	DISPLAY_ORDER = 23, -- Care's order: above NimbusMenu (20), the Pet Index (21) and the Fusion Machine (22)
	RECT = { H0 = 390, W0 = 820, Y0 = 330, H1 = 1080, W1 = 1440, Y1 = 840 },
	MARGIN = 12,
