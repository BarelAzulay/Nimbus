	},
}
BattleCatalog.BossOrder = { "storm_titan", "lava_golem", "frost_wyrm", "shadow_hydra" }

function BattleCatalog.NextBoss(index)
	local order = BattleCatalog.BossOrder
	local i = tonumber(index) or 1
	i = floor(i)
	local n = #order
	i = ((i - 1) % n) + 1
	if i < 1 then
		i = i + n
	end
	return order[i]
end

-- The weighted head count of a list of team DPS values: every team counts min(1, dps / the strongest dps), so eight
-- equal teams count 8 and one real team with seven idle alts counts a little over 1.
function BattleCatalog.WeightedTeams(dpsList)
	local top = 0
	for _, dps in ipairs(type(dpsList) == "table" and dpsList or {}) do
		if finite(dps) and dps > top then
			top = dps
		end
	end
	local n = 0
	for _, dps in ipairs(type(dpsList) == "table" and dpsList or {}) do
		if top > 0 and finite(dps) and dps > 0 then
			n = n + min(1, dps / top)
		end
	end
	return n
end

-- Boss HP for a list of team specs (each { Pets = {...} }): HpPerPlayer seconds of every team's expected DPS, each
-- team's share weighted like the head count (min(1, dps / the strongest dps): a team that brings nothing adds nothing).
-- Returns the total (x GroupFactor(weighted team count), at least BossRules.MinHp) and the list of each team's share
-- (BattleSim recomputes the whole figure when players join or leave).
function BattleCatalog.BossHp(bossId, teams)
	local boss = BattleCatalog.Bosses[bossId]
	local seconds = boss and boss.HpPerPlayer or 150
	local dpsList = {}
	local top = 0
	for i, team in ipairs(type(teams) == "table" and teams or {}) do
		dpsList[i] = BattleCatalog.ExpectedDps(team)
		top = max(top, dpsList[i])
	end
	local total = 0
	local shares = {}
	for i, dps in ipairs(dpsList) do
		local weight = (top > 0) and min(1, dps / top) or 0
		shares[i] = dps * seconds * weight
		total = total + shares[i]
	end
	total = total * BattleCatalog.GroupFactor(BattleCatalog.WeightedTeams(dpsList))
	local minHp = BattleCatalog.BossRules.MinHp
	if total < minHp then
		total = minHp
	end
	return floor(total + 0.5), shares
end

-- teams ^ GroupExponent: the multiplier on the summed shares for a raid of `teams` (weighted, may be fractional) teams
function BattleCatalog.GroupFactor(teams)
	local n = max(1, num(teams, 1))
	return n ^ (BattleCatalog.BossRules.GroupExponent or 0)
end

----------------------------------------------------------------------
-- Event schedule + raid rewards
----------------------------------------------------------------------
BattleCatalog.Events = {
	Schedule = {
		{ Kind = "BossRaid", EveryMinutes = 20, AnnounceSeconds = 120, DurationSeconds = 330 },
		{ Kind = "DoubleRewards", EveryMinutes = 180, AnnounceSeconds = 120, DurationSeconds = 3600 },
	},
	FirstAfterSeconds = 300, -- the first raid of a fresh server
	DoubleRewardsMultiplier = 2,
	JoinWindowSeconds = 60, -- players may join a raid during its first minute
}

BattleCatalog.Raid = {
	-- by damage share (fraction of the boss's total HP a player dealt); the first tier that fits wins
	Tiers = {
		{ Id = "Gold", MinShare = 0.25, Tokens = 500, Xp = 400, Gems = 10, GemChance = 0.25, EventPetChance = 0.05 },
		{ Id = "Silver", MinShare = 0.10, Tokens = 300, Xp = 250, Gems = 5, GemChance = 0.15, EventPetChance = 0.03 },
		{ Id = "Bronze", MinShare = 0.02, Tokens = 150, Xp = 120, Gems = 3, GemChance = 0.08, EventPetChance = 0.015 },
		{ Id = "Helper", MinShare = 0, Tokens = 60, Xp = 50, Gems = 0, GemChance = 0, EventPetChance = 0.005 }, -- any hit
	},
	-- everyone who fights gets rewarded (the player's design: "everyone gets in this fight for the reward"): a raider
	-- whose pets hit the boss at all earns at least Helper (Loss when the raid fails); only a share of 0 (an idle joiner
	-- whose pets never hit it) earns nothing. Joiners who deal little cannot inflate the boss (WeightedTeams).
	MinShare = 0,
	LossTokens = 25, -- everyone who really fought a raid that failed
	LossXp = 20,
}

-- the reward tier for a damage share (0..1): nil for no damage (share 0, or below Raid.MinShare), the Loss tier when
-- the raid failed
function BattleCatalog.RaidTier(share, won)
	local s = tonumber(share) or 0
	if s ~= s or s <= 0 or s < BattleCatalog.Raid.MinShare then
		return nil
	end
	if won == false then
		return { Id = "Loss", MinShare = BattleCatalog.Raid.MinShare, Tokens = BattleCatalog.Raid.LossTokens, Xp = BattleCatalog.Raid.LossXp, Gems = 0, GemChance = 0, EventPetChance = 0 }
	end
	local tiers = BattleCatalog.Raid.Tiers
	for _, tier in ipairs(tiers) do
		if s >= tier.MinShare then
			return tier
		end
	end
	return tiers[#tiers]
end

-- Catalog pets marked EventOnly = true (the events agent adds them): raid exclusive drops
function BattleCatalog.EventPets()
	local out = {}
	local pc = petCatalog()
	if pc and type(pc.Pets) == "table" then
		for _, def in ipairs(pc.Pets) do
			if def.EventOnly == true then
				table.insert(out, def.Id)
			end
		end
	end
	return out
end

----------------------------------------------------------------------
-- PvP trophies
----------------------------------------------------------------------
BattleCatalog.Trophies = {
	Win = 20,
	Loss = -10,
	Draw = 0,
	Forfeit = -10, -- a leaver / forfeit counts as a loss
	Floor = 0,
	Tokens = { Win = 40, Loss = 10, Draw = 15 },
	Xp = { Win = 60, Loss = 25 }, -- pet XP per team pet
}

----------------------------------------------------------------------
-- Self-check
----------------------------------------------------------------------
function BattleCatalog.Validate()
	local problems = {}
	local function bad(msg)
		table.insert(problems, msg)
	end
	local pc = petCatalog()
	-- profiles for every species
	if pc and type(pc.Species) == "table" then
		for _, species in ipairs(pc.Species) do
			if not BattleCatalog.Profiles[species] then
				bad("no combat profile for species " .. tostring(species))
			end
		end
	end
	for species, profile in pairs(BattleCatalog.Profiles) do
		if profile.Attack ~= "Melee" and profile.Attack ~= "Ranged" then
			bad(species .. ": Attack must be Melee or Ranged")
		end
		for _, key in ipairs({ "Range", "MoveSpeed", "Interval", "HitRadius", "DamageMult" }) do
			if not finite(profile[key]) or profile[key] <= 0 then
				bad(species .. ": " .. key .. " must be a positive number")
			end
		end
	end
	-- specials for every kind
	local kinds = (pc and pc.SpecialKinds) or BattleCatalog.SpecialKinds
	for _, kind in ipairs(kinds) do
		local s = BattleCatalog.Specials[kind]
		if type(s) ~= "table" then
			bad("no special effect for kind " .. tostring(kind))
		elseif type(s.Name) ~= "string" or type(s.Text) ~= "string" or not finite(s.Scale) then
			bad("special " .. kind .. " needs Name, Text and Scale")
		end
	end
	-- trials: 30 levels, pets exist, mini-boss every 5 levels, power never drops, rewards grow
	local trials = BattleCatalog.Trials
	if #trials ~= BattleCatalog.TrialCount then
		bad("expected " .. BattleCatalog.TrialCount .. " trials, got " .. #trials)
	end
	local lastPower = 0
	local lastTokens = 0
	for level = 1, #trials do
		local t = trials[level]
		if t.Level ~= level then
			bad("trial " .. level .. " has Level " .. tostring(t.Level))
		end
		if type(t.Name) ~= "string" or t.Name == "" then
			bad("trial " .. level .. " has no name")
		end
		if (level % 5 == 0) ~= (t.MiniBoss == true) then
			bad("trial " .. level .. ": MiniBoss must be true exactly every 5 levels")
		end
		if t.MiniBoss and not t.Boss then
			bad("trial " .. level .. ": a mini-boss level names no Boss pet")
		end
		if #t.Team < (level == 1 and 1 or 3) or #t.Team > BattleCatalog.MaxTeamSize then
			bad("trial " .. level .. ": team of " .. #t.Team .. " pets")
		end
		local bossSeen = false
		for _, entry in ipairs(t.Team) do
			if pc and pc.Get and not pc.Get(entry.PetId) then
				bad("trial " .. level .. ": unknown pet " .. tostring(entry.PetId))
			end
			if entry.Boss then
				bossSeen = true
			end
		end
		if t.Boss and not bossSeen then
			bad("trial " .. level .. ": Boss pet " .. tostring(t.Boss) .. " is not in the team")
		end
		if not finite(t.RecommendedPower) or t.RecommendedPower < lastPower then
			bad("trial " .. level .. ": RecommendedPower " .. tostring(t.RecommendedPower) .. " drops below level " .. (level - 1))
		end
		lastPower = t.RecommendedPower
		if t.RecommendedPower < t.TargetPower * 0.9 then
			bad("trial " .. level .. ": the roster cannot reach the target power " .. t.TargetPower .. " (got " .. t.RecommendedPower .. ")")
		end
		local r = t.Rewards
		if type(r) ~= "table" or not finite(r.Tokens) or r.Tokens <= lastTokens or type(r.FirstClear) ~= "table" then
			bad("trial " .. level .. ": rewards must grow with the level")
		else
			lastTokens = r.Tokens
			if t.MiniBoss and (r.FirstClear.Gems or 0) <= 0 then
				bad("trial " .. level .. ": a mini-boss first clear pays no Gems")
			end
		end
	end
	-- bosses
	local validElements = {}
	for _, e in ipairs((type(Config.Elements) == "table" and Config.Elements.Order) or {}) do
		validElements[e] = true
	end
	for _, id in ipairs(BattleCatalog.BossOrder) do
		local b = BattleCatalog.Bosses[id]
		if not b then
			bad("BossOrder names unknown boss " .. tostring(id))
		else
			if b.Id ~= id then
				bad("boss " .. id .. " has Id " .. tostring(b.Id))
			end
			if not validElements[b.Element] then
				bad("boss " .. id .. ": Element " .. tostring(b.Element) .. " is not in Config.Elements.Order")
			end
			if not finite(b.HpPerPlayer) or b.HpPerPlayer <= 0 then
				bad("boss " .. id .. ": HpPerPlayer must be positive")
			end
			if type(b.Attacks) ~= "table" or #b.Attacks < 1 then
				bad("boss " .. id .. ": needs attacks")
			else
				for _, a in ipairs(b.Attacks) do
					if a.Shape ~= "Circle" and a.Shape ~= "Line" then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": unknown shape " .. tostring(a.Shape))
					end
					if a.Shape == "Circle" and not finite(a.Radius) then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Circle needs Radius")
					end
					if a.Shape == "Line" and (not finite(a.Width) or not finite(a.Length)) then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Line needs Width and Length")
					end
					if not finite(a.Telegraph) or a.Telegraph < 1 then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Telegraph must be >= 1 s (players need time to RETREAT)")
					end
					if not finite(a.Damage) or a.Damage <= 0 or a.Damage > 0.6 then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Damage must be a fraction in (0, 0.6] (no one-shots)")
					end
					if not finite(a.Cooldown) or a.Cooldown < a.Telegraph then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Cooldown must cover the Telegraph")
					end
				end
			end
			if type(b.Basic) ~= "table" or not finite(b.Basic.Damage) or b.Basic.Damage > 0.2 then
				bad("boss " .. id .. ": Basic attack damage must be a small fraction")
			end
			if pc and pc.Get and b.MinionPet and not pc.Get(b.MinionPet) then
				bad("boss " .. id .. ": unknown minion pet " .. tostring(b.MinionPet))
			end
			if not finite(b.EnrageAt) or not finite(b.TimeLimit) or b.TimeLimit <= b.EnrageAt then
				bad("boss " .. id .. ": TimeLimit must come after EnrageAt")
			end
		end
	end
	-- raid tiers sorted by share, nothing paid for no damage, trophies floor
	local lastShare = 2
	for _, tier in ipairs(BattleCatalog.Raid.Tiers) do
		if tier.MinShare >= lastShare then
			bad("Raid.Tiers must be sorted by descending MinShare")
		end
		lastShare = tier.MinShare
	end
	if not finite(BattleCatalog.Raid.MinShare) or BattleCatalog.Raid.MinShare < 0 or lastShare < BattleCatalog.Raid.MinShare then
		bad("Raid.MinShare must be 0 or more and no higher than the lowest tier's MinShare (a raider with no damage earns nothing)")
	end
	if BattleCatalog.Trophies.Loss >= 0 or BattleCatalog.Trophies.Win <= 0 or BattleCatalog.Trophies.Floor ~= 0 then
		bad("Trophies: Win must be positive, Loss negative, Floor 0")
	end
	-- Phase 4: training, the loss-XP gate, the Champion Ring
	local TR = BattleCatalog.Training
	if TR.MaxRank ~= 10 or not finite(TR.Defense) or TR.Defense * TR.MaxRank > 0.3 + 1e-9 then
		bad("Training: MaxRank 10 and Defense capped at 30% at rank 10")
	end
	for _, skill in ipairs({ "Speed", "Physique", "Ability", "AbilityMeter", "Defense" }) do
		if not finite(TR[skill]) or TR[skill] <= 0 or TR[skill] > 0.1 then
			bad("Training." .. skill .. " must be a small positive share per rank")
		end
	end
	if #BattleCatalog.TrainingSkills ~= 4 then
		bad("TrainingSkills lists the four skills")
	end
	local TRR = BattleCatalog.TrialRewardRules
	if not finite(TRR.LossShare) or TRR.LossShare <= 0 or TRR.LossShare >= 1 or not finite(TRR.LossMinSeconds) or not finite(TRR.LossMinDamage) then
		bad("TrialRewardRules: LossShare in (0, 1), LossMinSeconds, LossMinDamage")
	end
	local R = BattleCatalog.Ring
	if BattleCatalog.Zones.Ring == nil or BattleCatalog.TimeLimits.Ring ~= R.TimeLimit then
		bad("Ring: Zones.Ring and TimeLimits.Ring = Ring.TimeLimit")
	end
	if not (R.Growth > 1 and R.Growth > R.BossBump and R.BossBump >= 1 and R.FirstPower > 0 and R.MinHandicap > 0 and R.MinHandicap < 1) then
		bad("Ring: Growth > BossBump >= 1 (the target never drops), FirstPower > 0, MinHandicap in (0, 1)")
	end
	for i, easy in ipairs(R.EasyRounds) do
		local def = pc and pc.Get and pc.Get(easy.PetId)
		if pc and (not def or def.Rarity ~= "Common") then
			bad("Ring.EasyRounds[" .. i .. "] must be a Common catalog pet")
		end
		if not finite(easy.Handicap) or easy.Handicap <= 0 or easy.Handicap >= 1 then
			bad("Ring.EasyRounds[" .. i .. "] needs a Handicap in (0, 1)")
		end
	end
	local nextFrom = #R.EasyRounds + 1
	for i, b in ipairs(R.Bands) do
		if b.From ~= nextFrom or type(b.Rarities) ~= "table" or #b.Rarities == 0 then
			bad("Ring.Bands[" .. i .. "] must start at round " .. nextFrom .. " and name rarities")
		end
		nextFrom = (b.To or huge) + 1
		for _, rarity in ipairs(b.Rarities or {}) do
			local pool = P4.pools()[rarity]
			if pc and (not pool or #pool == 0) then
				bad("Ring.Bands[" .. i .. "]: no catalog pets of rarity " .. tostring(rarity))
			end
		end
	end
	if nextFrom ~= huge then
		bad("Ring.Bands: the last band must be open-ended (no To)")
	end
	if pc then
		local last = 0
		local boosted = nil
		for round = 1, 80 do
			local spec = BattleCatalog.ChampionTeam(round, 1)
			if type(spec) ~= "table" or #spec.Pets ~= 1 then
				bad("ChampionTeam(" .. round .. ", 1) must be a one-pet team spec")
				break
			end
			-- rounds 1-3 are the fixed easy rounds; from the first solved round on the power never drops
			if round > #R.EasyRounds and spec.Power < last then
				bad("ChampionTeam: round " .. round .. " is weaker than round " .. (round - 1))
			end
			last = spec.Power
			if spec.Pets[1].Boost and not boosted then
				boosted = round
			end
			if pc.IsEventOnly and pc.IsEventOnly(spec.Pets[1].PetId) then
				bad("ChampionTeam: round " .. round .. " fields an EventOnly pet")
			end
			if spec.Pets[1].Level > R.ChampionMaxLevel then
				bad("ChampionTeam: round " .. round .. " is above ChampionMaxLevel")
			end
		end
		if not boosted then
			bad("ChampionTeam: no Boost by round 80 (the ladder must never end)")
		end
	end
	local rw = BattleCatalog.RingRewards(1, 0, false)
	if rw.Cash ~= R.CashFloorBase + R.CashFloorPerRound or rw.Xp ~= R.XpBase + R.XpPerRound or rw.Tokens ~= 0 then
		bad("RingRewards(1, 0, false) must pay the floor Cash and round-1 XP")
	end
	return #problems == 0, problems
end

return BattleCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BattleSim</string>
          <string name="Source"><![CDATA[-- BattleSim: the PURE pet battle engine of Phase 3 (ARCHITECTURE_V3.md "Phase 3 build contract" +
-- "Interfaces between the Phase 3 modules"). No Instances, no services, no yields, no wall clock: the server
-- steps it at 10 Hz and sends compact snapshots, every client draws and interpolates (Replication rule).
-- Deterministic for a seed: the same setup + the same commands at the same steps replay the same battle.
-- Plain Lua 5.1-compatible syntax only.
--
-- The floor is a 2D rectangle (x, z) in studs, centred on the zone centre of the "Start" payload (BattleService
-- adds the Zone CFrame; the floor is at the CFrame's height). Units move, pick the nearest enemy (or the focus the
-- owner tapped), attack in range (melee or ranged by species), use their special when commanded and the meter is
-- full, retreat to their owner's anchor (half damage taken, slow regen, ATTACK locked for a moment), go down and
-- stay down until the battle ends. Bosses stand on the stage and run their attack patterns: every pattern attack
-- is TELEGRAPHED (an event with the shape and the hit time) so a team can RETREAT out of it; minion waves spawn at
-- HP thresholds; an enrage timer doubles the boss's damage. Every number lives in BattleCatalog / PetCatalog.
--
-- API (the contract):
--   BattleSim.new(setup) -> battle | nil, reason
--     setup = {
--       Mode = "Trial" | "Duel" | "Raid" | "Ring",   -- default "Duel"; "Ring" (Phase 4, the Champion Ring) plays like a
--                                                     Trial: a timeout is a loss (side 2 wins)
--       Seed = n,                                     -- RNG seed (default 1)
--       Id = any,                                     -- optional battle id, echoed in Snapshot / Describe
--       Zone = n | { X = w, Z = d } | { w, d },       -- floor size in studs (default BattleCatalog.Zones[Mode])
--       Teams = { team... },                          -- see AddTeam
--       Trial = level,                                -- adds BattleCatalog.TrialTeam(level) on side 2
--       Boss = bossId,                                -- adds the boss (BattleCatalog.Bosses) on side 2 (Mode "Raid")
--       Round = n,                                    -- Ring: the round number, echoed in Describe / Result
--       TimeLimit = seconds,                          -- default BattleCatalog.TimeLimits[Mode] (Raid: the boss's)
--       Specials = false,                             -- harness: nobody can cast specials
--     }
--     team = { Owner = userId | string, Side = 1 | 2, Name, Anchor = { x, z } | nil, Npc = bool, Auto = bool,
--              Specials = false (harness: this team never casts), Pets = { { Key, PetId, Def, Level, Tier, Slot,
--              NoSpecial = true (harness: this pet never casts), Boss, Handicap,
--              Evo = 0..2, Train = { Speed, Physique, Ability, Defense }, Boost = > 1, Xp, XpNext, Crowned }... } }
--       Phase 4 entry fields: Evo (the stored evolution stage), Train (training ranks) and Boost (ring champions) go to
--       BattleCatalog.UnitStats (evolution / training / Boost numbers; Defense cuts every hit the pet takes after the
--       RETREAT halving and before MinHit / shields; Ability speeds up every meter gain); Xp / XpNext (the owner's own
--       pets: the XP bar) and Crowned (the ring champion) only go to the static unit info. NPC teams pass none of them.
--       Def may be a PetKeys.DefOf def (hybrids need it); otherwise Key / PetId is resolved through PetCatalog and
--       PetKeys. Npc / Auto teams cast their specials on their own (NPC trial teams, the harness); a player's team
--       casts only on the owner's "Special" command.
--   battle:Command(owner, action, arg) -> ok, reason
--       "Attack" (targetUnitId | nil: focus), "Retreat", "Special" (team slot 1-4), "Forfeit"
--   battle:Step(dt) -> events      advance dt seconds (clamped 0.02..0.5; the server uses 0.1) and return the
--       events of this step: { type = BattleSim.Events.X, ... } (Hit, Special, KO, Telegraph, Spawn, Enrage, Order,
--       Zone, Leave, End); an empty table while finished.
--   battle:Snapshot() -> { BattleId?, T, Units = { [id] = { x, z, hp, state, target?, meter, shield? } } }
--       compact numbers: x / z to 0.1 stud, hp / meter / shield integers, state = BattleSim.States code
--   battle:SnapshotDelta(last) -> { BattleId?, T, U = { number... } }    the WIRE form BattleService sends: only the
--       units whose picture changed since `last` (the receiver's previous picture, { [id] = { x, z, hp, state, meter,
--       shield, target } }, updated in place; pass {} for a full snapshot), each as the numbers
--         code, pos [, hp] [, meter] [, shield] [, target]
--       code = id x 128 + mask x 8 + state (mask bits: 1 hp, 2 meter, 4 shield, 8 target; target 0 = none),
--       pos = (x + 200) x 10 x 4096 + (z + 200) x 10 (0.1 stud steps; a floor is at most 400 studs). A unit missing
--       from U is unchanged (down units are sent once, then left out), so a 16-team raid stays a few KB/s per client.
--   BattleSim.DecodeSnapshot(payload, previous) -> Units    the client side: the full picture { [id] = { x, z, hp,
--       state, meter, shield, target } } from a SnapshotDelta payload and the previous picture (nil at the start);
--       untouched units keep their previous table. Junk payloads decode to the previous picture.
--   battle:Abort(reason) -> ok, events   ends a running battle now with no winner (Reason = reason, e.g. "Shutdown"):
--       the result still carries Damage / Shares / Survivors; the events hold the End event
--   battle:Result() -> nil while running, else { Mode, Reason, WinnerSide, Winners = { owner... },
--       Losers = { owner... }, Draw, Forfeit, Level (Trial), BossId (Raid), Round (Ring), Damage = { [owner] = n },
--       Shares = { [owner] = 0..1 }, Duration, Survivors = { [owner] = n }, Hp = { [side] = HP share left }, BossHp,
--       BossMaxHp }   (the loss-XP gate: the share a team dealt = 1 - Hp[the other side])
--       Phase 4 duel rules (BattleCatalog.Damage): Overtime (past At seconds every hit grows), MaxHit (no single pet hit
--       takes more than Share of a pet's max HP) and DoubleKoByDamage (both last pets down in one step: the team that
--       dealt more damage wins, Reason "Wipe"; forfeits stay a Draw). Trials, raids and the ring keep the Phase 3 rules.
--   battle:Describe() -> the static "Start" payload: { BattleId?, Mode, Seed, Zone = { X, Z }, TimeLimit, Level,
--       BossId, Round (Ring), Sides = { [side] = { owner... } }, Units = { unitInfo... } }
--   battle:StaticUnits() -> { unitInfo... }     unitInfo = { id, side, owner, slot, kind = "Pet" | "MiniBoss" |
--       "Boss" | "Minion", key, petId, boss (bossId; true for a pet in the mini-boss form), name, species, look
--       (PetBuilder Look), element, elements, maxHp, level, tier, scale, ranged, range, radius, special = { Id, Name,
--       Kind, Color }, evo (0..2), xp / xpNext (when the entry carries them), crowned (the ring champion) }
--   battle:AddTeam(team) -> infos | nil, reason    (raids: a player joins; queues a Spawn event)
--   battle:RemoveTeam(owner) -> ok                 (raids: a player leaves; queues a Leave event)
--   battle:SetAnchor(owner, x, z) -> ok            (where the team retreats to; clamped to the floor)
--   battle:BossStatus() -> { BossId, Hp, MaxHp, Enraged, EndsIn, Players } | nil
--   battle:Time(), battle:IsFinished(), battle:Owners(), battle:TeamOf(owner) (read-only summary)
--   BattleSim.States  = { Idle = 0, Moving = 1, Attacking = 2, Retreating = 3, Casting = 4, Down = 5, Stunned = 6 }
--   BattleSim.StateNames[code] -> "Idle" ...
--   BattleSim.Events  = { Hit, Special, KO, Telegraph, Spawn, Enrage, Order, Zone, Leave, End, Overtime }  (strings)
--   BattleSim.LineOvershoot = 6     a Line telegraph ends this far past the pet it is aimed at (never the whole floor)
-- RETREAT (Damage.RetreatLock / RetreatAutoResume / TelegraphMargin): the pets run to their spots beside the owner's
-- anchor and stand there; a pet inside an active Line telegraph first steps out sideways (the shortest way out), and
-- a spot covered by an active telegraph moves out of it, so every telegraph can be escaped by a timely RETREAT, even
-- one aimed at a team already parked. A PLAYER team (not Npc / Auto) parked at its spots with no telegraph on it goes
-- back to ATTACK by itself RetreatLock + RetreatAutoResume seconds after the RETREAT (Order event with auto = true).
-- Event shapes:
--   Hit       { from, to, dmg, elem (1.5 / 0.75 when not neutral), special (kind), tele (telegraph id), zone = true,
--               absorbed (shield), retreat = true }
--   Special   { unit, kind, name, x, z, tx, tz, targets = { id... }, heals = { { id, amount }... }, shields = { id... },
--               stunned = { id... } }
--   KO        { unit, by, forfeit = true }
--   Telegraph { id, boss, name, attack, shape = "Circle" | "Line", x, z, r | angle (radians) + length + width,
--               at (battle time of the hit), hits (seconds until it), freeze, linger }
--   Spawn     { units = { unitInfo... }, wave, boss, owner }
--   Enrage    { unit }
--   Order     { owner, order = "Attack" | "Retreat" | "Forfeit", target, auto = true (the retreat ended by itself) }
--   Zone      { unit, kind, x, z, r, seconds, side }
--   Leave     { owner, units = { id... } }
--   End       { reason, winnerSide }
--   Overtime  { at, perSecond }   once per duel at Damage.Overtime.At seconds: every hit grows by perSecond per second
--               past `at` (Phase 4: trained Shield / Heal mirrors would otherwise stall to the time limit)

local Shared = script.Parent

local BattleSim = {}
BattleSim.__index = BattleSim
BattleSim.Version = 1

local floor, ceil, sqrt, max, min, huge, abs = math.floor, math.ceil, math.sqrt, math.max, math.min, math.huge, math.abs
local cos, sin, atan2, pi = math.cos, math.sin, math.atan2, math.pi

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------
BattleSim.States = { Idle = 0, Moving = 1, Attacking = 2, Retreating = 3, Casting = 4, Down = 5, Stunned = 6 }
BattleSim.StateNames = {}
for name, code in pairs(BattleSim.States) do
	BattleSim.StateNames[code] = name
end
BattleSim.Events = {
	Hit = "Hit",
	Special = "Special",
	KO = "KO",
	Telegraph = "Telegraph",
	Spawn = "Spawn",
	Enrage = "Enrage",
	Order = "Order",
	Zone = "Zone",
	Leave = "Leave",
	End = "End",
	Overtime = "Overtime", -- Phase 4: a duel past Damage.Overtime.At (every hit grows from now on)
}
BattleSim.Orders = { Attack = "Attack", Retreat = "Retreat" }
BattleSim.Modes = { "Trial", "Duel", "Raid", "Ring" }
local MODE_OK = {}
for _, m in ipairs(BattleSim.Modes) do
	MODE_OK[m] = true
end
BattleSim.LineOvershoot = 6 -- studs a Line telegraph runs past the pet it is aimed at

local S_IDLE, S_MOVING, S_ATTACKING, S_RETREATING, S_CASTING, S_DOWN, S_STUNNED =
	BattleSim.States.Idle, BattleSim.States.Moving, BattleSim.States.Attacking, BattleSim.States.Retreating,
	BattleSim.States.Casting, BattleSim.States.Down, BattleSim.States.Stunned
local EV = BattleSim.Events
local ORDER_ATTACK, ORDER_RETREAT = "Attack", "Retreat"

local MAX_UNITS = 128 -- a raid of 8 teams x 4 pets + boss + waves stays far below this
local MIN_DT, MAX_DT = 0.02, 0.5
local ZONE_TICK = 0.5 -- zones (Storm clouds, lingering pools) hurt every enemy inside them this often (few events)
local HOME_RADIUS = 1.0 -- a retreating pet this close to its spot counts as parked (the auto resume waits for all)
-- the wire snapshot (SnapshotDelta / DecodeSnapshot): positions at 0.1 stud over a floor of at most 400 studs
local POS_OFFSET, POS_STEPS, POS_BASE = 200, 10, 4096
local MASK_HP, MASK_METER, MASK_SHIELD, MASK_TARGET = 1, 2, 4, 8

----------------------------------------------------------------------
-- Lazy modules
----------------------------------------------------------------------
local lazyCache = {}
local function lazy(name)
	local entry = lazyCache[name]
	if entry == nil then
		entry = false
		local inst = Shared:FindFirstChild(name)
		if inst then
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				entry = result
			end
		end
		lazyCache[name] = entry
	end
	return entry or nil
end

local function catalog()
	return lazy("BattleCatalog")
end

local function petCatalog()
	return lazy("PetCatalog")
end

local function petKeys()
	return lazy("PetKeys")
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= huge and n ~= -huge
end

local function r1(n)
	return floor(n * 10 + 0.5) / 10
end

----------------------------------------------------------------------
-- Deterministic RNG (Lehmer / Park-Miller: exact in doubles, the same on every platform)
----------------------------------------------------------------------
local RNG_M = 2147483647
local RNG_A = 48271

local function seedState(seed)
	local s = tonumber(seed) or 1
	if s ~= s or s == huge or s == -huge then
		s = 1
	end
	s = floor(abs(s)) % (RNG_M - 1) + 1
	-- a few warm-up rounds so neighbouring seeds diverge quickly
	for _ = 1, 4 do
		s = (s * RNG_A) % RNG_M
	end
	return s
end

local function rand(self)
	local s = (self.rngState * RNG_A) % RNG_M
	self.rngState = s
	return s / RNG_M
end

local function randInt(self, lo, hi)
	return lo + floor(rand(self) * (hi - lo + 1))
end

----------------------------------------------------------------------
-- Catalog access with safe fallbacks (the engine must never error at runtime)
----------------------------------------------------------------------
local FALLBACK_DAMAGE = {
	HpScale = 3, DamageScale = 0.6, Variance = 0.12, MinHit = 1,
	RetreatDamageTaken = 0.5, RetreatRegenPerSecond = 0.02, RetreatLock = 1.5, RetreatAutoResume = 3, TelegraphMargin = 1.5,
	MeterMax = 100, MeterStart = { 20, 50 }, MeterOnHit = 4, MeterOnHurt = 2, MeterPerSecond = 2,
	CastSeconds = 0.5, SpecialScale = 1, SeparationRadius = 2.6, RetargetSeconds = 0.5, EngageSlack = 0.6,
	NpcSpecialDelay = { 0.4, 1.4 }, KoMeterLoss = true,
}

local function damageRules()
	local bc = catalog()
	local d = bc and bc.Damage
	if type(d) == "table" then
		return d
	end
	return FALLBACK_DAMAGE
end

local function num(v, default)
	if finite(v) then
		return v
	end
	return default
end

local function resolveDef(entry)
	if type(entry) ~= "table" then
		return nil
	end
	if type(entry.Def) == "table" and type(entry.Def.Stats) == "table" then
		return entry.Def
	end
	local pc = petCatalog()
	local pk = petKeys()
	local candidates = { entry.Key, entry.PetId, entry.Id }
	for _, c in ipairs(candidates) do
		if type(c) == "string" then
			if pc and pc.Get then
				local def = pc.Get(c)
				if def then
					return def
				end
			end
			if pk and pk.DefOf then
				local ok, def = pcall(pk.DefOf, c, nil)
				if ok and type(def) == "table" and type(def.Stats) == "table" then
					return def
				end
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Geometry helpers
----------------------------------------------------------------------
local function dist(ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	return sqrt(dx * dx + dz * dz)
end

local function clampToFloor(self, u)
	local hx, hz = self.zone.HalfX - u.radius, self.zone.HalfZ - u.radius
	if hx < 0.5 then
		hx = 0.5
	end
	if hz < 0.5 then
		hz = 0.5
	end
	if u.x < -hx then
		u.x = -hx
	elseif u.x > hx then
		u.x = hx
	end
	if u.z < -hz then
		u.z = -hz
	elseif u.z > hz then
		u.z = hz
	end
end

-- a body of radius `radius` at (px, pz) touches the circle (x, z, r)
local function pointInCircle(px, pz, radius, x, z, r)
	local dx, dz = px - x, pz - z
	local reach = r + radius
	return dx * dx + dz * dz <= reach * reach
end

-- ... touches the line segment from (x, z) along angle for `length`, half width + body radius
local function pointInLine(px, pz, radius, x, z, angle, length, width)
	local dx, dz = px - x, pz - z
	local dirX, dirZ = cos(angle), sin(angle)
	local along = dx * dirX + dz * dirZ
	if along < -radius or along > length + radius then
		return false
	end
	local perp = abs(dx * dirZ - dz * dirX)
	return perp <= width / 2 + radius
end

-- inside a circle (unit body counts)
local function inCircle(u, x, z, r)
	return pointInCircle(u.x, u.z, u.radius, x, z, r)
end

-- inside a line segment from (x, z) along angle for `length`, half width + body radius
local function inLine(u, x, z, angle, length, width)
	return pointInLine(u.x, u.z, u.radius, x, z, angle, length, width)
end

-- the active telegraph (of the other side) that a body of `radius` at (x, z) is inside, or nil
local function telegraphAt(self, side, x, z, radius)
	local list = self.telegraphs
	for i = 1, #list do
		local tele = list[i]
		if tele.boss.side ~= side then
			if tele.shape == "Line" then
				if pointInLine(x, z, radius, tele.x, tele.z, tele.angle, tele.length, tele.width) then
					return tele
				end
			elseif pointInCircle(x, z, radius, tele.x, tele.z, tele.r) then
				return tele
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------
local function parseZone(mode, zone)
	local bc = catalog()
	local default = (bc and type(bc.Zones) == "table" and bc.Zones[mode]) or { X = 56, Z = 56 }
	local x, z = default.X, default.Z
	if finite(zone) and zone > 0 then
		x, z = zone, zone
	elseif type(zone) == "table" then
		local zx = zone.X or zone.x or zone[1]
		local zz = zone.Z or zone.z or zone[2]
		if type(zone.Size) == "table" then
			zx = zone.Size.X or zone.Size.x or zone.Size[1] or zx
			zz = zone.Size.Z or zone.Size.z or zone.Size[2] or zz
		elseif finite(zone.Size) then
			zx, zz = zone.Size, zone.Size
		end
		if finite(zx) and zx > 0 then
			x = zx
		end
		if finite(zz) and zz > 0 then
			z = zz
		end
	end
	x = max(16, min(400, x))
	z = max(16, min(400, z))
	return { X = x, Z = z, HalfX = x / 2, HalfZ = z / 2 }
end

local function newTeamRecord(self, spec, side)
	return {
		owner = spec.Owner,
		side = side,
		name = type(spec.Name) == "string" and spec.Name or nil,
		npc = spec.Npc == true,
		auto = spec.Npc == true or spec.Auto == true,
		noSpecials = spec.Specials == false, -- harness: this team never casts
		units = {},
		bySlot = {},
		order = ORDER_ATTACK,
		focus = nil,
		retreatAt = -huge,
		anchorX = 0,
		anchorZ = 0,
		damage = 0,
		forfeited = false,
		left = false,
		index = #self.teams + 1,
		powerMult = {},
		healthMult = 1,
	}
end

-- anchor positions: duel / trial sides face each other across z; raid teams stand around the boss
local function placeAnchor(self, team, spec)
	local hx, hz = self.zone.HalfX, self.zone.HalfZ
	if type(spec.Anchor) == "table" then
		local ax = spec.Anchor.x or spec.Anchor.X or spec.Anchor[1]
		local az = spec.Anchor.z or spec.Anchor.Z or spec.Anchor[2]
		if finite(ax) and finite(az) then
			team.anchorX = max(-hx + 2, min(hx - 2, ax))
			team.anchorZ = max(-hz + 2, min(hz - 2, az))
			return
		end
	end
	if self.mode == "Raid" then
		local slots = 8
		local k = (self.raidSlots or 0)
		self.raidSlots = k + 1
		local angle = -pi / 2 + (k % slots) * (2 * pi / slots) + floor(k / slots) * (pi / slots)
		local r = min(hx, hz) - 7
		team.anchorX = cos(angle) * r
		team.anchorZ = sin(angle) * r
		return
	end
	-- several teams on one side spread along x
	local sideTeams = 0
	for _, t in ipairs(self.teams) do
		if t.side == team.side and t ~= team then
			sideTeams = sideTeams + 1
		end
	end
	team.anchorX = (sideTeams % 2 == 0) and (sideTeams * 5) or (-(sideTeams + 1) * 5)
	team.anchorX = max(-hx + 3, min(hx - 3, team.anchorX))
	if team.side == 1 then
		team.anchorZ = -hz + 5
	else
		team.anchorZ = hz - 5
	end
end

-- Damage.MeterStart: a number, or { lo, hi } rolled per pet with the battle's RNG
local function meterStart(self, D)
	local ms = D.MeterStart
	if type(ms) == "table" then
		local lo, hi = num(ms[1], 0), num(ms[2], 0)
		return lo + (hi - lo) * rand(self)
	end
	return num(ms, 0)
end

local function unitFromDef(self, team, def, entry, slot, kind, powerMult)
	local bc = catalog()
	-- the entry doubles as the UnitStats extras: Evo, Train and Boost (Phase 4) are read from it
	local us = bc and bc.UnitStats and bc.UnitStats(def, entry.Level, entry.Tier, entry)
	if not us then
		return nil
	end
	local D = damageRules()
	local id = #self.units + 1
	if id > MAX_UNITS then
		return nil
	end
	local maxHp = us.MaxHp * (team.healthMult or 1)
	local hit = us.Hit
	local radius = us.Radius
	local scale = 1
	local specialPower = us.SpecialPower
	if kind == "MiniBoss" then
		local mb = (bc and bc.MiniBoss) or { Hp = 3, Power = 1.3, Scale = 1.7 }
		maxHp = maxHp * mb.Hp
		hit = hit * mb.Power
		radius = radius * 1.4
		scale = mb.Scale
	end
	-- a handicapped NPC pet (the tutorial's Trial 1): HP, hits and its special scaled down together
	if finite(entry.Handicap) and entry.Handicap > 0 and entry.Handicap < 1 then
		maxHp = maxHp * entry.Handicap
		hit = hit * entry.Handicap
		specialPower = specialPower * entry.Handicap
	end
	local special = type(def.Special) == "table" and def.Special or nil
	local u = {
		id = id,
		side = team.side,
		team = team,
		owner = team.owner,
		slot = slot,
		kind = kind,
		def = def,
		key = entry.Key or def.Key or def.Id,
		petId = entry.PetId or def.PetId or def.Id,
		name = def.DisplayName or def.Name or tostring(def.Id),
		species = us.Species,
		elems = us.Elements,
		maxHp = maxHp,
		hp = maxHp,
		hit = hit,
		interval = us.Interval,
		moveSpeed = us.MoveSpeed,
		range = us.Range,
		ranged = us.Ranged,
		radius = radius,
		specialPower = specialPower,
		specialFactor = min(1, num(us.SpecialFactor, 1)),
		specialKind = (special and not entry.NoSpecial) and special.Kind or nil, -- NoSpecial: harness only
		special = special,
		powerMult = powerMult or 1,
		level = num(entry.Level, 1),
		tier = entry.Tier or def.Tier or "Normal",
		scale = scale,
		-- Phase 4: evolution / training / ring Boost (already inside maxHp / hit / interval / specialPower via UnitStats)
		evo = num(us.Evo, 0),
		train = us.Train,
		boost = (finite(us.Boost) and us.Boost > 1) and us.Boost or nil,
		defense = max(0, min(0.9, num(us.Defense, 0))),
		meterRate = max(0.1, num(us.MeterRate, 1)),
		xp = (finite(entry.Xp) and entry.Xp >= 0) and floor(entry.Xp) or nil,
		xpNext = (finite(entry.XpNext) and entry.XpNext >= 0) and floor(entry.XpNext) or nil,
		crowned = entry.Crowned == true or nil,
		x = 0,
		z = 0,
		px = 0,
		pz = 0,
		state = S_IDLE,
		target = nil,
		nextAttack = self.t + rand(self) * us.Interval * 0.6, -- desynchronised swings: no lockstep first-strike edge
		retargetAt = 0,
		meter = meterStart(self, D),
		shield = 0,
		shieldUntil = 0,
		stunUntil = 0,
		castUntil = 0,
		autoCastAt = nil,
		alive = true,
		gone = false,
		damage = 0,
		atHome = false, -- retreating: parked at its spot
	}
	self.units[id] = u
	return u
end

-- pets stand near their anchor, offset per slot toward the floor centre
local function placeTeamUnits(self, team)
	local cx, cz = -team.anchorX, -team.anchorZ
	local len = sqrt(cx * cx + cz * cz)
	if len < 0.01 then
		cx, cz, len = 0, 1, 1
	end
	cx, cz = cx / len, cz / len -- toward the centre
	local px, pz = -cz, cx -- perpendicular
	local n = #team.units
	for i, u in ipairs(team.units) do
		local spread = (i - (n + 1) / 2) * 2.6
		u.x = team.anchorX + cx * 3 + px * spread
		u.z = team.anchorZ + cz * 3 + pz * spread
		clampToFloor(self, u)
		u.px, u.pz = u.x, u.z
	end
end

local function unitInfo(u)
	local info = {
		id = u.id,
		side = u.side,
		owner = u.owner,
		slot = u.slot,
		kind = u.kind,
		key = u.key,
		petId = u.petId,
		name = u.name,
		species = u.species,
		look = type(u.def) == "table" and u.def.Look or nil,
		element = u.elems[1],
		elements = u.elems,
		maxHp = floor(u.maxHp + 0.5),
		level = u.level,
		tier = u.tier,
		scale = u.scale,
		ranged = u.ranged,
		range = u.range,
		radius = u.radius,
	}
	if u.boss then
		info.boss = u.boss.Id
	elseif u.kind == "MiniBoss" then
		info.boss = true -- a pet in the mini-boss form (a trial's boss pet, a giant ring champion)
	end
	info.evo = u.evo or 0
	if u.xp then
		info.xp = u.xp
		info.xpNext = u.xpNext
	end
	if u.crowned then
		info.crowned = true
	end
	if u.special then
		info.special = { Id = u.special.Id, Name = u.special.Name, Kind = u.special.Kind, Color = u.special.Color }
	end
	return info
end

-- Adds a team (also used by new). Returns the unit infos, or nil + reason.
function BattleSim:AddTeam(spec)
	if self.result then
		return nil, "Finished"
	end
	if type(spec) ~= "table" or spec.Owner == nil then
		return nil, "BadTeam"
	end
	if self.teamByOwner[spec.Owner] then
		return nil, "DuplicateOwner"
	end
	local side = spec.Side
	if side ~= 1 and side ~= 2 then
		side = 1
	end
	local bc = catalog()
	local maxSize = (bc and bc.MaxTeamSize) or 4
	local pets = type(spec.Pets) == "table" and spec.Pets or {}
	-- resolve defs first (synergy needs them all)
	local defs, entries = {}, {}
	for i = 1, min(#pets, maxSize) do
		local entry = pets[i]
		local def = resolveDef(entry)
		if def then
			defs[#defs + 1] = def
			entries[#entries + 1] = entry
		end
	end
	if #defs == 0 then
		return nil, "NoPets"
	end
	local team = newTeamRecord(self, spec, side)
	local synPower = {} -- by def index (slots may be out of order)
	if bc and bc.SynergyBonus then
		local syn = bc.SynergyBonus(defs)
		team.healthMult = syn.HealthMult or 1
		for i = 1, #defs do
			synPower[i] = syn.PowerMult[i] or 1
		end
	end
	self.teams[#self.teams + 1] = team
	self.teamByOwner[spec.Owner] = team
	placeAnchor(self, team, spec)
	local infos = {}
	for i, def in ipairs(defs) do
		local entry = entries[i]
		local slot = i
		if finite(entry.Slot) and entry.Slot >= 1 and entry.Slot <= maxSize and not team.bySlot[floor(entry.Slot)] then
			slot = floor(entry.Slot)
		end
		team.powerMult[slot] = synPower[i] or 1
		local kind = entry.Boss and "MiniBoss" or "Pet"
		local u = unitFromDef(self, team, def, entry, slot, kind, synPower[i])
		if u then
			team.units[#team.units + 1] = u
			team.bySlot[slot] = u
			infos[#infos + 1] = u
		end
	end
	if #team.units == 0 then
		-- roll back
		self.teams[#self.teams] = nil
		self.teamByOwner[spec.Owner] = nil
		return nil, "NoPets"
	end
	placeTeamUnits(self, team)
	-- expected DPS / average hp bookkeeping (raids scale the boss with it)
	if bc and bc.ExpectedDps then
		team.dps = bc.ExpectedDps({ Pets = entries })
	else
		team.dps = 0
	end
	local out = {}
	for i, u in ipairs(infos) do
		out[i] = unitInfo(u)
	end
	if self.started then
		local boss = self.boss
		if boss and boss.alive and not team.npc and side == 1 then
			-- the boss grows by what the newcomer brings (BattleCatalog.BossHp over everyone still in); the damage dealt
			-- so far stays dealt
			local before = boss.maxHp
			boss.maxHp = self:_bossMaxHp()
			boss.hp = max(1, boss.hp + (boss.maxHp - before))
		end
		self:_refreshRaidScale()
		self.pending[#self.pending + 1] = { type = EV.Spawn, units = out, owner = spec.Owner }
	end
	return out
end

-- BattleCatalog.BossHp over the player teams still in the raid (their current pets)
function BattleSim:_bossMaxHp()
	local bc = catalog()
	local specs = {}
	for _, t in ipairs(self.teams) do
		if t.side == 1 and not t.npc and not t.left then
			local pets = {}
			for j, u in ipairs(t.units) do
				pets[j] = { Def = u.def, Level = u.level, Tier = u.tier, Evo = u.evo, Train = u.train, Boost = u.boost }
			end
			specs[#specs + 1] = { Pets = pets }
		end
	end
	if bc and bc.BossHp then
		local hp = bc.BossHp(self.bossId, specs)
		if finite(hp) and hp > 0 then
			return hp
		end
	end
	return 1000
end

-- player teams still in the raid (side 1, not NPC, not left)
function BattleSim:_playerTeams()
	local n = 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.npc and not team.left then
			n = n + 1
		end
	end
	return n
end

-- the same head count WEIGHTED by what each team brings (BattleCatalog.WeightedTeams: min(1, dps / the strongest
-- team's dps)), the number behind the boss's HP group factor and its damage scaling; `excluding` leaves one team out
function BattleSim:_effectiveTeams(excluding)
	local dpsList = {}
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.npc and not team.left and team ~= excluding then
			dpsList[#dpsList + 1] = num(team.dps, 0)
		end
	end
	local bc = catalog()
	if bc and bc.WeightedTeams then
		return bc.WeightedTeams(dpsList)
	end
	return #dpsList
end

local bossBasis -- defined with the boss patterns below

-- The boss's damage yardstick: the average pet MaxHp (and level) over the player teams
function BattleSim:_refreshRaidScale()
	local total, n, levels = 0, 0, 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.left then
			for _, u in ipairs(team.units) do
				if u.kind == "Pet" or u.kind == "MiniBoss" then
					total = total + u.maxHp
					levels = levels + (u.level or 1)
					n = n + 1
				end
			end
		end
	end
	if n > 0 then
		self.avgPetHp = total / n
		self.avgPetLevel = floor(levels / n + 0.5)
	end
	if not self.avgPetHp or self.avgPetHp <= 0 then
		self.avgPetHp = 150
		self.avgPetLevel = 1
	end
	self.playerTeamCount = self:_effectiveTeams()
	-- minions scale with the participants (the same head-count factor as the boss: bossBasis of an average pet)
	for _, u in ipairs(self.units) do
		if u.kind == "Minion" and u.alive then
			local rules = (catalog() and catalog().BossRules) or {}
			u.hit = num(rules.MinionDamage, 0.05) * bossBasis(self, { maxHp = self.avgPetHp })
		end
	end
end

local function makeBoss(self, bossId)
	local bc = catalog()
	local def = bc and type(bc.Bosses) == "table" and bc.Bosses[bossId]
	if not def then
		return nil, "UnknownBoss"
	end
	local id = #self.units + 1
	local team = {
		owner = "boss",
		side = 2,
		name = def.Name,
		npc = true,
		auto = true,
		units = {},
		bySlot = {},
		order = ORDER_ATTACK,
		retreatAt = -huge,
		anchorX = 0,
		anchorZ = 0,
		damage = 0,
		forfeited = false,
		left = false,
		index = #self.teams + 1,
		powerMult = {},
		healthMult = 1,
		dps = 0,
	}
	self.teams[#self.teams + 1] = team
	self.teamByOwner["boss"] = team
	self.bossId = bossId
	local hp = self:_bossMaxHp()
	local attacks = {}
	for i, a in ipairs(def.Attacks or {}) do
		attacks[i] = { def = a, nextAt = num(a.First, 6 + i * 6) } -- the first telegraph a few seconds in, then on cooldown
	end
	local u = {
		id = id,
		side = 2,
		team = team,
		owner = "boss",
		slot = 1,
		kind = "Boss",
		def = def,
		boss = def,
		key = bossId,
		petId = nil,
		name = def.Name,
		species = nil,
		elems = { def.Element },
		maxHp = hp,
		hp = hp,
		hit = 0,
		interval = num(def.Basic and def.Basic.Interval, 2.5),
		moveSpeed = 0,
		range = num(def.Basic and def.Basic.Range, 14),
		ranged = true,
		radius = num(def.Radius, 7),
		specialPower = 0,
		special = nil,
		powerMult = 1,
		level = 1,
		tier = "Boss",
		scale = num(def.Scale, 1),
		x = 0,
		z = 0,
		px = 0,
		pz = 0,
		state = S_IDLE,
		target = nil,
		nextAttack = 3,
		retargetAt = 0,
		meter = 0,
		shield = 0,
		shieldUntil = 0,
		stunUntil = 0,
		castUntil = 0,
		alive = true,
		gone = false,
		damage = 0,
		attacks = attacks,
		wavesDone = {},
		enraged = false,
		damageMult = 1,
		cooldownMult = 1,
	}
	self.units[id] = u
	team.units[1] = u
	team.bySlot[1] = u
	self.boss = u
	self.bossId = bossId
	return u
end

function BattleSim.new(setup)
	if type(setup) ~= "table" then
		return nil, "BadSetup"
	end
	local mode = setup.Mode
	if not MODE_OK[mode] then
		mode = (setup.Boss ~= nil and "Raid") or (setup.Trial ~= nil and "Trial") or "Duel"
	end
	local bc = catalog()
	local self = setmetatable({}, BattleSim)
	self.id = setup.Id
	self.mode = mode
	self.seed = tonumber(setup.Seed) or 1
	self.rngState = seedState(self.seed)
	self.t = 0
	self.stepCount = 0
	self.zone = parseZone(mode, setup.Zone)
	self.teams = {}
	self.teamByOwner = {}
	self.units = {}
	self.telegraphs = {}
	self.zones = {}
	self.pending = {}
	self.order = {} -- scratch: the shuffled unit order of the current step
	self.order2 = {} -- scratch: target candidates
	self.result = nil
	self.started = false
	self.specialsEnabled = setup.Specials ~= false
	self.elemCache = {}
	self.nextTelegraphId = 1
	self.avgPetHp = 150
	self.avgPetLevel = 1
	local limits = (bc and bc.TimeLimits) or { Trial = 90, Duel = 120, Raid = 330, Ring = 90 }
	self.timeLimit = num(setup.TimeLimit, limits[mode] or 120)
	if mode == "Ring" and finite(setup.Round) then
		self.round = floor(setup.Round)
	end
	-- overtime (Damage.Overtime): duels only; nil = never
	local ot = damageRules().Overtime
	if type(ot) == "table" and type(ot.Modes) == "table" and ot.Modes[mode] and finite(ot.At) and finite(ot.PerSecond) and ot.PerSecond > 0 then
		self.overtimeAt = ot.At
		self.overtimeRate = ot.PerSecond
	end
	-- no one-shots in PvP (Damage.MaxHit): a single pet hit takes at most Share of the victim's max HP
	local mh = damageRules().MaxHit
	if type(mh) == "table" and type(mh.Modes) == "table" and mh.Modes[mode] and finite(mh.Share) and mh.Share > 0 then
		self.maxHitShare = mh.Share
	end

	local teams = type(setup.Teams) == "table" and setup.Teams or {}
	for _, spec in ipairs(teams) do
		if type(spec) == "table" then
			local infos, reason = self:AddTeam(spec)
			if not infos and reason == "DuplicateOwner" then
				return nil, reason
			end
		end
	end
	if setup.Trial ~= nil then
		local level = tonumber(setup.Trial)
		local npc = bc and bc.TrialTeam and bc.TrialTeam(level)
		if not npc then
			return nil, "UnknownTrial"
		end
		self.level = level
		local trial = bc.Trials[level]
		if trial and finite(trial.TimeLimit) and setup.TimeLimit == nil then
			self.timeLimit = trial.TimeLimit
		end
		local infos, reason = self:AddTeam(npc)
		if not infos then
			return nil, reason or "BadTrial"
		end
	end
	if setup.Boss ~= nil then
		local boss, reason = makeBoss(self, setup.Boss)
		if not boss then
			return nil, reason
		end
		if setup.TimeLimit == nil and finite(boss.boss.TimeLimit) then
			self.timeLimit = boss.boss.TimeLimit
		end
	end
	-- both sides must exist
	local side1, side2 = 0, 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 then
			side1 = side1 + #team.units
		else
			side2 = side2 + #team.units
		end
	end
	if side1 == 0 then
		return nil, "NoTeam"
	end
	if side2 == 0 then
		return nil, "NoOpponent"
	end
	self:_refreshRaidScale()
	self.started = true
	return self
end

----------------------------------------------------------------------
-- Read-only accessors
----------------------------------------------------------------------
function BattleSim:Time()
	return self.t
end

function BattleSim:IsFinished()
	return self.result ~= nil
end

-- nil while the battle runs; afterwards the result table (the same table every call)
function BattleSim:Result()
	return self.result
end

function BattleSim:Owners()
	local out = {}
	for _, team in ipairs(self.teams) do
		if not team.npc and not team.left then
			out[#out + 1] = team.owner
		end
	end
	return out
end

function BattleSim:StaticUnits()
	local out = {}
	for _, u in ipairs(self.units) do
		if not u.gone then
			out[#out + 1] = unitInfo(u)
		end
	end
	return out
end

function BattleSim:Describe()
	local sides = { [1] = {}, [2] = {} }
	for _, team in ipairs(self.teams) do
		if not team.left then
			local list = sides[team.side]
			list[#list + 1] = team.owner
		end
	end
	return {
		BattleId = self.id,
		Mode = self.mode,
		Seed = self.seed,
		Zone = { X = self.zone.X, Z = self.zone.Z },
		TimeLimit = self.timeLimit,
		Level = self.level,
		BossId = self.bossId,
		Round = self.round,
		Sides = sides,
		Units = self:StaticUnits(),
	}
end

function BattleSim:TeamOf(owner)
	local team = self.teamByOwner[owner]
	if not team then
		return nil
	end
	local units = {}
	for i, u in ipairs(team.units) do
		units[i] = { id = u.id, slot = u.slot, hp = u.hp, maxHp = u.maxHp, meter = u.meter, state = u.state, alive = u.alive }
	end
	return {
		Owner = team.owner,
		Side = team.side,
		Order = team.order,
		Focus = team.focus and team.focus.id or nil,
		Anchor = { x = team.anchorX, z = team.anchorZ },
		Damage = team.damage,
		Left = team.left,
		Forfeited = team.forfeited,
		Units = units,
	}
end

function BattleSim:BossStatus()
	local b = self.boss
	if not b then
		return nil
	end
	local players = 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.npc and not team.left then
			players = players + 1
		end
	end
	return {
		BossId = self.bossId,
		Name = b.name,
		Hp = max(0, floor(b.hp + 0.5)),
		MaxHp = floor(b.maxHp + 0.5),
		Enraged = b.enraged,
		EndsIn = max(0, self.timeLimit - self.t),
		Players = players,
	}
end

function BattleSim:SetAnchor(owner, x, z)
	local team = self.teamByOwner[owner]
	if not team or not finite(x) or not finite(z) then
		return false
	end
	local hx, hz = self.zone.HalfX, self.zone.HalfZ
	team.anchorX = max(-hx + 2, min(hx - 2, x))
	team.anchorZ = max(-hz + 2, min(hz - 2, z))
	return true
end

----------------------------------------------------------------------
-- Snapshot
----------------------------------------------------------------------
function BattleSim:Snapshot()
	local units = {}
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if not u.gone then
			local hp = 0
			if u.alive then
				hp = ceil(u.hp - 0.0001)
				if hp < 1 then
					hp = 1
				end
			end
			local s = { x = r1(u.x), z = r1(u.z), hp = hp, state = u.state, meter = floor(u.meter + 0.5) }
			local tgt = u.target
			if tgt and tgt.alive and not tgt.gone then
				s.target = tgt.id
			end
			if u.shield > 0 then
				s.shield = floor(u.shield + 0.5)
			end
			units[u.id] = s
		end
	end
	return { BattleId = self.id, T = r1(self.t), Units = units }
end

-- the wire form (see the header): the units whose picture changed since `last`, as flat numbers
function BattleSim:SnapshotDelta(last)
	if type(last) ~= "table" then
		last = {}
	end
	local U = {}
	local n = 0
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if not u.gone then
			local hp = 0
			if u.alive then
				hp = ceil(u.hp - 0.0001)
				if hp < 1 then
					hp = 1
				end
			end
			local x, z = r1(u.x), r1(u.z)
			local meter = floor(u.meter + 0.5)
			local shield = u.shield > 0 and floor(u.shield + 0.5) or 0
			local tgt = u.target
			local target = (tgt and tgt.alive and not tgt.gone) and tgt.id or 0
			local l = last[u.id]
			local mask = 0
			if not l then
				l = {}
				last[u.id] = l
				mask = MASK_HP + MASK_METER + MASK_SHIELD + MASK_TARGET
			else
				if l.hp ~= hp then
					mask = mask + MASK_HP
				end
				if l.meter ~= meter then
					mask = mask + MASK_METER
				end
				if l.shield ~= shield then
					mask = mask + MASK_SHIELD
				end
				if (l.target or 0) ~= target then
					mask = mask + MASK_TARGET
				end
			end
			if mask > 0 or l.x ~= x or l.z ~= z or l.state ~= u.state then
				l.x, l.z, l.hp, l.state, l.meter, l.shield = x, z, hp, u.state, meter, shield
				l.target = (target ~= 0) and target or nil
				local xi = floor((max(-POS_OFFSET, min(POS_OFFSET, x)) + POS_OFFSET) * POS_STEPS + 0.5)
				local zi = floor((max(-POS_OFFSET, min(POS_OFFSET, z)) + POS_OFFSET) * POS_STEPS + 0.5)
				U[n + 1] = u.id * 128 + mask * 8 + u.state
				U[n + 2] = xi * POS_BASE + zi
				n = n + 2
				if mask % (MASK_HP * 2) >= MASK_HP then
					n = n + 1
					U[n] = hp
				end
				if mask % (MASK_METER * 2) >= MASK_METER then
					n = n + 1
					U[n] = meter
				end
				if mask % (MASK_SHIELD * 2) >= MASK_SHIELD then
					n = n + 1
					U[n] = shield
				end
				if mask % (MASK_TARGET * 2) >= MASK_TARGET then
					n = n + 1
					U[n] = target
				end
			end
		end
	end
	return { BattleId = self.id, T = r1(self.t), U = U }
end

-- the client side of SnapshotDelta: the full picture from the payload and the previous picture (see the header)
function BattleSim.DecodeSnapshot(payload, previous)
	local out = {}
	if type(previous) == "table" then
		for id, rec in pairs(previous) do
			out[id] = rec
		end
	end
	local U = type(payload) == "table" and payload.U
	if type(U) ~= "table" then
		return out
	end
	local i = 1
	local n = #U
	while i + 1 <= n do
		local code, pos = U[i], U[i + 1]
		if not finite(code) or not finite(pos) or code ~= floor(code) or code < 128 or pos ~= floor(pos) or pos < 0 then
			break -- junk: keep what decoded so far
		end
		local state = code % 8
		local mask = floor(code / 8) % 16
		local id = floor(code / 128)
		local xi = floor(pos / POS_BASE)
		local zi = pos % POS_BASE
		local prev = out[id]
		local rec = {
			x = xi / POS_STEPS - POS_OFFSET,
			z = zi / POS_STEPS - POS_OFFSET,
			state = state,
			hp = prev and prev.hp or nil,
			meter = prev and prev.meter or 0,
			shield = prev and prev.shield or 0,
			target = prev and prev.target or nil,
		}
		i = i + 2
		if mask % (MASK_HP * 2) >= MASK_HP then
			rec.hp = tonumber(U[i])
			i = i + 1
		end
		if mask % (MASK_METER * 2) >= MASK_METER then
			rec.meter = tonumber(U[i]) or 0
			i = i + 1
		end
		if mask % (MASK_SHIELD * 2) >= MASK_SHIELD then
			rec.shield = tonumber(U[i]) or 0
			i = i + 1
		end
		if mask % (MASK_TARGET * 2) >= MASK_TARGET then
			local target = tonumber(U[i]) or 0
			rec.target = (target > 0) and target or nil
			i = i + 1
		end
		if i > n + 1 then
			break -- a record cut short
		end
		out[id] = rec
	end
	return out
end

----------------------------------------------------------------------
-- Damage
----------------------------------------------------------------------
local function elemMult(self, attacker, victim)
	local key = attacker.id * MAX_UNITS + victim.id
	local m = self.elemCache[key]
	if m == nil then
		m = 1
		local pc = petCatalog()
		if pc and pc.ElementMultiplier and #attacker.elems > 0 and #victim.elems > 0 then
			local ok, result = pcall(pc.ElementMultiplier, attacker.elems, victim.elems)
			if ok and finite(result) then
				m = result
			end
		end
		self.elemCache[key] = m
	end
	return m
end

local function knockOut(self, u, by, events, forfeit)
	u.alive = false
	u.hp = 0
	u.state = S_DOWN
	u.target = nil
	u.shield = 0
	if damageRules().KoMeterLoss then
		u.meter = 0
	end
	local ev = { type = EV.KO, unit = u.id, by = by and by.id or nil }
	if forfeit then
		ev.forfeit = true
	end
	events[#events + 1] = ev
end

-- Applies `amount` of damage from `attacker` (may be nil for zones / telegraphs with a source unit in `by`) to `victim`.
-- Returns the damage dealt (after retreat reduction and shields). `extra` fields are copied into the Hit event.
local function applyDamage(self, attacker, victim, amount, events, extra, noVariance)
	if not victim.alive or victim.gone or amount <= 0 then
		return 0
	end
	local D = damageRules()
	local dmg = amount
	if self.overtimeMult then
		dmg = dmg * self.overtimeMult
	end
	local mult = 1
	if attacker then
		mult = elemMult(self, attacker, victim)
		dmg = dmg * mult * (attacker.powerMult or 1)
	end
	local crit = false
	if not noVariance then
		local v = D.Variance
		dmg = dmg * (1 - v + 2 * v * rand(self))
		-- plain pet attacks (not specials, bosses or zones) land critical hits now and then: a visible swing
		local critRules = D.Crit
		if attacker and attacker.kind ~= "Boss" and extra == nil and type(critRules) == "table" and rand(self) < num(critRules.Chance, 0) then
			dmg = dmg * num(critRules.Mult, 1.5)
			crit = true
		end
	end
	local retreating = victim.team.order == ORDER_RETREAT and victim.kind ~= "Boss"
	if retreating then
		dmg = dmg * D.RetreatDamageTaken
	end
	-- Phase 4 training: Defense blocks a share of every hit (after the RETREAT halving, before MinHit / shields)
	local defense = victim.defense
	if defense and defense > 0 then
		dmg = dmg * (1 - defense)
	end
	local cap = self.maxHitShare
	if cap and attacker and attacker.kind ~= "Boss" and dmg > victim.maxHp * cap then
		dmg = victim.maxHp * cap
	end
	if dmg < D.MinHit then
		dmg = D.MinHit
	end
	local absorbed = 0
	if victim.shield > 0 then
		absorbed = min(victim.shield, dmg)
		victim.shield = victim.shield - absorbed
		dmg = dmg - absorbed
	end
	victim.hp = victim.hp - dmg
	if attacker then
		attacker.damage = attacker.damage + dmg
		attacker.team.damage = attacker.team.damage + dmg
		-- only plain attacks build the meter (a special's own hits, zones and telegraphs never refund it)
		if attacker.kind ~= "Boss" and attacker.alive and extra == nil then
			attacker.meter = min(D.MeterMax, attacker.meter + D.MeterOnHit * (attacker.meterRate or 1))
		end
	end
	if victim.kind ~= "Boss" then
		victim.meter = min(D.MeterMax, victim.meter + D.MeterOnHurt * (victim.meterRate or 1))
	end
	local ev = { type = EV.Hit, from = attacker and attacker.id or nil, to = victim.id, dmg = floor(dmg + 0.5) }
	if mult ~= 1 then
		ev.elem = mult
	end
	if crit then
		ev.crit = true
	end
	if absorbed > 0 then
		ev.absorbed = floor(absorbed + 0.5)
	end
	if retreating then
		ev.retreat = true
	end
	if extra then
		for k, v in pairs(extra) do
			ev[k] = v
		end
	end
	events[#events + 1] = ev
	if victim.hp <= 0 then
		knockOut(self, victim, attacker, events)
	end
	return dmg + absorbed
end

----------------------------------------------------------------------
-- Targeting
----------------------------------------------------------------------
-- nearest living enemy, judged on start-of-step positions (px / pz) so every unit picks from the same picture of
-- the floor whatever its place in the update order
local function nearestEnemy(self, u, maxDist)
	local best, bestD2 = nil, (maxDist and maxDist * maxDist) or huge
	local list = self.units
	local side = u.side
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and e.alive and not e.gone then
			local dx, dz = e.px - u.px, e.pz - u.pz
			local d2 = dx * dx + dz * dz
			if d2 < bestD2 then
				best, bestD2 = e, d2
			end
		end
	end
	return best, bestD2
end

-- A pet keeps its current target while that one is still close to the nearest enemy (sticky), otherwise it picks
-- at random among the enemies about as near as the nearest: who gets focused and who is spared varies from fight
-- to fight, so a small edge in power is not a certain win (the owner's focus command overrides all of this).
local function pickTarget(self, u)
	local focus = u.team.focus
	if focus and focus.alive and not focus.gone and focus.side ~= u.side then
		return focus
	end
	local nearest, dmin2 = nearestEnemy(self, u)
	if not nearest then
		return nil
	end
	local D = damageRules()
	local sticky = num(D.TargetSticky, 1.6)
	local cur = u.target
	if cur and cur.alive and not cur.gone and cur.side ~= u.side then
		local dx, dz = cur.px - u.px, cur.pz - u.pz
		if dx * dx + dz * dz <= dmin2 * sticky * sticky then
			return cur
		end
	end
	local spread = num(D.TargetSpread, 1.35)
	local limit = dmin2 * spread * spread
	local count = 0
	local list = self.units
	local side = u.side
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and e.alive and not e.gone then
			local dx, dz = e.px - u.px, e.pz - u.pz
			if dx * dx + dz * dz <= limit then
				count = count + 1
				self.order2[count] = e
			end
		end
	end
	if count <= 1 then
		return nearest
	end
	return self.order2[randInt(self, 1, count)]
end

local function livingEnemies(self, side)
	local out = {}
	local list = self.units
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and e.alive and not e.gone then
			out[#out + 1] = e
		end
	end
	return out
end

----------------------------------------------------------------------
-- Specials
----------------------------------------------------------------------
local function specialRules(kind)
	local bc = catalog()
	local s = bc and type(bc.Specials) == "table" and bc.Specials[kind]
	if type(s) == "table" then
		return s
	end
	return nil
end

local function castSpecial(self, u, events)
	local kind = u.specialKind
	local S = kind and specialRules(kind)
	if not S then
		return false, "NoSpecial"
	end
	local D = damageRules()
	local base = u.specialPower * D.DamageScale * num(S.Scale, 1) * num(D.SpecialScale, 1)
	local offensive = kind ~= "Heal" and kind ~= "Shield"
	local target = nil
	if offensive then
		target = pickTarget(self, u)
		if not target then
			return false, "NoTarget"
		end
		if kind == "Pounce" and dist(u.x, u.z, target.x, target.z) > num(S.Range, 30) + target.radius then
			-- too far for the dash: pounce the nearest instead
			target = nearestEnemy(self, u, num(S.Range, 30) + 3)
			if not target then
				return false, "TooFar"
			end
		end
	end
	u.meter = 0
	u.castUntil = self.t + D.CastSeconds
	u.state = S_CASTING
	if u.nextAttack < u.castUntil then
		u.nextAttack = u.castUntil
	end
	u.autoCastAt = nil
	local ev = { type = EV.Special, unit = u.id, kind = kind, name = u.special and u.special.Name or kind, x = r1(u.x), z = r1(u.z) }
	if target then
		ev.tx, ev.tz = r1(target.x), r1(target.z)
		ev.target = target.id
	end
	local position = #events + 1 -- the Special event goes before the hits it causes
	local extra = { special = kind }
	if kind == "Blast" then
		local r = num(S.Radius, 7)
		local hits = {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inCircle(e, target.x, target.z, r) then
				hits[#hits + 1] = e
			end
		end
		ev.targets = {}
		for _, e in ipairs(hits) do
			ev.targets[#ev.targets + 1] = e.id
			applyDamage(self, u, e, base, events, extra)
		end
	elseif kind == "Heal" then
		ev.heals = {}
		for _, a in ipairs(u.team.units) do
			if a.alive and not a.gone and a.hp < a.maxHp then
				local amount = min(base, a.maxHp - a.hp)
				a.hp = a.hp + amount
				ev.heals[#ev.heals + 1] = { a.id, floor(amount + 0.5) }
			end
		end
	elseif kind == "Shield" then
		ev.shields = {}
		for _, a in ipairs(u.team.units) do
			if a.alive and not a.gone then
				if a.shield < base then
					a.shield = base
				end
				a.shieldUntil = self.t + num(S.Seconds, 8)
				ev.shields[#ev.shields + 1] = a.id
			end
		end
	elseif kind == "Storm" then
		local seconds = num(S.Seconds, 4)
		local zone = {
			x = target.x,
			z = target.z,
			r = num(S.Radius, 6),
			dps = base / seconds,
			untilT = self.t + seconds,
			nextTick = self.t + ZONE_TICK,
			side = u.side,
			from = u,
			kind = kind,
		}
		self.zones[#self.zones + 1] = zone
		events[#events + 1] = { type = EV.Zone, unit = u.id, kind = kind, x = r1(zone.x), z = r1(zone.z), r = zone.r, seconds = seconds, side = u.side }
	elseif kind == "Pounce" then
		-- dash next to the target and strike
		local dx, dz = target.x - u.x, target.z - u.z
		local d = sqrt(dx * dx + dz * dz)
		local stop = target.radius + u.radius + 0.5
		if d > stop then
			u.x = target.x - dx / d * stop
			u.z = target.z - dz / d * stop
			clampToFloor(self, u)
		end
		ev.targets = { target.id }
		applyDamage(self, u, target, base, events, extra)
	elseif kind == "Freeze" then
		local r = num(S.Radius, 7)
		local stun = num(S.Stun, 2) * (u.specialFactor or 1)
		ev.targets, ev.stunned = {}, {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inCircle(e, target.x, target.z, r) then
				ev.targets[#ev.targets + 1] = e.id
				if e.kind ~= "Boss" then
					local untilT = self.t + stun
					if e.stunUntil < untilT then
						e.stunUntil = untilT
					end
					e.state = S_STUNNED
					ev.stunned[#ev.stunned + 1] = e.id
				end
				applyDamage(self, u, e, base, events, extra)
			end
		end
	elseif kind == "Beam" then
		local dx, dz = target.x - u.x, target.z - u.z
		local angle = atan2(dz, dx)
		if dx == 0 and dz == 0 then
			angle = 0
		end
		ev.angle = r1(angle)
		ev.targets = {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inLine(e, u.x, u.z, angle, num(S.Length, 26), num(S.Width, 4)) then
				ev.targets[#ev.targets + 1] = e.id
				applyDamage(self, u, e, base, events, extra)
			end
		end
	else
		-- unknown kind: a plain strong hit
		ev.targets = { target.id }
		applyDamage(self, u, target, base, events, extra)
	end
	table.insert(events, position, ev)
	return true, kind
end

-- NPC / Auto teams decide when to use a full meter
local function autoSpecialWanted(self, u)
	local kind = u.specialKind
	if kind == "Heal" then
		for _, a in ipairs(u.team.units) do
			if a.alive and a.hp < a.maxHp * 0.8 then
				return true
			end
		end
		return false
	elseif kind == "Shield" then
		for _, a in ipairs(u.team.units) do
			if a.alive and a.hp < a.maxHp * 0.95 and a.shield <= 0 then
				return true
			end
		end
		return false
	end
	return true
end

----------------------------------------------------------------------
-- Boss patterns
----------------------------------------------------------------------
-- the boss's damage yardstick for one victim: a blend of its own max HP and the raid's average, scaled by the
-- head count (BossRules.DamageGroup: a lone team faces a gentler boss, a full arena the real thing)
function bossBasis(self, victim)
	local rules = (catalog() and catalog().BossRules) or {}
	local basis = type(rules.DamageBasis) == "table" and rules.DamageBasis or { Own = 0.6, Average = 0.4 }
	local group = type(rules.DamageGroup) == "table" and rules.DamageGroup or nil
	local factor = 1
	if group then
		local teams = self.playerTeamCount or 1
		local fullAt = max(2, num(group.FullAt, 8))
		local lo = num(group.Min, 0.6)
		factor = lo + (1 - lo) * min(1, (teams - 1) / (fullAt - 1))
	end
	return (num(basis.Own, 0.6) * victim.maxHp + num(basis.Average, 0.4) * self.avgPetHp) * factor
end

-- the point where the most enemy pets stand (within r of one of them)
local function clusterPoint(self, boss, r)
	local enemies = livingEnemies(self, boss.side)
	local best, bestCount = nil, -1
	for _, p in ipairs(enemies) do
		local count = 0
		for _, q in ipairs(enemies) do
			local dx, dz = q.x - p.x, q.z - p.z
			if dx * dx + dz * dz <= r * r then
				count = count + 1
			end
		end
		if count > bestCount then
			best, bestCount = p, count
		end
	end
	return best
end

-- the points an attack lands on. Circles: one per CirclesPerTeams player teams (max MaxCircles), each on a different
-- cluster / random pet, so big raids keep everyone busy; lines always aim at one point (Count fans them).
local function telegraphPoints(self, boss, a)
	local mode = a.Target or "Cluster"
	if mode == "Self" then
		return { { x = boss.x, z = boss.z } }
	end
	local enemies = livingEnemies(self, boss.side)
	if #enemies == 0 then
		return nil
	end
	local count = 1
	if a.Shape ~= "Line" then
		local rules = (catalog() and catalog().BossRules) or {}
		local teams = 0
		for _, team in ipairs(self.teams) do
			if team.side ~= boss.side and not team.left then
				teams = teams + 1
			end
		end
		count = max(1, min(num(rules.MaxCircles, 4), ceil(teams / num(rules.CirclesPerTeams, 2))))
	end
	local r = num(a.Radius, num(a.Width, 6))
	local points = {}
	local covered = {}
	for _ = 1, count do
		-- candidates not yet inside an earlier circle
		local pool = {}
		for _, e in ipairs(enemies) do
			if not covered[e] then
				pool[#pool + 1] = e
			end
		end
		if #pool == 0 then
			break
		end
		local p
		if mode == "Random" then
			p = pool[randInt(self, 1, #pool)]
		elseif mode == "Nearest" then
			p = pool[1]
			local bestD2 = huge
			for _, e in ipairs(pool) do
				local dx, dz = e.x - boss.x, e.z - boss.z
				local d2 = dx * dx + dz * dz
				if d2 < bestD2 then
					p, bestD2 = e, d2
				end
			end
		else
			local bestCount = -1
			for _, c in ipairs(pool) do
				local n = 0
				for _, q in ipairs(pool) do
					local dx, dz = q.x - c.x, q.z - c.z
					if dx * dx + dz * dz <= r * r then
						n = n + 1
					end
				end
				if n > bestCount then
					p, bestCount = c, n
				end
			end
		end
		points[#points + 1] = { x = p.x, z = p.z }
		for _, e in ipairs(pool) do
			local dx, dz = e.x - p.x, e.z - p.z
			if dx * dx + dz * dz <= (r + e.radius) * (r + e.radius) then
				covered[e] = true
			end
		end
	end
	return points
end

local function startTelegraph(self, boss, entry, events)
	local a = entry.def
	local points = telegraphPoints(self, boss, a)
	if not points or #points == 0 then
		return false
	end
	local delay = num(a.Telegraph, 2)
	local at = self.t + delay
	local shapes = {}
	if a.Shape == "Line" then
		local count = max(1, floor(num(a.Count, 1)))
		local spread = num(a.Spread, 0) * pi / 180
		local dx, dz = points[1].x - boss.x, points[1].z - boss.z
		if dx == 0 and dz == 0 then
			dz = 1
		end
		local baseAngle = atan2(dz, dx)
		-- the line ends a little past the pet it is aimed at: a team running home leaves it instead of running along it
		local length = min(num(a.Length, 40), sqrt(dx * dx + dz * dz) + BattleSim.LineOvershoot)
		for k = 1, count do
			shapes[#shapes + 1] = { x = boss.x, z = boss.z, angle = baseAngle + (k - (count + 1) / 2) * spread, length = r1(length), width = num(a.Width, 5) }
		end
	else
		for _, p in ipairs(points) do
			shapes[#shapes + 1] = { x = p.x, z = p.z, r = num(a.Radius, 8) }
		end
	end
	for _, shape in ipairs(shapes) do
		local id = self.nextTelegraphId
		self.nextTelegraphId = id + 1
		local tele = { id = id, boss = boss, attack = a, at = at, shape = a.Shape, x = shape.x, z = shape.z, angle = shape.angle, length = shape.length, width = shape.width, r = shape.r }
		self.telegraphs[#self.telegraphs + 1] = tele
		local ev = {
			type = EV.Telegraph,
			id = id,
			boss = boss.id,
			name = a.Name,
			attack = a.Id,
			shape = a.Shape,
			x = r1(tele.x),
			z = r1(tele.z),
			at = r1(at),
			hits = r1(delay),
		}
		if a.Shape == "Line" then
			ev.angle = floor(tele.angle * 1000 + 0.5) / 1000
			ev.length = tele.length
			ev.width = tele.width
		else
			ev.r = tele.r
		end
		if finite(a.Freeze) then
			ev.freeze = a.Freeze
		end
		if finite(a.Linger) then
			ev.linger = a.Linger
		end
		events[#events + 1] = ev
	end
	return true
end

local function resolveTelegraph(self, tele, events)
	local boss = tele.boss
	local a = tele.attack
	if not boss.alive then
		return
	end
	local extra = { tele = tele.id, attack = a.Id }
	local fraction = num(a.Damage, 0.3) * boss.damageMult
	for _, e in ipairs(livingEnemies(self, boss.side)) do
		local inside
		if tele.shape == "Line" then
			inside = inLine(e, tele.x, tele.z, tele.angle, tele.length, tele.width)
		else
			inside = inCircle(e, tele.x, tele.z, tele.r)
		end
		if inside then
			if finite(a.Freeze) and e.kind ~= "Boss" then
				local untilT = self.t + a.Freeze
				if e.stunUntil < untilT then
					e.stunUntil = untilT
				end
				e.state = S_STUNNED
				extra.freeze = a.Freeze
			end
			applyDamage(self, boss, e, fraction * bossBasis(self, e), events, extra)
		end
	end
	if finite(a.Linger) and tele.shape ~= "Line" then
		local perSecond = num(a.LingerDamage, 0.08) * self.avgPetHp * boss.damageMult
		self.zones[#self.zones + 1] = {
			x = tele.x,
			z = tele.z,
			r = tele.r,
			dps = perSecond,
			untilT = self.t + a.Linger,
			nextTick = self.t + ZONE_TICK,
			side = boss.side,
			from = boss,
			kind = "Linger",
		}
		events[#events + 1] = { type = EV.Zone, unit = boss.id, kind = "Linger", attack = a.Id, x = r1(tele.x), z = r1(tele.z), r = tele.r, seconds = a.Linger, side = boss.side }
	end
end

local function spawnMinions(self, boss, wave, waveIndex, events)
	local bc = catalog()
	local def = boss.boss
	local rules = (bc and bc.BossRules) or {}
	local players = 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.left then
			players = players + 1
		end
	end
	local count = ceil(num(wave.PerPlayer, 0.5) * players)
	count = max(num(rules.WaveMin, 2), min(num(rules.WaveMax, 8), count))
	local pc = petCatalog()
	local petDef = pc and pc.Get and def.MinionPet and pc.Get(def.MinionPet)
	if not petDef then
		return
	end
	local infos = {}
	for k = 1, count do
		local id = #self.units + 1
		if id > MAX_UNITS then
			break
		end
		local us = bc and bc.UnitStats and bc.UnitStats(petDef, self.avgPetLevel, "Normal")
		if not us then
			break
		end
		local angle = (k - 1) * (2 * pi / count) + self.t * 0.1
		local r = boss.radius + 3.5
		local u = {
			id = id,
			side = boss.side,
			team = boss.team,
			owner = boss.team.owner,
			slot = 0,
			kind = "Minion",
			def = petDef,
			key = petDef.Id,
			petId = petDef.Id,
			name = (def.Minions and def.Minions.Name) or petDef.Name,
			species = us.Species,
			elems = us.Elements,
			maxHp = num(rules.MinionHp, 0.9) * self.avgPetHp,
			hp = 0,
			hit = num(rules.MinionDamage, 0.05) * bossBasis(self, { maxHp = self.avgPetHp }),
			interval = num(rules.MinionInterval, 1.4),
			moveSpeed = us.MoveSpeed,
			range = us.Range,
			ranged = us.Ranged,
			radius = us.Radius,
			specialPower = 0,
			specialKind = nil,
			special = nil,
			powerMult = 1,
			level = self.avgPetLevel,
			minion = true,
			tier = "Normal",
			scale = 1,
			x = boss.x + cos(angle) * r,
			z = boss.z + sin(angle) * r,
			px = 0,
			pz = 0,
			state = S_IDLE,
			target = nil,
			nextAttack = self.t + 1 + rand(self) * 0.8,
			retargetAt = 0,
			meter = 0,
			shield = 0,
			shieldUntil = 0,
			stunUntil = 0,
			castUntil = 0,
			alive = true,
			gone = false,
			damage = 0,
		}
		u.hp = u.maxHp
		clampToFloor(self, u)
		u.px, u.pz = u.x, u.z
		self.units[id] = u
		boss.team.units[#boss.team.units + 1] = u
		infos[#infos + 1] = unitInfo(u)
	end
	if #infos > 0 then
		events[#events + 1] = { type = EV.Spawn, units = infos, wave = waveIndex, boss = boss.id, owner = boss.team.owner }
	end
end

local function bossStep(self, boss, events)
	if not boss.alive then
		return
	end
	local def = boss.boss
	local t = self.t
	-- enrage
	if not boss.enraged and finite(def.EnrageAt) and t >= def.EnrageAt then
		local rules = (catalog() and catalog().BossRules) or {}
		local en = type(rules.Enrage) == "table" and rules.Enrage or { Damage = 2, Cooldown = 0.7 }
		boss.enraged = true
		boss.damageMult = num(en.Damage, 2)
		boss.cooldownMult = num(en.Cooldown, 0.7)
		events[#events + 1] = { type = EV.Enrage, unit = boss.id }
	end
	-- minion waves at HP thresholds
	local waves = def.Minions and def.Minions.Waves
	if type(waves) == "table" then
		local frac = boss.hp / boss.maxHp
		for i, wave in ipairs(waves) do
			if not boss.wavesDone[i] and frac <= num(wave.At, 0) then
				boss.wavesDone[i] = true
				spawnMinions(self, boss, wave, i, events)
			end
		end
	end
	-- basic attack on the nearest pet in range
	if t >= boss.nextAttack then
		local target = nearestEnemy(self, boss, boss.range + boss.radius)
		if target then
			local basic = def.Basic or {}
			boss.target = target
			boss.state = S_ATTACKING
			applyDamage(self, boss, target, num(basic.Damage, 0.08) * boss.damageMult * bossBasis(self, target), events, { attack = basic.Name or "Basic" })
			boss.nextAttack = t + boss.interval * boss.cooldownMult
		else
			boss.state = S_IDLE
			boss.target = nearestEnemy(self, boss)
			boss.nextAttack = t + 0.5
		end
	end
	-- pattern attacks: one telegraph at a time per boss
	local pendingForBoss = false
	for _, tele in ipairs(self.telegraphs) do
		if tele.boss == boss then
			pendingForBoss = true
			break
		end
	end
	if not pendingForBoss then
		for _, entry in ipairs(boss.attacks) do
			if not pendingForBoss and t >= entry.nextAt then
				if startTelegraph(self, boss, entry, events) then
					boss.state = S_CASTING
					pendingForBoss = true
				end
				entry.nextAt = t + num(entry.def.Cooldown, 10) * boss.cooldownMult
			end
		end
	end
end

----------------------------------------------------------------------
-- The step
----------------------------------------------------------------------
local function tickZones(self, events)
	local zones = self.zones
	local i = 1
	while i <= #zones do
		local zone = zones[i]
		if self.t >= zone.untilT or (zone.from and zone.from.gone) then
			zones[i] = zones[#zones]
			zones[#zones] = nil
		else
			if self.t >= zone.nextTick then
				zone.nextTick = zone.nextTick + ZONE_TICK
				local amount = zone.dps * ZONE_TICK
				local list = self.units
				for k = 1, #list do
					local e = list[k]
					if e.side ~= zone.side and e.alive and not e.gone and inCircle(e, zone.x, zone.z, zone.r) then
						applyDamage(self, zone.from, e, amount, events, { zone = true, kind = zone.kind }, true)
					end
				end
			end
			i = i + 1
		end
	end
end

local function resolveTelegraphs(self, events)
	local list = self.telegraphs
	local i = 1
	while i <= #list do
		local tele = list[i]
		if self.t >= tele.at then
			resolveTelegraph(self, tele, events)
			table.remove(list, i)
		else
			i = i + 1
		end
	end
end

local function moveToward(u, tx, tz, step, stop)
	local dx, dz = tx - u.x, tz - u.z
	local d = sqrt(dx * dx + dz * dz)
	if d <= stop then
		return d
	end
	local travel = min(step, d - stop)
	u.x = u.x + dx / d * travel
	u.z = u.z + dz / d * travel
	return d - travel
end

-- a unit's place in its team (1..n) and the team size
local function teamIndex(team, u)
	local idx = 1
	for i, v in ipairs(team.units) do
		if v == u then
			idx = i
		end
	end
	return idx, #team.units
end

-- which side of a line (x, z, angle) the point (px, pz) is on: 1 / -1 (0 exactly on its axis)
local function lineSide(px, pz, x, z, angle)
	local cross = (px - x) * sin(angle) - (pz - z) * cos(angle)
	if cross > 0 then
		return 1
	elseif cross < 0 then
		return -1
	end
	return 0
end

-- The retreat spot of a pet: beside its owner's anchor (spread along the perpendicular), nudged out of any active
-- telegraph that covers it (sideways out of a Line, radially out of a Circle), kept on the floor.
local function retreatSpot(self, team, u)
	local idx, n = teamIndex(team, u)
	local cx, cz = -team.anchorX, -team.anchorZ
	local len = sqrt(cx * cx + cz * cz)
	if len < 0.01 then
		cx, cz, len = 0, 1, 1
	end
	local px, pz = -cz / len, cx / len
	local spread = (idx - (n + 1) / 2) * 2.4
	local x, z = team.anchorX + px * spread, team.anchorZ + pz * spread
	local margin = num(damageRules().TelegraphMargin, 1.5)
	for _ = 1, 2 do -- stepping out of one shape may land in another
		local tele = telegraphAt(self, u.side, x, z, u.radius)
		if not tele then
			break
		end
		if tele.shape == "Line" then
			-- out to the side the pet itself is on (retreatStep sends the pet toward this spot: one direction for both)
			local side = lineSide(u.x, u.z, tele.x, tele.z, tele.angle)
			if side == 0 then
				side = lineSide(x, z, tele.x, tele.z, tele.angle)
			end
			if side == 0 then
				side = (idx % 2 == 0) and 1 or -1
			end
			local dirX, dirZ = cos(tele.angle), sin(tele.angle)
			local perp = abs((x - tele.x) * dirZ - (z - tele.z) * dirX)
			local need = tele.width / 2 + u.radius + margin - perp
			x, z = x + side * need * dirZ, z - side * need * dirX
		else
			local dx, dz = x - tele.x, z - tele.z
			local d = sqrt(dx * dx + dz * dz)
			if d < 0.01 then
				dx, dz, d = -cx, -cz, len -- away from the floor centre
			end
			local need = tele.r + u.radius + margin
			x, z = tele.x + dx / d * need, tele.z + dz / d * need
		end
	end
	local hx, hz = max(0.5, self.zone.HalfX - u.radius), max(0.5, self.zone.HalfZ - u.radius)
	return max(-hx, min(hx, x)), max(-hz, min(hz, z))
end

-- one retreating pet: step sideways out of a Line telegraph it stands in, else run to its spot; regenerate
local function retreatStep(self, u, dt)
	local D = damageRules()
	local team = u.team
	if u.hp < u.maxHp then
		u.hp = min(u.maxHp, u.hp + u.maxHp * D.RetreatRegenPerSecond * dt)
	end
	local sx, sz = retreatSpot(self, team, u)
	local tele = telegraphAt(self, u.side, u.x, u.z, u.radius)
	if tele and tele.shape == "Line" then
		-- the shortest way out: past the line's end (lines stop just behind the pet they aim at; the same way out of
		-- every line of a fan) when that stays on the floor, else sideways
		local margin = num(D.TelegraphMargin, 1.5)
		local dirX, dirZ = cos(tele.angle), sin(tele.angle)
		local dx, dz = u.x - tele.x, u.z - tele.z
		local along = dx * dirX + dz * dirZ
		local perp = abs(dx * dirZ - dz * dirX)
		local outEnd = tele.length + u.radius + margin - along
		local outSide = tele.width / 2 + u.radius + margin - perp
		local step = u.moveSpeed * dt
		local ex, ez = tele.x + dirX * (along + outEnd), tele.z + dirZ * (along + outEnd)
		if outEnd < outSide and abs(ex) <= self.zone.HalfX - u.radius and abs(ez) <= self.zone.HalfZ - u.radius then
			u.x, u.z = u.x + dirX * step, u.z + dirZ * step
		else
			-- toward the side the spot lies on (the spot was moved out of this line on the pet's own side)
			local side = lineSide(sx, sz, tele.x, tele.z, tele.angle)
			if side == 0 then
				side = lineSide(u.x, u.z, tele.x, tele.z, tele.angle)
			end
			if side == 0 then
				side = (u.id % 2 == 0) and 1 or -1
			end
			u.x, u.z = u.x + side * dirZ * step, u.z - side * dirX * step
		end
		u.atHome = false
	else
		local left = moveToward(u, sx, sz, u.moveSpeed * dt, 0.3)
		u.atHome = left <= HOME_RADIUS
	end
	u.state = S_RETREATING
	u.target = nil
end

-- the ATTACK order (a command, or the end of a retreat): every living pet re-picks its target
local function orderAttack(self, team, focus)
	team.focus = focus
	team.order = ORDER_ATTACK
	for _, u in ipairs(team.units) do
		if u.alive then
			u.retargetAt = 0
			u.atHome = false
			if u.state == S_RETREATING then
				u.state = S_IDLE
			end
		end
	end
end

-- A retreating PLAYER team whose living pets are all parked, with no telegraph on any of them, goes back to attacking
-- RetreatLock + RetreatAutoResume seconds after the RETREAT (Npc / Auto teams keep their order until told otherwise).
local function resumeRetreats(self, events)
	local D = damageRules()
	local wait = num(D.RetreatLock, 1.5) + num(D.RetreatAutoResume, 3)
	for _, team in ipairs(self.teams) do
		if team.order == ORDER_RETREAT and not team.auto and not team.left and not team.forfeited and self.t >= team.retreatAt + wait then
			local ready = true
			for _, u in ipairs(team.units) do
				if u.alive and not u.gone and (not u.atHome or telegraphAt(self, u.side, u.x, u.z, u.radius)) then
					ready = false
					break
				end
			end
			if ready then
				orderAttack(self, team, nil)
				events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Attack", auto = true }
			end
		end
	end
end

local function unitStep(self, u, dt, events)
	local D = damageRules()
	local t = self.t
	local team = u.team
	-- timers
	if u.shield > 0 and t >= u.shieldUntil then
		u.shield = 0
	end
	if u.kind ~= "Boss" then
		u.meter = min(D.MeterMax, u.meter + D.MeterPerSecond * dt * (u.meterRate or 1))
	end
	if t < u.stunUntil then
		u.state = S_STUNNED
		return
	end
	if t < u.castUntil then
		u.state = S_CASTING
		return
	end
	if team.order == ORDER_RETREAT then
		retreatStep(self, u, dt)
		return
	end
	-- auto specials (NPC / harness teams)
	if team.auto and self.specialsEnabled and not team.noSpecials and u.specialKind and u.meter >= D.MeterMax and u.kind ~= "Minion" then
		if u.autoCastAt == nil then
			local lo, hi = D.NpcSpecialDelay[1] or 0.4, D.NpcSpecialDelay[2] or 1.4
			u.autoCastAt = t + lo + (hi - lo) * rand(self)
		elseif t >= u.autoCastAt then
			if autoSpecialWanted(self, u) then
				local ok = castSpecial(self, u, events)
				if ok then
					return
				end
				u.autoCastAt = t + 1
			else
				u.autoCastAt = t + 0.5
			end
		end
	end
	-- targeting
	local target = u.target
	if not target or not target.alive or target.gone or t >= u.retargetAt or (team.focus and team.focus.alive and target ~= team.focus) then
		target = pickTarget(self, u)
		u.target = target
		u.retargetAt = t + D.RetargetSeconds
	end
	if not target then
		u.state = S_IDLE
		return
	end
	-- movement aims at where the target stood at the START of this step (px / pz), so the order in which units are
	-- updated gives nobody a head start; the reach test afterwards uses the real positions of both
	local reach = u.range + target.radius
	local tx, tz = target.px, target.pz
	local d = dist(u.x, u.z, tx, tz)
	if d > reach then
		if target.kind == "Boss" then
			-- orbit slot: every pet of a team approaches the boss on its own angle, so one telegraph cannot catch the
			-- whole team and the pets surround the boss instead of queueing on one line
			local ax, az = team.anchorX - tx, team.anchorZ - tz
			local base = atan2(az, ax)
			if ax == 0 and az == 0 then
				base = 0
			end
			local idx, n = teamIndex(team, u)
			local angle = base + (idx - (n + 1) / 2) * (pi / 4)
			local r = reach - 0.5
			moveToward(u, tx + cos(angle) * r, tz + sin(angle) * r, u.moveSpeed * dt, 0.2)
		else
			moveToward(u, tx, tz, u.moveSpeed * dt, reach - 0.3)
		end
		u.state = S_MOVING
		d = dist(u.x, u.z, tx, tz)
	end
	-- the reach test also uses the target's start-of-step position: both sides judge range against where the
	-- other stood when the step began, so neither side swings a step earlier because it was updated later
	if d <= reach + D.EngageSlack then
		u.state = S_ATTACKING
		if t >= u.nextAttack then
			u.pendingTarget = target -- resolved with everyone else's attack after the movement phase (no first-strike bias)
		end
	elseif t >= u.nextAttack then
		-- on the way to a far target (a focus order, a kiting enemy) a ready pet still strikes whatever stands in reach
		local near, nd2 = nearestEnemy(self, u, u.range + 2.5 + D.EngageSlack)
		if near and nd2 <= (u.range + near.radius + D.EngageSlack) ^ 2 then
			u.pendingTarget = near
		end
	end
end

-- every attack that is ready lands at once, based on the positions after the whole movement phase, so neither side
-- gains from being updated first
local function resolveAttacks(self, events)
	local list = self.units
	local t = self.t
	for i = 1, #list do
		local u = list[i]
		local target = u.pendingTarget
		if target then
			u.pendingTarget = nil
			if not u.gone and target.alive and not target.gone then
				applyDamage(self, u, target, u.hit, events)
				-- swings drift +-10% so two equal units never stay in lockstep (the one updated first would
				-- otherwise land every killing blow a step early)
				u.nextAttack = t + u.interval * (0.9 + 0.2 * rand(self))
			end
		end
	end
end

-- push same-side units apart so they do not stack on one spot
local function separate(self)
	local D = damageRules()
	local r = D.SeparationRadius
	local r2 = r * r
	local list = self.units
	local n = #list
	for i = 1, n - 1 do
		local a = list[i]
		if a.alive and not a.gone and a.kind ~= "Boss" then
			for j = i + 1, n do
				local b = list[j]
				if b.alive and not b.gone and b.kind ~= "Boss" and b.side == a.side then
					local dx, dz = b.x - a.x, b.z - a.z
					local d2 = dx * dx + dz * dz
					if d2 < r2 then
						local d = sqrt(d2)
						local push
						if d < 0.001 then
							dx, dz, d = ((i % 2 == 0) and 1 or -1), 0.3, 1
						end
						push = (r - d) * 0.5
						if push > 0.6 then
							push = 0.6
						end
						dx, dz = dx / d, dz / d
						a.x, a.z = a.x - dx * push, a.z - dz * push
						b.x, b.z = b.x + dx * push, b.z + dz * push
					end
				end
			end
		end
	end
end

local function sideAlive(self, side)
	local count = 0
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if u.side == side and u.alive and not u.gone then
			count = count + 1
		end
	end
	return count
end

local function sideHpFraction(self, side)
	local hp, maxHp = 0, 0
	for _, u in ipairs(self.units) do
		if u.side == side and not u.gone and u.kind ~= "Minion" then
			hp = hp + max(0, u.hp)
			maxHp = maxHp + u.maxHp
		end
	end
	if maxHp <= 0 then
		return 0
	end
	return hp / maxHp
end

local function finish(self, winnerSide, reason, events)
	local result = {
		Mode = self.mode,
		Reason = reason,
		WinnerSide = winnerSide,
		Winners = {},
		Losers = {},
		Draw = winnerSide == nil,
		Forfeit = self.forfeitSeen == true,
		Level = self.level,
		BossId = self.bossId,
		Round = self.round,
		Damage = {},
		Shares = {},
		Duration = r1(self.t),
		Survivors = {},
		Hp = { [1] = sideHpFraction(self, 1), [2] = sideHpFraction(self, 2) },
	}
	local total = 0
	for _, team in ipairs(self.teams) do
		if not team.npc then
			result.Damage[team.owner] = floor(team.damage + 0.5)
			if team.side == 1 then
				total = total + team.damage
			end
			local alive = 0
			for _, u in ipairs(team.units) do
				if u.alive and not u.gone then
					alive = alive + 1
				end
			end
			result.Survivors[team.owner] = alive
			if not team.left then
				if winnerSide ~= nil and team.side == winnerSide and not team.forfeited then
					result.Winners[#result.Winners + 1] = team.owner
				elseif winnerSide ~= nil then
					result.Losers[#result.Losers + 1] = team.owner
				end
			end
		end
	end
	for _, team in ipairs(self.teams) do
		if not team.npc and team.side == 1 then
			result.Shares[team.owner] = (total > 0) and (team.damage / total) or 0
		end
	end
	if self.boss then
		result.BossHp = max(0, floor(self.boss.hp + 0.5))
		result.BossMaxHp = floor(self.boss.maxHp + 0.5)
	end
	self.result = result
	events[#events + 1] = { type = EV.End, reason = reason, winnerSide = winnerSide }
end

local function checkEnd(self, events)
	local alive1 = sideAlive(self, 1)
	local alive2 = sideAlive(self, 2)
	if self.mode == "Raid" then
		local boss = self.boss
		if boss and not boss.alive then
			finish(self, 1, "BossDown", events)
			return
		end
		local activeTeams = 0
		for _, team in ipairs(self.teams) do
			if team.side == 1 and not team.left then
				activeTeams = activeTeams + 1
			end
		end
		if activeTeams == 0 then
			finish(self, nil, "Abandoned", events)
			return
		end
		if alive1 == 0 then
			finish(self, 2, "Wipe", events)
			return
		end
		if self.t >= self.timeLimit then
			finish(self, 2, "Timeout", events)
			return
		end
		return
	end
	if alive1 == 0 and alive2 == 0 then
		-- Phase 4 (Damage.DoubleKoByDamage): a duel's double knock-out goes to the team that dealt more damage
		local rule = damageRules().DoubleKoByDamage
		local winner = nil
		if type(rule) == "table" and rule[self.mode] and not self.forfeitSeen then
			local d1, d2 = 0, 0
			for _, team in ipairs(self.teams) do
				if team.side == 1 then
					d1 = d1 + team.damage
				else
					d2 = d2 + team.damage
				end
			end
			if d1 > d2 then
				winner = 1
			elseif d2 > d1 then
				winner = 2
			end
		end
		if winner then
			finish(self, winner, "Wipe", events)
		else
			finish(self, nil, "Draw", events)
		end
	elseif alive1 == 0 then
		finish(self, 2, self.forfeitSeen and "Forfeit" or "Wipe", events)
	elseif alive2 == 0 then
		finish(self, 1, self.forfeitSeen and "Forfeit" or "Wipe", events)
	elseif self.t >= self.timeLimit then
		if self.mode == "Trial" or self.mode == "Ring" then
			finish(self, 2, "Timeout", events)
		else
			local f1, f2 = sideHpFraction(self, 1), sideHpFraction(self, 2)
			if abs(f1 - f2) < 0.001 then
				finish(self, nil, "Timeout", events)
			else
				finish(self, (f1 > f2) and 1 or 2, "Timeout", events)
			end
		end
	end
end

-- ends a running battle now with no winner (a server shutdown): the result keeps every team's damage and shares.
-- Returns ok and the End event (Step returns nothing more once finished).
function BattleSim:Abort(reason)
	if self.result then
		return false
	end
	local events = {}
	finish(self, nil, type(reason) == "string" and reason or "Aborted", events)
	return true, events
end

function BattleSim:Step(dt)
	local events = {}
	if self.result then
		return events
	end
	dt = tonumber(dt) or 0.1
	if dt ~= dt or dt < MIN_DT then
		dt = MIN_DT
	elseif dt > MAX_DT then
		dt = MAX_DT
	end
	self.t = self.t + dt
	self.stepCount = self.stepCount + 1
	-- overtime: every hit grows past overtimeAt (one Overtime event when it starts)
	if self.overtimeAt and self.t >= self.overtimeAt then
		if not self.overtimeMult then
			events[#events + 1] = { type = EV.Overtime, at = r1(self.overtimeAt), perSecond = self.overtimeRate }
		end
		self.overtimeMult = 1 + self.overtimeRate * (self.t - self.overtimeAt)
	end
	-- queued events (joins / leaves between steps)
	if #self.pending > 0 then
		for _, ev in ipairs(self.pending) do
			events[#events + 1] = ev
		end
		self.pending = {}
	end
	-- boss: patterns, basic attack, waves, enrage; then telegraphs that land now
	if self.boss then
		bossStep(self, self.boss, events)
	end
	resolveTelegraphs(self, events)
	tickZones(self, events)
	-- every other unit: timers, retreat, specials, targeting, movement (against start-of-step positions), in a
	-- seeded random order each step so no side profits from being updated first
	local list = self.units
	local n = #list
	local order = self.order
	for i = 1, n do
		local u = list[i]
		u.px, u.pz = u.x, u.z
		order[i] = i
	end
	for i = n, 2, -1 do
		local j = 1 + floor(rand(self) * i)
		order[i], order[j] = order[j], order[i]
	end
	for i = 1, n do
		local u = list[order[i]]
		if u.alive and not u.gone and u.kind ~= "Boss" then
			unitStep(self, u, dt, events)
		end
	end
	resolveAttacks(self, events)
	resumeRetreats(self, events)
	separate(self)
	for i = 1, #list do
		local u = list[i]
		if u.alive and not u.gone then
			clampToFloor(self, u)
		end
	end
	checkEnd(self, events)
	return events
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
function BattleSim:Command(owner, action, arg)
	if self.result then
		return false, "Finished"
	end
	local team = self.teamByOwner[owner]
	if not team then
		return false, "NoTeam"
	end
	if team.left then
		return false, "Left"
	end
	if team.forfeited then
		return false, "Forfeited"
	end
	local D = damageRules()
	local t = self.t
	if action == "Attack" then
		if team.order == ORDER_RETREAT then
			local ready = team.retreatAt + D.RetreatLock
			if t < ready then
				return false, "Regrouping", r1(ready - t)
			end
		end
		local focus = nil
		if arg ~= nil then
			local id = tonumber(arg)
			if not id or id ~= floor(id) then
				return false, "BadTarget"
			end
			local unit = self.units[id]
			if not unit or unit.gone or not unit.alive or unit.side == team.side then
				return false, "BadTarget"
			end
			focus = unit
		end
		orderAttack(self, team, focus)
		self.pending[#self.pending + 1] = { type = EV.Order, owner = owner, order = "Attack", target = focus and focus.id or nil }
		return true
	elseif action == "Retreat" then
		if team.order == ORDER_RETREAT then
			return false, "AlreadyRetreating"
		end
		team.order = ORDER_RETREAT
		team.retreatAt = t
		team.focus = nil
		for _, u in ipairs(team.units) do
			if u.alive then
				u.target = nil
				u.autoCastAt = nil
				u.atHome = false
				if u.state ~= S_STUNNED and u.state ~= S_CASTING then
					u.state = S_RETREATING
				end
			end
		end
		self.pending[#self.pending + 1] = { type = EV.Order, owner = owner, order = "Retreat" }
		return true
	elseif action == "Special" then
		if not self.specialsEnabled or team.noSpecials then
			return false, "Disabled"
		end
		local slot = tonumber(arg)
		if not slot or slot ~= floor(slot) then
			return false, "BadSlot"
		end
		local u = team.bySlot[slot]
		if not u then
			return false, "BadSlot"
		end
		if not u.alive then
			return false, "Down"
		end
		if not u.specialKind then
			return false, "NoSpecial"
		end
		if u.meter < D.MeterMax then
			return false, "Charging", floor(u.meter + 0.5)
		end
		if t < u.stunUntil then
			return false, "Stunned"
		end
		if t < u.castUntil then
			return false, "Casting"
		end
		if team.order == ORDER_RETREAT then
			return false, "Retreating"
		end
		local events = {}
		local ok, reason = castSpecial(self, u, events)
		if not ok then
			return false, reason
		end
		for _, ev in ipairs(events) do
			self.pending[#self.pending + 1] = ev
		end
		return true, reason
	elseif action == "Forfeit" then
		if self.mode == "Raid" then
			self:RemoveTeam(owner)
			return true
		end
		team.forfeited = true
		self.forfeitSeen = true
		local events = {}
		for _, u in ipairs(team.units) do
			if u.alive then
				knockOut(self, u, nil, events, true)
			end
		end
		self.pending[#self.pending + 1] = { type = EV.Order, owner = owner, order = "Forfeit" }
		for _, ev in ipairs(events) do
			self.pending[#self.pending + 1] = ev
		end
		return true
	end
	return false, "UnknownAction"
end

-- A team leaves (raids: LeaveRaid / disconnect). Its units vanish and the boss sheds their HP share.
function BattleSim:RemoveTeam(owner)
	local team = self.teamByOwner[owner]
	if not team or team.left or team.npc then
		return false
	end
	team.left = true
	local ids = {}
	for _, u in ipairs(team.units) do
		ids[#ids + 1] = u.id
		u.alive = false
		u.gone = true
		u.state = S_DOWN
		u.target = nil
	end
	-- other teams focusing one of these retarget
	for _, other in ipairs(self.teams) do
		if other.focus and other.focus.gone then
			other.focus = nil
		end
	end
	local boss = self.boss
	if boss and boss.alive and team.side == 1 then
		-- the leaver's share goes, at the boss's current HP fraction (BattleCatalog.BossHp over everyone still in)
		local frac = boss.hp / boss.maxHp
		boss.maxHp = max(1, self:_bossMaxHp())
		boss.hp = max(1, min(frac * boss.maxHp, boss.maxHp))
	end
	self:_refreshRaidScale()
	self.pending[#self.pending + 1] = { type = EV.Leave, owner = owner, units = ids }
	return true
end

return BattleSim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BossBuilder</string>
          <string name="Source"><![CDATA[-- BossBuilder (Phase 3, events): the four arena bosses as big DETAILED-VOXEL models (ARCHITECTURE_V3.md "Phase 3:
-- Pet battles", "Phase 3 build contract": EventService + BossBuilder; ART DIRECTION). Built on the CLIENT from a
-- BattleCatalog boss id (BattleController builds the raid boss; the server never moves these parts: Replication rule)
-- and animated locally between snapshots. Works in the Workspace and in ViewportFrames. Plain Lua 5.1-compatible.
--
-- API
--   BossBuilder.Build(bossId, opts) -> Model | nil
--       opts = { Detail = "High" | "Low" (default High; Low merges shades: about half the parts), Scale = n (default
--       BattleCatalog.Bosses[id].Scale or 1), CFrame = where the feet centre stands (LookVector = facing; default
--       identity), Parent, Pose = "Idle" (the first pose applied), PoseTime = 0 }.
--       The sculpt runs once per (bossId, detail, scale) and is cached: later builds clone it (fast). Call
--       BossBuilder.Preload(bossId) during the 2-minute raid announcement so the raid start never hitches.
--   BossBuilder.Animate(model, pose, t, opts)   applies a pose at time t (seconds, any running clock):
--       pose = "Idle" | "Windup" | "Attack" | "Basic" | "Enrage" | "Hurt" | "Down"
--       opts = { CFrame = the root CFrame this frame (the client's interpolated boss position; default: unchanged),
--                Progress = 0..1 (how far into a Windup / Attack / Basic / Enrage / Hurt / Down; default from t),
--                Attack = attack id (BattleCatalog.Bosses[id].Attacks[i].Id: picks the move, e.g. a one-arm zap or
--                the two-arm slam), Enraged = true (faster, fiercer idle) }
--       One BulkMoveTo per call (parts are anchored; only Workspace:BulkMoveTo or CFrame writes, nothing per part
--       allocated): cheap enough every frame for the one raid boss.
--   BossBuilder.SetEnraged(model, on)           the glowing parts (Glow / Eye / Bolt / Magma ... keys) turn the boss's
--                                               enrage colour (and back); the core light brightens
--   BossBuilder.Colors(bossId) -> { Glow, Telegraph, Edge, Enrage, Element }   (Color3s)
--   BossBuilder.TelegraphColor(bossId, attackId) -> fill Color3, edge Color3     colour of a floor telegraph
--   BossBuilder.FxPoint(model, name) -> Vector3 | nil   world position of a named effect point ("Mouth", "HandL",
--                                               "HandR", "Core", "Head1".."Head3", "Tail", "Crown"; see Rigs)
--   BossBuilder.GetHeight(model) -> studs       (also attribute Height; Radius = attribute Radius)
--   BossBuilder.Ids() -> { bossId... }          BattleCatalog.BossOrder (or the built-in list)
--   BossBuilder.Rigs[bossId]                    { Joints = { name -> { Parent, Pivot (voxels) } }, Fx = {...} }
--
-- Model layout (names are part of the contract: BattleController animates / attaches effects by them):
--   Boss_<id> (Model; attributes BossId, Element, Height, Radius, Detail, Scale; PrimaryPart = Root)
--     Root      invisible 1-stud part at the feet centre (the model's pivot; LookVector = facing)
--     Body      Model  the torso (every boss); its parts are named by palette key (Rock, Cloud, Scale, Glow, ...)
--     Head      Model  storm_titan / lava_golem / frost_wyrm          Jaw   Model  frost_wyrm (opens for the breath)
--     ArmL/ArmR Model  storm_titan / lava_golem (the fists that slam) Base  Model  storm_titan (its spinning vortex)
--     WingL/WingR Model frost_wyrm                                     Head1/Head2/Head3 Model shadow_hydra (L, C, R)
--   Every joint Model has attributes Pivot (Vector3, studs, Root space at rest) and JointParent (string, "" = Root).
--   Effect points are Attachments named "Fx_<name>" inside the joint that carries them.
-- Facing: -Z (Root.CFrame.LookVector). The bosses are 22-27 studs tall at Scale 1 (VoxelSize 0.5 stud), so they read
-- from the colosseum stands; High <= ~950 parts, Low <= ~700 (Low merges shades first).

local Shared = script.Parent
local Voxel = require(Shared:WaitForChild("Voxel"))

local BossBuilder = {}

local sin, cos, pi, max, min, floor, abs = math.sin, math.cos, math.pi, math.max, math.min, math.floor, math.abs

local VOXEL = 0.5 -- studs per voxel at Scale 1

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local lazyCatalog = nil
local function battleCatalog()
	if lazyCatalog == nil then
		lazyCatalog = false
		local inst = Shared:FindFirstChild("BattleCatalog")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				lazyCatalog = mod
			end
		end
	end
	return lazyCatalog or nil
end

local DEFAULT_IDS = { "storm_titan", "lava_golem", "frost_wyrm", "shadow_hydra" }

function BossBuilder.Ids()
	local bc = battleCatalog()
	local out = {}
	local src = (bc and type(bc.BossOrder) == "table" and #bc.BossOrder > 0) and bc.BossOrder or DEFAULT_IDS
	for i, id in ipairs(src) do
		out[i] = id
	end
	return out
end

----------------------------------------------------------------------
-- Colours: the glow, the floor telegraphs (fill + edge) and the enrage tint per boss
----------------------------------------------------------------------
local COLORS = {
	storm_titan = { Element = "Storm", Glow = rgb(110, 210, 255), Telegraph = rgb(80, 190, 255), Edge = rgb(255, 238, 140), Enrage = rgb(255, 92, 92) },
	lava_golem = { Element = "Flame", Glow = rgb(255, 112, 34), Telegraph = rgb(255, 104, 36), Edge = rgb(255, 214, 96), Enrage = rgb(255, 44, 44) },
	frost_wyrm = { Element = "Frost", Glow = rgb(140, 232, 255), Telegraph = rgb(110, 214, 255), Edge = rgb(240, 252, 255), Enrage = rgb(96, 120, 255) },
	shadow_hydra = { Element = "Shadow", Glow = rgb(196, 112, 255), Telegraph = rgb(170, 88, 255), Edge = rgb(255, 140, 236), Enrage = rgb(255, 60, 150) },
}
-- per attack overrides (BattleCatalog attack ids): fill, edge
local ATTACK_COLORS = {
	storm_titan = { slam = { rgb(80, 190, 255), rgb(255, 238, 140) }, chain = { rgb(255, 230, 110), rgb(255, 255, 220) } },
	lava_golem = { pool = { rgb(255, 128, 40), rgb(255, 214, 96) }, eruption = { rgb(255, 64, 32), rgb(255, 196, 80) } },
	frost_wyrm = { breath = { rgb(110, 214, 255), rgb(240, 252, 255) }, blizzard = { rgb(200, 236, 255), rgb(110, 190, 255) } },
	shadow_hydra = { fangs = { rgb(170, 88, 255), rgb(255, 140, 236) }, pulse = { rgb(236, 72, 200), rgb(255, 190, 250) } },
}

local FALLBACK_COLORS = { Element = "Storm", Glow = rgb(255, 220, 120), Telegraph = rgb(255, 90, 70), Edge = rgb(255, 230, 160), Enrage = rgb(255, 50, 50) }

function BossBuilder.Colors(bossId)
	local c = COLORS[bossId] or FALLBACK_COLORS
	return { Element = c.Element, Glow = c.Glow, Telegraph = c.Telegraph, Edge = c.Edge, Enrage = c.Enrage }
end

function BossBuilder.TelegraphColor(bossId, attackId)
	local per = ATTACK_COLORS[bossId]
	local a = per and per[attackId]
	if a then
		return a[1], a[2]
	end
	local c = COLORS[bossId] or FALLBACK_COLORS
	return c.Telegraph, c.Edge
end

----------------------------------------------------------------------
-- Sculpt helpers (voxel units; y up from the feet, the boss faces -Z, +X is its right)
----------------------------------------------------------------------
local function shape(g, t)
	return Voxel.Shape(g, t)
end
local function ell(g, key, c, r, extra)
	local t = { Kind = "Ellipsoid", Center = c, Radius = r, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function cap(g, key, a, b, r, rb, extra)
	local t = { Kind = "Capsule", A = a, B = b, Radius = r, RadiusB = rb, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function cone(g, key, a, b, r, rb, extra)
	local t = { Kind = "Cone", A = a, B = b, Radius = r, RadiusB = rb or 0, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function curve(g, key, pts, r, rb, extra)
	local t = { Kind = "Curve", Points = pts, Radius = r, RadiusB = rb, Key = key, Smooth = true }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function rbox(g, key, c, size, round, extra)
	local t = { Kind = "RoundBox", Center = c, Size = size, Round = round or 1, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function box(g, key, c, size, extra)
	local t = { Kind = "Box", Center = c, Size = size, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function paint(g, key, t, only)
	t.Key = key
	t.Op = "Paint"
	t.OnlyKeys = only
	if t.Kind == "Curve" and t.Smooth == nil then
		t.Smooth = true
	end
	return shape(g, t)
end
local function carve(g, t, only)
	t.Op = "Carve"
	t.OnlyKeys = only
	if t.Kind == "Curve" and t.Smooth == nil then
		t.Smooth = true
	end
	return shape(g, t)
end

-- a zig-zag lightning / crack path from a to b with n kinks (deterministic)
local function zigzag(a, b, n, amp, seed)
	local pts = { a }
	for i = 1, n - 1 do
		local f = i / n
		local h = Voxel.Hash(i, seed or 1, n, 7)
		local h2 = Voxel.Hash(seed or 1, i, 3, 11)
		pts[#pts + 1] = {
			a[1] + (b[1] - a[1]) * f + (h - 0.5) * 2 * amp,
			a[2] + (b[2] - a[2]) * f + (h2 - 0.5) * amp,
			a[3] + (b[3] - a[3]) * f + (h2 - h) * amp,
		}
	end
	pts[#pts + 1] = b
	return pts
end

