	nebula_axolotl = {
		Name = "Stardust Swirl", Plain = true, Rarity = "Epic", Element = "Water", Kind = "Haste",
		Forms = {
			{ Name = "Nebula Swirl", Twist = "a bigger cloud of stars around it", Slots = { Gust = "fx_stars" }, Tweak = { Gust = { Count = 14, Size = 1.2 } } },
			{ Name = "Supernova Swirl", Twist = "stars flash on each double hit",
				Twists = { DoubleHit = { Layers = { { Id = "SigSupernova", Kind = "Emitter", Texture = "fx_stars", Beat = "Impact", At = "Self", Count = 3, CountFixed = true, Size = 1.1 } } } } },
		},
	},
	candy_unicorn = {
		Name = "Sugar Rush", Plain = true, Rarity = "Legendary", Element = "Celestial", Kind = "Haste",
		Forms = {
			{ Name = "Candy Rush", Twist = "a rainbow candy trail", Tints = { Wind = rgb(255, 120, 200), Gust = rgb(140, 230, 255) }, Slots = { Gust = "fx_sparkle" } },
			{ Name = "Sugar Frenzy", Twist = "candy bursts on each double hit",
				Twists = { DoubleHit = { Layers = { { Id = "SigCandy", Kind = "Emitter", Texture = "fx_sparkle", Beat = "Impact", At = "Self", Color = rgb(255, 160, 220), Count = 4, CountFixed = true, Size = 1 } } } } },
		},
	},
}

----------------------------------------------------------------------
-- Rarity helpers
----------------------------------------------------------------------
local function cleanRarity(rarity)
	return (type(rarity) == "string" and rarityOrder[rarity]) and rarity or nil
end

local function cleanStage(stage)
	if not finite(stage) then
		return 0
	end
	return max(0, min(2, floor(stage)))
end

function AttackFxCatalog.BandOf(rarity)
	return AttackFxCatalog.Bands[cleanRarity(rarity) or "Common"]
end

function AttackFxCatalog.SizeOf(rarity, stage)
	local size = AttackFxCatalog.Sizes[cleanRarity(rarity) or "Common"]
	local bonus = AttackFxCatalog.StageBonus[cleanStage(stage)] or 0
	return min(AttackFxCatalog.SizeCap, size * (1 + bonus))
end

function AttackFxCatalog.CloudSizeOf(rarity, stage)
	return min(AttackFxCatalog.CloudCap, AttackFxCatalog.SizeOf(rarity, stage))
end

----------------------------------------------------------------------
-- Resolver
----------------------------------------------------------------------
local REACTIONS = AttackFxCatalog.Reactions
local HIT_AT = { Projectile = "Target", Swipe = "Target", Ground = "Target", Area = "Target", Self = "Self", Allies = "Allies" }
-- (evolved forms) a twist's ladder: its Burst x BurstBoost and no more (NoBurst: not even that); the Burst's size when the twist does not say
local TWIST_SKIP = REACTION_SKIP
local TWIST_SKIP_ALL = merge(copy(REACTION_SKIP), { Burst = true })
local TWIST_BURST = { Size = 0.7, Count = 0.5 }
-- (evolved forms) the kinds with an aura, the layers that hold through it (recipe.Aura)
local AURA_KINDS = { Rally = true, Haste = true }
local AURA_HOLD = { AllyRing = true, Rouse = true, Wind = true, Gust = true }

-- the attack definition: { Core, Beats, Skip, Layers (lists: kind / reaction layers), Detail (lists: the attack's own
-- element detail, e.g. Nature's thorns), Slots (list), Alive?, Extras? (= the element's impact detail), Kind?, Shape?,
-- Text, Special?, Twist? }
local function attackDef(req, element, sig)
	local attack = req.Attack
	if req.Twist ~= nil then -- (evolved forms) a form's delayed hit: the Twists recipe
		local tw = AttackFxCatalog.Twists[req.Twist]
		if not tw or (attack ~= "Special" and attack ~= "Element") then
			return nil
		end
		return {
			Core = tw.Core, Beats = copy(tw.Beats), Skip = tw.NoBurst and TWIST_SKIP_ALL or TWIST_SKIP, Layers = { tw.Layers or {} }, Detail = {}, Slots = { tw.Slots or {} }, Alive = false,
			Extras = false, Kind = (attack == "Special") and (req.Kind or (sig and sig.Kind)) or nil, Shape = tw.Shape, Text = tw.Text, BurstBoost = tw.BurstBoost or TWIST_BURST,
			BurstShape = tw.BurstShape, Short = true, Quiet = true, ThickBand = tw.ThickBand, Twist = req.Twist,
		}
	end
	if attack == "Melee" or attack == "Ranged" then
		local entry = element[attack]
		local base = AttackFxCatalog.Basic[attack]
		local beats = copy(base.Beats)
		if attack == "Melee" and entry.Path == "Ground" then
			beats.Travel = base.GroundTravel
		end
		local d = tonumber(req.Distance)
		if attack == "Melee" and base.LeapTravel and finite(d) then
			local lt = base.LeapTravel
			beats.Travel = beats.Travel + max(0, min(lt.Extra, (d - lt.Near) * lt.PerStud))
		end
		local detail = {} -- (no holes: ipairs) the attack's own layers, then the element's for this attack
		detail[#detail + 1] = base.Layers
		detail[#detail + 1] = entry.Layers
		return {
			Core = entry, Beats = beats, Skip = base.Skip or {}, Swap = base.Swap, Shot = base.Shot == true, BurstBoost = base.BurstBoost, Layers = {},
			LowKeep = entry.LowKeep, Drop = entry.Drop,
			Detail = detail, Slots = { entry }, Alive = true, Extras = true, Text = entry.Text,
		}
	elseif attack == "Element" then
		local shape = req.Shape
		if shape == nil then
			local bc = lazy("BattleCatalog")
			local ea = bc and type(bc.ElementAttacks) == "table" and bc.ElementAttacks[req.Element]
			shape = type(ea) == "table" and ea.Shape or "Cone"
		end
		local def = AttackFxCatalog.Shapes[shape]
		if not def then
			return nil
		end
		local area = element.Area or {}
		local core = copy(def.Core)
		if area.Key then
			core.Key, core.Count = area.Key, area.Count
		end
		if finite(area.Transparency) then -- (Task 9: Frost's see-through ice spikes)
			core.Transparency = area.Transparency
		end
		return { Core = core, Beats = copy(def.Beats), Skip = { Afterimage = true }, Layers = {}, Detail = { area.Layers }, Slots = {}, Alive = true, Extras = true, Shape = shape, Text = def.Text }
	elseif attack == "Special" then
		local kind = req.Kind
		if kind == nil and sig then
			kind = sig.Kind
		end
		local def = type(kind) == "string" and AttackFxCatalog.Specials[kind]
		if not def then
			return nil
		end
		-- (Task 10) the element's own take on the kind: Core fields merged over the kind's, its Slots / Layers / Drop /
		-- Tints / LowKeep on top (a signature still wins over both)
		local es = type(element.Specials) == "table" and element.Specials[kind] or nil
		if type(es) ~= "table" then
			es = {}
		end
		local core = merge(copy(def.Core), es.Core)
		local lowKeep = {}
		for _, list in ipairs({ es.LowKeep or {}, def.LowKeep or {} }) do
			for _, id in ipairs(list) do
				lowKeep[#lowKeep + 1] = id
			end
		end
		return {
			-- (review M1: no leading nil hole in the lists: slotsOf / ipairs read them in order)
			Core = core, Beats = copy(def.Beats), Skip = def.Skip or {}, Swap = def.Swap, Layers = { def.Layers or {}, es.Layers }, Detail = {},
			Slots = { def.Slots or {}, es.Slots }, Alive = true, Extras = def.Detail ~= false, Kind = kind, Text = def.Text, Special = true,
			BurstShape = def.BurstShape, LowKeep = lowKeep, Drop = es.Drop, Tints = es.Tints, CoreCount = def.CoreCount, ThickBand = def.ThickBand,
		}
	end
	local def = REACTIONS[attack]
	if not def then
		return nil
	end
	return {
		Core = def.Core, Beats = copy(def.Beats), Skip = def.Skip or {}, Layers = { def.Layers or {} }, Detail = {}, Slots = { def.Slots or {} }, Alive = false,
		Extras = false, Text = def.Text, BurstBoost = def.BurstBoost, LowKeep = def.LowKeep, Short = def.Short == true, Quiet = def.Quiet == true,
	}
end

local function slotsOf(def, element, sig)
	local refs = {
		Burst = element.Burst, Trail = element.Trail, Ground = element.Ground, Motif = element.Motif, Arc = element.Arc,
		RainKey = element.Rain.Key, RainTexture = element.Rain.Texture, RainKind = element.Rain.Kind or "Emitter",
		-- (Studio findings round) the Storm's rain sheet: thin falling streaks, unless the element's rain is solid / tumbling
		-- (Rain.Streak = false) or a Beam (Storm's lightning)
		RainStreak = (element.Rain.Streak == false or element.Rain.Kind == "Beam") and element.Rain.Texture or "fx_streak",
		-- (Task 10 kind slots: see Specials)
		ElementBurst = element.Burst, BurstMotion = element.BurstMotion or "Burst", Wrap = element.Trail, Ward = element.Motif, Gust = element.Trail,
	}
	for i = 1, #def.Slots do
		local s = def.Slots[i]
		if type(s) == "table" then
			for k in pairs(refs) do
				if s[k] ~= nil then
					refs[k] = s[k]
				end
			end
		end
	end
	if sig and type(sig.Slots) == "table" then
		for k, v in pairs(sig.Slots) do
			refs[k] = v
		end
	end
	return refs
end

local function ref(v, refs)
	if type(v) == "string" and string.sub(v, 1, 1) == "$" then
		return refs[string.sub(v, 2)]
	end
	return v
end

local function colourOf(spec, texture, palette, refs)
	if spec.Color ~= nil then
		return spec.Color
	end
	local t = texture and AttackFxCatalog.Textures[texture]
	if t and t.Baked then
		return WHITE
	end
	local tint = ref(spec.Tint, refs) or "Mid"
	return palette[tint] or palette.Mid
end

-- (Task 11c, review M2) the fields a signature's Tweak may set on a layer it keeps (smoke p7vfx_catalog checks every
-- Tweak names a layer its recipe has, with these fields only)
local TWEAK_FIELDS = { Transparency = true, Size = true, LightEmission = true, Color = true, Grow = true, Width = true, Delay = true, Count = true, Brightness = true, Range = true }
AttackFxCatalog.TweakFields = TWEAK_FIELDS

-- one concrete layer from a template, or nil when it has nothing to draw (an Emitter without a sheet)
local function buildLayer(id, tpl, ctx, scale)
	local layer = copy(tpl)
	layer.Id = id
	layer.Kind = ref(tpl.Kind, ctx.refs)
	layer.Texture = ref(tpl.Texture, ctx.refs)
	layer.Key = ref(tpl.Key, ctx.refs)
	layer.Motion = ref(tpl.Motion, ctx.refs) -- (Task 10: "$BurstMotion", the Rally roar moves like the element's burst)
	if layer.Kind == "Emitter" and layer.Texture == nil then
		return nil
	end
	if layer.Kind == "Light" or layer.Kind == "Ring" or layer.Kind == "Mesh" then
		layer.Texture = nil
	end
	local at = tpl.At
	if at == "$Hit" then
		at = ctx.hitAt
	end
	layer.At = at
	layer.Color = colourOf(tpl, layer.Texture, ctx.palette, ctx.refs)
	if ctx.tints and ctx.tints[id] then
		layer.Color = ctx.tints[id]
	end
	if tpl.Tint2 ~= nil then -- (Studio findings round) a second tone: the puffs are born in it (the cloud's lit underside)
		layer.Color2 = ctx.palette[tpl.Tint2] or ctx.palette.Mid -- (Task 11c, review M3: an unknown entry falls back like Tint)
	end
	layer.Tint2 = nil
	local count = tpl.Count
	local tweak = ctx.tweaks and ctx.tweaks[id]
	if type(tweak) == "table" then -- (a signature's Tweak on a layer it keeps: the whitelisted fields only, Task 11c M2)
		for k, v in pairs(tweak) do
			if TWEAK_FIELDS[k] then
				layer[k] = v
			end
		end
		if finite(tweak.Count) then -- (the full-density count: scaled below like the template's, never overwritten)
			count = tweak.Count
		end
	end
	if finite(count) then
		layer.Count = tpl.CountFixed and count or max(1, floor(count * (scale or ctx.countScale) + 0.5))
	end
	layer.Tint = nil
	layer.From = nil
	layer.Except = nil
	return layer
end

local function addExtras(out, list, tier, ctx, scale)
	if type(list) ~= "table" then
		return
	end
	for _, tpl in ipairs(list) do
		if (tpl.From or "Common") == tier and not (type(tpl.Except) == "table" and (tpl.Except[ctx.attack] or (ctx.kind and tpl.Except[ctx.kind])))
			and not (ctx.drop and ctx.drop[tpl.Id]) then
			local layer = buildLayer(tpl.Id, tpl, ctx, scale)
			if layer then
				out[#out + 1] = layer
			end
		end
	end
end

local function aliveOf(element, palette, countScale, sigTints)
	local a = copy(element.Alive)
	a.Color = (sigTints and sigTints.Alive) or (element.Tints and element.Tints.Alive) or colourOf(element.Alive, a.Texture, palette, {})
	a.Count = max(1, floor((a.Count or 1) * countScale + 0.5))
	a.Tint = nil
	return a
end

-- the kinds that heal, shield or buff: no impact, so nothing left on the ground and no camera kick (attack effects, 2026-11-01)
local SUPPORT_KINDS = { Heal = true, Shield = true, Rally = true, Haste = true }

-- an attack that lands on something: Melee / Ranged / Element and the damaging Specials (not a reaction, not a support cast)
local function isStrike(attack, kind)
	return attack == "Melee" or attack == "Ranged" or attack == "Element" or (attack == "Special" and not SUPPORT_KINDS[kind])
end

-- recipe.CameraPunch: false, or the kick of an own attack by kind and band (AttackFxCatalog.Kick)
local function kickOf(attack, kind, band, mine)
	if not mine or not isStrike(attack, kind) then
		return false
	end
	local K = AttackFxCatalog.Kick
	local basic = attack == "Melee" or attack == "Ranged"
	local base = (basic and K.Basic) or (attack == "Element" and K.Element) or K.Special
	return { Amount = min(K.Max, base + K.BandStep * (band - 1)), Crit = K.Crit, Seconds = K.Seconds, Basic = basic, Gap = K.BasicGap }
end

-- the impact package (spec 2026-11-01 "More effects"), x ImpactScale[band]: a Ring's Grow, a Decal's Size, an Emitter's
-- Count, a Light's Brightness (capped at 2; the Range never moves: the light caps stay, Task 8, and AttackFx keeps them on screen)
local PACKAGE = { Shockwave = true, Shockwave2 = true, Flash = true, Sparks = true, GroundGlow = true }

local function scaleImpact(layers, scale)
	for _, layer in ipairs(layers) do
		if PACKAGE[layer.Id] then
			if layer.Kind == "Ring" then
				layer.Grow = layer.Grow * scale
			elseif layer.Kind == "Decal" then
				layer.Size = layer.Size * scale
			elseif layer.Kind == "Emitter" then
				layer.Count = max(1, floor(layer.Count * scale + 0.5))
			elseif layer.Kind == "Light" then
				layer.Brightness = min(2, layer.Brightness * scale)
			end
		end
	end
end

-- AttackFx's emitter rule (isEmitter): an Emitter layer or a textured Decal
local function isEmitterLayer(layer)
	return layer.Kind == "Emitter" or (layer.Kind == "Decal" and type(layer.Texture) == "string")
end

-- who yields when the Sparks would pass the 6-emitter cap (AttackFx.MAX_EMITTERS.High), in this order, so a rarity's new
-- Trail / Slash never takes the package away from it (review, 2026-11-01). A basic or element hit gives up its Charge glow, the
-- engine's last-ranked emitter. A Special keeps its (the charge cues hang on it) and gives up the swing; a Beam or a Storm has
-- neither, its own layers fill the cap at every rarity and it goes without the Sparks
local CAP_YIELD = { Hit = { "Charge", "Slash", "Trail", "Sparks" }, Special = { "Slash", "Trail", "Sparks" } }

local function yieldLayer(recipe, id)
	for i, layer in ipairs(recipe.Layers) do
		if layer.Id == id then
			table.remove(recipe.Layers, i)
			recipe.Dropped = recipe.Dropped or {}
			recipe.Dropped[#recipe.Dropped + 1] = id
			return layer
		end
	end
	return nil
end

local function fitCap(recipe, attack, elementDetail)
	local count = isEmitterLayer(recipe.Alive) and 1 or 0
	local hasSparks, hasPulse = false, false
	for _, layer in ipairs(recipe.Layers) do
		if isEmitterLayer(layer) then
			count = count + 1
		end
		hasSparks = hasSparks or layer.Id == "Sparks"
		hasPulse = hasPulse or layer.Id == "Pulse"
	end
	-- (the Sparks yield as they did before the Beam had a Pulse: the Pulse takes nothing from the package)
	if hasSparks and count - (hasPulse and 1 or 0) > 6 then
		for _, id in ipairs(CAP_YIELD[(attack == "Special") and "Special" or "Hit"]) do
			local gone = yieldLayer(recipe, id)
			if gone then
				count = count - (isEmitterLayer(gone) and 1 or 0)
				break
			end
		end
	end
	-- (evolved forms, the owner: "today's beams look boring") a Beam still over the cap: the last of the element's impact details yields to its Pulse, the point of the
	-- cooler beam: the Wrap and the Burst still say which element it is. With none to give, the Pulse yields (the Wrap never does)
	if hasPulse and count > 6 then
		for i = #(elementDetail or {}), 1, -1 do
			local tpl = elementDetail[i]
			if count > 6 and isEmitterLayer(tpl) and yieldLayer(recipe, tpl.Id) then
				count = count - 1
			end
		end
		if count > 6 then
			yieldLayer(recipe, "Pulse")
		end
	end
end

----------------------------------------------------------------------
-- A form's look (evolved forms): what Resolve reads where a signature alone used to stand
----------------------------------------------------------------------
-- an Actor with another Key replaces the one below; with none its fields merge (the Rim's and Echo's too)
local function mergeActor(a, o)
	if type(o) ~= "table" then
		return a
	end
	if type(a) ~= "table" or (o.Key ~= nil and o.Key ~= a.Key) then
		return copy(o)
	end
	for k, v in pairs(o) do
		if (k == "Rim" or k == "Echo") and type(v) == "table" and type(a[k]) == "table" then
			merge(a[k], v)
		else
			a[k] = copy(v)
		end
	end
	return a
end

local LOOK_MERGED = { "Core", "Palette", "Slots", "Beats", "Tints", "Drop", "Skip" }
local LOOK_SCALARS = { "Name", "Twist", "Alive", "DimWorld" }

-- `into`, a look being built, with one more on top: its tables merge, its Layers go after, its LowKeep before (a pet's own pick first)
local function overlay(into, o)
	if type(o) ~= "table" then
		return into
	end
	for _, field in ipairs(LOOK_MERGED) do
		if type(o[field]) == "table" then
			into[field] = merge(into[field] or {}, o[field])
		end
	end
	if type(o.Tweak) == "table" then
		into.Tweak = into.Tweak or {}
		for id, fields in pairs(o.Tweak) do
			into.Tweak[id] = merge(into.Tweak[id] or {}, fields)
		end
	end
	if type(o.Layers) == "table" then
		into.Layers = into.Layers or {}
		for _, tpl in ipairs(o.Layers) do
			into.Layers[#into.Layers + 1] = tpl
		end
	end
	if type(o.LowKeep) == "table" then
		local keep = copy(o.LowKeep)
		for _, id in ipairs(into.LowKeep or {}) do
			keep[#keep + 1] = id
		end
		into.LowKeep = keep
	end
	into.Actor = mergeActor(into.Actor, o.Actor)
	for _, field in ipairs(LOOK_SCALARS) do
		if o[field] ~= nil then
			into[field] = o[field]
		end
	end
	return into
end

-- the look over this attack's recipe and whether it is a pet's own: a twist = its recipe's Actor + a pet's flavour from the stage that names it; a kind's form, then the
-- signature, then the pet's forms; an element's form; the start = the signature as it is (a Plain pet: the kind's recipe). No Form = the start, so a helper's buff stays plain
local function lookOf(req, def, sig, elementName)
	if def.Twist then
		local look = { Palette = sig and copy(sig.Palette), Tints = sig and copy(sig.Tints), Actor = copy(AttackFxCatalog.Twists[def.Twist].Actor), Name = AttackFxCatalog.Twists[def.Twist].Name }
		for n = 1, cleanStage(req.Form or req.Stage) do
			local form = sig and type(sig.Forms) == "table" and sig.Forms[n]
			overlay(look, form and type(form.Twists) == "table" and form.Twists[def.Twist])
		end
		return look, nil
	end
	local stage = cleanStage(req.Form)
	if stage >= 1 and req.Attack == "Special" then
		local look = {}
		local shared = AttackFxCatalog.Forms[def.Kind]
		for n = 1, stage do
			overlay(look, shared and shared[n])
		end
		overlay(look, sig)
		for n = 1, stage do
			overlay(look, sig and type(sig.Forms) == "table" and sig.Forms[n])
		end
		return look, sig
	end
	if stage >= 1 and req.Attack == "Element" then
		local look = {}
		local shared = AttackFxCatalog.ElementForms[elementName]
		for n = 1, stage do
			overlay(look, shared and shared[n])
		end
		return look, nil
	end
	if sig and sig.Plain then
		return nil, nil
	end
	return sig, sig
end

function AttackFxCatalog.Resolve(req)
	if type(req) ~= "table" then
		return nil
	end
	local petId = type(req.PetId) == "string" and req.PetId or nil
	local sig = (req.Attack == "Special" and petId) and AttackFxCatalog.Signatures[petId] or nil
	if sig and req.Kind ~= nil and req.Kind ~= sig.Kind then
		sig = nil -- a signature only replaces its own kind
	end
	local elementName = req.Element
	if elementName == nil and sig then
		elementName = sig.Element
	end
	local element = type(elementName) == "string" and AttackFxCatalog.Elements[elementName]
	if not element then
		return nil
	end
	local def = attackDef({ Attack = req.Attack, Kind = req.Kind, Shape = req.Shape, Element = elementName, Distance = req.Distance, Twist = req.Twist }, element, sig)
	if not def then
		return nil
	end

	local rarity = cleanRarity(req.Rarity) or "Common"
	local stage = cleanStage(req.Stage)
	local band = AttackFxCatalog.BandOf(rarity)
	local mine = req.Mine == true
	local B = AttackFxCatalog.Beats
	-- (evolved forms) from here on the look stands where the signature did; ownSig = the pet's own signature, for recipe.Signature
	local look, ownSig = lookOf(req, def, sig, elementName)

	local palette = merge(copy(element.Palette), look and look.Palette)
	palette.White = WHITE
	local refs = slotsOf(def, element, look)

	-- core
	local core = copy(def.Core)
	merge(core, look and look.Core)
	core.Key = ref(core.Key, refs)
	core.Text = nil
	core.Layers = nil
	for slotName in pairs(refs) do
		core[slotName] = nil -- slot overrides that rode on the element's Melee / Ranged entry
	end
	local bandLook = AttackFxCatalog.CoreLook[band]
	core.Color = palette[bandLook.Color] or palette.Mid
	core.InnerColor = bandLook.Inner and palette[(bandLook.Inner == "White" and element.PlasmaColor) or bandLook.Inner] or nil -- (Earth's band 4: a gold-hot heart)
	core.RimColor = bandLook.Rim and palette[bandLook.Rim] or nil
	core.RimShift = bandLook.RimShift == true
	core.Glow = bandLook.Glow
	core.Upgraded = bandLook.Upgraded == true
	if not (core.KeepMaterial and core.Material) then -- the Shield shell / Freeze cage stay Glass at every band
		core.Material = bandLook.Material or core.Material or element.Material or "Neon"
	end
	if core.Path == "Projectile" and not core.Stretch then
		core.Speed = core.Speed or (def.Shot and B.RangedSpeed) or B.ProjectileSpeed
	end
	-- (Task 10) a kind's core grows with the band: more falling pieces (Storm), a wider beam (Beam)
	if type(def.CoreCount) == "table" and finite(def.CoreCount[band]) then
		core.Count = def.CoreCount[band]
	end
	if type(def.ThickBand) == "table" and finite(def.ThickBand[band]) then
		core.Thick = def.ThickBand[band]
	end
	if finite(core.ThickK) and core.Thick then -- (evolved forms) a form's thicker Beam / Line, the Twin's thinner one
		core.Thick = core.Thick * core.ThickK
	end
	core.ThickK = nil
	-- (Task 11) a signature's core colour: Tint / InnerTint name the Palette entries its body / hot heart take instead of
	-- the band's (Ember's orange phoenix with a gold one inside, not the band's pale yellow round a blue-hot heart);
	-- NoTwin = no band 3+ quarter-turned twin (a phoenix crossed with itself reads as a spinning star)
	local sc = look and type(look.Core) == "table" and look.Core or nil
	if sc then
		if sc.Tint and palette[sc.Tint] then
			core.Color = palette[sc.Tint]
		end
		if sc.InnerTint and core.InnerColor and palette[sc.InnerTint] then
			core.InnerColor = palette[sc.InnerTint]
		end
		if sc.NoTwin then
			core.Upgraded = false
		end
	end
	core.Tint, core.InnerTint, core.NoTwin = nil, nil, nil

	-- beats
	local beats = merge(def.Beats, look and look.Beats)
	local special = def.Special == true
	local chargeStep = special and 0.05 or B.ChargeStep
	local charge = beats.Charge or 0
	if charge > 0 then
		-- (battle-feel T3) a special's charge x SpecialTempo before the band step and its cap
		charge = min(special and B.SpecialChargeMax or B.ChargeMax, charge * (special and B.SpecialTempo or 1) + chargeStep * (band - 1))
	end
	local travel = beats.Travel
	if core.Speed then
		if special then
			core.Speed = core.Speed * B.SpecialSpeed -- (battle-feel T3) the orb flies slower
		end
		local d = tonumber(req.Distance)
		if not finite(d) or d < 0 then
			d = B.DefaultDistance
		end
		travel = min(special and B.SpecialTravelMax or B.TravelMax, d / core.Speed)
		if def.Shot then
			travel = max(travel, B.MinTravel) -- a ranged shot is always seen flying (player note 1)
		end
	elseif special and finite(travel) and travel > 0 then
		travel = min(B.SpecialTravelMax, travel / B.SpecialSpeed) -- (battle-feel T3) the beam / rain / leap at SpecialSpeed
	end
	local linger = beats.Linger or 0.5
	if req.Attack ~= "Hurt" and not def.Short then
		linger = linger + B.LingerStep * (band - 1)
	end
	local out = {
		Charge = charge,
		Release = beats.Release or B.Release,
		Travel = travel or 0,
		Impact = beats.Impact or (special and B.SpecialImpact) or B.Impact,
		Linger = min(B.LingerMax, linger),
		MinTravel = def.Shot and min(travel or 0, B.MinTravel) or nil, -- the engine never cuts the shot's flight below this
	}

	-- layers: the ladder up to this rarity, each tier followed by the kind layers, the attack's and the element's impact
	-- detail and the signature layers of that tier (detail is From = "Common": every rarity shows it)
	local ctx = {
		refs = refs,
		palette = palette,
		hitAt = HIT_AT[core.Path] or "Target",
		countScale = AttackFxCatalog.CountScale[band],
		detailScale = AttackFxCatalog.DetailScale[band],
		-- (the element's Tints, then its own take on this special kind (Task 10), then a signature's)
		tints = (element.Tints or def.Tints or (look and look.Tints)) and merge(merge(copy(element.Tints or {}), def.Tints), look and look.Tints) or nil,
		attack = req.Attack,
		kind = def.Kind, -- the resolved kind (a signature special may come with Kind nil: Task 8 review)
		drop = def.Drop, -- the element's Melee / Ranged Drop: shared attack layers it replaces (Water's shot: no Boom ball)
		tweaks = look and type(look.Tweak) == "table" and look.Tweak or nil,
	}
	if look and type(look.Drop) == "table" then -- (Task 11) the kind / element layers a signature replaces (Rime: its glacier IS the spikes)
		ctx.drop = merge(copy(def.Drop or {}), look.Drop)
	end
	local sigSkip = look and type(look.Skip) == "table" and look.Skip or {} -- (Task 11) ladder layers a signature trades for its own
	local layers = {}
	local myOrder = rarityOrder[rarity]
	for _, step in ipairs(AttackFxCatalog.Ladder) do
		if rarityOrder[step.Tier] > myOrder then
			break
		end
		for _, ladderId in ipairs(step.Add) do
			if not def.Skip[ladderId] and not sigSkip[ladderId] then
				local id = (def.Swap and def.Swap[ladderId]) or ladderId -- (Ranged: Slash -> MuzzleRing, DoubleArc -> ShotArcs)
				local layer = buildLayer(id, AttackFxCatalog.LayerSlots[id], ctx)
				if layer then
					if id == "Burst" and def.BurstShape then
						layer.Shape = def.BurstShape
					end
					if id == "Burst" and def.BurstBoost then -- (the ranged impact explosion, player note (b))
						layer.Size = (layer.Size or 1) * def.BurstBoost.Size
						layer.Count = max(1, floor((layer.Count or 1) * def.BurstBoost.Count + 0.5))
					end
					if id == "Burst" and refs.Burst == element.Burst then
						layer.Motion = element.BurstMotion -- e.g. Water's geyser column, Shadow's void implosion
						local bs = element.BurstScale -- (Task 9: the element's own burst size / count, tuned in Studio)
						if bs then
							layer.Size = (layer.Size or 1) * (bs.Size or 1)
							layer.Count = max(1, floor((layer.Count or 1) * (bs.Count or 1) + 0.5))
							if finite(bs.Transparency) then -- (a see-through burst: the target stays readable inside it)
								layer.Transparency = bs.Transparency
							end
							if finite(bs.Speed) then -- (a burst flung further: Earth's chunks scatter instead of piling into a boulder)
								layer.SpeedScale = bs.Speed
							end
						end
						if finite(element.BurstLight) then -- (Task 9: an additive burst summed to white on the pale arena)
							layer.LightEmission = element.BurstLight
						end
						if element.BurstAt and layer.At == "Target" then -- (Task 9: Water's geyser erupts from the ground)
							layer.At = element.BurstAt
						end
					end
					layers[#layers + 1] = layer
				end
			end
		end
		for _, list in ipairs(def.Layers) do
			addExtras(layers, list, step.Tier, ctx)
		end
		for _, list in ipairs(def.Detail) do
			addExtras(layers, list, step.Tier, ctx, ctx.detailScale)
		end
		if def.Extras then
			addExtras(layers, element.Detail, step.Tier, ctx, ctx.detailScale)
		end
		if look then
			addExtras(layers, look.Layers, step.Tier, ctx)
		end
	end

	scaleImpact(layers, AttackFxCatalog.ImpactScale[band])

	-- (Task 9 Studio, Storm c2: the ranged Muzzle puff is the element's Burst sheet, but fully additive (fx_glow 1) it read
	-- as a white glare at the mouth: it takes the element's BurstLight like the Burst itself)
	if finite(element.BurstLight) then
		for _, layer in ipairs(layers) do
			if (layer.Id == "Muzzle" or layer.Id == "Roar") and layer.Texture == element.Burst then -- (Task 10: the Rally roar too)
				layer.LightEmission = element.BurstLight
			end
		end
	end

	-- (evolved forms) a Rally's / Haste's cast with its buff's seconds: these layers hold until the buff ends. A helper's buff has no Seconds: plain
	local aura = nil
	if AURA_KINDS[def.Kind] and not def.Twist and finite(req.Seconds) and req.Seconds > 0 then
		aura = req.Seconds
		for _, layer in ipairs(layers) do
			if AURA_HOLD[layer.Id] then
				layer.Linger = true
			end
		end
	end

	local recipe = {
		Element = elementName,
		Attack = req.Attack,
		Kind = def.Kind,
		Shape = def.Shape,
		Rarity = rarity,
		Stage = stage,
		Band = band,
		Size = AttackFxCatalog.SizeOf(rarity, stage),
		CloudSize = AttackFxCatalog.CloudSizeOf(rarity, stage),
		Density = mine and 1 or AttackFxCatalog.OthersDensity,
		Afterglow = (not def.Twist and isStrike(req.Attack, def.Kind)) and (special and AttackFxCatalog.SpecialAfterglow or AttackFxCatalog.Afterglow)[band] or 0,
		TailTrans = AttackFxCatalog.TailTransparency,
		CameraPunch = not def.Twist and kickOf(req.Attack, def.Kind, band, mine),
		ScreenGlow = mine and band == 4 and not def.Quiet,
		Signature = ownSig and petId or nil,
		Twist = def.Twist,
		Aura = aura,
		Palette = palette,
		Text = def.Text,
		Beats = out,
		ImpactAt = out.Charge + out.Release + out.Travel,
		Core = core,
		Layers = layers,
		-- (Task 11: a signature may leave the element's alive detail out (Alive = false: Sunbeam's ward has no bouncing rocks)
		-- or tint it, Tints.Alive: Obsidian's embers burn violet)
		Alive = (def.Alive and not (look and look.Alive == false)) and aliveOf(element, palette, ctx.detailScale, look and look.Tints) or {},
		LowKeep = {},
	}
	fitCap(recipe, req.Attack, def.Extras and element.Detail or nil)
	-- Low quality's second emitter after the Burst (AttackFx: MAX_EMITTERS.Low 2): the kind's pick, then the attack's,
	-- then the element's; the engine keeps the first one this effect has
	for _, list in ipairs({ (look and look.LowKeep) or {}, def.LowKeep or {}, element.LowKeep or {} }) do -- (a signature's own pick first)
		for _, id in ipairs(list) do
			recipe.LowKeep[#recipe.LowKeep + 1] = id
		end
	end
	if ownSig or (look and look.Actor) then -- (evolved forms: a shared form's or a twist's Actor too)
		local actor = copy(look.Actor)
		if actor then
			actor.Color = actor.Color or palette[actor.Tint or "Mid"] or palette.Mid
			actor.Tint = nil
			if type(actor.Rim) == "table" then -- (Task 11) the rim's colour: its own Color, else a Palette entry
				actor.Rim.Color = actor.Rim.Color or palette[actor.Rim.Tint or "Hot"] or palette.Hot
				actor.Rim.Tint = nil
			end
		end
		recipe.Sig = { Name = look.Name, Twist = look.Twist, Actor = actor, DimWorld = look.DimWorld }
	end
	return recipe
end

----------------------------------------------------------------------
-- Unit: what a battle unit's effects look like (from a BattleSim unitInfo)
----------------------------------------------------------------------
local function rarityOfPet(id)
	local pc = lazy("PetCatalog")
	if not pc or type(pc.Get) ~= "function" or type(id) ~= "string" then
		return nil
	end
	local ok, def = pcall(pc.Get, id)
	return ok and type(def) == "table" and cleanRarity(def.Rarity) or nil
end

-- a hybrid's rarity when its record gave none: the higher of its body and style pets (PetKeys hybridDef: higherRarity)
local function hybridRarity(look)
	local body, style = rarityOfPet(look.BodyId), rarityOfPet(look.StyleId)
	if body and style then
		return (rarityOrder[style] > rarityOrder[body]) and style or body
	end
	return body or style
end

function AttackFxCatalog.Unit(info)
	if type(info) ~= "table" then
		info = {}
	end
	local look = type(info.look) == "table" and info.look or {}
	local petId = type(info.petId) == "string" and info.petId or nil
	if petId == nil and type(info.key) == "string" and info.key ~= "" then
		petId = string.match(info.key, "^([^@]+)") -- "cat@Golden" -> "cat"; "hyb:<uid>@Golden" -> "hyb:<uid>"
	end
	local keyBase = type(info.key) == "string" and string.match(info.key, "^([^@]+)") or nil
	local rarity = cleanRarity(info.rarity) or cleanRarity(info.Rarity) or cleanRarity(look.Rarity)
		or rarityOfPet(petId) or rarityOfPet(keyBase) or hybridRarity(look) or "Common"
	local element = nil
	if type(info.elements) == "table" and type(info.elements[1]) == "string" then
		element = info.elements[1]
	elseif type(info.element) == "string" then
		element = info.element
	end
	if element ~= nil and not AttackFxCatalog.Elements[element] then
		element = nil
	end
	return {
		Element = element,
		Rarity = rarity,
		Stage = cleanStage(info.evo),
		PetId = petId,
		Ranged = info.ranged == true,
		Form = type(info.special) == "table" and info.special.Form or nil,
	}
end

return AttackFxCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
