	-- bug #6: spin bars are slower (readable, skill based) but hit harder; HazardService's defaults are the Hard row
	SpinSpeed = { { 35, 50 }, { 45, 60 }, { 55, 75 }, { 65, 90 }, { 75, 105 } },
	SpinDamage = { 12, 16, 22, 28, 34 },
	StormDPS = { 4, 5, 7, 10, 13 },
	LightningDamage = { 16, 20, 24, 28, 34 },
	LightningInterval = { 6, 5.5, 4.6, 4.0, 3.6 },
	LightningWarning = { 1.8, 1.6, 1.4, 1.2, 1.1 },
	VanishDelay = { 1.6, 1.3, 1.1, 0.95, 0.85 },
	VanishReturn = { 3.0, 3.2, 3.6, 4.0, 4.4 },
	BouncePower = { 70, 72, 75, 78, 80 },
	BounceSpeed = { 22, 23, 24, 25, 26 },
	MoveWidth = { { 5, 7 }, { 6, 9 }, { 7, 10 }, { 7, 10 }, { 7, 10 } },
	MovePeriod = { { 3.6, 4.4 }, { 3.0, 3.8 }, { 2.8, 3.4 }, { 2.6, 3.2 }, { 2.5, 3.0 } },
	PendDamage = { 12, 15, 19, 23, 28 },
	PendPeriod = { { 3.6, 4.2 }, { 3.2, 3.8 }, { 2.8, 3.4 }, { 2.5, 3.0 }, { 2.3, 2.8 } },
	PendArc = { { 28, 40 }, { 30, 42 }, { 34, 48 }, { 38, 54 }, { 42, 60 } },
	WindForce = { 12, 14, 18, 22, 26 },
	WindInterval = { 7, 6, 5, 4.5, 4 },
	WindWarning = { 1.8, 1.6, 1.4, 1.2, 1.0 },
	GoldenPerStage = { { 1, 1 }, { 1, 2 }, { 1, 2 }, { 2, 2 }, { 2, 2 } },
}
-- Fixed balance rules (the same on every tier). They live on TIER because the generator function is at Lua 5.1's
-- 60-upvalue limit (a new top-level local would break it):
--   CannonMaxApex   root peak above the pad top (bug #8: was 60, high enough to steer onto the steps above)
--   SpinSafeRing    free studs between a spin bar's end and the platform edge (bug #6), so a spin platform is at
--   SpinMinPlatform least 3 + 2 * SpinSafeRing wide (bar length >= 3)
--   SpinTwoBarTier  two crossed spin bars only from this tier on (the top difficulty)
TIER.CannonMaxApex = 35
TIER.SpinSafeRing = 2
TIER.SpinMinPlatform = 3 + 2 * TIER.SpinSafeRing
TIER.SpinTwoBarTier = 5

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

local function snap(v)
	return floor(v * 2 + 0.5) / 2
end

local function wrap180(a)
	a = a % 360
	if a > 180 then
		a = a - 360
	end
	return a
end

local function hypot(x, z)
	return sqrt(x * x + z * z)
end

local function tierOf(diff)
	for i, d in ipairs(Config.Difficulties) do
		if d.Id == diff.Id then
			return i
		end
	end
	return 1
end

local function byTier(tbl, tier)
	return tbl[min(tier, #tbl)]
end

-- weight of `id` inside a { id = weight } table (0 when absent)
local function weightIn(tbl, id)
	local w = tbl and tbl[id]
	if type(w) == "number" and w > 0 then
		return w
	end
	return 0
end

local function weightedPick(rng, list, weightOf)
	local total = 0
	for _, id in ipairs(list) do
		total = total + weightOf(id)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:Float(0, total)
	for _, id in ipairs(list) do
		local w = weightOf(id)
		if w > 0 then
			if roll <= w then
				return id
			end
			roll = roll - w
		end
	end
	for i = #list, 1, -1 do
		if weightOf(list[i]) > 0 then
			return list[i]
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Physics model shared by generator and validator
--   * a full-power jump to a step `rise` studs higher stays airborne airTime(rise)
--   * running covers RunSpeed * airTime; runReach keeps a 10% safety factor and 1.5 studs of margin
--   * a dash adds Config.Physics.DashBonus studs; dashReach keeps a 15% safety factor
----------------------------------------------------------------------
local function airTime(rise)
	if rise < 0 then
		rise = 0
	end
	local disc = PH.JumpPower * PH.JumpPower - 2 * PH.Gravity * rise
	if disc < 0 then
		return 0
	end
	return (PH.JumpPower + sqrt(disc)) / PH.Gravity
end

local function runReach(rise)
	return 0.9 * PH.RunSpeed * airTime(rise) - 1.5
end

local function dashReach(rise)
	return 0.85 * (PH.RunSpeed * airTime(rise) + PH.DashBonus)
end

local function dashRange(diff)
	local lo = diff.DashGapMin or 15
	local hi = diff.DashGapMax or 19
	hi = min(hi, 0.85 * PH.MaxDashGap)
	lo = max(lo, PH.MaxRunGap * 0.75 + 0.5)
	if lo > hi then
		lo = hi
	end
	return lo, hi
end

-- Horizontal studs a bounce pad launch covers before it descends through `rise + 0.3` (8% safety).
local function bounceReach(power, speed, rise)
	local disc = power * power - 2 * PH.Gravity * (rise + 0.3)
	if disc < 0 then
		return -1
	end
	local t = (power + sqrt(disc)) / PH.Gravity
	return 0.92 * speed * t
end

local function riseCapOf(diff)
	return min(diff.RiseMax, PH.JumpHeight * 0.7)
end

-- shortest time a vanishing step must stay solid so a runner can cross it and jump on
local function minVanishDelay(size)
	local diag = sqrt(size.X * size.X + size.Z * size.Z)
	return 0.3 + diag / PH.RunSpeed
end

----------------------------------------------------------------------
-- Geometry (all numbers; shapes are convex polygons in the XZ plane)
--   shape = { n = vertex count, [1..2n] = x,z pairs, cx, cz = centre, r = bounding radius about the centre }
--   Yaw convention: a step with Yaw = a has local +Z = (sin a, cos a) and local +X = (cos a, -sin a)
--   in world XZ, i.e. CFrame.Angles(0, rad(a), 0).
----------------------------------------------------------------------
local function rectShape(cx, cz, hx, hz, yawRad)
	local c, s = cos(yawRad), sin(yawRad)
	local ax, az = c * hx, -s * hx
	local bx, bz = s * hz, c * hz
	local sh = { n = 4, cx = cx, cz = cz, r = sqrt(hx * hx + hz * hz) }
	sh[1], sh[2] = cx - ax - bx, cz - az - bz
	sh[3], sh[4] = cx + ax - bx, cz + az - bz
	sh[5], sh[6] = cx + ax + bx, cz + az + bz
	sh[7], sh[8] = cx - ax + bx, cz - az + bz
	return sh
end

-- convex hull (Andrew monotone chain) of the points in `pts` (flat x,z array with n points)
local function hullShape(pts, n, cx, cz)
	local idx = {}
	for i = 1, n do
		idx[i] = i
	end
	table.sort(idx, function(a, b)
		local ax, bx = pts[2 * a - 1], pts[2 * b - 1]
		if ax ~= bx then
			return ax < bx
		end
		return pts[2 * a] < pts[2 * b]
	end)
	local function cross(o, a, b)
		return (pts[2 * a - 1] - pts[2 * o - 1]) * (pts[2 * b] - pts[2 * o])
			- (pts[2 * a] - pts[2 * o]) * (pts[2 * b - 1] - pts[2 * o - 1])
	end
	local hull = {}
	for _, i in ipairs(idx) do
		while #hull >= 2 and cross(hull[#hull - 1], hull[#hull], i) <= 0 do
			hull[#hull] = nil
		end
		hull[#hull + 1] = i
	end
	local lower = #hull
	for k = #idx - 1, 1, -1 do
		local i = idx[k]
		while #hull > lower and cross(hull[#hull - 1], hull[#hull], i) <= 0 do
			hull[#hull] = nil
		end
		hull[#hull + 1] = i
	end
	hull[#hull] = nil
	local sh = { n = #hull, cx = cx, cz = cz, r = 0 }
	for k, i in ipairs(hull) do
		local x, z = pts[2 * i - 1], pts[2 * i]
		sh[2 * k - 1], sh[2 * k] = x, z
		local d = hypot(x - cx, z - cz)
		if d > sh.r then
			sh.r = d
		end
	end
	return sh
end

-- footprint of a rectangle sliding from (cx, cz) to (cx + dx, cz + dz)
local function sweptShape(cx, cz, dx, dz, hx, hz, yawRad)
	local a = rectShape(cx, cz, hx, hz, yawRad)
	local b = rectShape(cx + dx, cz + dz, hx, hz, yawRad)
	local pts = {}
	for i = 1, 8 do
		pts[i] = a[i]
		pts[8 + i] = b[i]
	end
	return hullShape(pts, 8, cx + dx * 0.5, cz + dz * 0.5)
end

local function ptSeg2(px, pz, ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = 0
	if l2 > 1e-12 then
		t = ((px - ax) * dx + (pz - az) * dz) / l2
		if t < 0 then
			t = 0
		elseif t > 1 then
			t = 1
		end
	end
	local ex, ez = ax + t * dx - px, az + t * dz - pz
	return ex * ex + ez * ez
end

-- true when the two convex polygons intersect (separating axis test)
local function shapesOverlap(A, B)
	for pass = 1, 2 do
		local S, T = A, B
		if pass == 2 then
			S, T = B, A
		end
		local sn, tn = S.n, T.n
		for i = 1, sn do
			local j = i % sn + 1
			local x1, z1, x2, z2 = S[2 * i - 1], S[2 * i], S[2 * j - 1], S[2 * j]
			local nx, nz = z2 - z1, x1 - x2
			local smin, smax = huge, -huge
			for k = 1, sn do
				local d = nx * S[2 * k - 1] + nz * S[2 * k]
				if d < smin then
					smin = d
				end
				if d > smax then
					smax = d
				end
			end
			local tmin, tmax = huge, -huge
			for k = 1, tn do
				local d = nx * T[2 * k - 1] + nz * T[2 * k]
				if d < tmin then
					tmin = d
				end
				if d > tmax then
					tmax = d
				end
			end
			if smax < tmin or tmax < smin then
				return false
			end
		end
	end
	return true
end

-- Euclidean distance between two convex polygons (0 when they overlap). With `cut`, any answer >= cut
-- may be a lower bound instead of the exact value (fast reject by bounding circles).
local function shapeDist(A, B, cut)
	local ddx, ddz = A.cx - B.cx, A.cz - B.cz
	local cd = sqrt(ddx * ddx + ddz * ddz) - A.r - B.r
	if cut and cd > cut then
		return cd
	end
	if shapesOverlap(A, B) then
		return 0
	end
	local best = huge
	local an, bn = A.n, B.n
	for i = 1, an do
		local px, pz = A[2 * i - 1], A[2 * i]
		for j = 1, bn do
			local k = j % bn + 1
			local d = ptSeg2(px, pz, B[2 * j - 1], B[2 * j], B[2 * k - 1], B[2 * k])
			if d < best then
				best = d
			end
		end
	end
	for i = 1, bn do
		local px, pz = B[2 * i - 1], B[2 * i]
		for j = 1, an do
			local k = j % an + 1
			local d = ptSeg2(px, pz, A[2 * j - 1], A[2 * j], A[2 * k - 1], A[2 * k])
			if d < best then
				best = d
			end
		end
	end
	return sqrt(best)
end

-- distance from a point to a convex polygon (0 inside)
local function pointDist(px, pz, S)
	local pos, neg = false, false
	local best = huge
	local n = S.n
	for i = 1, n do
		local j = i % n + 1
		local ax, az, bx, bz = S[2 * i - 1], S[2 * i], S[2 * j - 1], S[2 * j]
		local cr = (bx - ax) * (pz - az) - (bz - az) * (px - ax)
		if cr > 0 then
			pos = true
		elseif cr < 0 then
			neg = true
		end
		local d = ptSeg2(px, pz, ax, az, bx, bz)
		if d < best then
			best = d
		end
	end
	if not (pos and neg) then
		return 0
	end
	return sqrt(best)
end

local function shapeRadius(S)
	local m = 0
	for i = 1, S.n do
		local d = hypot(S[2 * i - 1], S[2 * i])
		if d > m then
			m = d
		end
	end
	return m
end

-- min/max projection of a shape onto the axis (ux, uz)
local function project(S, ux, uz)
	local lo, hi = huge, -huge
	for i = 1, S.n do
		local d = ux * S[2 * i - 1] + uz * S[2 * i]
		if d < lo then
			lo = d
		end
		if d > hi then
			hi = d
		end
	end
	return lo, hi
end

-- Geometry record of a step-like table ({Pos, Size, Yaw, Kind, Hazard, Headroom}).
local function makeGeo(step)
	local pos, size = step.Pos, step.Size
	local yaw = (step.Yaw or 0) * RAD
	local g = {}
	g.cx, g.cz = pos.X, pos.Z
	g.hx, g.hz = size.X * 0.5, size.Z * 0.5
	g.yaw = yaw
	g.c, g.s = cos(yaw), sin(yaw)
	g.top = pos.Y
	g.th = size.Y
	g.bot = pos.Y - size.Y
	g.head = step.Headroom or Config.Course.Clearance
	g.kind = step.Kind
	g.rect = rectShape(g.cx, g.cz, g.hx, g.hz, yaw)
	g.hull = g.rect
	g.mx, g.mz = g.cx, g.cz -- middle of the sweep (== centre for static steps)
	local h = step.Hazard
	if step.Kind == "Moving" and type(h) == "table" and h.EndOffset then
		g.sx, g.sz = h.EndOffset.X, h.EndOffset.Z
		g.hull = sweptShape(g.cx, g.cz, g.sx, g.sz, g.hx, g.hz, yaw)
		g.mx, g.mz = g.cx + g.sx * 0.5, g.cz + g.sz * 0.5
	end
	return g
end

-- footprint of a step at fraction t (0..1) of its sweep
local function rectAt(g, t)
	if g.sx then
		return rectShape(g.cx + g.sx * t, g.cz + g.sz * t, g.hx, g.hz, g.yaw)
	end
	return g.rect
end

local function toWorld(g, lx, lz)
	return g.cx + lx * g.c + lz * g.s, g.cz - lx * g.s + lz * g.c
end

local function toLocal(g, x, z)
	local dx, dz = x - g.cx, z - g.cz
	return dx * g.c - dz * g.s, dx * g.s + dz * g.c
end

-- (min, max) edge-to-edge gap between two steps over every position of their sweeps
-- (at most one of the two may be a Moving step; two moving steps use their hulls).
local function gapRange(ga, gb)
	if not ga.sx and not gb.sx then
		local d = shapeDist(ga.rect, gb.rect)
		return d, d
	end
	local mover, still = ga, gb
	if not ga.sx then
		mover, still = gb, ga
	end
	if mover.sx and still.sx then
		local d = shapeDist(ga.hull, gb.hull)
		return d, huge
	end
	local function at(t)
		return shapeDist(rectAt(mover, t), still.rect)
	end
	local d0, d1 = at(0), at(1)
	local hi = max(d0, d1)
	-- distance is convex along a straight sweep: ternary search for the closest approach
	local a, b = 0, 1
	local lo = min(d0, d1)
	for _ = 1, 18 do
		local m1 = a + (b - a) / 3
		local m2 = b - (b - a) / 3
		local f1, f2 = at(m1), at(m2)
		if f1 < lo then
			lo = f1
		end
		if f2 < lo then
			lo = f2
		end
		if f1 < f2 then
			b = m2
		else
			a = m1
		end
	end
	return lo, hi
end

-- Overlap (studs) of the two footprints seen from the jump direction and the overlap a clean
-- straight run-and-jump needs. Both shapes are tested at the ends of their sweeps.
local function lateralOverlapOK(ga, gb)
	local function test(A, B)
		local dx, dz = B.cx - A.cx, B.cz - A.cz
		local d = hypot(dx, dz)
		if d < 1e-6 then
			return true
		end
		local ux, uz = -dz / d, dx / d
		local amin, amax = project(A, ux, uz)
		local bmin, bmax = project(B, ux, uz)
		local ov = min(amax, bmax) - max(amin, bmin)
		local need = min(LATERAL_NEED, 0.5 * min(amax - amin, bmax - bmin))
		return ov >= need - EPS
	end
	local ta = ga.sx and { 0, 1 } or { 0 }
	local tb = gb.sx and { 0, 1 } or { 0 }
	for _, t1 in ipairs(ta) do
		for _, t2 in ipairs(tb) do
			if not test(rectAt(ga, t1), rectAt(gb, t2)) then
				return false
			end
		end
	end
	return true
end

----------------------------------------------------------------------
-- Rules (the SAME functions prove a finished layout and filter every candidate the generator tries)
----------------------------------------------------------------------
local function isVec(v)
	return typeof(v) == "Vector3"
end

local function isNum(v)
	return type(v) == "number" and v == v and v > -1e9 and v < 1e9
end

local function minDimOf(size)
	return min(size.X, size.Z)
end

-- allowed Size.X / Size.Z ranges of a step kind: loX, hiX, loZ, hiZ
local function sizeBounds(kind, diff)
	local lo, hi = diff.PlatformMin, diff.PlatformMax
	if kind == "Start" then
		return 24, 40, 24, 40
	elseif kind == "Checkpoint" then
		return 14, 24, 14, 24
	elseif kind == "Finish" then
		return 28, 44, 28, 44
	elseif kind == "Beam" then
		return 2.5, 4, 14, 30
	elseif kind == "PendulumPlatform" or kind == "WindPlatform" then
		return 9, 15, 9, 15
	elseif kind == "CannonPad" then
		local a, b = max(lo, 7), max(hi, 7)
		return a, b, a, b
	elseif kind == "PlateBridge" then
		local a = max(lo, 7)
		return a, max(hi, a), a, max(hi, a)
	end
	return lo, hi, lo, hi
end

local function inFootprint(g, x, z, margin)
	local lx, lz = toLocal(g, x, z)
	return abs(lx) <= g.hx - margin + EPS and abs(lz) <= g.hz - margin + EPS
end

-- Launch velocity of the cannon for a rider whose root starts at (px, pz) on the pad.
local function cannonVelocity(padTop, px, pz, target, t)
	local g = PH.Gravity
	local py = padTop + ROOT_H
	return (target.X - px) / t, (target.Y - py) / t + g * t / 2, (target.Z - pz) / t, py
end

-- the five launch positions a rider can have on the pad (centre + four points of the pad circle)
local function cannonLaunchPoints(h)
	local r = h.PadRadius
	local x, z = h.Pos.X, h.Pos.Z
	return { { x, z }, { x + r, z }, { x - r, z }, { x, z + r }, { x, z - r } }
end

-- samples (every 0.02 s) of the five flight arcs { {x, y, z}, ... } (excluding the launch point itself)
local function cannonArcSamples(h, padTop)
	local out = {}
	local g = PH.Gravity
	local t = h.FlightTime
	local count = max(20, ceil(t / 0.02))
	for _, lp in ipairs(cannonLaunchPoints(h)) do
		local vx, vy, vz, py = cannonVelocity(padTop, lp[1], lp[2], h.Target, t)
		for k = 1, count do
			local tau = t * k / count
			out[#out + 1] = { lp[1] + vx * tau, py + vy * tau - 0.5 * g * tau * tau, lp[2] + vz * tau }
		end
	end
	return out
end

-- does the body of a rider at one arc sample touch a solid?
local function bodyHits(sample, s)
	local y = sample[2]
	if y + BODY_UP <= s.g.bot or y - BODY_DOWN >= s.g.top then
		return false
	end
	local hull = s.g.hull
	local dx, dz = sample[1] - hull.cx, sample[3] - hull.cz
	if hypot(dx, dz) - hull.r > BODY_R + 0.4 then
		return false
	end
	return pointDist(sample[1], sample[3], hull) < BODY_R + 0.4
end

local function sizeProblem(step, diff)
	local lx, hx, lz, hz = sizeBounds(step.Kind, diff)
	local sx, sy, sz = step.Size.X, step.Size.Y, step.Size.Z
	if sx < lx - EPS or sx > hx + EPS or sz < lz - EPS or sz > hz + EPS then
		return string.format("%s size %.1fx%.1f outside [%.1f-%.1f] x [%.1f-%.1f]", step.Kind, sx, sz, lx, hx, lz, hz)
	end
	if sy < 1 - EPS or sy > 6 then
		return string.format("thickness %.2f is not sensible", sy)
	end
	return nil
end

-- Rules of the cannon link pad -> landing (a = pad, b = landing).
local function cannonLinkProblem(diff, a, ga, b, gb, lo, hi, rise)
	local h = a.Hazard
	if type(h) ~= "table" or h.Type ~= "Cannon" then
		return "CannonPad has no Cannon hazard"
	end
	if not (isVec(h.Pos) and isVec(h.Target) and isVec(h.LandingPoint) and isNum(h.FlightTime) and isNum(h.PadRadius)) then
		return "Cannon hazard is missing Pos/Target/LandingPoint/FlightTime/PadRadius"
	end
	if b.Link ~= "Cannon" then
		return "landing step must have Link = Cannon"
	end
	if h.LandingIndex ~= b.Index then
		return "Cannon.LandingIndex does not name the next step"
	end
	if b.Kind ~= "Platform" or gb.sx then
		return "a cannon lands on a plain Platform"
	end
	if minDimOf(b.Size) < 7 - EPS then
		return "cannon landing island is smaller than 7x7"
	end
	if h.FlightTime < 1.0 - EPS or h.FlightTime > 2.2 + EPS then
		return string.format("cannon flight time %.2f outside [1.0, 2.2]", h.FlightTime)
	end
	local lx, lz = toLocal(gb, h.Target.X, h.Target.Z)
	if abs(lx) > gb.hx - 2.5 + EPS or abs(lz) > gb.hz - 2.5 + EPS then
		return string.format("cannon target (%.1f, %.1f) is not 2.5 studs inside the landing top", lx, lz)
	end
	if abs(h.Target.Y - (b.Pos.Y + ROOT_H)) > 0.05 or abs(h.LandingPoint.Y - b.Pos.Y) > 0.05 then
		return "cannon Target/LandingPoint height does not match the landing top"
	end
	if hypot(h.LandingPoint.X - h.Target.X, h.LandingPoint.Z - h.Target.Z) > 0.05 then
		return "cannon LandingPoint is not below Target"
	end
	if hypot(h.Pos.X - ga.cx, h.Pos.Z - ga.cz) > 0.5 or abs(h.Pos.Y - a.Pos.Y) > EPS then
		return "cannon pad is not at the middle of its step"
	end
	if h.PadRadius < 2 - EPS or h.PadRadius > min(minDimOf(a.Size) * 0.5 - 1, 4) + EPS then
		return "cannon pad radius does not fit its step"
	end
	local hdist = hypot(h.Target.X - h.Pos.X, h.Target.Z - h.Pos.Z)
	if hdist < 25 - EPS or hdist > 60 + EPS then
		return string.format("cannon flies %.1f studs (needs 25-60)", hdist)
	end
	if lo < dashReach(max(rise, 0)) + 1 then
		return string.format("cannon gap %.1f can be crossed without the cannon", lo)
	end
	if rise < -3 - RISE_EPS or rise > 10.5 + RISE_EPS then
		return string.format("cannon landing is %.1f above the pad (limit -3..10.5)", rise)
	end
	for idx, lp in ipairs(cannonLaunchPoints(h)) do
		local vx, vy, vz = cannonVelocity(a.Pos.Y, lp[1], lp[2], h.Target, h.FlightTime)
		local speed = sqrt(vx * vx + vy * vy + vz * vz)
		local apex = ROOT_H + (vy > 0 and vy * vy / (2 * PH.Gravity) or 0)
		if speed > 170 + EPS then
			return string.format("cannon launch speed %.1f exceeds 170", speed)
		end
		if apex > TIER.CannonMaxApex + EPS then
			return string.format("cannon peak %.1f above the pad exceeds %d", apex, TIER.CannonMaxApex)
		end
		if idx == 1 then
			if not isNum(h.Speed) or abs(h.Speed - speed) > 0.5 or not isNum(h.Apex) or abs(h.Apex - apex) > 0.5 then
				return "cannon Speed/Apex fields do not match the ballistics"
			end
			local aim = h.Aim
			if not isVec(aim) or abs(aim.Y) > EPS or abs(hypot(aim.X, aim.Z) - 1) > 0.01 then
				return "cannon Aim must be a horizontal unit vector"
			end
			local want = hypot(vx, vz)
			if want > 0.001 and (aim.X * vx + aim.Z * vz) / want < 0.99 then
				return "cannon Aim does not point at the target"
			end
		end
	end
	return nil
end

-- Rules of the link between two consecutive steps (a = previous, b = this one).
local function pairProblem(diff, a, ga, b, gb)
	local rise = b.Pos.Y - a.Pos.Y
	if rise < -MAX_DROP - RISE_EPS then
		return string.format("drops %.2f (limit -%d)", rise, MAX_DROP)
	end
	if ga.sx and gb.sx then
		return "two moving steps are adjacent"
	end
	local lo, hi = gapRange(ga, gb)
	if not isNum(b.Gap) or abs(b.Gap - hi) > 0.05 then
		return string.format("Gap field %s does not match the geometry (%.2f)", tostring(b.Gap), hi)
	end
	if a.Kind == "CannonPad" then
		return cannonLinkProblem(diff, a, ga, b, gb, lo, hi, rise)
	end
	if b.Link == "Cannon" then
		return "only the step after a CannonPad may have Link = Cannon"
	end
	if b.Kind == "DashGap" or b.Kind == "PlateBridge" then
		local dlo, dhi = dashRange(diff)
		if b.Link ~= "Dash" then
			return "dash-gap steps must have Link = Dash"
		end
		if lo < dlo - EPS or hi > dhi + EPS then
			return string.format("dash gap %.2f..%.2f outside [%.1f, %.1f]", lo, hi, dlo, dhi)
		end
		if hi > 0.85 * PH.MaxDashGap + EPS then
			return string.format("dash gap %.2f exceeds 0.85 * MaxDashGap", hi)
		end
		if lo <= PH.MaxRunGap * 0.75 then
			return string.format("dash gap %.2f does not need a dash", lo)
		end
		if rise < -RISE_EPS or rise > 2 + RISE_EPS then
			return string.format("dash gap rise %.2f outside [0, 2]", rise)
		end
		if hi > dashReach(rise) + EPS then
			return string.format("dash gap %.2f exceeds dash reach %.2f", hi, dashReach(rise))
		end
		if not STATIC_RUNUP[a.Kind] or ga.sx or gb.sx then
			return "a dash gap needs a static run-up platform (" .. tostring(a.Kind) .. ")"
		end
		local need = 5
		if b.Kind == "PlateBridge" then
			need = 7
		end
		if minDimOf(a.Size) < need - EPS then
			return "the run-up platform before a dash gap is too small"
		end
		local yawLimit = 20
		if b.Kind == "PlateBridge" then
			yawLimit = 0.5
		end
		if abs(wrap180((b.Yaw or 0) - (a.Yaw or 0))) > yawLimit then
			return "dash-gap step is not aligned with its run-up platform"
		end
		if not lateralOverlapOK(ga, gb) then
			return "dash-gap step is not in front of its run-up platform"
		end
		return nil
	end
	-- ordinary run-and-jump link
	if lo < diff.GapMin - EPS or hi > diff.GapMax + EPS then
		return string.format("gap %.2f..%.2f outside [%s, %s]", lo, hi, tostring(diff.GapMin), tostring(diff.GapMax))
	end
	local cap = riseCapOf(diff)
	local assisted = rise > cap + RISE_EPS
	if not assisted and hi > runReach(rise) + EPS then
		return string.format("gap %.2f exceeds run-jump reach %.2f for rise %.2f", hi, runReach(rise), rise)
	end
	local expectLink = "Walk"
	if assisted then
		-- only a bounce pad can lift the rider this high
		local h = a.Hazard
		if a.Kind ~= "Bounce" or type(h) ~= "table" or not isVec(h.Pos) or not isNum(h.Power) or not isNum(h.LaunchSpeed) then
			return string.format("rises %.2f (cap %.2f) without a bounce pad", rise, cap)
		end
		if rise > 9 + RISE_EPS then
			return string.format("bounce rise %.2f exceeds 9", rise)
		end
		local near = pointDist(h.Pos.X, h.Pos.Z, gb.hull)
		local reach = bounceReach(h.Power, h.LaunchSpeed, rise)
		if near > reach + EPS then
			return string.format("bounce pad reaches %.1f but the next step starts %.1f away", reach, near)
		end
		expectLink = "Bounce"
	end
	if b.Link ~= expectLink then
		return "Link should be " .. expectLink .. " but is " .. tostring(b.Link)
	end
	if not lateralOverlapOK(ga, gb) then
		return "consecutive steps only meet corner to corner"
	end
	return nil
end

-- Rules of one step's own hazard / hint / size. `prev`, `gPrev` are the previous step (may be nil for Start).
local function hazardProblem(diff, step, g, prev, gPrev)
	local kind = step.Kind
	local h = step.Hazard
	local expectType = HAZARD_OF_KIND[kind]
	if not expectType then
		if h ~= nil then
			return kind .. " must not carry a Hazard"
		end
	else
		if type(h) ~= "table" or h.Type ~= expectType then
			return kind .. " needs Hazard.Type = " .. expectType
		end
	end
	if not isNum(step.Headroom) or step.Headroom < Config.Course.Clearance - EPS then
		return "Headroom is missing or below Config.Course.Clearance"
	end
	if DECOR_HEAD[kind] and step.Headroom < DECOR_HEAD[kind] - EPS then
		return kind .. " Headroom must cover its decor (" .. DECOR_HEAD[kind] .. ")"
	end
	local minDim = minDimOf(step.Size)

	if kind == "Moving" then
		if not isVec(h.EndOffset) or not isNum(h.Period) then
			return "Moving lacks EndOffset/Period"
		end
		local travel = hypot(h.EndOffset.X, h.EndOffset.Z)
		if abs(h.EndOffset.Y) > EPS or travel < 3.5 - EPS then
			return "Moving must slide >= 3.5 studs horizontally"
		end
		if h.Period < 2 - EPS or travel / h.Period > 4.2 + EPS then
			return string.format("Moving is too fast (%.1f studs in %.2fs)", travel, h.Period)
		end
	elseif kind == "Vanishing" then
		if not isNum(h.VanishDelay) or not isNum(h.ReturnDelay) then
			return "Vanish lacks delays"
		end
		if h.VanishDelay < minVanishDelay(step.Size) - EPS then
			return string.format("Vanish after %.2fs but crossing needs %.2fs", h.VanishDelay, minVanishDelay(step.Size))
		end
		if h.ReturnDelay < h.VanishDelay + 1 - EPS or h.ReturnDelay > 8 then
			return "Vanish ReturnDelay is unfair"
		end
	elseif kind == "Bounce" then
		if not (isNum(h.Power) and isNum(h.LaunchSpeed) and isNum(h.PadSize) and isNum(h.Apex) and isVec(h.Pos)) then
			return "Bounce lacks Power/LaunchSpeed/PadSize/Apex/Pos"
		end
		if h.Power < 50 or h.Power > 90 or h.LaunchSpeed < 18 or h.LaunchSpeed > 30 then
			return "Bounce Power/LaunchSpeed out of range"
		end
		if h.PadSize < 2.5 - EPS or h.PadSize > minDim * 0.5 + EPS then
			return "Bounce pad does not fit its step"
		end
		if hypot(h.Pos.X - g.cx, h.Pos.Z - g.cz) > 0.5 or abs(h.Pos.Y - step.Pos.Y) > EPS then
			return "Bounce pad is not at the middle of its step"
		end
		if abs(h.Apex - h.Power * h.Power / (2 * PH.Gravity)) > 0.2 or step.Headroom < h.Apex + 1 - EPS then
			return "Bounce Headroom must exceed the bounce apex"
		end
	elseif kind == "SpinBarPlatform" then
		if not (isNum(h.Speed) and isNum(h.Damage) and isNum(h.Length) and isNum(h.Height) and isVec(h.Pos)) then
			return "SpinBar lacks Speed/Damage/Length/Height/Pos"
		end
		if h.Speed == 0 or abs(h.Speed) > 150 or h.Damage <= 0 then
			return "SpinBar Speed/Damage out of range"
		end
		if h.Count ~= 1 and h.Count ~= 2 then
			return "SpinBar Count must be 1 or 2"
		end
		if h.Count == 2 and tierOf(diff) < TIER.SpinTwoBarTier then
			return "SpinBar: two bars only on the top difficulty"
		end
		-- a TIER.SpinSafeRing stud ring between the bar's end and the platform edge always stays free (bug #6)
		if h.Length < 3 - EPS or h.Length > minDim - 2 * TIER.SpinSafeRing + EPS then
			return string.format("SpinBar length %.1f leaves no %.0f stud safe ring on a %.1f platform", h.Length, TIER.SpinSafeRing, minDim)
		end
		if hypot(h.Pos.X - g.cx, h.Pos.Z - g.cz) > 0.5 or abs(h.Pos.Y - step.Pos.Y) > EPS then
			return "SpinBar hub is not at the middle of its step"
		end
		if h.Height < 0.5 or h.Height > 2 then
			return "SpinBar Height out of range"
		end
	elseif kind == "StormPlatform" then
		local b = h.Box
		if not isNum(h.DPS) or h.DPS <= 0 or type(b) ~= "table" or not isVec(b.Pos) or not isVec(b.Size) or not isNum(b.Yaw) then
			return "Storm lacks DPS/Box"
		end
		if b.Size.Y < 4 or b.Size.Y > 9 or b.Size.X < step.Size.X - EPS or b.Size.Z < step.Size.Z - EPS then
			return "Storm box must cover the footprint and be 4-9 tall"
		end
		if step.Headroom < b.Size.Y + 3.5 - EPS then
			return "Storm Headroom must exceed the cloud height + 3.5"
		end
	elseif kind == "LightningPlatform" then
		if not (isNum(h.Damage) and isNum(h.Interval) and isNum(h.Warning)) or type(h.Zones) ~= "table" then
			return "Lightning lacks Damage/Interval/Warning/Zones"
		end
		if h.Interval < 2.5 or h.Warning < 0.8 or h.Warning > h.Interval - 1.2 + EPS then
			return string.format("Lightning timing %.1f / %.1f is unfair", h.Interval, h.Warning)
		end
		if #h.Zones < 1 or #h.Zones > 3 then
			return "Lightning needs 1-3 zones"
		end
		local zs = {}
		for i, z in ipairs(h.Zones) do
			if type(z) ~= "table" or not isVec(z.Pos) or not isNum(z.Radius) or z.Radius < 1.5 then
				return "Lightning zone is malformed"
			end
			local lx, lz = toLocal(g, z.Pos.X, z.Pos.Z)
			if abs(lx) + z.Radius > g.hx + EPS or abs(lz) + z.Radius > g.hz + EPS or abs(z.Pos.Y - step.Pos.Y) > EPS then
				return "Lightning zone leaves the platform"
			end
			zs[i] = { lx, lz, z.Radius }
		end
		-- a safe spot: somewhere on the platform clear of every strike disc by 1.2 studs
		local safe = false
		local x = -g.hx + 0.8
		while x <= g.hx - 0.8 + 1e-6 and not safe do
			local z = -g.hz + 0.8
			while z <= g.hz - 0.8 + 1e-6 do
				local ok = true
				for _, q in ipairs(zs) do
					if hypot(x - q[1], z - q[2]) < q[3] + 1.2 then
						ok = false
						break
					end
				end
				if ok then
					safe = true
					break
				end
				z = z + 0.5
			end
			x = x + 0.5
		end
		if not safe then
			return "Lightning platform has no safe spot"
		end
		if step.Headroom < 12 - EPS then
			return "Lightning Headroom must be >= 12"
		end
	elseif kind == "PendulumPlatform" then
		if not (isVec(h.Hinge) and isVec(h.Axis) and isVec(h.BeamSize) and isNum(h.Arc) and isNum(h.Period)
			and isNum(h.Damage) and isNum(h.Length)) then
			return "Pendulum lacks Hinge/Axis/BeamSize/Arc/Period/Damage/Length"
		end
		if abs(h.Axis.Y) > EPS or abs(hypot(h.Axis.X, h.Axis.Z) - 1) > 0.01 then
			return "Pendulum Axis must be a horizontal unit vector"
		end
		if h.Arc < 20 or h.Arc > 70 or h.Period < 2 or h.Damage <= 0 or h.Length < 4 or h.Length > 9 then
			return "Pendulum Arc/Period/Damage/Length out of range"
		end
		if abs(h.BeamSize.Y - h.Length) > EPS then
			return "Pendulum BeamSize.Y must equal Length"
		end
		local rest = h.Hinge.Y - step.Pos.Y - h.Length
		if rest < 1.0 - EPS then
			return "Pendulum beam hangs lower than 1 stud above the platform"
		end
		if step.Headroom < h.Hinge.Y - step.Pos.Y + 1 - EPS then
			return "Pendulum Headroom must exceed the hinge height"
		end
		local swx, swz = -h.Axis.Z, h.Axis.X
		local ex1, ex2, ez1, ez2 = g.c, -g.s, g.s, g.c
		local es = g.hx * abs(swx * ex1 + swz * ex2) + g.hz * abs(swx * ez1 + swz * ez2)
		local ea = g.hx * abs(h.Axis.X * ex1 + h.Axis.Z * ex2) + g.hz * abs(h.Axis.X * ez1 + h.Axis.Z * ez2)
		local dx, dz = h.Hinge.X - g.cx, h.Hinge.Z - g.cz
		local ps = dx * swx + dz * swz
		local pa = dx * h.Axis.X + dz * h.Axis.Z
		local sweep = h.Length * sin(h.Arc * RAD)
		if abs(ps) + sweep > es - 1.0 + EPS then
			return "Pendulum swings beyond the platform edge"
		end
		if h.BeamSize.X * 0.5 + abs(pa) > ea + EPS then
			return "Pendulum beam is wider than the platform"
		end
	elseif kind == "WindPlatform" then
		local z = h.Zone
		if not (isNum(h.Force) and isNum(h.Interval) and isNum(h.Warning) and isNum(h.Duration) and isVec(h.Direction))
			or type(z) ~= "table" or not isVec(z.Pos) or not isVec(z.Size) or not isNum(z.Yaw) then
			return "Wind lacks Force/Interval/Warning/Duration/Direction/Zone"
		end
		if h.Force < 5 or h.Force > 26 + EPS then
			return string.format("Wind force %.1f outside [5, 26]", h.Force)
		end
		if abs(h.Direction.Y) > EPS or abs(hypot(h.Direction.X, h.Direction.Z) - 1) > 0.01 then
			return "Wind Direction must be a horizontal unit vector"
		end
		if h.Interval < 3 or h.Warning < 0.8 or h.Warning > h.Interval - 1 or h.Duration < 1 or h.Duration > 2 then
			return "Wind timing is unfair"
		end
		if z.Size.X < 3.5 or z.Size.Z < 3.5 or z.Size.Y < 5 or step.Headroom < z.Size.Y + 0.5 - EPS then
			return "Wind zone is too small or Headroom too low"
		end
		local zs = rectShape(z.Pos.X, z.Pos.Z, z.Size.X * 0.5, z.Size.Z * 0.5, z.Yaw * RAD)
		for i = 1, 4 do
			if not inFootprint(g, zs[2 * i - 1], zs[2 * i], 0) then
				return "Wind zone leaves the platform"
			end
		end
		local _, platMax = project(g.rect, h.Direction.X, h.Direction.Z)
		local _, zoneMax = project(zs, h.Direction.X, h.Direction.Z)
		if platMax - zoneMax < 4.9 then
			return string.format("Wind leaves only %.1f studs of calm lee on the platform", platMax - zoneMax)
		end
	elseif kind == "CannonPad" then
		-- link rules live in cannonLinkProblem; only the shape of the hazard is checked here
		if not isVec(h.Pos) or not isNum(h.PadRadius) then
			return "Cannon lacks Pos/PadRadius"
		end
		if step.Headroom < 9 - EPS then
			return "CannonPad Headroom must be >= 9"
		end
	elseif kind == "PlateBridge" then
		if not prev then
			return "PlateBridge has no previous step"
		end
		local sp = h.Span
		if not isNum(h.BridgeNumber) or type(sp) ~= "table" or not isVec(sp.Pos) or not isVec(sp.Size) or not isNum(sp.Yaw)
			or type(h.Sides) ~= "table" or #h.Sides ~= 2 then
			return "PlateBridge lacks BridgeNumber/Span/Sides"
		end
		if abs(sp.Pos.Y - prev.Pos.Y) > EPS or abs(step.Pos.Y - prev.Pos.Y) > EPS then
			return "PlateBridge span is not level with its platforms"
		end
		if abs(wrap180(sp.Yaw - (step.Yaw or 0))) > 0.5 or sp.Size.X < 3 - EPS or sp.Size.Y < 0.5 then
			return "PlateBridge span is malformed"
		end
		local spanShape = rectShape(sp.Pos.X, sp.Pos.Z, sp.Size.X * 0.5, sp.Size.Z * 0.5, sp.Yaw * RAD)
		if shapeDist(spanShape, gPrev.rect) > 0.05 or shapeDist(spanShape, g.rect) > 0.05 then
			return "PlateBridge span does not reach both platforms"
		end
		for _, gg in ipairs({ gPrev, g }) do
			local lx = toLocal(gg, sp.Pos.X, sp.Pos.Z)
			if abs(lx) + sp.Size.X * 0.5 > gg.hx + EPS then
				return "PlateBridge span is wider than the platform it lands on"
			end
		end
		local seen = {}
		local gmax = min(diff.GapMax, runReach(0))
		for _, side in ipairs(h.Sides) do
			if type(side) ~= "table" or not isVec(side.Pos) or not isVec(side.Size) or not isNum(side.Yaw)
				or type(side.Plate) ~= "table" or not isVec(side.Plate.Pos) or not isVec(side.Plate.Size) then
				return "PlateBridge side platform is malformed"
			end
			local anchor, ganchor
			if side.From == prev.Index then
				anchor, ganchor = prev, gPrev
			elseif side.From == step.Index then
				anchor, ganchor = step, g
			end
			if not anchor then
				return "PlateBridge side platform has a bad anchor"
			end
			seen[side.From] = true
			if abs(side.Pos.Y - anchor.Pos.Y) > EPS or abs(wrap180(side.Yaw - (anchor.Yaw or 0))) > 0.5 then
				return "PlateBridge side platform is not level/aligned with its anchor"
			end
			local sg = makeGeo({ Pos = side.Pos, Size = side.Size, Yaw = side.Yaw })
			local d = shapeDist(sg.rect, ganchor.rect)
			if d < diff.GapMin - EPS or d > gmax + EPS or not isNum(side.Gap) or abs(side.Gap - d) > 0.05 then
				return string.format("PlateBridge side platform gap %.2f is not reachable without the bridge", d)
			end
			if minDimOf(side.Size) < 6 - EPS then
				return "PlateBridge side platform is smaller than 6x6"
			end
			local pl = side.Plate
			local lx, lz = toLocal(sg, pl.Pos.X, pl.Pos.Z)
			if abs(lx) > sg.hx - pl.Size.X * 0.5 + EPS or abs(lz) > sg.hz - pl.Size.Z * 0.5 + EPS
				or abs(pl.Pos.Y - (side.Pos.Y + pl.Size.Y)) > EPS then
				return "PlateBridge plate is not on its side platform"
			end
		end
		if not seen[prev.Index] or not seen[step.Index] then
			return "PlateBridge needs one plate before and one after the chasm"
		end
	end

	if kind == "DashGap" or kind == "PlateBridge" then
		local hint = step.DashHint
		if type(hint) ~= "table" or not isVec(hint.Pos) or not isVec(hint.Dir) or hint.From ~= step.Index - 1 then
			return "dash-gap step lacks a DashHint"
		end
		if prev and gPrev then
			if abs(hint.Pos.Y - prev.Pos.Y) > EPS or not inFootprint(gPrev, hint.Pos.X, hint.Pos.Z, 0) then
				return "DashHint is not on the run-up platform"
			end
			if abs(hint.Dir.Y) > EPS or abs(hypot(hint.Dir.X, hint.Dir.Z) - 1) > 0.01 then
				return "DashHint.Dir must be a horizontal unit vector"
			end
			local dx, dz = g.cx - gPrev.cx, g.cz - gPrev.cz
			local d = hypot(dx, dz)
			if d > 0.01 and (dx * hint.Dir.X + dz * hint.Dir.Z) / d < 0.9 then
				return "DashHint does not point at the next step"
			end
		end
	elseif step.DashHint ~= nil then
		return "only dash-gap steps carry a DashHint"
	end
	return nil
end

----------------------------------------------------------------------
-- Solids: everything a rider can stand on (steps, bridge spans, plate side platforms)
----------------------------------------------------------------------
local function makeSolid(stepLike, tag, owner, anchor)
	return { g = makeGeo(stepLike), tag = tag, owner = owner, anchor = anchor }
end

-- side solids of a PlateBridge hazard (span + two plate platforms); tolerant of malformed hazards
local function bridgeSolids(step, out)
	local h = step.Hazard
	if step.Kind ~= "PlateBridge" or type(h) ~= "table" then
		return
	end
	local sp = h.Span
	if type(sp) == "table" and isVec(sp.Pos) and isVec(sp.Size) then
		out[#out + 1] = makeSolid({ Pos = sp.Pos, Size = sp.Size, Yaw = sp.Yaw or 0, Headroom = Config.Course.Clearance },
			"span", step.Index, step.Index - 1)
	end
	if type(h.Sides) == "table" then
		for _, side in ipairs(h.Sides) do
			if type(side) == "table" and isVec(side.Pos) and isVec(side.Size) then
				out[#out + 1] = makeSolid({ Pos = side.Pos, Size = side.Size, Yaw = side.Yaw or 0,
					Headroom = Config.Course.Clearance }, "perch", step.Index, side.From)
			end
		end
	end
end

-- pairs that touch/neighbour by design and are covered by the link rules instead
local function solidsExempt(a, b)
	if a.tag == "step" and b.tag == "step" then
		return abs(a.owner - b.owner) <= 1
	end
	if a.tag ~= "step" and b.tag ~= "step" then
		return a.owner == b.owner
	end
	local step, other = a, b
	if a.tag ~= "step" then
		step, other = b, a
	end
	if other.tag == "span" then
		return step.owner == other.owner or step.owner == other.owner - 1
	end
	return step.owner == other.anchor
end

-- 2 stud separation + headroom between two solids (nil when fine)
local function solidPairProblem(a, b)
	local d = shapeDist(a.g.hull, b.g.hull, 30)
	local gv = max(b.g.bot - a.g.top, a.g.bot - b.g.top)
	if gv < 0 then
		gv = 0
	end
	if sqrt(d * d + gv * gv) < 2 - EPS then
		return "closer than 2 studs"
	end
	if d <= HEAD_CLEAR then
		local hi, lo = a.g, b.g
		if b.g.top > a.g.top then
			hi, lo = b.g, a.g
		end
		if hi.bot - lo.top < lo.head - EPS then
			return string.format("only %.1f studs of headroom above a lower step (needs %.1f)", hi.bot - lo.top, lo.head)
		end
	end
	return nil
end

-- stepping stones further than two steps apart must not allow a jump-skip
local function shortcutProblem(a, b)
	if a.tag ~= "step" or b.tag ~= "step" then
		return nil
	end
	local lo, hi = a, b
	if b.owner < a.owner then
		lo, hi = b, a
	end
	if hi.owner - lo.owner < 3 then
		return nil
	end
	local reach = SKIP_RISE
	if lo.g.kind == "Bounce" then
		-- a pad launches to its apex; its Headroom is ceil(apex + 1), so Headroom - 0.5 is apex + 0.5 (up to 1.5 with the rounding)
		reach = max(reach, lo.g.head - 0.5)
	end
	if hi.g.top - lo.g.top > reach then
		return nil
	end
	local d = shapeDist(lo.g.hull, hi.g.hull, SKIP_GAP + 2)
	if d < SKIP_GAP then
		return string.format("steps %d and %d are only %.1f apart (jump-skip)", lo.owner, hi.owner, d)
	end
	return nil
end

-- distance from the middle of g's sweep to its edge along the horizontal unit vector (dx, dz)
local function exitDistOf(g, dx, dz)
	local lux = dx * g.c - dz * g.s
	local luz = dx * g.s + dz * g.c
	return min(g.hx / max(abs(lux), 1e-6), g.hz / max(abs(luz), 1e-6))
end

-- Jump corridor of the link from step `aIndex` (geometry ga) to step `bIndex` (gb): sample points (flat x,z array)
local function makeCorridor(ga, aIndex, gb, bIndex)
	local dx, dz = gb.mx - ga.mx, gb.mz - ga.mz
	local D = hypot(dx, dz)
	if D < 0.01 then
		return nil
	end
	dx, dz = dx / D, dz / D
	local t0 = max(0, exitDistOf(ga, dx, dz) - CORRIDOR_BEFORE)
	local t1 = min(D, D - exitDistOf(gb, -dx, -dz) + CORRIDOR_AFTER)
	local c = { a = aIndex, b = bIndex, top = ga.top, need = Config.Course.Clearance + 0.3, n = 0 }
	local t = t0
	while t <= t1 + 1e-6 do
		for _, off in ipairs({ -CORRIDOR_HALF, 0, CORRIDOR_HALF }) do
			c.n = c.n + 1
			c[2 * c.n - 1], c[2 * c.n] = ga.mx + dx * t - dz * off, ga.mz + dz * t + dx * off
		end
		t = t + 1
	end
	return c
end

-- Does the solid `sol` hang in the free air a jump through corridor `c` needs? (a, b and their bridge parts never do)
local function corridorBlocked(c, sol)
	if sol.owner == c.a or sol.owner == c.b then
		return false
	end
	local g = sol.g
	if g.top <= c.top or g.bot >= c.top + c.need - EPS then
		return false
	end
	local h = g.hull
	for k = 1, c.n do
		local x, z = c[2 * k - 1], c[2 * k]
		if hypot(x - h.cx, z - h.cz) <= h.r + CORRIDOR_NEAR and pointDist(x, z, h) < CORRIDOR_NEAR then
			return true
		end
	end
	return false
end

-- the pieces runAttempt needs, in one table (a Lua 5.1 function may only capture 60 upvalues)
local JUMPROOM = { Decor = DECOR_HEAD, MakeCorridor = makeCorridor, Blocked = corridorBlocked }

local function corridorMessage(c, sol)
	return string.format("%s %d hangs only %.1f studs above the jump from step %d to step %d (needs %.1f)", sol.tag, sol.owner,
		sol.g.bot - c.top, c.a, c.b, c.need)
end

-- Does the arc of a cannon flight (samples) hit the solid? (pad and landing owners are skipped)
local function arcProblem(samples, padOwner, landOwner, s)
	if s.owner == padOwner or s.owner == landOwner then
		return false
	end
	for _, q in ipairs(samples) do
		if bodyHits(q, s) then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Tokens and scenery rules
----------------------------------------------------------------------
-- Is position (x, y, z) inside any solid (grown by `grow`)?
local function insideSolid(x, y, z, solids, grow)
	for _, s in ipairs(solids) do
		local g = s.g
		if y > g.bot - grow and y < g.top + grow then
			local dx, dz = x - g.hull.cx, z - g.hull.cz
			if hypot(dx, dz) <= g.hull.r + grow + 0.01 then
				if pointDist(x, z, g.hull) < grow + 0.001 then
					return s
				end
			end
		end
	end
	return nil
end

local function tokenProblem(step, g, tk, solids)
	if type(tk) ~= "table" or not isVec(tk.Pos) or not isNum(tk.Value) then
		return "token is malformed"
	end
	if tk.Value ~= Config.Tokens.DefaultValue and tk.Value ~= Config.Tokens.GoldenValue then
		return "token value is neither regular nor golden"
	end
	if (tk.Value == Config.Tokens.GoldenValue) ~= (tk.Golden == true) then
		return "token Golden flag does not match its value"
	end
	local dy = tk.Pos.Y - step.Pos.Y
	if dy < 3 - EPS or dy > 4.5 + EPS then
		return string.format("token height %.2f above its step is outside [3, 4.5]", dy)
	end
	-- it must hover over its own step or in the gap in front of it
	local d = pointDist(tk.Pos.X, tk.Pos.Z, g.hull)
	if d > 0.3 then
		local gap = step.Gap or 0
		if d > gap + 0.3 then
			return string.format("token is %.1f studs away from its step", d)
		end
	end
	local hit = insideSolid(tk.Pos.X, tk.Pos.Y, tk.Pos.Z, solids, 0.3)
	if hit then
		return string.format("token is inside %s %d", hit.tag, hit.owner)
	end
	if step.Kind == "CannonPad" then
		return "tokens do not belong on a cannon pad"
	end
	return nil
end

-- `samples` (optional): cannon flight samples that scenery must not stand in
local function sceneryProblem(item, solids, samples)
	if type(item) ~= "table" or type(item.Type) ~= "string" or not SCENERY_TYPES[item.Type] then
		return "unknown scenery type " .. tostring(item and item.Type)
	end
	if not (isVec(item.Pos) and isNum(item.Radius) and isNum(item.Height) and isNum(item.Yaw) and isNum(item.Seed)
		and isNum(item.Tint)) then
		return "scenery lacks Pos/Radius/Height/Yaw/Seed/Tint"
	end
	if item.Radius <= 0 or item.Height <= 0 then
		return "scenery has no size"
	end
	if hypot(item.Pos.X, item.Pos.Z) > 380 then
		return "scenery is too far from the course"
	end
	local y0, y1 = item.Pos.Y - 4, item.Pos.Y + item.Height + 4
	if samples then
		for _, q in ipairs(samples) do
			if q[2] > y0 - 1 and q[2] < y1 + 1 and hypot(q[1] - item.Pos.X, q[3] - item.Pos.Z) < item.Radius + 3 then
				return item.Type .. " would block a cannon flight"
			end
		end
	end
	for _, s in ipairs(solids) do
		local g = s.g
		if g.top + g.head > y0 and g.bot < y1 then
			local d = pointDist(item.Pos.X, item.Pos.Z, g.hull)
			if d < item.Radius + 4 then
				return string.format("%s overlaps %s %d (%.1f studs from it)", item.Type, s.tag, s.owner, d)
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Tokens
----------------------------------------------------------------------
-- Places regular and golden tokens on the finished steps. Every token is proven with tokenProblem.
-- Returns total value, token count, golden count.
local function placeTokens(rng, diff, tier, steps, geos, solids, stages)
	local function F(a, b)
		if b - a < 1e-6 then
			return a
		end
		return rng:Float(a, b)
	end
	local function I(a, b)
		if b <= a then
			return a
		end
		return rng:Int(a, b)
	end
	local DEFAULT, GOLD = Config.Tokens.DefaultValue, Config.Tokens.GoldenValue
	local total, count, goldCount = 0, 0, 0

	-- one proposal (a Vector3) for step `step`; `risky` pushes it to an edge / into a hazard area
	local function proposal(step, g, risky, golden)
		local kind = step.Kind
		local hx, hz = g.hx, g.hz
		local h = step.Hazard
		local function at(lx, lz, yy)
			local wx = g.mx + lx * g.c + lz * g.s
			local wz = g.mz - lx * g.s + lz * g.c
			return Vector3.new(wx, step.Pos.Y + yy, wz)
		end
		local y = F(3.2, 4.0)
		if golden then
			y = F(3.6, 4.4)
		end
		if kind == "Bounce" then
			return at(0, 0, 3.8)
		elseif kind == "Moving" then
			return at(F(-1.2, 1.2), F(-hz * 0.25, hz * 0.25), F(3.2, 4.2))
		elseif (kind == "DashGap" or kind == "PlateBridge") and step.DashHint and (risky or rng:Chance(0.6)) then
			local hint = step.DashHint
			local d = 1.5 + (step.Gap or 15) * 0.5
			return Vector3.new(hint.Pos.X + hint.Dir.X * d, step.Pos.Y + F(3.6, 4.3), hint.Pos.Z + hint.Dir.Z * d)
		elseif kind == "Beam" then
			local lx = F(-0.3, 0.3)
			if risky then
				lx = (rng:Chance(0.5) and 1 or -1) * (hx - 0.3)
			end
			return at(lx, F(-hz + 1.2, hz - 1.2), y)
		elseif kind == "PendulumPlatform" and h then
			-- tokens wait in the calm strips beside the swing
			local alongX = abs(h.Axis.X * g.c - h.Axis.Z * g.s) < 0.5 -- swing runs along local X?
			local sweep = h.Length * sin(h.Arc * RAD)
			local sgn = rng:Chance(0.5) and 1 or -1
			if alongX then
				local es = hx
				return at(sgn * F(sweep + 0.5, es - 0.5), F(-hz + 1.5, hz - 1.5), y)
			end
			return at(F(-hx + 1.5, hx - 1.5), sgn * F(sweep + 0.5, hz - 0.5), y)
		elseif kind == "LightningPlatform" and h and risky then
			local z = h.Zones[I(1, #h.Zones)]
			local lx, lz = toLocal(g, z.Pos.X, z.Pos.Z)
			return at(lx + F(-z.Radius * 0.4, z.Radius * 0.4), lz + F(-z.Radius * 0.4, z.Radius * 0.4), F(3.3, 4.0))
		end
		if risky then
			local side = I(1, 3)
			if side == 1 then
				return at(F(-hx * 0.3, hx * 0.3), hz - 0.5, y)
			elseif side == 2 then
				return at(hx - 0.5, F(-hz * 0.3, hz * 0.3), y)
			end
			return at(-(hx - 0.5), F(-hz * 0.3, hz * 0.3), y)
		end
		return at(F(-hx * 0.2, hx * 0.2), F(-hz * 0.35, hz * 0.35), y)
	end

	-- adds up to `want` tokens to one step; returns how many were placed
	local function fill(step, want, risky, golden)
		local g = geos[step.Index]
		local placed = 0
		local tries = 0
		while placed < want and tries < 14 do
			tries = tries + 1
			local pos = proposal(step, g, risky, golden)
			local tk = { Pos = pos, Value = golden and GOLD or DEFAULT, Golden = golden and true or false }
			local ok = tokenProblem(step, g, tk, solids) == nil
			if ok and step.Tokens then
				for _, other in ipairs(step.Tokens) do
					if hypot(other.Pos.X - pos.X, other.Pos.Z - pos.Z) < 1.6 and abs(other.Pos.Y - pos.Y) < 1.6 then
						ok = false
						break
					end
				end
			end
			if ok then
				step.Tokens = step.Tokens or {}
				step.Tokens[#step.Tokens + 1] = tk
				placed = placed + 1
				total = total + tk.Value
				count = count + 1
				if golden then
					goldCount = goldCount + 1
				end
			end
		end
		return placed
	end

	local goldRange = byTier(TIER.GoldenPerStage, tier)
	for k, info in ipairs(stages) do
		local cands = {}
		for i = info.FirstStep, info.LastStep do
			local s = steps[i]
			if s.Kind ~= "Checkpoint" and s.Kind ~= "CannonPad" then
				cands[#cands + 1] = s
			end
		end
		for i = #cands, 2, -1 do
			local j = I(1, i)
			cands[i], cands[j] = cands[j], cands[i]
		end
		-- regular tokens: TokensPerStage .. +2 distinct steps, 40% of them on risky edges
		local want = min(#cands, diff.TokensPerStage + I(0, 2))
		local risky = ceil(want * 0.4)
		local used = 0
		local ci = 1
		while used < want and ci <= #cands do
			local s = cands[ci]
			ci = ci + 1
			local n = 1
			if used >= risky and rng:Chance(0.3) and s.Kind ~= "Beam" and s.Kind ~= "Bounce" and s.Kind ~= "Moving" then
				n = I(2, 3)
			end
			if fill(s, n, used < risky, false) > 0 then
				used = used + 1
			end
		end
		-- golden tokens: hazards and chasms first, always on a risky spot
		local gold = I(goldRange[1], goldRange[2])
		local order = {}
		for _, s in ipairs(cands) do
			local w = 1
			local kind = s.Kind
			if kind == "DashGap" or kind == "PlateBridge" or kind == "Beam" or kind == "LightningPlatform"
				or kind == "PendulumPlatform" or kind == "SpinBarPlatform" or kind == "Moving" then
				w = 3
			end
			order[#order + 1] = { s = s, key = rng:Float(0, 1) * w + (w - 1) * 0.5 }
		end
		table.sort(order, function(a, b)
			if a.key ~= b.key then
				return a.key > b.key
			end
			return a.s.Index < b.s.Index
		end)
		local placed = 0
		for _, o in ipairs(order) do
			if placed >= gold then
				break
			end
			placed = placed + fill(o.s, 1, true, true)
		end
		if placed == 0 and #cands > 0 then
			-- every risky spot was blocked: put one on the first step that accepts it
			for _, s in ipairs(cands) do
				if fill(s, 1, false, true) > 0 then
					break
				end
			end
		end
	end
	return total, count, goldCount
end

----------------------------------------------------------------------
-- Scenery
----------------------------------------------------------------------
local function placeScenery(rng, steps, solids, stages, spiral, samples)
	local function F(a, b)
		if b - a < 1e-6 then
			return a
		end
		return rng:Float(a, b)
	end
	local function I(a, b)
		if b <= a then
			return a
		end
		return rng:Int(a, b)
	end
	local items = {}
	local minY, maxY = huge, -huge
	for _, s in ipairs(solids) do
		minY = min(minY, s.g.bot)
		maxY = max(maxY, s.g.top + s.g.head)
	end

	local function clashes(item)
		for _, o in ipairs(items) do
			local d = hypot(item.Pos.X - o.Pos.X, item.Pos.Z - o.Pos.Z)
			local overlapY = item.Pos.Y < o.Pos.Y + o.Height + 4 and o.Pos.Y < item.Pos.Y + item.Height + 4
			if overlapY and d < item.Radius + o.Radius + 4 then
				return true
			end
		end
		return false
	end

	-- the spiral's central pillar fills the void inside the helix
	if spiral then
		local r = spiral.Rmin * 0.5
		while r >= 8 do
			local item = {
				Type = "CentralPillar", Stage = 0,
				Pos = Vector3.new(spiral.cx, minY - 24, spiral.cz), Yaw = F(0, 360),
				Radius = r, Height = (maxY - minY) + 56, Seed = I(1, 99999), Tint = I(1, 8),
			}
			if sceneryProblem(item, solids, samples) == nil then
				items[#items + 1] = item
				break
			end
			r = r * 0.85
		end
	end

	-- one landmark per stage, matching its theme, beside the stage's route
	for k, st in ipairs(stages) do
		local id = LANDMARK_OF_THEME[st.Theme]
		local sz = id and LANDMARK_SIZE[id]
		if sz then
			local rad, hgt = F(sz[1], sz[2]), F(sz[3], sz[4])
			local mid = steps[floor((st.FirstStep + st.LastStep) / 2)]
			local done = false
			for ring = 1, 4 do
				local dist0 = rad + 20 + (ring - 1) * 24
				local a0 = F(0, 360)
				for a = 0, 11 do
					local ang = (a0 + a * 30) * RAD
					local d = dist0 + F(0, 8)
					local item = {
						Type = id, Stage = k,
						Pos = Vector3.new(mid.Pos.X + sin(ang) * d, mid.Pos.Y - hgt * 0.3 + F(-4, 8), mid.Pos.Z + cos(ang) * d),
						Yaw = F(0, 360), Radius = rad, Height = hgt, Seed = I(1, 99999), Tint = st.Tint,
					}
					if sceneryProblem(item, solids, samples) == nil and not clashes(item) then
						items[#items + 1] = item
						st.Landmark = id
						done = true
						break
					end
				end
				if done then
					break
				end
			end
		end
	end

	-- distant puffs, plus a cloud sea far below the route (Layer "Far" / "Sea": CourseBuilder seats the two differently)
	local function addPuff(dist0, dist1, y0, y1, layer)
		local ang = F(0, 360) * RAD
		local d = F(dist0, dist1)
		local r = F(12, 34)
		local item = {
			Type = "Puff", Stage = 0, Pos = Vector3.new(sin(ang) * d, F(y0, y1), cos(ang) * d), Yaw = F(0, 360),
			Radius = r, Height = r * 0.6, Seed = I(1, 99999), Tint = I(1, 8), Layer = layer,
		}
		if sceneryProblem(item, solids, samples) == nil then
			items[#items + 1] = item
		end
	end
	for _ = 1, I(14, 22) do
		addPuff(200, 320, minY - 50, maxY + 30, "Far")
	end
	for _ = 1, I(6, 10) do
		addPuff(0, 200, minY - 46, minY - 28, "Sea")
	end
	return items
end

----------------------------------------------------------------------
-- Generator
----------------------------------------------------------------------
-- Slide a shape along the ray (ox, oz) + D * (dx, dz) until its distance to `pShape` equals `gap`.
-- Returns the centre (x, z) or nil.
local function solvePlacement(pShape, ox, oz, dx, dz, makeShape, gap)
	local function f(D)
		return shapeDist(pShape, makeShape(ox + dx * D, oz + dz * D))
	end
	if f(0) > gap then
		return nil
	end
	local lo, hi = 0, 8
	while f(hi) < gap do
		lo = hi
		hi = hi + 8
		if hi > 220 then
			return nil
		end
	end
	for _ = 1, 22 do
		local mid = (lo + hi) * 0.5
		if f(mid) < gap then
			lo = mid
		else
			hi = mid
		end
	end
	return ox + dx * hi, oz + dz * hi
end

-- Finishes a generated course: checkpoints table, tokens, scenery, bounds.
local function assemble(rng, diff, tier, seed, attemptNo, archetype, themes, steps, geos, solids, stages, spiral, arcs)
	local layout = {
		DifficultyId = diff.Id, Seed = seed, Attempt = attemptNo + 1, Archetype = archetype, Themes = themes,
		Steps = steps, Stages = stages, Checkpoints = {}, Scenery = {}, TotalTokens = 0, TokenCount = 0, GoldenCount = 0,
	}
	for i, s in ipairs(steps) do
		if s.Kind == "Checkpoint" then
			layout.Checkpoints[s.Stage] = i
		end
	end
	if spiral then
		layout.Centre = Vector3.new(spiral.cx, 0, spiral.cz)
	end
	local total, count, gold = placeTokens(rng, diff, tier, steps, geos, solids, stages)
	layout.TotalTokens, layout.TokenCount, layout.GoldenCount = total, count, gold
	local samples = {}
	for _, a in ipairs(arcs) do
		for _, q in ipairs(a.samples) do
			samples[#samples + 1] = q
		end
	end
	layout.Scenery = placeScenery(rng, steps, solids, stages, spiral, samples)

	local mnx, mny, mnz, mxx, mxy, mxz = huge, huge, huge, -huge, -huge, -huge
	for _, s in ipairs(solids) do
		local h = s.g.hull
		for i = 1, h.n do
			mnx, mxx = min(mnx, h[2 * i - 1]), max(mxx, h[2 * i - 1])
			mnz, mxz = min(mnz, h[2 * i]), max(mxz, h[2 * i])
		end
		mny = min(mny, s.g.bot)
		mxy = max(mxy, s.g.top + s.g.head)
	end
	layout.Bounds = { Min = Vector3.new(mnx - 2, mny - 6, mnz - 2), Max = Vector3.new(mxx + 2, mxy, mxz + 2) }
	return layout
end

-- One complete generation attempt. Returns layout, nil  or  nil, reason.
local function runAttempt(diff, tier, seed, attemptNo, dbg)
	local MAXTURN = 42 -- degrees a step's heading may differ from the previous step's
	local OFFS = { 0, 8, -8, 16, -16, 26, -26, 38, -38, 52, -52, 68, -68, 90, -90 }
	local SAFE_OPENERS = { "Stones", "Bounce" }
	local MILD_OPENERS = { "Moving", "Beams", "Vanish", "Spin", "Plates" }
	local asin = math.asin
	local rng = Util.NewRng(floor(seed) + attemptNo * 1000003)
	local function F(a, b)
		if b - a < 1e-6 then
			return a
		end
		return rng:Float(a, b)
	end
	local function I(a, b)
		if b <= a then
			return a
		end
		return rng:Int(a, b)
	end
	local function coin()
		return rng:Chance(0.5)
	end

	local riseCap = riseCapOf(diff)
	local dashLo, dashHi = dashRange(diff)
	local clearance = Config.Course.Clearance
	local stageCount = diff.Stages
	local maxRadius = Config.Course.MaxRadius

	local steps, geos, heads, solids, arcs = {}, {}, {}, {}, {}
	local corridors = {} -- jump corridors of the accepted Walk / Dash links
	local bridgeCount = 0

	local function note(reason)
		if dbg and dbg.reasons then
			local key = reason:gsub("[%d%.%-]+", "#")
			dbg.reasons[key] = (dbg.reasons[key] or 0) + 1
		end
	end

	----------------------------------------------------------------
	-- archetype and stage themes
	----------------------------------------------------------------
	local archetype = weightedPick(rng, Config.Archetypes, function(id)
		return weightIn(diff.Archetypes, id)
	end) or "Straight"

	local function themeWeight(id)
		return weightIn(diff.Themes, id)
	end
	local themes, uses = {}, {}
	for k = 1, stageCount do
		local prevT = themes[k - 1]
		local pick
		if k == stageCount and stageCount > 1 and themeWeight("Gauntlet") > 0 and prevT ~= "Gauntlet" and rng:Chance(0.65) then
			pick = "Gauntlet"
		elseif k == 1 then
			pick = weightedPick(rng, SAFE_OPENERS, themeWeight)
			if not pick then
				pick = weightedPick(rng, MILD_OPENERS, themeWeight)
			end
		end
		if not pick then
			pick = weightedPick(rng, Config.StageThemes, function(id)
				if id == prevT then
					return 0
				end
				return themeWeight(id) * (0.45 ^ (uses[id] or 0))
			end)
		end
		if not pick then
			pick = prevT or "Stones"
		end
		themes[k] = pick
		uses[pick] = (uses[pick] or 0) + 1
	end

	----------------------------------------------------------------
	-- macro path (steering)
	----------------------------------------------------------------
	local avgPlat = (diff.PlatformMin + diff.PlatformMax) * 0.5
	local nomAdv = avgPlat + (diff.GapMin + diff.GapMax) * 0.5 * 0.9
	local avgSteps = (diff.StepsPerStage[1] + diff.StepsPerStage[2]) * 0.5
	local estLength = stageCount * (avgSteps + 1) * nomAdv * 1.2

	local steer = { arch = archetype, turning = false, laneLen = 0, laneS = 0, stageEnded = false, dd = 0, left = 0,
		sigma = 1, lastRate = 0 }
	local heading0
	local spiral = nil
	if archetype == "Spiral" then
		local R0 = F(45, 70)
		local R1 = clamp(R0 + F(-15, 15), 45, min(75, 144 - R0))
		steer.sigma = coin() and 1 or -1
		local a0 = F(0, 360)
		steer.R0, steer.R1 = R0, R1
		steer.cx, steer.cz = -R0 * sin(a0 * RAD), -R0 * cos(a0 * RAD)
		steer.aPrev, steer.aCum = a0, 0
		steer.totalAngle = estLength / ((R0 + R1) * 0.5) * DEG
		heading0 = a0 + steer.sigma * 90
		spiral = { cx = steer.cx, cz = steer.cz, Rmin = min(R0, R1) }
	else
		heading0 = F(0, 360)
		local rMin = max(18, 1.1 * diff.PlatformMax + 8)
		if archetype == "Straight" then
			steer.R = rMin + F(8, 14)
		elseif archetype == "Zigzag" then
			steer.R = rMin + F(0, 5)
			steer.minLane = 60
		else
			steer.R = rMin + F(10, 16)
			steer.theta = F(34, 50)
			steer.lambda = F(100, 140)
			steer.phase = F(0, 6.283)
		end
		steer.psi = heading0
		local sgn = coin() and 1 or -1
		local hr = heading0 * RAD
		steer.driftX, steer.driftZ = sgn * cos(hr), -sgn * sin(hr)
	end

	local function turnSlack(px, pz, h, R, sigma)
		local hr = h * RAD
		local ccx = px + sigma * cos(hr) * R
		local ccz = pz - sigma * sin(hr) * R
		return CENTRE_LIMIT - (hypot(ccx, ccz) + R)
	end
	local function bestSlack(px, pz, h, R)
		return max(turnSlack(px, pz, h, R, 1), turnSlack(px, pz, h, R, -1))
	end
	-- which way to U-turn: continue the sweep across the disc, flip when that side has no room
	local function chooseSigma(px, pz, h, R)
		local hr = h * RAD
		local pref = (cos(hr) * steer.driftX - sin(hr) * steer.driftZ) >= 0 and 1 or -1
		local s1 = turnSlack(px, pz, h, R, pref)
		local s2 = turnSlack(px, pz, h, R, -pref)
		if s1 >= 0 then
			return pref
		end
		if s2 >= 0 then
			steer.driftX, steer.driftZ = -steer.driftX, -steer.driftZ
			return -pref
		end
		return (s1 >= s2) and pref or -pref
	end

	local function desiredHeading(spec)
		local gPrev, hPrev = geos[#steps], heads[#steps]
		local px, pz = gPrev.mx, gPrev.mz
		local adv = gPrev.hz + (diff.GapMin + diff.GapMax) * 0.5 + spec.sz * 0.5
		local want
		if steer.arch == "Spiral" then
			local vx, vz = px - steer.cx, pz - steer.cz
			local r = hypot(vx, vz)
			local a = atan2(vx, vz) * DEG
			local frac = clamp(steer.aCum / steer.totalAngle, 0, 1)
			local Rt = steer.R0 + (steer.R1 - steer.R0) * frac
			local eps = clamp(atan2(r - Rt, 28) * DEG, -38, 38)
			local half = (adv / max(r, 10)) * 0.5 * DEG
			want = a + steer.sigma * (90 + eps + half)
		else
			if not steer.turning then
				local Rp = max(steer.R, adv * 1.4)
				local hr = hPrev * RAD
				local ax, az = px + sin(hr) * adv, pz + cos(hr) * adv
				local start = false
				if steer.arch == "Zigzag" and steer.stageEnded and steer.laneLen >= steer.minLane
					and bestSlack(px, pz, hPrev, Rp) >= 0 then
					start = true
				end
				if not start and bestSlack(ax, az, hPrev, Rp) < 0 then
					start = true
				end
				if start then
					local sg = chooseSigma(px, pz, hPrev, Rp)
					local target = steer.psi + 180
					local left = (((target - hPrev) * sg) % 360)
					if left >= 20 then
						steer.turning, steer.sigma, steer.Rp, steer.target, steer.left = true, sg, Rp, target, left
					end
				end
			end
			if steer.turning then
				local rate = min(steer.left, MAXTURN, DEG * adv / steer.Rp)
				steer.lastRate = rate
				want = hPrev + steer.sigma * rate
			elseif steer.arch == "Serpent" then
				want = steer.psi + steer.theta * sin(6.2832 * steer.laneS / steer.lambda + steer.phase)
			else
				want = steer.psi + steer.dd
			end
		end
		return hPrev + clamp(wrap180(want - hPrev), -MAXTURN, MAXTURN)
	end

	-- called once per committed step
	local function steerAfter(step, g)
		local prevG = geos[step.Index - 1]
		local dist = 0
		if prevG then
			dist = hypot(g.mx - prevG.mx, g.mz - prevG.mz)
		end
		steer.laneS = steer.laneS + dist
		if steer.arch == "Spiral" then
			local a = atan2(g.mx - steer.cx, g.mz - steer.cz) * DEG
			local da = wrap180(a - steer.aPrev) * steer.sigma
			if da > 0 then
				steer.aCum = steer.aCum + da
			end
			steer.aPrev = a
		else
			if steer.turning then
				steer.left = steer.left - steer.lastRate
				if steer.left <= 0.5 then
					steer.turning = false
					steer.psi = steer.target % 360
					steer.laneLen = 0
				end
			else
				steer.laneLen = steer.laneLen + dist
			end
			steer.dd = clamp(steer.dd + F(-3, 3), -9, 9)
		end
		steer.stageEnded = (step.Kind == "Checkpoint")
	end

	----------------------------------------------------------------
	-- solids / history
	----------------------------------------------------------------
	-- never below Config.Course.Clearance, whatever the hazard geometry itself needs
	local function headOf(kind)
		local h = JUMPROOM.Decor[kind] or 0
		if kind == "Bounce" then
			local p = byTier(TIER.BouncePower, tier)
			h = ceil(p * p / (2 * PH.Gravity) + 1)
		elseif kind == "StormPlatform" then
			h = 10.5
		elseif kind == "LightningPlatform" then
			h = 12
		elseif kind == "PendulumPlatform" then
			h = 11.5
		elseif kind == "WindPlatform" then
			h = 10
		elseif kind == "CannonPad" then
			h = 9
		end
		return max(clearance, h)
	end

	-- lowest top surface that keeps the headroom rule with every solid under/near the new footprint
	local function neededTop(g, index, top, head)
		local proxy = { tag = "step", owner = index }
		local need = -huge
		for _, es in ipairs(solids) do
			if not solidsExempt(proxy, es) then
				local d = shapeDist(g.hull, es.g.hull, HEAD_CLEAR + 2)
				if d <= HEAD_CLEAR + 0.5 then
					local aboveOK = (top - TH) >= es.g.top + es.g.head + 0.3
					local belowOK = (es.g.bot - top) >= head + 0.3
					if not (aboveOK or belowOK) then
						need = max(need, es.g.top + es.g.head + TH + 0.3)
					end
				end
			end
		end
		return need
	end

	local function historyProblem(newSolids, newCorridor)
		for _, ns in ipairs(newSolids) do
			for _, es in ipairs(solids) do
				if not solidsExempt(ns, es) then
					local msg = solidPairProblem(ns, es)
					if msg then
						return msg
					end
					msg = shortcutProblem(ns, es)
					if msg then
						return msg
					end
				end
			end
			for _, arc in ipairs(arcs) do
				if arcProblem(arc.samples, arc.pad, arc.land, ns) then
					return "blocks a cannon flight"
				end
			end
			for _, c in ipairs(corridors) do
				if JUMPROOM.Blocked(c, ns) then
					return "hangs over an earlier jump"
				end
			end
		end
		if newCorridor then
			for _, es in ipairs(solids) do
				if JUMPROOM.Blocked(newCorridor, es) then
					return "its jump runs under an earlier step"
				end
			end
		end
		return nil
	end

	----------------------------------------------------------------
	-- rise / gap / size sampling
	----------------------------------------------------------------
	local function sizeFor(kind, forceLo)
		local lo, hi = diff.PlatformMin, diff.PlatformMax
		if kind == "Checkpoint" then
			return SIZES.Checkpoint, SIZES.Checkpoint
		elseif kind == "Beam" then
			local wlo, whi = 3.6, 4
			if tier == 3 then
				wlo, whi = 3.4, 4
			elseif tier == 4 then
				wlo, whi = 3, 3.8
			elseif tier >= 5 then
				wlo, whi = 2.5, 3.4
			end
			local w = floor(F(wlo, whi) * 4 + 0.5) / 4
			return clamp(w, 2.5, 4), clamp(snap(F(14, 30)), 14, 30)
		elseif kind == "PendulumPlatform" or kind == "WindPlatform" then
			return clamp(snap(F(9, 13)), 9, 15), clamp(snap(F(9, 13)), 9, 15)
		end
		local a, b = lo, hi
		if kind == "CannonPad" then
			a, b = max(lo, 7), max(hi, 7)
		elseif kind == "PlateBridge" then
			a = max(lo, 7)
			b = max(hi, a)
		elseif kind == "Moving" or kind == "Bounce" or kind == "StormPlatform" then
			a = lo + (hi - lo) * 0.4
		elseif kind == "SpinBarPlatform" then
			a = max(lo + (hi - lo) * 0.4, TIER.SpinMinPlatform)
		elseif kind == "LightningPlatform" then
			a = max(lo + (hi - lo) * 0.3, 6)
		end
		if forceLo and forceLo > a then
			a = forceLo
		end
		if a > b then
			a = b
		end
		local function pick()
			return clamp(snap(F(a, b)), a, b)
		end
		return pick(), pick()
	end

	local function pickRise(spec, prev, exitD)
		local kind = spec.kind
		if kind == "PlateBridge" then
			return 0
		elseif kind == "DashGap" then
			if coin() then
				return F(0, 1.5)
			end
			return 0
		elseif spec.cannonLanding then
			return F(-1, 7.5)
		end
		if prev.Kind == "Bounce" and spec.bounceUp then
			local hp = prev.Hazard
			local r = F(4.8, 8.5)
			if hp and hp.Power then
				while r > riseCap
					and bounceReach(hp.Power, hp.LaunchSpeed, r) - exitD - 0.8 < diff.GapMin + 0.3 do
					r = r - 0.5
				end
			end
			if r > riseCap then
				return r
			end
		end
		local r
		local roll = F(0, 1)
		if roll < 0.18 then
			r = 0
		elseif roll < 0.70 then
			r = F(0.5, riseCap * 0.7)
		elseif roll < 0.93 then
			r = F(riseCap * 0.55, riseCap)
		else
			r = -F(0.5, 3)
		end
		if r >= 0 and r < 0.4 and rng:Chance(0.4) then
			r = F(0.6, min(1.5, riseCap))
		end
		if r > 0 then
			r = r * spec.climb
		end
		if kind == "Moving" or kind == "SpinBarPlatform" or kind == "Vanishing" then
			r = min(r, 2.5)
		elseif kind == "PendulumPlatform" or kind == "WindPlatform" or kind == "Finish" or kind == "CannonPad" then
			r = clamp(r, 0, 2)
		elseif kind == "Checkpoint" then
			r = clamp(r, 0, riseCap * 0.7)
		end
		if r < 0 and (prev.Pos.Y < 3 or kind ~= "Platform") then
			r = 0
		end
		if prev.Pos.Y + r < -6 then
			r = 0
		end
		r = min(r, riseCap)
		while r > 0 and runReach(r) - 0.3 < diff.GapMin do
			r = r - 0.25
		end
		if r < 0.05 and r > 0 then
			r = 0
		end
		return r
	end

	local function pickGap(spec, rise, prev, exitD)
		local kind = spec.kind
		if kind == "DashGap" or kind == "PlateBridge" then
			local hi = min(dashHi, dashReach(rise) - 0.3)
			local lo = dashLo
			if hi < lo then
				hi = lo
			end
			return F(lo, hi)
		elseif spec.cannonLanding then
			return F(24, 46)
		end
		local lo, hi = diff.GapMin, diff.GapMax
		if rise > riseCap + RISE_EPS then
			local hp = prev.Hazard
			if hp and hp.Power then
				hi = min(hi, bounceReach(hp.Power, hp.LaunchSpeed, rise) - exitD - 0.8)
			end
		else
			hi = min(hi, runReach(rise) - 0.3)
		end
		if hi < lo then
			hi = lo
		end
		local t = F(0.05, 0.55 + 0.45 * spec.progress)
		if kind == "Vanishing" or kind == "Moving" then
			t = t * 0.8
		elseif kind == "Beam" then
			t = t * 0.6
		end
		return lo + (hi - lo) * t
	end

	----------------------------------------------------------------
	-- hazards
	----------------------------------------------------------------
	local function attachCannon(prev, gPrev, step, g)
		local tx, tz = g.cx, g.cz
		local hdist = hypot(tx - gPrev.cx, tz - gPrev.cz)
		-- the longest flight whose peak stays under TIER.CannonMaxApex: the root climbs vy^2 / 2g + ROOT_H with
		-- vy = rise / t + g t / 2, so g/2 t^2 - K t + rise <= 0 with K = sqrt(2 g (TIER.CannonMaxApex - ROOT_H)) (bug #8)
		local rise = step.Pos.Y - prev.Pos.Y
		local K = sqrt(2 * PH.Gravity * (TIER.CannonMaxApex - ROOT_H))
		local tApex = (K + sqrt(max(K * K - 2 * PH.Gravity * rise, 0))) / PH.Gravity - 0.01
		local tTop = min(1.45, tApex)
		local t0 = clamp(1.0 + hdist / 110, 1.0, tTop)
		local aimX, aimZ = tx - gPrev.cx, tz - gPrev.cz
		local al = hypot(aimX, aimZ)
		if al < 0.01 then
			return false
		end
		local target = Vector3.new(tx, step.Pos.Y + ROOT_H, tz)
		local minDim = minDimOf(prev.Size)
		local padR = clamp(minDim * 0.3, 2.2, 3.4)
		for _, t in ipairs({ t0, t0 - 0.04, t0 - 0.08, 1.0 + (tTop - 1.0) * 0.5, 1.0 }) do
			if t >= 1.0 and t <= tTop then
				local vx, vy, vz = cannonVelocity(prev.Pos.Y, gPrev.cx, gPrev.cz, target, t)
				prev.Hazard = {
					Type = "Cannon",
					Pos = Vector3.new(gPrev.cx, prev.Pos.Y, gPrev.cz),
					PadRadius = padR,
					Target = target,
					LandingPoint = Vector3.new(tx, step.Pos.Y, tz),
					FlightTime = t,
					Aim = Vector3.new(aimX / al, 0, aimZ / al),
					Speed = sqrt(vx * vx + vy * vy + vz * vz),
					Apex = ROOT_H + (vy > 0 and vy * vy / (2 * PH.Gravity) or 0),
					LandingIndex = step.Index,
				}
				prev.Headroom = headOf("CannonPad")
				step.Link = "Cannon"
				local lo, hi = gapRange(gPrev, g)
				local msg = cannonLinkProblem(diff, prev, gPrev, step, g, lo, hi, step.Pos.Y - prev.Pos.Y)
				if not msg then
					return true
				end
				note("cannon: " .. msg)
			end
		end
		prev.Hazard = nil
		return false
	end

	-- Builds the hazard / hint of a freshly placed step. Returns extra solids ({} when none) or nil, reason.
	local function decorate(step, g, spec, prev, gPrev)
		local kind = step.Kind
		local top = step.Pos.Y
		local minDim = minDimOf(step.Size)
		local extras = {}
		if kind == "Vanishing" then
			local d = max(byTier(TIER.VanishDelay, tier), minVanishDelay(step.Size) + 0.05)
			d = ceil(d * 20) / 20
			step.Hazard = { Type = "Vanish", VanishDelay = d, ReturnDelay = max(byTier(TIER.VanishReturn, tier), d + 1.2) }
		elseif kind == "Bounce" then
			local power = byTier(TIER.BouncePower, tier)
			step.Hazard = {
				Type = "Bounce", Pos = Vector3.new(g.cx, top, g.cz), PadSize = clamp(minDim * 0.42, 3, 4.6),
				Power = power, LaunchSpeed = byTier(TIER.BounceSpeed, tier), Apex = power * power / (2 * PH.Gravity),
			}
		elseif kind == "SpinBarPlatform" then
			local sp = byTier(TIER.SpinSpeed, tier)
			local speed = floor(F(sp[1], sp[2]))
			if coin() then
				speed = -speed
			end
			local count = 1
			if tier >= TIER.SpinTwoBarTier and coin() then
				count = 2
			end
			-- the bar ends TIER.SpinSafeRing studs inside the edge: walking the rim or jumping the bar are both real options
			step.Hazard = {
				Type = "SpinBar", Pos = Vector3.new(g.cx, top, g.cz), Length = clamp(floor((minDim - 2 * TIER.SpinSafeRing) * 2) / 2, 3, 9),
				Speed = speed, Damage = byTier(TIER.SpinDamage, tier), Count = count, Height = 1.0,
			}
		elseif kind == "StormPlatform" then
			step.Hazard = {
				Type = "Storm", DPS = byTier(TIER.StormDPS, tier),
				Box = { Pos = Vector3.new(g.cx, top, g.cz), Size = Vector3.new(step.Size.X + 2, 6.5, step.Size.Z + 2), Yaw = step.Yaw },
			}
		elseif kind == "LightningPlatform" then
			local r = clamp(minDim * 0.28, 1.8, 3.6)
			local nZones = 1
			if tier >= 4 and minDim >= 7.5 and coin() then
				nZones = 2
			end
			local pl = byTier(TIER.LightningInterval, tier)
			local okHaz = false
			for _ = 1, 14 do
				local zones = {}
				for z = 1, nZones do
					local lx = F(-(g.hx - r), g.hx - r)
					local lz = F(-(g.hz - r), g.hz - r)
					local wx, wz = toWorld(g, lx, lz)
					zones[z] = { Pos = Vector3.new(wx, top, wz), Radius = r }
				end
				step.Hazard = {
					Type = "Lightning", Zones = zones, Damage = byTier(TIER.LightningDamage, tier), Interval = pl,
					Warning = byTier(TIER.LightningWarning, tier),
				}
				if hazardProblem(diff, step, g, prev, gPrev) == nil then
					okHaz = true
					break
				end
				nZones = 1
			end
			if not okHaz then
				return nil, "lightning has no safe spot"
			end
		elseif kind == "PendulumPlatform" then
			local swingFwd = rng:Chance(0.6) -- swing along local Z (rotation axis = local X)
			local es, ea = g.hz, g.hx
			if not swingFwd then
				es, ea = g.hx, g.hz
			end
			local sweepMax = es - 1.0 - 0.3
			local ar = byTier(TIER.PendArc, tier)
			local arc = F(ar[1], ar[2])
			local L = clamp(sweepMax / sin(arc * RAD), 4.5, 8.5)
			if L * sin(arc * RAD) > sweepMax then
				arc = asin(sweepMax / L) * DEG
			end
			if arc < 24 then
				return nil, "pendulum arc too small"
			end
			L = floor(L * 10) / 10
			local axisX, axisZ = g.c, -g.s
			if not swingFwd then
				axisX, axisZ = g.s, g.c
			end
			local pp = byTier(TIER.PendPeriod, tier)
			step.Hazard = {
				Type = "Pendulum", Hinge = Vector3.new(g.cx, top + L + 1.2, g.cz), Axis = Vector3.new(axisX, 0, axisZ),
				Arc = floor(arc * 10) / 10, Period = F(pp[1], pp[2]), Damage = byTier(TIER.PendDamage, tier), Length = L,
				BeamSize = Vector3.new(min(2 * ea - 1.0, 12), L, 1.0), RestClear = 1.2,
			}
		elseif kind == "WindPlatform" then
			local alongX = coin()
			local sgn = coin() and 1 or -1
			local La, Lc = step.Size.Z, step.Size.X
			if alongX then
				La, Lc = step.Size.X, step.Size.Z
			end
			local zoneLen = La - 5.4
			local lx, lz, zx, zz = 0, 0, Lc - 0.4, zoneLen
			if alongX then
				lx, zx, zz = -sgn * 2.7, zoneLen, Lc - 0.4
			else
				lz = -sgn * 2.7
			end
			local wx, wz = toWorld(g, lx, lz)
			local dirx, dirz = sgn * g.s, sgn * g.c
			if alongX then
				dirx, dirz = sgn * g.c, -sgn * g.s
			end
			step.Hazard = {
				Type = "Wind", Zone = { Pos = Vector3.new(wx, top, wz), Size = Vector3.new(zx, 9, zz), Yaw = step.Yaw },
				Direction = Vector3.new(dirx, 0, dirz), Force = byTier(TIER.WindForce, tier),
				Interval = byTier(TIER.WindInterval, tier), Warning = byTier(TIER.WindWarning, tier), Duration = 1.5,
			}
		elseif kind == "DashGap" or kind == "PlateBridge" then
			-- hint: a spot on the run-up platform's top, 1.5 studs behind its edge along the line to this step
			local tx, tz = g.cx, g.cz
			if kind == "PlateBridge" then
				-- aim at the middle of the bridge lane
				local lxn = toLocal(gPrev, g.cx, g.cz)
				local ovLo = max(-gPrev.hx, lxn - g.hx)
				local ovHi = min(gPrev.hx, lxn + g.hx)
				local lc = (ovLo + ovHi) * 0.5
				local ov = ovHi - ovLo
				local sw = min(4.5, ov - 1.2)
				if sw < 3.2 then
					return nil, "bridge lanes do not overlap enough"
				end
				local gap = step.Gap
				local sx0, sz0 = toWorld(gPrev, lc, gPrev.hz + gap * 0.5)
				local spanSize = Vector3.new(sw, 1, gap + 0.6)
				local bridge = {
					Type = "PlateBridge", BridgeNumber = spec.bridgeNumber,
					Span = { Pos = Vector3.new(sx0, prev.Pos.Y, sz0), Size = spanSize, Yaw = step.Yaw },
					Sides = {},
				}
				local sgn = coin() and 1 or -1
				local sideLo = diff.GapMin
				local sideHi = max(sideLo, min(diff.GapMax, runReach(0)) - 1)
				for k, pair in ipairs({ { prev, gPrev }, { step, g } }) do
					local anchor, ga = pair[1], pair[2]
					local sgap = F(sideLo, sideHi)
					local sideZ = clamp(anchor.Size.Z, 6, 9)
					local side = (k == 1) and sgn or -sgn
					local wx, wz = toWorld(ga, side * (ga.hx + sgap + 3.5), 0)
					local sPos = Vector3.new(wx, anchor.Pos.Y, wz)
					local sSize = Vector3.new(7, TH, sideZ)
					local sg = makeGeo({ Pos = sPos, Size = sSize, Yaw = anchor.Yaw })
					bridge.Sides[k] = {
						Pos = sPos, Size = sSize, Yaw = anchor.Yaw, From = anchor.Index, Gap = shapeDist(sg.rect, ga.rect),
						Plate = { Pos = Vector3.new(wx, anchor.Pos.Y + 0.5, wz), Size = Vector3.new(4, 0.5, 4) },
					}
				end
				step.Hazard = bridge
				tx, tz = sx0, sz0
			end
			local ux, uz = tx - gPrev.cx, tz - gPrev.cz
			local ul = hypot(ux, uz)
			if ul < 0.01 then
				return nil, "dash line is degenerate"
			end
			ux, uz = ux / ul, uz / ul
			local lux = ux * gPrev.c - uz * gPrev.s
			local luz = ux * gPrev.s + uz * gPrev.c
			local texit = min(gPrev.hx / max(abs(lux), 1e-6), gPrev.hz / max(abs(luz), 1e-6))
			local back = min(1.5, texit * 0.5)
			step.DashHint = {
				From = prev.Index,
				Pos = Vector3.new(gPrev.cx + ux * (texit - back), prev.Pos.Y, gPrev.cz + uz * (texit - back)),
				Dir = Vector3.new(ux, 0, uz),
			}
		end
		if kind == "PlateBridge" then
			local tmp = { Pos = step.Pos, Size = step.Size, Yaw = step.Yaw, Kind = kind, Hazard = step.Hazard, Index = step.Index }
			bridgeSolids(tmp, extras)
		end
		return extras
	end

	----------------------------------------------------------------
	-- placement of one step
	----------------------------------------------------------------
	local function tryPlace(spec, heading, index, attempt)
		local kind = spec.kind
		local prev, gPrev = steps[#steps], geos[#steps]
		local hr = heading * RAD
		local dirx, dirz = sin(hr), cos(hr)
		local yaw = heading
		if spec.yawJitter then
			yaw = heading + F(-spec.yawJitter, spec.yawJitter)
		end
		if kind == "PlateBridge" then
			yaw = prev.Yaw
		end
		yaw = yaw % 360
		local yawRad = yaw * RAD
		local sx, sz = spec.sx, spec.sz
		local hx, hz = sx * 0.5, sz * 0.5
		local swx, swz = 0, 0
		local movingHaz = nil
		if kind == "Moving" then
			local sgn = coin() and 1 or -1
			local w = spec.sweepW
			if attempt > 2 then
				w = floor(F(min(3.6, w), w) * 2) / 2 -- later attempts try shorter slides
			end
			swx, swz = sgn * w * cos(yawRad), -sgn * w * sin(yawRad)
			local mp = byTier(TIER.MovePeriod, tier)
			local per = F(max(mp[1], w / 3.9), max(mp[2], w / 3.9 + 0.2))
			movingHaz = { Type = "Moving", EndOffset = Vector3.new(swx, 0, swz), Period = floor(per * 20) / 20 }
		end
		local function shapeAt(mx, mz)
			if kind == "Moving" then
				return sweptShape(mx - swx * 0.5, mz - swz * 0.5, swx, swz, hx, hz, yawRad)
			end
			return rectShape(mx, mz, hx, hz, yawRad)
		end

		local maxRise = riseCap
		if prev.Kind == "Bounce" then
			maxRise = 9
		end
		if spec.cannonLanding then
			maxRise = 10
		elseif kind == "DashGap" or kind == "PlateBridge" then
			maxRise = 2
		end
		-- distance from the middle of the previous step to its edge in the travel direction
		local lux = dirx * gPrev.c - dirz * gPrev.s
		local luz = dirx * gPrev.s + dirz * gPrev.c
		local exitD = min(gPrev.hx / max(abs(lux), 1e-6), gPrev.hz / max(abs(luz), 1e-6))
		local rise = pickRise(spec, prev, exitD)
		if rise > maxRise then
			rise = maxRise
		end
		local gap = pickGap(spec, rise, prev, exitD)

		local ox, oz = gPrev.mx, gPrev.mz
		if prev.Kind == "Beam" and abs(wrap180(heading - prev.Yaw)) < 100 then
			ox = ox + sin(prev.Yaw * RAD) * gPrev.hz
			oz = oz + cos(prev.Yaw * RAD) * gPrev.hz
		end
		local bridgeShift = 0
		if kind == "PlateBridge" then
			bridgeShift = F(-1.5, 1.5)
		elseif not spec.noShift and coin() then
			local lim = min(gPrev.hx, hx) * 0.5
			local shift = F(-lim, lim)
			ox, oz = ox + shift * cos(hr), oz - shift * sin(hr)
		end

		local function place(gapNow)
			if kind == "PlateBridge" then
				return toWorld(gPrev, bridgeShift, gPrev.hz + gapNow + hz)
			end
			return solvePlacement(gPrev.hull, ox, oz, dirx, dirz, shapeAt, gapNow)
		end

		local head = headOf(kind)
		local mx, mz = place(gap)
		if not mx then
			return nil, "no placement"
		end
		local top = prev.Pos.Y + rise
		local function tentative()
			return makeGeo({
				Pos = Vector3.new(mx - swx * 0.5, top, mz - swz * 0.5), Size = Vector3.new(sx, TH, sz), Yaw = yaw,
				Kind = kind, Hazard = movingHaz, Headroom = head,
			})
		end
		-- raise the step when an earlier lap/lane is too close underneath
		for _ = 1, 2 do
			local need = neededTop(tentative(), index, top, head)
			if need > top + EPS then
				local newRise = need - prev.Pos.Y
				if newRise > maxRise + 1e-9 then
					return nil, "needs too much climb"
				end
				rise, top = newRise, need
				if not spec.cannonLanding and kind ~= "DashGap" and kind ~= "PlateBridge" and rise <= riseCap + RISE_EPS
					and gap > runReach(rise) - 0.3 then
					gap = runReach(rise) - 0.3
					if gap < diff.GapMin then
						return nil, "no gap left after climbing"
					end
					mx, mz = place(gap)
					if not mx then
						return nil, "no placement"
					end
				end
			else
				break
			end
		end

		-- a moving neighbour makes the gap vary along its sweep: pull the nearest approach in so the far end stays legal
		if (gPrev.sx or kind == "Moving") and not spec.cannonLanding then
			local lo, hi = gapRange(gPrev, tentative())
			local limit = diff.GapMax
			if rise <= riseCap + RISE_EPS then
				limit = min(limit, runReach(rise) - 0.3)
			end
			if hi > limit then
				local target = limit - (hi - lo) - 0.05
				if target < diff.GapMin then
					return nil, "a moving step varies the gap too much"
				end
				gap = target
				mx, mz = place(gap)
				if not mx then
					return nil, "no placement"
				end
			end
		end

		local link = "Walk"
		if prev.Kind == "CannonPad" then
			link = "Cannon"
		elseif kind == "DashGap" or kind == "PlateBridge" then
			link = "Dash"
		elseif rise > riseCap + RISE_EPS then
			link = "Bounce"
		end
		local step = {
			Index = index, Stage = spec.stage, Kind = kind,
			Pos = Vector3.new(mx - swx * 0.5, top, mz - swz * 0.5), Size = Vector3.new(sx, TH, sz), Yaw = yaw,
			Gap = 0, Link = link, Variant = I(1, 4), Headroom = head, Hazard = movingHaz,
		}
		local g = makeGeo(step)
		local _, gapHi = gapRange(gPrev, g)
		step.Gap = gapHi
		spec.bridgeNumber = bridgeCount + 1
		local extras, why = decorate(step, g, spec, prev, gPrev)
		if not extras then
			return nil, why
		end
		if spec.cannonLanding and not attachCannon(prev, gPrev, step, g) then
			return nil, "cannon cannot reach"
		end

		local msg = sizeProblem(step, diff)
		if not msg then
			msg = pairProblem(diff, prev, gPrev, step, g)
		end
		if not msg and kind ~= "CannonPad" then
			msg = hazardProblem(diff, step, g, prev, gPrev)
		end
		if not msg and prev.Kind == "CannonPad" then
			msg = hazardProblem(diff, prev, gPrev, steps[#steps - 1], geos[#steps - 1])
		end
		if msg then
			if prev.Kind == "CannonPad" then
				prev.Hazard = nil
			end
			return nil, msg
		end
		if shapeRadius(g.hull) > maxRadius - 0.5 then
			if prev.Kind == "CannonPad" then
				prev.Hazard = nil
			end
			return nil, "outside the course radius"
		end
		local newSolids = { { g = g, tag = "step", owner = index } }
		for _, e in ipairs(extras) do
			if shapeRadius(e.g.hull) > maxRadius - 0.5 then
				if prev.Kind == "CannonPad" then
					prev.Hazard = nil
				end
				return nil, "bridge parts outside the course radius"
			end
			newSolids[#newSolids + 1] = e
		end
		local corridor = nil
		if link == "Walk" or link == "Dash" then
			corridor = JUMPROOM.MakeCorridor(gPrev, index - 1, g, index)
		end
		msg = historyProblem(newSolids, corridor)
		if not msg and prev.Kind == "CannonPad" then
			local samples = cannonArcSamples(prev.Hazard, prev.Pos.Y)
			for _, s in ipairs(solids) do
				if arcProblem(samples, index - 1, index, s) then
					msg = "the cannon flight would hit another step"
					break
				end
			end
			if not msg then
				for _, ns in ipairs(newSolids) do
					if ns.owner ~= index - 1 and ns.owner ~= index and arcProblem(samples, index - 1, index, ns) then
						msg = "the cannon flight would hit its own bridge"
						break
					end
				end
			end
			if not msg then
				arcs[#arcs + 1] = { samples = samples, pad = index - 1, land = index }
			end
		end
		if msg then
			if prev.Kind == "CannonPad" then
				prev.Hazard = nil
			end
			return nil, msg
		end

		-- accepted
		steps[index], geos[index], heads[index] = step, g, heading
		for _, s in ipairs(newSolids) do
			solids[#solids + 1] = s
		end
		if corridor then
			corridors[#corridors + 1] = corridor
		end
		if kind == "PlateBridge" then
			bridgeCount = bridgeCount + 1
		end
		steerAfter(step, g)
		return step
	end

	-- Slides of the previous (moving) step get shorter around their middle: always legal for its own link.
	local function shrinkMoving(idx, newW)
		local s, g = steps[idx], geos[idx]
		local travel = hypot(g.sx, g.sz)
		if travel <= newW + 0.01 then
			return false
		end
		local k = newW / travel
		local ex, ez = g.sx * k, g.sz * k
		s.Hazard.EndOffset = Vector3.new(ex, 0, ez)
		s.Pos = Vector3.new(g.mx - ex * 0.5, s.Pos.Y, g.mz - ez * 0.5)
		local ng = makeGeo(s)
		geos[idx] = ng
		for _, sol in ipairs(solids) do
			if sol.tag == "step" and sol.owner == idx then
				sol.g = ng
			end
		end
		local _, hi = gapRange(geos[idx - 1], ng)
		s.Gap = hi
		return true
	end

	local placeStepOnce
	local function placeStep(spec)
		local prev = steps[#steps]
		local step, why = placeStepOnce(spec)
		if not step and prev.Kind == "Moving" and shrinkMoving(#steps, 3.6) then
			note("shrank a moving step to let the next step fit")
			step, why = placeStepOnce(spec)
		end
		return step, why
	end

	placeStepOnce = function(spec)
		local prev = steps[#steps]
		local index = #steps + 1
		local sign = coin() and 1 or -1
		local jitter = 8
		if archetype == "Spiral" or archetype == "Serpent" then
			jitter = 3
		end
		-- phases of heading attempts: straight kinds keep the previous yaw, steps leaving a moving cloud first try
		-- to continue straight out of it (keeps the gap steady), everything else follows the macro path
		local phases = {}
		if spec.straight then
			phases[1] = { base = prev.Yaw, offs = { 0, 3, -3, 6, -6 }, tries = 10, exact = true }
		else
			if prev.Kind == "Moving" then
				phases[1] = { base = prev.Yaw, offs = { 0, 3, -3, 6, -6, 10, -10 }, tries = 14, exact = true }
			end
			phases[#phases + 1] = { base = desiredHeading(spec), offs = OFFS, tries = 30 }
		end
		local lastWhy = "?"
		local attempt = 0
		for _, ph in ipairs(phases) do
			for k = 1, ph.tries do
				attempt = attempt + 1
				local oi = floor((k + 1) / 2)
				local off = ph.offs[min(oi, #ph.offs)] * sign
				local heading = ph.base + off
				if not ph.exact then
					heading = heading + ((oi == 1) and F(-jitter, jitter) or F(-2, 2))
				end
				local step, why = tryPlace(spec, heading, index, attempt)
				if step then
					return step
				end
				lastWhy = why or "?"
				note(lastWhy .. " (" .. prev.Kind .. ">" .. spec.kind .. ")")
			end
		end
		return nil, lastWhy
	end

	local function demoteLast()
		local idx = #steps
		local s, g = steps[idx], geos[idx]
		s.Kind = "Platform"
		s.Hazard = nil
		s.Headroom = clearance
		g.kind = "Platform"
		g.head = clearance
	end

	----------------------------------------------------------------
	-- stage planning
	----------------------------------------------------------------
	local function planStage(theme, n, stage, progress)
		local kinds = {}
		local landing = {}
		for j = 1, n do
			kinds[j] = "Platform"
		end
		local pFeat = clamp(0.45 + 0.5 * diff.HazardChance, 0.5, 0.92)
		-- sprinkle `kind` on steps 2..n with chance p (never next to itself unless `run` allows); keep at least `need`
		local function sprinkle(kind, p, need, run)
			local count = 0
			local streak = 0
			for j = 2, n do
				if kinds[j] == "Platform" and streak < run and rng:Chance(p) then
					kinds[j] = kind
					count = count + 1
					streak = streak + 1
				else
					streak = 0
				end
			end
			local tries = 0
			while count < need and tries < 40 do
				tries = tries + 1
				local j = I(2, n)
				if kinds[j] == "Platform" and (run > 1 or (kinds[j - 1] ~= kind and kinds[j + 1] ~= kind)) then
					kinds[j] = kind
					count = count + 1
				end
			end
		end

		if theme == "Beams" then
			for j = 1, n do
				kinds[j] = "Beam"
			end
		elseif theme == "Bounce" then
			sprinkle("Bounce", pFeat * 0.75, 2, 2)
		elseif theme == "Moving" then
			sprinkle("Moving", pFeat, 2, 1)
		elseif theme == "Spin" then
			sprinkle("SpinBarPlatform", pFeat * 0.8, 2, (tier >= 4) and 2 or 1)
		elseif theme == "Storm" then
			sprinkle("StormPlatform", pFeat * 0.8, 2, 2)
		elseif theme == "Lightning" then
			sprinkle("LightningPlatform", pFeat * 0.8, 2, (tier >= 4) and 2 or 1)
		elseif theme == "Vanish" then
			sprinkle("Vanishing", pFeat, 2, 3)
		elseif theme == "Pendulum" then
			sprinkle("PendulumPlatform", pFeat * 0.5, (n >= 8) and 2 or 1, 1)
		elseif theme == "Wind" then
			sprinkle("WindPlatform", pFeat * 0.5, (n >= 8) and 2 or 1, 1)
		elseif theme == "Cannon" then
			local maxPads = min(2, n - diff.TokensPerStage)
			local pads = (maxPads >= 2 and n >= 8 and coin()) and 2 or 1
			if maxPads < 1 then
				pads = 0
			end
			local placed, tries = 0, 0
			while placed < pads and tries < 40 do
				tries = tries + 1
				local j = I(2, n - 1)
				if kinds[j] == "Platform" and kinds[j + 1] == "Platform" and not landing[j] and not landing[j + 1]
					and kinds[j - 1] ~= "CannonPad" and (kinds[j + 2] ~= "CannonPad") then
					kinds[j] = "CannonPad"
					landing[j + 1] = true
					placed = placed + 1
				end
			end
		elseif theme == "Plates" then
			local j = I(2, n)
			kinds[j] = "PlateBridge"
			local fill = (tier >= 3) and "Vanishing" or "Moving"
			for q = 2, n do
				if kinds[q] == "Platform" and q ~= j - 1 and rng:Chance(0.22) then
					kinds[q] = fill
				end
			end
		elseif theme == "DashGap" then
			for j = 1, n do
				if kinds[j] == "Platform" and (j == 1 or kinds[j - 1] == "Platform") and rng:Chance(0.55) then
					kinds[j] = "DashGap"
				end
			end
			local have = 0
			for j = 1, n do
				if kinds[j] == "DashGap" then
					have = have + 1
				end
			end
			if have == 0 then
				kinds[I(1, n)] = "DashGap"
			end
		elseif theme == "Gauntlet" then
			local pool = {}
			local themeOfKind = {
				SpinBarPlatform = "Spin", Vanishing = "Vanish", LightningPlatform = "Lightning", StormPlatform = "Storm",
				PendulumPlatform = "Pendulum", WindPlatform = "Wind", Moving = "Moving",
			}
			for _, kk in ipairs({ "SpinBarPlatform", "Vanishing", "LightningPlatform", "StormPlatform", "PendulumPlatform",
				"WindPlatform", "Moving" }) do
				if themeWeight(themeOfKind[kk]) > 0 then
					pool[#pool + 1] = kk
				end
			end
			if #pool < 3 then
				pool = { "SpinBarPlatform", "Vanishing", "Moving" }
			end
			-- three distinct hazards, shuffled, cycled over the stage
			for i = #pool, 2, -1 do
				local j = I(1, i)
				pool[i], pool[j] = pool[j], pool[i]
			end
			local chosen = { pool[1], pool[2], pool[3] }
			local ci = 0
			for j = 2, n do
				if rng:Chance(0.72) or j == 2 then
					ci = ci % 3 + 1
					kinds[j] = chosen[ci]
				end
			end
			-- every one of the three hazards must appear at least once
			for _, want in ipairs(chosen) do
				local present = false
				for j = 1, n do
					if kinds[j] == want then
						present = true
					end
				end
				local tries = 0
				while not present and tries < 40 do
					tries = tries + 1
					local j = I(2, n)
					local isChosen = false
					for _, c in ipairs(chosen) do
						if kinds[j] == c then
							isChosen = true
						end
					end
					if not isChosen or tries > 30 then
						kinds[j] = want
						present = true
					end
				end
			end
		end

		-- general fix-ups
		for j = 2, n do
			if kinds[j] == "Moving" and kinds[j - 1] == "Moving" then
				kinds[j] = "Platform"
			end
		end
		-- sprinkle dash gaps on harder levels (stage 2+)
		if stage >= 2 and (diff.DashGapChance or 0) > 0 and theme ~= "DashGap" then
			for j = 1, n do
				if kinds[j] == "Platform" and not landing[j] and (j == 1 or kinds[j - 1] == "Platform")
					and kinds[j + 1] ~= "PlateBridge" and rng:Chance(diff.DashGapChance) then
					kinds[j] = "DashGap"
				end
			end
		end
		-- dash gaps and plate bridges need a static plain run-up
		for j = 2, n do
			if (kinds[j] == "DashGap" or kinds[j] == "PlateBridge") and kinds[j - 1] ~= "Platform" then
				kinds[j] = "Platform"
			end
		end
		-- a cannon pad must stay followed by its landing island
		for j = 1, n do
			if kinds[j] == "CannonPad" and not landing[j + 1] then
				kinds[j] = "Platform"
			end
		end

		local entries = {}
		for j = 1, n + 1 do
			local kind = (j <= n) and kinds[j] or "Checkpoint"
			local forceLo = nil
			if kind ~= "Checkpoint" then
				local nxt = kinds[j + 1]
				if kind == "PlateBridge" or nxt == "PlateBridge" or (landing[j] and true or false) then
					forceLo = 7
				elseif nxt == "DashGap" then
					forceLo = 6
				end
			end
			local sx, sz = sizeFor(kind, forceLo)
			local psx, psz = sizeFor("Platform", forceLo)
			if kind == "Checkpoint" then
				psx, psz = sx, sz
			end
			entries[j] = {
				kind = kind, stage = stage, sx = sx, sz = sz, plain = { sx = psx, sz = psz }, progress = progress,
				cannonLanding = landing[j] and true or false, straight = (kind == "DashGap" or kind == "PlateBridge"),
				noShift = (kind == "DashGap" or kind == "PlateBridge" or kind == "Beam"),
			}
		end
		return entries
	end

	----------------------------------------------------------------
	-- build the course
	----------------------------------------------------------------
	local startSize = SIZES.Start
	local start = {
		Index = 1, Stage = 0, Kind = "Start", Pos = Vector3.new(0, 0, 0), Size = Vector3.new(startSize, TH, startSize),
		Yaw = heading0 % 360, Variant = I(1, 4), Headroom = headOf("Start"),
	}
	steps[1] = start
	geos[1] = makeGeo(start)
	heads[1] = heading0
	solids[1] = { g = geos[1], tag = "step", owner = 1 }

	local stages = {}
	local lastTint = 0
	for stage = 1, stageCount do
		local progress = 0
		if stageCount > 1 then
			progress = (stage - 1) / (stageCount - 1)
		end
		local n = I(diff.StepsPerStage[1], diff.StepsPerStage[2])
		local theme = themes[stage]
		local entries = planStage(theme, n, stage, progress)
		local climb = F(0.7, 1.25)
		local tint = I(1, 8)
		if tint == lastTint then
			tint = tint % 8 + 1
		end
		lastTint = tint
		local firstIndex = #steps + 1
		local skipLanding = false
		for j = 1, n + 1 do
			local e = entries[j]
			e.climb = climb
			if skipLanding and e.cannonLanding then
				e.kind, e.cannonLanding = "Platform", false
				e.sx, e.sz = e.plain.sx, e.plain.sz
				skipLanding = false
			end
			if e.kind == "Platform" or e.kind == "Vanishing" or e.kind == "Bounce" or e.kind == "StormPlatform"
				or e.kind == "SpinBarPlatform" or e.kind == "LightningPlatform" then
				e.yawJitter = 14
				local nxtKind = entries[j + 1] and entries[j + 1].kind
				if nxtKind == "Moving" or steps[#steps].Kind == "Moving" then
					e.yawJitter = 3 -- keep the faces of a moving cloud's neighbours square to it
				end
			end
			if steps[#steps].Kind == "Bounce" and e.kind ~= "Checkpoint" and e.kind ~= "Finish" then
				if theme == "Bounce" and rng:Chance(0.8) then
					e.bounceUp = true
				elseif rng:Chance(0.25) then
					e.bounceUp = true
				end
			end
			if e.kind == "Moving" then
				local prevW = steps[#steps].Size.X
				local nxt = entries[j + 1]
				local nextW = nxt and nxt.sx or SIZES.Checkpoint
				local mw = byTier(TIER.MoveWidth, tier)
				local w = F(mw[1], mw[2])
				w = min(w, prevW + e.sx - 5, e.sx + nextW - 5)
				if w < 3.6 or steps[#steps].Kind == "Moving" then
					e.kind = "Platform"
					e.sx, e.sz = e.plain.sx, e.plain.sz
				else
					e.sweepW = floor(w * 2) / 2
				end
			end
			local step, why = placeStep(e)
			if not step and e.kind ~= "Platform" and e.kind ~= "Checkpoint" then
				note("DEMOTED " .. e.kind .. " in " .. theme .. ": " .. tostring(why))
				if e.cannonLanding then
					demoteLast()
				end
				if e.kind == "CannonPad" then
					skipLanding = true
				end
				local plain = {}
				for k2, v in pairs(e) do
					plain[k2] = v
				end
				plain.kind, plain.cannonLanding, plain.straight, plain.noShift = "Platform", false, false, false
				plain.sx, plain.sz = e.plain.sx, e.plain.sz
				plain.sweepW, plain.yawJitter = nil, 14
				if e.kind == "Beam" then
					plain.yawJitter = nil
				end
				step, why = placeStep(plain)
			end
			if not step then
				return nil, "stuck at step " .. (#steps + 1) .. " (" .. tostring(e.kind) .. "): " .. tostring(why)
			end
		end
		stages[stage] = {
			Index = stage, Theme = theme, Name = THEME_NAMES[theme] or "Sky Climb", Tint = tint,
			FirstStep = firstIndex, LastStep = #steps,
		}
	end

	-- the finish island
	do
		local e = {
			kind = "Finish", stage = stageCount, sx = SIZES.Finish, sz = SIZES.Finish, progress = 1, climb = 1,
			plain = { sx = SIZES.Finish, sz = SIZES.Finish }, straight = false, noShift = false, cannonLanding = false,
		}
		local step, why = placeStep(e)
		if not step then
			return nil, "stuck at the finish: " .. tostring(why)
		end
	end
	for i = 1, #steps do
		if steps[i].Kind == "CannonPad" and not steps[i].Hazard then
			return nil, "a cannon pad was left without its landing"
		end
	end

	return assemble(rng, diff, tier, seed, attemptNo, archetype, themes, steps, geos, solids, stages, spiral, arcs)
end

----------------------------------------------------------------------
-- ValidateLayout: a proof of everything the contract promises
----------------------------------------------------------------------
function CourseLayout.ValidateLayout(layout)
	local problems = {}
	local function bad(fmt, ...)
		if #problems < MAX_PROBLEMS then
			problems[#problems + 1] = string.format(fmt, ...)
		end
	end
	if type(layout) ~= "table" or type(layout.Steps) ~= "table" then
		return false, { "layout has no Steps table" }
	end
	local diff = Config.GetDifficulty(layout.DifficultyId)
	if not diff then
		return false, { "unknown difficulty " .. tostring(layout.DifficultyId) }
	end
	local steps = layout.Steps
	local n = #steps
	if n < 3 then
		return false, { "layout has fewer than 3 steps" }
	end
	local clearance = Config.Course.Clearance
	local maxRadius = Config.Course.MaxRadius

	-- header: archetype, themes -------------------------------------------------
	local archetypeOk = false
	for _, a in ipairs(Config.Archetypes) do
		if a == layout.Archetype and weightIn(diff.Archetypes, a) > 0 then
			archetypeOk = true
		end
	end
	if not archetypeOk then
		bad("archetype %s is not allowed on %s", tostring(layout.Archetype), diff.Id)
	end
	local themes = layout.Themes
	if type(themes) ~= "table" or #themes ~= diff.Stages then
		bad("Themes must list one theme per stage (%d)", diff.Stages)
		themes = {}
	end
	local themeKinds = 0
	for _, id in ipairs(Config.StageThemes) do
		if weightIn(diff.Themes, id) > 0 then
			themeKinds = themeKinds + 1
		end
	end
	for k = 1, #themes do
		if weightIn(diff.Themes, themes[k]) <= 0 then
			bad("stage %d theme %s is not allowed on %s", k, tostring(themes[k]), diff.Id)
		end
		if k > 1 and themes[k] == themes[k - 1] and themeKinds > 1 then
			bad("stages %d and %d repeat the theme %s", k - 1, k, tostring(themes[k]))
		end
	end
	if themes[1] then
		local safe = weightIn(diff.Themes, "Stones") > 0 or weightIn(diff.Themes, "Bounce") > 0
		if safe and themes[1] ~= "Stones" and themes[1] ~= "Bounce" then
			bad("stage 1 must open with Stones or Bounce, not %s", tostring(themes[1]))
		elseif not safe and (themes[1] == "Storm" or themes[1] == "Lightning" or themes[1] == "Gauntlet"
			or themes[1] == "Pendulum" or themes[1] == "Wind" or themes[1] == "Cannon" or themes[1] == "DashGap") then
			bad("stage 1 opens with the harsh theme %s", tostring(themes[1]))
		end
	end
	if (layout.Archetype == "Spiral") ~= (layout.Centre ~= nil) then
		bad("Centre must be present exactly for Spiral courses")
	end

	-- steps ------------------------------------------------------------------------
	local geos = {}
	for i, s in ipairs(steps) do
		if type(s) ~= "table" or not isVec(s.Pos) or not isVec(s.Size) or type(s.Kind) ~= "string" then
			bad("step %d is malformed (needs Pos, Size, Kind)", i)
			return false, problems
		end
		geos[i] = makeGeo(s)
	end
	if steps[1].Kind ~= "Start" then
		bad("first step must be Start, got %s", tostring(steps[1].Kind))
	end
	if steps[n].Kind ~= "Finish" then
		bad("last step must be Finish, got %s", tostring(steps[n].Kind))
	end
	if steps[1].Pos.X ~= 0 or steps[1].Pos.Y ~= 0 or steps[1].Pos.Z ~= 0 then
		bad("Start must sit at the origin")
	end

	for i, s in ipairs(steps) do
		local ok, err = pcall(function()
			local g = geos[i]
			if s.Index ~= i then
				bad("step %d has Index %s", i, tostring(s.Index))
			end
			if not KINDS[s.Kind] then
				bad("step %d has unknown Kind %s", i, tostring(s.Kind))
				return
			end
			if not isNum(s.Yaw) then
				bad("step %d has no Yaw", i)
			end
			if (s.Kind == "Start") ~= (i == 1) or (s.Kind == "Finish") ~= (i == n) then
				bad("step %d: Start/Finish may only be the first/last step", i)
			end
			if not isNum(s.Stage) then
				bad("step %d has no Stage", i)
			end
			local msg = sizeProblem(s, diff)
			if msg then
				bad("step %d: %s", i, msg)
			end
			if s.Pos.Y < -10 - EPS then
				bad("step %d is lower than origin.Y - 10 (%.1f)", i, s.Pos.Y)
			end
			if shapeRadius(g.hull) > maxRadius + EPS then
				bad("step %d reaches %.1f studs from the origin (max %d)", i, shapeRadius(g.hull), maxRadius)
			end
			if i > 1 then
				msg = pairProblem(diff, steps[i - 1], geos[i - 1], s, g)
				if msg then
					bad("step %d (%s): %s", i, s.Kind, msg)
				end
			end
			if s.Kind ~= "CannonPad" or type(s.Hazard) == "table" then
				msg = hazardProblem(diff, s, g, steps[i - 1], geos[i - 1])
				if msg then
					bad("step %d (%s): %s", i, s.Kind, msg)
				end
			elseif s.Kind == "CannonPad" then
				bad("step %d: CannonPad has no Hazard", i)
			end
		end)
		if not ok then
			bad("step %d: internal error while validating: %s", i, tostring(err))
		end
	end

	-- stages + checkpoints -------------------------------------------------------------
	local cpCount = 0
	local perStage, bridgesPerStage = {}, {}
	for i, s in ipairs(steps) do
		if s.Kind == "Checkpoint" then
			cpCount = cpCount + 1
		end
		if s.Kind ~= "Start" and s.Kind ~= "Finish" and s.Kind ~= "Checkpoint" and isNum(s.Stage) then
			perStage[s.Stage] = (perStage[s.Stage] or 0) + 1
			if s.Kind == "PlateBridge" then
				bridgesPerStage[s.Stage] = (bridgesPerStage[s.Stage] or 0) + 1
				if themes[s.Stage] ~= "Plates" then
					bad("step %d: PlateBridge outside a Plates stage", i)
				end
			elseif s.Kind == "CannonPad" and themes[s.Stage] ~= "Cannon" then
				bad("step %d: CannonPad outside a Cannon stage", i)
			end
		end
		if i > 1 and isNum(s.Stage) and isNum(steps[i - 1].Stage) and s.Stage < steps[i - 1].Stage then
			bad("step %d goes back to an earlier stage", i)
		end
	end
	if cpCount ~= diff.Stages then
		bad("expected %d checkpoints, found %d", diff.Stages, cpCount)
	end
	local cps = layout.Checkpoints
	if type(cps) ~= "table" then
		bad("layout has no Checkpoints table")
		cps = {}
	end
	local lastCp = 0
	for k = 1, diff.Stages do
		local idx = cps[k]
		local s = idx and steps[idx]
		if not s or s.Kind ~= "Checkpoint" or s.Stage ~= k then
			bad("Checkpoints[%d] does not point at that stage's checkpoint", k)
		else
			if idx <= lastCp then
				bad("Checkpoints[%d] is out of order", k)
			end
			lastCp = idx
		end
	end
	if lastCp ~= n - 1 then
		bad("the last checkpoint (step %d) must sit right before the Finish (step %d)", lastCp, n)
	end
	if isNum(steps[n].Stage) and steps[n].Stage ~= diff.Stages then
		bad("the Finish must belong to the last stage")
	end
	for k = 1, diff.Stages do
		local c = perStage[k] or 0
		if c < diff.StepsPerStage[1] or c > diff.StepsPerStage[2] then
			bad("stage %d has %d steps (expected %d-%d)", k, c, diff.StepsPerStage[1], diff.StepsPerStage[2])
		end
		if (bridgesPerStage[k] or 0) > 1 then
			bad("stage %d has more than one PlateBridge", k)
		end
	end
	-- every stage must really contain what its theme promises
	local kindsInStage = {}
	for _, s in ipairs(steps) do
		if isNum(s.Stage) and s.Kind ~= "Start" and s.Kind ~= "Finish" and s.Kind ~= "Checkpoint" then
			local t = kindsInStage[s.Stage]
			if not t then
				t = {}
				kindsInStage[s.Stage] = t
			end
			t[s.Kind] = (t[s.Kind] or 0) + 1
		end
	end
	for k, theme in ipairs(themes) do
		local have = kindsInStage[k] or {}
		local feature = THEME_FEATURE[theme]
		if feature and (have[feature] or 0) < 1 then
			bad("stage %d (%s) has no %s step", k, theme, feature)
		end
		if theme == "Beams" and (have.Beam or 0) * 2 < (perStage[k] or 0) then
			bad("stage %d (Beams) is mostly not beams", k)
		elseif theme == "Plates" and have.PlateBridge ~= 1 then
			bad("stage %d (Plates) needs exactly one PlateBridge", k)
		elseif theme == "Gauntlet" then
			local distinct = 0
			for kind in pairs(have) do
				if kind ~= "Platform" then
					distinct = distinct + 1
				end
			end
			if distinct < 3 then
				bad("stage %d (Gauntlet) mixes only %d hazard kinds", k, distinct)
			end
		end
	end
	if type(layout.Stages) ~= "table" or #layout.Stages ~= diff.Stages then
		bad("Stages must describe every stage")
	else
		for k, info in ipairs(layout.Stages) do
			if type(info) ~= "table" or info.Index ~= k or info.Theme ~= themes[k] or type(info.Name) ~= "string"
				or not isNum(info.Tint) or not isNum(info.FirstStep) or info.LastStep ~= cps[k] then
				bad("Stages[%d] is malformed", k)
			end
		end
	end

	-- solids: separation, headroom, jump-skips --------------------------------------------
	local solids = {}
	for i, s in ipairs(steps) do
		solids[#solids + 1] = { g = geos[i], tag = "step", owner = i }
		local ok = pcall(bridgeSolids, s, solids)
		if not ok then
			bad("step %d: malformed bridge", i)
		end
	end
	for a = 1, #solids do
		for b = a + 1, #solids do
			local A, B = solids[a], solids[b]
			if not solidsExempt(A, B) then
				local msg = solidPairProblem(A, B)
				if msg then
					bad("%s %d and %s %d: %s", A.tag, A.owner, B.tag, B.owner, msg)
				end
				msg = shortcutProblem(A, B)
				if msg then
					bad("%s", msg)
				end
			end
		end
	end
	for _, s in ipairs(solids) do
		if s.tag ~= "step" and shapeRadius(s.g.hull) > maxRadius + EPS then
			bad("%s of step %d reaches beyond the course radius", s.tag, s.owner)
		end
	end
	-- jump corridors: a full jump of a Walk / Dash link must not bonk its head under another solid
	for i = 2, n do
		if steps[i].Link == "Walk" or steps[i].Link == "Dash" then
			local c = makeCorridor(geos[i - 1], i - 1, geos[i], i)
			if c then
				for _, sol in ipairs(solids) do
					if corridorBlocked(c, sol) then
						bad("%s", corridorMessage(c, sol))
					end
				end
			end
		end
	end

	-- cannon flights --------------------------------------------------------------------------
	for i, s in ipairs(steps) do
		local h = s.Hazard
		if s.Kind == "CannonPad" and type(h) == "table" and isVec(h.Target) and isVec(h.Pos) and isNum(h.FlightTime)
			and isNum(h.PadRadius) and h.FlightTime > 0 then
			local samples = cannonArcSamples(h, s.Pos.Y)
			for _, sol in ipairs(solids) do
				if arcProblem(samples, i, i + 1, sol) then
					bad("the flight of cannon %d hits %s %d", i, sol.tag, sol.owner)
				end
			end
		end
	end

	-- tokens ----------------------------------------------------------------------------------------
	local counted, valueSum, goldenTotal = 0, 0, 0
	local regularSteps, goldenInStage = {}, {}
	for i, s in ipairs(steps) do
		if s.Tokens ~= nil then
			if type(s.Tokens) ~= "table" then
				bad("step %d Tokens is not a list", i)
			else
				local hasRegular = false
				for _, tk in ipairs(s.Tokens) do
					local msg = tokenProblem(s, geos[i], tk, solids)
					if msg then
						bad("step %d: %s", i, msg)
					elseif type(tk) == "table" then
						counted = counted + 1
						valueSum = valueSum + tk.Value
						if tk.Golden then
							goldenTotal = goldenTotal + 1
							goldenInStage[s.Stage] = (goldenInStage[s.Stage] or 0) + 1
						else
							hasRegular = true
						end
					end
				end
				if hasRegular then
					regularSteps[s.Stage] = (regularSteps[s.Stage] or 0) + 1
				end
			end
		end
	end
	if valueSum ~= layout.TotalTokens then
		bad("TotalTokens %s does not match the placed token value %d", tostring(layout.TotalTokens), valueSum)
	end
	if counted ~= layout.TokenCount or goldenTotal ~= layout.GoldenCount then
		bad("TokenCount/GoldenCount do not match the placed tokens")
	end
	for k = 1, diff.Stages do
		if (regularSteps[k] or 0) < diff.TokensPerStage then
			bad("stage %d has regular tokens on %d steps (needs %d)", k, regularSteps[k] or 0, diff.TokensPerStage)
		end
		local gcount = goldenInStage[k] or 0
		if gcount < 1 or gcount > 2 then
			bad("stage %d has %d golden tokens (needs 1-2)", k, gcount)
		end
	end

	-- scenery -----------------------------------------------------------------------------------------
	if type(layout.Scenery) ~= "table" then
		bad("layout has no Scenery list")
	else
		local landmarks = {}
		local samples = {}
		for _, s in ipairs(steps) do
			local h = s.Hazard
			if s.Kind == "CannonPad" and type(h) == "table" and isVec(h.Target) and isVec(h.Pos) and isNum(h.FlightTime)
				and isNum(h.PadRadius) and h.FlightTime > 0 then
				for _, q in ipairs(cannonArcSamples(h, s.Pos.Y)) do
					samples[#samples + 1] = q
				end
			end
		end
		for _, item in ipairs(layout.Scenery) do
			local msg = sceneryProblem(item, solids, samples)
			if msg then
				bad("scenery: %s", msg)
			elseif item.Stage and item.Stage > 0 then
				landmarks[item.Stage] = item.Type
			end
		end
		if type(layout.Stages) == "table" then
			for k, info in ipairs(layout.Stages) do
				if type(info) == "table" and info.Landmark ~= nil and landmarks[k] ~= info.Landmark then
					bad("stage %d names the landmark %s but it is not in Scenery", k, tostring(info.Landmark))
				end
			end
		end
	end

	-- bounds ----------------------------------------------------------------------------------------------
	local bnd = layout.Bounds
	if type(bnd) ~= "table" or not isVec(bnd.Min) or not isVec(bnd.Max) then
		bad("layout has no Bounds")
	else
		for _, s in ipairs(solids) do
			local h = s.g.hull
			local inside = s.g.bot >= bnd.Min.Y - EPS and s.g.top <= bnd.Max.Y + EPS
			for i = 1, h.n do
				local x, z = h[2 * i - 1], h[2 * i]
				if x < bnd.Min.X - EPS or x > bnd.Max.X + EPS or z < bnd.Min.Z - EPS or z > bnd.Max.Z + EPS then
					inside = false
				end
			end
			if not inside then
				bad("%s %d lies outside Bounds", s.tag, s.owner)
				break
			end
		end
	end

	return #problems == 0, problems
end

----------------------------------------------------------------------
-- GenerateLayout
----------------------------------------------------------------------
local MAX_ATTEMPTS = 40

-- Set CourseLayout.Debug = { reasons = {}, attempts = {}, problems = {} } to collect generator statistics.
CourseLayout.Debug = nil

function CourseLayout.GenerateLayout(difficultyId, seed)
	local diff = Config.GetDifficulty(difficultyId) or Config.Difficulties[1]
	seed = tonumber(seed) or 0
	local tier = tierOf(diff)
	local dbg = CourseLayout.Debug
	local lastLayout = nil
	for attempt = 0, MAX_ATTEMPTS - 1 do
		local layout, why = runAttempt(diff, tier, seed, attempt, dbg)
		if layout then
			local ok, problems = CourseLayout.ValidateLayout(layout)
			if ok then
				if dbg and dbg.attempts then
					dbg.attempts[attempt + 1] = (dbg.attempts[attempt + 1] or 0) + 1
				end
				return layout
			end
			lastLayout = layout
			if dbg and dbg.problems then
				for _, p in ipairs(problems) do
					local key = p:gsub("[%d%.%-]+", "#")
					dbg.problems[key] = (dbg.problems[key] or 0) + 1
				end
			end
		elseif dbg and dbg.stuck then
			local key = tostring(why):gsub("[%d%.%-]+", "#")
			dbg.stuck[key] = (dbg.stuck[key] or 0) + 1
		end
	end
	if lastLayout then
		warn("[CourseLayout] no valid " .. diff.Id .. " layout for seed " .. tostring(seed) .. "; using the last attempt")
		return lastLayout
	end
	warn("[CourseLayout] could not generate a " .. diff.Id .. " layout for seed " .. tostring(seed))
	return {
		DifficultyId = diff.Id, Seed = seed, Attempt = MAX_ATTEMPTS, Archetype = "Straight", Themes = {}, Steps = {},
		Stages = {}, Checkpoints = {}, Scenery = {}, TotalTokens = 0, TokenCount = 0, GoldenCount = 0,
		Bounds = { Min = Vector3.new(0, 0, 0), Max = Vector3.new(0, 0, 0) },
	}
end

----------------------------------------------------------------------
-- Stats
----------------------------------------------------------------------
-- Summary numbers of a layout (for the UI, tests and tuning).
function CourseLayout.Stats(layout)
	local out = {
		Steps = 0, Regular = 0, Checkpoints = 0, Tokens = 0, Golden = 0, TotalTokens = 0, Height = 0, PathLength = 0,
		Radius = 0, MaxGap = 0, MaxRise = 0, Hazards = 0, Cannons = 0, Bridges = 0, DashGaps = 0, Beams = 0,
		Movers = 0, Scenery = 0, Stages = 0, Archetype = layout and layout.Archetype, Attempt = layout and layout.Attempt,
		KindCounts = {}, ThemeCounts = {}, HazardCounts = {},
	}
	if type(layout) ~= "table" or type(layout.Steps) ~= "table" then
		return out
	end
	local steps = layout.Steps
	out.Steps = #steps
	out.Tokens = layout.TokenCount or 0
	out.Golden = layout.GoldenCount or 0
	out.TotalTokens = layout.TotalTokens or 0
	out.Scenery = type(layout.Scenery) == "table" and #layout.Scenery or 0
	out.Stages = type(layout.Stages) == "table" and #layout.Stages or 0
	local minY, maxY = huge, -huge
	for i, s in ipairs(steps) do
		out.KindCounts[s.Kind] = (out.KindCounts[s.Kind] or 0) + 1
		if s.Kind == "Checkpoint" then
			out.Checkpoints = out.Checkpoints + 1
		elseif s.Kind ~= "Start" and s.Kind ~= "Finish" then
			out.Regular = out.Regular + 1
		end
		if s.Kind == "CannonPad" then
			out.Cannons = out.Cannons + 1
		elseif s.Kind == "PlateBridge" then
			out.Bridges = out.Bridges + 1
		elseif s.Kind == "DashGap" then
			out.DashGaps = out.DashGaps + 1
		elseif s.Kind == "Beam" then
			out.Beams = out.Beams + 1
		elseif s.Kind == "Moving" then
			out.Movers = out.Movers + 1
		end
		if type(s.Hazard) == "table" then
			out.Hazards = out.Hazards + 1
			out.HazardCounts[s.Hazard.Type] = (out.HazardCounts[s.Hazard.Type] or 0) + 1
		end
		minY = min(minY, s.Pos.Y)
		maxY = max(maxY, s.Pos.Y)
		out.Radius = max(out.Radius, hypot(s.Pos.X, s.Pos.Z))
		if i > 1 then
			local p = steps[i - 1]
			out.PathLength = out.PathLength + hypot(s.Pos.X - p.Pos.X, s.Pos.Z - p.Pos.Z)
			if type(s.Gap) == "number" and s.Link ~= "Cannon" then
				out.MaxGap = max(out.MaxGap, s.Gap)
			end
			out.MaxRise = max(out.MaxRise, s.Pos.Y - p.Pos.Y)
		end
	end
	if minY <= maxY then
		out.Height = maxY - minY
	end
	if type(layout.Themes) == "table" then
		for _, t in ipairs(layout.Themes) do
			out.ThemeCounts[t] = (out.ThemeCounts[t] or 0) + 1
		end
	end
	return out
end

-- helpers the builder / tests may want
CourseLayout.RootHeight = ROOT_H
CourseLayout.RunReach = runReach
CourseLayout.DashReach = dashReach
CourseLayout.AirTime = airTime

-- edge-to-edge gap between two layout steps (largest over a moving step's sweep)
function CourseLayout.StepGap(a, b)
	local _, hi = gapRange(makeGeo(a), makeGeo(b))
	return hi
end

-- local (lx, lz) of a world position inside a step's frame, and back
function CourseLayout.ToLocal(step, x, z)
	return toLocal(makeGeo(step), x, z)
end

function CourseLayout.ToWorld(step, lx, lz)
	return toWorld(makeGeo(step), lx, lz)
end

return CourseLayout
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1087">
          <Properties>
            <string name="Name">DailyService</string>
            <string name="Source"><![CDATA[-- DailyService (store 2026-11-04; docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.2 / 6 / 7 Z8-Z9 / 13b.2-4):
-- the daily gifts behind the one Gifts button: the 7-day streak and the per-day play-time tiers (Config.Daily). Every
-- grant is server-decided, written with its claim in ONE non-yielding DataService.MutateDaily step (the merge's
-- DailyClaims record) and paid right after; the client reads only DailyState.
--
-- The streak (5.2, 13b.2-3)
--   * Ready ReadySeconds (20 h) after the last claim on the SERVER clock (os.time()); kept when claimed within
--     KeepSeconds (48 h): Streak = kept days, cumulative; a claim makes it Streak + 1 and pays cell ((Streak - 1) % 7) + 1
--     of the NEW value (claim 8 = cell 1 of week 2). Weeks = max(Weeks, floor(Streak / 7)) never drops.
--   * A miss steps back one day per missed day at the next claim: stepBack = 1 + floor((gap - 48 h) / 86400),
--     Streak = max(0, Streak - stepBack) + 1. Exactly 48 h is still kept; the boundary is a strict '>'.
--   * Re-earned, never re-paid: Paid = the highest Streak ever paid; a claim pays only when the new Streak > Paid, else
--     "Streak repaired! Day N of 7" and nothing. A miss costs one gift per missed day, never the week. State says what
--     the next claim does before it (re-review 1 and 2): Repair = (the streak it builds on + 1 <= Paid), Claim's own
--     rule, for EVERY claim: the step-back claim and the kept claims after it that climb back to Paid, and a VIP's
--     while Paid > Streak; the Days' Claimed / Today come from that streak (Today on the repair cell, flagged Repair),
--     never a gift the claim will not pay. StaleAt = the moment that view changes by itself (the keep deadline passing,
--     KeepUntil + 1, then each further missed day; 0 = never): the tick re-sends the payload then, and a VIP answer that
--     changes Vip (StoreService.Changed) re-sends it at once. The wait before such a claim names no gift either
--     (re-review 3): a claim sent before it is ready is refused with "Streak repair in 4h 12m" (the window counts down
--     the same text), "Next gift in 4h 12m" only before a claim that pays.
--   * VIP (StoreService.Owns(player, "VIP")) never steps back and gets x2 (Config.Store.Perks.Vip.DailyMult) on the
--     Cash and Tokens cells only (never Gems, the pet or the play tiers). A pass still "Checking" with a step-back due
--     holds the claim ("Checking your VIP pass, one moment", nothing written); no StoreService or an Unavailable pass
--     = never VIP, never held. Attributes are never read for the pass (Z3).
--   * Day 7 of every kept week grants week_wisp through PetService.GrantPet (13b.2); the stack room is checked BEFORE
--     the claim: a full stack resolves the cell's Else (40 Gems). Daily.Pet turns true with the first pet grant.
--   * Cash cells are income-minutes with a floor: max(Min, floor(TycoonService.IncomePerSecond x Minutes x 60)),
--     resolved at state time (the payload carries numbers, 13b.3) and again at the claim (the claim pays its own
--     value). Berries = "Basket" fills the Berry Basket to TycoonCatalog.BasketCap(home, income) minus what is owned.
--   * Z8: a stored LastClaimAt more than FutureClockSlack ahead of now (a wrong clock: the server that wrote it ran
--     fast, or this one runs behind) counts as the now of its FIRST SIGHT (State at the join, so the join's ReadyAt is
--     now + 20 h and the window counts down to a claim; or a claim, which is then refused once with "Next gift in 20h
--     0m"): the player is never locked out for hours. LastClaimAt itself is NEVER written (re-review 1: a bare clamp in
--     the store would let a server whose clock runs behind pull the next gift earlier on every other server, visit after
--     visit). The first sight is noted next to it (re-review 2): Daily.ClampFrom = the stamp, ClampAt = that now,
--     ClampJob = this server's game.JobId (one MutateDaily, NO grant, only when the record holds no first sight of this
--     stamp from this server), so a later session on THIS server counts from the same moment instead of starting the
--     20 h over (a rejoin here). A sight another server noted is never reused (re-review 3): it is a reading of another
--     clock, and a slower one would start the countdown early; that session counts from its own first sight and notes
--     it in its place. A server that sees the stamp as past uses the stamp itself: a slow server's first sight of a
--     correct claim never pulls the gift earlier there. The costs (accepted, spec Z8): a session on another server
--     starts the 20 h over while the stamp still reads ahead there (bounded by the stamp's lead); when a fast server's
--     stamp falls behind the clocks before the countdown ends, a NEW session counts from the stamp (at most that clock's
--     offset later than the window said); the session that saw it keeps its countdown. A changed stamp (a claim, a
--     rebase) drops the session's clamp; a claim clears ClampFrom / ClampAt / ClampJob. A second request finds
--     LastClaimAt = now. Two servers: the section 6 merge (a claim
--     less than ReadySeconds after a STORED claim it did not build on loses its grant; the grant's Prev names the stamp
--     it built on, so a claim after a clamp is no exception). The claim's one `now` is its LastClaimAt AND its grant's At
--     (MutateDaily's `now` argument): a second ticking inside Claim never splits the pair from its grant in the merge.
--
-- Play time (5.2, 13b.4, Q17, Z9)
--   * Per play-day on the rolling PlayStart clock: a Tick every TickSeconds (10 s) counts for a player whose root moved
--     more than MoveStuds since the last sample OR whose client fired one of Play.ActiveRemotes within ActiveWindow
--     (180 s; this service adds its own OnServerEvent listener to each). The first tick >= DaySeconds (20 h) after
--     PlayStart starts a new day, counting or not: PlayStart = now, PlaySec = 0, PlayClaimed = {} (unclaimed tiers are
--     LOST, Q17); until that tick runs (no root) State shows no tier Ready and ClaimPlay refuses ("That play day is
--     over!"). A first PlayStart is set by the first COUNTING tick only.
--     PlaySec caps at MaxDaySeconds (10 h). Matches count as play; a provisional profile never ticks (its stand-in's
--     PlayStart would win the stored Play group).
--   * No root (no Character, no HumanoidRootPart) or a dead Humanoid (between respawns): nothing happens: no seconds,
--     no PlayStart reset, no sample (Review Focus 4).
--   * Play.Active (the paused clock, 13b.4) is sent on each CHANGE, never per tick; a tier crossing or a day reset
--     sends too (the pip shake).
--   * ClaimPlay(tier): PlaySec >= Tiers[tier].Min x 60 and not yet claimed: the flag and the grant in one step
--     ({ Kind = "Play", Tier }), paid right after; two servers at one PlayStart pay once (the (PlayStart, tier) merge).
--   * ClaimPlayAll (gui-redo 5.4, the gift boxes' CLAIM ALL): every Ready tier in tier order through ClaimPlay's own
--     quiet step (claimTier: each tier its own MutateDaily flag + grant, paid right after it; nothing yields), then ONE
--     toast and ONE payload; Claimed fires once per tier. A Ready tier that would pay nothing now (Resolve: a full Berry
--     Basket, Amount 0) is skipped and stays Ready for its own box (review fix: a bulk claim never spends it for
--     nothing). Toast: one tier = ClaimPlay's text; several = each pay text
--     without its "!", joined with ", ", then ": n gifts!" ("+$2,160 Cash, +10 Gems: 2 gifts!"), or "n gifts claimed!"
--     when that would pass 60 characters. None Ready: "No gifts ready yet!" ("Your Berry Basket is full!" when only a
--     full Basket's tier is Ready). The same refusals as ClaimPlay (loaded, a play-day that is over); the merge pays
--     each (PlayStart, tier) once, as for ClaimPlay.
--
-- The 10-minute unlock and the hold (gui-redo, docs/superpowers/specs/2026-11-06-window-redo-design.md 5.3)
--   * Every streak claim (a paid day, the Week Wisp, the first ever, a VIP's, the repair) needs Config.Daily.UnlockSeconds
--     (600) counted play seconds of the current play-day: the play clock above (PlaySec on a live PlayStart; a play-day
--     not started or over counts 0; its AFK rule; its 20 h reset restarts the count; a provisional profile never ticks).
--     Claim order: loaded -> not ready (the texts above) -> LOCKED: refused, nothing written, "Play 6 more min to unlock
--     today's gift!" / "Play 6 more min to repair your streak!" (a claim that would only repair; minutes = ceil(left / 60))
--     -> VIP "Checking" -> the step-back -> commit and pay. Play tiers and the Trove are not affected. 0 = the rule off.
--   * The hold: the step-back gap is measured at keepAt, never later than now (keepOf, shared by State and Claim): from =
--     min(the live PlayStart, now - this session's held seconds for this stamp), keepAt = min(now, max(from, last +
--     ReadySeconds)). The held seconds (holds[player] = { Last = the stamp, Sec }, in memory only, dropped on leave and by
--     a claim) grow by TickSeconds on each COUNTING tick that finds the gift due and still locked (PlaySec after any reset,
--     before the tick's add, < UnlockSeconds); a changed stamp (a claim, a rebase, another server's claim) starts them at
--     0. So playing toward the unlock never counts as time away, even across a play-day reset or a hop (the stored
--     PlayStart). UnlockSeconds 0: keepAt = now (today's step-backs exactly).
--   * State uses keepAt for the missed streak, Repair, Cell and Today; StaleAt: held by PlayStart -> its play-day's end
--     (PlayStart + DaySeconds); held by the session's seconds -> today's rule at keepAt + Sec; else today's rule at now.
--   * Payload: Unlock = { Need = UnlockSeconds, Left = max(0, Need - live PlaySec) } (Loading: Left = Need). The tick sends
--     a payload when the live PlaySec crosses UnlockSeconds (before < Need <= after), so CLAIM shows on time.
--
-- Remote DailyRequest(action, tier): "Claim" (no second argument) / "ClaimPlay" (a whole 1..7) / "ClaimPlayAll" (no
-- second argument). isPlayer, one request per second per action (each action its own gap), type checks, refused InMatch
-- with a toast; junk (any third argument too) is dropped without an answer and spends no gap (Z12).
-- ProfileLoaded / ProfileRebased -> Send(player) (a Loading payload while provisional), NO Notify on load: nothing is
-- announced on join (the client's pip waits PipDelaySeconds). The tick re-sends a payload whose StaleAt has passed;
-- StoreService.Changed re-sends it when the VIP answer differs from the last payload's Vip.
--
-- Public API
--   DailyService.Init(deps)              deps = { DataService, StoreService?, PetService, TycoonService?, TutorialService? }
--   DailyService.Resolve(player, reward, vip) -> { Kind = "Cash"|"Tokens"|"Gems"|"Berries"|"Pet"|"None", Amount, PetId }
--   DailyService.State(player) -> payload | nil (nil until the profile is loaded; Loading = true while provisional)
--   DailyService.Send(player)            fires DailyState(State(player)) to that client
--   DailyService.Claim(player) -> ok, { Cell, Streak, Grant, StepBack } | reason
--   DailyService.ClaimPlay(player, tier) -> ok, { Tier, Grant } | reason
--   DailyService.ClaimPlayAll(player) -> ok, { Tiers = { tier... }, Grants = { grant | false... } } | reason
--                                        (Grants[i] belongs to Tiers[i]; a tier that would pay nothing is not claimed)
--   DailyService.Tick()                  one play-time tick over every player
--   DailyService.Claimed                 Util.Signal Fire(player, "Day" | "Play", cellOrTier, grant)
--   DailyService._deps()                 test-only: the live deps table (a test swaps deps.StoreService for a double)
--   DailyService._tickAt()               test-only: os.clock() of the last loop tick
--   DailyService._holds(player)          test-only: this session's held seconds { Last, Sec } | nil (the hold)
--
-- Plain Lua 5.1-compatible syntax only. Nothing here yields between a check and its write.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local TycoonCatalog = require(Shared.TycoonCatalog)
local PetCatalog = require(Shared.PetCatalog)

local DailyService = {}
DailyService.Claimed = Util.Signal() -- Fire(player, "Day" | "Play", cellOrTier, grant)

local WEEK = 7
local REQUEST_GAP = 1 -- seconds between two DailyRequests of one action by one player
local TEXT = {
	Loading = "Your save is still loading",
	InMatch = "Finish your match first!",
	Checking = "Checking your VIP pass, one moment",
	Next = "Next gift in %dh %dm",
	RepairNext = "Streak repair in %dh %dm", -- the wait before a claim that only repairs (re-review 3)
	Repaired = "Streak repaired! Day %d of 7",
	Week = "WEEK DONE! %s is yours!",
	Day = "%s Day %d of 7",
	Play = "%s %d min played",
	Full = "Your Berry Basket is full!",
	Already = "You already claimed that!",
	NotYet = "Play %d more minutes!",
	DayOver = "That play day is over!",
	Unavailable = "Player unavailable",
	Locked = "Play %d more min to unlock today's gift!", -- a ready streak claim before UnlockSeconds of play (gui-redo 5.3)
	LockedRepair = "Play %d more min to repair your streak!", -- ...when that claim would only repair
	NoneReady = "No gifts ready yet!", -- ClaimPlayAll with no Ready tier (gui-redo 5.4)
	Gifts = "%s: %d gifts!", -- ClaimPlayAll, several tiers: the joined pay texts
	GiftsShort = "%d gifts claimed!", -- ...when the joined text would pass GIFTS_MAX characters
}
local GIFTS_MAX = 60

local deps = {}
local active = {} -- [player] = { On = bool, LastRemote = os.clock() | nil }
local sample = {} -- [player] = the root's Vector3 at the last tick
local lastRequest = {} -- [player] = { [action] = os.clock() }
local stepBacks = {} -- [player] = the last claim's step-back, sent once
local clamps = {} -- [player] = { From = the stored future LastClaimAt, At = the now of its first sight } (Z8)
local sent = {} -- [player] = { Vip = the last payload's Vip, StaleAt = its StaleAt } (the re-sends)
local holds = {} -- [player] = { Last = the stamp, Sec = counting seconds while it was due and locked } (the hold, 5.3)
local started = false
local tickAt = -1

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function cfg()
	return type(Config.Daily) == "table" and Config.Daily or {}
end

local function playCfg()
	local c = cfg()
	return type(c.Play) == "table" and c.Play or {}
end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v then
		return default
	end
	return v
end

local function whole(n)
	n = num(n, 0)
	if n < 0 then
		return 0
	end
	return math.floor(n + 1e-9)
end

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function attr(player, key)
	local name = Config.Attr and Config.Attr[key]
	if type(name) ~= "string" then
		return nil
	end
	return player:GetAttribute(name)
end

local function fire(name, player, ...)
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote and isLivePlayer(player) then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind)
	fire("Notify", player, text, kind or "info", 4)
end

local function commas(n)
	local s = tostring(math.floor(num(n, 0)))
	while true do
		local k
		s, k = string.gsub(s, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return s
end

local function dailyMult()
	local store = type(Config.Store) == "table" and Config.Store or {}
	local perks = type(store.Perks) == "table" and store.Perks or {}
	local vip = type(perks.Vip) == "table" and perks.Vip or {}
	return math.max(1, num(vip.DailyMult, 2))
end

-- the clean Daily record, or nil until loaded and while provisional
local function dailyOf(player)
	local DS = deps.DataService
	if not DS or type(DS.GetDaily) ~= "function" then
		return nil
	end
	local ok, d = pcall(DS.GetDaily, player)
	if ok and type(d) == "table" then
		return d
	end
	return nil
end

local function provisional(player)
	local DS = deps.DataService
	return DS ~= nil and type(DS.IsProvisional) == "function" and DS.IsProvisional(player) == true
end

local function income(player)
	local Ty = deps.TycoonService
	if not Ty or type(Ty.IncomePerSecond) ~= "function" then
		return 0
	end
	local ok, v = pcall(Ty.IncomePerSecond, player)
	v = ok and num(v, 0) or 0
	if v < 0 then
		return 0
	end
	return v
end

local function homeOf(player)
	local Ty = deps.TycoonService
	if not Ty or type(Ty.GetHome) ~= "function" then
		return nil
	end
	local ok, home = pcall(Ty.GetHome, player)
	return ok and home or nil
end

local function berriesOf(player)
	local DS = deps.DataService
	if not DS or type(DS.GetBerries) ~= "function" then
		return 0
	end
	local ok, n = pcall(DS.GetBerries, player)
	return ok and whole(n) or 0
end

-- copies of petId the player holds (0 without a readable profile)
local function petCount(player, petId)
	local DS = deps.DataService
	if not DS or type(DS.GetProfile) ~= "function" then
		return 0
	end
	local ok, profile = pcall(DS.GetProfile, player)
	if ok and type(profile) == "table" and type(profile.Pets) == "table" then
		return whole(profile.Pets[petId])
	end
	return 0
end

local function stackRoom(player, petId)
	return num(Config.Pets and Config.Pets.MaxPerStack, 99) - petCount(player, petId)
end

local function ownsVip(player)
	local SS = deps.StoreService
	if not SS or type(SS.Owns) ~= "function" then
		return false
	end
	local ok, owns = pcall(SS.Owns, player, "VIP")
	return ok and owns == true
end

local function vipState(player)
	local SS = deps.StoreService
	if not SS or type(SS.PassState) ~= "function" then
		return "Unavailable"
	end
	local ok, state = pcall(SS.PassState, player, "VIP")
	return ok and tostring(state) or "Unavailable"
end

local function activeOf(player)
	local a = active[player]
	if not a then
		a = { On = false, LastRemote = nil }
		active[player] = a
	end
	return a
end

local function limited(player, action)
	local record = lastRequest[player]
	if not record then
		record = {}
		lastRequest[player] = record
	end
	local now = os.clock()
	local last = record[action]
	if last and now - last < REQUEST_GAP then
		return true
	end
	record[action] = now
	return false
end

local function validTier(tier)
	local tiers = playCfg().Tiers
	local n = type(tiers) == "table" and #tiers or 0
	return type(tier) == "number" and tier == tier and tier >= 1 and tier <= n and tier == math.floor(tier)
end

-- the refusal of a claim that is not ready yet: "Next gift in 4h 12m", or "Streak repair in 4h 12m" when that claim
-- will only repair (`repair`), so the wait never names a gift the claim will not pay
local function nextText(seconds, repair)
	seconds = math.max(0, whole(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	if h == 0 and m == 0 and seconds > 0 then
		m = 1
	end
	return string.format(repair and TEXT.RepairNext or TEXT.Next, h, m)
end

-- the grant record of a resolved reward ({ Kind, Tier, Cash | Tokens | Gems | Berries | Pets }), nil when nothing is paid
local function grantOf(r, kind, tier)
	if type(r) ~= "table" then
		return nil
	end
	local g = { Kind = kind, Tier = tier }
	if r.Kind == "Pet" and type(r.PetId) == "string" then
		g.Pets = { [r.PetId] = 1 }
	elseif (r.Kind == "Cash" or r.Kind == "Tokens" or r.Kind == "Gems" or r.Kind == "Berries") and whole(r.Amount) >= 1 then
		g[r.Kind] = whole(r.Amount)
	else
		return nil
	end
	return g
end

-- pays a resolved reward (after its claim committed); answers the toast's amount text
local function pay(player, r)
	local DS = deps.DataService
	local amount = whole(r.Amount)
	if r.Kind == "Cash" then
		if amount >= 1 then
			DS.AddCash(player, amount)
		end
		return "+$" .. commas(amount) .. " Cash!"
	elseif r.Kind == "Tokens" then
		if amount >= 1 then
			DS.AddTokens(player, amount)
		end
		return "+" .. commas(amount) .. " Tokens!"
	elseif r.Kind == "Gems" then
		if amount >= 1 then
			DS.AddGems(player, amount)
		end
		return "+" .. commas(amount) .. " Gems!"
	elseif r.Kind == "Berries" then
		if amount >= 1 then
			DS.AddBerries(player, amount)
			return "+" .. commas(amount) .. " Berries!"
		end
		return TEXT.Full
	elseif r.Kind == "Pet" then
		local PS = deps.PetService
		local ok, result = false, "no PetService"
		if PS and type(PS.GrantPet) == "function" then
			ok, result = PS.GrantPet(player, r.PetId, { Count = 1 })
		end
		if not ok then
			warn("[DailyService] GrantPet " .. tostring(r.PetId) .. " failed after the claim: " .. tostring(result))
		end
		local def = type(PetCatalog.Get) == "function" and PetCatalog.Get(r.PetId) or nil
		return string.format(TEXT.Week, def and def.Name or tostring(r.PetId))
	end
	return nil
end

local function readyCount(d, tiers)
	local n = 0
	for i, t in ipairs(tiers) do
		if d.PlaySec >= num(t.Min, 0) * 60 and d.PlayClaimed[i] ~= true then
			n = n + 1
		end
	end
	return n
end

-- true when the record's play-day has run its DaySeconds (its tiers are lost; the next tick starts a new day)
local function dayOver(d, now)
	local start = num(d.PlayStart, 0)
	return start > 0 and now >= start + num(playCfg().DaySeconds, 72000)
end

-- the counted play seconds a streak claim needs on the current play-day (5.3); 0 = the rule is off (no lock, no hold)
local function unlockNeed()
	return whole(cfg().UnlockSeconds)
end

-- the counted play seconds of the LIVE play-day: PlaySec when it started and is not over, else 0
local function livePlaySec(d, now)
	if num(d.PlayStart, 0) > 0 and not dayOver(d, now) then
		return whole(d.PlaySec)
	end
	return 0
end

-- The hold (5.3): the moment a claim's step-back gap is measured at -> keepAt, source ("PlayStart" | "Held" | nil), the held
-- seconds. from = min(the live PlayStart, now - this session's held seconds for this stamp); keepAt = min(now, max(from,
-- last + ReadySeconds)); now with no source when nothing holds it, the rule is off or there is no claim yet.
local function keepOf(player, d, last, now)
	if unlockNeed() <= 0 or last <= 0 then
		return now, nil, 0
	end
	local from, source = nil, nil
	if num(d.PlayStart, 0) > 0 and not dayOver(d, now) then
		from, source = num(d.PlayStart, 0), "PlayStart"
	end
	local h = holds[player]
	local sec = (h and h.Last == last) and num(h.Sec, 0) or 0
	if sec > 0 and (from == nil or now - sec < from) then
		from, source = now - sec, "Held"
	end
	if from == nil then
		return now, nil, sec
	end
	local at = math.max(from, last + num(cfg().ReadySeconds, 72000))
	if at >= now then
		return now, nil, sec
	end
	return at, source, sec
end

-- today's StaleAt rule at the moment t for the stamp `last`: the keep deadline passing (KeepUntil + 1), then each further
-- missed day
local function staleRule(t, last, keep)
	if t - last > keep then
		return last + keep + 86400 * (math.floor((t - last - keep) / 86400) + 1)
	end
	return last + keep + 1
end

-- this server's game.JobId (the clock a Z8 first sight was read on; "" in Studio or when unreadable)
local function jobId()
	local ok, id = pcall(function()
		return game.JobId
	end)
	return (ok and type(id) == "string") and id or ""
end

-- Z8: this session's LastClaimAt. A stored stamp more than FutureClockSlack ahead of now counts as the now of its
-- first sight ON THIS SERVER'S CLOCK: the record's ClampAt when this server noted one for this stamp (ClampFrom ==
-- LastClaimAt and ClampJob == game.JobId: a rejoin here; never later than now), else this call's now, which is then
-- noted in the record in place of any other (ClampFrom / ClampAt / ClampJob, no grant; LastClaimAt is never touched).
-- A sight another server noted is never reused (re-review 3): it is a reading of that server's clock, and a slower
-- clock's sight would start the countdown early here. The session keeps that value until the stored stamp changes (a
-- claim, a rebase), also after the stamp falls behind now. A stamp this server sees as past is used as it is (see the
-- header). Answers the stamp and true when this call started the session's clamp.
local function lastClaimOf(player, d, now)
	local stored = d.LastClaimAt
	local c = clamps[player]
	if c and c.From == stored then
		return c.At, false
	end
	clamps[player] = nil
	if stored <= now + num(cfg().FutureClockSlack, 300) then
		return stored, false
	end
	local at = now
	local seen = num(d.ClampAt, 0)
	local job = jobId()
	if num(d.ClampFrom, 0) == stored and seen > 0 and d.ClampJob == job then
		at = math.min(seen, now)
	else
		local DS = deps.DataService
		if DS and type(DS.MutateDaily) == "function" then
			pcall(DS.MutateDaily, player, function(live)
				if num(live.LastClaimAt, 0) ~= stored then
					return false
				end
				live.ClampFrom = stored
				live.ClampAt = now
				live.ClampJob = job
				return true
			end)
		end
	end
	clamps[player] = { From = stored, At = at }
	return at, true
end

local function defaultDaily()
	return { Streak = 0, Paid = 0, LastClaimAt = 0, Weeks = 0, Pet = false, PlayStart = 0, PlaySec = 0, PlayClaimed = {}, ClampFrom = 0, ClampAt = 0, ClampJob = "" }
end

----------------------------------------------------------------------
-- public: Resolve / State / Send
----------------------------------------------------------------------
-- A reward entry of Config.Daily (a cell or a play tier) -> what it pays THIS player now: { Kind, Amount, PetId }.
-- Cash = max(Min, floor(income x Minutes x 60)) and Tokens take the VIP multiplier when `vip`; Gems never; Berries
-- fill the Basket; a Pet with no stack room resolves the entry's Else.
function DailyService.Resolve(player, reward, vip)
	reward = type(reward) == "table" and reward or {}
	local mult = vip and dailyMult() or 1
	if type(reward.Pet) == "string" then
		if stackRoom(player, reward.Pet) > 0 then
			return { Kind = "Pet", Amount = 1, PetId = reward.Pet }
		end
		if type(reward.Else) == "table" then
			return DailyService.Resolve(player, reward.Else, vip)
		end
		return { Kind = "None", Amount = 0 }
	end
	if reward.Cash ~= nil then
		local amount
		if type(reward.Cash) == "table" then
			local minutes = math.max(0, num(reward.Cash.Minutes, 0))
			local floor = math.max(0, num(reward.Cash.Min, 0))
			amount = math.max(floor, math.floor(income(player) * minutes * 60 + 1e-9))
		else
			amount = math.max(0, num(reward.Cash, 0))
		end
		return { Kind = "Cash", Amount = whole(amount * mult) }
	end
	if reward.Tokens ~= nil then
		return { Kind = "Tokens", Amount = whole(math.max(0, num(reward.Tokens, 0)) * mult) }
	end
	if reward.Gems ~= nil then
		return { Kind = "Gems", Amount = whole(reward.Gems) }
	end
	if reward.Berries ~= nil then
		local amount
		if reward.Berries == "Basket" then
			amount = TycoonCatalog.BasketCap(homeOf(player), income(player)) - berriesOf(player)
		else
			amount = num(reward.Berries, 0)
		end
		return { Kind = "Berries", Amount = whole(math.max(0, amount)) }
	end
	return { Kind = "None", Amount = 0 }
end

-- The DailyState payload (DailyController's shape), or nil until the profile is loaded. While provisional it carries
-- Loading = true (the client hides CLAIM and the pip) with ReadyAt = now + ReadySeconds.
function DailyService.State(player)
	if not isLivePlayer(player) or not deps.DataService then
		return nil
	end
	local C = cfg()
	local P = playCfg()
	local now = os.time()
	local d = dailyOf(player)
	local loading = false
	if not d then
		if not provisional(player) then
			return nil
		end
		loading = true
		d = defaultDaily()
	end
	local last = loading and 0 or lastClaimOf(player, d, now) -- Z8: this session's stamp (LastClaimAt never written here)
	local ready = num(C.ReadySeconds, 72000)
	local keep = num(C.KeepSeconds, 172800)
	local vip = ownsVip(player)
	-- the hold (5.3): the gap is measured at keepAt, as Claim measures it, so the window never promises what the claim
	-- will not do
	local keepAt, source, held = now, nil, 0
	if not loading then
		keepAt, source, held = keepOf(player, d, last, now)
	end
	-- the streak the claim will build on: a step-back due (Claim's rule; never for a VIP) lowers it first. The claim
	-- re-earns a paid day whenever that streak + 1 <= Paid (Claim's pays = streak > Paid): a repair, so Today moves to
	-- the repair cell and no gift is promised. Every claim: the step-back one, the kept ones that climb back to Paid,
	-- a VIP's while Paid > Streak (re-review 1 and 2)
	local streak = d.Streak
	local missed = not loading and not vip and last > 0 and keepAt - last > keep
	if missed then
		streak = math.max(0, d.Streak - (1 + math.floor((keepAt - last - keep) / 86400)))
	end
	local repair = (not loading) and streak + 1 <= d.Paid
	-- StaleAt: when this view changes with no claim: the keep deadline passing (Claim's strict '>'), then each further
	-- missed day while the streak can still fall; 0 = never (loading, a VIP, no claim yet, a streak already at 0). Held by
	-- the live PlayStart the view can only change when that play-day ends; held by the session's seconds, today's rule at
	-- keepAt shifted by them (the moment now - Sec passes the next boundary if the player stood still from now on)
	local staleAt = 0
	if not loading and not vip and last > 0 and streak > 0 then
		if source == "PlayStart" then
			staleAt = d.PlayStart + num(P.DaySeconds, 72000)
		elseif source == "Held" then
			staleAt = staleRule(keepAt, last, keep) + held
		else
			staleAt = staleRule(now, last, keep)
		end
	end
	local cell = (streak % WEEK) + 1
	local days = {}
	for i, reward in ipairs(type(C.Days) == "table" and C.Days or {}) do
		local r = DailyService.Resolve(player, reward, vip)
		local claimed = streak > 0 and i <= ((streak - 1) % WEEK) + 1 and d.Paid >= math.floor((streak - 1) / WEEK) * WEEK + i
		local today = (i == cell) and not claimed
		days[i] = { Kind = r.Kind, Amount = r.Amount, PetId = r.PetId, Claimed = claimed, Today = today, Repair = (repair and today) or nil }
	end
	local tiers = {}
	local over = dayOver(d, now)
	for i, t in ipairs(type(P.Tiers) == "table" and P.Tiers or {}) do
		local r = DailyService.Resolve(player, t, false)
		local claimed = d.PlayClaimed[i] == true
		tiers[i] = { Min = num(t.Min, 0), Kind = r.Kind, Amount = r.Amount, PetId = r.PetId, Claimed = claimed, Ready = (not loading) and (not over) and d.PlaySec >= num(t.Min, 0) * 60 and not claimed }
	end
	local readyAt = now
	if loading then
		readyAt = now + ready
	elseif last > 0 then
		readyAt = last + ready
	end
	local dayEnds = now + num(P.DaySeconds, 72000)
	if d.PlayStart > 0 then
		dayEnds = d.PlayStart + num(P.DaySeconds, 72000)
	end
	local a = active[player]
	local stepBack = stepBacks[player] or 0
	stepBacks[player] = nil
	local need = unlockNeed()
	return {
		Loading = loading or nil,
		Streak = d.Streak,
		Paid = d.Paid,
		Weeks = d.Weeks,
		Cell = cell,
		Repair = repair, -- the next claim repairs the streak and pays nothing (Today = the repair cell)
		StaleAt = staleAt, -- this view (Repair, Cell, Today) stops being true at this server time; 0 = never
		ReadyAt = readyAt,
		KeepUntil = last > 0 and last + keep or 0,
		ServerNow = now,
		Vip = vip,
		StepBack = stepBack,
		-- the 10-minute unlock (5.3): Left 0 = a ready claim may go; Need 0 = the rule is off
		Unlock = { Need = need, Left = loading and need or math.max(0, need - livePlaySec(d, now)) },
		Days = days,
		Play = {
			Seconds = d.PlaySec,
			DayEnds = dayEnds,
			Active = a ~= nil and a.On == true,
			Tiers = tiers,
		},
	}
end

function DailyService.Send(player)
	local state = DailyService.State(player)
	if state then
		sent[player] = { Vip = state.Vip == true, StaleAt = num(state.StaleAt, 0) }
		fire("DailyState", player, state)
	end
	return state
end

----------------------------------------------------------------------
-- public: Claim / ClaimPlay
----------------------------------------------------------------------
function DailyService.Claim(player)
	if not isLivePlayer(player) then
		return false, TEXT.Unavailable
	end
	local DS = deps.DataService
	local d = dailyOf(player)
	if not DS or not d then
		return false, TEXT.Loading
	end
	local C = cfg()
	local now = os.time()
	local ready = num(C.ReadySeconds, 72000)
	local keep = num(C.KeepSeconds, 172800)
	-- Z8: a wrong-clock stamp counts as the session's first sight of it (never written); a claim that starts the clamp
	-- is refused with "Next gift in 20h 0m" and sends the payload that counts down from now
	local last, clamped = lastClaimOf(player, d, now)
	if last > 0 and now - last < ready then
		if clamped then
			DailyService.Send(player)
		end
		-- not ready means no step-back is due (gap < ReadySeconds < KeepSeconds): the claim builds on d.Streak
		return false, nextText(ready - (now - last), num(d.Streak, 0) + 1 <= num(d.Paid, 0))
	end
	-- the hold (5.3): the gap is measured at keepAt (never later than now), as State shows it
	local gap = keepOf(player, d, last, now) - last
	local stepBack = 0
	if last > 0 and gap > keep then
		stepBack = 1 + math.floor((gap - keep) / 86400)
	end
	local vip = ownsVip(player)
	-- locked (5.3): a ready claim waits for UnlockSeconds of the live play-day; refused, nothing written
	local left = unlockNeed() - livePlaySec(d, now)
	if left > 0 then
		local repair = math.max(0, num(d.Streak, 0) - (vip and 0 or stepBack)) + 1 <= num(d.Paid, 0)
		return false, string.format(repair and TEXT.LockedRepair or TEXT.Locked, math.ceil(left / 60))
	end
	if stepBack > 0 and not vip and vipState(player) == "Checking" then
		return false, TEXT.Checking
	end
	if vip then
		stepBack = 0
	end
	local streak = math.max(0, d.Streak - stepBack) + 1
	local cell = ((streak - 1) % WEEK) + 1
	local pays = streak > d.Paid
	local reward = type(C.Days) == "table" and C.Days[cell] or nil
	local r = (pays and reward) and DailyService.Resolve(player, reward, vip) or nil
	local grant = r and grantOf(r, "Day") or nil
	local ok = DS.MutateDaily(player, function(live)
		live.Streak = streak
		live.LastClaimAt = now
		live.ClampFrom = 0 -- the Z8 first sight belonged to the stamp this claim replaces
		live.ClampAt = 0
		live.ClampJob = ""
		live.Paid = math.max(num(live.Paid, 0), streak)
		live.Weeks = math.max(num(live.Weeks, 0), math.floor(streak / WEEK))
		if r and r.Kind == "Pet" then
			live.Pet = true
		end
		return true
	end, grant, now) -- the grant's At is this claim's now: the merge pairs them by that one stamp
	if not ok then
		return false, TEXT.Loading
	end
	-- nothing yields between the commit and the pay
	local text
	if r then
		local head = pay(player, r)
		if r.Kind == "Pet" then
			text = head
		elseif head then
			text = string.format(TEXT.Day, head, cell)
		end
	else
		text = string.format(TEXT.Repaired, cell)
	end
	if stepBack > 0 then
		stepBacks[player] = stepBack
	end
	holds[player] = nil -- the held seconds belonged to the stamp this claim replaces
	if text then
		notify(player, text, "good")
	end
	DailyService.Claimed:Fire(player, "Day", cell, grant)
	DailyService.Send(player)
	return true, { Cell = cell, Streak = streak, Grant = grant, StepBack = stepBack }
end

-- One play tier's claim, QUIET (ClaimPlay and ClaimPlayAll share it): `d` is the loaded record of a play-day that is not
-- over. PlaySec >= the tier's minutes and not yet claimed: the flag and the grant in one MutateDaily step, paid right after
-- (nothing yields between). Answers true, grant | nil, pay's text | nil, or false, reason. The caller toasts, fires
-- Claimed and sends.
local function claimTier(player, d, tier)
	local t = playCfg().Tiers[tier]
	local need = num(t.Min, 0) * 60
	if d.PlayClaimed[tier] == true then
		return false, TEXT.Already
	end
	if d.PlaySec < need then
		return false, string.format(TEXT.NotYet, math.ceil((need - d.PlaySec) / 60))
	end
	local r = DailyService.Resolve(player, t, false)
	local grant = grantOf(r, "Play", tier)
	local ok = deps.DataService.MutateDaily(player, function(live)
		if type(live.PlayClaimed) ~= "table" then
			live.PlayClaimed = {}
		end
		live.PlayClaimed[tier] = true
		return true
	end, grant)
	if not ok then
		return false, TEXT.Loading
	end
	return true, grant, pay(player, r)
end

function DailyService.ClaimPlay(player, tier)
	if not isLivePlayer(player) then
		return false, TEXT.Unavailable
	end
	if not validTier(tier) then
		return false, "Unknown tier"
	end
	local DS = deps.DataService
	local d = dailyOf(player)
	if not DS or not d then
		return false, TEXT.Loading
	end
	if dayOver(d, os.time()) then
		return false, TEXT.DayOver
	end
	local ok, grant, head = claimTier(player, d, tier)
	if not ok then
		return false, grant
	end
	if head then
		notify(player, string.format(TEXT.Play, head, num(playCfg().Tiers[tier].Min, 0)), "good")
	end
	DailyService.Claimed:Fire(player, "Play", tier, grant)
	DailyService.Send(player)
	return true, { Tier = tier, Grant = grant }
end

-- Claim All (5.4): every Ready tier in tier order through claimTier, then ONE toast and ONE payload (header)
function DailyService.ClaimPlayAll(player)
	if not isLivePlayer(player) then
		return false, TEXT.Unavailable
	end
	local d = dailyOf(player)
	if not deps.DataService or not d then
		return false, TEXT.Loading
	end
	if dayOver(d, os.time()) then
		return false, TEXT.DayOver
	end
	local list = type(playCfg().Tiers) == "table" and playCfg().Tiers or {}
	local tiers, grants, heads = {}, {}, {}
	local refusal = TEXT.NoneReady
	for tier, t in ipairs(list) do
		if d.PlayClaimed[tier] ~= true and d.PlaySec >= num(t.Min, 0) * 60 then
			local r = DailyService.Resolve(player, t, false)
			if not grantOf(r, "Play", tier) then
				-- (review fix) a tier that would pay nothing now (a full Berry Basket) stays Ready for its own box: a bulk
				-- claim never flags it claimed for nothing, nor counts it as a gift
				if r.Kind == "Berries" then
					refusal = TEXT.Full
				end
			else
				local ok, grant, head = claimTier(player, d, tier)
				if not ok then
					refusal = grant -- the record went away mid-way (nothing yields: only a removed profile); keep what committed
					break
				end
				tiers[#tiers + 1] = tier
				grants[#tiers] = grant or false
				if head then
					heads[#heads + 1] = head
				end
			end
		end
	end
	if #tiers == 0 then
		return false, refusal
	end
	local text
	if #tiers == 1 then
		text = heads[1] and string.format(TEXT.Play, heads[1], num(list[tiers[1]].Min, 0)) or nil
	else
		local parts = {}
		for i, head in ipairs(heads) do
			parts[i] = (string.gsub(head, "!$", ""))
		end
		text = string.format(TEXT.Gifts, table.concat(parts, ", "), #tiers)
		if #heads == 0 or #text > GIFTS_MAX then
			text = string.format(TEXT.GiftsShort, #tiers)
		end
	end
	if text then
		notify(player, text, "good")
	end
	for i, tier in ipairs(tiers) do
		DailyService.Claimed:Fire(player, "Play", tier, grants[i] or nil)
	end
	DailyService.Send(player)
	return true, { Tiers = tiers, Grants = grants }
end

----------------------------------------------------------------------
-- public: Tick
----------------------------------------------------------------------
local function tickPlayer(player, P, now, clock)
	local DS = deps.DataService
	local d = dailyOf(player) -- nil until loaded and while provisional: no tick
	if not d then
		return
	end
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	local hum = Util.GetHumanoid(player)
	if hum and num(hum.Health, 0) <= 0 then
		return
	end
	local pos = root.Position
	local last = sample[player]
	local moved = last ~= nil and (pos - last).Magnitude > num(P.MoveStuds, 2)
	sample[player] = pos
	local a = activeOf(player)
	local remoteRecent = a.LastRemote ~= nil and clock - a.LastRemote < num(P.ActiveWindow, 180)
	local on = moved or remoteRecent
	local send = false
	if on ~= a.On then
		a.On = on
		send = true
	end
	-- a finished play-day resets on this tick even when it does not count (Q17: its tiers are never banked)
	if on or dayOver(d, now) then
		local tiers = type(P.Tiers) == "table" and P.Tiers or {}
		local readyBefore = readyCount(d, tiers)
		local reset = false
		local daySeconds = num(P.DaySeconds, 72000)
		local need = unlockNeed()
		-- the stamp the hold counts for: this session's (Z8) stamp, read BEFORE the step (lastClaimOf may write the first
		-- sight itself)
		local stamp = (on and need > 0) and lastClaimOf(player, d, now) or 0
		local counted = nil -- the play-day's seconds after any reset, before this tick's add
		local ok = DS.MutateDaily(player, function(live)
			local start = num(live.PlayStart, 0)
			if (on and start == 0) or (start > 0 and now >= start + daySeconds) then
				live.PlayStart = now
				live.PlaySec = 0
				live.PlayClaimed = {}
				reset = true
			end
			counted = num(live.PlaySec, 0)
			if on then
				live.PlaySec = math.min(num(P.MaxDaySeconds, 36000), num(live.PlaySec, 0) + num(P.TickSeconds, 10))
			end
			return true
		end)
		if ok then
			local after = dailyOf(player)
			if reset or (after and readyCount(after, tiers) > readyBefore) then
				send = true
			end
			if on and need > 0 and counted ~= nil and counted < need then
				-- the hold (5.3): a counting tick while the streak gift is due and still locked
				if stamp > 0 and now >= stamp + num(cfg().ReadySeconds, 72000) then
					local h = holds[player]
					if not h or h.Last ~= stamp then
						h = { Last = stamp, Sec = 0 }
						holds[player] = h
					end
					h.Sec = h.Sec + num(P.TickSeconds, 10)
				end
				-- the unlock crossing (before < Need <= after): CLAIM shows on time
				if after and num(after.PlaySec, 0) >= need then
					send = true
				end
			end
		end
	end
	if send then
		DailyService.Send(player)
	end
end

function DailyService.Tick()
	if not deps.DataService then
		return
	end
	local P = playCfg()
	local now = os.time()
	local clock = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, err = pcall(tickPlayer, player, P, now, clock)
		if not ok then
			warn("[DailyService] tick failed for " .. tostring(player.Name) .. ": " .. tostring(err))
		end
		-- the last payload's view went stale (the keep deadline or another missed day passed): send the fresh one
		local s = sent[player]
		if s and s.StaleAt > 0 and now >= s.StaleAt then
			local okS, errS = pcall(DailyService.Send, player)
			if not okS then
				warn("[DailyService] re-send failed for " .. tostring(player.Name) .. ": " .. tostring(errS))
			end
		end
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function onRequest(player, action, tier, extra)
	if not isLivePlayer(player) or extra ~= nil then
		return
	end
	if action == "Claim" or action == "ClaimPlayAll" then
		if tier ~= nil then
			return -- junk
		end
	elseif action == "ClaimPlay" then
		if not validTier(tier) then
			return
		end
	else
		return
	end
	if limited(player, action) then
		return
	end
	if attr(player, "InMatch") == true then
		notify(player, TEXT.InMatch, "bad")
		return
	end
	local ok, success, info
	if action == "Claim" then
		ok, success, info = pcall(DailyService.Claim, player)
	elseif action == "ClaimPlayAll" then
		ok, success, info = pcall(DailyService.ClaimPlayAll, player)
	else
		ok, success, info = pcall(DailyService.ClaimPlay, player, tier)
	end
	if not ok then
		warn("[DailyService] " .. action .. " errored: " .. tostring(success))
		notify(player, "Something went wrong, try again", "bad")
		return
	end
	if success == false and type(info) == "string" and isLivePlayer(player) then
		notify(player, info, "info")
	end
end

function DailyService.Init(given)
	if type(given) == "table" then
		for k, v in pairs(given) do
			deps[k] = v
		end
	end
	if started then
		return
	end
	started = true
	local DS = deps.DataService
	if DS then
		if DS.ProfileLoaded then
			DS.ProfileLoaded:Connect(function(player)
				DailyService.Send(player)
			end)
		end
		if DS.ProfileRebased then
			DS.ProfileRebased:Connect(function(player)
				DailyService.Send(player)
			end)
		end
	else
		warn("[DailyService] Init without DataService: nothing can be claimed")
	end
	-- a VIP answer after the payload was built (a pass still Checking at the join): re-send when Vip changed
	local SS = deps.StoreService
	if type(SS) == "table" and type(SS.Changed) == "table" and type(SS.Changed.Connect) == "function" then
		SS.Changed:Connect(function(player)
			local s = sent[player]
			if s and isLivePlayer(player) and ownsVip(player) ~= s.Vip then
				local okS, errS = pcall(DailyService.Send, player)
				if not okS then
					warn("[DailyService] VIP re-send failed: " .. tostring(errS))
				end
			end
		end)
	end
	local okRemote, remote = pcall(Remotes.Get, "DailyRequest")
	if okRemote and remote then
		remote.OnServerEvent:Connect(onRequest)
	else
		warn("[DailyService] DailyRequest remote is unavailable: " .. tostring(remote))
	end
	for _, name in ipairs(type(playCfg().ActiveRemotes) == "table" and playCfg().ActiveRemotes or {}) do
		local okA, r = pcall(Remotes.Get, name)
		if okA and r then
			r.OnServerEvent:Connect(function(player)
				if isLivePlayer(player) then
					activeOf(player).LastRemote = os.clock()
				end
			end)
		else
			warn("[DailyService] activity remote " .. tostring(name) .. " is unavailable")
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		active[player] = nil
		sample[player] = nil
		lastRequest[player] = nil
		stepBacks[player] = nil
		clamps[player] = nil
		sent[player] = nil
		holds[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(num(playCfg().TickSeconds, 10))
			tickAt = os.clock()
			local ok, err = pcall(DailyService.Tick)
			if not ok then
				warn("[DailyService] Tick errored: " .. tostring(err))
			end
		end
	end)
end

function DailyService._deps()
	return deps
end

function DailyService._tickAt()
	return tickAt
end

function DailyService._holds(player)
	return holds[player]
end

return DailyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1088">
          <Properties>
            <string name="Name">DamageService</string>
            <string name="Source"><![CDATA[-- DamageService: the single source of truth for player health during a match.
--
-- * Damage only exists inside a match (attr InMatch). The lobby is safe.
-- * Humanoid.Health never reaches 0: a lethal hit puts the player in the DOWNED state instead
--   (health pinned at Config.Damage.DownedHealth, frozen, semi-transparent, with a floating
--   marker so teammates can find them). Teammates (via MatchService) call Revive.
-- * Two kinds of protection: the short "hit" i-frame window started by every normal hit, and
--   "granted" invulnerability (spawn, revive, finished pad). IgnoreIFrames bypasses only the hit
--   window (damage-over-time such as storms), never granted invulnerability.
-- * Extra (not in the ARCHITECTURE contract, used by PlayerService): ClearDowned(player).
-- * v2: damage kinds come straight from Config.Damage.Kinds (Void, Lightning, SpinBar, Storm,
--   Pendulum, Other); anything unknown is reported as "Other". Max health is owned by
--   PlayerService (pet perks raise it), so this module never writes Humanoid.MaxHealth: heals,
--   revives and health fractions are all relative to whatever the humanoid currently has.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local FxSprites = require(Shared.FxSprites) -- the game's own particle sprites (kit B X1)
local WorldTag = require(Shared.WorldTag) -- (kit-b world signs, lane C) the DOWNED marker's stone card

local DamageService = {}

-- Signal: Fire(player, sourceKind) when a player drops into the downed state.
DamageService.PlayerDowned = Util.Signal()

local DOWNED_TRANSPARENCY = 0.55
local REVIVE_IFRAMES = 2 -- seconds of protection after a revive
local MAX_KNOCKBACK = 90 -- studs/second, hard cap for any caller

-- states[player] = {
--   HitUntil = os.clock() time the post-hit window ends,
--   GrantUntil = os.clock() time granted invulnerability ends,
--   Downed = bool,
--   Originals = { [BasePart|Decal] = original Transparency },
--   Marker = BillboardGui|nil, MarkerTween = Tween|nil,
--   HealthConn = RBXScriptConnection|nil,   -- keeps downed health pinned
--   Conns = { connections to disconnect on leave },
-- }
local states = {}
local initialized = false
local damageRemote = nil

local kindSet = { Other = true }
for _, kind in ipairs(Config.Damage.Kinds or {}) do
	kindSet[kind] = true
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function getDamageRemote()
	if not damageRemote then
		local ok, remote = pcall(Remotes.Get, "DamageTaken")
		if ok then
			damageRemote = remote
		end
	end
	return damageRemote
end

local function isInMatch(player)
	return player:GetAttribute(Config.Attr.InMatch) == true
end

local function isValidNumber(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Restores the base movement stats on a humanoid (after revive / leaving the downed state).
local function restoreMovement(humanoid)
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = Config.Physics.WalkSpeed
	humanoid.JumpPower = Config.Physics.JumpPower
end

----------------------------------------------------------------------
-- Downed visuals: transparency + a pulsing marker above the head
----------------------------------------------------------------------

local function destroyMarker(s)
	if s.MarkerTween then
		s.MarkerTween:Cancel()
		s.MarkerTween = nil
	end
	if s.Marker then
		s.Marker:Destroy()
		s.Marker = nil
	end
end

-- Downed marker (World text rule): a PIXEL-sized tag over the head. AlwaysOnTop and a long MaxDistance on purpose:
-- teammates must spot a downed friend across the course. Static: per-frame visual animation belongs to the client
-- (replication rule), so the server no longer tweens the text.
-- (kit-b world signs, lane C: the rounded navy plate with the rounded red pill went) the NPC nameplate's stone card: a
-- 3 px mitred wood edge, a red lip, "DOWNED" in a small square red block (WorldTag.Tint: a light red face, the red lip,
-- the kit's brown ink) over the hint line in the muted ink. Both lines are measured, so the card hugs them.
local MARKER_TITLE_PX = 28
local MARKER_HINT_PX = 19
local MARKER = { PadX = 14, PadTop = 6, Gap = 3, PadBottom = 6, PillEdge = 2, PillLip = 3, PillPadX = 14, PillPadY = 2 }

local function createMarker(s, char)
	local anchor = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
	if not anchor then
		return
	end
	local Sign, Z, M = Theme.Sign, WorldTag.Sizes, MARKER
	local red = Sign.Red

	local gui = Instance.new("BillboardGui")
	gui.Name = "NimbusDownedMarker"
	gui.Size = UDim2.fromOffset(320, 100)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the bottom edge sits 2.2 studs over the head's centre
	gui.StudsOffset = Vector3.new(0, 2.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 250
	gui.LightInfluence = 0
	gui.ClipsDescendants = false

	local title, hint = "DOWNED", "reach the next checkpoint!"
	local titleW = math.ceil(Theme.Measure(title, "Accent", MARKER_TITLE_PX).X) + 2 * (M.PillPadX + M.PillEdge)
	local hintW = math.ceil(Theme.Measure(hint, "Body", MARKER_HINT_PX).X)
	local faceW = math.max(titleW, hintW) + 2 * M.PadX
	local pillH = MARKER_TITLE_PX + 2 * M.PillPadY + 4 + M.PillLip -- the pill's face, its lip included

	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.AnchorPoint = Vector2.new(0.5, 1)
	plate.Position = UDim2.new(0.5, 0, 1, -Z.Edge)
	plate.ZIndex = 2
	WorldTag.Block(plate, Sign.Stone, Sign.RedLip, Sign.Wood, Z.Edge, Z.Lip)
	plate.Parent = gui

	local y = M.PadTop
	local pill = Instance.new("Frame")
	pill.Name = "TitlePill"
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.new(0.5, 0, 0, y + M.PillEdge)
	pill.Size = UDim2.fromOffset(titleW - 2 * M.PillEdge, pillH)
	pill.LayoutOrder = 1
	pill.ZIndex = 3
	WorldTag.Block(pill, red, red, Sign.Wood, M.PillEdge, M.PillLip)
	pill.Parent = plate
	WorldTag.Text(pill, "Title", title, "Accent", MARKER_TITLE_PX, Sign.Text, {
		Size = UDim2.new(1, 0, 1, -M.PillLip), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, ZIndex = 4,
	})
	WorldTag.Tint(pill, red)
	y = y + pillH + 2 * M.PillEdge + M.Gap

	WorldTag.Text(plate, "Hint", hint, "Body", MARKER_HINT_PX, Sign.TextMuted, {
		Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, MARKER_HINT_PX + 4), TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 2, ZIndex = 3,
	})
	y = y + MARKER_HINT_PX + 4
	plate.Size = UDim2.fromOffset(faceW, y + M.PadBottom + Z.Lip)

	gui.Parent = anchor
	s.Marker = gui
	s.MarkerTween = nil
end

local function applyDownedLook(s, char)
	s.Originals = {}
	for _, inst in ipairs(char:GetDescendants()) do
		-- The root part is already fully transparent; leave it (and any invisible part) alone.
		if (inst:IsA("BasePart") and inst.Name ~= "HumanoidRootPart") or inst:IsA("Decal") then
			s.Originals[inst] = inst.Transparency
			if inst.Transparency < DOWNED_TRANSPARENCY then
				inst.Transparency = DOWNED_TRANSPARENCY
			end
		end
	end
	createMarker(s, char)
end

local function restoreLook(s)
	for inst, original in pairs(s.Originals) do
		if inst.Parent then
			inst.Transparency = original
		end
	end
	s.Originals = {}
	destroyMarker(s)
end

-- A small green sparkle burst at the revived player's feet.
local function reviveBurst(player)
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Name = "NimbusReviveFx"
	attachment.Parent = root

	local emitter = Instance.new("ParticleEmitter")
	FxSprites.Apply(emitter, "Sparkle")
	emitter.Color = ColorSequence.new(Theme.Colors.Good, Theme.Colors.White)
	emitter.LightEmission = 1
	emitter.Lifetime = NumberRange.new(0.8, 1.3)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(360, 360)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.1),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rate = 0
	emitter.Parent = attachment
	emitter:Emit(28)
	Debris:AddItem(attachment, 2.5)
end

----------------------------------------------------------------------
-- Downed state transitions
----------------------------------------------------------------------

local function enterDowned(player, s, char, humanoid, kind)
	s.Downed = true
	humanoid.UseJumpPower = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.Health = Config.Damage.DownedHealth
	player:SetAttribute(Config.Attr.Downed, true)
	applyDownedLook(s, char)

	-- Keep health pinned: the default regen script (or anything else) must not heal a downed
	-- player and must never push them to 0.
	if s.HealthConn then
		s.HealthConn:Disconnect()
	end
	s.HealthConn = humanoid.HealthChanged:Connect(function(health)
		if s.Downed and health > Config.Damage.DownedHealth and humanoid.Parent then
			humanoid.Health = Config.Damage.DownedHealth
		end
	end)

	DamageService.PlayerDowned:Fire(player, kind)
end

-- Leaves the downed state bookkeeping (visuals + attribute). Does not touch health or speed.
local function leaveDownedState(player, s)
	if not s.Downed then
		return false
	end
	s.Downed = false -- before touching anything else: the HealthChanged guard checks this
	if s.HealthConn then
		s.HealthConn:Disconnect()
		s.HealthConn = nil
	end
	restoreLook(s)
	if player.Parent then
		player:SetAttribute(Config.Attr.Downed, false)
	end
	return true
end

-- The character is going away (death, reset, respawn): drop everything tied to it.
local function resetCharacterState(player, s)
	s.HitUntil = 0
	s.GrantUntil = 0
	leaveDownedState(player, s)
end

----------------------------------------------------------------------
-- Per-player tracking
----------------------------------------------------------------------

local function newState()
	return {
		HitUntil = 0,
		GrantUntil = 0,
		Downed = false,
		Originals = {},
		Marker = nil,
		MarkerTween = nil,
		HealthConn = nil,
		Conns = {},
	}
end

local function track(player)
	local existing = states[player]
	if existing then
		return existing
	end
	if not player or not player.Parent then
		return nil
	end

	local s = newState()
	states[player] = s

	-- CharacterRemoving fires before the next CharacterAdded, so clearing here can never wipe the
	-- spawn i-frames PlayerService grants to the fresh character.
	table.insert(
		s.Conns,
		player.CharacterRemoving:Connect(function()
			resetCharacterState(player, s)
		end)
	)

	-- Leaving the match (SendToLobby, abandon) must never leave a player stuck downed.
	table.insert(
		s.Conns,
		player:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if not isInMatch(player) then
				DamageService.ClearDowned(player)
			end
		end)
	)

	-- If something outside this module flips the Downed attribute off, follow along.
	table.insert(
		s.Conns,
		player:GetAttributeChangedSignal(Config.Attr.Downed):Connect(function()
			if s.Downed and player:GetAttribute(Config.Attr.Downed) ~= true then
				DamageService.ClearDowned(player)
			end
		end)
	)

	return s
end

local function untrack(player)
	local s = states[player]
	if not s then
		return
	end
	states[player] = nil
	for _, conn in ipairs(s.Conns) do
		conn:Disconnect()
	end
	s.Conns = {}
	s.Downed = false
	if s.HealthConn then
		s.HealthConn:Disconnect()
		s.HealthConn = nil
	end
	destroyMarker(s)
	s.Originals = {}
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function DamageService.Init()
	if initialized then
		return
	end
	initialized = true
	getDamageRemote() -- resolve early (Remotes.Init has already run in Main)
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(untrack)
	for _, player in ipairs(Players:GetPlayers()) do
		track(player)
	end
end

-- Pushes the player away from the given point (horizontal) with a small pop upwards.
local function applyKnockback(root, from, strength)
	strength = Util.Clamp(strength, 0, MAX_KNOCKBACK)
	local away = root.Position - from
	local dir = Vector3.new(away.X, 0, away.Z)
	if dir.Magnitude < 0.05 then
		local look = root.CFrame.LookVector
		dir = Vector3.new(-look.X, 0, -look.Z)
	end
	if dir.Magnitude < 0.05 then
		dir = Vector3.new(0, 0, 1)
	end
	dir = dir.Unit
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity =
		Vector3.new(dir.X * strength, math.max(velocity.Y, strength * 0.45), dir.Z * strength)
end

-- Returns true if damage was applied.
-- opts: { IgnoreIFrames = bool, KnockbackFrom = Vector3?, Knockback = number? }
function DamageService.Damage(player, amount, sourceKind, opts)
	if not player or not player.Parent or not isValidNumber(amount) or amount <= 0 then
		return false
	end
	local s = states[player] or track(player)
	if not s then
		return false
	end
	opts = opts or {}

	if not isInMatch(player) then
		return false -- the lobby is safe
	end
	if s.Downed then
		return false -- downed players ignore further damage
	end

	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end

	local now = os.clock()
	if now < s.GrantUntil then
		return false
	end
	if not opts.IgnoreIFrames and now < s.HitUntil then
		return false
	end

	local kind = "Other"
	if kindSet[sourceKind] then
		kind = sourceKind
	end

	local downedHealth = Config.Damage.DownedHealth
	local after = humanoid.Health - amount
	local goesDown = after <= downedHealth
	if goesDown then
		after = downedHealth -- health must never reach 0
	end
	humanoid.Health = after

	if not opts.IgnoreIFrames then
		s.HitUntil = now + Config.Damage.IFrames
	end

	local remote = getDamageRemote()
	if remote then
		pcall(function()
			remote:FireClient(player, Util.Round(amount, 1), kind)
		end)
	end

	if goesDown then
		enterDowned(player, s, char, humanoid, kind)
	elseif root and typeof(opts.KnockbackFrom) == "Vector3" then
		local strength = 40
		if isValidNumber(opts.Knockback) then
			strength = opts.Knockback
		end
		applyKnockback(root, opts.KnockbackFrom, strength)
	end

	return true
end

-- Returns the amount actually healed. Downed players are not healed (use Revive).
function DamageService.Heal(player, amount)
	if not player or not isValidNumber(amount) or amount <= 0 then
		return 0
	end
	local s = states[player]
	if s and s.Downed then
		return 0
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return 0
	end
	local before = humanoid.Health
	local after = math.min(humanoid.MaxHealth, before + amount)
	if after <= before then
		return 0
	end
	humanoid.Health = after
	return after - before
end

function DamageService.HealFraction(player, fraction)
	if not isValidNumber(fraction) then
		return 0
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then
		return 0
	end
	return DamageService.Heal(player, humanoid.MaxHealth * fraction)
end

-- Sets health to a fraction of max (never below DownedHealth; ignored while downed).
function DamageService.SetHealthFraction(player, fraction)
	if not player or not isValidNumber(fraction) then
		return
	end
	local s = states[player]
	if s and s.Downed then
		return
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local target = humanoid.MaxHealth * Util.Clamp(fraction, 0, 1)
	humanoid.Health = Util.Clamp(target, Config.Damage.DownedHealth, humanoid.MaxHealth)
end

function DamageService.GrantInvulnerability(player, seconds)
	if not player or not isValidNumber(seconds) or seconds <= 0 then
		return
	end
	local s = states[player] or track(player)
	if not s then
		return
	end
	local untilTime = os.clock() + seconds
	if untilTime > s.GrantUntil then
		s.GrantUntil = untilTime
	end
end

function DamageService.IsInvulnerable(player)
	local s = states[player]
	if not s then
		return false
	end
	local now = os.clock()
	return now < s.GrantUntil or now < s.HitUntil
end

function DamageService.IsDowned(player)
	local s = states[player]
	return s ~= nil and s.Downed == true
end

-- Downed -> back on their feet with ReviveHealthFraction health and 2s of protection.
function DamageService.Revive(player)
	local s = player and states[player]
	if not s or not s.Downed then
		return
	end
	leaveDownedState(player, s)

	local humanoid = Util.GetHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		restoreMovement(humanoid)
		-- MaxHealth stays as PlayerService set it (it includes pet perks).
		humanoid.Health = humanoid.MaxHealth * Config.Damage.ReviveHealthFraction
	end
	DamageService.GrantInvulnerability(player, REVIVE_IFRAMES)
	reviveBurst(player)
end

-- Extra: silently leaves the downed state (no health change, no i-frames, no effects).
-- PlayerService.SendToLobby uses it; it is also triggered when InMatch turns false.
function DamageService.ClearDowned(player)
	local s = player and states[player]
	if not s or not s.Downed then
		return
	end
	leaveDownedState(player, s)
	local humanoid = Util.GetHumanoid(player)
	if humanoid and humanoid.Health > 0 then
		restoreMovement(humanoid)
	end
end

return DamageService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1089">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: persistent player profile (tokens, pets, items, stats, the v3 Pet Index / tutorial, the Phase 2
-- tycoon: Cash, Gems, Home, Food, pet levels, tier copies and fused hybrids, the Phase 3 battle teams and battle
-- record, and the Phase 4 pet growth (evolution stages, training), the Champion Ring record and the migration
-- markers) for Nimbus Climb.
--
-- Profile shape (ARCHITECTURE_V2.md section 1, ARCHITECTURE_V3.md section 1 + section 11 + "Phase 2 build contract" +
-- "Phase 3 build contract" + "Phase 4 build contract" section 4):
--   { Version = 2, Tokens, Pets = {[petId]=count}, Equipped = {key...}, Items = {[itemId]=count} (HUD cleanup: the
--     obby items are gone; the field stays in the store and the merge, emptied by the one-time B3ItemsRefund),
--     Stats = { Matches, Wins, TokensEarned, Spins, BestTimes = {[difficultyId]=seconds} }, SpotIndex,
--     -- v3
--     Discovered = {[petId]=true}, IndexClaimed = {[groupId]=true}, Tutorial = { Step, Done, Gifted },
--     -- Phase 2
--     Cash, Gems,
--     Home = { Level, Prestige, Stations = {[stationId]=level}, Garden = {[slot]=key}, Gym = {[slot]=key},
--              CollectorCash, LastSeen,
--              LegacySlots = n | nil, LegacyPrices = true | nil },     -- Phase 4 (veterans, see below)
--     Food = {[foodId]=count}, PetLevels = {[key]={Level, Xp}}, Tiers = {[petId]={Golden=n, Rainbow=n}},
--     Hybrids = {[uid]={Body, Style, Elements, Name, Rarity, Tier, Seed?, SpecialFrom?}}, GemReceipts = {[purchaseId]=os.time()},
--              (gui-redo: Elements in order, [1] = the normal attack's parent; SpecialFrom = "Style" | absent = the Body
--              gives the special; anything else is dropped by cleanHybrid. No migration: old records read as today)
--     -- Phase 3
--     Teams = { Presets = { [1..3] = {key, key, key, key?} }, Active = 1..3 },
--     Battle = { Trophies, TrialBest, TrialCleared = {[level]=true}, Raids, RaidBestDamage, PvPWins, PvPLosses,
--                EventPets = {[petId]=true}, RaidRewardAt, RaidLossAt,     -- the raid reward clocks: Unix seconds of the last
--                                                                          -- paid win / loss (0 = never; boss raids 2026-11-01)
--                Duels = { { U = opponent UserId, T = Unix seconds }... } }  -- lobby-shop 16.12: the counted duels this
--                player fought (a start with trophies at stake), newest first, every entry of the last 30 min + at most 32 older, 64 in all (the cross-server pair limit); stored only when not empty, never in
--                the snapshot; merges as a union (a server of an older build still running drops it: the limit then
--                counts only the newer server's duels for a while)
--     -- Phase 4 (new TOP-LEVEL fields only: a Phase 3 server still running during the rollout rebuilds Battle,
--     -- Teams, PetLevels entries and slot values from the keys it knows and would erase anything new inside them;
--     -- keepForeign writes unknown top-level and Home keys back untouched)
--     PetGrowth = { [key] = { Evo = 0..2, Speed, Physique, Ability, Defense = 0..10,
--                            Job = { Stat, Ends, Rank, Slot, From, Paid } | nil } },
--     Ring = { Best = 0..100000, Runs },
--     Migrations = { P4 = true, P5Dungeon = true, P5Home = true, P5MouseLock = true, B2GardenSolo = true,
--                    B3ItemsRefund = true },
--     -- Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" section 9; new TOP-LEVEL fields + new Home keys again, so
--     -- a Phase 4 server still running during the rollout writes them back untouched through keepForeign)
--     Dungeon = { Best = 0..100, Cleared = {[floor]=true} (a dense boolean array in the store), Runs, Clears },
--     Berries = whole number >= 0 (left out while 0),
--     Settings = { Music 0..10, Sfx 0..10, Gfx "Auto"|"Low"|"High", Shake bool, SeenNotes 0..1000, MouseLock bool,
--       FastHatch bool }  (left out while default; FastHatch, lobby shop, is written only when true, so a stored
--       Settings table of an older build never gains FastHatch = false),
--     Home.DecorCredit = 1..18 | nil, Home.LegacyMagnet = 1..5 | nil, Home.LegacyMagnetStar = the Prestige it was folded at,
--     -- Store build (spec docs/superpowers/specs/2026-11-04-shop-retention-design.md section 6; new TOP-LEVEL fields
--     -- again, foreign to every older server; helper table P7)
--     Store = { Bought = {[key]=unix}, Passes = {[key]=unix}, Boosts = {[id]=endsUnix} }   -- the Once packs bought, the
--       passes seen owned, the potion ends (left out while empty; kept by the dev reset: Robux)
--     Daily = { Streak, Paid, LastClaimAt, Weeks, Pet (bool), PlayStart, PlaySec, PlayClaimed = {[tier]=true},
--       ClampFrom, ClampAt, ClampJob }   -- the streak gifts and the play-time gifts (clocks in Unix seconds, 0 = never;
--       PlayClaimed a DENSE boolean array in the store like TrialCleared; ClampFrom / ClampAt / ClampJob =
--       DailyService's Z8 first sight of a wrong-clock LastClaimAt (the stamp it was seen against, the now of that first
--       sight, the game.JobId of the server whose clock read it: re-review 3), left out of the store while 0; the Daily
--       left out while all zero; wiped by the dev reset)
--     Trove = {[askId]=true}   -- the Sky Trove asks paid (left out while empty; wiped by the dev reset); lobby-shop 16.13:
--       also the one-time ask "TutorialStarter" (TutorialService: the restricted account's starter pet, grant { Pets })
--     -- Lobby shop (spec docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.2 / 6; a new TOP-LEVEL field, foreign to
--     -- every older server; helpers in P7)
--     Pity = { Secret = { Spins, Hit } }   -- the Secret Roulette pity: Spins = its spins ever, Hit = the Spins value
--       right after its last Secret (Since = Spins - Hit); whole numbers 0..1e9 (anything else 0), Hit <= Spins (else
--       Hit = Spins); left out of the store while 0 / 0 (old records have none: no migration, no retroactive count);
--       never in the ProfileSync snapshot (the attribute and the RouletteResult reply carry it) }
--   Lobby shop rules: Pity.Secret.Spins merges as a +/- delta (like Ring.Runs), Hit as the higher value (like Ring.Best),
--   then Hit <= Spins; ResetFields (the dev reset) writes the session's record over the stored one.
--   Store build rules (P7): Bought / Passes merge as a union (the earlier time wins), a potion end per id as the later
--   end MINUS the seconds of this session's receipt grants the store already holds (the twin rule, before the max);
--   Daily: the pair (LastClaimAt, Streak) travels together and the higher LastClaimAt wins it, EXCEPT that a session
--   claim less than Config.Daily.ReadySeconds after the STORED LastClaimAt was paid elsewhere (its grant comes off the
--   deltas, the stored pair stays); Paid / Weeks max, Pet sticks once true; the higher PlayStart wins the whole Play
--   group (PlayStart, PlaySec, PlayClaimed), at the same PlayStart the session's seconds add up (0..MaxDaySeconds) and
--   its tiers join the stored ones, and a Play grant whose (PlayStart, tier) the store holds comes off the deltas; a
--   stand-in delta never carries a Play group; a stored LastClaimAt further in the future than FutureClockSlack (a
--   wrong clock) loses the pair to a session that moved its pair (a claim: DailyService's Z8 clamp never moves the
--   stored claim, so a server whose clock runs behind cannot pull it earlier), but the twin rule still holds against it.
--   Every Day grant records Prev, the LastClaimAt its claim built on (re-review 2): while the record still holds that
--   stamp (or holds this session's own earlier claim the grant follows) the grant is this session's next claim, never a
--   twin, even less than ReadySeconds after the stamp (a claim after a Z8 clamp); against any other stored stamp the
--   ReadySeconds rule decides, so a clamp claim whose stamp another server has since replaced is still dropped as the
--   twin (P7.pendingClaims / P7.applyDaily). Only a session that moved its own pair (a claim) takes the pair (re-review
--   3: an unmoved pair is just its Base, so a late save that only ticked play time or noted a Z8 first sight never puts
--   back a stamp another server's claim replaced); a session whose Base stamp is still the stored one takes it with any
--   claim it made. The Z8 first sight (ClampFrom, ClampAt, ClampJob) belongs to its stamp: it is kept only while
--   ClampFrom is the merged LastClaimAt, and two first sights of one stamp keep the later ClampAt. Trove: a union; an
--   ask the store already holds takes the session's grant off the deltas. The grant records (cache annotations, never
--   stored):
--   ReceiptGrants = {[purchaseId] = grant} (replaces ReceiptGems; a number grant still means { Gems = n }),
--   DailyClaims = { grant... } (each { Kind = "Day" | "Play", Tier, At, Prev, PlayStart, ...amounts }), TroveGrants =
--   {[askId] = grant}; a grant = { Cash, Tokens, Gems, Berries, Pets = {[id]=n}, Boost = {[id]=seconds}, Star } (Star =
--   the session's Home.Prestige when it was paid). applyDelta sums every grant the store already holds into `drop` and
--   takes it off the Tokens / Pets / Cash / Gems / Berries deltas and the potion ends where each kind is applied; the
--   Cash of a grant comes off only while the session's balance still holds it (a plain delta; when both sides
--   prestiged to the stored star, only a grant paid at that star: a prestige reset the earlier ones), and a pet whose
--   grant the store holds keeps the higher PetLevels entry of the two (a pack's level write never lowers it). Every
--   claim and its grant are written in ONE non-yielding step and ride one UpdateAsync; the orphan retry carries them
--   (Z11 / Z14).
--   Phase 5 rules: Teams hold 3 keys per preset (slot 1 = the fighter; a stored 4th key leaves the preset only, the pet
--   stays owned); Dungeon merges Best max / Cleared union / Runs delta / Clears delta (the P5Dungeon migration's own
--   Clears as a max, so two servers migrating one save do not double it); Berries merge as a +/- delta clamped at 0,
--   MINUS the session's own P5Home conversion when the store was already marked P5Home (its twin: two servers
--   converting one save's Food do not double the berries); the live session's Settings win; Food was converted into
--   berries ONCE by the P5Home step and is never written again.
--   Battle teams: a preset lists up to 3 UNIQUE keys in slot order (Phase 5: 3 always, slot 1 = the fighter; the
--   Phase 3 prestige unlock of a 4th slot is gone); every key needs a FREE copy: owned (PetKeys.Count) more often than it
--   works in the Garden or the Gym (bug batch 2 #18, "Remote recall": a Garden pet is BUSY gardening, it can neither
--   follow you (Equipped) nor fight; this replaces the Phase 4 rule "a Garden pet keeps earning at home while it follows
--   you and fights"; Phase 4 empties the Gym on its one-time migration). Only OPEN garden places lock (follow-up): a
--   copy on a place ABOVE the open count (TycoonCatalog.GardenSlots; a Prestige closed it, the pet sleeps there under
--   its "Prestige to open" sign and earns nothing) is not busy (P3.placedCopies skips it, P3.closedSlot); once it
--   follows or joins a preset it leaves that place silently (live: TycoonService after PetService.PerksChanged /
--   TeamsChanged, through ClosedBedOverlap; on load: P3.gardenSolo, closed places first, no toast; in the merge nothing
--   to do: the record keeps the pet with the player and the next load empties the bed). A key no longer owned at all
--   (fused away, released, a developer reset) is dropped from every preset ("pruned", the pets behind it move up a slot):
--   in every copy taken for a save or a snapshot, in the merge, and in the live profile on every Sync and after a
--   MutateHome that moved pets (TeamsChanged fires then).
--   ONE TEAM (team balance, spec 2026-10-31 s.1): a player's battle team IS the pets following them. The invariant, after
--   every write: Equipped == the active preset's keys minus busy keys (training, or every copy in the Garden / Gym), in
--   order (P3.syncEquipped: normalizeProfile, applyDelta, pruneLive, SetTeam, SelectTeam, MutateGrowth, MutateHome's prune,
--   SyncEquipped). Nothing else writes Equipped on a migrated profile. A busy pet KEEPS its slot (P3.prune keeps a key whose
--   copies all work, P3.busyOf marks it) and is back by itself when the job ends. The team is locked during an obby match
--   (P3.matchLocked: SetTeam / CheckTeam on the active preset, SelectTeam): the perks must not change between checkpoints.
--   B4TeamFollow (once per save, P3.teamMigrate, on a loaded, real profile: a provisional one waits for its recovery): until
--   the marker is set Equipped is the save's own list (normalizeEquipped), the migration's input: with Equipped empty ->
--   the active preset; else a preset holding the same keys (not counting its busy ones; the active one first) becomes
--   active; else the first empty preset takes the list and becomes active; else the highest-numbered non-active preset
--   does. { Preset = n, Case = "Empty" | "Same" | "Free" | "Replaced" } in MigratedNow; no toast. No pet is ever touched.
--   Bug batch 2 #18 old saves: a stored profile without B4TeamFollow whose pet is BOTH in the Garden and equipped / in a
--   preset (the Phase 4 rule allowed it) is repaired when it is read (P3.gardenSolo in normalizeProfile, before the presets
--   are pruned): the pet STAYS equipped / in its team and LEAVES the Garden (no player loses a fighter, no team is
--   emptied; a migrated save may hold that overlap: the pet is busy and keeps its slot, only closed places are freed). The repair
--   is deterministic and only acts on such an overlap, so it never loops; the load that moved pets records them
--   (MigratedNow(player, "B2GardenSolo") = { Keys }) and fires Migrated(player, "B2GardenSolo", info) once (TycoonService
--   shows the one explaining toast); the marker Migrations.B2GardenSolo is set on the first loaded, real profile.
--   THE MARKER IS A RECORD, NOT A GATE: the repair runs on EVERY normalizeProfile read (it is idempotent and a no-op
--   without an overlap). So an overlap written later (an old Phase 4 server during the rollout) is repaired again on
--   the next load, with the event and the toast again. Two outcomes, both deterministic and neither looping:
--     * on LOAD (normalizeProfile -> P3.gardenSolo, before the prune): the PLAYER wins: the pet stays equipped / in
--       its team and leaves the Garden;
--     * in the MERGE (applyDelta -> P3.prune, P3.syncEquipped): the GARDEN wins: the placement the other server wrote
--       stands and the pet leaves Equipped; its preset keeps it as a busy slot (p5flow_merge pins it).
--   A Phase 2 profile (no Teams / Battle,
--   or the empty Teams reserve) gets the defaults: 3 empty presets, preset 1 active, a zeroed battle record.
--   Phase 4 pet growth, per KEY like levels: Evo is the evolution stage the player unlocked by pressing EVOLVE
--   (0..2; the boost counts only from the stored stage, never from the level alone); Speed / Physique / Ability /
--   Defense are the training ranks (0..10); Job is the running training job: Stat (one of the four), Ends (os.time()
--   when it completes), Rank (the TARGET rank = the stat's rank + 1, so two servers completing the same job give rank
--   3, not 4; a Job whose Rank is not above the stored rank was completed elsewhere and is dropped by P4.cleanGrowth),
--   Slot (the Training Place mat 1..5), From ("Follow" | "Garden:<slot>" | "Free": where the pet goes back to), Paid
--   (the Cash to refund on Stop). An all-zero entry without a Job is not kept.
--   THE TRAINING LOCK is a READ-TIME filter, one source of truth: TrainingKeys(player) = every key with a Job.
--   P3.syncEquipped drops such keys from Equipped, FieldableKeys and ActiveTeamKeys skip them; P3.checkTeam refuses a
--   DIRECT pick of one and P3.prune never drops one from a preset. Garden pets ARE busy the same way (bug batch 2 #18:
--   P3.placedCopies counts the OPEN places of Home.Garden and Home.Gym; a closed place does not lock, see the team rule
--   above).
--   Ring: Best = the highest Champion Ring round won (0 = never), Runs = finished runs.
--   Migrations: one-time data migrations this profile went through (P4 = the Phase 4 migration, section 4.3).
--   HUD cleanup (2026-10-30): B3ItemsRefund = the obby items were removed and the save's old Items were refunded ONCE
--   as Tokens (30 / 45 / 150 per heal_cloud / shield_bubble / phoenix_feather, at most 5 of each, unknown ids pay 0),
--   then Items emptied (P6.itemsRefund, on a loaded, real profile only: a provisional one is refunded after its
--   recovery). The twin rule: when the STORE already holds the marker as this session saves (another server refunded
--   the same save), the session's own refund is left out of the Tokens delta, so a save is never paid twice.
--   Home.LegacySlots (a veteran's old garden size when it was above 3 + Prestige) and Home.LegacyPrices (true for a
--   veteran who had prestiged on Phase 3: base prices until the next prestige) are written ONLY by the Phase 4
--   migration and cleared by the next prestige (MutateHome clears both whenever the Home's Prestige rises).
--   Pet copies are identified by keys (shared/PetKeys.lua): "petId" (Normal), "petId@Golden", "petId@Rainbow",
--   "hyb:<uid>"; Equipped, PetLevels, Garden and Gym hold keys. Every plain petId of an old profile is a valid key.
--   Garden / Gym slots are whole numbers 1..64 (other valid string slot names are kept as they are).
--   Home.Rooms (the v3 reserve) was migrated into Home.Stations: in the live profile Home.Rooms is the SAME table as
--   Home.Stations (old code that touches Rooms still works); it is never written to the store again.
--   Every field is additive: a stored v2 / v3 profile lacks the newer fields and gets the defaults on load, and every
--   owned pet (Normal or tier copy) always counts as discovered. Version stays 2: no stored v2 field changed its
--   layout, so older tooling keeps reading it (older servers keep the new fields as foreign data, see below).
--
-- Design notes
--   * Everything runs from an in-memory cache, so the game is fully playable when DataStores are
--     unavailable (Studio without "Enable Studio Access to API Services", Roblox outages, ...).
--   * Saves are DELTA based. The cache remembers `Base` (what the store is known to contain);
--     a save sends only "live minus base" and merges it into whatever is stored right now inside
--     UpdateAsync. A failed load can therefore never wipe a saved profile and two servers touching
--     the same player cannot clobber each other. After a failed load, the next save (or a
--     background retry) re-reads the store and merges the session on top of it.
--     Merge rules: Discovered / IndexClaimed only ever grow (set union); Tutorial merges monotonically (Done and
--     Gifted stick once true) so a second server can never replay the tutorial gift; Tokens / Cash / Gems / Food
--     counts / Home.CollectorCash travel as +/- deltas; Home.Stations / Garden / Gym, Tiers, Hybrids and PetLevels
--     are replaced PER KEY when the session changed that key; GemReceipts only grow (bounded to the newest 100);
--     Teams merge PER PRESET (a preset the session changed replaces the stored one, Active is replaced when the
--     session changed it; afterwards the presets are pruned against the merged copies); Battle: Trophies / Raids /
--     PvPWins / PvPLosses travel as +/- deltas (never below 0), TrialBest / RaidBestDamage / RaidRewardAt / RaidLossAt keep the
--     higher value (the reward clocks: the latest paid raid, so the limit survives a server hop), Duels merges as a union
--     of { U, T } entries (the last 30 min + the newest 32 older kept, 64 at most; lobby-shop 16.12 / 16.13 review),
--     TrialCleared / EventPets only grow (union). Home: a HIGHER Home.Prestige wins the whole Home (prestige resets the stations, so
--     the other side's per-station changes are void); at equal prestige the Home merges per key (Level replaced,
--     LastSeen the later one). When both sides prestiged to that star (two runs from the same reset home), each
--     station keeps the higher level, the Home Level grows by what that adds and the session's Collector counts
--     from 0 (its prestige emptied it).
--     Cash follows the same prestige rule, because a prestige resets Cash too: a session that prestiged past the
--     store writes its balance (the Cash of the newest run), a session whose run the store prestiged past loses its
--     Cash delta (that run was reset), and when both sides prestiged to the same star the session's Cash since its
--     prestige joins the store's. A star reward (Gems) both sides paid counts once. Gem purchases: the receipt and
--     its gems merge together (MarkReceipt records the amount): a receipt the store already holds was granted by
--     another server, so its gems are not added again. Phase 4: PetGrowth merges PER KEY: Evo and every rank keep
--     the HIGHER value (never down; a rank is a target value, so two servers completing one job give one rank), the
--     Job is the session's value when the session changed it (a cleared job travels as `false` + the job it ended; a
--     job the session never touched leaves the stored one alone; a stored job that is NEWER than the one the session
--     ended or started, the same skill at a higher target, survives: two servers can race during the rollout or an
--     outage's late leave save), then P4.cleanGrowth drops a Job whose Rank is not above the merged rank (completed
--     elsewhere); a key the session removed travels as `false`. Ring.Best keeps the higher value,
--     Ring.Runs travels as a +/- delta. Migrations only grow (union). Home.LegacySlots / LegacyPrices merge with the
--     Home (per-key replace; a higher Prestige wins the whole Home, which has them cleared).
--     Store build: Store.Bought / Passes union (the earlier time), Boosts the later end per id minus the session's
--     own receipt seconds the store already holds; Daily by the pair / Play group rules of the header; Trove union;
--     the grant records of the three twin rules take a grant the store already holds off every delta (one purchase
--     id, one claim, one ask: ONE grant across retries, rejoins and two servers).
--     The ONE exception is ResetFields (developer tools only):
--     the fields it names are written over the stored ones at the next successful save instead of merged (Daily and
--     Trove are among them: their merges are unions / maxima, so the dev reset could not stick otherwise; Store is
--     not: Robux, like GemReceipts).
--   * A PROVISIONAL profile (the load failed while the DataStore is reachable, e.g. an outage) holds
--     defaults, not the player's data. One-time rewards must not be decided from it: GetTutorial
--     answers nil and SetTutorial refuses until the background recovery read the real save (then
--     ProfileRebased fires and TutorialService starts from the stored progress), and
--     IsProvisional(player) lets IndexService / DevService refuse claims and resets meanwhile. That
--     is what keeps a failed load from replaying the tutorial gift / finish reward. Per-key data would be
--     overwritten by stand-in values the same way, so GetHome answers nil, MutateHome only lets delta-safe changes
--     (CollectorCash, LastSeen) through and AddPetXp / MarkReceipt refuse while provisional; likewise GetTeams /
--     GetBattle answer nil, ActiveTeamKeys {}, SetTeam / SelectTeam refuse and MutateBattle only lets the fields
--     through that merge as deltas or best values (a first clear or an event pet is never decided from stand-in
--     data). AddTrophies keeps working (a delta). Phase 4: MutateGrowth / SetEvolution / MutateRing / SetPetLevel are
--     refused while provisional (training, evolution, their completion and ring records wait for the real save; the
--     ring does not start); GetRing / GetGrowthMap-based decisions answer nil / {} through TrainingKeys, ActiveTeamKeys
--     and FieldableKeys; MarkMigrated is allowed (a union); the Phase 4 migration does not run on a provisional
--     profile (it runs after the recovery, on ProfileRebased). Without a usable
--     store (Studio without API access) nothing is provisional: everything runs from memory.
--   * Forward compatibility: a save keeps every stored field this version does not know (top level,
--     inside Home and inside Stats) and a newer Version number, so a server still running an older build after
--     a later phase is published never erases that phase's data.
--   * v1 saves ({Tokens = n} in Config.Tokens.LegacyDataStoreName) are migrated once: when the v2
--     key is empty, the legacy key is read and its tokens become the starting balance. The legacy
--     store is never written. (Release step 1: the load's claim writes those tokens into the v2 record together
--     with its lock, so a server of the older build, which reads any stored record as a v2 save, never skips them.)
--   * A leaving player's cache entry is only freed once the store holds everything it knows. If the
--     final save failed (outage, throttling, lock timeout, failed load that cannot be recovered), the
--     entry is kept as an "orphan": it is retried in the background with backoff, flushed by the
--     autosave sweep (which walks the cache, not the player list) and by BindToClose, and a quick
--     rejoin simply picks it up again. It is only dropped after a successful write or after
--     ORPHAN_TIMEOUT seconds. DataService alone makes this decision (Release); callers just call it.
--     The leave save starts only after the other PlayerRemoving handlers ran (task.defer), so what they write
--     at leave time (PetCareService refunds the dishes still cooking) is still in the cache and travels with
--     that save or with its orphan retry; a save started at once had nothing to write when the session was
--     already saved, returned without yielding, and Release dropped the entry before those handlers ran.
--   * Session lock (2026-11-10, docs/superpowers/specs/2026-11-10-session-lock-design.md; helper table P8): a player's
--     save is owned by ONE server at a time. The record holds one optional top-level key Lock = { Id, Job, Place, At }
--     (Id = game.JobId, "studio-<guid>" in Studio; Job / Place are diagnostics; At = Unix seconds of the last write that
--     carried it), in KNOWN_TOP, never in a profile / Base / delta / snapshot; Version stays 2. The load claims it with
--     ONE UpdateAsync whose pure callback only adds Lock (no GetAsync); a brand-new player's claim writes a lock-only
--     record { Lock }, which every read treats as "nothing stored" (the v1 lookup still runs). A live lock of another
--     server makes the load wait (attempts every Config.Save.ClaimRetrySeconds, at most ClaimWaitSeconds; the player
--     attribute Config.Attr.SaveWaiting = true meanwhile), then play PROVISIONALLY (see above) while the recovery keeps
--     claiming. Every save refreshes the lock; an idle entry's empty save still writes once the lock is
--     HeartbeatSeconds old (skipped while the UpdateAsync budget is under 10). Every write is guarded: a record that
--     holds another server's live lock is never written (the write is cancelled, a warning): an orphan's entry is
--     dropped (a stale server never saves), a player still here plays on a stand-in (the store wins at the
--     recovery's claim). Review round 1: this server trusts its own cached lock only for LockSeconds - 30 s after its
--     last landed write (P8.trusted): past that OwnsSave is false, a rejoin claims again instead of using the cache,
--     and a write goes ahead only into a record that still holds this server's lock (another server may have taken it
--     and released it since). A provisional entry is always a true stand-in (defaults), never cached or seen data.
--     Review round 2: every write stamps WriteId (a nonce; claims clear it): a write whose answer was lost is adopted
--     when the next attempt finds its nonce (no second delta, and a strict release that left no lock is not taken for
--     another server's); a landed claim is recorded on the entry the moment UpdateAsync returns; a claim that errored
--     (ClaimSent) is let go by one cheap release of a clean stand-in (P8.letGo); time an orphan spends refused by a live
--     lock does not run out ORPHAN_TIMEOUT; BindToClose keeps claiming a held stand-in every ClaimRetrySeconds inside
--     its cap; a held entry's recovery first claims 4 s after the give-up; the re-take after a late release never waits
--     for budget (retried RETAKE_DELAY later on failure); the GemsSettled attribute follows OwnsSave.
--     A write for a player who left (or is leaving, or at BindToClose) is a
--     release (Lock cleared); an entry whose release failed stays an orphan until it lands (so does one still loading
--     at the leave); a release that lands after the player rejoined is followed by a re-take. A lock is free (stale)
--     when its At is LockSeconds old or more, LockSeconds in the future, junk, or (Studio only) another Studio
--     session's. Every DataService copy in the smoke mock shares game.JobId "mock-job" (one server, two caches); a test
--     gives a copy its own id with _SetServerIdForTest. The lobby shop's 15 s gem settle hold is retired into the lock
--     (spec 12): GemsSettled is OwnsSave, Settled fires once per load when it turns true (see the API below).
--   * The store never holds a sparse array: Garden / Gym are written as arrays with "" for empty slots (or a map
--     with string keys when a slot has a name); empty Phase 2 maps (Food, Tiers, Hybrids, GemReceipts) and Teams /
--     Battle while they hold the defaults are left out of the record. ProfileSync uses the same slot encoding (client
--     State decodes it). Battle.TrialCleared is stored and synced as a DENSE array of booleans indexed by level
--     ({true, true, false, true}: false = not cleared), so `TrialCleared[level]` reads the same on both sides.
--
-- Public API
--   Load(player) -> live profile, GetProfile(player), MarkDirty(player), Sync(player), Save(player),
--   StartAutosave(), BindToClose(), AddTokens / SpendTokens / GetTokens, RecordMatch, signal ProfileLoaded.
--   v3: MarkDiscovered(player, petId) -> isNew (marks dirty; the caller Syncs, PetService does right after a roll),
--     GetTutorial(player) -> copy | nil until loaded (and while provisional), SetTutorial(player, t) -> ok
--     (MarkDirty + Sync; Gifted never goes back to false; false while provisional).
--   Phase 2 (all mark the profile dirty; never yield; the balance checks and writes are atomic):
--     GetHome(player) -> deep copy of Home (Garden / Gym keyed by slot number) | nil until loaded / while provisional
--     MutateHome(player, fn) -> ok      fn(home) edits the LIVE Home table and must not yield. It runs under pcall:
--                                       an error, or fn returning false, restores the Home as it was (-> false).
--                                       Afterwards the Home is sanitised in place; a change the client can see
--                                       (anything but CollectorCash / LastSeen) is synced (throttled, see below).
--     AddCash(player, n) -> ok          n > 0 (fractions allowed: income math; the store keeps whole units)
--     SpendCash(player, n) -> ok        false (nothing taken) when the balance is short; never negative
--     GetCash(player) -> whole cash
--     AddGems / SpendGems / GetGems     the same for Gems (whole numbers)
--     AddFood(player, foodId, n) -> ok, SpendFood(player, foodId, n) -> ok, GetFood(player, foodId) -> count
--                                       (GetFood(player) -> a copy of the whole map); Food changes are synced
--     GetPetLevel(player, key) -> level, xp       (1, 0 for a pet that never gained XP)
--     AddPetXp(player, key, xp) -> levelsGained   owned copies only; the curve is TycoonCatalog.XpToNext(level)
--                                       (a local fallback when that module is missing); synced
--     The player attributes Config.Attr.Cash / Config.Attr.Gems mirror the (whole) balances for the HUD.
--   Phase 3 (battle teams + the battle record; nothing here yields; reasons are short texts for a side toast):
--     TeamsChanged                      Util.Signal (exists at module load) Fire(player) after every successful SetTeam /
--                                       SelectTeam, when pruning dropped keys from the live presets or moved Equipped, after
--                                       a rebase, and on the load whose B4TeamFollow moved a team
--     GetTeams(player) -> { Presets = { {key...}, {key...}, {key...} }, Active = 1..3, Slots = 3 | 4, Busy = {[key] =
--                                       "Training" | "Garden"} }   a pruned copy (the ProfileSync shape) | nil until loaded
--                                       and while provisional
--     SetTeam(player, preset, keys) -> ok, reason   preset 1..3; keys = the pets in slot order ("" / false = an empty
--                                       slot; the list is compacted). Refused: junk, a pet in a slot past Slots (slot 4
--                                       before the prestige unlock), the same key twice, a key not owned, a DIRECT pick
--                                       of a busy key ("That pet is gardening! ..." for a Garden pet: the client offers
--                                       the recall, TycoonService.GardenRecall; "<Pet> is training (2:10 left)"), the
--                                       active preset during an obby match, a profile not loaded or provisional. A busy
--                                       key already in this preset is no pick when it stays in its slot or the list holds
--                                       the same keys (a swap): send "" / false for an emptied slot, so the pets behind
--                                       it keep their index. An empty list clears the preset. MarkDirty + SyncSoon +
--                                       TeamsChanged.
--     CheckTeam(player, preset, keys, freeKey?) -> ok, reason   SetTeam's checks without writing; freeKey counts one
--                                       copy of that key as out of the Garden (bug batch 2 #18: the recall check)
--     SelectTeam(player, preset) -> ok, reason      makes that preset the active one: the followers change at once
--                                       (MarkDirty + SyncSoon + TeamsChanged); refused during an obby match
--     SyncEquipped(player) -> changed   rewrites Equipped from the invariant (MarkDirty + SyncSoon when changed; never
--                                       fires TeamsChanged; PetService.Refresh republishes the attributes)
--     BusyKeys(player) -> {[key] = "Training" | "Garden"}   training keys + every owned key with NO copy free of the
--                                       Garden / Gym ({} until loaded / provisional)
--     FieldableKeys(player) -> {key...}             every owned key with a copy free for a team (not in the Garden or the
--                                       Gym, not in training; bug batch 2 #18: a garden pet is busy)
--     PlacedCopies(player) -> {[key] = n}           copies working in the Garden / Gym (bug batch 2 #18; {} until loaded /
--                                       while provisional): PetService.Equip and its re-validation read it
--     GardenBusyKeys(player) -> {[key] = true}      every owned key with NO copy free of the Garden / Gym (the "gardening"
--                                       badge; BusyKeys without the training keys; {} until loaded / provisional)
--     ClosedBedOverlap(player) -> {slot...}         CLOSED garden places (above the open count) whose copy now also
--                                       follows / sits in a preset; TycoonService empties them silently ({} when none)
--     ActiveTeamKeys(player) -> keys, why           the active preset minus busy keys, in slot order: equals Equipped at all
--                                       times; why = nil with at least one key, "Empty" for an empty preset, "Busy" when
--                                       all its pets are busy, "Loading" until loaded and while provisional
--     GetBattle(player) -> { Trophies, TrialBest, TrialCleared = {[level]=true}, Raids, RaidBestDamage, PvPWins,
--                                       PvPLosses, EventPets = {[petId]=true} }   a copy | nil until loaded and while
--                                       provisional (stand-in data must never decide a first clear or an event pet)
--     MutateBattle(player, fn) -> ok    fn(battle) edits the LIVE record and must not yield; an error, or fn returning
--                                       false, restores it (-> false). Afterwards it is sanitised in place: whole numbers
--                                       >= 0, TrialCleared / EventPets never lose an entry and TrialBest / RaidBestDamage
--                                       never go down (the store merges them so), TrialBest >= the highest cleared level.
--                                       While provisional only Trophies / Raids / PvPWins / PvPLosses / RaidBestDamage may
--                                       change (they merge safely into the real save): any other change rolls the whole
--                                       call back (-> false). Pay a reward decided inside fn only once this returned true.
--                                       A change is synced (throttled).
--     DuelsWith(player, opponentUserId, since) -> n   lobby-shop 16.12: the record's duels with that opponent at Unix
--                                       second `since` or later (0 until loaded)
--     RecordDuel(player, opponentUserId, at) -> ok    lobby-shop 16.12: adds { U, T } to Battle.Duels (window + 32 older kept,
--                                       junk refused; also while provisional: it merges as a union). Not synced.
--     AddTrophies(player, n) -> ok, total            n is rounded to a whole number and may be negative; the total
--                                       never goes below 0. Works like AddCash (also before the load finished and while
--                                       provisional: trophies merge as a delta). Synced (throttled).
--   Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" section 4.2; nothing here yields; every helper lives in the
--   P4 table next to P3):
--     GetGrowth(player, key) -> { Evo, Speed, Physique, Ability, Defense, Job = {...} | nil }   a copy, zeros when
--                                       absent (also before the load and while provisional: display only)
--     GetGrowthMap(player) -> { [key] = entry }   a clean copy of the whole map ({} until loaded / while provisional)
--     MutateGrowth(player, fn) -> ok    fn(growth) edits the LIVE PetGrowth map { [key] = entry } and must not yield.
--                                       Refused until loaded and while provisional. An error, or fn returning false,
--                                       restores the map (-> false). Afterwards it is cleaned in place
--                                       (P4.cleanGrowth) and no Evo / rank may go down (the store merges them as
--                                       the higher value, so a lower write would come back anyway); a changed map is
--                                       synced (throttled). Decide a reward / refund inside fn and pay it only once
--                                       this returned true (the Job and the Cash then travel in the same step).
--     TrainingKeys(player) -> {[key] = true}        every key with a running Job ({} until loaded / while provisional):
--                                       the ONE source of the training lock (PetService.Equip, GardenSet, Fusion,
--                                       teamOf, the ring start and this module's own filters read it)
--     GetEvolution(player, key) -> 0..2             the stored stage (0 when absent)
--     SetEvolution(player, key, stage) -> ok        only up: true when the stage was raised to `stage` (<= 2 and <=
--                                       PetCatalog.MaxEvolution of the key's def when the catalog is there); false
--                                       for a stage not above the stored one, junk, not loaded, provisional
--     GetRing(player) -> { Best, Runs } | nil       a copy; nil until loaded and while provisional
--     MutateRing(player, fn) -> ok      fn(ring) edits the live record (no yields); Best never goes down (max), Runs
--                                       is a whole number >= 0; rollback on error / false; refused while provisional.
--                                       Decide "new record" / "first boss clear" rewards inside fn.
--     IsMigrated(player, name) -> bool | nil        nil until loaded and while provisional (not decidable)
--     MarkMigrated(player, name) -> ok  records Migrations[name] = true (a union: allowed while provisional)
--     MigratedNow(player, name) -> info | nil       info when THIS session ran that migration on this profile (the
--                                       entry remembers it until the player is released): for "P4" { Veteran = bool
--                                       (the profile had a home before), LegacySlots = n | nil, LegacyPrices = bool,
--                                       GymKeys = {key...} (the Gym pets set free), GymPets = #GymKeys,
--                                       CollectorCash = n (the Cash that waited on the Phase 3 Collector) }.
--                                       TycoonService shows the one welcome toast on the first claim when
--                                       MigratedNow(player, "P4").Veteran is true. Because that first claim may
--                                       happen in a LATER session, the migration also persists the marker
--                                       Migrations.P4Veteran (IsMigrated(player, "P4Veteran")); TycoonService
--                                       shows the toast when it is set and "P4Welcome" is not, then
--                                       MarkMigrated(player, "P4Welcome") (a union: never shown twice).
--     Migrated                          Util.Signal (exists at module load) Fire(player, name, info) right after the
--                                       ProfileLoaded / ProfileRebased that ran a migration; bug batch 2 #18:
--                                       "B2GardenSolo" { Keys = {key...} } when the read took pets out of the Garden
--                                       (they stayed equipped / in a team; MigratedNow(player, "B2GardenSolo") too);
--                                       HUD cleanup: "B3ItemsRefund" { Tokens = n, Items = {[id]=count} } when the
--                                       refund paid Tokens (Main.server shows the toast; MigratedNow answers it too).
--                                       B4TeamFollow does not fire this: MigratedNow(player, "B4TeamFollow") alone.
--     SetPetLevel(player, key, level) -> ok   developer tools: writes { Level, Xp = 0 } for an OWNED key (1..the curve's
--                                       max level); refused until loaded / while provisional; synced
--   ProfileSync snapshot: Tokens, Pets, Equipped, Stats, SpotIndex, Perks, Discovered, IndexClaimed (no Items since
--     the HUD cleanup),
--     Tutorial + Phase 2: Cash, Gems, Home { Level, Prestige, Stations, Garden, Gym, CollectorCash, LegacySlots?,
--     LegacyPrices? } (slot maps encoded like the store), Food, Tiers, Hybrids, PetLevels + Phase 3: Teams { Presets,
--     Active, Slots, Busy } (pruned), Battle { Trophies, TrialBest, TrialCleared = {bool...} (index = level), Raids,
--     RaidBestDamage, PvPWins, PvPLosses, EventPets = {[petId]=true} } + Phase 4: PetGrowth { [key] = { Evo?, Speed?,
--     Physique?, Ability?, Defense?, Job? } } (zero numbers left out: the client fills them), Ring { Best, Runs }
--     + Phase 5: Dungeon, Berries, Settings (every key, FastHatch included); never Pity.
--     Plain tables, never shared with the live profile.
--   Extras (used by PetService / IndexService / DevService / GemService, harmless otherwise): Release(player), Init(),
--     ComputePerks(equippedKeys, profile|nil), IsDiscovered(player, petId), IsProvisional(player),
--     ResetFields(player, { Discovered, IndexClaimed, Tutorial, BestTimes, Home, Tiers, Hybrids, PetLevels, Teams,
--     Battle, PetGrowth, Ring, Migrations, Dungeon, Daily, Trove, Pity = true })
--     -> ok (the session's CURRENT values of those fields replace the stored ones at the next successful save),
--     HasReceipt(player, purchaseId) -> bool | nil, MarkReceipt(player, purchaseId, gems?) -> true (new: grant now) |
--     false (already processed: grant nothing) | nil (not decidable now: profile not loaded or provisional -> answer
--     NotProcessedYet; `gems` = the amount granted with it (a number = { Gems = n }, or a grant table), so a purchase
--     another server already stored is never added twice), SyncSoon(player) (a throttled Sync: at most one snapshot
--     per 0.25 s, trailing call kept), signal ProfileRebased(player, profile).
--     Session lock: OwnsSave(player) -> bool (the profile is loaded, not provisional, and this server holds the lock;
--     true with no usable store: nothing to own), _SetServerIdForTest(id) -> id | false (Studio and the mock only: this
--     module copy's server id, set before its first Load).
--   Store build (spec section 6; helper table P7; nothing here yields; every write is one step and rides the next
--   UpdateAsync with its grant record):
--     NoteReceiptGrant(player, purchaseId, grant) -> ok   records what a receipt REALLY granted (substitutes included;
--                                       replaces what MarkReceipt recorded) for a receipt in the live profile but not
--                                       in the store yet; false otherwise, until loaded and while provisional
--     MarkBought(player, key) -> ok     Store.Bought[key] = os.time(); false when already set, until loaded, provisional
--     GetStore(player) -> copy | nil    { Bought, Passes, Boosts } (nil until loaded and while provisional)
--     MarkPassSeen(player, key) -> ok   Store.Passes[key] = os.time() once (a union: allowed while provisional)
--     AddBoost(player, id, seconds) -> ok, ends   Store.Boosts[id] = max(now, the running end) + seconds (no cap: a
--                                       paid potion is never eaten, Z7); refused until loaded / while provisional
--     GetDaily(player) -> copy | nil    the live shape (PlayClaimed a set); nil until loaded and while provisional
--     MutateDaily(player, fn, grant?, now?) -> ok   fn(daily) edits the LIVE Daily and must not yield; an error,
--                                       or fn returning false, restores it (-> false); afterwards it is sanitised in
--                                       place. A `grant` table ({ Kind = "Day" | "Play", Tier, Cash, Tokens, Gems,
--                                       Berries, Pets }) is stamped At = `now` (the caller's one clock of the claim;
--                                       without it ONE os.time() read), Prev = the LastClaimAt before fn (the stamp the
--                                       claim built on), PlayStart = daily.PlayStart (after fn) and Star
--                                       = the live Home.Prestige, and kept in the entry's DailyClaims for the merge: pay
--                                       it right after, nothing yielding between. A number in the grant's place is
--                                       `now` (no grant). Refused until loaded / while provisional. Not synced.
--     GetTrove(player) -> copy | nil    {[askId] = true}; nil until loaded and while provisional
--     MarkTrove(player, askId, grant) -> ok   Trove[askId] = true + the grant record; false when set, until loaded,
--                                       while provisional
--     ResetFields gained Daily and Trove (the dev reset); Store is not resettable.
--   Lobby shop (spec 5.2; helpers in P7; nothing here yields):
--     GetPity(player) -> { Spins, Hit } | nil       a copy of Pity.Secret; nil until loaded and while provisional
--     SetPity(player, spins, hit) -> ok  a plain write on the real entry (no callback form: the pity is never refused
--                                       after the charge): whole numbers 0..1e9 or false (nothing written); Hit never
--                                       below the live Hit, then Hit <= Spins; MarkDirty + SyncSoon; false until loaded
--                                       and while provisional
--     ResetFields gained Pity; Settings gained FastHatch (SetSetting takes booleans only; the snapshot carries it).
--     GemsSettled(player) -> bool       the server-hop guard of the gem-priced actions (spec 5.2), since 2026-11-10 the
--                                       session lock's flag: OwnsSave(player) (the 15 s gem settle hold and its settle read
--                                       are retired, docs/superpowers/specs/2026-11-10-session-lock-design.md 12: the lock
--                                       covers every case they covered). True at once after a normal load; false while a
--                                       load waits for another server's lock, while provisional and after a release.
--                                       Gem-priced actions refuse "Your data is still loading" while it is false
--                                       (FusionService's gem fusions, the gem spins, the Secret Roulette, GemBuy). Once true
--                                       for a load: Settled:Fire(player), once per load (entry.SettledFired, reset by every
--                                       (re)join): right after ProfileLoaded, or right after the ProfileRebased of the
--                                       recovery that claimed (its listeners already see true). The player attribute
--                                       Config.Attr.GemsSettled (review round 2) follows the flag: true while it is true
--                                       (absent before), removed (nil, never written false) when it turns false with the
--                                       player here (a guard trip, a release that landed after a rejoin, the trust window
--                                       running out), set again by the next landed non-release write.
--     _SettleForTest(player) -> ok      Studio and the mock only (RunService:IsStudio()): answers OwnsSave(player) and does
--                                       nothing else (no read); false with no entry, not loaded, provisional, or outside Studio
--     Settled                           Util.Signal (exists at module load) Fire(player) once per load when GemsSettled
--                                       turned true
--
-- Plain Lua 5.1-compatible syntax only.

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = {}

-- Fired after a profile finished loading: (player, profile). Handlers run on their own thread.
DataService.ProfileLoaded = Util.Signal()
-- Fired when the live profile was replaced by newer stored data (recovered failed load, or another
-- server changed the save): (player, profile). PetService re-validates its attributes on this.
DataService.ProfileRebased = Util.Signal()
-- Phase 3: fired after SetTeam / SelectTeam, when stale keys were pruned from the live presets and after a rebase:
-- (player). Exists at module load so other services can connect before any Init.
DataService.TeamsChanged = Util.Signal()
-- Phase 4: fired right after the ProfileLoaded / ProfileRebased that ran a one-time migration on the profile:
-- (player, name, info) with name "P4" and the info table of MigratedNow (see the header). Exists at module load.
DataService.Migrated = Util.Signal()
-- Lobby shop (spec 5.2; session lock spec 12): fired once per load when GemsSettled (= OwnsSave) turned true: (player).
DataService.Settled = Util.Signal()

local PROFILE_VERSION = 2
local RETRY_DELAY = 1.5 -- seconds between the two attempts of a read/write
local MAX_COUNT = 1000000000 -- sanity cap for tokens and stats
local MAX_CASH = 1000000000000000 -- 1e15: tycoon money grows large; still an exact integer in a double
local MAX_FOOD = 1000000 -- per food type
local MAX_KEY_LENGTH = 48
local MAX_SLOT = 64 -- Garden / Gym slot numbers 1..MAX_SLOT
local MAX_RECEIPTS = 100 -- GemReceipts keeps the newest processed purchase ids
local MAX_TIME = 100000000000 -- sanity cap for os.time() stamps (LastSeen, receipts)
local REQUEST_COOLDOWN = 0.5 -- RequestProfile rate limit (seconds per player)
local SYNC_GAP = 0.25 -- SyncSoon: at most one snapshot per this many seconds per player
local ORPHAN_RETRY_FIRST = 10 -- seconds before the first background retry of an unsaved, departed profile
local ORPHAN_RETRY_MAX = 120 -- the retry delay doubles up to this
local ORPHAN_TIMEOUT = 1800 -- give up on (and drop) a departed profile that still cannot be saved after this long
local IS_STUDIO = RunService:IsStudio()
local STAT_KEYS = { "Matches", "Wins", "TokensEarned", "Spins" }
local MAX_TUTORIAL_STEP = 1000 -- sanity cap for Tutorial.Step (TutorialService clamps to its own step count)
local MAX_LEVEL = 100000 -- sanity cap for home / station / pet levels and prestige
local DEFAULT_MAX_PET_LEVEL = 100 -- AddPetXp cap when TycoonCatalog does not name one
local TIER_NAMES = { "Golden", "Rainbow" }
local VALID_TIER = { Normal = true, Golden = true, Rainbow = true }

-- Fields ResetFields may write over the store (everything else already follows a reset through the normal delta).
-- GemReceipts are deliberately not resettable: they keep developer-product purchases from being granted twice.
local OVERWRITABLE = {
	Discovered = true, IndexClaimed = true, Tutorial = true, BestTimes = true,
	Home = true, Tiers = true, Hybrids = true, PetLevels = true,
	Teams = true, Battle = true, -- Phase 3: the battle record's sets only grow and its best values only rise
	PetGrowth = true, Ring = true, Migrations = true, -- Phase 4: ranks / stages / Best only rise, Migrations only grow
	Dungeon = true, -- Phase 5: Best max / Cleared union would bring a reset record back
	Daily = true, Trove = true, -- Store build: the pair / Play group maxima and the ask union would bring them back; Store
	-- stays out (Robux: bought packs and potion ends are never reset)
	Pity = true, -- lobby shop: Pity.Secret.Hit merges as the max and would come back
}
-- Stored keys this version owns. Anything else in a stored profile belongs to a newer phase and is written back
-- untouched by every save (see keepForeign).
local KNOWN_TOP = {
	Version = true, Tokens = true, Pets = true, Equipped = true, Items = true, Stats = true, SpotIndex = true,
	Discovered = true, IndexClaimed = true, Tutorial = true, Cash = true, Gems = true, Home = true, PetLevels = true,
	Food = true, Tiers = true, Hybrids = true, GemReceipts = true, Teams = true, Battle = true,
	PetGrowth = true, Ring = true, Migrations = true, -- Phase 4
	Dungeon = true, Berries = true, Settings = true, -- Phase 5
	Store = true, Daily = true, Trove = true, -- Store build
	Pity = true, -- lobby shop (without it keepForeign would copy the stored Pity back over every save: a frozen count)
	UpdatedAt = true,
	Lock = true, -- session lock: record metadata like UpdatedAt; known, so a release that leaves it out really removes it
	WriteId = true, -- session lock, review round 2: the last write's nonce (record metadata; every write stamps its own)
}
local KNOWN_HOME = {
	Level = true, Rooms = true, Prestige = true, Stations = true, Garden = true, Gym = true, CollectorCash = true,
	LastSeen = true,
	LegacySlots = true, LegacyPrices = true, -- Phase 4
	DecorCredit = true, LegacyMagnet = true, LegacyMagnetStar = true, -- Phase 5
}
local KNOWN_STATS = { Matches = true, Wins = true, TokensEarned = true, Spins = true, BestTimes = true }

-- cache[userId] = {
--   Profile = live profile table (what every other module reads and mutates),
--   Base = profile the store is known to contain (delta reference),
--   Owner = the Player instance the entry was last announced to (a quick rejoin gets a new one),
--   Loaded, Loading, LoadFailed, Saving, Dirty, RecoveryScheduled = bool flags,
--   Orphan = true while the player is gone but the entry still holds unsaved progress,
--   OrphanSince = os.clock() when it became an orphan, OrphanScheduled = a background retry loop runs,
--   Overwrite = { [field] = true } fields ResetFields asked to write over the store (nil when none is pending;
--     cleared only after a successful write, so orphan retries and BindToClose carry it too),
--   OverwriteGen = counter bumped by every ResetFields (a reset during an in-flight save stays pending),
--   LastSync = os.clock() of the last ProfileSync, SyncQueued = a trailing SyncSoon is scheduled,
--   ReceiptGrants = { [purchaseId] = grant } granted with receipts not in the store yet (MarkReceipt / NoteReceiptGrant;
--     nil when none; the Store build's name of ReceiptGems: a grant table instead of a gem count),
--   DailyClaims = { grant... } the daily claims (MutateDaily's grant, stamped At / Prev / PlayStart / Star) not in the
--     store yet, in claim order,
--   TroveGrants = { [askId] = grant } the Trove asks (MarkTrove) not in the store yet (P7.pruneGrants drops all three
--     after a confirmed save),
--   session lock: LockHeld = this server's lock is in the record (the claim or a non-release write landed; false after
--     a release or a guard trip), LockAt = the lock's At as written (the heartbeat's age, P8.trusted), HeldBy = { Id, At } of the
--     live lock that made the load wait or the guard trip (nil once claimed), Leaving = PlayerRemoving ran for this
--     session (its writes are releases; Load clears it on a rejoin), SettledFired = this load already fired Settled
--     (the lock's flag, P8.settled; Load resets it on every (re)join),
--   review round 2: ClaimSent = a claim errored and may have committed (P8.letGo), ClaimLanded = a claim of the current
--     claim loop wrote, SentWrite = { [nonce] = what that write wrote } writes whose answer never came, LandedWrite = the
--     nonce of the last landed write (P8.mine), RetakeScheduled = a failed re-take's retry runs (P8.retakeLater)
-- }
local cache = {}
local store = nil
local storeResolved = false
local legacyStore = nil
local legacyResolved = false
local storeDisabled = false -- true once the DataStore API is known to be unusable (Studio)
local autosaveStarted = false
local closeBound = false
local shuttingDown = false
local playerHooked = false
local requestHooked = false
local remoteCache = {}
local lastRequest = {} -- [userId] = os.clock() of the last accepted RequestProfile

----------------------------------------------------------------------
-- Optional shared modules (written by other engineers; resolved lazily, every use is guarded)
----------------------------------------------------------------------

local optionalModules = {}
local function getShared(name)
	local entry = optionalModules[name]
	if entry == nil then
		entry = false
		local module = Shared:FindFirstChild(name)
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				entry = result
			else
				warn("[DataService] " .. name .. " failed to load: " .. tostring(result))
			end
		end
		optionalModules[name] = entry
	end
	return entry or nil
end

local function getPetCatalog()
	return getShared("PetCatalog")
end

local function getPetKeys()
	return getShared("PetKeys")
end

local function getTycoonCatalog()
	return getShared("TycoonCatalog")
end

-- resolve PetKeys now (DataService's pure merge code counts equipped copies with it inside UpdateAsync), and
-- TycoonCatalog (the merge reads its team-slot unlock when it prunes the battle teams)
getPetKeys()
getTycoonCatalog()

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function keyFor(userId)
	return "u_" .. tostring(userId)
end

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- Any value -> non-negative integer within sane bounds.
local function sanitize(n)
	if not isFinite(n) or n < 0 then
		return 0
	end
	if n > MAX_COUNT then
		return MAX_COUNT
	end
	return math.floor(n)
end

local function clampCount(n, maxCount)
	local value = sanitize(n)
	if value > maxCount then
		return maxCount
	end
	return value
end

-- Cash -> whole units in 0..MAX_CASH (the store and the snapshot hold whole cash).
local function sanitizeCash(n)
	if not isFinite(n) or n < 0 then
		return 0
	end
	if n > MAX_CASH then
		return MAX_CASH
	end
	return math.floor(n)
end

-- Cash for the LIVE profile: clamped, fractions kept (per-second income accumulates in fractions).
local function clampCash(n)
	if not isFinite(n) or n < 0 then
		return 0
	end
	if n > MAX_CASH then
		return MAX_CASH
	end
	return n
end

local function sanitizeTime(n)
	if not isFinite(n) or n < 0 then
		return 0
	end
	if n > MAX_TIME then
		return MAX_TIME
	end
	return math.floor(n)
end

-- Seconds for BestTimes: finite, > 0, rounded to 1/100 s. Returns nil when unusable.
local function sanitizeSeconds(n)
	if not isFinite(n) or n <= 0 or n > 10000000 then
		return nil
	end
	return math.floor(n * 100 + 0.5) / 100
end

local function validKey(key)
	return type(key) == "string" and #key > 0 and #key <= MAX_KEY_LENGTH
end

-- hybrid uids: letters, digits, "_" and "-" (they live inside keys and csv attributes)
local function validUid(uid)
	return type(uid) == "string" and #uid >= 1 and #uid <= 24 and string.find(uid, "^[%w_%-]+$") ~= nil
end

local function copyMap(map)
	local out = {}
	if type(map) ~= "table" then
		return out
	end
	for key, value in pairs(map) do
		out[key] = value
	end
	return out
end

local function copyList(list)
	local out = {}
	if type(list) ~= "table" then
		return out
	end
	for i, value in ipairs(list) do
		out[i] = value
	end
	return out
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end

local function deepEqual(a, b)
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		return false
	end
	for k, v in pairs(a) do
		if not deepEqual(v, b[k]) then
			return false
		end
	end
	for k in pairs(b) do
		if a[k] == nil then
			return false
		end
	end
	return true
end

local function mapsEqual(a, b)
	for key, value in pairs(a) do
		if b[key] ~= value then
			return false
		end
	end
	for key in pairs(b) do
		if a[key] == nil then
			return false
		end
	end
	return true
end

local function listsEqual(a, b)
	if #a ~= #b then
		return false
	end
	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end
	return true
end

local function tableOr(t)
	if type(t) == "table" then
		return t
	end
	return {}
end

----------------------------------------------------------------------
-- Profile construction / validation
----------------------------------------------------------------------

local function newTutorial()
	return { Step = 1, Done = false, Gifted = false }
end

-- Home.Rooms is the same table as Home.Stations (the v3 name, kept for old code). The Phase 4 keys LegacySlots /
-- LegacyPrices are absent (nil) unless the Phase 4 migration wrote them.
local function newHome()
	local stations = {}
	return {
		Level = 0,
		Prestige = 0,
		Stations = stations,
		Rooms = stations,
		Garden = {},
		Gym = {},
		CollectorCash = 0,
		LastSeen = 0,
		LegacySlots = nil,
		LegacyPrices = nil,
		-- Phase 5 (nil unless the P5Home fold wrote them)
		DecorCredit = nil,
		LegacyMagnet = nil,
		LegacyMagnetStar = nil,
	}
end

-- Phase 3 (battle teams + the battle record). Its constants and helpers live in ONE table: the main chunk of this
-- module is close to Lua's limit of 200 local variables. None of the values below is in Config (local constants).
local P3 = {
	PRESETS = 3, -- saved team presets (Teams.Presets[1..3])
	SLOTS = 3, -- pets in a team: a fighter and two helpers (Phase 5, 4.8: the 4th slot is gone; a stored 4-key preset
	MAX_SLOTS = 3, -- keeps its first 3 keys, the 4th pet stays owned with its level and growth)
	MAX_TRIAL_LEVEL = 200, -- sanity cap for TrialBest / TrialCleared levels (the trials go up to 30)
	COUNTERS = { "Trophies", "Raids", "PvPWins", "PvPLosses" }, -- merge as +/- deltas (never below 0)
	BESTS = { "TrialBest", "RaidBestDamage", "RaidRewardAt", "RaidLossAt" }, -- merge as the higher value
	-- what MutateBattle may change while the profile is provisional (these merge safely into the real save)
	PROVISIONAL_OK = { Trophies = true, Raids = true, PvPWins = true, PvPLosses = true, RaidBestDamage = true, RaidRewardAt = true, RaidLossAt = true, Duels = true },
	-- lobby-shop 16.12: Battle.Duels = { { U = opponent UserId, T = Unix seconds }... } newest first (BattleService's
	-- cross-server pair limit reads the last PAIR_WINDOW of it); merges as a union. 16.13 review fix 6: every entry of the
	-- last DUELS_WINDOW seconds (BattleService's PAIR_WINDOW) is kept, plus at most DUELS_KEEP older ones, DUELS_MAX in all
	DUELS_KEEP = 32,
	DUELS_WINDOW = 1800,
	DUELS_MAX = 64,
	MAX_USER_ID = 1e15,
	MARK_TEAM = "B4TeamFollow", -- Migrations[name]: the save went through the one-team rule (team balance, P3.teamMigrate)
	MATCH_LOCKED = "Pets are locked during a match", -- the active team during an obby match (PetService's words)
}

-- Phase 4 (pet growth: evolution stages + training; the Champion Ring record; migration markers; the veteran Home
-- keys). Like P3, ONE table holds every constant and helper (the one new top-level local of Phase 4). None of the
-- values below is in Config (local constants of the save format; the game rules live in PetCatalog / BattleCatalog /
-- TycoonCatalog and are read lazily where a rule, not the format, decides).
local P4 = {
	STATS = { "Speed", "Physique", "Ability", "Defense" }, -- the training skills (PetGrowth[key][stat] = rank)
	STAT_SET = { Speed = true, Physique = true, Ability = true, Defense = true },
	MAX_RANK = 10, -- training ranks 0..10
	MAX_EVO = 2, -- evolution stages 0..2 (PetCatalog.MaxEvolution decides per rarity; the data clamps at 2)
	MAX_JOB_SLOT = 5, -- Training Place mats 1..5
	MAX_FROM = 16, -- Job.From: "Follow" | "Garden:<slot>" | "Free" (a short string)
	MAX_RING = 100000, -- sanity cap for Ring.Best (the ring is endless; records are a few dozen rounds)
	MIGRATION = "P4", -- Migrations[name] of the one-time Phase 4 migration (section 4.3)
	VETERAN_MARK = "P4Veteran", -- set by that migration when the profile had a home before (the welcome toast is owed)
	WELCOME_MARK = "P4Welcome", -- set by TycoonService (MarkMigrated) once the welcome toast was shown on the first claim
	GARDEN_SLOTS_BASE = 3, -- 3 + Prestige garden places when TycoonCatalog.Prestige.GardenSlotsBase is missing
	GARDEN_SLOTS_PER_STAR = 1,
}

-- Phase 5 (the Dungeon record, Berries, Settings, the P5 migrations and the folded Home keys; ARCHITECTURE_V3.md
-- "Phase 5 build contract" section 9). ONE table again (the one new top-level local of Phase 5). Save-format
-- constants only; the game rules (floors, berry prices, the fold) live in BattleCatalog / TycoonCatalog.
local P5 = {
	MAX_FLOOR = 100, -- Dungeon.Best / Cleared floors 1..100 (the dungeon has 10 floors + endless)
	MIGRATE_MAX_FLOOR = 10, -- the P5Dungeon migration credits at most floor 10
	TRIALS_PER_FLOOR = 3, -- Best = min(10, floor(TrialBest / 3)) (9.2 step 2)
	DUNGEON_MARK = "P5Dungeon", -- Migrations[name] of the one-time dungeon migration
	HOME_MARK = "P5Home", -- Migrations[name] of the one-time home fold (TycoonCatalog.FoldLegacy + the Food -> berries step)
	MOUSELOCK_MARK = "P5MouseLock", -- Migrations[name] of the one-time "mouse lock ON" step (bug batch 2 #21)
	GARDEN_MARK = "B2GardenSolo", -- Migrations[name]: the profile went through the garden-exclusive rule (bug batch 2 #18)
	LEGACY_FOOD = { Snack = 200, Meal = 1200, Feast = 6400 }, -- berries per old food when TycoonCatalog.Berries.LegacyFood is missing
	MAX_BERRIES = 1000000000, -- sanity cap (whole berries)
	BERRIES_GAP = 0.5, -- seconds: the Berries attribute is written at most twice a second (trailing write; 10.2 m6)
	SETTING_KEYS = { "Music", "Sfx", "Gfx", "Shake", "SeenNotes", "MouseLock", "FastHatch" },
	-- (lobby shop, spec 5.5: FastHatch, the egg stage's short roll; default off; toStored writes it only when true, so a
	-- record that already stores its Settings never gains FastHatch = false on its next save)
	-- 7.2 (+ MouseLock: dungeon-fixes 6). Bug batch 2 #21: MouseLock defaults to ON (a new profile, or a stored Settings
	-- table without the key). A stored false is NOT always a choice: since the option landed the store writes the whole
	-- Settings table (MouseLock = false, the old default) as soon as any one setting is non-default, so the one-time
	-- P5MouseLock step (P5.migrateMouseLock) turns the lock on ONCE for a profile without that marker. A player who sets
	-- MouseLock (SetSetting: the L key or the Settings row) marks it too, so a false chosen after this release stays false.
	SETTING_DEFAULTS = { Music = 6, Sfx = 8, Gfx = "Auto", Shake = true, SeenNotes = 0, MouseLock = true, FastHatch = false },
	GFX = { Auto = true, Low = true, High = true },
	MAX_VOLUME = 10, -- Music / Sfx 0..10
	MAX_NOTES = 1000, -- SeenNotes 0..1000 (UpdateNotes.Latest is a small version number)
	SETTINGS_RATE = 6, -- SettingsSet: 6 per second...
	SETTINGS_BURST = 6, -- ...with a burst of 6
	MAX_DECOR_CREDIT = 18, -- Home.DecorCredit 0..18 (the old decor levels that did not fit into Fence / Fountain)
	MAX_MAGNET = 5, -- Home.LegacyMagnet 1..5 (the old Coin Magnet level)
	buckets = {}, -- [userId] = { tokens, last } SettingsSet rate limit (cleared when the player leaves)
	pushes = {}, -- [userId] = { last = os.clock(), queued = bool } Berries attribute throttle
}

-- HUD cleanup (2026-10-30): the obby items are gone. ONE table again (the one new top-level local): the one-time
-- refund of the Items a save still holds (see the header, Migrations). Save-format constants only.
local P6 = {
	MARK = "B3ItemsRefund", -- Migrations[name] of the one-time item refund
	REFUND = { heal_cloud = 30, shield_bubble = 45, phoenix_feather = 150 }, -- Tokens per item (the old catalog prices)
	REFUND_MAX = 5, -- the old Config.Items.MaxCarry: stored counts clamp to it (on read, in the merge and in the refund)
}

-- Store build (2026-11-04, spec section 6; plan Task 5): the Robux Store / daily gifts / Sky Trove fields and the grant
-- records of their twin rules. ONE table again (the one new top-level local). Save-format constants only; the rules
-- (prices, the gift cells, the asks) live in Config.Store / Config.Daily / Config.Trove and shared/StoreCatalog.
local P7 = {
	MAX_TIER = 16, -- Daily.PlayClaimed tiers 1..16 (Config.Daily.Play.Tiers has 7)
	MAX_STREAK = 100000, -- Daily.Streak / Paid / Weeks sanity cap
	MAX_BOOST = 1000000000, -- seconds one AddBoost may add (sanity)
	KINDS = { Day = true, Play = true }, -- DailyClaims grant kinds
	AMOUNTS = { "Cash", "Tokens", "Gems", "Berries" }, -- the currency amounts of a grant
	STORE_MAPS = { "Bought", "Passes", "Boosts" },
	DAILY_NUMBERS = { "Streak", "Paid", "Weeks" }, -- whole numbers 0..MAX_STREAK
	DAILY_CLOCKS = { "LastClaimAt", "PlayStart", "ClampFrom", "ClampAt" }, -- Unix seconds, 0 = never
	MAX_PITY = 1000000000, -- lobby shop: Pity.Secret.Spins / Hit are whole numbers 0..MAX_PITY (anything else reads 0)
}

-- Session lock (2026-11-10, docs/superpowers/specs/2026-11-10-session-lock-design.md; see the header): ONE table again
-- (the one new top-level local besides HttpService). Id is this server's id: game.JobId on a live server, a
-- "studio-<guid>" per Studio session (game.JobId is "" there); _SetServerIdForTest changes it for one module copy. The
-- numbers live in Config.Save (P8.num falls back to the spec's values when a key is missing).
local P8 = {
	Id = (game.JobId ~= "" and game.JobId) or ("studio-" .. HttpService:GenerateGUID(false)),
	BUDGET = 10, -- an UpdateAsync request budget under this skips a heartbeat (the release and real saves still go)
	-- review round 1: this server trusts its own cached lock for LockSeconds minus SKEW after the last landed write (a
	-- margin for clock skew between servers and a slow call); after that another server may have taken the record
	SKEW = 30,
	DEFAULTS = { LockSeconds = 360, HeartbeatSeconds = 60, ClaimWaitSeconds = 12, ClaimRetrySeconds = 3 },
	-- review round 2: the recovery's delays for an entry another server's live lock holds (HeldBy): the first claim 4 s
	-- after the load's give-up, not the outage cadence's 20 s
	HELD_DELAYS = { 4, 10, 20, 40, 80, 160, 300 },
	RETAKE_DELAY = 6, -- review round 2: a failed re-take (a release landed after a rejoin) is tried again this much later
	RETAKE_TRIES = 5,
	CLOSE_CAP = 25, -- BindToClose's wait (Roblox gives ~30 s)
	-- review round 2: every write stamps the record with WriteId = Run .. "-" .. a counter (this module copy's run id), so
	-- the retry of a write whose answer was lost knows the record it finds is its own (P8.mine)
	Run = string.sub(HttpService:GenerateGUID(false), 1, 8),
	Seq = 0,
}

-- The Dungeon record: Best = the highest floor cleared (0 = none), Cleared = { [floor] = true } in the live profile
-- (a dense boolean array in the store and the snapshot, like Battle.TrialCleared), Runs = finished runs, Clears =
-- first clears (counter).
function P5.newDungeon()
	return { Best = 0, Cleared = {}, Runs = 0, Clears = 0 }
end

-- A floor number: a whole number 1..MAX_FLOOR (a numeric string too), or nil.
function P5.floorOf(value)
	local n = value
	if type(value) == "string" and string.find(value, "^%d+$") then
		n = tonumber(value)
	end
	if isFinite(n) and n >= 1 and n <= P5.MAX_FLOOR and n == math.floor(n) then
		return n
	end
	return nil
end

-- Untrusted Dungeon -> a clean record (whole numbers >= 0; Cleared as a set; Best >= the highest cleared floor).
function P5.cleanDungeon(raw)
	local r = tableOr(raw)
	local d = P5.newDungeon()
	d.Best = clampCount(r.Best, P5.MAX_FLOOR)
	d.Runs = sanitize(r.Runs)
	d.Clears = sanitize(r.Clears)
	for key, value in pairs(tableOr(r.Cleared)) do
		local floor = nil
		if value == true then
			floor = P5.floorOf(key)
		elseif type(key) == "number" and type(value) == "number" then
			floor = P5.floorOf(value)
		end
		if floor then
			d.Cleared[floor] = true
		end
	end
	for floor in pairs(d.Cleared) do
		if floor > d.Best then
			d.Best = floor
		end
	end
	return d
end

function P5.isDefaultDungeon(d)
	return d.Best == 0 and d.Runs == 0 and d.Clears == 0 and next(d.Cleared) == nil
end

-- Clean record -> the stored / synced form (Cleared as a dense boolean array; no sparse array for the DataStore).
function P5.encodeDungeon(d)
	local cleared, top = {}, 0
	for floor in pairs(d.Cleared) do
		if floor > top then
			top = floor
		end
	end
	for floor = 1, top do
		cleared[floor] = d.Cleared[floor] == true
	end
	return { Best = d.Best, Cleared = cleared, Runs = d.Runs, Clears = d.Clears }
end

-- The Dungeon delta (both clean), or nil: Best as a candidate when it rose, Cleared = the floors the session added
-- (a union), Runs as a +/- delta, Clears as a +/- delta EXCEPT the part the session's own P5Dungeon migration wrote
-- (`migrated` = that Clears value): it travels as ClearsFloor and merges as a max, so two servers migrating the same
-- save do not double it (9.1 m15).
function P5.diffDungeon(live, base, migrated)
	local d, any = { Best = nil, Cleared = {}, Runs = nil, Clears = nil, ClearsFloor = nil }, false
	if live.Best > base.Best then
		d.Best = live.Best
		any = true
	end
	for floor in pairs(live.Cleared) do
		if not base.Cleared[floor] then
			d.Cleared[floor] = true
			any = true
		end
	end
	if live.Runs ~= base.Runs then
		d.Runs = live.Runs - base.Runs
		any = true
	end
	local floorClears = isFinite(migrated) and migrated > 0 and math.floor(migrated) or 0
	local clearsDelta = live.Clears - base.Clears - floorClears
	if clearsDelta ~= 0 then
		d.Clears = clearsDelta
		any = true
	end
	if floorClears > 0 then
		d.ClearsFloor = floorClears
		any = true
	end
	if not any then
		return nil
	end
	return d
end

function P5.applyDungeon(out, dd)
	if not dd then
		return
	end
	local d = out.Dungeon
	if isFinite(dd.Best) and dd.Best > d.Best then
		d.Best = clampCount(dd.Best, P5.MAX_FLOOR)
	end
	for key, value in pairs(tableOr(dd.Cleared)) do
		local floor = value == true and P5.floorOf(key) or nil
		if floor then
			d.Cleared[floor] = true
			if floor > d.Best then
				d.Best = floor
			end
		end
	end
	if isFinite(dd.Runs) then
		d.Runs = sanitize(d.Runs + dd.Runs) -- never below 0
	end
	if isFinite(dd.ClearsFloor) and dd.ClearsFloor > d.Clears then
		d.Clears = clampCount(dd.ClearsFloor, P5.MAX_FLOOR)
	end
	if isFinite(dd.Clears) then
		d.Clears = sanitize(d.Clears + dd.Clears)
	end
end

-- Berries: a whole number 0..MAX_BERRIES.
function P5.cleanBerries(raw)
	return clampCount(raw, P5.MAX_BERRIES)
end

function P5.newSettings()
	local s = {}
	for _, key in ipairs(P5.SETTING_KEYS) do
		s[key] = P5.SETTING_DEFAULTS[key]
	end
	return s
end

-- One setting's clean value, or nil when `value` is not acceptable for `key` (type -> range; 7.2).
function P5.settingValue(key, value)
	if key == "Music" or key == "Sfx" then
		if isFinite(value) and value >= 0 and value <= P5.MAX_VOLUME and value == math.floor(value) then
			return value
		end
	elseif key == "Gfx" then
		if type(value) == "string" and P5.GFX[value] then
			return value
		end
	elseif key == "Shake" or key == "MouseLock" or key == "FastHatch" then
		if type(value) == "boolean" then
			return value
		end
	elseif key == "SeenNotes" then
		if isFinite(value) and value >= 0 and value <= P5.MAX_NOTES and value == math.floor(value) then
			return value
		end
	end
	return nil
end

-- Untrusted Settings -> a clean table with every key (per-key defaults for a missing or malformed value).
function P5.cleanSettings(raw)
	local r = tableOr(raw)
	local s = P5.newSettings()
	for _, key in ipairs(P5.SETTING_KEYS) do
		local value = P5.settingValue(key, r[key])
		if value ~= nil then
			s[key] = value
		end
	end
	return s
end

function P5.isDefaultSettings(s)
	for _, key in ipairs(P5.SETTING_KEYS) do
		if s[key] ~= P5.SETTING_DEFAULTS[key] then
			return false
		end
	end
	return true
end

function P5.settingsEqual(a, b)
	for _, key in ipairs(P5.SETTING_KEYS) do
		if a[key] ~= b[key] then
			return false
		end
	end
	return true
end

-- 3 empty presets, preset 1 active
function P3.newTeams()
	local presets = {}
	for i = 1, P3.PRESETS do
		presets[i] = {}
	end
	return { Presets = presets, Active = 1 }
end

function P3.newBattle()
	return {
		Trophies = 0,
		TrialBest = 0,
		TrialCleared = {},
		Raids = 0,
		RaidBestDamage = 0,
		PvPWins = 0,
		PvPLosses = 0,
		EventPets = {},
		RaidRewardAt = 0,
		RaidLossAt = 0,
		Duels = {}, -- lobby-shop 16.12
	}
end

local function newProfile()
	return {
		Version = PROFILE_VERSION,
		Tokens = 0,
		Pets = {},
		Equipped = {},
		Items = {},
		Stats = { Matches = 0, Wins = 0, TokensEarned = 0, Spins = 0, BestTimes = {} },
		SpotIndex = nil,
		-- v3 (ARCHITECTURE_V3.md section 1)
		Discovered = {},
		IndexClaimed = {},
		Tutorial = newTutorial(),
		-- Phase 2 (ARCHITECTURE_V3.md "Phase 2 build contract")
		Cash = 0,
		Gems = 0,
		Home = newHome(),
		PetLevels = {},
		Food = {},
		Tiers = {},
		Hybrids = {},
		GemReceipts = {},
		-- Phase 3 (ARCHITECTURE_V3.md "Phase 3 build contract")
		Teams = P3.newTeams(),
		Battle = P3.newBattle(),
		-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" section 4)
		PetGrowth = {},
		Ring = { Best = 0, Runs = 0 },
		Migrations = {},
		-- Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" section 9)
		Dungeon = P5.newDungeon(),
		Berries = 0,
		Settings = P5.newSettings(),
		-- Store build (spec section 6)
		Store = P7.newStore(),
		Daily = P7.newDaily(),
		Trove = {},
		-- lobby shop (spec 5.2): the Secret pity record, the zero record by default
		Pity = P7.cleanPity(nil),
	}
end

-- Untrusted tutorial table -> a clean copy { Step >= 1, Done, Gifted }.
local function cleanTutorial(raw)
	local t = newTutorial()
	if type(raw) == "table" then
		local step = raw.Step
		if isFinite(step) and step >= 1 then
			t.Step = math.min(math.floor(step), MAX_TUTORIAL_STEP)
		end
		t.Done = raw.Done == true
		t.Gifted = raw.Gifted == true
	end
	return t
end

local function tutorialsEqual(a, b)
	return a.Step == b.Step and a.Done == b.Done and a.Gifted == b.Gifted
end

-- Untrusted pet level entry -> { Level >= 1, Xp >= 0 } (a bare number is read as the level), or nil.
local function cleanPetLevel(raw)
	local level, xp
	if type(raw) == "table" then
		level, xp = raw.Level, raw.Xp
	elseif isFinite(raw) then
		level, xp = raw, 0
	else
		return nil
	end
	if not isFinite(level) or level < 1 then
		level = 1
	end
	return { Level = math.min(math.floor(level), MAX_LEVEL), Xp = sanitize(xp) }
end

local function copyPetLevels(map)
	local out = {}
	for id, entry in pairs(tableOr(map)) do
		local clean = validKey(id) and cleanPetLevel(entry)
		if clean then
			out[id] = clean
		end
	end
	return out
end

-- { [validKey] = 1..cap } (zero / junk entries dropped)
local function cleanCounts(raw, cap)
	local out = {}
	for key, value in pairs(tableOr(raw)) do
		if validKey(key) and isFinite(value) then
			local n = clampCount(value, cap)
			if n > 0 then
				out[key] = n
			end
		end
	end
	return out
end

-- Garden / Gym slot id: a whole number 1..MAX_SLOT (also from a numeric string), or a valid string name.
local function slotId(key)
	local n = key
	if type(key) == "string" and string.find(key, "^%d+$") then
		n = tonumber(key)
	end
	if type(n) == "number" then
		if n == n and n >= 1 and n <= MAX_SLOT and n == math.floor(n) then
			return n
		end
		return nil
	end
	if validKey(key) then
		return key
	end
	return nil
end

-- Untrusted slot map (map, list, or a stored array with "" holes) -> { [slot] = key }.
local function cleanSlots(raw)
	local out = {}
	for key, value in pairs(tableOr(raw)) do
		local slot = slotId(key)
		if slot ~= nil and validKey(value) then
			out[slot] = value
		end
	end
	return out
end

-- { [slot] = key } -> a storable / sendable table: an array with "" for empty slots when every slot is a number,
-- otherwise a map with string keys (stores and remotes mangle sparse arrays).
local function encodeSlots(map)
	local allNumbers, maxSlot = true, 0
	for slot in pairs(map) do
		if type(slot) == "number" then
			if slot > maxSlot then
				maxSlot = slot
			end
		else
			allNumbers = false
		end
	end
	local out = {}
	if allNumbers then
		for i = 1, maxSlot do
			out[i] = map[i] or ""
		end
	else
		for slot, key in pairs(map) do
			out[tostring(slot)] = key
		end
	end
	return out
end

local function cleanStations(raw)
	local out = {}
	for key, value in pairs(tableOr(raw)) do
		if validKey(key) and isFinite(value) then
			local level = clampCount(value, MAX_LEVEL)
			if level > 0 then
				out[key] = level
			end
		end
	end
	return out
end

-- Untrusted home -> a clean home (whole numbers). `migrate`: stored data, so the v3 reserve Home.Rooms is folded
-- into Stations (the higher level wins). The live profile is never migrated again: there Rooms IS Stations.
local function cleanHome(raw, migrate)
	local h = tableOr(raw)
	local home = newHome()
	home.Level = clampCount(h.Level, MAX_LEVEL)
	home.Prestige = clampCount(h.Prestige, MAX_LEVEL)
	local stations = h.Stations
	if type(stations) ~= "table" and not migrate then
		stations = h.Rooms -- a live home whose Stations table was dropped: Rooms is the same table
	end
	for key, level in pairs(cleanStations(stations)) do
		home.Stations[key] = level
	end
	if migrate and type(h.Rooms) == "table" and h.Rooms ~= h.Stations then
		for key, level in pairs(cleanStations(h.Rooms)) do
			if level > (home.Stations[key] or 0) then
				home.Stations[key] = level
			end
		end
	end
	home.Garden = cleanSlots(h.Garden)
	home.Gym = cleanSlots(h.Gym)
	home.CollectorCash = sanitizeCash(h.CollectorCash)
	home.LastSeen = sanitizeTime(h.LastSeen)
	-- Phase 4 (veterans): a whole number of garden places >= 1, or nil; true, or nil
	local legacy = h.LegacySlots
	if isFinite(legacy) and legacy >= 1 then
		home.LegacySlots = math.min(math.floor(legacy), MAX_SLOT)
	end
	if h.LegacyPrices == true then
		home.LegacyPrices = true
	end
	-- Phase 5 (the fold): DecorCredit 1..18 or nil; LegacyMagnet 1..5 with the Prestige it was folded at, or nil
	local credit = h.DecorCredit
	if isFinite(credit) and credit >= 1 then
		home.DecorCredit = math.min(math.floor(credit), P5.MAX_DECOR_CREDIT)
	end
	local magnet = h.LegacyMagnet
	if isFinite(magnet) and magnet >= 1 then
		home.LegacyMagnet = math.min(math.floor(magnet), P5.MAX_MAGNET)
		home.LegacyMagnetStar = clampCount(h.LegacyMagnetStar, MAX_LEVEL)
	end
	return home
end

local function homesEqual(a, b)
	return a.Level == b.Level
		and a.Prestige == b.Prestige
		and a.CollectorCash == b.CollectorCash
		and a.LastSeen == b.LastSeen
		and a.LegacySlots == b.LegacySlots
		and a.LegacyPrices == b.LegacyPrices
		and a.DecorCredit == b.DecorCredit
		and a.LegacyMagnet == b.LegacyMagnet
		and a.LegacyMagnetStar == b.LegacyMagnetStar
		and mapsEqual(a.Stations, b.Stations)
		and mapsEqual(a.Garden, b.Garden)
		and mapsEqual(a.Gym, b.Gym)
end

-- what the client sees of a home (CollectorCash / LastSeen changes alone are not worth a snapshot; neither is
-- LegacyPrices alone: it only ever changes together with a Prestige or in the one-time migration before the first
-- snapshot of the session)
local function homeVisiblyEqual(a, b)
	return a.Level == b.Level
		and a.Prestige == b.Prestige
		and a.LegacySlots == b.LegacySlots
		and mapsEqual(a.Stations, b.Stations)
		and mapsEqual(a.Garden, b.Garden)
		and mapsEqual(a.Gym, b.Gym)
end

-- { [petId] = { Golden = n, Rainbow = n } } with positive counts only
local function cleanTiers(raw)
	local out = {}
	local cap = Config.Pets.MaxPerStack
	for petId, entry in pairs(tableOr(raw)) do
		if validKey(petId) and type(entry) == "table" then
			local clean = nil
			for _, tier in ipairs(TIER_NAMES) do
				local n = isFinite(entry[tier]) and clampCount(entry[tier], cap) or 0
				if n > 0 then
					clean = clean or {}
					clean[tier] = n
				end
			end
			if clean then
				out[petId] = clean
			end
		end
	end
	return out
end

-- One fused hybrid record { Body, Style, Elements, Name?, Rarity?, Tier, SpecialFrom? } (+ up to 8 extra scalar fields the
-- fusion code may keep, e.g. a look seed), or nil. Lenient on purpose: the store keeps what the game made. Elements keep
-- their order (Elements[1] = the normal attack's parent). SpecialFrom (gui-redo) is a known field, kept only when it is
-- exactly "Style" (anything else = the Body, dropped) and never counted as an extra.
local function cleanHybrid(raw)
	if type(raw) ~= "table" or not validKey(raw.Body) or not validKey(raw.Style) then
		return nil
	end
	local rec = { Body = raw.Body, Style = raw.Style, Elements = {}, Tier = "Normal" }
	if VALID_TIER[raw.Tier] then
		rec.Tier = raw.Tier
	end
	if raw.SpecialFrom == "Style" then
		rec.SpecialFrom = "Style"
	end
	local seen = {}
	for _, e in ipairs(tableOr(raw.Elements)) do
		if validKey(e) and not seen[e] and #rec.Elements < 4 then
			seen[e] = true
			rec.Elements[#rec.Elements + 1] = e
		end
	end
	if type(raw.Name) == "string" and #raw.Name >= 1 and #raw.Name <= 32 then
		rec.Name = raw.Name
	end
	if validKey(raw.Rarity) then
		rec.Rarity = raw.Rarity
	end
	local extras = 0
	for k, v in pairs(raw) do
		if rec[k] == nil and k ~= "Name" and k ~= "Rarity" and k ~= "SpecialFrom" and type(k) == "string" and #k <= 24 and extras < 8 then
			if isFinite(v) or type(v) == "boolean" or (type(v) == "string" and #v <= 64) then
				rec[k] = v
				extras = extras + 1
			end
		end
	end
	return rec
end

local function cleanHybrids(raw)
	local out = {}
	for uid, rec in pairs(tableOr(raw)) do
		local clean = validUid(uid) and cleanHybrid(rec)
		if clean then
			out[uid] = clean
		end
	end
	return out
end

-- Trims a receipt map (in place) to MAX_RECEIPTS entries by evicting the oldest ones (ties: the smaller id).
-- Ids in `keep` (the receipts just processed) are never evicted, so a fresh receipt always survives its own save.
local function trimReceipts(map, keep)
	local list = {}
	local total = 0
	for id, t in pairs(map) do
		total = total + 1
		if not (keep and keep[id]) then
			list[#list + 1] = { Id = id, T = t }
		end
	end
	if total <= MAX_RECEIPTS then
		return map
	end
	table.sort(list, function(a, b)
		if a.T ~= b.T then
			return a.T < b.T
		end
		return a.Id < b.Id
	end)
	local i = 1
	while total > MAX_RECEIPTS and list[i] do
		map[list[i].Id] = nil
		total = total - 1
		i = i + 1
	end
	return map
end

-- { [purchaseId] = os.time() of processing } (a stored `true` counts as time 0). `trim`: bounded to MAX_RECEIPTS
-- (stored data); the live map is bounded by MarkReceipt and copied whole, so a fresh receipt always reaches the delta.
local function cleanReceipts(raw, trim)
	local out = {}
	for id, value in pairs(tableOr(raw)) do
		if validKey(id) then
			if value == true then
				out[id] = 0
			elseif isFinite(value) then
				out[id] = sanitizeTime(value)
			end
		end
	end
	if trim then
		trimReceipts(out)
	end
	return out
end

-- Set-like map { [key] = true } with valid keys only (a stored list of ids is accepted as well).
local function cleanSet(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, value in pairs(raw) do
		if validKey(key) and value == true then
			out[key] = true
		elseif type(key) == "number" and validKey(value) then
			out[value] = true
		end
	end
	return out
end

-- Every owned pet counts as discovered (v3 migration rule, kept as an invariant): Normal copies and tier copies.
local function discoverOwned(profile)
	for id, count in pairs(profile.Pets) do
		if validKey(id) and type(count) == "number" and count > 0 then
			profile.Discovered[id] = true
		end
	end
	for id in pairs(tableOr(profile.Tiers)) do
		if validKey(id) then
			profile.Discovered[id] = true
		end
	end
end

-- copies of `key` the profile owns (PetKeys.Count; plain Pets counts without that module)
local function ownedCount(profile, key)
	local keys = getPetKeys()
	if keys and type(keys.Count) == "function" then
		local ok, n = pcall(keys.Count, profile, key)
		if ok and type(n) == "number" then
			return n
		end
		return 0
	end
	local pets = tableOr(profile.Pets)
	local n = pets[key]
	if type(n) == "number" then
		return n
	end
	return 0
end

-- A save without B4TeamFollow: its own Equipped list is the migration's input (P3.teamMigrate), cleaned here. Drops
-- equipped keys that are not owned, are over their owned count, exceed the slot limit, or (Phase 4) are in training (a
-- Phase 3 server may have equipped one during the rollout). Runs after Pets, Tiers, Hybrids AND PetGrowth are final: tier
-- and hybrid copies count too, and the training lock reads the clean growth map. Bug batch 2 #18: copies working in the
-- Garden / Gym of profile.Home cannot follow (open places only: a copy resting on a closed one may, P3.placedCopies;
-- normalizeProfile calls this before its Home is read, so a stored overlap is left to P3.gardenSolo there, which keeps
-- the pet equipped and takes it out of the Garden).
local function normalizeEquipped(profile)
	local out = {}
	local used = {}
	local maxEquipped = Config.Pets.MaxEquipped
	local training = P4.trainingSet(profile.PetGrowth)
	local placed = P3.placedCopies(profile)
	for _, id in ipairs(profile.Equipped) do
		if type(id) == "string" and #out < maxEquipped and not training[id] then
			local owned = ownedCount(profile, id) - (placed[id] or 0)
			local count = used[id] or 0
			if count < owned then
				used[id] = count + 1
				table.insert(out, id)
			end
		end
	end
	profile.Equipped = out
end

----------------------------------------------------------------------
-- Phase 3: battle teams + the battle record (pure helpers; they run inside UpdateAsync too)
----------------------------------------------------------------------

-- true for a key a team may hold: a valid key that PetKeys reads as a canonical key (without PetKeys: any valid key)
function P3.teamKey(key)
	if not validKey(key) then
		return false
	end
	local keys = getPetKeys()
	if keys and type(keys.Parse) == "function" then
		local ok, parsed = pcall(keys.Parse, key)
		return ok and parsed ~= nil
	end
	return true
end

-- Untrusted preset -> the keys of its slots 1..MAX_SLOTS in order, each once ("" / false / junk entries are skipped,
-- so the pets behind an empty slot move up).
function P3.cleanPreset(raw)
	local out, seen = {}, {}
	if type(raw) ~= "table" then
		return out
	end
	for i = 1, P3.MAX_SLOTS do
		local key = raw[i]
		if P3.teamKey(key) and not seen[key] then
			seen[key] = true
			out[#out + 1] = key
		end
	end
	return out
end

-- Untrusted Teams -> { Presets = { [1..PRESETS] = {key...} }, Active = 1..PRESETS }: the structure only (ownership is
-- P3.prune's job). Migration: a Phase 2 profile has no Teams, or the empty reserve -> the defaults; a bare list of
-- presets ({ {keys}, ... }) or of keys ({ key, ... } = preset 1) is read leniently.
function P3.cleanTeams(raw)
	local teams = P3.newTeams()
	if type(raw) ~= "table" then
		return teams
	end
	local presets = raw.Presets
	if type(presets) ~= "table" then
		if type(raw[1]) == "table" then
			presets = raw
		elseif type(raw[1]) == "string" then
			presets = { raw }
		else
			presets = {}
		end
	end
	for i = 1, P3.PRESETS do
		local list = presets[i]
		if list == nil then
			list = presets[tostring(i)]
		end
		teams.Presets[i] = P3.cleanPreset(list)
	end
	local active = raw.Active
	if isFinite(active) and active >= 1 and active <= P3.PRESETS and active == math.floor(active) then
		teams.Active = active
	end
	return teams
end

-- Team slots of any profile-like table: 3 always (Phase 5, 4.8: slot 1 = the fighter, 2-3 = the helpers; the Phase 3
-- prestige unlock of a 4th slot is gone).
function P3.slotsOf(_)
	return P3.SLOTS
end

-- { [key] = copies working in the Garden or the Gym } (those copies can neither follow nor fight). Live slot maps or
-- stored arrays (""). Bug batch 2 #18 ("Remote recall"): the Garden counts again (Phase 4 had dropped it: "a garden
-- pet earns at home while it follows you and fights"); a garden pet is busy gardening. Training stays a read-time
-- filter, never a prune. Home.Gym is emptied by the one-time Phase 4 migration (kept so Phase 3 writes during the
-- rollout stay understood). A CLOSED garden place does not count (P3.closedSlot: a copy resting there earns nothing,
-- so it is not busy; it may follow and fight, and leaves that place silently when it does).
function P3.placedCopies(profile)
	local out = {}
	local home = type(profile) == "table" and profile.Home or nil
	if type(home) ~= "table" then
		return out
	end
	local open = P3.gardenOpen(home)
	for slot, key in pairs(tableOr(home.Garden)) do
		if type(key) == "string" and key ~= "" and not P3.closedSlot(slot, open) then
			out[key] = (out[key] or 0) + 1
		end
	end
	for _, key in pairs(tableOr(home.Gym)) do
		if type(key) == "string" and key ~= "" then
			out[key] = (out[key] or 0) + 1
		end
	end
	return out
end

-- Bug batch 2 #18 follow-up: the open garden places of a home (TycoonCatalog.GardenSlots: 3 + 1 per Prestige star, or
-- the veteran's LegacySlots), or nil when that cannot be told (no catalog, or no Garden built: then no place counts as
-- closed, the safe side of the lock).
function P3.gardenOpen(home)
	local catalog = getTycoonCatalog()
	if type(home) ~= "table" or not catalog or type(catalog.GardenSlots) ~= "function" then
		return nil
	end
	local ok, open = pcall(catalog.GardenSlots, home)
	if ok and isFinite(open) and open >= 1 then
		return math.floor(open)
	end
	return nil
end

-- true for a numbered garden place ABOVE the open count (`open` from P3.gardenOpen): a Prestige closed it (the
-- veteran's LegacySlots ended), the pet sleeps on it ("Prestige to open") and earns nothing. Stored arrays and
-- string slot names ("5") read through slotId; a named slot is never closed.
function P3.closedSlot(slot, open)
	local id = slotId(slot)
	return open ~= nil and type(id) == "number" and id > open
end

-- Bug batch 2 #18, old saves (the Phase 4 rule let a Garden pet follow and fight): every key whose copies cannot cover
-- both its Garden places and its other jobs (the equipped copies, or 1 when a preset lists it) LEAVES the Garden
-- (its highest places first) until they do: the pet stays equipped / in its team, no team is emptied. Edits the clean
-- profile in place (Home.Garden keyed by slot, Equipped, Teams clean); deterministic, and a no-op without an overlap
-- (so it never loops). Returns the keys that left an OPEN place (sorted; they get the toast), or nil when none did.
-- Closed places (P3.closedSlot) go first and silently: a copy resting there is not busy (P3.placedCopies skips it),
-- so the pet just leaves that bed, the same as TycoonService's live release after an equip / team change. A save with
-- B4TeamFollow keeps its OPEN overlaps: the pet is busy gardening and keeps its team slot (P3.soloPlan).
function P3.gardenSolo(profile)
	local plan = P3.soloPlan(profile)
	if not plan then
		return nil
	end
	local garden = profile.Home.Garden
	for _, slot in ipairs(plan.Closed) do
		garden[slot] = nil
	end
	for _, slot in ipairs(plan.Open) do
		garden[slot] = nil
	end
	if #plan.Moved == 0 then
		return nil
	end
	return plan.Moved
end

-- The Garden places of a profile whose copy also follows the player / sits in a preset (see P3.gardenSolo), without
-- changing anything: { Closed = {slot...}, Open = {slot...}, Moved = {key...} (the keys of Open, sorted) }, or nil
-- when there is no overlap. Closed places are freed first. The live profile never has an Open overlap (the lock), so
-- DataService.ClosedBedOverlap reads only Closed.
function P3.soloPlan(profile)
	local home = type(profile) == "table" and profile.Home or nil
	local garden = type(home) == "table" and home.Garden or nil
	if type(garden) ~= "table" or next(garden) == nil then
		return nil
	end
	local teamModel = tableOr(profile.Migrations)[P3.MARK_TEAM] == true
	local need = {}
	for _, key in ipairs(tableOr(profile.Equipped)) do
		if type(key) == "string" then
			need[key] = (need[key] or 0) + 1
		end
	end
	local presets = type(profile.Teams) == "table" and profile.Teams.Presets or nil
	for _, list in pairs(tableOr(presets)) do
		for _, key in ipairs(tableOr(list)) do
			if type(key) == "string" and (need[key] or 0) < 1 then
				need[key] = 1
			end
		end
	end
	local open = P3.gardenOpen(home)
	local slotsOf, closedOf = {}, {}
	for slot, key in pairs(garden) do
		if type(key) == "string" and key ~= "" and need[key] then
			local byKey = P3.closedSlot(slot, open) and closedOf or slotsOf
			local list = byKey[key]
			if not list then
				list = {}
				byKey[key] = list
			end
			list[#list + 1] = slot
		end
	end
	if next(slotsOf) == nil and next(closedOf) == nil then
		return nil
	end
	local gym = {}
	for _, key in pairs(tableOr(home.Gym)) do
		if type(key) == "string" and key ~= "" then
			gym[key] = (gym[key] or 0) + 1
		end
	end
	local function highestFirst(a, b)
		if type(a) == type(b) then
			return a > b
		end
		return type(a) == "string" -- named slots go first, then the highest numbers
	end
	local plan = { Closed = {}, Open = {}, Moved = {} }
	for key in pairs(need) do
		local slots, closed = slotsOf[key] or {}, closedOf[key] or {}
		if #slots > 0 or #closed > 0 then
			table.sort(slots, highestFirst)
			table.sort(closed, highestFirst)
			local owned = ownedCount(profile, key) - (gym[key] or 0)
			local want = math.min(need[key], owned) -- (a key owned too rarely is the prune's job, not the Garden's)
			local free = owned - #slots - #closed
			-- closed places first (silent: the copy resting there is not busy), then the open ones (the old-save repair)
			local i = 1
			while free < want and closed[i] ~= nil do
				plan.Closed[#plan.Closed + 1] = closed[i]
				free = free + 1
				i = i + 1
			end
			i = 1
			while not teamModel and free < want and slots[i] ~= nil do
				plan.Open[#plan.Open + 1] = slots[i]
				free = free + 1
				i = i + 1
			end
			if i > 1 then
				plan.Moved[#plan.Moved + 1] = key
			end
		end
	end
	if #plan.Closed == 0 and #plan.Open == 0 then
		return nil
	end
	table.sort(plan.Closed)
	table.sort(plan.Moved)
	return plan
end

-- Drops (in place) every key not owned at all and every key past the profile's team slots. A busy key (every copy in
-- the Garden / Gym, or training) KEEPS its slot. `teams` is a clean Teams table; `profile` any profile-like table whose
-- copies decide (the live profile, a clean copy or a merged record). Returns true when something was dropped.
function P3.prune(profile, teams)
	local slots = P3.slotsOf(profile)
	local changed = false
	for i = 1, P3.PRESETS do
		local list = teams.Presets[i]
		local kept = {}
		for _, key in ipairs(list) do
			if ownedCount(profile, key) >= 1 and #kept < slots then
				kept[#kept + 1] = key
			end
		end
		if #kept ~= #list then
			teams.Presets[i] = kept
			changed = true
		end
	end
	return changed
end

-- A clean, pruned copy of a profile's Teams.
function P3.teamsOf(profile)
	local teams = P3.cleanTeams(type(profile) == "table" and profile.Teams or nil)
	P3.prune(profile, teams)
	return teams
end

-- { [key] = "Training" | "Garden" } of a profile: every key with a running Job, every owned key with no copy free of
-- the Garden / Gym (open places only, P3.placedCopies). Such a key keeps its team slot, but neither follows nor fights.
function P3.busyOf(profile)
	local out = {}
	for key, n in pairs(P3.placedCopies(profile)) do
		local owned = ownedCount(profile, key)
		if owned >= 1 and owned - n < 1 then
			out[key] = "Garden"
		end
	end
	for key in pairs(P4.trainingSet(profile.PetGrowth)) do
		out[key] = "Training"
	end
	return out
end

-- true unless PetKeys knows no such pet (one that left the catalog, a hybrid whose record is gone): it never follows.
function P3.knownPet(profile, key)
	local keys = getPetKeys()
	if keys and type(keys.DefOf) == "function" then
		local ok, def = pcall(keys.DefOf, key, profile)
		return ok and def ~= nil
	end
	return true
end

-- The invariant's right side: the active preset minus its busy keys, in slot order -> keys, the whole preset.
function P3.activeKeys(profile)
	local teams = P3.teamsOf(profile)
	local busy = P3.busyOf(profile)
	local preset = teams.Presets[teams.Active]
	local out = {}
	for _, key in ipairs(preset) do
		if not busy[key] and P3.knownPet(profile, key) then
			out[#out + 1] = key
		end
	end
	return out, preset
end

-- Rewrites profile.Equipped from the invariant; a save without B4TeamFollow keeps its own cleaned list
-- (the migration's input). Pure: it also runs inside UpdateAsync. Returns true when Equipped changed.
function P3.syncEquipped(profile)
	local before = copyList(tableOr(profile.Equipped))
	local want = nil
	if tableOr(profile.Migrations)[P3.MARK_TEAM] == true then
		want = P3.activeKeys(profile)
	else
		profile.Equipped = copyList(before)
		normalizeEquipped(profile)
		want = profile.Equipped
	end
	if listsEqual(before, want) then
		return false
	end
	profile.Equipped = copyList(want)
	return true
end

function P3.isDefaultTeams(teams)
	if teams.Active ~= 1 then
		return false
	end
	for i = 1, P3.PRESETS do
		if #teams.Presets[i] > 0 then
			return false
		end
	end
	return true
end

-- clean Teams -> the stored / synced form (Presets as a dense array of PRESETS lists)
function P3.encodeTeams(teams)
	local presets = {}
	for i = 1, P3.PRESETS do
		presets[i] = copyList(teams.Presets[i])
	end
	return { Presets = presets, Active = teams.Active }
end

-- A cleared trial level: a whole number 1..MAX_TRIAL_LEVEL (a numeric string too), or nil.
function P3.trialLevel(value)
	local n = value
	if type(value) == "string" and string.find(value, "^%d+$") then
		n = tonumber(value)
	end
	if isFinite(n) and n >= 1 and n <= P3.MAX_TRIAL_LEVEL and n == math.floor(n) then
		return n
	end
	return nil
end

-- Untrusted cleared set: { [level] = true }, the stored / synced dense array of booleans (false = not cleared) or a
-- list of level numbers -> { [level] = true }.
function P3.cleanCleared(raw)
	local out = {}
	for key, value in pairs(tableOr(raw)) do
		local level = nil
		if value == true then
			level = P3.trialLevel(key)
		elseif type(key) == "number" and type(value) == "number" then
			level = P3.trialLevel(value)
		end
		if level then
			out[level] = true
		end
	end
	return out
end

-- lobby-shop 16.12: one duel entry { U, T } (U a whole UserId 1..MAX_USER_ID, T whole Unix seconds > 0) or nil
function P3.duelEntry(e)
	if type(e) ~= "table" then
		return nil
	end
	local u, t = e.U, e.T
	if not isFinite(u) or u < 1 or u > P3.MAX_USER_ID or u ~= math.floor(u) or not isFinite(t) or t <= 0 then
		return nil
	end
	t = sanitizeTime(t)
	if t <= 0 then
		return nil
	end
	return { U = u, T = t }
end

-- Untrusted Duels -> a list of clean entries, duplicates (same U and T) once, newest first (ties: the higher U first),
-- bounded (lobby-shop 16.13 review fix 6): every entry inside the pair window (T >= os.time() - DUELS_WINDOW) is kept,
-- plus at most DUELS_KEEP older ones, and never more than DUELS_MAX in all (the oldest dropped), so a burst of duels with
-- other opponents cannot push a pair's recent duels out. An old save without the field reads {}.
function P3.cleanDuels(raw)
	local out, seen = {}, {}
	if type(raw) ~= "table" then
		return out
	end
	for _, e in pairs(raw) do
		local d = P3.duelEntry(e)
		local key = d and (tostring(d.U) .. ":" .. tostring(d.T))
		if d and not seen[key] then
			seen[key] = true
			out[#out + 1] = d
		end
	end
	table.sort(out, function(x, y)
		if x.T ~= y.T then
			return x.T > y.T
		end
		return x.U > y.U
	end)
	local since = os.time() - P3.DUELS_WINDOW
	local kept, older = {}, 0
	for _, d in ipairs(out) do
		if #kept >= P3.DUELS_MAX then
			break
		end
		if d.T >= since then
			kept[#kept + 1] = d
		elseif older < P3.DUELS_KEEP then
			older = older + 1
			kept[#kept + 1] = d
		end
	end
	return kept
end

function P3.duelsEqual(a, b)
	if #a ~= #b then
		return false
	end
	for i = 1, #a do
		if a[i].U ~= b[i].U or a[i].T ~= b[i].T then
			return false
		end
	end
	return true
end

-- Untrusted Battle -> a clean record: whole numbers >= 0, TrialBest >= the highest cleared level.
function P3.cleanBattle(raw)
	local r = tableOr(raw)
	local battle = P3.newBattle()
	for _, field in ipairs(P3.COUNTERS) do
		battle[field] = sanitize(r[field])
	end
	battle.RaidBestDamage = sanitize(r.RaidBestDamage)
	battle.RaidRewardAt = sanitizeTime(r.RaidRewardAt)
	battle.RaidLossAt = sanitizeTime(r.RaidLossAt)
	battle.TrialBest = clampCount(r.TrialBest, P3.MAX_TRIAL_LEVEL)
	battle.TrialCleared = P3.cleanCleared(r.TrialCleared)
	for level in pairs(battle.TrialCleared) do
		if level > battle.TrialBest then
			battle.TrialBest = level
		end
	end
	battle.EventPets = cleanSet(r.EventPets)
	battle.Duels = P3.cleanDuels(r.Duels)
	return battle
end

-- { [field] = true } of the fields that differ between two clean records
function P3.battleChanges(a, b)
	local out = {}
	for _, field in ipairs(P3.COUNTERS) do
		if a[field] ~= b[field] then
			out[field] = true
		end
	end
	for _, field in ipairs(P3.BESTS) do
		if a[field] ~= b[field] then
			out[field] = true
		end
	end
	if not mapsEqual(a.TrialCleared, b.TrialCleared) then
		out.TrialCleared = true
	end
	if not mapsEqual(a.EventPets, b.EventPets) then
		out.EventPets = true
	end
	if not P3.duelsEqual(a.Duels or {}, b.Duels or {}) then
		out.Duels = true
	end
	return out
end

function P3.isDefaultBattle(battle)
	return next(P3.battleChanges(battle, P3.newBattle())) == nil
end

-- clean Battle -> the stored / synced form: TrialCleared as a dense array of booleans (index = level, never sparse)
function P3.encodeBattle(battle)
	local cleared, top = {}, 0
	for level in pairs(battle.TrialCleared) do
		if level > top then
			top = level
		end
	end
	for level = 1, top do
		cleared[level] = battle.TrialCleared[level] == true
	end
	-- lobby-shop 16.12: the duel record only when it holds something (an old save stays as it was until a duel)
	local duels = nil
	if type(battle.Duels) == "table" and #battle.Duels > 0 then
		duels = {}
		for i, e in ipairs(battle.Duels) do
			duels[i] = { U = e.U, T = e.T }
		end
	end
	return {
		Trophies = battle.Trophies,
		TrialBest = battle.TrialBest,
		TrialCleared = cleared,
		Raids = battle.Raids,
		RaidBestDamage = battle.RaidBestDamage,
		PvPWins = battle.PvPWins,
		PvPLosses = battle.PvPLosses,
		EventPets = copyMap(battle.EventPets),
		RaidRewardAt = battle.RaidRewardAt,
		RaidLossAt = battle.RaidLossAt,
		Duels = duels,
	}
end

-- the snapshot's Battle (ProfileSync): the stored form without the duel record (opponents' ids stay on the server)
function P3.syncBattle(raw)
	local out = P3.encodeBattle(P3.cleanBattle(raw))
	out.Duels = nil
	return out
end

----------------------------------------------------------------------
-- Phase 4: pet growth (evolution stages + training ranks + the running job), the Champion Ring record and the
-- migration markers (pure helpers; they run inside UpdateAsync too). The format rules (ARCHITECTURE_V3.md "Phase 4
-- build contract" 4.1 / 4.2) are in the header.
----------------------------------------------------------------------

-- a growth entry with every number 0 and no Job
function P4.zeroEntry()
	local e = { Evo = 0 }
	for _, stat in ipairs(P4.STATS) do
		e[stat] = 0
	end
	return e
end

-- Untrusted Job -> a clean job for an entry whose ranks are final, or nil (dropped): Stat one of the four skills,
-- Ends a sane os.time() stamp > 0, Rank EXACTLY the stat's rank + 1 (a job whose target rank is not above the stored
-- rank was completed elsewhere and must never re-apply; a target further above cannot happen; rank 10 is the top),
-- Slot a Training Place mat 1..MAX_JOB_SLOT, From a short string (optional), Paid whole Cash >= 0 (the Stop refund).
function P4.cleanJob(raw, entry)
	if type(raw) ~= "table" then
		return nil
	end
	local stat = raw.Stat
	if not P4.STAT_SET[stat] then
		return nil
	end
	local target = entry[stat] + 1
	local rank = raw.Rank
	if not isFinite(rank) or math.floor(rank) ~= target or target > P4.MAX_RANK then
		return nil
	end
	local ends = sanitizeTime(raw.Ends)
	if ends <= 0 then
		return nil
	end
	local slot = raw.Slot
	if not isFinite(slot) or slot < 1 or slot > P4.MAX_JOB_SLOT or slot ~= math.floor(slot) then
		return nil
	end
	local job = { Stat = stat, Ends = ends, Rank = target, Slot = slot, Paid = sanitizeCash(raw.Paid) }
	if type(raw.From) == "string" and #raw.From >= 1 and #raw.From <= P4.MAX_FROM then
		job.From = raw.From
	end
	return job
end

-- Untrusted growth entry -> { Evo 0..2, Speed, Physique, Ability, Defense 0..10, Job? } (fresh tables), or nil for
-- junk and for an entry that is all zeros without a Job (keeps the save small).
function P4.cleanEntry(raw)
	if type(raw) ~= "table" then
		return nil
	end
	local e = P4.zeroEntry()
	e.Evo = clampCount(raw.Evo, P4.MAX_EVO)
	local any = e.Evo > 0
	for _, stat in ipairs(P4.STATS) do
		local rank = clampCount(raw[stat], P4.MAX_RANK)
		e[stat] = rank
		any = any or rank > 0
	end
	local job = P4.cleanJob(raw.Job, e)
	if job then
		e.Job = job
		any = true
	end
	if not any then
		return nil
	end
	return e
end

-- Untrusted PetGrowth map (live, stored or synced) -> { [validKey] = clean entry }
function P4.cleanGrowth(raw)
	local out = {}
	for key, entry in pairs(tableOr(raw)) do
		local clean = validKey(key) and P4.cleanEntry(entry)
		if clean then
			out[key] = clean
		end
	end
	return out
end

-- clean growth -> the stored / synced form: zero numbers left out (every reader fills them: cleanEntry here,
-- State.PetGrowth on the client), the Job copied. ~80 bytes per fully trained, evolved key.
function P4.encodeGrowth(growth)
	local out = {}
	for key, e in pairs(growth) do
		local rec = {}
		if e.Evo > 0 then
			rec.Evo = e.Evo
		end
		for _, stat in ipairs(P4.STATS) do
			if e[stat] > 0 then
				rec[stat] = e[stat]
			end
		end
		if e.Job then
			rec.Job = copyMap(e.Job)
		end
		out[key] = rec
	end
	return out
end

-- { [key] = true } of every key with a running job: the training lock. Any growth map (live, clean or stored); junk
-- is ignored (a junk job never survives a clean anyway).
function P4.trainingSet(growth)
	local out = {}
	for key, entry in pairs(tableOr(growth)) do
		if validKey(key) and type(entry) == "table" and type(entry.Job) == "table" and P4.STAT_SET[entry.Job.Stat] then
			out[key] = true
		end
	end
	return out
end

-- The PetGrowth delta (both clean), or nil: every changed key -> its whole clean live entry, where Job is the live
-- job when the session changed it, `false` when the session cleared a job the base had, and absent when the session
-- left it alone (the stored job then stays: a job another server started is never wiped by a session that never saw
-- it); a key the session removed -> false.
function P4.diffGrowth(live, base)
	local out, any = {}, false
	for key, e in pairs(live) do
		local b = base[key]
		if b == nil or not deepEqual(e, b) then
			local d = P4.zeroEntry()
			d.Evo = e.Evo
			for _, stat in ipairs(P4.STATS) do
				d[stat] = e[stat]
			end
			local liveJob, baseJob = e.Job, b and b.Job or nil
			if liveJob then
				if not (baseJob and deepEqual(liveJob, baseJob)) then
					d.Job = copyMap(liveJob)
				end
			elseif baseJob then
				d.Job = false
				d.JobDone = { Stat = baseJob.Stat, Rank = baseJob.Rank } -- WHICH job ended (P4.newerJob keeps a newer stored one)
			end
			out[key] = d
			any = true
		end
	end
	for key in pairs(base) do
		if live[key] == nil then
			out[key] = false
			any = true
		end
	end
	if not any then
		return nil
	end
	return out
end

-- true when the STORED job `cur` is a newer job of the same key than `ref` (the job a session ended or started): the
-- same skill at a higher target rank. Two servers holding one player (the rollout minutes, an outage's late leave
-- save) can race: server B completes Speed 2 -> 3 and starts 3 -> 4 while server A's later save still ends the 2 -> 3
-- job (or starts its own stale 2 -> 3): A must not wipe B's paid rank-4 job. A job of another skill, or at the same /
-- a lower target, is the same job or an older one and follows the session's value (the sanitizer then drops it when
-- it is stale).
function P4.newerJob(cur, ref)
	return type(cur) == "table" and type(ref) == "table" and cur.Stat == ref.Stat and isFinite(cur.Rank) and isFinite(ref.Rank) and cur.Rank > ref.Rank
end

-- Per key: Evo and every rank keep the HIGHER value (a rank is a target value: two servers completing one job give
-- one rank), the Job follows the delta (a table replaces, false + JobDone clears, absent keeps the stored one; a
-- stored job that is NEWER than the one the session ended or started survives, P4.newerJob), a key marked false goes;
-- then the map is cleaned: a Job whose target rank is not above the merged rank (completed elsewhere) is dropped and
-- empty entries go.
function P4.applyGrowth(out, dg)
	if not dg then
		return
	end
	local map = out.PetGrowth
	for key, d in pairs(dg) do
		if d == false then
			map[key] = nil
		elseif type(d) == "table" then
			local cur = map[key] or P4.zeroEntry()
			cur.Evo = math.max(cur.Evo, clampCount(d.Evo, P4.MAX_EVO))
			for _, stat in ipairs(P4.STATS) do
				cur[stat] = math.max(cur[stat], clampCount(d[stat], P4.MAX_RANK))
			end
			if d.Job == false then
				if not P4.newerJob(cur.Job, d.JobDone) then
					cur.Job = nil
				end
			elseif type(d.Job) == "table" then
				if not P4.newerJob(cur.Job, d.Job) then
					cur.Job = copyMap(d.Job)
				end
			end
			map[key] = cur
		end
	end
	out.PetGrowth = P4.cleanGrowth(map)
end

-- Untrusted ring record -> { Best = 0..MAX_RING, Runs >= 0 } (whole numbers)
function P4.cleanRing(raw)
	local r = tableOr(raw)
	return { Best = clampCount(r.Best, P4.MAX_RING), Runs = sanitize(r.Runs) }
end

function P4.isDefaultRing(ring)
	return ring.Best == 0 and ring.Runs == 0
end

-- The Ring delta (both clean), or nil: Best as a candidate when it rose, Runs as a +/- delta.
function P4.diffRing(live, base)
	local d, any = { Best = nil, Runs = nil }, false
	if live.Best > base.Best then
		d.Best = live.Best
		any = true
	end
	if live.Runs ~= base.Runs then
		d.Runs = live.Runs - base.Runs
		any = true
	end
	if not any then
		return nil
	end
	return d
end

function P4.applyRing(out, dr)
	if not dr then
		return
	end
	local ring = out.Ring
	if isFinite(dr.Best) and dr.Best > ring.Best then
		ring.Best = clampCount(dr.Best, P4.MAX_RING)
	end
	if isFinite(dr.Runs) then
		ring.Runs = sanitize(ring.Runs + dr.Runs) -- never below 0
	end
end

-- Live (possibly messy) profile -> clean profile with whole numbers. Read defensively: other modules mutate it.
----------------------------------------------------------------------
-- Store build (P7): the Store / Daily / Trove records, their deltas and merges, the grant records of the twin rules
----------------------------------------------------------------------

function P7.newStore()
	return { Bought = {}, Passes = {}, Boosts = {} }
end

function P7.newDaily()
	return { Streak = 0, Paid = 0, LastClaimAt = 0, Weeks = 0, Pet = false, PlayStart = 0, PlaySec = 0, PlayClaimed = {}, ClampFrom = 0, ClampAt = 0, ClampJob = "" }
end

-- The server of a Z8 first sight (its game.JobId, re-review 3): a short string of letters, digits and dashes, else ""
-- (none / unknown).
function P7.jobOf(value)
	if type(value) == "string" and #value <= 64 and string.find(value, "^[%w%-]*$") then
		return value
	end
	return ""
end

-- Config.Daily is read lazily (the spec's numbers; the defaults when an older Config lacks the table).
function P7.dailyNumber(key, sub, default)
	local daily = Config.Daily
	local holder = type(daily) == "table" and (sub and daily[sub] or daily) or nil
	local value = type(holder) == "table" and holder[key] or nil
	if isFinite(value) and value > 0 then
		return value
	end
	return default
end

function P7.readySeconds()
	return P7.dailyNumber("ReadySeconds", nil, 72000)
end

function P7.futureSlack()
	return P7.dailyNumber("FutureClockSlack", nil, 300)
end

function P7.maxDaySeconds()
	return P7.dailyNumber("MaxDaySeconds", "Play", 36000)
end

-- { [key] = Unix seconds } with valid keys and sane clocks (a stored `true` counts as time 0).
function P7.cleanClocks(raw)
	local out = {}
	for key, value in pairs(tableOr(raw)) do
		if validKey(key) then
			if value == true then
				out[key] = 0
			elseif isFinite(value) then
				out[key] = sanitizeTime(value)
			end
		end
	end
	return out
end

-- Untrusted Store -> a clean record (Bought / Passes = the Unix time of the first mark, Boosts = the potion ends).
function P7.cleanStore(raw)
	local r = tableOr(raw)
	local s = P7.newStore()
	for _, key in ipairs(P7.STORE_MAPS) do
		s[key] = P7.cleanClocks(r[key])
	end
	return s
end

function P7.isDefaultStore(s)
	for _, key in ipairs(P7.STORE_MAPS) do
		if next(s[key]) ~= nil then
			return false
		end
	end
	return true
end

-- Clean store -> the stored form (an empty map left out).
function P7.encodeStore(s)
	local rec = {}
	for _, key in ipairs(P7.STORE_MAPS) do
		if next(s[key]) ~= nil then
			rec[key] = copyMap(s[key])
		end
	end
	return rec
end

-- A play tier: a whole number 1..MAX_TIER (a numeric string too), or nil.
function P7.tierOf(value)
	local n = value
	if type(value) == "string" and string.find(value, "^%d+$") then
		n = tonumber(value)
	end
	if isFinite(n) and n >= 1 and n <= P7.MAX_TIER and n == math.floor(n) then
		return n
	end
	return nil
end

-- Untrusted Daily -> a clean record (whole numbers >= 0, clocks capped at MAX_TIME, Pet a boolean, PlaySec
-- 0..MaxDaySeconds, PlayClaimed a set from a set or from the stored dense boolean array).
function P7.cleanDaily(raw)
	local r = tableOr(raw)
	local d = P7.newDaily()
	for _, key in ipairs(P7.DAILY_NUMBERS) do
		d[key] = clampCount(r[key], P7.MAX_STREAK)
	end
	for _, key in ipairs(P7.DAILY_CLOCKS) do
		d[key] = sanitizeTime(r[key])
	end
	d.ClampJob = (d.ClampFrom > 0 and d.ClampAt > 0) and P7.jobOf(r.ClampJob) or ""
	d.Pet = r.Pet == true
	d.PlaySec = clampCount(r.PlaySec, P7.maxDaySeconds())
	for key, value in pairs(tableOr(r.PlayClaimed)) do
		local tier = nil
		if value == true then
			tier = P7.tierOf(key)
		elseif type(key) == "number" and type(value) == "number" then
			tier = P7.tierOf(value)
		end
		if tier then
			d.PlayClaimed[tier] = true
		end
	end
	return d
end

function P7.isDefaultDaily(d)
	return d.Streak == 0 and d.Paid == 0 and d.LastClaimAt == 0 and d.Weeks == 0 and d.Pet == false and d.PlayStart == 0 and d.PlaySec == 0 and next(d.PlayClaimed) == nil
		and d.ClampFrom == 0 and d.ClampAt == 0 and d.ClampJob == ""
end

-- Clean record -> the stored form (PlayClaimed a dense boolean array; no sparse array for the DataStore; the Z8 first
-- sight only while it is set, so a record without one keeps its stored shape).
function P7.encodeDaily(d)
	local claimed, top = {}, 0
	for tier in pairs(d.PlayClaimed) do
		if tier > top then
			top = tier
		end
	end
	for tier = 1, top do
		claimed[tier] = d.PlayClaimed[tier] == true
	end
	local out = { Streak = d.Streak, Paid = d.Paid, LastClaimAt = d.LastClaimAt, Weeks = d.Weeks, Pet = d.Pet, PlayStart = d.PlayStart, PlaySec = d.PlaySec, PlayClaimed = claimed }
	if d.ClampFrom > 0 and d.ClampAt > 0 then
		out.ClampFrom = d.ClampFrom
		out.ClampAt = d.ClampAt
		if d.ClampJob ~= "" then
			out.ClampJob = d.ClampJob
		end
	end
	return out
end

function P7.cleanTrove(raw)
	return cleanSet(raw)
end

-- An untrusted grant (what a receipt, a daily claim or a Trove ask REALLY paid) -> a clean record { Cash, Tokens, Gems,
-- Berries, Pets = {[id] = n}, Boost = {[id] = seconds}, Kind, Tier, At, PlayStart, Star } (zero amounts left out), or
-- nil when it carries nothing to take back. A number means { Gems = n } (the gem packs' MarkReceipt call).
function P7.cleanGrant(raw)
	if type(raw) == "number" then
		raw = { Gems = raw }
	end
	if type(raw) ~= "table" then
		return nil
	end
	local g, any = {}, false
	for _, key in ipairs(P7.AMOUNTS) do
		local n = raw[key]
		if isFinite(n) and n >= 1 then
			g[key] = math.floor(n + 0.5)
			any = true
		end
	end
	for id, n in pairs(tableOr(raw.Pets)) do
		local count = validKey(id) and clampCount(n, Config.Pets.MaxPerStack) or 0
		if count > 0 then
			g.Pets = g.Pets or {}
			g.Pets[id] = count
			any = true
		end
	end
	for id, seconds in pairs(tableOr(raw.Boost)) do
		local n = validKey(id) and clampCount(seconds, P7.MAX_BOOST) or 0
		if n > 0 then
			g.Boost = g.Boost or {}
			g.Boost[id] = n
			any = true
		end
	end
	if not any then
		return nil
	end
	if type(raw.Kind) == "string" and P7.KINDS[raw.Kind] then
		g.Kind = raw.Kind
	end
	g.Tier = P7.tierOf(raw.Tier)
	g.At = isFinite(raw.At) and sanitizeTime(raw.At) or nil
	g.Prev = isFinite(raw.Prev) and sanitizeTime(raw.Prev) or nil
	g.PlayStart = isFinite(raw.PlayStart) and sanitizeTime(raw.PlayStart) or nil
	g.Star = isFinite(raw.Star) and clampCount(raw.Star, MAX_LEVEL) or nil
	return g
end

-- The live Home.Prestige of a profile: the star a grant is paid at (its record's Star).
function P7.starOf(profile)
	return clampCount(type(profile.Home) == "table" and profile.Home.Prestige or 0, MAX_LEVEL)
end

-- The index in `claims` (a session's grants, in claim order) of the first Day grant built on the stamp `stamp` (its
-- Prev): the record holding `stamp` holds this session's chain up to that claim and none after it. nil = no such grant.
function P7.chainFrom(claims, stamp)
	for i, g in ipairs(claims) do
		if g.Kind ~= "Play" and g.Prev ~= nil and g.Prev == stamp then
			return i
		end
	end
	return nil
end

-- The daily claims of `claims` that are still open against the clean record `daily` (an entry's Base, or the store):
-- the ones its merge would keep. A record that still holds the stamp a Day grant built on (its Prev, P7.chainFrom)
-- holds the claims before it and none from it on: those are open, even less than ReadySeconds after that stamp (a
-- claim after a Z8 clamp, re-review 2). Otherwise a Day grant is settled at or before the record's LastClaimAt (held)
-- or less than ReadySeconds after it (the merge dropped it against that claim: paid elsewhere, never dropped twice); a
-- Play grant of its play-day whose tier it holds, or of an EARLIER play-day (the higher PlayStart replaced that day:
-- never matched again).
function P7.pendingClaims(claims, daily)
	local out = {}
	local ready = P7.readySeconds()
	local list = tableOr(claims)
	local from = P7.chainFrom(list, daily.LastClaimAt)
	for i, g in ipairs(list) do
		local held
		if g.Kind == "Play" then
			local start = g.PlayStart or 0
			held = start < daily.PlayStart or (start == daily.PlayStart and g.Tier ~= nil and daily.PlayClaimed[g.Tier] == true)
		elseif from then
			held = i < from
		else
			held = (g.At or 0) - daily.LastClaimAt < ready
		end
		if not held then
			out[#out + 1] = g
		end
	end
	return out
end

-- The Store delta (both clean), or nil: Bought / Passes = the keys the session marked (their times), Boosts = the ids
-- whose end the session changed (the session's end).
function P7.diffStore(live, base)
	local d, any = P7.newStore(), false
	for _, key in ipairs({ "Bought", "Passes" }) do
		for id, t in pairs(live[key]) do
			if base[key][id] == nil then
				d[key][id] = t
				any = true
			end
		end
	end
	for id, ends in pairs(live.Boosts) do
		if base.Boosts[id] ~= ends then
			d.Boosts[id] = ends
			any = true
		end
	end
	if not any then
		return nil
	end
	return d
end

-- The Daily delta (both clean), or nil when the session changed nothing: the pair (LastClaimAt, Streak) and the Base's
-- LastClaimAt (BaseClaimAt: did the session move the pair?), Paid / Weeks / Pet as candidates, the Play group
-- (PlayStart; PlaySec = the seconds the session added to that play-day, the whole live count when the session started
-- the day; PlaySecNow = the live count; PlayClaimed = the live set). A stand-in delta carries no Play group (its base
-- is defaults, not store data).
function P7.diffDaily(live, base, standIn)
	if deepEqual(live, base) then
		return nil
	end
	local d = { Streak = live.Streak, LastClaimAt = live.LastClaimAt, BaseClaimAt = base.LastClaimAt, Paid = live.Paid, Weeks = live.Weeks, Pet = live.Pet,
		ClampFrom = live.ClampFrom, ClampAt = live.ClampAt, ClampJob = live.ClampJob }
	if not standIn then
		d.PlayStart = live.PlayStart
		d.PlaySecNow = live.PlaySec
		if live.PlayStart == base.PlayStart then
			d.PlaySec = live.PlaySec - base.PlaySec
		else
			d.PlaySec = live.PlaySec
		end
		d.PlayClaimed = copyMap(live.PlayClaimed)
	end
	return d
end

-- CashAt = {[star] = Cash} the dropped Cash by the prestige star it was paid at (a grant record's Star).
function P7.newDrop()
	return { Tokens = 0, Cash = 0, Gems = 0, Berries = 0, Pets = {}, Boosts = {}, CashAt = {} }
end

-- Adds a grant the store already holds to `drop` (what applyDelta takes off the session's deltas).
function P7.dropGrant(drop, grant)
	if type(grant) ~= "table" then
		return
	end
	for _, key in ipairs(P7.AMOUNTS) do
		if isFinite(grant[key]) then
			drop[key] = drop[key] + grant[key]
		end
	end
	if isFinite(grant.Cash) and isFinite(grant.Star) then
		drop.CashAt[grant.Star] = (drop.CashAt[grant.Star] or 0) + grant.Cash
	end
	for id, n in pairs(tableOr(grant.Pets)) do
		drop.Pets[id] = (drop.Pets[id] or 0) + n
	end
	for id, seconds in pairs(tableOr(grant.Boost)) do
		drop.Boosts[id] = (drop.Boosts[id] or 0) + seconds
	end
end

-- The Daily merge (`out` = the merged profile, `dd` = the Daily delta or nil, `claims` = the session's pending claim
-- grants, `drop` collects the grants the store already paid). The store decides against ITS values before the merge:
-- when the stored LastClaimAt is the stamp one of the claims built on (its Prev, P7.chainFrom), the store holds this
-- session's claims before that one (dropped: paid there) and none from it on (kept, however soon after the stamp: a
-- claim after a Z8 clamp, re-review 2); otherwise a Day grant less than ReadySeconds after the stored LastClaimAt was
-- paid elsewhere (dropped; the stored pair stays). Else the higher LastClaimAt of a session that MOVED its pair wins
-- the pair, and a session whose Base stamp is still the stored one takes it with any claim it made; an unmoved pair
-- never takes it (re-review 3: it is only the session's Base). A stored clock further in the future than
-- FutureClockSlack is a wrong clock: it loses the pair to a session that MOVED its pair (a claim; DailyService's Z8
-- clamp never moves LastClaimAt), but it still drops a twin, so one day is never paid twice. Paid / Weeks max, Pet
-- sticks. The Z8 first sight (ClampFrom, ClampAt, ClampJob) stays only while ClampFrom is the merged LastClaimAt; the
-- store's and the session's first sights of that one stamp keep the later ClampAt with its ClampJob (DailyService
-- reuses a sight only on the server that took it, so either one is safe to keep).
-- The higher PlayStart wins the whole Play group; at the same PlayStart the seconds add up and the tiers join; a Play
-- grant whose (PlayStart, tier) the store holds was paid elsewhere.
function P7.applyDaily(out, dd, claims, drop)
	local stored = P7.cleanDaily(out.Daily)
	local ready = P7.readySeconds()
	local wrongClock = stored.LastClaimAt > os.time() + P7.futureSlack()
	local droppedAt = {}
	local list = tableOr(claims)
	local from = P7.chainFrom(list, stored.LastClaimAt)
	for i, g in ipairs(list) do
		if g.Kind == "Play" then
			if (g.PlayStart or 0) == stored.PlayStart and g.Tier ~= nil and stored.PlayClaimed[g.Tier] == true then
				P7.dropGrant(drop, g)
			end
		elseif (from and i < from) or (not from and (g.At or 0) - stored.LastClaimAt < ready) then
			P7.dropGrant(drop, g)
			droppedAt[g.At or 0] = true
		end
	end
	if not dd then
		return
	end
	local d = out.Daily
	-- only a session that MOVED its pair (a claim) takes it (re-review 3): an unmoved pair is just the session's Base, no
	-- news about the claim, so a late save that only ticked play time or noted a Z8 first sight never puts back a stamp
	-- another server's claim has replaced (which would reopen P7.chainFrom's exemption for a twin built on that stamp)
	local moved = dd.LastClaimAt ~= dd.BaseClaimAt
	local successor = moved and stored.LastClaimAt == dd.BaseClaimAt -- nothing claimed in the store since the Base
	if moved and (dd.LastClaimAt > stored.LastClaimAt or wrongClock or successor) and not droppedAt[dd.LastClaimAt] then
		d.LastClaimAt = dd.LastClaimAt
		d.Streak = dd.Streak
	end
	local seenAt, seenJob = 0, ""
	if stored.ClampFrom > 0 and stored.ClampFrom == d.LastClaimAt then
		seenAt, seenJob = stored.ClampAt, stored.ClampJob
	end
	if isFinite(dd.ClampFrom) and dd.ClampFrom > 0 and dd.ClampFrom == d.LastClaimAt and isFinite(dd.ClampAt) and dd.ClampAt > seenAt then
		seenAt = sanitizeTime(dd.ClampAt)
		seenJob = P7.jobOf(dd.ClampJob)
	end
	d.ClampFrom = seenAt > 0 and d.LastClaimAt or 0
	d.ClampAt = seenAt
	d.ClampJob = seenAt > 0 and seenJob or ""
	if dd.Paid > d.Paid then
		d.Paid = dd.Paid
	end
	if dd.Weeks > d.Weeks then
		d.Weeks = dd.Weeks
	end
	if dd.Pet == true then
		d.Pet = true
	end
	if isFinite(dd.PlayStart) then
		local maxDay = P7.maxDaySeconds()
		if dd.PlayStart > stored.PlayStart then
			d.PlayStart = dd.PlayStart
			d.PlaySec = clampCount(dd.PlaySecNow, maxDay)
			d.PlayClaimed = {}
		end
		if dd.PlayStart >= stored.PlayStart then
			if dd.PlayStart == stored.PlayStart then
				d.PlaySec = clampCount(stored.PlaySec + (isFinite(dd.PlaySec) and dd.PlaySec or 0), maxDay)
			end
			for tier in pairs(tableOr(dd.PlayClaimed)) do
				if P7.tierOf(tier) then
					d.PlayClaimed[tier] = true
				end
			end
		end
	end
end

-- The Trove merge: the asks are a union; an ask the store already holds was paid there (its grant off the deltas).
function P7.applyTrove(out, asks, grants, drop)
	for ask in pairs(tableOr(asks)) do
		if validKey(ask) then
			if out.Trove[ask] == true then
				P7.dropGrant(drop, tableOr(grants)[ask])
			end
			out.Trove[ask] = true
		end
	end
end

-- PetLevels per key (the session's replacement, a removal too), EXCEPT for a pet whose grant the store already holds
-- (`drop.Pets`, the twin rules): the session's level write of that grant (a pack's Level) must never lower the stored
-- level, so that key keeps the higher { Level, Xp } of the two.
function P7.applyLevels(target, changes, drop)
	for key, value in pairs(changes) do
		local current = target[key]
		if value == false then
			target[key] = nil
		elseif not ((drop.Pets[key] or 0) > 0 and type(current) == "table" and (current.Level > value.Level or (current.Level == value.Level and current.Xp >= value.Xp))) then
			target[key] = deepCopy(value)
		end
	end
end

-- The Store merge: Bought / Passes a union (the earlier time wins); a potion end per id: the session's end MINUS the
-- seconds of its receipt grants the store already holds (in `drop`), then the later end of the two.
function P7.applyStore(out, ds, drop)
	if not ds then
		return
	end
	local s = out.Store
	for _, key in ipairs({ "Bought", "Passes" }) do
		for id, t in pairs(tableOr(ds[key])) do
			if validKey(id) and isFinite(t) then
				local current = s[key][id]
				if current == nil or t < current then
					s[key][id] = sanitizeTime(t)
				end
			end
		end
	end
	for id, ends in pairs(tableOr(ds.Boosts)) do
		if validKey(id) and isFinite(ends) then
			local want = ends - (drop.Boosts[id] or 0)
			if want > (s.Boosts[id] or 0) then
				s.Boosts[id] = sanitizeTime(want)
			end
		end
	end
end

-- Lobby shop (spec 5.2 / 6): the Secret pity record Pity = { Secret = { Spins, Hit } }. Spins = Secret Roulette spins
-- ever, Hit = the Spins value right after the last Secret from that roulette (Since = Spins - Hit). Helpers are fields of
-- P7 (no new column-0 local). One number of the record: a whole number 0..MAX_PITY, anything else 0.
function P7.pityNumber(n)
	if isFinite(n) and n >= 0 and n <= P7.MAX_PITY and n == math.floor(n) then
		return n
	end
	return 0
end

-- Untrusted Pity -> { Secret = { Spins, Hit } } (whole numbers 0..MAX_PITY, anything else 0; Hit <= Spins, else Hit =
-- Spins). nil / junk gives the zero record (an old profile has no Pity: 7 spins left).
function P7.cleanPity(raw)
	local secret = tableOr(tableOr(raw).Secret)
	local spins, hit = P7.pityNumber(secret.Spins), P7.pityNumber(secret.Hit)
	if hit > spins then
		hit = spins
	end
	return { Secret = { Spins = spins, Hit = hit } }
end

-- true for the zero record (left out of the store)
function P7.isDefaultPity(pity)
	return pity.Secret.Spins == 0 and pity.Secret.Hit == 0
end

-- The Secret counter's delta (both clean), or nil: Spins as a +/- delta (like Ring.Runs), Hit as a candidate when it
-- rose (like Ring.Best).
function P7.diffPity(live, base)
	local l, b = live.Secret, base.Secret
	local d, any = { Spins = nil, Hit = nil }, false
	if l.Spins ~= b.Spins then
		d.Spins = l.Spins - b.Spins
		any = true
	end
	if l.Hit > b.Hit then
		d.Hit = l.Hit
		any = true
	end
	if not any then
		return nil
	end
	return d
end

-- Merges a diffPity delta into out.Pity: Spins add up (never below 0), the higher Hit wins, then Hit <= Spins. Two
-- servers that each counted spins after the same hit can push Since above PityAt - 1: the reader clamps (5.2).
function P7.applyPity(out, dp)
	if not dp then
		return
	end
	local secret = out.Pity.Secret
	if isFinite(dp.Spins) then
		secret.Spins = sanitize(secret.Spins + dp.Spins)
	end
	if isFinite(dp.Hit) and dp.Hit > secret.Hit then
		secret.Hit = sanitize(dp.Hit)
	end
	out.Pity = P7.cleanPity(out.Pity)
end

local function copyProfile(p)
	local out = newProfile()
	out.Tokens = p.Tokens
	out.Pets = copyMap(p.Pets)
	out.Equipped = copyList(p.Equipped)
	out.Items = copyMap(p.Items)
	for _, key in ipairs(STAT_KEYS) do
		out.Stats[key] = p.Stats[key]
	end
	out.Stats.BestTimes = copyMap(p.Stats.BestTimes)
	out.SpotIndex = p.SpotIndex
	-- v3
	out.Tiers = cleanTiers(p.Tiers) -- before discoverOwned: tier copies count as discovered too
	out.Discovered = cleanSet(p.Discovered)
	discoverOwned(out) -- a pet granted without MarkDiscovered still saves as discovered
	out.IndexClaimed = cleanSet(p.IndexClaimed)
	out.Tutorial = cleanTutorial(p.Tutorial)
	-- Phase 2
	out.Cash = sanitizeCash(p.Cash)
	out.Gems = sanitize(p.Gems)
	out.Home = cleanHome(p.Home, false)
	out.PetLevels = copyPetLevels(p.PetLevels)
	out.Food = cleanCounts(p.Food, MAX_FOOD)
	out.Hybrids = cleanHybrids(p.Hybrids)
	out.GemReceipts = cleanReceipts(p.GemReceipts)
	-- Phase 4 (before the presets: the live Equipped list is copied as it is, but the growth map is read everywhere)
	out.PetGrowth = P4.cleanGrowth(p.PetGrowth)
	out.Ring = P4.cleanRing(p.Ring)
	out.Migrations = cleanSet(p.Migrations)
	-- Phase 5
	out.Dungeon = P5.cleanDungeon(p.Dungeon)
	out.Berries = P5.cleanBerries(p.Berries)
	out.Settings = P5.cleanSettings(p.Settings)
	-- Store build
	out.Store = P7.cleanStore(p.Store)
	out.Daily = P7.cleanDaily(p.Daily)
	out.Trove = P7.cleanTrove(p.Trove)
	out.Pity = P7.cleanPity(p.Pity) -- lobby shop
	-- Phase 3 (the copies, the Home and its prestige are final above: the presets are pruned against them)
	out.Teams = P3.cleanTeams(p.Teams)
	P3.prune(out, out.Teams)
	out.Battle = P3.cleanBattle(p.Battle)
	return out
end

-- Untrusted stored value (nil / number / v1 table / v2 table / v3 table / Phase 2 table) -> clean profile. Pure.
-- `info` (optional): a table that receives GardenMoved = { key... } when P3.gardenSolo took pets out of the Garden.
local function normalizeProfile(raw, info)
	local p = newProfile()
	if type(raw) == "number" then
		p.Tokens = sanitize(raw)
		return p
	end
	if type(raw) ~= "table" then
		return p
	end
	p.Tokens = sanitize(raw.Tokens)
	if type(raw.Pets) == "table" then
		for id, n in pairs(raw.Pets) do
			if validKey(id) then
				local count = clampCount(n, Config.Pets.MaxPerStack)
				if count > 0 then
					p.Pets[id] = count
				end
			end
		end
	end
	if type(raw.Items) == "table" then
		for id, n in pairs(raw.Items) do
			if validKey(id) then
				local count = clampCount(n, P6.REFUND_MAX)
				if count > 0 then
					p.Items[id] = count
				end
			end
		end
	end
	if type(raw.Equipped) == "table" then
		for _, id in ipairs(raw.Equipped) do
			if type(id) == "string" then
				table.insert(p.Equipped, id)
			end
		end
	end
	if type(raw.Stats) == "table" then
		for _, key in ipairs(STAT_KEYS) do
			p.Stats[key] = sanitize(raw.Stats[key])
		end
		if type(raw.Stats.BestTimes) == "table" then
			for id, seconds in pairs(raw.Stats.BestTimes) do
				local clean = sanitizeSeconds(seconds)
				if validKey(id) and clean then
					p.Stats.BestTimes[id] = clean
				end
			end
		end
	end
	local spot = raw.SpotIndex
	if isFinite(spot) and spot >= 1 and spot <= Config.Lobby.SpotCount and spot == math.floor(spot) then
		p.SpotIndex = spot
	end
	-- Phase 2 copies first: the equipped list may hold tier / hybrid keys; Phase 4 growth too: a training key may not
	-- stay equipped (a Phase 3 server may have equipped it during the rollout)
	p.Tiers = cleanTiers(raw.Tiers)
	p.Hybrids = cleanHybrids(raw.Hybrids)
	p.PetGrowth = P4.cleanGrowth(raw.PetGrowth)
	p.Ring = P4.cleanRing(raw.Ring)
	p.Migrations = cleanSet(raw.Migrations)
	-- Phase 5 (absent in older saves: the defaults stay; the P5 migrations run on the live profile after the load)
	p.Dungeon = P5.cleanDungeon(raw.Dungeon)
	p.Berries = P5.cleanBerries(raw.Berries)
	p.Settings = P5.cleanSettings(raw.Settings)
	-- Store build (absent in older saves: the defaults stay)
	p.Store = P7.cleanStore(raw.Store)
	p.Daily = P7.cleanDaily(raw.Daily)
	p.Trove = P7.cleanTrove(raw.Trove)
	p.Pity = P7.cleanPity(raw.Pity) -- lobby shop (absent in older saves: the zero record)
	normalizeEquipped(p)
	-- v3 fields (absent in v2 saves: the defaults from newProfile stay)
	p.Discovered = cleanSet(raw.Discovered)
	discoverOwned(p) -- migration: owned pets count as discovered
	p.IndexClaimed = cleanSet(raw.IndexClaimed)
	p.Tutorial = cleanTutorial(raw.Tutorial)
	p.Cash = sanitizeCash(raw.Cash)
	p.Gems = sanitize(raw.Gems)
	p.Home = cleanHome(raw.Home, true) -- migration: the v3 reserve Home.Rooms becomes Home.Stations
	p.PetLevels = copyPetLevels(raw.PetLevels)
	p.Food = cleanCounts(raw.Food, MAX_FOOD)
	p.GemReceipts = cleanReceipts(raw.GemReceipts, true)
	-- Phase 3 (migration: a Phase 2 profile has no Teams / Battle and gets the defaults; stale keys are pruned)
	p.Teams = P3.cleanTeams(raw.Teams)
	-- bug batch 2 #18: a pet both in the Garden and equipped / in a preset (an old save) leaves the Garden FIRST, so
	-- the prune below (which counts Garden copies now) never takes a fighter out of its team
	local moved = P3.gardenSolo(p)
	if moved and type(info) == "table" then
		info.GardenMoved = moved
	end
	P3.prune(p, p.Teams)
	p.Battle = P3.cleanBattle(raw.Battle)
	P3.syncEquipped(p) -- last: the copies, the Home, the growth map and the presets are final now
	return p
end

-- Both arguments are clean profiles (normalizeProfile / copyProfile results).
local function profilesEqual(a, b)
	if a.Tokens ~= b.Tokens or a.SpotIndex ~= b.SpotIndex then
		return false
	end
	if not listsEqual(a.Equipped, b.Equipped) then
		return false
	end
	if not mapsEqual(a.Pets, b.Pets) or not mapsEqual(a.Items, b.Items) then
		return false
	end
	for _, key in ipairs(STAT_KEYS) do
		if a.Stats[key] ~= b.Stats[key] then
			return false
		end
	end
	if not mapsEqual(a.Stats.BestTimes, b.Stats.BestTimes) then
		return false
	end
	-- v3
	if a.Cash ~= b.Cash or a.Gems ~= b.Gems then
		return false
	end
	if not mapsEqual(a.Discovered, b.Discovered) or not mapsEqual(a.IndexClaimed, b.IndexClaimed) then
		return false
	end
	if not tutorialsEqual(a.Tutorial, b.Tutorial) then
		return false
	end
	-- Phase 2
	if not homesEqual(a.Home, b.Home) or not mapsEqual(a.Food, b.Food) or not mapsEqual(a.GemReceipts, b.GemReceipts) then
		return false
	end
	return deepEqual(a.PetLevels, b.PetLevels)
		and deepEqual(a.Tiers, b.Tiers)
		and deepEqual(a.Hybrids, b.Hybrids)
		and deepEqual(a.Teams, b.Teams)
		and deepEqual(a.Battle, b.Battle)
		-- Phase 4
		and deepEqual(a.PetGrowth, b.PetGrowth)
		and deepEqual(a.Ring, b.Ring)
		and mapsEqual(a.Migrations, b.Migrations)
		-- Phase 5
		and deepEqual(a.Dungeon, b.Dungeon)
		and a.Berries == b.Berries
		and P5.settingsEqual(a.Settings, b.Settings)
		-- Store build
		and deepEqual(a.Store, b.Store)
		and deepEqual(a.Daily, b.Daily)
		and mapsEqual(a.Trove, b.Trove)
		-- lobby shop (without it a save that found another server's spins would keep the stale live count)
		and deepEqual(a.Pity, b.Pity)
end

----------------------------------------------------------------------
-- Delta merge (the heart of the safe-save design)
----------------------------------------------------------------------

local function diffCounts(live, base)
	local out = {}
	for id, n in pairs(live) do
		local delta = n - (base[id] or 0)
		if delta ~= 0 then
			out[id] = delta
		end
	end
	for id, n in pairs(base) do
		if live[id] == nil then
			out[id] = -n
		end
	end
	return out
end

-- Keys the session added to a grow-only set (removals never travel).
local function diffSet(live, base)
	local out = {}
	local b = tableOr(base)
	for key, value in pairs(tableOr(live)) do
		if value and not b[key] and validKey(key) then
			out[key] = true
		end
	end
	return out
end

-- Per-key replacements of a clean map: key -> new value, or false when the session removed it.
local function diffReplace(live, base, equal)
	local out = {}
	for key, value in pairs(live) do
		if base[key] == nil or not equal(value, base[key]) then
			out[key] = value
		end
	end
	for key in pairs(base) do
		if live[key] == nil then
			out[key] = false
		end
	end
	return out
end

local function sameValue(a, b)
	return a == b
end

local function samePetLevel(a, b)
	return a.Level == b.Level and a.Xp == b.Xp
end

-- Untrusted best-times map -> { [difficultyId] = seconds } with valid keys and sane seconds only.
local function cleanBestTimes(raw)
	local out = {}
	for id, seconds in pairs(tableOr(raw)) do
		local clean = sanitizeSeconds(seconds)
		if validKey(id) and clean then
			out[id] = clean
		end
	end
	return out
end

-- The values a pending ResetFields writes over the store: the session's CURRENT values of those fields.
local function overwriteValues(live, overwrite)
	if type(overwrite) ~= "table" then
		return nil
	end
	local out = {}
	if overwrite.Discovered then
		out.Discovered = cleanSet(live.Discovered)
	end
	if overwrite.IndexClaimed then
		out.IndexClaimed = cleanSet(live.IndexClaimed)
	end
	if overwrite.Tutorial then
		out.Tutorial = cleanTutorial(live.Tutorial)
	end
	if overwrite.BestTimes then
		out.BestTimes = cleanBestTimes(type(live.Stats) == "table" and live.Stats.BestTimes)
	end
	if overwrite.Home then
		out.Home = cleanHome(live.Home, false)
	end
	if overwrite.Tiers then
		out.Tiers = cleanTiers(live.Tiers)
	end
	if overwrite.Hybrids then
		out.Hybrids = cleanHybrids(live.Hybrids)
	end
	if overwrite.PetLevels then
		out.PetLevels = copyPetLevels(live.PetLevels)
	end
	if overwrite.Teams then
		out.Teams = P3.teamsOf(live)
	end
	if overwrite.Battle then
		out.Battle = P3.cleanBattle(live.Battle)
	end
	-- Phase 4
	if overwrite.PetGrowth then
		out.PetGrowth = P4.cleanGrowth(live.PetGrowth)
	end
	if overwrite.Ring then
		out.Ring = P4.cleanRing(live.Ring)
	end
	if overwrite.Migrations then
		out.Migrations = cleanSet(live.Migrations)
	end
	-- Phase 5 (the dev reset: Best max / Cleared union would bring the record back)
	if overwrite.Dungeon then
		out.Dungeon = P5.cleanDungeon(live.Dungeon)
	end
	-- Store build (the dev reset: the pair / Play group maxima and the ask union would bring them back)
	if overwrite.Daily then
		out.Daily = P7.cleanDaily(live.Daily)
	end
	if overwrite.Trove then
		out.Trove = P7.cleanTrove(live.Trove)
	end
	-- lobby shop (the dev reset: the max Hit would bring the record back)
	if overwrite.Pity then
		out.Pity = P7.cleanPity(live.Pity)
	end
	if next(out) == nil then
		return nil
	end
	return out
end

-- The Teams delta (both clean): { Presets = { [i] = list } (only the presets the session changed), Active = n | nil },
-- or nil when the session changed nothing.
function P3.diffTeams(live, base)
	local d = { Presets = {}, Active = nil }
	local any = false
	for i = 1, P3.PRESETS do
		if not listsEqual(live.Presets[i], base.Presets[i]) then
			d.Presets[i] = copyList(live.Presets[i])
			any = true
		end
	end
	if live.Active ~= base.Active then
		d.Active = live.Active
		any = true
	end
	if not any then
		return nil
	end
	return d
end

-- Per preset: a changed preset replaces the stored one (the caller prunes once the owned copies are final).
function P3.applyTeams(out, d)
	if not d then
		return
	end
	for i, list in pairs(d.Presets) do
		out.Teams.Presets[i] = copyList(list)
	end
	if d.Active ~= nil then
		out.Teams.Active = d.Active
	end
end

-- The Battle delta (both clean), or nil: counters as +/- deltas, best values as candidates, cleared levels and event
-- pets as additions (removals never travel: those sets only grow).
function P3.diffBattle(live, base)
	local d = { Counters = {}, Best = {}, Cleared = {}, EventPets = {} }
	local any = false
	for _, field in ipairs(P3.COUNTERS) do
		local delta = live[field] - base[field]
		if delta ~= 0 then
			d.Counters[field] = delta
			any = true
		end
	end
	for _, field in ipairs(P3.BESTS) do
		if live[field] > base[field] then
			d.Best[field] = live[field]
			any = true
		end
	end
	for level in pairs(live.TrialCleared) do
		if not base.TrialCleared[level] then
			d.Cleared[level] = true
			any = true
		end
	end
	for id in pairs(live.EventPets) do
		if not base.EventPets[id] then
			d.EventPets[id] = true
			any = true
		end
	end
	-- lobby-shop 16.12: the duel entries the session added (the record merges as a union, capped by cleanDuels)
	local had = {}
	for _, e in ipairs(base.Duels or {}) do
		had[tostring(e.U) .. ":" .. tostring(e.T)] = true
	end
	for _, e in ipairs(live.Duels or {}) do
		if not had[tostring(e.U) .. ":" .. tostring(e.T)] then
			d.Duels = d.Duels or {}
			d.Duels[#d.Duels + 1] = { U = e.U, T = e.T }
			any = true
		end
	end
	if not any then
		return nil
	end
	return d
end

function P3.applyBattle(out, d)
	if not d then
		return
	end
	local battle = out.Battle
	for field, delta in pairs(d.Counters) do
		battle[field] = sanitize(battle[field] + delta) -- Trophies (like every counter) never below 0
	end
	for field, value in pairs(d.Best) do
		if value > battle[field] then
			battle[field] = value
		end
	end
	for level in pairs(d.Cleared) do
		battle.TrialCleared[level] = true
	end
	for id in pairs(d.EventPets) do
		battle.EventPets[id] = true
	end
	if type(d.Duels) == "table" then -- lobby-shop 16.12 (a delta from before it has none)
		local duels = type(battle.Duels) == "table" and battle.Duels or {}
		for _, e in ipairs(d.Duels) do
			duels[#duels + 1] = e
		end
		battle.Duels = duels
	end
	out.Battle = P3.cleanBattle(battle) -- TrialBest >= the highest cleared level; Duels deduplicated and capped
end

-- The Home delta, or nil when the session did not change the Home. Whole = the session's complete home (it wins
-- when its prestige is higher than the stored one); the rest is the per-key merge used at equal prestige.
-- BasePrestige / CollectorNow: when the session prestiged to the star the store also holds, its Collector filled up
-- from 0 after that prestige (a delta against the pre-prestige base would wipe the store's Collector).
local function diffHome(liveRaw, baseRaw)
	local live, base = cleanHome(liveRaw, false), cleanHome(baseRaw, false)
	if homesEqual(live, base) then
		return nil
	end
	local d = {
		Whole = live,
		Prestige = live.Prestige,
		BasePrestige = base.Prestige,
		Level = nil,
		Stations = diffReplace(live.Stations, base.Stations, sameValue),
		Garden = diffReplace(live.Garden, base.Garden, sameValue),
		Gym = diffReplace(live.Gym, base.Gym, sameValue),
		CollectorCash = live.CollectorCash - base.CollectorCash,
		CollectorNow = live.CollectorCash,
		LastSeen = nil,
		-- Phase 4 (per-key replace): the new value, false when the session cleared it, nil when untouched
		LegacySlots = nil,
		LegacyPrices = nil,
		-- Phase 5 (per-key replace too): DecorCredit, LegacyMagnet (+ LegacyMagnetStar travels with it)
		DecorCredit = nil,
		LegacyMagnet = nil,
		LegacyMagnetStar = nil,
	}
	if live.Level ~= base.Level then
		d.Level = live.Level
	end
	if live.LastSeen ~= base.LastSeen then
		d.LastSeen = live.LastSeen
	end
	if live.LegacySlots ~= base.LegacySlots then
		d.LegacySlots = live.LegacySlots or false
	end
	if live.LegacyPrices ~= base.LegacyPrices then
		d.LegacyPrices = live.LegacyPrices or false
	end
	if live.DecorCredit ~= base.DecorCredit then
		d.DecorCredit = live.DecorCredit or false
	end
	if live.LegacyMagnet ~= base.LegacyMagnet or live.LegacyMagnetStar ~= base.LegacyMagnetStar then
		d.LegacyMagnet = live.LegacyMagnet or false
		d.LegacyMagnetStar = live.LegacyMagnetStar
	end
	return d
end

-- { [star] = gems } the prestige reward TycoonService paid for every star in fromStars+1 .. toStars (empty without
-- TycoonCatalog). Resolved here, outside UpdateAsync, so the merge itself stays pure.
local function starRewards(fromStars, toStars)
	local out = {}
	local catalog = getTycoonCatalog()
	if toStars <= fromStars or not catalog or type(catalog.PrestigeGems) ~= "function" then
		return out
	end
	for star = fromStars + 1, math.min(toStars, fromStars + 100) do
		local ok, gems = pcall(catalog.PrestigeGems, star)
		if ok and isFinite(gems) and gems >= 1 then
			out[star] = math.floor(gems) -- TycoonService.Prestige pays math.floor(PrestigeGems(stars))
		end
	end
	return out
end

-- What changed between `base` and `live`. Counters travel as +/- deltas, "best" values as
-- candidates, sets as additions, lists / single values as replacements. `live` may be the raw live
-- profile, so every v3 / Phase 2 field is read defensively. `overwrite` (the entry's pending ResetFields, or nil)
-- adds d.Overwrite: whole fields that replace the stored ones before anything else is merged.
-- `opts` (optional): { ReceiptGems = { [purchaseId] = gems } (MarkReceipt), StandIn = true when `base` is not data
-- read from the store (the load has not finished or failed: the delta then merges plainly) }. The delta carries what
-- the prestige rule of applyDelta needs: BasePrestige / LivePrestige, CashNow (the live balance), StarGems (the
-- reward of every star the session reached since its base) and ReceiptGems (the gems of each new receipt).
local function diffProfiles(live, base, overwrite, opts)
	opts = type(opts) == "table" and opts or {}
	local baseStars = clampCount(type(base.Home) == "table" and base.Home.Prestige or 0, MAX_LEVEL)
	local liveStars = clampCount(type(live.Home) == "table" and live.Home.Prestige or 0, MAX_LEVEL)
	local d = {
		Tokens = live.Tokens - base.Tokens,
		Pets = diffCounts(live.Pets, base.Pets),
		Items = diffCounts(live.Items, base.Items),
		Stats = {},
		BestTimes = {},
		Equipped = nil,
		HasSpot = false,
		SpotIndex = nil,
		-- v3
		Discovered = diffSet(live.Discovered, base.Discovered),
		IndexClaimed = diffSet(live.IndexClaimed, base.IndexClaimed),
		Tutorial = nil,
		-- whole units only (like copyProfile), so a fractional live balance can never keep a delta alive
		Cash = sanitizeCash(live.Cash) - sanitizeCash(base.Cash),
		Gems = sanitize(live.Gems) - sanitize(base.Gems),
		PetLevels = diffReplace(copyPetLevels(live.PetLevels), copyPetLevels(base.PetLevels), samePetLevel),
		-- Phase 2
		Home = diffHome(live.Home, base.Home),
		Food = diffCounts(cleanCounts(live.Food, MAX_FOOD), cleanCounts(base.Food, MAX_FOOD)),
		Tiers = diffReplace(cleanTiers(live.Tiers), cleanTiers(base.Tiers), deepEqual),
		Hybrids = diffReplace(cleanHybrids(live.Hybrids), cleanHybrids(base.Hybrids), deepEqual),
		GemReceipts = {},
		-- Phase 3 (the live presets are pruned the way copyProfile prunes them, so a stale key never keeps a delta alive)
		Teams = P3.diffTeams(P3.teamsOf(live), P3.teamsOf(base)),
		Battle = P3.diffBattle(P3.cleanBattle(live.Battle), P3.cleanBattle(base.Battle)),
		-- Phase 4: growth per key (nil when unchanged), the ring record (Best candidate / Runs delta), new markers
		PetGrowth = P4.diffGrowth(P4.cleanGrowth(live.PetGrowth), P4.cleanGrowth(base.PetGrowth)),
		Ring = P4.diffRing(P4.cleanRing(live.Ring), P4.cleanRing(base.Ring)),
		Migrations = diffSet(live.Migrations, base.Migrations),
		-- Phase 5: the dungeon record (Best candidate, Cleared union, Runs / Clears deltas, the migration's Clears as
		-- a floor), berries as a +/- delta, the settings whole when the session changed them (the live session wins)
		Dungeon = P5.diffDungeon(P5.cleanDungeon(live.Dungeon), P5.cleanDungeon(base.Dungeon), opts.DungeonMigrated),
		Berries = P5.cleanBerries(live.Berries) - P5.cleanBerries(base.Berries),
		-- the part of that delta the session's own P5Home step converted from Food (the m15 twin: a store another
		-- server already marked P5Home holds its own conversion, so applyDelta leaves these out there)
		BerriesMigrated = (isFinite(opts.BerriesMigrated) and opts.BerriesMigrated > 0) and math.floor(opts.BerriesMigrated) or nil,
		-- HUD cleanup: the Tokens the session's own item refund paid (left out against a store already refunded)
		ItemsRefunded = (isFinite(opts.ItemsRefunded) and opts.ItemsRefunded > 0) and math.floor(opts.ItemsRefunded) or nil,
		Settings = nil,
		Overwrite = overwriteValues(live, overwrite),
		-- the prestige rule for Cash and the star rewards (applyDelta); receipt gems (no double grant)
		BasePrestige = baseStars,
		LivePrestige = liveStars,
		CashNow = sanitizeCash(live.Cash),
		StandIn = opts.StandIn == true,
		StarGems = {},
		-- Store build (P7): the Store record (new marks, changed potion ends), the Daily record by its pair / Play group
		-- rules (nil when unchanged; a stand-in delta carries no Play group), the asks the session set (a union), and
		-- the grant records of the three twin rules: what the session paid for each new receipt (filled below), each
		-- daily claim its Base does not hold, each new ask (filled below)
		Store = P7.diffStore(P7.cleanStore(live.Store), P7.cleanStore(base.Store)),
		Daily = P7.diffDaily(P7.cleanDaily(live.Daily), P7.cleanDaily(base.Daily), opts.StandIn == true),
		Trove = diffSet(live.Trove, base.Trove),
		ReceiptGrants = {},
		DailyClaims = P7.pendingClaims(opts.DailyClaims, P7.cleanDaily(base.Daily)),
		TroveGrants = {},
		-- lobby shop: the Secret pity counter (Spins delta, Hit candidate; nil when unchanged)
		Pity = P7.diffPity(P7.cleanPity(live.Pity), P7.cleanPity(base.Pity)),
	}
	if not d.StandIn and liveStars > baseStars then
		d.StarGems = starRewards(baseStars, liveStars)
	end
	for _, key in ipairs(STAT_KEYS) do
		local delta = live.Stats[key] - base.Stats[key]
		if delta ~= 0 then
			d.Stats[key] = delta
		end
	end
	for id, seconds in pairs(live.Stats.BestTimes) do
		if base.Stats.BestTimes[id] ~= seconds then
			d.BestTimes[id] = seconds
		end
	end
	if not listsEqual(live.Equipped, base.Equipped) then
		d.Equipped = copyList(live.Equipped)
	end
	if live.SpotIndex ~= base.SpotIndex then
		d.HasSpot = true
		d.SpotIndex = live.SpotIndex
	end
	local liveTutorial = cleanTutorial(live.Tutorial)
	if not tutorialsEqual(liveTutorial, cleanTutorial(base.Tutorial)) then
		d.Tutorial = liveTutorial
	end
	local liveSettings = P5.cleanSettings(live.Settings)
	if not P5.settingsEqual(liveSettings, P5.cleanSettings(base.Settings)) then
		d.Settings = liveSettings
	end
	local baseReceipts = cleanReceipts(base.GemReceipts)
	local receiptGrants = type(opts.ReceiptGrants) == "table" and opts.ReceiptGrants or {}
	for id, t in pairs(cleanReceipts(live.GemReceipts)) do
		if baseReceipts[id] == nil then
			d.GemReceipts[id] = t
			local grant = P7.cleanGrant(receiptGrants[id])
			if grant then
				d.ReceiptGrants[id] = grant
			end
		end
	end
	local troveGrants = type(opts.TroveGrants) == "table" and opts.TroveGrants or {}
	for ask in pairs(d.Trove) do
		local grant = P7.cleanGrant(troveGrants[ask])
		if grant then
			d.TroveGrants[ask] = grant
		end
	end
	return d
end

local function isEmptyDelta(d)
	return d.Tokens == 0
		and next(d.Pets) == nil
		and next(d.Items) == nil
		and next(d.Stats) == nil
		and next(d.BestTimes) == nil
		and d.Equipped == nil
		and not d.HasSpot
		and next(d.Discovered) == nil
		and next(d.IndexClaimed) == nil
		and d.Tutorial == nil
		and d.Cash == 0
		and d.Gems == 0
		and next(d.PetLevels) == nil
		and d.Home == nil
		and next(d.Food) == nil
		and next(d.Tiers) == nil
		and next(d.Hybrids) == nil
		and next(d.GemReceipts) == nil
		and d.Teams == nil
		and d.Battle == nil
		and d.PetGrowth == nil
		and d.Ring == nil
		and next(d.Migrations) == nil
		and d.Dungeon == nil
		and d.Berries == 0
		and d.Settings == nil
		and d.Overwrite == nil
		-- Store build
		and d.Store == nil
		and d.Daily == nil
		and next(d.Trove) == nil
		and #d.DailyClaims == 0
		-- lobby shop (a pity-only change must save)
		and d.Pity == nil
end

local function applyCounts(target, deltas, maxCount)
	for id, delta in pairs(deltas) do
		local value = clampCount((target[id] or 0) + delta, maxCount)
		if value > 0 then
			target[id] = value
		else
			target[id] = nil
		end
	end
end

local function applyReplace(target, changes)
	for key, value in pairs(changes) do
		if value == false then
			target[key] = nil
		else
			target[key] = deepCopy(value)
		end
	end
end

-- Home merge: a higher prestige wins the whole Home; at equal prestige the session's changes merge per key.
-- When BOTH sides prestiged to the stored star (the session's base is an earlier run), the session's delta against
-- that base mixes its prestige reset with what it built since. Both runs started from the same reset home (decor
-- kept) and stations only go up within a run, so every station keeps the higher of the two levels (a station the
-- session's prestige reset does not remove the one the other run rebuilt), the Home Level grows by what that adds
-- (it is the sum of the station levels), and the session's Collector, which filled from 0 after its prestige, joins
-- the stored one.
local function applyHome(out, dh)
	if not dh then
		return
	end
	local stored = out.Home
	if dh.Prestige > stored.Prestige then
		out.Home = cleanHome(dh.Whole, false) -- the session prestiged past the store
		return
	end
	if stored.Prestige > dh.Prestige then
		return -- another server prestiged past this session: its stations were reset, the session's edits are void
	end
	if isFinite(dh.BasePrestige) and dh.BasePrestige < dh.Prestige then
		local gained = 0
		for key, level in pairs(dh.Stations) do
			local current = stored.Stations[key] or 0
			if isFinite(level) and level > current then
				stored.Stations[key] = level
				gained = gained + (level - current)
			end
		end
		stored.Level = clampCount(stored.Level + gained, MAX_LEVEL)
		stored.CollectorCash = sanitizeCash(stored.CollectorCash + (isFinite(dh.CollectorNow) and dh.CollectorNow or 0))
	else
		if dh.Level ~= nil then
			stored.Level = dh.Level
		end
		applyReplace(stored.Stations, dh.Stations)
		stored.CollectorCash = sanitizeCash(stored.CollectorCash + dh.CollectorCash)
	end
	applyReplace(stored.Garden, dh.Garden) -- garden / gym choices survive a prestige: the session's edits count
	applyReplace(stored.Gym, dh.Gym)
	if dh.LastSeen ~= nil and dh.LastSeen > stored.LastSeen then
		stored.LastSeen = dh.LastSeen
	end
	-- Phase 4: the veteran extras merge per key too (a value replaces, false removes, nil leaves the stored one)
	if dh.LegacySlots == false then
		stored.LegacySlots = nil
	elseif isFinite(dh.LegacySlots) and dh.LegacySlots >= 1 then
		stored.LegacySlots = math.min(math.floor(dh.LegacySlots), MAX_SLOT)
	end
	if dh.LegacyPrices == false then
		stored.LegacyPrices = nil
	elseif dh.LegacyPrices == true then
		stored.LegacyPrices = true
	end
	-- Phase 5: the folded Home keys merge per key the same way (a higher Prestige won the whole Home above and
	-- CARRIES its DecorCredit; the magnet keys are cleared by that prestige)
	if dh.DecorCredit == false then
		stored.DecorCredit = nil
	elseif isFinite(dh.DecorCredit) and dh.DecorCredit >= 1 then
		stored.DecorCredit = math.min(math.floor(dh.DecorCredit), P5.MAX_DECOR_CREDIT)
	end
	if dh.LegacyMagnet == false then
		stored.LegacyMagnet = nil
		stored.LegacyMagnetStar = nil
	elseif isFinite(dh.LegacyMagnet) and dh.LegacyMagnet >= 1 then
		stored.LegacyMagnet = math.min(math.floor(dh.LegacyMagnet), P5.MAX_MAGNET)
		stored.LegacyMagnetStar = clampCount(dh.LegacyMagnetStar, MAX_LEVEL)
	end
end

-- stored profile + delta -> new profile. Pure (runs inside UpdateAsync, which may retry it).
local function applyDelta(stored, d)
	local out = copyProfile(stored)
	-- a pending ResetFields first replaces whole fields, so the union / sticky / best-of / prestige merges below
	-- cannot bring the stored values back (they then merge the session's own changes onto the replaced value)
	local o = d.Overwrite
	if o then
		if o.Discovered then
			out.Discovered = copyMap(o.Discovered)
		end
		if o.IndexClaimed then
			out.IndexClaimed = copyMap(o.IndexClaimed)
		end
		if o.Tutorial then
			out.Tutorial = cleanTutorial(o.Tutorial)
		end
		if o.BestTimes then
			out.Stats.BestTimes = copyMap(o.BestTimes)
		end
		if o.Home then
			out.Home = cleanHome(o.Home, false)
		end
		if o.Tiers then
			out.Tiers = deepCopy(o.Tiers)
		end
		if o.Hybrids then
			out.Hybrids = deepCopy(o.Hybrids)
		end
		if o.PetLevels then
			out.PetLevels = deepCopy(o.PetLevels)
		end
		if o.Teams then
			out.Teams = P3.cleanTeams(o.Teams)
		end
		if o.Battle then
			out.Battle = P3.cleanBattle(o.Battle)
		end
		if o.PetGrowth then
			out.PetGrowth = P4.cleanGrowth(o.PetGrowth)
		end
		if o.Ring then
			out.Ring = P4.cleanRing(o.Ring)
		end
		if o.Migrations then
			out.Migrations = cleanSet(o.Migrations)
		end
		if o.Dungeon then
			out.Dungeon = P5.cleanDungeon(o.Dungeon)
		end
		-- Store build (the dev reset; Store is never overwritten)
		if o.Daily then
			out.Daily = P7.cleanDaily(o.Daily)
		end
		if o.Trove then
			out.Trove = P7.cleanTrove(o.Trove)
		end
		if o.Pity then
			out.Pity = P7.cleanPity(o.Pity) -- lobby shop (the dev reset)
		end
	end
	-- HUD cleanup: the session's own item refund is left out when the store already holds another server's (the
	-- marker, read from the stored record before the union below): one save is refunded once
	local refunded = 0
	if tableOr(stored.Migrations)[P6.MARK] == true and isFinite(d.ItemsRefunded) and d.ItemsRefunded > 0 then
		refunded = d.ItemsRefunded
	end
	-- Store build (P7): ONE pass sums every grant the store already holds into `drop` (the twin rules: a receipt the
	-- stored set holds, a Trove ask set there, a daily claim paid there by another server or by this session's own
	-- earlier save that landed unconfirmed) while it merges the Trove / Daily / Store records by their rules (an
	-- overwritten Daily / Trove already is the session's whole value). The amounts then come off the Tokens / Pets /
	-- Cash / Gems / Berries deltas where each kind is applied below (`d` itself stays untouched: UpdateAsync may run
	-- this more than once). A dropped pet comes off the delta even when the session lost that copy again (a fuse, a
	-- release): the store's copy of the grant is the one that counts.
	local drop = P7.newDrop()
	if type(d.ReceiptGrants) == "table" then
		for id in pairs(tableOr(d.GemReceipts)) do
			if out.GemReceipts[id] ~= nil then
				P7.dropGrant(drop, d.ReceiptGrants[id])
			end
		end
	end
	if not (o and o.Trove) then
		P7.applyTrove(out, d.Trove, d.TroveGrants, drop)
	end
	if not (o and o.Daily) then
		P7.applyDaily(out, d.Daily, d.DailyClaims, drop)
	end
	P7.applyStore(out, d.Store, drop)
	local petDeltas = copyMap(d.Pets)
	for id, n in pairs(drop.Pets) do
		petDeltas[id] = (petDeltas[id] or 0) - n
	end
	out.Tokens = sanitize(out.Tokens + d.Tokens - refunded - drop.Tokens)
	applyCounts(out.Pets, petDeltas, Config.Pets.MaxPerStack)
	applyCounts(out.Items, d.Items, P6.REFUND_MAX)
	for key, delta in pairs(d.Stats) do
		if key == "TokensEarned" then
			delta = delta - refunded
		end
		out.Stats[key] = sanitize(out.Stats[key] + delta)
	end
	for id, seconds in pairs(d.BestTimes) do
		local current = out.Stats.BestTimes[id]
		if current == nil or seconds < current then
			out.Stats.BestTimes[id] = seconds
		end
	end
	if d.Equipped then
		out.Equipped = copyList(d.Equipped)
	end
	if d.HasSpot then
		out.SpotIndex = d.SpotIndex
	end
	-- v3
	for id in pairs(d.Discovered) do
		out.Discovered[id] = true
	end
	for id in pairs(d.IndexClaimed) do
		out.IndexClaimed[id] = true
	end
	if d.Tutorial then
		-- the session's step wins; Done and Gifted stick once true (the gift can never be paid twice)
		out.Tutorial = {
			Step = d.Tutorial.Step,
			Done = d.Tutorial.Done or out.Tutorial.Done,
			Gifted = d.Tutorial.Gifted or out.Tutorial.Gifted,
		}
	end
	-- Cash follows the Home's prestige rule (applyHome; a prestige resets Cash like the stations), and a star reward
	-- both sides paid counts once. B = the session's base prestige, L = its live prestige, S = the stored one:
	--   L > B and L > S  the session prestiged past the store: its balance (Cash since that prestige) is the Cash
	--   S > B, L == S    both prestiged to S: the session's Cash since its prestige joins the store's
	--   S > B, L < S     the store prestiged past the session's run: that run's Cash was reset (delta dropped)
	--   otherwise        a plain delta
	-- Skipped for a ResetFields Home (written over the store as it is) and a stand-in base (not store data).
	local cashDelta, gemDelta = d.Cash, d.Gems
	local cashDrop = drop.Cash -- the dropped Cash that is still in cashDelta (the prestige rule below narrows it)
	if not (o and o.Home) and not d.StandIn and isFinite(d.BasePrestige) and isFinite(d.LivePrestige) then
		local s, b, l = out.Home.Prestige, d.BasePrestige, d.LivePrestige
		if l > b and l > s then
			cashDelta = sanitizeCash(d.CashNow) - out.Cash
			cashDrop = 0
		elseif s > b then
			if l == s then
				cashDelta = sanitizeCash(d.CashNow)
				cashDrop = drop.CashAt[l] or 0
			else
				cashDelta = 0
				cashDrop = 0
			end
		end
		-- stars b+1 .. min(l, s) were reached and paid by the server that wrote the store too
		local top = math.min(l, s)
		for star, gems in pairs(type(d.StarGems) == "table" and d.StarGems or {}) do
			if star > b and star <= top and isFinite(gems) then
				gemDelta = gemDelta - gems
			end
		end
	end
	-- Store build (P7): a Cash / Gems grant the store already holds (a receipt, a claim or an ask paid elsewhere: `drop`
	-- above) comes off whatever delta survives the prestige rule, and only while that delta still holds it. When the
	-- rule replaced the Cash delta with the session's balance (it holds the grant once; the store's copy went with the
	-- balance it replaced) or reset it (that run's Cash was reset anyway), there is nothing to take off; when both
	-- sides prestiged to the stored star, the session's balance since its prestige holds only the grants paid AT that
	-- star (their Star): an earlier one went with the session's own prestige, and taking it off again would remove
	-- Cash the player earned.
	cashDelta = cashDelta - cashDrop
	gemDelta = gemDelta - drop.Gems
	out.Cash = sanitizeCash(out.Cash + cashDelta)
	out.Gems = sanitize(out.Gems + gemDelta)
	P7.applyLevels(out.PetLevels, d.PetLevels, drop) -- per key; a twin-dropped pet keeps the higher level
	-- Phase 2
	if not (o and o.Home) then
		applyHome(out, d.Home) -- an overwritten Home already is the session's whole Home
	end
	applyCounts(out.Food, d.Food, MAX_FOOD)
	applyReplace(out.Tiers, d.Tiers)
	applyReplace(out.Hybrids, d.Hybrids)
	for id, t in pairs(d.GemReceipts) do
		local current = out.GemReceipts[id]
		if current == nil or t > current then
			out.GemReceipts[id] = t
		end
	end
	trimReceipts(out.GemReceipts, d.GemReceipts)
	-- Phase 3: presets per preset, the battle record by its rules. An overwritten field already is the session's whole
	-- value (its counters must not count the session's delta a second time).
	if not (o and o.Teams) then
		P3.applyTeams(out, d.Teams)
	end
	if not (o and o.Battle) then
		P3.applyBattle(out, d.Battle)
	end
	-- Phase 4: growth per key (the higher Evo / ranks, the session's Job), the ring record (Best max, Runs delta),
	-- the migration markers (union; an overwritten set already holds the session's additions)
	if not (o and o.PetGrowth) then
		P4.applyGrowth(out, d.PetGrowth)
	end
	if not (o and o.Ring) then
		P4.applyRing(out, d.Ring)
	end
	-- Phase 5: whether the STORE already held the P5Home marker before this merge (another server converted the same
	-- Food into berries, or this session's own earlier save landed): read from the stored record itself, before the
	-- union below and regardless of a pending Migrations overwrite
	local homeMarked = tableOr(stored.Migrations)[P5.HOME_MARK] == true
	for name in pairs(tableOr(d.Migrations)) do
		if validKey(name) then
			out.Migrations[name] = true
		end
	end
	-- Phase 5: the dungeon record by its rules (an overwritten record already is the session's whole value), berries
	-- as a delta clamped at 0 (a two-server race costs at most one feed, Y9) MINUS the session's own Food conversion
	-- when the store was already marked P5Home (it holds the conversion then: two servers migrating one Phase 4 save
	-- do not double the berries, the twin of the m15 Clears rule), the settings of the live session
	if not (o and o.Dungeon) then
		P5.applyDungeon(out, d.Dungeon)
	end
	if isFinite(d.Berries) then
		local delta = d.Berries
		if homeMarked and isFinite(d.BerriesMigrated) and d.BerriesMigrated > 0 then
			delta = delta - d.BerriesMigrated
		end
		delta = delta - drop.Berries -- Store build: a berry grant the store already holds
		out.Berries = P5.cleanBerries(out.Berries + delta)
	end
	if type(d.Settings) == "table" then
		out.Settings = P5.cleanSettings(d.Settings)
	end
	-- lobby shop: the Secret pity counter (Spins delta, Hit max; an overwritten record already is the session's whole value)
	if not (o and o.Pity) then
		P7.applyPity(out, d.Pity)
	end
	-- last: the owned copies (Pets, Tiers, Hybrids), the Home and the growth map (the training lock) are final now
	discoverOwned(out)
	P3.prune(out, out.Teams)
	P3.syncEquipped(out)
	return out
end

-- Clean profile -> the table written to the store (no Rooms alias, slot maps encoded, empty Phase 2 maps left out).
local function toStored(p)
	local stats = { BestTimes = copyMap(p.Stats.BestTimes) }
	for _, key in ipairs(STAT_KEYS) do
		stats[key] = p.Stats[key]
	end
	local h = p.Home
	local rec = {
		Version = PROFILE_VERSION,
		Tokens = p.Tokens,
		Pets = copyMap(p.Pets),
		Equipped = copyList(p.Equipped),
		Items = copyMap(p.Items),
		Stats = stats,
		SpotIndex = p.SpotIndex,
		Discovered = copyMap(p.Discovered),
		IndexClaimed = copyMap(p.IndexClaimed),
		Tutorial = cleanTutorial(p.Tutorial),
		Cash = p.Cash,
		Gems = p.Gems,
		Home = {
			Level = h.Level,
			Prestige = h.Prestige,
			Stations = copyMap(h.Stations),
			Garden = encodeSlots(h.Garden),
			Gym = encodeSlots(h.Gym),
			CollectorCash = h.CollectorCash,
			LastSeen = h.LastSeen,
			LegacySlots = h.LegacySlots, -- Phase 4: absent unless the migration wrote them
			LegacyPrices = h.LegacyPrices,
			DecorCredit = h.DecorCredit, -- Phase 5: absent unless the fold wrote them
			LegacyMagnet = h.LegacyMagnet,
			LegacyMagnetStar = h.LegacyMagnetStar,
		},
		PetLevels = deepCopy(p.PetLevels),
	}
	if next(p.Food) ~= nil then
		rec.Food = copyMap(p.Food)
	end
	if next(p.Tiers) ~= nil then
		rec.Tiers = deepCopy(p.Tiers)
	end
	if next(p.Hybrids) ~= nil then
		rec.Hybrids = deepCopy(p.Hybrids)
	end
	if next(p.GemReceipts) ~= nil then
		rec.GemReceipts = copyMap(p.GemReceipts)
	end
	-- Phase 3: left out while they hold the defaults (most players never battle)
	if not P3.isDefaultTeams(p.Teams) then
		rec.Teams = P3.encodeTeams(p.Teams)
	end
	if not P3.isDefaultBattle(p.Battle) then
		rec.Battle = P3.encodeBattle(p.Battle)
		-- (a reward clock never started is left out: a save from before the raid clocks stays as it was until the first paid fight)
		rec.Battle.RaidRewardAt = rec.Battle.RaidRewardAt > 0 and rec.Battle.RaidRewardAt or nil
		rec.Battle.RaidLossAt = rec.Battle.RaidLossAt > 0 and rec.Battle.RaidLossAt or nil
	end
	-- Phase 4: left out while empty / default (zero numbers inside growth entries left out too)
	if next(p.PetGrowth) ~= nil then
		rec.PetGrowth = P4.encodeGrowth(p.PetGrowth)
	end
	if not P4.isDefaultRing(p.Ring) then
		rec.Ring = { Best = p.Ring.Best, Runs = p.Ring.Runs }
	end
	if next(p.Migrations) ~= nil then
		rec.Migrations = copyMap(p.Migrations)
	end
	-- Phase 5: left out while default / 0 (Cleared as a dense boolean array)
	if not P5.isDefaultDungeon(p.Dungeon) then
		rec.Dungeon = P5.encodeDungeon(p.Dungeon)
	end
	if p.Berries > 0 then
		rec.Berries = p.Berries
	end
	if not P5.isDefaultSettings(p.Settings) then
		rec.Settings = copyMap(p.Settings)
		if rec.Settings.FastHatch ~= true then
			rec.Settings.FastHatch = nil -- lobby shop: stored only when true (missing = false; old records stay as they were)
		end
	end
	-- Store build: left out while default / empty (PlayClaimed as a dense boolean array)
	if not P7.isDefaultStore(p.Store) then
		rec.Store = P7.encodeStore(p.Store)
	end
	if not P7.isDefaultDaily(p.Daily) then
		rec.Daily = P7.encodeDaily(p.Daily)
	end
	if next(p.Trove) ~= nil then
		rec.Trove = copyMap(p.Trove)
	end
	-- lobby shop: left out while 0 / 0 (an old record stays as it was until the first Secret Roulette spin)
	if not P7.isDefaultPity(p.Pity) then
		rec.Pity = { Secret = { Spins = p.Pity.Secret.Spins, Hit = p.Pity.Secret.Hit } }
	end
	return rec
end

-- Forward compatibility (runs inside UpdateAsync, so it stays pure): `record` was rebuilt from the keys this
-- version knows, so it gets back every stored key it does not own (top level, inside Home and inside Stats) and
-- a newer Version number. An older server still running after a later phase is published then never erases that
-- phase's data. Known keys are never copied back (a cleared SpotIndex must stay cleared, spent Food stays spent).
local function keepForeign(record, old)
	if type(old) ~= "table" then
		return record
	end
	for key, value in pairs(old) do
		if not KNOWN_TOP[key] then
			record[key] = value
		end
	end
	if type(old.Home) == "table" then
		for key, value in pairs(old.Home) do
			if not KNOWN_HOME[key] then
				record.Home[key] = value
			end
		end
	end
	if type(old.Stats) == "table" then
		for key, value in pairs(old.Stats) do
			if not KNOWN_STATS[key] then
				record.Stats[key] = value
			end
		end
	end
	if isFinite(old.Version) and old.Version > PROFILE_VERSION then
		record.Version = old.Version
	end
	return record
end

-- Clears `t` and copies `src` into it (deep copies of table values).
local function refill(t, src)
	for key in pairs(copyMap(t)) do
		t[key] = nil
	end
	for key, value in pairs(src) do
		t[key] = deepCopy(value)
	end
end

-- The table at holder[field], created when missing (replaceContents works in place).
local function ensureTable(holder, field)
	local t = holder[field]
	if type(t) ~= "table" then
		t = {}
		holder[field] = t
	end
	return t
end

-- Writes a clean home into the live home table IN PLACE (other modules may hold it); Rooms stays Stations.
local function writeHome(target, src)
	target.Level = src.Level
	target.Prestige = src.Prestige
	local stations = ensureTable(target, "Stations")
	refill(stations, src.Stations)
	target.Rooms = stations
	refill(ensureTable(target, "Garden"), src.Garden)
	refill(ensureTable(target, "Gym"), src.Gym)
	target.CollectorCash = src.CollectorCash
	target.LastSeen = src.LastSeen
	target.LegacySlots = src.LegacySlots -- Phase 4 (nil clears)
	target.LegacyPrices = src.LegacyPrices
	target.DecorCredit = src.DecorCredit -- Phase 5 (nil clears)
	target.LegacyMagnet = src.LegacyMagnet
	target.LegacyMagnetStar = src.LegacyMagnetStar
end

-- Overwrites the fields of `target` with `src` IN PLACE (other modules may hold the table).
local function replaceContents(target, src)
	target.Version = PROFILE_VERSION
	target.Tokens = src.Tokens
	target.SpotIndex = src.SpotIndex
	for _, field in ipairs({ "Pets", "Items", "Discovered", "IndexClaimed", "PetLevels", "Food", "Tiers", "Hybrids", "GemReceipts" }) do
		refill(ensureTable(target, field), src[field])
	end
	local equipped = ensureTable(target, "Equipped")
	for i = #equipped, 1, -1 do
		equipped[i] = nil
	end
	for i, id in ipairs(src.Equipped) do
		equipped[i] = id
	end
	local stats = ensureTable(target, "Stats")
	for _, key in ipairs(STAT_KEYS) do
		stats[key] = src.Stats[key]
	end
	refill(ensureTable(stats, "BestTimes"), src.Stats.BestTimes)
	-- v3 / Phase 2
	target.Cash = src.Cash
	target.Gems = src.Gems
	local tutorial = ensureTable(target, "Tutorial")
	tutorial.Step = src.Tutorial.Step
	tutorial.Done = src.Tutorial.Done
	tutorial.Gifted = src.Tutorial.Gifted
	writeHome(ensureTable(target, "Home"), src.Home)
	-- Phase 3 (in place too)
	refill(ensureTable(target, "Teams"), src.Teams)
	refill(ensureTable(target, "Battle"), src.Battle)
	-- Phase 4 (in place too)
	refill(ensureTable(target, "PetGrowth"), src.PetGrowth)
	refill(ensureTable(target, "Ring"), src.Ring)
	refill(ensureTable(target, "Migrations"), src.Migrations)
	-- Phase 5 (in place too)
	refill(ensureTable(target, "Dungeon"), src.Dungeon)
	target.Berries = src.Berries
	refill(ensureTable(target, "Settings"), src.Settings)
	-- Store build (in place too)
	refill(ensureTable(target, "Store"), src.Store)
	refill(ensureTable(target, "Daily"), src.Daily)
	refill(ensureTable(target, "Trove"), src.Trove)
	-- lobby shop (in place too: a rebase must bring another server's spins into the live count)
	refill(ensureTable(target, "Pity"), src.Pity)
end

-- Prunes the LIVE presets in place (keys no longer owned: fused away, released; a junk structure is repaired too) and
-- brings Equipped back to the invariant. Returns true when the live Teams or Equipped changed; the caller fires
-- TeamsChanged once it is done (handlers run at once: PetService republishes the followers).
function P3.pruneLive(entry)
	local profile = entry.Profile
	local teams = P3.teamsOf(profile)
	local changed = false
	if not deepEqual(profile.Teams, teams) then
		refill(ensureTable(profile, "Teams"), teams)
		changed = true
	end
	if P3.syncEquipped(profile) then
		changed = true
	end
	if changed then
		entry.Dirty = true
	end
	return changed
end

-- diffProfiles options of an entry: the gems of the receipts it marked, and whether its Base is a stand-in (the
-- load has not finished, or failed and was not recovered yet: the Base is defaults, not store data).
local function deltaOpts(entry)
	return {
		-- Store build: the grant records of the three twin rules (what the session paid for its receipts, its daily
		-- claims and its Trove asks that are not in the store yet)
		ReceiptGrants = entry.ReceiptGrants,
		DailyClaims = entry.DailyClaims,
		TroveGrants = entry.TroveGrants,
		StandIn = entry.LoadFailed == true or entry.Loaded ~= true,
		-- Phase 5: the Clears the session's own P5Dungeon migration wrote (merge as a max until the store holds them)
		DungeonMigrated = entry.DungeonMigrated,
		-- Phase 5: the berries the session's own P5Home step converted from Food (left out of the merge when the store
		-- already holds another server's conversion)
		BerriesMigrated = entry.BerriesMigrated,
		-- HUD cleanup: the Tokens the session's own item refund paid (left out when the store is already refunded)
		ItemsRefunded = entry.ItemsRefunded,
	}
end

-- Drops the grant records the entry no longer needs (after a confirmed save): receipts the store holds (they are in
-- Base) or the live profile lost (taken back / trimmed), daily claims the Base holds (a Day grant at or before its
-- LastClaimAt, a Play grant whose (PlayStart, tier) it holds or of an earlier play-day), Trove asks set in the Base or
-- gone from the live profile. Only grants still on their way to the store are looked up by diffProfiles.
function P7.pruneGrants(entry)
	local base = type(entry.Base) == "table" and entry.Base or {}
	local receipts = entry.ReceiptGrants
	if type(receipts) == "table" then
		local live = tableOr(entry.Profile.GemReceipts)
		local saved = tableOr(base.GemReceipts)
		for id in pairs(copyMap(receipts)) do
			if live[id] == nil or saved[id] ~= nil then
				receipts[id] = nil
			end
		end
		if next(receipts) == nil then
			entry.ReceiptGrants = nil
		end
	end
	if type(entry.DailyClaims) == "table" then
		local left = P7.pendingClaims(entry.DailyClaims, P7.cleanDaily(base.Daily))
		entry.DailyClaims = #left > 0 and left or nil
	end
	local asks = entry.TroveGrants
	if type(asks) == "table" then
		local live = tableOr(entry.Profile.Trove)
		local saved = tableOr(base.Trove)
		for ask in pairs(copyMap(asks)) do
			if live[ask] == nil or saved[ask] ~= nil then
				asks[ask] = nil
			end
		end
		if next(asks) == nil then
			entry.TroveGrants = nil
		end
	end
end

-- Moves the live profile onto freshly read store data while keeping everything the session did
-- since `fromBase`. `newBase` becomes the new "known to be in the store" reference. A pending ResetFields
-- keeps the session's values of its fields (they are still to be written over the store).
local function rebase(entry, fromBase, stored, newBase)
	local d = diffProfiles(entry.Profile, fromBase, entry.Overwrite, deltaOpts(entry))
	local merged = applyDelta(stored, d)
	replaceContents(entry.Profile, merged)
	entry.Base = copyProfile(newBase)
end

----------------------------------------------------------------------
-- Player mirrors + remotes
----------------------------------------------------------------------

-- Mirror a token total onto the player (attribute for the HUD, leaderstats for the leaderboard).
local function pushToPlayer(player, value)
	if not player or not player.Parent then
		return
	end
	player:SetAttribute(Config.Attr.Tokens, value)
	local stats = player:FindFirstChild("leaderstats")
	local tokensValue = stats and stats:FindFirstChild("Tokens")
	if tokensValue then
		tokensValue.Value = value
	end
end

-- Mirror the Cash / Gems balances (whole units) onto the player for the HUD currency stack.
local function pushCurrencies(player, profile)
	if not player or not player.Parent or type(profile) ~= "table" then
		return
	end
	if Config.Attr.Cash then
		player:SetAttribute(Config.Attr.Cash, sanitizeCash(profile.Cash))
	end
	if Config.Attr.Gems then
		player:SetAttribute(Config.Attr.Gems, sanitize(profile.Gems))
	end
end

-- Phase 5: mirrors the whole berries onto the player (Config.Attr.Berries) at most twice a second per player: the
-- first write goes out at once, later ones wait for the end of the BERRIES_GAP window (a trailing write; a Berries-only
-- change never triggers a ProfileSync, C14). `now` forces the write (load, leave).
function P5.pushBerries(player, now)
	if not player or not player.Parent or not Config.Attr.Berries then
		return
	end
	local userId = player.UserId
	local entry = cache[userId]
	if not entry then
		return
	end
	local push = P5.pushes[userId]
	if not push then
		push = { last = -math.huge, queued = false }
		P5.pushes[userId] = push
	end
	local clock = os.clock()
	if now or clock - push.last >= P5.BERRIES_GAP then
		push.last = clock
		player:SetAttribute(Config.Attr.Berries, P5.cleanBerries(entry.Profile.Berries))
		return
	end
	if push.queued then
		return
	end
	push.queued = true
	task.delay(P5.BERRIES_GAP - (clock - push.last), function()
		push.queued = false
		if cache[userId] == entry and player.Parent then
			push.last = os.clock()
			player:SetAttribute(Config.Attr.Berries, P5.cleanBerries(entry.Profile.Berries))
		end
	end)
end

local function pushAll(player, profile)
	pushToPlayer(player, profile.Tokens)
	pushCurrencies(player, profile)
	P5.pushBerries(player, true)
end

local function getRemote(name)
	local cached = remoteCache[name]
	if cached and cached.Parent then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		remoteCache[name] = remote
		return remote
	end
	return nil
end

local PERK_KEYS = { "MaxHealth", "TokenBonus", "StaminaRegen", "CheckpointHeal" }

-- Perk totals of a list of keys: each copy's perks x its tier multiplier (PetKeys.DefOf + StatMultiplier), each total
-- capped and rounded like PetCatalog.SumPerks (so Normal-only lists give exactly the same numbers).
local function sumKeyPerks(keys, equipped, profile)
	local sums = {}
	for _, key in ipairs(PERK_KEYS) do
		sums[key] = 0
	end
	for _, key in ipairs(equipped) do
		local ok, def = pcall(keys.DefOf, key, profile)
		if ok and type(def) == "table" and type(def.Perks) == "table" then
			local mult = 1
			if def.Tier ~= nil and type(keys.StatMultiplier) == "function" then
				local okMult, m = pcall(keys.StatMultiplier, def.Tier)
				if okMult and isFinite(m) and m > 0 then
					mult = m
				end
			end
			for perk, value in pairs(def.Perks) do
				if sums[perk] ~= nil and type(value) == "number" then
					sums[perk] = sums[perk] + value * mult
				end
			end
		end
	end
	local caps = Config.Pets.PerkCaps
	for perk, total in pairs(sums) do
		local cap = caps[perk]
		if type(cap) == "number" and total > cap then
			total = cap
		end
		sums[perk] = math.floor(total * 10000 + 0.5) / 10000
	end
	return sums
end

-- Equipped keys -> { MaxHealth, TokenBonus, StaminaRegen, CheckpointHeal } (summed, capped). `profile` is needed for
-- hybrid keys (their record); plain pet ids and tier keys work without it.
function DataService.ComputePerks(equipped, profile)
	local perks = { MaxHealth = 0, TokenBonus = 0, StaminaRegen = 0, CheckpointHeal = 0 }
	if type(equipped) ~= "table" then
		return perks
	end
	local summed = nil
	local keys = getPetKeys()
	if keys and type(keys.DefOf) == "function" then
		local ok, result = pcall(sumKeyPerks, keys, equipped, profile)
		if ok then
			summed = result
		end
	end
	if not summed then
		local catalog = getPetCatalog()
		if catalog and type(catalog.SumPerks) == "function" then
			local ok, result = pcall(catalog.SumPerks, equipped)
			if ok and type(result) == "table" then
				summed = result
			end
		end
	end
	if type(summed) == "table" then
		for _, key in ipairs(PERK_KEYS) do
			local value = summed[key]
			if isFinite(value) and value > 0 then
				local cap = Config.Pets.PerkCaps[key]
				if cap and value > cap then
					value = cap
				end
				perks[key] = value
			end
		end
	end
	return perks
end

-- Discovered ids for the client (owned pets always included): only pets the catalog knows (a retired
-- pet must not count towards "Unlocked: x/N"). Without a catalog the set is sent unfiltered.
local function discoveredSnapshot(profile)
	local set = cleanSet(profile.Discovered)
	for id, count in pairs(tableOr(profile.Pets)) do
		if validKey(id) and type(count) == "number" and count > 0 then
			set[id] = true
		end
	end
	for id in pairs(cleanTiers(profile.Tiers)) do
		set[id] = true
	end
	local catalog = getPetCatalog()
	if not catalog or type(catalog.Get) ~= "function" then
		return set
	end
	local out = {}
	for id in pairs(set) do
		local ok, def = pcall(catalog.Get, id)
		if ok and def then
			out[id] = true
		end
	end
	return out
end

-- What the client sees of the Home (slot maps encoded like the store; no LastSeen).
local function homeSnapshot(rawHome)
	local h = cleanHome(rawHome, false)
	return {
		Level = h.Level,
		Prestige = h.Prestige,
		Stations = h.Stations,
		Garden = encodeSlots(h.Garden),
		Gym = encodeSlots(h.Gym),
		CollectorCash = h.CollectorCash,
		LegacySlots = h.LegacySlots, -- Phase 4 (absent for most homes)
		LegacyPrices = h.LegacyPrices,
		DecorCredit = h.DecorCredit, -- Phase 5 (the fold; absent for most homes)
		LegacyMagnet = h.LegacyMagnet,
		LegacyMagnetStar = h.LegacyMagnetStar,
	}
end

-- What the client (and GetTeams) sees of the battle teams: the pruned presets, the active one, the slot count and the
-- busy keys.
function P3.teamsSnapshot(profile)
	local out = P3.encodeTeams(P3.teamsOf(profile))
	out.Slots = P3.slotsOf(profile)
	out.Busy = P3.busyOf(profile)
	return out
end

-- Plain-table snapshot for the client (no Instances, no shared references).
local function buildSnapshot(profile)
	local stats = profile.Stats
	return {
		Tokens = profile.Tokens,
		Pets = copyMap(profile.Pets),
		Equipped = copyList(profile.Equipped),
		Stats = {
			Matches = stats.Matches,
			Wins = stats.Wins,
			TokensEarned = stats.TokensEarned,
			Spins = stats.Spins,
			BestTimes = copyMap(stats.BestTimes),
		},
		SpotIndex = profile.SpotIndex,
		Perks = DataService.ComputePerks(profile.Equipped, profile),
		-- v3
		Discovered = discoveredSnapshot(profile),
		IndexClaimed = cleanSet(profile.IndexClaimed),
		Tutorial = cleanTutorial(profile.Tutorial),
		-- Phase 2
		Cash = sanitizeCash(profile.Cash),
		Gems = sanitize(profile.Gems),
		Home = homeSnapshot(profile.Home),
		Food = cleanCounts(profile.Food, MAX_FOOD),
		Tiers = cleanTiers(profile.Tiers),
		Hybrids = cleanHybrids(profile.Hybrids),
		PetLevels = copyPetLevels(profile.PetLevels),
		-- Phase 3 (small: 3 presets of up to 4 keys, a handful of numbers, one boolean per trial level)
		Teams = P3.teamsSnapshot(profile),
		Battle = P3.syncBattle(profile.Battle), -- (lobby-shop 16.12: without the duel record, server-only)
		-- Phase 4 (growth entries without their zero numbers; the ring record always whole)
		PetGrowth = P4.encodeGrowth(P4.cleanGrowth(profile.PetGrowth)),
		Ring = P4.cleanRing(profile.Ring),
		-- Phase 5 (<= 60 B dungeon record with a dense Cleared array, the berries, every setting always)
		Dungeon = P5.encodeDungeon(P5.cleanDungeon(profile.Dungeon)),
		Berries = P5.cleanBerries(profile.Berries),
		Settings = P5.cleanSettings(profile.Settings),
	}
end

----------------------------------------------------------------------
-- DataStore access
----------------------------------------------------------------------

-- Records a DataStore failure. Studio without API access is expected, so it stays silent there.
local function noteFailure(what, err)
	local message = tostring(err)
	if
		string.find(message, "StudioAccessToApisNotAllowed", 1, true)
		or string.find(message, "Studio access to APIs", 1, true)
		or string.find(message, "Enable Studio Access", 1, true)
		or string.find(message, "Cannot write to DataStore from studio", 1, true) -- a write's refusal (403); the claim is one
		or string.find(message, "publish this place", 1, true) -- an unpublished place in Studio
	then
		storeDisabled = true -- stop hammering an API that will keep refusing us
		return
	end
	if not IS_STUDIO then
		warn(string.format("[DataService] %s failed: %s", what, message))
	end
end

-- The DataStore object, or nil when unavailable. Resolved lazily and only once.
local function getStore()
	if storeDisabled then
		return nil
	end
	if not storeResolved then
		storeResolved = true
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.Tokens.DataStoreName)
		end)
		if ok then
			store = result
		else
			noteFailure("GetDataStore", result)
		end
	end
	return store
end

-- true while the entry holds stand-in defaults: its load failed although the store is usable (an outage), and the
-- recovery has not read the real save yet. Without a usable store (Studio without API access) the in-memory
-- profile is all there is, so it is never provisional.
local function isProvisional(entry)
	return entry ~= nil and entry.LoadFailed == true and getStore() ~= nil
end

local function getLegacyStore()
	if storeDisabled then
		return nil
	end
	if not legacyResolved then
		legacyResolved = true
		local name = Config.Tokens.LegacyDataStoreName
		if type(name) == "string" and name ~= "" then
			local ok, result = pcall(function()
				return DataStoreService:GetDataStore(name)
			end)
			if ok then
				legacyStore = result
			else
				noteFailure("GetDataStore(legacy)", result)
			end
		end
	end
	return legacyStore
end

-- GetAsync with one retry (`attempts` 2 by default; the claim loop and the recovery pass 1 for the v1 read: their loop
-- is the retry, so the entry lock is never held across RETRY_DELAY). Returns ok:boolean, value.
local function readKey(dataStore, key, attempts)
	local tries = attempts or 2
	for attempt = 1, tries do
		local ok, result = pcall(function()
			return dataStore:GetAsync(key)
		end)
		if ok then
			return true, result
		end
		noteFailure("load", result)
		if storeDisabled or attempt >= tries then
			break
		end
		task.wait(RETRY_DELAY)
	end
	return false, nil
end

----------------------------------------------------------------------
-- The session lock (helpers; see the header and the P8 table)
----------------------------------------------------------------------

-- A Config.Save number (the spec's default when the key is missing or junk).
function P8.num(key)
	local save = Config.Save
	local n = type(save) == "table" and tonumber(save[key]) or nil
	if n and n == n and n >= 0 and n < math.huge then
		return n
	end
	return P8.DEFAULTS[key]
end

-- The usable lock of a stored record: { Id, At } (At sanitised), or nil when there is none or it is junk (a string Id
-- and a finite At are required). Pure.
function P8.lockOf(raw)
	local lock = type(raw) == "table" and raw.Lock or nil
	if type(lock) ~= "table" or type(lock.Id) ~= "string" or not isFinite(lock.At) then
		return nil
	end
	return { Id = lock.Id, At = sanitizeTime(lock.At) }
end

-- true when `lock` (a P8.lockOf answer) no longer protects the record (spec 10, in this order): no lock / junk; its At is
-- LockSeconds old or older (a crashed server's lock expired); its At is more than LockSeconds in the future (a junk
-- clock); the Studio rule: a Studio server treats another Studio session's lock as free (a force-closed Studio never
-- locks the owner out); a live server's lock is honoured in Studio too. Pure.
function P8.stale(lock, now)
	if type(lock) ~= "table" or type(lock.Id) ~= "string" or not isFinite(lock.At) then
		return true
	end
	local ttl = P8.num("LockSeconds")
	if now - lock.At >= ttl or lock.At - now > ttl then
		return true
	end
	return IS_STUDIO and string.sub(lock.Id, 1, 7) == "studio-"
end

-- true when a live lock of ANOTHER server protects the record `raw` at `now`. Pure.
function P8.foreign(raw, now)
	local lock = P8.lockOf(raw)
	if lock and lock.Id ~= P8.Id and not P8.stale(lock, now) then
		return lock
	end
	return nil
end

-- This server's lock record, stamped `now`.
function P8.lockRecord(now)
	return { Id = P8.Id, Job = game.JobId, Place = game.PlaceId, At = now }
end

-- A record that holds nothing but a lock (a brand-new player's claim: no Version, no Tokens) counts as "nothing stored".
-- Every real save writes Version and Tokens (toStored), so no older record is ever taken for one.
function P8.lockOnly(raw)
	return type(raw) == "table" and raw.Version == nil and raw.Tokens == nil and raw.Lock ~= nil
end

-- true when the stored record `raw` carries THIS server's lock (fresh or stale). Pure.
function P8.ours(raw)
	local lock = P8.lockOf(raw)
	return lock ~= nil and lock.Id == P8.Id
end

-- Review round 1: true while this server's cached lock cannot have expired: the entry holds it and its last landed write
-- (entry.LockAt, the stamp written) is less than LockSeconds - SKEW old. Past that another server may have taken the
-- record (a stale steal, even one it released since), so the cached profile is not served as current (loadEntry
-- claims again), OwnsSave answers false, and the next write goes ahead only into a record that still holds this
-- server's lock (writeEntry's strict guard).
function P8.trusted(entry)
	if entry.LockHeld ~= true then
		return false
	end
	return os.time() - (entry.LockAt or 0) < P8.window()
end

-- The trust window: LockSeconds - SKEW (half the TTL when that is too short).
function P8.window()
	local ttl = P8.num("LockSeconds")
	return ttl > 2 * P8.SKEW and ttl - P8.SKEW or ttl / 2
end

-- Review round 2: a new write nonce (WriteId) of this module copy.
function P8.nonce()
	P8.Seq = P8.Seq + 1
	return P8.Run .. "-" .. tostring(P8.Seq)
end

-- Review round 2: whether the stored record `raw` was last written by this entry: its WriteId is the last landed write
-- (entry.LandedWrite: true) or one sent since whose answer never came (entry.SentWrite[id]: that write's record, see
-- writeEntry). Every write of any server stamps its own nonce and every claim clears it, so the record has not moved
-- since. Otherwise false. Pure.
function P8.mine(entry, raw)
	local id = type(raw) == "table" and raw.WriteId or nil
	if type(id) ~= "string" then
		return false
	end
	if type(entry.SentWrite) == "table" and type(entry.SentWrite[id]) == "table" then
		return entry.SentWrite[id]
	end
	return id == entry.LandedWrite
end

-- Review round 1: the entry becomes a true stand-in (defaults, nothing unsaved): a provisional entry never shows real
-- data, whose balances the server that owns the save may be spending meanwhile (a spend on a stand-in fails on its 0
-- balance). Used when the store wins (a guard trip with the player here) and when the re-claim of a cached entry
-- finds the record held by another server: the session's unsaved changes are dropped, as the guard drops them (spec
-- 8); the grant records go with them (a receipt never saved answers NotProcessedYet and Roblox asks again).
function P8.standIn(entry)
	entry.ReceiptGrants, entry.DailyClaims, entry.TroveGrants, entry.Overwrite = nil, nil, nil, nil
	entry.DungeonMigrated, entry.BerriesMigrated, entry.ItemsRefunded = nil, nil, nil
	replaceContents(entry.Profile, newProfile())
	entry.Base = newProfile()
end

-- true when this server's UpdateAsync request budget is under P8.BUDGET (an unanswered budget call counts as enough).
function P8.writeBudgetLow()
	local ok, n = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
	end)
	return ok and type(n) == "number" and n < P8.BUDGET
end

-- The player attribute Config.Attr.SaveWaiting: true while the load waits for (or the session plays provisionally
-- because of) another server's lock; removed (nil) once this server's claim landed. Written only when it changes.
function P8.setWaiting(userId, on)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return
	end
	local attr = (Config.Attr and Config.Attr.SaveWaiting) or "SaveWaiting"
	pcall(function()
		if on then
			if player:GetAttribute(attr) ~= true then
				player:SetAttribute(attr, true)
			end
		elseif player:GetAttribute(attr) ~= nil then
			player:SetAttribute(attr, nil)
		end
	end)
end

-- One claim attempt (spec 6.1): ONE UpdateAsync whose pure, non-yielding callback takes the lock (a shallow copy of the
-- record with only Lock changed: no profile rebuild, so a newer or older build's fields stay as they are) or refuses it
-- (another server's live lock: nil = no write). The last run's outcome travels through upvalues (the callback may run
-- more than once). A stored value that is not a table is left alone (claimed without a write: the next save writes the
-- record with the lock). Returns ok, seenRaw, held ({ Id, At } of the refusing lock).
-- Review round 2, with the cache `entry`: a claim that wrote is recorded on the entry the moment UpdateAsync returns
-- (LockHeld / LockAt / ClaimLanded), before the read is normalised, so an error after it (Load's pcall fallback, the
-- claim loop's pcall) still leaves an entry whose release lets go of the lock; a claim that errored may have committed
-- (its answer lost): entry.ClaimSent = true until a later claim is answered or the stand-in's release clears it (P8.letGo).
-- Release step 1 follow-up (the v1-only rollback gap), `seed`: a record that holds nothing yet (no record, or only a
-- dead claim's lock: P8.lockOnly) is NOT claimed by a call without `seed`: no write, the 4th value `empty` is true, and
-- the caller reads the v1 store first (fetchProfile). The second call passes seed = { Tokens = n } (the v1 balance) or
-- false (no v1 save): when the record is still empty its claim writes the lock AND, for a v1 player, Tokens = n in the
-- same write (the 5th value `written` = that record). So no record ever holds a lock without the v1 balance: a server
-- of the live build (main reads any stored record as a v2 save and then never looks at v1) still finds the Tokens when
-- this server dies before its first full save. A brand-new player's claim is still the lock-only record.
function P8.claim(dataStore, key, entry, seed)
	local seen, held, stamp, empty, written = nil, nil, nil, false, nil
	local ok, err = pcall(function()
		dataStore:UpdateAsync(key, function(old)
			local now = os.time()
			seen, stamp, empty, written = old, nil, false, nil
			held = P8.foreign(old, now)
			if held or (old ~= nil and type(old) ~= "table") then
				return nil
			end
			local nothing = old == nil or P8.lockOnly(old)
			if nothing and seed == nil then
				empty = true
				return nil -- nothing stored: the v1 store is read before anything is written (no write)
			end
			local rec = {}
			if type(old) == "table" then
				for k, v in pairs(old) do
					rec[k] = v
				end
			end
			if nothing and type(seed) == "table" then
				rec.Tokens = seed.Tokens -- the v1 balance travels with the lock (never a lock-only record over a v1 save)
				written = rec
			end
			rec.Lock = P8.lockRecord(now)
			rec.WriteId = nil -- review round 2: a claim ends what the last writer can call its own (P8.mine)
			stamp = now
			return rec
		end)
	end)
	if not ok then
		noteFailure("load", err)
		if entry then
			entry.ClaimSent = true
		end
		return false, nil, nil
	end
	if entry then
		entry.ClaimSent = nil -- answered: it landed (LockHeld from here) or it was refused (another lock is in the record)
		if stamp then
			entry.LockHeld, entry.LockAt, entry.ClaimLanded = true, stamp, true
		end
	end
	return true, seen, held, empty, written
end

-- Reads a player's stored profile.
-- Returns ok, profile|nil, migrated. ok=false means "could not read" (nothing may be assumed).
-- profile == nil with ok=true means a brand-new player. migrated=true means the profile was built
-- from a v1 save and the v2 key does not exist yet. `attempts`: readKey's (nil = 2).
-- Session lock: with `claim` the v2 read is P8.claim (one UpdateAsync: the record is read AND this server's lock
-- written); the 6th value `held` = { Id, At } when another server's live lock refused it (ok false), the 7th `wrote` =
-- the claim landed (the record holds this server's lock even when the v1 read after it failed), the 8th `ours` = the
-- record read already held THIS server's lock (nobody else took it since this server's last write: review round 1).
-- A lock-only record counts as nothing stored, in both modes. (The load and the recovery always claim; the plain-read
-- mode lost its last caller with the gem settle read, 2026-11-10.) Review round 2: `claim` is the cache entry (P8.claim
-- records a landed claim on it at once).
-- Release step 1 follow-up (the v1-only rollback gap): with `claim`, a record that holds nothing yet is not written by
-- the first P8.claim (`empty`); the v1 store is read, then a second P8.claim writes the lock together with the v1
-- balance (see P8.claim). The profile is then read from that record as a stored save (migrated = false: its Tokens ARE
-- in the store, so the first save adds no v1 delta on top). A v1 read that fails leaves the record untouched (wrote
-- false). The v1 store is read once per load, as before; a player with nothing stored costs one more UpdateAsync.
local function fetchProfile(userId, attempts, claim)
	local s = getStore()
	if not s then
		return false, nil, false
	end
	local ok, raw, held
	local legacyRead = false -- claim mode: the v1 store was read already (and held nothing)
	if claim then
		local entry = type(claim) == "table" and claim or nil
		local empty, written
		ok, raw, held, empty = P8.claim(s, keyFor(userId), entry)
		if ok and held then
			return false, nil, false, false, nil, held, false
		end
		if ok and empty then
			local seed = false
			local legacy = getLegacyStore()
			if legacy then
				local okLegacy, old = readKey(legacy, keyFor(userId), attempts)
				if not okLegacy then
					return false, nil, false, false, nil, nil, false
				end
				if old ~= nil then
					if type(old) == "table" then
						seed = { Tokens = sanitize(old.Tokens) }
					else
						seed = { Tokens = sanitize(old) }
					end
				end
			end
			legacyRead = true
			ok, raw, held, empty, written = P8.claim(s, keyFor(userId), entry, seed)
			if ok and held then
				return false, nil, false, false, nil, held, false
			end
			if ok and written then
				return true, normalizeProfile(written), false, false, nil, nil, true, P8.ours(raw)
			end
		end
	else
		ok, raw = readKey(s, keyFor(userId), attempts)
	end
	if not ok then
		return false, nil, false
	end
	local wrote = claim ~= nil and claim ~= false
	local ours = P8.ours(raw)
	if raw ~= nil and not P8.lockOnly(raw) then
		-- the 4th value: the raw record held a preset longer than 3 keys (Phase 5, 4.8: Load fires TeamsChanged once);
		-- the 5th: the keys P3.gardenSolo took out of the Garden (bug batch 2 #18) or nil
		local info = {}
		local profile = normalizeProfile(raw, info)
		return true, profile, false, P5.hadLongPreset(raw), info.GardenMoved, nil, wrote, ours
	end
	if legacyRead then
		return true, nil, false, false, nil, nil, wrote, ours -- (claim mode) nothing in v2 and no v1 save: a brand-new player
	end
	-- Nothing in v2: look for a v1 save to migrate.
	local legacy = getLegacyStore()
	if legacy then
		local okLegacy, old = readKey(legacy, keyFor(userId), attempts)
		if not okLegacy then
			return false, nil, false, false, nil, nil, wrote
		end
		if old ~= nil then
			local migrated = newProfile()
			if type(old) == "table" then
				migrated.Tokens = sanitize(old.Tokens)
			else
				migrated.Tokens = sanitize(old)
			end
			return true, migrated, true, false, nil, nil, wrote, ours
		end
	end
	return true, nil, false, false, nil, nil, wrote, ours
end

-- The load's claim loop (spec 6.2): one fetchProfile claim per attempt (the loop is the retry). Claimed -> done. Held by
-- another server's live lock -> SaveWaiting = true (first time), give up as held once ClaimWaitSeconds have passed on
-- the clock since the loop began (review round 1: slow or queued calls count, not only the sleeps; the player left or
-- the server is closing: at once), else wait ClaimRetrySeconds (at most what is left) and try again: attempts at 0, 3,
-- 6, 9, 12 s with fast calls. An error / outage -> a second error gives up as failed (today's two attempts), else wait
-- RETRY_DELAY. Returns fetchProfile's tuple (fetched, profile, migrated, trimmed, moved, held, wrote, ours);
-- entry.HeldBy keeps the last refusing lock.
function P8.claimLoop(entry, userId)
	local from, errors, wrote = os.clock(), 0, false
	entry.ClaimLanded = nil
	while true do
		local pok, fetched, profile, migrated, trimmed, moved, held, didWrite, ours = pcall(fetchProfile, userId, 1, entry)
		if not pok then
			warn("[DataService] fetch errored: " .. tostring(fetched))
			fetched, held, didWrite = false, nil, false
		end
		-- (review round 2: a claim that landed before the read after it errored counts as written: entry.ClaimLanded)
		wrote = wrote or didWrite == true or entry.ClaimLanded == true
		if fetched then
			return true, profile, migrated, trimmed == true, moved, nil, true, ours == true
		end
		if held then
			entry.HeldBy = held
			P8.setWaiting(userId, true)
			local left = P8.num("ClaimWaitSeconds") - (os.clock() - from)
			if left <= 0 or shuttingDown or not Players:GetPlayerByUserId(userId) then
				return false, nil, false, false, nil, held, wrote
			end
			task.wait(math.min(math.max(P8.num("ClaimRetrySeconds"), 0.1), left))
		else
			errors = errors + 1
			if errors >= 2 or storeDisabled or not getStore() then
				return false, nil, false, false, nil, nil, wrote
			end
			task.wait(RETRY_DELAY)
		end
	end
end

-- The claim landed (a load, a re-claim or a recovery): this server holds the lock from now on.
function P8.claimed(entry, userId)
	entry.LockHeld = true
	entry.LockAt = os.time()
	entry.HeldBy = nil
	P8.setWaiting(userId, false)
end

-- A claim attempt that did not end in a profile: the entry plays provisionally; it still holds the lock when the claim
-- itself landed (the v1 read after it failed): its writes keep or release it like any other.
function P8.notClaimed(entry, wrote)
	entry.LoadFailed = true
	if wrote then
		entry.LockHeld = true
		entry.LockAt = os.time()
	end
end

-- The lock's flag (spec 12; the retired gem settle hold's API): the first time in a load of a Player (entry.SettledFired,
-- reset by Load on every (re)join) that this server owns the save (OwnsSave: at the load, or at the recovery's claim),
-- Settled fires. Review round 2: the player attribute Config.Attr.GemsSettled follows the flag: true while OwnsSave is
-- true, removed (nil, never written false) when it turns false with the player here (a guard trip, a release that
-- landed after a rejoin, the trust window running out: P8.lapsed after the next save attempt); the next landed
-- non-release write sets it again
-- (Settled still fires once per load). Never yields.
function P8.settled(entry, userId)
	if cache[userId] ~= entry then
		return
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return
	end
	local attr = (Config.Attr and Config.Attr.GemsSettled) or "GemsSettled"
	local owns = DataService.OwnsSave(player) == true
	pcall(function()
		if owns and player:GetAttribute(attr) ~= true then
			player:SetAttribute(attr, true)
		elseif not owns and player:GetAttribute(attr) ~= nil then
			player:SetAttribute(attr, nil)
		end
	end)
	if not owns then
		return
	end
	if entry.SettledFired ~= true then
		entry.SettledFired = true
		DataService.Settled:Fire(player)
	end
end

-- Review round 2: the flag also lapses without a write (the trust window ran out while every write failed): after every
-- save attempt (saveEntry: the autosave sweep, the orphan retries, Save) the attribute is removed when OwnsSave is false
-- with the player here. Only the removal: Settled and the attribute's true stay with P8.settled (Load, the recovery, a
-- landed write), so a save never fires Settled before ProfileLoaded. No timer threads.
function P8.lapsed(entry, userId)
	local player = cache[userId] == entry and Players:GetPlayerByUserId(userId) or nil
	if player and DataService.OwnsSave(player) ~= true then
		P8.settled(entry, userId)
	end
end

----------------------------------------------------------------------
-- Cache entries, locking, loading
----------------------------------------------------------------------

local function ensureEntry(userId)
	local entry = cache[userId]
	if not entry then
		entry = {
			Profile = newProfile(),
			Base = newProfile(),
			Loaded = false,
			Loading = false,
			LoadFailed = false,
			Saving = false,
			Dirty = false,
			RecoveryScheduled = false,
			Orphan = false,
			OrphanSince = 0,
			OrphanScheduled = false,
		}
		cache[userId] = entry
	end
	return entry
end

-- Waits (bounded) for an in-flight load to finish. Session lock: a load may wait ClaimWaitSeconds for another server's
-- lock plus one RETRY_DELAY (spec 6.2), so the bound is that plus 4 s.
local function waitForLoad(entry)
	local bound = P8.num("ClaimWaitSeconds") + RETRY_DELAY + 4
	local waited = 0
	while entry.Loading and waited < bound do
		task.wait(0.1)
		waited = waited + 0.1
	end
end

-- Simple per-entry write lock (autosave vs. PlayerRemoving vs. BindToClose vs. recovery).
local function acquire(entry)
	local waited = 0
	while entry.Saving and waited < 20 do
		task.wait(0.25)
		waited = waited + 0.25
	end
	if entry.Saving then
		return false
	end
	entry.Saving = true
	return true
end

local function loadEntry(player)
	local userId = player.UserId
	local entry = ensureEntry(userId)
	if entry.Loading then
		waitForLoad(entry)
		return entry, false
	end
	-- Session lock (spec 6.5): a loaded entry is current while it holds a lock that cannot have expired (P8.trusted: a
	-- quick rejoin before the leave's release landed, or an orphan whose release failed: the record cannot have moved)
	-- or while its recovery runs. Any other cached entry claims again (review round 1):
	--   * released (a rejoin raced the leave: the entry is not dropped yet): the record may hold another server's data by
	--     now, which the claim brings in (rebase, the late writes kept on top; Load announces it to the new Player);
	--   * holding a lock that may have expired (its writes failed for LockSeconds - SKEW): when the record read still
	--     holds this server's lock nobody took it (rebase, nothing lost); otherwise another server took it, perhaps
	--     released it since: the store wins and the stale session's unsaved changes are dropped (a stale server never
	--     saves, spec 8). A failed read leaves such an entry as it is (its writes stay strict, OwnsSave false);
	--   * a re-claim another server holds (or that failed for a released entry) plays on a true stand-in (P8.standIn),
	--     never on the cached data that server may be spending.
	local again = entry.Loaded == true
	if again and (entry.LoadFailed or getStore() == nil or P8.trusted(entry)) then
		if entry.LoadFailed and entry.HeldBy then
			P8.setWaiting(userId, true) -- review round 2: the new Player of a held-provisional session sees the wait too
		end
		return entry, false
	end
	local expired = again and entry.LockHeld == true

	entry.Loading = true
	local fetched, stored, migrated, trimmed, moved, held, wrote, ours = P8.claimLoop(entry, userId)

	if fetched then
		-- Anything the session did before the load finished (early AddTokens) is kept on top.
		local source = stored or newProfile()
		local newBase = newProfile()
		if stored and not migrated then
			newBase = source
		end
		if expired and not ours then
			P8.standIn(entry) -- another server had the record since: nothing of the stale session is kept
		elseif again and migrated then
			-- review round 2: the record is still lock-only (nothing of the cached session landed): its profile already holds
			-- the v1 tokens on a defaults Base, so the re-read v1 balance must not be added on top again
			source = newProfile()
		end
		rebase(entry, entry.Base, source, newBase)
		entry.LoadFailed = false
		if trimmed then
			entry.TeamsTrimmed = true -- Phase 5 (4.8): a stored 4-key preset loads with 3; Load fires TeamsChanged once
		end
		entry.GardenMoved = moved -- bug batch 2 #18: pets that left the Garden on this read (P3.gardenAnnounce)
		P8.claimed(entry, userId)
	elseif expired and not held and not wrote then
		P8.setWaiting(userId, false) -- the store could not be read: the cached session plays on as it was (see above)
	else
		-- play on with defaults; saves/recovery merge with the real data later (held by another server's lock: the
		-- recovery claims once it frees)
		if again then
			P8.standIn(entry)
			entry.LockHeld = false -- another server holds it (or a released entry: still false); a landed claim sets it below
		end
		P8.notClaimed(entry, wrote)
	end
	entry.Loaded = true
	entry.Loading = false
	return entry, not again
end

-- Tells the player's systems that the live profile changed underneath them.
local function announceRebase(userId, entry)
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return
	end
	pushAll(player, entry.Profile)
	-- Phase 4: the one-time migration of a profile that arrives here from a recovered (provisional) load, before the
	-- snapshot and the signals (idempotent: a profile another server already migrated is left alone)
	local migrated = P4.migrateEntry(entry, player)
	local migrated5 = P5.migrateEntry(entry, player) -- Phase 5: after a recovered load too (idempotent)
	local garden = P3.gardenMigrate(entry) -- bug batch 2 #18: the marker + what this read took out of the Garden
	local refund = P6.itemsRefund(entry, player) -- HUD cleanup: the old Items refunded once (after a recovery too)
	P3.teamMigrate(entry) -- team balance: B4TeamFollow once (after a recovery too; TeamsChanged fires below)
	entry.TeamsTrimmed = nil
	DataService.Sync(player)
	DataService.ProfileRebased:Fire(player, entry.Profile)
	DataService.TeamsChanged:Fire(player) -- the presets may have come from another server
	P4.announceMigration(player, migrated)
	P5.announceMigration(player, migrated5)
	P3.gardenAnnounce(player, garden)
	P6.announce(player, refund)
end

-- Re-reads the store for an entry whose load failed and merges the session on top of it.
-- Caller holds the entry lock. Returns true on success. Session lock: the read is a claim (one UpdateAsync); another
-- server's live lock refuses it (false: the recovery loop or the next autosave tries again).
local function recover(entry, userId)
	local fetched, stored, migrated, _, moved, held, wrote = fetchProfile(userId, 1, entry)
	if not fetched then
		-- (review round 2: nil after an error: the orphan timeout, the shutdown claims and the recovery cadence treat only
		-- a live lock of another server as "held")
		entry.HeldBy = held
		P8.notClaimed(entry, wrote)
		return false
	end
	entry.GardenMoved = moved -- bug batch 2 #18 (announced by announceRebase)
	local source = stored or newProfile()
	local newBase = newProfile()
	if stored and not migrated then
		newBase = source
	end
	rebase(entry, entry.Base, source, newBase)
	entry.LoadFailed = false
	P8.claimed(entry, userId) -- SaveWaiting removed before the announce: its listeners see the claim
	announceRebase(userId, entry)
	P8.settled(entry, userId) -- the lock's flag: Settled once per load, right after the recovery's ProfileRebased
	return true
end

-- After a failed load, keep retrying in the background so the player gets their pets back.
local function scheduleRecovery(userId)
	local entry = cache[userId]
	if not entry or entry.RecoveryScheduled or storeDisabled then
		return
	end
	entry.RecoveryScheduled = true
	task.spawn(function()
		-- (review round 2: held by another server's live lock: the first claim 4 s after the give-up, P8.HELD_DELAYS)
		local delays = entry.HeldBy and P8.HELD_DELAYS or { 20, 40, 80, 160, 300 }
		for _, seconds in ipairs(delays) do
			task.wait(seconds)
			if cache[userId] ~= entry or not entry.LoadFailed or shuttingDown or storeDisabled then
				break
			end
			if not Players:GetPlayerByUserId(userId) then
				break
			end
			if acquire(entry) then
				local ok, err = pcall(recover, entry, userId)
				entry.Saving = false
				if not ok then
					warn("[DataService] recovery errored: " .. tostring(err))
				end
			end
		end
		entry.RecoveryScheduled = false
	end)
end

----------------------------------------------------------------------
-- Saving
----------------------------------------------------------------------

-- true when the store already holds everything the entry knows (nothing could be lost by dropping it).
-- An unreadable comparison counts as "not clean": keeping data is always the safe direction. Session lock: an entry
-- that still holds the lock is not clean either (its release must land first: the orphan loop retries it), nor one
-- still loading (review round 1: its claim may land after a leave: Release keeps it as an orphan, whose retry writes
-- the release once the load ended). Review round 2: nor one whose claim may have committed unseen (entry.ClaimSent: its
-- release, P8.letGo, must land first), unless `claimOk` (writeEntry asks whether only that cheap release is left).
local function entryIsClean(entry, claimOk)
	if entry.Loading == true then
		return false
	end
	local ok, empty = pcall(function()
		return isEmptyDelta(diffProfiles(entry.Profile, entry.Base, entry.Overwrite, deltaOpts(entry)))
	end)
	return ok and empty == true and entry.LockHeld ~= true and (claimOk == true or entry.ClaimSent ~= true)
end

-- Review round 2: the release of a clean stand-in (nothing to write, no lock it knows of). True at once, unless a claim
-- of it errored (entry.ClaimSent: it may have committed, its answer lost, leaving this server's lock in the record for
-- LockSeconds): then ONE UpdateAsync that clears the lock only when the record holds THIS server's lock (a lock-only
-- record, a brand-new player's, keeps its shape with the lock expired at once, At = 0: the v1 lookup still runs) and
-- changes nothing else. Returns true once that is answered.
function P8.letGo(entry, userId)
	local s = getStore()
	if entry.ClaimSent ~= true or not s then
		return true
	end
	local ok, err = pcall(function()
		s:UpdateAsync(keyFor(userId), function(old)
			if not P8.ours(old) then
				return nil -- no lock of this server in the record: nothing to let go of (no write)
			end
			local rec = {}
			for k, v in pairs(old) do
				rec[k] = v
			end
			rec.Lock = P8.lockOnly(old) and { Id = P8.Id, At = 0 } or nil
			return rec
		end)
	end)
	if not ok then
		noteFailure("save", err)
		return false
	end
	entry.ClaimSent = nil
	return true
end

-- Session lock: a save whose delta is empty still writes when it must move the lock: a release while the entry holds
-- it (the lock must go), or (not a release) for a loaded, real entry: the re-take of a lock it does not hold (a quick
-- rejoin raced the leave's release; the guard still applies; review round 2: never skipped for budget), or the
-- heartbeat once its lock is HeartbeatSeconds old and the UpdateAsync budget is not low (a skipped heartbeat is caught
-- by the next sweep).
function P8.mustWrite(entry, release)
	if release then
		return entry.LockHeld == true
	end
	if entry.Loaded ~= true or entry.LoadFailed == true then
		return false
	end
	if entry.LockHeld ~= true then
		return true
	end
	return os.time() - (entry.LockAt or 0) >= P8.num("HeartbeatSeconds") and not P8.writeBudgetLow()
end

-- Session lock: the write guard tripped (spec 8): another server's live lock is in the record (or, review round 1, this
-- server's own lock may have expired and the record no longer holds it: another server took it, perhaps released it
-- since), so this server's write was cancelled and its unsaved changes are dropped. A player who is not here (an
-- orphan, a late leave save): the entry goes (a stale server never saves). A player still here (the same account on
-- two servers at once, or a session whose writes failed for minutes): the store wins: the session plays on a true
-- stand-in (P8.standIn: defaults, the grant records and a pending ResetFields dropped with the changes; a receipt
-- never saved answers NotProcessedYet and Roblox asks again; review round 1: never the record seen, whose balances
-- the owning server may be spending) and the recovery claims the stored record once the lock frees. Always false (the
-- caller's save failed).
function P8.tripped(entry, userId, lock)
	warn(string.format("[DataService] another server owns the save of user %s (lock %s, %d s old): this server's unsaved changes are dropped",
		tostring(userId), tostring(lock.Id), math.max(0, os.time() - (tonumber(lock.At) or os.time()))))
	entry.LockHeld = false
	if not Players:GetPlayerByUserId(userId) then
		if cache[userId] == entry then
			cache[userId] = nil
		end
		return false
	end
	P8.standIn(entry)
	entry.LoadFailed = true
	entry.HeldBy = lock
	P8.setWaiting(userId, true)
	P8.settled(entry, userId) -- review round 2: OwnsSave is false now: the GemsSettled attribute goes
	scheduleRecovery(userId)
	announceRebase(userId, entry)
	return false
end

-- The bookkeeping of a write of this entry that landed: `w` is what it wrote ({ Id, Snapshot, Release, At, Gen,
-- Overwrite }, see writeEntry), `result` the record the store answered (review round 3: for an adopted lost-ack write,
-- the record found). The Base, the lock state and the pending markers follow THAT write (its mode, not the caller's).
function P8.landed(entry, userId, w, result)
	-- (a landed write also overwrote whatever lock an uncertain claim may have left: ClaimSent is answered)
	entry.SentWrite, entry.LandedWrite, entry.ClaimSent = nil, w.Id, nil
	entry.LockHeld = not w.Release
	entry.LockAt = w.At or os.time() -- the lock's At as written (the trust window counts from it)
	if w.Overwrite and entry.OverwriteGen == w.Gen then
		entry.Overwrite = nil -- written; a ResetFields during the write stays pending for the next save
	end
	entry.DungeonMigrated = nil -- Phase 5: the store holds the migration's Clears now (the Base adopts them below)
	entry.BerriesMigrated = nil -- Phase 5: ...and the P5Home step's berries (counted there exactly once)
	entry.ItemsRefunded = nil -- HUD cleanup: ...and the item refund (the store holds the marker now)
	if type(result) == "table" then
		local confirmed = normalizeProfile(result)
		if profilesEqual(confirmed, w.Snapshot) then
			entry.Base = w.Snapshot
		else
			-- The store held something different from what we assumed (another server,
			-- a recovered load): adopt it and re-apply whatever changed since the snapshot.
			rebase(entry, w.Snapshot, confirmed, confirmed)
			announceRebase(userId, entry)
		end
	else
		entry.Base = w.Snapshot
	end
	P7.pruneGrants(entry)
	-- review round 1: a write that (re)took the lock settles a load that was not settled yet; review round 2: the
	-- GemsSettled attribute follows the flag (a release with the player here removes it)
	P8.settled(entry, userId)
end

-- Body of a save; the caller holds the entry lock. Returns true when the store is up to date.
-- Session lock: `mode` "release" (or a player who left / is leaving, or the server shutting down) writes the record
-- without the lock; any other write stamps this server's lock. Every write is guarded (P8.tripped; strict while this
-- server's own lock may have expired). A release that lands after the player rejoined is followed by a re-take.
-- Review round 3: `release` is the WANTED mode and never changes: an adopted lost-ack write (perhaps of the other mode)
-- only moves the Base and the lock state; the loop then writes again whatever changed since it, or the lock move.
local function writeEntry(entry, userId, mode)
	local release = mode == "release" or entry.Leaving == true or shuttingDown or Players:GetPlayerByUserId(userId) == nil
	if entry.LoadFailed then
		if release and entryIsClean(entry, true) then
			-- a stand-in with nothing to write and no lock of ours: no claim just to let go of it (review round 2: one
			-- cheap release when a claim of it errored and may have committed, P8.letGo)
			return P8.letGo(entry, userId)
		end
		if not recover(entry, userId) then
			return false -- never write blind: it could hide a v1 save or a v2 profile we could not read
		end
	end

	-- two tries; review round 3: an adoption is an answer, not a failed try: it gives the loop one more pass (once)
	local tries, attempt, adopted = 2, 0, false
	while attempt < tries do
		attempt = attempt + 1
		local s = getStore()
		if not s then
			return false
		end

		local overwriteGen = entry.OverwriteGen
		local snapshot = copyProfile(entry.Profile)
		local delta = diffProfiles(snapshot, entry.Base, entry.Overwrite, deltaOpts(entry))
		if isEmptyDelta(delta) and not P8.mustWrite(entry, release) then
			entry.Dirty = false
			return true
		end

		-- review round 1: the strict guard: this server's own lock may have expired (its writes failed for LockSeconds -
		-- SKEW), so another server may have taken the record, and released it since (no lock left to refuse on): the
		-- write goes ahead only into a record that still holds this server's lock
		local strict = entry.LockHeld == true and not P8.trusted(entry)
		-- review round 2: every write stamps its nonce (WriteId). A write whose answer was lost (an error after it may have
		-- committed) is kept in entry.SentWrite[nonce] (what it wrote) until an answer comes: when the next attempt finds
		-- that nonce in the record, the earlier write landed: it is adopted (no second delta, and a strict release that
		-- left no lock is not taken for another server's write)
		local nonce = P8.nonce()
		local result, tripped, made, adopt, adoptRaw = nil, nil, nil, nil, nil
		local ok, err = pcall(function()
			result = s:UpdateAsync(keyFor(userId), function(old)
				-- Must be pure and non-yielding: UpdateAsync may call it more than once.
				local now = os.time()
				tripped, made, adopt, adoptRaw = nil, nil, nil, nil
				local mine = P8.mine(entry, old)
				if type(mine) == "table" then
					adopt, adoptRaw = mine, old
					return nil -- an earlier write of this entry landed although its answer was lost: adopted below (no write)
				end
				tripped = P8.foreign(old, now)
				if not tripped and strict and not P8.ours(old) and not mine then
					tripped = P8.lockOf(old) or { Id = "none (the record no longer holds this server's expired lock)", At = now }
				end
				if tripped then
					return nil -- the guard: another server owns (or owned) the save (no write)
				end
				local record = keepForeign(toStored(applyDelta(normalizeProfile(old), delta)), old)
				record.UpdatedAt = now
				record.WriteId = nonce
				if not release then
					record.Lock = P8.lockRecord(now)
				end
				made = { Id = nonce, Snapshot = snapshot, Release = release, At = now, Gen = overwriteGen, Overwrite = delta.Overwrite }
				return record
			end)
		end)

		if not ok and made then
			entry.SentWrite = entry.SentWrite or {}
			entry.SentWrite[nonce] = made -- it may have committed (the answer lost)
		end
		if ok and adopt then
			-- review round 3: an earlier write of this entry landed although its answer was lost (nothing was written
			-- now): the entry takes ITS Base and lock state (an autosave adopted by a release still holds the lock), and
			-- the loop goes round again: the next pass writes what changed since that write, or the lock move the wanted
			-- mode still needs (P8.mustWrite), or ends with nothing left to write
			if not adopted then
				tries = tries + 1
			end
			adopted = true
			P8.landed(entry, userId, adopt, adoptRaw)
		elseif ok and tripped then
			return P8.tripped(entry, userId, tripped)
		elseif ok then
			P8.landed(entry, userId, made, result)
			entry.Dirty = false
			if release and cache[userId] == entry and entry.Leaving ~= true and not shuttingDown and Players:GetPlayerByUserId(userId) then
				-- review round 1: the player rejoined this server while this release was in flight (Load used the cached
				-- entry): take the lock back at once with one more guarded write (review round 2: whatever the budget;
				-- tried again RETAKE_DELAY later when it fails), so the player is not left on an unlocked record until the
				-- next autosave
				if not writeEntry(entry, userId, nil) then
					P8.retakeLater(entry, userId)
				end
			end
			return true
		else
			noteFailure("save", err)
			if storeDisabled then
				return false
			end
			if attempt < tries then
				task.wait(RETRY_DELAY)
			end
		end
	end
	return false
end

local function saveEntry(userId, mode)
	local entry = cache[userId]
	if not entry then
		return false
	end
	waitForLoad(entry)
	if entry.Loading then
		return false -- session lock: nothing of a loading entry may be written (its claim has not landed)
	end
	if not getStore() then
		return false -- DataStores unavailable: the in-memory cache is all we have
	end
	if not acquire(entry) then
		return false
	end
	local ok, result = pcall(writeEntry, entry, userId, mode)
	entry.Saving = false
	P8.lapsed(entry, userId) -- review round 2: the GemsSettled attribute goes once OwnsSave lapsed (never yields)
	if not ok then
		if not IS_STUDIO then
			warn("[DataService] Save errored: " .. tostring(result))
		end
		return false
	end
	return result == true
end

-- pcall-safe save by user id (the player may be gone: orphaned entries are saved this way too).
local function safeSave(userId, mode)
	local ok, result = pcall(saveEntry, userId, mode)
	if not ok then
		if not IS_STUDIO then
			warn("[DataService] Save errored: " .. tostring(result))
		end
		return false
	end
	return result == true
end

-- Review round 2: a re-take that failed (a release landed after a rejoin; writeEntry's two attempts failed) is tried
-- again every RETAKE_DELAY s, at most RETAKE_TRIES times, until the entry holds the lock again (the autosave sweep
-- re-takes too); it stops when the player left again, the entry went provisional or was dropped, or the server closes.
function P8.retakeLater(entry, userId)
	if entry.RetakeScheduled then
		return
	end
	entry.RetakeScheduled = true
	task.spawn(function()
		for _ = 1, P8.RETAKE_TRIES do
			task.wait(P8.RETAKE_DELAY)
			if cache[userId] ~= entry or entry.LockHeld == true or entry.Leaving == true or entry.LoadFailed or shuttingDown
				or not Players:GetPlayerByUserId(userId) then
				break
			end
			safeSave(userId)
		end
		entry.RetakeScheduled = false
	end)
end

-- Saves one player (pcall-safe, retries once, silent when DataStores are unavailable). Session lock: the save of a
-- Player who left (and did not rejoin) is a release.
function DataService.Save(player)
	if not player then
		return false
	end
	local current = Players:GetPlayerByUserId(player.UserId)
	local mode = nil
	if player.Parent == nil and (current == nil or current == player) then
		mode = "release"
	end
	return safeSave(player.UserId, mode)
end

-- After a save attempt on a departed player's entry: drop it once it is safe (clean) or hopeless
-- (store unusable, or unsaved for ORPHAN_TIMEOUT seconds). A rejoined player owns the entry again.
local function settleOrphan(userId, entry)
	if cache[userId] ~= entry or not entry.Orphan or Players:GetPlayerByUserId(userId) then
		return
	end
	if entryIsClean(entry) then
		cache[userId] = nil
		return
	end
	if entry.HeldBy and not P8.stale(entry.HeldBy, os.time()) then
		-- review round 2: the last claim was refused by another server's live lock (a session that never owned the save,
		-- the player playing on there): that time does not run out ORPHAN_TIMEOUT; its delta lands after that release
		entry.OrphanSince = os.clock()
	end
	if storeDisabled or os.clock() - entry.OrphanSince >= ORPHAN_TIMEOUT then
		warn(string.format("[DataService] giving up on unsaved progress of user %s", tostring(userId)))
		cache[userId] = nil
	end
end

-- Background retry (with backoff) for a departed player's unsaved entry. One loop per entry; it ends
-- when the entry is saved/dropped, the player rejoined (Load clears Orphan), or the server shuts down
-- (BindToClose makes the last attempt).
local function scheduleOrphanFlush(userId, entry)
	if entry.OrphanScheduled or shuttingDown then
		return
	end
	entry.OrphanScheduled = true
	task.spawn(function()
		local delay = ORPHAN_RETRY_FIRST
		while true do
			task.wait(delay)
			delay = math.min(delay * 2, ORPHAN_RETRY_MAX)
			if shuttingDown or cache[userId] ~= entry or not entry.Orphan then
				break
			end
			safeSave(userId)
			settleOrphan(userId, entry)
			if cache[userId] ~= entry or not entry.Orphan then
				break
			end
		end
		entry.OrphanScheduled = false
	end)
end

-- The player left: frees the cache entry, but ONLY when the store holds everything it knows. A failed
-- final save (outage, throttling, lock timeout, a load that never succeeded) would otherwise throw away
-- the only copy of the session's progress, so a dirty entry stays behind as an orphan and keeps being
-- retried (see the header). Skipped if the same user already rejoined.
function DataService.Release(player)
	if not player then
		return
	end
	local userId = player.UserId
	local current = Players:GetPlayerByUserId(userId)
	if current and current ~= player then
		return
	end
	lastRequest[userId] = nil
	local entry = cache[userId]
	if not entry then
		return
	end
	if storeDisabled or entryIsClean(entry) then
		cache[userId] = nil -- nothing can be (or is left to be) saved
		return
	end
	if not entry.Orphan then
		entry.Orphan = true
		entry.OrphanSince = os.clock()
	end
	scheduleOrphanFlush(userId, entry)
end

----------------------------------------------------------------------
-- Hooks: leave handler + RequestProfile
----------------------------------------------------------------------

local function onPlayerRemoving(player)
	-- The one leave save (session lock: PlayerService no longer saves at leave, so a leave is ONE write) and the
	-- release of the cache entry are decided here. Release keeps the entry when this save failed, see DataService.Release.
	-- Session lock: the entry is marked Leaving at once (every write from now on is a release, Lock cleared; Load clears
	-- the mark when the player rejoins), and the deferred save is a release write (it still writes with an empty delta
	-- while the entry holds the lock).
	local current = Players:GetPlayerByUserId(player.UserId)
	local leaving = cache[player.UserId]
	if leaving and (current == nil or current == player) then
		leaving.Leaving = true
	end
	-- Deferred so that the other PlayerRemoving handlers run first (their order is not guaranteed): what they
	-- write at leave time (PetCareService refunds the dishes still cooking, any other late write) is then in the
	-- snapshot of this save, or in its orphan retry. Started at once, a save with nothing to write returned
	-- without yielding and Release dropped the entry inside the dispatch, before those handlers ran: their
	-- writes were lost. A rejoin before this runs is fine: Load picks the entry up again and Release skips it.
	task.defer(function()
		DataService.Save(player)
		DataService.Release(player)
	end)
	-- Phase 5: the per-player SettingsSet bucket and the berries push state go with the player
	P5.buckets[player.UserId] = nil
	P5.pushes[player.UserId] = nil
end

local function hook()
	if not playerHooked then
		playerHooked = true
		Players.PlayerRemoving:Connect(onPlayerRemoving)
	end
	if not requestHooked then
		local remote = getRemote("RequestProfile")
		if remote then
			requestHooked = true
			remote.OnServerEvent:Connect(function(player)
				local userId = player.UserId
				local now = os.clock()
				local last = lastRequest[userId]
				if last and now - last < REQUEST_COOLDOWN then
					return
				end
				lastRequest[userId] = now
				DataService.Sync(player)
			end)
		end
	end
	-- Phase 5 (7.2): SettingsSet(key, value) from the client: 6/s with a burst of 6 per player, then SetSetting's
	-- whitelist / types / ranges (junk is dropped silently, Y11); the client applied the value locally already
	if not P5.settingsHooked then
		local remote = getRemote("SettingsSet")
		if remote then
			P5.settingsHooked = true
			remote.OnServerEvent:Connect(function(player, key, value)
				if not player or type(key) ~= "string" then
					return
				end
				local userId = player.UserId
				local now = os.clock()
				local b = P5.buckets[userId]
				if not b then
					b = { tokens = P5.SETTINGS_BURST, last = now }
					P5.buckets[userId] = b
				end
				b.tokens = math.min(P5.SETTINGS_BURST, b.tokens + (now - b.last) * P5.SETTINGS_RATE)
				b.last = now
				if b.tokens < 1 then
					return
				end
				b.tokens = b.tokens - 1
				DataService.SetSetting(player, key, value)
			end)
		end
	end
end

-- Optional explicit init (Load / StartAutosave / BindToClose do the same lazily).
function DataService.Init()
	hook()
end

----------------------------------------------------------------------
-- Public API: loading + profile access
----------------------------------------------------------------------

-- Phase 5 (7.1): the player attribute ProfileLoaded = true once the profile is loaded or provisional (written once; the
-- loading screen waits for it).
function P5.markProfileLoaded(player)
	local attr = (Config.Attr and Config.Attr.ProfileLoaded) or "ProfileLoaded"
	pcall(function()
		if player:GetAttribute(attr) ~= true then
			player:SetAttribute(attr, true)
		end
	end)
end

-- Never errors. Returns the LIVE profile (mutate, then MarkDirty + Sync).
function DataService.Load(player)
	if not player then
		return newProfile()
	end
	hook()
	local prior = cache[player.UserId]
	if prior then
		prior.Leaving = false -- session lock: a (re)join is not a leave (its writes keep the lock again)
	end
	local ok, entry, didLoad = pcall(loadEntry, player)
	if not ok or not entry then
		warn("[DataService] Load failed: " .. tostring(entry))
		local fallback = ensureEntry(player.UserId)
		fallback.Loading = false
		fallback.Loaded = true
		fallback.LoadFailed = true
		scheduleRecovery(player.UserId) -- provisional until the real save is read (see the header)
		fallback.SettledFired = false -- session lock: the flag (GemsSettled, Settled) waits for that recovery's claim
		P5.markProfileLoaded(player)
		return fallback.Profile
	end
	-- A quick rejoin can find the previous session's entry still in memory (its final save was in
	-- flight): the profile is current, but the NEW Player instance still needs its attributes.
	if didLoad or entry.Owner ~= player then
		entry.Owner = player
		if Players:GetPlayerByUserId(player.UserId) == player then
			entry.Orphan = false -- the (re)joined player owns the entry again; the orphan retry loop stands down
		end -- (review round 1: not for a player who left during the load: that orphan's retry still writes the release)
		-- session lock (spec 12): a new load of a Player (a quick rejoin too): the lock's flag fires Settled once again
		entry.SettledFired = false
		pushAll(player, entry.Profile)
		if entry.LoadFailed then
			scheduleRecovery(player.UserId)
		end
		-- Phase 4: the one-time migration (section 4.3) of a loaded, non-provisional profile, in the same step as the
		-- load, so TycoonService's ProfileLoaded handler already sees the migrated Home (a provisional profile is
		-- migrated after its recovery, on ProfileRebased)
		local migrated = P4.migrateEntry(entry, player)
		-- Phase 5: the dungeon record from the old Trials and the home fold (section 9.2), in the same step
		local migrated5 = P5.migrateEntry(entry, player)
		-- bug batch 2 #18: the garden-exclusive marker + the pets the read took out of the Garden (old saves)
		local garden = P3.gardenMigrate(entry)
		-- HUD cleanup: the obby items are gone; the save's old Items are refunded once as Tokens
		local refund = P6.itemsRefund(entry, player)
		-- team balance: the followers become a team, once (a provisional profile after its recovery)
		local teamMoved = P3.teamMigrate(entry)
		DataService.Sync(player)
		DataService.ProfileLoaded:Fire(player, entry.Profile)
		if entry.TeamsTrimmed or (teamMoved and teamMoved.Case ~= "Empty") then
			entry.TeamsTrimmed = nil
			DataService.TeamsChanged:Fire(player) -- a stored 4-key preset loaded with 3 (4.8), a team moved: once
		end
		P4.announceMigration(player, migrated)
		P5.announceMigration(player, migrated5)
		P3.gardenAnnounce(player, garden)
		P6.announce(player, refund)
		P8.settled(entry, player.UserId) -- the lock's flag: this server owns the save (else the recovery's claim fires it)
	end
	P5.markProfileLoaded(player)
	return entry.Profile
end

-- The live profile table, or nil until Load finished.
function DataService.GetProfile(player)
	local entry = player and cache[player.UserId]
	if entry and entry.Loaded then
		return entry.Profile
	end
	return nil
end

function DataService.MarkDirty(player)
	local entry = player and cache[player.UserId]
	if entry then
		entry.Dirty = true
	end
end

-- Fires ProfileSync(snapshot) to that player (no-op until the profile is loaded).
function DataService.Sync(player)
	if not player or not player.Parent then
		return
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return
	end
	-- Phase 3: keys that lost their copy since the last sync (a fusion, a release, ...) leave the live presets
	local pruned = P3.pruneLive(entry)
	local remote = getRemote("ProfileSync")
	if remote then
		entry.LastSync = os.clock()
		local ok, err = pcall(function()
			remote:FireClient(player, buildSnapshot(entry.Profile))
		end)
		if not ok then
			warn("[DataService] Sync failed: " .. tostring(err))
		end
	end
	if pruned then
		DataService.TeamsChanged:Fire(player)
	end
end

-- Extra: a throttled Sync for frequent small changes (food, pet XP, home edits): sends now when the last snapshot
-- is at least SYNC_GAP seconds old, otherwise once at the end of that window (several calls -> one snapshot).
function DataService.SyncSoon(player)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or entry.SyncQueued then
		return
	end
	local elapsed = os.clock() - (entry.LastSync or -math.huge)
	if elapsed >= SYNC_GAP then
		DataService.Sync(player)
		return
	end
	entry.SyncQueued = true
	task.delay(SYNC_GAP - elapsed, function()
		entry.SyncQueued = false
		if cache[player.UserId] == entry then
			DataService.Sync(player)
		end
	end)
end

----------------------------------------------------------------------
-- v3: Pet Index discovery + tutorial progress
----------------------------------------------------------------------

-- Marks a pet as discovered (seen in the Pet Index). Returns true only the first time. Marks the
-- profile dirty but does not Sync: the caller does (PetService syncs right after every roll).
function DataService.MarkDiscovered(player, petId)
	if not player or not validKey(petId) then
		return false
	end
	local catalog = getPetCatalog()
	if catalog and type(catalog.Get) == "function" then
		local ok, def = pcall(catalog.Get, petId)
		if ok and not def then
			return false -- unknown pet id
		end
	end
	local entry = cache[player.UserId]
	if not entry then
		return false
	end
	local discovered = entry.Profile.Discovered
	if type(discovered) ~= "table" then
		discovered = {}
		entry.Profile.Discovered = discovered
	end
	if discovered[petId] == true then
		return false
	end
	discovered[petId] = true
	entry.Dirty = true
	return true
end

-- Extra: true when the player has discovered (ever owned / rolled) that pet.
function DataService.IsDiscovered(player, petId)
	local entry = player and cache[player.UserId]
	if not entry or type(petId) ~= "string" then
		return false
	end
	local discovered = entry.Profile.Discovered
	return type(discovered) == "table" and discovered[petId] == true
end

-- Extra: true while the player's profile is a stand-in (its load failed during a DataStore outage and the real
-- save has not been read yet). One-time rewards (tutorial gift, Index claims) and developer resets wait for it.
function DataService.IsProvisional(player)
	local entry = player and cache[player.UserId]
	return entry ~= nil and entry.Loaded == true and isProvisional(entry)
end

-- Session lock (spec 12, 16): true when this server owns the player's save: the profile is loaded (not mid-claim), not
-- provisional, and this server's lock is in the record and cannot have expired (P8.trusted, review round 1: after
-- LockSeconds - SKEW without a landed write another server may own it; the next landed write trusts it again). Also
-- true with no usable store (Studio without API access: nothing to own). False until loaded, while a load waits for
-- another server's lock, while provisional, after a release.
function DataService.OwnsSave(player)
	local entry = player and cache[player.UserId]
	if not entry or entry.Loaded ~= true or entry.Loading == true then
		return false
	end
	if getStore() == nil then
		return true
	end
	return entry.LoadFailed ~= true and P8.trusted(entry)
end

-- Studio and the mock only (RunService:IsStudio(); false elsewhere): this module copy's server id (P8.Id), so a second
-- copy of DataService in a test is a real other server for the lock. Set it before the copy's first Load.
function DataService._SetServerIdForTest(id)
	if not IS_STUDIO or type(id) ~= "string" or id == "" then
		return false
	end
	P8.Id = id
	return id
end

-- A copy of the tutorial progress { Step, Done, Gifted }, or nil until the profile is loaded. Also nil while the
-- profile is provisional: its defaults would start a returning player's tutorial again (gift and finish reward
-- included). TutorialService keeps polling and starts from the real progress once the recovery fired
-- ProfileRebased.
function DataService.GetTutorial(player)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	return cleanTutorial(entry.Profile.Tutorial)
end

-- Stores tutorial progress (MarkDirty + Sync). Step is clamped to a whole number >= 1; Done and Gifted
-- stick once true (the store merges them the same way, so a gift can never be paid twice).
-- Returns true when stored (false until the profile is loaded, while it is provisional, or for a non-table
-- argument).
function DataService.SetTutorial(player, tutorial)
	if not player or type(tutorial) ~= "table" then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return false
	end
	local profile = entry.Profile
	local current = cleanTutorial(profile.Tutorial)
	local wanted = cleanTutorial(tutorial)
	local live = profile.Tutorial
	if type(live) ~= "table" then
		live = {}
		profile.Tutorial = live
	end
	live.Step = wanted.Step
	live.Done = wanted.Done or current.Done
	live.Gifted = wanted.Gifted or current.Gifted
	entry.Dirty = true
	DataService.Sync(player)
	return true
end

-- Extra (developer tools only): the session's CURRENT values of the named fields (Discovered, IndexClaimed,
-- Tutorial, BestTimes, Home, Tiers, Hybrids, PetLevels, Teams, Battle, PetGrowth, Ring, Migrations, Dungeon, Daily,
-- Trove, Pity (lobby shop: its Hit merges as the max); fields =
-- { Discovered = true, ... }) replace the stored ones at the next successful save instead of being merged (those
-- merges only ever grow, or a higher stored prestige would win the Home back, or the battle record's cleared trials /
-- event pets / best values would come back, or the Phase 4 evolution stages / training ranks / ring record would keep
-- their higher stored values, so a /reset or /tutorial would otherwise return with the next save). The caller changes the
-- live values itself; everything after this call merges on top of them as usual. Pending until a save succeeds
-- (orphan retries and BindToClose carry it). Returns true when recorded (false until the profile is loaded, while it
-- is provisional, or without a known field).
function DataService.ResetFields(player, fields)
	if not player or type(fields) ~= "table" then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return false
	end
	local pending = {}
	for key in pairs(entry.Overwrite or {}) do
		pending[key] = true
	end
	local any = false
	for key, on in pairs(fields) do
		if on == true and OVERWRITABLE[key] then
			pending[key] = true
			any = true
		end
	end
	if not any then
		return false
	end
	entry.Overwrite = pending
	entry.OverwriteGen = (entry.OverwriteGen or 0) + 1
	entry.Dirty = true
	return true
end

----------------------------------------------------------------------
-- Tokens
----------------------------------------------------------------------

-- Adds earned tokens (n > 0; spending goes through SpendTokens). Also counts Stats.TokensEarned.
function DataService.AddTokens(player, n)
	if not player or not isFinite(n) then
		return
	end
	local amount = math.floor(n + 0.5)
	if amount <= 0 then
		return
	end
	local entry = cache[player.UserId]
	if not entry then
		if not player.Parent then
			return -- a player who already left (and was released) must not recreate a cache entry
		end
		hook()
		entry = ensureEntry(player.UserId)
	end
	local profile = entry.Profile
	profile.Tokens = sanitize(profile.Tokens + amount)
	profile.Stats.TokensEarned = sanitize(profile.Stats.TokensEarned + amount)
	entry.Dirty = true
	pushToPlayer(player, profile.Tokens)
end

-- true if the tokens were taken. Never goes negative.
function DataService.SpendTokens(player, n)
	if not player or not isFinite(n) or n < 0 then
		return false
	end
	local amount = math.ceil(n)
	local entry = cache[player.UserId]
	if not entry then
		return amount == 0
	end
	local profile = entry.Profile
	if amount > profile.Tokens then
		return false
	end
	if amount == 0 then
		return true
	end
	profile.Tokens = profile.Tokens - amount
	entry.Dirty = true
	pushToPlayer(player, profile.Tokens)
	return true
end

function DataService.GetTokens(player)
	if not player then
		return 0
	end
	local entry = cache[player.UserId]
	if entry then
		return entry.Profile.Tokens
	end
	local attr = player:GetAttribute(Config.Attr.Tokens)
	if type(attr) == "number" then
		return attr
	end
	return 0
end

----------------------------------------------------------------------
-- Phase 2: Cash + Gems (delta-saved like Tokens; mirrored on the player attributes)
----------------------------------------------------------------------

-- The cache entry for a currency change (created like AddTokens does when the load has not finished yet).
local function currencyEntry(player)
	local entry = cache[player.UserId]
	if not entry then
		if not player.Parent then
			return nil
		end
		hook()
		entry = ensureEntry(player.UserId)
	end
	return entry
end

-- Adds cash (n > 0; fractions are kept in the live balance, the store and the HUD see whole units).
function DataService.AddCash(player, n)
	if not player or not isFinite(n) or n <= 0 then
		return false
	end
	local entry = currencyEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	profile.Cash = clampCash((isFinite(profile.Cash) and profile.Cash or 0) + n)
	entry.Dirty = true
	pushCurrencies(player, profile)
	return true
end

-- true if the cash was taken (whole units, n rounded up). Never goes negative; check and write do not yield.
function DataService.SpendCash(player, n)
	if not player or not isFinite(n) or n < 0 then
		return false
	end
	local amount = math.ceil(n)
	local entry = cache[player.UserId]
	if not entry then
		return amount == 0
	end
	local profile = entry.Profile
	local balance = clampCash(profile.Cash)
	if amount > balance then
		return false
	end
	if amount == 0 then
		return true
	end
	profile.Cash = balance - amount
	entry.Dirty = true
	pushCurrencies(player, profile)
	return true
end

function DataService.GetCash(player)
	if not player then
		return 0
	end
	local entry = cache[player.UserId]
	if entry then
		return sanitizeCash(entry.Profile.Cash)
	end
	local attr = Config.Attr.Cash and player:GetAttribute(Config.Attr.Cash)
	if type(attr) == "number" then
		return attr
	end
	return 0
end

-- Adds gems (whole numbers; n rounded to the nearest whole, must be >= 1).
function DataService.AddGems(player, n)
	if not player or not isFinite(n) then
		return false
	end
	local amount = math.floor(n + 0.5)
	if amount <= 0 then
		return false
	end
	local entry = currencyEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	profile.Gems = sanitize(sanitize(profile.Gems) + amount)
	entry.Dirty = true
	pushCurrencies(player, profile)
	return true
end

-- true if the gems were taken (n rounded up). Never goes negative.
function DataService.SpendGems(player, n)
	if not player or not isFinite(n) or n < 0 then
		return false
	end
	local amount = math.ceil(n)
	local entry = cache[player.UserId]
	if not entry then
		return amount == 0
	end
	local profile = entry.Profile
	local balance = sanitize(profile.Gems)
	if amount > balance then
		return false
	end
	if amount == 0 then
		return true
	end
	profile.Gems = balance - amount
	entry.Dirty = true
	pushCurrencies(player, profile)
	return true
end

function DataService.GetGems(player)
	if not player then
		return 0
	end
	local entry = cache[player.UserId]
	if entry then
		return sanitize(entry.Profile.Gems)
	end
	local attr = Config.Attr.Gems and player:GetAttribute(Config.Attr.Gems)
	if type(attr) == "number" then
		return attr
	end
	return 0
end

----------------------------------------------------------------------
-- Phase 2: Food (delta-saved counts)
----------------------------------------------------------------------

local function wholeAmount(n)
	if n == nil then
		return 1
	end
	if not isFinite(n) then
		return nil
	end
	local amount = math.floor(n + 0.5)
	if amount < 1 then
		return nil
	end
	return amount
end

-- Adds n (default 1) of a food. false for junk ids / amounts or before the profile loaded. Capped per type.
function DataService.AddFood(player, foodId, n)
	local amount = wholeAmount(n)
	if not player or not validKey(foodId) or not amount then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local food = ensureTable(entry.Profile, "Food")
	local have = isFinite(food[foodId]) and sanitize(food[foodId]) or 0
	food[foodId] = math.min(have + amount, MAX_FOOD)
	entry.Dirty = true
	DataService.SyncSoon(player)
	return true
end

-- Takes n (default 1) of a food: false (nothing taken) when fewer are owned.
function DataService.SpendFood(player, foodId, n)
	local amount = wholeAmount(n)
	if not player or not validKey(foodId) or not amount then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local food = ensureTable(entry.Profile, "Food")
	local have = isFinite(food[foodId]) and sanitize(food[foodId]) or 0
	if have < amount then
		return false
	end
	if have - amount > 0 then
		food[foodId] = have - amount
	else
		food[foodId] = nil
	end
	entry.Dirty = true
	DataService.SyncSoon(player)
	return true
end

-- Count of one food, or (foodId nil) a copy of the whole { [foodId] = count } map.
function DataService.GetFood(player, foodId)
	local entry = player and cache[player.UserId]
	local food = entry and tableOr(entry.Profile.Food) or {}
	if foodId == nil then
		return cleanCounts(food, MAX_FOOD)
	end
	if not validKey(foodId) then
		return 0
	end
	return isFinite(food[foodId]) and sanitize(food[foodId]) or 0
end

----------------------------------------------------------------------
-- Phase 2: pet levels (per key, replaced per key on save)
----------------------------------------------------------------------

-- XP needed to go from `level` to level + 1 (TycoonCatalog.XpToNext; a local curve without it).
local function xpToNext(level)
	local catalog = getTycoonCatalog()
	if catalog and type(catalog.XpToNext) == "function" then
		local ok, need = pcall(catalog.XpToNext, level)
		if ok and need == math.huge then
			return need -- the top of the curve: no further level
		end
		if ok and isFinite(need) and need > 0 then
			return need
		end
	end
	return math.floor(40 * level ^ 1.35 + 0.5)
end

local function maxPetLevel()
	local catalog = getTycoonCatalog()
	if catalog then
		local fromXp = type(catalog.PetXp) == "table" and catalog.PetXp.MaxLevel or nil
		for _, v in ipairs({ catalog.MaxPetLevel or false, catalog.PetMaxLevel or false, fromXp or false }) do
			if isFinite(v) and v >= 1 then
				return math.min(math.floor(v), MAX_LEVEL)
			end
		end
	end
	return DEFAULT_MAX_PET_LEVEL
end

-- level, xp of a pet key (1, 0 when it never gained XP or the profile is not loaded).
function DataService.GetPetLevel(player, key)
	local entry = player and cache[player.UserId]
	if not entry or not validKey(key) then
		return 1, 0
	end
	local clean = cleanPetLevel(tableOr(entry.Profile.PetLevels)[key])
	if not clean then
		return 1, 0
	end
	return clean.Level, clean.Xp
end

-- Adds XP to an OWNED pet copy and levels it up along the XP curve (capped at the max level, where XP stops).
-- Returns how many levels it gained (0 when refused: junk, not owned, not loaded, provisional profile).
function DataService.AddPetXp(player, key, xp)
	if not player or not validKey(key) or not isFinite(xp) or xp <= 0 then
		return 0
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return 0
	end
	local profile = entry.Profile
	if ownedCount(profile, key) <= 0 then
		return 0
	end
	local levels = ensureTable(profile, "PetLevels")
	local raw = levels[key]
	local level, have = 1, 0
	if type(raw) == "table" then
		if isFinite(raw.Level) and raw.Level >= 1 then
			level = math.min(math.floor(raw.Level), MAX_LEVEL)
		end
		if isFinite(raw.Xp) and raw.Xp > 0 then
			have = raw.Xp
		end
	elseif isFinite(raw) and raw >= 1 then
		level = math.min(math.floor(raw), MAX_LEVEL)
	end
	local cap = maxPetLevel()
	local total = have + xp
	local gained = 0
	while level < cap do
		local need = xpToNext(level)
		if total < need then
			break
		end
		total = total - need
		level = level + 1
		gained = gained + 1
	end
	if level >= cap then
		total = 0 -- at the top of the curve XP stops counting
	end
	levels[key] = { Level = level, Xp = math.min(total, MAX_COUNT) }
	entry.Dirty = true
	DataService.SyncSoon(player)
	return gained
end

----------------------------------------------------------------------
-- Phase 2: Home (Stations / Garden / Gym per key, CollectorCash as a delta, a higher prestige wins the whole Home)
----------------------------------------------------------------------

-- The live Home table, repaired in place when another module dropped one of its parts. Rooms stays Stations.
local function liveHome(profile)
	local home = profile.Home
	if type(home) ~= "table" then
		home = newHome()
		profile.Home = home
	end
	if type(home.Stations) ~= "table" then
		home.Stations = type(home.Rooms) == "table" and home.Rooms or {}
	end
	home.Rooms = home.Stations
	ensureTable(home, "Garden")
	ensureTable(home, "Gym")
	return home
end

-- After MutateHome: sanitises the live home IN PLACE (keeps the fraction of CollectorCash).
local function repairHome(home)
	local collector = clampCash(home.CollectorCash)
	writeHome(home, cleanHome(home, false))
	home.CollectorCash = collector
end

-- A deep copy of the Home ({ Level, Prestige, Stations, Garden, Gym, CollectorCash, LastSeen }; Garden / Gym keyed
-- by slot number), or nil until the profile is loaded and while it is provisional (its Home would be defaults).
function DataService.GetHome(player)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local home = liveHome(entry.Profile)
	local copy = cleanHome(home, false)
	copy.CollectorCash = clampCash(home.CollectorCash)
	return copy
end

-- fn(home) edits the live Home table (no yields). An error, or fn returning false, restores the Home and answers
-- false. While the profile is provisional only CollectorCash / LastSeen may change (they merge as a delta / the
-- later time; stations from stand-in defaults would overwrite the real ones): anything else is rolled back.
function DataService.MutateHome(player, fn)
	if not player or type(fn) ~= "function" then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local home = liveHome(entry.Profile)
	local before = cleanHome(home, false)
	local beforeCollector = home.CollectorCash
	local ok, result = pcall(fn, home)
	local function restore()
		writeHome(home, before)
		home.CollectorCash = clampCash(beforeCollector)
	end
	if not ok then
		warn("[DataService] MutateHome callback errored (home restored): " .. tostring(result))
		restore()
		return false
	end
	if result == false then
		restore()
		return false
	end
	repairHome(home)
	local after = cleanHome(home, false)
	-- Phase 4: a prestige ends the veteran extras of the one-time migration (the old garden places and the old prices
	-- last "until your next Prestige"; the merge agrees: a higher Prestige wins the whole Home, which has them cleared)
	-- Phase 5: the folded Coin Magnet ends with it too (LegacyMagnet / LegacyMagnetStar); DecorCredit is NEVER cleared
	if after.Prestige > before.Prestige and (after.LegacySlots ~= nil or after.LegacyPrices ~= nil or after.LegacyMagnet ~= nil) then
		home.LegacySlots = nil
		home.LegacyPrices = nil
		home.LegacyMagnet = nil
		home.LegacyMagnetStar = nil
		after = cleanHome(home, false)
	end
	local visible = not homeVisiblyEqual(before, after)
	if visible and isProvisional(entry) then
		restore()
		return false
	end
	entry.Dirty = true
	-- team balance: a pet whose last free copy went to the Garden / Gym leaves the followers and keeps its slot; one that
	-- came out of it is back by itself (TeamsChanged: PetService republishes)
	local pruned = visible and P3.pruneLive(entry)
	if visible then
		DataService.SyncSoon(player)
	end
	if pruned then
		DataService.TeamsChanged:Fire(player)
	end
	return true
end

----------------------------------------------------------------------
-- Phase 2: developer-product receipts (GemService: idempotent ProcessReceipt)
----------------------------------------------------------------------

-- true when that purchase id was already processed for the player; nil when that cannot be known yet (profile not
-- loaded, or provisional).
function DataService.HasReceipt(player, purchaseId)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) or not validKey(purchaseId) then
		return nil
	end
	return tableOr(entry.Profile.GemReceipts)[purchaseId] ~= nil
end

-- Records a processed purchase id. true = new (grant it now, in the same step), false = already processed (grant
-- nothing, the purchase is done), nil = cannot decide now (not loaded / provisional: answer NotProcessedYet).
-- The receipt and its grant travel in the same save (one UpdateAsync). `grant` (optional) = what the caller grants
-- for it (a number = that many Gems, the gem packs; or a grant table { Cash, Tokens, Gems, Berries, Pets, Boost }):
-- the merge then makes the grant follow its receipt atomically. When the stored profile already holds that receipt
-- (another server granted the same purchase while this server's save failed and the player moved on), this
-- session's grant is not added to the store a second time. NoteReceiptGrant replaces the record once the grant is
-- known for real (substitutes).
function DataService.MarkReceipt(player, purchaseId, grant)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) or not validKey(purchaseId) then
		return nil
	end
	local receipts = ensureTable(entry.Profile, "GemReceipts")
	if receipts[purchaseId] ~= nil then
		return false
	end
	receipts[purchaseId] = sanitizeTime(os.time())
	trimReceipts(receipts, { [purchaseId] = true })
	P7.noteGrant(entry, "ReceiptGrants", purchaseId, grant)
	entry.Dirty = true
	return true
end

-- Writes (or with a grant of nothing clears) one grant record of the entry's annotation `field` ({[key] = grant}),
-- stamped with the star it is paid at (Star).
function P7.noteGrant(entry, field, key, grant)
	local g = P7.cleanGrant(grant)
	if g then
		g.Star = P7.starOf(entry.Profile)
	end
	local map = entry[field]
	if type(map) ~= "table" then
		if not g then
			return
		end
		map = {}
		entry[field] = map
	end
	map[key] = g
	if next(map) == nil then
		entry[field] = nil
	end
end

-- Store build: records what a receipt REALLY granted (substitutes included) for a receipt this session marked that
-- is not in the store yet, replacing MarkReceipt's record; the merge takes it off the deltas when the store turns out
-- to hold the receipt. false for a receipt the store already holds / not marked here, until loaded, while provisional.
function DataService.NoteReceiptGrant(player, purchaseId, grant)
	local entry = P3.realEntry(player)
	if not entry or not validKey(purchaseId) then
		return false
	end
	if tableOr(entry.Profile.GemReceipts)[purchaseId] == nil or tableOr(entry.Base.GemReceipts)[purchaseId] ~= nil then
		return false
	end
	P7.noteGrant(entry, "ReceiptGrants", purchaseId, grant)
	entry.Dirty = true
	return true
end

----------------------------------------------------------------------
-- Store build (P7): the Store record (bought packs, passes seen, potion ends), the Daily record (streak and play-time
-- gifts) and the Trove asks. Nothing here yields; every write is one step and rides the next UpdateAsync with its
-- grant record (the twin rules of the merge). One-time grants are refused on a stand-in (P3.realEntry).
----------------------------------------------------------------------

-- The live Store sub-map `key` (Bought / Passes / Boosts) of an entry, created when missing.
function P7.storeMap(entry, key)
	return ensureTable(ensureTable(entry.Profile, "Store"), key)
end

-- Marks a Once pack bought (Store.Bought[key] = now). false when already bought, for junk, until loaded, provisional.
function DataService.MarkBought(player, key)
	local entry = P3.realEntry(player)
	if not entry or not validKey(key) then
		return false
	end
	local bought = P7.storeMap(entry, "Bought")
	if bought[key] ~= nil then
		return false
	end
	bought[key] = sanitizeTime(os.time())
	entry.Dirty = true
	return true
end

-- A clean copy of the Store record, or nil until loaded and while provisional.
function DataService.GetStore(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P7.cleanStore(entry.Profile.Store)
end

-- Records a pass seen owned (Store.Passes[key] = now, once). A union: allowed before the load and while provisional.
function DataService.MarkPassSeen(player, key)
	local entry = player and cache[player.UserId]
	if not entry or not validKey(key) then
		return false
	end
	local passes = P7.storeMap(entry, "Passes")
	if passes[key] == nil then
		passes[key] = sanitizeTime(os.time())
		entry.Dirty = true
	end
	return true
end

-- Adds potion time: the end is max(now, the running end) + seconds (stacks in TIME, restarts once expired; no cap:
-- a paid potion is never eaten, Z7). -> ok, ends. Refused for junk, until loaded and while provisional.
function DataService.AddBoost(player, id, seconds)
	local entry = P3.realEntry(player)
	if not entry or not validKey(id) or not isFinite(seconds) then
		return false
	end
	local add = math.floor(seconds + 0.5)
	if add <= 0 then
		return false
	end
	local boosts = P7.storeMap(entry, "Boosts")
	local from = isFinite(boosts[id]) and boosts[id] or 0
	local now = os.time()
	if from < now then
		from = now
	end
	local ends = sanitizeTime(from + math.min(add, P7.MAX_BOOST))
	boosts[id] = ends
	entry.Dirty = true
	return true, ends
end

-- A clean copy of the Daily record (PlayClaimed a set), or nil until loaded and while provisional.
function DataService.GetDaily(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P7.cleanDaily(entry.Profile.Daily)
end

-- fn(daily) edits the LIVE Daily record (no yields); an error, or fn returning false, restores it (-> false);
-- afterwards it is sanitised in place. A `grant` table is stamped At = `now` (the caller's one clock of the claim, so
-- the grant pairs with the LastClaimAt fn wrote from it; without it ONE os.time() read for the whole mutation),
-- PlayStart = daily.PlayStart (after fn) and Star = the live Home.Prestige, and kept for the merge (DailyClaims): pay
-- it right after this returned true, nothing yielding between. A number in the grant's place is `now` (no grant).
-- Refused until loaded and while provisional.
function DataService.MutateDaily(player, fn, grant, now)
	if type(fn) ~= "function" then
		return false
	end
	if isFinite(grant) and now == nil then
		grant, now = nil, grant
	end
	if type(grant) == "table" then
		now = sanitizeTime(isFinite(now) and now or os.time())
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local live = ensureTable(entry.Profile, "Daily")
	local before = P7.cleanDaily(live)
	local prev = before.LastClaimAt -- the stamp a claim in fn builds on (its grant's Prev)
	local ok, result = pcall(fn, live)
	entry.Profile.Daily = live -- the record stays this table even if fn replaced the field
	if not ok then
		warn("[DataService] MutateDaily callback errored (record restored): " .. tostring(result))
		refill(live, before)
		return false
	end
	if result == false then
		refill(live, before)
		return false
	end
	refill(live, P7.cleanDaily(live))
	if type(grant) == "table" then
		local g = P7.cleanGrant(grant)
		if g then
			g.At = now
			g.Prev = prev
			g.PlayStart = live.PlayStart
			g.Star = P7.starOf(entry.Profile)
			local claims = entry.DailyClaims
			if type(claims) ~= "table" then
				claims = {}
				entry.DailyClaims = claims
			end
			claims[#claims + 1] = g
		end
	end
	entry.Dirty = true
	return true
end

-- A copy of the Trove asks {[askId] = true}, or nil until loaded and while provisional.
function DataService.GetTrove(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P7.cleanTrove(entry.Profile.Trove)
end

-- Sets a Trove ask with its grant record (one step). false when already set, for junk, until loaded, provisional.
function DataService.MarkTrove(player, askId, grant)
	local entry = P3.realEntry(player)
	if not entry or not validKey(askId) then
		return false
	end
	local trove = ensureTable(entry.Profile, "Trove")
	if trove[askId] == true then
		return false
	end
	trove[askId] = true
	P7.noteGrant(entry, "TroveGrants", askId, grant)
	entry.Dirty = true
	return true
end

----------------------------------------------------------------------
-- Phase 3: battle teams (presets merge per preset) + the battle record (counters as deltas, best values, sets that
-- only grow). Nothing here yields; every refusal answers a short reason for a side toast.
----------------------------------------------------------------------

-- The cache entry of a loaded, non-provisional profile (team edits and record reads need the real data), or nil.
function P3.realEntry(player)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	return entry
end

-- Why a team edit cannot run now: a stand-in profile waits for its recovery (P3.realEntry), else the save is not in yet.
function P3.notReady(player)
	local entry = player and cache[player.UserId]
	if entry and entry.Loaded and isProvisional(entry) then
		return "Your save is still being recovered, try again in a moment"
	end
	return "Your data is still loading"
end

function P3.validPreset(preset)
	return isFinite(preset) and preset >= 1 and preset <= P3.PRESETS and preset == math.floor(preset)
end

-- "Rocky is training (2:10 left)": the refusal of a direct pick (PetService.CanEquip words it the same).
function P3.trainingText(profile, key)
	local name = key
	local petKeys = getPetKeys()
	if petKeys and type(petKeys.DefOf) == "function" then
		local ok, def = pcall(petKeys.DefOf, key, profile)
		if ok and type(def) == "table" then
			name = def.DisplayName or def.Name or key
		end
	end
	local entry = tableOr(profile.PetGrowth)[key]
	local ends = type(entry) == "table" and type(entry.Job) == "table" and entry.Job.Ends or nil
	if not isFinite(ends) then
		return tostring(name) .. " is training"
	end
	local left = math.max(0, math.ceil(ends - os.time()))
	return tostring(name) .. " is training (" .. string.format("%d:%02d", math.floor(left / 60), left % 60) .. " left)"
end

-- A busy key already in this preset is no pick when it stays in its slot, or when the list holds the same keys as the
-- preset (a swap): a team can be edited around a pet that is away. -> { [key] = true } of the keys that may stay.
function P3.keptKeys(keys, stored)
	local out = {}
	stored = type(stored) == "table" and stored or {}
	local had, inList, same = {}, {}, true
	for _, key in ipairs(stored) do
		had[key] = true
	end
	for i = 1, P3.MAX_SLOTS do
		local key = keys[i]
		if key ~= nil and key ~= "" and key ~= false then
			inList[key] = true
			same = same and had[key] == true
			if stored[i] == key then
				out[key] = true
			end
		end
	end
	for _, key in ipairs(stored) do
		same = same and inList[key] == true
	end
	return same and had or out
end

-- Checks a requested team against a profile. ok, keys (slot order, compacted) | reason. `freeKey` (optional, bug
-- batch 2 #18): count one copy of that key as free of the Garden (the recall check, before the Garden lets it go).
-- `stored` (optional): the preset's list now (a busy key that stays is no direct pick, P3.keptKeys).
function P3.checkTeam(profile, keys, freeKey, stored)
	if type(keys) ~= "table" then
		return false, "That team is not valid"
	end
	for index, key in pairs(keys) do
		if type(index) ~= "number" or index ~= math.floor(index) or index < 1 then
			return false, "That team is not valid"
		end
		if index > P3.MAX_SLOTS and key ~= nil and key ~= "" and key ~= false then
			return false, "Teams have 3 pets: a fighter and two helpers" -- Phase 5 (4.8): more than 3 keys
		end
	end
	local placed = P3.placedCopies(profile)
	if type(freeKey) == "string" and (placed[freeKey] or 0) > 0 then
		placed[freeKey] = placed[freeKey] - 1
	end
	local training = P4.trainingSet(profile.PetGrowth)
	local kept = P3.keptKeys(keys, stored)
	local list, seen = {}, {}
	for i = 1, P3.MAX_SLOTS do
		local key = keys[i]
		if key ~= nil and key ~= "" and key ~= false then
			if not P3.teamKey(key) then
				return false, "That team is not valid"
			end
			if seen[key] then
				return false, "A pet can join a team only once"
			end
			seen[key] = true
			local owned = ownedCount(profile, key)
			if owned < 1 then
				return false, "You do not own that pet"
			end
			if training[key] and not kept[key] then
				return false, P3.trainingText(profile, key)
			end
			if owned - (placed[key] or 0) < 1 and not kept[key] then
				-- bug batch 2 #18: a Garden pet is busy gardening (the client asks first and recalls it with ONE request,
				-- TycoonService.GardenRecall); a Gym copy stays the old reason
				local home = type(profile.Home) == "table" and profile.Home or {}
				local open = P3.gardenOpen(home)
				for slot, k in pairs(tableOr(home.Garden)) do
					if k == key and not P3.closedSlot(slot, open) then
						return false, "That pet is gardening! Take it out of the garden first"
					end
				end
				return false, "That pet is busy in your Garden or Gym"
			end
			list[#list + 1] = key
		end
	end
	return true, list
end

-- The active team cannot change during an obby match (its perks are read between checkpoints). Other presets can.
function P3.matchLocked(player, profile, preset)
	return player:GetAttribute(Config.Attr.InMatch) == true and P3.teamsOf(profile).Active == preset
end

-- { Presets = { {key...} x3 }, Active, Slots = 3 | 4, Busy } (a pruned copy), or nil until loaded / while provisional.
function DataService.GetTeams(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P3.teamsSnapshot(entry.Profile)
end

-- Stores the pets of one preset (slot order; "" / false = an empty slot). ok, reason
function DataService.SetTeam(player, preset, keys)
	if not player or not P3.validPreset(preset) then
		return false, "Pick a team from 1 to " .. P3.PRESETS
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false, P3.notReady(player)
	end
	local profile = entry.Profile
	if P3.matchLocked(player, profile, preset) then
		return false, P3.MATCH_LOCKED
	end
	local ok, result = P3.checkTeam(profile, keys, nil, P3.teamsOf(profile).Presets[preset])
	if not ok then
		return false, result
	end
	P3.pruneLive(entry) -- a clean live Teams table (the other presets drop their stale keys too)
	profile.Teams.Presets[preset] = result
	P3.syncEquipped(profile)
	entry.Dirty = true
	DataService.SyncSoon(player)
	DataService.TeamsChanged:Fire(player)
	return true
end

-- Bug batch 2 #18 (the recall check): would SetTeam(player, preset, keys) pass once ONE copy of `freeKey` left the
-- Garden? Changes nothing. ok, reason
function DataService.CheckTeam(player, preset, keys, freeKey)
	if not player or not P3.validPreset(preset) then
		return false, "Pick a team from 1 to " .. P3.PRESETS
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false, P3.notReady(player)
	end
	if P3.matchLocked(player, entry.Profile, preset) then
		return false, P3.MATCH_LOCKED
	end
	local ok, result = P3.checkTeam(entry.Profile, keys, freeKey, P3.teamsOf(entry.Profile).Presets[preset])
	if not ok then
		return false, result
	end
	return true
end

-- Makes a preset the active one: the followers change at once (an empty preset leaves none). ok, reason
function DataService.SelectTeam(player, preset)
	if not player or not P3.validPreset(preset) then
		return false, "Pick a team from 1 to " .. P3.PRESETS
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false, P3.notReady(player)
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, P3.MATCH_LOCKED
	end
	P3.pruneLive(entry)
	entry.Profile.Teams.Active = preset
	P3.syncEquipped(entry.Profile)
	entry.Dirty = true
	DataService.SyncSoon(player)
	DataService.TeamsChanged:Fire(player)
	return true
end

-- Every owned key that could join a team right now (a copy not busy in the Garden / Gym, and not in training: Phase
-- 4's read-time lock; bug batch 2 #18: a garden pet is busy): what the Team picker offers and what the tutorial's
-- "team" step counts. {} until loaded or while provisional.
function DataService.FieldableKeys(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	local profile = entry.Profile
	local keys = getPetKeys()
	local owned = {}
	if keys and type(keys.List) == "function" then
		local ok, list = pcall(keys.List, profile)
		if ok and type(list) == "table" then
			owned = list
		end
	else
		for key in pairs(tableOr(profile.Pets)) do
			owned[#owned + 1] = key
		end
	end
	local placed = P3.placedCopies(profile)
	local training = P4.trainingSet(profile.PetGrowth)
	local out = {}
	for _, key in ipairs(owned) do
		if type(key) == "string" and P3.teamKey(key) and not training[key] and ownedCount(profile, key) - (placed[key] or 0) >= 1 then
			out[#out + 1] = key
		end
	end
	return out
end

-- Bug batch 2 #18: { [key] = copies working in the Garden (open places only) / Gym } of the live profile (a copy), {}
-- until loaded / while provisional (stand-in data must not unequip anything). PetService.Equip and its re-validation
-- read it.
function DataService.PlacedCopies(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	return P3.placedCopies(entry.Profile)
end

-- { [key] = "Training" | "Garden" } of the live profile (team balance: such a key keeps its slot, it neither follows nor
-- fights). {} until loaded / while provisional.
function DataService.BusyKeys(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	return P3.busyOf(entry.Profile)
end

-- Rewrites Equipped from the invariant (a profile still provisional: its own cleaned list). MarkDirty + SyncSoon when it
-- changed; never fires TeamsChanged. -> changed
function DataService.SyncEquipped(player)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or not P3.syncEquipped(entry.Profile) then
		return false
	end
	entry.Dirty = true
	DataService.SyncSoon(player)
	return true
end

-- Bug batch 2 #18: { [key] = true } of every owned key with NO copy free of the Garden / Gym (busy gardening: no
-- follow, no fight; BusyKeys without the training keys). {} until loaded / while provisional.
function DataService.GardenBusyKeys(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	local profile = entry.Profile
	local out = {}
	for key, n in pairs(P3.placedCopies(profile)) do
		local owned = ownedCount(profile, key)
		if owned >= 1 and owned - n < 1 then
			out[key] = true
		end
	end
	return out
end

-- Bug batch 2 #18 follow-up: the CLOSED garden places (above the open count: a Prestige closed them, the pet rests
-- there and earns nothing) whose copy now also follows the player or sits in a battle preset, ascending; {} when
-- none, until loaded / while provisional. Changes nothing: TycoonService empties them silently after an equip / team
-- change (its plot shows the pet leave the bed). Open places never show up here (the lock refuses that overlap).
function DataService.ClosedBedOverlap(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	local plan = P3.soloPlan(entry.Profile)
	local out = {}
	for i, slot in ipairs(plan and plan.Closed or {}) do
		out[i] = slot
	end
	return out
end

-- The active preset minus busy keys, in slot order (equals Equipped). -> keys, why: nil with at least one key, "Empty"
-- (an empty preset), "Busy" (all its pets are busy), "Loading" (not loaded / provisional).
function DataService.ActiveTeamKeys(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}, "Loading"
	end
	local keys, preset = P3.activeKeys(entry.Profile)
	if #keys > 0 then
		return keys, nil
	end
	return keys, #preset == 0 and "Empty" or "Busy"
end

-- A copy of the battle record (TrialCleared / EventPets as sets), or nil until loaded / while provisional.
function DataService.GetBattle(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P3.cleanBattle(entry.Profile.Battle)
end

-- fn(battle) edits the live record (no yields). See the header for the rules. -> ok
function DataService.MutateBattle(player, fn)
	if not player or type(fn) ~= "function" then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local live = ensureTable(entry.Profile, "Battle")
	local before = P3.cleanBattle(live)
	local ok, result = pcall(fn, live)
	entry.Profile.Battle = live -- the record stays this table even if fn replaced the field
	if not ok then
		warn("[DataService] MutateBattle callback errored (record restored): " .. tostring(result))
		refill(live, before)
		return false
	end
	if result == false then
		refill(live, before)
		return false
	end
	local after = P3.cleanBattle(live)
	-- the sets only grow and the best values never go down (the store merges them that way)
	for level in pairs(before.TrialCleared) do
		after.TrialCleared[level] = true
	end
	for id in pairs(before.EventPets) do
		after.EventPets[id] = true
	end
	for _, field in ipairs(P3.BESTS) do
		if before[field] > after[field] then
			after[field] = before[field]
		end
	end
	local changes = P3.battleChanges(before, after)
	if isProvisional(entry) then
		for field in pairs(changes) do
			if not P3.PROVISIONAL_OK[field] then
				refill(live, before) -- stand-in data must not decide a first clear or an event pet
				return false
			end
		end
	end
	refill(live, after)
	if next(changes) ~= nil then
		entry.Dirty = true
		DataService.SyncSoon(player)
	end
	return true
end

-- lobby-shop 16.12: how many duels with that opponent the player's record holds at Unix second `since` or later (0
-- until the profile is loaded; a provisional profile's stand-in record counts too, which is empty or this session's).
function DataService.DuelsWith(player, opponentUserId, since)
	local entry = player and cache[player.UserId]
	if not entry or not entry.Loaded or not isFinite(opponentUserId) or not isFinite(since) then
		return 0
	end
	local n = 0
	for _, e in ipairs(P3.cleanDuels(entry.Profile.Battle and entry.Profile.Battle.Duels)) do
		if e.U == opponentUserId and e.T >= since then
			n = n + 1
		end
	end
	return n
end

-- lobby-shop 16.12: notes a duel with that opponent at Unix second `at` on the player's record (the window + DUELS_KEEP older kept;
-- merges into the store as a union, so it is allowed while provisional too). Never yields. -> ok
function DataService.RecordDuel(player, opponentUserId, at)
	local entry = player and cache[player.UserId]
	local add = P3.duelEntry({ U = opponentUserId, T = at })
	if not entry or not entry.Loaded or not add then
		return false
	end
	local battle = ensureTable(entry.Profile, "Battle")
	local list = P3.cleanDuels(battle.Duels)
	list[#list + 1] = add
	battle.Duels = P3.cleanDuels(list)
	entry.Dirty = true -- (no Sync: the snapshot leaves the record out)
	return true
end

-- Adds (or with n < 0 takes) trophies; the total never goes below 0. -> ok, total
function DataService.AddTrophies(player, n)
	if not player or not isFinite(n) then
		return false
	end
	local amount
	if n >= 0 then
		amount = math.floor(n + 0.5)
	else
		amount = -math.floor(-n + 0.5)
	end
	local entry = currencyEntry(player)
	if not entry then
		return false
	end
	local battle = ensureTable(entry.Profile, "Battle")
	local before = battle.Trophies
	battle.Trophies = sanitize(sanitize(before) + amount)
	if battle.Trophies ~= before then
		entry.Dirty = true
		DataService.SyncSoon(player)
	end
	return true, battle.Trophies
end

----------------------------------------------------------------------
-- Phase 4: pet growth (evolution stages + training ranks + the running job), the Champion Ring record, the migration
-- markers and the one-time Phase 4 migration (ARCHITECTURE_V3.md "Phase 4 build contract" 4.2 / 4.3). Nothing here
-- yields; every helper lives in P4 (the main chunk is close to Lua's 200-local limit).
----------------------------------------------------------------------

-- The live PetGrowth map of a profile (repaired in place when another module dropped it).
function P4.liveGrowth(profile)
	return ensureTable(profile, "PetGrowth")
end

-- The live Ring record of a profile (repaired in place).
function P4.liveRing(profile)
	local ring = profile.Ring
	if type(ring) ~= "table" then
		ring = { Best = 0, Runs = 0 }
		profile.Ring = ring
	end
	return ring
end

-- true when a clean growth entry has an Evo or a rank above 0
function P4.hasGains(e)
	if e.Evo > 0 then
		return true
	end
	for _, stat in ipairs(P4.STATS) do
		if e[stat] > 0 then
			return true
		end
	end
	return false
end

-- No Evo / rank may go down through MutateGrowth (the store merges them as the higher value, so a lower write would
-- come back anyway): per key the clean `after` keeps the higher of before / after; an entry fn removed while its key is
-- still owned keeps its numbers (its Job goes: to clear a job set Job = nil, never delete a trained pet's entry); an
-- entry of a key no longer owned (fused away, released) may vanish. Returns the re-cleaned map (a Job whose target is
-- no longer the stat's rank + 1 after the max is stale and goes).
function P4.keepGains(profile, before, after)
	for key, e in pairs(before) do
		local a = after[key]
		if a == nil then
			if P4.hasGains(e) and ownedCount(profile, key) > 0 then
				local kept = P4.zeroEntry()
				kept.Evo = e.Evo
				for _, stat in ipairs(P4.STATS) do
					kept[stat] = e[stat]
				end
				after[key] = kept
			end
		else
			a.Evo = math.max(a.Evo, e.Evo)
			for _, stat in ipairs(P4.STATS) do
				a[stat] = math.max(a[stat], e[stat])
			end
		end
	end
	return P4.cleanGrowth(after)
end

-- PetCatalog.MaxEvolution of a key (its def through PetKeys.DefOf when the catalog is there), else the data cap 2.
function P4.maxEvolution(profile, key)
	local catalog = getPetCatalog()
	if not catalog or type(catalog.MaxEvolution) ~= "function" then
		return P4.MAX_EVO
	end
	local subject = key
	local keys = getPetKeys()
	if keys and type(keys.DefOf) == "function" then
		local okDef, def = pcall(keys.DefOf, key, profile)
		if okDef and type(def) == "table" then
			subject = def
		end
	end
	local ok, top = pcall(catalog.MaxEvolution, subject)
	if ok and isFinite(top) and top >= 0 then
		return math.min(math.floor(top), P4.MAX_EVO)
	end
	return P4.MAX_EVO
end

-- A copy of one pet's growth { Evo, Speed, Physique, Ability, Defense, Job = {...} | nil }: zeros when the key has none
-- (also before the load and while provisional: display only).
function DataService.GetGrowth(player, key)
	local entry = player and cache[player.UserId]
	local clean = nil
	if entry and validKey(key) then
		clean = P4.cleanEntry(tableOr(entry.Profile.PetGrowth)[key])
	end
	return clean or P4.zeroEntry()
end

-- A clean copy of the whole growth map { [key] = entry }; {} until loaded and while provisional.
function DataService.GetGrowthMap(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	return P4.cleanGrowth(entry.Profile.PetGrowth)
end

-- fn(growth) edits the LIVE PetGrowth map { [key] = { Evo, Speed, Physique, Ability, Defense, Job } } (no yields).
-- Refused until loaded and while provisional (-> false). An error, or fn returning false, restores the map (-> false).
-- Afterwards the map is cleaned in place (P4.cleanGrowth: junk and stale Jobs dropped, numbers clamped) and no Evo /
-- rank may go down (P4.keepGains); every entry is replaced by a clean copy, so re-read entries with GetGrowth after
-- the call. A changed map is synced (throttled). Decide a reward / refund inside fn and pay it only once this returned
-- true: the Job and the Cash then travel in the same save.
function DataService.MutateGrowth(player, fn)
	if not player or type(fn) ~= "function" then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	local live = P4.liveGrowth(profile)
	local before = P4.cleanGrowth(live)
	local ok, result = pcall(fn, live)
	profile.PetGrowth = live -- the map stays this table even if fn replaced the field
	if not ok then
		warn("[DataService] MutateGrowth callback errored (growth restored): " .. tostring(result))
		refill(live, before)
		return false
	end
	if result == false then
		refill(live, before)
		return false
	end
	local after = P4.keepGains(profile, before, P4.cleanGrowth(live))
	local changed = not deepEqual(before, after)
	refill(live, after)
	if changed then
		entry.Dirty = true
		local moved = P3.syncEquipped(profile) -- a job began or ended: the pet leaves or rejoins the followers
		DataService.SyncSoon(player)
		if moved then
			DataService.TeamsChanged:Fire(player)
		end
	end
	return true
end

-- { [key] = true } of every key with a running training Job: the ONE source of the training lock (PetService.Equip,
-- GardenSet, Fusion, teamOf, the ring start and this module's own filters read it). {} until loaded / while
-- provisional.
function DataService.TrainingKeys(player)
	local entry = P3.realEntry(player)
	if not entry then
		return {}
	end
	return P4.trainingSet(entry.Profile.PetGrowth)
end

-- The stored evolution stage of a key (0..2; 0 when absent). The boost counts only from this stored stage.
function DataService.GetEvolution(player, key)
	return DataService.GetGrowth(player, key).Evo
end

-- Raises the stored stage of an OWNED key to `stage` (1..2, at most PetCatalog.MaxEvolution of its def). Only up:
-- false for a stage not above the stored one, junk, a key not owned, a profile not loaded or provisional.
function DataService.SetEvolution(player, key, stage)
	if not player or not validKey(key) or not isFinite(stage) or stage ~= math.floor(stage) or stage < 1 or stage > P4.MAX_EVO then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	if ownedCount(profile, key) < 1 or stage > P4.maxEvolution(profile, key) then
		return false
	end
	if stage <= DataService.GetGrowth(player, key).Evo then
		return false
	end
	return DataService.MutateGrowth(player, function(growth)
		local e = growth[key]
		if type(e) ~= "table" then
			e = {}
			growth[key] = e
		end
		e.Evo = stage
	end)
end

-- A copy of the Champion Ring record { Best, Runs }, or nil until loaded and while provisional (a stand-in record must
-- never decide a new record or a first boss clear).
function DataService.GetRing(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P4.cleanRing(entry.Profile.Ring)
end

-- fn(ring) edits the live record { Best, Runs } (no yields). Refused until loaded and while provisional. An error, or
-- fn returning false, restores it (-> false). Afterwards: whole numbers >= 0, Best never goes down (the store merges it
-- as the higher value), Runs is replaced (it travels as a +/- delta). Decide "new record" / "first boss clear" inside
-- fn and pay only once this returned true. A change is synced (throttled).
function DataService.MutateRing(player, fn)
	if not player or type(fn) ~= "function" then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	local live = P4.liveRing(profile)
	local before = P4.cleanRing(live)
	local ok, result = pcall(fn, live)
	profile.Ring = live -- the record stays this table even if fn replaced the field
	if not ok then
		warn("[DataService] MutateRing callback errored (record restored): " .. tostring(result))
		refill(live, before)
		return false
	end
	if result == false then
		refill(live, before)
		return false
	end
	local after = P4.cleanRing(live)
	if after.Best < before.Best then
		after.Best = before.Best
	end
	local changed = after.Best ~= before.Best or after.Runs ~= before.Runs
	refill(live, after)
	if changed then
		entry.Dirty = true
		DataService.SyncSoon(player)
	end
	return true
end

-- Lobby shop (spec 5.2): the live Secret pity record { Spins, Hit } of a profile (repaired in place when another module
-- dropped the field).
function P7.livePity(profile)
	return ensureTable(ensureTable(profile, "Pity"), "Secret")
end

-- A copy of the Secret pity record { Spins, Hit }, or nil until loaded and while provisional (a stand-in record must
-- never force a Secret). Since = Spins - Hit.
function DataService.GetPity(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	local secret = P7.cleanPity(entry.Profile.Pity).Secret
	return { Spins = secret.Spins, Hit = secret.Hit }
end

-- A plain write of the Secret pity record on the real entry: whole numbers 0..1e9 (anything else: false, nothing
-- written), Hit never below the live Hit, then Hit <= Spins. false with no player, until loaded and while provisional.
-- MarkDirty + SyncSoon. There is no callback form: the caller (PetService's money step) read GetPity in the same
-- non-yielding step and checked everything before the charge, so this write never refuses after it (spec 5.2).
function DataService.SetPity(player, spins, hit)
	if not player or P7.pityNumber(spins) ~= spins or P7.pityNumber(hit) ~= hit then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local live = P7.livePity(entry.Profile)
	local before = P7.cleanPity(entry.Profile.Pity).Secret
	if hit < before.Hit then
		hit = before.Hit
	end
	if hit > spins then
		hit = spins
	end
	live.Spins, live.Hit = spins, hit
	if spins ~= before.Spins or hit ~= before.Hit then
		entry.Dirty = true
		DataService.SyncSoon(player)
	end
	return true
end

-- Lobby shop (spec 5.2, the server-hop guard), since the session lock (2026-11-10, its spec 12) the lock's flag: true
-- when this server owns the player's save (OwnsSave: loaded, not provisional, the lock held; or no usable store). The
-- 15 s gem settle hold and its settle read are retired: the lock covers what they covered. Gem-priced actions refuse
-- "Your data is still loading" while it is false.
function DataService.GemsSettled(player)
	return DataService.OwnsSave(player) == true
end

-- Studio and the mock only (RunService:IsStudio(); false elsewhere): answers the flag (OwnsSave) and does nothing else:
-- there is no hold to end and no settle read. Tests call it before a gem action right after a join.
function DataService._SettleForTest(player)
	if not IS_STUDIO or not player then
		return false
	end
	return DataService.OwnsSave(player) == true
end

-- true / false once the profile is loaded and not provisional (nil before: not decidable).
function DataService.IsMigrated(player, name)
	local entry = P3.realEntry(player)
	if not entry or not validKey(name) then
		return nil
	end
	return tableOr(entry.Profile.Migrations)[name] == true
end

-- Records Migrations[name] = true (a union in the merge, so it is allowed while provisional). true when it is set now.
function DataService.MarkMigrated(player, name)
	if not player or not validKey(name) then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local migrations = ensureTable(entry.Profile, "Migrations")
	if migrations[name] ~= true then
		migrations[name] = true
		entry.Dirty = true
	end
	return true
end

-- The info of a migration THIS session ran on the profile (remembered until the player is released), or nil. For
-- "P4": { Veteran, LegacySlots, LegacyPrices, GymKeys, GymPets, CollectorCash } (see the header). TycoonService shows
-- the one welcome toast on the first claim when MigratedNow(player, "P4") answers a Veteran.
function DataService.MigratedNow(player, name)
	local entry = player and cache[player.UserId]
	if not entry or type(entry.MigratedNow) ~= "table" or not validKey(name) then
		return nil
	end
	local info = entry.MigratedNow[name]
	if type(info) ~= "table" then
		return nil
	end
	return deepCopy(info)
end

-- Developer tools (/petlevel): writes { Level, Xp = 0 } for an OWNED key, level a whole number 1..the curve's max level
-- (TycoonCatalog.PetXp.MaxLevel, 100). Refused until loaded and while provisional. Synced (throttled).
function DataService.SetPetLevel(player, key, level)
	if not player or not validKey(key) or not isFinite(level) or level ~= math.floor(level) then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	if level < 1 or level > maxPetLevel() or ownedCount(profile, key) < 1 then
		return false
	end
	ensureTable(profile, "PetLevels")[key] = { Level = level, Xp = 0 }
	entry.Dirty = true
	DataService.SyncSoon(player)
	return true
end

-- Garden places a home has by right (TycoonCatalog.Prestige.GardenSlotsBase / GardenSlotsPerStar; 3 + 1 per star
-- without them), so the migration can see which veterans had more.
function P4.gardenPlaces(stars)
	local base, perStar = P4.GARDEN_SLOTS_BASE, P4.GARDEN_SLOTS_PER_STAR
	local catalog = getTycoonCatalog()
	local prestige = catalog and type(catalog.Prestige) == "table" and catalog.Prestige or nil
	if prestige then
		if isFinite(prestige.GardenSlotsBase) and prestige.GardenSlotsBase >= 0 then
			base = math.floor(prestige.GardenSlotsBase)
		end
		if isFinite(prestige.GardenSlotsPerStar) and prestige.GardenSlotsPerStar >= 0 then
			perStar = math.floor(prestige.GardenSlotsPerStar)
		end
	end
	return base + perStar * sanitize(stars)
end

-- The one-time Phase 4 migration of a LIVE profile (section 4.3), in one non-yielding step; returns its info:
--   1. extra garden places: a Phase 3 Garden's level was its slot count; above 3 + Prestige it becomes LegacySlots
--      ("You keep your extra garden places until your next Prestige")
--   2. old prices: a veteran who had prestiged keeps the base prices until the next Prestige (LegacyPrices)
--   3. the old Gym is emptied (those pets are free again; their Gym XP is already in PetLevels)
--   4. Migrations.P4 = true
-- No one-time Cash payout anywhere (a payout plus a marker can double-pay across two servers); everything else needs
-- no data change (the station ids, Home Level, Prestige, CollectorCash, Food and PetLevels keep their meaning).
function P4.migrateP4(profile)
	local home = liveHome(profile)
	local clean = cleanHome(home, false)
	local info = {
		Veteran = clean.Level > 0 or clean.Prestige > 0 or next(clean.Stations) ~= nil,
		LegacySlots = nil,
		LegacyPrices = false,
		GymKeys = {},
		GymPets = 0,
		CollectorCash = clean.CollectorCash,
	}
	local oldSlots = clean.Stations.Garden or 0
	if oldSlots > P4.gardenPlaces(clean.Prestige) then
		home.LegacySlots = math.min(oldSlots, MAX_SLOT)
		info.LegacySlots = home.LegacySlots
	end
	if clean.Prestige > 0 then
		home.LegacyPrices = true
		info.LegacyPrices = true
	end
	local gym = ensureTable(home, "Gym")
	local slots = {}
	for slot in pairs(gym) do
		slots[#slots + 1] = slot
	end
	table.sort(slots, function(a, b)
		if type(a) == type(b) then
			return a < b
		end
		return type(a) == "number" -- numbered mats first, named slots after
	end)
	for _, slot in ipairs(slots) do
		local key = gym[slot]
		if validKey(key) then
			info.GymKeys[#info.GymKeys + 1] = key
		end
		gym[slot] = nil
	end
	info.GymPets = #info.GymKeys
	repairHome(home) -- whole numbers, the CollectorCash fraction kept
	local migrations = ensureTable(profile, "Migrations")
	migrations[P4.MIGRATION] = true
	if info.Veteran then
		-- persisted (a union like every marker): TycoonService shows the one welcome toast on the FIRST claim, which may
		-- happen in a later session than the migration; it marks P4.WELCOME_MARK itself once the toast was shown
		migrations[P4.VETERAN_MARK] = true
	end
	return info
end

-- Runs the Phase 4 migration on a cache entry when it is due: loaded, not provisional (stand-in defaults must never
-- be migrated: the real save is migrated after the recovery, on ProfileRebased) and not marked yet (idempotent: a
-- profile another server already migrated is left alone; the marker merges as a union). Returns the info, or nil.
function P4.migrateEntry(entry, player)
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local profile = entry.Profile
	if tableOr(profile.Migrations)[P4.MIGRATION] == true then
		return nil
	end
	local ok, info = pcall(P4.migrateP4, profile)
	if not ok then
		warn("[DataService] Phase 4 migration failed (it runs again on the next load): " .. tostring(info))
		return nil
	end
	entry.Dirty = true
	if type(entry.MigratedNow) ~= "table" then
		entry.MigratedNow = {}
	end
	entry.MigratedNow[P4.MIGRATION] = info
	return info
end

-- (The marker below is a record only, never consulted: the read-time repair itself runs on every load, see the header.)
-- Bug batch 2 #18 on a loaded, real profile: sets the marker Migrations.B2GardenSolo the first time and takes the keys
-- this read moved out of the Garden (entry.GardenMoved, P3.gardenSolo in normalizeProfile) -> info { Keys = {key...} }
-- (also MigratedNow(player, "B2GardenSolo")), or nil when nothing moved. A provisional profile waits for its recovery.
function P3.gardenMigrate(entry)
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local migrations = ensureTable(entry.Profile, "Migrations")
	if migrations[P5.GARDEN_MARK] ~= true then
		migrations[P5.GARDEN_MARK] = true
		entry.Dirty = true
	end
	local moved = entry.GardenMoved
	entry.GardenMoved = nil
	if type(moved) ~= "table" or #moved == 0 then
		return nil
	end
	entry.Dirty = true -- the store still holds the overlap until the next save (every read repairs it the same way)
	local info = { Keys = copyList(moved) }
	if type(entry.MigratedNow) ~= "table" then
		entry.MigratedNow = {}
	end
	entry.MigratedNow[P5.GARDEN_MARK] = info
	return info
end

-- Fires Migrated(player, "B2GardenSolo", { Keys }) right after the ProfileLoaded / ProfileRebased whose read moved pets
-- out of the Garden (TycoonService shows the one explaining toast).
function P3.gardenAnnounce(player, info)
	if type(info) == "table" and player then
		DataService.Migrated:Fire(player, P5.GARDEN_MARK, deepCopy(info))
	end
end

-- A pet the old build sent to training out of Equipped (Job.From = "Follow") is in no list here (normalizeEquipped), and that
-- build's return to its slot is gone (PetCareService.sendBack): it takes a free slot of the migrated team, sorted so two
-- servers agree. Busy, it does not follow until the job ends. A full team has no slot for it; the pet stays owned.
function P3.keepFollowJobs(profile, preset)
	local have, keys = {}, {}
	for _, key in ipairs(preset) do
		have[key] = true
	end
	for key, entry in pairs(tableOr(profile.PetGrowth)) do
		if type(entry) == "table" and type(entry.Job) == "table" and entry.Job.From == "Follow" and not have[key] and P3.teamKey(key) and P3.knownPet(profile, key) then
			keys[#keys + 1] = key
		end
	end
	table.sort(keys)
	for _, key in ipairs(keys) do
		if #preset < P3.MAX_SLOTS then
			preset[#preset + 1] = key
		end
	end
end

-- Team balance (B4TeamFollow) on a loaded, real profile without the marker: the old Equipped list becomes a team, so no
-- team is lost when it can be helped. With Equipped empty it follows the active preset; else a preset holding the same
-- keys (not counting its busy ones; the active preset first) becomes active, and Equipped takes ITS order; else the first
-- empty preset takes the list and becomes active; else the highest-numbered non-active preset does. A pet training from
-- Follow keeps a free slot of that team (P3.keepFollowJobs). No pet is touched, a key listed twice stays once. Returns info { Preset = n, Case = "Empty" | "Same" | "Free" | "Replaced" } (also
-- MigratedNow(player, "B4TeamFollow")), or nil when the marker was already set or the profile is not decidable (not
-- loaded, provisional: migrated after the recovery).
function P3.teamMigrate(entry)
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local profile = entry.Profile
	local migrations = ensureTable(profile, "Migrations")
	if migrations[P3.MARK_TEAM] == true then
		return nil
	end
	local teams = P3.teamsOf(profile)
	local busy = P3.busyOf(profile)
	-- the old list, each key once: only pets a preset could hold, and that exist
	local list, wanted = {}, {}
	for _, key in ipairs(tableOr(profile.Equipped)) do
		if #list < P3.MAX_SLOTS and P3.teamKey(key) and not wanted[key] and P3.knownPet(profile, key) then
			wanted[key] = true
			list[#list + 1] = key
		end
	end
	local function holdsList(preset)
		local n = 0
		for _, key in ipairs(preset) do
			if not busy[key] then
				if not wanted[key] then
					return false
				end
				n = n + 1
			end
		end
		return n == #list
	end
	local case, target = nil, nil
	if #list == 0 then
		case, target = "Empty", teams.Active
	elseif holdsList(teams.Presets[teams.Active]) then
		case, target = "Same", teams.Active
	else
		for i = 1, P3.PRESETS do
			if not case and holdsList(teams.Presets[i]) then
				case, target = "Same", i
			end
		end
		for i = 1, P3.PRESETS do
			if not case and #teams.Presets[i] == 0 then
				case, target = "Free", i
			end
		end
		for i = P3.PRESETS, 1, -1 do
			if not case and i ~= teams.Active then
				case, target = "Replaced", i
			end
		end
		if case ~= "Same" then
			teams.Presets[target] = list
		end
	end
	P3.keepFollowJobs(profile, teams.Presets[target])
	teams.Active = target
	refill(ensureTable(profile, "Teams"), teams)
	migrations[P3.MARK_TEAM] = true
	P3.syncEquipped(profile)
	entry.Dirty = true
	local info = { Preset = target, Case = case }
	if type(entry.MigratedNow) ~= "table" then
		entry.MigratedNow = {}
	end
	entry.MigratedNow[P3.MARK_TEAM] = info
	return info
end

-- HUD cleanup (B3ItemsRefund) on a loaded, real profile without the marker: pays the old Items as Tokens (P6.REFUND
-- per item, at most P6.REFUND_MAX of each, unknown ids pay 0; booked like AddTokens: TokensEarned too), empties Items,
-- sets the marker and remembers the paid amount for the twin rule of the merge (entry.ItemsRefunded). Returns
-- info { Tokens = n, Items = {[id]=count} } (also MigratedNow(player, "B3ItemsRefund")), or nil when the marker was
-- already set or the profile is not decidable (not loaded, provisional: refunded after the recovery).
function P6.itemsRefund(entry, player)
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local profile = entry.Profile
	local migrations = ensureTable(profile, "Migrations")
	if migrations[P6.MARK] == true then
		return nil
	end
	local items = {}
	local paid = 0
	for id, n in pairs(tableOr(profile.Items)) do
		local count = validKey(id) and clampCount(n, P6.REFUND_MAX) or 0
		if count > 0 then
			items[id] = count
			paid = paid + count * (P6.REFUND[id] or 0)
		end
	end
	if paid > 0 then
		profile.Tokens = sanitize(profile.Tokens + paid)
		profile.Stats.TokensEarned = sanitize(profile.Stats.TokensEarned + paid)
		entry.ItemsRefunded = paid
		pushToPlayer(player or entry.Owner, profile.Tokens)
	end
	profile.Items = {}
	migrations[P6.MARK] = true
	entry.Dirty = true
	local info = { Tokens = paid, Items = items }
	if type(entry.MigratedNow) ~= "table" then
		entry.MigratedNow = {}
	end
	entry.MigratedNow[P6.MARK] = info
	return info
end

-- Fires Migrated(player, "B3ItemsRefund", info) right after the ProfileLoaded / ProfileRebased whose refund paid
-- Tokens (Main.server shows the one explaining toast); nothing for an empty Items table.
function P6.announce(player, info)
	if type(info) == "table" and player and isFinite(info.Tokens) and info.Tokens > 0 then
		DataService.Migrated:Fire(player, P6.MARK, deepCopy(info))
	end
end

-- Fires Migrated(player, "P4", info) right after the ProfileLoaded / ProfileRebased that ran the migration.
function P4.announceMigration(player, info)
	if type(info) == "table" and player then
		DataService.Migrated:Fire(player, P4.MIGRATION, deepCopy(info))
	end
end

----------------------------------------------------------------------
-- Phase 5: the Dungeon record, Berries, Settings (ARCHITECTURE_V3.md "Phase 5 build contract" 9.1) and the one-time
-- P5 migrations (9.2). API in the same shape as the Ring / Food / Migrations API above.
----------------------------------------------------------------------

-- The live Dungeon table of a profile (created when missing; Cleared is a table).
function P5.liveDungeon(profile)
	local d = ensureTable(profile, "Dungeon")
	ensureTable(d, "Cleared")
	return d
end

-- { Best, Cleared = { [floor] = true }, Runs, Clears } (a clean copy), or nil until loaded / while provisional.
function DataService.GetDungeon(player)
	local entry = P3.realEntry(player)
	if not entry then
		return nil
	end
	return P5.cleanDungeon(entry.Profile.Dungeon)
end

-- fn(dungeon) edits the live record { Best, Cleared = { [floor] = true }, Runs, Clears } (no yields). Returns ok, first:
-- `first` = this call set a new Cleared[floor] (pay the first clear ONLY when ok and first are both true). An error, or
-- fn returning false, restores the record (-> false). Afterwards: whole numbers, Best never goes down and is >= the
-- highest cleared floor, Cleared only grows (both merge that way in the store), Runs / Clears travel as +/- deltas. While
-- the profile is provisional only Runs may change: a first clear / a higher Best is refused with "Your save is still
-- loading" (nothing changes). A change is synced (throttled).
function DataService.MutateDungeon(player, fn)
	if not player or type(fn) ~= "function" then
		return false, "That is not valid"
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false, "Your save is still loading"
	end
	local profile = entry.Profile
	local live = P5.liveDungeon(profile)
	local before = P5.cleanDungeon(live)
	refill(live, before) -- fn sees the clean shape (Cleared as a set)
	local ok, result = pcall(fn, live)
	profile.Dungeon = live -- the record stays this table even if fn replaced the field
	if not ok then
		warn("[DataService] MutateDungeon callback errored (record restored): " .. tostring(result))
		refill(live, before)
		return false, "That is not valid"
	end
	if result == false then
		refill(live, before)
		return false, "That is not valid"
	end
	local after = P5.cleanDungeon(live)
	if after.Best < before.Best then
		after.Best = before.Best
	end
	local first = false
	for floor in pairs(before.Cleared) do
		after.Cleared[floor] = true
	end
	for floor in pairs(after.Cleared) do
		if not before.Cleared[floor] then
			first = true
		end
		if floor > after.Best then
			after.Best = floor
		end
	end
	local progress = first or after.Best ~= before.Best or after.Clears ~= before.Clears
	if progress and isProvisional(entry) then
		refill(live, before)
		return false, "Your save is still loading"
	end
	refill(live, after)
	if progress or after.Runs ~= before.Runs then
		entry.Dirty = true
		DataService.SyncSoon(player)
	end
	return true, first
end

-- Whole berries (0 before the profile loaded).
function DataService.GetBerries(player)
	local entry = player and cache[player.UserId]
	if not entry then
		return 0
	end
	return P5.cleanBerries(entry.Profile.Berries)
end

-- Adds n whole berries (n >= 1 after flooring; the caller keeps its own fractions). Allowed while provisional (a +
-- delta merges safely). The Berries attribute follows (<= 2 writes/s); no ProfileSync (C14). false for junk / early.
function DataService.AddBerries(player, n)
	if not player or not isFinite(n) then
		return false
	end
	local amount = math.floor(n)
	if amount < 1 then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local profile = entry.Profile
	profile.Berries = P5.cleanBerries(P5.cleanBerries(profile.Berries) + amount)
	entry.Dirty = true
	P5.pushBerries(player, false)
	return true
end

-- Takes n whole berries in ONE step (check, then subtract; no yield in between). false (nothing taken) when fewer are
-- owned, for junk amounts, before the load and while provisional (Y9: never from the client, never a double spend).
function DataService.SpendBerries(player, n)
	if not player or not isFinite(n) then
		return false
	end
	local amount = math.floor(n)
	if amount < 1 then
		return false
	end
	local entry = P3.realEntry(player)
	if not entry then
		return false
	end
	local profile = entry.Profile
	local have = P5.cleanBerries(profile.Berries)
	if have < amount then
		return false
	end
	profile.Berries = have - amount
	entry.Dirty = true
	P5.pushBerries(player, false)
	return true
end

-- { Music, Sfx, Gfx, Shake, SeenNotes, MouseLock, FastHatch } (a clean copy with per-key defaults; the defaults before
-- the load).
function DataService.GetSettings(player)
	local entry = player and cache[player.UserId]
	if not entry then
		return P5.newSettings()
	end
	return P5.cleanSettings(entry.Profile.Settings)
end

-- Stores one setting: key one of P5.SETTING_KEYS, value of its type and range (7.2; SeenNotes never goes down; FastHatch
-- a boolean, lobby shop 5.5). Allowed
-- while provisional (the live session's settings win the merge). Not synced: the client applied it already. -> ok
function DataService.SetSetting(player, key, value)
	if not player or type(key) ~= "string" or P5.SETTING_DEFAULTS[key] == nil then
		return false
	end
	local clean = P5.settingValue(key, value)
	if clean == nil then
		return false
	end
	local entry = cache[player.UserId]
	if not entry or not entry.Loaded then
		return false
	end
	local settings = ensureTable(entry.Profile, "Settings")
	local current = P5.settingValue(key, settings[key])
	if current == nil then
		current = P5.SETTING_DEFAULTS[key]
	end
	if key == "SeenNotes" and clean < current then
		return false
	end
	if settings[key] ~= clean then
		settings[key] = clean
		entry.Dirty = true
	end
	if key == "MouseLock" then
		-- an explicit choice: the one-time "lock ON" step never overrides it (also a choice made while provisional,
		-- before the step ran on the recovered profile; Migrations is a union, so the marker survives the merge)
		local migrations = ensureTable(entry.Profile, "Migrations")
		if migrations[P5.MOUSELOCK_MARK] ~= true then
			migrations[P5.MOUSELOCK_MARK] = true
			entry.Dirty = true
		end
	end
	return true
end

-- true when a stored record holds a preset with more than 3 keys (a Phase 4 save: the 4th slot), read leniently.
function P5.hadLongPreset(stored)
	local teams = type(stored) == "table" and stored.Teams or nil
	local presets = type(teams) == "table" and teams.Presets or nil
	if type(presets) ~= "table" then
		return false
	end
	for i = 1, P3.PRESETS do
		local list = presets[i]
		if list == nil then
			list = presets[tostring(i)]
		end
		if type(list) == "table" and (list[P3.MAX_SLOTS + 1] ~= nil or #list > P3.MAX_SLOTS) then
			return true
		end
	end
	return false
end

-- berries per old food id (TycoonCatalog.Berries.LegacyFood, else the local table)
function P5.legacyFood(catalog)
	local berries = catalog and type(catalog.Berries) == "table" and catalog.Berries or nil
	local legacy = berries and type(berries.LegacyFood) == "table" and berries.LegacyFood or nil
	return legacy or P5.LEGACY_FOOD
end

-- 9.2 step 2 (P5Dungeon) on a LIVE profile: Best = min(10, floor(TrialBest / 3)), Cleared[1..Best], Clears = Best
-- (only when the record held no clears yet), Runs untouched (0 for a Phase 4 save); the marker. Returns the info
-- { TrialBest, Best, Clears = the Clears this step wrote (the merge floor) }. No Cash, Gems or berries.
function P5.migrateDungeon(profile)
	local battle = P3.cleanBattle(profile.Battle)
	local best = math.min(P5.MIGRATE_MAX_FLOOR, math.floor(battle.TrialBest / P5.TRIALS_PER_FLOOR))
	local live = P5.liveDungeon(profile)
	local d = P5.cleanDungeon(live)
	local wrote = 0
	if best > d.Best then
		d.Best = best
	end
	for floor = 1, best do
		d.Cleared[floor] = true
	end
	if best > 0 and d.Clears == 0 then
		d.Clears = best
		wrote = best
	end
	refill(live, d)
	ensureTable(profile, "Migrations")[P5.DUNGEON_MARK] = true
	return { TrialBest = battle.TrialBest, Best = best, Clears = wrote }
end

-- 9.2 step 3 (P5Home): TycoonCatalog.FoldLegacy(home, firstTime) inside ONE MutateHome; on the first time the Food ->
-- berries step (Snack / Meal / Feast x LegacyFood, the basket cap ignored, Food zeroed) and MarkMigrated("P5Home") in
-- the same non-yielding step, ONLY when the fold ran (without TycoonCatalog.FoldLegacy the whole step is skipped and
-- retried on the next load, m14). After the marker the fold runs again only when it has something to fold (a key a
-- Phase 4 server sold during the rollout, 9.3). Returns the info, or nil when nothing ran.
function P5.migrateHome(entry, player)
	local catalog = getTycoonCatalog()
	local fold = catalog and type(catalog.FoldLegacy) == "function" and catalog.FoldLegacy or nil
	if not fold then
		return nil
	end
	local profile = entry.Profile
	local marked = tableOr(profile.Migrations)[P5.HOME_MARK] == true
	local firstTime = not marked
	-- a dry run on a clean copy: nothing to fold on a marked home -> no MutateHome, no dirty save
	local probe = cleanHome(liveHome(profile), false)
	local okProbe, changes = pcall(fold, probe, firstTime)
	if not okProbe then
		warn("[DataService] TycoonCatalog.FoldLegacy failed (the P5Home step runs again on the next load): " .. tostring(changes))
		return nil
	end
	if marked and changes ~= true then
		return nil
	end
	local before = cleanHome(liveHome(profile), false)
	local info = {
		FirstTime = firstTime,
		Folded = false,
		Veteran = before.Level > 0 or before.Prestige > 0 or next(before.Stations) ~= nil,
		Berries = 0,
		Food = {},
	}
	local ok = DataService.MutateHome(player, function(home)
		info.Folded = fold(home, firstTime) == true -- an error here restores the home: nothing is marked
		if marked and not info.Folded then
			return false
		end
		return true
	end)
	if not ok then
		return nil
	end
	if firstTime then
		local legacy = P5.legacyFood(catalog)
		local berries = 0
		for id, count in pairs(cleanCounts(profile.Food, MAX_FOOD)) do
			info.Food[id] = count
			local each = legacy[id]
			if isFinite(each) and each > 0 then
				berries = berries + count * math.floor(each)
			end
		end
		if berries > 0 then
			profile.Berries = P5.cleanBerries(P5.cleanBerries(profile.Berries) + berries)
			info.Berries = berries
			entry.BerriesMigrated = berries -- left out of the merge against a store another server already marked (m15 twin)
		end
		refill(ensureTable(profile, "Food"), {}) -- converted once; never written again (m16)
		ensureTable(profile, "Migrations")[P5.HOME_MARK] = true
		entry.Dirty = true
		P5.pushBerries(player, true)
	end
	return info
end

-- Bug batch 2 #21 (P5MouseLock) on a LIVE profile: Settings.MouseLock = true and the marker, once. A stored false from
-- before this step was the old default written along with another setting, not a choice (a false set through
-- SetSetting carries the marker already). Returns true when the setting changed.
function P5.migrateMouseLock(profile)
	local settings = ensureTable(profile, "Settings")
	local changed = settings.MouseLock ~= true
	settings.MouseLock = true
	ensureTable(profile, "Migrations")[P5.MOUSELOCK_MARK] = true
	return changed
end

-- Runs the Phase 5 migrations on a cache entry when they are due (loaded, not provisional; each one idempotent through
-- its marker, a profile another server migrated is left alone). Returns { Dungeon = info | nil, Home = info | nil } or nil.
function P5.migrateEntry(entry, player)
	if not entry or not entry.Loaded or isProvisional(entry) then
		return nil
	end
	local profile = entry.Profile
	local out = nil
	if tableOr(profile.Migrations)[P5.DUNGEON_MARK] ~= true then
		local ok, info = pcall(P5.migrateDungeon, profile)
		if ok then
			entry.Dirty = true
			if info.Clears > 0 then
				entry.DungeonMigrated = info.Clears -- merges as a max until the store holds it (m15)
			end
			out = { Dungeon = info }
		else
			warn("[DataService] Phase 5 dungeon migration failed (it runs again on the next load): " .. tostring(info))
		end
	end
	if tableOr(profile.Migrations)[P5.MOUSELOCK_MARK] ~= true then
		-- bug batch 2 #21: no toast, no Migrated signal (the client reads the setting from the Sync right after)
		local okLock, err = pcall(P5.migrateMouseLock, profile)
		if okLock then
			entry.Dirty = true
		else
			warn("[DataService] mouse lock migration failed (it runs again on the next load): " .. tostring(err))
		end
	end
	local okHome, home = pcall(P5.migrateHome, entry, player)
	if not okHome then
		warn("[DataService] Phase 5 home migration failed (it runs again on the next load): " .. tostring(home))
	elseif home then
		out = out or {}
		out.Home = home
	end
	if out then
		if type(entry.MigratedNow) ~= "table" then
			entry.MigratedNow = {}
		end
		if out.Dungeon then
			entry.MigratedNow[P5.DUNGEON_MARK] = out.Dungeon
		end
		if out.Home and out.Home.FirstTime then
			entry.MigratedNow[P5.HOME_MARK] = out.Home
		end
	end
	return out
end

-- Fires Migrated(player, "P5Dungeon" / "P5Home", info) right after the ProfileLoaded / ProfileRebased that ran them.
function P5.announceMigration(player, out)
	if type(out) ~= "table" or not player then
		return
	end
	if type(out.Dungeon) == "table" then
		DataService.Migrated:Fire(player, P5.DUNGEON_MARK, deepCopy(out.Dungeon))
	end
	if type(out.Home) == "table" then
		DataService.Migrated:Fire(player, P5.HOME_MARK, deepCopy(out.Home))
	end
end

----------------------------------------------------------------------
-- Stats
----------------------------------------------------------------------

-- Called by MatchService for every member at match end. `won` = finished on a victory.
function DataService.RecordMatch(player, difficultyId, won, seconds)
	local entry = player and cache[player.UserId]
	if not entry then
		return
	end
	local stats = entry.Profile.Stats
	stats.Matches = sanitize(stats.Matches + 1)
	if won == true then
		stats.Wins = sanitize(stats.Wins + 1)
		local clean = sanitizeSeconds(seconds)
		if clean and type(difficultyId) == "string" and Config.GetDifficulty(difficultyId) then
			local best = stats.BestTimes[difficultyId]
			if best == nil or clean < best then
				stats.BestTimes[difficultyId] = clean
			end
		end
	end
	entry.Dirty = true
end

----------------------------------------------------------------------
-- Autosave + shutdown
----------------------------------------------------------------------

function DataService.StartAutosave()
	hook()
	if autosaveStarted then
		return
	end
	autosaveStarted = true
	task.spawn(function()
		while not shuttingDown do
			local interval = Config.Tokens.AutosaveSeconds or 90
			local slept = 0
			-- Sleep in one-second slices so shutdown ends the loop promptly.
			while slept < interval and not shuttingDown do
				task.wait(1)
				slept = slept + 1
			end
			if shuttingDown then
				break
			end
			-- Walk the cache, not Players:GetPlayers(): entries of players who already left but could
			-- not be saved yet (orphans) must keep being flushed.
			local userIds = {}
			for userId in pairs(cache) do
				table.insert(userIds, userId)
			end
			for _, userId in ipairs(userIds) do
				if shuttingDown then
					break
				end
				local entry = cache[userId]
				-- (session lock: a load may now wait up to ClaimWaitSeconds for another server's lock; the sweep skips a
				-- loading entry instead of stalling on it: nothing of it may be written yet, the next sweep saves it)
				if entry and not entry.Loading then
					safeSave(userId)
					if entry.Orphan then
						settleOrphan(userId, entry)
					end
					task.wait(0.25) -- spread requests out to stay inside the DataStore budget
				end
			end
		end
	end)
end

function DataService.BindToClose()
	hook()
	if closeBound then
		return
	end
	closeBound = true
	game:BindToClose(function()
		shuttingDown = true
		local userIds = {}
		for userId in pairs(cache) do
			table.insert(userIds, userId)
		end
		local pending = #userIds
		for _, userId in ipairs(userIds) do
			task.spawn(function()
				local from = os.clock()
				-- session lock: the server is closing: every save lets go of the lock
				local ok, saved = pcall(saveEntry, userId, "release")
				-- review round 1: a load still claiming outlasted saveEntry's wait (a slow call; the claim loop stops at its
				-- next attempt now): once it ends, its lock is released too (inside the 25 s cap)
				local entry = cache[userId]
				if entry and entry.Loading then
					waitForLoad(entry)
					ok, saved = pcall(saveEntry, userId, "release")
				end
				-- review round 2: a provisional entry another server's live lock still holds (HeldBy) keeps claiming every
				-- ClaimRetrySeconds inside the cap, so its stand-in delta lands with the release once that lock frees
				local retry = math.max(P8.num("ClaimRetrySeconds"), 0.1)
				while not (ok and saved == true) and entry and cache[userId] == entry and entry.LoadFailed and entry.HeldBy
					and os.clock() - from + retry < P8.CLOSE_CAP do
					task.wait(retry)
					ok, saved = pcall(saveEntry, userId, "release")
				end
				pending = pending - 1
			end)
		end
		-- Roblox gives BindToClose ~30s; leave a margin.
		local waited = 0
		while pending > 0 and waited < P8.CLOSE_CAP do
			task.wait(0.1)
			waited = waited + 0.1
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1090">
          <Properties>
            <string name="Name">DevService</string>
            <string name="Source"><![CDATA[-- DevService: owner-only developer tools (Config.Dev). Lets the game's owner test everything: get every pet,
-- add tokens, restart / skip the tutorial and wipe their own data back to a brand-new player.
--
--   DevService.Init(deps)                          deps = { DataService, PetService, TutorialService, IndexService,
--                                                  BattleService, EventService, SkyService } (Phase 3: the raid
--                                                  command; the living sky: /sky)
--                                                  (pets are written into the profile the way PetService does it, and
--                                                  ProfileRebased refreshes its attributes; PetService.Refresh after
--                                                  /petlevel republishes EquippedInfo)
--   DevService.IsAllowed(player) -> bool           may yield ONCE per player for a group-owned game (group rank)
--   DevService.IsOwner(player) -> true | false | nil   the game's owner only (no Admins, no Studio rule): nil while a
--                                                  group game's rank could not be read (asked again next time); may
--                                                  yield like IsAllowed (lobby shop spec 16.6: LeaderboardService's
--                                                  Creator title; not reachable from a client)
--   DevService.Run(player, command, arg, source) -> ok, message
--                                                  the ONE entry point of the DevCommand remote and of chat:
--                                                  rate limit, permission check, validation, then the command
--   DevService.Commands                            the command names, in help order
--
-- Who is a developer (checked again on EVERY command; the client is never trusted):
--   Config.Dev.Enabled and (
--       (Config.Dev.AllowInStudio and RunService:IsStudio())          everyone while testing in Roblox Studio
--    or the game's owner: game.CreatorType == User and UserId == game.CreatorId,
--       or for a group-owned game the group's owner (GetRankInGroup(CreatorId) == 255, pcall, cached per player)
--    or player.UserId is listed in Config.Dev.Admins )
-- Allowed players get chat commands and two hints for their client, set on their PlayerGui (a PlayerGui only
-- replicates to its own player; an attribute on the Player itself would tell every client who the developers are):
--   NC_Dev = true            show the DEV button
--   NC_DevTutorial = true    show "Restart tutorial" (only when TutorialService has the Reload hook, see "tutorial")
-- They are only hints: the server checks the permission again on every command.
--
-- Commands (remote "DevCommand"(command, arg) or chat, case-insensitive):
--   allpets         one copy of every catalog pet the player does not own yet (Secret pets too), every pet marked
--                   discovered so the Pet Index fills up, then IndexService.Refresh
--   tokens [n]      DataService.AddTokens(n): n defaults to Config.Dev.GrantTokens, whole numbers only, clamped to
--                   1 .. Config.Dev.MaxTokensPerCommand (chat also takes "50,000", "50k", "1m")
--   reset           back to a brand-new player: tokens, pets, equipped pets, items, stats, Pet Index progress and
--                   rewards, Cash, Gems, home, pet levels, the battle teams (3 empty presets, preset 1 active),
--                   the battle record (trophies, trial clears, raid and PvP counters, event pets), the Phase 4 pet
--                   growth (evolution stages, training ranks and jobs), the Champion Ring record (Best 0, Runs 0),
--                   the Phase 5 Dungeon record (Best 0, no clears, Runs 0, Clears 0) and the berries (0; Settings
--                   stay: they are not progress; the Migrations markers stay: a reset player is not migrated
--                   again); the lobby spot
--                   stays assigned for this session. PetCareService.ClearSessions(player) (the live training /
--                   feeding sessions) and TycoonService.ClearCoins(player) (the coin piles) are called when those
--                   functions exist (PetCareService.ClearKitchen while the old Kitchen is still in the build).
--                   The tutorial starts again as a new player's (gift and finish
--                   reward included: the reset took those tokens) when TutorialService has the Reload hook. Without
--                   it a tutorial that already paid its gift is ended as skipped, because every step from "spin" on
--                   needs the tokens and pets the reset just took (it would wait forever); an earlier tutorial
--                   carries on. Then
--                   DataService.ProfileRebased fires so PetService republishes the equipped pets / perks and
--                   IndexService forgets the completed groups, and DataService.TeamsChanged fires for the battle
--                   services. Refused during a match and during a pet battle (player attribute InBattle).
--   tutorial        replay the tutorial from step 1. Needs the hook TutorialService.Reload(player, { Replay = true }):
--                   it drops the running tutorial and reads it again from the profile; Replay = true means the
--                   finish reward is not paid again. The stored progress goes back to step 1 with Gifted kept, so
--                   the "spin" gift is not paid again either (rewards are never paid twice). Without the hook the
--                   command is refused, nothing changes, and the panel hides the button (NC_DevTutorial).
--   skiptutorial    mark the tutorial done without the finish reward (TutorialService.HandleEvent(player, "Skip"))
--   raid [boss|end] boss raids: the next boss (or that boss) now, or when the running fights end (EventService.StartNow("BossRaid"));
--                   "end" ends the running fights (EventService.EndNow("BossRaid")). Touches no profile data.
--   berries [n]     Phase 5: DataService.AddBerries(n): n defaults to Config.Dev.GrantBerries (5000 without it),
--                   whole numbers only, clamped like tokens; the Berries attribute follows (allowed while provisional)
--   petlevel <n>    Phase 4: sets every EQUIPPED pet's level to n (1..the curve's max level, 100; XP 0) through
--                   DataService.SetPetLevel, to try "Ready to evolve!" / EVOLVE at 20 and 50 quickly. Refused with
--                   no pet equipped, a level out of range, a provisional profile. Levels only: evolution stages and
--                   training ranks are untouched.
--   sky [what]      the living sky (server/Services/SkyService; plan 2026-10-30-living-sky Task 4), for everyone in the
--                   server (the clock is Workspace attributes): /sky alone names the phase, /sky dawn|day|sunset|night
--                   starts that phase now, /sky speed <x> runs the loop x times faster (clamped 0.1..120, the loop keeps
--                   its position; not a number = refused), /sky raid <boss> previews a raid sky (a boss id or a unique
--                   start of one: "/sky raid frost"), /sky clear takes it down. Touches no profile data.
--   kick <player> [reason]   removes a player from this server (Player:Kick; the reason goes through the text filter, and a
--                   filter that fails drops it). <player> is a userId, a name or display name, a unique part is enough (exact names
--                   win); refuses yourself, an unknown or ambiguous name. Needs no profile.
--   ban <player> [reason]    a permanent ban (Players:BanAsync, Duration -1, the whole universe; the engine removes a player in
--                   the server). <player>: anyone by exact name or userId, or someone in the server by their exact display name; a
--                   part of a name only earns a hint, and a display name two players share is refused. Refuses yourself and any other developer (Config.Dev.Admins, the owner, IsAllowed for those in the
--                   server), online or offline. The API's own error is the toast; so is Players.BanningEnabled off. In Studio
--                   Roblox validates a ban but only runs it on live servers: the toast says nobody was banned.
--   unban <name|userId>      Players:UnbanAsync in the same scope, the same honest toasts.
--   evolvepets      every pet the player owns goes up one stage, free and with no level requirement (2nd evolution Epic+ only,
--                   PetCatalog.MaxEvolution): DataService.SetEvolution + PetCareService.Evolved through PetCareService.DevEvolve.
--                   The stage lives on the key, so keys, copies, teams, Equipped, Garden and running training jobs stay as they
--                   are; a stack shares its one stage. Refused in a battle like the real EVOLVE. Saved. (/evolve is the preview.)
--   levelall <n>    every pet the player owns (not only the equipped ones, unlike /petlevel) to level n (1..100, XP 0) through
--                   DataService.SetPetLevel. Refused in a battle.
--   maxpets         every pet the player owns: level 100 (the curve's top), its highest allowed evolution stage and rank 10 in all
--                   four training skills (Speed, Physique, Ability, Defense): all BattleCatalog.UnitStats reads from a pet's
--                   progress. A running training job finishes first through its real completion (the pet comes back, no refund).
--                   The tier (Golden / Rainbow) stays: it is another copy with another key. Refused in a battle. Saved.
--   speed           toggles 2x walking and running: the hint NC_DevSpeed on the developer's PlayerGui, which MovementController
--                   reads (off by default, not saved, survives a respawn, ends with the session; nothing on the server checks
--                   a character's speed outside a battle, where the client leaves it alone).
--   devhelp         three toasts listing the chat commands (the pet showcase ones, the new tools, then the others)
-- The pet showcase (nothing is saved; the pets are built on the developer's OWN client only, by
-- client/Controllers/DevPetShow.lua, through the server -> client remote DevPetShow(action, payload)):
--   pet <pet> [stage]       one pet in front of you, at stage 0 (normal, the default), 1 (evolved) or 2 (second
--                           evolution, Epic pets and up). <pet> is its name or id, spaces and case do not matter and
--                           a unique part is enough ("/pet cloudy 2"); stage words: normal, evolved, evolved2 / max.
--                           -> Spawn { PetId, Stage }
--   pets [stage]            every pet (that has the stage) lined up in front of you -> Lineup { Stage, PetIds }
--   evolve <pet|all> [stage]   the evolution animation: with no stage the whole line (normal -> evolved, then ->
--                           evolved II for Epic+), 1 = normal -> evolved, 2 = evolved -> evolved II; "all" plays
--                           every pet's evolutions one after another -> Evolve { Steps = { {PetId, From, To}, ... } }
--   fx <element> <attack> [kind|shape] [rarity] [stage]
--                           the pet attack VFX preview (plan docs/superpowers/plans/2026-10-23-pet-attack-vfx.md
--                           Task 7): a caster pet of that element (and rarity, when the catalog has one) and a dummy
--                           target 10 studs apart in front of you play client/Controllers/AttackFx. Words are
--                           shared/AttackFxCatalog's names in any case: <element> (Flame, Water...), <attack> (Melee,
--                           Ranged, Special, Element, Hurt, Ko, Victory), then in any order a special's kind (Blast,
--                           Beam...; none = the caster pet's own), an element attack's shape (Cone, Circle, Line), a
--                           rarity (default Common) and a stage (0-2 or the stage words, default 0)
--                           -> Fx { Element, Attack, Kind, Shape, Rarity, Stage }
--   clearpets               removes the showcase pets (and the fx pair) and stops an evolution -> Clear {}
-- They need no loaded profile and run while it is provisional; they change no data.
-- After every change: DataService.MarkDirty + Sync (the menu updates at once) and a side toast "DEV: ..." (kind
-- "good"); refusals get a "bad" toast. Rate limit: 4 commands per 2 seconds per player. Every command is logged with
-- print("[NimbusClimb][Dev] ...") including the UserId. Nothing yields between reading and writing the profile.
--
-- Chat: "/allpets", "/tokens 50000", "/reset", "/tutorial", "/skiptutorial", "/raid", "/sky sunset", "/petlevel 20", "/pet cloudy dragon 2",
-- "/pets 1", "/evolve all", "/fx flame ranged epic", "/clearpets", "/kick name reason", "/ban name reason", "/unban name", "/evolvepets",
-- "/levelall 50", "/maxpets", "/speed", "/devhelp", typed in the GAME's chat (not Studio's command bar). Two ways in, one
-- parser (onChatted): Player.Chatted of allowed players (the legacy chat), and one TextChatCommand per command
-- (PrimaryAlias "/<command>", children of TextChatService, made at Init when the place uses TextChatService):
-- the new chat only hands a "/" message to the game when a TextChatCommand claims it, and claimed commands stay
-- out of the public chat. Their Triggered event fires for every player; the permission check is the same.
-- The same text from the same player again within DUPLICATE_WINDOW seconds is dropped (both ways may fire).
-- Other "/" messages are left alone.
-- Studio auto grant: with Config.Dev.StudioAutoGrant in Studio, every allowed player gets allpets + tokens once per
-- server, right after their profile loads (a provisional profile waits until DataService.ProfileRebased says it
-- recovered).
-- The DevCommand listener is connected even when Config.Dev.Enabled is false (or DataService is missing): Roblox
-- queues every event fired at a RemoteEvent nobody listens to, so a switched-off build must still drop them at once
-- (Run rate-limits them and IsAllowed refuses everybody).
--
-- Persistence: DataService merges Discovered, IndexClaimed, Tutorial.Done / Gifted and best times so they only
-- ever grow (a gift can never be paid twice). reset and tutorial therefore call DataService.ResetFields for the
-- fields they rewind (reset: Discovered, IndexClaimed, best times, the rewound Tutorial, the Phase 2 Home / Tiers /
-- Hybrids / PetLevels, the Phase 3 Teams / Battle, whose cleared trials and event pets only grow, and the Phase 4
-- PetGrowth / Ring, whose stages, ranks and Best only rise in the merge; tutorial: Tutorial):
-- the next successful save writes the session's values over the stored ones, so the reset lasts with DataStores
-- on (the live game, Studio with API access) and a replay is not ended by the next autosave. Everything else
-- (tokens, pets, the old Items field, stats, ...) follows through the normal delta save.
-- While DataService.IsProvisional(player) (the profile's load failed during a DataStore outage and the real save
-- is still being read) only tokens and devhelp run: allpets, reset, tutorial and skiptutorial would work on stand-in
-- defaults, so they are refused with "your data is still loading".
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DevService = {}

DevService.Commands = {
	"allpets", "tokens", "cash", "gems", "berries", "petlevel", "reset", "tutorial", "skiptutorial", "raid", "sky", "pet", "pets",
	"evolve", "fx", "clearpets", "kick", "ban", "unban", "evolvepets", "levelall", "maxpets", "speed", "devhelp",
}

local TAG = "[NimbusClimb][Dev] "
local ATTR = "NC_Dev" -- PlayerGui attribute: true for developers (a hint for the client's DEV button)
local ATTR_TUTORIAL = "NC_DevTutorial" -- PlayerGui attribute: true when "Restart tutorial" works in this build
local ATTR_SPEED = "NC_DevSpeed" -- PlayerGui attribute: true while /speed is on (MovementController reads it)
local PLAYER_GUI_WAIT = 10 -- seconds to wait for a joining player's PlayerGui
local RATE_COUNT = 4 -- commands ...
local RATE_WINDOW = 2 -- ... per this many seconds, per player
local MAX_COMMAND_LENGTH = 32
local MAX_CHAT_LENGTH = 200
local DUPLICATE_WINDOW = 0.35 -- seconds: one chat line seen twice (Player.Chatted + TextChatCommand) runs once
local GROUP_OWNER_RANK = 255
local TOAST_SECONDS = 4
local HELP_SECONDS = 8

local KNOWN = {}
for _, name in ipairs(DevService.Commands) do
	KNOWN[name] = true
end
-- the commands that still run while the profile is provisional (see the persistence note)
local PROVISIONAL_OK = {
	tokens = true, cash = true, gems = true, berries = true, raid = true, devhelp = true, pet = true, pets = true, evolve = true,
	fx = true, clearpets = true, sky = true, kick = true, ban = true, unban = true, speed = true,
}
-- the pet showcase (and the sky) never touches the profile, so it does not wait for it
local NO_PROFILE = { pet = true, pets = true, evolve = true, fx = true, clearpets = true, sky = true, kick = true, ban = true, unban = true, speed = true }
-- the commands that take a whole-number amount
local NUMERIC = { tokens = true, cash = true, gems = true, berries = true, petlevel = true, levelall = true }
-- the commands that take a value, and its type (tokens / cash / gems / berries / petlevel: a number; the showcase: the
-- rest of the chat line)
local ARG_KIND = { raid = "string", tokens = "number", cash = "number", gems = "number", berries = "number", petlevel = "number", levelall = "number", pet = "string", pets = "string", evolve = "string", fx = "string", sky = "string", kick = "string", ban = "string", unban = "string" }
-- the example value a refusal toast shows for a numeric command (50000 for the currencies), and for a text one
local ARG_EXAMPLE = { petlevel = "20", levelall = "50" }
local TEXT_EXAMPLE = { raid = "/raid lava", sky = "/sky sunset", kick = "/kick name reason", ban = "/ban name reason", unban = "/unban name" }
local MAX_ARG_LENGTH = 48
local MAX_REASON_ARG_LENGTH = 180 -- /kick and /ban: a name and a reason
local DEFAULT_MAX_PET_LEVEL = 100 -- /petlevel's cap when neither PetCatalog nor TycoonCatalog names one
local TRAINING_SKILLS = { "Speed", "Physique", "Ability", "Defense" } -- PetGrowth[key][skill] = rank (BattleCatalog.UnitStats reads them)
local DEFAULT_MAX_RANK = 10
local KICK_TEXT = "You were removed from this server by the game's developer."
local BAN_TEXT = "You are banned from this game."
local MAX_ERROR_TEXT = 70 -- an API error in a toast (they fit a side toast; the whole error goes to the output)
local MAX_USER_ID = 2 ^ 53
-- the commands that act on other players: their success is a "good" toast, though no data changed
local GOOD_TOAST = { kick = true, ban = true, unban = true }
local STAGE_NAMES = { [0] = "Normal", [1] = "Evolved", [2] = "Evolved II" }
local STAGE_WORDS = {
	["0"] = 0, normal = 0, base = 0,
	["1"] = 1, evolved = 1, evo = 1, e1 = 1,
	["2"] = 2, evolved2 = 2, evo2 = 2, e2 = 2, ii = 2, second = 2, max = 2,
}

----------------------------------------------------------------------
-- Collaborators (other engineers' modules: every use is guarded)
----------------------------------------------------------------------

local function loadModule(parent, name)
	local module = parent and parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[DevService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local PetCatalog = loadModule(Shared, "PetCatalog")
local PetBuilder = nil -- loaded on the first showcase command (MaxEvolution)
local AttackFxCatalog = nil -- loaded on the first /fx (its name lists validate the words)
local DataService = nil
local TutorialService = nil
local IndexService = nil
local EventService = nil -- Phase 3: /raid
local BattleService = nil
local PetService = nil -- Phase 4: /petlevel republishes EquippedInfo
local SkyService = nil -- the living sky: /sky

local function hasFunction(module, name)
	return type(module) == "table" and type(module[name]) == "function"
end

local function hasSignal(module, name)
	return type(module) == "table" and type(module[name]) == "table" and type(module[name].Connect) == "function"
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local rankCache = {} -- [player] = true / false: group owner (only successful GetRankInGroup answers are cached)
local devs = {} -- [player] = true: allowed when they joined (only decides who hears "slow down"; never a permission)
local recent = {} -- [player] = { os.clock() of the commands accepted in the current window }
local rateWarned = {} -- [player] = os.clock() of the last "slow down" toast
local chatConns = {} -- [player] = Chatted connection
local lastChat = {} -- [player] = { Text, At }: the last chat line handled (duplicates are dropped)
local chatCommandsMade = false
local autoGranted = {} -- [userId] = true once the Studio auto grant ran in this server
local initialized = false
local ready = false -- Init finished with the tools on (Config.Dev.Enabled and a DataService)

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function devConfig()
	if type(Config.Dev) == "table" then
		return Config.Dev
	end
	return {}
end

local function isWhole(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge and n == math.floor(n)
end

local function commas(n)
	local ok, text = pcall(Util.Commas, n)
	if ok and type(text) == "string" then
		return text
	end
	return tostring(n)
end

local function who(player)
	return "UserId " .. tostring(player.UserId) .. " (" .. tostring(player.Name) .. ")"
end

-- An untrusted command name made safe for the log.
local function printable(value)
	if type(value) ~= "string" then
		return "<" .. type(value) .. ">"
	end
	return (string.gsub(string.sub(value, 1, MAX_COMMAND_LENGTH), "[^%w_%-]", "?"))
end

local function log(player, source, command, arg, outcome)
	local argText = ""
	if arg ~= nil then
		if type(arg) == "number" then
			argText = " " .. tostring(arg)
		else
			argText = " <" .. type(arg) .. ">"
		end
	end
	print(TAG .. who(player) .. " via " .. tostring(source) .. ": " .. printable(command) .. argText .. " -> " .. outcome)
end

local function notify(player, text, kind, duration)
	if not isLivePlayer(player) then
		return
	end
	local ok, remote = pcall(Remotes.Get, "Notify")
	if ok and remote then
		local sent, err = pcall(function()
			remote:FireClient(player, text, kind or "info", duration or TOAST_SECONDS)
		end)
		if not sent then
			warn("[DevService] Notify failed: " .. tostring(err))
		end
	end
end

local function getProfile(player)
	if not hasFunction(DataService, "GetProfile") then
		return nil
	end
	local ok, profile = pcall(DataService.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function markDirtyAndSync(player)
	if hasFunction(DataService, "MarkDirty") then
		DataService.MarkDirty(player)
	end
	if hasFunction(DataService, "Sync") then
		DataService.Sync(player)
	end
end

-- true while the player's profile holds stand-in defaults (its load failed during a DataStore outage)
local function isProvisional(player)
	if not hasFunction(DataService, "IsProvisional") then
		return false
	end
	local ok, provisional = pcall(DataService.IsProvisional, player)
	return ok and provisional == true
end

-- Asks DataService to write the session's values of these fields over the stored ones at the next save (they are
-- merged so they only ever grow otherwise, which would undo the reset). See the persistence note in the header.
local function overwriteStored(player, fields)
	if not hasFunction(DataService, "ResetFields") then
		return
	end
	local ok, err = pcall(DataService.ResetFields, player, fields)
	if not ok then
		warn("[DevService] DataService.ResetFields failed: " .. tostring(err))
	end
end

-- Empties a table in place (other modules may hold a reference to it).
local function wipe(t)
	if type(t) ~= "table" then
		return
	end
	for key in pairs(t) do
		t[key] = nil
	end
end

-- The profile table at holder[field], created when missing.
local function tableField(holder, field)
	local t = holder[field]
	if type(t) ~= "table" then
		t = {}
		holder[field] = t
	end
	return t
end

----------------------------------------------------------------------
-- Who may use the tools
----------------------------------------------------------------------

-- Owner of a group-owned game: rank 255 in that group -> true | false | nil. GetRankInGroup is a web call, so it runs in
-- a pcall and only a real answer is cached; a failure answers nil (unknown: tried again on the next command or ask).
local function isGroupOwner(player, groupId)
	if type(groupId) ~= "number" or groupId <= 0 then
		return false
	end
	local cached = rankCache[player]
	if cached ~= nil then
		return cached
	end
	local ok, rank = pcall(function()
		return player:GetRankInGroup(groupId)
	end)
	if not ok then
		print(TAG .. "could not read the group rank of " .. who(player) .. ": " .. tostring(rank))
		return nil
	end
	local owner = rank == GROUP_OWNER_RANK
	if player.Parent == Players then
		rankCache[player] = owner -- never cache a player who left while we asked
	end
	return owner
end

local function isOwner(player)
	local creatorType = game.CreatorType
	local creatorId = game.CreatorId
	if creatorType == Enum.CreatorType.User then
		return type(creatorId) == "number" and creatorId > 0 and player.UserId == creatorId
	elseif creatorType == Enum.CreatorType.Group then
		return isGroupOwner(player, creatorId)
	end
	return false
end

local function isAdminId(userId, admins)
	if type(admins) ~= "table" then
		return false
	end
	for key, value in pairs(admins) do
		-- a list of UserIds (numbers or digit strings), or a map { [UserId] = true }
		if tonumber(value) == userId or (value == true and tonumber(key) == userId) then
			return true
		end
	end
	return false
end

local function isAdmin(player, admins)
	return isAdminId(player.UserId, admins)
end

function DevService.IsAllowed(player)
	if not isLivePlayer(player) then
		return false
	end
	local dev = devConfig()
	if dev.Enabled ~= true then
		return false
	end
	if dev.AllowInStudio == true and RunService:IsStudio() then
		return true
	end
	if isAdmin(player, dev.Admins) then
		return true
	end
	return isOwner(player) == true -- a group rank that could not be read (nil) is "not allowed" for now
end

-- The game's owner only (lobby shop spec 16.6, the Creator title): a User game's creator, or rank 255 in the group that
-- owns a group game. Never Config.Dev.Admins, never Studio's AllowInStudio, works with the tools switched off.
function DevService.IsOwner(player)
	if not isLivePlayer(player) then
		return false
	end
	return isOwner(player)
end

-- Sliding window: true when another command fits into the last RATE_WINDOW seconds.
local function takeSlot(player)
	local now = os.clock()
	local kept = {}
	for _, at in ipairs(recent[player] or {}) do
		if now - at < RATE_WINDOW then
			kept[#kept + 1] = at
		end
	end
	if #kept >= RATE_COUNT then
		recent[player] = kept
		return false
	end
	kept[#kept + 1] = now
	recent[player] = kept
	return true
end

----------------------------------------------------------------------
-- Commands. Each one: (player, profile, arg) -> ok, message, changed. None of them yields.
----------------------------------------------------------------------

-- TutorialService.Reload(player, opts): drops the running tutorial and reads it again from the profile
-- (opts.Replay = true: do not pay the finish reward again). nil while TutorialService has no such hook.
local function tutorialReloader()
	if hasFunction(TutorialService, "Reload") then
		return TutorialService.Reload
	end
	return nil
end

-- Puts the stored tutorial back to step 1 and lets TutorialService read it again.
-- A reset is a brand-new player (the gift's tokens are gone, so the gift and the finish reward are paid again);
-- a restart is a replay: Gifted stays as it is and Replay asks TutorialService not to pay the finish reward again.
local function rewindTutorial(player, profile, reload, isReset)
	local tutorial = tableField(profile, "Tutorial")
	tutorial.Step = 1
	tutorial.Done = false
	if isReset then
		tutorial.Gifted = false
	end
	if reload then
		local ok, err = pcall(reload, player, { Replay = not isReset })
		if not ok then
			warn("[DevService] TutorialService.Reload failed: " .. tostring(err))
		end
	end
end

-- Reset without the Reload hook: a tutorial that already paid its gift is skipped (no finish reward), because
-- every step from "spin" on needs the tokens and pets the reset just took. Returns the note for the toast.
local function settleTutorialAfterReset(player, profile)
	local tutorial = profile.Tutorial
	if type(tutorial) ~= "table" or tutorial.Gifted ~= true or tutorial.Done == true then
		return "" -- not started on the gift yet (it carries on and pays the gift) or already finished
	end
	if not hasFunction(TutorialService, "HandleEvent") then
		return ""
	end
	local ok, skipped = pcall(TutorialService.HandleEvent, player, "Skip")
	if not ok then
		warn("[DevService] TutorialService.HandleEvent failed: " .. tostring(skipped))
		return ""
	end
	if skipped == true then
		return " (tutorial skipped)"
	end
	return ""
end

local function cmdAllPets(player, profile)
	if not PetCatalog or type(PetCatalog.Pets) ~= "table" then
		return false, "the pet catalog is missing"
	end
	local pets = tableField(profile, "Pets")
	local added, total = 0, 0
	for _, def in ipairs(PetCatalog.Pets) do
		if type(def) == "table" and type(def.Id) == "string" then
			total = total + 1
			local owned = pets[def.Id]
			if type(owned) ~= "number" or owned < 1 then
				pets[def.Id] = 1
				added = added + 1
			end
			if hasFunction(DataService, "MarkDiscovered") then
				DataService.MarkDiscovered(player, def.Id)
			end
		end
	end
	if hasFunction(IndexService, "Refresh") then
		local ok, err = pcall(IndexService.Refresh, player)
		if not ok then
			warn("[DevService] IndexService.Refresh failed: " .. tostring(err))
		end
	end
	if added == 0 then
		return true, "you already own all " .. total .. " pets", false
	end
	return true, "you got " .. added .. " new pets: all " .. total .. " are yours!", true
end

local function cmdTokens(player, profile, arg)
	local dev = devConfig()
	local amount = arg
	if amount == nil then
		amount = isWhole(dev.GrantTokens) and dev.GrantTokens or 1000000
	end
	if not isWhole(amount) then
		return false, "tokens needs a whole number, like /tokens 50000"
	end
	local maxAmount = isWhole(dev.MaxTokensPerCommand) and dev.MaxTokensPerCommand or 100000000
	amount = math.max(1, math.min(amount, math.max(1, maxAmount)))
	if not hasFunction(DataService, "AddTokens") then
		return false, "tokens are unavailable right now"
	end
	DataService.AddTokens(player, amount)
	return true, "+" .. commas(amount) .. " Cloud Tokens", true
end

-- Phase 2 currencies (tycoon Cash and premium Gems) for testing the homes, fusion and the gem roulettes.
local function grantCurrency(player, arg, label, configKey, fallback, adder)
	local dev = devConfig()
	local amount = arg
	if amount == nil then
		amount = isWhole(dev[configKey]) and dev[configKey] or fallback
	end
	if not isWhole(amount) then
		return false, label .. " needs a whole number, like /" .. string.lower(label) .. " 50000"
	end
	local maxAmount = isWhole(dev.MaxTokensPerCommand) and dev.MaxTokensPerCommand or 100000000
	amount = math.max(1, math.min(amount, math.max(1, maxAmount)))
	if not hasFunction(DataService, adder) then
		return false, label .. " is unavailable in this build"
	end
	DataService[adder](player, amount)
	return true, "+" .. commas(amount) .. " " .. label, true
end

local function cmdCash(player, profile, arg)
	return grantCurrency(player, arg, "Cash", "GrantCash", 1000000, "AddCash")
end

local function cmdGems(player, profile, arg)
	return grantCurrency(player, arg, "Gems", "GrantGems", 1000, "AddGems")
end

-- Phase 5: /berries <n> adds whole berries through DataService.AddBerries (Config.Dev.GrantBerries, else 5000)
local function cmdBerries(player, profile, arg)
	return grantCurrency(player, arg, "Berries", "GrantBerries", 5000, "AddBerries")
end

local function cmdReset(player, profile)
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "leave the match first, then reset"
	end
	-- Phase 3: BattleService sets InBattle (the battle id) while the player's team fights
	local battleId = player:GetAttribute(Config.Attr.InBattle or "InBattle")
	if battleId ~= nil and battleId ~= false and battleId ~= "" and battleId ~= 0 then
		return false, "leave the battle first, then reset"
	end
	local reload = tutorialReloader()
	-- tokens through the public API so the HUD attribute and the leaderboard follow
	if hasFunction(DataService, "SpendTokens") and hasFunction(DataService, "GetTokens") then
		DataService.SpendTokens(player, DataService.GetTokens(player))
	end
	profile.Tokens = 0
	wipe(tableField(profile, "Pets"))
	wipe(tableField(profile, "Equipped"))
	wipe(tableField(profile, "Items")) -- HUD cleanup: the obby items are gone; the stored field stays empty (harmless)
	local stats = tableField(profile, "Stats")
	stats.Matches, stats.Wins, stats.TokensEarned, stats.Spins = 0, 0, 0, 0
	wipe(tableField(stats, "BestTimes"))
	wipe(tableField(profile, "Discovered"))
	wipe(tableField(profile, "IndexClaimed"))
	profile.Cash = 0
	profile.Gems = 0
	-- Phase 2: the tycoon home (stations, garden, gym, collector), fused copies, food and pet levels go too
	local home = tableField(profile, "Home")
	home.Level, home.Prestige = 0, 0
	home.CollectorCash = 0
	wipe(tableField(home, "Rooms"))
	wipe(tableField(home, "Stations"))
	wipe(tableField(home, "Garden"))
	wipe(tableField(home, "Gym"))
	wipe(tableField(profile, "PetLevels"))
	wipe(tableField(profile, "Tiers"))
	wipe(tableField(profile, "Hybrids"))
	wipe(tableField(profile, "Food"))
	-- Phase 4: evolution stages, training ranks and running jobs go; the Champion Ring record starts over; the
	-- Migrations markers stay (a reset player is not migrated a second time: there is nothing old to migrate)
	wipe(tableField(profile, "PetGrowth"))
	local ring = tableField(profile, "Ring")
	wipe(ring)
	ring.Best, ring.Runs = 0, 0
	-- lobby shop (spec 5.2 / 6; review round 1): the Secret Roulette pity starts over (7 spins to the next forced Secret)
	local pity = tableField(profile, "Pity")
	wipe(pity)
	pity.Secret = { Spins = 0, Hit = 0 }
	-- Phase 5: the Dungeon record starts over and the berries go (Settings stay: they are not progress)
	local dungeon = tableField(profile, "Dungeon")
	wipe(dungeon)
	dungeon.Best, dungeon.Cleared, dungeon.Runs, dungeon.Clears = 0, {}, 0, 0
	profile.Berries = 0
	-- Store build: the daily gifts (streak, play-day) and the Trove asks start over; Store (bought packs, passes seen,
	-- potion ends) is kept: Robux
	local daily = tableField(profile, "Daily")
	wipe(daily)
	daily.Streak, daily.Paid, daily.LastClaimAt, daily.Weeks, daily.Pet = 0, 0, 0, 0, false
	daily.PlayStart, daily.PlaySec, daily.PlayClaimed = 0, 0, {}
	wipe(tableField(profile, "Trove"))
	if Config.Attr.Berries and player:GetAttribute(Config.Attr.Berries) ~= nil then
		player:SetAttribute(Config.Attr.Berries, 0)
	end
	-- the live session state of the other services: training / feeding sessions (Phase 4 PetCareService.ClearSessions;
	-- the old Kitchen's ClearKitchen while that build is still here) and the coin piles (TycoonService.ClearCoins)
	local care = loadModule(script.Parent, "PetCareService")
	if hasFunction(care, "ClearSessions") then
		pcall(care.ClearSessions, player)
	elseif hasFunction(care, "ClearKitchen") then
		pcall(care.ClearKitchen, player)
	end
	local tycoon = loadModule(script.Parent, "TycoonService")
	if hasFunction(tycoon, "ClearCoins") then
		pcall(tycoon.ClearCoins, player)
	end
	-- Phase 3: the battle teams (3 empty presets, preset 1 active) and the battle record (trophies, trial clears, raid /
	-- PvP counters, event pets), in the shape DataService keeps them
	local teams = tableField(profile, "Teams")
	wipe(teams)
	teams.Presets = { {}, {}, {} }
	teams.Active = 1
	if hasFunction(DataService, "SyncEquipped") then
		DataService.SyncEquipped(player)
	end
	local battle = tableField(profile, "Battle")
	wipe(battle)
	for _, field in ipairs({ "Trophies", "TrialBest", "Raids", "RaidBestDamage", "PvPWins", "PvPLosses" }) do
		battle[field] = 0
	end
	battle.TrialCleared = {}
	battle.EventPets = {}
	for _, attr in ipairs({ Config.Attr.Cash, Config.Attr.Gems }) do
		if attr and player:GetAttribute(attr) ~= nil then
			player:SetAttribute(attr, 0)
		end
	end
	-- the tutorial: a new player's again when TutorialService can re-read it (or the build has none); otherwise
	-- it must not wait forever on a step that needs what was just wiped
	local tutorialNote = ""
	local rewound = reload ~= nil or not TutorialService
	-- the grow-only fields are written over the store at the next save (the store would merge them back otherwise)
	overwriteStored(player, {
		Discovered = true,
		IndexClaimed = true,
		BestTimes = true,
		Tutorial = rewound,
		-- Phase 2: a higher stored prestige would otherwise win the Home merge and bring the old home back
		Home = true,
		Tiers = true,
		Hybrids = true,
		PetLevels = true,
		-- Phase 3: cleared trials and event pets only grow and best values only rise in the merge
		Teams = true,
		Battle = true,
		-- Phase 4: evolution stages, training ranks and the ring record only rise in the merge (Migrations are kept)
		PetGrowth = true,
		Ring = true,
		-- Phase 5: Dungeon Best / Cleared only grow in the merge (Berries travel as a delta, Settings stay)
		Dungeon = true,
		-- Store build: the Daily pair / Play group merge as maxima and the Trove asks as a union (Store is kept)
		Daily = true,
		Trove = true,
		-- lobby shop: Pity.Secret.Hit merges as the maximum and would come back
		Pity = true,
	})
	if rewound then
		rewindTutorial(player, profile, reload, true)
	else
		tutorialNote = settleTutorialAfterReset(player, profile)
	end
	-- the profile changed underneath every other service: PetService republishes the equipped pets and perks,
	-- IndexService forgets the completed groups (execute() then marks it dirty and syncs it to the client)
	if hasSignal(DataService, "ProfileRebased") then
		DataService.ProfileRebased:Fire(player, profile)
	end
	-- Phase 3: the battle services re-read the (now empty) teams
	if hasSignal(DataService, "TeamsChanged") then
		DataService.TeamsChanged:Fire(player)
	end
	return true, "data reset: you are a brand-new player" .. tutorialNote, true
end

local function cmdTutorial(player, profile)
	local reload = tutorialReloader()
	if not reload then
		return false, "Restart tutorial is not in this build yet"
	end
	overwriteStored(player, { Tutorial = true }) -- Done would otherwise stick in the store and end the replay
	rewindTutorial(player, profile, reload, false)
	return true, "the tutorial starts again from step 1", true
end

local function cmdSkipTutorial(player, profile)
	if hasFunction(TutorialService, "HandleEvent") then
		local ok, success, reason = pcall(TutorialService.HandleEvent, player, "Skip")
		if not ok then
			warn("[DevService] TutorialService.HandleEvent failed: " .. tostring(success))
			return false, "the tutorial could not be skipped"
		end
		if success ~= true then
			return false, string.lower(tostring(reason or "the tutorial could not be skipped"))
		end
		return true, "tutorial skipped (no finish reward)", true
	end
	-- no TutorialService in this build: just store it as done
	local tutorial = tableField(profile, "Tutorial")
	if tutorial.Done == true then
		return false, "the tutorial is already finished"
	end
	tutorial.Done = true
	return true, "tutorial skipped (no finish reward)", true
end

-- Phase 4: the top of the pet XP curve (PetCatalog.MaxPetLevel, else TycoonCatalog.PetXp.MaxLevel, else 100)
local function maxPetLevel()
	if PetCatalog and hasFunction(PetCatalog, "MaxPetLevel") then
		local ok, top = pcall(PetCatalog.MaxPetLevel)
		if ok and isWhole(top) and top >= 1 then
			return top
		end
	end
	local tycoon = loadModule(Shared, "TycoonCatalog")
	local px = tycoon and type(tycoon.PetXp) == "table" and tycoon.PetXp or nil
	if px and isWhole(px.MaxLevel) and px.MaxLevel >= 1 then
		return px.MaxLevel
	end
	return DEFAULT_MAX_PET_LEVEL
end

-- Phase 4: every equipped pet to level n (XP 0) through DataService.SetPetLevel (the curve's cap; owned keys only).
local function cmdPetLevel(player, profile, arg)
	local top = maxPetLevel()
	if not isWhole(arg) then
		return false, "petlevel needs a whole number from 1 to " .. top .. ", like /petlevel 20"
	end
	if arg < 1 or arg > top then
		return false, "petlevel takes a level from 1 to " .. top
	end
	if not hasFunction(DataService, "SetPetLevel") then
		return false, "pet levels are unavailable in this build"
	end
	local equipped = type(profile.Equipped) == "table" and profile.Equipped or {}
	if #equipped == 0 then
		return false, "equip a pet first (Menu > Pets), then /petlevel " .. arg
	end
	local set, seen = 0, {}
	for _, key in ipairs(equipped) do
		if type(key) == "string" and not seen[key] then
			seen[key] = true
			local ok, done = pcall(DataService.SetPetLevel, player, key, arg)
			if ok and done == true then
				set = set + 1
			end
		end
	end
	if set == 0 then
		return false, "no equipped pet could be set to level " .. arg
	end
	if hasFunction(PetService, "Refresh") then
		pcall(PetService.Refresh, player) -- the pet cards (EquippedInfo) show the new level
	end
	return true, set .. (set == 1 and " equipped pet is" or " equipped pets are") .. " level " .. arg .. " now", true
end

-- Boss raids: /raid = the next boss, /raid <boss word> = that boss, /raid end = end the fights (events owner). Nothing in the profile changes.
local function cmdRaid(_, _, arg)
	if not hasFunction(EventService, "StartNow") then
		return false, "boss raids are not in this build", false
	end
	local word = string.match(string.lower(type(arg) == "string" and arg or ""), "%S+")
	local fn, boss = EventService.StartNow, nil
	if word == "end" then
		fn = EventService.EndNow
	elseif word then
		boss = hasFunction(SkyService, "Find") and SkyService.Find(word) or nil
		if not boss then
			return false, "no boss starts with \"" .. word .. "\"", false
		end
	end
	local ok, started, message = pcall(fn, "BossRaid", boss)
	if not ok then
		warn("[DevService] /raid failed: " .. tostring(started))
		return false, "the boss could not change", false
	end
	return started == true, tostring(message or (started and "done" or "the boss could not change")), false
end

-- The living sky (SkyService): the clock and the raid sky are Workspace attributes, so this changes the sky of everyone
-- in the server. Nothing in the profile changes. "speed" takes one finite number (clamped by SkyService), "raid" one boss.
local SKY_USAGE = "try /sky dawn|day|sunset|night|speed <x>|raid <boss>|clear"

local function minutes(seconds)
	local s = math.max(0, math.floor(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function cmdSky(_, _, arg)
	if not hasFunction(SkyService, "Status") then
		return false, "the living sky is not in this build", false
	end
	local words = {}
	for word in string.gmatch(string.lower(arg or ""), "%S+") do
		words[#words + 1] = word
	end
	local verb = words[1]
	if verb == nil then
		local s = SkyService.Status()
		local event = (s.Event ~= nil and s.Event ~= "") and (", raid sky " .. s.Event) or ""
		return true, "sky: " .. s.Phase .. " " .. minutes(s.Seconds) .. " of " .. minutes(s.Length) .. ", speed x" .. tostring(s.Speed) .. event, false
	end
	if verb == "speed" then
		local n = #words == 2 and tonumber(words[2]) or nil
		if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then
			return false, "sky speed needs a number, like /sky speed 20", false
		end
		local ok, speed = SkyService.SetSpeed(n)
		if not ok then
			return false, "sky " .. tostring(speed), false
		end
		return true, "sky speed x" .. tostring(speed) .. (speed ~= n and " (clamped)" or ""), false
	end
	if verb == "raid" then
		local boss = #words == 2 and hasFunction(SkyService, "Find") and SkyService.Find(words[2]) or nil
		if not boss then
			local ids = {}
			for id in pairs((type(Config.Sky) == "table" and Config.Sky.RaidThemes) or {}) do
				ids[#ids + 1] = id
			end
			table.sort(ids)
			return false, "sky raid needs a boss: " .. table.concat(ids, ", "), false
		end
		SkyService.SetEvent(boss, "dev")
		return true, "raid sky " .. boss .. " (a preview; /sky clear ends it)", false
	end
	if verb == "clear" and #words == 1 then
		SkyService.ClearEvent()
		return true, "raid sky cleared, back to the cycle", false
	end
	if #words == 1 then
		local ok, phase = SkyService.SetPhase(verb)
		if ok then
			return true, "sky: " .. tostring(phase) .. " starts now", false
		end
	end
	return false, "sky: unknown '" .. printable(verb) .. "' (" .. SKY_USAGE .. ")", false
end

----------------------------------------------------------------------
-- The pet showcase (pet / pets / evolve / clearpets): validated here, built on the developer's own client
----------------------------------------------------------------------

-- 2 for Epic pets and up (PetBuilder.MaxEvolution; the same rule when PetBuilder cannot load)
local function maxEvolution(def)
	if PetBuilder == nil then
		PetBuilder = loadModule(Shared, "PetBuilder") or false
	end
	if PetBuilder and hasFunction(PetBuilder, "MaxEvolution") then
		local ok, top = pcall(PetBuilder.MaxEvolution, def)
		if ok and (top == 1 or top == 2) then
			return top
		end
	end
	local r = def.Rarity
	return (r == "Epic" or r == "Legendary" or r == "Mythic" or r == "Secret") and 2 or 1
end

local function squash(text)
	return (string.gsub(string.lower(tostring(text)), "[^%a%d]", ""))
end

-- "cloudy dragon 2" -> "cloudy dragon", 2 (nil when the last word is not a stage)
local function splitStage(text)
	text = tostring(text or "")
	local head, last = string.match(text, "^%s*(.-)%s*(%S+)%s*$")
	if last then
		local stage = STAGE_WORDS[string.lower(last)]
		if stage ~= nil then
			return head, stage
		end
	end
	return (string.match(text, "^%s*(.-)%s*$")), nil
end

-- A catalog pet by id or name: exact first, then the one pet whose id or name contains the text.
local function findPet(text)
	local key = squash(text)
	if key == "" then
		return nil, "which pet? like /pet cloudy dragon 2"
	end
	local partial = {}
	for _, def in ipairs(PetCatalog.Pets) do
		if type(def) == "table" and type(def.Id) == "string" then
			local id, name = squash(def.Id), squash(def.Name or def.Id)
			if id == key or name == key then
				return def
			end
			if string.find(id, key, 1, true) or string.find(name, key, 1, true) then
				partial[#partial + 1] = def
			end
		end
	end
	if #partial == 1 then
		return partial[1]
	end
	local shown = string.sub(tostring(text), 1, 24)
	if #partial == 0 then
		return nil, "no pet called '" .. shown .. "'"
	end
	local names = {}
	for i = 1, math.min(4, #partial) do
		names[i] = tostring(partial[i].Name or partial[i].Id)
	end
	return nil, "'" .. shown .. "' could be " .. table.concat(names, ", ") .. ((#partial > 4) and ", ..." or "")
end

local function nameOf(def)
	return tostring(def.Name or def.Id)
end

-- Sends the showcase action to the developer's own client.
local function showPets(player, action, payload)
	local okRemote, remote = pcall(Remotes.Get, "DevPetShow")
	if not (okRemote and remote) then
		return false
	end
	local sent = pcall(function()
		remote:FireClient(player, action, payload)
	end)
	return sent
end

local function needCatalog()
	return PetCatalog ~= nil and type(PetCatalog.Pets) == "table"
end

local function cmdPet(player, _, arg)
	if not needCatalog() then
		return false, "the pet catalog is missing"
	end
	local text, stage = splitStage(arg)
	local def, err = findPet(text)
	if not def then
		return false, err
	end
	stage = stage or 0
	if stage > maxEvolution(def) then
		return false, nameOf(def) .. " has no second evolution (Epic pets and up)"
	end
	if not showPets(player, "Spawn", { PetId = def.Id, Stage = stage }) then
		return false, "the DevPetShow remote is missing"
	end
	return true, nameOf(def) .. " (" .. STAGE_NAMES[stage] .. ") in front of you; /clearpets removes it", false
end

local function cmdPets(player, _, arg)
	if not needCatalog() then
		return false, "the pet catalog is missing"
	end
	local text, stage = splitStage(arg)
	if text ~= "" then
		return false, "/pets takes only a stage: /pets, /pets 1 or /pets 2"
	end
	stage = stage or 0
	local ids = {}
	for _, def in ipairs(PetCatalog.Pets) do
		if type(def) == "table" and type(def.Id) == "string" and maxEvolution(def) >= stage then
			ids[#ids + 1] = def.Id
		end
	end
	if not showPets(player, "Lineup", { Stage = stage, PetIds = ids }) then
		return false, "the DevPetShow remote is missing"
	end
	return true, #ids .. " pets (" .. STAGE_NAMES[stage] .. ") lined up in front of you; /clearpets removes them", false
end

-- The evolutions of one pet: no stage = its whole line, 1 = normal -> evolved, 2 = evolved -> evolved II.
local function stepsOf(def, stage, steps)
	local top = maxEvolution(def)
	local from, to = 0, top
	if stage == 1 then
		from, to = 0, 1
	elseif stage == 2 then
		from, to = 1, 2
	end
	for s = from + 1, math.min(to, top) do
		steps[#steps + 1] = { PetId = def.Id, From = s - 1, To = s }
	end
end

local function cmdEvolve(player, _, arg)
	if not needCatalog() then
		return false, "the pet catalog is missing"
	end
	local text, stage = splitStage(arg)
	if stage == 0 then
		return false, "evolve to 1 (Evolved) or 2 (Evolved II), like /evolve cloudy dragon 2"
	end
	local steps = {}
	local label
	if squash(text) == "all" then
		for _, def in ipairs(PetCatalog.Pets) do
			if type(def) == "table" and type(def.Id) == "string" then
				stepsOf(def, stage, steps)
			end
		end
		label = #steps .. " evolutions one after another"
	else
		if squash(text) == "" then
			return false, "which pet? like /evolve cloudy dragon, or /evolve all"
		end
		local def, err = findPet(text)
		if not def then
			return false, err
		end
		if stage == 2 and maxEvolution(def) < 2 then
			return false, nameOf(def) .. " has no second evolution (Epic pets and up)"
		end
		stepsOf(def, stage, steps)
		label = nameOf(def) .. " evolving"
		if #steps > 1 then
			label = label .. " twice (Evolved, then Evolved II)"
		else
			label = label .. " to " .. STAGE_NAMES[steps[1].To]
		end
	end
	if not showPets(player, "Evolve", { Steps = steps }) then
		return false, "the DevPetShow remote is missing"
	end
	return true, label .. "; /clearpets stops it", false
end

-- AttackFxCatalog name list -> { [lower name] = name }
local function namesOf(list)
	local out = {}
	for _, name in ipairs(type(list) == "table" and list or {}) do
		out[string.lower(name)] = name
	end
	return out
end

-- /fx <element> <attack> [kind|shape] [rarity] [stage] -> Fx { Element, Attack, Kind, Shape, Rarity, Stage }
local function cmdFx(player, _, arg)
	if AttackFxCatalog == nil then
		AttackFxCatalog = loadModule(Shared, "AttackFxCatalog") or false
	end
	local Cat = AttackFxCatalog
	if not (Cat and type(Cat.Elements) == "table" and type(Cat.AttackNames) == "table") then
		return false, "the attack effects catalog is missing"
	end
	local words = {}
	for w in string.gmatch(tostring(arg or ""), "%S+") do
		words[#words + 1] = w
	end
	if #words == 0 then
		return false, "which element? like /fx flame ranged epic"
	end
	local elements, order = {}, {}
	for name in pairs(Cat.Elements) do
		elements[string.lower(name)] = name
		order[#order + 1] = string.lower(name)
	end
	table.sort(order)
	local element = elements[string.lower(words[1])]
	if not element then
		return false, "no element '" .. string.sub(words[1], 1, 12) .. "' (" .. table.concat(order, " ") .. ")"
	end
	if not words[2] then
		return false, "which attack? like /fx " .. string.lower(element) .. " melee"
	end
	local attack = namesOf(Cat.AttackNames)[string.lower(words[2])]
	if not attack then
		return false, "no attack '" .. string.sub(words[2], 1, 12) .. "' (" .. string.lower(table.concat(Cat.AttackNames, " ")) .. ")"
	end
	local kinds, shapes, rarities = namesOf(Cat.KindNames), namesOf(Cat.ShapeNames), namesOf(Cat.Rarities)
	local payload = { Element = element, Attack = attack, Rarity = "Common", Stage = 0 }
	local given = {}
	for i = 3, #words do
		local w = string.lower(words[i])
		-- (each of kind / shape / rarity / stage at most once: "/fx flame ranged epic rare" is refused, never guessed)
		local field, value = nil, nil
		if kinds[w] then
			if attack ~= "Special" then
				return false, kinds[w] .. " is a special's kind: /fx " .. string.lower(element) .. " special " .. w
			end
			field, value = "Kind", kinds[w]
		elseif shapes[w] then
			if attack ~= "Element" then
				return false, shapes[w] .. " is an element attack's shape: /fx " .. string.lower(element) .. " element " .. w
			end
			field, value = "Shape", shapes[w]
		elseif rarities[w] then
			field, value = "Rarity", rarities[w]
		elseif STAGE_WORDS[w] ~= nil then
			field, value = "Stage", STAGE_WORDS[w]
		end
		if field then
			if given[field] then
				local plural = ({ Kind = "kinds", Shape = "shapes", Rarity = "rarities", Stage = "stages" })[field]
				return false, "two " .. plural .. ": " .. tostring(given[field]) .. " and " .. string.sub(words[i], 1, 12)
			end
			given[field] = words[i]
			payload[field] = value
		else
			return false, "'" .. string.sub(words[i], 1, 12) .. "' is no kind, shape, rarity or stage"
		end
	end
	if not showPets(player, "Fx", payload) then
		return false, "the DevPetShow remote is missing"
	end
	local label = element .. " " .. attack .. ((payload.Kind or payload.Shape) and (" " .. (payload.Kind or payload.Shape)) or "")
	return true, label .. " " .. payload.Rarity .. " stage " .. payload.Stage .. " in front of you; /clearpets ends it", false
end

local function cmdClearPets(player)
	if not showPets(player, "Clear", {}) then
		return false, "the DevPetShow remote is missing"
	end
	return true, "showcase pets removed", false
end

-- "name the rest of the line" -> the first word, the rest (nil when there is none)
local function splitTarget(text)
	local word, rest = string.match(tostring(text or ""), "^%s*(%S+)%s*(.-)%s*$")
	if rest == "" then
		rest = nil
	end
	return word, rest
end

-- A word that could mean several players, as a toast's text.
local function ambiguous(word, list)
	local names = {}
	for i = 1, math.min(4, #list) do
		names[i] = list[i].Name
	end
	return "'" .. string.sub(word, 1, 24) .. "' could be " .. table.concat(names, ", ") .. ((#list > 4) and ", ..." or "")
end

-- The one player in this server a word means: their userId (the panel sends it, so a player who just left is never
-- swapped for a similar name), an exact Name, the only exact DisplayName, else (unless exactOnly; never for digits) the
-- one whose Name or DisplayName contains it. -> player | nil, problem (a toast's text)
local function findOnline(word, exactOnly)
	local digits = string.match(word, "^%d+$") ~= nil
	if digits then
		local id = tonumber(word)
		if isWhole(id) and id >= 1 and id <= MAX_USER_ID then
			local byId = Players:GetPlayerByUserId(id)
			if byId then
				return byId
			end
		end
	end
	local key = string.lower(word)
	local exact, partial = {}, {}
	for _, p in ipairs(Players:GetPlayers()) do
		local name, display = string.lower(p.Name), string.lower(tostring(p.DisplayName or ""))
		if name == key then
			return p
		end
		if display == key then
			exact[#exact + 1] = p
		elseif string.find(name, key, 1, true) or string.find(display, key, 1, true) then
			partial[#partial + 1] = p
		end
	end
	if #exact > 1 then
		return nil, ambiguous(word, exact)
	end
	if #exact == 1 then
		return exact[1]
	end
	if #partial == 0 or exactOnly or digits then
		return nil, "nobody here is called '" .. string.sub(word, 1, 24) .. "'"
	end
	if #partial == 1 then
		return partial[1]
	end
	return nil, ambiguous(word, partial)
end

-- A developer's typed reason, as this player may read it. nil when the filter fails: the raw text is never shown.
local function filteredReason(reason, fromUserId, toUserId)
	local ok, text = pcall(function()
		return TextService:FilterStringAsync(reason, fromUserId):GetNonChatStringForUserAsync(toUserId)
	end)
	if ok and type(text) == "string" and text ~= "" then
		return text
	end
	warn("[DevService] the kick reason could not be filtered: " .. tostring(text))
	return nil
end

-- This one yields (the text filter).
local function cmdKick(player, _, arg)
	local word, reason = splitTarget(arg)
	if not word then
		return false, "kick who? like /kick name reason"
	end
	local target, problem = findOnline(word)
	if not target then
		return false, problem
	end
	if target == player then
		return false, "you cannot kick yourself"
	end
	local name = target.Name
	local message = KICK_TEXT
	if reason then
		local clean = filteredReason(reason, player.UserId, target.UserId)
		if clean then
			message = message .. " " .. clean
		end
	end
	if not isLivePlayer(target) then
		return false, name .. " already left"
	end
	target:Kick(message)
	return true, "kicked " .. name, false
end

-- An API failure as a toast's text: the engine's own words.
local function apiError(what, err)
	warn("[DevService] " .. what .. " failed: " .. tostring(err))
	local text = string.gsub(tostring(err), "^.-:%d+: ", "") -- without the "script:line: " in front
	return what .. " failed: " .. string.sub(text, 1, MAX_ERROR_TEXT)
end

local function banningOff()
	local ok, on = pcall(function()
		return Players.BanningEnabled
	end)
	return ok and on == false
end

-- A userId or an exact account name -> userId, label | nil, problem. The name lookup yields.
local function accountOf(word)
	if string.match(word, "^%d+$") then
		local id = tonumber(word)
		if not isWhole(id) or id < 1 or id > MAX_USER_ID then
			return nil, "'" .. string.sub(word, 1, 24) .. "' is no userId"
		end
		return id, "userId " .. word
	end
	if not string.match(word, "^[%w_]+$") or #word > 20 then
		return nil, "'" .. string.sub(word, 1, 24) .. "' is no player name or userId"
	end
	local ok, id = pcall(function()
		return Players:GetUserIdFromNameAsync(word)
	end)
	if not ok or not isWhole(id) or id < 1 then
		return nil, "no player called '" .. word .. "'"
	end
	return id, word
end

-- Is this account a developer, in the server or not? -> yes | nil when it cannot be told. Studio's "everyone is allowed"
-- counts for those in the server (IsAllowed); the rest is the owner and Config.Dev.Admins.
local function isDeveloperId(userId, online)
	if online and DevService.IsAllowed(online) then
		return true
	end
	if isAdminId(userId, devConfig().Admins) then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User then
		return userId == game.CreatorId
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, info = pcall(function()
			return game:GetService("GroupService"):GetGroupInfoAsync(game.CreatorId)
		end)
		local owner = ok and type(info) == "table" and type(info.Owner) == "table" and info.Owner.Id or nil
		if type(owner) ~= "number" then
			return nil
		end
		return userId == owner
	end
	return false
end

-- These yield (the name lookup, the ban API).
local function cmdBan(player, _, arg)
	local word, reason = splitTarget(arg)
	if not word then
		return false, "ban who? like /ban name reason"
	end
	if banningOff() then
		return false, "bans are off here: turn on Players.BanningEnabled in Studio, then publish"
	end
	-- someone here by their exact name, otherwise any account by exact name or userId: a ban is forever, a part of a
	-- name only earns a hint
	local online = nil
	if not string.match(word, "^%d+$") then
		local found, problem = findOnline(word, true)
		if found then
			online = found
		elseif problem and not string.find(problem, "nobody here", 1, true) then
			return false, problem
		end
	end
	local userId, label = nil, nil
	if online then
		userId, label = online.UserId, online.Name
	else
		userId, label = accountOf(word)
		if not userId then
			local near = findOnline(word)
			return false, near and (label .. ": did you mean " .. near.Name .. "?") or label
		end
		online = Players:GetPlayerByUserId(userId)
	end
	if userId == player.UserId then
		return false, "you cannot ban yourself"
	end
	local developer = isDeveloperId(userId, online)
	if developer == nil then
		return false, "could not check whether " .. label .. " is a developer, nothing was done"
	end
	if developer then
		return false, label .. " is a developer and cannot be banned"
	end
	local ok, err = pcall(function()
		Players:BanAsync({
			UserIds = { userId },
			ApplyToUniverse = true,
			Duration = -1,
			DisplayReason = reason or BAN_TEXT,
			PrivateReason = "Banned with the dev tools by " .. who(player),
		})
	end)
	if not ok then
		return false, apiError("ban", err)
	end
	if RunService:IsStudio() then
		return false, "Studio only checks a ban: Roblox runs bans on live servers, nobody was banned"
	end
	return true, "banned " .. label .. " for good", false
end

local function cmdUnban(player, _, arg)
	local word = splitTarget(arg)
	if not word then
		return false, "unban who? like /unban name"
	end
	if banningOff() then
		return false, "bans are off here: turn on Players.BanningEnabled in Studio, then publish"
	end
	local userId, label = accountOf(word)
	if not userId then
		return false, label
	end
	local ok, err = pcall(function()
		Players:UnbanAsync({ UserIds = { userId }, ApplyToUniverse = true })
	end)
	if not ok then
		return false, apiError("unban", err)
	end
	if RunService:IsStudio() then
		return false, "Studio only checks an unban: Roblox runs them on live servers, nothing changed"
	end
	return true, "unbanned " .. label, false
end

-- Every key the player owns with its def, for the commands that change all pets. -> { { Key, Def } } | nil, problem
local function ownedPets(player, profile)
	if player:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil then
		return nil, "finish your battle first"
	end
	local keys = loadModule(Shared, "PetKeys")
	if not (keys and hasFunction(keys, "List") and hasFunction(keys, "DefOf")) then
		return nil, "the pet keys are missing"
	end
	local out = {}
	for _, key in ipairs(keys.List(profile)) do
		local def = keys.DefOf(key, profile)
		if type(def) == "table" then
			out[#out + 1] = { Key = key, Def = def }
		end
	end
	if #out == 0 then
		return nil, "you own no pets yet"
	end
	return out
end

local function refreshPets(player)
	if hasFunction(PetService, "Refresh") then
		pcall(PetService.Refresh, player) -- the pet cards and the followers (EquippedInfo) show the new level and stage
	end
end

local function petCare()
	local care = loadModule(script.Parent, "PetCareService")
	return hasFunction(care, "DevEvolve") and care or nil
end

local function cmdEvolvePets(player, profile)
	local care = petCare()
	if not care then
		return false, "pet care is not in this build"
	end
	local pets, problem = ownedPets(player, profile)
	if not pets then
		return false, problem
	end
	local done = 0
	for _, pet in ipairs(pets) do
		local stage = DataService.GetEvolution(player, pet.Key)
		if stage < maxEvolution(pet.Def) and care.DevEvolve(player, pet.Key, stage + 1) then
			done = done + 1
		end
	end
	if done == 0 then
		return true, "all your pets are already fully evolved", false
	end
	refreshPets(player)
	return true, done .. (done == 1 and " pet" or " pets") .. " evolved one stage, free", true
end

local function cmdLevelAll(player, profile, arg)
	local top = maxPetLevel()
	if not isWhole(arg) then
		return false, "levelall needs a whole number from 1 to " .. top .. ", like /levelall 50"
	end
	if arg < 1 or arg > top then
		return false, "levelall takes a level from 1 to " .. top
	end
	local pets, problem = ownedPets(player, profile)
	if not pets then
		return false, problem
	end
	local set = 0
	for _, pet in ipairs(pets) do
		local ok, done = pcall(DataService.SetPetLevel, player, pet.Key, arg)
		if ok and done == true then
			set = set + 1
		end
	end
	if set == 0 then
		return false, "no pet could be set to level " .. arg
	end
	refreshPets(player)
	return true, set .. (set == 1 and " pet is" or " pets are") .. " level " .. arg .. " now", true
end

local function cmdMaxPets(player, profile)
	local care = petCare()
	if not care then
		return false, "pet care is not in this build"
	end
	local pets, problem = ownedPets(player, profile)
	if not pets then
		return false, problem
	end
	local tycoon = loadModule(Shared, "TycoonCatalog")
	local training = tycoon and type(tycoon.Training) == "table" and tycoon.Training or nil
	local rank = (training and isWhole(training.MaxRank) and training.MaxRank) or DEFAULT_MAX_RANK
	local top = maxPetLevel()
	local changed = 0
	local keys = {}
	for _, pet in ipairs(pets) do
		local key = pet.Key
		keys[#keys + 1] = key
		local growth = DataService.GetGrowth(player, key)
		local different = DataService.GetPetLevel(player, key) ~= top or growth.Evo ~= maxEvolution(pet.Def)
		for _, skill in ipairs(TRAINING_SKILLS) do
			different = different or growth[skill] ~= rank
		end
		if different then
			changed = changed + 1
		end
		if growth.Job then
			care.DevFinishJob(player, key) -- the real completion: its rank, the pet comes back; maxing it now would leave it behind
		end
		if growth.Evo < maxEvolution(pet.Def) then
			care.DevEvolve(player, key, maxEvolution(pet.Def))
		end
		DataService.SetPetLevel(player, key, top)
	end
	if changed == 0 then
		return true, "all your pets are already at their maximum", false
	end
	local wrote = DataService.MutateGrowth(player, function(growth)
		for _, key in ipairs(keys) do
			local e = growth[key]
			if type(e) ~= "table" then
				e = {}
				growth[key] = e
			end
			for _, skill in ipairs(TRAINING_SKILLS) do
				e[skill] = rank
			end
		end
	end)
	if not wrote then
		return false, "the training ranks could not be written"
	end
	refreshPets(player)
	return true, changed .. (changed == 1 and " pet" or " pets") .. " maxed: level " .. top .. ", top evolution, every training rank " .. rank, true
end

-- The hint lives on the developer's PlayerGui like NC_Dev: it survives a respawn, is not saved and tells nobody else.
local function cmdSpeed(player)
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return false, "your screen is still loading, try again"
	end
	if pg:GetAttribute(ATTR_SPEED) == true then
		pg:SetAttribute(ATTR_SPEED, nil)
		return true, "2x speed off", false
	end
	pg:SetAttribute(ATTR_SPEED, true)
	return true, "2x speed on", false
end

-- Three toasts (each fits a side toast, <= 90 characters with the "DEV: " prefix): the pet showcase commands first
-- (/fx among them since the pet attack VFX, /sky since the living sky: it took the room of /berries' "[n]"), then the
-- others (/petlevel among them since Phase 4; the numeric commands take a number, which their refusal toasts spell
-- out: "like /tokens 50000"); the second one is the tools that act on other players and on all your pets.
local function cmdHelp(player)
	notify(player, "DEV: /pet <name> [0-2] /pets [0-2] /evolve <name|all> [1-2] /fx /clearpets /berries /sky", "info", HELP_SECONDS)
	notify(player, "DEV: /kick /ban /unban /evolvepets /levelall <n> /maxpets /speed", "info", HELP_SECONDS)
	if tutorialReloader() then
		return true, "/allpets /tokens /cash /gems /petlevel /reset /tutorial /skiptutorial /raid /devhelp", false
	end
	return true, "/allpets /tokens /cash /gems /petlevel /reset /skiptutorial /raid /devhelp", false
end

local HANDLERS = {
	allpets = cmdAllPets,
	tokens = cmdTokens,
	cash = cmdCash,
	gems = cmdGems,
	berries = cmdBerries,
	petlevel = cmdPetLevel,
	reset = cmdReset,
	tutorial = cmdTutorial,
	skiptutorial = cmdSkipTutorial,
	raid = cmdRaid,
	sky = cmdSky,
	pet = cmdPet,
	pets = cmdPets,
	evolve = cmdEvolve,
	fx = cmdFx,
	clearpets = cmdClearPets,
	kick = cmdKick,
	ban = cmdBan,
	unban = cmdUnban,
	evolvepets = cmdEvolvePets,
	levelall = cmdLevelAll,
	maxpets = cmdMaxPets,
	speed = cmdSpeed,
	devhelp = cmdHelp,
}

-- Validates and runs one command for an allowed player. Returns ok, message.
local function execute(player, command, arg, source)
	if type(command) ~= "string" or #command == 0 or #command > MAX_COMMAND_LENGTH then
		log(player, source, command, arg, "refused: bad command")
		notify(player, "DEV: that is not a command", "bad")
		return false, "bad command"
	end
	local name = string.lower(command)
	local handler = HANDLERS[name]
	if not handler then
		log(player, source, command, arg, "refused: unknown command")
		notify(player, "DEV: unknown command '" .. printable(command) .. "' (try /devhelp)", "bad")
		return false, "unknown command"
	end
	-- tokens / cash / gems take a whole number, the showcase commands a short text, the rest no value
	local kind = ARG_KIND[name]
	local maxLength = (name == "kick" or name == "ban") and MAX_REASON_ARG_LENGTH or MAX_ARG_LENGTH
	if arg ~= nil and (type(arg) ~= kind or (kind == "string" and #arg > maxLength)) then
		log(player, source, name, arg, "refused: bad value")
		if NUMERIC[name] then
			notify(player, "DEV: " .. name .. " needs a whole number, like /" .. name .. " " .. (ARG_EXAMPLE[name] or "50000"), "bad")
		elseif kind == "string" then
			notify(player, "DEV: " .. name .. " needs a short text, like " .. (TEXT_EXAMPLE[name] or "/pet cloudy dragon 2"), "bad")
		else
			notify(player, "DEV: " .. name .. " takes no value", "bad")
		end
		return false, "bad value"
	end
	local profile = getProfile(player)
	if not profile and not NO_PROFILE[name] then
		log(player, source, name, arg, "refused: profile not loaded")
		notify(player, "DEV: your data is still loading, try again", "bad")
		return false, "profile not loaded"
	end
	-- a provisional profile holds stand-in defaults (failed load during an outage): only additive commands make sense
	if not PROVISIONAL_OK[name] and isProvisional(player) then
		log(player, source, name, arg, "refused: profile provisional")
		notify(player, "DEV: your data is still loading, try again", "bad")
		return false, "profile provisional"
	end
	local pok, ok, message, changed = pcall(handler, player, profile, arg)
	if not pok then
		warn("[DevService] " .. name .. " failed: " .. tostring(ok))
		log(player, source, name, arg, "error")
		notify(player, "DEV: " .. name .. " went wrong, see the output", "bad")
		return false, "error"
	end
	message = tostring(message or "")
	if not ok then
		log(player, source, name, arg, "refused: " .. message)
		notify(player, "DEV: " .. message, "bad")
		return false, message
	end
	if changed then
		markDirtyAndSync(player)
	end
	log(player, source, name, arg, "ok: " .. message)
	if name == "devhelp" then
		notify(player, "DEV: " .. message, "info", HELP_SECONDS)
	else
		notify(player, "DEV: " .. message, (changed or GOOD_TOAST[name]) and "good" or "info")
	end
	return true, message
end

-- The one entry point of the DevCommand remote and of chat.
function DevService.Run(player, command, arg, source)
	if not isLivePlayer(player) then
		return false, "player unavailable"
	end
	source = tostring(source or "remote")
	if not takeSlot(player) then
		-- a developer gets one "slow down" toast per window; nobody else hears anything
		local now = os.clock()
		if devs[player] and (rateWarned[player] == nil or now - rateWarned[player] >= RATE_WINDOW) then
			rateWarned[player] = now
			log(player, source, command, arg, "refused: rate limit")
			notify(player, "DEV: slow down (" .. RATE_COUNT .. " commands every " .. RATE_WINDOW .. " seconds)", "bad", 3)
		end
		return false, "rate limited"
	end
	if not ready then
		return false, "developer tools are off" -- switched off or no DataService: dropped without a word
	end
	local allowed = DevService.IsAllowed(player) -- may yield once for a group game; nothing is held meanwhile
	if not isLivePlayer(player) then
		return false, "player unavailable"
	end
	if not allowed then
		log(player, source, command, arg, "refused: not a developer")
		return false, "not allowed"
	end
	return execute(player, command, arg, source)
end

----------------------------------------------------------------------
-- Chat
----------------------------------------------------------------------

-- "50000", "50,000", "50k", "1.5m" -> number (nil when it is not a number)
local function parseAmount(text)
	local s = string.gsub(string.lower(text), "[,_%s]", "")
	local digits, suffix = string.match(s, "^(%-?[%d%.]+)([kmb]?)$")
	local n = tonumber(digits)
	if not n then
		return nil
	end
	if suffix == "k" then
		n = n * 1000
	elseif suffix == "m" then
		n = n * 1000000
	elseif suffix == "b" then
		n = n * 1000000000
	end
	return n
end

local function onChatted(player, message)
	if type(message) ~= "string" or #message > MAX_CHAT_LENGTH then
		return
	end
	local word, rest = string.match(message, "^%s*/(%S+)%s*(.-)%s*$")
	if not word then
		return
	end
	word = string.lower(word)
	if not KNOWN[word] then
		return -- not one of ours (/e dance, /w name ...): leave it alone
	end
	-- the same line through both ways in (Player.Chatted and a TextChatCommand) runs once
	local now = os.clock()
	local last = lastChat[player]
	if last and last.Text == message and now - last.At < DUPLICATE_WINDOW then
		return
	end
	lastChat[player] = { Text = message, At = now }
	local arg = nil
	if NUMERIC[word] and rest ~= "" then
		arg = parseAmount(rest)
		if arg == nil then
			arg = rest -- not a number: Run refuses it with a "bad" toast
		end
	elseif ARG_KIND[word] == "string" and rest ~= "" then
		arg = rest -- the showcase commands read the rest of the line (pet name and stage)
	end
	local ok, err = pcall(DevService.Run, player, word, arg, "chat")
	if not ok then
		warn("[DevService] chat command failed: " .. tostring(err))
	end
end

local function connectChat(player)
	if chatConns[player] then
		return
	end
	chatConns[player] = player.Chatted:Connect(function(message)
		onChatted(player, message)
	end)
end

-- The new chat (TextChatService) only hands a "/" message to the game when a TextChatCommand claims it: one per
-- command. Skipped for the legacy chat and wherever TextChatCommand cannot be made.
local function makeChatCommands()
	if chatCommandsMade then
		return
	end
	chatCommandsMade = true
	local okService, tcs = pcall(function()
		return game:GetService("TextChatService")
	end)
	if not okService or not tcs then
		return
	end
	local okVersion, version = pcall(function()
		return tcs.ChatVersion
	end)
	if okVersion and version ~= nil and version ~= Enum.ChatVersion.TextChatService then
		return -- the legacy chat: Player.Chatted sees every message
	end
	for _, name in ipairs(DevService.Commands) do
		local ok = pcall(function()
			local command = Instance.new("TextChatCommand")
			command.Name = "NimbusDev_" .. name
			command.PrimaryAlias = "/" .. name
			command.Triggered:Connect(function(source, text)
				local okPlayer, player = pcall(function()
					return Players:GetPlayerByUserId(source.UserId)
				end)
				if okPlayer and player then
					onChatted(player, text)
				end
			end)
			command.Parent = tcs
		end)
		if not ok then
			return -- no TextChatCommand here (an old engine, a test world): Player.Chatted still works
		end
	end
	print(TAG .. "chat commands registered with TextChatService")
end

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------

-- Studio auto grant: every pet + GrantTokens tokens once per server, after the profile loaded.
local function autoGrant(player)
	local dev = devConfig()
	if dev.StudioAutoGrant ~= true or not RunService:IsStudio() or not isLivePlayer(player) then
		return
	end
	-- a provisional profile (failed load during an outage) waits: ProfileRebased brings it back here once it recovered
	if autoGranted[player.UserId] or not getProfile(player) or isProvisional(player) then
		return
	end
	local allowed = DevService.IsAllowed(player)
	-- checked again after IsAllowed: the join handler, ProfileLoaded and ProfileRebased can all get here
	if not allowed or autoGranted[player.UserId] or not isLivePlayer(player) or not getProfile(player) or isProvisional(player) then
		return
	end
	autoGranted[player.UserId] = true
	execute(player, "allpets", nil, "studio auto grant")
	execute(player, "tokens", nil, "studio auto grant")
end

-- The hints for the developer's own client go on their PlayerGui, which replicates to that player only.
local function publishHints(player)
	-- (ATTR_SPEED is /speed's own: off until asked for)
	local playerGui = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", PLAYER_GUI_WAIT)
	if not isLivePlayer(player) then
		return
	end
	if not playerGui then
		warn("[DevService] no PlayerGui for " .. who(player) .. ": the DEV button stays hidden (chat commands work)")
		return
	end
	playerGui:SetAttribute(ATTR, true)
	if tutorialReloader() then
		playerGui:SetAttribute(ATTR_TUTORIAL, true)
	else
		playerGui:SetAttribute(ATTR_TUTORIAL, nil)
	end
end

local function onPlayerAdded(player)
	task.spawn(function()
		local allowed = DevService.IsAllowed(player)
		if not allowed or not isLivePlayer(player) then
			return
		end
		devs[player] = true
		connectChat(player)
		print(TAG .. "developer tools on for " .. who(player) .. " (DEV button, /devhelp)")
		autoGrant(player)
		publishHints(player)
	end)
end

local function onPlayerRemoving(player)
	local conn = chatConns[player]
	if conn then
		pcall(function()
			conn:Disconnect()
		end)
	end
	chatConns[player] = nil
	lastChat[player] = nil
	rankCache[player] = nil
	devs[player] = nil
	recent[player] = nil
	rateWarned[player] = nil
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

-- The DevCommand listener. Connected even when the tools are off: Roblox queues the events of a RemoteEvent
-- without a listener, so an exploiter could otherwise fill that queue in a switched-off build.
local function connectRemote()
	local okRemote, remote = pcall(Remotes.Get, "DevCommand")
	if not (okRemote and remote) then
		warn("[DevService] DevCommand remote is missing: " .. tostring(remote))
		return
	end
	remote.OnServerEvent:Connect(function(player, command, arg)
		local ok, err = pcall(DevService.Run, player, command, arg, "button")
		if not ok then
			warn("[DevService] DevCommand failed: " .. tostring(err))
		end
	end)
end

function DevService.Init(deps)
	if initialized then
		return
	end
	initialized = true
	deps = type(deps) == "table" and deps or {}
	local services = script.Parent
	DataService = deps.DataService or loadModule(services, "DataService")
	TutorialService = deps.TutorialService
	IndexService = deps.IndexService
	EventService = deps.EventService or loadModule(services, "EventService")
	BattleService = deps.BattleService or loadModule(services, "BattleService")
	PetService = deps.PetService
	SkyService = deps.SkyService or loadModule(services, "SkyService")
	if not PetCatalog then
		PetCatalog = loadModule(Shared, "PetCatalog")
	end
	connectRemote()
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	if devConfig().Enabled ~= true then
		print(TAG .. "developer tools are switched off (Config.Dev.Enabled)")
		return
	end
	if not DataService then
		warn("[DevService] DataService is missing: developer tools are off")
		return
	end
	ready = true
	makeChatCommands()

	if hasSignal(DataService, "ProfileLoaded") then
		DataService.ProfileLoaded:Connect(function(player)
			autoGrant(player)
		end)
	end
	if hasSignal(DataService, "ProfileRebased") then
		DataService.ProfileRebased:Connect(function(player)
			autoGrant(player) -- a profile that loaded provisionally gets its Studio grant once it recovered
		end)
	end
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
end

return DevService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1091">
          <Properties>
            <string name="Name">DungeonBuilder</string>
            <string name="Source"><![CDATA[--!nocheck
-- DungeonBuilder (ARCHITECTURE_V3.md "Phase 5 build contract" 5.5, art per image 22, the rules of 6.4; dungeon W3)
--
-- The Dungeon gate in the Gate Court and the run instances (pockets) of DungeonService.
--
--   DungeonBuilder.Build(lobbyInfo) -> DungeonInfo    the gate (BuildPortal) + the template folder; the templates are
--                                                      built in a task.spawn after boot, one set per task.wait()
--   DungeonBuilder.BuildPortal(gatesFolder, siteCFrame) -> DungeonInfo { Portal, Pad, PromptPart, ReturnCFrame, Prompt }
--                                                      WorldStyle.BuildGate (the P4 hoop, Purple, "torch" = the skull
--                                                      crest, pill from the attribute DungeonBoard) + two torches on its
--                                                      pillars, <= 120 parts; prompt "DungeonPrompt"
--                                                      with OpenPanel = "Dungeon" on the prompt part
--   DungeonBuilder.BuildRun(index, floor, seed) -> Pocket { Index, Origin, Model, Floor, Seed, Layout, Rooms, Hall }
--                                                      the holder workspace.Dungeons.Dungeon_<index>, the Entrance Hall,
--                                                      the corridor to room 1 and room 1 (rooms chained on a seeded
--                                                      corridor path, never overlapping)
--   DungeonBuilder.PlaceRoom(pocket, room) -> RoomInfo  room 1..4 (5 = the treasure alcove): the template cloned, the
--                                                      Accent parts recoloured to the floor's element, the NC_BattleZone
--                                                      part (Mode "Dungeon", ZoneId "Room", Index, Room), the Threshold
--                                                      and the two bar doors; assembled under ServerStorage and parented
--                                                      in ONE step
--   DungeonBuilder.RemoveRoom(pocket, room)           destroys that room (and its inbound corridor)
--   (wave 6) every placed piece model carries CamMin / CamMax (Vector3, world): its camera box (the W x D shell, a
--                                                      corridor's floor tiles; floor - 2 .. its ceiling's bottom), read
--                                                      by DungeonController's camera clamp
--   DungeonBuilder.SetDoor(roomInfo, "Entrance"|"Exit", open) the bars' two states (CanCollide + Transparency) + the
--                                                      room model attributes DoorOpen (exit) / EntranceOpen
--   DungeonBuilder.FreeRun(index)                     the holder destroyed; the Dungeons folder goes with the last run
--   DungeonBuilder.Template(name) -> Model            a template (built on demand); EnsureTemplates() builds every set
--   DungeonBuilder.CountParts(instance) -> n          BasePart descendants
--   DungeonBuilder.Templates / Budgets / Kinds        data for tests and the renderer
--
-- RoomInfo = { Index, Kind, Template, Model, Zone, ZoneFloor (CFrame: the floor centre ON the floor top = the encounter
--             centre), Entrance (CFrame), Threshold (part), Door = { Bars }, ExitDoor = { Bars }, Center (Vector3), Spawns
--             = { CFrame... }, Chests = { part... }, Corridor, EnterPrompt (the entrance's, corridor side), NextPrompt (the
--             boss room's exit -> the treasure; Pocket.Hall.NextPrompt = the hall's exit -> room 1) }
-- Doors (dungeon-fixes decision 2): every Door_Entrance is placed CLOSED (EntranceOpen false); the EnterPrompt
-- ProximityPrompts (E, HoldDuration 0, RequiresLineOfSight false, MaxActivationDistance 10, DungeonAction "Enter",
-- ActionText "Enter", ObjectText "Room N" / "Boss room" / "Treasure", attribute TargetRoom) are built DISABLED;
-- DungeonService enables the one the group walks to and moves the group on when every member pressed it.
--
-- Art (Phase 6 A1: a cute, colourful voxel dungeon in the P4 spirit): lilac storybook stone walls with plinth, body
-- and cap, warm sandstone 6-stud flagstones (+-0.05 alternation), wall torches (bracket + stick + Neon flame + Fire +
-- PointLight range 18 amber, Shadows off), puddles, juicy moss, barrels, crates, chains, pillars, arches, a
-- portcullis on every door, stairs to a dais and a throne under a magenta carpet (the Throne set), caves with rock
-- walls, stalagmites, a turquoise pool and a waterfall wall, bridges over a deep violet chasm (an invisible floor
-- under it), a dark violet ceiling 16 studs up. SmoothPlastic only (Neon for glow, Glass for water and bottles,
-- ForceField for shimmer), blocky voxel shapes only (no Cylinder / Ball: barrels, bowls and rings are blocks);
-- parts < 4 studs do not cast shadows (Voxel.Box). Budgets per template: wave room <= 320, boss room <= 420, hall <=
-- 140, corridor <= 70, treasure <= 90; live per run hall + room k + corridor + room k+1 <= 950.
-- Plain Lua 5.1 syntax only (Luau subset).

local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Voxel = require(Shared.Voxel)
local WorldStyle = require(Shared.WorldStyle)

local DungeonBuilder = {}
-- bug batch 2 #14: the chests Treasure_1 builds (each member picks ONE); DungeonService.Init asserts this is >= its
-- CHEST_SLOTS (= MAX_PARTY 4). Read through deps there, so no require loop.
DungeonBuilder.CHEST_COUNT = 4

local floor, max, min, abs = math.floor, math.max, math.min, math.abs
local PI = math.pi
local rgb = Color3.fromRGB

-- Phase 6 A1 (back to the P4 look): every material key is SmoothPlastic; only Neon / Glass / ForceField stay
local M = setmetatable({ Neon = Enum.Material.Neon, Glass = Enum.Material.Glass, ForceField = Enum.Material.ForceField }, {
	__index = function()
		return Enum.Material.SmoothPlastic
	end,
})
local P4_MATS = { [Enum.Material.SmoothPlastic] = true, [Enum.Material.Neon] = true, [Enum.Material.Glass] = true, [Enum.Material.ForceField] = true }
local ZONE_TAG = "NC_BattleZone"
local DETAIL_TAG = (WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail"
local TEMPLATE_FOLDER = "DungeonTemplates"
local DUNGEONS_FOLDER = "Dungeons"
local WALL_H = 15 -- wall height; the ceiling slab sits on the cap, 16 studs up
local CEIL_Y = 15.8
local ASTRO_HUB_Y = 12.9 -- the B boss room's astrolabe hub (the outer ring's mesh top 15.4: 0.4 under the ceiling)
local TILE = 6
local MAX_INDEX = 12
local JOG = 15 -- the lateral shift of a Left / Right corridor
-- the battle zones (BattleCatalog.Dungeon.Zones when it loads: Room 44 x 44, Boss 56 x 72 = the whole Throne floor)
local ROOM_ZONE = { X = 44, Z = 44 }
local BOSS_ZONE = { X = 56, Z = 72 }
do
	local okZ, BattleCatalog = pcall(require, Shared:FindFirstChild("BattleCatalog"))
	local zones = okZ and type(BattleCatalog) == "table" and type(BattleCatalog.Dungeon) == "table" and BattleCatalog.Dungeon.Zones or nil
	if type(zones) == "table" then
		for name, target in pairs({ Room = ROOM_ZONE, Boss = BOSS_ZONE }) do
			local z = zones[name]
			if type(z) == "table" and tonumber(z.X) and tonumber(z.Z) then
				target.X, target.Z = tonumber(z.X), tonumber(z.Z)
			end
		end
	end
end

-- the chain of a run (room 0 = the hall, 1..4 the fight rooms, 5 the treasure alcove); every piece heads +Z
DungeonBuilder.Budgets = { Room = 320, Boss = 420, Hall = 140, Corridor = 70, Treasure = 90, Run = 950, Portal = 120 }
DungeonBuilder.Kinds = { Hall = 3, Cellar = 3, Cave = 3, Bridge = 2, Throne = 1 }
DungeonBuilder.Templates = {
	"Hall_1", "Hall_2", "Hall_3", "Cellar_1", "Cellar_2", "Cellar_3", "Cave_1", "Cave_2", "Cave_3", "Bridge_1", "Bridge_2",
	"Throne_1", "Entrance_1", "Corridor_Straight", "Corridor_Left", "Corridor_Right", "Treasure_1",
}

----------------------------------------------------------------------
-- Colours (Phase 6 A1: a cute, colourful voxel dungeon in the P4 spirit: lilac storybook stone, warm sandstone
-- flagstones, gold trim, juicy moss and turquoise water; bright enough for the dungeon's darker lighting preset)
----------------------------------------------------------------------
local BASE = {
	Stone = rgb(170, 160, 212), -- lilac castle stone
	StoneDark = rgb(130, 120, 182),
	StoneLight = rgb(198, 190, 236),
	Brick = rgb(186, 156, 214),
	Flag = rgb(232, 210, 166), -- the warm sandstone floor
	FlagDark = rgb(210, 184, 140),
	Ceiling = rgb(104, 92, 156),
	Wood = rgb(150, 100, 66),
	Plank = rgb(196, 146, 98),
	Iron = rgb(74, 82, 108),
	Gold = rgb(244, 198, 84),
	Flame = rgb(255, 184, 96),
	Ember = rgb(255, 120, 60),
	Light = rgb(255, 190, 120), -- amber torch light
	Moss = rgb(110, 200, 120),
	Hay = rgb(250, 214, 120),
	Water = rgb(92, 200, 236), -- the turquoise pool
	WaterGlow = rgb(150, 236, 255),
	Puddle = rgb(120, 190, 240),
	Carpet = rgb(206, 72, 150), -- the throne's magenta carpet
	Rock = rgb(156, 146, 196),
	RockDark = rgb(124, 114, 170),
	Abyss = rgb(60, 50, 104),
	Bone = rgb(246, 240, 226),
	Marble = rgb(240, 238, 248),
	Accent = rgb(176, 120, 240), -- the default accent (recoloured to the floor's element)
	Core = rgb(255, 184, 96), -- a brazier's glowing heart (the flame)
	CoreLight = rgb(255, 190, 120),
}

----------------------------------------------------------------------
-- bug #5 (art wave, player-approved B "The Weatherworks" + the note "every dungeon level needs a different design ...
-- the higher level of the dungeon the more serious it looks"): three looks, one per depth tier, chosen by the run's
-- floor. The colliders and the room layouts are the same in every look; the Part colours (the fallback), the Blender
-- keys (dungeon_<style>_wall_48 ...: blender/kit/props/dungeon_style.py) and a few style props differ.
--   c  The Root Conservatory  floors 1-3   the softest: a seed vault taken over by roots (terracotta, glasshouse ribs)
--   b  The Weatherworks       floors 4-8   the approved look: the Cloud-Smiths' machine halls (riveted panels, pipes)
--   a  The Cloudkeep Undercroft floors 9-12 the most serious: the old castle under everything (dark granite, pointed
--                             arches, a sky window behind the throne)
-- Inside a tier each floor's colours get a little darker (Deepen) and its contrast a little harder (the client mood,
-- Mood*). The mood is never darker than the P4 dungeon preset (MoodFloor: ambient 70,62,86, brightness -0.12): the
-- fights must stay readable on a phone; the palette, the colours and the contrast carry "serious". Every floor also gets its
-- element's weathering set (dungeon_wx_<element>_high / _low: moss, crystals, drips, icicles, soot, scorch, star-moss,
-- shadow crystals) and its element colour on one accent per look (ML_Secondary). Ranges are data: StyleTiers.
----------------------------------------------------------------------
DungeonBuilder.DefaultStyle = "b"
DungeonBuilder.StyleTiers = {
	{ First = 1, Last = 3, Style = "c" },
	{ First = 4, Last = 8, Style = "b" },
	{ First = 9, Last = 12, Style = "a" },
}
DungeonBuilder.StyleOrder = { "c", "b", "a" } -- by seriousness (Rank)
DungeonBuilder.Styles = {
	c = {
		Id = "c",
		Name = "The Root Conservatory",
		Rank = 1,
		Deepen = 0.9, -- the tier's last floor: wall / floor colours x 0.9
		Bricks = true, -- the protruding stones of a wall run (a terracotta brick out of line)
		Palette = {
			Stone = rgb(147, 87, 62), -- old terracotta brick (the player's pick 2026-10-29: the middle, darker brick)
			StoneDark = rgb(104, 82, 66), -- the soil-stone base
			StoneLight = rgb(167, 126, 98),
			Brick = rgb(138, 78, 58),
			Flag = rgb(148, 154, 126), -- mossy grey flagstones
			FlagDark = rgb(128, 136, 110),
			Ceiling = rgb(84, 70, 58), -- old timber
			Carpet = rgb(151, 93, 65), -- the terracotta path
			Rock = rgb(150, 136, 112),
			RockDark = rgb(120, 106, 88),
			Abyss = rgb(46, 62, 56),
			Marble = rgb(234, 236, 224),
			Light = rgb(255, 208, 140),
			Flame = rgb(255, 200, 112),
			Core = rgb(236, 255, 150), -- the pitcher plants' glow
			CoreLight = rgb(220, 255, 170),
		},
		Mood = { Ambient = rgb(82, 76, 92), Outdoor = rgb(98, 92, 108), Brightness = -0.08, Contrast = 0.1, Tint = rgb(240, 232, 220) },
	},
	b = {
		Id = "b",
		Name = "The Weatherworks",
		Rank = 2,
		Deepen = 0.84,
		Bricks = false, -- riveted panels: nothing sticks out of line
		Palette = {
			Stone = rgb(226, 230, 240), -- white dressed panels
			StoneDark = rgb(62, 76, 108), -- the storm-blue plinth / girders
			StoneLight = rgb(238, 240, 248),
			Brick = rgb(208, 214, 228),
			Flag = rgb(122, 136, 168), -- slate-blue tiles
			FlagDark = rgb(104, 118, 150),
			Ceiling = rgb(44, 54, 82),
			Carpet = rgb(58, 74, 132), -- the navy runner
			Gold = rgb(222, 172, 72), -- brass
			Iron = rgb(70, 80, 106),
			Rock = rgb(124, 132, 160),
			RockDark = rgb(96, 104, 134),
			Abyss = rgb(30, 40, 66),
			Light = rgb(255, 222, 170), -- lantern light
			Flame = rgb(255, 214, 140),
			Core = rgb(150, 232, 255), -- the condenser coils' cyan heart
			CoreLight = rgb(160, 226, 255),
		},
		Mood = { Ambient = rgb(70, 66, 90), Outdoor = rgb(86, 82, 108), Brightness = -0.1, Contrast = 0.12, Tint = rgb(230, 234, 242) },
	},
	a = {
		Id = "a",
		Name = "The Cloudkeep Undercroft",
		Rank = 3,
		Deepen = 0.78,
		Bricks = true,
		Palette = {
			Stone = rgb(154, 160, 178), -- grey-blue granite blocks
			StoneDark = rgb(70, 82, 110), -- the slate plinth / cornice
			StoneLight = rgb(182, 186, 202),
			Brick = rgb(140, 146, 166),
			Flag = rgb(150, 146, 144), -- big worn flagstones
			FlagDark = rgb(124, 120, 120),
			Ceiling = rgb(44, 44, 58),
			Carpet = rgb(150, 34, 48), -- the red carpet
			Gold = rgb(214, 170, 80),
			Iron = rgb(58, 62, 78),
			Rock = rgb(118, 120, 136),
			RockDark = rgb(92, 94, 110),
			Abyss = rgb(24, 22, 38),
			Marble = rgb(222, 220, 214),
			Light = rgb(255, 176, 104), -- old warm torchlight
			Flame = rgb(255, 176, 92),
			Core = rgb(255, 150, 70),
			CoreLight = rgb(255, 160, 90),
		},
		-- (the review: a 4-way darkening stack (ambient 52,50,66 x0.85, brightness -0.20, lights -15%, colours x0.78) had no
		-- in-engine evidence of readability; A now sits AT the P4 preset and gets its weight from the granite palette,
		-- Deepen, a harder contrast and the warm old-torch tint)
		Mood = { Ambient = rgb(70, 62, 86), Outdoor = rgb(86, 78, 104), Brightness = -0.12, Contrast = 0.16, Tint = rgb(226, 216, 204) },
	},
}

-- the darkest a run's mood may get (the P4 dungeon preset, DungeonController PRESET / contract 5.6): BuildRun clamps every
-- tier's MoodAmbient / MoodOutdoor per channel and MoodBrightness to it
DungeonBuilder.MoodFloor = { Ambient = rgb(70, 62, 86), Outdoor = rgb(86, 78, 104), Brightness = -0.12 }

-- the look of a floor (StyleTiers; DefaultStyle outside every range)
function DungeonBuilder.StyleFor(floorIndex)
	local f = tonumber(floorIndex) or 1
	for _, tier in ipairs(DungeonBuilder.StyleTiers) do
		if f >= tier.First and f <= tier.Last and DungeonBuilder.Styles[tier.Style] then
			return tier.Style
		end
	end
	return DungeonBuilder.DefaultStyle
end

-- 0 on a tier's first floor .. 1 on its last (how far down the tier the floor is: darker, dimmer)
function DungeonBuilder.StyleDepth(floorIndex)
	local f = tonumber(floorIndex) or 1
	for _, tier in ipairs(DungeonBuilder.StyleTiers) do
		if f >= tier.First and f <= tier.Last then
			return (tier.Last > tier.First) and (f - tier.First) / (tier.Last - tier.First) or 0
		end
	end
	return 0
end

-- the style the Kit builds with right now (Template / PlaceRoom set it; nil = the lobby portal: the base look)
local Style = { Cur = nil }
local C = setmetatable({}, {
	__index = function(_, k)
		local s = Style.Cur
		local v = s and s.Palette[k]
		if v ~= nil then
			return v
		end
		return BASE[k]
	end,
})
DungeonBuilder._Style = Style

----------------------------------------------------------------------
-- Small deterministic RNG per template (never math.random: templates are the same on every server)
----------------------------------------------------------------------
local function rng(seed)
	local s = floor(seed or 1) % 2147483647
	if s <= 0 then
		s = s + 2147483646
	end
	return function(n)
		s = (s * 48271) % 2147483647
		if n then
			return 1 + (s % n)
		end
		return s / 2147483647
	end
end

-- deterministic +-6 RGB shade noise (P4 Voxel.Shade spirit: big areas are never one flat colour)
local function jitter(color, seed)
	local n = (floor(seed or 0) * 7919 + 13) % 13 - 6
	local function ch(v)
		return max(0, min(255, floor(v * 255 + 0.5) + n))
	end
	return rgb(ch(color.R), ch(color.G), ch(color.B))
end

----------------------------------------------------------------------
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7, owner art-arenadungeon): Blender mesh dressing. The Part build stays
-- exactly as it is (the fallback, the colliders, every name / prompt / attribute / Accent part). The reusable pieces
-- (wall runs, floor tiles, pillars, torch bodies, chests, crates, cave rocks, stalagmites, cracks, door frames) sit in
-- small wrapper Models whose PrimaryPart moves with the clone (clonePiece moves BaseParts), and are tagged with
-- MeshLibrary.Tag(target, key, look, keep): clients Dress them (Parts hidden locally, Keep parts stay: flames, bars).
-- Keys: blender/catalog/arenadungeon.json, baked by blender/kit/props/dungeon.py from this very build. A key is tagged
-- only once it has an uploaded id (MeshLibrary.Status ~= "missing": the shipped empty MeshIds change nothing) and,
-- for pieces baked from a layout (walls, floors, pillars, door frames), only while the live piece still matches the
-- manifest's "LayoutSig" (part count + position / size sums in origin space; the random protruding Bricks are not
-- counted: the mesh carries its own). Tint parts take the piece's colour (look Primary). Targets never nest.
----------------------------------------------------------------------
local Mesh = { Lib = nil, Skip = { Brick = true }, Placed = setmetatable({}, { __mode = "k" }) } -- Placed: target -> its Tag call

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

-- part count + weighted sums of the visible BaseParts' positions / sizes in `origin` space (/ scale), Skip names out
function Mesh.Signature(target, origin, scale, keep)
	local inv = origin:Inverse()
	local s = tonumber(scale) or 1
	local kept = {}
	for _, k in ipairs(keep or {}) do
		kept[k] = true
	end
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 and not Mesh.Skip[d.Name] and not kept[d.Name] then
			local p = inv * d.Position
			local z = d.Size
			n = n + 1
			a = a + (p.X + p.Y * 0.37 + p.Z * 0.61) / s
			b = b + (z.X + z.Y * 1.3 + z.Z * 1.7) / s
		end
	end
	return n, a, b
end

function Mesh.sigOk(ML, key, target, origin, scale, keep)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	if not man then
		return false
	end
	local att = man.Attachments and man.Attachments.LayoutSig
	if not att then
		return true -- a designed piece (rock, crack): no layout to match
	end
	local pos = att.Pos or att.pos
	if type(pos) ~= "table" then
		return false
	end
	local n, a, b = Mesh.Signature(target, origin, scale, keep)
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- target: the piece (Model with a PrimaryPart, or one Part); origin: world CFrame of the mesh pivot; look: { Primary };
-- keep: names that stay visible; scale: uniform placement scale. Returns true when tagged.
function Mesh.tag(target, key, origin, look, keep, scale)
	if typeof(target) ~= "Instance" or typeof(origin) ~= "CFrame" then
		return false
	end
	Mesh.Placed[target] = { Key = key, Origin = origin, Look = look, Keep = keep, Scale = scale }
	local kit = DungeonBuilder._Kit
	if type(kit) == "table" and type(kit.Targets) == "table" then
		kit.Targets[#kit.Targets + 1] = { Key = key, Target = target, Origin = origin, Look = look, Keep = keep, Scale = scale }
	end
	local ML = Mesh.lib()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" or not Mesh.sigOk(ML, key, target, origin, scale, keep) then
		return false
	end
	local tagLook = {}
	for k, v in pairs(look or {}) do
		tagLook[k] = v
	end
	local pivot = target:IsA("BasePart") and target.CFrame or target:GetPivot() -- (a Part's pivot: PivotOffset is never set here)
	tagLook.Offset = pivot:Inverse() * origin
	if scale and scale ~= 1 then
		target:SetAttribute("ML_Scale", scale)
	end
	ML.Tag(target, key, tagLook, keep)
	return true
end

-- a number in a key: 15 -> "15", 15.5 -> "15p5", -6 -> "m6"
function Mesh.num(v)
	local t = string.format("%.2f", v):gsub("0+$", ""):gsub("%.$", "")
	return (t:gsub("%-", "m"):gsub("%.", "p"))
end

-- bug #5: the key of a styled piece. The baked shell pieces (walls, floors, pillars, torches, door frames) take the
-- current style: dungeon_wall_48 -> dungeon_b_wall_48. Outside a style (a Geo build called on its own) the shell takes
-- DefaultStyle; only a torch outside a style (the lobby portal's) keeps the base key dungeon_torch.
Mesh.Styled = { wall = true, floor = true, pillar = true, torch = true, door = true }
-- the base shell keys of the lilac look (uploaded and live before bug #5): nothing tags them any more. Their manifests
-- and ids stay until the styled keys are uploaded and live (then they can be deleted: blender/catalog no longer
-- builds them); the mesh smoke skips them in its orphan check
DungeonBuilder.RetiredKeys = {}
for _, k in ipairs({ "wall_10_lite", "wall_15_lite", "wall_22_lite", "wall_24", "wall_30", "wall_30_door", "wall_30_door_lite", "wall_30_lite", "wall_48", "wall_50_door", "wall_5_lite", "wall_62_door", "wall_62_door20", "wall_72", "floor_28x22", "floor_28x24", "floor_44x48", "floor_48x48", "floor_60x72", "pillar_7", "pillar_10p5", "pillar_15", "pillar_15p5", "door_8" }) do
	DungeonBuilder.RetiredKeys["dungeon_" .. k] = true
end
function Mesh.key(base)
	local kind = string.match(base, "^dungeon_(%a+)")
	if not (kind and Mesh.Styled[kind]) then
		return base
	end
	local id = Style.Cur and Style.Cur.Id or (kind ~= "torch" and DungeonBuilder.DefaultStyle) or nil
	if id then
		return "dungeon_" .. id .. "_" .. string.sub(base, 9)
	end
	return base
end

-- a style's own designed prop: Mesh.skey("throne") -> dungeon_b_throne (DefaultStyle outside a style)
function Mesh.skey(name)
	local s = Style.Cur
	return "dungeon_" .. (s and s.Id or DungeonBuilder.DefaultStyle) .. "_" .. name
end

-- a wrapper Model for one piece (PrimaryPart set by the caller once its first part exists)
function Mesh.group(parent, name)
	local g = Instance.new("Model")
	g.Name = name
	g.Parent = parent
	return g
end
DungeonBuilder._Mesh = Mesh

----------------------------------------------------------------------
-- Kit: the parts (Voxel.Box) of the dungeon
----------------------------------------------------------------------
local Kit = {}

-- a box; opts: Name, Collide, Material, Transparency, Shape, Accent, Detail
function Kit.part(parent, cf, size, color, mat, opts)
	opts = opts or {}
	local props = { Name = opts.Name or "Stone", CanCollide = opts.Collide == true, CanQuery = opts.Collide == true, CanTouch = false }
	if opts.Transparency then
		props.Transparency = opts.Transparency
	end
	-- Phase 6 A1: blocks only (opts.Shape is ignored: no Cylinder / Ball) and P4 materials only
	if not P4_MATS[mat or M.Slate] then
		mat = M.Slate
	end
	local p = Voxel.Box(parent, cf, size, color, mat or M.Slate, props)
	if opts.Accent then
		p:SetAttribute("Accent", true)
	end
	return p
end

-- the floor: TILE-stud flagstones with +-0.05 alternation, top at y 0, walkable
function Kit.floorTiles(parent, w, d, color, mat, seed, y)
	local nx, nz = max(1, floor(w / TILE + 0.5)), max(1, floor(d / TILE + 0.5))
	local tw, td = w / nx, d / nz
	local base = y or 0
	local n = 0
	local tiles = Mesh.group(parent, "FloorTiles")
	for i = 1, nx do
		for j = 1, nz do
			local lift = ((i + j) % 2 == 0) and 0.05 or -0.05
			local x = -w / 2 + (i - 0.5) * tw
			local z = -d / 2 + (j - 0.5) * td
			local c = color
			if (i * 7 + j * 3 + seed) % 6 == 0 then
				c = C.FlagDark
			end
			local tile = Kit.part(tiles, CFrame.new(x, base - 0.5 + lift, z), Vector3.new(tw, 1, td), jitter(c, seed * 31 + i * 7 + j), mat or M.Cobblestone, { Name = "Floor", Collide = true })
			if not tiles.PrimaryPart then
				tiles.PrimaryPart = tile
			end
			n = n + 1
		end
	end
	Mesh.tag(tiles, Mesh.key("dungeon_floor_" .. Mesh.num(w) .. "x" .. Mesh.num(d)), CFrame.new(0, base, 0), { Primary = color, Secondary = C.Accent })
	tiles:SetAttribute("DG_Element", true) -- bug #5: the grates / joints glow in the floor's element colour
	-- cracks between the flagstones
	local r = rng(seed * 13 + 5)
	for k = 1, max(2, floor((nx * nz) / 12)) do
		local x = -w / 2 + 4 + r() * (w - 8)
		local z = -d / 2 + 4 + r() * (d - 8)
		local ccf = CFrame.new(x, base + 0.06, z) * CFrame.Angles(0, r() * PI, 0)
		local len = 2.5 + r() * 3
		local crack = Kit.part(parent, ccf, Vector3.new(len, 0.12, 0.25), C.StoneDark, M.Slate, { Name = "Crack" })
		Mesh.tag(crack, "dungeon_crack", ccf, nil, nil, len / 4)
		n = n + 1
	end
	return n
end

-- a wall of length `len` whose centre is `cf` (local X along the wall, LookVector into the room): plinth band, body,
-- cap, a few protruding stones; door = { X = offset, Width } leaves a doorway with a lintel
function Kit.wall(outer, cf, len, color, mat, seed, door, lite)
	local h = WALL_H
	local r = rng(seed)
	local parent = Mesh.group(outer, "WallRun")
	-- plinth (rule 3)
	parent.PrimaryPart = Kit.part(parent, cf * CFrame.new(0, 0.6, -0.35), Vector3.new(len, 1.2, 1.7), C.StoneDark, M.Slate, { Name = "Plinth", Collide = true })
	if door then
		local dw = door.Width or 8
		local dx = door.X or 0
		local leftLen = (dx - dw / 2) - (-len / 2)
		local rightLen = (len / 2) - (dx + dw / 2)
		if leftLen > 0.5 then
			Kit.part(parent, cf * CFrame.new(-len / 2 + leftLen / 2, h / 2, 0), Vector3.new(leftLen, h, 1), jitter(color, seed), mat, { Name = "Wall", Collide = true })
		end
		if rightLen > 0.5 then
			Kit.part(parent, cf * CFrame.new(len / 2 - rightLen / 2, h / 2, 0), Vector3.new(rightLen, h, 1), jitter(color, seed + 1), mat, { Name = "Wall", Collide = true })
		end
		-- the wall above the doorway
		Kit.part(parent, cf * CFrame.new(dx, (h + 8) / 2, 0), Vector3.new(dw, h - 8, 1), jitter(color, seed + 2), mat, { Name = "Wall", Collide = true })
	else
		Kit.part(parent, cf * CFrame.new(0, h / 2, 0), Vector3.new(len, h, 1), jitter(color, seed), mat, { Name = "Wall", Collide = true })
	end
	-- cap / cornice, the dado band and two mortar courses (the brick read of image 22)
	Kit.part(parent, cf * CFrame.new(0, h + 0.4, -0.3), Vector3.new(len, 0.8, 1.6), C.StoneDark, M.Slate, { Name = "Cap" })
	if lite then
		Kit.part(parent, cf * CFrame.new(0, 7.2, -0.55), Vector3.new(len, 0.4, 0.12), C.StoneDark, M.Brick, { Name = "Course" })
	elseif not door then
		Kit.part(parent, cf * CFrame.new(0, 3.4, -0.6), Vector3.new(len, 0.5, 0.2), C.StoneDark, M.Brick, { Name = "Dado" })
		Kit.part(parent, cf * CFrame.new(0, 7.2, -0.55), Vector3.new(len, 0.4, 0.12), C.StoneDark, M.Brick, { Name = "Course" })
		Kit.part(parent, cf * CFrame.new(0, 11, -0.55), Vector3.new(len, 0.4, 0.12), C.StoneDark, M.Brick, { Name = "Course" })
	else
		Kit.part(parent, cf * CFrame.new(0, 11.4, -0.55), Vector3.new(len, 0.4, 0.12), C.StoneDark, M.Brick, { Name = "Course" })
	end
	-- protruding stones (bug #5: not on the Weatherworks' riveted panels)
	-- (bug #5: one stone fewer per run: the bannered walls' new brackets and chain rods kept Treasure inside its 90)
	local n = lite and 1 or max(3, min(7, floor(len / 6)))
	if not (Style.Cur or DungeonBuilder.Styles[DungeonBuilder.DefaultStyle]).Bricks then
		n = 0
	end
	for i = 1, n do
		local x = -len / 2 + 2 + r() * (len - 4)
		local y = 1.6 + r() * (h - 4)
		if not door or abs(x - (door.X or 0)) > (door.Width or 8) / 2 + 1.2 or y > 8.5 then
			local sw = 1.8 + r() * 1.4
			local shade = (i % 3 == 0) and C.StoneDark or C.StoneLight
			Kit.part(parent, cf * CFrame.new(x, y, -0.6), Vector3.new(sw, 1.0, 0.4), jitter(shade, seed + i * 3), M.Slate, { Name = "Brick" })
		end
	end
	local key = "dungeon_wall_" .. Mesh.num(len)
	if door then
		key = key .. "_door" .. (((door.X or 0) ~= 0) and Mesh.num(door.X) or "") .. (((door.Width or 8) ~= 8) and ("w" .. Mesh.num(door.Width)) or "")
	end
	if lite then
		key = key .. "_lite"
	end
	Mesh.tag(parent, Mesh.key(key), cf, { Primary = color, Secondary = C.Accent })
	parent:SetAttribute("DG_Element", true)
	return parent
end

function Kit.pillar(outer, cf, h, color)
	local parent = Mesh.group(outer, "PillarStack")
	parent.PrimaryPart = Kit.part(parent, cf * CFrame.new(0, 0.5, 0), Vector3.new(2.6, 1, 2.6), C.StoneDark, M.Slate, { Name = "PillarBase", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, h / 2, 0), Vector3.new(2, h, 2), color or C.Stone, M.Slate, { Name = "Pillar", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, h - 0.4, 0), Vector3.new(2.6, 0.8, 2.6), C.StoneDark, M.Slate, { Name = "PillarCap" })
	Mesh.tag(parent, Mesh.key("dungeon_pillar_" .. Mesh.num(h)), cf, { Primary = color or C.Stone, Secondary = C.Accent })
	parent:SetAttribute("DG_Element", true)
	return parent
end

-- a wall torch: cf = the mount point on the wall face (LookVector into the room)
function Kit.torch(outer, cf, bright)
	local parent = Mesh.group(outer, "WallTorch")
	parent.PrimaryPart = Kit.part(parent, cf * CFrame.new(0, 0.6, -0.1), Vector3.new(1.2, 2.2, 0.2), C.Iron, M.Metal, { Name = "Sconce" })
	Kit.part(parent, cf * CFrame.new(0, 0, -0.3), Vector3.new(0.5, 0.7, 0.6), C.Iron, M.Metal, { Name = "Bracket" })
	Kit.part(parent, cf * CFrame.new(0, 0.7, -0.75) * CFrame.Angles(-0.35, 0, 0), Vector3.new(0.3, 1.8, 0.3), C.Wood, M.Wood, { Name = "Stick" })
	local flame = Kit.part(parent, cf * CFrame.new(0, 1.9, -1.05), Vector3.new(0.8, 1.3, 0.8), C.Flame, M.Neon, { Name = "Flame" })
	local light = Instance.new("PointLight")
	light.Name = "TorchLight"
	light.Color = C.Light
	light.Brightness = bright or 1.2
	light.Range = 18
	light.Shadows = false
	light.Parent = flame
	pcall(function()
		local fire = Instance.new("Fire")
		fire.Name = "TorchFire"
		fire.Size = 2
		fire.Heat = 4
		fire.Color = C.Flame
		fire.SecondaryColor = C.Ember
		fire.Parent = flame
	end)
	Mesh.tag(parent, Mesh.key("dungeon_torch"), cf, nil, { "Flame" })
	Kit.sound(parent, "torch")
	return flame
end

-- a doorway's portcullis: cf = the doorway centre on the floor (LookVector into the room); the bars are a Model
function Kit.door(parent, cf, name, width)
	local w = width or 8
	local h = 8
	local door = Instance.new("Model")
	door.Name = name
	Kit.part(door, cf * CFrame.new(-w / 2 - 0.5, h / 2, 0), Vector3.new(1, h, 1.6), C.StoneDark, M.Slate, { Name = "Jamb", Collide = true })
	Kit.part(door, cf * CFrame.new(w / 2 + 0.5, h / 2, 0), Vector3.new(1, h, 1.6), C.StoneDark, M.Slate, { Name = "Jamb", Collide = true })
	Kit.part(door, cf * CFrame.new(0, h + 0.5, 0), Vector3.new(w + 2, 1, 1.6), C.StoneDark, M.Slate, { Name = "Lintel", Collide = true })
	local n = max(3, floor(w / 1.6))
	local bars = {}
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		bars[i] = Kit.part(door, cf * CFrame.new(x, h / 2, 0), Vector3.new(0.35, h, 0.35), C.Iron, M.Metal, { Name = "Bar", Collide = true })
	end
	door:SetAttribute("Open", false)
	door.PrimaryPart = door:FindFirstChild("Lintel")
	door.Parent = parent
	-- the frame (jambs + lintel) is the mesh; the Bars stay Parts (SetDoor flips them on the server)
	Mesh.tag(door, Mesh.key("dungeon_door_" .. Mesh.num(w)), cf, nil, { "Bar" })
	return door, bars
end

function Kit.setDoor(door, open)
	if not door then
		return
	end
	for _, bar in ipairs(door:GetChildren()) do
		if bar.Name == "Bar" and bar:IsA("BasePart") then
			bar.CanCollide = not open
			bar.CanQuery = not open
			bar.Transparency = open and 1 or 0
		end
	end
	door:SetAttribute("Open", open == true)
end

-- the "Enter" prompt of a door (dungeon-fixes decision 2): an invisible anchored point a little in front of the bars with
-- a ProximityPrompt EnterPrompt (E, no hold, no line of sight, 10 studs, DungeonAction "Enter"), DISABLED: DungeonService
-- enables it only while the group may move on and handles the press in its PromptTriggered (nothing new from the client)
function Kit.enterPrompt(parent, cf, objectText, targetRoom)
	local point = Instance.new("Part")
	point.Name = "EnterPoint"
	point.Anchored = true
	point.CanCollide = false
	point.CanQuery = false
	point.CanTouch = false
	point.CastShadow = false
	point.Transparency = 1
	point.Material = Enum.Material.SmoothPlastic
	point.Size = Vector3.new(1, 1, 1)
	point.CFrame = cf
	point:SetAttribute("DungeonAction", "Enter")
	point:SetAttribute("TargetRoom", targetRoom)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "EnterPrompt"
	prompt.ActionText = "Enter"
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Enabled = false
	prompt:SetAttribute("DungeonAction", "Enter")
	prompt:SetAttribute("TargetRoom", targetRoom)
	prompt.Parent = point
	point.Parent = parent
	return prompt, point
end

local function enterLabel(targetRoom)
	if targetRoom >= 5 then
		return "Treasure"
	elseif targetRoom == 4 then
		return "Boss room"
	end
	return "Room " .. tostring(targetRoom)
end

-- bug batch 2 (#19): the ceiling collides (CanCollide + CanQuery), so Roblox's camera occlusion (Poppercam only stops at
-- colliding, queryable parts) keeps the camera under it: with the dungeon zoom cap of 14 a steep downward look used to
-- lift the camera 18 studs up, through the 16-stud ceiling, above the pocket (nobody can jump that high)
function Kit.ceiling(parent, w, d, y)
	Kit.part(parent, CFrame.new(0, (y or CEIL_Y) + 0.5, 0), Vector3.new(w + 2, 1, d + 2), C.Ceiling, M.Slate, { Name = "Ceiling", Collide = true })
end

-- bug #5 (art rule: every visible piece is a Blender mesh): a prop's Part build sits in its own wrapper Model and is
-- dressed by `key` (pivot = the Tag origin `cf`); the Parts stay as the collider and the fallback. element = true: the
-- key's Secondary tint takes the floor's element colour (PlaceRoom). Shared keys (one look for every style: barrel,
-- table, hay, bench, cauldron, shield, candles, chandelier, hearth, rug, wine rack, weapon rack) are dungeon_<name>;
-- style keys (throne, dais, carpet, arch, statue, brazier, banner, curio ...) dungeon_<style>_<name> (Mesh.skey).
function Kit.dress(group, key, cf, look, keep, scale, element)
	if not group.PrimaryPart then
		for _, d in ipairs(group:GetChildren()) do
			if d:IsA("BasePart") then
				group.PrimaryPart = d
				break
			end
		end
	end
	Mesh.tag(group, key, cf, look, keep, scale)
	if element then
		group:SetAttribute("DG_Element", true)
	end
	return group
end

-- bug #5: the dungeon's sound sources, tagged for the audio branch (no playback here): CollectionService tag
-- DungeonBuilder.SoundTag on the instance + attribute DungeonSound = the kind ("torch", "brazier_<style>",
-- "astrolabe", "curio_<style>", "weather_<element>")
DungeonBuilder.SoundTag = "NC_DungeonSound"
function Kit.sound(inst, kind)
	CollectionService:AddTag(inst, DungeonBuilder.SoundTag)
	inst:SetAttribute("DungeonSound", kind)
	return inst
end

-- props (pure decor sits in one NC_Detail model per room)
-- bug #5 review: the Weatherworks (b) is a guild workshop, not the castle cellar; its rooms swap the cellar leftovers
-- for its own honest pieces (placement only, no new keys): barrel / hay -> a supply crate, the wine rack -> a stand-pipe
-- with its red valve wheel against the wall (the b curio), the cauldron -> a condenser coil (the b brazier)
local function machineHall()
	return Style.Cur ~= nil and Style.Cur.Id == "b"
end
DungeonBuilder.B_SWAPS = { BarrelSet = "CrateBox", HayBale = "CrateBox", WineRackSet = "CurioSet", CauldronSet = "BrazierSet" }

function Kit.barrel(outer, cf)
	if machineHall() then
		return Kit.crate(outer, cf, 2.6)
	end
	local parent = Mesh.group(outer, "BarrelSet")
	local up = CFrame.Angles(0, 0, PI / 2)
	Kit.part(parent, cf * CFrame.new(0, 1.6, 0) * up, Vector3.new(3.2, 2.8, 2.8), C.Wood, M.Wood, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Collide = true })
	Kit.part(parent, cf * CFrame.new(0, 0.7, 0) * up, Vector3.new(0.25, 2.95, 2.95), C.Iron, M.Metal, { Name = "Band", Shape = Enum.PartType.Cylinder })
	Kit.part(parent, cf * CFrame.new(0, 2.5, 0) * up, Vector3.new(0.25, 2.95, 2.95), C.Iron, M.Metal, { Name = "Band", Shape = Enum.PartType.Cylinder })
	return Kit.dress(parent, "dungeon_barrel", cf)
end

function Kit.crate(outer, cf, s)
	s = s or 3
	local parent = Mesh.group(outer, "CrateBox")
	parent.PrimaryPart = Kit.part(parent, cf * CFrame.new(0, s / 2, 0), Vector3.new(s, s, s), C.Plank, M.WoodPlanks, { Name = "Crate", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, s / 2, s / 2 + 0.05), Vector3.new(s * 0.9, 0.3, 0.1), C.Wood, M.Wood, { Name = "Slat" })
	Kit.part(parent, cf * CFrame.new(0, s / 2, -s / 2 - 0.05), Vector3.new(s * 0.9, 0.3, 0.1), C.Wood, M.Wood, { Name = "Slat" })
	Mesh.tag(parent, "dungeon_crate", cf, nil, nil, s / 3)
	return parent
end

-- a chain hanging from the ceiling (bug #5: the three links used to hang in mid-air; a rod now reaches the ceiling
-- slab). Shared key dungeon_chain (pivot = the top link; the rod's length is the room's, so no LayoutSig on the rod:
-- the key covers the links and a ceiling staple, the rod stays a Part)
function Kit.chain(outer, cf)
	local parent = Mesh.group(outer, "ChainHang")
	for i = 0, 2 do
		Kit.part(parent, cf * CFrame.new((i % 2) * 0.2 - 0.1, -i * 0.9, 0), Vector3.new(0.35, 1, 0.2), C.Iron, M.Metal, { Name = "Chain" })
	end
	local top = cf.Position.Y + 0.5
	local len = max(0.2, CEIL_Y - top)
	Kit.part(outer, CFrame.new(cf.Position.X, top + len / 2, cf.Position.Z), Vector3.new(0.2, len, 0.2), C.Iron, M.Metal, { Name = "ChainRod" })
	return Kit.dress(parent, "dungeon_chain", cf)
end

function Kit.puddle(parent, cf, w, d)
	Kit.part(parent, cf * CFrame.new(0, 0.07, 0), Vector3.new(w or 4, 0.14, d or 3), C.Puddle, M.Glass, { Name = "Puddle", Transparency = 0.35, Accent = true })
end

function Kit.moss(parent, cf, w, d)
	Kit.part(parent, cf * CFrame.new(0, 0.1, 0), Vector3.new(w or 3, 0.2, d or 2), C.Moss, M.Grass, { Name = "Moss" })
end

function Kit.hay(outer, cf)
	if machineHall() then
		-- (a long low crate pair over the bale's footprint: the 1.1 step rule is kept by the crates' own colliders)
		Kit.crate(outer, cf * CFrame.new(-0.9, 0, 0), 2.4)
		return Kit.crate(outer, cf * CFrame.new(1.3, 0, 0.3) * CFrame.Angles(0, 0.3, 0), 1.6)
	end
	local parent = Mesh.group(outer, "HayBale")
	-- bug batch 2 (#3): the bale collides (a 1.1 step, like the wall plinth): no wading through it
	Kit.part(parent, cf * CFrame.new(0, 0.55, 0), Vector3.new(4.4, 1.1, 3.6), C.Hay, M.Sand, { Name = "Hay", Collide = true })
	Kit.part(parent, cf * CFrame.new(0.5, 1.35, -0.3) * CFrame.Angles(0, 0.4, 0), Vector3.new(2.6, 0.6, 2), C.Hay, M.Sand, { Name = "Hay" })
	return Kit.dress(parent, "dungeon_hay", cf)
end

function Kit.table(outer, cf)
	local parent = Mesh.group(outer, "TableSet")
	Kit.part(parent, cf * CFrame.new(0, 2.5, 0), Vector3.new(7, 0.45, 3), C.Plank, M.WoodPlanks, { Name = "TableTop", Collide = true })
	Kit.part(parent, cf * CFrame.new(-2.8, 1.15, 0), Vector3.new(0.6, 2.3, 2.4), C.Wood, M.Wood, { Name = "TableLeg" })
	Kit.part(parent, cf * CFrame.new(2.8, 1.15, 0), Vector3.new(0.6, 2.3, 2.4), C.Wood, M.Wood, { Name = "TableLeg" })
	Kit.part(parent, cf * CFrame.new(-1.6, 3.0, 0.4), Vector3.new(0.9, 0.6, 0.9), C.Gold, M.Metal, { Name = "Cup" })
	Kit.part(parent, cf * CFrame.new(1.4, 2.9, -0.5), Vector3.new(1.6, 0.3, 1.2), C.Bone, M.Marble, { Name = "Plate" })
	return Kit.dress(parent, "dungeon_table", cf)
end

function Kit.bench(outer, cf)
	local parent = Mesh.group(outer, "BenchSet")
	Kit.part(parent, cf * CFrame.new(0, 1.3, 0), Vector3.new(6, 0.4, 1.4), C.Plank, M.WoodPlanks, { Name = "Bench", Collide = true })
	Kit.part(parent, cf * CFrame.new(-2.4, 0.55, 0), Vector3.new(0.5, 1.1, 1.2), C.Wood, M.Wood, { Name = "BenchLeg" })
	Kit.part(parent, cf * CFrame.new(2.4, 0.55, 0), Vector3.new(0.5, 1.1, 1.2), C.Wood, M.Wood, { Name = "BenchLeg" })
	return Kit.dress(parent, "dungeon_bench", cf)
end

function Kit.bones(parent, cf)
	if machineHall() then
		-- (fix round, Gemini: bones read as crypt leftovers in a workshop) a dropped copper pipe offcut and a brass nut
		Kit.part(parent, cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.2, 0.35, 0.35), rgb(70, 168, 140), M.Metal, { Name = "PipeOffcut" })
		Kit.part(parent, cf * CFrame.new(0.8, 0.12, 0.6) * CFrame.Angles(0, -0.9, 0), Vector3.new(0.5, 0.24, 0.5), C.Gold, M.Metal, { Name = "Nut" })
		return
	end
	Kit.part(parent, cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0.5, 0), Vector3.new(2.2, 0.35, 0.35), C.Bone, M.Marble, { Name = "Bone" })
	Kit.part(parent, cf * CFrame.new(0.8, 0.2, 0.6) * CFrame.Angles(0, -0.9, 0), Vector3.new(1.6, 0.3, 0.3), C.Bone, M.Marble, { Name = "Bone" })
end

-- a hanging banner (Accent: recoloured to the floor's element) ON the wall face (bug #5: cf = the face itself; the pole
-- and the cloth hang 0.3 out, clear of the 0.11-stud mortar courses, held by two iron brackets; they used to float ~0.9
-- stud off the wall with nothing holding them). Style key dungeon_<s>_banner (its stripe = the element: Secondary)
function Kit.banner(outer, cf)
	local parent = Mesh.group(outer, "BannerHang")
	Kit.part(parent, cf * CFrame.new(0, 0, -0.3), Vector3.new(4.4, 0.3, 0.3), C.Wood, M.Wood, { Name = "BannerPole" })
	Kit.part(parent, cf * CFrame.new(-1.8, 0, -0.15), Vector3.new(0.3, 0.3, 0.3), C.Iron, M.Metal, { Name = "BannerBracket" })
	Kit.part(parent, cf * CFrame.new(1.8, 0, -0.15), Vector3.new(0.3, 0.3, 0.3), C.Iron, M.Metal, { Name = "BannerBracket" })
	Kit.part(parent, cf * CFrame.new(0, -2.8, -0.3), Vector3.new(3.6, 5.4, 0.25), C.Accent, M.Fabric, { Name = "Banner", Accent = true })
	return Kit.dress(parent, Mesh.skey("banner"), cf, { Secondary = C.Accent }, nil, nil, true)
end

-- a thin Neon rune inlay in the floor (Accent)
function Kit.rune(parent, cf, w, d)
	Kit.part(parent, cf * CFrame.new(0, 0.08, 0), Vector3.new(w or 3, 0.16, d or 0.6), C.Accent, M.Neon, { Name = "Rune", Accent = true })
end

-- an arch over the aisle: two pillar stacks (their own pillar keys) + the top. bug #5: the lintel, the two diagonal
-- ArchStones and the keystone are one style key dungeon_<s>_arch_<width> (a pointed granite arch (a), a riveted
-- storm-blue girder with a weathervane (b), two woven roots (c))
function Kit.arch(parent, cf, width, height)
	local w, h = width or 10, height or 11
	Kit.pillar(parent, cf * CFrame.new(-w / 2 - 1, 0, 0), h - 2, C.StoneLight)
	Kit.pillar(parent, cf * CFrame.new(w / 2 + 1, 0, 0), h - 2, C.StoneLight)
	local top = Mesh.group(parent, "ArchTop")
	Kit.part(top, cf * CFrame.new(0, h - 0.6, 0), Vector3.new(w + 4.6, 1.2, 2.2), C.StoneLight, M.Slate, { Name = "ArchLintel" })
	Kit.part(top, cf * CFrame.new(-w / 2 + 0.6, h - 2.2, 0) * CFrame.Angles(0, 0, 0.75), Vector3.new(2, 1, 2), C.StoneLight, M.Slate, { Name = "ArchStone" })
	Kit.part(top, cf * CFrame.new(w / 2 - 0.6, h - 2.2, 0) * CFrame.Angles(0, 0, -0.75), Vector3.new(2, 1, 2), C.StoneLight, M.Slate, { Name = "ArchStone" })
	Kit.part(top, cf * CFrame.new(0, h + 0.6, 0), Vector3.new(4, 1.2, 2.4), C.Stone, M.Slate, { Name = "Keystone" })
	Kit.dress(top, Mesh.skey("arch_" .. Mesh.num(w)), cf, { Secondary = C.Accent }, nil, nil, true)
end

function Kit.stairs(parent, cf, width, steps, rise)
	local depth = 1.6
	for i = 1, steps do
		Kit.part(parent, cf * CFrame.new(0, (i - 0.5) * rise, (i - 0.5) * depth), Vector3.new(width, rise, depth), jitter(C.StoneLight, i * 11), M.Slate, { Name = "Step", Collide = true })
	end
end

-- bug batch 2 (#3): an invisible collider around the foot, stem and bowl (the flame stays above it). bug #5: the style
-- key dungeon_<s>_brazier (an iron brazier on a tripod (a), a copper condenser coil round a cyan core (b), a glowing
-- pitcher plant (c)); the flame stays a Neon Part in the style's Core colour
function Kit.brazier(outer, cf)
	local parent = Mesh.group(outer, "BrazierSet")
	Kit.part(parent, cf * CFrame.new(0, 1.8, 0), Vector3.new(3.2, 3.6, 3.2), C.Iron, M.Metal, { Name = "BrazierCollider", Collide = true, Transparency = 1 })
	Kit.part(parent, cf * CFrame.new(0, 0.3, 0), Vector3.new(2, 0.6, 2), C.Iron, M.Metal, { Name = "BrazierFoot" })
	Kit.part(parent, cf * CFrame.new(0, 1.6, 0), Vector3.new(0.5, 2, 0.5), C.Iron, M.Metal, { Name = "BrazierStem" })
	Kit.part(parent, cf * CFrame.new(0, 3.0, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(1.1, 3.2, 3.2), C.Iron, M.Metal, { Name = "BrazierBowl", Shape = Enum.PartType.Cylinder })
	local flame = Kit.part(parent, cf * CFrame.new(0, 4.3, 0), Vector3.new(1.8, 1.8, 1.8), C.Core, M.Neon, { Name = "BrazierFlame" })
	local light = Instance.new("PointLight")
	light.Name = "BrazierLight"
	light.Color = C.CoreLight
	light.Brightness = 1.4
	light.Range = 18
	light.Shadows = false
	light.Parent = flame
	Kit.sound(parent, "brazier_" .. (Style.Cur and Style.Cur.Id or DungeonBuilder.DefaultStyle))
	return Kit.dress(parent, Mesh.skey("brazier"), cf, nil, { "BrazierFlame" })
end

function Kit.rock(parent, cf, size, seed)
	local r = rng(seed)
	local rock = Kit.part(parent, cf * CFrame.Angles((r() - 0.5) * 0.4, (r() - 0.5) * 0.6, (r() - 0.5) * 0.4), size, jitter((r() > 0.5) and C.Rock or C.RockDark, seed), M.Slate, { Name = "Rock", Collide = true })
	-- a real voxel rock (3 shapes) upright at the box's centre, sized to the box's volume (the tilted box stays the collider)
	local vol = (size.X * size.Y * size.Z) ^ (1 / 3)
	local thin = min(size.X, size.Y, size.Z)
	local shape = (floor(seed or 0) % 3) + 1
	Mesh.tag(rock, "dungeon_rock_" .. shape, cf * CFrame.new(0, -size.Y / 2, 0), { Primary = rock.Color }, nil, min(vol, thin * 1.3) / 4)
	return rock
end

function Kit.stalagmite(outer, cf, h)
	h = h or 4
	local parent = Mesh.group(outer, "StalagmiteStack")
	-- bug batch 2 (#3): every tier collides (standing on the base used to put the player inside the upper tiers)
	parent.PrimaryPart = Kit.part(parent, cf * CFrame.new(0, h * 0.2, 0) * CFrame.Angles(0, 0.4, 0), Vector3.new(2.6, h * 0.4, 2.6), C.RockDark, M.Slate, { Name = "Stalagmite", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, h * 0.55, 0) * CFrame.Angles(0, 0.8, 0), Vector3.new(1.6, h * 0.35, 1.6), C.Rock, M.Slate, { Name = "Stalagmite", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, h * 0.85, 0), Vector3.new(0.7, h * 0.3, 0.7), C.Rock, M.Slate, { Name = "Stalagmite", Collide = true })
	Mesh.tag(parent, "dungeon_stalagmite", cf, nil, nil, h / 4)
	return parent
end

-- a cobweb in a ceiling corner: cf = the corner at the ceiling, LookVector along one wall
function Kit.cobweb(parent, cf)
	Kit.part(parent, cf * CFrame.new(1.4, -0.3, -1.4) * CFrame.Angles(0, PI / 4, 0), Vector3.new(4, 0.1, 0.1), C.Marble, M.Glass, { Name = "Web", Transparency = 0.45 })
	Kit.part(parent, cf * CFrame.new(1.0, -1.1, -1.0) * CFrame.Angles(0, PI / 4, 0), Vector3.new(2.8, 0.1, 0.1), C.Marble, M.Glass, { Name = "Web", Transparency = 0.5 })
	Kit.part(parent, cf * CFrame.new(0.5, -2.0, -0.5) * CFrame.Angles(0, PI / 4, 0), Vector3.new(1.4, 0.1, 0.1), C.Marble, M.Glass, { Name = "Web", Transparency = 0.55 })
end

function Kit.skulls(parent, cf)
	if machineHall() then
		-- (fix round, Gemini: a skull pile is a crypt leftover in a workshop) a riveted toolbox and a dropped spanner
		Kit.part(parent, cf * CFrame.new(0, 0.4, 0) * CFrame.Angles(0, 0.3, 0), Vector3.new(1.6, 0.8, 0.8), C.StoneDark, M.Metal, { Name = "Toolbox" })
		Kit.part(parent, cf * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0.3, 0), Vector3.new(1.0, 0.1, 0.2), C.Gold, M.Metal, { Name = "ToolboxHandle" })
		Kit.part(parent, cf * CFrame.new(-0.9, 0.08, 0.6) * CFrame.Angles(0, 1.1, 0), Vector3.new(1.4, 0.16, 0.3), C.Iron, M.Metal, { Name = "Spanner" })
		return
	end
	Kit.part(parent, cf * CFrame.new(0, 0.45, 0), Vector3.new(0.9, 0.9, 0.9), C.Bone, M.Marble, { Name = "Skull" })
	Kit.part(parent, cf * CFrame.new(1.0, 0.4, 0.5) * CFrame.Angles(0, 0.6, 0.2), Vector3.new(0.8, 0.8, 0.8), C.Bone, M.Marble, { Name = "Skull" })
	Kit.part(parent, cf * CFrame.new(-0.9, 0.2, 0.6) * CFrame.Angles(0, 1.1, 0), Vector3.new(1.8, 0.3, 0.3), C.Bone, M.Marble, { Name = "Bone" })
end

function Kit.rubble(parent, cf, seed)
	local r = rng(seed or 1)
	for i = 1, 3 do
		Kit.part(parent, cf * CFrame.new((r() - 0.5) * 3, 0.3, (r() - 0.5) * 3) * CFrame.Angles(0, r() * PI, 0), Vector3.new(0.8 + r(), 0.6, 0.7 + r() * 0.6), jitter(C.StoneLight, (seed or 1) + i), M.Slate, { Name = "Rubble" })
	end
end

-- a weapon rack ON a wall face (cf on the face, LookVector into the room); bug batch 2 (#3): one invisible collider over
-- the whole rack (wall face to the front of the foot, up past the spear heads), so nobody stands in the spears
function Kit.rack(outer, cf)
	local parent = Mesh.group(outer, "RackSet")
	Kit.part(parent, cf * CFrame.new(0, 2.15, -0.55), Vector3.new(4.2, 4.3, 1.1), C.Wood, M.Wood, { Name = "RackCollider", Collide = true, Transparency = 1 })
	Kit.part(parent, cf * CFrame.new(0, 1.6, -0.15), Vector3.new(4, 3.2, 0.3), C.Wood, M.Wood, { Name = "RackBack" })
	Kit.part(parent, cf * CFrame.new(0, 0.3, -0.4), Vector3.new(4.2, 0.6, 0.8), C.Wood, M.Wood, { Name = "RackFoot" })
	for i = -1, 1 do
		Kit.part(parent, cf * CFrame.new(i * 1.2, 2.0, -0.45), Vector3.new(0.25, 3.4, 0.25), C.Iron, M.Metal, { Name = "Spear" })
		Kit.part(parent, cf * CFrame.new(i * 1.2, 3.8, -0.45), Vector3.new(0.5, 0.9, 0.15), C.Marble, M.Metal, { Name = "SpearHead" })
	end
	return Kit.dress(parent, "dungeon_rack", cf)
end

function Kit.cauldron(outer, cf)
	if machineHall() then
		return Kit.brazier(outer, cf)
	end
	local parent = Mesh.group(outer, "CauldronSet")
	Kit.part(parent, cf * CFrame.new(0, 0.3, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(0.6, 2.4, 2.4), C.Iron, M.Metal, { Name = "CauldronFoot", Shape = Enum.PartType.Cylinder })
	Kit.part(parent, cf * CFrame.new(0, 1.8, 0), Vector3.new(3.2, 3.2, 3.2), C.Iron, M.Metal, { Name = "Cauldron", Shape = Enum.PartType.Ball, Collide = true })
	Kit.part(parent, cf * CFrame.new(0, 3.2, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(0.3, 2.6, 2.6), C.Moss, M.Neon, { Name = "Brew", Shape = Enum.PartType.Cylinder, Accent = true })
	return Kit.dress(parent, "dungeon_cauldron", cf, nil, { "Brew" })
end

-- a wall emblem ON the wall face: a shield with crossed swords (bug #5: a bracket holds it, the plate sits 0.12 out,
-- clear of the courses; it used to float 0.75 stud off the wall). Shared key dungeon_shield (crest = the element)
function Kit.shield(outer, cf)
	local parent = Mesh.group(outer, "ShieldMount")
	Kit.part(parent, cf * CFrame.new(0, 0, -0.27), Vector3.new(2.6, 3.2, 0.3), C.Iron, M.Metal, { Name = "Shield" })
	Kit.part(parent, cf * CFrame.new(0, 0.4, -0.06), Vector3.new(0.8, 0.8, 0.12), C.Iron, M.Metal, { Name = "ShieldBracket" })
	Kit.part(parent, cf * CFrame.new(0, 0, -0.47), Vector3.new(1.6, 2, 0.15), C.Accent, M.Fabric, { Name = "ShieldCrest", Accent = true })
	Kit.part(parent, cf * CFrame.new(0, 0, -0.62) * CFrame.Angles(0, 0, 0.75), Vector3.new(4, 0.25, 0.2), C.Gold, M.Metal, { Name = "Sword" })
	Kit.part(parent, cf * CFrame.new(0, 0, -0.62) * CFrame.Angles(0, 0, -0.75), Vector3.new(4, 0.25, 0.2), C.Gold, M.Metal, { Name = "Sword" })
	return Kit.dress(parent, "dungeon_shield", cf, { Secondary = C.Accent }, nil, nil, true)
end

-- a guardian statue on a plinth; bug batch 2 (#3): an invisible collider from the plinth top past the spear tip (arms,
-- head and spear stick out of the body: standing on the plinth put the player inside them). bug #5: the style key
-- dungeon_<s>_statue (a hooded stone warden (a), a retired weather robot (b), a hedge knight in a planter (c))
function Kit.statue(outer, cf)
	local parent = Mesh.group(outer, "StatueSet")
	Kit.part(parent, cf * CFrame.new(0, 4.2, 0), Vector3.new(3.2, 6, 3.2), C.StoneLight, M.Marble, { Name = "StatueCollider", Collide = true, Transparency = 1 })
	Kit.part(parent, cf * CFrame.new(0, 0.6, 0), Vector3.new(3, 1.2, 3), C.StoneDark, M.Slate, { Name = "StatueBase", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, 3.2, 0), Vector3.new(1.8, 4, 1.4), C.StoneLight, M.Marble, { Name = "StatueBody", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, 5.8, 0), Vector3.new(1.2, 1.2, 1.2), C.StoneLight, M.Marble, { Name = "StatueHead" })
	Kit.part(parent, cf * CFrame.new(-1.3, 3.6, 0), Vector3.new(0.6, 2.6, 0.6), C.StoneLight, M.Marble, { Name = "StatueArm" })
	Kit.part(parent, cf * CFrame.new(1.3, 4.0, -0.4) * CFrame.Angles(0.5, 0, 0), Vector3.new(0.6, 2.6, 0.6), C.StoneLight, M.Marble, { Name = "StatueArm" })
	Kit.part(parent, cf * CFrame.new(1.3, 5.4, -1.2), Vector3.new(0.3, 3.4, 0.3), C.Iron, M.Metal, { Name = "StatueSpear" })
	return Kit.dress(parent, Mesh.skey("statue"), cf, { Secondary = C.Accent }, nil, nil, true)
end

function Kit.candles(outer, cf)
	local parent = Mesh.group(outer, "CandleSet")
	for i = -1, 1 do
		Kit.part(parent, cf * CFrame.new(i * 0.7, 0.35, 0), Vector3.new(0.3, 0.7, 0.3), C.Marble, M.Marble, { Name = "Candle" })
		Kit.part(parent, cf * CFrame.new(i * 0.7, 0.85, 0), Vector3.new(0.25, 0.3, 0.25), C.Flame, M.Neon, { Name = "CandleFlame" })
	end
	return Kit.dress(parent, "dungeon_candles", cf, nil, { "CandleFlame" })
end

-- a chandelier hanging from the ceiling (cf = the ceiling point)
function Kit.chandelier(outer, cf)
	local parent = Mesh.group(outer, "ChandelierSet")
	Kit.part(parent, cf * CFrame.new(0, -2.5, 0), Vector3.new(0.3, 5, 0.3), C.Iron, M.Metal, { Name = "ChandelierChain" })
	Kit.part(parent, cf * CFrame.new(0, -5.2, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(0.4, 5, 5), C.Iron, M.Metal, { Name = "ChandelierRing", Shape = Enum.PartType.Cylinder })
	Kit.part(parent, cf * CFrame.new(0, -5.2, 0) * CFrame.Angles(0, 0, PI / 2), Vector3.new(0.5, 3.6, 3.6), C.StoneDark, M.Metal, { Name = "ChandelierHub", Shape = Enum.PartType.Cylinder })
	for i = 0, 3 do
		local a = i * PI / 2 + PI / 4
		local x, z = math.cos(a) * 2.1, math.sin(a) * 2.1
		Kit.part(parent, cf * CFrame.new(x, -4.6, z), Vector3.new(0.35, 0.8, 0.35), C.Marble, M.Marble, { Name = "Candle" })
		Kit.part(parent, cf * CFrame.new(x, -4.0, z), Vector3.new(0.3, 0.4, 0.3), C.Flame, M.Neon, { Name = "CandleFlame" })
	end
	local light = Instance.new("PointLight")
	light.Name = "ChandelierLight"
	light.Color = C.Light
	light.Brightness = 1.0
	light.Range = 18
	light.Shadows = false
	light.Parent = parent:FindFirstChild("ChandelierHub")
	return Kit.dress(parent, "dungeon_chandelier", cf, nil, { "CandleFlame" })
end

-- a hearth ON a wall face (cf on the face at floor level, LookVector into the room); bug batch 2 (#3): an invisible
-- collider fills the fire opening between the sides (the back, the log and the flame), so nobody walks into the fire
function Kit.hearth(outer, cf)
	local parent = Mesh.group(outer, "HearthSet")
	Kit.part(parent, cf * CFrame.new(0, 2.6, -0.9), Vector3.new(5, 5.2, 1.8), C.Ceiling, M.Slate, { Name = "HearthCollider", Collide = true, Transparency = 1 })
	Kit.part(parent, cf * CFrame.new(-3.2, 2.6, -0.9), Vector3.new(1.4, 5.2, 1.8), C.StoneDark, M.Slate, { Name = "HearthSide", Collide = true })
	Kit.part(parent, cf * CFrame.new(3.2, 2.6, -0.9), Vector3.new(1.4, 5.2, 1.8), C.StoneDark, M.Slate, { Name = "HearthSide", Collide = true })
	Kit.part(parent, cf * CFrame.new(0, 5.6, -0.9), Vector3.new(7.8, 0.8, 2), C.StoneDark, M.Slate, { Name = "Mantle" })
	Kit.part(parent, cf * CFrame.new(0, 2.6, -0.25), Vector3.new(5, 5.2, 0.5), C.Ceiling, M.Slate, { Name = "HearthBack" })
	Kit.part(parent, cf * CFrame.new(0, 0.2, -1.2), Vector3.new(7.8, 0.4, 2.4), C.StoneDark, M.Slate, { Name = "HearthStone" })
	Kit.part(parent, cf * CFrame.new(0, 0.7, -0.9), Vector3.new(2.6, 0.6, 1.2), C.Wood, M.Wood, { Name = "Log" })
	local flame = Kit.part(parent, cf * CFrame.new(0, 1.6, -0.9), Vector3.new(2.2, 1.6, 1), C.Ember, M.Neon, { Name = "HearthFlame" })
	local light = Instance.new("PointLight")
	light.Name = "HearthLight"
	light.Color = C.Light
	light.Brightness = 1.4
	light.Range = 18
	light.Shadows = false
	light.Parent = flame
	return Kit.dress(parent, "dungeon_hearth", cf, nil, { "HearthFlame" })
end

function Kit.rug(outer, cf, w, d)
	local parent = Mesh.group(outer, "RugSet")
	Kit.part(parent, cf * CFrame.new(0, 0.07, 0), Vector3.new(w or 8, 0.14, d or 6), C.Carpet, M.Fabric, { Name = "Rug" })
	Kit.part(parent, cf * CFrame.new(0, 0.15, 0), Vector3.new((w or 8) - 1.6, 0.06, (d or 6) - 1.6), C.Accent, M.Fabric, { Name = "RugInlay", Accent = true })
	return Kit.dress(parent, "dungeon_rug_" .. Mesh.num(w or 8) .. "x" .. Mesh.num(d or 6), cf, { Primary = C.Carpet, Secondary = C.Accent }, nil, nil, true)
end

-- a wine rack ON a wall face (cf on the face, LookVector into the room; bug #5: it stood 0.7 stud off the wall)
function Kit.wineRack(outer, cf)
	if machineHall() then
		-- the curio's pipe stands 1 stud off the face (its box reaches back to the wall)
		return Kit.curio(outer, cf * CFrame.new(0, 0, -1.0))
	end
	local parent = Mesh.group(outer, "WineRackSet")
	Kit.part(parent, cf * CFrame.new(0, 2, -0.9), Vector3.new(5, 4, 1.8), C.Wood, M.Wood, { Name = "WineRack", Collide = true })
	for i = -1, 1 do
		for j = 0, 1 do
			Kit.part(parent, cf * CFrame.new(i * 1.5, 1.1 + j * 1.8, -1.95) * CFrame.Angles(PI / 2, 0, 0), Vector3.new(0.6, 0.6, 0.6), C.Moss, M.Glass, { Name = "Bottle", Shape = Enum.PartType.Cylinder })
		end
	end
	return Kit.dress(parent, "dungeon_winerack", cf)
end

-- bug #5 fix 4: the throne room's own clutter instead of the cellar's hay, barrel, crate and table: a style "curio"
-- (the people who use the place): a journal + a half-melted candle on a lectern (a), a stand-pipe with a red valve
-- wheel, a wrench and a mug (b), a cracked pot, a watering can and a spilled seed packet (c). Parts: a block + two
-- small pieces (the collider is the block)
function Kit.curio(outer, cf)
	local parent = Mesh.group(outer, "CurioSet")
	local s = Style.Cur and Style.Cur.Id or DungeonBuilder.DefaultStyle
	if s == "b" then
		Kit.part(parent, cf * CFrame.new(0, 0.8, 0.6), Vector3.new(2.4, 1.6, 1.6), C.StoneDark, M.Metal, { Name = "CurioBox", Collide = true })
		Kit.part(parent, cf * CFrame.new(-0.6, 2.4, -0.6), Vector3.new(0.6, 4.8, 0.6), C.Gold, M.Metal, { Name = "CurioPipe", Collide = true })
		Kit.part(parent, cf * CFrame.new(-0.6, 3.4, -1.0), Vector3.new(1.8, 1.8, 0.2), rgb(196, 44, 44), M.Metal, { Name = "CurioWheel" })
	elseif s == "a" then
		Kit.part(parent, cf * CFrame.new(0, 1.6, 0), Vector3.new(2.2, 3.2, 1.6), C.Wood, M.Wood, { Name = "CurioBox", Collide = true })
		Kit.part(parent, cf * CFrame.new(0, 3.3, -0.1), Vector3.new(1.8, 0.2, 1.3), C.Marble, M.Fabric, { Name = "CurioBook" })
		Kit.part(parent, cf * CFrame.new(0.7, 3.6, 0.4), Vector3.new(0.35, 0.5, 0.35), C.Marble, M.Marble, { Name = "CurioCandle" })
	else
		Kit.part(parent, cf * CFrame.new(0, 0.8, 0), Vector3.new(1.8, 1.6, 1.8), C.Stone, M.Slate, { Name = "CurioBox", Collide = true })
		Kit.part(parent, cf * CFrame.new(1.7, 0.6, -0.4), Vector3.new(1.4, 1.2, 0.9), rgb(120, 150, 176), M.Metal, { Name = "CurioCan" })
		Kit.part(parent, cf * CFrame.new(-1.0, 0.05, -1.3), Vector3.new(1.6, 0.1, 1.2), C.Moss, M.Fabric, { Name = "CurioSeeds" })
	end
	Kit.sound(parent, "curio_" .. s)
	return Kit.dress(parent, Mesh.skey("curio"), cf)
end

function Kit.chest(outer, cf, slot)
	local parent = Mesh.group(outer, "ChestBox")
	local body = Kit.part(parent, cf * CFrame.new(0, 0.9, 0), Vector3.new(3, 1.8, 2), C.Plank, M.WoodPlanks, { Name = "Chest", Collide = true })
	parent.PrimaryPart = body
	Kit.part(parent, cf * CFrame.new(0, 2.05, 0), Vector3.new(3.1, 0.5, 2.1), C.Wood, M.Wood, { Name = "ChestLid" })
	Kit.part(parent, cf * CFrame.new(0, 1.0, 1.05), Vector3.new(0.6, 0.6, 0.15), C.Gold, M.Metal, { Name = "ChestLock" })
	body:SetAttribute("ChestSlot", slot)
	-- bug batch 2 #14: each member picks ONE chest by walking to it (DungeonService reads the prompt's ChestSlot, checks
	-- the range and turns the prompt off for everyone once taken); 7 studs so the chests 6 apart do not overlap much
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ChestPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = "Pick ONE chest"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 7
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("DungeonAction", "Chest")
	prompt:SetAttribute("ChestSlot", slot)
	prompt.Parent = body
	Mesh.tag(parent, "dungeon_chest", cf)
	return body
end

----------------------------------------------------------------------
-- Template sets. Every template is a Model whose PrimaryPart "Base" sits at the local origin (floor top y 0); the
-- piece heads +Z: Entrance at the -Z edge, Exit at the +Z edge (attachments on Base, like Threshold / Spawn1..4 / Dais).
----------------------------------------------------------------------
local Rooms = {}

local function attach(base, name, pos)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = CFrame.new(pos)
	a.Parent = base
	return a
end

local function newTemplate(name, w, d, entrance, exit)
	local model = Instance.new("Model")
	model.Name = name
	local base = Instance.new("Part")
	base.Name = "Base"
	base.Anchored = true
	base.CanCollide = false
	base.CanQuery = false
	base.CanTouch = false
	base.Transparency = 1
	base.Size = Vector3.new(1, 1, 1)
	base.Material = Enum.Material.SmoothPlastic
	base.CFrame = CFrame.new(0, -1.5, 0)
	base.Parent = model
	model.PrimaryPart = base
	model:SetAttribute("Width", w)
	model:SetAttribute("Depth", d)
	-- attachments carry the piece's local points (relative to the Base part, which stands at the origin)
	attach(base, "Entrance", Vector3.new(entrance.X, 1.5, entrance.Z))
	attach(base, "Exit", Vector3.new(exit.X, 1.5, exit.Z))
	local detail = Instance.new("Model")
	detail.Name = "Detail"
	detail.Parent = model
	CollectionService:AddTag(detail, DETAIL_TAG)
	return model, base, detail
end

-- the four walls (with doorways at the entrance / exit) + corner pillars + torches of a rectangular room
local function roomShell(model, w, d, color, mat, seed, exitX, torches, doorW)
	local hw, hd = w / 2, d / 2
	doorW = doorW or 8
	Kit.wall(model, CFrame.new(0, 0, -hd - 0.5, -1, 0, 0, 0, 1, 0, 0, 0, -1), w + 2, color, mat, seed + 1, { X = 0, Width = doorW })
	Kit.wall(model, CFrame.new(0, 0, hd + 0.5, 1, 0, 0, 0, 1, 0, 0, 0, 1), w + 2, color, mat, seed + 2, { X = exitX or 0, Width = doorW })
	Kit.wall(model, CFrame.new(-hw - 0.5, 0, 0) * CFrame.Angles(0, -PI / 2, 0), d, color, mat, seed + 3)
	Kit.wall(model, CFrame.new(hw + 0.5, 0, 0) * CFrame.Angles(0, PI / 2, 0), d, color, mat, seed + 4)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			Kit.pillar(model, CFrame.new(sx * (hw - 1.4), 0, sz * (hd - 1.4)), WALL_H + 0.5, color)
		end
	end
	-- torches along the side walls every ~12 studs (rule 6) + one each side of the doors
	Kit.cobweb(model, CFrame.new(-hw + 0.5, WALL_H - 0.3, -hd + 0.5))
	Kit.cobweb(model, CFrame.new(hw - 0.5, WALL_H - 0.3, hd - 0.5) * CFrame.Angles(0, PI, 0))
	local n = torches or max(2, floor(d / 12))
	for i = 1, n do
		local z = -hd + (i - 0.5) * (d / n)
		Kit.torch(model, CFrame.new(-hw, 6.5, z) * CFrame.Angles(0, -PI / 2, 0))
		Kit.torch(model, CFrame.new(hw, 6.5, z) * CFrame.Angles(0, PI / 2, 0))
	end
	Kit.torch(model, CFrame.new(-doorW / 2 - 3, 7, -hd) * CFrame.Angles(0, PI, 0))
	Kit.torch(model, CFrame.new(doorW / 2 + 3, 7, -hd) * CFrame.Angles(0, PI, 0))
end

local function roomPoints(base, w, d, exitX)
	local hd = d / 2
	attach(base, "Threshold", Vector3.new(0, 1.5, -hd + 10))
	for i = 1, 4 do
		attach(base, "Spawn" .. i, Vector3.new(-6 + (i - 1) * 4, 1.5, -hd + 4))
	end
	attach(base, "Dais", Vector3.new(exitX or 0, 1.5, hd - 6))
end

-- Hall_1..3: pillared halls with tables, banners, benches and runes (floors Stone Halls, Ember Forge, Star Chapel,
-- Eclipse Sanctum)
function Rooms.Hall(variant)
	local w, d = 48, 48
	local seed = 100 + variant * 17
	local r = rng(seed)
	local model, base, detail = newTemplate("Hall_" .. variant, w, d, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24))
	Kit.floorTiles(model, w, d, C.Flag, M.Cobblestone, seed)
	roomShell(model, w, d, C.Stone, M.Slate, seed, 0, 3)
	Kit.ceiling(model, w, d)
	-- two rows of pillars down the hall
	for _, x in ipairs({ -14, 14 }) do
		for _, z in ipairs({ -10, 4 }) do
			Kit.pillar(model, CFrame.new(x, 0, z), WALL_H, C.StoneLight)
		end
	end
	Kit.rune(detail, CFrame.new(0, 0, 0), 10, 0.6)
	Kit.rune(detail, CFrame.new(0, 0, 0), 0.6, 10)
	for _, x in ipairs({ -20, 20 }) do
		Kit.banner(detail, CFrame.new(x, 11, -24) * CFrame.Angles(0, PI, 0))
		Kit.banner(detail, CFrame.new(x, 11, 24))
	end
	Kit.shield(detail, CFrame.new(0, 9, 24))
	Kit.rack(detail, CFrame.new(24, 0, -6) * CFrame.Angles(0, PI / 2, 0))
	Kit.chandelier(model, CFrame.new(0, CEIL_Y, 0))
	Kit.hearth(model, CFrame.new(24, 0, 10) * CFrame.Angles(0, PI / 2, 0))
	Kit.rug(detail, CFrame.new(0, 0, -14), 10, 7)
	Kit.skulls(detail, CFrame.new(-21, 0, -8))
	Kit.rubble(detail, CFrame.new(12, 0, 20), seed + 7)
	-- bug batch 2 (#25): no table on the door axis (6 studs either side of the doors' centre line stay clear: the smoke
	-- bug2dgn_doorlanes); the candles stand on a table in every variant (they floated in mid-air in Hall_2 / Hall_3)
	if variant == 1 then
		Kit.table(detail, CFrame.new(-18, 0, 14))
		Kit.candles(detail, CFrame.new(-18, 2.5, 14))
		Kit.bench(detail, CFrame.new(-18, 0, 11.4))
		Kit.crate(detail, CFrame.new(20, 0, -18))
		Kit.crate(detail, CFrame.new(20, 2.4, -18), 1.8)
		Kit.barrel(detail, CFrame.new(17.5, 0, -17.5))
		Kit.hay(detail, CFrame.new(20, 0, 16))
		Kit.puddle(detail, CFrame.new(6, 0, -14), 5, 3.5)
		Kit.rack(detail, CFrame.new(-24, 0, 6) * CFrame.Angles(0, -PI / 2, 0))
	elseif variant == 2 then
		Kit.table(detail, CFrame.new(18, 0, -12))
		Kit.table(detail, CFrame.new(18, 0, 16))
		Kit.candles(detail, CFrame.new(18, 2.5, 16))
		Kit.bench(detail, CFrame.new(18, 0, 13.4))
		Kit.crate(detail, CFrame.new(-20, 0, 18), 2.8)
		Kit.crate(detail, CFrame.new(-20, 0, 15), 1.8)
		Kit.moss(detail, CFrame.new(-10, 0, 20), 4, 2.6)
		Kit.bones(detail, CFrame.new(10, 0, -19))
	else
		Kit.barrel(detail, CFrame.new(-20, 0, -18))
		Kit.barrel(detail, CFrame.new(-20, 0, -15.4))
		Kit.crate(detail, CFrame.new(20, 0, 18))
		Kit.puddle(detail, CFrame.new(-8, 0, 12), 4, 4)
		Kit.chain(detail, CFrame.new(-23.3, 11, 0))
		Kit.chain(detail, CFrame.new(23.3, 11, 6))
		Kit.table(detail, CFrame.new(-18, 0, 14)) -- was (0, 0, 19): right in front of the exit door (#25)
		Kit.candles(detail, CFrame.new(-18, 2.5, 14))
	end
	-- a loose stone or two
	for _ = 1, 2 do
		Kit.part(detail, CFrame.new(-16 + r() * 32, 0.3, -16 + r() * 32), Vector3.new(1.2, 0.6, 1), C.StoneLight, M.Slate, { Name = "Rubble" })
	end
	roomPoints(base, w, d, 0)
	return model
end

-- Cellar_1..3: brick cellars with barrels, crates, hay, chains and a cell (Mossy Cellar, Frozen Crypt)
function Rooms.Cellar(variant)
	local w, d = 48, 48
	local seed = 200 + variant * 23
	local r = rng(seed)
	local model, base, detail = newTemplate("Cellar_" .. variant, w, d, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24))
	Kit.floorTiles(model, w, d, C.FlagDark, M.Cobblestone, seed)
	roomShell(model, w, d, C.Brick, M.Brick, seed, 0, 3)
	Kit.ceiling(model, w, d)
	-- beams across the ceiling, a wine rack
	Kit.part(model, CFrame.new(0, CEIL_Y - 0.6, -8), Vector3.new(w, 1.2, 1.6), C.Wood, M.Wood, { Name = "Beam" })
	Kit.part(model, CFrame.new(0, CEIL_Y - 0.6, 8), Vector3.new(w, 1.2, 1.6), C.Wood, M.Wood, { Name = "Beam" })
	Kit.wineRack(detail, CFrame.new(24, 0, 12) * CFrame.Angles(0, PI / 2, 0))
	-- a cell in one corner: bars on two sides (bug batch 2, #3: the bars collide, 0.9-stud gaps: nobody walks into the cell)
	local cx, cz = 16, -14
	for i = 0, 5 do
		Kit.part(detail, CFrame.new(cx - 6 + i * 1.2, 4, cz + 6), Vector3.new(0.3, 8, 0.3), C.Iron, M.Metal, { Name = "CellBar", Collide = true })
		Kit.part(detail, CFrame.new(cx - 6, 4, cz + i * 1.2), Vector3.new(0.3, 8, 0.3), C.Iron, M.Metal, { Name = "CellBar", Collide = true })
	end
	Kit.part(detail, CFrame.new(cx - 3, 8.1, cz + 3), Vector3.new(6.6, 0.3, 6.6), C.Iron, M.Metal, { Name = "CellRail" })
	Kit.hay(detail, CFrame.new(cx + 0.5, 0, cz - 2))
	Kit.bones(detail, CFrame.new(cx - 2, 0, cz + 1))
	Kit.chain(detail, CFrame.new(cx + 3, 10, cz - 7.6))
	for i = 1, 3 do
		Kit.barrel(detail, CFrame.new(-20 + (i - 1) * 2.6, 0, 19))
	end
	Kit.crate(detail, CFrame.new(-19, 0, -19), 2.6)
	Kit.crate(detail, CFrame.new(-16, 0, -19.5), 1.8)
	Kit.crate(detail, CFrame.new(-19, 2.6, -19), 1.8)
	Kit.moss(detail, CFrame.new(-10, 0, 20), 4, 2.4)
	Kit.moss(detail, CFrame.new(21, 0, 8), 2.4, 5)
	Kit.puddle(detail, CFrame.new(-6 + r() * 12, 0, -6 + r() * 8), 5, 4)
	Kit.cauldron(detail, CFrame.new(-19, 0, 8))
	Kit.skulls(detail, CFrame.new(-16, 0, 11))
	Kit.rubble(detail, CFrame.new(8, 0, -20), seed + 3)
	Kit.rack(detail, CFrame.new(-24, 0, -6) * CFrame.Angles(0, -PI / 2, 0))
	Kit.candles(detail, CFrame.new(-19, 0, 0))
	if variant == 2 then
		-- bug batch 2 (#25): the table + bench moved off the exit door's axis (they stood at x 0, z 20 / 17.4, 4 studs
		-- in front of the doorway) to the free corner between the wine rack and the exit wall
		Kit.table(detail, CFrame.new(14, 0, 18))
		Kit.bench(detail, CFrame.new(14, 0, 15.4))
		Kit.chain(detail, CFrame.new(-23.3, 11, 8))
	elseif variant == 3 then
		Kit.hay(detail, CFrame.new(18, 0, 18))
		Kit.hay(detail, CFrame.new(20, 0, 15))
		Kit.barrel(detail, CFrame.new(-20, 0, 0))
		Kit.puddle(detail, CFrame.new(8, 0, 14), 3.6, 3)
	else
		Kit.bones(detail, CFrame.new(-4, 0, 18))
		Kit.crate(detail, CFrame.new(19, 0, 19))
	end
	roomPoints(base, w, d, 0)
	return model
end

-- Cave_1..3: rough rock walls, stalagmites, a turquoise pool and a waterfall wall (Flooded Vaults, Shadow Keep, Magma Mines)
function Rooms.Cave(variant)
	local w, d = 48, 48
	local seed = 300 + variant * 29
	local r = rng(seed)
	local model, base, detail = newTemplate("Cave_" .. variant, w, d, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24))
	Kit.floorTiles(model, w, d, C.FlagDark, M.Slate, seed)
	roomShell(model, w, d, C.Rock, M.Slate, seed, 0, 2)
	Kit.ceiling(model, w, d)
	-- rock bulges along every wall (the cave read), boulders on the floor
	for i = 1, 7 do
		local z = -21 + (i - 1) * 7
		Kit.rock(model, CFrame.new(-23.5 + 0.8 * r(), 3 + r() * 6, z), Vector3.new(3 + r() * 2.5, 6 + r() * 5, 6 + r() * 2), seed + i)
		Kit.rock(model, CFrame.new(23.5 - 0.8 * r(), 3 + r() * 6, z + 3), Vector3.new(3 + r() * 2.5, 6 + r() * 5, 6 + r() * 2), seed + i + 20)
	end
	for i = 1, 4 do
		local x = -18 + (i - 1) * 12
		if abs(x) > 6 then
			Kit.rock(model, CFrame.new(x, 3 + r() * 5, -23.5 + 0.8 * r()), Vector3.new(6 + r() * 2, 6 + r() * 4, 3 + r() * 2), seed + i + 40)
		end
		-- bug batch 2 (#25): the exit wall's bulges at x -3 / 9 stood in (or beside) the doorway; they slide sideways until
		-- their tilted box clears the door lane (6 studs either side of the centre line); same r() calls, so the rest is unchanged
		local ry, rz = 3 + r() * 5, 23.5 - 0.8 * r()
		local size = Vector3.new(6 + r() * 2, 6 + r() * 4, 3 + r() * 2)
		local ex = x + 3
		local clear = 6.5 + size.X / 2 + 2 -- + the random tilt of Kit.rock
		if abs(ex) < clear then
			ex = (ex < 0) and -clear or clear
		end
		Kit.rock(model, CFrame.new(ex, ry, rz), size, seed + i + 60)
	end
	-- (#25) a stalagmite drawn on the exit's door lane (z > 10: its turned 2.6 base reaches z 12) steps out of it to the
	-- side away from the pool (x -8 clears the lane); they are drawn at z -8..18, never on the entrance lane
	local function offLane(x, z)
		if abs(x) < 8 and z > 10 then
			return -8
		end
		return x
	end
	for i = 1, 7 do
		local sx, sz = -18 + r() * 36, -8 + r() * 26
		Kit.stalagmite(detail, CFrame.new(offLane(sx, sz), 0, sz), 2.5 + r() * 2.5)
	end
	Kit.rock(detail, CFrame.new(-14, 1.2, -6), Vector3.new(3.5, 2.4, 3), seed + 81)
	Kit.rock(detail, CFrame.new(8, 0.9, -16), Vector3.new(2.6, 1.8, 2.2), seed + 82)
	Kit.rubble(detail, CFrame.new(-6, 0, 4), seed + 83)
	Kit.skulls(detail, CFrame.new(18, 0, -18))
	-- the pool in the far corner, a rim of stones and the waterfall wall over it (bug batch 2: the rim stones collide,
	-- a 1.2 step like the wall plinth; the pool sits 1 stud further from the exit door so its rim keeps off the door lane)
	local px, pz = 16, 15
	Kit.part(model, CFrame.new(px, 0.1, pz), Vector3.new(14, 0.2, 12), C.Water, M.Glass, { Name = "Pool", Transparency = 0.3 })
	for i = 1, 6 do
		local ang = (i / 6) * PI * 2
		Kit.part(model, CFrame.new(px + math.cos(ang) * 7.9, 0.6, pz + math.sin(ang) * 7.4) * CFrame.Angles(0, -ang, 0), Vector3.new(3.2, 1.2, 2), jitter(C.RockDark, seed + i), M.Slate, { Name = "PoolRim", Collide = true })
	end
	Kit.part(model, CFrame.new(px + 4, 7, 23.2), Vector3.new(6, 13, 0.6), C.Water, M.Glass, { Name = "Waterfall", Transparency = 0.45 })
	for i = 1, 3 do
		Kit.part(model, CFrame.new(px + 2 + i * 1.2, 7 + (i % 2), 22.8), Vector3.new(0.3, 10, 0.3), C.WaterGlow, M.Neon, { Name = "WaterStreak", Accent = true })
	end
	Kit.puddle(detail, CFrame.new(px - 10, 0, pz + 2), 4, 3)
	Kit.moss(detail, CFrame.new(-16, 0, -16), 5, 3)
	Kit.moss(detail, CFrame.new(-20, 0, 10), 3, 5)
	Kit.bones(detail, CFrame.new(-10, 0, 16))
	if variant == 2 then
		Kit.crate(detail, CFrame.new(-20, 0, 18))
		Kit.stalagmite(detail, CFrame.new(-9, 0, -12), 4) -- was x -6: its base reached into the entrance lane (#25)
	elseif variant == 3 then
		Kit.rock(detail, CFrame.new(-12, 1.5, 4), Vector3.new(4, 3, 3), seed + 90)
		Kit.hay(detail, CFrame.new(20, 0, -16))
	end
	roomPoints(base, w, d, 0)
	return model
end

-- Bridge_1..2: a stone causeway over a dark chasm (an invisible floor below), rope rails and lamp posts (Thunder Spire,
-- Howling Peak)
function Rooms.Bridge(variant)
	local w, d = 48, 48
	local seed = 400 + variant * 31
	local model, base, detail = newTemplate("Bridge_" .. variant, w, d, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24))
	-- the causeway floor (44 wide: the zone), the abyss plane and the invisible safety floor
	Kit.floorTiles(model, 44, d, C.Flag, M.Cobblestone, seed)
	Kit.part(model, CFrame.new(0, -7, 0), Vector3.new(w + 2, 0.4, d + 2), C.Abyss, M.Slate, { Name = "Abyss", Transparency = 0.35 })
	Kit.part(model, CFrame.new(0, -6.5, 0), Vector3.new(w + 2, 0.5, d + 2), C.Abyss, M.Slate, { Name = "SafetyFloor", Transparency = 1, Collide = true })
	-- the edge kerbs (rule 3) + posts with rope rails
	for _, sx in ipairs({ -1, 1 }) do
		Kit.part(model, CFrame.new(sx * 22.2, 0.2, 0), Vector3.new(0.6, 0.4, d), C.StoneDark, M.Slate, { Name = "Kerb", Collide = true })
		Kit.part(model, CFrame.new(sx * 22.2, -1.2, 0), Vector3.new(1, 2.4, d), C.StoneDark, M.Slate, { Name = "Edge" })
		for i = 0, 4 do
			local z = -22 + i * 11
			Kit.part(model, CFrame.new(sx * 22.2, 1.6, z), Vector3.new(0.6, 3.2, 0.6), C.Wood, M.Wood, { Name = "Post", Collide = true })
		end
		Kit.part(model, CFrame.new(sx * 22.2, 2.9, 0), Vector3.new(0.25, 0.25, d - 2), C.Iron, M.Metal, { Name = "Rail" })
		Kit.part(model, CFrame.new(sx * 22.2, 1.9, 0), Vector3.new(0.25, 0.25, d - 2), C.Iron, M.Metal, { Name = "Rail" })
	end
	-- the end walls with doors + lamp posts (the sides are open to the chasm; the ceiling still closes the room)
	Kit.wall(model, CFrame.new(0, 0, -24.5, -1, 0, 0, 0, 1, 0, 0, 0, -1), w + 2, C.Stone, M.Slate, seed + 1, { X = 0, Width = 8 })
	Kit.wall(model, CFrame.new(0, 0, 24.5, 1, 0, 0, 0, 1, 0, 0, 0, 1), w + 2, C.Stone, M.Slate, seed + 2, { X = 0, Width = 8 })
	Kit.ceiling(model, w, d)
	for _, sx in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -12, 12 }) do
			Kit.part(model, CFrame.new(sx * 20.5, 2.5, z), Vector3.new(0.6, 5, 0.6), C.Iron, M.Metal, { Name = "LampPost", Collide = true })
			local lamp = Kit.part(model, CFrame.new(sx * 20.5, 5.4, z), Vector3.new(1, 1, 1), C.Flame, M.Neon, { Name = "Lamp" })
			local light = Instance.new("PointLight")
			light.Name = "LampLight"
			light.Color = C.Light
			light.Brightness = 1.2
			light.Range = 18
			light.Shadows = false
			light.Parent = lamp
		end
	end
	Kit.torch(model, CFrame.new(-7, 7, -24) * CFrame.Angles(0, PI, 0))
	Kit.torch(model, CFrame.new(7, 7, -24) * CFrame.Angles(0, PI, 0))
	Kit.skulls(detail, CFrame.new(-16, 0, -10))
	Kit.rubble(detail, CFrame.new(10, 0, 16), seed + 5)
	-- a few plank patches and a broken crate
	for i = 1, 3 do
		Kit.part(detail, CFrame.new(-12 + i * 6, 0.1, -4 + i * 3), Vector3.new(4.5, 0.2, 2.6), C.Plank, M.WoodPlanks, { Name = "Plank" })
	end
	Kit.crate(detail, CFrame.new(-18, 0, 18), 2.2)
	if variant == 2 then
		Kit.chain(detail, CFrame.new(-20.8, 12, -20))
		Kit.chain(detail, CFrame.new(20.8, 12, 20))
		Kit.rune(detail, CFrame.new(0, 0, 0), 8, 0.6)
	else
		Kit.bones(detail, CFrame.new(14, 0, -14))
		Kit.puddle(detail, CFrame.new(-8, 0, 10), 4, 3)
	end
	roomPoints(base, w, d, 0)
	return model
end

-- Throne_1: the boss room (every floor's room 4): three arches, a long carpet, two braziers, stairs to a dais and the
-- throne; the exit (to the treasure alcove) is a door beside the dais
function Rooms.Throne(variant)
	local w, d = 60, 72
	local seed = 500 + variant * 37
	local exitX = 20
	local model, base, detail = newTemplate("Throne_" .. variant, w, d, Vector3.new(0, 0, -36), Vector3.new(exitX, 0, 36))
	Kit.floorTiles(model, w, d, C.Flag, M.Cobblestone, seed)
	roomShell(model, w, d, C.Stone, M.Slate, seed, exitX, 4, 8)
	Kit.ceiling(model, w, d)
	-- three arches across the room
	for _, z in ipairs({ -20, 4 }) do
		Kit.pillar(model, CFrame.new(-19, 0, z), WALL_H, C.StoneLight)
		Kit.pillar(model, CFrame.new(19, 0, z), WALL_H, C.StoneLight)
	end
	-- the carpet runner (bug #5: the style key dungeon_<s>_carpet: a navy runner with brass edges and chevrons (b), a red
	-- carpet with a gold border (a), a terracotta herringbone path (c); its edge stripe = the floor's element colour. The
	-- two long lime Neon edge runes are gone: the screenshot's harsh green lines)
	local carpet = Mesh.group(model, "CarpetRun")
	Kit.part(carpet, CFrame.new(0, 0.1, -4), Vector3.new(8, 0.2, 56), C.Carpet, M.Fabric, { Name = "Carpet" })
	Kit.dress(carpet, Mesh.skey("carpet"), CFrame.new(0, 0, -4), { Primary = C.Carpet, Secondary = C.Accent }, nil, nil, true)
	-- the dais with stairs (one style key dungeon_<s>_dais, baked from these Parts), the throne and two braziers
	local daisZ = 28
	local dais = Mesh.group(model, "DaisSet")
	Kit.part(dais, CFrame.new(0, 1.2, daisZ), Vector3.new(24, 2.4, 14), C.StoneLight, M.Slate, { Name = "Dais", Collide = true })
	Kit.part(dais, CFrame.new(0, 2.5, daisZ), Vector3.new(6, 0.2, 10), C.Carpet, M.Fabric, { Name = "DaisCarpet" })
	Kit.part(dais, CFrame.new(0, 2.6, daisZ - 7.2), Vector3.new(24, 0.4, 0.6), C.StoneDark, M.Slate, { Name = "DaisKerb" })
	Kit.stairs(dais, CFrame.new(0, 0, daisZ - 7 - 4.8), 10, 3, 0.8)
	Kit.dress(dais, Mesh.skey("dais"), CFrame.new(0, 0, daisZ), { Secondary = C.Accent }, nil, nil, true)
	-- the throne (bug #5: the style key dungeon_<s>_throne: a carved granite throne with a red cushion and a cloud crest
	-- (a), the guild master's iron and brass chair with a copper lightning rod (b), a hollow stump with a moss cushion and
	-- a crown of leaves (c)); the Parts are its collider and fallback
	local tz = daisZ + 3
	local style = Style.Cur and Style.Cur.Id or DungeonBuilder.DefaultStyle
	local throne = Mesh.group(model, "ThroneSet")
	Kit.part(throne, CFrame.new(0, 3.4, tz), Vector3.new(3.4, 2, 2.4), C.StoneDark, M.Slate, { Name = "ThroneSeat", Collide = true })
	Kit.part(throne, CFrame.new(0, 6.2, tz + 1), Vector3.new(3.4, 7.6, 0.6), C.StoneDark, M.Slate, { Name = "ThroneBack", Collide = true })
	Kit.part(throne, CFrame.new(-1.7, 4.6, tz), Vector3.new(0.4, 2.4, 2.4), C.StoneDark, M.Slate, { Name = "ThroneArm", Collide = true })
	Kit.part(throne, CFrame.new(1.7, 4.6, tz), Vector3.new(0.4, 2.4, 2.4), C.StoneDark, M.Slate, { Name = "ThroneArm", Collide = true })
	if style == "b" then
		Kit.part(throne, CFrame.new(0, 10.35, tz + 1), Vector3.new(0.25, 0.7, 0.25), C.Gold, M.Metal, { Name = "LightningRod" })
	else
		Kit.part(throne, CFrame.new(0, 10.4, tz + 1), Vector3.new(1.6, 1, 0.5), C.Gold, M.Metal, { Name = "ThroneCrown" })
	end
	Kit.part(throne, CFrame.new(0, 4.6, tz - 0.2), Vector3.new(2.6, 0.5, 2), C.Carpet, M.Fabric, { Name = "ThroneCushion" })
	Kit.dress(throne, Mesh.skey("throne"), CFrame.new(0, 2.4, tz), { Secondary = C.Accent }, nil, nil, true)
	if style == "b" then
		-- the weather astrolabe over the chair: a captured storm cloud (a Neon cyan heart inside a puff mesh) in three
		-- brass gimbal rings that turn slowly (DungeonFx spins the NC_DungeonSpin parts about their local Y; each ring's
		-- plane holds its spin axis, so they sweep nested spheres: 2.4 / 2.0 / 1.6 studs, the rod tip at 2.2 sits between)
		-- (the review: at 13.2 the outer ring's mesh reached 15.7 under the 15.8 ceiling; at 12.9 it clears it by 0.4, and
		-- the rod tip (10.7, the throne key) stays 2.2 below the hub, between the outer and middle rings' spheres)
		local hub = CFrame.new(0, ASTRO_HUB_Y, tz + 1)
		local heart = Kit.part(model, hub, Vector3.new(0.9, 0.9, 0.9), C.Core, M.Neon, { Name = "CloudHeart" })
		local glow = Instance.new("PointLight")
		glow.Name = "CloudLight"
		glow.Color = C.CoreLight
		glow.Brightness = 1.2
		glow.Range = 16
		glow.Shadows = false
		glow.Parent = heart
		Kit.sound(heart, "astrolabe")
		local cloud = Kit.part(model, hub, Vector3.new(2.2, 1.6, 2.2), C.Marble, M.Slate, { Name = "StormCloud" })
		Mesh.tag(cloud, "dungeon_b_cloud", hub, nil, nil)
		local rings = {
			{ R = 2.4, Rot = CFrame.new(), Speed = 0.35 },
			{ R = 2.0, Rot = CFrame.Angles(0, 0, -PI / 2), Speed = -0.5 },
			{ R = 1.6, Rot = CFrame.Angles(PI / 2, 0, 0), Speed = 0.65 },
		}
		for i, rg in ipairs(rings) do
			local cf = hub * rg.Rot
			local ring = Kit.part(model, cf, Vector3.new(rg.R * 2, 0.3, 0.3), C.Gold, M.Metal, { Name = "AstroRing" })
			ring:SetAttribute("SpinSpeed", rg.Speed)
			ring:SetAttribute("SpinIndex", i)
			ring:SetAttribute("ML_Weld", true) -- the uploaded ring mesh rides the Part DungeonFx turns (client-side)
			CollectionService:AddTag(ring, "NC_DungeonSpin")
			Mesh.tag(ring, "dungeon_b_ring", cf, nil, nil, rg.R / 2.4)
		end
	end
	Kit.brazier(model, CFrame.new(-8, 2.4, daisZ - 2))
	Kit.brazier(model, CFrame.new(8, 2.4, daisZ - 2))
	-- two arches spanning the aisle, guardian statues by the stairs, skull piles, candles
	Kit.arch(model, CFrame.new(0, 0, -20), 10, 12.5)
	Kit.arch(model, CFrame.new(0, 0, -2), 10, 12.5)
	Kit.statue(model, CFrame.new(-9, 0, 14))
	Kit.statue(model, CFrame.new(9, 0, 14))
	Kit.skulls(detail, CFrame.new(-26, 0, -12))
	Kit.candles(detail, CFrame.new(-6, 2.4, daisZ + 5))
	Kit.candles(detail, CFrame.new(6, 2.4, daisZ + 5))
	if style == "a" then
		-- the Undercroft's round sky window behind the throne (it lights the far end: the far arch used to read navy-black)
		local win = Kit.part(model, CFrame.new(0, 10.6, 35.9), Vector3.new(7, 7, 0.2), rgb(176, 214, 255), M.Slate, { Name = "SkyWindow" })
		local sky = Instance.new("PointLight")
		sky.Name = "SkyLight"
		sky.Color = rgb(186, 214, 255)
		sky.Brightness = 0.9
		sky.Range = 26
		sky.Shadows = false
		sky.Parent = win
		Mesh.tag(win, "dungeon_a_window", CFrame.new(0, 10.6, 36), nil, nil)
	else
		Kit.shield(detail, CFrame.new(0, 10, 36))
	end
	Kit.rubble(detail, CFrame.new(-20, 0, 4), seed + 9)
	-- banners on the side walls BETWEEN the torches (bug #5 fix 1: they hung at z -10 / 6, and the torch at z -9 burned
	-- through the cloth; roomShell's 4 torches stand at z -27, -9, 9, 27), chains from the ceiling, the bones
	for _, x in ipairs({ -30, 30 }) do
		Kit.banner(detail, CFrame.new(x, 12, 0) * CFrame.Angles(0, x < 0 and -PI / 2 or PI / 2, 0))
		Kit.banner(detail, CFrame.new(x, 12, 18) * CFrame.Angles(0, x < 0 and -PI / 2 or PI / 2, 0))
	end
	Kit.chain(detail, CFrame.new(-29.3, 12, -26))
	Kit.chain(detail, CFrame.new(29.3, 12, 24))
	Kit.bones(detail, CFrame.new(-24, 0, -30))
	-- bug #5 fix 4: the hay, barrel, crates, table, puddles and moss square of the cellar are gone; the throne room has
	-- its own two curios (the people who keep it) in the far-left and near-right corners, off both door lanes
	Kit.curio(detail, CFrame.new(-25, 0, 31) * CFrame.Angles(0, -PI / 2, 0))
	Kit.curio(detail, CFrame.new(25, 0, -30) * CFrame.Angles(0, PI / 2, 0))
	-- points: the zone covers the WHOLE room (56 x 72 on the 60 x 72 floor: the dais, the throne and the back strip are
	-- inside it, so a member who climbs the stairs is never dropped out of the fight); the enemies spawn at the foot of
	-- the dais stairs (SpawnAnchor), not on the throne
	attach(base, "Threshold", Vector3.new(0, 1.5, -26))
	for i = 1, 4 do
		attach(base, "Spawn" .. i, Vector3.new(-6 + (i - 1) * 4, 1.5, -32))
	end
	attach(base, "Dais", Vector3.new(0, 1.5, daisZ))
	attach(base, "ZoneCenter", Vector3.new(0, 1.5, 0))
	attach(base, "SpawnAnchor", Vector3.new(0, 1.5, 15))
	return model
end

-- Entrance_1: the hall where a run starts (the pads Spawn1..4, a stair down to the first corridor's door)
function Rooms.Entrance()
	local w, d = 28, 24
	local seed = 600
	local model, base, detail = newTemplate("Entrance_1", w, d, Vector3.new(0, 0, -12), Vector3.new(0, 0, 12))
	Kit.floorTiles(model, w, d, C.Flag, M.Cobblestone, seed)
	Kit.wall(model, CFrame.new(0, 0, -12.5, -1, 0, 0, 0, 1, 0, 0, 0, -1), w + 2, C.Stone, M.Slate, seed + 1)
	Kit.wall(model, CFrame.new(0, 0, 12.5, 1, 0, 0, 0, 1, 0, 0, 0, 1), w + 2, C.Stone, M.Slate, seed + 2, { X = 0, Width = 8 })
	Kit.wall(model, CFrame.new(-14.5, 0, 0) * CFrame.Angles(0, -PI / 2, 0), d, C.Stone, M.Slate, seed + 3)
	Kit.wall(model, CFrame.new(14.5, 0, 0) * CFrame.Angles(0, PI / 2, 0), d, C.Stone, M.Slate, seed + 4)
	Kit.ceiling(model, w, d)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.pillar(model, CFrame.new(sx * 12.6, 0, -10.6), WALL_H + 0.5, C.Stone)
		Kit.pillar(model, CFrame.new(sx * 12.6, 0, 10.6), WALL_H + 0.5, C.Stone)
		Kit.torch(model, CFrame.new(sx * 14, 6.5, 1) * CFrame.Angles(0, sx * PI / 2, 0))
	end
	Kit.torch(model, CFrame.new(-7, 7, 12))
	Kit.torch(model, CFrame.new(7, 7, 12))
	-- four spawn pads (Marble inlays) and the banner wall
	for i = 1, 4 do
		local x = -7.5 + (i - 1) * 5
		Kit.part(model, CFrame.new(x, 0.1, -4), Vector3.new(3.6, 0.2, 3.6), C.Marble, M.Marble, { Name = "Pad" })
		attach(base, "Spawn" .. i, Vector3.new(x, 1.5, -4))
	end
	Kit.banner(detail, CFrame.new(-6, 11, -12) * CFrame.Angles(0, PI, 0))
	Kit.banner(detail, CFrame.new(6, 11, -12) * CFrame.Angles(0, PI, 0))
	Kit.barrel(detail, CFrame.new(-11, 0, 9))
	Kit.crate(detail, CFrame.new(11, 0, 9), 2.2)
	Kit.moss(detail, CFrame.new(10, 0, -9), 3, 2.4)
	Kit.puddle(detail, CFrame.new(-9, 0, 2), 3.6, 3)
	attach(base, "Threshold", Vector3.new(0, 1.5, 6))
	attach(base, "Dais", Vector3.new(0, 1.5, 8))
	return model
end

-- Corridor_Straight / Left / Right: 10-wide, 15-long passages (Left / Right jog JOG studs sideways: the seeded path)
function Rooms.Corridor(kind)
	local jog = (kind == "Left") and -JOG or ((kind == "Right") and JOG or 0)
	local seed = 700 + (jog + 20)
	local model, base, detail = newTemplate("Corridor_" .. kind, 10 + abs(jog), 15, Vector3.new(0, 0, -7.5), Vector3.new(jog, 0, 7.5))
	-- floor tiles (5 studs): the entry column, the cross row, the exit column
	local function tile(x, z)
		Kit.part(model, CFrame.new(x, -0.5 + (((x + z) / 5) % 2 == 0 and 0.05 or -0.05), z), Vector3.new(5, 1, 5), jitter(C.FlagDark, seed + x * 3 + z), M.Cobblestone, { Name = "Floor", Collide = true })
	end
	if jog == 0 then
		for _, x in ipairs({ -2.5, 2.5 }) do
			for _, z in ipairs({ -5, 0, 5 }) do
				tile(x, z)
			end
		end
		for _, sx in ipairs({ -1, 1 }) do
			Kit.wall(model, CFrame.new(sx * 5.5, 0, 0) * CFrame.Angles(0, sx * PI / 2, 0), 15, C.Stone, M.Slate, seed + sx, nil, true)
		end
		Kit.ceiling(model, 10, 15)
		Kit.torch(model, CFrame.new(-5, 6.5, 0) * CFrame.Angles(0, -PI / 2, 0))
		Kit.torch(model, CFrame.new(5, 6.5, 0) * CFrame.Angles(0, PI / 2, 0))
	else
		local s = jog > 0 and 1 or -1
		-- entry column (z -7.5..-2.5), cross row (z -2.5..2.5), exit column (z 2.5..7.5)
		tile(-2.5, -5)
		tile(2.5, -5)
		for i = 0, 4 do
			tile(s * (-2.5 + i * 5), 0)
		end
		tile(jog - 2.5, 5)
		tile(jog + 2.5, 5)
		-- walls around the jog (LookVector into the walkway): entry outer / inner, the cross row's two sides, exit inner / outer
		Kit.wall(model, CFrame.new(-s * 5.5, 0, -2.5) * CFrame.Angles(0, -s * PI / 2, 0), 10, C.Stone, M.Slate, seed + 1, nil, true)
		Kit.wall(model, CFrame.new(s * 5.5, 0, -5) * CFrame.Angles(0, s * PI / 2, 0), 5, C.Stone, M.Slate, seed + 2, nil, true)
		Kit.wall(model, CFrame.new(s * 12.5, 0, -3) * CFrame.Angles(0, PI, 0), 15, C.Stone, M.Slate, seed + 3, nil, true)
		Kit.wall(model, CFrame.new(s * 2.5, 0, 3), 15, C.Stone, M.Slate, seed + 4, nil, true)
		Kit.wall(model, CFrame.new(jog + s * 5.5, 0, 2.5) * CFrame.Angles(0, s * PI / 2, 0), 10, C.Stone, M.Slate, seed + 5, nil, true)
		Kit.wall(model, CFrame.new(jog - s * 5.5, 0, 5) * CFrame.Angles(0, -s * PI / 2, 0), 5, C.Stone, M.Slate, seed + 6, nil, true)
		Kit.ceiling(model, 10 + abs(jog), 15)
		Kit.torch(model, CFrame.new(s * 5, 6.5, -5) * CFrame.Angles(0, s * PI / 2, 0))
		Kit.torch(model, CFrame.new(jog - s * 5, 6.5, 5) * CFrame.Angles(0, -s * PI / 2, 0))
	end
	Kit.puddle(detail, CFrame.new(jog / 2, 0, 0), 3, 2.4)
	if jog == 0 then
		Kit.chain(detail, CFrame.new(-4.6, 11, 4))
		Kit.moss(detail, CFrame.new(0, 0, 5.5), 2.4, 1.8)
	end
	return model
end

-- Treasure_1: the alcove after the boss: four chests, the exit portal "Back to the plaza"
function Rooms.Treasure()
	local w, d = 28, 22
	local seed = 800
	local model, base, detail = newTemplate("Treasure_1", w, d, Vector3.new(0, 0, -11), Vector3.new(0, 0, 11))
	Kit.floorTiles(model, w, d, C.Flag, M.Cobblestone, seed)
	Kit.wall(model, CFrame.new(0, 0, -11.5, -1, 0, 0, 0, 1, 0, 0, 0, -1), w + 2, C.Stone, M.Slate, seed + 1, { X = 0, Width = 8 }, true)
	Kit.wall(model, CFrame.new(0, 0, 11.5, 1, 0, 0, 0, 1, 0, 0, 0, 1), w + 2, C.Stone, M.Slate, seed + 2, nil, true)
	Kit.wall(model, CFrame.new(-14.5, 0, 0) * CFrame.Angles(0, -PI / 2, 0), d, C.Stone, M.Slate, seed + 3, nil, true)
	Kit.wall(model, CFrame.new(14.5, 0, 0) * CFrame.Angles(0, PI / 2, 0), d, C.Stone, M.Slate, seed + 4, nil, true)
	Kit.ceiling(model, w, d)
	Kit.torch(model, CFrame.new(-14, 6.5, 0) * CFrame.Angles(0, -PI / 2, 0))
	Kit.torch(model, CFrame.new(14, 6.5, 0) * CFrame.Angles(0, PI / 2, 0))
	local chests = DungeonBuilder.CHEST_COUNT
	for i = 1, chests do
		local x = (i - (chests + 1) / 2) * 6
		Kit.chest(model, CFrame.new(x, 0, 3), i)
		attach(base, "Chest" .. i, Vector3.new(x, 1.5, 3))
	end
	Kit.rune(detail, CFrame.new(0, 0, -3), 20, 0.5)
	-- the exit portal: a Marble arch with a purple shimmer and the prompt part
	Kit.arch(model, CFrame.new(0, 0, 9.4), 6, 9)
	Kit.part(model, CFrame.new(0, 4.2, 9.4), Vector3.new(5.6, 8, 0.15), C.Accent, M.ForceField, { Name = "ExitShimmer", Transparency = 0.4 })
	local exitPart = Kit.part(model, CFrame.new(0, 3, 7.4), Vector3.new(1, 1, 1), C.Stone, M.Slate, { Name = "ExitPrompt", Transparency = 1 })
	exitPart:SetAttribute("DungeonAction", "Exit")
	local exitPrompt = Instance.new("ProximityPrompt")
	exitPrompt.Name = "ExitPrompt"
	exitPrompt.ActionText = "Leave"
	exitPrompt.ObjectText = "Back to the plaza"
	exitPrompt.KeyboardKeyCode = Enum.KeyCode.E
	exitPrompt.HoldDuration = 0
	exitPrompt.MaxActivationDistance = 10
	exitPrompt.RequiresLineOfSight = false
	exitPrompt:SetAttribute("DungeonAction", "Exit")
	exitPrompt.Parent = exitPart
	Kit.banner(detail, CFrame.new(-10, 11, 11))
	Kit.banner(detail, CFrame.new(10, 11, 11))
	Kit.skulls(detail, CFrame.new(-12, 0, -8))
	for i = 1, 4 do
		attach(base, "Spawn" .. i, Vector3.new(-6 + (i - 1) * 4, 1.5, -7))
	end
	attach(base, "Threshold", Vector3.new(0, 1.5, -6))
	attach(base, "Dais", Vector3.new(0, 1.5, 8))
	return model
end

----------------------------------------------------------------------
-- Template registry (geometry known without building: the layout plans a run before any set exists)
----------------------------------------------------------------------
local Geo = {} -- name -> { W, D, Entrance = Vector3, Exit = Vector3, Kind, Budget, build = fn }
local function geo(name, w, d, entrance, exit, kind, budget, build)
	Geo[name] = { Name = name, W = w, D = d, Entrance = entrance, Exit = exit, Kind = kind, Budget = budget, build = build }
end
for v = 1, 3 do
	geo("Hall_" .. v, 48, 48, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24), "Room", 320, function() return Rooms.Hall(v) end)
	geo("Cellar_" .. v, 48, 48, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24), "Room", 320, function() return Rooms.Cellar(v) end)
	geo("Cave_" .. v, 48, 48, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24), "Room", 320, function() return Rooms.Cave(v) end)
end
for v = 1, 2 do
	geo("Bridge_" .. v, 48, 48, Vector3.new(0, 0, -24), Vector3.new(0, 0, 24), "Room", 320, function() return Rooms.Bridge(v) end)
end
geo("Throne_1", 60, 72, Vector3.new(0, 0, -36), Vector3.new(20, 0, 36), "Boss", 420, function() return Rooms.Throne(1) end)
geo("Entrance_1", 28, 24, Vector3.new(0, 0, -12), Vector3.new(0, 0, 12), "Hall", 140, function() return Rooms.Entrance() end)
geo("Corridor_Straight", 10, 15, Vector3.new(0, 0, -7.5), Vector3.new(0, 0, 7.5), "Corridor", 70, function() return Rooms.Corridor("Straight") end)
geo("Corridor_Left", 25, 15, Vector3.new(0, 0, -7.5), Vector3.new(-JOG, 0, 7.5), "Corridor", 70, function() return Rooms.Corridor("Left") end)
geo("Corridor_Right", 25, 15, Vector3.new(0, 0, -7.5), Vector3.new(JOG, 0, 7.5), "Corridor", 70, function() return Rooms.Corridor("Right") end)
geo("Treasure_1", 28, 22, Vector3.new(0, 0, -11), Vector3.new(0, 0, 11), "Treasure", 90, function() return Rooms.Treasure() end)

DungeonBuilder.Geo = Geo

local function templateFolder()
	local f = ServerStorage:FindFirstChild(TEMPLATE_FOLDER)
	if not f then
		f = Instance.new("Folder")
		f.Name = TEMPLATE_FOLDER
		f.Parent = ServerStorage
	end
	return f
end

function DungeonBuilder.CountParts(inst)
	local n = 0
	if typeof(inst) ~= "Instance" then
		return 0
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

-- the template of a style (built now when missing, ~0.1 s). bug #5: one set per style (the same layout and colliders,
-- the style's colours, keys and style props); style = DefaultStyle when nil. The models keep the plain names
-- (Hall_1 ...) with a Style attribute, so the set of every style lives side by side in DungeonTemplates.
local TplCache = {}
function DungeonBuilder.Template(name, style)
	local g = Geo[name]
	if not g then
		return nil
	end
	style = DungeonBuilder.Styles[style or ""] and style or DungeonBuilder.DefaultStyle
	local f = templateFolder()
	TplCache[style] = TplCache[style] or {}
	local existing = TplCache[style][name]
	if existing and existing.Parent == f then
		return existing
	end
	local prev = Style.Cur
	Style.Cur = DungeonBuilder.Styles[style]
	local ok, model = pcall(g.build)
	Style.Cur = prev
	if not ok then
		error(model, 0)
	end
	model:SetAttribute("Kind", g.Kind)
	model:SetAttribute("Budget", g.Budget)
	model:SetAttribute("Style", style)
	model.Parent = f
	TplCache[style][name] = model
	return model
end

-- every template of `style` (DefaultStyle when nil; "all" = every style)
function DungeonBuilder.EnsureTemplates(style)
	local styles = (style == "all") and DungeonBuilder.StyleOrder or { style or DungeonBuilder.DefaultStyle }
	for _, s in ipairs(styles) do
		for _, name in ipairs(DungeonBuilder.Templates) do
			DungeonBuilder.Template(name, s)
		end
	end
	return templateFolder()
end

----------------------------------------------------------------------
-- The portal (C4: built with WorldStyle.BuildGate into the Gate Court)
----------------------------------------------------------------------
local State = { Info = nil, Pockets = {}, Built = false }

-- (quick wins, review round 1) the party cap the gate's "up to N friends" is built from: DungeonService.MAX_PARTY (a
-- party is the player + N friends). Read at build time, when Main.server has already loaded DungeonService (no require
-- loop: DungeonService never requires this module); 4 when it cannot be read.
function DungeonBuilder.PartyMax()
	local inst = script.Parent and script.Parent:FindFirstChild("DungeonService")
	local ok, svc = pcall(function()
		return inst and require(inst) or nil
	end)
	local n = ok and type(svc) == "table" and tonumber(svc.MAX_PARTY) or nil
	return (n and n >= 2 and n < 100) and floor(n) or 4
end

function DungeonBuilder.BuildPortal(gatesFolder, siteCFrame)
	if typeof(siteCFrame) ~= "CFrame" then
		siteCFrame = CFrame.new(Config.Lobby.Origin + Vector3.new(0, 0, 118), Config.Lobby.Origin)
	end
	local model, pad, promptPart = WorldStyle.BuildGate(gatesFolder, siteCFrame, {
		Id = "Dungeon",
		Title = "The Dungeon",
		Info = "Rooms, waves and a boss. Solo or up to " .. tostring(DungeonBuilder.PartyMax() - 1) .. " friends",
		Pill = "Floors cleared here: -",
		Color = "Purple",
		Glyph = "torch",
		Pad = true,
	})
	-- two torches on the front faces of the hoop's stone pillars (P6 A1: the P4 hoop gate), facing the plaza
	local look = siteCFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local site = CFrame.lookAt(siteCFrame.Position, siteCFrame.Position + flat.Unit)
	for _, sx in ipairs({ -1, 1 }) do
		local mount = site * CFrame.new(sx * 9.9, 4.2, -1.5)
		local flame = Kit.torch(model, mount, 1.2)
		local light = flame:FindFirstChild("TorchLight")
		if light then
			light.Range = 16 -- the lobby rule (6.4 rule 7)
			light.Color = C.Light
		end
	end
	model:SetAttribute("DungeonBoard", "")
	-- the prompt (handled by ArenaController's onPromptTriggered next to "Ring": OpenPanel = "Dungeon")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "DungeonPrompt"
	prompt.ActionText = "Enter"
	prompt.ObjectText = "The Dungeon"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenPanel", "Dungeon")
	prompt.Parent = promptPart
	-- the return point: on the pad, looking at the plaza
	local padCf = pad and pad.CFrame or (site * CFrame.new(0, 1, -14))
	local returnCf = CFrame.new(padCf.Position + Vector3.new(0, 3.5, 0) + flat.Unit * -2, padCf.Position + Vector3.new(0, 3.5, 0) + flat.Unit * -30)
	local info = { Portal = model, Pad = pad, PromptPart = promptPart, Prompt = prompt, ReturnCFrame = returnCf, Site = site }
	State.Info = info
	return info
end

-- Build(lobbyInfo) -> DungeonInfo: the gate now, the template sets in the background
function DungeonBuilder.Build(lobbyInfo)
	lobbyInfo = type(lobbyInfo) == "table" and lobbyInfo or {}
	local gates = lobbyInfo.GatesFolder
	if not gates then
		local lobby = workspace:FindFirstChild("NimbusLobby")
		gates = lobby and lobby:FindFirstChild("Gates")
		if not gates then
			gates = Instance.new("Folder")
			gates.Name = "Gates"
			gates.Parent = lobby or workspace
		end
	end
	local site = lobbyInfo.GateSites and lobbyInfo.GateSites.Dungeon or lobbyInfo.DungeonSite
	local info = DungeonBuilder.BuildPortal(gates, site)
	info.TemplateFolder = templateFolder()
	if not State.Built then
		State.Built = true
		task.spawn(function()
			-- bug #5: every style's set (floors 1-3, 4-8 and 9-12 each use their own), one template per task.wait()
			for _, style in ipairs(DungeonBuilder.StyleOrder) do
				for _, name in ipairs(DungeonBuilder.Templates) do
					local ok, err = pcall(DungeonBuilder.Template, name, style)
					if not ok then
						warn("[DungeonBuilder] template " .. name .. " (" .. style .. ") failed: " .. tostring(err))
					end
					task.wait()
				end
			end
		end)
	end
	return info
end

function DungeonBuilder.GetInfo()
	return State.Info
end

----------------------------------------------------------------------
-- Runs
----------------------------------------------------------------------
local function dungeonsFolder(create)
	local f = workspace:FindFirstChild(DUNGEONS_FOLDER)
	if not f and create then
		f = Instance.new("Folder")
		f.Name = DUNGEONS_FOLDER
		f.Parent = workspace
	end
	return f
end

local function elementColor(element)
	local ok, PetCatalog = pcall(require, Shared:FindFirstChild("PetCatalog"))
	if ok and type(PetCatalog) == "table" and type(PetCatalog.Elements) == "table" and PetCatalog.Elements[element] and typeof(PetCatalog.Elements[element].Color) == "Color3" then
		return PetCatalog.Elements[element].Color
	end
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	if info and typeof(info.Color) == "Color3" then
		return info.Color
	end
	return C.Accent
end

local function floorDef(floorIndex)
	local ok, BattleCatalog = pcall(require, Shared:FindFirstChild("BattleCatalog"))
	local list = ok and type(BattleCatalog) == "table" and BattleCatalog.DungeonFloors or nil
	local def = type(list) == "table" and list[floorIndex] or nil
	if type(def) ~= "table" then
		def = { Name = "Floor " .. tostring(floorIndex), Element = "Earth", Kind = "Hall" }
	end
	return def
end

-- the seeded chain of a run: piece names + their placement CFrames (pocket-local, heading +Z from the origin)
local Layout = {}

function Layout.plan(floorIndex, seed)
	local def = floorDef(floorIndex)
	local kind = DungeonBuilder.Kinds[def.Kind] and def.Kind or "Hall"
	local variants = DungeonBuilder.Kinds[kind]
	local r = rng((seed or 1) * 7 + floorIndex * 131)
	local names = { "Entrance_1" }
	local x = 0
	local function corridor()
		local pick = r(3)
		local name = "Corridor_Straight"
		if pick == 2 and x - JOG >= -60 then
			name = "Corridor_Left"
		elseif pick == 3 and x + JOG <= 60 then
			name = "Corridor_Right"
		end
		x = x + Geo[name].Exit.X
		names[#names + 1] = name
	end
	for room = 1, 3 do
		corridor()
		names[#names + 1] = kind .. "_" .. r(variants)
	end
	corridor()
	names[#names + 1] = "Throne_1"
	corridor()
	names[#names + 1] = "Treasure_1"
	-- placements: each piece's Entrance lands on the previous piece's Exit (same heading)
	local pieces = {}
	local cursor = CFrame.new(0, 0, 0) -- the current piece's origin
	for i, name in ipairs(names) do
		local g = Geo[name]
		if i == 1 then
			cursor = CFrame.new(-g.Entrance.X, 0, -g.Entrance.Z)
		else
			local prev = pieces[i - 1]
			local exitWorld = prev.CFrame * CFrame.new(Geo[prev.Name].Exit)
			cursor = exitWorld * CFrame.new(-g.Entrance.X, 0, -g.Entrance.Z)
		end
		pieces[i] = { Name = name, CFrame = cursor, Kind = g.Kind, W = g.W, D = g.D }
	end
	-- rooms by index: 0 = hall, 1..4 fight rooms, 5 the treasure; corridor k leads into room k
	local rooms = {}
	rooms[0] = { Piece = 1 }
	local roomIndex = 0
	for i = 2, #pieces, 2 do
		roomIndex = roomIndex + 1
		rooms[roomIndex] = { Piece = i + 1, Corridor = i }
	end
	return { Floor = floorIndex, Seed = seed, Def = def, Kind = kind, Pieces = pieces, Rooms = rooms, Style = DungeonBuilder.StyleFor(floorIndex) }
end

function DungeonBuilder.Plan(floorIndex, seed)
	return Layout.plan(floorIndex, seed)
end

-- the world-space bounding box of a planned piece (for the overlap test)
function DungeonBuilder.PieceBox(pocket, pieceIndex)
	local piece = pocket.Layout.Pieces[pieceIndex]
	if not piece then
		return nil
	end
	local cf = CFrame.new(pocket.Origin) * piece.CFrame
	local p = cf.Position
	return { MinX = p.X - piece.W / 2, MaxX = p.X + piece.W / 2, MinZ = p.Z - piece.D / 2, MaxZ = p.Z + piece.D / 2, Name = piece.Name }
end

local function recolourAccents(model, color)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Accent") == true then
			d.Color = color
			n = n + 1
		end
	end
	return n
end

-- bug #5: the floor's own look on a placed piece (before it is parented): the style's per-floor depth (colours x
-- Deepen; the lights are NOT dimmed, the review's readability cap), the element colour on every dressed key's Secondary
-- tint (DG_Element: banners, stripes, grates, crests), the Accent parts recoloured
local NO_DEEPEN = { [Enum.Material.Neon] = true, [Enum.Material.Glass] = true, [Enum.Material.ForceField] = true }
local function lerpColor(a, f)
	return Color3.new(a.R * f, a.G * f, a.B * f)
end
local function dressFloor(model, pocket)
	local color = elementColor(pocket.Layout.Def.Element)
	local style = DungeonBuilder.Styles[pocket.Style or ""]
	local depth = DungeonBuilder.StyleDepth(pocket.Floor)
	local f = 1 - (1 - (style and style.Deepen or 1)) * depth
	recolourAccents(model, color)
	local list = model:GetDescendants()
	list[#list + 1] = model
	for _, d in ipairs(list) do
		if d:IsA("BasePart") then
			if f < 1 and not NO_DEEPEN[d.Material] and d:GetAttribute("Accent") ~= true then
				d.Color = lerpColor(d.Color, f)
			end
		end
		if d:GetAttribute("DG_Element") == true then
			d:SetAttribute("ML_Secondary", color)
		end
		local primary = d:GetAttribute("ML_Primary")
		if f < 1 and typeof(primary) == "Color3" then
			d:SetAttribute("ML_Primary", lerpColor(primary, f))
		end
	end
	return color
end

-- bug #5: the element weathering of a floor (blender keys dungeon_wx_<element>_high / _low: Nature moss and ferns, Earth
-- crystals and rubble, Water drip stains and puddles, Frost icicles and rime, Flame soot and ember cracks, Storm scorch
-- marks and a spark coil, Celestial star-moss, Shadow dark crystals). Two hang under the cornice of the entrance / exit
-- walls beside the doors, two sit at the foot of the side walls; a spot is skipped when a prop already stands there.
-- The anchors are invisible (a flat stand-in would bring back the pasted squares the pitch removed): the clusters show
-- once their keys are uploaded.
DungeonBuilder.WeatherKeys = {
	Nature = "nature", Earth = "earth", Water = "water", Frost = "frost", Flame = "flame", Storm = "storm", Celestial = "celestial", Shadow = "shadow",
}
-- the review (bug batch 2 #3 rule "no visible prop a player can stand inside"): the _low sets that stand taller than
-- the 1.1-stud step out on the floor get a collider over their footprint (spot space: x along the wall, z into the room
-- is negative, y up from the floor; from blender/kit/props/dungeon_props.py wx()). Shadow: crystals up to 1.9 studs;
-- Nature: fern fronds up to 1.3. The others stay under 1.1 on the floor (Earth crystals 1.05, Frost ice blocks 0.6,
-- Celestial star 0.95, Flame coals, Storm coil, Water drips: their taller bits sit on the plinth or the wall face).
DungeonBuilder.WeatherLowSolid = {
	Shadow = { X0 = -1.75, X1 = 1.85, Y1 = 2.0, Z0 = -2.0, Z1 = -0.5 },
	Nature = { X0 = -2.25, X1 = 1.95, Y1 = 1.35, Z0 = -2.05, Z1 = -0.5 },
}
local WEATHER_SKIP = { Floor = true, Wall = true, Plinth = true, Cap = true, Course = true, Dado = true, Brick = true, Ceiling = true, Crack = true, Base = true, Weather = true }
local function weatherSpots(g)
	local hw, hd = g.W / 2, g.D / 2
	local x = min(11, hw - 4)
	local spots = {}
	spots[#spots + 1] = { High = true, CF = CFrame.new(-x, WALL_H - 0.2, -hd) * CFrame.Angles(0, PI, 0) }
	spots[#spots + 1] = { High = true, CF = CFrame.new(x, WALL_H - 0.2, hd) }
	spots[#spots + 1] = { High = true, CF = CFrame.new(x, WALL_H - 0.2, -hd) * CFrame.Angles(0, PI, 0) }
	spots[#spots + 1] = { High = true, CF = CFrame.new(-x, WALL_H - 0.2, hd) }
	if g.Name and string.sub(g.Name, 1, 6) == "Bridge" then
		spots[#spots + 1] = { CF = CFrame.new(x, 0, -hd) * CFrame.Angles(0, PI, 0) }
		spots[#spots + 1] = { CF = CFrame.new(-x, 0, hd) }
	else
		for _, z in ipairs({ -0.4, 0.15, -0.1, 0.4 }) do
			spots[#spots + 1] = { CF = CFrame.new(-hw, 0, z * g.D) * CFrame.Angles(0, -PI / 2, 0) }
			spots[#spots + 1] = { CF = CFrame.new(hw, 0, -z * g.D) * CFrame.Angles(0, PI / 2, 0) }
		end
	end
	return spots
end

local function placeWeather(holder, model, element, g)
	local name = DungeonBuilder.WeatherKeys[element]
	local base = model.PrimaryPart
	if not name or not base or not g then
		return 0
	end
	local room = base.CFrame * CFrame.new(0, 1.5, 0)
	local inv = room:Inverse()
	-- the room-space boxes of what already stands in the room (walls, floor, ceiling and big slabs left out)
	local boxes = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not WEATHER_SKIP[d.Name] then
			local s = d.Size
			if max(s.X, s.Y, s.Z) < 20 then
				local cf = inv * d.CFrame
				local r = { cf:GetComponents() }
				local ex = abs(r[4]) * s.X / 2 + abs(r[5]) * s.Y / 2 + abs(r[6]) * s.Z / 2
				local ey = abs(r[7]) * s.X / 2 + abs(r[8]) * s.Y / 2 + abs(r[9]) * s.Z / 2
				local ez = abs(r[10]) * s.X / 2 + abs(r[11]) * s.Y / 2 + abs(r[12]) * s.Z / 2
				boxes[#boxes + 1] = { cf.X - ex, cf.Y - ey, cf.Z - ez, cf.X + ex, cf.Y + ey, cf.Z + ez }
			end
		end
	end
	local placed, high, low = 0, 0, 0
	for _, spot in ipairs(weatherSpots(g)) do
		if (spot.High and high < 2) or (not spot.High and low < 2) then
			-- the cluster's room-space box: 4.6 wide, under the cornice 3 tall x 1.2 deep, at the wall foot 2.6 x 2.6
			local c = spot.CF * CFrame.new(0, spot.High and -1.5 or 1.3, spot.High and -0.6 or -1.3)
			local hx, hy, hz = 2.3, spot.High and 1.5 or 1.3, spot.High and 0.6 or 1.3
			local r = { c:GetComponents() }
			local ex = abs(r[4]) * hx + abs(r[5]) * hy + abs(r[6]) * hz
			local ez = abs(r[10]) * hx + abs(r[11]) * hy + abs(r[12]) * hz
			local a = { c.X - ex, c.Y - hy, c.Z - ez, c.X + ex, c.Y + hy, c.Z + ez }
			local free = true
			for _, b in ipairs(boxes) do
				if a[1] < b[4] and b[1] < a[4] and a[2] < b[5] and b[2] < a[5] and a[3] < b[6] and b[3] < a[6] then
					free = false
					break
				end
			end
			if free then
				local at = room * spot.CF
				local solid = (not spot.High) and DungeonBuilder.WeatherLowSolid[element] or nil
				local anchor
				if solid then
					-- the anchor IS the collider (invisible, colliding, queryable) over the cluster's footprint
					anchor = Kit.part(holder, at * CFrame.new((solid.X0 + solid.X1) / 2, solid.Y1 / 2, (solid.Z0 + solid.Z1) / 2),
						Vector3.new(solid.X1 - solid.X0, solid.Y1, solid.Z1 - solid.Z0), elementColor(element), M.Slate, { Name = "Weather", Transparency = 1, Collide = true })
				else
					anchor = Kit.part(holder, at * CFrame.new(0, spot.High and -1.5 or 0.5, spot.High and -0.3 or -1), Vector3.new(4.4, 1, 0.6), elementColor(element), M.Slate, { Name = "Weather", Transparency = 1 })
				end
				anchor:SetAttribute("Element", element)
				Kit.sound(anchor, "weather_" .. element)
				local key = "dungeon_wx_" .. name .. (spot.High and "_high" or "_low")
				Mesh.tag(anchor, key, at, nil, nil)
				placed = placed + 1
				if spot.High then
					high = high + 1
				else
					low = low + 1
				end
				boxes[#boxes + 1] = a
			end
		end
	end
	return placed
end
DungeonBuilder._PlaceWeather = placeWeather
DungeonBuilder.AstroHubY = ASTRO_HUB_Y
DungeonBuilder._KitFns = Kit -- TESTS / RENDERS ONLY (tools, blender renders: doors + weathering on a bare template)
DungeonBuilder._ElementColor = function(e)
	return elementColor(e)
end

local function worldPoint(model, name)
	local base = model.PrimaryPart
	local a = base and base:FindFirstChild(name)
	if a then
		return base.CFrame * a.CFrame
	end
	return nil
end

-- clones the template of a piece and places it in pocket space (not parented yet)
-- wave 6: the piece's camera box for DungeonController's camera clamp (attributes CamMin / CamMax, world space; pieces
-- never rotate). The hall, the rooms and the treasure: the W x D shell; a corridor: its floor tiles (a Left / Right
-- corridor's walkway is not centred on its origin). From 2 studs under the floor top up to the lowest Ceiling part's
-- bottom (CEIL_Y without one).
local function camBox(copy, piece, cf)
	local o = cf.Position
	local minX, maxX, minZ, maxZ = o.X - piece.W / 2, o.X + piece.W / 2, o.Z - piece.D / 2, o.Z + piece.D / 2
	local detail = copy:FindFirstChild("Detail")
	local ceil = nil
	local fx0, fx1, fz0, fz1 = math.huge, -math.huge, math.huge, -math.huge
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("BasePart") and not (detail and d:IsDescendantOf(detail)) then
			if d.Name == "Ceiling" then
				local bottom = d.Position.Y - d.Size.Y / 2
				ceil = ceil and min(ceil, bottom) or bottom
			elseif d.Name == "Floor" and piece.Kind == "Corridor" then
				local p, s = d.Position, d.Size
				fx0, fx1 = min(fx0, p.X - s.X / 2), max(fx1, p.X + s.X / 2)
				fz0, fz1 = min(fz0, p.Z - s.Z / 2), max(fz1, p.Z + s.Z / 2)
			end
		end
	end
	if fx0 < fx1 then
		minX, maxX, minZ, maxZ = fx0, fx1, fz0, fz1
	end
	copy:SetAttribute("CamMin", Vector3.new(minX, o.Y - 2, minZ))
	copy:SetAttribute("CamMax", Vector3.new(maxX, ceil or (o.Y + CEIL_Y), maxZ))
end

local function clonePiece(pocket, pieceIndex, holder)
	local piece = pocket.Layout.Pieces[pieceIndex]
	local template = DungeonBuilder.Template(piece.Name, pocket.Style or pocket.Layout.Style)
	if not template then
		return nil
	end
	local copy = template:Clone()
	copy:SetAttribute("PieceIndex", pieceIndex)
	local cf = CFrame.new(pocket.Origin) * piece.CFrame
	-- the template's Base stands at its local origin: every part moves by the same delta
	local base = copy.PrimaryPart or copy:FindFirstChild("Base")
	local delta = base and (cf * base.CFrame) * base.CFrame:Inverse() or cf
	for _, d in ipairs(copy:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = delta * d.CFrame
		end
	end
	camBox(copy, piece, cf)
	copy.Parent = holder
	return copy
end

-- the zone part of a fight room: Mode "Dungeon", ZoneId "Room", Index (pocket), Room. `floorCf` is the room's floor
-- centre (the floor top, y 0 of the template): the 16-stud part stands 6 studs above it (presence box floor -2..+14) and
-- FloorY is the floor top itself (dungeon-fixes root cause B: the encounter centre is RoomInfo.ZoneFloor, never the part)
local function makeZone(model, pocket, room, size, floorCf)
	local zone = Instance.new("Part")
	zone.Name = "NC_BattleZone"
	zone.Anchored = true
	zone.CanCollide = false
	zone.CanQuery = false
	zone.CanTouch = false
	zone.Transparency = 1
	zone.Material = Enum.Material.SmoothPlastic
	zone.CastShadow = false
	zone.Size = Vector3.new(size.X, 16, size.Z)
	zone.CFrame = floorCf * CFrame.new(0, 6, 0)
	zone:SetAttribute("Mode", "Dungeon")
	zone:SetAttribute("ZoneId", "Room")
	zone:SetAttribute("Index", pocket.Index)
	zone:SetAttribute("Room", room)
	zone:SetAttribute("Size", size.X)
	zone:SetAttribute("FloorY", floorCf.Position.Y)
	CollectionService:AddTag(zone, ZONE_TAG)
	zone.Parent = model
	return zone
end

-- PlaceRoom(pocket, room) -> RoomInfo: room 1..4 (the fight rooms) or 5 (the treasure alcove); the inbound corridor
-- comes with it. Assembled under ServerStorage, parented in ONE step.
function DungeonBuilder.PlaceRoom(pocket, room)
	if type(pocket) ~= "table" or not pocket.Layout or not pocket.Layout.Rooms[room] then
		return nil, "BadRoom"
	end
	if pocket.Rooms[room] then
		return pocket.Rooms[room]
	end
	local entry = pocket.Layout.Rooms[room]
	if not pocket.Model or pocket.Model.Parent == nil then
		return nil, "Freed"
	end
	local staging = Instance.new("Model")
	staging.Name = "Room_" .. room
	staging.Parent = templateFolder() -- assembled out of the workspace
	local corridor = entry.Corridor and clonePiece(pocket, entry.Corridor, staging) or nil
	local model = clonePiece(pocket, entry.Piece, staging)
	if not model then
		staging:Destroy()
		return nil, "NoTemplate"
	end
	local piece = pocket.Layout.Pieces[entry.Piece]
	-- bug #5: the doors and the weathering are built in the run's style (its colours and keys). The styled section runs
	-- in a pcall so Style.Cur is restored on an error too (else every later Kit call outside Template() would build in
	-- this run's style)
	local prevStyle = Style.Cur
	Style.Cur = DungeonBuilder.Styles[pocket.Style or ""] or Style.Cur
	local info
	local okStyled, styledErr = pcall(function()
	-- floor 1 is the brightest (no abyss): every torch a little stronger
	if pocket.Floor == 1 then
		for _, d in ipairs(staging:GetDescendants()) do
			if d:IsA("PointLight") then
				d.Brightness = min(1.5, d.Brightness + 0.3)
			elseif d.Name == "Abyss" and d:IsA("BasePart") then
				d.Transparency = 1
			end
		end
	end
	info = {
		Index = room,
		Kind = piece.Kind,
		Template = piece.Name,
		Model = staging,
		Room = model,
		Corridor = corridor,
		Spawns = {},
		Chests = {},
	}
	local entranceCf = worldPoint(model, "Entrance")
	local exitCf = worldPoint(model, "Exit")
	local center = model.PrimaryPart.CFrame * CFrame.new(0, 1.5, 0)
	info.Center = center.Position
	info.Entrance = entranceCf and (entranceCf * CFrame.new(0, 3, 3)) or center
	for i = 1, 4 do
		local sp = worldPoint(model, "Spawn" .. i)
		info.Spawns[i] = sp and (sp * CFrame.new(0, 3, 0)) or info.Entrance
	end
	local thresholdCf = worldPoint(model, "Threshold")
	if thresholdCf then
		local th = Instance.new("Part")
		th.Name = "Threshold"
		th.Anchored = true
		th.CanCollide = false
		th.CanQuery = false
		th.CanTouch = false
		th.Transparency = 1
		th.Material = Enum.Material.SmoothPlastic
		th.CastShadow = false
		th.Size = Vector3.new(12, 8, 4)
		th.CFrame = thresholdCf * CFrame.new(0, 2.5, 0)
		th:SetAttribute("Room", room)
		th.Parent = staging
		info.Threshold = th
	end
	if piece.Kind == "Room" or piece.Kind == "Boss" then
		local size = piece.Kind == "Boss" and Vector3.new(BOSS_ZONE.X, 0, BOSS_ZONE.Z) or Vector3.new(ROOM_ZONE.X, 0, ROOM_ZONE.Z)
		-- the floor centre: the ZoneCenter attachment or the room's centre, both ON the floor top (attachments sit at
		-- template y 0); the old fallback took the centre 1.5 studs BELOW the floor (FloorY 1.5 low, enemies ~4.5 up)
		local zc = worldPoint(model, "ZoneCenter")
		local floorCf = CFrame.new(zc and zc.Position or center.Position)
		info.ZoneFloor = floorCf
		info.Zone = makeZone(staging, pocket, room, size, floorCf)
		-- the enemies' spawn point in zone-local x / z when the template names one (DungeonService passes it to SpawnWave)
		local sa = worldPoint(model, "SpawnAnchor")
		if sa then
			local rel = info.Zone.CFrame:PointToObjectSpace(sa.Position)
			info.SpawnAnchor = { x = rel.X, z = rel.Z }
		end
		-- the two portcullis doors: Entrance (CLOSED until the group enters the room after everyone pressed E at it:
		-- DungeonService opens it in Dg.enterRoom, closes it again when the fight starts) and Exit (opens after the clear).
		-- The entrance's EnterPrompt stands on the corridor side; the boss room's exit carries the one to the treasure
		-- (the alcove has no door of its own), on the room side
		if entranceCf then
			local door, bars = Kit.door(staging, CFrame.new(entranceCf.Position - Vector3.new(0, 1.5, 0)) * CFrame.new(0, 0, 0), "Door_Entrance", 8)
			info.Door = { Model = door, Bars = bars }
			Kit.setDoor(door, false)
			info.EnterPrompt, info.EnterPoint = Kit.enterPrompt(staging, entranceCf * CFrame.new(0, 3, -2.5), enterLabel(room), room)
		end
		if exitCf then
			local door, bars = Kit.door(staging, CFrame.new(exitCf.Position - Vector3.new(0, 1.5, 0)), "Door_Exit", 8)
			info.ExitDoor = { Model = door, Bars = bars }
			Kit.setDoor(door, false)
			if piece.Kind == "Boss" then
				info.NextPrompt, info.NextPoint = Kit.enterPrompt(staging, exitCf * CFrame.new(0, 3, -2.5), enterLabel(room + 1), room + 1)
			end
		end
		staging:SetAttribute("DoorOpen", false)
		staging:SetAttribute("EntranceOpen", false)
	else
		for i = 1, 4 do
			local c = worldPoint(model, "Chest" .. i)
			if c then
				for _, d in ipairs(model:GetDescendants()) do
					if d.Name == "Chest" and d:GetAttribute("ChestSlot") == i then
						info.Chests[i] = d
					end
				end
			end
		end
		for _, d in ipairs(model:GetDescendants()) do
			if d.Name == "ExitPrompt" then
				info.ExitPrompt = d
			end
		end
	end
	-- bug #5: the floor's element weathering in the room (not the treasure alcove), then the floor's look on everything
	if piece.Kind == "Room" or piece.Kind == "Boss" then
		placeWeather(staging, model, pocket.Layout.Def.Element, Geo[piece.Name])
	end
	dressFloor(staging, pocket)
	end)
	Style.Cur = prevStyle
	if not okStyled then
		staging:Destroy()
		error(styledErr, 0)
	end
	staging:SetAttribute("Room", room)
	staging:SetAttribute("Floor", pocket.Floor)
	staging:SetAttribute("Element", pocket.Layout.Def.Element)
	staging:SetAttribute("Style", pocket.Style)
	-- one replication burst
	staging.Parent = pocket.Model
	pocket.Rooms[room] = info
	return info
end

function DungeonBuilder.SetDoor(info, which, open)
	if type(info) ~= "table" then
		return
	end
	local door = (which == "Exit") and info.ExitDoor or info.Door
	if door and door.Model then
		Kit.setDoor(door.Model, open == true)
	end
	if info.Model then
		info.Model:SetAttribute(which == "Exit" and "DoorOpen" or "EntranceOpen", open == true)
	end
end

function DungeonBuilder.RemoveRoom(pocket, room)
	if type(pocket) ~= "table" or not pocket.Rooms then
		return false
	end
	local info = pocket.Rooms[room]
	if not info then
		return false
	end
	pocket.Rooms[room] = nil
	if info.Model then
		info.Model:Destroy()
	end
	return true
end

function DungeonBuilder.PocketOrigin(index)
	local i = max(1, floor(index or 1)) - 1
	local col, row = i % 4, floor(i / 4)
	return Vector3.new(9000 + col * 600, 160, 9000 + row * 600)
end

-- BuildRun(index, floor, seed) -> Pocket: the holder, the hall (room 0), the corridor to room 1 and room 1
function DungeonBuilder.BuildRun(index, floorIndex, seed)
	index = floor(tonumber(index) or 1)
	if index < 1 or index > MAX_INDEX then
		return nil, "BadIndex"
	end
	if State.Pockets[index] then
		return nil, "Busy"
	end
	floorIndex = max(1, min(12, floor(tonumber(floorIndex) or 1)))
	seed = floor(tonumber(seed) or 1)
	local folder = dungeonsFolder(true)
	local holder = Instance.new("Model")
	holder.Name = "Dungeon_" .. index
	holder:SetAttribute("Index", index)
	holder:SetAttribute("Floor", floorIndex)
	holder:SetAttribute("Seed", seed)
	local pocket = {
		Index = index,
		Origin = DungeonBuilder.PocketOrigin(index),
		Model = holder,
		Floor = floorIndex,
		Seed = seed,
		Layout = Layout.plan(floorIndex, seed),
		Rooms = {},
	}
	pocket.Name = pocket.Layout.Def.Name
	pocket.Element = pocket.Layout.Def.Element
	-- bug #5: the run's look (StyleTiers by floor) and its mood for the client (DungeonController's lighting preset):
	-- the style's ambient / colour correction (never darker than MoodFloor), the contrast a little harder deeper in the tier
	pocket.Style = pocket.Layout.Style or DungeonBuilder.StyleFor(floorIndex)
	do
		local st = DungeonBuilder.Styles[pocket.Style]
		local depth = DungeonBuilder.StyleDepth(floorIndex)
		local fl = DungeonBuilder.MoodFloor
		local function atLeast(c, lo)
			return Color3.new(max(c.R, lo.R), max(c.G, lo.G), max(c.B, lo.B))
		end
		holder:SetAttribute("DungeonStyle", pocket.Style)
		holder:SetAttribute("StyleName", st and st.Name or "")
		if st and st.Mood then
			holder:SetAttribute("MoodAmbient", atLeast(st.Mood.Ambient, fl.Ambient))
			holder:SetAttribute("MoodOutdoor", atLeast(st.Mood.Outdoor, fl.Outdoor))
			holder:SetAttribute("MoodBrightness", max(st.Mood.Brightness, fl.Brightness))
			holder:SetAttribute("MoodContrast", st.Mood.Contrast + 0.03 * depth)
			holder:SetAttribute("MoodTint", st.Mood.Tint)
		end
	end
	-- the hall: built while the holder is still out of the workspace (like a room's staging), so it replicates whole.
	-- (wave 6 Studio check: the exit door built in a live hall reached a client before its PrimaryPart did and the client
	-- dressed its mesh at the world origin)
	local hall = clonePiece(pocket, 1, holder)
	if hall then
		local prevStyle = Style.Cur
		Style.Cur = DungeonBuilder.Styles[pocket.Style] or Style.Cur
		local okStyled, styledErr = pcall(function()
		local spawns = {}
		for i = 1, 4 do
			local sp = worldPoint(hall, "Spawn" .. i)
			spawns[i] = sp and (sp * CFrame.new(0, 3, 0)) or (hall.PrimaryPart.CFrame * CFrame.new(0, 4.5, 0))
		end
		local exitCf = worldPoint(hall, "Exit")
		local door, bars = Kit.door(hall, CFrame.new(exitCf and (exitCf.Position - Vector3.new(0, 1.5, 0)) or hall.PrimaryPart.Position), "Door_Exit", 8)
		Kit.setDoor(door, false)
		hall:SetAttribute("DoorOpen", false)
		-- the hall's exit carries room 1's EnterPrompt (hall side; the run moves on when every member pressed E)
		local nextPrompt, nextPoint = nil, nil
		if exitCf then
			nextPrompt, nextPoint = Kit.enterPrompt(hall, exitCf * CFrame.new(0, 3, -2.5), enterLabel(1), 1)
		end
		dressFloor(hall, pocket)
		pocket.Hall = { Index = 0, Kind = "Hall", Model = hall, Room = hall, Spawns = spawns, Center = hall.PrimaryPart.Position + Vector3.new(0, 1.5, 0), ExitDoor = { Model = door, Bars = bars }, Entrance = spawns[1], NextPrompt = nextPrompt, NextPoint = nextPoint }
		pocket.Rooms[0] = pocket.Hall
		end)
		-- (Style.Cur restored on both paths: an error in the styled hall must not leave the Kit building in this style)
		Style.Cur = prevStyle
		if not okStyled then
			holder:Destroy()
			error(styledErr, 0)
		end
	end
	holder.Parent = folder
	State.Pockets[index] = pocket
	DungeonBuilder.PlaceRoom(pocket, 1)
	return pocket
end

function DungeonBuilder.GetPocket(index)
	return State.Pockets[index]
end

function DungeonBuilder.FreeRun(index)
	index = floor(tonumber(index) or 0)
	local pocket = State.Pockets[index]
	State.Pockets[index] = nil
	local folder = dungeonsFolder(false)
	local holder = pocket and pocket.Model or (folder and folder:FindFirstChild("Dungeon_" .. index))
	if holder then
		holder:Destroy()
	end
	if pocket then
		pocket.Rooms = {}
	end
	if folder and #folder:GetChildren() == 0 then
		folder:Destroy()
	end
	return pocket ~= nil
end

-- the live BasePart count of a run (hall + rooms + corridors)
function DungeonBuilder.LiveParts(pocket)
	if type(pocket) ~= "table" or not pocket.Model then
		return 0
	end
	return DungeonBuilder.CountParts(pocket.Model)
end

return DungeonBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1092">
          <Properties>
            <string name="Name">DungeonService</string>
            <string name="Source"><![CDATA[--!nocheck
-- DungeonService (ARCHITECTURE_V3.md "Phase 5 build contract" 5.2-5.4, 5.7, 10.4 Y3-Y6; dungeon W3)
--
-- Parties, runs and loot of the Dungeon. Combat goes ONLY through BattleService's encounter API (4.6): one encounter
-- per room (a fresh BattleSim, full HP), KeepInBattle = true (the RUN owns the InBattle attribute: its id "D<n>" is
-- written before the teleport and released by Dg.endRun / Dg.removeMember). Every reward is paid by this service,
-- once per room per qualifying member (result.Fighters: >= Dungeon.MinShare of the room's damage), marked in
-- run.Paid[room][userId] BEFORE the payment; first clears are decided inside DataService.MutateDungeon (`first`).
--
--   DungeonService.Init(deps)   deps { DataService, PetCareService, TycoonService, BattleService, DungeonBuilder,
--                               DungeonInfo, LobbyInfo, PetService, TutorialService }: wires DungeonRequest, the 0.5 s loop, then LAST
--                               BattleService.SetRunProvider({ KeysInRun, GetRun }) (C16)
--   API: CreateParty(player, floor), JoinParty(player, leaderUserId), LeaveParty(player), SetReady(player, bool),
--        SetFloor(player, floor), KickMember(leader, userId), StartRun(party) -> ok, runId | reason,
--        StartSolo(player, floor), Quit(player), OpenChest(player, slot), GetRun(player) -> { RunId, Floor, Room, State, Wave }
--        | nil, KeysInRun(player) -> {[key] = true}, ListParties(), Shutdown()
--   Signals: RunEnded(runId, result = { Floor, Cleared, Members, Winners, Loot, Reason }) after the payments;
--            FloorCleared(player, floor);
--            RoomCleared(player, floor, room) for every live member of a cleared room, before FloorCleared on room 4 (team balance)
--   Remotes: DungeonRequest(action, a, b) c->s (Open / Create / Join / Leave / Ready / SetFloor / Start / Solo / Quit /
--            Chest / Kick), DungeonState(kind, payload) s->c (Lobby <= 1/s, Run, Loot, Chest, End, Fade { Out, Hold,
--            In, Room }, Enter { Cover, Reveal, Element, Floor, Name }), the gate's attribute DungeonBoard, the room
--            models' DoorOpen / EntranceOpen attributes; the doors' EnterPrompt (DungeonAction "Enter") arrives through
--            ProximityPromptService.PromptTriggered
-- The treasure (bug batch 2, #14): every member owed a chest picks ONE of the alcove's chests with its E prompt (no GUI
-- button). The prompt's ChestSlot goes to Dg.openChest(run, m, slot): a real slot, free, the member within CHEST_RANGE,
-- the member's own chest still closed. The drop is rolled from run.Seed + slot * 7919 (every chest its own roll), the
-- chest part is marked Opened / OpenedBy, its prompt disabled for everyone, a glow lit. A "Chest" request without a
-- slot opens nothing. The 45 s exit (and a member leaving in the alcove) gives the first free slot.
-- Wave 5 (bugs #15 / #26): a run starts with DungeonState("Enter") to every member; the members are teleported into
-- the hall ENTER.Cover seconds later (Dg.finishEnter, under the client's voxel cover; run.Transit holds the lock
-- meanwhile). A room's fight starts on the first Threshold crossing or WALK_IN_TIMEOUT (3 s) after enterRoom (the
-- client walks its character in under the fade); startFight moves only members outside the room's Zone box (onto the
-- Threshold line), nobody is yanked back. The player attribute InFight (Config.Attr.InFight) is true only while the
-- member's team fights a room (startFight -> onRoomEnd / removeMember / endRun / unbind): PetController shows the
-- followers the rest of the run (InBattle stays the run id for the whole run).
--
-- Run.State: "Hall" -> "Corridor" (Phase "Threshold": at the room's entrance until a member crosses the Threshold part;
-- Phase "Walk": the room is cleared, its exit bars open after Intermission) -> "Fight" -> ... -> "Treasure"
-- (TreasureSeconds, chests) -> "Ending" (End sent, Runs + 1, return teleport after RETURN_DELAY, InBattle released,
-- pocket freed, party removed, RunEnded once). Late joins while Hall / Corridor and Room <= LateJoinLastRoom.
-- Moving on (dungeon-fixes decision 2): NO timer ever moves the group to another room. In the Hall (the hall's exit ->
-- room 1) and after a clear once the bars are open (the NEXT room's closed Door_Entrance; the boss room's exit -> the
-- treasure) one EnterPrompt is enabled (Dg.nextDoor / Dg.syncPrompt). Its E press (ProximityPromptService, nothing new
-- from the client) is Dg.confirm: run.Confirm[userId] = true, idempotent (own pocket, State Hall / Corridor-Walk, a
-- member not Left, within CONFIRM_RANGE of the prompt, not during a transit). When every member still in the run
-- (Downed ones too) confirmed, Dg.transit: run.Transit lock, DungeonState("Fade", { Out, Hold, In, Room }) to the
-- members, after Out Dg.finishTransit (once per transit: TransitSeq + the state it started from) enters the next room
-- (Dg.enterRoom: Door_Entrance opened, members at its Entrance) or the treasure, and clears Confirm / Transit. A member
-- leaving re-checks the count; a late joiner must press too. The Run payload carries Confirmed { userId... },
-- NeedConfirm (presses still missing), EnterOpen (a door is waiting), Next (the room it leads to, 5 = the treasure).
-- Watchdog (the loop): a Fight whose encounter is gone for 15 s, or any run older than MaxRunSeconds(floor) -> endRun
-- "Error". MaxRunSeconds no longer counts DoorTime: it allows WAIT_ALLOWANCE seconds per door (5 doors) in total, so a
-- slow-walking group is never ended early while an AFK group still frees its pocket.
-- Rate limits: DungeonRequest burst 6 refill 2 / s + per-action cooldowns; the ladder type -> range -> permission ->
-- plausibility; refusals are throttled side toasts.
-- Plain Lua 5.1 syntax only (Luau subset); no per-frame loops, no server tweens.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local FxSprites = require(Shared.FxSprites) -- the game's own particle sprites (kit B X1)

local DungeonService = {}
DungeonService.RunEnded = Util.Signal() -- Fire(runId, result) once per run, after the payments
DungeonService.FloorCleared = Util.Signal() -- Fire(player, floor)
DungeonService.RoomCleared = Util.Signal() -- Fire(player, floor, room): the tutorial's "Into the Dungeon!" (team balance)
DungeonService.MAX_DUNGEONS = 8 -- 12 only after the owner's MicroProfiler check (judge M6)

local floor, max, min, abs = math.floor, math.max, math.min, math.abs

local function copyList(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

local ATTR_IN_BATTLE = (Config.Attr and Config.Attr.InBattle) or "InBattle"
local ATTR_IN_MATCH = (Config.Attr and Config.Attr.InMatch) or "InMatch"
local ATTR_PORTAL_LOCKED = (Config.Attr and Config.Attr.PortalLocked) or "PortalLocked"
local ATTR_IN_FIGHT = (Config.Attr and Config.Attr.InFight) or "InFight"

local K = {
	MAX_PARTY = 4,
	RETURN_DELAY = 4,
	START_COUNTDOWN = 5, -- "Dungeon in 5..."
	WALK_IN_TIMEOUT = 3, -- bug #26: nobody crossed the Threshold 3 s after the room was entered (fade-in 0.45 + the
	-- 1.3 s walk-in + lag): the fight starts anyway. The old 30 s THRESHOLD_TIMEOUT was the dead wait.
	WATCHDOG_MISSING = 15,
	LEASH = 80, -- studs from the room centre
	LEASH_STRIKES = 2,
	JOIN_QUEUE = 20, -- a join during a fight waits this long for the corridor
	START_RANGE = 30, -- studs from the portal pad
	BOARD_MAX = 5,
	NEXT_WAVE = 1.5,
	LOOP = 0.5,
	LOBBY_GAP = 1, -- Lobby pushes per client
	TOAST_GAP = 3,
	FAR = 500, -- a member this far from the pocket respawned elsewhere
	BUCKET_BURST = 6,
	BUCKET_REFILL = 2,
	CONFIRM_RANGE = 14, -- studs from the EnterPrompt's part (the prompt itself shows within 10)
	WAIT_ALLOWANCE = 180, -- watchdog seconds per door wait (hall + 3 corridors + the boss exit = 5 waits, pooled)
	DOOR_WAITS = 5,
	CHEST_RANGE = 9, -- studs from the chest (its prompt shows within 7)
}
-- bug batch 2 #14: one pickable chest slot per possible member; Init asserts DungeonBuilder.CHEST_COUNT (the chests
-- Treasure_1 builds) >= this, so a full party never runs out of chests (the builder comes in through deps, no require)
K.CHEST_SLOTS = K.MAX_PARTY
-- (quick wins, review round 1) the party cap for the texts: DungeonBuilder's gate info ("up to MAX_PARTY - 1 friends")
-- reads it here, the client reads the Lobby payload's Max
DungeonService.MAX_PARTY = K.MAX_PARTY

-- the room change's fade (dungeon-fixes decision 2): the server enters the next room after Out
local FADE = { Out = 0.45, Hold = 0.35, In = 0.45 }
-- the dungeon entrance (bug #15): the client covers the screen in voxel blocks over Cover seconds, the server teleports
-- the members into the hall after Cover, the blocks fall away over Reveal (sent in the payload, never hard-coded there)
local ENTER = { Cover = 0.55, Reveal = 0.9 }
DungeonService.ENTER = ENTER

local COOLDOWN = { Create = 2, Join = 1, Ready = 0.3, SetFloor = 0.5, Start = 1.5, Quit = 1, Chest = 0.5, Open = 0.5, Kick = 1, Leave = 0.5, Solo = 1.5, Enter = 0.25 }
local ACTIONS = { Open = true, Create = true, Join = true, Leave = true, Ready = true, SetFloor = true, Start = true, Solo = true, Quit = true, Chest = true, Kick = true }

local St = {
	deps = {},
	parties = {}, -- leaderUserId -> Party
	partyOrder = {}, -- leaderUserIds in creation order (deterministic listings)
	partyOf = {}, -- Player -> Party
	runs = {}, -- runId -> Run
	runOrder = {}, -- runIds in creation order
	runOf = {}, -- Player -> Run
	runByBattle = {}, -- battleId -> Run
	pocketBusy = {}, -- index -> true
	buckets = {}, -- Player -> { tokens, last }
	cooldowns = {}, -- Player -> { [action] = clock }
	toasts = {}, -- Player -> { [text] = clock }
	lobbyDirty = {}, -- Player -> true (a Lobby push is owed)
	lobbySent = {}, -- Player -> clock of the last Lobby push
	joinQueue = {}, -- Player -> { Party, Deadline }
	strikes = {}, -- Player -> leash strikes
	board = {}, -- name -> best floor cleared on this server
	conns = {},
	remotes = {},
	seq = 0,
	closing = false,
	initialized = false,
	loop = nil,
}

local Dg = {} -- the run machinery (exported for tests: DungeonService.Dg)
DungeonService.Dg = Dg
DungeonService.St = St

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function now()
	return os.clock()
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function whole(n, lo, hi)
	if not finite(n) or n ~= floor(n) then
		return nil
	end
	if lo and n < lo then
		return nil
	end
	if hi and n > hi then
		return nil
	end
	return n
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent ~= nil
end

local function hasFn(t, name)
	return type(t) == "table" and type(t[name]) == "function"
end

local function try(t, name, ...)
	if hasFn(t, name) then
		local ok, a, b, c = pcall(t[name], ...)
		if ok then
			return a, b, c
		end
		warn("[DungeonService] " .. tostring(name) .. " failed: " .. tostring(a))
	end
	return nil
end

local function catalog()
	local ok, BC = pcall(require, Shared:FindFirstChild("BattleCatalog"))
	if ok and type(BC) == "table" then
		return BC
	end
	return nil
end

local function D()
	local BC = catalog()
	local d = BC and BC.Dungeon
	return type(d) == "table" and d or {}
end

local function num(v, fallback)
	return finite(v) and v or fallback
end

local function getRemote(name)
	local cached = St.remotes[name]
	if cached ~= nil then
		return cached or nil
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		St.remotes[name] = remote
		return remote
	end
	St.remotes[name] = false
	return nil
end

local function notify(player, text, kind, duration)
	if not isPlayer(player) or type(text) ~= "string" or text == "" then
		return
	end
	local list = St.toasts[player]
	if not list then
		list = {}
		St.toasts[player] = list
	end
	local t = now()
	if list[text] and t - list[text] < K.TOAST_GAP then
		return
	end
	list[text] = t
	local remote = getRemote("Notify")
	if remote then
		if #text > 90 then
			text = text:sub(1, 89) .. "."
		end
		pcall(function()
			remote:FireClient(player, text, kind or "info", duration or 3)
		end)
	end
end

local function sendState(player, kind, payload)
	if not isPlayer(player) then
		return false
	end
	local remote = getRemote("DungeonState")
	if not remote then
		return false
	end
	local ok = pcall(function()
		remote:FireClient(player, kind, payload)
	end)
	return ok
end

local function rootOf(player)
	local char = isPlayer(player) and player.Character or nil
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function teleport(player, cf)
	local char = isPlayer(player) and player.Character or nil
	if not char or typeof(cf) ~= "CFrame" then
		return false
	end
	local ok = pcall(function()
		char:PivotTo(cf)
	end)
	if not ok then
		local root = rootOf(player)
		if root then
			root.CFrame = cf
		end
	end
	return true
end

local function setInBattle(player, value)
	if isPlayer(player) then
		pcall(function()
			player:SetAttribute(ATTR_IN_BATTLE, value)
		end)
	end
end

-- bug #26: InFight = true only while the member's team fights a room (the followers park then; nil = they follow)
local function setInFight(player, on)
	if isPlayer(player) then
		pcall(function()
			player:SetAttribute(ATTR_IN_FIGHT, on and true or nil)
		end)
	end
end

local function shortName(player)
	return isPlayer(player) and (player.DisplayName or player.Name) or "?"
end

local function countLive(run)
	local n = 0
	for _, uid in ipairs(run.Order) do
		local m = run.Members[uid]
		if m and not m.Left then
			n = n + 1
		end
	end
	return n
end

local function liveMembers(run)
	local out = {}
	for _, uid in ipairs(run.Order) do
		local m = run.Members[uid]
		if m and not m.Left then
			out[#out + 1] = m
		end
	end
	return out
end

local function partyCount(party)
	local n = 0
	for _, uid in ipairs(party.Order) do
		if party.Members[uid] then
			n = n + 1
		end
	end
	return n
end

-- a member out of a party: the record AND its Order entry (a later re-join appends once; partyCount stays exact)
local function dropPartyMember(party, uid)
	party.Members[uid] = nil
	for i = #party.Order, 1, -1 do
		if party.Order[i] == uid then
			table.remove(party.Order, i)
		end
	end
end

-- the member qualified (>= MinShare of the party's damage) in at least one room: the only ones the boss chest is for (5.2 / Y4)
local function qualifiedAnywhere(m)
	local q = type(m.Qualified) == "table" and m.Qualified or {}
	for room = 1, 4 do
		if q[room] == true then
			return true
		end
	end
	return false
end

-- the watchdog's limit of a run (5.4 + dungeon-fixes decision 2): Dungeon.RunMaxSeconds or, when longer, the floor's
-- own worst case: 4 rooms at the floor's room limit, 4 Threshold waits + Intermissions, the door waits (no DoorTime /
-- HallSeconds any more: the group walks at its own pace and presses E, so DOOR_WAITS x WAIT_ALLOWANCE seconds of
-- waiting are allowed in total, pooled over the hall, the corridors and the boss exit), the fades, the treasure and
-- 120 s of slack. Floor 2: 4 x 120 + 4 x 32 + 5 x 180 + 5 x 1.25 + 45 + 120 = 1679 s (28 min) instead of 703 s.
function DungeonService.MaxRunSeconds(floorIndex)
	local d = D()
	local roomTime = (floorIndex == 1) and num(d.Floor1RoomTime, 180) or num(d.RoomTime, 120)
	local fade = FADE.Out + FADE.Hold + FADE.In
	local worst = 4 * roomTime + 4 * (K.WALK_IN_TIMEOUT + num(d.Intermission, 2)) + K.DOOR_WAITS * (K.WAIT_ALLOWANCE + fade) + num(d.TreasureSeconds, 45) + 120
	return max(num(d.RunMaxSeconds, 700), worst)
end

local function markLobbyDirty()
	for _, p in ipairs(Players:GetPlayers()) do
		St.lobbyDirty[p] = true
	end
end

----------------------------------------------------------------------
-- Records (DataService.GetDungeon / MutateDungeon; nil while provisional)
----------------------------------------------------------------------
local function record(player)
	local rec = try(St.deps.DataService, "GetDungeon", player)
	if type(rec) == "table" then
		return rec
	end
	return { Best = 0, Cleared = {}, Runs = 0, Clears = 0 }
end

local function profileReady(player)
	local DS = St.deps.DataService
	local prof = try(DS, "GetProfile", player)
	if type(prof) ~= "table" then
		return false, "Your save is still loading"
	end
	local provisional = try(DS, "IsProvisional", player)
	if provisional == true then
		return false, "Your save is still loading"
	end
	return true, prof
end

local function ownsPet(player)
	local prof = try(St.deps.DataService, "GetProfile", player)
	if type(prof) == "table" and type(prof.Pets) == "table" then
		for _, n in pairs(prof.Pets) do
			if (tonumber(n) or 0) > 0 then
				return true
			end
		end
	end
	return false
end

-- ok, reason: the entry checks of 5.3 in order (pet, team, battle-free, distance, loaded, floor for the leader)
local function canEnter(player, floorIndex, isLeader, checkDistance)
	if not isPlayer(player) then
		return false, "That player is not here"
	end
	if not ownsPet(player) then
		return false, "You need a pet"
	end
	local spec, why = try(St.deps.BattleService, "TeamSpec", player)
	if type(spec) ~= "table" then
		return false, why or "You need a pet"
	end
	if St.closing then
		return false, "The server is restarting: the dungeon will be back in a moment"
	end
	if player:GetAttribute(ATTR_IN_MATCH) == true then
		return false, "Finish your obby match first"
	end
	local locked = player:GetAttribute(ATTR_PORTAL_LOCKED)
	if locked ~= nil and locked ~= false and locked ~= "" then
		return false, "Leave the portal party first"
	end
	local inBattle = player:GetAttribute(ATTR_IN_BATTLE)
	if (inBattle ~= nil and inBattle ~= false and inBattle ~= "") or try(St.deps.BattleService, "IsInBattle", player) == true then
		if St.runOf[player] then
			return false, "Finish your dungeon run first"
		end
		return false, "Finish your battle first"
	end
	if checkDistance then
		local info = St.deps.DungeonInfo
		local pad = type(info) == "table" and (info.Pad or info.PromptPart) or nil
		local root = rootOf(player)
		if pad and root and (root.Position - pad.Position).Magnitude > K.START_RANGE then
			return false, "Walk to the Dungeon gate first"
		end
		if not root then
			return false, "Respawn first"
		end
	end
	local ok, why2 = profileReady(player)
	if not ok then
		return false, why2
	end
	if isLeader then
		local rec = record(player)
		if (tonumber(rec.Best) or 0) < floorIndex - 1 then
			return false, "Clear floor " .. tostring(floorIndex - 1) .. " first"
		end
	end
	return true, spec
end

local function powerOf(spec)
	local BC = catalog()
	if not BC or type(spec) ~= "table" or type(spec.Pets) ~= "table" then
		return 0
	end
	local list = {}
	for i, pet in ipairs(spec.Pets) do
		list[i] = { Def = pet.Def, Level = pet.Level, Tier = pet.Tier, Evo = pet.Evo, Train = pet.Train }
	end
	local ok, power = pcall(BC.TeamPower, list)
	if ok and finite(power) then
		return floor(power + 0.5)
	end
	return 0
end

local function keysOf(spec)
	local keys = {}
	for i, pet in ipairs(type(spec) == "table" and spec.Pets or {}) do
		keys[i] = pet.Key
	end
	return keys
end

----------------------------------------------------------------------
-- The Lobby payload (<= 1/s per client)
----------------------------------------------------------------------
local function lobbyPayload(player)
	local parties = {}
	for _, leaderId in ipairs(St.partyOrder) do
		local party = St.parties[leaderId]
		if party then
			local run = party.Run
			parties[#parties + 1] = {
				Leader = leaderId,
				LeaderName = shortName(party.Leader),
				Floor = party.Floor,
				Count = partyCount(party),
				Max = K.MAX_PARTY,
				Open = partyCount(party) < K.MAX_PARTY and (run == nil or run.Joinable == true or (run.State == "Fight" and run.Room <= num(D().LateJoinLastRoom, 2) and countLive(run) < K.MAX_PARTY)),
				InRun = run ~= nil,
				Room = run and run.Room or nil,
			}
		end
	end
	local mine = nil
	local party = St.partyOf[player]
	if party then
		local members = {}
		for _, uid in ipairs(party.Order) do
			local m = party.Members[uid]
			if m then
				members[#members + 1] = { UserId = uid, Name = shortName(m.Player), Ready = m.Ready == true or uid == party.Leader.UserId, Power = m.Power or 0 }
			end
		end
		mine = {
			Leader = party.Leader.UserId,
			Floor = party.Floor,
			Members = members,
			Countdown = party.StartAt and max(0, floor(party.StartAt - now() + 0.5)) or nil,
			InRun = party.Run ~= nil,
		}
	end
	local rec = record(player)
	local cleared = {}
	for f = 1, 12 do
		cleared[f] = rec.Cleared and rec.Cleared[f] == true or false
	end
	return {
		Max = K.MAX_PARTY, -- (quick wins, review round 1) the party cap: the window's "up to Max - 1 friends"
		Parties = parties,
		Mine = mine,
		Record = { Best = tonumber(rec.Best) or 0, Cleared = cleared, Runs = tonumber(rec.Runs) or 0, Clears = tonumber(rec.Clears) or 0 },
	}
end

local function pushLobby(player, force)
	if not isPlayer(player) then
		return
	end
	local t = now()
	local last = St.lobbySent[player]
	if last and t - last < K.LOBBY_GAP and not force then
		St.lobbyDirty[player] = true
		return
	end
	St.lobbySent[player] = t
	St.lobbyDirty[player] = nil
	sendState(player, "Lobby", lobbyPayload(player))
end

----------------------------------------------------------------------
-- Run payloads
----------------------------------------------------------------------
local function runPayload(run)
	local members = {}
	for _, uid in ipairs(run.Order) do
		local m = run.Members[uid]
		if m then
			members[#members + 1] = { UserId = uid, Name = shortName(m.Player), Downed = m.Downed == true, Left = m.Left == true }
		end
	end
	-- the door wait: who pressed E at the open door, how many presses are still missing (every member still in)
	local door, target = Dg.nextDoor(run)
	local confirmed, need = {}, 0
	-- the treasure: who still has a chest to pick (the card says "Pick ONE chest!" to them only)
	local owed = nil
	if run.State == "Treasure" then
		owed = {}
		for _, m in ipairs(liveMembers(run)) do
			if run.Chests[m.Player.UserId] == "Closed" then
				owed[#owed + 1] = m.Player.UserId
			end
		end
	end
	if door then
		local mine = run.ConfirmFor == target and run.Confirm or {}
		for _, m in ipairs(liveMembers(run)) do
			if mine[m.Player.UserId] then
				confirmed[#confirmed + 1] = m.Player.UserId
			else
				need = need + 1
			end
		end
	end
	return {
		Confirmed = confirmed,
		NeedConfirm = need,
		EnterOpen = door ~= nil,
		Next = door and target or nil,
		Transit = run.Transit == true,
		RunId = run.Id,
		Floor = run.Floor,
		Name = run.Name,
		Element = run.Element,
		Room = run.Room,
		RoomCount = 4,
		Wave = run.Wave,
		Waves = run.Waves,
		State = run.State,
		Phase = run.Phase,
		Members = members,
		Joinable = run.Joinable == true,
		ChestOwed = owed,
	}
end

local function sendRun(run)
	Dg.syncPrompt(run)
	local payload = runPayload(run)
	for _, m in ipairs(liveMembers(run)) do
		sendState(m.Player, "Run", payload)
	end
end

local function lootOf(run, uid)
	local loot = run.Loot[uid]
	if not loot then
		loot = { Cash = 0, Tokens = 0, Xp = 0, Gems = 0 }
		run.Loot[uid] = loot
	end
	return loot
end

local function endPayload(run, member, reason)
	local uid = member.Player.UserId
	local loot = lootOf(run, uid)
	local payload = {
		Floor = run.Floor,
		Name = run.Name,
		Cleared = run.Cleared == true and member.ClearedFloor == true,
		Reason = reason or run.EndReason or "Ended",
		Room = run.Room,
		Totals = { Cash = loot.Cash, Tokens = loot.Tokens, Xp = loot.Xp, Gems = loot.Gems },
		FirstClear = member.FirstClear,
		Unlocked = member.Unlocked,
		NewBest = member.NewBest == true,
	}
	-- team balance (spec 2026-10-31 s.7): a lost floor's numbers for the loss screen (the client never computes levels)
	if payload.Reason == "Wipe" or payload.Reason == "Timeout" then
		payload.Pets = try(St.deps.BattleService, "LevelReport", member.Player, member.Keys, member.StartLevels)
		payload.Solo = (#run.Order == 1) and true or nil
	end
	return payload
end

----------------------------------------------------------------------
-- Pockets
----------------------------------------------------------------------
local function freePocket()
	for i = 1, DungeonService.MAX_DUNGEONS do
		if not St.pocketBusy[i] then
			return i
		end
	end
	return nil
end

local function updateBoard()
	local info = St.deps.DungeonInfo
	local portal = type(info) == "table" and info.Portal or nil
	if not portal then
		return
	end
	local names = {}
	for name in pairs(St.board) do
		names[#names + 1] = name
	end
	table.sort(names, function(a, b)
		if St.board[a] ~= St.board[b] then
			return St.board[a] > St.board[b]
		end
		return a < b
	end)
	local parts = {}
	for i = 1, min(K.BOARD_MAX, #names) do
		parts[#parts + 1] = names[i] .. "|" .. tostring(St.board[names[i]])
	end
	local text = table.concat(parts, ";")
	if portal:GetAttribute("DungeonBoard") ~= text then
		portal:SetAttribute("DungeonBoard", text)
		local tag = portal:FindFirstChild("GateTag", true)
		local pillLabel = tag and tag:FindFirstChild("Label", true)
		if pillLabel and pillLabel:IsA("TextLabel") then
			local line = {}
			for i = 1, min(2, #names) do
				line[#line + 1] = names[i] .. " - " .. tostring(St.board[names[i]])
			end
			pcall(function()
				pillLabel.Text = "Floors cleared here: " .. (#line > 0 and table.concat(line, ", ") or "-")
			end)
		end
	end
end

----------------------------------------------------------------------
-- Dg: the run machinery
----------------------------------------------------------------------
local function runSeed(party, floorIndex)
	return (party.Leader.UserId * 31 + St.seq * 7919 + floorIndex * 131) % 2147483647
end

local function roomInfo(run, room)
	return run.Pocket and run.Pocket.Rooms and run.Pocket.Rooms[room] or nil
end

local function wavesOf(run, room)
	local d = D()
	if room == 4 then
		return 2
	end
	local list = (run.Floor == 1) and d.Floor1Waves or d.Waves
	local w = type(list) == "table" and tonumber(list[room]) or nil
	return max(1, floor(w or 2))
end

-- the run id's attribute + the service's maps for a member
local function bindMember(run, player)
	setInBattle(player, run.Id)
	St.runOf[player] = run
end

local function unbindMember(run, player)
	if St.runOf[player] == run then
		St.runOf[player] = nil
	end
	if isPlayer(player) and player:GetAttribute(ATTR_IN_BATTLE) == run.Id then
		setInBattle(player, nil)
	end
	setInFight(player, nil)
	St.strikes[player] = nil
end

local function returnHome(player)
	local info = St.deps.DungeonInfo
	local cf = type(info) == "table" and info.ReturnCFrame or nil
	if typeof(cf) ~= "CFrame" then
		cf = CFrame.new(Config.Lobby.Origin + Vector3.new(0, 4, 0))
	end
	teleport(player, cf)
end

local function newMember(run, player, spec, joinedRoom)
	local member = {
		Player = player,
		Keys = keysOf(spec),
		StartLevels = try(St.deps.BattleService, "LevelSnapshot", player, keysOf(spec)), -- the loss screen's "before"
		Spec = spec,
		Power = powerOf(spec),
		JoinedRoom = joinedRoom,
		Downed = false,
		Left = false,
		Qualified = {},
	}
	run.Members[player.UserId] = member
	run.Order[#run.Order + 1] = player.UserId
	member.Slot = #run.Order
	lootOf(run, player.UserId)
	return member
end

-- Dg.begin(party) -> ok, runId | reason: reserves the pocket BEFORE any yield, builds the run, binds + teleports the members
function Dg.begin(party, readyOnly)
	local leader = party.Leader
	local floorIndex = party.Floor
	party.StartAt = nil
	party.WaitingReady = nil
	if party.Run then
		return false, "Your party is already in a run"
	end
	local index = freePocket()
	if not index then
		for _, uid in ipairs(party.Order) do
			local m = party.Members[uid]
			if m then
				notify(m.Player, "The dungeon is full, try again in a minute", "bad", 4)
			end
		end
		return false, "The dungeon is full, try again in a minute"
	end
	St.pocketBusy[index] = true
	St.seq = St.seq + 1
	local run = {
		Id = "D" .. tostring(St.seq),
		Floor = floorIndex,
		Seed = runSeed(party, floorIndex),
		Pocket = nil,
		State = "Hall",
		Phase = nil,
		Room = 0,
		Wave = 0,
		Waves = 0,
		Members = {},
		Order = {},
		Battle = nil,
		Rooms = {},
		Paid = {},
		Loot = {},
		Started = now(),
		StateAt = now(),
		Joinable = true,
		Chests = {},
		ChestTaken = {}, -- slot -> userId: the alcove's chest that member picked (one chest, one member)
		Cleared = false,
		Party = party,
		PocketIndex = index,
		Confirm = {}, -- userId -> true: pressed E at the open door (for run.ConfirmFor = the room it leads to)
		ConfirmFor = nil,
		Transit = nil, -- true from the last press to the next room (the lock: later presses are ignored)
		TransitSeq = 0,
	}
	-- members in party order: the entry checks, the team spec fixed now
	local dropped = {}
	for _, uid in ipairs(party.Order) do
		local pm = party.Members[uid]
		if pm and isPlayer(pm.Player) then
			local isReady = pm.Ready == true or uid == leader.UserId
			if readyOnly and not isReady then
				dropped[#dropped + 1] = pm.Player
			else
				local ok, specOrWhy = canEnter(pm.Player, floorIndex, uid == leader.UserId, true)
				if ok then
					newMember(run, pm.Player, specOrWhy, 1)
				else
					notify(pm.Player, tostring(specOrWhy), "bad", 4)
					dropped[#dropped + 1] = pm.Player
				end
			end
		end
	end
	for _, p in ipairs(dropped) do
		local uid = p.UserId
		if uid ~= leader.UserId then
			dropPartyMember(party, uid)
			St.partyOf[p] = nil
			notify(p, "You were dropped from the party", "bad", 4)
		end
	end
	if #run.Order == 0 or not run.Members[leader.UserId] then
		St.pocketBusy[index] = nil
		-- the leader could not enter: the party stays, nothing starts
		if #run.Order > 0 then
			for _, uid in ipairs(run.Order) do
				run.Members[uid] = nil
			end
		end
		markLobbyDirty()
		return false, "The leader could not enter"
	end
	-- team balance (spec 2026-10-31 s.7): room 1 of floor 1 is eased for a SOLO player on the tutorial's dungeon step; a party
	-- always gets the normal room (a late joiner drops the flag, Dg.lateJoin), so nobody farms it
	run.Eased = (#run.Order == 1 and try(St.deps.TutorialService, "IsOnStep", leader, "dungeon") == true) or nil
	local okB, pocket, whyB = pcall(St.deps.DungeonBuilder.BuildRun, index, floorIndex, run.Seed)
	if not okB or type(pocket) ~= "table" then
		St.pocketBusy[index] = nil
		warn("[DungeonService] BuildRun failed: " .. tostring(okB and whyB or pocket))
		notify(leader, "The dungeon could not open, try again", "bad", 4)
		return false, "The dungeon could not open"
	end
	run.Pocket = pocket
	run.Name = pocket.Name or ("Floor " .. tostring(floorIndex))
	run.Element = pocket.Element or "Earth"
	-- InBattle = the run id BEFORE the teleport (followers parked, portals / GoHome / obby refused)
	for _, uid in ipairs(run.Order) do
		bindMember(run, run.Members[uid].Player)
	end
	-- bug #15: the entrance cover first (the client's voxel blocks), the teleport into the hall after ENTER.Cover
	-- (Dg.finishEnter); the Transit lock holds the doors, the late joins and the confirms meanwhile
	run.Transit = true
	run.TransitSeq = (run.TransitSeq or 0) + 1
	local seq = run.TransitSeq
	local enter = { Cover = ENTER.Cover, Reveal = ENTER.Reveal, Element = run.Element, Floor = floorIndex, Name = run.Name }
	for _, m in ipairs(liveMembers(run)) do
		sendState(m.Player, "Enter", enter)
	end
	party.Run = run
	St.runs[run.Id] = run
	St.runOrder[#St.runOrder + 1] = run.Id
	run.State = "Hall"
	run.StateAt = now()
	markLobbyDirty()
	task.delay(ENTER.Cover, function()
		local ok, err = pcall(Dg.finishEnter, run, seq)
		if not ok then
			warn("[DungeonService] the dungeon entrance failed: " .. tostring(err))
			pcall(Dg.endRun, run, false, "Error")
		end
	end)
	return true, run.Id
end

-- Dg.finishEnter(run, seq) -> bool: the members into the hall under the entrance cover (once per begin)
function Dg.finishEnter(run, seq)
	if run.State ~= "Hall" or run.TransitSeq ~= seq or not run.Transit then
		return false
	end
	run.Transit = nil
	local hall = run.Pocket and run.Pocket.Hall
	for i, uid in ipairs(run.Order) do
		local m = run.Members[uid]
		if m and not m.Left and isPlayer(m.Player) then
			m.Joined = now() -- (the FAR check's grace: the teleport replicates within it)
			local cf = hall and hall.Spawns and hall.Spawns[((i - 1) % 4) + 1] or CFrame.new(run.Pocket.Origin + Vector3.new(0, 4, 0))
			teleport(m.Player, cf)
		end
	end
	if countLive(run) == 0 then
		return false
	end
	sendRun(run)
	markLobbyDirty()
	return true
end

-- a late joiner enters the run in its Hall / Corridor (earlier rooms pay nothing: JoinedRoom = the next fight room)
function Dg.lateJoin(run, player)
	if run.State == "Ending" or not run.Joinable then
		return false, "That run is closed"
	end
	-- a member who LEFT keeps their record (Left, loot, Runs + 1): a second record would list them twice in run.Order and
	-- the next OpenEncounter refuses the whole party ("DuplicatePlayer")
	if run.Members[player.UserId] then
		return false, "You left this run"
	end
	if countLive(run) >= K.MAX_PARTY then
		return false, "That party is full"
	end
	local ok, spec = canEnter(player, run.Floor, false, true)
	if not ok then
		return false, spec
	end
	local joinedRoom = (run.State == "Hall") and 1 or (run.Room + ((run.Phase == "Threshold") and 0 or 1))
	local member = newMember(run, player, spec, max(1, joinedRoom))
	run.Eased = nil -- no longer solo: the normal room
	bindMember(run, player)
	local target
	if run.State == "Hall" then
		local hall = run.Pocket.Hall
		target = hall and hall.Spawns and hall.Spawns[((#run.Order - 1) % 4) + 1]
	else
		local info = roomInfo(run, run.Room)
		target = info and info.Entrance
		if run.Phase == "Walk" then
			local cleared = roomInfo(run, run.Room)
			target = cleared and cleared.Entrance or target
		end
	end
	teleport(player, target or CFrame.new(run.Pocket.Origin + Vector3.new(0, 4, 0)))
	member.Joined = now()
	sendRun(run)
	markLobbyDirty()
	return true, run.Id
end

-- Dg.enterRoom(run, room): members placed at the Entrance and the room's Run payload sent, THEN room + 1 (and its
-- corridor) built and room - 1 destroyed. (wave 6: Roblox replicates in one ordered stream, so the ~400-540 instances of
-- room + 1 built before sendRun went out AHEAD of the payload and could hold it past the client's fade: no walk-in)
function Dg.enterRoom(run, room)
	if run.State == "Ending" then
		return
	end
	local pocket = run.Pocket
	local DB = St.deps.DungeonBuilder
	if room >= 5 then
		return Dg.enterTreasure(run)
	end
	local info = DB.PlaceRoom(pocket, room)
	if not info then
		return Dg.endRun(run, false, "Error")
	end
	run.Room = room
	run.Wave = 0
	run.Waves = wavesOf(run, room)
	run.State = "Corridor"
	run.Phase = "Threshold"
	run.StateAt = now()
	run.DoorOpened = nil
	run.Joinable = room <= num(D().LateJoinLastRoom, 2) and countLive(run) < K.MAX_PARTY
	DB.SetDoor(info, "Entrance", true)
	for i, m in ipairs(liveMembers(run)) do
		m.Downed = false
		local cf = info.Entrance * CFrame.new(((i - 1) % 4) * 2.4 - 3.6, 0, 0)
		teleport(m.Player, cf)
	end
	sendRun(run)
	pcall(DB.PlaceRoom, pocket, room + 1)
	if room - 1 >= 1 then
		pcall(DB.RemoveRoom, pocket, room - 1)
	end
	markLobbyDirty()
end

-- the treasure alcove after the boss: chests closed per member, the exit after TreasureSeconds
function Dg.enterTreasure(run)
	if run.State == "Ending" then
		return
	end
	local pocket = run.Pocket
	local DB = St.deps.DungeonBuilder
	local info = DB.PlaceRoom(pocket, 5)
	if not info then
		return Dg.endRun(run, false, "Error")
	end
	run.Room = 4
	run.State = "Treasure"
	run.Phase = nil
	run.StateAt = now()
	run.Joinable = false
	-- one chest per member who qualified in at least one room (5.2: loot goes to QUALIFYING members; Y4: an AFK alt
	-- carried through the floor earns nothing, so no chest either)
	for _, m in ipairs(liveMembers(run)) do
		local uid = m.Player.UserId
		if run.Chests[uid] == nil and qualifiedAnywhere(m) then
			run.Chests[uid] = "Closed"
		end
	end
	if info then
		for i, m in ipairs(liveMembers(run)) do
			local cf = info.Spawns and info.Spawns[((i - 1) % 4) + 1] or info.Entrance
			teleport(m.Player, cf)
		end
	end
	sendRun(run)
	markLobbyDirty()
end

----------------------------------------------------------------------
-- Moving on: the door prompt, the per-member E, the fade, the next room (dungeon-fixes decision 2)
----------------------------------------------------------------------
-- the door the group walks to now -> prompt, targetRoom (5 = the treasure) | nil (fighting, bars still shut, a
-- transit running, the run over)
function Dg.nextDoor(run)
	if run.Transit or not run.Pocket then
		return nil
	end
	if run.State == "Hall" then
		local hall = run.Pocket.Hall
		local prompt = hall and hall.NextPrompt
		return prompt and prompt.Parent and prompt or nil, 1
	end
	if run.State == "Corridor" and run.Phase == "Walk" and run.DoorOpened then
		local prompt
		if run.Room >= 4 then
			local info = roomInfo(run, 4)
			prompt = info and info.NextPrompt
			if prompt and prompt.Parent then
				return prompt, 5
			end
			return nil
		end
		local info = roomInfo(run, run.Room + 1)
		prompt = info and info.EnterPrompt
		if prompt and prompt.Parent then
			return prompt, run.Room + 1
		end
	end
	return nil
end

-- exactly the current door's prompt is enabled (sendRun calls this at every state change)
function Dg.syncPrompt(run)
	local prompt = (run.State ~= "Ending") and Dg.nextDoor(run) or nil
	local old = run.ActivePrompt
	if old and old ~= prompt then
		pcall(function()
			old.Enabled = false
		end)
	end
	run.ActivePrompt = prompt
	if prompt and prompt.Enabled ~= true then
		pcall(function()
			prompt.Enabled = true
		end)
	end
end

-- Dg.confirm(run, player, prompt) -> ok, why: one member's E at the open door (idempotent)
function Dg.confirm(run, player, prompt)
	if run.Transit then
		return false, "Transit"
	end
	if run.State ~= "Hall" and run.State ~= "Corridor" then
		return false, "State"
	end
	local uid = player.UserId
	local m = run.Members[uid]
	if not m or m.Left then
		return false, "NotMember"
	end
	local door, target = Dg.nextDoor(run)
	if not door or door ~= prompt then
		return false, "NotNow"
	end
	local part = prompt.Parent
	local root = rootOf(player)
	if not root or typeof(part) ~= "Instance" or not part:IsA("BasePart") or (root.Position - part.Position).Magnitude > K.CONFIRM_RANGE then
		return false, "Far"
	end
	if run.ConfirmFor ~= target then
		run.Confirm = {}
		run.ConfirmFor = target
	end
	if run.Confirm[uid] then
		return true, "Already"
	end
	run.Confirm[uid] = true
	if not Dg.checkConfirm(run) then
		sendRun(run)
	end
	return true
end

-- every member still in the run (not Left; Downed ones too) pressed E -> the transit (true when it began)
function Dg.checkConfirm(run)
	if run.Transit or run.State == "Ending" then
		return false
	end
	local door, target = Dg.nextDoor(run)
	if not door or run.ConfirmFor ~= target then
		return false
	end
	local live = liveMembers(run)
	if #live == 0 then
		return false
	end
	for _, m in ipairs(live) do
		if not run.Confirm[m.Player.UserId] then
			return false
		end
	end
	return Dg.transit(run, target)
end

-- the lock, the fade to every member, the next room after FADE.Out (once: TransitSeq + the state it left from)
function Dg.transit(run, target)
	if run.Transit then
		return false
	end
	run.Transit = true
	run.TransitSeq = (run.TransitSeq or 0) + 1
	local seq = run.TransitSeq
	local from = tostring(run.State) .. ":" .. tostring(run.Room)
	local fade = { Out = FADE.Out, Hold = FADE.Hold, In = FADE.In, Room = target }
	for _, m in ipairs(liveMembers(run)) do
		sendState(m.Player, "Fade", fade)
	end
	sendRun(run)
	task.delay(FADE.Out, function()
		local ok, err = pcall(Dg.finishTransit, run, seq, target, from)
		if not ok then
			warn("[DungeonService] the room change failed: " .. tostring(err))
			pcall(Dg.endRun, run, false, "Error")
		end
	end)
	return true
end

function Dg.finishTransit(run, seq, target, from)
	if not run.Transit or run.TransitSeq ~= seq then
		return false
	end
	run.Transit = nil
	run.Confirm = {}
	run.ConfirmFor = nil
	if run.State == "Ending" or (tostring(run.State) .. ":" .. tostring(run.Room)) ~= from then
		sendRun(run)
		return false
	end
	if countLive(run) == 0 then
		return false
	end
	if target >= 5 then
		local info = roomInfo(run, 4)
		if info then
			St.deps.DungeonBuilder.SetDoor(info, "Exit", true)
		end
		Dg.enterTreasure(run)
	else
		Dg.enterRoom(run, target)
	end
	return true
end

local function spawnWave(run, wave)
	local BC = catalog()
	local BS = St.deps.BattleService
	if not BC or not run.Battle then
		return false
	end
	local n = countLive(run)
	local opts = (run.Eased == true and run.Floor == 1 and run.Room == 1) and { Eased = true } or nil
	local okW, plan = pcall(BC.DungeonWave, run.Floor, run.Room, wave, n, run.Seed, opts)
	if not okW or type(plan) ~= "table" or type(plan.Pets) ~= "table" or #plan.Pets == 0 then
		warn("[DungeonService] DungeonWave failed: " .. tostring(plan))
		return false
	end
	-- the room's spawn point when its template names one (the Throne: at the foot of the dais, not on the throne)
	local info = roomInfo(run, run.Room)
	local anchor = info and type(info.SpawnAnchor) == "table" and info.SpawnAnchor or nil
	local infos, why = BS.SpawnWave(run.Battle, plan.Pets, { Wave = wave, Name = plan.Name or ("Wave " .. tostring(wave)), Anchor = anchor })
	if not infos then
		warn("[DungeonService] SpawnWave refused: " .. tostring(why))
		return false
	end
	run.Wave = wave
	return true
end

-- Dg.startFight(run): the encounter of the current room
function Dg.startFight(run)
	if run.State ~= "Corridor" or run.Phase ~= "Threshold" then
		return false
	end
	local BS = St.deps.BattleService
	local room = run.Room
	local info = roomInfo(run, room)
	if not info or not info.Zone then
		return Dg.endRun(run, false, "Error")
	end
	local teams = {}
	for i, m in ipairs(liveMembers(run)) do
		local spec = try(BS, "TeamSpec", m.Player, m.Keys)
		if type(spec) ~= "table" then
			spec = m.Spec
		end
		m.Spec = spec
		m.Downed = false
		teams[#teams + 1] = { Player = m.Player, Spec = spec }
		-- bug #26: a member already inside the room (walked in) keeps their spot; anyone else (still in the corridor, no
		-- character, elsewhere) is placed on the Threshold line, never yanked back to the Entrance
		local root = rootOf(m.Player)
		if not (root and Dg.insideBox(info.Zone, root.Position)) then
			local line = info.Threshold and info.Threshold.Parent and (info.Threshold.CFrame * CFrame.new(((i - 1) % 4) * 2.4 - 3.6, -1, 0)) -- (the part is centred 2.5 up: a root 3 up, like the Entrance)
				or (info.Entrance * CFrame.new(((i - 1) % 4) * 2.4 - 3.6, 0, 0))
			teleport(m.Player, line)
		end
	end
	if #teams == 0 then
		return Dg.endRun(run, false, "Abandoned")
	end
	local d = D()
	local timeLimit = (run.Floor == 1) and num(d.Floor1RoomTime, 180) or num(d.RoomTime, 120)
	local waves = wavesOf(run, room)
	-- the encounter's centre is the room's FLOOR (RoomInfo.ZoneFloor; the zone part floats 6 studs above it and stays
	-- the presence box); a builder without ZoneFloor: the part's centre moved down to the floor top (FloorY)
	local floorCf = info.ZoneFloor
	if typeof(floorCf) ~= "CFrame" then
		local fy = info.Zone:GetAttribute("FloorY")
		floorCf = info.Zone.CFrame * CFrame.new(0, (finite(fy) and fy or (info.Zone.Position.Y - 6)) - info.Zone.Position.Y, 0)
	end
	-- bug #26: the followers park only now (BattleController draws the team from the Start it is about to send)
	for _, team in ipairs(teams) do
		setInFight(team.Player, true)
	end
	local id, why = BS.OpenEncounter({
		Mode = "Dungeon",
		Zone = { CFrame = floorCf, Size = info.Zone.Size, Part = info.Zone },
		Seed = run.Seed + room * 17,
		TimeLimit = timeLimit,
		Label = run.Name .. " room " .. tostring(room),
		Teams = teams,
		Extra = { Floor = run.Floor, Room = room, Wave = 1, Waves = waves, Name = run.Name, Element = run.Element, Boss = room == 4, RunId = run.Id },
		KeepInBattle = true,
		OnEnd = function(battleId, result)
			Dg.onRoomEnd(run, result, battleId)
		end,
		OnWave = function(battleId, waveIndex)
			Dg.onWave(run, waveIndex, battleId)
		end,
		OnBossHp = function(battleId, frac)
			Dg.onBossHp(run, frac, battleId)
		end,
		OnDown = function(battleId, player, livesLeft)
			Dg.onDown(run, player, livesLeft, battleId)
		end,
		OnLeave = function(battleId, player, leaveWhy)
			Dg.onLeave(run, player, leaveWhy, battleId)
		end,
	})
	if not id then
		warn("[DungeonService] OpenEncounter refused: " .. tostring(why))
		for _, m in ipairs(liveMembers(run)) do
			notify(m.Player, "The fight could not start: " .. tostring(why), "bad", 4)
		end
		return Dg.endRun(run, false, "Error")
	end
	run.Battle = id
	run.LastBattle = id
	St.runByBattle[id] = run
	run.State = "Fight"
	run.Phase = nil
	run.StateAt = now()
	run.FightAt = now()
	run.Waves = waves
	run.Wave = 1
	run.EscortSpawned = false
	run.BattleMissingSince = nil
	run.Joinable = false
	St.deps.DungeonBuilder.SetDoor(info, "Entrance", false)
	if not spawnWave(run, 1) then
		return Dg.endRun(run, false, "Error")
	end
	sendRun(run)
	markLobbyDirty()
	return true
end

function Dg.onWave(run, waveIndex, battleId)
	if run.State ~= "Fight" then
		return
	end
	if battleId and run.Battle ~= battleId then
		return
	end
	local BS = St.deps.BattleService
	-- BattleSim fires EnemiesDown per wave TEAM: the room is cleared only when no enemy at all is left (the boss room:
	-- boss AND escort down, 5.4; whichever falls last fires the EnemiesDown that clears)
	local status = try(BS, "EncounterStatus", run.Battle)
	local enemiesLeft = type(status) == "table" and tonumber(status.Enemies) or 0
	if run.Room == 4 then
		if not run.EscortSpawned then
			Dg.spawnEscort(run)
			return
		end
		if enemiesLeft > 0 then
			return
		end
		BS.FinishEncounter(run.Battle, "Cleared")
		return
	end
	if waveIndex < run.Waves then
		local id = run.Battle
		task.delay(K.NEXT_WAVE, function()
			if run.State == "Fight" and run.Battle == id then
				if spawnWave(run, waveIndex + 1) then
					sendRun(run)
				else
					BS.FinishEncounter(id, "Cleared")
				end
			end
		end)
	elseif enemiesLeft == 0 then
		BS.FinishEncounter(run.Battle, "Cleared")
	end
end

function Dg.spawnEscort(run)
	if run.State ~= "Fight" or run.EscortSpawned or run.Room ~= 4 then
		return
	end
	run.EscortSpawned = true
	if spawnWave(run, 2) then
		sendRun(run)
	end
end

function Dg.onBossHp(run, frac, battleId)
	if run.State ~= "Fight" then
		return
	end
	if battleId and run.Battle ~= battleId then
		return
	end
	if run.Room == 4 and finite(frac) and frac <= num(D().EscortAt, 0.5) then
		Dg.spawnEscort(run)
	end
end

function Dg.onDown(run, player, livesLeft, battleId)
	if run.State ~= "Fight" then
		return
	end
	if battleId and run.Battle ~= battleId then
		return
	end
	local m = isPlayer(player) and run.Members[player.UserId] or nil
	if m and not m.Left then
		m.Downed = true
		sendRun(run)
	end
end

function Dg.onLeave(run, player, why, battleId)
	if run.State ~= "Fight" then
		return
	end
	if battleId and run.Battle ~= battleId then
		return
	end
	Dg.removeMember(run, player, why or "Left")
end

-- the loot of a cleared room: once per room per qualifying fighter (result.Fighters), marked before paying
function Dg.payRoom(run, room, result)
	local BC = catalog()
	local DS, PC, TS, BS = St.deps.DataService, St.deps.PetCareService, St.deps.TycoonService, St.deps.BattleService
	local mult = St.deps.Multipliers -- store: x2 Cash with the pass (Init deps only); Tokens and XP are not its business
	if not BC then
		return
	end
	run.Paid[room] = run.Paid[room] or {}
	local paid = run.Paid[room]
	local waves = (room == 4) and num(D().BossRoomWaves, 4) or run.Waves
	local double = try(BS, "IsDoubleRewards") == true
	for _, uid in ipairs(type(result.Fighters) == "table" and result.Fighters or {}) do
		local m = run.Members[uid]
		if m and not m.Left and (m.JoinedRoom or 1) <= room and not paid[uid] then
			paid[uid] = true
			m.Qualified[room] = true
			local income = try(TS, "IncomePerSecond", m.Player) or 0
			local okR, rewards = pcall(BC.DungeonRewards, run.Floor, room, waves, income, double)
			if okR and type(rewards) == "table" then
				local loot = lootOf(run, uid)
				local cash, tokens, xp = floor(num(rewards.Cash, 0)), floor(num(rewards.Tokens, 0)), floor(num(rewards.Xp, 0))
				cash = mult and mult.Cash(m.Player, cash, "Dungeon") or cash
				if cash > 0 then
					try(DS, "AddCash", m.Player, cash)
				end
				if tokens > 0 then
					try(DS, "AddTokens", m.Player, tokens)
				end
				local levelUps = 0
				if xp > 0 then
					for _, key in ipairs(m.Keys) do
						local _, levels = try(PC, "GrantXp", m.Player, key, xp, "Dungeon")
						levelUps = levelUps + (tonumber(levels) or 0)
					end
				end
				loot.Cash = loot.Cash + cash
				loot.Tokens = loot.Tokens + tokens
				loot.Xp = loot.Xp + xp
				sendState(m.Player, "Loot", { Room = room, Cash = cash, Tokens = tokens, Xp = xp, LevelUps = levelUps })
			end
		end
	end
end

-- the loss third of the room that ends a run (RealLoss: >= 20 s or >= 20% damage; never Quit / leave / disconnect / shutdown)
function Dg.payLoss(run, room, result)
	local BC = catalog()
	if not BC or type(result) ~= "table" then
		return
	end
	local dealt = 0
	if type(result.Hp) == "table" and finite(result.Hp[2]) then
		dealt = max(0, min(1, 1 - result.Hp[2]))
	end
	local okL, real = pcall(BC.RealLoss, num(result.Duration, 0), dealt)
	if not okL or not real then
		return
	end
	run.Paid[room] = run.Paid[room] or {}
	local paid = run.Paid[room]
	local waves = (room == 4) and num(D().BossRoomWaves, 4) or run.Waves
	local PC, TS = St.deps.PetCareService, St.deps.TycoonService
	for _, uid in ipairs(type(result.Fighters) == "table" and result.Fighters or {}) do
		local m = run.Members[uid]
		if m and not m.Left and (m.JoinedRoom or 1) <= room and not paid[uid] then
			paid[uid] = true
			local income = try(TS, "IncomePerSecond", m.Player) or 0
			local okR, rewards = pcall(BC.DungeonRewards, run.Floor, room, waves, income, false)
			local xp = okR and type(rewards) == "table" and floor(num(rewards.Xp, 0) / 3 + 0.5) or 0
			if xp > 0 then
				for _, key in ipairs(m.Keys) do
					try(PC, "GrantXp", m.Player, key, xp, "Dungeon")
				end
				lootOf(run, uid).Xp = lootOf(run, uid).Xp + xp
				sendState(m.Player, "Loot", { Room = room, Cash = 0, Tokens = 0, Xp = xp, LevelUps = 0, Loss = true })
			end
		end
	end
end

-- the floor cleared: Best / Cleared / Clears inside MutateDungeon (first clears paid when it says so), chests, the board
function Dg.clearFloor(run)
	local BC = catalog()
	local DS = St.deps.DataService
	local floorIndex = run.Floor
	run.Cleared = true
	for _, m in ipairs(liveMembers(run)) do
		local qualifies = m.Qualified[4] == true and (m.Qualified[1] or m.Qualified[2] or m.Qualified[3]) == true
		local before = record(m.Player)
		local ok, first
		if qualifies then
			ok, first = try(DS, "MutateDungeon", m.Player, function(rec)
				rec.Best = max(tonumber(rec.Best) or 0, floorIndex)
				rec.Cleared = type(rec.Cleared) == "table" and rec.Cleared or {}
				rec.Cleared[floorIndex] = true
				rec.Clears = (tonumber(rec.Clears) or 0) + 1
			end)
			m.ClearedFloor = true
			m.Qualified.Floor = true
		else
			ok = try(DS, "MutateDungeon", m.Player, function(rec)
				rec.Best = max(tonumber(rec.Best) or 0, floorIndex)
			end)
		end
		m.NewBest = (tonumber(before.Best) or 0) < floorIndex
		m.Unlocked = (floorIndex < 12) and (floorIndex + 1) or nil
		if ok and first == true and qualifies and BC then
			local okF, reward = pcall(BC.DungeonFirstClear, floorIndex)
			if okF and type(reward) == "table" then
				local tokens, gems = floor(num(reward.Tokens, 0)), floor(num(reward.Gems, 0))
				if tokens > 0 then
					try(DS, "AddTokens", m.Player, tokens)
				end
				if gems > 0 then
					try(DS, "AddGems", m.Player, gems)
				end
				local loot = lootOf(run, m.Player.UserId)
				loot.Tokens = loot.Tokens + tokens
				loot.Gems = loot.Gems + gems
				m.FirstClear = { Tokens = tokens, Gems = gems }
				notify(m.Player, "First clear of floor " .. tostring(floorIndex) .. "! +" .. tostring(tokens) .. " tokens, +" .. tostring(gems) .. " gems", "good", 5)
			end
		end
		if qualifies then
			local name = m.Player.Name
			if (St.board[name] or 0) < floorIndex then
				St.board[name] = floorIndex
			end
			pcall(DungeonService.FloorCleared.Fire, DungeonService.FloorCleared, m.Player, floorIndex)
		end
	end
	updateBoard()
end

-- Dg.onRoomEnd(run, result): Cleared -> loot + the bars; Wipe / Timeout -> the loss third and the end of the run
function Dg.onRoomEnd(run, result, battleId)
	if run.State ~= "Fight" then
		return
	end
	if battleId and run.Battle ~= battleId then
		return
	end
	-- bug #26: the fight is over (every reason): the followers come back
	for _, m in ipairs(liveMembers(run)) do
		setInFight(m.Player, nil)
	end
	result = type(result) == "table" and result or { Reason = "Error" }
	local room = run.Room
	local id = run.Battle
	run.Battle = nil
	if id then
		St.runByBattle[id] = nil
	end
	local reason = tostring(result.Reason or "Error")
	if reason == "Cleared" then
		Dg.payRoom(run, room, result)
		for _, m in ipairs(liveMembers(run)) do
			pcall(DungeonService.RoomCleared.Fire, DungeonService.RoomCleared, m.Player, run.Floor, room)
		end
		if room == 4 then
			Dg.clearFloor(run)
		end
		run.State = "Corridor"
		run.Phase = "Walk"
		run.StateAt = now()
		run.DoorOpened = false
		run.Joinable = room <= num(D().LateJoinLastRoom, 2) and countLive(run) < K.MAX_PARTY
		sendRun(run)
		markLobbyDirty()
	elseif reason == "Wipe" or reason == "Timeout" then
		Dg.payLoss(run, room, result)
		for _, m in ipairs(liveMembers(run)) do
			notify(m.Player, "Floor " .. tostring(run.Floor) .. ": the " .. tostring(run.Name) .. " got you in room " .. tostring(room) .. ". Train your team and try again!", "bad", 6)
		end
		Dg.endRun(run, false, reason)
	elseif reason == "Abandoned" then
		if countLive(run) > 0 then
			Dg.endRun(run, false, "Abandoned")
		end
	else
		Dg.endRun(run, false, reason)
	end
end

-- Dg.removeMember(run, player, why): that member only (Quit / Left / Leash / Disconnect / Kick); the last one out ends the run
function Dg.removeMember(run, player, why)
	local uid = isPlayer(player) and player.UserId or (type(player) == "number" and player) or nil
	local m = uid and run.Members[uid] or nil
	if not m or m.Left then
		return false
	end
	m.Left = true
	m.LeftWhy = why
	local BS = St.deps.BattleService
	if run.State == "Fight" and run.Battle then
		pcall(BS.RemoveEncounterTeam, run.Battle, m.Player)
	end
	if run.State == "Treasure" and run.Chests[uid] == "Closed" then
		pcall(Dg.openChest, run, m, nil, true)
	end
	pcall(function()
		try(St.deps.DataService, "MutateDungeon", m.Player, function(rec)
			rec.Runs = (tonumber(rec.Runs) or 0) + 1
		end)
	end)
	if run.State ~= "Ending" then
		sendState(m.Player, "End", endPayload(run, m, why))
	end
	unbindMember(run, m.Player)
	local party = run.Party
	if party then
		dropPartyMember(party, uid)
		-- the leader out while others fight on: the party record is re-keyed to the first live member, so the run stays
		-- listed / joinable under its new leader and the old leader may open or join another party at once
		if party.Leader == m.Player and run.State ~= "Ending" then
			local heir = nil
			for _, ouid in ipairs(run.Order) do
				local om = run.Members[ouid]
				if om and not om.Left and isPlayer(om.Player) then
					heir = om.Player
					break
				end
			end
			if heir and St.parties[uid] == party then
				St.parties[uid] = nil
				St.parties[heir.UserId] = party
				for i, id in ipairs(St.partyOrder) do
					if id == uid then
						St.partyOrder[i] = heir.UserId
					end
				end
				party.Leader = heir
				if not party.Members[heir.UserId] then
					local spec = try(St.deps.BattleService, "TeamSpec", heir)
					party.Members[heir.UserId] = { Player = heir, Ready = true, Keys = keysOf(spec), Power = powerOf(spec) }
					party.Order[#party.Order + 1] = heir.UserId
				end
				St.partyOf[heir] = party
			end
		end
	end
	if St.partyOf[m.Player] == party then
		St.partyOf[m.Player] = nil
	end
	if why ~= "Disconnect" and why ~= "Left" and isPlayer(m.Player) then
		returnHome(m.Player)
	end
	if run.State ~= "Ending" then
		run.Joinable = run.Joinable and countLive(run) < K.MAX_PARTY
		sendRun(run)
		markLobbyDirty()
		if countLive(run) == 0 then
			Dg.endRun(run, false, why == "Disconnect" and "Disconnect" or "Abandoned")
		else
			-- the others may all have pressed E at the door already: the leaver no longer holds them up
			Dg.checkConfirm(run)
		end
	end
	return true
end

-- the alcove's chest parts by slot ({} when the treasure room is not built)
local function chestParts(run)
	local info = roomInfo(run, 5)
	return info and type(info.Chests) == "table" and info.Chests or {}
end

-- the first chest nobody took (a built one first); past CHEST_SLOTS only if every chest is gone (never with
-- MAX_PARTY <= CHEST_SLOTS, but a member is never left without their drop)
function Dg.freeChest(run)
	local parts = chestParts(run)
	for slot = 1, K.CHEST_SLOTS do
		if not run.ChestTaken[slot] and parts[slot] and parts[slot].Parent then
			return slot
		end
	end
	local slot = 1
	while run.ChestTaken[slot] do
		slot = slot + 1
	end
	return slot
end

-- the picked chest: Opened / OpenedBy on the part, its prompt off for everyone, a warm glow and a burst of sparks (the
-- Blender chest is one closed mesh: an open-lid mesh is wanted, wave 3 art)
function Dg.markChest(run, slot, m)
	local part = chestParts(run)[slot]
	if not part or not part.Parent then
		return false
	end
	pcall(function()
		part:SetAttribute("Opened", true)
		part:SetAttribute("OpenedBy", m.Player.UserId)
		part:SetAttribute("OpenedByName", shortName(m.Player))
		local prompt = part:FindFirstChild("ChestPrompt")
		if prompt then
			prompt.Enabled = false
		end
		if not part:FindFirstChild("OpenGlow") then
			local glow = Instance.new("PointLight")
			glow.Name = "OpenGlow"
			glow.Color = Color3.fromRGB(255, 196, 80)
			glow.Brightness = 2
			glow.Range = 9
			glow.Shadows = false
			glow.Parent = part
			local burst = Instance.new("ParticleEmitter")
			burst.Name = "OpenBurst"
			FxSprites.Apply(burst, "Sparkle")
			burst.Color = ColorSequence.new(Color3.fromRGB(255, 214, 90))
			burst.LightEmission = 0.8
			burst.Rate = 0
			burst.Lifetime = NumberRange.new(0.6, 1.1)
			burst.Speed = NumberRange.new(6, 10)
			burst.SpreadAngle = Vector2.new(35, 35)
			burst.Size = NumberSequence.new(0.35, 0)
			burst.EmissionDirection = Enum.NormalId.Top
			burst.Parent = part
			burst:Emit(24)
		end
	end)
	return true
end

-- a member's boss chest (bug batch 2, #14): the member picks ONE of the alcove's chests; each chest is its own roll
-- (run seed + slot), paid once (the marks are written first). auto = the 45 s exit / a member leaving: the first free
-- chest, no range check.
function Dg.openChest(run, m, slot, auto)
	local uid = m.Player.UserId
	if run.Chests[uid] ~= "Closed" then
		return false, "No chest"
	end
	run.ChestTaken = run.ChestTaken or {}
	if auto then
		slot = Dg.freeChest(run)
	else
		if not finite(slot) or slot ~= floor(slot) or slot < 1 or slot > K.CHEST_SLOTS then
			return false, "Pick a chest: walk to one and press E"
		end
		local part = chestParts(run)[slot]
		if not part or not part.Parent then
			return false, "That chest is not here"
		end
		if run.ChestTaken[slot] then
			return false, "That chest is taken, pick another one"
		end
		local root = rootOf(m.Player)
		if not root or (root.Position - part.Position).Magnitude > K.CHEST_RANGE then
			return false, "Walk to the chest first"
		end
	end
	run.Chests[uid] = "Opened"
	run.ChestTaken[slot] = uid
	m.ChestSlot = slot
	Dg.markChest(run, slot, m)
	local BC = catalog()
	local DS, TS = St.deps.DataService, St.deps.TycoonService
	local mult = St.deps.Multipliers -- store: x2 Cash with the pass on a Cash chest only
	if not BC then
		return false
	end
	local okC, chest = pcall(BC.DungeonChest, run.Floor, run.Seed + slot * 7919)
	if not okC or type(chest) ~= "table" then
		return false
	end
	local loot = lootOf(run, uid)
	local amount = floor(num(chest.Amount, 0))
	if chest.Kind == "Cash" then
		local income = try(TS, "IncomePerSecond", m.Player) or 0
		amount = max(amount, floor(income * num(chest.Seconds, 30)))
		amount = mult and mult.Cash(m.Player, amount, "Chest") or amount
		if amount > 0 then
			try(DS, "AddCash", m.Player, amount)
		end
		loot.Cash = loot.Cash + amount
	elseif chest.Kind == "Tokens" then
		if amount > 0 then
			try(DS, "AddTokens", m.Player, amount)
		end
		loot.Tokens = loot.Tokens + amount
	elseif chest.Kind == "Gems" then
		if amount > 0 then
			try(DS, "AddGems", m.Player, amount)
		end
		loot.Gems = loot.Gems + amount
	end
	m.Chest = { Kind = chest.Kind, Amount = amount, Slot = slot }
	sendState(m.Player, "Chest", { Kind = chest.Kind, Amount = amount, Slot = slot })
	if not auto and run.State == "Treasure" then
		-- the others' cards: who still has a chest to pick
		sendRun(run)
	end
	return true, m.Chest
end

local function finishRun(run)
	if run.Finished then
		return
	end
	run.Finished = true
	for _, uid in ipairs(run.Order) do
		local m = run.Members[uid]
		if m then
			pcall(function()
				if not m.Left and isPlayer(m.Player) and run.EndReason ~= "Shutdown" then
					returnHome(m.Player)
				end
			end)
			pcall(unbindMember, run, m.Player)
			pcall(function()
				-- a member who left earlier may already lead or sit in ANOTHER party: only this run's party link goes
				if St.partyOf[m.Player] == run.Party then
					St.partyOf[m.Player] = nil
				end
			end)
		end
	end
	pcall(function()
		St.deps.DungeonBuilder.FreeRun(run.PocketIndex)
	end)
	St.pocketBusy[run.PocketIndex] = nil
	St.runs[run.Id] = nil
	for i, id in ipairs(St.runOrder) do
		if id == run.Id then
			table.remove(St.runOrder, i)
			break
		end
	end
	if run.LastBattle then
		St.runByBattle[run.LastBattle] = nil
	end
	local party = run.Party
	if party and St.parties[party.Leader.UserId] == party then
		St.parties[party.Leader.UserId] = nil
		for i, id in ipairs(St.partyOrder) do
			if id == party.Leader.UserId then
				table.remove(St.partyOrder, i)
				break
			end
		end
		for _, uid in ipairs(party.Order) do
			local pm = party.Members[uid]
			if pm then
				St.partyOf[pm.Player] = nil
			end
		end
	end
	if not run.Fired then
		run.Fired = true
		local members, winners = {}, {}
		for _, uid in ipairs(run.Order) do
			members[#members + 1] = uid
			local m = run.Members[uid]
			if m and m.ClearedFloor then
				winners[#winners + 1] = uid
			end
		end
		pcall(DungeonService.RunEnded.Fire, DungeonService.RunEnded, run.Id, { Floor = run.Floor, Cleared = run.Cleared == true, Members = members, Winners = winners, Loot = run.Loot, Reason = run.EndReason })
	end
	markLobbyDirty()
end

-- Dg.endRun(run, cleared, reason, immediate): idempotent; every step in its own pcall; ALWAYS releases the members, the
-- pocket and fires RunEnded once
function Dg.endRun(run, cleared, reason, immediate)
	if run.State == "Ending" then
		return false
	end
	-- a run killed at the Treasure (the watchdog): the chests already earned open for their owners first (same mark,
	-- once); a Shutdown stays void
	if run.State == "Treasure" and reason ~= "Shutdown" then
		for _, m in ipairs(liveMembers(run)) do
			if run.Chests[m.Player.UserId] == "Closed" then
				pcall(Dg.openChest, run, m, nil, true)
			end
		end
	end
	run.State = "Ending"
	run.Phase = nil
	run.Joinable = false
	run.Transit = nil
	pcall(Dg.syncPrompt, run)
	run.EndReason = reason or (cleared and "Cleared" or "Ended")
	if cleared then
		run.Cleared = true
	end
	run.EndedAt = now()
	-- 1. the encounter, if one still runs (its OnEnd returns at once: the state is Ending)
	pcall(function()
		local id = run.Battle
		run.Battle = nil
		if id then
			St.runByBattle[id] = nil
			St.deps.BattleService.FinishEncounter(id, reason == "Shutdown" and "Shutdown" or "Abandoned")
		end
	end)
	-- 2. Runs + 1 and the End card for everyone still in
	for _, m in ipairs(liveMembers(run)) do
		setInFight(m.Player, nil)
		pcall(function()
			try(St.deps.DataService, "MutateDungeon", m.Player, function(rec)
				rec.Runs = (tonumber(rec.Runs) or 0) + 1
			end)
		end)
		pcall(function()
			sendState(m.Player, "End", endPayload(run, m, run.EndReason))
		end)
	end
	-- 3. the return after RETURN_DELAY (now on a shutdown or when nobody is left), then the release + RunEnded
	if immediate or countLive(run) == 0 or St.closing then
		pcall(finishRun, run)
	else
		task.delay(K.RETURN_DELAY, function()
			pcall(finishRun, run)
		end)
	end
	return true
end

----------------------------------------------------------------------
-- Parties
----------------------------------------------------------------------
local function partyOfLeader(leaderUserId)
	return St.parties[leaderUserId]
end

local function removeParty(party)
	St.parties[party.Leader.UserId] = nil
	for i, id in ipairs(St.partyOrder) do
		if id == party.Leader.UserId then
			table.remove(St.partyOrder, i)
			break
		end
	end
	for _, uid in ipairs(party.Order) do
		local pm = party.Members[uid]
		if pm and St.partyOf[pm.Player] == party then
			St.partyOf[pm.Player] = nil
		end
	end
	markLobbyDirty()
end

function DungeonService.CreateParty(player, floorIndex)
	if not isPlayer(player) then
		return false, "That player is not here"
	end
	floorIndex = whole(tonumber(floorIndex), 1, 12)
	if not floorIndex then
		return false, "Pick a floor"
	end
	if St.runOf[player] then
		return false, "Finish your dungeon run first"
	end
	if St.partyOf[player] then
		return false, "You are already in a party"
	end
	-- (safety net: the key is re-assigned to a live member when a leader leaves a run, so this never holds a running
	-- party; it is never overwritten while a run uses it)
	local old = St.parties[player.UserId]
	if old and old.Run and old.Run.State ~= "Ending" and not old.Run.Finished then
		return false, "Your old party is still in the dungeon"
	end
	if St.joinQueue[player] then
		St.joinQueue[player] = nil
	end
	local ok, why = profileReady(player)
	if not ok then
		return false, why
	end
	local rec = record(player)
	if (tonumber(rec.Best) or 0) < floorIndex - 1 then
		return false, "Clear floor " .. tostring(floorIndex - 1) .. " first"
	end
	local spec = try(St.deps.BattleService, "TeamSpec", player)
	local party = {
		Leader = player,
		Floor = floorIndex,
		Members = {},
		Order = {},
		Created = now(),
		Run = nil,
		StartAt = nil,
	}
	party.Members[player.UserId] = { Player = player, Ready = true, Keys = keysOf(spec), Power = powerOf(spec) }
	party.Order[1] = player.UserId
	St.parties[player.UserId] = party
	local listed = false
	for _, id in ipairs(St.partyOrder) do
		if id == player.UserId then
			listed = true
		end
	end
	if not listed then
		St.partyOrder[#St.partyOrder + 1] = player.UserId
	end
	St.partyOf[player] = party
	markLobbyDirty()
	return true, party
end

function DungeonService.JoinParty(player, leaderUserId)
	if not isPlayer(player) then
		return false, "That player is not here"
	end
	leaderUserId = whole(tonumber(leaderUserId), 1)
	if not leaderUserId then
		return false, "That party is gone"
	end
	if St.runOf[player] then
		return false, "Finish your dungeon run first"
	end
	local party = partyOfLeader(leaderUserId)
	if not party then
		return false, "That party is gone"
	end
	if St.partyOf[player] == party then
		return false, "You are already in that party"
	end
	if St.partyOf[player] then
		return false, "Leave your party first"
	end
	local ok, why = profileReady(player)
	if not ok then
		return false, why
	end
	if not ownsPet(player) then
		return false, "You need a pet"
	end
	-- a new JOIN replaces a pending queued join (one queue entry per player)
	St.joinQueue[player] = nil
	local run = party.Run
	if run then
		if run.State == "Ending" then
			return false, "That run is over"
		end
		local lastRoom = num(D().LateJoinLastRoom, 2)
		if run.Room > lastRoom or (run.State ~= "Hall" and run.State ~= "Corridor" and run.State ~= "Fight") then
			return false, "That party is past room " .. tostring(lastRoom)
		end
		if run.Members[player.UserId] then
			return false, "You left this run"
		end
		if countLive(run) >= K.MAX_PARTY then
			return false, "That party is full"
		end
		if run.State == "Fight" or run.Transit then
			-- 5.3: a join during a fight of room 1 / 2 (or a room change) waits (<= JOIN_QUEUE) for the corridor;
			-- tickQueue enters them there
			St.joinQueue[player] = { Party = party, Deadline = now() + K.JOIN_QUEUE }
			notify(player, "Joining when the room is cleared", "info", 4)
			markLobbyDirty()
			return true, "Queued"
		end
		local okJ, whyJ = Dg.lateJoin(run, player)
		if not okJ then
			return false, whyJ
		end
		local spec = try(St.deps.BattleService, "TeamSpec", player)
		party.Members[player.UserId] = { Player = player, Ready = true, Keys = keysOf(spec), Power = powerOf(spec) }
		party.Order[#party.Order + 1] = player.UserId
		St.partyOf[player] = party
		markLobbyDirty()
		return true, run.Id
	end
	if partyCount(party) >= K.MAX_PARTY then
		return false, "That party is full"
	end
	local spec = try(St.deps.BattleService, "TeamSpec", player)
	party.Members[player.UserId] = { Player = player, Ready = false, Keys = keysOf(spec), Power = powerOf(spec) }
	party.Order[#party.Order + 1] = player.UserId
	St.partyOf[player] = party
	notify(party.Leader, shortName(player) .. " joined your party", "info", 3)
	markLobbyDirty()
	return true, party
end

function DungeonService.LeaveParty(player)
	if St.joinQueue[player] then
		St.joinQueue[player] = nil
		markLobbyDirty()
		return true
	end
	local party = St.partyOf[player]
	if not party then
		return false, "You are not in a party"
	end
	if party.Run and St.runOf[player] then
		return false, "Use LEAVE in the run"
	end
	if party.Leader == player then
		for _, uid in ipairs(party.Order) do
			local pm = party.Members[uid]
			if pm and pm.Player ~= player then
				notify(pm.Player, "The party was disbanded", "info", 3)
			end
		end
		removeParty(party)
		return true
	end
	party.Members[player.UserId] = nil
	for i, uid in ipairs(party.Order) do
		if uid == player.UserId then
			table.remove(party.Order, i)
			break
		end
	end
	St.partyOf[player] = nil
	markLobbyDirty()
	return true
end

function DungeonService.SetReady(player, ready)
	local party = St.partyOf[player]
	if not party or party.Run then
		return false, "You are not in a party"
	end
	local pm = party.Members[player.UserId]
	if not pm then
		return false, "You are not in a party"
	end
	pm.Ready = ready == true or player == party.Leader
	markLobbyDirty()
	return true
end

function DungeonService.SetFloor(player, floorIndex)
	local party = St.partyOf[player]
	if not party or party.Leader ~= player then
		return false, "Only the leader picks the floor"
	end
	if party.Run then
		return false, "The run already started"
	end
	floorIndex = whole(tonumber(floorIndex), 1, 12)
	if not floorIndex then
		return false, "Pick a floor"
	end
	local rec = record(player)
	if (tonumber(rec.Best) or 0) < floorIndex - 1 then
		return false, "Clear floor " .. tostring(floorIndex - 1) .. " first"
	end
	party.Floor = floorIndex
	markLobbyDirty()
	return true
end

function DungeonService.KickMember(leader, userId)
	local party = St.partyOf[leader]
	if not party or party.Leader ~= leader then
		return false, "Only the leader can do that"
	end
	if party.Run then
		return false, "Not during a run"
	end
	userId = whole(tonumber(userId), 1)
	if not userId or userId == leader.UserId then
		return false, "That player is not in your party"
	end
	local pm = party.Members[userId]
	if not pm then
		return false, "That player is not in your party"
	end
	party.Members[userId] = nil
	for i, uid in ipairs(party.Order) do
		if uid == userId then
			table.remove(party.Order, i)
			break
		end
	end
	St.partyOf[pm.Player] = nil
	notify(pm.Player, "You were removed from the party", "bad", 4)
	markLobbyDirty()
	return true
end

-- StartRun(party) -> ok, runId | reason: now when everyone is ready, else the ReadyTimeout clock
function DungeonService.StartRun(party)
	if type(party) ~= "table" or not isPlayer(party.Leader) then
		return false, "That party is gone"
	end
	if party.Run then
		return false, "The run already started"
	end
	local okL, whyL = canEnter(party.Leader, party.Floor, true, true)
	if not okL then
		return false, whyL
	end
	local unready = 0
	for _, uid in ipairs(party.Order) do
		local pm = party.Members[uid]
		if pm and uid ~= party.Leader.UserId and not pm.Ready then
			unready = unready + 1
		end
	end
	if unready > 0 then
		if party.WaitingReady then
			return false, "Waiting for the party"
		end
		party.WaitingReady = true
		party.StartAt = now() + num(D().ReadyTimeout, 30)
		for _, uid in ipairs(party.Order) do
			local pm = party.Members[uid]
			if pm then
				notify(pm.Player, "Starting in " .. tostring(num(D().ReadyTimeout, 30)) .. " - press READY", "info", 4)
			end
		end
		markLobbyDirty()
		return true, "Waiting"
	end
	if party.StartAt and not party.WaitingReady then
		return false, "Starting"
	end
	party.WaitingReady = nil
	party.StartAt = now() + K.START_COUNTDOWN
	for _, uid in ipairs(party.Order) do
		local pm = party.Members[uid]
		if pm then
			notify(pm.Player, "Dungeon in " .. tostring(K.START_COUNTDOWN) .. "...", "info", 3)
		end
	end
	markLobbyDirty()
	return true, "Countdown"
end

function DungeonService.StartSolo(player, floorIndex)
	if St.runOf[player] then
		return false, "Finish your dungeon run first"
	end
	if St.partyOf[player] then
		return false, "Leave your party first"
	end
	floorIndex = whole(tonumber(floorIndex), 1, 12)
	if not floorIndex then
		return false, "Pick a floor"
	end
	local okE, whyE = canEnter(player, floorIndex, true, true)
	if not okE then
		return false, whyE
	end
	local okC, party = DungeonService.CreateParty(player, floorIndex)
	if not okC then
		return false, party
	end
	local ok, idOrWhy = Dg.begin(party)
	if not ok then
		removeParty(party)
		return false, idOrWhy
	end
	return true, idOrWhy
end

function DungeonService.Quit(player)
	local run = St.runOf[player]
	if not run then
		return false, "You are not in a run"
	end
	if run.State == "Ending" then
		return false, "The run is over"
	end
	Dg.removeMember(run, player, "Quit")
	return true
end

-- slot: the chest the member stands at (its prompt's ChestSlot); no slot opens nothing (bug batch 2, #14)
function DungeonService.OpenChest(player, slot)
	local run = St.runOf[player]
	if not run then
		return false, "You are not in a run"
	end
	if run.State ~= "Treasure" then
		return false, "No chest yet"
	end
	local m = run.Members[player.UserId]
	if not m or m.Left then
		return false, "No chest"
	end
	if run.Chests[player.UserId] == nil then
		return false, "No chest for you this run"
	end
	if run.Chests[player.UserId] ~= "Closed" then
		return false, "You already picked your chest"
	end
	return Dg.openChest(run, m, slot)
end

function DungeonService.GetRun(player)
	local run = isPlayer(player) and St.runOf[player] or nil
	if not run or run.State == "Ending" and run.Finished then
		return nil
	end
	return { RunId = run.Id, Floor = run.Floor, Room = run.Room, State = run.State, Wave = run.Wave }
end

function DungeonService.KeysInRun(player)
	local set = {}
	local run = isPlayer(player) and St.runOf[player] or nil
	local m = run and run.Members[player.UserId] or nil
	if m and not m.Left then
		for _, key in ipairs(m.Keys) do
			set[key] = true
		end
	end
	return set
end

function DungeonService.ListParties()
	local out = {}
	for _, leaderId in ipairs(St.partyOrder) do
		local party = St.parties[leaderId]
		if party then
			out[#out + 1] = { Leader = leaderId, Floor = party.Floor, Count = partyCount(party), InRun = party.Run ~= nil }
		end
	end
	return out
end

function DungeonService.ListRuns()
	local out = {}
	for _, id in ipairs(St.runOrder) do
		local run = St.runs[id]
		if run then
			out[#out + 1] = { RunId = id, Floor = run.Floor, Room = run.Room, State = run.State, Members = countLive(run), Pocket = run.PocketIndex }
		end
	end
	return out
end

function DungeonService.GetParty(player)
	return St.partyOf[player]
end

function DungeonService.RunById(runId)
	return St.runs[runId]
end

function DungeonService.Shutdown()
	St.closing = true
	for _, id in ipairs(copyList(St.runOrder)) do
		local run = St.runs[id]
		if run then
			if run.State ~= "Ending" then
				Dg.endRun(run, false, "Shutdown", true)
			else
				pcall(finishRun, run)
			end
		end
	end
	for _, leaderId in ipairs(copyList(St.partyOrder)) do
		local party = St.parties[leaderId]
		if party then
			removeParty(party)
		end
	end
end

function DungeonService.SetClosing(flag)
	St.closing = flag == true
end

----------------------------------------------------------------------
-- The remote ladder (type -> range -> permission -> plausibility)
----------------------------------------------------------------------
local function allow(player)
	local t = now()
	local b = St.buckets[player]
	if not b then
		b = { tokens = K.BUCKET_BURST, last = t }
		St.buckets[player] = b
	end
	b.tokens = min(K.BUCKET_BURST, b.tokens + (t - b.last) * K.BUCKET_REFILL)
	b.last = t
	if b.tokens < 1 then
		return false
	end
	b.tokens = b.tokens - 1
	return true
end

local function onCooldown(player, action)
	local cd = COOLDOWN[action]
	if not cd then
		return false
	end
	local list = St.cooldowns[player]
	if not list then
		list = {}
		St.cooldowns[player] = list
	end
	local t = now()
	if list[action] and t - list[action] < cd then
		return true
	end
	list[action] = t
	return false
end

local function refuse(player, why)
	if type(why) == "string" and why ~= "" then
		notify(player, why, "bad", 3)
	end
	return false, why
end

function DungeonService.Request(player, action, a, b)
	if not isPlayer(player) or type(action) ~= "string" or not ACTIONS[action] then
		return false, "junk"
	end
	if not allow(player) then
		return false, "rate"
	end
	if onCooldown(player, action) then
		return false, "cooldown"
	end
	if action == "Open" then
		pushLobby(player, false)
		return true
	elseif action == "Create" then
		local ok, why = DungeonService.CreateParty(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Join" then
		local ok, why = DungeonService.JoinParty(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Leave" then
		local ok, why = DungeonService.LeaveParty(player)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Ready" then
		if type(a) ~= "boolean" then
			return false, "junk"
		end
		local ok, why = DungeonService.SetReady(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "SetFloor" then
		local ok, why = DungeonService.SetFloor(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Start" then
		local party = St.partyOf[player]
		if not party or party.Leader ~= player then
			return refuse(player, "Only the leader starts the run")
		end
		local ok, why = DungeonService.StartRun(party)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Solo" then
		local ok, why = DungeonService.StartSolo(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Quit" then
		local ok, why = DungeonService.Quit(player)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Chest" then
		-- a = the chest's slot (the prompt's ChestSlot); OpenChest checks it is free and the player stands at it
		local ok, why = DungeonService.OpenChest(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	elseif action == "Kick" then
		local ok, why = DungeonService.KickMember(player, a)
		if not ok then
			return refuse(player, why)
		end
		return true
	end
	return false, "junk"
end

----------------------------------------------------------------------
-- The 0.5 s loop: timers, the threshold, the leash, the watchdog, queued joins, countdowns, Lobby pushes
----------------------------------------------------------------------
local function insideBox(part, position)
	if not part or not part.Parent then
		return false
	end
	local rel = part.CFrame:PointToObjectSpace(position)
	local s = part.Size
	return abs(rel.X) <= s.X / 2 + 1 and abs(rel.Y) <= s.Y / 2 + 3 and abs(rel.Z) <= s.Z / 2 + 1
end
Dg.insideBox = insideBox -- (Dg.startFight: who already walked into the room)

local function tickRun(run, t)
	local d = D()
	if run.State == "Ending" then
		if not run.Finished and t - (run.EndedAt or t) > K.RETURN_DELAY + 2 then
			pcall(finishRun, run)
		end
		return
	end
	if t - run.Started > DungeonService.MaxRunSeconds(run.Floor) then
		return Dg.endRun(run, false, "Error")
	end
	-- members who left the pocket (a respawn elsewhere, an obby match)
	for _, m in ipairs(liveMembers(run)) do
		local p = m.Player
		if not isPlayer(p) then
			Dg.removeMember(run, p, "Disconnect")
		elseif p:GetAttribute(ATTR_IN_MATCH) == true then
			Dg.removeMember(run, p, "Left")
		else
			local root = rootOf(p)
			-- (wave 5: never while the entrance cover still holds the party at the gate: State Hall + Transit, before
			-- Dg.finishEnter; a late task.delay must not drop them as "Left")
			local covering = run.State == "Hall" and run.Transit and not m.Joined
			if root and run.Pocket and not covering and (root.Position - run.Pocket.Origin).Magnitude > K.FAR and t - (m.Joined or run.Started) > 1 then
				Dg.removeMember(run, p, "Left")
			end
		end
	end
	if run.State == "Ending" then
		return
	end
	if run.State == "Hall" then
		-- no HallSeconds timer: the group moves on when every member pressed E at the hall's exit (Dg.confirm)
		Dg.syncPrompt(run)
	elseif run.State == "Corridor" then
		local info = roomInfo(run, run.Room)
		if run.Phase == "Threshold" then
			local cross = false
			for _, m in ipairs(liveMembers(run)) do
				local root = rootOf(m.Player)
				if root and info and info.Threshold and insideBox(info.Threshold, root.Position) then
					cross = true
					break
				end
			end
			if cross or t - run.StateAt >= K.WALK_IN_TIMEOUT then
				Dg.startFight(run)
			end
		else
			-- after the clear: the exit bars open after Intermission (the boss room's stay shut: its exit IS the door to
			-- the treasure alcove, which has none) and the next door's EnterPrompt is enabled; no DoorTime: nobody is
			-- moved until every member pressed E there
			if not run.DoorOpened and t - run.StateAt >= num(d.Intermission, 2) then
				run.DoorOpened = true
				if info and run.Room < 4 then
					St.deps.DungeonBuilder.SetDoor(info, "Exit", true)
				end
				sendRun(run)
			end
		end
	elseif run.State == "Fight" then
		local status = run.Battle and try(St.deps.BattleService, "EncounterStatus", run.Battle) or nil
		if not status then
			run.BattleMissingSince = run.BattleMissingSince or t
			if t - run.BattleMissingSince > K.WATCHDOG_MISSING then
				return Dg.endRun(run, false, "Error")
			end
		else
			run.BattleMissingSince = nil
		end
		local info = roomInfo(run, run.Room)
		if info and info.Center then
			for _, m in ipairs(liveMembers(run)) do
				local root = rootOf(m.Player)
				if root then
					local dx, dz = root.Position.X - info.Center.X, root.Position.Z - info.Center.Z
					if math.sqrt(dx * dx + dz * dz) > K.LEASH then
						St.strikes[m.Player] = (St.strikes[m.Player] or 0) + 1
						if St.strikes[m.Player] >= K.LEASH_STRIKES then
							Dg.removeMember(run, m.Player, "Leash")
						end
					else
						St.strikes[m.Player] = nil
					end
				end
			end
		end
	elseif run.State == "Treasure" then
		if t - run.StateAt >= num(d.TreasureSeconds, 45) then
			for _, m in ipairs(liveMembers(run)) do
				if run.Chests[m.Player.UserId] == "Closed" then
					pcall(Dg.openChest, run, m, nil, true)
				end
			end
			Dg.endRun(run, true, "Cleared")
		end
	end
end

local function tickParties(t)
	for _, leaderId in ipairs(copyList(St.partyOrder)) do
		local party = St.parties[leaderId]
		if party and not party.Run and party.StartAt then
			if not isPlayer(party.Leader) then
				removeParty(party)
			else
				local allReady = true
				for _, uid in ipairs(party.Order) do
					local pm = party.Members[uid]
					if pm and uid ~= leaderId and not pm.Ready then
						allReady = false
					end
				end
				if party.WaitingReady and allReady then
					-- everyone pressed READY during the wait: the countdown proper
					party.WaitingReady = nil
					party.StartAt = t + K.START_COUNTDOWN
					markLobbyDirty()
				elseif t >= party.StartAt then
					local readyOnly = party.WaitingReady == true
					Dg.begin(party, readyOnly)
				end
			end
		end
	end
end

local function tickQueue(t)
	for player, q in pairs(St.joinQueue) do
		local party = q.Party
		local run = party and party.Run
		if not isPlayer(player) or not run or run.State == "Ending" or St.parties[party.Leader.UserId] ~= party then
			St.joinQueue[player] = nil
			if isPlayer(player) then
				notify(player, "That party moved on", "bad", 3)
			end
		elseif (run.State == "Hall" or run.State == "Corridor") and not run.Transit then
			St.joinQueue[player] = nil
			local ok, why = Dg.lateJoin(run, player)
			if ok then
				local spec = try(St.deps.BattleService, "TeamSpec", player)
				party.Members[player.UserId] = { Player = player, Ready = true, Keys = keysOf(spec), Power = powerOf(spec) }
				party.Order[#party.Order + 1] = player.UserId
				St.partyOf[player] = party
			else
				notify(player, tostring(why), "bad", 3)
			end
			markLobbyDirty()
		elseif t >= q.Deadline then
			St.joinQueue[player] = nil
			notify(player, "That party moved on", "bad", 3)
		end
	end
end

local function tick()
	local t = now()
	for _, id in ipairs(copyList(St.runOrder)) do
		local run = St.runs[id]
		if run then
			local ok, err = pcall(tickRun, run, t)
			if not ok then
				warn("[DungeonService] tick failed for " .. tostring(id) .. ": " .. tostring(err))
				pcall(Dg.endRun, run, false, "Error", true)
			end
		end
	end
	pcall(tickParties, t)
	pcall(tickQueue, t)
	for _, p in ipairs(Players:GetPlayers()) do
		if St.lobbyDirty[p] then
			pushLobby(p, false)
		end
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function onPlayerRemoving(player)
	local run = St.runOf[player]
	if run then
		pcall(Dg.removeMember, run, player, "Disconnect")
	end
	local party = St.partyOf[player]
	if party then
		pcall(DungeonService.LeaveParty, player)
	end
	St.joinQueue[player] = nil
	St.buckets[player] = nil
	St.cooldowns[player] = nil
	St.toasts[player] = nil
	St.lobbyDirty[player] = nil
	St.lobbySent[player] = nil
	St.strikes[player] = nil
	St.runOf[player] = nil
	St.partyOf[player] = nil
end

local function onPromptTriggered(prompt, player)
	if typeof(prompt) ~= "Instance" or not isPlayer(player) then
		return
	end
	local action = prompt:GetAttribute("DungeonAction")
	if action ~= "Chest" and action ~= "Exit" and action ~= "Enter" then
		return
	end
	local run = St.runOf[player]
	if not run or not run.Pocket or not run.Pocket.Model or not prompt:IsDescendantOf(run.Pocket.Model) then
		return
	end
	if action == "Enter" then
		-- the door's E (decision 2): the shared bucket + a short cooldown, then Dg.confirm validates the rest
		if not allow(player) or onCooldown(player, "Enter") then
			return
		end
		Dg.confirm(run, player, prompt)
	elseif action == "Chest" then
		-- the chest's E (#14): its own slot, through the same bucket / cooldown as the remote
		DungeonService.Request(player, "Chest", prompt:GetAttribute("ChestSlot"))
	else
		DungeonService.Request(player, "Quit")
	end
end

function DungeonService.Init(deps)
	if St.initialized then
		return DungeonService
	end
	St.initialized = true
	St.deps = type(deps) == "table" and deps or {}
	local builtChests = type(St.deps.DungeonBuilder) == "table" and St.deps.DungeonBuilder.CHEST_COUNT or nil
	if builtChests ~= nil then
		assert(type(builtChests) == "number" and builtChests >= K.CHEST_SLOTS, "[DungeonService] DungeonBuilder.CHEST_COUNT ("
			.. tostring(builtChests) .. ") must be >= CHEST_SLOTS = MAX_PARTY (" .. K.CHEST_SLOTS .. "): one chest per member")
	end
	if not St.deps.DungeonInfo and hasFn(St.deps.DungeonBuilder, "GetInfo") then
		St.deps.DungeonInfo = St.deps.DungeonBuilder.GetInfo()
	end
	local remote = getRemote("DungeonRequest")
	if remote then
		St.conns[#St.conns + 1] = remote.OnServerEvent:Connect(function(player, action, a, b)
			local ok, err = pcall(DungeonService.Request, player, action, a, b)
			if not ok then
				warn("[DungeonService] request failed: " .. tostring(err))
			end
		end)
	else
		warn("[DungeonService] the DungeonRequest remote is missing (Config.Remotes)")
	end
	St.conns[#St.conns + 1] = Players.PlayerRemoving:Connect(onPlayerRemoving)
	St.conns[#St.conns + 1] = ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		pcall(onPromptTriggered, prompt, player)
	end)
	St.loop = task.spawn(function()
		while St.initialized do
			task.wait(K.LOOP)
			local ok, err = pcall(tick)
			if not ok then
				warn("[DungeonService] loop error: " .. tostring(err))
			end
		end
	end)
	pcall(function()
		game:BindToClose(function()
			DungeonService.Shutdown()
		end)
	end)
	updateBoard()
	-- LAST (C16): the run provider for BattleService's canBattle / KeysInBattle
	if hasFn(St.deps.BattleService, "SetRunProvider") then
		St.deps.BattleService.SetRunProvider({ KeysInRun = DungeonService.KeysInRun, GetRun = DungeonService.GetRun })
	end
	return DungeonService
end

return DungeonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1093">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- EventService (Phase 3, events): the arena's special events (ARCHITECTURE_V3.md "Phase 3: Pet battles" -> "Special
-- events system", the "Phase 3 build contract" and its "Interfaces between the Phase 3 modules").
--
--   EventService.Init(deps)        deps = { DataService, BattleService, PetCareService, ArenaInfo } (all optional; players
--                                  already in the game get the ArenaState at once)
--   EventService.StartNow(kind, bossId|nil) -> ok, message      start an event at once (developer tools: /raid, the DEV panel's
--                                  "Next raid boss"): kind = "BossRaid" (the next boss now, or when the running fights end) | "DoubleRewards"
--   EventService.RewardMultiplier() -> n                         BattleCatalog.Events.DoubleRewardsMultiplier during a
--                                  Double Rewards hour, else 1 (BattleService multiplies battle Tokens by it)
--   EventService.IsDoubleRewards() -> bool, EventService.GetDouble() -> { Active, EndsIn } | nil
--   EventService.GetState() -> the ArenaState table (below), EventService.Broadcast() sends it now
--   Extras: EndNow(kind) -> ok, message (ends a running event), SecondsUntil(kind) -> seconds to the next one
--   EventService.RaidTierFor(share, won, tierId) -> BattleCatalog.RaidTier(...) with the Tokens of this moment (Double Rewards)
--   EventService.RaidFloorStarted(info): BattleService tells a floor fight began; fires EventStarted("BossRaid", info)
--   Signals (exist at module load, Util.Signal): EventAnnounced(kind, info), EventStarted(kind, info),
--   EventEnded(kind, info). info = { Kind, BossId, Name, StartsIn | Seconds, Won, Players, ... }
--
-- The scheduler (numbers from BattleCatalog.Events, never duplicated here):
--   * Boss Raid: the boss is always there (BattleService runs the fights, see its header), so the BossRaid slot is only the ROTATION:
--     every Schedule.BossRaid.EveryMinutes (20), the first FirstAfterSeconds (300) after the server starts,
--     BattleService.SetRaidBoss(the next of BattleCatalog.NextBoss) changes the boss, at once or when the running fights end. No
--     announcement, no toast. On BattleService.BattleEnded (Mode "Raid"), a win is told to everyone with who won an event pet;
--     EventStarted / EventEnded("BossRaid") follow the FLOOR fight only (the server-wide sky and the boards).
--   * Double Rewards: a DurationSeconds (1 hour) window every EveryMinutes (180), the first one EveryMinutes after the
--     server starts (or the entry's FirstAfterSeconds when the catalog adds one). Announced like the raid; while it
--     runs RewardMultiplier() is 2, the Workspace attribute DoubleRewards is true (clients / boards) and BattleService
--     is told with SetDoubleRewards(true, seconds).
--   * More kinds later (e.g. King of the Ring): add a KINDS entry + a BattleCatalog.Events.Schedule row.
-- Raid rewards (paid exactly once): BattleService pays the tiers by damage share (BattleCatalog.RaidTier: Tokens x
--   RewardMultiplier(), pet XP, a GemChance of Gems, an EventPetChance of one of the EventOnly pets of PetCatalog the
--   player has not won yet) while BattleService.PayRaidRewards is true (its default: its "End" message shows them).
--   When a BattleService build leaves them unpaid (PayRaidRewards == false, result.RewardsPaid ~= true), EventService
--   pays the same tiers itself from the BattleEnded result, once per (battle, player): the record is marked first.
-- ArenaState (remote, server -> client, one table): broadcast every BROADCAST_FAST s while a countdown (the last
--   AnnounceSeconds) or a raid runs, else every BROADCAST_SLOW s, and to every player who joins:
--   { Next = { Kind, BossId, Name, StartsIn, Announced } | nil   (the soonest event players are told about; the silent boss rotation is Raid.NextBoss)
--     Raid = BattleService.GetRaidStatus() -> { BossId, Name, Active, BattleId, FloorTier, FloorHiddenIn, Fights, Closed } + NextBossIn,
--            NextBoss (the rotation) | nil
--     Double = { Active, EndsIn } | nil
--     Leaderboard = { { UserId, Name, Trophies } x 10 }   (the players in this server, by Battle.Trophies)
--     -- extras: LastRaid = { BossId, Name, Tier, Won, Players, Top = { { UserId, Name, Damage, Tier }... }, Ago } | nil, Multiplier = n }
--   The same table is drawn on the arena's event board + trophy leaderboard (ArenaBuilder.ApplyArenaState) whenever
--   what they show changes (the boards tick their countdowns themselves), at least every BOARD_KEEPALIVE s.
-- Plain Lua 5.1-compatible syntax only; task.* only; no client -> server remote (nothing to trust).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local EventService = {}
EventService.EventAnnounced = Util.Signal()
EventService.EventStarted = Util.Signal()
EventService.EventEnded = Util.Signal()

local function loadShared(name)
	local inst = Shared:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[EventService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local BattleCatalog = loadShared("BattleCatalog")
local PetCatalog = loadShared("PetCatalog")
local PetKeys = loadShared("PetKeys")

----------------------------------------------------------------------
-- Local constants (not in Config / BattleCatalog; see the deviations list)
----------------------------------------------------------------------
local TICK = 1 -- scheduler step (seconds)
local BROADCAST_FAST = 1 -- ArenaState period while a countdown or a raid fight runs
local BROADCAST_SLOW = 5 -- ... otherwise
local TOAST_SECONDS = 6
local LEADERS = 10

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local St = {
	initialized = false,
	running = false,
	deps = {},
	slots = {}, -- [kind] = { Kind, At, Announced, Entry, BossId }
	raidIndex = 1, -- the rotation position of the last boss that was scheduled (BossOrder[1] waits from the start: BattleService.Init)
	double = nil, -- { EndsAt, StartedAt }
	lastRaid = nil,
	lastBroadcast = -math.huge,
	paid = {}, -- [battleId] = { [userId] = true } (fallback payer)
	rng = Random.new(),
	leaders = nil,
	leadersAt = -math.huge,
}

local function now()
	return os.clock()
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function hasFn(m, name)
	return type(m) == "table" and type(m[name]) == "function"
end

local function try(m, name, ...)
	if not hasFn(m, name) then
		return nil
	end
	local ok, a, b, c = pcall(m[name], ...)
	if not ok then
		warn("[EventService] " .. name .. " failed: " .. tostring(a))
		return nil
	end
	return a, b, c
end

local function services()
	local folder = script.Parent
	return folder
end

local lazyModules = {}
local function lazyService(name)
	local dep = St.deps[name]
	if type(dep) == "table" then
		return dep
	end
	if lazyModules[name] == nil then
		lazyModules[name] = false
		local inst = services() and services():FindFirstChild(name)
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				lazyModules[name] = mod
			end
		end
	end
	return lazyModules[name] or nil
end

local function battleService()
	return lazyService("BattleService")
end
local function dataService()
	return lazyService("DataService")
end
local function petCareService()
	return lazyService("PetCareService")
end

local function eventsConfig()
	local e = BattleCatalog and BattleCatalog.Events
	return type(e) == "table" and e or {}
end

local function scheduleEntry(kind)
	for _, entry in ipairs(eventsConfig().Schedule or {}) do
		if type(entry) == "table" and entry.Kind == kind then
			return entry
		end
	end
	return nil
end

local function bossName(bossId)
	local boss = BattleCatalog and type(BattleCatalog.Bosses) == "table" and BattleCatalog.Bosses[bossId]
	return (boss and boss.Name) or tostring(bossId or "the boss")
end

local function petName(petId)
	local def = PetCatalog and hasFn(PetCatalog, "Get") and PetCatalog.Get(petId)
	return (def and def.Name) or tostring(petId)
end

local function isPlayer(p)
	return typeof(p) == "Instance" and p:IsA("Player") and p.Parent == Players
end

local function displayName(player)
	if not isPlayer(player) then
		return "?"
	end
	local n = player.DisplayName
	if type(n) ~= "string" or n == "" then
		n = player.Name
	end
	return n
end

local function getRemote(name)
	local ok, remote = pcall(Remotes.Get, name)
	if ok then
		return remote
	end
	return nil
end

local function clip(text)
	if #text > 90 then
		text = text:sub(1, 89) .. "."
	end
	return text
end

local function notify(player, text, kind, seconds)
	local remote = getRemote("Notify")
	if remote and isPlayer(player) then
		pcall(function()
			remote:FireClient(player, clip(text), kind or "info", seconds or TOAST_SECONDS)
		end)
	end
end

local function notifyAll(text, kind, seconds)
	for _, player in ipairs(Players:GetPlayers()) do
		notify(player, text, kind, seconds)
	end
end

local function minutesText(seconds)
	local m = math.floor((seconds + 30) / 60)
	if m <= 1 then
		return "1 minute"
	end
	return m .. " minutes"
end

----------------------------------------------------------------------
-- Double Rewards
----------------------------------------------------------------------
local function doubleMultiplier()
	local m = tonumber(eventsConfig().DoubleRewardsMultiplier) or 2
	if not finite(m) or m < 1 then
		m = 2
	end
	return m
end

function EventService.IsDoubleRewards()
	local d = St.double
	return d ~= nil and now() < d.EndsAt
end

function EventService.GetDouble()
	local d = St.double
	if not d or now() >= d.EndsAt then
		return nil
	end
	return { Active = true, EndsIn = math.max(0, math.ceil(d.EndsAt - now())) }
end

function EventService.RewardMultiplier()
	if EventService.IsDoubleRewards() then
		return doubleMultiplier()
	end
	return 1
end

function EventService.RaidTierFor(share, won, tierId)
	if not BattleCatalog or not hasFn(BattleCatalog, "RaidTier") then
		return nil
	end
	local tier = BattleCatalog.RaidTier(share, won, tierId)
	if type(tier) ~= "table" then
		return nil
	end
	local out = {}
	for k, v in pairs(tier) do
		out[k] = v
	end
	out.Tokens = math.floor((tonumber(tier.Tokens) or 0) * EventService.RewardMultiplier() + 0.5)
	return out
end

local function setDoubleAttribute(on)
	pcall(function()
		Workspace:SetAttribute("DoubleRewards", on == true)
	end)
end

local function startDouble(seconds, source)
	seconds = tonumber(seconds) or 3600
	local t = now()
	if St.double and t < St.double.EndsAt then
		St.double.EndsAt = math.max(St.double.EndsAt, t + seconds)
	else
		St.double = { StartedAt = t, EndsAt = t + seconds }
	end
	setDoubleAttribute(true)
	try(battleService(), "SetDoubleRewards", true, St.double.EndsAt - t)
	notifyAll("Double Rewards for " .. minutesText(St.double.EndsAt - t) .. "! Battles pay x" .. doubleMultiplier() .. " tokens.", "good", 7)
	EventService.EventStarted:Fire("DoubleRewards", { Kind = "DoubleRewards", Seconds = St.double.EndsAt - t, Source = source })
	return true
end

local function endDouble()
	if not St.double then
		return
	end
	St.double = nil
	setDoubleAttribute(false)
	try(battleService(), "SetDoubleRewards", nil)
	notifyAll("Double Rewards are over. Thanks for battling!", "info", 5)
	EventService.EventEnded:Fire("DoubleRewards", { Kind = "DoubleRewards" })
end

----------------------------------------------------------------------
-- Boss raids
----------------------------------------------------------------------
local function raidStatus()
	local bs = battleService()
	if not hasFn(bs, "GetRaidStatus") then
		return nil
	end
	local ok, status = pcall(bs.GetRaidStatus)
	if ok and type(status) == "table" then
		return status
	end
	return nil
end

local function raidsPossible()
	local bs = battleService()
	return hasFn(bs, "SetRaidBoss") and BattleCatalog ~= nil and type(BattleCatalog.Bosses) == "table"
end

local function nextBossId()
	St.raidIndex = St.raidIndex + 1
	if BattleCatalog and hasFn(BattleCatalog, "NextBoss") then
		return BattleCatalog.NextBoss(St.raidIndex)
	end
	return nil
end

-- the rotation's step -> ok, "set" | "queued" | why
local function setRaidBoss(bossId)
	local ok, okSet, how = pcall(battleService().SetRaidBoss, bossId)
	if not ok then
		warn("[EventService] SetRaidBoss failed: " .. tostring(okSet))
		return false, "the boss could not change"
	end
	if okSet ~= true then
		return false, string.lower(tostring(how or "the boss could not change"))
	end
	return true, how
end

-- BattleService: a fight began on the real floor (the server-wide sky and the boards follow that one)
function EventService.RaidFloorStarted(info)
	EventService.EventStarted:Fire("BossRaid", info)
	EventService.Broadcast()
end

----------------------------------------------------------------------
-- The schedule
----------------------------------------------------------------------
local function everySeconds(entry)
	local m = tonumber(entry.EveryMinutes) or 20
	if not finite(m) or m <= 0 then
		m = 20
	end
	return m * 60
end

local function announceSeconds(entry)
	local a = tonumber(entry.AnnounceSeconds) or 120
	if not finite(a) or a < 0 then
		a = 120
	end
	return a
end

local KINDS = {}

KINDS.BossRaid = {
	Possible = raidsPossible,
	Silent = true, -- the rotation: no toast, no EventAnnounced, no fast ArenaState
	FirstAfter = function(entry)
		return tonumber(entry.FirstAfterSeconds) or tonumber(eventsConfig().FirstAfterSeconds) or 300
	end,
	Prepare = function(slot)
		slot.BossId = nextBossId()
	end,
	Start = function(slot)
		setRaidBoss(slot.BossId)
	end,
}

KINDS.DoubleRewards = {
	Possible = function()
		return true
	end,
	FirstAfter = function(entry)
		return tonumber(entry.FirstAfterSeconds) or everySeconds(entry)
	end,
	Prepare = function() end,
	Announce = function(_, secondsLeft)
		notifyAll("Double Rewards hour in " .. minutesText(secondsLeft) .. "! Battle tokens x" .. doubleMultiplier() .. ".", "info", 7)
	end,
	Start = function(slot)
		startDouble(tonumber(slot.Entry.DurationSeconds) or 3600, "schedule")
	end,
}

local function buildSlots()
	St.slots = {}
	local t = now()
	for _, entry in ipairs(eventsConfig().Schedule or {}) do
		local kind = type(entry) == "table" and KINDS[entry.Kind]
		if kind then
			local slot = { Kind = entry.Kind, Entry = entry, At = t + kind.FirstAfter(entry), Announced = false }
			kind.Prepare(slot)
			St.slots[entry.Kind] = slot
		end
	end
end

-- moves a slot to its next occurrence (counted from now, so a stalled server never fires a burst)
local function reschedule(slot, from)
	local kind = KINDS[slot.Kind]
	slot.At = (from or now()) + everySeconds(slot.Entry)
	slot.Announced = false
	kind.Prepare(slot)
end

local function tickSlot(slot, t)
	local kind = KINDS[slot.Kind]
	if not kind or not kind.Possible() then
		return
	end
	local left = slot.At - t
	local announce = announceSeconds(slot.Entry)
	if not kind.Silent and not slot.Announced and left <= announce and left > 0 then
		slot.Announced = true
		kind.Announce(slot, left)
		EventService.EventAnnounced:Fire(slot.Kind, { Kind = slot.Kind, BossId = slot.BossId, Name = slot.BossId and bossName(slot.BossId) or nil, StartsIn = math.ceil(left) })
	end
	if left <= 0 then
		kind.Start(slot)
		reschedule(slot, t)
	end
end

----------------------------------------------------------------------
-- Leaderboard + ArenaState
----------------------------------------------------------------------
local function trophiesOf(player)
	local battle = try(dataService(), "GetBattle", player)
	if type(battle) == "table" and finite(tonumber(battle.Trophies)) then
		return math.max(0, math.floor(tonumber(battle.Trophies)))
	end
	return nil
end

local function leaderboard()
	local t = now()
	if St.leaders and t - St.leadersAt < BROADCAST_SLOW - 0.5 then
		return St.leaders
	end
	local rows = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local trophies = trophiesOf(player)
		if trophies then
			rows[#rows + 1] = { UserId = player.UserId, Name = displayName(player), Trophies = trophies }
		end
	end
	table.sort(rows, function(a, b)
		if a.Trophies ~= b.Trophies then
			return a.Trophies > b.Trophies
		end
		return a.Name < b.Name
	end)
	local out = {}
	for i = 1, math.min(LEADERS, #rows) do
		out[i] = rows[i]
	end
	St.leaders = out
	St.leadersAt = t
	return out
end

local function nextEvent()
	local best = nil
	for _, slot in pairs(St.slots) do
		local kind = KINDS[slot.Kind]
		if kind and not kind.Silent and kind.Possible() and (not best or slot.At < best.At) then
			best = slot
		end
	end
	return best
end

local function slotInfo(slot, t)
	if not slot then
		return nil
	end
	return {
		Kind = slot.Kind,
		BossId = slot.BossId,
		Name = slot.BossId and bossName(slot.BossId) or nil,
		StartsIn = math.max(0, math.ceil(slot.At - t)),
		Announced = slot.Announced == true,
	}
end

function EventService.GetState()
	local t = now()
	local state = {
		Next = slotInfo(nextEvent(), t),
		Raid = raidStatus(),
		Double = EventService.GetDouble(),
		Leaderboard = leaderboard(),
		Multiplier = EventService.RewardMultiplier(),
	}
	local raidSlot = St.slots.BossRaid
	if state.Raid and raidSlot and KINDS.BossRaid.Possible() then
		state.Raid.NextBoss = raidSlot.BossId
		state.Raid.NextBossIn = math.max(0, math.ceil(raidSlot.At - t))
	end
	if St.lastRaid then
		local lr = {}
		for k, v in pairs(St.lastRaid) do
			lr[k] = v
		end
		lr.Ago = math.floor(t - (St.lastRaid.EndedAt or t))
		lr.EndedAt = nil
		state.LastRaid = lr
	end
	return state
end

-- what the boards show, with countdowns as absolute times (ArenaBuilder ticks them down by itself between two
-- states): the boards are redrawn only when this changes, or every BOARD_KEEPALIVE s (it falls back to its own
-- schedule after ~20 s of silence)
local BOARD_KEEPALIVE = 12
local function boardSignature(state, t)
	local parts = {}
	local function add(v)
		parts[#parts + 1] = tostring(v)
	end
	local function at(seconds)
		return math.floor((t + (tonumber(seconds) or 0)) / 2 + 0.5)
	end
	local n = state.Next
	if type(n) == "table" then
		add(n.Kind)
		add(n.BossId)
		add(at(n.StartsIn))
	end
	local r = state.Raid
	if type(r) == "table" then
		add(r.Active)
		add(r.BossId)
		add(r.FloorTier)
		add(at(r.NextBossIn))
		for _, tierId in ipairs((BattleCatalog and BattleCatalog.RaidTierOrder) or {}) do
			local f = type(r.Fights) == "table" and r.Fights[tierId]
			if type(f) == "table" then
				add(tierId)
				add(f.Hp)
				add(f.MaxHp)
				add(f.Players)
				add(at(f.EndsIn))
			end
		end
	end
	local d = state.Double
	if type(d) == "table" then
		add(d.Active)
		add(at(d.EndsIn))
	end
	for _, row in ipairs(state.Leaderboard or {}) do
		add(row.UserId)
		add(row.Name)
		add(row.Trophies)
	end
	return table.concat(parts, "|")
end

local function applyBoards(state)
	local t = now()
	local sig = boardSignature(state, t)
	if sig == St.boardSig and St.boardAt and t - St.boardAt < BOARD_KEEPALIVE then
		return
	end
	St.boardSig = sig
	St.boardAt = t
	local info = St.deps.ArenaInfo
	local apply = type(info) == "table" and info.ApplyArenaState
	if type(apply) ~= "function" then
		local ab = lazyService("ArenaBuilder")
		apply = hasFn(ab, "ApplyArenaState") and ab.ApplyArenaState or nil
	end
	if apply then
		local ok, err = pcall(apply, state)
		if not ok then
			warn("[EventService] ApplyArenaState failed: " .. tostring(err))
		end
	end
end

function EventService.Broadcast(player)
	local state = EventService.GetState()
	local remote = getRemote("ArenaState")
	if remote then
		pcall(function()
			if player then
				if isPlayer(player) then
					remote:FireClient(player, state)
				end
			else
				remote:FireAllClients(state)
			end
		end)
	end
	if not player then
		St.lastBroadcast = now()
		applyBoards(state)
	end
	return state
end

local function fastMode(t)
	local raid = raidStatus()
	if raid and type(raid.Fights) == "table" and next(raid.Fights) ~= nil then
		return true
	end
	for _, slot in pairs(St.slots) do
		if slot.Announced and slot.At - t <= announceSeconds(slot.Entry) + 1 then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Raid results: the everyone-toast, the event pet shout-out, the fallback payer
----------------------------------------------------------------------
local function grantEventPet(player)
	if not BattleCatalog or not hasFn(BattleCatalog, "EventPets") or not PetKeys or not PetCatalog then
		return nil
	end
	local list = BattleCatalog.EventPets()
	if type(list) ~= "table" or #list == 0 then
		return nil
	end
	local DS = dataService()
	local profile = try(DS, "GetProfile", player)
	if type(profile) ~= "table" then
		return nil
	end
	local chosen = nil
	local ok = try(DS, "MutateBattle", player, function(rec)
		if type(rec.EventPets) ~= "table" then
			rec.EventPets = {}
		end
		local candidates = {}
		for _, id in ipairs(list) do
			if type(id) == "string" and rec.EventPets[id] ~= true and PetCatalog.Get(id) then
				candidates[#candidates + 1] = id
			end
		end
		if #candidates == 0 then
			return false
		end
		chosen = candidates[St.rng:NextInteger(1, #candidates)]
		rec.EventPets[chosen] = true
	end)
	if ok ~= true or not chosen then
		return nil
	end
	local okAdd, added = pcall(PetKeys.Add, profile, chosen, 1)
	if not okAdd or not added then
		return nil
	end
	try(DS, "MarkDiscovered", player, chosen)
	try(DS, "MarkDirty", player)
	if hasFn(DS, "SyncSoon") then
		try(DS, "SyncSoon", player)
	else
		try(DS, "Sync", player)
	end
	return chosen
end

-- pays one raider's tier when BattleService did not (see the header). Marked before anything is paid.
local function payRaider(battleId, result, uid, won)
	local paid = St.paid[battleId]
	if not paid then
		paid = {}
		St.paid[battleId] = paid
	end
	if paid[uid] then
		return nil
	end
	paid[uid] = true
	local player = Players:GetPlayerByUserId(uid)
	if not isPlayer(player) then
		return nil
	end
	-- the same reward clocks as BattleService's payer: nothing while the limit runs, a payment stamps it
	local clocks = try(battleService(), "RaidRewardStatus", player)
	if type(clocks) == "table" and ((won and clocks.WinIn > 0) or (not won and clocks.LossIn > 0)) then
		return nil
	end
	local share = (type(result.Shares) == "table" and tonumber(result.Shares[uid] or result.Shares[tostring(uid)])) or 0
	local damage = (type(result.Damage) == "table" and tonumber(result.Damage[uid] or result.Damage[tostring(uid)])) or 0
	local tier = EventService.RaidTierFor(share, won, result.RaidTier)
	if not tier then
		return nil
	end
	local DS = dataService()
	try(DS, "MutateBattle", player, function(rec)
		rec.Raids = (tonumber(rec.Raids) or 0) + 1
		if damage > (tonumber(rec.RaidBestDamage) or 0) then
			rec.RaidBestDamage = math.floor(damage)
		end
		if type(clocks) == "table" and won then
			rec.RaidRewardAt = clocks.Now
		elseif type(clocks) == "table" then
			rec.RaidLossAt = clocks.Now
		end
	end)
	local eventPet = nil
	if (tonumber(tier.EventPetChance) or 0) > 0 and St.rng:NextNumber() < tier.EventPetChance then
		eventPet = grantEventPet(player)
	end
	if (tonumber(tier.Tokens) or 0) > 0 then
		try(DS, "AddTokens", player, tier.Tokens)
	end
	local gems = 0
	if (tonumber(tier.GemChance) or 0) > 0 and St.rng:NextNumber() < tier.GemChance then
		gems = tonumber(tier.Gems) or 0
		if gems > 0 and try(DS, "AddGems", player, gems) ~= true then
			gems = 0
		end
	end
	local xp = tonumber(tier.Xp) or 0
	if xp > 0 then
		local keys = try(DS, "ActiveTeamKeys", player) or {}
		local care = petCareService()
		for _, key in ipairs(keys) do
			if hasFn(care, "GrantXp") then
				try(care, "GrantXp", player, key, xp, "Raid")
			else
				try(DS, "AddPetXp", player, key, xp)
			end
		end
	end
	local text = (won and "Boss defeated! " or "The boss won this time. ") .. tostring(tier.Id) .. " tier: +" .. tier.Tokens .. " tokens"
	if gems > 0 then
		text = text .. ", +" .. gems .. " gems"
	end
	notify(player, text, won and "good" or "info", 6)
	if eventPet then
		notify(player, "Event pet! " .. petName(eventPet) .. " joined your pets!", "good", 7)
	end
	return { Tier = tier.Id, Tokens = tier.Tokens, Gems = gems, Xp = xp, EventPet = eventPet }
end

local function onBattleEnded(battleId, result)
	if type(result) ~= "table" or result.Mode ~= "Raid" then
		return
	end
	local bossId = result.BossId
	local won = type(result.Winners) == "table" and #result.Winners > 0
	local participants = {}
	if type(result.Participants) == "table" then
		for _, uid in ipairs(result.Participants) do
			participants[#participants + 1] = tonumber(uid)
		end
	end
	if #participants == 0 and type(result.Damage) == "table" then
		for uid in pairs(result.Damage) do
			participants[#participants + 1] = tonumber(uid)
		end
	end
	-- the raiders who were still in at the end (result.Fighters; leavers are not counted): the toast and LastRaid.Players
	local fighters = {}
	if type(result.Fighters) == "table" then
		for _, uid in ipairs(result.Fighters) do
			fighters[#fighters + 1] = tonumber(uid)
		end
	else
		fighters = participants
	end
	-- fallback payer: only when BattleService did not pay (never both)
	local rewards = type(result.Rewards) == "table" and result.Rewards or {}
	local bs = battleService()
	if result.RewardsPaid ~= true and type(bs) == "table" and bs.PayRaidRewards == false then
		for _, uid in ipairs(participants) do
			if uid then
				local rw = payRaider(battleId, result, uid, won)
				if rw then
					rewards[uid] = rw
				end
			end
		end
	end
	-- the summary everyone sees on the boards + one toast
	local top = {}
	for _, uid in ipairs(participants) do
		if uid then
			local player = Players:GetPlayerByUserId(uid)
			local dmg = type(result.Damage) == "table" and tonumber(result.Damage[uid] or result.Damage[tostring(uid)]) or 0
			local rw = rewards[uid] or rewards[tostring(uid)]
			top[#top + 1] = { UserId = uid, Name = player and displayName(player) or tostring(uid), Damage = math.floor(dmg or 0), Tier = type(rw) == "table" and rw.Tier or nil }
		end
	end
	table.sort(top, function(a, b)
		return a.Damage > b.Damage
	end)
	while #top > 5 do
		table.remove(top)
	end
	St.lastRaid = { BossId = bossId, Name = bossName(bossId), Tier = result.RaidTier, Won = won, Players = #fighters, Top = top, EndedAt = now() }
	if won then
		local who = bossName(bossId) .. (result.RaidTier and (" (" .. tostring(result.RaidTier) .. ")") or "")
		notifyAll(who .. " was defeated by " .. #fighters .. (#fighters == 1 and " raider!" or " raiders!"), "good", 6)
	end
	-- shout-out for every event pet won (BattleService or the fallback payer)
	for uid, rw in pairs(rewards) do
		if type(rw) == "table" and type(rw.EventPet) == "string" then
			local player = Players:GetPlayerByUserId(tonumber(uid) or -1)
			local who = player and displayName(player) or "A raider"
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					notify(other, who .. " won the event pet " .. petName(rw.EventPet) .. "!", "good", 6)
				end
			end
		end
	end
	if result.RaidFloor == true then
		EventService.EventEnded:Fire("BossRaid", { Kind = "BossRaid", BossId = bossId, Name = bossName(bossId), Tier = result.RaidTier, Won = won, Players = #fighters, BattleId = battleId })
	end
	EventService.Broadcast()
end

----------------------------------------------------------------------
-- StartNow (developer tools)
----------------------------------------------------------------------
function EventService.StartNow(kind, bossId)
	if kind == nil or kind == "raid" or kind == "Raid" then
		kind = "BossRaid"
	elseif kind == "double" or kind == "Double" then
		kind = "DoubleRewards"
	end
	if kind == "BossRaid" then
		if not raidsPossible() then
			return false, "boss raids are not ready in this build"
		end
		local slot = St.slots.BossRaid
		local boss = nil
		if type(bossId) == "string" and BattleCatalog.Bosses[bossId] then
			boss = bossId
		elseif slot and slot.BossId then
			boss = slot.BossId
		else
			boss = nextBossId()
		end
		local ok, how = setRaidBoss(boss)
		if not ok then
			return false, how
		end
		-- the cycle restarts from now (the waiting boss was used, the next one is queued)
		if slot then
			reschedule(slot, now())
		end
		EventService.Broadcast()
		return true, "next boss: " .. bossName(boss) .. (how == "set" and " (now)" or " (when the fights end)")
	elseif kind == "DoubleRewards" then
		local entry = scheduleEntry("DoubleRewards") or {}
		startDouble(tonumber(entry.DurationSeconds) or 3600, "dev")
		EventService.Broadcast()
		return true, "Double Rewards for " .. minutesText(St.double.EndsAt - now())
	end
	return false, "unknown event " .. tostring(kind)
end

-- extra (developer tools / tests): ends a running event now -> ok, message
function EventService.EndNow(kind)
	if kind == "DoubleRewards" or kind == "double" then
		if not EventService.IsDoubleRewards() then
			return false, "no Double Rewards running"
		end
		endDouble()
		EventService.Broadcast()
		return true, "Double Rewards ended"
	elseif kind == nil or kind == "BossRaid" or kind == "raid" then
		local ended = try(battleService(), "EndRaids", "Ended")
		if not ended or ended <= 0 then
			return false, "no raid running"
		end
		EventService.Broadcast()
		return true, ended == 1 and "raid ended" or (ended .. " raids ended")
	end
	return false, "unknown event " .. tostring(kind)
end

----------------------------------------------------------------------
-- The loop
----------------------------------------------------------------------
local function tick()
	local t = now()
	if St.double and t >= St.double.EndsAt then
		endDouble()
	end
	for _, slot in pairs(St.slots) do
		local ok, err = pcall(tickSlot, slot, t)
		if not ok then
			warn("[EventService] " .. tostring(slot.Kind) .. " failed: " .. tostring(err))
			reschedule(slot, t)
		end
	end
	local period = fastMode(t) and BROADCAST_FAST or BROADCAST_SLOW
	if t - St.lastBroadcast >= period - 0.05 then
		EventService.Broadcast()
	end
end

function EventService.Init(deps)
	if St.initialized then
		return
	end
	St.initialized = true
	St.deps = type(deps) == "table" and deps or {}
	if not BattleCatalog then
		warn("[EventService] BattleCatalog missing: no events")
	end
	buildSlots()
	setDoubleAttribute(false)
	local bs = battleService()
	if type(bs) == "table" and type(bs.BattleEnded) == "table" and hasFn(bs.BattleEnded, "Connect") then
		bs.BattleEnded:Connect(function(battleId, result)
			local ok, err = pcall(onBattleEnded, battleId, result)
			if not ok then
				warn("[EventService] raid result failed: " .. tostring(err))
			end
		end)
	end
	Players.PlayerAdded:Connect(function(player)
		St.leaders = nil -- a new face on the leaderboard
		EventService.Broadcast(player)
	end)
	Players.PlayerRemoving:Connect(function()
		St.leaders = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		EventService.Broadcast(player)
	end
	St.running = true
	task.spawn(function()
		while St.running do
			task.wait(TICK)
			local ok, err = pcall(tick)
			if not ok then
				warn("[EventService] tick failed: " .. tostring(err))
			end
		end
	end)
	EventService.Broadcast()
end

-- extra (tests): the scheduled time of a kind, seconds from now (nil when not scheduled)
function EventService.SecondsUntil(kind)
	local slot = St.slots[kind]
	if not slot then
		return nil
	end
	return slot.At - now()
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1094">
          <Properties>
            <string name="Name">FusionService</string>
            <string name="Source"><![CDATA[-- FusionService (Phase 2, fusion): the Fusion Machine on the player's home plot (ARCHITECTURE_V3.md section 11 and the
-- FusionService paragraph of the "Phase 2 build contract").
--
-- * UPGRADE (key): 3 copies of the same key -> 1 copy of the next tier: Normal -> Golden (x1.5 stats / perks) ->
--   Rainbow (x2.5). Costs TycoonCatalog.FusionCost("Upgrade", rarity, targetTier, machineLevel) (Cloud Tokens; the
--   machine's TokenDiscount lowers them). Hybrids are one of a kind (one copy each), so they cannot be upgraded.
-- * MIX (keyA, keyB, moves): two different catalog pets -> a brand-new hybrid record (PetKeys "hyb:<uid>"): Body = the
--   first pet (species, body colour, eyes), Style = the second (colours, wings, accessory). The move choice (gui-redo,
--   spec 2026-11-06-window-redo 5.6): `moves` = "BB" | "BS" | "SB" | "SS", letter 1 = the parent of the normal attack,
--   letter 2 = the parent of the special (B = Body, S = Style); nil = "BB" (today's rule: an old client); anything else
--   is refused ("Pick the moves again"), nothing fused or charged. The record is built through PetKeys.MixMoves: Elements =
--   { the attack parent's element, the other's } (deduplicated; Elements[1] is the hybrid's first element), SpecialFrom =
--   "Style" when letter 2 is S (left out otherwise = the Body gives the special).
--   Rarity = the higher of the two, Name = PetKeys.BlendName ("Pip Penguin" + "Ember Phoenix" ->
--   "Pengnix"), a random look Seed (PetBuilder varies the blend with it; PetService publishes it for other clients),
--   Tier = the LOWER tier of the two inputs (two Golden pets make a Golden hybrid, so no finish is ever gained for
--   free). Stats = the parents' average x1.2 (PetKeys.DefOf). Costs TycoonCatalog.FusionCost("Mix", higherRarity, nil,
--   machineLevel): Tokens, Gems for Mythic / Secret inputs. A hybrid cannot be mixed again (its record only names
--   two catalog parents). At most MAX_HYBRIDS hybrids per profile.
-- * Requirements (every request): the profile is loaded and not provisional, the player is not in a match,
--   Home.Prestige >= TycoonCatalog.Prestige.FusionUnlock (1) and Home.Stations.FusionMachine >= 1. Requests through the
--   remote must also come from near the player's own Fusion Machine (the window opens with E at the machine).
-- * Copies in use: inputs are taken from free copies first. A copy that is equipped or working in the Garden is taken
--   off first (never consumed while in use), and the result takes over the freed place (the equipped slot; the freed
--   Garden slot whatever its role: Phase 4 gardens take any pet). Bug batch 2 #18 (one job at a time: a Garden pet
--   cannot follow, so an equipped copy and a placed copy are different copies): the copies in use beyond what is left
--   leave their jobs together, the placed ones first, so a player whose followers are spare copies keeps them; when
--   the inputs freed BOTH an equipped slot and a Garden place, the result takes the equipped slot
--   only (the player keeps a follower, like the old-save ruling) and the Garden place is left empty; the result toast
--   says so. If the inputs are the player's ONLY equipped pets
--   (fusing would leave nothing equipped) the fusion is refused: unequip them or equip another pet. Phase 4
--   (ARCHITECTURE_V3.md "Phase 4 build contract" 3.6 / 4.5): a TRAINING input (DataService.TrainingKeys) is refused
--   ("Rocky is training: wait for it to finish"); old Home.Gym slots are only cleared (no Gym placement: the Gym is the
--   Training Place now).
-- * Levels: an upgraded copy keeps the level of its inputs (the target key's level is raised to it, never lowered);
--   a hybrid starts at the average level of its parents.
-- * Growth (Phase 4): "Fusing keeps your pet's evolution and training". An upgraded copy gets the input key's stored
--   evolution stage and training ranks (the higher of each, result vs input); a Mix (hybrid) starts at stage 0 with the
--   parents' higher rank per skill. Written through DataService.MutateGrowth in the same non-yielding commit as the
--   pets (the input key's entry is dropped when no copy of it is left).
-- * Atomic: every check runs first; then the inputs are removed, the result added and the price paid in ONE
--   non-yielding step (anything unexpected restores the pets and nothing is charged). Then PetService.Refresh
--   republishes the equipped attributes / perks and the profile is synced.
-- * Lobby shop (docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.2, the gem settle hold): a gem-priced fusion
--   (a Mythic / Secret Mix) is refused "Your data is still loading" (Preview too) until DataService.GemsSettled answers
--   true for this load; token fusions are not held.
-- * Remote Fusion(action, a, b, moves): "Upgrade" (key; a 4th argument is ignored), "Mix" (keyA, keyB, moves). Types,
--   lengths and keys are validated, then a Mix's moves (PetKeys.ValidMoves) before anything else is read: junk answers
--   { Ok = false, Reason = "Pick the moves again" } with a toast; a per-player cooldown plus a burst budget rate-limit
--   it; refusals answer with a side toast (repeats throttled).
--   The server answers on the same RemoteEvent: Fusion:FireClient(player, "Result", { Ok, Action, Key, Name, Rarity,
--   Tier, Reason, Consumed = {key...} }) so the window can play its fusion animation (FusionController).
--
-- Public API (the contract): Init(deps)   deps = { DataService, PetService, TycoonService }
-- Extras: Upgrade(player, key) -> ok, resultKey | reason
--         Mix(player, keyA, keyB, moves) -> ok, resultKey | reason   (moves as the remote's; nil = "BB")
--         Preview(player, action, a, b, moves) -> ok, plan | reason   (no changes; plan = { Action, Cost = {Tokens|Gems = n},
--                                          ResultKey (Upgrade; nil for Mix: the uid is drawn on fusing), ResultName,
--                                          Rarity, Tier, Inputs = { {Key, Count} }, Freed = { Equipped, Garden, Gym },
--                                          Mix only: Elements = { ... } (the record's order), SpecialFrom = "Style" | nil })
--         Unlocked(player) -> ok, reason, { Prestige, MachineLevel }
--         Fused  Util.Signal Fire(player, action, resultKey, consumedKeys)
--
-- Plain Lua 5.1-compatible syntax only. Nothing here yields between a check and its write.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local FusionService = {}
FusionService.Fused = Util.Signal() -- Fire(player, action, resultKey, consumedKeys)

local COPIES = 3 -- Upgrade input copies (TycoonCatalog.Fusion.Copies overrides it)
local MAX_HYBRIDS = 100 -- hybrids one profile may hold (not in Config / TycoonCatalog: local constant)
local FUSE_COOLDOWN = 0.75 -- seconds between two fusions of one player
local BURST_SIZE = 6 -- Fusion requests a player may send at once...
local BURST_REFILL = 2 -- ...refilled at this many per second
local TOAST_GAP = 1.5 -- the same refusal text is not repeated within this many seconds
local MACHINE_RANGE = 36 -- studs: remote requests must come from near the player's own Fusion Machine
local MAX_ACTION_LENGTH = 16
local MAX_KEY_LENGTH = 48
local MAX_NAME_CHARS = 30
local MOVES_TEXT = "Pick the moves again" -- a Mix whose move choice is not "BB" | "BS" | "SB" | "SS" (or nil)
local DEFAULT_UNLOCK = 1 -- prestige stars that unlock the machine (TycoonCatalog.Prestige.FusionUnlock)
local MACHINE_ID = "FusionMachine"
local TIER_RANK = { Normal = 1, Golden = 2, Rainbow = 3 }
local NEXT_TIER = { Normal = "Golden", Golden = "Rainbow" }

local initialized = false
local dataService = nil
local petService = nil
local tycoonService = nil
local petKeys = nil
local petCatalog = nil
local catalog = nil -- TycoonCatalog
local homeBuilder = nil
local homeBuilderTried = false
local fusionRemote = nil
local notifyRemote = nil
local rng = nil

local cooldowns = {} -- [Player] = os.clock() of the last accepted fusion request
local budgets = {} -- [Player] = { Tokens, At }
local toastAt = {} -- [Player] = { [text] = os.clock() }

----------------------------------------------------------------------
-- Modules (written by other engineers: every use is guarded)
----------------------------------------------------------------------

local function requireModule(container, name)
	local module = container and container:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[FusionService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local function getHomeBuilder()
	if not homeBuilderTried then
		homeBuilderTried = true
		homeBuilder = requireModule(script.Parent, "HomeBuilder")
	end
	return homeBuilder
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function clip(text, n)
	text = tostring(text or "")
	if #text > n then
		return string.sub(text, 1, n - 1) .. "."
	end
	return text
end

local function notify(player, text, kind, seconds)
	if not player or not player.Parent or type(text) ~= "string" or text == "" then
		return
	end
	if not notifyRemote then
		local ok, remote = pcall(Remotes.Get, "Notify")
		if ok then
			notifyRemote = remote
		end
	end
	if notifyRemote then
		pcall(function()
			notifyRemote:FireClient(player, text, kind or "info", seconds or 3)
		end)
	end
end

-- A refusal toast; the same text is not repeated within TOAST_GAP (spam clicks stay quiet).
local function toastOnce(player, text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	local map = toastAt[player]
	if not map then
		map = {}
		toastAt[player] = map
	end
	local now = os.clock()
	local last = map[text]
	if last and now - last < TOAST_GAP then
		return
	end
	map[text] = now
	notify(player, text, kind or "bad", 3)
end

-- Per player burst budget shared by every Fusion request.
local function spend(player)
	local now = os.clock()
	local b = budgets[player]
	if not b then
		b = { Tokens = BURST_SIZE, At = now }
		budgets[player] = b
	end
	b.Tokens = math.min(BURST_SIZE, b.Tokens + (now - b.At) * BURST_REFILL)
	b.At = now
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

local function cooldownReady(player)
	local now = os.clock()
	local last = cooldowns[player]
	if last and now - last < FUSE_COOLDOWN then
		return false
	end
	cooldowns[player] = now
	return true
end

local function reply(player, payload)
	if not fusionRemote or not player or not player.Parent then
		return
	end
	pcall(function()
		fusionRemote:FireClient(player, "Result", payload)
	end)
end

local function copyList(list)
	local out = {}
	for i, v in ipairs(type(list) == "table" and list or {}) do
		out[i] = v
	end
	return out
end

local function deepCopy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = deepCopy(v)
	end
	return out
end

local function random()
	if not rng then
		rng = Random.new(math.floor((os.clock() * 1000003) % 2147483647) + 7)
	end
	return rng
end

----------------------------------------------------------------------
-- Data access
----------------------------------------------------------------------

local function dsCall(fnName, ...)
	if not dataService or type(dataService[fnName]) ~= "function" then
		return false, nil
	end
	local ok, result = pcall(dataService[fnName], ...)
	if not ok then
		warn("[FusionService] DataService." .. fnName .. " failed: " .. tostring(result))
		return false, nil
	end
	return true, result
end

local function getProfile(player)
	local ok, profile = dsCall("GetProfile", player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function isProvisional(player)
	local ok, result = dsCall("IsProvisional", player)
	return ok and result == true
end

local function getHome(player)
	local ok, home = dsCall("GetHome", player)
	if ok and type(home) == "table" then
		return home
	end
	return nil
end

local function inMatch(player)
	return player:GetAttribute(Config.Attr.InMatch) == true
end

local function balanceOf(player, currency)
	local fnName = (currency == "Gems") and "GetGems" or "GetTokens"
	local ok, n = dsCall(fnName, player)
	if ok and isFinite(n) then
		return n
	end
	return 0
end

local function parseKey(key)
	if type(key) ~= "string" or key == "" or #key > MAX_KEY_LENGTH or not petKeys then
		return nil
	end
	local ok, parsed = pcall(petKeys.Parse, key)
	if ok and type(parsed) == "table" then
		return parsed
	end
	return nil
end

local function defOf(key, profile)
	if not petKeys or type(petKeys.DefOf) ~= "function" then
		return nil
	end
	local ok, def = pcall(petKeys.DefOf, key, profile)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function catalogDef(petId)
	if not petCatalog or type(petCatalog.Get) ~= "function" then
		return nil
	end
	local ok, def = pcall(petCatalog.Get, petId)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function countOf(profile, key)
	if not petKeys then
		return 0
	end
	local ok, n = pcall(petKeys.Count, profile, key)
	if ok and isFinite(n) then
		return n
	end
	return 0
end

local function maxStack()
	local n = Config.Pets and tonumber(Config.Pets.MaxPerStack)
	if n and n >= 1 then
		return math.floor(n)
	end
	return 99
end

local function rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 0
		end
	end
	return 0
end

local function higherRarity(a, b)
	if rarityOrder(b) > rarityOrder(a) then
		return b
	end
	return a
end

local function displayName(def, key)
	if type(def) == "table" then
		return clip(def.DisplayName or def.Name or key, MAX_NAME_CHARS)
	end
	return clip(key, MAX_NAME_CHARS)
end

local function unlockStars()
	local p = catalog and catalog.Prestige
	local n = type(p) == "table" and tonumber(p.FusionUnlock) or nil
	if n and n >= 0 then
		return math.floor(n)
	end
	return DEFAULT_UNLOCK
end

local function copiesNeeded()
	local f = catalog and catalog.Fusion
	local n = type(f) == "table" and tonumber(rawget(f, "Copies")) or nil
	if n and n >= 2 and n == math.floor(n) then
		return n
	end
	return COPIES
end

-- { Tokens = n } | { Gems = n } | nil
local function costOf(action, rarity, tier, machineLevel)
	if not catalog or type(catalog.FusionCost) ~= "function" then
		return nil
	end
	local ok, cost = pcall(catalog.FusionCost, action, rarity, tier, machineLevel)
	if not ok or type(cost) ~= "table" then
		return nil
	end
	local out = nil
	if isFinite(cost.Gems) and cost.Gems > 0 then
		out = { Gems = math.ceil(cost.Gems) }
	elseif isFinite(cost.Tokens) and cost.Tokens >= 0 then
		out = { Tokens = math.ceil(cost.Tokens) }
	end
	return out
end

local function currencyOf(cost)
	if cost.Gems then
		return "Gems", cost.Gems
	end
	return "Tokens", cost.Tokens or 0
end

local function priceText(cost)
	local currency, amount = currencyOf(cost)
	if currency == "Gems" then
		return tostring(amount) .. " Gems"
	end
	return tostring(amount) .. " Cloud Tokens"
end

-- Phase 4: { [key] = true } of the keys with a running training job (DataService.TrainingKeys, the ONE lock source)
local function trainingKeys(player)
	if not dataService or type(dataService.TrainingKeys) ~= "function" then
		return {}
	end
	local ok, set = pcall(dataService.TrainingKeys, player)
	if ok and type(set) == "table" then
		return set
	end
	return {}
end

-- Phase 4: the stored growth of a key { Evo, Speed, Physique, Ability, Defense } (zeros when unknown)
local GROWTH_STATS = { "Speed", "Physique", "Ability", "Defense" }
local function growthOf(player, key)
	local out = { Evo = 0 }
	for _, stat in ipairs(GROWTH_STATS) do
		out[stat] = 0
	end
	if not dataService or type(dataService.GetGrowth) ~= "function" then
		return out
	end
	local ok, g = pcall(dataService.GetGrowth, player, key)
	if ok and type(g) == "table" then
		if isFinite(g.Evo) and g.Evo > 0 then
			out.Evo = math.floor(g.Evo)
		end
		for _, stat in ipairs(GROWTH_STATS) do
			if isFinite(g[stat]) and g[stat] > 0 then
				out[stat] = math.floor(g[stat])
			end
		end
	end
	return out
end

local function levelOf(profile, key)
	local levels = type(profile.PetLevels) == "table" and profile.PetLevels or {}
	local raw = levels[key]
	if type(raw) == "table" and isFinite(raw.Level) and raw.Level >= 1 then
		return math.floor(raw.Level)
	elseif isFinite(raw) and raw >= 1 then
		return math.floor(raw)
	end
	return 1
end

----------------------------------------------------------------------
-- Requirements
----------------------------------------------------------------------

local function machineLevelOf(home)
	local stations = type(home) == "table" and home.Stations
	local lv = type(stations) == "table" and stations[MACHINE_ID] or nil
	if isFinite(lv) and lv >= 1 then
		return math.floor(lv)
	end
	return 0
end

local function prestigeOf(home)
	local p = type(home) == "table" and home.Prestige or nil
	if isFinite(p) and p >= 0 then
		return math.floor(p)
	end
	return 0
end

-- ok, reason, info { Prestige, MachineLevel }, home, profile
local function checkUnlocked(player)
	if not initialized then
		return false, "The Fusion Machine is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	local profile = getProfile(player)
	if not profile then
		return false, "Your data is still loading..."
	end
	if isProvisional(player) then
		return false, "Your save is still loading: try again in a moment"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	local info = { Prestige = prestigeOf(home), MachineLevel = machineLevelOf(home) }
	local need = unlockStars()
	if info.Prestige < need then
		return false, "The Fusion Machine unlocks at Prestige " .. need, info
	end
	if info.MachineLevel < 1 then
		return false, "Build the Fusion Machine at your home first", info
	end
	if inMatch(player) then
		return false, "Fusion is closed during a match", info
	end
	return true, nil, info, home, profile
end

----------------------------------------------------------------------
-- Planning: which copies a fusion takes and what it frees
----------------------------------------------------------------------

local function sortedSlots(map, key)
	local out = {}
	for slot, k in pairs(type(map) == "table" and map or {}) do
		if k == key then
			out[#out + 1] = slot
		end
	end
	table.sort(out, function(a, b)
		if type(a) == type(b) then
			return a > b -- the highest slots are freed first
		end
		return type(a) == "string"
	end)
	return out
end

-- Takes `n` copies of each input key: { equippedIdx = {i = true}, garden = {slot...}, gym = {slot...} } of what must
-- be freed, or nil, reason when the copies are not there. Equipped and placed copies are separate copies (bug batch 2
-- #18), so they are counted together against what is left.
local function planUse(profile, home, inputs)
	local freeEq, freeGarden, freeGym = {}, {}, {}
	for _, input in ipairs(inputs) do
		local key, n = input.Key, input.Count
		local owned = countOf(profile, key)
		if owned < n then
			return nil, input.Short
		end
		local left = owned - n
		local eqIdx = {}
		for i, k in ipairs(type(profile.Equipped) == "table" and profile.Equipped or {}) do
			if k == key then
				eqIdx[#eqIdx + 1] = i
			end
		end
		local gymSlots = sortedSlots(home.Gym, key)
		local gardenSlots = sortedSlots(home.Garden, key)
		-- bug batch 2 #18 (one job at a time): an equipped copy and a placed copy are DIFFERENT copies now, so the copies
		-- in use beyond what is left leave their jobs together: the placed ones first (Gym, then Garden), then the
		-- equipped ones (the last equipped first), so the player keeps a follower whenever a copy can stay
		local placed = #gymSlots + #gardenSlots
		local over = #eqIdx + placed - left
		local dropPlaced = math.max(0, math.min(over, placed))
		local dropEq = over - dropPlaced
		for j = #eqIdx, 1, -1 do
			if dropEq <= 0 then
				break
			end
			freeEq[eqIdx[j]] = true
			dropEq = dropEq - 1
		end
		for _, slot in ipairs(gymSlots) do
			if dropPlaced <= 0 then
				break
			end
			freeGym[#freeGym + 1] = slot
			dropPlaced = dropPlaced - 1
		end
		for _, slot in ipairs(gardenSlots) do
			if dropPlaced <= 0 then
				break
			end
			freeGarden[#freeGarden + 1] = slot
			dropPlaced = dropPlaced - 1
		end
	end
	return { Equipped = freeEq, Garden = freeGarden, Gym = freeGym }
end

local function countKeys(set)
	local n = 0
	for _ in pairs(set) do
		n = n + 1
	end
	return n
end

-- The "never leave the player with no pet" rule. ok, reason
local function checkEquippedRule(profile, freed)
	local equipped = type(profile.Equipped) == "table" and profile.Equipped or {}
	local total = #equipped
	local dropped = countKeys(freed.Equipped)
	if total > 0 and dropped >= total then
		return false, "Those are your only team pets: put another pet in your team first"
	end
	return true
end

-- The Mix move choice: nil or exactly "BB" | "BS" | "SB" | "SS" (PetKeys.ValidMoves; without it only nil = today's rule).
local function validMoves(moves)
	if petKeys and type(petKeys.ValidMoves) == "function" then
		return petKeys.ValidMoves(moves) == true
	end
	return moves == nil
end

-- ok, plan | reason. plan = { Action, Inputs = {{Key, Count}}, Cost, Currency, Price, ResultKey, ResultName, Rarity,
-- Tier, Record (Mix: its Elements order and SpecialFrom from `moves`), Freed, Profile, Home, MachineLevel, Level }
local function buildPlan(player, action, a, b, moves)
	if action == "Mix" and not validMoves(moves) then
		return false, MOVES_TEXT
	end
	local ok, reason, info, home, profile = checkUnlocked(player)
	if not ok then
		return false, reason
	end
	if not petKeys then
		return false, "Fusion is not available right now"
	end
	local plan = { Action = action, Profile = profile, Home = home, MachineLevel = info.MachineLevel }
	if action == "Upgrade" then
		local parsed = parseKey(a)
		if not parsed then
			return false, "Pick a pet to upgrade"
		end
		if parsed.HybridId then
			return false, "Hybrids are one of a kind: they cannot be upgraded"
		end
		local nextTier = NEXT_TIER[parsed.Tier]
		if not nextTier then
			return false, "Rainbow is the best finish: this pet cannot go higher"
		end
		local def = defOf(a, profile)
		local base = catalogDef(parsed.PetId)
		if not def or not base then
			return false, "Unknown pet"
		end
		local need = copiesNeeded()
		local have = countOf(profile, a)
		if have < need then
			return false, "You need " .. need .. " copies of " .. displayName(def, a) .. " (you have " .. have .. ")"
		end
		local resultKey = petKeys.Make(parsed.PetId, nextTier)
		if not resultKey then
			return false, "Unknown pet"
		end
		if countOf(profile, resultKey) + 1 > maxStack() then
			return false, "You already have the most copies of that finish"
		end
		local cost = costOf("Upgrade", base.Rarity, nextTier, info.MachineLevel)
		if not cost then
			return false, "This pet cannot be fused"
		end
		plan.Inputs = { { Key = a, Count = need, Short = "You need " .. need .. " copies of " .. displayName(def, a) } }
		plan.ResultKey = resultKey
		plan.ResultName = clip(nextTier .. " " .. tostring(base.Name), MAX_NAME_CHARS + 8)
		plan.Rarity = base.Rarity
		plan.Tier = nextTier
		plan.Cost = cost
		plan.Level = levelOf(profile, a)
		plan.Role = base.Role
	elseif action == "Mix" then
		local pa, pb = parseKey(a), parseKey(b)
		if not pa or not pb then
			return false, "Pick two pets to mix"
		end
		if pa.HybridId or pb.HybridId then
			return false, "Hybrids cannot be mixed again: pick two regular pets"
		end
		if pa.PetId == pb.PetId then
			return false, "Pick two different pets to mix"
		end
		local defA, defB = defOf(a, profile), defOf(b, profile)
		local baseA, baseB = catalogDef(pa.PetId), catalogDef(pb.PetId)
		if not defA or not defB or not baseA or not baseB then
			return false, "Unknown pet"
		end
		if countOf(profile, a) < 1 then
			return false, "You do not own " .. displayName(defA, a)
		end
		if countOf(profile, b) < 1 then
			return false, "You do not own " .. displayName(defB, b)
		end
		local hybrids = type(profile.Hybrids) == "table" and profile.Hybrids or {}
		if countKeys(hybrids) >= MAX_HYBRIDS then
			return false, "Your hybrid collection is full (" .. MAX_HYBRIDS .. ")"
		end
		local rarity = higherRarity(baseA.Rarity, baseB.Rarity)
		local cost = costOf("Mix", rarity, nil, info.MachineLevel)
		if not cost then
			return false, "These pets cannot be mixed"
		end
		local tier = pa.Tier
		if (TIER_RANK[pb.Tier] or 1) < (TIER_RANK[tier] or 1) then
			tier = pb.Tier
		end
		-- the move choice: Elements in the attack parent's order (deduplicated), SpecialFrom = "Style" | nil
		local okMoves, elements, specialFrom = false, nil, nil
		if type(petKeys.MixMoves) == "function" then
			okMoves, elements, specialFrom = pcall(petKeys.MixMoves, baseA, baseB, moves)
		end
		if not okMoves or type(elements) ~= "table" then
			return false, "These pets cannot be mixed"
		end
		local name = nil
		if type(petKeys.BlendName) == "function" then
			local okName, blended = pcall(petKeys.BlendName, baseA.Name, baseB.Name)
			if okName and type(blended) == "string" and blended ~= "" then
				name = clip(blended, 24)
			end
		end
		plan.Inputs = {
			{ Key = a, Count = 1, Short = "You do not own " .. displayName(defA, a) },
			{ Key = b, Count = 1, Short = "You do not own " .. displayName(defB, b) },
		}
		plan.Record = { Body = pa.PetId, Style = pb.PetId, Elements = elements, Name = name, Rarity = rarity, Tier = tier }
		if specialFrom == "Style" then
			plan.Record.SpecialFrom = "Style" -- left out otherwise (= the Body, today's rule)
		end
		plan.ResultName = name or "Hybrid"
		plan.Rarity = rarity
		plan.Tier = tier
		plan.Cost = cost
		plan.Level = math.max(1, math.floor((levelOf(profile, a) + levelOf(profile, b)) / 2))
	else
		return false, "Unknown fusion"
	end
	-- Phase 4: a training pet cannot be fused (the lock); nor can the result key train meanwhile (carrying a higher rank
	-- onto it would end its paid job early)
	local training = trainingKeys(player)
	for _, input in ipairs(plan.Inputs) do
		if training[input.Key] then
			return false, displayName(defOf(input.Key, profile), input.Key) .. " is training: wait for it to finish"
		end
	end
	if plan.ResultKey and training[plan.ResultKey] then
		return false, displayName(defOf(plan.ResultKey, profile), plan.ResultKey) .. " is training: wait for it to finish"
	end
	local freed, short = planUse(profile, home, plan.Inputs)
	if not freed then
		return false, short or "You do not have those pets"
	end
	local okRule, why = checkEquippedRule(profile, freed)
	if not okRule then
		return false, why
	end
	plan.Freed = freed
	local currency, price = currencyOf(plan.Cost)
	plan.Currency, plan.Price = currency, price
	-- lobby shop (spec 5.2, the gem settle hold): a gem fusion waits for this server's settle read after the load (a
	-- server hop must not spend gems the old server already spent); fails closed when the check itself errors
	if currency == "Gems" and dataService and type(dataService.GemsSettled) == "function" and select(2, dsCall("GemsSettled", player)) ~= true then
		return false, "Your data is still loading"
	end
	if balanceOf(player, currency) < price then
		if currency == "Gems" then
			return false, "Not enough Gems: this fusion costs " .. priceText(plan.Cost)
		end
		return false, "Not enough Cloud Tokens: this fusion costs " .. priceText(plan.Cost)
	end
	return true, plan
end

----------------------------------------------------------------------
-- Execution (one non-yielding step)
----------------------------------------------------------------------

local function petIdsOf(plan)
	local ids = {}
	for _, input in ipairs(plan.Inputs) do
		local parsed = parseKey(input.Key)
		if parsed and parsed.PetId then
			ids[#ids + 1] = parsed.PetId
		end
	end
	if plan.ResultKey then
		local parsed = parseKey(plan.ResultKey)
		if parsed and parsed.PetId then
			ids[#ids + 1] = parsed.PetId
		end
	end
	return ids
end

-- What the step below may touch: the input / result entries of Pets and Tiers (hybrid inputs are refused, the new
-- hybrid record is removed by uid) and the equipped list.
local function takeSnapshot(profile, plan)
	local snap = { Pets = {}, Tiers = {}, Equipped = copyList(profile.Equipped) }
	local pets = type(profile.Pets) == "table" and profile.Pets or {}
	local tiers = type(profile.Tiers) == "table" and profile.Tiers or {}
	for _, id in ipairs(petIdsOf(plan)) do
		snap.Pets[id] = { Value = pets[id] }
		snap.Tiers[id] = { Value = deepCopy(tiers[id]) }
	end
	return snap
end

local function restoreSnapshot(profile, snap, newUid)
	if type(profile.Pets) ~= "table" then
		profile.Pets = {}
	end
	for id, box in pairs(snap.Pets) do
		profile.Pets[id] = box.Value
	end
	if next(snap.Tiers) ~= nil then
		if type(profile.Tiers) ~= "table" then
			profile.Tiers = {}
		end
		for id, box in pairs(snap.Tiers) do
			profile.Tiers[id] = box.Value
		end
	end
	if newUid and type(profile.Hybrids) == "table" then
		profile.Hybrids[newUid] = nil
	end
	local eq = type(profile.Equipped) == "table" and profile.Equipped or {}
	for i = #eq, 1, -1 do
		eq[i] = nil
	end
	for i, k in ipairs(snap.Equipped) do
		eq[i] = k
	end
	profile.Equipped = eq
end

local function spendCurrency(player, currency, price)
	if price <= 0 then
		return true
	end
	local fnName = (currency == "Gems") and "SpendGems" or "SpendTokens"
	local ok, result = dsCall(fnName, player, price)
	return ok and result == true
end

local function writeLevel(profile, key, level)
	if not isFinite(level) or level <= 1 then
		return
	end
	if type(profile.PetLevels) ~= "table" then
		profile.PetLevels = {}
	end
	local cur = levelOf(profile, key)
	if level > cur then
		profile.PetLevels[key] = { Level = math.floor(level), Xp = 0 }
	end
end

-- Team balance: the followers are the active team, so a used-up follower's slot passes to the result (or empties when
-- the result is already in that team). The next Refresh / Sync drops the key from the other presets.
local function passTeamSlot(profile, usedKey, resultKey)
	local teams = type(profile.Teams) == "table" and profile.Teams or nil
	local team = teams and type(teams.Presets) == "table" and teams.Presets[teams.Active] or nil
	if type(team) ~= "table" then
		return
	end
	local slot, hasResult = nil, false
	for i, k in ipairs(team) do
		if k == usedKey then
			slot = i
		elseif k == resultKey then
			hasResult = true
		end
	end
	if slot and resultKey and not hasResult then
		team[slot] = resultKey
	elseif slot then
		table.remove(team, slot)
	end
end

-- The new equipped list: freed entries out, the result in the first freed place.
local function rebuildEquipped(profile, freed, resultKey)
	local eq = type(profile.Equipped) == "table" and profile.Equipped or {}
	local out = {}
	local placed = false
	for i, k in ipairs(eq) do
		if freed.Equipped[i] then
			passTeamSlot(profile, k, resultKey)
			if not placed and resultKey then
				out[#out + 1] = resultKey
				placed = true
			end
		else
			out[#out + 1] = k
		end
	end
	for i = #eq, 1, -1 do
		eq[i] = nil
	end
	local cap = (Config.Pets and Config.Pets.MaxEquipped) or 3
	for i, k in ipairs(out) do
		if i <= cap then
			eq[i] = k
		end
	end
	profile.Equipped = eq
	return placed
end

-- Clears the freed Garden slots (and any old Gym slot: the Gym is retired); the result takes the smallest freed Garden
-- slot whatever its role (Phase 4: any pet works in the garden). No Gym placement.
local function freeHomeSlots(player, freed, resultKey)
	if #freed.Garden == 0 and #freed.Gym == 0 then
		return true, nil
	end
	local placedIn = nil
	local ok, wrote = dsCall("MutateHome", player, function(home)
		if type(home.Garden) ~= "table" then
			home.Garden = {}
		end
		for _, slot in ipairs(freed.Garden) do
			home.Garden[slot] = nil
		end
		if type(home.Gym) == "table" then
			for _, slot in ipairs(freed.Gym) do
				home.Gym[slot] = nil
			end
		end
		if resultKey and #freed.Garden > 0 then
			local slot = nil
			for _, s in ipairs(freed.Garden) do
				if type(s) == "number" and (slot == nil or s < slot) then
					slot = s
				end
			end
			if slot then
				home.Garden[slot] = resultKey
				placedIn = "Garden"
			end
		end
		return true
	end)
	if not ok or wrote ~= true then
		warn("[FusionService] could not free the Garden slots of the fused pets")
		return false, nil
	end
	return true, placedIn
end

-- Phase 4 (contract 3.6): the result's growth, in the same non-yielding commit as the pets. Upgrade: the result gets
-- the input key's stage and ranks (the higher of each); Mix: stage 0 and the parents' higher rank per skill. The entry
-- of an input key no copy of which is left is dropped (an owned key's numbers are kept by DataService anyway).
local function carryGrowth(player, plan, resultKey, before)
	if not dataService or type(dataService.MutateGrowth) ~= "function" then
		return false
	end
	local profile = plan.Profile
	local gone = {}
	for _, input in ipairs(plan.Inputs) do
		if countOf(profile, input.Key) < 1 then
			gone[#gone + 1] = input.Key
		end
	end
	local ok, wrote = dsCall("MutateGrowth", player, function(g)
		local e = g[resultKey]
		if type(e) ~= "table" then
			e = {}
			g[resultKey] = e
		end
		if plan.Action == "Upgrade" then
			local stage = before[1].Evo
			if isFinite(e.Evo) and e.Evo > stage then
				stage = e.Evo
			end
			e.Evo = stage
		elseif not isFinite(e.Evo) then
			e.Evo = 0
		end
		for _, stat in ipairs(GROWTH_STATS) do
			local rank = isFinite(e[stat]) and e[stat] or 0
			for _, b in ipairs(before) do
				if b[stat] > rank then
					rank = b[stat]
				end
			end
			e[stat] = rank
		end
		for _, key in ipairs(gone) do
			if key ~= resultKey then
				g[key] = nil
			end
		end
		return true
	end)
	if not ok or wrote ~= true then
		warn("[FusionService] could not carry the evolution / training of the fused pets")
		return false
	end
	return true
end

local function newHybridUid(profile)
	local seed = random():NextInteger(0, 2147483646)
	local uid = nil
	if type(petKeys.NewHybridId) == "function" then
		local ok, result = pcall(petKeys.NewHybridId, profile, seed)
		if ok and type(result) == "string" then
			uid = result
		end
	end
	return uid
end

-- Runs a plan. ok, resultKey | reason
local function execute(player, plan)
	local profile = plan.Profile
	if getProfile(player) ~= profile then
		return false, "Your data changed: try again"
	end
	local resultKey = plan.ResultKey
	local uid = nil
	local record = nil
	if plan.Action == "Mix" then
		uid = newHybridUid(profile)
		if not uid then
			return false, "Could not make a new hybrid: try again"
		end
		record = deepCopy(plan.Record)
		record.Seed = random():NextInteger(1, 999999)
		resultKey = petKeys.HybridKey(uid, plan.Tier)
		if not resultKey then
			return false, "Could not make a new hybrid: try again"
		end
	end

	-- everything below runs without yielding: the inputs leave, the result arrives and the price is paid together
	local before = {}
	for i, input in ipairs(plan.Inputs) do
		before[i] = growthOf(player, input.Key)
	end
	local snap = takeSnapshot(profile, plan)
	local consumed = {}
	local okStep, err = pcall(function()
		for _, input in ipairs(plan.Inputs) do
			if not petKeys.Remove(profile, input.Key, input.Count) then
				error("remove " .. input.Key, 0)
			end
			consumed[#consumed + 1] = input.Key
		end
		local added
		if record then
			added = petKeys.Add(profile, resultKey, 1, record)
		else
			added = petKeys.Add(profile, resultKey, 1)
		end
		if not added then
			error("add " .. tostring(resultKey), 0)
		end
		if not spendCurrency(player, plan.Currency, plan.Price) then
			error("price", 0)
		end
	end)
	if not okStep then
		restoreSnapshot(profile, snap, uid)
		if err == "price" then
			if plan.Currency == "Gems" then
				return false, "Not enough Gems"
			end
			return false, "Not enough Cloud Tokens"
		end
		warn("[FusionService] fusion rolled back: " .. tostring(err))
		return false, "The fusion fizzled: nothing was used"
	end
	-- the result takes over the places the inputs left, and their evolution / training. Bug batch 2 #18: one job at a
	-- time, so a result that follows the player does not also take the freed Garden place (PetService.Refresh would
	-- otherwise drop the follow, past checkEquippedRule, and could leave the player with no pet)
	local follows = rebuildEquipped(profile, plan.Freed, resultKey)
	writeLevel(profile, resultKey, plan.Level)
	carryGrowth(player, plan, resultKey, before)
	local def = defOf(resultKey, profile)
	freeHomeSlots(player, plan.Freed, (not follows) and resultKey or nil)
	plan.LeftGarden = follows and #plan.Freed.Garden > 0 or nil
	dsCall("MarkDirty", player)
	return true, resultKey, def, consumed
end

local function finish(player, plan, resultKey, def, consumed)
	-- republish the equipped attributes and perks (PetService also re-validates the list), then the snapshot
	local refreshed = false
	if petService and type(petService.Refresh) == "function" then
		local ok = pcall(petService.Refresh, player)
		refreshed = ok
	end
	if not refreshed and petService and type(petService.GetPerks) == "function" then
		-- an older PetService: at least keep the attribute other clients draw from in step
		local profile = getProfile(player)
		if profile then
			pcall(function()
				player:SetAttribute(Config.Attr.EquippedPets, table.concat(profile.Equipped, ","))
			end)
		end
	end
	dsCall("Sync", player)
	local name = displayName(def, resultKey)
	local rarity = (type(def) == "table" and def.Rarity) or plan.Rarity
	-- bug batch 2 #18: say where the garden place went when the result follows instead
	local tail = plan.LeftGarden and " It follows you, so its garden place is free." or ""
	if plan.Action == "Mix" then
		notify(player, "New hybrid: " .. name .. " (" .. tostring(rarity) .. ")!" .. tail, "good", plan.LeftGarden and 5 or 4)
	else
		notify(player, "Fusion complete: " .. name .. "!" .. tail, "good", plan.LeftGarden and 5 or 4)
	end
	reply(player, {
		Ok = true,
		Action = plan.Action,
		Key = resultKey,
		Name = name,
		Rarity = rarity,
		Tier = plan.Tier,
		Consumed = consumed,
	})
	FusionService.Fused:Fire(player, plan.Action, resultKey, consumed)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function FusionService.Unlocked(player)
	local ok, reason, info = checkUnlocked(player)
	return ok, reason, info
end

function FusionService.Preview(player, action, a, b, moves)
	if action ~= "Upgrade" and action ~= "Mix" then
		return false, "Unknown fusion"
	end
	if action == "Upgrade" then
		moves = nil
	end
	local ok, plan = buildPlan(player, action, a, b, moves)
	if not ok then
		return false, plan
	end
	local inputs = {}
	for i, input in ipairs(plan.Inputs) do
		inputs[i] = { Key = input.Key, Count = input.Count }
	end
	local garden, gym = {}, {}
	for i, s in ipairs(plan.Freed.Garden) do
		garden[i] = s
	end
	for i, s in ipairs(plan.Freed.Gym) do
		gym[i] = s
	end
	local record = plan.Record
	return true, {
		Action = plan.Action,
		Cost = deepCopy(plan.Cost),
		ResultKey = plan.ResultKey,
		ResultName = plan.ResultName,
		Rarity = plan.Rarity,
		Tier = plan.Tier,
		Inputs = inputs,
		Freed = { Equipped = countKeys(plan.Freed.Equipped), Garden = garden, Gym = gym },
		Elements = record and copyList(record.Elements) or nil, -- Mix: the new record's element order
		SpecialFrom = record and record.SpecialFrom or nil, -- Mix: "Style" | nil (the Body)
	}
end

local function run(player, action, a, b, moves)
	local ok, plan = buildPlan(player, action, a, b, moves)
	if not ok then
		return false, plan
	end
	local done, resultKey, def, consumed = execute(player, plan)
	if not done then
		return false, resultKey
	end
	finish(player, plan, resultKey, def, consumed)
	return true, resultKey
end

function FusionService.Upgrade(player, key)
	return run(player, "Upgrade", key, nil)
end

function FusionService.Mix(player, keyA, keyB, moves)
	return run(player, "Mix", keyA, keyB, moves)
end

----------------------------------------------------------------------
-- Remote Fusion(action, a, b, moves)
----------------------------------------------------------------------

local function machineModel(player)
	if not tycoonService or type(tycoonService.GetPlot) ~= "function" then
		return nil, "unknown"
	end
	local ok, info = pcall(tycoonService.GetPlot, player)
	if not ok or type(info) ~= "table" then
		return nil, "noplot"
	end
	local hbm = getHomeBuilder()
	if hbm and type(hbm.GetStation) == "function" then
		local okStation, model = pcall(hbm.GetStation, info, MACHINE_ID)
		if okStation and typeof(model) == "Instance" and model.Parent then
			return model, nil
		end
	end
	local folder = info.Folder
	if typeof(folder) == "Instance" then
		local model = folder:FindFirstChild("Station_" .. MACHINE_ID, true)
		if model then
			return model, nil
		end
	end
	return nil, "nomodel"
end

local function modelPosition(model)
	if model:IsA("Model") then
		local ok, pivot = pcall(model.GetPivot, model)
		if ok and typeof(pivot) == "CFrame" then
			return pivot.Position
		end
	elseif model:IsA("BasePart") then
		return model.Position
	end
	return nil
end

-- ok, reason: remote requests come from the window at the player's own machine
local function nearMachine(player)
	local model, why = machineModel(player)
	if not model then
		if why == "noplot" then
			return false, "Claim your home and use its Fusion Machine"
		end
		return true -- no plot service / no machine model to measure (HomeBuilder missing): the data checks decide
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local at = modelPosition(model)
	if not root or not at then
		return false, "Walk up to your Fusion Machine"
	end
	if (root.Position - at).Magnitude > MACHINE_RANGE then
		return false, "Walk up to your Fusion Machine"
	end
	return true
end

local function validKeyArg(v)
	return type(v) == "string" and v ~= "" and #v <= MAX_KEY_LENGTH
end

local function onFusionRemote(player, action, a, b, moves)
	if not isPlayer(player) or type(action) ~= "string" or #action > MAX_ACTION_LENGTH then
		return
	end
	if not spend(player) then
		return
	end
	if action ~= "Upgrade" and action ~= "Mix" then
		return
	end
	if not validKeyArg(a) or (action == "Mix" and not validKeyArg(b)) then
		reply(player, { Ok = false, Action = action, Reason = "Pick the pets to fuse" })
		return
	end
	-- the move choice is checked (type and one of the four strings) before anything else is read; nil = today's rule
	if action == "Mix" and not validMoves(moves) then
		reply(player, { Ok = false, Action = "Mix", Reason = MOVES_TEXT })
		toastOnce(player, MOVES_TEXT, "bad")
		return
	end
	if action == "Upgrade" then
		b = nil
		moves = nil -- Upgrade ignores a 4th argument
	end
	if not cooldownReady(player) then
		reply(player, { Ok = false, Action = action, Reason = "One fusion at a time", Quiet = true })
		return
	end
	local okNear, whyNear = nearMachine(player)
	if not okNear then
		toastOnce(player, whyNear, "bad")
		reply(player, { Ok = false, Action = action, Reason = whyNear })
		return
	end
	local ok, result = run(player, action, a, b, moves)
	if not ok then
		toastOnce(player, result or "That fusion is not possible", "bad")
		reply(player, { Ok = false, Action = action, Reason = result })
	end
end

local function forget(player)
	cooldowns[player] = nil
	budgets[player] = nil
	toastAt[player] = nil
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function FusionService.Init(deps)
	if initialized then
		return
	end
	deps = type(deps) == "table" and deps or {}
	dataService = deps.DataService or requireModule(script.Parent, "DataService")
	petService = deps.PetService or requireModule(script.Parent, "PetService")
	tycoonService = deps.TycoonService
	petKeys = requireModule(Shared, "PetKeys")
	petCatalog = requireModule(Shared, "PetCatalog")
	catalog = requireModule(Shared, "TycoonCatalog")
	if not dataService or type(dataService.GetProfile) ~= "function" then
		warn("[FusionService] DataService is missing: the Fusion Machine is disabled")
		return
	end
	if not petKeys or type(petKeys.Add) ~= "function" or type(petKeys.Remove) ~= "function" then
		warn("[FusionService] PetKeys is missing: the Fusion Machine is disabled")
		return
	end
	if not catalog or type(catalog.FusionCost) ~= "function" then
		warn("[FusionService] TycoonCatalog has no fusion costs: the Fusion Machine is disabled")
		return
	end
	initialized = true
	local ok, remote = pcall(Remotes.Get, "Fusion")
	if ok and remote then
		fusionRemote = remote
		remote.OnServerEvent:Connect(onFusionRemote)
	else
		warn("[FusionService] the Fusion remote is missing: fusing only works from server code")
	end
	-- no per-player state to set up for players already in the game: everything is read from their profile on use
	Players.PlayerRemoving:Connect(forget)
end

return FusionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1095">
          <Properties>
            <string name="Name">GateService</string>
            <string name="Source"><![CDATA[-- GateService (Phase 5, ARCHITECTURE_V3.md "Phase 5 build contract" 6.2): the prompt of the Gate Court's Altar gate.
-- Phase 6: the lobby has no Home gate any more (the player asked): players go home with the Home window's Go home
-- button (HomeAction "GoHome" -> TycoonService's home portal; without a home it leads to a free plot's gate, and the
-- Home tile's Claim a home sends GoToSpot, the same portal). "Home" is no gate id here: Use(player, "Home") is junk.
--
--   GateService.Init(lobbyInfo, deps)  deps = { SpotService, PortalService, StormAltar, ArenaInfo, MatchService,
--                                      DataService, PlayerService, ArenaBuilder } (Main.server, after SpotService.Init
--                                      and PortalService.Init)
--   GateService.Teleported             Util.Signal; Fire(player, "Altar" | "Plaza") once per accepted teleport
--   GateService.Use(player, gateId)    the handler behind the prompt (tests call it); -> ok, reason
--   GateService.Travel(player, dest)   Remotes.QuickTravel(dest), client -> server -> ok, reason. dest "Plaza" (the top-left
--                                      pill's Travel button) opens the home portal with the lobby as its destination
--                                      (TycoonService.OpenLobbyPortal: the refusals and their toasts, the 3 s cooldown shared
--                                      with Go home and the replacing of an open portal are that portal's); nothing moves
--                                      until the owner walks in. dest "Altar" (shop-area 16.17.3: the Shop's Secret card
--                                      TRAVEL) runs the Altar gate prompt's checks without its distance ("dead" / "match" /
--                                      "battle" / "locked" / "cooldown", the gates' shared 1.5 s cooldown), only from the
--                                      lobby (Config.InLobbyZone, else "away"; the owner's call 2026-11-11), and puts the
--                                      character on StormAltar.GetLanding() ("failed" without one), Teleported "Altar".
--                                      Every Altar refusal toasts its reason (Notify "bad", at most one per 1.5 s:
--                                      the Shop closed on TRAVEL, so a silent refusal read as a broken button).
--                                      Anything else: "junk".
--   GateService.ToLobby(player)        the Lobby portal's landing: the lobby spawn (PlayerService.GetLobbySpawnCFrame()), fires
--                                      Teleported(player, "Plaza") -> moved
--
-- Prompts (created here on LobbyInfo.Gates.<Id>.PromptPart, MaxActivationDistance 12, HoldDuration 0):
--   AltarGatePrompt  "Enter" / "Storm Altar"    -> StormAltar.GetLanding(): the island deck at the bridge end
-- bug batch 2 #4: and on StormAltar.GetReturnPad() (the small return portal beside the landing, MaxActivationDistance 8):
--   PlazaGatePrompt  "Enter" / "Plaza"          -> LobbyInfo.Gates.Altar.ReturnCFrame: the plaza 18 studs in front of
--                                                  the Altar gate (fallback: 15 studs in front of its prompt part)
--                    Teleported fires (player, "Plaza"); the pad is looked up again when the altar was rebuilt.
-- The Obby gate's prompt is PortalService's, the Dungeon gate's DungeonService's, Ring / Arena are ArenaBuilder's.
-- Every use is checked on the server (Y12): the prompt is this one, the player is alive, not InMatch, not
-- InBattle (also set for a whole dungeon run), not locked on a portal pad (PortalService.IsLocked), within
-- MaxActivationDistance + 4 of the prompt part, and 1.5 s after their last use (one cooldown for both directions).
-- A seated player (a lobby bench) is stood up before the teleport so the seat stays where it is. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local GateService = {}
GateService.Teleported = Util.Signal()

local PROMPT_RANGE = 12
local RANGE_SLACK = 4
local COOLDOWN = 1.5
local ATTR_IN_BATTLE = (Config.Attr and Config.Attr.InBattle) or "InBattle"
local ATTR_IN_MATCH = (Config.Attr and Config.Attr.InMatch) or "InMatch"

-- (Pitch 2 item 13 A) the gates say "Enter": "Travel" is gone from the game's words (the Shop's button became "Show the
-- way", a walking guide), so a gate you walk up to is a door you go through.
-- (look review r1, M2) Lift = studs the prompt's plank floats over its chest-high anchor (the prompt attribute CardLift,
-- PromptController's StudsOffsetWorldSpace): at the gate the anchor projects onto the player's own body, under a phone's
-- vitals card and the travel guide's chip; lifted, the plank hangs in the gate's opening over the player's head. The
-- prompt's range is still measured from the anchor
local PROMPTS = {
	Altar = { Name = "AltarGatePrompt", Action = "Enter", Object = "Storm Altar", Lift = 6 },
	Plaza = { Name = "PlazaGatePrompt", Action = "Enter", Object = "Plaza", Range = 8 }, -- bug batch 2 #4
}
local ORDER = { "Altar" } -- Phase 6: no Home gate (the Home window's Go home is the way home)

local S = {
	deps = {},
	prompts = {}, -- ProximityPrompt -> gate id
	parts = {}, -- gate id -> prompt part
	plazaCF = nil, -- bug batch 2 #4: the "Plaza" gate's arrival (LobbyInfo.Gates.Altar.ReturnCFrame)
	lastUse = {}, -- Player -> os.clock() of the last accepted use
	lastRefusal = {}, -- Player -> os.clock() of the last refused Travel("Altar") toast
	lobbyInfo = nil,
	conn = nil,
	initialized = false,
}

local function notify(player, text, kind)
	local ok, remote = pcall(Remotes.Get, "Notify")
	if ok and remote then
		pcall(remote.FireClient, remote, player, text, kind or "info", 4)
	end
end

local function hasFn(t, name)
	return type(t) == "table" and type(t[name]) == "function"
end

local function inMatch(player)
	if player:GetAttribute(ATTR_IN_MATCH) == true then
		return true
	end
	local ms = S.deps.MatchService
	if hasFn(ms, "GetMatchOf") then
		local ok, match = pcall(ms.GetMatchOf, player)
		if ok and match then
			return true
		end
	end
	return false
end

local function inBattle(player)
	local v = player:GetAttribute(ATTR_IN_BATTLE)
	return v ~= nil and v ~= false
end

local function isLocked(player)
	local ps = S.deps.PortalService
	if hasFn(ps, "IsLocked") then
		local ok, locked = pcall(ps.IsLocked, player)
		return ok and locked == true
	end
	return false
end

local function aliveRoot(player)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root then
		return nil
	end
	return root
end

local function placeCharacter(player, cf)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or typeof(cf) ~= "CFrame" then
		return false
	end
	-- bug batch 2 #7: a seated player is welded to an anchored seat; break the weld first or the seat comes along
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if seat then
		pcall(function()
			for _, d in ipairs(seat:GetChildren()) do
				if d:IsA("JointInstance") and d.Name == "SeatWeld" then
					d:Destroy()
				end
			end
			humanoid.Sit = false
		end)
	end
	local ok = pcall(function()
		char:PivotTo(cf)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
	return ok
end

-- The checks of 6.2 in order, then the teleport. -> ok, reason
function GateService.Use(player, gateId)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then
		return false, "junk"
	end
	if gateId == "Plaza" then
		GateService._bindPlaza() -- the altar may have been rebuilt since Init
	end
	local part = S.parts[gateId]
	local spec = PROMPTS[gateId]
	if not part or part.Parent == nil or not spec then
		return false, "junk"
	end
	local root = aliveRoot(player)
	if not root then
		return false, "dead"
	end
	if inMatch(player) then
		return false, "match"
	end
	if inBattle(player) then
		notify(player, "Finish your battle first!", "bad")
		return false, "battle"
	end
	if isLocked(player) then
		return false, "locked"
	end
	if (root.Position - part.Position).Magnitude > (spec.Range or PROMPT_RANGE) + RANGE_SLACK then
		return false, "far"
	end
	local now = os.clock()
	local last = S.lastUse[player]
	if last and now - last < COOLDOWN then
		return false, "cooldown"
	end
	S.lastUse[player] = now

	local moved = false
	if gateId == "Altar" then
		local altar = S.deps.StormAltar
		local cf = nil
		if hasFn(altar, "GetLanding") then
			local ok, result = pcall(altar.GetLanding)
			cf = ok and result or nil
		end
		moved = typeof(cf) == "CFrame" and placeCharacter(player, cf)
	elseif gateId == "Plaza" then
		moved = typeof(S.plazaCF) == "CFrame" and placeCharacter(player, S.plazaCF)
	end
	if not moved then
		return false, "failed"
	end
	GateService.Teleported:Fire(player, gateId)
	return true
end

-- The QuickTravel remote. "Plaza" (the pill's Travel button): the home portal, leading to the lobby. "Altar" (shop-area
-- 16.17.3, the Shop's Secret card TRAVEL): the Altar gate prompt's checks without its distance (a live root, not InMatch,
-- not in a battle, not locked on a portal pad, the gates' shared cooldown), then straight to StormAltar.GetLanding() and
-- Teleported(player, "Altar"). Anything else: "junk". -> ok, reason
function GateService.Travel(player, dest)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then
		return false, "junk"
	end
	if dest == "Altar" then
		return GateService._toAltar(player)
	end
	if dest ~= "Plaza" then
		return false, "junk"
	end
	local tycoon = S.deps.TycoonService
	if not hasFn(tycoon, "OpenLobbyPortal") then
		return false, "failed"
	end
	return tycoon.OpenLobbyPortal(player)
end

-- Travel(player, "Altar") refusals the player is told about (shop-area review round 1: the Shop's TRAVEL closes the
-- window before any answer, so a silent refusal read as a broken button). The texts are the home portal's
-- (TycoonService Portal.refuse / its cooldown) where one exists. At most one per player per COOLDOWN, so a mash of
-- refused taps never stacks toasts.
local TRAVEL_REFUSED = {
	dead = "You cannot travel right now",
	match = "Finish your match first",
	battle = "Finish your battle first!",
	locked = "Leave the portal party first",
	cooldown = "Wait a moment",
	away = "Travel to the Storm Altar from the lobby",
	failed = "The Storm Altar is not ready yet",
}

local function refuseTravel(player, reason)
	local now = os.clock()
	local last = S.lastRefusal[player]
	if not (last and now - last < COOLDOWN) then
		S.lastRefusal[player] = now
		notify(player, TRAVEL_REFUSED[reason] or "You cannot travel right now", "bad")
	end
	return false, reason
end

-- Travel(player, "Altar"): every refusal moves nothing and tells the player why; the cooldown is the gate prompts'
-- (S.lastUse, COOLDOWN). The owner's call (2026-11-11): only from the lobby (Config.InLobbyZone: not a home plot, the
-- ring street, the Arena, a course, nor the Altar island itself), like the other trips' portal walk -> "away".
function GateService._toAltar(player)
	local root = aliveRoot(player)
	if not root then
		return refuseTravel(player, "dead")
	end
	if inMatch(player) then
		return refuseTravel(player, "match")
	end
	if inBattle(player) then
		return refuseTravel(player, "battle")
	end
	if isLocked(player) then
		return refuseTravel(player, "locked")
	end
	local now = os.clock()
	local last = S.lastUse[player]
	if last and now - last < COOLDOWN then
		return refuseTravel(player, "cooldown")
	end
	if not Config.InLobbyZone(root.Position) then
		return refuseTravel(player, "away")
	end
	S.lastUse[player] = now
	local altar = S.deps.StormAltar
	local cf = nil
	if hasFn(altar, "GetLanding") then
		local ok, result = pcall(altar.GetLanding)
		cf = ok and result or nil
	end
	if typeof(cf) ~= "CFrame" or not placeCharacter(player, cf) then
		return refuseTravel(player, "failed")
	end
	GateService.Teleported:Fire(player, "Altar")
	return true
end

-- A Lobby portal's landing: the lobby spawn. -> moved
function GateService.ToLobby(player)
	local cf = nil
	local ps = S.deps.PlayerService
	if hasFn(ps, "GetLobbySpawnCFrame") then
		local ok, result = pcall(ps.GetLobbySpawnCFrame)
		cf = ok and result or nil
	end
	if typeof(cf) ~= "CFrame" and type(S.lobbyInfo) == "table" then
		cf = S.lobbyInfo.SpawnCFrame
	end
	if typeof(cf) ~= "CFrame" or not placeCharacter(player, cf) then
		return false
	end
	GateService.Teleported:Fire(player, "Plaza")
	return true
end

local function makePrompt(part, spec)
	local old = part:FindFirstChild(spec.Name)
	if old then
		old:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = spec.Name
	prompt.ActionText = spec.Action
	prompt.ObjectText = spec.Object
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = spec.Range or PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	if type(spec.Lift) == "number" then
		prompt:SetAttribute("CardLift", spec.Lift)
	end
	prompt.Parent = part
	return prompt
end

function GateService.Init(lobbyInfo, deps)
	S.deps = type(deps) == "table" and deps or {}
	if S.initialized then
		return
	end
	S.initialized = true
	S.lobbyInfo = type(lobbyInfo) == "table" and lobbyInfo or nil
	local gates = type(lobbyInfo) == "table" and type(lobbyInfo.Gates) == "table" and lobbyInfo.Gates or {}
	for _, id in ipairs(ORDER) do
		local gate = gates[id]
		local part = type(gate) == "table" and gate.PromptPart or nil
		if typeof(part) == "Instance" and part:IsA("BasePart") then
			local prompt = makePrompt(part, PROMPTS[id])
			S.prompts[prompt] = id
			S.parts[id] = part
		else
			warn("[GateService] the lobby has no " .. id .. " gate prompt part")
		end
	end
	-- bug batch 2 #4: the way back from the Storm Altar (the arrival in front of the Altar gate, then the pad's prompt)
	local altarGate = gates.Altar
	if type(altarGate) == "table" and typeof(altarGate.ReturnCFrame) == "CFrame" then
		S.plazaCF = altarGate.ReturnCFrame
	elseif S.parts.Altar then
		local p = S.parts.Altar
		local look = Vector3.new(p.CFrame.LookVector.X, 0, p.CFrame.LookVector.Z)
		look = look.Magnitude > 1e-3 and look.Unit or Vector3.new(0, 0, -1)
		local front = p.Position + look * 15 - Vector3.new(0, 0.5, 0)
		S.plazaCF = CFrame.lookAt(front, front + look)
	end
	GateService._bindPlaza()
	local altar = S.deps.StormAltar
	if type(altar) == "table" and type(altar.Built) == "table" and type(altar.Built.Connect) == "function" then
		altar.Built:Connect(function()
			GateService._bindPlaza() -- a rebuilt altar: the new pad gets the prompt at once
		end)
	end
	S.conn = ProximityPromptService.PromptTriggered:Connect(function(prompt, player)
		local id = S.prompts[prompt]
		if not id then
			return
		end
		local ok, err = pcall(GateService.Use, player, id)
		if not ok then
			warn("[GateService] " .. id .. ": " .. tostring(err))
		end
	end)
	-- HUD cleanup: the pill's Travel button (the refusals' toasts are the portal's, like Go home)
	local okRemote, travelRemote = pcall(Remotes.Get, "QuickTravel")
	if okRemote and travelRemote then
		travelRemote.OnServerEvent:Connect(function(player, dest)
			local ok, err = pcall(GateService.Travel, player, dest)
			if not ok then
				warn("[GateService] QuickTravel: " .. tostring(err))
			end
		end)
	else
		warn("[GateService] no QuickTravel remote")
	end
	Players.PlayerRemoving:Connect(function(player)
		S.lastUse[player] = nil
		S.lastRefusal[player] = nil
	end)
end

-- bug batch 2 #4: (re)binds the "Plaza" gate to the Storm Altar's return pad; a rebuilt altar gets a fresh prompt.
function GateService._bindPlaza()
	local current = S.parts.Plaza
	if current and current.Parent ~= nil then
		return current
	end
	local altar = S.deps.StormAltar
	local part = nil
	if hasFn(altar, "GetReturnPad") then
		local ok, result = pcall(altar.GetReturnPad)
		part = ok and result or nil
	end
	for prompt, id in pairs(S.prompts) do
		if id == "Plaza" then
			S.prompts[prompt] = nil -- the old altar's prompt (destroyed with it)
		end
	end
	S.parts.Plaza = nil
	if typeof(part) == "Instance" and part:IsA("BasePart") and S.plazaCF then
		local prompt = makePrompt(part, PROMPTS.Plaza)
		S.prompts[prompt] = "Plaza"
		S.parts.Plaza = part
		return part
	end
	return nil
end

-- The prompt of a gate ("Altar", "Plaza"), for tests and tutorials.
function GateService.GetPrompt(gateId)
	if gateId == "Plaza" then
		GateService._bindPlaza()
	end
	local part = S.parts[gateId]
	local spec = PROMPTS[gateId]
	return part and spec and part:FindFirstChild(spec.Name) or nil
end

return GateService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1096">
          <Properties>
            <string name="Name">GemService</string>
            <string name="Source"><![CDATA[-- GemService (Phase 2, gems): Gems, the premium currency bought with Robux, and the gem-priced roulettes
-- (ARCHITECTURE_V3.md "Phase 2: Tycoon homes" -> Economy, and the GemService paragraph of the "Phase 2 build contract").
--
-- * Developer products: Config.Gems.Products = { {Id, Gems, Name}... }. Id 0 means the owner has not created that
--   product yet (Creator Hub -> the experience -> Monetization -> Developer Products, then paste its id into Config):
--   such a pack is hidden and never sold. Store (2026-11-04, spec 5.4): every receipt is looked up with
--   StoreCatalog.ProductById (the gem packs AND Config.Store.Items) and a Store item is granted by
--   StoreService.ApplyGrant in the same non-yielding step as the receipt (substitutes for a full stack, a potion past
--   its cap: a paid receipt is never eaten); without StoreService only gem packs are granted.
-- * ProcessReceipt: MarketplaceService.ProcessReceipt is set here and nowhere else (Roblox allows one callback per
--   server). Idempotent through the profile's GemReceipts (DataService.MarkReceipt): the purchase id and the grant are
--   written to the live profile in ONE non-yielding step, then the profile is saved (one UpdateAsync carries both),
--   and only a successful save answers PurchaseGranted. So a purchase is granted once per purchase id: a second call
--   (Roblox retries, another server after a rejoin) finds the receipt and grants nothing. A failed save keeps the
--   receipt and the grant in the live profile and DataService keeps retrying that save (also after the player left);
--   MarkReceipt records what came with the receipt (NoteReceiptGrant replaces it with what was REALLY granted), so
--   when another server granted the same purchase first (Roblox re-sent it there after a rejoin) the late save adds
--   nothing for it: one purchase, one grant. While the profile is not loaded yet (or provisional: the load failed,
--   the real save is unknown) the callback waits up to ProfileWaitSeconds, then answers NotProcessedYet and Roblox
--   asks again later. Unknown product, malformed receipt, player not in this server, failed save: NotProcessedYet.
--   InMatch is NEVER checked here: a late receipt of an earlier prompt is granted in a match. In Studio a failed save
--   still answers PurchaseGranted (test purchases cost nothing and the grant is already in the session). The
--   thank-you toast (the gem text for a gem pack, StoreService.Thank's "Thank you! ..." for a Store item),
--   GemsPurchased (gem packs) and StoreService.Purchased come once per purchase, when it is granted for good (the
--   save succeeded, or Studio): after a failed save, the retry that saves it sends them.
-- * PromptPurchase(player, ref): a validated request (live player, not in a match, a CREATED product picked by its
--   index in Config.Gems.Products or by its product id, a 1 s cooldown) -> MarketplaceService:PromptProductPurchase.
--   A client may also prompt by itself: Gems are only ever granted by ProcessReceipt. Config.Remotes has no gem remote
--   yet; when the lead adds "BuyGems" (ref) it is connected here (rate-limited, numbers only).
-- * PolicyService: GetPolicyInfoForPlayerAsync (pcall) on join, retried with backoff by ONE loop ->
--   ArePaidRandomItemsRestricted. Until the answer is known, or when it is true (or missing), the player counts as
--   restricted: every gem-priced roulette (token roulettes paid with Gems, the gems-only Secret roulette) is refused,
--   and the player attribute PaidRandomItemsRestricted (true while restricted or unknown) tells the client to hide them.
--   Buying Gems themselves stays possible (a fixed amount is not a random item). lobby-shop 16.12 (the owner's pick A,
--   2026-11-08): token-paid roulette spins follow the same answer (TokenSpinLock: only "Allowed" spins with tokens), since
--   a client can open the token packs' Robux prompt itself and a paid receipt is always granted. Release step 1 (the
--   owner's pick, 2026-11-23): that token lock applies only while Config.Store.Enabled is true; with the Store off
--   (nothing sells Tokens) every account spins with Tokens, as on main. Paste a token pack's product id only together
--   with turning the Store on.
-- * Gem roulettes: every token roulette with a price in Config.Gems.RouletteGemPrices (the same odds as with Cloud
--   Tokens) and the gems-only Secret roulette (Config.Gems.SecretRoulette, AllowSecret = true) at the Storm Altar. Secret
--   pets come from the Secret roulette and from Celestial's 2% Secret row (its AllowSecret, lobby-shop 16.1: token and gem
--   rolls alike; Quote hands AllowSecret on). PetService.BuyRoulette(player, rouletteId, "Gems") charges and grants atomically;
--   this module quotes the price and checks the policy. Odds are always available: GetOdds / GetRarityOdds give the
--   exact numbers the roll uses, and a roulette whose odds cannot be listed is not sold.
--
-- Public API
--   GemService.Init(deps)                         deps = { DataService, PetService, StoreService? } (players already in game too)
--   GemService.ProcessReceipt(receiptInfo) -> Enum.ProductPurchaseDecision     (yields: profile wait + save)
--   GemService.PromptPurchase(player, ref) -> ok, reason    ref = product index (1..n) or developer product id
--   GemService.GetProducts() -> { {Index, ProductId, Gems, Name}... }   created products only (Id ~= 0)
--   GemService.GetProduct(ref) -> {Index, ProductId, Gems, Name, Created} | nil
--   GemService.PolicyState(player) -> "Allowed" | "Restricted" | "Checking"
--   GemService.IsRestricted(player) -> bool                  true unless the policy said "Allowed"
--   GemService.SecretRouletteState(player) -> "Open" | "Restricted" | "Checking" | "Unavailable"   (the Storm Altar)
--   GemService.TokenSpinLock(player) -> nil | reason   nil only when PolicyState is "Allowed" (16.12; never yields);
--                                        always nil while the Store is off (Config.Store.Enabled, release step 1)
--   GemService.Recheck(player) -> state   asks PolicyService again while "Checking" (kickPolicy's 5 s gap; 16.13 review)
--   GemService.GetRoulette(id) -> {Id, DisplayName, GemPrice, Color, AllowSecret, GemsOnly, Odds} | nil   (a copy)
--   GemService.ListRoulettes() -> {def...}   token roulettes with a gem price (Config.Roulettes order), then gems-only
--   GemService.RoulettePrice(id) -> gems | nil
--   GemService.Quote(player, id) -> ok, {RouletteId, DisplayName, Price, AllowSecret, GemsOnly, Roll} | reason
--                                    (never yields; Roll = nil for token roulettes: PetCatalog.RollPet rolls them)
--   GemService.Roll(player, id) -> ok, result|reason    a gem-paid spin = PetService.BuyRoulette(player, id, "Gems")
--   GemService.RollPet(id, rng, opts?) -> petId | nil   every roulette (the Secret Roulette too): PetCatalog.RollPet;
--                                    opts.ForceRarity (the pity, server only): the Float draw is thrown away, then
--                                    PetCatalog.RollFromRarity(id, ForceRarity, rng) (the rng position of an unforced roll)
--   GemService.GetOdds(id) -> {{PetId, Rarity, Chance}...}, GetRarityOdds(id) -> {{Rarity, Chance, Count}...},
--   GemService.PossiblePets(id) -> {PetDef...}               PetCatalog's own tables for both kinds (lobby-shop spec
--                                                            5.1: one odds source; PetCatalog knows the Secret Roulette)
--   GemService.GemsPurchased   Util.Signal Fire(player, gems, productId, purchaseId) once a purchase is granted for good
--                              (saved; in Studio also unsaved), once per purchase
--   GemService.ProfileWaitSeconds = 12                       how long ProcessReceipt waits for a loading profile
--
-- Plain Lua 5.1-compatible syntax only. Nothing here yields between a check and its write.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")
local PolicyService = game:GetService("PolicyService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local GemService = {}
GemService.GemsPurchased = Util.Signal() -- Fire(player, gems, productId, purchaseId)
GemService.ProfileWaitSeconds = 12

-- Names that are not in Config (lead-owned): local constants, listed as deviations.
local RESTRICTED_ATTR = "PaidRandomItemsRestricted" -- player attribute: true = hide / refuse gem-priced roulettes
local PURCHASE_REMOTE = "BuyGems" -- (ref) connected only once Config.Remotes lists it
local TOKEN_SPIN_LOCK = "Token spins are not available on your account" -- lobby-shop 16.12: TokenSpinLock's "Restricted" text
local POLICY_CHECKING = "Checking your account, try again in a moment" -- the policy answer is still unknown (Quote's text too)

local PROMPT_COOLDOWN = 1 -- seconds between two purchase prompts of one player
local REMOTE_COOLDOWN = 0.5
local PROFILE_POLL = 0.5 -- ProcessReceipt: seconds between two looks at a loading profile
local MAX_GEMS_PER_PRODUCT = 10000000
local MAX_GEM_PRICE = 1000000000
local MAX_RECEIPT_KEY = 48 -- DataService keeps GemReceipts keys of 1..48 characters
local POLICY_RETRY = { 5, 15, 45, 120 } -- seconds before the retries of a failed policy lookup...
local POLICY_RETRY_LATER = 300 -- ...then every this many seconds
local POLICY_TICK = 2 -- the retry loop looks for due lookups this often
local POLICY_KICK_GAP = 5 -- an on-demand lookup (a refused gem roll) at most this often per player
local THANKS_SECONDS = 5

local initialized = false
local dataRef = nil
local petRef = nil
local storeRef = nil -- StoreService (Init deps): the grant path of a Store item, Thank, Purchased
local catalogRef = nil
local catalogTried = false
local storeCatalogRef = nil -- shared/StoreCatalog: ProductById over the gem packs and Config.Store.Items

local policy = {} -- [Player] = { State = "Checking"|"Allowed"|"Restricted", Busy, Fails, NextTry, LastTry }
local pendingThanks = {} -- [Player] = { [receiptKey] = { Item, Granted, ProductId, Done } } granted here, not saved yet
local promptAt = {} -- [Player] = os.clock() of the last purchase prompt
local lastCall = {} -- [Player] = { [key] = os.clock() }
local warned = {} -- [key] = true: one warning per problem per server

----------------------------------------------------------------------
-- Collaborators (every use is guarded: other engineers write them)
----------------------------------------------------------------------

local function requireIn(container, name)
	local module = container and container:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[GemService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local function getData()
	if not dataRef then
		dataRef = requireIn(script.Parent, "DataService")
	end
	return dataRef
end

local function getCatalog()
	if not catalogTried then
		catalogTried = true
		catalogRef = requireIn(Shared, "PetCatalog")
	end
	return catalogRef
end

local function getStoreCatalog()
	if not storeCatalogRef then
		storeCatalogRef = requireIn(Shared, "StoreCatalog")
	end
	return storeCatalogRef
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function wholeNumber(n)
	if not isFinite(n) or n ~= math.floor(n) then
		return nil
	end
	return n
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function warnOnce(key, text)
	if warned[key] then
		return
	end
	warned[key] = true
	warn(text)
end

local function rateLimited(player, key, interval)
	local record = lastCall[player]
	if not record then
		record = {}
		lastCall[player] = record
	end
	local now = os.clock()
	local last = record[key]
	if last and now - last < interval then
		return true
	end
	record[key] = now
	return false
end

local function notify(player, text, kind, duration)
	local ok, remote = pcall(Remotes.Get, "Notify")
	if ok and remote and player and player.Parent then
		remote:FireClient(player, text, kind or "info", duration or 3)
	end
end

local function gemConfig()
	if type(Config.Gems) == "table" then
		return Config.Gems
	end
	return {}
end

----------------------------------------------------------------------
-- Developer products
----------------------------------------------------------------------

-- Every well-formed entry of Config.Gems.Products (read each time: the list is tiny and tests may change it).
local function readProducts()
	local out = {}
	local list = gemConfig().Products
	if type(list) ~= "table" then
		return out
	end
	for index, entry in ipairs(list) do
		if type(entry) == "table" then
			local id = wholeNumber(entry.Id)
			local amount = wholeNumber(entry.Gems)
			if id and id >= 0 and amount and amount >= 1 and amount <= MAX_GEMS_PER_PRODUCT then
				local name = entry.Name
				if type(name) ~= "string" or name == "" then
					name = Util.Commas(amount) .. " Gems"
				end
				out[#out + 1] = { Index = index, ProductId = id, Gems = amount, Name = name, Created = id > 0 }
			end
		end
	end
	return out
end

local function copyProduct(p)
	return { Index = p.Index, ProductId = p.ProductId, Gems = p.Gems, Name = p.Name, Created = p.Created }
end

-- The Store item (a gem pack or a Config.Store.Items product) with that developer product id: StoreCatalog's
-- ProductById (a disabled entry still resolves: a paid receipt is never eaten). { Key, Kind, Id, Grants, Gem?, Once? }
local function productById(productId)
	local sc = getStoreCatalog()
	if not sc or type(sc.ProductById) ~= "function" then
		return nil
	end
	return sc.ProductById(productId)
end

-- ref = an index into Config.Gems.Products (1..n) or a created product's id.
local function productByRef(ref)
	local n = wholeNumber(ref)
	if not n or n < 1 then
		return nil
	end
	local list = readProducts()
	for _, p in ipairs(list) do
		if p.Index == n then
			return p
		end
	end
	for _, p in ipairs(list) do
		if p.Created and p.ProductId == n then
			return p
		end
	end
	return nil
end

function GemService.GetProducts()
	local out = {}
	for _, p in ipairs(readProducts()) do
		if p.Created then
			out[#out + 1] = { Index = p.Index, ProductId = p.ProductId, Gems = p.Gems, Name = p.Name }
		end
	end
	return out
end

function GemService.GetProduct(ref)
	local p = productByRef(ref)
	if p then
		return copyProduct(p)
	end
	return nil
end

----------------------------------------------------------------------
-- PolicyService: paid random items
----------------------------------------------------------------------

local function publishPolicy(player, entry)
	if player.Parent ~= Players then
		return
	end
	local restricted = entry.State ~= "Allowed"
	if player:GetAttribute(RESTRICTED_ATTR) ~= restricted then
		player:SetAttribute(RESTRICTED_ATTR, restricted)
	end
end

-- The engine's lookup function, or nil where the API is missing (it never is on Roblox; offline test doubles).
local function policyApi()
	local ok, fn = pcall(function()
		return PolicyService.GetPolicyInfoForPlayerAsync
	end)
	if ok and type(fn) == "function" then
		return fn
	end
	return nil
end

-- One lookup (yields inside the PolicyService call). A failure keeps a known answer and schedules a retry.
local function lookupPolicy(player)
	local entry = policy[player]
	if not entry or entry.Busy then
		return
	end
	local fn = policyApi()
	if not fn then
		return -- no API (offline test doubles): stays "Checking", i.e. restricted
	end
	entry.Busy = true
	entry.LastTry = os.clock()
	local ok, info = pcall(fn, PolicyService, player)
	entry.Busy = false
	if policy[player] ~= entry or player.Parent ~= Players then
		return
	end
	if ok and type(info) == "table" then
		local flag = info.ArePaidRandomItemsRestricted
		if flag == false then
			entry.State = "Allowed"
		else
			entry.State = "Restricted" -- true, or an answer without the field: the careful side
			if flag ~= true then
				warnOnce("policy-shape", "[GemService] PolicyService answered without ArePaidRandomItemsRestricted: gem roulettes stay locked")
			end
		end
		entry.Fails = 0
		entry.NextTry = nil
	else
		entry.Fails = entry.Fails + 1
		entry.NextTry = os.clock() + (POLICY_RETRY[entry.Fails] or POLICY_RETRY_LATER)
		warnOnce("policy-fail", "[GemService] PolicyService lookup failed (" .. tostring(info) .. "): gem roulettes stay locked for that player until a retry succeeds")
	end
	publishPolicy(player, entry)
end

local function startPolicy(player)
	local entry = policy[player]
	if entry then
		return entry
	end
	entry = { State = "Checking", Busy = false, Fails = 0, NextTry = nil, LastTry = nil }
	policy[player] = entry
	publishPolicy(player, entry)
	task.spawn(lookupPolicy, player)
	return entry
end

-- A refused gem roll while the answer is unknown asks again now (not before POLICY_KICK_GAP since the last try).
local function kickPolicy(player)
	local entry = policy[player]
	if not entry or entry.Busy or entry.State ~= "Checking" then
		return
	end
	if entry.LastTry and os.clock() - entry.LastTry < POLICY_KICK_GAP then
		return
	end
	entry.NextTry = nil
	task.spawn(lookupPolicy, player)
end

-- One loop for every retry (no thread per player, nothing left behind when players leave).
local function policyLoop()
	while true do
		task.wait(POLICY_TICK)
		local now = os.clock()
		local due = {}
		for player, entry in pairs(policy) do
			if not entry.Busy and entry.NextTry and now >= entry.NextTry then
				due[#due + 1] = player
			end
		end
		for _, player in ipairs(due) do
			local entry = policy[player]
			if entry and player.Parent == Players then
				entry.NextTry = nil
				task.spawn(lookupPolicy, player)
			end
		end
	end
end

function GemService.PolicyState(player)
	if not isPlayer(player) then
		return "Checking"
	end
	return startPolicy(player).State
end

function GemService.IsRestricted(player)
	return GemService.PolicyState(player) ~= "Allowed"
end

-- lobby-shop 16.13 review fix 2: asks PolicyService again while this player's answer is still unknown ("Checking"); a
-- known answer is left alone. kickPolicy's own gap (POLICY_KICK_GAP, 5 s per player) and Busy flag bound it, so callers
-- (the tutorial's open "Your First Pet" step at 2 Hz, the Shop's prompts) may call it freely. Never yields. -> the state
function GemService.Recheck(player)
	if not isPlayer(player) then
		return "Checking"
	end
	local entry = startPolicy(player)
	if entry.State == "Checking" then
		kickPolicy(player)
	end
	return entry.State
end

----------------------------------------------------------------------
-- Gem roulettes: definitions, odds, rolls
----------------------------------------------------------------------

local function tokenRoulette(rouletteId)
	for _, r in ipairs(Config.Roulettes) do
		if r.Id == rouletteId then
			return r
		end
	end
	return nil
end

-- Roulettes that exist only for Gems (today: the Secret roulette at the Storm Altar).
local function gemsOnlySources()
	local out = {}
	local secret = gemConfig().SecretRoulette
	if type(secret) == "table" and type(secret.Id) == "string" and secret.Id ~= "" then
		out[1] = secret
	end
	return out
end

local function gemsOnlySource(rouletteId)
	if tokenRoulette(rouletteId) then
		return nil -- a token roulette id always means the token roulette
	end
	for _, src in ipairs(gemsOnlySources()) do
		if src.Id == rouletteId then
			return src
		end
	end
	return nil
end

local function validPrice(n)
	n = wholeNumber(n)
	if n and n >= 1 and n <= MAX_GEM_PRICE then
		return n
	end
	return nil
end

local function makeDef(src, price, gemsOnly)
	local odds = {}
	if type(src.Odds) == "table" then
		for rarity, weight in pairs(src.Odds) do
			odds[rarity] = weight
		end
	end
	return {
		Id = src.Id,
		DisplayName = (type(src.DisplayName) == "string" and src.DisplayName ~= "") and src.DisplayName or src.Id,
		GemPrice = price,
		Color = src.Color,
		AllowSecret = src.AllowSecret == true,
		GemsOnly = gemsOnly,
		Odds = odds,
	}
end

function GemService.GetRoulette(rouletteId)
	if type(rouletteId) ~= "string" then
		return nil
	end
	local token = tokenRoulette(rouletteId)
	if token then
		local prices = gemConfig().RouletteGemPrices
		local price = type(prices) == "table" and validPrice(prices[rouletteId]) or nil
		if not price then
			return nil
		end
		return makeDef(token, price, false)
	end
	local src = gemsOnlySource(rouletteId)
	if src then
		local price = validPrice(src.GemPrice)
		if not price then
			return nil
		end
		return makeDef(src, price, true)
	end
	return nil
end

function GemService.ListRoulettes()
	local out = {}
	for _, r in ipairs(Config.Roulettes) do
		local def = GemService.GetRoulette(r.Id)
		if def then
			out[#out + 1] = def
		end
	end
	for _, src in ipairs(gemsOnlySources()) do
		local def = GemService.GetRoulette(src.Id)
		if def then
			out[#out + 1] = def
		end
	end
	return out
end

function GemService.RoulettePrice(rouletteId)
	local def = GemService.GetRoulette(rouletteId)
	return def and def.GemPrice or nil
end

-- Calls PetCatalog[fnName](rouletteId); returns the table or {}. lobby-shop (spec 5.1): PetCatalog is the one odds
-- source for every roulette, the gems-only Secret Roulette included (its findRoulette knows Config.Gems.SecretRoulette).
local function fromCatalog(fnName, rouletteId)
	if type(rouletteId) ~= "string" then
		return {}
	end
	local catalog = getCatalog()
	if not catalog or type(catalog[fnName]) ~= "function" then
		return {}
	end
	local ok, result = pcall(catalog[fnName], rouletteId)
	if ok and type(result) == "table" then
		return result
	end
	return {}
end

-- rng: anything with :Float(a, b) and :Int(a, b) (Util.NewRng); math.random without one. Every roulette rolls through
-- PetCatalog.RollPet. opts.ForceRarity (the Secret pity, spec 5.2; server code only, never a remote value): the
-- rarity draw still happens and is thrown away, then the pet comes from PetCatalog.RollFromRarity(id, ForceRarity, rng),
-- so the rng ends where an unforced roll leaves it. nil when that rarity is not one of the roulette's rows.
function GemService.RollPet(rouletteId, rng, opts)
	if type(rouletteId) ~= "string" then
		return nil
	end
	local catalog = getCatalog()
	if not catalog or type(catalog.RollPet) ~= "function" then
		return nil
	end
	local force = type(opts) == "table" and opts.ForceRarity or nil
	if force == nil then
		return catalog.RollPet(rouletteId, rng)
	end
	if type(force) ~= "string" or type(catalog.RollFromRarity) ~= "function" then
		return nil
	end
	if type(rng) == "table" and type(rng.Float) == "function" then
		rng:Float(0, 1)
	else
		math.random()
	end
	return catalog.RollFromRarity(rouletteId, force, rng)
end

-- Exact per-pet chances (PetCatalog.GetOdds): the rarity's share split evenly between its pets (what RollPet does).
function GemService.GetOdds(rouletteId)
	return fromCatalog("GetOdds", rouletteId)
end

function GemService.GetRarityOdds(rouletteId)
	return fromCatalog("GetRarityOdds", rouletteId)
end

function GemService.PossiblePets(rouletteId)
	return fromCatalog("PossiblePets", rouletteId)
end

-- The price and roll of a gem-paid spin, after the policy check. Never yields (PetService calls it right before its
-- atomic charge + grant). ok, quote | reason.
function GemService.Quote(player, rouletteId)
	local def = GemService.GetRoulette(rouletteId)
	if not def then
		return false, "That roulette cannot be paid with Gems"
	end
	local state = GemService.PolicyState(player)
	if state == "Restricted" then
		return false, "Gem roulettes are not available on your account"
	elseif state ~= "Allowed" then
		kickPolicy(player)
		return false, POLICY_CHECKING
	end
	-- odds are always shown: a roulette whose odds cannot be listed is not sold
	if #GemService.GetOdds(def.Id) == 0 then
		return false, "That roulette is unavailable right now"
	end
	return true, {
		RouletteId = def.Id,
		DisplayName = def.DisplayName,
		Price = def.GemPrice,
		AllowSecret = def.AllowSecret,
		GemsOnly = def.GemsOnly,
		Roll = def.GemsOnly and GemService.RollPet or nil,
	}
end

-- Extra: a gem-paid spin through PetService (the same path as the BuyRoulette remote with "Gems").
function GemService.Roll(player, rouletteId)
	local pets = petRef or requireIn(script.Parent, "PetService")
	if not pets or type(pets.BuyRoulette) ~= "function" then
		return false, "Pets are unavailable right now"
	end
	return pets.BuyRoulette(player, rouletteId, "Gems")
end

-- lobby-shop 16.12 (the owner's pick A, 2026-11-08): why a token-paid roulette spin is refused for this account, or nil.
-- The token packs' Robux prompt is never opened by the server for an account that is not "Allowed" (StoreService's
-- tokenLock), but a client can open it itself and a paid receipt is always granted, so the spin is the lock: only
-- PolicyState "Allowed" spins with tokens; "Restricted" gets TOKEN_SPIN_LOCK; anything else is still unknown (fail closed,
-- the token lock's rule) and asks PolicyService again (kickPolicy). Never yields; no saved field.
-- Release step 1 (the owner's pick, 2026-11-23): only while the Store is on (StoreCatalog.Enabled()). With the Store off
-- nothing sells Tokens, so there is no lock: nil for every account, whatever PolicyService said or failed to say.
function GemService.TokenSpinLock(player)
	local catalog = getStoreCatalog()
	if not (catalog and type(catalog.Enabled) == "function" and catalog.Enabled() == true) then
		return nil
	end
	local state = GemService.PolicyState(player)
	if state == "Allowed" then
		return nil
	elseif state == "Restricted" then
		return TOKEN_SPIN_LOCK
	end
	kickPolicy(player)
	return POLICY_CHECKING
end

-- What the Storm Altar's prompt does for this player: open the Secret roulette, explain the restriction, or (gem
-- system still checking the account / roulette missing) show the "awakens soon" toast.
function GemService.SecretRouletteState(player)
	local src = gemsOnlySources()[1]
	if not src or not GemService.GetRoulette(src.Id) or #GemService.GetOdds(src.Id) == 0 then
		return "Unavailable"
	end
	local state = GemService.PolicyState(player)
	if state == "Allowed" then
		return "Open"
	elseif state == "Restricted" then
		return "Restricted"
	end
	kickPolicy(player)
	return "Checking"
end

----------------------------------------------------------------------
-- Purchases
----------------------------------------------------------------------

function GemService.PromptPurchase(player, ref)
	if not isPlayer(player) then
		return false, "Player unavailable"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "The shop is closed during a match"
	end
	local product = productByRef(ref)
	if not product then
		return false, "Unknown gem pack"
	end
	if not product.Created then
		return false, "That gem pack is not on sale yet"
	end
	local now = os.clock()
	local last = promptAt[player]
	if last and now - last < PROMPT_COOLDOWN then
		return false, "Please wait a moment"
	end
	promptAt[player] = now
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, product.ProductId)
	end)
	if not ok then
		warnOnce("prompt", "[GemService] PromptProductPurchase failed: " .. tostring(err))
		return false, "The purchase window could not open"
	end
	return true
end

-- The key GemReceipts stores for a purchase id (DataService keeps keys of 1..48 characters; a longer id becomes a
-- stable short form: its first characters plus two hashes of the whole id).
local function hashOf(s, mult, modulus)
	local h = 0
	for i = 1, #s do
		h = (h * mult + string.byte(s, i)) % modulus
	end
	return h
end

local function receiptKey(purchaseId)
	if isFinite(purchaseId) then
		purchaseId = string.format("%.0f", purchaseId)
	end
	if type(purchaseId) ~= "string" or purchaseId == "" then
		return nil
	end
	if #purchaseId <= MAX_RECEIPT_KEY then
		return purchaseId
	end
	return string.sub(purchaseId, 1, 28) .. "#" .. string.format("%08x%08x", hashOf(purchaseId, 31, 2147483647), hashOf(purchaseId, 131, 2147483629))
end

-- Takes a receipt back out of the live profile (only when the gems could not be added in the same step).
local function unmarkReceipt(data, player, key)
	local profile = type(data.GetProfile) == "function" and data.GetProfile(player) or nil
	local receipts = type(profile) == "table" and profile.GemReceipts or nil
	if type(receipts) == "table" then
		receipts[key] = nil
	end
end

-- A purchase granted here waits for its save before the player is thanked (the grant may still be answered
-- NotProcessedYet). Returns the record the granting call keeps (a retry looks it up by the receipt key).
local function holdThanks(player, key, item, granted, productId)
	local map = pendingThanks[player]
	if not map then
		map = {}
		pendingThanks[player] = map
	end
	local rec = { Item = item, Granted = granted, ProductId = productId, Done = false }
	map[key] = rec
	return rec
end

-- The purchase is granted for good: the thank-you toast, GemsPurchased (gem packs) and StoreService.Purchased, once
-- per purchase. `rec` = the record of the call that granted it (nil for a retry, which finds it in pendingThanks;
-- nothing when it was thanked already).
local function sendThanks(player, key, rec)
	local map = pendingThanks[player]
	if map then
		rec = rec or map[key]
		map[key] = nil
		if next(map) == nil then
			pendingThanks[player] = nil
		end
	end
	if type(rec) ~= "table" or rec.Done then
		return
	end
	rec.Done = true
	local item, granted = rec.Item, rec.Granted
	if type(item) == "table" and item.Gem then
		local gems = type(granted) == "table" and granted.Gems or 0
		notify(player, "+" .. Util.Commas(gems) .. " Gems! Thank you for your support!", "good", THANKS_SECONDS)
		GemService.GemsPurchased:Fire(player, gems, rec.ProductId, key)
		if storeRef and type(storeRef.Purchased) == "table" and type(storeRef.Purchased.Fire) == "function" then
			storeRef.Purchased:Fire(player, item.Key, granted, key)
		end
	elseif storeRef and type(storeRef.Thank) == "function" then
		storeRef.Thank(player, item, granted, key)
	end
end

-- The record DataService keeps with the receipt (the twin rule of the merge): the grant table shape without the
-- Substitute annotation (its Tokens are already counted in Tokens).
local function recordOf(granted)
	if type(granted) ~= "table" then
		return nil
	end
	local out = {}
	for k, v in pairs(granted) do
		if k ~= "Substitute" then
			out[k] = v
		end
	end
	return out
end

function GemService.ProcessReceipt(receiptInfo)
	local NOT_YET = Enum.ProductPurchaseDecision.NotProcessedYet
	local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
	if type(receiptInfo) ~= "table" then
		return NOT_YET
	end
	local userId = wholeNumber(receiptInfo.PlayerId)
	local productId = wholeNumber(receiptInfo.ProductId)
	local key = receiptKey(receiptInfo.PurchaseId)
	if not userId or not productId or not key then
		warnOnce("receipt-shape", "[GemService] a malformed receipt was not granted (Roblox keeps it pending)")
		return NOT_YET
	end
	local item = productById(productId)
	if not item or type(item.Grants) ~= "table" then
		warnOnce("product-" .. tostring(productId), "[GemService] receipt for developer product " .. tostring(productId)
			.. ", which neither Config.Gems.Products nor Config.Store.Items lists: not granted (Roblox keeps it pending)")
		return NOT_YET
	end
	local data = getData()
	if not data or type(data.MarkReceipt) ~= "function" or type(data.AddGems) ~= "function" then
		warnOnce("receipt-data", "[GemService] DataService has no MarkReceipt / AddGems: purchases stay pending")
		return NOT_YET
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return NOT_YET -- not in this server: Roblox asks again when they join one
	end

	-- Was it granted before? Only a loaded, non-provisional profile can tell (MarkReceipt answers nil until then).
	-- The grant travels with the receipt: a purchase another server already saved is never added to the store twice.
	local spec = item.Gem and item.Grants.Gems or item.Grants
	local marked = data.MarkReceipt(player, key, spec)
	local waited = 0
	while marked == nil and player.Parent == Players and waited < GemService.ProfileWaitSeconds do
		task.wait(PROFILE_POLL)
		waited = waited + PROFILE_POLL
		marked = data.MarkReceipt(player, key, spec)
	end
	if marked == nil then
		return NOT_YET
	end
	local thanks = nil
	if marked == true then
		-- a new purchase: the grant goes in now, in the same step as the receipt (nothing yields in between)
		local granted
		if storeRef and type(storeRef.ApplyGrant) == "function" then
			local ok, result = storeRef.ApplyGrant(player, item, key)
			if not ok then
				unmarkReceipt(data, player, key)
				warnOnce("receipt-grant", "[GemService] could not grant a purchase (" .. tostring(result) .. "): it stays pending")
				return NOT_YET
			end
			granted = result
			if type(data.NoteReceiptGrant) == "function" then
				data.NoteReceiptGrant(player, key, recordOf(granted)) -- what was REALLY granted (substitutes)
			end
		elseif item.Gem then
			if not data.AddGems(player, item.Grants.Gems) then
				unmarkReceipt(data, player, key)
				warnOnce("receipt-grant", "[GemService] could not add the Gems of a purchase: it stays pending")
				return NOT_YET
			end
			granted = { Gems = item.Grants.Gems }
		else
			unmarkReceipt(data, player, key)
			warnOnce("receipt-store", "[GemService] StoreService is missing: Store items stay pending (gem packs are still granted)")
			return NOT_YET
		end
		thanks = holdThanks(player, key, item, granted, productId)
	end
	-- Durable before Roblox hears "done": the save carries the receipt and the gems together (a duplicate call saves
	-- too: an earlier save of this purchase may have failed). The player is thanked once it is granted for good.
	if type(data.Save) == "function" then
		local okSave, saved = pcall(data.Save, player)
		if okSave and saved == true then
			sendThanks(player, key, thanks)
			return GRANTED
		end
	end
	if RunService:IsStudio() then
		sendThanks(player, key, thanks)
		return GRANTED -- Studio test purchases cost nothing; the gems are in the session
	end
	return NOT_YET
end

-- The callback Roblox calls (a wrapper: an error answers NotProcessedYet instead of breaking the purchase queue).
local function receiptCallback(receiptInfo)
	local ok, result = pcall(GemService.ProcessReceipt, receiptInfo)
	if ok and result ~= nil then
		return result
	end
	if not ok then
		warn("[GemService] ProcessReceipt errored: " .. tostring(result))
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

----------------------------------------------------------------------
-- Init: config check, receipt callback, the optional purchase remote, players
----------------------------------------------------------------------

local function checkConfig()
	local gems = gemConfig()
	local list = type(gems.Products) == "table" and gems.Products or {}
	local valid = readProducts()
	if #valid ~= #list then
		warn("[GemService] " .. (#list - #valid) .. " entries of Config.Gems.Products are malformed (need Id >= 0, Gems >= 1)")
	end
	local seen, onSale = {}, 0
	for _, p in ipairs(valid) do
		if p.Created then
			onSale = onSale + 1
			if seen[p.ProductId] then
				warn("[GemService] developer product " .. p.ProductId .. " is listed twice in Config.Gems.Products (the first entry counts)")
			end
			seen[p.ProductId] = true
		end
	end
	if type(gems.RouletteGemPrices) == "table" then
		for id, price in pairs(gems.RouletteGemPrices) do
			if not tokenRoulette(id) then
				warn("[GemService] Config.Gems.RouletteGemPrices names an unknown roulette: " .. tostring(id))
			elseif not validPrice(price) then
				warn("[GemService] Config.Gems.RouletteGemPrices." .. tostring(id) .. " is not a whole number of Gems >= 1")
			end
		end
	end
	for _, src in ipairs(gemsOnlySources()) do
		if not validPrice(src.GemPrice) then
			warn("[GemService] " .. tostring(src.Id) .. " roulette: GemPrice must be a whole number of Gems >= 1")
		elseif #GemService.GetOdds(src.Id) == 0 then
			warn("[GemService] " .. tostring(src.Id) .. " roulette has no odds with pets in them: it is not sold")
		end
	end
	print(string.format("[GemService] %d of %d gem packs on sale%s", onSale, #list,
		onSale < #list and " (product id 0 = not created yet: paste the developer product ids into Config.Gems.Products)" or ""))
end

local function connectPurchaseRemote()
	local listed = false
	for _, name in ipairs(Config.Remotes) do
		if name == PURCHASE_REMOTE then
			listed = true
		end
	end
	if not listed then
		return
	end
	local ok, remote = pcall(Remotes.Get, PURCHASE_REMOTE)
	if not ok or not remote then
		return
	end
	remote.OnServerEvent:Connect(function(player, ref)
		if rateLimited(player, PURCHASE_REMOTE, REMOTE_COOLDOWN) then
			return
		end
		if type(ref) ~= "number" then
			return
		end
		local okCall, success, reason = pcall(GemService.PromptPurchase, player, ref)
		if not okCall then
			warn("[GemService] PromptPurchase errored: " .. tostring(success))
		elseif not success and reason then
			notify(player, tostring(reason), "bad", 3)
		end
	end)
end

local function onPlayerAdded(player)
	if isPlayer(player) then
		startPolicy(player)
	end
end

local function onPlayerRemoving(player)
	policy[player] = nil
	pendingThanks[player] = nil -- a save still in flight keeps its own record (sendThanks gets it passed)
	promptAt[player] = nil
	lastCall[player] = nil
end

function GemService.Init(deps)
	if type(deps) == "table" then
		if type(deps.DataService) == "table" then
			dataRef = deps.DataService
		end
		if type(deps.PetService) == "table" then
			petRef = deps.PetService -- PetService pulls prices / the policy from here; kept for later callers
		end
		if type(deps.StoreService) == "table" then
			storeRef = deps.StoreService
		end
	end
	if initialized then
		return
	end
	initialized = true
	getCatalog()
	if not getStoreCatalog() then
		warn("[GemService] shared/StoreCatalog is missing: no receipt can be looked up (purchases stay pending)")
	end
	local okCheck, errCheck = pcall(checkConfig)
	if not okCheck then
		warn("[GemService] config check failed: " .. tostring(errCheck))
	end
	local okSet, errSet = pcall(function()
		MarketplaceService.ProcessReceipt = receiptCallback
	end)
	if not okSet then
		warn("[GemService] could not set MarketplaceService.ProcessReceipt: " .. tostring(errSet))
	end
	connectPurchaseRemote()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	task.spawn(policyLoop)
end

return GemService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1097">
          <Properties>
            <string name="Name">HazardService</string>
            <string name="Source"><![CDATA[-- HazardService: brings the tagged parts of a sky course to life and applies damage through
-- DamageService. One Attach() call per match; the returned stopFn tears everything down.
-- Plain Lua 5.1-compatible syntax only.
--
-- Behaviours (see Config.Tags):
--   v1: SpinBar, StormCloud, LightningZone, VanishCloud, MovingCloud, BouncePad,
--       PressurePlate + PlateBridge
--   v2: Pendulum (swinging beam), WindGust (periodic sideways push), CloudCannon (ballistic launch)
-- Every parameter is read from attributes with a sane default, so a part with a missing attribute
-- still behaves.
--
-- Structure: Attach() builds a per-match "context" table. All per-frame work (spinning bars,
-- pendulums, moving clouds, wind streaks, storm / plate / wind ticks) runs from ONE shared Heartbeat
-- connection owned by that context. Timed sequences (lightning, wind gusts, vanishing clouds, cannon
-- charge-ups) run in their own task threads that check ctx.stopped after every wait. Everything
-- created at runtime lives inside the container, except the WindGust force constraints, which have
-- to sit on the players' characters and are removed again by stopFn / when the gust ends.
--
-- Visual rule: warning discs, bolts, rain and puffs use the calm palette below (Theme.World when it
-- exists). Nothing here is pure white or full-saturation neon, and lightning flashes are brief.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local FxSprites = require(Shared.FxSprites) -- kit-b O3: the game's own particle sprites (no stock sparkle / smoke)
local DamageService = require(script.Parent.DamageService)

-- Theme is only used for its in-world palette; a broken UI kit must never take the hazards down.
local themeOk, Theme = pcall(require, Shared.Theme)
if not themeOk or type(Theme) ~= "table" then
	Theme = {}
end

local HazardService = {}

local TAGS = Config.Tags
local TWO_PI = math.pi * 2

----------------------------------------------------------------------
-- Tunables (anything a designer might want to tweak lives here)
----------------------------------------------------------------------
local STORM_TICK = 0.25 -- seconds between storm damage ticks (4 Hz)
local PLATE_TICK = 0.2 -- seconds between pressure-plate polls (5 Hz)
local HIT_TICK = 0.08 -- backup overlap poll for moving damage bars (12 Hz)
local WIND_TICK = 1 / 15 -- how often wind forces are re-evaluated
local PLATE_RETRACT_DELAY = 1.0 -- bridge stays up this long after the last player leaves
local PLATE_FADE_IN = 0.2
local PLATE_FADE_OUT = 0.45
local PLATE_PRESS_DEPTH = 0.18 -- how far a plate sinks when stood on
local HITTER_DEBOUNCE = 0.35 -- per player, per bar (DamageService i-frames do the rest)
local HITTER_MARGIN = 0.3 -- studs the overlap poll grows a bar by
local HITTER_NEAR_MARGIN = 10 -- bars with no player this close (beyond their own radius) are not polled
local SPINBAR_KNOCKBACK = 55
local PENDULUM_KNOCKBACK = 55
local BOUNCE_DEBOUNCE = 0.3
local LIGHTNING_KNOCKBACK = 40
local BOLT_HEIGHT = 90
local BOLT_SEGMENTS = 8

-- WindGust
local WIND_BLOW_TIME = 1.5 -- default seconds the push lasts after the warning (optional Duration attribute)
local WIND_RAMP_IN = 0.3 -- push strength fades in over this long ...
local WIND_RAMP_OUT = 0.4 -- ... and out over this long
local WIND_MAX_FORCE = 40 -- hard cap on the Force attribute (studs/s)
local WIND_MAX_ACCEL = 480 -- studs/s^2; has to beat the Humanoid's ground controller to shove a standing player
local WIND_GAIN = 18 -- 1/s: acceleration = (ceiling - speed along wind) * gain, then clamped
local WIND_STREAKS = 10 -- pooled streak parts per gust volume
local WIND_WARN_STREAKS = 4 -- how many of them show during the warning

-- CloudCannon
local CANNON_CHARGE = 0.35 -- squash + puff before the launch
local CANNON_REARM = 1.0 -- a player cannot be launched twice within this many seconds
local CANNON_STAND_SLACK = 5 -- still counts as "on the pad" this far beyond its edge
local CANNON_LANDING_GRACE = 0.8 -- extra protection after FlightTime for the touchdown
local CANNON_MAX_SPEED = 260 -- sanity cap for a broken Target / FlightTime
local CANNON_DEFAULT_FLIGHT = 1.6
local CANNON_MAX_LATENCY = 0.3 -- seconds of lag the launch compensates for at most
local CANNON_STEER_POLL = 0.05 -- how often a steering lock checks for the touchdown (see lockSteering)

----------------------------------------------------------------------
-- Palette: calm, readable colours (Theme.World when present, local fallbacks otherwise)
----------------------------------------------------------------------
local WORLD = Theme.World or {}

local function colorOr(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	return fallback
end

-- Pulls a colour away from full saturation / full brightness (hazard glows must stay calm).
local function calm(color)
	local ok, h, s, v = pcall(function()
		return color:ToHSV()
	end)
	if not ok then
		return color
	end
	return Color3.fromHSV(h, math.min(s, 0.72), math.min(v, 0.86))
end

local PAL = {}
PAL.Warn = calm(colorOr(WORLD.HazardGlow, Color3.fromRGB(204, 84, 100)))
PAL.WarnFill = PAL.Warn:Lerp(Color3.fromRGB(236, 170, 160), 0.3)
PAL.BoltCore = Color3.fromRGB(210, 222, 244) -- soft blue-white, never pure white
PAL.BoltGlow = Color3.fromRGB(118, 110, 204)
PAL.RainTop = Color3.fromRGB(225, 235, 255) -- near-white: the Droplet sheet's own blue shows through
PAL.RainBottom = Color3.fromRGB(200, 220, 250)
PAL.StormMist = Color3.fromRGB(200, 208, 226) -- tints the neutral-grey fx_stormcloud sheet to a slate storm grey
PAL.StormMistDeep = Color3.fromRGB(150, 160, 190)
PAL.Sparkle = Color3.fromRGB(228, 214, 164)
PAL.PuffLight = Color3.fromRGB(206, 218, 238)
PAL.PuffDark = Color3.fromRGB(150, 168, 200)
PAL.Wind = Color3.fromRGB(190, 208, 232)
PAL.WindDrift = Color3.fromRGB(170, 190, 220)
PAL.PlateGlow = Color3.fromRGB(220, 228, 244)

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local warned = {}

-- Run fn(...) in a pcall; the first failure per name is reported, never spammed per frame.
local function guarded(name, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not warned[name] then
		warned[name] = true
		warn("[HazardService] " .. name .. " failed: " .. tostring(err))
	end
end

local function attrNumber(inst, name, default)
	local value = inst:GetAttribute(name)
	if type(value) == "number" and value == value then
		return value
	end
	return default
end

local function attrVector3(inst, name, default)
	local value = inst:GetAttribute(name)
	if typeof(value) == "Vector3" then
		return value
	end
	return default
end

local function attrString(inst, name, default)
	local value = inst:GetAttribute(name)
	if value == nil then
		return default
	end
	return tostring(value)
end

-- Horizontal unit vector of `v` (Y dropped), or `fallback` when v is (nearly) vertical / nil.
local function flatUnit(v, fallback)
	if typeof(v) == "Vector3" then
		local flat = Vector3.new(v.X, 0, v.Z)
		if flat.Magnitude > 0.01 then
			return flat.Unit
		end
	end
	return fallback
end

-- Create an anchored, non-interactive effect part. Parent is applied last.
local function makePart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Material = Enum.Material.Neon
	local parent = nil
	for key, value in pairs(props) do
		if key == "Parent" then
			parent = value
		else
			part[key] = value
		end
	end
	part.Parent = parent
	return part
end

-- props.Sprite = the FxSprites role of its texture (Sparkle when left out); the other props are set as given.
local function newEmitter(props)
	local emitter = Instance.new("ParticleEmitter")
	FxSprites.Apply(emitter, props.Sprite or "Sparkle")
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	for key, value in pairs(props) do
		if key ~= "Sprite" then
			emitter[key] = value
		end
	end
	return emitter
end

-- Soft smoke puff emitter (cannon poof, wind drift). Rate 0: fire it with :Emit() or set Rate.
local function newPuffEmitter(props)
	local emitter = newEmitter({
		Sprite = "Puff",
		Rate = 0,
		Color = ColorSequence.new(PAL.PuffLight, PAL.PuffDark),
		LightEmission = 0.05,
		LightInfluence = 0.8,
		Lifetime = NumberRange.new(0.5, 0.9),
		Speed = NumberRange.new(8, 16),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(50, 50),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-80, 80),
		Drag = 2,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1.2),
			NumberSequenceKeypoint.new(1, 4.5),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.6, 0.65),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	if props then
		for key, value in pairs(props) do
			emitter[key] = value
		end
	end
	return emitter
end

-- Root part + humanoid of a player that is currently alive, or nil.
local function getLivingRoot(player)
	local char = player and player.Character
	if not char then
		return nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return root, humanoid
	end
	return nil
end

-- Touched part -> (player, root) for a living player character, else nil.
local function playerFromHit(hit)
	local player = Util.PlayerFromPart(hit)
	if not player then
		return nil
	end
	local root = getLivingRoot(player)
	if not root then
		return nil
	end
	return player, root
end

local function isDowned(player)
	return player:GetAttribute(Config.Attr.Downed) == true
end

-- Axis-aligned world-space extents (full sizes) of a possibly rotated part.
local function worldExtents(part)
	local cf = part.CFrame
	local s = part.Size
	local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
	return Vector3.new(
		math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z,
		math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z,
		math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z
	)
end

-- Half-extent of the part's (oriented) box measured along the world unit vector `dir`.
local function halfExtentAlong(part, dir)
	local cf = part.CFrame
	local s = part.Size
	return 0.5 * (math.abs(dir:Dot(cf.RightVector)) * s.X
		+ math.abs(dir:Dot(cf.UpVector)) * s.Y
		+ math.abs(dir:Dot(cf.LookVector)) * s.Z)
end

-- A "fade set" is a part plus every BasePart (and particle emitter) parented under it, with the
-- original look remembered so it can be faded out and restored exactly.
local function collectFadeSet(root)
	local set = { parts = {}, emitters = {} }
	local function addPart(part, isRoot)
		local transparency = part.Transparency
		local canCollide = part.CanCollide
		if isRoot then
			canCollide = true -- the tagged walkable part is always solid when shown
			if transparency > 0.95 then
				transparency = 0 -- authored invisible: show it as a solid cloud instead
			end
		end
		table.insert(set.parts, { part = part, transparency = transparency, canCollide = canCollide })
	end
	addPart(root, true)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			if not CollectionService:HasTag(d, TAGS.CloudToken) then
				addPart(d, false)
			end
		elseif d:IsA("ParticleEmitter") then
			table.insert(set.emitters, { emitter = d, enabled = d.Enabled })
		end
	end
	return set
end

-- factor 0 = original look, 1 = invisible. seconds 0 = instant.
local function fadeSet(set, factor, seconds)
	for _, e in ipairs(set.parts) do
		local goal = e.transparency + (1 - e.transparency) * factor
		if seconds > 0 then
			Util.Tween(e.part, seconds, { Transparency = goal }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		else
			e.part.Transparency = goal
		end
	end
	for _, e in ipairs(set.emitters) do
		if factor >= 1 then
			e.emitter.Enabled = false
		else
			e.emitter.Enabled = e.enabled
		end
	end
end

local function collideSet(set, solid)
	for _, e in ipairs(set.parts) do
		if solid then
			e.part.CanCollide = e.canCollide
		else
			e.part.CanCollide = false
		end
	end
end

----------------------------------------------------------------------
-- Context helpers (one context per Attach call)
----------------------------------------------------------------------
local function newContext(container, matchHandle)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Include
	overlap.MaxParts = 128
	return {
		container = container,
		matchHandle = matchHandle,
		stopped = false,
		clock = 0, -- animation clock: advances only while the match is active
		rng = Random.new(),
		overlap = overlap,
		heartbeat = nil,
		connections = {}, -- RBXScriptConnections to disconnect on stop
		cleanups = {}, -- functions to run on stop
		permanents = {}, -- instances HazardService added for the whole match (destroyed on stop)
		temps = {}, -- short-lived effect parts: part -> true
		spinBars = {},
		pendulums = {},
		hitters = {}, -- every moving damage bar (spin bars + pendulums), for the overlap backup poll
		movers = {},
		moversMoving = false,
		storms = {},
		winds = {},
		launchedAt = {}, -- player -> os.clock() of their last cannon launch
		groups = {}, -- BridgeId -> group
		groupList = {},
		stormAcc = 0,
		plateAcc = 0,
		hitAcc = 0,
		windAcc = 0,
	}
end

-- True while hazards should run. A missing/broken matchHandle never freezes the course.
local function isActive(ctx)
	local handle = ctx.matchHandle
	if handle and type(handle.IsActive) == "function" then
		local ok, result = pcall(handle.IsActive)
		if ok then
			return result and true or false
		end
	end
	return true
end

local function connect(ctx, signal, fn)
	local conn = signal:Connect(fn)
	table.insert(ctx.connections, conn)
	return conn
end

local function onStop(ctx, fn)
	table.insert(ctx.cleanups, fn)
end

-- Parent a transient effect part under the container and auto-destroy it after `lifetime`.
local function addTemp(ctx, part, lifetime)
	if ctx.stopped then
		part:Destroy()
		return part
	end
	part.Parent = ctx.container
	ctx.temps[part] = true
	task.delay(lifetime, function()
		ctx.temps[part] = nil
		part:Destroy()
	end)
	return part
end

local function removeTemp(ctx, part)
	ctx.temps[part] = nil
	part:Destroy()
end

-- Apply damage through DamageService (only while active). Returns true if damage landed.
local function hurt(ctx, player, amount, kind, opts)
	if ctx.stopped or not isActive(ctx) then
		return false
	end
	if not player or player.Parent == nil or isDowned(player) then
		return false
	end
	local ok, applied = pcall(DamageService.Damage, player, amount, kind, opts)
	if not ok then
		if not warned.Damage then
			warned.Damage = true
			warn("[HazardService] DamageService.Damage failed: " .. tostring(applied))
		end
		return false
	end
	return applied == true
end

-- All living players with any body part overlapping the (possibly rotated) box.
local function playersInBox(ctx, cf, size)
	local found = {}
	local characters = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(characters, player.Character)
		end
	end
	if #characters == 0 then
		return found
	end
	ctx.overlap.FilterDescendantsInstances = characters
	local parts = Workspace:GetPartBoundsInBox(cf, size, ctx.overlap)
	local seen = {}
	for _, part in ipairs(parts) do
		local player = Util.PlayerFromPart(part)
		if player and not seen[player] then
			seen[player] = true
			if getLivingRoot(player) then
				table.insert(found, player)
			end
		end
	end
	return found
end

-- Wait `seconds` of ACTIVE time (the timer holds while the match is paused).
-- Returns false if the context was stopped meanwhile.
local function waitActive(ctx, seconds)
	local waited = 0
	while waited < seconds do
		if ctx.stopped then
			return false
		end
		local step = math.min(0.1, seconds - waited)
		local dt = task.wait(step)
		if ctx.stopped then
			return false
		end
		if isActive(ctx) then
			waited = waited + (dt or step)
		end
	end
	return not ctx.stopped
end

-- Block until the match is active. Returns false if stopped.
local function awaitActive(ctx)
	while not ctx.stopped and not isActive(ctx) do
		task.wait(0.1)
	end
	return not ctx.stopped
end

-- Wait `seconds` of real time. Returns false if stopped.
local function sleep(ctx, seconds)
	local waited = 0
	while waited < seconds do
		if ctx.stopped then
			return false
		end
		local step = math.min(0.1, seconds - waited)
		local dt = task.wait(step)
		waited = waited + (dt or step)
	end
	return not ctx.stopped
end

----------------------------------------------------------------------
-- Moving damage bars (SpinBar + Pendulum share one hit routine)
--   A hit comes from the part's Touched signal OR from the 12 Hz overlap poll below: an anchored
--   part that is swept through a character by CFrame occasionally misses a Touched event.
----------------------------------------------------------------------
local function registerHit(ctx, hitter, player)
	if ctx.stopped or not isActive(ctx) then
		return
	end
	local now = os.clock()
	local last = hitter.lastHit[player]
	if last and now - last < HITTER_DEBOUNCE then
		return
	end
	hitter.lastHit[player] = now
	hurt(ctx, player, hitter.damage, hitter.kind, {
		KnockbackFrom = hitter.part.Position,
		Knockback = hitter.knockback,
	})
end

local function pollHitters(ctx)
	-- Cheap early-out: collect the living roots once, then only run the (relatively expensive) box
	-- query for bars that have a player within reach.
	local roots = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getLivingRoot(player)
		if root then
			table.insert(roots, root.Position)
		end
	end
	if #roots == 0 then
		return
	end
	for _, hitter in ipairs(ctx.hitters) do
		local part = hitter.part
		if part.Parent then
			local reach = part.Size.Magnitude / 2 + HITTER_NEAR_MARGIN
			local reach2 = reach * reach
			local near = false
			local centre = part.Position
			for _, position in ipairs(roots) do
				local d = position - centre
				if d:Dot(d) <= reach2 then
					near = true
					break
				end
			end
			if near then
				local size = part.Size + Vector3.new(HITTER_MARGIN, HITTER_MARGIN, HITTER_MARGIN)
				for _, player in ipairs(playersInBox(ctx, part.CFrame, size)) do
					registerHit(ctx, hitter, player)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Per-frame / per-tick work (all driven by the one shared Heartbeat)
----------------------------------------------------------------------
local function updateSpinBars(ctx)
	local t = ctx.clock
	for _, bar in ipairs(ctx.spinBars) do
		local part = bar.part
		if part.Parent then
			-- Always derived from the base CFrame so rotation never accumulates error.
			part.CFrame = bar.base * CFrame.Angles(0, bar.phase + bar.speed * t, 0)
		end
	end
end

-- Pendulum swing: the beam (and anything anchored under it) is rotated about the world pivot
-- `Hinge` around the world axis `Axis`, always from the remembered base CFrame.
local function updatePendulums(ctx)
	local t = ctx.clock
	for _, p in ipairs(ctx.pendulums) do
		local part = p.part
		if part.Parent then
			local angle = p.arc * math.sin(TWO_PI * t / p.period + p.phase)
			local transform = p.pivot * CFrame.fromAxisAngle(p.axis, angle) * p.pivotInverse
			part.CFrame = transform * p.base
			for _, f in ipairs(p.followers) do
				if f.part.Parent then
					f.part.CFrame = transform * f.base
				end
			end
		end
	end
end

-- MovingCloud motion.
--
-- How standing players are carried: an Anchored part moved by CFrame has no physics velocity, so
-- Humanoids standing on it would simply be left behind. Pushing the player's HumanoidRootPart
-- from the SERVER every frame is not an option either: the character is simulated by its owning
-- client, so the server would keep writing a stale (latency-old) position back and the player
-- would rubber-band whenever they walk. Instead each frame we do two things to the anchored
-- cloud: (1) move it along its sine path with CFrame, and (2) publish the exact analytic
-- velocity of that path in AssemblyLinearVelocity. An anchored part's velocity is treated by the
-- engine as a moving surface (the same trick conveyor belts use), so Humanoids standing on the
-- cloud are carried along smoothly by their own client physics, with no teleporting involved.
-- Welded decor (CourseBuilder welds it to the cloud) follows the root automatically.
local function updateMovers(ctx)
	local t = ctx.clock
	for _, m in ipairs(ctx.movers) do
		local part = m.part
		if part.Parent then
			-- u runs 0..2; 0..1 is the trip out, 1..2 the trip back (one leg takes `period` s).
			local u = (t / m.period + m.phase) % 2
			local direction = 1
			if u > 1 then
				u = 2 - u
				direction = -1
			end
			local eased = 0.5 - 0.5 * math.cos(math.pi * u) -- Sine in/out
			local rate = 0.5 * math.pi * math.sin(math.pi * u) / m.period * direction
			part.CFrame = m.base + m.offset * eased
			part.AssemblyLinearVelocity = m.offset * rate
		end
	end
	ctx.moversMoving = true
end

-- Stop publishing velocity (match paused/ended) so nothing keeps dragging players.
local function haltMovers(ctx)
	for _, m in ipairs(ctx.movers) do
		if m.part.Parent then
			m.part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end
	ctx.moversMoving = false
end

local function tickStorms(ctx, elapsed)
	for _, storm in ipairs(ctx.storms) do
		local part = storm.part
		if part.Parent then
			local victims = playersInBox(ctx, part.CFrame, part.Size)
			for _, player in ipairs(victims) do
				-- DPS / 4 per 0.25 s tick; i-frames are ignored so the drizzle is steady.
				hurt(ctx, player, storm.dps * elapsed, "Storm", { IgnoreIFrames = true })
			end
		end
	end
end

local function setPlatePressed(plate, pressed)
	local part = plate.part
	if not part.Parent then
		return
	end
	plate.pressed = pressed
	if pressed then
		Util.Tween(part, 0.15, {
			CFrame = plate.baseCF - Vector3.new(0, PLATE_PRESS_DEPTH, 0),
			Color = plate.baseColor:Lerp(PAL.PlateGlow, 0.3),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	else
		Util.Tween(part, 0.25, { CFrame = plate.baseCF, Color = plate.baseColor },
			Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	end
end

local function setBridgeShown(group, shown)
	for _, bridge in ipairs(group.bridges) do
		if bridge.part.Parent then
			if shown then
				collideSet(bridge.set, true)
				fadeSet(bridge.set, 0, PLATE_FADE_IN)
			else
				-- Solid-ness goes first so nobody is left standing on a ghost.
				collideSet(bridge.set, false)
				fadeSet(bridge.set, 1, PLATE_FADE_OUT)
			end
		end
	end
end

-- Co-op rule: a bridge is solid only while at least one player stands on any plate sharing its
-- BridgeId; it retracts PLATE_RETRACT_DELAY seconds after the last player steps off.
local function tickPlates(ctx)
	local now = os.clock()
	for _, group in ipairs(ctx.groupList) do
		local occupied = false
		for _, plate in ipairs(group.plates) do
			local pressed = false
			if plate.part.Parent then
				pressed = #playersInBox(ctx, plate.boxCF, plate.boxSize) > 0
			end
			if pressed ~= plate.pressed then
				setPlatePressed(plate, pressed)
			end
			if pressed then
				occupied = true
			end
		end
		if occupied then
			group.emptySince = nil
			if not group.shown then
				group.shown = true
				setBridgeShown(group, true)
			end
		elseif group.shown then
			if not group.emptySince then
				group.emptySince = now
			end
			if now - group.emptySince >= PLATE_RETRACT_DELAY then
				group.shown = false
				group.emptySince = nil
				setBridgeShown(group, false)
			end
		end
	end
end

----------------------------------------------------------------------
-- WindGust runtime (per-frame streaks + 15 Hz push). Behaviour setup is further below.
----------------------------------------------------------------------
-- Wind push implementation note: the push is a horizontal VectorForce on the player's
-- HumanoidRootPart, not repeated AssemblyLinearVelocity writes. A character is simulated by its
-- owning client, so the server only ever reads a latency-old velocity; writing "old velocity +
-- push" back 15 times a second would also overwrite the vertical velocity with stale values (it
-- cancels jumps and makes falling floaty). A constraint is simulated by the owner itself, touches
-- X/Z only, and still obeys the contract: the speed gained along the wind is capped at `Force`
-- studs/s (the force switches off once the player is as fast as the gust).
local function releasePush(entry)
	if entry.force then
		pcall(function()
			entry.force:Destroy()
		end)
	end
	if entry.attachment then
		pcall(function()
			entry.attachment:Destroy()
		end)
	end
	entry.force = nil
	entry.attachment = nil
end

local function clearWindPushes(wind)
	for player, entry in pairs(wind.pushed) do
		releasePush(entry)
		wind.pushed[player] = nil
	end
end

local function setWindPhase(ctx, wind, phase)
	if ctx.stopped then
		return
	end
	wind.phase = phase
	wind.phaseClock = ctx.clock
	if wind.drift then
		if phase == "blow" then
			wind.drift.Rate = wind.blowRate
		elseif phase == "warning" then
			wind.drift.Rate = wind.warnRate
		else
			wind.drift.Rate = 0
		end
	end
end

-- Strength 0..1 of the current push (0 outside the blow phase).
local function windEnvelope(ctx, wind)
	if wind.phase ~= "blow" then
		return 0
	end
	local t = ctx.clock - wind.phaseClock
	local env = math.min(1, t / WIND_RAMP_IN, (wind.blow - t) / WIND_RAMP_OUT)
	if env < 0 then
		env = 0
	end
	return env
end

local function pushPlayer(wind, player, root, env)
	local entry = wind.pushed[player]
	if entry and (entry.root ~= root or not root.Parent or not entry.force or not entry.force.Parent) then
		releasePush(entry) -- respawned (or the constraint vanished): start over
		entry = nil
	end
	if not entry then
		local attachment = Instance.new("Attachment")
		attachment.Name = "NimbusWindAttachment"
		attachment.Parent = root
		local force = Instance.new("VectorForce")
		force.Name = "NimbusWindForce"
		force.Attachment0 = attachment
		force.ApplyAtCenterOfMass = true
		force.RelativeTo = Enum.ActuatorRelativeTo.World
		force.Force = Vector3.new(0, 0, 0)
		force.Parent = root
		entry = { root = root, attachment = attachment, force = force }
		wind.pushed[player] = entry
	end
	-- Speed already gained along the wind is capped at the (ramped) gust speed.
	local along = root.AssemblyLinearVelocity:Dot(wind.dir)
	local ceiling = wind.force * env
	local accel = Util.Clamp((ceiling - along) * WIND_GAIN, 0, WIND_MAX_ACCEL)
	entry.force.Force = wind.dir * (root.AssemblyMass * accel)
end

local function tickWind(ctx, wind)
	local env = windEnvelope(ctx, wind)
	if env <= 0 or not wind.part.Parent then
		clearWindPushes(wind)
		return
	end
	local inside = {}
	for _, player in ipairs(playersInBox(ctx, wind.part.CFrame, wind.part.Size)) do
		if not isDowned(player) then
			local root = getLivingRoot(player)
			if root then
				inside[player] = true
				pushPlayer(wind, player, root, env)
			end
		end
	end
	for player, entry in pairs(wind.pushed) do
		if not inside[player] then
			releasePush(entry)
			wind.pushed[player] = nil
		end
	end
end

local function tickWinds(ctx, active)
	for _, wind in ipairs(ctx.winds) do
		if active then
			tickWind(ctx, wind)
		else
			clearWindPushes(wind) -- paused: nobody keeps drifting
		end
	end
end

-- Start one streak: a thin soft line racing from the upwind face to the downwind face of the volume.
local function launchStreak(ctx, wind, slot)
	local rng = ctx.rng
	local part = wind.part
	local size = part.Size
	local localPoint = Vector3.new(
		(rng:NextNumber() - 0.5) * size.X,
		(rng:NextNumber() - 0.5) * size.Y,
		(rng:NextNumber() - 0.5) * size.Z
	)
	local point = part.CFrame:PointToWorldSpace(localPoint)
	local along = (point - wind.center):Dot(wind.dir)
	local lateral = point - wind.dir * along -- same spot, projected onto the centre plane
	slot.a = lateral - wind.dir * wind.halfLen
	slot.b = lateral + wind.dir * wind.halfLen
	local speed = math.max(30, wind.force * 2.4) * rng:NextNumber(0.85, 1.25)
	slot.life = Util.Clamp(wind.halfLen * 2 / speed, 0.35, 1.3)
	slot.age = 0
	slot.state = "fly"
	if wind.phase == "blow" then
		slot.minTransparency = 0.42
	else
		slot.minTransparency = 0.74 -- the warning is just a hint
	end
	local thickness = rng:NextNumber(0.1, 0.2)
	slot.part.Size = Vector3.new(thickness, thickness, rng:NextNumber(4, 8))
	wind.live = wind.live + 1
end

local function updateWindStreaks(ctx, dt)
	for _, wind in ipairs(ctx.winds) do
		if wind.phase ~= "idle" or wind.live > 0 then
			local limit = 0
			if wind.phase == "blow" then
				limit = #wind.streaks
			elseif wind.phase == "warning" then
				limit = WIND_WARN_STREAKS
			end
			for index, slot in ipairs(wind.streaks) do
				if slot.state == "idle" then
					if index <= limit then
						slot.delay = slot.delay - dt
						if slot.delay <= 0 then
							launchStreak(ctx, wind, slot)
						end
					end
				else
					slot.age = slot.age + dt
					local u = slot.age / slot.life
					if u >= 1 then
						slot.state = "idle"
						slot.part.Transparency = 1
						slot.delay = ctx.rng:NextNumber(0.02, 0.35)
						wind.live = wind.live - 1
					else
						local pos = slot.a:Lerp(slot.b, u)
						slot.part.CFrame = CFrame.lookAt(pos, pos + wind.dir)
						local alpha = math.min(u / 0.2, (1 - u) / 0.3, 1)
						slot.part.Transparency = 1 - (1 - slot.minTransparency) * alpha
					end
				end
			end
		end
	end
end

local function stepContext(ctx, dt)
	if ctx.stopped then
		return
	end
	if dt > 0.1 then
		dt = 0.1 -- a lag spike must not teleport bars/clouds
	end
	local active = isActive(ctx)
	if active then
		ctx.clock = ctx.clock + dt
		if #ctx.spinBars > 0 then
			guarded("SpinBar", updateSpinBars, ctx)
		end
		if #ctx.pendulums > 0 then
			guarded("Pendulum", updatePendulums, ctx)
		end
		if #ctx.movers > 0 then
			guarded("MovingCloud", updateMovers, ctx)
		end
		if #ctx.winds > 0 then
			guarded("WindGustVisuals", updateWindStreaks, ctx, dt)
		end
	elseif ctx.moversMoving then
		guarded("MovingCloud", haltMovers, ctx)
	end

	ctx.stormAcc = ctx.stormAcc + dt
	if ctx.stormAcc >= STORM_TICK then
		local elapsed = ctx.stormAcc
		ctx.stormAcc = 0
		if active and #ctx.storms > 0 then
			guarded("StormCloud", tickStorms, ctx, elapsed)
		end
	end

	ctx.hitAcc = ctx.hitAcc + dt
	if ctx.hitAcc >= HIT_TICK then
		ctx.hitAcc = 0
		if active and #ctx.hitters > 0 then
			guarded("HitPoll", pollHitters, ctx)
		end
	end

	ctx.windAcc = ctx.windAcc + dt
	if ctx.windAcc >= WIND_TICK then
		ctx.windAcc = 0
		if #ctx.winds > 0 then
			guarded("WindGust", tickWinds, ctx, active)
		end
	end

	ctx.plateAcc = ctx.plateAcc + dt
	if ctx.plateAcc >= PLATE_TICK then
		ctx.plateAcc = 0
		if #ctx.groupList > 0 then
			guarded("PressurePlate", tickPlates, ctx)
		end
	end
end

-- The single shared Heartbeat connection of this context (created lazily by the first behaviour
-- that needs per-frame work).
local function ensureHeartbeat(ctx)
	if ctx.heartbeat then
		return
	end
	ctx.heartbeat = RunService.Heartbeat:Connect(function(dt)
		stepContext(ctx, dt)
	end)
	table.insert(ctx.connections, ctx.heartbeat)
end

-- Register a moving damage bar (SpinBar / Pendulum): Touched + the backup overlap poll.
local function addHitter(ctx, hitter)
	table.insert(ctx.hitters, hitter)
	ensureHeartbeat(ctx)
	connect(ctx, hitter.part.Touched, function(hit)
		if ctx.stopped or not isActive(ctx) then
			return
		end
		local player = playerFromHit(hit)
		if player then
			registerHit(ctx, hitter, player)
		end
	end)
	onStop(ctx, function()
		hitter.lastHit = {}
	end)
end

----------------------------------------------------------------------
-- Behaviour: SpinBar
----------------------------------------------------------------------
local function attachSpinBar(ctx, part)
	local bar = {
		part = part,
		base = part.CFrame,
		-- defaults = the middle (Hard) tier of CourseLayout's TIER.SpinSpeed / SpinDamage: slow enough to read, hits hard
		speed = math.rad(attrNumber(part, "Speed", 65)),
		phase = math.rad(attrNumber(part, "Phase", 0)),
		-- hit data used by the shared moving-bar routine
		damage = attrNumber(part, "Damage", 22),
		kind = "SpinBar",
		knockback = SPINBAR_KNOCKBACK,
		lastHit = {},
	}
	table.insert(ctx.spinBars, bar)
	addHitter(ctx, bar)
	onStop(ctx, function()
		if part.Parent then
			part.CFrame = bar.base
		end
	end)
end

----------------------------------------------------------------------
-- Behaviour: Pendulum
--   Tagged part = the swinging beam. Attributes: Hinge (world pivot), Axis (world swing axis),
--   Period (s per full swing), Arc (degrees each side of rest), Damage, optional Phase (degrees).
--   Swing angle = Arc * sin(2*pi*t/Period + Phase); decor welded to the beam follows by itself,
--   decor merely parented under it (anchored) is moved by the same transform.
----------------------------------------------------------------------
local function attachPendulum(ctx, part)
	local base = part.CFrame
	local hinge = attrVector3(part, "Hinge", nil)
	if not hinge then
		hinge = base.Position + Vector3.new(0, 12, 0) -- sane default: pivot a little above the beam
	end
	local axis = attrVector3(part, "Axis", nil)
	if not axis or axis.Magnitude < 0.01 then
		axis = flatUnit(base.RightVector, Vector3.new(1, 0, 0))
	else
		axis = axis.Unit
	end

	local phase
	local phaseAttr = part:GetAttribute("Phase")
	if type(phaseAttr) == "number" then
		phase = math.rad(phaseAttr)
	else
		-- no explicit phase: derive one from the position so neighbouring pendulums are not in lockstep
		phase = (hinge.X * 0.173 + hinge.Y * 0.071 + hinge.Z * 0.291) % TWO_PI
	end

	-- anchored decor parented under the beam would be left behind by the swing: move it ourselves
	local followers = {}
	for _, d in ipairs(part:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored then
			table.insert(followers, { part = d, base = d.CFrame })
		end
	end

	local pendulum = {
		part = part,
		base = base,
		pivot = CFrame.new(hinge),
		pivotInverse = CFrame.new(hinge):Inverse(),
		axis = axis,
		arc = math.rad(Util.Clamp(attrNumber(part, "Arc", 55), 0, 170)),
		period = math.max(0.8, attrNumber(part, "Period", 4)),
		phase = phase,
		followers = followers,
		-- hit data used by the shared moving-bar routine
		damage = attrNumber(part, "Damage", 20),
		kind = "Pendulum",
		knockback = PENDULUM_KNOCKBACK,
		lastHit = {},
	}
	table.insert(ctx.pendulums, pendulum)
	addHitter(ctx, pendulum)
	onStop(ctx, function()
		if part.Parent then
			part.CFrame = base
		end
		for _, f in ipairs(followers) do
			if f.part.Parent then
				f.part.CFrame = f.base
			end
		end
	end)
end

----------------------------------------------------------------------
-- Behaviour: MovingCloud (motion in updateMovers, see the carrying note there)
----------------------------------------------------------------------
local function attachMovingCloud(ctx, part)
	table.insert(ctx.movers, {
		part = part,
		base = part.CFrame,
		offset = attrVector3(part, "EndOffset", Vector3.new(0, 0, 16)),
		period = math.max(0.5, attrNumber(part, "Period", 5)),
		phase = attrNumber(part, "Phase", 0),
	})
	ensureHeartbeat(ctx)
	onStop(ctx, function()
		if part.Parent then
			part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		end
	end)
end

----------------------------------------------------------------------
-- Behaviour: StormCloud
----------------------------------------------------------------------
-- A rain emitter hugging the top of the storm volume; drops (the Droplet sprite) fall through it to the platform top,
-- and a slow Cloud mist layer drifts down under the cloud (kit-b O3: the volume itself is invisible now).
-- The Droplet sheet is OneShot over a drop's life (fall, wobble, then a splash crown), so the life ends where the
-- drop reaches the volume bottom (the platform top) and the pop plays on the surface, not under the slab.
local function addRain(ctx, part)
	if part:FindFirstChildOfClass("ParticleEmitter") then
		return -- the builder already dressed this cloud
	end
	local size = part.Size
	local fallSpeed = 30
	local rainPart = makePart({
		Name = "StormRain",
		Transparency = 1,
		Size = Vector3.new(math.max(1, size.X * 0.95), 0.2, math.max(1, size.Z * 0.95)),
		CFrame = part.CFrame * CFrame.new(0, size.Y / 2 - 0.1, 0),
		Parent = ctx.container,
	})
	local fallAccel = 40
	local fall = math.max(0.5, size.Y - 0.1) -- the emitter sits 0.1 under the volume top
	-- fallSpeed * t + fallAccel / 2 * t^2 = fall
	local lifetime = (-fallSpeed + math.sqrt(fallSpeed * fallSpeed + 2 * fallAccel * fall)) / fallAccel
	local rate = Util.Clamp(size.X * size.Z * 1.2, 60, 320)
	local rain = newEmitter({
		Name = "Rain",
		Sprite = "Droplet",
		Rate = rate,
		Lifetime = NumberRange.new(lifetime * 0.9, lifetime),
		Speed = NumberRange.new(fallSpeed * 0.9, fallSpeed * 1.1),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(3, 3),
		LightEmission = 0.1,
		LightInfluence = 0.7,
		Color = ColorSequence.new(PAL.RainTop, PAL.RainBottom),
		Size = NumberSequence.new(0.85), -- the drop fills ~0.31 of its cell: ~0.26 studs drawn
		Squash = NumberSequence.new({ -- a taller streak while falling, round again for the pop
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(0.6, 0.6),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(0.8, 0.4),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Acceleration = Vector3.new(0, -fallAccel, 0),
	})
	rain.Parent = rainPart
	local mist = newEmitter({
		Name = "StormMist",
		Sprite = "Cloud",
		Rate = Util.Clamp(size.X * size.Z * 0.04, 3, 10),
		Lifetime = NumberRange.new(3, 4.5),
		Speed = NumberRange.new(0.6, 1.4),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(20, 20),
		Rotation = NumberRange.new(-12, 12), -- a cloud sheet stays upright
		RotSpeed = NumberRange.new(-4, 4),
		LightEmission = 0,
		LightInfluence = 0.8,
		Color = ColorSequence.new(PAL.StormMist, PAL.StormMistDeep), -- the sheet is neutral grey: a grey-blue tint
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2.5),
			NumberSequenceKeypoint.new(1, 4.5),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, 0.6),
			NumberSequenceKeypoint.new(0.75, 0.75),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	mist.Parent = rainPart
	table.insert(ctx.permanents, rainPart)
end

local function attachStormCloud(ctx, part)
	table.insert(ctx.storms, { part = part, dps = attrNumber(part, "DPS", 8) })
	addRain(ctx, part)
	ensureHeartbeat(ctx)
end

----------------------------------------------------------------------
-- Behaviour: LightningZone
--   The tagged part marks the strike disc: its centre is the impact point and `Radius`
--   (default: half its footprint) is the damage radius. A red warning disc fills up for
--   `Warning` seconds, then a jagged bolt hits and everyone in the disc is damaged. The flash is
--   brief and dim on purpose: it must read as a strike, not blind the screen.
----------------------------------------------------------------------
local function zoneGroundY(part)
	local half = part.Size.Y / 2
	if part.Size.Y > 6 then
		return part.Position.Y - half -- tall volume: the floor is at its bottom
	end
	return part.Position.Y + half -- slab: the floor is its top face
end

local function showStrikeWarning(ctx, zone, target)
	local diameter = zone.radius * 2
	local flat = CFrame.new(target.X, target.Y + 0.2, target.Z) * CFrame.Angles(0, 0, math.pi / 2)
	local ring = makePart({
		Name = "StrikeWarning",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.1, diameter, diameter),
		CFrame = flat,
		Color = PAL.Warn,
		Transparency = 0.55,
	})
	local fill = makePart({
		Name = "StrikeWarningFill",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.14, 0.4, 0.4),
		CFrame = flat,
		Color = PAL.WarnFill,
		Transparency = 0.62,
	})
	addTemp(ctx, ring, zone.warning + 3)
	addTemp(ctx, fill, zone.warning + 3)
	-- the inner disc grows to the full radius exactly when the bolt lands
	Util.Tween(fill, zone.warning, { Size = Vector3.new(0.14, diameter, diameter) },
		Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	-- the outer ring pulses so the danger reads at a glance
	TweenService:Create(ring, TweenInfo.new(0.22, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Transparency = 0.3 }):Play()
	return ring, fill
end

local function strikeAt(ctx, zone, target)
	local rng = ctx.rng
	local radius = zone.radius

	-- 1. jagged bolt from the sky: a soft glow shell + a thin core per segment
	local top = Vector3.new(target.X + rng:NextNumber(-8, 8), target.Y + BOLT_HEIGHT, target.Z + rng:NextNumber(-8, 8))
	local points = { top }
	for i = 1, BOLT_SEGMENTS - 1 do
		local alpha = i / BOLT_SEGMENTS
		local sway = 1 + (1 - alpha) * 5
		local p = top:Lerp(target, alpha)
		table.insert(points, p + Vector3.new(rng:NextNumber(-sway, sway), 0, rng:NextNumber(-sway, sway)))
	end
	table.insert(points, target)

	for i = 1, #points - 1 do
		local a = points[i]
		local b = points[i + 1]
		local length = (b - a).Magnitude + 0.4
		local look = CFrame.lookAt(a:Lerp(b, 0.5), b)
		local glow = makePart({
			Name = "BoltGlow",
			Size = Vector3.new(1.8, 1.8, length),
			CFrame = look,
			Color = PAL.BoltGlow,
			Transparency = 0.72,
		})
		local core = makePart({
			Name = "BoltCore",
			Size = Vector3.new(0.55, 0.55, length),
			CFrame = look,
			Color = PAL.BoltCore,
			Transparency = 0.08,
		})
		addTemp(ctx, glow, 0.7)
		addTemp(ctx, core, 0.7)
		Util.Tween(glow, 0.28, { Transparency = 1, Size = Vector3.new(0.5, 0.5, length) },
			Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Util.Tween(core, 0.28, { Transparency = 1, Size = Vector3.new(0.15, 0.15, length) },
			Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end

	-- 2. impact flash: a brief translucent ground disc + a small fading light + a short spark burst
	local flash = makePart({
		Name = "StrikeFlash",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.2, radius * 2, radius * 2),
		CFrame = CFrame.new(target.X, target.Y + 0.25, target.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = PAL.BoltCore,
		Transparency = 0.5,
	})
	addTemp(ctx, flash, 0.8)
	Util.Tween(flash, 0.35, { Size = Vector3.new(0.2, radius * 2.4, radius * 2.4), Transparency = 1 },
		Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local impact = makePart({
		Name = "StrikeImpact",
		Transparency = 1,
		Size = Vector3.new(1, 1, 1),
		CFrame = CFrame.new(target.X, target.Y + 1.5, target.Z),
	})
	local light = Instance.new("PointLight")
	light.Color = PAL.BoltCore
	light.Brightness = 2.4
	light.Range = Util.Clamp(radius * 3.5, 16, 30)
	light.Shadows = false
	light.Parent = impact
	local sparks = newEmitter({
		Name = "StrikeSparks",
		Sprite = "Spark", -- zig-zag electric crackles
		Rate = 0,
		Color = ColorSequence.new(PAL.BoltCore, PAL.BoltGlow),
		Lifetime = NumberRange.new(0.35, 0.7),
		Speed = NumberRange.new(18, 32),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(70, 70),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Acceleration = Vector3.new(0, -60, 0),
	})
	sparks.Parent = impact
	addTemp(ctx, impact, 1.2)
	sparks:Emit(20)
	Util.Tween(light, 0.4, { Brightness = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	-- 3. damage everyone standing in the strike cylinder
	local reach = radius + 0.8
	local reach2 = reach * reach
	for _, player in ipairs(Players:GetPlayers()) do
		local root = getLivingRoot(player)
		if root then
			local p = root.Position
			local dx = p.X - target.X
			local dz = p.Z - target.Z
			if dx * dx + dz * dz <= reach2 and p.Y > target.Y - 4 and p.Y < target.Y + 16 then
				hurt(ctx, player, zone.damage, "Lightning", {
					KnockbackFrom = target,
					Knockback = LIGHTNING_KNOCKBACK,
				})
			end
		end
	end
end

-- One warn -> strike cycle. Returns false when the context was stopped.
local function lightningCycle(ctx, zone)
	if not awaitActive(ctx) then
		return false
	end
	local part = zone.part
	local target = Vector3.new(part.Position.X, zoneGroundY(part), part.Position.Z)
	local ring, fill = showStrikeWarning(ctx, zone, target)
	local ok = waitActive(ctx, zone.warning)
	removeTemp(ctx, ring)
	removeTemp(ctx, fill)
	if not ok then
		return false
	end
	strikeAt(ctx, zone, target)
	return true
end

local function runLightningZone(ctx, zone)
	-- Desynchronise zones so a whole stage does not flash at once.
	if not waitActive(ctx, ctx.rng:NextNumber(0.3, zone.interval)) then
		return
	end
	while not ctx.stopped and zone.part.Parent do
		local ok, result = pcall(lightningCycle, ctx, zone)
		if not ok then
			if not warned.Lightning then
				warned.Lightning = true
				warn("[HazardService] lightning cycle failed: " .. tostring(result))
			end
		elseif result == false then
			return
		end
		-- Interval is strike-to-strike; the warning already used part of it.
		local rest = zone.interval + ctx.rng:NextNumber(-zone.jitter, zone.jitter) - zone.warning
		if rest < 0.5 then
			rest = 0.5
		end
		if not waitActive(ctx, rest) then
			return
		end
	end
end

local function attachLightningZone(ctx, part)
	local interval = math.max(1.5, attrNumber(part, "Interval", 4))
	local radius = attrNumber(part, "Radius", 0)
	if radius <= 0 then
		radius = math.max(2, math.min(part.Size.X, part.Size.Z) / 2)
	end
	local zone = {
		part = part,
		damage = attrNumber(part, "Damage", 28),
		interval = interval,
		warning = math.max(0.4, attrNumber(part, "Warning", 1.2)),
		jitter = math.max(0, attrNumber(part, "Jitter", interval * 0.2)),
		radius = radius,
	}
	task.spawn(runLightningZone, ctx, zone)
end

----------------------------------------------------------------------
-- Behaviour: WindGust
--   Tagged part = invisible volume. Attributes: Force (studs/s the gust can reach), Direction
--   (unit vector, used horizontally), Interval (s between gust starts), Warning (s of faint
--   streaks before the push). Cycle: idle -> warning (hint streaks) -> blow (Duration attr, default 1.5 s, of
--   push + dense streaks) -> idle. No damage, ever. See the push note above releasePush.
----------------------------------------------------------------------
local function windCycle(ctx, wind)
	if not awaitActive(ctx) then
		return false
	end
	setWindPhase(ctx, wind, "warning")
	if not waitActive(ctx, wind.warning) then
		return false
	end
	setWindPhase(ctx, wind, "blow")
	if not waitActive(ctx, wind.blow) then
		return false
	end
	setWindPhase(ctx, wind, "idle")
	return true
end

local function runWind(ctx, wind)
	-- Desynchronise gust volumes so a whole stage does not blow at once.
	if not waitActive(ctx, ctx.rng:NextNumber(0.2, wind.interval)) then
		return
	end
	while not ctx.stopped and wind.part.Parent do
		local ok, result = pcall(windCycle, ctx, wind)
		if not ok then
			if not warned.WindCycle then
				warned.WindCycle = true
				warn("[HazardService] wind cycle failed: " .. tostring(result))
			end
			setWindPhase(ctx, wind, "idle")
		elseif result == false then
			return
		end
		local rest = wind.interval + ctx.rng:NextNumber(-0.4, 0.4) - wind.warning - wind.blow
		if rest < 0.8 then
			rest = 0.8
		end
		if not waitActive(ctx, rest) then
			return
		end
	end
end

local function attachWindGust(ctx, part)
	part.CanCollide = false -- an invisible wall would be a nasty surprise
	local dir = flatUnit(attrVector3(part, "Direction", nil), nil)
	if not dir then
		dir = flatUnit(part.CFrame.LookVector, Vector3.new(1, 0, 0))
	end
	local force = Util.Clamp(attrNumber(part, "Force", 18), 0, WIND_MAX_FORCE)
	local halfLen = math.max(1, halfExtentAlong(part, dir))
	local wind = {
		part = part,
		dir = dir,
		force = force,
		interval = math.max(2.5, attrNumber(part, "Interval", 5)),
		warning = math.max(0.5, attrNumber(part, "Warning", 1.5)),
		blow = Util.Clamp(attrNumber(part, "Duration", WIND_BLOW_TIME), 0.6, 3), -- optional extra attribute
		center = part.Position,
		halfLen = halfLen,
		phase = "idle",
		phaseClock = 0,
		pushed = {}, -- player -> { root, attachment, force }
		streaks = {},
		live = 0, -- streaks currently flying
		drift = nil,
		warnRate = 4,
		blowRate = 22,
	}

	-- drifting smoke at the upwind face: faint puffs carried along the wind
	local crossWidth = math.max(1, halfExtentAlong(part, dir:Cross(Vector3.new(0, 1, 0)).Unit) * 2)
	local crossHeight = math.max(1, halfExtentAlong(part, Vector3.new(0, 1, 0)) * 2)
	local upwind = wind.center - dir * halfLen
	local driftPart = makePart({
		Name = "WindDrift",
		Transparency = 1,
		Size = Vector3.new(crossWidth, crossHeight, 0.4),
		CFrame = CFrame.lookAt(upwind, upwind + dir),
		Parent = ctx.container,
	})
	table.insert(ctx.permanents, driftPart)
	local driftSpeed = force * 0.9 + 8
	wind.drift = newPuffEmitter({
		Name = "WindSmoke",
		Color = ColorSequence.new(PAL.WindDrift, PAL.PuffDark),
		LightEmission = 0,
		Lifetime = NumberRange.new(
			Util.Clamp(halfLen * 2 / driftSpeed, 0.5, 1.6),
			Util.Clamp(halfLen * 2.4 / driftSpeed, 0.6, 1.9)
		),
		Speed = NumberRange.new(driftSpeed * 0.85, driftSpeed * 1.15),
		EmissionDirection = Enum.NormalId.Front, -- the part's look vector == the wind direction
		SpreadAngle = Vector2.new(4, 4),
		Drag = 0,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 2),
			NumberSequenceKeypoint.new(1, 5),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.86),
			NumberSequenceKeypoint.new(1, 1),
		}),
	})
	wind.drift.Parent = driftPart

	-- pooled streak parts (invisible until used)
	for _ = 1, WIND_STREAKS do
		local streak = makePart({
			Name = "WindStreak",
			Size = Vector3.new(0.14, 0.14, 6),
			Color = PAL.Wind,
			Transparency = 1,
			Parent = ctx.container,
		})
		table.insert(ctx.permanents, streak)
		table.insert(wind.streaks, {
			part = streak,
			state = "idle",
			delay = ctx.rng:NextNumber(0, 0.5),
			age = 0,
			life = 1,
			a = wind.center,
			b = wind.center,
			minTransparency = 0.5,
		})
	end

	table.insert(ctx.winds, wind)
	ensureHeartbeat(ctx)
	onStop(ctx, function()
		clearWindPushes(wind)
	end)
	task.spawn(runWind, ctx, wind)
end

----------------------------------------------------------------------
-- Behaviour: CloudCannon
--   Touch the pad -> 0.35 s squash + puff -> the player's root gets the velocity of a projectile that
--   leaves its CURRENT position and reaches Target after FlightTime under workspace.Gravity:
--       v = (Target - p) / t + Vector3.new(0, g * t / 2, 0)
--   (Target is where the root passes at t = FlightTime). The player cannot be launched again for
--   CANNON_REARM seconds and is protected from all damage (fall / void included) while in flight. They cannot
--   steer the flight either (WalkSpeed 0 / AutoRotate off until the touchdown, see lockSteering).
----------------------------------------------------------------------
local function chargeCannon(cannon)
	cannon.charging = cannon.charging + 1
	if cannon.puff then
		cannon.puff:Emit(8)
	end
	if cannon.sparks then
		cannon.sparks:Emit(8)
	end
	local base = cannon.baseSize
	cannon.tween = Util.Tween(cannon.part, CANNON_CHARGE * 0.85,
		{ Size = Vector3.new(base.X * 1.1, base.Y * 0.68, base.Z * 1.1) },
		Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
end

-- The charge ended (launch or cancelled): spring back once nobody else is charging.
local function releaseCannon(ctx, cannon)
	cannon.charging = math.max(0, cannon.charging - 1)
	if cannon.charging > 0 or ctx.stopped or not cannon.part.Parent then
		return
	end
	cannon.tween = Util.Tween(cannon.part, 0.55, { Size = cannon.baseSize },
		Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
end

-- Where the rider's root really is when our velocity write reaches their client: the server sees a
-- position that is up to one round trip old, and a walking rider keeps moving until the write lands.
local function launchOrigin(player, root)
	local position = root.Position
	local ok, ping = pcall(function()
		return player:GetNetworkPing()
	end)
	if ok and type(ping) == "number" and ping == ping then
		ping = Util.Clamp(ping, 0, CANNON_MAX_LATENCY)
		local v = root.AssemblyLinearVelocity
		position = position + Vector3.new(v.X, 0, v.Z) * ping
	end
	return position
end

-- No steering in a cannon flight (bug #8: riders steered the arc onto the steps above and skipped a stage).
-- From the launch until the touchdown the rider's WalkSpeed is 0 (no air control; the client's MovementController
-- reads a server 0 as "frozen", so no run or dash either) and AutoRotate is off. The touchdown is the first floor
-- contact once FlightTime has passed, and at the latest FlightTime + CANNON_LANDING_GRACE. The values from before
-- the launch come back on every path: touchdown / time limit, the match stopping (stopContext), the character dying
-- or being removed, and MatchService detaching the player (HazardService.ReleaseFlight). A freeze, downed state or
-- revive that wrote its own WalkSpeed meanwhile is left alone. player -> lock (one per player, across matches).
local steerLocks = {}

local function isGrounded(humanoid)
	local ok, material = pcall(function()
		return humanoid.FloorMaterial
	end)
	return ok and material ~= nil and material ~= Enum.Material.Air
end

local function releaseSteering(player, lock)
	if not lock or steerLocks[player] ~= lock then
		return
	end
	steerLocks[player] = nil
	if lock.diedConn then
		pcall(function()
			lock.diedConn:Disconnect()
		end)
	end
	local humanoid = lock.humanoid
	pcall(function()
		if not humanoid.Parent or humanoid.Health <= 0 then
			return -- died / respawned: the next character starts with fresh values
		end
		if humanoid.WalkSpeed < 0.01 and not isDowned(player) then
			local root = humanoid.Parent:FindFirstChild("HumanoidRootPart")
			if not (root and root.Anchored) then -- anchored = frozen by MatchService, it unfreezes by itself
				humanoid.WalkSpeed = lock.walkSpeed
			end
		end
		if humanoid.AutoRotate == false then
			humanoid.AutoRotate = lock.autoRotate
		end
	end)
end

local function lockSteering(ctx, player, humanoid, flight)
	local now = os.clock()
	local lock = steerLocks[player]
	if lock and lock.humanoid ~= humanoid then
		releaseSteering(player, lock) -- a lock left on an old character
		lock = nil
	end
	if lock then
		-- launched again while still locked (pad to pad): keep the values saved at the first launch
		lock.ctx = ctx
	else
		lock = {
			ctx = ctx,
			humanoid = humanoid,
			walkSpeed = humanoid.WalkSpeed,
			autoRotate = humanoid.AutoRotate,
		}
		steerLocks[player] = lock
		lock.diedConn = humanoid.Died:Connect(function()
			releaseSteering(player, lock)
		end)
		task.spawn(function()
			while steerLocks[player] == lock do
				task.wait(CANNON_STEER_POLL)
				local t = os.clock()
				if lock.ctx.stopped or not humanoid.Parent or t >= lock.untilAt
					or (t >= lock.landAt and isGrounded(humanoid)) then
					releaseSteering(player, lock)
				end
			end
		end)
	end
	lock.landAt = now + flight
	lock.untilAt = now + flight + CANNON_LANDING_GRACE
	humanoid.WalkSpeed = 0
	humanoid.AutoRotate = false
end

-- Gives every steering lock of this context back (the match stopped).
local function releaseContextSteering(ctx)
	local list = {}
	for player, lock in pairs(steerLocks) do
		if lock.ctx == ctx then
			table.insert(list, { player, lock })
		end
	end
	for _, entry in ipairs(list) do
		releaseSteering(entry[1], entry[2])
	end
end

local function launchPlayer(ctx, cannon, player, root)
	local gravity = Workspace.Gravity
	local flight = cannon.flight
	local origin = launchOrigin(player, root)
	local velocity = (cannon.target - origin) / flight + Vector3.new(0, gravity * flight / 2, 0)
	if velocity.Magnitude > CANNON_MAX_SPEED then
		velocity = velocity.Unit * CANNON_MAX_SPEED
	end
	root.AssemblyLinearVelocity = velocity
	ctx.launchedAt[player] = os.clock()
	-- no fall / void / hazard damage until just after the touchdown
	pcall(DamageService.GrantInvulnerability, player, flight + CANNON_LANDING_GRACE)
	-- ... and no steering until the touchdown (bug #8)
	local humanoid = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
	if humanoid then
		guarded("CannonSteer", lockSteering, ctx, player, humanoid, flight)
	end
	if cannon.puff then
		cannon.puff:Emit(20)
	end
	if cannon.sparks then
		cannon.sparks:Emit(14)
	end
end

local function runCannonLaunch(ctx, cannon, player)
	chargeCannon(cannon)
	local alive = sleep(ctx, CANNON_CHARGE)
	cannon.pending[player] = nil
	if not alive then
		return -- match ended: the part may already be gone
	end
	local launched = false
	local root = getLivingRoot(player)
	if root and player.Parent and isActive(ctx) and not isDowned(player) and cannon.part.Parent then
		-- the player must still be on (or right next to) the pad: someone who jumped off is left alone
		local offset = root.Position - cannon.part.Position
		local reach = math.max(cannon.part.Size.X, cannon.part.Size.Z) / 2 + CANNON_STAND_SLACK
		if Vector3.new(offset.X, 0, offset.Z).Magnitude <= reach and math.abs(offset.Y) <= 12 then
			launchPlayer(ctx, cannon, player, root)
			launched = true
		end
	end
	if not launched and cannon.puff then
		cannon.puff:Emit(4) -- a little fizzle so the charge does not just vanish
	end
	releaseCannon(ctx, cannon)
end

local function onCannonTouched(ctx, cannon, hit)
	if ctx.stopped or not isActive(ctx) then
		return
	end
	local player, root = playerFromHit(hit)
	if not player or isDowned(player) or cannon.pending[player] then
		return
	end
	local last = ctx.launchedAt[player]
	if last and os.clock() - last < CANNON_REARM then
		return -- already flying (or just landed on another pad)
	end
	if root.Position.Y < cannon.part.Position.Y then
		return -- only standing on the pad arms it
	end
	cannon.pending[player] = true
	task.spawn(function()
		local ok, err = pcall(runCannonLaunch, ctx, cannon, player)
		if not ok then
			cannon.pending[player] = nil
			if not warned.Cannon then
				warned.Cannon = true
				warn("[HazardService] cannon launch failed: " .. tostring(err))
			end
		end
	end)
end

local function attachCloudCannon(ctx, part)
	local target = attrVector3(part, "Target", nil)
	if not target then
		-- no landing point authored: lob the player a little way ahead of the pad
		local ahead = flatUnit(part.CFrame.LookVector, Vector3.new(0, 0, 1))
		target = part.Position + ahead * 30 + Vector3.new(0, 6, 0)
	end
	local cannon = {
		part = part,
		target = target,
		flight = Util.Clamp(attrNumber(part, "FlightTime", CANNON_DEFAULT_FLIGHT), 0.4, 4),
		baseSize = part.Size,
		pending = {}, -- player -> true while charging
		charging = 0,
		tween = nil,
		puff = nil,
		sparks = nil,
	}
	cannon.puff = newPuffEmitter({ Name = "CannonPoof" })
	cannon.puff.Parent = part
	cannon.sparks = newEmitter({
		Name = "CannonSparks",
		Rate = 0,
		Color = ColorSequence.new(PAL.Sparkle, PAL.PuffLight),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(8, 18),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(60, 60),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Acceleration = Vector3.new(0, -16, 0),
	})
	cannon.sparks.Parent = part
	connect(ctx, part.Touched, function(hit)
		onCannonTouched(ctx, cannon, hit)
	end)
	onStop(ctx, function()
		if cannon.tween then
			cannon.tween:Cancel()
		end
		if part.Parent then
			part.Size = cannon.baseSize
		end
		cannon.pending = {}
	end)
end

----------------------------------------------------------------------
-- Behaviour: VanishCloud
--   Touched from above -> blinks for VanishDelay, fades and turns non-solid, comes back after
--   ReturnDelay. The timers always complete (even while paused) so a cloud is never stuck gone.
----------------------------------------------------------------------
local function runVanish(ctx, cloud)
	cloud.state = "pending"
	-- crumble warning: a quick blink
	local elapsed = 0
	local dim = false
	while elapsed < cloud.delay do
		if ctx.stopped then
			return
		end
		dim = not dim
		local step = math.min(0.15, cloud.delay - elapsed)
		if dim then
			fadeSet(cloud.set, 0.4, step)
		else
			fadeSet(cloud.set, 0, step)
		end
		task.wait(step)
		elapsed = elapsed + step
	end
	if ctx.stopped then
		return
	end

	cloud.state = "gone"
	collideSet(cloud.set, false)
	fadeSet(cloud.set, 1, 0.35)
	if not sleep(ctx, cloud.returnDelay) then
		return
	end

	cloud.state = "returning"
	collideSet(cloud.set, true)
	fadeSet(cloud.set, 0, 0.4)
	if not sleep(ctx, 0.45) then
		return
	end
	cloud.state = "idle"
end

local function attachVanishCloud(ctx, part)
	local cloud = {
		part = part,
		set = collectFadeSet(part),
		delay = math.max(0.1, attrNumber(part, "VanishDelay", 0.9)),
		returnDelay = math.max(0.5, attrNumber(part, "ReturnDelay", 3.5)),
		state = "idle",
	}
	connect(ctx, part.Touched, function(hit)
		if ctx.stopped or cloud.state ~= "idle" or not isActive(ctx) then
			return
		end
		local player, root = playerFromHit(hit)
		if not player then
			return
		end
		if root.Position.Y < part.Position.Y then
			return -- bumped from below/side-on at its underside: only standing on it counts
		end
		cloud.state = "pending" -- claim it before the thread starts so a second touch cannot race
		task.spawn(runVanish, ctx, cloud)
	end)
	onStop(ctx, function()
		-- leave the cloud in its pristine state in case the course is reused
		if part.Parent then
			collideSet(cloud.set, true)
			fadeSet(cloud.set, 0, 0)
		end
	end)
end

----------------------------------------------------------------------
-- Behaviour: BouncePad
----------------------------------------------------------------------
local function popPad(ctx, pad)
	local part = pad.part
	if pad.burst then
		pad.burst:Emit(10)
	end
	-- squash-and-spring: swell quickly, then settle back with an elastic overshoot
	local grow = Util.Tween(part, 0.07, { Size = pad.baseSize * 1.14 },
		Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	pad.tween = grow
	task.delay(0.07, function()
		-- a newer bounce owns the animation now, or the match is over
		if ctx.stopped or pad.tween ~= grow or not part.Parent then
			return
		end
		pad.tween = Util.Tween(part, 0.5, { Size = pad.baseSize },
			Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
	end)
end

local function onBounceTouched(ctx, pad, hit)
	if ctx.stopped then
		return
	end
	local player, root = playerFromHit(hit)
	if not player or isDowned(player) then
		return
	end
	if root.Position.Y < pad.part.Position.Y then
		return -- must land on top of the pad
	end
	local now = os.clock()
	local last = pad.lastHit[player]
	if last and now - last < BOUNCE_DEBOUNCE then
		return
	end
	pad.lastHit[player] = now
	-- keep the player's heading; when moving, rescale it to the pad's LaunchSpeed so a bounce always
	-- carries the distance the course generator validated. A standing player bounces straight up.
	local v = root.AssemblyLinearVelocity
	local h = Vector3.new(v.X, 0, v.Z)
	if pad.launchSpeed > 0 and h.Magnitude > 2 then
		h = h.Unit * pad.launchSpeed
	end
	root.AssemblyLinearVelocity = Vector3.new(h.X, pad.power, h.Z)
	popPad(ctx, pad)
end

local function attachBouncePad(ctx, part)
	local pad = {
		part = part,
		power = attrNumber(part, "Power", 90),
		launchSpeed = attrNumber(part, "LaunchSpeed", 0),
		baseSize = part.Size,
		lastHit = {},
		tween = nil,
		burst = nil,
	}
	-- one reusable sparkle puff, fired on every bounce
	local burst = newEmitter({
		Name = "BounceBurst",
		Rate = 0,
		Color = ColorSequence.new(PAL.PuffLight, PAL.Sparkle),
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(10, 22),
		EmissionDirection = Enum.NormalId.Top,
		SpreadAngle = Vector2.new(40, 40),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Acceleration = Vector3.new(0, -20, 0),
	})
	burst.Parent = part
	pad.burst = burst
	connect(ctx, part.Touched, function(hit)
		onBounceTouched(ctx, pad, hit)
	end)
	onStop(ctx, function()
		if pad.tween then
			pad.tween:Cancel()
		end
		if part.Parent then
			part.Size = pad.baseSize
		end
		pad.lastHit = {}
	end)
end

----------------------------------------------------------------------
-- Behaviour: PressurePlate + PlateBridge
----------------------------------------------------------------------
local function getGroup(ctx, id)
	local group = ctx.groups[id]
	if not group then
		group = { id = id, plates = {}, bridges = {}, shown = false, emptySince = nil }
		ctx.groups[id] = group
		table.insert(ctx.groupList, group)
	end
	return group
end

local function attachPressurePlate(ctx, part)
	local group = getGroup(ctx, attrString(part, "BridgeId", "default"))
	local extents = worldExtents(part)
	local plate = {
		part = part,
		baseCF = part.CFrame,
		baseColor = part.Color,
		pressed = false,
		-- a world-aligned box from the plate's underside to 4.5 studs above its top
		boxCF = CFrame.new(part.Position + Vector3.new(0, 2.25, 0)),
		boxSize = Vector3.new(extents.X, extents.Y + 4.5, extents.Z),
	}
	table.insert(group.plates, plate)
	ensureHeartbeat(ctx)
	onStop(ctx, function()
		if part.Parent then
			part.CFrame = plate.baseCF
			part.Color = plate.baseColor
		end
	end)
end

local function attachPlateBridge(ctx, part)
	local group = getGroup(ctx, attrString(part, "BridgeId", "default"))
	local bridge = { part = part, set = collectFadeSet(part) }
	table.insert(group.bridges, bridge)
	-- Bridges start retracted: invisible and walk-through until somebody holds a plate.
	collideSet(bridge.set, false)
	fadeSet(bridge.set, 1, 0)
	ensureHeartbeat(ctx)
end

----------------------------------------------------------------------
-- Tag dispatch
----------------------------------------------------------------------
local BEHAVIOURS = {
	[TAGS.SpinBar] = attachSpinBar,
	[TAGS.StormCloud] = attachStormCloud,
	[TAGS.LightningZone] = attachLightningZone,
	[TAGS.VanishCloud] = attachVanishCloud,
	[TAGS.MovingCloud] = attachMovingCloud,
	[TAGS.BouncePad] = attachBouncePad,
	[TAGS.PressurePlate] = attachPressurePlate,
	[TAGS.PlateBridge] = attachPlateBridge,
	[TAGS.Pendulum] = attachPendulum,
	[TAGS.WindGust] = attachWindGust,
	[TAGS.CloudCannon] = attachCloudCannon,
}

local function stopContext(ctx)
	if ctx.stopped then
		return
	end
	ctx.stopped = true -- every loop/thread checks this after each wait
	for _, conn in ipairs(ctx.connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	ctx.connections = {}
	ctx.heartbeat = nil
	for _, fn in ipairs(ctx.cleanups) do
		pcall(fn)
	end
	ctx.cleanups = {}
	for _, inst in ipairs(ctx.permanents) do
		pcall(function()
			inst:Destroy()
		end)
	end
	ctx.permanents = {}
	for part in pairs(ctx.temps) do
		pcall(function()
			part:Destroy()
		end)
	end
	ctx.temps = {}
	ctx.launchedAt = {}
	releaseContextSteering(ctx)
end

-- Start every tagged behaviour found under `container`.
-- matchHandle = { IsActive = function() -> bool }  (hazards pause while it returns false)
-- Returns stopFn: stops all loops/connections and removes runtime effects (idempotent).
function HazardService.Attach(container, matchHandle)
	if not container then
		warn("[HazardService] Attach called without a container")
		return function() end
	end
	local ctx = newContext(container, matchHandle)
	for _, inst in ipairs(container:GetDescendants()) do
		if inst:IsA("BasePart") then
			for _, tag in ipairs(CollectionService:GetTags(inst)) do
				local attach = BEHAVIOURS[tag]
				if attach then
					local ok, err = pcall(attach, ctx, inst)
					if not ok then
						warn("[HazardService] could not attach " .. tag .. " to " .. inst:GetFullName() .. ": " .. tostring(err))
					end
				end
			end
		end
	end
	return function()
		stopContext(ctx)
	end
end

-- Gives a cannon rider's steering (WalkSpeed / AutoRotate) back at once; MatchService calls it when a player
-- leaves or is detached from a match mid flight. A player without a lock is ignored.
function HazardService.ReleaseFlight(player)
	if player then
		releaseSteering(player, steerLocks[player])
	end
end

return HazardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1098">
          <Properties>
            <string name="Name">HomeBuilder</string>
            <string name="Source"><![CDATA[-- HomeBuilder (Phase 2 + 4 + 5, homeworld): builds the tycoon home of a lobby plot (ARCHITECTURE_V3.md "Phase 2 build
-- contract", "Phase 4 build contract", "Phase 5 build contract" 3.3 / 3.4 / 3.6 / 6.4). A server module: TycoonService
-- requires it and decides WHAT is built; HomeBuilder only draws.
--
-- Contract API:
--   HomeBuilder.Init(lobbyInfo)                 remembers the lobby and prepares every plot in lobbyInfo.Spots
--   HomeBuilder.PreparePlot(spotInfo)           the plot's `Home` folder (tag NC_Home) and the gate's "Claim Home"
--                                               ProximityPrompt `ClaimPrompt` (attribute SpotIndex; E, ObjectText
--                                               "Free home") plus a crafted "FREE HOME" signpost on the verge.
--                                               Idempotent; returns the Home folder.
--   HomeBuilder.SetOwner(spotInfo, player|nil)  attributes OwnerUserId / OwnerName on the Home folder, every pad and
--                                               owner-only prompt; the claim prompt + signpost only while free; the
--                                               cobble paths of the yard while owned (and the staked-out house lot
--                                               while there is no House yet)
--   HomeBuilder.SetStation(spotInfo, id, level) builds or replaces the station model `Station_<Id>` (attributes
--                                               StationId, Level, BuiltAt = workspace:GetServerTimeNow(), Kind + the
--                                               art's points / info) under the Home folder at PlotCFrame * Slot.CFrame;
--                                               level 0 removes it; the same level again is a no-op. Returns the model.
--                                               The art is chosen by the station's Kind (TycoonCatalog.Kinds) or Id.
--   HomeBuilder.SetPads(spotInfo, pads)         the buy pads `Pad_<StationId>` (Home/Pads) for TycoonCatalog.AvailablePads
--                                               entries: a slate pad with a neon plate + a pixel sign `PadSign` (icon,
--                                               name, "Lv a -> b", price or the lock reason; HomeFx hides the unsigned
--                                               ones) + ProximityPrompt `BuyPrompt` ("Buy"; "Upgrade" once built, HoldDuration 0.25,
--                                               on the Base's Attachment `PromptPoint` 3 studs over the pad's top;
--                                               attributes StationId, OwnerUserId; disabled while locked; the Prestige
--                                               pad's says "Prestige" and needs a 1.5 s hold). Pads missing from the list
--                                               are removed, unchanged pads are kept. Locked "Unlocks at Prestige" /
--                                               "Coming soon" stations show a hologram silhouette (`Ghost_<Id>`)
--                                               unless their def says Ghost = "Pad" (the Fusion Machine: pad + sign).
--   HomeBuilder.SetGarden(spotInfo, valid, open)  (TycoonService) the Garden's open beds (3 + Prestige stars, <= 12;
--                                               NOT the Garden level) and the placed keys valid = { [slot] = key }: a
--                                               new open count rebuilds the Garden (template Garden:<level>:<open>);
--                                               the GardenSpotPrompt of every OPEN EMPTY bed is enabled, the others
--                                               disabled. Remembered per plot.
--   HomeBuilder.SetTraining(spotInfo, pets)     (PetCareService, optional) pets = { [mat] = { Key, Stat, Ends } }:
--                                               attributes Busy / Key / Stat / Ends on the Training Place's Spot<i>
--   HomeBuilder.ClearPlot(spotInfo)             removes every station, pad and ghost (the paths too when nobody owns
--                                               the plot); the claim prompt stays; the remembered garden / training
--                                               state is dropped
-- Extras (nothing depends on them): GetHomeFolder(spotInfo), GetStation(spotInfo, id), GetPad(spotInfo, id),
--   GetClaimPrompt(spotInfo), BuildHome(spotInfo, home) (every station of home.Stations, others removed),
--   BuildStationModel(id, level, accent, open) -> a fresh clone at the origin (renders / tests; open = the Garden's
--   open bed count), PartCount(spotInfo), StationBuilt = Util.Signal Fire(spotInfo, stationId, model|nil),
--   Points(id, level) (local fx points), Art (the art functions, for tests).
--
-- Workspace layout (Spot_NN = spotInfo.Folder):
--   Spot_NN/ClaimGate          ClaimSign (a two-part signpost, while free); ClaimAnchor (invisible, only when the lobby
--                              has no gate part) -- the ClaimPrompt rides the Attachment ClaimPoint in the gate opening
--   Spot_NN/Home  (Folder, tag NC_Home; attributes SpotIndex, PlotCFrame, OwnerUserId, OwnerName)
--     Paths                    the yard's cobble paths (TycoonCatalog.Layout.Paths), one merged voxel layer
--     HouseLot                 stakes, a string, planks and bricks where the house will stand (owned, no House yet)
--     Station_<Id>             the station models (contract 3.6 budgets: Farm 150, Garden 95, Food Machine 55,
--                              Training Place 90, House 150, Fusion 90, Fence 90, Fountain 80, others 80; a fully
--                              built plot <= 950 with its pads):
--                              * Farm (Press1, Berry Farm, 40 levels): red-berry bushes 1-10, blue-berry bushes 11-22,
--                                a golden trellis 23-37 (oars, rope, mast), the glowing Starberry tree 38-40 in a crow's-nest
--                                tub; bug #20: the Sky-Sailor's Allotment (lifeboat hulls on a deck, the cabin under an
--                                upturned boat, propeller weathervane = element home_farm_propeller; the ship's `Bell`
--                                is tagged NC_FarmBell for the audio branch, no sound code here); the
--                                BillboardGui `FarmSign` ("Berry Farm Lv N" / "Grows berries for your pets", 70 studs);
--                                point BerryPoint (where HomeFx's berry flights start)
--                              * Garden: the fence ring with the entrance, the Food Bowl (`FoodBowl` + `BowlSign`
--                                "Food Bowl" / "Pets eat here, then poop Cloud Cash!", 40 studs; point BowlCenter),
--                                12 beds at Slot.Beds: Attachments Spot<i> (attributes Slot, Open) on the lawn; an open
--                                bed = bed + cushion + tiny roof with PromptPoint<i> -> `GardenSpotPrompt` ("Put a pet
--                                here", E, attributes Slot / OwnerUserId / StationId, MaxActivationDistance 4, no line of
--                                sight; the point 3 studs over the lawn); a closed bed = soil + Stem + Sprout + `ClosedSign` ("Prestige to open"). The
--                                lawn top is y 0.2; the interior stays clear for the roaming pets (HomeRoam)
--                              * FoodMachine (Kitchen): the glass `Hopper` part (PetCareService's FeedPrompt), the
--                                BillboardGui `MachineSign` (Title "Food Machine", Info "Berries -> XP: press E", the
--                                TextLabel `BasketLine` HomeFx rewrites); points ChuteMouth / Tray / HopperTop / BasketTop
--                              * Training (Gym): mats with Attachments Spot<i> (attribute Slot) on the `Deck`
--                              * Fusion Machine: `Swirl` (a Model HomeFx spins) and `FusionPrompt` ("Fuse", owner
--                                only); Arena Gate: `ArenaGatePrompt` ("Go to Arena", owner only, Teleport = "Arena")
--                              * Decor: Yard Fence (Perimeter, plot frame), Fountain (lanterns 4 / 6 / 8), Pet Podium
--     Pads/Pad_<StationId>     buy pads, 4 parts each (attributes StationId, OwnerUserId, NextLevel, Level, Price,
--                              Locked ("" when unlocked), Title, LevelText, Kind, BuiltAt)
--     Ghost_<Id>               hologram silhouette (the 12 biggest blocks, ForceField) of a station that unlocks later
--
-- Art (Phase 6 A1: back to the Phase 4 look, 7aa0df2): SmoothPlastic everywhere (Neon for glow, Glass for windows
-- and water, ForceField for holograms), the bright P4 palette (white castle keep, blue / terracotta stepped voxel
-- roofs, gold trim, juicy greens, cream stone), blocky voxel shapes only (no Ball / Cylinder: the "round" helpers
-- build square prisms, roofs are stepped layers); warm lanterns (Brightness <= 1.5, Range <= 16, no shadows), parts
-- < 4 studs cast no shadow; pure decor sits in sub-models tagged NC_Detail (the Low graphics setting hides them),
-- voxel clouds are tagged NC_StyleExempt. Kit.finish guards the look on every template. Each (station,
-- level) is built ONCE per server and kept as a template that is :Clone()d onto every plot. No server-side
-- animation and no Instance per coin (Replication rule): HomeFx (client) pops stations in, spins the fusion swirl,
-- poses the roaming pets, draws the coins and berries, and hides other players' pads and prompts. Texts follow the
-- World text rule (pixel-sized billboard tags, surface signs at 50 px per stud with >= 0.6 stud letters). The only
-- fonts are Theme roles. Plain Lua 5.1-compatible syntax only.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local PixelIcon = require(Shared.PixelIcon) -- (kit-b U7b) the pad signs' icons, the closed bed's star
local WorldTag = require(Shared.WorldTag) -- (kit-b world signs) the kit's stone card every home sign is drawn as
local Sign = Theme.Sign

local HomeBuilder = {}

local function loadShared(name)
	local inst = Shared:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[HomeBuilder] shared/" .. name .. " unavailable: " .. tostring(result))
	return nil
end

local Voxel = loadShared("Voxel")
local Util = loadShared("Util")
local WorldStyle = loadShared("WorldStyle")
local TycoonCatalog = nil -- resolved lazily (the economy agent's module may arrive later in a build)

local function catalog()
	if TycoonCatalog == nil then
		TycoonCatalog = loadShared("TycoonCatalog") or false
	end
	return TycoonCatalog or nil
end

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------
local MAT = Enum.Material
local HOME_TAG = "NC_Home"
local FARM_BELL_TAG = "NC_FarmBell" -- bug #20: the farm's ship bell ("calls the pets to dinner"), for the audio branch
local PROMPT_RANGE = 9 -- studs: buy pads and station prompts
-- (playtest 2026-11-28 C8 review) studs over the floor a player stands on where a pad's BuyPrompt and a Garden bed's
-- GardenSpotPrompt hang: a standing root's height (HipHeight 2 + half the root = 3, up to ~4.5 on tall avatars,
-- MatchService GROUND_REACH), so their short reaches run near-level for every avatar. On the pad's Base (0.2 up) a
-- tall avatar's root was 4.8 from the prompt even dead centre, out of the 4.3 reach.
local PROMPT_LIFT = 3
local PRESTIGE_HOLD = 1.5 -- seconds: the Prestige pad's prompt (it opens the prestige confirmation, never a quick tap)
local CLAIM_RANGE = 12
local PAD_SIGN_RANGE = 60 -- studs: pad signs (pixel tags) hide beyond this
local PAD_SIGN_LIFT = 4.2 -- studs above the pad's base where the sign's plate starts
local GHOST_PARTS = 12 -- a locked station's silhouette keeps only its biggest blocks
local SIGN_PPS = 50 -- surface signs: pixels per stud
local TAG_NAME = 24 -- px: pad sign names (World text rule: >= 22)
local TAG_INFO = 20 -- px: info lines (>= 18)
local TAG_PRICE = 22
-- (kit-b U7b) the signs' icons are PixelIcons (a station's TycoonCatalog Icon is a PixelIcon name); the emoji table went
local PAD_ICON = "house" -- a pad that names no icon

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local C = {
	Stone = rgb(208, 202, 190),
	StoneLight = rgb(226, 221, 209),
	StoneDark = rgb(160, 152, 144),
	StoneEdge = rgb(132, 124, 120),
	Marble = rgb(238, 236, 232),
	Iron = rgb(74, 82, 108),
	IronLight = rgb(118, 128, 156),
	IronDark = rgb(46, 52, 72),
	Gold = rgb(244, 198, 84),
	GoldDark = rgb(206, 154, 62),
	Copper = rgb(212, 134, 84),
	Plank = rgb(196, 146, 98),
	PlankLight = rgb(218, 170, 118),
	PlankDark = rgb(146, 102, 70),
	Bark = rgb(128, 90, 62),
	Cloud = rgb(240, 244, 252),
	CloudShade = rgb(210, 220, 240),
	Mist = rgb(190, 206, 236),
	Glass = rgb(186, 224, 250),
	Window = rgb(150, 200, 240),
	WarmWindow = rgb(255, 222, 150),
	Lamp = rgb(255, 214, 140),
	Cash = rgb(112, 204, 98),
	CashGlow = rgb(150, 236, 120),
	Leaf = rgb(98, 178, 80),
	LeafDark = rgb(70, 146, 70),
	Grass = rgb(118, 192, 92),
	Soil = rgb(122, 88, 66),
	Hedge = rgb(76, 150, 76),
	Water = rgb(92, 178, 236),
	Red = rgb(226, 92, 90),
	Rose = rgb(234, 120, 146),
	Cream = rgb(246, 236, 214),
	Navy = rgb(34, 42, 76),
	Violet = rgb(68, 60, 118),
	Crystal = rgb(120, 220, 255),
	Ink = (Theme.Colors and Theme.Colors.TextStroke) or rgb(16, 22, 50),
	Text = rgb(238, 243, 252),
	TextGold = rgb(246, 216, 132),
	TextGreen = rgb(170, 244, 140),
	TextLock = rgb(255, 176, 160),
	Ghost = rgb(120, 190, 255),
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local floor, max, min, abs, huge = math.floor, math.max, math.min, math.abs, math.huge

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function serverNow()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function newFolder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- One anchored block (Voxel.Box when the kit is there). opts: Collide, Material, Transparency, Shadow, Reflectance,
-- Touch, Query.
local function box(parent, name, cf, size, color, opts)
	opts = opts or {}
	local p
	if Voxel and Voxel.Box then
		p = Voxel.Box(nil, cf, size, color, opts.Material or MAT.SmoothPlastic)
	else
		p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = opts.Material or MAT.SmoothPlastic
	end
	p.Name = name
	p.Transparency = opts.Transparency or 0
	if opts.Reflectance then
		p.Reflectance = opts.Reflectance
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.Collide == true
	p.CanQuery = opts.Collide == true or opts.Query == true
	p.CanTouch = opts.Touch == true
	if opts.Shadow ~= nil then
		p.CastShadow = opts.Shadow == true
	else
		p.CastShadow = max(size.X, size.Y, size.Z) >= 4
	end
	p.Parent = parent
	return p
end

local function anchorPart(parent, name, cf)
	return box(parent, name, cf, Vector3.new(1, 1, 1), C.Cloud, { Transparency = 1, Shadow = false })
end

local function countParts(inst)
	if not inst then
		return 0
	end
	local n = 0
	if inst:IsA("BasePart") then
		n = 1
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

local FxSprites = require(Shared.FxSprites) -- the game's own particle sprites (kit B X1)

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	FxSprites.Apply(e, props and props.Sprite or "Sparkle") -- props.Sprite: an FxSprites role
	e.LightEmission = 0.5
	e.LightInfluence = 0
	e.Rate = 4
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(1, 2)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-40, 40)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	if props then
		for k, v in pairs(props) do
			if k ~= "Sprite" then
				e[k] = v
			end
		end
	end
	e.Parent = parent
	return e
end

local function pointLight(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- GUI helpers (World text rule; fonts only through Theme roles)
----------------------------------------------------------------------
-- (kit-b world signs, lane B; Pitch 2 item 04_world_ui, the owner's pick B "Stone tags") every home sign is the kit's
-- stone card (shared/WorldTag; NpcService's nameplate is the model for the billboards, LobbyBuilder's "THE GATES" board for
-- the surface boards): the Stone face, a mitred wood edge (the UIStroke "SignEdge", drawn outside the face), a lip along
-- the bottom in the sign's accent, the text in the kit's brown ink on the opaque face with no outline. No round corner, no
-- gradient, no navy (the rounded navy plates with a vertical gradient and a glowing edge went).
local TAG = {
	PadX = 14, -- px each side of the widest row, inside the face (the old plate's padding)
	PadTop = 6, -- over the first row
	Gap = 3, -- between rows
	PadBottom = 4, -- under the last row, over the lip
	MinW = 150, -- the face's least width
}

local function listLayout(parent, direction, gap, hAlign)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 0)
	l.Parent = parent
	return l
end

local function plainFrame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	if props then
		for k, v in pairs(props) do
			f[k] = v
		end
	end
	f.Parent = parent
	return f
end

-- Fixed-size ink text that sizes itself (tags, rows): the kit's brown ink by default, no outline (kit B U6: "no outline on
-- a panel"; it sits on the opaque stone face)
local function tagText(parent, name, text, role, size, color, order)
	return WorldTag.Text(parent, name, text, role, size, color or Sign.Text, {
		AutomaticSize = Enum.AutomaticSize.XY,
		Size = UDim2.fromOffset(0, size + 4),
		LayoutOrder = order or 0,
	})
end

-- Pixel-sized billboard (constant on-screen size) whose bottom edge sits on the adornee.
local function newTag(adornee, name, w, h, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = UDim2.fromOffset(w, h)
	gui.SizeOffset = Vector2.new(0, 0.5)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or PAD_SIGN_RANGE
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

-- the tag's stone card, the Frame "Plate" (its readers find it as gui.Plate: HomeFx lays the pad signs out by its size),
-- bottom-centred in the gui with its wood edge inside the gui; the lip in `accent`'s lip (WorldTag.LipOf, as the NPC cards).
-- tagFit sizes it once its rows are in.
local function tagPlate(gui, accent)
	local Z = WorldTag.Sizes
	local plate = plainFrame(gui, "Plate", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Z.Edge),
		Size = UDim2.fromOffset(TAG.MinW, 40),
		ZIndex = 2,
	})
	WorldTag.Block(plate, Sign.Stone, WorldTag.LipOf(accent), Sign.Wood, Z.Edge, Z.Lip)
	return plate
end

-- a label's width as it shows: its text measured in its role with Theme.Measure (capitals and the face's spare included,
-- as NpcService's card) plus its UIPadding (a Lead icon's room); a fixed box (an icon's host) its own width
local function labelW(label)
	if label.AutomaticSize == Enum.AutomaticSize.None then
		return label.Size.X.Offset
	end
	local pad = label:FindFirstChildOfClass("UIPadding")
	local padW = pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0
	local ok, v = pcall(Theme.Measure, label.Text, label:GetAttribute("FontRole") or "Body", label.TextSize)
	local w = (ok and typeof(v) == "Vector2") and v.X or 0
	if label.Text == "" then
		w = 0
	end
	return math.ceil(w) + padW
end

-- one row's size: a lone label, or a Frame whose UIListLayout lines its labels up (gap = the layout's padding)
local function rowSize(row, reserve)
	local w, h = 0, 0
	if row:IsA("TextLabel") then
		w, h = labelW(row), row.TextSize + 4
	else
		local layout = row:FindFirstChildOfClass("UIListLayout")
		local gap = layout and layout.Padding.Offset or 0
		local n = 0
		for _, c in ipairs(row:GetChildren()) do
			if c:IsA("TextLabel") then
				w = w + labelW(c) + ((n > 0) and gap or 0)
				h = max(h, c.TextSize + 4, (c.AutomaticSize == Enum.AutomaticSize.None) and c.Size.Y.Offset or 0)
				n = n + 1
			end
		end
	end
	return max(w, reserve or 0), h
end

-- lays the rows out down the stone card (centred, TAG's padding) and sizes the card to them; the gui grows when the card
-- needs more room than its design box. reserve = { [row] = px }: a line the client rewrites keeps room for its longest text
local function tagFit(gui, plate, rows, reserve)
	local Z = WorldTag.Sizes
	local widest, sizes = 0, {}
	for i, row in ipairs(rows) do
		local w, h = rowSize(row, reserve and reserve[row])
		sizes[i] = h
		widest = max(widest, w)
	end
	local y = TAG.PadTop
	for i, row in ipairs(rows) do
		row.AutomaticSize = Enum.AutomaticSize.None
		row.AnchorPoint = Vector2.new(0.5, 0)
		row.Position = UDim2.new(0.5, 0, 0, y)
		row.Size = UDim2.new(1, -2 * TAG.PadX, 0, sizes[i])
		row.ZIndex = plate.ZIndex + 1
		if row:IsA("TextLabel") then
			row.TextXAlignment = Enum.TextXAlignment.Center
		end
		y = y + sizes[i] + ((i < #rows) and TAG.Gap or 0)
	end
	local faceW = math.ceil(max(TAG.MinW, widest + 2 * TAG.PadX))
	local faceH = y + TAG.PadBottom + Z.Lip
	plate.Size = UDim2.fromOffset(faceW, faceH)
	local size = gui.Size
	gui.Size = UDim2.fromOffset(max(size.X.Offset, faceW + 2 * Z.Edge), max(size.Y.Offset, faceH + 2 * Z.Edge))
end

local function surfaceGui(part, face, name)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name or "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SIGN_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	gui.Parent = part
	return gui
end

-- a surface board's face (LobbyBuilder's "THE GATES" board): a stone card inset by its edge so the canvas keeps the
-- mitred wood edge drawn outside it, the lip `lipPx` tall in `lip`
local function boardPanel(gui, edge, lipPx, lip)
	local panel = plainFrame(gui, "Panel", {
		Position = UDim2.fromOffset(edge, edge),
		Size = UDim2.new(1, -2 * edge, 1, -2 * edge),
	})
	WorldTag.Block(panel, Sign.Stone, lip or Sign.StoneLip, Sign.Wood, edge, lipPx)
	return panel
end

-- ink text on a surface board, its box in px of the panel
local function boardText(parent, text, role, size, color, name, x, y, w, h)
	return WorldTag.Text(parent, name, text, role, size, color or Sign.Text, {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
end

local function formatCash(n)
	local TC = catalog()
	if TC and type(TC.FormatCash) == "function" then
		local ok, s = pcall(TC.FormatCash, n)
		if ok and type(s) == "string" then
			return s
		end
	end
	n = floor(tonumber(n) or 0)
	if Util and Util.Commas then
		return "$" .. Util.Commas(n)
	end
	return "$" .. tostring(n)
end


----------------------------------------------------------------------
-- The art kit (Phase 6 A1: back to the Phase 4 look, 7aa0df2): SmoothPlastic everywhere (Glass / Neon / ForceField
-- only for glass, glow and holograms), the bright P4 palette, blocky voxel shapes only (no Cylinder / Ball: the
-- "round" helpers below build square prisms and cubes, roofs are stepped voxel stacks). The material keys stay so
-- the art code reads the same; every one of them is SmoothPlastic now. The detail comes later from the Blender
-- meshes (wave 2), so this is a revert, not new Part detail.
----------------------------------------------------------------------
local PLASTIC = MAT.SmoothPlastic
local M = {
	Slate = PLASTIC,
	Cobble = PLASTIC,
	Brick = PLASTIC,
	Marble = PLASTIC,
	Planks = PLASTIC,
	Wood = PLASTIC,
	Grass = PLASTIC,
	Leafy = PLASTIC,
	Sand = PLASTIC,
	Clay = PLASTIC,
	Shingles = PLASTIC,
	Metal = PLASTIC,
	Glass = MAT.Glass,
	Neon = MAT.Neon,
	Fabric = PLASTIC,
	Force = MAT.ForceField,
	Plastic = PLASTIC,
}
-- the materials a home part may use (Kit.finish turns anything else into SmoothPlastic)
local ALLOWED_MATS = { [PLASTIC] = true, [MAT.Neon] = true, [MAT.Glass] = true, [MAT.ForceField] = true }

-- the Phase 4 palette (7aa0df2 HomeBuilder.lua:151-191 + its House / station colours; style.md 4): bright stone,
-- white castle walls, blue and terracotta roofs, gold trim, juicy greens. The old key names stay.
local K = {
	SlateDark = rgb(160, 152, 144), -- P4 StoneDark: plinths and steps
	Slate = rgb(208, 202, 190), -- P4 Stone
	SlateLight = rgb(226, 221, 209), -- P4 StoneLight
	Marble = rgb(240, 240, 246), -- P4 Castle white
	MarbleShade = rgb(212, 216, 232), -- P4 CastleShade
	Cobble = rgb(208, 202, 190),
	Brick = rgb(250, 214, 196), -- P4 VillaWall (peach)
	BrickDark = rgb(220, 120, 80), -- P4 Terracotta
	Planks = rgb(196, 146, 98),
	PlanksLight = rgb(218, 170, 118),
	PlanksDark = rgb(146, 102, 70),
	Wood = rgb(128, 90, 62), -- P4 Bark
	WoodDark = rgb(150, 100, 66), -- P4 Door
	Whitewash = rgb(252, 248, 240), -- P4 VillaTrim
	Cream = rgb(250, 238, 214), -- P4 cottage Wall
	Manor = rgb(232, 226, 240), -- P4 ManorWall
	Grass = rgb(118, 192, 92),
	GrassLight = rgb(132, 202, 98),
	Leafy = rgb(98, 178, 80),
	LeafyDark = rgb(70, 146, 70),
	LeafyTeal = rgb(104, 196, 116), -- P4 Canopy
	Soil = rgb(122, 88, 66),
	SoilDark = rgb(100, 72, 56),
	Sand = rgb(236, 214, 166),
	Roof = rgb(222, 104, 82), -- P4 Roof (terracotta)
	RoofDark = rgb(190, 82, 68), -- P4 RoofTop
	RoofBlue = rgb(88, 136, 226), -- P4 Spire
	RoofBlueLight = rgb(110, 158, 238), -- P4 Spire2
	RoofBlueDark = rgb(70, 112, 204), -- P4 SpireTop
	Shingle = rgb(86, 106, 160), -- P4 manor Slate roof
	ShingleLight = rgb(102, 124, 178),
	BarnRed = rgb(226, 92, 90),
	Gold = rgb(244, 198, 84),
	GoldBright = rgb(255, 214, 96),
	Iron = rgb(74, 82, 108),
	IronDark = rgb(46, 52, 72),
	Copper = rgb(212, 134, 84),
	Glass = rgb(186, 224, 250),
	WarmGlass = rgb(255, 222, 150),
	Shutter = rgb(98, 148, 226),
	Fabric = rgb(246, 150, 188),
	Banner = rgb(236, 88, 110),
	Lantern = rgb(255, 214, 140),
	Water = rgb(92, 178, 236),
	WaterDeep = rgb(62, 136, 212),
	BerryRed = rgb(226, 58, 94),
	BerryRed2 = rgb(240, 92, 104),
	BerryBlue = rgb(84, 120, 230),
	BerryBlue2 = rgb(118, 160, 244),
	BerryGold = rgb(255, 210, 66),
	Star = rgb(255, 222, 96),
	CloudTop = rgb(244, 247, 252),
	CloudSide = rgb(232, 238, 249),
	CloudUnder = rgb(212, 222, 241),
}
local LANTERN = K.Lantern
local DETAIL_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail"
local EXEMPT_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Exempt) or "NC_StyleExempt"
local PI = math.pi
local rad = math.rad

local Kit = {}

-- one block in a world material; collide = true makes it solid (walkable / blocking)
function Kit.p(parent, name, cf, size, color, mat, collide, extra)
	local opts = { Material = mat or M.Slate, Collide = collide == true }
	if extra then
		for k, v in pairs(extra) do
			opts[k] = v
		end
	end
	return box(parent, name, cf, size, color, opts)
end

-- a "ball" (P6 A1: a voxel cube, no round primitives) centred on pos, d studs wide
function Kit.ball(parent, name, pos, d, color, mat, collide)
	return Kit.p(parent, name, CFrame.new(pos), Vector3.new(d, d, d), color, mat, collide)
end

-- an upright "cylinder" standing on (x, y0, z): a square voxel prism d wide, h tall
function Kit.cyl(parent, name, x, y0, z, d, h, color, mat, collide)
	return Kit.p(parent, name, CFrame.new(x, y0 + h / 2, z), Vector3.new(d, h, d), color, mat, collide)
end

-- a "cylinder" along an arbitrary CFrame's X axis (pipes, door wheels, medallions): a square bar / tile
function Kit.cylAt(parent, name, cf, length, d, color, mat, collide)
	return Kit.p(parent, name, cf, Vector3.new(length, d, d), color, mat, collide)
end

-- a wedge (P6 A1: no slopes either; a block of the same size)
function Kit.wedge(parent, name, cf, size, color, mat, collide)
	return Kit.p(parent, name, cf, size, color, mat or M.Planks, collide)
end

-- a round slab of width w and height h standing on y0: a square voxel slab
function Kit.oct(parent, name, x, y0, z, w, h, color, mat, collide)
	return Kit.cyl(parent, name, x, y0, z, w, h, color, mat, collide)
end

-- a stepped voxel roof over a rectangle (the P4 look): cf = the centre of the wall tops (ridge along local X),
-- len = ridge length, span = the width it covers (local Z), rise = ridge height. Layers of blocks shrink toward
-- the ridge (light / dark alternate like P4's stepped spires); the first layer overhangs the walls. opts: Overhang,
-- EndOverhang, Ridge (a ridge cap colour), Collide, Dark (the alternate layer colour). Returns the layers.
function Kit.gable(parent, name, cf, len, span, rise, color, mat, opts)
	opts = opts or {}
	local ov = opts.Overhang or 0.6
	local eo = opts.EndOverhang or 0.4
	local n = max(2, min(5, floor(rise / 0.9 + 0.5)))
	local lh = rise / n
	local w0 = span + 2 * ov
	local layers = {}
	for i = 0, n - 1 do
		local w = w0 * (1 - i / n)
		local c = (opts.Dark and i % 2 == 1) and opts.Dark or color
		layers[#layers + 1] = Kit.p(parent, name, cf * CFrame.new(0, (i + 0.5) * lh, 0), Vector3.new(len + 2 * eo, lh, max(0.5, w)), c, mat, opts.Collide)
	end
	if opts.Ridge then
		Kit.p(parent, name .. "Ridge", cf * CFrame.new(0, rise + 0.15, 0), Vector3.new(len + 2 * eo + 0.1, 0.3, 0.5), opts.Ridge, M.Wood)
	end
	return layers
end

-- a window on a wall: cf = the window centre ON the wall surface, local -Z = outward. A wooden frame and warm glass
-- set 0.08 proud of the wall, a sill below (3 parts)
function Kit.window(parent, cf, w, h, frameColor, glassColor, opts)
	opts = opts or {}
	Kit.p(parent, "WindowFrame", cf * CFrame.new(0, 0, -0.06), Vector3.new(w + 0.3, h + 0.3, 0.12), frameColor or K.Whitewash, M.Wood)
	Kit.p(parent, "Window", cf * CFrame.new(0, 0, -0.14), Vector3.new(w, h, 0.06), glassColor or K.WarmGlass, M.Glass, false, { Transparency = opts.Transparency or 0.1, Reflectance = 0.05 })
	if opts.Sill ~= false then
		Kit.p(parent, "Sill", cf * CFrame.new(0, -h / 2 - 0.2, -0.2), Vector3.new(w + 0.5, 0.18, 0.4), opts.SillColor or K.SlateLight, M.Slate)
	end
end

-- a wall lantern / post-top lantern: a dark iron cap and a glowing warm body; light = a PointLight (no shadows)
function Kit.lantern(parent, pos, size, light, style)
	size = size or 0.6
	local cap = (style == "Brass") and K.Gold or ((style == "Crystal") and K.Marble or K.IronDark)
	local body = Kit.p(parent, "Lantern", CFrame.new(pos), Vector3.new(size, size * 1.25, size), (style == "Crystal") and rgb(200, 236, 255) or LANTERN, M.Neon)
	Kit.p(parent, "LanternCap", CFrame.new(pos + Vector3.new(0, size * 0.75, 0)), Vector3.new(size * 1.35, size * 0.25, size * 1.35), cap, (style == "Crystal") and M.Marble or M.Metal)
	if light then
		pointLight(body, (style == "Crystal") and rgb(214, 236, 255) or LANTERN, 1.2, 12)
	end
	return body
end

-- an inset corner post (6.4 rule 4: a 0.6-stud post on a corner >= 4 studs tall)
function Kit.corner(parent, x, y0, z, h, color, mat)
	return Kit.p(parent, "CornerPost", CFrame.new(x, y0 + h / 2, z), Vector3.new(0.6, h, 0.6), color or K.Whitewash, mat or M.Wood)
end

-- the four inset corner posts of a box [x0, x1] x [z0, z1]
function Kit.corners(parent, x0, x1, z0, z1, y0, h, color, mat)
	for _, x in ipairs({ x0, x1 }) do
		for _, z in ipairs({ z0, z1 }) do
			Kit.corner(parent, x, y0, z, h, color, mat)
		end
	end
end

-- a sub-model of pure decoration (tagged NC_Detail: the Low graphics setting hides it)
function Kit.detail(parent, name)
	local d = Instance.new("Model")
	d.Name = name or "Detail"
	d.Parent = parent
	CollectionService:AddTag(d, DETAIL_TAG)
	return d
end

-- deterministic +-6 RGB shade noise for repeated pieces (P4 Voxel.Shade spirit: never one flat colour)
function Kit.jit(color, seed)
	local n = ((seed or 0) * 7919 + 13) % 13 - 6
	local function ch(v)
		return max(0, min(255, floor(v * 255 + 0.5) + n))
	end
	return Color3.fromRGB(ch(color.R), ch(color.G), ch(color.B))
end

-- a pixel billboard sign (World text rule): a title line and info lines on a stone card (kit-b world signs: the title
-- in the brown ink, the info lines in the muted ink, the lip in `accent`'s lip); returns gui, labels. info.Reserve: a text
-- as long as the longest the client will write on that line (HomeFx's basket line), the card keeps room for it
function Kit.sign(adornee, name, lift, title, infos, maxDistance, accent)
	local gui = newTag(adornee, name, 360, 120, maxDistance or 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift or 3, 0)
	local plate = tagPlate(gui, accent or Sign.Gold)
	local labels, rows, reserve = {}, {}, {}
	labels.Title = tagText(plate, "Title", title, "Title", TAG_NAME, Sign.Text, 1)
	rows[1] = labels.Title
	for i, info in ipairs(infos or {}) do
		local key = info.Name or ("Info" .. i)
		local label = tagText(plate, key, info.Text, "Body", TAG_INFO, info.Color or Sign.TextMuted, i + 1)
		if info.Reserve then
			reserve[label] = math.ceil(Theme.Measure(info.Reserve, "Body", TAG_INFO).X)
		end
		labels[key] = label
		rows[#rows + 1] = label
	end
	tagFit(gui, plate, rows, reserve)
	return gui, labels
end

----------------------------------------------------------------------
-- The style finish (a guard after every template, Phase 6 A1): every visible part is SmoothPlastic unless it is
-- Glass / Neon / ForceField, every Part is a Block (no Ball / Cylinder), Reflectance 0; parts < 4 studs cast no
-- shadow. Voxel clouds / pets / tokens (NC_StyleExempt) are skipped.
----------------------------------------------------------------------
local function exemptPart(p, root)
	local cur = p
	while cur and cur ~= root.Parent do
		if CollectionService:HasTag(cur, EXEMPT_TAG) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

function Kit.finish(root)
	for _, p in ipairs(root:GetDescendants()) do
		if p:IsA("BasePart") then
			local s = p.Size
			if max(s.X, s.Y, s.Z) < 4 then
				p.CastShadow = false
			end
			if not exemptPart(p, root) then
				if not ALLOWED_MATS[p.Material] then
					p.Material = PLASTIC
				end
				if p:IsA("Part") and p.Shape ~= Enum.PartType.Block then
					p.Shape = Enum.PartType.Block
				end
				if p.Material ~= MAT.Glass then
					p.Reflectance = 0
				end
			end
		end
	end
end
----------------------------------------------------------------------
-- Templates: every (station, level) is built once per server and cloned onto the plots. A template is
-- { Model = Model at the origin (front = -Z, ground = y 0), Points = { name = local Vector3 }, Info = {...} }.
----------------------------------------------------------------------
local templates = {}

local function newTemplate(name)
	local m = Instance.new("Model")
	m.Name = name
	return { Model = m, Points = {}, Info = {} }
end

-- clones a template model to `cf` (every part moved by cf), returns the clone (unparented)
local function cloneAt(tpl, cf)
	local m = tpl.Model:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	pcall(function()
		m.WorldPivot = cf
	end)
	return m
end

-- moves every child of `from` into `to` (merging sculpts into one model)
local function absorb(to, from)
	for _, c in ipairs(from:GetChildren()) do
		c.Parent = to
	end
	from:Destroy()
end

local function biggestPart(model, nameFilter)
	local best, bestVol = nil, -1
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 1 and (not nameFilter or p.Name == nameFilter) then
			local v = p.Size.X * p.Size.Y * p.Size.Z
			if v > bestVol then
				best, bestVol = p, v
			end
		end
	end
	return best
end

local function attach(part, name, localPos, attrs)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = part.CFrame:Inverse() * CFrame.new(localPos)
	if attrs then
		for k, v in pairs(attrs) do
			a:SetAttribute(k, v)
		end
	end
	a.Parent = part
	return a
end

local function newPrompt(name, action, object, stationId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("StationId", stationId)
	return prompt
end

----------------------------------------------------------------------
-- ART: stations. Each Art.<Kind>(def, level) returns a template.
----------------------------------------------------------------------
local Art = {}

----------------------------------------------------------------------
-- Berry Farm (Press1, Kind Farm, 40 levels; contract 3.6; bug #20 option B "Sky-Sailor's Allotment"): when the old
-- cloud-ship retired, her crew hauled three lifeboats onto the island, filled them with soil and laid the ship's deck
-- under them. Front -Z toward the lane, local +X = the north end. On a plank deck: three planked lifeboat hulls step up
-- toward the back (the front one grows red-berry bushes, one per level 1-10; the middle one blue (11-22); the back one
-- a gold vine per level (23-37) up the oars stuck blade-up in it, with a rope between them and the ship's old mast and
-- rigging in the middle), and the Starberry tree (38-40) in the old crow's-nest tub at the north end. At the south end
-- the crew's cabin: white planks, navy corners and door, two brass portholes, an upturned lifeboat as its roof (red
-- bottom paint up, a keel ridge) with a propeller weathervane, the ship's bell by the door (it calls the pets to
-- dinner), the farm sign, sea-chest crates of berries, the painted anchor and its coiled mooring rope.
-- The Part build is the collider and the fallback: boxes only (P6 A1). The Blender bake (blender/kit/props/
-- home_style.py, style "allotment") turns these boxes into the round hulls, domed bushes with hanging berry clusters,
-- blade-up oars, the boat roof, the bell and the anchor; the Propeller is its own spinning element key
-- (home_farm_propeller, HomeFx spins it). The plant layout (Farm.ROWS, sizes, Farm.age) is the game's own. <= 150
-- parts (L40 147).
----------------------------------------------------------------------
local Farm = {}
Farm.X0, Farm.X1 = -10.8, 13.2 -- the planted span (local x); the hulls run 0.3 past it at each end
Farm.ROWS = { { Z = -2.25, Top = 0.75 }, { Z = 0.0, Top = 1.15 }, { Z = 2.25, Top = 1.55 } } -- soil tops
Farm.RED, Farm.BLUE, Farm.VINES = 10, 12, 15 -- plants per row (levels 1-10, 11-22, 23-37)
Farm.TREE_X = 15.7
Farm.DECK = 0.3 -- the deck top
Farm.SHED = { X = -15.6, Z = 0.6, W = 4.8, D = 5.4, H = 3.2 } -- the crew's cabin (walls)
Farm.TUB_TOP = 1.25 -- the soil in the crow's-nest tub (the tree stands on it)
-- the allotment palette (pitch B): ship's timber, navy trim, sailcloth white, brass, red bottom paint, deck, rope
Farm.C = {
	Hull = rgb(193, 138, 93),
	HullDark = rgb(170, 118, 78),
	Navy = rgb(70, 130, 180),
	Sail = rgb(242, 240, 230),
	Brass = rgb(230, 197, 92),
	Anti = rgb(196, 70, 64),
	Deck = rgb(214, 178, 128),
	Rope = rgb(222, 204, 158),
	Anchor = rgb(58, 74, 112),
	Chest = rgb(196, 150, 98),
	Porthole = rgb(150, 210, 240),
}

-- how grown a plant planted at level `at` is at `level` (0 = just planted .. 1 = full)
function Farm.age(level, at, span)
	return max(0, min(1, (level - at) / (span or 6)))
end

-- a berry bush: a leafy box a little wider than tall seated on its soil (the bake rounds it into a dome) with its
-- berries hanging on the yard side, under the leaves (the bake hangs them as clusters on stalks)
function Farm.bush(parent, x, row, d, berry, berry2, n, seed)
	local r = Farm.ROWS[row]
	local h = d * 0.78
	local cy = r.Top + h / 2 - 0.06
	Kit.p(parent, "Bush", CFrame.new(x, cy, r.Z), Vector3.new(d, h, d), Kit.jit(row == 1 and K.Leafy or K.LeafyDark, seed), M.Leafy)
	local spots = { { -0.28, -0.08 }, { 0.26, 0.1 }, { 0.04, -0.28 } }
	for k = 1, n do
		local o = spots[k]
		Kit.ball(parent, "Berry", Vector3.new(x + o[1] * d, cy + o[2] * h, r.Z - d * 0.42), 0.42 + 0.04 * k, (k % 2 == 0) and berry2 or berry, M.Plastic)
	end
end

function Art.Farm(def, level)
	local tpl = newTemplate("BerryFarm")
	local m = tpl.Model
	local FC = Farm.C
	level = max(1, min(floor(level), (def and def.MaxLevel) or 40))
	local x0, x1 = Farm.X0, Farm.X1
	local len = x1 - x0
	local cx = (x0 + x1) / 2
	local y0 = Farm.DECK
	-- the ship's deck under the whole allotment (walkable)
	Kit.p(m, "ShipDeck", CFrame.new(-0.15, y0 / 2, 0), Vector3.new(36.3, y0, 7.0), FC.Deck, M.Planks, true)
	-- three lifeboat hulls stepping up toward the back, each filled with soil (grass while its row is not planted)
	local hx0, hx1 = x0 - 0.3, x1 + 0.3
	for i, r in ipairs(Farm.ROWS) do
		local planted = (i == 1) or (i == 2 and level > Farm.RED) or (i == 3 and level > Farm.RED + Farm.BLUE)
		local hullTop = r.Top - 0.06
		Kit.p(m, "Hull", CFrame.new((hx0 + hx1) / 2, (y0 + hullTop) / 2, r.Z), Vector3.new(hx1 - hx0, hullTop - y0, 2.15),
			Kit.jit(FC.Hull, i), M.Planks, true)
		Kit.p(m, planted and "Soil" or "Grass", CFrame.new(cx, r.Top - 0.15, r.Z), Vector3.new(len, 0.3, 1.6),
			planted and Kit.jit(K.Soil, i) or K.Grass, planted and M.Sand or M.Grass, true)
	end
	-- the old crow's-nest tub at the north end (the Starberry tree grows in it at 38-40)
	Kit.p(m, "Tub", CFrame.new(Farm.TREE_X, (y0 + 1.4) / 2, 0), Vector3.new(3.2, 1.4 - y0, 3.2), FC.HullDark, M.Planks, true)
	-- row 1: red berries (levels 1-10)
	local span = len - 1.2
	for i = 1, min(level, Farm.RED) do
		local x = x0 + 0.6 + (i - 0.5) * span / Farm.RED
		local g = Farm.age(level, i, 6)
		Farm.bush(m, x, 1, 1.45 + 0.5 * g, K.BerryRed, K.BerryRed2, (g >= 0.5) and 2 or 1, i)
	end
	-- row 2: blue berries (levels 11-22)
	for i = 1, min(level - Farm.RED, Farm.BLUE) do
		local x = x0 + 0.6 + (i - 0.5) * span / Farm.BLUE
		local g = Farm.age(level, Farm.RED + i, 6)
		Farm.bush(m, x, 2, 1.35 + 0.45 * g, K.BerryBlue, K.BerryBlue2, (g >= 0.5) and 2 or 1, 20 + i)
	end
	-- row 3 (levels 23-37): six oars stuck blade-up in the back hull with a rope between them, the ship's old mast
	-- (yard arm, rigging down to the end oars) in the middle, then one vine with gold berries per level
	local vines = min(level - Farm.RED - Farm.BLUE, Farm.VINES)
	if vines > 0 then
		local r = Farm.ROWS[3]
		local oz = r.Z + 0.35
		for k = 0, 5 do
			local px = x0 + 0.5 + k * (len - 1.0) / 5
			Kit.p(m, "Oar", CFrame.new(px, r.Top + 1.75, oz), Vector3.new(0.3, 3.5, 0.3), FC.HullDark, M.Wood)
		end
		Kit.p(m, "Rope", CFrame.new(cx, r.Top + 2.35, oz), Vector3.new(len - 1.0, 0.18, 0.18), FC.Rope, M.Fabric)
		local mz = r.Z + 0.75
		Kit.p(m, "Mast", CFrame.new(cx, r.Top + 3.5, mz), Vector3.new(0.5, 7.0, 0.5), FC.Hull, M.Wood)
		Kit.p(m, "Yard", CFrame.new(cx, r.Top + 5.8, mz - 0.375), Vector3.new(4.0, 0.25, 0.25), FC.HullDark, M.Wood)
		for _, ex in ipairs({ x0 + 0.5, x1 - 0.5 }) do
			local a = Vector3.new(cx, r.Top + 6.6, mz)
			local b = Vector3.new(ex, r.Top + 2.35, oz)
			Kit.p(m, "Rigging", CFrame.lookAt((a + b) / 2, b), Vector3.new(0.12, 0.12, (b - a).Magnitude), FC.Rope, M.Fabric)
		end
		local vspan = len - 1.4
		for j = 1, vines do
			local x = x0 + 0.7 + (j - 0.5) * vspan / Farm.VINES
			local g = Farm.age(level, Farm.RED + Farm.BLUE + j, 5)
			local h = ((j % 2 == 0) and 1.7 or 2.2) + 1.0 * g
			Kit.p(m, "Vine", CFrame.new(x, r.Top + h / 2, r.Z + 0.1), Vector3.new(0.85, h, 0.45), Kit.jit((j % 2 == 0) and K.Leafy or K.LeafyDark, 40 + j), M.Leafy)
			Kit.ball(m, "GoldBerry", Vector3.new(x + ((j % 2 == 0) and 0.25 or -0.25), r.Top + h * 0.62, r.Z - 0.3), 0.5 + 0.12 * g, K.BerryGold, M.Metal)
		end
	end
	-- a young sapling in the tub foreshadows the Starberry tree (30-37)
	local ty = Farm.TUB_TOP
	if level >= 30 and level < 38 then
		Kit.cyl(m, "Sapling", Farm.TREE_X, ty, 0, 0.35, 1.6, K.Wood, M.Wood)
		Kit.ball(m, "SaplingLeaves", Vector3.new(Farm.TREE_X, ty + 1.9, 0), 1.5, K.LeafyTeal, M.Leafy)
	end
	-- the Starberry tree (levels 38-40): a trunk, a teal crown of three puffs and glowing star fruit
	if level >= 38 then
		local t = level - 37 -- 1..3
		local trunkH = 2.6 + 0.7 * t
		local crown = 3.0 + 0.55 * t
		local tx = Farm.TREE_X
		Kit.cyl(m, "Trunk", tx, ty, 0, 0.9, trunkH, K.Wood, M.Wood)
		local cy = ty + trunkH + crown * 0.3
		Kit.ball(m, "Crown", Vector3.new(tx, cy, 0), crown, K.LeafyTeal, M.Leafy)
		Kit.ball(m, "Crown", Vector3.new(tx - crown * 0.32, cy - crown * 0.22, -0.3), crown * 0.66, Kit.jit(K.LeafyTeal, 7), M.Leafy)
		Kit.ball(m, "Crown", Vector3.new(tx + crown * 0.32, cy - crown * 0.18, 0.3), crown * 0.62, Kit.jit(K.LeafyTeal, 9), M.Leafy)
		local stars = { { -0.35, -0.05, -0.5 }, { 0.3, 0.2, -0.48 }, { 0.0, 0.42, -0.36 }, { 0.42, -0.25, -0.3 } }
		for k = 1, min(#stars, t + 1) do
			local o = stars[k]
			local sp = Kit.p(m, "Starberry", CFrame.new(tx + o[1] * crown, cy + o[2] * crown, o[3] * crown) * CFrame.Angles(rad(45), rad(30), rad(45)),
				Vector3.new(0.55, 0.55, 0.55), K.Star, M.Neon)
			if k == 1 and t >= 3 then
				pointLight(sp, LANTERN, 1.2, 12)
				local att = Instance.new("Attachment")
				att.Name = "Sparkle"
				att.Parent = sp
				emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
			end
		end
	end
	-- the crew's cabin at the south end (its door faces the lane)
	local S = Farm.SHED
	local bx, bz, bw, bd, bh = S.X, S.Z, S.W, S.D, S.H
	local front = bz - bd / 2
	Kit.p(m, "Cabin", CFrame.new(bx, y0 + bh / 2, bz), Vector3.new(bw, bh, bd), FC.Sail, M.Planks, true)
	for _, sx in ipairs({ -1, 1 }) do -- slim navy corner posts (white plank walls between them)
		Kit.p(m, "CornerPost", CFrame.new(bx + sx * (bw / 2 - 0.12), y0 + bh / 2, front + 0.12), Vector3.new(0.36, bh, 0.36), FC.Navy, M.Wood)
	end
	-- the roof: the ship's lifeboat turned upside down (keel along the cabin, front to back), red bottom paint up
	local ry = y0 + bh
	Kit.p(m, "HullRoof", CFrame.new(bx, ry + 0.45, bz), Vector3.new(bw + 1.2, 1.1, bd + 1.2), FC.Hull, M.Planks)
	Kit.p(m, "HullRoof", CFrame.new(bx, ry + 1.35, bz), Vector3.new(bw - 1.0, 0.9, bd + 0.9), FC.Anti, M.Planks)
	Kit.p(m, "Keel", CFrame.new(bx, ry + 1.95, bz), Vector3.new(0.35, 0.3, bd + 1.4), FC.HullDark, M.Wood)
	-- the propeller weathervane on the keel (HomeFx spins the Propeller: its own element key, home_farm_propeller)
	Kit.p(m, "VanePost", CFrame.new(bx, ry + 2.6, bz), Vector3.new(0.2, 1.0, 0.2), FC.HullDark, M.Wood)
	Kit.p(m, "Propeller", CFrame.new(bx, ry + 2.85, bz - 0.25), Vector3.new(1.9, 0.3, 0.15), FC.Navy, M.Wood)
	-- the navy door, the sign board over it, two brass portholes on the field side, the ship's bell by the door
	Kit.p(m, "Door", CFrame.new(bx, y0 + 1.15, front - 0.06), Vector3.new(1.8, 2.3, 0.14), FC.Navy, M.Wood)
	local sign = Kit.p(m, "SignBoard", CFrame.new(bx, y0 + 2.75, front - 0.1), Vector3.new(2.8, 0.55, 0.12), K.Whitewash, M.Wood)
	for _, pz in ipairs({ bz - 0.9, bz + 1.1 }) do
		Kit.p(m, "Porthole", CFrame.new(bx + bw / 2 + 0.02, y0 + 2.0, pz), Vector3.new(0.12, 0.8, 0.8), FC.Porthole, M.Glass, false,
			{ Transparency = 0.25 })
	end
	local bell = Kit.p(m, "Bell", CFrame.new(bx + 1.6, y0 + 2.05, front - 0.38), Vector3.new(0.75, 0.8, 0.75), FC.Brass, M.Metal)
	CollectionService:AddTag(bell, FARM_BELL_TAG) -- the audio branch rings it (no sound code here); clones keep the tag
	if level >= 10 then
		Kit.lantern(m, Vector3.new(bx - 1.7, y0 + 2.55, front - 0.35), 0.45, true)
	end
	-- the painted anchor leaning on the wall under the lantern, its coiled mooring rope at its foot
	Kit.p(m, "Anchor", CFrame.new(bx - 1.43, y0 + 0.95, front - 0.25) * CFrame.Angles(rad(8), 0, 0), Vector3.new(1.0, 1.9, 0.25), FC.Anchor, M.Metal)
	Kit.p(m, "RopeCoil", CFrame.new(bx - 1.3, y0 + 0.15, front - 0.95), Vector3.new(0.95, 0.3, 0.95), FC.Rope, M.Fabric)
	-- sea-chest crates of berries by the cabin (pure decor)
	local d = Kit.detail(m, "Crates")
	local crates = { { -12.25, y0 + 0.55, -0.9, K.BerryRed }, { -12.25, y0 + 0.55, 0.4, K.BerryBlue }, { -12.25, y0 + 1.65, -0.25, K.BerryGold } }
	local nCrates = (level >= 23) and 3 or ((level >= 11) and 2 or 1)
	for i = 1, nCrates do
		local c = crates[i]
		Kit.p(d, "Crate", CFrame.new(c[1], c[2], c[3]) * CFrame.Angles(0, rad((i - 2) * 6), 0), Vector3.new(1.15, 1.1, 1.15), Kit.jit(FC.Chest, i), M.Planks)
		Kit.p(d, "CrateBerries", CFrame.new(c[1], c[2] + 0.6, c[3]) * CFrame.Angles(0, rad((i - 2) * 6), 0), Vector3.new(0.95, 0.18, 0.95), c[4], M.Plastic)
	end
	-- the farm sign (World text rule, MaxDistance 70)
	Kit.sign(sign, "FarmSign", 4.2, "Berry Farm Lv " .. level, { { Name = "Info", Text = "Grows berries for your pets" } }, 70, Sign.Grass)
	-- where HomeFx's berry flights start: the top of the planted rows, in the middle of the field
	local topRow = (vines > 0) and 3 or ((level > Farm.RED) and 2 or 1)
	tpl.Points.BerryPoint = Vector3.new(cx, Farm.ROWS[topRow].Top + 2.2, Farm.ROWS[topRow].Z)
	tpl.Info.Rows = topRow
	return tpl
end

----------------------------------------------------------------------
-- Pet Garden (Kind Garden; contract 3.3 / 3.6): front -Z = the entrance (Slot.Entrance, 4 wide) toward its pad. A
-- grass lawn inside a fence ring on the footprint edge (Slot.Fence 0.6: a cobble kerb, posts and a wooden rail),
-- the Food Bowl in the middle (Slot.Bowl, filled with berries; its "Food Bowl" sign) and 12 beds (Slot.Beds):
-- an OPEN bed = a wooden bed with a cushion under a tiny lean-to roof (Attachment Spot<i>, and a PromptPoint<i> with
-- the owner-only GardenSpotPrompt on its yard side), a CLOSED bed = a soil bed with a seedling (Stem + Sprout) and a
-- "Prestige to open" sign. The interior stays clear for the roaming pets (HomeRoam): every level's decor sits on the
-- fence (flower strips, the entrance arch, lanterns, bunting, gold rails at 8). The lawn top is y 0.2. <= 95 parts.
----------------------------------------------------------------------
local Garden = {}

-- studs (contract 3.6). (playtest 2026-11-28 C8) was 3: the reach is measured from the root part, ~1.7 studs over
-- the prompt point, so 3 reached only ~2.5 studs across the lawn and the guide's stop at the bed (3.3) was out of it.
-- 4 reaches ~3.6 across; the middle of the lawn stays clear of the side beds (7.4 studs from their prompts).
-- (C8 review) the prompt point now hangs PROMPT_LIFT over the lawn (root height): 4 reaches >= 3.7 across for a
-- root 3 to 4.5 studs up (it was 2.4 for a 4.5-stud root from 1.5 up).
Garden.PROMPT_RANGE = 4
Garden.CUSHION_TOP = 0.95
Garden.LAWN_TOP = 0.2
Garden.CUSHIONS = { rgb(246, 150, 188), rgb(150, 224, 176), rgb(130, 170, 255), rgb(250, 214, 92) }

function Garden.places(def)
	return (def and def.Slot and type(def.Slot.Beds) == "table") and def.Slot.Beds or {}
end

function Garden.defaultOpen()
	local cat = catalog()
	local p = cat and type(cat.Prestige) == "table" and cat.Prestige or nil
	return (p and tonumber(p.GardenSlotsBase)) or 3
end

function Garden.clampOpen(open, places)
	open = tonumber(open)
	if not open or open ~= open then
		open = Garden.defaultOpen()
	end
	return max(0, min(floor(open), places))
end

-- the bed's frame: at the bed centre on the lawn, local -Z = toward the garden's interior, +Z = the fence behind it
function Garden.bedFrame(def, v)
	local hx = ((def.Slot.Footprint and def.Slot.Footprint.X) or 22) / 2
	local out
	if abs(v.X) >= hx - 3 then
		out = Vector3.new((v.X > 0) and 1 or -1, 0, 0)
	else
		out = Vector3.new(0, 0, 1)
	end
	local pos = Vector3.new(v.X, Garden.LAWN_TOP, v.Z)
	return CFrame.lookAt(pos, pos - out)
end

-- the prompt point of bed i (station frame): on the bed's interior side, PROMPT_LIFT over the lawn (a standing
-- root's height; (C8 review) it was 1.3, half a stud over the cushion)
function Garden.promptPoint(def, i)
	local v = Garden.places(def)[i]
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local size = def.Slot.BedSize or 2.5
	return (Garden.bedFrame(def, v) * CFrame.new(0, PROMPT_LIFT, -(size / 2 + 0.35))).Position
end

-- the "Prestige to open" sign of a closed bed (World text rule: 50 px per stud, letters 0.6 stud). (kit-b world signs) a
-- stone card on the 170 x 80 px canvas (the board 3.4 x 1.6 studs), inset by its 3 px wood edge (164 x 74), a 4 px lip in
-- the Prestige violet, so 70 px of face over the lip. Everything keeps Pad px off the wood edge and the lip: the star
-- (54 px, low on the face: its arm row clears the title's "P") and "Prestige" (120 px of FredokaOne at 30 px) need 174 px side by side, so they share a
-- corner: the two 30 px lines sit right-aligned and the star's wide arm row runs between them, its narrow top beside the
-- title's first letter. (Review: the 1.4 stud board left the star flush on the edge and "to open" on the lip.)
-- (world text rule: the sign's biggest mark >= 0.95 stud) the star is a 9-cell PixelIcon, so it draws in whole 6 px
-- cells at 54 px (1.08 stud; 46 px drew as 45 px = 0.90 stud); the board is 1.6 studs tall so its wide arm row sits
-- below the "Prestige" line and the star keeps Pad px off the lip
Garden.CLOSED = { Edge = 3, Lip = 4, Pad = 4, Board = Vector3.new(3.4, 1.6, 0.15), Star = 54, StarY = 12, TextX = 40, TextW = 120, LineH = 30, TitleY = 2, InfoY = 33 }
function Garden.closedSign(parent, bedCF, size)
	local Q = Garden.CLOSED
	local board = Kit.p(parent, "ClosedSign", bedCF * CFrame.new(0, 0.95, -(size / 2 + 0.05)), Q.Board, K.PlanksLight, M.Planks)
	local gui = surfaceGui(board, Enum.NormalId.Front, "ClosedGui")
	local panel = boardPanel(gui, Q.Edge, Q.Lip, Sign.VioletLip)
	-- (kit-b U7b) the star is a 54 px PixelIcon (1.08 stud: the sign's biggest mark), in its own colours
	PixelIcon.Host(boardText(panel, "", "Heading", 48, Sign.GoldLip, "Star", Q.Pad, Q.StarY, Q.Star, Q.Star), "star", Q.Star)
	local title = boardText(panel, "Prestige", "Heading", 30, Sign.Text, "Title", Q.TextX, Q.TitleY, Q.TextW, Q.LineH)
	local info = boardText(panel, "to open", "Heading", 30, Sign.TextMuted, "Info", Q.TextX, Q.InfoY, Q.TextW, Q.LineH)
	title.TextXAlignment = Enum.TextXAlignment.Right
	info.TextXAlignment = Enum.TextXAlignment.Right
	return board
end

function Art.Garden(def, level, open)
	local tpl = newTemplate("Garden")
	local m = tpl.Model
	local slot = def.Slot
	local fp = slot.Footprint or Vector3.new(22, 4, 20)
	local hx, hz = fp.X / 2, fp.Z / 2
	local t = slot.Fence or 0.6
	local beds = Garden.places(def)
	local size = slot.BedSize or 2.5
	open = Garden.clampOpen(open, #beds)
	local ent = slot.Entrance or { Center = Vector3.new(0, 0, -hz), Width = 4 }
	local g0, g1 = ent.Center.X - ent.Width / 2, ent.Center.X + ent.Width / 2
	local gold = level >= 8
	-- the lawn
	local lawn = Kit.p(m, "Lawn", CFrame.new(0, Garden.LAWN_TOP / 2, 0), Vector3.new(fp.X, Garden.LAWN_TOP, fp.Z), K.GrassLight, M.Grass, true)
	-- the fence ring: kerb runs (the sides between the front and back runs), a rail on posts
	local kh, railY = 0.7, 1.55
	local runs = {
		{ "Back", 0, hz - t / 2, fp.X, t },
		{ "Left", -hx + t / 2, 0, t, fp.Z - 2 * t },
		{ "Right", hx - t / 2, 0, t, fp.Z - 2 * t },
		{ "FrontL", (-hx + g0) / 2, -hz + t / 2, g0 + hx, t },
		{ "FrontR", (g1 + hx) / 2, -hz + t / 2, hx - g1, t },
	}
	local railColor = gold and K.Gold or K.Planks
	local railMat = gold and M.Metal or M.Planks
	for i, r in ipairs(runs) do
		Kit.p(m, "Kerb", CFrame.new(r[2], Garden.LAWN_TOP + kh / 2, r[3]), Vector3.new(r[4], kh, r[5]), Kit.jit(K.Cobble, i), M.Cobble, true)
		Kit.p(m, "Rail", CFrame.new(r[2], railY, r[3]), Vector3.new(r[4], 0.22, r[5] * 0.6), railColor, railMat, true)
	end
	local postH = 1.85
	local posts = {
		{ -hx + t / 2, -hz + t / 2 }, { hx - t / 2, -hz + t / 2 }, { -hx + t / 2, hz - t / 2 }, { hx - t / 2, hz - t / 2 },
		{ -hx + t / 2, 0 }, { hx - t / 2, 0 }, { 0, hz - t / 2 },
	}
	for i, p in ipairs(posts) do
		Kit.p(m, "Post", CFrame.new(p[1], postH / 2, p[2]), Vector3.new(0.72, postH, 0.72), Kit.jit(K.Wood, 30 + i), M.Wood, true)
	end
	-- the entrance posts (taller from level 3: they carry the arch)
	local arch = level >= 3
	local eh = arch and 3.9 or postH + 0.2
	for _, x in ipairs({ g0 - 0.45, g1 + 0.45 }) do
		Kit.p(m, "EntrancePost", CFrame.new(x, eh / 2, -hz + t / 2), Vector3.new(0.75, eh, 0.75), K.Wood, M.Wood, true)
	end
	-- a cobble walk from the entrance to the bowl (flush with the lawn: pets and players walk over it)
	local walkZ0, walkZ1 = -hz + t, (slot.Bowl and (slot.Bowl.Center.Z - slot.Bowl.Radius) or -2.5) + 0.2
	Kit.p(m, "Walk", CFrame.new(ent.Center.X, Garden.LAWN_TOP + 0.03, (walkZ0 + walkZ1) / 2), Vector3.new(ent.Width - 0.6, 0.06, walkZ1 - walkZ0), K.Cobble, M.Cobble, true)
	-- the Food Bowl: a slate basin with a marble rim, full of berries
	local bowl = slot.Bowl or { Center = Vector3.new(0, 0, 0), Radius = 2.5 }
	local bc, br = bowl.Center, bowl.Radius
	local basin = Kit.cyl(m, "FoodBowl", bc.X, Garden.LAWN_TOP, bc.Z, 2 * br, 0.55, K.Slate, M.Slate, true)
	Kit.cyl(m, "BowlRim", bc.X, Garden.LAWN_TOP + 0.55, bc.Z, 2 * br + 0.2, 0.18, K.Marble, M.Marble, true)
	Kit.cyl(m, "BowlBerries", bc.X, Garden.LAWN_TOP + 0.73, bc.Z, 2 * br - 0.8, 0.16, rgb(226, 58, 94), M.Sand)
	local heap = { { -0.55, 0.1, K.BerryRed2 }, { 0.5, -0.3, K.BerryBlue } }
	for _, h in ipairs(heap) do
		Kit.ball(m, "BowlBerry", Vector3.new(bc.X + h[1], Garden.LAWN_TOP + 1.05, bc.Z + h[2]), 0.85, h[3], M.Plastic)
	end
	Kit.sign(basin, "BowlSign", 3.4, "Food Bowl", { { Name = "Info", Text = "Pets eat here, then poop Cloud Cash!" } }, 40, Sign.Grass)
	tpl.Points.BowlCenter = Vector3.new(bc.X, Garden.LAWN_TOP + 0.9, bc.Z)
	-- the beds
	for i, v in ipairs(beds) do
		local cf = Garden.bedFrame(def, v)
		if i <= open then
			Kit.p(m, "Bed", cf * CFrame.new(0, 0.225, 0), Vector3.new(size, 0.45, size), Kit.jit(K.Planks, 50 + i), M.Planks, true)
			Kit.p(m, "Cushion", cf * CFrame.new(0, 0.6, 0.05), Vector3.new(size - 0.5, 0.3, size - 0.55), Kit.jit(Garden.CUSHIONS[(i - 1) % 4 + 1], i), M.Fabric)
			Kit.p(m, "Headboard", cf * CFrame.new(0, 1.05, size / 2 - 0.12), Vector3.new(size, 1.7, 0.24), Kit.jit(K.PlanksDark, 70 + i), M.Planks)
			Kit.p(m, "BedRoof", cf * CFrame.new(0, 2.05, size / 2 - 0.55), Vector3.new(size + 0.4, 0.2, 1.5), Kit.jit(K.Roof, 60 + i), M.Clay)
		else
			Kit.p(m, "SoilBed", cf * CFrame.new(0, 0.175, 0), Vector3.new(size, 0.35, size), K.SoilDark, M.Sand, true)
			Kit.p(m, "Stem", cf * CFrame.new(0, 0.7, 0.3), Vector3.new(0.18, 0.7, 0.18), K.LeafyDark, M.Leafy)
			Kit.p(m, "Sprout", cf * CFrame.new(0, 1.1, 0.3), Vector3.new(0.75, 0.22, 0.45), K.GrassLight, M.Leafy)
			Garden.closedSign(m, cf, size)
		end
	end
	-- the level decor, all on the fence ring or overhead (the interior stays clear for the roaming pets)
	local d = Kit.detail(m, "GardenDecor")
	if level >= 2 then
		-- flower strips on the front kerb, both sides of the entrance
		for _, r in ipairs({ runs[4], runs[5] }) do
			Kit.p(d, "FlowerStrip", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.15, r[3]), Vector3.new(r[4] - 1.2, 0.3, 0.5), K.Leafy, M.Leafy)
			Kit.p(d, "Blooms", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.36, r[3]), Vector3.new(r[4] - 1.6, 0.14, 0.34), rgb(246, 150, 188), M.Fabric)
		end
	end
	if arch then
		Kit.p(m, "Arch", CFrame.new(ent.Center.X, eh + 0.2, -hz + t / 2), Vector3.new(ent.Width + 2.0, 0.4, 0.9), K.Planks, M.Planks)
		Kit.p(d, "Garland", CFrame.new(ent.Center.X, eh - 0.15, -hz + t / 2 - 0.1), Vector3.new(ent.Width + 0.8, 0.35, 0.6), K.Leafy, M.Leafy)
	end
	if level >= 4 then
		for _, x in ipairs({ g0 - 0.45, g1 + 0.45 }) do
			Kit.lantern(d, Vector3.new(x, eh - 1.0, -hz + t / 2 - 0.62), 0.42, x > ent.Center.X)
		end
	end
	if level >= 5 then
		for _, r in ipairs({ runs[2], runs[3] }) do
			Kit.p(d, "FlowerStrip", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.15, r[3]), Vector3.new(0.5, 0.3, r[5] - 2.0), K.Leafy, M.Leafy)
			Kit.p(d, "Blooms", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.36, r[3]), Vector3.new(0.34, 0.14, r[5] - 2.6), rgb(172, 142, 232), M.Fabric)
		end
	end
	if level >= 6 then
		for _, p in ipairs({ posts[3], posts[4] }) do
			Kit.lantern(d, Vector3.new(p[1], postH + 0.45, p[2]), 0.5, false)
		end
	end
	if level >= 7 then
		Kit.p(d, "Bunting", CFrame.new(0, railY - 0.3, hz - t / 2 - 0.05), Vector3.new(fp.X - 2.0, 0.4, 0.06), rgb(250, 168, 72), M.Fabric)
		Kit.p(d, "Bunting", CFrame.new(0, railY - 0.3, hz - t / 2 + 0.05), Vector3.new(fp.X - 2.4, 0.4, 0.06), rgb(118, 168, 236), M.Fabric)
	end
	if gold then
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		att.CFrame = lawn.CFrame:Inverse() * CFrame.new(ent.Center.X, eh + 0.6, -hz + t / 2)
		att.Parent = lawn
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	-- where pets sleep (Spot<i>, every bed) and the GardenSpotPrompts (open beds; SetGarden enables the empty ones)
	for i, v in ipairs(beds) do
		local cf = Garden.bedFrame(def, v)
		attach(lawn, "Spot" .. i, (cf * CFrame.new(0, Garden.CUSHION_TOP - Garden.LAWN_TOP, 0)).Position, { Slot = i, Open = i <= open })
		if i <= open then
			local pa = attach(lawn, "PromptPoint" .. i, Garden.promptPoint(def, i), { Slot = i })
			local prompt = newPrompt("GardenSpotPrompt", "Put a pet here", "Garden bed " .. i, "Garden")
			prompt.MaxActivationDistance = Garden.PROMPT_RANGE
			prompt.Enabled = false
			prompt:SetAttribute("Slot", i)
			prompt.Parent = pa
		end
	end
	tpl.Info.Open = open
	return tpl
end
----------------------------------------------------------------------
-- Food Machine (Kitchen, contract 3.4 / 3.6; the slot swapped with the Training Place): front -Z. A wooden cabinet
-- with iron bands on a slate plinth, a glass `Hopper` full of berries on a copper funnel (PetCareService puts the
-- FeedPrompt on it), a dispenser mouth with a chute over a tray, a big red FEED button, the Berry Basket beside it
-- (HomeFx's berry flights land in it) and the machine's sign: "Food Machine" / "Berries -> XP: press E" + the basket
-- line (TextLabel `BasketLine`, HomeFx rewrites it from the player attribute Berries and the plot's BerryCap).
-- Lamps (2+), a berry press barrel (3+), a shelf of bowls (4+), brass trims and a bell (5). Points ChuteMouth,
-- Tray, HopperTop, BasketTop. <= 55 parts.
----------------------------------------------------------------------
function Art.FoodMachine(def, level)
	local tpl = newTemplate("FoodMachine")
	local m = tpl.Model
	local gold = level >= 5
	local band = gold and K.Gold or K.IronDark
	local hw = ({ 2.6, 2.8, 3.0, 3.2, 3.4 })[level] or 3.4
	local top = ({ 4.2, 4.4, 4.6, 4.8, 5.0 })[level] or 5.0
	local z0, z1 = -1.6, 2.2
	local zc = (z0 + z1) / 2
	local dz = z1 - z0
	Kit.p(m, "Plinth", CFrame.new(0, 0.25, zc - 0.6), Vector3.new(2 * hw + 1.4, 0.5, dz + 2.6), K.SlateDark, M.Slate, true)
	local body = Kit.p(m, "Cabinet", CFrame.new(0, 0.5 + (top - 0.5) / 2, zc), Vector3.new(2 * hw, top - 0.5, dz), rgb(240, 112, 104), M.Planks, true)
	Kit.corners(m, -hw + 0.2, hw - 0.2, z0 + 0.2, z1 - 0.2, 0.5, top - 0.5, rgb(118, 168, 236), M.Wood)
	for _, y in ipairs({ 1.3, top - 0.9 }) do
		Kit.p(m, "Band", CFrame.new(0, y, z0 - 0.04), Vector3.new(2 * hw + 0.1, 0.22, 0.1), band, M.Metal)
	end
	Kit.p(m, "Cornice", CFrame.new(0, top + 0.17, zc), Vector3.new(2 * hw + 0.5, 0.35, dz + 0.5), rgb(92, 150, 230), M.Wood, true)
	Kit.p(m, "Panel", CFrame.new(0, 0.5 + (top - 0.5) / 2, z0 - 0.02), Vector3.new(2 * hw - 0.9, top - 1.6, 0.06), K.Whitewash, M.Planks)
	-- the dispenser: a slate mouth, a two-step copper chute, the tray with a few berries
	Kit.p(m, "Mouth", CFrame.new(-0.6, 2.4, z0 - 0.06), Vector3.new(1.7, 1.4, 0.14), K.IronDark, M.Slate)
	Kit.p(m, "Chute", CFrame.new(-0.6, 2.0, z0 - 0.45) * CFrame.Angles(rad(-25), 0, 0), Vector3.new(1.2, 0.18, 1.0), K.Copper, M.Metal)
	Kit.p(m, "Tray", CFrame.new(-0.6, 0.75, z0 - 1.0), Vector3.new(2.2, 0.3, 1.3), K.Iron, M.Metal, true)
	Kit.p(m, "TrayBerries", CFrame.new(-0.6, 0.95, z0 - 1.0), Vector3.new(1.6, 0.12, 0.8), K.BerryRed, M.Plastic)
	-- the FEED button (the one accent: berry red)
	Kit.cylAt(m, "ButtonRim", CFrame.new(hw - 1.0, 2.6, z0 - 0.06) * CFrame.Angles(0, PI / 2, 0), 0.12, 1.3, gold and K.Gold or K.Iron, M.Metal)
	Kit.cylAt(m, "Button", CFrame.new(hw - 1.0, 2.6, z0 - 0.16) * CFrame.Angles(0, PI / 2, 0), 0.14, 0.85, rgb(232, 64, 80), M.Neon)
	-- the hopper: a copper funnel, the glass Hopper (one part) with berry layers inside, a wooden lid with a knob
	local gw = (level >= 3) and 2.8 or 2.4
	local gh = 2.0 + 0.2 * level
	local gy0 = top + 0.35 + 0.5
	Kit.cyl(m, "Funnel", 0, top + 0.35, zc, 1.5, 0.5, K.Copper, M.Metal)
	local hopper = Kit.p(m, "Hopper", CFrame.new(0, gy0 + gh / 2, zc), Vector3.new(gw, gh, gw), rgb(214, 234, 246), M.Glass, false, { Transparency = 0.55 })
	hopper.CastShadow = false
	Kit.p(m, "HopperBerries", CFrame.new(0, gy0 + 0.4, zc), Vector3.new(gw - 0.3, 0.8, gw - 0.3), K.BerryRed, M.Plastic)
	Kit.p(m, "HopperBerries", CFrame.new(0, gy0 + 1.05, zc), Vector3.new(gw - 0.3, 0.5, gw - 0.3), K.BerryBlue, M.Plastic)
	Kit.p(m, "Lid", CFrame.new(0, gy0 + gh + 0.15, zc), Vector3.new(gw + 0.4, 0.3, gw + 0.4), rgb(92, 150, 230), M.Wood)
	for _, cx in ipairs({ -1, 1 }) do
		for _, cz2 in ipairs({ -1, 1 }) do
			Kit.p(m, "HopperRod", CFrame.new(cx * gw / 2, gy0 + gh / 2, zc + cz2 * gw / 2), Vector3.new(0.16, gh, 0.16), band, M.Metal)
		end
	end
	Kit.p(m, "Knob", CFrame.new(0, gy0 + gh + 0.45, zc), Vector3.new(0.5, 0.3, 0.5), gold and K.Gold or K.Copper, M.Metal)
	-- the Berry Basket on the plinth at the front right
	local bx = hw + 0.05
	Kit.cyl(m, "Basket", bx, 0.5, z0 - 1.05, 1.5, 0.75, K.PlanksLight, M.Planks)
	Kit.ball(m, "BasketBerries", Vector3.new(bx, 1.2, z0 - 1.05), 1.15, K.BerryRed2, M.Plastic)
	tpl.Points.BasketTop = Vector3.new(bx, 1.6, z0 - 1.05)
	local d = Kit.detail(m, "MachineDecor")
	if level >= 2 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.lantern(d, Vector3.new(sx * (hw + 0.1), top - 0.4, z0 - 0.35), 0.45, sx > 0)
		end
	end
	if level >= 3 then
		-- a berry press barrel on the left with a crank
		local px = -hw - 1.25
		Kit.cyl(m, "PressBarrel", px, 0.5, zc, 1.8, 1.9, K.Wood, M.Wood, true)
		Kit.cyl(m, "Hoop", px, 0.85, zc, 1.88, 0.18, band, M.Metal)
		Kit.cyl(m, "Hoop", px, 1.95, zc, 1.88, 0.18, band, M.Metal)
		Kit.p(m, "Crank", CFrame.new(px, 2.75, zc), Vector3.new(0.25, 0.9, 0.25), K.Iron, M.Metal)
		Kit.p(m, "PressPipe", CFrame.new((px - hw) / 2 + 0.2, 2.2, zc), Vector3.new(abs(px + hw) + 0.4, 0.35, 0.35), K.Copper, M.Metal)
	end
	if level >= 4 then
		-- a shelf of bowls on the right side
		local sx = hw + 1.0
		Kit.p(m, "Shelf", CFrame.new(sx, 1.4, zc + 0.6), Vector3.new(1.4, 1.8, 1.6), K.PlanksDark, M.Planks, true)
		local bowls = { K.BerryRed2, K.BerryBlue2, K.BerryGold }
		for i, c in ipairs(bowls) do
			Kit.cyl(d, "Bowl", sx, 2.3 + (i - 1) * 0.28, zc + 0.6, 1.2 - 0.12 * i, 0.26, c, M.Plastic)
		end
	end
	if gold then
		Kit.p(m, "Bell", CFrame.new(0, gy0 + gh + 0.95, zc), Vector3.new(0.7, 0.7, 0.7), K.GoldBright, M.Metal)
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		att.CFrame = body.CFrame:Inverse() * CFrame.new(0, gy0 + gh + 1.2, zc)
		att.Parent = body
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	-- the machine's sign (World text rule); HomeFx rewrites BasketLine for the owner
	Kit.sign(body, "MachineSign", (gy0 + gh + 1.6) - (0.5 + (top - 0.5) / 2), "Food Machine", {
		{ Name = "Info", Text = "Berries -> XP: press E" },
		-- the owner's line ("1,240 / 3,000 berries", HomeFx) in the ink, the card wide enough for a big basket (review: a
		-- BasketCap past 99,999 writes a longer line; HomeFx's R.basketFit then widens the card to fit it)
		{ Name = "BasketLine", Text = "Berry Basket", Color = Sign.Text, Reserve = "00,000 / 00,000 berries" },
	}, 60, Sign.Grass)
	tpl.Points.ChuteMouth = Vector3.new(-0.6, 2.0, z0 - 0.5)
	tpl.Points.Tray = Vector3.new(-0.6, 1.0, z0 - 1.0)
	tpl.Points.HopperTop = Vector3.new(0, gy0 + gh, zc)
	return tpl
end

----------------------------------------------------------------------
-- Training Place (Gym; its slot swapped with the Food Machine): front -Z, open toward the yard. A plank deck on a
-- slate plinth that grows from the left edge; one fabric mat per level at Slot.Spots (Attachments Spot1..5 on the
-- deck, attribute Slot; HomeFx puts the training pet and its skill prop on it) and behind each mat its skill corner:
-- a barbell rack (Physique, 1), two hurdles (Attack Speed, 2), a marble pedestal with a glowing orb (Ability, 3), a
-- shield wall (Defense, 4) and a scoreboard with a trophy (5). Pennant posts from 3. <= 90 parts.
----------------------------------------------------------------------
local TRAIN_MATS = { rgb(236, 92, 96), rgb(250, 204, 72), rgb(176, 120, 236), rgb(84, 140, 226), rgb(110, 200, 120) }

function Art.Training(def, level)
	local tpl = newTemplate("Training")
	local m = tpl.Model
	local fp = (def.Slot and def.Slot.Footprint) or Vector3.new(18, 10, 9)
	local hz = fp.Z / 2
	local spots = (def.Slot and def.Slot.Spots) or {}
	local w = ({ 9, 12, 15, 18, 18 })[level] or 18
	local x0 = -fp.X / 2
	local x1 = x0 + w
	local cx = (x0 + x1) / 2
	local gold = level >= 5
	local deckTop = 0.8
	Kit.p(m, "Plinth", CFrame.new(cx, 0.22, 0), Vector3.new(w, 0.44, fp.Z), K.SlateDark, M.Slate, true)
	local deck = Kit.p(m, "Deck", CFrame.new(cx, 0.44 + (deckTop - 0.44) / 2, 0.15), Vector3.new(w - 0.5, deckTop - 0.44, fp.Z - 0.8), K.Planks, M.Planks, true)
	Kit.p(m, "Kerb", CFrame.new(cx, 0.6, -hz + 0.2), Vector3.new(w, 0.32, 0.4), gold and K.Gold or K.Brick, gold and M.Metal or M.Brick, true)
	Kit.p(m, "BackRail", CFrame.new(cx, deckTop + 0.5, hz - 0.15), Vector3.new(w - 0.2, 1.0, 0.3), K.PlanksDark, M.Planks, true)
	local bz = 2.6 -- the skill corners stand behind the mats
	local function spotX(i)
		local p = spots[i]
		return (typeof(p) == "Vector3") and p.X or (x0 + 3 * i)
	end
	local y = deckTop
	-- 1 Physique: a barbell on a rack
	do
		local x = spotX(1)
		Kit.p(m, "Rack", CFrame.new(x, y + 0.4, bz), Vector3.new(2.6, 0.8, 1.0), K.IronDark, M.Metal, true)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "RackPost", CFrame.new(x + sx * 1.0, y + 1.35, bz), Vector3.new(0.25, 1.1, 0.25), K.Iron, M.Metal)
			Kit.cylAt(m, "Weight", CFrame.new(x + sx * 1.55, y + 1.9, bz), 0.3, 1.2, K.IronDark, M.Metal)
		end
		Kit.cylAt(m, "Bar", CFrame.new(x, y + 1.9, bz), 3.6, 0.2, K.Iron, M.Metal)
	end
	-- 2 Attack Speed: two hurdles with striped bars
	if level >= 2 then
		local x = spotX(2)
		for _, hx in ipairs({ x - 0.8, x + 0.8 }) do
			for _, lz in ipairs({ bz - 0.9, bz + 0.9 }) do
				Kit.p(m, "HurdleLeg", CFrame.new(hx, y + 0.65, lz), Vector3.new(0.2, 1.3, 0.2), K.Whitewash, M.Wood)
			end
			Kit.p(m, "Hurdle", CFrame.new(hx, y + 1.2, bz), Vector3.new(0.25, 0.3, 2.0), rgb(236, 86, 86), M.Wood)
		end
	end
	-- 3 Ability: a marble pedestal with a glowing orb
	if level >= 3 then
		local x = spotX(3)
		Kit.p(m, "Pedestal", CFrame.new(x, y + 0.2, bz), Vector3.new(1.6, 0.4, 1.6), K.MarbleShade, M.Marble, true)
		Kit.cyl(m, "Pedestal", x, y + 0.4, bz, 0.9, 1.4, K.Marble, M.Marble, true)
		Kit.p(m, "Pedestal", CFrame.new(x, y + 1.95, bz), Vector3.new(1.3, 0.3, 1.3), gold and K.Gold or K.MarbleShade, gold and M.Metal or M.Marble)
		Kit.ball(m, "Orb", Vector3.new(x, y + 2.75, bz), 1.2, rgb(176, 130, 255), M.Neon)
	end
	-- 4 Defense: a plank wall with a round shield
	if level >= 4 then
		local x = spotX(4)
		Kit.p(m, "ShieldWall", CFrame.new(x, y + 1.8, hz - 0.9), Vector3.new(2.8, 3.6, 0.4), K.PlanksDark, M.Planks, true)
		Kit.p(m, "ShieldWallCap", CFrame.new(x, y + 3.75, hz - 0.9), Vector3.new(3.2, 0.3, 0.7), K.WoodDark, M.Wood)
		Kit.cylAt(m, "Shield", CFrame.new(x, y + 1.9, hz - 1.18) * CFrame.Angles(0, PI / 2, 0), 0.16, 2.2, rgb(84, 140, 226), M.Metal)
		Kit.cylAt(m, "ShieldBoss", CFrame.new(x, y + 1.9, hz - 1.3) * CFrame.Angles(0, PI / 2, 0), 0.14, 0.7, gold and K.Gold or K.Iron, M.Metal)
	end
	-- 5: a scoreboard with three lights and a trophy on a little stand
	if gold then
		local x = spotX(5)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "BoardPost", CFrame.new(x + sx * 1.8, y + 2.4, hz - 0.8), Vector3.new(0.35, 4.8, 0.35), K.WoodDark, M.Wood)
		end
		Kit.p(m, "Board", CFrame.new(x, y + 4.0, hz - 0.8), Vector3.new(3.4, 1.6, 0.3), K.SlateDark, M.Slate)
		local lights = { rgb(120, 220, 130), rgb(250, 214, 90), rgb(255, 120, 110) }
		for i, c in ipairs(lights) do
			Kit.p(m, "BoardLight", CFrame.new(x - 1.6 + 0.8 * i, y + 4.0, hz - 1.0), Vector3.new(0.5, 0.5, 0.12), c, M.Neon)
		end
		Kit.p(m, "TrophyStand", CFrame.new(x, y + 0.5, bz), Vector3.new(1.0, 1.0, 1.0), K.MarbleShade, M.Marble, true)
		Kit.cyl(m, "Trophy", x, y + 1.0, bz, 0.5, 0.6, K.GoldBright, M.Metal)
		Kit.cyl(m, "Trophy", x, y + 1.6, bz, 1.0, 0.55, K.GoldBright, M.Metal)
	end
	-- pennant posts at the deck's back corners (3+)
	if level >= 3 then
		local d = Kit.detail(m, "Pennants")
		for _, px in ipairs({ x0 + 0.4, x1 - 0.4 }) do
			Kit.p(d, "PennantPost", CFrame.new(px, y + 2.6, hz - 0.4), Vector3.new(0.3, 5.2, 0.3), gold and K.Gold or K.WoodDark, gold and M.Metal or M.Wood)
			local fx = (px < cx) and (px + 0.85) or (px - 0.85)
			Kit.p(d, "Pennant", CFrame.new(fx, y + 4.6, hz - 0.4), Vector3.new(1.4, 0.9, 0.06), rgb(236, 86, 86), M.Fabric)
		end
	end
	-- the training mats (one per level) and their Spot<i> attachments on the deck
	for i, p in ipairs(spots) do
		if i <= level then
			Kit.p(m, "Mat", CFrame.new(p.X, y + 0.05, p.Z), Vector3.new(2.6, 0.1, 2.6), Kit.jit(TRAIN_MATS[i] or TRAIN_MATS[1], i), M.Fabric)
			Kit.p(m, "MatIn", CFrame.new(p.X, y + 0.11, p.Z), Vector3.new(1.5, 0.04, 1.5), K.Whitewash, M.Fabric)
			attach(deck, "Spot" .. i, Vector3.new(p.X, y + 0.15, p.Z), { Slot = i })
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Vault: front -Z. A chamfered slate strongroom on a plinth with a marble cornice and a round metal door (1),
-- marble pilasters and a brass band (2), a glass gem case on top (3), coin stacks and sconces (4), a gold crown (5).
-- <= 80 parts.
----------------------------------------------------------------------
function Art.Vault(def, level)
	local tpl = newTemplate("Vault")
	local m = tpl.Model
	local w, d, h = 5.6, 6.0, 4.4
	Kit.p(m, "Plinth", CFrame.new(0, 0.3, 0), Vector3.new(w + 1.0, 0.6, d + 1.0), K.SlateDark, M.Slate, true)
	Kit.p(m, "Step", CFrame.new(0, 0.15, -d / 2 - 1.0), Vector3.new(3.2, 0.3, 1.2), K.Slate, M.Slate, true)
	Kit.p(m, "Vault", CFrame.new(0, 0.6 + h / 2, 0), Vector3.new(w, h, d), rgb(218, 212, 200), M.Slate, true)
	Kit.p(m, "Cornice", CFrame.new(0, 0.6 + h + 0.12, 0), Vector3.new(w + 0.6, 0.24, d + 0.6), rgb(100, 122, 170), M.Marble, true)
	Kit.p(m, "Roof", CFrame.new(0, 0.6 + h + 0.32, 0), Vector3.new(w - 0.4, 0.16, d - 0.4), rgb(84, 104, 150), M.Slate)
	for _, y in ipairs({ 1.55, 3.95 }) do
		Kit.p(m, "Course", CFrame.new(0, y, 0), Vector3.new(w + 0.12, 0.16, d - 1.2), K.SlateLight, M.Slate)
		Kit.p(m, "Course", CFrame.new(0, y, 0), Vector3.new(w - 1.2, 0.16, d + 0.12), K.SlateLight, M.Slate)
	end
	Kit.p(m, "Keystone", CFrame.new(0, 4.55, -d / 2 - 0.1), Vector3.new(0.9, 0.7, 0.2), K.MarbleShade, M.Marble)
	-- the round door: a metal disc, a hub, a three-spoke wheel
	local dz = -d / 2 - 0.08
	Kit.cylAt(m, "Door", CFrame.new(0, 2.6, dz) * CFrame.Angles(0, PI / 2, 0), 0.18, 3.0, K.Iron, M.Metal)
	Kit.cylAt(m, "DoorRing", CFrame.new(0, 2.6, dz - 0.1) * CFrame.Angles(0, PI / 2, 0), 0.06, 2.5, K.IronDark, M.Metal)
	Kit.cylAt(m, "Hub", CFrame.new(0, 2.6, dz - 0.18) * CFrame.Angles(0, PI / 2, 0), 0.16, 0.7, K.Gold, M.Metal)
	for k = 0, 2 do
		Kit.p(m, "Spoke", CFrame.new(0, 2.6, dz - 0.2) * CFrame.Angles(0, 0, rad(k * 60)), Vector3.new(1.9, 0.14, 0.08), K.Gold, M.Metal)
	end
	if level >= 2 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "Pilaster", CFrame.new(sx * 2.15, 0.6 + h / 2, -d / 2 - 0.15), Vector3.new(0.6, h, 0.3), K.MarbleShade, M.Marble)
		end
		Kit.p(m, "Band", CFrame.new(0, 0.6 + h - 0.35, -d / 2 - 0.12), Vector3.new(w - 1.4, 0.25, 0.1), K.Gold, M.Metal)
	end
	local topY = 0.6 + h + 0.4
	if level >= 3 then
		-- a glass gem case on the roof
		Kit.p(m, "CaseBase", CFrame.new(0, topY + 0.2, 0), Vector3.new(2.6, 0.4, 2.6), K.MarbleShade, M.Marble)
		Kit.p(m, "GemCase", CFrame.new(0, topY + 1.3, 0), Vector3.new(2.2, 1.8, 2.2), rgb(214, 234, 246), M.Glass, false, { Transparency = 0.6 })
		Kit.p(m, "CaseLid", CFrame.new(0, topY + 2.3, 0), Vector3.new(2.6, 0.2, 2.6), K.Gold, M.Metal)
		local gems = { { -0.45, rgb(120, 220, 255) }, { 0.5, rgb(255, 130, 190) }, { 0.0, rgb(140, 240, 160) } }
		for i, g in ipairs(gems) do
			Kit.p(m, "Gem", CFrame.new(g[1], topY + 0.75 + 0.15 * i, (i - 2) * 0.3) * CFrame.Angles(rad(45), rad(35), 0), Vector3.new(0.55, 0.55, 0.55), g[2], M.Neon)
		end
	end
	if level >= 4 then
		local deco = Kit.detail(m, "VaultDecor")
		for _, sx in ipairs({ -1, 1 }) do
			Kit.cyl(deco, "Coins", sx * 2.4, 0.6, -d / 2 - 0.9, 0.9, 0.5 + 0.15 * (sx + 1), K.GoldBright, M.Metal)
			Kit.lantern(deco, Vector3.new(sx * 2.15, 3.9, -d / 2 - 0.55), 0.42, sx > 0)
		end
	end
	if level >= 5 then
		local cy = topY + ((level >= 3) and 2.4 or 0)
		Kit.cyl(m, "Crown", 0, cy, 0, 1.8, 0.4, K.GoldBright, M.Metal)
		for k = 0, 3 do
			local a = k * PI / 2 + PI / 4
			Kit.p(m, "CrownPoint", CFrame.new(math.cos(a) * 0.65, cy + 0.65, math.sin(a) * 0.65) * CFrame.Angles(0, -a, 0), Vector3.new(0.3, 0.6, 0.3), K.GoldBright, M.Metal)
		end
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		local anchor = biggestPart(m, "Cornice") or biggestPart(m)
		att.CFrame = anchor.CFrame:Inverse() * CFrame.new(0, cy + 1.0, 0)
		att.Parent = anchor
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	return tpl
end

----------------------------------------------------------------------
-- Fusion Machine: front -Z. A slate-and-marble dais with a neon inlay line, two glass input pods on metal pedestals
-- (cyan left, magenta right) piped into the marble-ringed glass chamber where the `Swirl` (a Model HomeFx spins: two
-- cloud puffs around a glowing heart) turns, and a small output pod in front. Brass trims and lamps (2), crystal
-- shards and sparkles (3). `FusionPrompt` ("Fuse", owner only) on PromptPoint, SwirlCenter, ChamberLight. <= 90.
----------------------------------------------------------------------
function Art.Fusion(def, level)
	local tpl = newTemplate("FusionMachine")
	local m = tpl.Model
	local gold = level >= 2
	local trim = gold and K.Gold or K.Iron
	local cz = 1.0
	local violet = rgb(170, 118, 255)
	Kit.oct(m, "Base", 0, 0, 0.5, 9.4, 0.5, rgb(84, 72, 160), M.Slate, true)
	local deckA = Kit.oct(m, "Deck", 0, 0.5, 0.5, 8.4, 0.45, rgb(150, 128, 226), M.Marble, true)
	deckA.Name = "Deck"
	Kit.oct(m, "Inlay", 0, 0.62, 0.5, 8.6, 0.08, violet, M.Neon)
	Kit.p(m, "Step", CFrame.new(0, 0.25, -4.7), Vector3.new(3.0, 0.5, 1.2), K.Slate, M.Slate, true)
	Kit.p(m, "StepInlay", CFrame.new(0, 0.52, -4.7), Vector3.new(2.0, 0.04, 0.3), violet, M.Neon)
	-- the input pods
	for _, sx in ipairs({ -1, 1 }) do
		local px = sx * 3.0
		local glow = (sx < 0) and rgb(110, 230, 240) or rgb(240, 120, 210)
		Kit.cyl(m, "PodBase", px, 0.95, cz, 1.9, 0.6, trim, M.Metal, true)
		Kit.cyl(m, "Pod", px, 1.55, cz, 1.5, 2.6, rgb(214, 234, 246), M.Glass).Transparency = 0.55
		Kit.cyl(m, "PodCore", px, 1.75, cz, 0.6, 1.6, glow, M.Neon)
		Kit.cyl(m, "PodLid", px, 4.15, cz, 1.9, 0.45, trim, M.Metal)
		-- a pipe from the lid into the chamber
		Kit.cylAt(m, "Pipe", CFrame.new(px * 0.62, 4.75, cz), abs(px) * 0.75, 0.4, K.Copper, M.Metal)
		Kit.p(m, "PipeElbow", CFrame.new(px, 4.55, cz), Vector3.new(0.45, 0.6, 0.45), K.Copper, M.Metal)
	end
	-- the chamber: a marble base ring and crown ring around a glass column, neon inlay bands and three marble ribs
	Kit.cyl(m, "ChamberBase", 0, 0.95, cz, 3.4, 0.7, K.Marble, M.Marble, true)
	Kit.cyl(m, "Chamber", 0, 1.65, cz, 2.8, 5.0, rgb(214, 226, 246), M.Glass).Transparency = 0.6
	Kit.cyl(m, "ChamberCrown", 0, 6.65, cz, 3.4, 0.7, K.Marble, M.Marble)
	Kit.cyl(m, "ChamberInlay", 0, 1.6, cz, 3.45, 0.12, violet, M.Neon)
	Kit.cyl(m, "ChamberInlay", 0, 6.6, cz, 3.45, 0.12, violet, M.Neon)
	for k = 0, 2 do
		local a = rad(90 + k * 120)
		Kit.p(m, "Rib", CFrame.new(math.cos(a) * 1.5, 4.15, cz + math.sin(a) * 1.5) * CFrame.Angles(0, -a, 0), Vector3.new(0.35, 5.0, 0.35), K.MarbleShade, M.Marble)
	end
	Kit.cyl(m, "ChamberCap", 0, 7.35, cz, 1.6, 0.5, trim, M.Metal)
	local crystalColor = (level >= 3) and rgb(255, 226, 150) or rgb(200, 170, 255)
	Kit.p(m, "Crystal", CFrame.new(0, 8.3, cz) * CFrame.Angles(rad(45), rad(45), 0), Vector3.new(0.7, 0.7, 0.7), crystalColor, M.Neon)
	-- the output pod in front
	Kit.cyl(m, "OutputBase", 0, 0.95, -2.6, 1.6, 0.5, trim, M.Metal, true)
	Kit.ball(m, "OutputDome", Vector3.new(0, 1.55, -2.6), 1.3, rgb(214, 234, 246), M.Glass).Transparency = 0.5
	if gold then
		local deco = Kit.detail(m, "FusionDecor")
		for _, sx in ipairs({ -1, 1 }) do
			Kit.lantern(deco, Vector3.new(sx * 3.6, 1.35, -3.0), 0.4, false)
		end
	end
	if level >= 3 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "Shard", CFrame.new(sx * 3.4, 1.9, 3.6) * CFrame.Angles(0, rad(45), rad(sx * 12)), Vector3.new(0.6, 1.8, 0.6), rgb(150, 230, 255), M.Neon)
		end
	end
	-- the swirl (HomeFx spins it): two cloud puffs on a rising spiral around a glowing heart (voxel-cloud palette)
	local swirl = Instance.new("Model")
	swirl.Name = "Swirl"
	CollectionService:AddTag(swirl, EXEMPT_TAG)
	Kit.ball(swirl, "Cloud", Vector3.new(0.7, 3.2, cz), 1.3, K.CloudTop, M.Plastic)
	Kit.ball(swirl, "Cloud", Vector3.new(-0.7, 4.9, cz), 1.2, K.CloudSide, M.Plastic)
	Kit.p(swirl, "Heart", CFrame.new(0, 4.0, cz), Vector3.new(0.5, 2.4, 0.5), (level >= 3) and rgb(255, 230, 160) or rgb(214, 176, 255), M.Neon, false, { Transparency = 0.15 })
	swirl.Parent = m
	tpl.Points.SwirlCenter = Vector3.new(0, 4.1, cz)
	local prompt = newPrompt("FusionPrompt", "Fuse", "Fusion Machine", "FusionMachine")
	local deck = biggestPart(m, "Deck") or biggestPart(m)
	if deck then
		local att = attach(deck, "PromptPoint", Vector3.new(0, 2.5, -3.0))
		prompt.Parent = att
		local light = attach(deck, "ChamberLight", Vector3.new(0, 4.0, cz))
		pointLight(light, rgb(186, 120, 255), 1.2, 16)
		if level >= 3 then
			emitter(light, { Color = ColorSequence.new(rgb(214, 180, 255), C.TextGold), Rate = 4, SpreadAngle = Vector2.new(180, 180) })
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Arena Gate (Kind Arena): front -Z. The P4 home Arena Gate (7aa0df2 Art.Arena): two square stone pillars on
-- plinths, a stone lintel with a red shield crest and crossed swords, a violet neon inlay around the opening, the
-- violet portal + a ForceField shimmer, braziers on top and red banners. `ArenaGatePrompt` ("Go to Arena", owner
-- only, attributes StationId / Teleport = "Arena"; ArenaBuilder teleports). <= 80 parts.
----------------------------------------------------------------------
function Art.ArenaGate(def, level)
	local tpl = newTemplate("ArenaGate")
	local m = tpl.Model
	local accent = rgb(140, 96, 220) -- the P4 home Arena Gate: a violet portal under a red shield
	local cx = 2.55 -- column centres at +-cx
	local colH = 7.4
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * cx
		Kit.p(m, "Plinth", CFrame.new(x, 0.45, 0), Vector3.new(1.9, 0.9, 1.9), K.SlateDark, M.Slate, true)
		Kit.p(m, "PlinthBand", CFrame.new(x, 0.95, 0), Vector3.new(2.05, 0.15, 2.05), K.MarbleShade, M.Marble)
		Kit.cyl(m, "Column", x, 1.0, 0, 1.35, colH, K.Marble, M.Marble, true)
		Kit.p(m, "Capital", CFrame.new(x, 1.0 + colH + 0.25, 0), Vector3.new(1.8, 0.5, 1.8), K.MarbleShade, M.Marble)
		Kit.p(m, "Banner", CFrame.new(x, 5.0, -0.72), Vector3.new(0.9, 3.4, 0.06), rgb(214, 70, 74), M.Fabric)
		Kit.p(m, "Brazier", CFrame.new(x, 11.05, 0), Vector3.new(0.9, 0.5, 0.9), K.IronDark, M.Metal)
		local fire = Kit.p(m, "Fire", CFrame.new(x, 11.55, 0), Vector3.new(0.55, 0.6, 0.55), rgb(255, 170, 80), M.Neon)
		if sx > 0 then
			pointLight(fire, LANTERN, 1.2, 12)
		end
	end
	local ly = 1.0 + colH + 0.5
	Kit.p(m, "Lintel", CFrame.new(0, ly + 0.7, 0), Vector3.new(6.9, 1.4, 2.0), K.Slate, M.Slate, true)
	Kit.p(m, "Cornice", CFrame.new(0, ly + 1.55, 0), Vector3.new(7.0, 0.3, 2.3), K.MarbleShade, M.Marble)
	Kit.cylAt(m, "Medallion", CFrame.new(0, ly + 0.7, -1.05) * CFrame.Angles(0, PI / 2, 0), 0.2, 1.7, rgb(196, 58, 66), M.Marble)
	for _, sx in ipairs({ -1, 1 }) do
		local cf = CFrame.new(0, ly + 0.7, -1.2) * CFrame.Angles(0, 0, rad(sx * 40))
		Kit.p(m, "Sword", cf, Vector3.new(0.22, 1.7, 0.06), rgb(214, 222, 236), M.Metal)
		Kit.p(m, "Hilt", cf * CFrame.new(0, -0.7, 0), Vector3.new(0.7, 0.16, 0.08), K.GoldBright, M.Metal)
	end
	-- the opening: a neon inlay frame, the red disc and the ForceField shimmer (non-solid)
	local ow, oh = 3.5, colH
	Kit.p(m, "Inlay", CFrame.new(-ow / 2 - 0.12, 1.0 + oh / 2, -0.35), Vector3.new(0.18, oh, 0.18), accent, M.Neon)
	Kit.p(m, "Inlay", CFrame.new(ow / 2 + 0.12, 1.0 + oh / 2, -0.35), Vector3.new(0.18, oh, 0.18), accent, M.Neon)
	Kit.p(m, "Inlay", CFrame.new(0, ly - 0.05, -0.35), Vector3.new(ow + 0.42, 0.18, 0.18), accent, M.Neon)
	Kit.p(m, "Portal", CFrame.new(0, 1.0 + oh / 2, 0), Vector3.new(ow, oh, 0.12), accent, M.Neon, false, { Transparency = 0.35 })
	Kit.p(m, "Shimmer", CFrame.new(0, 1.0 + oh / 2, -0.1), Vector3.new(ow, oh, 0.05), rgb(206, 180, 255), M.Force, false, { Transparency = 0.2 })
	Kit.p(m, "Threshold", CFrame.new(0, 0.3, 0), Vector3.new(ow + 0.6, 0.6, 2.6), K.Slate, M.Slate, true)
	local prompt = newPrompt("ArenaGatePrompt", "Go to Arena", "Arena Gate", "ArenaGate")
	prompt:SetAttribute("Teleport", "Arena")
	local portal = biggestPart(m, "Portal") or biggestPart(m)
	if portal then
		prompt.Parent = attach(portal, "PromptPoint", Vector3.new(0, 3.0, -1.5))
	end
	return tpl
end
----------------------------------------------------------------------
-- House (4 tiers; Phase 6 A1 = the P4 colours): front -Z toward the gate (the HouseWalk ends at local z -10). Stone
-- plinths, walls with corner posts, stepped voxel roofs, glass windows, warm lanterns. Cottage (cream walls, a
-- terracotta roof, a chimney), Villa (two storeys: peach below, cream above, a porch, a cross gable, terracotta
-- roofs), Manor (a lavender-white hall with two wings, slate-blue roofs, a white portico), Sky Castle (a white keep,
-- four square towers with blue stepped spires and gold tips, pink banners, a rose window). <= 150 parts.
----------------------------------------------------------------------
local House = {}

-- a walled block: a plinth band, the walls (centre cx, cz; w x d; from y0, h tall) and its four corner posts
function House.block(m, name, cx, cz, w, d, y0, h, color, mat, postColor)
	Kit.p(m, name, CFrame.new(cx, y0 + h / 2, cz), Vector3.new(w, h, d), color, mat, true)
	Kit.corners(m, cx - w / 2 + 0.15, cx + w / 2 - 0.15, cz - d / 2 + 0.15, cz + d / 2 - 0.15, y0, h, postColor or K.WoodDark, M.Wood)
end

-- a row of windows on the front wall (z = the wall's front face)
function House.windows(m, xs, y, z, w, h, frame)
	for _, x in ipairs(xs) do
		Kit.window(m, CFrame.new(x, y, z), w, h, frame)
	end
end

function House.door(m, x, y0, z, w, h, frame)
	Kit.p(m, "DoorFrame", CFrame.new(x, y0 + (h + 0.3) / 2, z - 0.06), Vector3.new(w + 0.5, h + 0.3, 0.12), frame or K.Whitewash, M.Wood)
	Kit.p(m, "Door", CFrame.new(x, y0 + h / 2, z - 0.14), Vector3.new(w, h, 0.1), K.WoodDark, M.Wood)
end

function House.chimney(m, x, z, y0, h)
	Kit.p(m, "Chimney", CFrame.new(x, y0 + h / 2, z), Vector3.new(1.3, h, 1.3), K.Brick, M.Brick, true)
	Kit.p(m, "ChimneyCap", CFrame.new(x, y0 + h + 0.15, z), Vector3.new(1.6, 0.3, 1.6), K.SlateDark, M.Slate)
end

function House.cottage(m)
	Kit.p(m, "Plinth", CFrame.new(0, 0.35, 0), Vector3.new(13.2, 0.7, 9.2), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0, 12, 8, 0.7, 4.6, K.Cream, M.Planks, K.Wood)
	Kit.gable(m, "Roof", CFrame.new(0, 5.3, 0), 12, 8, 3.4, K.Roof, M.Clay, { Overhang = 0.8, Ridge = K.RoofDark, Dark = K.RoofDark })
	House.door(m, 0, 0.7, -4, 1.8, 3.0)
	House.windows(m, { -3.6, 3.6 }, 2.9, -4, 1.8, 1.5)
	Kit.window(m, CFrame.new(6, 2.9, 0) * CFrame.Angles(0, -PI / 2, 0), 1.6, 1.4)
	House.chimney(m, 3.8, 1.6, 6.0, 3.6)
	Kit.p(m, "Step", CFrame.new(0, 0.2, -5.2), Vector3.new(3.0, 0.4, 1.4), K.Slate, M.Slate, true)
	local d = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -1.6, 1.6 }) do
		Kit.lantern(d, Vector3.new(x, 3.2, -4.35), 0.45, x > 0)
	end
	for _, x in ipairs({ -3.6, 3.6 }) do
		Kit.p(d, "FlowerBox", CFrame.new(x, 1.75, -4.35), Vector3.new(1.9, 0.4, 0.5), K.PlanksDark, M.Planks)
		Kit.p(d, "Flowers", CFrame.new(x, 2.05, -4.35), Vector3.new(1.7, 0.25, 0.4), rgb(246, 150, 188), M.Leafy)
	end
	return 9.6
end

function House.villa(m)
	local w, d = 18, 11
	Kit.p(m, "Plinth", CFrame.new(0, 0.35, 0.5), Vector3.new(w + 1.2, 0.7, d + 1.2), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0.5, w, d, 0.7, 4.4, K.Brick, M.Brick, K.Whitewash)
	Kit.p(m, "Band", CFrame.new(0, 5.25, 0.5), Vector3.new(w + 0.4, 0.3, d + 0.4), K.SlateLight, M.Slate)
	House.block(m, "Upper", 0, 0.5, w - 0.4, d - 0.4, 5.4, 3.8, K.Cream, M.Planks, K.Whitewash)
	Kit.gable(m, "Roof", CFrame.new(0, 9.2, 0.5), w - 0.4, d - 0.4, 4.2, K.Roof, M.Clay, { Overhang = 0.9, Ridge = K.RoofDark, Dark = K.RoofDark })
	-- the cross gable over the entrance
	local fz = 0.5 - d / 2
	Kit.p(m, "Bay", CFrame.new(0, 7.3, fz - 0.6), Vector3.new(5.4, 3.8, 1.2), K.Cream, M.Planks, true)
	Kit.gable(m, "BayRoof", CFrame.new(0, 9.2, fz - 0.2) * CFrame.Angles(0, PI / 2, 0), 2.4, 5.4, 2.4, K.Roof, M.Clay, { Overhang = 0.5, Dark = K.RoofDark })
	House.door(m, 0, 0.7, fz, 2.4, 3.2)
	House.windows(m, { -6.4, -3.4, 3.4, 6.4 }, 2.9, fz, 1.6, 1.6)
	House.windows(m, { -6.4, -3.4, 3.4, 6.4 }, 7.2, fz + 0.2, 1.5, 1.5)
	Kit.window(m, CFrame.new(0, 7.4, fz - 1.2), 2.2, 1.6)
	-- the porch: a slate floor, two posts, a little roof
	Kit.p(m, "Porch", CFrame.new(0, 0.3, fz - 1.5), Vector3.new(5.4, 0.6, 3.0), K.Slate, M.Slate, true)
	for _, x in ipairs({ -2.4, 2.4 }) do
		Kit.p(m, "PorchPost", CFrame.new(x, 2.3, fz - 2.6), Vector3.new(0.4, 3.4, 0.4), K.Whitewash, M.Wood)
	end
	Kit.p(m, "PorchRoof", CFrame.new(0, 4.15, fz - 1.6) * CFrame.Angles(rad(12), 0, 0), Vector3.new(6.0, 0.3, 3.0), K.RoofDark, M.Clay)
	House.chimney(m, -5.6, 2.4, 9.6, 4.4)
	House.chimney(m, 5.6, 2.4, 9.6, 4.4)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -2.4, 2.4 }) do
		Kit.lantern(deco, Vector3.new(x, 3.4, fz - 0.4), 0.45, x > 0)
	end
	return 14
end

function House.manor(m)
	local cw, cd = 14, 12
	Kit.p(m, "Plinth", CFrame.new(0, 0.4, 0.5), Vector3.new(25.2, 0.8, cd + 1.4), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0.5, cw, cd, 0.8, 4.6, K.Manor, M.Brick, K.Whitewash)
	Kit.p(m, "Band", CFrame.new(0, 5.55, 0.5), Vector3.new(cw + 0.4, 0.3, cd + 0.4), K.Marble, M.Marble)
	House.block(m, "Upper", 0, 0.5, cw, cd, 5.7, 4.3, K.Manor, M.Brick, K.Whitewash)
	Kit.p(m, "Cornice", CFrame.new(0, 10.15, 0.5), Vector3.new(cw + 0.6, 0.3, cd + 0.6), K.Marble, M.Marble)
	Kit.gable(m, "Roof", CFrame.new(0, 10.3, 0.5), cw, cd, 5.6, K.Shingle, M.Clay, { Overhang = 0.8, Ridge = K.Gold, Dark = K.ShingleLight })
	-- the wings (their gables face the yard)
	for _, sx in ipairs({ -1, 1 }) do
		local wx = sx * 9.6
		House.block(m, "Wing", wx, 1.0, 5.0, 10, 0.8, 6.0, K.Manor, M.Brick, K.Whitewash)
		Kit.gable(m, "WingRoof", CFrame.new(wx, 6.8, 1.0) * CFrame.Angles(0, PI / 2, 0), 10, 5.0, 3.0, K.Shingle, M.Clay, { Overhang = 0.6, Dark = K.ShingleLight })
		Kit.window(m, CFrame.new(wx, 3.2, -4.0), 1.8, 2.0)
		Kit.window(m, CFrame.new(wx, 7.6, -4.15), 1.0, 1.0, nil, nil, { Sill = false })
	end
	local fz = 0.5 - cd / 2
	House.door(m, 0, 0.8, fz, 2.6, 3.4, K.Marble)
	House.windows(m, { -4.6, -2.3, 2.3, 4.6 }, 3.1, fz, 1.4, 1.9, K.Marble)
	House.windows(m, { -4.6, -2.3, 0, 2.3, 4.6 }, 7.8, fz, 1.4, 1.7, K.Marble)
	-- the marble portico: two columns, an entablature, a pediment, two steps
	for _, x in ipairs({ -2.2, 2.2 }) do
		Kit.cyl(m, "Column", x, 0.8, fz - 1.9, 0.75, 4.6, K.Marble, M.Marble, true)
	end
	Kit.p(m, "Entablature", CFrame.new(0, 5.65, fz - 1.1), Vector3.new(5.6, 0.5, 2.4), K.MarbleShade, M.Marble)
	Kit.gable(m, "Pediment", CFrame.new(0, 5.9, fz - 1.1) * CFrame.Angles(0, PI / 2, 0), 2.4, 5.6, 1.4, K.MarbleShade, M.Marble, { Overhang = 0.25, EndOverhang = 0.1, Dark = K.Marble })
	Kit.p(m, "Steps", CFrame.new(0, 0.5, fz - 1.5), Vector3.new(5.2, 1.0, 2.8), K.Slate, M.Slate, true)
	Kit.p(m, "Steps", CFrame.new(0, 0.2, fz - 3.2), Vector3.new(4.6, 0.4, 1.0), K.SlateLight, M.Slate, true)
	House.chimney(m, -4.2, 3.0, 11.0, 5.4)
	House.chimney(m, 4.2, 3.0, 11.0, 5.4)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -3.4, 3.4 }) do
		Kit.lantern(deco, Vector3.new(x, 3.6, fz - 0.35), 0.5, x > 0)
	end
	for _, sx in ipairs({ -1, 1 }) do
		Kit.lantern(deco, Vector3.new(sx * 9.6 + sx * 1.5, 3.4, -4.4), 0.45, false)
	end
	return 15
end

function House.castle(m)
	local hw, hd, hh = 16, 12, 9.0
	local cz = 0.5
	Kit.p(m, "Plinth", CFrame.new(0, 0.45, cz), Vector3.new(hw + 2.0, 0.9, hd + 1.6), K.SlateDark, M.Slate, true)
	House.block(m, "Keep", 0, cz, hw, hd, 0.9, hh, K.Marble, M.Marble, K.MarbleShade)
	Kit.p(m, "Band", CFrame.new(0, 5.2, cz), Vector3.new(hw + 0.3, 0.3, hd + 0.3), K.Gold, M.Slate)
	Kit.p(m, "Cornice", CFrame.new(0, 0.9 + hh + 0.2, cz), Vector3.new(hw + 0.6, 0.4, hd + 0.6), K.MarbleShade, M.Slate)
	-- battlements along the front and the back
	local fz = cz - hd / 2
	for k = 0, 5 do
		local x = -hw / 2 + 1.0 + k * (hw - 2.0) / 5
		for _, z in ipairs({ fz + 0.3, cz + hd / 2 - 0.3 }) do
			Kit.p(m, "Merlon", CFrame.new(x, 0.9 + hh + 0.95, z), Vector3.new(1.2, 1.1, 0.6), K.MarbleShade, M.Marble)
		end
	end
	-- the great door, the portcullis, the rose window
	Kit.p(m, "GateArch", CFrame.new(0, 2.9, fz - 0.1), Vector3.new(4.4, 4.6, 0.3), K.Gold, M.Slate)
	Kit.p(m, "Door", CFrame.new(0, 2.6, fz - 0.28), Vector3.new(3.2, 3.6, 0.12), K.WoodDark, M.Wood)
	Kit.p(m, "Portcullis", CFrame.new(0, 4.25, fz - 0.36), Vector3.new(3.2, 0.5, 0.1), K.Iron, M.Metal)
	Kit.cylAt(m, "RoseFrame", CFrame.new(0, 7.3, fz - 0.06) * CFrame.Angles(0, PI / 2, 0), 0.14, 2.9, K.SlateLight, M.Slate)
	Kit.cylAt(m, "RoseWindow", CFrame.new(0, 7.3, fz - 0.16) * CFrame.Angles(0, PI / 2, 0), 0.08, 2.3, rgb(220, 186, 240), M.Glass)
	House.windows(m, { -5.4, -2.8, 2.8, 5.4 }, 3.0, fz, 1.2, 2.0, K.MarbleShade)
	House.windows(m, { -5.4, -2.8, 2.8, 5.4 }, 7.4, fz, 1.2, 1.8, K.MarbleShade)
	-- the central tower behind the gate
	Kit.cyl(m, "Tower", 0, 0.9 + hh, cz + 1.5, 5.2, 6.0, K.Marble, M.Marble, true)
	Kit.cyl(m, "TowerBand", 0, 0.9 + hh + 6.0, cz + 1.5, 5.8, 0.45, K.Gold, M.Slate)
	Kit.window(m, CFrame.new(0, 0.9 + hh + 3.2, cz + 1.5 - 2.62), 1.1, 1.8, K.MarbleShade, nil, { Sill = false })
	local function spire(x, z, y0, d0, h)
		local steps = { 1.0, 0.8, 0.6, 0.42, 0.26 }
		for k, f in ipairs(steps) do
			Kit.cyl(m, "Spire", x, y0 + (k - 1) * h * 0.17, z, d0 * f, h * 0.17, (k % 2 == 0) and K.RoofBlueDark or K.RoofBlue, M.Clay)
		end
		Kit.cyl(m, "SpireTip", x, y0 + h * 0.85, z, d0 * 0.1, h * 0.2, K.Gold, M.Metal)
	end
	spire(0, cz + 1.5, 0.9 + hh + 6.45, 5.6, 6.2)
	-- four corner towers with spires, windows and banners
	local towers = { { -10.4, cz - 4.6 }, { 10.4, cz - 4.6 }, { -10.4, cz + 4.4 }, { 10.4, cz + 4.4 } }
	for i, t in ipairs(towers) do
		local th = (i <= 2) and 12.5 or 11.0
		Kit.cyl(m, "TowerBase", t[1], 0, t[2], 4.8, 0.9, K.SlateDark, M.Slate, true)
		Kit.cyl(m, "CornerTower", t[1], 0.9, t[2], 4.2, th, Kit.jit(K.Marble, i), M.Marble, true)
		Kit.cyl(m, "TowerBand", t[1], 0.9 + th, t[2], 4.7, 0.4, K.Gold, M.Slate)
		spire(t[1], t[2], 0.9 + th + 0.4, 4.9, 5.2)
		if i <= 2 then
			Kit.window(m, CFrame.new(t[1], 8.0, t[2] - 2.12), 0.9, 1.6, K.MarbleShade, nil, { Sill = false })
			Kit.p(m, "Banner", CFrame.new(t[1] + ((t[1] < 0) and 2.2 or -2.2), 6.4, fz - 0.12), Vector3.new(1.4, 3.6, 0.08), K.Banner, M.Fabric)
		end
	end
	-- the bridge steps and lanterns
	Kit.p(m, "Steps", CFrame.new(0, 0.45, fz - 1.0), Vector3.new(5.0, 0.9, 2.0), K.Slate, M.Slate, true)
	Kit.p(m, "Steps", CFrame.new(0, 0.2, fz - 2.5), Vector3.new(4.4, 0.4, 1.2), K.SlateLight, M.Slate, true)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -2.9, 2.9 }) do
		Kit.lantern(deco, Vector3.new(x, 3.8, fz - 0.4), 0.5, true)
	end
	return 30
end

function Art.House(def, level)
	local tpl = newTemplate("House")
	local m = tpl.Model
	level = max(1, min(4, floor(level)))
	local top
	if level == 1 then
		top = House.cottage(m)
	elseif level == 2 then
		top = House.villa(m)
	elseif level == 3 then
		top = House.manor(m)
	else
		top = House.castle(m)
	end
	tpl.Info.Tier = level
	tpl.Points.RoofTop = Vector3.new(0, top, 0)
	return tpl
end

----------------------------------------------------------------------
-- Yard Fence (DecorFence, Perimeter: built in the PLOT frame just inside the lobby's fence, open at the gate),
-- the looks of the old Flower Beds + Banners merged in: picket panels + tulip boxes (1), a hedge + cloth banners +
-- the tulips (2), a cloudstone wall with cloud-capped pillars + royal banners + glowing starflowers (3). <= 90 parts.
----------------------------------------------------------------------
local Fence = {}

-- the runs { x0, z0, x1, z1 } along the yard's edge, the front split at the gate
function Fence.runs(half, inset)
	local e = half - (inset or 0.6)
	local gate = 8.6
	return {
		{ -e, e, e, e },
		{ -e, -e, -e, e },
		{ e, -e, e, e },
		{ -e, -e, -gate, -e },
		{ gate, -e, e, -e },
	}, e, gate
end

-- a box along a run: y0..y1 tall, `thick` across
function Fence.seg(parent, name, r, y0, y1, thick, color, mat, collide, shrink)
	local dx, dz = r[3] - r[1], r[4] - r[2]
	local len = math.sqrt(dx * dx + dz * dz) - (shrink or 0)
	local mid = Vector3.new((r[1] + r[3]) / 2, (y0 + y1) / 2, (r[2] + r[4]) / 2)
	local size = (abs(dx) > abs(dz)) and Vector3.new(len + thick, y1 - y0, thick) or Vector3.new(thick, y1 - y0, len + thick)
	return Kit.p(parent, name, CFrame.new(mid), size, color, mat, collide)
end

-- evenly spaced points along the runs (a corner shared by two runs comes once): fn(x, z, runIndex)
function Fence.points(runs, every, fn)
	local seen = {}
	for i, r in ipairs(runs) do
		local len = math.sqrt((r[3] - r[1]) ^ 2 + (r[4] - r[2]) ^ 2)
		local n = max(1, floor(len / every + 0.5))
		for k = 0, n do
			local f = k / n
			local x, z = lerp(r[1], r[3], f), lerp(r[2], r[4], f)
			local key = floor(x * 2 + 0.5) .. ":" .. floor(z * 2 + 0.5)
			if not seen[key] then
				seen[key] = true
				fn(x, z, i)
			end
		end
	end
end

-- the flower boxes beside the gate (inside the yard, along the front runs): a planter, foliage and blooms
function Fence.flowers(parent, e, gate, colors, glow)
	local d = Kit.detail(parent, "Flowers")
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * 16.2, sx * 25.2
		local cx = (x0 + x1) / 2
		local z = -e + 1.2
		Kit.p(d, "Planter", CFrame.new(cx, 0.35, z), Vector3.new(9.0, 0.7, 0.9), K.PlanksDark, M.Planks)
		Kit.p(d, "Foliage", CFrame.new(cx, 0.85, z), Vector3.new(8.6, 0.4, 0.6), K.Leafy, M.Leafy)
		for k = 1, 5 do
			local bx = cx - 3.6 + (k - 1) * 1.8
			Kit.p(d, "Bloom", CFrame.new(bx, 1.25, z + ((k % 2 == 0) and 0.12 or -0.12)), Vector3.new(0.55, 0.55, 0.55), colors[(k % #colors) + 1], glow and M.Neon or M.Fabric)
		end
	end
end

-- a banner on a pole: pole, crossbar, cloth (+ an emblem for the royal ones)
function Fence.banner(parent, x, z, face, cloth, royal)
	local d = Kit.detail(parent, "Banner")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, face, 0)
	Kit.p(d, "Pole", cf * CFrame.new(0, 3.3, 0), Vector3.new(0.35, 6.6, 0.35), royal and K.Gold or K.IronDark, M.Metal)
	Kit.p(d, "Crossbar", cf * CFrame.new(0, 6.3, -0.25), Vector3.new(2.2, 0.22, 0.22), royal and K.Gold or K.Wood, royal and M.Metal or M.Wood)
	Kit.p(d, "Cloth", cf * CFrame.new(0, 4.8, -0.3), Vector3.new(1.8, 2.8, 0.08), cloth, M.Fabric)
	if royal then
		Kit.p(d, "Emblem", cf * CFrame.new(0, 4.9, -0.36) * CFrame.Angles(0, 0, rad(45)), Vector3.new(0.7, 0.7, 0.06), K.GoldBright, M.Metal)
	end
end

function Art.Fence(def, level, plotSize)
	local tpl = newTemplate("DecorFence")
	local m = tpl.Model
	local half = (tonumber(plotSize) or 72) / 2
	level = max(1, min(3, floor(level)))
	-- the thicker looks step inward so they fit between the lobby's own fence posts (|x|, |z| >= 35.5) and the
	-- stations along the edge (the Pet Garden ends at x 34)
	local runs, e, gate = Fence.runs(half, ({ 0.6, 1.25, 1.25 })[level])
	if level == 1 then
		-- whitewashed picket panels between a top rail and posts every ~9 studs
		for _, r in ipairs(runs) do
			Fence.seg(m, "Pickets", r, 0, 1.9, 0.22, K.Whitewash, M.Planks, true)
			Fence.seg(m, "Rail", r, 1.55, 1.8, 0.4, Kit.jit(K.Whitewash, 3), M.Wood)
		end
		Fence.points(runs, 9, function(x, z, i)
			Kit.p(m, "Post", CFrame.new(x, 1.15, z), Vector3.new(0.55, 2.3, 0.55), K.Whitewash, M.Wood, true)
		end)
		Fence.flowers(m, e, gate, { rgb(236, 104, 108), rgb(250, 214, 92), rgb(246, 150, 188) }, false)
	elseif level == 2 then
		-- a clipped hedge on a brick kerb, brick pillars, the tulips and cloth banners at the gate and the corners
		for _, r in ipairs(runs) do
			Fence.seg(m, "Kerb", r, 0, 0.5, 1.2, K.Brick, M.Brick, true)
			Fence.seg(m, "Hedge", r, 0.5, 2.3, 1.1, K.Leafy, M.Leafy, true)
			Fence.seg(m, "HedgeTop", r, 2.3, 2.6, 0.8, K.GrassLight, M.Leafy)
		end
		Fence.points(runs, 18, function(x, z)
			Kit.p(m, "Pillar", CFrame.new(x, 1.45, z), Vector3.new(1.3, 2.9, 1.3), K.Brick, M.Brick, true)
			Kit.p(m, "PillarCap", CFrame.new(x, 3.05, z), Vector3.new(1.5, 0.3, 1.5), K.SlateLight, M.Slate)
		end)
		Fence.flowers(m, e, gate, { rgb(236, 104, 108), rgb(250, 214, 92), rgb(246, 150, 188) }, false)
		for _, sx in ipairs({ -1, 1 }) do
			Fence.banner(m, sx * (gate + 0.4), -e, 0, rgb(236, 88, 110), false)
			Fence.banner(m, sx * (e - 1.0), e - 1.0, PI, rgb(236, 88, 110), false)
		end
	else
		-- a cloudstone wall: a slate base, marble wall and cap, pillars with cloud puffs, royal banners, starflowers
		for _, r in ipairs(runs) do
			Fence.seg(m, "WallBase", r, 0, 0.5, 1.1, K.SlateDark, M.Slate, true)
			Fence.seg(m, "Wall", r, 0.5, 1.9, 0.9, K.Marble, M.Marble, true)
			Fence.seg(m, "WallCap", r, 1.9, 2.2, 1.1, K.MarbleShade, M.Marble)
		end
		local clouds = Kit.detail(m, "CloudPuffs")
		CollectionService:AddTag(clouds, EXEMPT_TAG)
		Fence.points(runs, 18, function(x, z)
			Kit.p(m, "Pillar", CFrame.new(x, 1.55, z), Vector3.new(1.3, 3.1, 1.3), K.Marble, M.Marble, true)
			Kit.ball(clouds, "Puff", Vector3.new(x, 3.5, z), 1.5, K.CloudTop, M.Plastic)
		end)
		Fence.flowers(m, e, gate, { rgb(196, 156, 255), rgb(140, 226, 255), rgb(255, 222, 140) }, true)
		for _, sx in ipairs({ -1, 1 }) do
			Fence.banner(m, sx * (gate + 0.4), -e, 0, rgb(150, 116, 226), true)
			Fence.banner(m, sx * (e - 1.0), e - 1.0, PI, rgb(150, 116, 226), true)
			Kit.lantern(m, Vector3.new(sx * gate, 4.6, -e), 0.6, true, "Crystal")
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Fountain (DecorFountain): the yard's centrepiece inside the ring of stone paths (radius <= 4.3), with the old
-- Lanterns merged in: a marble basin + 4 wood lanterns (1), a second tier + a cobble kerb + 6 brass lanterns (2),
-- a third tier with a cloud and a crystal + 8 crystal lanterns (3). The splash is a ParticleEmitter. <= 80 parts.
----------------------------------------------------------------------
function Art.Fountain(def, level)
	local tpl = newTemplate("DecorFountain")
	local m = tpl.Model
	level = max(1, min(3, floor(level)))
	local eff = (def and def.Effects and def.Effects[level]) or {}
	local style = eff.LanternStyle or ({ "Wood", "Brass", "Crystal" })[level]
	local count = tonumber(eff.Lanterns) or (2 + 2 * level)
	local water = K.Water
	Kit.oct(m, "Plinth", 0, 0, 0, 7.4, 0.4, K.SlateDark, M.Slate, true)
	local basin = Kit.cyl(m, "Basin", 0, 0.4, 0, 6.6, 1.0, K.Marble, M.Marble, true)
	Kit.cyl(m, "BasinFoot", 0, 0.4, 0, 6.9, 0.3, K.MarbleShade, M.Marble, true)
	Kit.cyl(m, "Water", 0, 1.4, 0, 5.9, 0.08, water, M.Glass, false).Transparency = 0.2
	Kit.cyl(m, "Column", 0, 1.4, 0, 0.9, 2.2, K.MarbleShade, M.Marble, true)
	Kit.cyl(m, "Bowl", 0, 3.6, 0, 2.6, 0.45, K.Marble, M.Marble)
	Kit.cyl(m, "BowlWater", 0, 4.0, 0, 2.2, 0.1, water, M.Glass).Transparency = 0.25
	local top = 4.1
	if level >= 2 then
		Kit.oct(m, "Kerb", 0, 0, 0, 8.4, 0.25, K.Cobble, M.Cobble, true)
		Kit.cyl(m, "Column", 0, 4.05, 0, 0.6, 1.6, K.MarbleShade, M.Marble)
		Kit.cyl(m, "Bowl", 0, 5.65, 0, 1.6, 0.35, K.Marble, M.Marble)
		Kit.cyl(m, "Trim", 0, 3.55, 0, 2.7, 0.12, K.Gold, M.Metal)
		top = 6.0
	end
	if level >= 3 then
		local clouds = Kit.detail(m, "Cloud")
		CollectionService:AddTag(clouds, EXEMPT_TAG)
		Kit.ball(clouds, "Puff", Vector3.new(0, 6.6, 0), 1.6, K.CloudTop, M.Plastic)
		Kit.ball(clouds, "Puff", Vector3.new(0.7, 6.3, 0.3), 1.1, K.CloudSide, M.Plastic)
		Kit.ball(clouds, "Puff", Vector3.new(-0.7, 6.25, -0.2), 1.0, K.CloudSide, M.Plastic)
		Kit.p(m, "Crystal", CFrame.new(0, 7.9, 0) * CFrame.Angles(rad(45), 0, rad(35)), Vector3.new(0.8, 0.8, 0.8), rgb(160, 226, 255), M.Neon)
		top = 7.2
	end
	-- the lanterns on an ellipse around the basin (clear of the paths), every other one lit
	local d = Kit.detail(m, "Lanterns")
	for i = 1, count do
		local a = (i - 0.5) / count * 2 * PI + PI / 4
		local x, z = math.cos(a) * 4.25, math.sin(a) * 3.65
		local postColor = (style == "Crystal") and K.Marble or ((style == "Brass") and K.IronDark or K.WoodDark)
		local postMat = (style == "Crystal") and M.Marble or ((style == "Brass") and M.Metal or M.Wood)
		Kit.p(d, "LanternPost", CFrame.new(x, 1.1, z), Vector3.new(0.3, 2.2, 0.3), postColor, postMat)
		Kit.lantern(d, Vector3.new(x, 2.45, z), 0.45, i % 2 == 1, style)
	end
	local att = Instance.new("Attachment")
	att.Name = "Splash"
	att.CFrame = basin.CFrame:Inverse() * CFrame.new(0, top + 0.4, 0)
	att.Parent = basin
	emitter(att, {
		Sprite = "Droplet",
		Color = ColorSequence.new(rgb(206, 232, 250)),
		LightEmission = 0.2,
		Rate = 10 + level * 4,
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(4, 6),
		SpreadAngle = Vector2.new(18, 18),
		Acceleration = Vector3.new(0, -14, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.15) }),
	})
	return tpl
end

----------------------------------------------------------------------
-- Pet Podium (DecorPodium): dresses up the lobby's own podium (6 x 6, 3 tall; the best pet stands on it): a slate
-- stage with a marble step ring and corner posts: stone lanterns (1), marble pillars with gold caps + a carpet (2),
-- crystal pillars (3). The looks are unchanged from Phase 4; the materials follow 6.4. <= 80 parts.
----------------------------------------------------------------------
function Art.Podium(def, level)
	local tpl = newTemplate("DecorPodium")
	local m = tpl.Model
	level = max(1, min(3, floor(level)))
	Kit.p(m, "Stage", CFrame.new(0, 0.25, 0), Vector3.new(8, 0.5, 8), K.Slate, M.Slate, true)
	-- the step ring around the podium's foot (its middle left open: no face shared with the podium)
	for _, s in ipairs({ { 0, 3.25, 7, 0.5 }, { 0, -3.25, 7, 0.5 }, { 3.25, 0, 0.5, 6 }, { -3.25, 0, 0.5, 6 } }) do
		Kit.p(m, "Step", CFrame.new(s[1], 0.75, s[2]), Vector3.new(s[3], 0.5, s[4]), K.MarbleShade, M.Marble, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local x, z = sx * 3.5, sz * 3.5
			if level == 1 then
				Kit.p(m, "Post", CFrame.new(x, 1.75, z), Vector3.new(0.9, 1.5, 0.9), K.SlateLight, M.Slate)
				Kit.lantern(m, Vector3.new(x, 2.8, z), 0.55, false)
			elseif level == 2 then
				Kit.p(m, "Pillar", CFrame.new(x, 2.25, z), Vector3.new(0.9, 2.5, 0.9), K.Marble, M.Marble)
				Kit.p(m, "Cap", CFrame.new(x, 3.65, z), Vector3.new(1.1, 0.3, 1.1), K.Gold, M.Metal)
			else
				Kit.p(m, "Pillar", CFrame.new(x, 1.75, z), Vector3.new(0.9, 1.5, 0.9), K.Marble, M.Marble)
				Kit.p(m, "Cap", CFrame.new(x, 2.65, z), Vector3.new(1.1, 0.3, 1.1), K.Gold, M.Metal)
				Kit.p(m, "Crystal", CFrame.new(x, 3.5, z) * CFrame.Angles(0, rad(45), 0), Vector3.new(0.7, 1.4, 0.7), rgb(150, 220, 255), M.Neon)
			end
		end
	end
	if level >= 2 then
		for _, sz in ipairs({ -1, 1 }) do
			Kit.p(m, "Collar", CFrame.new(0, 2.25, sz * 2.85), Vector3.new(6.2, 0.4, 0.4), K.Gold, M.Metal)
			Kit.p(m, "Collar", CFrame.new(sz * 2.85, 2.25, 0), Vector3.new(0.4, 0.4, 5.3), K.Gold, M.Metal)
		end
		Kit.p(m, "Carpet", CFrame.new(0, 0.53, -4.35), Vector3.new(2.4, 0.06, 0.8), rgb(236, 88, 110), M.Fabric)
	end
	return tpl
end

----------------------------------------------------------------------
-- Template lookup
----------------------------------------------------------------------
local function fallbackTemplate(def, level)
	-- plain stand-in when the art fails: a slate block of the footprint
	local tpl = newTemplate(def.Id)
	local fp = (def.Slot and def.Slot.Footprint) or Vector3.new(6, 6, 6)
	local h = max(1, fp.Y * (0.5 + 0.5 * level / max(1, def.MaxLevel or 1)))
	Kit.p(tpl.Model, "Body", CFrame.new(0, h / 2, 0), Vector3.new(min(fp.X, 30), h, min(fp.Z, 30)), K.Slate, M.Slate, true)
	return tpl
end

local ART_BY_KIND = {
	Farm = Art.Farm,
	Garden = Art.Garden,
	FoodMachine = Art.FoodMachine,
	Training = Art.Training,
	Vault = Art.Vault,
	House = Art.House,
	Fusion = Art.Fusion,
	Arena = Art.ArenaGate,
}
local ART_BY_ID = {
	DecorFence = Art.Fence,
	DecorFountain = Art.Fountain,
	DecorPodium = Art.Podium,
}

-- (kit-b prep, the leak hunt) a template is only ever cloned and Clone copies no connections: its art is built frozen
-- (Theme.SetFrozen / PixelIcon.SetFrozen: the signs get their capitals and icons, but no follow listeners), or every
-- cached template kept a caps listener per sign and three icon listeners per closed bed's star for the server's life
-- (final_checks: TextLabel.Changed:Text / TextColor3 / TextTransparency / ZIndex grew with every template built)
local function frozenCall(fn, ...)
	local wasT, wasP = Theme.SetFrozen(true), PixelIcon.SetFrozen(true)
	local ok, result = pcall(fn, ...)
	Theme.SetFrozen(wasT)
	PixelIcon.SetFrozen(wasP)
	return ok, result
end

-- template for (def, level); the Garden's open bed count changes its art (cache key Garden:<level>:<open>)
local function stationTemplate(def, level, accent, open)
	local key = def.Id .. ":" .. level
	local garden = def.Kind == "Garden"
	if garden then
		open = Garden.clampOpen(open, #Garden.places(def))
		key = key .. ":" .. open
	end
	local tpl = templates[key]
	if tpl then
		return tpl
	end
	local fn = ART_BY_ID[def.Id] or ART_BY_KIND[def.Kind]
	local ok, result = false, nil
	if fn then
		if garden then
			ok, result = frozenCall(fn, def, level, open)
		else
			ok, result = frozenCall(fn, def, level, TycoonCatalog and TycoonCatalog.PlotSize or 72, accent)
		end
		if not ok then
			warn("[HomeBuilder] art for " .. key .. " failed: " .. tostring(result))
		end
	end
	if not ok or type(result) ~= "table" then
		result = fallbackTemplate(def, level)
	end
	Kit.finish(result.Model)
	local primary = biggestPart(result.Model)
	if primary then
		result.Model.PrimaryPart = primary
	end
	result.Parts = countParts(result.Model)
	templates[key] = result
	return result
end

----------------------------------------------------------------------
-- Pads
----------------------------------------------------------------------
local PAD_COLORS = {
	Build = C.CashGlow,
	Upgrade = rgb(255, 210, 110),
	Locked = rgb(150, 160, 186),
	Prestige = rgb(196, 140, 255),
}

local function padState(pad)
	if pad.Prestige or pad.StationId == "Prestige" then
		return "Prestige"
	end
	if pad.Locked and pad.Locked ~= "" then
		return "Locked"
	end
	if (tonumber(pad.Level) or 0) <= 0 then
		return "Build"
	end
	return "Upgrade"
end

-- the pad's parts for one state, built once (origin = pad centre on the ground, front -Z = toward the station).
-- Four parts: a stone base (walkable; it carries the BuyPrompt and the sign), the glowing plate in the state's
-- colour and a two-part neon emblem: "+" build, an arrow toward the station upgrade, a padlock, a star (prestige).
local PAD_TOP = 0.5 -- the pad's walkable top (the Glow plate), over its origin
local function padTemplate(state)
	local key = "Pad:" .. state
	if templates[key] then
		return templates[key]
	end
	local tpl = newTemplate("Pad")
	local m = tpl.Model
	local glow = PAD_COLORS[state] or PAD_COLORS.Build
	local size = Vector3.new(4, 0.6, 4)
	local cat = catalog()
	if cat and cat.Layout and typeof(cat.Layout.PadSize) == "Vector3" then
		size = cat.Layout.PadSize
	end
	local w, d = size.X, size.Z
	local base = box(m, "Base", CFrame.new(0, 0.2, 0), Vector3.new(w, 0.4, d), (state == "Locked") and C.StoneDark or C.StoneEdge, { Collide = true, Shadow = false })
	box(m, "Glow", CFrame.new(0, 0.45, 0), Vector3.new(w - 0.7, 0.1, d - 0.7), glow, { Material = MAT.Neon, Shadow = false, Collide = true })
	local ec = (state == "Locked") and rgb(214, 220, 236) or rgb(255, 255, 255)
	local eo = { Material = MAT.Neon, Shadow = false }
	local y = 0.52
	if state == "Build" then
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(1.8, 0.05, 0.5), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(0.5, 0.05, 1.8), ec, eo)
	elseif state == "Upgrade" then
		box(m, "Emblem", CFrame.new(0, y, 0.35), Vector3.new(0.5, 0.05, 1.3), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, -0.45) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(0.95, 0.05, 0.95), ec, eo)
	elseif state == "Locked" then
		box(m, "Emblem", CFrame.new(0, y, 0.3), Vector3.new(1.3, 0.05, 1.0), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, -0.45), Vector3.new(0.8, 0.05, 0.5), ec, eo)
	else
		box(m, "Emblem", CFrame.new(0, y, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(1.2, 0.05, 1.2), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(1.2, 0.05, 1.2), ec, eo)
	end
	m.PrimaryPart = base
	templates[key] = tpl
	return tpl
end

----------------------------------------------------------------------
-- Plot records
----------------------------------------------------------------------
local lobbyInfo = nil
local plots = {} -- [key] = record
local initialized = false

HomeBuilder.StationBuilt = Util and Util.Signal and Util.Signal() or nil

local function spotKey(spotInfo)
	if type(spotInfo) == "table" then
		return tonumber(spotInfo.Index) or spotInfo
	end
	return tonumber(spotInfo)
end

local function resolveSpot(spotInfo)
	if type(spotInfo) == "number" then
		local spots = lobbyInfo and lobbyInfo.Spots
		return type(spots) == "table" and spots[spotInfo] or nil
	end
	if type(spotInfo) == "table" then
		return spotInfo
	end
	return nil
end

local function plotFrame(spotInfo)
	if typeof(spotInfo.PlotCFrame) == "CFrame" then
		return spotInfo.PlotCFrame
	end
	if typeof(spotInfo.Center) == "Vector3" then
		return CFrame.new(spotInfo.Center)
	end
	return nil
end

local function ownerId(rec)
	return rec.OwnerUserId or 0
end

-- the plot record (created by PreparePlot)
local function recordOf(spotInfo)
	local key = spotKey(spotInfo)
	return key ~= nil and plots[key] or nil
end

local function buildClaimSign(rec)
	if rec.ClaimSign then
		return rec.ClaimSign
	end
	local cf = rec.CF
	local half = (rec.Size or 72) / 2
	local m = Instance.new("Model")
	m.Name = "ClaimSign"
	-- a signboard on a wooden post on the verge beside the gate, facing the street. Two parts only: the free plots
	-- live inside the lobby and count toward its part budget. (World text rule: 50 px per stud, a 1.04 stud title (T0 review:
	-- 52 px, FREE HOME in FredokaOne is about 306 px with its outline in the 329 px box; 56 px touched its edges),
	-- 0.6 stud info, both fitting the 7 x 2.6 stud board; the GUI draws the board's frame.) (kit-b world signs) the face is a
	-- stone card as LobbyBuilder's "THE GATES" board: inset by its 5 px mitred wood edge (340 x 120 px of the 350 x 130 canvas),
	-- a 6 px lip in the grass green of a free home; FREE HOME (300 px of FredokaOne at 52 px) in the ink over the muted line
	local base = cf * CFrame.new(11, 0, -half - 2) * CFrame.Angles(0, math.pi, 0)
	box(m, "Post", base * CFrame.new(0, 1.6, 0), Vector3.new(0.6, 3.2, 0.6), C.PlankDark, { Collide = true })
	local board = box(m, "Board", base * CFrame.new(0, 3.9, 0), Vector3.new(7.0, 2.6, 0.4), C.Plank, { Collide = true, Shadow = false })
	local gui = surfaceGui(board, Enum.NormalId.Back, "ClaimGui")
	local panel = boardPanel(gui, 5, 6, Sign.GrassLip)
	boardText(panel, "FREE HOME", "Title", 52, Sign.Text, "Title", 0, 6, 340, 58)
	boardText(panel, "Press E at the gate", "Body", 30, Sign.TextMuted, "Info", 0, 66, 340, 40)
	rec.ClaimSign = m
	return m
end

-- the lobby's own gate part closest to the gate opening (LobbyBuilder names them GateBeam / GateBase / GatePillar)
local GATE_PARTS = { GateBeam = 1, GateBase = 2, GatePillar = 3 }

local function gateHolder(parent, point)
	local best, bestRank, bestDist = nil, huge, huge
	for _, d in ipairs(parent:GetDescendants()) do
		local rank = GATE_PARTS[d.Name]
		if rank and d:IsA("BasePart") then
			local dist = (d.Position - point).Magnitude
			if dist <= 14 and (rank < bestRank or (rank == bestRank and dist < bestDist)) then
				best, bestRank, bestDist = d, rank, dist
			end
		end
	end
	return best
end

local function setClaimVisible(rec, free)
	if rec.ClaimPrompt then
		rec.ClaimPrompt.Enabled = free
	end
	local sign = buildClaimSign(rec)
	if free then
		if sign.Parent ~= rec.ClaimGate then
			sign.Parent = rec.ClaimGate
		end
	else
		sign.Parent = nil
	end
end

function HomeBuilder.PreparePlot(spotInfo)
	spotInfo = resolveSpot(spotInfo)
	if type(spotInfo) ~= "table" then
		return nil
	end
	local key = spotKey(spotInfo)
	local rec = plots[key]
	if rec and rec.Home and rec.Home.Parent then
		return rec.Home
	end
	local cf = plotFrame(spotInfo)
	if not cf then
		warn("[HomeBuilder] PreparePlot: SpotInfo " .. tostring(key) .. " has no PlotCFrame")
		return nil
	end
	local parent = spotInfo.Folder
	if typeof(parent) ~= "Instance" then
		parent = Workspace:FindFirstChild("NimbusHomes") or newFolder(Workspace, "NimbusHomes")
		parent = parent:FindFirstChild(string.format("Spot_%02d", tonumber(spotInfo.Index) or 0)) or newFolder(parent, string.format("Spot_%02d", tonumber(spotInfo.Index) or 0))
	end
	rec = {
		Key = key,
		Spot = spotInfo,
		Index = tonumber(spotInfo.Index) or 0,
		CF = cf,
		Size = tonumber(spotInfo.PlotSize) or (catalog() and catalog().PlotSize) or Config.Lobby.PlotSize or 72,
		Stations = {}, -- [id] = model
		Levels = {}, -- [id] = level
		Pads = {}, -- [id] = { Model, Sig, Prompt, ... }
		Ghosts = {},
		OwnerUserId = 0,
	}
	plots[key] = rec
	local old = parent:FindFirstChild("Home")
	if old then
		old:Destroy()
	end
	local home = newFolder(parent, "Home")
	home:SetAttribute("SpotIndex", rec.Index)
	home:SetAttribute("PlotCFrame", cf)
	home:SetAttribute("OwnerUserId", 0)
	home:SetAttribute("OwnerName", "")
	CollectionService:AddTag(home, HOME_TAG)
	rec.Home = home
	rec.PadFolder = newFolder(home, "Pads")

	-- the claim gate: the prompt rides an Attachment ("ClaimPoint") in the gate opening, on the lobby's own gate part
	-- when the plot has one (no extra part per plot), else on an invisible anchor (ClaimGate/ClaimAnchor)
	local oldGate = parent:FindFirstChild("ClaimGate")
	if oldGate then
		oldGate:Destroy()
	end
	for _, d in ipairs(parent:GetDescendants()) do
		if d:IsA("Attachment") and d.Name == "ClaimPoint" then
			d:Destroy()
		end
	end
	local gate = Instance.new("Model")
	gate.Name = "ClaimGate"
	gate.Parent = parent
	rec.ClaimGate = gate
	local gatePoint = cf * CFrame.new(0, 2.6, -rec.Size / 2)
	local holder = gateHolder(parent, gatePoint.Position) or anchorPart(gate, "ClaimAnchor", gatePoint)
	local anchor = Instance.new("Attachment")
	anchor.Name = "ClaimPoint"
	anchor.CFrame = holder.CFrame:ToObjectSpace(gatePoint)
	anchor.Parent = holder
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClaimPrompt"
	prompt.ActionText = "Claim Home"
	prompt.ObjectText = "Free home"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CLAIM_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("SpotIndex", rec.Index)
	prompt.Parent = anchor
	rec.ClaimPrompt = prompt
	setClaimVisible(rec, true)
	return home
end

----------------------------------------------------------------------
-- Paths (one merged voxel layer of every TycoonCatalog.Layout.Paths entry; built while the plot is owned)
----------------------------------------------------------------------
local PATH_EDGES = false -- a darker outline costs ~2x the parts (junctions fragment it)

local function pathTemplate()
	if templates.Paths then
		return templates.Paths
	end
	local tpl = newTemplate("Paths")
	local cat = catalog()
	local paths = cat and cat.Layout and cat.Layout.Paths or {}
	local g = Voxel and Voxel.NewGrid(1) or nil
	if g then
		local inside = {}
		local function key(i, k)
			return i * 4096 + k
		end
		for _, p in ipairs(paths) do
			local a, b, w = p.Start, p.Finish, p.Width or 4
			if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
				local x0, x1 = min(a.X, b.X) - w / 2, max(a.X, b.X) + w / 2
				local z0, z1 = min(a.Z, b.Z) - w / 2, max(a.Z, b.Z) + w / 2
				for i = floor(x0 + 0.5), floor(x1 + 0.5) - 1 do
					for k = floor(z0 + 0.5), floor(z1 + 0.5) - 1 do
						inside[key(i, k)] = true
					end
				end
			end
		end
		for code in pairs(inside) do
			local i = floor((code + 2048) / 4096)
			local k = code - i * 4096
			local edge = not (inside[key(i + 1, k)] and inside[key(i - 1, k)] and inside[key(i, k + 1)] and inside[key(i, k - 1)])
			local cellKey = edge and "PathEdge" or "Path"
			if not PATH_EDGES then
				cellKey = "Path"
			end
			Voxel.Set(g, i, 0, k, cellKey)
		end
		-- the border: one slab per path, 0.5 stud wider on each side and a hair lower than the path top
		for _, p in ipairs(paths) do
			local a, b, w = p.Start, p.Finish, p.Width or 4
			if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
				local x0, x1 = min(a.X, b.X) - w / 2 - 0.5, max(a.X, b.X) + w / 2 + 0.5
				local z0, z1 = min(a.Z, b.Z) - w / 2 - 0.5, max(a.Z, b.Z) + w / 2 + 0.5
				local half = (catalog() and catalog().PlotSize or 72) / 2 - 0.3
				x0, x1 = max(x0, -half), min(x1, half)
				z0, z1 = max(z0, -half), min(z1, half)
				box(tpl.Model, "PathEdge", CFrame.new((x0 + x1) / 2, -0.02, (z0 + z1) / 2), Vector3.new(x1 - x0, 0.2, z1 - z0), rgb(146, 138, 132), { Collide = true, Shadow = false })
			end
		end
		local model = Voxel.Build(g, {
			VoxelSize = 1,
			Palette = { Path = { Color = rgb(208, 202, 190), Material = MAT.SmoothPlastic }, PathEdge = { Color = rgb(146, 138, 132), Material = MAT.SmoothPlastic } },
			Name = "Paths",
			CFrame = CFrame.new(0.5, -0.32, 0.5), -- one voxel layer whose top sits 0.18 stud over the lawn
			CanCollide = true,
			CanQuery = true,
			CastShadow = false,
		})
		absorb(tpl.Model, model)
	end
	templates.Paths = tpl
	return tpl
end

local function setPaths(rec, on)
	local existing = rec.Home:FindFirstChild("Paths")
	if on then
		if not existing then
			local m = cloneAt(pathTemplate(), rec.CF)
			m.Name = "Paths"
			m.Parent = rec.Home
		end
	elseif existing then
		existing:Destroy()
	end
end

----------------------------------------------------------------------
-- The house lot: while the plot is owned and has no House yet (a new home, or right after a prestige) four stakes
-- and a string mark where the house will stand, with a little pile of planks and a stack of bricks beside it, so an
-- empty yard reads "your house goes here" (12 parts, gone as soon as the House is built; no collisions)
----------------------------------------------------------------------
local function lotTemplate()
	if templates.HouseLot then
		return templates.HouseLot
	end
	local tpl = newTemplate("HouseLot")
	local m = tpl.Model
	-- in the House slot's frame (front -Z, toward the yard); kept clear of the walk in front of the house
	local x0, x1, z0, z1 = -12, 12, -6.5, 8
	local rope = rgb(244, 238, 222)
	local deco = { Shadow = false }
	local plank = { Shadow = false }
	for _, x in ipairs({ x0, x1 }) do
		for _, z in ipairs({ z0, z1 }) do
			box(m, "Stake", CFrame.new(x, 0.8, z), Vector3.new(0.4, 1.6, 0.4), C.Plank, deco)
		end
	end
	box(m, "String", CFrame.new(0, 1.25, z0), Vector3.new(x1 - x0, 0.12, 0.12), rope, deco)
	box(m, "String", CFrame.new(0, 1.25, z1), Vector3.new(x1 - x0, 0.12, 0.12), rope, deco)
	box(m, "String", CFrame.new(x0, 1.25, (z0 + z1) / 2), Vector3.new(0.12, 0.12, z1 - z0), rope, deco)
	box(m, "String", CFrame.new(x1, 1.25, (z0 + z1) / 2), Vector3.new(0.12, 0.12, z1 - z0), rope, deco)
	-- planks (two crossed layers) and bricks inside the lot
	box(m, "Planks", CFrame.new(-6, 0.25, 1.5) * CFrame.Angles(0, math.rad(8), 0), Vector3.new(4.5, 0.5, 1.6), C.PlankLight, plank)
	box(m, "Planks", CFrame.new(-6, 0.75, 1.6) * CFrame.Angles(0, math.rad(-6), 0), Vector3.new(4.0, 0.5, 1.4), C.Plank, plank)
	box(m, "Bricks", CFrame.new(6, 0.5, 2.5), Vector3.new(2.4, 1.0, 1.6), rgb(220, 120, 80), { Shadow = false })
	box(m, "Bricks", CFrame.new(5.8, 1.25, 2.5) * CFrame.Angles(0, math.rad(10), 0), Vector3.new(1.6, 0.5, 1.2), rgb(232, 140, 98), { Shadow = false })
	templates.HouseLot = tpl
	return tpl
end

local function refreshLot(rec)
	local existing = rec.Home:FindFirstChild("HouseLot")
	local want = ownerId(rec) ~= 0 and (rec.Levels.House or 0) <= 0
	if want and not existing then
		local cat = catalog()
		local def = cat and cat.Get("House")
		if def and type(def.Slot) == "table" and typeof(def.Slot.CFrame) == "CFrame" then
			local m = cloneAt(lotTemplate(), rec.CF * def.Slot.CFrame)
			m.Name = "HouseLot"
			m.Parent = rec.Home
		end
	elseif existing and not want then
		existing:Destroy()
	end
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function stationDef(id)
	local cat = catalog()
	if not cat or type(id) ~= "string" then
		return nil
	end
	local def = cat.Get(id)
	if type(def) ~= "table" or def.Kind == "Prestige" or type(def.Slot) ~= "table" or typeof(def.Slot.CFrame) ~= "CFrame" then
		return nil
	end
	return def
end

local function applyOwnerAttr(rec, root)
	local uid = ownerId(rec)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name ~= "ClaimPrompt" then
			if d:GetAttribute("OwnerUserId") ~= uid then
				d:SetAttribute("OwnerUserId", uid)
			end
			-- buy pads follow their lock; garden places follow SetGarden (Garden.applyPrompts)
			if d.Name ~= "BuyPrompt" and d.Name ~= "GardenSpotPrompt" then
				d.Enabled = uid ~= 0
			end
		end
	end
	root:SetAttribute("OwnerUserId", uid)
end

----------------------------------------------------------------------
-- Garden places (SetGarden) and training mats (SetTraining): per-plot state re-applied to every rebuilt model
----------------------------------------------------------------------
function Garden.openOf(rec)
	local g = rec.Garden
	if g and g.Open then
		return g.Open
	end
	return Garden.defaultOpen()
end

-- GardenSpotPrompt.Enabled = owned AND open AND empty; OwnerUserId on every one (written only on change)
function Garden.applyPrompts(rec)
	local model = rec.Stations.Garden
	if not model then
		return
	end
	local uid = ownerId(rec)
	local open = Garden.openOf(rec)
	local valid = (rec.Garden and rec.Garden.Valid) or {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "GardenSpotPrompt" then
			local slot = tonumber(d:GetAttribute("Slot")) or 0
			local want = uid ~= 0 and slot >= 1 and slot <= open and valid[slot] == nil
			if d.Enabled ~= want then
				d.Enabled = want
			end
			if d:GetAttribute("OwnerUserId") ~= uid then
				d:SetAttribute("OwnerUserId", uid)
			end
		end
	end
end

-- the training mats show who trains on them: attributes Busy / Key / Stat / Ends on each Spot<i> (on change only)
function Garden.applyTraining(rec)
	local model = rec.Stations.Gym
	if not model then
		return
	end
	local pets = rec.Training or {}
	for i = 1, 5 do
		local att = model:FindFirstChild("Spot" .. i, true)
		if att then
			local job = pets[i]
			local busy = job ~= nil
			local values = {
				Busy = busy,
				Key = busy and job.Key or "",
				Stat = busy and job.Stat or "",
				Ends = busy and job.Ends or 0,
			}
			for name, v in pairs(values) do
				if att:GetAttribute(name) ~= v then
					att:SetAttribute(name, v)
				end
			end
		end
	end
end

local function removeGhost(rec, id)
	local g = rec.Ghosts[id]
	if g then
		g:Destroy()
		rec.Ghosts[id] = nil
	end
end

----------------------------------------------------------------------
-- Phase 6 (art-home, ARCHITECTURE_V3 6.1 A7 / recipe 4.8 "World path"): Blender meshes for the station art. Every
-- placed station is tagged with MeshLibrary.Tag(station, "home_<stem>_<level>"): the client hides the Part build
-- locally and shows the fine-voxel mesh (blender/catalog/home.json, built by blender/kit/props/home*.py from THIS
-- file's own Part build). The Part build stays: colliders, names, prompts, attachments, signs and the fallback.
-- Kept visible over the mesh (Mesh.keepOf): Neon / ForceField glow (HomeFx and the light pulse them), the parts HomeFx
-- moves (the Fusion `Swirl`), SurfaceGui sign boards (text stays Parts) and the Garden's bed pieces, which carry one
-- key each (home_bed_<piece>, tagged per Part, so a bed swap never needs a new station key). A key is tagged only
-- when it has an uploaded id (MeshLibrary.Status ~= "missing": the shipped empty MeshIds change nothing) and while
-- its manifest's "LayoutSig" (part count + position / size sums of the Part build it was baked from) still matches
-- the live build, so a later art change can never show a stale mesh. The kit reads Mesh.keepOf / Mesh.signature
-- through HomeBuilder._Mesh, so both sides use the same rules.
----------------------------------------------------------------------
local Mesh = {
	Lib = nil,
	-- key stem per station Kind (decor per Id): home_<stem>_<level>
	Stems = {
		Farm = "farm", Garden = "garden", FoodMachine = "foodmachine", Training = "training", Vault = "vault",
		House = "house", Fusion = "fusion", Arena = "arena", DecorFence = "fence", DecorFountain = "fountain",
		DecorPodium = "podium",
	},
	-- per-Part element keys (station Kind -> part name -> key); the element meshes' own parts use the same names
	Elements = {
		-- the Berry Farm's propeller weathervane: its own key so HomeFx can spin it (bug #20 option B)
		Farm = { Propeller = "home_farm_propeller" },
		Garden = {
			Bed = "home_bed_frame", Cushion = "home_bed_cushion", Headboard = "home_bed_headboard",
			BedRoof = "home_bed_roof", SoilBed = "home_bed_soil", Stem = "home_bed_stem", Sprout = "home_bed_sprout",
			Post = "home_bed_post",
		},
	},
	NoElements = {},
}

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" and type(result.Status) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

function Mesh.elementsOf(def)
	return (def and Mesh.Elements[def.Kind]) or Mesh.NoElements
end

-- the part names that stay visible over a dressed station (sorted list) + the set
function Mesh.keepOf(model, elements)
	local set = {}
	for name in pairs(elements or Mesh.NoElements) do
		set[name] = true
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local keep = d.Material == MAT.Neon or d.Material == MAT.ForceField
				or (d.Material ~= MAT.Glass and d.Transparency > 0.05 and d.Transparency < 0.99)
				or d:FindFirstChildWhichIsA("SurfaceGui") ~= nil
			local a = d.Parent
			while not keep and a and a ~= model do
				if a.Name == "Swirl" then
					keep = true
				end
				a = a.Parent
			end
			if keep then
				set[d.Name] = true
			end
		end
	end
	local list = {}
	for name in pairs(set) do
		list[#list + 1] = name
	end
	table.sort(list)
	return list, set
end

-- part count + weighted sums of the visible, not kept BaseParts in `origin` space (LobbyBuilder Mesh.Signature's
-- formula; the kit stores the same numbers as the manifest attachment "LayoutSig")
function Mesh.signature(target, origin, skip)
	local inv = origin:Inverse()
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 and not (skip and skip[d.Name]) then
			local p = inv * d.Position
			local s = d.Size
			n = n + 1
			a = a + p.X + p.Y * 0.37 + p.Z * 0.61
			b = b + s.X + s.Y * 1.3 + s.Z * 1.7
		end
	end
	return n, a, b
end

function Mesh.sigOk(ML, key, n, a, b)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	local att = man and man.Attachments and (man.Attachments.LayoutSig or man.Attachments.layoutSig)
	local pos = att and (att.Pos or att.pos)
	if type(pos) ~= "table" then
		return false -- every home key is baked from a layout
	end
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- per template (cached): the station key, keep list and layout signature in template space
function Mesh.info(def, level, tpl)
	if tpl.Mesh then
		return tpl.Mesh
	end
	local stem = Mesh.Stems[def.Id] or Mesh.Stems[def.Kind]
	local elements = Mesh.elementsOf(def)
	local keepList, keepSet = Mesh.keepOf(tpl.Model, elements)
	local n, a, b = Mesh.signature(tpl.Model, CFrame.new(), keepSet)
	tpl.Mesh = { Key = stem and ("home_" .. stem .. "_" .. level) or nil, Keep = keepList, Sig = { n, a, b } }
	return tpl.Mesh
end

-- tags a placed station (model pivot = cf) and its element parts; returns the number of tags. pinned = true (a station
-- placed on its plot, it never moves): the mesh spot is written as the world CFrame `cf` itself (ML_At), so a client
-- that dresses while the Model is still replicating (its PrimaryPart, the biggest part, may arrive last: the farm's
-- Cabin) never reads another pivot than the server did (bug #20 "two farms": the mesh ~16 studs along the field)
function Mesh.station(m, def, level, tpl, cf, pinned)
	local ML = Mesh.lib()
	if not ML or not tpl or not tpl.Model then
		return 0
	end
	local info = Mesh.info(def, level, tpl)
	local tags = 0
	local key = info.Key
	if key and ML.Status(key) ~= "missing" and Mesh.sigOk(ML, key, info.Sig[1], info.Sig[2], info.Sig[3]) then
		ML.Tag(m, key, { Offset = m:GetPivot():Inverse() * cf, At = pinned and cf or nil }, info.Keep)
		tags = tags + 1
	end
	local elements = Mesh.elementsOf(def)
	if next(elements) then
		for _, d in ipairs(m:GetDescendants()) do
			local ekey = d:IsA("BasePart") and elements[d.Name]
			if ekey and d.Transparency < 0.99 and ML.Status(ekey) ~= "missing" then
				local n, a, b = Mesh.signature(d, d.CFrame)
				if Mesh.sigOk(ML, ekey, n, a, b) then
					ML.Tag(d, ekey, { Primary = d.Color }, nil) -- a tinted piece (the cushions) takes the part's colour
					tags = tags + 1
				end
			end
		end
	end
	return tags
end

HomeBuilder._Mesh = Mesh

local function placeStation(rec, def, level)
	local accent = (typeof(rec.Spot.Accent) == "Color3") and rec.Spot.Accent or nil
	local tpl = stationTemplate(def, level, accent, (def.Kind == "Garden") and Garden.openOf(rec) or nil)
	local slotCF = rec.CF * def.Slot.CFrame
	local m = cloneAt(tpl, slotCF)
	m.Name = "Station_" .. def.Id
	m:SetAttribute("StationId", def.Id)
	m:SetAttribute("Level", level)
	m:SetAttribute("Kind", def.Kind)
	m:SetAttribute("BuiltAt", serverNow())
	for name, p in pairs(tpl.Points) do
		m:SetAttribute(name, (slotCF * CFrame.new(p)).Position)
	end
	for name, v in pairs(tpl.Info) do
		m:SetAttribute(name, v)
	end
	applyOwnerAttr(rec, m)
	Mesh.station(m, def, level, tpl, slotCF, true) -- Phase 6: the Blender mesh (no-op without uploaded ids), pinned
	return m
end

-- after a station model is placed: the per-plot state that lives on it (garden prompts, training mats)
local function afterPlace(rec, def)
	if def.Kind == "Garden" then
		Garden.applyPrompts(rec)
	elseif def.Kind == "Training" then
		Garden.applyTraining(rec)
	end
end

function HomeBuilder.SetStation(spotInfo, stationId, level)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	local def = stationDef(stationId)
	if not rec or not def then
		return nil
	end
	level = tonumber(level)
	if not level or level ~= level then
		return nil
	end
	level = floor(level)
	level = max(0, min(level, def.MaxLevel or level))
	local current = rec.Stations[stationId]
	if level == 0 then
		if current then
			current:Destroy()
		end
		rec.Stations[stationId] = nil
		rec.Levels[stationId] = nil
		if def.Kind == "House" then
			refreshLot(rec)
		end
		if HomeBuilder.StationBuilt then
			HomeBuilder.StationBuilt:Fire(rec.Spot, stationId, nil)
		end
		return nil
	end
	if current and current.Parent and rec.Levels[stationId] == level then
		return current
	end
	local ok, model = pcall(placeStation, rec, def, level)
	if not ok or not model then
		warn("[HomeBuilder] SetStation " .. tostring(stationId) .. " " .. tostring(level) .. " failed: " .. tostring(model))
		return nil
	end
	if current then
		current:Destroy()
	end
	removeGhost(rec, stationId)
	model.Parent = rec.Home
	rec.Stations[stationId] = model
	rec.Levels[stationId] = level
	afterPlace(rec, def)
	if def.Kind == "House" then
		refreshLot(rec)
	end
	if HomeBuilder.StationBuilt then
		HomeBuilder.StationBuilt:Fire(rec.Spot, stationId, model)
	end
	return model
end

-- every station of a Home table (others removed): a returning player's saved home on a fresh plot
function HomeBuilder.BuildHome(spotInfo, home)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	local cat = catalog()
	if not rec or not cat then
		return false
	end
	local stations = type(home) == "table" and type(home.Stations) == "table" and home.Stations or {}
	for _, def in ipairs(cat.Stations or {}) do
		HomeBuilder.SetStation(rec.Spot, def.Id, tonumber(stations[def.Id]) or 0)
	end
	return true
end

----------------------------------------------------------------------
-- Pads
----------------------------------------------------------------------
local function padSlot(id)
	local cat = catalog()
	local def = cat and cat.Get(id)
	if type(def) == "table" and type(def.Slot) == "table" and typeof(def.Slot.Pad) == "CFrame" then
		return def.Slot.Pad, def
	end
	return nil, def
end

-- (playtest 2026-11-28 C8) a pad's BuyPrompt reach: PROMPT_RANGE, cut so it never meets a Garden bed's reach. The
-- Garden pad (10.6 studs from beds 1/2), the Fence and the Podium pads reached into the beds' reach, and E goes to
-- whichever prompt the camera faces, so the bed the guide called "you're here" bought the $15K Garden upgrade. A
-- purchase stays one deliberate step onto (or beside) its 4 x 4 pad: never less than PAD_REACH_MIN. (C8 review) 4.3,
-- not 5: the reach is measured centre to centre (the root part ~3 studs over the pad: a corner of its top is ~3.9 from
-- the prompt, so 4.3 still covers the whole pad); at 5 the Gym and ArenaGate pads (8.4 / 8.3 studs from beds 1, 3, 5)
-- were held at 5 and met the beds' 4. (C8 review, round 3) the prompt hangs on an Attachment PromptPoint PROMPT_LIFT
-- over the pad's top (PAD_PROMPT_Y): on the Base a 4.5-stud root was 4.8 from it even dead centre. Lifted, the floor is
-- 4.0: it reaches >= 3.7 across for a root 3 to 4.5 studs up (the pad's corner is 2.8 out), and the lifted bed prompts
-- sit level with it (8.24 studs from the ArenaGate pad's, so 4.3 + 4 would meet; the cut gives it 4.2).
local PAD_REACH_MIN = 4.0
local PAD_PROMPT_Y = PAD_TOP + PROMPT_LIFT -- the BuyPrompt's point over the pad's origin
local function padReach(slotCF)
	local cat = catalog()
	local gdef = cat and cat.Get("Garden")
	local gcf = type(gdef) == "table" and type(gdef.Slot) == "table" and gdef.Slot.CFrame
	if typeof(gcf) ~= "CFrame" then
		return PROMPT_RANGE
	end
	local at = (slotCF * CFrame.new(0, PAD_PROMPT_Y, 0)).Position
	local reach = PROMPT_RANGE
	for i = 1, #Garden.places(gdef) do
		local p = Garden.promptPoint(gdef, i)
		if p then
			reach = math.min(reach, ((gcf * CFrame.new(p)).Position - at).Magnitude - Garden.PROMPT_RANGE)
		end
	end
	return math.max(PAD_REACH_MIN, math.floor(reach * 10) / 10)
end

-- "x1.25" (two decimals at most, no trailing zeros)
local function multText(m)
	local text = string.format("%.2f", m):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

local function priceText(pad)
	local price = tonumber(pad.Price) or 0
	if pad.Prestige or pad.StationId == "Prestige" then
		-- what the reset buys: every star multiplies the income (the Home window says the same, per star)
		local cat = catalog()
		local m = cat and type(cat.Prestige) == "table" and tonumber(cat.Prestige.IncomeMultiplier) or nil
		if m and m == m and m > 1 and m < 100 then
			return "Reset: " .. multText(m) .. " income"
		end
		return "Start over: +1 star"
	end
	if price <= 0 then
		return "FREE"
	end
	return formatCash(price)
end

local function padSignature(pad, uid)
	return table.concat({
		tostring(pad.NextLevel), tostring(pad.Price), tostring(pad.Locked or ""), tostring(pad.Title or pad.Name), tostring(pad.LevelText), tostring(uid), padState(pad),
	}, "|")
end

-- (kit-b world signs) a pad sign's accent, its stone card's lip: build green, upgrade gold, locked the well's stone edge,
-- Prestige violet (the kit's own colours; PAD_COLORS stays the pads' glowing plates)
local PAD_ACCENT = {
	Build = Sign.Grass,
	Upgrade = Sign.Gold,
	Locked = Sign.WellEdge,
	Prestige = Sign.Violet,
}

-- the floating sign (pixel tag): icon + name, then "Lv a -> b" + price, or the lock reason; a stone card (kit-b world
-- signs: the name and the price in the ink, the level and the lock reason in the muted ink, the lip in PAD_ACCENT)
local function buildPadSign(anchor, pad, state)
	local gui = newTag(anchor, "PadSign", 360, 130, PAD_SIGN_RANGE)
	gui.StudsOffsetWorldSpace = Vector3.new(0, PAD_SIGN_LIFT, 0)
	local plate = tagPlate(gui, PAD_ACCENT[state] or Sign.Gold)
	local row1 = plainFrame(plate, "NameRow", { LayoutOrder = 1 })
	listLayout(row1, Enum.FillDirection.Horizontal, 6)
	-- (kit-b U7b) the station's PixelIcon in a fixed box (an empty label would size to nothing)
	local icon = tagText(row1, "Icon", "", "Title", TAG_NAME, Sign.Text, 1)
	icon.AutomaticSize = Enum.AutomaticSize.None
	icon.Size = UDim2.fromOffset(TAG_NAME + 4, TAG_NAME + 4)
	PixelIcon.Host(icon, PixelIcon.Bitmaps[pad.Icon] and pad.Icon or PAD_ICON, PixelIcon.Snap(TAG_NAME))
	tagText(row1, "NameLabel", tostring(pad.Title or pad.Name or pad.StationId), "Title", TAG_NAME, Sign.Text, 2)
	local row2 = plainFrame(plate, "InfoRow", { LayoutOrder = 2 })
	listLayout(row2, Enum.FillDirection.Horizontal, 10)
	if state == "Locked" then
		PixelIcon.Lead(tagText(row2, "LockLabel", tostring(pad.Locked), "Body", TAG_INFO, Sign.TextMuted, 1), "lock") -- (kit-b U7b)
	else
		tagText(row2, "LevelLabel", tostring(pad.LevelText or ""), "Body", TAG_INFO, Sign.TextMuted, 1)
		tagText(row2, "PriceLabel", priceText(pad), "Display", TAG_PRICE, Sign.Text, 2)
	end
	tagFit(gui, plate, { row1, row2 })
	return gui
end

local function ghostFor(rec, id, def)
	if rec.Ghosts[id] or rec.Stations[id] or not def then
		return
	end
	-- def.Ghost = "Pad": no hologram, the locked pad and its sign say it all (the Fusion Machine: a silhouette of its
	-- glass pods / chamber read as a broken model, bug batch 2 #10)
	if def.Ghost == "Pad" then
		return
	end
	local ok, tpl = pcall(stationTemplate, def, 1, nil)
	if not ok or type(tpl) ~= "table" then
		return
	end
	local m = cloneAt(tpl, rec.CF * def.Slot.CFrame)
	m.Name = "Ghost_" .. id
	-- a silhouette needs only the biggest blocks: keep GHOST_PARTS of them
	local parts = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
		end
	end
	table.sort(parts, function(a, b)
		return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z
	end)
	for k = GHOST_PARTS + 1, #parts do
		parts[k]:Destroy()
	end
	-- drawn as a soft blue hologram (the ForceField material shimmers on its own: no animation needed)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = C.Ghost
			d.Material = MAT.ForceField
			d.Transparency = 0.3
			d.Reflectance = 0
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("ProximityPrompt") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("SurfaceGui") then
			d:Destroy()
		end
	end
	m:SetAttribute("StationId", id)
	m.Parent = rec.Home
	rec.Ghosts[id] = m
end

local function updatePad(rec, pad)
	local id = pad.StationId
	local slotCF, def = padSlot(id)
	if not slotCF then
		return nil
	end
	local uid = ownerId(rec)
	local state = padState(pad)
	local sig = padSignature(pad, uid)
	local entry = rec.Pads[id]
	if entry and entry.Sig == sig and entry.Model.Parent then
		return entry
	end
	-- the pad parts only change with the state; the sign and the attributes with every change
	if not entry or entry.State ~= state or not entry.Model.Parent then
		if entry then
			entry.Model:Destroy()
		end
		local m = cloneAt(padTemplate(state), rec.CF * slotCF)
		m.Name = "Pad_" .. id
		m:SetAttribute("BuiltAt", serverNow())
		local base = m:FindFirstChild("Base")
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "BuyPrompt"
		-- the Prestige pad buys nothing: a deliberate hold opens the Home window's prestige confirmation
		local prestigePad = id == "Prestige"
		prompt.ActionText = prestigePad and "Prestige" or "Buy"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = prestigePad and PRESTIGE_HOLD or 0.25
		prompt.MaxActivationDistance = padReach(slotCF) -- (playtest 2026-11-28 C8) never into a Garden bed's reach
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("StationId", id)
		if base then
			-- (playtest 2026-11-28 C8 review) at a standing root's height over the pad, not on the Base (0.2 up)
			local point = Instance.new("Attachment")
			point.Name = "PromptPoint"
			point.CFrame = base.CFrame:Inverse() * (rec.CF * slotCF * CFrame.new(0, PAD_PROMPT_Y, 0))
			point.Parent = base
			prompt.Parent = point
		else
			prompt.Parent = m
		end
		entry = { Model = m, Prompt = prompt, Anchor = base, State = state }
		rec.Pads[id] = entry
		m.Parent = rec.PadFolder
	end
	local m = entry.Model
	if id ~= "Prestige" then
		-- (playtest 2026-11-28 C8) a built station's pad says what E does: "Upgrade" (it said "Buy" at every level)
		entry.Prompt.ActionText = (tonumber(pad.Level) or 0) >= 1 and "Upgrade" or "Buy"
	end
	if entry.Sign then
		entry.Sign:Destroy()
	end
	entry.Sign = buildPadSign(entry.Anchor, pad, state)
	local locked = (pad.Locked ~= nil and pad.Locked ~= "") and tostring(pad.Locked) or ""
	m:SetAttribute("StationId", id)
	m:SetAttribute("OwnerUserId", uid)
	m:SetAttribute("NextLevel", tonumber(pad.NextLevel) or 1)
	m:SetAttribute("Level", tonumber(pad.Level) or 0)
	m:SetAttribute("Price", tonumber(pad.Price) or 0)
	m:SetAttribute("Locked", locked)
	m:SetAttribute("Title", tostring(pad.Title or pad.Name or id))
	m:SetAttribute("LevelText", tostring(pad.LevelText or ""))
	m:SetAttribute("Kind", tostring(pad.Kind or (def and def.Kind) or ""))
	entry.Prompt:SetAttribute("OwnerUserId", uid)
	entry.Prompt.ObjectText = tostring(pad.Title or pad.Name or id) .. ((locked == "") and ("  " .. priceText(pad)) or "")
	entry.Prompt.Enabled = locked == "" and uid ~= 0
	entry.Sig = sig
	-- a ghost of the station while it unlocks only later ("Unlocks at Prestige 1", "Coming soon")
	if locked ~= "" and (locked:find("Prestige", 1, true) or locked:find("Coming soon", 1, true)) and (tonumber(pad.Level) or 0) == 0 then
		ghostFor(rec, id, stationDef(id))
	else
		removeGhost(rec, id)
	end
	return entry
end

function HomeBuilder.SetPads(spotInfo, pads)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local keep = {}
	if type(pads) == "table" then
		for _, pad in ipairs(pads) do
			if type(pad) == "table" and type(pad.StationId) == "string" and not keep[pad.StationId] then
				local ok, entry = pcall(updatePad, rec, pad)
				if ok and entry then
					keep[pad.StationId] = true
				elseif not ok then
					warn("[HomeBuilder] pad " .. pad.StationId .. " failed: " .. tostring(entry))
				end
			end
		end
	end
	for id, entry in pairs(rec.Pads) do
		if not keep[id] then
			entry.Model:Destroy()
			rec.Pads[id] = nil
			removeGhost(rec, id)
		end
	end
	return true
end

----------------------------------------------------------------------
-- Owner, collector, clear
----------------------------------------------------------------------
function HomeBuilder.SetOwner(spotInfo, player)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local uid, name = 0, ""
	if typeof(player) == "Instance" and player:IsA("Player") then
		uid = player.UserId
		name = player.DisplayName ~= "" and player.DisplayName or player.Name
	end
	rec.OwnerUserId = uid
	rec.Home:SetAttribute("OwnerUserId", uid)
	rec.Home:SetAttribute("OwnerName", name)
	setClaimVisible(rec, uid == 0)
	setPaths(rec, uid ~= 0)
	refreshLot(rec)
	for _, model in pairs(rec.Stations) do
		applyOwnerAttr(rec, model)
	end
	Garden.applyPrompts(rec)
	for _, entry in pairs(rec.Pads) do
		entry.Model:SetAttribute("OwnerUserId", uid)
		entry.Prompt:SetAttribute("OwnerUserId", uid)
		local locked = entry.Model:GetAttribute("Locked")
		entry.Prompt.Enabled = uid ~= 0 and (locked == nil or locked == "")
		entry.Sig = nil
	end
	return true
end

-- SetGarden(spotInfo, valid, open): the Garden's open place count (3 + Prestige stars, at most 12: TycoonService's
-- GardenSlots, NOT the Garden level) and the placed keys valid = { [slot] = key }. A new open count rebuilds the
-- Garden model (template Garden:<level>:<open>); the GardenSpotPrompts follow the empty open places. Kept per plot,
-- so a Garden built later (or rebuilt with a new level) shows the same places.
function HomeBuilder.SetGarden(spotInfo, valid, open)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local cat = catalog()
	local def = stationDef("Garden")
	local places = def and #Garden.places(def) or ((cat and cat.Prestige and tonumber(cat.Prestige.GardenSlotsMax)) or 12)
	local slots = {}
	if type(valid) == "table" then
		for k, v in pairs(valid) do
			local slot = tonumber(k)
			if slot and slot == slot and slot >= 1 and slot <= places and slot == floor(slot) and type(v) == "string" and v ~= "" then
				slots[slot] = v
			end
		end
	end
	local before = Garden.openOf(rec)
	open = Garden.clampOpen((open == nil) and before or open, places)
	rec.Garden = { Open = open, Valid = slots }
	local model = rec.Stations.Garden
	if def and model and model.Parent and open ~= before and (rec.Levels.Garden or 0) > 0 then
		-- the places changed (a Prestige): rebuild the Garden with the new open count
		local ok, fresh = pcall(placeStation, rec, def, rec.Levels.Garden)
		if ok and fresh then
			model:Destroy()
			fresh.Parent = rec.Home
			rec.Stations.Garden = fresh
			if HomeBuilder.StationBuilt then
				HomeBuilder.StationBuilt:Fire(rec.Spot, "Garden", fresh)
			end
		else
			warn("[HomeBuilder] SetGarden rebuild failed: " .. tostring(fresh))
		end
	end
	Garden.applyPrompts(rec)
	if rec.Stations.Garden and rec.Stations.Garden:GetAttribute("Open") ~= open then
		rec.Stations.Garden:SetAttribute("Open", open)
	end
	return true
end

-- SetTraining(spotInfo, pets): pets = { [mat] = { Key, Stat, Ends } } (PetCareService; HomeFx reads the plot's
-- TrainingPets attribute). Only attributes on the mats' Spot<i> attachments: Busy, Key, Stat, Ends.
function HomeBuilder.SetTraining(spotInfo, pets)
	local rec = recordOf(spotInfo)
	if not rec then
		return false
	end
	local map = {}
	if type(pets) == "table" then
		for k, v in pairs(pets) do
			local mat = tonumber(k)
			if mat and mat == mat and mat >= 1 and mat <= 5 and mat == floor(mat) and type(v) == "table" then
				local ends = tonumber(v.Ends) or 0
				if ends ~= ends or ends == huge or ends == -huge then
					ends = 0
				end
				map[mat] = { Key = tostring(v.Key or ""), Stat = tostring(v.Stat or ""), Ends = floor(ends) }
			end
		end
	end
	rec.Training = map
	Garden.applyTraining(rec)
	return true
end

function HomeBuilder.ClearPlot(spotInfo)
	local rec = recordOf(spotInfo)
	if not rec then
		return false
	end
	for id, model in pairs(rec.Stations) do
		model:Destroy()
		rec.Stations[id] = nil
	end
	rec.Levels = {}
	for id, entry in pairs(rec.Pads) do
		entry.Model:Destroy()
		rec.Pads[id] = nil
	end
	for id in pairs(rec.Ghosts) do
		removeGhost(rec, id)
	end
	rec.Garden = nil
	rec.Training = nil
	-- anything else a caller parented under Home (but keep the Pads folder)
	for _, c in ipairs(rec.Home:GetChildren()) do
		if c ~= rec.PadFolder and c.Name ~= "Paths" and c.Name ~= "HouseLot" then
			c:Destroy()
		end
	end
	for _, c in ipairs(rec.PadFolder:GetChildren()) do
		c:Destroy()
	end
	if ownerId(rec) == 0 then
		setPaths(rec, false)
	end
	refreshLot(rec)
	return true
end

----------------------------------------------------------------------
-- Extras
----------------------------------------------------------------------
function HomeBuilder.GetHomeFolder(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and rec.Home or nil
end

function HomeBuilder.GetStation(spotInfo, id)
	local rec = recordOf(spotInfo)
	return rec and rec.Stations[id] or nil
end

function HomeBuilder.GetPad(spotInfo, id)
	local rec = recordOf(spotInfo)
	local entry = rec and rec.Pads[id]
	return entry and entry.Model or nil
end

function HomeBuilder.GetClaimPrompt(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and rec.ClaimPrompt or nil
end

function HomeBuilder.PartCount(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and countParts(rec.Home) or 0
end

-- a fresh copy of a station's model at the origin (front -Z), for renders and tests; open = the Garden's open place
-- count (default: Prestige.GardenSlotsBase)
function HomeBuilder.BuildStationModel(id, level, accent, open)
	local def = stationDef(id)
	if not def then
		return nil
	end
	level = max(1, min(floor(tonumber(level) or 1), def.MaxLevel or 1))
	local tpl = stationTemplate(def, level, accent, open)
	local m = cloneAt(tpl, CFrame.new())
	m.Name = "Station_" .. id
	m:SetAttribute("StationId", id)
	m:SetAttribute("Level", level)
	m:SetAttribute("Kind", def.Kind)
	for name, v in pairs(tpl.Info) do
		m:SetAttribute(name, v)
	end
	Mesh.station(m, def, level, tpl, CFrame.new()) -- Phase 6: the Blender mesh (no-op without uploaded ids)
	return m
end

-- local fx points of a station level (FruitPoint, MagnetCenter, ChuteMouth, Tray, HopperTop, SwirlCenter ...)
function HomeBuilder.Points(id, level)
	local def = stationDef(id)
	if not def then
		return nil
	end
	local tpl = stationTemplate(def, max(1, floor(tonumber(level) or 1)), nil)
	return tpl.Points, tpl.Info
end

HomeBuilder.Art = Art

function HomeBuilder.Init(info)
	if type(info) == "table" then
		lobbyInfo = info
	end
	initialized = true
	if type(lobbyInfo) == "table" and type(lobbyInfo.Spots) == "table" then
		for _, spot in pairs(lobbyInfo.Spots) do
			local ok, err = pcall(HomeBuilder.PreparePlot, spot)
			if not ok then
				warn("[HomeBuilder] PreparePlot failed: " .. tostring(err))
			end
		end
	end
	return true
end

function HomeBuilder.IsReady()
	return initialized
end

return HomeBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1099">
          <Properties>
            <string name="Name">IndexService</string>
            <string name="Source"><![CDATA[-- IndexService: Pet Index group rewards (ARCHITECTURE_V3.md section 3).
--
--   IndexService.Init(deps)                       deps = { DataService =, PetService = }
--   IndexService.CanClaim(player, groupId) -> bool, reason
--   IndexService.Claim(player, groupId)    -> ok, reason
--   IndexService.Completed                        Util.Signal, Fire(player, groupId) when a group becomes complete
--                                                 (its last pet was just discovered; the tutorial may listen)
--   Extras: IndexService.Claimed (Util.Signal, Fire(player, groupId, tokens) after a successful claim),
--           IndexService.GetProgress(player) -> { [groupId] = { Found, Total, Complete, Claimed, Reward } }
--
-- A group is one rarity (PetCatalog.IndexGroups). It is complete when every pet in it is in the profile's
-- Discovered set; its Config.Index reward can be claimed once (Profile.IndexClaimed[groupId] = true). Claims wait
-- while DataService.IsProvisional(player) (a load that failed during an outage: the defaults cannot tell which
-- rewards were already claimed).
-- Everything is server authoritative: the client only sends a group id through the IndexClaim remote, which
-- is type checked and rate limited; the reward goes through DataService.AddTokens, then the profile is synced.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local IndexService = {}
IndexService.Completed = Util.Signal()
IndexService.Claimed = Util.Signal()

local CLAIM_COOLDOWN = 0.5 -- seconds per player between IndexClaim requests
local MAX_ID_LENGTH = 48
local REMINDER_DELAY = 8 -- seconds after joining before the "unclaimed reward" reminder toast

----------------------------------------------------------------------
-- Collaborators (resolved defensively: other modules may be missing or broken)
----------------------------------------------------------------------

local function loadModule(parent, name)
	local module = parent and parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[IndexService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local PetCatalog = loadModule(Shared, "PetCatalog")
local DataService = nil
local PetService = nil

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local groups = {} -- array of { Id, Rarity, Pets = {PetDef...}, Reward } in rarity order
local groupById = {} -- [groupId] = group
local groupOfPet = {} -- [petId] = groupId

local completeState = {} -- [player] = { [groupId] = true } groups already complete (edge detection)
local lastClaim = {} -- [player] = os.clock() of the last accepted IndexClaim
local reminded = {} -- [player] = true once the unclaimed-reward reminder was sent this session
local initialized = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function fireClient(remoteName, player, ...)
	local ok, remote = pcall(Remotes.Get, remoteName)
	if ok and remote and player and player.Parent then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 4)
end

local function commas(n)
	local ok, text = pcall(Util.Commas, n)
	if ok and type(text) == "string" then
		return text
	end
	return tostring(n)
end

-- (Re)builds the group tables from the catalog (static data, so once is enough).
local function buildGroups()
	groups, groupById, groupOfPet = {}, {}, {}
	if not PetCatalog or type(PetCatalog.IndexGroups) ~= "function" then
		return
	end
	local ok, list = pcall(PetCatalog.IndexGroups)
	if not ok or type(list) ~= "table" then
		warn("[IndexService] PetCatalog.IndexGroups failed: " .. tostring(list))
		return
	end
	for _, group in ipairs(list) do
		if type(group) == "table" and type(group.Id) == "string" and type(group.Pets) == "table" and #group.Pets > 0 then
			table.insert(groups, group)
			groupById[group.Id] = group
			for _, def in ipairs(group.Pets) do
				if type(def) == "table" and type(def.Id) == "string" then
					groupOfPet[def.Id] = group.Id
				end
			end
		end
	end
end

-- Token reward of a group (Config.Index is the source of truth; the catalog copy is a fallback).
local function rewardTokens(group)
	local index = Config.Index
	local rewards = type(index) == "table" and index.Rewards
	local reward = type(rewards) == "table" and rewards[group.Id]
	if type(reward) ~= "table" then
		reward = group.Reward
	end
	local tokens = type(reward) == "table" and reward.Tokens
	if type(tokens) == "number" and tokens == tokens and tokens > 0 and tokens < math.huge then
		return math.floor(tokens)
	end
	return 0
end

local function getProfile(player)
	if not DataService or type(DataService.GetProfile) ~= "function" then
		return nil
	end
	local ok, profile = pcall(DataService.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

-- found, total for one group of a profile (an owned pet always counts as discovered).
local function groupProgress(profile, group)
	local discovered = type(profile.Discovered) == "table" and profile.Discovered or {}
	local owned = type(profile.Pets) == "table" and profile.Pets or {}
	local found = 0
	for _, def in ipairs(group.Pets) do
		local count = owned[def.Id]
		if discovered[def.Id] == true or (type(count) == "number" and count > 0) then
			found = found + 1
		end
	end
	return found, #group.Pets
end

local function isClaimed(profile, groupId)
	return type(profile.IndexClaimed) == "table" and profile.IndexClaimed[groupId] == true
end

local function isComplete(profile, group)
	local found, total = groupProgress(profile, group)
	return total > 0 and found >= total
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function IndexService.CanClaim(player, groupId)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(groupId) ~= "string" or #groupId == 0 or #groupId > MAX_ID_LENGTH then
		return false, "Unknown Index group"
	end
	if not DataService or #groups == 0 then
		return false, "The Pet Index is unavailable right now"
	end
	local group = groupById[groupId]
	if not group then
		return false, "Unknown Index group"
	end
	local profile = getProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	-- a profile whose load failed (DataStore outage) holds defaults: its IndexClaimed cannot tell what was claimed
	if type(DataService.IsProvisional) == "function" then
		local okProvisional, provisional = pcall(DataService.IsProvisional, player)
		if okProvisional and provisional == true then
			return false, "Your data is still loading"
		end
	end
	if isClaimed(profile, groupId) then
		return false, "Already claimed"
	end
	local found, total = groupProgress(profile, group)
	if found < total then
		return false, string.format("Discover every %s pet first (%d/%d)", groupId, found, total)
	end
	if rewardTokens(group) <= 0 then
		return false, "This group has no reward"
	end
	return true
end

function IndexService.Claim(player, groupId)
	local ok, reason = IndexService.CanClaim(player, groupId)
	if not ok then
		return false, reason
	end
	local group = groupById[groupId]
	local profile = getProfile(player)
	if not group or not profile then
		return false, "Your data is still loading"
	end
	local tokens = rewardTokens(group)
	-- Nothing below yields: the claimed flag is written before the tokens, so a claim pays exactly once.
	if type(profile.IndexClaimed) ~= "table" then
		profile.IndexClaimed = {}
	end
	profile.IndexClaimed[groupId] = true
	if type(DataService.AddTokens) == "function" then
		DataService.AddTokens(player, tokens)
	end
	if type(DataService.MarkDirty) == "function" then
		DataService.MarkDirty(player)
	end
	if type(DataService.Sync) == "function" then
		DataService.Sync(player)
	end
	notify(player, "Pet Index: " .. groupId .. " complete! +" .. commas(tokens) .. " Cloud Tokens", "token", 4)
	IndexService.Claimed:Fire(player, groupId, tokens)
	return true
end

-- Extra: per-group progress for a player (empty table until the profile is loaded).
function IndexService.GetProgress(player)
	local out = {}
	local profile = player and getProfile(player)
	if not profile then
		return out
	end
	for _, group in ipairs(groups) do
		local found, total = groupProgress(profile, group)
		out[group.Id] = {
			Found = found,
			Total = total,
			Complete = total > 0 and found >= total,
			Claimed = isClaimed(profile, group.Id),
			Reward = rewardTokens(group),
		}
	end
	return out
end

----------------------------------------------------------------------
-- Completion tracking (Completed signal + side toasts)
----------------------------------------------------------------------

-- Remembers which groups are complete right now without announcing them (join / rebase).
local function primePlayer(player)
	local profile = getProfile(player)
	if not profile then
		return
	end
	local state = {}
	local unclaimed = 0
	for _, group in ipairs(groups) do
		if isComplete(profile, group) then
			state[group.Id] = true
			if not isClaimed(profile, group.Id) and rewardTokens(group) > 0 then
				unclaimed = unclaimed + 1
			end
		end
	end
	completeState[player] = state
	-- once per session: a gentle side toast when a finished group still waits for its reward
	if unclaimed > 0 and not reminded[player] then
		reminded[player] = true
		task.delay(REMINDER_DELAY, function()
			if isLivePlayer(player) then
				local text = "You have an unclaimed Pet Index reward! Open the Index to claim it."
				if unclaimed > 1 then
					text = "You have " .. unclaimed .. " unclaimed Pet Index rewards! Open the Index to claim them."
				end
				notify(player, text, "good", 5)
			end
		end)
	end
end

-- After a discovery: fires Completed for every group that just became complete.
local function checkCompletions(player, petId)
	if not isLivePlayer(player) then
		return
	end
	local profile = getProfile(player)
	if not profile then
		return
	end
	local state = completeState[player]
	if not state then
		state = {}
		completeState[player] = state
	end
	-- the rolled pet's group first (the common case), then the rest (cheap: a handful of groups)
	local order = {}
	local first = type(petId) == "string" and groupOfPet[petId]
	if first and groupById[first] then
		table.insert(order, groupById[first])
	end
	for _, group in ipairs(groups) do
		if group.Id ~= first then
			table.insert(order, group)
		end
	end
	for _, group in ipairs(order) do
		if not state[group.Id] and isComplete(profile, group) then
			state[group.Id] = true
			if not isClaimed(profile, group.Id) then
				local tokens = rewardTokens(group)
				if tokens > 0 then
					notify(player, "Pet Index: every " .. group.Id .. " pet found! Claim " .. commas(tokens) .. " tokens in the Index.", "good", 5)
				end
			end
			IndexService.Completed:Fire(player, group.Id)
		end
	end
end

-- Extra: re-checks a player's groups after a discovery that did not come through PetService.Rolled.
function IndexService.Refresh(player, petId)
	checkCompletions(player, petId)
end

----------------------------------------------------------------------
-- Remote + lifecycle wiring
----------------------------------------------------------------------

local function connectRemote()
	local ok, remote = pcall(Remotes.Get, "IndexClaim")
	if not ok or not remote then
		warn("[IndexService] remote IndexClaim is missing (did Remotes.Init run?)")
		return
	end
	remote.OnServerEvent:Connect(function(player, groupId)
		if not isLivePlayer(player) then
			return
		end
		local now = os.clock()
		local last = lastClaim[player]
		if last and now - last < CLAIM_COOLDOWN then
			return
		end
		lastClaim[player] = now
		if type(groupId) ~= "string" or #groupId == 0 or #groupId > MAX_ID_LENGTH then
			return
		end
		local pok, success, reason = pcall(IndexService.Claim, player, groupId)
		if not pok then
			warn("[IndexService] Claim errored: " .. tostring(success))
			notify(player, "Something went wrong, try again", "bad", 3)
			return
		end
		if not success and reason then
			notify(player, tostring(reason), "bad", 3)
		end
	end)
end

local function hasSignal(module, name)
	return type(module) == "table" and type(module[name]) == "table" and type(module[name].Connect) == "function"
end

local function connectSignals()
	if hasSignal(PetService, "Rolled") then
		PetService.Rolled:Connect(function(player, petId)
			checkCompletions(player, petId)
		end)
	else
		warn("[IndexService] PetService.Rolled is missing: Index completions are only checked on claim")
	end
	if hasSignal(DataService, "ProfileLoaded") then
		DataService.ProfileLoaded:Connect(function(player)
			primePlayer(player)
		end)
	end
	if hasSignal(DataService, "ProfileRebased") then
		DataService.ProfileRebased:Connect(function(player)
			primePlayer(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		completeState[player] = nil
		lastClaim[player] = nil
		reminded[player] = nil
	end)
	-- players whose profile loaded before Init
	for _, player in ipairs(Players:GetPlayers()) do
		if getProfile(player) then
			task.spawn(primePlayer, player)
		end
	end
end

function IndexService.Init(deps)
	if initialized then
		return
	end
	initialized = true
	if type(deps) == "table" then
		DataService = deps.DataService
		PetService = deps.PetService
	end
	local services = script.Parent
	if type(DataService) ~= "table" then
		DataService = loadModule(services, "DataService")
	end
	if type(PetService) ~= "table" then
		PetService = loadModule(services, "PetService")
	end
	if not PetCatalog then
		PetCatalog = loadModule(Shared, "PetCatalog")
	end
	buildGroups()
	if #groups == 0 then
		warn("[IndexService] no Pet Index groups (PetCatalog missing?): claims are refused")
	end
	if not DataService then
		warn("[IndexService] DataService is missing: claims are refused")
	end
	connectRemote()
	connectSignals()
end

return IndexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1100">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- LeaderboardService (lobby shop; docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.10 and 7, with section 15: the
-- third page is Ring best, there is no Climb wins page): the global top 10 of Trophies, Pets found and Ring best, one
-- OrderedDataStore per stat (Config.Leaderboard.Stores). The client sends nothing; nothing a client says reaches a write.
--
-- Values (ValueOf): Trophies = the profile's Battle.Trophies; Pets = the Discovered keys that are PetCatalog ids; Ring =
-- DataService.GetRing(player).Best. Whole numbers clamped to 0 .. MaxValue, nil while the profile is loading or
-- provisional (a stand-in value is never written or shown). The store key is tostring(UserId).
--
-- Writes (OrderedDataStore:SetAsync, pcall): only from a loaded, non-provisional profile; none without a store, none while
-- RunService:IsStudio() and WriteInStudio is false; none for a developer account in a live server (DevService.IsAllowed,
-- asked once per track: its tools grant pets and gems; review round 1). A player's first write SeedDelay s after the load, only for a value
-- above 0; then a sweep every SweepSeconds writes a changed value, at most once per WriteEvery per stat; a leave writes once
-- what changed in this session; BindToClose writes what changed and waits at most CLOSE_SECONDS. Every write first needs the
-- SetIncrementSortedAsync request budget at BudgetFloor.Write or more, else it waits for the next sweep.
--
-- Reads: at boot each stat once, BOOT_GAP s apart; then every RefreshSeconds per stat, GetSortedAsync(false, ReadSize)'s
-- first page (pcall). A GetSortedAsync budget under BudgetFloor.Read postpones the read by RetrySeconds[1] without counting
-- a failure; a failed read keeps the last good page and retries after RetrySeconds[1], [2], ... (the last repeats). Names of
-- the Top rows: one batched UserService:GetUserInfosByUserIdsAsync call (cached for the server's life), then
-- Players:GetNameFromUserIdAsync, then "Player" (not cached: asked again at the next read).
--
-- Scope: "Global" once every stat has a good page. "Server" before that (a fresh server never shows an empty board), after
-- failures before the first good read, and for good when there is no store (Studio without API access): the live values of
-- the players in this server (above 0), sorted, rebuilt every FallbackRefresh s.
--
-- LeaderboardState (server -> client): State(player) when the profile loads (or a stand-in recovers), after every refresh,
-- and when the player's own values change (DataService has no signal for them: a PollSeconds poll of the live values).
-- NextAt / UpdatedAt are workspace:GetServerTimeNow() times (the client counts down on the same clock).
--
-- Titles (spec 16.6, Config.Leaderboard.RankTitles): only this service writes them, only from what the server read. The
-- rank is the player's index in the good page of RankTitles.Stat (Trophies), up to Gold; none before the first good page,
-- with no store, or outside the read (the other pages and the board's Scope do not matter). Creator: DevService.IsOwner
-- (the game's creator or the owning group's owner; never Config.Dev.Admins or Studio), asked once per join in a task;
-- a nil answer (the group call failed) is asked again at the next title refresh. Kind: Creator wins (TitleRank still set),
-- else rank <= Rainbow -> "Top10", rank <= Gold -> "Top100". applyTitle writes only what changed: the attributes
-- Config.Attr.Title / TitleRank and leaderstats.<Column>.Value = ColumnText[kind] or "". PlayerService makes leaderstats
-- and its values (Tokens, then Rank); this service never does: while the Rank value is missing one task waits for it
-- (RANK_WAIT s), else the next pass writes it. Passes: Players.PlayerAdded (titles need no profile), the owner's answer,
-- every player after each good read of the title stat, and (with no store, so no reads) each "Server" rebuild. A leave
-- drops the player's entries; each refresh also drops the entries of players no longer in the server.
--
-- Public API
--   LeaderboardService.Init(deps)            deps = { DataService, DevService }
--   LeaderboardService.TitleOf(player) -> kind ("Creator" | "Top10" | "Top100") | nil, rank (1..Gold) | nil  (read only)
--   LeaderboardService.ValueOf(player, stat) -> whole number | nil
--   LeaderboardService.State(player) -> { Stats = { [stat] = { Top = { { UserId, Name, Value }... <= Top },
--                                                              You = { Rank = n | nil, Value = n | nil } } },
--                                         Scope = "Global" | "Server", NextAt, UpdatedAt }
--   LeaderboardService.Scope() -> "Global" | "Server"
--   LeaderboardService._S, _StopForTest(), _CloseForTest()   (smoke tests: a stopped copy drops its connections and loops)
--   LeaderboardService._JoinForTest(player)  (smoke lb_titles: the titles' PlayerAdded handler, run by hand)
--
-- Plain Lua 5.1-compatible syntax only.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserService = game:GetService("UserService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local PetCatalog = require(Shared.PetCatalog)

local LeaderboardService = {}

local TICK = 1 -- seconds between two passes of the scheduler (reads, the Server refresh, seeds, sweeps)
local BOOT_GAP = 3 -- seconds between the boot reads of two stats (the first BOOT_GAP s after Init)
local CLOSE_SECONDS = 5 -- BindToClose waits at most this long for its writes
local RANK_WAIT = 10 -- seconds a title waits for PlayerService's leaderstats.Rank before the next pass takes over

local S = {
	DS = nil,
	Dev = nil, -- DevService (IsOwner: the Creator title; IsAllowed: no global writes for a developer account)
	Started = false,
	Stopped = false,
	Closing = false,
	NoStore = false, -- no OrderedDataStore (Studio without API access): Scope "Server" for good, no reads, no writes
	Stores = {}, -- [stat] = OrderedDataStore
	Pages = {}, -- [stat] = { Entries = { { UserId, Value }... } | nil, Good, Fails, DueAt, UpdatedAt, Reading }
	Names = {}, -- [userId] = name (cached for the server's life)
	Recs = {}, -- [player] = { LoadedAt, SeedAt, Seeded, Base = {}, Written = {}, LastWrite = {}, Pending = {}, Sig, Dev }
	Server = { At = 0, Rows = {} }, -- the "Server" scope: Rows[stat] = sorted { { UserId, Name, Value }... }
	FallbackDueAt = 0,
	SweepDueAt = 0,
	InFlight = 0, -- write batches still running
	Writes = 0, -- SetAsync calls made (tests)
	Titles = {}, -- [player] = { Kind, Rank, Waiting }: the title last written (Waiting: a task waits for leaderstats.Rank)
	Owner = {}, -- [player] = true | false (DevService.IsOwner's answer) | "asking"; absent: not asked yet, or it failed
	TitleWrites = 0, -- title attribute / Rank writes made (tests)
	Conns = {},
}
LeaderboardService._S = S

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function cfg()
	return type(Config.Leaderboard) == "table" and Config.Leaderboard or {}
end

local function num(key, default)
	local v = tonumber(cfg()[key])
	if v == nil or v ~= v then
		return default
	end
	return v
end

local function stats()
	local pages = cfg().Pages
	return type(pages) == "table" and pages or {}
end

local function now()
	return Workspace:GetServerTimeNow()
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player")
end

local function displayName(player)
	local ok, name = pcall(function()
		return player.DisplayName
	end)
	if ok and type(name) == "string" and name ~= "" then
		return name
	end
	return player.Name
end

-- any value -> a whole number in 0 .. MaxValue
local function whole(v)
	v = tonumber(v)
	if v == nil or v ~= v or v <= 0 then
		return 0
	end
	local max = num("MaxValue", 1e12)
	if v >= max then
		return math.floor(max)
	end
	return math.floor(v)
end

-- the live profile, or nil while loading or provisional
local function profileOf(player)
	local DS = S.DS
	if not DS or not isPlayer(player) then
		return nil
	end
	local okProv, provisional = pcall(DS.IsProvisional, player)
	if not okProv or provisional then
		return nil
	end
	local ok, profile = pcall(DS.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local READ = {
	Trophies = function(_, profile)
		local battle = profile.Battle
		return type(battle) == "table" and battle.Trophies or 0
	end,
	Pets = function(_, profile)
		local n = 0
		local found = profile.Discovered
		if type(found) == "table" then
			for id, seen in pairs(found) do
				if seen == true and PetCatalog.Get(id) then
					n = n + 1
				end
			end
		end
		return n
	end,
	Ring = function(player)
		local ok, ring = pcall(S.DS.GetRing, player)
		if ok and type(ring) == "table" then
			return ring.Best
		end
		return nil
	end,
}

-- "v1|v2|v3": the player's own values (the poll compares it with what was last sent)
local function ownSig(player)
	local parts = {}
	for _, stat in ipairs(stats()) do
		parts[#parts + 1] = tostring(LeaderboardService.ValueOf(player, stat))
	end
	return table.concat(parts, "|")
end

local function send(player)
	if S.Stopped or not isPlayer(player) or player.Parent ~= Players then
		return
	end
	local rec = S.Recs[player]
	if rec then
		rec.Sig = ownSig(player)
	end
	local state = LeaderboardService.State(player)
	local ok, remote = pcall(Remotes.Get, "LeaderboardState")
	if ok and remote then
		pcall(remote.FireClient, remote, player, state)
	end
end

local function sendAll()
	for player in pairs(S.Recs) do
		send(player)
	end
end

-- the "Server" scope: this server's live values above 0, sorted (ties by UserId)
local function rebuildServer()
	local rows = {}
	for _, stat in ipairs(stats()) do
		rows[stat] = {}
	end
	for _, player in ipairs(Players:GetPlayers()) do
		for _, stat in ipairs(stats()) do
			local v = LeaderboardService.ValueOf(player, stat)
			if v and v > 0 then
				local list = rows[stat]
				list[#list + 1] = { UserId = player.UserId, Name = displayName(player), Value = v }
			end
		end
	end
	for _, list in pairs(rows) do
		table.sort(list, function(a, b)
			if a.Value ~= b.Value then
				return a.Value > b.Value
			end
			return a.UserId < b.UserId
		end)
	end
	S.Server.Rows = rows
	S.Server.At = now()
	S.FallbackDueAt = S.Server.At + num("FallbackRefresh", 30)
end

local function nameOf(userId)
	local name = S.Names[userId]
	if name then
		return name
	end
	local p = Players:GetPlayerByUserId(userId)
	if p then
		return displayName(p)
	end
	return "Player"
end

local function budget(kind)
	local ok, n = pcall(function()
		return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType[kind])
	end)
	return ok and tonumber(n) or 0
end

local function floorOf(key, default)
	local floors = cfg().BudgetFloor
	return type(floors) == "table" and tonumber(floors[key]) or default
end

local function writesAllowed()
	if S.NoStore or S.Stopped then
		return false
	end
	return not RunService:IsStudio() or cfg().WriteInStudio == true
end

-- The writes a record owes now ({ { stat, value }... }), marked pending. kind "sweep" (the seed is a record's first sweep)
-- honours WriteEvery; kind "leave" (a leave, BindToClose) writes what changed since the load or the last write.
local function owed(player, rec, kind, t)
	local out = {}
	if rec.Dev ~= false then
		return out -- a developer account, or its answer not in yet (see track)
	end
	for _, stat in ipairs(stats()) do
		local v = LeaderboardService.ValueOf(player, stat)
		local last = rec.Written[stat]
		local base = last
		if kind == "leave" and base == nil then
			base = rec.Base[stat]
		end
		local wanted = v ~= nil and v ~= base and (v > 0 or last ~= nil) and not rec.Pending[stat] and S.Stores[stat] ~= nil
		if wanted and kind == "sweep" and rec.LastWrite[stat] and t - rec.LastWrite[stat] < num("WriteEvery", 120) then
			wanted = false
		end
		if wanted and budget("SetIncrementSortedAsync") >= floorOf("Write", 20) then
			rec.Pending[stat] = true
			rec.LastWrite[stat] = t
			out[#out + 1] = { stat, v }
		end
	end
	return out
end

local function writeAll(userId, rec, list)
	if #list == 0 then
		return
	end
	S.InFlight = S.InFlight + 1
	task.spawn(function()
		for _, item in ipairs(list) do
			local stat, v = item[1], item[2]
			local store = S.Stores[stat]
			S.Writes = S.Writes + 1
			local ok = store ~= nil and pcall(function()
				store:SetAsync(tostring(userId), v)
			end)
			if ok then
				rec.Written[stat] = v
			end
			rec.Pending[stat] = nil
		end
		S.InFlight = S.InFlight - 1
	end)
end

local function retryAfter(fails)
	local list = type(cfg().RetrySeconds) == "table" and cfg().RetrySeconds or {}
	if #list == 0 then
		return 30
	end
	return tonumber(list[math.min(math.max(fails, 1), #list)]) or 30
end

-- a GetSortedAsync page -> { { UserId, Value }... } (bad keys dropped, at most ReadSize)
local function cleanPage(raw)
	local out = {}
	local size = math.floor(num("ReadSize", 100))
	for _, e in ipairs(raw) do
		if #out >= size then
			break
		end
		local userId = type(e) == "table" and tonumber(e.key) or nil
		if userId and userId > 0 and userId == math.floor(userId) then
			out[#out + 1] = { UserId = userId, Value = whole(e.value) }
		end
	end
	return out
end

-- the names of the Top rows not known yet (yields: called from a read's own thread)
local function resolveNames(entries)
	local ask = {}
	for i = 1, math.min(math.floor(num("Top", 10)), #entries) do
		local userId = entries[i].UserId
		if not S.Names[userId] then
			local p = Players:GetPlayerByUserId(userId)
			if p then
				S.Names[userId] = displayName(p)
			else
				ask[#ask + 1] = userId
			end
		end
	end
	if #ask == 0 then
		return
	end
	local ok, infos = pcall(function()
		return UserService:GetUserInfosByUserIdsAsync(ask)
	end)
	if ok and type(infos) == "table" then
		for _, info in ipairs(infos) do
			local id = type(info) == "table" and tonumber(info.Id) or nil
			local name = id and info.DisplayName
			if type(name) ~= "string" or name == "" then
				name = id and info.Username
			end
			if id and type(name) == "string" and name ~= "" then
				S.Names[id] = name
			end
		end
	end
	for _, userId in ipairs(ask) do
		if not S.Names[userId] then
			local okName, name = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if okName and type(name) == "string" and name ~= "" then
				S.Names[userId] = name
			end
		end
	end
end

----------------------------------------------------------------------
-- titles (spec 16.6)
----------------------------------------------------------------------
local function titleCfg()
	local t = cfg().RankTitles
	return type(t) == "table" and t or {}
end

-- the player's index in the good page of the title stat (1 .. Gold), or nil (no good page yet, no store, outside)
local function titleRank(player)
	local tc = titleCfg()
	local page = S.Pages[tc.Stat or "Trophies"]
	if S.NoStore or not page or not page.Good or type(page.Entries) ~= "table" then
		return nil
	end
	local gold = tonumber(tc.Gold) or 100
	for i, e in ipairs(page.Entries) do
		if i > gold then
			return nil
		end
		if e.UserId == player.UserId then
			return i
		end
	end
	return nil
end

-- kind ("Creator" | "Top10" | "Top100" | nil), rank: Creator wins over a rank (the rank is still given)
local function titleKind(player)
	local rank = titleRank(player)
	if S.Owner[player] == true then
		return "Creator", rank
	end
	if rank then
		return (rank <= (tonumber(titleCfg().Rainbow) or 10)) and "Top10" or "Top100", rank
	end
	return nil, nil
end

-- One player's title, written only where it changed: the two attributes and leaderstats.<Column>'s text. PlayerService
-- makes leaderstats and the Rank value; while it is missing one task waits RANK_WAIT s for it, else the next pass writes.
local function applyTitle(player)
	if S.Stopped or not isPlayer(player) or player.Parent ~= Players then
		return
	end
	local rec = S.Titles[player]
	if not rec then
		rec = { Kind = nil, Rank = nil, Waiting = false }
		S.Titles[player] = rec
	end
	local tc = titleCfg()
	local kind, rank = titleKind(player)
	rec.Kind, rec.Rank = kind, rank
	local attr = type(Config.Attr) == "table" and Config.Attr or {}
	local titleAttr, rankAttr = attr.Title or "Title", attr.TitleRank or "TitleRank"
	if player:GetAttribute(titleAttr) ~= kind then
		player:SetAttribute(titleAttr, kind)
		S.TitleWrites = S.TitleWrites + 1
	end
	if player:GetAttribute(rankAttr) ~= rank then
		player:SetAttribute(rankAttr, rank)
		S.TitleWrites = S.TitleWrites + 1
	end
	local text = kind and type(tc.ColumnText) == "table" and tc.ColumnText[kind] or ""
	local column = tc.Column or "Rank"
	local folder = player:FindFirstChild("leaderstats")
	local value = folder and folder:FindFirstChild(column)
	if value and value:IsA("StringValue") then
		if value.Value ~= text then
			value.Value = text
			S.TitleWrites = S.TitleWrites + 1
		end
	elseif not value and not rec.Waiting then
		rec.Waiting = true
		task.spawn(function()
			local t0 = now()
			local ok, found = pcall(function()
				local stats = player:WaitForChild("leaderstats", RANK_WAIT)
				local left = RANK_WAIT - (now() - t0)
				return stats and left > 0 and stats:WaitForChild(column, left) or nil
			end)
			rec.Waiting = false
			if ok and found and S.Titles[player] == rec then
				applyTitle(player)
			end
		end)
	end
end

-- DevService.IsOwner, asked once per join in its own task (a group game's rank is a web call); a nil answer (the call
-- failed) is asked again at the next title refresh
local function askOwner(player)
	local dev = S.Dev
	if S.Owner[player] ~= nil or type(dev) ~= "table" or type(dev.IsOwner) ~= "function" then
		return
	end
	S.Owner[player] = "asking"
	task.spawn(function()
		local ok, answer = pcall(dev.IsOwner, player)
		if S.Owner[player] ~= "asking" then
			return -- the player left meanwhile (their entry was dropped)
		end
		if ok and type(answer) == "boolean" and player.Parent == Players then
			S.Owner[player] = answer
		else
			S.Owner[player] = nil
		end
		applyTitle(player)
	end)
end

-- After each good read of the title stat (and with no store at each "Server" rebuild): drops the entries of players who
-- left, asks the owner again where the last answer failed, writes every player's title.
local function refreshTitles()
	for _, map in ipairs({ S.Titles, S.Owner }) do
		for player in pairs(map) do
			if not isPlayer(player) or player.Parent ~= Players then
				map[player] = nil
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		askOwner(player)
		applyTitle(player)
	end
end

-- Players.PlayerAdded (and the players already here at Init)
local function onTitleJoin(player)
	if S.Stopped or not isPlayer(player) then
		return
	end
	askOwner(player)
	applyTitle(player)
end

local function readStat(stat)
	local page = S.Pages[stat]
	if budget("GetSortedAsync") < floorOf("Read", 2) then
		page.DueAt = now() + retryAfter(1) -- not a failure: the budget comes back
		page.Reading = false
		return
	end
	local store = S.Stores[stat]
	local ok, raw = pcall(function()
		return store:GetSortedAsync(false, math.floor(num("ReadSize", 100))):GetCurrentPage()
	end)
	if S.Stopped then
		page.Reading = false
		return
	end
	if ok and type(raw) == "table" then
		local entries = cleanPage(raw)
		resolveNames(entries)
		page.Entries, page.Good, page.Fails = entries, true, 0
		page.UpdatedAt = now()
		page.DueAt = page.UpdatedAt + num("RefreshSeconds", 240)
		page.Reading = false
		if stat == (titleCfg().Stat or "Trophies") then
			local okTitles, errTitles = pcall(refreshTitles)
			if not okTitles then
				warn("[LeaderboardService] titles failed: " .. tostring(errTitles))
			end
		end
		sendAll()
	else
		page.Fails = page.Fails + 1
		page.DueAt = now() + retryAfter(page.Fails) -- the last good page stays
		page.Reading = false
	end
end

local function track(player)
	if S.Stopped or not isPlayer(player) or player.Parent ~= Players then
		return nil
	end
	if S.Recs[player] then
		return S.Recs[player]
	end
	local t = now()
	local rec = { LoadedAt = t, SeedAt = t + num("SeedDelay", 30), Seeded = false, Base = {}, Written = {}, LastWrite = {}, Pending = {}, Sig = nil, Dev = false }
	for _, stat in ipairs(stats()) do
		rec.Base[stat] = LeaderboardService.ValueOf(player, stat)
	end
	-- (review round 1) a developer account in a live server (DevService.IsAllowed: its tools grant pets, gems and anything
	-- they buy) is never written to the global stores; asked once in its own task (a group game's rank is a web call), and
	-- the record owes nothing until the answer is in. Studio keeps the rule off (its AllowInStudio makes everyone a dev).
	local dev = S.Dev
	if not RunService:IsStudio() and type(dev) == "table" and type(dev.IsAllowed) == "function" then
		rec.Dev = "asking"
		task.spawn(function()
			local ok, answer = pcall(dev.IsAllowed, player)
			rec.Dev = ok and answer == true
		end)
	end
	S.Recs[player] = rec
	S.Names[player.UserId] = displayName(player)
	return rec
end

-- one pass of the scheduler
local function step()
	local t = now()
	if not S.NoStore then
		for _, stat in ipairs(stats()) do
			local page = S.Pages[stat]
			if page and not page.Reading and t >= page.DueAt then
				page.Reading = true
				task.spawn(readStat, stat)
			end
		end
	end
	if LeaderboardService.Scope() == "Server" and t >= S.FallbackDueAt then
		rebuildServer()
		if S.NoStore then
			refreshTitles() -- no reads without a store: an owner answer that failed is asked again here
		end
		sendAll()
	end
	if writesAllowed() and not S.Closing then
		local sweep = t >= S.SweepDueAt
		if sweep then
			S.SweepDueAt = t + num("SweepSeconds", 60)
		end
		for player, rec in pairs(S.Recs) do
			if (not rec.Seeded and t >= rec.SeedAt) or (sweep and rec.Seeded) then
				rec.Seeded = true
				writeAll(player.UserId, rec, owed(player, rec, "sweep", t))
			end
		end
	end
end

-- the own-value poll: a send when a player's values changed since the last send
local function poll()
	for player, rec in pairs(S.Recs) do
		if player.Parent == Players then
			for _, stat in ipairs(stats()) do
				if rec.Base[stat] == nil then
					rec.Base[stat] = LeaderboardService.ValueOf(player, stat) -- a stand-in that recovered
				end
			end
			if ownSig(player) ~= rec.Sig then
				send(player)
			end
		end
	end
end

local function onLeave(player)
	S.Titles[player] = nil
	S.Owner[player] = nil -- an owner ask still running sees its entry gone and stops
	local rec = S.Recs[player]
	if not rec then
		return
	end
	S.Recs[player] = nil -- read below while the profile is still cached (DataService saves in a deferred task)
	if writesAllowed() then
		writeAll(player.UserId, rec, owed(player, rec, "leave", now()))
	end
end

local function close()
	if S.Stopped or S.Closing then
		return
	end
	S.Closing = true
	if not writesAllowed() then
		return
	end
	local t = now()
	for player, rec in pairs(S.Recs) do
		writeAll(player.UserId, rec, owed(player, rec, "leave", t))
	end
	while S.InFlight > 0 and now() - t < CLOSE_SECONDS do
		task.wait(0.1)
	end
end

----------------------------------------------------------------------
-- public
----------------------------------------------------------------------
function LeaderboardService.ValueOf(player, stat)
	local read = type(stat) == "string" and READ[stat] or nil
	local profile = read and profileOf(player)
	if not profile then
		return nil
	end
	local v = read(player, profile)
	if v == nil then
		return nil
	end
	return whole(v)
end

function LeaderboardService.Scope()
	if S.NoStore then
		return "Server"
	end
	local any = false
	for _, stat in ipairs(stats()) do
		local page = S.Pages[stat]
		if not page or not page.Good then
			return "Server"
		end
		any = true
	end
	return any and "Global" or "Server"
end

function LeaderboardService.State(player)
	local scope = LeaderboardService.Scope()
	local global = scope == "Global"
	local top = math.max(0, math.floor(num("Top", 10)))
	local userId = isPlayer(player) and player.UserId or nil
	local out = { Stats = {}, Scope = scope }
	local nextAt, updatedAt = S.FallbackDueAt, S.Server.At
	if global then
		nextAt, updatedAt = nil, nil
		for _, stat in ipairs(stats()) do
			local page = S.Pages[stat]
			nextAt = math.min(nextAt or page.DueAt, page.DueAt)
			updatedAt = math.max(updatedAt or page.UpdatedAt, page.UpdatedAt)
		end
	end
	for _, stat in ipairs(stats()) do
		local list = (global and S.Pages[stat].Entries) or (not global and S.Server.Rows[stat]) or {}
		local rows, rank = {}, nil
		for i, e in ipairs(list) do
			if i <= top then
				rows[i] = { UserId = e.UserId, Name = global and nameOf(e.UserId) or e.Name, Value = e.Value }
			end
			if userId and not rank and e.UserId == userId then
				rank = i
			end
		end
		out.Stats[stat] = { Top = rows, You = { Rank = rank, Value = userId and LeaderboardService.ValueOf(player, stat) or nil } }
	end
	out.NextAt = (nextAt and nextAt > 0) and nextAt or now()
	out.UpdatedAt = (updatedAt and updatedAt > 0) and updatedAt or now()
	return out
end

-- the title as last written: kind ("Creator" | "Top10" | "Top100" | nil), rank (1..Gold | nil); read only
function LeaderboardService.TitleOf(player)
	local rec = S.Titles[player]
	if not rec then
		return nil, nil
	end
	return rec.Kind, rec.Rank
end

function LeaderboardService.Init(deps)
	deps = type(deps) == "table" and deps or {}
	S.DS = deps.DataService or S.DS
	S.Dev = deps.DevService or S.Dev
	if S.Started then
		return
	end
	S.Started = true
	local t = now()
	local names = type(cfg().Stores) == "table" and cfg().Stores or {}
	for i, stat in ipairs(stats()) do
		local ok, store = pcall(function()
			return DataStoreService:GetOrderedDataStore(names[stat])
		end)
		if ok and store then
			S.Stores[stat] = store
		else
			S.NoStore = true
		end
		S.Pages[stat] = { Entries = nil, Good = false, Fails = 0, DueAt = t + i * BOOT_GAP, UpdatedAt = nil, Reading = false }
	end
	S.SweepDueAt = t + num("SweepSeconds", 60)
	rebuildServer()
	local DS = S.DS
	if DS and type(DS.ProfileLoaded) == "table" then
		S.Conns[#S.Conns + 1] = DS.ProfileLoaded:Connect(function(player)
			if track(player) then
				send(player)
			end
		end)
	end
	if DS and type(DS.ProfileRebased) == "table" then
		S.Conns[#S.Conns + 1] = DS.ProfileRebased:Connect(function(player)
			if not S.Recs[player] and track(player) then
				send(player) -- a stand-in that recovered (a failed load fires no ProfileLoaded)
			end
		end)
	end
	S.Conns[#S.Conns + 1] = Players.PlayerRemoving:Connect(onLeave)
	S.Conns[#S.Conns + 1] = Players.PlayerAdded:Connect(onTitleJoin)
	for _, player in ipairs(Players:GetPlayers()) do
		if profileOf(player) and track(player) then
			send(player)
		end
		onTitleJoin(player)
	end
	pcall(function()
		game:BindToClose(close)
	end)
	task.spawn(function()
		while not S.Stopped do
			task.wait(TICK)
			if not S.Stopped then
				local ok, err = pcall(step)
				if not ok then
					warn("[LeaderboardService] step failed: " .. tostring(err))
				end
			end
		end
	end)
	task.spawn(function()
		while not S.Stopped do
			task.wait(num("PollSeconds", 5))
			if not S.Stopped then
				local ok, err = pcall(poll)
				if not ok then
					warn("[LeaderboardService] poll failed: " .. tostring(err))
				end
			end
		end
	end)
end

-- tests: a stopped copy drops its connections; its loops end at their next pass
function LeaderboardService._StopForTest()
	S.Stopped = true
	for _, conn in ipairs(S.Conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	S.Conns = {}
end

-- tests: what BindToClose runs
function LeaderboardService._CloseForTest()
	close()
end

-- tests: the titles' PlayerAdded handler, run by hand (lb_titles runs it before PlayerService's handler)
function LeaderboardService._JoinForTest(player)
	onTitleJoin(player)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1101">
          <Properties>
            <string name="Name">LightingService</string>
            <string name="Source"><![CDATA[-- LightingService: owns the sky, the atmosphere, the post effects, the moving sky clouds and the global
-- workspace rules (ARCHITECTURE_V3.md "Phase 6" 6.0.2 / 6.1 A2 and docs/phase6/style.md section 4).
--
-- Phase 6 look = the Phase 4 look again ("bright, warm afternoon"; P4 LOOK at 7aa0df2): a high warm sun, light shade
-- (no black creases on the voxels), exposure a little under 0 so the cloud whites keep their shades, subtle bloom
-- (only neon trims and tokens glow), colours a touch richer, faint sun rays. No golden hour, no purple haze.
--   * Look.Fallback no sky ids yet (the shipped Config): the stock sky with the P4 light sky-blue air and a soft peach
--                   horizon, white moving clouds and 2500 stars
--   * Look.Custom   the owner's painted skybox (branding/sky/*.png, the 6 ids pasted into Config.Sky.Faces): the same
--                   P4 light, a light pink air to match the painted sky, no engine stars (they are painted)
--   * Look.Painted  no Config.Sky.Faces (kit-b S2, sky audit F4 / F12): the living sky's painted theme of the loop's
--                   first phase (Config.Sky.Themes[Config.Sky.Cycle.Order[1]]: SkyService boots SkyOffset 0, so a fresh
--                   server starts there; the Day theme when that one is not uploaded) with the Day look's light and air,
--                   no engine sun / moon / stars, Glare 0, no sun rays, so every frame before SkyController's first apply
--                   (server captures, the loading screen's preload of Lighting.Sky, a client whose SkyController failed)
--                   is the painted sky, never the stock one. The faces, sun, stars, glare and rays are what SkyCycle.Preset
--                   writes at that phase (S2 review), so on a fresh Play the first apply swaps no faces the loading
--                   screen did not preload; the light and air it sets at once (the first apply is instant)
-- Init() picks Custom only when ALL SIX faces are set (one missing -> Painted, with a warning that names it); the
-- stock-sky Fallback only when neither the first phase's theme nor the Day theme is uploaded.
-- A face is the full content id Studio's Asset Manager copies (scheme://..., an Image id); anything else counts as unset.
-- The tuned numbers live in the Look table so the owner can tweak the mood in one place.
-- Lighting.Technology (ShadowMap, as in Phase 4) cannot be written from a script (plugin security):
-- default.project.json sets it. The server writes Lighting ONLY here, at boot; the client's LightingStack layers
-- its presets (dungeon, low graphics) on top. Plain Lua 5.1-compatible syntax only. Init() is idempotent.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local SkyFaces = require(Shared.SkyFaces)

local LightingService = {}

local rgb = Color3.fromRGB

-- Shared by the looks (the same table in each, so a tweak applies to all; Painted has its own SunRays): the Phase 4 numbers
local BLOOM = { Enabled = true, Intensity = 0.16, Size = 18, Threshold = 1.6 } -- only the brightest accents (neon, tokens) glow
local COLOR = { Enabled = true, Brightness = 0, Contrast = 0.1, Saturation = 0.14, TintColor = rgb(255, 250, 242) }
local SUNRAYS = { Enabled = true, Intensity = 0.06, Spread = 0.6 }
-- Depth of field stays off (it blurs the course edges players need to read).
local DOF = { Enabled = false, FarIntensity = 0.05, NearIntensity = 0, FocusDistance = 200, InFocusRadius = 160 }

-- The world light of Phase 4 (both looks): at latitude 34 and 14:30 the sun stands about 50 degrees up, voxel tops
-- are well lit, sides keep a readable shade and shadows stay short and crisp.
local function p4Light()
	return {
		ClockTime = 14.5,
		GeographicLatitude = 34,
		Brightness = 2.0,
		ExposureCompensation = -0.15, -- the near-white cloud voxels never blow out
		Ambient = rgb(98, 106, 132),
		OutdoorAmbient = rgb(132, 138, 160), -- no black creases
		ColorShift_Top = rgb(66, 50, 26), -- a warm sun
		ColorShift_Bottom = rgb(14, 20, 40), -- a cool sky bounce
		EnvironmentDiffuseScale = 0.6,
		EnvironmentSpecularScale = 0.35,
		GlobalShadows = true,
		ShadowSoftness = 0.3,
		FogStart = 0,
		FogEnd = 100000, -- the Atmosphere does the distance haze
	}
end

local FACE_KEYS = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }

LightingService.FaceKeys = FACE_KEYS

LightingService.Look = {
	Custom = {
		Lighting = p4Light(),
		Atmosphere = {
			Density = 0.28,
			Offset = 0.25,
			Color = rgb(240, 214, 232), -- light pink air to match the painted sky
			Decay = rgb(238, 200, 180), -- soft peach horizon
			Glare = 0.25,
			Haze = 1.0,
		},
		Sky = {
			StarCount = 0, -- the stars are painted in the custom sky
			CelestialBodiesShown = true,
			SunAngularSize = 11,
			MoonAngularSize = 9,
		},
		Clouds = { Enabled = true, Cover = 0.5, Density = 0.6, Color = rgb(252, 238, 246) },
		SunRays = SUNRAYS,
		Bloom = BLOOM,
		ColorCorrection = COLOR,
		DepthOfField = DOF,
	},
	Fallback = {
		Lighting = p4Light(),
		Atmosphere = {
			Density = 0.28,
			Offset = 0.25,
			Color = rgb(178, 198, 228), -- light sky-blue air (Phase 4)
			Decay = rgb(238, 200, 170), -- soft warm peach horizon (Phase 4)
			Glare = 0.25,
			Haze = 1.0,
		},
		Sky = {
			StarCount = 2500,
			CelestialBodiesShown = true,
			SunAngularSize = 16,
			MoonAngularSize = 9,
		},
		Clouds = { Enabled = true, Cover = 0.5, Density = 0.6, Color = rgb(240, 244, 252) }, -- soft white, never overcast
		SunRays = SUNRAYS,
		Bloom = BLOOM,
		ColorCorrection = COLOR,
		DepthOfField = DOF,
	},
	Painted = {
		Lighting = p4Light(), -- = Config.Sky.Looks.Day's light (SkyController's first apply sets the phase's own at once)
		Atmosphere = {
			Density = 0.26, -- = Config.Sky.Looks.Day's clear resting air (P2 F11 C: was 0.28 / Haze 1.0, the old Day air)
			Offset = 0.25,
			Color = rgb(178, 198, 228), -- the Day look's sky-blue air
			Decay = rgb(238, 200, 170),
			Glare = 0, -- no engine sun to glare around
			Haze = 0.8,
		},
		Sky = {
			StarCount = 0, -- the painted skies have their own stars
			CelestialBodiesShown = false, -- the painted skies have their own sun (no second, engine one)
			SunAngularSize = 11,
			MoonAngularSize = 9,
		},
		Clouds = { Enabled = true, Cover = 0.5, Density = 0.6, Color = rgb(240, 244, 252) },
		-- (S2 review) no rays: they glow at the hidden engine sun, next to the painted one (SkyCycle.Preset's Intensity 0)
		SunRays = { Enabled = true, Intensity = 0, Spread = 0.6 },
		Bloom = BLOOM,
		ColorCorrection = COLOR,
		DepthOfField = DOF,
	},
}

-- the look Init() applied last: "Custom" | "Painted" | "Fallback" | nil (before Init)
LightingService.Current = nil

-- Assign every property in `props` to `inst`; a property that does not exist (or is not scriptable on this
-- engine version) only produces a warning instead of breaking boot.
local function setProps(inst, props)
	for key, value in pairs(props) do
		local ok, err = pcall(function()
			inst[key] = value
		end)
		if not ok then
			warn("[LightingService] could not set " .. inst.ClassName .. "." .. tostring(key) .. ": " .. tostring(err))
		end
	end
end

-- Reuse the first child of `className` under `parent`, otherwise create one (idempotent; a place that already
-- ships a Sky / Atmosphere does not double up).
local function ensure(parent, className, name)
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = parent
	end
	return inst
end

-- The one Sky under Lighting: NimbusSky when there is one, else the first Sky, else a new NimbusSky. Every other Sky
-- is destroyed: a Baseplate opened in Studio ships its own Sky, and a second one (Rojo connect never removes unknown
-- children; default.project.json names its node Sky so Rojo can adopt the Baseplate's) would split the sky the engine
-- draws from the one LightingStack, the loading screen and SkyController swap faces on: they take the first Sky
-- (sky review 2026-11-13)
local function ownSky()
	local named = Lighting:FindFirstChild("NimbusSky")
	local sky = (named and named:IsA("Sky")) and named or ensure(Lighting, "Sky", "NimbusSky")
	for _, child in ipairs(Lighting:GetChildren()) do
		if child ~= sky and child:IsA("Sky") then
			child:Destroy()
		end
	end
	return sky
end

-- One face id: the trimmed content URL (the "Copy ID" text Studio gives, scheme://...), nil when empty or unusable
-- (a bare number, junk, a non-string), so the fallback look is used instead of a grey box.
function LightingService.FaceId(value)
	if type(value) ~= "string" then
		return nil
	end
	local s = value:match("^%s*(.-)%s*$")
	if s:match("^%a[%w%+%.%-]*://%S+$") then
		return s
	end
	return nil
end

-- { Bk = id, ... } when all six faces of Config.Sky.Faces are usable, else nil + the list of missing / bad keys.
function LightingService.CustomFaces()
	local faces = (type(Config.Sky) == "table" and type(Config.Sky.Faces) == "table") and Config.Sky.Faces or {}
	local out, missing, any = {}, {}, false
	for _, key in ipairs(FACE_KEYS) do
		local raw = faces[key]
		local id = LightingService.FaceId(raw)
		if id then
			out[key] = id
			any = true
		else
			missing[#missing + 1] = key
			if raw ~= nil and raw ~= "" then
				any = true
			end
		end
	end
	if #missing > 0 then
		return nil, missing, any
	end
	return out, missing, any
end

-- workspace.Terrain.Clouds (skipped quietly when the engine has no Terrain or no Clouds class).
local function applyClouds(props)
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local ok, err = pcall(function()
		setProps(ensure(terrain, "Clouds", "NimbusClouds"), props)
	end)
	if not ok then
		warn("[LightingService] sky clouds skipped: " .. tostring(err))
	end
end

-- Global physics / world rules. StreamingEnabled is deliberately left alone (false). Spawning is NOT decided
-- here: Main / PlayerService hold the character until the menu's PLAY (7.2), so CharacterAutoLoads is untouched.
-- (playtest 2026-11-28 C46) Workspace.FallenPartsDestroyHeight is PluginSecurity: a server Script cannot write it
-- (every boot warned "lacking capability PluginOrOpenCloud" and the value never applied). It is -2000 in the place
-- itself now (default.project.json's Workspace $properties), far below the lobby and every course kill plane.
function LightingService.ApplyWorldRules()
	setProps(Workspace, {
		Gravity = Config.Physics.Gravity,
	})
end

function LightingService.Init()
	local faces, missing, any = LightingService.CustomFaces()
	-- no complete owner skybox: the living sky's painted faces of the loop's first phase, else the Day's
	-- ({ SkyboxBk = ..., the six } or nil: not uploaded)
	local painted = nil
	if not faces and type(Config.Sky) == "table" and type(Config.Sky.Themes) == "table" then
		local order = type(Config.Sky.Cycle) == "table" and Config.Sky.Cycle.Order
		local first = type(order) == "table" and order[1] or nil
		painted = (first and SkyFaces.For(Config.Sky.Themes[first])) or SkyFaces.For(Config.Sky.Themes.Day)
	end
	local name = faces and "Custom" or (painted and "Painted" or "Fallback")
	if not faces and any then
		-- the owner started pasting ids: say which ones are still missing / unreadable (a warning, not an error)
		warn("[LightingService] Config.Sky.Faces is missing " .. table.concat(missing, ", ") .. " (paste the full id from Asset Manager -> Copy ID): using the " .. (painted and "painted" or "fallback") .. " sky until all six are set")
	end
	local look = LightingService.Look[name]

	setProps(Lighting, look.Lighting)
	setProps(ensure(Lighting, "Atmosphere", "NimbusAtmosphere"), look.Atmosphere)
	local sky = ownSky()
	setProps(sky, look.Sky)
	local skybox = {}
	for _, key in ipairs(FACE_KEYS) do
		-- the fallback clears the faces (the engine's stock sky); Init twice gives the same Sky
		local slot = "Skybox" .. key
		skybox[slot] = faces and faces[key] or (painted and painted[slot]) or ""
	end
	setProps(sky, skybox)
	setProps(ensure(Lighting, "BloomEffect", "NimbusBloom"), look.Bloom)
	setProps(ensure(Lighting, "SunRaysEffect", "NimbusSunRays"), look.SunRays)
	setProps(ensure(Lighting, "ColorCorrectionEffect", "NimbusColor"), look.ColorCorrection)
	setProps(ensure(Lighting, "DepthOfFieldEffect", "NimbusDepthOfField"), look.DepthOfField)
	applyClouds(look.Clouds)

	LightingService.Current = name
	LightingService.ApplyWorldRules()
	return name
end

return LightingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1102">
          <Properties>
            <string name="Name">LobbyBoardBuilder</string>
            <string name="Source"><![CDATA[-- LobbyBoardBuilder (lobby shop 2026-11-07, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.9 / 5.6 / 5.10;
-- shop-area 16.17.2): the lobby's newer boards and the shop's egg row, drawn with LobbyBuilder's own helpers (passed in as
-- H), so they look exactly like the other notice boards and add only one local to LobbyBuilder's near-full main chunk.
--
--   LobbyBoardBuilder.EggRow(parent, cf, H) -> Model "EggRow", PromptPart
--     shop-area 16.17.2 (the owner, 2026-11-08: "the roulettes and eggs are the same thing ... put the eggs preview below
--     the pets guide"): the seven eggs stand on a shelf in front of the WINGED PETS board (LobbyBuilder.buildRarityBoard;
--     its letters end above y 3.9, so the eggs never hide them). cf = that board's ground CFrame (front -Z, towards the
--     reader; WorldPivot = cf). No board of its own:
--       * EggShelf: a low stone shelf (SHELF: 19.3 x 0.8 x 2.6) 3 studs in front of the board, colliding; the row slides
--         1.0 stud (the eggs) / 1.35 (the shelf) towards the reader's left, off the Cloud machine (see SHELF).
--       * RarityStrip: a SurfaceGui on the shelf's Front face at 50 px per stud (965 x 40 px), LightInfluence 0: the
--         Band, a stone card (kit-b world signs, shared/WorldTag: the Stone face inset by its 2 px mitred wood edge, a 4 px
--         StoneLip lip; the navy see-through band went) holding seven labels Label_<Rarity> (135 x 32 px over the lip, one
--         under each egg) that name the rarity in the kit's brown ink (no outline: it sits on the opaque face) at 30 px =
--         0.6 stud (the World text rule's line floor; a label strip has no title line) in Theme's Body face, TextScaled off,
--         each over its own lip piece Lip_<Rarity> as wide as its word (less STRIP.LipInset each end, so two pieces never
--         meet) in the rarity colour (Secret: its violet glow, its
--         own colour is near-black). Measured with Roblox's own BuilderSans-Bold the words are 59 .. 161 px
--         wide, so two neighbours of the 135 px cells would meet (Common 126 + Uncommon 161): STRIP.Nudge moves the Common
--         label 22 px out to the shelf's end and the Mythic one 8 px towards Secret, each still under its egg; every gap is
--         then >= 9 px (the spec's GothamBlack "Heading" face is wider still: Uncommon 185 px, Legendary 175).
--       * Egg_<Rarity>: the seven 3D eggs standing on the shelf EGG.Step (2.7) studs apart in the same order, left to right
--         as the reader sees them (the reader's left is the board's +X: egg i at cf * (1.0 + (8 - 2 i) * 1.35, 0.8, -3)), each
--         Mesh.tag'ged with its egg_<rarity> key at the egg's
--         bottom centre (the Blender pivot). Until a key has an id the egg is its Part fallback: a 2.25 x 3 x 2.5
--         ellipsoid (a block with a Sphere SpecialMesh, CourseBuilder's way: a Roblox Ball part is always round) in the
--         rarity colour, SmoothPlastic, not colliding; the Secret egg dark with its violet tint. Each egg is tagged
--         Config.Tags.Spin with SpinSeconds 14, BobStuds 0.12, BobSeconds 3.2 (lobby shop 16.5, Task 25: a slow display
--         turntable; the client's LobbyFxController turns and bobs it about its pivot, the server never animates).
--         The shelf VFX (lobby shop 16.5 "The world eggs", Task 26), one set per egg at an Attachment "Center" in the egg's
--         middle (the Part fallback and a dressed mesh alike: dressing only hides the Part, the Attachment stays): a
--         ParticleEmitter "Sparkle" on the Rare and up eggs (the built-in sparkle texture; Rate Rare 1 / Epic 2 /
--         Legendary 3 / Mythic 4 / Secret 5; the rarity colour, Secret the egg's violet glow; LightEmission 0.5;
--         Lifetime 1.2-2; Speed 0.3-0.8; ZOffset 1.4 so the sparks draw in front of the shell they start in), tagged
--         WorldStyle.Tags.Detail so the Low graphics setting parks them. No part is added.
--       * EggShelfGlow (Task 26): one PointLight 1.0 / 10, no shadows, on an Attachment 1.5 studs over the shelf's top
--         centre (inside the lobby light rule: a non-lamp light <= 1.5 / 28).
--       * PromptPart (lobby shop 16.3, Task 23): an invisible, non-colliding 5 x 4 x 3 part at cf * (0, 2, -5.6), just in
--         front of the shelf. Returned second: LobbyBuilder hands it on as LobbyInfo.Shop.Counter.PromptPart and
--         PetService puts the walk-up ShopPrompt on it.
--     Parts: 9 (the shelf, seven eggs, the PromptPart).
--   LobbyBoardBuilder.Leaderboard(parent, L, H) -> Model "LobbyLeaderboard" | nil
--     The global leaderboard's board on the south lawn (spec 5.10 "World"): placed with H.plazaSpot at polar 295 degrees,
--     r 48, clearance 9 (nil when the spot is not free: plazaSpot has warned "plaza decor skipped"), on the lawn layer,
--     facing the plaza centre (H.faceCentre). The layout Task 23's prop_board_lb mesh shares (pivot = the ground centre,
--     front -Z towards the centre):
--       * Face: 16 x 13 x 0.4, centred 9.5 up, navy SmoothPlastic, not colliding but queryable: the client's PlayerGui
--         SurfaceGui (LeaderboardController, 50 px per stud = 800 x 650 px, ten rows at the 0.6-stud floor) adorns it
--         and its tabs take taps. It stays a Part under the mesh (Mesh.tag keeps "Face").
--       * two 1 x 17 x 1 timber posts at local x +-8.9 on stone feet, a 0.6-stud frame around the face (four bars) with
--         a plank back, an 18.6 x 0.6 x 2.4 roof at y 16.9 with a ridge on it.
--     Mesh.tag(model, "prop_board_lb", cf, nil, { "Face" }); the Part build shows until that key has an id.
--
--   H = { noticeBoard, surfaceGui, signPanel, signText, box, Mesh, C, MAT, LAWN, plazaSpot, faceCentre } (LobbyBuilder's
--   layout field L.H, built once per Build)
-- No other light (only the shelf's EggShelfGlow), no prompt (only the egg row's PromptPart for PetService's), no
-- animation (the server never animates; the sparkles are a ParticleEmitter). Plain Lua 5.1 syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local WorldStyle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WorldStyle"))
local FxSprites = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("FxSprites"))
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Theme"))
local WorldTag = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("WorldTag")) -- (kit-b world signs) the stone card

local LobbyBoardBuilder = {}

-- the egg mesh keys, literal (tools/mesh_keys.py reads the keys from the source)
local EGG_KEYS = {
	Common = "egg_common",
	Uncommon = "egg_uncommon",
	Rare = "egg_rare",
	Epic = "egg_epic",
	Legendary = "egg_legendary",
	Mythic = "egg_mythic",
	Secret = "egg_secret",
}
-- the Blender egg's size (studs), the gap between centres (shop-area 16.17.2: 2.7 = one 135 px label cell at 50 px per
-- stud), and the shelf turntable the client plays (spec 16.5: one turn in SpinSeconds, a BobStuds bob over BobSeconds)
local EGG = { Size = Vector3.new(2.25, 3, 2.5), Step = 2.7, SpinSeconds = 14, BobStuds = 0.12, BobSeconds = 3.2 }
-- the stone shelf: its size, its centre's distance in front of the board (Z) and its centre along the board (X, + = the
-- reader's left; the eggs need 18.45 studs, the labels 18.9 + the Common label's nudge). Centred on the board as 16.17.2
-- drew it (20 wide), its Secret end met the Cloud machine: the shelf
-- touched its base and the Secret egg stood under its lever knob (0.00 stud; the knob hangs 7 studs up over the shelf's
-- front corner). So the row slides off it: the eggs' centre at ROW_X (1.0 towards the reader's left), and the shelf
-- reaches 9.3 studs past that on the Secret side (0.075 past the Secret egg) and 10.0 on the Common side (the Common
-- label, nudged out, needs it): 19.3 wide, centred at X = 1.35. The PromptPart stays centred on the board.
local SHELF = { Size = Vector3.new(19.3, 0.8, 2.6), Z = -3, X = 1.35 }
local ROW_X = 1.0
-- the rarity label strip on the shelf's front (16.17.2): px per stud, the label cell, the text size (0.6 stud), the band;
-- Nudge = px a label moves off its cell's centre (+ = towards the canvas's right = the reader's right), measured above
local STRIP = {
	Name = "RarityStrip", PPS = 50, Cell = 135, Text = 30, Role = "Body",
	Edge = 2, Lip = 4, -- (kit-b world signs) the band's wood edge (the band is inset by it) and lip, px
	LipInset = 4, -- px a word's lip piece stops short of each end of the word (render review: Common's and Uncommon's met)
	Nudge = { Common = -22, Mythic = 8 },
}
-- the walk-up Shop prompt's part (lobby shop 16.3: just in front of the shelf)
local COUNTER = { Offset = CFrame.new(0, 2, -5.6), Size = Vector3.new(5, 4, 3) }
local SECRET = {
	Body = Color3.fromRGB(40, 40, 52), -- Config.Rarities Secret
	Tint = Color3.fromRGB(138, 92, 255), -- the Secret egg's violet glow (spec 5.6; its strip label's lip piece)
}
-- the shelf VFX (spec 16.5 "The world eggs"): the sparkle per egg from Rare up and the shelf's one light
local SHELF_FX = {
	Rate = { Rare = 1, Epic = 2, Legendary = 3, Mythic = 4, Secret = 5 },
	Sprite = "Sparkle", -- an FxSprites role: the game's own glint sheet (kit B X1; was the built-in sparkle)
	Detail = (WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail",
	Glow = { Name = "EggShelfGlow", Brightness = 1.0, Range = 10, Lift = 1.5, Color = Color3.fromRGB(255, 238, 206) },
}
-- the leaderboard board: where it stands (polar degrees, radius, plazaSpot clearance; spec 5.10 checked the clearance
-- against the fountain, the NPC spots, the benches, the flower beds and the spawn) and its layout (shared with Task 23)
local BOARD = {
	Angle = 295, R = 48, Clear = 9,
	Face = Vector3.new(16, 13, 0.4), FaceY = 9.5,
	PostX = 8.9, PostH = 17,
	Rim = 0.6, -- the frame's width around the face
	Roof = Vector3.new(18.6, 0.6, 2.4), RoofY = 16.9,
}

local function rarityColor(id)
	for _, r in ipairs(Config.Rarities) do
		if r.Id == id then
			return r.Color
		end
	end
	return Color3.fromRGB(200, 200, 210)
end

-- the egg rarities in Config.Eggs.Order (only those with a mesh key)
local function eggOrder()
	local out = {}
	local eggs = type(Config.Eggs) == "table" and Config.Eggs or {}
	for _, id in ipairs(type(eggs.Order) == "table" and eggs.Order or {}) do
		if EGG_KEYS[id] then
			out[#out + 1] = id
		end
	end
	return out
end

-- the sparkle of one shelf egg (Rare and up) at an Attachment Center in its middle; nothing below Rare
local function eggSparkle(egg, id)
	local rate = SHELF_FX.Rate[id]
	if not rate then
		return nil
	end
	local center = Instance.new("Attachment")
	center.Name = "Center"
	center.Parent = egg
	local color = (id == "Secret") and SECRET.Tint or rarityColor(id)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Sparkle"
	FxSprites.Apply(pe, SHELF_FX.Sprite)
	pe.Rate = rate
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 0.5
	pe.LightInfluence = 0
	pe.Lifetime = NumberRange.new(1.2, 2)
	pe.Speed = NumberRange.new(0.3, 0.8)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, 0.35, 0)
	pe.ZOffset = 1.4
	pe.Rotation = NumberRange.new(0, 360)
	pe.RotSpeed = NumberRange.new(-40, 40)
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.32),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.3, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Parent = center
	CollectionService:AddTag(pe, SHELF_FX.Detail)
	return pe
end

-- the rarity label strip on the shelf's front (16.17.2): a stone band (kit-b world signs), one ink label per egg standing
-- under it over its word-wide lip piece in the rarity colour. The canvas's left is the shelf's +X (the reader's left, where
-- egg 1 stands), so egg i's centre is W / 2 - x_i * PPS px of the canvas (the band starts STRIP.Edge px in).
local function rarityStrip(shelf, order, H)
	local Sign = Theme.Sign
	local gui = H.surfaceGui(shelf, Enum.NormalId.Front)
	gui.Name = STRIP.Name
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = STRIP.PPS
	gui.LightInfluence = 0
	local e = STRIP.Edge
	local band = Instance.new("Frame")
	band.Name = "Band"
	band.Position = UDim2.fromOffset(e, e) -- the edge is drawn outside the face: inset so the canvas keeps it
	band.Size = UDim2.new(1, -2 * e, 1, -2 * e)
	band.Parent = gui
	WorldTag.Block(band, Sign.Stone, Sign.StoneLip, Sign.Wood, e, STRIP.Lip)
	local w = SHELF.Size.X * STRIP.PPS
	local lineH = SHELF.Size.Y * STRIP.PPS - 2 * e - STRIP.Lip
	for i, id in ipairs(order) do
		local eggX = ROW_X - SHELF.X + (#order + 1 - 2 * i) * EGG.Step / 2 -- the egg's centre from the shelf's
		local centre = w / 2 - eggX * STRIP.PPS + (STRIP.Nudge[id] or 0) - e
		WorldTag.Text(band, "Label_" .. id, id, STRIP.Role, STRIP.Text, Sign.Text, {
			Position = UDim2.fromOffset(centre - STRIP.Cell / 2, 0),
			Size = UDim2.fromOffset(STRIP.Cell, lineH),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 2,
		})
		-- the word's own lip piece in the rarity colour, as wide as the word less LipInset each end (the band's StoneLip
		-- shows between them, even where two words nearly meet)
		local tw = math.ceil(Theme.Measure(id, STRIP.Role, STRIP.Text).X)
		local piece = Instance.new("Frame")
		piece.Name = "Lip_" .. id
		piece.BorderSizePixel = 0
		piece.BackgroundColor3 = (id == "Secret") and SECRET.Tint or rarityColor(id)
		piece.AnchorPoint = Vector2.new(0.5, 1)
		piece.Position = UDim2.new(0, centre, 1, 0)
		piece.Size = UDim2.fromOffset(math.max(24, tw - 2 * STRIP.LipInset), STRIP.Lip)
		piece.ZIndex = 2
		piece.Parent = band
	end
	gui.Parent = shelf
	return gui
end

function LobbyBoardBuilder.EggRow(parent, cf, H)
	local model = Instance.new("Model")
	model.Name = "EggRow"
	model.Parent = parent
	local order = eggOrder()
	-- the shelf: its bottom on the board's ground (the lawn), the part over the court's stone just sinks into it
	local shelfCF = cf * CFrame.new(SHELF.X, SHELF.Size.Y / 2, SHELF.Z)
	local shelf = H.box(model, "EggShelf", shelfCF, SHELF.Size, H.C.StoneLight, { Collide = true, Material = H.MAT.SmoothPlastic })
	rarityStrip(shelf, order, H)
	-- the shelf's one soft glow (Task 26): an Attachment over its top centre, so no part is added
	local glowAt = Instance.new("Attachment")
	glowAt.Name = SHELF_FX.Glow.Name
	glowAt.CFrame = CFrame.new(0, SHELF.Size.Y / 2 + SHELF_FX.Glow.Lift, 0)
	glowAt.Parent = shelf
	local glow = Instance.new("PointLight")
	glow.Name = SHELF_FX.Glow.Name
	glow.Brightness = SHELF_FX.Glow.Brightness
	glow.Range = SHELF_FX.Glow.Range
	glow.Color = SHELF_FX.Glow.Color
	glow.Shadows = false
	glow.Parent = glowAt
	for i, id in ipairs(order) do
		-- the reader faces the board's front (-Z): their left is +X, so the first egg stands at +X
		local eggCF = cf * CFrame.new(ROW_X + (#order + 1 - 2 * i) * EGG.Step / 2, SHELF.Size.Y, SHELF.Z)
		local color = rarityColor(id)
		if id == "Secret" then
			color = SECRET.Body:Lerp(SECRET.Tint, 0.18)
		end
		local egg = H.box(model, "Egg_" .. id, eggCF * CFrame.new(0, EGG.Size.Y / 2, 0), EGG.Size, color, { Material = H.MAT.SmoothPlastic })
		local shape = Instance.new("SpecialMesh")
		shape.MeshType = Enum.MeshType.Sphere -- the ellipsoid of the block's size
		shape.Parent = egg
		H.Mesh.tag(egg, EGG_KEYS[id], eggCF)
		eggSparkle(egg, id)
		-- the turntable (Task 25): attributes first, then the tag, so a client that sees the tag reads them
		egg:SetAttribute("SpinSeconds", EGG.SpinSeconds)
		egg:SetAttribute("BobStuds", EGG.BobStuds)
		egg:SetAttribute("BobSeconds", EGG.BobSeconds)
		if type(Config.Tags) == "table" and type(Config.Tags.Spin) == "string" then
			CollectionService:AddTag(egg, Config.Tags.Spin)
		end
	end
	-- the walk-up Shop prompt's part (spec 16.3): invisible, not colliding, just in front of the shelf, centred on the board
	local prompt = H.box(model, "PromptPart", cf * COUNTER.Offset, COUNTER.Size, H.C.Cloud, { Transparency = 1, Shadow = false })
	model.WorldPivot = cf
	return model, prompt
end

function LobbyBoardBuilder.Leaderboard(parent, L, H)
	local pos = H.plazaSpot(BOARD.Angle, BOARD.R, BOARD.Clear, L)
	if not pos then
		return nil -- not free: plazaSpot has warned "plaza decor skipped"
	end
	local cf = H.faceCentre(pos - Vector3.new(0, H.LAWN, 0)) -- on the lawn layer, the front (-Z) towards the centre
	local C, solid = H.C, { Collide = true }
	local model = Instance.new("Model")
	model.Name = "LobbyLeaderboard"
	model.Parent = parent
	local fw, fh, rim = BOARD.Face.X, BOARD.Face.Y, BOARD.Rim
	local face = H.box(model, "Face", cf * CFrame.new(0, BOARD.FaceY, 0), BOARD.Face, C.Navy, { Material = H.MAT.SmoothPlastic, Query = true })
	if face and type(Config.Tags) == "table" and type(Config.Tags.LeaderboardFace) == "string" then
		CollectionService:AddTag(face, Config.Tags.LeaderboardFace) -- (review round 1) how LeaderboardController finds it
	end
	H.box(model, "Back", cf * CFrame.new(0, BOARD.FaceY, BOARD.Face.Z / 2 + 0.15), Vector3.new(fw + 2 * rim, fh + 2 * rim, 0.3), C.Plank, solid)
	for _, s in ipairs({ -1, 1 }) do
		H.box(model, "Frame", cf * CFrame.new(0, BOARD.FaceY + s * (fh + rim) / 2, 0), Vector3.new(fw + 2 * rim, rim, rim), C.Plank, solid)
		H.box(model, "Frame", cf * CFrame.new(s * (fw + rim) / 2, BOARD.FaceY, 0), Vector3.new(rim, fh, rim), C.Plank, solid)
		H.box(model, "Post", cf * CFrame.new(s * BOARD.PostX, BOARD.PostH / 2, 0), Vector3.new(1, BOARD.PostH, 1), C.PlankDark, solid)
		H.box(model, "PostFoot", cf * CFrame.new(s * BOARD.PostX, 0.4, 0), Vector3.new(1.6, 0.8, 1.6), C.StoneDark, solid)
	end
	H.box(model, "Roof", cf * CFrame.new(0, BOARD.RoofY, 0), BOARD.Roof, C.PlankDark)
	H.box(model, "Ridge", cf * CFrame.new(0, BOARD.RoofY + BOARD.Roof.Y / 2 + 0.25, 0), Vector3.new(BOARD.Roof.X - 1.4, 0.5, 1.4), C.Rose)
	model.WorldPivot = cf -- before the tag: the mesh's offset is measured from the model's pivot
	H.Mesh.tag(model, "prop_board_lb", cf, nil, { "Face" })
	return model
end

return LobbyBoardBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1103">
          <Properties>
            <string name="Name">LobbyBuilder</string>
            <string name="Source"><![CDATA[-- LobbyBuilder (v3): builds the Nimbus Climb sky village in the DETAILED VOXEL style
-- (ARCHITECTURE_V3.md, "ART DIRECTION" + section 6), sculpted with shared/Voxel.lua.
--
-- Top view (+X right, +Z up the page, angles in degrees: x = cos, z = sin, plaza centre = Origin):
--
--   * PLAZA          a big round cloud island (Phase 5: PlazaRadius 150, 1.8x the Phase 4 area). Its body is a tiered
--                    voxel cloud (white / light-blue, tagged NC_StyleExempt); the top is built in the Phase 4 look again
--                    (Phase 6, 6.0.2 / 6.1 A1: SmoothPlastic, bright lime grass, cream stone paths with darker borders,
--                    glow in Neon) on the Phase 5 layout: the spawn court (concentric cream stone tile rings, a light
--                    ring, a gold sun medallion with Neon arrows in the gate colours), the grand avenue to the Gate
--                    Court (stone kerbs, lamps every 16 studs, a tall cream welcome arch at r 40 carrying the welcome
--                    sign), the circle walk (r 100) with clipped hedges and lamps, the east / west walks, the shop
--                    boardwalk with the fountain roundabout, lawns with trees, benches, flower beds and the six NPC
--                    spots, a kerb along the edge; the leaderboard board LobbyLeaderboard on the south lawn (lobby shop,
--                    spec 5.10: LobbyBoardBuilder.Leaderboard, polar 295 degrees r 48, facing the centre; the client's
--                    PlayerGui SurfaceGui adorns its Face).
--   * GATE COURT     (6.1) a sector 48..132 degrees, r 96..146: cream tile rings, a light rim, a raised terrace with
--                    hedges, a banner behind every gate and two obelisks. Five gates left -> right Obby, Dungeon, Ring,
--                    Arena, Altar on the arc r Config.Lobby.GateArcRadius, spread evenly over the court's six Phase 5
--                    slots (GateStep degrees apart) around GateFacing, the Ring gate in the middle, every gate facing
--                    the spawn (WorldStyle.BuildGate: the P4 round voxel hoop family, 6.0.3). Phase 6: no Home gate (the
--                    player asked; the Home window's Go home portal is the way home). This module builds Obby and Altar
--                    into the Gates folder; ArenaBuilder adds Ring + Arena, DungeonBuilder the Dungeon gate.
--   * SHOP ISLAND    at Config.Lobby.ShopOffset: four voxel gacha machines (Model Roulette_<Id>, built in
--                    the roulette colour; shop-area spec 16.17.1: the Machine is tagged with the Gumball Globe key
--                    prop_roulette_globe, Primary = the roulette colour, Secondary = its top rarity's (Secret: the
--                    white-gold 255,240,200 since the polish), and only when that tag dresses
--                    LobbyMachineBuilder.GlobeEggs piles eighteen eggs in the glass beside it (the chase egg on
--                    egg_<rarity>, the pile on egg_<rarity>_pile); with no globe id the Machine is tagged with today's uploaded cabinet
--                    prop_roulette instead, the Part build only where that is missing too), the WINGED PETS
--                    rarity board with the seven-egg row in front of it (shop-area 16.17.2: LobbyBoardBuilder.EggRow, a
--                    stone shelf with the seven 3D eggs and a rarity label strip, the walk-up Shop prompt's part; the board's
--                    letters end above the eggs), a token statue and an entrance arch, joined to the plaza by a short
--                    stone neck. The Sky Trove
--                    (Model SkyTrove, store 2026-11-04: a brass-banded chest, its Lid a separate Model hinged at the back
--                    and resting open 18 degrees, a sign post, the gap's light, the Join sign; TroveService puts the
--                    prompt on its PromptPart) is built with the shop (its folder) but stands on the plaza lawn (lobby
--                    shop, spec 5.9 / 16.2: polar G.Trove.Angle, r G.Trove.R, facing the centre: spot C on the west
--                    lawn, between the two west benches by the Guide board).
--   * HOME PLOTS     Config.Lobby.SpotCount cloud islands on Config.Lobby.SpotRingRadius: a puffy cloud body
--                    (billows along the sides and back, a hanging cumulus underneath, a soft rim of puffs on the
--                    outer margins) under a flat PlotSize x PlotSize mowed lawn yard (kept EMPTY for the
--                    phase-2 home), fence posts and rails, a gate facing the ring street, a mailbox with the
--                    nameplate, the pet podium.
--   * RING STREET    a stone street along the front of every plot; wooden bridges join neighbouring plots
--                    at the junctions. Wooden spoke bridges (supported by cloud puffs) join the plaza to every
--                    other junction; two garden islands hang off the street; one junction slot stays free for
--                    the Storm Altar (LobbyInfo.AltarSite).
--   * SKY            voxel cumulus clouds around the village and one far below it.
--
-- LobbyBuilder.Build() -> LobbyInfo (ARCHITECTURE.md / _V2 / _V3 contract):
--   Folder, SpawnCFrame, Portals = { Obby = PortalInfo (+ Model, PromptPart) } (Phase 5: the one Sky Obby portal),
--   Spots[i] = SpotInfo, Shop = { Roulettes[id], ItemShop = { PromptPart, Center, Model, Lid } (ItemShop = the Sky Trove),
--                              Counter = { PromptPart, Center, Model } | nil } (lobby shop 16.3: the walk-up Shop prompt's
--                              part, shop-area 16.17.2: the egg row's (Model = the EggRow, Center = the WINGED PETS
--                              board's Face); the fallback shop's own ShopCounter; nil only when the egg row failed),
--   NpcSpots = { CFrame x6 }   ground-level CFrames on the plaza lawn beside the walkways, LookVector = towards
--                              the walkway / court, each with ~5 studs of free space for an NPC pedestal
--   AltarSite = CFrame | nil   reserved, empty spot inside the ring for the Storm Altar island (faces the plaza)
--   AltarDock = Vector3 | nil  inner edge of the street junction in front of it (where a bridge can dock; that
--                              junction's inner rope rail is left open for the altar's bridge and gate)
--   Phase 3 (built by ArenaBuilder into workspace.BattleArena; the lobby only keeps their ground free):
--   ArenaAngle = degrees | nil  the spoke just past the last portal; its junction's OUTER rope rail is open
--   ArenaDock = Vector3 | nil   outer edge of that junction on the spoke's ray: the arena bridge leaves the street here
--   ArenaBridgeWidth = studs    the arena bridge's deck width (the rail gap is 1.6 studs wider)
--   Phase 5 (6.1): GateSites = { Obby, Dungeon, Ring, Arena, Altar } ground CFrames of the gate centres
--                              (LookVector = towards the plaza centre); RingSite = GateSites.Ring; DungeonSite =
--                              GateSites.Dungeon; GatesFolder = workspace.NimbusLobby.Gates; Gates = { Obby, Altar
--                              = { Model, Pad, PromptPart } } (GateService / PortalService put the prompts on them);
--                              Gates.Altar.ReturnCFrame = the way back's arrival (lobby shop 5.11 a: on the front half
--                              of the Altar gate's pad, 3 studs over its top; the pad is no trigger).
--                              NimbusLobby.PartCount is written by Main after the last gate builder, not here.
-- SpotInfo also carries PlotCFrame (centre of the flat yard surface, LookVector = towards the gate),
-- PlotSize (= Config.Lobby.PlotSize), GateCFrame (gate, on the ground) and Accent (the plot colour).
-- Spot folders are named Spot_NN and carry the attribute SpotIndex; portal / roulette models are named
-- Portal_<Id> / Roulette_<Id> (tutorial targets).
--
-- Walkability: every walking surface is a flat collidable part at the plaza height (TOP); layers that meet
-- differ by at most 0.3 studs (no gaps, no jumps, no z-fighting: overlapping layers are offset in height).
-- Decor stands on the surface under it: props on the lawn sit LAWN studs under TOP (nothing hovers), pennants
-- hang from their rope, puffs under bridges stop at the deck, and no cloud rises over a path or an exit.
-- No server-side animation (v3 replication rule): life comes from ParticleEmitters and lights only.
--
-- Part budget: the lobby with all six gates <= 8000 parts after the greedy voxel merge (10.3). Repeated decor (trees, lamps, benches, flower beds,
-- the whole plot with its island, fence and gate, cloud puffs, sky clouds) is sculpted once and :Clone()d.
-- No external assets: Parts, built-in particle textures and Theme-styled GUI text. Deterministic (seeded).
-- ProximityPrompts are NOT created here: PetService attaches them to the PromptParts (the machines' and, lobby shop
-- 16.3, the walk-up ShopPrompt on Shop.Counter.PromptPart; TroveService the Sky Trove's). The one exception
-- (bug batch 2 #7): every bench's "Sit" prompts, handled here (Benches).
--
-- Robustness: gates, spots, the shop machines and the item stall are what other services depend on. Each
-- is built inside pcall with a plain-part fallback that still returns the same LobbyInfo shape (the
-- fallbacks also cover a missing shared/Voxel module), and all decoration runs in guarded sections.
-- Plain Lua 5.1-compatible syntax only.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)
local PixelIcon = require(Shared.PixelIcon) -- (kit-b U7b) the token coin on the machines' price signs
local WorldTag = require(Shared.WorldTag) -- (Pitch 2 item 04 B) THE GATES face as a stone card
local LobbyBoardBuilder = require(script.Parent.LobbyBoardBuilder) -- lobby shop: the egg row and the leaderboard board
local LobbyMachineBuilder = require(script.Parent.LobbyMachineBuilder) -- shop-area 16.17.1: the Gumball Globe's eggs

local LobbyBuilder = {}

local function loadShared(name)
	local inst = Shared:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[LobbyBuilder] shared/" .. name .. " unavailable: " .. tostring(result))
	return nil
end

local Voxel = loadShared("Voxel")
local WorldStyle = loadShared("WorldStyle")
local DETAIL_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail" -- pure decor (Low graphics hides it)
local EXEMPT_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Exempt) or "NC_StyleExempt" -- voxel clouds / pets / tokens

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------

local LOBBY = Config.Lobby
local ORIGIN = LOBBY.Origin
local TOP = ORIGIN.Y -- y of every walking surface
local LAWN = 0.4 -- the lawn layer's top sits this far under TOP (paths 0, borders -0.1, patches -0.3)
local OX, OZ = ORIGIN.X, ORIGIN.Z
local PLAZA_R = (LOBBY.PlazaRadius or 110) + 6 -- walkable radius of the plaza ground
local SPOT_R = LOBBY.SpotRingRadius or 300
local SPOT_COUNT = math.max(1, LOBBY.SpotCount or 16)
local PLOT = LOBBY.PlotSize or 72
local SEED = 20261009
local MAT = Enum.Material
local FxSprites = require(Shared.FxSprites) -- the game's own particle sprites (kit B X1)

-- Glyphs as UTF-8 byte escapes (keeps the source file ASCII): typography only. kit-b U7b: the prices' token is the
-- PixelIcon coin (tokenPrice); the star and cloud emoji went with the unused star row
local GLYPH = {
	Bullet = "\226\128\162",
	Ellipsis = "\226\128\166",
}

local function atan2(y, x)
	if math.atan2 then
		return math.atan2(y, x)
	end
	return math.atan(y, x)
end

-- Layout numbers (studs). Plot-local frames: origin = yard centre on the ground, -Z = towards the plaza
-- (the gate side), +X = across.
local G = {}
-- Phase 5 Gate Court (6.1): six gates on an arc in front of the spawn
G.GateR = LOBBY.GateArcRadius or 118
G.GateStep = LOBBY.GateStep or 14.5
G.GateFacing = LOBBY.GateFacing or 90
G.CourtSlots = 6 -- Phase 6: the court keeps its Phase 5 width of six gate slots; the five gates spread over it
G.CourtR = 34 -- the spawn court (Slate rings + a Marble ring around the medallion)
G.AvenueHalf = 10 -- the grand avenue to the Gate Court (20 wide, Cobblestone, Brick kerbs)
G.RingRoadR = 100 -- the cobbled circle walk around the lawns (the spokes leave it)
G.CourtIn = 96 -- the Gate Court sector: Slate rings from r 96 ...
G.CourtOut = 146 -- ... to r 146
G.TerraceIn = 126 -- the raised terrace behind the gates (r 126 .. 146)
G.TerraceLift = 0.3
G.PadR = G.GateR - 14 -- pad centres (WorldStyle.BuildGate puts the pad 14 studs in front of the gate)
G.PathHalf = 5 -- radial stone paths (half width incl. border)
G.BoardHalf = 7 -- the wooden boardwalk to the shop
G.StubHalf = 5 -- sand paths to the spoke bridges
G.FountainD = 66 -- fountain roundabout, distance from the centre towards the shop
G.Step = 360 / SPOT_COUNT
G.HalfStep = G.Step / 2
G.PlotHalf = PLOT / 2
G.Verge = 4
G.StreetW = 14
G.StreetZ = -(G.PlotHalf + G.Verge + G.StreetW / 2) -- plot-local z of the street centre line
G.StreetR = SPOT_R + G.StreetZ -- distance of the street centre line from the origin
G.IslandHalfX = G.PlotHalf + 6
G.IslandBack = G.PlotHalf + 6
G.IslandFront = G.StreetZ - G.StreetW / 2
G.JunctionX = G.StreetR * math.tan(math.rad(G.HalfStep)) -- plot-local x of the junctions
G.StreetExt = (G.StreetW / 2) * math.tan(math.rad(G.HalfStep)) + 0.8 -- overlap past the junction
G.SpokeEndR = (G.StreetR - G.StreetW / 2) / math.cos(math.rad(G.HalfStep)) + 2.4
G.SpokeW = 10
G.GardenR = (PLAZA_R + G.StreetR - G.StreetW / 2) / 2 -- garden island centres, halfway between the plaza and the street (221)
G.GardenSize = 22 -- garden island radius
G.ArenaBridgeW = 12 -- Phase 3: the arena bridge (ArenaBuilder) leaves the street through a gap this wide + 1.6
-- lobby shop (spec 5.9; spot C, the owner's pick, spec 16.2): the Sky Trove on the plaza lawn (polar degrees, radius,
-- plazaSpot clearance) at plaza-local (-48.30, 12.94): the west lawn between the two west benches (130 / 200 degrees r 44,
-- 28.84 studs each), beside the Guide board (148 degrees r 48, 14.62 apart, 12.5 needed), 12.94 off the west walk's
-- centre line (11.5 needed); about 75 degrees to the right of the spawn's view up the avenue
G.Trove = { Angle = 165, R = 50, Clear = 6.5 }

----------------------------------------------------------------------
-- Palette: cheerful but not blinding. Nothing is pure white (cloud tops stay below 249 on red).
----------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Phase 6 (6.0.2 / 6.1 A1): the Phase 4 look again (7aa0df2 LobbyBuilder palette): bright lime grass, cream stone
-- paths with darker borders, white / light-blue clouds, everything SmoothPlastic (glow Neon, water Glass). The
-- Phase 5 layout keys (Slate courts, Marble rings and arches, Navy signs) keep their names with P4 colours.
local C = {
	CloudLight = rgb(244, 247, 252),
	Cloud = rgb(232, 238, 249),
	CloudShade = rgb(212, 222, 241),
	Mist = rgb(194, 211, 240),
	MistDark = rgb(170, 190, 228),
	Grass = rgb(108, 186, 86),
	GrassLight = rgb(132, 202, 98),
	GrassDark = rgb(86, 160, 76),
	GrassWild = rgb(94, 168, 76), -- bug #12: the unmown outer meadow's floor (between Grass and GrassDark)
	Hedge = rgb(74, 146, 72),
	HedgeLight = rgb(100, 170, 84),
	Stone = rgb(208, 202, 190), -- cream stone paths
	StoneLight = rgb(226, 221, 209),
	StoneDark = rgb(172, 164, 154),
	StoneEdge = rgb(146, 138, 132), -- path borders / kerbs
	Slate = rgb(214, 208, 196), -- the courts: cream stone tiles (a hair lighter than the paths)
	SlateLight = rgb(228, 223, 211),
	SlateDark = rgb(172, 164, 154),
	Marble = rgb(242, 237, 226), -- the courts' light rings, arches, columns
	MarbleShade = rgb(226, 221, 209),
	Sand = rgb(236, 214, 166),
	SandDark = rgb(212, 186, 138),
	Plank = rgb(196, 146, 98),
	PlankLight = rgb(214, 166, 114),
	PlankDark = rgb(152, 108, 72),
	Bark = rgb(132, 92, 62),
	Iron = rgb(64, 70, 92),
	IronLight = rgb(96, 104, 130),
	Gold = rgb(244, 198, 84),
	GoldDark = rgb(206, 154, 62),
	Lamp = rgb(255, 214, 140),
	Water = rgb(92, 178, 236),
	WaterDeep = rgb(62, 136, 212),
	Leaf = rgb(98, 178, 80),
	Pine = rgb(60, 138, 92),
	Blossom = rgb(246, 174, 204),
	BlossomWhite = rgb(250, 228, 238),
	Soil = rgb(120, 86, 64),
	-- the Sky-Oasis fountain (bug #13): cool natural rock, island soil, twigs, rope, the paper boat, the sign's paint
	Rock = rgb(170, 170, 186),
	RockDark = rgb(140, 142, 160),
	Dirt = rgb(150, 106, 72),
	DirtDark = rgb(120, 84, 58),
	PoolFloor = rgb(112, 132, 156),
	Twig = rgb(156, 112, 70),
	Rope = rgb(214, 192, 142),
	Paper = rgb(250, 248, 240),
	SignPaint = rgb(122, 170, 206),
	Navy = rgb(34, 42, 76),
	Violet = rgb(68, 60, 118),
	Ink = (Theme.Colors and Theme.Colors.Ink) or rgb(26, 32, 64),
	Text = rgb(238, 243, 252),
	TextDim = rgb(190, 202, 230),
	TextGold = rgb(246, 216, 132),
	StarOff = rgb(96, 104, 136),
	Rose = rgb(234, 120, 146),
	Cream = rgb(246, 234, 210),
	PanelTop = rgb(68, 60, 118), -- sign GUI panels only (never a part colour)
	PanelBottom = rgb(34, 42, 76),
}

-- Material of every colour key: the P4 look is SmoothPlastic everywhere; lamps glow (Neon), water is Glass.
-- (materialOf keeps the Phase 5 material names working: they all resolve to SmoothPlastic.)
local MATS = {
	Lamp = "Neon", Water = "Glass", WaterDeep = "Glass",
}
local LOOK_MATERIALS = { Neon = MAT.Neon, Glass = MAT.Glass, SmoothPlastic = MAT.SmoothPlastic }
local function materialOf(name)
	return LOOK_MATERIALS[name] or MAT.SmoothPlastic
end
-- colour -> material for box() calls that pass a C colour (keyed by "r,g,b": Color3 values are not table keys)
local function colorKey(color)
	return string.format("%d,%d,%d", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end
local MAT_BY_COLOR = {}
for key, name in pairs(MATS) do
	if C[key] then
		MAT_BY_COLOR[colorKey(C[key])] = materialOf(name)
	end
end

local FLOWERS = {
	rgb(246, 150, 188), -- pink
	rgb(250, 214, 92), -- yellow
	rgb(244, 244, 248), -- white (not pure)
	rgb(172, 142, 232), -- violet
	rgb(236, 104, 108), -- red
	rgb(112, 172, 240), -- blue
}

-- One accent per home plot (cycled): banner, mailbox flag, podium trim.
local ACCENTS = {
	rgb(232, 112, 132),
	rgb(240, 160, 84),
	rgb(236, 204, 92),
	rgb(108, 192, 124),
	rgb(86, 186, 206),
	rgb(98, 148, 226),
	rgb(154, 122, 222),
	rgb(222, 120, 192),
}

-- The five gates of the Gate Court, left -> right (6.1 / 6.2): id, gate colour (WorldStyle.Palette.Accent), glyph.
-- (Phase 6: the Home gate is gone; players go home with the Home window's Go home button.)
local GATE_SPECS = {
	{ Id = "Obby", Accent = "Blue", Glyph = "cloud" },
	{ Id = "Dungeon", Accent = "Purple", Glyph = "torch" },
	{ Id = "Ring", Accent = "Gold", Glyph = "crown" },
	{ Id = "Arena", Accent = "Red", Glyph = "swords" },
	{ Id = "Altar", Accent = "Cyan", Glyph = "bolt" },
}
local function gateAccent(name)
	local acc = WorldStyle and WorldStyle.Palette and WorldStyle.Palette.Accent
	return (acc and acc[name]) or C.Gold
end

-- One palette for every voxel grid (keys are shared; Voxel derives missing _Light / _Dark variants).
local P = {}
for key, color in pairs(C) do
	P[key] = { Color = color, Material = materialOf(MATS[key] or "SmoothPlastic") }
end
P.GoldGlow = { Color = C.Gold, Material = MAT.Neon }
P.Water = { Color = C.Water, Material = materialOf("Glass"), Transparency = 0.35 }
for i, color in ipairs(FLOWERS) do
	P["Flower" .. i] = { Color = color, Material = materialOf("LeafyGrass") }
end
for i, spec in ipairs(GATE_SPECS) do
	P["Gate" .. i] = { Color = gateAccent(spec.Accent), Material = MAT.Neon }
end

-- Cloud keys used by tiers, from the top tier down (height-banded shading: cheap and soft).
local TIER_KEYS = { "CloudLight", "Cloud", "CloudShade", "Mist", "MistDark" }

----------------------------------------------------------------------
-- Per-build state
----------------------------------------------------------------------

local templates = {} -- name -> unparented Model built at the origin, cloned with place()
local reserved = {} -- { x, z, radius } world circles taken by plaza decor (keeps props apart)

----------------------------------------------------------------------
-- Small math helpers
----------------------------------------------------------------------

local function polar(angleDeg, radius, y)
	local a = math.rad(angleDeg)
	return Vector3.new(OX + math.cos(a) * radius, y or TOP, OZ + math.sin(a) * radius)
end

local function dirOf(angleDeg)
	local a = math.rad(angleDeg)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- CFrame at `pos` looking (flat) at `target`.
local function flatLook(pos, target)
	local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	if d.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + d.Unit)
end

local function faceCentre(pos)
	return flatLook(pos, Vector3.new(OX, pos.Y, OZ))
end

local function angleDiff(a, b)
	local d = math.abs((a - b) % 360)
	if d > 180 then
		d = 360 - d
	end
	return d
end

local function nearAny(angle, list, half)
	for _, other in ipairs(list or {}) do
		if angleDiff(angle, other) < half then
			return true
		end
	end
	return false
end

-- angle inside [from, to] (degrees, from may be negative)
local function angleIn(angle, from, to)
	local a = (angle - from) % 360
	return a <= (to - from)
end

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

-- Deterministic hash of integers -> [0, 1). The squared term makes hashes with different seeds independent.
local function hash3(x, y, z, seed)
	local h = (x * 73856093 + y * 19349663 + z * 83492791 + seed * 2654435761) % 2147483647
	h = (h * 16807) % 2147483647
	local a = h % 65521
	a = (a * a + seed * 7919 + 12345) % 65521
	h = ((h + a * 32771) * 16807) % 2147483647
	return h / 2147483647
end

-- Smooth 2D value noise in 0..1 (deterministic).
local function vnoise(x, z, scale, seed)
	local fx, fz = x / scale, z / scale
	local x0, z0 = math.floor(fx), math.floor(fz)
	local tx, tz = fx - x0, fz - z0
	tx = tx * tx * (3 - 2 * tx)
	tz = tz * tz * (3 - 2 * tz)
	local a, b = hash3(x0, 0, z0, seed), hash3(x0 + 1, 0, z0, seed)
	local c, d = hash3(x0, 0, z0 + 1, seed), hash3(x0 + 1, 0, z0 + 1, seed)
	local ab = a + (b - a) * tx
	local cd = c + (d - c) * tx
	return ab + (cd - ab) * tz
end

----------------------------------------------------------------------
-- Instance helpers
----------------------------------------------------------------------

local function newFolder(parent, name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function newModel(parent, name)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- One anchored block. opts: Collide (default false), Material, Transparency, Shadow, Reflectance.
local function box(parent, name, cf, size, color, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	-- the P4 look: SmoothPlastic unless the caller (or the colour: lamps, water) says Neon / Glass
	p.Material = opts.Material or MAT_BY_COLOR[colorKey(color)] or MAT.SmoothPlastic
	p.Transparency = opts.Transparency or 0
	if opts.Reflectance then
		p.Reflectance = opts.Reflectance
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.Collide == true
	p.CanQuery = opts.Collide == true or opts.Query == true
	p.CanTouch = false
	if opts.Shadow ~= nil then
		p.CastShadow = opts.Shadow == true
	else
		p.CastShadow = math.max(size.X, size.Y, size.Z) >= 4
	end
	p.Parent = parent
	return p
end

-- Invisible part used to host emitters / billboards / lights.
local function anchorPart(parent, name, pos, size)
	local p = box(parent, name, CFrame.new(pos), size or Vector3.new(1, 1, 1), C.Cloud, { Transparency = 1, Shadow = false })
	return p
end

local FADE_IN_OUT = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.25, 0.2),
	NumberSequenceKeypoint.new(0.75, 0.2),
	NumberSequenceKeypoint.new(1, 1),
})

local function popSize(maxSize)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, maxSize),
		NumberSequenceKeypoint.new(1, 0),
	})
end

-- Sparkle ParticleEmitter with soft defaults; `props` overrides anything (props.Sprite: another FxSprites role).
local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	FxSprites.Apply(e, props and props.Sprite or "Sparkle")
	e.Color = ColorSequence.new(C.TextGold)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = 6
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(1, 2)
	e.Size = popSize(0.7)
	e.Transparency = FADE_IN_OUT
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	if props then
		for key, value in pairs(props) do
			if key ~= "Sprite" then
				e[key] = value
			end
		end
	end
	e.Parent = parent
	return e
end

local function pointLight(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- GUI helpers (all text goes through Theme font roles)
----------------------------------------------------------------------
-- World text rule (ARCHITECTURE_V3.md, added after the playtest "letters too small"):
--   * Tags above things are PIXEL-sized BillboardGuis (offset UDim2), so their text keeps one on-screen size at
--     any distance: names >= 22 px and info lines >= 18 px at 1080p, ink on a compact stone plate (kit B)
--     that sizes itself to its text, LightInfluence 0 and a MaxDistance of ~60-120 studs (a gate's name card 55:
--     the gate card range, WorldStyle.TagRange; 2026-11-13 owner: 55, was 45).
--   * Signs on surfaces are SurfaceGuis at SIGN_PPS pixels per stud with FIXED text sizes: titles >= 1 stud,
--     info lines >= 0.6 stud.
--   * Never TextScaled in the world: the engine drew the auto-scaled world text tiny in the playtest.

local TAG_NAME = 28 -- px: the name / title of a tag
local TAG_INFO = 20 -- px: info lines of a tag
local TAG_SMALL = 18 -- px: badges and pills (the info-line minimum)
local TAG_RANGE = 110 -- studs: MaxDistance of an ordinary tag
local SIGN_PPS = 50 -- pixels per stud on every surface sign
local SIGN_TITLE = 56 -- px at SIGN_PPS = 1.12 studs
local SIGN_INFO = 30 -- px at SIGN_PPS = 0.6 stud

-- Pixel-sized tag on `adornee`. The `w` x `h` container is transparent (the plate inside sizes itself to its
-- text); SizeOffset puts the container's BOTTOM edge on the adornee, raised `lift` studs in world space, so the
-- tag grows upwards and never sinks into what it labels, whatever the camera distance.
local function newTag(adornee, name, w, h, lift, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name or "Tag"
	gui.Size = UDim2.fromOffset(w, h)
	gui.SizeOffset = Vector2.new(0, 0.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift or 0, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or TAG_RANGE
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

local function listLayout(parent, direction, gap, hAlign)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction or Enum.FillDirection.Vertical
	layout.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, gap or 0)
	layout.Parent = parent
	return layout
end

local function plainFrame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	if props then
		for key, value in pairs(props) do
			f[key] = value
		end
	end
	f.Parent = parent
	return f
end

-- (Pitch 2 item 04_world_ui, the owner's pick B "Stone tags", carried to the lobby's own signs: the navy gradient plates,
-- the rounded pills, the outlined and gradient letters went) every tag and board here is a kit B stone block
-- (shared/WorldTag, the NPC card / THE GATES face): the Stone face, a mitred wood edge (the Border UIStroke SignEdge, drawn
-- outside the face), a darker lip along the bottom in the sign's accent (WorldTag.LipOf: the plot / roulette / gate
-- colour); its lines in the kit's brown ink on the opaque face (WorldTag.Text, no outline); a pill is a small square block
-- tinted in its colour (WorldTag.Tint). A UIListLayout would lay the Lip out as one more row, so a tag's lines are placed
-- by hand from their measured text (Theme.Measure, as WorldStyle.BuildTag does) and placed again whenever a text changes
-- (SpotService's owner names, PortalService's party line on the stand-in gate).
local KIT = {
	Sign = Theme.Sign,
	Edge = WorldTag.Sizes.Edge, -- 3 px: a tag's wood edge
	Lip = WorldTag.Sizes.Lip, -- 5 px: ... and its lip
	PadX = 16, -- px each side of the widest line, inside the face
	PadTop = 6,
	PadBottom = 5, -- over the lip
	Gap = 2,
	PillGap = 4, -- extra px over a pill
	PillEdge = 2,
	PillLip = 3,
	PillPad = 10, -- px each side of a pill's text
	BoardEdge = 6, -- a surface board's wood edge (THE GATES face)
	BoardLip = 8,
}

-- a line's box as the label shows it: its text measured in its role (+ its UIPadding: a PixelIcon.Lead coin) -> w, h
function KIT.LineSize(label)
	local pad = label:FindFirstChildOfClass("UIPadding")
	local padW = pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0
	local m = Theme.Measure(label.Text, label:GetAttribute("KitRole") or "Body", label.TextSize)
	return math.ceil(m.X) + padW, label.TextSize + 4
end

-- a pill block sized to its text (the first TextLabel in it), the lip under the text
function KIT.FitPill(pill)
	local label = pill:FindFirstChildWhichIsA("TextLabel")
	if not label then
		return
	end
	local w, h = KIT.LineSize(label)
	pill.Size = UDim2.fromOffset(w + 2 * KIT.PillPad, h + KIT.PillLip)
	label.AnchorPoint = Vector2.new(0, 0)
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(1, 0, 1, -KIT.PillLip)
	label.TextXAlignment = Enum.TextXAlignment.Center
end

-- a tag's plate laid out: its visible lines and pills (LayoutOrder, then the order they were added) one under the other,
-- centred, the plate as wide as the widest (never under its KitMinW) and as tall as they need over its lip
KIT.Laying = setmetatable({}, { __mode = "k" })
function KIT.Stack(plate)
	if KIT.Laying[plate] then
		return
	end
	KIT.Laying[plate] = true
	local items = {}
	for i, c in ipairs(plate:GetChildren()) do
		if c:IsA("GuiObject") and c.Name ~= "Lip" and c.Visible then
			items[#items + 1] = { c = c, i = i }
		end
	end
	table.sort(items, function(a, b)
		if a.c.LayoutOrder ~= b.c.LayoutOrder then
			return a.c.LayoutOrder < b.c.LayoutOrder
		end
		return a.i < b.i
	end)
	local widest, y = 0, KIT.PadTop
	for n, it in ipairs(items) do
		local c = it.c
		if c:IsA("TextLabel") then
			local w, h = KIT.LineSize(c)
			c.AnchorPoint = Vector2.new(0.5, 0)
			c.Position = UDim2.new(0.5, 0, 0, y)
			c.Size = UDim2.fromOffset(w, h)
			c.TextXAlignment = Enum.TextXAlignment.Center
			widest = math.max(widest, w)
			y = y + h
		else -- a pill block: its edge is drawn outside it
			KIT.FitPill(c)
			y = y + (n > 1 and KIT.PillGap or 0)
			c.AnchorPoint = Vector2.new(0.5, 0)
			c.Position = UDim2.new(0.5, 0, 0, y + KIT.PillEdge)
			widest = math.max(widest, c.Size.X.Offset + 2 * KIT.PillEdge)
			y = y + c.Size.Y.Offset + 2 * KIT.PillEdge
		end
		if n < #items then
			y = y + KIT.Gap
		end
	end
	local minW = tonumber(plate:GetAttribute("KitMinW")) or 0
	plate.Size = UDim2.fromOffset(math.max(minW, widest + 2 * KIT.PadX), y + KIT.PadBottom + KIT.Lip)
	KIT.Laying[plate] = nil
end

-- lays the plate out now and again whenever one of its texts (or a pill's) changes or a pill is shown / hidden
function KIT.Done(plate)
	local function again()
		KIT.Stack(plate)
	end
	for _, c in ipairs(plate:GetChildren()) do
		if c:IsA("GuiObject") and c.Name ~= "Lip" then
			c:GetPropertyChangedSignal("Visible"):Connect(again)
			local labels = c:IsA("TextLabel") and { c } or {}
			for _, d in ipairs(c:GetChildren()) do
				if d:IsA("TextLabel") then
					labels[#labels + 1] = d
				end
			end
			for _, l in ipairs(labels) do
				l:GetPropertyChangedSignal("Text"):Connect(again)
				l:GetPropertyChangedSignal("TextSize"):Connect(again)
				l.ChildAdded:Connect(function() -- a PixelIcon.Lead added later pads the label: measure it again
					task.defer(again)
				end)
			end
		end
	end
	again()
	return plate
end

-- canvas fractions -> the place on a board's panel: a panel signPanel made (inset by its edge) is placed in px of the
-- whole canvas, so every line keeps the place it had on the old full-face panel; any other parent takes the fractions
function KIT.Place(parent, x, y, w, h)
	local cw, ch = parent:GetAttribute("CanvasW"), parent:GetAttribute("CanvasH")
	if type(cw) == "number" and type(ch) == "number" then
		local inset = tonumber(parent:GetAttribute("CanvasInset")) or 0
		return UDim2.fromOffset(x * cw - inset, y * ch - inset), UDim2.fromOffset(w * cw, h * ch)
	end
	return UDim2.new(x, 0, y, 0), UDim2.new(w, 0, h, 0)
end

-- A tag's stone plate, standing on the bottom centre of the tag (raised by its edge: a BillboardGui clips what lies outside
-- it), its lip in WorldTag.LipOf(accent). Its lines are tagText / tagPill children; KIT.Done(plate) lays them out.
local function tagPlate(gui, accent, minW)
	local plate = plainFrame(gui, "Plate", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -KIT.Edge),
		Size = UDim2.fromOffset(minW or 0, 0),
		ZIndex = 2,
	})
	plate:SetAttribute("KitMinW", minW or 0)
	WorldTag.Block(plate, KIT.Sign.Stone, WorldTag.LipOf(accent), KIT.Sign.Wood, KIT.Edge, KIT.Lip)
	return plate
end

-- Fixed-size ink text on a kit face (no outline), its box set by KIT.Stack / the caller.
local function tagText(parent, name, text, role, size, color, order)
	local label = WorldTag.Text(parent, name, text, role, size, color or KIT.Sign.Text, {
		Size = UDim2.fromOffset(0, size + 4),
		LayoutOrder = order or 0,
		ZIndex = 3,
	})
	label:SetAttribute("KitRole", role)
	return label
end

-- A pill: a small square block in `colour` (WorldTag.Tint: a light face of it, its lip the colour, the text in ink)
-- round one short text (status, rarity), sized to it. Returns pill, label.
local function tagPill(parent, name, text, role, size, colour, order)
	local pill = plainFrame(parent, name, { LayoutOrder = order or 0, ZIndex = 3 })
	WorldTag.Block(pill, colour, colour, KIT.Sign.Wood, KIT.PillEdge, KIT.PillLip)
	local label = tagText(pill, name .. "Label", text, role, size, KIT.Sign.Text, 1)
	label.ZIndex = 4
	WorldTag.Tint(pill, colour)
	KIT.FitPill(pill)
	return pill, label
end

local function surfaceGui(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SIGN_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	return gui
end

-- A board's stone panel (THE GATES face): inset by its wood edge so the canvas keeps the edge, a lip along the bottom
-- (`lip`, else the stone's), the part's face painted Stone under it. signText places lines in fractions of the canvas.
local function signPanel(gui, lip, edgePx, lipPx)
	edgePx, lipPx = edgePx or KIT.BoardEdge, lipPx or KIT.BoardLip
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Position = UDim2.fromOffset(edgePx, edgePx)
	panel.Size = UDim2.new(1, -2 * edgePx, 1, -2 * edgePx)
	panel.Parent = gui
	WorldTag.Block(panel, KIT.Sign.Stone, lip or KIT.Sign.StoneLip, KIT.Sign.Wood, edgePx, lipPx)
	local part = gui.Adornee
	if part and part:IsA("BasePart") then
		local s, face = part.Size, gui.Face
		local fw, fh = s.X, s.Y
		if face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
			fw, fh = s.X, s.Z
		elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
			fw, fh = s.Z, s.Y
		end
		panel:SetAttribute("CanvasW", fw * gui.PixelsPerStud)
		panel:SetAttribute("CanvasH", fh * gui.PixelsPerStud)
		panel:SetAttribute("CanvasInset", edgePx)
	end
	return panel
end

-- Sign text with a FIXED size (px at SIGN_PPS) in the kit's ink (no outline), placed with fractions of the canvas (on a
-- signPanel) or of its parent (x, y, w, h).
local function signText(parent, text, role, size, color, name, x, y, w, h, align, wrap)
	local label = WorldTag.Text(parent, name, text, role, size, color or KIT.Sign.Text, {
		TextWrapped = wrap == true,
		TextXAlignment = align or Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
	})
	label.Position, label.Size = KIT.Place(parent, x, y, w, h)
	return label
end

-- the old outlined sign text (ONE world outline in the ink, the colour the caller's, fractions of the parent), kept only
-- for LobbyBoardBuilder's egg-row RarityStrip (its own builder, a navy band: L.H.signText) until that builder moves to the
-- kit; L.H.kitText is the kit's signText above
function KIT.OutlinedText(parent, text, role, size, color, name, x, y, w, h, align, wrap)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Outline = "World", -- a world sign: ONE outline, no classic stroke (kit-b U6)
		OutlineThickness = math.max(2, math.floor(size / 16 + 0.5)),
		OutlineColor = (Theme.Colors and Theme.Colors.TextStroke) or C.Ink,
		Props = {
			Name = name,
			Position = UDim2.new(x, 0, y, 0),
			Size = UDim2.new(w, 0, h, 0),
			TextWrapped = wrap == true,
			TextXAlignment = align or Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	label.Parent = parent
	return label
end

-- "50" / "5,000" (kit-b U7b: the token is the PixelIcon coin in front, tokenPrice)
local function priceText(price)
	return Util.Commas(price)
end

-- (kit-b U7b) a token price label: the coin (Theme.Currency.Tokens.Icon) drawn in front of the amount
local function tokenPrice(label)
	local cur = Theme.Currency and Theme.Currency.Tokens
	PixelIcon.Lead(label, cur and cur.Icon or "token")
	return label
end

-- A key-cap chip + a description: one row of a notice board (fractions of the 550 x 400 px board canvas). The chip is a
-- small raised stone block (Tile face, a 2 px wood edge inside the old chip's box, a stone lip).
local function keyRow(parent, y, rowH, keyText, descText)
	local chip = Instance.new("Frame")
	chip.Name = "KeyChip"
	-- (T0 review) 0.30 wide (165 px): DUNGEON at 30 px fits it; the description moves right to match and keeps the board's
	-- right margin
	local pos, size = KIT.Place(parent, 0.04, y, 0.30, rowH)
	chip.Position = UDim2.new(pos.X.Scale, pos.X.Offset + 2, pos.Y.Scale, pos.Y.Offset + 2)
	chip.Size = UDim2.new(size.X.Scale, size.X.Offset - 4, size.Y.Scale, size.Y.Offset - 4)
	chip.Parent = parent
	WorldTag.Block(chip, KIT.Sign.Tile, KIT.Sign.StoneLip, KIT.Sign.Wood, 2, 4)
	local key = signText(chip, keyText, "Heading", SIGN_INFO, KIT.Sign.Text, "Key", 0, 0, 1, 1)
	key.Size = UDim2.new(1, 0, 1, -4)
	signText(parent, descText, "Body", SIGN_INFO, KIT.Sign.Text, "Desc", 0.355, y, 0.62, rowH, Enum.TextXAlignment.Left)
end

----------------------------------------------------------------------
-- Voxel helpers
----------------------------------------------------------------------

local VX = {}

-- Vertical cylinder of voxels (voxel units). keep = only fill empty voxels.
function VX.Disc(g, cx, cz, r, y0, y1, key, keep)
	local ri = math.ceil(r) + 1
	local r2 = r * r
	for y = y0, y1 do
		for x = math.floor(cx) - ri, math.ceil(cx) + ri do
			for z = math.floor(cz) - ri, math.ceil(cz) + ri do
				local dx, dz = x - cx, z - cz
				if dx * dx + dz * dz <= r2 and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

function VX.Ring(g, cx, cz, r0, r1, y0, y1, key)
	local ri = math.ceil(r1) + 1
	for y = y0, y1 do
		for x = math.floor(cx) - ri, math.ceil(cx) + ri do
			for z = math.floor(cz) - ri, math.ceil(cz) + ri do
				local dx, dz = x - cx, z - cz
				local d = math.sqrt(dx * dx + dz * dz)
				if d >= r0 and d <= r1 then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- Inclusive integer box of voxels.
function VX.Fill(g, x0, x1, y0, y1, z0, z1, key)
	for y = y0, y1 do
		for x = x0, x1 do
			for z = z0, z1 do
				Voxel.Set(g, x, y, z, key)
			end
		end
	end
end

-- Rounded rectangle prism centred on (cx, cz): sx by sz voxels, corner radius `round`.
function VX.RoundRect(g, cx, cz, sx, sz, round, y0, y1, key, keep)
	local hx, hz = sx / 2, sz / 2
	round = math.max(0, math.min(round, hx, hz))
	for y = y0, y1 do
		for x = math.floor(cx - hx) - 1, math.ceil(cx + hx) + 1 do
			for z = math.floor(cz - hz) - 1, math.ceil(cz + hz) + 1 do
				local qx, qz = math.abs(x - cx) - (hx - round), math.abs(z - cz) - (hz - round)
				local ox, oz = math.max(qx, 0), math.max(qz, 0)
				local d = math.sqrt(ox * ox + oz * oz) + math.min(math.max(qx, qz), 0)
				if d <= round and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- Moves every voxel whose base key is in `keys` into a new grid (for split collision / materials).
function VX.Split(g, keys)
	local out = Voxel.NewGrid(g.Resolution)
	local move = {}
	for k, v in pairs(g.Cells) do
		if keys[Voxel.BaseKey(v)] or keys[v] then
			move[#move + 1] = k
		end
	end
	for _, k in ipairs(move) do
		out.Cells[k] = g.Cells[k]
		out.Count = out.Count + 1
		g.Cells[k] = nil
		g.Count = g.Count - 1
	end
	return out
end

-- Voxel.Build with the lobby defaults. o: V (voxel size), Name, CF (where voxel 0,0,0 sits), Parent,
-- Collide, MaxParts, Keep, Shadow, Pal.
function VX.Build(g, o)
	if not g or g.Count == 0 then
		return nil
	end
	local model = Voxel.Build(g, {
		VoxelSize = o.V or 1,
		Palette = o.Pal or P,
		Name = o.Name or "Voxels",
		CFrame = o.CF or CFrame.new(),
		CanCollide = o.Collide == true,
		CanQuery = o.Collide == true,
		MaxParts = o.MaxParts,
		Keep = o.Keep,
		CastShadow = o.Shadow,
	})
	if o.Parent then
		model.Parent = o.Parent
	end
	return model
end

----------------------------------------------------------------------
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7, owner art-lobby): Blender mesh dressing. Every Part build in this
-- file stays exactly as it is (the fallback, the colliders, every name / prompt / zone / sign); the static decoration
-- subtrees are tagged with MeshLibrary.Tag(target, key, look, keep) and clients Dress them (Parts hidden locally, the
-- mesh placed at the target's pivot * ML_Offset = `origin`). Keys: blender/catalog/lobby.json. A key is tagged only
-- once it has an uploaded id (MeshLibrary.Status ~= "missing"): with the shipped empty MeshIds nothing changes.
-- Keys baked from this file's own layout (clouds, floors, the altar) carry a "LayoutSig" attachment in their manifest
-- (part count + position / size sums of the Part build, relative to `origin`): they are tagged only while the live
-- build still matches it, so a Config change can never show a stale mesh.
----------------------------------------------------------------------
local Mesh = {
	Lib = nil,
	-- template name -> mesh key (place() tags every clone)
	Templates = {
		TreeRound = "prop_tree_round",
		TreeBlossom = "prop_tree_blossom",
		TreePine = "prop_tree_pine",
		Lamp = "prop_lamp",
		Bench = "prop_bench",
		PuffS = "cloud_puff_s",
		PuffM = "cloud_puff_m",
		SkyBig = "cloud_sky_big",
		SkySmall = "cloud_sky_small",
		Plot = "prop_plot",
	},
	-- parts that stay visible over the mesh (live per-plot colour, signs)
	Keep = {
		Plot = { "PodiumBase", "Accent", "PodiumTop" },
	},
	Names = {}, -- template model -> template name
	-- the part names of a dressed cloud puff (Voxel cloud keys + the cloud mesh's parts): kept by the bridge that
	-- carries one, so the two dresses never hide each other
	CloudParts = { "Cloud", "CloudLight", "CloudShade", "Mist", "MistDark", "Puff" },
	Template = nil, -- the template being built (VX.CloudModel records it for the kit)
}

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

-- part count + weighted sums of every visible BasePart's position / size in `origin` space (the kit computes the
-- same numbers from the same build: blender/kit/props/lobby_world.py)
function Mesh.Signature(target, origin)
	local inv = origin:Inverse()
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			local p = inv * d.Position
			local s = d.Size
			n = n + 1
			a = a + p.X + p.Y * 0.37 + p.Z * 0.61
			b = b + s.X + s.Y * 1.3 + s.Z * 1.7
		end
	end
	return n, a, b
end

local function meshSigOk(ML, key, target, origin)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	local att = man and man.Attachments and man.Attachments.LayoutSig
	if not att then
		return true -- a designed prop: no layout to match
	end
	local pos = att.Pos or att.pos
	if type(pos) ~= "table" then
		return false
	end
	local n, a, b = Mesh.Signature(target, origin)
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- target: Model / Part subtree; key: mesh key; origin: world CFrame of the mesh pivot; look: { Primary, Secondary };
-- keep: part names that stay visible. Returns true when tagged.
function Mesh.tag(target, key, origin, look, keep)
	if typeof(target) ~= "Instance" or typeof(origin) ~= "CFrame" then
		return false
	end
	local kit = LobbyBuilder._Kit
	if type(kit) == "table" and type(kit.Targets) == "table" then
		kit.Targets[#kit.Targets + 1] = { Key = key, Target = target, Origin = origin, Look = look, Keep = keep }
	end
	local ML = Mesh.lib()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" or not meshSigOk(ML, key, target, origin) then
		return false
	end
	local tagLook = {}
	for k, v in pairs(look or {}) do
		tagLook[k] = v
	end
	tagLook.Offset = target:GetPivot():Inverse() * origin
	ML.Tag(target, key, tagLook, keep)
	return true
end

-- Clones a template (built at the origin) to `cf`; returns the clone.
local function place(tpl, cf, parent, name)
	if not tpl then
		return nil
	end
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	if not m.PrimaryPart and m:IsA("Model") then
		m.WorldPivot = cf -- the clone's pivot = where it was placed (TutorialController reads Plot:GetPivot())
	end
	if name then
		m.Name = name
	end
	m.Parent = parent
	local tname = Mesh.Names[tpl]
	local key = tname and (Mesh.Templates[tname] or (tname:match("^FlowerBed") and "prop_flowerbed"))
	if key then
		local look = nil
		local v = tonumber(tname:match("^FlowerBed(%d+)"))
		if v then -- the bed's two flower colours (Props.FlowerBed)
			look = { Primary = FLOWERS[v], Secondary = FLOWERS[v % #FLOWERS + 1] }
		end
		Mesh.tag(m, key, cf, look, Mesh.Keep[tname])
	end
	return m
end

local function template(name, make)
	local t = templates[name]
	if t == nil then
		local outer = Mesh.Template
		Mesh.Template = name
		local ok, result = pcall(make)
		Mesh.Template = outer
		if ok and result then
			t = result
			Mesh.Names[t] = name
		else
			warn("[LobbyBuilder] template " .. name .. " failed: " .. tostring(result))
			t = false
		end
		templates[name] = t
	end
	return t or nil
end

-- One flat layer of ground cells (a one-voxel-thick grid) whose top face sits at topY. fn(x, z) -> key | nil
-- gets the cell centre in studs relative to `centre`. Layers that overlap are offset in height (no z-fight).
local function groundLayer(parent, name, centre, radius, topY, cell, fn, maxParts)
	local g = Voxel.NewGrid(1)
	local n = math.ceil(radius / cell)
	for i = -n, n do
		for k = -n, n do
			local key = fn(i * cell, k * cell)
			if key then
				Voxel.Set(g, i, 0, k, key)
			end
		end
	end
	return VX.Build(g, {
		V = cell,
		Name = name,
		CF = CFrame.new(centre.X, topY - cell / 2, centre.Z),
		Collide = true,
		Shadow = false,
		Parent = parent,
		MaxParts = maxParts,
	})
end

-- A tiered voxel cloud body (tops at y = 0, V studs per voxel). spec:
--   Tiers = { { R = studs | SX =, SZ =, Round = studs, H = levels }, ... } from the top tier down
--   Puffs = { { x, y, z, rx, ry, rz } (studs, relative to the top centre) } soft bulges (shaded)
--   Rim = { same } puffs that rise above the walking surface; Carve = fn(x, y, z) -> remove voxel?
function VX.Cloud(spec)
	local V = spec.V or 3
	local g = Voxel.NewGrid(16)
	local y = 0
	for i, t in ipairs(spec.Tiers) do
		local key = t.Key or TIER_KEYS[math.min(i, #TIER_KEYS)]
		local h = t.H or 1
		if t.R then
			VX.Disc(g, 0, 0, t.R / V, y - h + 1, y, key)
		else
			VX.RoundRect(g, (t.X or 0) / V, (t.Z or 0) / V, t.SX / V, t.SZ / V, (t.Round or 6) / V, y - h + 1, y, key)
		end
		y = y - h
	end
	for _, p in ipairs(spec.Puffs or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Puff", KeepExisting = true })
	end
	for _, p in ipairs(spec.Rim or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Rim", KeepExisting = true })
	end
	if spec.Carve then
		local remove = {}
		for k in pairs(g.Cells) do
			local x, yy, z = Voxel.Unpack(k)
			if spec.Carve(x * V, yy * V, z * V) then
				remove[#remove + 1] = k
			end
		end
		for _, k in ipairs(remove) do
			g.Cells[k] = nil
			g.Count = g.Count - 1
		end
	end
	Voxel.Shade(g, { Only = { Puff = true, Rim = true }, Smooth = 2, Seed = spec.Seed or 1 })
	Voxel.Remap(g, {
		Puff = "Cloud",
		Puff_Light = "CloudLight",
		Puff_Dark = "Mist",
		Rim = "Cloud",
		Rim_Light = "CloudLight",
		Rim_Dark = "CloudShade",
	})
	return g
end

-- Builds a cloud spec at a CFrame whose position is the top centre of the cloud.
function VX.CloudModel(spec, cf, parent, name, collide)
	local V = spec.V or 3
	local g = VX.Cloud(spec)
	local model = VX.Build(g, {
		V = V,
		Name = name or "Cloud",
		CF = cf * CFrame.new(0, -V / 2, 0),
		Collide = collide,
		MaxParts = spec.MaxParts,
		Parent = parent,
	})
	if model then
		CollectionService:AddTag(model, EXEMPT_TAG) -- the voxel clouds keep their look on purpose (6.4 rule 9)
		local kit = LobbyBuilder._Kit
		if type(kit) == "table" and type(kit.Clouds) == "table" then -- Phase 6 kit hook (blender/kit/props/lobby_world.py)
			kit.Clouds[model] = { Spec = spec, CF = cf, Template = Mesh.Template, Name = name }
		end
	end
	return model
end

----------------------------------------------------------------------
-- Prop templates (sculpted once, cloned everywhere)
----------------------------------------------------------------------

local Props = {}

-- Detailed voxel trees (~18 studs, ~1.1-stud voxels). kind: "Round" (green, red fruit), "Blossom" (pink), "Pine".
-- Shapes are written in 1.4-stud units and scaled by S, so the voxels get finer without the tree changing size.
function Props.Tree(kind)
	return template("Tree" .. kind, function()
		local S = 1.3
		local function v(x, y, z)
			return { x * S, y * S, z * S }
		end
		local g = Voxel.NewGrid(16)
		local leaf = (kind == "Blossom") and "Blossom" or ((kind == "Pine") and "Pine" or "Leaf")
		-- trunk with a slight bend, flared roots and two branch stubs into the canopy
		Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 0, 0), v(0.3, 2.4, 0), v(-0.2, 4.6, 0.2), v(0, 6.4, 0) }, Radius = 1.05 * S, RadiusB = 0.6 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(1.5, 0, 0.5), Radius = 0.55 * S, RadiusB = 0.25 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(-1.1, 0, -1.1), Radius = 0.55 * S, RadiusB = 0.25 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(-0.4, 0, 1.4), Radius = 0.5 * S, RadiusB = 0.25 * S, Key = "Bark" })
		if kind == "Pine" then
			-- three stacked, shrinking cone tiers
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 3.2, 0), B = v(0, 8.6, 0), Radius = 4.6 * S, RadiusB = 1.2 * S, Key = leaf })
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 6.6, 0), B = v(0, 11.4, 0), Radius = 3.7 * S, RadiusB = 0.8 * S, Key = leaf })
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 9.6, 0), B = v(0, 14.2, 0), Radius = 2.6 * S, RadiusB = 0, Key = leaf })
		else
			Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 5.4, 0), v(1.8, 7, 0.6) }, Radius = 0.45 * S, Key = "Bark" })
			Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 5.8, 0), v(-1.6, 7.2, -0.8) }, Radius = 0.45 * S, Key = "Bark" })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(0, 8.3, 0), Radius = { 3.8 * S, 3.0 * S, 3.8 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(2.3, 7.1, 1.1), Radius = { 2.4 * S, 2.1 * S, 2.4 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(-2.1, 7.3, -1.4), Radius = { 2.5 * S, 2.1 * S, 2.5 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(-0.8, 7.0, 2.3), Radius = { 2.2 * S, 2.0 * S, 2.2 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(0.4, 10.6, -0.4), Radius = { 2.3 * S, 1.8 * S, 2.3 * S }, Key = leaf })
		end
		Voxel.Shade(g, { Smooth = 2, Noise = 0.05, Seed = 7 })
		local accent, onlyKey, chance = nil, nil, 0
		if kind == "Blossom" then
			accent, onlyKey, chance = "BlossomWhite", "Blossom_Light", 0.18 -- pale petals on the lit side
		elseif kind == "Round" then
			accent, onlyKey, chance = "Flower5", "Leaf", 0.05 -- small red fruit
		end
		if accent then
			Voxel.Shape(g, {
				Kind = "Ellipsoid",
				Center = v(0, 8.3, 0),
				Radius = { 5 * S, 4.5 * S, 5 * S },
				Op = "Paint",
				OnlyKeys = { [onlyKey] = true },
				Pattern = function(x, y, z)
					if hash3(x, y, z, 5) < chance then
						return accent
					end
					return false
				end,
			})
		end
		local V = 1.4 / S
		return VX.Build(g, { V = V, Name = kind .. "Tree", CF = CFrame.new(0, V / 2, 0), Collide = true, MaxParts = 54 })
	end)
end

-- Lamp post (~9 studs) with a warm neon lantern. Built from crafted blocks.
function Props.Lamp()
	return template("Lamp", function()
		local m = Instance.new("Model")
		m.Name = "Lamp"
		-- plinth + body + cap (6.4 rule 3): a Slate foot with a Marble band, an iron post, a glass lantern
		box(m, "LampBase", CFrame.new(0, 0.6, 0), Vector3.new(1.8, 1.2, 1.8), C.Slate, { Collide = true })
		box(m, "LampBand", CFrame.new(0, 1.3, 0), Vector3.new(2, 0.2, 2), C.MarbleShade)
		box(m, "LampPole", CFrame.new(0, 4.6, 0), Vector3.new(0.5, 6.6, 0.5), C.Iron, { Collide = true })
		box(m, "LampCollar", CFrame.new(0, 8, 0), Vector3.new(1.2, 0.3, 1.2), C.IronLight)
		box(m, "LampCage", CFrame.new(0, 8.85, 0), Vector3.new(1.3, 1.4, 1.3), C.Lamp, { Material = materialOf("Glass"), Transparency = 0.45 })
		box(m, "LampGlass", CFrame.new(0, 8.85, 0), Vector3.new(0.7, 1.0, 0.7), C.Lamp, { Material = MAT.Neon })
		box(m, "LampRoof", CFrame.new(0, 9.75, 0), Vector3.new(1.8, 0.4, 1.8), C.Iron)
		box(m, "LampTip", CFrame.new(0, 10.15, 0), Vector3.new(0.5, 0.4, 0.5), C.GoldDark)
		return m
	end)
end

-- bug batch 2 #7 (the player: "benches should be sittable, when a player sits on them the pets sit on the ground"):
-- every bench carries invisible Seats that stay Disabled (running past still never sits you down) with a "Sit" prompt
-- (E). The server checks the press (Benches.sit: alive, not in a battle / dungeon run / match, near, the seat free,
-- the player not seated already, a 0.5 s cooldown), enables that seat for the sit and seats the player; when the
-- occupant leaves (jump, death, leaving) the seat goes back to Disabled and its prompt shows again. While a seat is
-- taken a 4 Hz watchdog frees it if a teleport dragged it (or its occupant) away and puts it back home.
local Benches = {
	SEAT = "BenchSeat",
	PROMPT = "BenchSitPrompt",
	RANGE = 7, -- the prompt's MaxActivationDistance ...
	SLACK = 3, -- ... + this much on the server (lag)
	COOLDOWN = 0.5,
	DRIFT = 4, -- studs a taken seat or its occupant may stray from the seat's home before the watchdog frees it
	lastUse = {}, -- [Player] = os.clock() of the last accepted sit
	homes = {}, -- [Seat] = its CFrame as built
	watched = {}, -- [Seat] = true while its watchdog runs
	hooked = false,
}

-- one Seat (+ prompt) per 2.2 studs of bench (a seated player is ~2 studs wide): the bench seats two
function Benches.addSeats(m, length, seatY, seatZ)
	local n = math.max(1, math.floor(length / 2.2 + 1e-6))
	for i = 1, n do
		local seat = Instance.new("Seat")
		seat.Name = Benches.SEAT
		seat.Anchored = true
		seat.Size = Vector3.new(2, 0.4, 1.8)
		seat.CFrame = CFrame.new(-length / 2 + (i - 0.5) * length / n, seatY, seatZ) -- faces -Z like the bench
		seat.Transparency = 1
		seat.CanCollide = false
		seat.CanQuery = false
		seat.CastShadow = false
		seat.Disabled = true
		seat.Parent = m
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = Benches.PROMPT
		prompt.ActionText = "Sit"
		prompt.ObjectText = "Bench"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = 0
		prompt.MaxActivationDistance = Benches.RANGE
		prompt.RequiresLineOfSight = false
		prompt.Parent = seat
	end
end

-- Sit `player` on `seat` (the prompt's handler; tests call it). -> ok, reason
function Benches.sit(player, seat)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent == nil then
		return false, "junk"
	end
	if typeof(seat) ~= "Instance" or not seat:IsA("Seat") or seat.Name ~= Benches.SEAT or not seat:IsDescendantOf(Workspace) then
		return false, "junk"
	end
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return false, "dead"
	end
	-- InBattle is also set for a whole dungeon run (Config.Attr.InBattle)
	local attr = Config.Attr or {}
	local battle = player:GetAttribute(attr.InBattle or "InBattle")
	if (battle ~= nil and battle ~= false) or player:GetAttribute(attr.InMatch or "InMatch") == true then
		return false, "busy"
	end
	if (root.Position - seat.Position).Magnitude > Benches.RANGE + Benches.SLACK then
		return false, "far"
	end
	if seat.Occupant ~= nil then
		return false, "taken"
	end
	if humanoid.Sit or humanoid.SeatPart ~= nil then
		return false, "seated"
	end
	local now = os.clock()
	local last = Benches.lastUse[player]
	if last and now - last < Benches.COOLDOWN then
		return false, "cooldown"
	end
	Benches.lastUse[player] = now
	seat.Disabled = false -- for this sit only: Benches.refresh disables it again once the seat is free
	local ok = pcall(seat.Sit, seat, humanoid)
	if ok and seat.Occupant == humanoid then
		Benches.refresh(seat)
		return true
	end
	-- the weld may land a frame later: give it a moment, then the seat is Disabled again unless someone sits
	task.delay(0.5, function()
		Benches.refresh(seat)
	end)
	return ok, ok and "pending" or "failed"
end

-- Disabled + prompt shown while free; prompt hidden (and the watchdog running) while taken
function Benches.refresh(seat)
	if seat.Parent == nil then
		return
	end
	local taken = seat.Occupant ~= nil
	seat.Disabled = not taken
	local prompt = seat:FindFirstChild(Benches.PROMPT)
	if prompt then
		prompt.Enabled = not taken
	end
	if taken and not Benches.watched[seat] then
		Benches.watched[seat] = true
		task.spawn(Benches.watch, seat)
	end
end

-- while the seat is taken: a teleport that moved the welded occupant (and with it the seat) frees the seat at home
function Benches.watch(seat)
	while seat.Parent and seat.Occupant ~= nil do
		Benches.check(seat)
		task.wait(0.25)
	end
	Benches.watched[seat] = nil
	if seat.Parent then
		Benches.refresh(seat)
	end
end

function Benches.check(seat)
	local home = Benches.homes[seat]
	local occupant = seat.Occupant
	local root = occupant and occupant.Parent and occupant.Parent:FindFirstChild("HumanoidRootPart")
	if not home then
		return
	end
	local strayed = (seat.Position - home.Position).Magnitude > Benches.DRIFT
		or (root and (root.Position - home.Position).Magnitude > Benches.DRIFT + 3)
	if not strayed then
		return
	end
	for _, d in ipairs(seat:GetChildren()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy() -- the SeatWeld: the occupant stays where the teleport put them
		end
	end
	if occupant and occupant.Parent then
		pcall(function()
			occupant.Sit = false
		end)
	end
	seat.CFrame = home
	Benches.refresh(seat)
end

-- after the build: every bench seat gets its prompt handler, its Occupant watcher and its home CFrame
function Benches.wire(root)
	for _, seat in ipairs(root:GetDescendants()) do
		if seat:IsA("Seat") and seat.Name == Benches.SEAT then
			Benches.homes[seat] = seat.CFrame
			local prompt = seat:FindFirstChild(Benches.PROMPT)
			if prompt then
				prompt.Triggered:Connect(function(player)
					local ok, err = pcall(Benches.sit, player, seat)
					if not ok then
						warn("[LobbyBuilder] bench sit: " .. tostring(err))
					end
				end)
			end
			seat:GetPropertyChangedSignal("Occupant"):Connect(function()
				Benches.refresh(seat)
			end)
			seat.AncestryChanged:Connect(function()
				if not seat:IsDescendantOf(game) then
					Benches.homes[seat] = nil
				end
			end)
		end
	end
	if not Benches.hooked then
		Benches.hooked = true
		game:GetService("Players").PlayerRemoving:Connect(function(player)
			Benches.lastUse[player] = nil
		end)
	end
end

-- Wooden bench (plain parts) with two Disabled Seats + "Sit" prompts (bug batch 2 #7, Benches). Faces -Z.
function Props.Bench()
	return template("Bench", function()
		local m = Instance.new("Model")
		m.Name = "Bench"
		box(m, "Seat", CFrame.new(0, 1.55, -0.45), Vector3.new(5.6, 0.4, 1), C.PlankLight, { Collide = true })
		box(m, "Seat", CFrame.new(0, 1.55, 0.55), Vector3.new(5.6, 0.4, 1), C.Plank, { Collide = true })
		box(m, "Back", CFrame.new(0, 2.55, 1.05), Vector3.new(5.6, 0.7, 0.3), C.PlankLight)
		box(m, "Back", CFrame.new(0, 3.35, 1.05), Vector3.new(5.6, 0.7, 0.3), C.Plank)
		box(m, "Frame", CFrame.new(-2.4, 1.6, 0.25), Vector3.new(0.4, 3.2, 2.2), C.Iron, { Collide = true })
		box(m, "Frame", CFrame.new(2.4, 1.6, 0.25), Vector3.new(0.4, 3.2, 2.2), C.Iron, { Collide = true })
		-- the seats' tops sit on the planks' top (1.75); between the frames (inner width 4.4 -> 2 x 2.2)
		Benches.addSeats(m, 4.4, 1.55, 0.05)
		return m
	end)
end

-- Raised wooden flower bed (6 x 3) with leaves and flower pixels. variant picks the flower colours.
function Props.FlowerBed(variant)
	return template("FlowerBed" .. variant, function()
		local g = Voxel.NewGrid(4)
		for x = -3, 2 do
			for z = -2, 1 do
				local edge = x == -3 or x == 2 or z == -2 or z == 1
				Voxel.Set(g, x, 0, z, edge and "PlankDark" or "Soil")
				if not edge then
					local h = hash3(x, variant, z, 3)
					if h < 0.45 then
						Voxel.Set(g, x, 1, z, "Flower" .. (((variant + x + z) % 3 == 0) and variant or (variant % #FLOWERS + 1)))
					else
						Voxel.Set(g, x, 1, z, "Leaf")
					end
				end
			end
		end
		return VX.Build(g, { V = 1, Name = "FlowerBed", CF = CFrame.new(0.5, 0.5, 0.5), Collide = true, MaxParts = 16 })
	end)
end

-- A small voxel cloud puff (supports under bridges). size: "S" | "M".
function Props.Puff(size)
	return template("Puff" .. size, function()
		local s = (size == "M") and 1.35 or 1
		local spec = {
			V = 3,
			Tiers = { { R = 6 * s, H = 1 }, { R = 4.5 * s, H = 1 } },
			Puffs = {
				{ 5 * s, -1, 2 * s, 5 * s, 4 * s, 5 * s },
				{ -5 * s, -2, -1 * s, 5.5 * s, 4.5 * s, 5 * s },
				{ 0, -4, 0, 6 * s, 5 * s, 6 * s },
			},
			MaxParts = 12,
			Seed = 3,
		}
		return VX.CloudModel(spec, CFrame.new(), nil, "CloudPuff", false)
	end)
end

-- Bunting: a sagging rope with stepped voxel pennants in the given colours between two points.
local function bunting(parent, a, b, colors, sag)
	local m = newModel(parent, "Bunting")
	local span = b - a
	local len = span.Magnitude
	if len < 2 then
		return m
	end
	sag = sag or math.min(2, len * 0.06)
	local dir = span.Unit
	local count = math.max(2, math.floor(len / 4))
	local pieces = 3
	local knots = {}
	for i = 0, pieces do
		local t = i / pieces
		knots[i] = a + span * t - Vector3.new(0, sag * 4 * t * (1 - t), 0)
	end
	for i = 1, pieces do
		local p, prev = knots[i], knots[i - 1]
		local mid = (p + prev) * 0.5
		box(m, "Rope", CFrame.lookAt(mid, p), Vector3.new(0.18, 0.18, (p - prev).Magnitude + 0.1), C.PlankDark, { Shadow = false })
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(1, 0, 0)
	end
	for i = 1, count do
		-- on the straight rope piece (not the parabola through its knots), so every pennant hangs from it
		local t = (i - 0.5) / count
		local k = math.min(pieces - 1, math.floor(t * pieces))
		local p = knots[k]:Lerp(knots[k + 1], t * pieces - k)
		local color = colors[(i - 1) % #colors + 1]
		local cf = CFrame.lookAt(p, p + flat) * CFrame.Angles(0, math.rad(90), 0)
		box(m, "Pennant", cf * CFrame.new(0, -0.4, 0), Vector3.new(0.12, 0.8, 1.3), color, { Shadow = false })
		box(m, "Pennant", cf * CFrame.new(0, -1.05, 0), Vector3.new(0.12, 0.6, 0.6), color, { Shadow = false })
	end
	return m
end

-- Tall banner pole with a hanging cloth in `color` (and a gold finial). cf at ground level.
local function bannerPole(parent, cf, color)
	local m = newModel(parent, "Banner")
	box(m, "Pole", cf * CFrame.new(0, 5.5, 0), Vector3.new(0.5, 11, 0.5), C.Iron, { Collide = true })
	box(m, "Finial", cf * CFrame.new(0, 11.3, 0), Vector3.new(0.9, 0.7, 0.9), C.Gold)
	box(m, "Bar", cf * CFrame.new(0.9, 10.5, 0), Vector3.new(2.4, 0.3, 0.3), C.Iron)
	box(m, "Cloth", cf * CFrame.new(1.2, 8.2, 0), Vector3.new(2, 4.2, 0.15), color, { Shadow = false })
	box(m, "ClothTip", cf * CFrame.new(1.2, 5.75, 0), Vector3.new(1, 0.7, 0.15), color, { Shadow = false })
	Mesh.tag(m, "prop_banner", cf, { Primary = color }) -- Phase 6: the cloth takes `color`
	return m
end

-- A wooden notice board with a small roof; returns the face part for the SurfaceGui. cf: ground, faces -Z.
local function noticeBoard(parent, cf, width, height, name)
	local m = newModel(parent, name or "NoticeBoard")
	local postH = height + 3.4
	for _, s in ipairs({ -1, 1 }) do
		box(m, "Post", cf * CFrame.new(s * (width / 2 + 0.5), postH / 2, 0), Vector3.new(1, postH, 1), C.PlankDark, { Collide = true })
		box(m, "PostFoot", cf * CFrame.new(s * (width / 2 + 0.5), 0.4, 0), Vector3.new(1.6, 0.8, 1.6), C.StoneDark, { Collide = true })
	end
	box(m, "Frame", cf * CFrame.new(0, 2.4 + height / 2, 0.15), Vector3.new(width + 0.6, height + 0.6, 0.6), C.Plank, { Collide = true })
	local face = box(m, "Face", cf * CFrame.new(0, 2.4 + height / 2, -0.2), Vector3.new(width, height, 0.2), KIT.Sign.Stone) -- (kit B) under a stone panel
	box(m, "Roof", cf * CFrame.new(0, postH + 0.25, 0), Vector3.new(width + 3, 0.5, 2.4), C.PlankDark)
	box(m, "RoofTop", cf * CFrame.new(0, postH + 0.75, 0), Vector3.new(width + 1.6, 0.5, 1.4), C.Rose)
	-- Phase 6: prop_board_s (11 x 8) / prop_board_l (14 x 9); the Face keeps its SurfaceGui and stays visible
	local boardKey = (width == 11 and height == 8) and "prop_board_s" or ((width == 14 and height == 9) and "prop_board_l" or nil)
	if boardKey then
		Mesh.tag(m, boardKey, cf, nil, { "Face" })
	end
	return face, m
end

----------------------------------------------------------------------
-- Layout (derived once from Config.Lobby / Config.Difficulties)
----------------------------------------------------------------------

local function computeLayout()
	local L = {}

	-- Phase 5 Gate Court (6.1): the gates left -> right on the arc r G.GateR around G.GateFacing (the spawn looks this
	-- way); Phase 6: the court keeps its six-slot width ((G.CourtSlots - 1) * G.GateStep) and the five gates spread
	-- evenly over it (the end gates stand on the old end slots, Ring in the middle); the sector reaches 5.75 degrees
	-- past the end gates.
	L.MidAngle = G.GateFacing
	L.GateAngles = {}
	L.GateOrder = {}
	local nGates = #GATE_SPECS
	local span = (G.CourtSlots - 1) * G.GateStep
	local step = nGates > 1 and span / (nGates - 1) or 0
	for i, spec in ipairs(GATE_SPECS) do
		local a = G.GateFacing + (i - (nGates + 1) / 2) * step
		L.GateAngles[spec.Id] = a
		L.GateOrder[i] = spec.Id
	end
	L.CourtFrom = G.GateFacing - span / 2 - 5.75
	L.CourtTo = G.GateFacing + span / 2 + 5.75

	-- Shop island.
	local off = LOBBY.ShopOffset or Vector3.new(0, 0, -150)
	L.ShopCenter = Vector3.new(OX + off.X, TOP, OZ + off.Z)
	L.ShopDist = math.max(1, math.sqrt(off.X * off.X + off.Z * off.Z))
	L.ShopAngle = math.deg(atan2(off.Z, off.X)) % 360
	L.ShopR = clamp(L.ShopDist - PLAZA_R - 4, 18, 34)
	L.FountainX = math.cos(math.rad(L.ShopAngle)) * G.FountainD
	L.FountainZ = math.sin(math.rad(L.ShopAngle)) * G.FountainD

	-- Home plots sit between the junctions of the ring street; spokes join every other junction (never through the
	-- Gate Court, whose terrace fills the plaza edge behind the gates, and never right beside the shop neck).
	L.PlotAngles = {}
	for i = 1, SPOT_COUNT do
		L.PlotAngles[i] = (i - 1) * G.Step + G.HalfStep
	end
	L.Junctions = {}
	L.SpokeAngles = {}
	for j = 0, SPOT_COUNT - 1 do
		local a = j * G.Step
		local info = { Angle = a, Index = j }
		L.Junctions[#L.Junctions + 1] = info
		if j % 2 == 1 and angleDiff(a, L.ShopAngle) > 14 and not angleIn(a, L.CourtFrom - 8, L.CourtTo + 8) then
			info.Spoke = true
			L.SpokeAngles[#L.SpokeAngles + 1] = a
		end
	end

	-- Gardens (and the reserved Storm Altar site) hang off even junctions inside the ring.
	local function pickEven(target)
		local best, bestD = nil, 1e9
		for _, info in ipairs(L.Junctions) do
			local d = angleDiff(info.Angle, target)
			if not info.Spoke and not info.Garden and not info.Altar and d < bestD and angleDiff(info.Angle, L.ShopAngle) > 30 then
				best, bestD = info, d
			end
		end
		return best
	end
	L.Gardens = {}
	local specs = {
		{ Target = L.MidAngle - 45, Name = "Blossom Garden", Kind = "Blossom" },
		{ Target = L.MidAngle + 45, Name = "Lily Pond", Kind = "Pond" },
	}
	for _, spec in ipairs(specs) do
		local j = pickEven(spec.Target)
		if j then
			j.Garden = true
			L.Gardens[#L.Gardens + 1] = { Angle = j.Angle, Name = spec.Name, Kind = spec.Kind }
		end
	end
	local altar = pickEven(L.ShopAngle + 45)
	if altar then
		altar.Altar = true
		L.AltarAngle = altar.Angle
	end

	-- Phase 3 / 5: the Battle Arena island floats beyond the homes; its bridge continues the spoke junction nearest
	-- 135 degrees straight through the street (the junction's outer rail opens for it). Portal_Arena in the Gate Court
	-- is the other way in (ArenaBuilder).
	local arenaTarget = L.CourtTo + 3
	local arenaJ, arenaD = nil, 1e9
	for _, info in ipairs(L.Junctions) do
		if info.Spoke and not info.Garden and not info.Altar and angleDiff(info.Angle, L.ShopAngle) > 30
			and (not L.AltarAngle or angleDiff(info.Angle, L.AltarAngle) > 30) then
			local d = angleDiff(info.Angle, arenaTarget)
			if d < arenaD then
				arenaJ, arenaD = info, d
			end
		end
	end
	if arenaJ then
		arenaJ.Arena = true
		L.ArenaAngle = arenaJ.Angle
	end

	-- Exits through the plaza's soft cloud rim: spokes and the shop boardwalk.
	L.RimGaps = {}
	for _, a in ipairs(L.SpokeAngles) do
		L.RimGaps[#L.RimGaps + 1] = a
	end
	L.RimGaps[#L.RimGaps + 1] = L.ShopAngle

	-- Plaza path segments (plaza-local studs): { ax, az, dx, dz, len, half, kind }.
	local segs = {}
	local function segAB(ax, az, bx, bz, half, kind)
		local dx, dz = bx - ax, bz - az
		local len = math.max(0.01, math.sqrt(dx * dx + dz * dz))
		segs[#segs + 1] = { ax = ax, az = az, dx = dx / len, dz = dz / len, len = len, half = half, kind = kind }
	end
	local function seg(angle, r0, r1, half, kind)
		local d = dirOf(angle)
		segAB(d.X * r0, d.Z * r0, d.X * r1, d.Z * r1, half, kind)
	end
	-- the grand avenue (spawn court -> Gate Court), the shop boardwalk, the east / west walks to the circle walk
	seg(L.MidAngle, G.CourtR - 1, G.CourtIn + 1, G.AvenueHalf, "Stone")
	seg(L.ShopAngle, G.CourtR - 1, PLAZA_R + 1, G.BoardHalf, "Plank")
	L.CrossAngles = { (L.MidAngle + 90) % 360, (L.MidAngle - 90) % 360 }
	for _, a in ipairs(L.CrossAngles) do
		seg(a, G.CourtR - 1, G.RingRoadR, G.PathHalf, "Stone")
	end
	-- every spoke leaves the circle walk
	for _, a in ipairs(L.SpokeAngles) do
		seg(a, G.RingRoadR - 2, PLAZA_R + 1, G.StubHalf, "Stone")
	end
	L.PlazaSegs = segs
	return L
end

----------------------------------------------------------------------
-- Plaza: ground (layered voxel tiles), cloud body, decor
----------------------------------------------------------------------

local BORDER_KEY = { Stone = "StoneEdge", Sand = "SandDark", Plank = "PlankDark" }

local function segDist(px, pz, s)
	local rx, rz = px - s.ax, pz - s.az
	local t = rx * s.dx + rz * s.dz
	if t < 0 or t > s.len then
		return math.huge, t
	end
	return math.abs(-rx * s.dz + rz * s.dx), t
end

-- Signed lateral distance (studs) of a plaza-local point inside the Gate Court sector: > 0 inside, the distance to
-- the nearer side edge (the rays at L.CourtFrom / L.CourtTo).
local function courtSide(x, z, L)
	local a0, a1 = math.rad(L.CourtFrom), math.rad(L.CourtTo)
	-- the left edge ray at a0: inside is counter-clockwise of it; the right edge ray at a1: inside is clockwise
	local d0 = math.cos(a0) * z - math.sin(a0) * x
	local d1 = math.sin(a1) * x - math.cos(a1) * z
	return math.min(d0, d1)
end

-- Keys of the plaza ground layers at a cell centre (plaza-local studs):
-- l1 lawn patches / flowers, l2 borders and the grout under the tiled courts (just below the surface), l3 surfaces
-- (cobbles, planks); the spawn court and the Gate Court get their Slate tiles from Court.Tiles on top of the grout.
local function plazaCell(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r > PLAZA_R - 0.5 then
		return nil
	end
	local l1, l2, l3
	local n = vnoise(x + 400, z + 400, 46, 11)
	if r > PLAZA_R - 3.5 then
		n = 0.5 -- lawn only at the very edge (no patch faces flush with the lawn's edge)
	end
	if n < 0.17 then
		l1 = "GrassDark"
	elseif n > 0.83 then
		l1 = "GrassLight"
	end
	-- spawn court (tiles on top) and the Gate Court sector (tiles, terrace)
	if r <= G.CourtR + 1 then
		l2 = "SlateDark"
	end
	local side = courtSide(x, z, L)
	if r >= G.CourtIn - 2 and r <= G.CourtOut + 1 and side >= -1.5 then
		l2 = "SlateDark"
	end
	-- (the cobbled circle walk is built from arc segments by Court.RingRoad; keep its band free of lawn patches)
	if math.abs(r - G.RingRoadR) <= G.PathHalf + 0.5 then
		l1 = nil
	end
	-- fountain roundabout
	local fx, fz = x - L.FountainX, z - L.FountainZ
	local fr = math.sqrt(fx * fx + fz * fz)
	if fr <= 16 then
		l2 = l2 or "StoneEdge"
		if fr <= 14 then
			l3 = l3 or "Stone"
		end
	end
	-- paths
	for _, s in ipairs(L.PlazaSegs) do
		local d, t = segDist(x, z, s)
		if d <= s.half then
			l2 = l2 or BORDER_KEY[s.kind]
			-- (the surface stops one cell before the island's edge, its border runs on: no two layers end flush)
			if d <= s.half - 2 and not l3 and l2 ~= "SlateDark" and r <= PLAZA_R - 2.5 then
				if s.kind == "Plank" then
					l3 = (math.floor(t / 4) % 2 == 0) and "Plank" or "PlankLight"
				else
					-- cobbles in two shades by large soft patches (+-6 RGB, rule 2)
					l3 = (vnoise(x + 1300, z + 1300, 9, 3) > 0.5) and "Stone" or "StoneLight"
				end
			end
		end
	end
	-- (bug #12: no flat "Flower" lawn pixels any more: the grass and wildflowers are 3D clumps the clients grow from
	-- the Meadow scatter, built after every prop has its place: see Meadow below.) The unmown outer lawns get a
	-- slightly deeper floor in soft drifts, so the gaps between the tufts read as meadow, not mown lawn.
	if not l1 and not l2 and not l3 and r > G.RingRoadR + G.PathHalf + 1.5 and r < PLAZA_R - 3.5
		and vnoise(x - 700, z + 300, 34, 29) > 0.28 then
		l1 = "GrassWild"
	end
	return l1, l2, l3
end

-- The spawn medallion (1-stud inlay cells, thinned to 0.3-stud inlays when built): a Metal sun, a Marble ring and six
-- Neon arrows in the gate colours, each pointing at its gate.
local function courtInlay(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r <= 3.6 then
		return "Gold"
	elseif r <= 4.8 then
		return "GoldDark"
	elseif r >= 15.4 and r <= 16.9 then
		return "Marble"
	end
	for i, id in ipairs(L.GateOrder) do
		local pa = L.GateAngles[id]
		local dx, dz = math.cos(math.rad(pa)), math.sin(math.rad(pa))
		local t = x * dx + z * dz
		local d = math.abs(-x * dz + z * dx)
		if t >= 18 and t <= 23 and d <= (23.4 - t) * 0.4 then
			return "Gate" .. i
		end
	end
	-- short sun rays
	if r >= 5.6 and r <= 7.6 then
		local a = (math.deg(atan2(z, x)) - L.MidAngle) % 45
		if a < 7 or a > 38 then
			return "GoldDark"
		end
	end
	return nil
end

local function plazaKind(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r > PLAZA_R - 6 then
		return "edge"
	end
	local _, l2, l3 = plazaCell(x, z, L)
	if l2 or l3 then
		return "path"
	end
	return "lawn"
end

-- Is a circle (plaza-local) free lawn, away from paths, the rim and other decor?
local function plazaFree(x, z, radius, L)
	for _, o in ipairs({ { 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 }, { 0.7, 0.7 }, { -0.7, 0.7 }, { 0.7, -0.7 }, { -0.7, -0.7 } }) do
		if plazaKind(x + o[1] * radius, z + o[2] * radius, L) ~= "lawn" then
			return false
		end
	end
	for _, rsv in ipairs(reserved) do
		local dx, dz = x - rsv[1], z - rsv[2]
		local need = radius + rsv[3]
		if dx * dx + dz * dz < need * need then
			return false
		end
	end
	return true
end

local function reserve(x, z, radius)
	reserved[#reserved + 1] = { x, z, radius }
end

-- Places a prop on the plaza lawn when the spot is free; returns the world ground position or nil.
local function plazaSpot(angle, radius, clearance, L, force)
	local d = dirOf(angle)
	local x, z = d.X * radius, d.Z * radius
	if not force and not plazaFree(x, z, clearance, L) then
		warn(string.format("[LobbyBuilder] plaza decor skipped at %.0f deg r=%.0f (not free)", angle, radius))
		return nil
	end
	reserve(x, z, clearance)
	return Vector3.new(OX + x, TOP, OZ + z), x, z
end

local function buildPlazaGround(f, L)
	local cell = 2
	local n = math.ceil(PLAZA_R / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	local r2 = (PLAZA_R - 0.5) * (PLAZA_R - 0.5)
	for i = -n, n do
		for k = -n, n do
			local x, z = i * cell, k * cell
			if x * x + z * z <= r2 then
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local l1, l2, l3 = plazaCell(x, z, L)
				if l1 then
					Voxel.Set(grids[2], i, 0, k, l1)
				end
				if l2 then
					Voxel.Set(grids[3], i, 0, k, l2)
				end
				if l3 then
					Voxel.Set(grids[4], i, 0, k, l3)
				end
			end
		end
	end
	-- the medallion uses finer 1-stud cells
	local inlay = grids[5]
	local ci = math.ceil(G.CourtR)
	for i = -ci, ci do
		for k = -ci, ci do
			local key = courtInlay(i, k, L)
			if key then
				Voxel.Set(inlay, i, 0, k, key)
			end
		end
	end
	-- top surfaces: lawn -0.4, patches -0.3, borders -0.1, paths 0, inlays +0.1 (walkable steps, no z-fight;
	-- bridge decks that dock into the ground sit at -0.2)
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	local names = { "Lawn", "LawnPatches", "PathBorders", "Paths", "Inlays" }
	for li = 1, 5 do
		local cellSize = (li == 5) and 1 or cell
		local model = VX.Build(grids[li], {
			V = cellSize,
			Name = names[li],
			CF = CFrame.new(OX, TOP + tops[li] - cellSize / 2, OZ),
			Collide = li ~= 5,
			Shadow = false,
			Parent = f,
		})
		if li == 5 and model then
			-- the medallion: 0.3-stud inlays (rule 2: saturated colours only as thin inlays) on top of the court tiles
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") then
					local topY = p.Position.Y + p.Size.Y / 2
					p.Size = Vector3.new(p.Size.X, 0.3, p.Size.Z)
					p.CFrame = CFrame.new(p.Position.X, topY - 0.15, p.Position.Z)
					p.CanCollide = false
					p.CanQuery = false
				end
			end
		end
		if model then -- Phase 6: floor_plaza_<layer> (baked from this very build: LayoutSig)
			Mesh.tag(model, "floor_plaza_" .. string.lower(names[li]), CFrame.new(OX, TOP, OZ))
		end
	end
end

-- The plaza's cloud body: tiered, with lumpy side puffs and a soft rim of clouds around the lawn.
local function buildPlazaBody(f, L)
	local rng = Util.NewRng(SEED + 2)
	local R = PLAZA_R
	local puffs = {}
	for i = 1, 6 do
		local a = (i - 1) / 6 * math.pi * 2 + rng:Float(-0.2, 0.2)
		local tier = rng:Int(1, 2)
		local tr = ({ R - 8, R - 30 })[tier]
		local ty = ({ -7, -14 })[tier]
		local s = rng:Float(12, 17)
		puffs[#puffs + 1] = { math.cos(a) * tr, ty, math.sin(a) * tr, s, s * 0.7, s }
	end
	for i = 1, 3 do
		local a = rng:Float(0, math.pi * 2)
		local d = rng:Float(10, 40)
		puffs[#puffs + 1] = { math.cos(a) * d, -26, math.sin(a) * d, rng:Float(16, 24), rng:Float(8, 11), rng:Float(16, 24) }
	end
	-- the exits through the rim: unit direction + half width kept clear (path + border + a little air)
	local exits = {}
	for _, a in ipairs(L.RimGaps) do
		local d = dirOf(a)
		local half = ((angleDiff(a, L.ShopAngle) < 1) and G.BoardHalf or G.StubHalf) + 2.5
		exits[#exits + 1] = { d.X, d.Z, half }
	end
	-- rim puffs: one right beside every exit, the arcs between exits filled evenly (<= ~30 degrees apart)
	local rim = {}
	local gaps = {}
	for _, a in ipairs(L.RimGaps) do
		gaps[#gaps + 1] = a % 360
	end
	table.sort(gaps)
	local function addRim(adeg)
		local a = math.rad(adeg)
		local rr = R + rng:Float(-1, 1.5)
		local s = rng:Float(8.5, 11)
		rim[#rim + 1] = { math.cos(a) * rr, rng:Float(-1, 1.5), math.sin(a) * rr, s, s * 0.62, s }
	end
	if #gaps == 0 then
		gaps[1] = 0
	end
	for i, g0 in ipairs(gaps) do
		local g1 = gaps[i % #gaps + 1]
		local span = (g1 - g0) % 360
		if span == 0 then
			span = 360
		end
		local from, to = g0 + 9, g0 + span - 9
		if to > from then
			local n = math.max(1, math.ceil((to - from) / 30))
			for k = 0, n do
				addRim(from + (to - from) * k / n)
			end
		end
	end
	local spec = {
		V = 3,
		Tiers = {
			{ R = R + 3, H = 1 },
			{ R = R - 6, H = 2 },
			{ R = R - 28, H = 2 },
			{ R = R - 62, H = 3 },
		},
		Puffs = puffs,
		Rim = rim,
		-- keep the walking area clear: nothing of the body may rise above the lawn inside the rim, nor over an
		-- exit (the spoke bridges and the shop neck dock there)
		Carve = function(x, y, z)
			if y <= 0 then
				return false
			end
			if (x * x + z * z) < (R - 6) * (R - 6) then
				return true
			end
			for _, ex in ipairs(exits) do
				local along = x * ex[1] + z * ex[2]
				if along > R - 24 and math.abs(-x * ex[2] + z * ex[1]) < ex[3] then
					return true
				end
			end
			return false
		end,
		Seed = 4,
		MaxParts = 360,
	}
	-- top of tier 1 sits 1.2 under the lawn surface; rim puffs rise up to ~5 studs above the lawn
	local body = VX.CloudModel(spec, CFrame.new(OX, TOP - 1.2, OZ), f, "PlazaCloud", true)
	if body then
		Mesh.tag(body, "cloud_plaza", CFrame.new(OX, TOP - 1.2, OZ))
	end
end

-- Fountain on the roundabout (bug #13, the player's pick on the pitch board: option C "Sky-Oasis Steps"). Three chunks
-- of a broken sky-island stand in a mossy rock pool: the low one came down in the water, the settlers propped the
-- other two on drum-stone pillars. A spring on the top island feeds a small fall onto the middle island, its stream
-- runs to the big fall into the pool, and a seep on the low island gives a small west fall. Players climb it: stepping
-- stones, a ladder (low -> middle) and a knotted rope (middle -> top) up to Nimbus's twig nest.
--   Meshes (blender/kit/props/lobby_oasis.py, catalog lobby.json): prop_oasis_pool / _islands / _water dress the Part
--   build below (the colliders and the fallback until the keys are uploaded), prop_oasis_boat rides the paper boat's
--   root part (ML_Weld; client FountainFx bobs it). The falls are Beams (TextureSpeed: they move with no script), the
--   splashes / ripples / mist ParticleEmitters with Roblox's own soft textures (no glitter: the old spray was the
--   sparkle star and started inside the statue). The two climbs are invisible TrussParts with plank landings on top.
-- OASIS mirrors the kit's LAYOUT (studs, fountain frame: origin = the ground under the pool centre, -Z = the front,
-- toward the plaza centre). Change both together; tools/smoke_bug13_fountain.lua checks them against the manifests.
local OASIS = {
	PoolIn = 8.6, -- the rim wall's inner radius (the water reaches it)
	RimR = 9.55, -- the boulders' centre line
	Water = 1.25, -- the water surface
	Islands = { -- centre (x, z), grass top, radii (x, z), underside depth below the soil band
		{ C = { -3.8, -0.6 }, Top = 4.0, R = { 3.4, 3.2 }, Depth = 2.6 },
		{ C = { 3.0, -1.0 }, Top = 7.5, R = { 3.4, 3.3 }, Depth = 2.6 },
		{ C = { -0.6, 4.0 }, Top = 10.5, R = { 4.3, 3.4 }, Depth = 3.0 },
	},
	Stones = { { -2.3, -7.0, 2.0, 1.05 }, { -3.6, -5.3, 3.0, 0.95 } }, -- x, z, top, radius
	-- the climbs: truss centre (x, z), bottom / top, the face the player climbs (local), the plank landing's extent
	Ladder = { C = { -1.4, -0.85 }, Y0 = 3.55, Y1 = 7.55, Deck = { -2.45, -0.25 } },
	Rope = { C = { 2.3, 0.5 }, Y0 = 6.6, Y1 = 10.6, Deck = { -0.55, 1.55 } },
	Nest = { C = { -0.9, 4.7 }, R = 2.35, Floor = 10.5 },
	StatueScale = 2.1, -- Nimbus nests in it (2.6 swallowed the top island; Gemini and Claude agreed on 2.1)
	Tree = { -6.0, -1.7 },
	Lantern = { 5.4, 0.6 },
	Spring = { 2.0, 5.6 },
	Streams = {
		{ { 2.0, 4.8 }, { 2.7, 3.4 }, { 3.15, 2.35 } }, -- island 3: the spring -> its right rim
		{ { 3.75, 1.75 }, { 3.85, -0.8 }, { 3.6, -4.2 } }, -- island 2: under the small fall -> its front rim
		{ { -5.0, 1.0 }, { -5.9, 1.1 }, { -6.75, 1.05 } }, -- island 1: the seep -> its west rim
	},
	-- the falls: lip (x, y, z), outward direction (x, z), landing height, sheet width; Big = the one into the pool
	Falls = {
		{ Lip = { 3.25, 10.25, 2.25 }, Dir = { 0.81, -0.59 }, Land = 7.5, Width = 1.0 },
		{ Lip = { 3.6, 7.25, -4.35 }, Dir = { 0.12, -0.99 }, Land = 1.25, Width = 1.9, Big = true },
		{ Lip = { -6.85, 3.85, 1.05 }, Dir = { -0.95, 0.31 }, Land = 1.25, Width = 1.0 },
	},
	Sign = { Pos = { -6.45, -9.2 }, Face = { -0.57, -0.82 } },
	Boat = { 0.7, -6.3 },
}

-- the fountain's sprites are FxSprites roles (kit B X1: the game's own sheets): Droplet for drops and bubbles, Puff for
-- foam and mist, Ring for the ripples; the falls' streak Beams scroll the Flow strip, their core wears the Sheet strip
local Oasis = {} -- the fountain helpers (one main-chunk local: LobbyBuilder is near the 200-locals limit)
-- Fall direction. The Beam reference: a positive TextureSpeed scrolls the texture from Attachment0 toward Attachment1,
-- a negative one from Attachment1 toward Attachment0. Each fall's Attachment0 is its impact and Attachment1 its lip, so
-- Flow = -1 runs the streaks downhill, lip -> impact. (Studio check #1 after upload: if they ever climb, the engine
-- disagrees with its docs: flip this to 1.)
Oasis.Flow = -1

Oasis.Drop = ColorSequence.new(rgb(236, 248, 255), rgb(160, 214, 250))
Oasis.Foam = ColorSequence.new(rgb(250, 253, 255), rgb(214, 236, 252))

-- fountain-local stud point -> world
function Oasis.at(origin, x, y, z)
	return (origin * CFrame.new(x, y, z)).Position
end

-- An emitter with the water look: the droplet sheet by default (props.Sprite: another role), never the sparkle star.
function Oasis.emitter(parent, props)
	local e = emitter(parent, {
		Sprite = props and props.Sprite or "Droplet",
		Color = Oasis.Drop,
		LightEmission = 0.35,
		LightInfluence = 0.4,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(0, 0),
	})
	for k, v in pairs(props or {}) do
		if k ~= "Sprite" then
			e[k] = v
		end
	end
	return e
end

-- Voxel helpers for the Part build in fountain-local studs. Grid "fine" = 0.5-stud voxels whose rows span
-- [j * 0.5, j * 0.5 + 0.5] above the ground (built at origin * (0, 0.25, 0)); grid "rock" = 1-stud voxels spanning
-- [j, j + 1] (built at origin * (0, 0.5, 0)). So island tops (4.0 / 7.5 / 10.5) and stone tops land exactly.
function Oasis.fill(g, x0, x1, z0, z1, y0, y1, key, inside)
	for i = math.floor(x0 * 2), math.ceil(x1 * 2) do
		for k = math.floor(z0 * 2), math.ceil(z1 * 2) do
			local x, z = i * 0.5, k * 0.5
			local lo, hi = inside(x, z)
			if lo then
				for j = math.max(math.ceil(lo * 2 - 0.5), math.floor(y0 * 2)), math.min(math.floor(hi * 2 - 0.5), math.ceil(y1 * 2)) do
					Voxel.Set(g, i, j, k, key)
				end
			end
		end
	end
end

function Oasis.island(g, I, isLow)
	local cx, cz, rx, rz = I.C[1], I.C[2], I.R[1], I.R[2]
	local top = I.Top
	Oasis.fill(g, cx - rx - 0.5, cx + rx + 0.5, cz - rz - 0.5, cz + rz + 0.5, 0, top, "Dirt", function(x, z)
		local q = math.sqrt(((x - cx) / rx) ^ 2 + ((z - cz) / rz) ^ 2)
		if q > 1 then
			return nil
		end
		-- the soil band (1 stud) then the craggy cone: deeper toward the middle; the low island reaches the pool floor
		local depth = 1.0 + (I.Depth + 0.2) * (1 - q ^ 1.6)
		local bottom = isLow and math.max(0, top - depth - 1.5) or (top - depth)
		return bottom, top
	end)
	-- grass on top (a slight lip past the soil), a stony core toward the tip
	Oasis.fill(g, cx - rx - 0.6, cx + rx + 0.6, cz - rz - 0.6, cz + rz + 0.6, top - 0.5, top, "Grass", function(x, z)
		local q = math.sqrt(((x - cx) / (rx + 0.2)) ^ 2 + ((z - cz) / (rz + 0.2)) ^ 2)
		if q > 1 then
			return nil
		end
		return top - 0.5, top
	end)
	-- the stony tip: the lowest part of the cone turns to rock
	local tipY = top - 1.0 - (I.Depth + 0.2) * 0.7
	for i = math.floor((cx - rx) * 2), math.ceil((cx + rx) * 2) do
		for k = math.floor((cz - rz) * 2), math.ceil((cz + rz) * 2) do
			for j = 0, math.floor(tipY * 2) do
				if Voxel.Get(g, i, j, k) == "Dirt" then
					Voxel.Set(g, i, j, k, "Rock")
				end
			end
		end
	end
	-- a darker soil band a stud under the grass (the broken edge's strata)
	local jb = math.floor((top - 1.5) * 2)
	for i = math.floor((cx - rx) * 2), math.ceil((cx + rx) * 2) do
		for k = math.floor((cz - rz) * 2), math.ceil((cz + rz) * 2) do
			if Voxel.Get(g, i, jb, k) == "Dirt" then
				Voxel.Set(g, i, jb, k, "DirtDark")
			end
		end
	end
end

-- distance from (x, z) to the polyline `pts` ({ {x, z}, ... })
function Oasis.polyDist(x, z, pts)
	local best = math.huge
	for n = 1, #pts - 1 do
		local ax, az, bx, bz = pts[n][1], pts[n][2], pts[n + 1][1], pts[n + 1][2]
		local vx, vz = bx - ax, bz - az
		local t = ((x - ax) * vx + (z - az) * vz) / math.max(vx * vx + vz * vz, 1e-9)
		t = math.max(0, math.min(1, t))
		best = math.min(best, math.sqrt((x - ax - vx * t) ^ 2 + (z - az - vz * t) ^ 2))
	end
	return best
end

function Oasis.partBuild(m, origin)
	local O = OASIS
	local fineCF = origin * CFrame.new(0, 0.25, 0)
	local rockCF = origin * CFrame.new(0, 0.5, 0)
	-- 1) the pool: boulder rim (1-stud voxels) and the stepping stones, collidable
	local rock = Voxel.NewGrid(16)
	VX.Ring(rock, 0, 0, O.PoolIn, O.PoolIn + 1.2, 0, 0, "RockDark")
	for i = 0, 20 do
		local a = (i + (Voxel.Hash(i, 1, 21, 3) - 0.5) * 0.35) / 21 * math.pi * 2
		local rr = O.RimR + (Voxel.Hash(i, 2, 21, 3) - 0.5) * 0.4
		local h = 2 -- boulder tops at 2 studs (the meshes' 1.55 .. 2.25), size varies with the hash below
		Voxel.Shape(rock, {
			Kind = "Ellipsoid",
			Key = (i % 4 == 1) and "RockDark" or "Rock",
			Center = { math.cos(a) * rr, h * 0.5 - 0.5, math.sin(a) * rr },
			Radius = { 0.9 + Voxel.Hash(i, 4, 21, 3) * 0.3, h * 0.5 + 0.3, 1.3 + Voxel.Hash(i, 3, 21, 3) * 0.5 },
			Rotation = CFrame.Angles(0, -a, 0),
		})
	end
	for _, s in ipairs(O.Stones) do
		VX.Disc(rock, s[1], s[2], s[4], 0, s[3] - 1, "Rock")
	end
	Voxel.Shade(rock, { Only = { Rock = true, RockDark = true }, Smooth = 1, Seed = 13 })
	local pool = Instance.new("Model")
	pool.Name = "Pool"
	pool.Parent = m
	VX.Build(rock, { V = 1, Name = "Rim", CF = rockCF, Collide = true, Parent = pool, MaxParts = 84 })
	-- the pool floor: four squares turned by 22.5 degrees (a 16-gon whose corners hide under the rim), 0.5 stud thick
	local side = O.PoolIn * 2 * math.cos(math.pi / 4) + 0.2
	for i = 0, 3 do
		box(pool, "Floor", origin * CFrame.new(0, 0.25, 0) * CFrame.Angles(0, i * math.pi / 8, 0), Vector3.new(side, 0.5, side),
			C.PoolFloor, { Collide = true, Shadow = false })
	end
	-- the sign (pool key): two posts and the faded board, Parts
	do
		local sp, sf = O.Sign.Pos, O.Sign.Face
		local yaw = math.atan2(-sf[1], -sf[2])
		local cf = origin * CFrame.new(sp[1], 0, sp[2]) * CFrame.Angles(0, yaw, 0)
		local sign = Instance.new("Model")
		sign.Name = "Sign"
		sign.Parent = pool
		for _, sx in ipairs({ -1.15, 1.15 }) do
			box(sign, "Post", cf * CFrame.new(sx, 1.45, 0.12), Vector3.new(0.3, 2.9, 0.3), C.PlankDark, { Collide = true })
		end
		box(sign, "Board", cf * CFrame.new(0, 2.02, -0.06), Vector3.new(2.6, 1.2, 0.22), C.Plank)
		box(sign, "Cap", cf * CFrame.new(0, 2.75, 0), Vector3.new(2.8, 0.18, 0.4), C.PlankLight)
		box(sign, "Paint", cf * CFrame.new(-0.45, 2.05, -0.19), Vector3.new(0.5, 0.6, 0.06), C.SignPaint)
	end

	-- 2) the islands, pillars and the pool floor (0.5-stud voxels), collidable
	local g = Voxel.NewGrid(64)
	local I1, I2, I3 = O.Islands[1], O.Islands[2], O.Islands[3]
	for _, p in ipairs({ { I2.C[1] - 0.1, I2.C[2] + 0.2, I2.Top - 3.5, 0.9 }, { I3.C[1] + 0.2, I3.C[2] + 0.1, I3.Top - 3.9, 1.0 } }) do
		Oasis.fill(g, p[1] - 1.2, p[1] + 1.2, p[2] - 1.2, p[2] + 1.2, 0, p[3], "Rock", function(x, z)
			if (x - p[1]) ^ 2 + (z - p[2]) ^ 2 > p[4] * p[4] then
				return nil
			end
			return 0, p[3]
		end)
	end
	for i, I in ipairs(O.Islands) do
		Oasis.island(g, I, i == 1)
	end
	-- the streams: the top grass row cut away along each stream (the water grid fills the channel)
	for s, pts in ipairs(O.Streams) do
		local j = math.floor(O.Islands[4 - s].Top * 2 - 0.5)
		for i = -24, 24 do
			for k = -24, 24 do
				if Oasis.polyDist(i * 0.5, k * 0.5, pts) <= 0.45 then
					Voxel.Set(g, i, j, k, nil)
				end
			end
		end
	end
	Voxel.Shade(g, { Only = { Grass = true }, Smooth = 1, Seed = 5 })
	local islands = Instance.new("Model")
	islands.Name = "Islands"
	islands.Parent = m
	VX.Build(g, { V = 0.5, Name = "Ground", CF = fineCF, Collide = true, Parent = islands, MaxParts = 180 })

	-- 3) decor on the islands (islands key), not collidable: the tree, the nest, the lantern, ladder, rope, landings
	local d = Voxel.NewGrid(64)
	local function shape(t)
		Voxel.Shape(d, t)
	end
	local function v(x, y, z) -- studs -> fine voxel coords
		return { x * 2, (y - 0.25) * 2, z * 2 }
	end
	local tx, tz = O.Tree[1], O.Tree[2]
	shape({ Kind = "Capsule", Key = "Bark", A = v(tx, I1.Top, tz), B = v(tx, I1.Top + 2.6, tz), Radius = 0.6, RadiusB = 0.45 })
	shape({ Kind = "Ellipsoid", Key = "Leaf", Center = v(tx, I1.Top + 3.3, tz), Radius = { 2.7, 2.1, 2.6 } })
	shape({ Kind = "Ellipsoid", Key = "Leaf", Center = v(tx + 0.7, I1.Top + 2.75, tz - 0.25), Radius = { 1.7, 1.4, 1.7 } })
	local nc = O.Nest.C
	shape({ Kind = "Torus", Key = "Twig", Center = v(nc[1], O.Nest.Floor + 0.25, nc[2]), Radius = O.Nest.R * 2, Thickness = 0.8 })
	local lx, lz = O.Lantern[1], O.Lantern[2]
	-- (thin pieces are capsules: a capsule always keeps the voxels along its line, a thin box can miss every centre)
	shape({ Kind = "Capsule", Key = "PlankDark", A = v(lx, I2.Top, lz), B = v(lx, I2.Top + 2.5, lz), Radius = 0.5 })
	shape({ Kind = "Capsule", Key = "Iron", A = v(lx, I2.Top + 2.45, lz), B = v(lx - 0.65, I2.Top + 2.45, lz), Radius = 0.4 })
	shape({ Kind = "Box", Key = "Iron", Center = v(lx - 0.65, I2.Top + 2.1, lz), Size = { 2, 1, 2 } })
	shape({ Kind = "Box", Key = "Lamp", Center = v(lx - 0.65, I2.Top + 1.6, lz), Size = { 1.2, 1.4, 1.2 } })
	-- the ladder on the low truss's -X face, its landing; the rope on the high truss's -Z face, its landing
	local L, R = O.Ladder, O.Rope
	local fx = L.C[1] - 1.0 + 0.12
	for _, sz in ipairs({ -0.7, 0.7 }) do
		shape({ Kind = "Capsule", Key = "Plank", A = v(fx, L.Y0 + 0.4, L.C[2] + sz), B = v(fx, L.Y1 + 0.75, L.C[2] + sz), Radius = 0.5 })
	end
	local y = L.Y0 + 0.95
	while y < L.Y1 - 0.3 do
		shape({ Kind = "Capsule", Key = "PlankLight", A = v(fx, y, L.C[2] - 0.75), B = v(fx, y, L.C[2] + 0.75), Radius = 0.4 })
		y = y + 0.75
	end
	shape({ Kind = "Box", Key = "Plank", Center = v((L.Deck[1] + L.Deck[2]) / 2, L.Y1 - 0.25, L.C[2]), Size = { (L.Deck[2] - L.Deck[1]) * 2, 1, 4 } })
	shape({ Kind = "Box", Key = "Plank", Center = v(R.C[1], R.Y1 - 0.25, (R.Deck[1] + R.Deck[2]) / 2), Size = { 4, 1, (R.Deck[2] - R.Deck[1]) * 2 } })
	shape({ Kind = "Capsule", Key = "Rope", A = v(R.C[1], I2.Top, R.C[2] - 0.9), B = v(R.C[1], R.Y1 + 0.05, R.C[2] - 0.9), Radius = 0.45 })
	local ky = R.Y1 - 0.6
	while ky > I2.Top + 0.6 do -- the knots
		shape({ Kind = "Ellipsoid", Key = "Rope", Center = v(R.C[1], ky, R.C[2] - 0.9), Radius = 0.8 })
		ky = ky - 0.7
	end
	-- (not NC_Detail: the ladder and the rope show where to climb, Low graphics keeps them)
	VX.Build(d, { V = 0.5, Name = "Decor", CF = fineCF, Collide = false, Parent = islands, MaxParts = 60 })

	-- 4) the water (water key): the pool surface and the island streams, translucent, not collidable
	local w = Voxel.NewGrid(64)
	local wCF = origin -- 0.5-stud rows centred on j * 0.5: the surface row j = 2 spans 0.75 .. 1.25
	Oasis.fill(w, -O.PoolIn, O.PoolIn, -O.PoolIn, O.PoolIn, 0, 2, "Water", function(x, z)
		if x * x + z * z > (O.PoolIn + 0.2) ^ 2 then
			return nil
		end
		return 0.5, 1.5
	end)
	for s, pts in ipairs(O.Streams) do
		local jy = math.floor((O.Islands[4 - s].Top - 0.1) * 2) -- the row just under the channel lip
		for i = -24, 24 do
			for k = -24, 24 do
				if Oasis.polyDist(i * 0.5, k * 0.5, pts) <= 0.45 then
					Voxel.Set(w, i, jy, k, "Water")
				end
			end
		end
	end
	local waterModel = VX.Build(w, { V = 0.5, Name = "Water", CF = wCF, Collide = false, Parent = m })
	return pool, islands, waterModel
end

-- One fall: a soft core sheet and thin fast streaks (Beams, FaceCamera), droplets off the lip (big fall), and at the
-- impact a splash of drops, foam, ripple rings on the water (and mist off the big one). Attachment0 = the impact,
-- Attachment1 = the lip (Oasis.Flow = -1: the texture runs A1 -> A0, down); both live on the invisible `anchor` part.
function Oasis.fall(anchor, origin, f, index)
	local lx, ly, lz = f.Lip[1], f.Lip[2], f.Lip[3]
	local dx, dz = f.Dir[1], f.Dir[2]
	local drop = ly - f.Land
	local throw = 0.3 + drop * 0.1
	local up = Vector3.new(0, 1, 0)
	local out = Vector3.new(dx, 0, dz).Unit
	local side = Vector3.new(-dz, 0, dx).Unit
	local lip = Vector3.new(lx, ly + 0.05, lz) + out * 0.2
	local impact = Vector3.new(lx, f.Land, lz) + out * (0.2 + throw)
	local inv = anchor.CFrame:Inverse() * origin -- fountain-local -> anchor-local
	local function attach(name, pos, xAxis)
		local a = Instance.new("Attachment")
		a.Name = name
		a.CFrame = inv * CFrame.fromMatrix(pos, xAxis, side:Cross(xAxis).Unit)
		a.Parent = anchor
		return a
	end
	local xBottom = up -- from the impact the curve rises (P1 = A0 + X0 * CurveSize0)
	local xTop = (out * -0.6 + up * 0.8).Unit -- P2 = A1 - X1 * CurveSize1: out and down from the lip
	local function beam(name, a0, a1, props)
		local b = Instance.new("Beam")
		b.Name = name
		b.Attachment0 = a0
		b.Attachment1 = a1
		b.FaceCamera = true
		b.Segments = 14
		b.CurveSize0 = drop * 0.3
		b.CurveSize1 = 0.45 + throw * 0.5
		b.LightInfluence = 0.5
		for k, v in pairs(props) do
			b[k] = v
		end
		b.Parent = anchor
		return b
	end
	local tag = "Fall" .. index
	local a0 = attach(tag .. "Impact", impact, xBottom)
	local a1 = attach(tag .. "Lip", lip, xTop)
	beam(tag .. "Core", a0, a1, {
		Texture = FxSprites.Strip("Sheet"), -- a soft-edged water sheet (the old stock glow until fx_watersheet is uploaded)
		TextureMode = Enum.TextureMode.Stretch,
		TextureLength = 1,
		TextureSpeed = 0,
		Width0 = f.Width * 1.25,
		Width1 = f.Width,
		Color = ColorSequence.new(rgb(150, 206, 246), rgb(120, 190, 242)),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(0.15, 0.2),
			NumberSequenceKeypoint.new(0.9, 0.2),
			NumberSequenceKeypoint.new(1, 0.5),
		}),
		LightEmission = 0.15,
	})
	local n = f.Big and 3 or 2
	for k = 1, n do
		local off = ((k - 1) / math.max(1, n - 1) - 0.5) * f.Width * 0.55
		local s0 = attach(tag .. "StreakImpact" .. k, impact + side * off * 1.2, xBottom)
		local s1 = attach(tag .. "StreakLip" .. k, lip + side * off, xTop)
		beam(tag .. "Streak" .. k, s0, s1, {
			Texture = FxSprites.Strip("Flow"), -- soft streaks running downhill (the old stock glow until fx_waterflow is uploaded)
			TextureMode = Enum.TextureMode.Wrap,
			TextureLength = 0.9 + k * 0.15,
			TextureSpeed = Oasis.Flow * (2.4 + k * 0.35 + (f.Big and 0.4 or 0)),
			Width0 = 0.42,
			Width1 = 0.32,
			Color = Oasis.Foam,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.6),
				NumberSequenceKeypoint.new(0.2, 0.15),
				NumberSequenceKeypoint.new(0.85, 0.15),
				NumberSequenceKeypoint.new(1, 0.7),
			}),
			LightEmission = 0.45,
			ZOffset = 0.05 * k,
		})
	end
	-- the impact: drops, foam (and mist) on the Splash part, tagged NC_Detail so Low graphics (GraphicsQuality) parks
	-- it with its emitters off; the ripple rings on their own untagged part, so on Low the falls (Core + streak Beams)
	-- still land in rings on the water
	local big = f.Big and 1 or 0.6
	local splash = anchorPart(anchor.Parent, tag .. "Splash", Oasis.at(origin, impact.X, f.Land + 0.1, impact.Z),
		Vector3.new(f.Width, 0.2, f.Width))
	splash.CFrame = origin * CFrame.new(impact.X, f.Land + 0.1, impact.Z)
	CollectionService:AddTag(splash, DETAIL_TAG)
	local rings = anchorPart(anchor.Parent, tag .. "Ripples", splash.Position, Vector3.new(f.Width, 0.2, f.Width))
	rings.CFrame = splash.CFrame
	Oasis.emitter(splash, {
		Name = "Drops",
		Rate = 30 * big,
		Lifetime = NumberRange.new(0.45, 0.8),
		Speed = NumberRange.new(3.5 * big + 1, 6 * big + 1),
		SpreadAngle = Vector2.new(38, 38),
		Acceleration = Vector3.new(0, -24, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.38), NumberSequenceKeypoint.new(1, 0.08) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 0.6) }),
	})
	Oasis.emitter(splash, {
		Name = "Foam",
		Sprite = "Puff",
		Color = Oasis.Foam,
		Rate = 9 * big,
		Lifetime = NumberRange.new(0.6, 1.0),
		Speed = NumberRange.new(0.6, 1.6),
		SpreadAngle = Vector2.new(60, 60),
		Acceleration = Vector3.new(0, -1, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7 * big + 0.3), NumberSequenceKeypoint.new(1, 1.9 * big + 0.4) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) }),
		RotSpeed = NumberRange.new(-40, 40),
		LightEmission = 0.2,
	})
	Oasis.emitter(rings, {
		Name = "Ripples",
		Sprite = "Ring",
		Color = Oasis.Foam,
		Orientation = Enum.ParticleOrientation.VelocityPerpendicular, -- flat on the water
		EmissionDirection = Enum.NormalId.Top,
		Rate = 2.4 * big + 0.4,
		Lifetime = NumberRange.new(1.1, 1.4),
		Speed = NumberRange.new(0.05, 0.05),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 3.4 * big + 0.6) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }),
		LightEmission = 0.25,
	})
	if f.Big then
		Oasis.emitter(splash, {
			Name = "Mist",
			Sprite = "Puff",
			Color = Oasis.Foam,
			Rate = 4,
			Lifetime = NumberRange.new(1.6, 2.6),
			Speed = NumberRange.new(0.6, 1.2),
			SpreadAngle = Vector2.new(70, 70),
			Acceleration = Vector3.new(0, 0.4, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.8), NumberSequenceKeypoint.new(1, 4.2) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(1, 1) }),
			RotSpeed = NumberRange.new(-20, 20),
			LightEmission = 0.1,
		})
		-- droplets breaking off the lip (the sheet tears into drops as it falls): the part's front (-Z) faces out
		local lipWorld = Oasis.at(origin, lip.X, lip.Y - 0.1, lip.Z)
		local outWorld = origin:VectorToWorldSpace(out)
		local lipPart = anchorPart(anchor.Parent, tag .. "LipDrops", lipWorld, Vector3.new(f.Width, 0.2, 0.3))
		lipPart.CFrame = CFrame.lookAt(lipWorld, lipWorld + outWorld)
		CollectionService:AddTag(lipPart, DETAIL_TAG)
		Oasis.emitter(lipPart, {
			Name = "LipDrops",
			Rate = 12,
			Lifetime = NumberRange.new(0.5, 0.8),
			Speed = NumberRange.new(1.2, 2.2),
			EmissionDirection = Enum.NormalId.Front,
			SpreadAngle = Vector2.new(15, 15),
			Acceleration = Vector3.new(0, -26, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0.14) }),
			Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.5) }),
		})
	end
	return impact
end

-- The paper boat: one root Part and its sail under it, both Anchored like every lobby part (the server never moves
-- them; client FountainFx moves the root and the sail together at their rest offsets, and the dressed mesh rides the
-- root, ML_Weld). Returns the root and its fountain-local rest frame.
function Oasis.boat(m, origin)
	local b = OASIS.Boat
	local rest = CFrame.new(b[1], OASIS.Water, b[2]) * CFrame.Angles(0, 0.5, 0)
	local cf = origin * rest
	local root = box(m, "PaperBoat", cf * CFrame.new(0, 0.1, 0), Vector3.new(0.6, 0.3, 1.3), C.Paper, { Shadow = false })
	local sail = box(root, "Sail", cf * CFrame.new(0, 0.5, 0), Vector3.new(0.1, 0.55, 0.6), C.Paper, { Shadow = false })
	sail.CanCollide = false
	root:SetAttribute("ML_Weld", true) -- a moving root: the dressed mesh is welded to it (MeshLibrary.Dress)
	CollectionService:AddTag(root, "OasisBoat")
	return root, rest
end

local function buildFountain(f, centre, lookTarget)
	local m = newModel(f, "Fountain")
	local ground = flatLook(Vector3.new(centre.X, TOP, centre.Z), Vector3.new(lookTarget.X, TOP, lookTarget.Z))
	local pool, islands, waterModel = Oasis.partBuild(m, ground)
	-- Phase 6: the Blender meshes dress these Part builds once their keys are uploaded (the Parts stay the colliders)
	Mesh.tag(pool, "prop_oasis_pool", ground)
	Mesh.tag(islands, "prop_oasis_islands", ground)
	if waterModel then
		Mesh.tag(waterModel, "prop_oasis_water", ground)
	end
	local boat, boatRest = Oasis.boat(m, ground)
	Mesh.tag(boat, "prop_oasis_boat", ground * boatRest)

	-- the climbs: invisible trusses (reliable climbing for every rig), tops flush with the plank landings
	for _, spec in ipairs({ { "LadderTruss", OASIS.Ladder }, { "RopeTruss", OASIS.Rope } }) do
		local c = spec[2]
		local t = Instance.new("TrussPart")
		t.Name = spec[1]
		t.Anchored = true
		t.Size = Vector3.new(2, c.Y1 - c.Y0, 2)
		t.CFrame = ground * CFrame.new(c.C[1], (c.Y0 + c.Y1) / 2, c.C[2])
		t.Transparency = 1
		t.CanCollide = true
		t.CanQuery = true
		t.CanTouch = false
		t.CastShadow = false
		t.Parent = m
	end

	-- the water: three falls (Beams on one anchor), their splashes, a few bubbles at the spring
	local anchor = anchorPart(m, "Falls", ground.Position)
	anchor.CFrame = ground
	CollectionService:AddTag(anchor, "OasisFalls")
	for i, fall in ipairs(OASIS.Falls) do
		Oasis.fall(anchor, ground, fall, i)
	end
	local sp = OASIS.Spring
	local bubbles = anchorPart(m, "SpringBubbles", Oasis.at(ground, sp[1] - 0.05, OASIS.Islands[3].Top - 0.2, sp[2] - 0.75),
		Vector3.new(0.8, 0.1, 0.6))
	CollectionService:AddTag(bubbles, DETAIL_TAG) -- Low graphics: the bubbles rest (the falls and ripples keep running)
	Oasis.emitter(bubbles, {
		Name = "Bubbles",
		Rate = 5,
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(0.5, 1.0),
		SpreadAngle = Vector2.new(20, 20),
		Acceleration = Vector3.new(0, -2, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.22), NumberSequenceKeypoint.new(1, 0.05) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0.8) }),
	})
	-- the lantern's warm glow on the middle island (the old blue spray light went with the spray)
	local lp = OASIS.Lantern
	local lamp = anchorPart(m, "LanternLight", Oasis.at(ground, lp[1] - 0.65, OASIS.Islands[2].Top + 1.6, lp[2] - 0.05))
	pointLight(lamp, C.Lamp, 0.8, 12)

	-- Nimbus in the nest (optional: the pet modules); the statue's lowest point sits on the nest floor, facing front
	local ok, err = pcall(function()
		local builderModule = Shared:FindFirstChild("PetBuilder")
		local catalogModule = Shared:FindFirstChild("PetCatalog")
		if not builderModule or not catalogModule then
			return
		end
		local PetBuilder = require(builderModule)
		local PetCatalog = require(catalogModule)
		local def = PetCatalog.Get and PetCatalog.Get("cloudy_dragon")
		if not def or type(PetBuilder.Build) ~= "function" then
			return
		end
		local opts = { Scale = OASIS.StatueScale, Detail = "Low" }
		local nest = OASIS.Nest
		local function statue()
			local pet = PetBuilder.Build(def, opts)
			if not pet then
				return nil
			end
			pet.Name = "NimbusStatue"
			pet:PivotTo(CFrame.new(0, 0, 0))
			local boxCf, boxSize = pet:GetBoundingBox()
			local bottom = pet:GetPivot().Position.Y - (boxCf.Position.Y - boxSize.Y * 0.5)
			if type(bottom) ~= "number" or bottom ~= bottom or bottom < -50 or bottom > 100 then
				bottom = 2
			end
			pet:PivotTo(ground * CFrame.new(nest.C[1], nest.Floor + bottom, nest.C[2]))
			for _, d in ipairs(pet:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
				end
			end
			CollectionService:AddTag(pet, EXEMPT_TAG) -- a pet statue: skipped by the 6.4 material / saturation audit
			return pet
		end
		local pet = statue()
		if not pet then
			return
		end
		pet.Parent = m
		-- Phase 6: the mesh Nimbus replaces this Part build once its keys load after boot (MeshLibrary.Swap)
		if type(PetBuilder.SwapWhenReady) == "function" then
			PetBuilder.SwapWhenReady(pet, def, opts, statue)
		end
	end)
	if not ok then
		warn("[LobbyBuilder] fountain statue skipped: " .. tostring(err))
	end
	return m
end

----------------------------------------------------------------------
-- Phase 5 courts (6.1; Phase 6: the P4 colours): the tiled spawn court, the Gate Court with its terrace, the avenue,
-- the welcome arch
----------------------------------------------------------------------
local Court = {}

-- Boxes along an annulus sector (plaza angles in degrees, radii in studs): each segment spans [r0, r1] radially and
-- about `seg` studs of arc. fn(i, n) -> color | nil (skip), topOffset (above TOP), material | nil. A grout gap
-- separates the tiles; neighbours overlap a little at the inner edge, so their heights alternate (rule 5).
function Court.Arc(parent, name, r0, r1, a0, a1, seg, thick, gap, fn)
	local span = a1 - a0
	local rm = (r0 + r1) / 2
	local n = math.max(1, math.floor(math.rad(span) * rm / seg + 0.5))
	local step = span / n
	local width = 2 * r1 * math.sin(math.rad(step) / 2) - gap
	for i = 1, n do
		local color, top, material = fn(i, n)
		if color then
			local a = a0 + (i - 0.5) * step
			local pos = polar(a, rm, TOP + top - thick / 2)
			local cf = CFrame.lookAt(pos, Vector3.new(OX, pos.Y, OZ))
			local p = box(parent, name, cf, Vector3.new(math.max(0.4, width), thick, (r1 - r0) - gap), color, { Collide = true, Material = material, Shadow = false })
			p.CanQuery = true
		end
	end
end

-- Tile colour: the base cream stone with a +-6 RGB jitter per tile, deterministic.
function Court.Jitter(color, a, b)
	local h = hash3(a, b, 7, 31) * 2 - 1
	local d = h * 6 / 255
	return Color3.new(clamp(color.R + d, 0, 1), clamp(color.G + d, 0, 1), clamp(color.B + d * 1.2, 0, 1))
end

-- The tiled courts: concentric Slate rings around the medallion (r 4 .. 32) inside a Marble ring (32 .. 34); the Gate
-- Court's lower level (r 96 .. 126) and its raised terrace (r 126 .. 146, a Marble step in front), Marble rims.
function Court.Tiles(f, L)
	local m = newModel(f, "Courts")
	local slate, slateL = C.Slate, C.SlateLight
	local ring = 0
	local function tiles(name, r0, r1, a0, a1, depth, seg, top)
		local r = r0
		while r < r1 - 0.5 do
			local rb = math.min(r1, r + depth)
			ring = ring + 1
			local thisRing = ring
			Court.Arc(m, name, r, rb, a0, a1, seg, top + 0.6, 0.22, function(i)
				local alt = (i + thisRing) % 2 == 0
				return Court.Jitter(alt and slateL or slate, i, thisRing), top + (alt and 0.05 or 0), materialOf("Slate")
			end)
			r = rb
		end
	end
	-- the spawn court
	tiles("SpawnTile", 4.6, 32, 0, 360, 4.6, 6, 0)
	Court.Arc(m, "SpawnRing", 32, 34.4, 0, 360, 7, 0.7, 0.12, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, 0.08
	end)
	-- the Gate Court (lower level + the raised terrace)
	tiles("CourtTile", G.CourtIn, G.TerraceIn - 1, L.CourtFrom, L.CourtTo, 6, 6, 0)
	Court.Arc(m, "CourtRim", G.CourtIn - 1.6, G.CourtIn + 0.2, L.CourtFrom, L.CourtTo, 8, 0.6, 0.1, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, 0.08
	end)
	Court.Arc(m, "TerraceStep", G.TerraceIn - 1, G.TerraceIn + 1.2, L.CourtFrom, L.CourtTo, 8, 0.9, 0.1, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, G.TerraceLift + 0.05
	end)
	tiles("TerraceTile", G.TerraceIn + 1.2, G.CourtOut, L.CourtFrom, L.CourtTo, 6.3, 6, G.TerraceLift)
	-- the side edges of the sector: Marble kerbs from the rim to the back of the terrace
	for _, a in ipairs({ L.CourtFrom, L.CourtTo }) do
		local inward = (a == L.CourtFrom) and 1 or -1
		local mid = (G.CourtIn - 1.6 + G.CourtOut) / 2
		local len = G.CourtOut - (G.CourtIn - 1.6)
		local d = dirOf(a)
		local side = dirOf(a + 90) * inward
		local pos = Vector3.new(OX, TOP, OZ) + d * mid + side * 0.6 + Vector3.new(0, G.TerraceLift / 2 - 0.15, 0)
		local p = box(m, "CourtSide", CFrame.lookAt(pos, pos + d), Vector3.new(1.4, G.TerraceLift + 0.75, len), C.MarbleShade, { Collide = true })
		p.CanQuery = true
	end
	Mesh.tag(m, "floor_plaza_courts", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	return m
end

-- The cobbled circle walk (r RingRoadR, 8 wide + Brick borders) from one end of the Gate Court round to the other:
-- arc segments read smoother than voxel cells and cost fewer parts. Its tops sit 0.03 / 0.06 above the voxel paths
-- that cross it (no coplanar overlap).
function Court.RingRoad(f, L)
	local m = newModel(f, "CircleWalk")
	local a0, a1 = L.CourtTo + 0.4, L.CourtFrom + 360 - 0.4
	local R, h = G.RingRoadR, G.PathHalf - 1
	Court.Arc(m, "Walk", R - h, R + h, a0, a1, 8, 0.7, 0.05, function(i)
		local alt = i % 2 == 0
		return Court.Jitter(alt and C.StoneLight or C.Stone, i, 3), alt and 0.06 or 0.03, materialOf("Cobblestone")
	end)
	for _, rb in ipairs({ { R - h - 1.2, R - h + 0.05 }, { R + h - 0.05, R + h + 1.2 } }) do
		Court.Arc(m, "WalkBorder", rb[1], rb[2], a0, a1, 10, 0.6, 0.02, function(i)
			return C.StoneEdge, (i % 2 == 0) and 0.0 or 0.02, materialOf("Brick")
		end)
	end
	Mesh.tag(m, "floor_plaza_walk", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	return m
end

-- Angular gaps (degrees) of the walks crossing a ring of radius r: { centre, half } per crossing walk.
function Court.Gaps(L, r, extra)
	local gaps = {}
	local function add(a, half)
		gaps[#gaps + 1] = { a, math.deg((half + (extra or 0)) / r) }
	end
	for _, a in ipairs(L.SpokeAngles) do
		add(a, G.StubHalf)
	end
	for _, a in ipairs(L.CrossAngles) do
		add(a, G.PathHalf)
	end
	add(L.ShopAngle, G.BoardHalf)
	return gaps
end

-- Arcs of a ring between the gaps (and outside the Gate Court sector when `skipCourt`) -> { { a0, a1 } ... }
function Court.Runs(L, r, gaps, skipCourt)
	local cuts = {}
	for _, g in ipairs(gaps) do
		cuts[#cuts + 1] = { g[1] - g[2], g[1] + g[2] }
	end
	if skipCourt then
		cuts[#cuts + 1] = { L.CourtFrom - 1.5, L.CourtTo + 1.5 }
	end
	-- walk the circle in 0.5-degree steps and collect the free stretches (deterministic, cheap)
	local runs, start = {}, nil
	local function blocked(a)
		for _, c in ipairs(cuts) do
			if angleIn(a, c[1], c[2]) then
				return true
			end
		end
		return false
	end
	local base = 0
	while not blocked(base) and base < 360 do
		base = base + 0.5
	end
	for k = 0, 720 do
		local a = base + k * 0.5
		if not blocked(a) then
			start = start or a
		elseif start then
			if a - 0.5 - start >= 2 then
				runs[#runs + 1] = { start, a - 0.5 }
			end
			start = nil
		end
	end
	return runs
end

-- The plaza's edge: a low Brick kerb all round the lawn (6.4 rule 3: platform edges), open at every exit; clipped
-- hedges along the inner side of the circle walk; lamps along its outer side.
function Court.Edges(f, L)
	local m = newModel(f, "PlazaEdges")
	local rimR0, rimR1 = PLAZA_R - 4.6, PLAZA_R - 3.2
	for _, run in ipairs(Court.Runs(L, rimR1, Court.Gaps(L, rimR1, 2.5), false)) do
		Court.Arc(m, "EdgeKerb", rimR0, rimR1, run[1], run[2], 14, 1.1, 0.02, function(i)
			return C.StoneEdge, (i % 2 == 0) and 0.32 or 0.3, materialOf("Brick")
		end)
	end
	Mesh.tag(m, "floor_plaza_edges", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	local decor = newModel(f, "WalkHedges")
	CollectionService:AddTag(decor, DETAIL_TAG)
	local hr0 = G.RingRoadR - G.PathHalf - 4.4
	local hr1 = hr0 + 2.2
	for _, run in ipairs(Court.Runs(L, hr1, Court.Gaps(L, hr1, 1.5), true)) do
		Court.Arc(decor, "Hedge", hr0, hr1, run[1], run[2], 11, 2.2, 0.15, function(i)
			return (i % 2 == 0) and C.Hedge or C.HedgeLight, (i % 2 == 0) and 1.4 or 1.45, materialOf("LeafyGrass")
		end)
	end
	local lampTpl = Props.Lamp()
	local lit = 0
	for _, a in ipairs({ 15, 165, 200, 236, 304, 340 }) do
		if angleDiff(a, L.ShopAngle) > 12 then
			local pos = polar(a, G.RingRoadR + G.PathHalf + 2.2, TOP - LAWN)
			local lamp = place(lampTpl, CFrame.new(pos), decor, "WalkLamp")
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			lit = lit + 1
			if glass and lit % 2 == 1 then
				pointLight(glass, C.Lamp, 1.0, 14)
			end
		end
	end
	return m
end

-- The grand avenue's Brick kerbs (WorldStyle.Kerb), lamp posts every 16 studs and the welcome arch at r 40.
function Court.Avenue(f, L)
	local m = newModel(f, "Avenue")
	local d = dirOf(L.MidAngle)
	local side = dirOf(L.MidAngle - 90) -- the viewer's right when looking up the avenue
	local r0, r1 = G.CourtR + 0.6, G.CourtIn - 1.8
	local mid = (r0 + r1) / 2
	if WorldStyle and WorldStyle.Kerb then
		for _, s in ipairs({ -1, 1 }) do
			local p = Vector3.new(OX, TOP, OZ) + d * mid + side * s * (G.AvenueHalf - 0.6)
			-- X along the edge, LookVector outward
			local cf = CFrame.fromMatrix(p, d * s, Vector3.new(0, 1, 0), -(side * s))
			pcall(WorldStyle.Kerb, m, cf, r1 - r0, materialOf("Brick"), C.StoneEdge)
		end
	end
	local lampTpl = Props.Lamp()
	local r = G.CourtR + 10
	local n = 0
	while r <= G.CourtIn - 6 do
		for _, s in ipairs({ -1, 1 }) do
			local pos = Vector3.new(OX, TOP - LAWN, OZ) + d * r + side * s * (G.AvenueHalf + 2)
			local lamp = place(lampTpl, CFrame.new(pos), m, "AvenueLamp")
			n = n + 1
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			if glass and n % 2 == 1 then
				pointLight(glass, C.Lamp, 1.1, 14)
			end
			reserve(pos.X - OX, pos.Z - OZ, 2)
		end
		r = r + 16
	end
	Court.WelcomeArch(m, L, 40)
	return m
end

-- A stone arch over the avenue with the welcome sign (replaces the rainbow arch): two chamfered Marble piers on Slate
-- plinths, a Slate beam with a Marble cornice, the sign board on the beam (readable from the spawn and the gates).
function Court.WelcomeArch(parent, L, radius)
	local m = newModel(parent, "WelcomeArch")
	local base = polar(L.MidAngle, radius, TOP)
	local cf = flatLook(base, base + dirOf(L.MidAngle)) -- local -Z = up the avenue, towards the gates
	local px = G.AvenueHalf + 2.4
	-- tall enough that the beam stays above the gates' tags seen from the spawn (eye 5 studs up: the tags at 27 studs
	-- and 118 studs out sit ~11 degrees up; the beam's underside at ~27.5 studs and 40 out ~29 degrees)
	local pierH = 24
	for _, s in ipairs({ -1, 1 }) do
		local pc = cf * CFrame.new(s * px, 0, 0)
		if WorldStyle then
			WorldStyle.Plinth(m, pc * CFrame.new(0, 0.7, 0), Vector3.new(4.4, 1.4, 4.4), materialOf("Slate"), C.Slate)
			WorldStyle.Chamfer(m, pc * CFrame.new(0, 1.4 + pierH / 2, 0), Vector3.new(3.2, pierH, 3.2), materialOf("Marble"), C.Marble, 0.5)
		else
			box(m, "Pier", pc * CFrame.new(0, pierH / 2 + 0.7, 0), Vector3.new(3.2, pierH + 1.4, 3.2), C.Marble, { Collide = true })
		end
		box(m, "PierCap", pc * CFrame.new(0, 1.4 + pierH + 0.35, 0), Vector3.new(4, 0.7, 4), C.MarbleShade)
		reserve(base.X - OX + cf.RightVector.X * s * px, base.Z - OZ + cf.RightVector.Z * s * px, 4)
	end
	local beamY = 1.4 + pierH + 0.7 + 1.1
	box(m, "Beam", cf * CFrame.new(0, beamY, 0), Vector3.new(px * 2 + 4, 2.2, 3), C.MarbleShade, { Collide = true })
	box(m, "Cornice", cf * CFrame.new(0, beamY + 1.3, 0), Vector3.new(px * 2 + 4.8, 0.4, 3.6), C.Marble)
	box(m, "Soffit", cf * CFrame.new(0, beamY - 1.25, 0), Vector3.new(px * 2 + 2.6, 0.3, 3.3), C.SlateDark)
	local inlay = box(m, "Inlay", cf * CFrame.new(0, beamY - 0.3, -1.55), Vector3.new(px * 2, 0.25, 0.2), gateAccent("Gold"), { Material = MAT.Neon, Shadow = false })
	inlay.CastShadow = false
	-- the sign on the beam
	local boardCf = cf * CFrame.new(0, beamY + 1.5 + 3.4, 0) * CFrame.Angles(0, math.pi, 0)
	box(m, "SignFrame", boardCf, Vector3.new(19.4, 6.4, 0.8), C.SlateDark)
	box(m, "SignCap", boardCf * CFrame.new(0, 3.45, 0), Vector3.new(20.2, 0.5, 1.2), C.MarbleShade)
	-- (kit B stone board: the navy gradient panel and the title's gold-to-sky text gradient went) a stone panel with a gold
	-- lip, every line in the kit's ink; the board's sides in the frame's wood
	local board = box(m, "WelcomeSign", boardCf, Vector3.new(18.4, 5.4, 1.0), KIT.Sign.Wood, { Shadow = true })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = surfaceGui(board, face)
		local panel = signPanel(gui, KIT.Sign.GoldLip)
		signText(panel, "~ welcome to the clouds ~", "Script", 36, KIT.Sign.TextMuted, "Welcome", 0.04, 0.05, 0.92, 0.17)
		signText(panel, Config.GameName, "Title", 100, KIT.Sign.Text, "Title", 0.03, 0.23, 0.94, 0.44)
		signText(panel, Config.Tagline or "", "Script", 36, KIT.Sign.Text, "Tagline", 0.04, 0.72, 0.92, 0.17)
		gui.Parent = board
	end
	Mesh.tag(m, "prop_welcome_arch", cf, nil, { "WelcomeSign" }) -- Phase 6: the sign board stays (SurfaceGuis)
	return m
end

-- An obelisk (plinth + chamfered Marble shaft + a Metal cap and a small Neon band in `color`).
function Court.Obelisk(parent, ground, color)
	local m = newModel(parent, "Obelisk")
	local cf = CFrame.new(ground)
	if WorldStyle then
		WorldStyle.Plinth(m, cf * CFrame.new(0, 0.8, 0), Vector3.new(5, 1.6, 5), materialOf("Slate"), C.Slate)
		WorldStyle.Chamfer(m, cf * CFrame.new(0, 1.6 + 7, 0), Vector3.new(3, 14, 3), materialOf("Marble"), C.Marble, 0.5)
	else
		box(m, "Shaft", cf * CFrame.new(0, 8, 0), Vector3.new(3, 16, 3), C.Marble, { Collide = true })
	end
	box(m, "Band", cf * CFrame.new(0, 13, 0), Vector3.new(3.15, 0.3, 3.15), color, { Material = MAT.Neon, Shadow = false })
	box(m, "Cap", cf * CFrame.new(0, 15.95, 0), Vector3.new(3.4, 0.7, 3.4), C.MarbleShade)
	local tip = Instance.new("WedgePart")
	tip.Name = "Tip"
	tip.Anchored = true
	tip.CanCollide = false
	tip.CanQuery = false
	tip.CanTouch = false
	tip.CastShadow = false
	tip.Material = materialOf("Metal")
	tip.Color = C.Gold
	tip.Size = Vector3.new(2.2, 1.6, 1.1)
	tip.CFrame = cf * CFrame.new(0, 17.1, -0.55)
	tip.Parent = m
	local tip2 = tip:Clone()
	tip2.CFrame = cf * CFrame.new(0, 17.1, 0.55) * CFrame.Angles(0, math.pi, 0)
	tip2.Parent = m
	Mesh.tag(m, "prop_obelisk", cf, { Primary = color }) -- Phase 6: the band takes `color`
	return m
end

-- The Gate Court's dressing: hedges in Brick planters along the back of the terrace, a banner behind every gate in its
-- colour, two obelisks at the ends and lamps at the court's front corners.
function Court.Decor(f, L)
	local m = newModel(f, "GateCourtDecor")
	CollectionService:AddTag(m, DETAIL_TAG)
	-- hedges
	local hedgeR0, hedgeR1 = G.CourtOut - 3.4, G.CourtOut - 0.4
	Court.Arc(m, "Planter", hedgeR0, hedgeR1, L.CourtFrom + 1.2, L.CourtTo - 1.2, 10, 1.0, 0.3, function()
		return C.StoneEdge, G.TerraceLift + 1.0, materialOf("Brick")
	end)
	Court.Arc(m, "Hedge", hedgeR0 + 0.3, hedgeR1 - 0.3, L.CourtFrom + 1.2, L.CourtTo - 1.2, 10, 2.4, 0.5, function(i)
		return (i % 2 == 0) and C.Hedge or C.HedgeLight, G.TerraceLift + 3.2, materialOf("LeafyGrass")
	end)
	-- banners behind every gate (their colours, small cloth pieces: rule 2)
	for i, id in ipairs(L.GateOrder) do
		local a = L.GateAngles[id]
		for _, s in ipairs({ -1, 1 }) do
			local pos = polar(a + s * 3.4, G.TerraceIn + 6, TOP + G.TerraceLift)
			bannerPole(m, faceCentre(pos), gateAccent(GATE_SPECS[i].Accent))
		end
	end
	-- obelisks at both ends of the terrace
	for _, a in ipairs({ L.CourtFrom + 3.2, L.CourtTo - 3.2 }) do
		Court.Obelisk(m, polar(a, G.TerraceIn + 9, TOP + G.TerraceLift), gateAccent("Gold"))
	end
	-- lamps at the court's front corners (where the circle walk meets it)
	local lampTpl = Props.Lamp()
	for _, a in ipairs({ L.CourtFrom - 2.5, L.CourtTo + 2.5 }) do
		local pos = polar(a, G.CourtIn - 4, TOP - LAWN)
		local lamp = place(lampTpl, CFrame.new(pos), m, "CourtLamp")
		local glass = lamp and lamp:FindFirstChild("LampGlass")
		if glass then
			pointLight(glass, C.Lamp, 1.2, 16)
		end
	end
	return m
end

-- "How to play" and "Guide" notice boards on both sides of the avenue, facing the spawn.
local function buildBoards(f, L)
	local function spotFor(angle)
		local pos = plazaSpot(angle, 48, 6, L)
		if not pos then
			return nil
		end
		return faceCentre(pos - Vector3.new(0, LAWN, 0)) -- the board's face (-Z, the Front face) looks at the centre
	end
	-- 550 x 400 px canvas (11 x 8 studs): a 1.04-stud header, five 0.6-stud rows, a 0.6-stud footer
	-- (beside the lawns, clear of the sight lines from the spawn to the six gates)
	local howCf = spotFor(L.MidAngle - 58)
	if howCf then
		local face = noticeBoard(f, howCf, 11, 8, "HowToBoard")
		local gui = surfaceGui(face, Enum.NormalId.Front)
		-- (kit B: THE GATES face's stone panel, the key chips small raised stone blocks; the navy panel went)
		face.Color = KIT.Sign.Stone
		local panel = signPanel(gui)
		signText(panel, "HOW TO PLAY", "Title", 52, KIT.Sign.Text, "Header", 0.04, 0.025, 0.92, 0.14)
		local rows = {
			{ "W A S D", "Move around" },
			{ "SHIFT", "Hold to run" },
			{ "Q", "Dash over wide gaps" },
			{ "SPACE", "Jump" },
			{ "E", "Use a gate" },
		}
		for i, row in ipairs(rows) do
			keyRow(panel, 0.18 + (i - 1) * 0.12, 0.105, row[1], row[2])
		end
		signText(panel, "Walk up the avenue to the GATES!", "Body", SIGN_INFO, KIT.Sign.TextMuted, "Footer", 0.05, 0.785, 0.9, 0.19, nil, true)
		gui.Parent = face
	end
	local guideCf = spotFor(L.MidAngle + 58)
	if guideCf then
		local face = noticeBoard(f, guideCf, 11, 8, "GuideBoard")
		local gui = surfaceGui(face, Enum.NormalId.Front)
		-- (Pitch 2 item 04_world_ui, the owner's pick B "Stone tags"; the navy rounded panel with eight 30 px lines, about
		-- 8 px on the plaza, went) the face is a stone card (a 6 px wood edge, an 8 px lip) that lists only the five gate
		-- names at 52 px (about 15 px on the plaza, read from across the square) behind their pixel icons; each gate's own
		-- header carries its description, and the way home is the HUD's Home tile. Px of the 550 x 400 canvas (SIGN_PPS)
		local Sign = Theme.Sign
		face.Color = Sign.Stone
		local panel = Instance.new("Frame")
		panel.Name = "Panel"
		panel.Position = UDim2.fromOffset(6, 6) -- the edge is drawn outside the face: inset so the canvas keeps it
		panel.Size = UDim2.new(1, -12, 1, -12)
		panel.Parent = gui
		WorldTag.Block(panel, Sign.Stone, Sign.StoneLip, Sign.Wood, 6, 8)
		WorldTag.Text(panel, "Header", "THE GATES", "Title", 60, Sign.Text, {
			Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 68), TextXAlignment = Enum.TextXAlignment.Center,
		})
		local rule = Instance.new("Frame")
		rule.Name = "Rule"
		rule.BorderSizePixel = 0
		rule.BackgroundColor3 = Sign.StoneLip
		rule.Position = UDim2.fromOffset(24, 84)
		rule.Size = UDim2.new(1, -48, 0, 5)
		rule.Parent = panel
		-- Phase 6: the 5 real Gate Court gates (no Home gate any more)
		local lines = {
			{ "OBBY", "mountain", Sign.Sky },
			{ "DUNGEON", "castle", Sign.WoodLight },
			{ "RING", "trophy", Sign.Gold },
			{ "ARENA", "sword", Sign.Red },
			{ "ALTAR", "vault", Sign.Violet },
		}
		for i, line in ipairs(lines) do
			local row = Instance.new("Frame")
			row.Name = "Row_" .. line[1]
			row.BackgroundTransparency = 1
			row.Position = UDim2.fromOffset(0, 94 + (i - 1) * 56)
			row.Size = UDim2.new(1, 0, 0, 56)
			row.Parent = panel
			local icon = PixelIcon.New(row, line[2], 36, line[3])
			if icon then
				icon.Position = UDim2.fromOffset(34, 10)
			end
			WorldTag.Text(row, "Key", line[1], "Heading", 52, Sign.Text, {
				Position = UDim2.fromOffset(94, 0), Size = UDim2.new(1, -110, 1, 0), TextXAlignment = Enum.TextXAlignment.Left,
			})
		end
		gui.Parent = face
	end
end

-- Plaza decor: courts, avenue, fountain, boards, NPC spots, trees, lamps, benches, flower beds.
local function buildPlazaDecor(f, L)
	reserve(L.FountainX, L.FountainZ, 15)
	reserve(0, 0, G.CourtR + 2)

	local fountainPos = Vector3.new(OX + L.FountainX, TOP, OZ + L.FountainZ)
	local okF, errF = pcall(buildFountain, f, fountainPos, Vector3.new(OX, TOP, OZ))
	if not okF then
		warn("[LobbyBuilder] fountain failed: " .. tostring(errF))
	end
	for _, part in ipairs({
		{ "court decor", Court.Decor },
		{ "avenue", Court.Avenue },
		{ "boards", buildBoards },
		-- lobby shop (spec 5.10): the leaderboard board on the south lawn (LobbyBoardBuilder; the client SurfaceGui adorns
		-- its Face)
		{ "leaderboard board", function(ff, LL)
			return LobbyBoardBuilder.Leaderboard(ff, LL, LL.H)
		end },
	}) do
		local ok, err = pcall(part[2], f, L)
		if not ok then
			warn("[LobbyBuilder] " .. part[1] .. " failed: " .. tostring(err))
		end
	end

	-- NPC spots (NpcService builds the pets): on the east / west lawns (6.1: r 62..80, >= 12 studs from any path),
	-- facing the nearest walk.
	L.NpcSpots = {}
	local npcPlan = { 20, 160, 215, 235, 305, 325 }
	for _, a in ipairs(npcPlan) do
		local pos = plazaSpot(a, 70, 5, L, false)
		if not pos then
			pos = plazaSpot(a, 76, 5, L, true)
		end
		L.NpcSpots[#L.NpcSpots + 1] = flatLook(pos, Vector3.new(OX, TOP, OZ))
	end

	local decor = newModel(f, "LawnDecor")
	CollectionService:AddTag(decor, DETAIL_TAG)
	-- Trees on the lawns, between the walks (never near the courts).
	local trees = {
		{ 8, 120, "Round" }, { 36, 130, "Pine" }, { 144, 130, "Pine" }, { 172, 120, "Round" },
		{ 196, 126, "Blossom" }, { 226, 130, "Round" }, { 314, 130, "Round" }, { 344, 126, "Blossom" },
	}
	for i, t in ipairs(trees) do
		local pos = plazaSpot(t[1], t[2], 6, L)
		if pos then
			place(Props.Tree(t[3]), CFrame.new(pos - Vector3.new(0, LAWN, 0)) * CFrame.Angles(0, math.rad(i * 77), 0), decor, t[3] .. "Tree")
		end
	end

	-- Lamps where the walks meet the circle walk and at every exit through the rim.
	local lampTpl = Props.Lamp()
	local lit = 0
	local function lampAt(pos, name, light)
		local lamp = place(lampTpl, CFrame.new(pos), decor, name)
		local glass = lamp and lamp:FindFirstChild("LampGlass")
		if glass and light and lit < 6 then
			lit = lit + 1
			pointLight(glass, C.Lamp, 1.0, 14)
		end
	end
	for _, a in ipairs(L.CrossAngles) do
		for _, s in ipairs({ -1, 1 }) do
			local pos = polar(a, G.RingRoadR - G.PathHalf - 2.2, TOP - LAWN) + dirOf(a + 90) * s * (G.PathHalf + 2)
			lampAt(pos, "WalkLamp", s > 0)
		end
	end
	for _, a in ipairs(L.RimGaps) do
		local half = (angleDiff(a, L.ShopAngle) < 1) and G.BoardHalf or G.StubHalf
		local side = dirOf(a + 90)
		for _, s in ipairs({ -1, 1 }) do
			if s > 0 or angleDiff(a, L.ShopAngle) < 1 then
				lampAt(polar(a, PLAZA_R - 6, TOP - LAWN) + side * s * (half + 1.8), "ExitLamp", angleDiff(a, L.ShopAngle) < 1)
			end
		end
	end

	-- Benches on the inner lawns facing the spawn, flower beds along the circle walk.
	local benchTpl = Props.Bench()
	for _, b in ipairs({ { 50, 44 }, { 130, 44 }, { 200, 44 }, { 340, 44 } }) do
		local pos = plazaSpot(b[1], b[2], 3.5, L)
		if pos then
			place(benchTpl, faceCentre(pos - Vector3.new(0, LAWN, 0)), decor, "Bench")
		end
	end
	local beds = { 30, 150, 190, 250, 290, 350 }
	for i, a in ipairs(beds) do
		local pos = plazaSpot(a, G.RingRoadR - G.PathHalf - 14, 4, L)
		if pos then
			local bed = place(Props.FlowerBed((i - 1) % #FLOWERS + 1), faceCentre(pos - Vector3.new(0, LAWN, 0)), decor, "FlowerBed")
			if bed then
				bed:SetAttribute("FlowerVariant", (i - 1) % #FLOWERS + 1) -- bug #12: the seed drift wears the bed's colours
			end
		end
	end

	-- Fireflies and sparkle dust over the lawns.
	local flies = anchorPart(f, "Fireflies", Vector3.new(OX, TOP + 6, OZ), Vector3.new(PLAZA_R * 1.7, 10, PLAZA_R * 1.7))
	emitter(flies, {
		Sprite = "Glow",
		Color = ColorSequence.new(rgb(255, 236, 150), rgb(190, 240, 170)),
		Rate = 10,
		Lifetime = NumberRange.new(5, 8),
		Speed = NumberRange.new(0.3, 1),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.45),
	})
end

local function buildPlaza(root, L)
	local f = newFolder(root, "Plaza")
	buildPlazaGround(f, L)
	for _, part in ipairs({ { "court tiles", Court.Tiles }, { "circle walk", Court.RingRoad }, { "edges", Court.Edges } }) do
		local ok, err = pcall(part[2], f, L)
		if not ok then
			warn("[LobbyBuilder] " .. part[1] .. " failed: " .. tostring(err))
		end
	end
	local okBody, errBody = pcall(buildPlazaBody, f, L)
	if not okBody then
		warn("[LobbyBuilder] plaza cloud failed: " .. tostring(errBody))
	end
	local okDecor, errDecor = pcall(buildPlazaDecor, f, L)
	if not okDecor then
		warn("[LobbyBuilder] plaza decor failed: " .. tostring(errDecor))
	end
	return f
end

----------------------------------------------------------------------
-- Phase 5 Gate Court gates (6.1 / 6.2): Obby and Altar are built here with WorldStyle.BuildGate into the
-- Gates folder; Ring / Arena (ArenaBuilder) and Dungeon (DungeonBuilder, W3) stand at LobbyInfo.GateSites.
----------------------------------------------------------------------
local Gates = {}

-- lobby shop (spec 5.11 a): the Altar gate has the Obby's pad (decoration and the way back's landing spot; GateService's
-- "Travel" prompt stays the only way in), a Pill and a brighter vortex (VortexBoost: a model attribute PortalVortex reads)
Gates.Info = {
	Obby = { Title = "Sky Obby", Info = "Climb the clouds", Pad = true },
	Altar = { Title = "Storm Altar", Info = "Secret pets", Pad = true, Pill = "Secret Roulette", VortexBoost = 1.4 },
}
Gates.Built = { "Obby", "Altar" } -- the lobby's own gates, in Build order (Phase 6: no Home gate)

function Gates.Spec(id)
	for _, s in ipairs(GATE_SPECS) do
		if s.Id == id then
			return s
		end
	end
	return GATE_SPECS[1]
end

-- Ground CFrame of every gate centre on the arc (LookVector = towards the plaza centre).
function Gates.Sites(L)
	local sites = {}
	for _, id in ipairs(L.GateOrder) do
		sites[id] = faceCentre(polar(L.GateAngles[id], G.GateR, TOP))
	end
	return sites
end

-- A plain gate when WorldStyle is missing or BuildGate throws: two columns, a lintel, the pad / step, the prompt anchor
-- and a pixel tag (the same names as BuildGate, so GateService / PortalService work unchanged).
function Gates.Fallback(parent, site, id, info, color)
	local model = newModel(parent, "Portal_" .. id)
	model:SetAttribute("GateId", id)
	for side = -1, 1, 2 do
		box(model, "Column", site * CFrame.new(side * 8.2, 8, 0), Vector3.new(2.4, 16, 2.4), C.Marble, { Collide = true })
	end
	local lintel = box(model, "Lintel", site * CFrame.new(0, 17.4, 0), Vector3.new(21.4, 2.4, 3), C.Slate, { Collide = true })
	box(model, "PortalDisc", site * CFrame.new(0, 8, 0), Vector3.new(13, 14, 0.2), color, { Material = MAT.Neon, Transparency = 0.35, Shadow = false })
	local pad
	if info.Pad then
		pad = box(model, "Pad", site * CFrame.new(0, 0.3, -14), Vector3.new(14, 0.6, 14), C.Slate, { Collide = true })
	else
		pad = box(model, "Step", site * CFrame.new(0, 0.15, -6), Vector3.new(10, 0.3, 6), C.Slate, { Collide = true })
	end
	local prompt = box(model, "PromptAnchor", site * CFrame.new(0, 3, -2.2), Vector3.new(2, 2, 1), C.Slate, { Transparency = 1, Shadow = false })
	-- 55 studs: the gate card range (= WorldStyle.TagRange, written out: this stand-in runs without WorldStyle;
	-- 2026-11-13 owner: 55, was 45; first 120)
	local gui = newTag(lintel, "GateTag", 420, 150, 27 - 17.4, 55)
	-- (kit B) WorldStyle.BuildTag's stone board without its beam: Title / Info in ink, the Pill a block tinted in the gate's
	-- colour (PortalService re-tints it through WorldTag.Tint: the block carries the WorldTag attribute)
	local plate = tagPlate(gui, color, 190)
	tagText(plate, "Title", info.Title, "Heading", 28, KIT.Sign.Text, 1)
	tagText(plate, "Info", info.Info, "Body", 20, KIT.Sign.TextMuted, 2)
	-- the Pill shows info.Pill (the Altar's "Secret Roulette"); hidden while empty, as BuildGate's
	local pill = tagPill(plate, "Pill", info.Pill or "", "Label", 18, color, 3)
	pill.Visible = (info.Pill or "") ~= ""
	KIT.Done(plate)
	if type(info.VortexBoost) == "number" then
		model:SetAttribute("VortexBoost", info.VortexBoost)
	end
	model.PrimaryPart = lintel
	return model, pad, prompt
end

-- One gate of the court -> { Model, Pad, PromptPart }.
function Gates.BuildOne(parent, site, id)
	local spec = Gates.Spec(id)
	local info = Gates.Info[id] or { Title = id, Info = "", Pad = false }
	local ok, model, pad, prompt = false, nil, nil, nil
	if WorldStyle and type(WorldStyle.BuildGate) == "function" then
		ok, model, pad, prompt = pcall(WorldStyle.BuildGate, parent, site, {
			Id = id,
			Title = info.Title,
			Info = info.Info,
			Color = spec.Accent,
			Glyph = spec.Glyph,
			Pad = info.Pad,
			Name = "Portal_" .. id,
			Pill = info.Pill,
			VortexBoost = info.VortexBoost,
		})
		if not ok then
			warn("[LobbyBuilder] gate " .. id .. " failed: " .. tostring(model))
			local broken = parent:FindFirstChild("Portal_" .. id)
			if broken then
				broken:Destroy()
			end
		end
	end
	if not ok or not model then
		model, pad, prompt = Gates.Fallback(parent, site, id, info, gateAccent(spec.Accent))
	end
	return { Model = model, Pad = pad, PromptPart = prompt, Site = site }
end

-- lobby shop (5.11 a): the highest top of a gate's pad (the Pad part and the PadTile* inlay / rim tiles on it, up to 0.68
-- over the ground on a BuildGate pad), or nil when the gate has no "Pad" (a Step)
function Gates.PadTop(gate)
	local pad = type(gate) == "table" and gate.Pad or nil
	if typeof(pad) ~= "Instance" or not pad:IsA("BasePart") or pad.Name ~= "Pad" then
		return nil
	end
	local top = pad.Position.Y + pad.Size.Y / 2
	for _, d in ipairs(gate.Model and gate.Model:GetChildren() or {}) do
		if d:IsA("BasePart") and string.sub(d.Name, 1, 7) == "PadTile" then
			top = math.max(top, d.Position.Y + d.Size.Y / 2)
		end
	end
	return top
end

-- The Obby portal's PortalInfo: the gate + the PortalService zone on its pad (14 x 6 x 14, floor flush with the pad,
-- -Z facing the plaza) and the gate's pixel tag (PortalService writes the live party state into it).
function Gates.ObbyPortal(gate)
	local pad = gate.Pad
	local top = pad.Position.Y + pad.Size.Y / 2
	local zonePos = Vector3.new(pad.Position.X, top + 3, pad.Position.Z)
	local zone = box(gate.Model, "Zone_Obby", faceCentre(zonePos), Vector3.new(14, 6, 14), C.Slate, { Transparency = 1, Shadow = false })
	zone.CanQuery = false
	zone:SetAttribute("PortalId", "Obby")
	local tag = gate.Model:FindFirstChild("GateTag", true)
	local plate = tag and tag:FindFirstChild("Plate")
	local pill = plate and plate:FindFirstChild("Pill")
	return {
		Id = "Obby",
		Model = gate.Model,
		Zone = zone,
		Center = zone.Position,
		Pad = pad,
		PromptPart = gate.PromptPart,
		Billboard = tag,
		TitleLabel = plate and plate:FindFirstChild("Title"),
		InfoLabel = plate and plate:FindFirstChild("Info"),
		StatusPill = pill,
		StatusLabel = pill and (pill:FindFirstChild("Label") or pill:FindFirstChild("PillLabel")),
	}
end

----------------------------------------------------------------------
-- Shop island: four gacha-style roulette machines, the item stall, a rarity board, a token statue
----------------------------------------------------------------------

-- Size (studs) of the name + price card floating above every roulette machine.
local MACHINE_CARD_W = 14
local MACHINE_CARD_H = 7.6
local machineBoxCache = nil

-- Pixel tag of a roulette machine: the name in the roulette colour + a gold price. The machines stand ~15 studs
-- apart, so the tags hide beyond 60 studs (constant-size tags of neighbours would overlap on screen from afar).
local function machineTag(anchor, roulette, lift)
	local color = roulette.Color or C.Rose
	local gui = newTag(anchor, "PriceBillboard", 320, 110, lift, 60)
	-- (kit B) a stone card, its lip in the roulette's colour; the name and the coin price in ink
	local plate = tagPlate(gui, color, 160)
	tagText(plate, "NameLabel", roulette.DisplayName or roulette.Id, "Title", 26, KIT.Sign.Text, 1)
	tokenPrice(tagText(plate, "PriceLabel", priceText(roulette.Price or 0), "Display", 24, KIT.Sign.TextMuted, 2))
	KIT.Done(plate)
	return gui
end

-- Rarities (in Config order) that a roulette can actually pay out.
local function oddsRarities(roulette)
	local list = {}
	for _, rarity in ipairs(Config.Rarities) do
		if roulette.Odds and (roulette.Odds[rarity.Id] or 0) > 0 then
			list[#list + 1] = rarity
		end
	end
	return list
end

-- the P4 machine colours: the roulette colour on the cabinet, gold trims, cream wheel segments, a glass dome
local function machinePalette(roulette)
	local color = roulette.Color or C.Rose
	local pal = {
		Base = C.Iron,
		Body = color,
		Trim = C.Gold,
		Seg1 = color:Lerp(rgb(255, 255, 255), 0.45),
		Seg2 = C.Cream,
		Rim = C.GoldDark,
		Hub = C.Gold,
		Dark = rgb(42, 46, 70),
		Glass = { Color = rgb(214, 236, 255), Material = MAT.Glass, Transparency = 0.55 },
		Bulb = { Color = C.Lamp, Material = MAT.Neon },
		Knob = { Color = color, Material = MAT.Neon },
		Iron = C.IronLight,
	}
	local rarities = oddsRarities(roulette)
	for i = 1, 4 do
		local r = rarities[(i - 1) % math.max(1, #rarities) + 1]
		pal["Egg" .. i] = (r and r.Color) or color
	end
	return pal
end

-- The machine is sculpted and merged once; each roulette builds it with its own colours. Front = -Z.
-- Two resolutions: the cabinet, wheel and lever in fine half-stud voxels, the glass dome in 1-stud voxels
-- (translucent voxels cannot hide behind each other, so a coarse dome keeps the part count sane).
local function machineBoxes()
	if machineBoxCache then
		return machineBoxCache
	end
	local g = Voxel.NewGrid(28)
	VX.RoundRect(g, 0, 0, 18, 14, 3, 0, 1, "Base")
	VX.RoundRect(g, 0, 0, 15, 11, 2, 2, 2, "Trim")
	VX.RoundRect(g, 0, 0, 14, 10, 2, 3, 10, "Body")
	VX.RoundRect(g, 0, 0, 15, 11, 2, 11, 11, "Trim")
	VX.RoundRect(g, 0, 0, 8, 8, 2, 12, 13, "Trim")
	-- the prize wheel on the front: eight coloured segments, a gold rim and hub, a red pointer on top
	local wy = 7
	for x = -4, 4 do
		for y = 3, 11 do
			local dy = y - wy
			local d = math.sqrt(x * x + dy * dy)
			if d <= 3.7 then
				local key
				if d <= 1.0 then
					key = "Hub"
				elseif d >= 2.9 then
					key = "Rim"
				else
					local seg = math.floor((atan2(dy, x) + math.pi) / (math.pi / 4))
					key = (seg % 2 == 0) and "Seg1" or "Seg2"
				end
				Voxel.Set(g, x, y, -6, key)
			end
		end
	end
	Voxel.Set(g, 0, 11, -6, "Knob")
	Voxel.Set(g, 0, 11, -7, "Knob")
	-- prize chute + gold tray, marquee bulbs on the top band
	VX.Fill(g, -2, 2, 3, 3, -6, -6, "Dark")
	VX.Fill(g, -2, 2, 2, 2, -7, -6, "Trim")
	for _, x in ipairs({ -6, -3, 3, 6 }) do
		Voxel.Set(g, x, 11, -6, "Bulb")
	end
	-- lever on the right side
	Voxel.Shape(g, { Kind = "Capsule", A = { 7.4, 6, 0 }, B = { 9, 12, 0 }, Radius = 0.6, Key = "Iron" })
	Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 9, 13.2, 0 }, Radius = 1.3, Key = "Knob" })
	Voxel.Shade(g, {
		Skip = { Bulb = true, Seg1 = true, Seg2 = true, Hub = true, Rim = true, Dark = true, Knob = true },
		Smooth = 1,
		Seed = 12,
	})

	-- the glass dome full of pet eggs (1-stud voxels), sitting on the neck
	local d = Voxel.NewGrid(8)
	Voxel.Shape(d, { Kind = "Ellipsoid", Center = { 0, 9.4, 0 }, Radius = { 3.1, 2.9, 3.1 }, Key = "Glass" })
	local eggs = { { -1.2, 8.1, -0.9 }, { 1.2, 8.2, 0.7 }, { 0.2, 9.8, -1.3 }, { -0.9, 10, 1.1 }, { 1.4, 9.9, -0.2 }, { -0.1, 8.4, 1.6 } }
	for i, e in ipairs(eggs) do
		Voxel.Shape(d, { Kind = "Ellipsoid", Center = e, Radius = { 0.75, 0.95, 0.75 }, Key = "Egg" .. ((i - 1) % 4 + 1), Bias = 0.15 })
	end
	VX.RoundRect(d, 0, 0, 3, 3, 0.8, 12, 12, "Trim")
	Voxel.Set(d, 0, 13, 0, "Bulb")
	local pal = machinePalette(Config.Roulettes[1] or { Color = C.Rose })
	-- LOD only folds shade variants (the coloured keys differ per roulette, so they are kept as they are)
	local keep = { "Body", "Trim", "Seg1", "Seg2", "Rim", "Hub", "Glass", "Egg1", "Egg2", "Egg3", "Egg4", "Bulb", "Knob", "Base", "Iron", "Dark" }
	machineBoxCache = {
		Fine = Voxel.Merge(g, { Palette = pal, MaxParts = 70, Keep = keep }),
		Dome = Voxel.Merge(d, { Palette = pal, Keep = keep }),
	}
	return machineBoxCache
end

-- A gacha roulette machine (Model Roulette_<Id>). `cf` sits on the ground; LookVector = towards the customer.
-- H = L.H (the in-globe eggs draw with it; nil = no eggs).
local function buildMachine(parent, cf, roulette, H)
	local model = newModel(parent, "Roulette_" .. roulette.Id)
	local body = Instance.new("Model")
	body.Name = "Machine"
	-- the sculpt's front (-Z) faces along cf.LookVector (the customer)
	local boxes = machineBoxes()
	local pal = machinePalette(roulette)
	Voxel.BuildBoxes(boxes.Fine, { VoxelSize = 0.5, Palette = pal, CFrame = cf * CFrame.new(0, 0.25, 0), Model = body, CanCollide = true, CanQuery = true })
	Voxel.BuildBoxes(boxes.Dome, { VoxelSize = 1, Palette = pal, CFrame = cf * CFrame.new(0, 0.5, 0), Model = body, CanCollide = true, CanQuery = true })
	body.Parent = model
	-- shop-area 16.17.1: the Gumball Globe for every roulette (cabinet = the roulette colour, emblem = its top rarity's;
	-- Secret's near-black reads as the chat violet). Only a dressed globe gets the real eggs in its glass. With no globe
	-- id the tag returns false and the Machine keeps today's look: the uploaded Phase 6 cabinet prop_roulette (review
	-- round 1: it ships an id, so the live game wears it; Phase 6's look, eggs = the top rarity's Config colour), and
	-- the voxel Part build only where that key is missing too.
	local rarities = oddsRarities(roulette)
	local top = rarities[#rarities]
	local chat = type(Config.Eggs) == "table" and type(Config.Eggs.ChatColors) == "table" and Config.Eggs.ChatColors or {}
	-- (polish: Secret's star is white-gold; the chat violet 180,150,255 was a near twin of Cloud's Epic lavender)
	local emblem = (top and top.Id == "Secret" and LobbyMachineBuilder.SECRET_EMBLEM) or (top and (chat[top.Id] or top.Color)) or C.Gold
	local dressed = Mesh.tag(body, LobbyMachineBuilder.GLOBE.Key, cf, { Primary = roulette.Color or C.Rose, Secondary = emblem })
	if not dressed then
		Mesh.tag(body, "prop_roulette", cf, { Primary = roulette.Color or C.Rose, Secondary = (top and top.Color) or C.Gold })
	end
	if dressed and H then
		local okEggs, errEggs = pcall(LobbyMachineBuilder.GlobeEggs, model, cf, roulette, H)
		if not okEggs then
			warn("[LobbyBuilder] globe eggs " .. tostring(roulette.Id) .. " failed: " .. tostring(errEggs))
		end
	end
	local cabinet = nil
	for _, d in ipairs(body:GetChildren()) do
		if d:IsA("BasePart") and d.Name == "Body" and (not cabinet or d.Size.Magnitude > cabinet.Size.Magnitude) then
			cabinet = d
		end
	end
	local glow = anchorPart(model, "DomeGlow", (cf * CFrame.new(0, 9.5, 0)).Position)
	pointLight(glow, roulette.Color or C.Lamp, 0.9, 16) -- range 16: art rule 7 (bug batch 6; was 18)
	emitter(glow, {
		Color = ColorSequence.new((roulette.Color or C.Rose):Lerp(rgb(255, 255, 255), 0.4), C.TextGold),
		Rate = 3,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(1, 2.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.5),
	})

	-- Name + price tag standing on the dome.
	local anchor = anchorPart(model, "PriceAnchor", (cf * CFrame.new(0, 14.2 + MACHINE_CARD_H * 0.5, 0)).Position)
	machineTag(anchor, roulette, 0.5 - MACHINE_CARD_H * 0.5)

	-- Invisible spot in front where PetService hangs the ProximityPrompt.
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5.4), Vector3.new(5, 4, 3), roulette.Color or C.Rose, { Transparency = 1, Shadow = false })
	prompt.CanQuery = false
	model.PrimaryPart = cabinet or prompt
	return {
		Id = roulette.Id,
		PromptPart = prompt,
		Center = (cf * CFrame.new(0, 3.5, 0)).Position,
		Model = model,
	}
end

local function fallbackMachine(parent, cf, roulette)
	local old = parent:FindFirstChild("Roulette_" .. roulette.Id)
	if old then
		old:Destroy()
	end
	local model = newModel(parent, "Roulette_" .. roulette.Id)
	local cabinet = box(model, "Cabinet", cf * CFrame.new(0, 3, 0), Vector3.new(7, 6, 5), roulette.Color or C.Rose, { Collide = true })
	local anchor = anchorPart(model, "PriceAnchor", (cf * CFrame.new(0, 10, 0)).Position)
	machineTag(anchor, roulette, -2.5)
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	model.PrimaryPart = cabinet
	return { Id = roulette.Id, PromptPart = prompt, Center = cabinet.Position, Model = model }
end

-- The Sky Trove (store 2026-11-04, spec 5.3): a sky-sailor's treasure chest, since the lobby shop (spec 5.9) on the
-- plaza lawn (L.TroveCF; it stood on the shop lawn where the boarded-up item stall had been). Plank body with two brass
-- bands, gold corners, a lock plate and iron side handles on four feet; the Lid is its own Model hinged at the back
-- edge (PrimaryPart Hinge on the hinge line) and rests OPEN 18 degrees so the gold inside and the warm light show
-- through the gap (TroveController swings it to 70 degrees on the client when a
-- player's prize pays out); a little sign post beside it (the lawn here steps between 0.0 and 0.4 studs, so nothing
-- lies flat on it). Front (-Z) faces the customer. <= 60 parts; mesh keys prop_trove_body / prop_trove_lid /
-- prop_trove_sign (the Blender dress comes later: until a key has an id the Parts stay). TroveService puts the
-- ProximityPrompt on PromptPart. The Join sign (JoinAnchor + JoinBillboard) floats over it. -> { PromptPart, Center,
-- Model, Lid }
local function buildTrove(parent, cf)
	local REST_DEG = 18 -- the lid's resting angle (TroveController swings it to 70 from here)
	local model = newModel(parent, "SkyTrove")
	local brass, brassDark = C.Gold, C.GoldDark
	-- the body: core box, two seams, two brass bands, four corners, the rim, the lock, the handles, the feet
	local body = newModel(model, "Body")
	local core = box(body, "Core", cf * CFrame.new(0, 2.6, 0), Vector3.new(9, 4.2, 6), C.Plank, { Collide = true })
	for i, y in ipairs({ 1.9, 3.3 }) do
		box(body, "Seam" .. i, cf * CFrame.new(0, y, -3.04), Vector3.new(8.6, 0.18, 0.12), C.PlankDark)
	end
	for i, x in ipairs({ -2.9, 2.9 }) do
		box(body, "Band" .. i, cf * CFrame.new(x, 2.6, 0), Vector3.new(0.6, 4.36, 6.16), brassDark)
	end
	local corners = { { -4.45, -2.95 }, { 4.45, -2.95 }, { -4.45, 2.95 }, { 4.45, 2.95 } }
	for i, c in ipairs(corners) do
		box(body, "Corner" .. i, cf * CFrame.new(c[1], 2.6, c[2]), Vector3.new(0.4, 4.36, 0.4), brass)
		box(body, "Foot" .. i, cf * CFrame.new(c[1] * 0.86, 0.25, c[2] * 0.82), Vector3.new(1.1, 0.5, 1.1), C.PlankDark)
	end
	box(body, "Rim", cf * CFrame.new(0, 4.72, -2.95), Vector3.new(9.1, 0.25, 0.3), brass)
	box(body, "LockPlate", cf * CFrame.new(0, 4.0, -3.12), Vector3.new(1.3, 1.3, 0.25), brass)
	box(body, "Keyhole", cf * CFrame.new(0, 3.85, -3.26), Vector3.new(0.25, 0.5, 0.06), C.Ink)
	for i, x in ipairs({ -4.65, 4.65 }) do
		box(body, "Handle" .. i, cf * CFrame.new(x, 3.3, 0), Vector3.new(0.3, 0.35, 2), C.Iron)
	end
	-- the treasure seen through the gap: a gold bed, three square coins on edge and a rose gem (blocks only: the lobby
	-- has no round primitives)
	box(body, "Treasure", cf * CFrame.new(0, 4.55, 0), Vector3.new(8.4, 0.3, 5.4), C.Gold)
	for i, c in ipairs({ { -2, 0.8, 20 }, { 1.5, -0.6, -35 }, { 2.8, 1.2, 60 } }) do
		box(body, "Coin" .. i, cf * CFrame.new(c[1], 4.95, c[2]) * CFrame.Angles(0, math.rad(c[3]), math.rad(12)) * CFrame.Angles(math.rad(45), 0, 0), Vector3.new(0.18, 0.8, 0.8), C.GoldDark)
	end
	box(body, "Gem", cf * CFrame.new(-0.4, 4.95, 0.3) * CFrame.Angles(math.rad(45), math.rad(30), 0), Vector3.new(0.7, 0.7, 0.7), C.Rose)
	Mesh.tag(body, "prop_trove_body", cf)

	-- the lid: hinged on the back top edge, built at its resting angle (Hinge = the hinge line, the client's pivot)
	local lid = newModel(model, "Lid")
	local lidCF = cf * CFrame.new(0, 4.7, 3) * CFrame.Angles(math.rad(REST_DEG), 0, 0)
	local hinge = box(lid, "Hinge", lidCF, Vector3.new(0.4, 0.4, 0.4), C.Iron, { Transparency = 1, Shadow = false })
	box(lid, "Slab", lidCF * CFrame.new(0, 0.45, -3.05), Vector3.new(9.2, 0.9, 6.2), C.Plank, { Collide = true })
	box(lid, "Crown", lidCF * CFrame.new(0, 1.15, -3.05), Vector3.new(8.4, 0.5, 5.2), C.PlankLight)
	for i, x in ipairs({ -2.9, 2.9 }) do
		box(lid, "Band" .. i, lidCF * CFrame.new(x, 0.75, -3.05), Vector3.new(0.65, 1.6, 6.3), brassDark)
		box(lid, "Hinge" .. i, lidCF * CFrame.new(x, 0.2, 0.15), Vector3.new(1, 0.5, 0.45), C.Iron)
	end
	box(lid, "Lip", lidCF * CFrame.new(0, 0.35, -6.15), Vector3.new(9.3, 0.5, 0.25), brass)
	box(lid, "Hasp", lidCF * CFrame.new(0, -0.1, -6.25), Vector3.new(1, 1, 0.2), brass)
	lid.PrimaryPart = hinge
	CollectionService:AddTag(lid, Config.Tags.TroveLid)
	-- the name plate rides the lid (one pixel-sized tag, the world text rule)
	local plateAnchor = anchorPart(lid, "PlateAnchor", (lidCF * CFrame.new(0, 1.6, -3)).Position)
	local bb = newTag(plateAnchor, "TroveBillboard", 320, 110, 1.4, 80)
	local plate = tagPlate(bb, KIT.Sign.Gold, 160) -- (kit B) the stone card, a gold lip
	tagText(plate, "Title", "SKY TROVE", "Title", TAG_NAME, KIT.Sign.Text, 1)
	KIT.Done(plate)
	Mesh.tag(lid, "prop_trove_lid", lidCF, nil, { "Hinge", "PlateAnchor" })

	-- the warm light and the sparkles in the gap (pure decor: Low graphics parks them)
	local glow = anchorPart(model, "TroveGlow", (cf * CFrame.new(0, 5.3, -0.5)).Position, Vector3.new(6, 0.6, 4))
	pointLight(glow, C.Lamp, 1.2, 14)
	emitter(glow, {
		Color = ColorSequence.new(C.TextGold, C.Gold),
		Rate = 4,
		Lifetime = NumberRange.new(1.2, 2),
		Speed = NumberRange.new(0.6, 1.6),
		SpreadAngle = Vector2.new(25, 25),
		EmissionDirection = Enum.NormalId.Top,
		Size = popSize(0.5),
	})
	CollectionService:AddTag(glow, DETAIL_TAG)

	-- the sign post beside the chest (a painted gold star on a plank board; no words: the lid plate names it). lobby shop
	-- (spec 5.9 / 16.2): at local x -6.2 (was +6.2), the west walk side at spot C (open lawn; its footing ends 0.86 stud
	-- off the walk's border), since at +6.2 it would crowd the Guide board's post (under a stud from its foot)
	local sign = newModel(model, "Sign")
	local signCF = cf * CFrame.new(-6.2, 0, -1.4)
	box(sign, "Footing", signCF * CFrame.new(0, 0.15, 0), Vector3.new(1.2, 0.3, 1.2), C.StoneDark)
	box(sign, "Post", signCF * CFrame.new(0, 2.2, 0), Vector3.new(0.45, 4.2, 0.45), C.PlankDark, { Collide = true })
	box(sign, "Board", signCF * CFrame.new(0, 3.7, -0.32), Vector3.new(2.4, 1.3, 0.22), C.Plank)
	box(sign, "Star", signCF * CFrame.new(0, 3.7, -0.45) * CFrame.Angles(0, 0, math.rad(45)), Vector3.new(0.7, 0.7, 0.08), C.Gold)
	Mesh.tag(sign, "prop_trove_sign", signCF)

	-- lobby shop (spec 5.9): the Join sign over the chest, a pixel tag like the lid plate on an invisible anchor 10.5 studs
	-- up. GroupId 0 (no group yet): one line, so no kid is asked to join a group that does not exist; else "Join the
	-- group!" over the Group ask's reward. Tagged NC_Bob (the client bobs it) and hidden by the client for a player whose
	-- TroveGroupDone attribute is set.
	local trove = type(Config.Trove) == "table" and Config.Trove or {}
	local joinAnchor = anchorPart(model, "JoinAnchor", (cf * CFrame.new(0, 10.5, 0)).Position)
	local join = newTag(joinAnchor, "JoinBillboard", 360, 110, 0, 60)
	local joinPlate = tagPlate(join, KIT.Sign.Grass, 160) -- (kit B) the stone card, the main action's green lip
	if (tonumber(trove.GroupId) or 0) > 0 then
		tagText(joinPlate, "JoinTitle", "Join the group!", "Title", TAG_NAME, KIT.Sign.Text, 1)
		local reward, bits = nil, {}
		for _, ask in ipairs(type(trove.Asks) == "table" and trove.Asks or {}) do
			if type(ask) == "table" and ask.Id == "Group" and type(ask.Reward) == "table" then
				reward = ask.Reward
			end
		end
		for _, k in ipairs({ "Cash", "Tokens" }) do
			local n = math.floor(tonumber(reward and reward[k]) or 0)
			if n > 0 then
				bits[#bits + 1] = Util.Commas(n) .. " " .. k
			end
		end
		if #bits > 0 then
			tagText(joinPlate, "JoinReward", table.concat(bits, " + "), "Body", TAG_INFO, KIT.Sign.TextMuted, 2)
		end
	else
		tagText(joinPlate, "JoinSoon", "Group rewards coming soon!", "Heading", 24, KIT.Sign.Text, 1)
	end
	KIT.Done(joinPlate)
	CollectionService:AddTag(join, Config.Tags.Bob or "NC_Bob")
	join:SetAttribute("BobStuds", 0.5)
	join:SetAttribute("BobSeconds", 2.4)

	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5.4), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	model.PrimaryPart = core
	return { PromptPart = prompt, Center = (cf * CFrame.new(0, 2.6, 0)).Position, Model = model, Lid = lid }
end

-- The plain stand-in when buildTrove failed: a counter box, the PromptPart and an empty Lid model (still tagged).
local function fallbackTrove(parent, cf)
	local old = parent:FindFirstChild("SkyTrove")
	if old then
		old:Destroy()
	end
	local model = newModel(parent, "SkyTrove")
	local counter = box(model, "Counter", cf * CFrame.new(0, 1.7, 0), Vector3.new(9, 3.4, 3.2), C.Plank, { Collide = true })
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5.4), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	local lid = newModel(model, "Lid")
	CollectionService:AddTag(lid, Config.Tags.TroveLid)
	model.PrimaryPart = counter
	return { PromptPart = prompt, Center = counter.Position, Model = model, Lid = lid }
end

-- Board that explains the roulettes: price, and which rarities each one can give. Returns its Face and its Model.
-- shop-area 16.17.2: the seven-egg row (LobbyBoardBuilder.EggRow) stands in front of it, its eggs 3.8 studs tall, so every
-- letter and pill ends above y 3.9 (<= RB.MaxBottom = (11.4 - 3.9) x 50 px of the 450): one header row (the title left,
-- the subtitle right in two lines: at 30 px it is 507 px long, measured with Roblox's BuilderSans-Bold, and the 383 px
-- title leaves it ~280; a box 261 .. 285 px wide breaks it into "Every egg hatches" / "a pet of its rarity"), then the
-- four roulette rows at RB.Pitch (the fourth row's pills end at 362 px).
local function buildRarityBoard(parent, cf)
	-- 700 x 450 px canvas (14 x 9 studs): a 1-stud header, then one row per roulette: the name and the price
	-- (0.6 stud) over rarity pills that spell out what it can pay (0.6 stud)
	local RB = { TitleX = 0.025, TitleW = 0.56, SubX = 0.575, SubW = 0.40, SubY = 4, SubH = 62, RowTop = 68, Pitch = 74, Name = 36, PillTop = 38, Pill = 34 }
	local face, model = noticeBoard(parent, cf, 14, 9, "RarityBoard")
	local gui = surfaceGui(face, Enum.NormalId.Front)
	-- (kit B: THE GATES face's stone panel; the navy panel and the rounded outlined pills went) every line in ink, each
	-- rarity a small square block tinted in its colour (WorldTag.Tint)
	face.Color = KIT.Sign.Stone
	local panel = signPanel(gui)
	local H = 450
	signText(panel, "WINGED PETS", "Title", 50, KIT.Sign.Text, "Header", RB.TitleX, 6 / H, RB.TitleW, 54 / H, Enum.TextXAlignment.Left)
	signText(panel, "Every egg hatches a pet of its rarity", "Body", SIGN_INFO, KIT.Sign.TextMuted, "Sub", RB.SubX, RB.SubY / H, RB.SubW, RB.SubH / H, Enum.TextXAlignment.Right, true) -- lobby shop (5.9)
	for i, roulette in ipairs(Config.Roulettes) do
		local top = RB.RowTop + (i - 1) * RB.Pitch
		local y = top / H
		signText(panel, roulette.DisplayName or roulette.Id, "Heading", SIGN_INFO, KIT.Sign.Text, "Name" .. i, 0.04, y, 0.6, RB.Name / H, Enum.TextXAlignment.Left)
		tokenPrice(signText(panel, priceText(roulette.Price or 0), "Body", SIGN_INFO, KIT.Sign.Text, "Price" .. i, 0.6, y, 0.36, RB.Name / H, Enum.TextXAlignment.Right))
		local pills = plainFrame(panel, "Rarities" .. i)
		pills.Position, pills.Size = KIT.Place(panel, 0.04, (top + RB.PillTop) / H, 0.92, RB.Pill / H)
		-- 12 px apart: the pills' 2 px edges are drawn outside them
		local layout = listLayout(pills, Enum.FillDirection.Horizontal, 12, Enum.HorizontalAlignment.Left)
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		for k, rarity in ipairs(oddsRarities(roulette)) do
			local pill = tagPill(pills, "Rarity_" .. rarity.Id, rarity.Id, "Body", SIGN_INFO, rarity.Color, k)
			-- a slim pill (32 px, its edge outside): the row keeps a clear gap to the next roulette
			pill.Size = UDim2.fromOffset(pill.Size.X.Offset, RB.Pill - 2 * KIT.PillEdge)
		end
	end
	gui.Parent = face
	return face, model
end

-- A big decorative voxel coin with a cloud emblem on a pedestal (NOT a collectible token).
local function buildTokenStatue(parent, ground)
	local m = newModel(parent, "TokenStatue")
	local g = Voxel.NewGrid(12)
	VX.RoundRect(g, 0, 0, 6, 6, 1.2, 0, 1, "StoneLight")
	VX.RoundRect(g, 0, 0, 4.4, 4.4, 1, 2, 2, "Stone")
	for x = -4, 4 do
		for y = -4, 4 do
			local d = math.sqrt(x * x + y * y)
			if d <= 4.3 then
				local key = (d >= 3.4) and "GoldDark" or "Gold"
				Voxel.Set(g, x, 7 + y, 0, key)
			end
		end
	end
	-- the cloud emblem in relief on both faces
	local emblem = {}
	for _, row in ipairs({ { 2, -1, 0 }, { 1, -2, 2 }, { 0, -3, 3 }, { -1, -2, 2 } }) do
		for x = row[2], row[3] do
			emblem[#emblem + 1] = { x, row[1] }
		end
	end
	for _, e in ipairs(emblem) do
		Voxel.Set(g, e[1], 7 + e[2], -1, "GoldGlow")
		Voxel.Set(g, e[1], 7 + e[2], 1, "GoldGlow")
	end
	VX.Fill(g, -1, 1, 3, 3, 0, 0, "GoldDark")
	Voxel.Shade(g, { Only = { StoneLight = true, Stone = true }, Smooth = 1 })
	local coinCf = flatLook(ground, Vector3.new(OX, ground.Y, OZ))
	local coin = VX.Build(g, { V = 1, Name = "Coin", CF = coinCf * CFrame.new(0, 0.5, 0), Collide = true, Parent = m })
	if coin then
		Mesh.tag(coin, "prop_token_statue", coinCf) -- Phase 6
	end
	local sparkle = anchorPart(m, "CoinSparkle", ground + Vector3.new(0, 7, 0), Vector3.new(6, 6, 2))
	emitter(sparkle, { Rate = 5, Lifetime = NumberRange.new(1.2, 2), Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180), Size = popSize(0.6) })
	return m
end

local function buildShop(root, L)
	local f = newFolder(root, "Shop")
	local S = L.ShopCenter
	local R = L.ShopR
	local shopCF = flatLook(S, Vector3.new(OX, TOP, OZ)) -- local -Z = towards the plaza (the entrance)
	local function at(x, z)
		return (shopCF * CFrame.new(x, 0, z)).Position
	end
	local function local2(wx, wz)
		local p = shopCF:PointToObjectSpace(Vector3.new(S.X + wx, TOP, S.Z + wz))
		return p.X, p.Z
	end
	local rng = Util.NewRng(SEED + 4)

	-- Ground layers (2-stud cells): lawn, patches + flowers, borders, the stone court + entrance path, inlays.
	local cell = 2
	local n = math.ceil(R / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	for i = -n, n do
		for k = -n, n do
			local wx, wz = i * cell, k * cell
			local r = math.sqrt(wx * wx + wz * wz)
			if r <= R - 0.5 then
				local x, z = local2(wx, wz)
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local nz = vnoise(wx + 50, wz + 50, 22, 31)
				if r > R - 3 then
					nz = 0.5 -- lawn only at the very edge
				end
				if nz < 0.26 then
					Voxel.Set(grids[2], i, 0, k, "GrassDark")
				elseif nz > 0.76 then
					Voxel.Set(grids[2], i, 0, k, "GrassLight")
				end
				local court = r <= 21
				local path = z < 0 and math.abs(x) <= 7
				if court or path then
					Voxel.Set(grids[3], i, 0, k, "StoneEdge")
				end
				if r <= 19 or (z < 0 and math.abs(x) <= 5) then
					Voxel.Set(grids[4], i, 0, k, "Stone")
				end -- (bug #12: the rim's flat flower pixels became Meadow clumps)
				if r <= 19 then
					if r >= 12 and r <= 13.5 then
						Voxel.Set(grids[5], i, 0, k, "StoneLight")
					elseif r >= 4.5 and r <= 6.5 then
						Voxel.Set(grids[5], i, 0, k, "GoldDark")
					end
				end
			end
		end
	end
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	for li = 1, 5 do
		local layer = VX.Build(grids[li], { V = cell, Name = "Ground" .. li, CF = CFrame.new(S.X, TOP + tops[li] - cell / 2, S.Z), Collide = true, Shadow = false, Parent = f })
		if layer then
			Mesh.tag(layer, "floor_shop_" .. li, CFrame.new(S.X, TOP, S.Z)) -- Phase 6 (LayoutSig)
		end
	end

	-- The shop's cloud body + the stone neck to the plaza.
	local okBody, errBody = pcall(function()
		local rim = {}
		for i = 1, 9 do
			local a = (i - 1) / 9 * 360 + rng:Float(-5, 5)
			local wx, wz = math.cos(math.rad(a)) * (R + 1.5), math.sin(math.rad(a)) * (R + 1.5)
			local _, lz = local2(wx, wz)
			if lz > -R * 0.55 then
				local s = rng:Float(8, 10)
				rim[#rim + 1] = { wx, rng:Float(-1, 1), wz, s, s * 0.6, s }
			end
		end
		local puffs = {}
		for i = 1, 6 do
			local a = (i - 1) / 6 * math.pi * 2 + rng:Float(-0.3, 0.3)
			local s = rng:Float(7, 11)
			puffs[#puffs + 1] = { math.cos(a) * (R - 6), -7, math.sin(a) * (R - 6), s, s * 0.7, s }
		end
		local shopCloud = VX.CloudModel({
			V = 3,
			Tiers = { { R = R + 3, H = 1 }, { R = R - 3, H = 2 }, { R = R - 11, H = 2 }, { R = R - 19, H = 2 } },
			Puffs = puffs,
			Rim = rim,
			Carve = function(x, y, z)
				return y > 0 and (x * x + z * z) < (R - 4) * (R - 4)
			end,
			Seed = 5,
			MaxParts = 84,
		}, CFrame.new(S.X, TOP - 1.2, S.Z), f, "ShopCloud", true)
		if shopCloud then
			Mesh.tag(shopCloud, "cloud_shop", CFrame.new(S.X, TOP - 1.2, S.Z)) -- Phase 6 (LayoutSig)
		end
	end)
	if not okBody then
		warn("[LobbyBuilder] shop cloud failed: " .. tostring(errBody))
	end
	local neckA = polar(L.ShopAngle, PLAZA_R - 4, TOP)
	local neckB = polar(L.ShopAngle, L.ShopDist - R + 5, TOP)
	local neckMid = (neckA + neckB) * 0.5
	box(f, "ShopNeck", flatLook(neckMid, neckB) * CFrame.new(0, -0.2 - 0.6, 0), Vector3.new(G.BoardHalf * 2 - 0.3, 1.2, (neckB - neckA).Magnitude), C.Stone, { Collide = true })
	place(Props.Puff("S"), CFrame.new(neckMid - Vector3.new(0, 1.4, 0)), f, "NeckPuff")

	-- Roulette machines on an arc across the back, cheapest on the left as the customer walks in.
	local roulettes = {}
	local count = #Config.Roulettes
	local arcR = 19
	local stepDeg = math.deg(2 * math.asin(math.min(1, (MACHINE_CARD_W + 1) / (2 * arcR))))
	if count > 1 then
		stepDeg = math.min(stepDeg, 150 / (count - 1))
	end
	for i, roulette in ipairs(Config.Roulettes) do
		local phi = math.rad((i - (count + 1) / 2) * stepDeg)
		local pos = at(-math.sin(phi) * arcR, math.cos(phi) * arcR)
		local cf = flatLook(pos, S)
		local ok, result = pcall(buildMachine, f, cf, roulette, L.H)
		if not ok then
			warn("[LobbyBuilder] roulette machine " .. tostring(roulette.Id) .. " failed: " .. tostring(result))
			result = fallbackMachine(f, cf, roulette)
		end
		roulettes[roulette.Id] = result
	end

	-- The WINGED PETS rarity board (lobby shop 5.9: on the lawn, facing the centre; at(23, -10) since the polish, below) with the seven-egg row in
	-- front of it (shop-area 16.17.2: the old guide board's spot at at(-21, -8) is empty lawn now, with its lamp and
	-- flower bed). The Sky Trove stands on the plaza lawn at L.TroveCF (worked out once in Build, before the plaza's
	-- reservations); it stays in this folder, so a failed shop build takes it along and the fallback builds the only trove.
	-- (shop-area polish: at(23, -10), out on the lawn and towards the entrance; at(21, -8) the row's Secret end stood
	-- 0.44 stud off the Cloud machine and its eggs read as that machine's)
	local boardCF = flatLook(at(23, -10) - Vector3.new(0, LAWN, 0), S - Vector3.new(0, LAWN, 0)) -- on the lawn layer
	local okBoard, face = pcall(buildRarityBoard, f, boardCF)
	if not okBoard then
		warn("[LobbyBuilder] rarity board failed: " .. tostring(face))
	end
	-- lobby shop 16.3 (Task 23): the walk-up Shop prompt's counter is the egg row (PetService puts ShopPrompt on its part;
	-- without it PetService warns and the machines' prompts still open the Shop); Center = the board's Face
	local counter = nil
	local okRow, row, rowPart = pcall(LobbyBoardBuilder.EggRow, f, boardCF, L.H)
	if not okRow then
		warn("[LobbyBuilder] egg row failed: " .. tostring(row))
	elseif rowPart then
		counter = { PromptPart = rowPart, Center = (okBoard and typeof(face) == "Instance") and face.Position or rowPart.Position, Model = row }
	end
	local okStall, stall = pcall(buildTrove, f, L.TroveCF)
	if not okStall then
		warn("[LobbyBuilder] sky trove failed: " .. tostring(stall))
		stall = fallbackTrove(f, L.TroveCF)
	end

	-- Decor: token statue, entrance arch with the shop sign, lamps, bunting, flower beds, fireflies.
	local okDecor, errDecor = pcall(function()
		buildTokenStatue(f, S)
		local archCF = shopCF * CFrame.new(0, 0, -(R - 5)) * CFrame.Angles(0, math.pi, 0)
		local arch = newModel(f, "ShopArch")
		for _, s in ipairs({ -1, 1 }) do
			box(arch, "Pillar", archCF * CFrame.new(s * 7.6, 0.35, 0), Vector3.new(2.6, 1.7, 2.6), C.StoneDark, { Collide = true })
			box(arch, "Pillar", archCF * CFrame.new(s * 7.6, 5.6, 0), Vector3.new(1.8, 8.8, 1.8), C.StoneLight, { Collide = true })
			box(arch, "PillarCap", archCF * CFrame.new(s * 7.6, 10.3, 0), Vector3.new(2.6, 0.8, 2.6), C.Rose)
			box(arch, "PillarLamp", archCF * CFrame.new(s * 7.6, 11.2, 0), Vector3.new(1, 1, 1), C.Lamp, { Material = MAT.Neon })
		end
		box(arch, "Beam", archCF * CFrame.new(0, 10.3, 0), Vector3.new(13, 0.6, 1.2), C.PlankDark)
		local sign = box(arch, "ShopSign", archCF * CFrame.new(0, 12.38, 0), Vector3.new(12.4, 3.6, 0.8), KIT.Sign.Wood, { Shadow = true })
		box(arch, "SignRoof", archCF * CFrame.new(0, 14.46, 0), Vector3.new(14, 0.6, 1.8), C.Rose)
		Mesh.tag(arch, "prop_shop_arch", archCF, nil, { "ShopSign" }) -- Phase 6: the sign board stays (SurfaceGuis)
		-- 620 x 180 px canvas: the name 1.6 studs tall, the caption 0.68 stud
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = surfaceGui(sign, face)
			-- (kit B) the stone panel with the shop roof's pink lip, ink lines (the navy gradient panel went)
			local panel = signPanel(gui, KIT.Sign.RoofLip)
			signText(panel, "CLOUD SHOP", "Title", 80, KIT.Sign.Text, "Name", 0.03, 0.05, 0.94, 0.56)
			signText(panel, "eggs & gems", "Body", 34, KIT.Sign.TextMuted, "Sub", 0.04, 0.62, 0.92, 0.3) -- lobby shop 16.3: no items any more
			gui.Parent = sign
		end
		local lampTpl = Props.Lamp()
		local lampTops = {}
		for i, p in ipairs({ { -9, -13 }, { 9, -13 }, { -25, 6 }, { 25, 6 } }) do
			local base = at(p[1], p[2]) - Vector3.new(0, (i > 2) and LAWN or 0, 0) -- the outer pair stands on the lawn
			local lamp = place(lampTpl, CFrame.new(base), f, "ShopLamp")
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			if glass and i <= 2 then
				pointLight(glass, C.Lamp, 0.8, 16)
			end
			lampTops[i] = base + Vector3.new(0, 7.4, 0)
		end
		bunting(f, lampTops[1], lampTops[2], { C.Rose, C.Cream, C.Gold, rgb(120, 190, 235) }, 1.2)
		local down = Vector3.new(0, LAWN, 0)
		place(Props.FlowerBed(2), flatLook(at(-11.5, -19) - down, S - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
		place(Props.FlowerBed(4), flatLook(at(11.5, -19) - down, S - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
		local flies = anchorPart(f, "Fireflies", S + Vector3.new(0, 5, 0), Vector3.new(R * 1.5, 8, R * 1.5))
		emitter(flies, {
			Sprite = "Glow",
			Color = ColorSequence.new(rgb(255, 236, 150), rgb(190, 240, 170)),
			Rate = 5,
			Lifetime = NumberRange.new(5, 8),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Size = popSize(0.45),
		})
	end)
	if not okDecor then
		warn("[LobbyBuilder] shop decor failed: " .. tostring(errDecor))
	end
	return { Roulettes = roulettes, ItemShop = stall, Counter = counter }
end

-- Last-resort shop: plain machines and the Trove's counter with their PromptParts, so pets stay purchasable.
local function fallbackShop(root, L)
	local f = newFolder(root, "ShopFallback")
	local S = L.ShopCenter
	box(f, "ShopTop", CFrame.new(S - Vector3.new(0, 1, 0)), Vector3.new(L.ShopR * 2, 2, L.ShopR * 2), C.Cloud, { Collide = true })
	local neckA = polar(L.ShopAngle, PLAZA_R - 4, TOP)
	local neckB = polar(L.ShopAngle, L.ShopDist - L.ShopR + 5, TOP)
	local mid = (neckA + neckB) * 0.5
	box(f, "ShopNeck", flatLook(mid, neckB) * CFrame.new(0, -0.8, 0), Vector3.new(14, 1.2, (neckB - neckA).Magnitude), C.Stone, { Collide = true })
	local roulettes = {}
	local count = #Config.Roulettes
	for i, roulette in ipairs(Config.Roulettes) do
		local pos = S + Vector3.new((i - (count + 1) / 2) * 12, 0, -12)
		roulettes[roulette.Id] = fallbackMachine(f, flatLook(pos, S), roulette)
	end
	-- lobby shop (spec 5.9): the fallback trove at the plaza spot too, so there is only ever one trove, on the plaza
	local stall = fallbackTrove(f, L.TroveCF or flatLook(S + Vector3.new(0, 0, 12), S))
	-- lobby shop 16.3 (Task 23): a plain counter at the end of the machines' row carries the walk-up Shop prompt's part
	local counterCF = flatLook(S + Vector3.new((count + 1) / 2 * 12, 0, -12), S)
	local counter = newModel(f, "ShopCounter")
	local desk = box(counter, "Counter", counterCF * CFrame.new(0, 1.7, 0), Vector3.new(6, 3.4, 3.2), C.Plank, { Collide = true })
	local promptPart = box(counter, "PromptPart", counterCF * CFrame.new(0, 2, -5.6), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	return { Roulettes = roulettes, ItemShop = stall, Counter = { PromptPart = promptPart, Center = desk.Position, Model = counter } }
end

----------------------------------------------------------------------
-- Home plots (one per spot) and the ring street
----------------------------------------------------------------------

-- Local positions inside a plot (studs; origin = yard centre on the ground, -Z = gate / street side).
local PLOT_POS = {
	Gate = -G.PlotHalf,
	Mailbox = Vector3.new(-11, 0, -G.PlotHalf - 2),
	Podium = Vector3.new(G.PlotHalf - 12, 0, -G.PlotHalf + 10),
	Spawn = Vector3.new(0, 3, -12),
}

-- Everything every plot shares, built once in plot-local space and cloned per plot.
local function plotTemplate()
	return template("Plot", function()
		local m = Instance.new("Model")
		m.Name = "Plot"
		local half = G.PlotHalf
		local ix = G.IslandHalfX
		local front, back = G.IslandFront, G.IslandBack
		local depth = back - front
		local midZ = (back + front) / 2

		-- cloud island body (top 1.2 under the lawn): a puffy cushion, not a slab. Two flat tiers carry the lawn;
		-- overlapping billows bulge out along both sides and the back (a scalloped outline from above, round
		-- bumps from the side), a hanging cumulus of big lumps rounds the underside off, and a soft rim of
		-- small puffs rises from the outer margins (outside the fence; the yard, verge and street stay clear).
		local rng = Util.NewRng(SEED + 77)
		local puffs, rim = {}, {}
		local sideZ0, sideZ1 = front + 12, back - 8
		for _, sx in ipairs({ -1, 1 }) do
			for i = 0, 3 do
				local z = sideZ0 + i * (sideZ1 - sideZ0) / 3 + rng:Float(-3, 3)
				puffs[#puffs + 1] = { sx * (ix + rng:Float(1, 3)), rng:Float(-5, -3.5), z, rng:Float(8, 10), rng:Float(5.5, 7), rng:Float(10, 12.5) }
			end
			rim[#rim + 1] = { sx * (ix - 1), 0, rng:Float(-12, -4), 6, 4, 8 }
		end
		for i = 0, 2 do
			local x = -ix + 12 + i * (2 * ix - 24) / 2 + rng:Float(-3, 3)
			puffs[#puffs + 1] = { x, rng:Float(-5, -3.5), back + rng:Float(1, 3), rng:Float(12, 14), rng:Float(5.5, 7), rng:Float(8, 10) }
		end
		rim[#rim + 1] = { -ix + 2, 0, back - 1, 10, 6.5, 10 }
		rim[#rim + 1] = { ix - 2, 0, back - 1, 10, 6.5, 10 }
		-- the hanging underside (studs below the top of the cloud)
		local hang = {
			{ 0, -10, midZ, ix * 0.95, 7.5, depth * 0.48 },
			{ ix * 0.1, -15, midZ, 20, 6.5, 22 },
		}
		for _, h in ipairs(hang) do
			puffs[#puffs + 1] = h
		end
		-- 6-stud voxels: the island is cloned 16 times, so its body must stay cheap (~56 parts)
		VX.CloudModel({
			V = 6,
			Tiers = {
				{ SX = ix * 2 + 4, SZ = depth + 4, Z = midZ, Round = 10, H = 1 },
			},
			Puffs = puffs,
			Rim = rim,
			-- nothing may rise above the yard, the verge or the street
			Carve = function(x, y, z)
				return y > 0 and ((math.abs(x) < G.PlotHalf + 1.5 and z < G.PlotHalf + 1.5 and z > -G.PlotHalf - G.Verge - 1) or (z <= -G.PlotHalf - G.Verge - 1 and z > front - 3 and math.abs(x) < ix + 6))
			end,
			MaxParts = 80,
			Seed = 9,
		}, CFrame.new(0, -1.2, 0), m, "Island", true)

		-- mowed lawn stripes in the yard + darker margins and verge (all flush at the walking height)
		local stripeW = PLOT / 6
		for i = 1, 6 do
			local z = -half + (i - 0.5) * stripeW
			box(m, "Yard", CFrame.new(0, -0.5, z), Vector3.new(PLOT, 1, stripeW), (i % 2 == 0) and C.GrassLight or C.Grass, { Collide = true, Shadow = false })
		end
		local verge = G.Verge
		box(m, "Margin", CFrame.new(-(half + ix) / 2, -0.5, (back + (-half - verge)) / 2), Vector3.new(ix - half, 1, back + half + verge), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Margin", CFrame.new((half + ix) / 2, -0.5, (back + (-half - verge)) / 2), Vector3.new(ix - half, 1, back + half + verge), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Margin", CFrame.new(0, -0.5, (back + half) / 2), Vector3.new(PLOT, 1, back - half), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Verge", CFrame.new(0, -0.5, -half - verge / 2), Vector3.new(PLOT, 1, verge), C.GrassDark, { Collide = true, Shadow = false })
		-- stepping stones from the gate into the yard
		for i, z in ipairs({ -half + 2.5, -half + 6.5, -half + 10.5 }) do
			box(m, "SteppingStone", CFrame.new((i % 2 == 0) and 0.6 or -0.4, 0.05, z), Vector3.new(4, 0.1, 2.6), C.StoneLight, { Collide = true, Shadow = false })
		end

		-- the street in front: stone slabs in two shades with darker curbs
		local sw = G.StreetW
		local slabs = 4
		local slabLen = (ix * 2) / slabs
		for i = 1, slabs do
			local x = -ix + (i - 0.5) * slabLen
			box(m, "Street", CFrame.new(x, -0.5, G.StreetZ), Vector3.new(slabLen, 1, sw - 3), (i % 2 == 0) and C.StoneLight or C.Stone, { Collide = true, Shadow = false })
		end
		for _, s in ipairs({ -1, 1 }) do
			box(m, "Curb", CFrame.new(0, -0.5, G.StreetZ + s * (sw / 2 - 0.75)), Vector3.new(ix * 2, 1, 1.5), C.StoneDark, { Collide = true, Shadow = false })
		end
		-- low hedge along the plaza side of the street (keeps walkers from stepping off the island)
		box(m, "Hedge", CFrame.new(0, 0.9, front - 0.9), Vector3.new(ix * 2, 1.8, 1.8), C.Hedge, { Collide = true })
		box(m, "HedgeTop", CFrame.new(0, 1.9, front - 0.9), Vector3.new(ix * 2 - 1, 0.4, 1.3), C.HedgeLight)

		-- fence posts + rails around the yard, open at the gate
		local postSpots = {}
		for _, x in ipairs({ -half, -half / 3, half / 3, half }) do
			postSpots[#postSpots + 1] = { x, half }
		end
		for _, z in ipairs({ -half / 3, half / 3 }) do
			postSpots[#postSpots + 1] = { -half, z }
			postSpots[#postSpots + 1] = { half, z }
		end
		postSpots[#postSpots + 1] = { -half, -half }
		postSpots[#postSpots + 1] = { half, -half }
		for _, p in ipairs(postSpots) do
			box(m, "FencePost", CFrame.new(p[1], 1.5, p[2]), Vector3.new(1, 3, 1), C.PlankDark, { Collide = true })
		end
		for _, y in ipairs({ 2.3 }) do
			box(m, "FenceRail", CFrame.new(0, y, half), Vector3.new(PLOT, 0.35, 0.35), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(-half, y, 0), Vector3.new(0.35, 0.35, PLOT), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(half, y, 0), Vector3.new(0.35, 0.35, PLOT), C.Plank, { Collide = true })
			local seg = half - 8
			box(m, "FenceRail", CFrame.new(-half + seg / 2, y, -half), Vector3.new(seg, 0.35, 0.35), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(half - seg / 2, y, -half), Vector3.new(seg, 0.35, 0.35), C.Plank, { Collide = true })
		end

		-- the gate: stone pillars with lanterns, a beam across
		for _, s in ipairs({ -1, 1 }) do
			box(m, "GateBase", CFrame.new(s * 7.2, 0.5, -half), Vector3.new(2.6, 1, 2.6), C.StoneDark, { Collide = true })
			box(m, "GatePillar", CFrame.new(s * 7.2, 4, -half), Vector3.new(2, 6, 2), C.StoneLight, { Collide = true })
			box(m, "GateCap", CFrame.new(s * 7.2, 7.3, -half), Vector3.new(2.6, 0.6, 2.6), C.Stone)
			box(m, "GateLantern", CFrame.new(s * 7.2, 8.1, -half), Vector3.new(1, 1, 1), C.Lamp, { Material = MAT.Neon })
		end
		box(m, "GateBeam", CFrame.new(0, 6.6, -half), Vector3.new(13.4, 0.8, 1), C.PlankDark)

		-- mailbox (the nameplate floats above it); the gate lanterns light the street
		local mb = PLOT_POS.Mailbox
		box(m, "MailPost", CFrame.new(mb.X, 1.5, mb.Z), Vector3.new(0.5, 3, 0.5), C.PlankDark, { Collide = true })
		box(m, "MailBox", CFrame.new(mb.X, 3.4, mb.Z), Vector3.new(1.4, 1.2, 2.2), C.IronLight)

		-- pet podium: stepped stone with a band in the plot accent (recoloured per plot)
		local pod = Instance.new("Model")
		pod.Name = "Podium"
		local pp = PLOT_POS.Podium
		box(pod, "PodiumBase", CFrame.new(pp + Vector3.new(0, 0.5, 0)), Vector3.new(6, 1, 6), C.StoneDark, { Collide = true })
		box(pod, "Accent", CFrame.new(pp + Vector3.new(0, 1.5, 0)), Vector3.new(4.4, 1, 4.4), C.Rose, { Collide = true })
		box(pod, "PodiumTop", CFrame.new(pp + Vector3.new(0, 2.5, 0)), Vector3.new(5.2, 1, 5.2), C.StoneLight, { Collide = true })
		pod.Parent = m
		return m
	end)
end

-- "No. 7" on both faces of the plot's gate sign: 220 x 90 px, the number 1.12 studs tall. (kit B: THE GATES face's stone
-- panel, a 4 px wood edge, its 6 px lip in the plot's colour, the number in ink; the rounded navy gradient plate went)
local function numberSign(sign, index, accent)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = surfaceGui(sign, face)
		local plate = signPanel(gui, WorldTag.LipOf(accent), 4, 6)
		plate.Name = "Plate"
		signText(plate, "No. " .. tostring(index), "Title", SIGN_TITLE, KIT.Sign.Text, "Number", 0.05, 0, 0.9, 0.88)
		gui.Parent = sign
	end
end

-- Home nameplate over the mailbox (World text rule): a compact pixel tag, readable from ~80 studs. (Pitch 2 item 04 B
-- "Stone tags", modelled on the NPC card: the rounded navy gradient capsule and the round disc went) ONE stone card (a 3 px
-- mitred wood edge, a 5 px lip in the plot's colour, WorldTag.LipOf); left: a square avatar well with a mitred wood edge
-- (MenuController's icon well), the plot number a small gold block on its lower-left corner (WorldTag.Bang's block);
-- right: the name (Nameplate role, 28 px) over the info line (20 px) in the kit's ink. The card is sized from the measured
-- texts and laid out again whenever SpotService writes them. The well holds
--   Headshot    ImageLabel: SpotService loads the owner's headshot into it (Players:GetUserThumbnailAsync), square-cropped
--   Silhouette  the fallback built from square frames (head + shoulders) while no headshot is available
--   FreeIcon    a "+" shown while the home is free
-- and the attributes OwnedColor / FreeColor (the well's colour per state, read by SpotService).
-- Returns gui, nameLabel, subLabel.
local NP = {
	Avatar = 60, -- the well (its 3 px edge outside)
	WellEdge = 3,
	Pad = 9, -- px from the face's left / top to the well
	Gap = 14, -- px from the well to the texts
	PadR = 16,
	FaceH = 83, -- 9 + the 60 px well + 9, the 5 px lip
	NameY = 8,
	NameH = 32,
	SubY = 41,
	SubH = 26,
	MinW = 230, -- the card's least face width (as the old plate's)
	Badge = 26, -- the number block's height (its 2 px edge outside, a 4 px gold lip)
	BadgePad = 6,
	BadgeOut = 6, -- px it reaches past the well's left and bottom
}

local function avatarDisc(parent, index, accent)
	local holder = plainFrame(parent, "AvatarHolder", {
		Position = UDim2.fromOffset(NP.Pad, NP.Pad),
		Size = UDim2.fromOffset(NP.Avatar, NP.Avatar),
		ZIndex = 3,
	})
	local freeColor = KIT.Sign.Grass
	local ownedColor = accent:Lerp(C.Cloud, 0.45)
	local disc = plainFrame(holder, "Avatar", { Size = UDim2.fromScale(1, 1), ZIndex = 3 })
	WorldTag.Block(disc, freeColor, nil, KIT.Sign.Wood, NP.WellEdge, 0) -- a well: the edge, no lip
	disc:SetAttribute("OwnedColor", ownedColor)
	disc:SetAttribute("FreeColor", freeColor)

	-- fallback avatar: a square head over square shoulders in a deeper shade of the plot colour
	local shade = Theme.Darken and Theme.Darken(accent, 0.38) or accent:Lerp(C.Ink, 0.38)
	local silhouette = plainFrame(disc, "Silhouette", { Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4 })
	plainFrame(silhouette, "Head", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = shade,
		BackgroundTransparency = 0,
		ZIndex = 4,
	})
	plainFrame(silhouette, "Shoulders", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(38, 22),
		BackgroundColor3 = shade,
		BackgroundTransparency = 0,
		ZIndex = 4,
	})

	-- free home: a chunky square "+" in the ink that reads on the grass well
	local plus = plainFrame(disc, "FreeIcon", { Size = UDim2.fromScale(1, 1), ZIndex = 4 })
	for _, size in ipairs({ Vector2.new(30, 9), Vector2.new(9, 30) }) do
		plainFrame(plus, "Bar", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size.X, size.Y),
			BackgroundColor3 = KIT.Sign.OnGrass,
			BackgroundTransparency = 0,
			ZIndex = 4,
		})
	end

	local shot = Instance.new("ImageLabel")
	shot.Name = "Headshot"
	shot.Size = UDim2.fromScale(1, 1)
	shot.BackgroundTransparency = 1
	shot.BorderSizePixel = 0
	shot.Image = ""
	shot.ScaleType = Enum.ScaleType.Crop -- square-cropped
	shot.Visible = false
	shot.ZIndex = 4
	shot.Parent = disc

	-- the plot number: a small gold block (WorldTag.Bang's) pinned on the well's lower-left corner
	local badge = plainFrame(holder, "NumberBadge", { ZIndex = 5 })
	WorldTag.Block(badge, KIT.Sign.Gold, KIT.Sign.GoldLip, KIT.Sign.Wood, 2, 4)
	local number = tagText(badge, "Number", "#" .. tostring(index), "Display", TAG_SMALL, KIT.Sign.Text, 1)
	number.ZIndex = 6
	local w = KIT.LineSize(number)
	badge.AnchorPoint = Vector2.new(0, 1)
	badge.Position = UDim2.new(0, -NP.BadgeOut, 1, NP.BadgeOut)
	badge.Size = UDim2.fromOffset(w + 2 * NP.BadgePad, NP.Badge)
	number.Position = UDim2.fromOffset(0, 0)
	number.Size = UDim2.new(1, 0, 1, -4)
	number.TextXAlignment = Enum.TextXAlignment.Center
	return holder
end

local function homeNameplate(anchor, index, accent)
	-- bottom edge 7.2 studs up: a few studs over the mailbox, under the gate lanterns' glow
	local gui = newTag(anchor, "Nameplate", 460, 110, -2.4, 100)
	local plate = tagPlate(gui, accent, NP.MinW)
	plate.Size = UDim2.fromOffset(NP.MinW, NP.FaceH)
	avatarDisc(plate, index, accent)
	local textX = NP.Pad + NP.Avatar + NP.Gap
	local texts = plainFrame(plate, "Texts", { Position = UDim2.fromOffset(textX, 0), Size = UDim2.new(0, 0, 1, -KIT.Lip), ZIndex = 3 })
	local nameLabel = tagText(texts, "NameLabel", "Free home", "Nameplate", TAG_NAME, KIT.Sign.Text, 1) -- (kit-b U6) a player's name keeps its case
	local subLabel = tagText(texts, "SubLabel", "Step in to claim", "Body", TAG_INFO, KIT.Sign.TextMuted, 2)
	nameLabel.Position = UDim2.fromOffset(0, NP.NameY)
	subLabel.Position = UDim2.fromOffset(0, NP.SubY)
	for _, l in ipairs({ nameLabel, subLabel }) do
		l.TextXAlignment = Enum.TextXAlignment.Left
	end
	-- the card as wide as the longer line needs (never under MinW), laid out again whenever SpotService writes a line
	local function layout()
		local nw = KIT.LineSize(nameLabel)
		local sw = KIT.LineSize(subLabel)
		local textW = math.max(nw, sw)
		nameLabel.Size = UDim2.fromOffset(textW, NP.NameH)
		subLabel.Size = UDim2.fromOffset(textW, NP.SubH)
		texts.Size = UDim2.new(0, textW, 1, -KIT.Lip)
		plate.Size = UDim2.fromOffset(math.max(NP.MinW, textX + textW + NP.PadR), NP.FaceH)
	end
	nameLabel:GetPropertyChangedSignal("Text"):Connect(layout)
	subLabel:GetPropertyChangedSignal("Text"):Connect(layout)
	layout()
	return gui, nameLabel, subLabel
end

local function buildSpot(parent, index, angle)
	local accent = ACCENTS[(index - 1) % #ACCENTS + 1]
	local f = newFolder(parent, string.format("Spot_%02d", index))
	f:SetAttribute("SpotIndex", index)
	local centre = polar(angle, SPOT_R, TOP)
	local plotCF = faceCentre(centre) -- LookVector = towards the gate / street / plaza
	local function at(v)
		return plotCF * CFrame.new(v)
	end

	local plot = place(plotTemplate(), plotCF, f, "Plot")
	if plot then
		-- the podium trim takes the plot accent
		local podium = plot:FindFirstChild("Podium")
		if podium then
			for _, d in ipairs(podium:GetChildren()) do
				if d:IsA("BasePart") and d.Name == "Accent" then
					d.Color = accent
				end
			end
		end
	else
		-- plain stand-in (template failed): a lawn slab so the spot stays usable
		box(f, "Yard", plotCF * CFrame.new(0, -0.5, -9), Vector3.new(PLOT + 12, 1, PLOT + 30), C.Grass, { Collide = true })
	end

	-- per-plot accents: banner pennants on the gate beam, mailbox flag, number sign
	for _, s in ipairs({ -1, 1 }) do
		box(f, "GateBanner", at(Vector3.new(s * 5.4, 5.4, PLOT_POS.Gate - 0.6)), Vector3.new(1.6, 2, 0.15), accent, { Shadow = false })
	end
	local mb = PLOT_POS.Mailbox
	box(f, "MailFlag", at(Vector3.new(mb.X + 0.77, 4.2, mb.Z + 0.4)), Vector3.new(0.15, 1, 0.8), accent, { Shadow = false })
	local sign = box(f, "NumberSign", at(Vector3.new(0, 7.9, PLOT_POS.Gate)), Vector3.new(4.4, 1.8, 0.5), C.Plank)
	numberSign(sign, index, accent)

	-- nameplate over the mailbox
	local anchor = anchorPart(f, "NameplateAnchor", at(Vector3.new(mb.X, 9.6, mb.Z)).Position)
	local gui, nameLabel, subLabel = homeNameplate(anchor, index, accent)

	local podiumTop = at(PLOT_POS.Podium + Vector3.new(0, 3, 0)).Position
	local spawnPos = at(PLOT_POS.Spawn).Position
	return {
		Index = index,
		Folder = f,
		Center = centre,
		SpawnCFrame = flatLook(spawnPos, centre + Vector3.new(0, 3, 0) + plotCF.LookVector * -30),
		NameLabel = nameLabel,
		SubLabel = subLabel,
		Nameplate = gui,
		PodiumCFrame = flatLook(podiumTop, podiumTop + plotCF.LookVector),
		PlotCFrame = plotCF,
		PlotSize = PLOT,
		GateCFrame = at(Vector3.new(0, 0, PLOT_POS.Gate)),
		Accent = accent,
	}
end

-- Bare-minimum spot (see fallbackPortal): a lawn slab, a podium and the two labels.
local function fallbackSpot(parent, index, angle)
	local old = parent:FindFirstChild(string.format("Spot_%02d", index))
	if old then
		old:Destroy()
	end
	local f = newFolder(parent, string.format("Spot_%02d", index))
	f:SetAttribute("SpotIndex", index)
	local centre = polar(angle, SPOT_R, TOP)
	local plotCF = faceCentre(centre)
	box(f, "Yard", plotCF * CFrame.new(0, -0.5, -9), Vector3.new(PLOT + 12, 1, PLOT + 30), C.Grass, { Collide = true })
	box(f, "PodiumBase", plotCF * CFrame.new(PLOT_POS.Podium + Vector3.new(0, 1.5, 0)), Vector3.new(5, 3, 5), C.Stone, { Collide = true })
	local anchor = anchorPart(f, "NameplateAnchor", (plotCF * CFrame.new(PLOT_POS.Mailbox + Vector3.new(0, 9.6, 0))).Position)
	local gui, nameLabel, subLabel = homeNameplate(anchor, index, C.TextGold)
	local podiumTop = (plotCF * CFrame.new(PLOT_POS.Podium + Vector3.new(0, 3, 0))).Position
	local spawnPos = (plotCF * CFrame.new(PLOT_POS.Spawn)).Position
	return {
		Index = index,
		Folder = f,
		Center = centre,
		SpawnCFrame = flatLook(spawnPos, centre + Vector3.new(0, 3, 0) + plotCF.LookVector * -30),
		NameLabel = nameLabel,
		SubLabel = subLabel,
		Nameplate = gui,
		PodiumCFrame = flatLook(podiumTop, podiumTop + plotCF.LookVector),
		PlotCFrame = plotCF,
		PlotSize = PLOT,
		GateCFrame = plotCF * CFrame.new(0, 0, PLOT_POS.Gate),
		Accent = C.TextGold,
	}
end

-- Rope rail with end posts along a straight edge (a, b = ground points).
local function rail(parent, a, b, height)
	height = height or 2.8
	local m = newModel(parent, "Rail")
	local dir = b - a
	local len = dir.Magnitude
	if len < 1 then
		return m
	end
	local posts = math.max(2, math.floor(len / 30) + 1)
	for i = 0, posts - 1 do
		local p = a + dir * (i / (posts - 1))
		box(m, "RailPost", CFrame.new(p + Vector3.new(0, height / 2, 0)), Vector3.new(0.6, height, 0.6), C.PlankDark, { Collide = true })
	end
	local mid = (a + b) * 0.5 + Vector3.new(0, height - 0.4, 0)
	box(m, "RailRope", CFrame.lookAt(mid, mid + dir), Vector3.new(0.3, 0.3, len), C.Plank, { Collide = true, Shadow = false })
	return m
end

-- A wooden bridge between two ground points (deck top `topOffset` below TOP): longitudinal planks, edge
-- beams, rope rails on both sides (open ends) and optional cloud puffs underneath.
local function woodBridge(parent, name, a, b, width, opts)
	opts = opts or {}
	local m = newModel(parent, name)
	local topY = TOP + (opts.Top or -0.2)
	a = Vector3.new(a.X, topY, a.Z)
	b = Vector3.new(b.X, topY, b.Z)
	local dir = b - a
	local len = dir.Magnitude
	local cf = CFrame.lookAt((a + b) * 0.5, b)
	local planks = math.max(3, math.floor(width / 2 + 0.5))
	local pw = width / planks
	for i = 1, planks do
		local x = -width / 2 + (i - 0.5) * pw
		box(m, "Plank", cf * CFrame.new(x, -0.5, 0), Vector3.new(pw, 1, len), (i % 2 == 0) and C.PlankLight or C.Plank, { Collide = true, Shadow = len > 8 })
	end
	if opts.Rails ~= false then
		local insetA = opts.RailInsetA or opts.RailInset or 3
		local insetB = opts.RailInsetB or opts.RailInset or 3
		local right = cf.RightVector
		for _, s in ipairs({ -1, 1 }) do
			if not (opts.NoRail and opts.NoRail[s]) then
				local off = right * (s * (width / 2 - 0.3))
				local p0 = a + dir.Unit * insetA + off
				local p1 = b - dir.Unit * insetB + off
				rail(m, Vector3.new(p0.X, topY, p0.Z), Vector3.new(p1.X, topY, p1.Z))
			end
		end
	end
	for _, t in ipairs(opts.Puffs or {}) do
		-- the puff's highest voxels reach 3 studs over its anchor: anchored 4 under the deck top, it touches the
		-- underside of the 1-stud planks and nothing pokes through
		place(Props.Puff(opts.PuffSize or "M"), CFrame.new(a + dir * t - Vector3.new(0, 4, 0)) * CFrame.Angles(0, t * 7, 0), m, "BridgePuff")
	end
	if opts.MeshKey then -- Phase 6 (LayoutSig); the puff under it is dressed on its own (its parts are kept)
		Mesh.tag(m, opts.MeshKey, cf, nil, Mesh.CloudParts)
	end
	return m
end

-- Ring street junctions (plank bridges between neighbouring plots), spoke bridges and garden bridges.
local function buildRoads(root, L)
	local f = newFolder(root, "Roads")
	local ext = G.JunctionX + G.StreetExt
	local ix = G.IslandHalfX
	local sw = G.StreetW
	for j, info in ipairs(L.Junctions) do
		local a = info.Angle
		local open = info.Spoke or info.Garden or info.Altar -- something docks on the plaza side here
		local jf = newModel(f, string.format("Junction_%02d", j))
		-- half A belongs to the plot before the junction (its local -X side), half B to the plot after it
		for half = 1, 2 do
			local plotAngle = (half == 1) and (a - G.HalfStep) or (a + G.HalfStep)
			local plotCF = faceCentre(polar(plotAngle, SPOT_R, TOP))
			local s = (half == 1) and -1 or 1
			local lift = (half == 1) and 0 or -0.1 -- the halves overlap at the junction: never coplanar
			local x0, x1 = s * ix, s * ext
			local len = math.abs(x1 - x0)
			local count = math.max(2, math.floor(len / 4 + 0.5))
			local pw = len / count
			for i = 1, count do
				local x = x0 + s * (i - 0.5) * pw
				box(jf, "Plank", plotCF * CFrame.new(x, -0.5 + lift, G.StreetZ), Vector3.new(pw, 1, sw), (i % 2 == 0) and C.PlankLight or C.Plank, { Collide = true, Shadow = false })
			end
		end
		-- one straight rail per side across both halves: outer always, inner unless a bridge docks here
		local plotA = faceCentre(polar(a - G.HalfStep, SPOT_R, TOP))
		local plotB = faceCentre(polar(a + G.HalfStep, SPOT_R, TOP))
		local sides = { G.StreetZ + sw / 2 - 0.9 }
		if not open then
			sides[2] = G.StreetZ - sw / 2 + 0.9
		end
		for k, z in ipairs(sides) do
			local pA = (plotA * CFrame.new(-ix - 0.8, 0, z)).Position
			local pB = (plotB * CFrame.new(ix + 0.8, 0, z)).Position
			if k == 1 and info.Arena then
				-- Phase 3: the outer rail opens around the junction's ray for the arena bridge (ArenaBuilder)
				local mid = (pA + pB) * 0.5
				local u = Vector3.new(pB.X - pA.X, 0, pB.Z - pA.Z).Unit
				local keep = G.ArenaBridgeW / 2 + 0.8
				local q0, q1 = mid - u * keep, mid + u * keep
				rail(jf, Vector3.new(pA.X, TOP, pA.Z), Vector3.new(q0.X, TOP, q0.Z))
				rail(jf, Vector3.new(q1.X, TOP, q1.Z), Vector3.new(pB.X, TOP, pB.Z))
			else
				rail(jf, Vector3.new(pA.X, TOP, pA.Z), Vector3.new(pB.X, TOP, pB.Z))
			end
		end
		if open then
			-- short inner rails on both sides of the docking bridge
			local zIn = G.StreetZ - sw / 2 + 0.9
			local dock = polar(a, G.StreetR / math.cos(math.rad(G.HalfStep)) - sw / 2, TOP)
			-- (the Storm Altar's bridge docks with a 14-stud entrance gate whose low walls close the gap)
			local keep = info.Altar and 7.6 or (((info.Spoke and G.SpokeW) or 8) / 2 + 0.8)
			for _, p in ipairs({ (plotA * CFrame.new(-ix - 0.8, 0, zIn)).Position, (plotB * CFrame.new(ix + 0.8, 0, zIn)).Position }) do
				local d = Vector3.new(dock.X - p.X, 0, dock.Z - p.Z)
				local len = d.Magnitude - keep
				if len > 1.5 then
					local q = p + d.Unit * len
					rail(jf, Vector3.new(p.X, TOP, p.Z), Vector3.new(q.X, TOP, q.Z))
				end
			end
		end
		-- Phase 6: one plank-deck mesh per junction kind (identical local geometry; LayoutSig)
		local kind = (info.Arena and "arena") or (info.Altar and "altar") or (info.Spoke and "spoke") or (info.Garden and "garden") or "plain"
		Mesh.tag(jf, "floor_junction_" .. kind, faceCentre(polar(a, G.StreetR, TOP)))
	end

	-- Spokes: plaza rim -> junction, over open sky, carried by cloud puffs.
	for _, a in ipairs(L.SpokeAngles) do
		local p0 = polar(a, PLAZA_R - 3, TOP)
		local p1 = polar(a, G.SpokeEndR, TOP)
		-- rails run from the plaza's cloud rim right up to the street edge (no open window over the sky)
		woodBridge(f, "Spoke", p0, p1, G.SpokeW, { Puffs = { 0.52 }, PuffSize = "S", RailInsetA = 6, RailInsetB = 2.6, MeshKey = "floor_spoke" })
	end
end

----------------------------------------------------------------------
-- Garden islands (hanging off the street) and the reserved Storm Altar site
----------------------------------------------------------------------

-- Five stacked ground layers around `centre` (2-stud cells). fn(x, z, r) -> l1, l2, l3, l4 (see plazaCell).
local function layeredGround(parent, centre, radius, fn, meshPrefix)
	local cell = 2
	local n = math.ceil(radius / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	for i = -n, n do
		for k = -n, n do
			local x, z = i * cell, k * cell
			local r = math.sqrt(x * x + z * z)
			if r <= radius - 0.5 then
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local keys = { fn(x, z, r) }
				for li = 1, 4 do
					if keys[li] then
						Voxel.Set(grids[li + 1], i, 0, k, keys[li])
					end
				end
			end
		end
	end
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	for li = 1, 5 do
		local layer = VX.Build(grids[li], { V = cell, Name = "Ground" .. li, CF = CFrame.new(centre.X, TOP + tops[li] - cell / 2, centre.Z), Collide = true, Shadow = false, Parent = parent })
		if layer and meshPrefix then
			Mesh.tag(layer, meshPrefix .. li, CFrame.new(centre.X, TOP, centre.Z)) -- Phase 6 (LayoutSig)
		end
	end
end

local function buildPond(parent, ground)
	local g = Voxel.NewGrid(14)
	VX.Ring(g, 0, 0, 5.2, 6.9, 0, 1, "Stone")
	VX.Disc(g, 0, 0, 5.3, -1, -1, "WaterDeep")
	VX.Disc(g, 0, 0, 5.3, 0, 0, "Water")
	for _, p in ipairs({ { -2, 1 }, { 2, -2 }, { 1, 3 } }) do
		Voxel.Set(g, p[1], 0, p[2], "Leaf")
		Voxel.Set(g, p[1] + 1, 0, p[2], "Leaf")
	end
	Voxel.Set(g, 1, 1, 3, "Blossom")
	Voxel.Set(g, -2, 1, 1, "BlossomWhite")
	local water = VX.Split(g, { Water = true })
	local cf = CFrame.new(ground.X, TOP + 0.1, ground.Z)
	local stone = VX.Build(g, { V = 1, Name = "PondStone", CF = cf, Collide = true, Parent = parent })
	local pondWater = VX.Build(water, { V = 1, Name = "PondWater", CF = cf, Collide = false, Parent = parent })
	-- Phase 6: the pond ring and its water
	local ground0 = CFrame.new(ground.X, TOP, ground.Z)
	if stone then
		Mesh.tag(stone, "prop_pond", ground0)
	end
	if pondWater then
		Mesh.tag(pondWater, "prop_pond_water", ground0)
	end
	local sparkle = anchorPart(parent, "PondSparkle", ground + Vector3.new(0, 1, 0), Vector3.new(9, 1, 9))
	emitter(sparkle, { Color = ColorSequence.new(rgb(200, 236, 255)), Rate = 3, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(0.2, 0.6), Size = popSize(0.5) })
end

local function buildGarden(parent, spec, L)
	local f = newFolder(parent, "Garden_" .. (spec.Name:gsub("%s", "")))
	local a = spec.Angle
	local c = polar(a, G.GardenR, TOP)
	local R = G.GardenSize
	local out = dirOf(a)
	local rng = Util.NewRng(SEED + 40 + math.floor(a))
	local cf = flatLook(c, c + out) -- local -Z = outwards (towards the street bridge)

	local rim, puffs = {}, {}
	for i = 1, 6 do
		local deg = (i - 1) * 60 + a + 180 + rng:Float(-6, 6)
		if angleDiff(deg, a) > 30 then
			local s = rng:Float(8, 9.5)
			rim[#rim + 1] = { math.cos(math.rad(deg)) * (R + 1.5), rng:Float(-1.5, 0), math.sin(math.rad(deg)) * (R + 1.5), s, s * 0.62, s }
		end
	end
	for i = 1, 3 do
		local ang = (i - 1) / 3 * math.pi * 2 + rng:Float(-0.3, 0.3)
		local s = rng:Float(7, 9)
		puffs[#puffs + 1] = { math.cos(ang) * (R - 5), -6, math.sin(ang) * (R - 5), s, s * 0.7, s }
	end
	local gardenKind = (spec.Kind == "Pond") and "pond" or "blossom"
	local gardenCloud = VX.CloudModel({
		V = 3,
		Tiers = { { R = R + 3, H = 1 }, { R = R - 3, H = 2 }, { R = R - 10, H = 2 }, { R = R - 16, H = 1 } },
		Puffs = puffs,
		Rim = rim,
		Carve = function(x, y, z)
			return y > 0 and (x * x + z * z) < (R - 3) * (R - 3)
		end,
		MaxParts = 46,
		Seed = 20 + math.floor(a),
	}, CFrame.new(c.X, TOP - 1.2, c.Z), f, "GardenCloud", true)
	if gardenCloud then
		Mesh.tag(gardenCloud, "cloud_garden_" .. gardenKind, CFrame.new(c.X, TOP - 1.2, c.Z)) -- Phase 6 (LayoutSig)
	end

	layeredGround(f, c, R, function(x, z, r)
		local l1, l2, l3
		local nz = vnoise(x + a, z - a, 18, 17)
		if nz < 0.26 then
			l1 = "GrassDark"
		elseif nz > 0.76 then
			l1 = "GrassLight"
		end
		local ring = math.abs(r - 10)
		local t = x * out.X + z * out.Z
		local d = math.abs(-x * out.Z + z * out.X)
		-- the border reaches 2.2 studs past the sand (more than one 2-stud cell), so the sand never ends flush
		-- with it on the grid
		local onPath = t >= 9 and d <= 4.4
		if ring <= 4.4 or onPath then
			l2 = "SandDark"
		end
		if ring <= 2.2 or (t >= 9 and d <= 2.2 and r <= R - 2.5) then
			l3 = "Sand"
		end
		if r > R - 3 then
			l1 = nil -- lawn only at the very edge
		end -- (bug #12: the rim's flat flower pixels became Meadow clumps)
		return l1, l2, l3, nil
	end, "floor_garden_" .. gardenKind .. "_")

	-- features
	local function localPos(deg, dist)
		-- deg measured from the outward direction
		return (cf * CFrame.Angles(0, math.rad(deg), 0) * CFrame.new(0, 0, -dist)).Position
	end
	local down = Vector3.new(0, LAWN, 0) -- props stand on the lawn layer
	if spec.Kind == "Pond" then
		buildPond(f, c)
		place(Props.Tree("Round"), CFrame.new(localPos(180, 16) - down) * CFrame.Angles(0, 1.3, 0), f, "RoundTree")
		place(Props.FlowerBed(6), flatLook(localPos(140, 16) - down, c - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
	else
		place(Props.Tree("Blossom"), CFrame.new(c - down) * CFrame.Angles(0, 0.7, 0), f, "BlossomTree")
		place(Props.FlowerBed(1), flatLook(localPos(180, 16) - down, c - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
	end
	for _, deg in ipairs({ 75, -75 }) do
		local p = localPos(deg, 15.5) - down
		place(Props.Bench(), flatLook(p, c - down), f, "Bench")
	end

	-- name tag + the bridge to the street junction
	local tag = anchorPart(f, "NameTag", c + Vector3.new(0, 22, 0))
	local gui = newTag(tag, "NameTag", 320, 80, -1.7, 120)
	local plate = tagPlate(gui, KIT.Sign.Grass, 160) -- (kit B) the stone card, a grass lip
	tagText(plate, "Text", spec.Name, "Title", TAG_NAME + 2, KIT.Sign.Text, 1)
	KIT.Done(plate)
	woodBridge(f, "GardenBridge", polar(a, G.GardenR + R - 3, TOP), polar(a, G.SpokeEndR, TOP), 8, { RailInsetA = 3, RailInsetB = 2.6, MeshKey = "floor_garden_bridge" })
	return f
end

----------------------------------------------------------------------
-- Sky: voxel cumulus around the village and one far below it (never collidable)
----------------------------------------------------------------------

-- kind: "Big" (96 studs) | "Small" (60 studs)
local function cumulus(kind)
	return template("Sky" .. kind, function()
		local r = Util.NewRng(SEED + #kind * 13)
		local w = (kind == "Big") and 96 or 60
		local rim = {}
		local n = 5
		for i = 1, n do
			local x = (i - (n + 1) / 2) / n * w * 0.9 + r:Float(-4, 4)
			local s = r:Float(0.16, 0.24) * w
			rim[#rim + 1] = { x, r:Float(0, 6), r:Float(-w * 0.12, w * 0.12), s, s * 0.8, s * 0.9 }
		end
		rim[#rim + 1] = { r:Float(-6, 6), w * 0.18, 0, w * 0.22, w * 0.2, w * 0.2 }
		local spec = {
			V = 6,
			Tiers = { { SX = w, SZ = w * 0.55, Round = w * 0.2, H = 1, Key = "Mist" } },
			Rim = rim,
			MaxParts = 32,
			Seed = #kind,
		}
		return VX.CloudModel(spec, CFrame.new(), nil, "SkyCloud", false)
	end)
end

local function buildSky(root)
	local f = newFolder(root, "Sky")
	local rng = Util.NewRng(SEED + 5)
	local count = 3
	for i = 1, count do
		local ang = (i - 1) * (360 / count) + rng:Float(-14, 14) + 20
		local dist = rng:Float(430, 620)
		local y = TOP + rng:Float(-40, 80)
		local kind = (i == 2) and "Small" or "Big"
		local pos = polar(ang, dist, y)
		place(cumulus(kind), CFrame.new(pos) * CFrame.Angles(0, math.rad(rng:Float(0, 360)), 0), f, "SkyCloud")
	end
	-- far below: one big puffy cumulus (depth under the village), not a flat sheet
	place(cumulus("Big"), CFrame.new(polar(rng:Float(40, 80), rng:Float(200, 320), TOP - rng:Float(130, 160))) * CFrame.Angles(0, math.rad(rng:Float(0, 360)), 0), f, "CloudSea")
	local dust = anchorPart(f, "SkyDust", Vector3.new(OX, TOP + 24, OZ), Vector3.new(560, 90, 560))
	emitter(dust, {
		Color = ColorSequence.new(rgb(255, 236, 200), rgb(200, 220, 255)),
		Rate = 14,
		Lifetime = NumberRange.new(8, 12),
		Speed = NumberRange.new(0.3, 1.2),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.8),
	})
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

local function section(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[LobbyBuilder] section '" .. name .. "' failed: " .. tostring(err))
	end
	return ok
end

-- Six spots on the plaza lawn when the decor pass could not compute them.
local function defaultNpcSpots(L)
	local spots = {}
	local plan = { 22.5, 157.5, L.ShopAngle - 30, L.ShopAngle + 30, L.ShopAngle - 60, L.ShopAngle + 60 }
	for _, a in ipairs(plan) do
		local pos = polar(a, 58, TOP)
		spots[#spots + 1] = faceCentre(pos)
	end
	return spots
end

----------------------------------------------------------------------
-- Bug #12 "Wind-Sown Sky Meadow" (the player's pick, option B; note: "make sure the grass/flowers quality is high and
-- the animation is smooth"). Up here the wind never stops: the outer lawns go wild (tufts leaning downwind, grass gone
-- to seed, wildflowers, cornflowers, dandelions), the settlers still mow the inner lawns (short tufts, clover, daisies),
-- and a sack of flower seed torn open against a flower bed sends a trail of the bed's own two colours downwind.
--
-- The SERVER only decides where things grow; it builds no grass parts (the lobby is at ~7.5k of its 8k-part budget):
--   * it reads the built ground itself (every lawn / patch / path / prop part in the lobby, rasterised on a 1-stud
--     grid per area), so a clump can never sit on a path, under a tree's roots, a lamp, a bench, a flower bed, the
--     fountain, an NPC spot or past the rim, whatever the layout becomes; grass thins out near every edge
--     (MEADOW.Edge / Thin);
--   * it scatters clumps on a jittered 2-stud grid AFTER all of that exists (the old flat squares were picked before
--     the props reserved their spots: the pink square under the tree in the bug screenshot);
--   * it publishes the result as compact strings on workspace.NimbusLobby.Meadow (attributes Clumps1..N: 9 chars
--     per clump) + Wind / Base / Kinds / Tint1..6; clients (MeadowFx) grow the clumps locally from the Blender keys
--     (meadow_*) or plain-part stand-ins, thin them with distance and sway them in rolling gusts;
--   * the torn seed sacks are a small Part build + Mesh.tag "prop_seedsack" (Detail decor), and a few invisible
--     emitter boxes let dandelion seeds drift downwind over the wild lawns (NC_Detail: Low graphics parks them).
----------------------------------------------------------------------
-- (built inside its own function: its helpers stay out of this chunk's local-variable budget)
local Meadow = (function()
	local Meadow = {}
	local MEADOW = {
		Version = 1,
		-- the lobby's prevailing wind (from the west-south-west): every blade leans along it, the gusts roll along it
		Wind = Vector3.new(0.96, 0, 0.28).Unit,
		-- clump kinds: index (1-based) -> mesh key (the encoding stores index - 1)
		Kinds = { "meadow_tuft_tall", "meadow_tuft_short", "meadow_tuft_seed", "meadow_sprig", "meadow_flowers",
			"meadow_cornflower", "meadow_dandelion", "meadow_clover" },
		Cell = 1.7, -- candidate grid: at most one clump per 1.7 x 1.7-stud cell, jittered inside it
		Edge = 1.1, -- no clump closer than this to a path, a prop, an NPC spot or the rim (studs)
		Thin = 2.6, -- ... and up to this distance only short ones, sparser (paths and pets stay easy to read)
		Pad = 0.35, -- props (anything standing on the lawn) are grown by this before the distance test
		Density = { wild = 0.9, mown = 0.48, garden = 0.4 }, -- mown 0.34 -> 0.48 after the final review (the inner lawns read bare)
		-- weights per zone, in Kinds order (tall, short, seed, sprig, flowers, cornflower, dandelion, clover)
		Mix = {
			wild = { 22, 22, 10, 26, 8, 5, 5, 2 },
			mown = { 0, 34, 0, 20, 20, 0, 6, 20 }, -- more short tufts + daisies (they read from afar), fewer sprigs
			garden = { 14, 26, 0, 18, 22, 5, 4, 11 },
			edge = { 0, 30, 0, 50, 0, 0, 0, 20 },
		},
		-- wildflower tints (index into FLOWERS): wild meadow pink / yellow / white, mown lawn white daisies, gardens any
		WildTints = { 1, 1, 1, 2, 2, 2, 3, 3 },
		ChunkClumps = 450, -- clumps per attribute string (9 chars each: ~4 KB per attribute)
		Sacks = 2, -- plaza flower beds that get a torn seed sack (the best downwind runs)
		Sack = { W = 1.15, D = 0.85, H = 1.35, Lean = 0.22 }, -- blender/kit/props/lobby_meadow.py SACK
		Drift = { Length = 24, Width0 = 1.3, Spread = 0.3 },
		Seeds = { Sectors = 6, MinClocks = 6, Rate = 1.2 },
		Stats = nil, -- the last scatter's numbers (tests, the build log)
	}
	Meadow.K = MEADOW

	local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local B64I = {}
	for i = 1, #B64 do
		B64I[string.sub(B64, i, i)] = i - 1
	end

	local function b64(v, n)
		local out = {}
		for i = n, 1, -1 do
			local d = v % 64
			out[i] = string.sub(B64, d + 1, d + 1)
			v = (v - d) / 64
		end
		return table.concat(out)
	end

	-- one clump -> 9 chars: [kind*8 + tint] [x: 3] [z: 3] [yaw 0..63] [scale 0..15 + 16 * patch]; x / z relative to the
	-- lobby origin, 1/64 stud, +-2048
	function Meadow.encode(c)
		local qx = math.floor((c.X + 2048) * 64 + 0.5)
		local qz = math.floor((c.Z + 2048) * 64 + 0.5)
		qx = math.max(0, math.min(262143, qx))
		qz = math.max(0, math.min(262143, qz))
		local yaw = math.floor(((c.Yaw % (2 * math.pi)) / (2 * math.pi)) * 64 + 0.5) % 64
		local sc = math.max(0, math.min(15, math.floor((c.Scale - 0.7) / 0.04 + 0.5)))
		return b64((c.Kind - 1) * 8 + (c.Tint or 0), 1) .. b64(qx, 3) .. b64(qz, 3) .. b64(yaw, 1)
			.. b64(sc + (c.Patch and 16 or 0), 1)
	end

	function Meadow.decode(s, i)
		local function n(a, len)
			local v = 0
			for j = a, a + len - 1 do
				v = v * 64 + (B64I[string.sub(s, j, j)] or 0)
			end
			return v
		end
		local o = (i - 1) * 9 + 1
		local kt = n(o, 1)
		local tint = kt % 8
		local f = n(o + 8, 1)
		return {
			Kind = (kt - tint) / 8 + 1,
			Tint = tint,
			X = n(o + 1, 3) / 64 - 2048,
			Z = n(o + 4, 3) / 64 - 2048,
			Yaw = n(o + 7, 1) / 64 * 2 * math.pi,
			Scale = 0.7 + (f % 16) * 0.04,
			Patch = f >= 16,
		}
	end

	-- ground codes of a 1-stud grid: 0 nothing (sky), 1 lawn, 2 lawn patch (0.1 higher), 3 blocked (path, border, prop)
	local function areaGrid(cx, cz, R)
		local N = math.ceil(R) + 2
		return { CX = cx, CZ = cz, R = R, N = N, S = 2 * N, Code = {}, Dist = nil }
	end

	local function gridIndex(g, x, z)
		local i = math.floor(x - g.CX) + g.N
		local k = math.floor(z - g.CZ) + g.N
		if i < 0 or k < 0 or i >= g.S or k >= g.S then
			return nil
		end
		return i * g.S + k + 1
	end

	local function gridMark(g, x0, z0, x1, z1, code)
		local S, N = g.S, g.N
		local i0 = math.max(0, math.floor(x0 - g.CX) + N)
		local i1 = math.min(S - 1, math.floor(x1 - g.CX) + N)
		local k0 = math.max(0, math.floor(z0 - g.CZ) + N)
		local k1 = math.min(S - 1, math.floor(z1 - g.CZ) + N)
		local code_ = g.Code
		for i = i0, i1 do
			local base = i * S + 1
			for k = k0, k1 do
				local idx = base + k
				if (code_[idx] or 0) < code then
					code_[idx] = code
				end
			end
		end
	end

	local function gridCircle(g, x, z, r)
		gridMark(g, x - r, z - r, x + r, z + r, 3)
	end

	-- every visible part of the lobby that reaches into the area: lawn / patch / blocked
	local function rasterise(g, parts)
		local R = g.R + 2
		for _, p in ipairs(parts) do
			local pos, s, cf = p.Position, p.Size, p.CFrame
			local rx, ry, rz = cf.RightVector, cf.UpVector, cf.LookVector
			local ex = (math.abs(rx.X) * s.X + math.abs(ry.X) * s.Y + math.abs(rz.X) * s.Z) / 2
			local ey = (math.abs(rx.Y) * s.X + math.abs(ry.Y) * s.Y + math.abs(rz.Y) * s.Z) / 2
			local ez = (math.abs(rx.Z) * s.X + math.abs(ry.Z) * s.Y + math.abs(rz.Z) * s.Z) / 2
			if pos.X + ex >= g.CX - R and pos.X - ex <= g.CX + R and pos.Z + ez >= g.CZ - R and pos.Z - ez <= g.CZ + R then
				local top, bottom = pos.Y + ey, pos.Y - ey
				if top > TOP - LAWN - 0.05 and bottom < TOP + 2.5 then
					if top <= TOP - LAWN + 0.05 then
						-- the lawn layer: cells whose centre it covers (half-open, so neighbouring slabs never double up)
						gridMark(g, pos.X - ex + 0.5, pos.Z - ez + 0.5, pos.X + ex - 0.5, pos.Z + ez - 0.5, 1)
					elseif top <= TOP - LAWN + 0.15 then
						gridMark(g, pos.X - ex + 0.5, pos.Z - ez + 0.5, pos.X + ex - 0.5, pos.Z + ez - 0.5, 2)
					elseif top <= TOP + 0.15 then
						gridMark(g, pos.X - ex, pos.Z - ez, pos.X + ex, pos.Z + ez, 3) -- borders, paths, inlays
					else
						local pad = MEADOW.Pad -- anything standing on the lawn: trunks, roots, lamps, benches, beds...
						local aligned = math.abs(ry.Y) > 0.999 and (math.abs(rx.X) > 0.999 or math.abs(rx.Z) > 0.999)
						if aligned then
							gridMark(g, pos.X - ex - pad, pos.Z - ez - pad, pos.X + ex + pad, pos.Z + ez + pad, 3)
						else
							-- a turned prop: only the cells its own (padded) box covers, not its world bounding box
							local S, N, code = g.S, g.N, g.Code
							local hx, hy, hz = s.X / 2 + pad, s.Y / 2 + pad, s.Z / 2 + pad
							local i0 = math.max(0, math.floor(pos.X - ex - pad - g.CX) + N)
							local i1 = math.min(S - 1, math.floor(pos.X + ex + pad - g.CX) + N)
							local k0 = math.max(0, math.floor(pos.Z - ez - pad - g.CZ) + N)
							local k1 = math.min(S - 1, math.floor(pos.Z + ez + pad - g.CZ) + N)
							local yProbe = math.max(bottom, math.min(top, TOP - LAWN + 0.1))
							for i = i0, i1 do
								for k = k0, k1 do
									local q = cf:PointToObjectSpace(Vector3.new(g.CX + i - N + 0.5, yProbe, g.CZ + k - N + 0.5))
									if math.abs(q.X) <= hx and math.abs(q.Z) <= hz and math.abs(q.Y) <= hy then
										code[i * S + k + 1] = 3
									end
								end
							end
						end
					end
				end
			end
		end
	end

	-- distance (studs) from every cell to the nearest cell that is not lawn (chamfer 3-4 / 3)
	local function distances(g)
		local S, code = g.S, g.Code
		local D = {}
		local BIG = 1e6
		for idx = 1, S * S do
			local c = code[idx] or 0
			D[idx] = (c == 1 or c == 2) and BIG or 0
		end
		for i = 0, S - 1 do
			for k = 0, S - 1 do
				local idx = i * S + k + 1
				local d = D[idx]
				if d > 0 then
					if i > 0 then
						d = math.min(d, D[idx - S] + 3)
						if k > 0 then
							d = math.min(d, D[idx - S - 1] + 4)
						end
						if k < S - 1 then
							d = math.min(d, D[idx - S + 1] + 4)
						end
					else
						d = math.min(d, 3)
					end
					if k > 0 then
						d = math.min(d, D[idx - 1] + 3)
					else
						d = math.min(d, 3)
					end
					D[idx] = d
				end
			end
		end
		for i = S - 1, 0, -1 do
			for k = S - 1, 0, -1 do
				local idx = i * S + k + 1
				local d = D[idx]
				if d > 0 then
					if i < S - 1 then
						d = math.min(d, D[idx + S] + 3)
						if k > 0 then
							d = math.min(d, D[idx + S - 1] + 4)
						end
						if k < S - 1 then
							d = math.min(d, D[idx + S + 1] + 4)
						end
					else
						d = math.min(d, 3)
					end
					if k < S - 1 then
						d = math.min(d, D[idx + 1] + 3)
					else
						d = math.min(d, 3)
					end
					D[idx] = d
				end
			end
		end
		g.Dist = D
	end

	-- distance of a point to the nearest non-lawn cell (studs; the cell centre value, minus half a cell of slack)
	local function distAt(g, x, z)
		local idx = gridIndex(g, x, z)
		if not idx then
			return 0
		end
		return math.max(0, g.Dist[idx] / 3 - 0.5)
	end

	local function pick(weights, h)
		local total = 0
		for _, w in ipairs(weights) do
			total = total + w
		end
		local t = h * total
		for i, w in ipairs(weights) do
			t = t - w
			if t < 0 then
				return i
			end
		end
		return #weights
	end

	-- the lobby's parts once (visible ones only), shared by every area
	local function lobbyParts(root)
		local list = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 0.99 then
				list[#list + 1] = d
			end
		end
		return list
	end

	-- the seed sacks: at the plaza's flower beds whose downwind run over open lawn is longest; returns the comets
	local function buildSacks(root, g, decorParent)
		local beds = {}
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("Model") and d.Name == "FlowerBed" and d.Parent and d.Parent.Name == "LawnDecor" then
				beds[#beds + 1] = d
			end
		end
		table.sort(beds, function(a, b)
			local pa, pb = a:GetPivot().Position, b:GetPivot().Position
			return pa.X + pa.Z * 0.001 < pb.X + pb.Z * 0.001
		end)
		local w = MEADOW.Wind
		local up = Vector3.new(0, 1, 0)
		local options = {}
		for bi, bed in ipairs(beds) do
			local pivot = bed:GetPivot()
			-- the bed's half extents in its own frame (its parts)
			local hx, hz = 0, 0
			for _, p in ipairs(bed:GetDescendants()) do
				if p:IsA("BasePart") then
					local lp = pivot:PointToObjectSpace(p.Position)
					local ls = pivot:VectorToObjectSpace(p.CFrame:VectorToWorldSpace(p.Size))
					hx = math.max(hx, math.abs(lp.X) + math.abs(ls.X) / 2)
					hz = math.max(hz, math.abs(lp.Z) + math.abs(ls.Z) / 2)
				end
			end
			local v = tonumber((bed:GetAttribute("FlowerVariant"))) or (((bi - 1) % #FLOWERS) + 1)
			for _, side in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local nLocal = Vector3.new(side[1], 0, side[2])
				local n = pivot:VectorToWorldSpace(nLocal)
				n = Vector3.new(n.X, 0, n.Z).Unit
				local look = -n
				local right = look:Cross(up)
				if right:Dot(w) > 0.5 then
					local reach = (side[1] ~= 0) and hx or hz
					local along = (side[1] ~= 0) and hz or hx
					local footD = reach + MEADOW.Sack.D / 2 + 0.25
					-- the sack slumps at the downwind end of that side, its spill just past the bed's corner
					local tangent = right
					local offset = math.max(0, along + 0.8 - (MEADOW.Sack.W / 2 + 0.7)) -- the spill lands just past the corner
					local foot = pivot.Position + n * footD + tangent * offset
					local spill = foot + right * (MEADOW.Sack.W / 2 + 0.7)
					local okFoot = true
					for _, probe in ipairs({ foot, spill, foot - right * 0.5 }) do
						local idx = gridIndex(g, probe.X, probe.Z)
						local c = idx and g.Code[idx] or 0
						if c ~= 1 and c ~= 2 then
							okFoot = false
						end
					end
					if okFoot then
						local run = 0
						for t = 1, MEADOW.Drift.Length do
							local q = spill + w * t
							local idx = gridIndex(g, q.X, q.Z)
							local c = idx and g.Code[idx] or 0
							if c ~= 1 and c ~= 2 then
								break
							end
							run = t
						end
						local score = run + right:Dot(w) * 4
						options[#options + 1] = { Bed = bed, Score = score, Foot = foot, Look = look, Spill = spill,
							Variant = v, Patch = (g.Code[gridIndex(g, foot.X, foot.Z)] == 2) }
					end
				end
			end
		end
		table.sort(options, function(a, b)
			if math.abs(a.Score - b.Score) > 1e-6 then
				return a.Score > b.Score
			end
			return a.Foot.X < b.Foot.X
		end)
		local comets, used = {}, {}
		local S = MEADOW.Sack
		local burlap, burlapDark, seed, twine = rgb(206, 178, 128), rgb(190, 162, 114), rgb(232, 214, 160), rgb(160, 122, 78)
		for _, o in ipairs(options) do
			if #comets >= MEADOW.Sacks then
				break
			end
			if not used[o.Bed] then
				used[o.Bed] = true
				local y = TOP - LAWN + (o.Patch and 0.1 or 0)
				local frame = CFrame.lookAt(Vector3.new(o.Foot.X, y, o.Foot.Z), Vector3.new(o.Foot.X, y, o.Foot.Z) + o.Look)
				local m = newModel(decorParent, "SeedSack")
				m:SetAttribute("Bed", o.Bed:GetFullName())
				-- the Part build (the fallback and the shape the mesh dresses): a slumped body, the bunched neck, the
				-- flopped top and the spilled mound
				local tilt = frame * CFrame.Angles(-S.Lean, 0, 0)
				box(m, "Sack", tilt * CFrame.new(0, S.H / 2, 0), Vector3.new(S.W, S.H, S.D), burlap)
				box(m, "SackNeck", tilt * CFrame.new(0, S.H + 0.08, 0), Vector3.new(0.5, 0.26, 0.5), twine)
				box(m, "SackTop", tilt * CFrame.new(0, S.H + 0.32, 0.05), Vector3.new(0.6, 0.28, 0.45), burlapDark)
				box(m, "Spill", frame * CFrame.new(S.W / 2 + 0.5, 0.06, 0.2), Vector3.new(1.0, 0.16, 0.9), seed)
				m.WorldPivot = frame
				Mesh.tag(m, "prop_seedsack", frame)
				gridCircle(g, o.Foot.X, o.Foot.Z, 1.0)
				gridCircle(g, o.Spill.X, o.Spill.Z, 0.8)
				local v = o.Variant
				comets[#comets + 1] = { From = o.Spill, Tints = { v, v % #FLOWERS + 1 }, Sack = m }
			end
		end
		return comets
	end

	-- where a point sits in a seed drift (a comet streaming downwind from the spill): t along it, its half width there
	local function inComet(c, x, z)
		local w = MEADOW.Wind
		local rel = Vector3.new(x - c.From.X, 0, z - c.From.Z)
		local t = rel:Dot(w)
		local side = math.abs(rel.X * w.Z - rel.Z * w.X)
		local half = MEADOW.Drift.Width0 + math.max(0, t) * MEADOW.Drift.Spread
		if t >= -0.6 and t <= MEADOW.Drift.Length and side <= half then
			return t, side, half
		end
		return nil
	end

	local function zoneScale(zone, edge, h)
		if zone == "wild" and not edge then
			return 0.9 + 0.32 * h
		elseif zone == "mown" then
			return 0.72 + 0.2 * h
		end
		return 0.8 + 0.26 * h
	end

	-- one area's clumps (appended to `out`); zoneOf(x, z) -> "wild" | "mown" | "garden" | nil (relative to the area centre)
	local function scatter(g, out, zoneOf, seed, comets, npcSpots)
		for _, s in ipairs(npcSpots or {}) do
			local p = typeof(s) == "CFrame" and s.Position or s
			if typeof(p) == "Vector3" then
				gridCircle(g, p.X, p.Z, 3)
			end
		end
		distances(g)
		local cell = MEADOW.Cell
		local n = math.ceil(g.R / cell)
		local w = MEADOW.Wind
		local yaw0 = math.atan2(-w.Z, w.X) -- CFrame.Angles(0, yaw0, 0) turns +X onto the wind
		local stats = out.Stats
		local function add(kind, tint, x, z, h, sc, code, zone, drift)
			out[#out + 1] = {
				Kind = kind,
				Tint = tint,
				X = x - OX,
				Z = z - OZ,
				Yaw = yaw0 + (h - 0.5) * 0.7,
				Scale = sc,
				Patch = code == 2,
				Zone = zone,
				Drift = drift,
			}
			local key = drift and "Drift" or zone
			stats[key] = (stats[key] or 0) + 1
		end
		-- the meadow / lawn on a jittered 2-stud grid
		for i = -n, n - 1 do
			for k = -n, n - 1 do
				local h1, h2 = hash3(i, 1, k, seed), hash3(i, 2, k, seed)
				local lx, lz = (i + 0.12 + 0.76 * h1) * cell, (k + 0.12 + 0.76 * h2) * cell
				local x, z = g.CX + lx, g.CZ + lz
				local idx = gridIndex(g, x, z)
				local code = idx and g.Code[idx] or 0
				if (code == 1 or code == 2) and lx * lx + lz * lz <= g.R * g.R then
					local d = distAt(g, x, z)
					local zone = zoneOf(lx, lz)
					if zone and d >= MEADOW.Edge then
						local p, mix = MEADOW.Density[zone] or 0, MEADOW.Mix[zone]
						-- clumpy meadow: soft patches of thicker and thinner growth
						p = p * (0.45 + 0.75 * vnoise(x + 311, z - 97, 13, seed + 3))
						for _, c in ipairs(comets or {}) do
							if inComet(c, x, z) then
								p = p * 0.5 -- the drift's flowers stand in thinner grass
							end
						end
						local edge = d < MEADOW.Thin
						if edge then
							p = p * (0.1 + 0.4 * (d - MEADOW.Edge) / (MEADOW.Thin - MEADOW.Edge))
							mix = MEADOW.Mix.edge
						end
						if hash3(i, 3, k, seed) < p then
							local kind = pick(mix, hash3(i, 4, k, seed))
							local tint = 0
							if kind == 5 then
								if zone == "wild" then
									tint = MEADOW.WildTints[math.floor(hash3(i, 5, k, seed) * #MEADOW.WildTints) + 1]
								elseif zone == "mown" then
									tint = (hash3(i, 5, k, seed) < 0.7) and 3 or 2 -- daisies, a few buttercups
								else
									tint = math.floor(hash3(i, 5, k, seed) * #FLOWERS) + 1
								end
							end
							add(kind, tint, x, z, hash3(i, 9, k, seed), zoneScale(zone, edge, hash3(i, 6, k, seed)), code, zone, false)
						end
					end
				end
			end
		end
		-- the seed drifts: the bed's two colours on a finer 1-stud grid, densest by the sack, thinning downwind
		for ci, c in ipairs(comets or {}) do
			local L_ = MEADOW.Drift.Length
			local reach = L_ + MEADOW.Drift.Width0 + L_ * MEADOW.Drift.Spread + 1
			local i0, i1 = math.floor(c.From.X - reach), math.ceil(c.From.X + reach)
			local k0, k1 = math.floor(c.From.Z - reach), math.ceil(c.From.Z + reach)
			for i = i0, i1 do
				for k = k0, k1 do
					local hs = seed + 50 + ci
					local x, z = i + 0.1 + 0.8 * hash3(i, 11, k, hs), k + 0.1 + 0.8 * hash3(i, 12, k, hs)
					local t, side, half = inComet(c, x, z)
					local idx = gridIndex(g, x, z)
					local code = idx and g.Code[idx] or 0
					if t and (code == 1 or code == 2) and distAt(g, x, z) >= MEADOW.Edge * 0.8 then
						local fall = 1 - math.max(0, t) / L_
						local core = 1 - side / (half + 0.01)
						local p = 0.9 * (fall ^ 0.6) * (0.5 + 0.5 * core)
						if hash3(i, 13, k, hs) < p then
							local r = hash3(i, 14, k, hs)
							local kind, tint = 5, c.Tints[(hash3(i, 15, k, hs) < 0.55) and 1 or 2]
							if r > 0.9 then
								kind, tint = 4, 0
							elseif r > 0.85 then
								kind, tint = 8, 0
							end
							add(kind, tint, x, z, hash3(i, 16, k, hs), 0.74 + 0.22 * hash3(i, 17, k, hs), code, zoneOf(x - g.CX, z - g.CZ) or "mown", true)
						end
					end
				end
			end
		end
	end

	-- dandelion seeds drifting off the wild lawns: one invisible emitter box per sector rich in seed clocks
	local function buildSeeds(parent, clumps)
		local K = MEADOW.Seeds
		local sectors = {}
		for _, c in ipairs(clumps) do
			if c.Kind == 7 and c.Zone == "wild" then
				local a = math.floor(((math.deg(atan2(c.Z, c.X)) % 360) / 360) * K.Sectors) + 1
				local s = sectors[a] or { N = 0, X = 0, Z = 0, X2 = 0, Z2 = 0 }
				s.N, s.X, s.Z = s.N + 1, s.X + c.X, s.Z + c.Z
				s.X2, s.Z2 = s.X2 + c.X * c.X, s.Z2 + c.Z * c.Z
				sectors[a] = s
			end
		end
		local model = newModel(parent, "MeadowSeeds")
		CollectionService:AddTag(model, DETAIL_TAG)
		local w = MEADOW.Wind
		for a = 1, K.Sectors do
			local s = sectors[a]
			if s and s.N >= K.MinClocks then
				local mx, mz = s.X / s.N, s.Z / s.N
				local sx = math.sqrt(math.max(1, s.X2 / s.N - mx * mx)) * 2
				local sz = math.sqrt(math.max(1, s.Z2 / s.N - mz * mz)) * 2
				local anchor = anchorPart(model, "Seeds" .. a, Vector3.new(OX + mx, TOP + 0.4, OZ + mz),
					Vector3.new(math.min(40, sx), 0.6, math.min(40, sz)))
				local e = emitter(anchor, {
					Sprite = "Glow",
					Color = ColorSequence.new(rgb(255, 255, 250)),
					LightEmission = 0.25,
					LightInfluence = 0.6,
					Rate = K.Rate,
					Lifetime = NumberRange.new(6, 10),
					Speed = NumberRange.new(0.4, 1.0),
					SpreadAngle = Vector2.new(25, 25),
					Acceleration = Vector3.new(w.X * 0.9, 0.12, w.Z * 0.9),
					Drag = 0.35,
					Size = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0),
						NumberSequenceKeypoint.new(0.1, 0.16),
						NumberSequenceKeypoint.new(0.85, 0.13),
						NumberSequenceKeypoint.new(1, 0),
					}),
					Transparency = FADE_IN_OUT,
					RotSpeed = NumberRange.new(-40, 40),
				})
				e.Name = "DandelionSeeds"
				pcall(function()
					e.Shape = Enum.ParticleEmitterShape.Box
					e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
				end)
			end
		end
		return model
	end

	-- publish the clumps for the clients (MeadowFx): attributes only, no parts
	local function publish(root, clumps)
		local folder = Instance.new("Folder")
		folder.Name = "Meadow"
		local chunk, buf, nchunks = MEADOW.ChunkClumps, {}, 0
		for i, c in ipairs(clumps) do
			buf[#buf + 1] = Meadow.encode(c)
			if #buf >= chunk or i == #clumps then
				nchunks = nchunks + 1
				folder:SetAttribute("Clumps" .. nchunks, table.concat(buf))
				buf = {}
			end
		end
		folder:SetAttribute("Version", MEADOW.Version)
		folder:SetAttribute("Count", #clumps)
		folder:SetAttribute("Chunks", nchunks)
		folder:SetAttribute("Wind", MEADOW.Wind)
		folder:SetAttribute("Base", TOP - LAWN)
		folder:SetAttribute("Origin", Vector3.new(OX, 0, OZ))
		folder:SetAttribute("Kinds", table.concat(MEADOW.Kinds, ","))
		for i, col in ipairs(FLOWERS) do
			folder:SetAttribute("Tint" .. i, col)
		end
		folder.Parent = root
		return folder
	end

	function Meadow.build(root, L)
		local parts = lobbyParts(root)
		local clumps = { Stats = {} }
		local plaza = root:FindFirstChild("Plaza")
		-- the plaza: wild beyond the circle walk, mown inside it
		if plaza then
			local g = areaGrid(OX, OZ, PLAZA_R - 4.5)
			rasterise(g, parts)
			local decor = plaza:FindFirstChild("LawnDecor") or plaza
			local okSacks, comets = pcall(buildSacks, root, g, decor)
			if not okSacks then
				warn("[LobbyBuilder] meadow sacks failed: " .. tostring(comets))
				comets = {}
			end
			local wildR = G.RingRoadR + G.PathHalf
			scatter(g, clumps, function(x, z)
				local r = math.sqrt(x * x + z * z)
				if r > wildR then
					return "wild"
				end
				return "mown"
			end, 1201, comets, L and L.NpcSpots)
			clumps.Comets = comets
		end
		-- the shop lawn and the garden islands: a lighter garden mix
		local shop = root:FindFirstChild("Shop")
		if shop and L and L.ShopCenter then
			local g = areaGrid(L.ShopCenter.X, L.ShopCenter.Z, (L.ShopR or 30) - 3)
			rasterise(g, parts)
			scatter(g, clumps, function()
				return "garden"
			end, 1301)
		end
		local gardens = root:FindFirstChild("Gardens")
		if gardens and L and L.Gardens then
			for gi, spec in ipairs(L.Gardens) do
				local c = polar(spec.Angle, G.GardenR, TOP)
				local g = areaGrid(c.X, c.Z, G.GardenSize - 3)
				rasterise(g, parts)
				scatter(g, clumps, function()
					return "garden"
				end, 1400 + gi)
			end
		end
		local stats = clumps.Stats
		clumps.Stats = nil
		local comets = clumps.Comets or {}
		clumps.Comets = nil
		section("meadow seeds", function()
			buildSeeds(plaza or root, clumps)
		end)
		local folder = publish(root, clumps)
		stats.Total = #clumps
		stats.Sacks = #comets
		MEADOW.Stats = stats
		MEADOW.Last = { Clumps = clumps, Comets = comets, Folder = folder }
		return folder
	end

	return Meadow
end)()

function LobbyBuilder.Build()
	templates = {}
	reserved = {}
	machineBoxCache = nil
	Mesh.Names = {}

	local old = Workspace:FindFirstChild("NimbusLobby")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "NimbusLobby"

	local L = computeLayout()
	if not Voxel then
		warn("[LobbyBuilder] shared/Voxel is missing: building the plain fallback lobby")
	end
	-- lobby shop: the helpers LobbyBoardBuilder draws with (the egg row in buildShop, the leaderboard board in
	-- buildPlazaDecor), one table as a field of the layout (no new local)
	-- (kit B, the lobby's signs on stone) signText stays the old outlined text for LobbyBoardBuilder's RarityStrip; kitText
	-- / signPanel / KIT are the kit's ink text, stone panel and tag helpers for when that builder moves over
	L.H = {
		noticeBoard = noticeBoard, surfaceGui = surfaceGui, signPanel = signPanel, signText = KIT.OutlinedText, kitText = signText, KIT = KIT,
		box = box, Mesh = Mesh, C = C, MAT = MAT, LAWN = LAWN, plazaSpot = plazaSpot, faceCentre = faceCentre,
		Detail = DETAIL_TAG, -- shop-area: the in-globe pile eggs (LobbyMachineBuilder.GlobeEggs)
	}

	-- Gameplay-critical objects first (gates, spots, shop); each has a bare-bones fallback.
	-- The Gate Court (6.1): Obby, Altar here; Ring / Arena (ArenaBuilder) and Dungeon (DungeonBuilder) join the
	-- same folder later, at GateSites.
	local gatesFolder = newFolder(root, "Gates")
	local sites = Gates.Sites(L)
	local gates = {}
	for _, id in ipairs(Gates.Built) do
		local ok, gate = pcall(Gates.BuildOne, gatesFolder, sites[id], id)
		if not ok then
			warn("[LobbyBuilder] gate " .. id .. ": " .. tostring(gate))
			gate = { Model = nil }
		end
		if not gate.Model then
			local spec = Gates.Spec(id)
			local m, pad, prompt = Gates.Fallback(gatesFolder, sites[id], id, Gates.Info[id], gateAccent(spec.Accent))
			gate = { Model = m, Pad = pad, PromptPart = prompt, Site = sites[id] }
		end
		gates[id] = gate
	end
	local portals = {}
	local okObby, obbyInfo = pcall(Gates.ObbyPortal, gates.Obby)
	if okObby then
		portals.Obby = obbyInfo
	else
		warn("[LobbyBuilder] obby portal zone failed: " .. tostring(obbyInfo))
	end

	local spots = {}
	local spotFolder = newFolder(root, "Spots")
	for i = 1, SPOT_COUNT do
		local angle = L.PlotAngles[i]
		local ok, result = pcall(buildSpot, spotFolder, i, angle)
		if not ok then
			warn("[LobbyBuilder] spot " .. tostring(i) .. " failed: " .. tostring(result))
			result = fallbackSpot(spotFolder, i, angle)
		end
		spots[i] = result
	end

	-- lobby shop (spec 5.9): the Sky Trove's plaza spot, worked out once per build and before buildPlaza (so its
	-- reservation comes first); buildShop and fallbackShop both build at L.TroveCF and never ask plazaSpot again (a second
	-- ask after a failed buildShop had reserved it would find it taken). Not free -> it has warned; forced, so there is
	-- always one trove.
	local trovePos = plazaSpot(G.Trove.Angle, G.Trove.R, G.Trove.Clear, L) or plazaSpot(G.Trove.Angle, G.Trove.R, G.Trove.Clear, L, true)
	L.TroveCF = faceCentre(trovePos - Vector3.new(0, LAWN, 0))
	local okShop, shop
	if LobbyBuilder._ForceShopFallback == true and game:GetService("RunService"):IsStudio() then
		okShop, shop = false, "forced fallback (the Studio hook LobbyBuilder._ForceShopFallback)"
	else
		okShop, shop = pcall(buildShop, root, L)
	end
	if not okShop then
		warn("[LobbyBuilder] shop failed: " .. tostring(shop))
		local broken = root:FindFirstChild("Shop")
		if broken then
			broken:Destroy()
		end
		shop = fallbackShop(root, L)
	end

	-- The plaza ground is where everyone spawns: keep a plain floor if the voxel plaza cannot be built.
	local okPlaza = section("plaza", function()
		buildPlaza(root, L)
	end)
	if not okPlaza or not root:FindFirstChild("Plaza") or not root.Plaza:FindFirstChild("Paths") then
		local floor = newFolder(root, "PlazaFallback")
		box(floor, "PlazaFloor", CFrame.new(OX, TOP - 1, OZ), Vector3.new(PLAZA_R * 1.7, 2, PLAZA_R * 1.7), C.Grass, { Collide = true })
		box(floor, "ShopNeckFloor", CFrame.new((Vector3.new(OX, TOP - 1, OZ) + L.ShopCenter - Vector3.new(0, 1, 0)) * 0.5), Vector3.new(16, 2, L.ShopDist), C.Stone, { Collide = true })
	end
	if type(L.NpcSpots) ~= "table" or #L.NpcSpots < 6 then
		L.NpcSpots = defaultNpcSpots(L)
	end

	section("roads", function()
		buildRoads(root, L)
	end)
	section("gardens", function()
		local gf = newFolder(root, "Gardens")
		for _, spec in ipairs(L.Gardens) do
			section("garden " .. spec.Name, function()
				buildGarden(gf, spec, L)
			end)
		end
	end)
	section("sky", function()
		buildSky(root)
	end)
	section("benches", function()
		Benches.wire(root) -- bug batch 2 #7: the Sit prompts of every bench (plaza lawns + gardens)
	end)
	section("meadow", function()
		Meadow.build(root, L) -- bug #12: where the grass and wildflowers grow (after every prop has its place)
	end)

	root.Parent = Workspace
	-- the templates and merged box lists are only needed while building
	templates = {}
	machineBoxCache = nil

	-- Spawn on the medallion in the middle of the spawn court, looking up the avenue at the Gate Court.
	local spawnPos = Vector3.new(OX, TOP + 3, OZ)
	local focus = polar(L.MidAngle, G.GateR, TOP + 3)
	local altarSite = nil
	local altarDock = nil
	if L.AltarAngle then
		altarSite = faceCentre(polar(L.AltarAngle, G.GardenR, TOP))
		altarDock = polar(L.AltarAngle, G.SpokeEndR - 2.4, TOP)
	end
	-- Phase 3: where ArenaBuilder links the Battle Arena (the outer edge of the junction on the arena spoke's ray)
	local arenaDock = nil
	if L.ArenaAngle then
		arenaDock = polar(L.ArenaAngle, (G.StreetR + G.StreetW / 2) / math.cos(math.rad(G.HalfStep)), TOP)
	end

	local parts = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			parts = parts + 1
		end
	end
	print(string.format("[LobbyBuilder] lobby built (%d parts, %d gates, %d plots)", parts, #Gates.Built, #spots))

	local gateInfo = {}
	for id, g in pairs(gates) do
		gateInfo[id] = { Model = g.Model, Pad = g.Pad, PromptPart = g.PromptPart }
	end
	-- bug batch 2 #4: where the Storm Altar's return portal (GateService gate "Plaza") lands: on the plaza 18 studs in
	-- front of the Altar gate (~15.2 from its PromptAnchor at 2.8 out, well clear of the 12-stud prompt), looking at the
	-- plaza; lobby shop (5.11 a): that is the front half of the gate's pad (14 studs out, 14 deep), so it lands 3 studs
	-- over the pad top (its highest part), 3 studs over the ground without a pad
	local altarGate = sites.Altar
	if gateInfo.Altar and typeof(altarGate) == "CFrame" then
		local lift = (Gates.PadTop(gates.Altar) or altarGate.Position.Y) - altarGate.Position.Y + 3
		local front = altarGate.Position + altarGate.LookVector * 18 + Vector3.new(0, lift, 0)
		gateInfo.Altar.ReturnCFrame = CFrame.lookAt(front, front + altarGate.LookVector * 12)
	end
	return {
		Folder = root,
		SpawnCFrame = flatLook(spawnPos, focus),
		Portals = portals, -- Phase 5: exactly { Obby = PortalInfo } (6.3)
		Spots = spots,
		Shop = shop,
		NpcSpots = L.NpcSpots,
		AltarSite = altarSite, -- the Storm Altar island (StormAltar.Build), faces the plaza
		AltarDock = altarDock, -- street inner edge where the bridge to the altar island docks
		-- Phase 3 (ArenaBuilder): the arena bridge leaves the street here, straight out along ArenaAngle (degrees, the
		-- spoke's ray through that junction, whose outer rail is open ArenaBridgeWidth + 1.6 studs)
		ArenaAngle = L.ArenaAngle,
		ArenaDock = arenaDock,
		ArenaBridgeWidth = G.ArenaBridgeW,
		-- Phase 5 Gate Court (6.1): ground CFrame of every gate centre (LookVector = towards the plaza centre), the
		-- folder every gate builder parents its gate to, and the lobby's own gates
		GateSites = sites,
		GatesFolder = gatesFolder,
		Gates = gateInfo, -- bug batch 2 #4: Gates.Altar.ReturnCFrame = the Storm Altar return portal's arrival
		RingSite = sites.Ring, -- ArenaBuilder's Portal_Ring (C12)
		DungeonSite = sites.Dungeon, -- DungeonBuilder.BuildPortal (W3)
	}
end

----------------------------------------------------------------------
-- Phase 6 kit hooks (read-only; the game never calls them): blender/kit/props/lobby_world.py sets
-- LobbyBuilder._Kit = { Targets = {}, Clouds = {} } before Build() to list every mesh target (key, subtree, origin) and
-- every voxel cloud spec, then re-voxels a cloud at a finer grain with _CloudGrid. Tests use _Mesh (Signature, tag).
----------------------------------------------------------------------
LobbyBuilder._Kit = nil
-- lobby shop (spec 5.9): Studio-only test hook (read by Build under RunService:IsStudio() only): true -> Build skips
-- buildShop and takes the fallbackShop path exactly as if buildShop had errored
LobbyBuilder._ForceShopFallback = nil
LobbyBuilder._Mesh = Mesh
LobbyBuilder._Oasis = OASIS -- bug #13: the fountain layout (tests compare it with the committed meshes)
LobbyBuilder._Benches = Benches -- bug batch 2 #7: tests call _Benches.sit / .check
LobbyBuilder._Meadow = Meadow -- bug #12: tests decode the scatter (Meadow.decode, Meadow.K.Stats / .Last)

-- the cells of a recorded VX.Cloud spec at `V` studs per voxel (tier heights keep their stud thickness)
function LobbyBuilder._CloudGrid(spec, V)
	local V0 = spec.V or 3
	local copy = {}
	for k, v in pairs(spec) do
		copy[k] = v
	end
	copy.V = V
	copy.Tiers = {}
	for i, t in ipairs(spec.Tiers) do
		local tt = {}
		for k, v in pairs(t) do
			tt[k] = v
		end
		tt.H = math.max(1, math.floor((t.H or 1) * V0 / V + 0.5))
		copy.Tiers[i] = tt
	end
	return VX.Cloud(copy)
end

return LobbyBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1104">
          <Properties>
            <string name="Name">LobbyMachineBuilder</string>
            <string name="Source"><![CDATA[-- LobbyMachineBuilder (shop-area 2026-11-09, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.17.1): the shop's
-- roulette machine card A "Gumball Globe" (the mesh key prop_roulette_globe, blender/kit/props/lobby_machine.py) and the
-- real eggs piled inside its glass. LobbyBuilder's main chunk is near its local cap, so the machine's new pieces live
-- here (one local there); LobbyBuilder.buildMachine tags the globe key and calls GlobeEggs only when that tag dressed.
--
--   LobbyMachineBuilder.GLOBE = { Key = "prop_roulette_globe", Count = 18, Chase = 1, Scale = 0.5, ChaseScale = 0.54,
--                                 EggSize = Vector3.new(2.25, 3, 2.5) }   (polish 2026-11-09: was 12 at 0.42 / 0.44)
--   LobbyMachineBuilder.SECRET_EMBLEM = white-gold 255,240,200: the Celestial machine's star (its top rarity is Secret)
--   LobbyMachineBuilder.EggKey(rarity, pile) -> "egg_<rarity>" (the chase egg) | "egg_<rarity>_pile" (pile) | nil
--   LobbyMachineBuilder.Rarities(roulette, count) -> { rarity id }
--     Pure (no Instances). [1] = the roulette's top rarity (the last of its odds > 0 in Config.Rarities order: the chase
--     egg), [2..count] = the pile of its lower rarities by weight: n_r = max(1, floor((count - 1) * w_r / sum + 0.5)),
--     then the largest n drops by one while the sum is over count - 1 and the most common rarity gains one while it is
--     under; interleaved by cycling the lower rarities in Config order, one of each while any is left. At 18: Cloud: Epic
--     + C U R C U R C U C U C U C C C C C; Storm: Legendary + U R E U R E U R E U R E U R U R R; Sky: Mythic + R E L R E L
--     R E L R E R E R E E E; Celestial: Secret + E L M E L M E L M E L E L E L E L. One rarity -> that egg everywhere;
--     none -> {}.
--   LobbyMachineBuilder.GlobeEggs(parent, cf, roulette, H) -> Model "GlobeEggs" | nil
--     cf = the machine's ground CFrame (the globe key's pivot, front -Z). Reads the globe manifest's Egg1..Egg18
--     attachments (pos = the egg's bottom centre in machine studs, rot = its turn) through MeshLibrary.Manifest and builds,
--     as a child of `parent` (the Roulette_<Id> model, beside its Machine: never inside the dressed body), one Model
--     GlobeEgg<i> per attachment holding one Part "Egg": the Part fallback (a block with a Sphere SpecialMesh, 2.25 x 3 x
--     2.5 x the scale, in the rarity colour, Secret dark with the shelf egg's violet tint, SmoothPlastic, anchored, no
--     collide / touch / query) standing on the pivot; the Model's WorldPivot = cf * the attachment, its attribute
--     ML_Scale = Scale (ChaseScale on GlobeEgg1: MeshLibrary.Dress assembles the mesh at that size about the pivot), then
--     H.Mesh.tag(model, EggKey(rarity, i ~= 1), pivot): the chase egg on the uploaded egg_<rarity>, the pile on
--     egg_<rarity>_pile (polish 2026-11-09, review round 2's perf finding: the full keys would put 68 x ~3.4k tris in the
--     shop; named "_pile", not "_low": MeshLibrary.LowKey reads "<key>_low" as key's LOD twin, and the one-part pile egg
--     is not the full egg's layout); ML_DressKey only where that key is not missing, so until the pile eggs are
--     uploaded the pile shows its Part spheres. GlobeEgg2..18 are tagged H.Detail (NC_Detail: the Low graphics setting parks the pile; the chase egg always
--     shows); nothing is tagged Spin (a still pile). A manifest that is missing, or lacks an Egg<i> attachment, warns once
--     per manifest ("[LobbyMachineBuilder] prop_roulette_globe: no Egg<i> attachment" / "...: no manifest") and returns
--     nil: the machine stands without its eggs.
--     H = LobbyBuilder's L.H (box, Mesh, C, MAT, Detail).
--   LobbyMachineBuilder._Manifest  TESTS ONLY: a function(key) -> manifest used instead of MeshLibrary.Manifest (nil = real)
-- No light, no prompt, no animation (the server never animates). Plain Lua 5.1 syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local LobbyMachineBuilder = {}

-- polish 2026-11-09: 18 eggs (the 12 read ~25 % full) at 0.5, the chase egg 0.54 (blender/kit/props/lobby_machine.py
-- EGG_SPOTS, poured by blender/pitches/shop_area_globe.py --settle onto the globe's cloud bed)
local GLOBE = {
	Key = "prop_roulette_globe", -- the mesh key, literal (tools/mesh_keys.py reads the keys from the source)
	Count = 18,
	Chase = 1,
	Scale = 0.5,
	ChaseScale = 0.54,
	EggSize = Vector3.new(2.25, 3, 2.5), -- the shelf egg's Part size (LobbyBoardBuilder EGG.Size)
}
LobbyMachineBuilder.GLOBE = GLOBE

-- the Celestial machine's emblem (polish: white-gold; the chat violet 180,150,255 was a near twin of Cloud's Epic lavender)
LobbyMachineBuilder.SECRET_EMBLEM = Color3.fromRGB(255, 240, 200)

-- the egg mesh keys, literal: the chase egg wears the full uploaded egg (LobbyBoardBuilder EGG_KEYS, ~3-3.7k tris); the
-- pile wears the low-poly pile egg (polish: egg_<rarity>_pile, a few hundred tris, one part; 68 full eggs would be
-- ~230k tris; never "_low", the LOD-twin name MeshLibrary.LowKey pairs with the full egg).
-- With no id for a key its egg stays the rarity-tinted Part sphere (Mesh.tag leaves it undressed)
local EGG_KEYS = {
	Common = "egg_common",
	Uncommon = "egg_uncommon",
	Rare = "egg_rare",
	Epic = "egg_epic",
	Legendary = "egg_legendary",
	Mythic = "egg_mythic",
	Secret = "egg_secret",
}
local PILE_KEYS = {
	Common = "egg_common_pile",
	Uncommon = "egg_uncommon_pile",
	Rare = "egg_rare_pile",
	Epic = "egg_epic_pile",
	Legendary = "egg_legendary_pile",
	Mythic = "egg_mythic_pile",
	Secret = "egg_secret_pile",
}

-- the dress key of an egg of `rarity`: the pile egg when `pile`, else the full egg (nil for an unknown rarity)
function LobbyMachineBuilder.EggKey(rarity, pile)
	return (pile and PILE_KEYS or EGG_KEYS)[rarity]
end
-- the Secret egg's Part colour: its near-black body with the violet glow (LobbyBoardBuilder SECRET, the shelf egg's)
local SECRET_EGG = Color3.fromRGB(40, 40, 52):Lerp(Color3.fromRGB(138, 92, 255), 0.18)
local DETAIL = "NC_Detail"

LobbyMachineBuilder._Manifest = nil

-- the rarities a roulette can pay, in Config.Rarities order
local function oddsList(roulette)
	local out = {}
	local odds = type(roulette) == "table" and type(roulette.Odds) == "table" and roulette.Odds or {}
	for _, r in ipairs(Config.Rarities) do
		local w = tonumber(odds[r.Id]) or 0
		if w > 0 then
			out[#out + 1] = { Id = r.Id, W = w, Color = r.Color }
		end
	end
	return out
end

function LobbyMachineBuilder.Rarities(roulette, count)
	count = math.max(0, math.floor(tonumber(count) or GLOBE.Count))
	local have = oddsList(roulette)
	local out = {}
	if #have == 0 or count == 0 then
		return out
	end
	local top = have[#have]
	out[1] = top.Id
	local lower = {}
	for i = 1, #have - 1 do
		lower[i] = have[i]
	end
	local m = count - 1
	if #lower == 0 then
		for i = 2, count do
			out[i] = top.Id
		end
		return out
	end
	local sum = 0
	for _, r in ipairs(lower) do
		sum = sum + r.W
	end
	local n, total = {}, 0
	for i, r in ipairs(lower) do
		n[i] = math.max(1, math.floor(m * r.W / sum + 0.5))
		total = total + n[i]
	end
	while total > m do
		local big = 1
		for i = 2, #n do
			if n[i] > n[big] then
				big = i
			end
		end
		n[big] = n[big] - 1
		total = total - 1
	end
	while total < m do
		n[1] = n[1] + 1
		total = total + 1
	end
	local left = total
	while left > 0 do
		for i, r in ipairs(lower) do
			if n[i] > 0 then
				out[#out + 1] = r.Id
				n[i] = n[i] - 1
				left = left - 1
			end
		end
	end
	return out
end

-- one warn per manifest (the four machines read the same one)
local warned = setmetatable({}, { __mode = "k" })
local NO_MANIFEST = {}
local function warnOnce(man, msg)
	local key = type(man) == "table" and man or NO_MANIFEST
	warned[key] = warned[key] or {}
	if warned[key][msg] then
		return
	end
	warned[key][msg] = true
	warn(msg)
end

-- a manifest attachment { Pos = {x, y, z}, Rot = {{...}, {...}, {...}} } -> its CFrame in machine space, nil if malformed
local function frameOf(a)
	local pos = type(a) == "table" and (a.Pos or a.pos)
	local rot = type(a) == "table" and (a.Rot or a.rot)
	if type(pos) ~= "table" or type(rot) ~= "table" or type(rot[1]) ~= "table" or type(rot[2]) ~= "table" or type(rot[3]) ~= "table" then
		return nil
	end
	local v = { pos[1], pos[2], pos[3], rot[1][1], rot[1][2], rot[1][3], rot[2][1], rot[2][2], rot[2][3], rot[3][1], rot[3][2], rot[3][3] }
	for i = 1, 12 do
		if type(v[i]) ~= "number" then
			return nil
		end
	end
	return CFrame.new(v[1], v[2], v[3], v[4], v[5], v[6], v[7], v[8], v[9], v[10], v[11], v[12])
end

local function eggColour(id)
	if id == "Secret" then
		return SECRET_EGG
	end
	for _, r in ipairs(Config.Rarities) do
		if r.Id == id then
			return r.Color
		end
	end
	return Color3.fromRGB(200, 200, 210)
end

local function manifest(H)
	local get = LobbyMachineBuilder._Manifest
	if type(get) ~= "function" then
		local lib = type(H.Mesh) == "table" and type(H.Mesh.lib) == "function" and H.Mesh.lib() or nil
		get = lib and lib.Manifest
	end
	if type(get) ~= "function" then
		return nil
	end
	local ok, man = pcall(get, GLOBE.Key)
	return ok and type(man) == "table" and man or nil
end

function LobbyMachineBuilder.GlobeEggs(parent, cf, roulette, H)
	if typeof(parent) ~= "Instance" or typeof(cf) ~= "CFrame" or type(roulette) ~= "table" or type(H) ~= "table" or type(H.box) ~= "function" then
		return nil
	end
	local man = manifest(H)
	local att = man and (man.Attachments or man.attachments)
	if type(att) ~= "table" then
		warnOnce(man, "[LobbyMachineBuilder] " .. GLOBE.Key .. ": no manifest")
		return nil
	end
	local frames = {}
	for i = 1, GLOBE.Count do
		frames[i] = frameOf(att["Egg" .. i])
		if not frames[i] then
			warnOnce(man, "[LobbyMachineBuilder] " .. GLOBE.Key .. ": no Egg" .. i .. " attachment")
			return nil
		end
	end
	local seq = LobbyMachineBuilder.Rarities(roulette, GLOBE.Count)
	if #seq < GLOBE.Count then
		return nil -- a roulette without odds: nothing to show
	end
	local detail = type(H.Detail) == "string" and H.Detail or DETAIL
	local smooth = H.MAT and H.MAT.SmoothPlastic or Enum.Material.SmoothPlastic
	local model = Instance.new("Model")
	model.Name = "GlobeEggs"
	for i = 1, GLOBE.Count do
		local id = seq[i]
		local s = (i == GLOBE.Chase) and GLOBE.ChaseScale or GLOBE.Scale
		local pivot = cf * frames[i]
		local size = GLOBE.EggSize * s
		local egg = Instance.new("Model")
		egg.Name = "GlobeEgg" .. i
		local part = H.box(egg, "Egg", pivot * CFrame.new(0, size.Y / 2, 0), size, eggColour(id), { Material = smooth, Shadow = false })
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		local shape = Instance.new("SpecialMesh")
		shape.MeshType = Enum.MeshType.Sphere -- the ellipsoid of the block's size
		shape.Parent = part
		egg.WorldPivot = pivot
		-- the size first, then the tag: a client that sees the dress tag reads ML_Scale with it
		egg:SetAttribute("ML_Scale", s)
		local key = LobbyMachineBuilder.EggKey(id, i ~= GLOBE.Chase)
		if type(H.Mesh) == "table" and type(H.Mesh.tag) == "function" and key then
			H.Mesh.tag(egg, key, pivot)
		end
		if i ~= GLOBE.Chase then
			CollectionService:AddTag(egg, detail)
		end
		egg.Parent = model
	end
	model.WorldPivot = cf
	model.Parent = parent
	return model
end

return LobbyMachineBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1105">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[-- MatchService (v2): match lifecycle + team rules for Nimbus Climb.
--
-- One match = one procedurally generated sky course in its own arena slot, a party of 1-4 players,
-- and a single worker loop (task.spawn + task.wait(0.25)) that drives the state machine:
--
--   Setup -> Countdown (frozen on the start platform) -> Playing -> Ended (results) -> cleanup
--
-- Server-authoritative: checkpoints, revives, void handling, tokens, victory/defeat/timeout.
-- Everything a match creates (course, hazard loops, token watcher, event connections, player
-- attributes) is torn down in cleanupMatch(), always in the same order, every step in a pcall so a
-- single failure can never leak a slot.
--
-- v2 additions:
--   * five difficulties (everything is looked up through Config.GetDifficulty / per-id Config tables)
--   * pet perks through deps.PetService: token pickups are multiplied by GetTokenMultiplier with a
--     per-player fractional carry (rounding stays fair over time), checkpoint heals are scaled by
--     the CheckpointHeal perk
--   * DataService.RecordMatch for every member at the end of a match, lifetime TokensEarned
--   * MatchResult.Stars
--   * courses are no longer a line toward +Z: all positions come from CourseInfo (StartCFrame,
--     Checkpoints[i].SpawnCFrame, Finish part, KillY), so spirals / zigzags / any heading work
--   * laps are stacked above each other (Spiral, overlapping lanes), so a missed jump often lands on a
--     LOWER lap long before the KillY plane. Besides the KillY plane there is a per-player fall rule:
--     a player who lands more than FALL_DROP studs below the last place they stood is treated exactly
--     like a void fall (VoidDamage + back to the team checkpoint). See landedOnLowerLap().
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local MatchService = {}
MatchService.MatchEnded = Util.Signal() -- Fire(match, won:boolean)

----------------------------------------------------------------------
-- Tunables local to this module
----------------------------------------------------------------------
local TICK = 0.25 -- worker loop period (also the void / checkpoint / finish poll rate)
local STATE_INTERVAL = 0.5 -- MatchState broadcast period while counting down / playing (2 Hz)
local START_SPREAD = 4 -- scatter radius on the start platform (platform is >= 24x24)
local CHECKPOINT_SPREAD = 3.5 -- scatter radius on a checkpoint pad (pads are >= 14x14)
local FINISH_SPREAD = 7.5 -- scatter radius on the finish pad (pad is >= 28x28)
local RESPAWN_FIX_DELAY = 0.4 -- let PlayerService place + stat a fresh character before we adjust it
local MAX_TICK_ERRORS = 40 -- consecutive worker errors before a match is force-closed
local SHORT_RESPAWN_TIME = 1.5 -- Players.RespawnTime cap, so reset-button deaths are quick
local LAYOUT_ATTEMPTS = 4 -- tries to get a layout that passes ValidateLayout
local TOKEN_TOAST_WINDOW = 0.6 -- pickups inside this window share one "+n cloud tokens" toast
local PAD_BELOW = 2 -- studs below a pad's underside that still count as "on" it (poll fallback)
local DEFAULT_KILL_DROP = 60 -- CourseInfo.KillY fallback: origin.Y - this

-- Fall-to-a-lower-lap rule (stacked laps, see landedOnLowerLap). The numbers come from the layout rules:
--   * a legitimate link never drops more than 4 studs (CourseLayout: "drop: rise >= -4 always", cannon
--     landings >= -3 below the pad) and the poll samples every 0.25 s, so two links cannot fit between
--     two samples: honest play never changes the standing height by more than ~4 per sample;
--   * hazard geometry (storm cloud, pendulum, lightning rods ...) is at most 12 studs above its step;
--   * two overlapping steps are always >= Config.Course.Clearance + 2 (step thickness) = 15 studs apart
--     top to top (the generator keeps the underside >= Clearance + 0.3 above the lower top); over the
--     ~55000 overlapping step pairs of 1500 generated layouts (5 difficulties x 300 seeds) the closest
--     was 15.3 and none was closer than 15, so stacked laps clear the 12 stud limit by about 3 studs.
-- So landing more than 12 studs below the last standing height is always a fall, never a link.
local FALL_DROP = 12
-- Ground probe: a standing root is ~3 studs over the floor (HipHeight 2 + half the root, up to ~4.5 on
-- tall avatars). 6 studs reaches the floor under a standing player and the first metres of a jump, but
-- not from the top of a full jump (~7 studs up, root ~10 over the floor).
local GROUND_REACH = 6
-- Vertical speeds (studs/s, downward) used to recognise a fall in progress. A standing player is at 0,
-- a fall reaches 30 after 0.15 s and 60 after 0.3 s (gravity 196):
--   * FALLING_SPEED: this fast is a fall even right above a floor (the player is about to land on it)
--   * DESCENT_SPEED: any clear downward motion; with no floor under the root it also marks a fall.
-- A poll in the air WITHOUT downward motion (jump apex, rising, or a position that was just moved) is
-- ignored: it proves nothing about a fall and must not count as one.
local FALLING_SPEED = 30
local DESCENT_SPEED = 4
local groundParams = nil -- RaycastParams, created on first use

-- A player standing on a pad has the root ~3 studs over its top surface. Anything higher than the
-- course headroom guarantee cannot be a player standing on the pad itself (it would be on a step
-- above it), so the poll fallback never fires from the floor above.
local PAD_ABOVE = 9
if type(Config.Course) == "table" and type(Config.Course.Clearance) == "number" then
	PAD_ABOVE = math.max(6, math.min(12, Config.Course.Clearance + 1))
end

-- (playtest 2026-11-28 C22) the finish is accepted only from a player who went the way: a client teleport onto the
-- finish pad won Easy in 0:59. Each member keeps their OWN trail (rec.Checkpoint: the last checkpoint they were at, in
-- order, like the team's), and the finish needs the trail complete plus the match older than the course's shortest
-- honest time. The trail must never refuse an honest player, so a pad counts when the player is anywhere NEAR it
-- (TRAIL_PAD studs past its edge, TRAIL_ABOVE over its top: a dash-jump across a 14-stud pad at 85 studs/s still has a
-- 0.25 s poll inside that window, and Touched counts too) and every place the SERVER puts a player (a void rescue, a
-- revive, a respawn: all at the team checkpoint) counts as that checkpoint. A refusal is logged once per player.
local TRAIL_PAD = 12
local TRAIL_ABOVE = 20
-- (C22 review) A Touched event counts only with the toucher's root AT the part (TOUCH_SLACK studs past its edge: a foot or
-- a hand on the rim, never a touch reported from across the course: an exploit client can fire touches for its own parts
-- from anywhere). The trail takes a touch inside nearPad like the poll does.
local TOUCH_SLACK = 4
-- The shortest honest time (match.MinSeconds), from honest pace instead of 1.5 x DashSpeed (review: the old floor was
-- 3.6-4.9 s on Easy, a pad-by-pad teleport won after 4.3 s). The path: the horizontal chain start -> each checkpoint pad ->
-- the finish pad, less what touching each pad anywhere in its touch window can cut at a turn (minFinishSeconds), so it
-- is a LOWER bound on any honest path. The pace: run + a dash every cooldown, the best average a climber can hold
-- (Config.Physics: 27 run, 85 for 0.18 s of every 1.6 s = 33.5 studs/s, and stamina makes it lower), x FLOOR_PACE_MARGIN
-- for a moving cloud's carry (<= 4.2), a hazard's knock and the first dash. A cannon leg counts as its flight time
-- (CourseLayout: 25-60 studs in 1.0-2.2 s). A refusal only makes the player wait on the pad, so an honest record run is
-- delayed at worst, never lost. Floors over 200 seeds: Easy 8.8-12.9 s, Medium 8.4-16.1, Hard 8.7-18.3, Extreme
-- 11.6-25.9, Saint 13.1-32.7 (about 1-2 % of each time limit).
local FLOOR_PACE_MARGIN = 1.2
local HONEST_PACE = 33.5 -- recomputed from Config.Physics below
do
	local ph = Config.Physics
	local run, dash = ph.RunSpeed or 27, ph.DashSpeed or 85
	local burst, cooldown = ph.DashDuration or 0.18, math.max(ph.DashCooldown or 1.6, ph.DashDuration or 0.18, 0.1)
	HONEST_PACE = ((cooldown - burst) * run + burst * dash) / cooldown
end
local FLOOR_PACE = HONEST_PACE * FLOOR_PACE_MARGIN
-- an accepted finish under this x the floor is logged (for review, nothing is refused): a waited-out teleport run lands
-- right at the floor, a stand-in at the honest pace on the straight chain at 1.39 x or more (200 seeds a difficulty)
local FAST_FINISH_LOG = 1.25
local REFUSAL_TOAST_EVERY = 4 -- seconds between two refusal toasts while a player keeps standing on the finish

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local deps = {}
local initialized = false
local slots = {} -- slot number -> match
local matches = {} -- match id -> match
local playerMatch = {} -- Player -> match
local nextMatchId = 0
local random = Random.new()
local remoteCache = {}
local tokenCarry = {} -- Player -> fractional pet-bonus tokens not yet paid out (0 <= x < 1)
local tokenToast = {} -- Player -> pending coalesced "+n cloud tokens" toast

-- forward declarations (functions that reference each other)
local endMatch
local cleanupMatch
local detachPlayer
local reachCheckpoint
local markFinished
local broadcastState

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function clock()
	return os.clock()
end

local function numberOr(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

local function copyList(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

local function removeValue(list, value)
	for i = #list, 1, -1 do
		if list[i] == value then
			table.remove(list, i)
		end
	end
end

local function nameOf(player)
	local n = player.DisplayName
	if type(n) ~= "string" or n == "" then
		n = player.Name
	end
	return n
end

-- Call deps[name][fnName](...) defensively. Returns ok, result1, result2.
local function callDep(name, fnName, ...)
	local dep = deps[name]
	if not dep then
		return false
	end
	local fn = dep[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local ok, a, b = pcall(fn, ...)
	if not ok then
		warn("[MatchService] " .. name .. "." .. fnName .. " failed: " .. tostring(a))
		return false
	end
	return true, a, b
end

local function setAttr(player, name, value)
	pcall(function()
		player:SetAttribute(name, value)
	end)
end

local function isDowned(player)
	return player:GetAttribute(Config.Attr.Downed) == true
end

local function getRemote(name)
	local cached = remoteCache[name]
	if cached then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		remoteCache[name] = remote
		return remote
	end
	return nil
end

local function fireClient(name, player, ...)
	if not player or player.Parent == nil then
		return
	end
	local remote = getRemote(name)
	if not remote then
		return
	end
	pcall(remote.FireClient, remote, player, ...)
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function notifyAll(match, text, kind, duration, except)
	for _, p in ipairs(match.Players) do
		if p ~= except then
			notify(p, text, kind, duration)
		end
	end
end

local function isMember(match, player)
	return playerMatch[player] == match
end

-- Humanoid + root of a living character, or nil, nil.
local function getLive(player)
	local char = player.Character
	if not char or not char.Parent then
		return nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil, nil
	end
	return hum, root
end

local function teleportTo(player, cf)
	local char = player.Character
	if not char or not char.Parent then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local ok = pcall(function()
		char:PivotTo(cf)
	end)
	if not ok then
		return false
	end
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	-- a deliberate move (spawn, revive, void rescue, finish pad): forget where the player last stood, so
	-- the new height is never mistaken for a fall from the old one (see landedOnLowerLap)
	local match = playerMatch[player]
	local rec = match and match.Recs and match.Recs[player]
	if rec then
		rec.LastGroundY = nil
		rec.Airborne = false
	end
	return true
end

-- Place player `index` of `count` on a ring around `base` (in base's local space, so it follows
-- the pad's heading), with a little random jitter.
local function spreadCFrame(base, index, count, radius)
	count = math.max(count or 1, 1)
	local angle = ((index - 1) / count) * math.pi * 2 + math.pi / 4
	local x = math.cos(angle) * radius * 0.8 + random:NextNumber(-1, 1) * radius * 0.2
	local z = math.sin(angle) * radius * 0.8 + random:NextNumber(-1, 1) * radius * 0.2
	return base * CFrame.new(x, 0, z)
end

-- Random scatter around `base` (respawns).
local function jitterCFrame(base, radius)
	return base * CFrame.new(random:NextNumber(-radius, radius), 0, random:NextNumber(-radius, radius))
end

-- Freeze / unfreeze a character: zero speed + jump AND anchored root (the client may fight a
-- WalkSpeed change by itself while sprinting, an anchored root cannot be argued with).
local function setFrozen(player, frozen)
	local char = player.Character
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum then
		pcall(function()
			hum.UseJumpPower = true
			if frozen then
				hum.WalkSpeed = 0
				hum.JumpPower = 0
			elseif not isDowned(player) then
				hum.WalkSpeed = Config.Physics.WalkSpeed
				hum.JumpPower = Config.Physics.JumpPower
			end
		end)
	end
	if root then
		pcall(function()
			root.Anchored = frozen
		end)
	end
end

-- Is `pos` above/inside the footprint of a block `part` (used instead of Touched for reliability)?
-- The test runs in the part's own space, so it works for pads rotated to any heading.
local function isOverPart(part, pos, padXZ, below, above)
	local rel = part.CFrame:PointToObjectSpace(pos)
	local hs = part.Size * 0.5
	return math.abs(rel.X) <= hs.X + padXZ
		and math.abs(rel.Z) <= hs.Z + padXZ
		and rel.Y >= -(hs.Y + below)
		and rel.Y <= hs.Y + above
end

-- Void height of a match's course (CourseInfo.KillY, else origin.Y - 60).
local function killYOf(match)
	local course = match.Course
	local y = course and course.KillY
	if type(y) == "number" and y == y then
		return y
	end
	if match.Origin then
		return match.Origin.Y - DEFAULT_KILL_DROP
	end
	return -1e9
end

local function teamSpawnCFrame(match)
	local course = match.Course
	if match.Checkpoint >= 1 then
		local cp = course.Checkpoints[match.Checkpoint]
		if cp and cp.SpawnCFrame then
			return cp.SpawnCFrame
		end
	end
	return course.StartCFrame
end

-- Standing spot at the centre of the finish pad, facing the pad's direction of travel (the pad's
-- local +Z). Follows the pad's heading so spiral / zigzag finishes spread correctly.
local function finishCFrame(match)
	local pad = match.Course and match.Course.Finish
	if pad and pad.Parent then
		local top = (pad.CFrame * CFrame.new(0, pad.Size.Y / 2 + 3.5, 0)).Position
		local look = pad.CFrame.LookVector
		local fwd = Vector3.new(-look.X, 0, -look.Z)
		if fwd.Magnitude < 0.01 then
			fwd = Vector3.new(0, 0, 1)
		end
		return CFrame.new(top, top + fwd.Unit)
	end
	return teamSpawnCFrame(match)
end

local function secondsLeft(match, t)
	t = t or clock()
	if match.State == "Countdown" then
		return math.max(0, math.ceil(match.CountdownEnd - t))
	elseif match.State == "Playing" then
		return math.max(0, math.ceil(match.Difficulty.TimeLimit - (t - match.StartedAt)))
	elseif match.State == "Ended" then
		return math.max(0, math.ceil((match.EndDeadline or t) - t))
	end
	return 0
end

----------------------------------------------------------------------
-- Pet perks (deps.PetService). Every call is guarded: no PetService => no bonus.
----------------------------------------------------------------------
local function perkCap(key, default)
	local caps = Config.Pets and Config.Pets.PerkCaps
	return numberOr(caps and caps[key], default)
end

-- Summed perk value (a fraction, 0.2 = +20%) for `key`, capped like PetCatalog.SumPerks.
local function perkOf(player, key)
	local pets = deps.PetService
	if not pets or type(pets.GetPerks) ~= "function" then
		return 0
	end
	local ok, perks = pcall(pets.GetPerks, player)
	if not ok or type(perks) ~= "table" then
		return 0
	end
	local value = numberOr(perks[key], 0)
	if value < 0 then
		value = 0
	end
	local cap = perkCap(key, nil)
	if cap and value > cap then
		value = cap
	end
	return value
end

-- >= 1. Never trusts the PetService to stay inside the configured cap.
local function tokenMultiplier(player)
	local pets = deps.PetService
	if pets and type(pets.GetTokenMultiplier) == "function" then
		local ok, mult = pcall(pets.GetTokenMultiplier, player)
		if ok then
			return Util.Clamp(numberOr(mult, 1), 1, 1 + perkCap("TokenBonus", 1))
		end
	end
	return 1
end

----------------------------------------------------------------------
-- MatchState broadcast
----------------------------------------------------------------------
local function buildState(match, phase)
	local diff = match.Difficulty
	local members = {}
	for _, p in ipairs(match.Players) do
		local fraction = 0
		local hum = Util.GetHumanoid(p)
		if hum and hum.MaxHealth > 0 then
			fraction = Util.Clamp(hum.Health / hum.MaxHealth, 0, 1)
		end
		members[#members + 1] = {
			UserId = p.UserId,
			Name = nameOf(p),
			Health = fraction,
			Downed = isDowned(p),
			Finished = match.Finished[p] == true,
			Tokens = match.Tokens[p] or 0,
		}
	end
	return {
		Phase = phase,
		DifficultyId = diff.Id,
		DifficultyName = diff.DisplayName,
		Color = diff.Color,
		Seconds = secondsLeft(match),
		Checkpoint = match.Checkpoint,
		TotalCheckpoints = match.TotalCheckpoints,
		TokensCollected = match.TeamTokens,
		TotalTokens = (match.Course and match.Course.TotalTokens) or 0,
		Members = members,
	}
end

broadcastState = function(match)
	if match.State == "Setup" then
		return
	end
	local state = buildState(match, match.State)
	for _, p in ipairs(match.Players) do
		fireClient("MatchState", p, state)
	end
	match.LastStateAt = clock()
end

----------------------------------------------------------------------
-- Stop helpers (idempotent)
----------------------------------------------------------------------
local function stopHazards(match)
	local fn = match.StopHazards
	match.StopHazards = nil
	if fn then
		local ok, err = pcall(fn)
		if not ok then
			warn("[MatchService] hazard stop failed: " .. tostring(err))
		end
	end
end

local function stopTokens(match)
	local fn = match.StopTokens
	match.StopTokens = nil
	if fn then
		local ok, err = pcall(fn)
		if not ok then
			warn("[MatchService] token stop failed: " .. tostring(err))
		end
	end
end

local function destroyCourse(match)
	local course = match.Course
	if course and course.Folder then
		pcall(function()
			course.Folder:Destroy()
		end)
	elseif match.Seed then
		-- belt and braces: a Build() that threw after parenting could leave an orphan folder.
		-- Sweep it by name, but never touch a folder that belongs to another live match.
		local name = "Course_" .. tostring(match.Seed)
		local claimed = {}
		for _, m in pairs(matches) do
			if m ~= match and m.Course and m.Course.Folder then
				claimed[m.Course.Folder] = true
			end
		end
		for _, child in ipairs(Workspace:GetChildren()) do
			if child.Name == name and not claimed[child] then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end
end

----------------------------------------------------------------------
-- Tokens
----------------------------------------------------------------------
-- Pay `n` tokens into the persistent wallet. Also keeps Stats.TokensEarned (lifetime) correct:
-- if DataService.AddTokens already counts it we leave it alone, otherwise we add it here, so the
-- stat is right whichever way DataService is written (and never double counted).
local function creditTokens(player, n)
	local ds = deps.DataService
	if not ds then
		return
	end
	local profile = nil
	local before = 0
	if type(ds.GetProfile) == "function" then
		local ok, p = pcall(ds.GetProfile, player)
		if ok and type(p) == "table" and type(p.Stats) == "table" then
			profile = p
			before = numberOr(p.Stats.TokensEarned, 0)
		end
	end
	callDep("DataService", "AddTokens", player, n)
	if profile and numberOr(profile.Stats.TokensEarned, 0) == before then
		profile.Stats.TokensEarned = before + n
		callDep("DataService", "MarkDirty", player)
	end
end

-- Several pickups within TOKEN_TOAST_WINDOW share one toast, so the (max 4) toast stack on the
-- right edge is not flooded by a row of tokens.
local function queueTokenToast(match, player, gained, base)
	local pending = tokenToast[player]
	if pending then
		pending.Gained = pending.Gained + gained
		pending.Base = pending.Base + base
		return
	end
	pending = { Gained = gained, Base = base }
	tokenToast[player] = pending
	task.delay(TOKEN_TOAST_WINDOW, function()
		if tokenToast[player] == pending then
			tokenToast[player] = nil
		end
		if player.Parent == nil or playerMatch[player] ~= match then
			return
		end
		local text = "+" .. pending.Gained .. " Cloud Token" -- (playtest 2026-11-28 C20: the Theme.Currency name's case)
		if pending.Gained ~= 1 then
			text = text .. "s"
		end
		local extra = pending.Gained - pending.Base
		if extra > 0 then
			text = text .. " (pets +" .. extra .. ")"
		end
		notify(player, text, "token", 2)
	end)
end

-- TokenService calls this (through the match handle) with the pickup's base value.
-- Pets multiply the payout; a per-player carry keeps the rounding fair over time:
--   exact = base * multiplier + carry ; paid = floor(exact) ; carry = exact - paid
local function addTokens(match, player, n)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	if not isMember(match, player) then
		return
	end
	local base = math.floor(numberOr(n, 0) + 0.5)
	if base < 1 then
		return
	end
	local exact = base * tokenMultiplier(player) + (tokenCarry[player] or 0)
	local paid = math.floor(exact + 1e-6)
	if paid < base then
		paid = base -- the multiplier is >= 1, never pay less than the pickup is worth
	end
	tokenCarry[player] = math.max(0, exact - paid)

	local total = (match.Tokens[player] or 0) + paid
	match.Tokens[player] = total
	match.TeamTokens = match.TeamTokens + base -- team progress counts the course's own token value
	setAttr(player, Config.Attr.MatchTokens, total)
	creditTokens(player, paid)
	queueTokenToast(match, player, paid, base)
end

----------------------------------------------------------------------
-- Checkpoints, finish, void
----------------------------------------------------------------------
-- The checkpoint taken next after `from`: the lowest usable index above it (nil after the last).
-- Checkpoints count in order only, so a cannon flight or a lucky jump onto a later stage never skips one (bug #8).
local function nextCheckpointFrom(match, from)
	local checkpoints = match.Course.Checkpoints
	for index = from + 1, match.MaxCheckpoint do
		if checkpoints[index] then
			return index
		end
	end
	return nil
end

local function nextCheckpointIndex(match)
	return nextCheckpointFrom(match, match.Checkpoint)
end

-- (C22) the player's own trail: `index` is the checkpoint they are at now (reached by them, or the server put them
-- there); it only ever moves forward
local function markTrail(match, player, index)
	local rec = match.Recs[player]
	if rec and type(index) == "number" and index > (rec.Checkpoint or 0) then
		rec.Checkpoint = index
	end
end

-- (C22) the server placed the player at the team checkpoint (void rescue, revive, respawn): their trail is there
local function placedAtTeamCheckpoint(match, player)
	markTrail(match, player, match.Checkpoint)
end

-- (C22) is the player near this checkpoint pad (standing on it, or passing it within TRAIL_PAD / TRAIL_ABOVE)?
local function nearPad(cp, pos)
	local part = cp and cp.Part
	return part ~= nil and part.Parent ~= nil and isOverPart(part, pos, TRAIL_PAD, PAD_BELOW, TRAIL_ABOVE)
end

-- (C22) why the finish does not count for this player yet -> log text, toast text | nil when it does
local function finishRefusal(match, player, t)
	local rec = match.Recs[player]
	local at = rec and rec.Checkpoint or 0
	local missing = nextCheckpointFrom(match, at)
	if missing then
		return string.format("their trail ends at checkpoint %d of %d (next %d)", at, match.MaxCheckpoint, missing),
			string.format("Checkpoint %d first!", missing) -- (C22 review) the pad they missed, also when the team has it
	end
	local played = match.StartedAt and ((t or clock()) - match.StartedAt) or 0
	if type(match.MinSeconds) == "number" and played < match.MinSeconds then
		-- the wait as a clock ("0:12", like BattleService's waits): one short line, no lone "s" wrapped onto a second one
		local wait = math.max(1, math.ceil(match.MinSeconds - played))
		return string.format("%.1f s played, the course cannot be run under %.1f s", played, match.MinSeconds),
			string.format("Finish opens in %d:%02d", math.floor(wait / 60), wait % 60)
	end
	return nil
end

-- (C22 review) how far a footprint reaches along the horizontal vector w: the part's top rectangle grown `slack` studs
-- past each edge (the window isOverPart tests), in the part's own axes so a pad at any heading works
local function footprintReach(part, w, slack)
	local cf, hs = part.CFrame, part.Size * 0.5
	return math.abs(w:Dot(cf.RightVector)) * (hs.X + slack) + math.abs(w:Dot(cf.LookVector)) * (hs.Z + slack)
end

local function flatOf(v)
	return Vector3.new(v.X, 0, v.Z)
end

-- (C22) the shortest honest time to the finish of this course (seconds), see FLOOR_PACE. The chain's nodes are the start
-- spot (players start within START_SPREAD of it), every checkpoint pad and the finish pad (each within TOUCH_SLACK of
-- its edge). A path that visits node i at c_i + d_i is at least sum u_k . (p_{k+1} - p_k) long (u_k the unit direction of
-- chain link k), which is the chain's length plus sum d_i . (u_{i-1} - u_i): so the chain less each node's reach along
-- its turn u_{i-1} - u_i is a lower bound (exact on a straight chain, no guess at the real route).
local function minFinishSeconds(match)
	local course = match.Course
	local nodes = { { Pos = flatOf(course.StartCFrame.Position), Part = nil, Slack = START_SPREAD } }
	for index = 1, match.MaxCheckpoint do
		local cp = course.Checkpoints[index]
		if cp and cp.Part then
			nodes[#nodes + 1] = { Pos = flatOf(cp.Part.Position), Part = cp.Part, Slack = TOUCH_SLACK }
		end
	end
	if course.Finish then
		nodes[#nodes + 1] = { Pos = flatOf(course.Finish.Position), Part = course.Finish, Slack = TOUCH_SLACK }
	end
	local zero = Vector3.new(0, 0, 0)
	local dirs = {}
	local length = 0
	for i = 2, #nodes do
		local d = nodes[i].Pos - nodes[i - 1].Pos
		local m = d.Magnitude
		length = length + m
		dirs[i - 1] = (m > 1e-6) and (d / m) or zero
	end
	for i, node in ipairs(nodes) do
		local turn = (dirs[i - 1] or zero) - (dirs[i] or zero)
		if node.Part then
			length = length - footprintReach(node.Part, turn, node.Slack)
		else
			length = length - node.Slack * turn.Magnitude
		end
	end
	-- cannon legs: a flight carries its rider at most `carried` studs (pad centre to Target, plus the pad, a touch and the
	-- launch spot's drift) in FlightTime seconds; the 0.35 s charge is not counted
	local carried, flights = 0, 0
	local layout = match.Layout
	if type(layout) == "table" and type(layout.Steps) == "table" then
		for _, step in ipairs(layout.Steps) do
			local h = step.Hazard
			if step.Kind == "CannonPad" and type(h) == "table" and typeof(h.Pos) == "Vector3" and typeof(h.Target) == "Vector3" then
				carried = carried + flatOf(h.Target - h.Pos).Magnitude + numberOr(h.PadRadius, 3) * 1.5 + TOUCH_SLACK
				flights = flights + math.max(0, numberOr(h.FlightTime, 0))
			end
		end
	end
	return math.max(0, length - carried) / FLOOR_PACE + flights
end

reachCheckpoint = function(match, index, byPlayer)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	if index ~= nextCheckpointIndex(match) then
		return -- an older one, or a later one before the one in between: ignored, never a skip
	end
	local cp = match.Course.Checkpoints[index]
	if not cp then
		return
	end
	match.Checkpoint = index
	if byPlayer then
		markTrail(match, byPlayer, index) -- (C22) the one who took it is there
	end
	notifyAll(match, string.format("Checkpoint %d/%d reached!", index, match.TotalCheckpoints), "good", 3.5)

	-- heal everyone who is up (pets can boost their owner's heal), collect the downed
	local downedList = {}
	for _, p in ipairs(copyList(match.Players)) do
		if isMember(match, p) then
			if isDowned(p) then
				table.insert(downedList, p)
			else
				local fraction = Config.Damage.CheckpointHealFraction * (1 + perkOf(p, "CheckpointHeal"))
				callDep("DamageService", "HealFraction", p, Util.Clamp(fraction, 0, 1))
			end
		end
	end

	-- lift up the downed teammates right here
	for i, p in ipairs(downedList) do
		teleportTo(p, spreadCFrame(cp.SpawnCFrame, i, #downedList, CHECKPOINT_SPREAD))
		placedAtTeamCheckpoint(match, p) -- (C22)
		callDep("DamageService", "Revive", p)
		local who = "your team"
		if byPlayer and byPlayer ~= p then
			who = nameOf(byPlayer)
		end
		notify(p, "Revived by " .. who .. "!", "good", 3)
	end
	if #downedList > 0 then
		notifyAll(match, "Team is back on its feet!", "good", 3)
	end
	broadcastState(match)
end

local function onCheckpointTouched(match, index, hit)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	local player = Util.PlayerFromPart(hit)
	if not player or not isMember(match, player) then
		return
	end
	if isDowned(player) or match.Finished[player] then
		return
	end
	local hum, root = getLive(player)
	if not hum or not root then
		return
	end
	-- (C22 review) the touch counts only with the player AT the pad (the poll's windows): an exploit client can fire
	-- touches for its own parts from anywhere on the course
	local cp = match.Course.Checkpoints[index]
	local pos = root.Position
	-- (C22) the player's own trail: this pad, when it is the next one on it
	local rec = match.Recs[player]
	if rec and index == nextCheckpointFrom(match, rec.Checkpoint or 0) and nearPad(cp, pos) then
		markTrail(match, player, index)
	end
	if cp and cp.Part and cp.Part.Parent and isOverPart(cp.Part, pos, TOUCH_SLACK, PAD_BELOW, PAD_ABOVE) then
		reachCheckpoint(match, index, player)
	end
end

markFinished = function(match, player)
	if match.State ~= "Playing" or match.Finished[player] then
		return
	end
	if isDowned(player) or not isMember(match, player) then
		return
	end
	-- (C22) the finish counts only after the player's own trail (every checkpoint, in order, or the server placing
	-- them at the team's) and never before the course's shortest honest time; a refusal is logged once per player and
	-- (review) told every REFUSAL_TOAST_EVERY seconds while they stay on the pad: the missing pad, or the wait
	local now = clock()
	local why, toast = finishRefusal(match, player, now)
	if why then
		local rec = match.Recs[player]
		if rec then
			if not rec.FinishRefused then
				rec.FinishRefused = true
				warn(string.format("[MatchService] finish refused for %s (match %d, %s): %s", nameOf(player), match.Id, tostring(match.DifficultyId), why))
			end
			if not rec.RefusalToastAt or now - rec.RefusalToastAt >= REFUSAL_TOAST_EVERY then
				rec.RefusalToastAt = now
				notify(player, toast, "bad", 3)
			end
		end
		return
	end
	-- (C22 review) a finish close to the floor is accepted and logged: a waited-out teleport run looks like this
	local played = match.StartedAt and (now - match.StartedAt) or 0
	if type(match.MinSeconds) == "number" and match.MinSeconds > 0 and played < match.MinSeconds * FAST_FINISH_LOG then
		warn(string.format("[MatchService] fast finish by %s (match %d, %s): %.1f s played, the floor is %.1f s", nameOf(player), match.Id, tostring(match.DifficultyId), played, match.MinSeconds))
	end
	match.Finished[player] = true
	match.FinishCount = match.FinishCount + 1
	-- park them safely on the pad and keep them out of harm's way
	teleportTo(player, spreadCFrame(finishCFrame(match), match.FinishCount, Config.Match.MaxPlayers, FINISH_SPREAD))
	setFrozen(player, true)
	callDep("DamageService", "GrantInvulnerability", player, 3)
	notify(player, "You made it! Wait for your team.", "good", 4)
	notifyAll(match, nameOf(player) .. " reached the finish!", "good", 3, player)
	broadcastState(match)
end

local function onFinishTouched(match, hit)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	local player = Util.PlayerFromPart(hit)
	if not player or not isMember(match, player) then
		return
	end
	local hum, root = getLive(player)
	if not hum or not root then
		return
	end
	-- (C22 review) only with the player AT the finish pad (a reported touch from anywhere else is ignored)
	local pad = match.Course.Finish
	if not (pad and pad.Parent and isOverPart(pad, root.Position, TOUCH_SLACK, PAD_BELOW, PAD_ABOVE)) then
		return
	end
	markFinished(match, player)
end

-- Player fell below the course. Damage them (unless downed / finished), then bring them back.
local function handleVoid(match, player, wasDowned, finished)
	if finished then
		teleportTo(player, finishCFrame(match))
		return
	end
	if not wasDowned then
		local dmg = Config.Damage.VoidDamage[match.DifficultyId] or 20
		callDep("DamageService", "Damage", player, dmg, "Void", { IgnoreIFrames = true })
	end
	teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
	placedAtTeamCheckpoint(match, player) -- (C22)
	if not isDowned(player) then
		callDep("DamageService", "GrantInvulnerability", player, 1.5)
	end
end

-- Is the player standing on (or a step above) something solid? Humanoid.FloorMaterial answers that on
-- the peer that simulates the character; this runs on the server, so a short ray down from the root
-- backs it up and the rule keeps working even where the server never sees a floor material.
-- CanCollide = false parts (tokens, storm / wind volumes, faded clouds) are ignored like physics does.
local function isGrounded(hum, root)
	local okFloor, floor = pcall(function()
		return hum.FloorMaterial
	end)
	if okFloor and floor ~= nil and floor ~= Enum.Material.Air then
		return true
	end
	local okRay, hit = pcall(function()
		if not groundParams then
			groundParams = RaycastParams.new()
			groundParams.FilterType = Enum.RaycastFilterType.Exclude
			groundParams.RespectCanCollide = true
		end
		groundParams.FilterDescendantsInstances = { root.Parent }
		return Workspace:Raycast(root.Position, Vector3.new(0, -GROUND_REACH, 0), groundParams)
	end)
	return okRay and hit ~= nil
end

-- Laps are stacked: a missed jump on a Spiral (or any overlapping layout) usually lands on a lower lap
-- 15-40 studs down, long before KillY, so the plane alone never punishes it and the player is stranded
-- behind the team. Per player we remember the height they last stood at (rec.LastGroundY) and whether
-- they have been in the air since (rec.Airborne). Touching ground again more than FALL_DROP studs below
-- that height is a fall: this returns true ONCE, then the caller rescues the player (handleVoid /
-- teleport), which also clears the memory.
--   * only a settled poll (on the ground, not falling fast) is judged and may move the reference, so a
--     cannon flight, bounce, dash or the last metres of a fall can neither trigger nor corrupt it; the
--     legitimate landings after a launch are at most 4 studs below the take-off (see FALL_DROP)
--   * a real fall always has a poll that is moving down in the air before the landing (>= 0.35 s in the
--     air against a 0.25 s poll), so a position that merely jumps (teleport, respawn, lag) with no such
--     poll in between is never read as a fall
--   * the reference is the player's OWN last standing height, not the team checkpoint: stragglers on the
--     previous stage can be ~15 studs below the new checkpoint and are not falling
--   * a new character (respawn) and every teleportTo() start with a clean slate
-- Call it only for live members who are neither downed nor finished.
local function landedOnLowerLap(match, player, hum, root)
	local rec = match.Recs[player]
	if not rec then
		return false
	end
	if rec.GroundRoot ~= root then
		rec.GroundRoot = root
		rec.LastGroundY = nil
		rec.Airborne = false
	end
	local vy = numberOr(root.AssemblyLinearVelocity.Y, 0)
	if vy < -FALLING_SPEED then
		rec.Airborne = true
		return false
	end
	if not isGrounded(hum, root) then
		if vy < -DESCENT_SPEED then
			rec.Airborne = true
		end
		return false
	end
	local y = root.Position.Y
	local last = rec.LastGroundY
	local flew = rec.Airborne == true
	rec.Airborne = false
	if flew and last and y < last - FALL_DROP then
		rec.LastGroundY = nil
		return true
	end
	rec.LastGroundY = y
	return false
end

----------------------------------------------------------------------
-- Per-player hooks: character respawn + death
----------------------------------------------------------------------
local function attachDied(match, player, hum)
	local rec = match.Recs[player]
	if not rec then
		return
	end
	if rec.DiedConn then
		rec.DiedConn:Disconnect()
		rec.DiedConn = nil
	end
	rec.DiedConn = hum.Died:Connect(function()
		if match.Stopped or not isMember(match, player) then
			return
		end
		-- a KO'd character that dies for real (reset button) comes back healthy at the checkpoint
		setAttr(player, Config.Attr.Downed, false)
		broadcastState(match)
	end)
end

local function onCharacterAdded(match, player, char)
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not hum or not root then
			return
		end
		if not isMember(match, player) or match.Stopped then
			return
		end
		attachDied(match, player, hum)

		task.wait(RESPAWN_FIX_DELAY)
		if match.Stopped or not isMember(match, player) then
			return
		end
		if player.Character ~= char or hum.Parent == nil or hum.Health <= 0 then
			return
		end

		-- PlayerService normally already placed us via GetRespawnCFrame; make sure.
		local finished = match.Finished[player] == true
		local target = teamSpawnCFrame(match)
		if finished then
			target = finishCFrame(match)
		end
		if (root.Position - target.Position).Magnitude > 80 then
			if finished then
				teleportTo(player, spreadCFrame(target, 1, Config.Match.MaxPlayers, FINISH_SPREAD))
			else
				teleportTo(player, jitterCFrame(target, CHECKPOINT_SPREAD))
			end
		end
		if not finished then
			placedAtTeamCheckpoint(match, player) -- (C22) a respawn comes back at the team checkpoint
		end

		-- respawn rule: back at the checkpoint immediately, 50% health, no penalty
		setAttr(player, Config.Attr.Downed, false)
		callDep("DamageService", "SetHealthFraction", player, Config.Damage.ReviveHealthFraction)
		callDep("DamageService", "GrantInvulnerability", player, 2)
		if match.State == "Countdown" or finished then
			setFrozen(player, true)
		end
	end)
end

local function hookPlayer(match, player)
	local rec = match.Recs[player]
	if not rec then
		return
	end
	table.insert(rec.Conns, player.CharacterAdded:Connect(function(char)
		onCharacterAdded(match, player, char)
	end))
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			attachDied(match, player, hum)
		end
	end
end

----------------------------------------------------------------------
-- Membership
----------------------------------------------------------------------
local function enrollPlayer(match, player, index, count)
	playerMatch[player] = match
	match.Tokens[player] = 0
	match.Recs[player] = { Conns = {}, Checkpoint = 0 }
	-- InMatch first: the lobby watchdog would otherwise yank a player standing at y=800 home
	setAttr(player, Config.Attr.InMatch, true)
	setAttr(player, Config.Attr.Downed, false)
	setAttr(player, Config.Attr.MatchTokens, 0)
	callDep("DamageService", "SetHealthFraction", player, 1)
	callDep("DamageService", "GrantInvulnerability", player, Config.Match.IntroCountdown + 2)
	teleportTo(player, spreadCFrame(match.Course.StartCFrame, index, count, START_SPREAD))
	setFrozen(player, true)
	hookPlayer(match, player)
end

-- Remove a player from a match and (optionally) send them home. Does not end the match.
detachPlayer = function(match, player, toLobby)
	if playerMatch[player] ~= match then
		return
	end
	playerMatch[player] = nil
	removeValue(match.Players, player)
	match.Alive[player] = nil
	local rec = match.Recs[player]
	match.Recs[player] = nil
	if rec then
		for _, conn in ipairs(rec.Conns) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		if rec.DiedConn then
			pcall(function()
				rec.DiedConn:Disconnect()
			end)
		end
	end
	-- a rider leaving mid cannon flight gets the steering (WalkSpeed / AutoRotate) back now, not at the touchdown
	callDep("HazardService", "ReleaseFlight", player)
	if player.Parent == nil then
		return -- they left the game, nothing to restore
	end

	local wasDowned = isDowned(player)
	setFrozen(player, false)
	if wasDowned then
		-- silently leave the downed state (restores look + walk speed); fall back to a full Revive
		local cleared = callDep("DamageService", "ClearDowned", player)
		if not cleared then
			callDep("DamageService", "Revive", player)
		end
	end
	setAttr(player, Config.Attr.InMatch, false)
	setAttr(player, Config.Attr.Downed, false)
	setAttr(player, Config.Attr.MatchTokens, 0)
	fireClient("MatchState", player, nil)
	if toLobby then
		callDep("PlayerService", "ApplyHumanoidStats", player)
		callDep("PlayerService", "SendToLobby", player)
	end
end

----------------------------------------------------------------------
-- Cleanup
----------------------------------------------------------------------
cleanupMatch = function(match)
	if match.CleanedUp then
		return
	end
	match.CleanedUp = true
	match.Stopped = true
	if match.State ~= "Ended" then
		match.State = "Ended"
	end
	if not match.Reason then
		match.Reason = "abandoned"
	end

	-- 1. stop everything that runs inside the course
	stopHazards(match)
	stopTokens(match)

	-- 2. event connections owned by the match
	for _, conn in ipairs(match.Connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	match.Connections = {}

	-- 3. players home (each in its own pcall so one bad character cannot strand the rest)
	for _, p in ipairs(copyList(match.Players)) do
		local ok, err = pcall(detachPlayer, match, p, true)
		if not ok then
			warn("[MatchService] detach failed: " .. tostring(err))
			playerMatch[p] = nil
		end
	end
	match.Players = {}
	match.Alive = {}

	-- 4. the course itself
	destroyCourse(match)

	-- 5. free the slot
	if slots[match.Slot] == match then
		slots[match.Slot] = nil
	end
	matches[match.Id] = nil

	-- 6. tell the world
	MatchService.MatchEnded:Fire(match, match.Won == true)
end

----------------------------------------------------------------------
-- Ending a match (victory / defeat / timeout / abandoned)
----------------------------------------------------------------------
-- Stats for every member: Matches always, Wins + BestTimes only for finishers of a won match.
-- Runs off the worker thread so a slow DataService can never stall the match state machine.
local function recordStats(match, roster, won, seconds)
	local diffId = match.DifficultyId
	local finished = {}
	for _, p in ipairs(roster) do
		finished[p] = won and match.Finished[p] == true
	end
	task.spawn(function()
		for _, p in ipairs(roster) do
			if p.Parent ~= nil then
				callDep("DataService", "RecordMatch", p, diffId, finished[p] == true, seconds)
				callDep("DataService", "Sync", p)
			end
		end
	end)
end

endMatch = function(match, won, reason)
	if match.Stopped or match.State == "Ended" then
		return
	end
	local t = clock()
	local playSeconds = 0
	if match.StartedAt then
		playSeconds = t - match.StartedAt
	end
	if reason == "timeout" then
		playSeconds = match.Difficulty.TimeLimit
	end
	match.State = "Ended"
	match.Won = won
	match.Reason = reason
	match.EndedAt = t
	stopTokens(match)

	if reason == "abandoned" or #match.Players == 0 then
		cleanupMatch(match)
		return
	end

	-- victory bonus goes to everybody who made it to the finish
	local bonusValue = 0
	if won then
		bonusValue = Config.Match.TokenBonusOnWin[match.DifficultyId] or 0
	end
	local bonuses = {}
	for _, p in ipairs(match.Players) do
		if won and bonusValue > 0 and match.Finished[p] then
			bonuses[p] = bonusValue
			creditTokens(p, bonusValue)
		end
	end

	recordStats(match, copyList(match.Players), won, Util.Round(playSeconds, 1))

	local members = {}
	for _, p in ipairs(match.Players) do
		members[#members + 1] = {
			Name = nameOf(p),
			MatchTokens = match.Tokens[p] or 0,
			Finished = match.Finished[p] == true,
			Downed = isDowned(p),
		}
	end
	local diff = match.Difficulty
	for _, p in ipairs(match.Players) do
		fireClient("MatchResult", p, {
			Won = won,
			Reason = reason,
			Seconds = math.floor(playSeconds + 0.5),
			MatchTokens = match.Tokens[p] or 0,
			Bonus = bonuses[p] or 0,
			DifficultyId = diff.Id,
			DifficultyName = diff.DisplayName,
			Stars = diff.Stars,
			TotalTokens = (match.Course and match.Course.TotalTokens) or 0,
			Members = members,
		})
		callDep("DamageService", "GrantInvulnerability", p, 2)
	end

	match.EndDeadline = t + Config.Match.EndScreenSeconds
	broadcastState(match)
end

----------------------------------------------------------------------
-- The worker loop
----------------------------------------------------------------------
local function refreshAlive(match)
	local alive = {}
	for _, p in ipairs(match.Players) do
		if not isDowned(p) then
			alive[p] = true
		end
	end
	match.Alive = alive
end

local function beginPlaying(match, t)
	match.State = "Playing"
	match.StartedAt = t
	match.LastStateAt = 0
	for _, p in ipairs(copyList(match.Players)) do
		if isMember(match, p) and not match.Finished[p] then
			setFrozen(p, false)
		end
	end
	notifyAll(match, "Go! Climb together.", "good", 3.5)
	broadcastState(match)
end

local function processPlayerPlaying(match, player)
	local hum, root = getLive(player)
	if not hum or not root then
		return
	end
	local course = match.Course
	local downed = isDowned(player)
	local finished = match.Finished[player] == true

	if root.Position.Y < killYOf(match) then
		handleVoid(match, player, downed, finished)
		return
	end
	if downed or finished then
		return
	end

	-- missed jump onto a lower lap of a stacked course: same penalty as falling into the void
	if landedOnLowerLap(match, player, hum, root) then
		handleVoid(match, player, false, false)
		return
	end

	-- checkpoints: only the NEXT one counts (in order, bug #8); standing on a later one does nothing until then
	local pos = root.Position
	local nextIndex = nextCheckpointIndex(match)
	local cp = nextIndex and course.Checkpoints[nextIndex]
	if cp and cp.Part and cp.Part.Parent and isOverPart(cp.Part, pos, 2, PAD_BELOW, PAD_ABOVE) then
		reachCheckpoint(match, nextIndex, player)
	end
	-- (C22) the player's own trail: their next pad, when they are near it (looser than the team's test on purpose)
	local rec = match.Recs[player]
	if rec then
		local mine = nextCheckpointFrom(match, rec.Checkpoint or 0)
		if mine and nearPad(course.Checkpoints[mine], pos) then
			markTrail(match, player, mine)
		end
	end

	local pad = course.Finish
	if pad and pad.Parent and isOverPart(pad, pos, 1, PAD_BELOW, PAD_ABOVE) then
		markFinished(match, player)
	end
end

local function tickPlaying(match, t)
	for _, player in ipairs(copyList(match.Players)) do
		if isMember(match, player) and match.State == "Playing" and not match.Stopped then
			local ok, err = pcall(processPlayerPlaying, match, player)
			if not ok then
				warn("[MatchService] player tick failed: " .. tostring(err))
			end
			if match.Finished[player] then
				callDep("DamageService", "GrantInvulnerability", player, 1)
			end
		end
	end
	if match.State ~= "Playing" or match.Stopped then
		return
	end

	refreshAlive(match)
	local aliveCount = 0
	local finishedAlive = 0
	for p in pairs(match.Alive) do
		aliveCount = aliveCount + 1
		if match.Finished[p] then
			finishedAlive = finishedAlive + 1
		end
	end

	if aliveCount > 0 and finishedAlive == aliveCount then
		endMatch(match, true, "victory")
		return
	end
	if aliveCount == 0 then
		endMatch(match, false, "defeat")
		return
	end

	local limit = match.Difficulty.TimeLimit
	local left = limit - (t - match.StartedAt)
	if left <= 0 then
		endMatch(match, false, "timeout")
		return
	end
	if limit > 150 and left <= 60 and not match.Warned60 then
		match.Warned60 = true
		notifyAll(match, "One minute left!", "bad", 4)
	end

	if t - match.LastStateAt >= STATE_INTERVAL then
		broadcastState(match)
	end
end

local function tickEnded(match, t)
	local killY = killYOf(match)
	for _, player in ipairs(copyList(match.Players)) do
		if isMember(match, player) then
			callDep("DamageService", "GrantInvulnerability", player, 1)
			local hum, root = getLive(player)
			if hum and root then
				-- no damage on the results screen, just bring them back
				if root.Position.Y < killY then
					if match.Finished[player] then
						teleportTo(player, finishCFrame(match))
					else
						teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
					end
				elseif not match.Finished[player] and not isDowned(player) and landedOnLowerLap(match, player, hum, root) then
					-- missed jump onto a lower lap: same free rescue
					teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
				end
			end
		end
	end
	if t >= (match.EndDeadline or t) then
		cleanupMatch(match)
		return
	end
	if t - match.LastStateAt >= STATE_INTERVAL then
		broadcastState(match)
	end
end

local function tickMatch(match)
	local t = clock()
	if #match.Players == 0 then
		if match.State ~= "Ended" then
			match.State = "Ended"
			match.Won = false
			match.Reason = "abandoned"
		end
		cleanupMatch(match)
		return
	end
	refreshAlive(match)

	if match.State == "Countdown" then
		if t >= match.CountdownEnd then
			beginPlaying(match, t)
		else
			local remaining = math.ceil(match.CountdownEnd - t)
			if remaining ~= match.LastCountdown then
				match.LastCountdown = remaining
				broadcastState(match)
			end
		end
	elseif match.State == "Playing" then
		tickPlaying(match, t)
	elseif match.State == "Ended" then
		tickEnded(match, t)
	end
end

local function runMatch(match)
	local errors = 0
	while not match.Stopped do
		local ok, err = pcall(tickMatch, match)
		if ok then
			errors = 0
		else
			errors = errors + 1
			warn("[MatchService] tick error (match " .. tostring(match.Id) .. "): " .. tostring(err))
			if errors >= MAX_TICK_ERRORS then
				warn("[MatchService] closing broken match " .. tostring(match.Id))
				pcall(cleanupMatch, match)
				break
			end
		end
		task.wait(TICK)
	end
end

----------------------------------------------------------------------
-- Setup
----------------------------------------------------------------------
local function allocateSlot()
	for s = 1, Config.Match.MaxConcurrent do
		if slots[s] == nil then
			return s
		end
	end
	return nil
end

-- True when another live match already uses this layout seed (course folders are named after it).
local function seedInUse(match, seed)
	for _, m in pairs(matches) do
		if m ~= match and m.Seed == seed then
			return true
		end
	end
	return false
end

-- Keep only checkpoints the match can actually use: a table with a numeric index and a spawn
-- CFrame (derived from the pad when the builder did not supply one).
local function cleanCheckpoints(raw)
	local clean = {}
	local count = 0
	local maxIndex = 0
	for index, cp in pairs(raw or {}) do
		if type(index) == "number" and type(cp) == "table" then
			if typeof(cp.SpawnCFrame) ~= "CFrame" and cp.Part then
				cp.SpawnCFrame = cp.Part.CFrame * CFrame.new(0, cp.Part.Size.Y / 2 + 3.5, 0)
			end
			if typeof(cp.SpawnCFrame) == "CFrame" then
				clean[index] = cp
				count = count + 1
				if index > maxIndex then
					maxIndex = index
				end
			end
		end
	end
	return clean, count, maxIndex
end

-- Generate (and validate) a layout, build the course, attach hazards + token pickup, and hook the
-- checkpoint / finish touch events. Errors propagate to the caller (StartMatch cleans up).
local function setupCourse(match)
	local CB = deps.CourseBuilder
	if not CB or type(CB.GenerateLayout) ~= "function" or type(CB.Build) ~= "function" then
		error("CourseBuilder dependency missing")
	end
	match.Origin = Config.Match.ArenaOrigin + Vector3.new((match.Slot - 1) * Config.Match.SlotSpacing, 0, 0)

	local layout = nil
	for attempt = 1, LAYOUT_ATTEMPTS do
		-- match ids are unique per server, so ids far apart in seed space keep concurrent matches
		-- from sharing a seed (and thus a Course_<seed> folder name); bump past any live collision
		local seed = os.time() + match.Id * 100003 + attempt
		while seedInUse(match, seed) do
			seed = seed + 1
		end
		local okLayout, result = pcall(CB.GenerateLayout, match.DifficultyId, seed)
		if okLayout and type(result) == "table" then
			layout = result
			match.Seed = result.Seed or seed
			local valid = true
			if type(CB.ValidateLayout) == "function" then
				local okValid, isValid, problems = pcall(CB.ValidateLayout, result)
				if okValid and isValid == false then
					valid = false
					local first = "?"
					if type(problems) == "table" and problems[1] then
						first = tostring(problems[1])
					end
					warn("[MatchService] layout seed " .. tostring(seed) .. " failed validation: " .. first)
				end
			end
			if valid then
				break
			end
		else
			warn("[MatchService] GenerateLayout failed: " .. tostring(result))
		end
	end
	if not layout then
		error("could not generate a course layout")
	end

	local okBuild, info = pcall(CB.Build, layout, match.Origin, Workspace)
	if not okBuild or type(info) ~= "table" then
		error("course build failed: " .. tostring(info))
	end
	match.Layout = layout
	match.Course = info
	if typeof(info.StartCFrame) ~= "CFrame" or not info.Finish then
		error("course is missing its start or finish")
	end
	match.Archetype = info.Archetype or layout.Archetype

	local clean, count, maxIndex = cleanCheckpoints(info.Checkpoints)
	info.Checkpoints = clean
	match.TotalCheckpoints = count
	match.MaxCheckpoint = maxIndex
	match.MinSeconds = minFinishSeconds(match) -- (C22)

	-- hazards pause unless the match is actually being played
	local hazardHandle = {
		IsActive = function()
			return match.State == "Playing" and not match.Stopped
		end,
	}
	local HS = deps.HazardService
	if HS and type(HS.Attach) == "function" then
		local okH, stopH = pcall(HS.Attach, info.Folder, hazardHandle)
		if okH and type(stopH) == "function" then
			match.StopHazards = stopH
		elseif not okH then
			warn("[MatchService] HazardService.Attach failed: " .. tostring(stopH))
		end
	end

	local TS = deps.TokenService
	if TS and type(TS.Watch) == "function" then
		local tokenHandle = {
			AddTokens = function(player, n)
				addTokens(match, player, n)
			end,
		}
		local okT, stopT = pcall(TS.Watch, info.Folder, tokenHandle)
		if okT and type(stopT) == "function" then
			match.StopTokens = stopT
		elseif not okT then
			warn("[MatchService] TokenService.Watch failed: " .. tostring(stopT))
		end
	end

	-- Touched gives instant feedback, the 4 Hz proximity poll in the worker loop is the backup.
	for index, cp in pairs(info.Checkpoints) do
		if cp.Part then
			table.insert(match.Connections, cp.Part.Touched:Connect(function(hit)
				onCheckpointTouched(match, index, hit)
			end))
		end
	end
	table.insert(match.Connections, info.Finish.Touched:Connect(function(hit)
		onFinishTouched(match, hit)
	end))
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- deps = { PlayerService, DamageService, DataService, HazardService, TokenService, CourseBuilder,
--          PetService }
function MatchService.Init(d)
	deps = d or deps or {}
	if initialized then
		return
	end
	initialized = true

	-- Reset-button deaths should respawn quickly (the match rule is "back at the checkpoint").
	pcall(function()
		if Players.RespawnTime > SHORT_RESPAWN_TIME then
			Players.RespawnTime = SHORT_RESPAWN_TIME
		end
	end)

	local okRemote, leaveRemote = pcall(Remotes.Get, "LeaveMatch")
	if okRemote and leaveRemote then
		leaveRemote.OnServerEvent:Connect(function(player)
			MatchService.LeaveMatch(player)
		end)
	else
		warn("[MatchService] LeaveMatch remote unavailable")
	end

	Players.PlayerRemoving:Connect(function(player)
		local match = playerMatch[player]
		if match then
			detachPlayer(match, player, false)
			if #match.Players == 0 and not match.CleanedUp then
				if match.State ~= "Ended" then
					match.State = "Ended"
					match.Won = false
					match.Reason = "abandoned"
				end
				cleanupMatch(match)
			end
		end
		tokenCarry[player] = nil
		tokenToast[player] = nil
	end)

	local dmg = deps.DamageService
	if dmg and dmg.PlayerDowned and type(dmg.PlayerDowned.Connect) == "function" then
		dmg.PlayerDowned:Connect(function(player)
			local match = playerMatch[player]
			if not match or match.State ~= "Playing" or match.Stopped then
				return
			end
			notifyAll(match, nameOf(player) .. " is down! Next flag revives.", "bad", 4, player)
			broadcastState(match)
		end)
	end
end

-- Start a match for `players` on the lowest free slot. Returns the match, or nil when no arena
-- slot is free / the course could not be built.
function MatchService.StartMatch(difficultyId, players)
	if not initialized then
		warn("[MatchService] StartMatch before Init")
		return nil
	end
	local diff = Config.GetDifficulty(difficultyId)
	if not diff then
		warn("[MatchService] unknown difficulty " .. tostring(difficultyId))
		return nil
	end

	local candidates = {}
	local seen = {}
	for _, p in ipairs(players or {}) do
		if p and p.Parent ~= nil and not seen[p] and not playerMatch[p] and #candidates < Config.Match.MaxPlayers then
			seen[p] = true
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		return nil
	end

	local slot = allocateSlot()
	if not slot then
		return nil
	end

	nextMatchId = nextMatchId + 1
	local match = {
		Id = nextMatchId,
		DifficultyId = diff.Id,
		Difficulty = diff,
		Slot = slot,
		Players = {},
		Alive = {},
		State = "Setup",
		Checkpoint = 0,
		TotalCheckpoints = 0,
		MaxCheckpoint = 0,
		StartedAt = nil,
		Course = nil,
		Won = false,
		Reason = nil,
		TeamTokens = 0, -- course token value collected by the team (pet bonus not included)
		FinishCount = 0,
		LastStateAt = 0,
		Tokens = {}, -- Player -> tokens paid out this match (pet bonus included)
		Finished = {}, -- Player -> true
		Recs = {}, -- Player -> { Conns, DiedConn, Checkpoint (C22: the player's own trail), FinishRefused, RefusalToastAt }
		MinSeconds = 0, -- (C22) the course's shortest honest time, set by setupCourse
		Connections = {}, -- match-level connections (checkpoint / finish Touched)
		Stopped = false,
		CleanedUp = false,
	}
	slots[slot] = match -- reserve the slot before anything can yield
	matches[match.Id] = match

	local okSetup, errSetup = pcall(setupCourse, match)
	if not okSetup then
		warn("[MatchService] setup failed: " .. tostring(errSetup))
		match.Stopped = true
		stopHazards(match)
		stopTokens(match)
		for _, conn in ipairs(match.Connections) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		destroyCourse(match)
		slots[slot] = nil
		matches[match.Id] = nil
		return nil
	end

	-- players may have left while the course was being built
	local present = {}
	for _, p in ipairs(candidates) do
		if p.Parent ~= nil and not playerMatch[p] then
			table.insert(present, p)
		end
	end
	if #present == 0 then
		match.Won = false
		match.Reason = "abandoned"
		cleanupMatch(match)
		return nil
	end

	match.Players = present
	for i, p in ipairs(present) do
		local ok, err = pcall(enrollPlayer, match, p, i, #present)
		if not ok then
			warn("[MatchService] enroll failed for " .. tostring(p.Name) .. ": " .. tostring(err))
		end
	end
	refreshAlive(match)

	match.State = "Countdown"
	match.CountdownEnd = clock() + Config.Match.IntroCountdown
	match.LastCountdown = math.ceil(Config.Match.IntroCountdown)
	broadcastState(match)

	local welcome = "Welcome to " .. diff.DisplayName .. "!"
	if type(match.Archetype) == "string" and match.Archetype ~= "" then
		welcome = diff.DisplayName .. ": " .. match.Archetype .. " course"
	end
	for _, p in ipairs(present) do
		notify(p, welcome, "info", 3)
	end

	task.spawn(runMatch, match)
	return match
end

function MatchService.GetMatchOf(player)
	return playerMatch[player]
end

-- SpawnProvider for PlayerService: team checkpoint spawn (scattered), nil => lobby spawn.
function MatchService.GetRespawnCFrame(player)
	local match = playerMatch[player]
	if not match or match.Stopped or not match.Course then
		return nil
	end
	if match.Finished[player] then
		return spreadCFrame(finishCFrame(match), random:NextInteger(1, 4), 4, FINISH_SPREAD)
	end
	local spread = CHECKPOINT_SPREAD
	if match.Checkpoint < 1 then
		spread = START_SPREAD
	end
	placedAtTeamCheckpoint(match, player) -- (C22) PlayerService spawns them at the team checkpoint
	return jitterCFrame(teamSpawnCFrame(match), spread)
end

-- Player goes back to the lobby; the match carries on without them (or closes if they were last).
function MatchService.LeaveMatch(player)
	local match = playerMatch[player]
	if not match then
		return
	end
	local name = nameOf(player)
	detachPlayer(match, player, true)
	if #match.Players == 0 then
		if match.State ~= "Ended" then
			match.State = "Ended"
			match.Won = false
			match.Reason = "abandoned"
		end
		cleanupMatch(match)
	else
		notifyAll(match, name .. " left the match.", "info", 3)
		broadcastState(match)
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1106">
          <Properties>
            <string name="Name">Multipliers</string>
            <string name="Source"><![CDATA[-- Multipliers (store 2026-11-04; docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.4 / 7 Z5): the paid
-- multipliers at the five earning sites, and the three attributes the client reads. Reached through Init deps only
-- (TycoonService's scoop, BattleService's Ring Cash, DungeonService's room and chest Cash, PetCareService's grantXp):
-- never inside DataService.AddCash / AddPetXp, so refunds, the tutorial's gifts, prestige Gems, Double Rewards
-- (Tokens) and the bank itself stay base (Z5).
--
--   Cash(player, amount, source)  amount x 2 with the Cash2x pass (Config.Store.Perks.CashX2.Cash), else x 1
--   PetXp(player, xp, source)     xp x max(pass PetXp2x -> 2, a running XP potion -> 2) (never x4)
--                                 x 1.5 with Store.Bought.Pro on a PvE source only (Dungeon / Raid; never Ring, Duel, Feed)
--   State(player) -> { Cash = 1 | 2, PetXp = 1 | 2, PvE = 1 | 1.5, PotionEnds, Passes = {[key] = true}, Bought = {[key] = true} }
--   Refresh(player)               writes OwnedPasses (csv, Config.Store.Items order), StoreBought (csv), XpBoostEnds
--                                 (unix or 0; both absent without a record) on the Player, only on change; connected
--                                 to StoreService.Changed and to
--                                 DataService.ProfileLoaded / ProfileRebased (the load, a provisional profile's recovery)
--   StoreBought and XpBoostEnds come ONLY from a real record: while DataService.GetStore answers nil (loading or
--   provisional) both attributes are absent (nil; cleared if they were set), never "" / 0 (the client reads absent as
--   "not known yet": StoreBought "" means "nothing bought", and the first XpBoostEnds the client sees is its baseline,
--   so it must be the real end, never a stand-in 0 that a late load then "raises"); once GetStore answers they are the
--   csv ("" for nothing bought) and the potion end (0 for none).
--   Init(deps)                    deps = { StoreService, DataService }; without StoreService every factor is 1
-- A junk amount (nil, NaN) passes through unchanged; the sites floor as they do today.
--
-- Plain Lua 5.1-compatible syntax only. Nothing here yields.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Multipliers = {}

local POTION_ID = "XpPotion"
local PASS_CASH = "Cash2x"
local PASS_XP = "PetXp2x"
local PACK_PRO = "Pro"
local PVE = { Dungeon = true, Raid = true }

local S = {
	Store = nil,
	DS = nil,
	Last = {}, -- [player] = { Passes = csv, Bought = csv | nil (absent), Ends = n | nil (absent) } as last written
	Started = false,
}
Multipliers._S = S

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function perk(name, field, default)
	local perks = type(Config.Store) == "table" and type(Config.Store.Perks) == "table" and Config.Store.Perks[name] or nil
	local v = type(perks) == "table" and tonumber(perks[field]) or nil
	if v and v >= 1 then
		return v
	end
	return default
end

local function items()
	return type(Config.Store) == "table" and type(Config.Store.Items) == "table" and Config.Store.Items or {}
end

local function owns(player, key)
	local store = S.Store
	return store ~= nil and type(store.Owns) == "function" and store.Owns(player, key) == true
end

-- the stored Store record (a copy) or nil while loading / provisional (then nothing bought counts)
local function recordOf(player)
	local DS = S.DS
	if not DS or type(DS.GetStore) ~= "function" then
		return nil
	end
	local ok, store = pcall(DS.GetStore, player)
	if ok and type(store) == "table" then
		return store
	end
	return nil
end

local function bought(player, key)
	local store = recordOf(player)
	return store ~= nil and type(store.Bought) == "table" and store.Bought[key] ~= nil
end

local function potionEnds(player)
	local store = S.Store
	if not store or type(store.BoostEnds) ~= "function" then
		return 0
	end
	local ends = store.BoostEnds(player, POTION_ID)
	return isFinite(ends) and ends or 0
end

function Multipliers.Cash(player, amount, source)
	if not isFinite(amount) or not isPlayer(player) then
		return amount
	end
	if owns(player, PASS_CASH) then
		return amount * perk("CashX2", "Cash", 2)
	end
	return amount
end

function Multipliers.PetXp(player, xp, source)
	if not isFinite(xp) or not isPlayer(player) then
		return xp
	end
	local m = 1
	if owns(player, PASS_XP) or potionEnds(player) > os.time() then
		m = perk("XpX2", "PetXp", 2) -- the pass or the potion: the same x2, never stacked
	end
	if PVE[source] and bought(player, PACK_PRO) then
		m = m * perk("ProXp", "PetXpPvE", 1.5)
	end
	return xp * m
end

function Multipliers.State(player)
	local state = { Cash = 1, PetXp = 1, PvE = 1, PotionEnds = 0, Passes = {}, Bought = {} }
	if not isPlayer(player) then
		return state
	end
	local store = recordOf(player)
	for _, item in ipairs(items()) do
		if type(item) == "table" and type(item.Key) == "string" then
			if item.Kind == "Pass" and owns(player, item.Key) then
				state.Passes[item.Key] = true
			elseif item.Once and store and type(store.Bought) == "table" and store.Bought[item.Key] ~= nil then
				state.Bought[item.Key] = true
			end
		end
	end
	state.PotionEnds = potionEnds(player)
	if state.Passes[PASS_CASH] then
		state.Cash = perk("CashX2", "Cash", 2)
	end
	if state.Passes[PASS_XP] or state.PotionEnds > os.time() then
		state.PetXp = perk("XpX2", "PetXp", 2)
	end
	if state.Bought[PACK_PRO] then
		state.PvE = perk("ProXp", "PetXpPvE", 1.5)
	end
	return state
end

local function csvOf(set)
	local out = {}
	for _, item in ipairs(items()) do
		if type(item) == "table" and set[item.Key] then
			out[#out + 1] = item.Key
		end
	end
	return table.concat(out, ",")
end

local function attrName(key)
	local name = Config.Attr and Config.Attr[key]
	return type(name) == "string" and name or nil
end

function Multipliers.Refresh(player)
	if not isPlayer(player) then
		return
	end
	local state = Multipliers.State(player)
	-- no record (loading / provisional) = StoreBought and XpBoostEnds absent: undecidable, not "nothing bought" / "no
	-- potion" (re-review 1, n2: XpBoostEnds follows StoreBought's rule)
	local known = recordOf(player) ~= nil
	local bought = known and csvOf(state.Bought) or nil
	local ends = known and state.PotionEnds or nil
	local now = { Passes = csvOf(state.Passes), Bought = bought, Ends = ends }
	local last = S.Last[player] or {}
	S.Last[player] = now
	local passesAttr, boughtAttr, endsAttr = attrName("OwnedPasses"), attrName("StoreBought"), attrName("XpBoostEnds")
	if passesAttr and last.Passes ~= now.Passes then
		player:SetAttribute(passesAttr, now.Passes)
	end
	if boughtAttr and last.Bought ~= now.Bought then
		player:SetAttribute(boughtAttr, now.Bought)
	end
	if endsAttr and last.Ends ~= now.Ends then
		player:SetAttribute(endsAttr, now.Ends)
	end
end

function Multipliers.Init(deps)
	deps = type(deps) == "table" and deps or {}
	S.Store = deps.StoreService or S.Store
	S.DS = deps.DataService or S.DS
	if S.Started then
		return
	end
	S.Started = true
	local store = S.Store
	if store and type(store.Changed) == "table" and type(store.Changed.Connect) == "function" then
		store.Changed:Connect(Multipliers.Refresh)
	else
		warn("[Multipliers] StoreService is missing: every multiplier is x1")
	end
	-- the Bought csv needs the loaded profile: refresh when it lands and after a rebase (ProfileRebased also fires when
	-- a provisional profile recovers: DataService's recover -> announceRebase)
	local DS = S.DS
	for _, name in ipairs({ "ProfileLoaded", "ProfileRebased" }) do
		local signal = DS and DS[name]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(player)
				Multipliers.Refresh(player)
			end)
		end
	end
	Players.PlayerAdded:Connect(function(player)
		Multipliers.Refresh(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		S.Last[player] = nil
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		Multipliers.Refresh(player)
	end
end

return Multipliers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1107">
          <Properties>
            <string name="Name">NpcService</string>
            <string name="Source"><![CDATA[-- NpcService: builds the six NPC pets of the lobby (ARCHITECTURE_V3.md section 5).
--
--   NpcService.Init(lobbyInfo, deps)   builds every NPC of shared/NpcDialog at lobbyInfo.NpcSpots[i] (6 ground-level
--                                      CFrames facing the walkway; missing ones fall back to 6 points around the
--                                      plaza). Safe to call again: the old NPCs are replaced. Returns GetNpcs().
--   NpcService.GetNpcs() -> { { Id, Name, Model, Pet, Prompt, Spot }, ... }
--   NpcService.GetNpc(id) -> record | nil
--   NpcService.FallbackSpots(lobbyInfo, count) -> { CFrame, ... }
--   NpcService.Talked                  Util.Signal; Fire(player, npcId) when a player uses an NPC's prompt
--
-- Every NPC is a Model "Npc_<Id>" in workspace.NimbusNpcs, tagged NpcDialog.Tag ("NC_Npc") with the attributes
-- NpcId, NpcName, Title, PetId, Accent (Color3) and PetParts (the pet's part count, so a client can tell when it
-- has fully replicated). Inside it:
--   Pedestal     a crafted voxel plinth (shared/Voxel.lua): a stepped stone base with a coloured tile band, studs,
--                a gold plaque, moss on the rim, tiny flowers and a patterned rug in the NPC's accent colour
--   Pet          PetBuilder.Build(catalog pet, { Detail = "High", Scale = 2.2 }) hovering above the rug, facing the
--                spot's LookVector (the walkway)
--   Collider     one invisible collidable cylinder around plinth + pet (players bump into the NPC, never stand in it)
--   PromptPart   an invisible part at the pet's centre holding the BillboardGui "Nameplate" (Pitch 2 item 04 B: one stone
--                card, the name over the title, the gold "!" block on its corner; Theme fonts, readable sizes), a soft
--                light, a few rising sparkles and the Attachment
--                "PromptAnchor" (front of the cushion) with the ProximityPrompt "TalkPrompt" (ActionText "Talk",
--                ObjectText = Name, HoldDuration 0, MaxActivationDistance 10, RequiresLineOfSight false, attribute NpcId)
-- The server never moves an NPC after building it: client/Controllers/NpcController idles them and shows the
-- dialog. The pets are not part of the lobby folder, so the lobby's part budget is unaffected.
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local WorldTag = require(Shared:WaitForChild("WorldTag")) -- (Pitch 2 item 04 B) the stone card of the nameplate
local Sign = Theme.Sign

local function optional(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[NpcService] shared module missing: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[NpcService] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local NpcDialog = optional("NpcDialog")
local PetCatalog = optional("PetCatalog")
local PetBuilder = optional("PetBuilder")
local Voxel = optional("Voxel")

local NpcService = {}
NpcService.Talked = Util.Signal()

local FOLDER_NAME = "NimbusNpcs"
local TAG = (NpcDialog and NpcDialog.Tag) or "NC_Npc"
local SETTINGS = (NpcDialog and NpcDialog.Settings) or {}
local NPC_SCALE = tonumber(SETTINGS.Scale) or 2.2
local PROMPT_DISTANCE = tonumber(SETTINGS.PromptDistance) or 10
local HOVER_GAP = tonumber(SETTINGS.HoverGap) or 1.0
local FxSprites = require(Shared:WaitForChild("FxSprites")) -- the game's own particle sprites (kit B X1)

-- Pedestal geometry (voxel units; one voxel = PV studs, about two pet voxels at Scale 2.2)
local PV = 0.4
local SINK = 0.15 -- the plinth starts slightly below the spot so it never floats over a lower ground tile
local R_BASE, R_DRUM, R_CAP = 10.6, 9.3, 9.8
local Y_BAND, Y_CAP, Y_CUSHION = 2, 4, 5
local PEDESTAL_TOP = (Y_CUSHION + 2) * PV - SINK -- studs above the spot: the cushion's top surface
local MAX_PEDESTAL_PARTS = 120 -- a safety net only: the design merges to about 100 parts

local records = {}
local folder = nil

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Same stone family as the lobby paths (LobbyBuilder palette), so the plinths belong to the plaza.
local STONE = {
	Base = rgb(150, 142, 136),
	Stone = rgb(208, 202, 190),
	Cap = rgb(226, 221, 209),
	Gold = rgb(244, 198, 84),
	Plaque = rgb(246, 234, 210),
	Moss = rgb(108, 180, 86),
	Leaf = rgb(82, 156, 74),
	Petal1 = rgb(246, 150, 188),
	Petal2 = rgb(250, 214, 92),
	Petal3 = rgb(172, 142, 232),
	Petal4 = rgb(244, 244, 248),
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function toCFrame(value)
	if typeof(value) == "CFrame" then
		return value
	elseif typeof(value) == "Vector3" then
		return CFrame.new(value)
	elseif type(value) == "table" and typeof(value.CFrame) == "CFrame" then
		return value.CFrame
	end
	return nil
end

-- Keeps only the yaw of a spot (NPCs stand upright even if a spot CFrame is tilted).
local function flatten(cf)
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local pos = cf.Position
	return CFrame.lookAt(pos, pos + flat.Unit)
end

local function lighten(c, t)
	return c:Lerp(Color3.new(1, 1, 1), t)
end

local function darken(c, t)
	return c:Lerp(Color3.fromRGB(26, 30, 52), t)
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- Lowest / highest point and horizontal reach of every part of `model`, relative to `origin`.
local function extents(model, origin)
	local lo, hi, reach = math.huge, -math.huge, 0
	local inv = origin:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local cf = inv * d.CFrame
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
			local s = d.Size
			local hy = (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) / 2
			local hx = (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z) / 2
			local hz = (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z) / 2
			local p = cf.Position
			lo = math.min(lo, p.Y - hy)
			hi = math.max(hi, p.Y + hy)
			reach = math.max(reach, math.abs(p.X) + hx, math.abs(p.Z) + hz)
		end
	end
	if lo == math.huge then
		return nil
	end
	return lo, hi, reach
end

local function countParts(model)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

----------------------------------------------------------------------
-- Spots
----------------------------------------------------------------------
-- Ground height under a point (the plaza surface), ignoring the NPC folder.
local function groundY(pos, fallbackY)
	local ok, hit = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if folder then
			params.FilterDescendantsInstances = { folder }
		end
		return Workspace:Raycast(Vector3.new(pos.X, fallbackY + 30, pos.Z), Vector3.new(0, -60, 0), params)
	end)
	if ok and hit and hit.Position and math.abs(hit.Position.Y - fallbackY) <= 4 then
		return hit.Position.Y -- the plaza surface (a hit on a tree or an arch is ignored)
	end
	return fallbackY
end

-- Six points on the plaza lawn (radius 58): two between the portal walkways, four towards the shop island.
function NpcService.FallbackSpots(lobbyInfo, count)
	count = tonumber(count) or 6
	local lobby = Config.Lobby or {}
	local origin = lobby.Origin or Vector3.new(0, 300, 0)
	local shop = lobby.ShopOffset or Vector3.new(0, 0, -150)
	local shopAngle = math.deg(math.atan2(shop.Z, shop.X))
	local angles = { 22.5, 157.5, shopAngle - 30, shopAngle + 30, shopAngle - 60, shopAngle + 60 }
	local radius = math.min(58, (lobby.PlazaRadius or 110) * 0.53)
	local spots = {}
	for i = 1, count do
		local a = math.rad(angles[(i - 1) % #angles + 1] + math.floor((i - 1) / #angles) * 11)
		local pos = Vector3.new(origin.X + math.cos(a) * radius, origin.Y, origin.Z + math.sin(a) * radius)
		pos = Vector3.new(pos.X, groundY(pos, origin.Y), pos.Z)
		spots[i] = CFrame.lookAt(pos, Vector3.new(origin.X, pos.Y, origin.Z))
	end
	return spots
end

local function resolveSpots(lobbyInfo, count)
	local spots = {}
	local given = type(lobbyInfo) == "table" and lobbyInfo.NpcSpots or nil
	if type(given) == "table" then
		for i = 1, count do
			local cf = toCFrame(given[i])
			if cf then
				spots[i] = flatten(cf)
			end
		end
	end
	local fallback = nil
	for i = 1, count do
		if not spots[i] then
			fallback = fallback or NpcService.FallbackSpots(lobbyInfo, count)
			spots[i] = fallback[i]
		end
	end
	return spots
end

----------------------------------------------------------------------
-- Pedestal (sculpted voxel plinth)
----------------------------------------------------------------------
local function disc(g, r, y, key, test)
	local ri = math.ceil(r)
	local r2 = r * r
	for x = -ri, ri do
		for z = -ri, ri do
			local d2 = x * x + z * z
			if d2 <= r2 then
				local k = key
				if test then
					k = test(x, z, math.sqrt(d2))
				end
				if k then
					Voxel.Set(g, x, y, z, k)
				end
			end
		end
	end
end

local function pedestalPalette(accent)
	local pal = {}
	for k, v in pairs(STONE) do
		pal[k] = v
	end
	pal.Trim = darken(accent, 0.3)
	pal.Rug = darken(accent, 0.12)
	pal.RugTop = accent
	pal.RugTrim = lighten(accent, 0.42)
	pal.RugCenter = rgb(250, 224, 146)
	pal.Gold = { Color = STONE.Gold, Material = Enum.Material.SmoothPlastic, Reflectance = 0.05 }
	return pal
end

-- Voxel position on a circle (rounded to the grid).
local function onCircle(deg, r)
	local a = math.rad(deg)
	return math.floor(math.cos(a) * r + 0.5), math.floor(math.sin(a) * r + 0.5)
end

-- A plinth with a classic profile, its stone in three shades by height (dark foot, mid drum, pale cap):
-- foot, drum with a tile band in the accent colour + gold rivets + a gold-framed plaque at the front, an
-- overhanging cap with moss clumps, and a plump square cushion with a trim border, a gold medallion and tassels.
-- Whole flat layers keep the greedy merge cheap (about 100 parts), so no colour ever gets lost to the LOD.
local function sculptPedestal(seed)
	local g = Voxel.NewGrid(8)
	disc(g, R_BASE, 0, "Base")
	disc(g, R_DRUM, 1, "Stone")
	disc(g, R_DRUM, Y_BAND, "Trim")
	disc(g, R_DRUM, 3, "Stone")
	disc(g, R_CAP, Y_CAP, "Cap")

	-- gold rivets standing out of the band every 45 degrees (the front one gives way to the plaque)
	for i = 0, 7 do
		local deg = i * 45
		if deg ~= 270 then
			local x, z = onCircle(deg, R_DRUM + 0.9)
			Voxel.Set(g, x, Y_BAND, z, "Gold")
		end
	end

	-- plaque on the front (the pet faces -Z): a flat gold frame around a recessed cream plate
	local zFront = -math.floor(R_DRUM)
	for x = -3, 3 do
		for y = 1, 3 do
			if math.abs(x) == 3 or y ~= Y_BAND then
				Voxel.Set(g, x, y, zFront, "Gold")
			else
				Voxel.Set(g, x, y, zFront, nil)
				Voxel.Set(g, x, y, zFront + 1, "Plaque")
			end
		end
	end

	-- small moss clumps creeping over the cap rim: back and sides only, placement varies per NPC
	local clumps = { 30 + (seed * 17) % 120, 160 + (seed * 29) % 60, 330 + (seed * 13) % 40 }
	for _, deg in ipairs(clumps) do
		for k = -1, 1 do
			local x, z = onCircle(deg + k * 6, R_CAP - 0.4)
			Voxel.Set(g, x, Y_CAP, z, "Moss")
		end
		local ox, oz = onCircle(deg, R_CAP + 0.4)
		Voxel.Set(g, ox, Y_CAP - 1, oz, "Moss_Dark") -- a drip hanging over the edge
		local ix, iz = onCircle(deg + 3, R_CAP - 1.4)
		Voxel.Set(g, ix, Y_CAP + 1, iz, "Moss_Light") -- a tuft on top
	end

	-- cushion: side band, lighter top with a trim border, gold medallion, gold corner tassels
	local half = 6
	for x = -half, half do
		for z = -half, half do
			if math.abs(x) + math.abs(z) < 2 * half - 1 then -- clipped corners
				Voxel.Set(g, x, Y_CUSHION, z, "Rug")
			end
			local ax, az = math.abs(x), math.abs(z)
			if ax <= half - 1 and az <= half - 1 and ax + az < 2 * half - 3 then
				local key = "RugTop"
				if ax == half - 1 or az == half - 1 or ax + az == 2 * half - 4 then
					key = "RugTrim"
				elseif ax + az <= 2 then
					key = "RugCenter"
				end
				Voxel.Set(g, x, Y_CUSHION + 1, z, key)
			end
		end
	end
	for _, c in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
		Voxel.Set(g, c[1] * (half - 1), Y_CUSHION, c[2] * (half - 1), "Gold")
		Voxel.Set(g, c[1] * half, Y_CUSHION, c[2] * (half - 1), "Gold")
		Voxel.Set(g, c[1] * (half - 1), Y_CUSHION, c[2] * half, "Gold")
	end

	-- little flowers on the foot step: a leaf and a petal each
	for i, deg in ipairs({ 40 + seed * 11, 140 + seed * 7, 235 - seed * 13, 300 + seed * 5 }) do
		local x, z = onCircle(deg, R_BASE - 0.5)
		if Voxel.Get(g, x, 0, z) ~= nil and Voxel.Get(g, x, 1, z) == nil then
			Voxel.Set(g, x, 1, z, "Leaf")
			Voxel.Set(g, x, 2, z, "Petal" .. ((i + seed) % 4 + 1))
		end
	end
	return g
end

-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7): the Part pedestal stays (the fallback; the Collider is separate) and
-- is tagged for the Blender mesh npc_pedestal (one design; the rug / trim follow the NPC accent through ML_Primary).
-- Clients dress it (MeshLibrary.Dress). Only once the key has an uploaded id: with an empty MeshIds nothing changes.
local PEDESTAL_KEY = "npc_pedestal"
local meshLib = nil
local function meshLibrary()
	if meshLib == nil then
		meshLib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				meshLib = result
			end
		end
	end
	return meshLib or nil
end

local function tagPedestal(model, origin, accent)
	local ML = meshLibrary()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, PEDESTAL_KEY)
	if not okStatus or st == "missing" then
		return false
	end
	ML.Tag(model, PEDESTAL_KEY, { Primary = accent, Offset = model:GetPivot():Inverse() * origin })
	return true
end

local function buildPedestal(parent, spot, accent, seed)
	if not Voxel then
		-- no voxel kit: a plain two-tier plinth so the NPC still stands somewhere
		local m = make("Model", { Name = "Pedestal" }, nil)
		make("Part", {
			Name = "Base", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic, Color = STONE.Stone,
			Size = Vector3.new(PEDESTAL_TOP + SINK, R_DRUM * PV * 2, R_DRUM * PV * 2),
			CFrame = spot * CFrame.new(0, (PEDESTAL_TOP - SINK) / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		}, m)
		m.Parent = parent
		return m
	end
	local g = sculptPedestal(seed)
	local origin = spot * CFrame.new(0, PV / 2 - SINK, 0) -- where grid voxel (0, 0, 0) sits = the mesh pivot
	local model = Voxel.Build(g, {
		VoxelSize = PV,
		Palette = pedestalPalette(accent),
		Name = "Pedestal",
		CFrame = spot * CFrame.new(0, PV / 2 - SINK, 0),
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		MaxParts = MAX_PEDESTAL_PARTS,
		Keep = { "Gold", "Trim", "Rug", "RugTop", "RugTrim", "RugCenter", "Plaque" },
		PrimaryKey = "Stone",
	})
	tagPedestal(model, origin, accent)
	model.Parent = parent
	return model
end

-- tests (tools/smoke_p6_creatures.lua): build one pedestal (Model "Pedestal") under `parent` at `spot`, tagged for
-- the mesh exactly like the NPCs' own. Returns the model.
function NpcService._BuildPedestal(parent, spot, accent, seed)
	return buildPedestal(parent, spot, accent, seed)
end

-- Phase 6 kit hook (read-only, never called by the game): the pedestal design for blender/kit/props/creatures.py
-- (key npc_pedestal): the voxel grid of seed `seed`, its palette for `accent`, and the layout numbers.
function NpcService._Blueprint(seed, accent)
	if not Voxel then
		return nil
	end
	accent = typeof(accent) == "Color3" and accent or rgb(120, 180, 236)
	return {
		Grid = sculptPedestal(tonumber(seed) or 1),
		Palette = pedestalPalette(accent),
		PV = PV,
		Sink = SINK,
		Top = PEDESTAL_TOP,
		Accent = accent,
		Keep = { "Gold", "Trim", "Rug", "RugTop", "RugTrim", "RugCenter", "Plaque" },
	}
end

----------------------------------------------------------------------
-- Nameplate
----------------------------------------------------------------------
-- World text rule (ARCHITECTURE_V3.md): a PIXEL-sized tag (constant on-screen size), the name >= 22 px and the
-- title >= 18 px at 1080p with FIXED text sizes (never TextScaled). The transparent Plate is the 1080p design box;
-- NpcController scales the tag and Plate (UIScale "ReadScale") with the screen-height factor (attributes BaseWidth /
-- BaseHeight).
-- (Pitch 2 item 04_world_ui, the owner's pick B "Stone tags"; the navy rounded capsules with a gradient and a neon edge
-- went) the sign is ONE stone card of the HUD's tier (shared/WorldTag): the Stone face, a 3 px mitred wood edge, a 5 px lip
-- in the NPC's role colour (WorldTag.LipOf(Accent)); the name (Nameplate, 28 px) over the title (Heading, 19 px) in the
-- kit's brown ink on the opaque face (no outline); the "!" a gold block pinned on the card's top-right corner, reaching
-- WorldTag.Sizes.BangOut px past it. The card is sized from the measured texts (Theme.Measure, its spare factor) and never
-- narrower than CARD_MIN; the gui holds the card, its edge and the "!" (a BillboardGui clips what lies outside it).
local NAME_PX = 28
local TITLE_PX = 19
local CARD_PAD = 14 -- px each side of the longer line, inside the face
local CARD_MIN = 150 -- the card's least outer width (its edges included)
local CARD_FACE_H = 72 -- the face: 6 px over the name, the 32 px name row, the 24 px title row, 5 px, the 5 px lip
local BANG_GAP = 6 -- (look review fin0, minor) px between the name's last letter and the "!" block over its row

local function buildNameplate(parent, def, accent, offsetY)
	local Z = WorldTag.Sizes
	local name, titleText = def.Name or "Friend", def.Title or "Lobby Friend"
	-- the name row shares its top with the "!" block, which reaches (Bang - BangOut - Edge) px into the face: the centred
	-- name keeps that much plus BANG_GAP clear each side ('Professor Axolotl' ended 1-2 px from the block)
	local bangIn = Z.Bang - Z.BangOut - Z.Edge
	local nameW = Theme.Measure(name, "Nameplate", NAME_PX).X + 2 * (bangIn + BANG_GAP)
	local titleW = Theme.Measure(titleText, "Heading", TITLE_PX).X + 2 * CARD_PAD
	local faceW = math.ceil(math.max(CARD_MIN - 2 * Z.Edge, nameW, titleW))
	local plateW = faceW + 2 * (Z.Edge + Z.BangOut)
	local plateH = Z.BangOut + Z.Edge + CARD_FACE_H + Z.Edge
	local gui = make("BillboardGui", {
		Name = "Nameplate",
		Size = UDim2.fromOffset(plateW, plateH),
		SizeOffset = Vector2.new(0, 0.5), -- the bottom edge sits offsetY studs over the pet's head
		StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = false,
		MaxDistance = 85,
		LightInfluence = 0,
		ClipsDescendants = false,
	}, nil)
	gui:SetAttribute("BaseWidth", plateW)
	gui:SetAttribute("BaseHeight", plateH)

	local plate = make("Frame", {
		Name = "Plate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(plateW, plateH),
		BackgroundTransparency = 1,
	}, gui)

	local card = make("Frame", {
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -Z.Edge),
		Size = UDim2.fromOffset(faceW, CARD_FACE_H),
		ZIndex = 2,
	}, plate)
	WorldTag.Block(card, Sign.Stone, WorldTag.LipOf(accent), Sign.Wood, Z.Edge, Z.Lip)
	WorldTag.Text(card, "Name", name, "Nameplate", NAME_PX, Sign.Text, {
		Position = UDim2.fromOffset(0, 6),
		Size = UDim2.new(1, 0, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
	})
	WorldTag.Text(card, "Title", titleText, "Heading", TITLE_PX, Sign.TextMuted, {
		Position = UDim2.fromOffset(0, 38),
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
	})

	-- the "!" (new tips here; the client hides it once the player has talked to this NPC): pinned on the corner, still
	local badge = WorldTag.Bang(card, 4)
	local inner = Z.Bang - 2 * Z.BangEdge
	badge.Position = UDim2.new(1, Z.BangOut + Z.Edge - Z.Bang + Z.BangEdge, 0, -(Z.BangOut + Z.Edge) + Z.BangEdge)
	badge.Size = UDim2.fromOffset(inner, inner)

	gui.Parent = parent
	return gui
end

----------------------------------------------------------------------
-- One NPC
----------------------------------------------------------------------
local function catalogPet(def)
	if not PetCatalog or type(PetCatalog.Get) ~= "function" then
		return nil
	end
	local pet = PetCatalog.Get(def.PetId)
	if pet then
		return pet
	end
	-- the id vanished from the catalog: borrow another pet of the same species (or any pet)
	local list = PetCatalog.Pets or {}
	for _, p in ipairs(list) do
		if type(p) == "table" and type(p.Look) == "table" and p.Look.Species == def.Species then
			return p
		end
	end
	return list[1]
end

local function buildNpc(def, spot, index, detached)
	local accent = typeof(def.Accent) == "Color3" and def.Accent or rgb(120, 180, 236)
	local model = make("Model", { Name = "Npc_" .. tostring(def.Id) }, nil)
	model:SetAttribute("NpcId", def.Id)
	model:SetAttribute("NpcName", def.Name or def.Id)
	model:SetAttribute("Title", def.Title or "")
	model:SetAttribute("Accent", accent)

	local okPed, errPed = pcall(buildPedestal, model, spot, accent, index)
	if not okPed then
		warn("[NpcService] pedestal of " .. tostring(def.Id) .. " failed: " .. tostring(errPed))
	end

	-- the pet, hovering HOVER_GAP above the rug, facing the walkway (pets face -Z = the spot's LookVector)
	local petDef = catalogPet(def)
	local pet = nil
	local centerY = PEDESTAL_TOP + 3.2
	local topY = PEDESTAL_TOP + 6.4
	local reach = 3
	if petDef and PetBuilder and type(PetBuilder.Build) == "function" then
		local ok, built = pcall(PetBuilder.Build, petDef, { Scale = def.Scale or NPC_SCALE, Detail = "High" })
		if ok and typeof(built) == "Instance" then
			pet = built
			pet.Name = "Pet"
			local origin = CFrame.new()
			pet:PivotTo(origin)
			local lo, hi, r = extents(pet, origin)
			if lo then
				local pivotY = PEDESTAL_TOP + HOVER_GAP - lo
				centerY = pivotY
				topY = pivotY + hi
				reach = r
			end
			pet:PivotTo(spot * CFrame.new(0, centerY, 0))
			pet.Parent = model
			model:SetAttribute("PetId", petDef.Id)
			model:SetAttribute("PetParts", countParts(pet))
		else
			warn("[NpcService] PetBuilder.Build failed for " .. tostring(def.Id) .. ": " .. tostring(built))
		end
	end

	-- one invisible collider: players walk around the NPC instead of into it
	local colliderH = topY + SINK + 0.3
	local colliderR = math.max(R_DRUM * PV + 0.15, math.min(reach * 0.75, R_CAP * PV))
	make("Part", {
		Name = "Collider",
		Anchored = true,
		CanCollide = true,
		CanTouch = false,
		Transparency = 1,
		CastShadow = false,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(colliderH, colliderR * 2, colliderR * 2),
		CFrame = spot * CFrame.new(0, colliderH / 2 - SINK, 0) * CFrame.Angles(0, 0, math.rad(90)),
	}, model)

	-- prompt + nameplate + light + sparkles live on an invisible part at the pet's centre
	local promptPart = make("Part", {
		Name = "PromptPart",
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		CastShadow = false,
		Size = Vector3.new(1, 1, 1),
		CFrame = spot * CFrame.new(0, centerY, 0),
	}, model)
	local prompt = make("ProximityPrompt", {
		Name = "TalkPrompt",
		ActionText = "Talk",
		ObjectText = def.Name or "Friend",
		HoldDuration = 0,
		MaxActivationDistance = PROMPT_DISTANCE,
		RequiresLineOfSight = false,
	}, nil)
	prompt:SetAttribute("NpcId", def.Id)
	-- the prompt pops up at the front of the cushion, so its key hint never covers the pet's face
	local anchor = make("Attachment", {
		Name = "PromptAnchor",
		CFrame = promptPart.CFrame:Inverse() * (spot * CFrame.new(0, PEDESTAL_TOP + 0.9, -(R_CAP * PV - 0.6))),
	}, promptPart)
	prompt.Parent = anchor
	buildNameplate(promptPart, def, accent, topY - centerY + 0.9)

	make("PointLight", {
		Name = "Glow",
		Color = lighten(accent, 0.45),
		Brightness = 0.6,
		Range = 11,
		Shadows = false,
	}, promptPart)

	local rugAttachment = make("Attachment", {
		Name = "RugSparkles",
		CFrame = promptPart.CFrame:Inverse() * (spot * CFrame.new(0, PEDESTAL_TOP + 0.1, 0)),
	}, promptPart)
	FxSprites.Apply(make("ParticleEmitter", {
		Name = "Sparkles",
		Color = ColorSequence.new(lighten(accent, 0.55), rgb(255, 236, 170)),
		LightEmission = 0.7,
		LightInfluence = 0,
		Rate = 2.2,
		Lifetime = NumberRange.new(1.6, 2.6),
		Speed = NumberRange.new(0.6, 1.3),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Top,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.32),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, rugAttachment), "Sparkle")

	if pet and pet.PrimaryPart then
		model.PrimaryPart = pet.PrimaryPart
	else
		model.PrimaryPart = promptPart
	end

	prompt.Triggered:Connect(function(player)
		NpcService.Talked:Fire(player, def.Id)
	end)

	CollectionService:AddTag(model, TAG)
	model:SetAttribute("Ready", true)
	if not detached then
		model.Parent = folder -- parented last: the whole NPC replicates in one step
	end
	return {
		Id = def.Id,
		Name = def.Name,
		Model = model,
		Pet = pet,
		Prompt = prompt,
		Spot = spot,
	}
end

-- Phase 6: the NPCs are built at boot, usually before MeshLibrary has loaded the pet keys. Once they are ready the
-- whole NPC is rebuilt in place with the Blender mesh pet (MeshLibrary.Swap: same name and folder; the clients'
-- NpcController sets the new model up like any NPC) and the record takes the new instances. Empty MeshIds = nothing.
local function watchMeshPet(rec, def, spot, index)
	local petDef = catalogPet(def)
	if not rec.Pet or not petDef or not PetBuilder or type(PetBuilder.SwapWhenReady) ~= "function" then
		return
	end
	local built = nil
	pcall(PetBuilder.SwapWhenReady, rec.Model, petDef, { Scale = def.Scale or NPC_SCALE, Detail = "High" }, function()
		built = buildNpc(def, spot, index, true)
		return built and built.Model or nil
	end, function(fresh)
		if built and built.Model == fresh then
			for k, v in pairs(built) do
				rec[k] = v
			end
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function NpcService.Init(lobbyInfo, deps)
	local _ = deps
	if not NpcDialog or type(NpcDialog.Npcs) ~= "table" then
		warn("[NpcService] shared/NpcDialog is unavailable: no NPCs")
		return {}
	end
	local old = Workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	records = {}
	folder = make("Folder", { Name = FOLDER_NAME }, Workspace)

	local list = NpcDialog.Npcs
	local spots = resolveSpots(lobbyInfo, #list)
	for i, def in ipairs(list) do
		if type(def) == "table" and type(def.Id) == "string" and spots[i] then
			local ok, rec = pcall(buildNpc, def, spots[i], i)
			if ok and rec then
				records[#records + 1] = rec
				watchMeshPet(rec, def, spots[i], i)
			else
				warn("[NpcService] NPC " .. tostring(def.Id) .. " failed: " .. tostring(rec))
			end
		end
	end
	return NpcService.GetNpcs()
end

function NpcService.GetNpcs()
	local out = {}
	for i, rec in ipairs(records) do
		out[i] = rec
	end
	return out
end

function NpcService.GetNpc(id)
	for _, rec in ipairs(records) do
		if rec.Id == id then
			return rec
		end
	end
	return nil
end

return NpcService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1108">
          <Properties>
            <string name="Name">PetCareService</string>
            <string name="Source"><![CDATA[-- PetCareService (Phase 4, care): the Food Machine, EVOLVE and the Training Place (ARCHITECTURE_V3.md "Phase 4 build
-- contract" 3.4-3.7, 5.1-5.4). The Phase 2 Kitchen (cooking queue) and Gym (passive XP) that lived in this file are
-- gone: "Cook" / "GymSet" requests answer one toast that says where the feature went.
--
-- * Food Machine (station id Kitchen; Phase 5 contract 3.4): Feed(key) = exactly ONE machine feed paid in berries:
--   TycoonCatalog.FeedBerries(def, level) berries (= the Phase 4 FeedPrice: 1 berry = $1 of food) for
--   TycoonCatalog.FeedXp(level, machineLevel) XP (25-50% of the bar). Checks in order (each a toast, nothing moves
--   before the last): loaded and not provisional; owned; below the cap (PetCatalog.LevelCap: 100); not in a running
--   battle or dungeon run (BattleService.KeysInBattle); the Food Machine built ("Build the Food Machine at home
--   first"); berries >= the cost ("Not enough berries: a feed needs 340 (you have 120). Your garden pets grow more!").
--   Then ONE non-yielding step: DataService.SpendBerries, grantXp; an XP write of 0 refunds the berries in the same
--   step. A { Count } / { Food } / string second argument from an old client is ignored (one feed). The old Food
--   items were converted into berries once by DataService's P5Home step: there is no leftover path and no Cash path.
--   ONE toast per XP grant (a feed, a fight), never one per level: a level-up toast shows the new stats and "Ready to
--   evolve!" at 20 / 50 (PetCatalog.CanEvolve).
-- * EVOLVE: Evolve(key): owned, loaded and not provisional, level >= the next threshold (PetCatalog.EvolutionLevels
--   20 / 50), stage < PetCatalog.MaxEvolution(def) (Common / Uncommon / Rare once, Epic and rarer twice), not in a
--   running battle or ring run. Writes the stored stage (DataService.SetEvolution, only up), fires Evolved, toasts
--   "<Pet> evolved! +25% to everything", refreshes the EquippedInfo attribute (PetService.Refresh) and sends
--   OpenPanel("Evolve", { Key, Stage }) to that client only. Free. A training pet may evolve. The toast reads
--   "<Pet> evolved! Level bonus x1.5!" / "x1.875!" (PetCatalog.EvolutionBonusOf, Phase 5 3.1).
-- * Training Place (station id Gym): Train(key, stat) with stat Speed | Physique | Ability | Defense: needs the
--   station (TycoonCatalog.TrainingSlots(home) >= 1) and a free mat, an owned pet that is not training, a rank below
--   10, no running battle, TycoonCatalog.TrainCost(def, rank) Cash; rank r takes TycoonCatalog.TrainSeconds(r)
--   (r minutes). The Cash and the job (PetGrowth[key].Job = { Stat, Ends = os.time() + seconds, Rank = rank + 1, Slot =
--   mat, From, Paid }, DataService.MutateGrowth) are one step; a failed job write gives the Cash back. Starting takes
--   the pet off the followers (PetService.Refresh; it keeps its team slot, busy) and out of the Garden (TycoonService.GardenSet) by
--   itself and remembers where it was in Job.From ("Garden:<slot>" wins over "Follow", else "Free"). The lock is
--   DataService.TrainingKeys (PetService.Equip, GardenSet, Fusion, teams and the ring read it). Completion is decided
--   from os.time() >= Job.Ends by the 1 s tick and on profile load / rebase (provisional saves wait): the rank is a
--   TARGET value (two servers completing one job give one rank), the pet goes back by itself ("Follow" -> its team slot
--   was never freed; "Garden:n" -> that place when open and empty, else the first free open place, else it stays
--   in the list), TrainingDone fires. TrainStop(key) removes the job and refunds Job.Paid in the same step (a job
--   that is already due finishes instead). Running jobs survive a Prestige. Toasts: "Rocky started Physique training
--   (4:00)", "Rocky finished Physique training: Rank 3!", "Training done while you were away! ..." on load.
-- * Home.Gym is retired: on every home load (ProfileLoaded / ProfileRebased, or the first readable tick) the old Gym
--   slots are emptied (old Gym pets come back to the list) with one toast per session, also when DataService's
--   one-time Phase 4 migration emptied them (DataService.MigratedNow(player, "P4").GymPets).
-- * Prompts (owner only, HomeFx hides them from visitors): FeedPrompt "Feed pets" on the Food Machine's Hopper part
--   (its biggest part while HomeBuilder has no Hopper yet) -> OpenPanel("Pets", { Action = "Feed" }); TrainPrompt
--   "Train pets" on Station_Gym -> OpenPanel("Train"). Rebuilt when the station is rebuilt (the CareSig attribute
--   carries a "p5:" marker so stale prompts of a Phase 3 / Phase 4 server never survive: the stations swapped slots).
-- * Replication: the plot folder attribute TrainingPets = "1=cat:Physique:1760000000;2=fox@Golden:Speed:1760000420"
--   (mat=key:stat:Ends, written only on change; a hybrid key holds ":" itself, so readers split from the right) and
--   HomeBuilder.SetTraining(spotInfo, { [mat] = { Key, Stat, Ends } }) when HomeBuilder has such a function. Levels,
--   growth and food reach the owner through ProfileSync (DataService).
-- * Remote PetCare(action, a, b): "Feed" (key; b ignored), "Evolve" (key), "Train" (key, stat), "TrainStop" (key); "Cook" /
--   "GymSet" are retired (one toast). Types, lengths, ranges and NaN are checked; every action has a cooldown plus a
--   shared per-player burst budget; refusals answer with a side toast (repeated texts are throttled). Nothing here
--   moves parts (Replication rule).
--
-- Public API (the contract): Init(deps)   deps = { DataService, PetService, TycoonService, BattleService }
--   Feed(player, key) -> ok, { Xp, Levels, Level, Cap, Berries, Cost } | reason
--   Evolve(player, key) -> ok, stage | reason
--   Train(player, key, stat) -> ok, { Rank, Ends, Cost, Slot, From } | reason
--   TrainStop(player, key) -> ok, refund | reason
--   GrantXp(player, key, xp, source) -> xpGiven, levelsGained, reason   (cap-aware XP for other services, one toast)
--   LevelCap(player, key) -> n | nil          ClearSessions(player) -> true   (developer reset)
--   Signals Fed(player, key, "Berries", levelsGained), LevelUp(player, key, level,
--   source), Evolved(player, key, stage), TrainingStarted(player, key, stat), TrainingDone(player, key, stat, rank)
--
-- Every Phase 4 helper lives in the table `Care` (Lua's 200-local limit). Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme) -- (Pitch 2 F0) compact: Theme.Short, the one number style

local PetCareService = {}
PetCareService.Fed = Util.Signal() -- Fire(player, key, "Berries", levelsGained)
PetCareService.LevelUp = Util.Signal() -- Fire(player, key, newLevel, source)  source "Feed" | "Trial" | "Ring" | GrantXp's
PetCareService.Evolved = Util.Signal() -- Fire(player, key, stage)
PetCareService.TrainingStarted = Util.Signal() -- Fire(player, key, stat)
PetCareService.TrainingDone = Util.Signal() -- Fire(player, key, stat, rank)

local TICK = 1 -- seconds between training ticks (completions, prompts, the TrainingPets attribute)
local FEED_COOLDOWN = 0.1
local EVOLVE_COOLDOWN = 1
local TRAIN_COOLDOWN = 0.25
local PROMPT_COOLDOWN = 0.35
local BURST_SIZE = 12 -- PetCare requests a player may send at once...
local BURST_REFILL = 6 -- ...refilled at this many per second
local TOAST_GAP = 1.5 -- the same refusal text is not repeated within this many seconds
local LOAD_TOAST_DELAY = 3 -- seconds after a player's session starts before the load toasts show (the client is ready)
local MAX_TOAST_CHARS = 90 -- NotifyController shows up to 90 characters
local MAX_NAME_CHARS = 28 -- "Rainbow Starlight Unicorn" fits; the longest toast stays under 90 characters
local MAX_ACTION_LENGTH = 16
local MAX_ID_LENGTH = 48
local MAX_STAT_LENGTH = 24
local MAX_TRAIN_SLOTS = 5 -- Training Place mats (DataService P4.MAX_JOB_SLOT)
local FALLBACK_MAX_RANK = 10
local PROMPT_RANGE = 10
local PROMPT_HOLD = 0.3
local FALLBACK_LEVEL_CAPS = { Common = 100, Uncommon = 100, Rare = 100, Epic = 100, Legendary = 100, Mythic = 100, Secret = 100 }
local FALLBACK_MAX_LEVEL = 100
local PROMPT_KEYS = { Keyboard = Enum.KeyCode.E, Gamepad = Enum.KeyCode.ButtonX }
local ATTR_TRAINING = "TrainingPets"
local ATTR_IN_BATTLE = Config.Attr.InBattle or "InBattle"
local CARE_SIG = "CareSig" -- attribute on a station model: which prompts this service built on it
local CARE_MARK = "CareMade" -- attribute on every prompt this service made
local SIG_PREFIX = "p5:" -- stale Phase 3 / Phase 4 prompts (other signatures) never match a Phase 5 signature (the stations moved)
local LOADING = "Your save is still loading, try again in a moment"
local STATS = { "Speed", "Physique", "Ability", "Defense" }
local STAT_LABELS = { Speed = "Attack Speed", Physique = "Physique", Ability = "Ability", Defense = "Defense" }
local STAT_BY_NAME = { speed = "Speed", attackspeed = "Speed", physique = "Physique", ability = "Ability", defense = "Defense", defence = "Defense" }

local initialized = false
local running = false
local dataService = nil
local petService = nil
local tycoonService = nil
local battleService = nil
local multipliers = nil -- Multipliers module table (store: x2 Pet XP by pass or potion, x1.5 PvE; Init deps only)
local catalog = nil -- TycoonCatalog
local petKeys = nil -- PetKeys (optional)
local petCatalog = nil -- PetCatalog (optional)
local battleCatalog = nil -- BattleCatalog (optional)
local homeBuilder = nil -- HomeBuilder (optional: GetStation, SetTraining)
local notifyRemote = nil
local openPanelRemote = nil

local Care = {} -- every Phase 4 helper (see the header)
local sessions = {} -- [Player] = { At, Pending = { { Text, Kind, Seconds }... }, Shown = { Folder, Info, Text } | nil, GymChecked, GymToast, MigrationSeen }
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local budgets = {} -- [Player] = { Tokens, At }
local toastAt = {} -- [Player] = { [text] = os.clock() }
local departed = setmetatable({}, { __mode = "k" })

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent ~= nil and not departed[player]
end

local function requireModule(container, name)
	local module = container and container:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[PetCareService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

-- cuts a text to n characters without splitting a UTF-8 character
local function clip(text, n)
	text = tostring(text)
	if #text <= n then
		return text
	end
	local cut = string.sub(text, 1, n - 3)
	cut = string.gsub(cut, "[\192-\255][\128-\191]*$", "")
	return cut .. "..."
end

local function remote(name)
	local ok, r = pcall(Remotes.Get, name)
	if ok then
		return r
	end
	return nil
end

local function notify(player, text, kind, seconds)
	if not isPlayer(player) or type(text) ~= "string" or text == "" then
		return
	end
	notifyRemote = notifyRemote or remote("Notify")
	if notifyRemote then
		pcall(function()
			notifyRemote:FireClient(player, clip(text, MAX_TOAST_CHARS), kind or "info", seconds or 3)
		end)
	end
end

-- A refusal toast; the same text is not repeated within TOAST_GAP (spam clicks stay quiet).
local function toastOnce(player, text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	local map = toastAt[player]
	if not map then
		map = {}
		toastAt[player] = map
	end
	local now = os.clock()
	local last = map[text]
	if last and now - last < TOAST_GAP then
		return
	end
	map[text] = now
	notify(player, text, kind or "bad", 3)
end

-- Per player per key cooldown.
local function cooldown(player, key, seconds)
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	local now = os.clock()
	local last = map[key]
	if last and now - last < seconds then
		return false
	end
	map[key] = now
	return true
end

-- Per player burst budget shared by every PetCare request and care prompt.
local function spend(player)
	local now = os.clock()
	local b = budgets[player]
	if not b then
		b = { Tokens = BURST_SIZE, At = now }
		budgets[player] = b
	end
	b.Tokens = math.min(BURST_SIZE, b.Tokens + (now - b.At) * BURST_REFILL)
	b.At = now
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

local function setAttr(inst, name, value)
	pcall(function()
		if inst:GetAttribute(name) ~= value then
			inst:SetAttribute(name, value)
		end
	end)
end

-- "Snack" -> "Snacks" (n ~= 1)
local function plural(name, n)
	name = tostring(name)
	if n == 1 then
		return name
	end
	return name .. "s"
end

-- 1234 -> "1.23K" (stat numbers in toasts): Theme.Short, the game's one short-number style (Pitch 2 F0; was its own
-- K / M / B to one decimal); a whole number under 1000 rounds to the nearest as before
local function compact(n)
	n = tonumber(n) or 0
	if not isFinite(n) then
		return "0"
	end
	if math.abs(n) < 1000 then
		return tostring(math.floor(n + 0.5))
	end
	return Theme.Short(n)
end

----------------------------------------------------------------------
-- Data access (DataService; every call guarded)
----------------------------------------------------------------------

local function dsCall(fnName, ...)
	if not dataService or type(dataService[fnName]) ~= "function" then
		return false, nil, nil
	end
	local ok, a, b = pcall(dataService[fnName], ...)
	if not ok then
		warn("[PetCareService] DataService." .. fnName .. " failed: " .. tostring(a))
		return false, nil, nil
	end
	return true, a, b
end

local function getProfile(player)
	local ok, profile = dsCall("GetProfile", player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function getHome(player)
	local ok, home = dsCall("GetHome", player)
	if ok and type(home) == "table" then
		return home
	end
	return nil
end

-- true while the save is a stand-in (DataService refuses XP / growth writes then)
local function isProvisional(player)
	if dataService and type(dataService.IsProvisional) == "function" then
		local ok, result = pcall(dataService.IsProvisional, player)
		return ok and result == true
	end
	return false
end

local function getCash(player)
	local ok, cash = dsCall("GetCash", player)
	if ok and isFinite(cash) and cash > 0 then
		return math.floor(cash)
	end
	return 0
end

local function spendCash(player, n)
	local ok, result = dsCall("SpendCash", player, n)
	return ok and result == true
end

local function addCash(player, n)
	local ok, result = dsCall("AddCash", player, n)
	return ok and result == true
end

local function petLevel(player, key)
	local ok, level, xp = dsCall("GetPetLevel", player, key)
	if not ok or not isFinite(level) or level < 1 then
		level = 1
	end
	if not ok or not isFinite(xp) or xp < 0 then
		xp = 0
	end
	return math.floor(level), xp
end

local function addPetXp(player, key, xp)
	local ok, gained = dsCall("AddPetXp", player, key, xp)
	if ok and isFinite(gained) and gained > 0 then
		return math.floor(gained)
	end
	return 0
end

local function mutateHome(player, fn)
	local ok, result = dsCall("MutateHome", player, fn)
	return ok and result == true
end

----------------------------------------------------------------------
-- Catalog access (TycoonCatalog: the Food Machine, the Training Place, the XP curve)
----------------------------------------------------------------------

local function money(n)
	if catalog and type(catalog.FormatCash) == "function" then
		local ok, text = pcall(catalog.FormatCash, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return "$" .. tostring(math.floor(tonumber(n) or 0))
end

local function stationLevel(home, id)
	if catalog and type(catalog.StationLevel) == "function" then
		local ok, level = pcall(catalog.StationLevel, home, id)
		if ok and isFinite(level) then
			return math.max(0, math.floor(level))
		end
	end
	local v = type(home) == "table" and type(home.Stations) == "table" and home.Stations[id]
	return isFinite(v) and math.max(0, math.floor(v)) or 0
end

-- XP from `level` to level + 1 (the TycoonCatalog curve; DataService's own fallback curve without it)
local function xpToNext(level)
	if catalog and type(catalog.XpToNext) == "function" then
		local ok, need = pcall(catalog.XpToNext, level)
		if ok and type(need) == "number" and need == need and need > 0 then
			return need
		end
	end
	return math.floor(40 * level ^ 1.35 + 0.5)
end

local function maxPetLevel()
	if petCatalog and type(petCatalog.MaxPetLevel) == "function" then
		local ok, n = pcall(petCatalog.MaxPetLevel)
		if ok and isFinite(n) and n >= 1 then
			return math.floor(n)
		end
	end
	if catalog then
		local px = type(catalog.PetXp) == "table" and catalog.PetXp or nil
		for _, v in ipairs({ catalog.MaxPetLevel or false, px and px.MaxLevel or false }) do
			if isFinite(v) and v >= 1 then
				return math.floor(v)
			end
		end
	end
	return FALLBACK_MAX_LEVEL
end

----------------------------------------------------------------------
-- Pets (keys, defs, ownership, levels and caps)
----------------------------------------------------------------------

local function validKeyString(key)
	if type(key) ~= "string" or key == "" or #key > MAX_ID_LENGTH then
		return false
	end
	if petKeys and type(petKeys.Parse) == "function" then
		local ok, parsed = pcall(petKeys.Parse, key)
		return ok and parsed ~= nil
	end
	return string.find(key, "^[%w_%-:@]+$") ~= nil
end

local function defOf(key, profile)
	if not validKeyString(key) then
		return nil
	end
	if petKeys and type(petKeys.DefOf) == "function" then
		local ok, def = pcall(petKeys.DefOf, key, profile)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	if petCatalog and type(petCatalog.Get) == "function" then
		local def = petCatalog.Get(key)
		if type(def) == "table" then
			return def
		end
	end
	return nil
end

local function ownedCount(profile, key)
	if type(profile) ~= "table" or not validKeyString(key) then
		return 0
	end
	if petKeys and type(petKeys.Count) == "function" then
		local ok, n = pcall(petKeys.Count, profile, key)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
		return 0
	end
	local n = type(profile.Pets) == "table" and profile.Pets[key]
	return isFinite(n) and math.max(0, math.floor(n)) or 0
end

local function petName(def, key)
	local name = type(def) == "table" and (def.DisplayName or def.Name) or nil
	if type(name) ~= "string" or name == "" then
		name = tostring(key)
	end
	return clip(name, MAX_NAME_CHARS)
end

-- the level feeding / fights can raise this pet to (PetCatalog.LevelCap: 100 for every rarity, never above the curve)
local function levelCap(def)
	local top = maxPetLevel()
	local cap = nil
	if petCatalog and type(petCatalog.LevelCap) == "function" then
		local ok, n = pcall(petCatalog.LevelCap, def)
		if ok and isFinite(n) then
			cap = n
		end
	end
	if not cap and type(def) == "table" then
		cap = FALLBACK_LEVEL_CAPS[def.Rarity]
	end
	if not isFinite(cap) or cap < 1 then
		return top
	end
	return math.min(math.floor(cap), top)
end

-- XP the pet can still take before it reaches `cap`
local function xpRoom(level, xp, cap)
	if level >= cap then
		return 0
	end
	local total = 0
	for l = level, cap - 1 do
		local need = xpToNext(l)
		if not isFinite(need) then
			break
		end
		total = total + need
	end
	return math.max(0, total - (tonumber(xp) or 0))
end

local function statsOf(def, level)
	if not petCatalog or type(def) ~= "table" then
		return nil
	end
	local fn = petCatalog.StatsOf or petCatalog.GetStats
	if type(fn) ~= "function" then
		return nil
	end
	local ok, stats = pcall(fn, def, level)
	if ok and type(stats) == "table" then
		return stats
	end
	return nil
end

----------------------------------------------------------------------
-- Care helpers: growth, the lock, battles, catalog numbers, texts
----------------------------------------------------------------------

-- { Evo, Speed, Physique, Ability, Defense, Job | nil } (zeros when unknown)
function Care.growth(player, key)
	local ok, g = dsCall("GetGrowth", player, key)
	if ok and type(g) == "table" then
		return g
	end
	local e = { Evo = 0 }
	for _, stat in ipairs(STATS) do
		e[stat] = 0
	end
	return e
end

function Care.growthMap(player)
	local ok, map = dsCall("GetGrowthMap", player)
	if ok and type(map) == "table" then
		return map
	end
	return {}
end

function Care.mutateGrowth(player, fn)
	local ok, result = dsCall("MutateGrowth", player, fn)
	return ok and result == true
end

-- { [key] = true } of the keys in a running battle / ring run of this player, or nil when BattleService has no such
-- function yet (then the whole battle counts: InBattle attribute)
function Care.keysInBattle(player)
	if battleService and type(battleService.KeysInBattle) == "function" then
		local ok, set = pcall(battleService.KeysInBattle, player)
		if ok and type(set) == "table" then
			return set
		end
	end
	return nil
end

function Care.inBattle(player)
	local v = player:GetAttribute(ATTR_IN_BATTLE)
	return v ~= nil and v ~= false
end

function Care.busyInBattle(player, key)
	local set = Care.keysInBattle(player)
	if set then
		return set[key] == true
	end
	return Care.inBattle(player)
end

function Care.statOf(stat)
	if type(stat) ~= "string" or stat == "" or #stat > MAX_STAT_LENGTH then
		return nil
	end
	local s = string.lower((string.gsub(stat, "[%s_%-]", "")))
	return STAT_BY_NAME[s]
end

function Care.statLabel(stat)
	return STAT_LABELS[stat] or tostring(stat)
end

-- 130 -> "2:10", 3600 -> "60:00"
function Care.clock(seconds)
	local s = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

-- "x1.8" / "x19.3" / "x1.2K"
function Care.factorText(n)
	n = tonumber(n) or 0
	if not isFinite(n) or n < 0 then
		n = 0
	end
	if n < 100 then
		local s = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		s = string.gsub(s, "%.0$", "")
		return "x" .. s
	end
	return "x" .. compact(n)
end

function Care.feedXp(level, machineLevel)
	if catalog and type(catalog.FeedXp) == "function" then
		local ok, n = pcall(catalog.FeedXp, level, machineLevel)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return 0
end

function Care.feedPrice(def, level)
	if catalog and type(catalog.FeedPrice) == "function" then
		local ok, n = pcall(catalog.FeedPrice, def, level)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.trainCost(def, rank)
	if catalog and type(catalog.TrainCost) == "function" then
		local ok, n = pcall(catalog.TrainCost, def, rank)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.trainSeconds(rank)
	if catalog and type(catalog.TrainSeconds) == "function" then
		local ok, n = pcall(catalog.TrainSeconds, rank)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.maxRank()
	local t = catalog and type(catalog.Training) == "table" and catalog.Training or nil
	local n = t and t.MaxRank
	if isFinite(n) and n >= 1 then
		return math.floor(n)
	end
	return FALLBACK_MAX_RANK
end

-- pets training at once (the Training Place level; 0 while it is not built)
function Care.trainingSlots(home)
	local n = nil
	if catalog and type(catalog.TrainingSlots) == "function" then
		local ok, v = pcall(catalog.TrainingSlots, home)
		if ok and isFinite(v) then
			n = v
		end
	end
	if n == nil then
		n = stationLevel(home, "Gym")
	end
	return math.max(0, math.min(math.floor(n), MAX_TRAIN_SLOTS))
end

function Care.gardenSlots(home)
	if catalog and type(catalog.GardenSlots) == "function" then
		local ok, n = pcall(catalog.GardenSlots, home)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return 0
end

-- the next stage the pet may evolve to, or nil
function Care.canEvolve(def, level, stage)
	if petCatalog and type(petCatalog.CanEvolve) == "function" then
		local ok, nextStage = pcall(petCatalog.CanEvolve, def, level, stage)
		if ok and isFinite(nextStage) then
			return math.floor(nextStage)
		end
	end
	return nil
end

function Care.maxEvolution(def)
	if petCatalog and type(petCatalog.MaxEvolution) == "function" then
		local ok, n = pcall(petCatalog.MaxEvolution, def)
		if ok and isFinite(n) then
			return math.floor(n)
		end
	end
	return 1
end

-- "Level bonus x1.5" for stage 1, "x1.875" for stage 2 (PetCatalog.EvolutionBonusOf; contract 3.1)
function Care.boostText(stage)
	local m = 1
	if petCatalog and type(petCatalog.EvolutionBonusOf) == "function" then
		local ok, v = pcall(petCatalog.EvolutionBonusOf, stage)
		if ok and isFinite(v) and v >= 1 then
			m = v
		end
	elseif stage >= 2 then
		m = 1.875
	elseif stage >= 1 then
		m = 1.5
	end
	local text = string.format("%.3f", m):gsub("0+$", ""):gsub("%.$", "")
	return "Level bonus x" .. text
end

-- the garden coin power of a pet (TycoonCatalog.PetPower; stage = the stored evolution stage)
function Care.coinsText(def, level, stage)
	if catalog and type(catalog.PetPower) == "function" then
		local ok, power = pcall(catalog.PetPower, def, level, nil, stage)
		if ok and isFinite(power) and power > 0 then
			return "Cash " .. Care.factorText(power) -- (playtest 2026-11-28 C20: was "Coins")
		end
	end
	return ""
end

-- "Coins x1.8" (Economy) / "Power 312, Health 1.2K, Speed 98" (Combat)
function Care.statsText(def, level, stage)
	if type(def) ~= "table" then
		return ""
	end
	if def.Role == "Economy" then
		return Care.coinsText(def, level, stage)
	end
	local stats = statsOf(def, level)
	if not stats then
		return ""
	end
	-- Power and Health are the battle numbers (the same as the Pets detail and the Index)
	if battleCatalog and type(battleCatalog.BattleStatsOf) == "function" then
		local ok, battle = pcall(battleCatalog.BattleStatsOf, def, level, nil, stage)
		if ok and type(battle) == "table" then
			stats.Power, stats.Health = battle.Power, battle.Health
		end
	end
	return "Power " .. compact(stats.Power) .. ", Health " .. compact(stats.Health) .. ", Speed " .. compact(stats.Speed)
end

-- ONE level-up toast per XP grant: "Pebble Pup reached Lv 20: Ready to evolve! Power 312, Health 1.2K, Speed 98"
local function levelUpText(def, key, level, cap, stage, ready)
	local text = petName(def, key) .. " reached Lv " .. level
	if level >= cap then
		text = text .. " (max)"
	end
	if ready then
		text = text .. ": Ready to evolve!"
	else
		text = text .. "!"
	end
	local stats = Care.statsText(def, level, stage)
	if stats ~= "" then
		text = text .. " " .. stats
	end
	return text
end

-- PetService republishes EquippedInfo (level:stage per equipped pet) after a level-up / evolution
function Care.refreshInfo(player)
	if petService and type(petService.Refresh) == "function" then
		pcall(petService.Refresh, player)
	end
end

-- Cap-aware XP. Returns xpGiven, levelsGained, reason (nil on success), the new level / XP / cap / def and whether the
-- pet is now ready to evolve.
local function grantXp(player, key, xp, source)
	-- store: the ONE Pet XP multiplier site (GrantXp's callers' source: Dungeon / Raid / Ring / Duel; the Food Machine's Feed)
	xp = multipliers and multipliers.PetXp(player, xp, source) or xp
	-- whole XP only: DataService reads XP back as whole points, so a fraction could never be seen to arrive
	xp = isFinite(xp) and math.floor(xp) or 0
	if xp < 1 then
		return 0, 0, "No XP to give"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return 0, 0, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return 0, 0, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return 0, 0, "You do not own that pet"
	end
	local level, have = petLevel(player, key)
	local cap = levelCap(def)
	local room = xpRoom(level, have, cap)
	if room <= 0 then
		return 0, 0, petName(def, key) .. " is at max level (Lv " .. cap .. ")", level, have, cap, def
	end
	local give = math.min(xp, room)
	local gained = addPetXp(player, key, give)
	local level2, have2 = petLevel(player, key)
	if gained == 0 and level2 == level and have2 == have then
		return 0, 0, "That pet cannot gain XP right now", level, have, cap, def
	end
	local stage = Care.growth(player, key).Evo
	local ready = Care.canEvolve(def, level2, stage) ~= nil
	if level2 > level then
		PetCareService.LevelUp:Fire(player, key, level2, source)
		Care.refreshInfo(player)
	end
	return give, math.max(0, level2 - level), nil, level2, have2, cap, def, ready, stage
end

----------------------------------------------------------------------
-- Plots (TycoonService) and station models (HomeBuilder)
----------------------------------------------------------------------

local function plotOf(player)
	if tycoonService and type(tycoonService.GetPlot) == "function" then
		local ok, info = pcall(tycoonService.GetPlot, player)
		if ok and type(info) == "table" then
			return info
		end
	end
	return nil
end

function Care.stationModel(info, id)
	local folder = info and info.Folder
	if typeof(folder) ~= "Instance" then
		return nil
	end
	if homeBuilder and type(homeBuilder.GetStation) == "function" then
		local ok, model = pcall(homeBuilder.GetStation, info, id)
		if ok and typeof(model) == "Instance" and model.Parent and model:IsA("Model") then
			return model
		end
	end
	local homeFolder = folder:FindFirstChild("Home")
	local model = homeFolder and homeFolder:FindFirstChild("Station_" .. id) or nil
	if not model and not homeFolder then
		model = folder:FindFirstChild("Station_" .. id, true)
	end
	if model and model:IsA("Model") then
		return model
	end
	return nil
end

----------------------------------------------------------------------
-- Sessions (per player, this server only), deferred toasts, the TrainingPets attribute
----------------------------------------------------------------------

function Care.session(player)
	local s = sessions[player]
	if not s then
		s = { At = os.clock(), Pending = {}, Shown = nil, GymChecked = false, GymToast = false, MigrationSeen = false }
		sessions[player] = s
	end
	return s
end

-- a toast that waits until the client is surely listening (load toasts: LOAD_TOAST_DELAY after the session started)
function Care.queueToast(player, text, kind, seconds)
	local s = Care.session(player)
	s.Pending[#s.Pending + 1] = { Text = text, Kind = kind, Seconds = seconds }
end

function Care.flushToasts(player, s, now)
	if #s.Pending == 0 or now - s.At < LOAD_TOAST_DELAY then
		return
	end
	local list = s.Pending
	s.Pending = {}
	for _, t in ipairs(list) do
		notify(player, t.Text, t.Kind, t.Seconds)
	end
end

function Care.clearShown(player)
	local s = sessions[player]
	local shown = s and s.Shown
	if not shown then
		return
	end
	s.Shown = nil
	if typeof(shown.Folder) == "Instance" then
		setAttr(shown.Folder, ATTR_TRAINING, nil)
		if shown.Info and homeBuilder and type(homeBuilder.SetTraining) == "function" then
			pcall(homeBuilder.SetTraining, shown.Info, {})
		end
	end
end

-- TrainingPets on the plot folder (+ HomeBuilder.SetTraining when it exists), written only when it changes
function Care.publishTraining(player, map)
	local s = Care.session(player)
	local info = plotOf(player)
	local folder = info and info.Folder
	if typeof(folder) ~= "Instance" then
		Care.clearShown(player)
		return
	end
	if s.Shown and s.Shown.Folder ~= folder then
		Care.clearShown(player)
	end
	map = map or Care.growthMap(player)
	local rows = {}
	for key, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" then
			local slot = isFinite(job.Slot) and math.floor(job.Slot) or 0
			rows[#rows + 1] = { Slot = slot, Key = key, Job = job, Text = tostring(slot) .. "=" .. key .. ":" .. tostring(job.Stat) .. ":" .. tostring(math.floor(tonumber(job.Ends) or 0)) }
		end
	end
	table.sort(rows, function(a, b)
		if a.Slot == b.Slot then
			return a.Key < b.Key
		end
		return a.Slot < b.Slot
	end)
	local parts = {}
	for i, r in ipairs(rows) do
		parts[i] = r.Text
	end
	local text = table.concat(parts, ";")
	if s.Shown and s.Shown.Folder == folder and s.Shown.Text == text then
		return
	end
	s.Shown = { Folder = folder, Info = info, Text = text }
	setAttr(folder, ATTR_TRAINING, text)
	if homeBuilder and type(homeBuilder.SetTraining) == "function" then
		local pets = {}
		for _, r in ipairs(rows) do
			pets[r.Slot] = { Key = r.Key, Stat = r.Job.Stat, Ends = r.Job.Ends }
		end
		local ok, err = pcall(homeBuilder.SetTraining, info, pets)
		if not ok then
			warn("[PetCareService] HomeBuilder.SetTraining failed: " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- Feeding (the Food Machine: ONE feed, paid in berries; Phase 5 3.4)
----------------------------------------------------------------------

-- whole berries owned (0 before the load)
function Care.berries(player)
	local ok, n = dsCall("GetBerries", player)
	if ok and isFinite(n) and n > 0 then
		return math.floor(n)
	end
	return 0
end

-- berries of one feed of `def` at `level` (TycoonCatalog.FeedBerries = the Phase 4 FeedPrice: 1 berry = $1 of food)
function Care.feedBerries(def, level)
	if catalog and type(catalog.FeedBerries) == "function" then
		local ok, n = pcall(catalog.FeedBerries, def, level)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return Care.feedPrice(def, level)
end

-- Feed(player, key): exactly one Food Machine feed for FeedBerries(def, level) berries -> FeedXp(level, machineLevel) XP.
-- Checks in order (each a toast, nothing moves before the last): loaded and not provisional; owned; below the cap; not
-- in a running battle or dungeon run; the Food Machine built; berries >= the cost. Then ONE non-yielding step: spend
-- (DataService.SpendBerries), grantXp; an XP write of 0 refunds the berries in the same step. A { Count } / { Food } /
-- string second argument from an old client is ignored (one feed). The old Food items were converted into berries
-- once by DataService's P5Home step, so there is no leftover path.
local function feed(player, key)
	if not initialized then
		return false, "Feeding is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	local level, have = petLevel(player, key)
	local cap = levelCap(def)
	local room = xpRoom(level, have, cap)
	if room <= 0 then
		return false, name .. " is at max level (Lv " .. cap .. ")"
	end
	if Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local home = getHome(player)
	local machineLevel = home and stationLevel(home, "Kitchen") or 0
	if machineLevel < 1 then
		return false, "Build the Food Machine at home first"
	end
	local cost = Care.feedBerries(def, level)
	local give = Care.feedXp(level, machineLevel)
	if not cost or give < 1 then
		return false, "That pet cannot eat right now"
	end
	local berries = Care.berries(player)
	if berries < cost then
		return false, "Not enough berries: a feed needs " .. tostring(cost) .. " (you have " .. tostring(berries) .. "). Your garden pets grow more!"
	end
	-- the berries and the XP in one step (no yields); the berries come back when the XP was refused
	if cost > 0 then
		local okSpend, spent = dsCall("SpendBerries", player, cost)
		if not okSpend or spent ~= true then
			return false, "Not enough berries: a feed needs " .. tostring(cost) .. " (you have " .. tostring(Care.berries(player)) .. "). Your garden pets grow more!"
		end
	end
	local given, levels, reason, newLevel, newXp, cap2, _, ready, stage = grantXp(player, key, math.min(give, room), "Feed")
	if given <= 0 then
		if cost > 0 then
			dsCall("AddBerries", player, cost)
		end
		return false, reason or "That pet cannot eat right now"
	end
	local left = Care.berries(player)
	PetCareService.Fed:Fire(player, key, "Berries", levels)
	-- ONE toast per feed
	if levels > 0 then
		notify(player, levelUpText(def, key, newLevel, cap2 or cap, stage, ready), "good", 5)
	else
		local need = xpToNext(newLevel)
		local progress = isFinite(need) and (" (" .. math.floor(newXp) .. "/" .. need .. " to Lv " .. (newLevel + 1) .. ")") or ""
		notify(player, name .. " ate " .. tostring(cost) .. " berries: +" .. math.floor(given) .. " XP" .. progress, "good", 3)
	end
	return true, { Xp = given, Levels = levels, Level = newLevel, Cap = cap2 or cap, Berries = left, Cost = cost }
end

function PetCareService.Feed(player, key)
	return feed(player, key)
end

----------------------------------------------------------------------
-- EVOLVE
----------------------------------------------------------------------

function Care.openPanel(player, panelId, args)
	openPanelRemote = openPanelRemote or remote("OpenPanel")
	if openPanelRemote and isPlayer(player) then
		pcall(function()
			openPanelRemote:FireClient(player, panelId, args)
		end)
	end
end

function PetCareService.Evolve(player, key)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	if Care.inBattle(player) or Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local level = petLevel(player, key)
	local stage = Care.growth(player, key).Evo or 0
	local nextStage = Care.canEvolve(def, level, stage)
	if not nextStage then
		if stage >= Care.maxEvolution(def) then
			return false, name .. " is fully evolved"
		end
		local levels = petCatalog and type(petCatalog.EvolutionLevels) == "table" and petCatalog.EvolutionLevels or { 20, 50 }
		local need = levels[stage + 1] or 20
		return false, name .. " evolves at level " .. tostring(need) .. " (Lv " .. level .. " now)"
	end
	local ok, wrote = dsCall("SetEvolution", player, key, nextStage)
	if not ok or wrote ~= true then
		return false, "Could not evolve right now, try again"
	end
	PetCareService.Evolved:Fire(player, key, nextStage)
	notify(player, name .. " evolved! " .. Care.boostText(nextStage) .. "!", "good", 6)
	Care.refreshInfo(player)
	Care.openPanel(player, "Evolve", { Key = key, Stage = nextStage })
	return true, nextStage
end

-- Developer tools (/evolvepets, /maxpets): the EVOLVE write and its signal without the level check, the toast and the
-- reveal panel (a whole collection evolves at once). DevService refuses a battle and refreshes EquippedInfo once.
function PetCareService.DevEvolve(player, key, stage)
	local ok, wrote = dsCall("SetEvolution", player, key, stage)
	if not ok or wrote ~= true then
		return false
	end
	PetCareService.Evolved:Fire(player, key, stage)
	return true
end

----------------------------------------------------------------------
-- Training (the Training Place): start, stop, completion, auto-remove / auto-return
----------------------------------------------------------------------

-- the mats in use and the running job count of a player (from the clean growth map)
function Care.usedMats(player)
	local map = Care.growthMap(player)
	local used, n = {}, 0
	for _, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" then
			n = n + 1
			if isFinite(job.Slot) then
				used[math.floor(job.Slot)] = true
			end
		end
	end
	return used, n, map
end

-- where the pet is now: "Garden:<slot>" (the smallest place holding it) | "Follow" | "Free"
function Care.fromOf(profile, home, key)
	local best = nil
	if type(home) == "table" and type(home.Garden) == "table" then
		for slot, k in pairs(home.Garden) do
			if k == key and isFinite(slot) and (best == nil or slot < best) then
				best = math.floor(slot)
			end
		end
	end
	if best then
		return "Garden:" .. best
	end
	if type(profile) == "table" and type(profile.Equipped) == "table" then
		for _, k in ipairs(profile.Equipped) do
			if k == key then
				return "Follow"
			end
		end
	end
	return "Free"
end

-- clears one Garden place (TycoonService.GardenSet, else straight into the saved Home)
function Care.clearGarden(player, slot)
	if tycoonService and type(tycoonService.GardenSet) == "function" then
		local ok, done = pcall(tycoonService.GardenSet, player, slot, nil)
		if ok and done == true then
			return
		end
	end
	mutateHome(player, function(live)
		if type(live.Garden) ~= "table" or live.Garden[slot] == nil then
			return false
		end
		live.Garden[slot] = nil
		return true
	end)
end

-- a training pet leaves the followers (it keeps its team slot) and the Garden by itself
function Care.removePet(player, key)
	Care.refreshInfo(player)
	local home = getHome(player)
	if home and type(home.Garden) == "table" then
		local slots = {}
		for slot, k in pairs(home.Garden) do
			if k == key then
				slots[#slots + 1] = slot
			end
		end
		for _, slot in ipairs(slots) do
			Care.clearGarden(player, slot)
		end
	end
end

-- the pet comes back to where it was (Job.From): "Follow" -> nothing to do, its team slot was never freed; "Garden:n" ->
-- that place when open and empty, else the first free open place; else it stays in the list. A pet in the active team
-- follows again by itself (the Refresh).
function Care.returnPet(player, key, from)
	if not isPlayer(player) then
		return
	end
	Care.sendBack(player, key, from)
	Care.refreshInfo(player)
end

function Care.sendBack(player, key, from)
	local slot = type(from) == "string" and tonumber(string.match(from, "^Garden:(%d+)$")) or nil
	if not slot then
		return
	end
	local home = getHome(player)
	if not home or type(home.Garden) ~= "table" then
		return
	end
	local open = Care.gardenSlots(home)
	local target = nil
	if slot <= open and home.Garden[slot] == nil then
		target = slot
	else
		for s = 1, open do
			if home.Garden[s] == nil then
				target = s
				break
			end
		end
	end
	if target and tycoonService and type(tycoonService.GardenSet) == "function" then
		pcall(tycoonService.GardenSet, player, target, key)
	end
end

-- Finishes a due job: the rank becomes the job's TARGET rank (two servers completing one job give one rank), the
-- job goes, the pet comes back. Returns true when this server completed it.
function Care.completeJob(player, key, job, atLoad)
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" or type(e.Job) ~= "table" or e.Job.Stat ~= job.Stat then
			return false -- changed meanwhile (stopped, or another server's state): nothing to do here
		end
		local rank = e.Job.Rank
		if (e[job.Stat] or 0) < rank then
			e[job.Stat] = rank
		end
		e.Job = nil
		return true
	end)
	if not wrote then
		return false
	end
	local def = defOf(key, getProfile(player))
	local name = petName(def, key)
	local label = Care.statLabel(job.Stat)
	pcall(Care.returnPet, player, key, job.From)
	Care.publishTraining(player)
	if atLoad then
		Care.queueToast(player, "Training done while you were away! " .. name .. ": " .. label .. " Rank " .. tostring(job.Rank), "good", 6)
	else
		notify(player, name .. " finished " .. label .. " training: Rank " .. tostring(job.Rank) .. "!", "good", 5)
	end
	PetCareService.TrainingDone:Fire(player, key, job.Stat, job.Rank)
	return true
end

-- completes every due job (os.time() >= Job.Ends) of a loaded, non-provisional player; returns how many, the map
function Care.settleJobs(player, atLoad)
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return 0, nil
	end
	local map = Care.growthMap(player)
	local now = os.time()
	local done = 0
	for key, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" and isFinite(job.Ends) and now >= job.Ends then
			if ownedCount(profile, key) < 1 then
				Care.mutateGrowth(player, function(g)
					g[key] = nil -- a job of a pet that is gone (fused away elsewhere)
				end)
				done = done + 1
			elseif Care.completeJob(player, key, job, atLoad) then
				done = done + 1
			end
		end
	end
	if done > 0 then
		map = nil -- changed: let the caller re-read
	end
	return done, map
end

function PetCareService.Train(player, key, stat)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	stat = Care.statOf(stat)
	if not stat then
		return false, "Pick a skill: Attack Speed, Physique, Ability or Defense"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	local label = Care.statLabel(stat)
	local home = getHome(player)
	if not home then
		return false, LOADING
	end
	local slots = Care.trainingSlots(home)
	if slots < 1 then
		return false, "Build the Training Place at home first"
	end
	local growth = Care.growth(player, key)
	if type(growth.Job) == "table" then
		return false, name .. " is already training (" .. Care.clock((tonumber(growth.Job.Ends) or 0) - os.time()) .. " left)"
	end
	local rank = isFinite(growth[stat]) and math.floor(growth[stat]) or 0
	local maxRank = Care.maxRank()
	if rank >= maxRank then
		return false, name .. "'s " .. label .. " is at Rank " .. maxRank .. " (max)"
	end
	local used, runningJobs = Care.usedMats(player)
	local mat = nil
	for s = 1, slots do
		if not used[s] then
			mat = s
			break
		end
	end
	if runningJobs >= slots or not mat then
		return false, "The Training Place is full (" .. runningJobs .. "/" .. slots .. " training)"
	end
	if Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local cost = Care.trainCost(def, rank + 1)
	local seconds = Care.trainSeconds(rank + 1)
	if not cost or not seconds then
		return false, "That pet cannot train right now"
	end
	local short = "Not enough Cash: Rank " .. (rank + 1) .. " " .. label .. " costs " .. money(cost)
	if getCash(player) < cost then
		return false, short
	end
	local from = Care.fromOf(profile, home, key)
	-- the payment and the job in one step (no yields): a failed job write gives the Cash back
	if cost > 0 and not spendCash(player, cost) then
		return false, short
	end
	local ends = os.time() + seconds
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" then
			e = {}
			g[key] = e
		end
		if type(e.Job) == "table" then
			return false
		end
		e.Job = { Stat = stat, Ends = ends, Rank = (isFinite(e[stat]) and math.floor(e[stat]) or 0) + 1, Slot = mat, From = from, Paid = cost }
		return true
	end)
	if not wrote then
		if cost > 0 then
			addCash(player, cost)
		end
		return false, "Could not start training right now, try again"
	end
	-- the pet leaves the player and the Garden by itself (Job.From remembers where it was)
	pcall(Care.removePet, player, key)
	Care.publishTraining(player)
	notify(player, name .. " started " .. label .. " training (" .. Care.clock(seconds) .. ")", "good", 4)
	PetCareService.TrainingStarted:Fire(player, key, stat)
	return true, { Rank = rank + 1, Ends = ends, Cost = cost, Slot = mat, From = from }
end

-- Developer tools (/maxpets): a running job finishes now through the real completion (the rank, the pet comes back).
function PetCareService.DevFinishJob(player, key)
	local job = Care.growth(player, key).Job
	if type(job) ~= "table" then
		return false
	end
	return Care.completeJob(player, key, job, false)
end

function PetCareService.TrainStop(player, key)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	local name = petName(def, key)
	local job = Care.growth(player, key).Job
	if type(job) ~= "table" then
		return false, name .. " is not training"
	end
	if isFinite(job.Ends) and os.time() >= job.Ends then
		-- already done: it finishes instead (the rank is earned, nothing to refund)
		Care.completeJob(player, key, job, false)
		return true, 0
	end
	local paid = isFinite(job.Paid) and math.max(0, math.floor(job.Paid)) or 0
	-- the job goes and the Cash comes back in the same step (they travel in the same save)
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" or type(e.Job) ~= "table" then
			return false
		end
		e.Job = nil
		return true
	end)
	if not wrote then
		return false, "Could not stop training right now, try again"
	end
	if paid > 0 then
		addCash(player, paid)
	end
	pcall(Care.returnPet, player, key, job.From)
	Care.publishTraining(player)
	if paid > 0 then
		notify(player, name .. " stopped training: " .. money(paid) .. " back", "info", 3)
	else
		notify(player, name .. " stopped training", "info", 3)
	end
	return true, paid
end

----------------------------------------------------------------------
-- Home load: the retired Gym, offline completions
----------------------------------------------------------------------

-- empties Home.Gym (the Gym is the Training Place now) once the home is readable; one toast per session, also when
-- DataService's one-time migration freed the Gym pets this session
function Care.freeOldGym(player)
	local s = Care.session(player)
	if s.GymChecked then
		return
	end
	local home = getHome(player)
	if not home then
		return -- not loaded yet / provisional: ProfileRebased and the tick bring us back
	end
	s.GymChecked = true
	local freed = 0
	if type(home.Gym) == "table" and next(home.Gym) ~= nil then
		local n = 0
		local wrote = mutateHome(player, function(live)
			if type(live.Gym) ~= "table" then
				return false
			end
			local slots = {}
			for slot, k in pairs(live.Gym) do
				if type(k) == "string" then
					n = n + 1
				end
				slots[#slots + 1] = slot
			end
			for _, slot in ipairs(slots) do
				live.Gym[slot] = nil
			end
			return #slots > 0
		end)
		if wrote then
			freed = freed + n
		end
	end
	if not s.MigrationSeen then
		local ok, info = dsCall("MigratedNow", player, "P4")
		if ok and type(info) == "table" then
			s.MigrationSeen = true
			if isFinite(info.GymPets) and info.GymPets > 0 then
				freed = freed + math.floor(info.GymPets)
			end
		end
	end
	if freed > 0 and not s.GymToast then
		s.GymToast = true
		Care.queueToast(player, "The Gym is now the Training Place: your gym pets are back with you", "info", 6)
	end
end

-- ProfileLoaded / ProfileRebased (and players already here at Init): the old Gym, the jobs that ended meanwhile
function Care.onProfileReady(player)
	if not isPlayer(player) then
		return
	end
	local s = Care.session(player)
	s.GymChecked = false -- a rebased save may hold Gym pets again (a Phase 3 server during the rollout)
	if not getProfile(player) or isProvisional(player) then
		return
	end
	Care.freeOldGym(player)
	local done, map = Care.settleJobs(player, true)
	if done > 0 then
		map = nil
	end
	Care.publishTraining(player, map)
end

----------------------------------------------------------------------
-- Prompts (FeedPrompt on the Food Machine, TrainPrompt on the Training Place)
----------------------------------------------------------------------

local function biggestPart(model)
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local best, size = nil, -1
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local s = d.Size.X * d.Size.Y * d.Size.Z
			if s > size then
				best, size = d, s
			end
		end
	end
	return best
end

local function newPrompt(parent, name, action, object, ownerId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = PROMPT_KEYS.Keyboard
	prompt.GamepadKeyCode = PROMPT_KEYS.Gamepad
	prompt.HoldDuration = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OwnerUserId", ownerId)
	prompt:SetAttribute(CARE_MARK, true)
	prompt.Parent = parent
	return prompt
end

local function clearCarePrompts(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d.Parent and d:GetAttribute(CARE_MARK) == true then
			d:Destroy()
		end
	end
end

-- the part a prompt sits on: the named part (a part inside a named model) when the station has it, else its biggest
function Care.anchorOf(model, anchorName)
	if anchorName then
		local found = model:FindFirstChild(anchorName, true)
		if found then
			if found:IsA("BasePart") then
				return found
			end
			local inner = found:FindFirstChildWhichIsA("BasePart", true)
			if inner then
				return inner
			end
		end
	end
	return biggestPart(model)
end

-- one owner-only prompt per station (rebuilt when the station or its owner changes; the signature carries "p4:")
function Care.ensurePrompt(player, info, home, stationId, promptName, action, object, anchorName)
	local level = stationLevel(home, stationId)
	if level < 1 then
		return
	end
	local model = Care.stationModel(info, stationId)
	if not model then
		return
	end
	local sig = SIG_PREFIX .. stationId .. ":" .. tostring(level) .. ":" .. tostring(player.UserId)
	if model:GetAttribute(CARE_SIG) == sig then
		return
	end
	clearCarePrompts(model)
	local anchor = Care.anchorOf(model, anchorName)
	if not anchor then
		return
	end
	local prompt = newPrompt(anchor, promptName, action, object, player.UserId)
	prompt:SetAttribute("StationId", stationId)
	model:SetAttribute(CARE_SIG, sig)
end

function Care.ensurePrompts(player, info, home)
	Care.ensurePrompt(player, info, home, "Kitchen", "FeedPrompt", "Feed pets", "Food Machine", "Hopper")
	Care.ensurePrompt(player, info, home, "Gym", "TrainPrompt", "Train pets", "Training Place", nil)
end

local function onPromptTriggered(prompt, player)
	if typeof(prompt) ~= "Instance" or not isPlayer(player) then
		return
	end
	local name = prompt.Name
	if name ~= "FeedPrompt" and name ~= "TrainPrompt" then
		return
	end
	if prompt:GetAttribute(CARE_MARK) ~= true or prompt:GetAttribute("OwnerUserId") ~= player.UserId then
		return -- someone else's home (their prompts are disabled locally; never trust a stray trigger)
	end
	local info = plotOf(player)
	if not info or typeof(info.Folder) ~= "Instance" or not prompt:IsDescendantOf(info.Folder) then
		return
	end
	if not cooldown(player, "Prompt", PROMPT_COOLDOWN) or not spend(player) then
		return
	end
	if name == "FeedPrompt" then
		Care.openPanel(player, "Pets", { Tab = "Pets", Action = "Feed" })
	else
		Care.openPanel(player, "Train")
	end
end

----------------------------------------------------------------------
-- Extras
----------------------------------------------------------------------

-- Cap-aware XP for other services (battles, the Champion Ring): never past the pet's level cap. Returns xpGiven,
-- levelsGained, reason (nil when XP was given). ONE toast per grant: the level-up toast with the new stats (and
-- "Ready to evolve!" at 20 / 50), whatever the number of levels crossed.
function PetCareService.GrantXp(player, key, xp, source)
	if not initialized then
		return 0, 0, "Pet care is not ready yet"
	end
	if not isPlayer(player) or not validKeyString(key) then
		return 0, 0, "Unknown pet"
	end
	local given, levels, why, newLevel, _, cap, def, ready, stage = grantXp(player, key, tonumber(xp), source or "Other")
	if levels > 0 and def then
		notify(player, levelUpText(def, key, newLevel, cap, stage, ready), "good", 5)
	end
	return given, levels, why
end

function PetCareService.LevelCap(player, key)
	local def = defOf(key, player and getProfile(player) or nil)
	if not def then
		return nil
	end
	return levelCap(def)
end

-- Developer tools ("Reset my data"): drops this server's session state of the player (deferred toasts, the published
-- TrainingPets, the Gym check). The saved growth is wiped by DevService itself.
function PetCareService.ClearSessions(player)
	if not player then
		return false
	end
	Care.clearShown(player)
	local s = sessions[player]
	if s then
		s.Pending = {}
		s.GymChecked = false
		s.GymToast = false
		s.MigrationSeen = false
	end
	cooldowns[player] = nil
	return true
end

----------------------------------------------------------------------
-- Remote PetCare(action, a, b)
----------------------------------------------------------------------

local function onPetCare(player, action, a, b)
	if not isPlayer(player) or type(action) ~= "string" or #action > MAX_ACTION_LENGTH then
		return
	end
	if not spend(player) then
		return
	end
	if action == "Feed" then
		if not cooldown(player, "Feed", FEED_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		-- (a { Count } / { Food } / string in `b` from an old client is ignored: exactly one feed)
		local ok, reason = feed(player, key)
		if not ok then
			toastOnce(player, reason or "That pet cannot eat now", "bad")
		end
	elseif action == "Evolve" then
		if not cooldown(player, "Evolve", EVOLVE_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		local ok, reason = PetCareService.Evolve(player, key)
		if not ok then
			toastOnce(player, reason or "That pet cannot evolve now", "bad")
		end
	elseif action == "Train" then
		if not cooldown(player, "Train", TRAIN_COOLDOWN) then
			return
		end
		local key, stat = a, b
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
			stat = a.Stat
			if stat == nil then
				stat = a.Skill
			end
			if stat == nil then
				stat = a[2]
			end
		end
		local ok, reason = PetCareService.Train(player, key, stat)
		if not ok then
			toastOnce(player, reason or "That pet cannot train now", "bad")
		end
	elseif action == "TrainStop" then
		if not cooldown(player, "Train", TRAIN_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		local ok, reason = PetCareService.TrainStop(player, key)
		if not ok then
			toastOnce(player, reason or "That pet is not training", "bad")
		end
	elseif action == "Cook" then
		toastOnce(player, "The Kitchen is now the Food Machine: press E at it to feed your pets", "info")
	elseif action == "GymSet" then
		toastOnce(player, "The Gym is now the Training Place: press E at it to train a pet", "info")
	end
end

----------------------------------------------------------------------
-- Tick + players
----------------------------------------------------------------------

local function tickPlayer(player, now)
	local s = Care.session(player)
	local profile = getProfile(player)
	local readable = profile ~= nil and not isProvisional(player)
	local map = nil
	if readable then
		if not s.GymChecked then
			Care.freeOldGym(player)
		end
		local done
		done, map = Care.settleJobs(player, false)
		if done > 0 then
			map = nil
		end
	end
	local info = plotOf(player)
	if info and readable then
		local home = getHome(player)
		if home then
			Care.ensurePrompts(player, info, home)
			Care.publishTraining(player, map)
		end
	elseif s.Shown then
		Care.clearShown(player)
	end
	Care.flushToasts(player, s, now)
end

local function tickAll()
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayer(player) then
			local ok, err = pcall(tickPlayer, player, now)
			if not ok then
				warn("[PetCareService] tick failed: " .. tostring(err))
			end
		end
	end
end

local function tickLoop()
	while running do
		task.wait(TICK)
		if not running then
			break
		end
		local ok, err = pcall(tickAll)
		if not ok then
			warn("[PetCareService] tick failed: " .. tostring(err))
		end
	end
end

local function onPlayerAdded(player)
	Care.session(player)
	if getProfile(player) and not isProvisional(player) then
		local ok, err = pcall(Care.onProfileReady, player)
		if not ok then
			warn("[PetCareService] load failed: " .. tostring(err))
		end
	end
end

local function onPlayerRemoving(player)
	departed[player] = true
	Care.clearShown(player)
	sessions[player] = nil
	cooldowns[player] = nil
	budgets[player] = nil
	toastAt[player] = nil
end

local function connectSignal(signal, fn, what)
	if type(signal) == "table" and type(signal.Connect) == "function" then
		local ok, err = pcall(function()
			signal:Connect(function(...)
				local okCall, callErr = pcall(fn, ...)
				if not okCall then
					warn("[PetCareService] " .. what .. " handler failed: " .. tostring(callErr))
				end
			end)
		end)
		if not ok then
			warn("[PetCareService] could not listen to " .. what .. ": " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function PetCareService.Init(deps)
	if initialized then
		return
	end
	deps = deps or {}
	local services = script.Parent
	dataService = deps.DataService or requireModule(services, "DataService")
	petService = deps.PetService
	tycoonService = deps.TycoonService
	battleService = deps.BattleService
	multipliers = deps.Multipliers
	catalog = requireModule(Shared, "TycoonCatalog")
	petKeys = requireModule(Shared, "PetKeys")
	petCatalog = requireModule(Shared, "PetCatalog")
	battleCatalog = requireModule(Shared, "BattleCatalog")
	if not catalog then
		warn("[PetCareService] TycoonCatalog is missing: the Food Machine, EVOLVE and the Training Place are disabled")
		return
	end
	if not dataService or type(dataService.AddPetXp) ~= "function" then
		warn("[PetCareService] DataService has no pet level API: the Food Machine, EVOLVE and the Training Place are disabled")
		return
	end
	if type(dataService.MutateGrowth) ~= "function" then
		warn("[PetCareService] DataService has no PetGrowth API: EVOLVE and training will refuse")
	end
	homeBuilder = services and services:FindFirstChild("HomeBuilder") and requireModule(services, "HomeBuilder") or nil
	initialized = true

	local petCare = remote("PetCare")
	if petCare then
		petCare.OnServerEvent:Connect(onPetCare)
	else
		warn("[PetCareService] the PetCare remote is missing (Config.Remotes)")
	end
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	-- the old Gym is emptied and due jobs finish when a save becomes readable (load, rebase, dev reset)
	connectSignal(dataService.ProfileLoaded, Care.onProfileReady, "DataService.ProfileLoaded")
	connectSignal(dataService.ProfileRebased, Care.onProfileReady, "DataService.ProfileRebased")
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	running = true
	task.spawn(tickLoop)
end

return PetCareService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1109">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[-- PetService: pet ownership, roulette purchases, equipping and pet perks (ARCHITECTURE_V2.md s.2).
--
--   PetService.Init(lobbyInfo, deps)         deps = { DataService = }. Builds the lobby prompts (again on a second call,
--                                            e.g. a rebuilt lobby: the old ones are destroyed first): one RoulettePrompt
--                                            per machine ("Open" / its name, range 12) -> OpenPanel("Shop", { Tab =
--                                            "Roulette", RouletteId }); lobby shop 16.3 (Task 23): the walk-up ShopPrompt
--                                            ("Open" / "Shop", range 10, HoldDuration 0, no line of sight) on
--                                            lobbyInfo.Shop.Counter.PromptPart (the egg row under the WINGED PETS board,
--                                            shop-area 16.17.2) -> OpenPanel("Shop", { Tab =
--                                            "Eggs" }) after a live-player, not-InMatch, PROMPT_COOLDOWN check; no part ->
--                                            one warn, no prompt
--   PetService.BuyRoulette(player, rouletteId, currency|nil, spins|nil) -> ok, reply|reason
--                                            currency: nil = the roulette's own ("Tokens"; the gems-only Secret
--                                            roulette: "Gems"), "Tokens" or "Gems" (also { Currency = ... });
--                                            spins: nil = 1, only 1 or 3 (never 3 on a gems-only roulette): anything
--                                            else answers "Bad spins". A gems-only (Secret) spin away from the Storm
--                                            Altar answers "Secret rolls happen at the Storm Altar" (shop-area 16.17.3).
--                                            See "The money step" below.
--   PetService._SetRngForTest(rollRng, stripRng)   Studio / the mock only: seeded generators (nil keeps the current)
--   PetService._SetFaultForTest(stage, fn)         Studio / the mock only: fn() runs inside step 3 ("plan") or inside
--                                            the step-6 refresh pcall ("after"); nil fn clears it
--   PetService.Equip / Unequip(player, key)    -> ok, reason   (team balance: put a key in / take it out of the active
--                                            team, through DataService.SetTeam: Equip fills the first empty slot)
--   PetService.GetEquipped(player) -> {key...}
--   PetService.GetPerks(player) -> {MaxHealth, TokenBonus, StaminaRegen, CheckpointHeal}
--   PetService.GetTokenMultiplier(player) -> number >= 1
--   PetService.PerksChanged                  Util.Signal, Fire(player)
--   PetService.Rolled                        Util.Signal, Fire(player, petId) after every successful roll (v3; once per
--                                            pull of a request, after the reply)
--   PetService.GrantPet(player, petId, opts) -> ok, result|reason   store (2026-11-04, spec 5.4): the ONE pet-grant path
--                                            outside the roulette (the Store's packs, the daily gifts' Week Wisp). opts =
--                                            { Count = n >= 1 (default 1), Level = n | nil }. Grants min(Count, MaxPerStack
--                                            - owned) Normal copies through the roll's own two parts (planCopies +
--                                            writeCopies) WITHOUT a spin: the
--                                            first-pet auto-equip, the Index discovery, SetPetLevel(max(current, Level)),
--                                            MarkDirty, Refresh, Sync. result = { PetId, Key, Granted, Count, IsNew,
--                                            NewDiscovery, Level }. Refused: not here, a save not loaded or provisional
--                                            ("Your save is still loading"), an unknown pet, a junk Count / Level, a full
--                                            stack ("Stack full": nothing written, the caller substitutes). Never fires
--                                            Rolled. Non-yielding.
--   Extra (Phase 2): PetService.Refresh(player) -> changed   DataService.SyncEquipped (the followers = the active team minus
--                    busy pets, after FusionService / DevService removed copies, a training job, a Garden change) and
--                    republishes the attributes and perks. DataService.TeamsChanged republishes them too.
-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.7, 5.3, 5.4):
--   * the training lock: Equip refuses a key with a running training job ("Rocky is training (2:10 left)"; the ONE
--     source is DataService.TrainingKeys). A team pet that starts training keeps its slot and leaves the followers
--     (PetCareService calls Refresh).
-- Bug batch 2 #18 ("Remote recall"): a pet working in the Garden is busy gardening. A pet whose every copy is placed in
--   the Garden / Gym (DataService.PlacedCopies) cannot follow: Equip refuses it ("Rocky is gardening! Take it out of the
--   garden first"; the client asks first and recalls it with ONE request, TycoonService.GardenRecall). A team pet sent to
--   the Garden keeps its slot.
--   PetService.CanEquip(player, key, freed?) -> ok, reason   Equip's checks without equipping; `freed` = copies about to
--     leave the Garden (the recall checks before it takes the pet out).
--   * attribute EquippedInfo (Config.Attr) = "23:1,5:0": level:evolution stage per EquippedPets entry, written by
--     refreshPlayer (equip changes, Refresh after level-ups / evolutions) only when it changed and at most every 0.5 s
--     per player (a burst of level-ups coalesces into one deferred write); other clients draw the pet cards and the
--     evolved follower models from it.
--
-- v3 (ARCHITECTURE_V3.md section 3): every successful roll marks the pet as discovered for the Pet Index
-- (DataService.MarkDiscovered) before the ProfileSync goes out; RouletteResult.IsNew keeps meaning "first time
-- owned" and the payload also carries NewDiscovery (first time in the Index). Owned pets are re-checked as
-- discovered whenever a profile loads or is rebased.
--
-- Phase 2 (ARCHITECTURE_V3.md "Pet keys"): a pet COPY is a key (shared/PetKeys.lua): "petId" (Normal),
-- "petId@Golden", "petId@Rainbow", "hyb:<uid>" (a fused hybrid). Equip / Unequip take keys; an old plain petId is
-- the Normal key, so old callers keep working (Unequip(petId) also takes off a tier copy of that pet when no Normal
-- copy is equipped). Perks and the token multiplier sum PetKeys.DefOf(key).Perks x PetKeys.StatMultiplier(tier)
-- (DataService.ComputePerks), capped as before. The roulette still adds Normal copies (Pets[petId] + 1).
--
-- Phase 2 gems (ARCHITECTURE_V3.md "GemService"): a roulette can also be paid in Gems. GemService (looked up when
-- needed, so it may be missing) owns the gem prices (Config.Gems.RouletteGemPrices, the same odds as with tokens), the
-- PolicyService paid-random-items check and the gems-only Secret roulette (Config.Gems.SecretRoulette, rolled by
-- GemService.RollPet); its Quote is taken first, then the shared roll charges the Gems (DataService.SpendGems) and
-- grants in one non-yielding step. A gem roll without GemService, for a restricted (or not yet checked) account or
-- for a roulette without a gem price is refused before anything is charged. Secret pets only ever come out of a
-- roulette with AllowSecret = true (the Secret Roulette, and Celestial's 2% row since lobby-shop 16.1, token or gem
-- paid; only the Secret Roulette counts the pity): a Secret result of any other roulette is refused (nothing charged). The
-- BuyRoulette remote takes the optional currency as its second argument; RouletteResult gains Currency, Price, Gems.
--
-- The money step (lobby-shop spec 5.1 / 7): BuyRoulette(player, rouletteId, currency, spins) is ONE non-yielding step
-- (no task.wait, DataStore or remote call) that never refuses after the roll:
--   1. the checks, in order, with today's texts: a live player, a known roulette, the currency ("Unknown currency"),
--      the spins count ("Bad spins"), shop-area 16.17.3: a gems-only (Secret) spin only at the Storm Altar (the player's
--      own HumanoidRootPart, Config.AtAltar + AltarRangeSlack; no root / no altar attribute fails closed; "Secret rolls
--      happen at the Storm Altar"; the client's FromAltar is never read), not in a match, the profile loaded ("Your data is still loading"), the Secret
--      Roulette's pity read (DataService.GetPity; provisional or no answer -> "Your data is still loading"), a
--      gem-priced spin only once DataService.GemsSettled (the server-hop settle hold, same text), GemService.Quote (the
--      PolicyService lock, unchanged), a token-paid spin only for a PolicyService-"Allowed" account (16.12:
--      GemService.TokenSpinLock; "Token spins are not available on your account", or the checking text while unknown;
--      ONLY while the Store is on, release step 1: with Config.Store.Enabled off every account spins with Tokens),
--      the balance against Price = UnitPrice x spins (computed once, both currencies);
--   2. the pulls, from RNG.Roll in order (roll(id, RNG.Roll): PetCatalog.RollPet, or the quote's GemService.RollPet
--      for the Secret Roulette; the pity's forced pull is roll(id, RNG.Roll, { ForceRarity = "Secret" }), Pity = true,
--      and must come back a Secret). A pull's rarity is its rolled pet's and never changes. A pet the player cannot hold
--      another copy of (owned + earlier pulls of this request >= MaxPerStack) is re-picked uniformly with RNG.Roll from
--      PetCatalog.RarityPool(id, rarity) minus the full pets; only when every pet of that rarity is full the pull keeps
--      its pet and becomes a Substitute of PetService.SubstituteTokens(id, rarity) (Count = the full stack): that
--      rarity's Config.Index.Rewards Tokens, at most half the token roulette's Price (review round 1: never a token
--      source; the gems-only Secret Roulette pays the reward). The kept
--      exception: a Secret pet out of a roulette without AllowSecret refuses the whole request "The roulette jammed, try
--      again" (an impossible roll, before the charge);
--   3. everything that can fail, before the charge, in a pcall: the grant plans (planCopies: IsNew, NewDiscovery,
--      Count), PoolSize, the strips (buildStrip, RNG.Strip), the Secret pity's new numbers, the reply table; an error
--      answers "The roulette jammed, try again" with nothing charged;
--   4. one charge (SpendTokens / SpendGems of Price);
--   5. plain writes: writeCopies per pull in order (the Pets counts, Discovered), AddTokens per substitute,
--      Stats.Spins += spins, the Secret pity (DataService.SetPity), MarkDirty;
--   6. after the step, each in its own pcall (a failure is logged and never undoes the grant): refreshPlayer, the
--      SecretPityLeft attribute (a Secret Roulette spin), the first pet ever into the active team (SetTeam), one Sync,
--      the RouletteResult reply, Rolled:Fire per pull (a substitute fires with its rolled pet), the announcement (one
--      per request, see below).
-- The announcement (spec 5.5): one server chat line per request, for Legendary and up only (ANNOUNCE_ORDER): the best
-- pull of the request (the highest rarity, the first on ties; a substitute counts with its rolled pet) is named, N = its
-- other Legendary-or-better pulls: "<DisplayName> hatched a <Rarity> <Pet name>!" plus " (+N more)" when N > 0, as
-- Notify kind "pull" (the client shows it as a system chat line). The other players get it at once, the puller after
-- ANNOUNCE_DELAY (his reveal plays first). At most one line per player every ANNOUNCE_GAP: a request inside the gap
-- is held and every held request goes out as ONE line when the gap ends (the best held pull named, (+N more) counting
-- every other held Legendary-or-better pull), so an x3 spender cannot flood the chat. A held line of a player who
-- leaves is dropped. The text is built here from the DisplayName and the catalog name only.
-- The Secret pity (spec 5.2): Config.Gems.SecretRoulette.PityAt (7) = the 7th Secret Roulette spin in a row without a
-- Secret is a Secret. The count is the save's Pity.Secret = { Spins, Hit } (Since = max(0, Spins - Hit)): a spin is
-- forced when Since >= PityAt - 1; every spin adds 1 to Spins (a substitute too); a Secret pull (natural, forced or a
-- substitute) sets Hit = Spins. Read in step 1, computed in step 3, written in step 5 in the same profile write as the
-- spend and the pet. The strip of a forced pull is drawn as always (the plain roll from RNG.Strip): it shows the odds.
-- Attribute SecretPityLeft (Config.Attr) = clamp(PityAt - Since, 1, PityAt), written by refreshPityAttr on
-- ProfileLoaded, ProfileRebased, DataService.Settled and after each Secret spin; absent while loading, provisional or
-- not settled (DataService.GemsSettled false).
-- Every accepted request is charged once and gets all its pulls; a refused request writes nothing. x3 costs exactly 3 x
-- x1. The two generators (RNG.Roll for the pulls, RNG.Strip for the strips) are made once at Init with Util.NewRng()
-- (Random.new() without a seed: engine seeded, never the clock, the user id or Stats.Spins, never sent), so the pulls
-- of an x3 are independent and a strip says nothing about the roll generator.
-- The reply (RouletteResult, and BuyRoulette's second value):
--   { Ok = true, RouletteId, Currency, Spins, UnitPrice, Price = UnitPrice x Spins,
--     Pulls = { { PetId, Key, Rarity, IsNew, NewDiscovery, Count, PoolSize, Strip = { petId x 40, the winner at 34 },
--                 Pity = true|nil, Substitute = { Tokens } | nil }... },
--     PetId, Key, IsNew, NewDiscovery, Count, Strip (pull 1 mirrored for older readers), Tokens, Gems (after the step),
--     SecretPity = { Left = 1..PityAt } (the Secret Roulette only; the same clamped number as the attribute) }
--   The remote's failure answer: { Ok = false, Reason, RouletteId, Currency, Spins, Tokens, Gems }.
-- The BuyRoulette remote (rouletteId, currency, spins): the 0.25 s cooldown first, then rouletteId a string <= 48 and
-- spins nil / 1 / 3 (3 never on a gems-only roulette); anything else is dropped silently.
--
-- Everything is server authoritative: the client only sends ids, we validate ownership, prices,
-- stack caps and slot limits, then write to the live profile and Sync it back.
--
-- Perk plumbing:
--   * attribute EquippedPets (csv of keys)   -> every client draws that player's followers
--   * attribute EquippedHybrids              -> the looks of the equipped hybrids (other clients cannot see the
--                                               owner's profile): "uid=Body/Style/Tier/Rarity[/Seed[/Elements]];..."
--                                               -- set BEFORE EquippedPets, only once a player ever equips a hybrid.
--                                               Field 6 (gui-redo) = the record's Elements joined by "+" in their
--                                               order (the chosen first element first; field 5 "" without a Seed);
--                                               left out when the record has none (today's 4 / 5 fields)
--   * attribute PerkStaminaRegen         -> MovementController scales its stamina regen
--   * MaxHealth                          -> PlayerService (Main hands it GetPerks and calls RefreshMaxHealth
--                                           when PerksChanged fires), so this module never touches Humanoids
--   * TokenBonus / CheckpointHeal        -> read by MatchService through GetPerks / GetTokenMultiplier
-- perkState is updated BEFORE PerksChanged fires, so listeners always see the new numbers.
-- Equip / Unequip / BuyRoulette are refused while the player attribute InMatch is true, so the
-- loadout cannot be hot-swapped between token pickups and checkpoints.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local PetService = {}
PetService.PerksChanged = Util.Signal()
PetService.Rolled = Util.Signal()

local STRIP_LENGTH = 40 -- cosmetic roulette strip: the client scrolls it and stops on WIN_INDEX
local WIN_INDEX = 34
local REMOTE_COOLDOWN = 0.25 -- seconds per player per remote
local PROMPT_COOLDOWN = 0.5
local ANNOUNCE_DELAY = 5 -- seconds before the puller sees their own server-wide announcement
local ANNOUNCE_GAP = 10 -- seconds: at most one announcement per player in this time (later requests are held, then sent as one)
local MAX_ID_LENGTH = 48
local PROMPT_NAME = "RoulettePrompt"
local HYBRID_ATTR = "EquippedHybrids" -- not in Config.Attr (lead-owned): the looks of equipped hybrids, see the header
local SECRET_RARITY = "Secret" -- Secret pets come only from a roulette with AllowSecret = true (Secret, Celestial)
local MAX_CURRENCY_LENGTH = 16

----------------------------------------------------------------------
-- Optional collaborators (written by other modules; every use is guarded)
----------------------------------------------------------------------

local function loadShared(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[PetService] missing shared module: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[PetService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local PetCatalog = loadShared("PetCatalog")
local PetKeys = loadShared("PetKeys")
local StoreCatalog = loadShared("StoreCatalog") -- the Store switch (release step 1): tokenSpinLock reads it

-- GemService (Phase 2, gems) is looked up when a gem roll needs it: an optional module that Main loads after this one
-- (requiring it here at load time would tie the two to their load order).
local gemModule = nil
local function getGemService()
	if gemModule then
		return gemModule
	end
	local inst = script.Parent:FindFirstChild("GemService")
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		gemModule = result
		return result
	end
	return nil
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local roulettes = {} -- [id] = Config.Roulettes entry
for _, entry in ipairs(Config.Roulettes) do
	roulettes[entry.Id] = entry
end

local rarityOrder = {} -- [rarityId] = Order
for _, entry in ipairs(Config.Rarities) do
	rarityOrder[entry.Id] = entry.Order
end
local ANNOUNCE_ORDER = rarityOrder.Legendary or 5 -- lobby-shop spec 5.5: Legendary, Mythic and Secret pulls are announced

local perkState = {} -- [player] = { Perks = {...} }
local announceHold = {} -- [player] = { At = os.clock() of the last line, Held = { Def, Order, More } | nil }: announcePulls
local lastCall = {} -- [player] = { [key] = os.clock() }
local infoState = {} -- [player] = { At = os.clock() of the last EquippedInfo write, Pending = true while a deferred write waits }
local INFO_GAP = 0.5 -- EquippedInfo is written at most this often per player (level-up bursts coalesce)
local remotesConnected = false
local playersConnected = false
local promptObjects = {}
-- The money step's two server-wide generators (see the header): Roll for the pulls, Strip for the cosmetic strips.
-- Made in Init (or at the first spin); PetService._SetRngForTest swaps them in Studio / the mock.
local RNG = { Roll = nil, Strip = nil }
local faults = {} -- [stage] = fn: PetService._SetFaultForTest (Studio / the mock only), "plan" (step 3) or "after" (step 6)

local ZERO_PERKS = { MaxHealth = 0, TokenBonus = 0, StaminaRegen = 0, CheckpointHeal = 0 }

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function rateLimited(player, key, interval)
	local record = lastCall[player]
	if not record then
		record = {}
		lastCall[player] = record
	end
	local now = os.clock()
	local last = record[key]
	if last and now - last < interval then
		return true
	end
	record[key] = now
	return false
end

local function validId(id)
	return type(id) == "string" and #id > 0 and #id <= MAX_ID_LENGTH
end

-- Perks are read by MatchService at the moment of each pickup / checkpoint, so the loadout must not
-- change while a match runs (same rule as the roulette and the item shop).
local function inMatch(player)
	return player:GetAttribute(Config.Attr.InMatch) == true
end

local function fireClient(remoteName, player, ...)
	local ok, remote = pcall(Remotes.Get, remoteName)
	if ok and remote and player and player.Parent then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

-- every owned copy (Normal, tiers, hybrids): the very first pet ever is equipped automatically
local function totalPets(profile)
	local n = 0
	for _, count in pairs(profile.Pets) do
		n = n + count
	end
	for _, entry in pairs(type(profile.Tiers) == "table" and profile.Tiers or {}) do
		if type(entry) == "table" then
			for _, count in pairs(entry) do
				if type(count) == "number" then
					n = n + count
				end
			end
		end
	end
	for _ in pairs(type(profile.Hybrids) == "table" and profile.Hybrids or {}) do
		n = n + 1
	end
	return n
end

-- PetKeys.Parse(key) or nil (a plain petId when PetKeys is missing)
local function parseKey(key)
	if PetKeys and type(PetKeys.Parse) == "function" then
		local ok, parsed = pcall(PetKeys.Parse, key)
		if ok then
			return parsed
		end
		return nil
	end
	if validId(key) then
		return { Key = key, PetId = key, Tier = "Normal" }
	end
	return nil
end

-- The definition of a key (PetKeys.DefOf: catalog def, tier def or hybrid def), or nil for unknown keys.
-- Without PetKeys plain ids resolve through PetCatalog; without either nothing can be called unknown (true).
local function defOf(key, profile)
	if PetKeys and type(PetKeys.DefOf) == "function" then
		local ok, def = pcall(PetKeys.DefOf, key, profile)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	if PetCatalog and type(PetCatalog.Get) == "function" then
		local ok, def = pcall(PetCatalog.Get, key)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	return true
end

-- copies of `key` the profile owns
local function ownedCount(profile, key)
	if PetKeys and type(PetKeys.Count) == "function" then
		local ok, n = pcall(PetKeys.Count, profile, key)
		if ok and type(n) == "number" then
			return n
		end
		return 0
	end
	local n = profile.Pets[key]
	if type(n) == "number" then
		return n
	end
	return 0
end

-- "uid=Body/Style/Tier/Rarity[/Seed[/Elements]];..." for the equipped hybrids (what other clients need to draw them).
-- gui-redo Task 3: field 6 = the record's Elements in their order joined by "+" (Elements[1] = the parent that gives the
-- normal attack), so other clients' stand-in defs lead with the same element; field 5 is "" when there is no Seed but
-- there are Elements (field 6 keeps its place). Only plain names are written; a record with none keeps today's value.
local function hybridLooks(profile)
	local parts, seen = {}, {}
	local hybrids = type(profile.Hybrids) == "table" and profile.Hybrids or {}
	for _, key in ipairs(profile.Equipped) do
		local parsed = parseKey(key)
		local uid = parsed and parsed.HybridId
		local rec = uid and hybrids[uid]
		if uid and not seen[uid] and type(rec) == "table" and type(rec.Body) == "string" and type(rec.Style) == "string" then
			seen[uid] = true
			local fields = { rec.Body, rec.Style, parsed.Tier, type(rec.Rarity) == "string" and rec.Rarity or "" }
			if type(rec.Seed) == "number" and rec.Seed == rec.Seed then
				fields[5] = tostring(math.floor(rec.Seed))
			end
			local elements = {}
			for _, e in ipairs(type(rec.Elements) == "table" and rec.Elements or {}) do
				if type(e) == "string" and string.find(e, "^[%w_]+$") then
					elements[#elements + 1] = e
				end
			end
			if #elements > 0 then
				fields[5] = fields[5] or ""
				fields[6] = table.concat(elements, "+")
			end
			local text = uid .. "=" .. table.concat(fields, "/")
			if not string.find(text, "[,;]") then
				parts[#parts + 1] = text
			end
		end
	end
	return table.concat(parts, ";")
end

local function copyPerks(perks)
	return {
		MaxHealth = perks.MaxHealth or 0,
		TokenBonus = perks.TokenBonus or 0,
		StaminaRegen = perks.StaminaRegen or 0,
		CheckpointHeal = perks.CheckpointHeal or 0,
	}
end

----------------------------------------------------------------------
-- Perks + attributes
----------------------------------------------------------------------

-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.7, 4.1): the training lock. DataService.TrainingKeys is the
-- ONE source: { [key] = true } of the keys with a running training job ({} before the load / while provisional).
local function trainingKeys(player)
	if type(DataService.TrainingKeys) ~= "function" then
		return {}
	end
	local ok, set = pcall(DataService.TrainingKeys, player)
	if ok and type(set) == "table" then
		return set
	end
	return {}
end

-- "2:10" of training left for a key (its Job.Ends is a server os.time() stamp), or nil
local function trainingLeft(player, key)
	if type(DataService.GetGrowth) ~= "function" then
		return nil
	end
	local ok, growth = pcall(DataService.GetGrowth, player, key)
	local job = ok and type(growth) == "table" and growth.Job or nil
	local ends = type(job) == "table" and tonumber(job.Ends) or nil
	if not ends or ends ~= ends then
		return nil
	end
	local s = math.max(0, math.ceil(ends - os.time()))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

-- Bug batch 2 #18: { [key] = copies working in the Garden / Gym } (DataService.PlacedCopies; {} before the load,
-- while provisional or without that API)
local function placedCopies(player)
	if type(DataService.PlacedCopies) ~= "function" then
		return {}
	end
	local ok, map = pcall(DataService.PlacedCopies, player)
	if ok and type(map) == "table" then
		return map
	end
	return {}
end

local function petLevelOf(player, key)
	if type(DataService.GetPetLevel) ~= "function" then
		return 1
	end
	local ok, level = pcall(DataService.GetPetLevel, player, key)
	if ok and type(level) == "number" and level == level and level >= 1 then
		return math.floor(level)
	end
	return 1
end

local function evolutionOf(player, key)
	if type(DataService.GetEvolution) ~= "function" then
		return 0
	end
	local ok, stage = pcall(DataService.GetEvolution, player, key)
	if ok and type(stage) == "number" and stage == stage and stage >= 0 then
		return math.floor(stage)
	end
	return 0
end

-- "23:1,5:0": level:stage per EquippedPets entry (Phase 4 contract 5.3; other clients draw the pet cards and the evolved
-- models from it, since PetLevels / PetGrowth only sync to the owner)
local function equippedInfo(player, profile)
	local parts = {}
	for i, key in ipairs(profile.Equipped) do
		parts[i] = tostring(petLevelOf(player, key)) .. ":" .. tostring(evolutionOf(player, key))
	end
	return table.concat(parts, ",")
end

-- Writes EquippedInfo when it changed, at most every INFO_GAP seconds per player (a burst of level-ups coalesces into
-- one deferred write that carries the final value). Written BEFORE EquippedPets when it is due, so a client that sees
-- a new list already has its levels.
local function publishInfo(player, profile)
	local attr = Config.Attr.EquippedInfo
	if type(attr) ~= "string" then
		return
	end
	local text = equippedInfo(player, profile)
	if player:GetAttribute(attr) == text then
		return
	end
	local now = os.clock()
	local state = infoState[player]
	if not state then
		state = { At = -math.huge, Pending = false }
		infoState[player] = state
	end
	if now - state.At >= INFO_GAP then
		state.At = now
		player:SetAttribute(attr, text)
		return
	end
	if state.Pending then
		return
	end
	state.Pending = true
	task.delay(INFO_GAP - (now - state.At), function()
		local s = infoState[player]
		if s then
			s.Pending = false
		end
		if not isLivePlayer(player) then
			return
		end
		local latest = DataService.GetProfile(player)
		if type(latest) ~= "table" or type(latest.Equipped) ~= "table" then
			return
		end
		local value = equippedInfo(player, latest)
		if player:GetAttribute(attr) ~= value then
			if s then
				s.At = os.clock()
			end
			player:SetAttribute(attr, value)
		end
	end)
end

-- Recomputes perks from the profile and publishes the attributes. `silent` skips PerksChanged.
local function refreshPlayer(player, silent)
	if not isLivePlayer(player) then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local perks = copyPerks(DataService.ComputePerks(profile.Equipped, profile))
	perkState[player] = { Perks = perks }
	-- the hybrid looks first: a client that sees the new EquippedPets can already draw every hybrid in it
	local looks = hybridLooks(profile)
	local currentLooks = player:GetAttribute(HYBRID_ATTR)
	if looks ~= "" or (currentLooks ~= nil and currentLooks ~= "") then
		if currentLooks ~= looks then
			player:SetAttribute(HYBRID_ATTR, looks)
		end
	end
	publishInfo(player, profile)
	player:SetAttribute(Config.Attr.EquippedPets, table.concat(profile.Equipped, ","))
	player:SetAttribute(Config.Attr.PerkStaminaRegen, perks.StaminaRegen)
	if not silent then
		PetService.PerksChanged:Fire(player)
	end
end

-- Pet Index: marks a pet as discovered. Returns true the first time. Safe when DataService predates v3.
local function markDiscovered(player, petId)
	if type(DataService.MarkDiscovered) ~= "function" then
		return false
	end
	local ok, isNew = pcall(DataService.MarkDiscovered, player, petId)
	if not ok then
		warn("[PetService] MarkDiscovered errored: " .. tostring(isNew))
		return false
	end
	return isNew == true
end

-- Every owned pet counts as discovered (DataService migrates stored profiles; this also covers pets
-- granted outside the roulette).
local function discoverOwned(player, profile)
	for petId, count in pairs(profile.Pets) do
		if type(count) == "number" and count > 0 then
			markDiscovered(player, petId)
		end
	end
	-- tier copies count for their base pet (the Index lists base pets)
	for petId, entry in pairs(type(profile.Tiers) == "table" and profile.Tiers or {}) do
		if type(entry) == "table" then
			markDiscovered(player, petId)
		end
	end
end

local function onProfileReady(player)
	if not isLivePlayer(player) then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	DataService.SyncEquipped(player)
	discoverOwned(player, profile) -- the ProfileSync snapshot already lists owned pets, so no extra Sync
	refreshPlayer(player, false)
end

local RECOVERING = "Your save is still being recovered, try again in a moment" -- a stand-in profile has no teams (activeTeam)

-- { key... } of the active team's slots and the preset number, or nil until loaded / while provisional
local function activeTeam(player)
	local teams = DataService.GetTeams(player)
	if type(teams) ~= "table" then
		return nil
	end
	return teams.Presets[teams.Active], teams.Active
end

local function teamHas(list, key)
	for i, k in ipairs(list) do
		if k == key then
			return i
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Public API: perks
----------------------------------------------------------------------

function PetService.GetEquipped(player)
	local profile = player and DataService.GetProfile(player)
	local out = {}
	if profile then
		for i, id in ipairs(profile.Equipped) do
			out[i] = id
		end
	end
	return out
end

function PetService.GetPerks(player)
	local state = player and perkState[player]
	if state then
		return copyPerks(state.Perks)
	end
	return copyPerks(ZERO_PERKS)
end

function PetService.GetTokenMultiplier(player)
	local state = player and perkState[player]
	local bonus = state and state.Perks.TokenBonus or 0
	if type(bonus) ~= "number" or bonus ~= bonus or bonus < 0 then
		bonus = 0
	end
	return 1 + bonus
end

----------------------------------------------------------------------
-- Public API: equip / unequip
----------------------------------------------------------------------

-- Equip's checks (ok, reason); `freed` (bug batch 2 #18) = Garden copies about to be taken out (the recall).
function PetService.CanEquip(player, key, freed)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if inMatch(player) then
		return false, "Pets are locked during a match"
	end
	if not validId(key) or not parseKey(key) then
		return false, "Unknown pet"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	if not defOf(key, profile) then
		return false, "Unknown pet"
	end
	local owned = ownedCount(profile, key)
	if owned <= 0 then
		return false, "You do not own that pet"
	end
	if trainingKeys(player)[key] then
		-- Phase 4: a training pet rests at home until its job is done (the lock: DataService.TrainingKeys)
		local def = defOf(key, profile)
		local name = type(def) == "table" and (def.DisplayName or def.Name) or key
		local left = trainingLeft(player, key)
		return false, tostring(name) .. " is training" .. (left and (" (" .. left .. " left)") or "")
	end
	local team = activeTeam(player)
	if not team then
		return false, RECOVERING
	end
	-- bug batch 2 #18: a pet with every copy in the Garden is busy gardening (the recall frees `freed` copies first)
	local rawPlaced = placedCopies(player)[key] or 0
	local placed = math.max(0, rawPlaced - (type(freed) == "number" and math.max(0, math.floor(freed)) or 0))
	if owned - placed < 1 then
		local def = defOf(key, profile)
		local name = type(def) == "table" and (def.DisplayName or def.Name) or key
		return false, tostring(name) .. " is gardening! Take it out of the garden first"
	end
	if teamHas(team, key) then
		if owned - rawPlaced < 1 then
			return true -- the recall: it keeps its slot and is back with the player once the Garden lets it go
		end
		return false, "That pet is already in your team"
	end
	if #team >= Config.Pets.MaxEquipped then
		return false, "Your team is full (" .. Config.Pets.MaxEquipped .. " pets)"
	end
	return true
end

-- Puts the key in the active team's first empty slot.
function PetService.Equip(player, key)
	local ok, reason = PetService.CanEquip(player, key, 0)
	if not ok then
		return false, reason
	end
	local team, preset = activeTeam(player)
	local list = {}
	for i, k in ipairs(team) do
		list[i] = k
	end
	list[#list + 1] = key
	return DataService.SetTeam(player, preset, list)
end

-- Takes `key` out of the active team (its slot empties, the pets behind it move up). A plain petId also matches a tier
-- copy of that pet when the Normal key is not in the team (old callers only know pet ids).
function PetService.Unequip(player, key)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if inMatch(player) then
		return false, "Pets are locked during a match"
	end
	if not validId(key) then
		return false, "Unknown pet"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	local team, preset = activeTeam(player)
	if not team then
		return false, RECOVERING
	end
	local slot = teamHas(team, key)
	local parsed = parseKey(key)
	if not slot and parsed and parsed.PetId and parsed.Tier == "Normal" then
		for i = #team, 1, -1 do
			local other = parseKey(team[i])
			if other and other.PetId == parsed.PetId then
				slot = i
				break
			end
		end
	end
	if not slot then
		return false, "That pet is not in your team"
	end
	local list = {}
	for i, k in ipairs(team) do
		list[i] = (i ~= slot) and k or false -- a hole: the pets behind it keep their index (a busy pet stays no new pick)
	end
	return DataService.SetTeam(player, preset, list)
end

-- Extra: brings the followers back to the active team minus busy pets (FusionService / DevService call it after removing
-- copies; PetCareService after a level-up / evolution / training start or end), republishes the attributes (EquippedPets,
-- EquippedHybrids, EquippedInfo) and perks. Returns true when the list changed.
function PetService.Refresh(player)
	if not isLivePlayer(player) then
		return false
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	local changed = DataService.SyncEquipped(player)
	refreshPlayer(player, false)
	return changed
end

----------------------------------------------------------------------
-- Public API: roulette
----------------------------------------------------------------------

-- The Secret pity (lobby-shop spec 5.2) of a { Spins, Hit } record -> PityAt (Config.Gems.SecretRoulette.PityAt, 7),
-- Since = max(0, Spins - Hit), Left = clamp(PityAt - Since, 1, PityAt). The clamp matters: two servers adding spins after
-- the same hit can merge Since above PityAt - 1; a Since of 8 shows 1 (and forces the next spin), never "in -1".
local function pityNumbers(pity)
	local cfg = type(Config.Gems) == "table" and Config.Gems.SecretRoulette or nil
	local at = type(cfg) == "table" and tonumber(cfg.PityAt) or nil
	if not at or at ~= at or at < 1 or at > 1000 or at ~= math.floor(at) then
		at = 7
	end
	local since = math.max(0, pity.Spins - pity.Hit)
	return at, since, math.max(1, math.min(at, at - since))
end

-- The attribute SecretPityLeft (Config.Attr; spec 5.2): Left of the saved pity once this load's gem settle hold ended;
-- absent while loading, provisional or not settled (DataService.GemsSettled false: a recovery's ProfileRebased fires
-- before the hold ends, so DataService.Settled is what first sets it for a stand-in). Runs on ProfileLoaded,
-- ProfileRebased and Settled and after each Secret Roulette spin; written only when it changed.
local function refreshPityAttr(player)
	if not isLivePlayer(player) then
		return
	end
	local attr = Config.Attr.SecretPityLeft or "SecretPityLeft"
	local left = nil
	local settled = type(DataService.GemsSettled) == "function" and DataService.GemsSettled(player) == true
	local pity = settled and type(DataService.GetPity) == "function" and DataService.GetPity(player) or nil
	if type(pity) == "table" and type(pity.Spins) == "number" and type(pity.Hit) == "number" then
		local _, _, n = pityNumbers(pity)
		left = n
	end
	if player:GetAttribute(attr) ~= left then
		player:SetAttribute(attr, left)
	end
end

-- Cosmetic strip: STRIP_LENGTH pet ids drawn like real rolls (so it shows realistic rarities), with the real result at
-- WIN_INDEX. `roll` = the roulette's roll (PetCatalog.RollPet when nil), always the plain call roll(id, RNG.Strip):
-- never RNG.Roll and never forced, so a strip says nothing about the roll generator and a forced pull's strip shows the
-- normal odds.
local function buildStrip(rouletteId, resultId, roll)
	RNG.Strip = RNG.Strip or Util.NewRng()
	local strip = {}
	for i = 1, STRIP_LENGTH do
		local id = nil
		local ok, rolled = pcall(roll or PetCatalog.RollPet, rouletteId, RNG.Strip)
		if ok and type(rolled) == "string" then
			id = rolled
		end
		strip[i] = id or resultId
	end
	strip[WIN_INDEX] = resultId
	return strip
end

-- The announcement of one request (see the header, spec 5.5): its best Legendary-or-better pull named, the others
-- counted. Everybody else sees the line at once; the puller after the reveal so it does not spoil the result. A request
-- inside the player's ANNOUNCE_GAP joins the held line, sent once when the gap ends. Runs after the money step.
local function announcePulls(player, pulls)
	local best, bestOrder, count = nil, 0, 0
	for _, pull in ipairs(pulls) do
		local def = PetCatalog.Get(pull.PetId)
		local order = def and rarityOrder[def.Rarity] or 0
		if order >= ANNOUNCE_ORDER then
			count = count + 1
			if order > bestOrder then -- strictly higher: ties keep the first
				best, bestOrder = def, order
			end
		end
	end
	if not best then
		return
	end
	local state = announceHold[player]
	if not state then
		state = {}
		announceHold[player] = state
	end
	local held = state.Held
	if held then
		if bestOrder > held.Order then -- the held pull came first: it keeps a tie
			held.Def, held.Order = best, bestOrder
		end
		held.More = held.More + count
		return
	end
	local function send(def, more)
		state.At = os.clock()
		local text = player.DisplayName .. " hatched a " .. def.Rarity .. " " .. def.Name .. "!"
		if more > 0 then
			text = text .. " (+" .. more .. " more)"
		end
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= player then
				notify(other, text, "pull", 4)
			end
		end
		task.delay(ANNOUNCE_DELAY, function()
			if player.Parent then
				notify(player, text, "pull", 4)
			end
		end)
	end
	local gapLeft = state.At and state.At + ANNOUNCE_GAP - os.clock() or 0
	if gapLeft <= 0 then
		send(best, count - 1)
		return
	end
	state.Held = { Def = best, Order = bestOrder, More = count - 1 }
	task.delay(gapLeft, function()
		local line = state.Held
		state.Held = nil
		if line and announceHold[player] == state and isLivePlayer(player) then -- dropped when he left meanwhile
			send(line.Def, line.More)
		end
	end)
end

-- Copies of a pet in any form (Normal + tier copies): IsNew keeps meaning "first time owned".
local function ownedAnyForm(profile, petId)
	local n = profile.Pets[petId] or 0
	local entry = type(profile.Tiers) == "table" and profile.Tiers[petId]
	if type(entry) == "table" then
		for _, count in pairs(entry) do
			if type(count) == "number" and count > 0 then
				n = n + count
			end
		end
	end
	return n
end

-- The plan part of a pet grant (reads only, nothing written; the roll's step 3 and PetService.GrantPet): n Normal
-- copies of petId on top of `before` copies of it this request planned already (`earlier` = every copy it planned).
-- -> { PetId, Key, Granted, Count, IsNew, NewDiscovery, FirstPet }
local function planCopies(profile, petId, n, before, earlier)
	before, earlier = before or 0, earlier or 0
	local discovered = type(profile.Discovered) == "table" and profile.Discovered[petId] == true
	return {
		PetId = petId,
		Key = petId, -- the copy's key (a grant always adds Normal copies)
		Granted = n,
		Count = (profile.Pets[petId] or 0) + before + n,
		IsNew = ownedAnyForm(profile, petId) + before == 0, -- "first time owned"
		NewDiscovery = not discovered and before == 0,
		FirstPet = totalPets(profile) + earlier == 0,
	}
end

-- The write part (plain writes, nothing here yields or refuses; the caller checked the stack room and did its own spin /
-- charge): the copies, the first pet ever into the active team's slot 1 (a provisional profile has no teams yet: into
-- its Equipped list, which becomes a team once the recovery migrates it; the team's SetTeam only when `withTeam`: the
-- roll runs it after its step), the Index discovery (before the caller's Sync, so the snapshot shows it), the level
-- raised to `level` when given (never lowered), MarkDirty. -> newDiscovery, level (or nil)
local function writeCopies(player, profile, plan, level, withTeam)
	local petId = plan.PetId
	profile.Pets[petId] = (profile.Pets[petId] or 0) + plan.Granted
	if plan.FirstPet then
		local team, preset = activeTeam(player)
		if not team then
			table.insert(profile.Equipped, petId)
		elseif withTeam and #team == 0 then
			DataService.SetTeam(player, preset, { petId })
		end
	end
	local newDiscovery = markDiscovered(player, petId)
	local levelNow = nil
	if type(level) == "number" and type(DataService.GetPetLevel) == "function" and type(DataService.SetPetLevel) == "function" then
		local current = DataService.GetPetLevel(player, petId) or 1
		levelNow = math.max(current, level)
		if levelNow > current then
			DataService.SetPetLevel(player, petId, levelNow)
		end
	end
	DataService.MarkDirty(player)
	return newDiscovery, levelNow
end

-- Step 2 of the money step (see the header): `spins` pulls from RNG.Roll in order, a full stack re-picked inside its
-- rarity or turned into a Substitute, the AllowSecret guard; the Secret pity's forced pull (ctx.Pity.Forced, pull 1:
-- roll(id, RNG.Roll, { ForceRarity = "Secret" }), which must come back a Secret like any roll must come back a pet).
-- ctx = { Id, Roll, AllowSecret, Pity }.
-- -> { { PetId, Rarity, Pity = true | nil, Substitute = { Tokens } | nil }... } | nil, reason (nothing written either way)
local function rollPulls(profile, ctx, spins)
	RNG.Roll = RNG.Roll or Util.NewRng()
	local pulls, taken = {}, {}
	local function isFull(petId)
		return (profile.Pets[petId] or 0) + (taken[petId] or 0) >= Config.Pets.MaxPerStack
	end
	for j = 1, spins do
		local forced = j == 1 and type(ctx.Pity) == "table" and ctx.Pity.Forced == true
		local ok, petId
		if forced then
			ok, petId = pcall(ctx.Roll, ctx.Id, RNG.Roll, { ForceRarity = SECRET_RARITY })
		else
			ok, petId = pcall(ctx.Roll, ctx.Id, RNG.Roll)
		end
		local def = ok and type(petId) == "string" and PetCatalog.Get(petId) or nil
		if not def or (forced and def.Rarity ~= SECRET_RARITY) then
			return nil, "The roulette jammed, try again"
		end
		if def.Rarity == SECRET_RARITY and ctx.AllowSecret ~= true then
			-- Secret pets only come from a roulette with AllowSecret: never from any other one, whatever it rolled
			return nil, "The roulette jammed, try again"
		end
		local pull = { PetId = petId, Rarity = def.Rarity, Pity = forced or nil }
		if isFull(petId) then
			local open = {}
			for _, other in ipairs(PetCatalog.RarityPool(ctx.Id, def.Rarity)) do
				if not isFull(other.Id) then
					open[#open + 1] = other.Id
				end
			end
			if #open > 0 then
				local k = tonumber(RNG.Roll:Int(1, #open)) or 1
				pull.PetId = open[math.max(1, math.min(#open, math.floor(k)))]
			else
				pull.Substitute = { Tokens = PetService.SubstituteTokens(ctx.Id, def.Rarity) }
			end
		end
		if not pull.Substitute then
			taken[pull.PetId] = (taken[pull.PetId] or 0) + 1
		end
		pulls[j] = pull
	end
	return pulls
end

-- Step 3 (the caller runs it in a pcall; nothing written): each pull's grant plan, PoolSize and strip, the Secret pity's
-- new numbers (ctx.NewPity = { Spins, Hit }: Spins + 1 per pull, Hit = that Spins after a Secret pull, a substitute
-- included; reply.SecretPity = { Left }) and the reply (header). ctx = { Id, Currency, UnitPrice, Price, Roll, Pity }.
-- -> reply, plans ([j] = planCopies' plan; nil for a substitute)
local function planSpin(profile, ctx, pulls)
	if faults.plan then
		faults.plan()
	end
	local plans, out, before, earlier = {}, {}, {}, 0
	for j, pull in ipairs(pulls) do
		local petId = pull.PetId
		local item = {
			PetId = petId,
			Key = petId,
			Rarity = pull.Rarity,
			PoolSize = #PetCatalog.RarityPool(ctx.Id, pull.Rarity),
			Strip = buildStrip(ctx.Id, petId, ctx.Roll),
			Pity = pull.Pity,
			Substitute = pull.Substitute,
		}
		if pull.Substitute then
			-- the stack is full: nothing is granted, the reveal shows the full stack
			item.IsNew, item.NewDiscovery = false, false
			item.Count = (profile.Pets[petId] or 0) + (before[petId] or 0)
		else
			local plan = planCopies(profile, petId, 1, before[petId], earlier)
			item.IsNew, item.NewDiscovery, item.Count = plan.IsNew, plan.NewDiscovery, plan.Count
			plans[j] = plan
			before[petId] = (before[petId] or 0) + 1
			earlier = earlier + 1
		end
		out[j] = item
	end
	local first = out[1]
	local reply = {
		Ok = true,
		RouletteId = ctx.Id,
		Currency = ctx.Currency,
		Spins = #out,
		UnitPrice = ctx.UnitPrice,
		Price = ctx.Price,
		Pulls = out,
		PetId = first.PetId,
		Key = first.Key,
		IsNew = first.IsNew,
		NewDiscovery = first.NewDiscovery,
		Count = first.Count,
		Strip = first.Strip,
	}
	if type(ctx.Pity) == "table" then
		local spins, hit = ctx.Pity.Spins, ctx.Pity.Hit
		for _, item in ipairs(out) do
			spins = spins + 1
			if item.Rarity == SECRET_RARITY then
				hit = spins
			end
		end
		if spins > 1e9 then
			error("the Secret pity count is out of range") -- SetPity would refuse it after the charge: refuse it here
		end
		ctx.NewPity = { Spins = spins, Hit = hit }
		local _, _, left = pityNumbers(ctx.NewPity)
		reply.SecretPity = { Left = left }
	end
	return reply, plans
end

-- The optional currency of a spin: nil (the roulette's own), "Tokens" or "Gems" (any case; also { Currency = ... }).
-- Returns "Tokens" | "Gems" | nil, or false for anything else.
local function parseCurrency(currency)
	if currency == nil then
		return nil
	end
	if type(currency) == "table" then
		currency = rawget(currency, "Currency")
		if currency == nil then
			return nil
		end
	end
	if type(currency) ~= "string" or #currency > MAX_CURRENCY_LENGTH then
		return false
	end
	local lower = string.lower(currency)
	if lower == "gems" or lower == "gem" then
		return "Gems"
	elseif lower == "tokens" or lower == "token" or lower == "cloudtokens" then
		return "Tokens"
	end
	return false
end

-- shop-area (spec 16.17.3): the Secret roll's place rule. True when the player's own HumanoidRootPart stands at the Storm
-- Altar (Config.AtAltar with Config.Gems.SecretRoulette.AltarRangeSlack); no character, no root, no altar attribute or an
-- error: false.
local ALTAR_REASON = "Secret rolls happen at the Storm Altar"
local function atAltar(player)
	local ok, at = pcall(function()
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if not root or not root:IsA("BasePart") or type(Config.AtAltar) ~= "function" then
			return false
		end
		local def = type(Config.Gems) == "table" and Config.Gems.SecretRoulette or nil
		return Config.AtAltar(root.Position, type(def) == "table" and def.AltarRangeSlack or nil) == true
	end)
	return ok and at == true
end

-- A gems-only roulette (the Secret roulette at the Storm Altar) by id, or nil. GemService knows them.
local function gemsOnlyRoulette(rouletteId)
	local gems = getGemService()
	if not gems or type(gems.GetRoulette) ~= "function" then
		return nil
	end
	local ok, def = pcall(gems.GetRoulette, rouletteId)
	if ok and type(def) == "table" and def.GemsOnly == true then
		return def
	end
	return nil
end

-- The gem part of step 1: the settle hold (spec 5.2: a gem-priced spin waits for DataService.GemsSettled; fails closed
-- when the call errors, skipped without that API), then GemService.Quote (gem price, PolicyService check, the
-- roulette's roll; its texts, the lock unchanged). Fills ctx.UnitPrice / Roll / AllowSecret. -> ok, reason
local function gemQuote(player, ctx)
	if type(DataService.GemsSettled) == "function" then
		local okSettle, settled = pcall(DataService.GemsSettled, player)
		if not okSettle or settled ~= true then
			return false, "Your data is still loading"
		end
	end
	local gems = getGemService()
	if not gems or type(gems.Quote) ~= "function" or type(DataService.SpendGems) ~= "function" or type(DataService.GetGems) ~= "function" then
		return false, "Gem roulettes are not available right now"
	end
	local okQuote, ok, quote = pcall(gems.Quote, player, ctx.Id)
	if not okQuote then
		warn("[PetService] GemService.Quote errored: " .. tostring(ok))
		return false, "Gem roulettes are not available right now"
	end
	if not ok then
		return false, type(quote) == "string" and quote or "Gem roulettes are not available right now"
	end
	local price = type(quote) == "table" and quote.Price or nil
	if type(price) ~= "number" or price ~= price or price < 1 or price ~= math.floor(price) or price > 1e9 then
		return false, "Gem roulettes are not available right now"
	end
	ctx.UnitPrice = price
	ctx.Roll = type(quote.Roll) == "function" and quote.Roll or ctx.Roll
	ctx.AllowSecret = quote.AllowSecret == true
	return true
end

-- The token part of step 1 (lobby-shop 16.12, the owner's pick A): GemService.TokenSpinLock, nil only for a
-- PolicyService-"Allowed" account. No GemService, a missing function, an error or an odd answer is unknown: refused with
-- the checking text (fails closed, like StoreService's token lock). -> nil | reason
-- Release step 1 (the owner's pick, 2026-11-23): the lock belongs to a Store that sells Tokens for Robux, so it applies
-- ONLY while the Store is on (StoreCatalog.Enabled(): Config.Store.Enabled == true; no StoreCatalog counts as off, its
-- own rule). While the Store is off nothing sells Tokens: GemService is not asked and a restricted account, an
-- unanswered one and a failing PolicyService all spin with Tokens exactly as on origin/main, which has no such lock.
-- (Gem-priced spins keep GemService.Quote's PolicyService lock in both states: main has that one too.)
local function tokenSpinLock(player)
	if not (StoreCatalog and type(StoreCatalog.Enabled) == "function" and StoreCatalog.Enabled() == true) then
		return nil
	end
	local checking = "Checking your account, try again in a moment"
	local gems = getGemService()
	if not gems or type(gems.TokenSpinLock) ~= "function" then
		return checking
	end
	local ok, reason = pcall(gems.TokenSpinLock, player)
	if not ok then
		warn("[PetService] GemService.TokenSpinLock errored: " .. tostring(reason))
		return checking
	end
	if reason == nil or type(reason) == "string" then
		return reason
	end
	return checking
end

-- The tokens a full-stack pull pays instead of its pet (lobby-shop review round 1, the payback rule): the rarity's
-- Config.Index.Rewards Tokens, at most floor(the roulette's token Price x Config.Eggs.SubstituteShare (0.5)) for a token
-- roulette, whichever currency paid, so a pull never pays back its own price and full stacks are never a token source (pets
-- cannot be sold and there is no pet cap). A gems-only roulette (the Secret Roulette) has no token price: the reward.
function PetService.SubstituteTokens(rouletteId, rarity)
	local rewards = type(Config.Index) == "table" and Config.Index.Rewards or nil
	local reward = type(rewards) == "table" and rewards[rarity] or nil
	local tokens = math.max(0, math.floor(type(reward) == "table" and tonumber(reward.Tokens) or 0))
	local roulette = type(rouletteId) == "string" and roulettes[rouletteId] or nil
	local price = roulette and tonumber(roulette.Price) or nil
	if price and price > 0 then
		local share = type(Config.Eggs) == "table" and tonumber(Config.Eggs.SubstituteShare) or nil
		if not share or share ~= share or share < 0 or share >= 1 then
			share = 0.5
		end
		tokens = math.min(tokens, math.floor(price * share))
	end
	return tokens
end

-- The money step (see the header). Never yields; nothing refuses after the roll.
function PetService.BuyRoulette(player, rouletteId, currency, spins)
	-- step 1: the checks
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(rouletteId) ~= "string" then
		return false, "Unknown roulette"
	end
	local roulette = roulettes[rouletteId]
	-- not a token roulette: a gems-only one (the Secret roulette) is paid in Gems even when no currency is named
	local gemsOnly = not roulette and gemsOnlyRoulette(rouletteId) or nil
	if not roulette and not gemsOnly then
		return false, "Unknown roulette"
	end
	local paidWith = parseCurrency(currency)
	if paidWith == false then
		return false, "Unknown currency"
	end
	if gemsOnly then
		if paidWith == "Tokens" then
			return false, tostring(gemsOnly.DisplayName or "That roulette") .. " takes Gems only"
		end
		paidWith = "Gems"
	end
	if spins == nil then
		spins = 1
	end
	if (spins ~= 1 and spins ~= 3) or (spins == 3 and gemsOnly) then
		return false, "Bad spins"
	end
	-- shop-area (spec 16.17.3): the Secret roll happens at the Storm Altar only. The server reads the player's own
	-- character (never a client flag): a HumanoidRootPart within Config.AtAltar's range + AltarRangeSlack, else refused
	-- before the pity read and any quote (nothing charged). No root, no altar attribute or junk: refused (fails closed).
	if gemsOnly and not atAltar(player) then
		return false, ALTAR_REASON
	end
	if inMatch(player) then
		return false, "The shop is closed during a match"
	end
	if not PetCatalog or type(PetCatalog.RollPet) ~= "function" or type(PetCatalog.Get) ~= "function" or type(PetCatalog.RarityPool) ~= "function" then
		return false, "Pets are unavailable right now"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	-- the Secret pity (spec 5.2) reads the saved record: the Secret Roulette is refused while provisional or when GetPity
	-- cannot answer (fails closed); a pull is forced once Since >= PityAt - 1. Token roulettes never touch it.
	local pity = nil
	local secretDef = type(Config.Gems) == "table" and Config.Gems.SecretRoulette or nil
	if gemsOnly and type(secretDef) == "table" and rouletteId == secretDef.Id then
		local okPity, read = pcall(function()
			if type(DataService.IsProvisional) == "function" and DataService.IsProvisional(player) == true then
				return nil
			end
			return DataService.GetPity(player)
		end)
		local s = okPity and type(read) == "table" and tonumber(read.Spins) or nil
		local h = okPity and type(read) == "table" and tonumber(read.Hit) or nil
		if not s or not h or s ~= math.floor(s) or h ~= math.floor(h) or h < 0 or h > s or s > 1e9 then
			return false, "Your data is still loading"
		end
		local at, since = pityNumbers({ Spins = s, Hit = h })
		pity = { Spins = s, Hit = h, Forced = since >= at - 1 }
	end
	local ctx = {
		Id = rouletteId,
		Currency = paidWith or "Tokens",
		Roll = PetCatalog.RollPet, -- read now: tests that replace RollPet still steer the pulls
		AllowSecret = roulette ~= nil and roulette.AllowSecret == true,
		UnitPrice = roulette and roulette.Price,
		Pity = pity, -- the Secret Roulette only: { Spins, Hit, Forced } read above
	}
	if ctx.Currency == "Gems" then
		local okQuote, reason = gemQuote(player, ctx)
		if not okQuote then
			return false, reason
		end
	else
		local lock = tokenSpinLock(player) -- 16.12: before the balance, so a restricted account is told why
		if lock then
			return false, lock
		end
	end
	ctx.Price = ctx.UnitPrice * spins -- computed once: the balance check and the charge use it
	local poor = ctx.Currency == "Gems" and "Not enough Gems" or "Not enough Cloud Tokens" -- (playtest 2026-11-28 C20: Theme.Currency.Tokens.Name)
	local balance = ctx.Currency == "Gems" and DataService.GetGems(player) or DataService.GetTokens(player)
	if balance < ctx.Price then
		return false, poor
	end

	-- step 2: the pulls (the only refusal after them: the AllowSecret guard, still before the charge)
	local pulls, why = rollPulls(profile, ctx, spins)
	if not pulls then
		return false, why
	end

	-- step 3: everything that can fail, before the charge
	local okPlan, reply, plans = pcall(planSpin, profile, ctx, pulls)
	if not okPlan or type(reply) ~= "table" then
		warn("[PetService] spin plan failed (nothing charged): " .. tostring(reply))
		return false, "The roulette jammed, try again"
	end

	-- step 4: one charge
	local charged
	if ctx.Currency == "Gems" then
		charged = DataService.SpendGems(player, ctx.Price)
	else
		charged = DataService.SpendTokens(player, ctx.Price)
	end
	if not charged then
		return false, poor
	end

	-- step 5: plain writes only
	local firstPet = nil
	for j, pull in ipairs(pulls) do
		if pull.Substitute then
			DataService.AddTokens(player, pull.Substitute.Tokens)
		else
			writeCopies(player, profile, plans[j], nil, false)
			if plans[j].FirstPet then
				firstPet = pull.PetId
			end
		end
	end
	profile.Stats.Spins = profile.Stats.Spins + spins
	if ctx.NewPity and not DataService.SetPity(player, ctx.NewPity.Spins, ctx.NewPity.Hit) then
		-- cannot happen: GetPity answered in step 1 and step 3 checked the numbers; logged, never undoes the grant
		warn("[PetService] SetPity refused the Secret pity numbers after the charge")
	end
	DataService.MarkDirty(player)

	-- step 6: after the step, each in its own pcall (a failure is logged and never undoes the grant)
	local after = {
		{ "refresh", function()
			reply.Tokens = DataService.GetTokens(player) -- the balances after the charge and the substitute tokens
			reply.Gems = type(DataService.GetGems) == "function" and DataService.GetGems(player) or nil
			if faults.after then
				faults.after()
			end
			refreshPlayer(player, false)
		end },
		{ "pity", function()
			if ctx.Pity then
				refreshPityAttr(player) -- the attribute follows the new count at once (the reply carries the same Left)
			end
		end },
		{ "team", function()
			-- the first pet ever joins the active team's slot 1 (a provisional profile got it in its Equipped list)
			local team, preset = activeTeam(player)
			if firstPet and team and #team == 0 then
				DataService.SetTeam(player, preset, { firstPet })
			end
		end },
		{ "sync", function()
			DataService.Sync(player)
		end },
		{ "reply", function()
			fireClient("RouletteResult", player, reply)
		end },
	}
	for _, pull in ipairs(pulls) do
		after[#after + 1] = { "rolled", function()
			PetService.Rolled:Fire(player, pull.PetId) -- a substitute pull fires with its rolled pet (tutorial, Index)
		end }
	end
	after[#after + 1] = { "announce", function()
		announcePulls(player, pulls) -- one line per request, Legendary and up (spec 5.5)
	end }
	for _, call in ipairs(after) do
		local ok, err = pcall(call[2])
		if not ok then
			warn("[PetService] after a spin (" .. call[1] .. "): " .. tostring(err))
		end
	end
	return true, reply
end

-- store (2026-11-04, spec 5.4): the one pet-grant path outside the roulette (see the header). Non-yielding; nothing
-- between the checks and the write yields. A full stack answers "Stack full" and writes nothing: the caller
-- substitutes (StoreService pays the rarity's Index Tokens, DailyService pays Days[7].Else).
function PetService.GrantPet(player, petId, opts)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	opts = type(opts) == "table" and opts or {}
	local def = (PetCatalog and type(PetCatalog.Get) == "function" and type(petId) == "string") and PetCatalog.Get(petId) or nil
	if not def then
		return false, "Unknown pet"
	end
	local count = opts.Count
	if count == nil then
		count = 1
	end
	if type(count) ~= "number" or count ~= count or count < 1 or count > 1e6 or count ~= math.floor(count) then
		return false, "Bad count"
	end
	local level = opts.Level
	if level ~= nil then
		local top = (type(PetCatalog.MaxPetLevel) == "function" and PetCatalog.MaxPetLevel()) or 100
		if type(level) ~= "number" or level ~= level or level < 1 or level ~= math.floor(level) then
			return false, "Bad level"
		end
		level = math.min(level, top)
	end
	local profile = DataService.GetProfile(player)
	if not profile or (type(DataService.IsProvisional) == "function" and DataService.IsProvisional(player) == true) then
		return false, "Your save is still loading"
	end
	local room = Config.Pets.MaxPerStack - (profile.Pets[petId] or 0)
	if room <= 0 then
		return false, "Stack full"
	end
	-- the roll's own two parts in a row (nothing yields), then the perks / attributes and the Sync
	local plan = planCopies(profile, petId, math.min(count, room))
	local newDiscovery, levelNow = writeCopies(player, profile, plan, level, true)
	refreshPlayer(player, false)
	DataService.Sync(player)
	return true, {
		PetId = petId,
		Key = petId,
		Granted = plan.Granted,
		Count = plan.Count,
		IsNew = plan.IsNew,
		NewDiscovery = newDiscovery,
		Level = levelNow,
	}
end

-- Studio and the mock only (RunService:IsStudio(); false elsewhere): seeded generators for tests (anything with
-- :Float(a, b) and :Int(a, b), e.g. Util.NewRng(seed)); nil keeps the current one.
function PetService._SetRngForTest(rollRng, stripRng)
	if not game:GetService("RunService"):IsStudio() then
		return false
	end
	if rollRng ~= nil then
		RNG.Roll = rollRng
	end
	if stripRng ~= nil then
		RNG.Strip = stripRng
	end
	return true
end

-- Studio and the mock only: fn() runs inside the money step's step 3 (stage "plan", before the charge) or inside its
-- step-6 refresh pcall (stage "after"); a nil fn clears that stage.
function PetService._SetFaultForTest(stage, fn)
	if not game:GetService("RunService"):IsStudio() or (stage ~= "plan" and stage ~= "after") then
		return false
	end
	faults[stage] = type(fn) == "function" and fn or nil
	return true
end

----------------------------------------------------------------------
-- Remotes (client -> server). Rate limited and type checked.
----------------------------------------------------------------------

local function connectRemotes()
	if remotesConnected then
		return
	end
	local okBuy, buyRemote = pcall(Remotes.Get, "BuyRoulette")
	local okEquip, equipRemote = pcall(Remotes.Get, "EquipPet")
	local okUnequip, unequipRemote = pcall(Remotes.Get, "UnequipPet")
	if not (okBuy and okEquip and okUnequip) then
		warn("[PetService] pet remotes are missing (did Remotes.Init run?)")
		return
	end
	remotesConnected = true

	-- BuyRoulette(rouletteId, currency|nil, spins|nil): currency "Tokens" / "Gems" (or nil: the roulette's own), spins
	-- nil / 1 / 3 (3 never on a gems-only roulette; anything else is dropped silently), see BuyRoulette
	buyRemote.OnServerEvent:Connect(function(player, rouletteId, currency, spins)
		if rateLimited(player, "BuyRoulette", REMOTE_COOLDOWN) then
			return
		end
		if type(rouletteId) ~= "string" or #rouletteId > MAX_ID_LENGTH then
			return
		end
		if spins ~= nil and spins ~= 1 and spins ~= 3 then
			return
		end
		if spins == 3 and gemsOnlyRoulette(rouletteId) then
			return
		end
		local ok, success, info = pcall(PetService.BuyRoulette, player, rouletteId, currency, spins)
		if not ok then
			warn("[PetService] BuyRoulette errored: " .. tostring(success))
			success, info = false, "Something went wrong, try again"
		end
		if not success then
			local answer = {
				Ok = false,
				Reason = tostring(info),
				RouletteId = rouletteId,
				Currency = (parseCurrency(currency) == "Gems" or gemsOnlyRoulette(rouletteId)) and "Gems" or "Tokens",
				Spins = spins or 1,
				Tokens = DataService.GetTokens(player),
			}
			if type(DataService.GetGems) == "function" then
				answer.Gems = DataService.GetGems(player)
			end
			fireClient("RouletteResult", player, answer)
		end
	end)

	local function handleEquip(remoteName, fn)
		return function(player, petId)
			if rateLimited(player, remoteName, REMOTE_COOLDOWN) then
				return
			end
			if type(petId) ~= "string" or #petId > MAX_ID_LENGTH then
				return
			end
			local ok, success, reason = pcall(fn, player, petId)
			if not ok then
				warn("[PetService] " .. remoteName .. " errored: " .. tostring(success))
				return
			end
			if not success and reason then
				notify(player, tostring(reason), "bad", 3)
			end
		end
	end
	equipRemote.OnServerEvent:Connect(handleEquip("EquipPet", PetService.Equip))
	unequipRemote.OnServerEvent:Connect(handleEquip("UnequipPet", PetService.Unequip))
end

----------------------------------------------------------------------
-- Roulette machines in the lobby: one ProximityPrompt each; the walk-up ShopPrompt on the egg row (lobby shop 16.3, 16.17.2)
----------------------------------------------------------------------

-- lobby-shop 16.13 review fix 2: a player opening the Shop's Eggs page (a machine or the Egg Guide; the server-side prompt is
-- the request, already live-player / InMatch / cooldown checked) whose paid-random-items answer is still unknown gets
-- PolicyService asked again (GemService.Recheck: its own 5 s gap), so the Locked buttons can open. Guarded, never yields.
local function recheckPolicy(player)
	local gems = getGemService()
	if gems and type(gems.Recheck) == "function" then
		local ok, err = pcall(gems.Recheck, player)
		if not ok then
			warn("[PetService] GemService.Recheck errored: " .. tostring(err))
		end
	end
end

local function buildPrompts(lobbyInfo)
	for _, prompt in ipairs(promptObjects) do
		if prompt.Parent then
			prompt:Destroy()
		end
	end
	promptObjects = {}

	local shop = type(lobbyInfo) == "table" and lobbyInfo.Shop
	local machines = type(shop) == "table" and shop.Roulettes
	if type(machines) ~= "table" then
		warn("[PetService] lobbyInfo.Shop.Roulettes missing: no roulette prompts created")
		return
	end

	for _, roulette in ipairs(Config.Roulettes) do
		local machine = machines[roulette.Id]
		local part = type(machine) == "table" and machine.PromptPart
		if part and typeof(part) == "Instance" then
			local old = part:FindFirstChild(PROMPT_NAME)
			if old then
				old:Destroy()
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = PROMPT_NAME
			prompt.ActionText = "Open"
			prompt.ObjectText = roulette.DisplayName
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			table.insert(promptObjects, prompt)

			local rouletteId = roulette.Id
			prompt.Triggered:Connect(function(player)
				if not isLivePlayer(player) then
					return
				end
				if player:GetAttribute(Config.Attr.InMatch) == true then
					return
				end
				if rateLimited(player, "Prompt_" .. rouletteId, PROMPT_COOLDOWN) then
					return
				end
				recheckPolicy(player)
				fireClient("OpenPanel", player, "Shop", { Tab = "Roulette", RouletteId = rouletteId })
			end)
		else
			warn("[PetService] no PromptPart for roulette " .. tostring(roulette.Id))
		end
	end

	-- lobby shop 16.3 (Task 23): the walk-up Shop prompt on the egg row (Shop.Counter.PromptPart). The server only asks
	-- the client to open a window: a live player, not in a match, rate-limited per player.
	local counter = type(shop.Counter) == "table" and shop.Counter.PromptPart or nil
	if not (counter and typeof(counter) == "Instance" and counter:IsA("BasePart")) then
		warn("[PetService] no Shop.Counter.PromptPart: no walk-up ShopPrompt (the machines' prompts still open the Shop)")
		return
	end
	local old = counter:FindFirstChild("ShopPrompt")
	if old then
		old:Destroy()
	end
	local shopPrompt = Instance.new("ProximityPrompt")
	shopPrompt.Name = "ShopPrompt"
	shopPrompt.ActionText = "Open"
	shopPrompt.ObjectText = "Shop"
	shopPrompt.HoldDuration = 0
	shopPrompt.MaxActivationDistance = 10
	shopPrompt.RequiresLineOfSight = false
	shopPrompt.Parent = counter
	table.insert(promptObjects, shopPrompt)
	shopPrompt.Triggered:Connect(function(player)
		if not isLivePlayer(player) or player:GetAttribute(Config.Attr.InMatch) == true then
			return
		end
		if rateLimited(player, "Prompt_Shop", PROMPT_COOLDOWN) then
			return
		end
		recheckPolicy(player)
		fireClient("OpenPanel", player, "Shop", { Tab = "Eggs" })
	end)
end

----------------------------------------------------------------------
-- Player lifecycle
----------------------------------------------------------------------

local function onPlayerAdded(player)
	if DataService.GetProfile(player) then
		task.spawn(onProfileReady, player)
	end
end

local function connectPlayers()
	if playersConnected then
		return
	end
	playersConnected = true

	DataService.ProfileLoaded:Connect(function(player)
		onProfileReady(player)
		pcall(refreshPityAttr, player)
	end)
	DataService.ProfileRebased:Connect(function(player)
		onProfileReady(player)
		pcall(refreshPityAttr, player) -- another server's Secret spins arrive here (a recovery: still not settled)
	end)
	if type(DataService.Settled) == "table" and type(DataService.Settled.Connect) == "function" then
		DataService.Settled:Connect(function(player)
			pcall(refreshPityAttr, player) -- the gem settle hold ended: the first SecretPityLeft of this load
		end)
	end
	DataService.TeamsChanged:Connect(function(player)
		refreshPlayer(player, false) -- the followers are the active team: every team change republishes them
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		perkState[player] = nil
		lastCall[player] = nil
		infoState[player] = nil
		announceHold[player] = nil -- a held announcement of his is dropped (its timer finds no state)
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function PetService.Init(lobbyInfo, deps)
	if type(deps) == "table" then
		if deps.DataService then
			DataService = deps.DataService
		end
	end
	if type(DataService.Init) == "function" then
		pcall(DataService.Init)
	end
	if not PetCatalog then
		warn("[PetService] PetCatalog is missing: roulettes and equipping are limited")
	end
	-- the money step's generators: engine seeded once (Random.new() without a seed), never sent
	RNG.Roll = RNG.Roll or Util.NewRng()
	RNG.Strip = RNG.Strip or Util.NewRng()
	connectRemotes()
	connectPlayers()
	buildPrompts(lobbyInfo)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1110">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- PlayerService: per-player lifecycle, spawn placement, humanoid setup, leaderstats, lobby rules.
--
-- * PlayerAdded: attributes, leaderstats, saved profile (via DataService). PlayerService is the only maker of
--   leaderstats and its values: Tokens (an IntValue), then Rank (a StringValue, "" until LeaderboardService writes the
--   player's title text; lobby shop spec 16.6), both made synchronously before the data load.
-- * CharacterAdded: perk-aware humanoid stats, placement, brief spawn i-frames.
--     placement order: spawn provider (match checkpoint) -> own spot (lobby respawns only)
--                      -> scattered plaza spawn (first spawn, or no spot).
-- * Perk-aware max health: Main hands us PetService.GetPerks via SetPerkProvider(fn) and calls
--   RefreshMaxHealth(player) whenever PetService.PerksChanged fires. A refresh keeps the health
--   FRACTION (a half-health player stays at half health with the new maximum).
-- * 0.5s lobby loop: players who fall off the lobby are sent back (no damage), the lobby keeps
--   everybody at full health, and max health self-heals if it ever drifts from the perks.
-- * PlayerRemoving: cleanup (DataService's own leave handler saves and decides when the profile cache entry is
--   released: never while the final save failed).
--
-- Public API (ARCHITECTURE.md + v2):
--   Init(lobbyInfo)  SetSpawnProvider(fn)  SetPerkProvider(fn)  SetHomeProvider(fn)
--   SendToLobby(player)  GetLobbySpawnCFrame()  ApplyHumanoidStats(player)
--   GetMaxHealth(player)  RefreshMaxHealth(player)
--   SpawnPlayer(player) -> bool   HasSpawned(player) -> bool          (Phase 5, 7.2)
--
-- Phase 5 spawn gate (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2, judge M7 / C17): the SERVER holds the
-- character until the main menu's PLAY. Init sets Players.CharacterAutoLoads = false for the server's life (Main's
-- boot gate never re-enables it once SpawnPlayer exists), so every character is loaded here:
--   * Config.MainMenu.Enabled = true: PlayerAdded only records the player as waiting; the remote MenuPlay (c->s, no
--     args, the first one per session counts, 1 per second) or a Config.MainMenu.FallbackSeconds (90) timer calls
--     SpawnPlayer. A client that never sends MenuPlay (old client, script error, exploit) still spawns after 90 s (Y13).
--   * Config.MainMenu.Enabled = false: the character spawns at once on PlayerAdded (the Phase 4 behaviour).
--   * After the first spawn, Humanoid.Died -> task.delay(Players.RespawnTime) -> a new character (Roblox's automatic
--     respawn is off); the lobby loop also respawns a spawned player whose character vanished without dying.
-- SpawnPlayer = one player:LoadCharacter(), idempotent: skipped when the player left or already has a live character.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local DamageService = require(script.Parent.DamageService)

local PlayerService = {}

local SCATTER_RADIUS = 8 -- studs; plaza spawns are spread so players don't stack
local LOBBY_TICK = 0.5 -- seconds between lobby safety checks
local SPAWN_IFRAMES = 1.5 -- seconds of protection after every (re)spawn
local SAFE_MARGIN = 15 -- studs above KillY a position must be to count as "last safe"

local lobbySpawn = CFrame.new(Config.Lobby.Origin + Vector3.new(0, 3, 0))
local spawnProvider = nil -- fn(player) -> CFrame|nil   (match checkpoint)
local perkProvider = nil -- fn(player) -> { MaxHealth = fraction, ... }|nil
local homeProvider = nil -- fn(player) -> CFrame|nil    (the owner's lobby spot)
local initialized = false
local running = false
local perkWarned = false
-- perPlayer[player] = { Conns = { RBXScriptConnection... }, Spawned = bool, LastSafe = Vector3|nil }
local perPlayer = {}
local rng = Random.new()
-- Phase 5 spawn gate state (7.2). Tests read it through PlayerService._St.
--   waiting[player] = true until the first spawn; timers[player] = the fallback thread; played[player] = the clock of the
--   accepted MenuPlay (only the first counts); lastPlay[player] = the clock of the last MenuPlay (1/s rate);
--   spawned[player] = true after the first SpawnPlayer; respawning[player] = true while a respawn is scheduled
local Spawn = { St = { waiting = {}, timers = {}, played = {}, lastPlay = {}, spawned = {}, respawning = {}, missing = {} } }
PlayerService._St = Spawn.St

----------------------------------------------------------------------
-- Placement helpers
----------------------------------------------------------------------

-- A plaza spawn CFrame nudged to a random spot near the spawn point.
local function scatteredLobbyCFrame()
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(rng:NextNumber(0, 1)) * SCATTER_RADIUS
	return lobbySpawn * CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- The owner's spot spawn, or nil when the player has none (or the provider is not wired).
local function homeCFrameFor(player)
	if not homeProvider then
		return nil
	end
	local ok, result = pcall(homeProvider, player)
	if ok and typeof(result) == "CFrame" then
		return result
	end
	if not ok then
		warn("[PlayerService] home provider failed: " .. tostring(result))
	end
	return nil
end

-- Teleport a character and kill any leftover momentum.
local function placeCharacter(char, cframe)
	if not char or not char.Parent then
		return
	end
	local ok, err = pcall(function()
		char:PivotTo(cframe)
	end)
	if not ok then
		warn("[PlayerService] PivotTo failed: " .. tostring(err))
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
end

-- Roblox's built-in "Health" script slowly regenerates health, which would heal players during a
-- match (and un-pin downed players). DamageService is the only authority, so remove it.
local function removeDefaultRegen(char)
	local regen = char:WaitForChild("Health", 3)
	if regen and regen:IsA("Script") then
		regen:Destroy()
	end
end

----------------------------------------------------------------------
-- Perks -> max health
----------------------------------------------------------------------

-- The perk table for a player, or nil (no provider / provider failed / not a table).
local function getPerks(player)
	if not perkProvider then
		return nil
	end
	local ok, perks = pcall(perkProvider, player)
	if ok then
		if type(perks) == "table" then
			return perks
		end
		return nil
	end
	if not perkWarned then
		perkWarned = true
		warn("[PlayerService] perk provider failed: " .. tostring(perks))
	end
	return nil
end

-- Config.Physics.MaxHealth * (1 + MaxHealth perk), rounded to a whole number and never below 1.
function PlayerService.GetMaxHealth(player)
	local bonus = 0
	local perks = getPerks(player)
	if perks then
		local value = perks.MaxHealth
		if type(value) == "number" and value == value then
			local cap = 1
			if Config.Pets and Config.Pets.PerkCaps and type(Config.Pets.PerkCaps.MaxHealth) == "number" then
				cap = Config.Pets.PerkCaps.MaxHealth
			end
			bonus = Util.Clamp(value, 0, cap)
		end
	end
	return math.max(1, math.floor(Config.Physics.MaxHealth * (1 + bonus) + 0.5))
end

-- Re-applies the perk-aware maximum to the live humanoid and KEEPS the health fraction.
-- A downed player keeps their pinned health (DamageService owns it).
function PlayerService.RefreshMaxHealth(player)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local newMax = PlayerService.GetMaxHealth(player)
	local oldMax = humanoid.MaxHealth
	if math.abs(oldMax - newMax) < 0.01 then
		return
	end
	local fraction = 1
	if oldMax > 0 then
		fraction = Util.Clamp(humanoid.Health / oldMax, 0, 1)
	end
	humanoid.MaxHealth = newMax
	if player:GetAttribute(Config.Attr.Downed) ~= true then
		humanoid.Health = math.max(Config.Damage.DownedHealth, math.min(newMax, newMax * fraction))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function PlayerService.GetLobbySpawnCFrame()
	return lobbySpawn
end

-- fn(player) -> CFrame|nil : the match checkpoint to (re)spawn at, nil => lobby.
function PlayerService.SetSpawnProvider(fn)
	if fn == nil or type(fn) == "function" then
		spawnProvider = fn
	else
		warn("[PlayerService] SetSpawnProvider expects a function or nil")
	end
end

-- fn(player) -> { MaxHealth = fraction, ... } (PetService.GetPerks). Applied to everyone right away.
function PlayerService.SetPerkProvider(fn)
	if fn == nil or type(fn) == "function" then
		perkProvider = fn
		perkWarned = false
	else
		warn("[PlayerService] SetPerkProvider expects a function or nil")
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerService.RefreshMaxHealth(player)
	end
end

-- fn(player) -> CFrame|nil : where a lobby RESPAWN goes (the owner's spot). The first spawn of a
-- session always uses the plaza.
function PlayerService.SetHomeProvider(fn)
	if fn == nil or type(fn) == "function" then
		homeProvider = fn
	else
		warn("[PlayerService] SetHomeProvider expects a function or nil")
	end
end

-- WalkSpeed / JumpPower / MaxHealth (perk-aware) / Health from Config. A downed player keeps
-- their frozen stats and their pinned health so a stray call can never "heal" them.
function PlayerService.ApplyHumanoidStats(player)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then
		return
	end
	humanoid.UseJumpPower = true
	humanoid.MaxHealth = PlayerService.GetMaxHealth(player)

	if player:GetAttribute(Config.Attr.Downed) == true then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	else
		humanoid.WalkSpeed = Config.Physics.WalkSpeed
		humanoid.JumpPower = Config.Physics.JumpPower
		humanoid.Health = humanoid.MaxHealth
	end

	-- Cosmetic: the custom HUD owns the health display, and auto-jump fights precise parkour.
	pcall(function()
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.AutoJumpEnabled = false
	end)
end

-- Clears InMatch/Downed, heals, and puts the player back on the lobby plaza.
function PlayerService.SendToLobby(player)
	if not player or not player.Parent then
		return
	end
	pcall(DamageService.ClearDowned, player)
	player:SetAttribute(Config.Attr.InMatch, false)
	player:SetAttribute(Config.Attr.Downed, false)

	local record = perPlayer[player]
	if record then
		record.LastSafe = nil
	end

	local char = player.Character
	local humanoid = Util.GetHumanoid(player)
	if char and humanoid and humanoid.Health > 0 then
		PlayerService.ApplyHumanoidStats(player)
		placeCharacter(char, scatteredLobbyCFrame())
	end
	-- If the character is dead or missing, the respawn flow places the new one in the lobby
	-- (InMatch is false now, so the spawn provider returns nil).
end

----------------------------------------------------------------------
-- Phase 5 spawn gate (7.2)
----------------------------------------------------------------------

function Spawn.menuEnabled()
	return type(Config.MainMenu) == "table" and Config.MainMenu.Enabled == true
end

function Spawn.hasLiveCharacter(player)
	local char = player.Character
	if not char or not char.Parent then
		return false
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	return humanoid == nil or humanoid.Health > 0
end

function Spawn.cancelFallback(player)
	local timer = Spawn.St.timers[player]
	Spawn.St.timers[player] = nil
	if timer and coroutine.running() ~= timer then
		pcall(task.cancel, timer)
	end
end

-- one LoadCharacter; true when a character was loaded
function Spawn.loadCharacter(player)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		warn("[PlayerService] LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- Loads the player's character once: skipped when the player left, is unknown here, or already has a live character.
function PlayerService.SpawnPlayer(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent or not perPlayer[player] then
		return false
	end
	Spawn.St.waiting[player] = nil
	Spawn.cancelFallback(player)
	if Spawn.hasLiveCharacter(player) then
		Spawn.St.spawned[player] = true
		return false
	end
	Spawn.St.spawned[player] = true
	return Spawn.loadCharacter(player)
end

-- True once the player's first spawn happened (MenuPlay, the fallback, or at once with the menu disabled).
function PlayerService.HasSpawned(player)
	return Spawn.St.spawned[player] == true
end

-- Roblox's automatic respawn is off (CharacterAutoLoads = false): a dead character comes back after RespawnTime.
function Spawn.scheduleRespawn(player, char)
	if Spawn.St.respawning[player] then
		return
	end
	Spawn.St.respawning[player] = true
	local delaySeconds = 5
	pcall(function()
		delaySeconds = Players.RespawnTime
	end)
	task.delay(delaySeconds, function()
		Spawn.St.respawning[player] = nil
		if not player.Parent or not perPlayer[player] then
			return
		end
		local current = player.Character
		if current ~= nil and current ~= char and Spawn.hasLiveCharacter(player) then
			return -- something else (a match) already gave the player a new character
		end
		Spawn.loadCharacter(player)
	end)
end

function Spawn.watchDeath(player, char, humanoid)
	humanoid.Died:Connect(function()
		if player.Character == char then
			Spawn.scheduleRespawn(player, char)
		end
	end)
end

-- MenuPlay (c->s, no args): only the first per session counts, at most one per second; junk arguments are ignored.
function Spawn.onMenuPlay(player)
	if typeof(player) ~= "Instance" or not perPlayer[player] then
		return
	end
	local now = os.clock()
	local last = Spawn.St.lastPlay[player]
	if last and now - last < 1 then
		return
	end
	Spawn.St.lastPlay[player] = now
	if Spawn.St.played[player] then
		return
	end
	Spawn.St.played[player] = now
	if Spawn.St.waiting[player] then
		PlayerService.SpawnPlayer(player)
	end
end

-- A new player: wait for PLAY (menu on, with the 90 s fallback) or spawn at once (menu off).
function Spawn.holdOrSpawn(player)
	if Spawn.St.spawned[player] or Spawn.St.waiting[player] then
		return
	end
	if not Spawn.menuEnabled() then
		PlayerService.SpawnPlayer(player)
		return
	end
	Spawn.St.waiting[player] = true
	local seconds = tonumber(Config.MainMenu.FallbackSeconds) or 90
	Spawn.St.timers[player] = task.delay(seconds, function()
		Spawn.St.timers[player] = nil
		if Spawn.St.waiting[player] and player.Parent then
			PlayerService.SpawnPlayer(player)
		end
	end)
end

-- Lobby loop safety net: a spawned player whose character vanished without dying (destroyed, not Died) gets a new one
-- after two quiet seconds.
function Spawn.checkMissing(player)
	if not Spawn.St.spawned[player] or Spawn.St.respawning[player] or Spawn.St.waiting[player] then
		Spawn.St.missing[player] = nil
		return
	end
	local char = player.Character
	if char and char.Parent then
		Spawn.St.missing[player] = nil
		return
	end
	local now = os.clock()
	local since = Spawn.St.missing[player]
	if not since then
		Spawn.St.missing[player] = now
	elseif now - since >= 2 then
		Spawn.St.missing[player] = nil
		Spawn.loadCharacter(player)
	end
end

----------------------------------------------------------------------
-- Character + player lifecycle
----------------------------------------------------------------------

local function onCharacterAdded(player, char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	-- The player may have left or respawned again while we waited.
	if not player.Parent or player.Character ~= char or not char.Parent then
		return
	end
	local record = perPlayer[player]

	PlayerService.ApplyHumanoidStats(player)

	-- 1. A match checkpoint, when the provider has one for this player.
	local target = nil
	if spawnProvider then
		local ok, result = pcall(spawnProvider, player)
		if ok then
			if typeof(result) == "CFrame" then
				target = result
			end
		else
			warn("[PlayerService] spawn provider failed: " .. tostring(result))
		end
	end
	-- 2. A lobby respawn goes home (the first spawn of a session always uses the plaza).
	if not target and record and record.Spawned and player:GetAttribute(Config.Attr.InMatch) ~= true then
		target = homeCFrameFor(player)
	end
	-- 3. The plaza.
	if not target then
		target = scatteredLobbyCFrame()
	end
	placeCharacter(char, target)
	if record then
		record.Spawned = true
		record.LastSafe = nil
	end

	DamageService.GrantInvulnerability(player, SPAWN_IFRAMES)
	Spawn.watchDeath(player, char, humanoid)
	task.spawn(removeDefaultRegen, char)
end

local function setupPlayer(player)
	if perPlayer[player] then
		return
	end
	local record = { Conns = {}, Spawned = false, LastSafe = nil }
	perPlayer[player] = record

	-- Attributes first so the HUD never reads nil.
	player:SetAttribute(Config.Attr.Tokens, 0)
	player:SetAttribute(Config.Attr.MatchTokens, 0)
	player:SetAttribute(Config.Attr.InMatch, false)
	player:SetAttribute(Config.Attr.Downed, false)

	-- leaderstats.Tokens mirrors the CloudTokens attribute (DataService also pushes into it).
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local tokensValue = stats:FindFirstChild("Tokens")
	if not tokensValue then
		tokensValue = Instance.new("IntValue")
		tokensValue.Name = "Tokens"
		tokensValue.Value = 0
		tokensValue.Parent = stats
	end
	-- leaderstats.Rank (lobby shop spec 16.6): the title as plain text ("" without one), right after Tokens so the player
	-- list still sorts by Tokens. Made here only; LeaderboardService writes its text.
	local titles = type(Config.Leaderboard) == "table" and Config.Leaderboard.RankTitles
	local rankName = type(titles) == "table" and type(titles.Column) == "string" and titles.Column or "Rank"
	if not stats:FindFirstChild(rankName) then
		local rankValue = Instance.new("StringValue")
		rankValue.Name = rankName
		rankValue.Value = ""
		rankValue.Parent = stats
	end

	table.insert(
		record.Conns,
		player:GetAttributeChangedSignal(Config.Attr.Tokens):Connect(function()
			local value = player:GetAttribute(Config.Attr.Tokens)
			if type(value) == "number" then
				tokensValue.Value = math.floor(value)
			end
		end)
	)

	-- Connect before the (yielding) data load so an early character is not missed.
	table.insert(
		record.Conns,
		player.CharacterAdded:Connect(function(char)
			onCharacterAdded(player, char)
		end)
	)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	-- Phase 5 (7.2): hold the character for the main menu, or spawn it now (menu disabled). Before the data load so a
	-- menu-less join gets its character at once, like the Phase 4 automatic spawn.
	Spawn.holdOrSpawn(player)

	-- Saved data. DataService.Load never errors; the pcall is belt and braces.
	pcall(DataService.Load, player)
	if not player.Parent then
		-- Left while loading: PlayerRemoving may already have run its save, so ask DataService to free
		-- the cache. Release is conditional (it keeps an entry that still holds unsaved progress).
		if type(DataService.Release) == "function" then
			pcall(DataService.Release, player)
		end
		return
	end
	-- Phase 5 (7.1): the loading screen waits for the player attribute ProfileLoaded (loaded or provisional). The contract
	-- has DataService write it; until it does, the end of Load (it never errors, provisional included) is the moment.
	local profileAttr = (Config.Attr and Config.Attr.ProfileLoaded) or "ProfileLoaded"
	if player:GetAttribute(profileAttr) ~= true then
		player:SetAttribute(profileAttr, true)
	end
	local okTokens, tokens = pcall(DataService.GetTokens, player)
	if okTokens and type(tokens) == "number" then
		player:SetAttribute(Config.Attr.Tokens, tokens)
		tokensValue.Value = math.floor(tokens)
	end
	-- Pet perks may be known by now; if PetService is slower it fires PerksChanged later.
	PlayerService.RefreshMaxHealth(player)
end

local function onPlayerRemoving(player)
	local record = perPlayer[player]
	perPlayer[player] = nil
	Spawn.cancelFallback(player)
	for _, map in pairs(Spawn.St) do
		map[player] = nil
	end
	if record then
		for _, conn in ipairs(record.Conns) do
			conn:Disconnect()
		end
	end
	-- Saving and freeing the profile cache entry are DataService's: its own PlayerRemoving handler saves (a release
	-- write, deferred after every other handler) and releases. (Session lock, 2026-11-10: this handler no longer saves
	-- too, so a leave is ONE write instead of a possible second one inside Roblox's 6 s same-key window.)
end

----------------------------------------------------------------------
-- Lobby rules
----------------------------------------------------------------------

-- Where a player who fell off the village goes: their own spot when they fell closer to it than
-- to the plaza, otherwise the plaza.
local function recoverCFrame(player, record)
	if record and record.LastSafe then
		local home = homeCFrameFor(player)
		if home then
			local toHome = (record.LastSafe - home.Position).Magnitude
			local toPlaza = (record.LastSafe - lobbySpawn.Position).Magnitude
			if toHome < toPlaza then
				return home
			end
		end
	end
	return scatteredLobbyCFrame()
end

local function lobbyTick()
	for _, player in ipairs(Players:GetPlayers()) do
		if perPlayer[player] then
			Spawn.checkMissing(player)
		end
		if player:GetAttribute(Config.Attr.InMatch) ~= true then
			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 then
				local record = perPlayer[player]
				local y = root.Position.Y
				if y < Config.Lobby.KillY then
					-- Fell off the cloud village: back home / to the plaza, no damage.
					placeCharacter(char, recoverCFrame(player, record))
					if record then
						record.LastSafe = nil
					end
				elseif record and y > Config.Lobby.KillY + SAFE_MARGIN and humanoid.FloorMaterial ~= Enum.Material.Air then
					record.LastSafe = root.Position
				end

				-- Safety net: max health follows the perks even if a PerksChanged event was missed.
				if math.abs(humanoid.MaxHealth - PlayerService.GetMaxHealth(player)) >= 0.5 then
					PlayerService.RefreshMaxHealth(player)
				end
				-- The lobby is safe: keep everybody topped up.
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end
	end
end

local function lobbyLoop()
	while running do
		task.wait(LOBBY_TICK)
		if not running then
			break
		end
		local ok, err = pcall(lobbyTick)
		if not ok then
			warn("[PlayerService] lobby loop error: " .. tostring(err))
		end
	end
end

function PlayerService.Init(lobbyInfo)
	if initialized then
		return
	end
	initialized = true

	-- Phase 5 (7.2): the server spawns every character itself (SpawnPlayer) for the server's life
	pcall(function()
		Players.CharacterAutoLoads = false
	end)
	local okRemote, menuPlay = pcall(Remotes.Get, "MenuPlay")
	if okRemote and menuPlay then
		menuPlay.OnServerEvent:Connect(Spawn.onMenuPlay)
	else
		warn("[PlayerService] no MenuPlay remote: players spawn after the fallback timer")
	end

	if type(lobbyInfo) == "table" and typeof(lobbyInfo.SpawnCFrame) == "CFrame" then
		lobbySpawn = lobbyInfo.SpawnCFrame
	else
		warn("[PlayerService] no lobbyInfo.SpawnCFrame; using the default lobby origin")
	end

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	running = true
	task.spawn(lobbyLoop)
	game:BindToClose(function()
		running = false -- stop the lobby loop on shutdown
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1111">
          <Properties>
            <string name="Name">Podium</string>
            <string name="Source"><![CDATA[-- Podium (wave 6 "fight focus", docs/superpowers/specs/2026-10-29-fight-focus-wave6-design.md goal 3): in the Champion
-- Ring and PvP duels the trainer stands on the podium for the whole fight and cheers; the pet does the fighting. The
-- podium is the spot each mode already teleports the trainer to: the Ring pocket's SpawnPad (the run's Zone.Spawn) and the
-- duel side's ChallengePad (BattleService duelStand). The lock is by position, never by colour. Server-authoritative:
-- the character's HumanoidRootPart is ANCHORED at the stand CFrame (turning the camera still works) and the player
-- attribute Config.Attr.OnPodium = true tells the client to loop the cheer emote. Not used in dungeons or raids.
-- Plain Lua 5.1-compatible syntax only.
--
-- API
--   Podium.Init(deps)                 deps = { Notify = fn(player, text, kind, seconds) } (optional); CharacterAdded /
--                                     PlayerRemoving release a lock (a fresh character is never anchored)
--   Podium.Lock(player, standCFrame, key) -> bool   teleports the character onto the stand, anchors the root, sets
--                                     OnPodium; one toast per `key` (the battle / ring run id): TOAST
--   Podium.Release(player, key)       idempotent: unanchors the locked root, clears OnPodium, forgets the lock; with a
--                                     `key` only a lock taken with that key (a ring's next round keeps its own lock)
--   Podium.IsLocked(player) -> bool
--   Podium.Tick()                     (the battle heartbeat) a locked root > SNAP studs off its stand is put back; one
--                                     > LET_GO studs off (a game teleport) and a lock whose character died / respawned /
--                                     left are released
--   Podium.ReleaseAll()               (Shutdown) every lock released
--   Podium.TOAST                      "You're the trainer: cheer your pet on from the podium!"

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Podium = {}

Podium.TOAST = "You're the trainer: cheer your pet on from the podium!"
Podium.SNAP = 2 -- studs a locked root may drift (an exploit nudge, a physics push) before it is put back
Podium.LET_GO = 25 -- a root moved further than this was teleported by the game (an obby match, a return): the lock lets go
-- (the battle's presence check / leash then judges where the player went, exactly as before the podium)

local ATTR = (Config.Attr and Config.Attr.OnPodium) or "OnPodium"

local locks = {} -- [player] = { stand = CFrame, root = BasePart, char = Model, key = string }
local toasted = {} -- [player] = { [key] = true }
local deps = {}

-- root, humanoid, character of a living character (nil otherwise)
local function aliveRoot(player)
	local char = typeof(player) == "Instance" and player.Character
	if not char then
		return nil
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or humanoid.Health <= 0 then
		return nil
	end
	return root, humanoid, char
end

local function setAttr(player, value)
	pcall(function()
		player:SetAttribute(ATTR, value)
	end)
end

function Podium.Release(player, key)
	local lock = locks[player]
	if lock and key ~= nil and tostring(lock.key) ~= tostring(key) then
		return
	end
	locks[player] = nil
	if lock and lock.root then
		pcall(function()
			lock.root.Anchored = false
		end)
	end
	if typeof(player) == "Instance" then
		setAttr(player, nil)
	end
end

function Podium.Lock(player, standCFrame, key)
	if typeof(standCFrame) ~= "CFrame" then
		return false
	end
	local root, _, char = aliveRoot(player)
	if not root then
		return false
	end
	local old = locks[player]
	if old and old.root and old.root ~= root then
		pcall(function()
			old.root.Anchored = false
		end)
	end
	local ok = pcall(function()
		root.Anchored = false
		char:PivotTo(standCFrame)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
		root.Anchored = true
	end)
	if not ok then
		return false
	end
	locks[player] = { stand = standCFrame, root = root, char = char, key = tostring(key or "") }
	setAttr(player, true)
	key = tostring(key or "")
	local seen = toasted[player]
	if not seen then
		seen = {}
		toasted[player] = seen
	end
	if not seen[key] then
		seen[key] = true
		if type(deps.Notify) == "function" then
			pcall(deps.Notify, player, Podium.TOAST, "info", 4)
		end
	end
	return true
end

function Podium.IsLocked(player)
	return locks[player] ~= nil
end

function Podium.Tick()
	for player, lock in pairs(locks) do
		local root, _, char = aliveRoot(player)
		if not root or root ~= lock.root or char ~= lock.char or not player.Parent then
			-- died, respawned or left: let go (the new character is never anchored)
			Podium.Release(player)
		else
			local off = (root.Position - lock.stand.Position).Magnitude
			if off > Podium.LET_GO then
				Podium.Release(player)
			elseif off > Podium.SNAP or not root.Anchored then
				pcall(function()
					root.Anchored = false
					char:PivotTo(lock.stand)
					root.Anchored = true
				end)
			end
		end
	end
end

function Podium.ReleaseAll()
	local list = {}
	for player in pairs(locks) do
		list[#list + 1] = player
	end
	for _, player in ipairs(list) do
		Podium.Release(player)
	end
end

local function watch(player)
	player.CharacterAdded:Connect(function()
		if locks[player] then
			Podium.Release(player)
		end
	end)
end

function Podium.Init(d)
	deps = type(d) == "table" and d or {}
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		Podium.Release(player)
		toasted[player] = nil
	end)
end

return Podium
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1112">
          <Properties>
            <string name="Name">PortalService</string>
            <string name="Source"><![CDATA[-- PortalService (v3 polish, Phase 5 6.3): forms the party on the ONE Sky Obby portal pad (Portal_Obby in the Gate
-- Court), locks the members in until launch and shows the party on the gate's readable tag.
--
-- Standing inside the portal Zone (the "ready pad") puts a player in the party. The first player starts a
-- countdown; a full party shortens it. When it reaches zero the party is handed to MatchService.StartMatch(level,
-- players). MatchService is passed in through Init (no require) so the two services never form a circular
-- dependency. ONE party slot keyed "Obby" (lobbyInfo.Portals.Obby); its level (party.Diff, a Config.Difficulties
-- entry) is mutable:
--   * the level picker (ObbyController, W4) fires Remotes.ObbyPick(levelId) -> PortalService.PickLevel(player,
--     levelId): a string <= 16 chars, a Config difficulty, 4/s burst 4, a loaded profile and ObbyLevels.IsUnlocked on
--     the SERVER copy of Stats.BestTimes -> the player's ObbyLevel attribute; refused: "Beat Medium to unlock Hard";
--     junk is dropped silently. The LEADER's pick before launch also changes the party's level (the countdown gets
--     at least 8 more seconds, the members get "Level: Hard").
--   * the first player on the empty pad picks the level: their ObbyLevel attribute if still unlocked, else their
--     highest unlocked level; anyone may JOIN whatever the level (friends carry friends).
--   * the gate's prompt "ObbyPrompt" (Pick level / Sky Obby, attribute OpenPanel = "Obby") opens the picker.
--
-- Lock-in (asked for after the playtest): a party member is LOCKED on the pad for the whole countdown.
--   * Their character parts move to the collision group NC_PortalLocked. Every pad has five invisible walls
--     (four sides + a ceiling) in NC_PortalWall, which collides ONLY with NC_PortalLocked: everybody else walks
--     straight through, and raycasts / overlap queries (Default group) never see the walls. Walking, jumping
--     and dashing (velocity based) all stop at the walls.
--   * Server safety net: the 5 Hz zone poll puts a locked player who is outside the zone anyway (flung,
--     teleported) back on the pad, with a side toast that explains the Leave button.
--   * The only way out is the Leave button of the party panel (Remotes.LeaveParty, validated + rate-limited):
--     unlock, LEAVE_LOCKOUT, and a step off the pad. Launch, a cancelled countdown, death, a match and leaving
--     the game unlock as well.
--   * While a countdown runs the side walls show a soft ForceField shimmer in the portal colour.
-- Billboard (World text rule, ARCHITECTURE_V3.md): a PIXEL-sized BillboardGui above each gate replaces the
-- studs-sized card LobbyBuilder made: difficulty name + stars, "2/4 players" and a status pill ("Step in to
-- play" / "Starting in 12"). It floats ~27 studs up and shows within 55 studs (the gate card range,
-- WorldStyle.TagRange; 2026-11-13 owner: 55, was 45; first 120).
-- Countdown face (eye level, for friends standing next to the portal): a SurfaceGui in the gate's swirl,
-- facing the plaza, ~11 studs above the pad: "Starting in", a 3.2-stud numeral on a square stone badge and the head
-- count. Shown only while the pad has a party.
-- The server writes a text only when it changes (at most once per second per line) and mirrors the numbers as
-- attributes on the portal model (PartyCount, PartyMax, Countdown).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)
local PixelIcon = require(Shared.PixelIcon) -- (kit-b U7b) the difficulty stars on the gate cards
local WorldTag = require(Shared.WorldTag) -- (kit-b world signs, lane C) the stone card tier of the stand-in board and the face

local ObbyLevels = nil
do
	local inst = Shared:FindFirstChild("ObbyLevels")
	if inst then
		local ok, mod = pcall(require, inst)
		if ok and type(mod) == "table" then
			ObbyLevels = mod
		end
	end
end

local PortalService = {}

----------------------------------------------------------------------
-- Tunables local to this module
----------------------------------------------------------------------
local POLL = 0.2 -- zone poll period (5 Hz); also the safety-net reaction time
local STATE_INTERVAL = 1 -- PartyState refresh period
local LEAVE_LOCKOUT = 3 -- seconds a player cannot re-join after pressing Leave
local FAILED_LOCKOUT = 4 -- ... after a failed launch
local EJECT_DISTANCE = 12 -- studs the Leave button moves a player off the pad (outside the walls)
local ZONE_HYSTERESIS = 1.5 -- extra studs of tolerance for players already inside (no edge flicker)
local LEAVE_COOLDOWN = 0.5 -- LeaveParty rate limit per player
local PULL_TOAST_COOLDOWN = 5 -- seconds between two "press Leave" toasts after a safety-net pull
local PORTAL_ID = "Obby" -- the one portal (6.3)
local PICK_RATE, PICK_BURST = 4, 4 -- ObbyPick rate limit (per second, burst)
local PICK_EXTEND = 8 -- a leader's re-pick leaves the countdown at least this many seconds
local PICK_MAX_LEN = 16
local PROMPT_RANGE = 12

-- Lock-in walls. The inner faces sit ZONE_HYSTERESIS outside the zone, so a member's root always stays inside
-- the (hysteresis) zone and the safety net never fights the walls.
local LOCK_GROUP = "NC_PortalLocked"
local WALL_GROUP = "NC_PortalWall"
local WALL_THICKNESS = 2
local WALL_HEIGHT = 14 -- studs above the pad surface (a full jump tops out ~10 studs up)
local WALL_DEPTH = 2 -- studs the walls reach below the pad surface
local BARRIER_TRANSPARENCY = 0.55 -- side walls while a countdown runs (ForceField shimmer)
local PAD_ROOT_HEIGHT = 3.2 -- root height above the pad surface for a safety-net placement
local PAD_SPREAD = 2.5 -- members put back on the pad stand on a ring this wide

-- Billboard (pixels; World text rule: names >= 22 px, info lines >= 18 px, compact plate)
local BB = {
	Width = 380, -- transparent container; the plate inside is sized to its text
	Height = 150,
	MaxDistance = 55, -- studs: the gate card range (= WorldStyle.TagRange; 2026-11-13 owner: 55, was 45; first 120)
	Gap = 2.5, -- studs between the top of the gate and the bottom of the plate
	NameText = 32,
	InfoText = 21,
	StatusText = 25,
	PlateMinW = 190,
	-- (kit-b world signs, lane C) the stand-in board's stone card (NpcService's nameplate numbers): px inside the face, the
	-- status pill's wood edge, lip and side room
	PadX = 18,
	PadTop = 8,
	Gap = 3,
	PadBottom = 6,
	PillEdge = 2,
	PillLip = 4,
	PillPad = 14,
}

-- Countdown face (SurfaceGui, World text rule: 40-60 px per stud, titles >= 1 stud, info lines >= 0.6 stud).
-- Roblox caps TextSize at 100, so the numeral gets a UIScale: 100 px x 1.6 = 160 px = 3.2 studs at 50 px per stud.
local FACE = {
	Width = 8.4, -- studs; corners stay inside the gate ring's 6-stud hole
	Height = 7,
	Thickness = 0.2,
	PPS = 50,
	Lift = 11.2, -- studs above the pad surface when the gate has no SwirlCore
	WallGap = 0.3, -- studs in front of the back lock wall (no ForceField layer between the face and the plaza)
	SwirlGap = 0.6, -- studs in front of the swirl's centre plane
	Disc = 240, -- px: the round numeral badge (4.8 studs)
	TopY = 4, -- px: top of the "Starting in" ribbon (it overlaps the badge's rim)
	DiscY = 178, -- px: badge centre
	CountY = 312, -- px: centre of the head-count pill (it overlaps the badge's bottom)
	NumText = 100,
	NumScale = 1.6,
	TopText = 56, -- 1.12 studs
	CountText = 40, -- 0.8 stud
	-- (kit-b world signs, lane C) the badge is a square stone card (THE GATES board's 6 px wood edge, a 10 px lip in the
	-- portal's colour, gold while counting down); the ribbon and the head count are small square blocks (a 4 px wood edge)
	Edge = 6,
	Lip = 10,
	PillEdge = 4,
	PillLip = 6,
	PillPad = 32, -- side room each side (FredokaOne's capitals run wider than a quick measure: the world text audit's real widths)
}

local MAX_STARS = 5 -- a difficulty's rating: PixelIcon stars (kit-b U7b; they were the star glyphs)

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local matchService = nil
local initialized = false
local running = false

local parties = {} -- portal id -> party
local order = {} -- portal ids in lobby order
local playerParty = {} -- Player -> portal id
local lockedUntil = {} -- Player -> clock deadline for re-joining
local mustExit = {} -- Player -> true until they have been seen outside every zone
local starting = {} -- Player -> true while a launched match is being built
local fullNotified = {} -- Player -> portal id they were told is full
local locks = {} -- Player -> { PortalId, Groups = { [BasePart] = previous group }, Conns }
local lastLeave = {} -- Player -> clock of the last accepted LeaveParty
local lastPullToast = {} -- Player -> clock of the last safety-net toast
local pickBuckets = {} -- Player -> { tokens, last } (ObbyPick rate limit)
local dataService = nil -- required lazily (PortalService never needs it at load time)
local groupsReady = false

local remoteCache = {}

-- forward declaration (the lock's Died handler leaves the party)
local removeFromParty

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clock()
	return os.clock()
end

local function copyList(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

local function removeValue(list, value)
	for i = #list, 1, -1 do
		if list[i] == value then
			table.remove(list, i)
		end
	end
end

local function nameOf(player)
	local n = player.DisplayName
	if type(n) ~= "string" or n == "" then
		n = player.Name
	end
	return n
end

local function isPlayer(value)
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function getRemote(name)
	local cached = remoteCache[name]
	if cached then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		remoteCache[name] = remote
		return remote
	end
	return nil
end

local function fireClient(name, player, ...)
	if not player or player.Parent == nil then
		return
	end
	local remote = getRemote(name)
	if not remote then
		return
	end
	pcall(remote.FireClient, remote, player, ...)
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function isInMatch(player)
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return true
	end
	-- 5.3 / Y12: a player in a battle or a dungeon run cannot take a pad seat
	local inBattle = player:GetAttribute(Config.Attr.InBattle or "InBattle")
	if inBattle ~= nil and inBattle ~= false and inBattle ~= "" then
		return true
	end
	if matchService and type(matchService.GetMatchOf) == "function" then
		local ok, match = pcall(matchService.GetMatchOf, player)
		if ok and match then
			return true
		end
	end
	return false
end

-- Root part of a living, non-downed character, or nil.
local function getAliveRoot(player)
	if player:GetAttribute(Config.Attr.Downed) == true then
		return nil
	end
	local char = player.Character
	if not char or not char.Parent then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil
	end
	return root
end

local function zoneAlive(zone)
	return zone ~= nil and zone.Parent ~= nil
end

-- Is `position` inside `zone` (grown by `pad` studs sideways)? The zone reaches a little below its floor and
-- up to the ceiling of the lock walls, so a jump never counts as leaving.
local function inZone(zone, position, pad)
	local rel = zone.CFrame:PointToObjectSpace(position)
	local hs = zone.Size * 0.5
	return math.abs(rel.X) <= hs.X + pad
		and math.abs(rel.Z) <= hs.Z + pad
		and rel.Y >= -hs.Y - 2
		and rel.Y <= hs.Y + 8
end

-- Which portal zone (if any) contains `position`. Players already in `hintId` get a slightly
-- larger zone so standing on the edge does not flicker in and out of the party.
local function zoneAt(position, hintId)
	for _, id in ipairs(order) do
		local zone = parties[id].Info.Zone
		if zoneAlive(zone) then
			local pad = 0
			if hintId == id then
				pad = ZONE_HYSTERESIS
			end
			if inZone(zone, position, pad) then
				return id
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Obby levels (6.3): the server copy of BestTimes decides what a player may pick
----------------------------------------------------------------------
local function getDataService()
	if dataService == nil then
		dataService = false
		local inst = script.Parent:FindFirstChild("DataService")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				dataService = mod
			end
		end
	end
	return dataService or nil
end

-- The player's Stats.BestTimes from the server profile; nil while the profile is not loaded.
local function bestTimesOf(player)
	local ds = getDataService()
	if not ds or type(ds.GetProfile) ~= "function" then
		return nil
	end
	local ok, profile = pcall(ds.GetProfile, player)
	if not ok or type(profile) ~= "table" then
		return nil
	end
	local stats = profile.Stats
	if type(stats) == "table" and type(stats.BestTimes) == "table" then
		return stats.BestTimes
	end
	return {}
end

local function levelUnlocked(bestTimes, levelId)
	if ObbyLevels then
		return ObbyLevels.IsUnlocked(bestTimes, levelId) == true
	end
	local first = Config.Difficulties[1]
	return first ~= nil and first.Id == levelId
end

local function highestLevel(bestTimes)
	local index = ObbyLevels and ObbyLevels.HighestUnlocked(bestTimes) or 1
	return Config.Difficulties[index] or Config.Difficulties[1]
end

-- The level of a party the player starts on the empty pad: their pick (ObbyLevel) while it is still unlocked, else
-- their highest unlocked level.
local function levelForNewParty(player)
	local bestTimes = bestTimesOf(player) or {}
	local picked = player:GetAttribute(Config.Attr.ObbyLevel)
	if type(picked) == "string" and levelUnlocked(bestTimes, picked) then
		local d = Config.GetDifficulty(picked)
		if d then
			return d
		end
	end
	return highestLevel(bestTimes)
end

-- ObbyPick token bucket (PICK_RATE per second, PICK_BURST burst).
local function allowPick(player)
	local t = clock()
	local b = pickBuckets[player]
	if not b then
		b = { Tokens = PICK_BURST, Last = t }
		pickBuckets[player] = b
	end
	b.Tokens = math.min(PICK_BURST, b.Tokens + math.max(0, t - b.Last) * PICK_RATE)
	b.Last = t
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

----------------------------------------------------------------------
-- Collision groups + lock walls
----------------------------------------------------------------------
-- NC_PortalWall collides with NC_PortalLocked only. Groups registered by other code later keep the engine
-- default (collidable), so this runs again whenever a pad gets locked (cheap, idempotent).
local function setupCollisionGroups()
	for _, name in ipairs({ LOCK_GROUP, WALL_GROUP }) do
		local registered = false
		pcall(function()
			registered = PhysicsService:IsCollisionGroupRegistered(name)
		end)
		if not registered then
			local ok, err = pcall(function()
				PhysicsService:RegisterCollisionGroup(name)
			end)
			if not ok and not groupsReady then
				warn("[PortalService] could not register collision group " .. name .. ": " .. tostring(err))
			end
		end
	end
	local names = { "Default" }
	pcall(function()
		for _, info in ipairs(PhysicsService:GetRegisteredCollisionGroups()) do
			if type(info) == "table" and type(info.name) == "string" and info.name ~= "Default" then
				table.insert(names, info.name)
			end
		end
	end)
	for _, name in ipairs(names) do
		if name ~= LOCK_GROUP then
			pcall(function()
				PhysicsService:CollisionGroupSetCollidable(WALL_GROUP, name, false)
			end)
		end
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(WALL_GROUP, LOCK_GROUP, true)
	end)
	groupsReady = true
end

-- Four side walls + a ceiling around the zone, in the zone's own frame.
local function buildWalls(party)
	local zone = party.Info.Zone
	local parent = party.Info.Model or zone.Parent
	local old = parent:FindFirstChild("LockWalls")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "LockWalls"

	local hs = zone.Size * 0.5
	local ix, iz = hs.X + ZONE_HYSTERESIS, hs.Z + ZONE_HYSTERESIS -- inner faces
	local t = WALL_THICKNESS
	local floorY = -hs.Y -- pad surface in zone space
	local h = WALL_HEIGHT + WALL_DEPTH
	local cy = floorY - WALL_DEPTH + h / 2
	local specs = {
		{ "WallFront", CFrame.new(0, cy, -(iz + t / 2)), Vector3.new(2 * (ix + t), h, t), true },
		{ "WallBack", CFrame.new(0, cy, iz + t / 2), Vector3.new(2 * (ix + t), h, t), true },
		{ "WallLeft", CFrame.new(-(ix + t / 2), cy, 0), Vector3.new(t, h, 2 * iz), true },
		{ "WallRight", CFrame.new(ix + t / 2, cy, 0), Vector3.new(t, h, 2 * iz), true },
		{ "Ceiling", CFrame.new(0, floorY + WALL_HEIGHT + t / 2, 0), Vector3.new(2 * (ix + t), t, 2 * (iz + t)), false },
	}
	local sides = {}
	for _, spec in ipairs(specs) do
		local wall = Instance.new("Part")
		wall.Name = spec[1]
		wall.Anchored = true
		wall.CanCollide = true
		wall.CanTouch = false
		wall.CastShadow = false
		wall.Size = spec[3]
		wall.CFrame = zone.CFrame * spec[2]
		wall.Material = Enum.Material.ForceField
		wall.Color = party.Diff.Color
		wall.Transparency = 1
		wall.TopSurface = Enum.SurfaceType.Smooth
		wall.BottomSurface = Enum.SurfaceType.Smooth
		pcall(function()
			wall.CollisionGroup = WALL_GROUP
		end)
		if wall.CollisionGroup ~= WALL_GROUP then
			wall.CanCollide = false -- no group: a Default wall would block everybody; the safety net still holds the lock
		end
		wall:SetAttribute("PortalId", party.Id)
		wall.Parent = folder
		if spec[4] then
			table.insert(sides, wall)
		end
	end
	folder.Parent = parent
	party.Walls = folder
	party.SideWalls = sides
	party.BarrierOn = false
end

-- Side-wall shimmer on while the pad has a party, off when it is empty.
local function setBarrier(party, on)
	if party.BarrierOn == on or not party.SideWalls then
		return
	end
	party.BarrierOn = on
	for _, wall in ipairs(party.SideWalls) do
		if wall.Parent then
			wall.Transparency = on and BARRIER_TRANSPARENCY or 1
		end
	end
end

----------------------------------------------------------------------
-- Locking players
----------------------------------------------------------------------
local function lockPart(rec, inst)
	if inst:IsA("BasePart") and rec.Groups[inst] == nil then
		rec.Groups[inst] = inst.CollisionGroup
		pcall(function()
			inst.CollisionGroup = LOCK_GROUP
		end)
	end
end

local function unlockPlayer(player)
	local rec = locks[player]
	if not rec then
		return
	end
	locks[player] = nil
	for _, conn in ipairs(rec.Conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	for part, group in pairs(rec.Groups) do
		if part.Parent ~= nil then
			pcall(function()
				if part.CollisionGroup == LOCK_GROUP then
					part.CollisionGroup = group
				end
			end)
		end
	end
	if player.Parent ~= nil then
		player:SetAttribute("PortalLocked", nil)
	end
end

local function lockPlayer(player, id)
	unlockPlayer(player)
	setupCollisionGroups()
	local rec = { PortalId = id, Groups = {}, Conns = {} }
	locks[player] = rec
	local char = player.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			lockPart(rec, d)
		end
		-- accessories / tools added while locked
		table.insert(rec.Conns, char.DescendantAdded:Connect(function(d)
			if locks[player] == rec then
				lockPart(rec, d)
			end
		end))
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(rec.Conns, hum.Died:Connect(function()
				if locks[player] == rec then
					removeFromParty(player)
				end
			end))
		end
	end
	table.insert(rec.Conns, player.CharacterRemoving:Connect(function()
		if locks[player] == rec then
			removeFromParty(player)
		end
	end))
	player:SetAttribute("PortalLocked", id)
end

-- A spot on the pad for member `player` (a small ring, so several pulls never stack players inside each other).
local function padCFrame(party, player)
	local zone = party.Info.Zone
	local hs = zone.Size * 0.5
	local index, count = 1, math.max(1, #party.Players)
	for i, p in ipairs(party.Players) do
		if p == player then
			index = i
		end
	end
	local radius = (count > 1) and PAD_SPREAD or 0
	local angle = (index - 1) / count * math.pi * 2
	local pos = zone.CFrame:PointToWorldSpace(Vector3.new(math.cos(angle) * radius, -hs.Y + PAD_ROOT_HEIGHT, math.sin(angle) * radius))
	local look = zone.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.new(pos, pos + flat.Unit)
end

-- Safety net: a locked player outside the zone goes straight back onto the pad.
local function returnToPad(player, party, t)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local cf = padCFrame(party, player)
	pcall(function()
		char:PivotTo(cf)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	if t - (lastPullToast[player] or -1e9) >= PULL_TOAST_COOLDOWN then
		lastPullToast[player] = t
		notify(player, "You're locked in the portal. Press Leave to step out.", "info", 4)
	end
end

----------------------------------------------------------------------
-- Billboard (pixel-sized, World text rule)
----------------------------------------------------------------------
local GOLD = Theme.Colors.Gold or Theme.Colors.Token
-- (kit-b U7b) the rating on an empty label: `filled` gold PixelIcon stars of MAX_STARS, the rest dim
local function starRating(label, filled)
	filled = math.max(0, math.min(MAX_STARS, math.floor(tonumber(filled) or 1)))
	label.Text = ""
	label.TextXAlignment = Enum.TextXAlignment.Left
	PixelIcon.Lead(label, "star", { Count = filled, Of = MAX_STARS, Colour = Theme.Sign.GoldLip }) -- (the gate board's stars on stone)
end

local function listLayout(parent, direction, padding)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.Parent = parent
	return layout
end

-- World height of the gate's top (the star gems), or a sensible height above the zone.
local function gateTopY(info)
	local top = nil
	local model = info.Model
	if model then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "StarGem" or d.Name == "StarGemOff") then
				local y = d.Position.Y + 1.1
				if not top or y > top then
					top = y
				end
			end
		end
	end
	if not top and zoneAlive(info.Zone) then
		top = info.Zone.Position.Y + info.Zone.Size.Y * 0.5 + 10
	end
	return top
end

local function billboardAnchor(party)
	local info = party.Info
	local anchor = info.Model and info.Model:FindFirstChild("BillboardAnchor")
	if anchor and anchor:IsA("BasePart") then
		return anchor
	end
	anchor = Instance.new("Part")
	anchor.Name = "BillboardAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(info.Zone.Position + Vector3.new(0, 14, 0))
	anchor.Parent = info.Model or info.Zone.Parent
	return anchor
end

-- Phase 5: the gate already carries a pixel tag (WorldStyle.BuildGate's "GateTag": Title / Info / Pill.Label); the
-- party state is written into it (title "Sky Obby", info "Hard ★★★ - 2/4 players", the status pill). true when used.
local function useGateTag(party)
	local info = party.Info
	local tag = info.Billboard
	if typeof(tag) ~= "Instance" or not tag:IsA("BillboardGui") or tag.Name ~= "GateTag" then
		return false
	end
	if not info.StatusLabel or not info.StatusPill then
		return false
	end
	party.Billboard = tag
	party.Pill = info.StatusPill
	party.PillStroke = info.StatusPill:FindFirstChildOfClass("UIStroke")
	party.PillMode = nil
	info.StatusPill.Visible = true
	return true
end

local function buildBillboard(party)
	if useGateTag(party) then
		return
	end
	local info = party.Info
	local diff = party.Diff
	local color = diff.Color
	local anchor = billboardAnchor(party)
	local Sign, Z = Theme.Sign, WorldTag.Sizes

	-- the old studs-sized card (text shrank with distance) goes away
	local old = info.Billboard
	if old and old.Parent and old ~= party.Billboard then
		old:Destroy()
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "PortalBillboard"
	gui.Size = UDim2.fromOffset(BB.Width, BB.Height)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the container's bottom edge sits on the anchor point
	local topY = gateTopY(info)
	local offsetY = 0
	if topY then
		offsetY = topY + BB.Gap - anchor.Position.Y
	end
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.MaxDistance = BB.MaxDistance
	gui.ClipsDescendants = false
	gui.Adornee = anchor
	gui:SetAttribute("BaseWidth", BB.Width)
	gui:SetAttribute("BaseHeight", BB.Height)

	-- (kit-b world signs, lane C: the rounded gradient plate in the portal's colour went) the NPC nameplate's stone card:
	-- a 3 px mitred wood edge, a lip in the portal's colour, the name and the head count in the kit's brown ink, the stars
	-- in the dark gold, the status pill a small square block tinted in the portal's colour (setPillMode re-tints it gold
	-- while counting down). Every line is measured (the longest status and head count too), so the card never resizes
	local maxP = Config.Match.MaxPlayers
	local name = diff.DisplayName or diff.Id
	local function wide(text, role, px)
		return math.ceil(Theme.Measure(text, role, px).X)
	end
	local statusW = 0
	for _, t in ipairs({ "Step in to play", "Waiting for players...", string.format("Full! Starting in %d", 88) }) do
		statusW = math.max(statusW, wide(t, "Display", BB.StatusText))
	end
	local infoW = MAX_STARS * (BB.InfoText + 2) + 12 + wide(string.format("%d/%d players", maxP, maxP), "Heading", BB.InfoText)
	local faceW = math.max(BB.PlateMinW - 2 * Z.Edge, wide(name, "Title", BB.NameText) + 2 * BB.PadX, infoW + 2 * BB.PadX,
		statusW + 2 * (BB.PillPad + BB.PillEdge + BB.PadX))
	local pillH = BB.StatusText + 6 + BB.PillLip -- the pill's face, its lip included
	local y = BB.PadTop
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.AnchorPoint = Vector2.new(0.5, 1)
	plate.Position = UDim2.new(0.5, 0, 1, -Z.Edge)
	plate.ZIndex = 2
	WorldTag.Block(plate, Sign.Stone, WorldTag.LipOf(color), Sign.Wood, Z.Edge, Z.Lip)
	plate.Parent = gui

	local title = WorldTag.Text(plate, "TitleLabel", name, "Title", BB.NameText, Sign.Text, {
		Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, BB.NameText + 4), TextXAlignment = Enum.TextXAlignment.Center,
		LayoutOrder = 1, ZIndex = 3,
	})
	y = y + BB.NameText + 4 + BB.Gap

	local infoRow = Instance.new("Frame")
	infoRow.Name = "InfoRow"
	infoRow.BackgroundTransparency = 1
	infoRow.AnchorPoint = Vector2.new(0.5, 0)
	infoRow.Position = UDim2.new(0.5, 0, 0, y)
	infoRow.Size = UDim2.fromOffset(0, BB.InfoText + 4)
	infoRow.AutomaticSize = Enum.AutomaticSize.X
	infoRow.LayoutOrder = 2
	infoRow.ZIndex = 3
	listLayout(infoRow, Enum.FillDirection.Horizontal, 12)
	infoRow.Parent = plate
	local stars = WorldTag.Text(infoRow, "StarLabel", "", "Heading", BB.InfoText, Sign.Text, {
		Size = UDim2.fromOffset(0, BB.InfoText + 4), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 1, ZIndex = 3,
	})
	starRating(stars, diff.Stars)
	local count = WorldTag.Text(infoRow, "CountLabel", "0/" .. tostring(maxP) .. " players", "Heading", BB.InfoText, Sign.TextMuted, {
		Size = UDim2.fromOffset(0, BB.InfoText + 4), AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 2, ZIndex = 3,
	})
	y = y + BB.InfoText + 4 + BB.Gap

	local pill = Instance.new("Frame")
	pill.Name = "StatusPill"
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.Position = UDim2.new(0.5, 0, 0, y + BB.PillEdge)
	pill.Size = UDim2.fromOffset(faceW - 2 * (BB.PadX + BB.PillEdge), pillH)
	pill.LayoutOrder = 3
	pill.ZIndex = 3
	WorldTag.Block(pill, color, color, Sign.Wood, BB.PillEdge, BB.PillLip)
	pill.Parent = plate
	local status = WorldTag.Text(pill, "StatusLabel", "Step in to play", "Display", BB.StatusText, Sign.Text, {
		Size = UDim2.new(1, 0, 1, -BB.PillLip), TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1, ZIndex = 4,
	})
	WorldTag.Tint(pill, color)
	y = y + pillH + 2 * BB.PillEdge
	plate.Size = UDim2.fromOffset(faceW, y + BB.PadBottom + Z.Lip)

	gui.Parent = anchor

	party.Billboard = gui
	party.Pill = pill
	party.PillStroke = nil
	party.PillMode = nil
	-- keep the LobbyInfo contract (Billboard + labels) pointing at the live billboard
	info.Billboard = gui
	info.TitleLabel = title
	info.StarLabel = stars
	info.CountLabel = count
	info.StatusLabel = status
end

----------------------------------------------------------------------
-- Countdown face (eye level, SurfaceGui in the gate's swirl)
----------------------------------------------------------------------
-- In the zone's frame (-Z faces the plaza): the swirl's centre, pulled just in front of the back lock wall so
-- viewers on the plaza look through the front wall only. Without a SwirlCore: the back edge of the pad.
local function faceCFrame(party)
	local zone = party.Info.Zone
	local hs = zone.Size * 0.5
	local inner = hs.Z + ZONE_HYSTERESIS -- the back wall's inner face
	local model = party.Info.Model
	local swirl = model and model:FindFirstChild("SwirlCore") -- (the Phase 5 gate has none: the face stands at the back wall)
	local rel
	if swirl and swirl:IsA("BasePart") then
		rel = zone.CFrame:PointToObjectSpace(swirl.Position)
	else
		rel = Vector3.new(0, -hs.Y + FACE.Lift, inner)
	end
	local z = math.min(rel.Z - FACE.SwirlGap, inner - FACE.WallGap - FACE.Thickness / 2)
	return zone.CFrame * CFrame.new(rel.X, rel.Y, z)
end

local function buildFace(party)
	local info = party.Info
	local color = party.Diff.Color
	local parent = info.Model or info.Zone.Parent
	local Sign = Theme.Sign
	local old = parent:FindFirstChild("CountdownFace")
	if old then
		old:Destroy()
	end

	local part = Instance.new("Part")
	part.Name = "CountdownFace"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(FACE.Width, FACE.Height, FACE.Thickness)
	part.CFrame = faceCFrame(party)
	part:SetAttribute("PortalId", party.Id)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "CountdownGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = FACE.PPS
	gui.CanvasSize = Vector2.new(FACE.Width * FACE.PPS, FACE.Height * FACE.PPS)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Enabled = false -- shown while the pad has a party
	gui.Adornee = part
	local canvasW = FACE.Width * FACE.PPS

	-- (kit-b world signs, lane C: the round gradient badge with its gold rim, the gloss ring and the rounded ribbon and
	-- count pill went) the badge is a square stone card (THE GATES board's 6 px mitred wood edge, a FACE.Lip px lip in the
	-- portal's colour that turns gold while a countdown runs), the numeral in the kit's brown ink
	local disc = Instance.new("Frame")
	disc.Name = "Disc"
	disc.AnchorPoint = Vector2.new(0.5, 0.5)
	disc.Position = UDim2.new(0.5, 0, 0, FACE.DiscY)
	disc.Size = UDim2.fromOffset(FACE.Disc, FACE.Disc)
	local _, discLip = WorldTag.Block(disc, Sign.Stone, color, Sign.Wood, FACE.Edge, FACE.Lip)
	disc.Parent = gui

	-- the numeral fills the badge box above the lip (its UIScale grows it around the centre)
	local num = WorldTag.Text(disc, "NumeralLabel", "0", "Display", FACE.NumText, Sign.Text, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -math.floor(FACE.Lip / 2)),
		Size = UDim2.new(1, 0, 1, -FACE.Lip),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 3,
	})
	local numScale = Instance.new("UIScale")
	numScale.Scale = FACE.NumScale
	numScale.Parent = num

	-- a measured block: as wide as the widest of `texts` plus its side room, inside the canvas (its edge too)
	local function blockW(texts, role, px)
		local w = 0
		for _, t in ipairs(texts) do
			w = math.max(w, math.ceil(Theme.Measure(t, role, px).X))
		end
		return math.min(w + 2 * FACE.PillPad, canvasW - 2 * FACE.PillEdge)
	end

	-- "Starting in" ribbon over the badge's top edge: a small square gold block (WorldTag.Tint; setPillMode re-tints it
	-- in the portal's colour while waiting)
	local top = Instance.new("Frame")
	top.Name = "TopPill"
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, FACE.TopY + FACE.PillEdge)
	top.Size = UDim2.fromOffset(blockW({ "Starting in", "Waiting..." }, "Title", FACE.TopText), FACE.TopText + 8 + FACE.PillLip)
	top.ZIndex = 4
	WorldTag.Block(top, GOLD, GOLD, Sign.Wood, FACE.PillEdge, FACE.PillLip)
	top.Parent = gui
	local topLabel = WorldTag.Text(top, "TopLabel", "Starting in", "Title", FACE.TopText, Sign.Text, {
		Size = UDim2.new(1, 0, 1, -FACE.PillLip), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5,
	})
	WorldTag.Tint(top, GOLD)

	-- head count under the badge: a small square stone block, its lip in the portal's colour
	local maxP = Config.Match.MaxPlayers
	local bottom = Instance.new("Frame")
	bottom.Name = "CountPill"
	bottom.AnchorPoint = Vector2.new(0.5, 0.5)
	bottom.Position = UDim2.new(0.5, 0, 0, FACE.CountY)
	bottom.Size = UDim2.fromOffset(blockW({ string.format("%d/%d players", maxP, maxP), string.format("Full! %d/%d", maxP, maxP) }, "Heading", FACE.CountText),
		FACE.CountText + 8 + FACE.PillLip)
	bottom.ZIndex = 4
	WorldTag.Block(bottom, Sign.Tile, WorldTag.LipOf(color), Sign.Wood, FACE.PillEdge, FACE.PillLip)
	bottom.Parent = gui
	local countLabel = WorldTag.Text(bottom, "CountLabel", "0/" .. tostring(maxP) .. " players", "Heading", FACE.CountText, Sign.Text, {
		Size = UDim2.new(1, 0, 1, -FACE.PillLip), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 5,
	})

	gui.Parent = part
	part.Parent = parent

	party.Face = {
		Part = part,
		Gui = gui,
		DiscLip = discLip,
		TopPill = top,
		Top = topLabel,
		Num = num,
		Count = countLabel,
		Shown = false,
	}
	info.CountdownFace = part
end

----------------------------------------------------------------------
-- Party bookkeeping
----------------------------------------------------------------------
-- Effective launch deadline: the normal timer, or the short "party is full" timer if sooner.
local function effectiveDeadline(party)
	local d = party.BaseDeadline
	if d and party.FullDeadline and party.FullDeadline < d then
		d = party.FullDeadline
	end
	return d
end

local function countdownOf(party, t)
	local d = effectiveDeadline(party)
	if not d then
		return nil
	end
	return math.max(0, math.ceil(d - (t or clock())))
end

local function isFull(party)
	return #party.Players >= Config.Match.MaxPlayers
end

-- Recompute the timers after a join/leave.
local function onMembershipChanged(party)
	local t = clock()
	local n = #party.Players
	setBarrier(party, n > 0)
	if n == 0 then
		party.BaseDeadline = nil
		party.FullDeadline = nil
		return
	end
	if not party.BaseDeadline then
		party.BaseDeadline = t + Config.Match.PartyCountdown
	end
	if isFull(party) then
		if not party.FullDeadline then
			party.FullDeadline = t + Config.Match.FullPartyCountdown
		end
	else
		party.FullDeadline = nil
	end
end

local function setText(label, text, cacheKey, party)
	if party[cacheKey] == text then
		return
	end
	party[cacheKey] = text
	if label then
		pcall(function()
			label.Text = text
		end)
	end
end

local function setModelAttr(party, name, value)
	local model = party.Info.Model
	if model and model.Parent and model:GetAttribute(name) ~= value then
		model:SetAttribute(name, value)
	end
end

-- Status pill colours: the portal colour while idle, gold while a countdown runs.
local function setPillMode(party, mode)
	if party.PillMode == mode or not party.Pill then
		return
	end
	party.PillMode = mode
	local base = (mode == "Countdown") and GOLD or Theme.Darken(party.Diff.Color, 0.2)
	if party.Pill:GetAttribute("WorldTag") == true then
		-- (look review r1, M5) the gate board's pill is a kit block: the face a light tint of the mode's colour, its lip
		-- that colour, the ink brown; the wood edge stays wood
		WorldTag.Tint(party.Pill, base)
	else
		party.Pill.BackgroundColor3 = base
		if party.PillStroke then
			party.PillStroke.Color = Theme.Darken(base, 0.7)
		end
	end
	local outline = party.Info.StatusLabel and party.Info.StatusLabel:FindFirstChild("TextOutline")
	if outline then
		outline.Color = Theme.Darken(base, 0.66)
	end
	-- the face's ribbon and badge lip follow (kit-b world signs, lane C: kit blocks, the wood edges stay wood): gold while
	-- counting down, the portal colour while waiting
	local face = party.Face
	if face then
		WorldTag.Tint(face.TopPill, base)
		if face.DiscLip then
			face.DiscLip.BackgroundColor3 = (mode == "Countdown") and GOLD or party.Diff.Color
		end
	end
end

-- The eye-level face: hidden on an empty pad, otherwise "Starting in" / the seconds / the head count.
local function refreshFace(party, n, seconds, mode)
	local face = party.Face
	if not face then
		return
	end
	local shown = n > 0
	if face.Shown ~= shown then
		face.Shown = shown
		pcall(function()
			face.Gui.Enabled = shown
		end)
	end
	if not shown then
		return
	end
	local max = Config.Match.MaxPlayers
	setText(face.Top, (mode == "Countdown") and "Starting in" or "Waiting...", "LastFaceTop", party)
	setText(face.Num, tostring(seconds or 0), "LastFaceNum", party)
	local count
	if isFull(party) then
		count = string.format("Full! %d/%d", n, max)
	else
		count = string.format("%d/%d players", n, max)
	end
	setText(face.Count, count, "LastFaceCount", party)
end

-- Billboard above the portal: "2/4 players" and the status pill.
local function refreshLabels(party)
	local info = party.Info
	local n = #party.Players
	local max = Config.Match.MaxPlayers
	setText(info.CountLabel, string.format("%d/%d players", n, max), "LastCount", party)
	if info.InfoLabel then
		local diff = party.Diff
		local stars = math.max(0, math.min(MAX_STARS, math.floor(tonumber(diff.Stars) or 1)))
		setText(info.InfoLabel, string.format("%s - %d/%d players", tostring(diff.DisplayName or diff.Id), n, max), "LastInfo", party)
		-- (kit-b U7b) the gate card's stars lead the line as PixelIcons ("<3 stars> Hard - 2/4 players"), redrawn on a change
		if party.LastInfoStars ~= stars then
			party.LastInfoStars = stars
			pcall(function()
				if stars > 0 then
					-- (look review fin0, minor) on the board's cream stone the kit's dark gold (Sign.GoldLip, as the HUD's
					-- stars on its stone cards): the light gold read at ~1.5:1 there
					PixelIcon.Lead(info.InfoLabel, "star", { Count = stars, Of = stars, Colour = Theme.Sign.GoldLip })
				else
					PixelIcon.Clear(info.InfoLabel)
				end
			end)
		end
	end

	local status, mode
	local seconds = countdownOf(party)
	if n == 0 then
		status, mode = "Step in to play", "Idle"
	elseif n < Config.Match.MinPlayers then
		status, mode = "Waiting for players...", "Idle"
	elseif isFull(party) then
		status, mode = string.format("Full! Starting in %d", seconds or 0), "Countdown"
	else
		status, mode = string.format("Starting in %d", seconds or 0), "Countdown"
	end
	setText(info.StatusLabel, status, "LastStatus", party)
	setPillMode(party, mode)
	refreshFace(party, n, seconds, mode)
	setModelAttr(party, "PartyCount", n)
	setModelAttr(party, "PartyMax", max)
	if n > 0 then
		setModelAttr(party, "Countdown", seconds)
	else
		setModelAttr(party, "Countdown", nil)
	end
end

local function buildPartyState(party)
	local list = {}
	for _, p in ipairs(party.Players) do
		list[#list + 1] = { UserId = p.UserId, Name = nameOf(p) }
	end
	local leader = party.Leader
	return {
		PortalId = party.Id,
		Level = party.Diff.Id, -- Phase 5 (6.3): the party's obby level, its stars and the leader (who may change it)
		Stars = party.Diff.Stars,
		LeaderUserId = leader and leader.UserId or nil,
		DifficultyName = party.Diff.DisplayName,
		Color = party.Diff.Color,
		Players = list,
		Max = Config.Match.MaxPlayers,
		Countdown = countdownOf(party),
		Locked = true, -- members stay on the pad until launch; Leave is the only way out
	}
end

local function sendPartyState(party)
	if #party.Players == 0 then
		return
	end
	local state = buildPartyState(party)
	for _, p in ipairs(party.Players) do
		fireClient("PartyState", p, state)
	end
	party.LastStateAt = clock()
end

-- The party's level changed (a new party, a leader's pick): the model attribute, the old billboard's stars, the pill.
local function applyLevel(party)
	setModelAttr(party, "PartyLevel", party.Diff.Id)
	local info = party.Info
	if info.StarLabel then
		pcall(function()
			starRating(info.StarLabel, party.Diff.Stars)
		end)
	end
	party.PillMode = nil
	party.LastInfo = nil
end

local function addToParty(player, id)
	local party = parties[id]
	if not party then
		return false
	end
	if #party.Players == 0 then
		-- the first player on the empty pad picks the level (their pick if still unlocked, else their highest)
		party.Diff = levelForNewParty(player)
		applyLevel(party)
	end
	if isFull(party) then
		if fullNotified[player] ~= id then
			fullNotified[player] = id
			notify(player, "Party is full", "bad", 3)
		end
		return false
	end
	table.insert(party.Players, player)
	party.Leader = party.Players[1]
	playerParty[player] = id
	fullNotified[player] = nil
	lockPlayer(player, id)
	onMembershipChanged(party)
	refreshLabels(party)
	sendPartyState(party) -- everybody's list changed
	notify(player, "You're in the " .. tostring(party.Diff.DisplayName) .. " climb! Press Leave to step out.", "info", 4)
	return true
end

-- Leave the party (no lockout, no teleport) and unlock.
removeFromParty = function(player)
	unlockPlayer(player)
	local id = playerParty[player]
	if not id then
		return
	end
	playerParty[player] = nil
	local party = parties[id]
	if not party then
		return
	end
	removeValue(party.Players, player)
	party.Leader = party.Players[1]
	onMembershipChanged(party)
	refreshLabels(party)
	fireClient("PartyState", player, nil)
	sendPartyState(party)
end

-- Cancel a countdown: everybody is unlocked and leaves; they step out before they can join again.
local function cancelParty(party, message)
	local members = copyList(party.Players)
	local t = clock()
	for _, p in ipairs(members) do
		removeFromParty(p)
		lockedUntil[p] = t + LEAVE_LOCKOUT
		mustExit[p] = true
		if message then
			notify(p, message, "info", 4)
		end
	end
	return #members
end

----------------------------------------------------------------------
-- Launching a match
----------------------------------------------------------------------
local function launch(party)
	local members = copyList(party.Players)

	-- clear the party first: from here on these players belong to MatchService
	for _, p in ipairs(members) do
		playerParty[p] = nil
		unlockPlayer(p)
		starting[p] = true
		fireClient("PartyState", p, nil)
	end
	party.Players = {}
	party.Leader = nil
	local levelId = party.Diff.Id
	onMembershipChanged(party)
	refreshLabels(party)

	task.spawn(function()
		local match = nil
		if matchService and type(matchService.StartMatch) == "function" then
			local ok, result = pcall(matchService.StartMatch, levelId, members)
			if ok then
				match = result
			else
				warn("[PortalService] StartMatch failed: " .. tostring(result))
			end
		else
			warn("[PortalService] MatchService unavailable")
		end

		local t = clock()
		for _, p in ipairs(members) do
			starting[p] = nil
			if not match and p.Parent ~= nil then
				notify(p, "All sky arenas are busy, try again soon", "bad", 4)
				-- stop the pad from instantly re-forming the same party
				lockedUntil[p] = t + FAILED_LOCKOUT
				mustExit[p] = true
			end
		end
	end)
end

-- Per-party timer: launch when the deadline passes.
local function updateParty(party, t)
	-- drop anybody who vanished without us noticing
	for _, p in ipairs(copyList(party.Players)) do
		if p.Parent == nil then
			removeFromParty(p)
		end
	end

	local n = #party.Players
	if n > 0 and not zoneAlive(party.Info.Zone) then
		cancelParty(party, nil) -- the pad itself is gone
		n = 0
	end
	if n == 0 then
		refreshLabels(party)
		return
	end

	local deadline = effectiveDeadline(party)
	if deadline and t >= deadline then
		if n >= Config.Match.MinPlayers then
			launch(party)
			return
		end
		-- not enough players: the countdown is cancelled (nobody stays locked in an endless wait)
		cancelParty(party, "Not enough players to start. Step in again!")
		refreshLabels(party)
		return
	end

	refreshLabels(party)
	if t - (party.LastStateAt or 0) >= STATE_INTERVAL then
		sendPartyState(party)
	end
end

----------------------------------------------------------------------
-- Poll loop
----------------------------------------------------------------------
local function pollPlayer(player, t)
	if starting[player] then
		return
	end
	local current = playerParty[player]
	local inMatch = isInMatch(player)
	local root = nil
	if not inMatch then
		root = getAliveRoot(player)
	end

	if current then
		local party = parties[current]
		if inMatch or not root or not party then
			-- died, downed, no character, or pulled into a match: the seat (and the lock) ends here
			removeFromParty(player)
			current = nil
		elseif not zoneAlive(party.Info.Zone) then
			return -- updateParty cancels this party
		elseif inZone(party.Info.Zone, root.Position, ZONE_HYSTERESIS) then
			if not locks[player] then
				lockPlayer(player, current) -- a fresh character mid-countdown (should not happen, but never leave a member unlocked)
			end
			return
		else
			-- safety net: locked members cannot walk, jump, dash or get flung out
			returnToPad(player, party, t)
			return
		end
	end

	local zoneId = nil
	if root then
		zoneId = zoneAt(root.Position, nil)
	end
	if zoneId == nil then
		mustExit[player] = nil
		fullNotified[player] = nil
		return
	end

	local until_ = lockedUntil[player]
	if until_ and t >= until_ then
		lockedUntil[player] = nil
		until_ = nil
	end
	if until_ == nil and not mustExit[player] then
		addToParty(player, zoneId)
	end
end

local function pollOnce()
	local t = clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, err = pcall(pollPlayer, player, t)
		if not ok then
			warn("[PortalService] player poll failed: " .. tostring(err))
		end
	end
	for _, id in ipairs(order) do
		local ok, err = pcall(updateParty, parties[id], t)
		if not ok then
			warn("[PortalService] party update failed: " .. tostring(err))
		end
	end
end

local function pollLoop()
	while running do
		local ok, err = pcall(pollOnce)
		if not ok then
			warn("[PortalService] poll error: " .. tostring(err))
		end
		task.wait(POLL)
	end
end

----------------------------------------------------------------------
-- Leave button: unlock, remove from the party and step the player off the pad
----------------------------------------------------------------------
local function ejectFromPad(player, id)
	local party = parties[id]
	local root = Util.GetRoot(player)
	if not party or not root then
		return
	end
	local zone = party.Info.Zone
	local center = party.Info.Center
	if not center and zone then
		center = zone.Position
	end
	if not center then
		return
	end

	-- Move toward the plaza centre (the pads sit near the plaza rim, "outward" would be the void).
	local toPlaza = Vector3.new(Config.Lobby.Origin.X - center.X, 0, Config.Lobby.Origin.Z - center.Z)
	if toPlaza.Magnitude < 0.001 then
		toPlaza = Vector3.new(0, 0, 1)
	end
	local dir = toPlaza.Unit
	local target = center + dir * EJECT_DISTANCE

	local y = root.Position.Y
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		local hit = Workspace:Raycast(Vector3.new(target.X, root.Position.Y + 6, target.Z), Vector3.new(0, -40, 0), params)
		if hit then
			y = hit.Position.Y + 3.2
		end
	end)

	local pos = Vector3.new(target.X, y, target.Z)
	pcall(function()
		player.Character:PivotTo(CFrame.new(pos, pos + dir))
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
end

local function onLeaveParty(player)
	if not isPlayer(player) then
		return
	end
	local id = playerParty[player]
	if not id then
		return
	end
	local t = clock()
	if t - (lastLeave[player] or -1e9) < LEAVE_COOLDOWN then
		return
	end
	lastLeave[player] = t
	removeFromParty(player) -- unlocks first, so the step off the pad never meets a wall
	lockedUntil[player] = t + LEAVE_LOCKOUT
	mustExit[player] = true
	ejectFromPad(player, id)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- lobbyInfo: LobbyBuilder.Build() result; matchServiceArg: the MatchService module.
function PortalService.Init(lobbyInfo, matchServiceArg)
	matchService = matchServiceArg or matchService
	if initialized then
		return
	end
	initialized = true

	local okGroups, errGroups = pcall(setupCollisionGroups)
	if not okGroups then
		warn("[PortalService] collision groups: " .. tostring(errGroups))
	end

	-- Phase 5 (6.3): ONE party slot, the Sky Obby portal (lobbyInfo.Portals.Obby)
	local portals = (lobbyInfo and lobbyInfo.Portals) or {}
	local info = portals[PORTAL_ID]
	if info and not info.Zone then
		warn("[PortalService] the Obby portal has no Zone")
		info = nil
	end
	if info then
		parties[PORTAL_ID] = {
			Id = PORTAL_ID,
			Info = info,
			Diff = Config.Difficulties[1],
			Players = {},
			Leader = nil,
			BaseDeadline = nil,
			FullDeadline = nil,
			LastStateAt = 0,
		}
		table.insert(order, PORTAL_ID)
	else
		warn("[PortalService] the lobby has no Obby portal")
	end
	for _, id in ipairs(order) do
		local party = parties[id]
		local okWalls, errWalls = pcall(buildWalls, party)
		if not okWalls then
			warn("[PortalService] lock walls for " .. id .. ": " .. tostring(errWalls))
		end
		local okBoard, errBoard = pcall(buildBillboard, party)
		if not okBoard then
			warn("[PortalService] billboard for " .. id .. ": " .. tostring(errBoard))
		end
		local okFace, errFace = pcall(buildFace, party)
		if not okFace then
			party.Face = nil
			warn("[PortalService] countdown face for " .. id .. ": " .. tostring(errFace))
		end
		applyLevel(party)
		refreshLabels(party)
		local okPrompt, errPrompt = pcall(PortalService._MakePrompt, party.Info)
		if not okPrompt then
			warn("[PortalService] ObbyPrompt: " .. tostring(errPrompt))
		end
	end

	local okPick, pickRemote = pcall(Remotes.Get, "ObbyPick")
	if okPick and pickRemote then
		pickRemote.OnServerEvent:Connect(function(player, levelId)
			local ok, err = pcall(PortalService.PickLevel, player, levelId)
			if not ok then
				warn("[PortalService] ObbyPick: " .. tostring(err))
			end
		end)
	else
		warn("[PortalService] ObbyPick remote unavailable")
	end

	local okRemote, leaveRemote = pcall(Remotes.Get, "LeaveParty")
	if okRemote and leaveRemote then
		leaveRemote.OnServerEvent:Connect(onLeaveParty)
	else
		warn("[PortalService] LeaveParty remote unavailable")
	end

	Players.PlayerRemoving:Connect(function(player)
		removeFromParty(player)
		lockedUntil[player] = nil
		mustExit[player] = nil
		starting[player] = nil
		fullNotified[player] = nil
		lastLeave[player] = nil
		lastPullToast[player] = nil
		pickBuckets[player] = nil
	end)

	running = true
	task.spawn(pollLoop)
end

-- Leave the current party (no-op when not in one) and unlock. No lockout, no teleport.
function PortalService.RemovePlayer(player)
	removeFromParty(player)
end

function PortalService.GetParty(portalId)
	local party = parties[portalId or PORTAL_ID]
	if not party then
		return { Players = {}, Countdown = nil }
	end
	return { Players = copyList(party.Players), Countdown = countdownOf(party), Level = party.Diff.Id, Leader = party.Leader }
end

-- TESTS (kit-b world signs, lane C): builds the stand-in PortalBillboard and the countdown face for `info` ({ Model, Zone }:
-- a gate WITHOUT a GateTag, which today's world never has) as Init does, the labels filled for `n` players; `mode`
-- "Countdown" tints the pill and the face as a running countdown does. Not a live party (never polled) -> the party table
function PortalService._BuildCards(info, n, mode)
	local party = { Id = "Test", Info = info, Diff = Config.Difficulties[1], Players = {}, LastStateAt = 0 }
	buildBillboard(party)
	buildFace(party)
	setText(info.CountLabel, string.format("%d/%d players", n or 0, Config.Match.MaxPlayers), "LastCount", party)
	setPillMode(party, mode or "Idle")
	refreshFace(party, n or 0, 9, mode or "Idle")
	return party
end

-- The Obby gate's prompt (6.3): "Pick level" / "Sky Obby", OpenPanel = "Obby" (ObbyController opens the picker).
function PortalService._MakePrompt(info)
	local part = info and info.PromptPart
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return nil
	end
	local old = part:FindFirstChild("ObbyPrompt")
	if old then
		old:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ObbyPrompt"
	prompt.ActionText = "Pick level"
	prompt.ObjectText = "Sky Obby"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenPanel", "Obby")
	prompt.Parent = part
	return prompt
end

-- ObbyPick (6.3, Y10): validates on the server copy of the profile and writes the player's ObbyLevel attribute; a
-- party LEADER's pick before launch also moves the party's level. Returns ok, reason ("junk" | "rate" | "profile" |
-- "locked"); junk is dropped silently, a locked level answers "Beat Medium to unlock Hard".
function PortalService.PickLevel(player, levelId)
	if not isPlayer(player) then
		return false, "junk"
	end
	if type(levelId) ~= "string" or #levelId == 0 or #levelId > PICK_MAX_LEN then
		return false, "junk"
	end
	local diff = Config.GetDifficulty(levelId)
	if not diff then
		return false, "junk"
	end
	if not allowPick(player) then
		return false, "rate"
	end
	local bestTimes = bestTimesOf(player)
	if not bestTimes then
		return false, "profile"
	end
	if not levelUnlocked(bestTimes, levelId) then
		local index = (ObbyLevels and ObbyLevels.IndexOf(levelId)) or 1
		local prev = Config.Difficulties[math.max(1, index - 1)] or diff
		notify(player, string.format("Beat %s to unlock %s", tostring(prev.DisplayName or prev.Id), tostring(diff.DisplayName or diff.Id)), "bad", 3)
		return false, "locked"
	end
	if player:GetAttribute(Config.Attr.ObbyLevel) ~= levelId then
		player:SetAttribute(Config.Attr.ObbyLevel, levelId)
	end
	local party = parties[playerParty[player] or ""]
	if party and party.Leader == player and #party.Players > 0 and not starting[player] and party.Diff.Id ~= levelId then
		party.Diff = diff
		local t = clock()
		party.BaseDeadline = math.max(party.BaseDeadline or t, t + PICK_EXTEND)
		if party.FullDeadline then
			party.FullDeadline = math.max(party.FullDeadline, t + PICK_EXTEND)
		end
		applyLevel(party)
		for _, p in ipairs(party.Players) do
			if p ~= player then
				notify(p, "Level: " .. tostring(diff.DisplayName or diff.Id), "info", 3)
			end
		end
		refreshLabels(party)
		sendPartyState(party)
	end
	return true
end

-- true, portalId while `player` is locked inside a portal pad (waiting for its countdown).
function PortalService.IsLocked(player)
	local rec = locks[player]
	if rec then
		return true, rec.PortalId
	end
	return false, nil
end

-- Cancels a running countdown: every member is unlocked and removed (they must step out before re-joining).
-- Returns how many players were in the party.
function PortalService.CancelParty(portalId, message)
	local party = parties[portalId]
	if not party then
		return 0
	end
	local n = cancelParty(party, message)
	refreshLabels(party)
	return n
end

-- Stops the poll loop and releases everybody (not needed in normal play; handy for tests / shutdown).
function PortalService.Stop()
	running = false
	for _, id in ipairs(order) do
		pcall(PortalService.CancelParty, id, nil)
	end
end

return PortalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1113">
          <Properties>
            <string name="Name">SkyService</string>
            <string name="Source"><![CDATA[-- SkyService: the living sky's server half (docs/superpowers/specs/2026-10-30-living-sky-cycle-design.md, plan
-- docs/superpowers/plans/2026-10-30-living-sky.md Task 4). The server never tweens the sky: it publishes one clock and the
-- raid event as Workspace attributes (Config.Sky.Attr), every client turns them into the same phase and look with
-- shared/SkyCycle and applies it as the base of its LightingStack. No remote traffic, no per-frame work.
--
--   SkyService.Init(deps)        deps = { EventService, BattleService } (both optional). The first call publishes
--                                SkyEpoch = Workspace:GetServerTimeNow(), SkySpeed = Config.Sky.Speed.Default, SkyOffset 0,
--                                SkyEvent "" and SkyEventAt = now, and starts the raid watchdog. Init again (tests) never
--                                rewrites them: it only wires signals it was not given before and points the watchdog
--                                at the newest BattleService.
--   SkyService.SetPhase(name) -> ok, message     "dawn" | "day" | "sunset" | "night" (any case): SkyOffset so that
--                                phase starts now (dev /sky <phase>)
--   SkyService.SetSpeed(x) -> ok, speed|message  a finite number clamped to Config.Sky.Speed (0.1..120); SkyOffset moves
--                                with it so the loop keeps its position (no jump); NaN / inf / non-numbers are refused
--   SkyService.SetEvent(bossId, source, battleId) -> ok, message   a Config.Sky.RaidThemes boss id; source "raid" (the
--                                default) or "dev" (/sky raid: a preview the watchdog leaves alone)
--   SkyService.ClearEvent() -> ok                 SkyEvent "" (the clients blend back to the cycle)
--   SkyService.Status() -> { Phase, Next, T, Blend, LoopT, Seconds, Length, Speed, Offset, Event, Source }
--   SkyService.Find(word) -> bossId | nil         an exact boss id or a unique prefix ("storm" -> storm_titan)
-- The raid sky (server-wide; it follows the FLOOR fight, the one the whole colosseum sees: fighters in a pocket get theirs locally):
--   * on   EventService.EventStarted("BossRaid", { BossId, BattleId }), the floor fight's start, for a boss with a RaidThemes sky
--   * off  BattleService.BattleEnded(battleId, result) with result.Mode "Raid" (every Reason: BossDown, Wipe, Error,
--          Timeout, NoPlayers) and EventService.EventEnded("BossRaid", info); an end that names ANOTHER raid's battle id
--          (a late end of the raid before) leaves the current raid's sky up. Non-Raid ends never clear.
--   * the watchdog, every Config.Sky.EventWatch s: BattleService.GetRaidStatus().Active (the floor fight) is the truth for raid skies (a
--          fight gone without an end we heard clears, a fight that started without EventStarted gets its sky); dev previews are
--          left alone. A server shutdown takes the attributes with it (a new server starts on SkyEvent "").
-- SkyEventAt changes only when SkyEvent does (the same boss again does not restart the clients' blend).
-- Plain Lua 5.1-compatible syntax only.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local SkyCycle = require(Shared.SkyCycle)

local SkyService = {}

local St = {
	initialized = false,
	wired = {}, -- [signal table] = true once connected
	battle = nil, -- the BattleService the watchdog asks (the newest Init's)
	source = nil, -- "raid" | "dev" while SkyEvent is set
	battleId = nil, -- the raid battle id behind a "raid" sky (nil = unknown)
}

local function cfg()
	return Config.Sky
end

local function attr(key)
	return cfg().Attr[key]
end

local function now()
	return Workspace:GetServerTimeNow()
end

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function hasFn(m, name)
	return type(m) == "table" and type(m[name]) == "function"
end

local function get(key, default)
	local v = Workspace:GetAttribute(attr(key))
	if v == nil then
		return default
	end
	return v
end

local function set(key, value)
	Workspace:SetAttribute(attr(key), value)
end

local function loopLength()
	local total = 0
	for _, phase in ipairs(cfg().Cycle.Order) do
		total = total + cfg().Cycle.Seconds[phase]
	end
	return total
end

-- a loop position in [0, loop)
local function wrap(pos)
	local loop = loopLength()
	local w = pos - math.floor(pos / loop) * loop
	if not finite(w) or w < 0 or w >= loop then
		return 0
	end
	return w
end

-- the published clock: epoch, speed, offset (finite numbers, whatever someone wrote into the attributes)
local function clock()
	local epoch = get("Epoch", 0)
	local speed = get("Speed", cfg().Speed.Default)
	local offset = get("Offset", 0)
	if not finite(epoch) then
		epoch = 0
	end
	if not finite(speed) then
		speed = cfg().Speed.Default
	end
	if not finite(offset) then
		offset = 0
	end
	return epoch, math.max(cfg().Speed.Min, math.min(cfg().Speed.Max, speed)), offset
end

-- the loop position right now (the same sum SkyCycle.At takes)
local function position()
	local epoch, speed, offset = clock()
	return wrap((now() - epoch) * speed + offset)
end

----------------------------------------------------------------------
-- The clock
----------------------------------------------------------------------

function SkyService.Status()
	local epoch, speed, offset = clock()
	local at = SkyCycle.At(now(), epoch, speed, offset)
	local length = cfg().Cycle.Seconds[at.Phase] or 0
	return {
		Phase = at.Phase, Next = at.Next, T = at.T, Blend = at.Blend, LoopT = at.LoopT,
		Seconds = at.T * length, Length = length, Speed = speed, Offset = offset,
		Event = get("Event", ""), Source = St.source,
	}
end

function SkyService.SetPhase(name)
	if type(name) ~= "string" then
		return false, "name a phase"
	end
	local want = string.lower(name)
	local start = 0
	for _, phase in ipairs(cfg().Cycle.Order) do
		if string.lower(phase) == want then
			local epoch, speed = clock()
			-- a hair into the phase, so float rounding never lands on the end of the one before
			set("Offset", wrap(start + 0.001 - (now() - epoch) * speed))
			return true, phase
		end
		start = start + cfg().Cycle.Seconds[phase]
	end
	return false, "unknown phase " .. string.sub(name, 1, 16)
end

function SkyService.SetSpeed(x)
	if not finite(x) then
		return false, "the speed must be a number"
	end
	local s = cfg().Speed
	local speed = math.max(s.Min, math.min(s.Max, x))
	local pos = position()
	local epoch = clock()
	set("Speed", speed)
	set("Offset", wrap(pos - (now() - epoch) * speed)) -- the loop goes on from where it is
	return true, speed
end

----------------------------------------------------------------------
-- The raid sky
----------------------------------------------------------------------

-- an exact Config.Sky.RaidThemes boss id, or a unique prefix of one (any case)
function SkyService.Find(word)
	if type(word) ~= "string" or word == "" then
		return nil
	end
	local w = string.lower(word)
	local themes = cfg().RaidThemes
	if themes[w] then
		return w
	end
	local found = nil
	for id in pairs(themes) do
		if string.sub(id, 1, #w) == w then
			if found then
				return nil -- more than one boss starts like that
			end
			found = id
		end
	end
	return found
end

function SkyService.SetEvent(bossId, source, battleId)
	if type(bossId) ~= "string" or cfg().RaidThemes[bossId] == nil then
		return false, "no raid sky for " .. tostring(bossId)
	end
	St.source = source == "dev" and "dev" or "raid"
	St.battleId = battleId
	if get("Event", "") ~= bossId then
		set("Event", bossId)
		set("EventAt", now())
	end
	return true, bossId
end

function SkyService.ClearEvent()
	St.source = nil
	St.battleId = nil
	if get("Event", "") ~= "" then
		set("Event", "")
		set("EventAt", now())
	end
	return true
end

-- a raid ended: clear unless the end names another raid than the one whose sky is up
local function raidEnded(battleId)
	if get("Event", "") == "" then
		return
	end
	if battleId ~= nil and St.battleId ~= nil and battleId ~= St.battleId then
		return -- the late end of the raid before; the current raid's sky stays
	end
	SkyService.ClearEvent()
end

local function onEventStarted(kind, info)
	if kind ~= "BossRaid" or type(info) ~= "table" then
		return
	end
	SkyService.SetEvent(info.BossId, "raid", info.BattleId)
end

local function onEventEnded(kind, info)
	if kind ~= "BossRaid" then
		return
	end
	raidEnded(type(info) == "table" and info.BattleId or nil)
end

local function onBattleEnded(battleId, result)
	if type(result) ~= "table" or result.Mode ~= "Raid" then
		return
	end
	raidEnded(battleId)
end

-- the raid status is the truth for raid skies; dev previews are left alone
local function watch()
	local bs = St.battle
	if St.source == "dev" or not hasFn(bs, "GetRaidStatus") then
		return
	end
	local status = bs.GetRaidStatus()
	local live = type(status) == "table" and status.Active ~= false and type(status.BossId) == "string"
	if live and cfg().RaidThemes[status.BossId] ~= nil then
		if get("Event", "") ~= status.BossId then
			SkyService.SetEvent(status.BossId, "raid", status.BattleId)
		end
	elseif get("Event", "") ~= "" then
		SkyService.ClearEvent()
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

local function wire(signal, handler)
	if type(signal) ~= "table" or not hasFn(signal, "Connect") or St.wired[signal] then
		return
	end
	St.wired[signal] = true
	signal:Connect(function(...)
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[SkyService] " .. tostring(err))
		end
	end)
end

function SkyService.Init(deps)
	deps = type(deps) == "table" and deps or {}
	local es, bs = deps.EventService, deps.BattleService
	if type(es) == "table" then
		wire(es.EventStarted, onEventStarted)
		wire(es.EventEnded, onEventEnded)
	end
	if type(bs) == "table" then
		wire(bs.BattleEnded, onBattleEnded)
		St.battle = bs
	end
	if St.initialized then
		return
	end
	St.initialized = true
	local t = now()
	set("Epoch", t)
	set("Speed", cfg().Speed.Default)
	set("Offset", 0)
	set("Event", "")
	set("EventAt", t)
	task.spawn(function()
		while true do
			task.wait(cfg().EventWatch)
			local ok, err = pcall(watch)
			if not ok then
				warn("[SkyService] watchdog: " .. tostring(err))
			end
		end
	end)
end

return SkyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1114">
          <Properties>
            <string name="Name">SpotService</string>
            <string name="Source"><![CDATA[-- SpotService: the home plots on the outer lobby ring (one per player, claimed with E at the gate).
--
-- * Claiming (ARCHITECTURE_V3.md "Phase 2: Tycoon homes"; replaces the v2 auto-assignment): nobody gets a plot on
--   join. Each free plot's gate carries a "Claim Home" ProximityPrompt (HomeBuilder builds it, TycoonService handles
--   it and calls SpotService.Claim). One plot per player, refused during a match; the plot is the player's for the
--   session and is released when they leave (TycoonService clears the build, the gate reads "Claim Home" again).
--   The claimed index is mirrored on the player attribute Config.Attr.SpotIndex (absent while the player has no
--   plot) and remembered in Profile.SpotIndex as the player's LAST plot: a returning player whose last plot is free
--   gets the side toast "Welcome back! Press E at your gate", everyone else "Pick a free home: press E at its gate".
-- * Nameplate (LobbyBuilder builds it: a compact PIXEL-sized tag, World text rule): NameLabel = the owner's display
--   name, SubLabel = "Home Level 12 <bullet> 2 stars" (the Home Level and the Prestige stars in words; kit-b U7b: no
--   star glyph),
--   refreshed whenever the home changes; the avatar disc shows the owner's headshot (Players:GetUserThumbnailAsync in
--   pcall, cached per user; the silhouette built from frames is the fallback). Free plots read "Free home" /
--   "Press E at the gate" with a "+" on the disc.
-- * Showcase podium: the owner's best pet (highest rarity, then the better tier: Rainbow > Golden > Normal, then an
--   equipped copy) stands on the podium by the gate with a small name / rarity tag. Pet keys (shared/PetKeys) are
--   understood: a Golden copy or a fused hybrid is built from PetKeys.DefOf. The model is rebuilt only when that
--   pet changes. Replication rule: the server builds it standing still (every part Anchored) and tags it
--   "NC_Showcase" (attributes PetId = the key, PetParts, HoverAmp, Ready); ShowcaseController on each CLIENT welds it
--   locally and hovers / sways / animates it. The server never moves it.
-- * Remotes.GoToSpot (rate limited, refused during a match and in a battle: Phase 4 safe zones): opens the player's
--   home portal (TycoonService.OpenHomePortal: it leads home when the player has a plot, otherwise to the gate of
--   their last plot when it is free, else of the nearest free plot); without TycoonService it teleports directly.
-- * Teleport(player) (TycoonService's portal, the Home tile): home when the player has a plot, otherwise in front of
--   the suggested free gate. Refused during a match, in a battle or ring run (the InBattle attribute) and while dead.
--
-- Public API: Init(lobbyInfo, deps)  GetSpot(player) -> SpotInfo|nil (the CLAIMED plot)  Teleport(player) -> boolean
-- Phase 2 (used by TycoonService; the plot data stays here):
--   Claim(player, index) -> ok, reason        validated: a known plot, free, the player has none, not in a match
--   Release(player) -> index|nil               frees the player's plot (also automatic on leave)
--   GetOwner(index) -> Player|nil, GetSpotByIndex(index) -> SpotInfo|nil, GetSpots() -> { [index] = SpotInfo }
--   FindFreeSpot(position|nil, preferIndex|nil) -> SpotInfo|nil   the preferred plot when free, else the free plot
--                                              nearest to `position` (the lowest index without one)
--   SuggestSpot(player) -> SpotInfo|nil, owned  the claimed plot, else the last plot when free, else the nearest free
--   GateCFrame(spotInfo) -> CFrame              the gate on the ground (LookVector = towards the street)
--   Signals Claimed (player, index), Released (player, index)
-- Extra: Refresh(player) (re-reads the profile now; normally automatic).
-- deps = { DataService = , PetService = }.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local SpotService = {}
SpotService.Claimed = Util.Signal() -- Fire(player, index)
SpotService.Released = Util.Signal() -- Fire(player, index)

-- "\226\128\162" = bullet (escaped so the file stays plain ASCII).
local BULLET = "\226\128\162"

local FREE_NAME = "Free home"
local FREE_SUB = "Press E at the gate"

-- Showcase tag (World text rule): pixel-sized, names >= 22 px, info >= 18 px, a compact stone card (kit B).
local TAG_W, TAG_H = 300, 96
local TAG_NAME_PX = 26
local TAG_RARITY_PX = 18
local TAG_RANGE = 80
local TAG_LIFT = -1.2 -- studs: the plate's bottom edge sits ~0.7 stud over the highest point of the bob
local WorldTag = require(Shared.WorldTag) -- (Pitch 2 item 04 B) the podium tag as a kit B stone card
local Sign = Theme.Sign
-- the stone card (px at 1080p): its wood edge and lip, the paddings, the rarity block (its edge outside it)
local TAG = { Edge = 3, Lip = 5, PadX = 16, PadTop = 6, Gap = 3, PadBottom = 5, PillEdge = 2, PillLip = 3, PillPad = 10, MinW = 120 }

local SHOWCASE_SCALE = 1.4 -- the podium pet is a bit larger than a follower
local SHOWCASE_TAG = "NC_Showcase" -- ShowcaseController (client) hovers / sways / animates every model with this tag
local HOVER_HEIGHT = 0.9 -- studs between the podium top and the pet's lowest point (the client bobs it +/- HoverAmp)
local BOB_HEIGHT = 0.35 -- studs, +/-: the client's hover amplitude (attribute HoverAmp)
local TIER_ORDER = { Normal = 1, Golden = 2, Rainbow = 3 } -- a better tier wins a rarity tie on the podium
local REFRESH_INTERVAL = 1 -- seconds between profile signature checks
local PROFILE_WAIT = 20 -- give up waiting for a profile after this many seconds
local REMOTE_COOLDOWN = 0.25 -- per player per remote
local HEADSHOT_RETRY = 120 -- seconds before a failed headshot request may be tried again
local WELCOME_DELAY = 4 -- seconds after the profile loaded before the "press E at your gate" toast
-- (quick wins, review round 1) the welcome's "press E" lines are onboarding: a player still on the title screen keeps
-- them however long they wait (NotifyController's hold drops other toasts older than 60 s)
local WELCOME_OPTS = { Keep = true }
local GATE_OUTSIDE = 6 -- studs in front of the gate (street side) where GoToSpot puts a player without a plot
local GATE_LIFT = 3 -- studs above the ground for that placement (the character's root height)
local ATTR_IN_BATTLE = Config.Attr.InBattle or "InBattle" -- BattleService's player attribute (the battle id)
local BATTLE_TEXT = "Finish your battle first!" -- the Arena Gate's refusal text (Phase 4 safe zones)

local initialized = false
local running = false
local dataService = nil
local petService = nil
local spots = {} -- [index] = SpotInfo
local spotCount = 0
local owners = {} -- [index] = Player
local spotOf = {} -- [Player] = index
local conns = {} -- [Player] = { RBXScriptConnection... }
local shows = {} -- [index] = showcase record (see makeShow)
local lastSig = {} -- [index] = last nameplate signature
local lastGo = {} -- [Player] = os.clock() of the last GoToSpot
local welcomed = {} -- [Player] = true once the join toast was scheduled
local headshots = {} -- [userId] = content string : the GetUserThumbnailAsync cache
local headshotFailed = {} -- [userId] = os.clock() of the last failed request (retried after HEADSHOT_RETRY)
local headshotPending = {} -- [userId] = true while a request runs
local refreshQueued = {} -- [Player] = true while a deferred refresh is pending
local notifyRemote = nil
local departed = setmetatable({}, { __mode = "k" }) -- [Player] = true once PlayerRemoving ran

local rarityOrder = {}
local rarityColor = {}
for _, r in ipairs(Config.Rarities or {}) do
	rarityOrder[r.Id] = r.Order or 0
	rarityColor[r.Id] = r.Color
end

----------------------------------------------------------------------
-- Optional shared modules (PetBuilder / PetCatalog are written by other agents)
----------------------------------------------------------------------

local sharedCache = {} -- [name] = module | false

local function loadShared(name)
	local cached = sharedCache[name]
	if cached ~= nil then
		return cached or nil
	end
	sharedCache[name] = false
	local module = Shared:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			sharedCache[name] = result
			return result
		end
		warn("[SpotService] could not load " .. name .. ": " .. tostring(result))
	end
	return nil
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

-- opts (optional): the Notify remote's 4th argument (NotifyController: Keep = true survives the title screen's toast hold)
local function notify(player, text, kind, seconds, opts)
	if not player or not player.Parent then
		return
	end
	if not notifyRemote then
		local ok, remote = pcall(Remotes.Get, "Notify")
		if ok then
			notifyRemote = remote
		end
	end
	if notifyRemote then
		pcall(function()
			if opts ~= nil then
				notifyRemote:FireClient(player, text, kind or "info", seconds or 3, opts)
			else
				notifyRemote:FireClient(player, text, kind or "info", seconds or 3)
			end
		end)
	end
end

local function getProfile(player)
	if dataService and type(dataService.GetProfile) == "function" then
		local ok, profile = pcall(dataService.GetProfile, player)
		if ok and type(profile) == "table" then
			return profile
		end
	end
	return nil
end

-- Phase 4 safe zones: no teleport may pull a player out of a battle or a Champion Ring run (X18).
local function inBattle(player)
	local v = player:GetAttribute(ATTR_IN_BATTLE)
	return v ~= nil and v ~= false and v ~= ""
end

-- TycoonService (a sibling module; it may be absent in a trimmed build): the home portal.
local tycoonCache = nil
local function tycoonService()
	if tycoonCache ~= nil then
		return tycoonCache or nil
	end
	tycoonCache = false
	local module = script.Parent and script.Parent:FindFirstChild("TycoonService")
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			tycoonCache = result
			return result
		end
	end
	return nil
end

local function displayNameOf(player)
	local name = player.DisplayName
	if type(name) ~= "string" or name == "" then
		name = player.Name
	end
	return name
end

local function setText(label, text)
	if not label then
		return
	end
	pcall(function()
		label.Text = text
	end)
end

local function setLabels(index, name, sub)
	local info = spots[index]
	if not info then
		return
	end
	setText(info.NameLabel, name)
	setText(info.SubLabel, sub)
end

-- The nameplate's avatar disc (built by LobbyBuilder; a nameplate without one is simply left alone).
local function avatarOf(index)
	local info = spots[index]
	if not info then
		return nil
	end
	local gui = info.Nameplate
	if typeof(gui) ~= "Instance" and typeof(info.NameLabel) == "Instance" then
		gui = info.NameLabel:FindFirstAncestorOfClass("BillboardGui")
	end
	if typeof(gui) ~= "Instance" then
		return nil
	end
	local disc = gui:FindFirstChild("Avatar", true)
	if disc and disc:IsA("GuiObject") then
		return disc
	end
	return nil
end

-- mode: "Free" (the "+"), "Owned" (silhouette) or "Headshot" (image = the thumbnail content).
local function setAvatar(index, mode, image)
	local disc = avatarOf(index)
	if not disc then
		return
	end
	pcall(function()
		local color = disc:GetAttribute(mode == "Free" and "FreeColor" or "OwnedColor")
		if typeof(color) == "Color3" then
			disc.BackgroundColor3 = color
		end
		local shot = disc:FindFirstChild("Headshot")
		local silhouette = disc:FindFirstChild("Silhouette")
		local free = disc:FindFirstChild("FreeIcon")
		if free then
			free.Visible = mode == "Free"
		end
		if silhouette then
			silhouette.Visible = mode == "Owned"
		end
		if shot then
			shot.Image = (mode == "Headshot" and image) or ""
			shot.Visible = mode == "Headshot"
		end
	end)
end

-- Shows the owner's headshot on their nameplate: cached per user, fetched once in the background (the call
-- yields and fails for Studio test players, so the silhouette stays as the fallback).
local function loadHeadshot(player, index)
	local userId = player.UserId
	local cached = headshots[userId]
	if cached then
		setAvatar(index, "Headshot", cached)
		return
	end
	local failedAt = headshotFailed[userId]
	if headshotPending[userId] or (failedAt and os.clock() - failedAt < HEADSHOT_RETRY) then
		return
	end
	headshotPending[userId] = true
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		headshotPending[userId] = nil
		if ok and type(content) == "string" and content ~= "" then
			headshots[userId] = content
			headshotFailed[userId] = nil
		else
			headshotFailed[userId] = os.clock()
			return
		end
		-- wherever this user owns a home now: matched by UserId, so a player who left and rejoined while the
		-- request ran (a new Player object) still gets it; a home freed meanwhile keeps its "+"
		for index, owner in pairs(owners) do
			if owner.UserId == userId and owner.Parent then
				setAvatar(index, "Headshot", content)
			end
		end
	end)
end

-- Pivot a character somewhere and kill its momentum.
local function placeCharacter(char, cframe)
	if not char or not char.Parent then
		return false
	end
	local ok = pcall(function()
		char:PivotTo(cframe)
	end)
	if not ok then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
	return true
end

----------------------------------------------------------------------
-- Showcase podium
----------------------------------------------------------------------

-- The tag floating above the pet (World text rule): a PIXEL-sized BillboardGui, so it reads the same at any
-- distance. (Pitch 2 item 04_world_ui, the owner's pick B "Stone tags", modelled on WorldStyle.BuildTag: the navy gradient
-- capsule, its rounded rarity pill and the outlined letters went) ONE stone card (shared/WorldTag: the Stone face, a 3 px
-- mitred wood edge, a 5 px lip in the rarity's colour, WorldTag.LipOf) with the pet name in the kit's ink over a small
-- square rarity block tinted in the rarity's colour (WorldTag.Tint), sized from the measured texts (tag.Layout, called
-- after the texts are written). Its bottom edge sits just over the bobbing pet.
local function tagLabel(parent, name, text, role, size, z)
	local label = WorldTag.Text(parent, name, text, role, size, Sign.Text, {
		AnchorPoint = Vector2.new(0.5, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = z,
	})
	label:SetAttribute("KitRole", role)
	return label
end

local function lineW(label)
	return math.ceil(Theme.Measure(label.Text, label:GetAttribute("KitRole") or "Body", label.TextSize).X)
end

local function buildTag(info)
	local anchor = Instance.new("Part")
	anchor.Name = "ShowcaseAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.CFrame = CFrame.new(info.PodiumCFrame.Position + Vector3.new(0, 6, 0))

	local gui = Instance.new("BillboardGui")
	gui.Name = "ShowcaseTag"
	gui.Adornee = anchor
	gui.Size = UDim2.fromOffset(TAG_W, TAG_H)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the bottom edge sits on the anchor (+ TAG_LIFT)
	gui.StudsOffsetWorldSpace = Vector3.new(0, TAG_LIFT, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = TAG_RANGE
	gui.LightInfluence = 0
	gui.ClipsDescendants = false
	gui.Enabled = false

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.new(0.5, 0, 1, -TAG.Edge) -- raised by its edge (a BillboardGui clips what lies outside it)
	card.Size = UDim2.fromOffset(TAG.MinW, 0)
	card.ZIndex = 2
	card.Parent = gui
	local _, lip = WorldTag.Block(card, Sign.Stone, Sign.StoneLip, Sign.Wood, TAG.Edge, TAG.Lip)

	local nameLabel = tagLabel(card, "PetName", "", "Title", TAG_NAME_PX, 3)

	local pill = Instance.new("Frame")
	pill.Name = "RarityPill"
	pill.AnchorPoint = Vector2.new(0.5, 0)
	pill.ZIndex = 3
	pill.Parent = card
	WorldTag.Block(pill, Sign.Stone, Sign.StoneLip, Sign.Wood, TAG.PillEdge, TAG.PillLip)
	local rarityLabel = tagLabel(pill, "PetRarity", "", "Heading", TAG_RARITY_PX, 4)
	rarityLabel.AnchorPoint = Vector2.new(0, 0)
	rarityLabel.Position = UDim2.fromOffset(0, 0)
	rarityLabel.Size = UDim2.new(1, 0, 1, -TAG.PillLip)

	-- the name over the rarity block, the card as wide as the wider needs (never under MinW): minimum width a short hybrid
	-- name ("Draar" + "Mythic") still gets a card that hugs it
	local function layout()
		local nameH = TAG_NAME_PX + 4
		local nw = lineW(nameLabel)
		local pw = lineW(rarityLabel) + 2 * TAG.PillPad
		local ph = TAG_RARITY_PX + 4 + TAG.PillLip
		local w = math.max(TAG.MinW, nw + 2 * TAG.PadX, pw + 2 * TAG.PillEdge + 2 * TAG.PadX)
		local y = TAG.PadTop
		nameLabel.Position = UDim2.new(0.5, 0, 0, y)
		nameLabel.Size = UDim2.fromOffset(nw, nameH)
		y = y + nameH + TAG.Gap
		pill.Position = UDim2.new(0.5, 0, 0, y + TAG.PillEdge)
		pill.Size = UDim2.fromOffset(pw, ph)
		y = y + ph + 2 * TAG.PillEdge
		card.Size = UDim2.fromOffset(w, y + TAG.PadBottom + TAG.Lip)
	end
	-- (no Text listener: the tag is kept for the server's life and only showPet writes it, then calls Layout; final_checks
	-- allows the pet name's one caps listener per tag and no more)
	layout()

	anchor.Parent = info.Folder or workspace
	gui.Parent = anchor
	return {
		Anchor = anchor,
		Gui = gui,
		NameLabel = nameLabel,
		RarityLabel = rarityLabel,
		RarityPill = pill,
		Lip = lip,
		Layout = layout,
	}
end

-- the tag shows a pet: its name over its rarity, the rarity's colour on the card's lip (WorldTag.LipOf) and on the rarity
-- block (WorldTag.Tint: a light face of the colour, its lip the colour itself, the text kept in ink, so even the dark
-- Secret reads); the card hugs the new texts (tag.Layout)
local function paintTag(tag, def, key)
	local color = rarityColor[def.Rarity] or Sign.StoneLip
	tag.NameLabel.Text = tostring(def.DisplayName or def.Name or key)
	tag.RarityLabel.Text = tostring(def.Rarity or "")
	if tag.Layout then
		tag.Layout()
	end
	if tag.Lip then
		tag.Lip.BackgroundColor3 = WorldTag.LipOf(color)
	end
	WorldTag.Tint(tag.RarityPill, color)
	tag.Gui.Enabled = true
end
-- (tools/dump_gui.lua worldui:lobby renders the podium tag as the server builds and paints it)
SpotService._Tag = { Build = buildTag, Paint = paintTag }

local function makeShow(index)
	local info = spots[index]
	local show = {
		Index = index,
		PetId = nil, -- the pet key on the podium
		Model = nil,
		Tag = nil,
	}
	local ok, tag = pcall(buildTag, info)
	if ok then
		show.Tag = tag
	else
		warn("[SpotService] could not build the showcase tag: " .. tostring(tag))
	end
	return show
end

local function clearShowModel(show)
	if show.Model then
		pcall(function()
			show.Model:Destroy()
		end)
		show.Model = nil
	end
	if show.Tag and show.Tag.Gui then
		show.Tag.Gui.Enabled = false
	end
end

-- Builds + places the podium pet: `key` is the pet key (nil = empty podium), `def` its def (PetKeys.DefOf or the
-- catalog). The model stands still on the server; the client animates it (SHOWCASE_TAG, see the header).
local function setShowcasePet(index, key, def, stage)
	local show = shows[index]
	local info = spots[index]
	if not show or not info then
		return
	end
	stage = (type(stage) == "number" and stage == stage and stage >= 1) and math.floor(stage) or 0
	if show.PetId == key and (show.Stage or 0) == stage then
		return
	end
	clearShowModel(show)
	show.PetId = key
	show.Stage = stage
	if not key or type(def) ~= "table" then
		return
	end

	local builder = loadShared("PetBuilder")
	if not builder or type(builder.Build) ~= "function" then
		return
	end
	-- Phase 5 (3.7): the podium draws the pet's STORED evolution stage; an evolved model is always built at Low
	local opts = { Detail = "High", Scale = SHOWCASE_SCALE }
	if stage >= 1 then
		opts.Detail = "Low"
		opts.Evolved = (stage >= 2) and 2 or 1
	end
	local podium = info.PodiumCFrame
	-- the finished, placed podium pet (not parented) and its height, or nil
	local function buildShow()
		local okBuild, model = pcall(builder.Build, def, opts)
		if not okBuild or typeof(model) ~= "Instance" then
			warn("[SpotService] PetBuilder.Build failed for " .. tostring(key) .. ": " .. tostring(model))
			return nil, 3
		end

		-- Visual only: nothing may collide, be touched or be hit by raycasts; every part Anchored (the client welds).
		local parts = 0
		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				inst.Anchored = true
				inst.CanCollide = false
				inst.CanTouch = false
				inst.CanQuery = false
				parts = parts + 1
			end
		end

		-- Measure the model at the origin: how far its lowest point sits below the pivot, and its height.
		local bottomOffset = 1.2
		local height = 3
		local okBox = pcall(function()
			model:PivotTo(CFrame.new(0, 0, 0))
			local boxCf, boxSize = model:GetBoundingBox()
			local pivotY = model:GetPivot().Position.Y
			bottomOffset = pivotY - (boxCf.Position.Y - boxSize.Y * 0.5)
			height = boxSize.Y
		end)
		if not okBox and type(builder.GetHeight) == "function" then
			local okH, h = pcall(builder.GetHeight, def)
			if okH and type(h) == "number" then
				height = h * SHOWCASE_SCALE
				bottomOffset = height * 0.5
			end
		end

		-- facing the street like the podium, hovering a little over it (the client bobs it by HoverAmp)
		local rest = podium.Position + Vector3.new(0, HOVER_HEIGHT + bottomOffset, 0)
		model.Name = "ShowcasePet"
		model:PivotTo(CFrame.new(rest) * (podium - podium.Position))
		model:SetAttribute("PetId", key)
		model:SetAttribute("PetParts", parts)
		model:SetAttribute("PB_Evolved", stage)
		model:SetAttribute("HoverAmp", BOB_HEIGHT)
		model:SetAttribute("Ready", true)
		pcall(function()
			CollectionService:AddTag(model, SHOWCASE_TAG)
			CollectionService:AddTag(model, "NC_StyleExempt") -- a pet: WorldStyle.Tags.Exempt (the 6.4 material audit skips it)
		end)
		return model, height
	end
	local model, height = buildShow()
	if not model then
		return
	end
	show.Model = model
	model.Parent = info.Folder or workspace
	-- Phase 6: the mesh pet replaces this Part build once its keys load after boot (MeshLibrary.Swap: same name and
	-- place, re-tagged, so the clients' ShowcaseController picks it up); show.Model follows. Empty MeshIds = nothing.
	if type(builder.SwapWhenReady) == "function" then
		pcall(builder.SwapWhenReady, model, def, opts, function()
			return (buildShow())
		end, function(fresh, old)
			if show.Model == old then
				show.Model = fresh
			end
		end)
	end

	-- Tag: name + rarity, floating above the highest point of the bob.
	local tag = show.Tag
	if tag then
		tag.Anchor.CFrame = CFrame.new(podium.Position + Vector3.new(0, HOVER_HEIGHT + height + BOB_HEIGHT + 1.9, 0))
		paintTag(tag, def, key)
	end
end

----------------------------------------------------------------------
-- Nameplate + best pet
----------------------------------------------------------------------

-- Every owned pet copy as { Key, Def }: PetKeys (tiers + hybrids) when it is there, else the plain Pets counts.
local function ownedPets(profile)
	local out = {}
	if type(profile) ~= "table" then
		return out
	end
	local keys = loadShared("PetKeys")
	if keys and type(keys.List) == "function" and type(keys.DefOf) == "function" then
		local ok, list = pcall(keys.List, profile)
		if ok and type(list) == "table" then
			for _, key in ipairs(list) do
				local okDef, def = pcall(keys.DefOf, key, profile)
				if okDef and type(def) == "table" then
					out[#out + 1] = { Key = key, Def = def }
				end
			end
			return out
		end
	end
	local catalog = loadShared("PetCatalog")
	if not catalog or type(catalog.Get) ~= "function" or type(profile.Pets) ~= "table" then
		return out
	end
	for petId, count in pairs(profile.Pets) do
		if type(count) == "number" and count > 0 then
			local def = catalog.Get(petId)
			if def then
				out[#out + 1] = { Key = petId, Def = def }
			end
		end
	end
	return out
end

-- Highest rarity wins; ties prefer the better tier, then equipped copies, then the key (so the choice is stable).
-- Returns key, def (nil when the owner has no pet).
local function pickBestPet(profile)
	local equipped = {}
	if type(profile) == "table" and type(profile.Equipped) == "table" then
		for _, key in ipairs(profile.Equipped) do
			if type(key) == "string" then
				equipped[key] = true
			end
		end
	end
	local best, bestRank = nil, nil
	for _, entry in ipairs(ownedPets(profile)) do
		local def = entry.Def
		local rank = {
			rarityOrder[def.Rarity] or 0,
			TIER_ORDER[def.Tier] or 1,
			equipped[entry.Key] and 1 or 0,
		}
		local better = false
		if not bestRank then
			better = true
		else
			for i = 1, #rank do
				if rank[i] ~= bestRank[i] then
					better = rank[i] > bestRank[i]
					break
				end
				if i == #rank then
					better = tostring(entry.Key) < tostring(best.Key)
				end
			end
		end
		if better then
			best, bestRank = entry, rank
		end
	end
	if best then
		return best.Key, best.Def
	end
	return nil, nil
end

local function wholeNumber(v, maxValue)
	if type(v) ~= "number" or v ~= v or v < 0 then
		return 0
	end
	if v == math.huge then
		return maxValue
	end
	return math.min(math.floor(v), maxValue)
end

-- Home Level + Prestige stars of a profile's Home (the live table: read only).
local function homeStatsOf(profile)
	local home = profile and profile.Home
	if type(home) ~= "table" then
		return 0, 0
	end
	local level = nil
	local catalog = loadShared("TycoonCatalog")
	if catalog and type(catalog.HomeLevelOf) == "function" then
		local ok, value = pcall(catalog.HomeLevelOf, home)
		if ok and type(value) == "number" then
			level = value
		end
	end
	if level == nil then
		level = home.Level
	end
	return wholeNumber(level, 100000), wholeNumber(home.Prestige, 100000)
end

-- "Home Level 12" / "Home Level 12 <bullet> 1 star" / "Home Level 3 <bullet> 7 stars" (kit-b U7b: the Prestige stars
-- in words, no emoji on a world sign)
local function homeLine(level, stars)
	local text = "Home Level " .. tostring(level)
	if stars > 0 then
		text = text .. " " .. BULLET .. " " .. tostring(stars) .. (stars == 1 and " star" or " stars")
	end
	return text
end

-- Re-reads one owner's profile; touches the labels / podium only when something changed.
local function refreshSpot(index)
	local owner = owners[index]
	if not owner or not owner.Parent then
		return
	end
	local profile = getProfile(owner)
	local level, stars = homeStatsOf(profile)
	local bestKey, bestDef = pickBestPet(profile)
	local name = displayNameOf(owner)
	local stage = 0
	if bestKey and dataService and type(dataService.GetEvolution) == "function" then
		local okE, e = pcall(dataService.GetEvolution, owner, bestKey)
		if okE and type(e) == "number" and e == e and e >= 1 then
			stage = math.floor(e)
		end
	end

	local sig = name .. "|" .. tostring(level) .. "|" .. tostring(stars) .. "|" .. tostring(bestKey) .. "|" .. tostring(stage)
	if lastSig[index] == sig then
		return
	end
	lastSig[index] = sig
	setLabels(index, name, homeLine(level, stars))
	setShowcasePet(index, bestKey, bestDef, stage)
end

function SpotService.Refresh(player)
	local index = player and spotOf[player]
	if index then
		refreshSpot(index)
	end
end

-- Several changes in one frame produce a single refresh.
local function queueRefresh(player)
	if refreshQueued[player] then
		return
	end
	refreshQueued[player] = true
	task.defer(function()
		refreshQueued[player] = nil
		if player.Parent then
			SpotService.Refresh(player)
		end
	end)
end

local function refreshLoop()
	while running do
		task.wait(REFRESH_INTERVAL)
		if not running then
			break
		end
		for index = 1, spotCount do
			if owners[index] then
				local ok, err = pcall(refreshSpot, index)
				if not ok then
					warn("[SpotService] refresh failed: " .. tostring(err))
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Gates, free plots
----------------------------------------------------------------------

local function validIndex(index)
	return type(index) == "number" and index == index and index == math.floor(index) and spots[index] ~= nil
end

-- The gate on the ground (LookVector = towards the street): SpotInfo.GateCFrame, else derived from the plot.
function SpotService.GateCFrame(info)
	if type(info) ~= "table" then
		return nil
	end
	if typeof(info.GateCFrame) == "CFrame" then
		return info.GateCFrame
	end
	if typeof(info.PlotCFrame) == "CFrame" then
		local size = tonumber(info.PlotSize) or Config.Lobby.PlotSize or 72
		return info.PlotCFrame * CFrame.new(0, 0, -size / 2)
	end
	return nil
end

-- Where a player without a plot is put: just outside the gate (street side), facing into the yard.
local function gateArrivalCFrame(info)
	local gate = SpotService.GateCFrame(info)
	if not gate then
		return info and info.SpawnCFrame or nil
	end
	local pos = (gate * CFrame.new(0, GATE_LIFT, -GATE_OUTSIDE)).Position
	local inward = -gate.LookVector
	local flat = Vector3.new(inward.X, 0, inward.Z)
	if flat.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + flat.Unit)
end

local function gatePosition(info)
	local gate = SpotService.GateCFrame(info)
	if gate then
		return gate.Position
	end
	if typeof(info.Center) == "Vector3" then
		return info.Center
	end
	if typeof(info.SpawnCFrame) == "CFrame" then
		return info.SpawnCFrame.Position
	end
	return nil
end

function SpotService.FindFreeSpot(position, preferIndex)
	if validIndex(preferIndex) and not owners[preferIndex] then
		return spots[preferIndex]
	end
	local best, bestDist = nil, math.huge
	for index = 1, spotCount do
		local info = spots[index]
		if info and not owners[index] then
			if typeof(position) ~= "Vector3" then
				return info -- the lowest free index
			end
			local at = gatePosition(info)
			local d = at and (at - position).Magnitude or math.huge
			if d < bestDist then
				best, bestDist = info, d
			end
		end
	end
	return best
end

local function lastSpotIndex(player)
	local profile = getProfile(player)
	local wanted = profile and profile.SpotIndex
	if validIndex(wanted) then
		return wanted
	end
	return nil
end

function SpotService.SuggestSpot(player)
	if not player then
		return nil, false
	end
	local index = spotOf[player]
	if index then
		return spots[index], true
	end
	local root = Util.GetRoot(player)
	return SpotService.FindFreeSpot(root and root.Position or nil, lastSpotIndex(player)), false
end

----------------------------------------------------------------------
-- Claim / release
----------------------------------------------------------------------

local function freeSpot(player)
	refreshQueued[player] = nil
	local list = conns[player]
	conns[player] = nil
	if list then
		for _, conn in ipairs(list) do
			conn:Disconnect()
		end
	end
	local index = spotOf[player]
	spotOf[player] = nil
	if not index then
		return nil
	end
	if owners[index] == player then
		owners[index] = nil
	end
	lastSig[index] = nil
	if player.Parent then
		pcall(function()
			player:SetAttribute(Config.Attr.SpotIndex, nil)
		end)
	end
	local info = spots[index]
	if info and info.Folder then
		pcall(function()
			info.Folder:SetAttribute("OwnerUserId", nil)
		end)
	end
	if shows[index] then
		setShowcasePet(index, nil)
	end
	setLabels(index, FREE_NAME, FREE_SUB)
	setAvatar(index, "Free")
	return index
end

function SpotService.Claim(player, index)
	if not initialized then
		return false, "Homes are not ready yet"
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent or departed[player] then
		return false, "Not in the game"
	end
	if not validIndex(index) then
		return false, "Unknown home"
	end
	if spotOf[player] then
		if spotOf[player] == index then
			return false, "This is already your home"
		end
		return false, "You already have a home"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "Finish your match first"
	end
	local owner = owners[index]
	if owner then
		if owner.Parent then
			return false, "This home belongs to " .. displayNameOf(owner)
		end
		freeSpot(owner) -- a stale owner (left without PlayerRemoving): free it now
	end

	owners[index] = player
	spotOf[player] = index
	lastSig[index] = nil
	pcall(function()
		player:SetAttribute(Config.Attr.SpotIndex, index)
	end)
	local info = spots[index]
	if info and info.Folder then
		pcall(function()
			info.Folder:SetAttribute("OwnerUserId", player.UserId)
		end)
	end

	-- remember the LAST plot (the welcome-back toast offers it again next time)
	local profile = getProfile(player)
	if profile and profile.SpotIndex ~= index then
		profile.SpotIndex = index
		if dataService and type(dataService.MarkDirty) == "function" then
			pcall(dataService.MarkDirty, player)
		end
	end

	if not shows[index] then
		shows[index] = makeShow(index)
	end
	setAvatar(index, "Owned")
	loadHeadshot(player, index)

	local list = {}
	conns[player] = list
	table.insert(list, player:GetAttributeChangedSignal(Config.Attr.EquippedPets):Connect(function()
		queueRefresh(player)
	end))
	refreshSpot(index)
	SpotService.Claimed:Fire(player, index)
	return true, nil
end

function SpotService.Release(player)
	if not player then
		return nil
	end
	local index = freeSpot(player)
	if index then
		SpotService.Released:Fire(player, index)
	end
	return index
end

----------------------------------------------------------------------
-- Join / leave
----------------------------------------------------------------------

local function hasProfile(player)
	if not dataService or type(dataService.GetProfile) ~= "function" then
		return true -- nothing to wait for
	end
	return getProfile(player) ~= nil
end

-- The join toast (side toast, never centred): the last plot when it is still free, any free gate otherwise.
local function scheduleWelcome(player)
	if welcomed[player] or not player.Parent or departed[player] then
		return
	end
	welcomed[player] = true
	task.delay(WELCOME_DELAY, function()
		if not player.Parent or departed[player] or spotOf[player] then
			return
		end
		local last = lastSpotIndex(player)
		if last and not owners[last] then
			notify(player, "Welcome back! Press E at your gate (#" .. tostring(last) .. ").", "info", 6, WELCOME_OPTS)
		elseif SpotService.FindFreeSpot(nil, nil) then
			notify(player, "Pick a free home: press E at its gate!", "info", 6, WELCOME_OPTS)
		else
			notify(player, "Every home is taken right now.", "info", 6)
		end
	end)
end

-- Waits (bounded) for the player's profile, then schedules the welcome toast. ProfileLoaded usually wins.
local function onPlayerAdded(player)
	task.spawn(function()
		local waited = 0
		while player.Parent and not hasProfile(player) and waited < PROFILE_WAIT do
			task.wait(0.25)
			waited = waited + 0.25
		end
		if player.Parent then
			scheduleWelcome(player)
		end
	end)
end

local function onPlayerRemoving(player)
	departed[player] = true
	lastGo[player] = nil
	welcomed[player] = nil
	SpotService.Release(player)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function SpotService.GetSpot(player)
	local index = player and spotOf[player]
	if index then
		return spots[index]
	end
	return nil
end

function SpotService.GetOwner(index)
	local owner = validIndex(index) and owners[index] or nil
	if owner and owner.Parent then
		return owner
	end
	return nil
end

function SpotService.GetSpotByIndex(index)
	if validIndex(index) then
		return spots[index]
	end
	return nil
end

function SpotService.GetSpots()
	return spots
end

-- Pivots the character home (claimed plot) or, without a plot, to the gate of the suggested free plot.
-- Ignored during a match, in a battle or ring run (Phase 4 safe zones) and while dead. Returns true when the
-- character was moved.
function SpotService.Teleport(player)
	if not player or not player.Parent then
		return false
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false
	end
	if inBattle(player) then
		return false
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local info = SpotService.GetSpot(player)
	if info and typeof(info.SpawnCFrame) == "CFrame" then
		return placeCharacter(player.Character, info.SpawnCFrame)
	end
	local free = SpotService.SuggestSpot(player)
	local target = free and gateArrivalCFrame(free)
	if typeof(target) ~= "CFrame" then
		return false
	end
	return placeCharacter(player.Character, target)
end

local function onGoToSpot(player)
	local now = os.clock()
	local last = lastGo[player]
	if last and now - last < REMOTE_COOLDOWN then
		return
	end
	lastGo[player] = now
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return
	end
	if inBattle(player) then
		notify(player, BATTLE_TEXT, "bad", 3)
		return
	end
	if not spotOf[player] and not SpotService.SuggestSpot(player) then
		notify(player, "Every home is taken right now.", "bad", 3)
		return
	end
	-- Phase 4: the Home tile opens the home portal (home, or toward a free gate); it teleports only when the
	-- owner walks in (TycoonService's 0.2 s loop). Without TycoonService the old direct teleport stays.
	local tycoon = tycoonService()
	if tycoon and type(tycoon.OpenHomePortal) == "function" then
		local ok, opened = pcall(tycoon.OpenHomePortal, player)
		if ok and opened ~= nil then
			return
		end
	end
	local moved = SpotService.Teleport(player)
	if moved and not spotOf[player] then
		notify(player, "Press E at the gate to claim this home!", "info", 4)
	end
end

function SpotService.Init(lobbyInfo, deps)
	if initialized then
		return
	end
	initialized = true
	deps = deps or {}
	dataService = deps.DataService
	petService = deps.PetService

	local list = lobbyInfo and lobbyInfo.Spots
	if type(list) ~= "table" then
		warn("[SpotService] lobbyInfo.Spots is missing; spots are disabled")
		list = {}
	end
	for index, info in pairs(list) do
		if type(index) == "number" and type(info) == "table" and typeof(info.SpawnCFrame) == "CFrame"
			and typeof(info.PodiumCFrame) == "CFrame" then
			spots[index] = info
			if index > spotCount then
				spotCount = index
			end
		end
	end
	for index = 1, spotCount do
		if spots[index] then
			setLabels(index, FREE_NAME, FREE_SUB)
			setAvatar(index, "Free")
		end
	end

	-- Join toast once the profile is there (no auto-assignment: plots are claimed with E at the gate).
	if dataService and dataService.ProfileLoaded and type(dataService.ProfileLoaded.Connect) == "function" then
		dataService.ProfileLoaded:Connect(function(player)
			if player and player.Parent then
				scheduleWelcome(player)
			end
		end)
	end
	-- Pet changes show up on the podium immediately.
	if petService and petService.PerksChanged and type(petService.PerksChanged.Connect) == "function" then
		petService.PerksChanged:Connect(function(player)
			if player and player.Parent then
				queueRefresh(player)
			end
		end)
	end
	-- Phase 5 (3.7): an EVOLVE rebuilds the podium pet in its evolved look (PetCareService.Evolved; its signal exists at
	-- module load, so the require here is safe before its Init)
	local careModule = script.Parent and script.Parent:FindFirstChild("PetCareService")
	if careModule then
		local okCare, care = pcall(require, careModule)
		if okCare and type(care) == "table" and care.Evolved and type(care.Evolved.Connect) == "function" then
			care.Evolved:Connect(function(player)
				if player and player.Parent then
					queueRefresh(player)
				end
			end)
		end
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	local okRemote, goRemote = pcall(Remotes.Get, "GoToSpot")
	if okRemote and goRemote then
		goRemote.OnServerEvent:Connect(onGoToSpot)
	else
		warn("[SpotService] GoToSpot remote unavailable")
	end

	running = true
	task.spawn(refreshLoop)
	game:BindToClose(function()
		running = false
	end)
end

return SpotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1115">
          <Properties>
            <string name="Name">StoreService</string>
            <string name="Source"><![CDATA[-- StoreService (store 2026-11-04; docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.1 / 5.4 / 7): the Robux
-- Store's server half: the ONE grant path of a paid receipt (ApplyGrant), the game-pass cache, the purchase prompt
-- behind StoreRequest and the StorePreview flag. GemService keeps MarketplaceService.ProcessReceipt and routes every
-- receipt here through StoreCatalog.ProductById; the client reads only the three attributes Multipliers writes.
--
-- * ApplyGrant(player, item, purchaseId) -> ok, granted: non-yielding, CHECK then WRITE. The ONLY false is "profile
--   not loaded or provisional" (GemService answers NotProcessedYet and Roblox retries). A PAID receipt is never eaten
--   (Z7): a pet whose stack is full pays its rarity's Config.Index.Rewards[r].Tokens instead ("Stack full: +2,000
--   Tokens instead", recorded in granted.Substitute and added to granted.Tokens), a potion extends past the 7-day cap
--   (the cap only dims the card), a Once pack bought before is granted again with a warn. `granted` = what was REALLY
--   given: { Cash, Tokens, Gems, Pets = {[id] = n}, Boost = {[id] = seconds}, Substitute = {[id] = tokens} }
--   (GemService hands it to DataService.NoteReceiptGrant: the twin rule of the cross-server merge).
-- * Thank(player, item, granted, purchaseId): the "Thank you! <GrantLines joined by ', '>" toast (the client plays
--   StoreBuy on a text starting with "Thank you") and Purchased:Fire, once per purchase, called by GemService when the
--   purchase is granted for good (the save landed; in Studio also after a failed save).
-- * Passes (Z3): on join every Pass with Id > 0 is asked ONCE with pcall(MarketplaceService:UserOwnsGamePassAsync); a
--   failure keeps "Checking" (fail closed) and is retried after 5 / 15 / 45 / 120 s, then every 300 s. true -> Owned +
--   DataService.MarkPassSeen. PromptGamePassPurchaseFinished(player, id, true) is only a HINT (release step 1
--   follow-up): an exploit client can fire that signal itself, so it alone never marks a pass Owned, never writes the
--   ledger and never thanks. It starts a confirmation: UserOwnsGamePassAsync now and again after 2 / 5 / 15 / 45 s
--   (PASS_CONFIRM; Roblox may answer from its ownership cache for a while after a real purchase); the first true
--   answer marks Owned, writes the ledger and thanks once. Never confirmed -> nothing is granted and the normal
--   ownership check (the next join's lookup) decides. One confirmation per pass at a time, however often it fires. With
--   Config.Store.TrustLedgerAfter > 0, that many seconds of failures let the stored Store.Passes ledger count as Owned
--   (0 = never). Owns / PassState read THIS server's cache only; the attributes are written, never read back.
-- * StoreRequest ("Buy", key): a live player, a string key, 1 request/s, refused in a match ("The Store is closed
--   during a match"), for an Id 0 item (preview or not), a bought Once pack or an owned pass ("You already have
--   that!"), a Once pack while the save loads or is provisional ("Your save is still loading": GetStore answers nil,
--   undecidable), a Product that grants Tokens (Tokens1..3, the Pro Pack; lobby-shop 16.1: a token spin can give a
--   Secret) unless GemService.PolicyState is "Allowed" ("Token packs are not available on your account" when Restricted,
--   else "Checking your account, try again in a moment" and the policy lookup is kicked; checked before the 1 s prompt
--   cooldown); else PromptPurchase -> PromptGamePassPurchase / PromptProductPurchase. A prompt never grants (Z1), and
--   the lock never touches the grant path: a paid receipt is always granted.
-- * StoreRequest ("GemBuy", key) (lobby shop 2026-11-07, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.8 / 7):
--   BuyWithGems sells a Config.Store.GemItems item (the 30-minute XP Potion for 100 gems). "Buy" and "GemBuy" share the
--   one 1 s gap; any other action, or a key that is not a string, is dropped before it (no answer). Checks, in order: a
--   live player and a gem item (else false, no toast); in a match; the save loading or provisional ("Your save is still
--   loading"); not GemsSettled ("Your data is still loading": the server-hop guard); the PetXp2x pass "Owned" ("You
--   already have x2 Pet XP") or "Checking" ("Checking your passes..."; "NotOwned" / "Unavailable" buy); the potion bank
--   plus the item's seconds past Config.Store.Potion.CapSeconds ("Your potion time is full"); gems short ("Not enough
--   gems"). Then ONE non-yielding step: DataService.SpendGems, then DataService.AddBoost (its refusals were all checked
--   first, so it cannot refuse after the charge); the toast "XP Potion: +30 minutes" and Changed after it (pcall). Every
--   refusal toasts (bad). Restricted accounts may buy (a potion is not random). No receipt, no purchase id.
-- * XpPassState: the player attribute = PassState(player, "PetXp2x"), written at the join and on every Changed when it
--   differs from the last written value (the shop's potion label reads it; never read back).
-- * The Store switch (release step 1; Config.Store.Enabled through StoreCatalog.Enabled / OnSale, read on every call):
--   while it is off, PromptPurchase answers false ("That item is not on sale yet", no toast, no prompt) for every item
--   but a gem pack (Config.Gems.Products: what the live game already sold), BuyWithGems answers false before any check
--   (no charge, no toast) and StorePreview is false for everyone. ApplyGrant, Thank, the pass lookups and
--   PromptGamePassPurchaseFinished never read the switch: a paid receipt and an owned pass are always honoured.
-- * StorePreview: written once at the join, true in Studio (RunService:IsStudio()) or for DevService.IsAllowed(player)
--   (may yield once: a task.spawn), never on a timer.
--
-- Public API
--   StoreService.Init(deps)                       deps = { DataService, PetService, DevService? } (GemService: a lazy require)
--   StoreService.ApplyGrant(player, item, purchaseId) -> ok, granted | reason    (non-yielding)
--   StoreService.Thank(player, item, granted, purchaseId)   the thank-you toast + Purchased, once
--   StoreService.PromptPurchase(player, key) -> ok, reason
--   StoreService.BuyWithGems(player, key) -> ok, reason     a Config.Store.GemItems key (non-yielding; toasts its answer)
--   StoreService.Owns(player, key) -> bool                  this server's cache only (Z3)
--   StoreService.PassState(player, key) -> "Owned" | "NotOwned" | "Checking" | "Unavailable"
--   StoreService.IsPreview(player) -> bool
--   StoreService.BoostEnds(player, id) -> unix seconds | 0
--   StoreService.Refresh(player)                  fires Changed (Multipliers rewrites the attributes)
--   StoreService.Purchased   Util.Signal Fire(player, key, granted, purchaseId)   once per purchase, after the save that lands
--   StoreService.Changed     Util.Signal Fire(player)   after any ownership / bought / boost change and every pass answer
--
-- Plain Lua 5.1-compatible syntax only. Nothing here yields between a check and its write.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local MarketplaceService = game:GetService("MarketplaceService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local StoreCatalog = require(Shared.StoreCatalog)

local StoreService = {}
StoreService.Purchased = Util.Signal() -- Fire(player, key, granted, purchaseId)
StoreService.Changed = Util.Signal() -- Fire(player)

local REQUEST_REMOTE = "StoreRequest"
local REQUEST_GAP = 1 -- seconds between two StoreRequests of one player
local PROMPT_COOLDOWN = 1 -- seconds between two purchase prompts of one player
local PASS_RETRY = { 5, 15, 45, 120 } -- seconds before the retries of a failed pass lookup...
local PASS_RETRY_LATER = 300 -- ...then every this many seconds
local PASS_TICK = 1 -- the retry loop looks for due lookups this often
local PASS_CONFIRM = { 2, 5, 15, 45 } -- seconds before each further UserOwnsGamePassAsync after a "purchase finished" signal that was not confirmed
local THANKS_SECONDS = 5
local GEM_POTION = { Id = "XpPotion", Pass = "PetXp2x" } -- the boost a gem item sells and the pass that makes it pointless
local TEXT = {
	Match = "The Store is closed during a match",
	Have = "You already have that!",
	Unknown = "That item is not in the Store",
	NotYet = "That item is not on sale yet",
	Wait = "Please wait a moment",
	Window = "The purchase window could not open",
	Loading = "Your save is still loading",
	StackFull = "Stack full: +%s Tokens instead",
	-- lobby shop: StoreRequest("GemBuy") -> BuyWithGems
	Settling = "Your data is still loading",
	HavePass = "You already have x2 Pet XP",
	Checking = "Checking your passes...",
	Full = "Your potion time is full",
	Poor = "Not enough gems",
	PotionGot = "XP Potion: +%d minutes",
	-- lobby-shop 16.1: the token-grant lock (a token spin can give a Secret now)
	TokensLocked = "Token packs are not available on your account",
	TokensChecking = "Checking your account, try again in a moment",
}

local S = {
	DS = nil,
	PS = nil,
	Dev = nil,
	Passes = {}, -- [player] = { [key] = { State = "Checking"|"Owned"|"NotOwned", Busy, Fails, NextTry, FirstFail } }
	Preview = {}, -- [player] = bool (the computed flag; the attribute is only written)
	PromptAt = {}, -- [player] = os.clock() of the last purchase prompt
	LastCall = {}, -- [player] = { [key] = os.clock() }
	PassAttr = {}, -- [player] = the XpPassState value last written (the attribute is never read back)
	Warned = {}, -- [key] = true: one warning per problem per server
	Started = false,
}
StoreService._S = S

----------------------------------------------------------------------
-- helpers (the GemService shapes; its locals are not reachable from here)
----------------------------------------------------------------------
local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function wholeNumber(n)
	if not isFinite(n) or n ~= math.floor(n) then
		return nil
	end
	return n
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function warnOnce(key, text)
	if S.Warned[key] then
		return
	end
	S.Warned[key] = true
	warn(text)
end

local function rateLimited(player, key, interval)
	local record = S.LastCall[player]
	if not record then
		record = {}
		S.LastCall[player] = record
	end
	local now = os.clock()
	local last = record[key]
	if last and now - last < interval then
		return true
	end
	record[key] = now
	return false
end

local function notify(player, text, kind, duration)
	local ok, remote = pcall(Remotes.Get, "Notify")
	if ok and remote and isPlayer(player) then
		remote:FireClient(player, text, kind or "info", duration or 3)
	end
end

local function storeConfig()
	return type(Config.Store) == "table" and Config.Store or {}
end

local function attrName(key)
	local name = Config.Attr and Config.Attr[key]
	return type(name) == "string" and name or nil
end

-- the Pass items of the catalog (Config order), read on every call: the owner pastes ids, tests change them
local function passItems()
	local out = {}
	for _, item in ipairs(StoreCatalog.List()) do
		if item.Kind == "Pass" then
			out[#out + 1] = item
		end
	end
	return out
end

local function passItem(key)
	for _, item in ipairs(passItems()) do
		if item.Key == key then
			return item
		end
	end
	return nil
end

-- the stored Store record (a copy), or nil until loaded / while provisional
local function storeOf(player)
	local DS = S.DS
	if not DS or type(DS.GetStore) ~= "function" then
		return nil
	end
	local ok, store = pcall(DS.GetStore, player)
	if ok and type(store) == "table" then
		return store
	end
	return nil
end

local function rarityTokens(petId)
	local ok, catalog = pcall(function()
		return require(Shared.PetCatalog)
	end)
	local def = ok and type(catalog) == "table" and type(catalog.Get) == "function" and catalog.Get(petId) or nil
	local rewards = type(Config.Index) == "table" and type(Config.Index.Rewards) == "table" and Config.Index.Rewards or {}
	local entry = def and rewards[def.Rarity] or nil
	local tokens = type(entry) == "table" and wholeNumber(entry.Tokens) or nil
	return tokens and tokens > 0 and tokens or 0
end

----------------------------------------------------------------------
-- The grant (one non-yielding step after GemService marked the receipt)
----------------------------------------------------------------------
function StoreService.ApplyGrant(player, item, purchaseId)
	if not isPlayer(player) then
		return false, "Player unavailable"
	end
	if type(item) ~= "table" or type(item.Grants) ~= "table" then
		return false, "Unknown item"
	end
	local DS = S.DS
	if not DS or type(DS.GetProfile) ~= "function" then
		return false, TEXT.Loading
	end
	local profile = DS.GetProfile(player)
	if not profile or (type(DS.IsProvisional) == "function" and DS.IsProvisional(player) == true) then
		return false, TEXT.Loading
	end
	local grants = item.Grants
	local granted = {}
	local cash = wholeNumber(grants.Cash)
	if cash and cash >= 1 and type(DS.AddCash) == "function" and DS.AddCash(player, cash) then
		granted.Cash = cash
	end
	local tokens = wholeNumber(grants.Tokens)
	if tokens and tokens >= 1 and type(DS.AddTokens) == "function" then
		DS.AddTokens(player, tokens)
		granted.Tokens = tokens
	end
	local gems = wholeNumber(grants.Gems)
	if gems and gems >= 1 and type(DS.AddGems) == "function" and DS.AddGems(player, gems) then
		granted.Gems = gems
	end
	if type(grants.Pets) == "table" then
		local PS = S.PS
		for petId, spec in pairs(grants.Pets) do
			local count = type(spec) == "table" and wholeNumber(spec.Count) or 1
			local level = type(spec) == "table" and spec.Level or nil
			if count and count >= 1 then
				local given = 0
				if PS and type(PS.GrantPet) == "function" then
					local ok, result = PS.GrantPet(player, petId, { Count = count, Level = level })
					if ok and type(result) == "table" then
						given = wholeNumber(result.Granted) or 0
					elseif result ~= "Stack full" then
						warnOnce("pet-" .. tostring(petId), "[StoreService] could not grant pet " .. tostring(petId) .. " of " .. tostring(item.Key) .. ": " .. tostring(result))
					end
				else
					warnOnce("no-petservice", "[StoreService] PetService.GrantPet is missing: pets of a pack are paid as Tokens")
				end
				if given > 0 then
					granted.Pets = granted.Pets or {}
					granted.Pets[petId] = given
				end
				local left = count - given
				if left > 0 then
					-- Z7: the stack is full: the rarity's Index Tokens instead, per copy (a paid receipt is never eaten)
					local sub = rarityTokens(petId) * left
					if sub > 0 and type(DS.AddTokens) == "function" then
						DS.AddTokens(player, sub)
						granted.Tokens = (granted.Tokens or 0) + sub
						granted.Substitute = granted.Substitute or {}
						granted.Substitute[petId] = sub
					end
				end
			end
		end
	end
	if type(grants.Boost) == "table" and type(DS.AddBoost) == "function" then
		for id, seconds in pairs(grants.Boost) do
			local secs = wholeNumber(seconds)
			if type(id) == "string" and secs and secs >= 1 then
				local ok = DS.AddBoost(player, id, secs) -- past the cap too: the cap only dims the card
				if ok then
					granted.Boost = granted.Boost or {}
					granted.Boost[id] = secs
				end
			end
		end
	end
	if item.Once and type(DS.MarkBought) == "function" then
		if not DS.MarkBought(player, item.Key) then
			warn("[StoreService] " .. tostring(item.Key) .. " was bought before: Roblox sold it again (receipt " .. tostring(purchaseId) .. "), granted again (Z7)")
		end
	end
	StoreService.Changed:Fire(player)
	return true, granted
end

-- the GrantLines table of what was really granted (pets with the pack's Level for the "(Lv n)" text)
local function linesOf(item, granted)
	local lines = {}
	if type(granted) ~= "table" then
		return lines
	end
	if type(granted.Pets) == "table" then
		local pets = {}
		for petId, n in pairs(granted.Pets) do
			local spec = type(item.Grants) == "table" and type(item.Grants.Pets) == "table" and item.Grants.Pets[petId] or nil
			pets[petId] = { Count = n, Level = type(spec) == "table" and spec.Level or nil }
		end
		lines.Pets = pets
	end
	lines.Cash, lines.Tokens, lines.Gems, lines.Boost = granted.Cash, granted.Tokens, granted.Gems, granted.Boost
	if item.Kind == "Pass" and type(item.Grants) == "table" then
		lines.Perks = item.Grants.Perks
	end
	return lines
end

function StoreService.Thank(player, item, granted, purchaseId)
	if type(item) ~= "table" then
		return
	end
	local text = "Thank you! " .. table.concat(StoreCatalog.GrantLines(linesOf(item, granted)), ", ")
	notify(player, text, "good", THANKS_SECONDS)
	if type(granted) == "table" and type(granted.Substitute) == "table" then
		for _ , tokens in pairs(granted.Substitute) do
			notify(player, string.format(TEXT.StackFull, Util.Commas(tokens)), "info", THANKS_SECONDS)
		end
	end
	StoreService.Purchased:Fire(player, item.Key, granted, purchaseId)
end

----------------------------------------------------------------------
-- Passes
----------------------------------------------------------------------
local function passMap(player)
	local map = S.Passes[player]
	if not map then
		map = {}
		S.Passes[player] = map
	end
	return map
end

-- the ledger rule: Checking for TrustLedgerAfter seconds of failures with the pass in the stored Store.Passes = Owned
local function ledgerTrusted(player, entry, key)
	local after = tonumber(storeConfig().TrustLedgerAfter) or 0
	if after <= 0 or entry.State ~= "Checking" or not entry.FirstFail or os.clock() - entry.FirstFail < after then
		return false
	end
	local store = storeOf(player)
	return store ~= nil and type(store.Passes) == "table" and store.Passes[key] ~= nil
end

local function setOwned(player, key)
	local entry = passMap(player)[key]
	if not entry then
		entry = { State = "Checking", Busy = false, Fails = 0 }
		passMap(player)[key] = entry
	end
	entry.State = "Owned"
	entry.NextTry = nil
	if S.DS and type(S.DS.MarkPassSeen) == "function" then
		pcall(S.DS.MarkPassSeen, player, key)
	end
end

-- A "purchase finished" signal waits on this pass (entry.Confirm, onPassFinished) and a lookup was just answered:
-- Owned -> the thank-you, once, and the confirmation is over; else the next try is booked (PASS_CONFIRM), and after the
-- last one the confirmation is dropped: nothing was granted, the normal ownership check decides from here (a failed
-- lookup keeps the failure ladder's NextTry set above; the next join asks again).
local function confirmStep(player, key, entry)
	if not entry.Confirm then
		return
	end
	if entry.State == "Owned" then
		entry.Confirm = nil
		local item = passItem(key)
		if item then
			StoreService.Thank(player, item, { Perks = item.Grants and item.Grants.Perks }, nil)
		end
		return
	end
	entry.Confirm.Tries = entry.Confirm.Tries + 1
	local wait = PASS_CONFIRM[entry.Confirm.Tries]
	if wait then
		entry.NextTry = os.clock() + wait
	else
		entry.Confirm = nil
	end
end

-- One lookup (yields inside the MarketplaceService call). A failure keeps the state and schedules a retry.
local function lookupPass(player, key, id)
	local entry = passMap(player)[key]
	if not entry or entry.Busy then
		return
	end
	entry.Busy = true
	local ok, owns = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, id)
	end)
	entry.Busy = false
	if S.Passes[player] == nil or S.Passes[player][key] ~= entry or player.Parent ~= Players then
		return
	end
	if ok then
		entry.Fails = 0
		entry.FirstFail = nil
		entry.NextTry = nil
		if owns == true then
			setOwned(player, key)
		elseif entry.State ~= "Owned" then
			entry.State = "NotOwned"
		end
	else
		entry.Fails = entry.Fails + 1
		entry.FirstFail = entry.FirstFail or os.clock()
		entry.NextTry = os.clock() + (PASS_RETRY[entry.Fails] or PASS_RETRY_LATER)
		warnOnce("pass-fail", "[StoreService] UserOwnsGamePassAsync failed (" .. tostring(owns) .. "): passes stay unowned for that player until a retry succeeds")
	end
	confirmStep(player, key, entry)
	StoreService.Changed:Fire(player)
end

local function startPasses(player)
	local map = passMap(player)
	for _, item in ipairs(passItems()) do
		if item.Created and not map[item.Key] then
			map[item.Key] = { State = "Checking", Busy = false, Fails = 0, NextTry = nil, FirstFail = nil }
			task.spawn(lookupPass, player, item.Key, item.Id)
		end
	end
end

-- One loop for every retry and the ledger rule (no thread per player, nothing left behind when players leave).
local function passLoop()
	while true do
		task.wait(PASS_TICK)
		local now = os.clock()
		local due, trusted = {}, {}
		for player, map in pairs(S.Passes) do
			for key, entry in pairs(map) do
				if not entry.Busy and entry.NextTry and now >= entry.NextTry then
					due[#due + 1] = { player, key }
				end
				if ledgerTrusted(player, entry, key) then
					trusted[#trusted + 1] = { player, key }
				end
			end
		end
		for _, pair in ipairs(trusted) do
			local player, key = pair[1], pair[2]
			if player.Parent == Players then
				setOwned(player, key)
				StoreService.Changed:Fire(player)
			end
		end
		for _, pair in ipairs(due) do
			local player, key = pair[1], pair[2]
			local entry = S.Passes[player] and S.Passes[player][key]
			local item = passItem(key)
			if entry and item and item.Created and player.Parent == Players then
				entry.NextTry = nil
				task.spawn(lookupPass, player, key, item.Id)
			end
		end
	end
end

function StoreService.PassState(player, key)
	local item = passItem(key)
	if not item or not item.Created then
		return "Unavailable"
	end
	if not isPlayer(player) then
		return "Checking"
	end
	local entry = S.Passes[player] and S.Passes[player][key]
	if not entry then
		return "Checking"
	end
	if entry.State == "Checking" and ledgerTrusted(player, entry, key) then
		setOwned(player, key)
		StoreService.Changed:Fire(player)
	end
	return entry.State
end

function StoreService.Owns(player, key)
	return StoreService.PassState(player, key) == "Owned"
end

function StoreService.IsPreview(player)
	return isPlayer(player) and S.Preview[player] == true
end

function StoreService.BoostEnds(player, id)
	local store = isPlayer(player) and storeOf(player) or nil
	local ends = store and type(store.Boosts) == "table" and store.Boosts[id] or nil
	if isFinite(ends) and ends > 0 then
		return ends
	end
	return 0
end

function StoreService.Refresh(player)
	if isPlayer(player) then
		StoreService.Changed:Fire(player)
	end
end

-- The XpPassState attribute (lobby shop: the gem potion label) = PassState(player, "PetXp2x"), written when it differs from
-- the value last written. Called at the join and on every Changed (every pass answer fires Changed). Never read back.
local function writePassAttr(player)
	local attr = attrName("XpPassState")
	if not attr or not isPlayer(player) then
		return
	end
	local state = StoreService.PassState(player, GEM_POTION.Pass)
	if S.PassAttr[player] ~= state then
		S.PassAttr[player] = state
		player:SetAttribute(attr, state)
	end
end

----------------------------------------------------------------------
-- The prompt (never a grant: Z1)
----------------------------------------------------------------------

-- lobby-shop 16.1: why a Product that grants Cloud Tokens (Tokens1..3, the Pro Pack) cannot be prompted for this
-- account, or nil. Only GemService.PolicyState "Allowed" opens it (a token spin can give a Secret now: a paid random
-- item); no GemService, an error or any other answer is unknown ("Checking", fail closed) and kicks the policy lookup
-- (GemService.SecretRouletteState asks again when the answer is still unknown). The grant path never reads this.
local function tokenLock(player, item)
	local grants = item.Kind == "Product" and type(item.Grants) == "table" and item.Grants or nil
	local tokens = grants and wholeNumber(grants.Tokens) or nil
	if not tokens or tokens <= 0 then
		return nil
	end
	local inst = script.Parent:FindFirstChild("GemService") -- a lazy require: GemService requires nothing of ours at load
	local okReq, gems = false, nil
	if inst then
		okReq, gems = pcall(require, inst)
	end
	gems = okReq and type(gems) == "table" and gems or nil
	local okState, state = false, nil
	if gems and type(gems.PolicyState) == "function" then
		okState, state = pcall(gems.PolicyState, player)
	end
	if okState and state == "Allowed" then
		return nil
	elseif okState and state == "Restricted" then
		return TEXT.TokensLocked
	end
	if gems and type(gems.SecretRouletteState) == "function" then
		pcall(gems.SecretRouletteState, player)
	end
	return TEXT.TokensChecking
end

function StoreService.PromptPurchase(player, key)
	if not isPlayer(player) then
		return false, "Player unavailable"
	end
	if type(key) ~= "string" then
		return false, TEXT.Unknown
	end
	local inMatch = attrName("InMatch")
	if inMatch and player:GetAttribute(inMatch) == true then
		return false, TEXT.Match
	end
	local item = StoreCatalog.Item(key)
	if not item then
		return false, TEXT.Unknown
	end
	if not StoreCatalog.OnSale(item) then
		return false, TEXT.NotYet -- the Store switch is off (Config.Store.Enabled): only a gem pack is prompted, like Id 0 no toast
	end
	if not item.Created then
		return false, TEXT.NotYet -- Id 0: hidden, preview or not (Z12)
	end
	if item.Kind == "Pass" then
		if StoreService.Owns(player, key) then
			return false, TEXT.Have
		end
	elseif item.Once then
		-- nil = loading or provisional: undecidable, not unbought (a stand-in profile must never sell a bought pack again)
		local store = storeOf(player)
		if not store then
			return false, TEXT.Loading
		end
		if type(store.Bought) == "table" and store.Bought[key] ~= nil then
			return false, TEXT.Have -- Z6: a bought item is never prompted
		end
	end
	local locked = tokenLock(player, item) -- before the cooldown: a refused token pack takes no prompt slot
	if locked then
		return false, locked
	end
	local now = os.clock()
	local last = S.PromptAt[player]
	if last and now - last < PROMPT_COOLDOWN then
		return false, TEXT.Wait
	end
	S.PromptAt[player] = now
	local ok, err = pcall(function()
		if item.Kind == "Pass" then
			MarketplaceService:PromptGamePassPurchase(player, item.Id)
		else
			MarketplaceService:PromptProductPurchase(player, item.Id)
		end
	end)
	if not ok then
		warnOnce("prompt", "[StoreService] the purchase prompt failed: " .. tostring(err))
		return false, TEXT.Window
	end
	return true
end

----------------------------------------------------------------------
-- Gem items (lobby shop 2026-11-07, spec 5.8 / 7): one non-yielding step, every refusal decided before the charge
----------------------------------------------------------------------

-- Why a gem buy of `price` gems for `seconds` of potion time cannot happen now, or nil. It decides every refusal of the
-- step in BuyWithGems too: SpendGems (the balance) and AddBoost (loaded, not provisional, a valid id, whole seconds).
local function gemRefusal(player, price, seconds)
	local inMatch = attrName("InMatch")
	if inMatch and player:GetAttribute(inMatch) == true then
		return TEXT.Match
	end
	local DS = S.DS
	local api = DS and type(DS.GetProfile) == "function" and type(DS.IsProvisional) == "function" and type(DS.GemsSettled) == "function"
		and type(DS.GetGems) == "function" and type(DS.SpendGems) == "function" and type(DS.AddGems) == "function" and type(DS.AddBoost) == "function"
	if not api or DS.GetProfile(player) == nil or DS.IsProvisional(player) == true then
		return TEXT.Loading
	end
	if DS.GemsSettled(player) ~= true then
		return TEXT.Settling -- the server-hop guard (spec 5.2): another server's gem spend may not be in yet
	end
	local pass = StoreService.PassState(player, GEM_POTION.Pass)
	if pass == "Owned" then
		return TEXT.HavePass -- the potion would add nothing
	elseif pass == "Checking" then
		return TEXT.Checking -- a pass owner must not pay for nothing while the lookup runs or fails
	end
	local potion = storeConfig().Potion
	local cap = type(potion) == "table" and wholeNumber(potion.CapSeconds) or 7 * 86400
	local now = os.time()
	if math.max(StoreService.BoostEnds(player, GEM_POTION.Id), now) + seconds - now > cap then
		return TEXT.Full
	end
	local gems = DS.GetGems(player)
	if not isFinite(gems) or gems < price then
		return TEXT.Poor
	end
	return nil
end

function StoreService.BuyWithGems(player, key)
	if not isPlayer(player) then
		return false, "Player unavailable"
	end
	if not StoreCatalog.Enabled() then
		return false, TEXT.NotYet -- the Store switch is off: a gem item is not shown, so no charge and no toast
	end
	local item = StoreCatalog.GemItem(key)
	local boost = item and type(item.Grants) == "table" and type(item.Grants.Boost) == "table" and item.Grants.Boost or nil
	local seconds = boost and wholeNumber(boost[GEM_POTION.Id]) or nil
	local price = item and wholeNumber(item.Gems) or nil
	if not seconds or seconds < 1 or not price or price < 1 then
		return false, TEXT.Unknown -- not a gem item: no toast
	end
	local reason = gemRefusal(player, price, seconds)
	if reason then
		notify(player, reason, "bad", 3)
		return false, reason
	end
	-- the one step (no yield): the charge, then the potion time; gemRefusal decided both, so neither refuses now
	local DS = S.DS
	if not DS.SpendGems(player, price) then
		notify(player, TEXT.Poor, "bad", 3)
		return false, TEXT.Poor
	end
	if not DS.AddBoost(player, GEM_POTION.Id, seconds) then
		DS.AddGems(player, price) -- unreachable (see gemRefusal); the gems are never kept for nothing
		warnOnce("gem-boost", "[StoreService] AddBoost refused after the gem charge: the gems were given back")
		notify(player, TEXT.Loading, "bad", 3)
		return false, TEXT.Loading
	end
	pcall(notify, player, string.format(TEXT.PotionGot, math.floor(seconds / 60)), "good", 3)
	pcall(StoreService.Changed.Fire, StoreService.Changed, player) -- Multipliers rewrites XpBoostEnds
	return true
end

local function onRequest(player, action, key)
	if not isPlayer(player) or (action ~= "Buy" and action ~= "GemBuy") or type(key) ~= "string" then
		return -- junk: nothing, no answer, the gap untouched
	end
	if rateLimited(player, REQUEST_REMOTE, REQUEST_GAP) then
		return -- one 1 s gap for "Buy" and "GemBuy" together
	end
	if action == "GemBuy" then
		StoreService.BuyWithGems(player, key) -- it toasts its own answer (an unknown key stays silent)
		return
	end
	local ok, reason = StoreService.PromptPurchase(player, key)
	if not ok and reason and reason ~= TEXT.Unknown and reason ~= TEXT.NotYet then
		notify(player, tostring(reason), "bad", 3)
	end
end

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------
local function setPreview(player)
	-- the Store switch off: no preview either (no PREVIEW card or row for a dev while the Store is hidden)
	local on = StoreCatalog.Enabled()
	local preview = on and RunService:IsStudio()
	if on and not preview and S.Dev and type(S.Dev.IsAllowed) == "function" then
		local ok, allowed = pcall(S.Dev.IsAllowed, player) -- may yield once (a group-owned game)
		preview = ok and allowed == true
	end
	if player.Parent ~= Players then
		return
	end
	S.Preview[player] = preview
	local attr = attrName("StorePreview")
	if attr then
		player:SetAttribute(attr, preview)
	end
end

local function onPlayerAdded(player)
	if not isPlayer(player) then
		return
	end
	startPasses(player)
	writePassAttr(player)
	task.spawn(setPreview, player)
end

local function onPlayerRemoving(player)
	S.Passes[player] = nil
	S.Preview[player] = nil
	S.PromptAt[player] = nil
	S.LastCall[player] = nil
	S.PassAttr[player] = nil
end

local function onPassFinished(player, id, wasPurchased)
	if wasPurchased ~= true or not isPlayer(player) then
		return
	end
	local item = StoreCatalog.PassById(id)
	if not item then
		return
	end
	-- Release step 1 follow-up: the signal is a hint, never a grant (an exploit client can fire it). Owned, the ledger
	-- and the thank-you come only from UserOwnsGamePassAsync answering true (lookupPass -> setOwned, confirmStep).
	local map = passMap(player)
	local entry = map[item.Key]
	if not entry then
		entry = { State = "Checking", Busy = false, Fails = 0, NextTry = nil, FirstFail = nil }
		map[item.Key] = entry
	end
	if entry.State == "Owned" or entry.Confirm then
		return -- owned already, or a confirmation is running: a repeated (or forged) signal costs no further lookup
	end
	entry.Confirm = { Tries = 0 }
	if not entry.Busy then
		task.spawn(lookupPass, player, item.Key, item.Id) -- (a lookup in flight answers first: confirmStep books the next try)
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function checkConfig()
	local ok, problems = StoreCatalog.Validate()
	if not ok then
		for _, problem in ipairs(problems or {}) do
			warn("[StoreService] Config.Store: " .. tostring(problem))
		end
	end
	local onSale, total = 0, 0
	for _, item in ipairs(StoreCatalog.List()) do
		if not item.Gem then
			total = total + 1
			if item.Created then
				onSale = onSale + 1
			end
		end
	end
	if not StoreCatalog.Enabled() then
		print("[StoreService] the Store is OFF (Config.Store.Enabled = false): its tabs and prompts are hidden and refused; receipts and owned passes are still granted")
		return
	end
	print(string.format("[StoreService] %d of %d Store items on sale%s", onSale, total,
		onSale < total and " (Id 0 = not created yet: paste the product / pass ids into Config.Store.Items)" or ""))
end

function StoreService.Init(deps)
	deps = type(deps) == "table" and deps or {}
	S.DS = deps.DataService or S.DS
	S.PS = deps.PetService or S.PS
	S.Dev = deps.DevService or S.Dev
	if S.Started then
		return
	end
	S.Started = true
	local okCheck, errCheck = pcall(checkConfig)
	if not okCheck then
		warn("[StoreService] config check failed: " .. tostring(errCheck))
	end
	local okRemote, remote = pcall(Remotes.Get, REQUEST_REMOTE)
	if okRemote and remote then
		remote.OnServerEvent:Connect(function(player, action, key)
			local ok, err = pcall(onRequest, player, action, key)
			if not ok then
				warn("[StoreService] StoreRequest failed: " .. tostring(err))
			end
		end)
	else
		warn("[StoreService] StoreRequest remote is unavailable: " .. tostring(remote))
	end
	local okEvent, errEvent = pcall(function()
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, wasPurchased)
			local ok, err = pcall(onPassFinished, player, id, wasPurchased)
			if not ok then
				warn("[StoreService] PromptGamePassPurchaseFinished failed: " .. tostring(err))
			end
		end)
	end)
	if not okEvent then
		warn("[StoreService] could not connect PromptGamePassPurchaseFinished: " .. tostring(errEvent))
	end
	StoreService.Changed:Connect(writePassAttr) -- every pass answer fires Changed: XpPassState follows PassState
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end
	task.spawn(passLoop)
end

return StoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1116">
          <Properties>
            <string name="Name">StormAltar</string>
            <string name="Source"><![CDATA[-- StormAltar (server): the Storm Altar lobby landmark from the player's own Stormfang art
-- (ARCHITECTURE_V3.md section 10, branding/stormfang-concept.webp: the crystal altar ring on dark storm clouds).
--
--   StormAltar.Build(lobbyInfo) -> CFrame   builds Model "StormAltar" under the lobby folder and returns the
--                                           altar CFrame (centre of the dais on the island's walking surface,
--                                           LookVector = towards the plaza). Safe to call again (rebuilds).
--   StormAltar.GetModel() -> Model | nil
--   StormAltar.GetCFrame() -> CFrame | nil
--   StormAltar.GetLanding() -> CFrame | nil  Phase 5 (6.2): where the Gate Court's Altar gate (GateService) puts a
--                                           player: on the island deck at the bridge end, 3 studs up, facing the altar
--   StormAltar.GetReturnPad() -> BasePart | nil  bug batch 2 #4: the invisible prompt anchor over the small return
--                                           portal beside the landing (GateService puts its "Travel" / "Plaza" prompt
--                                           on it: gate id "Plaza", back to the Gate Court)
--   StormAltar.Built                        Util.Signal; Fire() after every Build (GateService re-binds the return pad)
--   StormAltar.Used                        Util.Signal; Fire(player) when a player uses the altar's prompt
--
-- What it builds (all static; the client animates the showcase, ShowcaseController):
--   Island     a dark navy storm cloud sculpted with shared/Voxel.lua, as in the art: a storm-blue walking top
--              (DECK studs above the lobby) ringed by overlapping 2-stud-voxel billows (a lower outer row, a main
--              row and a bank piled up behind the dais; open towards the bridge) with lighter blue-grey tops and
--              pale grey-white highlights on a few crowns, over a hanging cumulus belly of 3-stud voxels (tiers of
--              lumps narrowing downwards), navy, darker underneath.
--   Dais       a ring of charcoal stone blocks (radius ~12) with bevelled lighter tops, stepped clusters and
--              stacked mounts by the crystals, scattered rubble; a segmented inner rim around a dark navy portal
--              disc with a softer heart and dim glowing runes.
--   Crystals   as in the art seen from its front (the plaza): the head crystal, the biggest (a stepped diamond with
--              two small side shards), rises at the far side behind the showcase, a medium pair flanks it, a
--              smaller pair stands at the near sides and a low diamond gem is set into the near stone. Every shard
--              is a pale Glass shell around an electric-cyan Neon core.
--   Showcase   StormfangShowcase: PetBuilder.Build(stormfang, { Detail = "High", Scale = 3 }), anchored, hovering
--              over the portal on its storm cloud, leaning forward (prowling) towards the plaza; tagged
--              "NC_Showcase" with the attributes PetId, PetParts, HoverAmp and Ready. An invisible collider keeps
--              players out of the big (non-colliding) pet.
--   Bridge     a stone bridge from the island to LobbyInfo.AltarDock (the street junction, whose inner rail
--              LobbyBuilder leaves open for it): a short level deck over the island edge, then a gentle ramp down
--              to the street height (no steps into the street). Low parapets with crystal lanterns, a storm
--              puff underneath.
--   Sign       Model StormAltarSign: a stone entrance gate standing on the street over the bridge's foot, its
--              12 x 6.4-stud poster facing the street (SurfaceGui at 50 px per stud in the cloud UI style: the
--              player's art Config.Art.StormfangImage in a 5.7-stud well, "STORM ALTAR" in 1.1-stud letters,
--              "Secret pets" and "Awakens soon" in 0.64-stud letters: readable from ~30 studs), low walls between
--              the bridge and the pillars, and a pixel-sized "STORM ALTAR" / "Secret pets" title tag above the
--              altar, readable from the plaza.
--   Prompt     ProximityPrompt "Storm Altar" (ActionText "Secret Roll", shop-area 16.17.3: the Secret roll happens here
--              only; was "Summon"). Phase 2 (gems): it opens the Shop on the
--              gems-only Secret roulette (OpenPanel("Shop", { RouletteId = Config.Gems.SecretRoulette.Id,
--              Currency = "Gems", FromAltar = true }), rate-limited per player; FromAltar only unlocks the client's card,
--              PetService checks the distance itself) when GemService.SecretRouletteState says "Open";
--              an account where PolicyService restricts paid random items gets a side toast that the Secret
--              Roulette is not available there; while the gem system is missing or still checking the account the
--              phase 1 side toast "The Storm Altar awakens soon: summon Secret pets with Gems!" is sent (toasts:
--              Notify, rate-limited per player).
--   Glow       lobby-shop (spec 5.11 b): Model PortalGlow beside the untouched Portal model (its prop_altar_portal
--              LayoutSig still matches): a crystal-cyan Neon GlowDisc (a 16-gon inside the rim, union radius <= 6.0,
--              its top 0.06 over the old disc top) with a lighter GlowHeart, GlowRing (16 cyan Neon segments on a ring of
--              centre radius 6.0, 0.35 over the disc top, pivot = the disc centre on the disc top: the layout of the
--              Blender key portal_altar_ring, whose Part fallback it is) tagged Config.Tags.Spin (SpinSeconds 6: the
--              client turns it), rising sparkles, a PointLight 1.5 / 24 and a sky beam (a Beam from 0.5 to 160 studs
--              up, FaceCamera, no texture, cyan to white, fading with height) so the altar is found from the plaza.
--   Return     bug batch 2 #4, lobby-shop (spec 5.11 c): Model ReturnPortal, RETURN_AHEAD studs out along the bridge
--              bearing and RETURN_SIDE to its side, facing the walk from the dais: beside the landing, clear of the
--              arrival spot, the 8-stud bridge lane and the island's rim clouds. Two flat navy Pad octagons (4 studs across, 0.2 high: the only colliding parts)
--              and a standing ring in the Return-gate green (Model Ring, Blender key portal_ring with its plinth top
--              0.05 under the octagons' top; its Part fallback: 13 green Neon segments on a ring 4.5 up over the pad and
--              two stone feet), never colliding or touching. "Plaza" (0.96 stud) on the mesh's SignFace (a SurfaceGui at
--              50 px per stud on a SignFace part) once the ring is dressed, else a pixel BillboardGui "To the Plaza" over the ring. Its
--              "ReturnPrompt" anchor carries GateService's prompt (no panel) and a PointLight 1.3 / 14. Spec 16.16: a
--              PortalFx gate (GateId "Plaza") whose client vortex sits on the invisible VortexCenter part (the Part
--              ring's opening) or, once the client dressed the Ring (VortexMeshChild = "Ring"), VortexCenter x
--              VortexMeshOffset (the mesh's PortalCenter), sized VortexRadius / VortexMeshRadius, coloured VortexColor
--              (the ring's green).
--   Gem        lobby-shop (spec 5.7): Model WorldGem, "gems are spent here": a cut gem (Blender key gem_world, pivot the
--              girdle centre). shop-area (spec 16.17.4, spot 2 "Side crystal"): its centre 15 studs over the deck
--              straight above the medium crystal on the side away from the return ring (ahead 8.0 / side -9.2 in the
--              bridge frame at the default bearing), facing the walk, >= 2 studs of air over the crystal's tip: off the
--              deck where players stand, in view on arrival, >= 12 studs from both prompts, outside the
--              8-stud bridge lane. Part fallback Gem: one 4x4x4 Glass cube in rgb(84,196,246) turned 45 degrees on X and
--              Z, non-colliding, with a cyan PointLight 1.0 / 12. Tagged Config.Tags.Spin (SpinSeconds 8, BobStuds 0.6,
--              BobSeconds 3): the client turns and bobs it.
--   Lights     a few soft electric-blue PointLights with small ranges (portal, glow, return ring, gem, head crystal, gate).
-- No AltarSite: a free spot between the plaza and the plot ring road is searched (away from lobby parts, NPC spots
-- and the spawn), and the dock is found by raycasting for the street. Collision only on walkable parts (island
-- top and billows, dais stones, rim, disc, bridge, steps, gate, the return pads) plus the invisible showcase
-- collider. Part budget <= 500 without the showcase pet (tools/contract.json stormAltar). Plain Lua 5.1-compatible
-- syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local WorldTag = require(Shared:WaitForChild("WorldTag")) -- (Pitch 2 item 04) the hanging header's stone board

local function optional(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[StormAltar] shared module missing: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[StormAltar] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

