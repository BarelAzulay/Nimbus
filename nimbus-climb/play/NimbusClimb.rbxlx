			Gap = 12, Pad = 10, Top = 8, Face = 56, Name = 22, NameMin = 18, Line = 19, LineMin = 18, LineH = 26, BarH = 28,
			-- (LOOK-ui2) the lock 27 px, one of the kit's two icon sizes (was 36)
