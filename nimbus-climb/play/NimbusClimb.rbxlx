		end
		local hpNow = Theme.Short(clamp(bossUnit.hp or 0, 0, bossUnit.maxHp or 0))
		setText(Hud.bossText, Hud.bossShort and hpNow or (hpNow .. " / " .. maxText))
		local numX = tw - e - pad - nw
		local divX = numX - pad - 2
		Hud.bossDivider.Position = UDim2.fromOffset(divX, e)
		Hud.bossDivider.Size = UDim2.fromOffset(2, th - 2 * e)
		Hud.bossText.Position = UDim2.fromOffset(numX, e)
		Hud.bossText.Size = UDim2.fromOffset(nw, th - 2 * e)
		Hud.bossText.TextSize = numPx
		Hud.bossText:SetAttribute("BaseText", numPx)
		-- 20 blocks (14 on a phone); a narrow track (a tall phone's right column) fewer, each still a chunky >= 12 px block
		local n = compact and K.BOSS_BLOCKS_COMPACT or K.BOSS_BLOCKS
		local room = divX - pad - (e + pad)
		-- (playtest 2026-11-28 C6: the floor of six kept six blocks in 10 design px, each 0 px) under six 12 px blocks of
		-- room, fewer blocks (never under three), each still 12 px or more
		n = clamp(floor((room + 3) / (12 + 3)), min(6, max(3, floor((room + 3) / (12 + 3)))), n)
		if Hud.bossBar.count ~= n then
			SignKit.SetBlockCount(Hud.bossBar.Root, n, KB.Loss, SIGN.RedLip)
			Hud.bossBar.count = n
			Hud.bossBar.lit = -1
		end
		Hud.bossBar.Root.Position = UDim2.fromOffset(e + pad, e + pad)
		Hud.bossBar.Root.Size = UDim2.fromOffset(max(10, divX - pad - (e + pad)), th - 2 * (e + pad))
		pillX, pillW = bx, x1 - bx
		yy = yy + th + 8
	else
		Hud.portrait.Visible = false
	end
	-- the pills (a boss, a dungeon run): every one shown, wrapped into rows inside the card
	Hud.pills.Visible = bossUnit ~= nil or B.Mode == "Dungeon"
	Hud.pillsShort = compact
	Hud.SetPills(B, bossUnit, tierPill, compact, fpx)
	local pillsH = 0
	if Hud.pills.Visible then
		pillsH = Hud.FlowPills(pillW)
		if compact and bossUnit and bodyMin > 0 and pillX > x0 then
			-- (release check 2026-11-27, images I1-I7 uploaded) a phone shows the uploaded head too, and its slot narrowed the
			-- pill column beside it to half the card: the pills wrapped to twice the rows and a 360 x 640 full raid card reached
			-- MOVE. The pills go under the head at the card's full width where that ends the card higher
			local fullW, underY = x1 - x0, P + rowH + 8 + bodyMin + 8
			local fullH = Hud.FlowPills(fullW)
			if underY + fullH < max(yy + pillsH, underY - 8) then
				pillX, pillW, yy, pillsH = x0, fullW, underY, fullH
			else
				pillsH = Hud.FlowPills(pillW)
			end
		end
		if not compact and raidBoss and pillsH > K.PILL_H then
			-- (keys lane, look fixA r1: the PC strip's head slot narrows the pill row, whose four pills then took two rows; the
			-- approved strip has them in one) the phone's shorter words ("Wave 2/2", the people icon and the count) where they
			-- keep the pills in fewer rows; Hud.Update keeps the words this layout chose (Hud.pillsShort)
			Hud.SetPills(B, bossUnit, tierPill, true, fpx)
			local h2 = Hud.FlowPills(pillW)
			if h2 < pillsH then
				pillsH = h2
				Hud.pillsShort = true
			else
				Hud.SetPills(B, bossUnit, tierPill, false, fpx)
				pillsH = Hud.FlowPills(pillW)
			end
		end
		Hud.pills.Position = UDim2.fromOffset(pillX, yy)
		Hud.pills.Size = UDim2.fromOffset(pillW, max(1, pillsH))
		Hud.bossElement.Visible = bossUnit ~= nil
		if timerLow and pillsH > 0 then
			-- (fix6 look0 #1) the timer that left row 1: right-aligned at the card's inner edge (under Leave), on the last pill
			-- row where it clears that row's pills by K.PILL_GAP, else on a row of its own under them
			local e, lastY, lastR = 2, -1, 0
			for _, pill in ipairs({ Hud.raidPill, Hud.bossElement, Hud.enragePill, Hud.minionPill, Hud.wavePill, Hud.playersPill, Hud.tierPill }) do
				if pill.Visible then
					local py, pr = pill.Position.Y.Offset, pill.Position.X.Offset + pill.Size.X.Offset + e
					if py > lastY + 0.5 then
						lastY, lastR = py, pr
					elseif abs(py - lastY) <= 0.5 then
						lastR = max(lastR, pr)
					end
				end
			end
			-- (fix6b, the owner's pick of 2026-11-23: e272588 put Shadow Hydra's timer at the foot of the card in raid / raid:ready
			-- and inside the RAID pill in raid:full - three places on one phone; the place followed the pills, which change in
			-- the fight) one place for the whole fight: the RAID pill carries the time whenever it shows (row 1, which decides
			-- timerLow and the pill, is the same in every phase); the last pill row's end or a row of its own only without it
			if Hud.raidPill.Visible then
				-- not a row of its own (a landscape phone's card stays under 45 % of the height, keys look r3) - the RAID pill
				-- carries the time, sized for the widest time this fight shows; Hud.Update writes it each second (red under
				-- 15 s, as the timer)
				Hud.timerPill = true
				Hud.timer.Visible = false
				setText(Hud.raidPill, (fmtTime(B.TimeLimit):gsub("%d", "8")))
				pillsH = Hud.FlowPills(pillW)
				Hud.pills.Size = UDim2.fromOffset(pillW, max(1, pillsH))
				local left = B.TimeLimit - (B.renderT or 0)
				setText(Hud.raidPill, fmtTime(max(0, left)))
				paintPill(Hud.raidPill, (left < 15) and SIGN.Red or SIGN.Wood)
			elseif lastY >= 0 and pillX + lastR + K.PILL_GAP + timerW <= x1 then
				Hud.timer.Position = UDim2.fromOffset(x1 - timerW, yy + lastY - e)
				Hud.timer.Size = UDim2.fromOffset(timerW, K.PILL_H)
			else
				pillsH = pillsH + K.PILL_GAP + K.PILL_H
				Hud.timer.Position = UDim2.fromOffset(x1 - timerW, yy + pillsH - K.PILL_H)
				Hud.timer.Size = UDim2.fromOffset(timerW, K.PILL_H)
			end
		end
		if pillsH > 0 then
			yy = yy + pillsH + 8
		end
	end
	if bossUnit and bodyMin > 0 then
		yy = max(yy, P + rowH + 8 + bodyMin + 8)
	end
	if not bossUnit and not (Hud.pills.Visible and pillsH > 0) then
		yy = P + rowH + 8
	end
	yy = Ring.LayoutInfo(B, w, yy)
	local h = yy + 5 -- (the card's lip)
	Hud.modeCard.Root.Size = UDim2.fromOffset(w, h)
	Hud.boss.Size = UDim2.fromOffset(w, h)
	top.Size = UDim2.fromOffset(w, h)
	if leftTop then
		local fcH = Hud.fighterCard.Root.Size.Y.Offset
		Hud.helperHolder.Position = UDim2.fromOffset(0, fcH + 8 + h + 8)
	end
	if underList and y + h > Hud.BandTop(m) then
		-- (a tall phone whose right column starts low: the top card first, the enemy list under it, both above
		-- the centre band)
		y = rightY
		top.Position = UDim2.fromOffset(x, y)
		Hud.enemies.Position = UDim2.fromOffset(m.W - K.EDGE, y + h + 8)
	end
	Hud.topH = h
	Hud.topRect = { x - anchor * w, y, x - anchor * w + w, y + h }
end

-- (Pitch 2 item 06 A) the pills' texts, icons and sizes for this battle (a phone's shorter words: "Wave 2/3", the people icon
-- and the count). Returns a key that changes when a pill's text or visibility does
function Hud.SetPills(B, bossUnit, tierPill, compact, fpx)
	local size = max(18, fpx or 0)
	local lethal = B.lethalPending == true
	Hud.enragePill.Visible = B.enraged == true
	-- (keys lane, look fixA r1: the approved mock-up's pill reads "Enraged", the other pills' case)
	setText(Hud.enragePill, lethal and "Enraged - DASH!" or "Enraged")
	local minions, players = 0, {}
	for _, u in ipairs(B.list) do
		if u.kind == "Minion" and u.hp > 0 and u.state ~= S_DOWN then
			minions = minions + 1
		elseif u.side == 1 and u.owner ~= nil and u.kind ~= "Minion" then
			players[u.owner] = true
		end
	end
	local pc = 0
	for _ in pairs(players) do
		pc = pc + 1
	end
	Hud.minionPill.Visible = minions > 0
	setText(Hud.minionPill, "Minions x" .. minions)
	Hud.playersPill.Visible = (B.Mode == "Raid" or (B.Mode == "Dungeon" and pc > 1)) and pc > 0
	setText(Hud.playersPill, compact and tostring(pc) or (pc == 1 and "1 player" or (pc .. " players")))
	local d = B.Dungeon
	local waveText = ""
	-- (a phone's dungeon line already says "Room 1 - Wave 2/3" (Hud.ModeText): no second wave pill there)
	local waveInLine = compact and B.Mode == "Dungeon" and num(d and d.Waves, 0) > 1
	if d and num(d.Waves, 0) > 0 and not waveInLine then
		local wave, waves = clamp(max(num(d.Wave, 1), B.wave or 0), 1, num(d.Waves, 1)), num(d.Waves, 1)
		waveText = compact and ("Wave " .. wave .. "/" .. waves) or ("Wave " .. wave .. " / " .. waves)
	elseif B.Mode == "Raid" and bossUnit and num(B.wave, 0) >= 1 then
		-- (P2 fix A, look review r1: the pitch's pills are Storm, Enraged, Wave 2 / 3 and the players) a raid's minion wave, from
		-- the first one on, of the boss's waves (BattleCatalog.Bosses[id].Minions.Waves)
		local id = bossUnit.bossId or B.BossId or (B.Raid and B.Raid.BossId) or ""
		local def = BattleCatalog and type(BattleCatalog.Bosses) == "table" and BattleCatalog.Bosses[id] or nil
		local list = def and type(def.Minions) == "table" and def.Minions.Waves
		local waves = type(list) == "table" and #list or 0
		if waves > 0 then
			local wave = clamp(num(B.wave, 1), 1, waves)
			waveText = compact and ("Wave " .. wave .. "/" .. waves) or ("Wave " .. wave .. " / " .. waves)
		end
	end
	Hud.wavePill.Visible = waveText ~= ""
	setText(Hud.wavePill, waveText)
	-- (keys lane, look fixA r1: "Minions x4", not in the approved 06 A pills, pushed "3 players" onto a row of its own on PC
	-- and the phone's pills onto a second row) a raid's minions are its wave pill, "Wave 2/2", as the mock-up's four pills
	-- (Storm, Enraged, Wave, players); the minions themselves are on the enemy list. Elsewhere the count stays
	if B.Mode == "Raid" and Hud.wavePill.Visible then
		Hud.minionPill.Visible = false
	end
	Hud.tierPill.Visible = tierPill ~= nil and tierPill ~= ""
	setText(Hud.tierPill, tierPill or "")
	if bossUnit then
		setText(Hud.bossElement, tostring(bossUnit.element or "?"))
		paintPill(Hud.bossElement, elementColor(bossUnit.element))
		local icon = ELEMENT_ICON[bossUnit.element]
		if icon and Hud.bossElement:GetAttribute("LeadName") ~= icon then
			local old = Hud.bossElement:FindFirstChild("LeadIcon")
			if old then
				old:Destroy()
			end
			PixelIcon.Lead(Hud.bossElement, icon)
			Hud.bossElement:SetAttribute("LeadName", icon)
		end
	end
	Hud.bossElement.Visible = bossUnit ~= nil
	local key = { size }
	for _, pill in ipairs({ Hud.raidPill, Hud.bossElement, Hud.enragePill, Hud.minionPill, Hud.wavePill, Hud.playersPill, Hud.tierPill }) do
		if pill.TextSize ~= size then
			pill.TextSize = size
		end
		pill:SetAttribute("BaseText", size)
		-- (fix6 look0 #1: the RAID pill that carries the time changes its words each second, sized once for the widest)
		key[#key + 1] = (pill.Visible and "1" or "0") .. ((pill == Hud.raidPill and Hud.timerPill) and "<time>" or pill.Text)
	end
	return table.concat(key, "|")
end

-- (Pitch 2 item 06 A) lays the shown pills left to right in `width` design px, a new row where one would run past it (the
-- pitch's rule: one row at the HUD size, else rows, never cut). Returns the rows' height
function Hud.FlowPills(width)
	-- (each pill's 2 px wood edge is drawn outside its box: the box sits 2 px in, so the drawn pill is PILL_H tall and the
	-- drawn gap PILL_GAP, as the pitch's)
	local e = 2
	local items = {}
	for _, pill in ipairs({ Hud.raidPill, Hud.bossElement, Hud.enragePill, Hud.minionPill, Hud.wavePill, Hud.playersPill, Hud.tierPill }) do
		if pill.Visible then
			fitPill(pill, K.PILL_H - 2 * e)
			local pw = min(pill.Size.X.Offset + 4, width - 2 * e) -- (4 px more: a lead icon's pill reads tight at 0.8 scale)
			items[#items + 1] = { pill, pw }
		end
	end
	local function rowW(r)
		local s = 0
		for i, it in ipairs(r) do
			s = s + it[2] + 2 * e + ((i > 1) and K.PILL_GAP or 0)
		end
		return s
	end
	-- the pills in this order, left to right, a new row where one would run past the width
	local function flow(list)
		local rows, cur, x = {}, {}, 0
		for _, it in ipairs(list) do
			if x > 0 and x + it[2] + 2 * e > width then
				rows[#rows + 1] = cur
				cur, x = {}, 0
			end
			cur[#cur + 1] = it
			x = x + it[2] + 2 * e + K.PILL_GAP
		end
		if #cur > 0 then
			rows[#rows + 1] = cur
		end
		-- (keys lane, look fixA r1: "3 players" alone on a row of its own under the strip's other pills) a last row of one
		-- pill takes the row above's last pill where that row keeps two and both still fit in the width
		while #rows >= 2 and #rows[#rows] == 1 and #rows[#rows - 1] >= 3 do
			local prev = rows[#rows - 1]
			local trial = { prev[#prev], rows[#rows][1] }
			if rowW(trial) > width then
				break
			end
			table.remove(prev)
			rows[#rows] = trial
		end
		return rows
	end
	local function lone(rows)
		local n = 0
		for _, r in ipairs(rows) do
			if #rows > 1 and #r == 1 then
				n = n + 1
			end
		end
		return n
	end
	-- (keys look r3: at 640 x 360 the full raid's card in the gap took four rows, "Enraged" and "Starter" each alone: Enraged
	-- and the wave pill beside it miss the 203 px row by 2 px; the card was 52 % of the height) where the plain order leaves
	-- a pill alone on a row, the order with one pill moved to the end where that takes fewer rows or leaves fewer alone (of
	-- the orders that do it best, the one that moves the LAST such pill: the fewest pills change place, the RAID tag and the
	-- element lead)
	local rows = flow(items)
	if lone(rows) > 0 then
		local plain = rows
		for i = 1, #items - 1 do
			local list = {}
			for k, it in ipairs(items) do
				if k ~= i then
					list[#list + 1] = it
				end
			end
			list[#list + 1] = items[i]
			local trial = flow(list)
			local better = #trial < #rows or (#trial == #rows and lone(trial) < lone(rows))
			local asGood = rows ~= plain and #trial == #rows and lone(trial) == lone(rows)
			if better or asGood then
				rows = trial
			end
		end
	end
	for row, list in ipairs(rows) do
		local px0 = 0
		for _, it in ipairs(list) do
			local pill, pw = it[1], it[2]
			pill.AutomaticSize = Enum.AutomaticSize.None
			pill.Position = UDim2.fromOffset(px0 + e, (row - 1) * (K.PILL_H + K.PILL_GAP) + e)
			pill.Size = UDim2.fromOffset(pw, K.PILL_H - 2 * e)
			px0 = px0 + pw + 2 * e + K.PILL_GAP
		end
	end
	local n = #rows
	return n > 0 and (n * K.PILL_H + (n - 1) * K.PILL_GAP) or 0
end

-- the boss the top card shows: the raid boss, else a dungeon / wave mini-boss that is still up
function Hud.BossUnit(B)
	if B.boss then
		return B.boss
	end
	for _, u in ipairs(B.list) do
		if not u.ally and u.kind == "MiniBoss" and u.hp > 0 and u.state ~= S_DOWN then
			return u
		end
	end
	return nil
end

function Hud.Keys()
	for kind, A in pairs(Hud.buttons or {}) do
		local t = A.Key and A.Key:FindFirstChild("Text")
		if t then
			Hud.SetKey(t, Hud.KeyText(kind))
		end
	end
	for i, H in ipairs(Hud.helpers or {}) do
		local t = H.Key and H.Key:FindFirstChild("Text")
		if t then
			Hud.SetKey(t, Hud.KeyText("Buff", i))
		end
	end
	if Hud.retreat then
		Hud.SetKey(Hud.retreat.Key, Hud.KeyText("Retreat"))
	end
end

-- seconds left of a cooldown (B.cd[kind], or the buff of helper slot), clamped >= 0
local function cdLeft(B, kind, slot, now)
	local cd = B.cd
	local readyAt = (kind == "Buff") and (cd.Buff[slot] or 0) or (cd[kind] or 0)
	return max(0, readyAt - now)
end

local function cdLen(B, kind, slot)
	local cd = B.cdLen
	if kind == "Buff" then
		return max(0.1, cd.Buff[slot] or 15)
	end
	return max(0.1, cd[kind] or 1)
end

-- per-frame HUD values: bars / texts only when they change, rings at 10 Hz
function Hud.Update(B, now, force)
	if not Hud.gui or not B then
		return
	end
	local last = Hud.last or {}
	Hud.last = last
	local modeText, _, modeShorts = Hud.ModeText(B)
	if last.mode ~= modeText or last.modeW ~= Hud.mode.Size.X.Offset then
		last.mode = modeText
		last.modeW = Hud.mode.Size.X.Offset
		-- (kit-b U9-6) the line whole: a narrow card shows a short form (Hud.ModeText's third value)
		local forms = { modeText }
		for _, t in ipairs(modeShorts or {}) do
			forms[#forms + 1] = t
		end
		Hud.SetFit(Hud.mode, forms, Hud.m)
	end
	local left = B.TimeLimit > 0 and (B.TimeLimit - B.renderT) or 0
	local timerText = B.TimeLimit > 0 and fmtTime(left) or ""
	if last.timer ~= timerText then
		last.timer = timerText
		Hud.timer.Text = timerText
		Hud.timer.TextColor3 = (left < 15 and B.TimeLimit > 0) and SIGN.RedLip or KB.Ink -- (Pitch 2 item 06 A: on the stone card)
		if Hud.timerPill then
			-- (fix6 look0 #1) the RAID pill that carries the time (Hud.LayoutTop, a narrow card's long boss name)
			setText(Hud.raidPill, timerText)
			paintPill(Hud.raidPill, (left < 15 and B.TimeLimit > 0) and SIGN.Red or SIGN.Wood)
		end
	end
	local bossUnit = Hud.boss.Visible and Hud.BossUnit(B) or nil
	if bossUnit then
		if force or last.bossHp ~= bossUnit.hp or last.bossMax ~= bossUnit.maxHp then
			last.bossHp, last.bossMax = bossUnit.hp, bossUnit.maxHp
			-- (Pitch 2 item 06 A: the drain GIF's rule) the number changes on the same frame the blocks fall; "HP / max" on
			-- every screen, in the track behind its divider
			setBlocks(Hud.bossBar, healthBlocks(clamp(bossUnit.hp / bossUnit.maxHp, 0, 1), Hud.bossBar.count))
			local hpText = Theme.Short(clamp(bossUnit.hp, 0, bossUnit.maxHp))
			setText(Hud.bossText, Hud.bossShort and hpText or (hpText .. " / " .. Theme.Short(bossUnit.maxHp))) -- (playtest 2026-11-28 C6: a narrow track, the HP alone)
		end
	end
	if Hud.pills.Visible and Hud.topArgs then
		-- (Pitch 2 item 06 A) a pill that comes, goes or changes its words flows the rows again (the card grows by a row
		-- where they wrap anew)
		local m = Hud.m or Hud.Metrics()
		local fpx = math.ceil(Hud.FloorPx() / max(0.05, m.F) - 1e-6)
		local short = m.Compact
		if Hud.pillsShort ~= nil then
			short = Hud.pillsShort -- (keys lane: the words LayoutTop chose, a PC strip's shorter ones too)
		end
		local key = Hud.SetPills(B, Hud.BossUnit(B), Hud.tierPill.Visible and Hud.tierPill.Text or nil, short, fpx)
		if last.pillKey ~= key then
			local first = last.pillKey == nil
			last.pillKey = key
			if not first then
				local h = Hud.topH
				local a = Hud.topArgs
				Hud.LayoutTop(a[1], a[2], a[3], a[4], a[5], a[6])
				if Hud.topH ~= h then
					Leave.Place(m, B, B.Fighter and not B.ended)
					AreaWarn.Place(m, B)
				end
			end
		end
	end
	if not B.Fighter then
		return
	end
	-- the fighter card ----------------------------------------------------------------------------------
	local F = Hud.F
	local f = B.fighterId and B.units[B.fighterId]
	if f and Hud.team.Visible then
		local hp = max(0, f.hp)
		local frac = clamp(hp / f.maxHp, 0, 1)
		if force or last.hp ~= hp or last.maxHp ~= f.maxHp or last.fid ~= f.id then
			local prevLit = (last.fid == f.id) and F.HpBar.lit or nil
			last.hp, last.maxHp, last.fid, last.hpFrac = hp, f.maxHp, f.id, frac
			local lit = healthBlocks(frac, K.HP_BLOCKS)
			-- (LOOK-ui2) the number beside the row (a phone's narrow card: the HP left only, the blocks say the rest)
			local hpLine = Theme.Short(floor(hp + 0.5))
			if not Hud.hpShort then
				hpLine = hpLine .. " / " .. Theme.Short(floor(f.maxHp + 0.5))
			end
			setText(F.HpText, hpLine)
			Hud.hpWrites = (Hud.hpWrites or 0) + 1
			-- the loss trail: the blocks this hit took flash red for K.LOSS_TIME, then go stone; a heal lights them at once
			setBlocks(F.HpBar, lit)
			if prevLit and prevLit >= 0 and lit < prevLit then
				Hud.hpTrail = { From = lit, To = prevLit, Until = now + K.LOSS_TIME }
			elseif Hud.hpTrail and lit >= Hud.hpTrail.From then
				Hud.hpTrail = nil
			end
			Hud.PaintHpTrail(now)
		end
		if Hud.hpTrail and now >= Hud.hpTrail.Until then
			Hud.hpTrail = nil
			Hud.PaintHpTrail(now)
		end
		local meter = clamp(floor(f.meter + 0.5), 0, METER_MAX)
		if force or last.meter ~= meter then
			last.meter = meter
			-- (kit-b U9-6) the row turns gold at 100; the caption stays brown on the stone (gold text would not read there)
			local full = meter >= METER_MAX
			if last.energyFull ~= full then
				last.energyFull = full
				SignKit.SetBlockCount(F.EnergyBar.Root, K.HP_BLOCKS, full and SIGN.Gold or KB.Energy, full and SIGN.GoldLip or SIGN.SkyLip)
				F.EnergyBar.lit = -1
			end
			setBlocks(F.EnergyBar, chargeBlocks(meter / METER_MAX, K.HP_BLOCKS))
			F.EnergyText.Text = (Hud.energyShort and "" or "ENERGY ") .. meter .. "/" .. METER_MAX
		end
	end
	local lives = B.lives or 3
	if force or last.lives ~= lives then
		last.lives = lives
		for i, h in ipairs(F.Hearts) do
			h.TextColor3 = (i <= lives) and KB.Life or KB.LifeLost
			h.TextTransparency = (i <= lives) and 0 or 0.25
		end
	end
	if B.ended then
		return
	end
	-- rows of the enemy list: HP fills on change, the wind-up "!" while an enemy winds up -----------------
	if Hud.enemyDirty then
		Hud.enemyDirty = false
		local list = Hud.EnemyList(B)
		local key = tostring(B.lock or 0)
		for _, u in ipairs(list) do
			key = key .. "," .. u.id
		end
		if key ~= Hud.enemyKey and Hud.m then
			Hud.LayoutEnemies(B, Hud.m)
			Hud.FixText(Hud.enemies, Hud.m.F)
		end
	end
	for i, u in ipairs(Hud.enemyList or {}) do
		local row = Hud.rows[i]
		if row and row.Frame.Visible and row.unitId == u.id then
			setBlocks(row.Hp, healthBlocks(clamp(u.hp / u.maxHp, 0, 1), K.HP_BLOCKS))
			setVisible(row.Alert, u.windupUntil ~= nil and now < u.windupUntil)
		end
	end
	-- 10 Hz: the rings, the countdowns, the helper states -------------------------------------------------
	if not force and now - (Hud.ringAt or 0) < K.RING_DT then
		return
	end
	Hud.ringAt = now
	Input.CheckPending(B, now)
	CheerUp.Update(B, now)
	Retreat.Update(B, now)
	AreaWarn.Update(B, now)
	for kind, A in pairs(Hud.buttons) do
		local frac, countText = 1, ""
		if kind == "Element" or kind == "Dash" then
			local leftS = cdLeft(B, kind, nil, now)
			frac = 1 - leftS / cdLen(B, kind)
			if leftS > 0.05 then
				countText = tostring(math.ceil(leftS - 0.05))
			end
		elseif kind == "Special" then
			frac = f and clamp(f.meter / METER_MAX, 0, 1) or 0
		end
		local ready = frac >= 1
		if A.three then
			-- (Pitch 2 item 1b) MOVE: the meter rises on it; a full meter (a fighter with a special) turns it gold, the HOLD
			-- tag on, no countdown (a hold fires the special whatever the element's cooldown)
			A.meter = f and clamp(f.meter / METER_MAX, 0, 1) or 0
			local full = f ~= nil and f.special ~= nil and f.meter >= METER_MAX
			if A.full ~= full then
				A.full = full
				A.drawn = nil
				Hud.Captions(B)
			end
			if full then
				ready, countText = true, ""
			end
		end
		-- (LOOK-ui2) a key cooling down (a cooldown, the special's meter charging) sinks into the well, its colour rising
		A.cooling = not ready
		A.fill = frac
		setText(A.Count, countText)
		setVisible(A.Count, countText ~= "")
		-- (kit-b U9-6 review: the countdown over the faded glyph's ink pixels read 2.8:1) the countdown takes the glyph's place;
		-- (Pitch 2 item 1b, look review r0) a block key's seconds stand beside its glyph instead, both kept
		A.Glyph.TextTransparency = (countText ~= "" and not A.blockRow) and 1 or 0
		if A.blockRow then
			Hud.PlaceBlockCount(A)
		end
		A.cue = (kind == "Dash" and B.cue == "Dash") or (kind == "Special" and ready and f ~= nil and f.special ~= nil)
		Hud.PaintKey(A, now)
		setDisabled(A.Button, kind == "Special" and not ready)
	end
	local swapLeft = cdLeft(B, "Swap", nil, now)
	for i, H in ipairs(Hud.helpers) do
		local u = H.unit
		if u and H.Cell.Visible then
			local down = u.hp <= 0 or u.state == S_DOWN
			local leftS = cdLeft(B, "Buff", u.slot, now)
			-- (LOOK-ui2) the buff's four blocks light as it comes back (all four: ready)
			setBlocks(H.Cd, down and 0 or chargeBlocks(1 - leftS / cdLen(B, "Buff", u.slot), K.CD_BLOCKS))
			local countText = (not down and leftS > 0.05) and tostring(math.ceil(leftS - 0.05)) or ""
			setText(H.Count, countText)
			setVisible(H.Count, countText ~= "")
			local stateKey = (down and "d" or "a") .. ((swapLeft > 0.05) and "s" or "")
			if H.stateKey ~= stateKey then
				H.stateKey = stateKey
				setVisible(H.KO, down)
				H.View.ImageTransparency = down and 0.6 or 0
				H.View.ImageColor3 = down and Color3.fromRGB(120, 124, 140) or Color3.fromRGB(255, 255, 255)
				H.Buff.TextColor3 = down and KB.Muted or KB.Ink
				setDisabled(H.Swap, down or swapLeft > 0.05)
				-- (kit-b U9-6) a swap that cannot happen sinks into the well (the pitch's Off block), else the stone block
				local off = down or swapLeft > 0.05
				signBlock(H.Swap, off and KB.Well or KB.Face, off and SIGN.WellEdge or SIGN.StoneLip, off and KB.Muted or KB.Ink, K.SMALL_LIP, K.SMALL_EDGE)
			end
			local hold = Input.HoldFrac(i, now)
			setVisible(H.SwapFill, hold > 0)
			if hold > 0 then
				H.SwapFill.Size = UDim2.fromScale(hold, 1)
			end
			if H.swapIcon then
				-- (Pitch 2 item 1b, look review r1) a short landscape phone's SWAP beside the Lv tag: its arrows alone (sunk
				-- into the well while it cannot swap)
				setText(H.Swap, "")
			elseif swapLeft > 0.05 and not down then
				setText(H.Swap, tostring(math.ceil(swapLeft - 0.05)))
			else
				setText(H.Swap, "Swap")
			end
		end
		H.index = i
	end
end

-- the mode line, its colour and its short forms, longest first (kit-b U9-6 review: every mode has one, so Hud.SetFit never
-- has to cut the line on a narrow card - a portrait phone's under-card cut "Round 8 - Best 12")
function Hud.ModeText(B)
	local text, color, shorts
	if B.Mode == "Raid" then
		text, color = "BOSS RAID", KB.Mode.Raid
		if B.Raid and B.Raid.Tier then
			text = text .. " - " .. tostring(B.Raid.Tier)
			shorts = { "BOSS RAID" }
		end
	elseif B.Mode == "Dungeon" then
		local d = B.Dungeon or {}
		local compact = Hud.m and Hud.m.Compact
		local room = "Room " .. tostring(num(d.Room, 1))
		text, color = "DUNGEON - Floor " .. tostring(num(d.Floor, 1)) .. " - " .. room, KB.Mode.Dungeon
		shorts = { room }
		if compact then
			-- (a phone's line is short: the room + the wave; DungeonController's side card shows the floor)
			local waves = num(d.Waves, 0)
			if waves > 1 then
				local wave = "Wave " .. clamp(max(num(d.Wave, 1), B.wave or 0), 1, waves) .. "/" .. waves
				text = room .. " - " .. wave
				shorts = { wave } -- (kit-b U9-6: a portrait phone's narrow card: the wave, the room is on the side card)
			else
				text = "Floor " .. tostring(num(d.Floor, 1)) .. " - " .. room
			end
		end
		if d.Boss == true and num(d.Room, 0) >= 3 then
			text = text .. " (BOSS)"
			shorts = { shorts[1] .. " (BOSS)", shorts[1] }
		end
	elseif B.Mode == "Ring" then
		local round = "Round " .. tostring(B.Round > 0 and B.Round or 1)
		text, color = Ring.TitleText(B), KB.Mode.Ring
		shorts = { round }
		local best = B.Ring and num(B.Ring.Best, 0) or 0
		if best > 0 and not (Hud.m and Hud.m.Compact) then
			shorts = { round .. " - Best " .. best, round } -- (a phone's whole line is already this)
		end
	else
		text, color = "DUEL", KB.Mode.Duel
		if B.Fighter then
			local vs = "vs " .. Hud.SideName(B, B.Side == 1 and 2 or 1)
			text = "DUEL - " .. vs
			shorts = { vs, "DUEL" }
		end
	end
	if B.Spectator then
		local what = (B.Mode == "Duel") and (Hud.SideName(B, 1) .. " vs " .. Hud.SideName(B, 2)) or text
		text = "WATCHING - " .. what
		shorts = { what, "WATCHING" }
	end
	return text, color, shorts
end

function Hud.SideName(B, side)
	local names = {}
	for _, owner in ipairs((B.sides and B.sides[side]) or {}) do
		local n = B.Names[tostring(owner)]
		if n then
			names[#names + 1] = n
		end
	end
	if #names > 0 then
		return table.concat(names, ", ")
	end
	if B.Mode == "Ring" and side == 2 then
		return "The Champion"
	end
	return side == 1 and "Blue side" or "Red side"
end

function Hud.TitleText(B)
	return (Hud.ModeText(B))
end

-- a short "not yet" wiggle (rotation only, so the layout is never disturbed)
function Hud.Shake(obj)
	if not obj or not obj.Parent then
		return
	end
	Hud.shakes = (Hud.shakes or 0) + 1
	obj:SetAttribute("Shakes", (obj:GetAttribute("Shakes") or 0) + 1)
	-- (LOOK-ui2: was a +-7 degree wobble, a turned square off the pixel grid) U9-8's refusal: the wood edge flashes red for a
	-- moment; an action key's face also steps sideways in whole px (Hud.PaintKey reads DenyUntil)
	obj:SetAttribute("DenyUntil", os.clock() + 0.3)
	for _, A in pairs(Hud.buttons or {}) do
		if A.Button == obj then
			Hud.PaintKey(A, os.clock())
			return
		end
	end
	local edge = obj:FindFirstChild("SignEdge")
	if edge and edge:IsA("UIStroke") then
		edge.Color = SIGN.Red
		task.delay(0.3, function()
			if edge.Parent then
				edge.Color = KB.Edge
			end
		end)
	end
end

-- the button of an action (shakes on a refusal)
function Hud.ButtonOf(action, slot)
	if action == "Cheer" then
		return Hud.cheer and Hud.cheer.Button or nil
	end
	if action == "Retreat" or action == "Engage" then
		return Hud.retreat and Hud.retreat.Button or nil
	end
	if action == "Buff" or action == "Swap" then
		for _, H in ipairs(Hud.helpers or {}) do
			if H.unit and H.unit.slot == slot then
				return action == "Swap" and H.Swap or H.Face
			end
		end
		return nil
	end
	local A = Hud.buttons and Hud.buttons[action]
	return A and A.Button or nil
end

----------------------------------------------------------------------
-- the result card (bottom right; compact: top right; never centred)
----------------------------------------------------------------------
-- (Pitch 2 item 02, option B "Count-up list", the owner's pick: .superpowers/slop-audit/round3/build/PITCH2/A_battle_hud/
-- 02_result_card_optB.png) every battle end is one template, Hud.ResultModel's parts in one layout: the head band in the
-- result's colour (its pixel icon and word), the mode - reason line, the stat rows (a label, its value right-aligned and a
-- green tick block each), the reward chips (equal widths: the number big, its icon 18 px, the word under it on a wide
-- screen), the notes (a line that pays nothing: "First clear!", "No hits on the boss: no reward"), and OK the card's whole
-- width, its lip in five parts = the auto-close timer
function Hud.ResultModel(B, payload)
	local outcome = payload.Outcome
	if outcome == nil then
		outcome = payload.Won and "Win" or "Loss"
	end
	local raid = B.Mode == "Raid"
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local M = { stats = {}, chips = {}, notes = {} }
	-- the head: its word, colour and icon (the word stays the game's own; the colour by result)
	M.title, M.color, M.icon = "DEFEAT", SIGN.Red, "skull"
	if outcome == "Win" then
		M.title, M.color, M.icon = raid and "BOSS DEFEATED!" or "VICTORY!", SIGN.Grass, "trophy"
	elseif outcome == "Draw" then
		M.title, M.color, M.icon = "DRAW", SIGN.Sky, "sword"
	elseif outcome == "Left" then
		M.title, M.color, M.icon = "YOU LEFT", SIGN.Well, "clock"
	elseif raid then
		M.title = "THE BOSS WON"
	end
	local reasons = {
		BossDown = "The boss is down!",
		Wipe = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		KO = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		Timeout = "Time is up.",
		Forfeit = (outcome == "Win") and "Your opponent gave up." or "You gave up.",
		Left = "You left the battle.",
		Abandoned = "Everyone left.",
		Ended = "The raid has ended.",
		Error = "The battle was cancelled. No rewards were lost.",
		Void = "Both players left: this duel does not count.",
		Shutdown = raid and "The server is restarting: this fight pays like a loss." or "The server is restarting: this battle does not count.",
		Cleared = "Room cleared!",
		Fainted = "Your whole team fainted.",
	}
	if raid then
		-- (bug batch 6) a raid left by LEAVE, or by staying out of the fight area for the 3-2-1
		reasons.Left = "You left the raid: no reward."
		reasons.Area = "You left the fight area: no reward."
		local boss = (B.boss and B.boss.name) or Hud.lastBoss
		if boss then
			reasons.BossDown = tostring(boss) .. " is down"
		end
	end
	local why = reasons[tostring(payload.Reason)] or ""
	local mode = ({ Raid = "Boss raid", Dungeon = "Dungeon", Duel = "Duel" })[B.Mode]
	local extra = type(rw.Extra) == "table" and rw.Extra or {}
	local dg = B.Dungeon or {}
	if B.Mode == "Ring" then
		local ringWhy
		M.title, M.color, ringWhy = Ring.ResultTitle(B, payload, why)
		M.icon = M.title == "NEW RECORD!" and "star" or "crown"
		M.color = M.title == "NEW RECORD!" and SIGN.Gold or SIGN.Violet
		mode, why = "Champion Ring", tostring(ringWhy):gsub("^Champion Ring: ", "")
	elseif B.Mode == "Dungeon" then
		if outcome ~= "Win" then
			M.title, M.color, M.icon = "KNOCKED OUT", SIGN.Violet, "castle"
		end
		why = "Floor " .. tostring(num(extra.Floor, num(dg.Floor, 1))) .. " - Room " .. tostring(num(extra.Room, num(dg.Room, 1)))
	end
	why = tostring(why):gsub("[%.!]$", "")
	if mode and why ~= "" and not why:find("^Floor ") and not why:find("^%u%l+ is down$") then
		why = why:sub(1, 1):lower() .. why:sub(2)
	end
	M.sub = mode and (why ~= "" and (mode .. " - " .. why) or mode) or why
	-- the stat rows (key, icon, label, value, achieved: the green tick)
	-- (playtest 2026-11-28 C9) a tick only on a row the player achieved: a lost raid read "Tier Loss / Lives left 1 /
	-- Damage 100%" all ticked, a ring run that ended at 8 ticked "Best round 12"
	local won = outcome == "Win"
	local function stat(key, icon, text, value, achieved)
		M.stats[#M.stats + 1] = { key, icon, text, tostring(value), achieved == true }
	end
	local run = B.Mode == "Ring" and type(rw.Run) == "table" and rw.Run or nil
	if run then
		stat("Rounds", "crown", "Rounds won", num(run.Wins, 0), num(run.Wins, 0) > 0)
		stat("Round", "sword", "Last round", num(run.Round, num(rw.Round, B.Round)), run.Record ~= nil)
		if run.Record ~= nil then
			stat("Best", "star", "Best round", tostring(run.Record), true)
		elseif num(run.Best, 0) > 0 then
			stat("Best", "star", "Best round", num(run.Best, 0), false)
		end
	end
	-- (C9) the server's "Loss" medal (BattleCatalog.RaidTier on a lost raid) is no tier to show
	local realTier = rw.Tier and rw.Tier ~= "None" and rw.Tier ~= "Cooldown"
	if raid and realTier then
		stat("Damage", "sword", "Your share", tostring(floor(num(rw.Share, 0) * 100 + 0.5)) .. "%", won) -- (C9) the share of the damage, not "Damage"
		if rw.Tier ~= "Loss" then
			stat("Tier", "crown", "Tier", tostring(rw.Tier), won)
		end
	end
	-- (C9) on a loss only the dungeon keeps Lives left (the run's tries); a lost raid or duel had "Lives left 1" ticked
	if B.Fighter and B.Mode ~= "Ring" and (won or B.Mode == "Dungeon") then
		stat("Lives", "heart", "Lives left", B.lives or 0, won and num(B.lives, 0) > 0)
	end
	if B.Mode ~= "Ring" and num(B.renderT, 0) > 0 then
		stat("Time", "clock", "Fight time", fmtTime(B.renderT), won)
	end
	-- (look review round 1) a duel's trophy total after the fight (BattleService sends Rewards.TrophiesTotal)
	if B.Mode == "Duel" and rw.Practice ~= true and rw.Void ~= true and tonumber(rw.TrophiesTotal) then
		stat("Trophies", "trophy", "Trophies", Theme.Short(max(0, num(rw.TrophiesTotal, 0))), won)
	end
	-- the reward chips (key, icon, number, word)
	local function chip(key, icon, number, word)
		M.chips[#M.chips + 1] = { key, icon, number, word }
	end
	if run then
		chip("Cash", Config.Icons.Cash, "+" .. Ring.Money(run.Cash), "Cash")
		chip("Xp", "up", "+" .. Theme.Short(num(run.Xp, 0)), "Pet XP")
		if num(run.Tokens, 0) > 0 then
			chip("Tokens", Config.Icons.Tokens, "+" .. Theme.Short(num(run.Tokens, 0)), "Tokens")
		end
	else
		local tokens, gems, cash = num(rw.Tokens, 0), num(rw.Gems, 0), num(rw.Cash, 0)
		if tokens > 0 then
			chip("Tokens", Config.Icons.Tokens, "+" .. Theme.Short(tokens), "Tokens")
		end
		if cash > 0 then
			chip("Cash", Config.Icons.Cash, "+$" .. Theme.Short(cash), "Cash")
		end
		if gems > 0 then
			chip("Gems", "gem", "+" .. Theme.Short(gems), "Gems")
		end
		local trophies = num(rw.Trophies, 0)
		if trophies ~= 0 then
			chip("Trophies", "trophy", (trophies >= 0 and "+" or "") .. Theme.Short(trophies), "Trophies")
		end
		local xp = num(rw.Xp, 0)
		if xp > 0 then
			chip("Xp", "up", "+" .. Theme.Short(xp), "Pet XP")
		end
		local ups = num(rw.LevelUps, 0)
		if ups > 0 then
			chip("Ups", "star", Theme.Short(ups), ups == 1 and "Level up" or "Level ups")
		end
	end
	-- the notes: what pays nothing or is no number
	local function note(text, weak)
		M.notes[#M.notes + 1] = { text, weak == true }
	end
	if rw.Practice == true then
		note("Practice duel: no rewards", true)
	elseif B.Mode == "Duel" and rw.Void ~= true and num(rw.Trophies, 0) == 0 then
		-- (look review round 1: a "+0" chip on a VICTORY read as broken) a ranked duel that moved no trophies says so
		note("No trophies won or lost", true)
	end
	if rw.FirstClear == true then
		note("First clear!")
	end
	if rw.Tier == "None" then
		note("No hits on the boss: no reward", true)
	elseif rw.Tier == "Cooldown" then
		local wait = num(rw.AgainIn, 0)
		note(string.format("Rewards again in %d:%02d", floor(wait / 60), wait % 60), true)
	end
	if rw.SatOut == true then
		note("Sat out over half the fight: no pet this time", true)
	end
	if rw.EventPet then
		local name = tostring(rw.EventPet)
		if PetCatalog and PetCatalog.Get then
			local ok, d = pcall(PetCatalog.Get, rw.EventPet)
			if ok and type(d) == "table" and d.Name then
				name = d.Name
			end
		end
		note("New pet: " .. name)
	end
	if rw.Double == true then
		note("Double rewards")
	end
	if B.Mode == "Dungeon" and (extra.Name or dg.Name) then
		note(tostring(extra.Name or dg.Name))
	end
	return M
end

-- a text's width in design px at `size` in `role` (never under the face's ~0.56 em a letter, 4% to spare)
local function measureW(text, role, size)
	local ok, m = pcall(Theme.Measure, text, role, size)
	return math.ceil(max((ok and typeof(m) == "Vector2") and m.X or 0, #tostring(text) * size * 0.56) * 1.04)
end

-- (Pitch 2 item 02 B) THE result template, the one body of every end card: the head band in M.color with its icon and word
-- (Head), the mode - reason line (Reason), the stat rows (Stats: a label, the value right-aligned, a green tick each), the
-- equal reward chips (Chips), the notes (what pays nothing in the muted ink), OK across the whole inside width (OkButton)
-- with its lip in five parts (the auto-close timer). Built into `body` at the card's width; every part is tagged
-- ResultPart and the last build's parts go first. DungeonController's End card is built by it too
-- (BattleController.ResultTemplate). opts: W (design px), F (the card's scale on the screen: the readability floor and the
-- 44 px touch pad), Compact (a phone), Landscape, Cols (stat columns; default: two on a phone card 440 wide inside),
-- NoReason (no reason line: a landscape phone's End card where it has no room), OnOk.
-- -> { H = the content's height (the caller adds its lip), Ok, Segs = OK's five lip parts, ReasonRow = the reason line + gap }
function Hud.BuildResult(body, M, opts)
	for _, c in ipairs(body:GetChildren()) do
		if c:GetAttribute("ResultPart") then
			c:Destroy()
		end
	end
	local w = floor(opts.W)
	local compact, landscape = opts.Compact == true, opts.Landscape == true
	local P = K.PAD
	local inner = w - 2 * P
	local fpx = math.ceil(Hud.FloorPx() / max(0.05, opts.F or 1) - 1e-6)
	local function px(n)
		return max(n, fpx)
	end
	local function part(inst)
		inst:SetAttribute("ResultPart", true)
		return inst
	end
	-- the head band: the result's colour on its 4 px lip, the icon and the word centred together
	local headH = landscape and 44 or 52 -- (a landscape phone: a lower head, rows, chips and OK, the card ends above RUN)
	local ink = (M.color == SIGN.Grass) and SIGN.OnGrass or KB.Ink
	local head = part(make("Frame", { Name = "Head", BackgroundColor3 = M.color, BorderSizePixel = 0, Size = UDim2.fromOffset(w, headH), ZIndex = 2 }, body))
	make("Frame", { Name = "Lip", BackgroundColor3 = Theme.SignLipOf and Theme.SignLipOf(M.color) or KB.Edge, BorderSizePixel = 0, Position = UDim2.fromOffset(0, headH - 4), Size = UDim2.fromOffset(w, 4), ZIndex = 2 }, head)
	local title = Theme.StyleTitle(label(head, "", "Title", 30, { Name = "Title", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3 }), "Section")
	title.TextColor3 = ink
	local iconPx = 27
	local tw = Hud.FitLine(title, M.title, px(compact and 26 or 30), px(20), inner - iconPx - 8)
	local gx = floor((w - (iconPx + 8 + tw)) / 2)
	local icon = PixelIcon.New(head, M.icon, iconPx, ink)
	icon.Name = "Icon"
	icon.ZIndex = 3
	icon.Position = UDim2.fromOffset(gx, floor((headH - 4 - iconPx) / 2))
	title.Position = UDim2.fromOffset(gx + iconPx + 8, 0)
	-- (look review: the word's box was its measured width, and the drawn face ran 7% past it) the box runs to the card's
	-- inner right edge; the word, left-aligned, sits where it was measured
	title.Size = UDim2.fromOffset(max(tw + 4, w - P - (gx + iconPx + 8)), headH - 4)
	local y = headH + 8
	-- the mode - reason line (Body.Reason), centred, muted; as many lines (up to 3) as its width needs, 8% to spare
	local reasonRow = 0
	if M.sub ~= "" and opts.NoReason ~= true then
		local rpx = px(18)
		local lines = clamp(math.ceil(measureW(M.sub, "Heading", rpx) * 1.08 / max(1, inner)), 1, 3)
		local rh = lines * (rpx + 4) + 2
		part(label(body, M.sub, "Heading", rpx, { Name = "Reason", Position = UDim2.fromOffset(P, y), Size = UDim2.fromOffset(inner, rh), TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = lines > 1, TextColor3 = KB.Muted }))
		reasonRow = rh + 6
		y = y + reasonRow
	end
	-- the stat rows: one column (two on a wide phone card), 34 px each over a 2 px stone rule
	local cols = opts.Cols or ((compact and inner >= 440) and 2 or 1)
	local colGap = 14
	local colw = floor((inner - (cols - 1) * colGap) / cols)
	local rowH, ruleH = landscape and 30 or 34, 2
	local stats = part(make("Frame", { Name = "Stats", BackgroundTransparency = 1, Position = UDim2.fromOffset(P, y), Size = UDim2.fromOffset(inner, 1) }, body))
	local nRows = math.ceil(#M.stats / cols)
	for i, s in ipairs(M.stats) do
		local c, r = (i - 1) % cols, floor((i - 1) / cols)
		-- (P2 fix A look review r1: the ring's 3 stats in 2 columns left an empty cell) an odd last stat spans the line
		local colw = (cols > 1 and c == 0 and i == #M.stats) and inner or colw
		local row = make("Frame", { Name = "Stat_" .. s[1], BackgroundTransparency = 1, Position = UDim2.fromOffset(c * (colw + colGap), r * (rowH + ruleH)), Size = UDim2.fromOffset(colw, rowH + ruleH) }, stats)
		make("Frame", { Name = "Rule", BackgroundColor3 = SIGN.StoneLip, BorderSizePixel = 0, Position = UDim2.fromOffset(0, rowH), Size = UDim2.fromOffset(colw, ruleH) }, row)
		local ic = PixelIcon.New(row, s[2], 18, KB.Ink)
		ic.Name = "Icon"
		ic.Position = UDim2.fromOffset(0, floor((rowH - 18) / 2))
		-- the tick: a green kit block (26 drawn: 22 + its 2 px edge) with the check
		-- (playtest 2026-11-28 C9) not on a row the player did not achieve (s[5] false; a model without the field keeps it;
		-- the dungeon's End card sets it too, R.endModel); the value keeps its place either way
		local tick = make("Frame", { Name = "Tick", Visible = s[5] ~= false, BackgroundColor3 = SIGN.Grass, BorderSizePixel = 0, Position = UDim2.fromOffset(colw - 24, floor((rowH - 22) / 2)), Size = UDim2.fromOffset(22, 22) }, row)
		signEdge(tick, SIGN.GrassLip, 2)
		local ck = PixelIcon.New(tick, "check", 18, SIGN.OnGrass)
		ck.Name = "Check"
		ck.Position = UDim2.fromOffset(2, 2)
		local vpx = px(22)
		local val = label(row, "", "Display", vpx, { Name = "Value", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = KB.Ink })
		local valueRoom = colw - 24 - 30 - 8 - 60
		local vw = Hud.FitLine(val, s[4], vpx, px(18), valueRoom) + 4 -- (4 px to spare: a one-digit value reads tight)
		local lab = label(row, "", "Heading", px(18), { Name = "Label", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Muted })
		local lw = Hud.FitLine(lab, s[3], px(18), px(16), colw - 24 - 30 - 6 - vw - 12) + 4
		-- (look review: "Damage" and "34%" ran past their measured boxes) the free run between the label's end and the
		-- value's start is split in the middle: each box takes its half, the texts stay where they were measured
		local valueR = colw - 30 - 6
		local mid = floor(((24 + lw) + (valueR - vw)) / 2)
		lab.Position = UDim2.fromOffset(24, 0)
		lab.Size = UDim2.fromOffset(max(lw, mid - 2 - 24), rowH)
		val.Position = UDim2.fromOffset(min(valueR - vw, mid + 2), 0)
		val.Size = UDim2.fromOffset(valueR - min(valueR - vw, mid + 2), rowH)
	end
	stats.Size = UDim2.fromOffset(inner, max(1, nRows * (rowH + ruleH)))
	stats.Visible = #M.stats > 0
	if #M.stats > 0 then
		y = y + nRows * (rowH + ruleH) + 8
	end
	-- the reward chips: equal widths, three a row (two on a card under 360 inside); the number big with its 18 px icon, the
	-- word under it (a phone: none)
	local perRow = min(inner < 360 and 2 or 3, max(1, #M.chips))
	local chipGap = 8
	local cw = floor((inner - (perRow - 1) * chipGap) / perRow)
	local chipH = compact and (landscape and 40 or 44) or 74
	local chips = part(make("Frame", { Name = "Chips", BackgroundTransparency = 1, Position = UDim2.fromOffset(P, y), Size = UDim2.fromOffset(inner, 1) }, body))
	local chipRows = math.ceil(#M.chips / perRow)
	for i, c in ipairs(M.chips) do
		local col, r = (i - 1) % perRow, floor((i - 1) / perRow)
		local f = make("Frame", { Name = "Chip_" .. c[1], BackgroundColor3 = SIGN.Well, BorderSizePixel = 0, Position = UDim2.fromOffset(col * (cw + chipGap) + 2, r * (chipH + chipGap) + 2), Size = UDim2.fromOffset(cw - 4, chipH - 4) }, chips)
		signEdge(f, SIGN.WellEdge, 2)
		local fw = cw - 4
		local npx = px(compact and 22 or 26)
		local numL = label(f, "", "Display", npx, { Name = "Number", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink })
		local nw = Hud.FitLine(numL, c[3], npx, px(18), fw - 16 - 24) + 4
		local lineH = compact and (chipH - 4) or 34
		local nx = floor((fw - (18 + 6 + nw)) / 2)
		local ic = PixelIcon.New(f, c[2], 18, KB.Ink)
		ic.Name = "Icon"
		ic.Position = UDim2.fromOffset(nx, floor((lineH - 18) / 2) + (compact and 0 or 4))
		numL.Position = UDim2.fromOffset(nx + 24, compact and 0 or 4)
		numL.Size = UDim2.fromOffset(max(nw + 2, fw - 4 - (nx + 24)), lineH) -- (to the chip's inner right: room for the drawn face)
		if not compact then
			local word = label(f, "", "Heading", px(18), { Name = "Label", TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = KB.Muted })
			local ww = min(fw - 4, Hud.FitLine(word, c[4], px(18), px(16), fw - 12) + 8) -- (8 px to spare: a short word reads tight at 0.8)
			word.Position = UDim2.fromOffset(floor((fw - ww) / 2), 38)
			word.Size = UDim2.fromOffset(ww, 26)
		end
	end
	chips.Size = UDim2.fromOffset(inner, max(1, chipRows * chipH + max(0, chipRows - 1) * chipGap))
	chips.Visible = #M.chips > 0
	if #M.chips > 0 then
		y = y + chipRows * chipH + max(0, chipRows - 1) * chipGap + 8
	end
	-- the notes: a line each, its pixel icon before it (a line that pays nothing in the muted ink, no icon); a note may carry
	-- its own name (the dungeon's FirstClear / Unlocked)
	for i, n in ipairs(M.notes) do
		local npx = px(18)
		local lines = ((measureW(n[1], "Body", npx) + 28) * 1.08 > inner) and 2 or 1
		local nh = lines * (npx + 4) + 2
		local l = part(label(body, n[1], "Body", npx, { Name = n[3] or ("Note" .. i), Position = UDim2.fromOffset(P, y), Size = UDim2.fromOffset(inner, nh), TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = lines > 1, TextColor3 = n[2] and KB.Muted or KB.Ink }))
		local ic = not n[2] and (n[4] or Hud.RewardIcon(n[1]))
		if ic then
			PixelIcon.Lead(l, ic)
		end
		y = y + nh + 4
	end
	-- OK: the card's one green action across its whole inside width; its lip in five parts is the auto-close timer
	local okH = compact and (landscape and 40 or 44) or 50
	local ok = make("TextButton", { Name = "OkButton", Text = "OK", Position = UDim2.fromOffset(P, y), Size = UDim2.fromOffset(inner, okH), AutoButtonColor = false }, body)
	Theme.Style(ok, "Button", { Size = 22 })
	make("UIPadding", { Name = "LipPad", PaddingBottom = UDim.new(0, K.PLANK_LIP) }, ok)
	signBlock(ok, SIGN.Grass, SIGN.Grass, SIGN.OnGrass, K.PLANK_LIP, 2)
	local function press()
		if type(opts.OnOk) == "function" then
			opts.OnOk()
		end
	end
	ok.Activated:Connect(press)
	part(ok)
	-- (look review: OK was 32 px tall on a landscape phone) a thumb's 44 screen px: a clear hit pad (HitFor) centred on OK,
	-- over it, as LEAVE's; the plank keeps the pitch's height
	local hit = math.ceil(44 / max(0.05, opts.F or 1) - 1e-6)
	if okH < hit then
		local pad = make("TextButton", { Name = "OkHit", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = ok.ZIndex + 1,
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, floor(K.PLANK_LIP / 2)), Size = UDim2.new(1, 0, 0, hit) }, ok)
		pad:SetAttribute("HitFor", "OkButton")
		pad.Activated:Connect(press)
	end
	local lip = ok:FindFirstChild("Lip")
	local segs = {}
	if lip then
		local gap = 2
		local segW = floor((inner - 4 * gap) / 5)
		for i = 1, 5 do
			local sx = (i - 1) * (segW + gap)
			local sw = (i == 5) and (inner - sx) or segW
			segs[i] = make("Frame", { Name = "Seg" .. i, BackgroundColor3 = SIGN.GrassLip, BorderSizePixel = 0, Position = UDim2.fromOffset(sx, 0), Size = UDim2.new(0, sw, 1, 0), ZIndex = lip.ZIndex }, lip)
		end
	end
	y = y + okH + P
	if y % 2 == 1 then
		y = y + 1 -- (an even height: the wide screen's card is centred on its middle, on whole px)
	end
	Hud.FixText(body, opts.F or 1)
	return { H = y, Ok = ok, Segs = segs, ReasonRow = reasonRow }
end

-- (Pitch 2 item 02 B) the five lip parts of a template's OK lit for `frac` of the time left (the first k lit, the dark
-- grass; the rest gone into the face); `t` = { segs, count, lit } (the last lit count, so a repaint only on a change)
function Hud.PaintTimer(t, frac)
	if not t or not t.segs then
		return
	end
	local k = math.ceil(clamp(frac, 0, 1) * t.count - 1e-6)
	if k == t.lit then
		return
	end
	t.lit = k
	for i, s in ipairs(t.segs) do
		s.BackgroundColor3 = (i <= k) and SIGN.GrassLip or SIGN.Grass
	end
end

-- (Pitch 2 item 02 B, look review round 1) the touch buttons a phone's result card keeps off, as design px boxes { X, Y, R, B }
-- in our gui: the game's RUN and DASH (MovementController.MobileLayout, screen px from the bottom) and Roblox's jump
-- button; none without touch
function Hud.TouchBoxes(m)
	local out = {}
	if not m.Touch then
		return out
	end
	local f = max(0.05, m.F)
	local rects = Hud.TouchRects(m)
	for _, key in ipairs({ "dash", "run", "jump" }) do
		local r = rects[key]
		if type(r) == "table" and tonumber(r[1]) and tonumber(r[4]) then
			out[#out + 1] = { Name = key, X = r[1] / f, R = r[3] / f, Y = (m.VY - r[4] - m.Inset) / f, B = (m.VY - r[2] - m.Inset) / f }
		end
	end
	return out
end

-- (Pitch 2 item 02 B, look review round 1) a phone's place for the result card -> left, top (design px). A landscape phone:
-- the pitch's top middle (844x390: x 222, y 62), under the top-right stack only where the card reaches it (else left of it),
-- then slid left of / ended above a touch button it would lie on (the right edge put the card on DASH and RUN's top). A
-- portrait phone: the top right, under the top-right stack (the menu column steps aside where the card covers it).
-- (playtest 2026-11-28 C33) -> a 4th value, the width that clears a touch button the card can go neither left of nor
-- above (640x360: the RUN OVER card on RUN): the card at the left limit, Hud.ShowResult narrows it to that width
function Hud.ResultSpot(m, w, h, landscape)
	local gap = 8
	local stackBottom, stackLeft = Hud.TopRightBottom(m)
	local x, y, fitW
	local corner = false
	if landscape then
		local menuRight = Hud.MenuRight(m)
		local lo = (menuRight > 0) and (menuRight + gap) or gap
		x = max(lo, floor((m.W - w) / 2))
		y = 6
		if stackBottom > 0 and (stackLeft == nil or x + w + gap > stackLeft) then
			if stackLeft and floor(stackLeft - gap - w) >= lo then
				x = floor(stackLeft - gap - w)
			else
				y = stackBottom + gap
			end
		end
		for _, r in ipairs(Hud.TouchBoxes(m)) do
			if x < r.R + gap and r.X < x + w + gap and y < r.B + gap and r.Y < y + h + gap then
				local lx = floor(r.X - gap - w)
				if lx >= lo then
					x = lx
				else
					y = max(6, floor(r.Y - gap - h))
					if y + h + gap > r.Y then -- (C33) still on it
						x = lo
						fitW = min(fitW or math.huge, floor(r.X - gap - lo))
					end
				end
			end
		end
	else
		x = floor(m.W - math.ceil(8 / max(0.05, m.F)) - w) -- (8 screen px from the right edge)
		y = max(6, stackBottom > 0 and (stackBottom + 8) or 6)
		-- (P2 fix A: a battle's narrow stack of three strips started the card at 131, its foot over the screen's centre at
		-- 390 x 844) where under the stack the card would reach the centre, it takes the corner and the strips step aside
		-- while it is up (HudController.SetCurrencyHidden "BattleResult", as a phone's dungeon End card does; Hud.ShowResult)
		-- (weighed with the strips' bottom as the HUD laid them out, shown or stepped aside, so their step aside never
		-- turns the choice round on the next relayout)
		local held = Hud.HudAttr("TopRightBottom")
		local under = max(stackBottom, held and held / max(0.05, m.F) or 0)
		if (max(y, under + 8) + h) * m.F + m.Inset > m.VY / 2 then
			y = 6
			corner = true
		end
	end
	if y + h > m.H - 8 then
		y = max(6, floor(m.H - 8 - h))
	end
	return x, y, corner, fitW
end

-- (P2 fix A) the HUD's currency strips step aside while a portrait phone's result card takes the corner (Hud.ResultSpot)
function Hud.SetStripsAside(on)
	Hud.HoldStrips("BattleResult", on)
end

-- (P2 fix A r1) the HUD's currency strips held aside by `owner` (HudController.SetCurrencyHidden): "BattleResult" (the
-- result card's corner), "BattleKeys" (a short portrait phone's fight: under the boss strip they lay on DASH / TARGET),
-- "BattleList" (P2 fix round C: under the boss strip they pushed the enemy list into the centre band, Hud.StripsPushList)
function Hud.HoldStrips(owner, on)
	on = on == true
	Hud.stripHolds = Hud.stripHolds or {}
	if (Hud.stripHolds[owner] == true) == on then
		return
	end
	Hud.stripHolds[owner] = on or nil
	Hud.stripsAside = Hud.stripHolds.BattleResult == true
	if Mods.HudCtl == nil then
		Mods.HudCtl = optional(script.Parent, "HudController") or false
	end
	local hc = Mods.HudCtl
	if hc and type(hc.SetCurrencyHidden) == "function" then
		pcall(hc.SetCurrencyHidden, owner, on)
	end
end

-- (P2 fix A r1) whether the HUD's currency strips, as the HUD laid them out (shown or held aside: TopRightLeft /
-- TopRightBottom), reach an action key on a portrait phone (360 x 640 under the boss strip: DASH, TARGET)
function Hud.StripsOnKeys(m)
	local left, bottom = Hud.HudAttr("TopRightLeft"), Hud.HudAttr("TopRightBottom")
	if not (left and bottom and left > 0 and bottom > 0) then
		return false
	end
	local f = max(0.05, m.F)
	local x0, y1 = left / f, bottom / f
	for _, k in ipairs(Hud.KeyBoxes(m)) do
		if k.X1 > x0 and k.Y0 < y1 + 4 then
			return true
		end
	end
	return false
end

-- (P2 fix round C) whether the HUD's currency strips, as the HUD laid them out (shown or held aside), push the enemy list's
-- first row into the centre band under the boss strip (Hud.BandTop: 390 x 844 with a player's three strips), while from
-- topY (right under the boss strip) it would end above the band
function Hud.StripsPushList(B, m, topY)
	if #Hud.EnemyList(B) == 0 then
		return false
	end
	local left, bottom = Hud.HudAttr("TopRightLeft"), Hud.HudAttr("TopRightBottom")
	if not (left and bottom and left > 0 and bottom > 0) then
		return false
	end
	local rowH = m.Compact and K.ROW_H_COMPACT or K.ROW_H
	local band = Hud.BandTop(m)
	return math.ceil(bottom / max(0.05, m.F)) + 6 + rowH > band and topY + rowH <= band
end

function Hud.ShowResult(B, payload)
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	local res = Hud.result
	local body = res:FindFirstChild("Body") or res
	local M = Hud.ResultModel(B, payload)
	local card = Hud.resultCard
	if card and card.SetColor then
		pcall(card.SetColor, SIGN.StoneLip) -- (the head carries the result's colour; the card's lip is the stone one)
	end
	local compact = m.Compact
	local landscape = compact and m.Landscape
	local w = K.RESULT_W
	if landscape then
		w = min(500, floor(m.W / 2 - 16)) -- (the pitch's phone card, 500 wide where it fits)
	elseif compact then
		w = min(K.RESULT_W, m.W - 16)
	end
	w = floor(w)
	local built, h
	local noReason = false
	local function build()
		built = Hud.BuildResult(body, M, { W = w, F = m.F, Compact = compact, Landscape = landscape, NoReason = noReason, OnOk = function()
			Hud.HideResult()
		end })
		h = built.H + K.PLANK_LIP
	end
	build()
	if landscape then
		-- (playtest 2026-11-28 C33) a card that can go neither left of nor above a touch button (the RUN OVER card on RUN
		-- at 640x360) is narrowed to end before it (not under K.RESULT_MIN_W)
		-- (C33 review) only to a form that ends on the screen (its highest top 6, 8 px clear of the foot: Hud.ResultSpot): a
		-- narrower card is taller (the raid win's reason wrapped to two lines and its card ran past 640x360's foot, OK's
		-- timer lip off it), so it drops the reason line where only that fits (the dungeon End card's rule, NoReason), else
		-- it keeps its width
		local _, _, _, fitW = Hud.ResultSpot(m, w, h, landscape)
		if fitW and fitW < w and fitW >= K.RESULT_MIN_W then
			local fullW = w
			w = fitW
			build()
			if 6 + h > m.H - 8 then
				noReason = true
				build()
			end
			if 6 + h > m.H - 8 then
				w, noReason = fullW, false
				build()
			end
		end
	end
	Hud.resultTimer = { segs = built.Segs, count = 5, lit = -1 }
	Hud.SetResultTimer(1)
	res.Size = UDim2.fromOffset(w, h)
	Hud.SetTopReserve(nil) -- (P2 fix A) the boss strip goes with the fight: the HUD's strips back at the top first
	local top = Hud.TopRightBottom(m)
	local left, cardTop
	if compact then
		-- a phone: the pitch's top middle on a landscape phone, the top right on a portrait one (Hud.ResultSpot)
		-- (DailyController hides its Gift block while this card is up: BattleController.IsOpen)
		local corner
		left, cardTop, corner = Hud.ResultSpot(m, w, h, landscape)
		Hud.SetStripsAside(corner)
		res.AnchorPoint = Vector2.new(0, 0)
		res.Position = UDim2.fromOffset(left, cardTop)
	else
		-- a wide screen: the right edge, its middle (the pitch's place), under the top-right stack
		Hud.SetStripsAside(false)
		local cy = max(floor(m.H / 2), (top > 0 and top + 8 or K.EDGE) + h / 2)
		cy = min(cy, m.H - K.EDGE - h / 2)
		res.AnchorPoint = Vector2.new(1, 0.5)
		res.Position = UDim2.new(1, -K.EDGE, 0, floor(cy))
		left, cardTop = m.W - K.EDGE - w, floor(cy) - h / 2
	end
	-- (LOOK-ui2: at 390x844 the Pets, Index and Home tiles covered the card's left 37 px) where the card would lie on the menu
	-- column, the column steps aside while it is up (Hud.HideResult brings it back); where the card clears it, it stays
	local col = Hud.MenuBox(m)
	local covers = false
	if col and compact then
		covers = col.Right + 8 > left and col.Left < left + w + 8 and col.Bottom > cardTop and col.Top < cardTop + h
	end
	res.Visible = true
	Hud.FixText(res, m.F)
	Ring.HideNext()
	Hud.top.Visible = false
	Hud.team.Visible = false
	Hud.cmd.Visible = false
	Hud.enemies.Visible = false
	Hud.teamPlace = nil
	Hud.SetMenuHidden(covers)
	Hud.SetVitalsHidden(false)
	-- (Pitch 2 item 02 B) a phone's card where it would lie on the vitals card (a landscape phone: the pitch's card and the
	-- vitals card cannot both fit): the vitals card steps aside while the result is up (owner "Result"), back the moment
	-- the card closes (Hud.HideResult); anywhere else it is back with the card
	local onVitals = false
	if compact then
		local v = CheerUp.Layout()
		if v then
			local f = m.F
			local x0, y0 = left * f, cardTop * f
			local x1, y1 = (left + w) * f, (cardTop + h) * f
			onVitals = x0 < v.X + v.W and v.X < x1 and y0 < v.Y + v.H and v.Y < y1
		end
	end
	Hud.SetVitalsHeld("Result", onVitals)
	Leave.Place(m, nil, false)
	CheerUp.Place(m, nil, false)
	Retreat.Place(m, nil, false)
	AreaWarn.Hide()
	local keep = St.result and St.result.payload == payload and St.result.t0 -- a relayout (rotation) keeps the timer
	St.result = { t0 = keep or os.clock(), dur = K.RESULT_SECONDS, battle = B, payload = payload }
	Me.MouseHold("BattleResult", true) -- the cursor is free for the card's OK
	BattleController._wake()
end

-- (Pitch 2 item 02 B) OK's lip: the first k of its five parts lit (the dark grass), the rest gone into the face
function Hud.SetResultTimer(frac)
	Hud.PaintTimer(Hud.resultTimer, frac)
end

function Hud.RewardLines(B, rw)
	local lines = {}
	local tokens = num(rw.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.Short(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	local gems = num(rw.Gems, 0)
	if gems > 0 then
		lines[#lines + 1] = { "+" .. Theme.Short(gems) .. " Gems", Theme.Currency.Gems.Color }
	end
	local cash = num(rw.Cash, 0)
	if cash > 0 then
		lines[#lines + 1] = { "+$" .. Theme.Short(cash) .. " Cash", Theme.Currency.Cash and Theme.Currency.Cash.Color or COLORS.Mine }
	end
	if rw.Practice == true then
		lines[#lines + 1] = { "Practice duel: no rewards", COLORS.Weak }
	end
	local trophies = num(rw.Trophies, 0)
	if trophies ~= 0 or (B.Mode == "Duel" and rw.Practice ~= true and rw.Void ~= true) then
		lines[#lines + 1] = { (trophies >= 0 and "+" or "") .. tostring(trophies) .. " Trophies", trophies >= 0 and COLORS.Gold or COLORS.Enemy }
	end
	local xp = num(rw.Xp, 0)
	if xp > 0 then
		lines[#lines + 1] = { "+" .. Theme.Short(xp) .. " Pet XP", COLORS.Ally }
	end
	if rw.FirstClear == true then
		lines[#lines + 1] = { "First clear!", COLORS.Mine }
	end
	if rw.Tier == "None" then
		lines[#lines + 1] = { "No hits on the boss: no reward", COLORS.Weak }
	elseif rw.Tier == "Cooldown" then
		-- a boss raid won inside the 20 minute reward limit: nothing paid, the server says when
		local wait = num(rw.AgainIn, 0)
		lines[#lines + 1] = { string.format("Rewards again in %d:%02d", floor(wait / 60), wait % 60), COLORS.Weak }
	elseif rw.Tier then
		local share = num(rw.Share, 0)
		lines[#lines + 1] = { tostring(rw.Tier) .. " tier", COLORS.Gold }
		lines[#lines + 1] = { tostring(floor(share * 100 + 0.5)) .. "% of the damage", Color3.fromRGB(150, 110, 220) }
	end
	if rw.SatOut == true then
		-- a won raid with the pet back for over half of the team's time: the medal is paid, the Boss Raid pet roll is not (rw.Reason, the server's
		-- toast, says the long version)
		lines[#lines + 1] = { "Sat out over half the fight: no pet this time", COLORS.Weak }
	end
	if rw.EventPet then
		local name = tostring(rw.EventPet)
		if PetCatalog and PetCatalog.Get then
			local ok, d = pcall(PetCatalog.Get, rw.EventPet)
			if ok and type(d) == "table" and d.Name then
				name = d.Name
			end
		end
		lines[#lines + 1] = { "New pet: " .. name, Color3.fromRGB(236, 110, 170) }
	end
	local ups = num(rw.LevelUps, 0)
	if ups > 0 then
		lines[#lines + 1] = { ups == 1 and "1 level up!" or (ups .. " level ups!"), COLORS.Mine }
	end
	if rw.Double == true then
		lines[#lines + 1] = { "Double rewards", COLORS.Gold }
	end
	return lines
end

function Hud.HideResult()
	St.result = nil
	Hud.SetVitalsHeld("Result", false) -- (Pitch 2 item 02 B) the vitals card back with the card's close
	Hud.SetStripsAside(false) -- (P2 fix A) the strips back with it
	Me.MouseHold("BattleResult", false)
	if Hud.result then
		Hud.result.Visible = false
	end
	-- (LOOK-ui2) the menu column back (a phone kept it aside for the card), unless a fight holds the left edge again
	if not (Hud.team and Hud.team.Visible) then
		Hud.SetMenuHidden(false)
	end
	if not St.battle then
		Hud.SetVisible(false)
	end
end

-- (LOOK-ui2) a reward line's pixel icon (the End card's fact tags): by what the line pays; nil for a line that pays nothing
local REWARD_ICONS = {
	{ "Tokens", Config.Icons.Tokens }, { "Gems", "gem" }, { "Cash", Config.Icons.Cash }, { "Trophies", "trophy" },
	{ "Pet XP", "up" }, { "level up", "up" }, { "Rounds won", "crown" }, { "Best: round", "star" }, { "First clear", "star" },
	{ " tier", "crown" }, { "of the damage", "sword" }, { "New pet", "paw" }, { "Lives left", "heart" }, { "Floor ", "key" },
	{ "Double rewards", "sparkle" },
}
function Hud.RewardIcon(text)
	text = tostring(text or "")
	if text:find("no reward", 1, true) or text:find("Practice", 1, true) or text:find("Sat out", 1, true) or text:find("Rewards again", 1, true) then
		return nil
	end
	for _, pair in ipairs(REWARD_ICONS) do
		if text:find(pair[1], 1, true) then
			return pair[2]
		end
	end
	return nil
end

-- (LOOK-ui2) the lowest bottom edge of the HUD's top-right stack in our design px (the wallet's strips, the boost chips):
-- 0 when none sits in the top band's right half. (Pitch 2 item 02 B, look review) second: the stack's left edge (design
-- px), nil when there is none
function Hud.TopRightBottom(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return 0, nil
	end
	local f = max(0.05, m.F)
	local bottom, curLeft = Hud.CurrencyTop(m)
	local left = (bottom > 0 and curLeft and curLeft > 0) and curLeft or nil
	for _, spec in ipairs({ { "NimbusBoosts", "Chip_Cash" }, { "NimbusBoosts", "Chip_Xp" } }) do
		local g = pg:FindFirstChild(spec[1])
		local o = g and g:IsA("ScreenGui") and g.Enabled and g:FindFirstChild(spec[2], true)
		if o and o:IsA("GuiObject") and o.Visible and o.AbsoluteSize.X > 0 then
			local p, sz = o.AbsolutePosition, o.AbsoluteSize
			local dy = g.IgnoreGuiInset and -m.Inset or 0
			if p.Y + dy < m.VY * 0.3 and p.X > m.VX * 0.5 then
				bottom = max(bottom, math.ceil((p.Y + dy + sz.Y) / f))
				left = min(left or math.huge, floor(p.X / f))
			end
		end
	end
	return bottom, left
end

function Hud.UpdateResult(now)
	local r = St.result
	if not r then
		return
	end
	local p = (now - r.t0) / r.dur
	if p >= 1 then
		Hud.HideResult()
		return
	end
	Hud.SetResultTimer(1 - p)
end

function Hud.SetVisible(on)
	if not on then
		-- (quick wins, review round 1) the holds on other controllers are let go first, with or without the battle gui:
		-- a path that ever clears Hud.gui early can never leave the menu column or the player's HP card hidden
		Hud.SetMenuHidden(false)
		Hud.SetVitalsHidden(false)
		Hud.SetVitalsHeld("Result", false)
		Hud.SetTopReserve(nil) -- (P2 fix A) the HUD's strips back at the top
		Hud.SetStripsAside(false)
		Hud.HoldStrips("BattleKeys", false)
		Hud.HoldStrips("BattleList", false)
	end
	if not Hud.gui then
		return
	end
	if not on then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.enemies.Visible = false
		Hud.teamPlace = nil
		if Hud.leave then
			Hud.leave.Visible = false
		end
		CheerUp.Place(Hud.m or {}, nil, false)
		Retreat.Place(Hud.m or {}, nil, false)
		AreaWarn.Hide()
	end
end

-- the menu column (MenuController) steps aside while the battle HUD holds the left edge
function Hud.SetMenuHidden(on)
	on = on == true
	if (Hud.menuHidden == true) == on then
		return
	end
	local module = script.Parent:FindFirstChild("MenuController")
	local ok, menu = pcall(function()
		return module and require(module)
	end)
	if ok and type(menu) == "table" and type(menu.SetColumnHidden) == "function" and pcall(menu.SetColumnHidden, on) then
		Hud.menuHidden = on
	elseif not on then
		Hud.menuHidden = false
	end
end

-- quick wins (win 4): a fighter's own HP / stamina card (HudController) steps aside for the fight on every screen; Cheer up! and
-- Retreat take its slot (CheerUp.Layout). Our owner key is "Battle": another owner's hide (the Gifts window, "Daily") is never
-- released here, and HudController shows the card when the last owner lets go
-- (Pitch 2 item 02 B) a hide of the vitals card under another owner key ("Result": the phone's result card lies on it)
function Hud.SetVitalsHeld(owner, on)
	if Mods.HudCtl == nil then
		Mods.HudCtl = optional(script.Parent, "HudController") or false
	end
	local hc = Mods.HudCtl
	if hc and type(hc.SetVitalsHidden) == "function" then
		pcall(hc.SetVitalsHidden, owner, on == true)
	end
end

-- (P2 fix A, item 06 A) a portrait phone's boss fight: the top card is the pitch's strip across the top (Hud.Rebuild lays
-- it out first; the fighter card, the enemy list and the HUD's strips go under it)
function Hud.BandMode(B, m)
	-- (keys lane, look fixA r1 minor: the duel's one-row card dropped to the middle left at 390 x 844, between the helpers
	-- and the enemy list, and at 360 x 640 the list lay on the fighter card) a duel's card is placed as the raid's and the
	-- dungeon's: the strip across the top, the team and the list under it. (kit-b backlog 9: the Champion Ring's rounds and
	-- the trials fought as them kept the old card under the fighter card: at 360 x 640 enemy row 1 lay 15-18 px on the
	-- fighter card and 'Round 8' read 'Ro...' in a 40 px box, at 390 x 844 the card lay 37.6 px on the fighter card) the
	-- ring's card spans the top too
	return m.Compact == true and not m.Landscape and (Hud.BossUnit(B) ~= nil or B.Mode == "Duel" or B.Mode == "Ring")
end

-- (P2 fix A) whether the fighter's block (the card and its helpers), its top at y (design px) under the boss strip, ends
-- above the vitals slot's Cheer up! / Retreat stack (CheerUp.Place stands them on the slot's bottom edge, Retreat above).
-- extra: design px more under the block (look review r1: the enemy list's first row there, Hud.ListMinH)
function Hud.BandRoom(B, m, y, extra)
	local _, teamH = Hud.LayoutFighter(B, m)
	return y + (tonumber(teamH) or 0) + (tonumber(extra) or 0) <= Hud.StackTop(B, m)
end

-- (P2 fix A r1) the top (design px) of the vitals slot's Cheer up! / Retreat stack (stacked, the tallest it gets), the
-- screen's foot without a vitals card
function Hud.StackTop(B, m)
	if Hud.ThreeKeys(m) then
		-- (Pitch 2 item 1b) the three keys' layout: the team orders' row goes under the fighter's block (CheerUp.TeamSpots),
		-- which ends above Roblox's stick
		local f = max(0.05, m.F)
		local small = min(m.VX, m.VY) <= K.STICK_SMALL_PHONE
		local stickH = small and ((m.VY > m.VX) and K.STICK_H_TALL or K.STICK_H_WIDE) or K.STICK_H_LARGE
		local row = (CheerUp.Allowed(B) or Retreat.Allowed(B)) and (K.TEAM_KEY_H_PX + 10) / f or 0
		return m.H - (stickH + 6) / f - row -- (6 px off the stick's zone: no ink there to keep air from)
	end
	local v = CheerUp.Layout()
	if not v then
		return math.huge
	end
	local f = max(0.05, m.F)
	local h = K.CHEER_H
	if m.Touch then
		h = max(h, K.CHEER_TOUCH_PX / f)
	end
	local gap = K.CHEER_GAP_PX / f
	local stack = (CheerUp.Allowed(B) and (h + gap) or 0) + (Retreat.Allowed(B) and (h + gap) or 0)
	return (v.Y + v.H) / f - stack
end

-- (P2 fix A r1) the enemy list's first row and its "+n more" tag (design px), 0 without enemies
function Hud.ListMinH(B, m)
	local n = #Hud.EnemyList(B)
	if n == 0 then
		return 0
	end
	-- (keys look r5 c06) the tag under the first row keeps that row's air (Hud.LayoutEnemies: its bracket's)
	local air = Hud.ListAir(m, true)
	return (m.Compact and K.ROW_H_COMPACT or K.ROW_H) + ((n > 1) and (24 + air - K.ROW_GAP) or 0)
end

-- (keys look r5 c06: K.ROW_GAP's 6 design px left two rows' 2 px frames 0.8 px apart; the locked row's gold bracket, 4
-- design px out and its 3 px stroke (2 on a phone), lay 2.4-3 px on the next row's frame and on "+n more") design px
-- after an enemy row, to the next row or the "+n more" tag (under it or beside it): both 2 px frames (SignKit.Px: whole
-- screen px) and K.INK_AIR_PX of air; after the bracketed row its reach and stroke instead of its frame
function Hud.ListAir(m, bracket)
	local f = max(0.05, (m and m.F) or 1)
	local edge = SignKit.Px(K.SMALL_EDGE, f) * f
	if bracket then
		return 4 + Hud.Air(m, SignKit.Px(3, f) * f + edge + K.INK_AIR_PX)
	end
	return max(K.ROW_GAP, Hud.Air(m, 2 * edge + K.INK_AIR_PX))
end

-- (P2 fix A r1) whether the right column holds the enemy list's first row (and its "+n more" tag) from `top` (design px):
-- above the action keys under it (Hud.ClusterLayout, as Hud.LayoutEnemies weighs them) and clear of the fighter card,
-- whose block starts at y (at 360 x 640 the card reaches past the list's left edge)
function Hud.ListFits(B, m, top, y)
	local need = Hud.ListMinH(B, m)
	if need <= 0 then
		return true
	end
	local w = m.Compact and K.ROW_W_COMPACT or K.ROW_W
	local left, right = m.W - K.EDGE - w, m.W - K.EDGE
	local cardRight = K.EDGE + (Hud.fighterCard and Hud.fighterCard.Root.Size.X.Offset or (m.Compact and K.FC_W_COMPACT or K.FC_W))
	local cardBottom = y + (Hud.fighterCard and Hud.fighterCard.Root.Size.Y.Offset or 0)
	-- (390 x 844 keeps its look: the list's left edge on the card's right edge, 0.6 px apart)
	if left < cardRight - 2 and top < cardBottom + 8 then
		return false
	end
	-- (Pitch 2 item 1b: the three keys' team row leaves the block more room under the strip, so a 360 x 640 phone keeps the
	-- helpers side by side there) the helpers side by side under the card reach further right than the card: clear of them too
	if Hud.helpersRow and Hud.helperHolder then
		local _, teamH = Hud.LayoutFighter(B, m)
		if left < K.EDGE + Hud.helperHolder.Size.X.Offset - 2 and top < y + teamH + 8 then
			return false
		end
	end
	if m.Touch and m.VY >= m.VX then
		for _, k in ipairs(Hud.KeyBoxes(m)) do
			if k.X1 > left and k.X0 < right and top + need > k.Y0 - 4 then
				return false
			end
		end
	end
	return true
end

-- the portrait action keys' boxes (their wood edge too) in our design px { X0, X1, Y0, Y1 } (Hud.ClusterLayout)
function Hud.KeyBoxes(m)
	local keys = {}
	for _, spec in pairs(Hud.ClusterLayout(m)) do
		if type(spec) == "table" then
			local r = spec[3] / 2 + K.KEY_EDGE
			keys[#keys + 1] = { X0 = m.W + spec[1] - r, X1 = m.W + spec[1] + r, Y0 = m.H + spec[2] - r, Y1 = m.H + spec[2] + r }
		end
	end
	return keys
end

-- (P2 fix A r1) the list's "+n more" tag beside a row at rowTop (h tall) of the list whose left edge is `left`: right of
-- the row, on the screen, clear of every key. Returns its text ("+n more", else the short "+n" beside the row) or nil
function Hud.TagBeside(m, left, rowTop, h, more, keys, gap)
	local px = max(16, math.ceil(Hud.FloorPx() / max(0.05, m.F) - 1e-6))
	local w = m.Compact and K.ROW_W_COMPACT or K.ROW_W
	local y0 = rowTop + floor((h - 22) / 2)
	local y1 = y0 + 22
	for _, text in ipairs({ "+" .. more .. " more", "+" .. more }) do
		-- (keys look r5 c06: the row's air, Hud.ListAir; its bracket's beside the locked row)
		local x0 = left + w + (gap or K.ROW_GAP)
		local x1 = x0 + math.ceil(textWidth(text, px)) + 18
		local clear = x1 <= m.W - K.EDGE
		for _, k in ipairs(keys or {}) do
			if clear and k.X1 > x0 - 4 and k.X0 < x1 + 4 and k.Y0 < y1 + 4 and (k.Y1 or math.huge) > y0 - 4 then
				clear = false
			end
		end
		if clear then
			return text
		end
	end
	return nil
end

-- (P2 fix A, item 06 A) the band the boss strip spans at the top (gui-area px), nil = none: the HUD's strips start under it
function Hud.SetTopReserve(bottom)
	bottom = (type(bottom) == "number" and bottom > 0) and bottom or nil
	if Hud.topReserve == bottom then
		return
	end
	Hud.topReserve = bottom
	if Mods.HudCtl == nil then
		Mods.HudCtl = optional(script.Parent, "HudController") or false
	end
	local hc = Mods.HudCtl
	if hc and type(hc.SetTopReserve) == "function" then
		pcall(hc.SetTopReserve, "Battle", bottom)
	end
end

-- a layout attribute the HUD publishes on NimbusHud (gui-area px), nil when absent
function Hud.HudAttr(name)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local v = hud and hud:GetAttribute(name)
	return type(v) == "number" and v or nil
end

function Hud.SetVitalsHidden(on)
	if Mods.HudCtl == nil then
		Mods.HudCtl = optional(script.Parent, "HudController") or false
	end
	local hc = Mods.HudCtl
	if hc and type(hc.SetVitalsHidden) == "function" then
		pcall(hc.SetVitalsHidden, "Battle", on == true)
	end
end

-- MovementController (the battle dash keys, free dash, battle speed); nil when missing
function Hud.Movement()
	if Mods.Movement == nil then
		Mods.Movement = optional(script.Parent, "MovementController") or false
	end
	return Mods.Movement or nil
end

----------------------------------------------------------------------
-- LEAVE: stops a Champion Ring run (BattleCommand "Forfeit"; the server ends the run cleanly and the climber comes
-- back at the portal) or leaves a boss raid (bug batch 6: the server's leaveRaid, as walking out: no reward, no rejoin of that
-- fight, a pocket raider back at the gate). Never in duels (a forfeit costs trophies) or the dungeon (DungeonController's LEAVE).
-- Two presses: the first turns it into "Sure? Tap again" (a raid: "No reward! Tap again") for LEAVE_CONFIRM seconds, the
-- second sends it. One button beside the action cluster and one on the ring's next-round card; both share the confirm state.
----------------------------------------------------------------------
Leave.armedUntil = 0
Leave.sentUntil = 0
Leave.buttons = {}
-- (kit-b U9-6) a style's kit B block: { face, lip, ink }. Leave is danger (red); armed ("Sure? Tap again") the deep red with
-- cream ink; leaving the sunk well
Leave.LOOK = {
	Pink = { SIGN.Red, SIGN.RedLip, SIGN.Text },
	Red = { SIGN.RedLip, SIGN.RoofEdge, SIGN.Stone },
	Gray = { SIGN.Well, SIGN.WellEdge, SIGN.TextMuted },
}

function Leave.Allowed(B)
	return B ~= nil and B.Fighter == true and (B.Mode == "Ring" or B.Mode == "Raid")
end

-- the width of LEAVE in a landscape phone's top strip (a raid's armed text is longer)
function Leave.TopW(B)
	return (B and B.Mode == "Raid") and K.LEAVE_W_TOP_RAID or K.LEAVE_W_TOP
end

function Leave.Make(parent, textSize)
	local b = make("TextButton", { Name = "LeaveButton", Text = "Leave", AutoButtonColor = false, BorderSizePixel = 0, Size = UDim2.fromOffset(K.LEAVE_W, K.LEAVE_H), Visible = false, ZIndex = 4 }, parent)
	-- kit B: no outline; a block by role (Leave.Paint repaints it per style: danger red, armed the deep red, leaving the well)
	Theme.Style(b, "Button", { Size = textSize })
	signBlock(b, Leave.LOOK.Pink[1], Leave.LOOK.Pink[2], Leave.LOOK.Pink[3], K.PLANK_LIP, K.PLANK_EDGE)
	b.TextWrapped = true
	b:SetAttribute("BaseText", textSize)
	b:SetAttribute("LeaveStyle", "Pink")
	b.Activated:Connect(function()
		Leave.Press()
	end)
	Leave.buttons[#Leave.buttons + 1] = b
	return b
end

-- mode: the battle's Mode (a raid's armed text says what leaving pays)
function Leave.State(now, mode)
	if now < Leave.sentUntil then
		return "Leaving...", "Gray"
	elseif now < Leave.armedUntil then
		return (mode == "Raid") and "No reward! Tap again" or "Sure? Tap again", "Red"
	end
	return "Leave", "Pink"
end

function Leave.Paint()
	local text, style = Leave.State(os.clock(), Leave.battle and Leave.battle.Mode)
	Me.MouseHold("BattleLeave", style ~= "Pink") -- "Sure? Tap again": the cursor is free for the second press
	local live = {}
	for _, b in ipairs(Leave.buttons) do
		if b.Parent then
			live[#live + 1] = b
			setText(b, text)
			local slotW = b:GetAttribute("InCard")
			if slotW then
				-- (Pitch 2 item 06 A) the top card's plank: its slot's width, wider to the left while the text needs it
				local ok, ms = pcall(Theme.Measure, text, "Button", b.TextSize)
				local tw = max((ok and typeof(ms) == "Vector2") and ms.X or 0, #text * b.TextSize * 0.56) * 1.04 + 16
				local want = max(slotW, math.ceil(tw))
				if b.Size.X.Offset ~= want then
					b.Size = UDim2.fromOffset(want, b.Size.Y.Offset)
				end
			end
			-- (Pitch 2 item 06 A) the top card's plank is the pitch's small one: a 2 px edge and a 4 px lip
			local weight = slotW and "Card" or "Plank"
			if b:GetAttribute("LeaveStyle") ~= style or b:GetAttribute("LeaveWeight") ~= weight then
				b:SetAttribute("LeaveStyle", style)
				b:SetAttribute("LeaveWeight", weight)
				local look = Leave.LOOK[style] or Leave.LOOK.Pink
				signBlock(b, look[1], look[2], look[3], slotW and 4 or K.PLANK_LIP, slotW and 2 or K.PLANK_EDGE)
			end
		end
	end
	Leave.buttons = live
end

function Leave.Press()
	local now = os.clock()
	if now < Leave.sentUntil or not Leave.Allowed(St.battle) then
		return
	end
	if now < Leave.armedUntil then
		Leave.armedUntil = 0
		if BattleController.Command("Forfeit") then
			Leave.sentUntil = now + K.LEAVE_CONFIRM -- the run's End normally closes the HUD long before this
		end
	else
		Leave.armedUntil = now + K.LEAVE_CONFIRM
	end
	Leave.Paint()
	task.delay(K.LEAVE_CONFIRM + 0.05, Leave.Paint) -- back to LEAVE when nobody pressed again
end

-- a new battle (a ring round too) and the step from a fight to the next-round card start unarmed
function Leave.Track(B)
	local phase = B and B.ended and "next" or "fight"
	if Leave.battle ~= B or Leave.phase ~= phase then
		Leave.battle = B
		Leave.phase = phase
		Leave.armedUntil = 0
		Leave.sentUntil = 0
		Leave.Paint()
	end
end

-- the fight's LEAVE: wide = left of the action cluster at the bottom; compact = above the cluster, right edge
function Leave.Place(m, B, isFighting)
	local b = Hud.leave
	if not b then
		return
	end
	if B then
		Leave.Track(B)
	end
	b.Visible = B ~= nil and isFighting == true and Leave.Allowed(B)
	if not b.Visible then
		return
	end
	b.AnchorPoint = Vector2.new(1, 1)
	b:SetAttribute("InCard", nil)
	local pad = b:FindFirstChild("LeaveHit")
	if pad then
		pad.Visible = false
	end
	if Hud.leaveSlot and Hud.topRect and Hud.top.Visible then
		-- (Pitch 2 item 06 A) inside the top card's row 1, its right end (Hud.LayoutTop keeps the room): one card with the
		-- mode, the timer and the boss. It grows to the left over the row while it says "No reward! Tap again"
		local s = Hud.leaveSlot
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.fromOffset(Hud.topRect[1] + s[1] + s[3], Hud.topRect[2] + s[2])
		b.Size = UDim2.fromOffset(s[3], s[4])
		b:SetAttribute("InCard", s[3])
		b.TextSize = 18
		b:SetAttribute("BaseText", 18)
		do
			-- a thumb's (a pointer's) 44 screen px: a clear hit pad (HitFor) centred on the plank, over it
			if not pad then
				pad = make("TextButton", { Name = "LeaveHit", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 5,
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) }, b)
				pad:SetAttribute("HitFor", "LeaveButton")
				pad.Activated:Connect(function()
					Leave.Press()
				end)
			end
			local hit = math.ceil(44 / max(0.05, m.F))
			pad.Size = UDim2.fromOffset(max(s[3], hit), max(s[4], hit))
			pad.Visible = true
		end
		Leave.Paint()
		return
	end
	if not m.Compact then
		b.Size = UDim2.fromOffset(K.LEAVE_W, K.LEAVE_H)
		b.Position = UDim2.fromOffset(m.W - K.EDGE - 300, m.H - K.EDGE - 8)
	elseif m.Landscape and Hud.topRect and Hud.top.Visible and Hud.topRect[3] + 8 + Leave.TopW(B) <= m.W - K.EDGE - K.ROW_W_COMPACT - 8 then
		-- a landscape phone: right of the mode card in the top strip (the cluster needs the right edge)
		b.AnchorPoint = Vector2.new(0, 0)
		b.Size = UDim2.fromOffset(Leave.TopW(B), K.MODE_H)
		b.Position = UDim2.fromOffset(Hud.topRect[3] + 8, Hud.topRect[2])
	else
		-- above the cluster's top row, at the right edge
		local L = Hud.ClusterLayout(m)
		local topY = 0
		for _, kind in ipairs(ACTIONS) do
			local s = L[kind]
			if s then -- (Pitch 2 item 1b: the three keys' layout has no SPECIAL / TARGET key)
				topY = min(topY, s[2] - s[3] / 2)
			end
		end
		b.Size = UDim2.fromOffset(K.LEAVE_W_COMPACT, K.LEAVE_H_COMPACT)
		b.Position = UDim2.fromOffset(m.W - 8, m.H + topY - 10)
	end
	b.TextSize = 20
	Leave.Paint()
end

-- the next-round card's LEAVE: a row at the bottom of the card (returns the card's new height)
function Leave.PlaceOnCard(m, B, w, y, inline, inlineW)
	local b = Hud.nextLeave
	if not b then
		return y
	end
	Leave.Track(B)
	b.Visible = Leave.Allowed(B)
	if not b.Visible then
		return y
	end
	Leave.Paint()
	if inline then
		-- beside the countdown (a landscape phone; inlineW: narrower where the countdown needs the room)
		b.Size = UDim2.fromOffset(inlineW or 92, 38)
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.new(1, -K.PAD - 4, 0, y)
		return y
	end
	b.Size = UDim2.fromOffset(min(w - 2 * K.PAD - 8, K.LEAVE_CARD_W), K.LEAVE_H_COMPACT)
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -K.PAD - 4, 0, y)
	return y + K.LEAVE_H_COMPACT + K.PAD
end

----------------------------------------------------------------------
-- wave 6: CHEER UP! (Raid / Dungeon fighters): BattleCommand "Cheer"; the server gives my fighter x (1 + CheerBoost) for
-- CheerSeconds, cooldown CheerCooldown (BattleCatalog.Fighter; the server decides). The button sits right above the
-- vitals card (HudController.GetLayout().Vitals: CHEER_GAP_PX above it, centred on it), so it never shares a row with
-- the hotbar, the touch buttons or the action cluster. Quick wins (win 4): a fighter's card steps aside for the fight
-- (Hud.SetVitalsHidden), so in a fight the button takes the card's empty slot (GetLayout().VitalsSlot): centred on it, its
-- bottom edge on the slot's bottom edge (with Retreat: a centred row, or Retreat above). The gold glow behind it shows the
-- boost, a dark veil that shrinks to the right the cooldown. The trainer's cheer emote is Cheer.Mine (TrainerCheer) on the
-- server's Cheer event.
----------------------------------------------------------------------
function CheerUp.Allowed(B)
	return B ~= nil and B.Fighter == true and not B.ended and (B.Mode == "Raid" or B.Mode == "Dungeon")
end

-- HudController (the vitals card's rect); nil when missing. The second value, hidden: the card has stepped aside (a fighter's fight,
-- Hud.SetVitalsHidden; or another window's hide) and the rect is its empty slot (GetLayout().VitalsSlot): Cheer up! and Retreat sit in
-- it then (quick wins, win 4). The action cluster's keep-out (Hud.ClusterLayout) reads the same rect either way.
function CheerUp.Layout()
	if Mods.HudCtl == nil then
		Mods.HudCtl = optional(script.Parent, "HudController") or false
	end
	local hc = Mods.HudCtl
	if not hc or type(hc.GetLayout) ~= "function" then
		return nil, false
	end
	local ok, layout = pcall(hc.GetLayout)
	if not ok or type(layout) ~= "table" then
		return nil, false
	end
	local v = layout.Vitals or layout.VitalsSlot
	if type(v) == "table" and tonumber(v.X) and tonumber(v.Y) and tonumber(v.W) and tonumber(v.H) then
		return v, layout.Vitals == nil and layout.VitalsSlot ~= nil
	end
	return nil, false
end

-- (quick wins, win 4) the card's empty slot is ours only where the buttons put in it stay clear of the touch controls (RUN and
-- Roblox's jump button: a small portrait phone's narrowest card reaches the RUN button's battle spot), the action cluster and the
-- fighter's cards; else Cheer up! / Retreat keep the places they have around a shown card. boxes = { { cx, bottom }, ... } (design
-- px; the buttons' anchor is 0.5, 1), each w x h
function CheerUp.SlotClear(m, boxes, w, h)
	local f = max(0.05, m.F)
	local keep = {}
	if m.Touch then
		local r = Hud.TouchRects(m)
		for _, t in ipairs({ r.jump, r.run }) do
			if type(t) == "table" and tonumber(t[1]) and tonumber(t[2]) and tonumber(t[3]) and tonumber(t[4]) then
				-- (screen px: x from the left, y up from the gui area's bottom) -> design px from the top-left
				keep[#keep + 1] = { t[1] / f, m.H - t[4] / f, t[3] / f, m.H - t[2] / f }
			end
		end
	end
	for _, kind in ipairs(ACTIONS) do
		local s = Hud.cluster and Hud.cluster[kind]
		if type(s) == "table" then
			-- (Commands is anchored at the gui area's bottom-right; a button's centre is (W + x, H + y), diameter d)
			local x, y, d = m.W + s[1], m.H + s[2], s[3]
			keep[#keep + 1] = { x - d / 2, y - d / 2, x + d / 2, y + d / 2 }
		end
	end
	if Hud.team and Hud.team.Visible then
		local tx, ty = Hud.team.Position.X.Offset, Hud.team.Position.Y.Offset
		keep[#keep + 1] = { tx, ty, tx + Hud.team.Size.X.Offset, ty + Hud.team.Size.Y.Offset }
	end
	if Hud.listX and Hud.enemies and Hud.enemies.Visible then
		-- (P2 fix A r1) the enemy list under the fighter's block
		local ex, ey = Hud.listX, Hud.listTop or 0
		keep[#keep + 1] = { ex, ey, ex + Hud.enemies.Size.X.Offset, ey + Hud.enemies.Size.Y.Offset }
	end
	for _, b in ipairs(boxes) do
		local x0, y0, x1, y1 = b[1] - w / 2, b[2] - h, b[1] + w / 2, b[2]
		for _, k in ipairs(keep) do
			if x0 < k[3] and k[1] < x1 and y0 < k[4] and k[2] < y1 then
				return false
			end
		end
	end
	return true
end

-- the re-place key (CheerUp.Update): the card's rect, whether it is hidden (its slot is ours) and whether Retreat shares the row
function CheerUp.Key(v, hidden, withRetreat)
	if not v then
		return "-"
	end
	return string.format("%d,%d,%d,%d,%s,%s", v.X, v.Y, v.W, v.H, hidden and "slot" or "card", withRetreat and "R" or "-")
end

function CheerUp.Make(parent)
	-- (kit-b U9-6) the button a gold plank (the selected / special colour) in its wood edge, square; the cooldown's veil a flat
	-- brown sheet; (LOOK-ui2: was a see-through gold frame blinking behind it) while the boost lasts its edge blinks deep gold
	local b = make("TextButton", { Name = "Cheer", Text = "Cheer up!", AutoButtonColor = false, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(K.CHEER_W, K.CHEER_H), Visible = false, ZIndex = 4 }, parent)
	Theme.Style(b, "Button", { Size = 20 }) -- (kit-b U6: no outline)
	-- (Pitch 2 item 1b) the three keys' CHEER keeps its word above the lip: a padding the lip follows (signBlock watches it)
	make("UIPadding", { Name = "KeyPad" }, b)
	signBlock(b, SIGN.Gold, SIGN.GoldLip, SIGN.Text, K.PLANK_LIP, K.PLANK_EDGE)
	b:SetAttribute("BaseText", 20)
	local sweep = make("Frame", { Name = "Sweep", BackgroundColor3 = SIGN.Text, BackgroundTransparency = 0.45, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0, 1), Visible = false, ZIndex = 5 }, b)
	local glyph = label(b, "", "Display", 18, { Name = "Glyph", Visible = false, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(22, 20), Position = UDim2.new(0.5, 0, 0, 4), ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Center })
	b.Activated:Connect(function()
		BattleController.Cheer()
	end)
	Hud.cheer = { Button = b, Sweep = sweep, Edge = b:FindFirstChild("SignEdge"), Glyph = glyph }
	return b
end

-- (Pitch 2 item 1b, option C "Three buttons", the owner's pick 2026-11-20) the team orders' look: on the three keys' layout a
-- keycap block (the keys' edge and lip) with its pixel glyph over a one-word name (CHEER, BACK / FIGHT) at the phone floor;
-- else the plank with its words ("Cheer up!", "Retreat" / "Engage"). b: the button, glyph: its Glyph label, word: the
-- name, icon: the glyph's PixelIcon, face / lip: its colours
function CheerUp.Look(m, b, glyph, word, icon, face, lip)
	local three = Hud.ThreeKeys(m)
	local f = max(0.05, m.F)
	local lipPx = three and K.KEY_LIP or K.PLANK_LIP
	signBlock(b, face, lip, SIGN.Text, lipPx, three and K.KEY_EDGE or K.PLANK_EDGE)
	setText(b, word)
	local pad = b:FindFirstChild("KeyPad")
	if three then
		local px = math.ceil(Hud.FloorPx() / f - 1e-6)
		Theme.SetRole(b, "Label")
		b.TextSize = px
		b:SetAttribute("BaseText", px)
		b.TextYAlignment = Enum.TextYAlignment.Bottom
		if pad then
			pad.PaddingBottom = UDim.new(0, lipPx + 2)
		end
		if glyph then
			glyph.Visible = true
			glyph.TextColor3 = SIGN.Text -- (the icon's ink: the block's word's)
			PixelIcon.Set(glyph, icon, 18)
		end
	else
		Theme.SetRole(b, "Button")
		b.TextSize = 20
		b:SetAttribute("BaseText", 20)
		b.TextYAlignment = Enum.TextYAlignment.Center
		if pad then
			pad.PaddingBottom = UDim.new(0, 0)
		end
		if glyph then
			glyph.Visible = false
		end
	end
end

-- (look review r0) whether team orders at `spots` (CheerUp.TeamSpots' form; w x h design px) stand clear: whole on the gui
-- area 4 px in from its edges, 8 px off Roblox's stick zone (StackTop's) and jump button, (look review r1) 40 px off
-- MovementController's RUN and the three keys (Hud.KeyBoxes; K.TEAM_OFF_KEYS_PX), and off the top card and the enemy list
-- (Root children, offset-placed)
function CheerUp.SpotsClear(m, spots, w, h)
	local f = max(0.05, m.F)
	local edge, keep, keys = 4 / f, 8 / f, K.TEAM_OFF_KEYS_PX / f
	local small = min(m.VX, m.VY) <= K.STICK_SMALL_PHONE
	local stickW = small and K.STICK_W_SMALL or K.STICK_W_LARGE
	local stickH = small and ((m.VY > m.VX) and K.STICK_H_TALL or K.STICK_H_WIDE) or K.STICK_H_LARGE
	local avoid = { { X0 = 0, X1 = stickW / f, Y0 = m.H - stickH / f, Y1 = m.H, gap = keep } }
	local r = Hud.TouchRects(m)
	for _, t in ipairs({ r.jump, r.run }) do
		avoid[#avoid + 1] = { X0 = t[1] / f, X1 = t[3] / f, Y0 = m.H - t[4] / f, Y1 = m.H - t[2] / f, gap = (t == r.run) and keys or keep }
	end
	for _, k in ipairs(Hud.KeyBoxes(m)) do
		avoid[#avoid + 1] = { X0 = k.X0, X1 = k.X1, Y0 = k.Y0, Y1 = k.Y1, gap = keys }
	end
	for _, obj in ipairs({ Hud.top, Hud.enemies }) do
		if obj and obj.Visible then
			local p, s, a = obj.Position, obj.Size, obj.AnchorPoint
			local x, y = p.X.Offset - a.X * s.X.Offset, p.Y.Offset - a.Y * s.Y.Offset
			avoid[#avoid + 1] = { X0 = x, X1 = x + s.X.Offset, Y0 = y, Y1 = y + s.Y.Offset, gap = 2 / f }
		end
	end
	for _, s in ipairs(spots) do
		local x0, x1, y0, y1 = s[1] - w / 2, s[1] + w / 2, s[2] - h, s[2]
		if x0 < edge or x1 > m.W - edge or y0 < edge or y1 > m.H - edge then
			return false
		end
		for _, b in ipairs(avoid) do
			if max(b.X0 - x1, x0 - b.X1, b.Y0 - y1, y0 - b.Y1) < b.gap then
				return false
			end
		end
	end
	return true
end

-- (Pitch 2 item 1b) the team orders' spots on the three keys' layout (design px; the buttons' anchor is 0.5, 1): they are team
-- orders, so they sit with the team. A wide screen: beside the helper portraits, CHEER by the first helper and BACK by the
-- second (the helper column narrows for them in Hud.LayoutFighter); a tall one: a row under the portraits (under the enemy
-- list where it lies under the fighter's block), as the mock. From the Team block alone: no fight state moves them.
-- -> { { cx, bottom }, { cx, bottom } }, w, h
function CheerUp.TeamSpots(m)
	local f = max(0.05, m.F)
	local w, h = K.TEAM_KEY_W_PX / f, K.TEAM_KEY_H_PX / f
	local gap = K.TEAM_KEY_GAP_PX / f
	local tx, ty = Hud.team.Position.X.Offset, Hud.team.Position.Y.Offset
	local holder = Hud.helperHolder
	local cells = 0
	for _, H in ipairs(Hud.helpers or {}) do
		if H.Cell and H.Cell.Visible then
			cells = cells + 1
		end
	end
	local hx, hy = tx + (holder and holder.Position.X.Offset or 0), ty + (holder and holder.Position.Y.Offset or 0)
	local hw, hh = holder and holder.Size.X.Offset or 0, holder and holder.Size.Y.Offset or 0
	if m.VX > m.VY and cells > 0 and Hud.helpersRow ~= true then
		local cellH = (Hud.helperLevel and Hud.helperLevel.CellH) or (hh - Hud.CellGap(m)) / 2
		local spots = {}
		for i = 1, 2 do
			spots[i] = { hx + hw + gap + w / 2, hy + (i - 1) * (cellH + Hud.CellGap(m)) + cellH / 2 + h / 2 }
		end
		return spots, w, h
	end
	local top = (cells > 0) and (hy + hh) or (ty + Hud.team.Size.Y.Offset)
	local fc = Hud.fighterCard and Hud.fighterCard.Root
	if cells == 0 and fc and fc.Parent == Hud.team then
		-- (playtest 2026-11-28 C5: a raid with no helpers put CHEER / BACK on Roblox's stick at 667 x 375; the Team block
		-- keeps the empty helpers' height, so its foot is the screen's) no helpers: the row under the fighter card itself
		top = ty + fc.Position.Y.Offset + fc.Size.Y.Offset
	end
	if Hud.listX and Hud.enemies and Hud.enemies.Visible then
		-- (keys look r4: the "+n more" tag hangs past the list frame's height, its frame 2.8 px off CHEER's at 360 x 640) the
		-- list's foot is its lowest shown row or tag
		local foot = Hud.enemies.Size.Y.Offset
		for _, c in ipairs(Hud.enemies:GetChildren()) do
			if c:IsA("GuiObject") and c.Visible then
				foot = max(foot, c.Position.Y.Offset - c.AnchorPoint.Y * c.Size.Y.Offset + c.Size.Y.Offset)
			end
		end
		top = max(top, (Hud.listTop or 0) + foot)
	end
	-- (look review r0: the row narrowed them to 45-50 px to end before the screen's centre 40%, and CHEER at the 14 px floor
	-- ran onto its edges; the mock's row is 52 px blocks and crosses that line too) the mock's 52 px
	local bottom = top + 10 / f + h
	local under = { { tx + w / 2, bottom }, { tx + w + gap + w / 2, bottom } }
	if cells == 0 or CheerUp.SpotsClear(m, under, w, h) then
		return under, w, h
	end
	-- (look review r0, render_gui battle:raid:full at 360 x 640: the top card stacked into its tall column under the fighter
	-- card pushed the portraits down to Roblox's stick, and the row under them landed on it, 2 px off the screen's foot) where
	-- the row under them has no room, the orders go beside the portraits, as on a wide phone: one by each helper, else (DASH
	-- left of MOVE stands by the second helper) a row by the first; nothing clear (never seen): the row under them
	local cellH = Hud.helpersRow and hh or ((Hud.helperLevel and Hud.helperLevel.CellH) or (hh - Hud.CellGap(m)) / 2)
	local x = hx + hw + gap + w / 2
	if not Hud.helpersRow then
		local beside = { { x, hy + cellH / 2 + h / 2 }, { x, hy + cellH + Hud.CellGap(m) + cellH / 2 + h / 2 } }
		if CheerUp.SpotsClear(m, beside, w, h) then
			return beside, w, h
		end
	end
	local by = hy + cellH / 2 + h / 2
	local row = { { x, by }, { x + w + gap, by } }
	if CheerUp.SpotsClear(m, row, w, h) then
		return row, w, h
	end
	return under, w, h
end

function CheerUp.Place(m, B, isFighting)
	local C = Hud.cheer
	if not C then
		return
	end
	local on = B ~= nil and isFighting == true and CheerUp.Allowed(B)
	C.Button.Visible = on
	CheerUp.beside = false
	CheerUp.row = false
	CheerUp.inSlot = false
	if not on then
		CheerUp.placed = nil
		return
	end
	local three = Hud.ThreeKeys(m)
	if C.three ~= three then
		C.three = three
		CheerUp.Look(m, C.Button, C.Glyph, three and "CHEER" or "Cheer up!", "heart", SIGN.Gold, SIGN.GoldLip)
	end
	if three then
		-- (Pitch 2 item 1b) with the team: CheerUp.TeamSpots' first spot
		local spots, w, h = CheerUp.TeamSpots(m)
		C.Button.Size = UDim2.fromOffset(w, h)
		C.Button.Position = UDim2.fromOffset(spots[1][1], spots[1][2])
		CheerUp.placed = "three"
		return
	end
	local f = max(0.05, m.F)
	local w, h = K.CHEER_W, K.CHEER_H
	if m.Touch then
		w = max(w, K.CHEER_TOUCH_W_PX / f)
		h = max(h, K.CHEER_TOUCH_PX / f)
	end
	-- (keys look r4) between Cheer up! and Retreat (a row or a stack): both wood edges and K.INK_AIR_PX of air (Retreat.Place)
	local edge = C.Button:FindFirstChildOfClass("UIStroke")
	local edgePx = (edge and edge.Enabled ~= false and edge.Transparency < 0.99) and edge.Thickness or 0
	local gap = max(K.CHEER_GAP_PX, 2 * edgePx + K.INK_AIR_PX) / f
	local v, hidden = CheerUp.Layout()
	local withRetreat = Retreat.Allowed(B)
	local cx, bottom
	local rowLeft = nil -- (the slot's row: Retreat's centre, left of Cheer up!)
	if v and hidden then
		-- quick wins (win 4): the card has stepped aside for the fight; its slot is ours. Cheer up! centred on it, its bottom edge on
		-- the slot's bottom edge; with Retreat too, a row centred on the slot (Retreat left, Cheer up! right, one gap between) where it
		-- fits the slot plus one gap each side, else Cheer up! stays centred and Retreat stacks above it (Retreat.Place). Where the
		-- centre would reach the touch controls, the action cluster or the fighter's cards (CheerUp.SlotClear; a small portrait
		-- phone's narrowest card reaches the battle's RUN button) the group slides flush with the slot's left, then its right edge;
		-- where none is clear, the places around a shown card below are kept, measured against the slot
		local sx, sb = (v.X + v.W / 2) / f, (v.Y + v.H) / f
		local rowFits = withRetreat and 2 * w + gap <= v.W / f + 2 * gap
		-- (Pitch 2 item 08 C: the slot is the wider name-tab card's; a small landscape phone's row then reaches the action
		-- cluster) where no row is clear, the stacked form (Retreat above Cheer up!) is tried at the same three places
		local tries = {}
		for _, asRow in ipairs(rowFits and { true, false } or { false }) do
			local half = asRow and (w + gap / 2) or (w / 2)
			for _, gc in ipairs({ sx, v.X / f + half, (v.X + v.W) / f - half }) do
				tries[#tries + 1] = { gc, asRow }
			end
		end
		for _, try in ipairs(tries) do
			local gc, asRow = try[1], try[2]
			local boxes = { { gc, sb } }
			if asRow then
				boxes = { { gc + (w + gap) / 2, sb }, { gc - (w + gap) / 2, sb } }
			elseif withRetreat then
				boxes[2] = { gc, sb - h - gap }
			end
			if not CheerUp.inSlot and CheerUp.SlotClear(m, boxes, w, h) then
				CheerUp.inSlot = true
				cx, bottom = boxes[1][1], sb
				if asRow then
					rowLeft = boxes[2][1]
					CheerUp.row = true
				end
			end
		end
	end
	if not CheerUp.inSlot then
		if v then
			cx = (v.X + v.W / 2) / f
			bottom = (v.Y - K.CHEER_GAP_PX) / f
		else
			cx, bottom = m.W / 2, m.H - 150 -- (no vitals card: low in the middle)
		end
	end
	-- the middle of the screen stays free (HudController's CENTRE_TOL band): a landscape phone's card sits so high that the
	-- spot above it is in that band; the button then goes beside the card (or its empty slot) in its row, on the left (between
	-- Roblox's stick and the card: the right is the action cluster's), its top level with the card's top
	local tol = K.CHEER_CENTRE_TOL
	local bandL, bandR = m.W * (0.5 - tol), m.W * (0.5 + tol)
	local midY = (m.VY / 2 - m.Inset) / f
	local bandT, bandB = midY - m.VY * tol / f, midY + m.VY * tol / f
	local left = rowLeft and (rowLeft - w / 2) or (cx - w / 2)
	if cx + w / 2 > bandL and left < bandR and bottom > bandT and bottom - h < bandB then
		CheerUp.row = false
		CheerUp.inSlot = false
		if v then
			cx = (v.X - K.CHEER_GAP_PX) / f - w / 2
			bottom = v.Y / f + h
			CheerUp.beside = true -- (Retreat stacks above it then: the row's left is Roblox's stick)
		else
			cx = bandL - 4 - w / 2
		end
	end
	cx = clamp(cx, w / 2 + K.EDGE, m.W - w / 2 - K.EDGE)
	C.Button.Size = UDim2.fromOffset(w, h)
	C.Button.Position = UDim2.fromOffset(cx, bottom)
	CheerUp.placed = CheerUp.Key(v, hidden, withRetreat)
end

-- 10 Hz: the sweep, the glow; a vitals card that moved (or stepped aside / came back) takes the button with it
function CheerUp.Update(B, now)
	local C = Hud.cheer
	if not C or not C.Button.Visible then
		return
	end
	local v, hidden = CheerUp.Layout()
	-- (Pitch 2 item 1b) the three keys' CHEER / BACK stand with the team, whatever the vitals card does
	local key = C.three and "three" or CheerUp.Key(v, hidden, Retreat.Allowed(B))
	if key ~= CheerUp.placed and Hud.m then
		CheerUp.Place(Hud.m, B, B.Fighter and not B.ended)
		Retreat.Place(Hud.m, B, B.Fighter and not B.ended)
	end
	local left = cdLeft(B, "Cheer", nil, now)
	setVisible(C.Sweep, left > 0.05)
	if left > 0.05 then
		C.Sweep.Size = UDim2.fromScale(clamp(left / cdLen(B, "Cheer"), 0, 1), 1)
	end
	local cheering = now < (B.cheerUntil or 0)
	local lit = cheering and sin(now * 6) > 0
	local edgeColor = lit and SIGN.GoldDeep or KB.Edge
	if C.Edge and C.Edge.Color ~= edgeColor and (C.Button:GetAttribute("DenyUntil") or 0) <= now then
		C.Edge.Color = edgeColor
	end
	if C.Button:GetAttribute("Cheering") ~= cheering then
		C.Button:SetAttribute("Cheering", cheering)
	end
end

----------------------------------------------------------------------
-- evolved forms: RETREAT (boss raid fighters only): BattleCommand "Retreat" / "Engage"; the server decides (BattleSim "Retreat"). The button sits in the
-- Cheer up! row, its left, the same size; where that row has no room on its left (the screen edge, Roblox's stick) it stacks above Cheer up!; where
-- that stack would cover the fighter's cards (a landscape phone: Cheer up! sits beside the card, right under the cards) or the screen's middle (a
-- portrait phone) it goes under the vitals card instead, from the card's left edge and right of Roblox's stick. Quick wins (win 4): with the card
-- stepped aside for the fight the row is centred in its empty slot (Retreat left, Cheer up! right) where it fits the slot plus one gap each side,
-- else Retreat stacks above Cheer up! (centred in the slot); the fallbacks above are measured against the slot. The label follows the server's
-- echo (B.retreated), a dark veil that shrinks to the right is the 10 s wait after an Engage, the stroke pulses while it says Engage (plain on
-- Graphics Low).
----------------------------------------------------------------------
function Retreat.Allowed(B)
	return B ~= nil and B.Fighter == true and not B.ended and B.Mode == "Raid"
end

function Retreat.Make(parent)
	local b = make("TextButton", { Name = "Retreat", Text = "Retreat", AutoButtonColor = false, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(K.CHEER_W, K.CHEER_H), Visible = false, ZIndex = 4 }, parent)
	-- kit B: no outline; a stone block (Engage: the red block; Retreat.Update repaints it), its wood edge the pulsing stroke
	Theme.Style(b, "Button", { Size = 20 })
	make("UIPadding", { Name = "KeyPad" }, b) -- (Pitch 2 item 1b: as Cheer up!'s, CheerUp.Look)
	signBlock(b, KB.Face, SIGN.StoneLip, KB.Ink, K.PLANK_LIP, K.PLANK_EDGE)
	local stroke = b:FindFirstChild("SignEdge")
	b:SetAttribute("BaseText", 20)
	local sweep = make("Frame", { Name = "Sweep", BackgroundColor3 = SIGN.Text, BackgroundTransparency = 0.45, BorderSizePixel = 0, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0, 1), Visible = false, ZIndex = 5 }, b)
	local key = label(b, "", "Label", 14, { Name = "Key", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0), Size = UDim2.fromOffset(18, 18), TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6, TextColor3 = b.TextColor3 })
	local glyph = label(b, "", "Display", 18, { Name = "Glyph", Visible = false, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(22, 20), Position = UDim2.new(0.5, 0, 0, 4), ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Center })
	b.Activated:Connect(function()
		BattleController.Retreat()
	end)
	Hud.SetKey(key, Hud.KeyText("Retreat"))
	Hud.retreat = { Button = b, Sweep = sweep, Stroke = stroke, Key = key, Glyph = glyph }
	return b
end

-- (Pitch 2 item 1b) Retreat's words and look for its state: the three keys' BACK (down) / FIGHT (up), else Retreat / Engage
function Retreat.Paint(m, back)
	local R = Hud.retreat
	local three = Hud.ThreeKeys(m)
	local word = three and (back and "FIGHT" or "BACK") or (back and "Engage" or "Retreat")
	CheerUp.Look(m, R.Button, R.Glyph, word, back and "up" or "down", back and SIGN.Red or KB.Face, back and SIGN.RedLip or SIGN.StoneLip)
	R.Stroke.Thickness = three and K.KEY_EDGE or 3
	R.Key.TextColor3 = R.Button.TextColor3
	R.look = (three and "3" or "p") .. (back and "b" or "r")
end

-- Cheer up! has been placed (Hud.Rebuild, CheerUp.Update): the row is its row
function Retreat.Place(m, B, isFighting)
	local R = Hud.retreat
	if not R then
		return
	end
	local on = B ~= nil and isFighting == true and Retreat.Allowed(B)
	R.Button.Visible = on
	if not on then
		return
	end
	if Hud.ThreeKeys(m) then
		-- (Pitch 2 item 1b) BACK with the team: CheerUp.TeamSpots' second spot (by the second helper / right of CHEER)
		local back = B.retreated == true
		if R.look ~= ("3" .. (back and "b" or "r")) then
			Retreat.Paint(m, back)
		end
		local spots, w, h = CheerUp.TeamSpots(m)
		R.Button.Size = UDim2.fromOffset(w, h)
		R.Button.Position = UDim2.fromOffset(spots[2][1], spots[2][2])
		Retreat.how = "team"
		setVisible(R.Key, false)
		return
	end
	local C = Hud.cheer.Button
	local w, h = C.Size.X.Offset, C.Size.Y.Offset
	local cx, bottom = C.Position.X.Offset, C.Position.Y.Offset
	local f = max(0.05, m.F)
	-- (keys look r4: a PC's two buttons wear 5 px wood edges, 8 px apart they lay 2 px on each other at 1920 x 1080, met at
	-- 1280 x 720) beside or over Cheer up!, both edges and K.INK_AIR_PX of air between them
	local edge = C:FindFirstChildOfClass("UIStroke")
	local edgePx = (edge and edge.Enabled ~= false and edge.Transparency < 0.99) and edge.Thickness or 0
	local gap = max(K.CHEER_GAP_PX, 2 * edgePx + K.INK_AIR_PX) / f
	local x, y = cx - w - gap, bottom
	Retreat.how = "row"
	local v = CheerUp.Layout()
	-- the row's left is the screen edge or Roblox's stick (Cheer up! beside the card): above Cheer up!; so too in the card's
	-- empty slot (quick wins, win 4) where CheerUp.Place made no row there (the row is wider than the slot plus a gap each side)
	if CheerUp.beside or x - w / 2 < K.EDGE or (CheerUp.inSlot and not CheerUp.row) then
		x, y = cx, bottom - h - gap
		Retreat.how = "stack"
		-- ...unless the stack covers the fighter's cards (the Team block) or the screen's middle: under the vitals card (or its
		-- empty slot) then
		local covers = false
		if Hud.team and Hud.team.Visible then
			local tx, ty = Hud.team.Position.X.Offset, Hud.team.Position.Y.Offset
			local tr, tb = tx + Hud.team.Size.X.Offset, ty + Hud.team.Size.Y.Offset
			covers = x + w / 2 > tx - gap and x - w / 2 < tr + gap and y > ty - gap and y - h < tb + gap
		end
		if v and (covers or Retreat.inMiddle(m, x, y, w, h)) then
			local small = min(m.VX, m.VY) <= K.STICK_SMALL_PHONE
			local stickW = (small and K.STICK_W_SMALL or K.STICK_W_LARGE) / f
			x = max(v.X / f, stickW + gap) + w / 2
			y = min((v.Y + v.H) / f + gap + h, m.H - K.EDGE) -- (never below the screen's edge, whatever the card's bottom margin becomes)
			Retreat.how = "under"
		end
	end
	x = clamp(x, w / 2 + K.EDGE, m.W - w / 2 - K.EDGE)
	R.Button.Size = UDim2.fromOffset(w, h)
	R.Button.Position = UDim2.fromOffset(x, y)
	setVisible(R.Key, not m.Touch)
end

-- a button centred on x with its bottom at y (design px) would enter the screen's middle band (HudController's CENTRE_TOL band, as CheerUp.Place)
function Retreat.inMiddle(m, x, y, w, h)
	local f = max(0.05, m.F)
	local tol = K.CHEER_CENTRE_TOL
	local bandL, bandR = m.W * (0.5 - tol), m.W * (0.5 + tol)
	local midY = (m.VY / 2 - m.Inset) / f
	local bandT, bandB = midY - m.VY * tol / f, midY + m.VY * tol / f
	return x + w / 2 > bandL and x - w / 2 < bandR and y > bandT and y - h < bandB
end

-- 10 Hz: the label, the wait's sweep, the pulse
function Retreat.Update(B, now)
	local R = Hud.retreat
	if not R or not R.Button.Visible then
		return
	end
	local back = B.retreated == true
	local m = Hud.m
	if m and Hud.ThreeKeys(m) then
		-- (Pitch 2 item 1b) the three keys' BACK / FIGHT block
		if R.look ~= ("3" .. (back and "b" or "r")) then
			Retreat.Paint(m, back)
		end
	else
		if m and R.look and R.look:sub(1, 1) == "3" then
			Retreat.Paint(m, back) -- (back to the plank from the three keys' block)
		end
		setText(R.Button, back and "Engage" or "Retreat")
		local color = back and SIGN.Red or KB.Face
		if R.Button.BackgroundColor3 ~= color then
			signBlock(R.Button, color, back and SIGN.RedLip or SIGN.StoneLip, KB.Ink, K.PLANK_LIP, K.PLANK_EDGE)
			R.Stroke.Thickness = 3
			R.Key.TextColor3 = R.Button.TextColor3
		end
	end
	local left = cdLeft(B, "Retreat", nil, now)
	setVisible(R.Sweep, left > 0.05)
	if left > 0.05 then
		R.Sweep.Size = UDim2.fromScale(clamp(left / cdLen(B, "Retreat"), 0, 1), 1)
	end
	local pulse = back and not Me.LowGraphics()
	if R.Button:GetAttribute("Pulse") ~= pulse then
		R.Button:SetAttribute("Pulse", pulse)
	end
	local a = pulse and (0.25 + 0.25 * sin(now * K.RETREAT_PULSE)) or 0
	if abs(R.Stroke.Transparency - a) > 0.02 then
		R.Stroke.Transparency = a
	end
end

----------------------------------------------------------------------
-- bug batch 6: OUT OF THE FIGHT AREA (boss raid fighters). The server watches where my character is (BattleService Raid.watchArea:
-- the floor with its podium wall, or the Raid pocket's sand, + a 4-stud slack) and after 0.5 s outside sends BattleState "Area"
-- { Out = true, Left = 3 }; Left seconds later it takes me out of the raid exactly as LEAVE does, unless I step back in ({ Out =
-- false }). The banner only shows what the server said: "Back to the fight! 3", 2, 1 on the client clock, holding 1 until the
-- server's End or Out = false. Wide screens: centred, its top just under whatever the top band holds in its column (the top card
-- with the boss bar, the fighter's cards, the enemy list, the currency pills, LEAVE). Phones (Compact): the top band has no room
-- left (under it is the screen's middle), so the banner lies over the top card, a little bigger than it, for those seconds.
----------------------------------------------------------------------
function AreaWarn.Make(parent)
	-- (kit-b U9-6) a deep red sign in its gold edge with its lip, cream letters (no glow, no corner)
	local b = label(parent, "", "Title", K.AREA_TEXT, { Name = "AreaWarn", AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(K.AREA_W, K.AREA_H), TextYAlignment = Enum.TextYAlignment.Top, Visible = false, ZIndex = 7 })
	b:SetAttribute("BaseText", K.AREA_TEXT)
	signBlock(b, SIGN.RedLip, SIGN.RoofEdge, SIGN.Stone, K.PLANK_LIP, K.PLANK_EDGE)
	signEdge(b, SIGN.Gold, K.PLANK_EDGE)
	make("UIPadding", { PaddingTop = UDim.new(0, 8) }, b)
	local sub = label(b, "Or you leave the raid.", "Body", K.AREA_SUB_TEXT, { Name = "Sub", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 24), TextColor3 = SIGN.Stone, TextWrapped = true, ZIndex = 8 })
	sub:SetAttribute("BaseText", K.AREA_SUB_TEXT)
	Hud.area = b
	return b
end

-- the server's "Area" message for the drawn battle (another battle's, a spectator's or an ended one's is ignored)
function AreaWarn.Set(payload, battleId)
	local B = St.battle
	if type(payload) ~= "table" or not B or not B.Fighter or B.ended or B.Mode ~= "Raid" then
		return
	end
	local id = payload.BattleId or battleId
	if id ~= B.Id then
		return
	end
	if payload.Out ~= true then
		AreaWarn.Hide()
		return
	end
	local left = clamp(floor(num(payload.Left, 3) + 0.5), 1, 9)
	AreaWarn.battleId = B.Id
	AreaWarn.untilT = os.clock() + left
	AreaWarn.shown = nil
	if Hud.m then
		AreaWarn.Place(Hud.m, B)
		Hud.FixText(Hud.area, Hud.m.F)
	end
	AreaWarn.Update(B, os.clock())
end

function AreaWarn.Hide()
	AreaWarn.untilT = nil
	AreaWarn.battleId = nil
	AreaWarn.shown = nil
	if Hud.area then
		Hud.area.Visible = false
	end
end

-- a design-px rect { x0, y0, x1, y1 } of a shown HUD part placed by offsets (its AnchorPoint applied), nil when hidden
function AreaWarn.rectOf(obj, m)
	if not obj or not obj.Visible then
		return nil
	end
	local p, sz, a = obj.Position, obj.Size, obj.AnchorPoint
	local w, h = sz.X.Offset + sz.X.Scale * m.W, sz.Y.Offset + sz.Y.Scale * m.H
	local x = p.X.Offset + p.X.Scale * m.W - a.X * w
	local y = p.Y.Offset + p.Y.Scale * m.H - a.Y * h
	return { x, y, x + w, y + h }
end

-- centred; its top under every top-band part in its column (each push can uncover another: a few passes)
function AreaWarn.Place(m, B)
	local b = Hud.area
	if not b then
		return
	end
	if not B or B ~= St.battle or AreaWarn.battleId ~= B.Id or AreaWarn.untilT == nil then
		b.Visible = false
		return
	end
	local size = (m.Compact and Hud.topRect and Hud.top.Visible) and K.AREA_TEXT_COMPACT or K.AREA_TEXT
	if b:GetAttribute("BaseText") ~= size then
		b:SetAttribute("BaseText", size)
		b.TextSize = size
	end
	if size == K.AREA_TEXT_COMPACT then
		local r = Hud.topRect
		b.Size = UDim2.fromOffset(r[3] - r[1] + 8, r[4] - r[2] + 8)
		b.Position = UDim2.fromOffset((r[1] + r[3]) / 2, r[2] - 4)
		b.Visible = true
		return
	end
	local w = min(K.AREA_W, m.W - 2 * K.EDGE)
	local h = K.AREA_H
	local x0, x1 = m.W / 2 - w / 2, m.W / 2 + w / 2
	local rects = {}
	for _, obj in ipairs({ Hud.top, Hud.team, Hud.enemies, Hud.leave }) do
		rects[#rects + 1] = AreaWarn.rectOf(obj, m)
	end
	local curBottom, curLeft, curRight = Hud.CurrencyTop(m)
	if curBottom > 0 then
		rects[#rects + 1] = { curLeft, 0, curRight, curBottom }
	end
	local y = K.EDGE
	for _ = 1, 6 do
		local moved = false
		for _, r in ipairs(rects) do
			if r[1] < x1 and r[3] > x0 and r[2] < y + h + 8 and r[4] + 8 > y then
				y = r[4] + 8
				moved = true
			end
		end
		if not moved then
			break
		end
	end
	b.Size = UDim2.fromOffset(w, h)
	b.Position = UDim2.fromOffset(m.W / 2, y)
	b.Visible = true
end

-- 10 Hz: 3, 2, 1 (holds 1); a banner of a battle no longer drawn goes
function AreaWarn.Update(B, now)
	local b = Hud.area
	if not b or AreaWarn.untilT == nil then
		return
	end
	if not B or B ~= St.battle or B.ended or AreaWarn.battleId ~= B.Id then
		AreaWarn.Hide()
		return
	end
	local secs = max(1, math.ceil(AreaWarn.untilT - now - 1e-6))
	if AreaWarn.shown ~= secs then
		AreaWarn.shown = secs
		setText(b, "Back to the fight! " .. secs)
	end
end

----------------------------------------------------------------------
-- Phase 4: unit cards (src/client/UI/PetCard.lua; ARCHITECTURE_V3.md "Phase 4 build contract" 3.9)
----------------------------------------------------------------------
-- the card above every pet unit: own pets "Unit" (level + HP + SPECIAL + XP), a teammate's "Ally" (level + HP),
-- enemies / NPCs "Enemy" (level + HP in red). The billboard keeps the Phase 3 name HpBar (its HP fill is
-- Plate.Hp.Fill). Fills are written only when the snapshot changed a value (Cards.Live), never per frame.
function Cards.ModeOf(u)
	if u.mine then
		return "Unit"
	elseif u.ally then
		return "Ally"
	end
	return "Enemy"
end

function Cards.Add(B, u, root)
	local h = (u.height or 3) / 2 + 0.9
	local ok, c = false, nil
	if Mods.PetCard and type(Mods.PetCard.New) == "function" then
		ok, c = pcall(Mods.PetCard.New, root, Cards.ModeOf(u), h, { Parent = u.model, Name = "HpBar" })
	end
	if not ok or type(c) ~= "table" then
		if Mods.PetCard then
			warnOnce("card", "PetCard.New failed: " .. tostring(c))
		end
		addBar(u, root, h) -- the Phase 3 bar (a build without PetCard)
		return
	end
	u.card = c
	u.cardWrites = 0
	u.cardHp, u.cardMeter, u.cardLives = nil, nil, -1
	Cards.Static(u)
	Cards.Live(u)
	if u.crowned then
		pcall(Ring.Tag, B, u, root, h)
	end
end

function Cards.Free(u)
	if u.card then
		pcall(u.card.Destroy, u.card)
		u.card = nil
	end
end

-- the XP curve (TycoonCatalog.XpToNext; nil past the cap) and the pet's cap (PetCatalog: 100 for every rarity)
function Cards.Need(level)
	local TC = Mods.Tycoon
	if TC and type(TC.XpToNext) == "function" then
		local ok, need = pcall(TC.XpToNext, level)
		need = ok and tonumber(need) or nil
		if need and need > 0 and need < math.huge then
			return need
		end
	end
	return nil
end

function Cards.Cap(u)
	if PetCatalog then
		if type(PetCatalog.LevelCap) == "function" then
			local ok, cap = pcall(PetCatalog.LevelCap, u.info and u.info.petId)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if type(PetCatalog.MaxPetLevel) == "function" then
			local ok, cap = pcall(PetCatalog.MaxPetLevel)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if tonumber(PetCatalog.MaxLevel) then
			return tonumber(PetCatalog.MaxLevel)
		end
	end
	return math.huge
end

-- XP bar: xp / xpNext; the server leaves xpNext out at the cap (a full bar); 0 when the XP is unknown
function Cards.XpFrac(u)
	if u.xp == nil then
		return 0
	end
	local need = u.xpNext
	if need == nil or need ~= need or need >= math.huge then
		return 1
	end
	return clamp(u.xp / max(1, need), 0, 1)
end

-- level, stars and XP (on Start, after the rewards, on a State change)
function Cards.Static(u)
	local c = u.card
	if not c then
		return
	end
	c:SetLevel(u.level, u.evo, false)
	if u.mine then
		c:SetXp(Cards.XpFrac(u))
	end
end

-- HP and SPECIAL from the latest snapshot values (called only when one of them changed)
function Cards.Live(u)
	local c = u.card
	if not c then
		return
	end
	if u.cardHp ~= u.hp then
		u.cardHp = u.hp
		c:SetHp(clamp(u.hp / u.maxHp, 0, 1))
		u.cardWrites = (u.cardWrites or 0) + 1
	end
	if u.cardMeter ~= u.meter then
		u.cardMeter = u.meter
		if u.mine then
			local frac = clamp(u.meter / METER_MAX, 0, 1)
			c:SetSpecial(frac, frac >= 1 and u.special ~= nil)
			u.cardWrites = (u.cardWrites or 0) + 1
		end
	end
	-- Phase 5: a player fighter's lives as pips (PetCard:SetLives); NPC units have none
	if u.cardLives ~= u.lives then
		u.cardLives = u.lives
		local player = u.owner ~= nil and St.battle ~= nil and St.battle.Names[tostring(u.owner)] ~= nil
		if type(c.SetLives) == "function" and player and not u.benched then
			pcall(c.SetLives, c, u.lives, max(3, u.lives or 0))
		elseif type(c.SetLives) == "function" then
			pcall(c.SetLives, c, nil)
		end
	end
end

-- a raid spectator who joins the fight: the card switches its mode with the side
function Cards.Restyle(u)
	if u.card then
		u.card:SetMode(Cards.ModeOf(u))
		u.cardHp, u.cardMeter = nil, nil
		Cards.Static(u)
		Cards.Live(u)
	end
end

-- display only: the fight's XP (End.Rewards.Xp per team pet) moves my cards' XP bars (levels roll over on the curve);
-- the next Start / the profile mirror bring the server's numbers
function Cards.AddXp(u, xp)
	if u.xp == nil or xp <= 0 then
		return
	end
	u.xp = u.xp + xp
	local cap, guard = Cards.Cap(u), 0
	while u.xpNext and u.xpNext < math.huge and u.xp >= u.xpNext and guard < 200 do
		u.xp = u.xp - u.xpNext
		u.level = u.level + 1
		guard = guard + 1
		u.xpNext = (u.level < cap) and Cards.Need(u.level) or nil
	end
	Cards.Static(u)
end

function Cards.AfterFight(B, payload)
	local rw = type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards or nil
	local xp = rw and num(rw.Xp, 0) or 0
	if xp <= 0 or not B.Fighter or payload.Spectator == true then
		return
	end
	for _, u in pairs(B.mine) do
		Cards.AddXp(u, xp)
	end
end

-- the profile mirror (State.PetLevel) only ever moves a card forward (a stale mirror never undoes the rewards)
function Cards.FromState(B)
	local S = Mods.State
	if not B or not B.Fighter or not S or type(S.PetLevel) ~= "function" then
		return
	end
	if type(S.IsLoaded) == "function" and not S.IsLoaded() then
		return
	end
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.xp ~= nil then
			local ok, lv, xp = pcall(S.PetLevel, key)
			lv, xp = ok and tonumber(lv) or nil, ok and tonumber(xp) or nil
			if lv and xp and (lv > u.level or (lv == u.level and xp > u.xp)) then
				u.level, u.xp = lv, xp
				u.xpNext = (lv < Cards.Cap(u)) and Cards.Need(lv) or nil
				Cards.Static(u)
			end
		end
	end
end

----------------------------------------------------------------------
-- Phase 4: the Champion Ring HUD (contract 3.8)
----------------------------------------------------------------------
Ring.GOLD = Color3.fromRGB(250, 190, 56) -- the ring's champion gold (ArenaBuilder's Ring.Color)
Ring.VIOLET = Color3.fromRGB(156, 96, 238)
Ring.INTERMISSION = tonumber(BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring.Intermission) or 3
Ring.LINGER = 15 -- seconds a won round's floor waits for the next Start (BattleService sends it after INTERMISSION)

function Ring.IsFinal(payload)
	return type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards.Final == true
end

-- a won round that the next one follows: End.Rewards.Next (never the run's final End)
function Ring.IsNext(B, payload)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or nil
	return B.Mode == "Ring" and rw ~= nil and rw.Next ~= nil and rw.Final ~= true
		and (payload.Won == true or payload.Outcome == "Win" or rw.Won == true)
end

function Ring.Money(n)
	return "$" .. Theme.Short(num(n, 0))
end

function Ring.TitleText(B)
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	if Hud.m and Hud.m.Compact then
		-- (a phone's mode line is short: the gold card says it is the ring)
		return best > 0 and ("Round " .. round .. " - Best " .. best) or ("Ring - Round " .. round)
	end
	if best > 0 then
		return "CHAMPION RING - Round " .. round .. " - Best " .. best
	end
	return "CHAMPION RING - Round " .. round
end

-- the champion is built wearing PetBuilder's voxel crown accessory (a copy of its definition, cached by look)
function Ring.Crowned(def)
	if type(def) ~= "table" or type(def.Look) ~= "table" then
		return def
	end
	local copy = {}
	for k, v in pairs(def) do
		copy[k] = v
	end
	local look = {}
	for k, v in pairs(def.Look) do
		look[k] = v
	end
	look.Accessory = "Crown"
	copy.Look = look
	return copy
end

-- the champion's name tag: a pixel billboard above its card (same anchor; the tag sits at the top of a taller,
-- transparent frame, so it keeps a fixed pixel gap above the card at any distance)
function Ring.Tag(B, u, root, h)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local name = tostring(champ.Name or u.name or "Champion")
	if not string.find(name, "^Champion") then
		name = "Champion " .. name
	end
	local px = Theme.ScaledSize(22, 16)
	local th = Theme.ScaledSize(32, 24)
	local gap = Theme.ScaledSize(8, 5)
	local cardH = (u.card and u.card.Gui and u.card.Gui.Size.Y.Offset) or th
	local w = floor(min(Theme.ScaledSize(300, 220), textWidth(name, px) + Theme.ScaledSize(30, 22)))
	local gui = make("BillboardGui", {
		Name = "ChampionTag",
		Adornee = root,
		Size = UDim2.fromOffset(w, cardH + 2 * (th + gap)),
		StudsOffset = Vector3.new(0, h, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
		ResetOnSpawn = false,
	})
	-- (world signs kit-b, audit item 31: the navy rounded plate in a gold ring went) a stone card in a mitred wood edge,
	-- its lip in the ring's gold (WorldTag.LipOf), the name in the kit's brown ink, no outline. The card is inset by its
	-- edge (drawn outside it) so the billboard keeps the edge whole; the name sits above the lip
	local WorldTag = require(Shared:WaitForChild("WorldTag"))
	local edge = WorldTag.Sizes.Edge
	local lip = Theme.ScaledSize(WorldTag.Sizes.Lip, 4)
	local plate = make("Frame", { Name = "Plate", BorderSizePixel = 0, Position = UDim2.fromOffset(edge, edge), Size = UDim2.new(1, -2 * edge, 0, th) }, gui)
	WorldTag.Block(plate, SIGN.Stone, WorldTag.LipOf(Ring.GOLD), SIGN.Wood, edge, lip)
	WorldTag.Text(plate, "Name", name, "Heading", px, SIGN.Text, {
		Size = UDim2.new(1, 0, 1, -lip),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	gui.Parent = u.model
	u.tag = gui
end

-- "Win: +$X +Y XP" (BattleCatalog.RingRewards with the plot's IncomePerSecond, display only: the server pays)
function Ring.Income()
	local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex or "SpotIndex")
	if type(index) ~= "number" then
		return 0
	end
	local folder = Ring.plot
	if not (folder and folder.Parent and folder:GetAttribute("SpotIndex") == index) then
		local lobby = workspace:FindFirstChild("NimbusLobby")
		folder = lobby and lobby:FindFirstChild(string.format("Spot_%02d", index), true) or nil
		Ring.plot = folder
	end
	local value = folder and folder:GetAttribute("IncomePerSecond")
	return type(value) == "number" and value or 0
end

function Ring.Preview(B)
	if B.ringPreview then
		return B.ringPreview
	end
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	local cfg = BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring or {}
	local every = num(cfg.BossEvery, 10)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local p = { Round = round, Record = round > best, Boss = champ.Boss == true or (every > 0 and round % every == 0), Cash = 0, Xp = 0, Tokens = 0 }
	if BattleCatalog and type(BattleCatalog.RingRewards) == "function" then
		local ok, r = pcall(BattleCatalog.RingRewards, round, Ring.Income(), p.Record)
		if ok and type(r) == "table" then
			p.Cash, p.Xp, p.Tokens = num(r.Cash, 0), num(r.Xp, 0), num(r.Tokens, 0)
		end
	end
	B.ringPreview = p
	return p
end

-- the info row of the top card: ring (win pay, record, boss round)
function Ring.BuildInfo(top)
	local info = make("Frame", { Name = "RingInfo", BackgroundTransparency = 1, Visible = false }, top)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, info)
	Hud.info = info
	Hud.infoWin = smallPill(info, "", Theme.Currency.Cash.Color, { Name = "WinPay", LayoutOrder = 1 })
	Hud.infoRecord = smallPill(info, "RECORD x3", Ring.GOLD, { Name = "Record", LayoutOrder = 2, Visible = false })
	Hud.infoBoss = smallPill(info, "BOSS", Ring.VIOLET, { Name = "Boss", LayoutOrder = 3, Visible = false })
end

function Ring.LayoutInfo(B, topW, y)
	local info = Hud.info
	if not info then
		return y
	end
	local ring = B.Mode == "Ring" and B.Fighter
	if not ring then
		info.Visible = false
		return y
	end
	info.Visible = true
	Hud.infoWin.Visible = ring
	Hud.infoRecord.Visible = false
	Hud.infoBoss.Visible = false
	if ring then
		local p = Ring.Preview(B)
		-- (a compact top card drops the "Win:" so the pills fit its width)
		local compact = Hud.m and Hud.m.Compact
		setText(Hud.infoWin, (compact and "+" or "Win: +") .. Ring.Money(p.Cash) .. "  +" .. Theme.Short(p.Xp) .. " XP")
		Hud.infoRecord.Visible = p.Record and B.Round > 1
		Hud.infoBoss.Visible = p.Boss
	end
	info.Position = UDim2.fromOffset(K.PAD, y)
	info.Size = UDim2.fromOffset(topW - 2 * K.PAD, 26)
	return y + 30
end

-- the side card between two rounds: "Round 8 won!" / "+$319  +68 XP" / "Round 9 in 3" (never the screen centre:
-- where the commands were on a wide screen, under the team cards on a tall phone, at the right edge in landscape)
function Ring.EnsureNext()
	if Hud.next and Hud.next.Parent then
		return Hud.next
	end
	if not Hud.root then
		return nil
	end
	-- (kit-b U9-6) a stone card with a gold lip; its heading is the plain kit B title (a card heading, not a window's name)
	local f = neonCard(Hud.root, "NextRoundCard", SIGN.Gold, { Visible = false }).Root
	Hud.next = f
	Hud.nextTitle = Theme.StyleTitle(label(f, "", "Title", 28, { Name = "Title", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink }), "Section")
	Hud.nextLine = label(f, "", "Heading", 21, { Name = "Pay", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink })
	Hud.nextExtra = label(f, "", "Label", 18, { Name = "Extra", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.GrassLip })
	Hud.nextCount = label(f, "", "Display", 24, { Name = "Countdown", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink })
	Hud.nextBar = timerBlocks(f, "Timer") -- (LOOK-ui2: was an 8 px flat gold line) five gold kit blocks
	SignKit.Nails(f, { Inset = 5, ZIndex = 3 })
	Hud.nextLeave = Leave.Make(f, 20) -- LEAVE between two rounds (BattleService takes "Forfeit" during the intermission)
	return f
end

function Ring.ShowNext(B, payload)
	local rw = payload.Rewards
	local round = num(rw.Round, B.Round)
	B.ringNext = {
		Round = round,
		Next = num(rw.Next, round + 1),
		Cash = num(rw.Cash, 0),
		Xp = num(rw.Xp, 0),
		Tokens = num(rw.Tokens, 0),
		Record = rw.Record == true,
		At = os.clock(),
		Seconds = Ring.INTERMISSION,
	}
	if rw.Record == true and B.Ring then
		B.Ring.Best = max(num(B.Ring.Best, 0), round)
	end
	St.next = B.ringNext
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	pcall(Hud.Rebuild) -- top card + team stay, the commands go, Ring.PlaceNext shows the side card
	BattleController._wake()
end

function Ring.PlaceNext(B)
	local nx = B and B.ringNext
	if not nx then
		if Hud.next then
			Hud.next.Visible = false
		end
		return
	end
	local f = Ring.EnsureNext()
	if not f then
		return
	end
	local m = Hud.m or Hud.Metrics()
	setText(Hud.nextTitle, "Round " .. nx.Round .. " won!")
	setText(Hud.nextLine, "+" .. Ring.Money(nx.Cash) .. "   +" .. Theme.Short(nx.Xp) .. " XP")
	local extra = {}
	if nx.Record then
		extra[#extra + 1] = "New record! Cash x3"
	end
	if nx.Tokens > 0 then
		extra[#extra + 1] = "+" .. Theme.Short(nx.Tokens) .. " Tokens"
	end
	Hud.nextExtra.Visible = #extra > 0
	setText(Hud.nextExtra, table.concat(extra, "  "))
	local w
	local portraitTop = nil
	if not m.Compact then
		-- where the action cluster was (bottom right)
		w = 380
		f.AnchorPoint = Vector2.new(1, 1)
		f.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE)
	else
		-- the right edge, under the currency pills / the top card when they reach there; never the screen centre
		w = m.Landscape and max(240, min(320, floor(m.W * 0.3) - 16)) or min(340, m.W - 24)
		local y0 = 6
		local cb = Hud.CurrencyTop(m)
		if cb > 0 then
			y0 = cb + 6
		end
		local tr = Hud.topRect
		if tr and Hud.top.Visible and tr[3] > m.W - w - 20 then
			-- a landscape phone: narrow the card to stay beside the top card (below it would reach the DASH button)
			-- (kitb-matchhud look0 N2, kit-b's own: 10 design px left the top card's hard shadow on the card's frame, 0 px of
			-- air at 640 x 360 / 667 x 375) its shadow, the card's 2 px frame and K.INK_AIR_PX of air at the least
			local w2 = m.W - 8 - (tr[3] + max(10, Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX)))
			if m.Landscape and w2 >= 220 then
				w = w2
			else
				y0 = max(y0, tr[4] + 8)
			end
		end
		if m.Landscape then
			f.AnchorPoint = Vector2.new(1, 0)
			f.Position = UDim2.fromOffset(m.W - 8, y0)
		else
			-- a tall phone: under the top card at the right (clear of the fighter block), above the screen centre;
			-- else the lower right above the jump / RUN buttons (placed once the card's height is known)
			portraitTop = (tr and Hud.top.Visible) and (tr[4] + 8) or y0
			if Hud.team.Visible then
				local teamRight = Hud.team.Position.X.Offset + Hud.team.Size.X.Offset
				local teamBottom = Hud.team.Position.Y.Offset + Hud.team.Size.Y.Offset
				if Hud.bandOn and Hud.fighterCard then
					-- (kitb-matchhud look0 N2: with the ring's strip across the top - kit-b backlog 9 - the team stands under it
					-- and the card, placed under the strip, found the fighter card's whole width there, fell back to 340 wide and
					-- lay 32.8 px on the helpers at 360 x 640) it starts under the fighter card, its edge and shadow (Hud.TeamGap;
					-- the card's own frame 2 px more), beside the helpers alone, as it did under kit-b's top card beside the
					-- fighter card
					portraitTop = max(portraitTop, Hud.team.Position.Y.Offset + Hud.fighterCard.Root.Size.Y.Offset + Hud.TeamGap(m) + Hud.Air(m, 2))
				end
				if Hud.fighterCard and portraitTop >= Hud.team.Position.Y.Offset + Hud.fighterCard.Root.Size.Y.Offset then
					-- (only the helpers reach down here: their column, or P2 fix A r1's row of two)
					teamRight = Hud.team.Position.X.Offset + (Hud.helperHolder and Hud.helperHolder.Size.X.Offset or Hud.helperCellW or 0)
				end
				if teamBottom > portraitTop then
					-- ((look0 N2, kit-b's own: 8 design px left the two frames 1.8 - 2.4 px apart) K.INK_AIR_PX more)
					w = min(w, m.W - 8 - teamRight - 8 - Hud.Air(m, K.INK_AIR_PX))
				end
			end
			if w < 240 then
				w = min(340, m.W - 24)
				portraitTop = nil
			end
		end
	end
	local inner = w - 2 * K.PAD - 8
	-- the rows, top down; `inline`: LEAVE shares the countdown's row -> the card's height
	local function layRows(inline)
		local y = K.PAD
		Hud.nextTitle.Position = UDim2.fromOffset(K.PAD + 4, y)
		Hud.nextTitle.Size = UDim2.fromOffset(inner, 32)
		y = y + 34
		Hud.nextLine.Position = UDim2.fromOffset(K.PAD + 4, y)
		Hud.nextLine.Size = UDim2.fromOffset(inner, 26)
		y = y + 28
		if #extra > 0 then
			Hud.nextExtra.Position = UDim2.fromOffset(K.PAD + 4, y)
			Hud.nextExtra.Size = UDim2.fromOffset(inner, 22)
			y = y + 26
		end
		-- (look0 N2 re-look: the landscape card, kept off the top card's shadow, is 5 design px narrower at 640 x 360 /
		-- 667 x 375 and 'Next in 3' ran under LEAVE) an inline LEAVE gives the countdown's short form its room, down to 76
		local leaveW = 92
		if inline and inner - 92 - 6 < 150 then
			local okN, mN = pcall(Theme.Measure, "Next in 9", "Display", 24)
			local need = (okN and typeof(mN) == "Vector2" and mN.X > 0) and (mN.X * 1.04 + 4) or 0
			leaveW = max(76, min(92, floor(inner - 6 - need)))
		end
		local countW = inline and (inner - leaveW - 6) or inner
		Hud.nextShort = countW < 150 -- ("Next in 3" when the row is short)
		Hud.nextCount.Position = UDim2.fromOffset(K.PAD + 4, y + (inline and 4 or 0))
		Hud.nextCount.Size = UDim2.fromOffset(countW, 30)
		local countY = y
		y = y + (inline and 42 or 32)
		Hud.nextBar.Root.Position = UDim2.fromOffset(K.PAD + 4, y)
		y = y + 14 + K.PAD
		if inline then
			Leave.PlaceOnCard(m, B, w, countY, true, leaveW)
		else
			y = Leave.PlaceOnCard(m, B, w, y)
		end
		return y
	end
	-- a landscape phone: LEAVE shares the countdown's row (the card stays clear of the DASH / RUN buttons under it)
	local inline = m.Compact and m.Landscape and Leave.Allowed(B)
	local y = layRows(inline)
	local above = nil
	if m.Compact and not m.Landscape then
		local r = Hud.TouchRects(m)
		-- (kitb-matchhud look0 N2: the card's hard shadow and RUN's wood edge took 9 - 10 of the 12 screen px it kept over
		-- RUN's box: 2 - 3 px of air at 360 x 640 .. 430 x 932) K.INK_AIR_PX more
		above = (max(r.jump[4], r.run[4]) + 12 + K.INK_AIR_PX) / max(0.05, m.F)
		-- (look0 N2) under the ring's strip the card stands between the fighter card and RUN (portraitTop): where its rows
		-- are taller than that room (384 x 640), LEAVE shares the countdown's row, as on a landscape phone
		if Hud.bandOn and portraitTop and not inline and Leave.Allowed(B) and portraitTop + y > m.H - above then
			inline = true
			y = layRows(true)
		end
	end
	f.Size = UDim2.fromOffset(w, y)
	if m.Compact and not m.Landscape then
		if portraitTop and portraitTop + y <= m.H * 0.5 - 4 then
			f.AnchorPoint = Vector2.new(1, 0)
			f.Position = UDim2.fromOffset(m.W - 8, portraitTop)
		else
			f.AnchorPoint = Vector2.new(1, 1)
			f.Position = UDim2.fromOffset(m.W - 8, m.H - above)
		end
	end
	f.Visible = true
	Hud.FixText(f, m.F)
	Ring.UpdateNext(os.clock())
end

-- the countdown (a text write only when the shown second changes)
function Ring.UpdateNext(now)
	local nx = St.next
	if not nx then
		return
	end
	local f = Hud.next
	if not f or not f.Visible or not St.battle or St.battle.ringNext ~= nx then
		Ring.HideNext()
		return
	end
	local left = nx.Seconds - (now - nx.At)
	local label = Hud.nextShort and "Next" or ("Round " .. nx.Next)
	local text = (left > 0.05) and (label .. " in " .. math.ceil(left - 0.05)) or (label .. "...")
	setText(Hud.nextCount, text)
	setTimer(Hud.nextBar, clamp(left / max(0.1, nx.Seconds), 0, 1))
end

function Ring.HideNext()
	St.next = nil
	if Hud.next then
		Hud.next.Visible = false
	end
end

-- the run ended between two rounds (its final End names the last round's id): the result card replaces the side card
function Ring.FinalAfterWin(B, payload)
	B.ringNext = nil
	Net.Music()
	Ring.HideNext()
	B.linger = K.END_LINGER
	B.endAt = os.clock()
	Hud.ShowEnd(B, payload)
end

-- my pets' models + cards out of a won round (to be handed to the next round's units of the same key)
function Ring.TakeModels(B)
	local out = {}
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.model and not u.failed and out[key] == nil then
			out[key] = { model = u.model, root = u.root, height = u.height, centerY = u.centerY, rigid = u.rigid, card = u.card, evo = u.evo, x = u.x, z = u.z, yaw = u.yaw }
			u.model, u.root, u.card = nil, nil, nil
			out[key].model.Parent = nil
		end
	end
	return out
end

function Ring.GiveModels(B, carry)
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		local c = type(key) == "string" and carry[key] or nil
		if c and c.evo == u.evo and not u.model then
			carry[key] = nil
			u.model, u.root, u.height, u.centerY, u.rigid, u.card = c.model, c.root, c.height, c.centerY, c.rigid, c.card
			u.x, u.z, u.yaw, u.seen = c.x, c.z, c.yaw, false
			u.folder = B.folder
			u.model.Name = "Unit_" .. tostring(u.id)
			u.model.Parent = B.folder
			u.cardWrites = 0
			u.cardHp, u.cardMeter = nil, nil
			u.carried = true
			if u.card then
				u.card:SetMode(Cards.ModeOf(u))
				Cards.Static(u)
				Cards.Live(u)
			end
		end
	end
	for _, c in pairs(carry) do
		if c.card then
			pcall(c.card.Destroy, c.card)
		end
		pcall(c.model.Destroy, c.model)
	end
end

-- the result card of a run: RUN OVER / NEW RECORD!, where it ended
function Ring.ResultTitle(B, payload, sub)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local run = type(rw.Run) == "table" and rw.Run or {}
	local round = num(run.Round, num(rw.Round, B.Round))
	local title = run.Record ~= nil and "NEW RECORD!" or "RUN OVER"
	local why
	if rw.Void == true then
		why = "server restart: round " .. round .. " does not count"
	elseif payload.Reason == "Fainted" then
		-- HUD cleanup Task 4 (no heal): the last win left nobody standing; the server sends it as Outcome "Left"
		why = "your whole team fainted after round " .. round
	elseif payload.Outcome == "Left" or payload.Reason == "Forfeit" or payload.Reason == "Left" then
		why = "you left after round " .. round
	elseif payload.Reason == "Timeout" then
		why = "time ran out in round " .. round
	else
		why = "the champion won round " .. round
	end
	return title, Ring.GOLD, "Champion Ring: " .. why
end

-- the run's lines: Rounds won, Cash, XP, Tokens, the record
function Ring.ResultLines(B, rw)
	local run = type(rw.Run) == "table" and rw.Run or nil
	if not run then
		return Hud.RewardLines(B, rw)
	end
	local lines = {}
	local wins = num(run.Wins, 0)
	lines[#lines + 1] = { "Rounds won: " .. wins, COLORS.Gold }
	lines[#lines + 1] = { "+" .. Ring.Money(run.Cash) .. " Cash", Theme.Currency.Cash.Color }
	lines[#lines + 1] = { "+" .. Theme.Short(num(run.Xp, 0)) .. " Pet XP", COLORS.Ally }
	local tokens = num(run.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.Short(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	-- (level-ups are the server's toasts: the card stays short enough for a landscape phone)
	if run.Record ~= nil then
		lines[#lines + 1] = { "Best: round " .. tostring(run.Record) .. "!", COLORS.Mine }
	elseif num(run.Best, 0) > 0 then
		lines[#lines + 1] = { "Best: round " .. tostring(num(run.Best, 0)), COLORS.Weak }
	end
	return lines
end

-- team balance (spec 2026-10-31 s.7): a lost run. The server sends Rewards.Pets for a Wipe, a Timeout or a Fainted run only
-- (never a forfeit, a leave, a void round): the loss screen takes the place of the run card.
function Ring.IsLoss(payload)
	if not Ring.IsFinal(payload) or payload.Won == true then
		return false
	end
	return type(payload.Rewards.Pets) == "table" and #payload.Rewards.Pets > 0
end

-- client/Controllers/LossScreen, loaded once; nil when the build has none (today's card then)
function Ring.LossModule()
	if Mods.Loss == nil then
		Mods.Loss = optional(script.Parent, "LossScreen") or false
	end
	return Mods.Loss or nil
end

-- -> true when the loss screen took over
function Ring.ShowLoss(B, payload)
	local LS = Ring.LossModule()
	if not LS then
		return false
	end
	local rw = payload.Rewards
	local title, color, sub = Ring.ResultTitle(B, payload, "")
	local start = rw.Start
	local okS, shown = pcall(LS.Show, {
		Mode = "Ring",
		Title = title,
		Color = color,
		Sub = sub,
		Pets = rw.Pets,
		Lines = Ring.ResultLines(B, rw),
		Start = start,
		OnFightAgain = function()
			local arena = optional(script.Parent, "ArenaController")
			if arena and type(arena.Request) == "function" then
				arena.Request("Ring", start)
			end
		end,
	})
	if not okS or shown ~= true then
		warnOnce("loss screen", shown)
		return false
	end
	Ring.HideNext()
	Hud.HideResult()
	Hud.SetVisible(false)
	return true
end

-- the end of a participant's battle: the loss screen, or the result card
function Hud.ShowEnd(B, payload)
	if B.Mode == "Ring" and Ring.IsLoss(payload) and Ring.ShowLoss(B, payload) then
		return
	end
	-- (a lost Dungeon floor: DungeonController's run End shows the screen; the card never stays under it)
	local LS = B.Mode == "Dungeon" and Ring.LossModule() or nil
	if LS and LS.IsOpen() then
		Hud.SetVisible(false)
		return
	end
	Hud.ShowResult(B, payload)
end

----------------------------------------------------------------------
-- Input (contract 4.7 control map; bound through ContextActionService at High priority ONLY while fighting)
--   TARGET  F / X / its button: the fighter attacks by itself (server auto-attack): a tap (on release, under 0.4 s) =
--           Target(the next enemy), the pet goes after it; a hold of 0.4 s = Target(nil), back to automatic. One enemy:
--           the caption says so, nothing is sent. A left click on an enemy (with the mouse locked the enemy under the
--           screen centre) or a tap on it = Target(its id); a click on nothing sends nothing
--   ELEMENT E / Y / its button (cooldown ring); E passes through while a ProximityPrompt is shown (exit, chest)
--   SPECIAL Q / RB / its button (lights gold at 100)
--   DASH    Shift / B / its button: the PET dashes ("Dash"; MovementController.SetPetDash: no character impulse, no
--           stamina); RUN moves to Ctrl in a battle
--   lock    Tab cycles (nearest first), click / tap an enemy or its row; T clears; RT cycles, LT clears
--   helpers 1 / 2 (LB / D-up) tap = its buff, hold 0.5 s = swap; the SWAP chip; D-left / D-right swap; the portrait
--           (tap = buff, hold = swap)
----------------------------------------------------------------------
local KEY_HELPER = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.ButtonL1] = 1,
	[Enum.KeyCode.DPadUp] = 2,
}
local KEY_SWAP = {
	[Enum.KeyCode.DPadLeft] = 1,
	[Enum.KeyCode.DPadRight] = 2,
}

local function sink()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Sink
	end)
	return ok and v or nil
end

local function pass()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Pass
	end)
	return ok and v or nil
end

local function fighting()
	local B = St.battle
	return B ~= nil and B.Fighter and not B.ended
end

-- the main menu is gone (UiGate.HasPlayed, 7.2); no UiGate module = always
function Input.GateOpen()
	local hook = BattleController.Hooks.Gate
	if type(hook) == "function" then
		return hook() ~= false
	end
	if Mods.UiGate == nil then
		Mods.UiGate = optional(Client, "UiGate") or false
	end
	local g = Mods.UiGate
	if g and type(g.HasPlayed) == "function" then
		local ok, played = pcall(g.HasPlayed)
		return (not ok) or played ~= false
	end
	return true
end

-- a ProximityPrompt shown to me that E would press (dungeon fixes 6: E stays the interaction key)
function Input.PromptShown()
	for prompt in pairs(St.prompts) do
		local ok, live = pcall(function()
			local code = prompt.KeyboardKeyCode
			return prompt.Parent ~= nil and prompt.Enabled ~= false and (code == nil or code == Enum.KeyCode.E)
		end)
		if ok and live then
			return true
		elseif not ok or prompt.Parent == nil then
			St.prompts[prompt] = nil
		end
	end
	return false
end

function Input.OnAction(name, state, input)
	if not fighting() or not Input.GateOpen() then
		return pass()
	end
	local began = state == Enum.UserInputState.Begin
	local key = input and input.KeyCode
	if name == K.ACTION_ELEMENT and key == Enum.KeyCode.E and Input.PromptShown() then
		return pass() -- the shown prompt (the room's exit, a chest) gets the E
	end
	local ended = state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
	if name == K.ACTION_SWITCH then
		if began then
			Input.HoldStart("targetKey", 0, os.clock(), "Target")
		elseif state == Enum.UserInputState.Cancel then
			Input.HoldDrop("targetKey") -- (the key was taken away: no press the player finished)
		elseif ended then
			Input.HoldEnd("targetKey")
		end
	elseif name == K.ACTION_ELEMENT then
		if began then
			Input.Press("Element", true)
		end
	elseif name == K.ACTION_SPECIAL then
		if began then
			Input.Press("Special", true)
		end
	elseif name == K.ACTION_TARGET then
		if began then
			if key == Enum.KeyCode.T or key == Enum.KeyCode.ButtonL2 then
				Input.ClearTarget()
			else
				Input.SwitchTarget()
			end
		end
	elseif name == K.ACTION_HELPER then
		local index = key and KEY_HELPER[key]
		local swapIndex = key and KEY_SWAP[key]
		if swapIndex then
			if began then
				Input.Helper("Swap", swapIndex)
			end
		elseif index then
			if began then
				Input.HoldStart("key" .. index, index, os.clock())
			elseif ended then
				Input.HoldEnd("key" .. index)
			end
		end
	elseif name == K.ACTION_RETREAT then
		if began then
			BattleController.Retreat()
		end
	end
	return sink()
end

function Input.Bind(on)
	if on == St.bound then
		return
	end
	St.bound = on
	if on then
		local priority = 2000
		pcall(function()
			priority = Enum.ContextActionPriority.High.Value
		end)
		pcall(function()
			ContextActionService:BindActionAtPriority(K.ACTION_SWITCH, Input.OnAction, false, priority, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
			ContextActionService:BindActionAtPriority(K.ACTION_ELEMENT, Input.OnAction, false, priority, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
			ContextActionService:BindActionAtPriority(K.ACTION_SPECIAL, Input.OnAction, false, priority, Enum.KeyCode.Q, Enum.KeyCode.ButtonR1)
			ContextActionService:BindActionAtPriority(K.ACTION_TARGET, Input.OnAction, false, priority, Enum.KeyCode.Tab, Enum.KeyCode.T, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
			ContextActionService:BindActionAtPriority(
				K.ACTION_HELPER, Input.OnAction, false, priority,
				Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.KeypadOne, Enum.KeyCode.KeypadTwo,
				Enum.KeyCode.ButtonL1, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight
			)
			-- (R stays free everywhere but a boss raid)
			if Retreat.Allowed(St.battle) then
				ContextActionService:BindActionAtPriority(K.ACTION_RETREAT, Input.OnAction, false, priority, Enum.KeyCode.R, Enum.KeyCode.DPadDown)
			end
		end)
	else
		for _, name in ipairs({ K.ACTION_SWITCH, K.ACTION_ELEMENT, K.ACTION_SPECIAL, K.ACTION_TARGET, K.ACTION_HELPER, K.ACTION_RETREAT }) do
			pcall(function()
				ContextActionService:UnbindAction(name)
			end)
		end
		St.holds = {}
	end
end

-- MovementController's battle switches (contract 3.9 / 4.4, dungeon fixes decision 5): Shift / B = the PET's dash
-- (SetPetDash: the keys only send "Dash", the character gets no impulse and spends no stamina; RUN moves to Ctrl),
-- the battle speeds. (An older MovementController without SetPetDash: the old character dash keys.)
function Input.Movement(B, on)
	local mc = Hud.Movement()
	if not mc then
		return
	end
	if on then
		if type(mc.SetPetDash) == "function" then
			pcall(mc.SetPetDash, Input.PetDash)
		else
			local F = BattleCatalog and BattleCatalog.Fighter or {}
			pcall(mc.SetDashKeys, { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonB })
			pcall(mc.SetFreeDash, true, num(F.DashCooldown, 2.5))
			if type(mc.SetDashListener) == "function" then
				pcall(mc.SetDashListener, Input.PetDash)
			end
		end
		local sp = B and B.speed
		if sp then
			pcall(mc.SetBattleSpeed, sp.Walk, sp.Run)
		end
		St.movementOn = true
	elseif St.movementOn then
		St.movementOn = false
		if type(mc.SetPetDash) == "function" then
			pcall(mc.SetPetDash, nil)
		else
			pcall(mc.SetDashKeys, nil)
			pcall(mc.SetFreeDash, false)
			if type(mc.SetDashListener) == "function" then
				pcall(mc.SetDashListener, nil)
			end
		end
		pcall(mc.SetBattleSpeed, nil)
	end
end

-- Shift / B in a battle (MovementController.SetPetDash calls it): the pet's dash
function Input.PetDash()
	if not fighting() or not Input.GateOpen() then
		return false
	end
	return BattleController.Command("Dash")
end

-- a button press of an action (keys, the round buttons): ONE command per press
function Input.Press(kind, down)
	if not down or not fighting() then
		return
	end
	BattleController.Command(kind)
end

-- (Pitch 2 item 1b) the three keys' MOVE pressed: a meter that is not full (or no special) = the element at once, as the
-- old ELEMENT key; a full meter = a hold (MOVE_HOLD): held that long it fires the special, released sooner it is the
-- element (a slide off the key is nothing)
function Input.MoveBegan(input, gui)
	local B = St.battle
	local f = B and B.fighterId and B.units[B.fighterId]
	if f and f.special and f.meter >= METER_MAX then
		Input.HoldStart("moveButton", 0, os.clock(), "Move", input, gui)
	else
		Input.Press("Element", true)
	end
end

-- MOVE's touch / click ended, over the key or anywhere (as TargetButtonEnded): a release on the key before MOVE_HOLD = the
-- element; a release off it, or after the special fired, sends nothing more
function Input.MoveEnded(input)
	local h = St.holds and St.holds.moveButton
	if not h or (h.input ~= nil and input ~= nil and h.input ~= input and input.UserInputType ~= Enum.UserInputType.MouseButton1) then
		return
	end
	St.holds.moveButton = nil
	if not h.fired and Input.OnButton(input, h.gui) then
		Input.Press("Element", true)
	end
end

-- per frame: a helper key / portrait held 0.5 s swaps; a TARGET key / button held 0.4 s clears the lock; MOVE held 0.4 s
-- on a full meter fires the special
function Input.Tick(B, now)
	if not B or not fighting() then
		return
	end
	for key, h in pairs(St.holds or {}) do
		if (h.kind == "Target" or h.kind == "Move") and not h.fired and h.gui and h.input and not Input.OnButton(h.input, h.gui) then
			St.holds[key] = nil -- the touch / cursor slid off the TARGET / MOVE button: nothing the player asked for
		elseif h.kind == "Move" then
			if not h.fired and now - h.t >= K.MOVE_HOLD then
				h.fired = true
				Input.Press("Special", true)
			end
		elseif h.kind == "Target" then
			if not h.fired and now - h.t >= K.TARGET_HOLD then
				h.fired = true
				Input.ClearTarget()
			end
		elseif not h.fired and now - h.t >= K.SWAP_HOLD then
			h.fired = true
			Input.Helper("Swap", h.index)
		end
	end
	if St.targetFlashUntil and os.clock() >= St.targetFlashUntil then
		St.targetFlash, St.targetFlashUntil = nil, nil
		Hud.Captions(B)
	end
end

-- `kind` "Target" = a TARGET hold (never a helper's Buff / Swap); `input` / `gui` (the TARGET button's touch / click): the
-- hold is dropped when that input leaves the button
function Input.HoldStart(key, index, t, kind, input, gui)
	if not fighting() or not Input.GateOpen() then
		return
	end
	St.holds = St.holds or {}
	St.holds[key] = { index = index, t = t, fired = false, kind = kind, input = input, gui = gui }
	BattleController._wake()
end

function Input.HoldEnd(key)
	local h = St.holds and St.holds[key]
	if not h then
		return
	end
	St.holds[key] = nil
	if h.fired then
		return
	end
	if h.kind == "Target" then
		Input.SwitchTarget() -- the tap: released under 0.4 s (a fired hold has cleared the lock and sends nothing more)
	else
		Input.Helper("Buff", h.index)
	end
end

function Input.HoldDrop(key)
	if St.holds then
		St.holds[key] = nil
	end
end

-- the TARGET button's touch / click ended, over the button or anywhere (a release off it never reaches the button's own
-- InputEnded; both may come for one release, the hold answers once): a release off the button is no tap
function Input.TargetButtonEnded(input)
	local h = St.holds and St.holds.targetButton
	if not h then
		return
	end
	if h.fired or Input.OnButton(input, h.gui) then
		Input.HoldEnd("targetButton")
	else
		Input.HoldDrop("targetButton")
	end
end

-- 0..1 of a running swap hold on helper `index` (the SWAP chip fills; nothing for a short tap)
function Input.HoldFrac(index, now)
	local best = 0
	for _, h in pairs(St.holds or {}) do
		if h.index == index and not h.fired and h.kind ~= "Target" then
			local p = (now - h.t - 0.1) / (K.SWAP_HOLD - 0.1)
			if p > best then
				best = min(1, p)
			end
		end
	end
	return best
end

-- "Buff" / "Swap" for the helper shown in portrait `index` (its team slot goes to the server)
function Input.Helper(action, index)
	local B = St.battle
	if not B or not fighting() then
		return false
	end
	local H = Hud.helpers and Hud.helpers[index]
	local u = H and H.unit
	if not u then
		local bench = Hud.Bench(B)
		u = bench[index]
	end
	if not u then
		return false
	end
	return BattleController.Command(action, u.slot)
end

-- TARGET's caption reads `text` for NEXT_FLASH
function Input.FlashTarget(B, text)
	St.targetFlash, St.targetFlashUntil = text, os.clock() + K.NEXT_FLASH
	Hud.Captions(B)
end

-- a hold of F / X / TARGET, T / LT: back to automatic (the pet keeps its engaged target, then picks the nearest)
function Input.ClearTarget()
	local B = St.battle
	if not B then
		return
	end
	BattleController.Focus(nil)
	Input.FlashTarget(B, "AUTO")
end

-- a tap of F / X / TARGET, Tab / RT: lock the next enemy, nearest to my fighter first (the pet goes after the lock: the
-- server's engage order). One enemy: nothing to switch to, it says so and sends nothing
function Input.SwitchTarget()
	local B = St.battle
	if not B then
		return
	end
	local f = B.fighterId and B.units[B.fighterId]
	local fx, fz = f and f.x or 0, f and f.z or 0
	local list = {}
	for _, u in ipairs(B.list) do
		if not u.ally and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED and not u.hidden and (u.model or u.isBoss) then
			local dx, dz = u.x - fx, u.z - fz
			list[#list + 1] = { u = u, d = dx * dx + dz * dz }
		end
	end
	if #list == 0 then
		return
	end
	if #list == 1 then
		Hud.Shake(Hud.ButtonOf("Target"))
		Input.FlashTarget(B, "ONE ENEMY")
		return
	end
	table.sort(list, function(a, b)
		if a.d ~= b.d then
			return a.d < b.d
		end
		return a.u.id < b.u.id
	end)
	local pick = list[1].u
	for i, e in ipairs(list) do
		if e.u.id == B.lock then
			pick = list[(i % #list) + 1].u
			break
		end
	end
	if BattleController.Focus(pick.id) then
		Hud.Pop(Hud.ButtonOf("Target"))
		Input.FlashTarget(B, "NEXT")
	end
end

-- the enemy a tap / click at viewport pixel (x, y) picks (nearest projected enemy within reach), or nil
function BattleController.ScreenPick(x, y)
	local B = St.battle
	local cam = workspace.CurrentCamera
	if not B or not cam then
		return nil
	end
	local reach = K.TAP_REACH * Theme.ScreenFactor()
	local best, bestD = nil, math.huge
	for _, u in ipairs(B.list) do
		if not u.ally and u.model and not u.parked and not u.hidden and u.hp > 0 and u.state ~= S_DOWN then
			local ok, p, onScreen = pcall(cam.WorldToViewportPoint, cam, unitCenter(B, u))
			if ok and onScreen and p.Z > 0 then
				local dx, dy = p.X - x, p.Y - y
				local d = sqrt(dx * dx + dy * dy)
				local r = reach
				if u.isBoss then
					r = reach * 3
				elseif u.kind == "MiniBoss" then
					r = reach * 1.6
				end
				if d <= r and d < bestD then
					best, bestD = u.id, d
				end
			end
		end
	end
	return best
end

local function guiInset()
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	return inset
end

function Input.OnBegan(input, processed)
	local t = input.UserInputType
	if t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2 then
		if not St.gamepad then
			St.gamepad = true
			Hud.Keys()
		end
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if St.gamepad then
			St.gamepad = false
			Hud.Keys()
		end
	end
	if processed or not fighting() or not Input.GateOpen() then
		return
	end
	if t == Enum.UserInputType.Touch then
		St.tap = { x = input.Position.X, y = input.Position.Y, t = os.clock(), input = input }
	elseif t == Enum.UserInputType.MouseButton1 then
		-- a click on an enemy picks it: the one under the cursor (the screen centre while MouseLock holds the cursor there);
		-- a click on nothing sends nothing, holding the mouse never cycles
		local x, y = input.Position.X, input.Position.Y + guiInset()
		local cam = workspace.CurrentCamera
		if Input.MouseLocked() and cam then
			x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
		end
		local id = BattleController.ScreenPick(x, y)
		if id then
			BattleController.Focus(id)
		end
	end
end

-- the cursor is locked at the screen centre (client/MouseLock's option: MouseBehavior LockCenter)
function Input.MouseLocked()
	local ok, locked = pcall(function()
		return UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
	end)
	return ok and locked == true
end

-- is `input` (a touch / the mouse, GUI-inset space) still over `gui` (a few px of slack)?
function Input.OnButton(input, gui)
	local ok, inside = pcall(function()
		local p = input.Position
		local sg = gui:FindFirstAncestorOfClass("ScreenGui")
		local y = p.Y + ((sg and sg.IgnoreGuiInset) and guiInset() or 0)
		local a, s = gui.AbsolutePosition, gui.AbsoluteSize
		local slack = 6
		return gui.Visible and p.X >= a.X - slack and p.X <= a.X + s.X + slack and y >= a.Y - slack and y <= a.Y + s.Y + slack
	end)
	return not ok or inside == true
end

function Input.OnEnded(input)
	local t = input.UserInputType
	-- the TARGET button's hold ends with its own touch / the mouse button wherever it is released
	local ah = St.holds and St.holds.targetButton
	if ah and ((t == Enum.UserInputType.MouseButton1 and (ah.input == nil or ah.input.UserInputType == t)) or (t == Enum.UserInputType.Touch and (ah.input == nil or ah.input == input))) then
		Input.TargetButtonEnded(input)
	end
	-- (Pitch 2 item 1b) so does MOVE's hold
	if St.holds and St.holds.moveButton and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then
		Input.MoveEnded(input)
	end
	local tap = St.tap
	if not tap or t ~= Enum.UserInputType.Touch then
		return
	end
	St.tap = nil
	if not fighting() or os.clock() - tap.t > K.TAP_TIME then
		return
	end
	local dx, dy = input.Position.X - tap.x, input.Position.Y - tap.y
	if dx * dx + dy * dy > K.TAP_MOVE * K.TAP_MOVE then
		return
	end
	-- input positions are in GUI space (below the top bar); the camera projects into the full viewport
	local id = BattleController.ScreenPick(input.Position.X, input.Position.Y + guiInset())
	if id then
		BattleController.Focus(id)
	end
end

----------------------------------------------------------------------
-- Commands (BattleCommand(action, arg)); the server decides everything, the client predicts only the button's ring
----------------------------------------------------------------------
local VALID_ACTIONS = { Attack = true, Element = true, Special = true, Dash = true, Target = true, Buff = true, Swap = true, Forfeit = true, Cheer = true, Retreat = true, Engage = true }

local function commandRemote()
	if St.remoteCmd and St.remoteCmd.Parent then
		return St.remoteCmd
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild("BattleCommand")
	St.remoteCmd = r
	return r
end

-- the cooldown lengths of my team (BattleCatalog.Fighter; a helper's own Cooldown from its unit info)
function Input.CooldownLengths(B)
	local F = BattleCatalog and BattleCatalog.Fighter or {}
	B.cdLen = {
		Element = num(F.ElementCooldown, 7),
		Dash = num(F.DashCooldown, 2.5),
		Swap = num(F.SwapCooldown, 10),
		Cheer = num(F.CheerCooldown, 20),
		Retreat = num(F.RetreatWait, 10),
		Buff = {},
	}
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u then
			local buff = type(u.info.buff) == "table" and u.info.buff or nil
			local default = (u.info.role == "Support") and num(F.SupportCooldown, 12) or num(F.HelperCooldown, 15)
			B.cdLen.Buff[slot] = num(buff and buff.Cooldown, default)
		end
	end
end

-- a local refusal: the button shakes, nothing is sent
local function refuse(action, slot)
	Hud.Shake(Hud.ButtonOf(action, slot))
	return false
end

function BattleController.Command(action, arg)
	local B = St.battle
	if not B or not B.Fighter then
		return false
	end
	-- a ring run can be left between two rounds too: the won round has ended, the next Start has not come yet
	if B.ended and not (action == "Forfeit" and B.Mode == "Ring" and B.ringNext ~= nil) then
		return false
	end
	if not VALID_ACTIONS[action] then
		return false
	end
	local key = action .. tostring(arg)
	local now = os.clock()
	local gap = (action == "Attack") and K.ATTACK_GAP or K.CMD_GAP
	if St.lastCmd[key] and now - St.lastCmd[key] < gap then
		return false
	end
	-- local checks: instant feedback, no pointless traffic (the server decides)
	local f = B.fighterId and B.units[B.fighterId]
	if action == "Element" or action == "Dash" or action == "Swap" then
		if cdLeft(B, action, nil, now) > K.CD_SLACK then
			return refuse(action)
		end
		if action == "Swap" then
			local u = B.mine[tonumber(arg) or 0]
			if not u or u.id == B.fighterId or u.hp <= 0 or u.state == S_DOWN then
				return refuse(action, tonumber(arg))
			end
		end
	elseif action == "Buff" then
		local slot = tonumber(arg) or 0
		local u = B.mine[slot]
		if not u or u.id == B.fighterId or u.hp <= 0 or u.state == S_DOWN or cdLeft(B, "Buff", slot, now) > K.CD_SLACK then
			return refuse(action, slot)
		end
	elseif action == "Special" then
		if not f or not f.special or f.meter < METER_MAX then
			return refuse(action)
		end
	elseif action == "Cheer" then
		-- (wave 6) Raid / Dungeon only; the Ring / PvP podium cheer is the server's
		if not CheerUp.Allowed(B) then
			return false
		end
		if arg ~= nil or cdLeft(B, "Cheer", nil, now) > K.CD_SLACK then
			return refuse(action)
		end
	elseif action == "Retreat" or action == "Engage" then
		-- (evolved forms) boss raids only; the wait, and a press the echo already answered
		if not Retreat.Allowed(B) then
			return false
		end
		if arg ~= nil or (action == "Engage") ~= (B.retreated == true) or (action == "Retreat" and cdLeft(B, "Retreat", nil, now) > K.CD_SLACK) then
			return refuse(action)
		end
	elseif (action == "Attack" or action == "Target") and arg ~= nil then
		local u = B.units[arg]
		if not u or u.ally or u.hp <= 0 then
			return false
		end
	end
	St.lastCmd[key] = now
	local remote = commandRemote()
	if not remote then
		return false
	end
	local ok = pcall(function()
		if arg ~= nil then
			remote:FireServer(action, arg)
		else
			remote:FireServer(action)
		end
	end)
	if not ok then
		return false
	end
	St.sent = (St.sent or 0) + 1
	if action == "Forfeit" then
		return true -- the run's End does the rest
	end
	Input.Predict(B, action, arg, now)
	return true
end

-- wave 6: Cheer up! (the button does the same)
function BattleController.Cheer()
	return BattleController.Command("Cheer")
end

-- evolved forms: the R button: Retreat, or Engage while my team is back (the key and the button do the same)
function BattleController.Retreat()
	local B = St.battle
	return BattleController.Command((B and B.retreated) and "Engage" or "Retreat")
end

-- lock-on: Target(id) (nil clears); the server echoes the lock (Order "Target")
function BattleController.Focus(unitId)
	local B = St.battle
	if not B or not B.Fighter or B.ended then
		return false
	end
	if unitId == B.lock then
		return false -- (no lock to clear, or the enemy already picked: no traffic)
	end
	return BattleController.Command("Target", unitId)
end

-- prediction: the button's own ring starts at once; the matching event (Element / Dash / Buff / Swap / Hit /
-- Special / Order) within PENDING_TIMEOUT confirms it, a rejected Order or the timeout puts the old ring back
function Input.Predict(B, action, arg, now)
	local pend = B.pending
	local cd = B.cd
	if action == "Element" or action == "Dash" or action == "Swap" or action == "Cheer" then
		pend[action] = { t = now, prev = cd[action] or 0 }
		cd[action] = now + (B.cdLen[action] or 1)
	elseif action == "Buff" then
		local slot = tonumber(arg) or 0
		pend.Buff = { t = now, slot = slot, prev = cd.Buff[slot] or 0 }
		cd.Buff[slot] = now + (B.cdLen.Buff[slot] or 15)
		local H = nil
		for _, h in ipairs(Hud.helpers or {}) do
			if h.unit and h.unit.slot == slot then
				H = h
			end
		end
		if H then
			Hud.Pop(H.Face)
		end
	elseif action == "Target" then
		pend.Target = { t = now, prev = B.lock }
		B.lock = arg
		Hud.enemyDirty = true
	elseif action == "Attack" then
		-- no swing: the fighter attacks by itself (its lunges come from the server's Hits); a picked enemy shows the
		-- arrow at once (the server's lock echo / snapshot target follow)
		pend.Attack = { t = now, prev = B.lock }
		if arg ~= nil then
			B.lock = arg
			Hud.enemyDirty = true
		end
	elseif action == "Special" then
		pend.Special = { t = now }
		Atk.PreCharge(B, now) -- (Task 11b) its charge shows at once when my view says it can go
	end
	if action ~= "Target" then
		Hud.Pop(Hud.ButtonOf(action, tonumber(arg)))
	end
	Hud.ringAt = 0 -- repaint the rings on the next frame
end

-- the server confirmed `action` (its event arrived)
function Input.Confirm(B, action, slot)
	local p = B.pending[action]
	if p and (action ~= "Buff" or slot == nil or p.slot == slot) then
		B.pending[action] = nil
		return true
	end
	return false
end

-- a refusal or a timeout: the ring goes back to what it showed before the press, the button shakes
function Input.Revert(B, action, shake)
	local p = B.pending[action]
	if not p then
		return
	end
	B.pending[action] = nil
	if action == "Element" or action == "Dash" or action == "Swap" or action == "Cheer" then
		B.cd[action] = p.prev or 0
	elseif action == "Buff" then
		B.cd.Buff[p.slot] = p.prev or 0
	elseif action == "Target" or (action == "Attack" and p.prev ~= B.lock) then
		B.lock = p.prev
		Hud.enemyDirty = true
	end
	if shake then
		Hud.Shake(Hud.ButtonOf(action, p.slot))
	end
	Hud.ringAt = 0
end

-- predictions that no event confirmed in time (10 Hz from Hud.Update)
function Input.CheckPending(B, now)
	for action, p in pairs(B.pending) do
		if now - p.t > K.PENDING_TIMEOUT then
			if action == "Attack" or action == "Special" or action == "Target" then
				B.pending[action] = nil -- nothing to put back (a Target that never echoed keeps the lock)
			else
				Input.Revert(B, action, true)
				St.timeouts = (St.timeouts or 0) + 1
			end
		end
	end
end

-- a small press pop (scale) on a button
function Hud.Pop(obj)
	if not obj or not obj.Parent then
		return
	end
	local s = obj:FindFirstChild("PopScale")
	if not s then
		s = make("UIScale", { Name = "PopScale", Scale = 1 }, obj)
	end
	pcall(function()
		s.Scale = 0.9
		Util.Tween(s, 0.16, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
end


----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------
-- the music: SoundFx's "Battle" layer is on while MY fight runs (a fighter, not a spectator), and between two won
-- Champion Ring rounds (B.ringNext: the floor stays, so does the beat). A dungeon room keeps the Dungeon track
-- (DungeonController's layer) except its boss room. -> the layer's state
function Net.Music()
	local B = St.battle
	local on = false
	if B and B.Fighter and (not B.ended or B.ringNext ~= nil) then
		local d = B.Mode == "Dungeon" and B.Dungeon or nil
		on = B.Mode ~= "Dungeon" or (type(d) == "table" and d.Boss == true and num(d.Room, 0) >= 3)
	end
	if St.musicOn ~= on then
		local SF = Me.Sound()
		if SF and type(SF.SetLayer) == "function" then
			pcall(SF.SetLayer, "Battle", on)
		end
		St.musicOn = on
	end
	return on
end

-- a clear earn moment (a won fight's payout): SoundFx "Reward"
function Net.RewardSound()
	local SF = Me.Sound()
	if SF and type(SF.Play) == "function" then
		pcall(SF.Play, "Reward")
	end
end

-- a raid fight's own screen: a pocket's fighters get the raid sky locally (the floor fight's is server-wide), a late joiner the red edges
function Net.LocalSky(bossId)
	if Mods.Sky == nil then
		Mods.Sky = optional(script.Parent, "SkyController") or false
	end
	local sky = Mods.Sky
	if sky and type(sky.SetLocalEvent) == "function" then
		pcall(sky.SetLocalEvent, bossId)
	end
end

function Net.RaidStart(B)
	if not B.Raid or not B.Fighter then
		return
	end
	if B.Raid.Pocket == true then
		Net.LocalSky(B.Raid.BossId or B.BossId)
	end
	if B.enraged then
		Me.EdgeHold(COLORS.Enemy)
	end
end

function Net.RaidEnd(B)
	if B.Raid then
		Net.LocalSky(nil)
		Me.EdgeHold(nil)
	end
end

function Net.Cleanup(B, immediate)
	if not B then
		return
	end
	Net.RaidEnd(B)
	if B.Mode == "Dungeon" then
		pcall(Me.RecordDrawn, B)
	end
	Tele.ClearAll(B)
	for _, u in ipairs(B.list) do
		Units.Destroy(u)
	end
	B.list = {}
	B.units = {}
	B.mine = {}
	if B.folder then
		pcall(B.folder.Destroy, B.folder)
		B.folder = nil
	end
	if St.battle == B then
		St.battle = nil
		if B.ringNext then
			Ring.HideNext()
		end
		if B.Mode == "Ring" then
			St.ringLast = B -- a run's final "End" may still come for this battle id (it ended between two rounds)
		end
		Input.Bind(false)
		Input.Movement(B, false)
		if not St.result then
			Hud.SetVisible(false)
		end
	end
	Atk.ClearAll() -- (unit ids restart with every battle: no effect or pose may outlive its floor)
	if immediate then
		Fx.ClearAll()
	end
	if not St.starting then
		Net.Music() -- (a chained Start sets the music once the new battle is in: no Battle -> Lobby -> Battle blink)
	end
end

function Net.Start(payload, battleId)
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	local B = St.battle
	if B and B.Id == id and not B.ended then
		-- a refresh (a raid spectator joins): keep the models, update the side and the units
		local side = num(payload.Side, 0)
		B.Side = side
		B.Spectator = payload.Spectator == true or side == 0
		B.Fighter = not B.Spectator
		B.Names = type(payload.Names) == "table" and payload.Names or B.Names
		B.sides = type(payload.Sides) == "table" and payload.Sides or B.sides
		B.Raid = type(payload.Raid) == "table" and payload.Raid or B.Raid
		local keep = {}
		for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
			local u = Units.Add(B, info)
			if u then
				keep[u.id] = true
				local me = myUserId()
				u.mine = B.Fighter and info.owner == me
				if B.Fighter then
					u.ally = u.side == B.Side
				else
					u.ally = u.side == 1
				end
				if u.mine and u.slot >= 1 then
					B.mine[u.slot] = u
				end
				if u.barFill then
					u.barFill.BackgroundColor3 = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
				end
				Cards.Restyle(u)
			end
		end
		for i = #B.list, 1, -1 do
			local u = B.list[i]
			if not keep[u.id] then
				Units.Remove(B, u.id)
			end
		end
		Net.Team(B, payload)
		Input.Bind(B.Fighter)
		Input.Movement(B, B.Fighter)
		Net.RaidStart(B)
		Hud.Rebuild()
		Net.Music()
		return
	end
	-- the next Champion Ring round in the same pocket / the next dungeon room: my pets' models (and their cards)
	-- carry over, so nothing blinks between End and Start
	local chain = B and ((B.ringNext and tostring(payload.Mode) == "Ring") or (B.ended and B.Fighter and B.Mode == "Dungeon" and tostring(payload.Mode) == "Dungeon"))
	local carry = chain and Ring.TakeModels(B) or nil
	if B then
		St.starting = true
		local okClean, errClean = pcall(Net.Cleanup, B, false)
		St.starting = nil
		if not okClean then
			error(errClean, 0)
		end
	end
	B = newBattle(payload, battleId)
	B.sides = type(payload.Sides) == "table" and payload.Sides or {}
	St.battle = B
	Atk.Mod() -- (the pet attack VFX load with the first battle)
	B.renderT = num(payload.T, 0)
	for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
		Units.Add(B, info)
	end
	Net.Team(B, payload)
	if carry then
		Ring.GiveModels(B, carry)
	end
	Ring.HideNext()
	St.ringLast = nil
	-- spread the first positions from the static info until the first snapshot arrives
	if B.Mode == "Raid" then
		local BB = lazyBoss()
		if BB and B.BossId and type(BB.Preload) == "function" then
			pcall(BB.Preload, B.BossId, { Tier = B.Raid and B.Raid.Tier or nil })
		end
	end
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	Input.Bind(B.Fighter)
	Input.Movement(B, B.Fighter)
	Net.RaidStart(B)
	Hud.Rebuild()
	Net.Music()
	BattleController._wake()
end

-- Phase 5: my team from "Start".Team = { Fighter, Bench, Lives, Speed = { Walk, Run }, Cooldowns } (a late joiner
-- gets the running cooldowns: seconds left; Buff keyed by slot STRINGS on the wire)
function Net.Team(B, payload)
	Input.CooldownLengths(B)
	local team = type(payload.Team) == "table" and payload.Team or nil
	if not B.Fighter then
		return
	end
	local now = os.clock()
	if team then
		B.fighterId = tonumber(team.Fighter) or B.fighterId
		B.lives = tonumber(team.Lives) or B.lives
		if type(team.Speed) == "table" and tonumber(team.Speed.Walk) then
			B.speed = { Walk = tonumber(team.Speed.Walk), Run = tonumber(team.Speed.Run) }
		end
		B.retreated = team.Retreated == true
		local cds = type(team.Cooldowns) == "table" and team.Cooldowns or {}
		for _, kind in ipairs({ "Element", "Dash", "Swap", "Cheer", "Retreat" }) do
			local left = num(cds[kind], 0)
			B.cd[kind] = left > 0 and (now + left) or 0
		end
		if type(cds.Buff) == "table" then
			for key, left in pairs(cds.Buff) do
				local slot = tonumber(key)
				if slot then
					B.cd.Buff[slot] = num(left, 0) > 0 and (now + num(left, 0)) or 0
				end
			end
		end
	end
	if not B.fighterId then
		-- (an older Start without Team: my slot-1 pet)
		local u = B.mine[1]
		B.fighterId = u and u.id or nil
	end
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u then
			u.benched = u.id ~= B.fighterId
		end
	end
	local f = B.fighterId and B.units[B.fighterId]
	B.fighterEvo = f and f.evo or 0
	if not B.speed and f then
		local walk, run = tonumber(f.info.walk), tonumber(f.info.run)
		if walk then
			B.speed = { Walk = walk, Run = run }
		end
	end
end

-- Phase 5: what an event changes for MY HUD, on arrival (the visuals play later on the render clock): predictions
-- confirmed / refused, cooldowns started, the lock, the fighter after a swap, the battle speed
function Net.Pre(B, ev)
	if not B.Fighter or B.ended then
		return
	end
	local me = myUserId()
	local t = ev.type
	local now = os.clock()
	if t == EV.Order then
		if ev.owner ~= me then
			return
		end
		local action = tostring(ev.order or "")
		if ev.rejected ~= nil then
			St.rejected = (St.rejected or 0) + 1
			if action == "Special" then
				Atk.Shatter(B) -- (Task 11b) the predicted charge breaks
			end
			local p = B.pending[action]
			if p then
				Input.Revert(B, action, true)
			elseif action ~= "Attack" and action ~= "Target" then
				Hud.Shake(Hud.ButtonOf(action, tonumber(ev.target)))
			end
		elseif action == "Target" or (action == "Attack" and tonumber(ev.target)) then
			-- the lock echo ("Attack"(id) / "Attack"() lock the enemy the pet now attacks)
			B.lock = tonumber(ev.target)
			B.pending[action] = nil
			Hud.enemyDirty = true
		elseif action == "Retreat" then
			-- (evolved forms) the echo flips the button; the server dropped the lock
			B.retreated = true
			B.lock = nil
			B.pending.Target = nil
			Hud.enemyDirty = true
			Hud.ringAt = 0
		elseif action == "Engage" then
			B.retreated = false
			B.cd.Retreat = now + (B.cdLen.Retreat or 10)
			Hud.ringAt = 0
		end
	elseif t == EV.Element or t == EV.Dash then
		if t == EV.Dash and B.fighterId and tonumber(ev.unit) == B.fighterId then
			local f = B.units[B.fighterId]
			if f then
				Me.StartDash(B, f, ev) -- my pet's dash shows on arrival (the render clock would add its delay)
			end
		end
		if B.fighterId and tonumber(ev.unit) == B.fighterId then
			local kind = (t == EV.Element) and "Element" or "Dash"
			if not Input.Confirm(B, kind) then
				B.cd[kind] = now + (B.cdLen[kind] or 1)
			end
			Hud.ringAt = 0
		end
	elseif t == (EV.Cheer or "Cheer") then
		if tonumber(ev.owner) == me then
			if not Input.Confirm(B, "Cheer") then
				B.cd.Cheer = now + (B.cdLen.Cheer or 20)
			end
			local F = BattleCatalog and BattleCatalog.Fighter or {}
			B.cheerUntil = now + num(F.CheerSeconds, 5)
			Hud.ringAt = 0
		end
	elseif t == EV.Buff then
		if ev.owner == me then
			local h = B.units[tonumber(ev.unit) or -1]
			local slot = h and h.slot
			if slot and not Input.Confirm(B, "Buff", slot) then
				B.cd.Buff[slot] = now + (B.cdLen.Buff[slot] or 15)
			end
			Hud.ringAt = 0
		end
	elseif t == EV.Swap then
		if ev.owner == me then
			local predicted = Input.Confirm(B, "Swap")
			if not predicted and not ev.auto then
				B.cd.Swap = now + (B.cdLen.Swap or 10)
			end
			-- (fix round 2, I2-b) a held auto-swap (its KO waits for a late impact) trades the pets when it plays
			if not ev.fxSwitchLate then
				Me.Switch(B, ev)
			end
		end
	elseif t == EV.Hit then
		if B.fighterId and tonumber(ev.from) == B.fighterId and not ev.special and not ev.element and not ev.zone then
			Input.Confirm(B, "Attack")
		end
	elseif t == EV.Special then
		if B.fighterId and tonumber(ev.unit) == B.fighterId then
			Input.Confirm(B, "Special")
		end
	elseif t == EV.Speed then
		if ev.owner == me and tonumber(ev.walk) then
			B.speed = { Walk = tonumber(ev.walk), Run = tonumber(ev.run) }
			local mc = Hud.Movement()
			if mc and St.movementOn then
				pcall(mc.SetBattleSpeed, B.speed.Walk, B.speed.Run)
			end
		end
	end
end

function Net.Snapshot(payload, battleId)
	local B = St.battle
	if not B or type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if id ~= nil and id ~= B.Id then
		return
	end
	local T = num(payload.T, nil)
	if not T then
		return
	end
	local snaps = B.snaps
	local stale = #snaps > 0 and T <= snaps[#snaps].T
	if stale and payload.Units ~= nil then
		return -- out of order / duplicate (the old full form)
	end
	local units = payload.Units
	if type(units) ~= "table" then
		-- the wire form: only what changed since the last snapshot; the rest of the picture is carried forward
		if type(payload.U) ~= "table" or not BattleSim or type(BattleSim.DecodeSnapshot) ~= "function" then
			return
		end
		-- every delta is decoded, even one with no newer T (the server's baseline already counts it as sent)
		units = BattleSim.DecodeSnapshot(payload, B.lastUnits)
		B.lastUnits = units
		if stale then
			if T == snaps[#snaps].T then
				snaps[#snaps].Units = units
			end
			return
		end
	end
	snaps[#snaps + 1] = { T = T, Units = units }
	while #snaps > K.MAX_SNAPS do
		table.remove(snaps, 1)
	end
	local now = os.clock()
	local offset = T - now
	if not B.haveOffset then
		B.haveOffset = true
		B.offset = offset
	else
		-- follow slowly, but never let the render clock run ahead of what arrived
		B.offset = B.offset + (offset - B.offset) * K.OFFSET_RATE
		if offset < B.offset then
			B.offset = offset
		end
	end
end

-- the unit an event lands on (the ranged-shot hold): a Hit's victim, a KO'd unit
local function heldUnitOf(ev)
	if ev.type == EV.Hit then
		return tonumber(ev.to)
	elseif ev.type == EV.KO then
		return tonumber(ev.unit)
	elseif ev.type == (EV.Swap or "Swap") and ev.auto then
		return tonumber(ev.out) -- (fix round 1, I2) the auto-swap of a fighter KO'd by a shot still flying waits with its KO
	end
	return nil
end

-- seconds `ev` (due at t) waits for a ranged shot still flying at its unit (B.fxHold: when the shot lands), <=
-- FX_LATE_MAX; the End waits for every shot (the killing blow lands first)
function Net.Hold(B, ev, t)
	local holds = B.fxHold
	if not holds then
		return 0
	end
	local h = nil
	if ev.type == EV.End then
		for _, v in pairs(holds) do
			if not h or v > h then
				h = v
			end
		end
	else
		local id = heldUnitOf(ev)
		h = id and holds[id]
	end
	if not h or h <= t then
		return 0
	end
	return min(h - t, K.FX_LATE_MAX)
end

-- (Task 11b) the drawn HP / state of unit `id` wait until `untilClock` (os.clock): Units.Update never draws its HP
-- under `floor` (the HP drawn now; a caster's last gasp: 1) nor the unit down before then. A KO / the held hit itself
-- ends it when it plays (Units.Unhold)
function Units.Hold(B, id, untilClock, floor)
	local u = id and B.units[id]
	-- (fix round 2, M2') a unit already held may be drawn at 0 (a plain hit took its floor there): its hold still extends
	if not u or (not u.holdUntil and (u.state == S_DOWN or num(u.hp, 0) <= 0)) then
		return
	end
	if not u.holdUntil or u.holdUntil < untilClock then
		u.holdUntil = untilClock
	end
	local f = floor or u.hp
	u.holdHp = u.holdHp and max(u.holdHp, f) or f
	u.holdState = u.state
	if floor then
		u.holdFloor = max(u.holdFloor or 0, floor) -- (fix round 1) the hits that play during the hold never draw it lower
	end
end

function Units.Unhold(u)
	u.holdUntil, u.holdHp, u.holdState, u.holdFloor = nil, nil, nil, nil
end

-- (Task 11b) seconds `ev` (due at t on the render clock, `lead` s from now) waits for a late Special's impact
-- (B.spHold[caster] = { at, kind, victims }: Net.SpecialArrived): that special's own hits (Hit.special from the caster)
-- and its Storm's zone ticks (Hit.zone + kind) due before the impact, the KO of a unit they hit and the caster's own
-- KO in its late charge (+ LAST_GASP: the effect lands first). Their units' drawn HP waits too (Units.Hold). Other hits
-- on the same units (a plain attack, another unit's) play on time. The End does not wait: its grace (FX_END_GRACE
-- 1 s > LATE_MAX) lets the effect land and the held events drain on the render clock (Net.End, B.drainHeld)
function Net.SpecialHold(B, ev, t, lead)
	local holds = B.spHold
	if not holds then
		return 0
	end
	local now = os.clock()
	local w = 0
	if ev.type == EV.Hit then
		local h = holds[tonumber(ev.from) or -1]
		local v = tonumber(ev.to)
		if h and v and h.at > t and (ev.special ~= nil or (ev.zone and tostring(ev.kind or "") == h.kind)) then
			w = h.at - t
			h.victims[v] = true
			Units.Hold(B, v, now + lead + w)
		end
	elseif ev.type == EV.KO then
		local id = tonumber(ev.unit) or -1
		local own = holds[id]
		local gasp = own ~= nil and own.at > t
		if gasp then
			w = own.at - t + K.LAST_GASP
		end
		for _, h in pairs(holds) do
			if h.victims[id] and h.at > t then
				w = max(w, h.at - t)
			end
		end
		if w > 0 then
			-- (fix round 1, M1) one hold: a last gasp floors the drawn HP at 1 (the killing hit's drop shows)
			Units.Hold(B, id, now + lead + w, gasp and 1 or nil)
		end
	elseif ev.type == (EV.Swap or "Swap") and ev.auto then
		-- (fix round 1, I2) the server's auto-swap of a fighter whose KO waits for a late impact: the "GO!" and the
		-- entrance wait with it (the KO before it in this batch set the out unit's hold)
		local o = B.units[tonumber(ev.out) or -1]
		if o and o.holdUntil then
			w = max(0, o.holdUntil - now - lead)
		end
	end
	if w > 0 then
		ev.fxSpHeld = true
	end
	return min(w, K.LATE_MAX + K.LAST_GASP)
end

-- (Task 11b) a Special that lands late (ev.fxSpLate, Atk.Special): its hold, until the impact on the render clock
function Net.SpecialArrived(B, ev, t)
	local late = ev.type == EV.Special and tonumber(ev.fxSpLate) or nil
	if not late or late <= 0 then
		return
	end
	local holds = B.spHold or {}
	B.spHold = holds
	for id, h in pairs(holds) do
		if h.at < t - 2 then
			holds[id] = nil -- (long past)
		end
	end
	local id = tonumber(ev.unit)
	if id then
		holds[id] = { at = t + late, kind = tostring(ev.kind or ""), victims = {} }
	end
end

-- queue `ev` to play at `due` (in time order: a held event lets the others pass); a Hit whose shot lands late
-- (ev.fxLate, Atk.Hit) holds its victim's next events until then
function Net.Queue(B, ev, due, held)
	local q = B.evq
	local i = #q
	while i > 0 and q[i].t > due do
		i = i - 1
	end
	table.insert(q, i + 1, { t = due, ev = ev, held = held == true })
	if (tonumber(ev.fxLate) or 0) > 0 then
		local id = heldUnitOf(ev)
		if id then
			B.fxHold = B.fxHold or {}
			if (B.fxHold[id] or -math.huge) < due then
				B.fxHold[id] = due
			end
		end
	end
end

function Net.Events(list, battleId)
	local B = St.battle
	if not B or type(list) ~= "table" then
		return
	end
	if battleId ~= nil and battleId ~= B.Id then
		return
	end
	-- played on the delayed render clock: stamp them with the estimated server time of their arrival
	local t = B.haveOffset and (os.clock() + B.offset) or B.renderT
	-- the pet attack VFX start NOW, their impact due when the event plays (t - renderT from now: the render delay)
	local lead = B.haveOffset and clamp(t - B.renderT, 0, K.FX_LEAD_MAX) or 0
	for _, ev in ipairs(list) do
		if type(ev) == "table" and type(ev.type) == "string" then
			-- a victim whose ranged shot is still flying (Net.Hold): its Hit / KO wait for the shot to land
			-- (Task 11b) ... or a late Special's impact: its own hits, the KOs they cause, a last gasp, the End
			local hold = max(Net.Hold(B, ev, t), Net.SpecialHold(B, ev, t, lead))
			if hold > 0 and ev.type == (EV.Swap or "Swap") and ev.auto then
				-- (fix round 2, I2-b) the held auto-swap trades the pets when it plays, not now: my fighter switch waits
				-- (Net.Pre / the Swap handler), the incoming pet stays benched (another player's: parked) till then
				ev.fxSwitchLate = true
				local inc = B.units[tonumber(ev["in"]) or -1]
				if inc then
					inc.unbenchAt = os.clock() + lead + hold + K.UNBENCH_SLACK
					if inc.mine then
						Units.Rebuild(B, inc) -- (my new fighter's High model is built while it waits: its GO! lands on it)
					end
				end
			end
			local okPre, errPre = pcall(Net.Pre, B, ev)
			if not okPre then
				warnOnce("pre_" .. ev.type, "event " .. ev.type .. " (HUD) failed: " .. tostring(errPre))
			end
			Atk.Arrive(B, ev, lead + hold)
			Net.SpecialArrived(B, ev, t)
			-- telegraphs start at once (their fill must complete at the hit), the rest on the render clock
			if ev.type == EV.Telegraph then
				local fn = Handlers[ev.type]
				pcall(fn, B, ev)
			else
				local late = tonumber(ev.fxLate) or 0
				Net.Queue(B, ev, t + hold + late, hold > 0 or late > 0)
			end
		end
	end
end

-- the winners cheer: AttackFx's Victory (hop-spin + sparkles), else the old hop; a little apart (0-0.4 s). During the
-- End grace (Ruling 11: no new effect) the cheers wait for it in St.cheers (Atk.Update plays them)
function Net.Cheer(B)
	local now = os.clock()
	for _, u in ipairs(B.list) do
		if u.ally and u.root and not u.parked and not Atk.Lying(u) then
			local delay = math.random() * 0.4
			if not Atk.Mod() then
				u.hopAt = now + delay
			elseif St.fxEndAt then
				St.cheers = St.cheers or {}
				St.cheers[#St.cheers + 1] = { B = B, u = u, at = St.fxEndAt + delay }
			elseif not Atk.Victory(B, u, delay) then
				u.hopAt = now + delay
			end
		end
	end
end

function Net.End(payload, battleId)
	local B = St.battle
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if not B and St.ringLast and St.ringLast.Id == id and Ring.IsFinal(payload) then
		Hud.ShowEnd(St.ringLast, payload) -- the run's card after the last round's floor was already freed
		St.ringLast = nil
		return
	end
	if not B or (id ~= nil and id ~= B.Id) then
		return
	end
	if B.ended then
		if B.ringNext and Ring.IsFinal(payload) then
			Ring.FinalAfterWin(B, payload) -- the run ended between two rounds (Forfeit, a leave, a shutdown...)
		end
		return
	end
	-- play what is still queued, so the last KO shows. Events held for a ranged shot still in flight (Net.Queue
	-- `held`: its Hit, the victim's KO, the sim's End) keep their time: stepBattle drains them on the render clock
	-- during the End grace, so the killing shot's number and "KO!" pop when it LANDS (Task 8 fix round 3, review
	-- Important 3); the rest play now, like before
	local latest = B.snaps[#B.snaps]
	if Net.PlayUnheld(B) then
		B.drainHeld = true
	else
		B.renderT = max(B.renderT, (latest and latest.T or B.renderT)) + 5
		Net.PlayDue(B, os.clock())
	end
	B.ended = true
	B.endAt = os.clock()
	AreaWarn.Hide()
	Net.RaidEnd(B)
	Atk.EndSoon(B) -- (when the sim's End event has not played: the grace starts now, the cheers wait for it)
	Input.Bind(false)
	Input.Movement(B, false)
	B.pending = {}
	local participant = payload.Spectator ~= true and B.Fighter
	local ringNext = participant and Ring.IsNext(B, payload)
	if not ringNext then
		Net.Music() -- (first: an error in the cards / result below cannot leave the Battle music on; a won ring round sets it at the tail)
	end
	Cards.AfterFight(B, payload)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or nil
	if participant and B.Mode == "Dungeon" and (payload.Outcome == "Win" or payload.Won == true or (rw and rw.Dungeon == true and payload.Reason == "Cleared")) then
		-- a cleared dungeon room: no result card (DungeonController shows the loot); the floor goes after DUNGEON_LINGER
		-- (bug #26: then the followers take over, PetController.HANDOVER)
		B.linger = K.DUNGEON_LINGER
		Hud.SetVisible(false)
		Net.Cheer(B)
	elseif ringNext then
		-- a won Champion Ring round: the side card "Round 8 won! ... Round 9 in 3", the floor stays until the next Start
		B.linger = Ring.LINGER
		Ring.ShowNext(B, payload)
		Net.Cheer(B)
		Net.RewardSound() -- (audio wave 2 fix) a won round is a payout too
	elseif participant then
		B.linger = K.END_LINGER
		Hud.ShowEnd(B, payload)
		-- winners cheer (and hear their payout)
		if payload.Outcome == "Win" or payload.Won then
			Net.Cheer(B)
			Net.RewardSound()
		end
	else
		B.linger = (payload.Reason == "OutOfRange") and 0 or K.SPECTATOR_LINGER
		Hud.SetVisible(false)
	end
	Net.Music() -- (the fight is over: back to the Dungeon / Lobby track; a won ring round keeps the beat)
	if B.linger <= 0 then
		Net.Cleanup(B, false)
	end
end

function BattleController.HandleState(kind, payload, battleId)
	if kind == "Start" then
		Net.Start(payload, battleId)
	elseif kind == "Snapshot" then
		Net.Snapshot(payload, battleId)
	elseif kind == "Events" then
		Net.Events(payload, battleId)
	elseif kind == "End" then
		Net.End(payload, battleId)
	elseif kind == "Area" then
		AreaWarn.Set(payload, battleId)
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function sampleSnaps(B)
	local snaps = B.snaps
	local n = #snaps
	if n == 0 then
		return nil, nil, 0
	end
	local t = B.renderT
	if t <= snaps[1].T then
		return snaps[1], nil, 0
	end
	for i = n - 1, 1, -1 do
		local a = snaps[i]
		if a.T <= t then
			local b = snaps[i + 1]
			local span = b.T - a.T
			local alpha = span > 0 and clamp((t - a.T) / span, 0, 1) or 1
			return a, b, alpha
		end
	end
	return snaps[n], nil, 0
end

-- per-section cost (only while a test injects BattleController.PerfClock)
local function section(name, t0)
	local clock = BattleController.PerfClock
	if not clock then
		return nil
	end
	local t = clock()
	if t0 then
		local split = St.perf.split
		split[name] = (split[name] or 0) + (t - t0) * 1000
	end
	return t
end

local function stepBattle(B, now, dt)
	local s0 = section()
	if not B.ended then
		if B.haveOffset then
			local latest = B.snaps[#B.snaps]
			local t = now + B.offset - interpDelay(B)
			if latest and t > latest.T + 0.15 then
				t = latest.T + 0.15
			end
			if t > B.renderT then
				B.renderT = t
			end
		end
		Net.PlayDue(B, now)
	elseif B.drainHeld then
		-- the End came with events held for a flying shot (Net.End): they play on the render clock as it lands; at
		-- the latest after the End grace everything left plays and the clock jumps to the end like before
		B.renderT = B.renderT + dt
		if #B.evq == 0 or now - (B.endAt or now) >= K.FX_END_GRACE then
			local latest = B.snaps[#B.snaps]
			B.renderT = max(B.renderT, (latest and latest.T or B.renderT)) + 5
			B.drainHeld = nil
		end
		Net.PlayDue(B, now)
	end
	local sa, sb, alpha = sampleSnaps(B)
	s0 = section("Events", s0)
	Units.BuildPending(B)
	s0 = section("Builds", s0)
	local crowded = #B.list > K.CROWD
	local frameNo = St.frameNo
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for i, u in ipairs(B.list) do
		local animate = true
		if not u.mine and not u.isBoss then
			local stride = crowded and 2 or 1
			if camPos and u.root and not u.parked then
				local p = u.root.Position
				local dx, dy, dz = p.X - camPos.X, p.Y - camPos.Y, p.Z - camPos.Z
				local d2 = dx * dx + dy * dy + dz * dz
				if d2 > K.ANIM_FAR * K.ANIM_FAR then
					stride = 4
				elseif d2 > K.ANIM_MID * K.ANIM_MID then
					stride = 3
				end
			end
			-- a pet that only breathes (the battle idle) is posed every other frame: the idle is slow
			if stride < 2 and u.poseSrc == "idle" then
				stride = 2
			end
			-- a strided frame skips only the pose (PetBuilder.Animate); the root moves every frame and carries the
			-- animated parts rigidly (Units.CarryLoose), so the pet never stutters and never comes apart
			animate = (not u.posed) or ((frameNo + i) % stride) == 0
		end
		local ok, err = pcall(updateUnit, B, u, now, dt, sa, sb, alpha, animate)
		if not ok then
			warnOnce("unit", "unit update failed: " .. tostring(err))
		end
	end
	s0 = section("Units", s0)
	Tele.Update(B, now)
	Units.UpdateFocus(B, now)
	B.cue = B.threat and "Dash" or nil
	Input.Tick(B, now)
	s0 = section("Telegraphs", s0)
	if Hud.gui then
		local ok, err = pcall(Hud.Update, B, now)
		if not ok then
			warnOnce("hud", "HUD update failed: " .. tostring(err))
		end
	end
	section("Hud", s0)
end

-- the enemy my pet attacks: the lock (ATTACK / click / Tab), else the target my fighter auto-attacks (its snapshot
-- target, dungeon fixes decision 4); nil when none is drawn
function Units.FocusUnit(B)
	local u = B.lock and B.units[B.lock]
	local auto = false
	if not u and B.Fighter then
		local f = B.fighterId and B.units[B.fighterId]
		local t = f and f.target and B.units[f.target]
		if t and not t.ally then
			u, auto = t, true
		end
	end
	if not u or not u.model or u.parked or u.hidden or u.hp <= 0 or u.state == S_DOWN then
		return nil, false
	end
	return u, auto
end

-- (Pitch 2 item 1b, option C "Three buttons": TARGET is automatic on the three keys' layout) the enemy I locked (a tap on it in
-- the world or on its row) wears the LOCKED marker of the mock (repitch_01b.py lock_demo): four gold corner brackets round it
-- and the gold LOCKED tag under them, a billboard over the world on an anchor that follows the enemy's centre. The pet's own
-- pick keeps the see-through arrow only. Built once a battle, moved only while shown (one CFrame write a frame)
function Units.UpdateLock(B, u, auto)
	local show = u ~= nil and not auto and not B.ended and Hud.ThreeKeys()
	local gui = B.lockMark
	if not show then
		if gui and gui.Enabled then
			gui.Enabled = false
		end
		return
	end
	if not gui or not gui.Parent then
		local anchor = make("Part", { Name = "LockAnchor", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false,
			CastShadow = false, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2) }, B.folder)
		gui = make("BillboardGui", { Name = "LockMark", Adornee = anchor, AlwaysOnTop = true, LightInfluence = 0, MaxDistance = K.BAR_DISTANCE,
			ResetOnSpawn = false, Enabled = false }, anchor)
		local box = make("Frame", { Name = "Box", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -K.LOCK_TAG_H - 4) }, gui)
		for i, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
			-- one corner: an arm along the edge and one down it, gold in a wood line
			for j, size in ipairs({ { K.LOCK_ARM, K.LOCK_BAR }, { K.LOCK_BAR, K.LOCK_ARM } }) do
				local bar = make("Frame", { Name = "Corner" .. i .. "_" .. j, BackgroundColor3 = SIGN.Gold, BorderSizePixel = 0,
					AnchorPoint = Vector2.new(c[1], c[2]), Position = UDim2.fromScale(c[1], c[2]), Size = UDim2.fromOffset(size[1], size[2]) }, box)
				signEdge(bar, KB.Edge, 1)
			end
		end
		local tag = label(gui, "LOCKED", "Label", 15, { Name = "Locked", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1),
			Size = UDim2.fromOffset(math.ceil(textWidth("LOCKED", 15)) + 16, K.LOCK_TAG_H), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = KB.Ink })
		signBlock(tag, SIGN.Gold, SIGN.GoldLip, KB.Ink, 3, 2)
		B.lockMark, B.lockAnchor = gui, anchor
	end
	if B.lockId ~= u.id then
		B.lockId = u.id
		-- the brackets frame the enemy: a boss by its body, a pet by its height (studs), the tag in px under them
		local side = u.isBoss and (u.height or 20) * 0.9 or max(2.5, (u.height or 3) * 1.3)
		gui.Size = UDim2.new(side, 0, side, K.LOCK_TAG_H + 4)
	end
	B.lockAnchor.CFrame = CFrame.new(unitCenter(B, u))
	if not gui.Enabled then
		gui.Enabled = true
	end
end

-- a bobbing voxel arrow over the enemy my pet attacks (solid = picked, see-through = the one it chose by itself)
function Units.UpdateFocus(B, now)
	local u, auto = Units.FocusUnit(B)
	local mark = B.focusMark
	if not u or B.ended then
		if mark then
			mark.Parent = nil
		end
		Units.UpdateLock(B, nil, true)
		return
	end
	Units.UpdateLock(B, u, auto)
	if not mark then
		mark = make("Model", { Name = "FocusArrow" })
		local spec = { { 0, 0, 0.9 }, { 0, 0.7, 0.6 }, { 0, 1.3, 0.35 } }
		-- Phase 6: the Blender arrow (fx_arrow, 1 stud wide, pointing down) when ready: 1.4 studs wide like the Part
		-- arrow's top; each MeshPart's Y attribute keeps its manifest height under the same per-frame code
		local mesh = Units.FxMesh("fx_arrow", 1.4)
		if mesh then
			spec = {}
			for _, mp in ipairs(mesh) do
				mp:SetAttribute("Y", -mp.Position.Y / 0.8)
				mp.Parent = mark
			end
		end
		for i, s in ipairs(spec) do
			make("Part", {
				Name = "Arrow" .. i,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = COLORS.Gold,
				Size = Vector3.new(s[3] * 1.4, 0.5, s[3] * 1.4),
			}, mark):SetAttribute("Y", s[2])
		end
		B.focusMark = mark
	end
	if mark.Parent ~= B.folder then
		mark.Parent = B.folder
	end
	if (B.focusAuto == true) ~= auto then
		B.focusAuto = auto
		for _, p in ipairs(mark:GetChildren()) do
			if p:IsA("BasePart") then
				p.Transparency = auto and 0.4 or 0
			end
		end
	end
	B.focusId = u.id
	local top = u.isBoss and (u.height or 20) + 2 or (u.centerY or 1.5) + (u.height or 3) / 2 + 2.4
	local base = worldPoint(B, u.x, top + sin(now * 4) * 0.35, u.z)
	local spin = now * 2
	for _, p in ipairs(mark:GetChildren()) do
		p.CFrame = CFrame.new(base.X, base.Y - (p:GetAttribute("Y") or 0) * 0.8, base.Z) * CFrame.Angles(0, spin, 0)
	end
end

local function onFrame(dt)
	St.frameNo = St.frameNo + 1 -- (first: a frame that fails before Atk.Update shows in StepsAttackFx, fix round 2 M8)
	local perfClock = BattleController.PerfClock or os.clock
	local p0 = perfClock()
	local t0 = os.clock()
	local now = t0
	local B = St.battle
	if B then
		stepBattle(B, now, dt)
		if B.ended and now - (B.endAt or now) >= (B.linger or 0) then
			Net.Cleanup(B, false)
		end
	end
	local f0 = section()
	Fx.Update(now)
	Fx.UpdateNumbers(now)
	Fx.UpdateFlashes(now)
	Atk.Update(now) -- the pet attack VFX and poses (AttackFx has no frame loop of its own)
	local screenFx = Me.UpdateScreenFx(now)
	Hud.UpdateResult(now)
	Ring.UpdateNext(now)
	Me.UpdateShake(now)
	section("Effects", f0)
	local ms = (perfClock() - p0) * 1000
	local perf = St.perf
	perf.frames = perf.frames + 1
	perf.total = perf.total + ms
	perf.last = ms
	if ms > perf.peak then
		perf.peak = ms
	end
	-- the loop sleeps when nothing is drawn
	if not St.battle and #St.effects == 0 and #St.numbers == 0 and #St.totals == 0 and #St.flashes == 0 and not St.result and not St.next and not St.shake
		and not screenFx and not Atk.Pending() then
		if St.loop then
			St.loop:Disconnect()
			St.loop = nil
		end
	end
end

function BattleController._wake()
	if St.loop or not St.initialized then
		return
	end
	St.loop = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(onFrame, dt)
		if not ok then
			warnOnce("frame", "frame failed: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function BattleController.GetBattle()
	local B = St.battle
	if not B then
		return nil
	end
	local models = 0
	for _, u in ipairs(B.list) do
		if u.model then
			models = models + 1
		end
	end
	return {
		Id = B.Id,
		Mode = B.Mode,
		Side = B.Side,
		Spectator = B.Spectator,
		Fighter = B.Fighter,
		Ended = B.ended,
		Units = #B.list,
		Models = models,
		Focus = B.lock,
		Lock = B.lock,
		FighterId = B.fighterId,
		Lives = B.lives,
		Speed = B.speed and { Walk = B.speed.Walk, Run = B.speed.Run } or nil,
		Dungeon = B.Dungeon,
		Wave = B.wave,
		MenuHidden = Hud.menuHidden == true,
		Cooldowns = (function()
			local now = os.clock()
			local out = { Buff = {} }
			for _, kind in ipairs({ "Element", "Dash", "Swap", "Cheer", "Retreat" }) do
				out[kind] = max(0, (B.cd[kind] or 0) - now)
			end
			for slot, t in pairs(B.cd.Buff) do
				out.Buff[slot] = max(0, t - now)
			end
			return out
		end)(),
		Cheering = os.clock() < (B.cheerUntil or 0),
		Retreated = B.retreated == true,
		Pending = (function()
			local out = {}
			for k in pairs(B.pending) do
				out[k] = true
			end
			return out
		end)(),
		Hud = BattleController.IsHudVisible(),
		Layout = (Hud.m and Hud.m.Compact) and "Compact" or "Wide",
		RenderT = B.renderT,
		Telegraphs = (function()
			local n = 0
			for _ in pairs(B.teles) do
				n = n + 1
			end
			return n
		end)(),
		Threat = B.threat == true,
		Cue = B.cue,
		-- Phase 4: the ring round / record, the won round waiting for the next Start, duel overtime
		Round = B.Round > 0 and B.Round or nil,
		Best = B.Ring and num(B.Ring.Best, 0) or nil,
		Next = B.ringNext and B.ringNext.Next or nil,
		InterpDelay = interpDelay(B),
		TeamPlace = Hud.teamPlace,
	}
end

-- RaidGateController: a fight on the real floor is still drawn here, its end's linger included (its boss stands on the floor until then)
function BattleController.DrawsRaidFloor()
	local B = St.battle
	return B ~= nil and B.Mode == "Raid" and type(B.Raid) == "table" and B.Raid.Pocket == false
end

-- the drawn telegraphs (tests): { { Id, Shape, At, From, SafeAt, Late, Lethal, RimWidth, RimColor } ... } on the render clock
function BattleController.GetTelegraphs()
	local B = St.battle
	local out = {}
	for id, tl in pairs(B and B.teles or {}) do
		out[#out + 1] = { Id = id, Shape = tl.shape, At = tl.at, From = tl.from, SafeAt = tl.safeAt, Late = tl.late == true, Lethal = tl.lethal == true, RimWidth = tl.rimWidth, RimColor = tl.rimColor }
	end
	return out
end

function BattleController.GetUnit(id)
	local B = St.battle
	local u = B and B.units[id]
	if not u then
		return nil
	end
	return {
		Id = u.id, Side = u.side, Kind = u.kind, Name = u.name, Hp = u.hp, MaxHp = u.maxHp, State = u.state, Meter = u.meter,
		Model = u.model, X = u.x, Z = u.z, Parked = u.parked == true, Mine = u.mine, Ally = u.ally,
		World = u.model and unitCenter(B, u) or nil,
		-- Phase 4: the unit's PetCard ({ Gui, Mode }), level, evolution stage, XP, the ring champion's crown
		Card = u.card and { Gui = u.card.Gui, Mode = u.card.mode } or nil,
		Level = u.level, Evo = u.evo, Xp = u.xp, XpNext = u.xpNext, Crowned = u.crowned,
		Writes = u.cardWrites or 0,
		-- Phase 5: the bench, the wind-up, the drawn root position (my fighter / helpers), the team's lives, detail
		Benched = u.benched == true, Windup = u.windup == true, Lives = u.lives, Detail = u.detail,
		Drawn = u.root and u.root.Position or nil, FlyAt = u.flyAt, SwapAt = u.swapAt,
		-- dungeon fixes: arriving (the model hidden until the flash), the drawn pet dash, the wild look
		Arriving = u.arrive ~= nil, Hidden = u.hidden == true, ArriveFx = u.arriveFx ~= nil, DashAt = u.dashAt,
		Wild = u.info.wild == true,
		-- pet attack VFX: the battle pose drawn last frame (PetPoses name; nil = none)
		Pose = u.poseShown, PoseP = u.poseShownP,
	}
end

-- wave 5 (bug #26): where the player's dungeon fighter is (still drawn) or was last drawn (<= LAST_DRAWN_AGE s ago)
-- -> Vector3, key | nil (PetController's hand-over: the follower walks back from there)
function BattleController.LastDrawn(userId)
	userId = tonumber(userId)
	if not userId then
		return nil
	end
	local B = St.battle
	if B and B.Mode == "Dungeon" then
		local u = Me.FighterOf(B, userId)
		local pos = u and Me.SpotOf(u)
		if typeof(pos) == "Vector3" then
			return pos, u.info and u.info.key
		end
	end
	local e = St.lastDrawn[userId]
	if e and os.clock() - e.At <= K.LAST_DRAWN_AGE then
		return e.Pos, e.Key
	end
	St.lastDrawn[userId] = nil
	return nil
end

-- wave 5 polish: is the player's dungeon fighter still drawn on the floor (a lost room's KO'd models linger END_LINGER)?
-- PetController keeps the followers parked while it is (never two copies of the team on screen)
function BattleController.FighterDrawn(userId)
	userId = tonumber(userId)
	local B = St.battle
	if not userId or not B or B.Mode ~= "Dungeon" then
		return false
	end
	local u = Me.FighterOf(B, userId)
	return u ~= nil and u.model ~= nil and u.model.Parent ~= nil
end

function BattleController.LastDrawnKey(userId)
	local _, key = BattleController.LastDrawn(userId)
	return key
end

function BattleController.GetStats()
	local perf = St.perf
	local B = St.battle
	local models = 0
	if B then
		for _, u in ipairs(B.list) do
			if u.model then
				models = models + 1
			end
		end
	end
	local teles = 0
	if B then
		for _ in pairs(B.teles) do
			teles = teles + 1
		end
	end
	return {
		Frames = perf.frames,
		AvgMs = perf.frames > 0 and perf.total / perf.frames or 0,
		PeakMs = perf.peak,
		LastMs = perf.last,
		Units = B and #B.list or 0,
		Models = models,
		FxParts = St.fxLive,
		Effects = #St.effects,
		Numbers = #St.numbers,
		Flashes = #St.flashes,
		Telegraphs = teles,
		Builds = perf.builds,
		Bound = St.bound,
		HpWrites = Hud.hpWrites or 0,
		RingWrites = St.ringWrites or 0,
		Shakes = Hud.shakes or 0,
		CameraShakes = St.shakeCount or 0,
		Sent = St.sent or 0,
		Rejected = St.rejected or 0,
		Timeouts = St.timeouts or 0,
		Dashes = St.dashes or 0, -- pet dashes drawn (Dash events)
		Parries = St.parries or 0, -- wave 6: Parry events shown (PARRY!)
		Arrivals = St.arrivals or 0, -- arrival effects started (EvolutionFx.Arrive)
		AttackFx = Atk.Stats(), -- AttackFx.Stats() (nil before the first battle loads it)
		Focus = (function()
			local b = St.battle
			local u, auto = nil, false
			if b then
				u, auto = Units.FocusUnit(b)
			end
			return u and { Id = u.id, Auto = auto } or nil
		end)(),
		Split = (function()
			local out = {}
			for k, v in pairs(perf.split or {}) do
				out[k] = perf.frames > 0 and v / perf.frames or 0
			end
			return out
		end)(),
	}
end

function BattleController.ResetStats()
	St.perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} }
end

-- the result card off (team balance: DungeonController's loss screen takes its place)
-- (LOOK-ui2) the result card is up: DailyController's K.WINDOWS asks this, so its Gift block stays hidden meanwhile (it came
-- back over the card's OK in the corner the card holds as soon as InBattle cleared)
function BattleController.IsOpen()
	return St.result ~= nil and Hud.result ~= nil and Hud.result.Visible == true
end

function BattleController.HideResult()
	Hud.HideResult()
end

-- (Pitch 2 item 02 B, look review round 1) the one result template for another end card (DungeonController's End card):
-- builds model M (Hud.ResultModel's shape: title, color, icon, sub, stats, chips, notes) into `body`; opts as
-- Hud.BuildResult. -> { H, Ok, Segs, ReasonRow }. PaintResultTimer(t, frac) lights OK's lip parts, t = { segs, count, lit }
function BattleController.ResultTemplate(body, M, opts)
	return Hud.BuildResult(body, M, opts or {})
end

function BattleController.PaintResultTimer(t, frac)
	Hud.PaintTimer(t, frac)
end

-- (keys look r3) a card that hangs under the enemy list (DungeonController's run chip, dropped there on a phone) asks for px
-- screen px under the list's last row (its tag) and above the action keys under it: the list shows fewer rows for it.
-- 0 / nil frees it. Lays the HUD out again only when the ask changes
function BattleController.ReserveUnderList(px)
	px = tonumber(px) or 0
	px = (px > 0) and math.ceil(px) or nil
	if Hud.listReserve == px then
		return
	end
	Hud.listReserve = px
	if St.battle and Hud.root then
		Hud.Rebuild()
	end
end

function BattleController.IsHudVisible()
	return Hud.gui ~= nil and Hud.gui.Parent ~= nil and ((Hud.team and Hud.team.Visible) or (Hud.cmd and Hud.cmd.Visible) or (Hud.result and Hud.result.Visible)) == true
end

function BattleController.Stop()
	if St.battle then
		Net.Cleanup(St.battle, true)
	end
	Fx.ClearAll()
	Atk.ClearAll()
	if St.screenFx then
		pcall(St.screenFx.gui.Destroy, St.screenFx.gui)
		St.screenFx = nil
	end
	Input.Bind(false)
	Input.Movement(nil, false)
	St.shake = nil
	if Mods.Cheer then
		pcall(Mods.Cheer.StopLoop)
	end
	for _, c in ipairs(St.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	St.conns = {}
	if St.loop then
		St.loop:Disconnect()
		St.loop = nil
	end
	Hud.SetMenuHidden(false)
	Hud.SetVitalsHidden(false)
	Me.MouseHold("BattleResult", false)
	Me.MouseHold("BattleLeave", false)
	St.prompts = {}
	if Hud.gui then
		Hud.gui:Destroy()
	end
	Hud.gui = nil
	Hud.rows = {}
	Hud.helpers = {}
	Hud.buttons = {}
	Hud.more = nil
	Hud.next = nil
	Hud.info = nil
	Hud.leave = nil
	Hud.cheer = nil
	CheerUp.placed = nil
	Hud.retreat = nil
	Leave.buttons = {}
	St.result = nil
	St.next = nil
	St.ringLast = nil
	for _, p in ipairs(St.pool) do
		pcall(p.Destroy, p)
	end
	St.pool = {}
	St.fxLive = 0
	if St.folder then
		pcall(St.folder.Destroy, St.folder)
		St.folder = nil
		St.fxFolder = nil
	end
	St.initialized = false
end

function BattleController.Init()
	if St.initialized then
		return
	end
	St.initialized = true
	local conns = St.conns
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input, processed)
		local ok, err = pcall(Input.OnBegan, input, processed)
		if not ok then
			warnOnce("input", err)
		end
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
		local ok, err = pcall(Input.OnEnded, input)
		if not ok then
			warnOnce("input2", err)
		end
	end)
	local okGp, gpConn = pcall(function()
		return UserInputService.LastInputTypeChanged:Connect(function(t)
			local gp = t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2
			if gp ~= St.gamepad then
				St.gamepad = gp
				pcall(Hud.Keys)
			end
		end)
	end)
	if okGp and gpConn then
		conns[#conns + 1] = gpConn
	end
	-- the prompts shown to me: E presses them, not ELEMENT (Input.PromptShown)
	pcall(function()
		local pps = game:GetService("ProximityPromptService")
		conns[#conns + 1] = pps.PromptShown:Connect(function(prompt)
			St.prompts[prompt] = true
		end)
		conns[#conns + 1] = pps.PromptHidden:Connect(function(prompt)
			St.prompts[prompt] = nil
		end)
	end)
	-- own pets' level / XP from the profile mirror (after a fight's rewards land: the cards follow)
	local okS, sConn = pcall(function()
		return Mods.State and Mods.State.Changed and Mods.State.Changed:Connect(function()
			if St.battle then
				pcall(Cards.FromState, St.battle)
			end
		end)
	end)
	if okS and sConn then
		conns[#conns + 1] = sConn
	end
	-- the Graphics setting drives AttackFx's quality (like PetFx: ClientSettings.Changed "Gfx", then
	-- GraphicsQuality.Effective() once GraphicsQuality has applied it)
	local okG, gConn = pcall(function()
		if Mods.Settings == nil then
			Mods.Settings = optional(Client, "ClientSettings") or false
		end
		local cs = Mods.Settings
		return cs and cs.Changed and cs.Changed:Connect(function(key)
			if key == "Gfx" then
				task.defer(Atk.SyncQuality)
			end
		end)
	end)
	if okG and gConn then
		conns[#conns + 1] = gConn
	end
	local cam = workspace.CurrentCamera
	if cam then
		conns[#conns + 1] = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if St.battle then
				pcall(Hud.Rebuild)
			end
			local r = St.result
			if r and r.battle and Hud.result and Hud.result.Visible then
				pcall(Hud.ShowResult, r.battle, r.payload) -- the card re-places itself (top right on a landscape phone)
			end
		end)
	end
	-- wave 6: the podium cheer loop follows the server's OnPodium attribute
	if LocalPlayer then
		local okP, pConn = pcall(function()
			return LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.OnPodium) or "OnPodium"):Connect(function()
				local ok, err = pcall(Cheer.SyncPodium)
				if not ok then
					warnOnce("podium", err)
				end
			end)
		end)
		if okP and pConn then
			conns[#conns + 1] = pConn
		end
		pcall(Cheer.SyncPodium)
	end
	-- the remote (BattleState may arrive a little after the controller starts)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
		local remote = folder and folder:WaitForChild("BattleState", 30)
		if not remote or not St.initialized then
			if St.initialized then
				warnOnce("remote", "BattleState remote not found: battles will not be drawn")
			end
			return
		end
		conns[#conns + 1] = remote.OnClientEvent:Connect(function(kind, payload, battleId)
			local ok, err = pcall(BattleController.HandleState, kind, payload, battleId)
			if not ok then
				warnOnce("state_" .. tostring(kind), "BattleState " .. tostring(kind) .. " failed: " .. tostring(err))
			end
		end)
		commandRemote()
	end)
end

BattleController._Units = Units -- TESTS ONLY (tools/smoke_p6_creatures.lua: the fx mesh slots)
BattleController._Me = Me -- TESTS ONLY (tools/smoke_p7vfx_client.lua: the Eclipse dim, Task 11)
BattleController._Fx = Fx -- TESTS ONLY (tools/smoke_p7vfx_client.lua: the Special pre-charge, Task 11b: numbers / flashes)
BattleController._Ring = Ring -- TESTS ONLY (tools/smoke_ring_noheal_client.lua: the run card's line, HUD cleanup Task 4)
BattleController._Hud = Hud -- TESTS ONLY (tools/smoke_wave6.lua: the vitals hold let go without a battle gui, quick wins review)
BattleController._Cards = Cards -- TESTS ONLY (tools/smoke_battle_tags.lua: the unit cards the damage total clears)
BattleController._St = St -- TESTS ONLY (tools/smoke_kitb_ui.lua battle_family_fits: Hud.ModeText of the drawn battle, U9-6 review)

-- TESTS ONLY (Task 11b): the raw battle unit record (its drawn HP, hold, hurt time) and my predicted charge
function BattleController._Unit(id)
	local B = St.battle
	return B and B.units[id] or nil
end

function BattleController._Pre()
	return St.pre
end

-- TESTS ONLY (battle-feel T3): the live server casts { [unit] = { Kind, DueAt } } of the battle on screen
function BattleController._Casts()
	local B = St.battle
	return B and B.casts or nil
end

-- TESTS ONLY (fix round 2, M5'): the inhale records by token
function BattleController._Inhales()
	return St.inhales
end

-- (Task 11) loads client/Controllers/AttackFx and points its Hooks at this controller (camera punch, edge glow, the
-- battle dim) outside a battle too: the /fx preview (DevPetShow) shows a signature's dim as a battle would. -> loaded
function BattleController.FxHooks()
	local m = Atk.Mod()
	Atk.Hook(m) -- (again: a hook someone cleared is pointed back here)
	return m ~= nil
end

-- (Task 11 fix round 1, M2) true while this controller's frame loop runs and steps AttackFx itself (Atk.Update): the
-- /fx preview (DevPetShow) then leaves its own AttackFx.Update out, so an effect is stepped once a frame (an Eclipse dim
-- in /fx wakes this loop through Me.Dim). The loop keeps running while any AttackFx effect lives (Atk.Pending).
-- (fix round 2, M8) and only while the loop really reaches Atk.Update: the last frame it ran (St.frameNo, counted first
-- thing in onFrame) is the frame Atk.Update stepped (St.fxFrame). A loop that fails earlier in its frame every frame
-- (pcall'd, one warning) stays connected but steps nothing: the caller then steps AttackFx itself. (Either order of the
-- two RenderStepped handlers in a frame: before onFrame both still hold the last frame's numbers, after it this one's)
function BattleController.StepsAttackFx()
	return St.loop ~= nil and Mods.AttackFx ~= nil and Mods.AttackFx ~= false and St.fxFrame == St.frameNo
end

-- TESTS ONLY (tools/smoke_dev.lua, M8): re-arm a once-only warning after a check that faults a frame on purpose
function BattleController._Unwarn(key)
	St.warned[key] = nil
end

return BattleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1129">
            <Properties>
              <string name="Name">BoostBadgeController</string>
              <string name="Source"><![CDATA[-- BoostBadgeController (client, store 2026-11-04; spec 8 "Boost chips"): the small chips under the HUD's currency strips that
-- say which paid boost is running. No HudController edit: it reads the HUD's published attributes.
--
--   BoostBadgeController.Init()
--   BoostBadgeController.Chips() -> { Cash = bool, Xp = text | nil }   what the chips show now
--
-- Data: the replicated Player attributes OwnedPasses (csv of pass keys, e.g. "VIP,Cash2x") and XpBoostEnds (unix seconds
-- the XP potion bank ends; 0 = none). The server decides both; this only shows them.
-- Screen: ScreenGui "NimbusBoosts" (DisplayOrder 10 like the HUD, IgnoreGuiInset = false: gui px), Frame "BoostChips"
--   right-aligned at the strips' right edge (the HUD's side margin: 12 px, 20 on touch), y = NimbusHud.TopRightBottom + 4,
--   holding TextLabels "Chip_Cash" ("x2 Cash", while OwnedPasses has Cash2x) and "Chip_Xp" ("x2 XP · 58m", while
--   XpBoostEnds > now, the time left refreshed every second; "x2 XP" while OwnedPasses has PetXp2x: the pass and a potion
--   never stack, the pass wins). 46x24 at 1080p (text 18), 34x18 text 15 on a phone (the smaller screen side <= 500); a chip
--   grows with its text. Hidden with the strips (InMatch / InBattle, or no top-right strips). kit-b U8 review: each chip is
--   a kit B tag (CloudUI.SignBlock: Cash the cash green, XP the violet, a wood edge, square; no neon border).
-- Side hints (MenuController.Hint): "x2 Pet XP started!" only for a potion that starts during this view: XpBoostEnds rises
-- from a value that was no running potion (0, or an old end already in the past: the server leaves the last end on the
-- attribute) to an end whose time left is one whole potion (a Config.Store.Items Boost.XpPotion length, within
-- START_SLACK s); never for the first value seen (the attribute absent until then), an end in the past, an extension of a
-- running potion, or a potion bought earlier that arrives late (a provisional recovery, a slow profile load: part of it is
-- already used). "x2 Pet XP ends in 5 min" once per potion when its time left crosses Config.Store.Potion.WarnSeconds
-- downward. Neither while OwnedPasses has PetXp2x: the pass wins (Chips() shows its untimed "x2 XP"), so a potion on top
-- of it (a Starter pack's) neither starts nor ends anything (re-review 1).
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local BoostBadgeController = {}

local K = {
	DISPLAY_ORDER = 10,
	GAP = 4, -- under the strips
	CHIP_GAP = 6, -- between two chips
	EDGE = 12, -- the HUD's side margin (HudController K.EDGE) ...
	TOUCH_EDGE = 20, -- ... and on touch devices (K.TOUCH_EDGE)
	SMALL = 500, -- the smaller screen side at most this = a phone
	PC = { W = 46, H = 24, Text = 18, Pad = 8 },
	PHONE = { W = 34, H = 18, Text = 15, Pad = 5 },
	TICK = 1,
	START_SLACK = 15, -- seconds: a fresh potion's time left is its full length within this (os.time vs the server clock)
	-- (kit-b U8 review) the chips' kit B looks: Cash in the HUD's cash green (its strip's coin square) with the dark green
	-- ink, XP in the kit's violet with the brown ink (5.2:1); a 2 px wood edge suits a 18-24 px chip
	CASH_LOOK = { Face = Theme.Sign.Grass, Lip = Theme.Sign.GrassLip, Edge = Theme.Sign.Wood, Text = Theme.Sign.OnGrass },
	XP_LOOK = { Face = Theme.Sign.Violet, Lip = Theme.Sign.VioletLip, Edge = Theme.Sign.Wood, Text = Theme.Sign.Text },
	EDGE_PX = 2,
}
BoostBadgeController.K = K

local DOT = "\194\183"

local LocalPlayer = nil
local initialized = false
local U = {}
local S = { Ends = 0, Seen = false, WarnedFor = nil, Started = false }
local warned = {}

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[BoostBadgeController] " .. key .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function now()
	return workspace:GetServerTimeNow()
end

local function viewport()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize
	if vp and vp.X >= 2 and vp.Y >= 2 then
		return vp
	end
	return Vector2.new(1920, 1080)
end

local function hasPass(key)
	local csv = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.OwnedPasses or "OwnedPasses")
	if type(csv) ~= "string" then
		return false
	end
	for entry in csv:gmatch("[^,]+") do
		if entry:gsub("^%s+", ""):gsub("%s+$", "") == key then
			return true
		end
	end
	return false
end

local function boostAttr()
	return LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.XpBoostEnds or "XpBoostEnds")
end

local function boostEnds()
	return tonumber(boostAttr()) or 0
end

-- the lengths of one XP potion (seconds): every Boost.XpPotion grant of Config.Store.Items
local function potionLengths()
	local out = {}
	local items = Config.Store and Config.Store.Items
	for _, item in ipairs(type(items) == "table" and items or {}) do
		local boost = type(item) == "table" and type(item.Grants) == "table" and item.Grants.Boost
		local secs = type(boost) == "table" and tonumber(boost.XpPotion)
		if secs and secs > 0 then
			out[#out + 1] = secs
		end
	end
	return out
end

-- a potion that has just started: its time left is one whole potion length
local function freshPotion(left)
	for _, secs in ipairs(potionLengths()) do
		if math.abs(left - secs) <= K.START_SLACK then
			return true
		end
	end
	return false
end

-- "58m" / "1h 5m"
local function leftText(seconds)
	local s = math.max(0, seconds)
	if s >= 3600 then
		return math.floor(s / 3600) .. "h " .. math.floor((s % 3600) / 60) .. "m"
	end
	return math.max(1, math.ceil(s / 60)) .. "m"
end

local function hint(text)
	local inst = script.Parent:FindFirstChild("MenuController")
	local ok, menu = pcall(function()
		return inst and require(inst)
	end)
	if ok and type(menu) == "table" and type(menu.Hint) == "function" then
		pcall(menu.Hint, text, "good")
	end
end

local function hiddenByPlay()
	local p = LocalPlayer
	return p == nil or p:GetAttribute(Config.Attr.InMatch) == true or p:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil
end

local H = {}

-- (kit-b U8 review) a chip is a kit B tag: a flat block in its colour in a wood edge (UIStroke "SignEdge"), square, its
-- text in the ink that reads on it; no lip (as the strips' coin squares: at 18-24 px a lip ran under the letters like an
-- underline)
function H.chip(name, look)
	local l = Theme.Label("", "Heading", { Size = K.PC.Text })
	l.Name = name
	l.AutomaticSize = Enum.AutomaticSize.X
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.Visible = false
	local pad = Instance.new("UIPadding")
	pad.Name = "Pad"
	pad.Parent = l
	CloudUI.SignBlock(l, look, { EdgePx = K.EDGE_PX, LipPx = 0, Pad = false })
	l.Parent = U.Holder
	return l
end

function BoostBadgeController.Chips()
	local out = { Cash = hasPass("Cash2x"), Xp = nil }
	local left = boostEnds() - now()
	if hasPass("PetXp2x") then
		out.Xp = "x2 XP"
	elseif left > 0 then
		out.Xp = "x2 XP " .. DOT .. " " .. leftText(left)
	end
	return out
end

function H.layout()
	if not U.Holder then
		return
	end
	local vp = viewport()
	local small = math.min(vp.X, vp.Y) <= K.SMALL
	local M = small and K.PHONE or K.PC
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local bottom = tonumber(hud and hud:GetAttribute("TopRightBottom")) or 0
	local chips = BoostBadgeController.Chips()
	local any = chips.Cash or chips.Xp ~= nil
	U.Holder.Visible = any and bottom > 0 and not hiddenByPlay()
	U.Holder.AnchorPoint = Vector2.new(1, 0)
	U.Holder.Position = UDim2.new(1, -(touch and K.TOUCH_EDGE or K.EDGE), 0, math.floor(bottom + K.GAP + 0.5))
	U.Holder.Size = UDim2.fromOffset(0, M.H)
	U.Layout.Padding = UDim.new(0, K.CHIP_GAP)
	for _, chip in ipairs({ U.Cash, U.Xp }) do
		chip.Size = UDim2.fromOffset(M.W, M.H)
		chip.TextSize = M.Text
		chip.Pad.PaddingLeft = UDim.new(0, M.Pad)
		chip.Pad.PaddingRight = UDim.new(0, M.Pad)
	end
	U.Cash.Text = "x2 Cash"
	U.Cash.Visible = chips.Cash
	U.Xp.Text = chips.Xp or ""
	U.Xp.Visible = chips.Xp ~= nil
end

-- the potion hints: started (see the header) and the WarnSeconds crossing (once per potion end)
function H.watchPotion()
	local ends = boostEnds()
	local was = S.Ends
	local seen = S.Seen
	S.Ends = ends
	S.Seen = boostAttr() ~= nil -- absent again: the next value is a first value (a baseline)
	local t = now()
	if S.Started and seen and was <= t and ends > t and freshPotion(ends - t) and not hasPass("PetXp2x") then
		hint("x2 Pet XP started!")
	end
	if ends ~= was then
		S.WarnedFor = nil
	end
end

function H.tick()
	local ends = boostEnds()
	local warnAt = (Config.Store and Config.Store.Potion and Config.Store.Potion.WarnSeconds) or 300
	local left = ends - now()
	if ends > 0 and left > 0 and left <= warnAt and S.WarnedFor ~= ends then
		if S.LastLeft and S.LastLeft > warnAt then
			S.WarnedFor = ends
			if not hasPass("PetXp2x") then -- the pass keeps x2: nothing ends
				hint("x2 Pet XP ends in " .. math.floor(warnAt / 60 + 0.5) .. " min")
			end
		end
	end
	S.LastLeft = left
	H.layout()
end

function BoostBadgeController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	local gui = CloudUI.NewScreenGui("NimbusBoosts", K.DISPLAY_ORDER)
	gui.IgnoreGuiInset = false
	U.Gui = gui
	local holder = Instance.new("Frame")
	holder.Name = "BoostChips"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.AutomaticSize = Enum.AutomaticSize.X
	holder.Visible = false
	holder.Parent = gui
	U.Holder = holder
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = holder
	U.Layout = layout
	U.Cash = H.chip("Chip_Cash", K.CASH_LOOK)
	U.Cash.LayoutOrder = 2
	U.Xp = H.chip("Chip_Xp", K.XP_LOOK)
	U.Xp.LayoutOrder = 1
	S.Ends = boostEnds()
	S.Seen = boostAttr() ~= nil
	S.LastLeft = S.Ends - now()
	S.Started = true
	local attr = Config.Attr
	for _, name in ipairs({ attr.OwnedPasses or "OwnedPasses", attr.InMatch, attr.InBattle or "InBattle" }) do
		LocalPlayer:GetAttributeChangedSignal(name):Connect(function()
			safe("layout", H.layout)
		end)
	end
	LocalPlayer:GetAttributeChangedSignal(attr.XpBoostEnds or "XpBoostEnds"):Connect(function()
		safe("potion", H.watchPotion)
		safe("layout", H.layout)
	end)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("layout", H.layout)
	end)
	safe("layout", H.layout)
	task.spawn(function()
		local pg = LocalPlayer:WaitForChild("PlayerGui")
		local hud = pg:WaitForChild("NimbusHud", 30)
		if hud then
			hud:GetAttributeChangedSignal("TopRightBottom"):Connect(function()
				safe("layout", H.layout)
			end)
			safe("layout", H.layout)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(K.TICK)
			safe("tick", H.tick)
		end
	end)
end

return BoostBadgeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1130">
            <Properties>
              <string name="Name">CareController</string>
              <string name="Source"><![CDATA[-- CareController (client, Phase 4): the pet-care windows of ARCHITECTURE_V3.md "Phase 4 build contract" 3.4-3.7.
-- gui-redo Task 7: the Training Place window lives in TrainController; this module forwards Train to it and keeps every
-- wire the Care window had (see "Train" below), so no other controller changes.
--
--   CareController.Init()
--   CareController.Open(panelId, args)   panelId = "Feed" | "Garden" | "Train" | "Evolve"
--       Feed    the Food Machine window (args.Key = the pet to show first): one row per owned pet copy, garden pets
--               first, then the followers, then the rest; each row has the pet, its name and stars, "Lv 57 / 100", the
--               XP bar, "Feed $340 (+90 XP)" (or "Feed (free Feast, 3 left)" while leftovers last), "Level up $1.2K"
--               (several feeds in ONE request, TycoonCatalog.FeedPrice per feed at the level it is eaten at) and
--               EVOLVE! when PetCatalog.CanEvolve says so; the footer lists the leftover food and the machine
--               ("Food Machine Lv 2: each feed fills 30% of the bar. Upgrade to Lv 3 (35%): $320K" + Upgrade).
--               -> PetCare("Feed", key, nil | {Count = n}); HomeAction("Upgrade", "Kitchen")
--       Garden  the garden picker for one place (args.Slot): every pet copy (any role) with its coins per second;
--               "Put here" -> HomeAction("GardenSet", {Slot, Key}); "Take out" -> HomeAction("GardenSet", {Slot})
--       Train   (also "Training") forwards to TrainController.Open(args) and returns its answer: the Training Place
--               window (client/Controllers/TrainController.lua; args.Key / args.ReturnTo as before). While it is up,
--               Mode() is "Train" and IsOpen() is true; Opened:Fire("Train") / Closed:Fire() come from it through
--               NotifyTrain; Close() and the drop of the way back (another window, a match) close it too; opening Feed
--               or Garden closes it first.
--       Evolve  the evolution moment (the server's OpenPanel("Evolve", {Key, Stage}) after PetCare("Evolve")): every
--               window closes, PetController.PlayEvolution parks the follower of that key, EvolutionFx plays on two
--               fresh PetBuilder clones 5.5 studs in front of the player (with confetti), then the evolved clone
--               flies home as the follower (release(position)) and goes away
--       args.ReturnTo (team balance, Feed / Garden): the Pets window's own Open args; closing this window goes back
--               to it (same pet), unless another window or a match took over
--   CareController.Close()               closes the Training window (TrainController.Close), then this window and any confirm
--   CareController.CloseOwn()            closes only Feed / Garden (and the confirm), never forwards, never goes back to the
--                                        Pets window (the Training window opening calls it)
--   CareController.NotifyTrain(open)     TrainController's open / close: Opened:Fire("Train") / Closed:Fire()
--   CareController.IsOpen() -> true while a care window, a confirm or the Training window is up
--   Extras: CareController.Mode() -> "Feed" | "Garden" | "Train" | nil, CareController.ConfirmEvolve(key) (the EVOLVE
--           confirm, used by the Pets window too), CareController.FeedPlan(key, count) -> { Count, Price, Xp, Free,
--           Food, Levels } (what a request would do; the server decides), CareController.Evolving() -> plays running,
--           CareController.Opened / Closed (Util.Signal; Opened fires the mode)
--
-- How the windows open: the server's OpenPanel("Pets", {Action = "Feed"}) (FeedPrompt on the Food Machine) and
-- OpenPanel("Train") (TrainPrompt, forwarded) arrive here; MenuController forwards OpenPanel("Pets", {Action = "Feed" | "Garden"})
-- calls made on the client; E on an own GardenSpotPrompt opens the picker for its Slot. One window at a time: opening
-- one closes the menu windows, the Pet Index and the Fusion Machine; those opening close it. Esc, the red X or a click
-- outside close it, so does entering a match.
-- The client never decides money, XP or ranks: every number shown comes from the catalogs and the synced profile and the
-- server checks every request again. Readability rule: 1080p design pixels (body 18-19, buttons 20, titles 28-32) under
-- ONE UIScale = min(screen factor, fit); the window keeps >= 14 px text on phones (portrait: one column, landscape:
-- the compact rows). Pet viewports use PetBuilder's Low detail and are attached under a per-frame time budget.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the stars, the where marks, the berry
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-5) the docked window's title plate stays inside it
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local PetCatalog = safeRequire("PetCatalog") or { Get = function() return nil end }
local TycoonCatalog = safeRequire("TycoonCatalog")
local BattleCatalog = safeRequire("BattleCatalog")

local CareController = {}
CareController.Opened = Util.Signal()
CareController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- above NimbusMenu (20), the Pet Index (21) and the Fusion Machine (22)
	MARGIN = 12,
	PREF_W = 600, -- Phase 5 (6.6): the Care window is docked right / a bottom sheet (NeonKit.Dock), 600 x 820 design px
	PREF_H = 820,
	SHORT = 560, -- below this design height: the compact rows (landscape phones)
	WIDE = 930, -- at least this wide: one-line rows (the buttons beside the bar)
	TALL_W = 720, -- less than this free (design px) on a portrait screen: one column
	ROW_H = 112,
	BUTTONS_W = 610, -- the one-line row's button block (Feed 276 + Level up 190 + EVOLVE 128 + gaps)
	ROW_H_STACKED = 176,
	ROW_H_SHORT = 100,
	ROW_H_SHORT_STACKED = 160,
	VIEW = 88,
	VIEW_SHORT = 72,
	TOP_H = 46,
	FOOT_H = 108,
	FOOT_H_SHORT = 74,
	CONFIRM_W = 560,
	CONFIRM_H = 286, -- (LOOK-ui2) the most it takes; the box is as tall as its content (H.relayoutConfirm)
	CONFIRM_LIP = 8,
	SHADE = 0.55, -- (LOOK-ui2) the PetPicker's shade under the confirm
	BUILD_BUDGET = 0.004, -- seconds of pet viewport building per frame (at least one per frame)
	FIRE_GAP = 0.3, -- client-side spacing between two sends of the same action
	TICK = 0.5, -- seconds between two timer refreshes while a window is open
	MAX_FEEDS = 10, -- "Level up": at most this many feeds in one request (the server's MAX_FEEDS)
	-- the evolution moment (contract 3.6)
	EVO_AHEAD = 5.5, -- studs in front of the player
	EVO_HOVER = 0.7, -- studs between the clone's lowest point and the ground
	EVO_REST = 1.3, -- seconds the evolved clone stays before it flies home as the follower
	EVO_DETAIL = "High",
	EVO_FOLDER = "CareEvolution",
	RAY = 60,
	BACK_ACTION = "NimbusCareBack",
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local GOOD = Colors.Good
local BAD = Colors.Bad
local WELL_EDGE = Colors.WellEdge or NAVY
local INSET = Color3.fromRGB(20, 30, 70)
local CASH = Colors.Cash or Color3.fromRGB(112, 204, 98)
local XP = Theme.Sign.Sky -- (LOOK-ui2: was #78C8FF) XP's one role colour in every window: Pets, Feed, the loss card
local PURPLE = Color3.fromRGB(168, 118, 236)
local LOCK = Color3.fromRGB(255, 206, 120)
local ACCENTS = {
	Feed = Color3.fromRGB(240, 150, 80),
	Garden = Color3.fromRGB(110, 190, 90),
}
-- (LOOK-ui2: #60C46C / #E46860, off the kit) the role tags in the kit's own grass and red
local ROLE_COLORS = { Economy = Theme.Sign.Grass, Combat = Theme.Sign.Red }
-- (kit-b U9-5) the Signboard palette (the pitch's kit B; one colour by role): brown ink on stone rows in the window's stone
-- body, sunk wells for the footer and the garden header, the rarity on a pet's well edge, gold for a pet ready to evolve;
-- green / violet text darkened until it reads on stone (4.5:1)
local SIGN = Theme.Sign
local INK = SIGN.Text
local SIGN_MUTED = SIGN.TextMuted
local GOOD_INK = SIGN.Good -- #2E7D32: 5.1:1 on the stone tile (LOOK-ui2: kit B's one good ink, Theme.Sign.Good)

-- (kit-b U7b) the marks are PixelIcons, not emoji: a pet's evolution stars, where it is (training: the weight, the
-- garden: the sprout, following: the star), the berry basket
local ICON = { Star = "star", Training = "weight", Garden = "sprout", Following = "star", Berry = "berry" }

local TITLES = {
	Feed = "Food Machine",
	Garden = "Pet Garden",
}

local SKILLS = (BattleCatalog and type(BattleCatalog.TrainingSkills) == "table" and #BattleCatalog.TrainingSkills == 4)
		and BattleCatalog.TrainingSkills
	or {
		{ Id = "Speed", Name = "Attack Speed", Text = "+4% attacks per rank" },
		{ Id = "Physique", Name = "Physique", Text = "+5% max health per rank" },
		{ Id = "Ability", Name = "Ability", Text = "+4% special power and charge per rank" },
		{ Id = "Defense", Name = "Defense", Text = "-3% damage taken per rank" },
	}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local S = {
	Open = false, -- a window is shown
	Mode = nil, -- "Feed" | "Garden" (the Training window is TrainController's)
	Token = 0,
	Built = false,
	Focus = nil, -- Feed: the pet to show first
	Slot = nil, -- Garden: the place the picker fills
	Short = false,
	Tall = false,
	Stacked = false,
	Confirm = nil, -- { Kind, Key, Stat, Yes = fn } while a confirm is up
	Evolving = 0,
	EvoQueue = {},
	Last = {}, -- last send per action key (os.clock)
	Filling = false,
	RefreshPending = false,
}
local U = { Rows = {}, GardenRows = {} } -- ui references
local H = {} -- helpers (one table: the module stays far below Lua's local limit)

local function warnOnce(key, err)
	S.Warned = S.Warned or {}
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[CareController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok, err
end

----------------------------------------------------------------------
-- small UI helpers
----------------------------------------------------------------------
function H.frame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel (stroke + glyph outline: readable on any panel)
function H.text(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or INK, -- (kit-b U9-5) brown on stone
		Props = p,
	})
	label.Parent = parent
	return label
end

function H.corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

function H.stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

function H.pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

function H.list(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function H.scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.Parent = parent
	return SignKit.ScrollBar(Util.Create("ScrollingFrame", p)) -- (U9-7 look) the kit's one list bar, square ends
end

-- (kit-b U9-5) a square edge (a mitred border UIStroke named SignEdge)
function H.edge(parent, color, thickness)
	local s = Theme.Stroke(parent, color, thickness or 2, 0)
	s.Name = "SignEdge"
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

-- (kit-b U9-5) a sunk stone well in a square edge (the footer, the garden header; was a navy inset)
function H.inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = SIGN.Well
	p.BackgroundTransparency = 0
	local f = H.frame(parent, name, p)
	H.edge(f, SIGN.WellEdge, 2)
	return f
end

-- (kit-b U9-5) a pet's row: a raised stone tile in a wood edge with a darker lip (gold when the pet can evolve)
function H.rowTile(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = SIGN.Tile
	p.BackgroundTransparency = 0
	local f = H.frame(parent, name, p)
	H.edge(f, SIGN.Wood, 2)
	H.frame(f, "Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.StoneLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 5),
	})
	return f
end

-- a solid coloured tag (role, status). (kit-b U9-5) square, in a wood edge, its colour nudged until its ink reads
-- (Theme.ReadableFace, 4.5:1); no gradient
function H.pill(parent, name, text, color, size, order)
	local px = size or 18
	local face, ink = Theme.ReadableFace(color, 4.5)
	local pill = Theme.Label(text, "Heading", {
		Size = px,
		Color = ink,
		Props = {
			Name = name,
			BackgroundTransparency = 0,
			BackgroundColor3 = face,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, px + 9),
			LayoutOrder = order or 0,
		},
	})
	H.edge(pill, SIGN.Wood, 2)
	H.pad(pill, 9, 0, 9, 1)
	pill.Parent = parent
	return pill
end

-- (kit-b U9-5) a kit B block (CloudUI.Button Skin "Sign": one colour by role, no glow)
function H.button(parent, name, text, style, size, textSize, callback)
	local b = CloudUI.Button({
		Name = name,
		Text = text,
		Style = style,
		Skin = "Sign",
		Size = size,
		TextSize = textSize or 20,
		Callback = callback,
		Parent = parent,
	})
	return b
end

-- a button whose text may take two lines (the narrow rows): slimmer top / bottom padding
function H.twoLine(button)
	button.TextWrapped = true
	local p = button:FindFirstChildOfClass("UIPadding")
	if p then
		p.PaddingTop = UDim.new(0, 3)
		p.PaddingBottom = UDim.new(0, 3)
	end
end

function H.tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

----------------------------------------------------------------------
-- data helpers (the synced profile + the catalogs; display only)
----------------------------------------------------------------------
function H.call(mod, fnName, ...)
	if type(mod) ~= "table" or type(mod[fnName]) ~= "function" then
		return nil
	end
	local ok, a, b = pcall(mod[fnName], ...)
	if ok then
		return a, b
	end
	return nil
end

function H.def(key)
	if type(key) ~= "string" then
		return nil
	end
	local ok, def = pcall(State.DefOf, key)
	if ok and type(def) == "table" then
		return def
	end
	return PetCatalog.Get and PetCatalog.Get(key) or nil
end

function H.name(key, def)
	def = def or H.def(key)
	return def and tostring(def.DisplayName or def.Name or key) or tostring(key)
end

function H.level(key)
	local ok, level, xp = pcall(State.PetLevel, key)
	if ok and type(level) == "number" then
		return math.max(1, math.floor(level)), tonumber(xp) or 0
	end
	return 1, 0
end

function H.cap(def, key)
	local cap = H.call(PetCatalog, "LevelCap", def or key)
	if type(cap) == "number" and cap >= 1 then
		return math.floor(cap)
	end
	return tonumber(PetCatalog.MaxLevel) or (TycoonCatalog and tonumber(TycoonCatalog.MaxPetLevel)) or 100
end

function H.xpToNext(level)
	local n = H.call(TycoonCatalog, "XpToNext", level)
	if type(n) == "number" and n > 0 then
		return n
	end
	return math.huge
end

function H.growth(key)
	local ok, g = pcall(State.PetGrowth, key)
	if ok and type(g) == "table" then
		return g
	end
	return { Evo = 0, Speed = 0, Physique = 0, Ability = 0, Defense = 0 }
end

-- Phase 5 (3.7): the stored stage the way every site draws it (State.PetStage)
function H.stage(key)
	if type(State.PetStage) == "function" then
		local ok, stage = pcall(State.PetStage, key)
		if ok and type(stage) == "number" then
			return math.max(0, math.floor(stage))
		end
	end
	return math.max(0, math.floor(tonumber(H.growth(key).Evo) or 0))
end

-- Phase 5 (3.4): berries in the basket (the Berries attribute / State.Berries) and the basket size (plot BerryCap)
function H.berries()
	if type(State.Berries) == "function" then
		local ok, n = pcall(State.Berries)
		if ok and type(n) == "number" then
			return math.max(0, math.floor(n))
		end
	end
	return 0
end

function H.plot()
	local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex)
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	if type(index) ~= "number" or not lobby then
		return nil
	end
	local named = lobby:FindFirstChild(string.format("Spot_%02d", index), true)
	if named and named:GetAttribute("SpotIndex") == index then
		return named
	end
	return nil
end

-- one Food Machine feed of a pet copy: { Cost = berries (TycoonCatalog.FeedBerries), Xp = TycoonCatalog.FeedXp }
function H.berryFeed(key, def, level, machine)
	local cost = tonumber(H.call(TycoonCatalog, "FeedBerries", def or key, level)) or 0
	local xp = tonumber(H.call(TycoonCatalog, "FeedXp", level, math.max(1, machine))) or 0
	return { Cost = math.floor(cost), Xp = math.floor(xp) }
end

-- the next stage when the pet can EVOLVE now, else nil
function H.canEvolve(key, def, level)
	local nextStage = H.call(PetCatalog, "CanEvolve", def or key, level, H.stage(key))
	if type(nextStage) == "number" and nextStage >= 1 then
		return nextStage
	end
	return nil
end

-- how many evolution stars a pet shows (0-2; kit-b U7b: drawn as PixelIcons after its name)
function H.stars(stage)
	return (stage and stage > 0) and math.min(2, stage) or 0
end

function H.home()
	local ok, home = pcall(State.Home)
	if ok and type(home) == "table" then
		return home
	end
	return { Stations = {}, Garden = {}, Prestige = 0 }
end

function H.station(home, id)
	local st = type(home) == "table" and home.Stations or nil
	local v = type(st) == "table" and st[id] or nil
	if type(v) == "number" and v == v then
		return math.max(0, math.floor(v))
	end
	return 0
end

function H.cash()
	local ok, v = pcall(State.Cash)
	if ok and type(v) == "number" then
		return v
	end
	return 0
end

function H.owned(key)
	local ok, n = pcall(State.OwnedCount, key)
	return ok and tonumber(n) or 0
end

function H.money(n)
	local text = H.call(TycoonCatalog, "FormatCash", n)
	if type(text) == "string" then
		return text
	end
	return "$" .. Util.Commas(math.floor(tonumber(n) or 0))
end

function H.rate(n)
	n = tonumber(n) or 0
	if n ~= n or n < 0 then
		n = 0
	end
	if n < 100 then
		local t = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		return "$" .. (t:gsub("%.0$", ""))
	end
	return H.money(n)
end

function H.commas(n)
	return Util.Commas(math.floor(tonumber(n) or 0))
end

-- a Color3 as RichText's "rrggbb"
function H.hex(c)
	local function byte(v)
		return math.max(0, math.min(255, math.floor(v * 255 + 0.5)))
	end
	return string.format("%02x%02x%02x", byte(c.R), byte(c.G), byte(c.B))
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.hasHome()
	return LocalPlayer ~= nil and type(LocalPlayer:GetAttribute(Config.Attr.SpotIndex)) == "number"
end

function H.now()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

function H.clock(seconds)
	seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function H.rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 1
		end
	end
	return 1
end

function H.rarityText(def)
	if def and def.Rarity == "Secret" then
		return Color3.fromRGB(196, 168, 255)
	end
	return Theme.Lighten(CloudUI.RarityColor(def and def.Rarity), 0.3)
end

-- every owned pet copy, rarest first (the Pets panel's order)
function H.ownedKeys()
	local ok, keys = pcall(State.Keys)
	if not ok or type(keys) ~= "table" then
		keys = {}
	end
	local info, out = {}, {}
	for i, key in ipairs(keys) do
		if type(key) == "string" and not info[key] and H.owned(key) > 0 then
			local def = H.def(key)
			if def then
				info[key] = { Order = H.rarityOrder(def.Rarity), Index = i }
				out[#out + 1] = key
			end
		end
	end
	table.sort(out, function(a, b)
		local x, y = info[a], info[b]
		if x.Order ~= y.Order then
			return x.Order > y.Order
		end
		return x.Index > y.Index
	end)
	return out
end

-- the Garden places holding `key` (ascending)
function H.gardenSlots(home, key)
	local out = {}
	if type(home.Garden) == "table" then
		for slot, k in pairs(home.Garden) do
			if k == key and type(slot) == "number" then
				out[#out + 1] = slot
			end
		end
	end
	table.sort(out)
	return out
end

function H.equippedCount(key)
	local ok, n = pcall(State.EquippedCount, key)
	return ok and tonumber(n) or 0
end

function H.equippedList()
	local ok, snap = pcall(State.Get)
	if ok and type(snap) == "table" and type(snap.Equipped) == "table" then
		return snap.Equipped
	end
	return {}
end

-- the running training job of a key { Stat, Ends, Rank, ... } or nil
function H.job(key)
	local job = H.growth(key).Job
	if type(job) == "table" then
		return job
	end
	return nil
end

function H.skillName(stat)
	for _, s in ipairs(SKILLS) do
		if s.Id == stat then
			return s.Name
		end
	end
	return tostring(stat)
end

-- where a pet copy is: "Physique 2:10" (training) | "In Garden" | "Following" | nil, its colour and its PixelIcon
function H.whereText(key, home)
	local job = H.job(key)
	if job then
		local left = (tonumber(job.Ends) or 0) - H.now()
		return H.skillName(job.Stat) .. " " .. H.clock(left), SIGN.VioletLip, ICON.Training -- (kit-b U9-5) inks that read on stone
	end
	if #H.gardenSlots(home or H.home(), key) > 0 then
		return "In Garden", GOOD_INK, ICON.Garden
	end
	if H.equippedCount(key) > 0 then
		return "Following", SIGN.Wood, ICON.Following
	end
	return nil, SIGN_MUTED, nil
end

-- the room left below the level cap, in XP
function H.room(level, xp, cap)
	if level >= cap then
		return 0
	end
	local room = 0
	for l = level, cap - 1 do
		local need = H.xpToNext(l)
		if need == math.huge then
			break
		end
		room = room + need
		if room > 1e12 then
			break
		end
	end
	return math.max(0, room - xp)
end

-- coins per second of a pet in this home's Garden (PetPower x food x stars / meal x the Lucky EV); a home without a
-- Garden counts the grass food
function H.coinsPerSecond(key, def, home)
	if not TycoonCatalog then
		return 0
	end
	local level = H.level(key)
	local power = H.call(TycoonCatalog, "PetPower", { Def = def, Level = level, Stage = H.stage(key), Key = key }) or 0
	local food = H.call(TycoonCatalog, "FoodOf", home) or 0
	local coins = TycoonCatalog.Coins or {}
	if food <= 0 then
		food = tonumber(coins.GrassFood) or 12
	end
	local stars = math.floor(tonumber(home.Prestige) or 0)
	local mult = H.call(TycoonCatalog, "PrestigeMultiplier", stars) or 1
	local lucky = H.call(TycoonCatalog, "LuckyEV", home) or 1
	local meal = tonumber(coins.MealSeconds) or 8
	return power * food * mult * lucky / meal
end

----------------------------------------------------------------------
-- remotes (each action at most every FIRE_GAP seconds; the server rate-limits as well)
----------------------------------------------------------------------
function H.fire(gapKey, name, ...)
	local now = os.clock()
	if S.Last[gapKey] and now - S.Last[gapKey] < K.FIRE_GAP then
		return false
	end
	local ok, remote = pcall(Remotes.Get, name)
	if not ok or not remote then
		warnOnce("remote " .. name, remote)
		return false
	end
	S.Last[gapKey] = now
	local args = { ... }
	local n = select("#", ...)
	local sent = pcall(function()
		remote:FireServer(unpack(args, 1, n))
	end)
	return sent
end

function H.hint(text, kind)
	-- the server answers every request with a side toast; local refusals use the menu's side hint (never centred)
	local menu = H.controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		pcall(menu.Hint, text, kind or "info")
	end
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

----------------------------------------------------------------------
-- window geometry (the FusionController pattern: one UIScale = min(screen factor, fit))
----------------------------------------------------------------------
function H.guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

function H.viewportHeight()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return H.guiSize().Y
end

-- the small centred confirm (EVOLVE): its preferred size at the screen factor, shrunk to fit
function H.confirmFit(prefW, prefH, minW, minH)
	local area = H.guiSize()
	local factor = Theme.ScreenFactor(H.viewportHeight())
	local freeW = area.X - 2 * K.MARGIN
	local freeH = area.Y - 2 * K.MARGIN
	local w = Util.Clamp(math.floor(freeW / factor), minW, prefW)
	local h = Util.Clamp(math.floor(freeH / factor), minH, prefH)
	local scale = Util.Clamp(math.min(factor, freeW / w, freeH / h), 0.3, 1.25)
	return w, h, scale, area.X / 2, area.Y / 2
end

----------------------------------------------------------------------
-- pet viewports (Low detail, a few per frame)
----------------------------------------------------------------------
function H.queueView(row)
	if row.ViewReady or not row.ViewHolder then
		return
	end
	U.ViewQueue = U.ViewQueue or {}
	if not row.Queued then
		row.Queued = true
		U.ViewQueue[#U.ViewQueue + 1] = row
	end
	if S.Filling then
		return
	end
	S.Filling = true
	task.spawn(function()
		task.wait()
		while S.Open and U.ViewQueue and #U.ViewQueue > 0 do
			local t0 = os.clock()
			local built = 0
			while #U.ViewQueue > 0 and (built == 0 or os.clock() - t0 < K.BUILD_BUDGET) and built < 3 do
				local r = table.remove(U.ViewQueue, 1)
				if r then
					r.Queued = false
				end
				if r and not r.ViewReady and r.ViewHolder and r.ViewHolder.Parent and r.Def then
					r.ViewReady = true
					local stage = H.stage(r.Key)
					r.ViewStage = stage
					local ok, handle = pcall(CloudUI.PetViewport, r.ViewHolder, r.Def, UDim2.new(1, 0, 1, 0), {
						Spin = "sway",
						Detail = "Low",
						Evolved = stage > 0 and stage or nil,
						ZIndex = 4,
					})
					if ok then
						r.View = handle
					end
					built = built + 1
				end
			end
			task.wait()
		end
		S.Filling = false
	end)
end

function H.dropRow(row)
	if row.View then
		pcall(row.View.Destroy)
		row.View = nil
	end
	if row.Frame then
		row.Frame:Destroy()
	end
end

-- the pet of a row: (kit-b U9-5) a square light well (the pitch's pet well) in its rarity's edge, the viewport inside
function H.petDisc(parent, def, size)
	local color = CloudUI.RarityColor(def and def.Rarity)
	local disc = H.frame(parent, "Pet", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.PetWell,
		ZIndex = 3,
	})
	H.edge(disc, color, 3)
	local holder = H.frame(disc, "ViewHolder", { Size = UDim2.new(1, 0, 1, 0), ZIndex = 4 })
	return disc, holder
end

----------------------------------------------------------------------
-- the window
----------------------------------------------------------------------
function H.buildFeedPage(body)
	local page = H.frame(body, "FeedPage", { Size = UDim2.new(1, 0, 1, 0), Visible = false })
	U.FeedPage = page
	U.FeedList = H.scroller(page, "FeedList", { Size = UDim2.new(1, 0, 1, -(K.FOOT_H + 10)) })
	H.pad(U.FeedList, 2, 2, 14, 6)
	H.list(U.FeedList, Enum.FillDirection.Vertical, 8)
	local foot = H.inset(page, "Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, K.FOOT_H),
	})
	U.Foot = foot
	U.Leftovers = H.text(foot, "Leftovers", "", "Heading", 18, INK, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -220, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.Machine = H.text(foot, "Machine", "", "Body", 19, INK, {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -220, 0, 62),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	U.Upgrade = H.button(foot, "UpgradeMachine", "Upgrade", "Gray", UDim2.fromOffset(190, 54), 21, function()
		H.upgradeMachine()
	end)
	U.Upgrade.AnchorPoint = Vector2.new(1, 0.5)
	U.Upgrade.Position = UDim2.new(1, -12, 0.5, 0)
	U.FeedEmpty = H.text(page, "Empty", "", "Body", 20, SIGN_MUTED, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.new(1, -60, 0, 80),
		TextWrapped = true,
		Visible = false,
	})
end

function H.buildGardenPage(body)
	local page = H.frame(body, "GardenPage", { Size = UDim2.new(1, 0, 1, 0), Visible = false })
	U.GardenPage = page
	local head = H.inset(page, "GardenHeader", { Size = UDim2.new(1, 0, 0, 72) })
	U.GardenHead = head
	U.GardenPlace = H.text(head, "Place", "", "Title", 24, INK, {
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -220, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	Theme.StyleTitle(U.GardenPlace, "Section") -- (kit-b U9-5) a section head: the plain kit B title
	U.GardenNow = H.text(head, "Now", "", "Body", 18, SIGN_MUTED, {
		Position = UDim2.fromOffset(14, 38),
		Size = UDim2.new(1, -220, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.TakeOut = H.button(head, "TakeOut", "Take out", "Red", UDim2.fromOffset(180, 50), 21, function()
		if S.Slot then
			H.fire("garden", "HomeAction", "GardenSet", { Slot = S.Slot })
		end
	end)
	U.TakeOut.AnchorPoint = Vector2.new(1, 0.5)
	U.TakeOut.Position = UDim2.new(1, -12, 0.5, 0)
	U.GardenList = H.scroller(page, "GardenList", { Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 1, -82) })
	H.pad(U.GardenList, 2, 2, 14, 6)
	H.list(U.GardenList, Enum.FillDirection.Vertical, 8)
end

-- the confirm (Evolve): its own holder above the window, so it also works over the Pets panel
function H.buildConfirm()
	-- (LOOK-ui2: the confirm lay bare over the Pets window, half-words round it) the PetPicker's shade under it
	U.ConfirmShade = H.frame(U.Gui, "ConfirmShade", {
		BackgroundTransparency = K.SHADE,
		BackgroundColor3 = SIGN.NavyLip,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Active = true,
		ZIndex = 29,
	})
	local holder = H.frame(U.Gui, "CareConfirm", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(K.CONFIRM_W, K.CONFIRM_H),
		Visible = false,
		ZIndex = 30,
	})
	U.Confirm = holder
	U.ConfirmFit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-5) a stone notice in a wood frame; the plain kit B title (the ribbon is for window titles)
	local box = H.frame(holder, "Box", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		ZIndex = 31,
	})
	U.ConfirmStroke = H.edge(box, SIGN.Wood, 6)
	-- (LOOK-ui2) the card's 8 px stone lip and its two nails, as the kit's other cards
	H.frame(box, "Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.StoneLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, K.CONFIRM_LIP),
		ZIndex = 31,
	})
	SignKit.Nails(box, { Inset = 5, ZIndex = 33 })
	U.ConfirmTitle = Theme.StyleTitle(H.text(box, "Title", "", "Title", 30, INK, {
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 40),
		TextScaled = true,
		ZIndex = 32,
	}), "Section") -- (kit-b prep) a dialog's title: the ribbon is for window titles only
	Util.Create("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 22, Parent = U.ConfirmTitle })
	U.ConfirmText = H.text(box, "Text", "", "Body", 20, INK, {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 1, -(146 + K.CONFIRM_LIP)),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 32,
	})
	local buttons = H.frame(box, "Buttons", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(16 + K.CONFIRM_LIP)),
		Size = UDim2.new(1, -32, 0, 58),
		ZIndex = 32,
	})
	H.list(buttons, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	U.ConfirmYes = CloudUI.Button({
		Name = "ConfirmYes",
		Text = "Yes",
		Style = "Green", -- (kit-b U9-5) the dialog's one main action
		Skin = "Sign",
		Size = UDim2.fromOffset(230, 56),
		TextSize = 23,
		LayoutOrder = 1,
		Callback = function()
			local c = S.Confirm
			H.closeConfirm()
			if c and type(c.Yes) == "function" then
				safe("confirm", c.Yes)
			end
		end,
		Parent = buttons,
	})
	U.ConfirmYes.ZIndex = 33
	U.ConfirmNo = CloudUI.Button({
		Name = "ConfirmNo",
		Text = "Not now",
		Style = "Gray",
		Skin = "Sign",
		Size = UDim2.fromOffset(170, 56),
		TextSize = 22,
		LayoutOrder = 2,
		Callback = function()
			H.closeConfirm()
		end,
		Parent = buttons,
	})
	U.ConfirmNo.ZIndex = 33
end

function H.buildWindow()
	if S.Built then
		return true
	end
	local holder = H.frame(U.Gui, "Window_Care", {
		Size = UDim2.fromOffset(K.PREF_W, K.PREF_H),
		Visible = false,
		ZIndex = 3,
	})
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- Phase 5 (6.6): docked right on landscape screens, a bottom sheet on portrait ones; follows the screen
	U.Dock = NeonKit.Dock(holder, U.Fit, K.PREF_W, K.PREF_H)
	local panel = CloudUI.Panel({
		Name = "CarePanel",
		Title = TITLES.Feed,
		Closable = true,
		Skin = "Signboard", -- (kit-b U9-5) the pitch's window: awning, navy header with the berry, wood frame, stone body
		Icon = ICON.Berry,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			CareController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	-- (kit-b U9-5) docked to the screen edge: no ribbon tails out over the frame (they ran off the screen)
	SignKit.HeaderOverhang(panel.TitleBar, false)
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	-- the info line + the Cash chip
	U.Top = H.frame(content, "Top", { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, K.TOP_H) })
	U.Info = H.text(U.Top, "Info", "", "Body", 19, SIGN_MUTED, {
		Size = UDim2.new(1, -220, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	-- Phase 5 (3.4): the Food Machine's header is the Berry Basket: a bar "1,240 / 3,000 berries" + "+578 a minute"
	U.Basket = CloudUI.Bar({
		Name = "BerryBasket",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 34, 0.5, 0),
		Size = UDim2.new(1, -180, 0, 32),
		Height = 32,
		TextSize = 19,
		Color = SIGN.Roof,
		Skin = "Sign", -- (LOOK-ui2) a row of kit blocks, the number beside it ("1,24|0" straddled the fill's edge)
		LabelSide = "Right",
		MinBlockW = 14, -- (a phone's narrow row: 5 to 10 blocks, never slivers)
		Parent = U.Top,
	})
	U.BasketIcon = H.text(U.Top, "BasketIcon", "", "Title", 26, SIGN.RedLip, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(30, 32),
	})
	PixelIcon.Host(U.BasketIcon, ICON.Berry, 27) -- (kit-b U7b)
	U.BasketRate = H.text(U.Top, "BasketRate", "", "Heading", 18, SIGN.RoofEdge, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(140, 40),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	U.CashChip = H.pill(U.Top, "Cash", "$0", Theme.Darken(CASH, 0.15), 22, 0)
	U.CashChip.AnchorPoint = Vector2.new(1, 0.5)
	U.CashChip.Position = UDim2.new(1, 0, 0.5, 0)
	U.Body = H.frame(content, "Body", {
		Position = UDim2.fromOffset(12, K.TOP_H + 16),
		Size = UDim2.new(1, -24, 1, -(K.TOP_H + 26)),
	})
	H.buildFeedPage(U.Body)
	H.buildGardenPage(U.Body)
	S.Built = true
	H.relayout()
	return true
end

----------------------------------------------------------------------
-- rows
----------------------------------------------------------------------
-- the left block of every row: pet disc, name (+ stars), "Lv 12 / 100", where it is
function H.rowHead(f, row, def)
	local disc, holder = H.petDisc(f, def, K.VIEW)
	disc.Position = UDim2.fromOffset(10, 10)
	row.Disc = disc
	row.ViewHolder = holder
	row.Name = H.text(f, "Name", "", "Title", 23, INK, {
		Position = UDim2.fromOffset(K.VIEW + 22, 6),
		Size = UDim2.new(0, 300, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	row.Level = H.text(f, "Level", "", "Heading", 19, SIGN_MUTED, {
		Position = UDim2.fromOffset(K.VIEW + 22, 38),
		Size = UDim2.fromOffset(140, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	row.Where = H.text(f, "Where", "", "Heading", 18, SIGN_MUTED, {
		Position = UDim2.fromOffset(K.VIEW + 166, 39),
		Size = UDim2.new(0, 260, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

function H.paintHead(row, key, def, home)
	local level = H.level(key)
	local cap = H.cap(def, key)
	local stage = H.stage(key)
	local stars = H.stars(stage)
	row.Name.Text = H.name(key, def)
	PixelIcon.Mark(row.Name, stars > 0 and ICON.Star or nil, { After = true, Count = stars, Of = stars, Colour = SIGN.GoldLip })
	row.Level.Text = "Lv " .. level .. " / " .. cap
	row.Level.TextColor3 = level >= cap and INK or SIGN_MUTED
	local where, color, icon = H.whereText(key, home)
	row.Where.Text = where or ""
	row.Where.TextColor3 = color
	PixelIcon.Mark(row.Where, where and icon or nil)
	return level, cap, stage
end

function H.newFeedRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.rowTile(U.FeedList, "Feed_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	row.Bar = CloudUI.Bar({
		Name = "XpBar",
		Position = UDim2.fromOffset(K.VIEW + 22, 70),
		Size = UDim2.new(0, 360, 0, 28),
		Height = 28,
		TextSize = 18,
		Color = XP,
		Skin = "Sign", -- (LOOK-ui2) a row of kit blocks, "300 / 1,065 XP" beside it (it started on the fill's edge)
		LabelSide = "Right",
		MinBlockW = 14,
		Parent = f,
	})
	local buttons = H.frame(f, "Buttons", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(K.BUTTONS_W, 60),
	})
	row.Buttons = buttons
	H.list(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	row.Feed = H.button(buttons, "Feed", "Feed", "Gray", UDim2.fromOffset(240, 58), 20, function()
		H.feed(key)
	end)
	row.Feed.LayoutOrder = 1
	row.Feed.RichText = true -- (a short basket shows the price in red: H.paintFeedRow)
	-- (Phase 5: no "Level up" button: ONE Feed button = one feed)
	row.Evolve = H.button(buttons, "Evolve", "Evolve!", "Gray", UDim2.fromOffset(122, 58), 20, function()
		CareController.ConfirmEvolve(key)
	end)
	row.Evolve.LayoutOrder = 3
	for _, b in ipairs({ row.Feed, row.Evolve }) do
		H.twoLine(b)
	end
	H.layoutFeedRow(row)
	return row
end

function H.layoutFeedRow(row)
	local stacked, short = S.Stacked, S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local h
	if stacked then
		h = short and K.ROW_H_SHORT_STACKED or K.ROW_H_STACKED
		if S.Tall then
			h = h + 22
		end
	else
		h = short and K.ROW_H_SHORT or K.ROW_H
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 128, short and 35 or 39)
	local barY = short and 62 or 70
	if stacked then
		row.Name.Size = UDim2.new(1, -(x + 10), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138), 0, 24)
		if S.Tall then
			-- portrait: "Lv 57 / 100" and where it is get a line each, the bar under them
			row.Where.Position = UDim2.fromOffset(x, 62)
			row.Where.Size = UDim2.new(1, -(x + 10), 0, 24)
			barY = 90
		end
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + 12), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(0.5, 1)
		row.Buttons.Position = UDim2.new(0.5, 0, 1, -8)
		row.Buttons.Size = UDim2.new(1, -20, 0, 60)
	else
		local right = K.BUTTONS_W + 20
		row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138 + right), 0, 24)
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + right), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(1, 0.5)
		row.Buttons.Position = UDim2.new(1, -10, 0.5, 0)
		row.Buttons.Size = UDim2.fromOffset(K.BUTTONS_W, 60)
	end
	-- stacked rows: the Feed button takes the row (70% beside EVOLVE when the pet is ready)
	local bh = short and 50 or 58
	if stacked then
		row.Feed.Size = UDim2.new(row.Ready and 0.68 or 1, row.Ready and -6 or 0, 0, bh)
		row.Evolve.Size = UDim2.new(0.32, -4, 0, bh)
		row.Buttons.Size = UDim2.new(1, -20, 0, bh + 2)
	else
		row.Feed.Size = UDim2.fromOffset(row.Ready and 300 or 430, 58)
		row.Evolve.Size = UDim2.fromOffset(128, 58)
	end
	row.Bar.FitCount() -- (LOOK-ui2: the XP row's block count follows its new room, CloudUI.Bar MinBlockW)
end

function H.paintFeedRow(row, home, cash)
	local key, def = row.Key, row.Def
	local level, cap = H.paintHead(row, key, def, home)
	local _, xp = H.level(key)
	local need = H.xpToNext(level)
	local capped = level >= cap
	if capped then
		row.Bar.SetFraction(1)
		row.Bar.SetText("MAX LEVEL")
		row.Bar.SetColor(GOLD)
	else
		row.Bar.SetFraction(need > 0 and need < math.huge and math.min(1, xp / need) or 0)
		row.Bar.SetText(H.commas(xp) .. " / " .. H.commas(need) .. " XP")
		row.Bar.SetColor(XP)
	end
	-- Phase 5 (3.4): ONE Feed button: "Feed  340 berries  (+90 XP)"; grey (still says why when pressed) while the
	-- basket is short or the machine is not built
	local machine = H.station(home, "Kitchen")
	local busy = H.inMatch()
	local one = H.berryFeed(key, def, level, machine)
	row.Cost = one.Cost
	if capped then
		row.Feed.Text = "Max level"
		CloudUI.SetStyle(row.Feed, "Gray")
		CloudUI.SetDisabled(row.Feed, true)
	elseif machine < 1 then
		row.Feed.Text = "Feed (build the Food Machine)"
		CloudUI.SetStyle(row.Feed, "Gray")
		CloudUI.SetDisabled(row.Feed, busy)
	else
		-- (kit-b U9-5) every row's Feed is a peer: stone; H.oneGreen lights the window's one green action. A feed the basket
		-- cannot pay for shows its price in red (as Train's short TRAIN) and stays pressable, so it says why
		local price = H.commas(one.Cost) .. " berries"
		if H.berries() < one.Cost then
			price = '<font color="#' .. H.hex(SIGN.RedLip) .. '">' .. price .. "</font>"
		end
		row.Feed.Text = "Feed  " .. price .. "  (+" .. H.commas(one.Xp) .. " XP)"
		CloudUI.SetDisabled(row.Feed, busy)
	end
	-- EVOLVE when ready
	local nextStage = H.canEvolve(key, def, level)
	row.Evolve.Visible = nextStage ~= nil
	row.Evolve.Text = S.Tall and "Evolve" or "Evolve!" -- (playtest 2026-11-28 C47) sentence case, as the kit's other buttons
	if (row.Ready ~= nil) ~= (nextStage ~= nil) then
		row.Ready = nextStage
		H.layoutFeedRow(row)
	end
	row.Ready = nextStage
	CloudUI.SetDisabled(row.Evolve, busy)
	if row.Frame then
		-- (kit-b U9-5) a pet that can evolve: the gold lip and the ink edge (the "selected" look)
		local edge = row.Frame:FindFirstChild("SignEdge")
		if edge then
			edge.Color = nextStage and INK or SIGN.Wood
		end
		local lip = row.Frame:FindFirstChild("Lip")
		if lip then
			lip.BackgroundColor3 = nextStage and SIGN.Gold or SIGN.StoneLip
		end
	end
end

function H.newGardenRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.rowTile(U.GardenList, "Pick_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	local info = H.frame(f, "Info", { Position = UDim2.fromOffset(K.VIEW + 22, 70), Size = UDim2.new(1, -(K.VIEW + 220), 0, 30) })
	row.Info = info
	row.InfoLayout = H.list(info, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	row.InfoLayout.Wraps = true
	local role = type(def.Role) == "string" and def.Role or "Combat"
	local mult = H.call(PetCatalog, "RoleMultiplier", def) or 1
	row.RoleText = role .. (mult > 1.001 and (" x" .. tostring(math.floor(mult * 10 + 0.5) / 10)) or "")
	row.RoleShort = role
	row.Role = H.pill(info, "Role", row.RoleText, ROLE_COLORS[role] or Theme.Buttons.Blue, 18, 1)
	-- (LOOK-ui2: a darkened green pill) the coins as the stone fact tag with the cash icon
	row.Coins = H.pill(info, "Coins", "Cash $0/s", SIGN.Tile, 18, 2) -- (playtest 2026-11-28 C20: the currency's name)
	row.Coins.TextXAlignment = Enum.TextXAlignment.Left -- (the tag hugs its text: the icon at its padded box's left edge)
	PixelIcon.Lead(row.Coins, Config.Icons and Config.Icons.Cash or "note")
	row.Put = H.button(f, "PutHere", "Put here", "Gray", UDim2.fromOffset(170, 56), 21, function()
		if S.Slot then
			H.fire("garden", "HomeAction", "GardenSet", { Slot = S.Slot, Key = key })
		end
	end)
	row.Put.AnchorPoint = Vector2.new(1, 0.5)
	row.Put.Position = UDim2.new(1, -12, 0.5, 0)
	H.layoutSimpleRow(row)
	return row
end

function H.layoutSimpleRow(row)
	local short = S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local stacked = S.Tall or S.Short
	local h = short and K.ROW_H_SHORT or K.ROW_H
	-- (LOOK-ui2: 34 px kept for a second chip line no row used, a dead band over "Put here") the button under the pills; the
	-- pills' second line only when they wrap (H.chipsWrap)
	local wraps = stacked and H.chipsWrap(row)
	if stacked then
		h = h + 52 + 5 + (wraps and 34 or 0) -- (+ the row's 5 px lip under the button)
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	local right = stacked and 10 or 200
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 144, short and 35 or 39)
	row.Where.Size = UDim2.new(1, -(x + 154 + right), 0, 24)
	row.Info.Position = UDim2.fromOffset(x, short and 64 or 70)
	row.Info.Size = UDim2.new(1, -(x + right), 0, (stacked and wraps) and 66 or 30)
	if stacked then
		row.Put.AnchorPoint = Vector2.new(1, 1)
		row.Put.Position = UDim2.new(1, -12, 1, -(8 + 5)) -- (8 px above the row's 5 px lip, not on it)
		row.Put.Size = UDim2.fromOffset(170, 48)
	else
		row.Put.AnchorPoint = Vector2.new(1, 0.5)
		row.Put.Position = UDim2.new(1, -12, 0.5, 0)
		row.Put.Size = UDim2.fromOffset(170, 56)
	end
end

-- (LOOK-ui2) the role and coins tags need two lines in the row's info box (design px; their drawn widths, the padding, the
-- edges and the coin icon)
function H.chipsWrap(row)
	local s = PixelIcon.RestScale(row.Frame)
	local fw = (s > 0) and row.Frame.AbsoluteSize.X / s or 0
	if fw <= 0 then
		-- (not laid out yet: the dock's width less the body's and the list's insets)
		local rect = U.Dock and U.Dock.Rect
		fw = rect and (rect.designW - 24 - 16) or 0
		if fw <= 0 then
			return false
		end
	end
	local view = S.Short and K.VIEW_SHORT or K.VIEW
	local room = fw - (view + 22) - 10
	local function w(lbl, extra)
		local ok, m = pcall(Theme.MeasureLabel, lbl)
		return ((ok and typeof(m) == "Vector2") and m.X or #lbl.Text * 18 * 0.6) * 1.1 + 22 + (extra or 0)
	end
	return w(row.Role) + 8 + w(row.Coins, 24) > room
end

function H.paintGardenRow(row, home)
	local key, def = row.Key, row.Def
	H.paintHead(row, key, def, home)
	local role0, coins0 = row.Role.Text, row.Coins.Text
	row.Role.Text = S.Tall and row.RoleShort or row.RoleText
	row.Coins.Text = "Cash " .. H.rate(H.coinsPerSecond(key, def, home)) .. "/s"
	if (S.Tall or S.Short) and (role0 ~= row.Role.Text or coins0 ~= row.Coins.Text) then
		H.layoutSimpleRow(row) -- (the tags' widths decide the row's height)
	end
	local placed = #H.gardenSlots(home, key)
	local here = S.Slot and type(home.Garden) == "table" and home.Garden[S.Slot] == key
	local free = H.owned(key) - placed
	local training = H.job(key) ~= nil
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	if here then
		row.Put.Text = "Here now"
	elseif training then
		row.Put.Text = "Training"
	elseif free <= 0 then
		row.Put.Text = "In Garden"
	else
		row.Put.Text = "Put here"
	end
	CloudUI.SetDisabled(row.Put, here or training or free <= 0 or H.inMatch() or not S.Slot or S.Slot > open)
	return (here or training or free <= 0) and 1 or 0
end

----------------------------------------------------------------------
-- refresh
----------------------------------------------------------------------
-- a keyed list: drop the rows of pets that are gone, add new ones, order the rest
function H.syncRows(map, keys, make)
	local want = {}
	for i, key in ipairs(keys) do
		want[key] = i
	end
	for key, row in pairs(map) do
		if not want[key] then
			H.dropRow(row)
			map[key] = nil
		end
	end
	for i, key in ipairs(keys) do
		local row = map[key]
		if not row then
			local def = H.def(key)
			if def then
				row = make(key, def)
				map[key] = row
			end
		end
		if row then
			row.Frame.LayoutOrder = i
			-- a pet that evolved meanwhile gets its new form
			if row.ViewReady and row.ViewStage ~= H.stage(key) then
				if row.View then
					pcall(row.View.Destroy)
					row.View = nil
				end
				row.ViewReady = false
			end
			H.queueView(row)
		end
	end
end

-- Feed order: garden pets (by place), then followers (equipped order), then the rest (rarest first)
function H.feedOrder(home)
	local keys = H.ownedKeys()
	local rank = {}
	local garden = type(home.Garden) == "table" and home.Garden or {}
	local slots = {}
	for slot in pairs(garden) do
		if type(slot) == "number" then
			slots[#slots + 1] = slot
		end
	end
	table.sort(slots)
	local n = 0
	for _, slot in ipairs(slots) do
		local k = garden[slot]
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	for _, k in ipairs(H.equippedList()) do
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	local out = {}
	for i, k in ipairs(keys) do
		out[i] = k
		if not rank[k] then
			rank[k] = 1000 + i
		end
	end
	table.sort(out, function(a, b)
		return rank[a] < rank[b]
	end)
	-- the pet the window was opened for comes first
	if S.Focus then
		for i, k in ipairs(out) do
			if k == S.Focus then
				table.remove(out, i)
				table.insert(out, 1, k)
				break
			end
		end
	end
	return out
end

function H.refreshFeed(home, cash)
	local keys = H.feedOrder(home)
	H.syncRows(U.Rows, keys, H.newFeedRow)
	for _, row in pairs(U.Rows) do
		H.paintFeedRow(row, home, cash)
	end
	H.oneGreen(home)
	U.FeedEmpty.Visible = #keys == 0
	U.FeedEmpty.Text = "No pets yet! Spin a roulette in the Shop to hatch one."
	-- how it works (the kid rule, 3.4), always the same words
	U.Leftovers.Text = "Each Feed turns berries into XP. Your garden pets grow more berries!"
	local level = H.station(home, "Kitchen")
	local shares = TycoonCatalog and TycoonCatalog.FeedShare or {}
	local def = H.call(TycoonCatalog, "Get", "Kitchen")
	local maxLevel = def and def.MaxLevel or #shares
	local pad = H.kitchenPad(home)
	local pct = function(l)
		return math.floor((tonumber(shares[l]) or 0) * 100 + 0.5) .. "%"
	end
	local text
	if level < 1 then
		text = "Build the Food Machine at home first: each feed then fills " .. pct(1) .. " of a pet's XP bar."
		if pad and not pad.Locked then
			text = text .. " Build it: " .. H.money(pad.Price)
		end
	elseif level >= maxLevel then
		text = "Food Machine Lv " .. level .. " (max): each feed fills " .. pct(level) .. " of the bar."
	else
		text = "Food Machine Lv " .. level .. ": each feed fills " .. pct(level) .. " of the bar."
		if pad and not pad.Locked then
			text = text .. " Upgrade to Lv " .. (level + 1) .. " (" .. pct(level + 1) .. "): " .. H.money(pad.Price)
		elseif pad and pad.Locked then
			text = text .. " Lv " .. (level + 1) .. ": " .. tostring(pad.Locked)
		end
	end
	if S.Short then
		-- landscape phones: the short form (the footer has one line pair)
		text = level < 1 and "Build the Food Machine first" or ("Food Machine Lv " .. level .. ": feeds fill " .. pct(level))
	end
	U.Machine.Text = text
	local canBuy = pad ~= nil and not pad.Locked and level < maxLevel
	U.Upgrade.Visible = canBuy
	H.fitFoot()
	U.Upgrade.Text = level < 1 and "Build" or "Upgrade"
	CloudUI.SetDisabled(U.Upgrade, not canBuy or cash < (tonumber(pad and pad.Price) or 0) or not H.hasHome() or H.inMatch())
	-- the Berry Basket header: "1,240 / 3,000 berries" + "(+750 a minute)"
	local berries = H.berries()
	local plot = H.plot()
	local cap = plot and plot:GetAttribute("BerryCap")
	local income = plot and plot:GetAttribute("IncomePerSecond")
	local share = (TycoonCatalog and type(TycoonCatalog.Berries) == "table" and tonumber(TycoonCatalog.Berries.Share)) or 0.25
	if type(cap) == "number" and cap > 0 then
		U.Basket.SetFraction(math.min(1, berries / cap))
		U.Basket.SetText(H.basketText(H.commas(berries) .. " / " .. H.commas(math.floor(cap))))
	else
		U.Basket.SetFraction(berries > 0 and 1 or 0)
		U.Basket.SetText(H.basketText(H.commas(berries)))
	end
	U.BasketRate.Text = (type(income) == "number" and income > 0) and ("+" .. H.commas(math.floor(income * share * 60 + 0.5)) .. " a minute") or ""
	U.Info.Text = ""
end

-- (kit-b U9-5) one colour by role: the Food Machine's one green action is its next step, the first pet in the list that
-- can evolve (its EVOLVE), else the first one the basket holds a feed for (its Feed); every other button stays stone
function H.oneGreen(home)
	local rows = {}
	for _, row in pairs(U.Rows) do
		rows[#rows + 1] = row
	end
	table.sort(rows, function(a, b)
		return a.Frame.LayoutOrder < b.Frame.LayoutOrder
	end)
	local lit = nil
	for _, row in ipairs(rows) do
		if row.Evolve.Visible and row.Evolve:GetAttribute("Disabled") ~= true then
			lit = row.Evolve
			break
		end
	end
	if not lit and H.station(home, "Kitchen") >= 1 then
		local have = H.berries()
		for _, row in ipairs(rows) do
			if row.Feed:GetAttribute("Disabled") ~= true and H.level(row.Key) < H.cap(row.Def, row.Key) and (tonumber(row.Cost) or math.huge) <= have then
				lit = row.Feed
				break
			end
		end
	end
	for _, row in ipairs(rows) do
		for _, b in ipairs({ row.Feed, row.Evolve }) do
			local style = (b == lit) and "Green" or "Gray"
			if b:GetAttribute("Style") ~= style then
				CloudUI.SetStyle(b, style)
			end
		end
	end
end

function H.kitchenPad(home)
	for _, p in ipairs(H.call(TycoonCatalog, "AvailablePads", home) or {}) do
		if type(p) == "table" and p.StationId == "Kitchen" then
			return p
		end
	end
	return nil
end

function H.upgradeMachine()
	if H.inMatch() then
		return
	end
	if not H.hasHome() then
		H.hint("Claim a home first: " .. CloudUI.PromptWords() .. " at a free gate.", "info")
		return
	end
	H.fire("upgrade", "HomeAction", "Upgrade", "Kitchen")
end

function H.refreshGarden(home)
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	local slot = S.Slot
	local keys = H.ownedKeys()
	H.syncRows(U.GardenRows, keys, H.newGardenRow)
	-- the pets that can go here first (then the busy ones)
	local busy = {}
	for _, row in pairs(U.GardenRows) do
		busy[row.Key] = H.paintGardenRow(row, home)
	end
	local order = {}
	for i, k in ipairs(keys) do
		order[i] = k
	end
	local index = {}
	for i, k in ipairs(keys) do
		index[k] = i
	end
	table.sort(order, function(a, b)
		local x, y = busy[a] or 0, busy[b] or 0
		if x ~= y then
			return x < y
		end
		return index[a] < index[b]
	end)
	for i, k in ipairs(order) do
		if U.GardenRows[k] then
			U.GardenRows[k].Frame.LayoutOrder = i
		end
	end
	local current = slot and type(home.Garden) == "table" and home.Garden[slot] or nil
	-- (kit-b U9-5) each line with its shorter forms: H.fitGardenHead shows the longest one that fits on a phone
	if slot then
		local count = open > 0 and ("  (" .. open .. " open)") or ""
		S.GardenTexts = { "Garden place " .. slot .. count, "Place " .. slot .. count, "Place " .. slot }
	else
		S.GardenTexts = { "Pet Garden" }
	end
	if current and type(current) == "string" then
		local name = H.name(current)
		S.GardenNowTexts = { "Now here: " .. name .. ". Pick a pet to swap, or take it out.", "Now here: " .. name .. ".", name }
	elseif slot and slot > open then
		S.GardenNowTexts = { "This place opens with a Prestige.", "Opens with a Prestige." }
	else
		-- (LOOK-ui2: the info line under it said the same sentence 30 px away) the place's line is the action
		S.GardenNowTexts = slot and { "Pick a pet for place " .. slot .. ".", "Pick a pet for place " .. slot, "Pick a pet." } or { "Pick a pet to work here." }
	end
	U.GardenPlace.Text = S.GardenTexts[1]
	U.GardenNow.Text = S.GardenNowTexts[1]
	U.TakeOut.Visible = type(current) == "string"
	H.fitGardenHead()
	CloudUI.SetDisabled(U.TakeOut, H.inMatch())
	U.Info.Text = "Every pet can work here: it eats at the Food Bowl and poops Cloud Cash!"
end

function H.refresh()
	if not S.Built then
		return
	end
	local home = H.home()
	local cash = H.cash()
	U.CashChip.Text = H.money(cash)
	U.Info.TextColor3 = SIGN_MUTED
	local feedMode = S.Mode == "Feed"
	U.CashChip.Visible = not feedMode and not S.Tall
	U.Info.Visible = not feedMode
	U.Basket.Root.Visible = feedMode
	U.BasketIcon.Visible = feedMode
	U.BasketRate.Visible = feedMode
	U.FeedPage.Visible = S.Mode == "Feed"
	U.GardenPage.Visible = S.Mode == "Garden"
	if S.Mode == "Feed" then
		H.refreshFeed(home, cash)
	elseif S.Mode == "Garden" then
		H.refreshGarden(home)
	end
end

-- State.Changed can come in bursts: one refresh per frame at most
function H.refreshSoon()
	if S.RefreshPending then
		return
	end
	S.RefreshPending = true
	task.defer(function()
		S.RefreshPending = false
		if S.Open then
			safe("refresh", H.refresh)
		end
	end)
end

-- (kit-b U9-5) the garden header's two lines: the whole width when the Take out button is not beside them (portrait puts it
-- under them; an empty place has none), and on a narrow window the longest form of each line that fits its box (the
-- place line from 24 down to 18 px, the hint line from 18 down to 16; a portrait hint wraps). Widths are design px: the
-- label's share of the window times the dock's design width, so the open pop's scale does not count
function H.fitGardenHead()
	if not (U.GardenPlace and U.Panel and U.Dock) then
		return
	end
	local tall = S.Tall == true
	local wide = tall or not U.TakeOut.Visible
	U.GardenPlace.Size = UDim2.new(1, wide and -28 or -220, 0, 30)
	U.GardenNow.Size = UDim2.new(1, wide and -28 or -220, 0, tall and 48 or 26)
	local rect, root = U.Dock.Rect, U.Panel.Root
	local rootW = root and root.AbsoluteSize.X or 0
	if not rect or rootW <= 0 then
		return
	end
	local k = rect.designW / rootW
	local function fit(lbl, texts, maxSize, minSize, wrapped)
		if type(texts) ~= "table" or #texts == 0 then
			return
		end
		if wrapped then
			lbl.Text, lbl.TextSize = texts[1], maxSize
			return
		end
		local room = lbl.AbsoluteSize.X * k - 4 -- (2 px each side to spare)
		for _, t in ipairs(texts) do
			for size = maxSize, minSize, -1 do
				if Theme.MeasureLabel(lbl, t, size).X <= room then
					lbl.Text, lbl.TextSize = t, size
					return
				end
			end
		end
		lbl.Text, lbl.TextSize = texts[#texts], minSize
	end
	fit(U.GardenPlace, S.GardenTexts, 24, 18, false)
	fit(U.GardenNow, S.GardenNowTexts, 18, 16, tall)
	-- (LOOK-ui2: a 118 px box with its lower third empty on a phone) the box as tall as its lines and Take out
	if tall then
		local room = U.GardenNow.AbsoluteSize.X * k
		local okM, m = pcall(Theme.MeasureLabel, U.GardenNow, U.GardenNow.Text, 18)
		local lines = (room > 0 and okM and typeof(m) == "Vector2" and m.X * 1.1 > room) and 2 or 1
		local nowH = lines * 24
		U.GardenNow.Size = UDim2.new(1, -28, 0, nowH)
		local headH = 38 + nowH + 8 + (U.TakeOut.Visible and (44 + 8) or 0)
		U.GardenHead.Size = UDim2.new(1, 0, 0, headH)
		U.GardenList.Position = UDim2.fromOffset(0, headH + 10)
		U.GardenList.Size = UDim2.new(1, 0, 1, -(headH + 10))
	end
end

-- (LOOK-ui2: the footer kept 150 design px on a phone, half of it room for an Upgrade that was hidden; the list showed 1.3
-- cards) the Food Machine's footer as tall as what it shows: a PC its two lines (the Upgrade plank beside them); a phone
-- the Machine line only, the plank under it (portrait) or beside it (landscape) only while it shows
function H.fitFoot()
	if not (U.Foot and U.Machine and U.Dock and U.Dock.Rect) then
		return
	end
	local short, tall = S.Short == true, S.Tall == true
	local up = U.Upgrade.Visible
	local w = math.floor(U.Dock.Rect.designW + 0.5) - 24
	local footH
	if tall then
		local room = math.max(40, w - 28)
		local okM, m = pcall(Theme.MeasureLabel, U.Machine, U.Machine.Text, 19)
		local tw = (okM and typeof(m) == "Vector2") and m.X * 1.1 or #U.Machine.Text * 19 * 0.55
		local mh = math.max(1, math.ceil(tw / room)) * 25
		U.Machine.Size = UDim2.new(1, -28, 0, mh)
		footH = 8 + mh + 8 + (up and (46 + 8) or 0)
	elseif short then
		footH = up and 60 or 40
		U.Machine.Size = UDim2.new(1, up and -170 or -28, 0, footH - 12)
	else
		footH = up and K.FOOT_H or 80
		U.Machine.Size = UDim2.new(1, up and -220 or -28, 0, footH - 44)
	end
	U.Foot.Size = UDim2.new(1, 0, 0, footH)
	U.FeedList.Size = UDim2.new(1, 0, 1, -(footH + 10))
end

-- (kit-b U9-5) "Berry Basket 1,240 / 3,000", or the numbers alone when the words do not fit the bar (a phone: the berry
-- icon beside it names it). Widths in design px, as H.fitGardenHead
function H.basketText(numbers)
	local full = "Berry Basket " .. numbers
	local label = U.Basket and U.Basket.Label
	local rect, root = U.Dock and U.Dock.Rect, U.Panel and U.Panel.Root
	local rootW = root and root.AbsoluteSize.X or 0
	if not (label and rect and rootW > 0) then
		return full
	end
	-- (LOOK-ui2: the number sits beside the blocks now) the words only while the label keeps under 55% of the bar
	local bar = U.Basket.Root
	local room = bar.AbsoluteSize.X * rect.designW / rootW * 0.55
	if room > 0 and Theme.MeasureLabel(label, full).X * 1.15 > room then
		return numbers
	end
	return full
end

function H.relayout()
	if not S.Built then
		return
	end
	U.Dock.Refresh()
	local rect = U.Dock.Rect
	if not rect then
		return
	end
	local w, h = math.floor(rect.designW + 0.5), math.floor(rect.designH + 0.5)
	-- "short" (landscape phones): compact rows; "tall" (a narrow window with height): the one-column layouts
	local short = h < K.SHORT
	local tall = (not short) and w < K.TALL_W
	local stacked = tall or (w - 48) < K.WIDE
	local changed = short ~= S.Short or stacked ~= S.Stacked or tall ~= S.Tall
	S.Short, S.Stacked, S.Tall = short, stacked, tall
	-- landscape phones: no info line (the list needs the height); portrait: no Cash chip (the info line wraps)
	-- (landscape phones keep the Berry Basket bar in the Food Machine, the other windows drop their info line)
	local topH = short and ((S.Mode == "Feed") and 38 or 0) or K.TOP_H
	U.Top.Visible = topH > 0
	-- (LOOK-ui2: the dock never drew its roof: `tall` held for every 600 px dock) the fixed awning as on the other docked
	-- windows, hidden only where the panel's top comes within 12 px of Roblox's top bar (its 10 px rise would lie on it)
	if U.Panel.Roof then
		local okI, topLeft = pcall(function()
			return (GuiService:GetGuiInset())
		end)
		local inset = (okI and typeof(topLeft) == "Vector2") and topLeft.Y or 0
		U.Panel.Roof.Visible = (rect.y - inset) >= math.max(12, 10 * (rect.scale or 1) + 2)
	end
	U.Top.Size = UDim2.new(1, -24, 0, topH)
	U.Top.Position = UDim2.fromOffset(12, 8)
	U.CashChip.Visible = not tall
	U.Info.Size = tall and UDim2.new(1, 0, 1, 0) or UDim2.new(1, -220, 1, 0)
	U.Body.Position = UDim2.fromOffset(12, topH + (short and 8 or 16))
	U.Body.Size = UDim2.new(1, -24, 1, -(topH + (short and 16 or 26)))
	-- feed footer (LOOK-ui2: H.fitFoot sizes it to what it shows; a phone keeps the Machine line only)
	U.Leftovers.Visible = not (short or tall)
	H.fitFoot()
	if tall then
		U.Leftovers.Size = UDim2.new(1, -28, 0, 46)
		U.Leftovers.TextWrapped = true
		U.Leftovers.TextYAlignment = Enum.TextYAlignment.Top
		U.Machine.Position = UDim2.fromOffset(14, 8)
		U.Upgrade.AnchorPoint = Vector2.new(1, 1)
		U.Upgrade.Position = UDim2.new(1, -12, 1, -8)
		U.Upgrade.Size = UDim2.fromOffset(170, 46)
	else
		U.Leftovers.TextWrapped = false
		U.Leftovers.Size = UDim2.new(1, -220, 0, 26)
		U.Machine.Position = UDim2.fromOffset(14, short and 6 or 36)
		U.Upgrade.AnchorPoint = Vector2.new(1, 0.5)
		U.Upgrade.Position = UDim2.new(1, -12, 0.5, 0)
		U.Upgrade.Size = UDim2.fromOffset(short and 150 or 190, short and 48 or 54)
	end
	-- the garden header (a phone's: H.fitGardenHead, from its text)
	U.GardenHead.Size = UDim2.new(1, 0, 0, tall and 118 or 72)
	U.GardenList.Position = UDim2.fromOffset(0, tall and 128 or 82)
	U.GardenList.Size = UDim2.new(1, 0, 1, -(tall and 128 or 82))
	U.GardenNow.TextWrapped = tall
	H.fitGardenHead()
	U.GardenNow.TextYAlignment = Enum.TextYAlignment.Top
	if tall then
		U.TakeOut.AnchorPoint = Vector2.new(1, 1)
		U.TakeOut.Position = UDim2.new(1, -12, 1, -8)
		U.TakeOut.Size = UDim2.fromOffset(160, 44)
	else
		U.TakeOut.AnchorPoint = Vector2.new(1, 0.5)
		U.TakeOut.Position = UDim2.new(1, -12, 0.5, 0)
		U.TakeOut.Size = UDim2.fromOffset(180, 50)
	end
	if changed then
		for _, row in pairs(U.Rows) do
			H.layoutFeedRow(row)
		end
		for _, row in pairs(U.GardenRows) do
			H.layoutSimpleRow(row)
		end
		if S.Open then
			H.refreshSoon()
		end
	end
	U.Basket.FitCount() -- (LOOK-ui2: the basket's block count follows the top row's room)
	H.relayoutConfirm()
end

function H.relayoutConfirm()
	if not U.Confirm then
		return
	end
	-- (LOOK-ui2: a fixed 286 px left a 60 px hole between the text and the buttons) as tall as its content: the title, the
	-- wrapped text, the buttons and the lip
	local w0 = H.confirmFit(K.CONFIRM_W, K.CONFIRM_H, 440, 200)
	local okM, m = pcall(Theme.MeasureLabel, U.ConfirmText, U.ConfirmText.Text, 20)
	local tw = (okM and typeof(m) == "Vector2") and m.X * 1.1 or #U.ConfirmText.Text * 20 * 0.55
	local textH = math.max(1, math.ceil(tw / math.max(40, w0 - 40))) * 26
	local want = math.min(K.CONFIRM_H, 60 + textH + 16 + 58 + 16 + K.CONFIRM_LIP)
	local w, h, scale, x, y = H.confirmFit(K.CONFIRM_W, want, 440, math.min(want, 200))
	U.Confirm.Size = UDim2.fromOffset(w, h)
	U.ConfirmFit.Scale = scale
	U.Confirm.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
end

----------------------------------------------------------------------
-- actions
----------------------------------------------------------------------
-- ONE feed (PetCare("Feed", key): the server checks everything again); a short basket or no machine says why here
function H.feed(key)
	if H.inMatch() then
		H.hint("Pets eat at home, after the match.", "info")
		return
	end
	local def = H.def(key)
	if not def then
		return
	end
	local home = H.home()
	local machine = H.station(home, "Kitchen")
	if machine < 1 then
		H.hint("Build the Food Machine at home first", "info")
		return
	end
	local level = H.level(key)
	if level >= H.cap(def, key) then
		return
	end
	local cost = H.berryFeed(key, def, level, machine).Cost
	local have = H.berries()
	if have < cost then
		-- (playtest 2026-11-28 C59) a feed bigger than the basket can ever hold: waiting never helps, the Berry Farm does
		-- (a pet levelled in battles before the farm was built); it said 'Your garden pets grow more!' all the same
		local cap = H.basketCap(home)
		if cap and cost > cap then
			H.hint("Your basket holds " .. H.commas(cap) .. " berries: level up the Berry Farm to feed this pet", "bad")
			return
		end
		H.hint("Not enough berries: a feed needs " .. H.commas(cost) .. " (you have " .. H.commas(have) .. "). Your garden pets grow more!", "bad")
		return
	end
	H.fire("feed:" .. key, "PetCare", "Feed", key)
end

-- (playtest 2026-11-28 C59) the Berry Basket's size: the plot's BerryCap, else TycoonCatalog.BasketCap from its income;
-- nil when neither is known
function H.basketCap(home)
	local plot = H.plot()
	local cap = plot and plot:GetAttribute("BerryCap")
	if type(cap) == "number" and cap > 0 then
		return math.floor(cap)
	end
	local income = plot and plot:GetAttribute("IncomePerSecond")
	if TycoonCatalog and type(TycoonCatalog.BasketCap) == "function" and type(income) == "number" then
		local ok, v = pcall(TycoonCatalog.BasketCap, home, income)
		if ok and type(v) == "number" and v > 0 then
			return math.floor(v)
		end
	end
	return nil
end

function H.showConfirm(spec)
	if not U.Confirm then
		return
	end
	S.Confirm = spec
	U.ConfirmTitle.Text = spec.Title or ""
	U.ConfirmText.Text = spec.Text or ""
	U.ConfirmYes.Text = spec.Yes and (spec.YesText or "Yes") or "OK"
	-- (kit-b U9-5) Yes is the dialog's one green action (a red one stays red); brown title, the wood frame for every kind
	local style = spec.Style or "Green"
	CloudUI.SetStyle(U.ConfirmYes, (style == "Gold") and "Green" or style)
	U.ConfirmTitle.TextColor3 = INK
	U.ConfirmNo.Text = spec.NoText or "Not now"
	H.relayoutConfirm()
	U.Confirm.Visible = true
	U.ConfirmShade.Visible = true
	local pop = U.Confirm:FindFirstChild("Pop") or Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = U.Confirm:FindFirstChild("Box") })
	pop.Scale = 0.9
	H.tween(pop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	H.syncBack()
end

function H.closeConfirm()
	S.Confirm = nil
	if U.Confirm then
		U.Confirm.Visible = false
		U.ConfirmShade.Visible = false
	end
	H.syncBack()
end

----------------------------------------------------------------------
-- the evolution moment (contract 3.6)
----------------------------------------------------------------------
function H.playerFrame()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

function H.groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then
		ignore[#ignore + 1] = char
	end
	if U.EvoFolder then
		ignore[#ignore + 1] = U.EvoFolder
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- lowest point of a built pet below its root
function H.bottomOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or Vector3.new()
	return rel.Y - size.Y / 2
end

function H.evoFolder()
	if U.EvoFolder and U.EvoFolder.Parent then
		return U.EvoFolder
	end
	local f = Instance.new("Folder")
	f.Name = K.EVO_FOLDER
	f.Parent = Workspace
	U.EvoFolder = f
	return f
end

-- another window, a match or the evolution takes over: closing the care window does not go back to the Pets window
function H.dropReturn()
	S.ReturnTo = nil
	S.BackTo = nil
	S.EvoBack = nil
	local train = H.controller("TrainController")
	if train and type(train.DropReturn) == "function" then
		safe("training drop return", train.DropReturn)
	end
end

-- the Training window (TrainController) while it is up, else nil
function H.trainOpen()
	local train = H.controller("TrainController")
	if train and type(train.IsOpen) == "function" and train.IsOpen() then
		return train
	end
	return nil
end

-- what an Evolve's cinematic closes and brings back after it: the Pets window when a panel waits behind it (Ring, Dungeon,
-- Arena, the loss screen: its own Close then follows that chain). A window with nothing behind it stays closed.
function H.evolveBack()
	if S.EvoBack then
		return S.EvoBack
	end
	if type(S.ReturnTo) == "table" and S.ReturnTo.ReturnTo then
		return S.ReturnTo
	end
	local pets = H.controller("PetsController")
	if pets and type(pets.ReturnArgs) == "function" then
		return pets.ReturnArgs()
	end
	return nil
end

-- the last cinematic is over: back, unless another window (H.dropReturn), a match or a battle took over meanwhile
function H.evolutionOver()
	local back = S.EvoBack
	S.EvoBack = nil
	local pets = back and H.controller("PetsController")
	local battle = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InBattle)
	if pets and not H.inMatch() and (battle == nil or battle == false or battle == "") then
		safe("back to pets", pets.Open, back)
	end
end

function H.closeAll()
	H.dropReturn()
	CareController.Close()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function H.playEvolution(key, stage)
	local def = H.def(key)
	local PetBuilder = safeRequire("PetBuilder")
	local Fx = H.controller("EvolutionFx")
	local PC = H.controller("PetController")
	stage = math.max(1, math.min(2, math.floor(tonumber(stage) or 1)))
	local back = H.evolveBack()
	H.closeAll()
	S.EvoBack = back
	local fxSeconds = (Fx and H.call(Fx, "Duration", stage)) or 4.6
	local release = function() end
	if PC and type(PC.PlayEvolution) == "function" then
		local ok, fn = pcall(PC.PlayEvolution, key, stage, { Seconds = fxSeconds + K.EVO_REST + 1 })
		if ok and type(fn) == "function" then
			release = fn
		end
	end
	if not (def and PetBuilder and Fx and type(Fx.Play) == "function") then
		release()
		H.evolutionOver()
		return false
	end
	local okA, fromModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = (stage - 1 > 0) and (stage - 1) or nil })
	local okB, toModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = stage })
	if not (okA and okB and typeof(fromModel) == "Instance" and typeof(toModel) == "Instance" and fromModel.PrimaryPart and toModel.PrimaryPart) then
		release()
		H.evolutionOver()
		return false
	end
	fromModel.Name = "Evolving_" .. tostring(def.Id)
	toModel.Name = "Evolved_" .. tostring(def.Id)
	local origin, look, char = H.playerFrame()
	local spot = Vector3.new(origin.X, 0, origin.Z) + look * K.EVO_AHEAD
	local ground = H.groundAt(Vector3.new(spot.X, origin.Y + 4, spot.Z), char, origin.Y - 3)
	local pos = Vector3.new(spot.X, ground + K.EVO_HOVER - H.bottomOf(fromModel), spot.Z)
	local pose = CFrame.lookAt(pos, pos - look) -- facing the player
	local folder = H.evoFolder()
	fromModel.Parent = folder
	local okColors, c1, c2 = pcall(PetBuilder.EvolutionColors, def, stage)
	S.Evolving = S.Evolving + 1
	local finished = false
	local function done(model)
		if finished then
			return
		end
		finished = true
		task.delay(K.EVO_REST, function()
			local at = nil
			if typeof(model) == "Instance" and model.PrimaryPart then
				at = model.PrimaryPart.Position
			end
			pcall(release, at)
			if typeof(model) == "Instance" then
				pcall(function()
					model:Destroy()
				end)
			end
			S.Evolving = math.max(0, S.Evolving - 1)
			H.nextEvolution()
		end)
	end
	local okPlay, handle = pcall(Fx.Play, fromModel, toModel, pose, {
		Parent = folder,
		Colors = okColors and { c1, c2 } or nil,
		Stage = stage,
		Ground = ground,
		Confetti = true,
		OnDone = done,
	})
	if not okPlay or type(handle) ~= "table" or handle.Done then
		pcall(function()
			fromModel:Destroy()
			toModel:Destroy()
		end)
		finished = true
		S.Evolving = math.max(0, S.Evolving - 1)
		release()
		H.evolutionOver()
		return false
	end
	U.EvoHandle = handle
	return true
end

function H.nextEvolution()
	if S.Evolving > 0 then
		return
	end
	local nextOne = table.remove(S.EvoQueue, 1)
	if nextOne then
		safe("evolve", H.playEvolution, nextOne.Key, nextOne.Stage)
	else
		H.evolutionOver()
	end
end

----------------------------------------------------------------------
-- open / close
----------------------------------------------------------------------
-- (kit-b U9-5) on a touch-only device Roblox's thumbstick and jump button go while Feed / Garden is up (the sheet fills the
-- bottom of a phone: its footer and its Put here buttons sat under them), as the Training Place and the Fusion Machine do
-- (MenuController.SetTouchHidden("Care")); they come back as they were on close
function H.syncTouch()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local want = S.Open and touchOnly
	if want == (S.TouchOff == true) then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		safe("touch", menu.SetTouchHidden, "Care", want)
	end
end

-- gamepad B closes the confirm / the window while one is up (bound only then, so it never eats the dash)
function H.syncBack()
	H.syncTouch()
	local want = S.Open or S.Confirm ~= nil
	local ContextActionService = game:GetService("ContextActionService")
	if want and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					if S.Confirm then
						H.closeConfirm()
					else
						CareController.Close()
					end
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	elseif not want and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function H.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function CareController.IsOpen()
	return S.Open or S.Confirm ~= nil or H.trainOpen() ~= nil
end

function CareController.Mode()
	if S.Open then
		return S.Mode
	end
	return H.trainOpen() and "Train" or nil
end

-- TrainController's window opened (true) / closed (false): the signals the Care window always fired for Train
function CareController.NotifyTrain(open)
	if open then
		CareController.Opened:Fire("Train")
	else
		CareController.Closed:Fire()
	end
end

function CareController.Evolving()
	return S.Evolving
end

-- the EVOLVE confirm ("Evolve Pebble Pup? +25% to everything") -> PetCare("Evolve", key)
function CareController.ConfirmEvolve(key)
	if not initialized then
		CareController.Init()
	end
	local def = H.def(key)
	if not def or not U.Gui then
		return false
	end
	if H.inMatch() then
		return false
	end
	local level = H.level(key)
	local nextStage = H.canEvolve(key, def, level)
	local name = H.name(key, def)
	if not nextStage then
		local levels = PetCatalog.EvolutionLevels or { 20, 50 }
		local stage = H.stage(key)
		local maxStage = H.call(PetCatalog, "MaxEvolution", def) or 1
		local text
		if stage >= maxStage then
			text = name .. " is fully evolved!"
		else
			text = name .. " evolves at level " .. tostring(levels[stage + 1] or 20) .. " (Lv " .. level .. " now)."
		end
		H.hint(text, "info")
		return false
	end
	-- Phase 5 (3.1): EVOLVE multiplies the level bonus (x1.5 / x1.875), not the stat
	local bonus = tonumber(H.call(PetCatalog, "EvolutionBonusOf", nextStage)) or (nextStage == 2 and 1.875 or 1.5)
	local bonusText = string.format("%.3f", bonus):gsub("0+$", ""):gsub("%.$", "")
	H.showConfirm({
		Kind = "Evolve",
		Key = key,
		Title = "Evolve " .. name .. "?",
		Text = name .. " changes into its " .. (nextStage == 2 and "Evolved II" or "Evolved") .. " form: Level bonus x" .. bonusText
			.. " (battle power, health and Cash). It keeps its level.",
		YesText = "Evolve!",
		Style = "Gold",
		Color = GOLD,
		Yes = function()
			H.fire("evolve", "PetCare", "Evolve", key)
		end,
	})
	return true
end

function CareController.Open(panelId, args)
	if not initialized then
		CareController.Init()
	end
	if not U.Gui then
		return false
	end
	args = type(args) == "table" and args or {}
	local id = type(panelId) == "string" and panelId:lower() or ""
	if id == "evolve" then
		if type(args.Key) ~= "string" then
			return false
		end
		if S.Evolving > 0 then
			S.EvoQueue[#S.EvoQueue + 1] = { Key = args.Key, Stage = args.Stage }
			return true
		end
		local ok, played = safe("evolve", H.playEvolution, args.Key, args.Stage)
		return ok and played == true
	end
	if id == "train" or id == "training" then
		-- the Training Place window is TrainController's (gui-redo Task 7)
		local train = H.controller("TrainController")
		if not (train and type(train.Open) == "function") then
			return false
		end
		local ok, opened = safe("open training", train.Open, args)
		return ok and opened == true
	end
	local mode = (id == "feed" and "Feed") or (id == "garden" and "Garden") or nil
	if not mode then
		return false
	end
	-- the Training window gives way (no way back to the Pets window from it: this window takes over)
	local train = H.trainOpen()
	if train then
		safe("training drop return", train.DropReturn)
		safe("close training", train.Close)
	end
	if H.inMatch() then
		return false
	end
	if not H.buildWindow() then
		return false
	end
	if mode == "Feed" then
		S.Focus = type(args.Key) == "string" and args.Key or nil
	elseif mode == "Garden" then
		local slot = tonumber(args.Slot)
		S.Slot = (slot and slot == math.floor(slot) and slot >= 1) and slot or nil
		if not S.Slot then
			-- no place given: the first open empty one
			local home = H.home()
			local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
			for s = 1, open do
				if type(home.Garden) ~= "table" or home.Garden[s] == nil then
					S.Slot = s
					break
				end
			end
			S.Slot = S.Slot or 1
		end
	end
	local wasOpen = S.Open
	if not wasOpen then
		H.closeOthers()
		S.BackTo = nil
		S.ReturnTo = type(args.ReturnTo) == "table" and args.ReturnTo or nil
	end
	if mode ~= S.Mode then
		-- a fresh list order for the new window (the viewports are kept per row)
		if U.FeedList then
			U.FeedList.CanvasPosition = Vector2.new(0, 0)
		end
	end
	S.Mode = mode
	S.Open = true
	S.Token = S.Token + 1
	U.Panel.SetTitle(TITLES[mode])
	if U.Panel.SetAccent then
		pcall(U.Panel.SetAccent, ACCENTS[mode])
	end
	H.relayout()
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 0.86
		H.tween(U.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	safe("refresh", H.refresh)
	H.syncBack()
	-- timers tick while the window is open
	local mine = S.Token
	task.spawn(function()
		while S.Open and S.Token == mine do
			task.wait(K.TICK)
			if S.Open and S.Token == mine and (S.Mode == "Feed" or S.Mode == "Garden") then
				safe("tick", H.refresh)
			end
		end
	end)
	CareController.Opened:Fire(mode)
	return true
end

-- Feed / Garden (and the confirm)
function H.closeOwn()
	if S.Confirm then
		H.closeConfirm()
	end
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	local back = S.ReturnTo
	S.ReturnTo = nil
	H.syncBack()
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	CareController.Closed:Fire()
	if back then
		-- came from the Pets window: back to it next, unless what closed this one takes over (H.dropReturn)
		S.BackTo = back
		task.defer(function()
			if S.BackTo == back then
				S.BackTo = nil
				local pets = H.controller("PetsController")
				if pets and not H.inMatch() then
					safe("back to pets", pets.Open, back)
				end
			end
		end)
	end
end

function CareController.Close()
	-- the Training window first (before the "nothing open" return below): every caller that closes the Care window today
	-- (Arena, Dungeon, Obby, RaidGate, the window hooks, a match) closes Training too
	local train = H.controller("TrainController")
	if train and type(train.Close) == "function" then
		safe("close training", train.Close)
	end
	H.closeOwn()
end

-- only Feed / Garden: the Training window opening closes it this way (no forwarding, no way back to the Pets window)
function CareController.CloseOwn()
	S.ReturnTo = nil
	S.BackTo = nil
	H.closeOwn()
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function H.onPrompt(prompt)
	if typeof(prompt) ~= "Instance" or prompt.Name ~= "GardenSpotPrompt" then
		return
	end
	local owner = prompt:GetAttribute("OwnerUserId")
	if owner ~= nil and LocalPlayer and owner ~= LocalPlayer.UserId then
		return -- someone else's garden (HomeFx hides those prompts anyway)
	end
	CareController.Open("Garden", { Slot = prompt:GetAttribute("Slot") })
end

function H.onOpenPanel(panelId, args)
	if type(panelId) ~= "string" then
		return
	end
	args = type(args) == "table" and args or {}
	local id = panelId:lower()
	if id == "train" or id == "training" or id == "evolve" then
		CareController.Open(panelId, args)
	elseif id == "feed" then
		CareController.Open("Feed", args)
	elseif id == "pets" and (args.Action == "Feed" or args.Action == "Garden") then
		CareController.Open(args.Action, args)
	end
end

function H.connectOthers()
	local function hook(name, signalName)
		local mod = H.controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				H.dropReturn()
				CareController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
	hook("ArenaController", "Opened")
	hook("DungeonController", "Opened")
	hook("ObbyController", "Opened")
end

function CareController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusCare", K.DISPLAY_ORDER)
	-- (LOOK-ui2: under the window's Fit of 0.8 a 2 px edge drew 1.6 screen px, a 8 px lip 6.4) every wood edge and lip of the
	-- window, now and as rows are added, on whole screen px (PixelIcon.WholeTree, kitb-look1's one helper)
	PixelIcon.WholeTree(U.Gui)
	H.buildConfirm()
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", H.relayout)
		safe("relayout confirm", H.relayoutConfirm)
	end)
	State.Changed:Connect(function()
		if S.Open then
			H.refreshSoon()
		end
	end)
	if type(State.BerriesChanged) == "table" and type(State.BerriesChanged.Connect) == "function" then
		State.BerriesChanged:Connect(function()
			if S.Open then
				H.refreshSoon()
			end
		end)
	end
	if type(State.CashChanged) == "table" and type(State.CashChanged.Connect) == "function" then
		State.CashChanged:Connect(function()
			if S.Open then
				H.refreshSoon()
			end
		end)
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				H.dropReturn()
				CareController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape then
			if S.Confirm then
				H.closeConfirm()
			elseif S.Open then
				CareController.Close()
			end
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", H.onPrompt, prompt)
	end)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "OpenPanel")
		if ok and remote then
			remote.OnClientEvent:Connect(function(panelId, args)
				safe("OpenPanel", H.onOpenPanel, panelId, args)
			end)
		end
	end)
	task.defer(function()
		safe("connect", H.connectOthers)
	end)
end

return CareController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1131">
            <Properties>
              <string name="Name">DailyController</string>
              <string name="Source"><![CDATA[-- DailyController (client, store 2026-11-04; spec 5.2 / 8 "Gifts" / 13b.3-4; window redo gui-redo Task 9:
-- docs/superpowers/specs/2026-11-06-window-redo-design.md 5.1 / 5.3, plan docs/superpowers/plans/2026-11-06-window-redo.md):
-- the Gifts button, its pip and ring, and the Gifts window (the Daily page: the 7-day streak, card A; the Play time page).
--
--   DailyController.Init()
--   DailyController.Open(args)    args = { Tab = "Daily" | "Play" } (nil: Daily, or Play when only a play tier is claimable)
--   DailyController.Close()
--   DailyController.IsOpen() -> bool
--   DailyController.State() -> the last DailyState payload | nil
--   DailyController.PipShown() -> bool
--   DailyController.Layout() -> "PC" | "Phone" | "Portrait"   (the open window's layout, or the one it would open in)
--   DailyController.ClaimView(st, now, touch) -> { Mode, Line1, Line2, Repair }   pure: what the claim slot says for the
--       payload `st` at server time `now` (`touch`: a touch-only device). Mode:
--         "Claim"   (Line1 "Claim!") | "Repair" ("Repair streak (no gift)")
--         "Locked"  ready, but the 10-minute rule still holds it (Unlock.Left > 0 and Unlock.Need > 0): Line1 "Unlocks after
--                   10 min of play" (the minutes of Need), Line2 by priority: "Day resets in N min" when the live play-day
--                   ends before the unlock can come (0 < Play.DayEnds - now < the seconds left); else "Paused: move
--                   around!" (a touch device: "Paused: close this and move!": the stick is hidden while the window is
--                   open) while Play.Active == false; else "N min to go". The seconds left count down from the payload's
--                   ServerNow while Play.Active and hold at "1 min to go" until a payload says Left == 0: the client
--                   never unlocks on its own clock. Repair = true for a locked repair (it keeps the wide repair button).
--         "Wait"    not ready yet: "Next gift in 4h 12m" ("Streak repair in 4h 12m" when that claim only repairs)
--         "Stale"   past StaleAt, and "Loading" (no payload, or a Loading one): "Getting your gifts ready..."
--       A payload with no Unlock (an older server) or Need 0 (the rule off) is unlocked.
--   DailyController.TierCountdown(i, st, now) -> text   pure (gui-redo Task 10): play tier i's own countdown at server time
--       `now`: the seconds to its minute = Min x 60 - live, live = Play.Seconds + (now - ServerNow while Play.Active, else
--       0); "13:00" (m:ss) under an hour, "2h 13m" from an hour; never below "0:01" (the server's payload marks the tier
--       Ready: the client never does on its own clock); "" for a Ready / claimed / missing tier or a Loading payload.
--
-- Data: DailyState (server -> client) is the only source (DailyService builds it; nothing here decides a reward):
--   { Loading = bool (provisional: no CLAIM), Streak, Paid, Weeks, Pet, ReadyAt (unix), KeepUntil (unix), Cell (1..7: the NEXT
--     cell), Repair = bool (the next claim repairs a missed day and pays nothing), StaleAt (unix: the view changes then by
--     itself, the keep deadline or another missed day; 0 = never), Vip = bool, StepBack = n (the last claim's
--     step-back), Unlock = { Need = 600, Left = n } (gui-redo Task 4: the counted play seconds of the live play-day a
--     streak claim still needs), Days = { { Kind = "Cash" | "Tokens" | "Gems" | "Pet", Amount = n | nil, PetId =
--     "week_wisp" | nil, Claimed, Today, Repair = true | nil (today's cell of a repair) } x7 }, Play = { Seconds, DayEnds
--     (unix), Active = bool, Tiers = { { Min, Kind, Amount, PetId, Claimed, Ready } x7 } }, ServerNow (unix) }
--   Amounts are the server's resolved numbers (13b.3). Countdowns use ReadyAt / DayEnds - workspace:GetServerTimeNow().
--   A claim fires DailyRequest("Claim") / DailyRequest("ClaimPlay", tier) / DailyRequest("ClaimPlayAll") (1 s client gap per
--   action); the toast is the server's. The tutorial gate reads TutorialState (Done, or Step >= the index of the "spin" step).
--
-- Screen: ScreenGui "NimbusDaily" (DisplayOrder 19 like the Store and the Pets window: they never overlap, each Open fires
-- MenuController.WindowOpened(id) and each closes on any other id; IgnoreGuiInset = false: the HUD attributes are gui px).
--   * TextButton "GiftsButton": (kit-b U8) a small pink kit B block (the pitch's HUD stage: the pixel gift over "Gift") docked
--     under the HUD's currency strips: the square NimbusHud publishes (GiftLeft / GiftTop / GiftSize: right-aligned with
--     the strips, 8 px x the screen factor under them, 56 px at 1080p x the factor, never under 44); without those
--     attributes (no HUD) x = NimbusHud.TopRightLeft - 8 - size, y = 6 (gui px), 56 px at 1080p (x the screen
--     factor), 44 px on a phone; hidden with the strips (InMatch / InBattle, or no top-right strips) and, with its ring and
--     pip, while any window of K.WINDOWS is open (slop audit 2026-11-12, win 5: H.windowUp; back within K.WINDOW_POLL of the
--     close), and (owner 2026-11-13) while the Gifts window itself is open (back at once on Close) or an NPC talk box
--     is up (NpcController, in K.WINDOWS); re-laid out on the HUD's
--     TopRightLeft / TopRightBottom / GiftLeft / GiftTop / GiftSize signals. Children: the Gifts icon and word, Frame "Pip"
--     (a 10 px Sign red square, kit-b U8: an unlocked
--     claim (ClaimView "Claim" / "Repair") or a ready play tier, >= Config.Daily.PipDelaySeconds after the last
--     CharacterAdded, the tutorial at its spin step or later), a 0.4 s shake when a play tier becomes Ready in a payload
--     that is not the first after a join / Loading one. (U9-4 look review: the bar census) Frame "PlayBar" in the block's
--     lip (attribute Fill = Play.Seconds / the next tier's seconds, Filled, Paused): K.BAR_SEGS blocks with K.BAR_GAP px
--     of lip between them, the first floor(Fill x BAR_SEGS) gold (the gold lip while Play.Active == false, never alpha),
--     the rest the lip's pink: the kit's block bar (it replaced a gradient-swept gold outline round the block). The
--     button and the pip stay where they were before the window redo.
--   * The window: Frame "DailyHolder" (UIScale "Fit") centred in its NeonKit.BigRect box (RECT 820 x 330 at 390 px high ->
--     1180 x 720 at 1080 px; MARGIN 12, PHONE_W 900, SHORT 560, PC_MIN_H 600, PC_MAX_W 0.76: an 820 x 330 box at 12,59 on a
--     844 x 390 phone, "Phone" at scale 1; "PC" at the screen factor; a phone box taller than wide is "Portrait"). The PC
--     layout is computed in the design box (box px / scale) with card A's 1080p numbers as its largest form. Inside:
--     "DailyWindow" (kit-b U9-4, finding 15: the Signboard kit of the Shop; the wood frame round "Stone", the stone body
--     with its lip; UIScale "Pop" for the 0.22 s Back-Out open) > "TitleBar" (the navy header plank with its lip: Tab_Daily
--     "Daily", Tab_Play "Play time" as blocks on their Tab_*Fill frames, stone, the selected one gold; the red CloseButton
--     block: 56 px PC / 44 px phone, its X drawn by NeonKit.CloseMark, header 76 / 50), "Roof" (SignKit.Roof: the awning
--     at a fixed K.ROOF_W, never stretched; PC, and (U9-4 look review) the portrait window at K.ROOF_PHONE_W under clear
--     sky; a portrait window's band holds the gift, GIFTS and the close, its two tabs their own row under it) and "Body" > DailyPage, PlayPage, Fx. While open on a phone (or a touch-only device) Roblox's stick and jump are hidden (MenuController.
--     SetTouchHidden("Daily", on)), the menu tiles step aside (MenuController.SetColumnCovered(windowLeft, "Daily")) and
--     the HUD's vitals card hides (HudController.SetVitalsHidden("Daily", on): the window's edge would cut it on PC).
--   * DailyPage (card A): Header "Day 3 of 7 . Week 2" (the middle dot; a plain Section title, the owner's ruling
--     2026-11-14), StreakChip "Streak: 9 days" (phone "Streak: 9"; hidden at 0) and VipChip "VIP x2" (VIP only) as square
--     tags (stone, VIP gold); Cells > Cell1..7 kit B blocks (NeonKit.Card Skin "Sign", the day's DAY_COLORS on its lip,
--     CELL_LOOK: stone, today gold, claimed the sunk well; Day "Day n" or
--     "TODAY" while today's gift is due, Art (glyph or the Week Wisp's PetViewport), Amount, Dim, Check: a big tick on a
--     claimed tile; attributes Claimed / Today / Pulsing). (Pitch 2 item 09_daily_layout B, "Prize stand") Days 1-6 are
--     one row; Day 7 is the prize card right of it (the Week Wisp on its Plinth, its name on the Amount wood plank, Species
--     "Epic Owl . Storm", and the week's own countdown inside it); today is raised 8 px (same bottom; never the prize card),
--     gold, its ink edge pulsing; a Repair payload's today tile reads "Repair" with the Repair glyph. WispText (in the
--     card) "in N more days" (N = 7 - Cell; "in 1 more day"; Cell 7: "Yours today!") over WispBar (Seg1..7, attribute
--     State = "Claimed" | "Today" | "Open": grass, gold, the well). ClaimButton (the page's one green plank under the day
--     row: PC 400 x 96, phone 230 x 64; portrait the grid's width): "Claim!", or "Repair streak (no gift)" on the wider
--     repair button; locked: the Off block, disabled,
--     its Line1 / Line2 labels say why (ClaimView). Countdown takes its place while waiting ("Next gift in ...", "Getting
--     your gifts ready..."). Keep beside it ("Claim today's gift to keep your streak!" while the claim is due, "Come back
--     tomorrow to keep your streak!" while waiting; not while loading / stale). WeekBanner "WEEK DONE! Week Wisp is yours!"
--     (a gold block) covers the card's species and week lines for 4.5 s. Portrait: the prize card on top (the pet left),
--     Days 1-6 a 3 x 2 grid under it, the Claim the grid's width and the keep line under it, the chips under the header.
--   * PlayPage (card B, gui-redo Task 10, spec 5.4): PlayHeader "47 min played today . Resets in 5h" (phone / portrait "47
--     min today . Resets in 5h"; the minutes are live: Play.Seconds + the time since ServerNow while Active), or in red ink
--     "Paused: move around to keep counting!" while Play.Active == false (a touch-only device: "Paused: close this and
--     move around!", the stick is hidden while the window is open). ClaimAll "Claim all (n)" (the page's one green plank; n = the Ready tiers that
--     pay something now: a full Berry Basket, Amount 0, is left to its own box, which reads "Basket is full"; PC
--     252 x 60, phone 166 x 44 at the top right, portrait centred under the header): DailyRequest("ClaimPlayAll"), greyed
--     out at 0 in the same place. Tiers > Tier1..7 gift boxes (kit B blocks, TIER_COLORS on the lip; attributes State = "Ready" |
--     "Claimed" | "Locked", Pulsing): Time "10 min" on top, Gift (Block: the HUD button's pink gift block with the "Gifts" icon;
--     attribute Bobbing: a Ready box's gift bobs and its border pulses on the 1 s tick), Reward (the resolved amount; on a
--     box narrower inside than WRAP_BELOW it takes two lines: "Berry" / "Basket"; look review 2: a currency on its role's
--     tag, attribute Role, the coin / gem KindIcon before the amount), and one slot: Claim
--     (a stone "Claim" plank: DailyRequest("ClaimPlay", i)), Clock (+ ClockGlyph, a PixelIcon clock, when it fits: TierCountdown, on the 1 s tick) or
--     Check (claimed: a big tick over the Dim). PC: 260 x 250 boxes at 1080p, four on top and three under, both rows
--     centred (the rows slide from PlayCompact to PlayFull with the body); phone: seven 104 x 204 boxes in one row; portrait:
--     four a row, row 2 centred. Fx: the week's 24 Confetti frames (skipped on Low; kit-b U9-4, finding 26: flat bits in the
--     kit's colours by role, K.CONFETTI_COLORS: the prize's gold and the gift's pink with their lips; no rainbow, no sweep).
--   * A grown claimed set pops the cell or box (1.15 -> 1, 0.25 s) with SoundFx "Reward" (once per payload: Claim all
--     pops every box it claimed with one sound); a paid week (Weeks rose with the Streak
--     onto a multiple of 7; a repair claim back onto day 7 leaves Weeks alone and celebrates nothing): the
--     confetti, the banner, SoundFx "DailyWeek"; StepBack > 0: the side hint "Welcome back! You stepped back n day(s).
--     Keep going!" once per claim (MenuController.Hint: it can arrive while the window is closed).
--   * A payload past its StaleAt (re-review 2) no longer says what the claim does: no gold today tile, no claim button,
--     "Getting your gifts ready..." until DailyService's fresh payload (its tick re-sends one at StaleAt).
--   * Closes on X, Esc, gamepad B (bound only while open), InMatch / InBattle, and any other WindowOpened id. A screen
--     change while open lays the open window out again at once (it is built once and re-laid out, never rebuilt).
--   * Texts that would not fit their cell (TextService measures the real font) fall back to a shorter form: a pet's last
--     word ("Week Wisp" -> "Wisp"), "Full Berry Basket" -> "Berry Basket" -> "Full Basket", big numbers as "$1.2M".
-- Art: glyph fallbacks (NeonKit.Icon: "Gifts", "Cash", "Tokens", "Gems"); Config.Icons swaps in the uploaded images later.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles. Glyphs are UTF-8 byte escapes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TextService = game:GetService("TextService")
local GuiService = game:GetService("GuiService")

