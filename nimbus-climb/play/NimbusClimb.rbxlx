-- the left block of every row: pet disc, name (+ stars), "Lv 12 / 100", where it is
function H.rowHead(f, row, def)
	local disc, holder = H.petDisc(f, def, K.VIEW)
	disc.Position = UDim2.fromOffset(10, 10)
	row.Disc = disc
	row.ViewHolder = holder
	row.Name = H.text(f, "Name", "", "Title", 23, H.rarityText(def), {
		Position = UDim2.fromOffset(K.VIEW + 22, 6),
		Size = UDim2.new(0, 300, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	row.Level = H.text(f, "Level", "", "Heading", 19, WHITE, {
		Position = UDim2.fromOffset(K.VIEW + 22, 38),
		Size = UDim2.fromOffset(140, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	row.Where = H.text(f, "Where", "", "Heading", 18, MUTED, {
		Position = UDim2.fromOffset(K.VIEW + 166, 39),
		Size = UDim2.new(0, 260, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

function H.paintHead(row, key, def, home)
	local level = H.level(key)
	local cap = H.cap(def, key)
	local stage = H.stage(key)
	local stars = H.stars(stage)
	row.Name.Text = H.name(key, def) .. (stars ~= "" and ("  " .. stars) or "")
	row.Level.Text = "Lv " .. level .. " / " .. cap
	row.Level.TextColor3 = level >= cap and GOLD or WHITE
	local where, color = H.whereText(key, home)
	row.Where.Text = where or ""
	row.Where.TextColor3 = color
	return level, cap, stage
end

function H.newFeedRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.inset(U.FeedList, "Feed_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	row.Bar = CloudUI.Bar({
		Name = "XpBar",
		Position = UDim2.fromOffset(K.VIEW + 22, 70),
		Size = UDim2.new(0, 360, 0, 28),
		Height = 28,
		TextSize = 18,
		Color = XP,
		Parent = f,
	})
	local buttons = H.frame(f, "Buttons", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(K.BUTTONS_W, 60),
	})
	row.Buttons = buttons
	H.list(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	row.Feed = H.button(buttons, "Feed", "Feed", "Green", UDim2.fromOffset(240, 58), 20, function()
		H.feed(key)
	end)
	row.Feed.LayoutOrder = 1
	-- (Phase 5: no "Level up" button: ONE Feed button = one feed)
	row.Evolve = H.button(buttons, "Evolve", "EVOLVE!", "Gold", UDim2.fromOffset(122, 58), 20, function()
		CareController.ConfirmEvolve(key)
	end)
	row.Evolve.LayoutOrder = 3
	for _, b in ipairs({ row.Feed, row.Evolve }) do
		H.twoLine(b)
	end
	H.layoutFeedRow(row)
	return row
end

function H.layoutFeedRow(row)
	local stacked, short = S.Stacked, S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local h
	if stacked then
		h = short and K.ROW_H_SHORT_STACKED or K.ROW_H_STACKED
		if S.Tall then
			h = h + 22
		end
	else
		h = short and K.ROW_H_SHORT or K.ROW_H
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 128, short and 35 or 39)
	local barY = short and 62 or 70
	if stacked then
		row.Name.Size = UDim2.new(1, -(x + 10), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138), 0, 24)
		if S.Tall then
			-- portrait: "Lv 57 / 100" and where it is get a line each, the bar under them
			row.Where.Position = UDim2.fromOffset(x, 62)
			row.Where.Size = UDim2.new(1, -(x + 10), 0, 24)
			barY = 90
		end
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + 12), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(0.5, 1)
		row.Buttons.Position = UDim2.new(0.5, 0, 1, -8)
		row.Buttons.Size = UDim2.new(1, -20, 0, 60)
	else
		local right = K.BUTTONS_W + 20
		row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138 + right), 0, 24)
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + right), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(1, 0.5)
		row.Buttons.Position = UDim2.new(1, -10, 0.5, 0)
		row.Buttons.Size = UDim2.fromOffset(K.BUTTONS_W, 60)
	end
	-- stacked rows: the Feed button takes the row (70% beside EVOLVE when the pet is ready)
	local bh = short and 50 or 58
	if stacked then
		row.Feed.Size = UDim2.new(row.Ready and 0.68 or 1, row.Ready and -6 or 0, 0, bh)
		row.Evolve.Size = UDim2.new(0.32, -4, 0, bh)
		row.Buttons.Size = UDim2.new(1, -20, 0, bh + 2)
	else
		row.Feed.Size = UDim2.fromOffset(row.Ready and 300 or 430, 58)
		row.Evolve.Size = UDim2.fromOffset(128, 58)
	end
end

function H.paintFeedRow(row, home, cash)
	local key, def = row.Key, row.Def
	local level, cap = H.paintHead(row, key, def, home)
	local _, xp = H.level(key)
	local need = H.xpToNext(level)
	local capped = level >= cap
	if capped then
		row.Bar.SetFraction(1)
		row.Bar.SetText("MAX LEVEL")
		row.Bar.SetColor(GOLD)
	else
		row.Bar.SetFraction(need > 0 and need < math.huge and math.min(1, xp / need) or 0)
		row.Bar.SetText(H.commas(xp) .. " / " .. H.commas(need) .. " XP")
		row.Bar.SetColor(XP)
	end
	-- Phase 5 (3.4): ONE Feed button: "Feed  340 berries  (+90 XP)"; grey (still says why when pressed) while the
	-- basket is short or the machine is not built
	local machine = H.station(home, "Kitchen")
	local busy = H.inMatch()
	local one = H.berryFeed(key, def, level, machine)
	row.Cost = one.Cost
	if capped then
		row.Feed.Text = "Max level"
		CloudUI.SetStyle(row.Feed, "Gray")
		CloudUI.SetDisabled(row.Feed, true)
	elseif machine < 1 then
		row.Feed.Text = "Feed (build the Food Machine)"
		CloudUI.SetStyle(row.Feed, "Gray")
		CloudUI.SetDisabled(row.Feed, busy)
	else
		row.Feed.Text = "Feed  " .. H.commas(one.Cost) .. " berries  (+" .. H.commas(one.Xp) .. " XP)"
		CloudUI.SetStyle(row.Feed, H.berries() >= one.Cost and "Green" or "Gray")
		CloudUI.SetDisabled(row.Feed, busy)
	end
	-- EVOLVE when ready
	local nextStage = H.canEvolve(key, def, level)
	row.Evolve.Visible = nextStage ~= nil
	row.Evolve.Text = S.Tall and "EVOLVE" or "EVOLVE!"
	if (row.Ready ~= nil) ~= (nextStage ~= nil) then
		row.Ready = nextStage
		H.layoutFeedRow(row)
	end
	row.Ready = nextStage
	CloudUI.SetDisabled(row.Evolve, busy)
	if row.Frame then
		local edge = row.Frame:FindFirstChildOfClass("UIStroke")
		if edge then
			edge.Color = nextStage and GOLD or WELL_EDGE
			edge.Transparency = nextStage and 0 or 0.15
		end
	end
end

function H.newGardenRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.inset(U.GardenList, "Pick_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	local info = H.frame(f, "Info", { Position = UDim2.fromOffset(K.VIEW + 22, 70), Size = UDim2.new(1, -(K.VIEW + 220), 0, 30) })
	row.Info = info
	row.InfoLayout = H.list(info, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	row.InfoLayout.Wraps = true
	local role = type(def.Role) == "string" and def.Role or "Combat"
	local mult = H.call(PetCatalog, "RoleMultiplier", def) or 1
	row.RoleText = role .. (mult > 1.001 and (" x" .. tostring(math.floor(mult * 10 + 0.5) / 10)) or "")
	row.RoleShort = role
	row.Role = H.pill(info, "Role", row.RoleText, ROLE_COLORS[role] or Theme.Buttons.Blue, 18, 1)
	row.Coins = H.pill(info, "Coins", "Coins $0/s", Theme.Darken(CASH, 0.2), 18, 2)
	row.Put = H.button(f, "PutHere", "Put here", "Green", UDim2.fromOffset(170, 56), 21, function()
		if S.Slot then
			H.fire("garden", "HomeAction", "GardenSet", { Slot = S.Slot, Key = key })
		end
	end)
	row.Put.AnchorPoint = Vector2.new(1, 0.5)
	row.Put.Position = UDim2.new(1, -12, 0.5, 0)
	H.layoutSimpleRow(row)
	return row
end

function H.layoutSimpleRow(row)
	local short = S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local stacked = S.Tall or S.Short
	local h = short and K.ROW_H_SHORT or K.ROW_H
	if stacked then
		h = h + 52 + 34 -- the button under the pills, the pills on two lines
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	local right = stacked and 10 or 200
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 144, short and 35 or 39)
	row.Where.Size = UDim2.new(1, -(x + 154 + right), 0, 24)
	row.Info.Position = UDim2.fromOffset(x, short and 64 or 70)
	row.Info.Size = UDim2.new(1, -(x + right), 0, stacked and 66 or 30)
	if stacked then
		row.Put.AnchorPoint = Vector2.new(1, 1)
		row.Put.Position = UDim2.new(1, -12, 1, -8)
		row.Put.Size = UDim2.fromOffset(170, 48)
	else
		row.Put.AnchorPoint = Vector2.new(1, 0.5)
		row.Put.Position = UDim2.new(1, -12, 0.5, 0)
		row.Put.Size = UDim2.fromOffset(170, 56)
	end
end

function H.paintGardenRow(row, home)
	local key, def = row.Key, row.Def
	H.paintHead(row, key, def, home)
	row.Role.Text = S.Tall and row.RoleShort or row.RoleText
	row.Coins.Text = "Coins " .. H.rate(H.coinsPerSecond(key, def, home)) .. "/s"
	local placed = #H.gardenSlots(home, key)
	local here = S.Slot and type(home.Garden) == "table" and home.Garden[S.Slot] == key
	local free = H.owned(key) - placed
	local training = H.job(key) ~= nil
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	if here then
		row.Put.Text = "Here now"
	elseif training then
		row.Put.Text = "Training"
	elseif free <= 0 then
		row.Put.Text = "In Garden"
	else
		row.Put.Text = "Put here"
	end
	CloudUI.SetDisabled(row.Put, here or training or free <= 0 or H.inMatch() or not S.Slot or S.Slot > open)
	return (here or training or free <= 0) and 1 or 0
end

function H.newTrainRow(key, def)
	local row = { Key = key, Def = def }
	local f = Util.Create("TextButton", {
		Name = "Train_" .. key,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = INSET,
		BackgroundTransparency = 0.42,
		Size = UDim2.new(1, 0, 0, K.TRAIN_ROW_H),
		Parent = U.TrainList,
	})
	H.corner(f, 12)
	row.Edge = H.stroke(f, WELL_EDGE, 3, 0.15)
	row.Frame = f
	f.Activated:Connect(function()
		S.TrainKey = key
		H.refresh()
	end)
	local disc, holder = H.petDisc(f, def, 64)
	disc.Position = UDim2.fromOffset(8, 10)
	row.Disc = disc
	row.ViewHolder = holder
	row.Name = H.text(f, "Name", "", "Title", 21, H.rarityText(def), {
		Position = UDim2.fromOffset(82, 6),
		Size = UDim2.new(1, -90, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	row.Level = H.text(f, "Level", "", "Heading", 18, WHITE, {
		Position = UDim2.fromOffset(82, 34),
		Size = UDim2.new(1, -90, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	row.Where = H.text(f, "Where", "", "Heading", 18, MUTED, {
		Position = UDim2.fromOffset(82, 56),
		Size = UDim2.new(1, -90, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return row
end

function H.paintTrainRow(row, home)
	H.paintHead(row, row.Key, row.Def, home)
	local selected = row.Key == S.TrainKey
	row.Edge.Color = selected and GOLD or WELL_EDGE
	row.Edge.Transparency = selected and 0 or 0.15
	row.Frame.BackgroundTransparency = selected and 0.2 or 0.42
end

----------------------------------------------------------------------
-- refresh
----------------------------------------------------------------------
-- a keyed list: drop the rows of pets that are gone, add new ones, order the rest
function H.syncRows(map, keys, make)
	local want = {}
	for i, key in ipairs(keys) do
		want[key] = i
	end
	for key, row in pairs(map) do
		if not want[key] then
			H.dropRow(row)
			map[key] = nil
		end
	end
	for i, key in ipairs(keys) do
		local row = map[key]
		if not row then
			local def = H.def(key)
			if def then
				row = make(key, def)
				map[key] = row
			end
		end
		if row then
			row.Frame.LayoutOrder = i
			-- a pet that evolved meanwhile gets its new form
			if row.ViewReady and row.ViewStage ~= H.stage(key) then
				if row.View then
					pcall(row.View.Destroy)
					row.View = nil
				end
				row.ViewReady = false
			end
			H.queueView(row)
		end
	end
end

-- Feed order: garden pets (by place), then followers (equipped order), then the rest (rarest first)
function H.feedOrder(home)
	local keys = H.ownedKeys()
	local rank = {}
	local garden = type(home.Garden) == "table" and home.Garden or {}
	local slots = {}
	for slot in pairs(garden) do
		if type(slot) == "number" then
			slots[#slots + 1] = slot
		end
	end
	table.sort(slots)
	local n = 0
	for _, slot in ipairs(slots) do
		local k = garden[slot]
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	for _, k in ipairs(H.equippedList()) do
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	local out = {}
	for i, k in ipairs(keys) do
		out[i] = k
		if not rank[k] then
			rank[k] = 1000 + i
		end
	end
	table.sort(out, function(a, b)
		return rank[a] < rank[b]
	end)
	-- the pet the window was opened for comes first
	if S.Focus then
		for i, k in ipairs(out) do
			if k == S.Focus then
				table.remove(out, i)
				table.insert(out, 1, k)
				break
			end
		end
	end
	return out
end

function H.refreshFeed(home, cash)
	local keys = H.feedOrder(home)
	H.syncRows(U.Rows, keys, H.newFeedRow)
	for _, row in pairs(U.Rows) do
		H.paintFeedRow(row, home, cash)
	end
	U.FeedEmpty.Visible = #keys == 0
	U.FeedEmpty.Text = "No pets yet! Spin a roulette in the Shop to hatch one."
	-- how it works (the kid rule, 3.4), always the same words
	U.Leftovers.Text = G.Berry .. " Each Feed turns berries into XP. Your garden pets grow more berries!"
	local level = H.station(home, "Kitchen")
	local shares = TycoonCatalog and TycoonCatalog.FeedShare or {}
	local def = H.call(TycoonCatalog, "Get", "Kitchen")
	local maxLevel = def and def.MaxLevel or #shares
	local pad = H.kitchenPad(home)
	local pct = function(l)
		return math.floor((tonumber(shares[l]) or 0) * 100 + 0.5) .. "%"
	end
	local text
	if level < 1 then
		text = "Build the Food Machine at home first: each feed then fills " .. pct(1) .. " of a pet's XP bar."
		if pad and not pad.Locked then
			text = text .. " Build it: " .. H.money(pad.Price)
		end
	elseif level >= maxLevel then
		text = "Food Machine Lv " .. level .. " (max): each feed fills " .. pct(level) .. " of the bar."
	else
		text = "Food Machine Lv " .. level .. ": each feed fills " .. pct(level) .. " of the bar."
		if pad and not pad.Locked then
			text = text .. " Upgrade to Lv " .. (level + 1) .. " (" .. pct(level + 1) .. "): " .. H.money(pad.Price)
		elseif pad and pad.Locked then
			text = text .. " Lv " .. (level + 1) .. ": " .. tostring(pad.Locked)
		end
	end
	if S.Short then
		-- landscape phones: the short form (the footer has one line pair)
		text = level < 1 and "Build the Food Machine first" or ("Food Machine Lv " .. level .. ": feeds fill " .. pct(level))
	end
	U.Machine.Text = text
	local canBuy = pad ~= nil and not pad.Locked and level < maxLevel
	U.Upgrade.Visible = canBuy
	U.Upgrade.Text = level < 1 and "Build" or "Upgrade"
	CloudUI.SetDisabled(U.Upgrade, not canBuy or cash < (tonumber(pad and pad.Price) or 0) or not H.hasHome() or H.inMatch())
	-- the Berry Basket header: "1,240 / 3,000 berries" + "(+750 a minute)"
	local berries = H.berries()
	local plot = H.plot()
	local cap = plot and plot:GetAttribute("BerryCap")
	local income = plot and plot:GetAttribute("IncomePerSecond")
	local share = (TycoonCatalog and type(TycoonCatalog.Berries) == "table" and tonumber(TycoonCatalog.Berries.Share)) or 0.25
	if type(cap) == "number" and cap > 0 then
		U.Basket.SetFraction(math.min(1, berries / cap))
		U.Basket.SetText("Berry Basket " .. H.commas(berries) .. " / " .. H.commas(math.floor(cap)))
	else
		U.Basket.SetFraction(berries > 0 and 1 or 0)
		U.Basket.SetText("Berry Basket " .. H.commas(berries))
	end
	U.BasketRate.Text = (type(income) == "number" and income > 0) and ("+" .. H.commas(math.floor(income * share * 60 + 0.5)) .. " a minute") or ""
	U.Info.Text = ""
end

function H.kitchenPad(home)
	for _, p in ipairs(H.call(TycoonCatalog, "AvailablePads", home) or {}) do
		if type(p) == "table" and p.StationId == "Kitchen" then
			return p
		end
	end
	return nil
end

function H.upgradeMachine()
	if H.inMatch() then
		return
	end
	if not H.hasHome() then
		H.hint("Claim a home first: press E at a free gate.", "info")
		return
	end
	H.fire("upgrade", "HomeAction", "Upgrade", "Kitchen")
end

function H.refreshGarden(home)
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	local slot = S.Slot
	local keys = H.ownedKeys()
	H.syncRows(U.GardenRows, keys, H.newGardenRow)
	-- the pets that can go here first (then the busy ones)
	local busy = {}
	for _, row in pairs(U.GardenRows) do
		busy[row.Key] = H.paintGardenRow(row, home)
	end
	local order = {}
	for i, k in ipairs(keys) do
		order[i] = k
	end
	local index = {}
	for i, k in ipairs(keys) do
		index[k] = i
	end
	table.sort(order, function(a, b)
		local x, y = busy[a] or 0, busy[b] or 0
		if x ~= y then
			return x < y
		end
		return index[a] < index[b]
	end)
	for i, k in ipairs(order) do
		if U.GardenRows[k] then
			U.GardenRows[k].Frame.LayoutOrder = i
		end
	end
	local current = slot and type(home.Garden) == "table" and home.Garden[slot] or nil
	U.GardenPlace.Text = slot and ("Garden place " .. slot .. (open > 0 and ("  (" .. open .. " open)") or "")) or "Pet Garden"
	if current and type(current) == "string" then
		U.GardenNow.Text = "Now here: " .. H.name(current) .. ". Pick a pet to swap, or take it out."
	elseif slot and slot > open then
		U.GardenNow.Text = G.Lock .. " This place opens with a Prestige."
	else
		U.GardenNow.Text = "Pick a pet: it eats at the Food Bowl and poops Cloud Cash."
	end
	U.TakeOut.Visible = type(current) == "string"
	CloudUI.SetDisabled(U.TakeOut, H.inMatch())
	U.Info.Text = "Every pet can work here: it eats at the Food Bowl and poops Cloud Cash!"
end

function H.refreshTrain(home, cash)
	-- the pets in training first (their timers), then the followers, then the rest (rarest first)
	local keys = H.ownedKeys()
	local rank = {}
	local equipped = {}
	for _, k in ipairs(H.equippedList()) do
		equipped[k] = true
	end
	for i, k in ipairs(keys) do
		rank[k] = (H.job(k) and 0 or (equipped[k] and 1000 or 2000)) + i
	end
	table.sort(keys, function(a, b)
		return rank[a] < rank[b]
	end)
	H.syncRows(U.TrainRows, keys, H.newTrainRow)
	local valid = false
	for _, k in ipairs(keys) do
		if k == S.TrainKey then
			valid = true
		end
	end
	if not valid then
		S.TrainKey = keys[1]
		-- prefer a pet that is training (its timer), else the first follower
		for _, k in ipairs(keys) do
			if H.job(k) then
				S.TrainKey = k
				break
			end
		end
	end
	for _, row in pairs(U.TrainRows) do
		H.paintTrainRow(row, home)
	end
	local level = H.station(home, "Gym")
	local slots = H.call(TycoonCatalog, "TrainingSlots", home) or 0
	local busyCount = 0
	for _, k in ipairs(keys) do
		if H.job(k) then
			busyCount = busyCount + 1
		end
	end
	-- (a job can also belong to a pet copy no longer in the list: count the growth map)
	local okMap, map = pcall(State.PetGrowthMap)
	if okMap and type(map) == "table" then
		local n = 0
		for _, e in pairs(map) do
			if type(e) == "table" and type(e.Job) == "table" then
				n = n + 1
			end
		end
		busyCount = math.max(busyCount, n)
	end
	local key = S.TrainKey
	local def = key and H.def(key)
	local hasPet = def ~= nil
	U.TrainEmpty.Visible = not hasPet
	U.TrainEmpty.Text = "No pets yet! Spin a roulette in the Shop to hatch one."
	U.TrainName.Visible = hasPet
	U.TrainSpots.Visible = hasPet
	U.SkillList.Visible = hasPet
	if level < 1 then
		U.Info.Text = "Build the Training Place at home first. Training makes pets tougher in battles!"
	else
		U.Info.Text = "Train a skill: Rank 3 takes 3 minutes. Training pets rest at home until they're done!"
	end
	if not hasPet then
		U.TimerRow.Visible = false
		return
	end
	local stage = H.stage(key)
	local lv = H.level(key)
	U.TrainName.Text = H.name(key, def) .. "  " .. G.Bullet .. "  Lv " .. lv .. " / " .. H.cap(def, key) .. (stage > 0 and ("  " .. H.stars(stage)) or "")
	U.TrainName.TextColor3 = H.rarityText(def)
	if level < 1 then
		U.TrainSpots.Text = G.Lock .. " No Training Place yet"
	else
		U.TrainSpots.Text = "Training spots: " .. busyCount .. " / " .. slots .. " in use"
	end
	local job = H.job(key)
	U.TimerRow.Visible = job ~= nil
	local g = H.growth(key)
	if job then
		local total = tonumber(H.call(TycoonCatalog, "TrainSeconds", job.Rank)) or 60
		local left = math.max(0, (tonumber(job.Ends) or 0) - H.now())
		U.TrainTimer.SetFraction(total > 0 and math.min(1, 1 - left / total) or 1)
		if S.Tall then
			U.TrainTimer.SetText("Rank " .. tostring(job.Rank) .. ": " .. H.clock(left) .. " left")
		else
			U.TrainTimer.SetText(H.skillName(job.Stat) .. " Rank " .. tostring(job.Rank) .. ": " .. H.clock(left) .. " left")
		end
	end
	local top = S.Short and 44 or 72
	U.TimerRow.Position = UDim2.fromOffset(14, top)
	if job then
		top = top + 56
	end
	U.SkillList.Position = UDim2.fromOffset(8, top + 2)
	U.SkillList.Size = UDim2.new(1, -16, 1, -(top + 10))
	CloudUI.SetDisabled(U.StopTraining, H.inMatch())
	U.TrainSpots.Visible = not S.Short
	local maxRank = (TycoonCatalog and TycoonCatalog.Training and TycoonCatalog.Training.MaxRank) or 10
	for _, skill in ipairs(SKILLS) do
		local row = U.Skills[skill.Id]
		local rank = math.max(0, math.floor(tonumber(g[skill.Id]) or 0))
		row.Rank.Text = "Rank " .. rank .. "/" .. maxRank
		for p, pip in ipairs(row.Pips) do
			if p <= rank then
				pip.BackgroundColor3 = Theme.Lighten(ACCENTS.Train, 0.25)
			elseif job and job.Stat == skill.Id and p == rank + 1 then
				pip.BackgroundColor3 = PURPLE
			else
				pip.BackgroundColor3 = Color3.fromRGB(14, 20, 52)
			end
		end
		local maxed = rank >= maxRank
		row.Max.Visible = maxed
		row.Button.Visible = not maxed
		if maxed then
			row.Cost.Text = ""
		else
			local cost = H.call(TycoonCatalog, "TrainCost", def, rank + 1) or 0
			local seconds = H.call(TycoonCatalog, "TrainSeconds", rank + 1) or 60
			row.Cost.Text = "Rank " .. (rank + 1) .. ": " .. H.money(cost) .. ", " .. H.minutes(seconds)
			row.Cost.TextColor3 = cash < cost and Theme.Lighten(BAD, 0.35) or CASH
			row.Price = cost
			local reason = nil
			if job then
				reason = "busy"
			elseif level < 1 then
				reason = "no station"
			elseif busyCount >= slots then
				reason = "full"
			elseif cash < cost then
				reason = "cash"
			end
			row.Button.Text = (job and job.Stat == skill.Id) and "Training" or "Train"
			CloudUI.SetDisabled(row.Button, reason ~= nil or H.inMatch())
		end
	end
end

function H.refresh()
	if not S.Built then
		return
	end
	local home = H.home()
	local cash = H.cash()
	U.CashChip.Text = H.money(cash)
	U.Info.TextColor3 = MUTED
	local feedMode = S.Mode == "Feed"
	U.CashChip.Visible = not feedMode and not S.Tall
	U.Info.Visible = not feedMode
	U.Basket.Root.Visible = feedMode
	U.BasketIcon.Visible = feedMode
	U.BasketRate.Visible = feedMode
	U.FeedPage.Visible = S.Mode == "Feed"
	U.GardenPage.Visible = S.Mode == "Garden"
	U.TrainPage.Visible = S.Mode == "Train"
	if S.Mode == "Feed" then
		H.refreshFeed(home, cash)
	elseif S.Mode == "Garden" then
		H.refreshGarden(home)
	elseif S.Mode == "Train" then
		H.refreshTrain(home, cash)
	end
end

-- State.Changed can come in bursts: one refresh per frame at most
function H.refreshSoon()
	if S.RefreshPending then
		return
	end
	S.RefreshPending = true
	task.defer(function()
		S.RefreshPending = false
		if S.Open then
			safe("refresh", H.refresh)
		end
	end)
end

function H.relayout()
	if not S.Built then
		return
	end
	U.Dock.Refresh()
	local rect = U.Dock.Rect
	if not rect then
		return
	end
	local w, h = math.floor(rect.designW + 0.5), math.floor(rect.designH + 0.5)
	if S.Open then
		H.avoidRight(rect.mode == "Side" and rect.x or nil)
	end
	-- "short" (landscape phones): compact rows; "tall" (a narrow window with height): the one-column layouts
	local short = h < K.SHORT
	local tall = (not short) and w < K.TALL_W
	-- every docked Care window is narrow: the Training Place and the garden picker are one column at every size
	local oneCol = tall or short
	local stacked = tall or (w - 48) < K.WIDE
	local changed = short ~= S.Short or stacked ~= S.Stacked or tall ~= S.Tall
	S.Short, S.Stacked, S.Tall = short, stacked, tall
	-- landscape phones: no info line (the list needs the height); portrait: no Cash chip (the info line wraps)
	-- (landscape phones keep the Berry Basket bar in the Food Machine, the other windows drop their info line)
	local topH = short and ((S.Mode == "Feed") and 38 or 0) or K.TOP_H
	U.Top.Visible = topH > 0
	U.Top.Size = UDim2.new(1, -24, 0, topH)
	U.Top.Position = UDim2.fromOffset(12, 8)
	U.CashChip.Visible = not tall
	U.Info.Size = tall and UDim2.new(1, 0, 1, 0) or UDim2.new(1, -220, 1, 0)
	U.Body.Position = UDim2.fromOffset(12, topH + (short and 8 or 16))
	U.Body.Size = UDim2.new(1, -24, 1, -(topH + (short and 16 or 26)))
	-- feed footer
	local footH = short and K.FOOT_H_SHORT or K.FOOT_H
	if tall then
		footH = 150
	end
	U.Leftovers.Visible = not short
	U.Foot.Size = UDim2.new(1, 0, 0, footH)
	U.FeedList.Size = UDim2.new(1, 0, 1, -(footH + 10))
	if tall then
		U.Leftovers.Size = UDim2.new(1, -28, 0, 46)
		U.Leftovers.TextWrapped = true
		U.Leftovers.TextYAlignment = Enum.TextYAlignment.Top
		U.Machine.Size = UDim2.new(1, -28, 0, 50)
		U.Machine.Position = UDim2.fromOffset(14, 54)
		U.Upgrade.AnchorPoint = Vector2.new(1, 1)
		U.Upgrade.Position = UDim2.new(1, -12, 1, -8)
		U.Upgrade.Size = UDim2.fromOffset(170, 46)
	else
		U.Leftovers.TextWrapped = false
		U.Leftovers.Size = UDim2.new(1, -220, 0, 26)
		U.Machine.Size = UDim2.new(1, short and -170 or -220, 0, short and (footH - 12) or (footH - 44))
		U.Machine.Position = UDim2.fromOffset(14, short and 6 or 36)
		U.Upgrade.AnchorPoint = Vector2.new(1, 0.5)
		U.Upgrade.Position = UDim2.new(1, -12, 0.5, 0)
		U.Upgrade.Size = UDim2.fromOffset(short and 150 or 190, short and 48 or 54)
	end
	-- train: one column (the pets on top)
	if oneCol then
		U.TrainList.Size = UDim2.new(1, 0, 0.36, -6)
		U.TrainRight.AnchorPoint = Vector2.new(0, 1)
		U.TrainRight.Position = UDim2.new(0, 0, 1, 0)
		U.TrainRight.Size = UDim2.new(1, 0, 0.64, -6)
	else
		local listW = (w < 900) and math.min(300, math.floor(w * 0.4)) or K.TRAIN_LIST_W
		U.TrainList.Size = UDim2.new(0, listW, 1, 0)
		U.TrainRight.AnchorPoint = Vector2.new(1, 0)
		U.TrainRight.Position = UDim2.new(1, 0, 0, 0)
		U.TrainRight.Size = UDim2.new(1, -(listW + 12), 1, 0)
	end
	local skillH = short and K.SKILL_H_SHORT or K.SKILL_H
	for _, row in pairs(U.Skills) do
		row.Frame.Size = UDim2.new(1, 0, 0, tall and (skillH + 40) or skillH)
		if tall then
			row.Cost.AnchorPoint = Vector2.new(0, 1)
			row.Cost.Position = UDim2.new(0, 12, 1, -14)
			row.Cost.TextXAlignment = Enum.TextXAlignment.Left
			row.Name.Size = UDim2.new(1, -24, 0, 28)
			row.What.Size = UDim2.new(1, -24, 0, 26)
			row.Button.Size = UDim2.fromOffset(130, 46)
		else
			row.Cost.AnchorPoint = Vector2.new(1, 0)
			row.Cost.Position = UDim2.new(1, -12, 0, 8)
			row.Cost.TextXAlignment = Enum.TextXAlignment.Right
			row.Name.Size = UDim2.new(1, -250, 0, 28)
			row.What.Size = UDim2.new(1, -250, 0, 26)
			row.Button.Size = UDim2.fromOffset(150, short and 44 or 50)
		end
		row.What.Visible = not short or tall
	end
	-- the garden header
	U.GardenHead.Size = UDim2.new(1, 0, 0, tall and 118 or 72)
	U.GardenList.Position = UDim2.fromOffset(0, tall and 128 or 82)
	U.GardenList.Size = UDim2.new(1, 0, 1, -(tall and 128 or 82))
	U.GardenPlace.Size = UDim2.new(1, tall and -28 or -220, 0, 30)
	U.GardenNow.Size = UDim2.new(1, tall and -28 or -220, 0, tall and 48 or 26)
	U.GardenNow.TextWrapped = tall
	U.GardenNow.TextYAlignment = Enum.TextYAlignment.Top
	if tall then
		U.TakeOut.AnchorPoint = Vector2.new(1, 1)
		U.TakeOut.Position = UDim2.new(1, -12, 1, -8)
		U.TakeOut.Size = UDim2.fromOffset(160, 44)
	else
		U.TakeOut.AnchorPoint = Vector2.new(1, 0.5)
		U.TakeOut.Position = UDim2.new(1, -12, 0.5, 0)
		U.TakeOut.Size = UDim2.fromOffset(180, 50)
	end
	if changed then
		for _, row in pairs(U.Rows) do
			H.layoutFeedRow(row)
		end
		for _, row in pairs(U.GardenRows) do
			H.layoutSimpleRow(row)
		end
		if S.Open then
			H.refreshSoon()
		end
	end
	H.relayoutConfirm()
end

function H.relayoutConfirm()
	if not U.Confirm then
		return
	end
	local w, h, scale, x, y = H.confirmFit(K.CONFIRM_W, K.CONFIRM_H, 440, 250)
	U.Confirm.Size = UDim2.fromOffset(w, h)
	U.ConfirmFit.Scale = scale
	U.Confirm.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
end

----------------------------------------------------------------------
-- actions
----------------------------------------------------------------------
-- ONE feed (PetCare("Feed", key): the server checks everything again); a short basket or no machine says why here
function H.feed(key)
	if H.inMatch() then
		H.hint("Pets eat at home, after the match.", "info")
		return
	end
	local def = H.def(key)
	if not def then
		return
	end
	local home = H.home()
	local machine = H.station(home, "Kitchen")
	if machine < 1 then
		H.hint("Build the Food Machine at home first", "info")
		return
	end
	local level = H.level(key)
	if level >= H.cap(def, key) then
		return
	end
	local cost = H.berryFeed(key, def, level, machine).Cost
	local have = H.berries()
	if have < cost then
		H.hint("Not enough berries: a feed needs " .. H.commas(cost) .. " (you have " .. H.commas(have) .. "). Your garden pets grow more!", "bad")
		return
	end
	H.fire("feed:" .. key, "PetCare", "Feed", key)
end

function H.showConfirm(spec)
	if not U.Confirm then
		return
	end
	S.Confirm = spec
	U.ConfirmTitle.Text = spec.Title or ""
	U.ConfirmText.Text = spec.Text or ""
	U.ConfirmYes.Text = spec.Yes and (spec.YesText or "Yes") or "OK"
	CloudUI.SetStyle(U.ConfirmYes, spec.Style or "Gold")
	U.ConfirmStroke.Color = spec.Color or GOLD
	U.ConfirmTitle.TextColor3 = spec.Color or GOLD
	U.ConfirmNo.Text = spec.NoText or "Not now"
	H.relayoutConfirm()
	U.Confirm.Visible = true
	local pop = U.Confirm:FindFirstChild("Pop") or Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = U.Confirm:FindFirstChild("Box") })
	pop.Scale = 0.9
	H.tween(pop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	H.syncBack()
end

function H.closeConfirm()
	S.Confirm = nil
	if U.Confirm then
		U.Confirm.Visible = false
	end
	H.syncBack()
end

function H.askTrain(key, stat)
	local def = key and H.def(key)
	if not def then
		return
	end
	if H.inMatch() then
		return
	end
	local g = H.growth(key)
	local rank = math.max(0, math.floor(tonumber(g[stat]) or 0)) + 1
	local cost = H.call(TycoonCatalog, "TrainCost", def, rank) or 0
	local seconds = H.call(TycoonCatalog, "TrainSeconds", rank) or 60
	local name = H.name(key, def)
	H.showConfirm({
		Kind = "Train",
		Title = G.Muscle .. " Train " .. H.skillName(stat) .. "?",
		Text = name .. " goes to Rank " .. rank .. " " .. H.skillName(stat) .. " for " .. H.money(cost) .. ". It takes "
			.. H.minutes(seconds) .. ". " .. name .. " rests at home until it's done, then comes back by itself.",
		YesText = "Train " .. H.money(cost),
		Style = "Green",
		Color = Theme.Lighten(GOOD, 0.2),
		Yes = function()
			H.fire("train", "PetCare", "Train", key, stat)
		end,
	})
end

-- the Cash a Stop gives back: the job's Paid (0 after a Prestige)
function H.paidOf(key)
	local job = H.job(key)
	return type(job) == "table" and tonumber(job.Paid) or 0
end

function H.askStop(key)
	local def = key and H.def(key)
	if not def or not H.job(key) then
		return
	end
	H.showConfirm({
		Kind = "Stop",
		Title = "Stop training?",
		Text = (H.paidOf(key) > 0 and "You get the Cash back, no rank. " or "No rank and no Cash back (it was paid before your Prestige). ")
			.. H.name(key, def) .. " comes back to you right away.",
		YesText = "Stop training",
		NoText = "Keep training",
		Style = "Pink",
		Color = Color3.fromRGB(255, 160, 200),
		Yes = function()
			H.fire("trainstop", "PetCare", "TrainStop", key)
		end,
	})
end

----------------------------------------------------------------------
-- the evolution moment (contract 3.6)
----------------------------------------------------------------------
function H.playerFrame()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

function H.groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then
		ignore[#ignore + 1] = char
	end
	if U.EvoFolder then
		ignore[#ignore + 1] = U.EvoFolder
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- lowest point of a built pet below its root
function H.bottomOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or Vector3.new()
	return rel.Y - size.Y / 2
end

function H.evoFolder()
	if U.EvoFolder and U.EvoFolder.Parent then
		return U.EvoFolder
	end
	local f = Instance.new("Folder")
	f.Name = K.EVO_FOLDER
	f.Parent = Workspace
	U.EvoFolder = f
	return f
end

function H.closeAll()
	CareController.Close()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function H.playEvolution(key, stage)
	local def = H.def(key)
	local PetBuilder = safeRequire("PetBuilder")
	local Fx = H.controller("EvolutionFx")
	local PC = H.controller("PetController")
	stage = math.max(1, math.min(2, math.floor(tonumber(stage) or 1)))
	H.closeAll()
	local fxSeconds = (Fx and H.call(Fx, "Duration", stage)) or 4.6
	local release = function() end
	if PC and type(PC.PlayEvolution) == "function" then
		local ok, fn = pcall(PC.PlayEvolution, key, stage, { Seconds = fxSeconds + K.EVO_REST + 1 })
		if ok and type(fn) == "function" then
			release = fn
		end
	end
	if not (def and PetBuilder and Fx and type(Fx.Play) == "function") then
		release()
		return false
	end
	local okA, fromModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = (stage - 1 > 0) and (stage - 1) or nil })
	local okB, toModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = stage })
	if not (okA and okB and typeof(fromModel) == "Instance" and typeof(toModel) == "Instance" and fromModel.PrimaryPart and toModel.PrimaryPart) then
		release()
		return false
	end
	fromModel.Name = "Evolving_" .. tostring(def.Id)
	toModel.Name = "Evolved_" .. tostring(def.Id)
	local origin, look, char = H.playerFrame()
	local spot = Vector3.new(origin.X, 0, origin.Z) + look * K.EVO_AHEAD
	local ground = H.groundAt(Vector3.new(spot.X, origin.Y + 4, spot.Z), char, origin.Y - 3)
	local pos = Vector3.new(spot.X, ground + K.EVO_HOVER - H.bottomOf(fromModel), spot.Z)
	local pose = CFrame.lookAt(pos, pos - look) -- facing the player
	local folder = H.evoFolder()
	fromModel.Parent = folder
	local okColors, c1, c2 = pcall(PetBuilder.EvolutionColors, def, stage)
	S.Evolving = S.Evolving + 1
	local finished = false
	local function done(model)
		if finished then
			return
		end
		finished = true
		task.delay(K.EVO_REST, function()
			local at = nil
			if typeof(model) == "Instance" and model.PrimaryPart then
				at = model.PrimaryPart.Position
			end
			pcall(release, at)
			if typeof(model) == "Instance" then
				pcall(function()
					model:Destroy()
				end)
			end
			S.Evolving = math.max(0, S.Evolving - 1)
			H.nextEvolution()
		end)
	end
	local okPlay, handle = pcall(Fx.Play, fromModel, toModel, pose, {
		Parent = folder,
		Colors = okColors and { c1, c2 } or nil,
		Stage = stage,
		Ground = ground,
		Confetti = true,
		OnDone = done,
	})
	if not okPlay or type(handle) ~= "table" or handle.Done then
		pcall(function()
			fromModel:Destroy()
			toModel:Destroy()
		end)
		finished = true
		S.Evolving = math.max(0, S.Evolving - 1)
		release()
		return false
	end
	U.EvoHandle = handle
	return true
end

function H.nextEvolution()
	if S.Evolving > 0 then
		return
	end
	local nextOne = table.remove(S.EvoQueue, 1)
	if nextOne then
		safe("evolve", H.playEvolution, nextOne.Key, nextOne.Stage)
	end
end

----------------------------------------------------------------------
-- open / close
----------------------------------------------------------------------
-- HotbarController re-centres the hotbar left of the docked window (6.6); nil when nothing is docked
function H.avoidRight(x)
	local hb = H.controller("HotbarController")
	if hb and type(hb.SetAvoidRight) == "function" then
		pcall(hb.SetAvoidRight, x)
	end
end

-- gamepad B closes the confirm / the window while one is up (bound only then, so it never eats the dash)
function H.syncBack()
	local want = S.Open or S.Confirm ~= nil
	local ContextActionService = game:GetService("ContextActionService")
	if want and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					if S.Confirm then
						H.closeConfirm()
					else
						CareController.Close()
					end
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	elseif not want and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function H.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function CareController.IsOpen()
	return S.Open or S.Confirm ~= nil
end

function CareController.Mode()
	return S.Open and S.Mode or nil
end

function CareController.Evolving()
	return S.Evolving
end

-- the EVOLVE confirm ("Evolve Pebble Pup? +25% to everything") -> PetCare("Evolve", key)
function CareController.ConfirmEvolve(key)
	if not initialized then
		CareController.Init()
	end
	local def = H.def(key)
	if not def or not U.Gui then
		return false
	end
	if H.inMatch() then
		return false
	end
	local level = H.level(key)
	local nextStage = H.canEvolve(key, def, level)
	local name = H.name(key, def)
	if not nextStage then
		local levels = PetCatalog.EvolutionLevels or { 20, 50 }
		local stage = H.stage(key)
		local maxStage = H.call(PetCatalog, "MaxEvolution", def) or 1
		local text
		if stage >= maxStage then
			text = name .. " is fully evolved!"
		else
			text = name .. " evolves at level " .. tostring(levels[stage + 1] or 20) .. " (Lv " .. level .. " now)."
		end
		H.hint(text, "info")
		return false
	end
	-- Phase 5 (3.1): EVOLVE multiplies the level bonus (x1.5 / x1.875), not the stat
	local bonus = tonumber(H.call(PetCatalog, "EvolutionBonusOf", nextStage)) or (nextStage == 2 and 1.875 or 1.5)
	local bonusText = string.format("%.3f", bonus):gsub("0+$", ""):gsub("%.$", "")
	H.showConfirm({
		Kind = "Evolve",
		Key = key,
		Title = G.Sparkle .. " Evolve " .. name .. "?",
		Text = name .. " changes into its " .. (nextStage == 2 and "Evolved II" or "Evolved") .. " form: Level bonus x" .. bonusText
			.. " (battle power, health and coins). It keeps its level.",
		YesText = "EVOLVE!",
		Style = "Gold",
		Color = GOLD,
		Yes = function()
			H.fire("evolve", "PetCare", "Evolve", key)
		end,
	})
	return true
end

function CareController.Open(panelId, args)
	if not initialized then
		CareController.Init()
	end
	if not U.Gui then
		return false
	end
	args = type(args) == "table" and args or {}
	local id = type(panelId) == "string" and panelId:lower() or ""
	if id == "evolve" then
		if type(args.Key) ~= "string" then
			return false
		end
		if S.Evolving > 0 then
			S.EvoQueue[#S.EvoQueue + 1] = { Key = args.Key, Stage = args.Stage }
			return true
		end
		local ok, played = safe("evolve", H.playEvolution, args.Key, args.Stage)
		return ok and played == true
	end
	local mode = (id == "feed" and "Feed") or (id == "garden" and "Garden") or ((id == "train" or id == "training") and "Train") or nil
	if not mode then
		return false
	end
	if H.inMatch() then
		return false
	end
	if not H.buildWindow() then
		return false
	end
	if mode == "Feed" then
		S.Focus = type(args.Key) == "string" and args.Key or nil
	elseif mode == "Garden" then
		local slot = tonumber(args.Slot)
		S.Slot = (slot and slot == math.floor(slot) and slot >= 1) and slot or nil
		if not S.Slot then
			-- no place given: the first open empty one
			local home = H.home()
			local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
			for s = 1, open do
				if type(home.Garden) ~= "table" or home.Garden[s] == nil then
					S.Slot = s
					break
				end
			end
			S.Slot = S.Slot or 1
		end
	elseif mode == "Train" then
		if type(args.Key) == "string" then
			S.TrainKey = args.Key
		end
	end
	local wasOpen = S.Open
	if not wasOpen then
		H.closeOthers()
	end
	if mode ~= S.Mode then
		-- a fresh list order for the new window (the viewports are kept per row)
		if U.FeedList then
			U.FeedList.CanvasPosition = Vector2.new(0, 0)
		end
	end
	S.Mode = mode
	S.Open = true
	S.Token = S.Token + 1
	U.Panel.SetTitle(TITLES[mode])
	if U.Panel.SetAccent then
		pcall(U.Panel.SetAccent, ACCENTS[mode])
	end
	H.relayout()
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 0.86
		H.tween(U.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if U.Dock and U.Dock.Rect then
		H.avoidRight(U.Dock.Rect.mode == "Side" and U.Dock.Rect.x or nil)
	end
	safe("refresh", H.refresh)
	H.syncBack()
	-- timers tick while the window is open
	local mine = S.Token
	task.spawn(function()
		while S.Open and S.Token == mine do
			task.wait(K.TICK)
			if S.Open and S.Token == mine and (S.Mode == "Train" or S.Mode == "Feed" or S.Mode == "Garden") then
				safe("tick", H.refresh)
			end
		end
	end)
	CareController.Opened:Fire(mode)
	return true
end

function CareController.Close()
	if S.Confirm then
		H.closeConfirm()
	end
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	H.syncBack()
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	H.avoidRight(nil)
	CareController.Closed:Fire()
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function H.onPrompt(prompt)
	if typeof(prompt) ~= "Instance" or prompt.Name ~= "GardenSpotPrompt" then
		return
	end
	local owner = prompt:GetAttribute("OwnerUserId")
	if owner ~= nil and LocalPlayer and owner ~= LocalPlayer.UserId then
		return -- someone else's garden (HomeFx hides those prompts anyway)
	end
	CareController.Open("Garden", { Slot = prompt:GetAttribute("Slot") })
end

function H.onOpenPanel(panelId, args)
	if type(panelId) ~= "string" then
		return
	end
	args = type(args) == "table" and args or {}
	local id = panelId:lower()
	if id == "train" or id == "training" or id == "evolve" then
		CareController.Open(panelId, args)
	elseif id == "feed" then
		CareController.Open("Feed", args)
	elseif id == "pets" and (args.Action == "Feed" or args.Action == "Garden") then
		CareController.Open(args.Action, args)
	end
end

function H.connectOthers()
	local function hook(name, signalName)
		local mod = H.controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				CareController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
end

function CareController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusCare", K.DISPLAY_ORDER)
	H.buildConfirm()
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", H.relayout)
		safe("relayout confirm", H.relayoutConfirm)
	end)
	State.Changed:Connect(function()
		if S.Open then
			H.refreshSoon()
		end
	end)
	if type(State.BerriesChanged) == "table" and type(State.BerriesChanged.Connect) == "function" then
		State.BerriesChanged:Connect(function()
			if S.Open then
				H.refreshSoon()
			end
		end)
	end
	if type(State.CashChanged) == "table" and type(State.CashChanged.Connect) == "function" then
		State.CashChanged:Connect(function()
			if S.Open then
				H.refreshSoon()
			end
		end)
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				CareController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape then
			if S.Confirm then
				H.closeConfirm()
			elseif S.Open then
				CareController.Close()
			end
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", H.onPrompt, prompt)
	end)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "OpenPanel")
		if ok and remote then
			remote.OnClientEvent:Connect(function(panelId, args)
				safe("OpenPanel", H.onOpenPanel, panelId, args)
			end)
		end
	end)
	task.defer(function()
		safe("connect", H.connectOthers)
	end)
end

return CareController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="871">
            <Properties>
              <string name="Name">DamageFx</string>
              <string name="Source"><![CDATA[-- DamageFx (client, v2): everything the player sees and feels when they get hurt (or get paid).
--
--   DamageFx.Init()
--
-- What it does
--   * Remotes.DamageTaken(amount, kind): a SUBTLE coloured vignette on the screen EDGES only (four gradient
--     strips, no images; the middle of the screen stays clear), a short camera shake, and a small floating
--     "-12" number with a kind word ("ZAP!") that pops, rises and fades above the local player's head.
--   * Storm damage arrives four times a second, so it is merged into one gentle number every
--     STORM_INTERVAL seconds instead of spamming the screen.
--   * The MatchTokens player attribute going up pops a golden "+n ☁" above the head (golden tokens get a
--     bigger, paler pop).
--
-- Colours follow the calmer v2 palette: nothing flashes white, the lightning flash is a faint warm wash.
-- v3 readability rule: the floating texts are sized with Theme.ScaledSize (1080p sizes scaled by the screen
-- height, never below 14 px) and carry a thick glyph outline, so they read over sky, clouds and grass alike.
--
-- Camera shake
--   The shake is driven through Humanoid.CameraOffset by a RenderStepped connection that exists only
--   while there is shake left. Whenever the shake ends, the character goes away or the humanoid
--   changes, CameraOffset is put back to zero, so the camera can never stay displaced.
--
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DamageFx = {}

local LocalPlayer = Players.LocalPlayer
local ATTR = Config.Attr

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local STORM_INTERVAL = 0.6 -- seconds between merged storm damage numbers
local MAX_LIVE_FLOATS = 12 -- hard cap on simultaneous floating texts

local SHAKE_MAX = 0.8 -- studs of camera offset at full trauma
local SHAKE_DECAY = 2.6 -- trauma lost per second
local SHAKE_SPEED = 1.0 -- multiplier for the shake oscillation speed

-- 1080p design sizes of the floating texts (scaled per screen by Theme.ScaledSize)
local FLOAT_W = 260
local FLOAT_H = 120
local NUMBER_SIZE = 40
local NUMBER_SIZE_BIG = 48 -- hits of 25+
local WORD_SIZE = 24
local TOKEN_SIZE = 34
local TOKEN_SIZE_GOLDEN = 42

local Colors = Theme.Colors

-- Per damage kind: the word, the number colour, the vignette colour and how hard it shakes.
-- (All kinds of Config.Damage.Kinds are covered; anything unknown falls back to Other.)
local KIND_STYLE = {
	Void = {
		Word = "SPLASH",
		Color = Color3.fromRGB(190, 168, 242),
		Vignette = Color3.fromRGB(120, 88, 214),
		Shake = 0.5,
	},
	Lightning = {
		Word = "ZAP!",
		Color = Color3.fromRGB(244, 226, 134),
		Vignette = Color3.fromRGB(226, 196, 84),
		Shake = 0.8,
		Flash = true,
	},
	SpinBar = {
		Word = "WHACK!",
		Color = Color3.fromRGB(240, 156, 112),
		Vignette = Color3.fromRGB(214, 84, 76),
		Shake = 0.6,
	},
	Pendulum = {
		Word = "BONK!",
		Color = Color3.fromRGB(236, 170, 120),
		Vignette = Color3.fromRGB(206, 100, 80),
		Shake = 0.6,
	},
	Storm = {
		Word = "DRIZZLE",
		Color = Color3.fromRGB(150, 192, 238),
		Vignette = Color3.fromRGB(80, 118, 196),
		Shake = 0.1,
		Soft = true,
	},
	Other = {
		Word = "OOF!",
		Color = Colors.Bad,
		Vignette = Color3.fromRGB(204, 72, 92),
		Shake = 0.4,
	},
}

-- Smooth falloff for the vignette strips (strongest at the screen edge, clear towards the middle).
local VIGNETTE_FALLOFF = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.4, 0.6),
	NumberSequenceKeypoint.new(0.75, 0.9),
	NumberSequenceKeypoint.new(1, 1),
})

-- rotation: UIGradient offset 0 sits at the screen edge. 90 = top edge, -90 = bottom, 0 = left, 180 = right.
-- The strips are narrow: only the outer fifth of the screen is ever tinted.
local EDGE_DEFS = {
	{ Name = "Top", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.22), Rotation = 90 },
	{ Name = "Bottom", Anchor = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.22), Rotation = -90 },
	{ Name = "Left", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 0 },
	{ Name = "Right", Anchor = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 180 },
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local rng = Random.new()

local vignette = nil -- { holder, edges, tweens, flash, flashTween, token }
local liveFloats = 0

local shake = { trauma = 0, clock = 0, conn = nil, humanoid = nil, px = 0, py = 0 }

local stormAccum = 0
local stormLastShow = -10
local stormScheduled = false

local lastMatchTokens = 0

----------------------------------------------------------------------
-- Screen vignette
----------------------------------------------------------------------
local function buildScreenGui()
	local gui = CloudUI.NewScreenGui("NimbusDamageFx", 5) -- below the HUD (10)

	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.Visible = false
	holder.Parent = gui

	local edges = {}
	for _, def in ipairs(EDGE_DEFS) do
		local edge = Instance.new("Frame")
		edge.Name = def.Name
		edge.AnchorPoint = def.Anchor
		edge.Position = def.Position
		edge.Size = def.Size
		edge.BorderSizePixel = 0
		edge.BackgroundColor3 = KIND_STYLE.Other.Vignette
		edge.BackgroundTransparency = 1
		edge.Parent = holder

		local gradient = Instance.new("UIGradient")
		gradient.Rotation = def.Rotation
		gradient.Transparency = VIGNETTE_FALLOFF
		gradient.Parent = edge

		table.insert(edges, edge)
	end

	-- faint warm wash used for lightning (never a white-out)
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(240, 228, 190)
	flash.BackgroundTransparency = 1
	flash.Visible = false
	flash.Parent = gui

	vignette = { holder = holder, edges = edges, tweens = {}, flash = flash, flashTween = nil, token = 0 }
end

-- Fade the kind-coloured edges from startT to invisible over 'seconds'.
local function flashVignette(color, startT, seconds)
	local v = vignette
	if not v then
		return
	end
	v.token = v.token + 1
	local token = v.token
	v.holder.Visible = true
	for i, edge in ipairs(v.edges) do
		-- a running tween would overwrite the value we set below, so stop it first
		local old = v.tweens[i]
		if old then
			old:Cancel()
		end
		edge.BackgroundColor3 = color
		edge.BackgroundTransparency = startT
		v.tweens[i] = Util.Tween(edge, seconds, { BackgroundTransparency = 1 })
	end
	task.delay(seconds + 0.05, function()
		if vignette and vignette.token == token then
			vignette.holder.Visible = false
		end
	end)
end

local function flashScreen(startT, seconds)
	local v = vignette
	if not v then
		return
	end
	if v.flashTween then
		v.flashTween:Cancel()
	end
	v.flash.Visible = true
	v.flash.BackgroundTransparency = startT
	local tween = Util.Tween(v.flash, seconds, { BackgroundTransparency = 1 })
	v.flashTween = tween
	task.delay(seconds + 0.05, function()
		if vignette and vignette.flashTween == tween then
			vignette.flash.Visible = false
		end
	end)
end

----------------------------------------------------------------------
-- Camera shake (Humanoid.CameraOffset, always restored)
----------------------------------------------------------------------
local function stopShake()
	if shake.conn then
		shake.conn:Disconnect()
		shake.conn = nil
	end
	shake.trauma = 0
	local humanoid = shake.humanoid
	shake.humanoid = nil
	if humanoid then
		pcall(function()
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end)
	end
end

local function stepShake(dt)
	local humanoid = shake.humanoid
	if not humanoid or not humanoid.Parent then
		stopShake()
		return
	end
	shake.trauma = shake.trauma - SHAKE_DECAY * dt
	if shake.trauma <= 0 then
		stopShake()
		return
	end
	shake.clock = shake.clock + dt * SHAKE_SPEED
	local t = shake.clock
	local magnitude = shake.trauma * shake.trauma * SHAKE_MAX
	-- two incommensurate sines per axis read as noise without needing a random value per frame
	local x = (math.sin(t * 41 + shake.px) + 0.6 * math.sin(t * 67 + shake.py)) / 1.6
	local y = (math.sin(t * 53 + shake.py) + 0.6 * math.sin(t * 79 + shake.px)) / 1.6
	humanoid.CameraOffset = Vector3.new(x * magnitude, y * magnitude, 0)
end

local function addShake(amount)
	if amount <= 0 then
		return
	end
	local humanoid = Util.GetHumanoid(LocalPlayer)
	if not humanoid then
		return
	end
	if shake.humanoid ~= humanoid then
		stopShake() -- gives the previous humanoid (if any) its camera back
		shake.humanoid = humanoid
		shake.px = rng:NextNumber(0, 6.28)
		shake.py = rng:NextNumber(0, 6.28)
	end
	shake.trauma = math.min(1, shake.trauma + amount)
	if not shake.conn then
		shake.conn = RunService.RenderStepped:Connect(stepShake)
	end
end

----------------------------------------------------------------------
-- Floating texts (damage numbers, token pops)
----------------------------------------------------------------------
-- The part floating text hangs above, plus how many studs higher to start for that part.
local function getAnchor()
	local char = LocalPlayer.Character
	if not char then
		return nil, 0
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head, 0
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root, 1.5
	end
	return nil, 0
end

-- cfg: Text, Word (optional kind word), Color, WordColor, TextSize, Rise, Life, StartX, StartY,
--      Gradient = { top, bottom } (optional; tints the number with a UIGradient)
local function spawnFloat(cfg)
	if liveFloats >= MAX_LIVE_FLOATS then
		return
	end
	local anchor, bias = getAnchor()
	if not anchor then
		return
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end

	local startOffset = Vector3.new(cfg.StartX or 0, (cfg.StartY or 2.6) + bias, 0)
	local endOffset = startOffset + Vector3.new(0, cfg.Rise or 3, 0)
	local life = cfg.Life or 1.1
	local factor = Theme.ScreenFactor()

	local board = Instance.new("BillboardGui")
	board.Name = "NC_FloatText"
	board.Adornee = anchor
	board.AlwaysOnTop = true
	board.LightInfluence = 0
	board.ResetOnSpawn = false
	board.Size = UDim2.fromOffset(math.floor(FLOAT_W * factor), math.floor(FLOAT_H * factor))
	board.StudsOffset = startOffset

	-- the scale pop lives on an inner frame so the billboard itself keeps its size
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = board

	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = root

	local texts = {}
	local outlines = {}
	local textSize = Theme.ScaledSize(cfg.TextSize or NUMBER_SIZE)
	local outlineColor = Theme.Darken(cfg.Color or Colors.Bad, 0.72)
	local number = Theme.Label(cfg.Text, "Accent", {
		Size = textSize,
		Color = cfg.Color,
		Stroke = 0.1,
		StrokeColor = outlineColor,
		Outline = 3,
		OutlineColor = outlineColor,
		Props = {
			Name = "Number",
			Size = UDim2.new(1, 0, 0, math.floor(textSize * 1.3)),
			Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5)),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	number.Parent = root
	table.insert(texts, number)
	table.insert(outlines, number:FindFirstChild("TextOutline"))
	if cfg.Gradient then
		-- UIGradient multiplies the text colour, so the label itself must be white
		number.TextColor3 = Colors.White
		Theme.Gradient(number, cfg.Gradient[1], cfg.Gradient[2], 90)
	end

	if cfg.Word then
		local wordSize = Theme.ScaledSize(WORD_SIZE)
		local wordColor = cfg.WordColor or cfg.Color
		local wordOutline = Theme.Darken(wordColor or Colors.Bad, 0.72)
		local word = Theme.Label(cfg.Word, "Accent", {
			Size = wordSize,
			Color = wordColor,
			Stroke = 0.15,
			StrokeColor = wordOutline,
			Outline = 2,
			OutlineColor = wordOutline,
			Props = {
				Name = "Word",
				Size = UDim2.new(1, 0, 0, math.floor(wordSize * 1.3)),
				Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5 + wordSize * 1.25)),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		})
		word.Parent = root
		table.insert(texts, word)
		table.insert(outlines, word:FindFirstChild("TextOutline"))
	end

	board.Parent = playerGui
	liveFloats = liveFloats + 1

	Util.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	Util.Tween(board, life, { StudsOffset = endOffset }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	task.delay(life * 0.55, function()
		if not board.Parent then
			return
		end
		for _, label in ipairs(texts) do
			Util.Tween(label, life * 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		for _, outline in ipairs(outlines) do
			if outline then
				Util.Tween(outline, life * 0.45, { Transparency = 1 })
			end
		end
	end)
	task.delay(life + 0.1, function()
		liveFloats = math.max(0, liveFloats - 1)
		if board.Parent then
			board:Destroy()
		end
	end)
end

local function spawnDamageNumber(amount, kind)
	local style = KIND_STYLE[kind] or KIND_STYLE.Other
	local n = math.max(1, math.floor(amount + 0.5))
	local size = NUMBER_SIZE
	if n >= 25 then
		size = NUMBER_SIZE_BIG
	end
	spawnFloat({
		Text = "-" .. n,
		Word = style.Word,
		Color = style.Color,
		WordColor = Theme.Lighten(style.Color, 0.3),
		TextSize = size,
		Rise = 3,
		Life = 1.05,
		StartX = rng:NextNumber(-1.1, 1.1),
		StartY = 2.6,
	})
end

local function spawnTokenPop(delta)
	local golden = delta >= (Config.Tokens.GoldenValue or 5)
	spawnFloat({
		Text = "+" .. delta .. " \226\152\129",
		Color = Colors.Token,
		Gradient = golden and { Colors.White:Lerp(Colors.TokenGlow, 0.4), Colors.TokenGlow }
			or { Colors.TokenGlow, Colors.Token },
		TextSize = golden and TOKEN_SIZE_GOLDEN or TOKEN_SIZE,
		Rise = 3.2,
		Life = 1.2,
		StartX = rng:NextNumber(-1.4, 1.4),
		StartY = 3.4,
	})
end

----------------------------------------------------------------------
-- Storm merging
----------------------------------------------------------------------
local function showStormNumber()
	stormScheduled = false
	if stormAccum <= 0 then
		return
	end
	local total = stormAccum
	stormAccum = 0
	stormLastShow = os.clock()
	spawnDamageNumber(total, "Storm")
end

local function queueStormNumber(amount)
	stormAccum = stormAccum + amount
	if stormScheduled then
		return
	end
	stormScheduled = true
	local remaining = stormLastShow + STORM_INTERVAL - os.clock()
	if remaining <= 0.02 then
		showStormNumber()
	else
		task.delay(remaining, showStormNumber)
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------
local function onDamageTaken(amount, kind)
	amount = tonumber(amount) or 0
	if amount <= 0 then
		return
	end
	if type(kind) ~= "string" or not KIND_STYLE[kind] then
		kind = "Other"
	end
	local style = KIND_STYLE[kind]

	-- subtle: even the hardest hit only reaches a medium tint at the very edge
	local strength = Util.Clamp(amount / 30, 0.2, 1)
	local startT = Util.Lerp(0.82, 0.4, strength)
	local seconds = 0.45 + strength * 0.35
	if style.Soft then
		startT = 0.86
		seconds = 0.4
	end
	flashVignette(style.Vignette, startT, seconds)
	if style.Flash then
		flashScreen(0.78, 0.25)
	end
	addShake(style.Shake * Util.Clamp(0.5 + amount / 40, 0.5, 1.2))

	if kind == "Storm" then
		queueStormNumber(amount)
	else
		spawnDamageNumber(amount, kind)
	end
end

local function onMatchTokensChanged()
	local value = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	local delta = value - lastMatchTokens
	lastMatchTokens = value
	if delta > 0 then
		spawnTokenPop(math.floor(delta + 0.5))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function DamageFx.Init()
	if initialized then
		return
	end
	initialized = true
	if not LocalPlayer then
		return
	end

	task.spawn(function()
		local ok, err = pcall(buildScreenGui)
		if not ok then
			warn("[DamageFx] vignette setup failed: " .. tostring(err))
		end
	end)

	-- Remotes.Get yields until the folder replicates, so never block Init on it
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "DamageTaken")
		if not ok or not remote then
			warn("[DamageFx] DamageTaken remote unavailable: " .. tostring(remote))
			return
		end
		remote.OnClientEvent:Connect(function(amount, kind)
			local okFx, err = pcall(onDamageTaken, amount, kind)
			if not okFx then
				warn("[DamageFx] damage feedback failed: " .. tostring(err))
			end
		end)
	end)

	-- "+n ☁" whenever the match token count goes up
	lastMatchTokens = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	LocalPlayer:GetAttributeChangedSignal(ATTR.MatchTokens):Connect(function()
		local ok, err = pcall(onMatchTokensChanged)
		if not ok then
			warn("[DamageFx] token pop failed: " .. tostring(err))
		end
	end)

	-- never leave the camera displaced across respawns
	LocalPlayer.CharacterRemoving:Connect(function()
		stopShake()
	end)
end

return DamageFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="872">
            <Properties>
              <string name="Name">DevController</string>
              <string name="Source"><![CDATA[-- DevController (client): the owner-only DEV button and its "Developer tools" side panel (Config.Dev; the server
-- half is server/Services/DevService.lua).
--
--   DevController.Init()
--   Extras (tests): DevController.Open(), DevController.Close(), DevController.IsOpen(), DevController.Relayout()
--   Phase 5 (7.2): chat "/menu" (owner only) -> DevController.OpenMainMenu(); DevController.OnChat(message) (tests)
--
-- Everything here only exists while the LocalPlayer's PlayerGui has the attribute NC_Dev = true (DevService sets it
-- for the game's owner, the Config.Dev.Admins and everyone testing in Studio; a PlayerGui only replicates to its own
-- player, so nobody else learns who the developers are). The attribute is watched; it is only a hint: the server
-- checks every command again. NC_DevTutorial = true (same place) shows "Restart tutorial": the server only sets it
-- when its TutorialService can restart a tutorial.
--
-- ScreenGui "NimbusDev" (display order 15, IgnoreGuiInset = false), built the first time NC_Dev turns true:
--   * DevTile: a chunky cloud tile in the menu tiles' style (glossy face, thick navy outline, big "DEV") with the
--     TextButton "DevButton", docked to the RIGHT edge. Its spot is MEASURED, never guessed: the lowest free place
--     on the right edge that touches none of the menu column, the HUD blocks (NimbusHud panels + its published
--     TopRight geometry), the hotbar, the tutorial panel, the touch RUN / DASH buttons and Roblox's jump button,
--     and stays out of the middle of the screen. On a PC that is the bottom-right corner; on phones and tablets it
--     sits just above the thumb buttons. The top of the side-toast column (NimbusNotify's ToastStack, measured;
--     room for its two newest toasts) is kept free too whenever the screen has room for that. Re-checked twice a
--     second and on every screen size change.
--   * DevPanel: a compact CloudUI panel docked to the right edge, never centred, titled "Developer tools":
--     "Give all pets", "+1M tokens" (Config.Dev.GrantTokens through Theme.ShortNumber), "Restart tutorial",
--     "Skip tutorial", "Start Boss Raid" (Phase 3: DevCommand "raid"), the pet showcase ("Evolve every pet" =
--     DevCommand("evolve", "all"), "Show all pets" / "Show evolved pets" / "Show Evolved II pets" =
--     DevCommand("pets", "0" | "1" | "2"), "Clear pet show" = DevCommand("clearpets"); client/Controllers/DevPetShow.lua
--     builds them), "Reset my data" (the first tap turns it into "Are you sure?"; only a second, separate tap
--     0.6 to 4 s later sends it, so a double click never resets) and the note "Only you can see this". For the
--     first 0.4 s after it opens its buttons ignore taps (the rest of a double click on the tile lands there).
--     It takes a free stretch of the right edge below the toasts' room, so the toasts that answer its buttons
--     never cover it, preferring a stretch where it fits whole (see placePanel): while open it may lie over the
--     thumb buttons or HUD pieces (one tap closes it), never in the middle. Only a very short screen (a landscape
--     phone) has no such stretch: there the newest toasts may cover its top. When the stretch is short the
--     buttons scroll instead of shrinking the text. The tile hides while it is open.
--     Built on the first open, so a developer who never opens it only carries the small tile.
-- Input: mouse, touch and gamepad. Both are Selectable TextButtons (Activated covers click, tap and gamepad A);
-- opening the panel with a gamepad selects its first button; B (ContextActionService, only while open), Esc, the
-- red X and the tile close it.
-- Readability rule: designed in 1080p pixels under one UIScale of the screen factor clamp(viewportY / 1080,
-- 0.8, 1.25): buttons 22 px, title 28 px, note 18 px -> never below 14 px on a phone.
-- Remote out: DevCommand(command, arg). Plain Lua 5.1-compatible syntax only. Fonts only via Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DevController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	ATTR = "NC_Dev", -- PlayerGui attributes set by DevService
	ATTR_TUTORIAL = "NC_DevTutorial",
	GUI_NAME = "NimbusDev",
	ORDER = 15, -- above the HUD (10), hotbar (11) and tutorial (12); below the menu windows (20) and toasts (30)
	EDGE = 12, -- KEEP IN SYNC with HudController.lua: EDGE and TOUCH_EDGE (screen px)
	TOUCH_EDGE = 20,
	GAP = 8, -- screen px kept free around every neighbour
	CENTRE_TOL = 0.145, -- the middle of the screen: |dx| < 14.5% of the width and |dy| < 14.5% of the height
	SCAN_STEP = 4, -- screen px between two candidate spots of the tile
	TILE = 84, -- same size as a menu tile
	TILE_TEXT = 30,
	PANEL_W = 340,
	TITLE_TEXT = 28,
	BUTTON_H = 50,
	BUTTON_TEXT = 22,
	NOTE_TEXT = 18,
	NOTE_H = 26,
	LIST_PAD = 10,
	LIST_GAP = 8,
	BUMPS = 30, -- room the panel's cloud bumps (and their outline) need above its top edge
	MIN_PANEL_H = 230, -- the shortest (scrolling) panel worth showing
	MIN_SCALE = 0.5, -- only for absurdly small windows
	POLL = 0.5, -- seconds between two layout checks
	CONFIRM_SECONDS = 4, -- an armed "Are you sure?" disarms itself after this many seconds
	CONFIRM_DELAY = 0.6, -- seconds the confirming tap must come after the first one (a double click never resets)
	OPEN_GUARD = 0.4, -- seconds after opening during which the panel's buttons ignore taps
	SEND_GAP = 0.35, -- seconds between two commands sent from this panel
	-- design px kept free at the top of the side-toast column: its two newest toasts (the answer to a DEV button
	-- of up to 3 lines and one more of up to 4). KEEP IN SYNC with NotifyController.lua's toast: 18 px text,
	-- 8 px padding above and below, TOAST_GAP 8
	TOAST_ROOM = 200,
	BACK_ACTION = "NimbusDevBack",
}

local BUTTONS = Theme.Buttons or {}
local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local INK = Colors.TextStroke or Colors.Ink
local DEV_COLOR = Theme.Mix(Colors.Storm, BUTTONS.Blue or Color3.fromRGB(90, 158, 234), 0.3) -- slate blue

local LocalPlayer = nil
local initialized = false
local enabled = false
local panelOpen = false
local pollSerial = 0
local lastSend = -math.huge
local openedAt = -math.huge -- os.clock() of the last Open()
local warned = {}

local UI = {} -- Gui, Tile, TileScale, TileButton, TileFx, Panel, PanelRoot, PanelScale, List, Buttons = {}, ResetButton
local Hint = { Gui = nil } -- the LocalPlayer's PlayerGui: DevService's NC_Dev / NC_DevTutorial live there
local Reset = { Until = 0, Serial = 0, ChangedAt = -math.huge } -- ChangedAt: when it was last armed or sent
local Back = { Bound = false }
local applied = {} -- last values written by relayout (only changes are written)

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[DevController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function guard(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function devConfig()
	if type(Config.Dev) == "table" then
		return Config.Dev
	end
	return {}
end

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- The area GUIs with IgnoreGuiInset = false are laid out in (below the top bar).
local function guiAreaSize()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	local vp = viewportSize()
	return Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
end

local function usingGamepad()
	local ok, kind = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	return ok and kind ~= nil and string.find(tostring(kind), "Gamepad", 1, true) ~= nil
end

local refreshTutorialButton -- defined with the panel (Building)

local function corner(parent, radius)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness)
	return Util.Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function plainFrame(parent, name, props)
	local frame = Util.Create("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 })
	for key, value in pairs(props or {}) do
		frame[key] = value
	end
	frame.Parent = parent
	return frame
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function devRemote()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("DevCommand")
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

-- Fires DevCommand(command, arg). Returns true when it was sent (a quick double tap is dropped).
local function send(command, arg)
	local now = os.clock()
	if now - lastSend < K.SEND_GAP then
		return false
	end
	local remote = devRemote()
	if not remote then
		warnOnce("remote", "the DevCommand remote is missing")
		return false
	end
	lastSend = now
	remote:FireServer(command, arg)
	return true
end

local function grantTokens()
	local amount = tonumber(devConfig().GrantTokens)
	if not amount or amount ~= amount or amount < 1 then
		amount = 1000000
	end
	return math.floor(amount)
end

local function tokensLabel()
	local amount = grantTokens()
	local text = nil
	if type(Theme.ShortNumber) == "function" then
		local ok, short = pcall(Theme.ShortNumber, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " tokens"
end

-- Phase 2: test amounts of Cash and Gems (Config.Dev.GrantCash / GrantGems).
local function grantAmount(key, fallback)
	local amount = tonumber(devConfig()[key])
	if not amount or amount ~= amount or amount < 1 then
		amount = fallback
	end
	return math.floor(amount)
end

local function amountLabel(amount, word)
	local text = nil
	if type(Theme.ShortNumber) == "function" then
		local ok, short = pcall(Theme.ShortNumber, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " " .. word
end

local function disarmReset()
	Reset.Until = 0
	Reset.Serial = Reset.Serial + 1
	if UI.ResetButton then
		UI.ResetButton.Text = "Reset my data"
	end
end

-- First tap arms the button ("Are you sure?"); a second tap sends the reset when it comes CONFIRM_DELAY to
-- CONFIRM_SECONDS later. A tap sooner than CONFIRM_DELAY after arming (or after sending) is ignored and the button
-- stays as it is: a double click, however fast, can never wipe the data.
local function onResetPressed()
	local now = os.clock()
	if now - Reset.ChangedAt < K.CONFIRM_DELAY then
		return
	end
	if Reset.Until > now then
		if send("reset") then
			disarmReset()
			Reset.ChangedAt = now
		end
		return
	end
	Reset.Until = now + K.CONFIRM_SECONDS
	Reset.ChangedAt = now
	Reset.Serial = Reset.Serial + 1
	local serial = Reset.Serial
	UI.ResetButton.Text = "Are you sure?"
	task.delay(K.CONFIRM_SECONDS, function()
		if Reset.Serial == serial then
			disarmReset()
		end
	end)
end

-- A panel button's press, ignored for OPEN_GUARD seconds after the panel opened: the panel opens where the DEV
-- tile was, so the second click of a double click on the tile would otherwise land on one of its buttons.
local function panelPress(action)
	return function()
		if os.clock() - openedAt < K.OPEN_GUARD then
			return
		end
		action()
	end
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
-- Glossy chunky face (same recipe as the menu tiles): light top, the colour, then a darker lip at the bottom.
local function tileSequence(c)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.34)),
		ColorSequenceKeypoint.new(0.5, Theme.Lighten(c, 0.05)),
		ColorSequenceKeypoint.new(0.78, Theme.Darken(c, 0.08)),
		ColorSequenceKeypoint.new(0.8, Theme.Darken(c, 0.32)),
		ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.4)),
	})
end

local function buildTile(gui)
	local tile = plainFrame(gui, "DevTile", {
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.TILE, K.TILE),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		ZIndex = 2,
	})
	UI.Tile = tile
	UI.TileScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = tile })

	local button = Util.Create("TextButton", {
		Name = "DevButton",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Selectable = true,
		ZIndex = 3,
		Parent = tile,
	})
	UI.TileButton = button
	corner(button, 18)
	local outline = stroke(button, NAVY, 4)
	local face = Util.Create("UIGradient", { Rotation = 90, Color = tileSequence(DEV_COLOR), Parent = button })
	local gloss = plainFrame(button, "Gloss", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.72,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 0.3, 0),
		ZIndex = 3,
	})
	corner(gloss, 10)
	-- two tiny pixel glints, like the menu tiles (a nod to the voxel world)
	for i, glint in ipairs({ { 10, 9, 6 }, { 18, 9, 4 } }) do
		plainFrame(button, "Glint" .. i, {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.15,
			Position = UDim2.fromOffset(glint[1], glint[2]),
			Size = UDim2.fromOffset(glint[3], glint[3]),
			ZIndex = 4,
		})
	end
	local label = Theme.Label("DEV", "Title", {
		Size = K.TILE_TEXT,
		Stroke = 0.1,
		StrokeColor = INK,
		Outline = 2.5,
		OutlineColor = INK,
		Props = {
			Name = "Label",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.new(1, -8, 0, 36),
			ZIndex = 5,
		},
	})
	label.Parent = button

	-- hover / press feedback (same feel as the menu tiles)
	local fx = Util.Create("UIScale", { Name = "FxScale", Scale = 1, Parent = button })
	local state = { Hovering = false, Pressing = false }
	local function paint()
		local color = DEV_COLOR
		local scale = 1
		if state.Pressing then
			color = Theme.Darken(DEV_COLOR, 0.08)
			scale = 0.93
		elseif state.Hovering then
			color = Theme.Lighten(DEV_COLOR, 0.1)
			scale = 1.07
		end
		face.Color = tileSequence(color)
		outline.Color = NAVY
		Util.Tween(fx, 0.1, { Scale = scale })
	end
	button.MouseEnter:Connect(function()
		state.Hovering = true
		paint()
	end)
	button.MouseLeave:Connect(function()
		state.Hovering, state.Pressing = false, false
		paint()
	end)
	button.MouseButton1Down:Connect(function()
		state.Pressing = true
		paint()
	end)
	button.MouseButton1Up:Connect(function()
		state.Pressing = false
		paint()
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			state.Hovering, state.Pressing = false, false
			paint()
		end
	end)
	button.Activated:Connect(function()
		guard("open", DevController.Open)
	end)
	CloudUI.Tooltip(button, function()
		return "Developer tools (only you)"
	end)
end

-- Design height of the whole panel when nothing is cut off.
local function fullPanelHeight(count)
	local top, _, bottom = CloudUI.ContentInset(true)
	local list = 2 * K.LIST_PAD + count * (K.BUTTON_H + K.LIST_GAP) + K.NOTE_H
	return top + list + bottom
end

-- True when the server says "Restart tutorial" works in this build (NC_DevTutorial on our PlayerGui).
local function tutorialAvailable()
	return Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR_TUTORIAL) == true
end

-- Shows "Restart tutorial" only when it works, and sizes the panel for the buttons that are shown.
function refreshTutorialButton()
	local button = UI.Buttons and UI.Buttons.tutorial
	if not button then
		return -- the panel is not built yet: it asks again when it is
	end
	button.Visible = tutorialAvailable()
	local shown = 0
	for _, b in ipairs(UI.Buttons) do
		if b.Visible then
			shown = shown + 1
		end
	end
	UI.FullHeight = fullPanelHeight(shown)
	DevController.Relayout()
end

local function buildPanel(gui)
	local specs = {
		{ Id = "allpets", Text = "Give all pets", Style = "Green" },
		{ Id = "tokens", Text = tokensLabel(), Style = "Gold" },
		{ Id = "cash", Text = amountLabel(grantAmount("GrantCash", 1000000), "Cash"), Style = "Green" },
		{ Id = "gems", Text = amountLabel(grantAmount("GrantGems", 1000), "Gems"), Style = "Blue" },
		{ Id = "tutorial", Text = "Restart tutorial", Style = "Blue" },
		{ Id = "skiptutorial", Text = "Skip tutorial", Style = "Pink" },
		{ Id = "raid", Text = "Start Boss Raid", Style = "Gold" }, -- Phase 3 (events): DevCommand("raid")
		-- the pet showcase (DevService: evolve / pets / clearpets)
		{ Id = "evolveall", Text = "Evolve every pet", Style = "Gold", Command = "evolve", Arg = "all" },
		{ Id = "pets0", Text = "Show all pets", Style = "Blue", Command = "pets", Arg = "0" },
		{ Id = "pets1", Text = "Show evolved pets", Style = "Blue", Command = "pets", Arg = "1" },
		{ Id = "pets2", Text = "Show Evolved II pets", Style = "Blue", Command = "pets", Arg = "2" },
		{ Id = "clearpets", Text = "Clear pet show", Style = "Gray", Command = "clearpets" },
		{ Id = "reset", Text = "Reset my data", Style = "Red" },
	}
	UI.FullHeight = fullPanelHeight(#specs)
	local panel = CloudUI.Panel({
		Name = "DevPanel",
		Title = "Developer tools",
		TitleSize = K.TITLE_TEXT,
		Closable = true,
		OnClose = function()
			DevController.Close()
		end,
		Accent = DEV_COLOR,
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.PANEL_W, UI.FullHeight),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		Parent = gui,
	})
	UI.Panel = panel
	UI.PanelRoot = panel.Root
	UI.PanelRoot.Visible = false
	UI.PanelScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = panel.Root })

	local list = Util.Create("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = WHITE,
		ZIndex = 5,
		Parent = panel.Content,
	})
	UI.List = list
	Util.Create("UIPadding", {
		PaddingTop = UDim.new(0, K.LIST_PAD),
		PaddingBottom = UDim.new(0, K.LIST_PAD),
		PaddingLeft = UDim.new(0, K.LIST_PAD),
		PaddingRight = UDim.new(0, K.LIST_PAD + 4),
		Parent = list,
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, K.LIST_GAP),
		Parent = list,
	})

	UI.Buttons = {}
	for index, spec in ipairs(specs) do
		local id = spec.Id
		local callback
		if id == "reset" then
			callback = panelPress(function()
				guard("reset", onResetPressed)
			end)
		elseif id == "tokens" then
			callback = panelPress(function()
				send("tokens", grantTokens())
			end)
		elseif id == "cash" then
			callback = panelPress(function()
				send("cash", grantAmount("GrantCash", 1000000))
			end)
		elseif id == "gems" then
			callback = panelPress(function()
				send("gems", grantAmount("GrantGems", 1000))
			end)
		elseif spec.Command then
			callback = panelPress(function()
				send(spec.Command, spec.Arg)
			end)
		else
			callback = panelPress(function()
				send(id)
			end)
		end
		local button = CloudUI.Button({
			Name = "Dev_" .. id,
			Text = spec.Text,
			Style = spec.Style,
			Size = UDim2.new(1, 0, 0, K.BUTTON_H),
			TextSize = K.BUTTON_TEXT,
			LayoutOrder = index,
			ZIndex = 6,
			Callback = callback,
			Parent = list,
		})
		button.Selectable = true
		UI.Buttons[id] = button
		UI.Buttons[index] = button
		if id == "reset" then
			UI.ResetButton = button
		end
	end
	local note = Theme.Label("Only you can see this", "Label", {
		Size = K.NOTE_TEXT,
		Color = Colors.Muted or WHITE,
		Stroke = 0.3,
		Outline = 1.5,
		Props = {
			Name = "Note",
			Size = UDim2.new(1, 0, 0, K.NOTE_H),
			LayoutOrder = #specs + 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 6,
		},
	})
	note.Parent = list
	refreshTutorialButton()
end

local function build()
	if UI.Gui and UI.Gui.Parent then
		return
	end
	local gui = CloudUI.NewScreenGui(K.GUI_NAME, K.ORDER)
	gui.Enabled = false
	UI.Gui = gui
	applied = {}
	UI.PanelRoot = nil -- the panel is built on first open (a developer who never opens it only pays for the tile)
	buildTile(gui)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		guard("relayout", DevController.Relayout)
	end)
end

----------------------------------------------------------------------
-- Layout: measured neighbours (all rectangles in our gui-area pixels)
----------------------------------------------------------------------
local function playerGui()
	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

-- y offset that converts a gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

local function addRect(list, inst, root, dy)
	if not (inst and inst:IsA("GuiObject")) then
		return
	end
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	if s.X <= 0 or s.Y <= 0 or not shownIn(inst, root) then
		return
	end
	list[#list + 1] = { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

local function enabledGui(pg, name)
	local gui = pg:FindFirstChild(name)
	if gui and gui:IsA("ScreenGui") and gui.Enabled then
		return gui
	end
	return nil
end

-- The side toasts (NimbusNotify, drawn above us): the measured left / right edges and top of the toast column,
-- reserved TOAST_ROOM design px down, so its newest toasts (the answers to the panel's buttons) stay readable.
-- nil when there is no toast column.
local function toastRoom(pg, factor)
	local notify = enabledGui(pg, "NimbusNotify")
	local stack = notify and notify:FindFirstChild("ToastStack", true)
	if not (stack and stack:IsA("GuiObject")) or stack.AbsoluteSize.X <= 0 then
		return nil
	end
	local p, s = stack.AbsolutePosition, stack.AbsoluteSize
	local top = p.Y + insetShift(notify)
	return { x0 = p.X, y0 = top, x1 = p.X + s.X, y1 = top + K.TOAST_ROOM * factor }
end

-- What the DEV tile and panel keep clear of (gui-area rectangles):
--   Others          the menu column, HUD blocks, hotbar, tutorial panel, touch buttons (the tile never touches them)
--   Toasts          the toast column's room, or nil
--   TopRightBottom  the bottom of the HUD's top-right block (0 if none), TopRightLeft its left edge
local function neighbours(area, factor)
	local out = {}
	local layout = { Others = out, Toasts = nil, TopRightBottom = 0, TopRightLeft = area.X }
	local pg = playerGui()
	if not pg then
		return layout
	end
	layout.Toasts = toastRoom(pg, factor)
	local menu = enabledGui(pg, "NimbusMenu")
	if menu then
		addRect(out, menu:FindFirstChild("MenuColumn"), menu, insetShift(menu))
	end
	local hud = enabledGui(pg, "NimbusHud")
	if hud then
		local dy = insetShift(hud)
		for _, holder in ipairs(hud:GetChildren()) do
			if holder:IsA("GuiObject") and holder.Visible then
				for _, panel in ipairs(holder:GetChildren()) do
					addRect(out, panel, hud, dy)
				end
			end
		end
		local trb = tonumber(hud:GetAttribute("TopRightBottom")) or 0
		if trb > 0 then
			layout.TopRightBottom = trb
			layout.TopRightLeft = tonumber(hud:GetAttribute("TopRightLeft")) or 0
			out[#out + 1] = { x0 = layout.TopRightLeft, y0 = 0, x1 = area.X, y1 = trb }
		end
	end
	local hotbar = enabledGui(pg, "NimbusHotbar")
	if hotbar then
		addRect(out, hotbar:FindFirstChild("Hotbar"), hotbar, insetShift(hotbar))
	end
	local tutorial = enabledGui(pg, "NimbusTutorial")
	if tutorial then
		addRect(out, tutorial:FindFirstChild("TutorialPanel"), tutorial, insetShift(tutorial))
	end
	-- touch RUN / DASH (MovementController)
	local mobile = enabledGui(pg, "MobileControls")
	if mobile then
		local dy = insetShift(mobile)
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("ImageButton") then
				addRect(out, d, mobile, dy)
			end
		end
	end
	-- Roblox's own jump button; when it cannot be measured, the footprint MovementController assumes
	-- (KEEP IN SYNC with MovementController.lua layoutMobileControls)
	local measured = false
	local touchGui = enabledGui(pg, "TouchGui")
	if touchGui then
		local jump = touchGui:FindFirstChild("JumpButton", true)
		if jump then
			local before = #out
			addRect(out, jump, touchGui, insetShift(touchGui))
			measured = #out > before
		end
	end
	if not measured and isTouchDevice() then
		local vp = viewportSize()
		local small = math.min(vp.X, vp.Y) <= 500
		local size = small and 70 or 120
		local bottom = small and 20 or size * 0.75
		local dy = area.Y - vp.Y -- screen -> gui area (minus the top bar)
		out[#out + 1] = {
			x0 = vp.X - (size * 1.5 + 10),
			y0 = vp.Y - bottom - size + dy,
			x1 = vp.X - (size * 0.5 + 10),
			y1 = vp.Y - bottom + dy,
		}
	end
	return layout
end

-- A new list with the rectangles of `a` and `b` (either may be a list, one rectangle or nil).
local function joined(a, b)
	local out = {}
	for _, part in ipairs({ a or {}, b or {} }) do
		if part.x0 then
			out[#out + 1] = part
		else
			for _, r in ipairs(part) do
				out[#out + 1] = r
			end
		end
	end
	return out
end

-- The middle of the screen the game never writes into (same band as the HUD), in gui-area pixels.
local function centreBand(area)
	local vp = viewportSize()
	local inset = math.max(0, vp.Y - area.Y)
	local tol = K.CENTRE_TOL
	return {
		x0 = vp.X * (0.5 - tol),
		x1 = vp.X * (0.5 + tol),
		y0 = vp.Y * (0.5 - tol) - inset,
		y1 = vp.Y * (0.5 + tol) - inset,
	}
end

local function touches(a, b, gap)
	return a.x0 < b.x1 + gap and a.x1 > b.x0 - gap and a.y0 < b.y1 + gap and a.y1 > b.y0 - gap
end

-- Bottom edge (gui px) of the lowest spot for a size x size tile at the right edge `right` that touches no
-- blocker and stays out of the band; nil when there is none.
local function lowestFreeSpot(area, side, right, size, blockers, band)
	local y1 = area.Y - side
	while y1 - size >= side do
		local rect = { x0 = right - size, y0 = y1 - size, x1 = right, y1 = y1 }
		local free = not touches(rect, band, 0)
		if free then
			for _, r in ipairs(blockers) do
				if touches(rect, r, K.GAP) then
					free = false
					break
				end
			end
		end
		if free then
			return y1
		end
		y1 = y1 - K.SCAN_STEP
	end
	return nil
end

-- Bottom-right corner (gui px) of the tile: the lowest free spot on the right edge, clear of the toasts' room
-- too when the screen has space for that (a short phone screen has not: then only toasts may touch it).
local function placeTile(area, side, size, layout, band)
	local right = area.X - side
	for _, blockers in ipairs({ joined(layout.Others, layout.Toasts), layout.Others }) do
		local y1 = lowestFreeSpot(area, side, right, size, blockers, band)
		if y1 then
			return right, y1
		end
	end
	-- no free spot at all (a tiny window): the top-right corner
	return right, math.min(area.Y - side, side + size)
end

-- Free vertical stretches [y0, y1] of the column [x0, x1] between top and bottom. `headroom` is kept free below
-- every blocker as well (the panel's cloud bumps stick out above its top edge).
local function freeStretches(x0, x1, top, bottom, blockers, headroom)
	local spans = {}
	for _, r in ipairs(blockers) do
		if r.x0 < x1 + K.GAP and r.x1 > x0 - K.GAP and r.y1 + K.GAP > top and r.y0 - K.GAP < bottom then
			spans[#spans + 1] = { r.y0 - K.GAP, r.y1 + K.GAP + headroom }
		end
	end
	table.sort(spans, function(a, b)
		return a[1] < b[1]
	end)
	local out = {}
	local cursor = top
	for _, span in ipairs(spans) do
		if span[1] > cursor then
			out[#out + 1] = { cursor, math.min(span[1], bottom) }
		end
		cursor = math.max(cursor, span[2])
	end
	if cursor < bottom then
		out[#out + 1] = { cursor, bottom }
	end
	return out
end

-- The tallest free stretch (the lower one on a tie); nil when none is at least minH tall.
local function bestStretch(stretches, minH)
	local best = nil
	for _, s in ipairs(stretches) do
		local h = s[2] - s[1]
		if h >= minH and (best == nil or h >= best[2] - best[1]) then
			best = s
		end
	end
	return best
end

-- Bottom-right corner, design height and scale of the open panel. While it is open the panel is what the
-- developer uses, so it should be whole and uncovered: it may then lie over the thumb buttons or HUD pieces (one
-- tap closes it), but never over the toasts' room or in the middle of the screen. Tried in this order:
--   1. clear of everything, full height        2. clear of the toasts' room and the middle, full height
--   3. clear of everything, scrolling           4. clear of the toasts' room and the middle, scrolling
--   5. out of the middle only (a very short screen: the newest toasts may cover its top)
local function placePanel(area, side, factor, layout, band)
	local scale = math.max(K.MIN_SCALE, math.min(factor, (area.X - 2 * side) / K.PANEL_W))
	local right = area.X - side
	local left = right - K.PANEL_W * scale
	local bumps = K.BUMPS * scale
	local top = side
	if layout.TopRightBottom > 0 and layout.TopRightLeft < right then
		top = math.max(top, layout.TopRightBottom + K.GAP) -- the HUD's top-right block always stays visible
	end
	top = top + bumps
	local bottom = area.Y - side
	local fullH = (UI.FullHeight or 400) * scale
	local minH = math.min(K.MIN_PANEL_H * scale, bottom - top)
	local bandBlock = nil
	if left < band.x1 and right > band.x0 then
		bandBlock = { x0 = left, x1 = right, y0 = band.y0 + K.GAP, y1 = band.y1 - K.GAP }
	end
	local everything = joined(joined(layout.Others, layout.Toasts), bandBlock)
	local toastsAndMiddle = joined(layout.Toasts, bandBlock)
	local tries = {
		{ everything, fullH },
		{ toastsAndMiddle, fullH },
		{ everything, minH },
		{ toastsAndMiddle, minH },
		{ joined(bandBlock, nil), minH },
	}
	local stretch = nil
	for _, try in ipairs(tries) do
		stretch = bestStretch(freeStretches(left, right, top, bottom, try[1], bumps), try[2])
		if stretch then
			break
		end
	end
	stretch = stretch or { top, bottom }
	local height = math.min(UI.FullHeight or 400, (stretch[2] - stretch[1]) / scale)
	return right, stretch[2], height, scale
end

local function setIfChanged(key, inst, prop, value)
	if applied[key] ~= value then
		applied[key] = value
		inst[prop] = value
	end
end

function DevController.Relayout()
	if not UI.Gui or not enabled then
		return
	end
	local area = guiAreaSize()
	local factor = Theme.ScreenFactor(viewportSize().Y)
	local side = isTouchDevice() and K.TOUCH_EDGE or K.EDGE
	local layout = neighbours(area, factor)
	local band = centreBand(area)
	local tx, ty = placeTile(area, side, K.TILE * factor, layout, band)
	setIfChanged("tileScale", UI.TileScale, "Scale", factor)
	setIfChanged("tilePos", UI.Tile, "Position", UDim2.fromOffset(math.floor(tx + 0.5), math.floor(ty + 0.5)))
	if panelOpen then
		local px, py, height, scale = placePanel(area, side, factor, layout, band)
		setIfChanged("panelScale", UI.PanelScale, "Scale", scale)
		setIfChanged("panelSize", UI.PanelRoot, "Size", UDim2.fromOffset(K.PANEL_W, math.floor(height)))
		setIfChanged("panelPos", UI.PanelRoot, "Position", UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5)))
	end
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and panelOpen then
		DevController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function bindBack(on)
	if on == Back.Bound then
		return
	end
	Back.Bound = on
	if on then
		guard("bind back", function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

local function selectionInside(root)
	local selected = GuiService.SelectedObject
	return selected ~= nil and root ~= nil and selected:IsDescendantOf(root)
end

function DevController.IsOpen()
	return panelOpen
end

function DevController.Open()
	if not enabled or not UI.Gui then
		return false
	end
	if panelOpen then
		DevController.Close()
		return false
	end
	if not (UI.PanelRoot and UI.PanelRoot.Parent) then
		if not guard("build panel", buildPanel, UI.Gui) then
			return false
		end
	end
	panelOpen = true
	openedAt = os.clock()
	disarmReset()
	UI.PanelRoot.Visible = true
	UI.Tile.Visible = false
	DevController.Relayout()
	bindBack(true)
	if usingGamepad() and UI.Buttons[1] then
		pcall(function()
			GuiService.SelectedObject = UI.Buttons[1]
		end)
	end
	return true
end

function DevController.Close()
	if not panelOpen then
		return
	end
	panelOpen = false
	disarmReset()
	local hadSelection = selectionInside(UI.PanelRoot)
	if UI.PanelRoot then
		UI.PanelRoot.Visible = false
	end
	if UI.Tile then
		UI.Tile.Visible = enabled
	end
	bindBack(false)
	if hadSelection then
		pcall(function()
			GuiService.SelectedObject = (enabled and usingGamepad()) and UI.TileButton or nil
		end)
	end
	DevController.Relayout()
end

----------------------------------------------------------------------
-- NC_Dev on / off
----------------------------------------------------------------------
local function startPolling()
	pollSerial = pollSerial + 1
	local serial = pollSerial
	task.spawn(function()
		while enabled and serial == pollSerial do
			guard("relayout", DevController.Relayout)
			task.wait(K.POLL)
		end
	end)
end

local function setEnabled(on)
	if on == enabled then
		return
	end
	if on then
		if not guard("build", build) then
			return
		end
		enabled = true
		UI.Gui.Enabled = true
		UI.Tile.Visible = not panelOpen
		applied = {}
		startPolling()
	else
		DevController.Close()
		enabled = false
		pollSerial = pollSerial + 1
		if UI.Gui then
			UI.Gui.Enabled = false
		end
	end
end

local function refreshFlag()
	setEnabled(Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR) == true)
end

-- Follows DevService's hints on our PlayerGui (never on the Player: that one every client can read).
local function watchHints()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 60)
	if not pg then
		return
	end
	Hint.Gui = pg
	pg:GetAttributeChangedSignal(K.ATTR):Connect(function()
		guard("NC_Dev", refreshFlag)
	end)
	pg:GetAttributeChangedSignal(K.ATTR_TUTORIAL):Connect(function()
		guard("NC_DevTutorial", refreshTutorialButton)
	end)
	guard("NC_Dev", refreshFlag)
end

-- Phase 5 (7.2): the owner shortcut /menu reopens the main menu (MainMenuController.Open: client-side only, the
-- character stays and MenuPlay is never sent again). Only while NC_Dev is set; DevService ignores the word.
function DevController.OpenMainMenu()
	local module = script.Parent:FindFirstChild("MainMenuController")
	local ok, menu = pcall(function()
		return module and require(module)
	end)
	if ok and type(menu) == "table" and type(menu.Open) == "function" then
		guard("menu", menu.Open)
		return true
	end
	return false
end

function DevController.OnChat(message)
	if type(message) ~= "string" or #message > 40 or not string.match(string.lower(message), "^%s*/menu%s*$") then
		return false
	end
	if not (Hint.Gui and Hint.Gui:GetAttribute(K.ATTR) == true) then
		return false
	end
	return DevController.OpenMainMenu()
end

local function watchChat()
	LocalPlayer.Chatted:Connect(DevController.OnChat)
	pcall(function()
		local chat = game:GetService("TextChatService")
		chat.SendingMessage:Connect(function(msg)
			DevController.OnChat(msg and msg.Text)
		end)
	end)
end

function DevController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	if not LocalPlayer then
		return
	end
	UserInputService.InputBegan:Connect(function(input)
		if panelOpen and input.KeyCode == Enum.KeyCode.Escape then
			DevController.Close()
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			guard("relayout", DevController.Relayout)
		end)
	end
	task.spawn(watchHints)
	pcall(watchChat)
end

return DevController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="873">
            <Properties>
              <string name="Name">DevPetShow</string>
              <string name="Source"><![CDATA[-- DevPetShow (client): the developer's pet showcase. The server half is DevService ("/pet", "/pets", "/evolve",
-- "/clearpets"): it checks the permission and sends DevPetShow(action, payload) to the developer's own client.
--
--   DevPetShow.Init()
--   Extras (tests): DevPetShow.Handle(action, payload) (what the remote does), DevPetShow.Count() -> showcase pets
--                   in the world, DevPetShow.Busy() -> a lineup is being built or an evolution is playing,
--                   DevPetShow.Folder() -> the workspace folder (nil before the first pet)
--
-- The pets are built here with PetBuilder at Scale 1 (the size they have in the game) into the workspace folder
-- "DevPetShow": only this player sees them, and the server never has to replicate thousands of parts.
--   Spawn {PetId, Stage}    the pet at stage 0 (normal), 1 (evolved) or 2 (second evolution) in front of the player,
--                           facing them and hovering over the ground, beside the ones already there (they stay
--                           until Clear; the oldest goes past MAX_PETS)
--   Lineup {Stage, PetIds}  clears, builds every listed pet (one per frame) and stands them in rows in front of the
--                           player, all facing the same way; Low detail when the lineup would pass LINEUP_PARTS parts
--   Evolve {Steps}          clears, then plays the evolution animations (client/Controllers/EvolutionFx.lua) one
--                           after another in front of the player; Steps = { {PetId, From, To}, ... } with To = From + 1.
--                           A pet's line carries on with the evolved pet (normal -> evolved -> evolved II); after a
--                           short pause the next pet of a reel takes its place. The last one stays.
--   Clear {}                stops an evolution or a lineup and removes every showcase pet
-- Lineup, Evolve and Clear take over from whatever was running; Spawn adds to it. Resting pets get the tag
-- NC_Showcase (ShowcaseController makes them hover, flap, wag and blink) and a compact name tag (World text rule:
-- pixel-sized, 24 px name and 19 px info line, outlined, on a solid plate sized to its text, LightInfluence 0,
-- MaxDistance 120). Payloads are checked again here (catalog ids, stages each pet really has).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local function optionalModule(parent, name)
	local module = parent:FindFirstChild(name) or parent:WaitForChild(name, 5)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[DevPetShow] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local PetBuilder = optionalModule(Shared, "PetBuilder")
local PetCatalog = optionalModule(Shared, "PetCatalog")
local EvolutionFx = optionalModule(script.Parent, "EvolutionFx")

local DevPetShow = {}

local K = {
	FOLDER = "DevPetShow",
	TAG = "NC_Showcase", -- ShowcaseController animates models with this tag
	MAX_PETS = 40,
	HOVER = 0.7, -- studs between a pet's lowest point and the ground
	BOB = 0.3, -- ShowcaseController hover amplitude (studs)
	AHEAD = 6, -- studs from the player to the nearest pet's edge
	GAP = 1.6, -- studs between two pets
	PER_ROW = 8,
	LINEUP_PARTS = 26000, -- above this a lineup is built at Low detail
	PARTS = { [0] = 350, [1] = 1560, [2] = 2000 }, -- High detail part caps per stage (PetBuilder header)
	LOOK = 0.6, -- seconds a pet is shown before it evolves
	STEP_PAUSE = 0.5, -- seconds between the two evolutions of one pet
	PAUSE = 1.8, -- seconds an evolved pet rests before the next pet of a reel
	NAME_PX = 24, -- World text rule: names >= 22 px, info lines >= 18 px (1080p design pixels)
	INFO_PX = 19,
	TAG_W = 280,
	TAG_H = 70,
	TAG_DISTANCE = 120,
	RAY = 90, -- studs searched down for the ground
}
local STAGE_NAMES = { [0] = "Normal", [1] = "Evolved", [2] = "Evolved II" }

local folder = nil
local pets = {} -- { { Model, Pos = Vector3 (root, flat), Radius } } resting showcase pets, oldest first
local generation = 0 -- Lineup / Evolve / Clear bump it: a running lineup or evolution stops when it changes
local current = nil -- the EvolutionFx handle that is playing
local busy = 0
local initialized = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function getFolder()
	if folder and folder.Parent then
		return folder
	end
	folder = Workspace:FindFirstChild(K.FOLDER)
	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name = K.FOLDER
		folder.Parent = Workspace
	end
	return folder
end

local function defOf(id)
	if type(id) ~= "string" or not PetCatalog then
		return nil
	end
	local ok, def = pcall(PetCatalog.Get, id)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function maxStage(def)
	local ok, top = pcall(PetBuilder.MaxEvolution, def)
	if ok and (top == 1 or top == 2) then
		return top
	end
	return 1
end

local function validStage(def, stage)
	return type(stage) == "number" and stage == math.floor(stage) and stage >= 0 and stage <= maxStage(def)
end

local function rarityColor(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity and typeof(r.Color) == "Color3" then
			if rarity == "Secret" then
				return Color3.fromRGB(150, 236, 255) -- the dark Secret colour does not show on the navy plate
			end
			return r.Color
		end
	end
	return Theme.Colors.Gold
end

-- The player's position and the flat direction they look at.
local function playerFrame()
	local player = Players.LocalPlayer
	local char = player and player.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

-- y of the ground under pos (the player's feet when nothing is found)
local function groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { getFolder() }
	if char then
		ignore[#ignore + 1] = char
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- The built pet's extent around its root (PetBuilder builds the root at the origin): lowest and highest point,
-- and the horizontal radius from the root.
local function extentOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5, 1.5, 2
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or cf.Position
	local bottom = rel.Y - size.Y / 2
	local top = rel.Y + size.Y / 2
	local radius = math.max(math.abs(rel.X) + size.X / 2, math.abs(rel.Z) + size.Z / 2)
	return bottom, top, radius
end

local function build(def, stage, detail)
	local ok, model = pcall(PetBuilder.Build, def, { Detail = detail or "High", Evolved = (stage > 0) and stage or nil })
	if not ok or typeof(model) ~= "Instance" or not model.PrimaryPart then
		warn("[DevPetShow] could not build " .. tostring(def.Id) .. " stage " .. tostring(stage) .. ": " .. tostring(model))
		return nil
	end
	model.Name = "DevPet_" .. tostring(def.Id) .. "_" .. stage
	model:SetAttribute("DevPetStage", stage)
	return model
end

-- Root CFrame of a pet standing at flat position `spot` (its lowest point HOVER above the ground), facing `facing`.
local function poseAt(spot, bottom, facing, char, fallbackY)
	local ground = groundAt(Vector3.new(spot.X, fallbackY + 4, spot.Z), char, fallbackY)
	local pos = Vector3.new(spot.X, ground + K.HOVER - bottom, spot.Z)
	return CFrame.lookAt(pos, pos + facing), ground
end

local function nameTag(model, def, stage, top)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local k = 1
	local okScale, factor = pcall(Theme.ScreenFactor)
	if okScale and type(factor) == "number" and factor > 0 then
		k = factor
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "DevPetTag"
	gui.Size = UDim2.fromOffset(math.floor(K.TAG_W * k), math.floor(K.TAG_H * k))
	gui.StudsOffsetWorldSpace = Vector3.new(0, top + 1.4, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = K.TAG_DISTANCE
	gui.ClipsDescendants = false
	gui.Adornee = root
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.BackgroundColor3 = Theme.Colors.Navy
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.fromScale(0.5, 1)
	card.Size = UDim2.fromOffset(0, 0)
	card.AutomaticSize = Enum.AutomaticSize.XY
	card.Parent = gui
	Theme.Corner(card, UDim.new(0, 12))
	Theme.Stroke(card, rarityColor(def.Rarity), 3, 0)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 1)
	list.Parent = card
	local scale = Instance.new("UIScale")
	scale.Name = "ReadScale"
	scale.Scale = k
	scale.Parent = card
	local name = Theme.Label(tostring(def.Name or def.Id), "Heading", { Size = K.NAME_PX, Color = Theme.Colors.White, Outline = 2 })
	name.Name = "Name"
	name.AutomaticSize = Enum.AutomaticSize.XY
	name.Size = UDim2.fromOffset(0, K.NAME_PX + 4)
	name.TextWrapped = false
	name.LayoutOrder = 1
	name.Parent = card
	local info = Theme.Label(STAGE_NAMES[stage] .. "  \226\128\162  " .. tostring(def.Rarity or ""), "Label", { Size = K.INFO_PX, Color = rarityColor(def.Rarity), Outline = 2 })
	info.Name = "Info"
	info.AutomaticSize = Enum.AutomaticSize.XY
	info.Size = UDim2.fromOffset(0, K.INFO_PX + 4)
	info.TextWrapped = false
	info.LayoutOrder = 2
	info.Parent = card
	gui.Parent = root
end

-- A pet at rest: name tag, then ShowcaseController brings it to life.
local function rest(model, def, stage, pos, radius)
	local _, top = extentOf(model)
	model:SetAttribute("Ready", true)
	model:SetAttribute("HoverAmp", K.BOB)
	nameTag(model, def, stage, top)
	CollectionService:AddTag(model, K.TAG)
	pets[#pets + 1] = { Model = model, Pos = Vector3.new(pos.X, 0, pos.Z), Radius = radius }
	while #pets > K.MAX_PETS do
		local old = table.remove(pets, 1)
		pcall(function()
			old.Model:Destroy()
		end)
	end
end

local function clearAll()
	if current then
		pcall(current.Stop)
		current = nil
	end
	for _, rec in ipairs(pets) do
		pcall(function()
			rec.Model:Destroy()
		end)
	end
	pets = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

-- The first free spot on the line in front of the player (nearest the middle first).
local function freeSpot(origin, look, radius)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
	for i = 0, 40 do
		local side = (i == 0) and 0 or (((i % 2 == 1) and 1 or -1) * math.ceil(i / 2))
		local spot = base + right * side * (radius + K.GAP)
		local free = true
		for _, rec in ipairs(pets) do
			if rec.Model.Parent and (rec.Pos - spot).Magnitude < rec.Radius + radius + K.GAP * 0.5 then
				free = false
				break
			end
		end
		if free then
			return spot
		end
	end
	return base
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
local function spawnPet(payload)
	local def = defOf(payload.PetId)
	if not def or not validStage(def, payload.Stage) then
		return false
	end
	local model = build(def, payload.Stage, "High")
	if not model then
		return false
	end
	local origin, look, char = playerFrame()
	local bottom, _, radius = extentOf(model)
	local spot = freeSpot(origin, look, radius)
	local pose = poseAt(spot, bottom, -look, char, origin.Y - 3)
	model:PivotTo(pose)
	model.Parent = getFolder()
	rest(model, def, payload.Stage, spot, radius)
	return true
end

local function lineup(payload, gen)
	local stage = payload.Stage
	if type(payload.PetIds) ~= "table" or type(stage) ~= "number" then
		return false
	end
	local defs = {}
	for _, id in ipairs(payload.PetIds) do
		local def = defOf(id)
		if def and validStage(def, stage) then
			defs[#defs + 1] = def
		end
	end
	if #defs == 0 then
		return false
	end
	busy = busy + 1
	local detail = (#defs * (K.PARTS[stage] or 350) > K.LINEUP_PARTS) and "Low" or "High"
	-- build them all first (one per frame), then stand them in rows
	local built = {}
	local maxR = 1
	for _, def in ipairs(defs) do
		if gen ~= generation then
			break
		end
		local model = build(def, stage, detail)
		if model then
			local bottom, _, radius = extentOf(model)
			built[#built + 1] = { Model = model, Def = def, Bottom = bottom, Radius = radius }
			maxR = math.max(maxR, radius)
		end
		task.wait()
	end
	if gen ~= generation then
		for _, b in ipairs(built) do
			pcall(function()
				b.Model:Destroy()
			end)
		end
		busy = busy - 1
		return false
	end
	local origin, look, char = playerFrame()
	local right = Vector3.new(-look.Z, 0, look.X)
	local perRow = math.min(K.PER_ROW, #built)
	local pitch = maxR * 2 + K.GAP
	local parent = getFolder()
	for i, b in ipairs(built) do
		local row = math.floor((i - 1) / perRow)
		local col = (i - 1) % perRow
		local inRow = math.min(perRow, #built - row * perRow)
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + maxR + row * (pitch + K.GAP)) + right * ((col - (inRow - 1) / 2) * pitch)
		local pose = poseAt(spot, b.Bottom, -look, char, origin.Y - 3)
		b.Model:PivotTo(pose)
		b.Model.Parent = parent
		rest(b.Model, b.Def, stage, spot, b.Radius)
	end
	busy = busy - 1
	return true
end

-- Groups the steps into chains: consecutive steps of one pet where each starts where the previous ended.
local function chainsOf(steps)
	local chains = {}
	local last = nil
	for _, st in ipairs(steps) do
		if type(st) == "table" then
			local def = defOf(st.PetId)
			if def and validStage(def, st.From) and validStage(def, st.To) and st.To == st.From + 1 then
				if last and last.Def == def and last.To == st.From then
					last.Steps[#last.Steps + 1] = st
					last.To = st.To
				else
					last = { Def = def, From = st.From, To = st.To, Steps = { st } }
					chains[#chains + 1] = last
				end
			end
		end
	end
	return chains
end

local function evolveReel(payload, gen)
	if type(payload.Steps) ~= "table" or not EvolutionFx then
		return false
	end
	local chains = chainsOf(payload.Steps)
	if #chains == 0 then
		return false
	end
	busy = busy + 1
	local onShow = nil -- the model resting from the previous chain
	for ci, chain in ipairs(chains) do
		if gen ~= generation then
			break
		end
		if onShow then
			task.wait(K.PAUSE)
			if gen ~= generation then
				break
			end
			pcall(function()
				onShow:Destroy()
			end)
			onShow = nil
		end
		-- every stage of the chain is built first: the biggest one decides where it stands
		local models = {}
		local bottom, radius = 0, 1
		for stage = chain.From, chain.To do
			local m = build(chain.Def, stage, "High")
			if not m then
				break
			end
			models[stage] = m
			local b, _, r = extentOf(m)
			bottom, radius = math.min(bottom, b), math.max(radius, r)
			task.wait()
		end
		if gen ~= generation or not models[chain.To] then
			for _, m in pairs(models) do
				pcall(function()
					m:Destroy()
				end)
			end
			break
		end
		local origin, look, char = playerFrame()
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
		local pose, ground = poseAt(spot, bottom, -look, char, origin.Y - 3)
		local parent = getFolder()
		local model = models[chain.From]
		model:PivotTo(pose)
		model.Parent = parent
		task.wait(K.LOOK)
		for si, st in ipairs(chain.Steps) do
			if gen ~= generation then
				break
			end
			if si > 1 then
				task.wait(K.STEP_PAUSE)
				if gen ~= generation then
					break
				end
			end
			local toModel = models[st.To]
			local okColors, a, b = pcall(PetBuilder.EvolutionColors, chain.Def, st.To)
			local handle = EvolutionFx.Play(model, toModel, pose, {
				Parent = parent,
				Colors = okColors and { a, b } or nil,
				Stage = st.To,
				Ground = ground,
			})
			current = handle
			while not handle.Done do
				if gen ~= generation then
					pcall(handle.Stop)
					break
				end
				task.wait(0.1)
			end
			if current == handle then
				current = nil
			end
			model = toModel
		end
		-- a stage built but never shown (stopped part-way) goes away
		for _, m in pairs(models) do
			if m ~= model then
				pcall(function()
					m:Destroy()
				end)
			end
		end
		if gen ~= generation then
			pcall(function()
				model:Destroy()
			end)
			break
		end
		if ci == #chains then
			rest(model, chain.Def, chain.To, spot, radius)
		else
			onShow = model
		end
	end
	if onShow and gen ~= generation then
		pcall(function()
			onShow:Destroy()
		end)
	end
	busy = busy - 1
	return true
end

function DevPetShow.Handle(action, payload)
	if type(action) ~= "string" then
		return false
	end
	payload = type(payload) == "table" and payload or {}
	if not (PetBuilder and PetCatalog) then
		warn("[DevPetShow] PetBuilder / PetCatalog are missing")
		return false
	end
	if action == "Spawn" then
		local ok, result = pcall(spawnPet, payload)
		if not ok then
			warn("[DevPetShow] Spawn failed: " .. tostring(result))
		end
		return ok and result == true
	end
	if action ~= "Lineup" and action ~= "Evolve" and action ~= "Clear" then
		return false
	end
	generation = generation + 1
	local gen = generation
	clearAll()
	if action == "Clear" then
		return true
	end
	task.spawn(function()
		local fn = (action == "Lineup") and lineup or evolveReel
		local ok, err = pcall(fn, payload, gen)
		if not ok then
			warn("[DevPetShow] " .. action .. " failed: " .. tostring(err))
			busy = math.max(0, busy - 1)
		end
	end)
	return true
end

function DevPetShow.Count()
	local n = 0
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") then
				n = n + 1
			end
		end
	end
	return n
end

function DevPetShow.Busy()
	return busy > 0
end

function DevPetShow.Folder()
	return folder
end

function DevPetShow.Init()
	if initialized then
		return
	end
	initialized = true
	local ok, remote = pcall(Remotes.Get, "DevPetShow")
	if not (ok and remote) then
		warn("[DevPetShow] the DevPetShow remote is missing")
		return
	end
	remote.OnClientEvent:Connect(function(action, payload)
		DevPetShow.Handle(action, payload)
	end)
end

return DevPetShow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="874">
            <Properties>
              <string name="Name">DungeonController</string>
              <string name="Source"><![CDATA[-- DungeonController (client, Phase 5, dungeonclient W4): the Dungeon window, the run card, the loot / chest toasts, the
-- End card and the dungeon mood (ARCHITECTURE_V3.md "Phase 5 build contract" 5.3, 5.6, 5.7, 6.4, 6.6).
--
--   DungeonController.Init()
--   DungeonController.Open(floor|nil, portal|nil) -> bool   the Dungeon side panel (Portal_Dungeon's DungeonPrompt is
--                                             handed over by ArenaController; OpenPanel("Dungeon", { Floor }) from the
--                                             server: the tutorial / the prompt). Refused (false) inside a run / a match.
--   DungeonController.Close()
--   DungeonController.IsOpen() -> bool
--   DungeonController.Request(action, a, b) -> bool   DungeonRequest(action, a, b), spaced per action (K.FIRE_GAP);
--                                             the server validates everything (DungeonService ladder + cooldowns)
--   DungeonController.GetState() -> { Window, Floor, Lobby, Run, End, Loot, Totals, Ready, Lit, CardMode, Countdown, Fade,
--                                     Door }
--   DungeonController.Opened / Closed (Util.Signal)
--
-- What the player sees
--   * The Dungeon window (a NeonKit side panel, 640 x 860 design px, Purple; docked right on landscape screens, a
--     bottom sheet on portrait phones; never dims the screen): the record ("Best: floor 5 - 7 clears - 12 runs") and
--     the team power; the 12 floors (element orb, name, "Cleared" / "Recommended power 512" / "Clear floor 6 first";
--     the next floor to beat marked NEXT); then the party box: SOLO / PARTY + the open parties ("Ava's party - Floor 3
--     - 2/4 - JOIN", "in room 2 - JOIN"), or the own party (members with READY ticks, team power, the leader's crown
--     and KICK (x), READY / START / LEAVE, the countdown "Dungeon in 5..." / "Starting in 30 - press READY").
--     READY flips at once (optimistic) and the next Lobby payload says what the server decided.
--   * The run card (ScreenGui NimbusDungeonRun): on desktops a side card at the right edge between the enemy list and
--     the battle buttons ("Floor 3 - Frozen Crypt", "Room 2 / 4" pips with the boss room crowned, "Wave 1 / 3",
--     the status: "Walk into the room", "Go to the door and press E" / "Waiting for 1 more (Ava)" (dungeon-fixes
--     decision 2: no room changes by timer; the door's EnterPrompt E goes through ProximityPromptService on the
--     server, this controller sends nothing for it), "Open your chest!", member chips with Downed / Left, the
--     loot so far, LEAVE (two presses -> DungeonRequest("Quit")) and CHEST in the treasure alcove); on phones a one-line
--     chip in Roblox's top band. The party countdown uses the same card while the window is closed. Loot and chest
--     toasts flash inside it ("Room 2 cleared! +$340 +24 tokens +70 XP"). The End card (totals, first clear, unlock,
--     new best) sits at the right (desktop / landscape) or under the top bar (portrait), never in the centre.
--   * Lighting: LightingStack.Push("Dungeon", preset, 1) when a run starts (darker ambient, ColorCorrection Brightness
--     -0.12 / Contrast 0.1 / a warm grey tint, Atmosphere density +0.15); Pop("Dungeon", 1) on End or when the player
--     is no longer in the pocket (InBattle released).
--   * Doors: the room models' DoorOpen / EntranceOpen attributes play a local slide (copies of the bars sink into the
--     floor) in the player's own pocket.
--   * The room change fade (DungeonState "Fade" { Out, Hold, In }): ONE black full-screen Frame in its own ScreenGui
--     NimbusDungeonFade (IgnoreGuiInset, DisplayOrder K.FADE_ORDER 25: above the HUD 10, the battle HUD / run card 12
--     and the windows 20-23, below Notify 30); tweens to black over Out, holds (until the next room's Run payload,
--     at least Hold), back over In; never stuck: a FADE_SAFETY 3 s clear, End and leaving the run clear it at once.
-- Remotes: DungeonState (in), OpenPanel (in), DungeonRequest (out). One side panel at a time: opening it closes the
-- menu windows, the Pet Index, the Fusion / Care windows and the Arena windows; theirs close this one. Esc / gamepad
-- B / the red X / walking 40 studs away from the gate close it. Text is designed at 1080p (>= 18 design px).
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local State = require(Client:WaitForChild("State"))

local DungeonController = {}
DungeonController.Opened = Util.Signal()
DungeonController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design px of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- the windows' layer (like the Arena windows)
	RUN_ORDER = 12, -- the run card: above the HUD (10) and the hotbar (11), below the windows
	PREF_W = 640,
	PREF_H = 860,
	SHORT = 560, -- a docked window lower than this uses the compact rows (landscape phones)
	FIRE_GAP = 0.3, -- seconds between two sends of the same request
	WALK_AWAY = 40, -- studs from the gate that close a window opened there
	FLOORS = 12,
	ROW_H = 66,
	ROW_H_SHORT = 52,
	MEMBER_H = 46,
	MEMBER_H_SHORT = 40,
	CARD_W = 330, -- the desktop run card
	CHIP_H = 50, -- the phone chip (design px; scale 0.8)
	END_W = 400,
	LEAVE_CONFIRM = 3, -- seconds the first LEAVE press stays armed
	TOAST_SECONDS = 4,
	END_SECONDS = 14, -- the End card hides by itself after this
	TREASURE = 45,
	FADE_ORDER = 25, -- the room change fade: above the HUD (10), the run card (12) and the windows (20-23), below Notify (30)
	FADE_SAFETY = 3, -- a fade never stays on longer than this (seconds)
	FADE_MAX_STEP = 2, -- Out / Hold / In are clamped to 0..this
	TICK = 0.25, -- the light loop
	BACK_ACTION = "NimbusDungeonBack",
	LIGHT_ID = "Dungeon",
	LIGHT_SECONDS = 1,
}

local Colors = Theme.Colors
local NEON = Theme.Neon or {}
local WHITE = Colors.White
local INK = Colors.PanelInk or Color3.fromRGB(8, 10, 28)
local C = {
	Accent = Theme.NeonColor and Theme.NeonColor("Dungeon") or Color3.fromRGB(176, 104, 255),
	Gold = NEON.Gold or Color3.fromRGB(255, 196, 64),
	Green = NEON.Green or Color3.fromRGB(72, 224, 120),
	Red = NEON.Red or Color3.fromRGB(255, 76, 100),
	Blue = NEON.Blue or Color3.fromRGB(64, 170, 255),
	Grey = NEON.Grey or Color3.fromRGB(150, 166, 204),
	Muted = Color3.fromRGB(176, 184, 214),
	Row = Color3.fromRGB(30, 36, 78),
	RowDark = Color3.fromRGB(18, 22, 52),
	Locked = Color3.fromRGB(110, 116, 150),
	Power = Color3.fromRGB(255, 214, 110),
	Cash = Color3.fromRGB(120, 230, 140),
	Token = Colors.Token or Color3.fromRGB(255, 210, 90),
	Gem = Colors.Gem or Color3.fromRGB(84, 196, 246),
}

-- glyphs as UTF-8 escapes (the source stays ASCII)
local G = {
	Swords = "\226\154\148",
	Crown = "\240\159\145\145",
	Check = "\226\156\147",
	Lock = "\240\159\148\146",
	Cloud = "\226\152\129",
	Gem = (Theme.Currency and Theme.Currency.Gems and Theme.Currency.Gems.Glyph) or "\226\151\134",
	Skull = "\240\159\146\128",
	Dot = "\194\183",
	Cross = "\226\156\149",
	Chest = "\240\159\142\129",
	Star = "\226\152\133",
	Pip = "\226\151\143",
	PipOff = "\226\151\139",
	Torch = "\240\159\148\165",
	Hourglass = "\226\143\179",
}

-- the dungeon mood (contract 5.6): absolute values for the ambient / colour correction, the haze relative to the base
local PRESET = {
	Lighting = { Ambient = Color3.fromRGB(70, 62, 86), OutdoorAmbient = Color3.fromRGB(86, 78, 104) },
	ColorCorrection = { Brightness = -0.12, Contrast = 0.1, TintColor = Color3.fromRGB(236, 226, 212) },
	AtmosphereAdd = 0.15,
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local U = {} -- gui references
local S = {
	Open = false,
	Token = 0,
	Floor = nil, -- the selected floor in the window
	Lobby = nil, -- last DungeonState "Lobby"
	LobbyAt = 0,
	Run = nil, -- last "Run" (nil outside a run)
	RunAt = 0,
	PhaseAt = 0, -- os.clock() when the run's State / Phase last changed
	PhaseKey = nil,
	End = nil, -- last "End" (the End card)
	EndAt = 0,
	Loot = nil, -- last "Loot"
	Totals = { Cash = 0, Tokens = 0, Xp = 0, Gems = 0 },
	Toast = nil, -- { Text, Color, Until }
	ReadyWant = nil, -- optimistic READY until the next Lobby payload
	Lit = false,
	LeaveArmed = 0,
	LastFire = {},
	BackBound = false,
	AtPortal = nil,
	Hint = nil, -- { Text, Until } the window footer
	Built = false,
	Short = false,
	CardMode = nil, -- "Card" | "Chip" | nil
	Warned = {},
	Doors = {}, -- connections watching the pocket's doors
	Pocket = nil,
}

local H = {} -- helpers
local W = {} -- the window
local R = {} -- the run card / End card / lighting / doors

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
function H.warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[DungeonController] " .. key .. ": " .. tostring(err))
	end
end

function H.safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		H.warnOnce(key, err)
	end
	return ok
end

function H.optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

function H.catalog()
	if H.BC == nil then
		H.BC = H.optionalShared("BattleCatalog") or false
	end
	return H.BC or nil
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.frame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

function H.text(parent, name, text, role, size, color, props)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = tostring(text or "")
	Theme.Style(label, role or "Body", { Size = size, Color = color or WHITE, Stroke = 1 })
	Theme.TextOutline(label, 1.5, INK, 0.1)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

function H.corner(parent, px)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0, px or 10), Parent = parent })
end

function H.stroke(parent, color, thickness, transparency)
	return Util.Create("UIStroke", {
		Color = color or INK,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function H.list(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function H.pad(parent, l, t, r, b)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		Parent = parent,
	})
end

function H.clear(frame)
	for _, c in ipairs(frame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function H.commas(n)
	return Util.Commas(math.floor((tonumber(n) or 0) + 0.5))
end

function H.clock(seconds)
	local s = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

function H.tween(inst, seconds, goal, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function H.attr(name)
	return LocalPlayer and LocalPlayer:GetAttribute(name) or nil
end

function H.inMatch()
	return H.attr(Config.Attr.InMatch) == true
end

-- the dungeon run id while the player is in a run (InBattle = "D12"), else nil
function H.runAttr()
	local v = H.attr((Config.Attr and Config.Attr.InBattle) or "InBattle")
	if type(v) == "string" and v:sub(1, 1) == "D" then
		return v
	end
	return nil
end

function H.viewport()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if not vp or vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

function H.isPhone()
	local vp = H.viewport()
	return math.min(vp.X, vp.Y) < 500
end

function H.rootPosition()
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

function H.positionOf(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(function()
			return inst:GetBoundingBox()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- floor data from the catalog: { Name, Element, Floor } (a plain fallback when the catalog is missing)
function H.floorInfo(f)
	local BC = H.catalog()
	local list = BC and BC.DungeonFloors
	local info = type(list) == "table" and list[f] or nil
	if type(info) == "table" then
		return info
	end
	return { Name = "Floor " .. tostring(f), Element = nil, Floor = f }
end

function H.floorCount()
	local BC = H.catalog()
	local D = BC and BC.Dungeon
	return math.max(1, math.floor(tonumber(D and D.Floors) or K.FLOORS))
end

function H.elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	return info and info.Color or C.Accent
end

function H.recommended(f)
	local BC = H.catalog()
	if BC and type(BC.DungeonPower) == "function" then
		local ok, p = pcall(BC.DungeonPower, f, 1)
		if ok and tonumber(p) then
			return math.max(1, math.ceil(tonumber(p) - 1e-9))
		end
	end
	return nil
end

function H.dungeonNumber(field, default)
	local BC = H.catalog()
	local D = BC and BC.Dungeon
	return tonumber(D and D[field]) or default
end

-- the saved record: the Lobby payload's Record (fresh from the server) or State.Dungeon()
function H.record()
	local rec = S.Lobby and type(S.Lobby.Record) == "table" and S.Lobby.Record or nil
	local out = { Best = 0, Cleared = {}, Runs = 0, Clears = 0 }
	if not rec and type(State.Dungeon) == "function" then
		local ok, d = pcall(State.Dungeon)
		rec = ok and type(d) == "table" and d or nil
	end
	if rec then
		out.Best = math.floor(tonumber(rec.Best) or 0)
		out.Runs = math.floor(tonumber(rec.Runs) or 0)
		out.Clears = math.floor(tonumber(rec.Clears) or 0)
		if type(rec.Cleared) == "table" then
			for i = 1, K.FLOORS do
				if rec.Cleared[i] == true then
					out.Cleared[i] = true
				end
			end
		end
	end
	return out
end

-- floor f is open for the player as a leader: Best >= f - 1 (members are carried; the server decides)
function H.unlocked(f, rec)
	rec = rec or H.record()
	return f <= 1 or rec.Best >= f - 1 or rec.Cleared[f - 1] == true
end

function H.nextFloor(rec)
	rec = rec or H.record()
	return math.min(H.floorCount(), math.max(1, rec.Best + 1))
end

----------------------------------------------------------------------
-- The player's team power (team -> equipped -> best owned; training skipped), like the server's TeamSpec
----------------------------------------------------------------------
function H.entryOf(key)
	local def = nil
	if type(State.DefOf) == "function" then
		local ok, result = pcall(State.DefOf, key)
		def = ok and type(result) == "table" and result or nil
	end
	if not def then
		return nil
	end
	local level = 1
	if type(State.PetLevel) == "function" then
		local ok, lv = pcall(State.PetLevel, key)
		level = ok and tonumber(lv) or 1
	end
	local g = {}
	if type(State.PetGrowth) == "function" then
		local ok, result = pcall(State.PetGrowth, key)
		g = ok and type(result) == "table" and result or {}
	end
	return { Def = def, Level = level, Key = key, Evo = tonumber(g.Evo) or 0,
		Train = { Speed = g.Speed or 0, Physique = g.Physique or 0, Ability = g.Ability or 0, Defense = g.Defense or 0 } }
end

function H.collect(keys)
	local out = {}
	for _, key in ipairs(type(keys) == "table" and keys or {}) do
		local busy = false
		if type(State.IsTraining) == "function" then
			local ok, b = pcall(State.IsTraining, key)
			busy = ok and b == true
		end
		if type(key) == "string" and not busy then
			local e = H.entryOf(key)
			if e then
				out[#out + 1] = e
			end
		end
	end
	return out
end

function H.teamPower()
	local now = os.clock()
	if H.PowerAt and now - H.PowerAt < 1 and H.PowerSnap == State.Get() then
		return H.Power
	end
	H.PowerAt, H.PowerSnap = now, State.Get()
	H.Power = H.teamPowerNow()
	return H.Power
end

function H.teamPowerNow()
	local BC = H.catalog()
	if not BC or type(BC.TeamPower) ~= "function" then
		return 0
	end
	local list = {}
	if type(State.Teams) == "function" then
		local ok, t = pcall(State.Teams)
		if ok and type(t) == "table" and type(t.Presets) == "table" then
			list = H.collect(t.Presets[t.Active or 1])
		end
	end
	if #list == 0 and type(State.EquippedList) == "function" then
		local ok, eq = pcall(State.EquippedList)
		list = H.collect(ok and eq or nil)
	end
	if #list == 0 and type(State.Keys) == "function" then
		local ok, keys = pcall(State.Keys)
		list = H.collect(ok and keys or nil)
		if type(BC.UnitPower) == "function" then
			for _, e in ipairs(list) do
				local okP, p = pcall(BC.UnitPower, e)
				e.P = okP and tonumber(p) or 0
			end
			table.sort(list, function(a, b)
				if a.P ~= b.P then
					return a.P > b.P
				end
				return tostring(a.Key) < tostring(b.Key)
			end)
		end
		while #list > 3 do
			table.remove(list)
		end
	end
	local ok, p = pcall(BC.TeamPower, list)
	return ok and math.floor((tonumber(p) or 0) + 0.5) or 0
end

----------------------------------------------------------------------
-- Requests (DungeonRequest; spaced here, validated on the server)
----------------------------------------------------------------------
function H.request(action, a, b)
	local now = os.clock()
	local key = tostring(action) .. "|" .. tostring(a)
	if S.LastFire[key] and now - S.LastFire[key] < K.FIRE_GAP then
		return false
	end
	if not H.remote then
		local ok, remote = pcall(Remotes.Get, "DungeonRequest")
		H.remote = ok and remote or nil
	end
	if not H.remote then
		return false
	end
	S.LastFire[key] = now
	local ok, err = pcall(function()
		H.remote:FireServer(action, a, b)
	end)
	if not ok then
		H.warnOnce("DungeonRequest " .. tostring(action), err)
	end
	return ok
end

function H.hint(text, seconds)
	S.Hint = { Text = tostring(text), Until = os.clock() + (seconds or 4) }
	if S.Open then
		H.safe("footer", W.footer)
	end
end

function H.avoidRight(x)
	local hb = H.controller("HotbarController")
	if hb and type(hb.SetAvoidRight) == "function" then
		pcall(hb.SetAvoidRight, x)
	end
end

----------------------------------------------------------------------
-- The window (CloudUI.Panel on NeonKit.Dock)
----------------------------------------------------------------------
function W.build()
	if S.Built then
		return true
	end
	S.Built = true
	local holder = H.frame(U.Gui, "Window_Dungeon", { Size = UDim2.fromOffset(K.PREF_W, K.PREF_H), Visible = false, ZIndex = 3 })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	U.Dock = NeonKit.Dock(holder, U.Fit, K.PREF_W, K.PREF_H)
	local panel = CloudUI.Panel({
		Name = "DungeonPanel",
		Title = "The Dungeon",
		Closable = true,
		Category = "Dungeon",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			DungeonController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	-- the record line
	U.Top = H.frame(content, "Top", { Size = UDim2.new(1, 0, 0, 30) })
	U.Record = H.text(U.Top, "Record", "", "Heading", 19, WHITE, { Size = UDim2.new(1, -150, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	U.Power = H.text(U.Top, "Power", "", "Heading", 19, C.Power, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 150, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	-- the floor list
	U.Floors = Instance.new("ScrollingFrame")
	U.Floors.Name = "Floors"
	U.Floors.BackgroundTransparency = 0.25
	U.Floors.BackgroundColor3 = C.RowDark
	U.Floors.BorderSizePixel = 0
	U.Floors.ScrollBarThickness = 8
	U.Floors.ScrollBarImageColor3 = C.Accent
	U.Floors.ScrollingDirection = Enum.ScrollingDirection.Y
	U.Floors.AutomaticCanvasSize = Enum.AutomaticSize.Y
	U.Floors.CanvasSize = UDim2.new(0, 0, 0, 0)
	U.Floors.Position = UDim2.fromOffset(0, 36)
	U.Floors.Parent = content
	H.corner(U.Floors, 12)
	H.pad(U.Floors, 8, 8, 14, 8)
	H.list(U.Floors, Enum.FillDirection.Vertical, 6)
	U.FloorRows = {}
	for f = 1, H.floorCount() do
		U.FloorRows[f] = W.floorRow(f)
	end
	-- the party box
	U.Party = Instance.new("ScrollingFrame")
	U.Party.Name = "Party"
	U.Party.BackgroundTransparency = 0.2
	U.Party.BackgroundColor3 = C.RowDark
	U.Party.BorderSizePixel = 0
	U.Party.ScrollBarThickness = 6
	U.Party.ScrollBarImageColor3 = C.Accent
	U.Party.ScrollingDirection = Enum.ScrollingDirection.Y
	U.Party.AutomaticCanvasSize = Enum.AutomaticSize.Y
	U.Party.CanvasSize = UDim2.new(0, 0, 0, 0)
	U.Party.Parent = content
	H.corner(U.Party, 12)
	H.pad(U.Party, 10, 8, 10, 8)
	H.list(U.Party, Enum.FillDirection.Vertical, 6)
	-- the footer hint
	U.Footer = H.text(content, "Footer", "", "Body", 18, C.Muted, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return true
end

-- one floor row (a TextButton: tap to select it)
function W.floorRow(f)
	local info = H.floorInfo(f)
	local color = H.elementColor(info.Element)
	local row = Instance.new("TextButton")
	row.Name = "Floor" .. f
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.BackgroundColor3 = C.Row
	row.Size = UDim2.new(1, 0, 0, K.ROW_H)
	row.LayoutOrder = f
	row.Parent = U.Floors
	H.corner(row, 10)
	local rim = H.stroke(row, Theme.Darken(color, 0.35), 2, 0.2)
	local stripe = H.frame(row, "Stripe", { BackgroundTransparency = 0, BackgroundColor3 = color, Size = UDim2.new(0, 6, 1, -12), Position = UDim2.fromOffset(4, 6) })
	H.corner(stripe, 3)
	local orbHolder = H.frame(row, "OrbHolder", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0, 48, 1, 0) })
	local orb = NeonKit.Orb(orbHolder, color, 44)
	local num = H.text(orb, "Num", tostring(f), "Title", 22, WHITE, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	local name = H.text(row, "FloorName", info.Name, "Heading", 21, WHITE, {
		Position = UDim2.fromOffset(70, 6),
		Size = UDim2.new(1, -190, 0, 28),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local sub = H.text(row, "Status", "", "Body", 18, C.Muted, {
		Position = UDim2.fromOffset(70, 34),
		Size = UDim2.new(1, -190, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local chip = H.frame(row, "Chip", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(106, 34),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.RowDark,
	})
	H.corner(chip, 17)
	local chipRim = H.stroke(chip, color, 2, 0)
	local chipText = H.text(chip, "Text", "", "Button", 18, WHITE, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	row.Activated:Connect(function()
		H.safe("pick floor", W.pick, f)
	end)
	return { Root = row, Rim = rim, Orb = orb, Num = num, Name = name, Sub = sub, Chip = chip, ChipRim = chipRim, ChipText = chipText, Color = color }
end

-- a tap on floor f: select it (the leader of a party also moves the party's floor)
function W.pick(f)
	local rec = H.record()
	local mine = S.Lobby and S.Lobby.Mine or nil
	if mine and LocalPlayer and mine.Leader ~= LocalPlayer.UserId then
		H.hint("The party leader picks the floor")
		return
	end
	if not H.unlocked(f, rec) then
		H.hint("Clear floor " .. (f - 1) .. " first")
		return
	end
	S.Floor = f
	if mine then
		H.request("SetFloor", f)
	end
	W.refresh()
end

function W.selected()
	local mine = S.Lobby and S.Lobby.Mine or nil
	if mine and tonumber(mine.Floor) then
		return math.floor(mine.Floor)
	end
	local rec = H.record()
	local f = S.Floor or H.nextFloor(rec)
	if not H.unlocked(f, rec) then
		f = H.nextFloor(rec)
	end
	return f
end

function W.refreshFloors(rec, short)
	local sel = W.selected()
	local nextF = H.nextFloor(rec)
	local power = H.teamPower()
	for f, ui in ipairs(U.FloorRows) do
		local open = H.unlocked(f, rec)
		local cleared = rec.Cleared[f] == true
		local rp = H.recommended(f)
		local h = short and K.ROW_H_SHORT or K.ROW_H
		ui.Root.Size = UDim2.new(1, 0, 0, h)
		ui.Name.Position = UDim2.fromOffset(70, short and 2 or 6)
		ui.Sub.Position = UDim2.fromOffset(70, short and 26 or 34)
		ui.Sub.Size = UDim2.new(1, -190, 0, short and 22 or 24)
		local status, subColor, chip, chipColor
		if not open then
			status = G.Lock .. " Clear floor " .. (f - 1) .. " first"
			subColor = C.Muted
			chip, chipColor = "LOCKED", C.Locked
		elseif cleared then
			status = G.Check .. " Cleared"
			subColor = C.Green
			chip, chipColor = "CLEARED", C.Green
		else
			status = "Recommended power " .. (rp and H.commas(rp) or "?")
			subColor = (rp and power >= rp) and C.Green or C.Power
			if f == nextF then
				chip, chipColor = "NEXT", C.Gold
			else
				chip, chipColor = "OPEN", C.Blue
			end
		end
		ui.Sub.Text = status
		ui.Sub.TextColor3 = subColor
		ui.ChipText.Text = chip
		ui.ChipRim.Color = chipColor
		ui.ChipText.TextColor3 = (chip == "LOCKED") and C.Muted or WHITE
		ui.Root.BackgroundColor3 = (f == sel) and Theme.Lighten(C.Row, 0.14) or (open and C.Row or C.RowDark)
		ui.Rim.Color = (f == sel) and C.Accent or Theme.Darken(ui.Color, 0.35)
		ui.Rim.Thickness = (f == sel) and 3 or 2
		ui.Rim.Transparency = (f == sel) and 0 or 0.2
		ui.Name.TextColor3 = open and WHITE or C.Muted
		ui.Root:SetAttribute("Selected", f == sel)
		ui.Root:SetAttribute("Unlocked", open)
		ui.Root:SetAttribute("Cleared", cleared)
	end
end

-- a button inside the party box (NeonKit); returns the TextButton
function W.button(parent, name, text, color, size, order, callback, variant)
	return NeonKit.Button({
		Name = name,
		Text = text,
		Color = color,
		Variant = variant or "Primary",
		Size = size,
		TextSize = 20,
		LayoutOrder = order,
		Parent = parent,
		Callback = function()
			H.safe(name, callback)
		end,
	})
end

function W.setDisabled(button, disabled)
	if button then
		button:SetAttribute("Disabled", disabled == true)
	end
end

-- seconds left of the party countdown (ticks locally between two Lobby payloads)
function W.countdown(mine)
	local n = mine and tonumber(mine.Countdown)
	if not n then
		return nil
	end
	return math.max(0, math.ceil(n - (os.clock() - S.LobbyAt) - 1e-6))
end

function W.allReady(mine)
	for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" and m.Ready ~= true and m.UserId ~= mine.Leader then
			return false
		end
	end
	return true
end

function W.myReady(mine)
	if S.ReadyWant ~= nil then
		return S.ReadyWant
	end
	for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" and LocalPlayer and m.UserId == LocalPlayer.UserId then
			return m.Ready == true
		end
	end
	return false
end

function W.countdownText(mine)
	local left = W.countdown(mine)
	if not left then
		return nil
	end
	if W.allReady(mine) then
		return "Dungeon in " .. left .. "..."
	end
	return "Starting in " .. left .. " - press READY"
end

-- the party box when the player has no party: SOLO / PARTY + the open parties
function W.partyNone(box, short, sel)
	local info = H.floorInfo(sel)
	H.text(box, "Title", "Floor " .. sel .. " " .. G.Dot .. " " .. tostring(info.Name), "Heading", 20, WHITE, {
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	})
	local row = H.frame(box, "Buttons", { Size = UDim2.new(1, 0, 0, short and 46 or 52), LayoutOrder = 2 })
	H.list(row, Enum.FillDirection.Horizontal, 10)
	local bw = UDim2.new(0.5, -5, 1, 0)
	U.Solo = W.button(row, "SoloButton", "SOLO", C.Green, bw, 1, function()
		if H.request("Solo", W.selected()) then
			H.hint("Starting floor " .. W.selected() .. "...", 3)
		end
	end)
	U.Create = W.button(row, "PartyButton", "PARTY", C.Accent, bw, 2, function()
		if H.request("Create", W.selected()) then
			H.hint("Party made! Friends can JOIN it here", 4)
		end
	end)
	local parties = {}
	for _, p in ipairs(S.Lobby and type(S.Lobby.Parties) == "table" and S.Lobby.Parties or {}) do
		if type(p) == "table" then
			parties[#parties + 1] = p
		end
	end
	local maxRows = W.maxParties(short)
	H.text(box, "OpenTitle", (#parties > 0) and "Open parties" or "No open parties yet - make one!", "Heading", 18, C.Muted, {
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 3,
	})
	for i, p in ipairs(parties) do
		if i > maxRows then
			break
		end
		W.partyRow(box, p, i, short)
	end
end

function W.partyRow(box, p, i, short)
	local row = H.frame(box, "Open" .. i, { BackgroundTransparency = 0, BackgroundColor3 = C.Row, Size = UDim2.new(1, 0, 0, short and 40 or 44), LayoutOrder = 3 + i })
	H.corner(row, 10)
	local count = tostring(p.Count or 1) .. "/" .. tostring(p.Max or 4)
	local where = p.InRun and ("in room " .. tostring(p.Room or 1)) or ("Floor " .. tostring(p.Floor or 1))
	H.text(row, "Text", tostring(p.LeaderName or "Someone") .. "'s party " .. G.Dot .. " " .. where .. " " .. G.Dot .. " " .. count, "Body", 18, WHITE, {
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -120, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local join = W.button(row, "JoinButton", p.Open and "JOIN" or (p.InRun and "BUSY" or "FULL"), C.Blue, UDim2.fromOffset(96, short and 34 or 38), 1, function()
		if p.Open and H.request("Join", p.Leader) then
			H.hint("Joining " .. tostring(p.LeaderName or "the") .. "'s party...", 3)
		end
	end)
	join.AnchorPoint = Vector2.new(1, 0.5)
	join.Position = UDim2.new(1, -6, 0.5, 0)
	W.setDisabled(join, p.Open ~= true)
	join:SetAttribute("Leader", p.Leader)
end

-- the party box of the player's own party
function W.partyMine(box, short, mine)
	local me = LocalPlayer and LocalPlayer.UserId
	local leader = mine.Leader == me
	local f = math.floor(tonumber(mine.Floor) or 1)
	local info = H.floorInfo(f)
	H.text(box, "Title", (leader and "Your party" or "Party") .. " " .. G.Dot .. " Floor " .. f .. " " .. G.Dot .. " " .. tostring(info.Name), "Heading", 20, WHITE, {
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	})
	local cd = W.countdownText(mine)
	U.Countdown = H.text(box, "Countdown", cd or (leader and "Press START when everyone is READY" or "Press READY, the leader starts"), "Body", 18, cd and C.Gold or C.Muted, {
		Size = UDim2.new(1, 0, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
	})
	local h = short and K.MEMBER_H_SHORT or K.MEMBER_H
	for i, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" then
			local isMe = m.UserId == me
			local ready = m.Ready == true
			if isMe and S.ReadyWant ~= nil and not leader then
				ready = S.ReadyWant
			end
			local row = H.frame(box, "Member" .. i, { BackgroundTransparency = 0, BackgroundColor3 = isMe and Theme.Lighten(C.Row, 0.1) or C.Row, Size = UDim2.new(1, 0, 0, h), LayoutOrder = 10 + i })
			H.corner(row, 10)
			row:SetAttribute("UserId", m.UserId)
			row:SetAttribute("Ready", ready)
			local tick = H.text(row, "Ready", ready and G.Check or G.Hourglass, "Heading", 20, ready and C.Green or C.Muted, {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(0, 28, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			tick:SetAttribute("Ready", ready)
			local name = (m.UserId == mine.Leader and (G.Crown .. " ") or "") .. tostring(m.Name or "?")
			H.text(row, "Name", name, "Body", 19, WHITE, { Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -190, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
			H.text(row, "Power", G.Swords .. " " .. H.commas(m.Power or 0), "Heading", 18, C.Power, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, leader and not isMe and -52 or -10, 0, 0),
				Size = UDim2.new(0, 110, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
			})
			if leader and not isMe then
				local kick = W.button(row, "KickButton", G.Cross, C.Red, UDim2.fromOffset(38, h - 8), 1, function()
					if H.request("Kick", m.UserId) then
						H.hint("Removed " .. tostring(m.Name or "the player"), 3)
					end
				end, "Outline")
				kick.AnchorPoint = Vector2.new(1, 0.5)
				kick.Position = UDim2.new(1, -6, 0.5, 0)
				kick:SetAttribute("UserId", m.UserId)
			end
		end
	end
	-- the buttons come before the member list (a phone's sheet bottom sits under the thumbstick / jump buttons)
	local row = H.frame(box, "Buttons", { Size = UDim2.new(1, 0, 0, short and 46 or 52), LayoutOrder = 3 })
	H.list(row, Enum.FillDirection.Horizontal, 10)
	local bw = UDim2.new(0.5, -5, 1, 0)
	if leader then
		U.Start = W.button(row, "StartButton", "START", C.Green, bw, 1, function()
			if H.request("Start") then
				H.hint(W.allReady(mine) and "Starting..." or "Waiting 30 s for READY...", 3)
			end
		end)
		W.setDisabled(U.Start, W.countdown(mine) ~= nil and W.allReady(mine))
	else
		local want = W.myReady(mine)
		U.Ready = W.button(row, "ReadyButton", want and "NOT READY" or "READY", want and C.Grey or C.Green, bw, 1, function()
			local now = not W.myReady(mine)
			if H.request("Ready", now) then
				S.ReadyWant = now -- optimistic: the next Lobby payload is the truth
				W.refresh()
			end
		end)
	end
	U.LeaveParty = W.button(row, "LeaveButton", "LEAVE", C.Red, bw, 2, function()
		if H.request("Leave") then
			S.ReadyWant = nil
			H.hint("You left the party", 3)
		end
	end, "Outline")
end

-- open parties shown at once: 3 on desktops, 2 on a portrait phone, 1 on a landscape phone (the jump button corner)
function W.maxParties(short)
	if short then
		return 1
	end
	return H.isPhone() and 2 or 3
end

function W.partyHeight(short, mine)
	local h = 16
	if mine then
		local n = #(type(mine.Members) == "table" and mine.Members or {})
		h = h + 26 + 24 + n * ((short and K.MEMBER_H_SHORT or K.MEMBER_H) + 6) + (short and 46 or 52) + 18
	else
		local parties = S.Lobby and type(S.Lobby.Parties) == "table" and #S.Lobby.Parties or 0
		local rows = math.min(parties, W.maxParties(short))
		h = h + 26 + (short and 46 or 52) + 24 + rows * ((short and 40 or 44) + 6) + 18
	end
	return h
end

function W.footer()
	if not U.Footer then
		return
	end
	local text = ""
	if S.Hint and os.clock() < S.Hint.Until then
		text = S.Hint.Text
	else
		local rec = H.record()
		local sel = W.selected()
		local rp = H.recommended(sel)
		local power = H.teamPower()
		if rp and power > 0 and power < rp then
			text = "Your team looks weak for floor " .. sel .. ". Train it, or bring friends!"
		elseif rec.Best >= H.floorCount() then
			text = "Every floor cleared! Run them again for loot."
		else
			text = "Rooms, waves and a boss. Solo or up to 4 friends."
		end
	end
	U.Footer.Text = text
end

function W.layout()
	if not U.Dock then
		return
	end
	U.Dock.Refresh()
	local rect = U.Dock.Rect
	if not rect then
		return
	end
	if S.Open then
		H.avoidRight(rect.mode == "Side" and rect.x or nil)
	end
	S.Short = rect.designH < K.SHORT
end

function W.refresh()
	if not S.Built or not S.Open then
		return
	end
	W.layout()
	local short = S.Short
	local rec = H.record()
	local power = H.teamPower()
	U.Record.Text = "Best: floor " .. rec.Best .. " " .. G.Dot .. " " .. rec.Clears .. " clears " .. G.Dot .. " " .. rec.Runs .. " runs"
	U.Power.Text = G.Swords .. " " .. H.commas(power)
	W.refreshFloors(rec, short)
	-- the party box (rebuilt: a handful of frames, only on a payload / a tap)
	local mine = S.Lobby and type(S.Lobby.Mine) == "table" and S.Lobby.Mine or nil
	local sig = W.partySig(mine, short)
	if sig ~= S.PartySig then
		S.PartySig = sig
		H.clear(U.Party)
		U.Countdown, U.Start, U.Ready, U.Solo, U.Create = nil, nil, nil, nil, nil
		if mine then
			W.partyMine(U.Party, short, mine)
		else
			W.partyNone(U.Party, short, W.selected())
		end
	elseif mine and U.Countdown then
		local cd = W.countdownText(mine)
		if cd then
			U.Countdown.Text = cd
			U.Countdown.TextColor3 = C.Gold
		end
	end
	local contentH = U.Holder.Size.Y.Offset - 82
	local partyH = W.partyHeight(short, mine)
	-- phones: no footer line (the bottom edge of the sheet sits under Roblox's thumbstick / jump buttons)
	local footerH = H.isPhone() and 0 or 26
	U.Footer.Visible = footerH > 0
	local listH = math.max(short and 96 or 150, contentH - 36 - partyH - footerH - 12)
	U.Floors.Size = UDim2.new(1, 0, 0, listH)
	U.Party.Position = UDim2.fromOffset(0, 36 + listH + 6)
	U.Party.Size = UDim2.new(1, 0, 0, math.max(60, contentH - 36 - listH - 6 - footerH - 6))
	W.footer()
	if S.ScrollTo and U.Dock.Rect and U.Dock.Rect.mode == "Sheet" then
		-- (a portrait sheet keeps the list at the top: its rows scrolled above the sheet would count as covered screen
		-- for the coverage rule, which does not clip scrolling frames)
		S.ScrollTo = nil
		U.Floors.CanvasPosition = Vector2.new(0, 0)
	end
	if S.ScrollTo then
		-- bring the selected floor into view once after opening
		local f = S.ScrollTo
		S.ScrollTo = nil
		local rowH = (short and K.ROW_H_SHORT or K.ROW_H) + 6
		local top = 8 + (f - 1) * rowH
		local maxY = math.max(0, 8 + H.floorCount() * rowH + 8 - listH)
		U.Floors.CanvasPosition = Vector2.new(0, math.max(0, math.min(maxY, top - rowH * 0.5)))
	end
end

function W.partySig(mine, short)
	local parts = { tostring(short) }
	if mine then
		parts[#parts + 1] = "m" .. tostring(mine.Leader) .. ":" .. tostring(mine.Floor) .. ":" .. tostring(mine.Countdown ~= nil) .. ":" .. tostring(S.ReadyWant)
			.. ":" .. tostring(S.LobbyAt)
		for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
			if type(m) == "table" then
				parts[#parts + 1] = tostring(m.UserId) .. tostring(m.Ready) .. tostring(m.Power)
			end
		end
	else
		parts[#parts + 1] = "n" .. tostring(W.selected())
		for _, p in ipairs(S.Lobby and type(S.Lobby.Parties) == "table" and S.Lobby.Parties or {}) do
			if type(p) == "table" then
				parts[#parts + 1] = tostring(p.Leader) .. ":" .. tostring(p.Floor) .. ":" .. tostring(p.Count) .. ":" .. tostring(p.Open) .. ":" .. tostring(p.Room)
			end
		end
	end
	return table.concat(parts, ",")
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
function W.onBack(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		DungeonController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

function W.syncBack()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, W.onBack, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function W.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "ArenaController", "ObbyController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function DungeonController.Open(floorIndex, portal)
	if not initialized then
		DungeonController.Init()
	end
	if not U.Gui or H.inMatch() then
		return false
	end
	if S.Run or H.runAttr() then
		return false -- inside a run the run card is the dungeon's UI
	end
	if not W.build() then
		return false
	end
	local n = tonumber(floorIndex)
	if n and n >= 1 and n <= H.floorCount() then
		S.Floor = math.floor(n)
	end
	S.AtPortal = (typeof(portal) == "Instance") and portal or nil
	local was = S.Open
	if not was then
		W.closeOthers()
	end
	S.Open = true
	S.Token = S.Token + 1
	S.PartySig = nil
	if not was then
		S.ScrollTo = W.selected()
	end
	W.syncBack()
	U.Holder.Visible = true
	if not was then
		U.Pop.Scale = 0.9
		H.tween(U.Pop, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	H.request("Open")
	W.refresh()
	R.refresh()
	if not was then
		DungeonController.Opened:Fire("Dungeon")
	end
	return true
end

function DungeonController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.AtPortal = nil
	S.Token = S.Token + 1
	local mine = S.Token
	W.syncBack()
	H.avoidRight(nil)
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
			U.Pop.Scale = 1
		end
	end)
	R.refresh()
	DungeonController.Closed:Fire("Dungeon")
end

function DungeonController.IsOpen()
	return S.Open == true
end

function DungeonController.Request(action, a, b)
	return H.request(action, a, b)
end

function DungeonController.GetState()
	return {
		Window = S.Open and "Dungeon" or nil,
		Floor = S.Built and W.selected() or S.Floor,
		Lobby = S.Lobby,
		Run = S.Run,
		End = S.End,
		Loot = S.Loot,
		Totals = S.Totals,
		Ready = S.ReadyWant,
		Lit = S.Lit,
		CardMode = S.CardMode,
		Countdown = S.Lobby and S.Lobby.Mine and W.countdown(S.Lobby.Mine) or nil,
		Fade = S.Fade and S.Fade.Phase or nil, -- "Out" | "Hold" | "In" while the room change fade shows
		Door = (S.Run and R.doorWait()) or nil, -- "press" | "wait" | "go" at an open door
	}
end

----------------------------------------------------------------------
-- The run card (desktop side card / phone top-band chip), the toasts and the End card
----------------------------------------------------------------------
function R.build()
	-- (IgnoreGuiInset stays false like every text-carrying gui; R.place converts screen px to the gui area)
	local gui = CloudUI.NewScreenGui("NimbusDungeonRun", K.RUN_ORDER)
	U.RunGui = gui
	-- the side card
	local card = NeonKit.Card({ Name = "RunCard", Size = UDim2.fromOffset(K.CARD_W, 200), Color = C.Accent, Glow = true, Parent = gui })
	card.Root.Visible = false
	U.Card = card
	U.CardScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = card.Root })
	local body = H.frame(card.Body, "List", { Size = UDim2.new(1, 0, 1, 0) })
	H.pad(body, 14, 10, 12, 12)
	H.list(body, Enum.FillDirection.Vertical, 6)
	U.CardList = body
	U.CardTitle = H.text(body, "Title", "", "Heading", 21, WHITE, { Size = UDim2.new(1, 0, 0, 28), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1 })
	U.CardRoom = H.text(body, "Room", "", "Heading", 19, C.Gold, { Size = UDim2.new(1, 0, 0, 26), RichText = false, LayoutOrder = 2 })
	U.CardWave = H.text(body, "Wave", "", "Body", 18, WHITE, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3 })
	U.CardStatus = H.text(body, "Status", "", "Body", 19, WHITE, { Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 4 })
	U.CardToast = H.frame(body, "LootToast", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Darken(C.Gold, 0.55), Size = UDim2.new(1, 0, 0, 58), Visible = false, LayoutOrder = 5 })
	H.corner(U.CardToast, 10)
	H.stroke(U.CardToast, C.Gold, 2, 0)
	H.pad(U.CardToast, 10, 6, 10, 6)
	U.CardToastText = H.text(U.CardToast, "Text", "", "Heading", 19, WHITE, { Size = UDim2.new(1, 0, 1, 0), TextWrapped = true })
	U.CardMembers = H.frame(body, "Members", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 6 })
	Util.Create("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 26), CellPadding = UDim2.fromOffset(6, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = U.CardMembers })
	U.CardLoot = H.text(body, "Loot", "", "Heading", 18, C.Cash, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 7 })
	local buttons = H.frame(body, "Buttons", { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 8 })
	U.CardButtons = buttons
	H.list(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	U.CardChest = W.button(buttons, "ChestButton", G.Chest .. " CHEST", C.Gold, UDim2.new(0.5, -4, 1, 0), 1, R.chest)
	U.CardReady = W.button(buttons, "ReadyButton", "READY", C.Green, UDim2.new(0.5, -4, 1, 0), 2, R.ready)
	U.CardLeave = W.button(buttons, "LeaveButton", "LEAVE", C.Red, UDim2.new(0.5, -4, 1, 0), 3, R.leave, "Outline")
	-- the phone chip (one line in Roblox's top band)
	local chip = NeonKit.Card({ Name = "RunChip", Size = UDim2.fromOffset(420, K.CHIP_H), Color = C.Accent, Glow = false, Floor = false, Parent = gui })
	chip.Root.Visible = false
	U.Chip = chip
	U.ChipScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 0.8, Parent = chip.Root })
	U.ChipText = H.text(chip.Body, "Text", "", "Heading", 19, WHITE, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -112, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	U.ChipButton = W.button(chip.Body, "LeaveButton", "LEAVE", C.Red, UDim2.fromOffset(92, K.CHIP_H - 10), 1, function()
		if S.Run and S.Run.State == "Treasure" and not S.ChestOpened and os.clock() > S.LeaveArmed then
			R.chest()
		elseif S.Run then
			R.leave()
		elseif S.Lobby and S.Lobby.Mine and LocalPlayer and S.Lobby.Mine.Leader ~= LocalPlayer.UserId and not W.myReady(S.Lobby.Mine) then
			R.ready()
		else
			R.chest()
		end
	end, "Outline")
	U.ChipButton.AnchorPoint = Vector2.new(1, 0.5)
	U.ChipButton.Position = UDim2.new(1, -5, 0.5, 0)
	-- the End card
	local endCard = NeonKit.Card({ Name = "EndCard", Size = UDim2.fromOffset(K.END_W, 200), Color = C.Accent, Glow = true, Parent = gui })
	endCard.Root.Visible = false
	U.End = endCard
	U.EndScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = endCard.Root })
	local eb = H.frame(endCard.Body, "List", { Size = UDim2.new(1, 0, 1, 0) })
	H.pad(eb, 16, 12, 16, 14)
	H.list(eb, Enum.FillDirection.Vertical, 6)
	U.EndTitle = H.text(eb, "Title", "", "Title", 28, WHITE, { Size = UDim2.new(1, 0, 0, 36), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1 })
	U.EndReason = H.text(eb, "Reason", "", "Body", 19, C.Muted, { Size = UDim2.new(1, 0, 0, 50), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2 })
	U.EndTotals = H.text(eb, "Totals", "", "Heading", 20, WHITE, { Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 3 })
	U.EndFirst = H.text(eb, "FirstClear", "", "Heading", 20, C.Gold, { Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 4 })
	U.EndUnlock = H.text(eb, "Unlocked", "", "Heading", 19, C.Green, { Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 5 })
	local ok = W.button(eb, "OkButton", "OK", C.Accent, UDim2.new(1, 0, 0, 46), 6, function()
		S.End = nil
		R.refresh()
	end)
	U.EndOk = ok
end

function R.ready()
	local mine = S.Lobby and S.Lobby.Mine
	if not mine then
		return
	end
	local now = not W.myReady(mine)
	if H.request("Ready", now) then
		S.ReadyWant = now
		S.PartySig = nil
		R.refresh()
		W.refresh()
	end
end

function R.chest()
	if S.Run and S.Run.State == "Treasure" then
		if H.request("Chest") then
			R.toast("Opening your chest...", C.Gold, 2)
		end
	end
end

-- LEAVE: two presses within LEAVE_CONFIRM seconds -> DungeonRequest("Quit")
function R.leave()
	if not S.Run then
		return
	end
	local now = os.clock()
	if now <= S.LeaveArmed then
		S.LeaveArmed = 0
		H.request("Quit")
		R.refresh()
		return
	end
	S.LeaveArmed = now + K.LEAVE_CONFIRM
	R.refresh()
end

function R.toast(text, color, seconds, short)
	S.Toast = { Text = tostring(text), Short = short, Color = color or C.Gold, Until = os.clock() + (seconds or K.TOAST_SECONDS) }
	R.refresh()
end

-- seconds left of the current run phase (counted locally from when it began)
function R.phaseLeft()
	local run = S.Run
	if not run then
		return nil
	end
	local since = os.clock() - S.PhaseAt
	if run.State == "Treasure" then
		return math.max(0, H.dungeonNumber("TreasureSeconds", K.TREASURE) - since)
	end
	return nil
end

-- the door wait (decision 2): "press" (go and press E), "wait" (I pressed, others not yet), "go" (the transit) or nil;
-- -> kind, missing count, names of who did not press yet
function R.doorWait()
	local run = S.Run
	if not run or run.EnterOpen ~= true then
		if run and run.Transit == true then
			return "go", 0, {}
		end
		return nil, 0, {}
	end
	local pressed = {}
	for _, uid in ipairs(type(run.Confirmed) == "table" and run.Confirmed or {}) do
		pressed[uid] = true
	end
	local names = {}
	for _, m in ipairs(type(run.Members) == "table" and run.Members or {}) do
		if not m.Left and not pressed[m.UserId] then
			names[#names + 1] = tostring(m.Name or "?")
		end
	end
	local missing = math.max(0, math.floor(tonumber(run.NeedConfirm) or #names))
	if LocalPlayer and pressed[LocalPlayer.UserId] then
		return "wait", missing, names
	end
	return "press", missing, names
end

-- touch-only devices tap the prompt's button instead of pressing E
function R.pressWord()
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "tap Enter"
	end
	return "press E"
end

function R.doorText(short)
	local kind, missing, names = R.doorWait()
	if kind == "go" then
		return "Here we go!"
	elseif kind == "wait" then
		if missing <= 0 then
			return "Here we go!"
		end
		if short then
			return "Waiting for " .. missing .. " more"
		end
		return "Waiting for " .. missing .. " more (" .. table.concat(names, ", ") .. ")"
	elseif kind == "press" then
		return short and ("Door: " .. R.pressWord()) or ("Go to the door and " .. R.pressWord())
	end
	return nil
end

function R.statusText()
	local run = S.Run
	local left = R.phaseLeft()
	local door = R.doorText(false)
	if run.State == "Hall" then
		return door or "Get ready!"
	elseif run.State == "Corridor" then
		if run.Phase == "Walk" then
			return door or "Room cleared! The bars open..."
		end
		return door or "Walk into the room to start the fight"
	elseif run.State == "Fight" then
		return (tonumber(run.Room) == 4) and "Boss fight! Beat the boss and its escort" or "Fight! Beat every wave"
	elseif run.State == "Treasure" then
		return "Open your chest! Exit in " .. H.clock(left or 0)
	elseif run.State == "Ending" then
		return "Back to the plaza..."
	end
	return ""
end

-- the run card is exactly as tall as its visible rows (fixed rows, no AutomaticSize)
function R.cardHeight()
	U.CardButtons.Visible = U.CardChest.Visible or U.CardReady.Visible or U.CardLeave.Visible
	U.ChipText.Size = UDim2.new(1, U.ChipButton.Visible and -112 or -20, 1, 0)
	local h = 10 + 12
	local n = 0
	for _, child in ipairs(U.CardList:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			h = h + child.Size.Y.Offset
			n = n + 1
		end
	end
	h = h + math.max(0, n - 1) * 6
	U.Card.Root.Size = UDim2.fromOffset(K.CARD_W, h)
end

-- the phone chip's one line (the battle HUD shows the wave during a fight)
function R.chipText(room, count)
	local run = S.Run
	local left = R.phaseLeft()
	if run.State == "Fight" then
		return (room >= count) and ("Floor " .. tostring(run.Floor or 1) .. " " .. G.Dot .. " Boss") or ("Room " .. room .. "/" .. count)
	elseif run.State == "Hall" or (run.State == "Corridor" and run.Phase == "Walk") then
		return R.doorText(true) or ((run.State == "Hall") and "Get ready!" or "Cleared!")
	elseif run.State == "Corridor" then
		return R.doorText(true) or "Walk in!"
	elseif run.State == "Treasure" then
		return "Chest! " .. H.clock(left or 0)
	end
	return "Back soon..."
end

function R.pips(room, count)
	local out = {}
	for i = 1, count do
		if i == count then
			out[#out + 1] = (i <= room) and G.Crown or G.PipOff
		else
			out[#out + 1] = (i <= room) and G.Pip or G.PipOff
		end
	end
	return table.concat(out, " ")
end

function R.lootText()
	local t = S.Totals
	local parts = { "$" .. H.commas(t.Cash), G.Cloud .. " " .. H.commas(t.Tokens), "+" .. H.commas(t.Xp) .. " XP" }
	if (tonumber(t.Gems) or 0) > 0 then
		parts[#parts + 1] = G.Gem .. " " .. H.commas(t.Gems)
	end
	return table.concat(parts, "   ")
end

-- which card to show: "Run" (in a run), "Countdown" (a party countdown while the window is closed), or nil
function R.view()
	if H.inMatch() then
		return nil
	end
	if S.Run then
		return "Run"
	end
	local mine = S.Lobby and S.Lobby.Mine
	if mine and not S.Open and W.countdown(mine) ~= nil and not mine.InRun then
		return "Countdown"
	end
	return nil
end

-- Roblox's top bar height (the gui area starts below it)
function R.inset()
	local ok, inset = pcall(function()
		return game:GetService("GuiService"):GetGuiInset().Y
	end)
	return (ok and tonumber(inset)) or 0
end

function R.place()
	local vp = H.viewport()
	local w, h = vp.X, vp.Y
	local top = R.inset()
	local f = Theme.ScreenFactor(h)
	local phone = H.isPhone()
	S.CardMode = nil
	-- the End card
	local endH = U.End.Root.Size.Y.Offset
	if phone and w < h then
		-- portrait: right of the menu tile column, under the currency pills (clear of the screen's centre)
		local scale = 0.8
		U.EndScale.Scale = scale
		U.End.Root.Size = UDim2.fromOffset(math.floor((w - 172) / scale), endH)
		U.End.Root.Position = UDim2.fromOffset(160, math.floor(h * 0.18) - top)
	elseif phone then
		local scale = 0.8
		local width = math.min(K.END_W, math.floor(w * 0.44 / scale))
		U.EndScale.Scale = scale
		U.End.Root.Size = UDim2.fromOffset(width, endH)
		U.End.Root.Position = UDim2.fromOffset(math.floor(w - 12 - width * scale), 52 - top)
	else
		U.EndScale.Scale = f
		U.End.Root.Size = UDim2.fromOffset(K.END_W, endH)
		U.End.Root.Position = UDim2.fromOffset(math.floor(w - 12 - K.END_W * f), math.floor(h * 0.3) - top)
	end
	-- the run card / chip
	if phone then
		local scale = 0.8
		local x0 = (w < h) and 132 or math.max(300, math.floor(w * 0.36), R.pillsRight() + 8)
		local x1 = w - ((w < h) and 54 or 68)
		local width = math.max(220, math.floor((x1 - x0) / scale))
		width = math.min(width, 520)
		U.ChipScale.Scale = scale
		U.Chip.Root.Size = UDim2.fromOffset(width, K.CHIP_H)
		U.Chip.Root.Position = UDim2.fromOffset(x0, 4 - top)
		S.CardMode = "Chip"
	else
		U.CardScale.Scale = f
		U.Card.Root.Position = UDim2.fromOffset(math.floor(w - 12 - K.CARD_W * f), math.floor(h * 0.4) - top)
		S.CardMode = "Card"
	end
end

-- landscape phones: the HUD's currency pills share Roblox's top band; the chip starts right of them
function R.pillsRight()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud or hud:GetAttribute("CurrencyMode") ~= "TopBand" then
		return 0
	end
	local cur = hud:FindFirstChild("Currency", true)
	if not cur or not cur:IsA("GuiObject") then
		return 0
	end
	return math.floor(cur.AbsolutePosition.X + cur.AbsoluteSize.X + 0.5)
end

function R.refresh()
	if not U.RunGui then
		return
	end
	local view = R.view()
	local now = os.clock()
	if view == nil and S.End == nil then
		-- nothing to show (the common case in the lobby): no layout work on the 4 Hz tick
		U.Card.Root.Visible = false
		U.Chip.Root.Visible = false
		U.End.Root.Visible = false
		return
	end
	R.place()
	local toast = S.Toast and now < S.Toast.Until and S.Toast or nil
	local chip = S.CardMode == "Chip"
	U.Card.Root.Visible = view ~= nil and not chip
	U.Chip.Root.Visible = view ~= nil and chip
	U.Card.Root:SetAttribute("View", view)
	U.Chip.Root:SetAttribute("View", view)
	-- the End card
	local endShown = S.End ~= nil and now - S.EndAt < K.END_SECONDS and not H.inMatch()
	U.End.Root.Visible = endShown
	if endShown then
		R.fillEnd()
	end
	if not view then
		return
	end
	if view == "Countdown" then
		local mine = S.Lobby.Mine
		local cd = W.countdownText(mine) or ""
		local isLeader = LocalPlayer and mine.Leader == LocalPlayer.UserId
		local needReady = not isLeader and not W.myReady(mine)
		local f = math.floor(tonumber(mine.Floor) or 1)
		U.CardTitle.Text = G.Torch .. " The Dungeon " .. G.Dot .. " Floor " .. f
		U.CardRoom.Text = cd
		U.CardWave.Visible = false
		U.CardStatus.Text = "Stay near the Dungeon gate"
		U.CardMembers.Visible = false
		U.CardLoot.Visible = false
		U.CardToast.Visible = false
		U.CardChest.Visible = false
		U.CardReady.Visible = needReady
		U.CardLeave.Visible = false
		U.ChipText.Text = cd
		U.ChipButton.Text = "READY"
		U.ChipButton.Visible = needReady
		R.cardHeight()
		return
	end
	local run = S.Run
	local info = H.floorInfo(tonumber(run.Floor) or 1)
	local f = tonumber(run.Floor) or 1
	local room = math.floor(tonumber(run.Room) or 1)
	local count = math.floor(tonumber(run.RoomCount) or 4)
	U.Card.SetColor(H.elementColor(run.Element or info.Element))
	U.CardTitle.Text = "Floor " .. f .. " " .. G.Dot .. " " .. tostring(run.Name or info.Name)
	U.CardRoom.Text = ((room >= count) and "Boss room" or ("Room " .. room .. " / " .. count)) .. "   " .. R.pips(room, count)
	local waves = tonumber(run.Waves)
	local wave = tonumber(run.Wave)
	U.CardWave.Visible = waves ~= nil and waves > 0 and run.State == "Fight"
	U.CardWave.Text = "Wave " .. tostring(wave or 1) .. " / " .. tostring(waves or 1)
	U.CardStatus.Text = R.statusText()
	U.CardToast.Visible = toast ~= nil
	if toast then
		U.CardToastText.Text = toast.Text
		U.CardToast.BackgroundColor3 = Theme.Darken(toast.Color, 0.6)
	end
	-- members (a party only)
	local members = type(run.Members) == "table" and run.Members or {}
	U.CardMembers.Visible = #members > 1
	U.CardMembers.Size = UDim2.new(1, 0, 0, math.ceil(math.min(4, #members) / 2) * 30)
	local sig = ""
	for _, m in ipairs(members) do
		sig = sig .. tostring(m.UserId) .. tostring(m.Downed) .. tostring(m.Left) .. ";"
	end
	if sig ~= S.MemberSig then
		S.MemberSig = sig
		H.clear(U.CardMembers)
		for i, m in ipairs(members) do
			if i > 4 then
				break
			end
			local glyph = m.Left and G.Cross or (m.Downed and G.Skull or G.Check)
			local color = m.Left and C.Muted or (m.Downed and C.Red or C.Green)
			local chipF = H.frame(U.CardMembers, "Member" .. i, { BackgroundTransparency = 0, BackgroundColor3 = C.RowDark, LayoutOrder = i })
			H.corner(chipF, 8)
			chipF:SetAttribute("Downed", m.Downed == true)
			chipF:SetAttribute("Left", m.Left == true)
			H.text(chipF, "Text", glyph .. " " .. tostring(m.Name or "?"), "Body", 18, color, { Position = UDim2.fromOffset(6, 0), Size = UDim2.new(1, -8, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
		end
	end
	local t = S.Totals
	U.CardLoot.Visible = (t.Cash + t.Tokens + t.Xp + (t.Gems or 0)) > 0
	U.CardLoot.Text = R.lootText()
	U.CardChest.Visible = run.State == "Treasure" and not S.ChestOpened
	U.CardReady.Visible = false
	U.CardLeave.Visible = run.State ~= "Ending"
	local armed = now <= S.LeaveArmed
	U.CardLeave.Text = armed and "Sure? Tap again" or "LEAVE"
	-- the phone chip: room / wave or the toast or the status
	U.ChipText.Text = toast and (toast.Short or toast.Text) or R.chipText(room, count)
	U.ChipButton.Visible = run.State ~= "Ending"
	R.cardHeight()
	if run.State == "Treasure" and not S.ChestOpened then
		U.ChipButton.Text = "CHEST"
	else
		U.ChipButton.Text = armed and "SURE?" or "LEAVE"
	end
	if run.State == "Treasure" and not S.ChestOpened and not armed then
		U.ChipButton:SetAttribute("Color", "Gold")
	else
		U.ChipButton:SetAttribute("Color", "Red")
	end
end

function R.fillEnd()
	local e = S.End
	local cleared = e.Cleared == true
	local f = math.floor(tonumber(e.Floor) or 1)
	local info = H.floorInfo(f)
	local name = tostring(e.Name or info.Name)
	U.End.SetColor(cleared and C.Green or C.Red)
	U.EndTitle.Text = cleared and ("Floor " .. f .. " cleared!") or "Run over"
	U.EndTitle.TextColor3 = cleared and C.Green or WHITE
	local reason = tostring(e.Reason or "")
	local text
	if cleared then
		text = "You beat the " .. name .. "!"
	elseif reason == "Wipe" or reason == "Timeout" then
		text = "Floor " .. f .. ": the " .. name .. " got you in room " .. tostring(e.Room or 1) .. ". Train your team and try again!"
	elseif reason == "Quit" or reason == "Left" then
		text = "You left the dungeon. Your loot is kept."
	elseif reason == "Shutdown" then
		text = "The server is restarting. Your loot is kept."
	else
		text = "The run ended. Your loot is kept."
	end
	U.EndReason.Text = text
	local t = type(e.Totals) == "table" and e.Totals or S.Totals
	local parts = { "$" .. H.commas(t.Cash), G.Cloud .. " " .. H.commas(t.Tokens), "+" .. H.commas(t.Xp) .. " XP" }
	if (tonumber(t.Gems) or 0) > 0 then
		parts[#parts + 1] = G.Gem .. " " .. H.commas(t.Gems)
	end
	U.EndTotals.Text = table.concat(parts, "   ")
	local first = type(e.FirstClear) == "table" and e.FirstClear or nil
	U.EndFirst.Visible = first ~= nil
	if first then
		U.EndFirst.Text = G.Star .. " First clear! +" .. H.commas(first.Tokens or 0) .. " " .. G.Cloud .. "  +" .. H.commas(first.Gems or 0) .. " " .. G.Gem
	end
	local lines = {}
	if tonumber(e.Unlocked) then
		lines[#lines + 1] = "Floor " .. math.floor(e.Unlocked) .. " unlocked!"
	end
	if e.NewBest and #lines == 0 then
		lines[#lines + 1] = "New best: floor " .. tostring(tonumber(e.NewBest) or f)
	end
	U.EndUnlock.Visible = #lines > 0
	U.EndUnlock.Text = table.concat(lines, "  " .. G.Dot .. "  ")
	-- fixed rows (no AutomaticSize): the card is exactly as tall as what it shows; a narrow card (portrait phone)
	-- gives every row two lines
	local narrow = U.End.Root.Size.X.Offset < 340
	local row = narrow and 46 or 26
	local reasonH = (#text > (narrow and 26 or 40)) and 50 or 26
	U.EndReason.Size = UDim2.new(1, 0, 0, reasonH)
	for _, label in ipairs({ U.EndTotals, U.EndFirst, U.EndUnlock }) do
		label.Size = UDim2.new(1, 0, 0, row)
		label.TextWrapped = narrow
		label.TextTruncate = narrow and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
	end
	local h = 12 + 36 + 6 + reasonH + 6 + row + 6 + (first and (row + 6) or 0) + (#lines > 0 and (row + 6) or 0) + 46 + 14
	U.End.Root.Size = UDim2.fromOffset(U.End.Root.Size.X.Offset, h)
end

----------------------------------------------------------------------
-- The room change fade (dungeon-fixes decision 2): one black Frame in its own ScreenGui
----------------------------------------------------------------------
function R.buildFade()
	local gui = CloudUI.NewScreenGui("NimbusDungeonFade", K.FADE_ORDER)
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	U.FadeGui = gui
	U.Fade = Util.Create("Frame", {
		Name = "Fade",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Active = false,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
end

function R.fadeStep(v, default)
	v = tonumber(v)
	if not v or v ~= v then
		return default
	end
	return math.max(0, math.min(K.FADE_MAX_STEP, v))
end

function R.fadeTween(target, seconds)
	if S.FadeTween then
		pcall(function()
			S.FadeTween:Cancel()
		end)
		S.FadeTween = nil
	end
	if seconds <= 0 then
		U.Fade.BackgroundTransparency = target
		return
	end
	S.FadeTween = H.tween(U.Fade, seconds, { BackgroundTransparency = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
end

-- DungeonState "Fade" { Out, Hold, In }: to black over Out, hold (until the next room's Run payload arrived, >= Hold),
-- back over In; FADE_SAFETY clears it whatever happens
function R.fade(payload)
	if not U.Fade then
		return
	end
	local fade = {
		Token = (S.Fade and S.Fade.Token or S.FadeSeq or 0) + 1,
		Out = R.fadeStep(payload.Out, 0.45),
		Hold = R.fadeStep(payload.Hold, 0.35),
		In = R.fadeStep(payload.In, 0.45),
		Key = S.PhaseKey,
		Phase = "Out",
		HardAt = os.clock() + K.FADE_SAFETY,
	}
	S.FadeSeq = fade.Token
	S.Fade = fade
	U.FadeGui.Enabled = true
	U.Fade.Visible = true
	R.fadeTween(0, fade.Out)
	task.delay(fade.Out + fade.Hold, function()
		if S.Fade == fade then
			fade.Phase = "Hold"
			-- the server moved us already (a new State / Room): fade back in now, else on the next Run payload
			if S.PhaseKey ~= fade.Key or not S.Run then
				R.fadeIn()
			end
		end
	end)
	task.delay(K.FADE_SAFETY, function()
		if S.Fade == fade then
			R.clearFade()
		end
	end)
end

function R.fadeIn()
	local fade = S.Fade
	if not fade or fade.Phase == "In" then
		return
	end
	fade.Phase = "In"
	R.fadeTween(1, fade.In)
	task.delay(fade.In, function()
		if S.Fade == fade then
			R.clearFade()
		end
	end)
end

-- the overlay off at once (End, leaving the run, the safety timeout)
function R.clearFade()
	S.Fade = nil
	if S.FadeTween then
		pcall(function()
			S.FadeTween:Cancel()
		end)
		S.FadeTween = nil
	end
	if U.Fade then
		U.Fade.BackgroundTransparency = 1
		U.Fade.Visible = false
	end
	if U.FadeGui then
		U.FadeGui.Enabled = false
	end
end

-- the light loop's safety net (a lost task.delay never leaves the screen black)
function R.fadeTick()
	local fade = S.Fade
	if not fade then
		return
	end
	local now = os.clock()
	if now >= fade.HardAt then
		R.clearFade()
	elseif fade.Phase == "Hold" and now >= fade.HardAt - fade.In then
		R.fadeIn()
	end
end

----------------------------------------------------------------------
-- Lighting (LightingStack "Dungeon") and the door slides
----------------------------------------------------------------------
function R.lightingStack()
	if R.LS == nil then
		local module = Client:FindFirstChild("LightingStack")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		R.LS = (ok and type(result) == "table") and result or false
	end
	return R.LS or nil
end

function R.preset()
	local preset = { Lighting = PRESET.Lighting, ColorCorrection = PRESET.ColorCorrection }
	local atmosphere = game:GetService("Lighting"):FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		if not R.BaseDensity then
			R.BaseDensity = atmosphere.Density
		end
		preset.Atmosphere = { Density = math.min(1, (R.BaseDensity or 0.3) + PRESET.AtmosphereAdd) }
	end
	return preset
end

function R.light(on)
	if on == S.Lit then
		return
	end
	local LS = R.lightingStack()
	S.Lit = on
	if not LS then
		return
	end
	if on then
		H.safe("light push", LS.Push, K.LIGHT_ID, R.preset(), K.LIGHT_SECONDS)
	else
		H.safe("light pop", LS.Pop, K.LIGHT_ID, K.LIGHT_SECONDS)
	end
end

-- the pocket (workspace.Dungeons.Dungeon_<i>) the player stands in: the nearest holder within 400 studs
function R.findPocket()
	local folder = Workspace:FindFirstChild("Dungeons")
	local pos = H.rootPosition()
	if not folder or not pos then
		return nil
	end
	local best, bestD = nil, 400
	for _, holder in ipairs(folder:GetChildren()) do
		local at = H.positionOf(holder:FindFirstChild("Entrance_1") or holder:FindFirstChildWhichIsA("Model") or holder)
		if at then
			local d = (at - pos).Magnitude
			if d < bestD then
				best, bestD = holder, d
			end
		end
	end
	return best
end

function R.unwatchDoors()
	for _, conn in ipairs(S.Doors) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	S.Doors = {}
	S.Pocket = nil
end

-- local copies of a door's bars sink into the floor (the server already switched the real bars off)
function R.slide(door)
	if typeof(door) ~= "Instance" then
		return
	end
	local n = 0
	for _, bar in ipairs(door:GetChildren()) do
		if bar.Name == "Bar" and bar:IsA("BasePart") and n < 8 then
			n = n + 1
			local ghost = Instance.new("Part")
			ghost.Name = "BarSlide"
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanQuery = false
			ghost.CanTouch = false
			ghost.CastShadow = false
			ghost.Size = bar.Size
			ghost.CFrame = bar.CFrame
			ghost.Color = bar.Color
			ghost.Material = bar.Material
			ghost.Parent = Workspace
			H.tween(ghost, 0.7, { CFrame = bar.CFrame * CFrame.new(0, -bar.Size.Y, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.8, function()
				ghost:Destroy()
			end)
		end
	end
end

function R.watchRoom(room)
	if not room:IsA("Model") then
		return
	end
	table.insert(S.Doors, room:GetAttributeChangedSignal("DoorOpen"):Connect(function()
		if room:GetAttribute("DoorOpen") == true then
			R.slide(room:FindFirstChild("Door_Exit"))
		end
	end))
	table.insert(S.Doors, room:GetAttributeChangedSignal("EntranceOpen"):Connect(function()
		if room:GetAttribute("EntranceOpen") == true then
			R.slide(room:FindFirstChild("Door_Entrance"))
		end
	end))
end

function R.watchDoors()
	if S.Pocket and S.Pocket.Parent then
		return
	end
	R.unwatchDoors()
	local pocket = R.findPocket()
	if not pocket then
		return
	end
	S.Pocket = pocket
	for _, room in ipairs(pocket:GetChildren()) do
		R.watchRoom(room)
	end
	table.insert(S.Doors, pocket.ChildAdded:Connect(function(child)
		R.watchRoom(child)
	end))
end

----------------------------------------------------------------------
-- Server messages
----------------------------------------------------------------------
function R.onState(kind, payload)
	if type(payload) ~= "table" then
		return
	end
	if kind == "Lobby" then
		S.Lobby = payload
		S.LobbyAt = os.clock()
		S.ReadyWant = nil -- the server's word wins (the optimistic READY is reverted or confirmed here)
		S.PartySig = nil
		if type(payload.Mine) == "table" and tonumber(payload.Mine.Floor) then
			S.Floor = math.floor(payload.Mine.Floor)
		end
		W.refresh()
		R.refresh()
	elseif kind == "Run" then
		local fresh = S.Run == nil or S.Run.RunId ~= payload.RunId
		local key = tostring(payload.State) .. ":" .. tostring(payload.Phase) .. ":" .. tostring(payload.Room)
		if fresh then
			S.Totals = { Cash = 0, Tokens = 0, Xp = 0, Gems = 0 }
			S.ChestOpened = false
			S.End = nil
			S.LeaveArmed = 0
			S.MemberSig = nil
			R.unwatchDoors()
		end
		if key ~= S.PhaseKey then
			S.PhaseKey = key
			S.PhaseAt = os.clock()
		end
		S.Run = payload
		S.RunAt = os.clock()
		-- the next room arrived while the screen holds black: fade back in
		if S.Fade and S.Fade.Phase == "Hold" and key ~= S.Fade.Key then
			R.fadeIn()
		end
		if S.Open then
			DungeonController.Close()
		end
		R.light(true)
		H.safe("doors", R.watchDoors)
		R.refresh()
	elseif kind == "Loot" then
		S.Loot = payload
		local t = S.Totals
		t.Cash = t.Cash + (tonumber(payload.Cash) or 0)
		t.Tokens = t.Tokens + (tonumber(payload.Tokens) or 0)
		t.Xp = t.Xp + (tonumber(payload.Xp) or 0)
		local text
		if payload.Loss then
			text = "A third of the XP for trying: +" .. H.commas(payload.Xp) .. " XP"
		else
			local room = tonumber(payload.Room) or 1
			text = ((room >= 4) and "Boss beaten!" or ("Room " .. room .. " cleared!")) .. " +$" .. H.commas(payload.Cash) .. " +" .. H.commas(payload.Tokens) .. " tokens +"
				.. H.commas(payload.Xp) .. " XP"
			if (tonumber(payload.LevelUps) or 0) > 0 then
				text = text .. " (" .. math.floor(payload.LevelUps) .. " level up!)"
			end
		end
		R.toast(text, payload.Loss and C.Blue or C.Gold, nil, "+$" .. H.commas(payload.Cash) .. " +" .. H.commas(payload.Tokens) .. G.Cloud .. " +" .. H.commas(payload.Xp) .. "XP")
	elseif kind == "Chest" then
		local amount = tonumber(payload.Amount) or 0
		local kindName = tostring(payload.Kind)
		if kindName == "Gems" then
			S.Totals.Gems = S.Totals.Gems + amount
		elseif kindName == "Tokens" then
			S.Totals.Tokens = S.Totals.Tokens + amount
		elseif kindName == "Cash" then
			S.Totals.Cash = S.Totals.Cash + amount
		end
		S.ChestOpened = true
		local label = (kindName == "Cash") and ("$" .. H.commas(amount)) or (H.commas(amount) .. " " .. (kindName == "Gems" and "Gems" or "tokens"))
		R.toast(G.Chest .. " Chest: +" .. label .. "!", (kindName == "Gems") and C.Gem or C.Gold, nil, G.Chest .. " +" .. label)
	elseif kind == "Fade" then
		if S.Run then
			R.fade(payload)
		end
	elseif kind == "End" then
		S.End = payload
		S.EndAt = os.clock()
		S.Run = nil
		S.PhaseKey = nil
		S.LeaveArmed = 0
		S.Toast = nil
		R.clearFade()
		R.light(false)
		R.unwatchDoors()
		R.refresh()
	end
end

-- a run that vanished without an End (InBattle released, the pocket left): clean up and restore the light
function R.check()
	if S.Run and not H.runAttr() and os.clock() - S.RunAt > 3 then
		S.Run = nil
		S.PhaseKey = nil
		R.clearFade()
		R.unwatchDoors()
		R.light(false)
		R.refresh()
	elseif S.Lit and not S.Run and not H.runAttr() then
		R.light(false)
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function H.connectOthers()
	local function hook(name, signalName)
		local mod = H.controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(windowId)
				if name == "DungeonController" or windowId == "Dungeon" then
					return
				end
				DungeonController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
	hook("CareController", "Opened")
	hook("ArenaController", "Opened")
	hook("ObbyController", "Opened")
end

function DungeonController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusDungeon", K.DISPLAY_ORDER)
	R.build()
	R.buildFade()
	R.refresh()
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		H.safe("relayout", function()
			S.PartySig = nil
			W.refresh()
			R.refresh()
		end)
	end)
	State.Changed:Connect(function()
		H.safe("State.Changed", W.refresh)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				DungeonController.Close()
			end
			H.safe("InMatch", R.refresh)
		end)
		LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.InBattle) or "InBattle"):Connect(function()
			task.delay(3.2, function()
				H.safe("InBattle", R.check)
			end)
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			DungeonController.Close()
		end
	end)
	task.spawn(function()
		local okState, stateRemote = pcall(Remotes.Get, "DungeonState")
		if okState and stateRemote then
			stateRemote.OnClientEvent:Connect(function(kind, payload)
				H.safe("DungeonState " .. tostring(kind), R.onState, kind, payload)
			end)
		end
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) == "string" and panelId:lower() == "dungeon" then
					args = type(args) == "table" and args or {}
					H.safe("OpenPanel", DungeonController.Open, args.Floor)
				end
			end)
		end
	end)
	task.defer(function()
		H.safe("hooks", H.connectOthers)
	end)
	-- one light loop: countdowns, phase clocks, the toasts, walk-away (4 times a second)
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + K.TICK
		if S.Open and S.AtPortal then
			local pos, at = H.rootPosition(), H.positionOf(S.AtPortal)
			if pos and at and (Vector3.new(pos.X - at.X, 0, pos.Z - at.Z)).Magnitude > K.WALK_AWAY then
				DungeonController.Close()
				return
			end
		end
		if S.Open then
			H.safe("tick window", W.refresh)
		end
		H.safe("tick fade", R.fadeTick)
		H.safe("tick card", R.refresh)
	end)
end

return DungeonController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="875">
            <Properties>
              <string name="Name">EvolutionFx</string>
              <string name="Source"><![CDATA[-- EvolutionFx (client): the evolution animation of a pet, played on this client only (its parts never exist on
-- the server, so nothing replicates). Used by the developer pet showcase (DevPetShow, "/evolve") and by the game's own
-- EVOLVE moment (CareController, Phase 4: two fresh PetBuilder clones in front of the player, with Confetti = true).
--
--   EvolutionFx.Play(fromModel, toModel, pose, opts) -> handle
--       fromModel  the pet as it is now: a PetBuilder model at rest (any stage), placed at `pose`
--       toModel    the evolved pet: a PetBuilder model at rest (parented to opts.Parent when it appears)
--       pose       CFrame of the pets' root (PrimaryPart) at rest: where both hover; LookVector = their facing
--       opts       { Parent = Instance for toModel and the effect parts (default workspace),
--                    Colors = { Color3, Color3 } (glow, sparks: PetBuilder.EvolutionColors),
--                    Stage = 1 | 2 (the stage reached; the second evolution is grander and longer),
--                    Ground = y of the floor under the pets (default: just under fromModel),
--                    Confetti = true (Phase 4, the game's EVOLVE moment: a burst of voxel confetti at the reveal),
--                    OnDone = function(toModel) (called once, after the animation or Stop) }
--       handle     { Done = false/true, Model = the pet on show (fromModel, then toModel), Stop = function() }
--                  Stop() ends it at once: fromModel destroyed, toModel at rest at `pose`, the effects gone.
--   EvolutionFx.Duration(stage) -> seconds the animation lasts
--   EvolutionFx.Count() -> evolutions playing right now
--   EvolutionFx.Arrive(pivot, opts) -> handle   (dungeon fixes, decision 3) an enemy's arrival: EFFECTS ONLY (no model
--       is touched): the evolution's rune ring on the ground, a light pillar, the white flash with a sparkle burst, the
--       shock ring and voxel sparks, about 1.2 s. pivot = CFrame of the arriving pet's centre.
--       opts { Parent (default workspace), Colors = { Color3, Color3 }, Height, Radius (studs of the pet), Ground (y of
--              the floor; default pivot.Y - Height / 2), Seconds (default 1.2), Quality "Low" | "High" (default
--              GraphicsQuality.Effective()), OnFlash = function() (once, at the flash: the caller pops its model in),
--              OnDone = function() (once, at the end or on Stop) }
--       handle { Done, Low, FlashAt (seconds after the start), T, Stop = function() (ends it at once, OnFlash still
--              runs once) }
--       Cheap: the parts live in pooled kits (one kit per arrival, reused; nothing is created after the first wave),
--       one BulkMoveTo per piece list per frame with reused buffers; at most ARRIVE_MAX full kits at once (more
--       arrivals at the same moment get the Low kit). Low = the flash + the shock ring only (13 parts, no light, no
--       particles).
--   EvolutionFx.ArriveStats() -> { Live, LiveLow, Pooled, Parts }   (tests)
--
-- The animation (stage 1 about 4.3 s, stage 2 about 5 s):
--   charge  the pet rises and spins faster and faster while it starts to glow (a Highlight), a ring of voxel runes
--           grows on the ground under it (two counter-rotating rings for the second evolution), glowing motes
--           spiral in and a pillar of light rises
--   burst   the pet shrinks into a white flash and the pillar flares
--   reveal  the evolved pet pops out of the flash (overshoot, then settles), spins down to face forward exactly
--           as it was, sinks back to its hover height; a shock ring races over the ground, voxel sparks burst out
--           and sparkles fly; the glow fades
-- Pets are moved and scaled by placing / resizing their parts from their rest offsets (workspace:BulkMoveTo), so
-- PetBuilder.Animate must not run on them meanwhile; at the end toModel is back at rest, ready for Animate.
-- One RenderStepped connection while anything plays; every effect part is anchored, CanCollide / CanTouch /
-- CanQuery off, CastShadow off. Plain Lua 5.1-compatible syntax only.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local EvolutionFx = {}

local TAU = math.pi * 2
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local WHITE = Color3.fromRGB(255, 255, 255)

local K = {
	CHARGE = { 2.0, 2.6 }, -- seconds of charging, per stage reached
	BURST = 0.38,
	REVEAL = 1.35,
	SETTLE = 0.6,
	RISE = 0.28, -- the pet rises this share of its height while charging
	SPIN = 4.5, -- turns per second at the end of the charge
	REVEAL_TURNS = 2, -- turns the evolved pet spins down through
	MIN_SCALE = 0.04,
	RUNES = { 20, 28 }, -- voxel runes in the ground ring
	MOTES = { 18, 28 },
	SPARKS = { 22, 34 },
	PILLAR = { 9, 12 }, -- pillar height in pet heights... capped below
	PILLAR_MAX = 60, -- studs
	CONFETTI = 26, -- voxel confetti bits (opts.Confetti)
	-- an enemy's arrival (EvolutionFx.Arrive): seconds, the flash moment (share of the time), piece counts, caps
	ARRIVE_SECONDS = 1.2,
	ARRIVE_FLASH = 0.35,
	ARRIVE_RUNES = 12,
	ARRIVE_SHOCK = 16,
	ARRIVE_SHOCK_LOW = 12,
	ARRIVE_SPARKS = 10,
	ARRIVE_SPARKLES = 22,
	ARRIVE_MAX = 6, -- full kits at once (a wave of 3-5 + an escort); more arrivals at once get the Low kit
	ARRIVE_MAX_LOW = 16, -- beyond this nothing is drawn (OnFlash runs at once)
	ARRIVE_POOL = 6, -- kits of each kind kept for reuse
	CONFETTI_COLORS = {
		Color3.fromRGB(255, 96, 120),
		Color3.fromRGB(255, 176, 64),
		Color3.fromRGB(255, 226, 90),
		Color3.fromRGB(110, 214, 120),
		Color3.fromRGB(96, 176, 255),
		Color3.fromRGB(186, 128, 255),
	},
}

local plays = {}
local arrivals = {} -- live EvolutionFx.Arrive plays
local kitPool = { High = {}, Low = {} } -- free arrival kits
local loopConn = nil
local onFrame -- (below)
local quality = nil -- client/GraphicsQuality (lazy; false = unavailable)

local function ensureLoop()
	if not loopConn then
		loopConn = RunService.RenderStepped:Connect(function(dt)
			onFrame(dt)
		end)
	end
end

local function maybeStopLoop()
	if #plays == 0 and #arrivals == 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

local function easeIn(x)
	x = clamp01(x)
	return x * x * x
end

local function easeOut(x)
	x = clamp01(x)
	local y = 1 - x
	return 1 - y * y * y
end

-- overshoots to about 1.1 and settles at 1
local function easeOutBack(x)
	x = clamp01(x)
	local c1 = 1.70158
	local c3 = c1 + 1
	local y = x - 1
	return 1 + c3 * y * y * y + c1 * y * y
end

local function lighten(c, t)
	return c:Lerp(WHITE, t)
end

-- a small deterministic "random" in [0, 1) per index
local function hash(i, salt)
	local h = math.sin(i * 12.9898 + (salt or 0) * 78.233) * 43758.5453
	return h - math.floor(h)
end

local function effectPart(play, name, shape, color, size)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Material = Enum.Material.Neon
	p.Color = color
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Parent = play.Folder
	return p
end

-- The pet's parts, their rest offsets from the root and their sizes.
local function rigOf(model)
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not (root and root:IsA("BasePart")) then
		return nil
	end
	local base = root.CFrame
	local rig = { Model = model, Root = root, Parts = {}, Pos = {}, Rot = {}, Size = {}, Scale = 1, Buf = {}, Posed = nil }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = base:ToObjectSpace(d.CFrame)
			local n = #rig.Parts + 1
			rig.Parts[n] = d
			rig.Pos[n] = rel.Position
			rig.Rot[n] = rel - rel.Position
			rig.Size[n] = d.Size
		end
	end
	return rig
end

-- Places the pet with its root at cf, scaled by s around the root.
local function poseRig(rig, cf, s)
	if not rig or not rig.Model.Parent then
		return
	end
	local resize = s ~= rig.Scale
	if not resize and rig.Posed == cf then
		return -- already there (the settle phase holds the pose): nothing to move this frame
	end
	local list = rig.Buf -- reused every frame: no table per frame
	for i, part in ipairs(rig.Parts) do
		if resize then
			part.Size = rig.Size[i] * s
		end
		list[i] = cf * CFrame.new(rig.Pos[i] * s) * rig.Rot[i]
	end
	rig.Scale = s
	rig.Posed = cf
	Workspace:BulkMoveTo(rig.Parts, list, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Height, radius (half the larger horizontal size) and the offset from the root down to the pet's lowest point.
local function measure(rig)
	local lo, hi = math.huge, -math.huge
	local rx = 0
	local base = rig.Root.CFrame
	for i, part in ipairs(rig.Parts) do
		if part.Transparency < 1 then
			local p = rig.Pos[i]
			local half = rig.Size[i].Magnitude / 2
			lo = math.min(lo, p.Y - half)
			hi = math.max(hi, p.Y + half)
			rx = math.max(rx, math.abs(p.X) + half, math.abs(p.Z) + half)
		end
	end
	if lo == math.huge then
		return 3, 2, -1.5, base
	end
	return hi - lo, rx, lo, base
end

----------------------------------------------------------------------
-- One play
----------------------------------------------------------------------
local function ringPose(play, i, n, radius, turn, lift)
	local a = i / n * TAU + turn
	local c = play.Pose
	local centre = Vector3.new(c.Position.X, play.Ground + (lift or 0.06), c.Position.Z)
	local pos = centre + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
	return CFrame.new(pos) * CFrame.Angles(0, -a, 0)
end

-- the sparkle burst emitter (Rate 0: Emit(n) only) on an attachment of `part`; also used by the arrival kits
local function newSparkles(part, c1, c2, R, u)
	local att = Instance.new("Attachment")
	att.Name = "EvolveSparkles"
	att.Parent = part
	local em = Instance.new("ParticleEmitter")
	em.Name = "EvolveSparkles"
	em.Texture = SPARKLE
	em.LightEmission = 1
	em.LightInfluence = 0
	em.Rate = 0
	em.Lifetime = NumberRange.new(0.7, 1.4)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-180, 180)
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Parent = att
	local function tune(a, b, radius, unit)
		em.Color = ColorSequence.new(lighten(a, 0.3), lighten(b, 0.3))
		em.Speed = NumberRange.new(radius * 2.2, radius * 4.4)
		em.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, unit * 0.9),
			NumberSequenceKeypoint.new(1, 0),
		})
	end
	tune(c1, c2, R, u)
	return em, tune
end

local function buildEffects(play)
	local stage = play.Stage
	local c1, c2 = play.Colors[1], play.Colors[2]
	local R, H = play.Radius, play.Height
	local u = math.max(0.6, math.min(R, H) * 0.22) -- size unit of the voxel bits
	play.Unit = u
	-- glow on the pet
	local hl = Instance.new("Highlight")
	hl.Name = "EvolveGlow"
	hl.FillColor = lighten(c1, 0.35)
	hl.OutlineColor = lighten(c2, 0.5)
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Adornee = play.From.Model
	hl.Parent = play.Folder
	play.Glow = hl
	-- the rune ring(s) on the ground
	play.Runes = {}
	local rings = (stage == 2) and 2 or 1
	for r = 1, rings do
		local n = K.RUNES[stage] - (r - 1) * 8
		for i = 1, n do
			local col = ((i + r) % 2 == 0) and c1 or c2
			local part = effectPart(play, "EvolveRune", nil, col, Vector3.new(u * 0.55, u * 0.14, u * ((i % 3 == 0) and 1.5 or 0.9)))
			part.Transparency = 1
			play.Runes[#play.Runes + 1] = { Part = part, I = i, N = n, Ring = r }
		end
	end
	-- motes that spiral in
	play.Motes = {}
	for i = 1, K.MOTES[stage] do
		local part = effectPart(play, "EvolveMote", nil, (i % 2 == 0) and c1 or c2, Vector3.new(u * 0.4, u * 0.4, u * 0.4))
		part.Transparency = 1
		play.Motes[i] = { Part = part, A = hash(i, 1) * TAU, Y = 0.15 + hash(i, 2) * 1.05, Delay = hash(i, 3) * 0.35 }
	end
	-- the pillar of light (a cylinder's axis is its X axis: turned upright)
	local pillar = effectPart(play, "EvolvePillar", Enum.PartType.Cylinder, lighten(c1, 0.45), Vector3.new(0.1, R * 1.4, R * 1.4))
	pillar.Transparency = 1
	play.Pillar = pillar
	play.PillarHeight = math.min(K.PILLAR_MAX, H * K.PILLAR[stage])
	local light = Instance.new("PointLight")
	light.Name = "EvolveLight"
	light.Color = lighten(c1, 0.3)
	light.Range = math.min(40, R * 4 + 8)
	light.Brightness = 0
	light.Parent = pillar
	play.Light = light
	-- the flash
	local flash = effectPart(play, "EvolveFlash", Enum.PartType.Ball, WHITE, Vector3.new(0.2, 0.2, 0.2))
	flash.Transparency = 1
	play.Flash = flash
	-- sparkles (emitted in bursts)
	play.Emitter = newSparkles(flash, c1, c2, R, u)
	-- shock ring + sparks (shown at the reveal)
	play.Shock = {}
	for i = 1, 28 do
		local part = effectPart(play, "EvolveShock", nil, (i % 2 == 0) and lighten(c2, 0.2) or WHITE, Vector3.new(u * 0.5, u * 0.18, u * 1.4))
		part.Transparency = 1
		play.Shock[i] = part
	end
	play.Sparks = {}
	for i = 1, K.SPARKS[stage] do
		local part = effectPart(play, "EvolveSpark", nil, (i % 3 == 0) and WHITE or ((i % 2 == 0) and c1 or c2), Vector3.new(u * 0.45, u * 0.45, u * 0.45))
		part.Transparency = 1
		local a = hash(i, 5) * TAU
		local speed = R * (2.4 + hash(i, 6) * 2.2)
		play.Sparks[i] = {
			Part = part,
			V = Vector3.new(math.cos(a) * speed, R * (2.2 + hash(i, 7) * 2.6), math.sin(a) * speed),
			Spin = Vector3.new(hash(i, 8) * 9, hash(i, 9) * 9, hash(i, 10) * 9),
		}
	end
	-- confetti (Phase 4's EVOLVE moment): flat voxel bits that pop up from the pet and flutter down
	play.Confetti = {}
	if play.ConfettiOn then
		for i = 1, K.CONFETTI do
			local col = K.CONFETTI_COLORS[(i - 1) % #K.CONFETTI_COLORS + 1]
			local part = effectPart(play, "EvolveConfetti", nil, col, Vector3.new(u * 0.5, u * 0.08, u * 0.32))
			part.Material = Enum.Material.SmoothPlastic
			part.Transparency = 1
			local a = hash(i, 13) * TAU
			local speed = R * (0.8 + hash(i, 14) * 1.6)
			play.Confetti[i] = {
				Part = part,
				V = Vector3.new(math.cos(a) * speed, R * (3 + hash(i, 15) * 2.4), math.sin(a) * speed),
				Spin = Vector3.new(4 + hash(i, 16) * 8, hash(i, 17) * 6, 3 + hash(i, 18) * 8),
				Phase = hash(i, 19) * TAU,
			}
		end
	end
end

local function cleanup(play)
	if play.Folder then
		pcall(function()
			play.Folder:Destroy()
		end)
		play.Folder = nil
	end
end

local function finish(play)
	if play.Handle.Done then
		return
	end
	play.Handle.Done = true
	-- fromModel goes, toModel rests exactly at the pose (scale 1)
	if play.From and play.From.Model then
		pcall(function()
			play.From.Model:Destroy()
		end)
	end
	if play.To and play.To.Model then
		if not play.To.Model.Parent then
			play.To.Model.Parent = play.Parent
		end
		poseRig(play.To, play.Pose, 1)
	end
	play.Handle.Model = play.To and play.To.Model or nil
	cleanup(play)
	for i = #plays, 1, -1 do
		if plays[i] == play then
			table.remove(plays, i)
		end
	end
	maybeStopLoop()
	if type(play.OnDone) == "function" and play.To then
		local ok, err = pcall(play.OnDone, play.To.Model)
		if not ok then
			warn("[EvolutionFx] OnDone failed: " .. tostring(err))
		end
	end
end

local function step(play, dt)
	play.T = play.T + dt
	local t = play.T
	local c, b, r, s = play.Charge, K.BURST, K.REVEAL, K.SETTLE
	local pose, H, R, u = play.Pose, play.Height, play.Radius, play.Unit
	local rise = H * K.RISE
	local runeTurn = t * 0.9
	-- the rune rings: grow while charging, stay through the reveal, fade while settling
	local ringP = smooth(t / (c * 0.6))
	local ringFade = clamp01((t - (c + b + r)) / s)
	local runeList, cfs = {}, {}
	for _, rune in ipairs(play.Runes) do
		local radius = R * (0.45 + 0.75 * ringP) * ((rune.Ring == 2) and 0.68 or 1)
		local turn = (rune.Ring == 2) and -runeTurn * 1.4 or runeTurn
		runeList[#runeList + 1] = rune.Part
		cfs[#cfs + 1] = ringPose(play, rune.I, rune.N, radius, turn, (rune.Ring == 2) and 0.1 or 0.06)
		rune.Part.Transparency = 1 - ringP * 0.9 * (1 - ringFade)
	end
	if #runeList > 0 then
		Workspace:BulkMoveTo(runeList, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	local centre = pose.Position + Vector3.new(0, rise * smooth(t / c), 0)
	if t < c then
		-- charge: rise, spin up, shake a little, glow; motes spiral in; the pillar rises
		local p = t / c
		play.Yaw = play.Yaw + dt * TAU * K.SPIN * p * p
		local shake = H * 0.015 * p * p
		local jx = (hash(math.floor(t * 30), 11) - 0.5) * shake
		local jz = (hash(math.floor(t * 30), 12) - 0.5) * shake
		poseRig(play.From, pose * CFrame.new(jx, rise * smooth(p), jz) * CFrame.Angles(0, play.Yaw, 0), 1)
		play.Glow.FillTransparency = 1 - 0.78 * smooth(p)
		play.Glow.OutlineTransparency = 1 - smooth(p * 1.4)
		local moteList, moteCfs = {}, {}
		for i, m in ipairs(play.Motes) do
			local q = clamp01((p - m.Delay) / (1 - m.Delay))
			local radius = R * 1.9 * (1 - easeIn(q)) + R * 0.1
			local a = m.A + q * TAU * 1.6
			local y = pose.Position.Y - H * 0.4 + H * m.Y * (1 - q * 0.5) + rise * smooth(p)
			moteList[i] = m.Part
			moteCfs[i] = CFrame.new(centre.X + math.cos(a) * radius, y, centre.Z + math.sin(a) * radius) * CFrame.Angles(t * 3 + i, t * 2, 0)
			m.Part.Transparency = (q > 0 and q < 0.98) and 0.05 or 1
		end
		Workspace:BulkMoveTo(moteList, moteCfs, Enum.BulkMoveMode.FireCFrameChanged)
		local ph = play.PillarHeight * smooth(p * 1.3)
		local w = R * (0.9 + 0.3 * p)
		play.Pillar.Size = Vector3.new(math.max(0.1, ph), w, w)
		play.Pillar.CFrame = CFrame.new(centre.X, play.Ground + ph / 2, centre.Z) * CFrame.Angles(0, 0, math.pi / 2)
		play.Pillar.Transparency = 1 - 0.38 * smooth(p * 1.5)
		play.Light.Brightness = 3 * p
	elseif t < c + b then
		-- burst: the pet shrinks into a white flash; the pillar flares
		if not play.BurstStarted then
			play.BurstStarted = true
			for _, m in ipairs(play.Motes) do
				m.Part.Transparency = 1
			end
		end
		local p = (t - c) / b
		play.Yaw = play.Yaw + dt * TAU * K.SPIN
		poseRig(play.From, pose * CFrame.new(0, rise, 0) * CFrame.Angles(0, play.Yaw, 0), math.max(K.MIN_SCALE, 1 - easeIn(p)))
		local fs = (R * 0.4 + R * 1.3 * easeOut(p)) * 2
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.CFrame = CFrame.new(centre)
		play.Flash.Transparency = 0.2 + 0.2 * p
		local w = R * (1.2 + 1.2 * easeOut(p))
		play.Pillar.Size = Vector3.new(play.PillarHeight, w, w)
		play.Pillar.Transparency = 0.55 + 0.45 * p
		play.Light.Brightness = 3 + 3 * p
	elseif t < c + b + r then
		-- reveal: swap the pets once, then the evolved pet pops out, spins down to face forward and sinks back
		if not play.Swapped then
			play.Swapped = true
			pcall(function()
				play.From.Model.Parent = nil
			end)
			play.To.Model.Parent = play.Parent
			play.Glow.Adornee = play.To.Model
			play.Glow.FillColor = WHITE
			play.Glow.FillTransparency = 0
			play.Glow.OutlineTransparency = 0
			play.Handle.Model = play.To.Model
			play.Pillar.Transparency = 1
			play.Emitter:Emit(play.Stage == 2 and 70 or 45)
			play.SparkT0 = t
		end
		local p = (t - c - b) / r
		local yaw = TAU * K.REVEAL_TURNS * easeOut(p)
		local scale = K.MIN_SCALE + (1 - K.MIN_SCALE) * easeOutBack(math.min(1, p * 1.25))
		poseRig(play.To, pose * CFrame.new(0, rise * (1 - smooth(p)), 0) * CFrame.Angles(0, yaw, 0), math.max(K.MIN_SCALE, scale))
		play.Glow.FillTransparency = smooth(p)
		play.Glow.OutlineTransparency = smooth(p * 0.8)
		local fs = R * 1.7 * 2 * (1 + 0.35 * p)
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.Transparency = 0.4 + 0.6 * smooth(p * 3)
		play.Light.Brightness = 6 * (1 - p)
	else
		-- settle: hold the pose while the effects fade, then finish
		poseRig(play.To, pose, 1)
		play.Glow.FillTransparency = 1
		play.Glow.OutlineTransparency = 1
		play.Flash.Transparency = 1
		play.Light.Brightness = 0
		if t >= c + b + r + s then
			finish(play)
			return
		end
	end
	-- the shock ring and the sparks (from the swap on)
	if play.SparkT0 then
		local q = t - play.SparkT0
		local shockP = clamp01(q / 0.85)
		local list, list2 = {}, {}
		for i, part in ipairs(play.Shock) do
			list[i] = part
			list2[i] = ringPose(play, i, #play.Shock, R * (0.8 + 2.4 * easeOut(shockP)), 0, 0.12)
			part.Transparency = (shockP < 1) and (0.1 + 0.9 * shockP) or 1
		end
		Workspace:BulkMoveTo(list, list2, Enum.BulkMoveMode.FireCFrameChanged)
		local sl, sc = {}, {}
		local base = pose.Position + Vector3.new(0, rise * 0.5, 0)
		for i, sp in ipairs(play.Sparks) do
			local pos = base + sp.V * q + Vector3.new(0, -0.5 * 26 * q * q, 0)
			if pos.Y < play.Ground + u * 0.2 then
				pos = Vector3.new(pos.X, play.Ground + u * 0.2, pos.Z)
			end
			sl[i] = sp.Part
			sc[i] = CFrame.new(pos) * CFrame.Angles(sp.Spin.X * q, sp.Spin.Y * q, sp.Spin.Z * q)
			sp.Part.Transparency = clamp01(q / 1.2)
		end
		Workspace:BulkMoveTo(sl, sc, Enum.BulkMoveMode.FireCFrameChanged)
		if #play.Confetti > 0 then
			-- up fast, then a slow flutter down (drag), fading out near the end of the settle
			local cl, cc = {}, {}
			local top = pose.Position + Vector3.new(0, H * 0.6, 0)
			local fade = clamp01((q - 1.3) / 0.6)
			for i, cf in ipairs(play.Confetti) do
				local k = 1 - math.exp(-2.2 * q)
				local drift = cf.V * (k / 2.2)
				local fall = 2.4 * math.max(0, q - 0.35) ^ 1.5
				local sway = math.sin(q * 6 + cf.Phase) * u * 0.6
				local pos = top + Vector3.new(drift.X + sway, drift.Y - fall * R, drift.Z)
				if pos.Y < play.Ground + u * 0.1 then
					pos = Vector3.new(pos.X, play.Ground + u * 0.1, pos.Z)
				end
				cl[i] = cf.Part
				cc[i] = CFrame.new(pos) * CFrame.Angles(cf.Spin.X * q, cf.Spin.Y * q, cf.Spin.Z * q)
				cf.Part.Transparency = fade
			end
			Workspace:BulkMoveTo(cl, cc, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	play.Handle.T = t
end

----------------------------------------------------------------------
-- An enemy's arrival (EvolutionFx.Arrive): pooled kits of effect parts, effects only
----------------------------------------------------------------------
local function kitPart(folder, name, shape)
	local p = effectPart({ Folder = folder }, name, shape, WHITE, Vector3.new(0.2, 0.2, 0.2))
	p.Transparency = 1
	return p
end

local function kitCount(kit)
	local n = #kit.Shock + #kit.Runes + #kit.Sparks + 1
	if kit.Pillar then
		n = n + 1
	end
	return n
end

-- one kit: Low = the flash + the shock ring; High adds the rune ring, the pillar (+ light), the sparkles, the sparks
local function newKit(low)
	local folder = Instance.new("Folder")
	folder.Name = "ArriveFx"
	local kit = { Low = low, Folder = folder, Runes = {}, Shock = {}, Sparks = {}, SparkV = {}, SparkSpin = {}, BufP = {}, BufC = {} }
	kit.Flash = kitPart(folder, "ArriveFlash", Enum.PartType.Ball)
	for i = 1, low and K.ARRIVE_SHOCK_LOW or K.ARRIVE_SHOCK do
		kit.Shock[i] = kitPart(folder, "ArriveShock")
	end
	if not low then
		for i = 1, K.ARRIVE_RUNES do
			kit.Runes[i] = kitPart(folder, "ArriveRune")
		end
		kit.Pillar = kitPart(folder, "ArrivePillar", Enum.PartType.Cylinder)
		local light = Instance.new("PointLight")
		light.Name = "ArriveLight"
		light.Brightness = 0
		light.Parent = kit.Pillar
		kit.Light = light
		kit.Emitter, kit.Tune = newSparkles(kit.Flash, WHITE, WHITE, 2, 0.6)
		for i = 1, K.ARRIVE_SPARKS do
			kit.Sparks[i] = kitPart(folder, "ArriveSpark")
		end
	end
	return kit
end

-- the kit's parts sized and coloured for this arrival (once per play, never per frame)
local function dressKit(kit, play)
	local c1, c2, R, u = play.Colors[1], play.Colors[2], play.Radius, play.Unit
	kit.Flash.Size = Vector3.new(0.2, 0.2, 0.2)
	kit.Flash.Color = WHITE
	for i, part in ipairs(kit.Shock) do
		part.Size = Vector3.new(u * 0.5, u * 0.18, u * 1.3)
		part.Color = (i % 2 == 0) and lighten(c2, 0.2) or WHITE
	end
	for i, part in ipairs(kit.Runes) do
		part.Size = Vector3.new(u * 0.55, u * 0.14, u * ((i % 3 == 0) and 1.5 or 0.9))
		part.Color = (i % 2 == 0) and c1 or c2
	end
	if kit.Pillar then
		kit.Pillar.Color = lighten(c1, 0.45)
		kit.Light.Color = lighten(c1, 0.3)
		kit.Light.Range = math.min(32, R * 4 + 8)
		kit.Light.Brightness = 0
		kit.Tune(c1, c2, R, u)
	end
	for i, part in ipairs(kit.Sparks) do
		part.Size = Vector3.new(u * 0.45, u * 0.45, u * 0.45)
		part.Color = (i % 3 == 0) and WHITE or ((i % 2 == 0) and c1 or c2)
		local a = hash(i, 5) * TAU + play.Salt
		local speed = R * (2.0 + hash(i, 6) * 1.8)
		kit.SparkV[i] = Vector3.new(math.cos(a) * speed, R * (2 + hash(i, 7) * 2.2), math.sin(a) * speed)
		kit.SparkSpin[i] = Vector3.new(hash(i, 8) * 9, hash(i, 9) * 9, hash(i, 10) * 9)
	end
end

local function hideKit(kit)
	kit.Flash.Transparency = 1
	for _, list in ipairs({ kit.Shock, kit.Runes, kit.Sparks }) do
		for _, part in ipairs(list) do
			part.Transparency = 1
		end
	end
	if kit.Pillar then
		kit.Pillar.Transparency = 1
		kit.Light.Brightness = 0
	end
end

local function takeKit(low, parent)
	local pool = kitPool[low and "Low" or "High"]
	while #pool > 0 do
		local kit = table.remove(pool)
		if pcall(function()
			kit.Folder.Parent = parent
		end) then
			return kit
		end
	end
	local kit = newKit(low)
	kit.Folder.Parent = parent
	return kit
end

local function giveKit(kit)
	hideKit(kit)
	local pool = kitPool[kit.Low and "Low" or "High"]
	if #pool < K.ARRIVE_POOL then
		pcall(function()
			kit.Folder.Parent = nil
		end)
		pool[#pool + 1] = kit
	else
		pcall(function()
			kit.Folder:Destroy()
		end)
	end
end

local function arriveFlash(play)
	if play.Flashed then
		return
	end
	play.Flashed = true
	play.Handle.Flashed = true
	if play.Kit and play.Kit.Emitter then
		play.Kit.Emitter:Emit(K.ARRIVE_SPARKLES)
	end
	if type(play.OnFlash) == "function" then
		local ok, err = pcall(play.OnFlash)
		if not ok then
			warn("[EvolutionFx] OnFlash failed: " .. tostring(err))
		end
	end
end

local function arriveFinish(play)
	if play.Handle.Done then
		return
	end
	arriveFlash(play) -- (a Stop before the flash still shows the pet)
	play.Handle.Done = true
	if play.Kit then
		giveKit(play.Kit)
		play.Kit = nil
	end
	for i = #arrivals, 1, -1 do
		if arrivals[i] == play then
			table.remove(arrivals, i)
		end
	end
	maybeStopLoop()
	if type(play.OnDone) == "function" then
		local ok, err = pcall(play.OnDone)
		if not ok then
			warn("[EvolutionFx] OnDone failed: " .. tostring(err))
		end
	end
end

-- per frame: one arrival (reused buffers: no table per frame)
local function arriveStep(play, dt)
	play.T = play.T + dt
	local t, D, F = play.T, play.Dur, play.FlashAt
	local kit = play.Kit
	local R, u = play.Radius, play.Unit
	local centre = play.Pose.Position
	local bp, bc = kit.BufP, kit.BufC
	if t >= F then
		arriveFlash(play)
	end
	-- the rune ring: grows and turns, fades out at the end
	local n = #kit.Runes
	if n > 0 then
		local grow = smooth(t / (0.3 * D))
		local fade = clamp01((t - 0.65 * D) / (0.35 * D))
		local alpha = 1 - (1 - fade) * 0.9 * smooth(t / (0.25 * D))
		for i, part in ipairs(kit.Runes) do
			bp[i] = part
			bc[i] = ringPose(play, i, n, R * (0.5 + 0.8 * grow), t * 1.6, 0.06)
			part.Transparency = alpha
		end
		for i = n + 1, #bp do
			bp[i], bc[i] = nil, nil
		end
		Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
	end
	-- the pillar rises until the flash, flares, then fades
	local pillar = kit.Pillar
	if pillar then
		local rise = easeOut(clamp01((t - 0.04 * D) / (F - 0.04 * D)))
		local after = clamp01((t - F) / (0.3 * D))
		local h = math.max(0.1, play.PillarHeight * rise)
		local w = R * (0.9 + 0.6 * after)
		pillar.Size = Vector3.new(h, w, w)
		pillar.CFrame = CFrame.new(centre.X, play.Ground + h / 2, centre.Z) * CFrame.Angles(0, 0, math.pi / 2)
		pillar.Transparency = (t < F) and (1 - 0.45 * rise) or (0.55 + 0.45 * after)
		kit.Light.Brightness = (t < F) and (4 * rise) or (4 * (1 - after))
	end
	-- the white flash
	local fp = (t - (F - 0.06 * D)) / (0.32 * D)
	if fp > 0 and fp < 1 then
		local fs = (R * 0.5 + R * 2.1 * easeOut(fp)) * 2
		kit.Flash.Size = Vector3.new(fs, fs, fs)
		kit.Flash.CFrame = CFrame.new(centre)
		kit.Flash.Transparency = 0.12 + 0.88 * smooth(fp)
	else
		kit.Flash.Transparency = 1
	end
	-- the shock ring and the sparks (from the flash on)
	if t >= F then
		local q = t - F
		local sp = clamp01(q / (0.45 * D))
		local m = #kit.Shock
		for i, part in ipairs(kit.Shock) do
			bp[i] = part
			bc[i] = ringPose(play, i, m, R * (0.6 + 2.6 * easeOut(sp)), 0, 0.12)
			part.Transparency = (sp < 1) and (0.1 + 0.9 * sp) or 1
		end
		for i = m + 1, #bp do
			bp[i], bc[i] = nil, nil
		end
		Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
		local k = #kit.Sparks
		if k > 0 then
			local fade = clamp01(q / (D - F))
			for i, part in ipairs(kit.Sparks) do
				local pos = centre + kit.SparkV[i] * q + Vector3.new(0, -13 * q * q, 0)
				if pos.Y < play.Ground + u * 0.2 then
					pos = Vector3.new(pos.X, play.Ground + u * 0.2, pos.Z)
				end
				local spin = kit.SparkSpin[i]
				bp[i] = part
				bc[i] = CFrame.new(pos) * CFrame.Angles(spin.X * q, spin.Y * q, spin.Z * q)
				part.Transparency = fade
			end
			for i = k + 1, #bp do
				bp[i], bc[i] = nil, nil
			end
			Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	play.Handle.T = t
	if t >= D then
		arriveFinish(play)
	end
end

local function wantLow(opts)
	if opts.Quality == "Low" or opts.Quality == "High" then
		return opts.Quality == "Low"
	end
	if quality == nil then
		quality = false
		local client = script.Parent and script.Parent.Parent
		local mod = client and client:FindFirstChild("GraphicsQuality")
		if mod then
			local ok, result = pcall(require, mod)
			if ok and type(result) == "table" and type(result.Effective) == "function" then
				quality = result
			end
		end
	end
	if quality then
		local ok, mode = pcall(quality.Effective)
		return ok and mode == "Low"
	end
	return false
end

function EvolutionFx.Arrive(pivot, opts)
	opts = type(opts) == "table" and opts or {}
	local D = (type(opts.Seconds) == "number" and opts.Seconds > 0.2) and math.min(opts.Seconds, 4) or K.ARRIVE_SECONDS
	local handle = { Done = false, Flashed = false, Low = false, FlashAt = D * K.ARRIVE_FLASH, T = 0 }
	local play = { Handle = handle, OnFlash = opts.OnFlash, OnDone = opts.OnDone }
	handle.Stop = function()
		pcall(arriveFinish, play)
	end
	if typeof(pivot) ~= "CFrame" then
		handle.Stop()
		return handle
	end
	local high, low = 0, 0
	for _, a in ipairs(arrivals) do
		if a.Low then
			low = low + 1
		else
			high = high + 1
		end
	end
	local isLow = wantLow(opts) or high >= K.ARRIVE_MAX
	if isLow and low >= K.ARRIVE_MAX_LOW then
		handle.Stop() -- too many at once: no effect, the pet just appears
		return handle
	end
	local colors = type(opts.Colors) == "table" and opts.Colors or {}
	local H = (type(opts.Height) == "number" and opts.Height > 0) and opts.Height or 3.5
	local R = (type(opts.Radius) == "number" and opts.Radius > 0) and opts.Radius or 1.8
	play.Low = isLow
	play.Pose = pivot
	play.Dur = D
	play.FlashAt = handle.FlashAt
	play.Height = math.max(1, H)
	play.Radius = math.max(0.8, R)
	play.Unit = math.max(0.5, math.min(play.Radius, play.Height) * 0.22)
	play.Ground = (type(opts.Ground) == "number") and opts.Ground or (pivot.Position.Y - play.Height / 2)
	play.PillarHeight = math.min(28, play.Height * 6)
	play.Colors = {
		typeof(colors[1]) == "Color3" and colors[1] or Color3.fromRGB(255, 214, 90),
		typeof(colors[2]) == "Color3" and colors[2] or Color3.fromRGB(120, 200, 255),
	}
	play.Salt = (#arrivals + 1) * 0.37 + (pivot.Position.X + pivot.Position.Z) * 0.01
	play.T = 0
	handle.Low = isLow
	local parent = (typeof(opts.Parent) == "Instance") and opts.Parent or Workspace
	play.Kit = takeKit(isLow, parent)
	dressKit(play.Kit, play)
	arrivals[#arrivals + 1] = play
	ensureLoop()
	return handle
end

function EvolutionFx.ArriveStats()
	local out = { Live = 0, LiveLow = 0, Pooled = #kitPool.High + #kitPool.Low, Parts = 0 }
	for _, a in ipairs(arrivals) do
		if a.Low then
			out.LiveLow = out.LiveLow + 1
		else
			out.Live = out.Live + 1
		end
		if a.Kit then
			out.Parts = out.Parts + kitCount(a.Kit)
		end
	end
	return out
end

onFrame = function(dt)
	dt = math.min(dt, 0.1)
	for i = #plays, 1, -1 do
		local play = plays[i]
		if play then
			local ok, err = pcall(step, play, dt)
			if not ok then
				warn("[EvolutionFx] " .. tostring(err))
				pcall(finish, play)
			end
		end
	end
	for i = #arrivals, 1, -1 do
		local play = arrivals[i]
		if play then
			local ok, err = pcall(arriveStep, play, dt)
			if not ok then
				warn("[EvolutionFx] arrive: " .. tostring(err))
				pcall(arriveFinish, play)
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function EvolutionFx.Duration(stage)
	return K.CHARGE[(stage == 2) and 2 or 1] + K.BURST + K.REVEAL + K.SETTLE
end

function EvolutionFx.Count()
	return #plays
end

function EvolutionFx.Play(fromModel, toModel, pose, opts)
	opts = type(opts) == "table" and opts or {}
	local handle = { Done = false, Model = fromModel, T = 0 }
	local from = (typeof(fromModel) == "Instance") and rigOf(fromModel) or nil
	local to = (typeof(toModel) == "Instance") and rigOf(toModel) or nil
	if not (from and to) or typeof(pose) ~= "CFrame" then
		warn("[EvolutionFx] Play needs two PetBuilder models and a CFrame")
		handle.Done = true
		handle.Stop = function() end
		return handle
	end
	local stage = (opts.Stage == 2) and 2 or 1
	local colors = type(opts.Colors) == "table" and opts.Colors or {}
	local parent = (typeof(opts.Parent) == "Instance") and opts.Parent or Workspace
	local height, radius, low = measure(to)
	local play = {
		Handle = handle,
		From = from,
		To = to,
		Pose = pose,
		Stage = stage,
		Colors = {
			typeof(colors[1]) == "Color3" and colors[1] or Color3.fromRGB(255, 214, 90),
			typeof(colors[2]) == "Color3" and colors[2] or Color3.fromRGB(120, 200, 255),
		},
		Parent = parent,
		Charge = K.CHARGE[stage],
		Height = math.max(1, height),
		Radius = math.max(0.8, radius),
		Ground = (type(opts.Ground) == "number") and opts.Ground or (pose.Position.Y + low - 0.5),
		OnDone = opts.OnDone,
		ConfettiOn = opts.Confetti == true,
		T = 0,
		Yaw = 0,
	}
	local folder = Instance.new("Folder")
	folder.Name = "EvolutionFx"
	folder.Parent = parent
	play.Folder = folder
	toModel.Parent = nil
	poseRig(from, pose, 1)
	buildEffects(play)
	handle.Stop = function()
		pcall(finish, play)
	end
	plays[#plays + 1] = play
	ensureLoop()
	return handle
end

return EvolutionFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="876">
            <Properties>
              <string name="Name">FusionController</string>
              <string name="Source"><![CDATA[-- FusionController (client, Phase 2): the Fusion Machine window (ARCHITECTURE_V3.md section 11 and the
-- FusionService / FusionController paragraph of the "Phase 2 build contract").
--
--   FusionController.Init()
--   FusionController.Open(tab, args)   tab = "Upgrade" | "Mix" | nil (the last one); args (optional) =
--                                       { Key = key (Upgrade input / first Mix pet), KeyB = key (second Mix pet) }
--   FusionController.Close()
--   Extras: FusionController.IsOpen() -> bool, FusionController.Plan() -> the preview the window shows
--           ({ Ok, Reason, Action, Inputs, ResultKey, ResultName, Rarity, Tier, Cost = {Currency, Amount}, Notes }),
--           FusionController.Select(keyA, keyB) (picks pets like clicks do), FusionController.Fuse() (the FUSE
--           button), FusionController.Opened / Closed (Util.Signal)
--
-- How it opens: E at the player's own Fusion Machine (the FusionPrompt HomeBuilder puts on Station_FusionMachine;
-- other players' prompts are disabled locally by HomeFx and ignored here), or OpenPanel("Fusion", {Tab =, Key =})
-- from the server / other windows. One window at a time: opening it closes the menu windows, and a menu window or the
-- Pet Index opening closes it. Esc, gamepad B, the red X or a click outside close it; so does walking away from the
-- machine (when it was opened there) and entering a match.
--
-- Layout (CloudUI panel, violet like the machine):
--   top     two tabs, UPGRADE and MIX, and the player's Cloud Tokens / Gems
--   left    "Your pets": a grid of pet tiles (ViewportFrame, name, "x3" copies, a gold star when equipped).
--           UPGRADE lists every regular pet that can still go up a finish (3 copies needed, the others dimmed);
--           MIX lists every regular pet (hybrids are one of a kind and cannot be fused again).
--   right   the preview: UPGRADE = the input (x3) -> the next finish (Golden / Rainbow) in a big ViewportFrame with
--           its x1.5 / x2.5 bonus; MIX = Body + Style -> a preview of the hybrid (PetKeys.DefOf of a stand-in
--           record: the real one gets its own random look seed), its blended name, rarity, elements, tier.
--           Then the notes (copies that are equipped / working at home are taken off first; why a fusion is not
--           possible), the cost (TycoonCatalog.FusionCost with the machine's discount; red when short) and FUSE.
-- FUSE sends Remotes.Fusion("Upgrade", key) / ("Mix", keyA, keyB); the server checks everything again and answers
-- with Fusion:FireClient("Result", {Ok, Key, Name, Reason...}). On success a short fusion animation plays: the inputs
-- fly into the centre, a flash and a confetti burst, the new pet pops in with a NEW! ribbon, and a burst of glowing
-- cubes leaves the machine's output pod (client-only parts, gone after a second).
-- Readability rule: designed in 1080p pixels (body 18-19, captions 18, buttons 22, titles 28-34) under ONE
-- UIScale = min(screen factor, fit); the window adapts between 800x456 and 1080x700 design pixels so landscape
-- phones keep >= 14 px text; every text has a stroke and sits on a solid panel. Pet viewports are attached under a
-- per-frame time budget (cached Low clones in the grid, High in the preview), all on CloudUI's one update loop.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	warn("[FusionController] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetKeys = safeRequire("PetKeys")
local PetCatalog = safeRequire("PetCatalog")
local TycoonCatalog = safeRequire("TycoonCatalog")

local FusionController = {}
FusionController.Opened = Util.Signal()
FusionController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen)
----------------------------------------------------------------------
local K = {
	PREF_W = 760, -- Phase 5 (6.6): docked right / a bottom sheet (NeonKit.Dock), 760 x 860 design px
	PREF_H = 860,
	MIN_W = 800,
	MIN_H = 390,
	MARGIN = 12,
	SHORT = 560, -- below this design height the compact layout is used (landscape phones)
	TOP_H = 54,
	TOP_H_SHORT = 44,
	-- portrait phones: the preview on top, the picker below (used when less than TALL_W design px are free)
	TALL_W = 800, -- (every docked Fusion window is one column: the preview on top, the picker below)
	PREF_W_TALL = 560,
	MIN_W_TALL = 360,
	PREF_H_TALL = 1000,
	MIN_H_TALL = 600,
	PREVIEW_TALL_H = 440,
	RESULT_TALL = 124,
	INPUT_TALL = 82,
	PICKER_W = 520,
	PICKER_W_NARROW = 396,
	NARROW = 960,
	GAP = 12,
	TILE_W = 112,
	TILE_H = 162,
	TILE_W_SHORT = 104,
	TILE_H_SHORT = 122,
	TILE_GAP = 10,
	RESULT = 176,
	RESULT_SHORT = 92,
	INPUT = 108,
	INPUT_SHORT = 68,
	RESULT_MIN = 72, -- the smallest result card a cramped portrait preview shrinks to
	RESULT_FULL_MIN = 100, -- the full preview (title + pills) shrinks its cards down to this before it goes compact
	RESULT_SIDE = 84, -- landscape phones: the cards beside the name column
	INPUT_SIDE = 60,
	NOTE_MIN = 24, -- one line of notes (18 px text) under the name / pills
	TILE_BUDGET = 0.004, -- seconds of pet viewport building per frame (at least one per frame)
	TILES_MAX = 3,
	FUSE_TIMEOUT = 6, -- seconds the FUSE button waits for the server before it resets
	MACHINE_RANGE = 24, -- studs: the window closes when the player walks this far from the machine it opened at
	NEAR_RANGE = 30, -- studs: FUSE needs the player this close to their machine (the server allows a little more)
	BACK_ACTION = "NimbusFusionBack",
	DISPLAY_ORDER = 22, -- above NimbusMenu (20) and the Pet Index (21)
	PREVIEW_SEED = 4242, -- look seed of the Mix preview (the real hybrid draws its own)
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local GOOD = Colors.Good
local BAD = Colors.Bad
local ACCENT = Color3.fromRGB(150, 104, 230) -- the machine's violet (title bar, tabs)
local INSET = Color3.fromRGB(20, 26, 66)
local TILE_FACE = Color3.fromRGB(58, 70, 136)
local TILE_SELECTED = Color3.fromRGB(110, 92, 196)
local WARN = Color3.fromRGB(255, 214, 110)
local TOKEN_INFO = Theme.Currency and Theme.Currency.Tokens or { Glyph = "\226\152\129", Color = GOLD }
local GEM_INFO = Theme.Currency and Theme.Currency.Gems or { Glyph = "\226\151\134", Color = Colors.Gem }
local TIER_COLORS = {
	Normal = Color3.fromRGB(150, 164, 196),
	Golden = Color3.fromRGB(240, 186, 60),
	Rainbow = Color3.fromRGB(214, 120, 230),
}
local G = {
	Crystal = "\240\159\148\174",
	Up = "\226\172\134",
	Dna = "\240\159\167\172",
	Arrow = "\226\150\182",
	Plus = "+",
	Star = "\226\152\133",
	Sparkle = "\226\156\168",
	Lock = "\240\159\148\146",
	Swap = "\226\135\132",
}
local NEXT_TIER = { Normal = "Golden", Golden = "Rainbow" }
local TIER_RANK = { Normal = 1, Golden = 2, Rainbow = 3 }

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local initialized = false
local LocalPlayer = nil
local warned = {}

local S = {
	Open = false,
	Built = false,
	Tab = "Upgrade",
	UpKey = nil, -- Upgrade input key
	MixA = nil, -- Mix: Body
	MixB = nil, -- Mix: Style
	Pending = nil, -- { Action, Token, At } while a request waits for the server
	Animating = false,
	Token = 0, -- bumps on every open / close (stale delayed callbacks check it)
	AtMachine = nil, -- the machine model the window was opened at (nil when opened from elsewhere)
	Tiles = {}, -- [key] = tile
	Queue = {}, -- tiles waiting for their viewport
	BackBound = false,
	Short = false,
	Narrow = false,
	Tall = false,
	Plan = nil,
	ResultSig = nil, -- what the result viewport shows (rebuilt only when it changes)
	InputSig = nil,
	FuseToken = 0,
}

local U = {} -- ui references

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[FusionController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function makeFrame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel with a readable stroke + glyph outline.
local function makeText(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Stroke = 0.25,
		StrokeColor = INK,
		Outline = 1.5,
		OutlineColor = INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

local function corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

local function round(parent)
	return Theme.Corner(parent, UDim.new(0.5, 0))
end

local function stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

local function pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

local function inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = INSET
	p.BackgroundTransparency = 0.38
	local frame = makeFrame(parent, name, p)
	corner(frame, 12)
	stroke(frame, Colors.WellEdge or NAVY, 3, 0.15)
	return frame
end

local function commas(n)
	return Util.Commas(math.max(0, math.floor(tonumber(n) or 0)))
end

local function rarityAccent(rarityId)
	if rarityId == "Secret" then
		return Color3.fromRGB(150, 110, 232)
	end
	return CloudUI.RarityColor(rarityId)
end

local function pill(parent, name, text, color, layoutOrder)
	local label = makeText(parent, name, text, "Label", 18, WHITE, {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Darken(color, 0.25),
		LayoutOrder = layoutOrder or 0,
	})
	round(label)
	stroke(label, NAVY, 2, 0)
	pad(label, 12, 0, 12, 1)
	return label
end

----------------------------------------------------------------------
-- Pets, rules and costs (a mirror of FusionService: the server decides)
----------------------------------------------------------------------
local function parse(key)
	if not PetKeys or type(key) ~= "string" then
		return nil
	end
	local ok, parsed = pcall(PetKeys.Parse, key)
	if ok and type(parsed) == "table" then
		return parsed
	end
	return nil
end

local function defOf(key)
	local ok, def = pcall(State.DefOf, key)
	if ok and type(def) == "table" then
		return def
	end
	if PetKeys then
		local ok2, def2 = pcall(PetKeys.DefOf, key, State.Get())
		if ok2 and type(def2) == "table" then
			return def2
		end
	end
	return nil
end

local function catalogDef(petId)
	if PetCatalog and type(PetCatalog.Get) == "function" and type(petId) == "string" then
		local ok, def = pcall(PetCatalog.Get, petId)
		if ok and type(def) == "table" then
			return def
		end
	end
	return nil
end

local function nameOf(def, key)
	if type(def) == "table" then
		return tostring(def.DisplayName or def.Name or key)
	end
	return tostring(key)
end

local function owned(key)
	local ok, n = pcall(State.OwnedCount, key)
	if ok and type(n) == "number" then
		return n
	end
	return 0
end

local function equippedCount(key)
	local ok, n = pcall(State.EquippedCount, key)
	if ok and type(n) == "number" then
		return n
	end
	return 0
end

local function homeOf()
	local ok, home = pcall(State.Home)
	if ok and type(home) == "table" then
		return home
	end
	return { Level = 0, Prestige = 0, Stations = {}, Garden = {}, Gym = {} }
end

local function balance(currency)
	if currency == "Gems" then
		local ok, n = pcall(State.Gems)
		return (ok and type(n) == "number") and n or 0
	end
	local ok, n = pcall(State.Tokens)
	return (ok and type(n) == "number") and n or 0
end

local function copiesNeeded()
	local f = TycoonCatalog and TycoonCatalog.Fusion
	local n = type(f) == "table" and tonumber(rawget(f, "Copies")) or nil
	if n and n >= 2 then
		return math.floor(n)
	end
	return 3
end

local function unlockStars()
	local p = TycoonCatalog and TycoonCatalog.Prestige
	local n = type(p) == "table" and tonumber(p.FusionUnlock) or nil
	return n and math.floor(n) or 1
end

local function machineLevel()
	local stations = homeOf().Stations
	local lv = type(stations) == "table" and tonumber(stations.FusionMachine) or nil
	return lv and math.floor(lv) or 0
end

-- ok, reason
local function unlocked()
	local home = homeOf()
	local stars = tonumber(home.Prestige) or 0
	if stars < unlockStars() then
		return false, G.Lock .. " The Fusion Machine unlocks at Prestige " .. unlockStars()
	end
	if machineLevel() < 1 then
		return false, G.Lock .. " Build the Fusion Machine at your home first"
	end
	return true
end

local function costOf(action, rarity, tier)
	if not TycoonCatalog or type(TycoonCatalog.FusionCost) ~= "function" then
		return nil
	end
	local ok, cost = pcall(TycoonCatalog.FusionCost, action, rarity, tier, machineLevel())
	if not ok or type(cost) ~= "table" then
		return nil
	end
	if type(cost.Gems) == "number" and cost.Gems > 0 then
		return { Currency = "Gems", Amount = math.ceil(cost.Gems) }
	end
	if type(cost.Tokens) == "number" then
		return { Currency = "Tokens", Amount = math.ceil(cost.Tokens) }
	end
	return nil
end

local function rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 0
		end
	end
	return 0
end

-- What taking these copies frees: notes for the player, and whether it would leave nothing equipped.
local function usageNotes(inputs)
	local snap = State.Get()
	local equippedTotal = type(snap.Equipped) == "table" and #snap.Equipped or 0
	local home = homeOf()
	local dropped, placedOff = 0, 0
	for _, input in ipairs(inputs) do
		local left = owned(input.Key) - input.Count
		dropped = dropped + math.max(0, equippedCount(input.Key) - left)
		local placed = 0
		for _, k in pairs(type(home.Garden) == "table" and home.Garden or {}) do
			if k == input.Key then
				placed = placed + 1
			end
		end
		for _, k in pairs(type(home.Gym) == "table" and home.Gym or {}) do
			if k == input.Key then
				placed = placed + 1
			end
		end
		placedOff = placedOff + math.max(0, placed - left)
	end
	-- every note has a Short form for the one-line layouts (landscape phones)
	local notes = {}
	if equippedTotal > 0 and dropped >= equippedTotal then
		return notes, "Those are your only equipped pets: unequip them or equip another pet first", "Equip another pet first"
	end
	if dropped > 0 then
		notes[#notes + 1] = {
			Text = dropped .. " equipped cop" .. (dropped == 1 and "y is" or "ies are") .. " taken off first; the new pet takes the slot",
			Short = "Unequips " .. dropped .. " cop" .. (dropped == 1 and "y" or "ies") .. " first",
			Color = WARN,
		}
	end
	if placedOff > 0 then
		notes[#notes + 1] = {
			Text = placedOff .. " cop" .. (placedOff == 1 and "y leaves" or "ies leave") .. " the Garden / Gym first; the new pet takes over",
			Short = placedOff .. " cop" .. (placedOff == 1 and "y leaves" or "ies leave") .. " the Garden / Gym first",
			Color = WARN,
		}
	end
	return notes, nil
end

-- The preview of the current selection (the same checks the server makes, in the same order).
local function computePlan()
	local plan = { Ok = false, Action = S.Tab, Notes = {} }
	local okUnlock, why = unlocked()
	if not okUnlock then
		plan.Reason = why
		plan.Locked = true
		return plan
	end
	if not PetKeys then
		plan.Reason = "Fusion is not available right now"
		return plan
	end
	if S.Tab == "Upgrade" then
		local key = S.UpKey
		local parsed = key and parse(key)
		if not parsed then
			plan.Reason = "Pick a pet with " .. copiesNeeded() .. " copies"
			plan.Empty = true
			return plan
		end
		local def = defOf(key)
		local base = catalogDef(parsed.PetId)
		local nextTier = NEXT_TIER[parsed.Tier]
		plan.Inputs = { { Key = key, Count = copiesNeeded() } }
		plan.InputDef = def
		if parsed.HybridId or not base then
			plan.Reason = "Hybrids are one of a kind: they cannot be upgraded"
			return plan
		end
		if not nextTier then
			plan.Reason = "Rainbow is the best finish: this pet cannot go higher"
			return plan
		end
		plan.Tier = nextTier
		plan.Rarity = base.Rarity
		plan.ResultKey = PetKeys.Make(parsed.PetId, nextTier)
		plan.ResultDef = plan.ResultKey and PetKeys.DefOf(plan.ResultKey) or nil
		plan.ResultName = nameOf(plan.ResultDef, plan.ResultKey)
		plan.Cost = costOf("Upgrade", base.Rarity, nextTier)
		local have = owned(key)
		if have < copiesNeeded() then
			plan.Reason = "You need " .. copiesNeeded() .. " copies of " .. nameOf(def, key) .. " (you have " .. have .. ")"
			return plan
		end
	elseif S.Tab == "Mix" then
		local a, b = S.MixA, S.MixB
		local pa, pb = a and parse(a), b and parse(b)
		plan.Inputs = {}
		if pa then
			plan.Inputs[#plan.Inputs + 1] = { Key = a, Count = 1 }
		end
		if pb then
			plan.Inputs[#plan.Inputs + 1] = { Key = b, Count = 1 }
		end
		if not pa or not pb then
			plan.Reason = "Pick two different pets to mix"
			plan.Empty = true
			return plan
		end
		if pa.HybridId or pb.HybridId then
			plan.Reason = "Hybrids cannot be mixed again: pick two regular pets"
			return plan
		end
		if pa.PetId == pb.PetId then
			plan.Reason = "Pick two different pets to mix"
			return plan
		end
		local baseA, baseB = catalogDef(pa.PetId), catalogDef(pb.PetId)
		if not baseA or not baseB then
			plan.Reason = "Unknown pet"
			return plan
		end
		local rarity = (rarityOrder(baseB.Rarity) > rarityOrder(baseA.Rarity)) and baseB.Rarity or baseA.Rarity
		local tier = ((TIER_RANK[pb.Tier] or 1) < (TIER_RANK[pa.Tier] or 1)) and pb.Tier or pa.Tier
		local name = "Hybrid"
		if type(PetKeys.BlendName) == "function" then
			local okName, blended = pcall(PetKeys.BlendName, baseA.Name, baseB.Name)
			if okName and type(blended) == "string" then
				name = blended
			end
		end
		local elements = {}
		for _, e in ipairs({ baseA.Element, baseB.Element }) do
			if type(e) == "string" and e ~= elements[1] then
				elements[#elements + 1] = e
			end
		end
		local record = { Body = pa.PetId, Style = pb.PetId, Tier = tier, Rarity = rarity, Name = name, Elements = elements, Seed = K.PREVIEW_SEED }
		local previewKey = PetKeys.HybridKey("preview", tier)
		local okDef, def = pcall(PetKeys.DefOf, previewKey, { Hybrids = { preview = record } })
		plan.ResultDef = okDef and def or nil
		plan.ResultName = (tier ~= "Normal" and (tier .. " ") or "") .. name
		plan.Rarity = rarity
		plan.Tier = tier
		plan.Elements = elements
		plan.Cost = costOf("Mix", rarity, nil)
		if owned(a) < 1 or owned(b) < 1 then
			plan.Reason = "You do not own those pets"
			return plan
		end
	else
		plan.Reason = "Pick a tab"
		return plan
	end
	if not plan.Cost then
		plan.Reason = "These pets cannot be fused"
		return plan
	end
	local notes, rule, ruleShort = usageNotes(plan.Inputs)
	plan.Notes = notes
	if rule then
		plan.Reason = rule
		plan.ReasonShort = ruleShort
		return plan
	end
	local have = balance(plan.Cost.Currency)
	plan.CanAfford = have >= plan.Cost.Amount
	if not plan.CanAfford then
		plan.Reason = "Not enough " .. ((plan.Cost.Currency == "Gems") and "Gems" or "Cloud Tokens") .. " (you have " .. commas(have) .. ")"
		-- (the compact layouts: the red cost line already says how much, the HUD shows the balance)
		plan.ReasonShort = "Not enough " .. ((plan.Cost.Currency == "Gems") and "Gems" or "Cloud Tokens")
		return plan
	end
	if State.Get() and LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		plan.Reason = "Fusion is closed during a match"
		return plan
	end
	plan.Ok = true
	return plan
end

----------------------------------------------------------------------
-- The machine in the world (the player's own Station_FusionMachine)
----------------------------------------------------------------------
local function myMachine()
	local uid = LocalPlayer and LocalPlayer.UserId
	if not uid then
		return nil
	end
	for _, home in ipairs(CollectionService:GetTagged("NC_Home")) do
		if home:GetAttribute("OwnerUserId") == uid then
			local station = home:FindFirstChild("Station_FusionMachine")
			if station then
				return station
			end
		end
	end
	return nil
end

local function rootPart()
	local character = LocalPlayer and LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function distanceTo(model)
	local root = rootPart()
	if not root or not model or not model.Parent then
		return math.huge
	end
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if not ok or typeof(pivot) ~= "CFrame" then
		return math.huge
	end
	return (root.Position - pivot.Position).Magnitude
end

-- the output pod (where the FusionPrompt rides), or the model's pivot
local function outputPoint(model)
	if not model then
		return nil
	end
	local prompt = model:FindFirstChild("FusionPrompt", true)
	local holder = prompt and prompt.Parent
	if holder and holder:IsA("Attachment") then
		return holder.WorldPosition
	end
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if ok and typeof(pivot) == "CFrame" then
		return pivot.Position + Vector3.new(0, 3, 0)
	end
	return nil
end

----------------------------------------------------------------------
-- Layout (readability rule + fit)
----------------------------------------------------------------------
local function guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function viewportHeight()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return guiSize().Y
end

-- Phase 5 (6.6): NeonKit.Dock keeps the window docked right / a bottom sheet; returns its design size and "tall"
-- (one column); the hotbar re-centres left of the docked window
local function fitWindow()
	if not U.Dock then
		U.Kit = U.Kit or require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("NeonKit"))
		U.Dock = U.Kit.Dock(U.Holder, U.Fit, K.PREF_W, K.PREF_H)
	end
	U.Dock.Refresh()
	local r = U.Dock.Rect
	local w, h = math.floor(r.designW + 0.5), math.floor(r.designH + 0.5)
	return w, h, w < K.TALL_W, r
end

-- HotbarController.SetAvoidRight(x | nil) (6.6)
local function avoidRight(x)
	local hb = script.Parent:FindFirstChild("HotbarController")
	local ok, mod = pcall(function()
		return hb and require(hb)
	end)
	if ok and type(mod) == "table" and type(mod.SetAvoidRight) == "function" then
		pcall(mod.SetAvoidRight, x)
	end
end

local layoutPreview -- defined below

local function relayout()
	if not S.Built then
		return
	end
	local w, h, tall, rect = fitWindow()
	if S.Open then
		avoidRight(rect.mode == "Side" and rect.x or nil)
	end
	S.Tall = tall
	local short = h < K.SHORT
	S.Short = short
	S.Narrow = w < K.NARROW
	local pickerW = S.Narrow and K.PICKER_W_NARROW or K.PICKER_W
	local topH = short and K.TOP_H_SHORT or K.TOP_H
	U.Top.Size = UDim2.new(1, -20, 0, topH)
	U.Top.Position = UDim2.fromOffset(10, short and 6 or 10)
	local tabW = short and 176 or 196
	if tall then
		tabW = math.floor((w - 20 - 30) / 2)
	end
	for i, name in ipairs({ "Upgrade", "Mix" }) do
		local tab = U.Tabs[name]
		tab.Size = UDim2.fromOffset(tabW, short and 42 or 50)
		tab.Position = UDim2.fromOffset((i - 1) * (tabW + 10), short and 1 or 2)
		tab.TextSize = short and 22 or 24
	end
	-- (the tall layout has no room for the balance chips: the cost line turns red and says what is missing)
	U.Chips.Visible = not tall
	U.Chips.Size = UDim2.new(0, 360, 0, short and 40 or 44)
	U.Chips.Position = UDim2.new(1, 0, 0, short and 2 or 5)
	for _, chip in ipairs({ U.TokenChip, U.GemChip }) do
		chip.Size = UDim2.fromOffset(0, short and 40 or 44)
		chip.TextSize = short and 22 or 24
	end
	U.Body.Position = UDim2.fromOffset(10, topH + (short and 12 or 16))
	U.Body.Size = UDim2.new(1, -20, 1, -(topH + (short and 18 or 26)))
	if tall then
		-- (a short sheet gives the preview a bit more than half its body)
		local previewH = math.min(K.PREVIEW_TALL_H, math.floor((h - 90) * 0.58))
		S.PreviewH = previewH
		U.Preview.Position = UDim2.new(0, 0, 0, 0)
		U.Preview.Size = UDim2.new(1, 0, 0, previewH)
		U.Picker.Position = UDim2.new(0, 0, 0, previewH + K.GAP)
		U.Picker.Size = UDim2.new(1, 0, 1, -(previewH + K.GAP))
	else
		S.PreviewH = nil
		U.Picker.Position = UDim2.new(0, 0, 0, 0)
		U.Picker.Size = UDim2.new(0, pickerW, 1, 0)
		U.Preview.Position = UDim2.new(0, pickerW + K.GAP, 0, 0)
		U.Preview.Size = UDim2.new(1, -(pickerW + K.GAP), 1, 0)
	end
	U.PickerTitle.Size = UDim2.new(0.45, 0, 0, short and 28 or 32)
	U.PickerTitle.Position = UDim2.fromOffset(14, short and 4 or 8)
	U.PickerHint.Position = UDim2.new(1, -14, 0, short and 4 or 10)
	U.Grid.Position = UDim2.fromOffset(8, short and 36 or 46)
	U.Grid.Size = UDim2.new(1, -16, 1, -(short and 42 or 54))
	U.GridLayout.CellSize = UDim2.fromOffset(short and K.TILE_W_SHORT or K.TILE_W, short and K.TILE_H_SHORT or K.TILE_H)
	for _, tile in pairs(S.Tiles) do
		tile.Mode = nil
	end
	layoutPreview()
end

----------------------------------------------------------------------
-- Back button (gamepad B) while the window is open
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		FusionController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function syncBackBinding()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		local ok, err = pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
		if not ok then
			warnOnce("bind back", err)
		end
	else
		task.defer(function()
			if not S.BackBound then
				pcall(function()
					ContextActionService:UnbindAction(K.BACK_ACTION)
				end)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Pet tiles (left)
----------------------------------------------------------------------
local refresh -- defined below

-- keys the current tab lists, in display order
local function pickerKeys()
	local ok, keys = pcall(State.Keys)
	if not ok or type(keys) ~= "table" then
		keys = {}
	end
	local out = {}
	local need = copiesNeeded()
	for i, key in ipairs(keys) do
		local parsed = parse(key)
		if parsed and not parsed.HybridId then
			if S.Tab == "Mix" or NEXT_TIER[parsed.Tier] then
				out[#out + 1] = { Key = key, Order = i, Ready = owned(key) >= need }
			end
		end
	end
	if S.Tab == "Upgrade" then
		table.sort(out, function(a, b)
			if a.Ready ~= b.Ready then
				return a.Ready
			end
			return a.Order < b.Order
		end)
	end
	return out
end

local function destroyTileViewport(tile)
	if tile.Viewport then
		pcall(tile.Viewport.Destroy)
		tile.Viewport = nil
	end
end

local function buildTileViewport(tile)
	if tile.Viewport or not tile.Button.Parent then
		return
	end
	local def = defOf(tile.Key)
	if not def then
		return
	end
	-- Phase 5 (3.7): the copy's stored stage (evolved = Low)
	local stage = (type(State.PetStage) == "function" and tonumber(State.PetStage(tile.Key))) or 0
	tile.Stage = stage
	tile.Viewport = CloudUI.PetViewport(tile.View, def, UDim2.new(1, 0, 1, 0), { Detail = "Low", Spin = "sway", Evolved = stage >= 1 and stage or nil })
end

local function onTileClicked(key)
	if S.Pending or S.Animating then
		return
	end
	if S.Tab == "Upgrade" then
		S.UpKey = (S.UpKey == key) and nil or key
	else
		if S.MixA == key then
			S.MixA = nil
		elseif S.MixB == key then
			S.MixB = nil
		elseif not S.MixA then
			S.MixA = key
		elseif not S.MixB then
			S.MixB = key
		else
			S.MixB = key
		end
	end
	refresh()
end

local function newTile(key)
	local tile = { Key = key }
	local button = Util.Create("TextButton", {
		Name = "Tile",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = TILE_FACE,
		Parent = U.Grid,
	})
	corner(button, 12)
	tile.Stroke = stroke(button, NAVY, 3, 0)
	Theme.Gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 204, 230), 90)
	tile.Button = button
	tile.View = makeFrame(button, "View", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(1, -16, 0, 92),
	})
	tile.Name = makeText(button, "PetName", "", "Label", 18, WHITE, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(1, -10, 0, 44),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	tile.Count = makeText(button, "Count", "x1", "Heading", 18, WHITE, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -5, 0, 5),
		Size = UDim2.fromOffset(46, 26),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(30, 40, 90),
		ZIndex = 3,
	})
	round(tile.Count)
	stroke(tile.Count, NAVY, 2, 0)
	tile.Equipped = makeText(button, "Equipped", G.Star, "Heading", 18, GOLD, {
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(30, 40, 90),
		ZIndex = 3,
		Visible = false,
	})
	round(tile.Equipped)
	-- the Mix pick order (1 = Body, 2 = Style) sits in the top-left corner, clear of the pet's face
	tile.Mark = makeText(button, "Mark", "", "Title", 20, WHITE, {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = ACCENT,
		ZIndex = 4,
		Visible = false,
	})
	round(tile.Mark)
	stroke(tile.Mark, NAVY, 2, 0)
	tile.Dim = makeFrame(button, "Dim", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 0.5,
		BackgroundColor3 = Color3.fromRGB(10, 14, 36),
		ZIndex = 2,
		Visible = false,
	})
	corner(tile.Dim, 12)
	button.Activated:Connect(function()
		safe("tile", onTileClicked, key)
	end)
	S.Tiles[key] = tile
	S.Queue[#S.Queue + 1] = tile
	return tile
end

local function paintTile(tile, order, ready)
	local def = defOf(tile.Key)
	local mode = S.Short and "Short" or "Wide"
	if tile.Mode ~= mode then
		tile.Mode = mode
		tile.View.Size = UDim2.new(1, -16, 0, S.Short and 64 or 92)
		tile.Name.Size = UDim2.new(1, -10, 0, S.Short and 26 or 44)
		tile.Name.TextWrapped = not S.Short
		tile.Name.Position = UDim2.new(0.5, 0, 1, S.Short and -4 or -6)
	end
	tile.Button.LayoutOrder = order
	tile.Name.Text = nameOf(def, tile.Key)
	local n = owned(tile.Key)
	tile.Count.Text = "x" .. n
	local need = copiesNeeded()
	if S.Tab == "Upgrade" then
		tile.Count.BackgroundColor3 = (n >= need) and Theme.Darken(GOOD, 0.35) or Color3.fromRGB(30, 40, 90)
		tile.Dim.Visible = n < need
	else
		tile.Count.BackgroundColor3 = Color3.fromRGB(30, 40, 90)
		tile.Dim.Visible = false
	end
	tile.Equipped.Visible = equippedCount(tile.Key) > 0
	local selected = false
	local mark = nil
	if S.Tab == "Upgrade" then
		selected = S.UpKey == tile.Key
	else
		if S.MixA == tile.Key then
			selected, mark = true, "1"
		elseif S.MixB == tile.Key then
			selected, mark = true, "2"
		end
	end
	tile.Button.BackgroundColor3 = selected and TILE_SELECTED or TILE_FACE
	tile.Stroke.Color = selected and GOLD or NAVY
	tile.Stroke.Thickness = selected and 4 or 3
	tile.Mark.Visible = mark ~= nil
	tile.Mark.Text = mark or ""
	-- the equipped star moves down a row while the pick mark holds the corner
	tile.Equipped.Position = UDim2.fromOffset(mark and 6 or 5, mark and 38 or 5)
	local rarity = type(def) == "table" and def.Rarity or nil
	if not selected and rarity then
		tile.Stroke.Color = Theme.Darken(rarityAccent(rarity), 0.35)
	end
end

local function refreshTiles()
	local list = pickerKeys()
	local wanted = {}
	for i, entry in ipairs(list) do
		wanted[entry.Key] = true
		local tile = S.Tiles[entry.Key] or newTile(entry.Key)
		-- a copy that evolved meanwhile rebuilds its viewport (the per-frame builder picks it up again)
		if tile.Viewport and tile.Stage ~= ((type(State.PetStage) == "function" and tonumber(State.PetStage(entry.Key))) or 0) then
			destroyTileViewport(tile)
		end
		paintTile(tile, i, entry.Ready)
	end
	for key, tile in pairs(S.Tiles) do
		if not wanted[key] then
			destroyTileViewport(tile)
			tile.Button:Destroy()
			S.Tiles[key] = nil
		end
	end
	U.Empty.Visible = #list == 0
	if S.Tab == "Upgrade" then
		U.Empty.Text = "No pets to upgrade yet. Roll more copies at the roulettes!"
		U.PickerHint.Text = "Pick a pet with " .. copiesNeeded() .. " copies"
	else
		U.Empty.Text = "You need at least two different pets to mix."
		U.PickerHint.Text = "Pick two different pets"
	end
end

-- pet viewports under a per-frame time budget
local function fillViewports()
	if #S.Queue == 0 then
		return
	end
	local started = os.clock()
	local built = 0
	while #S.Queue > 0 and built < K.TILES_MAX do
		local tile = table.remove(S.Queue, 1)
		if tile.Button.Parent then
			safe("viewport", buildTileViewport, tile)
			built = built + 1
		end
		if os.clock() - started > K.TILE_BUDGET then
			break
		end
	end
end

----------------------------------------------------------------------
-- Preview (right)
----------------------------------------------------------------------
local function slotFrame(parent, name, size)
	local holder = makeFrame(parent, name, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(44, 54, 116),
		ZIndex = 3,
	})
	corner(holder, 14)
	local s = stroke(holder, NAVY, 3, 0)
	Theme.Gradient(holder, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 186, 220), 90)
	local view = makeFrame(holder, "View", { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ZIndex = 4 })
	local q = makeText(holder, "Placeholder", "?", "Title", 40, MUTED, {
		Size = UDim2.new(1, 0, 1, 0),
		TextTransparency = 0.2,
		ZIndex = 4,
	})
	local scale = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = holder })
	return { Frame = holder, View = view, Stroke = s, Placeholder = q, Scale = scale, Viewport = nil, Def = nil }
end

local function setSlotPet(slot, def, detail, stage)
	stage = math.floor(tonumber(stage) or 0)
	if slot.Def == def and slot.Viewport and slot.Stage == stage then
		return
	end
	slot.Stage = stage
	if slot.Viewport then
		pcall(slot.Viewport.Destroy)
		slot.Viewport = nil
	end
	slot.Def = def
	slot.Placeholder.Visible = def == nil
	if def then
		local ok, handle = pcall(CloudUI.PetViewport, slot.View, def, UDim2.new(1, 0, 1, 0), {
			Detail = stage >= 1 and "Low" or (detail or "High"),
			Evolved = stage >= 1 and stage or nil, -- Phase 5 (3.7)
			Spin = "spin",
			ZIndex = 4,
		})
		if ok then
			slot.Viewport = handle
		end
	end
end

layoutPreview = function()
	if not U.Preview then
		return
	end
	local short = S.Short
	local tall = S.Tall
	local mix = S.Tab == "Mix"
	local result = short and K.RESULT_SHORT or K.RESULT
	local input = short and K.INPUT_SHORT or K.INPUT
	if tall and not short then
		result, input = K.RESULT_TALL, K.INPUT_TALL
	end
	local bottomH = short and 52 or 64
	-- the room above the cost / FUSE row (design px; only the one-column window knows its preview height)
	local avail = S.PreviewH and (S.PreviewH - bottomH - (short and 6 or 12) - 4) or nil
	-- landscape phones (a short one-column sheet): the cards on the left, the name and the one-line note beside them
	local side = short and tall and avail ~= nil
	-- portrait phones: when the full stack (title, big cards, name, pills, one line of notes) does not fit above the
	-- FUSE row, the title steps aside (the tab says it) and the cards shrink until a line of notes fits again
	local tight = false
	local pills = not short
	local block = 78 -- name 36 + 2, pills 32 + 8
	if tall and not short and avail then
		local fitFull = avail - (54 + 26 + 2 + block + K.NOTE_MIN)
		if fitFull < result and fitFull >= K.RESULT_FULL_MIN then
			-- (a little short: slightly smaller cards keep the full stack)
			result = fitFull
			input = math.floor(result * K.INPUT_TALL / K.RESULT_TALL + 0.5)
		elseif fitFull < result then
			tight = true
			block = 66 -- name 30 + 2, pills 30 + 4
			local extra = mix and 26 or 8
			local fit = avail - 4 - extra - 2 - block - K.NOTE_MIN
			if fit < K.RESULT_MIN then
				-- not even the smallest cards leave room: the pills go, the name keeps its line
				pills = false
				block = 32
				fit = avail - 4 - extra - 2 - block - K.NOTE_MIN
			end
			result = math.max(K.RESULT_MIN, math.min(K.RESULT_TALL, fit))
			input = math.floor(result * K.INPUT_TALL / K.RESULT_TALL + 0.5)
		end
	end
	if side then
		result, input = K.RESULT_SIDE, K.INPUT_SIDE
		if mix then
			-- (two cards side by side: a little smaller, so the name column keeps its width)
			result, input = result - 4, input - 6
		end
	end
	S.PreviewMode = side and "Side" or (tight and "Tight" or (short and "Short" or "Full"))
	local compactRow = short or tight
	U.PreviewTitle.Visible = not compactRow
	local rowY = compactRow and 4 or (tall and 54 or 66)
	local rowH = result + ((mix or not compactRow) and 26 or 8)
	-- where the inputs, the arrow and the result sit (fractions of the slot row)
	local xIn, xArrow, xRes = 0.25, 0.53, 0.76
	U.SlotRow.Position = UDim2.new(0, 0, 0, rowY)
	U.SlotRow.Size = UDim2.new(1, 0, 0, rowH)
	local rowW = 0
	if side then
		-- the slot row only as wide as its cards (design px), the rest is the name column
		local mid, arrowX, resX
		if mix then
			local gap = input * 0.62
			mid = 10 + input / 2 + gap
			arrowX = mid + gap + input / 2 + 16
		else
			mid = 6 + input / 2 + 11 -- (the fanned stack spreads 8 px and tilts a little)
			arrowX = mid + input / 2 + 26
		end
		resX = arrowX + 18 + result / 2
		rowW = math.floor(resX + result / 2 + 4)
		xIn, xArrow, xRes = mid / rowW, arrowX / rowW, resX / rowW
		U.SlotRow.Size = UDim2.new(0, rowW, 0, rowH)
	end
	local cy = result / 2 + 4
	U.ResultSlot.Frame.Size = UDim2.fromOffset(result, result)
	U.ResultSlot.Frame.Position = UDim2.new(xRes, 0, 0, cy)
	U.Arrow.Position = UDim2.new(xArrow, 0, 0, cy)
	for _, slot in ipairs(U.InSlots) do
		slot.Frame.Size = UDim2.fromOffset(input, input)
	end
	if not mix then
		-- three copies fanned out like a stack of cards
		local fan = compactRow and (side and 8 or 10) or 16
		U.InSlots[1].Frame.Position = UDim2.new(xIn, -fan, 0, cy - fan * 0.75)
		U.InSlots[2].Frame.Position = UDim2.new(xIn, 0, 0, cy)
		U.InSlots[3].Frame.Position = UDim2.new(xIn, fan, 0, cy + fan * 0.75)
		U.InSlots[1].Frame.Rotation = -6
		U.InSlots[3].Frame.Rotation = 6
		U.InSlots[2].Frame.Rotation = 0
		U.InSlots[1].Frame.Visible = true
		U.InSlots[3].Frame.Visible = true
		U.Plus.Visible = false
		U.CaptionA.Visible = false
		U.CaptionB.Visible = false
		U.Swap.Visible = false
	else
		local gap = input * 0.62
		U.InSlots[1].Frame.Position = UDim2.new(xIn, -gap, 0, cy)
		U.InSlots[2].Frame.Position = UDim2.new(xIn, gap, 0, cy)
		U.InSlots[1].Frame.Rotation = 0
		U.InSlots[2].Frame.Rotation = 0
		U.InSlots[3].Frame.Visible = false
		U.InSlots[1].Frame.Visible = true
		U.CaptionA.Visible = true
		U.CaptionB.Visible = true
		-- ("Body" / "Style" under small cards: a caption no wider than its card's column)
		local capW = math.min(110, input + 12)
		U.CaptionA.Size = UDim2.fromOffset(capW, 24)
		U.CaptionB.Size = UDim2.fromOffset(capW, 24)
		U.CaptionA.Position = UDim2.new(xIn, -gap, 0, cy + input / 2 + 2)
		U.CaptionB.Position = UDim2.new(xIn, gap, 0, cy + input / 2 + 2)
		local swap = S.MixA ~= nil and S.MixB ~= nil
		U.Swap.Visible = swap
		if compactRow then
			-- no room above the cards: the swap button takes the plus sign's place between them
			U.Plus.Visible = not swap
			U.Swap.Position = UDim2.new(xIn, 0, 0, cy + 18)
		else
			U.Plus.Visible = true
			U.Swap.Position = UDim2.new(xIn, 0, 0, cy - input / 2 - 2)
		end
		U.Plus.Position = UDim2.new(xIn, 0, 0, cy)
	end
	local y = rowY + rowH + 2
	-- (in the side column the name is the first line of the details list, the note stacks right under it)
	U.ResultName.Parent = side and U.Details or U.Preview
	U.ResultName.LayoutOrder = 0
	if side then
		-- a column right of the cards: the name (one line, cut with "...") over the note
		U.Pills.Visible = false
		U.ResultName.Position = UDim2.new(0, 0, 0, 0)
		U.ResultName.Size = UDim2.new(1, 0, 0, 26)
		U.ResultName.TextSize = 20
		U.Details.Position = UDim2.new(0, rowW + 4, 0, 6)
		U.Details.Size = UDim2.new(1, -(rowW + 18), 0, math.max(0, avail - 6))
	elseif short or not pills then
		-- no room for the pills: the name (in its rarity colour) and a summary line instead
		U.ResultName.Position = UDim2.new(0, 14, 0, y)
		U.ResultName.Size = UDim2.new(1, -28, 0, 30)
		U.ResultName.TextSize = 24
		U.Pills.Visible = false
		y = y + 32
	else
		U.Pills.Visible = true
		U.ResultName.Position = UDim2.new(0, 14, 0, y)
		U.ResultName.Size = UDim2.new(1, -28, 0, tight and 30 or 36)
		U.ResultName.TextSize = tight and 24 or 28
		y = y + (tight and 32 or 38)
		U.Pills.Position = UDim2.new(0, 14, 0, y)
		U.Pills.Size = UDim2.new(1, -28, 0, tight and 30 or 32)
		U.PillsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		y = y + (tight and 34 or 40)
	end
	local compact = short or S.Tall
	U.Bottom.Size = UDim2.new(1, -28, 0, bottomH)
	U.Bottom.Position = UDim2.new(0, 14, 1, short and -6 or -12)
	U.Cost.TextSize = compact and 24 or 28
	U.FuseButton.Size = UDim2.fromOffset(compact and 170 or 214, short and 48 or 58)
	U.FuseButton.TextSize = compact and 24 or 28
	-- on a phone Roblox's jump button covers the bottom-right corner: FUSE goes to the left and the cost follows it
	-- (left-aligned right after the button), so the corner under the jump button stays empty
	local leftFuse = short and UserInputService.TouchEnabled
	S.CostOnly = leftFuse -- the cost shows without its "Cost:" label there (shorter, clear of the jump button)
	local fuseW = compact and 170 or 214
	U.FuseButton.AnchorPoint = leftFuse and Vector2.new(0, 0.5) or Vector2.new(1, 0.5)
	U.FuseButton.Position = leftFuse and UDim2.new(0, 0, 0.5, 0) or UDim2.new(1, 0, 0.5, 0)
	U.Cost.AnchorPoint = Vector2.new(0, 0.5)
	U.Cost.Position = leftFuse and UDim2.new(0, fuseW + 14, 0.5, 0) or UDim2.new(0, 0, 0.5, 0)
	U.Cost.TextXAlignment = Enum.TextXAlignment.Left
	U.Cost.Size = UDim2.new(1, -(fuseW + 14), 0, 40)
	-- a note with room for one line only stays on one line ("..." when long; the compact layouts use the notes'
	-- short forms), so it is never cut through the middle; the side column wraps it under the name
	local oneLine = not side and (short or tight or (avail ~= nil and avail - y < 2 * K.NOTE_MIN))
	U.Info.TextWrapped = not oneLine
	U.Info.TextTruncate = oneLine and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None
	if not side then
		U.Details.Position = UDim2.new(0, 14, 0, y)
		U.Details.Size = UDim2.new(1, -28, 0, math.max(0, avail and (avail - y) or 0))
		if not avail then
			U.Details.Size = UDim2.new(1, -28, 1, -(y + bottomH + (short and 8 or 20)))
		end
	end
	U.ServerNote.Position = UDim2.new(0, 14, 1, -(bottomH + (short and 10 or 18)))
	-- the locked card: a smaller crystal and no teaser line on short screens
	if U.LockedSub then
		U.LockedSub.Visible = not short
		U.LockedIcon.Size = short and UDim2.fromOffset(64, 64) or UDim2.fromOffset(90, 90)
		U.LockedIcon.TextSize = short and 46 or 64
		U.LockedIcon.Position = UDim2.new(0.5, 0, short and 0.42 or 0.4, 0)
		U.LockedText.Position = UDim2.new(0.5, 0, short and 0.46 or 0.43, 0)
		U.LockedSub.Position = UDim2.new(0.5, 0, 0.43, 70)
	end
end

local function setNotes(plan)
	for _, child in ipairs(U.Details:GetChildren()) do
		if child:IsA("TextLabel") and child ~= U.Info and child ~= U.ResultName then
			child:Destroy()
		end
	end
	U.Info.Visible = true
	S.NotesToken = (S.NotesToken or 0) + 1
	local mine = S.NotesToken
	local order = 1
	local function add(text, color)
		order = order + 1
		makeText(U.Details, "Note" .. order, text, "Body", 18, color or MUTED, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
		})
	end
	local lines = {}
	if plan.Reason and not plan.Empty then
		lines[#lines + 1] = { Text = plan.Reason, Short = plan.ReasonShort, Color = BAD }
	end
	for _, note in ipairs(plan.Notes or {}) do
		lines[#lines + 1] = note
	end
	if plan.Ok and not S.MachineNear then
		lines[#lines + 1] = { Text = "Walk up to your Fusion Machine to fuse", Color = WARN }
	end
	if S.Short or (S.Tall and #lines > 0) then
		-- one line only: the most important note replaces the summary / explanation
		local first = lines[1]
		if first then
			U.Info.Text = ((S.Short or S.PreviewMode == "Tight") and first.Short) or first.Text
			U.Info.TextColor3 = first.Color or MUTED
		end
		return
	end
	for _, line in ipairs(lines) do
		add(line.Text, line.Color)
	end
	-- when the explanation and the notes do not both fit (smaller screens, long names), the notes win: the general
	-- explanation steps aside instead of a warning being clipped at the bottom
	if #lines > 0 then
		local function fit()
			-- (a newer refresh owns the details now; the one-line layouts never hide their only line)
			if S.NotesToken ~= mine or S.Short or S.Tall or not U.Details or not U.Info.Parent then
				return
			end
			U.Info.Visible = true
			-- the stacked height of the lines (their absolute sizes plus the list padding)
			local scale = (U.Fit and U.Fit.Scale) or 1
			local used, n = 0, 0
			for _, child in ipairs(U.Details:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible then
					used = used + child.AbsoluteSize.Y
					n = n + 1
				end
			end
			used = used + math.max(0, n - 1) * 6 * scale
			local room = U.Details.AbsoluteSize.Y
			if room > 0 and used > room + 1 then
				U.Info.Visible = false
			end
		end
		fit()
		task.defer(fit)
	end
end

local function renderPills(plan)
	for _, child in ipairs(U.Pills:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if not plan.ResultDef then
		return
	end
	if plan.Rarity then
		pill(U.Pills, "Rarity", tostring(plan.Rarity), rarityAccent(plan.Rarity), 1)
	end
	if plan.Tier and plan.Tier ~= "Normal" then
		pill(U.Pills, "Tier", plan.Tier, TIER_COLORS[plan.Tier] or ACCENT, 2)
	end
	local elements = plan.Elements
	if not elements and type(plan.ResultDef) == "table" then
		elements = plan.ResultDef.Elements or { plan.ResultDef.Element }
	end
	for i, e in ipairs(elements or {}) do
		local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[e]
		if info then
			pill(U.Pills, "Element" .. i, e, info.Color, 2 + i)
		end
	end
end

-- "Legendary  Frost + Flame" (the compact layout shows this line instead of the pills)
local function summaryText(plan)
	local parts = {}
	if plan.Rarity then
		parts[#parts + 1] = tostring(plan.Rarity)
	end
	if plan.Tier and plan.Tier ~= "Normal" then
		parts[#parts + 1] = plan.Tier
	end
	local elements = plan.Elements
	if not elements and type(plan.ResultDef) == "table" then
		elements = plan.ResultDef.Elements or { plan.ResultDef.Element }
	end
	if elements and #elements > 0 then
		parts[#parts + 1] = table.concat(elements, " + ")
	end
	return table.concat(parts, "  |  ")
end

local function infoText(plan)
	-- (the compact previews have one line here: the pills' summary when they are hidden, else a short hint)
	if S.Short or S.PreviewMode == "Tight" then
		if plan.ResultDef and not U.Pills.Visible then
			return summaryText(plan)
		end
		return (S.Tab == "Upgrade") and "3 copies fuse into the next finish" or "Two different pets make a new hybrid"
	end
	if S.Tab == "Upgrade" then
		if plan.Tier == "Golden" then
			return "3 copies become 1 Golden copy: stats and perks x1.5 and a gold shine."
		elseif plan.Tier == "Rainbow" then
			return "3 Golden copies become 1 Rainbow copy: stats and perks x2.5 and a rainbow shimmer."
		end
		return "3 copies of a pet fuse into its next finish: Golden (x1.5), then Rainbow (x2.5)."
	end
	if plan.ResultDef then
		return "Body gives the shape, Style the colours and wings. Stats: average x1.2. Every hybrid is unique!"
	end
	return "Mix two different pets into a brand-new hybrid with both elements."
end

local function renderPreview(plan)
	U.PreviewTitle.Text = (S.Tab == "Upgrade") and (G.Up .. " Upgrade") or (G.Dna .. " Mix")
	-- inputs
	local inputs = {}
	if S.Tab == "Upgrade" then
		local def = S.UpKey and defOf(S.UpKey) or nil
		local have = S.UpKey and owned(S.UpKey) or 0
		for i = 1, 3 do
			inputs[i] = (def and i <= math.max(1, math.min(have, 3))) and def or nil
		end
		U.InCount.Visible = def ~= nil
		U.InCount.Text = math.min(have, copiesNeeded()) .. "/" .. copiesNeeded()
		U.InCount.BackgroundColor3 = (have >= copiesNeeded()) and Theme.Darken(GOOD, 0.3) or Theme.Darken(BAD, 0.2)
	else
		inputs[1] = S.MixA and defOf(S.MixA) or nil
		inputs[2] = S.MixB and defOf(S.MixB) or nil
		U.InCount.Visible = false
	end
	local function stageOf(key)
		return (key and type(State.PetStage) == "function" and tonumber(State.PetStage(key))) or 0
	end
	local inStage = {}
	if S.Tab == "Upgrade" then
		inStage = { stageOf(S.UpKey), stageOf(S.UpKey), stageOf(S.UpKey) }
	else
		inStage = { stageOf(S.MixA), stageOf(S.MixB) }
	end
	for i, slot in ipairs(U.InSlots) do
		setSlotPet(slot, inputs[i], (S.Tab == "Upgrade" and i ~= 2) and "Low" or "High", inStage[i])
	end
	-- result: the stage the fusion keeps (an Upgrade carries the copy's stage; a new Mix starts plain)
	if not S.Animating then
		local keep = 0
		if S.Tab == "Upgrade" and plan.ResultKey then
			keep = math.max(stageOf(S.UpKey), stageOf(plan.ResultKey))
		end
		setSlotPet(U.ResultSlot, plan.ResultDef, "High", keep)
		U.ResultSlot.Stroke.Color = plan.Rarity and rarityAccent(plan.Rarity) or NAVY
	end
	U.ResultName.Text = plan.ResultName or ((S.Tab == "Upgrade") and "Pick a pet" or "Pick two pets")
	U.ResultName.TextColor3 = plan.ResultDef and ((S.Short or not U.Pills.Visible) and plan.Rarity and Theme.Lighten(rarityAccent(plan.Rarity), 0.35) or WHITE) or MUTED
	renderPills(plan)
	U.Info.Text = infoText(plan)
	U.Info.TextColor3 = MUTED
	setNotes(plan)
	-- cost
	if plan.Cost then
		local info = (plan.Cost.Currency == "Gems") and GEM_INFO or TOKEN_INFO
		U.Cost.Text = (S.CostOnly and "" or "Cost: ") .. tostring(info.Glyph) .. " " .. commas(plan.Cost.Amount)
		U.Cost.TextColor3 = (plan.CanAfford == false) and BAD or (info.Color or GOLD)
	else
		U.Cost.Text = "Cost: -"
		U.Cost.TextColor3 = MUTED
	end
	local can = plan.Ok and S.MachineNear and not S.Pending and not S.Animating
	CloudUI.SetDisabled(U.FuseButton, not can)
	if S.Pending then
		U.FuseButton.Text = "Fusing..."
	else
		U.FuseButton.Text = G.Sparkle .. " FUSE"
	end
	U.Locked.Visible = plan.Locked == true
	if plan.Locked then
		U.LockedText.Text = plan.Reason or ""
	end
end

local function renderTop()
	U.TokenChip.Text = tostring(TOKEN_INFO.Glyph) .. " " .. Theme.ShortNumber(balance("Tokens"))
	U.GemChip.Text = tostring(GEM_INFO.Glyph) .. " " .. Theme.ShortNumber(balance("Gems"))
	for name, button in pairs(U.Tabs) do
		local on = name == S.Tab
		CloudUI.SetStyle(button, on and "Pink" or "Blue")
		local scale = button:FindFirstChild("TabScale")
		if scale then
			scale.Scale = on and 1 or 0.94
		end
	end
end

refresh = function()
	if not S.Built then
		return
	end
	-- drop selections the player no longer owns (fused away, traded...)
	if S.UpKey and owned(S.UpKey) < 1 then
		S.UpKey = nil
	end
	if S.MixA and owned(S.MixA) < 1 then
		S.MixA = nil
	end
	if S.MixB and owned(S.MixB) < 1 then
		S.MixB = nil
	end
	local machine = S.AtMachine or myMachine()
	S.MachineNear = machine ~= nil and distanceTo(machine) <= K.NEAR_RANGE
	if not machine and not myMachine() then
		-- no machine in the world to stand at (homes not built yet): the server decides
		S.MachineNear = true
	end
	renderTop()
	refreshTiles()
	layoutPreview()
	local plan = computePlan()
	S.Plan = plan
	renderPreview(plan)
end

----------------------------------------------------------------------
-- Fusing + the fusion animation
----------------------------------------------------------------------
local function burst(parent, color, amount, centre)
	local rng = Random.new()
	for i = 1, amount do
		local size = rng:NextInteger(9, 16)
		local pieceColor = color
		if i % 3 == 0 then
			pieceColor = GOLD
		elseif i % 3 == 1 then
			pieceColor = Theme.Lighten(color, 0.5)
		end
		local piece = makeFrame(parent, "Confetti", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = centre,
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 0,
			BackgroundColor3 = pieceColor,
			Rotation = rng:NextInteger(0, 90),
			ZIndex = 12,
		})
		corner(piece, 2)
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(70, 190)
		local target = UDim2.new(centre.X.Scale, centre.X.Offset + math.cos(angle) * distance, centre.Y.Scale, centre.Y.Offset + math.sin(angle) * distance * 0.7 - 20)
		local seconds = rng:NextNumber(0.6, 1.1)
		tween(piece, seconds, { Position = target, Rotation = piece.Rotation + rng:NextInteger(-200, 200) })
		tween(piece, seconds, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, seconds + 0.1)
	end
end

-- glowing cubes bursting out of the machine's output pod (client-only parts)
local function machineBurst(color)
	local machine = S.AtMachine or myMachine()
	local at = outputPoint(machine)
	if not at then
		return
	end
	local folder = workspace:FindFirstChild("ClientFx") or workspace
	local rng = Random.new()
	for i = 1, 10 do
		local part = Instance.new("Part")
		part.Name = "FusionSpark"
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = (i % 3 == 0) and GOLD or ((i % 3 == 1) and color or Theme.Lighten(color, 0.5))
		part.Size = Vector3.new(0.4, 0.4, 0.4)
		part.CFrame = CFrame.new(at)
		part.Parent = folder
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.6, 1.6), rng:NextNumber(-1, 1)).Unit
		tween(part, 0.8, { CFrame = CFrame.new(at + dir * rng:NextNumber(3, 6)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
		Debris:AddItem(part, 0.9)
	end
	local flash = Instance.new("Part")
	flash.Name = "FusionFlash"
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanTouch = false
	flash.CanQuery = false
	flash.CastShadow = false
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Theme.Lighten(color, 0.4)
	flash.Size = Vector3.new(1, 1, 1)
	flash.Transparency = 0.2
	flash.CFrame = CFrame.new(at)
	flash.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Parent = flash
	tween(flash, 0.5, { Size = Vector3.new(5, 5, 5), Transparency = 1 })
	tween(light, 0.5, { Brightness = 0 })
	Debris:AddItem(flash, 0.6)
end

local function slotCentre(slot)
	return slot.Frame.Position
end

local function playFusion(resultKey, rarity)
	S.Animating = true
	local mine = S.Token
	local color = rarity and rarityAccent(rarity) or ACCENT
	local target = slotCentre(U.ResultSlot)
	-- 1) the inputs fly into the machine (the result slot), spinning and shrinking
	local starts = {}
	for i, slot in ipairs(U.InSlots) do
		if slot.Frame.Visible then
			starts[i] = { Position = slot.Frame.Position, Rotation = slot.Frame.Rotation }
			tween(slot.Frame, 0.45, { Position = target, Rotation = slot.Frame.Rotation + 180 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(slot.Scale, 0.45, { Scale = 0.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end
	tween(U.ResultSlot.Scale, 0.45, { Scale = 0.7 })
	task.delay(0.45, function()
		if S.Token ~= mine then
			return
		end
		-- 2) a flash and a burst
		U.Flash.Position = target
		U.Flash.Size = UDim2.fromOffset(40, 40)
		U.Flash.BackgroundTransparency = 0.1
		U.Flash.BackgroundColor3 = Theme.Lighten(color, 0.6)
		U.Flash.Visible = true
		tween(U.Flash, 0.35, { Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 1 })
		burst(U.SlotRow, color, 26, target)
		safe("machine fx", machineBurst, color)
		for i, slot in ipairs(U.InSlots) do
			if starts[i] then
				slot.Frame.Visible = false
			end
		end
		-- 3) the new pet pops in
		local def = defOf(resultKey)
		if def then
			setSlotPet(U.ResultSlot, def, "High", (type(State.PetStage) == "function" and tonumber(State.PetStage(resultKey))) or 0)
		end
		U.ResultSlot.Scale.Scale = 0.4
		tween(U.ResultSlot.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		U.ResultSlot.Stroke.Color = color
		U.NewTag.Visible = true
		U.NewTag.Rotation = -8
		U.NewTag.Position = UDim2.new(target.X.Scale, target.X.Offset + 50, 0, target.Y.Offset - 70)
		if def then
			U.ResultName.Text = nameOf(def, resultKey)
		end
		task.delay(1.6, function()
			if S.Token ~= mine then
				return
			end
			-- 4) back to picking
			for i, slot in ipairs(U.InSlots) do
				if starts[i] then
					slot.Frame.Position = starts[i].Position
					slot.Frame.Rotation = starts[i].Rotation
					slot.Scale.Scale = 1
					slot.Frame.Visible = true
				end
			end
			U.Flash.Visible = false
			U.NewTag.Visible = false
			S.Animating = false
			refresh()
		end)
	end)
end

local function resetAnimation()
	S.Animating = false
	if not S.Built then
		return
	end
	for _, slot in ipairs(U.InSlots) do
		slot.Scale.Scale = 1
	end
	U.ResultSlot.Scale.Scale = 1
	U.Flash.Visible = false
	U.NewTag.Visible = false
end

local fusionRemote = nil
local function getRemote()
	if fusionRemote then
		return fusionRemote
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("Fusion")
	if remote and remote:IsA("RemoteEvent") then
		fusionRemote = remote
	end
	return fusionRemote
end

function FusionController.Fuse()
	if not S.Open or S.Pending or S.Animating then
		return false
	end
	local plan = computePlan()
	S.Plan = plan
	if not plan.Ok or not S.MachineNear then
		refresh()
		return false
	end
	local remote = getRemote()
	if not remote then
		warnOnce("remote", "the Fusion remote is missing")
		return false
	end
	S.FuseToken = S.FuseToken + 1
	local token = S.FuseToken
	S.Pending = { Action = plan.Action, Token = token, At = os.clock(), Inputs = plan.Inputs }
	if plan.Action == "Upgrade" then
		remote:FireServer("Upgrade", S.UpKey)
	else
		remote:FireServer("Mix", S.MixA, S.MixB)
	end
	-- the inputs glow while the machine works
	for _, slot in ipairs(U.InSlots) do
		if slot.Frame.Visible then
			slot.Stroke.Color = GOLD
		end
	end
	refresh()
	task.delay(K.FUSE_TIMEOUT, function()
		if S.Pending and S.Pending.Token == token then
			S.Pending = nil
			refresh()
		end
	end)
	return true
end

local function onResult(payload)
	if type(payload) ~= "table" then
		return
	end
	local pending = S.Pending
	S.Pending = nil
	if payload.Ok == true and type(payload.Key) == "string" then
		local key = payload.Key
		if not S.Built or not S.Open then
			return
		end
		-- the inputs are gone: start the next pick from the new pet when it can go on
		local parsed = parse(key)
		if S.Tab == "Upgrade" then
			S.UpKey = (parsed and NEXT_TIER[parsed.Tier]) and key or nil
		else
			S.MixA, S.MixB = nil, nil
		end
		local function play()
			if S.Open and S.Built then
				playFusion(key, payload.Rarity)
			end
		end
		if defOf(key) then
			play()
		else
			-- the profile snapshot with the new pet may land a moment after the answer
			local conn
			local done = false
			conn = State.Changed:Connect(function()
				if not done and defOf(key) then
					done = true
					conn:Disconnect()
					play()
				end
			end)
			task.delay(2, function()
				if not done then
					done = true
					conn:Disconnect()
					play()
				end
			end)
		end
	else
		if pending and S.Built then
			if not payload.Quiet then
				local reason = type(payload.Reason) == "string" and payload.Reason or "That fusion did not work"
				U.ServerNote.Text = reason
				U.ServerNote.Visible = true
				local mine = S.Token
				task.delay(4, function()
					if S.Token == mine and U.ServerNote then
						U.ServerNote.Visible = false
					end
				end)
			end
			refresh()
		end
	end
end

----------------------------------------------------------------------
-- Window
----------------------------------------------------------------------
local function setTab(tab)
	if tab ~= "Upgrade" and tab ~= "Mix" then
		return
	end
	if S.Tab ~= tab then
		S.Tab = tab
		resetAnimation()
		if U.Grid then
			U.Grid.CanvasPosition = Vector2.new(0, 0)
		end
	end
	refresh()
end

local function buildTop(content)
	local top = makeFrame(content, "Top", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, K.TOP_H),
	})
	U.Top = top
	U.Tabs = {}
	local x = 0
	for _, spec in ipairs({ { "Upgrade", G.Up .. " UPGRADE" }, { "Mix", G.Dna .. " MIX" } }) do
		local name = spec[1]
		local button = CloudUI.Button({
			Name = "Tab_" .. name,
			Text = spec[2],
			Style = "Blue",
			Size = UDim2.fromOffset(196, 50),
			Position = UDim2.fromOffset(x, 2),
			TextSize = 24,
			Callback = function()
				safe("tab", setTab, name)
			end,
			Parent = top,
		})
		Util.Create("UIScale", { Name = "TabScale", Scale = 1, Parent = button })
		U.Tabs[name] = button
		x = x + 208
	end
	local function chip(name, color)
		local label = makeText(top, name, "", "Display", 24, color, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 44),
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(26, 34, 78),
			LayoutOrder = 1,
		})
		round(label)
		stroke(label, NAVY, 3, 0)
		pad(label, 16, 0, 16, 2)
		return label
	end
	local chips = makeFrame(top, "Chips", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 5),
		Size = UDim2.new(0, 360, 0, 44),
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = chips,
	})
	U.Chips = chips
	U.TokenChip = chip("Tokens", TOKEN_INFO.Color or GOLD)
	U.TokenChip.Parent = chips
	U.TokenChip.LayoutOrder = 1
	U.GemChip = chip("Gems", GEM_INFO.Color or Colors.Gem)
	U.GemChip.Parent = chips
	U.GemChip.LayoutOrder = 2
end

