BattleCatalog.BossOrder = { "storm_titan", "lava_golem", "frost_wyrm", "shadow_hydra" }

-- The fight tiers (spec 2026-11-01): one boss, four strengths. A team fights the tier of its highest pet (a dare picks a
-- higher one). Hit (share of the boss's damage), Reward, EventScale (the chances of Gems and event pets), Level and
-- BossLevel are the owner's numbers; HpSeconds (seconds of every team's expected DPS, x the boss's HpFactor and HpTier), Scale and
-- Baseline (the HP floor's fighter) are tuned with tools/sim_battle.lua's raids section. GroupMin: Max only, DamageGroup.Min 1.6 left
-- no fight to tune there (3 teams fell in 95-100 s, 8 teams in 82-88 s against the 100 s band). SoloHit: a lone team's share of the
-- boss's hits, apart from the group line (the line's 1.6 left solos 0 of 48 even with a 97% dodge trainer; "solo barely possible" is the
-- owner's). Measured on 96 seeds a cell: 1.25-1.45 at Starter 16% - 2%, 1.1-1.25 at Mid 5% - 1% (frost_wyrm 17% at 1.14, over the 15% ceiling), at High 8.5% - 1%, at Max 3% - 0.5%.
-- (feel-balance 2026-11-10) Mid HpSeconds 98 -> 95: the real cast costs the trained S7 8-team raid (tier Mid) ~6% of its
-- time (storm_titan 230.9 s cast off -> 245.4 s cast on, 24 seeds; over the 240 s cap); at 95 it reads 237.3 s (24 seeds)
-- (feel-balance review 2026-11-11) SoloHit Starter 1.45 -> 1.33, Mid 1.17 -> 1.05, High 1.14 -> 0.96 (Max 1.08 kept): with
-- MinionDamage 0.06 (it bites a lone team too) solos read 1.2% at 48 seeds (Starter 0.5%, Mid 0.5%, High 0%; 163a2f4: 4.8%);
-- these read 4.0% at 96 seeds a cell (worst frost_wyrm Mid 10%, storm_titan Max 7%; the official 12 seeds 8 of 192 = 4.2%).
-- Max stays: at 1.02 storm_titan Max solo already read 19% (48 seeds)
BattleCatalog.RaidTiers = {
	{ Id = "Starter", Level = { 1, 19 }, BossLevel = 15, Hit = 0.6, Reward = 0.4, EventScale = 0.5, Scale = 0.85, HpSeconds = 120, SoloHit = 1.33, Baseline = { PetId = "ember_phoenix", Level = 15, Evo = 0, Tier = "Normal" } },
	{ Id = "Mid", Level = { 20, 49 }, BossLevel = 40, Hit = 0.8, Reward = 0.7, EventScale = 0.5, Scale = 1, HpSeconds = 95, SoloHit = 1.05, Baseline = { PetId = "ember_phoenix", Level = 40, Evo = 1, Tier = "Normal" } },
	{ Id = "High", Level = { 50, 79 }, BossLevel = 70, Hit = 1, Reward = 1, EventScale = 1, Scale = 1.15, HpSeconds = 112, SoloHit = 0.96, Baseline = { PetId = "ember_phoenix", Level = 70, Evo = 2, Tier = "Normal" } },
	{ Id = "Max", Level = { 80, 100 }, BossLevel = 95, Hit = 1.3, Reward = 1.3, EventScale = 1, Scale = 1.3, HpSeconds = 127, GroupMin = 1.35, SoloHit = 1.08, Crown = true, Baseline = { PetId = "ember_phoenix", Level = 95, Evo = 2, Tier = "Rainbow" } },
}
BattleCatalog.RaidTierOrder = { "Starter", "Mid", "High", "Max" }

function BattleCatalog.RaidTierById(id)
	for _, tier in ipairs(BattleCatalog.RaidTiers) do
		if tier.Id == id then
			return tier
		end
	end
	return nil
end

function BattleCatalog.RaidTierIndex(id)
	for i, tier in ipairs(BattleCatalog.RaidTiers) do
		if tier.Id == id then
			return i
		end
	end
	return nil
end

function BattleCatalog.RaidTierOf(level)
	local tiers = BattleCatalog.RaidTiers
	local n = tonumber(level)
	if not n or n ~= n then
		return tiers[1]
	end
	for _, tier in ipairs(tiers) do
		if n <= tier.Level[2] then
			return tier
		end
	end
	return tiers[#tiers]
end

function BattleCatalog.RaidTierOfTeam(pets)
	local highest = nil
	for _, p in ipairs(type(pets) == "table" and pets or {}) do
		local level = type(p) == "table" and tonumber(p.Level) or nil
		if level and level == level and (not highest or level > highest) then
			highest = level
		end
	end
	return BattleCatalog.RaidTierOf(highest), highest or 1
end

function BattleCatalog.RaidCanDare(fromId, toId)
	local from, to = BattleCatalog.RaidTierIndex(fromId), BattleCatalog.RaidTierIndex(toId)
	return from ~= nil and to ~= nil and to > from
end

-- a known tier by id, anything else is the High tier (no tier: raids outside the fight service, x1)
local function raidTierOrHigh(tierId)
	return BattleCatalog.RaidTierById(tierId) or BattleCatalog.RaidTierById("High")
end

function BattleCatalog.NextBoss(index)
	local order = BattleCatalog.BossOrder
	local i = tonumber(index) or 1
	i = floor(i)
	local n = #order
	i = ((i - 1) % n) + 1
	if i < 1 then
		i = i + n
	end
	return order[i]
end

-- The weighted head count of a list of team DPS values: every team counts min(1, dps / the strongest dps)
function BattleCatalog.WeightedTeams(dpsList)
	local top = 0
	for _, dps in ipairs(type(dpsList) == "table" and dpsList or {}) do
		if finite(dps) and dps > top then
			top = dps
		end
	end
	local n = 0
	for _, dps in ipairs(type(dpsList) == "table" and dpsList or {}) do
		if top > 0 and finite(dps) and dps > 0 then
			n = n + min(1, dps / top)
		end
	end
	return n
end

-- The DPS a boss's HP floor is measured against (#2): the boss's own BaselineDps, else the ExpectedDps of the
-- tier's Baseline fighter (so it follows the stat formulas)
function BattleCatalog.BaselineDps(bossId, tierId)
	local boss = BattleCatalog.Bosses[bossId]
	if boss and finite(boss.BaselineDps) and boss.BaselineDps > 0 then
		return boss.BaselineDps
	end
	local ref = raidTierOrHigh(tierId).Baseline
	if type(ref) ~= "table" then
		return 0
	end
	local ok, dps = pcall(BattleCatalog.ExpectedDps, { Pets = { { PetId = ref.PetId, Key = ref.PetId, Level = ref.Level, Tier = ref.Tier, Evo = ref.Evo } } })
	return (ok and finite(dps) and dps > 0) and dps or 0
end

-- Boss HP for a list of team specs (each { Pets = {...} }): the tier's HpSeconds x the boss's HpFactor seconds of every
-- team's expected DPS, each team's share weighted like the head count, x GroupFactor; never below FloorSeconds of the tier's BaselineDps (#2: the
-- floor is for the whole raid, so a weak group still adds up past it while a weak solo cannot), nor MinHp.
-- Returns the total and the shares (scaled up with the floor, so they still add up to the total before GroupFactor).
function BattleCatalog.BossHp(bossId, teams, tierId)
	local boss = BattleCatalog.Bosses[bossId]
	local tier = raidTierOrHigh(tierId)
	local seconds = tier.HpSeconds * num(boss and boss.HpFactor, 1) * num(boss and boss.HpTier and boss.HpTier[tier.Id], 1)
	local dpsList = {}
	local top = 0
	for i, team in ipairs(type(teams) == "table" and teams or {}) do
		dpsList[i] = BattleCatalog.ExpectedDps(team)
		top = max(top, dpsList[i])
	end
	local total = 0
	local shares = {}
	for i, dps in ipairs(dpsList) do
		local weight = (top > 0) and min(1, dps / top) or 0
		shares[i] = dps * seconds * weight
		total = total + shares[i]
	end
	total = total * BattleCatalog.GroupFactor(BattleCatalog.WeightedTeams(dpsList))
	local floorHp = num(BattleCatalog.BossRules.FloorSeconds, seconds) * BattleCatalog.BaselineDps(bossId, tierId)
	if total > 0 and total < floorHp then
		local scale = floorHp / total
		for i = 1, #shares do
			shares[i] = shares[i] * scale
		end
		total = floorHp
	elseif total <= 0 then
		total = floorHp
	end
	local minHp = BattleCatalog.BossRules.MinHp
	if total < minHp then
		total = minHp
	end
	return floor(total + 0.5), shares
end

function BattleCatalog.GroupFactor(teams)
	local n = max(1, num(teams, 1))
	local R = BattleCatalog.BossRules
	return n ^ (R.GroupExponent or 0) * (1 + num(R.GroupBonus, 0) * (1 - 1 / n))
end

----------------------------------------------------------------------
-- Event schedule + raid rewards + trophies (Phase 3, kept)
----------------------------------------------------------------------
BattleCatalog.Events = {
	Schedule = {
		{ Kind = "BossRaid", EveryMinutes = 20 }, -- the boss rotation (spec 2026-11-01: no window, no announcement)
		{ Kind = "DoubleRewards", EveryMinutes = 180, AnnounceSeconds = 120, DurationSeconds = 3600 },
	},
	FirstAfterSeconds = 300,
	DoubleRewardsMultiplier = 2,
}

BattleCatalog.Raid = {
	Tiers = {
		{ Id = "Gold", MinShare = 0.25, Tokens = 500, Xp = 400, Gems = 10, GemChance = 0.25, EventPetChance = 0.05 },
		{ Id = "Silver", MinShare = 0.10, Tokens = 300, Xp = 250, Gems = 5, GemChance = 0.15, EventPetChance = 0.03 },
		{ Id = "Bronze", MinShare = 0.02, Tokens = 150, Xp = 120, Gems = 3, GemChance = 0.08, EventPetChance = 0.015 },
		{ Id = "Helper", MinShare = 0, Tokens = 60, Xp = 50, Gems = 0, GemChance = 0, EventPetChance = 0.005 },
	},
	MinShare = 0,
	LossTokens = 25,
	LossXp = 20,
	ReturnSeconds = 60, -- a tier's fight is closed this long after a kill
	RewardMinutes = 20, -- a win pays once per this, per player (saved)
	LossMinutes = 5, -- the loss reward pays once per this, per player (saved)
	MaxRaiders = 8, -- per fight
}

-- A medal scaled to the fight tier: a copy, the Raid.Tiers table stays as it is. tierId nil = High (x1).
local function scaledMedal(medal, tierId)
	local tier = raidTierOrHigh(tierId)
	local reward, chance = tier.Reward, tier.EventScale
	return {
		Id = medal.Id,
		MinShare = medal.MinShare,
		Tokens = floor(medal.Tokens * reward + 0.5),
		Xp = floor(medal.Xp * reward + 0.5),
		Gems = floor(medal.Gems * reward + 0.5),
		GemChance = medal.GemChance * chance,
		EventPetChance = medal.EventPetChance * chance,
		Scale = reward,
		FightTier = tier.Id,
	}
end

function BattleCatalog.RaidTier(share, won, tierId)
	local s = tonumber(share) or 0
	if s ~= s or s <= 0 or s < BattleCatalog.Raid.MinShare then
		return nil
	end
	if won == false then
		return scaledMedal({ Id = "Loss", MinShare = BattleCatalog.Raid.MinShare, Tokens = BattleCatalog.Raid.LossTokens, Xp = BattleCatalog.Raid.LossXp, Gems = 0, GemChance = 0, EventPetChance = 0 }, tierId)
	end
	local tiers = BattleCatalog.Raid.Tiers
	for _, tier in ipairs(tiers) do
		if s >= tier.MinShare then
			return scaledMedal(tier, tierId)
		end
	end
	return scaledMedal(tiers[#tiers], tierId)
end

function BattleCatalog.EventPets()
	local out = {}
	local pc = petCatalog()
	if pc and type(pc.Pets) == "table" then
		for _, def in ipairs(pc.Pets) do
			if def.EventOnly == true then
				table.insert(out, def.Id)
			end
		end
	end
	return out
end

BattleCatalog.Trophies = {
	Win = 20,
	Loss = -10,
	Draw = 0,
	Forfeit = -10,
	Floor = 0,
	Tokens = { Win = 40, Loss = 10, Draw = 15 },
	Xp = { Win = 60, Loss = 25 },
}

----------------------------------------------------------------------
-- The Dungeon (5.1): 12 floors x 3 wave rooms + a boss room; the enemy of every wave is solved like a champion
-- (the same solver) to the floor's target per player. Floor 1 is the tutorial floor: ONE handicapped enemy per wave.
----------------------------------------------------------------------
BattleCatalog.Dungeon = {
	Floors = 12,
	Floor1Power = 17, -- floor 1's target per player (3 L1 Commons win room 1 and about half of room 2; 3 L6-7 Commons clear it)
	FirstPower = 29, -- floor f >= 2 targets FirstPower x Growth ^ (f - 1) TeamPower per player (floor 2 = 58, floor 10 = 14848, floor 12 = 59392)
	Growth = 2.0,
	RoomMult = { 1.0, 1.1, 1.25 }, -- wave rooms 1-3 (re-tuned by sim_battle for the fighter engine: S1 clears floor 2, S10 floor 11)
	BossMult = 1.3, -- the boss (room 4, wave 1)
	EscortMult = 0.5, -- the boss's escort (room 4, wave 2, at EscortAt of its HP)
	Waves = { 2, 2, 3 },
	Floor1Waves = { 1, 2, 3 },
	EnemiesPerWave = 2, -- + 1 per extra player
	Floor1EnemiesPerWave = 1,
	EasedRoomMult = 0.35, -- DungeonWave's opts.Eased: the tutorial's first room (spec 2026-10-31 s.7), any single level-1 pet wins it
	PartyExp = 0.5, -- the party's target = per player x partySize ^ PartyExp (0.85 in the design assumed 3-4 pets per player on the floor; with ONE fighter per player sim_battle measures +1 floor for a party of 4 at 0.5)
	MinHandicap = 0.3,
	EnemyMaxLevel = 50,
	RoomTime = 120,
	Floor1RoomTime = 180,
	Zones = { Room = { X = 44, Z = 44 }, Boss = { X = 56, Z = 72 } }, -- Boss = the whole 60 x 72 Throne floor (W5: the dais was outside the 56 x 56 zone)
	EscortAt = 0.5,
	Intermission = 2,
	DoorTime = 12,
	HallSeconds = 10,
	TreasureSeconds = 45,
	MinShare = 0.05,
	LateJoinLastRoom = 2,
	ReadyTimeout = 30,
	RunMaxSeconds = 4 * 120 + 4 * 12 + 10 + 45 + 120,
	Bands = {
		{ 1, 2, { "Common" } },
		{ 3, 4, { "Common", "Uncommon" } },
		{ 5, 6, { "Uncommon", "Rare" } },
		{ 7, 8, { "Rare", "Epic" } },
		{ 9, 10, { "Epic", "Legendary" } },
		{ 11, 12, { "Legendary", "Mythic", "Secret" } },
	},
	-- loot (5.2)
	RoomSeconds = { 3, 4, 5, 12 }, -- Cash = max(CashBase + CashPerFloor x floor, income x RoomSeconds[room])
	CashBase = 20,
	CashPerFloor = 10,
	TokenBase = 6, -- wave rooms floor((TokenBase + TokenPerFloor x f) x waves / 2); the boss room (TokenBase + TokenPerFloor x f) x 2
	TokenPerFloor = 4,
	XpBase = 25, -- XP per team pet = (XpBase + XpPerFloor x f) x waves (the boss room counts BossRoomWaves)
	XpPerFloor = 10,
	BossRoomWaves = 4,
	FirstClearTokens = 300, -- x floor
	FirstClearGems = { 3, 4, 5, 6, 8, 10, 12, 15, 18, 20, 25, 30 },
	-- the boss chest: floors 1-2 Cash 70% / Tokens 30% (never Gems); floor >= 3 Cash 60% / Tokens 30% / Gems 2 8% / Gems 5 2%
	ChestLowFloors = 2,
	ChestCashSeconds = 30, -- Cash = this many seconds of income (at least ChestCashMin)
	ChestCashMin = 50,
	ChestTokens = { Base = 20, PerFloor = 10 },
}

BattleCatalog.DungeonFloors = {
	{ Name = "Mossy Cellar", Element = "Nature", Kind = "Cellar" },
	{ Name = "Stone Halls", Element = "Earth", Kind = "Hall" },
	{ Name = "Flooded Vaults", Element = "Water", Kind = "Cave" },
	{ Name = "Frozen Crypt", Element = "Frost", Kind = "Cellar" },
	{ Name = "Ember Forge", Element = "Flame", Kind = "Hall" },
	{ Name = "Thunder Spire", Element = "Storm", Kind = "Bridge" },
	{ Name = "Star Chapel", Element = "Celestial", Kind = "Hall" },
	{ Name = "Shadow Keep", Element = "Shadow", Kind = "Cave" },
	{ Name = "Magma Mines", Element = "Earth", Kind = "Cave" },
	{ Name = "Howling Peak", Element = "Frost", Kind = "Bridge" },
	{ Name = "Eclipse Sanctum", Element = "Celestial", Kind = "Hall" },
	{ Name = "Abyss Throne", Element = "Shadow", Kind = "Throne" },
}
for i, f in ipairs(BattleCatalog.DungeonFloors) do
	f.Floor = i
end

local D5 = {}

function D5.floor(f)
	f = tonumber(f)
	if not finite(f) or f < 1 then
		return 1
	end
	return min(floor(f), num(BattleCatalog.Dungeon.Floors, 12))
end

function D5.party(n)
	n = tonumber(n)
	if not finite(n) or n < 1 then
		return 1
	end
	return min(floor(n), 16)
end

function D5.rarities(f)
	for _, b in ipairs(BattleCatalog.Dungeon.Bands) do
		if f >= b[1] and f <= b[2] then
			return b[3]
		end
	end
	local last = BattleCatalog.Dungeon.Bands[#BattleCatalog.Dungeon.Bands]
	return last and last[3] or { "Common" }
end

-- element -> rarity -> { petId... } (never EventOnly), cached once the catalog is there
function D5.pools()
	if D5.poolCache then
		return D5.poolCache
	end
	local byElement = {}
	local pc = petCatalog()
	if pc and type(pc.Pets) == "table" then
		for _, def in ipairs(pc.Pets) do
			if def.EventOnly ~= true and type(def.Id) == "string" and type(def.Rarity) == "string" then
				local elems = pc.ElementsOf and pc.ElementsOf(def) or { def.Element }
				for _, e in ipairs(elems) do
					byElement[e] = byElement[e] or {}
					byElement[e][def.Rarity] = byElement[e][def.Rarity] or {}
					table.insert(byElement[e][def.Rarity], def.Id)
				end
			end
		end
		D5.poolCache = byElement
	end
	return byElement
end

-- the candidates of a floor: the floor's element in the band (< 2 candidates -> any element in the band)
function D5.candidates(f)
	local info = BattleCatalog.DungeonFloors[f]
	local element = info and info.Element
	local rarities = D5.rarities(f)
	local pools = D5.pools()
	local list = {}
	local seen = {}
	local function add(id)
		if not seen[id] then
			seen[id] = true
			list[#list + 1] = id
		end
	end
	if element and pools[element] then
		for _, r in ipairs(rarities) do
			for _, id in ipairs(pools[element][r] or {}) do
				add(id)
			end
		end
	end
	if #list < 2 then
		for _, r in ipairs(rarities) do
			for _, list2 in pairs(P4.pools()) do
				for _, id in ipairs(list2) do
					local def = petCatalog() and petCatalog().Get(id)
					if def and def.Rarity == r then
						add(id)
					end
				end
			end
		end
	end
	table.sort(list)
	return list
end

-- the party's target power of a floor (per player x partySize ^ PartyExp)
function BattleCatalog.DungeonPower(floorIndex, partySize)
	local D = BattleCatalog.Dungeon
	local f = D5.floor(floorIndex)
	local n = D5.party(partySize)
	local per
	if f == 1 then
		per = num(D.Floor1Power, 1.5)
	else
		per = num(D.FirstPower, 4) * num(D.Growth, 2) ^ (f - 1)
	end
	return per * n ^ num(D.PartyExp, 0.85)
end

-- One wave's enemies: { Pets = { entry... }, Boss, Power, Target, Floor, Room, Wave, Count }; deterministic for its
-- arguments. Room 4 wave 1 = the boss alone (forced mini-boss form, handicapped on floors 1-2), wave 2 = the escort at
-- EscortMult; floor 1 = ONE enemy per wave. Rooms 1-3: EnemiesPerWave (+1 per extra player) at RoomMult.
-- opts = { Eased = true } aims the wave at EasedRoomMult x its goal (same species and count); nil = the plain wave.
function BattleCatalog.DungeonWave(floorIndex, room, wave, partySize, seed, opts)
	local D = BattleCatalog.Dungeon
	local f = D5.floor(floorIndex)
	local n = D5.party(partySize)
	local r = max(1, min(4, floor(num(tonumber(room), 1))))
	local w = max(1, floor(num(tonumber(wave), 1)))
	local s = P4.seed(seed)
	local total = BattleCatalog.DungeonPower(f, n)
	local count, goalEach, forceBoss
	local isBoss = false
	if r == 4 then
		if w == 1 then
			count = 1
			goalEach = total * num(D.BossMult, 1.3)
			forceBoss = true
			isBoss = true
		else
			count = (f == 1) and 1 or (num(D.EnemiesPerWave, 2) + (n - 1))
			goalEach = total * num(D.EscortMult, 0.5) / count
		end
	else
		count = (f == 1) and num(D.Floor1EnemiesPerWave, 1) or (num(D.EnemiesPerWave, 2) + (n - 1))
		local mult = D.RoomMult[r] or 1
		goalEach = total * mult / count
	end
	count = max(1, min(12, floor(count)))
	if type(opts) == "table" and opts.Eased == true then
		goalEach = goalEach * num(D.EasedRoomMult, 1)
	end
	local candidates = D5.candidates(f)
	local nextInt = P4.stream((s * 131 + f * 10007 + r * 1009 + w * 101) % P4.RING_M)
	local pets = {}
	local power = 0
	local topLevel = max(1, floor(num(D.EnemyMaxLevel, 50)))
	local minH = num(D.MinHandicap, 0.3)
	for i = 1, count do
		local petId = (#candidates > 0) and candidates[nextInt(#candidates)] or "pebble_pup"
		local e, p = P4.solveEntry(petId, goalEach, topLevel, minH, forceBoss)
		pets[i] = {
			PetId = e.PetId,
			Key = e.PetId,
			Level = e.Level,
			Tier = e.Tier,
			Slot = i,
			Boss = e.Boss,
			Boost = e.Boost,
			Handicap = e.Handicap,
			Wild = true,
		}
		power = power + p
	end
	return { Pets = pets, Boss = isBoss, Power = floor(power + 0.5), Target = total, Floor = f, Room = r, Wave = w, Count = count, Name = (isBoss and "Boss" or ("Wave " .. w)) }
end

-- Loot of one room (5.2): Cash = max(20 + 10f, income x RoomSeconds[room]); Tokens wave rooms floor((6 + 4f) x waves / 2),
-- boss room (6 + 4f) x 2, x2 under Double Rewards (Cash / XP not); Xp per team pet (25 + 10f) x waves (boss room 4)
function BattleCatalog.DungeonRewards(floorIndex, room, waves, incomePerSecond, double)
	local D = BattleCatalog.Dungeon
	local f = D5.floor(floorIndex)
	local r = max(1, min(4, floor(num(tonumber(room), 1))))
	local wv = max(1, floor(num(tonumber(waves), 1)))
	local ips = tonumber(incomePerSecond)
	if not finite(ips) or ips < 0 then
		ips = 0
	end
	local mult = double and (BattleCatalog.Events.DoubleRewardsMultiplier or 2) or 1
	local seconds = D.RoomSeconds[r] or 5
	local cash = max(num(D.CashBase, 20) + num(D.CashPerFloor, 10) * f, floor(ips * seconds))
	local tokenBase = num(D.TokenBase, 6) + num(D.TokenPerFloor, 4) * f
	local tokens
	if r == 4 then
		tokens = tokenBase * 2
		wv = num(D.BossRoomWaves, 4)
	else
		tokens = floor(tokenBase * wv / 2)
	end
	return {
		Cash = floor(cash),
		Tokens = floor(tokens * mult + 0.5),
		Xp = (num(D.XpBase, 25) + num(D.XpPerFloor, 10) * f) * wv,
		Seconds = seconds,
	}
end

function BattleCatalog.DungeonFirstClear(floorIndex)
	local D = BattleCatalog.Dungeon
	local f = D5.floor(floorIndex)
	return { Tokens = num(D.FirstClearTokens, 300) * f, Gems = D.FirstClearGems[f] or 0 }
end

-- the boss chest of a run, rolled from (floor, seed): { Kind = "Cash"|"Tokens"|"Gems", Amount | Seconds }. Cash is
-- paid as Seconds of the opener's own income (DungeonService multiplies; Amount = the ChestCashMin floor).
function BattleCatalog.DungeonChest(floorIndex, seed)
	local D = BattleCatalog.Dungeon
	local f = D5.floor(floorIndex)
	local s = P4.seed(seed)
	local nextInt = P4.stream((s * 977 + f * 7) % P4.RING_M)
	local roll = nextInt(100)
	local tokens = num(D.ChestTokens.Base, 20) + num(D.ChestTokens.PerFloor, 10) * f
	if f <= num(D.ChestLowFloors, 2) then
		if roll <= 70 then
			return { Kind = "Cash", Amount = num(D.ChestCashMin, 50), Seconds = num(D.ChestCashSeconds, 30) }
		end
		return { Kind = "Tokens", Amount = tokens }
	end
	if roll <= 60 then
		return { Kind = "Cash", Amount = num(D.ChestCashMin, 50), Seconds = num(D.ChestCashSeconds, 30) }
	elseif roll <= 90 then
		return { Kind = "Tokens", Amount = tokens }
	elseif roll <= 98 then
		return { Kind = "Gems", Amount = 2 }
	end
	return { Kind = "Gems", Amount = 5 }
end

----------------------------------------------------------------------
-- Self-check
----------------------------------------------------------------------
function BattleCatalog.Validate()
	local problems = {}
	local function bad(msg)
		table.insert(problems, msg)
	end
	local pc = petCatalog()
	local validElements = {}
	for _, e in ipairs(elementOrder()) do
		validElements[e] = true
	end
	-- profiles for every species
	if pc and type(pc.Species) == "table" then
		for _, species in ipairs(pc.Species) do
			if not BattleCatalog.Profiles[species] then
				bad("no combat profile for species " .. tostring(species))
			end
		end
	end
	for species, profile in pairs(BattleCatalog.Profiles) do
		if profile.Attack ~= "Melee" and profile.Attack ~= "Ranged" then
			bad(species .. ": Attack must be Melee or Ranged")
		end
		for _, key in ipairs({ "Range", "MoveSpeed", "Interval", "HitRadius", "DamageMult" }) do
			if not finite(profile[key]) or profile[key] <= 0 then
				bad(species .. ": " .. key .. " must be a positive number")
			end
		end
	end
	-- what a boss's HP counts for the forms: x1 unevolved, never falling with the stage
	if BattleCatalog.FormDps[0] ~= 1 or not finite(BattleCatalog.FormDps[1]) or not finite(BattleCatalog.FormDps[2]) or BattleCatalog.FormDps[1] < 1 or BattleCatalog.FormDps[2] < BattleCatalog.FormDps[1] then
		bad("FormDps: [0] = 1, never falling with the stage")
	end
	-- reach: x1 unevolved, never falling with the stage
	if BattleCatalog.Reach[0] ~= 1 then
		bad("Reach[0] must be 1")
	end
	for stage = 1, 2 do
		if not finite(BattleCatalog.Reach[stage]) or BattleCatalog.Reach[stage] < BattleCatalog.Reach[stage - 1] then
			bad("Reach must not fall with the stage (stage " .. stage .. ")")
		end
	end
	-- evolved forms: both stages of every kind, one name per evolution of every catalog pet
	if not finite(BattleCatalog.Forms.BossBonus) or BattleCatalog.Forms.BossBonus < 0 or BattleCatalog.Forms.BossBonus > 0.5 then
		bad("Forms.BossBonus must be in 0..0.5")
	end
	for _, kind in ipairs(BattleCatalog.SpecialKinds) do
		local forms = BattleCatalog.Forms[kind]
		for stage = 1, 2 do
			if type(forms) ~= "table" or type(forms[stage]) ~= "table" or type(forms[stage].Id) ~= "string" then
				bad("Forms." .. kind .. " has no form at stage " .. stage)
			end
		end
	end
	if pc and pc.Get and type(pc.Pets) == "table" then
		for petId, names in pairs(BattleCatalog.FormNames) do
			local def = pc.Get(petId)
			if not def then
				bad("FormNames: no catalog pet " .. tostring(petId))
			elseif #names ~= (pc.EvolveTwice[def.Rarity] and 2 or 1) then
				bad("FormNames." .. tostring(petId) .. " must name each evolution of a " .. tostring(def.Rarity))
			end
		end
		for _, def in ipairs(pc.Pets) do
			if not BattleCatalog.FormNames[def.Id] then
				bad("FormNames: no names for " .. tostring(def.Id))
			end
		end
	end
	-- specials for every kind (the catalog's list and ours)
	local kinds = (pc and pc.SpecialKinds) or BattleCatalog.SpecialKinds
	for _, list in ipairs({ kinds, BattleCatalog.SpecialKinds }) do
		for _, kind in ipairs(list) do
			local s = BattleCatalog.Specials[kind]
			if type(s) ~= "table" then
				bad("no special effect for kind " .. tostring(kind))
			elseif type(s.Name) ~= "string" or type(s.Text) ~= "string" or not finite(s.Scale) then
				bad("special " .. kind .. " needs Name, Text and Scale")
			end
		end
	end
	for _, kind in ipairs(BattleCatalog.SupportKinds) do
		if not BattleCatalog.Buffs[kind] or BattleCatalog.Specials[kind] == nil then
			bad("Support kind " .. kind .. " needs a Buff and a Special")
		end
	end
	-- roles, the fighter kit
	local R = BattleCatalog.Roles
	if not (R.Combat and R.Support and R.Support.Power > 1 and R.Support.Health > 1 and R.Combat.Power == 1 and R.Combat.Health == 1) then
		bad("Roles: Combat 1 / 1, Support above 1")
	end
	-- (battle-feel T2) the melee standoff: a number of studs 0..20
	local so = BattleCatalog.Damage.Standoff
	if not finite(so) or so < 0 or so > 20 then
		bad("Damage.Standoff must be a number 0..20 studs")
	end
	-- (feel-balance review) a mode's pace: nil, or a table of mode -> 0.5..2
	local md = BattleCatalog.Damage.ModeDamage
	if md ~= nil then
		if type(md) ~= "table" then
			bad("Damage.ModeDamage must be nil or a table of mode -> 0.5..2")
		else
			for mode, v in pairs(md) do
				if not finite(v) or v < 0.5 or v > 2 then
					bad("Damage.ModeDamage." .. tostring(mode) .. " must be a number 0.5..2")
				end
			end
		end
	end
	-- (feel-balance) the strike window: In / Bite / Hold / Back 0..2 s, FlurryBelow 0..3 s, Out 0.25..1, and a window of at
	-- least 0.3 s (three 10 Hz ticks: a shorter one could fall between two steps)
	local st = BattleCatalog.Damage.Strike
	if type(st) ~= "table" then
		bad("Damage.Strike must be a table")
	else
		local okStrike = true
		for _, key in ipairs({ "In", "Bite", "Hold", "Back" }) do
			if not finite(st[key]) or st[key] < 0 or st[key] > 2 then
				bad("Damage.Strike." .. key .. " must be a number 0..2 s")
				okStrike = false
			end
		end
		if not finite(st.FlurryBelow) or st.FlurryBelow < 0 or st.FlurryBelow > 3 then
			bad("Damage.Strike.FlurryBelow must be a number 0..3 s")
			okStrike = false
		end
		if not finite(st.Out) or st.Out < 0.25 or st.Out > 1 then
			bad("Damage.Strike.Out must be a number 0.25..1")
			okStrike = false
		end
		if okStrike and st.In * st.Out + st.Bite + st.Hold + st.Back * st.Out < 0.3 then
			bad("Damage.Strike: In x Out + Bite + Hold + Back x Out must be at least 0.3 s (the 10 Hz tick)")
		end
	end
	if type(BattleCatalog.Damage.SpecialCarry) ~= "boolean" then
		bad("Damage.SpecialCarry must be true or false")
	end
	-- (battle-feel T3) the real cast seconds: nil (off), else a number 0.3..2 for every special kind
	local sc = BattleCatalog.Damage.SpecialCast
	if sc ~= nil then
		if type(sc) ~= "table" then
			bad("Damage.SpecialCast must be nil or a table of seconds per kind")
		else
			for _, kind in ipairs(BattleCatalog.SpecialKinds) do
				local v = sc[kind]
				if not finite(v) or v < 0.3 or v > 2 then
					bad("Damage.SpecialCast." .. kind .. " must be a number 0.3..2 seconds")
				end
			end
		end
	end
	local F = BattleCatalog.Fighter
	for _, key in ipairs({ "AttackSlack", "AttackTolerance", "ElementCooldown", "ElementMult", "ElementRange", "SpecialMeterMax", "MeterPerSecond", "MeterOnHit", "MeterOnHurt", "DashSeconds", "DashCooldown", "DashIFrames", "SwapCooldown", "SwapCastSeconds", "HelperCooldown", "SupportCooldown", "Windup", "KitFactor", "HelperWeight", "Lives", "WalkMult", "WalkMin", "WalkMax", "RunMult", "MoveSlack", "Leash", "LeashSeconds" }) do
		if not finite(F[key]) or F[key] <= 0 then
			bad("Fighter." .. key .. " must be a positive number")
		end
	end
	if not finite(F.ArriveSeconds) or F.ArriveSeconds < 0 or F.ArriveSeconds > 3 then
		bad("Fighter.ArriveSeconds must be 0..3 s")
	end
	if (F.BenchRegenPerSecond or 0) ~= 0 then
		bad("Fighter.BenchRegenPerSecond must be 0 (no passive heal in combat)")
	end
	if F.Windup <= F.DashIFrames * 0.8 then
		bad("Fighter.Windup must leave the dash i-frames room to dodge")
	end
	-- wave 6: the parry (a timed Dash)
	if not finite(F.ParryWindow) or F.ParryWindow <= 0 or F.ParryWindow > F.DashIFrames then
		bad("Fighter.ParryWindow must be above 0 and <= DashIFrames")
	end
	if not finite(F.ParryStagger) or F.ParryStagger < 0 or F.ParryStagger > 1 then
		bad("Fighter.ParryStagger must be 0..1 s")
	end
	if not finite(F.ParryMeter) or F.ParryMeter < 0 or F.ParryMeter > 30 then
		bad("Fighter.ParryMeter must be 0..30")
	end
	if not finite(F.ParryBossGap) or not finite(F.ParryStagger) or F.ParryBossGap < F.ParryStagger then
		bad("Fighter.ParryBossGap must be >= ParryStagger")
	end
	-- wave 6: Cheer up! is a really small boost with a cooldown (never a must-spam meta)
	if not finite(F.CheerBoost) or F.CheerBoost <= 0 or F.CheerBoost > 0.1 then
		bad("Fighter.CheerBoost must be above 0 and <= 0.1")
	end
	if not finite(F.CheerSeconds) or not finite(F.CheerCooldown) or F.CheerSeconds <= 0 or F.CheerSeconds >= F.CheerCooldown then
		bad("Fighter.CheerSeconds must be above 0 and below CheerCooldown")
	end
	-- evolved forms: Retreat
	if not finite(F.RetreatWait) or F.RetreatWait <= 0 then
		bad("Fighter.RetreatWait must be above 0")
	end
	if not finite(F.RetreatDodge) or F.RetreatDodge <= 0 then
		bad("Fighter.RetreatDodge must be above 0")
	end
	-- wave 6: the stand-still engage rule is gone; a stray Engage* number means a half-reverted catalog
	for _, key in ipairs({ "EngageRange", "EngageLeash", "EngagePull", "EngageStillSeconds", "EngageCooldown" }) do
		if F[key] ~= nil then
			bad("Fighter." .. key .. " was removed in wave 6 (the pet fights anything in the fight area)")
		end
	end
	if F.WalkMin > F.WalkMax or F.RunMult < 1 or F.MoveSlack < 1 or F.Lives ~= 3 then
		bad("Fighter: WalkMin <= WalkMax, RunMult >= 1, MoveSlack >= 1, Lives 3")
	end
	if abs(F.WalkOf(10) - 12) > 1e-9 or abs(F.WalkOf(17.4) - 20) > 1e-9 or abs(F.RunOf(12) - 15.6) > 1e-9 then
		bad("Fighter.WalkOf / RunOf: clamp(MoveSpeed x 1.15, 12, 20) and x1.3")
	end
	-- element attacks / buffs: one per element
	for _, e in ipairs(elementOrder()) do
		local a = BattleCatalog.ElementAttacks[e]
		if type(a) ~= "table" or type(a.Name) ~= "string" then
			bad("no element attack for " .. e)
		elseif a.Shape == "Cone" and (not finite(a.Angle) or not finite(a.Length)) then
			bad("element attack " .. e .. ": a Cone needs Angle and Length")
		elseif a.Shape == "Circle" and not finite(a.Radius) then
			bad("element attack " .. e .. ": a Circle needs Radius")
		elseif a.Shape == "Line" and (not finite(a.Length) or not finite(a.Width)) then
			bad("element attack " .. e .. ": a Line needs Length and Width")
		elseif a.Shape ~= "Cone" and a.Shape ~= "Circle" and a.Shape ~= "Line" then
			bad("element attack " .. e .. ": unknown shape " .. tostring(a.Shape))
		end
		for stage = 1, 2 do
			local form = type(a) == "table" and type(a.Forms) == "table" and a.Forms[stage]
			if type(form) ~= "table" or type(form.Id) ~= "string" or type(form.Name) ~= "string" then
				bad("element attack " .. e .. " has no form with Id and Name at stage " .. stage)
			end
		end
		local b = BattleCatalog.Buffs[e]
		if type(b) ~= "table" or type(b.Name) ~= "string" or not finite(b.Value) or not finite(b.Seconds) or b.Cooldown ~= F.HelperCooldown then
			bad("no element buff for " .. e .. " (Name, Value, Seconds, Cooldown = HelperCooldown)")
		end
	end
	for kind, b in pairs(BattleCatalog.Buffs) do
		if b.Kind ~= kind or type(b.Text) ~= "string" or type(b.Effect) ~= "string" then
			bad("Buffs." .. kind .. " needs Kind, Effect and Text")
		end
		if not validElements[kind] and b.Cooldown ~= F.SupportCooldown then
			bad("Buffs." .. kind .. ": a Support buff's Cooldown is SupportCooldown")
		end
	end
	-- every Economy pet has a Support kind with a buff; every pet an element with a buff
	if pc and type(pc.Pets) == "table" then
		for _, def in ipairs(pc.Pets) do
			local kind = BattleCatalog.BuffOf(def)
			if kind == nil then
				bad("pet " .. tostring(def.Id) .. " has no helper buff")
			end
			if def.Role == "Economy" and (type(def.Special) ~= "table" or not BattleCatalog.Buffs[def.Special.Kind] or BattleCatalog.RoleOf(def) ~= "Support") then
				bad("Economy pet " .. tostring(def.Id) .. " is not a Support with a Support kind")
			end
		end
	end
	-- bosses
	for _, id in ipairs(BattleCatalog.BossOrder) do
		local b = BattleCatalog.Bosses[id]
		if not b then
			bad("BossOrder names unknown boss " .. tostring(id))
		else
			if b.Id ~= id then
				bad("boss " .. id .. " has Id " .. tostring(b.Id))
			end
			if not validElements[b.Element] then
				bad("boss " .. id .. ": Element " .. tostring(b.Element) .. " is not in Config.Elements.Order")
			end
			if not finite(b.HpFactor) or b.HpFactor <= 0 then
				bad("boss " .. id .. ": HpFactor must be positive")
			end
			for tierId, share in pairs(type(b.HpTier) == "table" and b.HpTier or {}) do
				if not BattleCatalog.RaidTierById(tierId) or not finite(share) or share <= 0 then
					bad("boss " .. id .. ": HpTier." .. tostring(tierId) .. " must be a known tier with a positive share")
				end
			end
			for _, tier in ipairs(BattleCatalog.RaidTiers) do
				if BattleCatalog.BaselineDps(id, tier.Id) <= 0 then
					bad("boss " .. id .. ": BaselineDps must be positive (tier " .. tostring(tier.Id) .. "'s Baseline names a real pet)")
				end
			end
			if type(b.Attacks) ~= "table" or #b.Attacks < 1 then
				bad("boss " .. id .. ": needs attacks")
			else
				for _, a in ipairs(b.Attacks) do
					if a.Shape ~= "Circle" and a.Shape ~= "Line" then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": unknown shape " .. tostring(a.Shape))
					end
					if a.Shape == "Circle" and not finite(a.Radius) then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Circle needs Radius")
					end
					if a.Shape == "Line" and (not finite(a.Width) or not finite(a.Length)) then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Line needs Width and Length")
					end
					if not finite(a.Telegraph) or a.Telegraph < 1 then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Telegraph must be >= 1 s (players need time to step out)")
					end
					if not finite(a.Damage) or a.Damage <= 0 or a.Damage > 0.6 then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Damage must be a fraction in (0, 0.6] (no one-shots)")
					end
					if not finite(a.Cooldown) or a.Cooldown < a.Telegraph then
						bad("boss " .. id .. " attack " .. tostring(a.Id) .. ": Cooldown must cover the Telegraph")
					end
				end
			end
			if type(b.Basic) ~= "table" or not finite(b.Basic.Damage) or b.Basic.Damage > 0.2 then
				bad("boss " .. id .. ": Basic attack damage must be a small fraction")
			end
			if pc and pc.Get and b.MinionPet and not pc.Get(b.MinionPet) then
				bad("boss " .. id .. ": unknown minion pet " .. tostring(b.MinionPet))
			end
			if not finite(b.TimeLimit) or b.TimeLimit <= 0 then
				bad("boss " .. id .. ": TimeLimit must be positive")
			end
			-- the lethal: a long warning (past any freeze and the dash cooldown), one cast at a time, small enough for the sidestep
			local l = b.Lethal
			if type(l) ~= "table" or l.Lethal ~= true then
				bad("boss " .. id .. ": needs a Lethal attack")
			else
				if not finite(l.Telegraph) or l.Telegraph < 3 then
					bad("boss " .. id .. ": the Lethal's Telegraph must be >= 3 s")
				end
				if l.Count ~= nil and l.Count ~= 1 then
					bad("boss " .. id .. ": the Lethal is one shape (no Count)")
				end
				if l.Damage ~= nil then
					bad("boss " .. id .. ": the Lethal has no Damage (it knocks out)")
				end
				if not finite(l.Cooldown) or l.Cooldown < 18 then
					bad("boss " .. id .. ": the Lethal's Cooldown must be >= 18 s")
				end
				local fits = (l.Shape == "Circle" and finite(l.Radius) and l.Radius <= 10 and l.Target == "Cluster") or (l.Shape == "Line" and finite(l.Width) and l.Width <= 12 and finite(l.Length))
				if not fits then
					bad("boss " .. id .. ": the Lethal must be a Cluster Circle with Radius <= 10 or a Line with Width <= 12")
				end
			end
		end
	end
	local enrageAt = BattleCatalog.BossRules.EnrageAt
	if not finite(enrageAt) or enrageAt <= 0 or enrageAt >= 1 then
		bad("BossRules.EnrageAt must be a share of the boss's health in (0, 1)")
	end
	-- the fight tiers: contiguous levels 1..MaxPetLevel, positive numbers, a real Baseline pet
	local nextLevel = 1
	for _, tier in ipairs(BattleCatalog.RaidTiers) do
		if type(tier.Level) ~= "table" or tier.Level[1] ~= nextLevel or tier.Level[2] < tier.Level[1] then
			bad("raid tier " .. tostring(tier.Id) .. ": Level must start at " .. nextLevel)
		else
			nextLevel = tier.Level[2] + 1
		end
		for _, field in ipairs({ "Hit", "Reward", "EventScale", "Scale", "HpSeconds" }) do
			if not finite(tier[field]) or tier[field] <= 0 then
				bad("raid tier " .. tostring(tier.Id) .. ": " .. field .. " must be positive")
			end
		end
		for _, field in ipairs({ "SoloHit", "GroupMin" }) do
			if tier[field] ~= nil and (not finite(tier[field]) or tier[field] <= 0) then
				bad("raid tier " .. tostring(tier.Id) .. ": " .. field .. " must be positive when set")
			end
		end
		if pc and pc.Get and not (type(tier.Baseline) == "table" and pc.Get(tier.Baseline.PetId)) then
			bad("raid tier " .. tostring(tier.Id) .. ": Baseline must name a real pet")
		end
	end
	local topLevel = (pc and pc.MaxPetLevel) and pc.MaxPetLevel() or 100
	if nextLevel ~= topLevel + 1 then
		bad("raid tiers must cover the levels up to " .. topLevel)
	end
	-- raid tiers sorted by share, nothing paid for no damage, trophies floor
	local lastShare = 2
	for _, tier in ipairs(BattleCatalog.Raid.Tiers) do
		if tier.MinShare >= lastShare then
			bad("Raid.Tiers must be sorted by descending MinShare")
		end
		lastShare = tier.MinShare
	end
	if not finite(BattleCatalog.Raid.MinShare) or BattleCatalog.Raid.MinShare < 0 or lastShare < BattleCatalog.Raid.MinShare then
		bad("Raid.MinShare must be 0 or more and no higher than the lowest tier's MinShare")
	end
	if BattleCatalog.Trophies.Loss >= 0 or BattleCatalog.Trophies.Win <= 0 or BattleCatalog.Trophies.Floor ~= 0 then
		bad("Trophies: Win must be positive, Loss negative, Floor 0")
	end
	-- training, the loss rules, the Ring
	local TR = BattleCatalog.Training
	if TR.MaxRank ~= 10 or not finite(TR.Defense) or TR.Defense * TR.MaxRank > 0.3 + 1e-9 then
		bad("Training: MaxRank 10 and Defense capped at 30% at rank 10")
	end
	for _, skill in ipairs({ "Speed", "Physique", "Ability", "AbilityMeter", "Defense" }) do
		if not finite(TR[skill]) or TR[skill] <= 0 or TR[skill] > 0.1 then
			bad("Training." .. skill .. " must be a small positive share per rank")
		end
	end
	if #BattleCatalog.TrainingSkills ~= 4 then
		bad("TrainingSkills lists the four skills")
	end
	local LR = BattleCatalog.LossRules
	if not finite(LR.LossShare) or LR.LossShare <= 0 or LR.LossShare >= 1 or not finite(LR.LossMinSeconds) or not finite(LR.LossMinDamage) then
		bad("LossRules: LossShare in (0, 1), LossMinSeconds, LossMinDamage")
	end
	local RG = BattleCatalog.Ring
	if BattleCatalog.Zones.Ring == nil or BattleCatalog.TimeLimits.Ring ~= RG.TimeLimit then
		bad("Ring: Zones.Ring and TimeLimits.Ring = Ring.TimeLimit")
	end
	local topLevel = P4.maxLevel()
	local A = RG.LevelAnchors
	local anchorsOk = type(A) == "table" and #A >= 2 and type(A[1]) == "table" and A[1][1] == 1 and A[1][2] >= 1
	for i = 2, anchorsOk and #A or 0 do
		if not (type(A[i]) == "table" and finite(A[i][1]) and finite(A[i][2]) and A[i][1] > A[i - 1][1] and A[i][2] >= A[i - 1][2]) then
			anchorsOk = false
		end
	end
	if not anchorsOk or A[#A][2] ~= topLevel then
		bad("Ring.LevelAnchors: { round, level } pairs from { 1, >= 1 }, rounds strictly increasing, levels never falling, ending at MaxPetLevel()")
	end
	if not (finite(RG.BossLevelBump) and RG.BossLevelBump >= 0 and finite(RG.BossEvery) and RG.BossEvery >= 2) then
		bad("Ring: BossEvery >= 2 and BossLevelBump >= 0")
	end
	local from = type(RG.TierFrom) == "table" and RG.TierFrom or {}
	if not (finite(from.Golden) and finite(from.Rainbow) and from.Golden >= 1 and from.Rainbow > from.Golden and from.Rainbow <= RG.MaxRound) then
		bad("Ring.TierFrom: 1 <= Golden < Rainbow <= MaxRound")
	end
	local lastHelp = 0
	for i, h in ipairs(type(RG.Helpers) == "table" and RG.Helpers or {}) do
		if not (finite(h.From) and finite(h.Count) and h.From >= 1 and h.From <= RG.MaxRound and h.From > lastHelp and h.Count >= 2 and h.Count <= P4.maxChampions()) then
			bad("Ring.Helpers[" .. i .. "]: From in 1..MaxRound (increasing), Count 2..MaxChampions")
		end
		lastHelp = num(h.From, lastHelp)
	end
	if RG.MaxChampions ~= BattleCatalog.TeamSize then
		bad("Ring.MaxChampions = TeamSize (3)")
	end
	local tr = type(RG.Training) == "table" and RG.Training or {}
	if not (finite(tr.From) and finite(tr.To) and tr.From >= 1 and tr.To > tr.From and tr.To <= RG.MaxRound) then
		bad("Ring.Training: 1 <= From < To <= MaxRound")
	end
	if not (finite(RG.OpeningRounds) and RG.OpeningRounds >= 0 and RG.OpeningRounds <= (RG.Bands[1] and RG.Bands[1].To or 0) and RG.Bands[1].Rarities[1] == "Common") then
		bad("Ring.OpeningRounds: inside the first band (Common)")
	end
	if not (finite(RG.MaxLevelRaise) and RG.MaxLevelRaise >= 0) then
		bad("Ring.MaxLevelRaise: >= 0 (how far above the curve a picked species may be raised)")
	end
	local nextFrom = 1
	for i, b in ipairs(RG.Bands) do
		if b.From ~= nextFrom or type(b.Rarities) ~= "table" or #b.Rarities == 0 then
			bad("Ring.Bands[" .. i .. "] must start at round " .. nextFrom .. " and name rarities")
		end
		nextFrom = (b.To or huge) + 1
		for _, rarity in ipairs(b.Rarities or {}) do
			local pool = P4.pools()[rarity]
			if pc and (not pool or #pool == 0) then
				bad("Ring.Bands[" .. i .. "]: no catalog pets of rarity " .. tostring(rarity))
			end
		end
	end
	if nextFrom ~= huge then
		bad("Ring.Bands: the last band must be open-ended (no To)")
	end
	if pc then
		-- the climb (rounds 1..120, seeds 1..4): 1..3 plain pets (no Boss / Handicap / Boost), levels 1..MaxPetLevel, never
		-- EventOnly, the power never drops, three champions by round 100
		for seed = 1, 4 do
			local last = 0
			for round = 1, 120 do
				local spec = BattleCatalog.ChampionTeam(round, seed)
				if type(spec) ~= "table" or type(spec.Pets) ~= "table" or #spec.Pets < 1 or #spec.Pets > P4.maxChampions() then
					bad("ChampionTeam(" .. round .. ", " .. seed .. ") must be a team spec of 1.." .. P4.maxChampions() .. " pets")
					break
				end
				if spec.Power < last then
					bad("ChampionTeam: round " .. round .. " is weaker than round " .. (round - 1) .. " (seed " .. seed .. ")")
				end
				last = spec.Power
				for _, e in ipairs(spec.Pets) do
					if e.Boss or e.Handicap or e.Boost then
						bad("ChampionTeam: round " .. round .. " carries Boss / Handicap / Boost (champions use the player formula)")
					end
					if not (finite(e.Level) and e.Level >= 1 and e.Level <= topLevel) then
						bad("ChampionTeam: round " .. round .. " has a level outside 1..MaxPetLevel")
					end
					if pc.IsEventOnly and pc.IsEventOnly(e.PetId) then
						bad("ChampionTeam: round " .. round .. " fields an EventOnly pet")
					end
				end
				if round == 100 and #spec.Pets ~= P4.maxChampions() then
					bad("ChampionTeam: round 100 must field " .. P4.maxChampions() .. " champions")
				end
			end
		end
	end
	local rw = BattleCatalog.RingRewards(1, 0, false)
	if rw.Cash ~= RG.CashFloorBase + RG.CashFloorPerRound or rw.Xp ~= RG.XpBase + RG.XpPerRound or rw.Tokens ~= 0 then
		bad("RingRewards(1, 0, false) must pay the floor Cash and round-1 XP")
	end
	-- the Dungeon: 12 floors with existing elements, power never drops, rewards grow, first-clear tables complete, bands with pets
	local DG = BattleCatalog.Dungeon
	if DG.Floors ~= 12 or #BattleCatalog.DungeonFloors ~= 12 then
		bad("Dungeon: 12 floors")
	end
	local lastPower, lastTokens, lastXp = 0, 0, 0
	local gemTotal, tokenTotal = 0, 0
	for f = 1, #BattleCatalog.DungeonFloors do
		local info = BattleCatalog.DungeonFloors[f]
		if type(info.Name) ~= "string" or not validElements[info.Element] or type(info.Kind) ~= "string" then
			bad("DungeonFloors[" .. f .. "] needs Name, a Config element and a Kind")
		end
		local p = BattleCatalog.DungeonPower(f, 1)
		if not finite(p) or p < lastPower then
			bad("DungeonPower drops at floor " .. f)
		end
		lastPower = p
		local rw1 = BattleCatalog.DungeonRewards(f, 4, 2, 0, false)
		if rw1.Tokens <= lastTokens or rw1.Xp <= lastXp or rw1.Cash <= 0 then
			bad("DungeonRewards must grow with the floor (floor " .. f .. ")")
		end
		lastTokens, lastXp = rw1.Tokens, rw1.Xp
		local fc = BattleCatalog.DungeonFirstClear(f)
		if not finite(fc.Tokens) or fc.Tokens <= 0 or not finite(fc.Gems) or fc.Gems <= 0 then
			bad("DungeonFirstClear(" .. f .. ") incomplete")
		end
		gemTotal = gemTotal + fc.Gems
		tokenTotal = tokenTotal + fc.Tokens
		if pc and #D5.candidates(f) == 0 then
			bad("Dungeon floor " .. f .. ": no catalog pets in its band")
		end
	end
	if gemTotal ~= 156 or tokenTotal ~= 23400 then
		bad("DungeonFirstClear totals must be 23,400 Tokens / 156 Gems")
	end
	if #DG.Bands ~= 6 or DG.Bands[1][1] ~= 1 or DG.Bands[#DG.Bands][2] ~= DG.Floors then
		bad("Dungeon.Bands must cover floors 1-12")
	end
	if pc then
		local w = BattleCatalog.DungeonWave(1, 1, 1, 1, 1)
		if #w.Pets ~= 1 then
			bad("DungeonWave floor 1 = one enemy per wave")
		end
		local b = BattleCatalog.DungeonWave(3, 4, 1, 1, 1)
		if not b.Boss or #b.Pets ~= 1 or not b.Pets[1].Boss then
			bad("DungeonWave room 4 wave 1 = the boss alone in the mini-boss form")
		end
	end
	return #problems == 0, problems
end

return BattleCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">BattleSim</string>
          <string name="Source"><![CDATA[-- BattleSim: the PURE pet battle engine (ARCHITECTURE_V3.md "Phase 5 build contract" 4.3, rewritten core on the Phase 3
-- floor). No Instances, no services, no yields, no wall clock: the server steps it at 10 Hz and sends compact snapshots,
-- every client draws and interpolates. Deterministic for a seed: the same setup + the same commands (Move points
-- included) at the same steps replay the same battle. Plain Lua 5.1-compatible syntax only.
--
-- The floor is a 2D rectangle (x, z) in studs, centred on the zone centre. Phase 5: every PLAYER team is ONE FIGHTER
-- unit on the floor (the player's character is its body: BattleService feeds "Move" from the character every step)
-- plus two BENCHED helpers (not on the floor: lives, buff buttons, swaps). The player presses Attack / Element /
-- Special / Dash / Buff / Swap; the server owns reach, cooldowns, meter, lives and damage (Y1). NPC teams (side 2,
-- enemy waves, the Ring champion, raid minions) have every pet on the floor, driven by the AI: threat target, melee
-- orbit, a WIND-UP (Winding, 0.45 s) before every hit so the 0.35 s dash i-frames can dodge it. Bosses keep their
-- telegraphed patterns, minion waves, the enrage at 30% health and its lethal attack. Every number lives in BattleCatalog / PetCatalog.
-- 2026-11-01: docs/superpowers/specs/2026-11-01-attack-fx-design.md (a unit's areas are catalog x reachOf(u), its stage through stageOf(u)).
-- 2026-11-02: docs/superpowers/specs/2026-11-01-evolved-forms-design.md (a fighter's special gains its form's twists by formOf(u); hybrids are stage 0).
--
-- API (the contract):
--   BattleSim.new(setup) -> battle | nil, reason
--     setup = { Mode = "Duel" | "Raid" | "Ring" | "Dungeon" (default Duel), Seed, Id, Zone = n | { X, Z } | { w, d },
--               Teams = { team... }, Boss = bossId (Raid), RaidTier = tierId (Raid; nil / junk = "High"), Round (Ring),
--               TimeLimit (nil = BattleCatalog.TimeLimits[Mode]),
--               Specials = false (harness: nobody casts) }
--     team  = { Owner, Side = 1 | 2, Name, Npc = bool, Auto = bool, Anchor = { x, z }, Specials = false, Wave = n,
--               Pets = { entry x 1..3 } }   entry: Key, PetId, Def, Level, Tier, Slot, Evo, Train, Boost, Handicap, Boss,
--               Wild, Xp, XpNext, Crowned, NoSpecial, HpFraction (player teams: the pet starts at maxHp x f, 0 < f < 1,
--               >= 1 HP; junk / missing = full; the Champion Ring's no-heal rule).
--               A PLAYER team (not Npc): Pets[1] = the fighter, 2-3 the bench
--               (3 lives). Npc teams: every pet is on the floor. Auto (harness): the AI plays the fighter's kit.
--               Mode Dungeon: side 2 may start empty (SpawnEnemies fills it).
--   battle:Command(owner, action, arg) -> ok, reason, extra
--     "Attack" (targetId | nil)       DIRECTS the fighter (dungeon fixes 4; it never swings by itself): Attack(id) locks that enemy,
--                                     Attack() KEEPS a live lock anywhere on the floor (bug #16: F never pulls the pet off its
--                                     enemy; no echo; wave 6: no EngageRange), else the engaged target, else locks the nearest
--                                     targetable enemy (by distance then id; the old cycle is gone: the client's hold-F / Tab / RT
--                                     send Target(next) for that);
--                                     -> true, lockId, "OutOfReach" | nil (the lock is beyond
--                                     range + radius + AttackSlack: BattleService toasts "Too far!"); refused: Down / BadTarget /
--                                     NoTarget. Echo: Order { owner, order = "Attack", target } when the lock changes.
--                                     THE AUTO-ATTACK: every step a player's fighter that is not Stunned / Casting / Dashing /
--                                     arriving, with t >= nextAttack - Interval x (1 - AttackTolerance), hits the lock when it is
--                                     targetable and within range + radius + AttackSlack, else the nearest targetable enemy in that
--                                     reach (applyDamage; nextAttack = max(nextAttack, t) + Interval). It never moves the unit.
--     "Element" (id | { x, z } | nil) cooldown Fighter.ElementCooldown; the shape of ElementAttacks[fighter.elems[1]] from the SERVER
--                                     fighter position toward the target / aim / lock / facing (a ranged pet's Circle lands on the
--                                     aim point, at most its range away); its twists by ElementFormOf at stage >= 1
--     "Special" ()                    meter >= SpecialMeterMax; offensive kinds as before; Heal / Shield / Rally / Haste act on the fighter
--     "Dash" ()                       cooldown DashCooldown -> Dashing for DashSeconds, i-frames until t + DashIFrames. Wave 6: the
--                                     pet SIDESTEPS out of the threat (never into the boss): the soonest timed threat aimed at /
--                                     covering it (an NPC wind-up on it, a boss telegraph over it): circle -> straight away from
--                                     its centre, line -> perpendicular to the line on the pet's side, wind-up -> away from the
--                                     attacker; no threat -> perpendicular to the aim (lock / engaged / nearest) toward the floor
--                                     centre; a candidate that ends closer / still inside is swapped for the next (the other
--                                     perpendicular, straight away). It moves at legal run x the dash factor, just far enough to
--                                     clear the shape + 1 stud (4 studs at least, clamped to the floor), and does nothing else
--                                     for DashSeconds. PARRY: a timed threat landing within ParryWindow (0.25 s) of the press is
--                                     parried: no damage (the i-frames), the attacker staggered ParryStagger (0.4 s: an NPC is
--                                     stunned, its wind-up cancelled; a boss starts no basic attack / telegraph, at most once per
--                                     ParryBossGap 3 s), the pet gains ParryMeter (+8) per parried threat, a Parry event each. A
--                                     boss basic attack has no tell: the i-frames dodge it, it is never a parry.
--     "Target" (unitId | nil)         lock-on; Attack / Element default to it
--     "Buff" (2 | 3)                  that helper's buff on the fighter; cooldown per helper (SupportCooldown / HelperCooldown)
--     "Swap" (2 | 3)                  fighter <-> helper; SwapCooldown; the incoming pet arrives Casting for SwapCastSeconds; refused
--                                     while Casting / Stunned
--     "Move" (x, z)                   the fighter's wanted floor point (the CHARACTER position; never from a remote): the fighter walks
--                                     toward it at <= legal run x MoveSlack (x DashSpeed / RunSpeed while Dashing), clamped to the floor
--                                     THE ENGAGE RULE (wave 6, replaces bug #22's stand-still rule): the pet fights any targetable
--                                     enemy on the floor (the fight area: ring pocket, duel ring, raid zone, dungeon room); the
--                                     character's movement never pulls it off. FOLLOW (above) -> ENGAGED at once when the fighter
--                                     is not arriving / Casting and an engage target exists: the lock (if targetable), else the
--                                     current engaged target (sticky until it dies or is untargetable), else the fresh threat (who
--                                     hit it within ThreatSeconds), else the targetable enemy nearest to the FIGHTER (ties: lower
--                                     id). Engaged, the fighter ignores the Move point and walks at the honest legal run (no
--                                     MoveSlack; 0 Stunned) to reach - 0.5 (melee; battle-feel T2: + Damage.Standoff, standoffOf) /
--                                     reach - 1 (ranged: it holds at the edge of its range) of the target. Back to FOLLOW only when no target is left (a wave still arriving, the
--                                     fight's end); a Swap / the fighter's KO / RemoveTeam drop it too. Harness Auto teams
--                                     (autoFighter) never engage: today's exact behaviour.
--     "Cheer" ()                      wave 6, Raid / Dungeon only ("Cheer up!"): the fighter deals x (1 + CheerBoost 0.05) for
--                                     CheerSeconds 5; cooldown CheerCooldown 20; never stacks (a cheer SETS the window). Refused:
--                                     NoCheer (Ring / Duel: the podium cheer there is visual only), Down, Cooldown (extra =
--                                     seconds left). Event Cheer { owner, unit (the fighter), untilT }
--     "Retreat" ()                    evolved forms, Raid only (NoRetreat elsewhere; Down with no living fighter; Cooldown + seconds left during the
--                                     RetreatWait; Retreated when already back): team.retreat, team.noEngage = true, drops the engage and the lock,
--                                     the short dodge (i-frames for Fighter.RetreatDodge, no Dash event). Accepted while Stunned / Casting /
--                                     Dashing (the pet runs once it can). Back: the pet runs to the Move point (FOLLOW), Attack / Element / Special
--                                     refused Retreated, no auto-attack, no meter from time, hurt or a parry (a helper's buff still fills it); Target /
--                                     Buff / Swap / Cheer / Dash / Forfeit work; a Swap or a KO keeps it (it is on the team, the incoming pet is back too).
--                                     Echo: Order { order = "Retreat" }. TARGETING: while some other fighter is on the floor, not back (self.anyEngaged, set
--                                     at the top of every step), the boss's basic attack, its telegraph points and the minions skip retreated pets; when
--                                     nobody is, retreated pets are targets again, so the boss never stalls. An area already placed keeps its point: a
--                                     telegraph, a lethal (it knocks out only that unit) and a zone hit a retreated pet standing in them. Retreated teams
--                                     still count in the boss's scaling.
--     "Engage" ()                     Raid only (NoRetreat); NotRetreated when not back: the pet fights again, the RetreatWait starts. Echo: Order { order = "Engage" }
--     "Forfeit" ()                    Duel / Ring: the team is knocked out; Raid / Dungeon: RemoveTeam
--   battle:Step(dt) -> events;  battle:Snapshot();  battle:SnapshotDelta(last);  BattleSim.DecodeSnapshot(payload, prev)
--   battle:AddTeam(team) -> infos | nil, reason;  battle:RemoveTeam(owner) -> ok
--   battle:SpawnEnemies(list, opts) -> infos | nil, reason    (Dungeon / Raid: a side-2 Npc Auto team { Owner = "wave:"..n }; opts =
--                                     { Wave = n, Anchor = { x, z } (default the far +Z edge), Name, Owner })
--   battle:LivingEnemies() -> n;  battle:BossHp() -> 0..1 | nil;  battle:Finish(reason) -> ok, events  ("Cleared" = side 1 wins,
--                                     "Abandoned" / "Shutdown" / ... = no winner);  battle:Abort(reason) = Finish
--   battle:TeamOf(owner) -> { Owner, Side, Fighter = id, Bench = { id, id }, Lives, Speed = { Walk, Run }, Cooldowns = { Element, Dash,
--                                     Swap, Cheer, Retreat, Buff = { [slot] = seconds } }, Lock, Engaged (the engaged target id | nil),
--                                     Cheering (the Cheer up! boost is on), Retreated (bool), Damage, Kills,
--                                     Left, Forfeited, Units = { {id, slot, hp,
--                                     maxHp, meter, state, alive, bench}... } }
--   battle:SpeedOf(owner) -> { Walk, Run }   the fighter's current legal speeds (speed buffs / slows included)
--   battle:Result() -> nil while running, else { Mode, Reason, WinnerSide, Winners, Losers, Draw, Forfeit, BossId, Round, Damage =
--                                     { [owner] = n }, Shares, Duration, Survivors = { [owner] = lives }, Hp = { [side] = share }, Kills =
--                                     { [owner] = n }, Waves, BossHp, BossMaxHp, Units = { [owner] = { { Key, Hp, MaxHp, Alive }... } }
--                                     (every player team's pets in slot order, bench included; Hp rounded, Alive = alive and
--                                     Hp > 0: a pet at 0 HP when the fight ends is fainted), Retreated = { [owner] = seconds back }, Fought =
--                                     { [owner] = seconds since the team joined the fight } (0.1 steps) }
--   battle:Describe() -> { BattleId, Mode, Seed, Zone = { X, Z }, TimeLimit, BossId, Round, Sides, Units = { unitInfo... } }
--   battle:StaticUnits() -> { unitInfo... }   unitInfo = { id, side, owner, slot, kind, key, petId, boss, name, species, look,
--                                     element, elements, maxHp, level, tier, scale, ranged, range, radius,
--                                     special = { Id, Name (the form's at stage >= 1), Base, Kind, Color, Form (0 | 1 | 2) }, evo, xp, xpNext,
--                                     reach (x its catalog areas: BattleCatalog.ReachOf of its stage; nil = x1),
--                                     crowned, role ("Fighter" | "Support"), buff = { Kind, Name, Seconds, Value, Cooldown },
--                                     elementAttack = { Name (the form's at stage >= 1), Shape, Element }, bench = 2 | 3 | nil, wild, walk, run }
--   battle:Time(), IsFinished(), Owners(), BossStatus() (+ Tier, Lethal = a lethal telegraph is pending), SetAnchor(owner, x, z)
--   BattleSim.States = { Idle 0, Moving 1, Attacking 2, Benched 3, Casting 4, Down 5, Stunned 6, Dashing 7 }  (Winding = Attacking + windup bit)
--   BattleSim.Events = { Hit, Special, KO, Telegraph, Spawn, Enrage, Order, Zone, Leave, End, Element, Dash, Buff, Swap, Windup, Wave,
--                        EnemiesDown, Speed, Engage, Parry, Cheer, Twist, Cast, CastBreak }
-- Event shapes:
--   (battle-feel T3) with BattleCatalog.Damage.SpecialCast (the real cast): Cast { unit, kind, name, at, target?, tx?, tz?, form? }
--                when a special starts (Casting until at, the aim fixed), its Special (+ at = the cast's start) and effects at
--                `at` (a target in dash i-frames then = a miss); CastBreak { unit, kind } = a stun / a retreat ended it (meter kept)
--   Engage     { owner, unit (the fighter), on = true, target }  /  { owner, unit, on = false }   (only the FOLLOW / ENGAGED flips)
--   Hit        { from, to, dmg, elem, crit, absorbed, miss = true (dodged), burn = true, leech = n, element = name, special = kind,
--                tele, zone, attack, buffDmg = true, lethal = true (the enraged boss's lethal attack: dmg = the whole HP + shield, a KO follows),
--                twist = "Charge" | "Landing" | "Aftershock" | "Twin" | "LastStrike" | "Shatter" | "Burst" | "Maelstrom" | "Fissure" | "Rockspire" | "Forked",
--                bonus = true (a boss's bonus hit), thorns = true, double = true }
--   Special    { unit, kind, name, x, z, tx, tz, target, targets, heals, shields, stunned, angle, r (Blast / Freeze / Storm),
--                length + width (Beam), range (Pounce) }   (an evolved pet's areas as the server used them, 0.1 steps; an unevolved
--                pet's stay off the wire, the client knows them: a full raid's traffic budget is tight)
--                stage >= 1 only: form = 1 | 2, name = the form's name; Pounce: x0, z0, angle (3 decimals), length, width = the charge line
--                (the drawn area IS the real area), targets = the aimed target first, then those on the line; stage 2: burstR, burstTargets
--   Twist      { unit, kind (the special kind, or the element), twist = "Aftershock" | "Twin" | "LastStrike" | "Shatter" | "Burst" | "Lingering" | "Overflow" | "Chill"
--                | "Maelstrom" | "Fissure" | "Rockspire" | "Forked" | "Starfall",
--                x, z (the point, 0.1 steps), angle (Twin, Maelstrom: 3 decimals), r | length + width (0.1 steps), band (Rockspire: the ring runs r .. r + band),
--                tx, tz (Forked: x, z = the last one struck, tx, tz = the next), targets, heals = { { id, hp }... } (Lingering, Starfall),
--                shields = { id... } + amount (Overflow) }   (a twist that lands later than its cast or adds to it; stage >= 1 only)
--   KO         { unit, by, forfeit }          Telegraph { id, boss, name, attack, shape, x, z, r | angle + length + width, at, hits, freeze, linger, lethal = true }
--   Spawn      { units, wave, boss, owner }   Enrage { unit }      Zone { unit, kind (Storm | Linger | Patch), special (Patch: the kind or element it came from),
--                                                                     x, z, r, seconds, side }     Leave { owner, units }
--   Order      { owner, order, target, rejected }   (every refused command echoes `rejected`; Attack / Target / Forfeit echo when accepted)
--   Element    { unit, element, name (the form's at stage >= 1), x, z, angle | tx, tz, targets, length (Cone / Line), width (Line), r (Circle), form = 1 | 2 (stage >= 1 only) }
--              (x, z = the caster, tx, tz = the aim. A Circle is round a melee pet; a ranged pet's is centred on (tx, tz), its aim point at most its range away)
--   Dash       { unit, dir = { dx, dz } (the SIDESTEP: unit vector in floor space, 0.01 steps), target (the threat's source | nil) }
--   Cheer      { owner, unit (the fighter), untilT (the boost's end, battle time) }
--   Parry      { unit (the fighter), from (the attacker), tele (the telegraph id | nil) }; the parried telegraph's Hit on the
--              fighter is { miss = true, parry = true }
--   Buff       { owner, unit (the helper), kind, name, until, target (the fighter), amount, heals = { { id, hp }... } (Heal:
--                the fighter + the other benched pet) }     Swap { owner, out, in, auto }
--   Speed      { owner, walk, run }   (whenever the fighter's legal speeds change: Swap, Haste / Slow start and end)
--   Windup     { unit, target, at }   Wave { index, units, left, timeLimit }   EnemiesDown { wave }   End { reason, winnerSide }
--   ARRIVAL (dungeon fixes 3): every enemy added after the start (AddTeam / SpawnEnemies waves + escorts, raid minions) arrives for
--   BattleCatalog.Fighter.ArriveSeconds (1.2): it does not act, cannot be hit (i-frames) and is never picked as the nearest target;
--   its unit info (Wave / Spawn units, StaticUnits while it lasts) carries Arrive = seconds left. A Dungeon wave added after the
--   start pushes the time limit back by the arrival (Wave.timeLimit = the new limit).
--   HEALING (dungeon fixes 7): no passive bench regen; a player's Heal special heals the fighter AND its benched pets; the Heal
--   helper buff heals the fighter and the other benched pet.
-- Wire form (SnapshotDelta / DecodeSnapshot): per changed unit the numbers  code, pos [, hp] [, meter] [, shield] [, target]
--   code = id x 1024 + lives x 256 + windup x 128 + mask x 8 + state (mask bits: 1 hp, 2 meter, 4 shield, 8 target; lives 0..3 =
--   the fighter's team lives; windup 1 while Winding), pos = (x + 200) x 10 x 4096 + (z + 200) x 10 (0.1 stud steps).
-- End rules: Duel: a side with no lives loses; both at once or the 120 s timeout -> DoubleKoByDamage (more damage dealt wins;
--   equal = Draw). Ring: no lives = loss, timeout = loss. Raid: BossDown / Wipe / Timeout / Abandoned. Dungeon: side-1 wipe ->
--   "Wipe", timeout -> "Timeout", never ends on an empty side 2 (Finish does).
-- Deleted (10.5): ATTACK / RETREAT orders, Retreating, Damage.Retreat*, the per-slot Special command, the Trial setup, Overtime,
--   Result.Level, Describe.Level. (Evolved forms' "Retreat" is a new, raid-only team state, not that order: no state of its own, no lock timer.)

local Shared = script.Parent

local BattleSim = {}
BattleSim.__index = BattleSim
BattleSim.Version = 5

local floor, ceil, sqrt, max, min, huge, abs = math.floor, math.ceil, math.sqrt, math.max, math.min, math.huge, math.abs
local cos, sin, atan2, pi = math.cos, math.sin, math.atan2, math.pi

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------
BattleSim.States = { Idle = 0, Moving = 1, Attacking = 2, Benched = 3, Casting = 4, Down = 5, Stunned = 6, Dashing = 7 }
BattleSim.StateNames = {}
for name, code in pairs(BattleSim.States) do
	BattleSim.StateNames[code] = name
end
BattleSim.Events = {
	Hit = "Hit",
	Special = "Special",
	KO = "KO",
	Telegraph = "Telegraph",
	Spawn = "Spawn",
	Enrage = "Enrage",
	Order = "Order",
	Zone = "Zone",
	Leave = "Leave",
	End = "End",
	Element = "Element",
	Dash = "Dash",
	Buff = "Buff",
	Swap = "Swap",
	Windup = "Windup",
	Wave = "Wave",
	EnemiesDown = "EnemiesDown",
	Speed = "Speed",
	Engage = "Engage",
	Parry = "Parry",
	Cheer = "Cheer",
	Twist = "Twist",
	-- (battle-feel T3, spec decision 6) the real cast: Cast { unit, kind, name, at, target?, tx?, tz?, form? } at its start
	-- (at = the sim time its effects land), CastBreak { unit, kind } when a stun / a retreat ends it first (meter kept)
	Cast = "Cast",
	CastBreak = "CastBreak",
}
BattleSim.Actions = { "Attack", "Element", "Special", "Dash", "Target", "Buff", "Swap", "Move", "Cheer", "Forfeit", "Retreat", "Engage" }
BattleSim.Modes = { "Duel", "Raid", "Ring", "Dungeon" }
local MODE_OK = {}
for _, m in ipairs(BattleSim.Modes) do
	MODE_OK[m] = true
end
BattleSim.LineOvershoot = 6 -- studs a Line telegraph runs past the pet it is aimed at

local S_IDLE, S_MOVING, S_ATTACKING, S_BENCHED, S_CASTING, S_DOWN, S_STUNNED, S_DASHING =
	BattleSim.States.Idle, BattleSim.States.Moving, BattleSim.States.Attacking, BattleSim.States.Benched,
	BattleSim.States.Casting, BattleSim.States.Down, BattleSim.States.Stunned, BattleSim.States.Dashing
local EV = BattleSim.Events

local MAX_UNITS = 127 -- the wire code packs the id below 128 (a 16-raid is ~16 x 3 + boss + waves)
local MIN_DT, MAX_DT = 0.02, 0.5
local ZONE_TICK = 0.5
local ATTACK_POSE = 0.3 -- seconds a fighter shows Attacking after a hit
-- the wire snapshot: positions at 0.1 stud over a floor of at most 400 studs
local POS_OFFSET, POS_STEPS, POS_BASE = 200, 10, 4096
local MASK_HP, MASK_METER, MASK_SHIELD, MASK_TARGET = 1, 2, 4, 8
local CODE_WINDUP, CODE_LIVES, CODE_ID = 128, 256, 1024

----------------------------------------------------------------------
-- Lazy modules
----------------------------------------------------------------------
local lazyCache = {}
local function lazy(name)
	local entry = lazyCache[name]
	if entry == nil then
		entry = false
		local inst = Shared:FindFirstChild(name)
		if inst then
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				entry = result
			end
		end
		lazyCache[name] = entry
	end
	return entry or nil
end

local function catalog()
	return lazy("BattleCatalog")
end

local function petCatalog()
	return lazy("PetCatalog")
end

local function petKeys()
	return lazy("PetKeys")
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= huge and n ~= -huge
end

local function r1(n)
	return floor(n * 10 + 0.5) / 10
end

local function num(v, default)
	if finite(v) then
		return v
	end
	return default
end

----------------------------------------------------------------------
-- Deterministic RNG (Lehmer / Park-Miller: exact in doubles, the same on every platform)
----------------------------------------------------------------------
local RNG_M = 2147483647
local RNG_A = 48271

local function seedState(seed)
	local s = tonumber(seed) or 1
	if s ~= s or s == huge or s == -huge then
		s = 1
	end
	s = floor(abs(s)) % (RNG_M - 1) + 1
	for _ = 1, 4 do
		s = (s * RNG_A) % RNG_M
	end
	return s
end

local function rand(self)
	local s = (self.rngState * RNG_A) % RNG_M
	self.rngState = s
	return s / RNG_M
end

local function randInt(self, lo, hi)
	return lo + floor(rand(self) * (hi - lo + 1))
end

----------------------------------------------------------------------
-- Catalog access with safe fallbacks (the engine must never error at runtime)
----------------------------------------------------------------------
local FALLBACK_DAMAGE = {
	HpScale = 2.6, DamageScale = 0.6, Variance = 0.2, MinHit = 1, TargetSticky = 1.6, TargetSpread = 1.35, ThreatSeconds = 3,
	MeterMax = 100, MeterStart = { 20, 50 }, MeterOnHit = 4, MeterOnHurt = 2, MeterPerSecond = 2,
	CastSeconds = 0.5, SpecialScale = 1, SeparationRadius = 3.2, RetargetSeconds = 0.5, EngageSlack = 0.6, Standoff = 0,
	NpcSpecialDelay = { 0.4, 1.4 }, KoMeterLoss = true, Slow = 0.6, Weaken = 0.85, BurnTicks = 3,
}
local FALLBACK_FIGHTER = {
	AttackSlack = 3.0, AttackTolerance = 0.85, ElementCooldown = 7, ElementMult = 2.4, ElementRange = 14, SpecialMeterMax = 100,
	MeterPerSecond = 6, MeterOnHit = 4, MeterOnHurt = 2, DashSeconds = 0.35, DashCooldown = 2.5, DashIFrames = 0.35, SwapCooldown = 10,
	SwapCastSeconds = 0.6, BenchRegenPerSecond = 0, ArriveSeconds = 1.2, DownAutoSwap = true, HelperCooldown = 15, SupportCooldown = 12, Windup = 0.45,
	KitFactor = 1.5, HelperWeight = 0.35, Lives = 3, WalkMult = 1.15, WalkMin = 12, WalkMax = 20, RunMult = 1.3, MoveSlack = 1.25,
	Leash = 10, LeashSeconds = 3, ParryWindow = 0.25, ParryStagger = 0.4, ParryMeter = 8, ParryBossGap = 3,
	CheerBoost = 0.05, CheerSeconds = 5, CheerCooldown = 20,
}

local function damageRules()
	local bc = catalog()
	local d = bc and bc.Damage
	if type(d) == "table" then
		return d
	end
	return FALLBACK_DAMAGE
end

local function fighterRules()
	local bc = catalog()
	local f = bc and bc.Fighter
	if type(f) == "table" then
		return f
	end
	return FALLBACK_FIGHTER
end

local function dashSpeedFactor()
	local cfg = lazy("Config")
	local phys = cfg and cfg.Physics
	if type(phys) == "table" and finite(phys.DashSpeed) and finite(phys.RunSpeed) and phys.RunSpeed > 0 then
		return max(1, phys.DashSpeed / phys.RunSpeed)
	end
	return 85 / 27
end

local function resolveDef(entry)
	if type(entry) ~= "table" then
		return nil
	end
	if type(entry.Def) == "table" and type(entry.Def.Stats) == "table" then
		return entry.Def
	end
	local pc = petCatalog()
	local pk = petKeys()
	for k = 1, 3 do
		local c = (k == 1 and entry.Key) or (k == 2 and entry.PetId) or (k == 3 and entry.Id) or nil
		if type(c) == "string" then
			if pc and pc.Get then
				local def = pc.Get(c)
				if def then
					return def
				end
			end
			if pk and pk.DefOf then
				local ok, def = pcall(pk.DefOf, c, nil)
				if ok and type(def) == "table" and type(def.Stats) == "table" then
					return def
				end
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Geometry helpers
----------------------------------------------------------------------
local function dist(ax, az, bx, bz)
	local dx, dz = bx - ax, bz - az
	return sqrt(dx * dx + dz * dz)
end

local function clampToFloor(self, u)
	local hx, hz = self.zone.HalfX - u.radius, self.zone.HalfZ - u.radius
	if hx < 0.5 then
		hx = 0.5
	end
	if hz < 0.5 then
		hz = 0.5
	end
	if u.x < -hx then
		u.x = -hx
	elseif u.x > hx then
		u.x = hx
	end
	if u.z < -hz then
		u.z = -hz
	elseif u.z > hz then
		u.z = hz
	end
end

local function clampPoint(self, x, z, margin)
	local hx, hz = max(0.5, self.zone.HalfX - (margin or 1)), max(0.5, self.zone.HalfZ - (margin or 1))
	return max(-hx, min(hx, x)), max(-hz, min(hz, z))
end

local function pointInCircle(px, pz, radius, x, z, r)
	local dx, dz = px - x, pz - z
	local reach = r + radius
	return dx * dx + dz * dz <= reach * reach
end

local function pointInLine(px, pz, radius, x, z, angle, length, width)
	local dx, dz = px - x, pz - z
	local dirX, dirZ = cos(angle), sin(angle)
	local along = dx * dirX + dz * dirZ
	if along < -radius or along > length + radius then
		return false
	end
	local perp = abs(dx * dirZ - dz * dirX)
	return perp <= width / 2 + radius
end

-- (feel-balance) every area test reads a unit at its BODY POINT: the rest spot, or its bite point while it strikes
-- (u.bdx / u.bdz = the offset, set by Strike.refresh; nil = at rest, the exact old test)
local function inCircle(u, x, z, r)
	local bdx = u.bdx
	if bdx then
		return pointInCircle(u.x + bdx, u.z + u.bdz, u.radius, x, z, r)
	end
	return pointInCircle(u.x, u.z, u.radius, x, z, r)
end

local function inLine(u, x, z, angle, length, width)
	local bdx = u.bdx
	if bdx then
		return pointInLine(u.x + bdx, u.z + u.bdz, u.radius, x, z, angle, length, width)
	end
	return pointInLine(u.x, u.z, u.radius, x, z, angle, length, width)
end

-- a body inside a cone from (x, z) along `angle`, half-angle `half` (radians), `length` studs
local function inCone(u, x, z, angle, half, length)
	local dx, dz = u.x - x, u.z - z
	if u.bdx then
		dx, dz = dx + u.bdx, dz + u.bdz
	end
	local d = sqrt(dx * dx + dz * dz)
	if d > length + u.radius then
		return false
	end
	if d <= u.radius + 0.5 then
		return true
	end
	local a = atan2(dz, dx) - angle
	while a > pi do
		a = a - 2 * pi
	end
	while a < -pi do
		a = a + 2 * pi
	end
	-- the body's radius widens the cone a little at its distance
	local extra = (d > 0.01) and (u.radius / d) or 0
	return abs(a) <= half + extra
end

-- (battle-feel T2, spec decision 2) the studs a melee, non-boss unit rests farther out: D.Standoff for it, 0 for a ranged
-- unit or a boss. Added to its rest spot and to every attack / hit test of it alike (reach, damage and tempo unchanged)
local function standoffOf(D, u)
	if u.ranged or u.kind == "Boss" then
		return 0
	end
	local so = D and D.Standoff
	return (finite(so) and so > 0) and so or 0
end

----------------------------------------------------------------------
-- (feel-balance, plan docs/superpowers/plans/2026-11-10-feel-balance.md Task 1) THE STRIKE: a melee unit with a standoff
-- has a server BODY POINT on the dash the client draws (BattleCatalog.Damage.Strike): at its bite point (the rest spot moved
-- Strike.advance toward its target) from biteAt - In x Out to biteAt + Bite + Hold + Back x Out of every bite, all the time
-- while it flurries (bites under FlurryBelow apart), at the rest spot otherwise and at once when it is stunned, casts,
-- dashes, falls, leaves the floor or its target does. Strike.refresh sets u.bdx / u.bdz (the offset) once per step before
-- any unit acts; the area tests (inCircle / inLine / inCone), the boss's nearest pick and Snapshot (bx, bz) read it. The
-- server alone moves it: no command does (a Dash only closes it). No RNG. Standoff 0: no window ever opens.
----------------------------------------------------------------------
local Strike = {}
local STRIKE_EPS = 1e-6

function Strike.rules(D)
	local s = D and D.Strike
	if type(s) ~= "table" then
		s = {}
	end
	return num(s.In, 0.3), num(s.Bite, 0.08), num(s.Hold, 0.12), num(s.Back, 0.4), num(s.FlurryBelow, 0.75), num(s.Out, 0.5)
end

-- the studs u's bite point lies in from its rest spot toward `target`: the free gap down to the Standoff-0 rest spot
-- (reach - 0.5), at most the standoff; half of it only while the target strikes back at u at time t (both dash in: they
-- meet half-way). (feel-balance review) It was half whenever the target had a standoff, so a melee pet biting a resting
-- melee pet stopped 4 studs short of where it stood at Standoff 0, outside the defender's own areas round itself (a mirror
-- duel's Shield Burst never reached it): the duels' extra length at Standoff 8
function Strike.advance(D, u, target, t)
	local so = standoffOf(D, u)
	if so <= 0 or not target then
		return 0
	end
	local gap = dist(u.x, u.z, target.x, target.z) - (u.range + target.radius - 0.5)
	if gap <= 0 then
		return 0
	end
	if standoffOf(D, target) > 0 and target.sTgt == u and target.sFrom and t and t >= target.sFrom - STRIKE_EPS and t <= target.sTo + STRIKE_EPS then
		gap = gap * 0.5
	end
	return min(so, gap)
end

-- u's bite point toward `target` at time t -> x, z (its rest spot when it has no advance)
function Strike.point(D, u, target, t)
	local adv = Strike.advance(D, u, target, t)
	if adv <= 0 then
		return u.x, u.z
	end
	local dx, dz = target.x - u.x, target.z - u.z
	local d = sqrt(dx * dx + dz * dz)
	if d < 0.01 then
		return u.x, u.z
	end
	return u.x + dx / d * adv, u.z + dz / d * adv
end

function Strike.close(u)
	u.sFrom, u.sTo, u.sTgt, u.nFrom, u.nTo, u.nTgt, u.bdx, u.bdz = nil, nil, nil, nil, nil, nil, nil, nil
end

-- u's bite on `target` is drawn at biteAt: its window, merged into the open one when they touch (a flurry: bites under
-- FlurryBelow apart hold it to biteAt + FlurryBelow + Back x Out, so the next bite lands inside it); a window that starts
-- after the open one ends waits in the next slot
function Strike.open(self, u, target, biteAt)
	local D = damageRules()
	if standoffOf(D, u) <= 0 or not target or not finite(biteAt) then
		return
	end
	local In, Bite, Hold, Back, Below, Out = Strike.rules(D)
	local from = biteAt - In * Out
	local flurry = u.sBite ~= nil and biteAt - u.sBite < Below
	local to = biteAt + (flurry and (Below + Back * Out) or (Bite + Hold + Back * Out))
	u.sBite = biteAt
	if u.sTo and u.sTgt == target and u.sTo >= from - 0.1 - STRIKE_EPS then
		u.sFrom, u.sTo = min(u.sFrom, from), max(u.sTo, to)
	elseif u.sTo and u.sTo >= self.t - STRIKE_EPS then
		if u.nTo and u.nTgt == target and u.nTo >= from - 0.1 - STRIKE_EPS then
			u.nFrom, u.nTo = min(u.nFrom, from), max(u.nTo, to)
		else
			u.nFrom, u.nTo, u.nTgt = from, to, target
		end
	else
		u.sFrom, u.sTo, u.sTgt = from, to, target
		u.nFrom, u.nTo, u.nTgt = nil, nil, nil
	end
end

-- once per step, before any unit acts: every unit's body point for this step
function Strike.refresh(self)
	local D = nil
	local t = self.t
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		local on = false
		if u.sTo then
			while u.sTo and t > u.sTo + STRIKE_EPS do
				u.sFrom, u.sTo, u.sTgt = u.nFrom, u.nTo, u.nTgt
				u.nFrom, u.nTo, u.nTgt = nil, nil, nil
			end
			if u.sTo and t >= u.sFrom - STRIKE_EPS then
				local tg = u.sTgt
				if not u.alive or u.gone or u.benched or t < (u.stunUntil or 0) or t < (u.castUntil or 0) or t < (u.dashUntil or 0)
					or not tg or not tg.alive or tg.gone or tg.benched then
					Strike.close(u)
				else
					D = D or damageRules()
					local adv = Strike.advance(D, u, tg, t)
					local dx, dz = tg.x - u.x, tg.z - u.z
					local d = sqrt(dx * dx + dz * dz)
					if adv > 0 and d > 0.01 then
						u.bdx, u.bdz = dx / d * adv, dz / d * adv
						on = true
					end
				end
			end
		end
		if not on and u.bdx then
			u.bdx, u.bdz = nil, nil
		end
	end
end

----------------------------------------------------------------------
-- Construction
----------------------------------------------------------------------
local function parseZone(mode, zone)
	local bc = catalog()
	local default = (bc and type(bc.Zones) == "table" and bc.Zones[mode]) or { X = 44, Z = 44 }
	local x, z = default.X, default.Z
	if finite(zone) and zone > 0 then
		x, z = zone, zone
	elseif type(zone) == "table" then
		local zx = zone.X or zone.x or zone[1]
		local zz = zone.Z or zone.z or zone[2]
		if type(zone.Size) == "table" then
			zx = zone.Size.X or zone.Size.x or zone.Size[1] or zx
			zz = zone.Size.Z or zone.Size.z or zone.Size[2] or zz
		elseif finite(zone.Size) then
			zx, zz = zone.Size, zone.Size
		end
		if finite(zx) and zx > 0 then
			x = zx
		end
		if finite(zz) and zz > 0 then
			z = zz
		end
	end
	x = max(16, min(400, x))
	z = max(16, min(400, z))
	return { X = x, Z = z, HalfX = x / 2, HalfZ = z / 2 }
end

local function newTeamRecord(self, spec, side)
	return {
		owner = spec.Owner,
		side = side,
		name = type(spec.Name) == "string" and spec.Name or nil,
		npc = spec.Npc == true,
		auto = spec.Npc == true or spec.Auto == true,
		player = spec.Npc ~= true, -- a fighter + bench team
		noSpecials = spec.Specials == false,
		units = {},
		bySlot = {},
		fighter = nil,
		lock = nil,
		wantX = nil,
		wantZ = nil,
		-- the engage rule (wave 6): nil | { target, unit, since }; noEngage = true holds it off (Retreat; white-box in the smoke tests)
		engage = nil,
		-- evolved forms: nil | { since } while the team is back (Raid); the wait after an Engage; the seconds back; when it joined (Result)
		retreat = nil,
		retreatReadyAt = 0,
		retreatSeconds = 0,
		joinedAt = self.t,
		faceX = 0,
		faceZ = 1,
		anchorX = 0,
		anchorZ = 0,
		damage = 0,
		kills = 0,
		forfeited = false,
		left = false,
		index = #self.teams + 1,
		powerMult = {},
		healthMult = 1,
		elementReadyAt = 0,
		dashReadyAt = 0,
		swapReadyAt = 0,
		cheerUntil = 0, -- wave 6: the Cheer up! boost window and its cooldown
		cheerReadyAt = 0,
		lastWalk = nil,
		lastRun = nil,
		wave = finite(spec.Wave) and floor(spec.Wave) or nil,
		alive = 0,
	}
end

-- anchor positions: duel / ring sides face each other across z; raid teams stand around the boss; dungeon waves at +Z
local function placeAnchor(self, team, spec)
	local hx, hz = self.zone.HalfX, self.zone.HalfZ
	if type(spec.Anchor) == "table" then
		local ax = spec.Anchor.x or spec.Anchor.X or spec.Anchor[1]
		local az = spec.Anchor.z or spec.Anchor.Z or spec.Anchor[2]
		if finite(ax) and finite(az) then
			team.anchorX = max(-hx + 2, min(hx - 2, ax))
			team.anchorZ = max(-hz + 2, min(hz - 2, az))
			return
		end
	end
	if self.mode == "Raid" and team.side == 1 then
		local slots = 8
		local k = (self.raidSlots or 0)
		self.raidSlots = k + 1
		local angle = -pi / 2 + (k % slots) * (2 * pi / slots) + floor(k / slots) * (pi / slots)
		local r = min(hx, hz) - 7
		team.anchorX = cos(angle) * r
		team.anchorZ = sin(angle) * r
		return
	end
	local sideTeams = 0
	for _, t in ipairs(self.teams) do
		if t.side == team.side and t ~= team then
			sideTeams = sideTeams + 1
		end
	end
	team.anchorX = (sideTeams % 2 == 0) and (sideTeams * 5) or (-(sideTeams + 1) * 5)
	team.anchorX = max(-hx + 3, min(hx - 3, team.anchorX))
	if team.side == 1 then
		team.anchorZ = -hz + 5
	else
		team.anchorZ = hz - 5
	end
end

local function meterStart(self, D, team, entry)
	-- bug batch 2 #27: BattleCatalog.MeterStart(entry, npc, wave) picks the range (players 20-50, NPC units 45-75, the
	-- Ring champion and dungeon waves 2+ at 80); one rand draw either way, so seeded fights keep their RNG order
	local bc = catalog()
	if bc and bc.MeterStart then
		local lo, hi = bc.MeterStart(entry, team and team.npc, team and team.wave)
		if finite(lo) and finite(hi) then
			return lo + (hi - lo) * rand(self)
		end
	end
	local ms = D.MeterStart
	if type(ms) == "table" then
		local lo, hi = num(ms[1], 0), num(ms[2], 0)
		return lo + (hi - lo) * rand(self)
	end
	return num(ms, 0)
end

-- a unit's evolution stage (0 | 1 | 2) and how far its abilities reach: the one place the sim reads either; u.evo is UnitStats'
-- cleaned stage (the STORED stage, a hybrid's too); a unit with none (a wild pet) is stage 0
local function stageOf(u)
	return max(0, min(2, floor(num(u.evo, 0))))
end

local function reachOf(u)
	local bc = catalog()
	if bc and type(bc.ReachOf) == "function" then
		return bc.ReachOf(stageOf(u))
	end
	return 1
end

-- the stage its forms read: the stored stage, a hybrid's real one too (BattleCatalog.FormStageOf; the owner's answer of 2026-11-02)
local function formStageOf(u)
	local bc = catalog()
	if bc and type(bc.FormStageOf) == "function" then
		return bc.FormStageOf(u.def, stageOf(u))
	end
	return 0
end

-- the unit's special's twists { [Id] = twist } (BattleCatalog.FormOf), nil at stage 0: the stage-0 path reads nothing new
local function formOf(u)
	local bc = catalog()
	if u.specialKind and bc and type(bc.FormOf) == "function" then
		return bc.FormOf(u.specialKind, formStageOf(u))
	end
	return nil
end

local function formNameOf(u)
	local bc = catalog()
	if u.specialKind and bc and type(bc.FormNameOf) == "function" then
		return bc.FormNameOf(u.petId, u.specialKind, formStageOf(u))
	end
	return nil
end

-- the unit's element attack's twists (BattleCatalog.ElementFormOf), nil at stage 0
local function elementFormOf(u)
	local bc = catalog()
	if bc and type(bc.ElementFormOf) == "function" then
		return bc.ElementFormOf(u.elems[1], formStageOf(u))
	end
	return nil
end

local function unitFromDef(self, team, def, entry, slot, kind)
	local bc = catalog()
	local us = bc and bc.UnitStats and bc.UnitStats(def, entry.Level, entry.Tier, entry)
	if not us then
		return nil
	end
	local D = damageRules()
	local id = #self.units + 1
	if id > MAX_UNITS then
		return nil
	end
	local maxHp = us.MaxHp * (team.healthMult or 1)
	local hit = us.Hit
	local radius = us.Radius
	local scale = 1
	local specialPower = us.SpecialPower
	if kind == "MiniBoss" then
		local mb = (bc and bc.MiniBoss) or { Hp = 3, Power = 1.3, Scale = 1.7 }
		maxHp = maxHp * mb.Hp
		hit = hit * mb.Power
		radius = radius * 1.4
		scale = mb.Scale
	end
	if finite(entry.Handicap) and entry.Handicap > 0 and entry.Handicap < 1 then
		maxHp = maxHp * entry.Handicap
		hit = hit * entry.Handicap
		specialPower = specialPower * entry.Handicap
	end
	-- the Champion Ring's no-heal rule: a player pet may start hurt (its HP share from the round before, >= 1 HP)
	local startHp = maxHp
	local frac = entry.HpFraction
	if team.player and finite(frac) and frac > 0 and frac < 1 then
		startHp = max(1, maxHp * frac)
	end
	local special = type(def.Special) == "table" and def.Special or nil
	local buffKind, buffDef = nil, nil
	if bc and bc.BuffOf then
		buffKind, buffDef = bc.BuffOf(def)
	end
	local u = {
		id = id,
		side = team.side,
		team = team,
		owner = team.owner,
		slot = slot,
		kind = kind,
		def = def,
		key = entry.Key or def.Key or def.Id,
		petId = entry.PetId or def.PetId or def.Id,
		name = def.DisplayName or def.Name or tostring(def.Id),
		species = us.Species,
		elems = us.Elements,
		role = us.Role or "Combat",
		maxHp = maxHp,
		hp = startHp,
		hit = hit,
		interval = us.Interval,
		moveSpeed = us.MoveSpeed,
		walk = us.Walk,
		run = us.Run,
		range = us.Range,
		ranged = us.Ranged,
		radius = radius,
		specialPower = specialPower,
		specialFactor = min(1, num(us.SpecialFactor, 1)),
		specialKind = (special and not entry.NoSpecial) and special.Kind or nil,
		special = special,
		specialBoost = num(us.SpecialBoost, 1),
		buffKind = buffKind,
		buffDef = buffDef,
		powerMult = team.powerMult[slot] or 1,
		level = num(entry.Level, 1),
		tier = entry.Tier or def.Tier or "Normal",
		scale = scale,
		evo = num(us.Evo, 0),
		train = us.Train,
		boost = (finite(us.Boost) and us.Boost > 1) and us.Boost or nil,
		defense = max(0, min(0.9, num(us.Defense, 0))),
		meterRate = max(0.1, num(us.MeterRate, 1)),
		xp = (finite(entry.Xp) and entry.Xp >= 0) and floor(entry.Xp) or nil,
		xpNext = (finite(entry.XpNext) and entry.XpNext >= 0) and floor(entry.XpNext) or nil,
		crowned = entry.Crowned == true or nil,
		wild = entry.Wild == true or nil,
		x = 0,
		z = 0,
		px = 0,
		pz = 0,
		state = S_IDLE,
		target = nil,
		nextAttack = self.t + rand(self) * us.Interval * 0.6,
		retargetAt = 0,
		meter = meterStart(self, D, team, entry),
		shield = 0,
		shieldUntil = 0,
		stunUntil = 0,
		castUntil = 0,
		autoCastAt = nil,
		alive = true,
		gone = false,
		benched = false,
		damage = 0,
		kills = 0,
		-- the fighter kit
		attackUntil = 0,
		dashUntil = 0,
		iframesUntil = 0,
		buffReadyAt = 0,
		-- statuses
		slowUntil = 0,
		slowMult = 1, -- strongest wins (applySlow)
		weakenUntil = 0,
		weakenMult = 1,
		markUntil = 0,
		markMult = 1, -- strongest wins (applyMark)
		burnLeft = 0,
		burnAmount = 0,
		burnNextAt = 0,
		burnFrom = nil,
		-- evolved forms: a stage-2 Shield's burst, a stage-1 Shield's reflection, the unit's own burning ground, Haste's windows
		shieldForm = nil,
		thorns = nil,
		patch = nil,
		quickUntil = 0,
		doubleUntil = 0,
		dmgBuffUntil = 0,
		dmgBuffMult = 1,
		speedBuffUntil = 0,
		speedBuffMult = 1,
		atkSpeedUntil = 0,
		atkSpeedMult = 1,
		takenUntil = 0,
		takenMult = 1,
		regenUntil = 0,
		regenRate = 0,
		chillUntil = 0,
		chillValue = 0,
		leechUntil = 0,
		leechValue = 0,
		-- NPC wind-up
		windAt = nil,
		windTarget = nil,
		threat = nil,
		threatAt = -huge,
	}
	u.formName = formNameOf(u)
	self.units[id] = u
	return u
end

-- NPC pets stand near their anchor, offset per slot toward the floor centre; a player's fighter stands at its anchor
local function placeTeamUnits(self, team)
	local cx, cz = -team.anchorX, -team.anchorZ
	local len = sqrt(cx * cx + cz * cz)
	if len < 0.01 then
		cx, cz, len = 0, 1, 1
	end
	cx, cz = cx / len, cz / len
	local px, pz = -cz, cx
	local n = #team.units
	for i, u in ipairs(team.units) do
		local spread = team.player and 0 or (i - (n + 1) / 2) * 2.6
		u.x = team.anchorX + cx * 3 + px * spread
		u.z = team.anchorZ + cz * 3 + pz * spread
		clampToFloor(self, u)
		u.px, u.pz = u.x, u.z
	end
	team.faceX, team.faceZ = cx, cz
end

-- an area on an event: the number the sim used. An unevolved pet's stays off the wire: the client knows it (the catalog's
-- number, a ranged fighter's own range), and a full raid's traffic budget is tight
local function areaField(reach, used)
	if reach ~= 1 then
		return r1(used)
	end
	return nil
end

local function unitInfo(u, t)
	local info = {
		id = u.id,
		side = u.side,
		owner = u.owner,
		slot = u.slot,
		kind = u.kind,
		key = u.key,
		petId = u.petId,
		name = u.name,
		species = u.species,
		look = type(u.def) == "table" and u.def.Look or nil,
		element = u.elems[1],
		elements = u.elems,
		maxHp = floor(u.maxHp + 0.5),
		level = u.level,
		tier = u.tier,
		scale = u.scale,
		ranged = u.ranged,
		range = u.range,
		radius = u.radius,
		role = (u.role == "Support") and "Support" or "Fighter",
		walk = u.walk,
		run = u.run,
	}
	if u.boss then
		info.boss = u.boss.Id
	elseif u.kind == "MiniBoss" then
		info.boss = true
	end
	info.evo = u.evo or 0
	local reach = reachOf(u)
	if reach ~= 1 then
		info.reach = reach
	end
	if u.xp then
		info.xp = u.xp
		info.xpNext = u.xpNext
	end
	if u.crowned then
		info.crowned = true
	end
	if u.wild then
		info.wild = true
	end
	if t and u.arriveUntil and t < u.arriveUntil then
		info.Arrive = r1(u.arriveUntil - t)
	end
	if u.team and u.team.player and u.slot and u.slot >= 2 then
		info.bench = u.slot
	end
	if u.special then
		info.special = { Id = u.special.Id, Name = u.formName or u.special.Name, Base = u.special.Name, Kind = u.special.Kind, Color = u.special.Color, Form = formStageOf(u) }
	end
	if u.buffDef then
		info.buff = { Kind = u.buffKind, Name = u.buffDef.Name, Seconds = u.buffDef.Seconds, Value = u.buffDef.Value, Cooldown = u.buffDef.Cooldown }
	end
	local bc = catalog()
	local ea = bc and type(bc.ElementAttacks) == "table" and u.elems[1] and bc.ElementAttacks[u.elems[1]]
	if ea then
		local form = elementFormOf(u)
		info.elementAttack = { Name = form and form.Name or ea.Name, Shape = ea.Shape, Element = u.elems[1] }
	end
	return info
end

-- the lives of a team = its living pets (fighter + bench; NPC: every pet still up)
local function teamLives(team)
	local n = 0
	for _, u in ipairs(team.units) do
		if u.alive and not u.gone then
			n = n + 1
		end
	end
	return n
end

local function onFloor(u)
	return u.alive and not u.gone and not u.benched
end

-- dungeon fixes (3): the entrance of an enemy added after the start: no acting, no hits (i-frames), not the nearest target
local function arriveSeconds()
	local s = num(fighterRules().ArriveSeconds, 1.2)
	return max(0, min(3, s))
end

local function markArrival(self, u, seconds)
	if seconds > 0 then
		u.arriveUntil = self.t + seconds
		if (u.iframesUntil or 0) < u.arriveUntil then
			u.iframesUntil = u.arriveUntil
		end
		u.nextAttack = max(u.nextAttack, u.arriveUntil)
	end
end

local function arriving(self, u)
	return u.arriveUntil ~= nil and self.t < u.arriveUntil
end

-- a living enemy on the floor that an area already placed can hit (not arriving)
local function hittable(self, e)
	return e.alive and not e.gone and not e.benched and not (e.arriveUntil and self.t < e.arriveUntil)
end

-- evolved forms: a retreated pet is no target while someone else fights (self.anyEngaged, set at the top of every step)
local function hiddenByRetreat(self, e)
	return e.team.retreat ~= nil and self.anyEngaged == true
end

-- a living enemy on the floor that may be chosen as a target (not arriving, not back while others fight)
local function targetable(self, e)
	return hittable(self, e) and not hiddenByRetreat(self, e)
end

-- Adds a team (also used by new / SpawnEnemies). Returns the unit infos, or nil + reason.
function BattleSim:AddTeam(spec)
	if self.result then
		return nil, "Finished"
	end
	if type(spec) ~= "table" or spec.Owner == nil then
		return nil, "BadTeam"
	end
	if self.teamByOwner[spec.Owner] then
		return nil, "DuplicateOwner"
	end
	local side = spec.Side
	if side ~= 1 and side ~= 2 then
		side = 1
	end
	local bc = catalog()
	local player = spec.Npc ~= true
	local maxSize = player and ((bc and bc.TeamSize) or 3) or 12
	local pets = type(spec.Pets) == "table" and spec.Pets or {}
	local defs, entries = {}, {}
	for i = 1, min(#pets, maxSize) do
		local entry = pets[i]
		local def = resolveDef(entry)
		if def then
			defs[#defs + 1] = def
			entries[#entries + 1] = entry
		end
	end
	if #defs == 0 then
		return nil, "NoPets"
	end
	local team = newTeamRecord(self, spec, side)
	local synPower = {}
	if bc and bc.SynergyBonus then
		local syn = bc.SynergyBonus(defs)
		team.healthMult = syn.HealthMult or 1
		for i = 1, #defs do
			synPower[i] = syn.PowerMult[i] or 1
		end
	end
	self.teams[#self.teams + 1] = team
	self.teamByOwner[spec.Owner] = team
	placeAnchor(self, team, spec)
	local infos = {}
	for i, def in ipairs(defs) do
		local entry = entries[i]
		local slot = i
		if player then
			slot = i -- a player's slots are the list order: 1 = the fighter, 2-3 the bench
		elseif finite(entry.Slot) and entry.Slot >= 1 and entry.Slot <= maxSize and not team.bySlot[floor(entry.Slot)] then
			slot = floor(entry.Slot)
		end
		team.powerMult[slot] = synPower[i] or 1
		local kind = entry.Boss and "MiniBoss" or "Pet"
		local u = unitFromDef(self, team, def, entry, slot, kind)
		if u then
			team.units[#team.units + 1] = u
			team.bySlot[slot] = u
			infos[#infos + 1] = u
			if player then
				if i == 1 then
					team.fighter = u
				else
					u.benched = true
					u.state = S_BENCHED
				end
			end
		end
	end
	if #team.units == 0 then
		self.teams[#self.teams] = nil
		self.teamByOwner[spec.Owner] = nil
		return nil, "NoPets"
	end
	placeTeamUnits(self, team)
	if player and team.fighter then
		for _, u in ipairs(team.units) do
			u.x, u.z, u.px, u.pz = team.fighter.x, team.fighter.z, team.fighter.x, team.fighter.z
		end
	end
	if bc and bc.ExpectedDps then
		team.dps = player and bc.ExpectedDps({ Pets = entries }) or 0
	else
		team.dps = 0
	end
	-- an enemy team added after the start (waves, escorts, mid-fight adds) arrives first
	local arrive = 0
	if self.started and side == 2 and not player then
		arrive = arriveSeconds()
		for _, u in ipairs(infos) do
			markArrival(self, u, arrive)
		end
	end
	local out = {}
	for i, u in ipairs(infos) do
		out[i] = unitInfo(u, self.t)
	end
	if team.wave then
		self.waveCount = max(self.waveCount or 0, team.wave)
	end
	if self.started then
		local boss = self.boss
		if boss and boss.alive and player and side == 1 then
			local before = boss.maxHp
			boss.maxHp = self:_bossMaxHp()
			boss.hp = max(1, boss.hp + (boss.maxHp - before))
		end
		self:_refreshRaidScale()
		if team.wave then
			local left = 0
			for _, v in ipairs(self.units) do
				if v.side == 2 and onFloor(v) then
					left = left + 1
				end
			end
			-- a dungeon room's clock does not run down while its new wave cannot be hit
			if self.mode == "Dungeon" and arrive > 0 then
				self.timeLimit = self.timeLimit + arrive
			end
			self.pending[#self.pending + 1] = { type = EV.Wave, index = team.wave, units = out, left = left, owner = spec.Owner, timeLimit = self.timeLimit }
		else
			self.pending[#self.pending + 1] = { type = EV.Spawn, units = out, owner = spec.Owner }
		end
	end
	return out
end

-- Dungeon / Raid: an enemy wave as a side-2 Npc Auto team
function BattleSim:SpawnEnemies(list, opts)
	opts = type(opts) == "table" and opts or {}
	local index = finite(opts.Wave) and floor(opts.Wave) or ((self.waveCount or 0) + 1)
	local anchor = opts.Anchor
	if type(anchor) ~= "table" then
		anchor = { 0, self.zone.HalfZ - 5 }
	end
	local pets = type(list) == "table" and (list.Pets or list) or {}
	local owner = opts.Owner or ("wave:" .. index)
	return self:AddTeam({ Owner = owner, Side = 2, Npc = true, Auto = true, Name = opts.Name or ("Wave " .. index), Anchor = anchor, Wave = index, Pets = pets })
end

-- BattleCatalog.BossHp over the player teams still in the raid
function BattleSim:_bossMaxHp()
	local bc = catalog()
	local specs = {}
	for _, t in ipairs(self.teams) do
		if t.side == 1 and t.player and not t.left then
			local pets = {}
			for j, u in ipairs(t.units) do
				pets[j] = { Def = u.def, Level = u.level, Tier = u.tier, Evo = u.evo, Train = u.train, Boost = u.boost }
			end
			specs[#specs + 1] = { Pets = pets }
		end
	end
	if bc and bc.BossHp then
		local hp = bc.BossHp(self.bossId, specs, self.raidTier)
		if finite(hp) and hp > 0 then
			return hp
		end
	end
	return 1000
end

function BattleSim:_playerTeams()
	local n = 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and team.player and not team.left then
			n = n + 1
		end
	end
	return n
end

function BattleSim:_effectiveTeams(excluding)
	local dpsList = {}
	for _, team in ipairs(self.teams) do
		if team.side == 1 and team.player and not team.left and team ~= excluding then
			dpsList[#dpsList + 1] = num(team.dps, 0)
		end
	end
	local bc = catalog()
	if bc and bc.WeightedTeams then
		return bc.WeightedTeams(dpsList)
	end
	return #dpsList
end

local bossBasis

-- The boss's damage yardstick: the average FIGHTER MaxHp (and level) over the player teams
function BattleSim:_refreshRaidScale()
	local total, n, levels = 0, 0, 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 and not team.left then
			for _, u in ipairs(team.units) do
				if (u.kind == "Pet" or u.kind == "MiniBoss") and (not team.player or u == team.fighter) then
					total = total + u.maxHp
					levels = levels + (u.level or 1)
					n = n + 1
				end
			end
		end
	end
	if n > 0 then
		self.avgPetHp = total / n
		self.avgPetLevel = floor(levels / n + 0.5)
	end
	if not self.avgPetHp or self.avgPetHp <= 0 then
		self.avgPetHp = 150
		self.avgPetLevel = 1
	end
	self.playerTeamCount = self:_effectiveTeams()
	for _, u in ipairs(self.units) do
		if u.kind == "Minion" and u.alive then
			local rules = (catalog() and catalog().BossRules) or {}
			u.hit = num(rules.MinionDamage, 0.05) * bossBasis(self, { maxHp = self.avgPetHp }) * (self.boss and self.boss.tierHit or 1)
		end
	end
end

local function makeBoss(self, bossId)
	local bc = catalog()
	local def = bc and type(bc.Bosses) == "table" and bc.Bosses[bossId]
	if not def then
		return nil, "UnknownBoss"
	end
	local id = #self.units + 1
	local team = newTeamRecord(self, { Owner = "boss", Name = def.Name, Npc = true, Auto = true }, 2)
	team.dps = 0
	self.teams[#self.teams + 1] = team
	self.teamByOwner["boss"] = team
	self.bossId = bossId
	local tier = bc.RaidTierById(self.raidTier)
	local hp = self:_bossMaxHp()
	local attacks = {}
	for i, a in ipairs(def.Attacks or {}) do
		attacks[i] = { def = a, nextAt = num(a.First, 6 + i * 6) }
	end
	local u = {
		id = id,
		side = 2,
		team = team,
		owner = "boss",
		slot = 1,
		kind = "Boss",
		def = def,
		boss = def,
		key = bossId,
		petId = nil,
		name = def.Name,
		species = nil,
		elems = { def.Element },
		role = "Combat",
		maxHp = hp,
		hp = hp,
		hit = 0,
		interval = num(def.Basic and def.Basic.Interval, 2.5),
		moveSpeed = 0,
		range = num(def.Basic and def.Basic.Range, 14),
		ranged = true,
		radius = num(def.Radius, 7) * tier.Scale,
		specialPower = 0,
		special = nil,
		powerMult = 1,
		level = 1,
		tier = "Boss",
		scale = num(def.Scale, 1),
		x = 0,
		z = 0,
		px = 0,
		pz = 0,
		state = S_IDLE,
		target = nil,
		nextAttack = 3,
		retargetAt = 0,
		meter = 0,
		shield = 0,
		shieldUntil = 0,
		stunUntil = 0,
		castUntil = 0,
		alive = true,
		gone = false,
		benched = false,
		damage = 0,
		kills = 0,
		attacks = attacks,
		lethal = def.Lethal and { def = def.Lethal, nextAt = huge } or nil, -- cast only while enraged (bossStep)
		wavesDone = {},
		enraged = false,
		tierId = tier.Id,
		tierHit = tier.Hit,
		groupMin = tier.GroupMin, -- nil = BossRules.DamageGroup.Min
		soloHit = tier.SoloHit, -- nil = the group line all the way down to one team
		damageMult = tier.Hit,
		cooldownMult = 1,
		attackUntil = 0,
		dashUntil = 0,
		iframesUntil = 0,
		buffReadyAt = 0,
		slowUntil = 0,
		slowMult = 1,
		weakenUntil = 0,
		weakenMult = 1,
		markUntil = 0,
		markMult = 1,
		burnLeft = 0,
		burnAmount = 0,
		burnNextAt = 0,
		shieldForm = nil,
		thorns = nil,
		patch = nil,
		quickUntil = 0,
		doubleUntil = 0,
		dmgBuffUntil = 0,
		dmgBuffMult = 1,
		speedBuffUntil = 0,
		speedBuffMult = 1,
		atkSpeedUntil = 0,
		atkSpeedMult = 1,
		takenUntil = 0,
		takenMult = 1,
		regenUntil = 0,
		regenRate = 0,
		chillUntil = 0,
		chillValue = 0,
		leechUntil = 0,
		leechValue = 0,
		threatAt = -huge,
	}
	self.units[id] = u
	team.units[1] = u
	team.bySlot[1] = u
	self.boss = u
	return u
end

function BattleSim.new(setup)
	if type(setup) ~= "table" then
		return nil, "BadSetup"
	end
	local mode = setup.Mode
	if not MODE_OK[mode] then
		mode = (setup.Boss ~= nil and "Raid") or "Duel"
	end
	local bc = catalog()
	local self = setmetatable({}, BattleSim)
	self.id = setup.Id
	self.mode = mode
	self.seed = tonumber(setup.Seed) or 1
	self.rngState = seedState(self.seed)
	self.t = 0
	self.stepCount = 0
	self.raidTier = (bc and bc.RaidTierById and bc.RaidTierById(setup.RaidTier) and setup.RaidTier) or "High"
	self.zone = parseZone(mode, setup.Zone)
	self.teams = {}
	self.teamByOwner = {}
	self.units = {}
	self.telegraphs = {}
	self.zones = {}
	self.delayed = {} -- the evolved twists' delayed hits (self.pending holds a step's events)
	self.pending = {}
	self.order = {}
	self.order2 = {}
	self.result = nil
	self.started = false
	self.specialsEnabled = setup.Specials ~= false
	self.elemCache = {}
	self.nextTelegraphId = 1
	self.avgPetHp = 150
	self.avgPetLevel = 1
	self.waveCount = 0
	local limits = (bc and bc.TimeLimits) or { Duel = 120, Raid = 330, Ring = 90, Dungeon = 120 }
	self.timeLimit = num(setup.TimeLimit, limits[mode] or 120)
	if mode == "Ring" and finite(setup.Round) then
		self.round = floor(setup.Round)
	end
	local mh = damageRules().MaxHit
	if type(mh) == "table" and type(mh.Modes) == "table" and mh.Modes[mode] and finite(mh.Share) and mh.Share > 0 then
		self.maxHitShare = mh.Share
	end
	-- (feel-balance review) the mode's pace: every direct hit x Damage.ModeDamage[mode] (nil = x1) in a fight of player teams
	-- only (the cause is both sides dashing out of the real casts; an NPC never dodges one, so a fight with an NPC team keeps x1)
	local md = damageRules().ModeDamage
	if type(md) == "table" and finite(md[mode]) and md[mode] > 0 and md[mode] ~= 1 then
		local players = type(setup.Teams) == "table" and #setup.Teams > 0
		for _, spec in ipairs(type(setup.Teams) == "table" and setup.Teams or {}) do
			if type(spec) ~= "table" or spec.Npc then
				players = false
			end
		end
		if players then
			self.modeDamage = md[mode]
		end
	end
	local teams = type(setup.Teams) == "table" and setup.Teams or {}
	for _, spec in ipairs(teams) do
		if type(spec) == "table" then
			local infos, reason = self:AddTeam(spec)
			if not infos and reason == "DuplicateOwner" then
				return nil, reason
			end
		end
	end
	if setup.Boss ~= nil then
		local boss, reason = makeBoss(self, setup.Boss)
		if not boss then
			return nil, reason
		end
		if setup.TimeLimit == nil and finite(boss.boss.TimeLimit) then
			self.timeLimit = boss.boss.TimeLimit
		end
	end
	local side1, side2 = 0, 0
	for _, team in ipairs(self.teams) do
		if team.side == 1 then
			side1 = side1 + #team.units
		else
			side2 = side2 + #team.units
		end
	end
	if side1 == 0 then
		return nil, "NoTeam"
	end
	if side2 == 0 and mode ~= "Dungeon" then
		return nil, "NoOpponent"
	end
	self:_refreshRaidScale()
	self.started = true
	return self
end

----------------------------------------------------------------------
-- Read-only accessors
----------------------------------------------------------------------
function BattleSim:Time()
	return self.t
end

function BattleSim:IsFinished()
	return self.result ~= nil
end

function BattleSim:Result()
	return self.result
end

function BattleSim:Owners()
	local out = {}
	for _, team in ipairs(self.teams) do
		if team.player and not team.left then
			out[#out + 1] = team.owner
		end
	end
	return out
end

function BattleSim:StaticUnits()
	local out = {}
	for _, u in ipairs(self.units) do
		if not u.gone then
			out[#out + 1] = unitInfo(u, self.t)
		end
	end
	return out
end

function BattleSim:Describe()
	local sides = { [1] = {}, [2] = {} }
	for _, team in ipairs(self.teams) do
		if not team.left then
			local list = sides[team.side]
			list[#list + 1] = team.owner
		end
	end
	return {
		BattleId = self.id,
		Mode = self.mode,
		Seed = self.seed,
		Zone = { X = self.zone.X, Z = self.zone.Z },
		TimeLimit = self.timeLimit,
		BossId = self.bossId,
		Round = self.round,
		Sides = sides,
		Units = self:StaticUnits(),
	}
end

-- the fighter's current legal speeds (walk, run) with Haste / Slow applied; trainer = the speeds sent to the player's
-- character (SpeedOf / TeamOf / the Speed event), which a raid floors at the normal walk / run (the pet keeps its own)
local function legalSpeeds(self, team, trainer)
	local f = team.fighter
	if not f then
		return 0, 0
	end
	local mult = 1
	if self.t < f.speedBuffUntil then
		mult = mult * f.speedBuffMult
	end
	if self.t < f.slowUntil then
		mult = mult * f.slowMult
	end
	local walk, run = num(f.walk, 12), num(f.run, 15.6)
	if trainer and self.mode == "Raid" then
		-- bug batch 6 (owner, Studio): a raider moves at least at the normal walk / run, so the fight area's countdown can be beaten
		-- (the pet engages on its own and keeps its own speed: the raid's balance does not move)
		local F = catalog() and catalog().Fighter or {}
		walk = max(walk, num(F.RaidWalkMin, 16))
		run = max(run, num(F.RaidRunMin, 27))
	end
	return walk * mult, run * mult
end

function BattleSim:SpeedOf(owner)
	local team = self.teamByOwner[owner]
	if not team or not team.fighter then
		return nil
	end
	local walk, run = legalSpeeds(self, team, true)
	return { Walk = walk, Run = run }
end

function BattleSim:TeamOf(owner)
	local team = self.teamByOwner[owner]
	if not team then
		return nil
	end
	local t = self.t
	local units = {}
	local bench = {}
	local buffs = {}
	for i, u in ipairs(team.units) do
		units[i] = { id = u.id, slot = u.slot, hp = u.hp, maxHp = u.maxHp, meter = u.meter, state = u.state, alive = u.alive, bench = u.benched or nil }
		if team.player and u ~= team.fighter then
			bench[#bench + 1] = u.id
			buffs[u.slot] = max(0, u.buffReadyAt - t)
		end
	end
	local walk, run = legalSpeeds(self, team, true)
	return {
		Owner = team.owner,
		Side = team.side,
		Fighter = team.fighter and team.fighter.id or nil,
		Bench = bench,
		Lives = teamLives(team),
		Speed = { Walk = walk, Run = run },
		Cooldowns = {
			Element = max(0, team.elementReadyAt - t),
			Dash = max(0, team.dashReadyAt - t),
			Swap = max(0, team.swapReadyAt - t),
			Cheer = max(0, team.cheerReadyAt - t),
			Retreat = max(0, team.retreatReadyAt - t),
			Buff = buffs,
		},
		Cheering = t < team.cheerUntil,
		Retreated = team.retreat ~= nil,
		Lock = team.lock and team.lock.id or nil,
		Engaged = team.engage and team.engage.target.id or nil,
		Damage = team.damage,
		Kills = team.kills,
		Left = team.left,
		Forfeited = team.forfeited,
		Units = units,
	}
end

function BattleSim:BossStatus()
	local b = self.boss
	if not b then
		return nil
	end
	local lethal = false
	for _, tele in ipairs(self.telegraphs) do
		if tele.boss == b and tele.lethal then
			lethal = true
			break
		end
	end
	return {
		BossId = self.bossId,
		Tier = b.tierId,
		Name = b.name,
		Hp = max(0, floor(b.hp + 0.5)),
		MaxHp = floor(b.maxHp + 0.5),
		Enraged = b.enraged,
		Lethal = lethal,
		EndsIn = max(0, self.timeLimit - self.t),
		Players = self:_playerTeams(),
	}
end

-- the side-2 boss's HP share (the raid boss, else a side-2 unit in the mini-boss form), nil without one
function BattleSim:BossHp()
	local b = self.boss
	if not b then
		for _, u in ipairs(self.units) do
			if u.side == 2 and u.kind == "MiniBoss" and not u.gone then
				b = u
				break
			end
		end
	end
	if not b or b.maxHp <= 0 then
		return nil
	end
	return max(0, min(1, b.hp / b.maxHp))
end

function BattleSim:LivingEnemies()
	local n = 0
	for _, u in ipairs(self.units) do
		if u.side == 2 and onFloor(u) then
			n = n + 1
		end
	end
	return n
end

function BattleSim:SetAnchor(owner, x, z)
	local team = self.teamByOwner[owner]
	if not team or not finite(x) or not finite(z) then
		return false
	end
	local hx, hz = self.zone.HalfX, self.zone.HalfZ
	team.anchorX = max(-hx + 2, min(hx - 2, x))
	team.anchorZ = max(-hz + 2, min(hz - 2, z))
	return true
end

----------------------------------------------------------------------
-- Snapshot
----------------------------------------------------------------------
local function unitLives(u)
	if u.team and u.team.player and u == u.team.fighter then
		return min(3, teamLives(u.team))
	end
	return 0
end

local function isWinding(self, u)
	return u.windAt ~= nil and self.t < u.windAt
end

function BattleSim:Snapshot()
	local units = {}
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if not u.gone then
			local hp = 0
			if u.alive then
				hp = ceil(u.hp - 0.0001)
				if hp < 1 then
					hp = 1
				end
			end
			local s = { x = r1(u.x), z = r1(u.z), hp = hp, state = u.state, meter = floor(u.meter + 0.5), lives = unitLives(u) }
			if u.bdx then
				-- (feel-balance) the body point while it strikes (only while it differs from the rest spot)
				local bx, bz = r1(u.x + u.bdx), r1(u.z + u.bdz)
				if bx ~= s.x or bz ~= s.z then
					s.bx, s.bz = bx, bz
				end
			end
			local tgt = u.target
			if tgt and tgt.alive and not tgt.gone then
				s.target = tgt.id
			end
			if u.shield > 0 then
				s.shield = floor(u.shield + 0.5)
			end
			if isWinding(self, u) then
				s.windup = true
			end
			units[u.id] = s
		end
	end
	return { BattleId = self.id, T = r1(self.t), Units = units }
end

function BattleSim:SnapshotDelta(last)
	if type(last) ~= "table" then
		last = {}
	end
	local U = {}
	local n = 0
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if not u.gone then
			local hp = 0
			if u.alive then
				hp = ceil(u.hp - 0.0001)
				if hp < 1 then
					hp = 1
				end
			end
			local x, z = r1(u.x), r1(u.z)
			local meter = floor(u.meter + 0.5)
			local shield = u.shield > 0 and floor(u.shield + 0.5) or 0
			local tgt = u.target
			local target = (tgt and tgt.alive and not tgt.gone) and tgt.id or 0
			local lives = unitLives(u)
			local windup = isWinding(self, u) and 1 or 0
			local l = last[u.id]
			local mask = 0
			if not l then
				l = {}
				last[u.id] = l
				mask = MASK_HP + MASK_METER + MASK_SHIELD + MASK_TARGET
			else
				if l.hp ~= hp then
					mask = mask + MASK_HP
				end
				if l.meter ~= meter then
					mask = mask + MASK_METER
				end
				if l.shield ~= shield then
					mask = mask + MASK_SHIELD
				end
				if (l.target or 0) ~= target then
					mask = mask + MASK_TARGET
				end
			end
			if mask > 0 or l.x ~= x or l.z ~= z or l.state ~= u.state or (l.lives or 0) ~= lives or ((l.windup and 1 or 0) ~= windup) then
				l.x, l.z, l.hp, l.state, l.meter, l.shield, l.lives = x, z, hp, u.state, meter, shield, lives
				l.windup = (windup == 1) or nil
				l.target = (target ~= 0) and target or nil
				local xi = floor((max(-POS_OFFSET, min(POS_OFFSET, x)) + POS_OFFSET) * POS_STEPS + 0.5)
				local zi = floor((max(-POS_OFFSET, min(POS_OFFSET, z)) + POS_OFFSET) * POS_STEPS + 0.5)
				U[n + 1] = u.id * CODE_ID + lives * CODE_LIVES + windup * CODE_WINDUP + mask * 8 + u.state
				U[n + 2] = xi * POS_BASE + zi
				n = n + 2
				if mask % (MASK_HP * 2) >= MASK_HP then
					n = n + 1
					U[n] = hp
				end
				if mask % (MASK_METER * 2) >= MASK_METER then
					n = n + 1
					U[n] = meter
				end
				if mask % (MASK_SHIELD * 2) >= MASK_SHIELD then
					n = n + 1
					U[n] = shield
				end
				if mask % (MASK_TARGET * 2) >= MASK_TARGET then
					n = n + 1
					U[n] = target
				end
			end
		end
	end
	return { BattleId = self.id, T = r1(self.t), U = U }
end

function BattleSim.DecodeSnapshot(payload, previous)
	local out = {}
	if type(previous) == "table" then
		for id, rec in pairs(previous) do
			out[id] = rec
		end
	end
	local U = type(payload) == "table" and payload.U
	if type(U) ~= "table" then
		return out
	end
	local i = 1
	local n = #U
	while i + 1 <= n do
		local code, pos = U[i], U[i + 1]
		if not finite(code) or not finite(pos) or code ~= floor(code) or code < CODE_ID or pos ~= floor(pos) or pos < 0 then
			break
		end
		local state = code % 8
		local mask = floor(code / 8) % 16
		local windup = floor(code / CODE_WINDUP) % 2
		local lives = floor(code / CODE_LIVES) % 4
		local id = floor(code / CODE_ID)
		local xi = floor(pos / POS_BASE)
		local zi = pos % POS_BASE
		local prev = out[id]
		local rec = {
			x = xi / POS_STEPS - POS_OFFSET,
			z = zi / POS_STEPS - POS_OFFSET,
			state = state,
			lives = lives,
			windup = (windup == 1) or nil,
			hp = prev and prev.hp or nil,
			meter = prev and prev.meter or 0,
			shield = prev and prev.shield or 0,
			target = prev and prev.target or nil,
		}
		i = i + 2
		if mask % (MASK_HP * 2) >= MASK_HP then
			rec.hp = tonumber(U[i])
			i = i + 1
		end
		if mask % (MASK_METER * 2) >= MASK_METER then
			rec.meter = tonumber(U[i]) or 0
			i = i + 1
		end
		if mask % (MASK_SHIELD * 2) >= MASK_SHIELD then
			rec.shield = tonumber(U[i]) or 0
			i = i + 1
		end
		if mask % (MASK_TARGET * 2) >= MASK_TARGET then
			local target = tonumber(U[i]) or 0
			rec.target = (target > 0) and target or nil
			i = i + 1
		end
		if i > n + 1 then
			break
		end
		out[id] = rec
	end
	return out
end

----------------------------------------------------------------------
-- Damage
----------------------------------------------------------------------
local function elemMult(self, attacker, victim)
	local key = attacker.id * 256 + victim.id
	local m = self.elemCache[key]
	if m == nil then
		m = 1
		local pc = petCatalog()
		if pc and pc.ElementMultiplier and #attacker.elems > 0 and #victim.elems > 0 then
			local ok, result = pcall(pc.ElementMultiplier, attacker.elems, victim.elems)
			if ok and finite(result) then
				m = result
			end
		end
		self.elemCache[key] = m
	end
	return m
end

local swapIn -- forward (the auto-swap on a fighter's KO)

-- the engage rule (bug #22, wave 6): back to FOLLOW; `events` nil = no event (RemoveTeam: the Leave event says it all)
local function dropEngage(self, team, events)
	local e = team.engage
	if not e then
		return
	end
	team.engage = nil
	if events then
		events[#events + 1] = { type = EV.Engage, owner = team.owner, unit = e.unit, on = false }
	end
end

local function knockOut(self, u, by, events, forfeit)
	u.alive = false
	u.hp = 0
	u.state = S_DOWN
	u.target = nil
	u.shield = 0
	u.shieldForm = nil -- a KO'd unit never bursts
	u.thorns = nil
	u.windAt = nil
	u.windTarget = nil
	u.burnLeft = 0
	if u.sTo then
		Strike.close(u)
	end
	u.meterCarry = nil
	if damageRules().KoMeterLoss then
		u.meter = 0
	end
	if by and by.alive then
		by.kills = by.kills + 1
		by.team.kills = by.team.kills + 1
	end
	local ev = { type = EV.KO, unit = u.id, by = by and by.id or nil }
	if forfeit then
		ev.forfeit = true
	end
	events[#events + 1] = ev
	local team = u.team
	if team.player and u == team.fighter then
		dropEngage(self, team, events)
	end
	-- a downed fighter is replaced by the next alive helper at once (3 lives)
	if team.player and u == team.fighter and not forfeit and fighterRules().DownAutoSwap ~= false then
		for _, v in ipairs(team.units) do
			if v.alive and not v.gone and v.benched then
				swapIn(self, team, v, events, true)
				break
			end
		end
	end
	-- the last enemy of a spawned wave fell
	if team.wave and not team.left then
		local left = 0
		for _, v in ipairs(team.units) do
			if v.alive and not v.gone then
				left = left + 1
			end
		end
		if left == 0 then
			events[#events + 1] = { type = EV.EnemiesDown, wave = team.wave, owner = team.owner }
		end
	end
end

-- the attacker's damage multiplier from its buffs / statuses (Rally / Blaze, Weaken; wave 6: the trainer's Cheer up!)
local function attackMult(self, attacker)
	local m = 1
	local team = attacker.team
	if team and team.player and attacker == team.fighter and self.t < (team.cheerUntil or 0) then
		m = m * (1 + num(fighterRules().CheerBoost, 0.05))
	end
	if attacker.dmgBuffUntil and self.t < attacker.dmgBuffUntil then
		m = m * attacker.dmgBuffMult
	end
	if attacker.weakenUntil and self.t < attacker.weakenUntil then
		m = m * attacker.weakenMult
	end
	return m
end

-- a slow on `e` (bosses keep their immunity): the strongest active one wins, the later end stands -> applied?
local function applySlow(self, e, mult, seconds)
	if e.kind == "Boss" then
		return false
	end
	local t = self.t
	e.slowMult = min(mult, (t < e.slowUntil) and e.slowMult or 1)
	e.slowUntil = max(e.slowUntil, t + seconds)
	return true
end

-- Mark / Ice Snare, one status: the strongest active one wins, no stacking. Not in a boss's immunities
local function applyMark(self, e, mult, seconds)
	local t = self.t
	e.markMult = max(mult, (t < e.markUntil) and e.markMult or 1)
	e.markUntil = max(e.markUntil, t + seconds)
end

local function inIFrames(self, u)
	return self.t < (u.iframesUntil or 0)
end

local shieldBreak -- forward

-- (feel-balance Task 2) a meter gain of `gain` (capped at `top`): while a real cast charges (castEntry, the meter sits
-- full) with Damage.SpecialCarry it is kept in u.meterCarry and added after the fire (fireCast); else it fills the meter
function Strike.meter(u, gain, top)
	if u.castEntry and damageRules().SpecialCarry == true then
		u.meterCarry = min(top, (u.meterCarry or 0) + gain)
	else
		u.meter = min(top, u.meter + gain)
	end
end

-- Applies `amount` of damage from `attacker` (may be nil for zones) to `victim`. Returns the damage dealt (after
-- shields). `extra` fields are copied into the Hit event; extra == nil marks a plain attack (crits, meter, chill, leech).
local function applyDamage(self, attacker, victim, amount, events, extra, noVariance)
	if not victim.alive or victim.gone or amount <= 0 then
		return 0
	end
	if victim.arriveUntil and self.t < victim.arriveUntil then
		-- an arriving enemy cannot be hit by any path (specials, zones, burns); no event (the client draws its entrance)
		return 0
	end
	local D = damageRules()
	local F = fighterRules()
	local dmg = amount
	local mult = 1
	if attacker then
		mult = elemMult(self, attacker, victim)
		dmg = dmg * mult * (attacker.powerMult or 1) * attackMult(self, attacker)
	end
	local crit = false
	if not noVariance then
		local v = D.Variance
		dmg = dmg * (1 - v + 2 * v * rand(self))
		local critRules = D.Crit
		if attacker and attacker.kind ~= "Boss" and extra == nil and type(critRules) == "table" and rand(self) < num(critRules.Chance, 0) then
			dmg = dmg * num(critRules.Mult, 1.5)
			crit = true
		end
	end
	local defense = victim.defense
	if defense and defense > 0 then
		dmg = dmg * (1 - defense)
	end
	if victim.takenUntil and self.t < victim.takenUntil then
		dmg = dmg * victim.takenMult
	end
	if victim.markUntil and self.t < victim.markUntil then
		dmg = dmg * victim.markMult
	end
	if self.modeDamage and not (extra and (extra.burn or extra.thorns)) then
		dmg = dmg * self.modeDamage -- (a burn tick / thorns come from a hit already paced: not twice)
	end
	local cap = self.maxHitShare
	if cap and attacker and attacker.kind ~= "Boss" and dmg > victim.maxHp * cap then
		dmg = victim.maxHp * cap
	end
	if dmg < D.MinHit then
		dmg = D.MinHit
	end
	local absorbed = 0
	if victim.shield > 0 then
		absorbed = min(victim.shield, dmg)
		victim.shield = victim.shield - absorbed
		dmg = dmg - absorbed
	end
	victim.hp = victim.hp - dmg
	local ev = { type = EV.Hit, from = attacker and attacker.id or nil, to = victim.id, dmg = floor(dmg + 0.5) }
	if attacker then
		attacker.damage = attacker.damage + dmg
		attacker.team.damage = attacker.team.damage + dmg
		local isFighter = attacker.team.player and attacker == attacker.team.fighter
		if attacker.kind ~= "Boss" and attacker.alive and extra == nil then
			local gain = isFighter and num(F.MeterOnHit, 4) or num(D.MeterOnHit, 4)
			local top = isFighter and num(F.SpecialMeterMax, 100) or num(D.MeterMax, 100)
			Strike.meter(attacker, gain * (attacker.meterRate or 1), top)
			-- Chill: the fighter's plain hits slow its enemies
			if attacker.chillUntil and self.t < attacker.chillUntil and applySlow(self, victim, num(D.Slow, 0.6), 2) then
				ev.slow = true
			end
		end
		-- Leech / Thorn Lash lifesteal
		local leech = 0
		if attacker.leechUntil and self.t < attacker.leechUntil then
			leech = attacker.leechValue
		end
		if extra and finite(extra.leech) then
			leech = leech + extra.leech
		end
		if leech > 0 and attacker.alive and attacker.hp < attacker.maxHp then
			local heal = min(dmg * leech, attacker.maxHp - attacker.hp)
			attacker.hp = attacker.hp + heal
			ev.leech = floor(heal + 0.5)
		end
		if attacker.dmgBuffUntil and self.t < attacker.dmgBuffUntil then
			ev.buffDmg = true
		end
		-- threat: an NPC chases who hit it last
		victim.threat = attacker
		victim.threatAt = self.t
	end
	-- (a retreated team gains no meter, hurt or not)
	if victim.kind ~= "Boss" and not victim.team.retreat then
		local isFighter = victim.team.player and victim == victim.team.fighter
		local gain = isFighter and num(F.MeterOnHurt, 2) or num(D.MeterOnHurt, 2)
		local top = isFighter and num(F.SpecialMeterMax, 100) or num(D.MeterMax, 100)
		Strike.meter(victim, gain * (victim.meterRate or 1), top)
	end
	if mult ~= 1 then
		ev.elem = mult
	end
	if crit then
		ev.crit = true
	end
	if absorbed > 0 then
		ev.absorbed = floor(absorbed + 0.5)
	end
	if extra then
		for k, v in pairs(extra) do
			if k ~= "leech" then
				ev[k] = v
			end
		end
	end
	events[#events + 1] = ev
	if victim.hp <= 0 then
		knockOut(self, victim, attacker, events)
	end
	-- evolved Shield, once the Hit stands (a KO'd unit has neither: knockOut cleared them). A Thorns hit never reflects a Thorns hit;
	-- the shield's last point still reflects, then it ends
	if absorbed > 0 then
		if victim.thorns and attacker and not (extra and extra.thorns) and not inIFrames(self, attacker) then
			applyDamage(self, victim, attacker, absorbed * victim.thorns.share, events, { thorns = true }, true)
		end
		if victim.shield <= 0 and (victim.shieldForm or victim.thorns) then
			shieldBreak(self, victim, events)
		end
	end
	return dmg + absorbed
end

-- a hit that lands on a unit inside its dash i-frames: a miss (DODGED)
local function missEvent(self, attacker, victim, events, extra)
	local ev = { type = EV.Hit, from = attacker and attacker.id or nil, to = victim.id, dmg = 0, miss = true }
	if extra then
		for k, v in pairs(extra) do
			ev[k] = v
		end
	end
	events[#events + 1] = ev
end

----------------------------------------------------------------------
-- Statuses
----------------------------------------------------------------------
local function applyStun(self, e, seconds)
	if e.kind == "Boss" or seconds <= 0 then
		return false
	end
	local untilT = self.t + seconds
	if e.stunUntil < untilT then
		e.stunUntil = untilT
	end
	e.state = S_STUNNED
	e.windAt = nil
	e.windTarget = nil
	if e.sTo then
		Strike.close(e) -- (feel-balance) a stunned pet stands where it is
	end
	return true
end

local function applyBurn(self, from, e, total, seconds)
	if e.kind == "Boss" or total <= 0 then
		return
	end
	local ticks = max(1, floor(num(damageRules().BurnTicks, 3)))
	e.burnLeft = ticks
	e.burnAmount = total / ticks
	e.burnNextAt = self.t + seconds / ticks
	e.burnStep = seconds / ticks
	e.burnFrom = from
end

----------------------------------------------------------------------
-- Targeting
----------------------------------------------------------------------
-- nearest living enemy on the floor, judged on start-of-step positions (px / pz; feel-balance: `body` = an enemy that strikes
-- at its body point, the offset Strike.refresh set this step: the boss's basic pick. The NPCs' own target picks stay on rest
-- spots: a body point that comes and goes made a minion swap targets every RetargetSeconds and walk instead of biting)
local function nearestEnemy(self, u, maxDist, body)
	local best, bestD2 = nil, (maxDist and maxDist * maxDist) or huge
	local list = self.units
	local side = u.side
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and targetable(self, e) then
			local dx, dz = e.px - u.px, e.pz - u.pz
			if body and e.bdx then
				dx, dz = dx + e.bdx, dz + e.bdz
			end
			local d2 = dx * dx + dz * dz
			if d2 < bestD2 then
				best, bestD2 = e, d2
			end
		end
	end
	return best, bestD2
end

-- the NPC target: the threat (who hit it within ThreatSeconds), else sticky nearest / a random near one
local function pickTarget(self, u)
	local D = damageRules()
	local threat = u.threat
	if threat and threat.alive and not threat.gone and not threat.benched and threat.side ~= u.side and self.t - u.threatAt <= num(D.ThreatSeconds, 3)
		and not hiddenByRetreat(self, threat) then
		return threat
	end
	local nearest, dmin2 = nearestEnemy(self, u)
	if not nearest then
		return nil
	end
	local sticky = num(D.TargetSticky, 1.6)
	local cur = u.target
	if cur and cur.alive and not cur.gone and not cur.benched and cur.side ~= u.side and not hiddenByRetreat(self, cur) then
		local dx, dz = cur.px - u.px, cur.pz - u.pz
		if dx * dx + dz * dz <= dmin2 * sticky * sticky then
			return cur
		end
	end
	local spread = num(D.TargetSpread, 1.35)
	local limit = dmin2 * spread * spread
	local count = 0
	local list = self.units
	local side = u.side
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and targetable(self, e) then
			local dx, dz = e.px - u.px, e.pz - u.pz
			if dx * dx + dz * dz <= limit then
				count = count + 1
				self.order2[count] = e
			end
		end
	end
	if count <= 1 then
		return nearest
	end
	return self.order2[randInt(self, 1, count)]
end

local function livingEnemies(self, side)
	local out = {}
	local list = self.units
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and targetable(self, e) then -- an arriving enemy is not in any shape yet
			out[#out + 1] = e
		end
	end
	return out
end

-- every enemy an area already placed can catch: a retreated pet standing in a telegraph is hit, whoever else fights
local function hittableEnemies(self, side)
	local out = {}
	local list = self.units
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and hittable(self, e) then
			out[#out + 1] = e
		end
	end
	return out
end

-- a player team's current lock, if still a living enemy on the floor
local function lockOf(team)
	local l = team.lock
	if l and l.alive and not l.gone and not l.benched and l.side ~= team.side then
		return l
	end
	team.lock = nil
	return nil
end

----------------------------------------------------------------------
-- Buffs (helper buttons, Rally / Haste specials)
----------------------------------------------------------------------
-- applies a buff table to `target`; value x `mult` (Ability training of the caster); returns the until time
local function applyBuff(self, target, buff, mult, events, ev)
	local t = self.t
	local value = num(buff.Value, 0) * num(mult, 1)
	local seconds = num(buff.Seconds, 0)
	local untilT = t + seconds
	local effect = buff.Effect
	if effect == "Heal" then
		local amount = min(target.maxHp * value, max(0, target.maxHp - target.hp))
		target.hp = target.hp + amount
		ev.amount = floor(amount + 0.5)
	elseif effect == "Shield" then
		local amount = target.maxHp * value
		if target.shield < amount then
			target.shield = amount
		end
		target.shieldUntil = max(target.shieldUntil, untilT)
		ev.amount = floor(amount + 0.5)
	elseif effect == "Damage" then
		target.dmgBuffMult = 1 + value
		target.dmgBuffUntil = untilT
	elseif effect == "Speed" then
		-- the Haste buttons and War pace share it: the larger stands, no overwrite
		target.speedBuffMult = max((t < target.speedBuffUntil) and target.speedBuffMult or 1, 1 + value)
		target.speedBuffUntil = max(target.speedBuffUntil, untilT)
	elseif effect == "Regen" then
		target.regenRate = value
		target.regenUntil = untilT
	elseif effect == "Chill" then
		target.chillValue = value
		target.chillUntil = untilT
	elseif effect == "Taken" then
		target.takenMult = max(0.1, 1 - value)
		target.takenUntil = untilT
	elseif effect == "AttackSpeed" then
		target.atkSpeedMult = 1 + value
		target.atkSpeedUntil = untilT
	elseif effect == "Lifesteal" then
		target.leechValue = value
		target.leechUntil = untilT
	end
	if finite(buff.Meter) and buff.Meter > 0 then
		local top = num(fighterRules().SpecialMeterMax, 100)
		Strike.meter(target, buff.Meter, top)
	end
	ev["until"] = r1(untilT)
	return untilT
end

----------------------------------------------------------------------
-- Specials
----------------------------------------------------------------------
local function specialRules(kind)
	local bc = catalog()
	local s = bc and type(bc.Specials) == "table" and bc.Specials[kind]
	if type(s) == "table" then
		return s
	end
	return nil
end

-- Evolved forms: the delayed hits, the charge line, burning ground, the boss bonus (BattleCatalog.Forms; a stage-0 unit reaches none of this)
-- a Twist event: a twist that lands later than its cast (or adds to it), on the wire in 0.1 steps
local function twistEvent(u, kind, twist, x, z)
	return { type = EV.Twist, unit = u.id, kind = kind, twist = twist, x = x and r1(x), z = z and r1(z) }
end

-- a twist's hit: a body in its dash i-frames dodges it, as every timed hit
local function twistHit(self, u, e, amount, events, extra)
	if inIFrames(self, e) then
		missEvent(self, u, e, events, extra)
	else
		applyDamage(self, u, e, amount, events, extra)
	end
end

-- a control twist on a boss (its immunities stand) pays a bonus hit, so it never does nothing. `element`: the attack's name, when the twist
-- is an element attack's (its Hit then reads as that attack's, as the cast's own)
local function bossBonus(self, u, boss, base, kind, events, element)
	local bc = catalog()
	local extra = element and { element = element, bonus = true } or { special = kind, bonus = true }
	return applyDamage(self, u, boss, base * num(bc and bc.Forms and bc.Forms.BossBonus, 0.1), events, extra)
end

-- the real and drawn Pounce charge: from Back studs behind `u` (clamped to the floor) through `target` to Past studs past it, Beam Width x
-- reach -> x0, z0, angle, length, width. A clamped start is re-aimed: the line still runs through the target
local function chargeLine(self, u, target, twist, reach)
	local dx, dz = target.x - u.x, target.z - u.z
	local d = sqrt(dx * dx + dz * dz)
	local dirX, dirZ = 1, 0
	if d > 0.01 then
		dirX, dirZ = dx / d, dz / d
	end
	local x0, z0 = clampPoint(self, u.x - dirX * num(twist.Back, 8), u.z - dirZ * num(twist.Back, 8), u.radius)
	dx, dz = target.x - x0, target.z - z0
	d = sqrt(dx * dx + dz * dz)
	if d > 0.01 then
		dirX, dirZ = dx / d, dz / d
	end
	local S = specialRules("Beam")
	return x0, z0, atan2(dirZ, dirX), d + num(twist.Past, 3), num(S and S.Width, 4) * reach
end

-- burning ground: a zone that deals `total` over `seconds`. A pet has one (the next replaces it); different pets' stack, as Storm zones do
local function patchZone(self, u, x, z, r, total, seconds, kind, events)
	local zones = self.zones
	for i = #zones, 1, -1 do
		if zones[i] == u.patch then
			table.remove(zones, i)
			break
		end
	end
	local zone = { x = x, z = z, r = r, dps = total / seconds, untilT = self.t + seconds, nextTick = self.t + ZONE_TICK, side = u.side, from = u, kind = "Patch", special = kind }
	zones[#zones + 1] = zone
	u.patch = zone
	events[#events + 1] = { type = EV.Zone, unit = u.id, kind = "Patch", special = kind, x = r1(x), z = r1(z), r = r1(r), seconds = seconds, side = u.side }
	return zone
end

-- a stage-2 Shield's burst, once: when the shield ends (broken, run out) around the unit that wore it. Thorns end with it. Nothing fires
-- from the bench, or for a fallen caster (a KO'd wearer has no form left: knockOut)
function shieldBreak(self, a, events)
	local form = a.shieldForm
	a.shieldForm = nil
	a.thorns = nil
	if not form or not onFloor(a) or not onFloor(form.from) then
		return
	end
	local from = form.from
	local tw = twistEvent(from, "Shield", "Burst", a.x, a.z)
	tw.r = r1(form.r)
	tw.targets = {}
	events[#events + 1] = tw
	local extra = { special = "Shield", twist = "Burst" }
	for _, e in ipairs(livingEnemies(self, a.side)) do
		if inCircle(e, a.x, a.z, form.r) then
			tw.targets[#tw.targets + 1] = e.id
			twistHit(self, from, e, form.base * form.share, events, extra)
		end
	end
end

-- a delayed twist lands. Twin: a line from where the caster stands NOW, along the original angle. Aftershock, Shatter, Last strike, Fissure: a
-- circle at the original point. Maelstrom: the same cone again (d.half). Rockspire: the ring round the area (d.band). Chill: the slow at the
-- thaw. Lingering: one tick of healing. d.element: the element attack's name, when the twist is one (d.kind = the element)
local function fireDelayed(self, d, events)
	local u = d.from
	if d.twist == "Chill" then
		local tw = twistEvent(u, d.kind, d.twist, d.x, d.z)
		tw.targets = {}
		for _, e in ipairs(d.targets) do
			if e.alive and not e.gone and applySlow(self, e, d.slow, d.seconds) then
				tw.targets[#tw.targets + 1] = e.id
			end
		end
		if #tw.targets > 0 then
			events[#events + 1] = tw
		end
		return
	elseif d.twist == "Lingering" then
		local tw = twistEvent(u, d.kind, d.twist)
		tw.heals = {}
		for _, a in ipairs(d.targets) do
			if a.alive and not a.gone and a.hp < a.maxHp then
				local got = min(d.base * d.share, a.maxHp - a.hp)
				a.hp = a.hp + got
				tw.heals[#tw.heals + 1] = { a.id, floor(got + 0.5) }
			end
		end
		if #tw.heals > 0 then
			events[#events + 1] = tw
		end
		return
	end
	local line = d.twist == "Twin"
	local x, z = d.x, d.z
	if line then
		x, z = u.x, u.z
	end
	local tw = twistEvent(u, d.kind, d.twist, x, z)
	if line then
		tw.angle = floor(d.angle * 1000 + 0.5) / 1000
		tw.length, tw.width = r1(d.length), r1(d.width)
	elseif d.half then
		tw.angle = floor(d.angle * 1000 + 0.5) / 1000
		tw.length = r1(d.length)
	else
		tw.r = r1(d.r)
		tw.band = d.band and r1(d.band) or nil
	end
	tw.targets = {}
	events[#events + 1] = tw
	local extra = d.element and { element = d.element, twist = d.twist } or { special = d.kind, twist = d.twist }
	for _, e in ipairs(livingEnemies(self, u.side)) do
		local inside
		if line then
			inside = inLine(e, x, z, d.angle, d.length, d.width)
		elseif d.half then
			inside = inCone(e, x, z, d.angle, d.half, d.length)
		elseif d.band then
			local away = dist(x, z, e.x, e.z)
			inside = away + e.radius >= d.r and away - e.radius <= d.r + d.band -- a body counts by its edge, as in every shape
		else
			inside = inCircle(e, x, z, d.r)
		end
		if inside then
			tw.targets[#tw.targets + 1] = e.id
			twistHit(self, u, e, d.base * d.share, events, extra)
		end
	end
end

-- the delayed-hit queue (self.delayed; self.pending holds a step's events), stepped like the telegraphs. A caster who fell, left or sits
-- on the bench drops its hits. entry = { at, from, kind, twist, x, z, angle, length, width, r, base, share, targets, every, left, slow, seconds }
local function queueDelayed(self, entry)
	self.delayed[#self.delayed + 1] = entry
end

-- (battle-feel T3) the real cast's entries ride the same queue: { at, from, cast = kind, target, x, z, t0 }. fireCast lands it
-- at `at`; cancelCast ends it (CastBreak, meter kept) when its caster is stunned or its team retreats first; a caster that
-- fell / left / sits on the bench drops it silently
local fireCast, cancelCast -- forward

local function resolveDelayed(self, events)
	local list = self.delayed
	local i = 1
	while i <= #list do
		local d = list[i]
		local u = d.from
		if d.cast and (not onFloor(u) or self.t < u.stunUntil or u.team.retreat) then
			table.remove(list, i)
			if onFloor(u) then
				cancelCast(self, d, events)
			else
				u.castEntry = nil
				u.meterCarry = nil
			end
		elseif self.t < d.at - (d.cast and 1e-6 or 0) then
			i = i + 1
		elseif d.cast then
			table.remove(list, i)
			fireCast(self, d, events)
		elseif not onFloor(d.from) then
			table.remove(list, i)
		else
			fireDelayed(self, d, events)
			if d.every and d.left > 1 then
				d.left = d.left - 1
				d.at = d.at + d.every
				i = i + 1
			else
				table.remove(list, i)
			end
		end
	end
end

-- Quick hands: a cooldown set while the fighter's Haste is on is shorter
local function rechargeOf(self, u)
	if self.t < u.quickUntil then
		local form = formOf(u)
		if form and form.QuickHands then
			return num(form.QuickHands.Recharge, 1)
		end
	end
	return 1
end

-- Double strike, after a landed swing: the extra draw exists only while the twist is on, so a stage-0 fight's stream never moves
local function doubleStrike(self, u, target, events)
	if self.t < u.doubleUntil then
		local form = formOf(u)
		if form and form.DoubleStrike and rand(self) < num(form.DoubleStrike.Chance, 0) then
			applyDamage(self, u, target, u.hit, events, { double = true })
		end
	end
end

-- (battle-feel T3) the real cast's seconds for `kind` (BattleCatalog.Damage.SpecialCast), nil = today's instant special
local function castSecondsOf(D, kind)
	local c = D.SpecialCast
	local s = type(c) == "table" and c[kind] or nil
	if finite(s) and s > 0 then
		return s
	end
	return nil
end

-- a special's effects: the meter spent, the areas, hits, zones, buffs, heals and the Special event. `cast` = the real cast's
-- queue entry firing now (battle-feel T3): its aim (cast.x, cast.z) was fixed at its start, the caster is not blocked again
-- (it was Casting until now), a Blast's target inside its dash i-frames is a miss, the Special event carries at = its start.
-- cast == nil: today's instant special (Casting CastSeconds after it)
local function specialBody(self, u, target, events, cast)
	local kind = u.specialKind
	local S = specialRules(kind)
	local D = damageRules()
	local team = u.team
	local isFighter = team.player and u == team.fighter
	local base = u.specialPower * D.DamageScale * num(S.Scale, 1) * num(D.SpecialScale, 1)
	local reach = reachOf(u)
	local form = formOf(u) -- nil at stage 0
	-- the aimed spot: the target now (today), or where it stood at the cast's start (a sidestep out of the area dodges)
	local ax, az = nil, nil
	if target then
		ax, az = target.x, target.z
		if cast and kind ~= "Pounce" then
			ax, az = cast.x, cast.z
		end
	end
	u.meter = 0
	if not cast then
		u.castUntil = self.t + D.CastSeconds
		u.state = S_CASTING
	end
	u.windAt = nil
	u.windTarget = nil
	if u.nextAttack < u.castUntil then
		u.nextAttack = u.castUntil
	end
	u.autoCastAt = nil
	local ev = { type = EV.Special, unit = u.id, kind = kind, name = u.formName or (u.special and u.special.Name) or kind, x = r1(u.x), z = r1(u.z) }
	if cast then
		ev.at = r1(cast.t0)
	end
	if form then
		ev.form = formStageOf(u)
	end
	if target then
		ev.tx, ev.tz = r1(ax), r1(az)
		ev.target = target.id
	end
	local position = #events + 1
	local extra = { special = kind }
	if kind == "Blast" then
		local r = num(S.Radius, 7) * reach
		ev.r = areaField(reach, r)
		ev.targets = {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inCircle(e, ax, az, r) then
				ev.targets[#ev.targets + 1] = e.id
				if cast and inIFrames(self, e) then
					missEvent(self, u, e, events, extra) -- (battle-feel T3) dashed through the cast: dodged
				else
					applyDamage(self, u, e, base, events, extra)
				end
			end
		end
		if form then
			queueDelayed(self, { at = self.t + form.Aftershock.Delay, from = u, kind = kind, twist = "Aftershock", x = ax, z = az, r = r, base = base, share = form.Aftershock.Share })
			if form.Patch then
				patchZone(self, u, ax, az, r, base * form.Patch.Share, form.Patch.Seconds, kind, events)
			end
		end
	elseif kind == "Heal" then
		ev.heals = {}
		local amount = base
		if isFighter then
			amount = base * num(S.Solo, 3) -- a fighter's heal: x Solo on the fighter and on each benched pet
		end
		-- Lingering ticks on the same units; Overflow: the part of the heal a unit could not take becomes its shield
		local healed, overflow = {}, form and form.Overflow
		local shields, topShield = {}, 0
		-- dungeon fixes (7): a player's healer heals its fighter AND the benched pets (an NPC: its pets on the floor)
		for _, a in ipairs(team.units) do
			if a.alive and not a.gone and (isFighter or not a.benched) then
				local got = 0
				if a.hp < a.maxHp then
					got = min(amount, a.maxHp - a.hp)
					a.hp = a.hp + got
					ev.heals[#ev.heals + 1] = { a.id, floor(got + 0.5) }
					healed[#healed + 1] = a
				end
				if overflow then
					local shield = min(amount - got, amount * overflow.Cap)
					if shield > 0 and shield > a.shield then
						a.shield = shield
						a.shieldUntil = self.t + overflow.Seconds
						shields[#shields + 1] = a.id
						topShield = max(topShield, shield)
					end
				end
			end
		end
		if form and #healed > 0 then
			local twist = form.Lingering
			local every = twist.Seconds / twist.Ticks
			queueDelayed(self, { at = self.t + every, from = u, kind = kind, twist = "Lingering", targets = healed, base = amount, share = twist.Share / twist.Ticks, every = every, left = twist.Ticks })
		end
		if #shields > 0 then
			local tw = twistEvent(u, kind, "Overflow")
			tw.shields, tw.amount = shields, floor(topShield + 0.5)
			events[#events + 1] = tw
		end
	elseif kind == "Shield" then
		ev.shields = {}
		local amount = base
		if isFighter then
			amount = base * num(S.Solo, 3)
		end
		for _, a in ipairs(team.units) do
			if a.alive and not a.gone and (not isFighter or a == u) and (isFighter or not a.benched) then
				if a.shield < amount then
					a.shield = amount
				end
				a.shieldUntil = self.t + num(S.Seconds, 6)
				ev.shields[#ev.shields + 1] = a.id
				if form then
					a.thorns = { from = u, share = form.Thorns.Share }
					if form.Burst then
						a.shieldForm = { from = u, base = base, share = form.Burst.Share, r = form.Burst.Radius * reach }
					end
				end
			end
		end
	elseif kind == "Rally" or kind == "Haste" then
		local bc = catalog()
		local buff = bc and type(bc.Buffs) == "table" and bc.Buffs[kind] or { Effect = (kind == "Rally") and "Damage" or "Speed", Value = num(S.Value, 0.35), Seconds = num(S.Seconds, 8) }
		local b = { Effect = buff.Effect, Value = num(S.Value, buff.Value), Seconds = num(S.Seconds, buff.Seconds) }
		local untilT = applyBuff(self, u, b, u.specialBoost, events, ev)
		ev.targets = { u.id }
		if form then
			if form.WarPace then
				applyBuff(self, u, { Effect = "Speed", Value = form.WarPace.Speed, Seconds = b.Seconds }, u.specialBoost, events, {})
			end
			if form.FiredUp then
				u.meter = min(isFighter and num(fighterRules().SpecialMeterMax, 100) or num(D.MeterMax, 100), u.meter + form.FiredUp.Meter)
			end
			if form.QuickHands then
				u.quickUntil = untilT
			end
			if form.DoubleStrike then
				u.doubleUntil = untilT
			end
		end
	elseif kind == "Storm" then
		local seconds = num(S.Seconds, 4)
		local zone = {
			x = ax,
			z = az,
			r = num(S.Radius, 6) * reach,
			dps = base / seconds,
			untilT = self.t + seconds,
			nextTick = self.t + ZONE_TICK,
			side = u.side,
			from = u,
			kind = kind,
		}
		if form then
			zone.slow = form.Winds.Slow
			zone.base = base
			zone.bonusDone = {}
			if form.LastStrike then
				zone.onEnd = { from = u, kind = kind, twist = "LastStrike", x = zone.x, z = zone.z, r = zone.r, base = base, share = form.LastStrike.Share }
			end
		end
		self.zones[#self.zones + 1] = zone
		ev.r = areaField(reach, zone.r)
		events[#events + 1] = { type = EV.Zone, unit = u.id, kind = kind, x = r1(zone.x), z = r1(zone.z), r = zone.r, seconds = seconds, side = u.side }
	elseif kind == "Pounce" then
		-- the charge line runs from where the pet stands now (an NPC leaps below)
		local lineX, lineZ, lineAngle, lineLength, lineWidth
		if form then
			lineX, lineZ, lineAngle, lineLength, lineWidth = chargeLine(self, u, target, form.Charge, reach)
		end
		local dx, dz = target.x - u.x, target.z - u.z
		local d = sqrt(dx * dx + dz * dz)
		local stop = target.radius + u.radius + 0.5
		if d > stop and not isFighter then
			u.x = target.x - dx / d * stop
			u.z = target.z - dz / d * stop
			clampToFloor(self, u)
		end
		ev.range = areaField(reach, num(S.Range, 30) * reach)
		ev.targets = { target.id }
		if inIFrames(self, target) then
			missEvent(self, u, target, events, extra)
		else
			applyDamage(self, u, target, base, events, extra)
		end
		if form then
			ev.x0, ev.z0 = r1(lineX), r1(lineZ)
			ev.angle = floor(lineAngle * 1000 + 0.5) / 1000
			ev.length, ev.width = r1(lineLength), r1(lineWidth)
			local on = { special = kind, twist = "Charge" }
			for _, e in ipairs(livingEnemies(self, u.side)) do
				if e ~= target and inLine(e, lineX, lineZ, lineAngle, lineLength, lineWidth) then
					ev.targets[#ev.targets + 1] = e.id
					twistHit(self, u, e, base * form.Charge.Share, events, on)
				end
			end
			if form.Landing then
				local r = form.Landing.Radius * reach
				ev.burstR = r1(r)
				ev.burstTargets = {}
				local burst = { special = kind, twist = "Landing" }
				for _, e in ipairs(livingEnemies(self, u.side)) do
					if e ~= target and inCircle(e, target.x, target.z, r) then
						ev.burstTargets[#ev.burstTargets + 1] = e.id
						twistHit(self, u, e, base * form.Landing.Share, events, burst)
					end
				end
			end
			-- aimed at a boss the strike is the whole of it: each twist pays its bonus hit, so it never does nothing
			if target.kind == "Boss" then
				bossBonus(self, u, target, base, kind, events)
				if form.Landing then
					bossBonus(self, u, target, base, kind, events)
				end
			end
		end
	elseif kind == "Freeze" then
		local r = num(S.Radius, 7) * reach
		local stun = num(S.Stun, 2) * (u.specialFactor or 1)
		ev.r = areaField(reach, r)
		ev.targets, ev.stunned = {}, {}
		local frozen = {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inCircle(e, ax, az, r) then
				ev.targets[#ev.targets + 1] = e.id
				if inIFrames(self, e) then
					missEvent(self, u, e, events, extra)
				else
					local stunned = applyStun(self, e, stun)
					if stunned then
						ev.stunned[#ev.stunned + 1] = e.id
						frozen[#frozen + 1] = e
					end
					applyDamage(self, u, e, base, events, extra)
					if form and not stunned and e.kind == "Boss" then
						bossBonus(self, u, e, base, kind, events) -- Chill: its immunity stands
					end
				end
			end
		end
		if form then
			local thaw = self.t + stun
			if #frozen > 0 then
				queueDelayed(self, { at = thaw, from = u, kind = kind, twist = "Chill", x = ax, z = az, targets = frozen, slow = form.Chill.Slow, seconds = form.Chill.Seconds })
			end
			if form.Shatter then
				queueDelayed(self, { at = thaw, from = u, kind = kind, twist = "Shatter", x = ax, z = az, r = r, base = base, share = form.Shatter.Share })
			end
		end
	elseif kind == "Beam" then
		local dx, dz = ax - u.x, az - u.z
		local angle = atan2(dz, dx)
		if dx == 0 and dz == 0 then
			angle = 0
		end
		ev.angle = r1(angle)
		local length, width = num(S.Length, 26) * reach, num(S.Width, 4) * reach
		ev.length, ev.width = areaField(reach, length), areaField(reach, width)
		ev.targets = {}
		for _, e in ipairs(livingEnemies(self, u.side)) do
			if inLine(e, u.x, u.z, angle, length, width) then
				ev.targets[#ev.targets + 1] = e.id
				if inIFrames(self, e) then
					missEvent(self, u, e, events, extra)
				else
					applyDamage(self, u, e, base, events, extra)
					if form then
						applyMark(self, e, form.Mark.Mark, form.Mark.Seconds)
					end
				end
			end
		end
		if form and form.Twin then
			queueDelayed(self, { at = self.t + form.Twin.Delay, from = u, kind = kind, twist = "Twin", angle = angle, length = length, width = width, base = base, share = form.Twin.Share })
		end
	else
		ev.targets = { target.id }
		applyDamage(self, u, target, base, events, extra)
	end
	table.insert(events, position, ev)
	return true, kind
end

-- a special press / an NPC's auto cast: today's refusals and target, then the effects at once (no SpecialCast) or, with the
-- real cast (battle-feel T3, beginCast): Casting for SpecialCast[kind] s with the aim fixed now, the Cast event, the queue
-- entry that fires them at `at` (fireCast); the meter stays full until then
local function castSpecial(self, u, events)
	local kind = u.specialKind
	local S = kind and specialRules(kind)
	if not S then
		return false, "NoSpecial"
	end
	local D = damageRules()
	local team = u.team
	local isFighter = team.player and u == team.fighter
	local reach = reachOf(u)
	local offensive = kind ~= "Heal" and kind ~= "Shield" and kind ~= "Rally" and kind ~= "Haste"
	local target = nil
	if offensive then
		target = isFighter and lockOf(team) or nil
		if not target then
			target = pickTarget(self, u)
		end
		if not target then
			return false, "NoTarget"
		end
		if kind == "Pounce" and dist(u.x, u.z, target.x, target.z) > num(S.Range, 30) * reach + target.radius then
			target = nearestEnemy(self, u, num(S.Range, 30) * reach + 3)
			if not target then
				return false, "TooFar"
			end
		end
	end
	if u.sTo then
		Strike.close(u) -- (feel-balance) a caster stands at its rest spot
	end
	local secs = castSecondsOf(D, kind)
	if not secs then
		return specialBody(self, u, target, events, nil)
	end
	-- beginCast
	local at = self.t + secs
	local d = { at = at, from = u, cast = kind, target = target, x = target and target.x or u.x, z = target and target.z or u.z, t0 = self.t }
	queueDelayed(self, d)
	u.castEntry = d
	u.castUntil = at
	u.state = S_CASTING
	u.windAt = nil
	u.windTarget = nil
	if u.nextAttack < at then
		u.nextAttack = at
	end
	u.autoCastAt = nil
	local ev = { type = EV.Cast, unit = u.id, kind = kind, name = u.formName or (u.special and u.special.Name) or kind, at = r1(at) }
	if formOf(u) then
		ev.form = formStageOf(u)
	end
	if target then
		ev.target = target.id
		ev.tx, ev.tz = r1(target.x), r1(target.z)
	end
	events[#events + 1] = ev
	return true, kind
end

-- (battle-feel T3) the cast lands (resolveDelayed at `at`): the Casting ends now, today's body at the fixed aim. A Pounce
-- leaps at its target's live spot (another in reach when it fell); none left: the cast breaks (CastBreak, meter kept)
function fireCast(self, d, events)
	local u = d.from
	u.castEntry = nil
	if u.castUntil > self.t then
		u.castUntil = self.t
	end
	if u.specialKind ~= d.cast then
		u.meterCarry = nil
		return
	end
	local target = d.target
	if target and (not target.alive or target.gone or target.benched) and d.cast == "Pounce" then
		local S = specialRules("Pounce")
		target = nearestEnemy(self, u, num(S and S.Range, 30) * reachOf(u) + 3)
		if not target then
			cancelCast(self, d, events)
			return
		end
	end
	local carry = u.meterCarry
	u.meterCarry = nil
	specialBody(self, u, target, events, d)
	-- (feel-balance Task 2) the meter carry: what the full meter gained during the charge, after the spend
	if carry and carry > 0 and u.alive then
		local isFighter = u.team.player and u == u.team.fighter
		local top = isFighter and num(fighterRules().SpecialMeterMax, 100) or num(damageRules().MeterMax, 100)
		u.meter = min(top, u.meter + carry)
	end
end

function cancelCast(self, d, events)
	local u = d.from
	u.castEntry = nil
	u.meterCarry = nil -- (the meter is still full: nothing to carry)
	if u.castUntil > self.t then
		u.castUntil = self.t
	end
	events[#events + 1] = { type = EV.CastBreak, unit = u.id, kind = d.cast }
end

-- NPC / Auto teams decide when to use a full meter
local function autoSpecialWanted(self, u)
	local kind = u.specialKind
	if kind == "Heal" then
		for _, a in ipairs(u.team.units) do
			if a.alive and not a.benched and a.hp < a.maxHp * 0.8 then
				return true
			end
		end
		return false
	elseif kind == "Shield" then
		for _, a in ipairs(u.team.units) do
			if a.alive and not a.benched and a.hp < a.maxHp * 0.95 and a.shield <= 0 then
				return true
			end
		end
		return false
	end
	return true
end

----------------------------------------------------------------------
-- The element attack
----------------------------------------------------------------------
-- aim: a unit (target) or a point; returns angle, tx, tz
local function aimOf(self, team, u, arg)
	local target = nil
	local tx, tz = nil, nil
	if type(arg) == "table" then
		local ax = arg.x or arg.X or arg[1]
		local az = arg.z or arg.Z or arg[2]
		if finite(ax) and finite(az) then
			tx, tz = clampPoint(self, ax, az, 0)
		end
	elseif arg ~= nil then
		local id = tonumber(arg)
		local unit = id and self.units[id]
		if unit and onFloor(unit) and unit.side ~= u.side then
			target = unit
		end
	end
	if not target and not tx then
		target = lockOf(team)
	end
	if not target and not tx then
		target = nearestEnemy(self, u)
	end
	if target then
		tx, tz = target.x, target.z
	end
	if not tx then
		tx, tz = u.x + team.faceX * 5, u.z + team.faceZ * 5
	end
	local dx, dz = tx - u.x, tz - u.z
	local angle = (dx == 0 and dz == 0) and atan2(team.faceZ, team.faceX) or atan2(dz, dx)
	return angle, tx, tz, target
end

-- Forked Bolt / Thunder Lance, after the line's hits: each jump strikes the nearest enemy not yet hit, within Reach of the last one struck; a
-- line that struck exactly one enemy with nobody in reach strikes it again, once
local function forkBolt(self, u, struck, form, dmg, name, events)
	local last = struck[#struck]
	if not last then
		return
	end
	local twist = form.Forked
	local done = {}
	for _, e in ipairs(struck) do
		done[e] = true
	end
	local extra = { element = name, twist = "Forked" }
	local amount = dmg * twist.Share
	local jumped = false
	for _ = 1, form.Jumps do
		local best, bestD = nil, twist.Reach
		for _, e in ipairs(livingEnemies(self, u.side)) do
			local d = dist(last.x, last.z, e.x, e.z)
			if not done[e] and d <= bestD then
				best, bestD = e, d
			end
		end
		if not best then
			break
		end
		local tw = twistEvent(u, u.elems[1], "Forked", last.x, last.z)
		tw.tx, tw.tz, tw.targets = r1(best.x), r1(best.z), { best.id }
		events[#events + 1] = tw
		twistHit(self, u, best, amount, events, extra)
		done[best] = true
		last = best
		jumped = true
	end
	if not jumped and #struck == 1 and last.alive then
		local tw = twistEvent(u, u.elems[1], "Forked", last.x, last.z)
		tw.tx, tw.tz, tw.targets = r1(last.x), r1(last.z), { last.id }
		events[#events + 1] = tw
		twistHit(self, u, last, amount, events, extra)
	end
end

local function castElement(self, team, u, arg, events)
	local bc = catalog()
	local F = fighterRules()
	local element = u.elems[1]
	local a = bc and type(bc.ElementAttacks) == "table" and element and bc.ElementAttacks[element]
	if not a then
		return false, "NoElement"
	end
	local form = elementFormOf(u) -- nil at stage 0
	local name = form and form.Name or a.Name
	local angle, tx, tz, aimT = aimOf(self, team, u, arg)
	-- a ranged fighter reaches out to its own range at least (the design's "ranged pets use max(Range, 14)")
	local reachOut = u.ranged and num(u.range, 0) or 0
	local reach = reachOf(u)
	-- (feel-balance Task 2) the origin: a melee caster with a standoff dashes in for its element too, so its Cone / Line /
	-- Circle grows from its bite point toward the aimed unit (Strike.point; the rest spot at Standoff 0) and the cast opens a
	-- strike window now (the client draws the dash)
	local ox, oz = u.x, u.z
	if aimT and standoffOf(damageRules(), u) > 0 then
		ox, oz = Strike.point(damageRules(), u, aimT, self.t)
		Strike.open(self, u, aimT, self.t)
	end
	local cx, cz = ox, oz -- a Circle's centre
	if a.Shape == "Circle" and u.ranged then
		-- a ranged pet's Circle lands on its aim point, no farther than its range: a far aim falls short, never across the floor
		local dx, dz = tx - u.x, tz - u.z
		local d = sqrt(dx * dx + dz * dz)
		if d > reachOut then
			tx, tz = u.x + dx / d * reachOut, u.z + dz / d * reachOut
		end
		cx, cz = tx, tz
	end
	local ev = { type = EV.Element, unit = u.id, element = element, name = name, x = r1(ox), z = r1(oz), angle = floor(angle * 1000 + 0.5) / 1000, tx = r1(tx), tz = r1(tz), shape = a.Shape, targets = {} }
	if form then
		ev.form = formStageOf(u)
	end
	local hits = {}
	local enemies = livingEnemies(self, u.side)
	local half, length, width, r = nil, nil, nil, nil
	if a.Shape == "Cone" then
		half = num(a.Angle, 60) * pi / 360
		length = max(num(a.Length, num(F.ElementRange, 14)) * reach, reachOut)
		ev.length = areaField(reach, length)
		for _, e in ipairs(enemies) do
			if inCone(e, ox, oz, angle, half, length) then
				hits[#hits + 1] = e
			end
		end
	elseif a.Shape == "Line" then
		length, width = max(num(a.Length, 24) * reach, reachOut), num(a.Width, 4) * reach
		ev.length, ev.width = areaField(reach, length), areaField(reach, width)
		for _, e in ipairs(enemies) do
			if inLine(e, ox, oz, angle, length, width) then
				hits[#hits + 1] = e
			end
		end
	else
		r = max(num(a.Radius, 8) * reach, reachOut) -- round a melee pet, on a ranged pet's aim
		ev.r = areaField(reach, r)
		for _, e in ipairs(enemies) do
			if inCircle(e, cx, cz, r) then
				hits[#hits + 1] = e
			end
		end
	end
	team.elementReadyAt = self.t + num(F.ElementCooldown, 7) * rechargeOf(self, u)
	team.faceX, team.faceZ = cos(angle), sin(angle)
	u.attackUntil = self.t + ATTACK_POSE
	events[#events + 1] = ev
	local dmg = u.hit * num(F.ElementMult, 2.4)
	local extra = { element = name }
	if form and finite(form.Leech) then
		extra.leech = form.Leech -- Bramble Lash, Soul Rend
	elseif finite(a.Leech) then
		extra.leech = a.Leech
	end
	local struck = {}
	for _, e in ipairs(hits) do
		ev.targets[#ev.targets + 1] = e.id
		if inIFrames(self, e) then
			missEvent(self, u, e, events, { element = name })
		else
			local dealt = applyDamage(self, u, e, dmg, events, extra)
			struck[#struck + 1] = e
			if e.alive then
				-- a twist a boss is immune to (burn, slow, root) pays one bonus hit instead
				local immune = false
				if finite(a.Push) and e.kind ~= "Boss" then
					local dx, dz = e.x - ox, e.z - oz
					local d = sqrt(dx * dx + dz * dz)
					if d > 0.01 then
						e.x, e.z = e.x + dx / d * a.Push, e.z + dz / d * a.Push
						clampToFloor(self, e)
					end
				end
				if type(a.Burn) == "table" then
					applyBurn(self, u, e, dealt * num(form and form.BurnShare, num(a.Burn.Share, 0.25)), num(a.Burn.Seconds, 3))
					immune = form ~= nil
				end
				if type(a.Slow) == "table" then
					applySlow(self, e, num(form and form.Slow, num(a.Slow.Mult, num(damageRules().Slow, 0.6))), num(a.Slow.Seconds, 4))
					immune = form ~= nil
					if form and form.IceSnare then
						applyMark(self, e, form.IceSnare.Mark, num(a.Slow.Seconds, 4))
					end
				end
				if form and form.Riptide then
					applySlow(self, e, form.Riptide.Slow, form.Riptide.Seconds)
					immune = true
				end
				if type(a.Weaken) == "table" then
					-- the strongest Weaken stands while it lasts: a weaker one from another pet never overwrites it
					e.weakenMult = min(num(form and form.Weaken, num(a.Weaken.Mult, num(damageRules().Weaken, 0.85))), (self.t < e.weakenUntil) and e.weakenMult or 1)
					e.weakenUntil = max(e.weakenUntil, self.t + num(a.Weaken.Seconds, 5))
				end
				if finite(a.Stun) then
					applyStun(self, e, a.Stun)
				end
				if form and form.Worldroot then
					applyStun(self, e, form.Worldroot.Root)
					immune = true
				end
				if immune and e.kind == "Boss" then
					bossBonus(self, u, e, dmg, element, events, name)
				end
			end
		end
	end
	if form then
		if form.Maelstrom then
			queueDelayed(self, { at = self.t + form.Maelstrom.Delay, from = u, kind = element, element = name, twist = "Maelstrom", x = ox, z = oz, angle = angle, half = half, length = length, base = dmg, share = form.Maelstrom.Share })
		end
		if form.Inferno then
			-- the ground burns where the attack lands: at the aim, no farther than the cone's end
			local dx, dz = tx - ox, tz - oz
			local d = sqrt(dx * dx + dz * dz)
			local px, pz = tx, tz
			if d > length then
				px, pz = ox + dx / d * length, oz + dz / d * length
			end
			patchZone(self, u, px, pz, form.Inferno.Radius * reach, dmg * form.Inferno.Share, form.Inferno.Seconds, element, events)
		end
		if form.Fissure then
			queueDelayed(self, { at = self.t + form.Fissure.Delay, from = u, kind = element, element = name, twist = "Fissure", x = cx, z = cz, r = r, base = dmg, share = form.Fissure.Share })
		end
		if form.Rockspire then
			queueDelayed(self, { at = self.t + form.Rockspire.Delay, from = u, kind = element, element = name, twist = "Rockspire", x = cx, z = cz, r = r, band = form.Rockspire.Band * reach, base = dmg, share = form.Rockspire.Share })
		end
		if form.Forked then
			forkBolt(self, u, struck, form, dmg, name, events)
		end
		if form.Lance then
			u.meter = min(num(F.SpecialMeterMax, 100), u.meter + form.Lance.Meter)
		end
		if form.Starfall and u.hp < u.maxHp then
			local got = min(u.maxHp * form.Starfall.Heal, u.maxHp - u.hp)
			u.hp = u.hp + got
			local tw = twistEvent(u, element, "Starfall", u.x, u.z)
			tw.heals = { { u.id, floor(got + 0.5) } }
			events[#events + 1] = tw
		end
	end
	local gain = num(form and form.MeterGain, a.MeterGain)
	if finite(gain) then
		u.meter = min(num(F.SpecialMeterMax, 100), u.meter + gain)
	end
	return true, name
end

----------------------------------------------------------------------
-- Swaps
----------------------------------------------------------------------
-- `incoming` (a benched, alive unit) takes the floor; the fighter (if alive) goes to the bench
function swapIn(self, team, incoming, events, auto)
	local F = fighterRules()
	local out = team.fighter
	local x, z = team.anchorX, team.anchorZ
	-- the incoming pet starts in FOLLOW (it re-engages after its cast + the still time)
	dropEngage(self, team, events)
	if out then
		if out.sTo then
			Strike.close(out) -- (feel-balance) to the bench from its rest spot
		end
		x, z = out.x, out.z
		if out.alive then
			out.benched = true
			out.state = S_BENCHED
		end
		out.target = nil
		out.windAt = nil
	end
	incoming.benched = false
	incoming.x, incoming.z, incoming.px, incoming.pz = x, z, x, z
	incoming.castUntil = self.t + num(F.SwapCastSeconds, 0.6)
	incoming.state = S_CASTING
	incoming.nextAttack = max(incoming.nextAttack, incoming.castUntil)
	incoming.iframesUntil = 0
	incoming.dashUntil = 0
	team.fighter = incoming
	events[#events + 1] = { type = EV.Swap, owner = team.owner, out = out and out.id or nil, ["in"] = incoming.id, auto = auto or nil }
end

----------------------------------------------------------------------
-- Boss patterns (Phase 3, kept; the dash i-frames dodge a telegraph)
----------------------------------------------------------------------
function bossBasis(self, victim)
	local rules = (catalog() and catalog().BossRules) or {}
	local basis = type(rules.DamageBasis) == "table" and rules.DamageBasis or { Own = 0.6, Average = 0.4 }
	local group = type(rules.DamageGroup) == "table" and rules.DamageGroup or nil
	local factor = 1
	if group then
		local teams = self.playerTeamCount or 1
		local fullAt = max(2, num(group.FullAt, 8))
		local lo = num(self.boss and self.boss.groupMin, num(group.Min, 0.6))
		factor = lo + (1 - lo) * min(1, (teams - 1) / (fullAt - 1))
		local solo = self.boss and self.boss.soloHit
		if solo and teams < 2 then -- a lone team: its own number, back on the line at two teams (an idle alt moves it a little, never a jump)
			factor = solo + (lo + (1 - lo) / (fullAt - 1) - solo) * max(0, teams - 1)
		end
	end
	return (num(basis.Own, 0.6) * victim.maxHp + num(basis.Average, 0.4) * self.avgPetHp) * factor
end

local function telegraphPoints(self, boss, a)
	local mode = a.Target or "Cluster"
	if mode == "Self" then
		return { { x = boss.x, z = boss.z } }
	end
	local enemies = livingEnemies(self, boss.side)
	if #enemies == 0 then
		return nil
	end
	local count = 1
	if a.Shape ~= "Line" then
		local rules = (catalog() and catalog().BossRules) or {}
		local teams = 0
		for _, team in ipairs(self.teams) do
			if team.side ~= boss.side and not team.left then
				teams = teams + 1
			end
		end
		count = max(1, min(num(rules.MaxCircles, 4), ceil(teams / num(rules.CirclesPerTeams, 2))))
	end
	local r = num(a.Radius, num(a.Width, 6))
	local points = {}
	local covered = {}
	-- (feel-balance) the boss aims where it sees each pet: its body point (the bite point while it strikes)
	local ex, ez = {}, {}
	for _, e in ipairs(enemies) do
		if e.bdx then
			ex[e], ez[e] = e.x + e.bdx, e.z + e.bdz
		else
			ex[e], ez[e] = e.x, e.z
		end
	end
	for _ = 1, count do
		local pool = {}
		for _, e in ipairs(enemies) do
			if not covered[e] then
				pool[#pool + 1] = e
			end
		end
		if #pool == 0 then
			break
		end
		local p
		if mode == "Random" then
			p = pool[randInt(self, 1, #pool)]
		elseif mode == "Nearest" then
			p = pool[1]
			local bestD2 = huge
			for _, e in ipairs(pool) do
				local dx, dz = ex[e] - boss.x, ez[e] - boss.z
				local d2 = dx * dx + dz * dz
				if d2 < bestD2 then
					p, bestD2 = e, d2
				end
			end
		else
			local bestCount = -1
			for _, c in ipairs(pool) do
				local n = 0
				for _, q in ipairs(pool) do
					local dx, dz = ex[q] - ex[c], ez[q] - ez[c]
					if dx * dx + dz * dz <= r * r then
						n = n + 1
					end
				end
				if n > bestCount then
					p, bestCount = c, n
				end
			end
		end
		points[#points + 1] = { x = ex[p], z = ez[p] }
		for _, e in ipairs(pool) do
			local dx, dz = ex[e] - ex[p], ez[e] - ez[p]
			if dx * dx + dz * dz <= (r + e.radius) * (r + e.radius) then
				covered[e] = true
			end
		end
	end
	return points
end

local function startTelegraph(self, boss, entry, events)
	local a = entry.def
	local points = telegraphPoints(self, boss, a)
	if not points or #points == 0 then
		return false
	end
	local delay = num(a.Telegraph, 2)
	local at = self.t + delay
	local shapes = {}
	if a.Shape == "Line" then
		local count = max(1, floor(num(a.Count, 1)))
		local spread = num(a.Spread, 0) * pi / 180
		local dx, dz = points[1].x - boss.x, points[1].z - boss.z
		if dx == 0 and dz == 0 then
			dz = 1
		end
		local baseAngle = atan2(dz, dx)
		local length = min(num(a.Length, 40), sqrt(dx * dx + dz * dz) + BattleSim.LineOvershoot)
		for k = 1, count do
			shapes[#shapes + 1] = { x = boss.x, z = boss.z, angle = baseAngle + (k - (count + 1) / 2) * spread, length = r1(length), width = num(a.Width, 5) }
		end
	else
		for _, p in ipairs(points) do
			shapes[#shapes + 1] = { x = p.x, z = p.z, r = num(a.Radius, 8) }
		end
	end
	for _, shape in ipairs(shapes) do
		local id = self.nextTelegraphId
		self.nextTelegraphId = id + 1
		local tele = { id = id, boss = boss, attack = a, at = at, shape = a.Shape, x = shape.x, z = shape.z, angle = shape.angle, length = shape.length, width = shape.width, r = shape.r, lethal = a.Lethal == true or nil }
		self.telegraphs[#self.telegraphs + 1] = tele
		local ev = {
			type = EV.Telegraph,
			id = id,
			boss = boss.id,
			name = a.Name,
			attack = a.Id,
			shape = a.Shape,
			x = r1(tele.x),
			z = r1(tele.z),
			at = r1(at),
			hits = r1(delay),
		}
		if a.Shape == "Line" then
			ev.angle = floor(tele.angle * 1000 + 0.5) / 1000
			ev.length = tele.length
			ev.width = tele.width
		else
			ev.r = tele.r
		end
		if finite(a.Freeze) then
			ev.freeze = a.Freeze
		end
		if finite(a.Linger) then
			ev.linger = a.Linger
		end
		if tele.lethal then
			ev.lethal = true
		end
		events[#events + 1] = ev
	end
	return true
end

-- the lethal attack: the whole remaining HP + shield, past Defense, elements and every other multiplier
local function lethalHit(self, boss, e, events, teleId, attackId)
	if e.arriveUntil and self.t < e.arriveUntil then
		return
	end
	local dealt = e.hp + e.shield
	boss.damage = boss.damage + dealt
	boss.team.damage = boss.team.damage + dealt
	e.threat = boss
	e.threatAt = self.t
	events[#events + 1] = { type = EV.Hit, from = boss.id, to = e.id, dmg = floor(dealt + 0.5), tele = teleId, attack = attackId, lethal = true }
	knockOut(self, e, boss, events)
end

local function resolveTelegraph(self, tele, events)
	local boss = tele.boss
	local a = tele.attack
	if not boss.alive then
		return
	end
	local extra = { tele = tele.id, attack = a.Id }
	local fraction = num(a.Damage, 0.3) * boss.damageMult
	for _, e in ipairs(hittableEnemies(self, boss.side)) do
		local inside
		if tele.shape == "Line" then
			inside = inLine(e, tele.x, tele.z, tele.angle, tele.length, tele.width)
		else
			inside = inCircle(e, tele.x, tele.z, tele.r)
		end
		if inside then
			if tele.parried and tele.parried[e.id] then
				missEvent(self, boss, e, events, { tele = tele.id, attack = a.Id, parry = true })
			elseif inIFrames(self, e) then
				missEvent(self, boss, e, events, extra)
			elseif tele.lethal then
				lethalHit(self, boss, e, events, tele.id, a.Id)
			else
				if finite(a.Freeze) then
					if applyStun(self, e, a.Freeze) then
						extra.freeze = a.Freeze
					end
				end
				applyDamage(self, boss, e, fraction * bossBasis(self, e), events, extra)
			end
		end
	end
	if finite(a.Linger) and tele.shape ~= "Line" then
		local perSecond = num(a.LingerDamage, 0.08) * self.avgPetHp * boss.damageMult
		self.zones[#self.zones + 1] = {
			x = tele.x,
			z = tele.z,
			r = tele.r,
			dps = perSecond,
			untilT = self.t + a.Linger,
			nextTick = self.t + ZONE_TICK,
			side = boss.side,
			from = boss,
			kind = "Linger",
		}
		events[#events + 1] = { type = EV.Zone, unit = boss.id, kind = "Linger", attack = a.Id, x = r1(tele.x), z = r1(tele.z), r = tele.r, seconds = a.Linger, side = boss.side }
	end
end

local function spawnMinions(self, boss, wave, waveIndex, events)
	local bc = catalog()
	local def = boss.boss
	local rules = (bc and bc.BossRules) or {}
	local players = self:_playerTeams()
	local count = ceil(num(wave.PerPlayer, 0.5) * players)
	count = max(num(rules.WaveMin, 2), min(num(rules.WaveMax, 8), count))
	local pc = petCatalog()
	local petDef = pc and pc.Get and def.MinionPet and pc.Get(def.MinionPet)
	if not petDef then
		return
	end
	local infos = {}
	for k = 1, count do
		local id = #self.units + 1
		if id > MAX_UNITS then
			break
		end
		local u = unitFromDef(self, boss.team, petDef, { Level = self.avgPetLevel, Tier = "Normal", NoSpecial = true }, 0, "Pet")
		if not u then
			break
		end
		local angle = (k - 1) * (2 * pi / count) + self.t * 0.1
		local r = boss.radius + 3.5
		u.kind = "Minion"
		u.minion = true
		u.name = (def.Minions and def.Minions.Name) or petDef.Name
		u.maxHp = num(rules.MinionHp, 0.9) * self.avgPetHp
		u.hp = u.maxHp
		u.hit = num(rules.MinionDamage, 0.05) * bossBasis(self, { maxHp = self.avgPetHp }) * boss.tierHit
		u.interval = num(rules.MinionInterval, 1.4)
		u.specialPower = 0
		u.specialKind = nil
		u.special = nil
		u.powerMult = 1
		u.x = boss.x + cos(angle) * r
		u.z = boss.z + sin(angle) * r
		clampToFloor(self, u)
		u.px, u.pz = u.x, u.z
		u.nextAttack = self.t + 1 + rand(self) * 0.8
		u.meter = 0
		markArrival(self, u, arriveSeconds())
		boss.team.units[#boss.team.units + 1] = u
		infos[#infos + 1] = unitInfo(u, self.t)
	end
	if #infos > 0 then
		events[#events + 1] = { type = EV.Spawn, units = infos, wave = waveIndex, boss = boss.id, owner = boss.team.owner }
	end
end

-- when the last fighter facing this side's boss thaws (the Dash answers "Stunned" until then)
local function lastThaw(self, side)
	local latest = 0
	for _, team in ipairs(self.teams) do
		local f = team.fighter
		if team.side ~= side and not team.left and f and onFloor(f) then
			latest = max(latest, f.stunUntil)
		end
	end
	return latest
end

local function bossStep(self, boss, events)
	if not boss.alive then
		return
	end
	local def = boss.boss
	local t = self.t
	local rules = (catalog() and catalog().BossRules) or {}
	if not boss.enraged and boss.hp / boss.maxHp <= num(rules.EnrageAt, 0.3) then
		local en = type(rules.Enrage) == "table" and rules.Enrage or { Damage = 2, Cooldown = 0.7, LethalFirst = 4 }
		boss.enraged = true
		boss.damageMult = boss.tierHit * num(en.Damage, 2)
		boss.cooldownMult = num(en.Cooldown, 0.7)
		if boss.lethal then
			boss.lethal.nextAt = t + num(en.LethalFirst, 4)
		end
		events[#events + 1] = { type = EV.Enrage, unit = boss.id }
	end
	local waves = def.Minions and def.Minions.Waves
	if type(waves) == "table" then
		local frac = boss.hp / boss.maxHp
		for i, wave in ipairs(waves) do
			if not boss.wavesDone[i] and frac <= num(wave.At, 0) then
				boss.wavesDone[i] = true
				spawnMinions(self, boss, wave, i, events)
			end
		end
	end
	-- wave 6: a parried boss is staggered: no new basic attack, no new telegraph (those already cast still resolve)
	if t < (boss.staggerUntil or 0) then
		return
	end
	-- the basic attack on the nearest fighter in range (a dash dodges it)
	if t >= boss.nextAttack then
		local target = nearestEnemy(self, boss, boss.range + boss.radius, true) -- (feel-balance: a striking pet at its bite point)
		if target then
			local basic = def.Basic or {}
			boss.target = target
			boss.state = S_ATTACKING
			if inIFrames(self, target) then
				missEvent(self, boss, target, events, { attack = basic.Name or "Basic" })
			else
				applyDamage(self, boss, target, num(basic.Damage, 0.08) * boss.damageMult * bossBasis(self, target), events, { attack = basic.Name or "Basic" })
			end
			boss.nextAttack = t + boss.interval * boss.cooldownMult
		else
			boss.state = S_IDLE
			boss.target = nearestEnemy(self, boss)
			boss.nextAttack = t + 0.5
		end
	end
	local pendingForBoss = false
	for _, tele in ipairs(self.telegraphs) do
		if tele.boss == boss then
			pendingForBoss = true
			break
		end
	end
	-- the lethal goes first: nothing else is pending when it starts and nothing else starts while it is (its warning is
	-- longer than the dash cooldown, so the Dash is always ready for it). A freeze refuses the Dash: while a fighter stays frozen
	-- past the warning's start the cast waits and the boss starts nothing else, so a second freeze can't follow the first
	local lethal = boss.lethal
	if not pendingForBoss and lethal and t >= lethal.nextAt then
		local en = type(rules.Enrage) == "table" and rules.Enrage or {}
		if lastThaw(self, boss.side) > t + num(lethal.def.Telegraph, 3.2) - num(en.LethalWarning, 2.5) then
			return
		end
		if startTelegraph(self, boss, lethal, events) then
			boss.state = S_CASTING
			pendingForBoss = true
		end
		lethal.nextAt = t + num(lethal.def.Cooldown, 22) * boss.cooldownMult
	end
	if not pendingForBoss then
		for _, entry in ipairs(boss.attacks) do
			if not pendingForBoss and t >= entry.nextAt then
				if startTelegraph(self, boss, entry, events) then
					boss.state = S_CASTING
					pendingForBoss = true
				end
				entry.nextAt = t + num(entry.def.Cooldown, 10) * boss.cooldownMult
			end
		end
	end
end

----------------------------------------------------------------------
-- The step
----------------------------------------------------------------------
local function tickZones(self, events)
	local zones = self.zones
	local i = 1
	while i <= #zones do
		local zone = zones[i]
		if self.t >= zone.untilT or (zone.from and zone.from.gone) then
			-- Last strike: on all still inside, at the zone's real end, unless the caster fell or sits on the bench
			if zone.onEnd and self.t >= zone.untilT and onFloor(zone.from) then
				fireDelayed(self, zone.onEnd, events)
			end
			zones[i] = zones[#zones]
			zones[#zones] = nil
		else
			if self.t >= zone.nextTick then
				zone.nextTick = zone.nextTick + ZONE_TICK
				local amount = zone.dps * ZONE_TICK
				local list = self.units
				for k = 1, #list do
					local e = list[k]
					if e.side ~= zone.side and onFloor(e) and inCircle(e, zone.x, zone.z, zone.r) and not inIFrames(self, e) then
						applyDamage(self, zone.from, e, amount, events, { zone = true, kind = zone.kind }, true)
						-- Dragging winds; a boss's immunity stands: one bonus hit per zone instead
						if zone.slow and e.kind == "Boss" then
							if not zone.bonusDone[e.id] then
								zone.bonusDone[e.id] = true
								bossBonus(self, zone.from, e, zone.base, zone.kind, events)
							end
						elseif zone.slow then
							applySlow(self, e, zone.slow, ZONE_TICK + 0.1)
						end
					end
				end
			end
			i = i + 1
		end
	end
end

local function resolveTelegraphs(self, events)
	local list = self.telegraphs
	local i = 1
	while i <= #list do
		local tele = list[i]
		if self.t >= tele.at then
			resolveTelegraph(self, tele, events)
			table.remove(list, i)
		else
			i = i + 1
		end
	end
end

local function moveToward(u, tx, tz, step, stop)
	local dx, dz = tx - u.x, tz - u.z
	local d = sqrt(dx * dx + dz * dz)
	if d <= stop then
		return d
	end
	local travel = min(step, d - stop)
	u.x = u.x + dx / d * travel
	u.z = u.z + dz / d * travel
	return d - travel
end

-- (standoffOf: with the geometry helpers, feel-balance: the strike reads it)

local function teamIndex(team, u)
	local idx, n = 1, 0
	for _, v in ipairs(team.units) do
		if onFloor(v) then
			n = n + 1
			if v == u then
				idx = n
			end
		end
	end
	return idx, max(1, n)
end

-- timers and statuses shared by every unit: shields, burn ticks, regen, meter, the Speed event bookkeeping
local function tickStatuses(self, u, dt, events)
	local t = self.t
	if u.shield > 0 and t >= u.shieldUntil then
		u.shield = 0
		if u.shieldForm or u.thorns then
			shieldBreak(self, u, events)
		end
	end
	if t >= u.slowUntil then
		u.slowMult = 1
	end
	if t >= u.markUntil then
		u.markMult = 1
	end
	if u.burnLeft > 0 and t >= u.burnNextAt then
		u.burnLeft = u.burnLeft - 1
		u.burnNextAt = t + (u.burnStep or 1)
		local from = u.burnFrom
		if from and from.gone then
			from = nil
		end
		applyDamage(self, from, u, u.burnAmount, events, { burn = true }, true)
		if not u.alive then
			return
		end
	end
	if u.regenUntil > t and u.regenRate > 0 and u.hp < u.maxHp then
		u.hp = min(u.maxHp, u.hp + u.maxHp * u.regenRate * dt)
	end
end

-- the NPC pet / minion AI: threat target, melee orbit, a wind-up before every hit
local function npcStep(self, u, dt, events)
	local D = damageRules()
	local F = fighterRules()
	local t = self.t
	local team = u.team
	if u.arriveUntil and t < u.arriveUntil then
		-- arriving (dungeon fixes 3): it stands where it appeared and does nothing yet
		u.state = S_IDLE
		return
	end
	Strike.meter(u, D.MeterPerSecond * dt * (u.meterRate or 1), D.MeterMax)
	if t < u.stunUntil then
		u.state = S_STUNNED
		u.windAt = nil
		return
	end
	if t < u.castUntil then
		u.state = S_CASTING
		return
	end
	local slow = (t < u.slowUntil) and u.slowMult or 1
	-- a wind-up in progress: the hit lands at windAt if the target is still in reach and not dodging
	if u.windAt then
		if t >= u.windAt then
			local target = u.windTarget
			u.windAt = nil
			u.windTarget = nil
			if target and target.alive and not target.gone and not target.benched then
				local reach = u.range + target.radius + standoffOf(D, u) + D.EngageSlack + 1.0
				if dist(u.x, u.z, target.x, target.z) <= reach and not inIFrames(self, target) then
					applyDamage(self, u, target, u.hit, events)
					doubleStrike(self, u, target, events)
				else
					missEvent(self, u, target, events)
				end
			end
			u.state = S_ATTACKING
		else
			u.state = S_ATTACKING
			return
		end
	end
	-- auto specials (never while winding)
	if team.auto and self.specialsEnabled and not team.noSpecials and u.specialKind and u.meter >= D.MeterMax and u.kind ~= "Minion" then
		if u.autoCastAt == nil then
			local lo, hi = D.NpcSpecialDelay[1] or 0.4, D.NpcSpecialDelay[2] or 1.4
			u.autoCastAt = t + lo + (hi - lo) * rand(self)
		elseif t >= u.autoCastAt then
			if autoSpecialWanted(self, u) then
				local ok = castSpecial(self, u, events)
				if ok then
					return
				end
				u.autoCastAt = t + 1
			else
				u.autoCastAt = t + 0.5
			end
		end
	end
	local target = u.target
	if not target or not target.alive or target.gone or target.benched or t >= u.retargetAt or hiddenByRetreat(self, target) then
		target = pickTarget(self, u)
		u.target = target
		u.retargetAt = t + D.RetargetSeconds
	end
	if not target then
		u.state = S_IDLE
		return
	end
	local reach = u.range + target.radius + standoffOf(D, u) -- (battle-feel T2: the melee standoff, the orbit and the engage test alike)
	local tx, tz = target.px, target.pz
	local d = dist(u.x, u.z, tx, tz)
	local moved = false
	if d > reach then
		local step = u.moveSpeed * slow * dt
		if target.kind == "Boss" or not u.ranged then
			-- orbit slot: every pet of a wave approaches on its own angle (surround, not a queue)
			local idx, n = teamIndex(team, u)
			local ax, az = u.x - tx, u.z - tz
			local base = atan2(az, ax)
			if ax == 0 and az == 0 then
				base = 0
			end
			local angle = base + (idx - (n + 1) / 2) * (pi / 6) * ((d > reach * 2) and 1 or 0)
			local r = reach - 0.5
			moveToward(u, tx + cos(angle) * r, tz + sin(angle) * r, step, 0.2)
		else
			moveToward(u, tx, tz, step, reach - 0.3)
		end
		moved = true
		d = dist(u.x, u.z, tx, tz)
	end
	if d <= reach + D.EngageSlack then
		u.state = S_ATTACKING
		if t >= u.nextAttack then
			-- the wind-up is INSIDE the interval: nextAttack counts from its start
			local windup = num(F.Windup, 0.45)
			u.windAt = t + windup
			u.windTarget = target
			u.nextAttack = t + u.interval / slow * (0.9 + 0.2 * rand(self))
			-- (look review r3, major: "about half of an NPC's bites land and chomp 0.10 s before their Hit plays") `at` is
			-- the step the hit lands on: the first step at or past windAt, added up the way Step adds dt (r1(t + 0.45)
			-- rounded x.x5 down on about half the steps, while the hit lands on t + 0.5; the client lands its dash on `at`)
			local landAt = t
			for _ = 1, 1000 do
				landAt = landAt + dt
				if landAt >= u.windAt then
					break
				end
			end
			events[#events + 1] = { type = EV.Windup, unit = u.id, target = target.id, at = r1(landAt) }
			Strike.open(self, u, target, u.windAt) -- (feel-balance) the client lands this bite's dash at windAt
		end
	elseif moved then
		u.state = S_MOVING
	else
		u.state = S_IDLE
	end
end

-- the fighter of a player team: Move toward the character's point at the legal cap; timers; the Auto kit
local autoFighter
local fighterSwing

-- the fighter's attack interval now (Charge / Haste speed it up, a Slow drags it)
local function attackInterval(self, f)
	local t = self.t
	local interval = f.interval
	if t < f.atkSpeedUntil then
		interval = interval / f.atkSpeedMult
	end
	if t < f.speedBuffUntil then
		interval = interval / f.speedBuffMult
	end
	if t < f.slowUntil then
		interval = interval / f.slowMult
	end
	return interval
end

-- current positions: within the fighter's range + the target's radius + slack
local function inReach(f, e, slack)
	local dx, dz = e.x - f.x, e.z - f.z
	local reach = f.range + e.radius + slack
	return dx * dx + dz * dz <= reach * reach
end

-- (feel-balance review) the standoff's share of the auto-attack's reach against `e`: f's standoff when e is the enemy f
-- rests at (f.restOn: its engaged / Auto target or the lock), e's standoff when e rests at f (e.target == f: the gap
-- between them is e's), else 0. Every other enemy is reached as at Standoff 0, so a melee pet does not catch passing
-- minions 8 studs sooner than it would without the standoff (reach unchanged)
local function standoffSlack(D, f, e)
	local so = 0
	if e == f.restOn then
		so = standoffOf(D, f)
	end
	if e.target == f then
		so = max(so, standoffOf(D, e))
	end
	return so
end

-- the auto-attack's target: the lock when targetable and in reach, else the nearest targetable enemy in reach (by id on ties)
local function autoTarget(self, team, f, slack)
	local D = damageRules()
	local lock = lockOf(team)
	if lock and targetable(self, lock) and inReach(f, lock, slack + standoffSlack(D, f, lock)) then
		return lock
	end
	local best, bestD2 = nil, huge
	local list = self.units
	local side = f.side
	for i = 1, #list do
		local e = list[i]
		if e.side ~= side and targetable(self, e) then
			local dx, dz = e.x - f.x, e.z - f.z
			local d2 = dx * dx + dz * dz
			local reach = f.range + e.radius + slack + standoffSlack(D, f, e)
			if d2 <= reach * reach and d2 < bestD2 then
				best, bestD2 = e, d2
			end
		end
	end
	return best
end

-- one auto-attack swing when the fighter can (not Stunned / Casting / Dashing / arriving, the interval ready) -> hit?
function fighterSwing(self, team, f, events)
	local t = self.t
	if team.retreat or not f.alive or f.gone or f.benched or t < f.stunUntil or t < f.castUntil or t < f.dashUntil or arriving(self, f) then
		return false
	end
	local F = fighterRules()
	local interval = attackInterval(self, f)
	if t < f.nextAttack - interval * (1 - num(F.AttackTolerance, 0.85)) then
		return false
	end
	local target = autoTarget(self, team, f, num(F.AttackSlack, 3))
	if not target then
		return false
	end
	f.nextAttack = max(f.nextAttack, t) + interval
	f.attackUntil = t + ATTACK_POSE
	local dx, dz = target.x - f.x, target.z - f.z
	local d = sqrt(dx * dx + dz * dz)
	if d > 0.01 then
		team.faceX, team.faceZ = dx / d, dz / d
	end
	if inIFrames(self, target) then
		missEvent(self, f, target, events)
	else
		applyDamage(self, f, target, f.hit, events)
		doubleStrike(self, f, target, events)
	end
	-- (feel-balance) the client holds a fighter's bite Melee.In (no Windup): its dash lands at t + In
	if f.alive then
		Strike.open(self, f, target, t + Strike.rules(damageRules()))
	end
	return true
end

----------------------------------------------------------------------
-- The engage rule (wave 6): "the pet fights any enemy in the fight area; the trainer's movement never pulls it off"
----------------------------------------------------------------------
-- the enemy an engaged fighter fights: the lock (if targetable), else the current engaged target (sticky until it dies or
-- is untargetable), else the fresh threat, else the targetable enemy nearest to the FIGHTER (ties: the lower id;
-- self.units is in id order). No range: the floor (the fight area) is the bound, the sim clamps every unit to it.
local function engageTarget(self, team, f)
	local lock = lockOf(team)
	if lock and targetable(self, lock) then
		return lock
	end
	local e = team.engage
	if e and e.target and e.target.side ~= team.side and targetable(self, e.target) then
		return e.target
	end
	local threat = f.threat
	if threat and threat.side ~= team.side and targetable(self, threat)
		and self.t - (f.threatAt or -huge) <= num(damageRules().ThreatSeconds, 3) then
		return threat
	end
	local best, bestD = nil, huge
	local list = self.units
	local side = team.side
	for i = 1, #list do
		local u = list[i]
		if u.side ~= side and targetable(self, u) then
			local d = dist(f.x, f.z, u.x, u.z)
			if d < bestD then
				best, bestD = u, d
			end
		end
	end
	return best
end

-- the engaged approach: the honest legal run (no MoveSlack), 0 while Stunned (wave 6: a Dash is the sidestep, never a
-- lunge); melee to reach - 0.5 (NPC parity, well inside AttackSlack), ranged to reach - 1 (it holds at the edge of its
-- range, no kiting)
local function engageStep(self, team, f, target, dt)
	local t = self.t
	local _, run = legalSpeeds(self, team)
	local step = run * dt
	if t < f.stunUntil then
		step = 0
	end
	local reach = f.range + target.radius
	local stop = max(0, f.ranged and (reach - 1.0) or (reach + standoffOf(damageRules(), f) - 0.5)) -- (battle-feel T2: + the melee standoff)
	local ox, oz = f.x, f.z
	if step > 0 then
		moveToward(f, target.x, target.z, step, stop)
	end
	clampToFloor(self, f)
	f.moving = dist(ox, oz, f.x, f.z) > 0.05
	local dx, dz = target.x - f.x, target.z - f.z
	local d = sqrt(dx * dx + dz * dz)
	if d > 0.01 then
		team.faceX, team.faceZ = dx / d, dz / d
	end
end

-- FOLLOW <-> ENGAGED for a player's fighter this step (before it moves) -> the engaged target | nil. Wave 6: no still
-- detector, no pull, no leash, no re-engage cooldown: the Move point plays no part while an enemy is targetable.
local function engageUpdate(self, team, f, events)
	if team.noEngage then
		dropEngage(self, team, events)
		return nil
	end
	local e = team.engage
	if e then
		if e.unit ~= f.id then
			dropEngage(self, team, events)
			return nil
		end
		local target = engageTarget(self, team, f)
		if not target then
			dropEngage(self, team, events)
			return nil
		end
		e.target = target
		return target
	end
	if arriving(self, f) or self.t < f.castUntil then
		return nil
	end
	local target = engageTarget(self, team, f)
	if not target then
		return nil
	end
	team.engage = { target = target, unit = f.id, since = self.t }
	events[#events + 1] = { type = EV.Engage, owner = team.owner, unit = f.id, on = true, target = target.id }
	return target
end

local function fighterStep(self, team, dt, events)
	local f = team.fighter
	if not f or not f.alive or f.gone or f.benched then
		return
	end
	local F = fighterRules()
	local D = damageRules()
	local t = self.t
	if team.retreat then
		team.retreatSeconds = team.retreatSeconds + dt -- (no meter while back; a team with no living fighter is not counted)
	else
		Strike.meter(f, num(F.MeterPerSecond, 6) * dt * (f.meterRate or 1), num(F.SpecialMeterMax, 100))
	end
	if team.auto and not team.npc then
		autoFighter(self, team, f, dt, events)
	end
	-- the engage rule (wave 6); harness Auto teams keep today's exact behaviour (autoFighter drives wantX itself)
	local engaged = nil
	if not team.auto then
		engaged = engageUpdate(self, team, f, events)
	end
	-- (feel-balance review) the enemy this fighter rests at (standoffSlack): the engaged target, else the lock, else the
	-- nearest enemy (an Auto team's target; in play a swinging fighter is always engaged or locked)
	f.restOn = engaged or lockOf(team) or nearestEnemy(self, f) or nil
	if t < f.dashUntil then
		-- wave 6: the Dash sidestep (set at the press) at legal run x the dash factor, then it holds until DashSeconds end
		local left = f.dashLeft or 0
		local ox, oz = f.x, f.z
		if left > 0 and t >= f.stunUntil then
			local _, run = legalSpeeds(self, team)
			local travel = min(left, run * dashSpeedFactor() * dt)
			f.x = f.x + (f.dashDX or 0) * travel
			f.z = f.z + (f.dashDZ or 0) * travel
			f.dashLeft = left - travel
		end
		clampToFloor(self, f)
		f.moving = dist(ox, oz, f.x, f.z) > 0.05
	elseif engaged then
		engageStep(self, team, f, engaged, dt)
	-- movement toward the wanted point at <= legal run x MoveSlack (x the dash factor while Dashing)
	elseif team.wantX ~= nil then
		local _, run = legalSpeeds(self, team)
		local cap = run * num(F.MoveSlack, 1.25)
		if t < f.stunUntil then
			cap = 0
		end
		if cap > 0 then
			local dx, dz = team.wantX - f.x, team.wantZ - f.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				local travel = min(cap * dt, d)
				f.x = f.x + dx / d * travel
				f.z = f.z + dz / d * travel
				team.faceX, team.faceZ = dx / d, dz / d
				f.moving = travel > 0.05
			else
				f.moving = false
			end
		end
	end
	clampToFloor(self, f)
	-- the auto-attack (dungeon fixes 4): the pet swings by itself; the character stays the body (never moved here)
	fighterSwing(self, team, f, events)
	-- the state
	if t < f.stunUntil then
		f.state = S_STUNNED
	elseif t < f.castUntil then
		f.state = S_CASTING
	elseif t < f.dashUntil then
		f.state = S_DASHING
	elseif t < f.attackUntil then
		f.state = S_ATTACKING
	elseif f.moving then
		f.state = S_MOVING
	else
		f.state = S_IDLE
	end
	-- the drawn target: the lock, else the enemy the engaged pet fights (the snapshot's target bit)
	f.target = lockOf(team) or (team.engage and team.engage.target) or nil
	-- dungeon fixes (7): no passive bench regen in combat (only a healing pet's Heal special / Heal buff heals the bench)
end

local doCommand -- forward

-- the harness / Auto fighter: approaches its target at the legal run speed and presses the kit (no dodging: the
-- scripted player of tools/sim_battle.lua does that). It rewrites wantX / wantZ itself every step, so an Auto team never
-- runs the engage rule (fighterStep skips it): the balance harness keeps today's exact numbers.
function autoFighter(self, team, f, dt, events)
	local target = lockOf(team) or nearestEnemy(self, f)
	if not target then
		return
	end
	local _, run = legalSpeeds(self, team)
	local reach = f.range + target.radius + standoffOf(damageRules(), f) -- (battle-feel T2: the melee standoff)
	local dx, dz = target.x - f.x, target.z - f.z
	local d = sqrt(dx * dx + dz * dz)
	local wantX, wantZ = f.x, f.z
	if d > reach - 0.5 and d > 0.01 then
		local travel = min(run * dt, d - (reach - 0.5))
		wantX, wantZ = f.x + dx / d * travel, f.z + dz / d * travel
	end
	team.wantX, team.wantZ = clampPoint(self, wantX, wantZ, f.radius)
	local t = self.t
	if t >= f.castUntil and t >= f.stunUntil then
		if f.meter >= num(fighterRules().SpecialMeterMax, 100) then
			doCommand(self, team, "Special", nil, events)
		end
		-- (the swing itself is the auto-attack of fighterStep)
		if t >= team.elementReadyAt and d <= num(fighterRules().ElementRange, 14) + target.radius then
			doCommand(self, team, "Element", target.id, events)
		end
		for _, u in ipairs(team.units) do
			if u.benched and u.alive and t >= u.buffReadyAt then
				local kind = u.buffKind
				local wanted = true
				if kind == "Heal" or (u.buffDef and u.buffDef.Effect == "Regen") then
					wanted = f.hp < f.maxHp * 0.6
				end
				if wanted then
					doCommand(self, team, "Buff", u.slot, events)
				end
			end
		end
		if f.hp < f.maxHp * 0.2 and t >= team.swapReadyAt then
			for _, u in ipairs(team.units) do
				if u.benched and u.alive and u.hp > u.maxHp * 0.5 then
					doCommand(self, team, "Swap", u.slot, events)
					break
				end
			end
		end
	end
end

-- same-side NPC units are pushed apart so they do not stack
local function separate(self)
	local D = damageRules()
	local r = D.SeparationRadius
	local r2 = r * r
	local list = self.units
	local n = #list
	for i = 1, n - 1 do
		local a = list[i]
		if onFloor(a) and a.kind ~= "Boss" and not (a.team.player and a == a.team.fighter) then
			for j = i + 1, n do
				local b = list[j]
				if onFloor(b) and b.kind ~= "Boss" and b.side == a.side and not (b.team.player and b == b.team.fighter) then
					local dx, dz = b.x - a.x, b.z - a.z
					local d2 = dx * dx + dz * dz
					if d2 < r2 then
						local d = sqrt(d2)
						if d < 0.001 then
							dx, dz, d = ((i % 2 == 0) and 1 or -1), 0.3, 1
						end
						local push = min(0.6, (r - d) * 0.5)
						dx, dz = dx / d, dz / d
						a.x, a.z = a.x - dx * push, a.z - dz * push
						b.x, b.z = b.x + dx * push, b.z + dz * push
					end
				end
			end
		end
	end
end

-- living pets of a side (bench included: the lives)
local function sideLives(self, side)
	local count = 0
	for _, team in ipairs(self.teams) do
		if team.side == side and not team.left then
			count = count + teamLives(team)
		end
	end
	return count
end

local function sideHpFraction(self, side)
	local hp, maxHp = 0, 0
	for _, u in ipairs(self.units) do
		if u.side == side and not u.gone and u.kind ~= "Minion" then
			hp = hp + max(0, u.hp)
			maxHp = maxHp + u.maxHp
		end
	end
	if maxHp <= 0 then
		return 0
	end
	return hp / maxHp
end

local function sideDamage(self, side)
	local d = 0
	for _, team in ipairs(self.teams) do
		if team.side == side then
			d = d + team.damage
		end
	end
	return d
end

local function finish(self, winnerSide, reason, events)
	local result = {
		Mode = self.mode,
		Reason = reason,
		WinnerSide = winnerSide,
		Winners = {},
		Losers = {},
		Draw = winnerSide == nil,
		Forfeit = self.forfeitSeen == true,
		BossId = self.bossId,
		Round = self.round,
		Damage = {},
		Shares = {},
		Duration = r1(self.t),
		Survivors = {},
		Kills = {},
		Waves = self.waveCount or 0,
		Hp = { [1] = sideHpFraction(self, 1), [2] = sideHpFraction(self, 2) },
	}
	local total = 0
	for _, team in ipairs(self.teams) do
		if team.player then
			result.Damage[team.owner] = floor(team.damage + 0.5)
			result.Kills[team.owner] = team.kills
			if team.side == 1 then
				total = total + team.damage
			end
			result.Survivors[team.owner] = teamLives(team)
			if not team.left then
				if winnerSide ~= nil and team.side == winnerSide and not team.forfeited then
					result.Winners[#result.Winners + 1] = team.owner
				elseif winnerSide ~= nil then
					result.Losers[#result.Losers + 1] = team.owner
				end
			end
		end
	end
	for _, team in ipairs(self.teams) do
		if team.player and team.side == 1 then
			result.Shares[team.owner] = (total > 0) and (team.damage / total) or 0
		end
	end
	if self.boss then
		result.BossHp = max(0, floor(self.boss.hp + 0.5))
		result.BossMaxHp = floor(self.boss.maxHp + 0.5)
	end
	-- every player team's pets as they ended (bench included): the Champion Ring carries the HP to the next round
	result.Units = {}
	for _, team in ipairs(self.teams) do
		if team.player then
			local rows = {}
			for _, u in ipairs(team.units) do
				local hp = max(0, floor(u.hp + 0.5))
				rows[#rows + 1] = { Key = u.key, Hp = hp, MaxHp = floor(u.maxHp + 0.5), Alive = u.alive and hp > 0 }
			end
			result.Units[team.owner] = rows
		end
	end
	-- evolved forms: each team's seconds back, against its OWN time in the fight (BattleService's no-free-win rule; a late joiner from its AddTeam)
	result.Retreated = {}
	result.Fought = {}
	for _, team in ipairs(self.teams) do
		if team.player then
			result.Retreated[team.owner] = r1(team.retreatSeconds)
			result.Fought[team.owner] = r1(self.t - team.joinedAt)
		end
	end
	self.result = result
	events[#events + 1] = { type = EV.End, reason = reason, winnerSide = winnerSide }
end

local function byDamage(self)
	local d1, d2 = sideDamage(self, 1), sideDamage(self, 2)
	if d1 > d2 then
		return 1
	elseif d2 > d1 then
		return 2
	end
	return nil
end

local function checkEnd(self, events)
	local lives1 = sideLives(self, 1)
	local mode = self.mode
	if mode == "Raid" then
		local boss = self.boss
		if boss and not boss.alive then
			finish(self, 1, "BossDown", events)
			return
		end
		local activeTeams = 0
		for _, team in ipairs(self.teams) do
			if team.side == 1 and not team.left then
				activeTeams = activeTeams + 1
			end
		end
		if activeTeams == 0 then
			finish(self, nil, "Abandoned", events)
		elseif lives1 == 0 then
			finish(self, 2, "Wipe", events)
		elseif self.t >= self.timeLimit then
			finish(self, 2, "Timeout", events)
		end
		return
	end
	if mode == "Dungeon" then
		local activeTeams = 0
		for _, team in ipairs(self.teams) do
			if team.side == 1 and not team.left then
				activeTeams = activeTeams + 1
			end
		end
		if activeTeams == 0 then
			finish(self, nil, "Abandoned", events)
		elseif lives1 == 0 then
			finish(self, 2, "Wipe", events)
		elseif self.t >= self.timeLimit then
			finish(self, 2, "Timeout", events)
		end
		return
	end
	local lives2 = sideLives(self, 2)
	if lives1 == 0 and lives2 == 0 then
		local rule = damageRules().DoubleKoByDamage
		local winner = nil
		if type(rule) == "table" and rule[mode] and not self.forfeitSeen then
			winner = byDamage(self)
		end
		if winner then
			finish(self, winner, "Wipe", events)
		else
			finish(self, nil, "Draw", events)
		end
	elseif lives1 == 0 then
		finish(self, 2, self.forfeitSeen and "Forfeit" or "Wipe", events)
	elseif lives2 == 0 then
		finish(self, 1, self.forfeitSeen and "Forfeit" or "Wipe", events)
	elseif self.t >= self.timeLimit then
		if mode == "Ring" then
			finish(self, 2, "Timeout", events)
		else
			local rule = damageRules().DoubleKoByDamage
			local winner = nil
			if type(rule) == "table" and rule[mode] then
				winner = byDamage(self)
			else
				local f1, f2 = sideHpFraction(self, 1), sideHpFraction(self, 2)
				if abs(f1 - f2) >= 0.001 then
					winner = (f1 > f2) and 1 or 2
				end
			end
			finish(self, winner, "Timeout", events)
		end
	end
end

-- ends a running battle now: "Cleared" = side 1 wins (the dungeon's last room), anything else = no winner
function BattleSim:Finish(reason)
	if self.result then
		return false
	end
	local events = {}
	reason = type(reason) == "string" and reason or "Aborted"
	finish(self, (reason == "Cleared") and 1 or nil, reason, events)
	return true, events
end

function BattleSim:Abort(reason)
	return self:Finish(reason)
end

-- the Speed event when a fighter's legal speeds change
local function checkSpeeds(self, team, events)
	if not team.player or not team.fighter or team.left then
		return
	end
	local walk, run = legalSpeeds(self, team, true)
	walk, run = r1(walk), r1(run)
	if team.lastWalk ~= walk or team.lastRun ~= run then
		team.lastWalk, team.lastRun = walk, run
		events[#events + 1] = { type = EV.Speed, owner = team.owner, walk = walk, run = run }
	end
end

-- evolved forms: a side-1 player team not left, not back, with a fighter that can be targeted (false: retreated pets are targets again, the boss never stalls)
local function anyEngaged(self)
	for _, team in ipairs(self.teams) do
		if team.side == 1 and team.player and not team.left and not team.retreat and team.fighter and hittable(self, team.fighter) then
			return true
		end
	end
	return false
end

function BattleSim:Step(dt)
	local events = {}
	if self.result then
		return events
	end
	dt = tonumber(dt) or 0.1
	if dt ~= dt or dt < MIN_DT then
		dt = MIN_DT
	elseif dt > MAX_DT then
		dt = MAX_DT
	end
	self.t = self.t + dt
	self.stepCount = self.stepCount + 1
	if #self.pending > 0 then
		for _, ev in ipairs(self.pending) do
			events[#events + 1] = ev
		end
		self.pending = {}
	end
	self.anyEngaged = anyEngaged(self)
	-- (feel-balance) the body points of this step, before the boss, the telegraphs, the delayed effects and the zones read them
	Strike.refresh(self)
	if self.boss then
		bossStep(self, self.boss, events)
	end
	resolveTelegraphs(self, events)
	resolveDelayed(self, events)
	tickZones(self, events)
	local list = self.units
	local n = #list
	local order = self.order
	for i = 1, n do
		local u = list[i]
		u.px, u.pz = u.x, u.z
		order[i] = i
	end
	for i = n, 2, -1 do
		local j = 1 + floor(rand(self) * i)
		order[i], order[j] = order[j], order[i]
	end
	for i = 1, n do
		local u = list[order[i]]
		if u.alive and not u.gone and u.kind ~= "Boss" then
			tickStatuses(self, u, dt, events)
			if u.alive and not u.benched and not (u.team.player and u == u.team.fighter) then
				npcStep(self, u, dt, events)
			end
		end
	end
	-- the fighters (incl. their auto-attack): the team order alternates every step, so in a mirror race no side always
	-- swings first (deterministic: it follows the step count)
	local teams = self.teams
	local nTeams = #teams
	local reverse = self.stepCount % 2 == 0
	for k = 1, nTeams do
		local team = teams[reverse and (nTeams + 1 - k) or k]
		if team.player and not team.left then
			fighterStep(self, team, dt, events)
		end
	end
	separate(self)
	for i = 1, #list do
		local u = list[i]
		if onFloor(u) then
			clampToFloor(self, u)
		end
	end
	for _, team in ipairs(self.teams) do
		checkSpeeds(self, team, events)
	end
	checkEnd(self, events)
	return events
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function unitArg(self, team, arg)
	local id = tonumber(arg)
	if not id or id ~= floor(id) then
		return nil
	end
	local unit = self.units[id]
	if not unit or not onFloor(unit) or unit.side == team.side then
		return nil
	end
	return unit
end

-- Attack() with no id, no live lock and no engaged target: the nearest targetable enemy (ties by id so it is deterministic).
-- Bug #16: the old "a press on the lock cycles to the next" is gone (it walked the pet off its enemy); the deliberate
-- re-target is the client's hold-F / Tab / RT -> Target(next id)
local function nearestTarget(self, team, f)
	local list = {}
	for _, e in ipairs(self.units) do
		if e.side ~= team.side and targetable(self, e) then
			local dx, dz = e.x - f.x, e.z - f.z
			list[#list + 1] = { e = e, d2 = dx * dx + dz * dz }
		end
	end
	if #list == 0 then
		return nil
	end
	table.sort(list, function(a, b)
		if a.d2 ~= b.d2 then
			return a.d2 < b.d2
		end
		return a.e.id < b.e.id
	end)
	return list[1].e
end

-- wave 6: the timed threats on fighter `f`, soonest first: { at, kind = "Windup" | "Tele", src (the attacker), tele | nil }.
-- An NPC wind-up aimed at it, a pending boss telegraph whose shape covers it (a boss basic attack has no tell: none).
local function findThreats(self, f)
	local out = {}
	local list = self.units
	for i = 1, #list do
		local u = list[i]
		if u.windAt and u.windTarget == f and u.alive and not u.gone and u.side ~= f.side then
			out[#out + 1] = { at = u.windAt, kind = "Windup", src = u, order = #out }
		end
	end
	for _, tele in ipairs(self.telegraphs) do
		local boss = tele.boss
		if boss and boss.alive and boss.side ~= f.side then
			local inside
			if tele.shape == "Line" then
				inside = inLine(f, tele.x, tele.z, tele.angle, tele.length, tele.width)
			else
				inside = inCircle(f, tele.x, tele.z, tele.r)
			end
			if inside then
				out[#out + 1] = { at = tele.at, kind = "Tele", src = boss, tele = tele, order = #out }
			end
		end
	end
	table.sort(out, function(a, b)
		if a.at ~= b.at then
			return a.at < b.at
		end
		return a.order < b.order
	end)
	return out
end

-- a unit vector, or nil when (dx, dz) is (near) zero
local function unitVec(dx, dz)
	local d = sqrt(dx * dx + dz * dz)
	if d < 0.01 then
		return nil
	end
	return dx / d, dz / d
end

-- wave 6: the Dash sidestep (Builder decision 4) -> dx, dz (unit), length (studs), the threat's source | nil.
-- Candidates in order; the first whose clamped end point clears the threat (or, with no threat, is not closer to the
-- aim) wins, else the best scoring one. A zero vector falls back to the facing turned 90 degrees.
local function sidestep(self, team, f, threat)
	local F = fighterRules()
	local _, run = legalSpeeds(self, team)
	local maxLen = run * dashSpeedFactor() * num(F.DashSeconds, 0.35)
	local fx, fz = team.faceX or 0, team.faceZ or 1
	local turnX, turnZ = unitVec(fz, -fx)
	if not turnX then
		turnX, turnZ = 1, 0
	end
	-- toward the floor centre (0, 0) first among a perpendicular pair
	local function perpPair(ax, az)
		local p1x, p1z = az, -ax
		if p1x * -f.x + p1z * -f.z < 0 then
			p1x, p1z = -p1x, -p1z
		end
		return p1x, p1z, -p1x, -p1z
	end
	local candidates = {}
	local need, hop = 4, nil
	local escapes, score
	local src = threat and threat.src or nil
	if threat and threat.kind == "Tele" and threat.tele.shape == "Line" then
		local tele = threat.tele
		local dirX, dirZ = cos(tele.angle), sin(tele.angle)
		local cross = (f.x - tele.x) * dirZ - (f.z - tele.z) * dirX
		local nx, nz = dirZ, -dirX
		if cross < 0 or (abs(cross) < 0.01 and nx * -f.x + nz * -f.z < 0) then
			nx, nz = -nx, -nz
		end
		candidates = { { nx, nz }, { -nx, -nz } }
		need = tele.width / 2 + f.radius - abs(cross) + 1
		escapes = function(x, z)
			return not pointInLine(x, z, f.radius, tele.x, tele.z, tele.angle, tele.length, tele.width)
		end
		score = function(x, z)
			return abs((x - tele.x) * dirZ - (z - tele.z) * dirX)
		end
	elseif threat then
		local cx, cz, reach
		if threat.kind == "Tele" then
			cx, cz, reach = threat.tele.x, threat.tele.z, threat.tele.r + f.radius
		else
			cx, cz = src.x, src.z
			reach = src.range + f.radius + num(damageRules().EngageSlack, 0.6) + 1.0
		end
		local ax, az = unitVec(f.x - cx, f.z - cz)
		if not ax then
			ax, az = turnX, turnZ
		end
		local p1x, p1z, p2x, p2z = perpPair(ax, az)
		candidates = { { ax, az }, { p1x, p1z }, { p2x, p2z } }
		local d0 = dist(f.x, f.z, cx, cz)
		need = reach - d0 + 1
		escapes = function(x, z)
			return dist(x, z, cx, cz) > reach
		end
		if threat.kind == "Windup" then
			-- a wind-up: a short hop that stays inside the attacker's reach (the i-frames / the parry are the defence, not the
			-- distance: an early Dash must not dodge it for free)
			hop = max(1, min(4, reach - d0 - 0.5))
			escapes = function(x, z)
				return dist(x, z, cx, cz) >= d0 - 1e-6
			end
		end
		score = function(x, z)
			return dist(x, z, cx, cz)
		end
	else
		local aim = lockOf(team)
		if aim and not targetable(self, aim) then
			aim = nil
		end
		if not aim and team.engage and targetable(self, team.engage.target) then
			aim = team.engage.target
		end
		aim = aim or nearestEnemy(self, f)
		local ax, az = nil, nil
		if aim then
			ax, az = unitVec(aim.x - f.x, aim.z - f.z)
		end
		if not ax then
			ax, az = unitVec(fx, fz)
		end
		if not ax then
			ax, az = 0, 1
		end
		local p1x, p1z, p2x, p2z = perpPair(ax, az)
		candidates = { { p1x, p1z }, { p2x, p2z }, { -ax, -az } }
		local d0 = aim and dist(f.x, f.z, aim.x, aim.z) or 0
		escapes = function(x, z)
			return not aim or dist(x, z, aim.x, aim.z) >= d0 - 1e-6
		end
		score = function(x, z)
			return aim and dist(x, z, aim.x, aim.z) or 0
		end
	end
	local len = hop or max(4, min(maxLen, need))
	local function tries(x, z, l)
		local ex, ez = clampPoint(self, f.x + x * l, f.z + z * l, f.radius)
		return escapes(ex, ez) and dist(f.x, f.z, ex, ez) > min(0.5, l * 0.5), score(ex, ez)
	end
	local best, bestScore, bestLen = nil, -huge, len
	for _, c in ipairs(candidates) do
		local ok, s = tries(c[1], c[2], len)
		if ok then
			return c[1], c[2], len, src
		end
		if s > bestScore + 1e-9 then
			best, bestScore = c, s
		end
	end
	-- a wall / corner blocks every candidate (Review Focus 3): for a telegraph, the 8 compass directions, nearest to the
	-- first candidate first, each lengthened up to the full dash; still nothing (or no threat: a run along the wall would
	-- pass closer to the aim) = the best scoring candidate (never closer, on the floor)
	if not hop and threat then
		local first = candidates[1]
		local dirs = {}
		for k = 0, 7 do
			local a = k * pi / 4
			local x, z = cos(a), sin(a)
			dirs[#dirs + 1] = { x, z, -(x * first[1] + z * first[2]), k }
		end
		table.sort(dirs, function(a, b)
			if abs(a[3] - b[3]) > 1e-9 then
				return a[3] < b[3]
			end
			return a[4] < b[4]
		end)
		for _, c in ipairs(dirs) do
			local l = len
			while l <= maxLen + 1e-9 do
				if tries(c[1], c[2], l) then
					return c[1], c[2], l, src
				end
				l = l + 2
			end
		end
	end
	return best[1], best[2], bestLen, src
end

-- the body of Command; `events` collects what the command causes (the caller queues them)
function doCommand(self, team, action, arg, events)
	local F = fighterRules()
	local t = self.t
	local f = team.fighter
	if action == "Forfeit" then
		if self.mode == "Raid" or self.mode == "Dungeon" then
			self:RemoveTeam(team.owner)
			return true
		end
		team.forfeited = true
		self.forfeitSeen = true
		for _, u in ipairs(team.units) do
			if u.alive then
				knockOut(self, u, nil, events, true)
			end
		end
		events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Forfeit" }
		return true
	end
	if not team.player then
		return false, "NotPlayer"
	end
	if (action == "Retreat" or action == "Engage") and self.mode ~= "Raid" then
		return false, "NoRetreat"
	end
	if not f or not f.alive then
		return false, "Down"
	end
	if action == "Retreat" then
		-- no busy check: a stunned / casting / dashing pet runs once it can, the dodge applies now
		if team.retreat then
			return false, "Retreated"
		end
		if t < team.retreatReadyAt then
			return false, "Cooldown", r1(team.retreatReadyAt - t)
		end
		team.retreat = { since = t }
		team.noEngage = true
		dropEngage(self, team, events)
		team.lock = nil
		f.iframesUntil = max(f.iframesUntil or 0, t + num(F.RetreatDodge, 0.5))
		events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Retreat" }
		return true
	elseif action == "Engage" then
		if not team.retreat then
			return false, "NotRetreated"
		end
		team.retreat = nil
		team.noEngage = nil
		team.retreatReadyAt = t + num(F.RetreatWait, 10)
		events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Engage" }
		return true
	end
	if team.retreat and (action == "Attack" or action == "Element" or action == "Special") then
		return false, "Retreated"
	end
	if action == "Target" then
		if arg == nil then
			team.lock = nil
			events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Target" }
			return true
		end
		local unit = unitArg(self, team, arg)
		if not unit then
			return false, "BadTarget"
		end
		team.lock = unit
		events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Target", target = unit.id }
		return true
	end
	local busy = nil
	if t < f.stunUntil then
		busy = "Stunned"
	elseif t < f.castUntil then
		busy = "Casting"
	end
	if action == "Attack" then
		-- dungeon fixes (4): ATTACK directs the auto-attacking pet (a lock); it never swings by itself
		local target = nil
		if arg ~= nil then
			target = unitArg(self, team, arg)
			if not target then
				return false, "BadTarget"
			end
		else
			-- bug #16: a live lock is KEPT (F never pulls the pet off its enemy; no echo below); wave 6: anywhere on the
			-- floor (no EngageRange), else the enemy the engaged pet already fights, else the nearest
			local lock = lockOf(team)
			local fighting = team.engage and team.engage.target or nil
			if lock and targetable(self, lock) then
				target = lock
			elseif fighting and targetable(self, fighting) then
				target = fighting
			else
				target = nearestTarget(self, team, f)
			end
			if not target then
				return false, "NoTarget"
			end
		end
		-- the echo only when the lock changes (a repeated order on the same enemy sends nothing: no traffic amplification)
		if team.lock ~= target then
			events[#events + 1] = { type = EV.Order, owner = team.owner, order = "Attack", target = target.id }
		end
		team.lock = target
		f.target = target
		if not inReach(f, target, num(F.AttackSlack, 3) + standoffOf(damageRules(), f)) then
			return true, target.id, "OutOfReach"
		end
		return true, target.id
	elseif action == "Element" then
		if busy then
			return false, busy
		end
		if t < team.elementReadyAt then
			return false, "Cooldown", r1(team.elementReadyAt - t)
		end
		return castElement(self, team, f, arg, events)
	elseif action == "Special" then
		if not self.specialsEnabled or team.noSpecials then
			return false, "Disabled"
		end
		if busy then
			return false, busy
		end
		if not f.specialKind then
			return false, "NoSpecial"
		end
		if f.meter < num(F.SpecialMeterMax, 100) then
			return false, "Charging", floor(f.meter + 0.5)
		end
		return castSpecial(self, f, events)
	elseif action == "Dash" then
		if t < f.stunUntil then
			return false, "Stunned"
		end
		if t < team.dashReadyAt then
			return false, "Cooldown", r1(team.dashReadyAt - t)
		end
		if f.sTo then
			Strike.close(f) -- (feel-balance) the dash starts from where the pet really is: its body point is its rest spot at once
		end
		f.dashUntil = t + num(F.DashSeconds, 0.35)
		f.iframesUntil = t + num(F.DashIFrames, 0.35)
		team.dashReadyAt = t + num(F.DashCooldown, 2.5) * rechargeOf(self, f)
		f.state = S_DASHING
		-- wave 6: the timed threats; those landing inside ParryWindow are PARRIED (the i-frames already make them miss)
		local threats = findThreats(self, f)
		local window = num(F.ParryWindow, 0.25)
		local parries = {}
		for _, th in ipairs(threats) do
			if th.at > t - 1e-9 and th.at - t <= window + 1e-6 then
				local src = th.src
				if not team.retreat then
					Strike.meter(f, num(F.ParryMeter, 8), num(F.SpecialMeterMax, 100))
				end
				if src.kind == "Boss" then
					-- applyStun refuses bosses: a short stagger instead (no new basic attack / telegraph), once per ParryBossGap
					if t - (src.staggerAt or -huge) >= num(F.ParryBossGap, 3) then
						src.staggerUntil = t + num(F.ParryStagger, 0.4)
						src.staggerAt = t
					end
				else
					applyStun(self, src, num(F.ParryStagger, 0.4)) -- also cancels its wind-up
				end
				if th.tele then
					th.tele.parried = th.tele.parried or {}
					th.tele.parried[f.id] = true
				end
				parries[#parries + 1] = { type = EV.Parry, unit = f.id, from = src.id, tele = th.tele and th.tele.id or nil }
			end
		end
		local dx, dz, len, src = sidestep(self, team, f, threats[1])
		f.dashDX, f.dashDZ, f.dashLeft = dx, dz, len
		-- small on the wire (16-raid budget): the position comes from the snapshot, the timings from BattleCatalog.Fighter
		events[#events + 1] = { type = EV.Dash, unit = f.id, dir = { floor(dx * 100 + 0.5) / 100, floor(dz * 100 + 0.5) / 100 }, target = src and src.id or nil }
		for _, ev in ipairs(parries) do
			events[#events + 1] = ev
		end
		return true
	elseif action == "Cheer" then
		-- wave 6: the trainer's "Cheer up!" (dungeon + raid only; the Ring / PvP podium cheer is visual only)
		if self.mode ~= "Raid" and self.mode ~= "Dungeon" then
			return false, "NoCheer"
		end
		if t < team.cheerReadyAt then
			return false, "Cooldown", r1(team.cheerReadyAt - t)
		end
		-- SET, never add: a cheer never stacks
		team.cheerUntil = t + num(F.CheerSeconds, 5)
		team.cheerReadyAt = t + num(F.CheerCooldown, 20)
		events[#events + 1] = { type = EV.Cheer, owner = team.owner, unit = f.id, untilT = r1(team.cheerUntil) }
		return true
	elseif action == "Buff" then
		local slot = tonumber(arg)
		if not slot or slot ~= floor(slot) or slot < 1 then
			return false, "BadSlot"
		end
		local helper = team.bySlot[slot]
		if not helper then
			return false, "BadSlot"
		end
		if not helper.alive then
			return false, "Down"
		end
		if not helper.benched then
			return false, "BadSlot"
		end
		if not helper.buffDef then
			return false, "NoBuff"
		end
		if t < helper.buffReadyAt then
			return false, "Cooldown", r1(helper.buffReadyAt - t)
		end
		local buff = helper.buffDef
		local cooldown = (helper.role == "Support") and num(F.SupportCooldown, 12) or num(F.HelperCooldown, 15)
		helper.buffReadyAt = t + cooldown
		local ev = { type = EV.Buff, owner = team.owner, unit = helper.id, kind = helper.buffKind, name = buff.Name, target = f.id }
		applyBuff(self, f, buff, helper.specialBoost, events, ev)
		if buff.Effect == "Heal" then
			-- dungeon fixes (7): a healing helper heals the fighter AND the other benched pet
			ev.heals = { { f.id, ev.amount or 0 } }
			for _, other in ipairs(team.units) do
				if other ~= helper and other ~= f and other.benched and other.alive and not other.gone then
					local tmp = {}
					applyBuff(self, other, buff, helper.specialBoost, events, tmp)
					ev.heals[#ev.heals + 1] = { other.id, tmp.amount or 0 }
				end
			end
		end
		events[#events + 1] = ev
		return true, helper.buffKind
	elseif action == "Swap" then
		local slot = tonumber(arg)
		if not slot or slot ~= floor(slot) or slot < 1 then
			return false, "BadSlot"
		end
		local helper = team.bySlot[slot]
		if not helper then
			return false, "BadSlot"
		end
		if not helper.alive then
			return false, "Down"
		end
		if not helper.benched then
			return false, "BadSlot"
		end
		if busy then
			return false, busy
		end
		if t < team.swapReadyAt then
			return false, "Cooldown", r1(team.swapReadyAt - t)
		end
		team.swapReadyAt = t + num(F.SwapCooldown, 10)
		swapIn(self, team, helper, events, false)
		return true, helper.id
	end
	return false, "UnknownAction"
end

function BattleSim:Command(owner, action, arg, arg2)
	if self.result then
		return false, "Finished"
	end
	local team = self.teamByOwner[owner]
	if not team then
		return false, "NoTeam"
	end
	if team.left then
		return false, "Left"
	end
	if team.forfeited then
		return false, "Forfeited"
	end
	if action == "Move" then
		if not team.player then
			return false, "NotPlayer"
		end
		local x, z = arg, arg2
		if type(arg) == "table" then
			x, z = arg.x or arg.X or arg[1], arg.z or arg.Z or arg[2]
		end
		if not finite(x) or not finite(z) then
			return false, "BadPoint"
		end
		local f = team.fighter
		team.wantX, team.wantZ = clampPoint(self, x, z, f and f.radius or 1)
		return true
	end
	if type(action) ~= "string" then
		return false, "UnknownAction"
	end
	local events = {}
	local ok, reason, extra = doCommand(self, team, action, arg, events)
	if not ok then
		if reason == "UnknownAction" then
			return false, reason
		end
		-- one rejected echo per team per step (a held ATTACK button must not flood the clients)
		if team.rejectStep ~= self.stepCount then
			team.rejectStep = self.stepCount
			self.pending[#self.pending + 1] = { type = EV.Order, owner = owner, order = action, target = tonumber(arg), rejected = reason }
		end
		return false, reason, extra
	end
	for _, ev in ipairs(events) do
		self.pending[#self.pending + 1] = ev
	end
	return true, reason, extra
end

-- A team leaves (raids / dungeons: leave / disconnect). Its units vanish and the boss sheds their HP share.
function BattleSim:RemoveTeam(owner)
	local team = self.teamByOwner[owner]
	if not team or team.left then
		return false
	end
	team.left = true
	dropEngage(self, team, nil)
	local ids = {}
	for _, u in ipairs(team.units) do
		ids[#ids + 1] = u.id
		u.alive = false
		u.gone = true
		u.state = S_DOWN
		u.target = nil
		u.windAt = nil
	end
	for _, other in ipairs(self.teams) do
		if other.lock and other.lock.gone then
			other.lock = nil
		end
	end
	local boss = self.boss
	if boss and boss.alive and team.side == 1 and team.player then
		local frac = boss.hp / boss.maxHp
		boss.maxHp = max(1, self:_bossMaxHp())
		boss.hp = max(1, min(frac * boss.maxHp, boss.maxHp))
	end
	self:_refreshRaidScale()
	self.pending[#self.pending + 1] = { type = EV.Leave, owner = owner, units = ids }
	return true
end

return BattleSim
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">BossBuilder</string>
          <string name="Source"><![CDATA[-- BossBuilder (Phase 3, events): the four arena bosses as big DETAILED-VOXEL models (ARCHITECTURE_V3.md "Phase 3:
-- Pet battles", "Phase 3 build contract": EventService + BossBuilder; ART DIRECTION). Built on the CLIENT from a
-- BattleCatalog boss id (BattleController builds the raid boss; the server never moves these parts: Replication rule)
-- and animated locally between snapshots. Works in the Workspace and in ViewportFrames. Plain Lua 5.1-compatible.
--
-- API
--   BossBuilder.Build(bossId, opts) -> Model | nil
--       opts = { Detail = "High" | "Low" (default High; Low merges shades: about half the parts), Scale = n (default
--       BattleCatalog.Bosses[id].Scale or 1), CFrame = where the feet centre stands (LookVector = facing; default
--       identity), Parent, Pose = "Idle" (the first pose applied), PoseTime = 0, Tier = a BattleCatalog.RaidTiers id (the
--       scale grows by the tier's Scale, then SetTier dresses it; nil = no dressing, today's boss), NoAura = true (see SetTier) }.
--       The sculpt runs once per (bossId, detail, scale) and is cached: later builds clone it (fast). Call
--       BossBuilder.Preload(bossId, { Tier }) ahead of a fight so its start never hitches.
--   BossBuilder.Animate(model, pose, t, opts)   applies a pose at time t (seconds, any running clock):
--       pose = "Idle" | "Windup" | "Attack" | "Basic" | "Enrage" | "Hurt" | "Down"
--       opts = { CFrame = the root CFrame this frame (the client's interpolated boss position; default: unchanged),
--                Progress = 0..1 (how far into a Windup / Attack / Basic / Enrage / Hurt / Down; default from t),
--                Attack = attack id (BattleCatalog.Bosses[id].Attacks[i].Id: picks the move, e.g. a one-arm zap or
--                the two-arm slam), Enraged = true (faster, fiercer idle),
--                LookAt = Vector3 (world): the head joint(s) turn toward it, at most 1 rad either way (the builder is stateless:
--                the caller smooths it); nil = today's pose }
--       One BulkMoveTo per call (parts are anchored; only Workspace:BulkMoveTo or CFrame writes, nothing per part
--       allocated): cheap enough every frame for the one raid boss.
--   BossBuilder.SetEnraged(model, on)           the glowing parts (Glow / Eye / Bolt / Magma ... keys) turn the boss's
--                                               enrage colour (and back); the core light brightens
--   BossBuilder.TierLooks[tierId]               { Color, Aura, Crown } per fight tier
--   BossBuilder.SetTier(model, tierId, opts) -> ok  dresses a built boss for a fight tier (again with another tier; nil takes it off;
--                                               an unknown tier is refused). The boss keeps its own colours (no tint: every glow
--                                               part stays its sculpt colour; the enrage colours win while enraged); the tier
--                                               shows in a TierAura emitter and a TierLight on Fx_Core (both in the tier's
--                                               Color), Max's TierCrown of 8 Neon spikes (rig parts: Animate moves them) and the
--                                               name plate; model attribute Tier.
--                                               No aura on a Low boss or with opts.NoAura = true (Graphics Low)
--   BossBuilder.Colors(bossId) -> { Glow, Telegraph, Edge, Enrage, Element }   (Color3s)
--   BossBuilder.TelegraphColor(bossId, attackId) -> fill Color3, edge Color3     colour of a floor telegraph
--   BossBuilder.FxPoint(model, name) -> Vector3 | nil   world position of a named effect point ("Mouth", "HandL",
--                                               "HandR", "Core", "Head1".."Head3", "Tail", "Crown"; see Rigs)
--   BossBuilder.GetHeight(model) -> studs       (also attribute Height; Radius = attribute Radius)
--   BossBuilder.Ids() -> { bossId... }          BattleCatalog.BossOrder (or the built-in list)
--   BossBuilder.Rigs[bossId]                    { Joints = { name -> { Parent, Pivot (voxels) } }, Fx = {...} }
--   BossBuilder.MeshKeys(bossId, detail) -> { "boss_<id>_<Joint>[_low]", ... }   Phase 6 Blender keys, joint order
--   BossBuilder.UsesMeshes(bossId, detail) -> bool   every key ready here (MeshLibrary): Build assembles MeshParts
--       (same tree, names by palette key, joint attributes, Fx points, rig; model attribute ML_Mesh = true);
--       otherwise (no ids, loading, failed) the voxel Part build exactly as before. Never a mix.
--
-- Model layout (names are part of the contract: BattleController animates / attaches effects by them):
--   Boss_<id> (Model; attributes BossId, Element, Height, Radius, Detail, Scale; PrimaryPart = Root)
--     Root      invisible 1-stud part at the feet centre (the model's pivot; LookVector = facing)
--     Body      Model  the torso (every boss); its parts are named by palette key (Rock, Cloud, Scale, Glow, ...)
--     Head      Model  storm_titan / lava_golem / frost_wyrm          Jaw   Model  frost_wyrm (opens for the breath)
--     ArmL/ArmR Model  storm_titan / lava_golem (the fists that slam) Base  Model  storm_titan (its spinning vortex)
--     WingL/WingR Model frost_wyrm                                     Head1/Head2/Head3 Model shadow_hydra (L, C, R)
--     TierCrown Model  a Max boss's 8 spikes (SetTier; not a joint: each spike follows the joint under the crown)
--   Every joint Model has attributes Pivot (Vector3, studs, Root space at rest) and JointParent (string, "" = Root).
--   Effect points are Attachments named "Fx_<name>" inside the joint that carries them.
-- Facing: -Z (Root.CFrame.LookVector). The bosses are 22-27 studs tall at Scale 1 (VoxelSize 0.5 stud), so they read
-- from the colosseum stands; High <= ~950 parts, Low <= ~700 (Low merges shades first).

local Shared = script.Parent
local Voxel = require(Shared:WaitForChild("Voxel"))
local FxSprites = require(Shared:WaitForChild("FxSprites")) -- the tier aura's soft glow (kit B X1)

local BossBuilder = {}

local sin, cos, pi, max, min, floor, abs = math.sin, math.cos, math.pi, math.max, math.min, math.floor, math.abs

local VOXEL = 0.5 -- studs per voxel at Scale 1

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local lazyCatalog = nil
local function battleCatalog()
	if lazyCatalog == nil then
		lazyCatalog = false
		local inst = Shared:FindFirstChild("BattleCatalog")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				lazyCatalog = mod
			end
		end
	end
	return lazyCatalog or nil
end

local DEFAULT_IDS = { "storm_titan", "lava_golem", "frost_wyrm", "shadow_hydra" }

function BossBuilder.Ids()
	local bc = battleCatalog()
	local out = {}
	local src = (bc and type(bc.BossOrder) == "table" and #bc.BossOrder > 0) and bc.BossOrder or DEFAULT_IDS
	for i, id in ipairs(src) do
		out[i] = id
	end
	return out
end

----------------------------------------------------------------------
-- Colours: the glow, the floor telegraphs (fill + edge) and the enrage tint per boss
----------------------------------------------------------------------
local COLORS = {
	storm_titan = { Element = "Storm", Glow = rgb(110, 210, 255), Telegraph = rgb(80, 190, 255), Edge = rgb(255, 238, 140), Enrage = rgb(255, 92, 92) },
	lava_golem = { Element = "Flame", Glow = rgb(255, 112, 34), Telegraph = rgb(255, 104, 36), Edge = rgb(255, 214, 96), Enrage = rgb(255, 44, 44) },
	frost_wyrm = { Element = "Frost", Glow = rgb(140, 232, 255), Telegraph = rgb(110, 214, 255), Edge = rgb(240, 252, 255), Enrage = rgb(96, 120, 255) },
	shadow_hydra = { Element = "Shadow", Glow = rgb(196, 112, 255), Telegraph = rgb(170, 88, 255), Edge = rgb(255, 140, 236), Enrage = rgb(255, 60, 150) },
}
-- per attack overrides (BattleCatalog attack ids): fill, edge
local ATTACK_COLORS = {
	storm_titan = { slam = { rgb(80, 190, 255), rgb(255, 238, 140) }, chain = { rgb(255, 230, 110), rgb(255, 255, 220) } },
	lava_golem = { pool = { rgb(255, 128, 40), rgb(255, 214, 96) }, eruption = { rgb(255, 64, 32), rgb(255, 196, 80) } },
	frost_wyrm = { breath = { rgb(110, 214, 255), rgb(240, 252, 255) }, blizzard = { rgb(200, 236, 255), rgb(110, 190, 255) } },
	shadow_hydra = { fangs = { rgb(170, 88, 255), rgb(255, 140, 236) }, pulse = { rgb(236, 72, 200), rgb(255, 190, 250) } },
}

local FALLBACK_COLORS = { Element = "Storm", Glow = rgb(255, 220, 120), Telegraph = rgb(255, 90, 70), Edge = rgb(255, 230, 160), Enrage = rgb(255, 50, 50) }

-- the same boss dressed for its fight tier (BattleCatalog.RaidTiers; the size is the tier's Scale there)
BossBuilder.TierLooks = {
	Starter = { Color = rgb(150, 210, 150), Aura = 0 },
	Mid = { Color = rgb(90, 160, 255), Aura = 0.5 },
	High = { Color = rgb(200, 110, 255), Aura = 1 },
	Max = { Color = rgb(255, 170, 60), Aura = 1.5, Crown = true },
}

function BossBuilder.Colors(bossId)
	local c = COLORS[bossId] or FALLBACK_COLORS
	return { Element = c.Element, Glow = c.Glow, Telegraph = c.Telegraph, Edge = c.Edge, Enrage = c.Enrage }
end

function BossBuilder.TelegraphColor(bossId, attackId)
	local per = ATTACK_COLORS[bossId]
	local a = per and per[attackId]
	if a then
		return a[1], a[2]
	end
	local c = COLORS[bossId] or FALLBACK_COLORS
	return c.Telegraph, c.Edge
end

----------------------------------------------------------------------
-- Sculpt helpers (voxel units; y up from the feet, the boss faces -Z, +X is its right)
----------------------------------------------------------------------
-- Phase 6 kit hook (read-only; the game never sets it): BossBuilder._Blueprint sculpts at k voxels per boss voxel
local MESH_K = nil
local MESH_FIELDS = { Center = true, A = true, B = true, Pivot = true, Radius = true, RadiusB = true, Size = true, Round = true, Thickness = true, ThicknessB = true }
local function meshScaled(t)
	local o = {}
	for key, v in pairs(t) do
		if MESH_FIELDS[key] then
			if type(v) == "number" then
				v = v * MESH_K
			elseif type(v) == "table" then
				local c = {}
				for i, x in pairs(v) do
					c[i] = (type(x) == "number") and x * MESH_K or x
				end
				v = c
			end
		elseif key == "Points" or key == "Radii" then
			local list = {}
			for i, pt in ipairs(v) do
				if type(pt) == "number" then
					list[i] = pt * MESH_K
				else
					list[i] = { pt[1] * MESH_K, pt[2] * MESH_K, pt[3] * MESH_K }
				end
			end
			v = list
		end
		o[key] = v
	end
	return o
end

local function shape(g, t)
	if MESH_K then
		t = meshScaled(t)
	end
	return Voxel.Shape(g, t)
end
local function ell(g, key, c, r, extra)
	local t = { Kind = "Ellipsoid", Center = c, Radius = r, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function cap(g, key, a, b, r, rb, extra)
	local t = { Kind = "Capsule", A = a, B = b, Radius = r, RadiusB = rb, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function cone(g, key, a, b, r, rb, extra)
	local t = { Kind = "Cone", A = a, B = b, Radius = r, RadiusB = rb or 0, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function curve(g, key, pts, r, rb, extra)
	local t = { Kind = "Curve", Points = pts, Radius = r, RadiusB = rb, Key = key, Smooth = true }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function rbox(g, key, c, size, round, extra)
	local t = { Kind = "RoundBox", Center = c, Size = size, Round = round or 1, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function box(g, key, c, size, extra)
	local t = { Kind = "Box", Center = c, Size = size, Key = key }
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return shape(g, t)
end
local function paint(g, key, t, only)
	t.Key = key
	t.Op = "Paint"
	t.OnlyKeys = only
	if t.Kind == "Curve" and t.Smooth == nil then
		t.Smooth = true
	end
	return shape(g, t)
end
local function carve(g, t, only)
	t.Op = "Carve"
	t.OnlyKeys = only
	if t.Kind == "Curve" and t.Smooth == nil then
		t.Smooth = true
	end
	return shape(g, t)
end

-- a zig-zag lightning / crack path from a to b with n kinks (deterministic)
local function zigzag(a, b, n, amp, seed)
	local pts = { a }
	for i = 1, n - 1 do
		local f = i / n
		local h = Voxel.Hash(i, seed or 1, n, 7)
		local h2 = Voxel.Hash(seed or 1, i, 3, 11)
		pts[#pts + 1] = {
			a[1] + (b[1] - a[1]) * f + (h - 0.5) * 2 * amp,
			a[2] + (b[2] - a[2]) * f + (h2 - 0.5) * amp,
			a[3] + (b[3] - a[3]) * f + (h2 - h) * amp,
		}
	end
	pts[#pts + 1] = b
	return pts
end

