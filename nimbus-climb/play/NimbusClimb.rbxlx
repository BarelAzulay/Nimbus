-- the step kind every stage of a theme must contain (Stones/Gauntlet/Beams/Plates have extra rules)
local THEME_FEATURE = {
	Bounce = "Bounce", Moving = "Moving", Spin = "SpinBarPlatform", Storm = "StormPlatform",
