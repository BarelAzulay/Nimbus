----------------------------------------------------------------------
-- Indexes
----------------------------------------------------------------------

-- Rarities sorted by Order (a copy: Config.Rarities itself is never reordered).
local rarityList = {}
local rarityById = {}
for _, r in ipairs(Config.Rarities) do
	table.insert(rarityList, r)
	rarityById[r.Id] = r
end
table.sort(rarityList, function(a, b)
	return a.Order < b.Order
end)

local function rarityOrder(rarityId)
	local r = rarityById[rarityId]
	if r then
		return r.Order
	end
	return 1000 -- unknown rarities sort last (Validate reports them)
end

PetCatalog.Pets = {}
PetCatalog.ById = {}
for _, def in ipairs(RAW) do
	table.insert(PetCatalog.Pets, def)
	PetCatalog.ById[def.Id] = def
end
-- rarity order, then the player's own creature (Signature) first, then Name
table.sort(PetCatalog.Pets, function(a, b)
	local oa, ob = rarityOrder(a.Rarity), rarityOrder(b.Rarity)
	if oa ~= ob then
		return oa < ob
	end
	local sa, sb = a.Signature == true, b.Signature == true
	if sa ~= sb then
		return sa
	end
	return a.Name < b.Name
end)

-- rarityId -> { PetDef... } (already in display order because Pets is). An exclusive pet (ExclusiveTo: the Store's
-- Crown Phoenix, the daily gifts' Week Wisp) is skipped HERE and nowhere else, so the pools, ListByRarity(r, true), the
-- odds, buildGroup and Validate's event loop never see it while Pets / Get / ById / TotalCount still list it.
local byRarity = {}
local exclusivePets = {}
for _, r in ipairs(rarityList) do
	byRarity[r.Id] = {}
end
for _, def in ipairs(PetCatalog.Pets) do
	if def.ExclusiveTo ~= nil then
		table.insert(exclusivePets, def)
	else
		if not byRarity[def.Rarity] then
			byRarity[def.Rarity] = {}
		end
		table.insert(byRarity[def.Rarity], def)
	end
end

-- rarityId -> { PetDef... } without the EventOnly pets: the roulette pools (Phase 3 event pets are raid drops only)
local poolByRarity = {}
local eventPets = {}
for rarityId, list in pairs(byRarity) do
	local pool = {}
	for _, def in ipairs(list) do
		if def.EventOnly == true then
			table.insert(eventPets, def)
		else
			table.insert(pool, def)
		end
	end
	poolByRarity[rarityId] = pool
end
table.sort(eventPets, function(a, b)
	local oa, ob = rarityOrder(a.Rarity), rarityOrder(b.Rarity)
	if oa ~= ob then
		return oa < ob
	end
	return a.Name < b.Name
end)

----------------------------------------------------------------------
-- Lookups
----------------------------------------------------------------------

function PetCatalog.Get(id)
	if type(id) ~= "string" then
		return nil
	end
	return PetCatalog.ById[id]
end

-- The roulette pool of a rarity: EventOnly pets are left out unless includeEvent is true (Phase 3).
function PetCatalog.ListByRarity(rarityId, includeEvent)
	local out = {}
	local list = poolByRarity[rarityId]
	if includeEvent == true then
		list = byRarity[rarityId]
	end
	if list then
		for i, def in ipairs(list) do
			out[i] = def
		end
	end
	return out
end

function PetCatalog.GetRarity(rarityId)
	return rarityById[rarityId]
end

function PetCatalog.TotalCount()
	return #PetCatalog.Pets
end

-- Phase 3: the exclusive Boss Raid pets (EventOnly = true), rarity order then Name. A fresh list.
function PetCatalog.EventPets()
	local out = {}
	for i, def in ipairs(eventPets) do
		out[i] = def
	end
	return out
end

function PetCatalog.IsEventOnly(petId)
	local def = PetCatalog.Get(petId)
	return def ~= nil and def.EventOnly == true
end

-- store (2026-11-04): true for a pet only the Store or the daily gifts grant (ExclusiveTo); false for unknown ids.
function PetCatalog.IsExclusive(petId)
	local def = PetCatalog.Get(petId)
	return def ~= nil and def.ExclusiveTo ~= nil
end

----------------------------------------------------------------------
-- Roulettes
----------------------------------------------------------------------

-- Every roulette the catalog answers for: the token roulettes (Config.Roulettes), then the gems-only Secret Roulette
-- (Config.Gems.SecretRoulette, AllowSecret = true). lobby-shop (spec 5.1): one odds source on the server and the
-- client, so the Secret card and GemService read this table. IsRollable still loops Config.Roulettes only.
local function findRoulette(rouletteId)
	for _, r in ipairs(Config.Roulettes) do
		if r.Id == rouletteId then
			return r
		end
	end
	local gems = Config.Gems
	local secret = type(gems) == "table" and gems.SecretRoulette or nil
	if type(secret) == "table" and secret.Id ~= nil and secret.Id == rouletteId then
		return secret
	end
	return nil
end

-- Secret pets only come from a roulette that opts in with AllowSecret = true (the Secret Roulette, Celestial: 16.1).
local function rarityAllowed(roulette, rarityId)
	if rarityId == SECRET then
		return roulette.AllowSecret == true
	end
	return true
end

-- Rarity buckets a roulette can actually produce, in rarity order:
-- { { Rarity = id, Weight = w, Pets = {PetDef...} }... }, totalWeight.
-- Rarities with weight <= 0, without any pet, or not allowed (Secret) are skipped, so Chance always sums to 1.
local function oddsEntries(rouletteId)
	local roulette = findRoulette(rouletteId)
	if not roulette or type(roulette.Odds) ~= "table" then
		return nil, 0
	end
	local entries = {}
	local total = 0
	for _, r in ipairs(rarityList) do
		local w = roulette.Odds[r.Id]
		local pets = poolByRarity[r.Id] -- never the EventOnly raid pets
		if type(w) == "number" and w > 0 and pets and #pets > 0 and rarityAllowed(roulette, r.Id) then
			table.insert(entries, { Rarity = r.Id, Weight = w, Pets = pets })
			total = total + w
		end
	end
	if #entries == 0 then
		return nil, 0
	end
	return entries, total
end

-- The odds row of one rarity of a roulette ({ Rarity, Weight, Pets }), or nil when that rarity is not one of its rows.
local function rowOf(rouletteId, rarityId)
	local entries = oddsEntries(rouletteId)
	if not entries or type(rarityId) ~= "string" then
		return nil
	end
	for _, e in ipairs(entries) do
		if e.Rarity == rarityId then
			return e
		end
	end
	return nil
end

-- lobby-shop (spec 5.1): the roll in two halves that keep RollPet's draws in the same order, so a seed gives the same
-- pet as before. rng: anything with :Float(a, b) and :Int(a, b) (Util.NewRng); math.random without one.
-- RollRarity: the one rng:Float(0, total) draw over the odds rows -> rarityId | nil.
function PetCatalog.RollRarity(rouletteId, rng)
	local entries, total = oddsEntries(rouletteId)
	if not entries then
		return nil
	end
	local r
	if type(rng) == "table" and rng.Float then
		r = rng:Float(0, total)
	else
		r = math.random() * total
	end
	local picked = entries[#entries] -- fallback also covers r landing on the very end
	local acc = 0
	for _, e in ipairs(entries) do
		acc = acc + e.Weight
		if r < acc then
			picked = e
			break
		end
	end
	return picked.Rarity
end

-- RollFromRarity: the one rng:Int(1, #pool) draw over that rarity's pool (RarityPool) -> petId | nil (nil when the
-- rarity is not one of the roulette's odds rows).
function PetCatalog.RollFromRarity(rouletteId, rarityId, rng)
	local row = rowOf(rouletteId, rarityId)
	if not row then
		return nil
	end
	local pets = row.Pets
	local idx
	if type(rng) == "table" and rng.Int then
		idx = rng:Int(1, #pets)
	else
		idx = math.random(1, #pets)
	end
	idx = math.floor(tonumber(idx) or 1)
	if idx < 1 then
		idx = 1
	elseif idx > #pets then
		idx = #pets
	end
	return pets[idx].Id
end

-- RarityPool: the pool RollFromRarity draws from (poolByRarity: never an EventOnly or ExclusiveTo pet), a fresh list;
-- {} when the rarity is not one of the roulette's rows.
function PetCatalog.RarityPool(rouletteId, rarityId)
	local out = {}
	local row = rowOf(rouletteId, rarityId)
	if row then
		for i, def in ipairs(row.Pets) do
			out[i] = def
		end
	end
	return out
end

-- Weighted rarity (Roulette.Odds), then a uniform pet of that rarity: RollFromRarity(id, RollRarity(id, rng), rng).
function PetCatalog.RollPet(rouletteId, rng)
	return PetCatalog.RollFromRarity(rouletteId, PetCatalog.RollRarity(rouletteId, rng), rng)
end

-- Exact per-pet chances: rarity share (weight / total) split evenly between that rarity's pets.
function PetCatalog.GetOdds(rouletteId)
	local out = {}
	local entries, total = oddsEntries(rouletteId)
	if not entries then
		return out
	end
	for _, e in ipairs(entries) do
		local each = (e.Weight / total) / #e.Pets
		for _, def in ipairs(e.Pets) do
			table.insert(out, { PetId = def.Id, Rarity = e.Rarity, Chance = each })
		end
	end
	return out
end

-- Extra: chance per rarity, handy for an "Odds" card -> { { Rarity, Chance, Count }... }
function PetCatalog.GetRarityOdds(rouletteId)
	local out = {}
	local entries, total = oddsEntries(rouletteId)
	if not entries then
		return out
	end
	for _, e in ipairs(entries) do
		table.insert(out, { Rarity = e.Rarity, Chance = e.Weight / total, Count = #e.Pets })
	end
	return out
end

function PetCatalog.PossiblePets(rouletteId)
	local out = {}
	local entries = oddsEntries(rouletteId)
	if not entries then
		return out
	end
	for _, e in ipairs(entries) do
		for _, def in ipairs(e.Pets) do
			table.insert(out, def)
		end
	end
	return out
end

-- Extra: true when at least one token roulette can roll this pet (Secret pets: through Celestial's AllowSecret row).
function PetCatalog.IsRollable(petId)
	local def = PetCatalog.Get(petId)
	if not def or def.EventOnly == true or def.ExclusiveTo ~= nil then
		return false
	end
	for _, roulette in ipairs(Config.Roulettes) do
		local w = type(roulette.Odds) == "table" and roulette.Odds[def.Rarity]
		if type(w) == "number" and w > 0 and rarityAllowed(roulette, def.Rarity) then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Perks
----------------------------------------------------------------------

-- PerkLabel("MaxHealth", 0.12) -> "+12% Max Health"; fractional percents keep one decimal.
function PetCatalog.PerkLabel(perkType, value)
	local name = PetCatalog.PerkNames[perkType] or tostring(perkType)
	local pct = (tonumber(value) or 0) * 100
	local sign = "+"
	if pct < 0 then
		sign = "-"
		pct = -pct
	end
	local rounded = math.floor(pct + 0.5)
	local text
	if math.abs(pct - rounded) < 0.05 then
		text = string.format("%d", rounded)
	else
		text = string.format("%.1f", pct)
	end
	return sign .. text .. "% " .. name
end

-- Extra: all perk labels of a pet in PerkOrder, e.g. { "+12% Max Health", "+25% Cloud Tokens" }.
function PetCatalog.PerkLines(petDef)
	local out = {}
	if type(petDef) ~= "table" or type(petDef.Perks) ~= "table" then
		return out
	end
	for _, key in ipairs(PetCatalog.PerkOrder) do
		local v = petDef.Perks[key]
		if type(v) == "number" and v ~= 0 then
			table.insert(out, PetCatalog.PerkLabel(key, v))
		end
	end
	return out
end

-- Sum the perks of a list of pet ids (duplicates count once per entry), each total capped by
-- Config.Pets.PerkCaps. Unknown ids are ignored. Always returns all four perk keys.
function PetCatalog.SumPerks(petIds)
	local sums = {}
	for _, key in ipairs(PetCatalog.PerkOrder) do
		sums[key] = 0
	end
	if type(petIds) == "table" then
		for _, id in ipairs(petIds) do
			local def = PetCatalog.Get(id)
			if def then
				for key, value in pairs(def.Perks) do
					if sums[key] ~= nil and type(value) == "number" then
						sums[key] = sums[key] + value
					end
				end
			end
		end
	end
	local caps = Config.Pets.PerkCaps
	for key, total in pairs(sums) do
		local cap = caps[key]
		if type(cap) == "number" and total > cap then
			total = cap
		end
		-- trim float noise (0.1 + 0.2 style) so labels and comparisons stay tidy
		sums[key] = math.floor(total * 10000 + 0.5) / 10000
	end
	return sums
end

----------------------------------------------------------------------
-- v3: stats (tycoon income + battles)
----------------------------------------------------------------------

local function rarityScale(rarityId)
	local petStats = Config.PetStats
	local scales = type(petStats) == "table" and petStats.RarityScale
	local scale = type(scales) == "table" and scales[rarityId]
	if type(scale) == "number" and scale > 0 then
		return scale
	end
	return 1
end

----------------------------------------------------------------------
-- Phase 2: pet levels (care agent). Feeding (Kitchen food) and the Gym raise a pet copy's level (profile
-- PetLevels[key], XP curve TycoonCatalog.XpToNext); every level adds LevelBonus of the level-1 stats.
----------------------------------------------------------------------

PetCatalog.MaxLevel = 100 -- top of the XP curve when TycoonCatalog does not name one (its PetXp.MaxLevel wins)
PetCatalog.LevelBonus = 0.1 -- +10% of the level-1 stats per level (TycoonCatalog.PetPower uses the same)
-- Phase 5 (contract 3.1): an evolution multiplies the LEVEL BONUS, not the stat: LevelFactor(level, stage) =
-- 1 + LevelBonus x (level - 1) x EvolutionBonus[stage]. Rarity 1: L1 1.0 (unchanged), L20 evo1 3.85 (Phase 4: 3.625),
-- L50 evo2 10.19 (was 8.85), L100 evo2 19.56; nobody gets weaker (p5design/lead/proto_check.py).
PetCatalog.EvolutionBonus = { [0] = 1, [1] = 1.5, [2] = 1.875 }
-- the highest level XP can raise a pet to, by rarity. Phase 4: every rarity reaches 100 (the player's rule; the
-- evolutions come at 20 and 50: Common, Uncommon and Rare pets evolve once, Epic and rarer twice). TycoonCatalog may override these
-- (PetXp.RarityCaps or PetLevelCaps); a rarity missing here is capped at MaxPetLevel().
PetCatalog.LevelCaps = { Common = 100, Uncommon = 100, Rare = 100, Epic = 100, Legendary = 100, Mythic = 100, Secret = 100 }
-- stat multiplier of a pet copy's tier (PetKeys.TierMultiplier / TycoonCatalog.TierMultiplier hold the same values)
PetCatalog.TierMultipliers = { Normal = 1, Golden = 1.5, Rainbow = 2.5 }

local function finite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

-- TycoonCatalog (the economy agent's module) is read lazily: it requires PetCatalog lazily too, and builds without
-- it (tests of older rounds) still get the local numbers.
local tycoonCatalog, tycoonResolved = nil, false
local function getTycoonCatalog()
	if not tycoonResolved then
		tycoonResolved = true
		local parent = script and script.Parent
		local module = parent and parent:FindFirstChild("TycoonCatalog")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				tycoonCatalog = result
			end
		end
	end
	return tycoonCatalog
end

-- Top of the XP curve: TycoonCatalog.MaxPetLevel (or PetXp.MaxLevel), else PetCatalog.MaxLevel.
function PetCatalog.MaxPetLevel()
	local tc = getTycoonCatalog()
	if tc then
		local px = type(tc.PetXp) == "table" and tc.PetXp or nil
		for _, v in ipairs({ tc.MaxPetLevel or false, px and px.MaxLevel or false }) do
			if finite(v) and v >= 1 then
				return math.floor(v)
			end
		end
	end
	return PetCatalog.MaxLevel
end

-- level -> whole number in 1..MaxPetLevel() (junk, NaN and anything below 1 count as 1)
local function clampLevel(level)
	local lv = tonumber(level)
	if not finite(lv) or lv < 1 then
		return 1
	end
	lv = math.floor(lv)
	local top = PetCatalog.MaxPetLevel()
	if lv > top then
		return top
	end
	return lv
end

-- stage -> whole number in 0..2 (nil, junk, NaN and anything below 1 count as 0; above the table's top counts as top).
-- Without a def this is the only clamp; StatsOf / GetStats clean the stage with EvolutionStage(def, ..) first, so a
-- Common pet never gets the stage-2 bonus.
local function clampStage(stage)
	local s = tonumber(stage)
	if not finite(s) or s < 1 then
		return 0
	end
	s = math.floor(s)
	local top = #PetCatalog.EvolutionBonus
	if s > top then
		return top
	end
	return s
end

-- 1 | 1.5 | 1.875: the level-bonus multiplier of a stage (contract 3.1; "Level bonus x1.5" in texts)
function PetCatalog.EvolutionBonusOf(stage)
	return PetCatalog.EvolutionBonus[clampStage(stage)] or 1
end

-- 1 + LevelBonus x (level - 1) x EvolutionBonus[stage]; stage nil -> 0 (the Phase 4 formula, bit-identical)
function PetCatalog.LevelFactor(level, stage)
	return 1 + PetCatalog.LevelBonus * (clampLevel(level) - 1) * PetCatalog.EvolutionBonusOf(stage)
end

-- "cat@Golden" -> "cat", "Golden"; "cat" -> "cat", nil; hybrid keys ("hyb:...") -> nil (they need the profile)
local function splitKey(key)
	if type(key) ~= "string" or key == "" or string.sub(key, 1, 4) == "hyb:" then
		return nil, nil
	end
	local base, tier = string.match(key, "^([^@]+)@(%a+)$")
	if base then
		return base, tier
	end
	return key, nil
end

-- 1 | 1.5 | 2.5 from a tier name ("Golden"), a pet key ("cat@Rainbow"), a def (StatMultiplier / Tier /
-- Look.Finish) or a positive multiplier; anything else is 1.
function PetCatalog.TierMultiplier(tier)
	if finite(tier) then
		if tier > 0 then
			return tier
		end
		return 1
	end
	if type(tier) == "table" then
		if finite(tier.StatMultiplier) and tier.StatMultiplier > 0 then
			return tier.StatMultiplier
		end
		local name = tier.Tier
		if type(name) ~= "string" then
			name = type(tier.Look) == "table" and tier.Look.Finish or nil
		end
		return (type(name) == "string" and PetCatalog.TierMultipliers[name]) or 1
	end
	if type(tier) ~= "string" then
		return 1
	end
	local m = PetCatalog.TierMultipliers[tier]
	if m then
		return m
	end
	local _, suffix = string.match(tier, "^([^@]+)@(%a+)$")
	return (suffix and PetCatalog.TierMultipliers[suffix]) or 1
end

-- the cap table: TycoonCatalog's when it has one, else PetCatalog.LevelCaps
local function capTable()
	local tc = getTycoonCatalog()
	if tc then
		local px = type(tc.PetXp) == "table" and tc.PetXp or nil
		local caps = (px and (px.RarityCaps or px.LevelCaps)) or tc.PetLevelCaps or tc.RarityLevelCaps
		if type(caps) == "table" then
			return caps
		end
	end
	return PetCatalog.LevelCaps
end

-- Level cap by rarity (see the API notes at the top). subject: a rarity id, a pet id, a pet key or a def table.
function PetCatalog.LevelCap(subject)
	local rarity = nil
	if type(subject) == "table" then
		rarity = subject.Rarity
	elseif type(subject) == "string" then
		if rarityById[subject] then
			rarity = subject
		else
			local def = PetCatalog.Get(splitKey(subject))
			if not def then
				return nil
			end
			rarity = def.Rarity
		end
	end
	if type(rarity) ~= "string" then
		return nil
	end
	local top = PetCatalog.MaxPetLevel()
	local cap = capTable()[rarity]
	if not finite(cap) and capTable() ~= PetCatalog.LevelCaps then
		cap = PetCatalog.LevelCaps[rarity]
	end
	if not finite(cap) or cap < 1 then
		return top
	end
	return math.min(math.floor(cap), top)
end

----------------------------------------------------------------------
-- Phase 4: evolution (the EVOLVE button) and garden roles. The stage lives per pet key in the profile
-- (DataService PetGrowth[key].Evo, grow-only) and counts only after the player pressed EVOLVE. The boost is applied
-- by BattleCatalog.UnitStats and TycoonCatalog.PetPower, never inside GetStats / StatsOf (the Index, the Trial
-- solver and the content tests pin the pure level formula). NPC pets never evolve.
----------------------------------------------------------------------

PetCatalog.EvolutionLevels = { 20, 50 } -- stage 1 at level 20 (every pet), stage 2 at level 50 (Epic and rarer)
-- (Phase 5 W3 gate: the Phase 4 flat stage boost and its multiplier function are gone; use LevelFactor(level, stage) /
-- GetStats(.., stage) / EvolutionBonusOf)
PetCatalog.EvolveTwice = { Epic = true, Legendary = true, Mythic = true, Secret = true } -- PetBuilder's ASCEND_RARITY
PetCatalog.RoleMult = { Economy = 1.6, Combat = 1 } -- garden coins by Role: Economy pets make 60% more

-- a def table from a def, a pet id or a pet key (hybrid keys need the profile: pass PetKeys.DefOf's def instead)
local function defOf(subject)
	if type(subject) == "table" then
		return subject
	end
	if type(subject) == "string" then
		return PetCatalog.Get(splitKey(subject))
	end
	return nil
end

-- 1 | 2: how far a pet can evolve. subject: a def, a rarity id, a pet id or a pet key; unknown -> 1.
function PetCatalog.MaxEvolution(subject)
	local rarity = nil
	if type(subject) == "table" then
		rarity = subject.Rarity
	elseif type(subject) == "string" then
		if rarityById[subject] then
			rarity = subject
		else
			local def = defOf(subject)
			rarity = def and def.Rarity or nil
		end
	end
	if type(rarity) == "string" and PetCatalog.EvolveTwice[rarity] then
		return 2
	end
	return 1
end

-- the stage that counts: the stored stage (pressing EVOLVE writes it) as a whole number in 0..MaxEvolution(subject).
-- level is accepted for symmetry with CanEvolve; it never raises or lowers the stored stage.
function PetCatalog.EvolutionStage(subject, level, stored)
	local stage = tonumber(stored)
	if not finite(stage) or stage < 1 then
		return 0
	end
	stage = math.floor(stage)
	local top = PetCatalog.MaxEvolution(subject)
	if stage > top then
		return top
	end
	return stage
end

-- the next stage a pet at `level` with stored `stage` may evolve to, or nil (not there yet / fully evolved)
function PetCatalog.CanEvolve(subject, level, stage)
	local nextStage = PetCatalog.EvolutionStage(subject, level, stage) + 1
	if nextStage > PetCatalog.MaxEvolution(subject) then
		return nil
	end
	local need = PetCatalog.EvolutionLevels[nextStage]
	local lv = tonumber(level)
	if not finite(need) or not finite(lv) or math.floor(lv) < need then
		return nil
	end
	return nextStage
end

-- garden coin multiplier of a pet's Role (Economy 1.6, Combat 1); unknown pets / roles -> 1
function PetCatalog.RoleMultiplier(subject)
	local def = defOf(subject)
	local role = def and def.Role or (type(subject) == "string" and subject or nil)
	local m = role and PetCatalog.RoleMult[role]
	if finite(m) and m > 0 then
		return m
	end
	return 1
end

-- Stats of a def table at a level, tier and evolution stage (the body of GetStats; defs from PetKeys.DefOf work: tier
-- copies carry StatMultiplier, hybrids their averaged base Stats and the higher rarity). tier nil -> the def's own tier.
-- stage (Phase 5) = the STORED stage (PetGrowth[key].Evo), cleaned by EvolutionStage(def, level, stage): nil -> 0, and
-- the level alone never evolves a pet; it scales the level bonus (LevelFactor), never the stat itself.
-- The rarity scale is StatRarity's when the pet has one (Magma Cub, Hydralotl: Mythic with Secret-grade stats).
function PetCatalog.StatsOf(def, level, tier, stage)
	if type(def) ~= "table" or type(def.Stats) ~= "table" then
		return nil
	end
	local mult
	if tier == nil then
		mult = PetCatalog.TierMultiplier(def)
	else
		mult = PetCatalog.TierMultiplier(tier)
	end
	local cleanStage = 0
	if stage ~= nil then
		cleanStage = PetCatalog.EvolutionStage(def, level, stage)
	end
	local factor = rarityScale(def.StatRarity or def.Rarity) * PetCatalog.LevelFactor(level, cleanStage) * mult
	local out = {}
	for _, key in ipairs(PetCatalog.StatOrder) do
		local base = def.Stats[key]
		if not finite(base) then
			base = 0
		end
		out[key] = base * factor
	end
	return out
end

-- GetStats("cloudy_dragon", 3) -> { Income, Power, Health, Speed } = base * RarityScale * LevelFactor(level, stage)
-- * tier multiplier. level defaults to 1 (anything below 1 or not a number counts as 1; fractions are floored;
-- clamped to MaxPetLevel()); stage (Phase 5, optional) is the stored evolution stage, nil = the pure level formula.
-- nil for unknown pets. See the API notes at the top for keys, defs and tiers.
function PetCatalog.GetStats(petId, level, tier, stage)
	if type(petId) == "table" then
		return PetCatalog.StatsOf(petId, level, tier, stage)
	end
	local base, keyTier = splitKey(petId)
	local def = PetCatalog.Get(base)
	if not def then
		return nil
	end
	if tier == nil then
		tier = keyTier
	end
	return PetCatalog.StatsOf(def, level, tier or "Normal", stage)
end

----------------------------------------------------------------------
-- v3: Pet Index groups (one per rarity that has pets)
----------------------------------------------------------------------

local function copyReward(rarityId)
	local index = Config.Index
	local rewards = type(index) == "table" and index.Rewards
	local reward = type(rewards) == "table" and rewards[rarityId]
	local out = {}
	if type(reward) == "table" then
		for key, value in pairs(reward) do
			out[key] = value
		end
	end
	if type(out.Tokens) ~= "number" then
		out.Tokens = 0
	end
	return out
end

-- A rarity's group lists its roulette pets first, then its EventOnly raid pets (shown in the Index too).
local function buildGroup(rarityId)
	local pets = byRarity[rarityId]
	if not pets or #pets == 0 then
		return nil
	end
	local list = {}
	for _, def in ipairs(poolByRarity[rarityId] or {}) do
		table.insert(list, def)
	end
	for _, def in ipairs(pets) do
		if def.EventOnly == true then
			table.insert(list, def)
		end
	end
	return { Id = rarityId, Rarity = rarityId, Pets = list, Reward = copyReward(rarityId) }
end

-- Fresh tables on every call (callers may sort or annotate them); rarity order, Secret last.
function PetCatalog.IndexGroups()
	local out = {}
	for _, r in ipairs(rarityList) do
		local group = buildGroup(r.Id)
		if group then
			table.insert(out, group)
		end
	end
	return out
end

-- Extra: one group by id (rarity id) or nil.
function PetCatalog.GetIndexGroup(groupId)
	if type(groupId) ~= "string" or not rarityById[groupId] then
		return nil
	end
	return buildGroup(groupId)
end

----------------------------------------------------------------------
-- v3: elements (ARCHITECTURE_V3.md section 11; the chart lives in Config.Elements)
----------------------------------------------------------------------

local function elementConfig()
	local E = Config.Elements
	if type(E) == "table" then
		return E
	end
	return {}
end

-- element name -> true for every name in Config.Elements.Order
local validElements = {}
for _, e in ipairs(elementConfig().Order or {}) do
	if type(e) == "string" then
		validElements[e] = true
	end
end

-- A pet definition's elements: `Elements` (a fused hybrid, phase 2) or its single `Element`. Deduplicated, in
-- the given order, unknown names dropped. Always a fresh table.
function PetCatalog.ElementsOf(def)
	local out = {}
	if type(def) ~= "table" then
		return out
	end
	local raw = def.Elements
	if type(raw) ~= "table" then
		raw = { def.Element }
	end
	local seen = {}
	for _, e in ipairs(raw) do
		if type(e) == "string" and validElements[e] and not seen[e] then
			seen[e] = true
			table.insert(out, e)
		end
	end
	return out
end

-- The elements of a catalog pet ({} for unknown ids).
function PetCatalog.GetElements(petId)
	return PetCatalog.ElementsOf(PetCatalog.Get(petId))
end

local function beats(attack, defend)
	local strong = elementConfig().Strong
	local list = type(strong) == "table" and strong[attack]
	if type(list) ~= "table" then
		return false
	end
	for _, e in ipairs(list) do
		if e == defend then
			return true
		end
	end
	return false
end

local function multipliers()
	local E = elementConfig()
	local strong = tonumber(E.StrongMultiplier) or 1.5
	local weak = tonumber(E.WeakMultiplier) or 0.75
	return strong, weak
end

-- one element against one element
local function singleMultiplier(attack, defend)
	if not validElements[attack] or not validElements[defend] then
		return 1
	end
	local strong, weak = multipliers()
	if beats(attack, defend) then
		return strong -- checked first, so the Celestial <-> Shadow rivals both hit hard
	elseif beats(defend, attack) then
		return weak
	end
	return 1
end

local function elementList(v)
	if type(v) == "table" then
		return v
	end
	return { v }
end

-- Damage multiplier of an attack element against a defending element (see the API notes at the top).
function PetCatalog.ElementMultiplier(attackElement, defendElement)
	local attackers = elementList(attackElement)
	local defenders = elementList(defendElement)
	local strong, weak = multipliers()
	local best = nil
	for _, a in ipairs(attackers) do
		local m = 1
		for _, d in ipairs(defenders) do
			m = m * singleMultiplier(a, d)
		end
		if m > strong then
			m = strong
		elseif m < weak then
			m = weak
		end
		if best == nil or m > best then
			best = m
		end
	end
	return best or 1
end

----------------------------------------------------------------------
-- Self-check (extra): returns ok, { problem strings }. Run once at load and warns in the output.
----------------------------------------------------------------------
function PetCatalog.Validate()
	local problems = {}
	local function bad(msg)
		table.insert(problems, msg)
	end

	local speciesSet, accessorySet, wingSet, roleSet, kindSet = {}, {}, {}, {}, {}
	for _, s in ipairs(PetCatalog.Species) do
		speciesSet[s] = true
	end
	for _, s in ipairs(PetCatalog.Accessories) do
		accessorySet[s] = true
	end
	for _, s in ipairs(PetCatalog.WingStyles) do
		wingSet[s] = true
	end
	for _, s in ipairs(PetCatalog.Roles) do
		roleSet[s] = true
	end
	for _, s in ipairs(PetCatalog.SpecialKinds) do
		kindSet[s] = true
	end
	local supportKindSet = {}
	for _, s in ipairs(PetCatalog.SupportKinds) do
		supportKindSet[s] = true
	end

	local seenIds, seenNames, seenSpecials = {}, {}, {}
	local elementPets, elementRarities = {}, {}
	for _, def in ipairs(PetCatalog.Pets) do
		local id = tostring(def.Id)
		if seenIds[id] then
			bad("duplicate pet id " .. id)
		end
		seenIds[id] = true
		if seenNames[def.Name] then
			bad("duplicate pet name " .. tostring(def.Name))
		end
		seenNames[def.Name] = true
		if not rarityById[def.Rarity] then
			bad(id .. ": unknown rarity " .. tostring(def.Rarity))
		end
		if def.StatRarity ~= nil and not rarityById[def.StatRarity] then
			bad(id .. ": unknown StatRarity " .. tostring(def.StatRarity))
		end
		if def.ExclusiveTo ~= nil then
			if def.ExclusiveTo ~= "Store" and def.ExclusiveTo ~= "Daily" then
				bad(id .. ": ExclusiveTo must be \"Store\" or \"Daily\", got " .. tostring(def.ExclusiveTo))
			end
			if def.EventOnly == true then
				bad(id .. ": ExclusiveTo and EventOnly together")
			end
		end
		local look = def.Look
		if type(look) ~= "table" then
			bad(id .. ": missing Look")
		else
			if not speciesSet[look.Species] then
				bad(id .. ": unknown species " .. tostring(look.Species))
			end
			if not wingSet[look.WingStyle] then
				bad(id .. ": unknown wing style " .. tostring(look.WingStyle))
			end
			if look.Accessory ~= nil and not accessorySet[look.Accessory] then
				bad(id .. ": unknown accessory " .. tostring(look.Accessory))
			end
			if look.Primary == nil or look.Secondary == nil or look.Eye == nil or look.WingColor == nil then
				bad(id .. ": Look is missing a colour")
			end
		end
		local count = 0
		for key, value in pairs(def.Perks or {}) do
			count = count + 1
			if Config.Pets.PerkCaps[key] == nil then
				bad(id .. ": perk " .. tostring(key) .. " is not in Config.Pets.PerkCaps")
			end
			if type(value) ~= "number" or value <= 0 then
				bad(id .. ": perk " .. tostring(key) .. " must be a positive number")
			end
		end
		if count < 1 or count > 2 then
			bad(id .. ": a pet needs 1-2 perks, has " .. count)
		end

		-- v3 fields
		if not roleSet[def.Role] then
			bad(id .. ": unknown role " .. tostring(def.Role))
		end
		if type(def.Element) ~= "string" or not validElements[def.Element] then
			bad(id .. ": Element " .. tostring(def.Element) .. " is not in Config.Elements.Order")
		else
			elementPets[def.Element] = (elementPets[def.Element] or 0) + 1
			elementRarities[def.Element] = elementRarities[def.Element] or {}
			elementRarities[def.Element][tostring(def.Rarity)] = true
		end
		local stats = def.Stats
		if type(stats) ~= "table" then
			bad(id .. ": missing Stats")
		else
			for _, key in ipairs(PetCatalog.StatOrder) do
				local v = stats[key]
				if type(v) ~= "number" or v <= 0 or v ~= v then
					bad(id .. ": stat " .. key .. " must be a positive number")
				end
			end
			if type(stats.Income) == "number" and type(stats.Power) == "number" then
				if def.Role == "Economy" and stats.Income <= stats.Power then
					bad(id .. ": an Economy pet needs more Income than Power")
				elseif def.Role == "Combat" and stats.Power <= stats.Income then
					bad(id .. ": a Combat pet needs more Power than Income")
				end
			end
		end
		local special = def.Special
		if type(special) ~= "table" then
			bad(id .. ": missing Special")
		else
			if type(special.Id) ~= "string" or special.Id == "" then
				bad(id .. ": Special.Id missing")
			elseif seenSpecials[special.Id] then
				bad(id .. ": duplicate special id " .. special.Id)
			else
				seenSpecials[special.Id] = true
			end
			if type(special.Name) ~= "string" or special.Name == "" then
				bad(id .. ": Special.Name missing")
			end
			if not kindSet[special.Kind] then
				bad(id .. ": unknown special kind " .. tostring(special.Kind))
			elseif def.Role == "Economy" and not supportKindSet[special.Kind] then
				-- Phase 5 contract 3.2: Economy pets are Supports in battle; their special is Heal / Shield / Rally / Haste
				bad(id .. ": an Economy pet needs a Support special (Heal, Shield, Rally or Haste), has " .. tostring(special.Kind))
			end
			if type(special.Power) ~= "number" or special.Power <= 0 then
				bad(id .. ": Special.Power must be a positive number")
			end
			if typeof(special.Color) ~= "Color3" then
				bad(id .. ": Special.Color must be a Color3")
			end
		end
	end

	-- The best pets for a perk, equipped together, must stay within that perk's cap on their own.
	local maxEquipped = tonumber(Config.Pets.MaxEquipped) or 3
	for key, cap in pairs(Config.Pets.PerkCaps) do
		local values = {}
		for _, def in ipairs(PetCatalog.Pets) do
			local v = type(def.Perks) == "table" and def.Perks[key]
			if type(v) == "number" then
				table.insert(values, v)
			end
		end
		table.sort(values, function(a, b)
			return a > b
		end)
		local top = 0
		for i = 1, math.min(maxEquipped, #values) do
			top = top + values[i]
		end
		if type(cap) == "number" and top > cap + 1e-9 then
			bad("the best " .. maxEquipped .. " " .. key .. " pets add up to " .. top .. ", above the cap " .. cap)
		end
	end

	-- Every element needs at least 3 pets spread over several rarities (battle teams can build around any of them).
	local order = elementConfig().Order
	if type(order) ~= "table" or #order == 0 then
		bad("Config.Elements.Order is missing")
	else
		for _, e in ipairs(order) do
			local nRarities = 0
			for _ in pairs(elementRarities[e] or {}) do
				nRarities = nRarities + 1
			end
			if (elementPets[e] or 0) < 3 or nRarities < 2 then
				bad("element " .. tostring(e) .. " has " .. (elementPets[e] or 0) .. " pet(s) in " .. nRarities .. " rarities (needs 3+ in 2+)")
			end
		end
	end

	-- Secret pets must outclass the best Mythic (total perk strength). A pet counts by its stats' rarity: Hydralotl (0.46)
	-- is a Mythic on the list with the power of a Secret, so it does not set the bar for Rime Wyrmling (0.44).
	local function perkSum(def)
		local sum = 0
		for _, v in pairs(def.Perks or {}) do
			if type(v) == "number" then
				sum = sum + v
			end
		end
		return sum
	end
	local bestMythic = 0
	for _, def in ipairs(PetCatalog.Pets) do
		if (def.StatRarity or def.Rarity) == "Mythic" then
			bestMythic = math.max(bestMythic, perkSum(def))
		end
	end
	for _, def in ipairs(PetCatalog.Pets) do
		if (def.StatRarity or def.Rarity) == SECRET and perkSum(def) < bestMythic then
			bad(tostring(def.Id) .. ": a Secret pet's perks must be at least as strong as the best Mythic")
		end
	end

	for _, roulette in ipairs(Config.Roulettes) do
		local total = 0
		for rarityId, w in pairs(roulette.Odds) do
			if type(w) == "number" and w > 0 then
				if rarityId == SECRET and roulette.AllowSecret ~= true then
					bad("roulette " .. roulette.Id .. " lists Secret pets without AllowSecret = true (they are ignored)")
				else
					total = total + w
					if not poolByRarity[rarityId] or #poolByRarity[rarityId] == 0 then
						bad("roulette " .. roulette.Id .. " lists rarity " .. tostring(rarityId) .. " but no pet has it")
					end
				end
			end
		end
		if total <= 0 then
			bad("roulette " .. roulette.Id .. " has no positive odds")
		end
	end

	-- Phase 3 event pets: real pets (validated above), never in a roulette pool
	for _, def in ipairs(eventPets) do
		for _, poolDef in ipairs(poolByRarity[def.Rarity] or {}) do
			if poolDef == def then
				bad(tostring(def.Id) .. ": an EventOnly pet is in a roulette pool")
			end
		end
	end
	-- store (2026-11-04): an exclusive pet is in no roulette pool and in no Index group (buildGroup reads the rarity lists)
	for _, def in ipairs(exclusivePets) do
		for _, poolDef in ipairs(poolByRarity[def.Rarity] or {}) do
			if poolDef == def then
				bad(tostring(def.Id) .. ": an exclusive pet is in a roulette pool")
			end
		end
		for _, listDef in ipairs(byRarity[def.Rarity] or {}) do
			if listDef == def then
				bad(tostring(def.Id) .. ": an exclusive pet is in its rarity's Index group")
			end
		end
	end

	return #problems == 0, problems
end

do
	local ok, problems = PetCatalog.Validate()
	if not ok then
		for _, p in ipairs(problems) do
			warn("[PetCatalog] " .. p)
		end
	end
end

return PetCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1060">
        <Properties>
          <string name="Name">PetFx</string>
          <string name="Source"><![CDATA[--[[
	PetFx (Phase 6): the effects of evolved pets - element particles, a soft glow light and a Neon pulse on the aura.
	Effects are not models (no Parts, no meshes of their own): they live on an invisible Attachment of the pet's Body
	root, so they work for both the Part-built pets and the Blender mesh pets. Contract: ARCHITECTURE_V3.md "## Phase 6"
	6.0.4, 6.1 A6 and 6.4. Plain Lua 5.1-compatible syntax only.

	PetFx.Apply(model, look, stage, opts) -> the PetFx Attachment | nil
		model  a pet Model with an invisible `Body` root (PetBuilder.Build, MeshLibrary.Assemble)
		look   PetBuilder's look ({ Id, Base, Species, Hybrid, ... }); look.Element (optional) wins over the catalog
		stage  1 / 2 = first / second evolution (0 or less does nothing and clears old effects)
		opts   { Detail = "High" | "Low", Scale = 1, NoFx = true (skip), Viewport = true (skip unless Fx = true),
		         Fx = true (force effects in a viewport), Element = "Flame" (override) }
		Builds Body.PetFx (an Attachment at the root; Attachments only work as children of a BasePart, so the effect
		holder IS the attachment) with:
		  * FxMain   the element's ParticleEmitter on its FxSprites sheet (recipe.Sprite, kit B X1; shapes from Size /
		             Squash / Transparency / LightEmission curves; embers, snow, sparks, leaves, bubbles, gem glints, star
		             motes, wisps)
		  * FxAura   stage 2 only: a shell of twinkling glints in the pet's own Glow / GlowB colours, locked to the pet
		  * FxLight  a soft PointLight (stage 1: brightness 0.6, range 6; stage 2: 1.0, range 8; x Scale)
		Stage 2 also flags the Neon `Aura*` parts PB_Pulse so PetBuilder.Animate breathes them (no new loop here).
		Budgets: total emitter Rate <= 12 (stage 2, High), <= 4 on Low detail (Low = half the rates first).
		Every emitter carries the CollectionService tag "PetFx" (the client's GraphicsQuality Low turns them off).
		Calling Apply again replaces the old effects (idempotent); a Clone carries them (Animate needs nothing new).
	PetFx.Clear(model)              removes Body.PetFx and the pulse flags PetFx added
	PetFx.SetQuality("Low"|"High")  client: Low = light only (every tagged emitter off, also later ones and the
	                                server-built pets that stream in), High = back on. Before the first call the client
	                                follows Roblox's own graphics slider (1-3 = Low, like GraphicsQuality "Auto") and
	                                then the game's Graphics setting (GraphicsQuality + ClientSettings, hooked lazily).
	PetFx.Quality() -> "Low" | "High"
	PetFx.Spec(element, stage, detail) -> { Main = {...}, Aura = {...} | nil, Light = {...}, Rate = total }  (tests)
	PetFx.ElementOf(look) -> element name
	PetFx.TAG, PetFx.Elements (the 8 element recipes)
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local FxSprites = require(script.Parent:WaitForChild("FxSprites")) -- the element sheets (kit B X1)

local PetFx = {}

local TAG = "PetFx"
local FX_NAME = "PetFx"
local PULSE_FLAG = "PFX_Pulse"
local RATE_CAP = { High = 12, Low = 4 }
local PULSE_MAX = { High = 32, Low = 12 }
local LIGHT = {
	[1] = { Brightness = 0.6, Range = 6 },
	[2] = { Brightness = 1.0, Range = 8 },
}
local STAGE2_WIDE = 1.3 -- stage 2 spreads wider
local STAGE2_SIZE = 1.15 -- and slightly bigger
local AURA_RATE = 5
local UNITS = 7 -- a pet is about 7 units across (U = its largest extent / 7)

PetFx.TAG = TAG

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

----------------------------------------------------------------------
-- The element recipes. Lengths are in pet units U = the pet's largest extent / 7 (about 1 stud for a second
-- evolution at Scale 1), so the same recipe fits a small first evolution, a big Ascended form and a mesh pet.
-- Color = { t, r, g, b }; Size / Transparency / Squash = { t, v }; Light = LightEmission; Sprite = the FxSprites role.
----------------------------------------------------------------------
local E = {}
-- Flame: embers that leap out of the pet and float up like a campfire's, gold -> orange -> red, shrinking as they cool
E.Flame = {
	Sprite = "Ember",
	Rate = 6, Lifetime = { 1.4, 2.0 }, Speed = { 3.0, 4.4 }, Spread = { 75, 75 }, Drag = 1.6,
	Accel = { 0, 2.0, 0 }, Rot = { 0, 360 }, RotSpeed = { -140, 140 }, Light = 0.6, Brightness = 1.1,
	Color = { { 0, 255, 236, 120 }, { 0.35, 255, 150, 40 }, { 1, 240, 70, 40 } },
	Size = { { 0, 0.2 }, { 0.12, 0.81 }, { 0.6, 0.57 }, { 1, 0 } },
	Transparency = { { 0, 0.05 }, { 0.7, 0.15 }, { 1, 1 } },
	Squash = { { 0, 0.7 }, { 1, 0.25 } },
	LightColor = rgb(255, 170, 90),
}
-- Frost: soft snowflakes puffed out of the fur that drift slowly down, white with an icy blue edge, turning gently
E.Frost = {
	Sprite = "Snow",
	Rate = 5, Lifetime = { 2.2, 3.0 }, Speed = { 3.4, 4.6 }, Spread = { 80, 80 }, Drag = 1.8,
	Accel = { 0.2, -1.1, 0 }, Rot = { 0, 360 }, RotSpeed = { -50, 50 }, Light = 0.35, Brightness = 1.1,
	Color = { { 0, 255, 255, 255 }, { 0.5, 200, 240, 255 }, { 1, 140, 210, 255 } },
	Size = { { 0, 0 }, { 0.1, 0.74 }, { 0.85, 0.65 }, { 1, 0 } },
	Transparency = { { 0, 0.1 }, { 0.8, 0.2 }, { 1, 1 } },
	LightColor = rgb(190, 236, 255),
}
-- Storm: quick electric sparks that crackle outward as bright streaks, white-blue -> violet
E.Storm = {
	Sprite = "Spark",
	Rate = 7, Lifetime = { 0.45, 0.7 }, Speed = { 8, 11 }, Spread = { 180, 180 }, Drag = 3.2,
	Accel = { 0, 0, 0 }, Rot = { 0, 0 }, RotSpeed = { 0, 0 }, Light = 0.7, Brightness = 1.1,
	Color = { { 0, 200, 240, 255 }, { 0.5, 96, 160, 255 }, { 1, 160, 100, 255 } },
	Size = { { 0, 0.9 }, { 0.6, 0.7 }, { 1, 0 } },
	Transparency = { { 0, 0 }, { 0.6, 0.1 }, { 1, 1 } },
	Squash = { { 0, 1.8 }, { 1, 0.9 } },
	Orientation = "VelocityParallel",
	LightColor = rgb(150, 176, 255),
}
-- Nature: little leaves that tumble out and sail down sideways on a breeze, fresh green -> spring lime
E.Nature = {
	Sprite = "Leaf",
	Rate = 5, Lifetime = { 2.0, 2.8 }, Speed = { 3.6, 4.8 }, Spread = { 75, 75 }, Drag = 1.6,
	Accel = { 0.9, -1.0, 0.3 }, Rot = { 0, 360 }, RotSpeed = { -160, 160 }, Light = 0, Brightness = 1.1, Influence = 0.5,
	Color = { { 0, 150, 236, 110 }, { 0.6, 120, 216, 92 }, { 1, 214, 244, 130 } },
	Size = { { 0, 0 }, { 0.08, 0.81 }, { 0.85, 0.7 }, { 1, 0 } },
	Transparency = { { 0, 0 }, { 0.85, 0.08 }, { 1, 1 } },
	Squash = { { 0, -0.6 }, { 1, -0.6 } },
	LightColor = rgb(176, 255, 150),
}
-- Water: shiny bubbles that bob upward and swell before they pop, aqua -> sky blue
E.Water = {
	Sprite = "Droplet",
	Rate = 5, Lifetime = { 1.8, 2.5 }, Speed = { 2.8, 4.0 }, Spread = { 90, 90 }, Drag = 1.8,
	Accel = { 0, 1.8, 0 }, Rot = { 0, 360 }, RotSpeed = { -40, 40 }, Light = 0.25, Brightness = 1.1,
	Color = { { 0, 150, 236, 255 }, { 0.6, 80, 186, 255 }, { 1, 140, 226, 255 } },
	Size = { { 0, 0.2 }, { 0.75, 0.84 }, { 0.92, 1 }, { 1, 0 } },
	Transparency = { { 0, 0.3 }, { 0.75, 0.15 }, { 0.92, 0 }, { 1, 1 } },
	LightColor = rgb(130, 210, 255),
}
-- Earth: golden gem glints kicked up like crystal dust that twinkle and fall back, amber -> mint crystal
E.Earth = {
	Sprite = "Sparkle",
	Rate = 5, Lifetime = { 1.3, 1.8 }, Speed = { 5.0, 6.4 }, Spread = { 50, 50 }, Drag = 1.0,
	Accel = { 0, -5.0, 0 }, Rot = { 0, 0 }, RotSpeed = { 0, 0 }, Light = 0.5, Brightness = 1.1,
	Color = { { 0, 255, 220, 110 }, { 0.5, 255, 180, 70 }, { 1, 120, 230, 180 } },
	Size = { { 0, 0 }, { 0.15, 0.84 }, { 0.35, 0.35 }, { 0.55, 0.78 }, { 0.8, 0.3 }, { 1, 0 } },
	Transparency = { { 0, 0 }, { 0.85, 0.08 }, { 1, 1 } },
	LightColor = rgb(255, 210, 140),
}
-- Celestial: twinkling star motes that float out around the pet and rise, white-gold
E.Celestial = {
	Sprite = "Star",
	Rate = 6, Lifetime = { 1.8, 2.6 }, Speed = { 4.6, 6.0 }, Spread = { 180, 180 }, Drag = 2.0,
	Accel = { 0, 0.6, 0 }, Rot = { 0, 0 }, RotSpeed = { 0, 0 }, Light = 0.6, Brightness = 1.1,
	Color = { { 0, 255, 250, 210 }, { 0.5, 255, 222, 110 }, { 1, 255, 190, 90 } },
	Size = { { 0, 0 }, { 0.15, 0.94 }, { 0.3, 0.41 }, { 0.5, 0.89 }, { 0.7, 0.35 }, { 0.85, 0.76 }, { 1, 0 } },
	Transparency = { { 0, 0 }, { 0.85, 0.05 }, { 1, 1 } },
	LightColor = rgb(255, 236, 170),
}
-- Shadow: soft violet wisps that curl upward and stretch thin, violet -> magenta
E.Shadow = {
	Sprite = "Wisp",
	Rate = 5, Lifetime = { 1.6, 2.2 }, Speed = { 2.6, 3.6 }, Spread = { 90, 90 }, Drag = 1.4,
	Accel = { 0, 1.8, 0 }, Rot = { -15, 15 }, RotSpeed = { -30, 30 }, Light = 0.1, Brightness = 1.1,
	Color = { { 0, 120, 70, 210 }, { 0.5, 168, 90, 240 }, { 1, 230, 100, 200 } },
	Size = { { 0, 0.34 }, { 0.5, 1.22 }, { 1, 0.61 } },
	Transparency = { { 0, 1 }, { 0.2, 0.3 }, { 0.7, 0.4 }, { 1, 1 } },
	Squash = { { 0, 0.4 }, { 1, 1.4 } },
	LightColor = rgb(196, 140, 255),
}
PetFx.Elements = E

-- the second evolution's aura: a shell of glints around the pet in its Glow / GlowB colours that twinkle and turn,
-- locked to the pet so it travels with it
local AURA = {
	Sprite = "Sparkle",
	Lifetime = { 1.5, 2.1 }, Speed = { 6.0, 7.2 }, Spread = { 180, 180 }, Drag = 2.2,
	Accel = { 0, 0.4, 0 }, Rot = { 0, 360 }, RotSpeed = { -90, 90 }, Light = 0.4, Brightness = 1.1, Locked = true,
	Size = { { 0, 0 }, { 0.2, 0.97 }, { 0.4, 0.46 }, { 0.6, 0.92 }, { 0.8, 0.41 }, { 1, 0 } },
	Transparency = { { 0, 0 }, { 0.8, 0.05 }, { 1, 1 } },
}

local ORDER = { "Water", "Flame", "Frost", "Nature", "Earth", "Storm", "Celestial", "Shadow" }
local SPECIES_ELEMENT = {
	Cat = "Celestial", Dog = "Earth", Fox = "Flame", Bunny = "Nature", Bear = "Earth", Panda = "Nature",
	Dragon = "Flame", Owl = "Shadow", Slime = "Water", Unicorn = "Celestial", Phoenix = "Flame", Frog = "Nature",
	Penguin = "Frost", Axolotl = "Water", Stormfang = "Storm",
}

----------------------------------------------------------------------
-- Element and colours
----------------------------------------------------------------------
local catalog = nil -- PetCatalog, required lazily (false when missing)
local function getCatalog()
	if catalog == nil then
		catalog = false
		local ok, mod = pcall(function()
			local inst = script.Parent:FindFirstChild("PetCatalog")
			return inst and require(inst) or nil
		end)
		if ok and type(mod) == "table" and type(mod.Get) == "function" then
			catalog = mod
		end
	end
	return catalog or nil
end

local function knownElement(e)
	return type(e) == "string" and E[e] ~= nil
end

local function catalogElement(id)
	local cat = getCatalog()
	if not cat or type(id) ~= "string" or id == "" then
		return nil
	end
	local def = cat.Get(id) or cat.Get(string.match(id, "^([^@]+)@") or "")
	if type(def) ~= "table" then
		return nil
	end
	if knownElement(def.Element) then
		return def.Element
	end
	if type(def.Elements) == "table" and knownElement(def.Elements[1]) then
		return def.Elements[1]
	end
	return nil
end

function PetFx.ElementOf(look, override)
	if knownElement(override) then
		return override
	end
	look = type(look) == "table" and look or {}
	if knownElement(look.Element) then
		return look.Element
	end
	local e = catalogElement(look.Base) or catalogElement(look.Id)
	if not e and type(look.Hybrid) == "table" then
		e = catalogElement(look.Hybrid.StyleId)
	end
	return e or SPECIES_ELEMENT[look.Species] or "Celestial"
end

-- the pet's own glow colours: PetBuilder.EvolutionColors (stage 2: its two Neon accents Glow / GlowB), else the Neon
-- parts of the model (Glow / GlowB names or MK_Key on mesh pets, then the Aura group), else the element's palette
local builder = nil -- PetBuilder, required lazily (it requires this module at load time)
local function getBuilder()
	if builder == nil then
		builder = false
		local ok, mod = pcall(function()
			local inst = script.Parent:FindFirstChild("PetBuilder")
			return inst and require(inst) or nil
		end)
		if ok and type(mod) == "table" and type(mod.EvolutionColors) == "function" then
			builder = mod
		end
	end
	return builder or nil
end

local function glowColors(model, look, element)
	local pb = getBuilder()
	if pb and type(look) == "table" and look.Hybrid == nil then
		local ok, a, b = pcall(pb.EvolutionColors, {
			Id = look.Id,
			PetId = look.Base,
			Rarity = look.Rarity,
			Look = { Species = look.Species, Primary = look.Primary, Secondary = look.Secondary, WingColor = look.WingColor },
		}, 2)
		if ok and typeof(a) == "Color3" and typeof(b) == "Color3" then
			return a, b
		end
	end
	local found = {}
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and p.Material == Enum.Material.Neon then
			local key = p:GetAttribute("MK_Key") or string.match(p.Name, "^(%a+)")
			if key == "Glow" or key == "GlowB" then
				found[key] = found[key] or p.Color
			elseif key == "Aura" then
				if not found.AuraA then
					found.AuraA = p.Color
				elseif not found.AuraB and p.Color ~= found.AuraA then
					found.AuraB = p.Color
				end
			end
		end
	end
	local spec = E[element]
	local last = spec.Color[#spec.Color]
	local a = found.Glow or found.AuraA or spec.LightColor
	local b = found.GlowB or found.AuraB or rgb(last[2], last[3], last[4])
	return a, b
end

----------------------------------------------------------------------
-- Specs (pure numbers: the tests and the renders read them)
----------------------------------------------------------------------
local function copy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

function PetFx.Spec(element, stage, detail)
	element = knownElement(element) and element or "Celestial"
	stage = (stage == 2) and 2 or 1
	detail = (detail == "Low") and "Low" or "High"
	local main = copy(E[element])
	local aura = nil
	local rate = main.Rate * (stage == 2 and 1.15 or 1)
	local auraRate = (stage == 2) and AURA_RATE or 0
	if detail == "Low" then
		rate, auraRate = rate * 0.5, auraRate * 0.5
	end
	local total = rate + auraRate
	local cap = RATE_CAP[detail]
	if total > cap then
		rate, auraRate = rate * cap / total, auraRate * cap / total
	end
	main.Rate = math.floor(rate * 100 + 0.5) / 100
	if stage == 2 then
		aura = copy(AURA)
		aura.Rate = math.floor(auraRate * 100 + 0.5) / 100
	end
	local light = LIGHT[stage]
	return {
		Element = element,
		Stage = stage,
		Detail = detail,
		Main = main,
		Aura = aura,
		Light = { Brightness = light.Brightness, Range = light.Range, Color = E[element].LightColor },
		Rate = main.Rate + (aura and aura.Rate or 0),
		Wide = (stage == 2) and STAGE2_WIDE or 1,
		Grow = (stage == 2) and STAGE2_SIZE or 1,
	}
end

----------------------------------------------------------------------
-- Instances
----------------------------------------------------------------------
local function numSeq(points, mul)
	local kps = {}
	for i, p in ipairs(points) do
		kps[i] = NumberSequenceKeypoint.new(p[1], p[2] * mul)
	end
	return NumberSequence.new(kps)
end

local function colorSeq(points)
	local kps = {}
	for i, p in ipairs(points) do
		kps[i] = ColorSequenceKeypoint.new(p[1], rgb(p[2], p[3], p[4]))
	end
	return ColorSequence.new(kps)
end

local function makeEmitter(name, s, scale, wide, grow)
	local pe = Instance.new("ParticleEmitter")
	pe.Name = name
	FxSprites.Apply(pe, s.Sprite or "Sparkle")
	pe.Rate = s.Rate
	pe.Lifetime = NumberRange.new(s.Lifetime[1], s.Lifetime[2])
	pe.Speed = NumberRange.new(s.Speed[1] * scale * wide, s.Speed[2] * scale * wide)
	pe.SpreadAngle = Vector2.new(s.Spread[1], s.Spread[2])
	pe.EmissionDirection = Enum.NormalId.Top
	pe.Drag = s.Drag
	pe.Acceleration = Vector3.new(s.Accel[1] * scale, s.Accel[2] * scale, s.Accel[3] * scale)
	pe.Rotation = NumberRange.new(s.Rot[1], s.Rot[2])
	pe.RotSpeed = NumberRange.new(s.RotSpeed[1], s.RotSpeed[2])
	pe.Size = numSeq(s.Size, scale * grow)
	pe.Transparency = numSeq(s.Transparency, 1)
	if s.Squash then
		pe.Squash = numSeq(s.Squash, 1)
	end
	if s.ColorSeq then
		pe.Color = s.ColorSeq
	else
		pe.Color = colorSeq(s.Color)
	end
	pe.LightEmission = s.Light
	pe.LightInfluence = s.Influence or 0
	pe.Brightness = s.Brightness or 1
	pe.LockedToPart = s.Locked == true
	if s.Orientation then
		pe.Orientation = Enum.ParticleOrientation[s.Orientation]
	end
	return pe
end

----------------------------------------------------------------------
-- Graphics quality (client only; the server always builds the emitters on)
----------------------------------------------------------------------
local Q = {
	Mode = nil, -- nil = not decided yet, "Low" | "High"
	Off = setmetatable({}, { __mode = "k" }), -- emitters WE turned off
	Conn = nil,
	Hooked = false,
}
PetFx._Q = Q

local function isClient()
	local ok, yes = pcall(function()
		return RunService:IsClient()
	end)
	return ok and yes == true
end

local function sliderMode()
	local ok, level = pcall(function()
		local value = UserSettings().GameSettings.SavedQualityLevel
		if typeof(value) == "EnumItem" then
			return value.Value
		end
		return tonumber(value)
	end)
	if ok and type(level) == "number" and level >= 1 and level <= 3 then
		return "Low"
	end
	return "High"
end

local function turnOff(pe)
	if pe:IsA("ParticleEmitter") and pe.Enabled then
		pe.Enabled = false
		Q.Off[pe] = true
	end
end

-- the game's Graphics setting (client/GraphicsQuality + ClientSettings), found lazily, never yields a Build
local function hookGraphics()
	if Q.Hooked then
		return
	end
	Q.Hooked = true
	task.defer(function()
		pcall(function()
			local lp = game:GetService("Players").LocalPlayer
			local ps = lp and lp:FindFirstChild("PlayerScripts")
			local client = ps and ps:FindFirstChild("Client")
			local gqm = client and client:FindFirstChild("GraphicsQuality")
			local csm = client and client:FindFirstChild("ClientSettings")
			if not (gqm and csm) then
				return
			end
			local GQ, CS = require(gqm), require(csm)
			if type(GQ) ~= "table" or type(CS) ~= "table" or type(GQ.Effective) ~= "function" then
				return
			end
			local function sync()
				local st = GQ._St
				if type(st) == "table" and st.Started then
					PetFx.SetQuality(GQ.Effective())
				end
			end
			if CS.Changed and type(CS.Changed.Connect) == "function" then
				CS.Changed:Connect(function(key)
					if key == "Gfx" then
						task.defer(sync)
					end
				end)
			end
			sync()
		end)
	end)
end

function PetFx.SetQuality(mode)
	mode = (mode == "Low") and "Low" or "High"
	Q.Mode = mode
	if mode == "Low" then
		for _, pe in ipairs(CollectionService:GetTagged(TAG)) do
			turnOff(pe)
		end
		if not Q.Conn then
			Q.Conn = CollectionService:GetInstanceAddedSignal(TAG):Connect(function(pe)
				if Q.Mode == "Low" then
					turnOff(pe)
				end
			end)
		end
	else
		if Q.Conn then
			Q.Conn:Disconnect()
			Q.Conn = nil
		end
		for pe in pairs(Q.Off) do
			Q.Off[pe] = nil
			if pe.Parent then
				pe.Enabled = true
			end
		end
	end
	return mode
end

function PetFx.Quality()
	if Q.Mode == nil and isClient() then
		PetFx.SetQuality(sliderMode())
		hookGraphics()
	end
	return Q.Mode or "High"
end

----------------------------------------------------------------------
-- Apply / Clear
----------------------------------------------------------------------
local function rootOf(model)
	if typeof(model) ~= "Instance" then
		return nil
	end
	local root = model:FindFirstChild("Body")
	if root and root:IsA("BasePart") then
		return root
	end
	local pp = model:IsA("Model") and model.PrimaryPart or nil
	return pp
end

function PetFx.Clear(model)
	local root = rootOf(model)
	if not root then
		return
	end
	local fx = root:FindFirstChild(FX_NAME)
	while fx do
		fx:Destroy()
		fx = root:FindFirstChild(FX_NAME)
	end
	for _, p in ipairs(model:GetChildren()) do
		if p:GetAttribute(PULSE_FLAG) then
			p:SetAttribute(PULSE_FLAG, nil)
			p:SetAttribute("PB_Pulse", nil)
		end
	end
end

-- stage 2: the Neon aura parts breathe (PetBuilder.Animate reads PB_Pulse)
local function flagPulse(model, detail)
	local n, max = 0, PULSE_MAX[detail]
	for _, p in ipairs(model:GetChildren()) do
		if n >= max then
			break
		end
		if p:IsA("BasePart") and p.Material == Enum.Material.Neon and string.sub(p.Name, 1, 4) == "Aura" then
			if p:GetAttribute("PB_Pulse") == nil then
				p:SetAttribute("PB_Pulse", p.Transparency)
				p:SetAttribute(PULSE_FLAG, true)
			end
			n = n + 1
		end
	end
	return n
end

function PetFx.Apply(model, look, stage, opts)
	opts = type(opts) == "table" and opts or {}
	local root = rootOf(model)
	if not root then
		return nil
	end
	PetFx.Clear(model)
	stage = tonumber(stage) or 0
	if stage <= 0 or opts.NoFx == true or (opts.Viewport == true and opts.Fx ~= true) then
		return nil
	end
	stage = (stage >= 2) and 2 or 1
	local detail = (opts.Detail == "Low") and "Low" or "High"
	local scale = tonumber(opts.Scale) or tonumber(model:GetAttribute("PB_Scale")) or 1
	if scale ~= scale or scale <= 0 then
		scale = 1
	end
	local element = PetFx.ElementOf(look, opts.Element)
	local spec = PetFx.Spec(element, stage, detail)
	-- the pet's own size and visual centre (the Body root sits low, near the belly)
	local unit, centre = scale, nil
	local okBox, cf, size = pcall(function()
		local c, sz = model:GetBoundingBox()
		return c, sz
	end)
	if okBox and typeof(size) == "Vector3" then
		local m = math.max(size.X, size.Y, size.Z)
		if m > 0 and m < 1e4 then
			unit = m / UNITS
			centre = root.CFrame:PointToObjectSpace(cf.Position)
		end
	end

	local fx = Instance.new("Attachment")
	fx.Name = FX_NAME
	fx:SetAttribute("Stage", stage)
	fx:SetAttribute("Element", element)
	fx:SetAttribute("Detail", detail)
	fx:SetAttribute("Rate", spec.Rate)
	fx:SetAttribute("Unit", unit)
	if centre then
		fx.Position = centre
	end

	local emitters = { makeEmitter("FxMain", spec.Main, unit, spec.Wide, spec.Grow) }
	if spec.Aura then
		local a, b = glowColors(model, look, element)
		local aura = copy(spec.Aura)
		aura.ColorSeq = ColorSequence.new({
			ColorSequenceKeypoint.new(0, a:Lerp(rgb(255, 255, 255), 0.1)),
			ColorSequenceKeypoint.new(0.5, a),
			ColorSequenceKeypoint.new(1, b),
		})
		emitters[2] = makeEmitter("FxAura", aura, unit, spec.Wide, spec.Grow)
	end
	local low = isClient() and PetFx.Quality() == "Low"
	for _, pe in ipairs(emitters) do
		CollectionService:AddTag(pe, TAG)
		if low then
			pe.Enabled = false
			Q.Off[pe] = true
		end
		pe.Parent = fx
	end

	local light = Instance.new("PointLight")
	light.Name = "FxLight"
	light.Brightness = spec.Light.Brightness
	light.Range = math.min(60, spec.Light.Range * math.max(1, scale))
	light.Color = spec.Light.Color
	light.Shadows = false
	light.Parent = fx

	if stage == 2 then
		fx:SetAttribute("Pulse", flagPulse(model, detail))
	end
	fx.Parent = root
	return fx
end

PetFx._Order = ORDER
return PetFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1061">
        <Properties>
          <string name="Name">PetKeys</string>
          <string name="Source"><![CDATA[-- PetKeys: per-copy pet keys (ARCHITECTURE_V3.md "Phase 2 build contract", "Pet keys" + section 11).
-- Pure data + logic: no Instances, safe on the server, the client and inside the save code.
-- Plain Lua 5.1-compatible syntax only.
--
-- A pet COPY is identified by a key string:
--   "<petId>"              a Normal copy          (old profiles: every plain petId is a valid key)
--   "<petId>@Golden"       a Golden copy          (x1.5 stats / perks, gold finish)
--   "<petId>@Rainbow"      a Rainbow copy         (x2.5 stats / perks, rainbow shimmer)
--   "hyb:<uid>"            a fused hybrid         (may also carry "@Golden" / "@Rainbow")
-- Keys are canonical: "cat@Normal" is not a key (Normal copies have no suffix), petIds and hybrid uids only use
-- letters, digits, "_" and "-" (so a key never contains ",", ";", "=", "/" or spaces and fits a csv attribute).
--
-- Where copies live in a profile (or in the client's ProfileSync snapshot, which has the same shape):
--   Pets[petId]     = count                                      Normal copies (unchanged since v2)
--   Tiers[petId]    = { Golden = n, Rainbow = n }                tier copies
--   Hybrids[uid]    = { Body = petId, Style = petId, Elements = {...}, Name, Rarity, Tier, Seed?, SpecialFrom? }
--                     ONE unique creature per uid. Its key is "hyb:<uid>" plus the record's Tier suffix, so
--                     Count("hyb:<uid>@Golden") is 1 only while the record's Tier is "Golden".
--                     Elements ORDER MATTERS: Elements[1] is the element of the parent that gives the normal attack
--                     (old records: the Body's). SpecialFrom = "Style" (gui-redo, the Mix move choice): the Style parent
--                     gives the special; absent (or anything but exactly "Style") = the Body, today's rule. No migration.
--
-- API (the contract):
--   PetKeys.Parse(key) -> { Key, PetId, Tier, HybridId } | nil      nil for anything that is not a canonical key.
--                         Tier is "Normal" | "Golden" | "Rainbow"; PetId is nil for hybrids, HybridId nil otherwise.
--   PetKeys.Make(petId, tier) -> key | nil                           Make("cat", "Golden") -> "cat@Golden";
--                         tier nil / "Normal" -> "cat"; petId may also be "hyb:<uid>" or a key (its tier is replaced)
--   PetKeys.Count(profile, key) -> n                                 copies owned (0 for junk)
--   PetKeys.Add(profile, key, n [, record]) -> ok                    n defaults to 1; refuses (false, nothing changed)
--                         junk, unknown catalog pets and stacks above Config.Pets.MaxPerStack. A hybrid key needs n = 1
--                         and `record` ({Body, Style, Elements, Name, Rarity, ...}); its uid must be free.
--   PetKeys.Remove(profile, key, n) -> ok                            never below 0: false (nothing changed) when fewer
--                         than n copies are owned. Removing a hybrid key deletes its record. Empty entries are cleaned.
--   PetKeys.List(profile) -> { key... }                              every owned key (count > 0) that DefOf can
--                         describe, in catalog order (rarity, then name; Normal, Golden, Rainbow), hybrids last by name
--   PetKeys.DefOf(key, profile) -> def | nil                         the catalog def for a Normal key; a derived def
--                         for tiers (Look.Finish = "Golden" | "Rainbow"); a merged def for hybrids (needs `profile`, or
--                         anything with a `Hybrids` table, for the record). Treat every def as READ-ONLY (shared/cached).
--   PetKeys.StatMultiplier(tier) -> 1 | 1.5 | 2.5                     also accepts a key ("cat@Golden" -> 1.5)
--
-- Derived defs (tiers and hybrids) carry every PetDef field PetBuilder / the menus read, plus:
--   Id = Key = the key (so PetBuilder caches every variant on its own), PetId (catalog id; nil for hybrids),
--   Tier, StatMultiplier, DisplayName ("Golden Pebble Pup"), and for hybrids IsHybrid = true, HybridId, Body, Style,
--   Elements (deduplicated, both parents' when the record has none), BodyDef / StyleDef (the parents' catalog defs);
--   tier defs also CatalogDef (the Normal def). Stats / Perks / Special.Power are the BASE values
--   (tier not applied): callers multiply by StatMultiplier(tier) like they scale by level.
-- Hybrid merge rules (section 11 + the Phase 2 contract): the FIRST parent (Body) gives the species, body colour
--   (Primary) and eyes, the special (unless the record's SpecialFrom = "Style": then the Style's) and the shape; the
--   SECOND (Style) gives Secondary, the wings (style + colour), the accessory (the Body's when the Style has none) and its
--   element (Elements = the record's, in its order; both parents', deduplicated, when it has none). A missing parent is
--   stood in for by the other one (so a def with a special still builds). Rarity = the
--   higher of the two (or the record's), StatRarity = the higher of the parents' stat rarities when that differs from a
--   Rarity that is the parents' own (never saved: a raid pet's hybrid keeps Secret-grade stats), Stats and Perks = the parents'
--   average x1.2, Role from the merged stats,
--   Name = the record's or a blend of both names ("Pip Penguin" + "Ember Phoenix" -> "Pengnix").
--
-- Extras (nothing depends on them): Tiers, TierMultiplier, HybridPrefix, HybridStatBonus, Base(key), TierOf(key),
--   NextTier(tier), HybridKey(uid, tier), IsHybridKey(key), ValidHybridId(uid), NewHybridId(profile, seed),
--   BlendName(nameA, nameB), DisplayName(key, profile), CleanHybrid(record) (keeps SpecialFrom only when exactly
--   "Style", never as one of its 8 extras), Owned(profile) -> { [key] = n },
--   ValidMoves(moves) -> bool (the Mix move choice: nil or exactly "BB" | "BS" | "SB" | "SS"; letter 1 = the parent of the
--   normal attack, letter 2 = the parent of the special, B = Body, S = Style),
--   MixMoves(bodyDef, styleDef, moves) -> elements, specialFrom (a new hybrid record's Elements, attack parent's first and
--   deduplicated, and SpecialFrom = "Style" | nil; nil / junk moves = "BB", today's rule).

local PetKeys = {}

local Shared = script.Parent
local Config = require(Shared.Config)

PetKeys.Tiers = { "Normal", "Golden", "Rainbow" }
PetKeys.TierMultiplier = { Normal = 1, Golden = 1.5, Rainbow = 2.5 }
PetKeys.HybridPrefix = "hyb:"
PetKeys.HybridStatBonus = 1.2 -- section 11: a hybrid's stats are its parents' average x1.2
PetKeys.MaxKeyLength = 48 -- DataService refuses longer keys
PetKeys.MaxHybridIdLength = 24

local TIER_INDEX = { Normal = 1, Golden = 2, Rainbow = 3 }
local NEXT_TIER = { Normal = "Golden", Golden = "Rainbow" }
local MAX_PET_ID_LENGTH = 40 -- leaves room for "@Rainbow" inside MaxKeyLength
local MAX_NAME_LENGTH = 32
local DEF_CACHE_LIMIT = 256

----------------------------------------------------------------------
-- PetCatalog (resolved lazily: it requires Config only, but load order must never matter)
----------------------------------------------------------------------
local catalog = nil
local catalogResolved = false

local function getCatalog()
	if not catalogResolved then
		catalogResolved = true
		local module = Shared:FindFirstChild("PetCatalog")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				catalog = result
			else
				warn("[PetKeys] PetCatalog failed to load: " .. tostring(result))
			end
		end
	end
	return catalog
end

local function catalogDef(petId)
	local c = getCatalog()
	if not c or type(c.Get) ~= "function" then
		return nil
	end
	local ok, def = pcall(c.Get, petId)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

-- true when the catalog is loaded and does NOT know petId (without a catalog nothing is called unknown)
local function unknownPet(petId)
	local c = getCatalog()
	if not c or type(c.Get) ~= "function" then
		return false
	end
	return catalogDef(petId) == nil
end

local function maxStack()
	local pets = Config.Pets
	local n = type(pets) == "table" and tonumber(pets.MaxPerStack)
	if n and n >= 1 then
		return math.floor(n)
	end
	return 99
end

local function rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 0
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Keys
----------------------------------------------------------------------
local function validPetId(id)
	return type(id) == "string" and #id >= 1 and #id <= MAX_PET_ID_LENGTH and string.find(id, "^[%w_%-]+$") ~= nil
end

function PetKeys.ValidHybridId(uid)
	return type(uid) == "string" and #uid >= 1 and #uid <= PetKeys.MaxHybridIdLength and string.find(uid, "^[%w_%-]+$") ~= nil
end

local function validTier(tier)
	return type(tier) == "string" and TIER_INDEX[tier] ~= nil
end

-- key -> base ("cat" | "hyb:<uid>"), tier ("Normal" | ...) or nil when the suffix is not canonical
local function split(key)
	local base, tier = string.match(key, "^(.-)@([%w]+)$")
	if base == nil then
		return key, "Normal"
	end
	if tier ~= "Golden" and tier ~= "Rainbow" then
		return nil -- "@Normal" and unknown suffixes are not keys
	end
	return base, tier
end

function PetKeys.Parse(key)
	if type(key) ~= "string" or #key < 1 or #key > PetKeys.MaxKeyLength then
		return nil
	end
	local base, tier = split(key)
	if not base then
		return nil
	end
	local prefix = PetKeys.HybridPrefix
	if string.sub(base, 1, #prefix) == prefix then
		local uid = string.sub(base, #prefix + 1)
		if not PetKeys.ValidHybridId(uid) then
			return nil
		end
		return { Key = key, PetId = nil, Tier = tier, HybridId = uid }
	end
	if not validPetId(base) then
		return nil
	end
	return { Key = key, PetId = base, Tier = tier, HybridId = nil }
end

function PetKeys.Make(petId, tier)
	if tier == nil then
		tier = "Normal"
	end
	if not validTier(tier) then
		return nil
	end
	local parsed = PetKeys.Parse(petId)
	if not parsed then
		return nil
	end
	local base = parsed.PetId or (PetKeys.HybridPrefix .. parsed.HybridId)
	local key = base
	if tier ~= "Normal" then
		key = base .. "@" .. tier
	end
	if #key > PetKeys.MaxKeyLength then
		return nil
	end
	return key
end

function PetKeys.HybridKey(uid, tier)
	if not PetKeys.ValidHybridId(uid) then
		return nil
	end
	return PetKeys.Make(PetKeys.HybridPrefix .. uid, tier)
end

function PetKeys.Base(key)
	local parsed = PetKeys.Parse(key)
	if not parsed then
		return nil
	end
	return parsed.PetId or (PetKeys.HybridPrefix .. parsed.HybridId)
end

function PetKeys.TierOf(key)
	local parsed = PetKeys.Parse(key)
	return parsed and parsed.Tier or nil
end

function PetKeys.IsHybridKey(key)
	local parsed = PetKeys.Parse(key)
	return parsed ~= nil and parsed.HybridId ~= nil
end

function PetKeys.NextTier(tier)
	return NEXT_TIER[tier]
end

function PetKeys.StatMultiplier(tier)
	if tier == nil then
		return 1
	end
	local m = PetKeys.TierMultiplier[tier]
	if m then
		return m
	end
	local parsed = PetKeys.Parse(tier) -- a key
	if parsed then
		return PetKeys.TierMultiplier[parsed.Tier] or 1
	end
	return 1
end

----------------------------------------------------------------------
-- Hybrid records
----------------------------------------------------------------------
local function cleanName(name)
	if type(name) ~= "string" then
		return nil
	end
	name = string.gsub(name, "[%c]", "")
	name = string.match(name, "^%s*(.-)%s*$")
	if #name < 1 or #name > MAX_NAME_LENGTH then
		return nil
	end
	return name
end

local function validElementSet()
	local set = {}
	local E = Config.Elements
	for _, e in ipairs(type(E) == "table" and type(E.Order) == "table" and E.Order or {}) do
		set[e] = true
	end
	return set
end

local function cleanElements(list)
	local out = {}
	if type(list) ~= "table" then
		return out
	end
	local valid = validElementSet()
	local seen = {}
	for _, e in ipairs(list) do
		if type(e) == "string" and valid[e] and not seen[e] and #out < 4 then
			seen[e] = true
			out[#out + 1] = e
		end
	end
	return out
end

-- Untrusted record -> a clean copy { Body, Style, Elements, Name?, Rarity?, Tier, SpecialFrom? } (plus up to 8 extra scalar
-- fields the fusion code may keep, e.g. a look seed), or nil when Body / Style are not pet ids. SpecialFrom is a known
-- field: kept only when it is exactly "Style" (anything else = the Body, dropped), never counted as an extra.
function PetKeys.CleanHybrid(raw)
	if type(raw) ~= "table" or not validPetId(raw.Body) or not validPetId(raw.Style) then
		return nil
	end
	local rec = {
		Body = raw.Body,
		Style = raw.Style,
		Elements = cleanElements(raw.Elements),
		Name = cleanName(raw.Name),
		Rarity = nil,
		Tier = validTier(raw.Tier) and raw.Tier or "Normal",
	}
	if type(raw.Rarity) == "string" and rarityOrder(raw.Rarity) then
		rec.Rarity = raw.Rarity
	end
	if raw.SpecialFrom == "Style" then
		rec.SpecialFrom = "Style"
	end
	local extras = 0
	for k, v in pairs(raw) do
		if rec[k] == nil and k ~= "Rarity" and k ~= "Name" and k ~= "SpecialFrom" and type(k) == "string" and #k <= 24 and extras < 8 then
			local t = type(v)
			if (t == "number" and v == v and v ~= math.huge and v ~= -math.huge) or t == "boolean" or (t == "string" and #v <= 64) then
				rec[k] = v
				extras = extras + 1
			end
		end
	end
	return rec
end

local function hybridRecord(profile, uid)
	local hybrids = type(profile) == "table" and profile.Hybrids
	local rec = type(hybrids) == "table" and hybrids[uid]
	if type(rec) == "table" then
		return rec
	end
	return nil
end

local function recordTier(rec)
	if validTier(rec.Tier) then
		return rec.Tier
	end
	return "Normal"
end

-- A uid not used by profile.Hybrids yet ("h" + base-36 digits). `seed` (number) varies the start.
function PetKeys.NewHybridId(profile, seed)
	local hybrids = type(profile) == "table" and type(profile.Hybrids) == "table" and profile.Hybrids or {}
	local digits = "0123456789abcdefghijklmnopqrstuvwxyz"
	local n = math.floor(tonumber(seed) or os.time()) % 2176782336 -- 36^6
	if n < 0 then
		n = -n
	end
	for _ = 1, 1000 do
		local v, s = n, ""
		repeat
			local d = v % 36
			s = string.sub(digits, d + 1, d + 1) .. s
			v = math.floor(v / 36)
		until v == 0
		local uid = "h" .. s
		if hybrids[uid] == nil then
			return uid
		end
		n = (n + 7919) % 2176782336
	end
	return nil
end

----------------------------------------------------------------------
-- Counting, adding, removing
----------------------------------------------------------------------
local function count(v)
	if type(v) == "number" and v == v and v > 0 and v ~= math.huge then
		return math.floor(v)
	end
	return 0
end

function PetKeys.Count(profile, key)
	if type(profile) ~= "table" then
		return 0
	end
	local parsed = PetKeys.Parse(key)
	if not parsed then
		return 0
	end
	if parsed.HybridId then
		local rec = hybridRecord(profile, parsed.HybridId)
		if rec and recordTier(rec) == parsed.Tier then
			return 1
		end
		return 0
	end
	if parsed.Tier == "Normal" then
		local pets = profile.Pets
		return type(pets) == "table" and count(pets[parsed.PetId]) or 0
	end
	local tiers = profile.Tiers
	local entry = type(tiers) == "table" and tiers[parsed.PetId]
	return type(entry) == "table" and count(entry[parsed.Tier]) or 0
end

local function ensure(holder, field)
	local t = holder[field]
	if type(t) ~= "table" then
		t = {}
		holder[field] = t
	end
	return t
end

local function wholeAmount(n)
	if n == nil then
		return 1
	end
	if type(n) ~= "number" or n ~= n or n < 1 or n == math.huge or n ~= math.floor(n) then
		return nil
	end
	return n
end

function PetKeys.Add(profile, key, n, record)
	if type(profile) ~= "table" then
		return false
	end
	local amount = wholeAmount(n)
	local parsed = PetKeys.Parse(key)
	if not amount or not parsed then
		return false
	end
	if parsed.HybridId then
		if amount ~= 1 or hybridRecord(profile, parsed.HybridId) then
			return false -- a hybrid is one unique creature; its uid must be free
		end
		local rec = PetKeys.CleanHybrid(record)
		if not rec then
			return false
		end
		rec.Tier = parsed.Tier
		ensure(profile, "Hybrids")[parsed.HybridId] = rec
		return true
	end
	if unknownPet(parsed.PetId) then
		return false
	end
	local have = PetKeys.Count(profile, key)
	if have + amount > maxStack() then
		return false
	end
	if parsed.Tier == "Normal" then
		ensure(profile, "Pets")[parsed.PetId] = have + amount
	else
		local entry = ensure(ensure(profile, "Tiers"), parsed.PetId)
		entry[parsed.Tier] = have + amount
	end
	return true
end

function PetKeys.Remove(profile, key, n)
	if type(profile) ~= "table" then
		return false
	end
	local amount = wholeAmount(n)
	local parsed = PetKeys.Parse(key)
	if not amount or not parsed then
		return false
	end
	local have = PetKeys.Count(profile, key)
	if have < amount then
		return false
	end
	if parsed.HybridId then
		profile.Hybrids[parsed.HybridId] = nil
		return true
	end
	local left = have - amount
	if parsed.Tier == "Normal" then
		if left > 0 then
			profile.Pets[parsed.PetId] = left
		else
			profile.Pets[parsed.PetId] = nil
		end
		return true
	end
	local entry = profile.Tiers[parsed.PetId]
	if left > 0 then
		entry[parsed.Tier] = left
	else
		entry[parsed.Tier] = nil
		if next(entry) == nil then
			profile.Tiers[parsed.PetId] = nil
		end
	end
	return true
end

-- Extra: { [key] = count } of every owned copy (junk entries skipped; no catalog check).
function PetKeys.Owned(profile)
	local out = {}
	if type(profile) ~= "table" then
		return out
	end
	for petId, n in pairs(type(profile.Pets) == "table" and profile.Pets or {}) do
		if validPetId(petId) and count(n) > 0 then
			out[petId] = count(n)
		end
	end
	for petId, entry in pairs(type(profile.Tiers) == "table" and profile.Tiers or {}) do
		if validPetId(petId) and type(entry) == "table" then
			for _, tier in ipairs({ "Golden", "Rainbow" }) do
				if count(entry[tier]) > 0 then
					out[petId .. "@" .. tier] = count(entry[tier])
				end
			end
		end
	end
	for uid, rec in pairs(type(profile.Hybrids) == "table" and profile.Hybrids or {}) do
		local key = type(rec) == "table" and PetKeys.HybridKey(uid, recordTier(rec))
		if key then
			out[key] = 1
		end
	end
	return out
end

----------------------------------------------------------------------
-- Definitions
----------------------------------------------------------------------
local defCache = {} -- [signature] = derived def
local defCacheSize = 0

local function cachePut(sig, def)
	if defCacheSize >= DEF_CACHE_LIMIT then
		defCache = {}
		defCacheSize = 0
	end
	defCache[sig] = def
	defCacheSize = defCacheSize + 1
	return def
end

local function shallowCopy(t)
	local out = {}
	for k, v in pairs(t) do
		out[k] = v
	end
	return out
end

-- "Pip Penguin" + "Ember Phoenix" -> "Pengnix": the front half of the first name's last word (usually the creature)
-- and the back half of the second name's last word, capitalised. When both end in the same word ("Cloudy Dragon" +
-- "Twilight Dragon") the first name's FIRST word is used instead ("Clogon"); words of 3 letters or fewer are used
-- whole ("Biscuit Bear" + "Aurora Fox" -> "Befox").
function PetKeys.BlendName(a, b)
	local lastA = type(a) == "string" and string.match(a, "([%a]+)[^%a]*$") or nil
	local firstA = type(a) == "string" and string.match(a, "^[^%a]*([%a]+)") or nil
	local last = type(b) == "string" and string.match(b, "([%a]+)[^%a]*$") or nil
	local first = lastA
	if first and last and string.lower(first) == string.lower(last) and firstA then
		first = firstA
	end
	if not first and not last then
		return "Fusion"
	end
	first = first or last
	last = last or first
	-- short words (3 letters or fewer: "Pup", "Fox", "Owl") are used whole, longer ones by half
	local front = first
	if #first > 3 then
		front = string.sub(first, 1, math.ceil(#first / 2))
	end
	local back = last
	if #last > 3 then
		back = string.sub(last, #last - math.floor(#last / 2) + 1)
	end
	local name = string.lower(front .. back)
	return string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2)
end

-- The Mix move choice (gui-redo): `moves` is two letters, letter 1 = the parent of the normal attack (the element attack),
-- letter 2 = the parent of the special, "B" = Body, "S" = Style: "BB" | "BS" | "SB" | "SS". nil = "BB" (today's rule, an old
-- client). FusionService refuses anything else; the server and the client both build a record through MixMoves.
local MIX_MOVES = { BB = true, BS = true, SB = true, SS = true }

function PetKeys.ValidMoves(moves)
	if moves == nil then
		return true
	end
	return type(moves) == "string" and MIX_MOVES[moves] == true
end

-- elements, specialFrom for a new hybrid of bodyDef + styleDef (catalog defs): elements = { the attack parent's element, the
-- other parent's } (deduplicated: two parents of one element give one); specialFrom = "Style" when letter 2 is "S", else nil
-- (left out of the record = the Body). Anything that is not one of the four strings reads as "BB".
function PetKeys.MixMoves(bodyDef, styleDef, moves)
	if moves == nil or not PetKeys.ValidMoves(moves) then
		moves = "BB"
	end
	local attackFromStyle = string.sub(moves, 1, 1) == "S"
	local first, second = bodyDef, styleDef
	if attackFromStyle then
		first, second = styleDef, bodyDef
	end
	local elements, seen = {}, {}
	for _, d in ipairs({ first, second }) do
		local e = type(d) == "table" and d.Element or nil
		if type(e) == "string" and not seen[e] then
			seen[e] = true
			elements[#elements + 1] = e
		end
	end
	local specialFrom = nil
	if string.sub(moves, 2, 2) == "S" then
		specialFrom = "Style"
	end
	return elements, specialFrom
end

local function tierLabel(tier, name)
	if tier == "Normal" then
		return name
	end
	return tier .. " " .. tostring(name)
end

local function tierDef(base, key, tier)
	local sig = "t|" .. key
	local cached = defCache[sig]
	if cached and cached.CatalogDef == base then
		return cached
	end
	local def = shallowCopy(base)
	def.CatalogDef = base -- the catalog def it was derived from
	def.Id = key
	def.Key = key
	def.PetId = base.Id
	def.Tier = tier
	def.StatMultiplier = PetKeys.TierMultiplier[tier] or 1
	def.DisplayName = tierLabel(tier, base.Name)
	local look = shallowCopy(type(base.Look) == "table" and base.Look or {})
	look.Finish = tier
	def.Look = look
	return cachePut(sig, def)
end

local function average(a, b, bonus)
	local out = {}
	for k, v in pairs(type(a) == "table" and a or {}) do
		if type(v) == "number" then
			out[k] = v
		end
	end
	for k, v in pairs(type(b) == "table" and b or {}) do
		if type(v) == "number" then
			out[k] = (out[k] or 0) + v
		end
	end
	for k, v in pairs(out) do
		out[k] = v / 2 * bonus
	end
	return out
end

local function higherRarity(a, b)
	local oa, ob = rarityOrder(a) or 0, rarityOrder(b) or 0
	if ob > oa then
		return b
	end
	return a
end

local function hybridDef(key, parsed, rec)
	local body = catalogDef(rec.Body)
	local style = catalogDef(rec.Style)
	if not body and not style then
		return nil
	end
	body = body or style
	style = style or body
	local tier = parsed.Tier
	local elementsKey = table.concat(type(rec.Elements) == "table" and rec.Elements or {}, "+")
	-- the parent that gives the special: exactly "Style", anything else (absent, junk) = the Body (today's rule)
	local specialFrom = (rec.SpecialFrom == "Style") and "Style" or "Body"
	local sig = table.concat({ "h", key, rec.Body, rec.Style, tostring(rec.Name), tostring(rec.Rarity), elementsKey, tostring(rec.Seed), specialFrom }, "|")
	local cached = defCache[sig]
	if cached and cached.BodyDef == body and cached.StyleDef == style then
		return cached
	end

	local bl = type(body.Look) == "table" and body.Look or {}
	local sl = type(style.Look) == "table" and style.Look or {}
	local look = {
		Species = bl.Species,
		Primary = bl.Primary,
		Eye = bl.Eye,
		Secondary = sl.Secondary or bl.Secondary,
		WingStyle = sl.WingStyle or bl.WingStyle,
		WingColor = sl.WingColor or bl.WingColor,
		Accessory = sl.Accessory or bl.Accessory,
		Glow = bl.Glow == true or sl.Glow == true,
		Hybrid = true,
		BodyId = body.Id,
		StyleId = style.Id,
		Seed = rec.Seed,
	}
	if tier ~= "Normal" then
		look.Finish = tier
	end

	local elements = cleanElements(rec.Elements)
	if #elements == 0 then
		elements = cleanElements({ body.Element, style.Element })
	end
	local listed = higherRarity(body.Rarity, style.Rarity)
	local rarity = rec.Rarity
	if type(rarity) ~= "string" or not rarityOrder(rarity) then
		rarity = listed
	end
	-- a raid pet is listed Mythic with Secret-grade stats (StatRarity), and a hybrid of one keeps them. Read off the parents,
	-- never saved: FusionService stores the listed rarity on a new record, so that counts as new too. A record stored with
	-- another rarity (made before its parent moved) is kept as it was: its own Rarity already gives its stats.
	local statRarity = nil
	if rarity == listed then
		local top = higherRarity(body.StatRarity or body.Rarity, style.StatRarity or style.Rarity)
		if top ~= rarity then
			statRarity = top
		end
	end
	local bonus = PetKeys.HybridStatBonus
	local stats = average(body.Stats, style.Stats, bonus)
	local role = body.Role
	if type(stats.Income) == "number" and type(stats.Power) == "number" then
		role = (stats.Income > stats.Power) and "Economy" or "Combat"
	end
	local special = nil
	local giver = (specialFrom == "Style") and style or body
	if type(giver.Special) == "table" then
		special = shallowCopy(giver.Special)
	end
	local name = cleanName(rec.Name) or PetKeys.BlendName(body.Name, style.Name)

	local def = {
		Id = key,
		Key = key,
		PetId = nil,
		IsHybrid = true,
		HybridId = parsed.HybridId,
		Body = body.Id,
		Style = style.Id,
		BodyDef = body,
		StyleDef = style,
		Name = name,
		DisplayName = tierLabel(tier, name),
		Rarity = rarity,
		StatRarity = statRarity,
		Blurb = "A fusion of " .. tostring(body.Name) .. " and " .. tostring(style.Name) .. ".",
		Look = look,
		Perks = average(body.Perks, style.Perks, bonus),
		Role = role,
		Stats = stats,
		Special = special,
		Element = elements[1],
		Elements = elements,
		Tier = tier,
		StatMultiplier = PetKeys.TierMultiplier[tier] or 1,
	}
	return cachePut(sig, def)
end

function PetKeys.DefOf(key, profile)
	local parsed = PetKeys.Parse(key)
	if not parsed then
		return nil
	end
	if parsed.HybridId then
		local rec = hybridRecord(profile, parsed.HybridId)
		if not rec or not validPetId(rec.Body) or not validPetId(rec.Style) then
			return nil
		end
		return hybridDef(key, parsed, rec)
	end
	local base = catalogDef(parsed.PetId)
	if not base then
		return nil
	end
	if parsed.Tier == "Normal" then
		return base
	end
	return tierDef(base, key, parsed.Tier)
end

function PetKeys.DisplayName(key, profile)
	local def = PetKeys.DefOf(key, profile)
	if not def then
		return nil
	end
	return def.DisplayName or def.Name
end

----------------------------------------------------------------------
-- Listing
----------------------------------------------------------------------
local function catalogPosition()
	local pos = {}
	local c = getCatalog()
	if c and type(c.Pets) == "table" then
		for i, def in ipairs(c.Pets) do
			if type(def) == "table" and def.Id ~= nil then
				pos[def.Id] = i
			end
		end
	end
	return pos
end

function PetKeys.List(profile)
	local owned = PetKeys.Owned(profile)
	local pos = catalogPosition()
	local hasCatalog = next(pos) ~= nil
	local plain, hybrids = {}, {}
	for key in pairs(owned) do
		local parsed = PetKeys.Parse(key)
		if parsed and parsed.HybridId then
			local def = PetKeys.DefOf(key, profile)
			if def then
				hybrids[#hybrids + 1] = { Key = key, Name = def.Name, Order = rarityOrder(def.Rarity) or 0 }
			end
		elseif parsed and (not hasCatalog or pos[parsed.PetId]) then
			plain[#plain + 1] = { Key = key, Pos = pos[parsed.PetId] or math.huge, PetId = parsed.PetId, Tier = TIER_INDEX[parsed.Tier] }
		end
	end
	table.sort(plain, function(a, b)
		if a.Pos ~= b.Pos then
			return a.Pos < b.Pos
		end
		if a.PetId ~= b.PetId then
			return a.PetId < b.PetId
		end
		return a.Tier < b.Tier
	end)
	table.sort(hybrids, function(a, b)
		if a.Order ~= b.Order then
			return a.Order < b.Order
		end
		if a.Name ~= b.Name then
			return a.Name < b.Name
		end
		return a.Key < b.Key
	end)
	local out = {}
	for _, e in ipairs(plain) do
		out[#out + 1] = e.Key
	end
	for _, e in ipairs(hybrids) do
		out[#out + 1] = e.Key
	end
	return out
end

return PetKeys
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1062">
        <Properties>
          <string name="Name">PetPoses</string>
          <string name="Source"><![CDATA[-- PetPoses: how a pet's body moves with its attacks (docs/superpowers/specs/2026-10-23-pet-attack-vfx-design.md
-- "Pet body animation", plan docs/superpowers/plans/2026-10-23-pet-attack-vfx.md Task 5). Poses ride on PetBuilder's
-- existing weld-free rig: a pose is a body offset (the caller applies it to the root) plus a rotation per animated
-- group kind that PetBuilder.Animate multiplies onto its own idle motion (opts.Pose). Pure: no Instances, no
-- services, no yields (CFrame / Vector3 values only); safe on the server and the client. Plain Lua 5.1-compatible
-- syntax only.
--
-- API:
--   PetPoses.Names = { "Windup", "Strike", "Shoot", "Recoil", "Cast", "Hurt", "Ko", "Victory", "IdleBattle", "DashIn", "DashBack",
--                      "DashBite", "DashDouble", "DashThorns", "DashReady" }
--   PetPoses.Loops = { IdleBattle = true, DashReady = true }   p is TIME in seconds (any value)
--   PetPoses.Holds = { Ko = true, DashIn = true, DashBite = true, DashThorns = true }  p = 1 is the pose's end state, held
--                                            (the KO'd pet lies on its side until the poof covers it and the model is
--                                            parked; a dashed-in pet stands at the target's edge until its DashBack);
--                                            every other one-shot pose is exactly at rest at p = 1 and at p = 0 too, but
--                                            DashBack (starts at the edge DashIn holds), DashDouble / DashThorns (start
--                                            from the bite's nose-down landing, as the chomp they replace)
--   PetPoses.DASH_RUN = 5 / 7                DashIn's / DashBite's hops land the bite at this p (AttackFx times it on the hit)
--   PetPoses.WINDUP_LOAD = 0.82              the melee Windup is fully loaded here (a dash's wind-up ends on it)
--   PetPoses.TREMBLE_HZ = 12.5, TREMBLE_MIN = 0.3   the melee Windup's tremble (real seconds) and the shortest wind-up
--                                            (to its load) that trembles
--   PetPoses.BACK_POSE = 1.4, BACK_HOME = 0.625   DashBack lasts Melee.Back x BACK_POSE; it is home at p BACK_HOME
--   PetPoses.DOUBLE_DUR = 0.15, DOUBLE_BITE = 0.6, THORN_DUR = 0.34, THORN_BACK = 1.3, REBOUND = 0.7, READY_BOUNCE = 0.17
--   PetPoses.FEET = { Down, Front, Hind }    a typical pet's paw lines (pose studs) when Sample gets no `feet` (a `feet`
--                                            Hop weighs the hops: an evolved form's 0.78, the mock's heavy lanes)
--   PetPoses.Landings[name] = { p, ... }     where the melee motion's hops come down (the landing dust's beats)
--   PetPoses.Offset(name, p, ranged, amp, reach, feet) -> Vector3   the pose's own move without its turn (where a
--                                            paw-pivoted pose's paw lines are: its Body position also carries the turn about
--                                            them)
--   PetPoses.HURT_SECS = 0.62                a hit's reaction (Hurt) in seconds after its hit stop (AttackFx's K.HURT);
--                                            a re-hit's Sample reach lists every hit it plays (see Hurt below)
--   PetPoses.DashHop = nil                   Config Melee.Hop in studs (0..3; nil = 0.5), set by AttackFx.Dash: every Bounce in
--                                            hop height x max(0.25, DashHop) / 0.5 (DashIn's first hop peaks at 1.1 x it;
--                                            0 still hops 0.275: a flatter hop lands like a slide)
--   PetPoses.Sample(name, p, ranged, amp, reach, feet) -> {
--       Body   = CFrame   offset of the pet's root in its OWN frame (the pet faces -Z = LookVector, up +Y, right
--                        +X; PetBuilder header), studs as written below (battle units: BattleController writes
--                        root = frame * Body; PetBuilder.PoseBody(opts) returns it)
--       Groups = { [kind] = CFrame }   per PetBuilder group kind ("wing", "cloud", "tail", "bob", "orbit"): a turn
--                        (+ lift) in the PET's frame about the group's hinge point, written for the LEFT side (Side =
--                        1: the left wing reaches towards -X). Pet-frame axes keep "swept back 25 deg" the same on
--                        every form (hinges are swept back 0.5 .. 1.35 rad and tilted, differently per form). Animate
--                        mirrors it for Side = -1 and scales the "bob" lift by the model's PB_Scale. Wings: "open" /
--                        "spread" = swung forward towards broadside (a bigger silhouette); they are never raised by
--                        more than ~10 deg (evolved wings already rest near upright: more would fold them over the back)
--       Lids   = 0..1    eyelids closed (Animate shows the EyeLid parts at >= 0.5)
--       Still  = 0..1    how much of the idle wing flap / tail wag / halo bob to hold back (1 = frozen at rest:
--                        wings held open, a limp KO'd tail)
--   }   p is clamped to 0..1 (one-shot poses; nil / NaN = 0); `ranged` = the ranged variant (Strike: a kick back
--       instead of the lunge; Windup / Recoil: rear back). An unknown name = rest. `amp` (number, default 1, clamped
--       1 .. LEAP_AMP_MAX 1.25) scales the melee Strike's leap (length and height grow a little with rarity: AttackFx
--       passes 1 + 0.08 per band above Common); every other pose ignores it. `reach` (studs at scale 1, optional,
--       >= 0, a safety ceiling LEAP_REACH_MAX 240 (the real clamp is AttackFx's, in world studs); nil = the fixed 1.5 x
--       amp hop): the melee Strike's forward distance, so the leap
--       lands on the target (Task 9 player decision: AttackFx measures the gap between the two models' facing edges,
--       minus a contact margin, and divides it by the caster's PB_Scale); the hop gets higher with it.
--
-- The shapes (spec + plan values; the extra motion is the "feel": anticipation, overshoot, settle):
--   Windup     melee (Pitch 2 item 5, the owner: "the wind-up looked wrong": the old crouch sank the paws 0.25 studs
--              into the floor): it rocks back onto its hind paws (9 deg in 0.12 s, pitched about the paw line: nothing
--              sinks), trembles (TREMBLE_HZ 12.5, +-1.4 deg), loads deeper (15 deg in its last 0.07 s, at WINDUP_LOAD 0.82:
--              a dash's wind-up ends there, DashIn starts from it), then springs back to rest (the push-off into Strike);
--              wings swept back 25 deg and folded tight, tail up and lashing. Its beats are in real seconds (gate review r0):
--              `reach` = the pose's length in seconds (nil = WINDUP_SECS, the strip's 0.45 s to the load); a wind-up under
--              TREMBLE_MIN 0.3 s to its load (the real NPC one, 0.25 s on the client since 2026-11-20; a fighter's 0.10)
--              rocks and loads in one eased gather (exactly 60 % / 40 %, nothing held between), no tremble. Ranged rears
--              back (crouch 0.25, weight back, chin up), unchanged.
--   Strike     melee (player note (a), fix round 3): a LEAP at the target: a hop arc 0.8 studs high (x amp) that carries
--              the body 1.5 studs (x amp) along the LookVector (with `reach`: exactly `reach` studs, the hop
--              min(LEAP_H_MAX, (0.8 + 0.12 x reach) x amp) high: Task 9), chin up on take-off, nose down coming in, landing at
--              p = 0.26 exactly when the hit lands (AttackFx times the pose so), a small squash on landing, then the
--              recoil: it settles back with a small overshoot behind the start. Wings snap open 35 deg (overshoot ~38).
--              ranged: a kick back 0.35 studs, chin up, wings snap open 35 deg, settle.
--   Shoot      the basic ranged attack's release (player note 1: a shot, never the melee lunge; it follows the ranged
--              Windup's rear-back): the head snaps forward and down 14 deg to loose the shot (a spit / a slap of the
--              air) while the body kicks back 0.45 studs and a little up, wings brace forward 20 deg with a downbeat,
--              tail flicks up; then settles. The body never moves forward of its spot.
--   Recoil     rear back: 0.5 studs back (ranged 0.35), up and nose high, wings flare forward to brace, tail down.
--   Cast       rise 0.6 studs, wings spread 50 deg and held, tail up, eyes shut gathering power, a hover bob, then the
--              release: a forward thrust + nod and a wing downbeat; soft landing.
--   Hurt       (Pitch 2 item 5 "Bounce in" A, the approved mock's bitten pet; it was a squash dip into the floor + a flinch
--              0.3 turned about the middle) one rigid body pivoted on its paw lines (`feet`): knocked back 0.38 in a 0.10
--              jolt off the floor (0.14 s), the head snapped back (~7 deg nose up), a springy rock (~4 deg nose down onto
--              the front paws, back) dying away, home over the mock's 0.30 .. 0.62 s with a low lift (0.025); nothing
--              under the floor, nothing slides; an evolved body (feet Hop 0.78) knocked back x 0.75, jolted and rocked
--              x 0.8 (the mock's); beats in seconds (p 1 = HURT_SECS
--              0.62, AttackFx's K.HURT). `amp` = the hit's power (nil = 1). `reach` = a re-hit's hits: { Secs, { Age,
--              Power }, ... }: each reacts on its own time and the reactions add (the mock's), so a re-hit starts where the
--              pet is, never pulled toward its biter, and stacks on top. Wings clamp down, tail tucks, halo knocked askew,
--              lids shut (0.02 .. 0.29 s).
--   Ko         knocked back 0.6 + a little hop, tumbles 90 deg onto its side (overshoot ~95, settle), drops 0.35,
--              wings fold back limp along the body, tail limp (Still -> 1), halo slides askew, eyes shut. Holds at p = 1.
--   Victory    a quick crouch, hop 1.2 studs with a full 360 deg spin (fastest mid-air), chin up, wings open, tail up,
--              halo spinning, then a squash landing that settles.
--   IdleBattle breathing 0.05 studs (1.8 s), and every 2-4 s a glance: a 10-13 deg look aside with a curious head tilt
--              and a tail flick (the rig has no ear / head groups: the glance turns the whole body).
--   DashIn     (battle-feel T2; Pitch 2 item 5 "Bounce in" A, docs/superpowers/specs/2026-11-20-pitch2-build-design.md) the
--              melee dash in, timed on Melee.In 0.30 s (p 0 .. DASH_RUN 5/7) then the chomp (DASH_RUN .. 1, 0.12 s): from
--              the melee Windup's loaded pose (rocked back 15 deg on the hind paws) a hop to 48 % of `reach` (0.13 s, 0.55
--              studs high), a nod as it lands on its front paws (0.04 s), a hop-bite onto the target (0.13 s, 0.36 high, nose
--              down 15) landing at DASH_RUN exactly when the hit lands, then the chomp (the head snaps up and bites down
--              again), upright at p 1, held there (Holds) at exactly (0, 0, -reach). reach nil = 1.5 x amp.
--   DashBack   the way home (AttackFx: Dur = Melee.Back x BACK_POSE 1.4 = 0.56 s): from (0, 0, -reach) a hop back to 45 %
--              (0.16 s, 0.42 high, nose up), a rock on the hind paws as it lands (0.03 s), a hop home (0.16 s, 0.32 high) landing
--              at BACK_HOME 0.625, then a rocking settle on the spot (0.21 s); exactly at rest at p 1.
--   DashBite   (item 5) a flurry's bite (bites closer than Melee.FlurryBelow: no trip home): `reach` = studs behind the face it
--              starts (0 at the face); a rebound hop back to REBOUND 0.7 behind the face (in place when it already stands that
--              far back; 12 / 30 of the run), a rock as it lands (the strip's 0.06 s: 12 / 30 .. 18 / 30), a hop-bite onto
--              the face landing at DASH_RUN on the hit, the chomp; held there.
--   DashDouble (item 5) a Double strike's second chomp at the face (0.15 s): the second bite lands at DOUBLE_BITE 0.6.
--   DashThorns (item 5) a bite on a Thorns shield: the prick snaps the head back (rocked onto the hind paws, eyes shut), a hop
--              away `reach` studs (nil = THORN_BACK 1.3), a rock as it lands; held there (Holds), upright.
--   DashReady  (item 5, loops: p = time) the flurry's ready bounce on the spot between bites: READY_BOUNCE 0.17 s hops of
--              0.07 studs with a little rock, on the floor (and level) at every multiple of READY_BOUNCE.
--   The melee motion is ONE rigid body (the rig has no scale channel and no leg groups): a pitch turns it about its paw line
--   on the floor (hind paws nose up, front paws nose down: f.paw) and about its middle in the air, blended
--   over the first BLEND_H of a hop; Sample's `feet` (AttackFx.FeetOf: pose studs, scale 1) places the paw lines, nil =
--   FEET. Nothing goes under the floor (a paw that would dips lifts the whole body) and nothing slides (a paw on the floor
--   never moves along it: every move along the ground is a hop).

local PetPoses = {}

PetPoses.Names = { "Windup", "Strike", "Shoot", "Recoil", "Cast", "Hurt", "Ko", "Victory", "IdleBattle", "DashIn", "DashBack",
	"DashBite", "DashDouble", "DashThorns", "DashReady" }
PetPoses.Loops = { IdleBattle = true, DashReady = true }
PetPoses.Holds = { Ko = true, DashIn = true, DashBite = true, DashThorns = true }

local PI = math.pi
local TAU = 2 * math.pi
local sin, cos, rad, floor = math.sin, math.cos, math.rad, math.floor

-- Strike / Recoil / Hurt / Victory values (studs, degrees)
local LUNGE = 1.5
local LEAP_H = 0.8 -- the melee Strike's hop height at amp 1 (studs)
local LEAP_LAND = 0.26 -- the leap lands (and the hit lands) at this p
PetPoses.LEAP_AMP_MAX = 1.25
-- studs (scale 1): a safety ceiling only (Task 9 review M5: the leap is clamped ONCE, by AttackFx.LeapReach, at LEAP_MAX
-- 12 WORLD studs, then divided by the caster's PB_Scale; a pose clamp of 12 bit first below scale 1 and landed short).
-- 240 = 12 / PetBuilder's smallest scale 0.05, so a reach AttackFx sends never meets it
PetPoses.LEAP_REACH_MAX = 240
local LEAP_H_PER = 0.12 -- extra hop height per stud of reach (a longer jump goes higher)
local LEAP_H_MAX = 2.4 -- studs: the highest hop
local RANGED_KICK = 0.35
local SHOOT_KICK = 0.45
local CROUCH = 0.25
local WINDUP_BACK = 25
local SNAP_OPEN = 35
local CAST_RISE = 0.6
local CAST_SPREAD = 50
-- (Pitch 2 item 5 "Bounce in" A) the bitten pet of the approved mock (Hurt, motion_pitch.enemy_new): one hit's reaction
-- in seconds of its own time (after the hit stop): AttackFx's K.HURT. (look review r2, major 2) home at 0.62 like the
-- mock (the hit + 0.67), not 0.50: at the fast tempo the bear stays knocked back and the bites stack
local HURT_SECS = 0.62
PetPoses.HURT_SECS = HURT_SECS
local KNOCK = 0.38 -- studs: knocked back
local JOLT = 0.10 -- studs: the small jolt off the floor the knock-back flies in
-- s: knocked back in that jolt (in the air: nothing slides). (look review r3 minor: "stacked knock-back runs 5-10 % over
-- the mock") the mock's out3(v / 0.14), was 0.12: the knock-back arrived early and the stacked hits ran over
local HURT_OUT = 0.14
-- (look review r3 minor) the mock's evolved Sunbeam Bear (motion_pitch.enemy_new, heavy) is knocked back x 0.75 and
-- jolted / rocked x 0.8: a body's Hop weight (EVO_HOP 0.78) maps onto those two, 1 stays 1
local HURT_HEAVY_Z, HURT_HEAVY_Y = 0.25 / 0.22, 0.20 / 0.22
local HURT_ROCK = 13 -- deg: the springy rock's first swing (the head snapped back)
local HURT_HOME0 = 0.30 -- s: the way home starts (the mock's), home at HURT_SECS
-- studs: (look review r2, minor 1: the 0.06 hop at 0.28 .. 0.50 read as a second bounce) the way home is one low, slow
-- lift over the mock's whole way home (nothing slides)
local HURT_HOME = 0.025
local HURT_WINGS = 0.5 -- s: the wings / tail / halo / lids keep their beats at the old length
local KO_ROLL = 90
local HOP = 1.2
local BREATH = 0.05
local GLANCE_CELL = 3 -- one glance per cell, starting 0..1 s into it: 2-4 s between two glances
local GLANCE_TIME = 1.1
-- (battle-feel T2; Pitch 2 item 5 "Bounce in" A) the dash: Melee.In 0.30 s of hops, then the 0.12 s chomp
PetPoses.DASH_RUN = 5 / 7 -- DashIn's / DashBite's hops end (the bite lands) at this p
-- DashIn's nod on the front paws: this share of the run's hops (AttackFx gives it at least 0.04 s of a short run: look
-- review r2 minor, the owner's 0.25 s wind-up leaves a 0.20 s run)
PetPoses.DASH_NOD = { 13 / 30, 17 / 30 }
PetPoses.WINDUP_LOAD = 0.82 -- the melee Windup's deepest load (a dash's wind-up ends here; DashIn starts from it)
-- (gate review r0, major 1) the melee Windup in real seconds (Sample's `reach` = its length; AttackFx passes the Dur)
PetPoses.TREMBLE_HZ = 12.5 -- the tremble while the telegraph is up (the strip's 13 Hz)
PetPoses.TREMBLE_MIN = 0.3 -- s to the load: a shorter wind-up (the real NPC one, 0.25 s on the client) does not tremble
local WINDUP_SECS = 0.45 / 0.82 -- the length when none is given (the strip's 0.45 s to the load: BattleController's hold)
local ROCK_T, DEEP_T = 0.12, 0.07 -- s: the rock back to 9 deg, the load to 15 deg before the run (at most 60 % / 40 % of it)
local TREMBLE = 1.4 -- deg
PetPoses.BACK_POSE = 1.4 -- DashBack's Dur = Melee.Back x this (0.40 -> 0.56 s)
PetPoses.BACK_HOME = 0.625 -- DashBack's second hop lands home at this p (0.35 of 0.56 s); the settle after it
PetPoses.DOUBLE_DUR = 0.15 -- s: DashDouble (the Double strike's second chomp) ...
PetPoses.DOUBLE_BITE = 0.6 -- ... its bite lands at this p (0.09 s in)
PetPoses.THORN_DUR = 0.34 -- s: DashThorns (the prick 0.12, the hop away 0.16, the landing 0.06)
PetPoses.THORN_BACK = 1.3 -- studs: the hop away from a Thorns shield
PetPoses.REBOUND = 0.7 -- studs: a flurry bite's rebound hop back from the face
PetPoses.READY_BOUNCE = 0.17 -- s: one DashReady bounce
-- a typical pet's paw lines (pose studs from the root: AttackFx.FeetOf measures each model; this when none is given)
PetPoses.FEET = { Down = 1.3, Front = 0.5, Hind = 0.5 } -- (the Maple Fox, measured)
-- the p at which each hop comes down with a rock (AttackFx kicks the landing dust there): DashIn's nod on the front
-- paws, DashBack's two hops home, DashBite's rebound, DashThorns' hop away. Not the bite's own landing (the hit's
-- impact plays there) nor DashReady's little bounces
PetPoses.Landings = {
	DashIn = { 13 / 30 * PetPoses.DASH_RUN },
	DashBack = { 0.16 / 0.56, 0.35 / 0.56 },
	DashBite = { 12 / 30 * PetPoses.DASH_RUN },
	DashThorns = { 0.28 / PetPoses.THORN_DUR },
}
local BLEND_H = 0.25 -- studs: a hop's pivot moves from the paw line to the middle over its first BLEND_H of height
local HOP_MIN = 0.25 -- Melee.Hop under this hops as this (half the shipped hops: a flatter hop lands like a slide)
-- the Bounce in's hop heights (studs at Melee.Hop 0.5; each x max(HOP_MIN, Hop) / 0.5)
local BH = { In1 = 0.55, In2 = 0.36, Back1 = 0.42, Back2 = 0.32, Rebound = 0.26, Bite = 0.30, Thorn = 0.34, Ready = 0.07 }
local DASH_HOP = 0.5 -- studs: the default of Config.Battle.Feel.Melee.Hop (the pose stays pure: no Config here)
-- (battle-feel gate) PetPoses.DashHop = the knob's studs (0..3), set by AttackFx.Dash before it schedules a DashIn; nil = DASH_HOP
PetPoses.DashHop = nil
local function dashHop()
	local h = PetPoses.DashHop
	if type(h) ~= "number" or h ~= h or h == math.huge or h == -math.huge then
		return DASH_HOP
	end
	return math.max(0, math.min(3, h))
end
-- the Bounce in's hop height scale (Melee.Hop / 0.5, at least HOP_MIN / 0.5)
local function hopK()
	return math.max(HOP_MIN, dashHop()) / DASH_HOP
end
-- (review minor: "evolved pets hop x0.78 heavier", the mock's heavy lanes) the body's weight from Sample's `feet`: its
-- Hop (AttackFx.FeetOf: EVO_HOP 0.78 for an evolved form), 1 when none is given (finite, 0.25 .. 1.5)
local function heavyOf(feet)
	local v = type(feet) == "table" and tonumber(feet.Hop) or nil
	if v == nil or v ~= v or v < 0.25 or v > 1.5 then
		return 1
	end
	return v
end

----------------------------------------------------------------------
-- Easing
----------------------------------------------------------------------
local function clamp01(x)
	if x ~= x or x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

-- 0..1 progress of p through [a, b]
local function seg(p, a, b)
	return clamp01((p - a) / (b - a))
end

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

local function outCubic(x)
	x = 1 - clamp01(x)
	return 1 - x * x * x
end

-- ease out with an overshoot of the target (s = 1.70158: peaks at 1.1)
local function outBack(x, s)
	x = clamp01(x)
	if x == 0 then
		return 0 -- exactly (the formula leaves a rounding crumb)
	end
	x = x - 1
	return 1 + (s + 1) * x * x * x + s * x * x
end

-- 1 -> 0, ease in-out, dipping softly past 0 (by about os / 4) before coming to rest; still at both ends
local function settle(u, os)
	u = clamp01(u)
	local b = sin(PI * seg(u, 0.45, 1))
	return 1 - smooth(u) - os * b * b
end

-- 0 -> 1 -> 0 over [a, d]: up through [a, b], held, down through [c, d] (smooth)
local function plateau(p, a, b, c, d)
	return smooth(seg(p, a, b)) * (1 - smooth(seg(p, c, d)))
end

-- deterministic 0..1 per integer
local function hash(k)
	local x = sin(k * 12.9898 + 78.233) * 43758.5453
	return x - floor(x)
end

-- (Pitch 2 item 5) a smoothstepped key track { t1, v1, t2, v2, ... } at u (held before the first key and after the last)
local function keys(u, k)
	if u <= k[1] then
		return k[2]
	end
	for i = 1, #k - 3, 2 do
		local t0, v0, t1, v1 = k[i], k[i + 1], k[i + 2], k[i + 3]
		if u < t1 then
			return v0 + (v1 - v0) * smooth((u - t0) / (t1 - t0))
		end
	end
	return k[#k]
end

-- (Pitch 2 item 5) a ballistic hop of f over u in [t0, t1): along z0 -> z1 (near linear, a little ease at both ends: it
-- leaves and lands moving), up a parabola h studs high, the pitch eased pa -> pb. -> whether u is inside it
local function hop(f, u, t0, t1, z0, z1, h, pa, pb)
	if u >= t0 and u < t1 then
		local q = (u - t0) / (t1 - t0)
		f.z = z0 + (z1 - z0) * (0.8 * q + 0.2 * smooth(q))
		f.y = 4 * h * q * (1 - q)
		f.pitch = pa + (pb - pa) * smooth(q)
		return true
	end
	return false
end

-- (Pitch 2 item 5) the chomp after a bite (q 0..1 over 0.12 s): the head snaps up and bites down again, then upright
local CHOMP = { 0, -15, 0.4167, -4, 0.75, -9, 1, 0 }

-- (Pitch 2 item 5) on the floor the pivot is the paw line, in the air the middle: blended over the hop's first BLEND_H
-- of height (pawBody)
local function grounded(f)
	f.paw = true
end

----------------------------------------------------------------------
-- The poses: each fills a frame of plain numbers (studs, degrees)
----------------------------------------------------------------------
--   x, y, z          body offset (z + = back: the pet faces -Z)
--   pitch, yaw, roll body rotation (pitch + = nose up)
--   raise, back      wings, about the hinge in the pet's frame (left wing: raise + = tip up, back + = tip swept
--                    back, back - = swung forward / open)
--   lift, sway       tail (lift + = up)
--   haloY, haloTilt, haloSpin   the floating halo ("bob"); orbitSpin = the aura ("orbit")
--   lids, still
local POSES = {}

POSES.Windup = function(f, p, ranged, _, secsIn)
	local load = PetPoses.WINDUP_LOAD
	local r = seg(p, load, 1) -- spring up (accelerating: the push-off)
	local a
	local lashes = 2
	if ranged then
		a = smooth(seg(p, 0, 0.5)) * (1 - r * r) -- gather into the crouch
		f.y = -CROUCH * a
		f.z = 0.2 * a
		f.pitch = 8 * a
	else
		-- (Pitch 2 item 5) rocked back onto the hind paws (pitched about the paw line: nothing sinks, nothing slides), a
		-- tremble while the telegraph is up (0 at both its ends), loaded deeper at WINDUP_LOAD, then back to rest.
		-- (gate review r0, major 1) its beats run in real seconds: `secsIn` = the pose's length (nil = WINDUP_SECS), so the
		-- tremble is TREMBLE_HZ however long the wind-up is, and a wind-up under TREMBLE_MIN to its load (the real NPC one:
		-- 0.25 s on the client) is one eased rock back and load with no tremble (at ~40 Hz it was a jitter)
		local L = (secsIn and secsIn > 0) and secsIn or WINDUP_SECS
		local W = load * L -- seconds to the load
		local t = math.min(p, load) * L
		local long = W >= PetPoses.TREMBLE_MIN
		-- (the owner, 2026-11-20: the NPC's wind-up is 0.25 s on the client) a short one is exactly 60 % rock and 40 % load,
		-- one gather with no frozen stretch between (the fixed 0.12 s rock held 9 deg for 0.06 s of a 0.25 s wind-up)
		local rockT, deepT = 0.6 * W, 0.4 * W
		if long then
			rockT, deepT = math.min(ROCK_T, rockT), math.min(DEEP_T, deepT)
		end
		local rk = long and outCubic(seg(t, 0, rockT)) or smooth(seg(t, 0, rockT)) -- (a short one eases in: no snap)
		local deep = smooth(seg(t, W - deepT, W))
		local trem = 0
		if long then
			local a0, a1 = rockT, W - deepT -- held between the rock and the load
			trem = TREMBLE * sin(TAU * PetPoses.TREMBLE_HZ * (t - a0)) * smooth(seg(t, a0, a0 + 0.05)) * (1 - smooth(seg(t, a1 - 0.06, a1)))
		end
		a = rk * (1 - r * r)
		f.pitch = (9 * rk + 6 * deep + trem) * (1 - r * r)
		f.paw = true
		lashes = math.max(1, floor(W / 0.2 + 0.5)) -- (about 4.4 a second: a short wind-up lashes once, not at 13 Hz)
	end
	f.back = WINDUP_BACK * a
	f.raise = -10 * a
	f.lift = 30 * a
	-- the tail lashes before the pounce (melee: whole lashes by the load, level there, so DashIn takes over without a pop)
	f.sway = 12 * sin(TAU * lashes * (ranged and p or math.min(1, p / load))) * a
	f.haloY = 0.05 * a -- the halo lags as the body drops
	f.still = 0.35 * a
end

POSES.Strike = function(f, p, ranged, amp, reachIn)
	-- the wings snap open early, hold, and fold back with the settle
	local wings = outBack(seg(p, 0, 0.14), 1.70158) * settle(seg(p, 0.4, 1), 0.15)
	f.back = -SNAP_OPEN * wings -- swung forward, broadside: the silhouette opens
	f.raise = 6 * wings
	f.still = 0.6 * math.min(1, wings)
	if ranged then
		local e = outCubic(seg(p, 0, 0.1)) * settle(seg(p, 0.22, 1), 0.12)
		f.z = RANGED_KICK * e
		f.y = 0.04 * e
		f.pitch = 10 * e
		f.lift = 10 * e
		f.haloTilt = -8 * e
	else
		-- the leap (player note (a)): take-off at p = 0, the hop arc, landing on the target at LEAP_LAND (the hit)
		amp = amp or 1
		local air = seg(p, 0, LEAP_LAND)
		local reach, hop = LUNGE * amp, LEAP_H * amp
		if reachIn then -- (Task 9: the measured gap: the leap lands on the target's near edge)
			reach = reachIn
			hop = math.min(LEAP_H_MAX, (LEAP_H + LEAP_H_PER * reach) * amp)
		end
		-- the recoil's overshoot behind the start stays small on a long leap (<= 0.27 studs)
		local lunge = reach * smooth(air) * settle(seg(p, 0.38, 1), 0.18 * math.min(1, LUNGE / math.max(reach, 1e-3)))
		local k = reach > 1e-3 and math.min(1, lunge / LUNGE) or 0
		f.z = -lunge
		f.y = hop * sin(PI * air) -- the hop: up, over, down onto the target
			- 0.08 * sin(PI * seg(p, LEAP_LAND, 0.36)) -- a little squash on landing
		-- chin up on take-off, then nose down onto the hit (eased back with the recoil)
		f.pitch = 12 * sin(PI * seg(air, 0, 0.5)) - 16 * smooth(seg(air, 0.4, 1)) * settle(seg(p, 0.38, 1), 0)
		f.lift = -20 * k -- the tail streams flat behind
		f.haloY = -0.06 * k
		f.haloTilt = 10 * k
	end
end

POSES.Shoot = function(f, p)
	local kick = outCubic(seg(p, 0, 0.12)) * settle(seg(p, 0.3, 1), 0) -- the body kicks back, then settles (no overshoot: never forward)
	local snap = sin(PI * seg(p, 0, 0.18)) -- the head snaps forward and back (0 -> 1 -> 0)
	f.z = SHOOT_KICK * kick -- (+ = back: never forward of its spot)
	f.y = 0.08 * kick
	f.pitch = -14 * snap + 8 * kick * seg(p, 0.1, 0.24) -- nose down to loose the shot, then the chin comes up
	f.back = -20 * kick -- wings brace forward
	f.raise = -10 * snap + 4 * kick -- a downbeat with the shot
	f.lift = 22 * kick
	f.sway = 8 * sin(TAU * 1.5 * p) * kick
	f.haloTilt = -8 * kick
	f.still = 0.45 * kick
end

POSES.Recoil = function(f, p, ranged)
	local e = outCubic(seg(p, 0, 0.2)) * settle(seg(p, 0.35, 1), 0.12)
	f.z = (ranged and RANGED_KICK or 0.5) * e
	f.y = 0.12 * e
	f.pitch = 16 * e
	f.back = -15 * e -- wings flare forward to brace
	f.raise = 6 * e
	f.lift = -20 * e
	f.haloTilt = -10 * e
	f.still = 0.3 * e
end

POSES.Cast = function(f, p)
	local r = smooth(seg(p, 0, 0.42)) -- rise
	local up = outCubic(seg(p, 0.66, 0.74)) -- the release
	local rb = up * (1 - smooth(seg(p, 0.74, 0.95)))
	local hover = 0.03 * sin(TAU * seg(p, 0.42, 0.66) * 2) * plateau(p, 0.42, 0.48, 0.6, 0.66)
	local down = seg(p, 0.78, 1)
	local held = 1 - smooth(down)
	f.y = CAST_RISE * r * settle(down, 0.15) + hover
	f.z = -0.2 * rb -- a forward thrust with the release
	f.pitch = 10 * r * (1 - up) - 10 * rb -- looking up while gathering, a nod at the target on release
	f.back = -CAST_SPREAD * r * held -- spread wide (broadside)
	f.raise = r * held * (8 - 22 * rb) -- a downbeat on release
	f.lift = 25 * r * held
	f.haloY = 0.25 * r * held
	f.haloSpin = TAU * smooth(p)
	f.orbitSpin = TAU * smooth(p)
	f.lids = (p >= 0.32 and p < 0.62) and 1 or 0 -- eyes shut, gathering power
	f.still = 0.6 * r * held
end

-- (Pitch 2 item 5) one hit's reaction at t seconds of its own time (t <= 0: still to land; >= HURT_SECS: home) ->
-- knock-back 0..1 of KNOCK, lift (studs), pitch (deg), the wings' envelope 0..1, lids 0..1. The mock's
-- motion_pitch.enemy_new: knocked back in a jolt over HURT_OUT, the head snapped back, a springy rock dying away (faded
-- out by HURT_SECS), home over HURT_HOME0 .. HURT_SECS with a low lift (HURT_HOME: nothing slides)
local function hurtHit(t)
	if not (t > 0 and t < HURT_SECS) then
		return 0, 0, 0, 0, 0
	end
	local out = seg(t, 0, HURT_OUT)
	local home = seg(t, HURT_HOME0, HURT_SECS)
	local knock = outCubic(out) * (1 - smooth(home))
	local lift = JOLT * sin(PI * out) + HURT_HOME * sin(PI * home)
	local pitch = HURT_ROCK * outCubic(seg(t, 0, 0.06)) * math.exp(-t / 0.13) * cos(TAU * t / 0.3) * (1 - smooth(seg(t, 0.36, HURT_SECS)))
	local q = t / HURT_WINGS
	local env = outCubic(seg(q, 0, 0.12)) * settle(seg(q, 0.22, 1), 0.14)
	local lids = clamp01(q / 0.04) * (1 - seg(q, 0.58, 0.64))
	return knock, lift, pitch, env, lids
end

-- a hit's power (nil = 1; 0 .. 2)
local function hurtPower(v)
	v = tonumber(v)
	if v == nil or v ~= v then
		return 1
	end
	return math.max(0, math.min(2, v))
end

-- (Pitch 2 item 5 "Bounce in" A: the bitten pet of the approved mock; the old Hurt turned about the body's middle, dipped
-- 0.1 into the floor and rolled a side paw under it) one rigid body like the melee motion, pivoted on its paw lines:
-- knocked back KNOCK in the air (a JOLT off the floor over HURT_OUT: nothing slides), the head snapped back (nose up), a
-- springy rock (nose down onto the front paws, up again) dying away, home over the mock's way home with a low lift
-- (HURT_HOME: nothing slides); an evolved body (feet Hop 0.78) is knocked back x 0.75, jolted and rocked x 0.8 (the
-- mock's heavy lanes: HURT_HEAVY_Z / _Y). Its beats run in seconds: p 1 =
-- HURT_SECS (AttackFx's K.HURT). `amp` = the hit's power (nil = 1; a Double strike's re-hit 0.5). `hits` (Sample's reach;
-- look review r2, major 2: the mock ADDS each hit's reaction) = a re-hit's list of every hit it plays, its own included:
-- { Secs = its length in seconds (p 1), { Age = the hit's own reaction time at p 0 (an earlier hit > 0; its own, landing
-- after its hit stop, < 0), Power }, ... }; amp is then unused. Each hit reacts on its own time and the reactions add,
-- so a re-hit starts exactly where the pet is (never pulled toward its biter) and stacks on top
POSES.Hurt = function(f, p, _, amp, hits, feet)
	local w = heavyOf(feet)
	local list = type(hits) == "table" and hits or nil
	local secs = list and tonumber(list.Secs) or HURT_SECS
	if not (secs and secs == secs and secs > 0 and secs < 10) then
		secs = HURT_SECS
	end
	local t = p * secs
	local z, y, pitch, env, lids = 0, 0, 0, 0, 0
	local function add(at, power)
		if power <= 0 then
			return
		end
		local k, l, r, e, s = hurtHit(at)
		z, y, pitch = z + power * k, y + power * l, pitch + power * r
		env, lids = math.max(env, e), math.max(lids, s)
	end
	if list then
		for _, h in ipairs(list) do
			if type(h) == "table" then
				local age = tonumber(h.Age) or 0
				add(t + ((age == age) and age or 0), hurtPower(h.Power))
			end
		end
	else
		add(t, hurtPower(amp))
	end
	local wz, wy = 1 - (1 - w) * HURT_HEAVY_Z, 1 - (1 - w) * HURT_HEAVY_Y
	f.z = KNOCK * wz * z
	f.y = wy * y
	f.pitch = wy * pitch
	f.paw = true
	f.raise = -22 * env -- wings clamp down
	f.back = 10 * env
	f.lift = -30 * env -- tail tucks
	f.haloY = 0.08 * env
	f.haloTilt = 18 * env -- knocked askew
	f.lids = lids
	f.still = 0.7 * env
end

POSES.Ko = function(f, p)
	f.z = 0.6 * outCubic(seg(p, 0, 0.45)) -- knocked back
	f.y = 0.3 * sin(PI * seg(p, 0, 0.32)) -- a little hop
		- 0.35 * smooth(seg(p, 0.2, 0.55)) -- down onto its side
		+ 0.05 * sin(PI * seg(p, 0.5, 0.64)) -- a small bounce
	f.roll = KO_ROLL * outBack(seg(p, 0.06, 0.5), 1.2) -- tumbles over (~95), settles at 90
	f.pitch = 10 * sin(PI * seg(p, 0, 0.4))
	local limp = smooth(seg(p, 0.25, 0.7))
	f.raise = -20 * limp
	f.back = 45 * limp -- folded back along the body (lying on its side, they stay out of the floor)
	f.lift = -25 * limp
	f.haloTilt = 35 * smooth(seg(p, 0.2, 0.7))
	f.haloY = -0.12 * smooth(seg(p, 0.2, 0.7))
	f.lids = seg(p, 0.2, 0.24)
	f.still = smooth(seg(p, 0.15, 0.6))
end

POSES.Victory = function(f, p)
	local crouch = smooth(seg(p, 0, 0.14)) * (1 - smooth(seg(p, 0.14, 0.2)))
	local u = seg(p, 0.16, 0.74) -- in the air
	local air = sin(PI * u)
	local land = outCubic(seg(p, 0.74, 0.8)) * settle(seg(p, 0.8, 1), 0.1)
	f.y = -0.15 * crouch + HOP * 4 * u * (1 - u) - 0.12 * land
	f.yaw = 360 * smooth(u)
	f.pitch = 12 * air
	f.back = -30 * air -- opened wide in the air
	f.raise = 10 * air - 10 * land
	f.lift = 30 * air
	f.haloY = 0.12 * air
	f.haloSpin = TAU * smooth(seg(p, 0.2, 0.85))
	f.orbitSpin = TAU * smooth(u)
end

POSES.IdleBattle = function(f, t)
	local breath = sin(TAU * t / 1.8)
	f.y = BREATH * breath
	f.pitch = 1.2 * sin(TAU * t / 1.8 - 0.7)
	f.raise = 3 * breath
	-- the glance of this cell (cells never overlap: it starts 0..1 s in and lasts GLANCE_TIME)
	local cell = floor(t / GLANCE_CELL)
	local start = cell * GLANCE_CELL + hash(cell)
	local u = (t - start) / GLANCE_TIME
	if u > 0 and u < 1 then
		local env = outCubic(seg(u, 0, 0.25)) * (1 - smooth(seg(u, 0.6, 1)))
		local dir = (hash(cell + 7919) < 0.5) and -1 or 1
		f.yaw = dir * (10 + 3 * hash(cell + 104729)) * env
		f.roll = -dir * 3 * env -- a curious head tilt
		f.sway = dir * 15 * env -- and a tail flick
	end
end

-- (Pitch 2 item 5) the wings snap open into a bite and fold back with the chomp; the tail streams flat while it hops
local function biteWings(f, p, air)
	local R = PetPoses.DASH_RUN
	local wings = outBack(seg(p, R - 0.08, R), 1.70158) * (1 - smooth(seg(p, R + 0.4 * (1 - R), 1)))
	f.back = f.back - SNAP_OPEN * wings
	f.raise = f.raise + 6 * wings
	f.lift = f.lift - 20 * air
	f.haloTilt = 10 * air
	f.still = math.max(f.still, 0.6 * math.min(1, wings + air))
end

-- (battle-feel T2; Pitch 2 item 5 "Bounce in" A) the melee dash in: from the Windup's load, hop, nod on the front paws,
-- hop-bite onto the target on the hit (DASH_RUN), the chomp, held at the edge (p 1 = exactly (0, 0, -reach), upright)
POSES.DashIn = function(f, p, _, amp, reachIn, feet)
	local reach = reachIn or LUNGE * (amp or 1)
	local R = PetPoses.DASH_RUN
	local k = hopK() * heavyOf(feet)
	local u = seg(p, 0, R) -- through Melee.In: hop 0.13 s, nod 0.04, hop-bite 0.13
	local mid = -0.48 * reach
	local na, nb = PetPoses.DASH_NOD[1], PetPoses.DASH_NOD[2]
	if p < R then
		if not hop(f, u, 0, na, 0, mid, BH.In1 * k, 15, -6) then
			if u < nb then -- the nod: landed on the front paws, the nose dips and comes up (dust)
				f.z = mid
				f.pitch = keys(u, { na, -6, 0.5 * (na + nb), -10, nb, -2 })
			else
				hop(f, u, nb, 1, mid, -reach, BH.In2 * k, -2, -15)
			end
		end
	else
		f.z = -reach
		f.pitch = keys(seg(p, R, 1), CHOMP)
	end
	-- the wind-up's sweep (wings back, tail up, halo lagging) lets go over the first hop
	local wound = 1 - smooth(seg(u, 0, 0.35))
	f.back = WINDUP_BACK * wound
	f.raise = -10 * wound
	f.lift = 30 * wound
	f.haloY = 0.05 * wound
	f.still = 0.35 * wound
	biteWings(f, p, (p < R) and sin(PI * u) or 0)
	grounded(f)
end

-- (battle-feel T2; Pitch 2 item 5) the way home: hop back, a rock on the hind paws as it lands, hop home (at BACK_HOME),
-- a rocking settle on the spot; from (0, 0, -reach) at p 0 to rest at p 1
POSES.DashBack = function(f, p, _, amp, reachIn, feet)
	local reach = reachIn or LUNGE * (amp or 1)
	local k = hopK() * heavyOf(feet)
	local t = p * 0.56 -- the beats in seconds at Melee.Back 0.40 (Dur 0.56)
	local mid = -0.45 * reach
	if not hop(f, t, 0, 0.16, -reach, mid, BH.Back1 * k, 0, 9) then
		if t < 0.19 then -- landed on the hind paws first: rocks back, then level
			f.z = mid
			f.pitch = keys(t, { 0.16, 9, 0.175, 12, 0.19, 3 })
		elseif not hop(f, t, 0.19, 0.35, mid, 0, BH.Back2 * k, 3, 8) then
			f.pitch = keys(t, { 0.35, 8, 0.41, -5, 0.48, 2, 0.56, 0 }) -- home: the rocking settle
		end
	end
	local air = clamp01(f.y / 0.3)
	f.back = -20 * air -- wings flare to brake
	f.raise = 4 * air
	f.lift = 15 * air
	f.still = 0.4 * air
	grounded(f)
end

-- (Pitch 2 item 5) a flurry's bite (no trip home): a rebound hop back, a rock, a hop-bite onto the face on the hit, the
-- chomp; `offIn` = studs behind the face it starts (0 at the face); held at the face (p 1 = (0, 0, -off), upright)
POSES.DashBite = function(f, p, _, _, offIn, feet)
	local off = math.max(0, offIn or 0)
	local R = PetPoses.DASH_RUN
	local k = hopK() * heavyOf(feet)
	local rb = math.max(0, PetPoses.REBOUND - off) -- (in place when it already stands that far back)
	-- through the run: rebound 0.12 s, rock 0.06, hop-bite 0.12 (gate review r0: the rock was 0.03 s, an 8.8 deg snap in
	-- one 60 fps frame; the strip's rock is 0.06 s: 7 -> 10 deg in 0.02, back to level in 0.04)
	local u = seg(p, 0, R)
	if p < R then
		if not hop(f, u, 0, 12 / 30, 0, rb, BH.Rebound * k, 0, 7) then
			if u < 18 / 30 then
				f.z = rb
				f.pitch = keys(u, { 12 / 30, 7, 14 / 30, 10, 18 / 30, 0 })
			else
				hop(f, u, 18 / 30, 1, rb, -off, BH.Bite * k, 0, -15)
			end
		end
	else
		f.z = -off
		f.pitch = keys(seg(p, R, 1), CHOMP)
	end
	biteWings(f, p, (p < R) and clamp01(f.y / 0.2) or 0)
	grounded(f)
end

-- (Pitch 2 item 5) a Double strike's second chomp at the face: up, the second bite down at DOUBLE_BITE, upright
POSES.DashDouble = function(f, p)
	f.pitch = keys(p, { 0, -15, 0.33, -3, PetPoses.DOUBLE_BITE, -17, 1, 0 })
	local w = (p < 1) and sin(PI * p) or 0 -- (exactly 0 at rest: sin(pi) leaves a crumb)
	f.back = -SNAP_OPEN * 0.5 * w
	f.raise = 4 * w
	f.still = 0.5 * w
	grounded(f)
end

-- (Pitch 2 item 5) a bite on a Thorns shield: the prick snaps the head back (rocked onto the hind paws, eyes shut), a hop
-- away `back` studs (nil = THORN_BACK), a rock as it lands; held there (p 1 = (0, 0, +back), upright)
POSES.DashThorns = function(f, p, _, _, backIn, feet)
	local back = math.max(0, backIn or PetPoses.THORN_BACK)
	local t = p * PetPoses.THORN_DUR
	if t < 0.12 then
		f.pitch = keys(t, { 0, -15, 0.05, 14, 0.12, 8 })
	elseif not hop(f, t, 0.12, 0.28, 0, back, BH.Thorn * hopK() * heavyOf(feet), 8, 6) then
		f.z = back
		f.pitch = keys(t, { 0.28, 6, 0.31, 9, 0.34, 0 })
	end
	local env = (t < 0.24) and sin(PI * t / 0.24) or 0
	f.raise = -15 * env -- wings clamp down, the tail tucks (the sting)
	f.lift = -30 * env
	f.haloTilt = 12 * env
	f.lids = (t >= 0.02 and t < 0.14) and 1 or 0
	f.still = 0.6 * env
	grounded(f)
end

-- (Pitch 2 item 5) ready on the spot between a flurry's bites (t = seconds): little hops, a rock with each, on the floor
-- and level at every multiple of READY_BOUNCE
POSES.DashReady = function(f, t)
	local b = PetPoses.READY_BOUNCE
	local s = sin(PI * t / b)
	f.y = BH.Ready * hopK() * math.abs(s)
	f.pitch = 1.5 * s
	f.lift = 10 * math.abs(s)
	f.still = 0.3
	grounded(f)
end

----------------------------------------------------------------------
-- Sample
----------------------------------------------------------------------
local function newFrame()
	return {
		x = 0, y = 0, z = 0, pitch = 0, yaw = 0, roll = 0,
		raise = 0, back = 0, lift = 0, sway = 0,
		haloY = 0, haloTilt = 0, haloSpin = 0, orbitSpin = 0,
		lids = 0, still = 0,
		paw = nil, -- (Pitch 2 item 5) nil = the old turn about the root; true = about the paw line on the floor (pawBody)
	}
end

-- (Pitch 2 item 5) a paw-line value from `feet` (finite, 0 .. 50 studs) or the typical pet's
local function footOf(feet, key)
	local v = type(feet) == "table" and tonumber(feet[key]) or nil
	if v == nil or v ~= v or v < 0 or v > 50 then
		return PetPoses.FEET[key]
	end
	return v
end

-- (Pitch 2 item 5) the body of a paw-pivoted frame: the turn about the paw line it rocks onto on the floor (hind paws for
-- nose up, front paws for nose down), about the root in the air, blended by its height; then lifted if a paw line would go
-- under the floor (the floor is Down under the root at rest)
local function pawBody(f, rot, feet)
	local down, front, hind = footOf(feet, "Down"), footOf(feet, "Front"), footOf(feet, "Hind")
	local paw = (f.pitch >= 0) and hind or front
	-- the blend height: at least BLEND_H, and never so low that the paw it left dips back under the floor while the body
	-- rises (a long body pitched far: its paw would stay on the floor and slide)
	local blend = math.max(BLEND_H, 1.25 * paw * math.abs(sin(rad(f.pitch))))
	local gw = 1 - clamp01(f.y / blend)
	local piv = Vector3.new(0, -down * gw, ((f.pitch >= 0) and hind or -front) * gw)
	local body = CFrame.new(f.x, f.y, f.z) * CFrame.new(piv) * rot * CFrame.new(-piv)
	local lo = math.min((body * Vector3.new(0, -down, hind)).Y, (body * Vector3.new(0, -down, -front)).Y) + down
	if lo < 0 then
		body = CFrame.new(0, -lo, 0) * body
	end
	return body
end

-- the frame of plain numbers of `name` at p (Sample's arguments checked; `feet` handed on: the melee motion's weight)
local function frameOf(name, p, ranged, amp, reach, feet)
	local fn = POSES[name]
	local f = newFrame()
	p = tonumber(p) or 0
	if p ~= p or p == math.huge or p == -math.huge then
		p = 0
	end
	if fn then
		if not PetPoses.Loops[name] then
			p = clamp01(p)
		end
		if name == "Hurt" then
			-- (Pitch 2 item 5, look review r2) the Hurt reads its own power (amp, under 1 for a Double strike's re-hit) and
			-- its re-hit's hits (reach: a table); it checks both itself
			fn(f, p, ranged == true, amp, reach, feet)
			return f
		end
		amp = tonumber(amp) or 1
		if amp ~= amp then
			amp = 1
		end
		reach = tonumber(reach)
		if reach ~= nil and (reach ~= reach or reach == math.huge or reach == -math.huge) then
			reach = nil
		elseif reach ~= nil then
			reach = math.max(0, math.min(PetPoses.LEAP_REACH_MAX, reach))
		end
		fn(f, p, ranged == true, math.max(1, math.min(PetPoses.LEAP_AMP_MAX, amp)), reach, feet)
	end
	return f
end

-- (Pitch 2 item 5) PetPoses.Offset(name, p, ranged, amp, reach, feet) -> Vector3: the pose's own move (studs, the pet's
-- frame) without its turn: where a paw-pivoted pose's paw lines have got to (the Body's position also carries the turn
-- about them). AttackFx starts a run caught on the way home from it. `feet` (optional): its Hop weighs the hops
function PetPoses.Offset(name, p, ranged, amp, reach, feet)
	local f = frameOf(name, p, ranged, amp, reach, feet)
	return Vector3.new(f.x, f.y, f.z)
end

-- Sample(name, p, ranged, amp, reach, feet): `feet` (Pitch 2 item 5, optional) = { Down, Front, Hind } pose studs from
-- the root to the floor / the front paw line (forward) / the hind paw line (back), and Hop (the body's weight: its hops
-- x Hop, an evolved form's 0.78); only the melee motion and the Hurt read it
function PetPoses.Sample(name, p, ranged, amp, reach, feet)
	local f = frameOf(name, p, ranged, amp, reach, feet)
	local raise, back = rad(f.raise), rad(f.back)
	local rot = CFrame.fromEulerAnglesYXZ(rad(f.pitch), rad(f.yaw), rad(f.roll))
	return {
		Body = f.paw and pawBody(f, rot, feet) or (CFrame.new(f.x, f.y, f.z) * rot),
		Groups = {
			wing = CFrame.Angles(0, back, -raise),
			cloud = CFrame.Angles(0, 0.3 * back, -0.3 * raise), -- Stormfang's cloud halves: a mild echo, they never spread
			tail = CFrame.Angles(-rad(f.lift), rad(f.sway), 0),
			bob = CFrame.new(0, f.haloY, 0) * CFrame.fromEulerAnglesYXZ(0, f.haloSpin, rad(f.haloTilt)),
			orbit = CFrame.Angles(0, f.orbitSpin, 0),
		},
		Lids = clamp01(f.lids),
		Still = clamp01(f.still),
	}
end

return PetPoses
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1063">
        <Properties>
          <string name="Name">PixelIcon</string>
          <string name="Source"><![CDATA[-- PixelIcon: the kit B icon set (U2 of .superpowers/slop-audit/round3/BUILD_PLAN.md, findings 5 and 7; decisions 2 and 3).
-- Every icon is a 9 x 9 one-colour bitmap kept as data: nine rows of nine cells, "#" drawn and "." empty, rows joined by
-- "/". The first 27 are the pitch's own (kit_pitch_mockups.html:523-550, the `I` table), ported as they are so the icons in
-- the game are the ones the owner saw; the rest are the ones the loading screen, menu, settings and credits need.
--   PixelIcon.Bitmaps[name]            the bitmap string
--   PixelIcon.Runs(name)               its merged rectangles { { x, y, w, h }, ... } in cells (nil for an unknown name)
--   PixelIcon.New(parent, name, px, colour)  a transparent px x px Frame (attribute PixelIcon = name) holding one Frame per
--                                      merged rectangle, snapped to whole pixels (cell = floor(px / 9), centred); nil for
--                                      an unknown name. px under 9 draws at 9; a px between multiples of 9 warns once
--                                      (PixelIcon.Warned). (U9-7 look) Under a UIScale the cells are whole screen px
--                                      (round(cell x scale), attribute CellPx), refitted when that scale changes
--   PixelIcon.Fit(icon)                (U9-7 look) fits an icon to the UIScales above it now (New and moves do it)
--   PixelIcon.Snap(px)                 the multiple of 9 nearest px (at least 9): the size an icon for a px glyph draws at
--   PixelIcon.Host(host, name, px[, colour])  (U7a) the icon centred in a text object, following its TextColor3 (unless
--                                      colour), TextTransparency and ZIndex (and with px nil its TextSize): an icon a
--                                      caller treats as a glyph
--   PixelIcon.Lead(label, name[, opts]) (U7a) the icon in front of a label's text ("<coin> 1,250"), the text inset past it;
--                                      opts.After / Count / Of: a rating after the text ("Easy" + 3 lit stars of 5); opts.Gap;
--                                      opts.Room (render gate): a left-aligned label keeps the trailing icons' room inside
--                                      its box (its text truncates first, the icons never leave the box).
--                                      Placed from TextBounds, or Theme.MeasureLabel when that reads 0 (a server: world signs)
--   PixelIcon.Clear(label[, opts])     (U7b) takes a Lead icon off again (a row whose mark comes and goes), insets back
--   PixelIcon.Mark(label, name|nil[, opts])  (U7b) Lead / Clear only when the mark changed: a status line set each refresh
--   PixelIcon.Set(host, name|nil[, px])      (U7b) Host only when the icon changed (the text emptied): a glyph label
-- Runs: each row's horizontal runs, then runs with the same columns in the rows below merged into one taller rectangle,
-- so an icon is a handful of Frames (smoke: at most 25).
-- (Pitch 2 item 9 B "Carved soft", spec docs/superpowers/specs/2026-11-20-pitch2-build-design.md) the redrawn icons in
-- their own colours: the spec's 16 (note, token, gem, pot, egg, bag, gift, box, ticket, potion, paw, book, house, stats,
-- gear, signpost), the 7 rarity dots (rarity_<rarity>) and the 8 element badges (Config.Elements.Info[*].Icon):
--   PixelIcon.Art[name]                { R = 10 rows of 10 (the 9 x 9 glyph + its 1-cell drop shadow), P = letter -> hex }
--                                      (the generated block below; tools/build_upload_sheets.py)
--   PixelIcon.Own                      the colour to pass for "its own colours": New(parent, name, px, PixelIcon.Own)
--                                      draws Art[name] (one Frame per merged run of one colour; the drop shadow Text at
--                                      30 %, attribute BaseT 0.7); a name with no Art draws white, as with no colour
--   Host / Lead / Mark / Set           a caller that gives no colour gets an Art icon in its own colours (it follows the
--                                      text's transparency and ZIndex, not its colour); a caller that gives a colour, and
--                                      every one-ink glyph, get the Bitmaps drawing in that one ink, as before
--   the art sizes (36 px and up: 2+ px cells on an 18 grid) of the 16 come from ONE uploaded sheet once
--                                      Config.IconSheet.Id is set (build/upload_sheets/icons_b.png, PixelIcon.SheetCells):
--                                      the icon Frame (attribute Sheet) holds one ImageLabel "Art" cut by ImageRectOffset /
--                                      ImageRectSize (19 x 19: the 18 x 18 art + its drop shadow), ResampleMode Pixelated,
--                                      19 cells of px / 18 on whole screen px. With no id (0, shipping) they draw the 9 x 9
--                                      glyph (54 px: 6 px cells): Review Focus 2, no image, no empty box
--   PixelIcon.Grey(icon, on)           the disabled state: the sheet's greyed row, or every colour of the 9 x 9 glyph to
--                                      its grey twin (the sheet's rule); off gives the colours back
-- Requires nothing at load (Shared, usable from ReplicatedFirst); Lead requires Theme (its sibling) on the first text it
-- must measure itself (U7b review: a server's TextBounds read 0), and an art-size Own icon reads Config (its sibling) for
-- the sheet's id when it draws (a loading screen before Config arrives draws the 9 x 9 glyph). Plain Lua 5.1-compatible
-- syntax only.

local PixelIcon = {}

PixelIcon.Bitmaps = {
	-- the pitch's icons (kit_pitch_mockups.html, exactly as drawn there)
	paw = "..##.##../..##.##../##.....##/##.###.##/..#####../.#######./.#######./..##.##../.........",
	book = "........./###...###/####.####/####.####/####.####/####.####/####.####/.###.###./.........",
	house = "....#..../...###.../..#####../.#######./#########/.#######./.##...##./.##...##./.##...##.",
	stats = "........./......##./......##./...##.##./...##.##./##.##.##./##.##.##./##.##.##./.........",
	bag = "...###.../..#...#../.#######./#########/#########/#########/#########/#########/.#######.",
	arrow = "........./....#..../....##.../#######../########./#######../....##.../....#..../.........",
	gear = "...###.../.#.###.#./.#######./###...###/###...###/###...###/.#######./.#.###.#./...###...",
	heart = "........./.##...##./####.####/#########/#########/.#######./..#####../...###.../....#....",
	bolt = ".....###./....###../...###.../..######./....###../...###.../..###..../.##....../.........",
	note = "........./........./#########/#.......#/#..###..#/#..###..#/#.......#/#########/.........", -- a banknote (cash)
	coin = "..#####../.#######./####.####/####.####/####.####/####.####/####.####/.#######./..#####..",
	gem = "........./.#######./#########/#########/.#######./..#####../...###.../....#..../.........",
	gift = ".##...##./#..#.#..#/.#######./#########/#########/.###.###./.###.###./.###.###./.###.###.",
	check = "........./........#/.......##/#.....##./##...##../.##.##.../..###..../...#...../.........",
	x = "........./.##...##./.###.###./..#####../...###.../..#####../.###.###./.##...##./.........",
	sword = "......###/.....####/....####./...####../#.####.../.####..../..##...../.#.##..../#...#....",
	star = "....#..../....#..../...###.../#########/.#######./..#####../..#####../.##...##./.#.....#.",
	-- (Pitch 2 items 9 B + 12_elements A) the three-tongue flame with a hollow core: the pitch's flame was a drop with a
	-- notch, so Water -> Flame read as drop -> drop
	flame = "....#..../.#..##.../.#..##.#./.##.####./#########/####.####/###...###/.##...##./..#####..",
	flake = "....#..../.#..#..#./..#.#.#../...###.../#########/...###.../..#.#.#../.#..#..#./....#....",
	moon = "...####../..###..../.###...../.###...../.###...../.###...../.####...#/..######./...####..",
	cloud = "........./...##..../..####.#./.#######./#########/#########/.#######./........./.........",
	apple = ".....##../....#..../.###.###./#########/#########/#########/#########/.#######./..##.##..",
	bell = "........./........./##.....##/##.....##/#########/##.....##/##.....##/........./.........",
	sprout = "........./###...###/####.####/.###.###./...###.../....#..../....#..../..#####../.#######.",
	plus = "...###.../...###.../...###.../#########/#########/#########/...###.../...###.../...###...",
	dash = "........./##..##.../.##..##../..##..##./...##..##/..##..##./.##..##../##..##.../.........",
	down = "........./........./##.....##/###...###/.###.###./..#####../...###.../....#..../.........",

	-- the screens' icons (U2): loading, menu, settings, credits
	play = ".#......./.###...../.#####.../.#######./.########/.#######./.#####.../.###...../.#.......",
	scroll = ".#######./#########/.#.....#./.#.###.#./.#.....#./.#.###.#./.#.....#./#########/.#######.",
	music = "...######/...######/...#....#/...#....#/...#....#/.###..###/####.####/####.####/.##...##.", -- a musical note
	speaker = "....#..../...##..#./..###...#/#####.#.#/#####.#.#/#####.#.#/..###...#/...##..#./....#....",
	monitor = "#########/#.......#/#.......#/#.......#/#.......#/#########/....#..../...###.../.#######.",
	shake = "#.#...#.#/...###.../#########/###...###/##..#..##/###...###/#########/........./#.#...#.#", -- camera shake
	mouse = "....#..../..#####../.##.#.##./.##.#.##./.#######./.#######./.#######./.#######./..#####..",
	bulb = "..#####../.#######./##..#####/##.######/.#######./..#####../........./..#####../...###...", -- a tip
	swap = "........./.....#.../########./.....#.../........./...#...../.########/...#...../.........",
	token = "..#####../.#######./####.####/###...###/##.....##/##.....##/#########/.#######./..#####..", -- the Cloud Token coin
	-- (U5) the settings scale's - (the pitch's plus without its upright)
	minus = "........./........./........./#########/#########/#########/........./........./.........",

	-- (U7a) the tiles' and the shop's icons the pitch did not draw (Config.Icons, NeonKit.Icon), in the pitch's style:
	-- solid shapes, a one-cell gap for every inner line
	pack = "..#####../.##...##./.#######./#########/##.....##/##.###.##/##.###.##/##.....##/.#######.", -- a backpack (Items)
	shield = ".#######./####.####/####.####/#.......#/####.####/.###.###./.###.###./..##.##../...###...", -- the Team
	trophy = "#########/#.#####.#/#.#####.#/.#######./..#####../...###.../....#..../..#####../.#######.", -- the Arena
	mountain = "...#...../..###..../..###.#../.#######./.########/#########/#########/#########/.........", -- the Obby (two peaks)
	key = "..####.../.##..##../.##..##../..####.../...##..../...####../...##..../...###.../...##....", -- the Dungeon
	crown = "........./#...#...#/##.###.##/#########/#########/#.#.#.#.#/#########/........./.........", -- the Ring, VIP
