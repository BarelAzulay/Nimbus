TycoonCatalog.Stations = STATIONS
local BY_ID = {}
local ORDER = {}
for i, def in ipairs(STATIONS) do
	def.Order = i
	def.Requires = def.Requires or {}
	def.LevelRequires = def.LevelRequires or {}
	BY_ID[def.Id] = def
	ORDER[i] = def.Id
end
TycoonCatalog.ById = BY_ID
TycoonCatalog.Order = ORDER
setmetatable(STATIONS, { __index = BY_ID }) -- Stations.Press1 works too (the array part stays the display order)

-- FeedShare by Food Machine level (the Kitchen's Effects, so the two never disagree)
do
	local share = {}
	for i, eff in ipairs(BY_ID.Kitchen.Effects) do
		share[i] = eff.FeedShare
	end
	TycoonCatalog.FeedShare = share
end

-- tier caps also live on the tiers: HouseTiers[i].Caps[stationId] = max level
for i, tier in ipairs(TIERS) do
	tier.Caps = {}
	for _, def in ipairs(STATIONS) do
		tier.Caps[def.Id] = def.TierCaps[tier.Id] or 0
	end
	tier.Order = i
end

-- The prestige pad (not a station: TycoonService handles it with its Prestige()). Get("Prestige") returns this.
local PRESTIGE_PAD = {
	Id = "Prestige", Name = "Prestige", Kind = "Prestige", Icon = ICON.Star, IsPrestige = true,
	Blurb = "Start over with +1 star: x1.25 coins forever, +1 garden place and Gems.",
	MaxLevel = 1, TierCaps = caps(0, 0, 0, 1), Requires = { House = "SkyCastle" },
	LevelRequires = {}, Price = { 0 }, Effects = { {} },
	Slot = { CFrame = at(-8, 18, 0), Footprint = V3(4, 1, 4), Walkable = true, Pad = padAt(-8, 12, -8, 18) },
}
TycoonCatalog.PrestigePad = PRESTIGE_PAD

----------------------------------------------------------------------
-- small helpers
----------------------------------------------------------------------
local function finite(v)
	return type(v) == "number" and v == v and v ~= huge and v ~= -huge
end

local function int(v)
	v = tonumber(v)
	if not v or v ~= v or v == huge or v == -huge then
		return nil
	end
	return floor(v)
end

local function stationsOf(home)
	local st = type(home) == "table" and home.Stations
	if type(st) == "table" then
		return st
	end
	return nil
end

-- current level of a station in a home (0 for junk; clamped to 0..MaxLevel)
local function levelOf(home, id)
	local def = BY_ID[id]
	local st = stationsOf(home)
	if not def or not st then
		return 0
	end
	local v = int(st[id])
	if not v or v < 0 then
		return 0
	end
	if v > def.MaxLevel then
		return def.MaxLevel
	end
	return v
end

local MAX_STARS = 1000 -- corrupt data guard: 1.25 ^ 1000 and 1.5 ^ 1000 are still finite numbers

local function sanitizeStars(v)
	v = int(v)
	if not v or v < 0 then
		return 0
	end
	return min(v, MAX_STARS)
end

local function starsOf(home)
	return sanitizeStars(type(home) == "table" and home.Prestige or nil)
end

-- tier index from an id ("Villa"), an index (2) or nil
local function tierIndexOf(value)
	if type(value) == "string" then
		return TIER_INDEX[value]
	end
	local n = int(value)
	if n and n >= 1 and n <= #TIERS then
		return n
	end
	return nil
end

local function commas(n)
	local s = tostring(floor(n))
	local neg = s:sub(1, 1) == "-"
	if neg then
		s = s:sub(2)
	end
	local out = s
	while true do
		local k
		out, k = out:gsub("^(%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return (neg and "-" or "") .. out
end

-- lazily resolved PetCatalog (pet ids / keys, roles, evolution stages); TycoonCatalog works without it (the sim and
-- the pure tests load it alone): then the local mirrors below are used
local petCatalog, petCatalogResolved = nil, false
local function getPetCatalog()
	if not petCatalogResolved then
		petCatalogResolved = true
		local module = Shared:FindFirstChild("PetCatalog")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				petCatalog = result
			end
		end
	end
	return petCatalog
end

-- mirrors of PetCatalog's Phase 5 data (used only when PetCatalog cannot be loaded; the smoke test pins them equal)
local MIRROR = {
	LevelBonus = 0.1,
	EvolutionBonus = { [0] = 1, [1] = 1.5, [2] = 1.875 }, -- multiplies the LEVEL BONUS (PetCatalog.EvolutionBonus)
	RoleMult = { Economy = 1.6, Combat = 1 },
	EvolveTwice = { Epic = true, Legendary = true, Mythic = true, Secret = true },
	MaxLevel = 100,
}
TycoonCatalog.Mirror = MIRROR -- READ-ONLY (tests compare it with PetCatalog)

local function rarityScaleOf(rarity)
	local ps = Config.PetStats
	local scales = type(ps) == "table" and ps.RarityScale
	local s = type(scales) == "table" and type(rarity) == "string" and tonumber(scales[rarity]) or nil
	if finite(s) and s > 0 then
		return s
	end
	return nil
end

local function tierMultiplier(tier)
	if finite(tier) and tier > 0 then
		return tier
	end
	return TycoonCatalog.TierMultiplier[tier] or 1
end

-- a PetDef from a pet id or key ("cat", "cat@Golden" -> def, "Golden"); hybrids ("hyb:...") need the profile -> nil
local function defOfKey(key)
	if type(key) ~= "string" or key == "" or key:sub(1, 4) == "hyb:" then
		return nil, nil
	end
	local petId, suffix = key:match("^([^@]+)@(%a+)$")
	petId = petId or key
	local pc = getPetCatalog()
	local def = pc and type(pc.Get) == "function" and pc.Get(petId) or nil
	if type(def) ~= "table" then
		return nil, nil
	end
	return def, suffix
end

-- RarityScale of a def / {Def} entry / rarity id / pet id / pet key, or nil
local function scaleOfSubject(subject)
	if type(subject) == "table" then
		if type(subject.Def) == "table" then
			subject = subject.Def
		end
		return rarityScaleOf(subject.Rarity)
	end
	if type(subject) == "string" then
		local s = rarityScaleOf(subject)
		if s then
			return s
		end
		local def = defOfKey(subject)
		return def and rarityScaleOf(def.Rarity) or nil
	end
	return nil
end

local function roleMultiplier(def)
	local pc = getPetCatalog()
	if pc and type(pc.RoleMultiplier) == "function" then
		local ok, m = pcall(pc.RoleMultiplier, def)
		if ok and finite(m) and m > 0 then
			return m
		end
	end
	local m = MIRROR.RoleMult[def.Role]
	return finite(m) and m or 1
end

-- the STORED evolution stage that counts (0..MaxEvolution of the rarity); the level alone never evolves a pet
local function evolutionStage(def, level, stage)
	if stage == nil then
		return 0
	end
	local pc = getPetCatalog()
	if pc and type(pc.EvolutionStage) == "function" then
		local ok, s = pcall(pc.EvolutionStage, def, level, stage)
		if ok and finite(s) and s >= 0 then
			return floor(s)
		end
		return 0
	end
	local s = int(stage)
	if not s or s < 1 then
		return 0
	end
	return min(s, MIRROR.EvolveTwice[def.Rarity] and 2 or 1)
end

-- PetCatalog.LevelFactor(level, stage) = 1 + LevelBonus x (level - 1) x EvolutionBonus[stage] (or the mirror)
local function levelFactor(level, stage)
	local pc = getPetCatalog()
	if pc and type(pc.LevelFactor) == "function" then
		local ok, f = pcall(pc.LevelFactor, level, stage)
		if ok and finite(f) and f > 0 then
			return f
		end
	end
	local lv = max(1, min(int(level) or 1, MIRROR.MaxLevel))
	return 1 + MIRROR.LevelBonus * (lv - 1) * (MIRROR.EvolutionBonus[stage] or 1)
end

----------------------------------------------------------------------
-- basic lookups
----------------------------------------------------------------------
function TycoonCatalog.Get(id)
	if id == "Prestige" then
		return PRESTIGE_PAD
	end
	return BY_ID[id]
end

function TycoonCatalog.PriceFor(id, level)
	local def = TycoonCatalog.Get(id)
	local lv = int(level)
	if not def or not lv or lv < 1 or lv > def.MaxLevel then
		return nil
	end
	return def.Price[lv]
end

-- (1 + PriceStep) ^ stars; 1 for a LegacyPrices home (a Phase 3 veteran's run). home may be a star count.
function TycoonCatalog.StarPriceMultiplier(home)
	local stars
	if type(home) == "table" then
		if home.LegacyPrices == true then
			return 1
		end
		stars = starsOf(home)
	else
		stars = sanitizeStars(home)
	end
	local step = tonumber(TycoonCatalog.Prestige.PriceStep) or 0
	return (1 + step) ^ stars
end

-- the price this home pays for `level` of `id` (whole Cash), nil when there is no such level
function TycoonCatalog.PriceAt(id, level, home)
	local base = TycoonCatalog.PriceFor(id, level)
	if base == nil then
		return nil
	end
	return floor(base * TycoonCatalog.StarPriceMultiplier(home) + 1e-9)
end

function TycoonCatalog.EffectsOf(id, level)
	local def = BY_ID[id]
	local lv = int(level)
	if not def or not lv or lv < 1 then
		return nil
	end
	return def.Effects[min(lv, def.MaxLevel)]
end

function TycoonCatalog.StationLevel(home, id)
	return levelOf(home, id)
end

-- the old Coin Magnet level a folded home keeps until its next Prestige (0 once the stars moved on)
function TycoonCatalog.LegacyMagnetLevel(home)
	if type(home) ~= "table" then
		return 0
	end
	local lv = int(home.LegacyMagnet)
	if not lv or lv < 1 then
		return 0
	end
	if sanitizeStars(home.LegacyMagnetStar) ~= starsOf(home) or int(home.LegacyMagnetStar) == nil then
		return 0
	end
	return min(lv, TycoonCatalog.LegacyMagnet.MaxLevel)
end

local MAX_DECOR_CREDIT = 18 -- Home.DecorCredit 0..18 (the old decor levels that did not fit, 9.1)

local function decorCreditOf(home)
	local c = int(type(home) == "table" and home.DecorCredit or nil)
	if not c or c < 0 then
		return 0
	end
	return min(c, MAX_DECOR_CREDIT)
end

-- sum of every station level + the folded credits (DecorCredit, the legacy magnet while its star holds)
function TycoonCatalog.HomeLevelOf(home)
	local total = 0
	for _, def in ipairs(STATIONS) do
		total = total + levelOf(home, def.Id)
	end
	return total + decorCreditOf(home) + TycoonCatalog.LegacyMagnetLevel(home)
end

-- house tier index (1 = Cottage .. 4 = Sky Castle) and its def; a home without a House is a Cottage
function TycoonCatalog.HouseTierOf(home)
	local i = max(1, levelOf(home, "House"))
	return i, TIERS[i]
end

function TycoonCatalog.HouseTier(idOrIndex)
	local i = tierIndexOf(idOrIndex)
	return i and TIERS[i] or nil
end

-- the max level the current house tier allows for a station
function TycoonCatalog.MaxLevelAt(id, home)
	local def = BY_ID[id]
	if not def then
		return 0
	end
	local tier = TycoonCatalog.HouseTierOf(home)
	return def.TierCaps[TIERS[tier].Id] or 0
end

-- first tier whose cap allows `level` (nil if none)
local function tierAllowing(def, level)
	for i, tier in ipairs(TIERS) do
		if (def.TierCaps[tier.Id] or 0) >= level then
			return i
		end
	end
	return nil
end

-- the coin multiplier of a star count: 1.25 ^ stars
function TycoonCatalog.PrestigeMultiplier(stars)
	return TycoonCatalog.Prestige.IncomeMultiplier ^ sanitizeStars(stars)
end

-- Gems for reaching `newStars` (1 = the first prestige)
function TycoonCatalog.PrestigeGems(newStars)
	local p = TycoonCatalog.Prestige
	local n = max(1, sanitizeStars(newStars))
	return max(p.GemRewardMin, p.GemReward - p.GemRewardStep * (n - 1))
end

----------------------------------------------------------------------
-- requirements, lock reasons and pads
----------------------------------------------------------------------
local function treeMet(def, home)
	for key, need in pairs(def.Requires) do
		if BY_ID[key] and key ~= "House" then
			if levelOf(home, key) < (int(need) or 0) then
				return false
			end
		end
	end
	return true
end

-- why `nextLevel` of `def` cannot be bought yet (nil = it can, given the cash)
local function lockReason(def, nextLevel, home, homeLevel, tier, stars)
	if def.ComingSoon then
		return "Coming soon"
	end
	local req = def.Requires
	local needStars = int(req.Prestige)
	if needStars and stars < needStars then
		return "Unlocks at Prestige " .. needStars
	end
	local needTier = req.House ~= nil and tierIndexOf(req.House) or nil
	if needTier and tier < needTier then
		return "Needs the " .. TIERS[needTier].Name
	end
	local needHL = int(req.HomeLevel)
	local lr = def.LevelRequires[nextLevel]
	if type(lr) == "table" and int(lr.HomeLevel) and (not needHL or int(lr.HomeLevel) > needHL) then
		needHL = int(lr.HomeLevel)
	end
	if needHL and homeLevel < needHL then
		return "Reach Home Level " .. needHL
	end
	local cap = def.TierCaps[TIERS[tier].Id] or 0
	if nextLevel > cap then
		local t = tierAllowing(def, nextLevel)
		if t then
			return "Needs the " .. TIERS[t].Name
		end
		return "Maxed"
	end
	return nil
end

function TycoonCatalog.PadLevelText(currentLevel, nextLevel)
	local cur = int(currentLevel) or 0
	if cur <= 0 then
		return "Build"
	end
	return "Lv " .. cur .. " -> " .. (int(nextLevel) or (cur + 1))
end

-- ok, reason: can this home prestige right now?
function TycoonCatalog.CanPrestige(home)
	local p = TycoonCatalog.Prestige
	local tier = TycoonCatalog.HouseTierOf(home)
	local need = tierIndexOf(p.House) or #TIERS
	if tier < need or levelOf(home, "House") < need then
		return false, "Needs the " .. TIERS[need].Name
	end
	if TycoonCatalog.HomeLevelOf(home) < p.HomeLevel then
		return false, "Reach Home Level " .. p.HomeLevel
	end
	return true, nil
end

function TycoonCatalog.AvailablePads(home)
	local pads = {}
	local homeLevel = TycoonCatalog.HomeLevelOf(home)
	local tier = TycoonCatalog.HouseTierOf(home)
	local stars = starsOf(home)
	local priceMult = TycoonCatalog.StarPriceMultiplier(type(home) == "table" and home or 0)
	for _, def in ipairs(STATIONS) do
		local level = levelOf(home, def.Id)
		if level < def.MaxLevel and treeMet(def, home) then
			local nextLevel = level + 1
			local title = def.Name
			if def.Kind == "House" then
				title = (TIERS[nextLevel] and TIERS[nextLevel].Name) or def.Name
			end
			local base = def.Price[nextLevel]
			pads[#pads + 1] = {
				StationId = def.Id,
				NextLevel = nextLevel,
				Price = floor(base * priceMult + 1e-9),
				BasePrice = base,
				Locked = lockReason(def, nextLevel, home, homeLevel, tier, stars),
				Level = level,
				MaxLevel = def.MaxLevel,
				Name = def.Name,
				Title = title,
				Kind = def.Kind,
				Icon = def.Icon,
				LevelText = TycoonCatalog.PadLevelText(level, nextLevel),
			}
		end
	end
	local castle = tierIndexOf(TycoonCatalog.Prestige.House) or #TIERS
	if levelOf(home, "House") >= castle then
		local ok, reason = TycoonCatalog.CanPrestige(home)
		pads[#pads + 1] = {
			StationId = PRESTIGE_PAD.Id,
			NextLevel = stars + 1,
			Price = 0,
			BasePrice = 0,
			Locked = (not ok) and reason or nil,
			Level = stars,
			MaxLevel = stars + 1,
			Name = PRESTIGE_PAD.Name,
			Title = "Prestige " .. (stars + 1),
			Kind = PRESTIGE_PAD.Kind,
			Icon = PRESTIGE_PAD.Icon,
			LevelText = stars .. " -> " .. (stars + 1) .. " " .. ICON.Star,
			Prestige = true,
		}
	end
	return pads
end

-- Server-side purchase check: ok, price | nil, reason. The price is the home's star price (PriceAt).
-- (TycoonService still re-checks the Cash atomically.)
function TycoonCatalog.CheckPurchase(home, stationId)
	if type(stationId) ~= "string" or not BY_ID[stationId] then
		return false, nil, "Unknown station"
	end
	for _, pad in ipairs(TycoonCatalog.AvailablePads(home)) do
		if pad.StationId == stationId then
			if pad.Locked then
				return false, pad.Price, pad.Locked
			end
			return true, pad.Price, nil
		end
	end
	local def = BY_ID[stationId]
	if levelOf(home, stationId) >= def.MaxLevel then
		return false, nil, "Maxed"
	end
	return false, nil, "Not unlocked yet"
end

-- The Stations table after a prestige: decor (KeepOnPrestige) stays, a station with a ResetLevel (the Garden) is set
-- to it (so the coins never stop), everything else resets.
function TycoonCatalog.StationsAfterPrestige(stations)
	local out = {}
	if type(stations) == "table" then
		for id, level in pairs(stations) do
			local def = BY_ID[id]
			local lv = int(level)
			if def and def.KeepOnPrestige and lv and lv > 0 then
				out[id] = min(lv, def.MaxLevel)
			end
		end
	end
	for _, def in ipairs(STATIONS) do
		local reset = int(def.ResetLevel)
		if reset and reset > 0 and not def.KeepOnPrestige then
			out[def.Id] = min(reset, def.MaxLevel)
		end
	end
	return out
end

----------------------------------------------------------------------
-- Cloud Cash: food, pet power, garden places, income, piles, scoop radius, offline earnings
----------------------------------------------------------------------
-- the Food of every meal: 0 without a Garden, else GrassFood + the Berry Farm's Effects.Food
function TycoonCatalog.FoodOf(home)
	if levelOf(home, "Garden") < 1 then
		return 0
	end
	local total = TycoonCatalog.Coins.GrassFood
	for _, def in ipairs(STATIONS) do
		if def.Kind == "Farm" then
			local lv = levelOf(home, def.Id)
			if lv > 0 then
				total = total + (def.Effects[lv].Food or 0)
			end
		end
	end
	return total
end

-- the coin power of one garden entry (any of the shapes listed in the header); prestige NOT applied
function TycoonCatalog.PetPower(entry, level, tier, stage)
	if type(entry) == "number" then
		if finite(entry) and entry > 0 then
			return entry
		end
		return 0
	end
	local def = entry
	if type(entry) == "string" then
		local suffix
		def, suffix = defOfKey(entry)
		if not def then
			return 0
		end
		if tier == nil then
			tier = suffix
		end
	end
	if type(def) ~= "table" then
		return 0
	end
	if type(def.Def) == "table" then
		if level == nil then
			level = def.Level
		end
		if tier == nil then
			tier = def.Tier
		end
		if stage == nil then
			stage = def.Stage
			if stage == nil then
				stage = def.Evo
			end
		end
		def = def.Def
	elseif def.Rarity == nil and def.Power ~= nil then
		local v = tonumber(def.Power)
		if finite(v) and v > 0 then
			return v
		end
		return 0
	end
	local scale = rarityScaleOf(def.Rarity)
	if not scale then
		return 0
	end
	local top = TycoonCatalog.PetXp.MaxLevel
	local lv = int(level)
	if lv == nil then
		lv = int(def.Level) or 1
	end
	lv = max(1, min(lv, top))
	local mult = tier
	if mult == nil then
		mult = def.StatMultiplier or def.Tier or (type(def.Look) == "table" and def.Look.Finish) or nil
	end
	if stage == nil then
		stage = def.Stage
	end
	local power = scale * levelFactor(lv, evolutionStage(def, lv, stage)) * tierMultiplier(mult) * roleMultiplier(def)
	if not finite(power) or power < 0 then
		return 0
	end
	return power
end

-- the open garden places: 0 without a Garden, else min(Max, max(Base + PerStar x stars, LegacySlots))
function TycoonCatalog.GardenSlots(home)
	if levelOf(home, "Garden") < 1 then
		return 0
	end
	local p = TycoonCatalog.Prestige
	local open = p.GardenSlotsBase + p.GardenSlotsPerStar * starsOf(home)
	local legacy = int(type(home) == "table" and home.LegacySlots or nil)
	if legacy and legacy > open then
		open = legacy
	end
	return max(0, min(p.GardenSlotsMax, open))
end

function TycoonCatalog.LuckyChance(home)
	local lv = levelOf(home, "Garden")
	if lv < 1 then
		return 0
	end
	local c = tonumber(BY_ID.Garden.Effects[lv].Lucky) or 0
	return max(0, min(1, c))
end

-- the Lucky expected value: one coin is worth this many plain coins on average
function TycoonCatalog.LuckyEV(home)
	return 1 + (TycoonCatalog.Coins.LuckyMult - 1) * TycoonCatalog.LuckyChance(home)
end

-- the sum of PetPower over the open places (entries[1 .. open]; the rest rest)
local function gardenPower(entries, open)
	local total = 0
	if type(entries) ~= "table" then
		return 0
	end
	for slot = 1, open do
		local e = entries[slot]
		if e ~= nil then
			total = total + TycoonCatalog.PetPower(e)
		end
	end
	return total
end

function TycoonCatalog.IncomePerSecond(home, entries, prestige)
	local stars = prestige
	if stars == nil then
		stars = starsOf(home)
	end
	local mult = TycoonCatalog.PrestigeMultiplier(stars)
	local food = TycoonCatalog.FoodOf(home)
	local pets = gardenPower(entries, TycoonCatalog.GardenSlots(home))
	local lucky = TycoonCatalog.LuckyEV(home)
	local total = food / TycoonCatalog.Coins.MealSeconds * pets * lucky * mult
	if not finite(total) or total < 0 then
		total = 0
	end
	return total, { Food = food, Pets = pets, Lucky = lucky, Multiplier = mult }
end

-- one plain (not Lucky) coin of a pet with `power`: Food x power x 1.25 ^ stars
function TycoonCatalog.CoinValue(home, power, prestige)
	local stars = prestige
	if stars == nil then
		stars = starsOf(home)
	end
	local p = tonumber(power)
	if not finite(p) or p <= 0 then
		return 0
	end
	local v = TycoonCatalog.FoodOf(home) * p * TycoonCatalog.PrestigeMultiplier(stars)
	return finite(v) and v or 0
end

-- the old Coin Magnet's effect of a folded home (nil without one / after the next Prestige)
local function legacyMagnetEffect(home, key)
	local lv = TycoonCatalog.LegacyMagnetLevel(home)
	if lv < 1 then
		return nil
	end
	return TycoonCatalog.LegacyMagnet[key][lv]
end

-- max(Garden Radius, LegacyMagnet radius); Coins.BaseRadius without a Garden
function TycoonCatalog.ScoopRadius(home)
	local lv = levelOf(home, "Garden")
	local r = TycoonCatalog.Coins.BaseRadius
	if lv >= 1 then
		r = BY_ID.Garden.Effects[lv].Radius
	end
	local legacy = legacyMagnetEffect(home, "Radius")
	if legacy and legacy > r then
		r = legacy
	end
	return r
end

-- max(Garden PileSeconds, LegacyMagnet pile) + Vault PileSeconds: a slot's lawn holds this many seconds of its coins
function TycoonCatalog.PileSeconds(home)
	local lv = levelOf(home, "Garden")
	local s = TycoonCatalog.Coins.BasePileSeconds
	if lv >= 1 then
		s = BY_ID.Garden.Effects[lv].PileSeconds
	end
	local legacy = legacyMagnetEffect(home, "PileSeconds")
	if legacy and legacy > s then
		s = legacy
	end
	local vault = levelOf(home, "Vault")
	if vault >= 1 then
		s = s + (BY_ID.Vault.Effects[vault].PileSeconds or 0)
	end
	return s
end

function TycoonCatalog.OfflineEarnings(home, seconds, incomePerSecond)
	local vault = levelOf(home, "Vault")
	local s = tonumber(seconds)
	local income = tonumber(incomePerSecond)
	if vault < 1 or not s or s ~= s or not income or income ~= income or income <= 0 or income == huge then
		return 0, { Seconds = 0, Percent = 0, MaxHours = 0 }
	end
	local ve = BY_ID.Vault.Effects[vault]
	local info = { Seconds = 0, Percent = ve.OfflinePercent, MaxHours = ve.OfflineHours }
	if s < TycoonCatalog.OfflineMinSeconds then
		return 0, info
	end
	local counted = min(s, ve.OfflineHours * 3600)
	info.Seconds = counted
	return floor(income * counted * ve.OfflinePercent), info
end

----------------------------------------------------------------------
-- the Food Machine, the Training Place, food, fusion, XP
----------------------------------------------------------------------
function TycoonCatalog.XpToNext(level)
	local px = TycoonCatalog.PetXp
	local lv = int(level)
	if not lv or lv < 1 then
		lv = 1
	end
	if lv >= px.MaxLevel then
		return huge
	end
	local raw = px.Base * lv ^ px.Exponent
	return max(px.Round, floor(raw / px.Round + 0.5) * px.Round)
end

-- total XP from level 1 to `level`
function TycoonCatalog.XpForLevel(level)
	local lv = int(level) or 1
	local total = 0
	for l = 1, min(lv, TycoonCatalog.PetXp.MaxLevel) - 1 do
		total = total + TycoonCatalog.XpToNext(l)
	end
	return total
end

-- XP of one machine feed for a pet at `level` (0 at the top level or without a machine)
function TycoonCatalog.FeedXp(level, machineLevel)
	local ml = int(machineLevel)
	if not ml or ml < 1 then
		return 0
	end
	ml = min(ml, #TycoonCatalog.FeedShare)
	local need = TycoonCatalog.XpToNext(level)
	if need == huge then
		return 0
	end
	return max(1, floor(need * TycoonCatalog.FeedShare[ml] + 0.5))
end

-- Cash of one machine feed for a pet (def / rarity / pet id / key) at `level`; nil at the top level or for junk
function TycoonCatalog.FeedPrice(def, level)
	local scale = scaleOfSubject(def)
	local need = TycoonCatalog.XpToNext(level)
	if not scale or need == huge then
		return nil
	end
	return floor(need * scale * TycoonCatalog.FeedBase + 0.5)
end

-- Cash for rank `rank` (1..MaxRank) of any skill for a pet (def / rarity / pet id / key); nil for junk
function TycoonCatalog.TrainCost(def, rank)
	local tr = TycoonCatalog.Training
	local r = int(rank)
	local scale = scaleOfSubject(def)
	if not r or r ~= tonumber(rank) or r < 1 or r > tr.MaxRank or not scale then
		return nil
	end
	return floor(tr.CostBase * r * r * scale + 0.5)
end

-- seconds rank `rank` (1..MaxRank) takes; nil for junk
function TycoonCatalog.TrainSeconds(rank)
	local tr = TycoonCatalog.Training
	local r = int(rank)
	if not r or r ~= tonumber(rank) or r < 1 or r > tr.MaxRank then
		return nil
	end
	return r * tr.MinutesPerRank * 60
end

-- pets training at once (the Training Place level's Slots; 0 while it is not built)
function TycoonCatalog.TrainingSlots(home)
	local lv = levelOf(home, "Gym")
	if lv < 1 then
		return 0
	end
	return BY_ID.Gym.Effects[lv].Slots
end

----------------------------------------------------------------------
-- Berries (Phase 5 3.4)
----------------------------------------------------------------------
-- the Berry Basket: max(BasketMin, floor(incomePerSecond x Share x 60 x BasketMinutes)) whole berries (30 minutes of
-- the berries the garden grows); junk income counts as 0. `home` is accepted for symmetry (the cap needs no station).
function TycoonCatalog.BasketCap(home, incomePerSecond)
	local B = TycoonCatalog.Berries
	local ips = tonumber(incomePerSecond)
	if not finite(ips) or ips < 0 then
		ips = 0
	end
	local cap = floor(ips * B.Share * 60 * B.BasketMinutes + 1e-9)
	if not finite(cap) or cap > 1e15 then
		cap = 1e15
	end
	return max(B.BasketMin, cap)
end

-- berries of one Food Machine feed for a pet (def / rarity / pet id / key) at `level`: round(XpToNext(level) x
-- RarityScale x FeedBase), the Phase 4 FeedPrice; nil at the top level or for junk
function TycoonCatalog.FeedBerries(def, level)
	return TycoonCatalog.FeedPrice(def, level)
end

----------------------------------------------------------------------
-- Pad signs (Phase 5 3.3): SignedPads(pads, cash, maxSigns) -> { [stationId] = true }
----------------------------------------------------------------------
function TycoonCatalog.SignedPads(pads, cash, maxSigns)
	local out = {}
	if type(pads) ~= "table" then
		return out
	end
	local money = tonumber(cash)
	if not finite(money) then
		money = 0
	end
	local limit = int(maxSigns) or TycoonCatalog.SignRules.MaxSigns
	if limit < 0 then
		limit = 0
	end
	-- open (not Locked) station pads in pad order; the cheapest first, ties by pad order (deterministic)
	local open = {}
	for i, pad in ipairs(pads) do
		if type(pad) == "table" and type(pad.StationId) == "string" and not pad.Locked then
			if pad.Prestige or pad.StationId == PRESTIGE_PAD.Id then
				out[pad.StationId] = true
			else
				local price = tonumber(pad.Price)
				if finite(price) then
					open[#open + 1] = { Id = pad.StationId, Price = price, Index = i }
				end
			end
		end
	end
	table.sort(open, function(a, b)
		if a.Price ~= b.Price then
			return a.Price < b.Price
		end
		return a.Index < b.Index
	end)
	local signed = 0
	for _, item in ipairs(open) do
		if signed >= limit then
			break
		end
		if item.Price <= money then
			out[item.Id] = true
			signed = signed + 1
		end
	end
	if signed == 0 and open[1] then
		out[open[1].Id] = true
	end
	return out
end

----------------------------------------------------------------------
-- The one-time Phase 5 fold (9.2 step 3): FoldLegacy(home, firstTime) -> changed (pure; mutates `home`)
----------------------------------------------------------------------
-- a station level as a whole number in 0..top (junk -> 0)
local function clampLevel(v, top)
	local n = int(v)
	if not n or n < 0 then
		return 0
	end
	return min(n, top)
end

-- the food the four Phase 4 plants gave at these levels (FoldLegacy's food floor)
local function legacyPlantFood(levels)
	local total = 0
	for _, id in ipairs({ "Press1", "Press2", "Press3", "Press4" }) do
		local lv = levels[id] or 0
		local table_ = TycoonCatalog.LegacyPlants[id]
		if lv >= 1 and table_[lv] then
			total = total + table_[lv]
		end
	end
	return total
end

-- the smallest Berry Farm level whose Food reaches `food` (MaxLevel when none does)
local function farmLevelForFood(food)
	local def = BY_ID.Press1
	for lv = 1, def.MaxLevel do
		if (def.Effects[lv].Food or 0) >= food then
			return lv
		end
	end
	return def.MaxLevel
end

local function present(v)
	return v ~= nil and v ~= false
end

-- (a) Farm: sum = Press1..Press4 (Press2-4 clamped 0..10; Press1 0..10 on the first fold, 0..40 after it: a folded
-- farm keeps its level when a Phase 4 server sold a Carrot Patch meanwhile); if any of Press2-4 is present or
-- firstTime: Press1 = min(40, max(sum, the smallest L whose Food >= the old plant food (firstTime only))), Press2-4
-- removed. (b) Magnet: Collector > 0 -> LegacyMagnet = max(the live LegacyMagnet, Collector) clamped 1..5,
-- LegacyMagnetStar = Prestige; Collector removed. (c) Decor: Fence = max(Fence, Flowers, Banners), Fountain =
-- max(Fountain, Lamps), DecorCredit += the levels that did not fit (at most 18), the three keys removed. Returns true
-- when the home changed. No Cash, Gems or berries (the Food -> berries step is DataService's).
function TycoonCatalog.FoldLegacy(home, firstTime)
	if type(home) ~= "table" then
		return false
	end
	local st = home.Stations
	if type(st) ~= "table" then
		return false
	end
	local changed = false
	local legacyTop = 10
	local farmDef = BY_ID.Press1
	-- (a) the Berry Farm
	local anyOld = false
	for _, id in ipairs(LEGACY_PLANTS) do
		if present(st[id]) then
			anyOld = true
		end
	end
	if anyOld or firstTime then
		local levels = { Press1 = clampLevel(st.Press1, firstTime and legacyTop or farmDef.MaxLevel) }
		local sum = levels.Press1
		for _, id in ipairs(LEGACY_PLANTS) do
			levels[id] = clampLevel(st[id], legacyTop)
			sum = sum + levels[id]
			if st[id] ~= nil then
				st[id] = nil
				changed = true
			end
		end
		local level = sum
		if firstTime then
			local food = legacyPlantFood(levels)
			if food > 0 then
				level = max(level, farmLevelForFood(food))
			end
		end
		level = min(farmDef.MaxLevel, level)
		local old = st.Press1
		if level > 0 then
			if old ~= level then
				st.Press1 = level
				changed = true
			end
		elseif old ~= nil and int(old) ~= nil and int(old) <= 0 then
			st.Press1 = nil
			changed = true
		end
	end
	-- (b) the Coin Magnet -> the legacy magnet (counts + keeps its radius until the next Prestige)
	if st.Collector ~= nil then
		local lv = clampLevel(st.Collector, TycoonCatalog.LegacyMagnet.MaxLevel)
		st.Collector = nil
		changed = true
		if lv > 0 then
			local live = TycoonCatalog.LegacyMagnetLevel(home)
			home.LegacyMagnet = max(live, lv)
			home.LegacyMagnetStar = starsOf(home)
		end
	end
	-- (c) the old decor -> the Yard Fence / the Fountain + DecorCredit
	local credit = decorCreditOf(home)
	local creditBefore = credit
	for _, pair in ipairs({ { "DecorFence", LEGACY_DECOR.DecorFence }, { "DecorFountain", LEGACY_DECOR.DecorFountain } }) do
		local target, sources = pair[1], pair[2]
		local any = false
		for _, id in ipairs(sources) do
			if st[id] ~= nil then
				any = true
			end
		end
		if any then
			local top = BY_ID[target].MaxLevel
			local best = clampLevel(st[target], top)
			local total = best
			for _, id in ipairs(sources) do
				local lv = clampLevel(st[id], 3)
				total = total + lv
				if lv > best then
					best = lv
				end
				st[id] = nil
			end
			changed = true
			credit = credit + (total - best)
			if best > 0 then
				st[target] = best
			end
		end
	end
	if credit ~= creditBefore then
		home.DecorCredit = min(credit, MAX_DECOR_CREDIT)
	end
	return changed
end

-- cost table ({Tokens = n} or {Gems = n}) of a fusion, or nil.
--   FusionCost("Upgrade", rarity, "Golden" | "Rainbow", fusionLevel?)   (target tier)
--   FusionCost("Mix", rarity, nil, fusionLevel?)                         (the higher rarity of both inputs)
-- The Fusion Machine's TokenDiscount (by level) lowers Token prices; Gem prices never change.
function TycoonCatalog.FusionCost(action, rarity, tier, fusionLevel)
	local F = TycoonCatalog.Fusion
	local base
	if action == "Upgrade" then
		local row = F.Upgrade[rarity]
		base = row and row[tier or "Golden"]
	elseif action == "Mix" then
		base = F.Mix[rarity]
	end
	if type(base) ~= "table" then
		return nil
	end
	local discount = 0
	local lv = int(fusionLevel)
	if lv and lv >= 1 then
		local eff = BY_ID.FusionMachine.Effects[min(lv, BY_ID.FusionMachine.MaxLevel)]
		discount = eff.TokenDiscount or 0
	end
	local out = {}
	for k, v in pairs(base) do
		if k == "Tokens" then
			out[k] = floor(v * (1 - discount) + 0.5)
		else
			out[k] = v
		end
	end
	return out
end

-- "$950", "$12.5K", "$3.2M"
function TycoonCatalog.FormatCash(n)
	local v = tonumber(n) or 0
	if v ~= v then
		v = 0
	end
	local a = math.abs(v)
	local sign = v < 0 and "-" or ""
	if a < 10000 then
		return sign .. "$" .. commas(a)
	end
	local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	for _, u in ipairs(units) do
		if a >= u[1] then
			local x = a / u[1]
			local s
			if x >= 100 then
				s = string.format("%d", floor(x))
			else
				s = string.format("%.1f", floor(x * 10) / 10)
				s = s:gsub("%.0$", "")
			end
			return sign .. "$" .. s .. u[2]
		end
	end
	return sign .. "$" .. commas(a)
end

----------------------------------------------------------------------
-- Validate (data self-check): ok, { problem... }
----------------------------------------------------------------------
-- world-aligned rectangle {x0, x1, z0, z1} of a slot footprint (yaw in 90 degree steps)
local function footprintRect(cf, size)
	local look = cf.LookVector
	local alongX = math.abs(look.X) > 0.7 -- the front faces +-X: the width runs along Z
	local w, d = size.X, size.Z
	local sx, sz = w, d
	if alongX then
		sx, sz = d, w
	end
	local p = cf.Position
	return { p.X - sx / 2, p.X + sx / 2, p.Z - sz / 2, p.Z + sz / 2 }
end
TycoonCatalog.FootprintRect = footprintRect

local function padRect(cf)
	local s = TycoonCatalog.Layout.PadSize
	local p = cf.Position
	return { p.X - s.X / 2, p.X + s.X / 2, p.Z - s.Z / 2, p.Z + s.Z / 2 }
end
TycoonCatalog.PadRect = padRect

-- plot-local rectangle {x0, x1, z0, z1} of a rectangle given in a station frame (centre + size, e.g. a garden walk)
local function localRect(slotCFrame, center, size)
	return footprintRect(slotCFrame * CFrame.new(center.X, center.Y, center.Z), size)
end
TycoonCatalog.LocalRect = localRect

local function overlap(a, b, gap)
	gap = gap or 0
	return a[1] < b[2] + gap and b[1] < a[2] + gap and a[3] < b[4] + gap and b[3] < a[4] + gap
end

local function inside(rect, x, z, pad)
	pad = pad or 0
	return x >= rect[1] - pad and x <= rect[2] + pad and z >= rect[3] - pad and z <= rect[4] + pad
end

-- a walk-through zone (true) vs a solid station (the Garden's Walkable is a list of walks INSIDE its solid footprint)
local function walkThrough(slot)
	return slot.Walkable == true or slot.Perimeter == true
end

----------------------------------------------------------------------
-- The roaming layout (Phase 5 3.5): what HomeRoam builds its walk graph from (plot-local rects; pure, a fresh table)
----------------------------------------------------------------------
TycoonCatalog.Roam = {
	Half = 33, -- the walkable square |x|, |z| <= Half
	Cell = 2, -- studs per grid cell
	StationPad = 1, -- clearance around every station footprint
	PadPad = 0.5, -- clearance around every buy pad
	FencePad = 0.6, -- clearance around the garden fence and the bowl
	BedPad = 0.3, -- clearance around the beds
	EatRing = 5, -- the eat points: the bowl centre + EatRing studs at (slot - 1) x 30 degrees
}

local function rectOf(r, pad)
	return { r[1], r[3], r[2], r[4], pad = pad } -- {x0, x1, z0, z1} -> {x0, z0, x1, z1}
end

function TycoonCatalog.RoamLayout()
	local R = TycoonCatalog.Roam
	local blocked = {}
	-- every station footprint, built or not (the graph never depends on what is built); walk-through decor and the
	-- yard fence decor (Perimeter) are not obstacles; the Garden is its fence + bowl + beds below
	for _, def in ipairs(STATIONS) do
		local slot = def.Slot
		if def.Id ~= "Garden" and not walkThrough(slot) then
			blocked[#blocked + 1] = rectOf(footprintRect(slot.CFrame, slot.Footprint), R.StationPad)
		end
	end
	-- every buy pad (the Prestige pad too)
	for _, def in ipairs(STATIONS) do
		blocked[#blocked + 1] = rectOf(padRect(def.Slot.Pad), R.PadPad)
	end
	blocked[#blocked + 1] = rectOf(padRect(PRESTIGE_PAD.Slot.Pad), R.PadPad)
	-- the garden fence: four sides on the footprint edge, the entrance side split around the gap
	local g = BY_ID.Garden.Slot
	local fp = g.Footprint
	local hx, hz, t = fp.X / 2, fp.Z / 2, g.Fence
	local e = g.Entrance
	local function localRectOf(cx, cz, sx, sz, pad)
		blocked[#blocked + 1] = rectOf(localRect(g.CFrame, V3(cx, 0, cz), V3(sx, 0, sz)), pad)
	end
	localRectOf(0, hz - t / 2, fp.X, t, R.FencePad) -- back
	localRectOf(-hx + t / 2, 0, t, fp.Z, R.FencePad) -- left side
	localRectOf(hx - t / 2, 0, t, fp.Z, R.FencePad) -- right side
	local gap0, gap1 = e.Center.X - e.Width / 2, e.Center.X + e.Width / 2
	localRectOf((-hx + gap0) / 2, -hz + t / 2, gap0 + hx, t, R.FencePad) -- front, left of the entrance
	localRectOf((gap1 + hx) / 2, -hz + t / 2, hx - gap1, t, R.FencePad) -- front, right of the entrance
	-- the Food Bowl and the beds
	local b = g.Bowl
	localRectOf(b.Center.X, b.Center.Z, 2 * b.Radius, 2 * b.Radius, R.FencePad)
	local beds = {}
	for i, v in ipairs(g.Beds) do
		localRectOf(v.X, v.Z, g.BedSize, g.BedSize, R.BedPad)
		local w = g.CFrame * v
		beds[i] = { w.X, w.Z }
	end
	local bowl = g.CFrame * b.Center
	local entrance = g.CFrame * e.Center
	local wp = g.WelcomePile
	return {
		Half = R.Half,
		Cell = R.Cell,
		EatRing = R.EatRing,
		Blocked = blocked,
		Beds = beds,
		Bowl = { X = bowl.X, Z = bowl.Z, R = b.Radius },
		Welcome = { wp.X, wp.Z },
		Entrance = { X = entrance.X, Z = entrance.Z, Width = e.Width },
	}
end

-- Which pads can a player (about 2 studs wide) walk to from the gate? Returns { [padName] = true } for reachable
-- pads and the grid size. Obstacles: every station footprint that is not a walk-through zone, grown by `radius`.
function TycoonCatalog.ReachablePads(radius, cell)
	radius = radius or 1
	cell = cell or 1
	local n = floor(PLOT / cell)
	local blocked = {}
	local rects = {}
	for _, def in ipairs(STATIONS) do
		local slot = def.Slot
		if slot and not walkThrough(slot) then
			rects[#rects + 1] = footprintRect(slot.CFrame, slot.Footprint)
		end
	end
	local function cellCentre(i)
		return -HALF + (i - 0.5) * cell
	end
	for ix = 1, n do
		for iz = 1, n do
			local x, z = cellCentre(ix), cellCentre(iz)
			local b = math.abs(x) > HALF - radius or math.abs(z) > HALF - radius
			if not b then
				for _, r in ipairs(rects) do
					if x > r[1] - radius and x < r[2] + radius and z > r[3] - radius and z < r[4] + radius then
						b = true
						break
					end
				end
			end
			if b then
				blocked[(ix - 1) * n + iz] = true
			end
		end
	end
	-- flood from the gate (the cells just inside the opening)
	local seen = {}
	local queue = {}
	local gate = TycoonCatalog.Layout.Gate
	for ix = 1, n do
		local x = cellCentre(ix)
		if math.abs(x - gate.X) < TycoonCatalog.Layout.GateWidth / 2 - radius then
			for iz = 1, 3 do
				local key = (ix - 1) * n + iz
				if not blocked[key] and not seen[key] then
					seen[key] = true
					queue[#queue + 1] = key
				end
			end
		end
	end
	local head = 1
	while head <= #queue do
		local key = queue[head]
		head = head + 1
		local ix = floor((key - 1) / n) + 1
		local iz = key - (ix - 1) * n
		local nbs = { { ix + 1, iz }, { ix - 1, iz }, { ix, iz + 1 }, { ix, iz - 1 } }
		for _, nb in ipairs(nbs) do
			local a, b = nb[1], nb[2]
			if a >= 1 and a <= n and b >= 1 and b <= n then
				local k2 = (a - 1) * n + b
				if not blocked[k2] and not seen[k2] then
					seen[k2] = true
					queue[#queue + 1] = k2
				end
			end
		end
	end
	local reachable = {}
	local all = {}
	for _, def in ipairs(STATIONS) do
		all[#all + 1] = { def.Id, def.Slot.Pad }
	end
	all[#all + 1] = { PRESTIGE_PAD.Id, PRESTIGE_PAD.Slot.Pad }
	for _, item in ipairs(all) do
		local r = padRect(item[2])
		local ok = false
		for ix = 1, n do
			local x = cellCentre(ix)
			if x > r[1] and x < r[2] then
				for iz = 1, n do
					local z = cellCentre(iz)
					if z > r[3] and z < r[4] and seen[(ix - 1) * n + iz] then
						ok = true
						break
					end
				end
			end
			if ok then
				break
			end
		end
		reachable[item[1]] = ok
	end
	return reachable, n
end

-- per-kind effect rules (section 5.4): bad(msg) for every problem of one station
local function rising(values, strict)
	for i = 2, #values do
		if strict and values[i] <= values[i - 1] then
			return false
		elseif not strict and values[i] < values[i - 1] then
			return false
		end
	end
	return true
end

local function effectValues(def, key)
	local out = {}
	for lv = 1, def.MaxLevel do
		local e = def.Effects[lv]
		local v = type(e) == "table" and e[key] or nil
		if not finite(v) then
			return nil
		end
		out[lv] = v
	end
	return out
end

local function checkKindEffects(def, bad)
	local id, kind = def.Id, def.Kind
	local C = TycoonCatalog.Coins
	if kind == "Farm" then
		local food = effectValues(def, "Food")
		if not food or food[1] <= 0 or not rising(food, true) then
			bad(id .. ": Effects.Food must be positive and rising")
		end
	elseif kind == "Garden" then
		local lucky = effectValues(def, "Lucky")
		if not lucky or lucky[1] < 0 or lucky[#lucky] > 0.5 or not rising(lucky, false) then
			bad(id .. ": Effects.Lucky must be a chance in 0..0.5 that never drops")
		end
		local beds = def.Slot and def.Slot.Beds
		if type(beds) ~= "table" or #beds ~= TycoonCatalog.Prestige.GardenSlotsMax then
			bad(id .. ": needs " .. TycoonCatalog.Prestige.GardenSlotsMax .. " Beds (Prestige.GardenSlotsMax)")
		end
		local reset = def.ResetLevel
		if reset ~= nil and (int(reset) ~= reset or reset < 1 or reset > def.MaxLevel) then
			bad(id .. ": ResetLevel must be a level of the station")
		end
		local radius = effectValues(def, "Radius")
		local pile = effectValues(def, "PileSeconds")
		if not radius or radius[1] <= C.BaseRadius or not rising(radius, true) then
			bad(id .. ": Effects.Radius must rise above Coins.BaseRadius")
		end
		if not pile or pile[1] <= C.BasePileSeconds or not rising(pile, true) then
			bad(id .. ": Effects.PileSeconds must rise above Coins.BasePileSeconds")
		end
	elseif kind == "FoodMachine" then
		local share = effectValues(def, "FeedShare")
		if not share or share[1] <= 0 or share[#share] > 1 or not rising(share, true) then
			bad(id .. ": Effects.FeedShare must rise and stay in 0..1")
		end
	elseif kind == "Training" then
		local slots = effectValues(def, "Slots")
		if not slots or slots[1] < 1 or not rising(slots, true) then
			bad(id .. ": Effects.Slots must be >= 1 and rising")
		end
		local spots = def.Slot and def.Slot.Spots
		if slots and (type(spots) ~= "table" or #spots < slots[#slots]) then
			bad(id .. ": needs a Spot for every training slot")
		end
	elseif kind == "Vault" then
		local pile = effectValues(def, "PileSeconds")
		local pct = effectValues(def, "OfflinePercent")
		local hours = effectValues(def, "OfflineHours")
		if not pile or pile[1] <= 0 or not rising(pile, true) then
			bad(id .. ": Effects.PileSeconds must be positive and rising")
		end
		if not pct or not hours or pct[1] <= 0 or pct[#pct] > 1 or hours[1] <= 0 or not rising(pct, true) or not rising(hours, false) then
			bad(id .. ": Effects.OfflinePercent / OfflineHours must be positive and rising")
		end
	elseif kind == "Fusion" then
		local d = effectValues(def, "TokenDiscount")
		if not d or d[1] < 0 or d[#d] >= 1 or not rising(d, false) then
			bad(id .. ": Effects.TokenDiscount must be in 0..1 and never drop")
		end
	end
end

-- the roaming graph check (a light copy of HomeRoam.Build: the same grid and obstacles, 4-neighbours): the number of
-- walkable nodes and whether every bed and every eat point has a reachable node next to it
local function roamReach(layout)
	local half, cell = layout.Half, layout.Cell
	local n = floor(2 * half / cell) + 1
	local free = {}
	local count = 0
	local function pos(i)
		return -half + (i - 1) * cell
	end
	for i = 1, n do
		for j = 1, n do
			local x, z = pos(i), pos(j)
			local ok = z > -half + 2
			if ok then
				for _, r in ipairs(layout.Blocked) do
					local pad = r.pad or 0
					if x >= r[1] - pad and x <= r[3] + pad and z >= r[2] - pad and z <= r[4] + pad then
						ok = false
						break
					end
				end
			end
			if ok then
				free[(i - 1) * n + j] = true
				count = count + 1
			end
		end
	end
	local function nearest(x, z)
		local best, bd = nil, huge
		for key in pairs(free) do
			local i = floor((key - 1) / n) + 1
			local j = key - (i - 1) * n
			local d = (pos(i) - x) ^ 2 + (pos(j) - z) ^ 2
			if d < bd or (d == bd and key < best) then
				best, bd = key, d
			end
		end
		return best, bd
	end
	local b = layout.Bowl
	local eat = {}
	for slot = 1, 12 do
		local a = math.rad((slot - 1) * 30)
		eat[slot] = { b.X + math.cos(a) * layout.EatRing, b.Z + math.sin(a) * layout.EatRing }
	end
	local start = nearest(eat[1][1], eat[1][2])
	local seen = {}
	if start then
		seen[start] = true
		local queue, head = { start }, 1
		while head <= #queue do
			local key = queue[head]
			head = head + 1
			local i = floor((key - 1) / n) + 1
			local j = key - (i - 1) * n
			for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
				local a, c = i + d[1], j + d[2]
				if a >= 1 and a <= n and c >= 1 and c <= n then
					local k2 = (a - 1) * n + c
					if free[k2] and not seen[k2] then
						seen[k2] = true
						queue[#queue + 1] = k2
					end
				end
			end
		end
	end
	local problems = {}
	local function reached(what, x, z, within)
		local key, d2 = nearest(x, z)
		if not key or not seen[key] or d2 > within * within then
			problems[#problems + 1] = what
		end
	end
	for slot, p in ipairs(eat) do
		reached("eat point " .. slot, p[1], p[2], 2.5)
	end
	for slot, p in ipairs(layout.Beds) do
		reached("bed " .. slot, p[1], p[2], 4)
	end
	return count, problems
end

-- the garden of Phase 5 3.3: bowl, 12 beds, fence + entrance, the Welcome-back pile, the roaming graph
local function checkGardenLayout(bad)
	local garden = BY_ID.Garden
	local slot = garden and garden.Slot
	if type(slot) ~= "table" or typeof(slot.CFrame) ~= "CFrame" or typeof(slot.Footprint) ~= "Vector3" then
		bad("Garden: no slot")
		return
	end
	local fp = slot.Footprint
	local fr = footprintRect(slot.CFrame, fp)
	local bowl = slot.Bowl
	local e = slot.Entrance
	if type(bowl) ~= "table" or typeof(bowl.Center) ~= "Vector3" or not finite(bowl.Radius) then
		bad("Garden: Slot.Bowl needs Center and Radius")
		return
	end
	if type(e) ~= "table" or typeof(e.Center) ~= "Vector3" or not finite(e.Width) then
		bad("Garden: Slot.Entrance needs Center and Width")
		return
	end
	if math.abs(math.abs(e.Center.Z) - fp.Z / 2) > 1e-6 or math.abs(e.Center.X) + e.Width / 2 > fp.X / 2 then
		bad("Garden: the entrance must sit on the front fence")
	end
	if not finite(slot.Fence) or slot.Fence <= 0 or slot.Fence > 1 then
		bad("Garden: Slot.Fence must be a thin ring (0..1 stud)")
	end
	local beds = slot.Beds or {}
	local half = (slot.BedSize or 2.5) / 2
	for i, v in ipairs(beds) do
		if math.abs(v.X) + half > fp.X / 2 - (slot.Fence or 0) or math.abs(v.Z) + half > fp.Z / 2 - (slot.Fence or 0) then
			bad("Garden: bed " .. i .. " leaves the footprint")
		end
		local dx, dz = v.X - bowl.Center.X, v.Z - bowl.Center.Z
		if math.sqrt(dx * dx + dz * dz) < bowl.Radius + 1.5 then
			bad("Garden: bed " .. i .. " is too close to the Food Bowl")
		end
		if math.abs(v.X - e.Center.X) < e.Width / 2 + half and math.abs(v.Z - e.Center.Z) < 3 then
			bad("Garden: bed " .. i .. " blocks the entrance")
		end
		for j = 1, i - 1 do
			if (beds[j] - v).Magnitude < 3 then
				bad("Garden: beds " .. j .. " and " .. i .. " are closer than 3 studs")
			end
		end
	end
	-- the Welcome-back pile: plot-local, inside the yard, outside the garden fence, off every pad and station
	local wp = slot.WelcomePile
	if typeof(wp) ~= "Vector3" then
		bad("Garden: Slot.WelcomePile is missing")
	else
		if math.abs(wp.X) > HALF - 1 or math.abs(wp.Z) > HALF - 1 then
			bad("Garden: the Welcome-back pile leaves the yard")
		end
		if inside(fr, wp.X, wp.Z) then
			bad("Garden: the Welcome-back pile lies inside the garden fence")
		end
		local pads = {}
		for _, def in ipairs(STATIONS) do
			pads[#pads + 1] = { def.Id, padRect(def.Slot.Pad) }
		end
		pads[#pads + 1] = { "Prestige", padRect(PRESTIGE_PAD.Slot.Pad) }
		for _, p in ipairs(pads) do
			if inside(p[2], wp.X, wp.Z, 0.25) then
				bad("Garden: the Welcome-back pile lies on the " .. p[1] .. " pad")
			end
		end
		for _, def in ipairs(STATIONS) do
			if def ~= garden and not walkThrough(def.Slot) and inside(footprintRect(def.Slot.CFrame, def.Slot.Footprint), wp.X, wp.Z) then
				bad("Garden: the Welcome-back pile lies inside " .. def.Id)
			end
		end
	end
	-- the roaming graph: >= 300 walkable nodes, every bed and eat point reachable
	local count, problems = roamReach(TycoonCatalog.RoamLayout())
	if count < 300 then
		bad("RoamLayout: only " .. count .. " walkable nodes (needs >= 300)")
	end
	for _, what in ipairs(problems) do
		bad("RoamLayout: " .. what .. " cannot be reached")
	end
end

function TycoonCatalog.Validate()
	local problems = {}
	local function bad(msg)
		problems[#problems + 1] = msg
	end
	local kindSet = {}
	for _, k in ipairs(TycoonCatalog.Kinds) do
		kindSet[k] = true
	end
	local contractIds = {
		"Press1", "Garden", "Kitchen", "Gym", "Vault", "House", "FusionMachine", "ArenaGate",
		"DecorFence", "DecorFountain", "DecorPodium",
	}
	for _, id in ipairs(contractIds) do
		if not BY_ID[id] then
			bad("missing station " .. id)
		end
	end
	if #STATIONS ~= #contractIds then
		bad("expected " .. #contractIds .. " stations, found " .. #STATIONS)
	end
	if #TIERS ~= 4 then
		bad("expected 4 house tiers")
	end

	local seen = {}
	for _, def in ipairs(STATIONS) do
		local id = tostring(def.Id)
		if seen[id] then
			bad("duplicate station id " .. id)
		end
		seen[id] = true
		if type(def.Name) ~= "string" or def.Name == "" then
			bad(id .. ": missing Name")
		end
		if not kindSet[def.Kind] then
			bad(id .. ": unknown Kind " .. tostring(def.Kind))
		end
		if type(def.Icon) ~= "string" or def.Icon == "" then
			bad(id .. ": missing Icon")
		end
		local maxLevel = int(def.MaxLevel)
		if not maxLevel or maxLevel < 1 or maxLevel ~= def.MaxLevel then
			bad(id .. ": MaxLevel must be a whole number >= 1")
			maxLevel = 0
		end
		-- prices: whole, >= 0, rising
		local last = -1
		for lv = 1, maxLevel do
			local p = def.Price[lv]
			if type(p) ~= "number" or p < 0 or p ~= floor(p) then
				bad(id .. ": Price[" .. lv .. "] must be a whole number >= 0")
			elseif p < last or (p == last and p > 0) then
				bad(id .. ": Price[" .. lv .. "] must be higher than the level before")
			else
				last = p
			end
			if type(def.Effects[lv]) ~= "table" then
				bad(id .. ": Effects[" .. lv .. "] missing")
			end
		end
		if def.Price[maxLevel + 1] ~= nil or def.Effects[maxLevel + 1] ~= nil then
			bad(id .. ": Price / Effects go past MaxLevel")
		end
		if maxLevel > 0 then
			checkKindEffects(def, bad)
		end
		-- tier caps: 0..MaxLevel, never dropping, the Sky Castle allows MaxLevel
		local lastCap = 0
		for _, tier in ipairs(TIERS) do
			local c = def.TierCaps[tier.Id]
			if type(c) ~= "number" or c < 0 or c > maxLevel or c ~= floor(c) then
				bad(id .. ": TierCaps." .. tier.Id .. " must be a whole number in 0.." .. maxLevel)
			elseif c < lastCap then
				bad(id .. ": TierCaps drop at " .. tier.Id)
			else
				lastCap = c
			end
		end
		if def.TierCaps.SkyCastle ~= maxLevel then
			bad(id .. ": the Sky Castle must allow MaxLevel")
		end
		-- requirement keys
		for key, need in pairs(def.Requires) do
			if key == "HomeLevel" or key == "Prestige" then
				if int(need) == nil or need < 0 then
					bad(id .. ": Requires." .. key .. " must be a whole number")
				end
			elseif key == "House" then
				if not tierIndexOf(need) then
					bad(id .. ": Requires.House must be a house tier id")
				end
			elseif BY_ID[key] then
				if key == id then
					bad(id .. ": requires itself")
				elseif int(need) == nil or need < 1 or need > BY_ID[key].MaxLevel then
					bad(id .. ": Requires." .. key .. " out of range")
				end
			else
				bad(id .. ": unknown requirement " .. tostring(key))
			end
		end
		-- slot
		local slot = def.Slot
		local slotOk = type(slot) == "table" and typeof(slot.CFrame) == "CFrame" and typeof(slot.Footprint) == "Vector3"
		if not slotOk or typeof(slot.Pad) ~= "CFrame" then
			bad(id .. ": Slot needs CFrame, Footprint and Pad")
		end
	end

	-- the House levels follow the tiers
	local house = BY_ID.House
	if house then
		for i, tier in ipairs(TIERS) do
			if house.Effects[i] and house.Effects[i].Tier ~= tier.Id then
				bad("House.Effects[" .. i .. "].Tier must be " .. tier.Id)
			end
			if i >= 2 then
				local lr = house.LevelRequires[i]
				if type(lr) ~= "table" or lr.HomeLevel ~= tier.HomeLevel then
					bad("House level " .. i .. " must need Home Level " .. tier.HomeLevel)
				end
			end
		end
	end
	local lastHL = -1
	for _, tier in ipairs(TIERS) do
		if type(tier.HomeLevel) ~= "number" or tier.HomeLevel <= lastHL then
			bad("HouseTiers HomeLevel must rise")
		end
		lastHL = tier.HomeLevel or lastHL
	end

	-- a fresh home shows exactly one pad: the free Pet Garden (the root of the tree)
	local fresh = TycoonCatalog.AvailablePads({ Stations = {}, Prestige = 0 })
	if #fresh ~= 1 or fresh[1].StationId ~= "Garden" or fresh[1].Price ~= 0 or fresh[1].Locked ~= nil then
		bad("a fresh home must show exactly one pad: the free, open Pet Garden (" .. #fresh .. " pads)")
	end

	-- no dead ends: buying every unlocked pad (cheapest first, cash unlimited) reaches the Sky Castle, Home Level
	-- 40 and the prestige; with 1 star, every station but the "Coming soon" ones reaches MaxLevel
	local function buildOut(stars)
		local home = { Stations = {}, Prestige = stars }
		for _ = 1, 400 do
			local best = nil
			for _, pad in ipairs(TycoonCatalog.AvailablePads(home)) do
				if not pad.Locked and not pad.Prestige and (not best or pad.Price < best.Price) then
					best = pad
				end
			end
			if not best then
				break
			end
			home.Stations[best.StationId] = best.NextLevel
		end
		return home
	end
	local first = buildOut(0)
	local okPrestige, why = TycoonCatalog.CanPrestige(first)
	if not okPrestige then
		bad("dead end: a fresh home cannot reach the prestige (" .. tostring(why) .. ")")
	end
	local later = buildOut(1)
	for _, def in ipairs(STATIONS) do
		if not def.ComingSoon and levelOf(later, def.Id) < def.MaxLevel then
			bad("dead end: " .. def.Id .. " stops at level " .. levelOf(later, def.Id) .. " of " .. def.MaxLevel)
		end
	end
	-- a prestige keeps the coins going: the stations after it still give a garden (and its pad tree)
	local after = TycoonCatalog.StationsAfterPrestige(first.Stations)
	if levelOf({ Stations = after }, "Garden") < 1 then
		bad("Prestige must keep the Garden built (ResetLevel)")
	end
	-- each tier's caps allow enough Home Level for the next tier (else the house could never be upgraded)
	for i = 1, #TIERS - 1 do
		local total = 0
		for _, def in ipairs(STATIONS) do
			if not def.ComingSoon and not (def.Requires.Prestige and def.Requires.Prestige > 0) then
				total = total + (def.TierCaps[TIERS[i].Id] or 0)
			end
		end
		if total < TIERS[i + 1].HomeLevel then
			local nextTier = TIERS[i + 1]
			bad(TIERS[i].Id .. " caps add up to Home Level " .. total .. ", below the " .. nextTier.Id .. "'s " .. nextTier.HomeLevel)
		end
	end

	-- coins, garden places, star prices, the Food Machine and the Training Place
	local C = TycoonCatalog.Coins
	for _, k in ipairs({ "MealSeconds", "GrassFood", "LuckyMult", "BaseRadius", "BasePileSeconds" }) do
		if not finite(C[k]) or C[k] <= 0 then
			bad("Coins." .. k .. " must be positive")
		end
	end
	if not finite(C.LuckyMult) or C.LuckyMult <= 1 then
		bad("Coins.LuckyMult must be above 1")
	end
	local ds = C.DropStages
	if type(ds) ~= "table" or #ds ~= 4 or ds[1] ~= 1 or not rising(ds, true) then
		bad("Coins.DropStages must be 4 rising poop counts starting at 1")
	end
	for _, k in ipairs({ "PoopMeals", "DropsPerPet" }) do
		if int(C[k]) ~= C[k] or C[k] < 1 then
			bad("Coins." .. k .. " must be a whole number >= 1")
		end
	end
	local p = TycoonCatalog.Prestige
	if int(p.GardenSlotsBase) ~= p.GardenSlotsBase or p.GardenSlotsBase < 1 then
		bad("Prestige.GardenSlotsBase must be a whole number >= 1")
	end
	if int(p.GardenSlotsPerStar) ~= p.GardenSlotsPerStar or p.GardenSlotsPerStar < 0 then
		bad("Prestige.GardenSlotsPerStar must be a whole number >= 0")
	end
	if int(p.GardenSlotsMax) ~= p.GardenSlotsMax or p.GardenSlotsMax < p.GardenSlotsBase then
		bad("Prestige.GardenSlotsMax must be a whole number >= GardenSlotsBase")
	end
	if not finite(p.PriceStep) or p.PriceStep < 0 then
		bad("Prestige.PriceStep must be >= 0")
	end
	local share = TycoonCatalog.FeedShare
	if type(share) ~= "table" or #share ~= BY_ID.Kitchen.MaxLevel then
		bad("FeedShare needs one share per Food Machine level")
	end
	if not finite(TycoonCatalog.FeedBase) or TycoonCatalog.FeedBase <= 0 then
		bad("FeedBase must be positive")
	end
	local tr = TycoonCatalog.Training
	if type(tr) ~= "table" or int(tr.MaxRank) ~= tr.MaxRank or tr.MaxRank < 1 or not finite(tr.CostBase) or tr.CostBase <= 0
		or not finite(tr.MinutesPerRank) or tr.MinutesPerRank <= 0 then
		bad("Training needs a whole MaxRank >= 1 and positive CostBase / MinutesPerRank")
	end
	if TycoonCatalog.Layout.Conveyor ~= nil then
		bad("Layout.Conveyor is gone in Phase 4 (no presses, no belt)")
	end

	-- berries (one food) and the pad signs
	local B = TycoonCatalog.Berries
	if type(B) ~= "table" or not finite(B.Share) or B.Share <= 0 or B.Share > 1 or not finite(B.BasketMinutes)
		or B.BasketMinutes <= 0 or int(B.BasketMin) ~= B.BasketMin or B.BasketMin < 1 then
		bad("Berries needs Share in 0..1, positive BasketMinutes and a whole BasketMin >= 1")
	else
		for _, id in ipairs({ "Snack", "Meal", "Feast" }) do
			local v = type(B.LegacyFood) == "table" and B.LegacyFood[id]
			if int(v) ~= v or v < 1 then
				bad("Berries.LegacyFood." .. id .. " must be a whole number of berries")
			end
		end
	end
	if int(TycoonCatalog.SignRules.MaxSigns) ~= TycoonCatalog.SignRules.MaxSigns or TycoonCatalog.SignRules.MaxSigns < 1 then
		bad("SignRules.MaxSigns must be a whole number >= 1")
	end
	for id, food in pairs(TycoonCatalog.LegacyPlants) do
		if #food ~= 10 or not rising(food, true) then
			bad("LegacyPlants." .. id .. " must be the 10 rising Phase 4 food values")
		end
	end
	local lm = TycoonCatalog.LegacyMagnet
	if #lm.Radius ~= lm.MaxLevel or #lm.PileSeconds ~= lm.MaxLevel then
		bad("LegacyMagnet needs a Radius and a PileSeconds per level")
	end

	-- XP curve
	local px = TycoonCatalog.PetXp
	local prev = 0
	for lv = 1, px.MaxLevel - 1 do
		local x = TycoonCatalog.XpToNext(lv)
		if type(x) ~= "number" or x < prev or x <= 0 or x == huge then
			bad("XpToNext(" .. lv .. ") must be positive and never drop")
			break
		end
		prev = x
	end
	if TycoonCatalog.XpToNext(px.MaxLevel) ~= huge then
		bad("XpToNext(MaxLevel) must be math.huge")
	end
	if TycoonCatalog.MaxPetLevel ~= px.MaxLevel then
		bad("MaxPetLevel must equal PetXp.MaxLevel")
	end

	-- fusion costs for every rarity
	for _, r in ipairs(Config.Rarities or {}) do
		local up = TycoonCatalog.Fusion.Upgrade[r.Id]
		if type(up) ~= "table" or type(up.Golden) ~= "table" or type(up.Rainbow) ~= "table" then
			bad("Fusion.Upgrade." .. tostring(r.Id) .. " needs Golden and Rainbow")
		end
		local mix = TycoonCatalog.Fusion.Mix[r.Id]
		if type(mix) ~= "table" or (type(mix.Tokens) ~= "number" and type(mix.Gems) ~= "number") then
			bad("Fusion.Mix." .. tostring(r.Id) .. " needs Tokens or Gems")
		end
	end

	-- prestige
	if not tierIndexOf(p.House) then
		bad("Prestige.House must be a house tier")
	end
	if type(p.IncomeMultiplier) ~= "number" or p.IncomeMultiplier <= 1 then
		bad("Prestige.IncomeMultiplier must be above 1")
	end
	if type(p.GemReward) ~= "number" or p.GemReward < 0 then
		bad("Prestige.GemReward must be >= 0")
	end

	-- layout: inside the yard, no overlaps between stations / pads, every pad reachable from the gate
	local margin = TycoonCatalog.Layout.Margin
	local rects = {}
	for _, def in ipairs(STATIONS) do
		local slot = def.Slot
		local slotOk = type(slot) == "table" and typeof(slot.CFrame) == "CFrame" and typeof(slot.Footprint) == "Vector3"
		if slotOk and typeof(slot.Pad) == "CFrame" then
			local r = footprintRect(slot.CFrame, slot.Footprint)
			local limit = HALF - margin
			local outside = r[1] < -HALF or r[2] > HALF or r[3] < -HALF or r[4] > HALF
			local inMargin = r[1] < -limit or r[2] > limit or r[3] < -limit or r[4] > limit
			-- the fence decor follows the fence line; other decor may line the fence; stations keep the margin
			if not slot.Perimeter and (outside or (def.Kind ~= "Decor" and inMargin)) then
				bad(def.Id .. ": footprint leaves the yard")
			end
			local pr = padRect(slot.Pad)
			if pr[1] < -HALF or pr[2] > HALF or pr[3] < -HALF or pr[4] > HALF then
				bad(def.Id .. ": pad outside the yard")
			end
			rects[#rects + 1] = { Id = def.Id, R = r, Pad = pr, Walk = walkThrough(slot) }
		end
	end
	local pp = padRect(PRESTIGE_PAD.Slot.Pad)
	rects[#rects + 1] = { Id = "Prestige", R = nil, Pad = pp, Walk = true }
	for i = 1, #rects do
		local a = rects[i]
		for j = i + 1, #rects do
			local b = rects[j]
			if a.R and b.R and not a.Walk and not b.Walk and overlap(a.R, b.R) then
				bad("slots overlap: " .. a.Id .. " and " .. b.Id)
			end
			if overlap(a.Pad, b.Pad, 0.5) then
				bad("pads too close: " .. a.Id .. " and " .. b.Id)
			end
		end
		for j = 1, #rects do
			local b = rects[j]
			if b.R and not b.Walk and overlap(a.Pad, b.R) then
				bad("pad of " .. a.Id .. " overlaps " .. b.Id)
			end
		end
	end
	checkGardenLayout(bad)
	local reach = TycoonCatalog.ReachablePads(1, 1)
	for id, ok in pairs(reach) do
		if not ok then
			bad("pad of " .. id .. " cannot be reached from the gate")
		end
	end
	return #problems == 0, problems
end

return TycoonCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="825">
        <Properties>
          <string name="Name">UpdateNotes</string>
          <string name="Source"><![CDATA[-- UpdateNotes: what the UPDATES panel of the main menu shows, the credits and the loading-screen tips
-- (ARCHITECTURE_V3.md "Phase 5 build contract" 7.1 / 7.2; lead W0). Pure data, read by the client only.
--
--   UpdateNotes.Latest   -> 6   the newest note's Version; the menu shows a "NEW" badge while Settings.SeenNotes < Latest
--                                and opening UPDATES sends SettingsSet("SeenNotes", Latest)
--   UpdateNotes.Notes    -> { { Version, Title, Lines = { ... } }, ... }  newest first
--   UpdateNotes.Credits  -> { line, ... }
--   UpdateNotes.Tips     -> { 12 short tips }  the loading screen rotates one every 5 s (LoadingScreen.client.lua)
-- Texts are for kids: short lines, plain words, no jargon. Plain Lua 5.1-compatible syntax only.

local UpdateNotes = {}

UpdateNotes.Latest = 6

UpdateNotes.Notes = {
	{
		Version = 6,
		Title = "The Cute Blocks Update",
		Lines = {
			"The bright, cute look is back, with smaller blocks and more detail.",
			"New hand-made 3D models for every pet, evolved pet, boss, gate, home and island arrive one by one.",
			"Evolved pets shine: sparkles in their colours and a soft glow. Second evolutions glow brighter and pulse.",
			"A magic swirl spins inside every gate, with a glowing rim and tiny lightning sparks.",
			"No Home gate in the lobby: tap Home, then Go home. No home yet? Tap Claim a home.",
			"Battles: your pet attacks by itself, F picks who, and Shift makes your pet dash. Dungeon enemies arrive in a flash!",
			"Nothing is lost: pets, levels, Cash, Gems, Tokens and homes stay the same.",
		},
	},
	{
		Version = 5,
		Title = "The Big Sky Update",
		Lines = {
			"Fight with one pet and bring two helpers. You move your fighter: ATTACK, ELEMENT, SPECIAL and DASH.",
			"The Dungeon: 12 floors of 4 rooms, alone or with up to 3 friends. Every room pays Cash, Tokens and XP.",
			"One portal per mode in the new Gate Court: Obby, Dungeon, Champion Ring, Arena, Storm Altar. Tap Home to go home.",
			"Pick your obby level at the Obby gate. Beat a level to unlock the next one.",
			"Your home got simpler: one Berry Farm, a roaming Pet Garden and three decorations.",
			"Garden pets roam your yard, eat at the Food Bowl and drop Cloud Cash. Walk over it to scoop!",
			"Berries fill your Berry Basket. At the Food Machine, ONE button: Feed. No Cash for food anymore.",
			"Evolved pets look evolved everywhere, and the level bonus grows x1.5 and x1.875 after evolving.",
			"More stamina: 150, it refills faster, and four dashes from full.",
			"A new look: stone and wood under a pink and purple cloud sky, neon menus, a loading screen and a main menu with settings.",
			"Nothing is lost: pets, levels, Cash, Gems, Tokens, homes and records carry over. Old Trial clears became dungeon floors.",
		},
	},
	{
		Version = 4,
		Title = "The Coin Garden Update",
		Lines = {
			"Garden pets make Cloud Cash: scoop their coin piles.",
			"Feed pets at the Food Machine, train them at the Training Place, and EVOLVE them at level 20 and 50.",
			"The Champion Ring: beat round after round of champions.",
		},
	},
	{
		Version = 3,
		Title = "The Battle Arena Update",
		Lines = {
			"The Battle Arena island: boss raids, duels and battle teams.",
			"Pets have elements: Water beats Flame, Flame beats Frost, and so on.",
		},
	},
	{
		Version = 2,
		Title = "The Sky Homes Update",
		Lines = {
			"Claim a home in the sky, build it up with Cash and go for Prestige.",
			"Fuse two pets into a new one at the Fusion Machine.",
		},
	},
}

-- The README's owner checklist tells the owner to put their name on the first line.
UpdateNotes.Credits = {
	"Game by the Nimbus Climb owner",
	"Built with Claude",
}

UpdateNotes.Tips = {
	"Your two helpers float behind your fighter. Each has one BUFF button.",
	"SWAP puts a helper in as the fighter. Three pets, three lives.",
	"Water beats Flame, Flame beats Frost, Frost beats Nature, Nature beats Earth, Earth beats Storm, Storm beats Water.",
	"Support pets heal, shield or boost. They are best as helpers.",
	"Every level adds +10% to a pet. Evolving makes that bonus grow faster.",
	"Beat an obby level to unlock the next one at the Obby gate.",
	"Dungeon rooms pay everyone who fought in them. Standing still pays nothing.",
	"Clear a dungeon floor for the first time for big Tokens and Gems.",
	"Garden pets drop Cloud Cash in your yard. Walk over it to scoop it up.",
	"Berries go into your Berry Basket. Feed them to your pets at the Food Machine.",
	"In a battle Shift makes your pet dash, for free. Outside a battle DASH is Q and costs stamina.",
	"Tap Home, then Go home: a magic portal takes you and your pets home.",
}

return UpdateNotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="826">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- Util: small helpers used on both server and client. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Util = {}

-- Instance.new + props + children in one call.
function Util.Create(className, props, children)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			if key ~= "Parent" then
				inst[key] = value
			end
		end
	end
	if children then
		for _, child in ipairs(children) do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent -- parent last: one replication step
	end
	return inst
end

-- Minimal pure-Lua signal (no BindableEvent) so game logic is testable outside Roblox.
-- local s = Util.Signal(); local c = s:Connect(fn); s:Fire(...); c:Disconnect()
function Util.Signal()
	local signal = { _handlers = {} }
	function signal:Connect(fn)
		local handler = { fn = fn, connected = true }
		table.insert(self._handlers, handler)
		return {
			Connected = true,
			Disconnect = function(conn)
				conn.Connected = false
				handler.connected = false
			end,
		}
	end
	function signal:Fire(...)
		local snapshot = {}
		for i, h in ipairs(self._handlers) do
			snapshot[i] = h
		end
		local alive = {}
		for _, h in ipairs(self._handlers) do
			if h.connected then
				table.insert(alive, h)
			end
		end
		self._handlers = alive
		for _, h in ipairs(snapshot) do
			if h.connected then
				task.spawn(h.fn, ...)
			end
		end
	end
	function signal:Destroy()
		for _, h in ipairs(self._handlers) do
			h.connected = false
		end
		self._handlers = {}
	end
	return signal
end

function Util.Clamp(n, lo, hi)
	if n < lo then
		return lo
	elseif n > hi then
		return hi
	end
	return n
end

function Util.Lerp(a, b, t)
	return a + (b - a) * t
end

function Util.Round(n, decimals)
	local m = 10 ^ (decimals or 0)
	return math.floor(n * m + 0.5) / m
end

-- 125 -> "2:05"
function Util.FormatTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- 12345 -> "12,345"
function Util.Commas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

function Util.GetCharacter(player)
	return player and player.Character
end

function Util.GetHumanoid(player)
	local char = player and player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

function Util.GetRoot(player)
	local char = player and player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

-- Part touched by a character -> that character's Player (or nil).
function Util.PlayerFromPart(part)
	if not part then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	if not model then
		return nil
	end
	return Players:GetPlayerFromCharacter(model)
end

function Util.Tween(instance, seconds, goal, style, direction)
	local info = TweenInfo.new(
		seconds,
		style or Enum.EasingStyle.Quad,
		direction or Enum.EasingDirection.Out
	)
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

-- Deterministic RNG wrapper. rng:Float(a,b) rng:Int(a,b) rng:Chance(p) rng:Pick(list)
function Util.NewRng(seed)
	local random = Random.new(seed)
	local rng = {}
	function rng:Float(a, b)
		return random:NextNumber(a, b)
	end
	function rng:Int(a, b)
		return random:NextInteger(a, b)
	end
	function rng:Chance(p)
		return random:NextNumber() < p
	end
	function rng:Pick(list)
		return list[random:NextInteger(1, #list)]
	end
	return rng
end

return Util
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="827">
        <Properties>
          <string name="Name">Voxel</string>
          <string name="Source"><![CDATA[-- Voxel: the detailed fine-voxel kit of Nimbus Climb (ARCHITECTURE_V3.md, "ART DIRECTION").
-- Models are SCULPTED from signed-distance-like shapes into an integer voxel grid, shaded (lighter tops,
-- darker undersides and creases), then greedily merged into as few box Parts as possible.
-- Usable on the server, on the client and inside ViewportFrames. Plain Lua 5.1-compatible syntax only.
--
--   Voxel.NewGrid(resolution) -> grid          resolution = voxels per model height (informative; Build can use it)
--   Voxel.Shape(grid, shape) -> changed        sculpt one shape (see "Shapes" below)
--   Voxel.Shade(grid, opts) -> nLight, nDark   <key>_Light on exposed tops, <key>_Dark on undersides / creases
--   Voxel.Merge(grid, opts) -> boxes           the 3D greedy merge Build uses (opts.MaxParts = LOD, see Build)
--   Voxel.Build(grid, opts) -> Model, parts, boxes
--   Voxel.Box(parent, cframe, size, color, material, props) -> Part     one block, for world building
--
-- Extras: Voxel.Set / Get / Count / Bounds / Copy / Remap / Mirror / Hash / Lighten / Darken / BuildBoxes / MirrorBoxes
--
-- Coordinates: voxel (x, y, z) is the unit cube CENTRED on the integer point (x, y, z) (voxel units). Shapes are
-- given in voxel units too (fractions allowed); a voxel is filled when its centre lies inside the shape. Tips:
--   * an odd number of voxels across -> centre on an integer; an even number -> centre on .5
--   * round shapes (Ellipsoid, Capsule, Cone, Torus, Curve, RoundBox) are inflated by Bias = 0.25 voxel by
--     default, so a Radius of 3 gives a clean 7-voxel ball without single-voxel "nubs" at the poles.
--
-- Shapes: { Kind = ..., Key = paletteKey, Op = "Add" | "Carve" | "Paint", Rotation = CFrame, Pivot = point,
--           Pattern = fn(x, y, z, currentKey) -> key | nil (use Key) | false (skip this voxel),
--           OnlyKeys = key | {key = true} (Carve / Paint only touch these keys), KeepExisting = true (Add only fills
--           empty voxels), Bias = n }
--   Ellipsoid  Center, Radius (number or vector of radii)
--   Capsule    A, B, Radius [, RadiusB]            (tapered when RadiusB is given: Radius at A, RadiusB at B)
--   Box        Center, Size                         (full size; Bias 0)
--   RoundBox   Center, Size, Round (corner radius, default 1)
--   Cone       A (base centre), B (tip), Radius [, RadiusB = 0 (radius at B: a truncated cone when > 0)]
--   Torus      Center, Radius (ring), Thickness (tube) [, ThicknessB (taper along the arc), Arc = {from, to}
--              radians, measured from +X towards +Z]; the ring lies in the XZ plane (axis Y) before Rotation
--   Curve      Points = {p1, p2, ...} [, Radius, RadiusB (taper start -> end) | Radii = {r per point},
--              Smooth = true (Catmull-Rom through the points), Steps = 6 (segments per span)]
-- Points / vectors may be Vector3, {x, y, z} or {X =, Y =, Z =}. Rotation turns the shape about Pivot (default:
-- Center, or A / the first point).
--
-- Palette: { key = Color3 | { Color = Color3, Material = Enum.Material, Transparency = n, Reflectance = n } }.
-- A missing <key>_Light / <key>_Dark entry is derived from <key> (about 15% lighter / darker; shadows lean a
-- little cool, highlights a little warm).
--
-- Merging: same-key voxels become boxes. Voxels completely enclosed by opaque voxels can never be seen, so any
-- opaque box may pass through them (fewer, bigger boxes; the surface is unchanged). Untextured opaque materials
-- (SmoothPlastic, Neon) may also overlap boxes of their own key. Translucent keys get exact, disjoint boxes.
-- If the result has more boxes than opts.MaxParts, nearly-equal shades are merged first (_Light / _Dark back
-- into their base colour, the patchiest ones first, then increasingly different colours) until it fits (LOD).

local Voxel = {}

local floor, ceil, sqrt, abs, max, min = math.floor, math.ceil, math.sqrt, math.abs, math.max, math.min
local atan2 = math.atan2 or function(y, x)
	return math.atan(y, x)
end
local PI = math.pi
local TAU = math.pi * 2

----------------------------------------------------------------------
-- Packed integer keys: one number per voxel (fast table keys, cheap neighbour offsets)
----------------------------------------------------------------------
local OFF = 1024 -- coordinates -1024 .. 1023 on every axis
local S = 2048
local S2 = S * S
local STR = { 1, S, S2 }

local function pack(x, y, z)
	return (x + OFF) + (y + OFF) * S + (z + OFF) * S2
end

local function unpack3(k)
	local z = floor(k / S2)
	local r = k - z * S2
	local y = floor(r / S)
	local x = r - y * S
	return x - OFF, y - OFF, z - OFF
end

Voxel.Pack = pack
Voxel.Unpack = unpack3

-- the 6 face neighbours
local FACE = { 1, -1, S, -S, S2, -S2 }

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
-- x, y, z of a Vector3 / {x, y, z} / {X =, Y =, Z =} / number (all three)
local function vec(v, dx, dy, dz)
	if v == nil then
		return dx or 0, dy or 0, dz or 0
	end
	if type(v) == "number" then
		return v, v, v
	end
	if type(v) == "table" and rawget(v, 1) ~= nil then
		return v[1] or 0, v[2] or 0, v[3] or 0
	end
	if type(v) == "table" and rawget(v, "x") ~= nil then
		return v.x or 0, v.y or 0, v.z or 0
	end
	return v.X, v.Y, v.Z
end

-- rotation matrix components of a CFrame (nil when there is no rotation)
local function rotationOf(cf)
	if cf == nil then
		return nil
	end
	local ok, _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = pcall(function()
		return cf:GetComponents()
	end)
	if not ok or r00 == nil then
		return nil
	end
	if r00 == 1 and r11 == 1 and r22 == 1 and r01 == 0 and r02 == 0 and r10 == 0 and r12 == 0 and r20 == 0 and r21 == 0 then
		return nil
	end
	return { r00, r01, r02, r10, r11, r12, r20, r21, r22 }
end

-- world = pivot + R * (p - pivot)
local function rotatePoint(R, px, py, pz, x, y, z)
	local dx, dy, dz = x - px, y - py, z - pz
	return px + R[1] * dx + R[2] * dy + R[3] * dz,
		py + R[4] * dx + R[5] * dy + R[6] * dz,
		pz + R[7] * dx + R[8] * dy + R[9] * dz
end

local function toSet(v)
	if v == nil then
		return nil
	end
	if type(v) == "string" then
		return { [v] = true }
	end
	if type(v) == "table" then
		if rawget(v, 1) ~= nil then
			local s = {}
			for _, k in ipairs(v) do
				s[k] = true
			end
			return s
		end
		return v
	end
	return nil
end

-- Deterministic hash of three integers (+ seed) -> [0, 1). Handy for patterns and noise.
function Voxel.Hash(x, y, z, seed)
	local h = (x * 73856093 + y * 19349663 + z * 83492791 + (seed or 0) * 2654435761) % 2147483647
	h = (h * 16807) % 2147483647
	h = (h * 16807) % 2147483647
	return h / 2147483647
end

----------------------------------------------------------------------
-- Colours
----------------------------------------------------------------------
local function clamp01(v)
	if v < 0 then
		return 0
	elseif v > 1 then
		return 1
	end
	return v
end

-- about 15% lighter by default, warm highlight
function Voxel.Lighten(c, t)
	t = t or 0.15
	return Color3.new(clamp01(c.R + (1 - c.R) * t), clamp01(c.G + (0.98 - c.G) * t), clamp01(c.B + (0.9 - c.B) * t * 0.9))
end

-- about 15% darker by default, slightly cool shadow
function Voxel.Darken(c, t)
	t = t or 0.15
	return Color3.new(clamp01(c.R * (1 - t * 1.05)), clamp01(c.G * (1 - t)), clamp01(c.B * (1 - t * 0.75)))
end

local function baseKeyOf(key)
	if type(key) ~= "string" then
		return key, nil
	end
	local b = key:match("^(.*)_Light$")
	if b then
		return b, "Light"
	end
	b = key:match("^(.*)_Dark$")
	if b then
		return b, "Dark"
	end
	return key, nil
end
Voxel.BaseKey = baseKeyOf

local DEFAULT_COLOR = nil -- created lazily (Color3 may not exist when this file is parsed by tools)
local SMOOTH = nil

-- Resolves a palette key into { Color, Material, Transparency, Reflectance } (cached per call site).
local function resolveStyle(palette, key, cache)
	local st = cache[key]
	if st then
		return st
	end
	local entry = palette and palette[key]
	if entry ~= nil then
		if typeof(entry) == "Color3" then
			st = { Color = entry, Material = SMOOTH, Transparency = 0 }
		elseif type(entry) == "table" then
			st = {
				Color = entry.Color or DEFAULT_COLOR,
				Material = entry.Material or SMOOTH,
				Transparency = tonumber(entry.Transparency) or 0,
				Reflectance = tonumber(entry.Reflectance),
			}
		end
	end
	if not st then
		local base, variant = baseKeyOf(key)
		if variant then
			local b = resolveStyle(palette, base, cache)
			local color = variant == "Light" and Voxel.Lighten(b.Color) or Voxel.Darken(b.Color)
			st = { Color = color, Material = b.Material, Transparency = b.Transparency, Reflectance = b.Reflectance }
		else
			st = { Color = DEFAULT_COLOR, Material = SMOOTH, Transparency = 0 }
		end
	end
	cache[key] = st
	return st
end

local function initEnums()
	if not DEFAULT_COLOR then
		DEFAULT_COLOR = Color3.fromRGB(200, 200, 205)
		SMOOTH = Enum.Material.SmoothPlastic
	end
end

----------------------------------------------------------------------
-- Grid
----------------------------------------------------------------------
function Voxel.NewGrid(resolution)
	return { Resolution = tonumber(resolution) or 32, Cells = {}, Count = 0 }
end

function Voxel.Set(grid, x, y, z, key)
	local k = pack(x, y, z)
	local cur = grid.Cells[k]
	if key == nil then
		if cur ~= nil then
			grid.Cells[k] = nil
			grid.Count = grid.Count - 1
		end
		return
	end
	if cur == nil then
		grid.Count = grid.Count + 1
	end
	grid.Cells[k] = key
end

function Voxel.Get(grid, x, y, z)
	return grid.Cells[pack(x, y, z)]
end

function Voxel.Count(grid)
	return grid.Count
end

-- minX, minY, minZ, maxX, maxY, maxZ (nil for an empty grid)
function Voxel.Bounds(grid)
	local x0, y0, z0, x1, y1, z1 = math.huge, math.huge, math.huge, -math.huge, -math.huge, -math.huge
	local any = false
	for k in pairs(grid.Cells) do
		local x, y, z = unpack3(k)
		any = true
		if x < x0 then x0 = x end
		if y < y0 then y0 = y end
		if z < z0 then z0 = z end
		if x > x1 then x1 = x end
		if y > y1 then y1 = y end
		if z > z1 then z1 = z end
	end
	if not any then
		return nil
	end
	return x0, y0, z0, x1, y1, z1
end

function Voxel.Copy(grid)
	local g = Voxel.NewGrid(grid.Resolution)
	for k, v in pairs(grid.Cells) do
		g.Cells[k] = v
	end
	g.Count = grid.Count
	return g
end

-- Renames keys: map = { oldKey = newKey | false (remove) }.
function Voxel.Remap(grid, map)
	local cells = grid.Cells
	for k, v in pairs(cells) do
		local to = map[v]
		if to == false then
			cells[k] = nil
			grid.Count = grid.Count - 1
		elseif to ~= nil then
			cells[k] = to
		end
	end
end

-- Mirrors one half of the grid onto the other across the plane axis = 0 (axis "X" | "Y" | "Z").
-- keep = 1 copies the positive half onto the negative one (default), -1 the other way round.
function Voxel.Mirror(grid, axis, keep)
	keep = (keep == -1) and -1 or 1
	local cells = grid.Cells
	local new = {}
	local count = 0
	for k, v in pairs(cells) do
		local x, y, z = unpack3(k)
		local c = (axis == "Y" and y) or (axis == "Z" and z) or x
		if c * keep >= 0 then
			new[k] = v
			count = count + 1
			if c ~= 0 then
				local mk
				if axis == "Y" then
					mk = pack(x, -y, z)
				elseif axis == "Z" then
					mk = pack(x, y, -z)
				else
					mk = pack(-x, y, z)
				end
				new[mk] = v
				count = count + 1
			end
		end
	end
	grid.Cells = new
	grid.Count = count
end

----------------------------------------------------------------------
-- Sculpting
----------------------------------------------------------------------
local OP_ADD, OP_CARVE, OP_PAINT = 1, 2, 3

-- The per-voxel write shared by every shape kind. Returns 1 when the voxel changed.
local function makeWriter(grid, shape)
	local cells = grid.Cells
	local op = OP_ADD
	if shape.Op == "Carve" then
		op = OP_CARVE
	elseif shape.Op == "Paint" then
		op = OP_PAINT
	end
	local key = shape.Key
	local pattern = shape.Pattern
	if type(pattern) ~= "function" then
		pattern = nil
	end
	local only = toSet(shape.OnlyKeys)
	local keep = shape.KeepExisting == true
	local changed = 0
	local function write(x, y, z)
		local k = (x + OFF) + (y + OFF) * S + (z + OFF) * S2
		local cur = cells[k]
		if op == OP_CARVE then
			if cur ~= nil and (not only or only[cur]) then
				cells[k] = nil
				grid.Count = grid.Count - 1
				changed = changed + 1
			end
			return
		end
		if op == OP_PAINT then
			if cur == nil or (only and not only[cur]) then
				return
			end
		elseif keep and cur ~= nil then
			return
		end
		local v = key
		if pattern then
			local p = pattern(x, y, z, cur)
			if p == false then
				return
			elseif p ~= nil then
				v = p
			end
		end
		if v == nil or v == cur then
			return
		end
		if cur == nil then
			grid.Count = grid.Count + 1
		end
		cells[k] = v
		changed = changed + 1
	end
	return write, function()
		return changed
	end
end

-- Iterates the integer voxels of an AABB and writes those whose centre is inside (inside(lx, ly, lz) gets
-- the sample point in the shape's unrotated frame).
local function rasterize(write, bx0, by0, bz0, bx1, by1, bz1, R, pvx, pvy, pvz, inside)
	local x0, y0, z0 = ceil(bx0 - 1e-6), ceil(by0 - 1e-6), ceil(bz0 - 1e-6)
	local x1, y1, z1 = floor(bx1 + 1e-6), floor(by1 + 1e-6), floor(bz1 + 1e-6)
	if R then
		-- local = pivot + R^T (p - pivot)
		local r00, r01, r02, r10, r11, r12, r20, r21, r22 = R[1], R[2], R[3], R[4], R[5], R[6], R[7], R[8], R[9]
		for z = z0, z1 do
			local dz = z - pvz
			for y = y0, y1 do
				local dy = y - pvy
				for x = x0, x1 do
					local dx = x - pvx
					local lx = pvx + r00 * dx + r10 * dy + r20 * dz
					local ly = pvy + r01 * dx + r11 * dy + r21 * dz
					local lz = pvz + r02 * dx + r12 * dy + r22 * dz
					if inside(lx, ly, lz) then
						write(x, y, z)
					end
				end
			end
		end
	else
		for z = z0, z1 do
			for y = y0, y1 do
				for x = x0, x1 do
					if inside(x, y, z) then
						write(x, y, z)
					end
				end
			end
		end
	end
end

-- World AABB of a box of half extents (hx, hy, hz) centred on (cx, cy, cz) in the unrotated frame.
local function rotatedBounds(R, pvx, pvy, pvz, cx, cy, cz, hx, hy, hz)
	if not R then
		return cx - hx, cy - hy, cz - hz, cx + hx, cy + hy, cz + hz
	end
	local wx, wy, wz = rotatePoint(R, pvx, pvy, pvz, cx, cy, cz)
	local ex = abs(R[1]) * hx + abs(R[2]) * hy + abs(R[3]) * hz
	local ey = abs(R[4]) * hx + abs(R[5]) * hy + abs(R[6]) * hz
	local ez = abs(R[7]) * hx + abs(R[8]) * hy + abs(R[9]) * hz
	return wx - ex, wy - ey, wz - ez, wx + ex, wy + ey, wz + ez
end

-- One tapered capsule segment in world coordinates.
local function capsule(write, ax, ay, az, bx, by, bz, ra, rb, bias)
	local abx, aby, abz = bx - ax, by - ay, bz - az
	local len2 = abx * abx + aby * aby + abz * abz
	local rm = max(ra, rb) + bias
	local x0, y0, z0 = ceil(min(ax, bx) - rm - 1e-6), ceil(min(ay, by) - rm - 1e-6), ceil(min(az, bz) - rm - 1e-6)
	local x1, y1, z1 = floor(max(ax, bx) + rm + 1e-6), floor(max(ay, by) + rm + 1e-6), floor(max(az, bz) + rm + 1e-6)
	local dr = rb - ra
	for z = z0, z1 do
		local pz = z - az
		for y = y0, y1 do
			local py = y - ay
			for x = x0, x1 do
				local px = x - ax
				local t = 0
				if len2 > 1e-9 then
					t = (px * abx + py * aby + pz * abz) / len2
					if t < 0 then
						t = 0
					elseif t > 1 then
						t = 1
					end
				end
				local qx, qy, qz = px - abx * t, py - aby * t, pz - abz * t
				local r = ra + dr * t + bias
				if qx * qx + qy * qy + qz * qz <= r * r then
					write(x, y, z)
				end
			end
		end
	end
end

-- Catmull-Rom samples through the control points; returns parallel arrays of points and radii.
local function curveSamples(pts, radii, steps, smooth)
	local n = #pts
	local outP, outR = {}, {}
	if n == 1 or not smooth then
		for i = 1, n do
			outP[i] = pts[i]
			outR[i] = radii[i]
		end
		return outP, outR
	end
	for i = 1, n - 1 do
		local p0 = pts[max(1, i - 1)]
		local p1 = pts[i]
		local p2 = pts[i + 1]
		local p3 = pts[min(n, i + 2)]
		local r1, r2 = radii[i], radii[i + 1]
		local first = (i == 1) and 0 or 1
		for s = first, steps do
			local t = s / steps
			local t2, t3 = t * t, t * t * t
			local a = -0.5 * t3 + t2 - 0.5 * t
			local b = 1.5 * t3 - 2.5 * t2 + 1
			local c = -1.5 * t3 + 2 * t2 + 0.5 * t
			local d = 0.5 * t3 - 0.5 * t2
			outP[#outP + 1] = {
				a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1],
				a * p0[2] + b * p1[2] + c * p2[2] + d * p3[2],
				a * p0[3] + b * p1[3] + c * p2[3] + d * p3[3],
			}
			outR[#outR + 1] = r1 + (r2 - r1) * t
		end
	end
	return outP, outR
end

local KINDS = {}

KINDS.Ellipsoid = function(shape, write, R, bias)
	local cx, cy, cz = vec(shape.Center)
	local rx, ry, rz = vec(shape.Radius or 1)
	rx, ry, rz = max(rx, 0.01) + bias, max(ry, 0.01) + bias, max(rz, 0.01) + bias
	local pvx, pvy, pvz = vec(shape.Pivot, cx, cy, cz)
	local ix, iy, iz = 1 / (rx * rx), 1 / (ry * ry), 1 / (rz * rz)
	local x0, y0, z0, x1, y1, z1
	if R then
		-- exact AABB of a rotated ellipsoid
		local wx, wy, wz = rotatePoint(R, pvx, pvy, pvz, cx, cy, cz)
		local ex = sqrt((R[1] * rx) ^ 2 + (R[2] * ry) ^ 2 + (R[3] * rz) ^ 2)
		local ey = sqrt((R[4] * rx) ^ 2 + (R[5] * ry) ^ 2 + (R[6] * rz) ^ 2)
		local ez = sqrt((R[7] * rx) ^ 2 + (R[8] * ry) ^ 2 + (R[9] * rz) ^ 2)
		x0, y0, z0, x1, y1, z1 = wx - ex, wy - ey, wz - ez, wx + ex, wy + ey, wz + ez
	else
		x0, y0, z0, x1, y1, z1 = cx - rx, cy - ry, cz - rz, cx + rx, cy + ry, cz + rz
	end
	rasterize(write, x0, y0, z0, x1, y1, z1, R, pvx, pvy, pvz, function(x, y, z)
		local dx, dy, dz = x - cx, y - cy, z - cz
		return dx * dx * ix + dy * dy * iy + dz * dz * iz <= 1
	end)
end

KINDS.Box = function(shape, write, R, bias)
	local cx, cy, cz = vec(shape.Center)
	local sx, sy, sz = vec(shape.Size or 1)
	local hx, hy, hz = sx * 0.5 + bias - 1e-4, sy * 0.5 + bias - 1e-4, sz * 0.5 + bias - 1e-4
	local pvx, pvy, pvz = vec(shape.Pivot, cx, cy, cz)
	local x0, y0, z0, x1, y1, z1 = rotatedBounds(R, pvx, pvy, pvz, cx, cy, cz, hx, hy, hz)
	rasterize(write, x0, y0, z0, x1, y1, z1, R, pvx, pvy, pvz, function(x, y, z)
		return abs(x - cx) <= hx and abs(y - cy) <= hy and abs(z - cz) <= hz
	end)
end

KINDS.RoundBox = function(shape, write, R, bias)
	local cx, cy, cz = vec(shape.Center)
	local sx, sy, sz = vec(shape.Size or 1)
	local hx, hy, hz = sx * 0.5, sy * 0.5, sz * 0.5
	local r = tonumber(shape.Round) or 1
	r = max(0, min(r, hx, hy, hz))
	local ix, iy, iz = hx - r, hy - r, hz - r
	local pvx, pvy, pvz = vec(shape.Pivot, cx, cy, cz)
	local x0, y0, z0, x1, y1, z1 = rotatedBounds(R, pvx, pvy, pvz, cx, cy, cz, hx + bias, hy + bias, hz + bias)
	local lim = r + bias - 1e-4
	rasterize(write, x0, y0, z0, x1, y1, z1, R, pvx, pvy, pvz, function(x, y, z)
		local qx, qy, qz = abs(x - cx) - ix, abs(y - cy) - iy, abs(z - cz) - iz
		local ox, oy, oz = max(qx, 0), max(qy, 0), max(qz, 0)
		local d = sqrt(ox * ox + oy * oy + oz * oz) + min(max(qx, qy, qz), 0)
		return d <= lim
	end)
end

KINDS.Torus = function(shape, write, R, bias)
	local cx, cy, cz = vec(shape.Center)
	local ring = tonumber(shape.Radius) or 4
	local th = tonumber(shape.Thickness) or 1
	local thB = tonumber(shape.ThicknessB) or th
	local pvx, pvy, pvz = vec(shape.Pivot, cx, cy, cz)
	local a0, a1 = nil, nil
	if type(shape.Arc) == "table" then
		a0, a1 = tonumber(shape.Arc[1]) or 0, tonumber(shape.Arc[2]) or TAU
	end
	local tm = max(th, thB) + bias
	local x0, y0, z0, x1, y1, z1 = rotatedBounds(R, pvx, pvy, pvz, cx, cy, cz, ring + tm, tm, ring + tm)
	rasterize(write, x0, y0, z0, x1, y1, z1, R, pvx, pvy, pvz, function(x, y, z)
		local dx, dy, dz = x - cx, y - cy, z - cz
		local u = 0
		if a0 then
			local ang = atan2(dz, dx)
			local rel = (ang - a0) % TAU
			local span = a1 - a0
			if rel > span + 1e-9 then
				return false
			end
			if span > 1e-9 then
				u = rel / span
			end
		end
		local q = sqrt(dx * dx + dz * dz) - ring
		local t = th + (thB - th) * u + bias
		return q * q + dy * dy <= t * t
	end)
end

KINDS.Cone = function(shape, write, R, bias)
	local ax, ay, az = vec(shape.A)
	local bx, by, bz = vec(shape.B, ax, ay + 4, az)
	local pvx, pvy, pvz = vec(shape.Pivot, ax, ay, az)
	if R then
		ax, ay, az = rotatePoint(R, pvx, pvy, pvz, ax, ay, az)
		bx, by, bz = rotatePoint(R, pvx, pvy, pvz, bx, by, bz)
	end
	local ra = tonumber(shape.Radius) or 2
	local rb = tonumber(shape.RadiusB) or 0
	local abx, aby, abz = bx - ax, by - ay, bz - az
	local len2 = abx * abx + aby * aby + abz * abz
	if len2 < 1e-9 then
		return
	end
	local rm = max(ra, rb) + bias
	rasterize(write, min(ax, bx) - rm, min(ay, by) - rm, min(az, bz) - rm, max(ax, bx) + rm, max(ay, by) + rm, max(az, bz) + rm, nil, 0, 0, 0, function(x, y, z)
		local px, py, pz = x - ax, y - ay, z - az
		local t = (px * abx + py * aby + pz * abz) / len2
		if t < -1e-6 or t > 1 + 1e-6 then
			return false
		end
		local qx, qy, qz = px - abx * t, py - aby * t, pz - abz * t
		local r = ra + (rb - ra) * t + bias
		return qx * qx + qy * qy + qz * qz <= r * r
	end)
end

KINDS.Capsule = function(shape, write, R, bias)
	local ax, ay, az = vec(shape.A)
	local bx, by, bz = vec(shape.B, ax, ay, az)
	local pvx, pvy, pvz = vec(shape.Pivot, ax, ay, az)
	if R then
		ax, ay, az = rotatePoint(R, pvx, pvy, pvz, ax, ay, az)
		bx, by, bz = rotatePoint(R, pvx, pvy, pvz, bx, by, bz)
	end
	local ra = tonumber(shape.Radius) or 1
	local rb = tonumber(shape.RadiusB) or ra
	capsule(write, ax, ay, az, bx, by, bz, ra, rb, bias)
end

KINDS.Curve = function(shape, write, R, bias)
	local src = shape.Points
	if type(src) ~= "table" or #src == 0 then
		return
	end
	local pts = {}
	for i = 1, #src do
		local x, y, z = vec(src[i])
		pts[i] = { x, y, z }
	end
	local pvx, pvy, pvz = vec(shape.Pivot, pts[1][1], pts[1][2], pts[1][3])
	if R then
		for i = 1, #pts do
			local p = pts[i]
			p[1], p[2], p[3] = rotatePoint(R, pvx, pvy, pvz, p[1], p[2], p[3])
		end
	end
	local radii = {}
	local n = #pts
	local r0 = tonumber(shape.Radius) or 1
	local r1 = tonumber(shape.RadiusB) or r0
	for i = 1, n do
		if type(shape.Radii) == "table" and tonumber(shape.Radii[i]) then
			radii[i] = tonumber(shape.Radii[i])
		elseif n > 1 then
			radii[i] = r0 + (r1 - r0) * (i - 1) / (n - 1)
		else
			radii[i] = r0
		end
	end
	local steps = max(1, floor(tonumber(shape.Steps) or 6))
	local sp, sr = curveSamples(pts, radii, steps, shape.Smooth ~= false)
	if #sp == 1 then
		local p = sp[1]
		capsule(write, p[1], p[2], p[3], p[1], p[2], p[3], sr[1], sr[1], bias)
		return
	end
	for i = 1, #sp - 1 do
		local a, b = sp[i], sp[i + 1]
		capsule(write, a[1], a[2], a[3], b[1], b[2], b[3], sr[i], sr[i + 1], bias)
	end
end

local DEFAULT_BIAS = { Ellipsoid = 0.25, Capsule = 0.25, Cone = 0.25, Torus = 0.25, Curve = 0.25, RoundBox = 0.25, Box = 0 }

-- Sculpts one shape into the grid. Returns the number of voxels that changed.
function Voxel.Shape(grid, shape)
	if type(grid) ~= "table" or type(shape) ~= "table" then
		return 0
	end
	local kind = KINDS[shape.Kind or "Ellipsoid"]
	if not kind then
		warn("[Voxel] unknown shape kind " .. tostring(shape.Kind))
		return 0
	end
	local bias = tonumber(shape.Bias) or DEFAULT_BIAS[shape.Kind or "Ellipsoid"] or 0
	local write, changed = makeWriter(grid, shape)
	kind(shape, write, rotationOf(shape.Rotation), bias)
	return changed()
end

----------------------------------------------------------------------
-- Shading
----------------------------------------------------------------------
-- Offsets of the normal estimator: every neighbour within 2 voxels (weighted 1/d^2).
-- The same neighbourhood measures "openness": the share of it that is empty (about 0.32 on a flat surface,
-- more on convex bumps, much less in concave creases).
local NEIGH26 = {}
do
	for dz = -1, 1 do
		for dy = -1, 1 do
			for dx = -1, 1 do
				if dx ~= 0 or dy ~= 0 or dz ~= 0 then
					NEIGH26[#NEIGH26 + 1] = dx + dy * S + dz * S2
				end
			end
		end
	end
end
local NORMAL_K, NORMAL_X, NORMAL_Y, NORMAL_Z = {}, {}, {}, {}
local NORMAL_TOTAL = 0
do
	for dz = -2, 2 do
		for dy = -2, 2 do
			for dx = -2, 2 do
				local d2 = dx * dx + dy * dy + dz * dz
				if d2 > 0 and d2 <= 4.1 then
					NORMAL_TOTAL = NORMAL_TOTAL + 1
					NORMAL_K[NORMAL_TOTAL] = dx + dy * S + dz * S2
					NORMAL_X[NORMAL_TOTAL] = dx / d2
					NORMAL_Y[NORMAL_TOTAL] = dy / d2
					NORMAL_Z[NORMAL_TOTAL] = dz / d2
				end
			end
		end
	end
end

-- Assigns shade variants. opts (all optional):
--   LightDir = vector (default straight up), LightAt = 0.55 (normal . LightDir at or above -> _Light),
--   DarkAt = -0.35 (at or below -> _Dark), Crease = 0.22 (exposed voxels whose 2-voxel neighbourhood is at most
--   this empty sit in a crease -> _Dark; a flat surface is ~0.31), Light = false / Dark = false (disable one),
--   Smooth = 1 (passes that give isolated voxels the shade of their neighbours: cleaner bands, fewer parts),
--   Skip = {key = true} | {key, ...} (never shaded, e.g. eyes), Only = keys to shade,
--   Noise = 0..1 (fraction of voxels nudged one shade up / down, deterministic), Seed = n
function Voxel.Shade(grid, opts)
	opts = opts or {}
	local cells = grid.Cells
	local lx, ly, lz = vec(opts.LightDir, 0, 1, 0)
	local ll = sqrt(lx * lx + ly * ly + lz * lz)
	if ll < 1e-6 then
		lx, ly, lz, ll = 0, 1, 0, 1
	end
	lx, ly, lz = lx / ll, ly / ll, lz / ll
	local lightAt = tonumber(opts.LightAt) or 0.55
	local darkAt = tonumber(opts.DarkAt) or -0.35
	local crease = tonumber(opts.Crease) or 0.22
	local useLight = opts.Light ~= false
	local useDark = opts.Dark ~= false
	local passes = tonumber(opts.Smooth) or 1
	local skip = toSet(opts.Skip) or {}
	local only = toSet(opts.Only)
	local noise = tonumber(opts.Noise) or 0
	local seed = tonumber(opts.Seed) or 0
	local shadeable = {} -- per key: may it be shaded?
	local OK, OX, OY, OZ = NORMAL_K, NORMAL_X, NORMAL_Y, NORMAL_Z

	-- 1) shade of every exposed voxel from its estimated normal and how open its neighbourhood is
	local shade = {}
	local list = {}
	for k, v in pairs(cells) do
		local can = shadeable[v]
		if can == nil then
			local _, variant = baseKeyOf(v)
			can = not variant and not skip[v] and (not only or only[v]) and true or false
			shadeable[v] = can
		end
		if can then
			local exposed = false
			for i = 1, 6 do
				if cells[k + FACE[i]] == nil then
					exposed = true
					break
				end
			end
			if exposed then
				local nx, ny, nz = 0, 0, 0
				local empty = 0
				for i = 1, NORMAL_TOTAL do
					if cells[k + OK[i]] == nil then
						nx, ny, nz = nx + OX[i], ny + OY[i], nz + OZ[i]
						empty = empty + 1
					end
				end
				local nl = sqrt(nx * nx + ny * ny + nz * nz)
				local sh = 0
				if nl > 1e-6 then
					local d = (nx * lx + ny * ly + nz * lz) / nl
					if d >= lightAt and useLight then
						sh = 1
					elseif d <= darkAt and useDark then
						sh = -1
					end
				end
				if empty / NORMAL_TOTAL <= crease and useDark then
					sh = -1
				end
				shade[k] = sh
				list[#list + 1] = k
			end
		end
	end
	table.sort(list)

	-- 2) smoothing: a voxel that agrees with fewer than 2 of its same-colour surface neighbours takes their
	--    most common shade (Jacobi passes, so the result does not depend on iteration order)
	for _ = 1, passes do
		local nextShade = {}
		local changed = false
		for i = 1, #list do
			local k = list[i]
			local v = cells[k]
			local own = shade[k]
			local same, cl, c0, cd = 0, 0, 0, 0
			for j = 1, 26 do
				local nk = k + NEIGH26[j]
				local ns = shade[nk]
				if ns ~= nil and cells[nk] == v then
					if ns == own then
						same = same + 1
					end
					if ns > 0 then
						cl = cl + 1
					elseif ns < 0 then
						cd = cd + 1
					else
						c0 = c0 + 1
					end
				end
			end
			local new = own
			if same < 2 and cl + c0 + cd > 0 then
				if c0 >= cl and c0 >= cd then
					new = 0
				elseif cl >= cd then
					new = 1
				else
					new = -1
				end
			end
			nextShade[k] = new
			if new ~= own then
				changed = true
			end
		end
		shade = nextShade
		if not changed then
			break
		end
	end

	-- 3) optional speckle, then write the variants
	local nLight, nDark = 0, 0
	for i = 1, #list do
		local k = list[i]
		local sh = shade[k]
		if noise > 0 then
			local x, y, z = unpack3(k)
			local h = Voxel.Hash(x, y, z, seed)
			if h < noise * 0.5 then
				sh = sh + 1
			elseif h < noise then
				sh = sh - 1
			end
			if sh > 1 or (sh > 0 and not useLight) then
				sh = useLight and 1 or 0
			elseif sh < -1 or (sh < 0 and not useDark) then
				sh = useDark and -1 or 0
			end
		end
		if sh > 0 then
			cells[k] = cells[k] .. "_Light"
			nLight = nLight + 1
		elseif sh < 0 then
			cells[k] = cells[k] .. "_Dark"
			nDark = nDark + 1
		end
	end
	return nLight, nDark
end

----------------------------------------------------------------------
-- Greedy merge
----------------------------------------------------------------------
-- growth orders tried per box (the best one wins); two orders get within ~1% of all six at a third of the cost
local ORDERS = { { 2, 1, 3 }, { 1, 3, 2 } }
local BRIDGE_CELLS = 160 -- zero-gain cells a growing box may look through after its last gain

-- Opacity / overlap rules from the palette (no palette: everything opaque and overlappable).
local function makeRules(palette)
	initEnums()
	local cache = {}
	local opaque, overlap = {}, {}
	local NEON = Enum.Material.Neon
	local function info(key)
		local o = opaque[key]
		if o == nil then
			if palette then
				local st = resolveStyle(palette, key, cache)
				o = (st.Transparency or 0) <= 0.001
				overlap[key] = o and (st.Material == SMOOTH or st.Material == NEON)
			else
				o = true
				overlap[key] = true
			end
			opaque[key] = o
		end
		return o, overlap[key]
	end
	return info, cache
end

-- The voxels a merge must cover (sorted, so the result is deterministic) and the hidden ones (opaque voxels
-- boxed in by opaque voxels on all 6 faces). Key remaps of the LOD keep opacity, so this is computed once.
local function prepare(cells, info)
	local hidden = {}
	local list = {}
	local n = 0
	for k, v in pairs(cells) do
		local enclosed = false
		if info(v) then
			enclosed = true
			for f = 1, 6 do
				local nv = cells[k + FACE[f]]
				if nv == nil or not info(nv) then
					enclosed = false
					break
				end
			end
		end
		if enclosed then
			hidden[k] = true
		else
			n = n + 1
			list[n] = k
		end
	end
	table.sort(list)
	return { List = list, Hidden = hidden }
end

local function mergeCells(cells, info, prep)
	prep = prep or prepare(cells, info)
	local orders = ORDERS
	local list = prep.List
	local n = #list
	local hidden = prep.Hidden

	local covered = {}
	local boxes = {}
	local lo, hi = { 0, 0, 0 }, { 0, 0, 0 }
	local bestLo, bestHi = { 0, 0, 0 }, { 0, 0, 0 }
	local key, canHidden, canOverlap

	-- Grows the current box (lo / hi) along one axis in both directions, one slab at a time, while every voxel
	-- of the new slab is acceptable (same key and not yet covered, or covered and overlappable, or hidden and
	-- the key is opaque). Trailing slabs that added nothing are trimmed again. Bridging through hidden or covered
	-- voxels is allowed for a limited number of looked-at cells after the last useful slab (long thin bridges
	-- are cheap and often pay off; huge empty faces rarely do). Returns the number of newly covered voxels.
	-- (The slab scan is written out inline: this is the hot loop of every voxel model.)
	local function growAxis(axis)
		local a, b
		if axis == 1 then
			a, b = 2, 3
		elseif axis == 2 then
			a, b = 1, 3
		else
			a, b = 1, 2
		end
		local sa, sb, sc = STR[a], STR[b], STR[axis]
		local a0, a1, b0, b1 = lo[a], hi[a], lo[b], hi[b]
		local cost = (a1 - a0 + 1) * (b1 - b0 + 1)
		local k, hid, cov, cel = key, hidden, covered, cells
		local okHidden, okOverlap = canHidden, canOverlap
		local gained = 0
		local ends = { lo[axis], hi[axis] }
		local last = { ends[1], ends[2] }
		for dir = 1, 2 do
			local step = (dir == 1) and -1 or 1
			local c = ends[dir]
			local idle = 0
			while true do
				local nc = c + step
				local base = (nc + OFF) * sc
				local gain = 0
				local ok = true
				for i = a0, a1 do
					local row = base + (i + OFF) * sa
					for j = b0, b1 do
						local p = row + (j + OFF) * sb
						local v = cel[p]
						if v == k then
							if hid[p] then
								if not okHidden then
									ok = false
									break
								end
							elseif cov[p] then
								if not okOverlap then
									ok = false
									break
								end
							else
								gain = gain + 1
							end
						elseif not (okHidden and v ~= nil and hid[p]) then
							ok = false
							break
						end
					end
					if not ok then
						break
					end
				end
				if not ok then
					break
				end
				c = nc
				if gain > 0 then
					last[dir] = c
					gained = gained + gain
					idle = 0
				else
					idle = idle + cost
					if idle > BRIDGE_CELLS then
						break
					end
				end
			end
		end
		lo[axis], hi[axis] = last[1], last[2]
		return gained
	end

	for i = 1, n do
		local k = list[i]
		if not covered[k] then
			key = cells[k]
			local o, ov = info(key)
			canHidden = o
			canOverlap = ov
			local sx, sy, sz = unpack3(k)
			local best = -1
			for oi = 1, #orders do
				local order = orders[oi]
				lo[1], lo[2], lo[3] = sx, sy, sz
				hi[1], hi[2], hi[3] = sx, sy, sz
				local gain = 1 + growAxis(order[1]) + growAxis(order[2]) + growAxis(order[3])
				if gain > best then
					best = gain
					bestLo[1], bestLo[2], bestLo[3] = lo[1], lo[2], lo[3]
					bestHi[1], bestHi[2], bestHi[3] = hi[1], hi[2], hi[3]
				end
			end
			-- claim the box
			for z = bestLo[3], bestHi[3] do
				for y = bestLo[2], bestHi[2] do
					local row = (y + OFF) * S + (z + OFF) * S2 + OFF
					for x = bestLo[1], bestHi[1] do
						local p = row + x
						if cells[p] == key and not hidden[p] then
							covered[p] = true
						end
					end
				end
			end
			boxes[#boxes + 1] = {
				X0 = bestLo[1], Y0 = bestLo[2], Z0 = bestLo[3],
				X1 = bestHi[1], Y1 = bestHi[2], Z1 = bestHi[3],
				Key = key, Count = best,
			}
		end
	end
	return boxes
end

-- Copy of cells with keys renamed through map (keys missing in map stay).
local function remapped(cells, map)
	local out = {}
	for k, v in pairs(cells) do
		out[k] = map[v] or v
	end
	return out
end

-- Colour-cluster LOD tier: keys whose colours are within `tol` (and share material / transparency) collapse
-- into the key with the most voxels.
local function clusterMap(cells, palette, cache, tol)
	local counts = {}
	for _, v in pairs(cells) do
		counts[v] = (counts[v] or 0) + 1
	end
	local keys = {}
	for v in pairs(counts) do
		keys[#keys + 1] = v
	end
	table.sort(keys, function(a, b)
		if counts[a] ~= counts[b] then
			return counts[a] > counts[b]
		end
		return tostring(a) < tostring(b)
	end)
	local reps = {}
	local map = {}
	for _, v in ipairs(keys) do
		local st = resolveStyle(palette, v, cache)
		local target = nil
		for _, r in ipairs(reps) do
			local rs = r.St
			if rs.Material == st.Material and abs((rs.Transparency or 0) - (st.Transparency or 0)) < 0.05 then
				local c1, c2 = rs.Color, st.Color
				local d = sqrt((c1.R - c2.R) ^ 2 + (c1.G - c2.G) ^ 2 + (c1.B - c2.B) ^ 2)
				if d <= tol then
					target = r.Key
					break
				end
			end
		end
		if target then
			map[v] = target
		else
			reps[#reps + 1] = { Key = v, St = st }
		end
	end
	return map
end

-- The greedy merge (see the header). opts: Palette (opacity, overlap and colours for the LOD), MaxParts,
-- Keep = {key = true} | {key, ...} (keys the LOD never recolours, e.g. eyes). Returns { {X0, Y0, Z0, X1, Y1, Z1,
-- Key, Count}, ... } with inclusive voxel ranges.
function Voxel.Merge(grid, opts)
	opts = opts or {}
	local cells = grid.Cells or grid
	local palette = opts.Palette
	local info, cache = makeRules(palette)
	local prep = prepare(cells, info)
	local boxes = mergeCells(cells, info, prep)
	local maxParts = tonumber(opts.MaxParts)
	if not maxParts or #boxes <= maxParts then
		return boxes
	end
	local keep = toSet(opts.Keep) or {}
	local work = cells

	-- LOD step 1: fold shade variants back into their base colour, the least efficient ones first (the most
	-- boxes per voxel: small scattered shade patches go before the broad highlight on top of a head), a few
	-- keys at a time, until the estimated saving covers the overshoot.
	for _ = 1, 6 do
		local nBoxes, nVox = {}, {}
		for _, b in ipairs(boxes) do
			nBoxes[b.Key] = (nBoxes[b.Key] or 0) + 1
		end
		for _, v in pairs(work) do
			nVox[v] = (nVox[v] or 0) + 1
		end
		local cands = {}
		for key, nb in pairs(nBoxes) do
			local base, variant = baseKeyOf(key)
			if variant and not keep[key] then
				cands[#cands + 1] = { Key = key, Base = base, Boxes = nb, Ratio = nb / max(nVox[key] or 1, 1) }
			end
		end
		if #cands == 0 then
			break
		end
		table.sort(cands, function(a, b)
			if a.Ratio ~= b.Ratio then
				return a.Ratio > b.Ratio
			end
			return a.Key < b.Key
		end)
		local need = (#boxes - maxParts) * 1.25
		local saved = 0
		local map = {}
		for _, c in ipairs(cands) do
			map[c.Key] = c.Base
			saved = saved + c.Boxes * 0.5
			if saved >= need then
				break
			end
		end
		work = remapped(work, map)
		boxes = mergeCells(work, info, prep)
		if #boxes <= maxParts then
			return boxes
		end
	end

	-- LOD step 2: ever more different colours together (same material and transparency only)
	if palette then
		for _, tol in ipairs({ 0.06, 0.12, 0.2, 0.3, 0.45 }) do
			local map = clusterMap(work, palette, cache, tol)
			for k in pairs(keep) do
				map[k] = nil
			end
			if next(map) ~= nil then
				work = remapped(work, map)
				boxes = mergeCells(work, info, prep)
				if #boxes <= maxParts then
					return boxes
				end
			end
		end
	end
	return boxes
end

----------------------------------------------------------------------
-- Parts
----------------------------------------------------------------------
-- Mirrors a box list across x = 0 (exact mirror image of the parts, unlike merging a mirrored grid).
function Voxel.MirrorBoxes(boxes)
	local out = {}
	for i, b in ipairs(boxes) do
		out[i] = { X0 = -b.X1, X1 = -b.X0, Y0 = b.Y0, Y1 = b.Y1, Z0 = b.Z0, Z1 = b.Z1, Key = b.Key, Count = b.Count }
	end
	return out
end

local function applyCommon(part, opts)
	part.Anchored = opts.Anchored ~= false
	part.CanCollide = opts.CanCollide == true
	part.CanTouch = opts.CanTouch == true
	part.CanQuery = opts.CanQuery == true
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

-- Creates the parts of a box list. Same opts as Build (VoxelSize, Palette, CFrame, Offset, Anchored, ...);
-- opts.Model = an existing Model to add to. Returns model, parts (parts[i] is boxes[i]).
function Voxel.BuildBoxes(boxes, opts)
	initEnums()
	opts = opts or {}
	local vs = tonumber(opts.VoxelSize) or 1
	local palette = opts.Palette or {}
	local cache = {}
	local origin = opts.CFrame or opts.Origin or CFrame.new()
	local ox, oy, oz = vec(opts.Offset, 0, 0, 0)
	local shadowSize = tonumber(opts.ShadowSize) or 4
	local unique = opts.UniqueNames == true
	local nameOf = opts.NameOf
	local model = opts.Model
	if not model then
		model = Instance.new("Model")
		model.Name = opts.Name or "Voxels"
	end
	local used = {}
	local parts = {}
	for i, b in ipairs(boxes) do
		local st = resolveStyle(palette, b.Key, cache)
		local sx, sy, sz = (b.X1 - b.X0 + 1) * vs, (b.Y1 - b.Y0 + 1) * vs, (b.Z1 - b.Z0 + 1) * vs
		local cx = ((b.X0 + b.X1) * 0.5 - ox) * vs
		local cy = ((b.Y0 + b.Y1) * 0.5 - oy) * vs
		local cz = ((b.Z0 + b.Z1) * 0.5 - oz) * vs
		local part = Instance.new("Part")
		local name = nil
		if type(nameOf) == "function" then
			name = nameOf(b.Key, b)
		end
		if type(name) ~= "string" then
			name = tostring((baseKeyOf(b.Key)))
		end
		if unique then
			local c = (used[name] or 0) + 1
			used[name] = c
			if c > 1 then
				name = name .. c
			end
		end
		part.Name = name
		applyCommon(part, opts)
		if opts.CastShadow ~= nil then
			part.CastShadow = opts.CastShadow == true
		else
			part.CastShadow = max(sx, sy, sz) >= shadowSize
		end
		part.Material = st.Material or SMOOTH
		part.Color = st.Color or DEFAULT_COLOR
		part.Transparency = st.Transparency or 0
		if st.Reflectance then
			part.Reflectance = st.Reflectance
		end
		part.Size = Vector3.new(sx, sy, sz)
		part.CFrame = origin * CFrame.new(cx, cy, cz)
		part.Parent = model
		parts[i] = part
	end
	return model, parts
end

-- Builds a Model of box Parts from the grid. opts:
--   VoxelSize = studs per voxel (default: opts.Height / grid.Resolution, else 1)
--   Palette = { key -> Color3 | {Color, Material, Transparency, Reflectance} }
--   Name, Parent, CFrame (where voxel 0,0,0 sits; default identity), Offset = voxel point placed at the CFrame,
--   Center = true (Offset = the centre of the grid's bounds), Anchored (default true), CanCollide / CanTouch /
--   CanQuery (default false), CastShadow (default: only parts >= ShadowSize = 4 studs), UniqueNames,
--   NameOf = fn(key, box) -> name, PrimaryKey (PrimaryPart = the biggest part of that key; default: biggest
--   part), MaxParts + Keep (LOD, see Merge)
-- Returns model, parts, boxes.
function Voxel.Build(grid, opts)
	initEnums()
	opts = opts or {}
	local o = {}
	for k, v in pairs(opts) do
		o[k] = v
	end
	if not tonumber(o.VoxelSize) then
		local h = tonumber(o.Height)
		if h and grid.Resolution and grid.Resolution > 0 then
			o.VoxelSize = h / grid.Resolution
		else
			o.VoxelSize = 1
		end
	end
	if o.Center and o.Offset == nil then
		local x0, y0, z0, x1, y1, z1 = Voxel.Bounds(grid)
		if x0 then
			o.Offset = { (x0 + x1) * 0.5, (y0 + y1) * 0.5, (z0 + z1) * 0.5 }
		end
	end
	local boxes = Voxel.Merge(grid, { Palette = o.Palette, MaxParts = o.MaxParts, Keep = o.Keep })
	local parent = o.Parent
	o.Parent = nil
	local model, parts = Voxel.BuildBoxes(boxes, o)
	-- PrimaryPart: the biggest part (of PrimaryKey when given)
	local best, bestVol = nil, -1
	for i, part in ipairs(parts) do
		local b = boxes[i]
		local base = baseKeyOf(b.Key)
		if o.PrimaryKey == nil or base == o.PrimaryKey or b.Key == o.PrimaryKey then
			local vol = (b.X1 - b.X0 + 1) * (b.Y1 - b.Y0 + 1) * (b.Z1 - b.Z0 + 1)
			if vol > bestVol then
				best, bestVol = part, vol
			end
		end
	end
	if not best and parts[1] then
		best = parts[1]
	end
	if best then
		model.PrimaryPart = best
	end
	if parent then
		model.Parent = parent
	end
	return model, parts, boxes
end

-- One block for world building. cframe: CFrame (or Vector3 position); size: Vector3 (or number for a cube).
-- Defaults: Anchored, CanCollide / CanTouch / CanQuery false, SmoothPlastic, CastShadow only when >= 4 studs.
-- props: any Part properties to override (e.g. { CanCollide = true, Name = "Path", Transparency = 0.4 }).
function Voxel.Box(parent, cframe, size, color, material, props)
	initEnums()
	local part = Instance.new("Part")
	part.Name = "Voxel"
	applyCommon(part, {})
	if type(size) == "number" then
		size = Vector3.new(size, size, size)
	end
	if size == nil then
		size = Vector3.new(1, 1, 1)
	end
	part.Size = size
	part.CastShadow = max(size.X, size.Y, size.Z) >= 4
	part.Material = material or SMOOTH
	if color then
		part.Color = color
	end
	if cframe ~= nil then
		if typeof(cframe) == "Vector3" then
			part.CFrame = CFrame.new(cframe)
		else
			part.CFrame = cframe
		end
	end
	if type(props) == "table" then
		for k, v in pairs(props) do
			local ok, err = pcall(function()
				part[k] = v
			end)
			if not ok then
				warn("[Voxel] Box: cannot set " .. tostring(k) .. ": " .. tostring(err))
			end
		end
	end
	if parent then
		part.Parent = parent
	end
	return part
end

return Voxel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="828">
        <Properties>
          <string name="Name">WorldStyle</string>
          <string name="Source"><![CDATA[-- WorldStyle: the shared art kit of the world (ARCHITECTURE_V3.md "Phase 6" 6.0.2 / 6.0.3 / 6.1 A1, docs/phase6/style.md
-- section 4). Phase 6 = the Phase 4 look again (7aa0df2): bright, cute, colourful voxels in SmoothPlastic, the P4
-- palette (lime grass, cream stone paths, white / light-blue clouds), no realistic textures and no round primitives.
-- Glow stays Neon (gate rings, swirls, gems, lanterns, inlays); water may be Glass. The Part builds here are the
-- fallback + colliders until the Blender meshes (wave 2) dress them. Every world builder (LobbyBuilder, HomeBuilder,
-- ArenaBuilder, DungeonBuilder) builds with these pieces so the world reads as one place. Usable on the server and
-- the client (pure part building; no services, no remotes). Plain Lua 5.1-compatible syntax only.
--
--   WorldStyle.Materials                      name -> Enum.Material. The P4 look: SmoothPlastic for every surface,
--       Neon for glow, Glass for water. The Phase 5 names (Slate, Cobblestone, Brick, Marble, WoodPlanks, Wood, Grass,
--       LeafyGrass, Sand, ClayRoofTiles, RoofShingles, Metal, Fabric) stay as aliases of SmoothPlastic and ForceField
--       as an alias of Neon, so older builder code keeps working and looks P4.
--   WorldStyle.Palette                        the P4 colours (style.md 4), the legacy Phase 5 keys recoloured to their
--       P4 counterparts, Accent.<Name> = the gate / mode colours (Obby Blue, Home Yellow, Dungeon Purple, Ring Gold +
--       Violet, Arena Red, Altar Cyan, Return Green)
--   WorldStyle.Plinth(parent, cf, size, mat, color) -> body, band          a base block + a 0.2-stud band on top
--   WorldStyle.Kerb(parent, cf, length, mat, color) -> kerb, lip           a platform edge (cf on the top surface at
--       the edge, X = along it, LookVector = outward): a 0.4 x 0.8 kerb + a 0.3-stud lip under the top
--   WorldStyle.Chamfer(parent, cf, size, mat, color, cut) -> body, parts    a box with bevelled vertical corners
--   WorldStyle.BuildGate(parent, siteCFrame, spec) -> model, pad, promptPart
--       The P4 round voxel hoop gate family (6.0.3; P4 LobbyBuilder buildPortal / ArenaBuilder buildTrialPortal):
--       siteCFrame = ground CFrame of the gate centre, LookVector toward the plaza (the gate's front, local -Z).
--       spec = { Id, Title, Info, Color (Palette.Accent name | Theme.Neon name | Color3), Glyph = "house" | "cloud" |
--                "torch" | "crown" | "swords" | "bolt", Pad = bool, Name = "Portal_<Id>", Pill = text (optional),
--                Stars = 0..5 (the "cloud" star crest, default 5), Accent = Color3 (the crowned arch's glow) }
--       Shape by glyph: "crown" = the P4 Champion Ring crowned square arch (gold trim, violet glow, crown baked into
--       the voxels); every other glyph = the round hoop: a stone base, two stone pillars with coloured caps and a
--       glowing dot, a chunky pixel ring whose outer band is the gate colour around a white cloud frame, an inner Neon
--       ring, a translucent Neon swirl (Transparency 0.62) and a coloured keystone with two gold gems. Crest on top by
--       glyph: cloud = 5 gold stars on a bar (Obby), swords = crossed swords + shield (Arena), house = a little house
--       (Home), torch = a skull (Dungeon), bolt = a cloud with a lightning bolt (Altar). Voxels are 1 stud, shaded like
--       P4 (Voxel.Shade: _Light tops, _Dark creases), sculpted once per shape and cloned with the gate's palette.
--       Children: the voxel parts (named by key: StoneDark, Stone, Frame, Trim, Glow, Swirl, Gem; Swirl / Glow / Gem
--       never collide), "GlowCore" (invisible, the PrimaryPart, 11.5 up; not named SwirlCore so PortalService keeps the countdown face at the lock wall: PointLight "GateLight" Range 28 Brightness 1.3
--       + ParticleEmitter "Sparkles" Rate 12 drifting toward the plaza), "Crest*" / "Star*" parts, "PromptAnchor"
--       (invisible, front of the opening, 3 up: prompts go here), the BillboardGui "GateTag" (Plate: Title 28 px,
--       Info 20 px, Pill.Label 18 px; anchor 27 studs up, MaxDistance 120). Pad = true: "Pad" (14 x 0.6 x 14, 14 studs
--       in front, walkable; the PortalService zone sits on it) tiled like P4 (a colour rim, a light stone ring, a Neon
--       plus; X for swords, a crown for the arch: "PadTile*" 0.06 thick on top) + two lanterns on its front corners;
--       else "Step" (10 x 0.3 x 6, 6 studs in front). Attributes GateId, Glyph, GateShape ("Hoop" | "Arch").
--       <= 100 parts; the owner adds <= 20 (crown pedestals, torches): every gate <= 120.
-- Extras: WorldStyle.Jitter(color, seed, amount), WorldStyle.Glyphs (the 6x6 patterns), WorldStyle.GlyphRects,
--   WorldStyle.IsWorldMaterial(m), WorldStyle.Saturation(color), WorldStyle.GateSize, WorldStyle.Look = "P4",
--   WorldStyle.Tags.Detail ("NC_Detail": pure decor, the Low graphics setting hides it), WorldStyle.Tags.Exempt
--   ("NC_StyleExempt": pets / tokens / the storm island, skipped by the look audit of p5world_style).

local Shared = script.Parent
local Voxel = require(Shared:WaitForChild("Voxel", 10))
local Theme = require(Shared:WaitForChild("Theme", 10))

local WorldStyle = {}

local rgb = Color3.fromRGB
local floor, max, min, sqrt, abs = math.floor, math.max, math.min, math.sqrt, math.abs
local PI = math.pi

WorldStyle.Look = "P4"
WorldStyle.Tags = { Detail = "NC_Detail", Exempt = "NC_StyleExempt" }

----------------------------------------------------------------------
-- Materials (6.1 A1): SmoothPlastic surfaces, Neon glow, Glass water. The rest are aliases (see the header).
----------------------------------------------------------------------
local SMOOTH = Enum.Material.SmoothPlastic
WorldStyle.Materials = {
	SmoothPlastic = SMOOTH, -- every surface
	Neon = Enum.Material.Neon, -- glow: gate rings, swirls, gems, lanterns, inlays
	Glass = Enum.Material.Glass, -- water, lantern cages, machine domes (translucent)
	-- Phase 5 names, kept so older builder code runs: all P4 SmoothPlastic now (style.md 4: no textures)
	Slate = SMOOTH,
	Cobblestone = SMOOTH,
	Brick = SMOOTH,
	Marble = SMOOTH,
	WoodPlanks = SMOOTH,
	Wood = SMOOTH,
	Grass = SMOOTH,
	LeafyGrass = SMOOTH,
	Sand = SMOOTH,
	ClayRoofTiles = SMOOTH,
	RoofShingles = SMOOTH,
	Metal = SMOOTH,
	Fabric = SMOOTH,
	ForceField = Enum.Material.Neon, -- shimmer sheets become translucent Neon (the P4 swirl)
}

local MATERIAL_SET = {}
for _, m in pairs(WorldStyle.Materials) do
	MATERIAL_SET[m] = true
end

function WorldStyle.IsWorldMaterial(material)
	return MATERIAL_SET[material] == true
end

----------------------------------------------------------------------
-- Palette (style.md 4: big surfaces bright and saturated; the P4 numbers are the reference)
----------------------------------------------------------------------
WorldStyle.Palette = {
	-- the P4 world
	Grass = rgb(108, 186, 86),
	GrassLight = rgb(132, 202, 98),
	GrassDark = rgb(86, 160, 76),
	Hedge = rgb(74, 146, 72),
	Stone = rgb(208, 202, 190), -- cream stone paths
	StoneLight = rgb(226, 221, 209),
	StoneDark = rgb(172, 164, 154),
	StoneEdge = rgb(146, 138, 132), -- path borders
	Sand = rgb(236, 214, 166),
	Plank = rgb(196, 146, 98),
	PlankLight = rgb(214, 166, 114),
	PlankDark = rgb(152, 108, 72),
	Bark = rgb(132, 92, 62),
	Gold = rgb(244, 198, 84),
	GoldDark = rgb(206, 154, 62),
	Iron = rgb(64, 70, 92),
	IronLight = rgb(96, 104, 130),
	Steel = rgb(206, 214, 228),
	Water = rgb(92, 178, 236),
	WaterDeep = rgb(62, 136, 212),
	Blossom = rgb(246, 174, 204),
	Cream = rgb(246, 234, 210),
	Bone = rgb(240, 236, 226),
	RoofBlue = rgb(88, 136, 226),
	RoofRed = rgb(232, 104, 112),
	StarOff = rgb(96, 104, 136),
	Navy = rgb(34, 42, 76),
	-- white / light-blue clouds (never pure white; tops < 249)
	CloudLight = rgb(244, 247, 252),
	Cloud = rgb(232, 238, 249),
	CloudShade = rgb(212, 222, 241),
	Mist = rgb(194, 211, 240),
	MistDark = rgb(170, 190, 228),
	-- the Phase 5 keys, recoloured to their P4 counterparts (older builder code keeps working, looks P4)
	SlateDark = rgb(172, 164, 154),
	Slate = rgb(208, 202, 190),
	SlateLight = rgb(226, 221, 209),
	Marble = rgb(240, 234, 220),
	MarbleShade = rgb(226, 221, 209),
	Cobble = rgb(208, 202, 190),
	Brick = rgb(146, 138, 132),
	WoodPlanks = rgb(196, 146, 98),
	Wood = rgb(132, 92, 62),
	LeafyGrass = rgb(74, 146, 72),
	Roof = rgb(88, 136, 226),
	Metal = rgb(244, 198, 84), -- gold trim
	Glass = rgb(150, 206, 244),
	Fabric = rgb(246, 174, 204),
	Lantern = rgb(255, 214, 140), -- warm lights
	CloudTop = rgb(244, 247, 252),
	CloudSide = rgb(232, 238, 249),
	CloudUnder = rgb(194, 211, 240),
	-- gate / mode colours (6.0.3; the P4 difficulty / Trial / Ring hues; Palette.Accent wins over Theme.Neon)
	Accent = {
		Yellow = rgb(246, 196, 60), -- Home
		Blue = rgb(96, 160, 224), -- Obby (the P4 Medium blue)
		Purple = rgb(150, 110, 220), -- Dungeon (the P4 Saint purple)
		Gold = rgb(250, 190, 56), -- Champion Ring trim
		Violet = rgb(156, 96, 238), -- Champion Ring glow and gems
		Red = rgb(222, 74, 80), -- Arena (the P4 Trial red)
		Cyan = rgb(64, 196, 222), -- Storm Altar
		Pink = rgb(234, 120, 170),
		Green = rgb(96, 190, 140), -- the arena's Return gate (the P4 Easy green)
	},
	TagPlate = rgb(20, 24, 52), -- the dark navy tag card
	TagInfo = rgb(214, 220, 255),
}

-- HSV saturation of a Color3 (0..1).
function WorldStyle.Saturation(color)
	local r, g, b = color.R, color.G, color.B
	local hi = max(r, g, b)
	if hi <= 0 then
		return 0
	end
	return (hi - min(r, g, b)) / hi
end

-- Deterministic +-amount RGB jitter (default 6): tile checkers that never read as one flat colour.
function WorldStyle.Jitter(color, seed, amount)
	amount = amount or 6
	local s = tonumber(seed) or 0
	local d = floor((Voxel.Hash(s, 17, 3, 91) * 2 - 1) * amount + 0.5)
	local function ch(c)
		return max(0, min(255, floor(c * 255 + 0.5) + d))
	end
	return rgb(ch(color.R), ch(color.G), ch(color.B))
end

----------------------------------------------------------------------
-- Pieces
----------------------------------------------------------------------
local function solidProps(name)
	return { Name = name, CanCollide = true, CanQuery = true, CanTouch = false }
end

local function decoProps(name)
	return { Name = name, CanCollide = false, CanQuery = false, CanTouch = false }
end

function WorldStyle.Plinth(parent, cf, size, mat, color)
	mat = mat or SMOOTH
	local body = Voxel.Box(parent, cf, size, color or WorldStyle.Palette.StoneDark, mat, solidProps("Plinth"))
	local band = Voxel.Box(
		parent,
		cf * CFrame.new(0, size.Y * 0.5 - 0.1, 0),
		Vector3.new(size.X + 0.3, 0.2, size.Z + 0.3),
		WorldStyle.Palette.StoneLight,
		SMOOTH,
		solidProps("PlinthBand")
	)
	return body, band
end

function WorldStyle.Kerb(parent, cf, length, mat, color)
	length = tonumber(length) or 4
	local kerb = Voxel.Box(
		parent,
		cf * CFrame.new(0, 0.2, 0),
		Vector3.new(length, 0.4, 0.8),
		color or WorldStyle.Palette.StoneEdge,
		mat or SMOOTH,
		solidProps("Kerb")
	)
	-- the lip: 0.3 tall, just under the top surface, 0.3 beyond the kerb's outer face (-Z local = outward)
	local lip = Voxel.Box(
		parent,
		cf * CFrame.new(0, -0.25, -0.3),
		Vector3.new(length + 0.2, 0.3, 1.0),
		WorldStyle.Palette.StoneDark,
		SMOOTH,
		decoProps("KerbLip")
	)
	return kerb, lip
end

function WorldStyle.Chamfer(parent, cf, size, mat, color, cut)
	cut = tonumber(cut) or 0.6
	cut = min(cut, size.X * 0.25, size.Z * 0.25)
	mat = mat or SMOOTH
	color = color or WorldStyle.Palette.StoneLight
	local parts = {}
	local body = Voxel.Box(parent, cf, Vector3.new(size.X - 2 * cut, size.Y, size.Z), color, mat, solidProps("Chamfer"))
	parts[1] = body
	parts[2] = Voxel.Box(parent, cf, Vector3.new(size.X, size.Y, size.Z - 2 * cut), color, mat, solidProps("ChamferX"))
	-- a square post of side cut*sqrt(2), turned 45 degrees, centred on each re-entrant corner of the cross:
	-- its outer face runs from (X/2, Z/2 - cut) to (X/2 - cut, Z/2), the bevel
	local side = cut * sqrt(2)
	local hx, hz = size.X * 0.5 - cut, size.Z * 0.5 - cut
	local signs = { { 1, 1 }, { 1, -1 }, { -1, -1 }, { -1, 1 } }
	for i, s in ipairs(signs) do
		parts[#parts + 1] = Voxel.Box(
			parent,
			cf * CFrame.new(s[1] * hx, 0, s[2] * hz) * CFrame.Angles(0, PI / 4, 0),
			Vector3.new(side, size.Y, side),
			color,
			mat,
			solidProps("ChamferCorner" .. i)
		)
	end
	return body, parts
end

----------------------------------------------------------------------
-- Glyphs: 6 x 6, top row first ("#" = lit)
----------------------------------------------------------------------
WorldStyle.Glyphs = {
	house = { "..##..", ".####.", "######", ".#..#.", ".#..#.", ".####." },
	cloud = { "......", "..##..", ".####.", "######", ".####.", "......" },
	torch = { "...#..", "..##..", "..###.", ".####.", "..##..", "..##.." },
	crown = { "#.##.#", "#.##.#", "######", "######", ".####.", "......" },
	swords = { "#....#", ".#..#.", "..##..", "..##..", ".#..#.", "#....#" },
	bolt = { "...##.", "..##..", ".####.", "..##..", ".##...", ".#...." },
}

-- Greedy rectangles of a glyph: runs per row, merged downwards while identical. Deterministic order.
local function glyphRects(rows)
	local rects = {}
	local open = {} -- key "x0:x1" -> rect still growing
	for y = 1, #rows do
		local row = rows[y]
		local nextOpen = {}
		local x = 1
		while x <= #row do
			if row:sub(x, x) == "#" then
				local x1 = x
				while x1 + 1 <= #row and row:sub(x1 + 1, x1 + 1) == "#" do
					x1 = x1 + 1
				end
				local key = x .. ":" .. x1
				local r = open[key]
				if r then
					r.Y1 = y
				else
					r = { X0 = x, X1 = x1, Y0 = y, Y1 = y }
					rects[#rects + 1] = r
				end
				nextOpen[key] = r
				x = x1 + 1
			else
				x = x + 1
			end
		end
		open = nextOpen
	end
	return rects
end
WorldStyle.GlyphRects = glyphRects

-- One template per glyph (and orientation): a Model of Neon cells, built once and cloned (6.2).
-- Vertical = the medallion face (cells in X/Y, `depth` thick along Z); flat = the pad inlay (cells in X/Z).
local glyphCache = {}
local function glyphTemplate(glyph, cell, depth, flat)
	local key = glyph .. "|" .. cell .. "|" .. depth .. "|" .. tostring(flat)
	local t = glyphCache[key]
	if t then
		return t
	end
	local rows = WorldStyle.Glyphs[glyph] or WorldStyle.Glyphs.cloud
	t = Instance.new("Model")
	t.Name = "Glyph"
	for i, r in ipairs(glyphRects(rows)) do
		local w = (r.X1 - r.X0 + 1) * cell
		local h = (r.Y1 - r.Y0 + 1) * cell
		local cx = ((r.X0 + r.X1) * 0.5 - 3.5) * cell
		local cy = (3.5 - (r.Y0 + r.Y1) * 0.5) * cell
		local size, pos
		if flat then
			-- top row toward -Z (the far side seen from the plaza is the glyph's top)
			size, pos = Vector3.new(w, depth, h), CFrame.new(cx, 0, -cy)
		else
			size, pos = Vector3.new(w, h, depth), CFrame.new(cx, cy, 0)
		end
		local p = Voxel.Box(t, pos, size, WorldStyle.Palette.Accent.Blue, WorldStyle.Materials.Neon, decoProps("GlyphCell" .. i))
		p.CastShadow = false
	end
	glyphCache[key] = t
	return t
end

-- Places a clone of the glyph template at `cf`, coloured `color`.
local function placeGlyph(parent, glyph, cf, color, cell, depth, flat)
	local model = glyphTemplate(glyph, cell, depth, flat):Clone()
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") then
			p.CFrame = cf * p.CFrame
			p.Color = color
		end
	end
	model.Parent = parent
	return model
end

----------------------------------------------------------------------
-- The pixel tag (World text rule): constant on-screen size, compact navy plate, neon border
----------------------------------------------------------------------
local TAG_TITLE, TAG_INFO, TAG_PILL = 28, 20, 18

local function tagLabel(parent, name, text, role, size, color, order)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Text = text or ""
	label.Font = Theme.Fonts[role] or Theme.Fonts.Body
	label.TextSize = size
	label.TextColor3 = color
	label.TextStrokeTransparency = 1
	label.TextWrapped = false
	label.Size = UDim2.fromOffset(0, size + 4)
	label.AutomaticSize = Enum.AutomaticSize.X
	label.LayoutOrder = order
	local stroke = Instance.new("UIStroke")
	stroke.Name = "TextOutline"
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Color = (Theme.Colors and Theme.Colors.Ink) or rgb(26, 32, 64)
	stroke.Thickness = 2.5
	stroke.Parent = label
	label.Parent = parent
	return label
end

local function buildTag(adornee, lift, spec, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "GateTag"
	gui.Size = UDim2.fromOffset(420, 150)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the plate grows upwards from the anchor
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift, 0)
	gui.LightInfluence = 0
	gui.MaxDistance = 120
	gui.AlwaysOnTop = false
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.AnchorPoint = Vector2.new(0.5, 1)
	plate.Position = UDim2.new(0.5, 0, 1, 0)
	plate.Size = UDim2.fromOffset(0, 0)
	plate.AutomaticSize = Enum.AutomaticSize.XY
	plate.BackgroundColor3 = WorldStyle.Palette.TagPlate
	plate.BackgroundTransparency = 0.08
	plate.BorderSizePixel = 0
	plate.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 14)
	corner.Parent = plate
	local border = Instance.new("UIStroke")
	border.Name = "Border"
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Color = color
	border.Thickness = 3
	border.Parent = plate
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 16)
	pad.PaddingRight = UDim.new(0, 16)
	pad.Parent = plate
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 2)
	list.Parent = plate
	tagLabel(plate, "Title", spec.Title or spec.Id or "", "Heading", TAG_TITLE, rgb(255, 255, 255), 1)
	local info = tagLabel(plate, "Info", spec.Info or "", "Body", TAG_INFO, WorldStyle.Palette.TagInfo, 2)
	info.Visible = (spec.Info or "") ~= ""
	-- the pill: the builder's status line (party, board, record); hidden while empty
	local pill = Instance.new("Frame")
	pill.Name = "Pill"
	pill.BackgroundColor3 = color:Lerp(rgb(0, 0, 0), 0.55)
	pill.BorderSizePixel = 0
	pill.Size = UDim2.fromOffset(0, TAG_PILL + 8)
	pill.AutomaticSize = Enum.AutomaticSize.X
	pill.LayoutOrder = 3
	pill.Visible = (spec.Pill or "") ~= ""
	pill.Parent = plate
	local pc = Instance.new("UICorner")
	pc.CornerRadius = UDim.new(1, 0)
	pc.Parent = pill
	local pp = Instance.new("UIPadding")
	pp.PaddingLeft = UDim.new(0, 10)
	pp.PaddingRight = UDim.new(0, 10)
	pp.Parent = pill
	tagLabel(pill, "Label", spec.Pill or "", "Label", TAG_PILL, rgb(255, 255, 255), 1)
	gui.Parent = adornee
	return gui
end

----------------------------------------------------------------------
-- The gate family (6.0.3): the P4 round voxel hoop + the P4 crowned arch, a crest per mode
----------------------------------------------------------------------
WorldStyle.GateSize = Vector3.new(23, 26, 5) -- the P4 hoop: a 23-voxel base, crest tops ~26, 5 deep

local GATE = {
	PadDistance = 14, -- pad centre in front of the gate centre (gate r 118, pad r 104)
	TagLift = 27, -- the tag's anchor height (just over the crests)
	SwirlY = 11.5, -- the swirl's centre (the ring is centred 11 voxels up, voxel centres 0.5 above the site)
	HoopParts = 80, -- MaxParts of the merged hoop voxels: ~76 boxes, the shade variants fold away (every gate <= 120)
	ArchParts = 56,
}
local NEON = Enum.Material.Neon
local WHITE = rgb(255, 255, 255)
-- ring radii (voxel units from the ring centre 11 up): swirl < Glow <= neon ring < Inner <= white frame < Band <=
-- coloured band < Outer
local RING = { Glow = 5.7, Inner = 6.6, Band = 8.6, Outer = 9.6 }
local KEEP = { "Stone", "StoneDark", "Frame", "Trim", "Glow", "Swirl", "Gem" }

-- Inclusive integer box of voxels.
local function vxFill(g, x0, x1, y0, y1, z0, z1, key)
	for y = y0, y1 do
		for x = x0, x1 do
			for z = z0, z1 do
				Voxel.Set(g, x, y, z, key)
			end
		end
	end
end

-- Rounded rectangle prism centred on (cx, cz): sx by sz voxels, corner radius `round` (P4 VX.RoundRect).
local function vxRoundRect(g, cx, cz, sx, sz, round, y0, y1, key)
	local hx, hz = sx / 2, sz / 2
	round = max(0, min(round, hx, hz))
	for y = y0, y1 do
		for x = floor(cx - hx) - 1, math.ceil(cx + hx) + 1 do
			for z = floor(cz - hz) - 1, math.ceil(cz + hz) + 1 do
				local qx, qz = abs(x - cx) - (hx - round), abs(z - cz) - (hz - round)
				local ox, oz = max(qx, 0), max(qz, 0)
				local d = sqrt(ox * ox + oz * oz) + min(max(qx, qz), 0)
				if d <= round then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- The round hoop (P4 LobbyBuilder gateBoxes / ArenaBuilder gateHoop; x across, y up, -z = the front)
local function hoopVoxels(g)
	vxRoundRect(g, 0, 0, 22, 5, 1.5, 0, 0, "StoneDark")
	vxRoundRect(g, 0, 0, 20, 4, 1.2, 1, 1, "Stone")
	for _, s in ipairs({ -1, 1 }) do
		vxRoundRect(g, s * 9, 0, 3, 3.4, 0.8, 2, 10, "Stone")
		vxRoundRect(g, s * 9, 0, 4, 4.2, 1, 11, 11, "Trim")
		vxFill(g, s * 9, s * 9, 12, 13, 0, 0, "Glow")
		vxFill(g, s * 9, s * 9, 3, 3, -2, -2, "Trim")
	end
	-- the ring (P4: a torus R 7.6 / 1.6 thick): a 3-voxel-deep pixel annulus, the white cloud frame inside the
	-- stepped outer band in the gate colour, a thin Neon ring at its inner edge and the swirl disc in the middle.
	-- Extruded (every depth layer the same) so the greedy merge keeps it near 60 boxes instead of 110.
	for y = 1, 21 do
		for x = -10, 10 do
			local dy = y - 11
			local r = sqrt(x * x + dy * dy)
			if r >= RING.Inner and r < RING.Outer then
				local key = (r >= RING.Band) and "Trim" or "Frame"
				vxFill(g, x, x, y, y, -1, 1, key)
			elseif r >= RING.Glow and r < RING.Inner then
				Voxel.Set(g, x, y, 0, "Glow")
			elseif r < RING.Glow and Voxel.Get(g, x, y, 0) == nil then
				Voxel.Set(g, x, y, 0, "Swirl")
			end
		end
	end
	-- the keystone with two gold gems facing the plaza
	vxRoundRect(g, 0, 0, 4, 3, 0.8, 19, 20, "Trim")
	Voxel.Set(g, 0, 20, -2, "Gem")
	Voxel.Set(g, 0, 19, -2, "Gem")
end

-- The crowned square arch (P4 ArenaBuilder Ring.gateVoxels): gold bands, a glowing frame around the swirl, violet
-- gems up the pillars and a big gold crown on the lintel
local function archVoxels(g)
	vxRoundRect(g, 0, 0, 22, 5, 1.5, 0, 0, "StoneDark")
	vxRoundRect(g, 0, 0, 20, 4, 1.2, 1, 1, "Stone")
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = min(sx * 7, sx * 9), max(sx * 7, sx * 9)
		vxFill(g, x0, x1, 2, 16, -1, 1, "Stone")
		vxFill(g, x0 - 1, x1 + 1, 2, 2, -2, 2, "Trim")
		vxFill(g, x0 - 1, x1 + 1, 15, 15, -2, 2, "Trim")
		vxFill(g, sx * 6, sx * 6, 3, 14, 0, 0, "Glow")
		for _, y in ipairs({ 6, 9, 12 }) do
			Voxel.Set(g, sx * 8, y, -2, "Gem")
		end
	end
	vxFill(g, -10, 10, 17, 17, -1, 1, "Trim")
	vxFill(g, -10, 10, 18, 18, -1, 1, "Stone")
	vxFill(g, -5, 5, 16, 16, 0, 0, "Glow")
	vxFill(g, -5, 5, 3, 15, 0, 0, "Swirl")
	-- the crown: a band with a row of gems, three big points (the middle one tallest), two small ones, gems on the tips
	vxFill(g, -7, 7, 19, 20, -1, 1, "Trim")
	for _, x in ipairs({ -4, 0, 4 }) do
		Voxel.Set(g, x, 20, -2, "Gem")
	end
	for _, pt in ipairs({ { -6, 22 }, { 0, 23 }, { 6, 22 } }) do
		vxFill(g, pt[1] - 1, pt[1] + 1, 21, 21, -1, 1, "Trim")
		vxFill(g, pt[1], pt[1], 22, pt[2], -1, 1, "Trim")
		Voxel.Set(g, pt[1], pt[2] + 1, 0, "Gem")
	end
	for _, x in ipairs({ -3, 3 }) do
		Voxel.Set(g, x, 21, 0, "Trim")
		Voxel.Set(g, x, 22, 0, "Gem")
	end
end

-- The gate palette (P4 gatePalette): stone light pillars, a white cloud frame, the trim in the gate colour, Neon glow /
-- swirl / gems
local function gatePalette(trim, glow, gem)
	local P = WorldStyle.Palette
	return {
		Stone = P.StoneLight,
		StoneDark = P.Stone,
		Frame = P.CloudLight,
		Puff = P.Cloud,
		Trim = trim,
		Glow = { Color = glow, Material = NEON },
		Swirl = { Color = glow:Lerp(WHITE, 0.35), Material = NEON, Transparency = 0.62 },
		Gem = { Color = gem, Material = NEON },
	}
end

-- sculpted, shaded and merged once per shape; every gate builds the same boxes with its own palette
local boxCache = {}
local function gateBoxes(shape)
	if boxCache[shape] then
		return boxCache[shape]
	end
	local g = Voxel.NewGrid(24)
	if shape == "Arch" then
		archVoxels(g)
	else
		hoopVoxels(g)
	end
	Voxel.Shade(g, { Skip = { Glow = true, Swirl = true, Gem = true }, Smooth = 1, Seed = 8 })
	local sample = rgb(120, 180, 140)
	boxCache[shape] = Voxel.Merge(g, {
		Palette = gatePalette(sample, sample, WorldStyle.Palette.Gold),
		MaxParts = (shape == "Arch") and GATE.ArchParts or GATE.HoopParts,
		Keep = KEEP,
	})
	return boxCache[shape]
end

local function accentOf(spec)
	local c = spec.Color
	if typeof(c) == "Color3" then
		return c
	end
	if type(c) == "string" then
		if WorldStyle.Palette.Accent[c] then
			return WorldStyle.Palette.Accent[c]
		end
		local neon = Theme.Neon
		if type(neon) == "table" and typeof(neon[c]) == "Color3" then
			return neon[c]
		end
	end
	return WorldStyle.Palette.Accent.Blue
end

-- one anchored block in the gate's frame
local function block(model, name, cf, size, color, opts)
	opts = opts or {}
	local p = Voxel.Box(model, cf, size, color, opts.Material or SMOOTH, {
		Name = name,
		Transparency = opts.Transparency or 0,
		CanCollide = opts.Collide == true,
		CanQuery = opts.Collide == true,
		CanTouch = false,
	})
	p.CastShadow = opts.Shadow == true
	return p
end

----------------------------------------------------------------------
-- Crests (P4 star crest / Trial sword crest; house, skull and storm bolt in the same toy style). The hoop's keystone
-- top is 21 studs up; every crest stays under ~26 (the tag's anchor is 27).
----------------------------------------------------------------------
local Crest = {}

function Crest.post(m, site)
	block(m, "CrestPost", site * CFrame.new(0, 21.6, 0), Vector3.new(0.8, 1.3, 0.6), WorldStyle.Palette.GoldDark)
end

-- cloud (Obby): five gold star gems on a bar (lit = Neon gold, unlit = dim stone); spec.Stars lights the first n
function Crest.cloud(m, site, color, spec)
	local P = WorldStyle.Palette
	local n = 5
	local lit = floor(tonumber(spec.Stars) or n)
	lit = max(0, min(n, lit))
	block(m, "StarPost", site * CFrame.new(0, 21.6, 0), Vector3.new(0.8, 1.3, 0.6), P.GoldDark)
	block(m, "StarBar", site * CFrame.new(0, 22.45, 0), Vector3.new((n - 1) * 2.6 + 1.2, 0.5, 0.5), P.GoldDark)
	for s = 1, n do
		local gx = ((n + 1) / 2 - s) * 2.6 -- gate +X is the viewer's left: lit stars first
		local on = s <= lit
		block(m, on and "StarGem" or "StarGemOff", site * CFrame.new(gx, 23.6, 0) * CFrame.Angles(0, 0, math.rad(45)), Vector3.new(1.5, 1.5, 0.8), on and P.Gold or P.StarOff, { Material = on and NEON or SMOOTH })
	end
end

-- swords (Arena): a shield in the gate colour with a gold rim and two crossed steel swords (P4 Trial crest)
function Crest.swords(m, site, color)
	local P = WorldStyle.Palette
	Crest.post(m, site)
	block(m, "CrestShield", site * CFrame.new(0, 23.4, 0), Vector3.new(2.4, 2.6, 0.7), color:Lerp(P.Navy, 0.2))
	block(m, "CrestShieldRim", site * CFrame.new(0, 23.4, 0.15), Vector3.new(2.9, 3.1, 0.5), P.Gold)
	for _, s in ipairs({ -1, 1 }) do
		local scf = site * CFrame.new(0, 23.6, -0.5) * CFrame.Angles(0, 0, math.rad(s * 42))
		block(m, "CrestBlade", scf * CFrame.new(0, 0.6, 0), Vector3.new(0.45, 5, 0.2), P.Steel)
		block(m, "CrestGuard", scf * CFrame.new(0, -1.9, 0), Vector3.new(1.5, 0.35, 0.3), P.Gold)
		block(m, "CrestGrip", scf * CFrame.new(0, -2.5, 0), Vector3.new(0.35, 0.9, 0.3), P.GoldDark)
	end
end

-- house (Home): a little cream house with a stepped coral roof, a door, two lit windows and a chimney
function Crest.house(m, site)
	local P = WorldStyle.Palette
	Crest.post(m, site)
	block(m, "CrestHouse", site * CFrame.new(0, 23.3, 0), Vector3.new(3.8, 2.4, 1.2), P.Cream)
	block(m, "CrestRoof", site * CFrame.new(0, 24.85, 0), Vector3.new(4.8, 0.7, 1.5), P.RoofRed)
	block(m, "CrestRoofTop", site * CFrame.new(0, 25.5, 0), Vector3.new(2.8, 0.6, 1.5), P.RoofRed:Lerp(WHITE, 0.15))
	block(m, "CrestChimney", site * CFrame.new(1.5, 25.5, 0.25), Vector3.new(0.6, 1.0, 0.6), P.PlankDark)
	block(m, "CrestDoor", site * CFrame.new(0, 22.85, -0.65), Vector3.new(1, 1.4, 0.15), P.Plank)
	for _, s in ipairs({ -1, 1 }) do
		block(m, "CrestWindow", site * CFrame.new(s * 1.25, 23.7, -0.65), Vector3.new(0.7, 0.7, 0.15), P.Lantern, { Material = NEON })
	end
end

-- torch (Dungeon): a cute bone skull with glowing eyes in the gate colour over two crossed bones; its jaw sits on
-- the keystone
function Crest.torch(m, site, color)
	local P = WorldStyle.Palette
	for _, s in ipairs({ -1, 1 }) do
		block(m, "CrestBone", site * CFrame.new(0, 23.4, 0.5) * CFrame.Angles(0, 0, math.rad(s * 45)), Vector3.new(0.55, 5.4, 0.4), P.StoneLight)
	end
	block(m, "CrestSkull", site * CFrame.new(0, 23.6, 0), Vector3.new(3.6, 2.8, 1.5), P.Bone)
	block(m, "CrestSkullTop", site * CFrame.new(0, 25.25, 0), Vector3.new(2.6, 0.5, 1.3), P.Bone)
	block(m, "CrestJaw", site * CFrame.new(0, 21.8, 0), Vector3.new(2.4, 0.8, 1.3), P.Bone)
	for _, s in ipairs({ -1, 1 }) do
		block(m, "CrestEye", site * CFrame.new(s * 0.8, 23.75, -0.77), Vector3.new(0.9, 0.9, 0.12), color, { Material = NEON })
	end
	block(m, "CrestNose", site * CFrame.new(0, 22.8, -0.77), Vector3.new(0.45, 0.45, 0.12), P.Navy)
end

-- bolt (Storm Altar): a puffy little storm cloud with a misty underside and a gold Neon lightning bolt on its face,
-- striking down out of it
function Crest.bolt(m, site)
	local P = WorldStyle.Palette
	block(m, "CrestPost", site * CFrame.new(0, 21.85, 0), Vector3.new(0.8, 1.7, 0.6), WorldStyle.Palette.GoldDark)
	block(m, "CrestCloudBase", site * CFrame.new(0, 22.9, 0), Vector3.new(4.4, 0.4, 1.3), P.Mist)
	block(m, "CrestCloud", site * CFrame.new(0, 23.9, 0), Vector3.new(5.6, 1.6, 1.4), P.CloudLight)
	block(m, "CrestCloudTop", site * CFrame.new(-0.6, 25.1, 0), Vector3.new(3.2, 0.8, 1.3), P.CloudLight)
	block(m, "CrestCloudPuff", site * CFrame.new(1.5, 24.95, 0), Vector3.new(2, 0.5, 1.2), P.Cloud)
	local bolt = rgb(252, 214, 72)
	block(m, "CrestBolt", site * CFrame.new(0.5, 24.3, -0.8) * CFrame.Angles(0, 0, math.rad(-28)), Vector3.new(0.7, 1.4, 0.2), bolt, { Material = NEON })
	block(m, "CrestBolt", site * CFrame.new(0.1, 23.65, -0.8), Vector3.new(1.4, 0.45, 0.2), bolt, { Material = NEON })
	block(m, "CrestBolt", site * CFrame.new(-0.3, 22.95, -0.8) * CFrame.Angles(0, 0, math.rad(-28)), Vector3.new(0.6, 1.4, 0.2), bolt, { Material = NEON })
end

----------------------------------------------------------------------
-- The ready pad (P4): a 14 x 14 tiled plate, a colour rim, a light stone ring, a Neon plus (X for swords, a crown
-- for the arch), and two lanterns on its front corners
----------------------------------------------------------------------
local function padInlay(kind, ci, ck)
	local ai, ak = abs(ci), abs(ck)
	if kind == "swords" then
		return abs(ai - ak) < 0.6 and ai <= 4
	elseif kind == "crown" then
		-- +k points at the gate: the crown's points
		if (ck == -2.5 or ck == -1.5) and ai <= 3 then
			return true
		end
		return (ai == 0.5 and ck >= -0.5 and ck <= 2.5) or (ai == 2.5 and ck >= -0.5 and ck <= 1.5)
	end
	return ai + ak <= 2.5
end

local padCache = {}
local function padBoxes(kind)
	if padCache[kind] then
		return padCache[kind]
	end
	local g = Voxel.NewGrid(14)
	for i = -7, 6 do
		for k = -7, 6 do
			local ring = min(i + 7, 6 - i, k + 7, 6 - k)
			local key = nil
			-- the pad itself is the light stone ring; one Stone tile covers the middle, the inlay lies on top of it
			if ring == 0 then
				key = "Trim"
			elseif padInlay(kind, i + 0.5, k + 0.5) then
				key = "Glow"
			end
			if key then
				Voxel.Set(g, i, 0, k, key)
			end
		end
	end
	padCache[kind] = Voxel.Merge(g, {})
	return padCache[kind]
end

local function buildPad(model, site, kind, trim, glow)
	local P = WorldStyle.Palette
	local padCF = site * CFrame.new(0, 0, -GATE.PadDistance) -- ground under the pad centre
	local pad = Voxel.Box(model, padCF * CFrame.new(0, 0.3, 0), Vector3.new(14, 0.6, 14), P.StoneLight, SMOOTH, { Name = "Pad", CanCollide = true, CanQuery = true, CanTouch = false })
	pad.CastShadow = false
	block(model, "PadTileStone", padCF * CFrame.new(0, 0.63, 0), Vector3.new(10, 0.06, 10), P.Stone)
	for _, b in ipairs(padBoxes(kind)) do
		local key = b.Key
		local w, d = b.X1 - b.X0 + 1, b.Z1 - b.Z0 + 1
		local cx, cz = (b.X0 + b.X1) * 0.5 + 0.5, (b.Z0 + b.Z1) * 0.5 + 0.5
		local glowTile = key == "Glow"
		-- the inlay pokes 0.02 over the Stone tile (no z-fighting); the rim is level with it
		block(model, "PadTile" .. key, padCF * CFrame.new(cx, glowTile and 0.64 or 0.63, cz), Vector3.new(w, glowTile and 0.08 or 0.06, d), glowTile and glow or trim, { Material = glowTile and NEON or SMOOTH })
	end
	-- lanterns on the two front corners (away from the gate)
	for _, sx in ipairs({ -1, 1 }) do
		local base = padCF * CFrame.new(sx * 7.9, 0, -7.9)
		block(model, "LanternPost", base * CFrame.new(0, 1.6, 0), Vector3.new(0.7, 3.2, 0.7), P.Iron, { Collide = true })
		block(model, "LanternCap", base * CFrame.new(0, 3.35, 0), Vector3.new(1.1, 0.3, 1.1), P.Iron)
		block(model, "LanternGlow", base * CFrame.new(0, 3.95, 0), Vector3.new(0.9, 0.9, 0.9), glow, { Material = NEON })
	end
	return pad
end

----------------------------------------------------------------------
-- Phase 6 (art-gates, contract 6.0.3 / A7): the Blender gate meshes (blender/kit/props/gates.py, keys gate_<kind>).
-- BuildGate tags the gate model with MeshLibrary.Tag; once the key's asset is ready a client Dresses it: the voxels
-- named in GATE_MESH_HIDE (stone, cloud frame, coloured trim, crest bodies) go transparent locally and the mesh takes
-- their place. Every other part stays visible (ML_Keep): the Neon glow ring / swirl / gems / star gems / crest eyes,
-- windows and bolt (PortalFxController animates them), the pad, the lanterns, the invisible anchors, and whatever a
-- builder adds to the gate later (torches, pedestals: the keep list follows DescendantAdded on the server). With
-- empty MeshIds the tag changes nothing.
----------------------------------------------------------------------
WorldStyle.GateMeshKeys = { cloud = "gate_obby", crown = "gate_ring", swords = "gate_arena", torch = "gate_dungeon", house = "gate_home", bolt = "gate_altar" }
WorldStyle.GATE_MESH_HIDE = {
	Stone = true, StoneDark = true, Frame = true, Trim = true,
	StarPost = true, StarBar = true, CrestPost = true,
	CrestShield = true, CrestShieldRim = true, CrestBlade = true, CrestGuard = true, CrestGrip = true,
	CrestHouse = true, CrestRoof = true, CrestRoofTop = true, CrestChimney = true, CrestDoor = true,
	CrestBone = true, CrestSkull = true, CrestSkullTop = true, CrestJaw = true, CrestNose = true,
	CrestCloudBase = true, CrestCloud = true, CrestCloudTop = true, CrestCloudPuff = true,
}

local meshLib = nil
local function meshLibrary()
	if meshLib == nil then
		meshLib = false
		local mod = Shared:FindFirstChild("MeshLibrary")
		if mod then
			local ok, lib = pcall(require, mod)
			if ok and type(lib) == "table" and type(lib.Tag) == "function" then
				meshLib = lib
			end
		end
	end
	return meshLib or nil
end

-- the mesh key of a gate: the arch is gate_ring; a hoop takes its crest's key (an unknown glyph wears the stars)
function WorldStyle.GateMeshKey(shape, glyph)
	if shape == "Arch" then
		return "gate_ring"
	end
	if glyph == "crown" or not WorldStyle.GateMeshKeys[glyph] then
		return "gate_obby"
	end
	return WorldStyle.GateMeshKeys[glyph]
end

local function keepList(keep)
	local names = {}
	for name in pairs(keep) do
		names[#names + 1] = name
	end
	table.sort(names)
	return table.concat(names, ",")
end

-- model pivot = GlowCore (SwirlY up the site): ML_Offset puts the mesh origin back on the site
local function tagGateMesh(model, key, color, stars)
	local ML = meshLibrary()
	if not ML then
		return
	end
	local hide = WorldStyle.GATE_MESH_HIDE
	local keep = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not hide[d.Name] then
			keep[d.Name] = true
		end
	end
	ML.Tag(model, key, { Primary = color, Stars = stars, Offset = CFrame.new(0, -GATE.SwirlY, 0) }, keep)
	model.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") and not hide[d.Name] and not keep[d.Name] and model:GetAttribute("ML_DressKey") == key then
			keep[d.Name] = true
			model:SetAttribute("ML_Keep", keepList(keep))
		end
	end)
end

local function popSize(maxSize)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, maxSize),
		NumberSequenceKeypoint.new(1, 0),
	})
end

function WorldStyle.BuildGate(parent, siteCFrame, spec)
	spec = spec or {}
	local id = tostring(spec.Id or "Gate")
	local color = accentOf(spec)
	local glyph = WorldStyle.Glyphs[spec.Glyph] and spec.Glyph or "cloud"
	local shape = (spec.Shape == "Arch" or spec.Shape == "Hoop") and spec.Shape or ((glyph == "crown") and "Arch" or "Hoop")
	local P = WorldStyle.Palette
	-- level the site: gates always stand upright, facing the site's horizontal look direction
	local look = siteCFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local site = CFrame.lookAt(siteCFrame.Position, siteCFrame.Position + flat.Unit)

	local model = Instance.new("Model")
	model.Name = spec.Name or ("Portal_" .. id)
	model:SetAttribute("GateId", id)
	model:SetAttribute("Glyph", glyph)
	model:SetAttribute("GateShape", shape)

	-- the arch glows violet under its gold trim (P4 Champion Ring); the hoop glows in its own colour
	local glow = color
	local gem = P.Gold
	if shape == "Arch" then
		glow = (typeof(spec.Accent) == "Color3") and spec.Accent or P.Accent.Violet
		gem = glow:Lerp(WHITE, 0.2)
	end
	Voxel.BuildBoxes(gateBoxes(shape), {
		VoxelSize = 1,
		Palette = gatePalette(color, glow, gem),
		CFrame = site * CFrame.new(0, 0.5, 0),
		Model = model,
		CanCollide = true,
		CanQuery = true,
	})
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") and (d.Name == "Swirl" or d.Name == "Glow" or d.Name == "Gem" or d.Name == "Puff") then
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		end
	end
	if shape == "Hoop" then
		local crest = Crest[glyph] or Crest.cloud
		crest(model, site, color, spec)
	end

	-- the swirl's light and sparkles drifting out toward the pad (an invisible core: the PrimaryPart)
	local core = block(model, "GlowCore", site * CFrame.new(0, GATE.SwirlY, 0), Vector3.new(9, 9, 0.4), glow, { Transparency = 1 })
	local light = Instance.new("PointLight")
	light.Name = "GateLight"
	light.Range = 28
	light.Brightness = 1.3
	light.Color = glow
	light.Shadows = false
	light.Parent = core
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "Sparkles"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkles.Rate = 12
	sparkles.Lifetime = NumberRange.new(1.4, 2.2)
	sparkles.Speed = NumberRange.new(1.5, 3.5)
	sparkles.Size = popSize(0.9)
	sparkles.Color = ColorSequence.new(glow:Lerp(WHITE, 0.5), (shape == "Arch") and color or glow)
	sparkles.LightEmission = 0.6
	sparkles.LightInfluence = 0
	sparkles.EmissionDirection = Enum.NormalId.Front
	sparkles.SpreadAngle = Vector2.new(30, 30)
	sparkles.Parent = core

	-- the prompt anchor: invisible, in front of the opening at chest height
	local promptPart = block(model, "PromptAnchor", site * CFrame.new(0, 3.5, -2.8), Vector3.new(2, 2, 1), P.Stone, { Transparency = 1 })

	-- pad (Pad = true) or a step
	local pad
	if spec.Pad then
		local kind = (shape == "Arch") and "crown" or ((glyph == "swords") and "swords" or "plus")
		pad = buildPad(model, site, kind, color, glow)
	else
		pad = Voxel.Box(model, site * CFrame.new(0, 0.15, -6), Vector3.new(10, 0.3, 6), P.StoneLight, SMOOTH, { Name = "Step", CanCollide = true, CanQuery = true, CanTouch = false })
		pad.CastShadow = false
	end

	buildTag(core, GATE.TagLift - GATE.SwirlY, spec, color)
	model.PrimaryPart = core
	local stars = (shape == "Hoop" and not (Crest[glyph] and glyph ~= "cloud")) and max(0, min(5, floor(tonumber(spec.Stars) or 5))) or nil
	tagGateMesh(model, WorldStyle.GateMeshKey(shape, glyph), color, stars)
	model.Parent = parent
	return model, pad, promptPart
end

-- The five Gate Court gates in a row (facing -Z) on a small cream court: the reference sample for renders
-- (tools/render_model.py module:shared/WorldStyle:Sample) and the style tests. Not used in game. (Phase 6: no Home
-- gate in the lobby any more, so no Home sample; the house crest still exists for the arena's Return gate.)
WorldStyle.SampleGates = {
	{ Id = "Obby", Title = "Sky Obby", Info = "Climb the clouds - pick a level", Color = "Blue", Glyph = "cloud", Pad = true, Pill = "Easy - 1/4" },
	{ Id = "Dungeon", Title = "Dungeon", Info = "12 floors of monsters and loot", Color = "Purple", Glyph = "torch", Pad = true },
	{ Id = "Ring", Title = "Champion Ring", Info = "Win rounds in a row", Color = "Gold", Glyph = "crown", Pad = true },
	{ Id = "Arena", Title = "Battle Arena", Info = "Duels and boss raids", Color = "Red", Glyph = "swords", Pad = false },
	{ Id = "Altar", Title = "Storm Altar", Info = "Secret pets", Color = "Cyan", Glyph = "bolt", Pad = false },
}

function WorldStyle.Sample(parent)
	local root = Instance.new("Model")
	root.Name = "WorldStyleSample"
	local P = WorldStyle.Palette
	local n = #WorldStyle.SampleGates
	local step = 30
	-- the court: cream stone tiles (a light / dark checker) with stone-edge kerbs on the long edges, on lime grass
	local w, d = n * step, 40
	Voxel.Box(root, CFrame.new(0, -1.5, 0), Vector3.new(w + 24, 1, d + 24), P.Grass, SMOOTH, { Name = "Lawn", CanCollide = true, CanQuery = true })
	for ix = 0, floor(w / 5) - 1 do
		for iz = 0, floor(d / 5) - 1 do
			local alt = (ix + iz) % 2 == 0
			Voxel.Box(root, CFrame.new(-w * 0.5 + 2.5 + ix * 5, -0.5, -d * 0.5 + 2.5 + iz * 5), Vector3.new(5, 1, 5),
				alt and P.StoneLight or P.Stone, SMOOTH, { Name = "Tile", CanCollide = true, CanQuery = true })
		end
	end
	WorldStyle.Kerb(root, CFrame.new(0, 0, -d * 0.5), w)
	WorldStyle.Kerb(root, CFrame.new(0, 0, d * 0.5) * CFrame.Angles(0, PI, 0), w)
	for i, spec in ipairs(WorldStyle.SampleGates) do
		local x = (i - (n + 1) * 0.5) * step
		WorldStyle.BuildGate(root, CFrame.new(x, 0, 8), spec)
	end
	-- loose pieces: a plinth with a chamfered pillar on it
	WorldStyle.Plinth(root, CFrame.new(-w * 0.5 - 8, 0.4, 8), Vector3.new(5, 0.8, 5))
	WorldStyle.Chamfer(root, CFrame.new(-w * 0.5 - 8, 0.8 + 3, 8), Vector3.new(4, 6, 4))
	root.Parent = parent
	return root
end

return WorldStyle
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="829">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="830">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="Script" referent="831">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Main (Script): boots every server service in the order defined in ARCHITECTURE.md / V2 / V3.
-- Each step runs under pcall + warn so one failing service can never brick the whole server.
-- Plain Lua 5.1-compatible syntax only.
--
-- Boot order (Phase 5, ARCHITECTURE_V3.md "Phase 5 build contract" 10.1):
--   Remotes -> Lighting -> Lobby -> Storm Altar -> Arena -> Dungeon world (DungeonBuilder.Build -> NimbusLobby.PartCount)
--   -> Damage -> Token -> Data (autosave / BindToClose)
--   -> Pet / Item / Spot services (they subscribe to profile events)
--   -> Player service (this is what starts loading profiles, so it comes after the subscribers)
--   -> Match -> Portals -> Gates -> Index / Npc -> Tutorial -> Tycoon / PetCare / Fusion / Gem
--   -> Battle -> Dungeon -> Events -> Dev -> Dash relay
-- Every Phase 3+ service is optional (loadOptionalService): a module that is not in the build is skipped quietly, so the
-- game boots at every wave of the build.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
do local okMesh, MeshLibrary = pcall(require, Shared:WaitForChild("MeshLibrary", 5)) if okMesh and type(MeshLibrary) == "table" then MeshLibrary.Start() end end -- Phase 6: Blender meshes (no-op while MeshIds is empty)

local Services = script.Parent:WaitForChild("Services")

local TAG = "[NimbusClimb] "

----------------------------------------------------------------------
-- Boot helpers
----------------------------------------------------------------------

-- Require a service module; returns nil (and warns) instead of erroring.
local function loadService(name)
	local moduleScript = Services:FindFirstChild(name) or Services:WaitForChild(name, 3)
	if not moduleScript then
		warn(TAG .. "service module missing: " .. name)
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if not ok then
		warn(TAG .. "failed to load " .. name .. ": " .. tostring(result))
		return nil
	end
	return result
end

-- Call module[funcName](...) under pcall. Returns (result, success).
-- Optional (newer) services: Rojo syncs every module before scripts run, so a module that is not there
-- right away is simply not part of this build. Do not wait for it (waiting would delay the whole boot).
local function loadOptionalService(name)
	local moduleScript = Services:FindFirstChild(name)
	if not moduleScript then
		return nil
	end
	local ok, result = pcall(require, moduleScript)
	if not ok then
		warn(TAG .. "failed to load " .. name .. ": " .. tostring(result))
		return nil
	end
	return result
end

local function call(label, module, funcName, ...)
	if type(module) ~= "table" or type(module[funcName]) ~= "function" then
		warn(TAG .. label .. " skipped (module or function unavailable)")
		return nil, false
	end
	local ok, result = pcall(module[funcName], ...)
	if not ok then
		warn(TAG .. label .. " failed: " .. tostring(result))
		return nil, false
	end
	return result, true
end

-- Run an arbitrary function under pcall + warn.
local function step(label, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn(TAG .. label .. " failed: " .. tostring(err))
	end
	return ok
end

-- True when module[name] is a Util.Signal-like object.
local function hasSignal(module, name)
	return type(module) == "table" and type(module[name]) == "table" and type(module[name].Connect) == "function"
end

-- A tiny cloud platform so players are never dropped into the void if the lobby failed to build.
local function buildEmergencyLobby()
	local origin = Config.Lobby.Origin
	local platform = Instance.new("Part")
	platform.Name = "NimbusEmergencyPlaza"
	platform.Anchored = true
	platform.Shape = Enum.PartType.Cylinder
	platform.Material = Enum.Material.SmoothPlastic
	platform.Color = Color3.fromRGB(150, 168, 200)
	platform.Size = Vector3.new(2, 120, 120) -- cylinder axis is X: rotate it flat below
	platform.CFrame = CFrame.new(origin - Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90))
	platform.Parent = Workspace
	return platform
end

-- Services index lobbyInfo.Portals / .Spots / .Shop directly: make sure those always exist.
local function normaliseLobbyInfo(info)
	if type(info) ~= "table" then
		warn(TAG .. "LobbyBuilder.Build returned nothing; using an emergency plaza")
		local platform = buildEmergencyLobby()
		info = {
			Folder = platform,
			SpawnCFrame = CFrame.new(Config.Lobby.Origin + Vector3.new(0, 4, 0)),
		}
	end
	if type(info.Portals) ~= "table" then
		info.Portals = {}
	end
	if type(info.Spots) ~= "table" then
		info.Spots = {}
	end
	if type(info.Shop) ~= "table" then
		info.Shop = {}
	end
	if type(info.Shop.Roulettes) ~= "table" then
		info.Shop.Roulettes = {}
	end
	return info
end

-- Phase 5 (10.1 / 10.2, judge m3): NimbusLobby.PartCount = the number of BaseParts under the lobby folder AFTER the last
-- gate builder (DungeonBuilder.Build). The loading screen (ReplicatedFirst) compares the replicated count with it.
local function writePartCount(info)
	local folder = type(info) == "table" and info.Folder or nil
	if typeof(folder) ~= "Instance" then
		return
	end
	local count = folder:IsA("BasePart") and 1 or 0
	for _, inst in ipairs(folder:GetDescendants()) do
		if inst:IsA("BasePart") then
			count = count + 1
		end
	end
	folder:SetAttribute("PartCount", count)
end

-- Global world rules. LightingService applies them too; this copy makes sure they hold even if
-- that service failed to load.
local function applyWorldRules()
	pcall(function()
		Workspace.Gravity = Config.Physics.Gravity
	end)
	pcall(function()
		Workspace.FallenPartsDestroyHeight = -2000
	end)
end

-- Spawn gate. Building the lobby takes a moment; a player who joins meanwhile would spawn at the
-- world origin, far below the village, and fall into the void. So characters are held back until
-- the lobby, PlayerService and the spawn providers are ready, then released.
--
-- Phase 5 (7.2, judge M7 / C17): once PlayerService owns the spawn (PlayerService.SpawnPlayer exists: the main menu
-- lands in wave 3), CharacterAutoLoads stays false for the server's life and PlayerService spawns every character
-- itself (on MenuPlay, after Config.MainMenu.FallbackSeconds, or at once when Config.MainMenu.Enabled is false).
-- Until then (Phase 4 PlayerService) the release re-enables CharacterAutoLoads like before.
local spawnsReleased = false
local releaseTimer = nil -- safety net: releases the gate even if a boot step stalls
local playerServiceSpawns = false -- set once PlayerService is loaded and has SpawnPlayer

local function holdSpawns()
	if spawnsReleased then
		return -- the safety timer already opened the gate; never close it again
	end
	pcall(function()
		Players.CharacterAutoLoads = false
	end)
end

local function releaseSpawns()
	if spawnsReleased then
		return
	end
	spawnsReleased = true
	if releaseTimer then
		pcall(task.cancel, releaseTimer)
		releaseTimer = nil
	end
	if playerServiceSpawns then
		return -- the gate stays closed for good: PlayerService.SpawnPlayer loads every character (7.2)
	end
	pcall(function()
		Players.CharacterAutoLoads = true
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Parent and not player.Character then
			task.spawn(function()
				local ok, err = pcall(function()
					player:LoadCharacter()
				end)
				if not ok then
					warn(TAG .. "LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
				end
			end)
		end
	end
end

----------------------------------------------------------------------
-- 0. Close the spawn gate first thing; a timer guarantees it opens even if a boot step stalls
----------------------------------------------------------------------

step("Hold spawns", holdSpawns)
releaseTimer = task.delay(30, function()
	releaseTimer = nil
	releaseSpawns()
end)

----------------------------------------------------------------------
-- 1. Remotes must exist before any service that grabs them
----------------------------------------------------------------------

step("Remotes.Init", function()
	Remotes.Init()
end)

local LightingService = loadService("LightingService")
local LobbyBuilder = loadService("LobbyBuilder")
local DamageService = loadService("DamageService")
local TokenService = loadService("TokenService")
local DataService = loadService("DataService")
local PlayerService = loadService("PlayerService")
local PetService = loadService("PetService")
local ItemService = loadService("ItemService")
local SpotService = loadService("SpotService")
local HazardService = loadService("HazardService")
local CourseBuilder = loadService("CourseBuilder")
local MatchService = loadService("MatchService")
local PortalService = loadService("PortalService")
-- v3 services (ARCHITECTURE_V3.md)
local IndexService = loadOptionalService("IndexService")
local NpcService = loadOptionalService("NpcService")
local TutorialService = loadOptionalService("TutorialService")
local DevService = loadOptionalService("DevService") -- owner-only developer tools (Config.Dev)
-- Phase 2 services (ARCHITECTURE_V3.md "Phase 2 build contract")
local TycoonService = loadOptionalService("TycoonService")
local PetCareService = loadOptionalService("PetCareService")
local FusionService = loadOptionalService("FusionService")
local GemService = loadOptionalService("GemService")
-- Phase 3 services (ARCHITECTURE_V3.md "Phase 3 build contract")
local ArenaBuilder = loadOptionalService("ArenaBuilder")
local BattleService = loadOptionalService("BattleService")
local EventService = loadOptionalService("EventService")
local StormAltar = loadOptionalService("StormAltar") -- the player's Stormfang landmark (ARCHITECTURE_V3.md section 10)
-- Phase 5 services (ARCHITECTURE_V3.md "Phase 5 build contract" 5.4, 5.5, 6.2)
local DungeonBuilder = loadOptionalService("DungeonBuilder") -- the dungeon gate, templates and runs (dungeon, W3)
local DungeonService = loadOptionalService("DungeonService") -- parties, runs, loot (dungeon, W3)
local GateService = loadOptionalService("GateService") -- the Gate Court prompts (worldlobby, W2)

playerServiceSpawns = type(PlayerService) == "table" and type(PlayerService.SpawnPlayer) == "function"

----------------------------------------------------------------------
-- 2. World: lighting, lobby, altar, arena, dungeon gate, damage, tokens, persistence
----------------------------------------------------------------------

call("LightingService.Init", LightingService, "Init")
step("World rules", applyWorldRules)

-- The Phase 4 LightingService re-enables CharacterAutoLoads; keep the gate closed until the end.
step("Hold spawns", holdSpawns)

local lobbyInfo = call("LobbyBuilder.Build", LobbyBuilder, "Build")
lobbyInfo = normaliseLobbyInfo(lobbyInfo)
if StormAltar then
	call("StormAltar.Build", StormAltar, "Build", lobbyInfo)
end
local arenaInfo = nil
if ArenaBuilder then
	arenaInfo = call("ArenaBuilder.Build", ArenaBuilder, "Build", lobbyInfo)
end
-- Phase 5: the Dungeon gate is the last gate built in the Gate Court; PartCount is written right after it (m3)
local dungeonInfo = nil
if DungeonBuilder then
	dungeonInfo = call("DungeonBuilder.Build", DungeonBuilder, "Build", lobbyInfo)
end
step("NimbusLobby.PartCount", function()
	writePartCount(lobbyInfo)
end)

call("DamageService.Init", DamageService, "Init")
call("TokenService.Init", TokenService, "Init")
call("DataService.StartAutosave", DataService, "StartAutosave")
call("DataService.BindToClose", DataService, "BindToClose")

----------------------------------------------------------------------
-- 3. Economy + spots (subscribe to profile events BEFORE PlayerService starts loading profiles)
----------------------------------------------------------------------

call("PetService.Init", PetService, "Init", lobbyInfo, {
	DataService = DataService,
})

call("ItemService.Init", ItemService, "Init", lobbyInfo, {
	DataService = DataService,
	DamageService = DamageService,
	MatchService = MatchService, -- module table; ItemService only asks it for matches at use time
})

call("SpotService.Init", SpotService, "Init", lobbyInfo, {
	DataService = DataService,
	PetService = PetService,
})

----------------------------------------------------------------------
-- 4. Players: providers first, then Init (which loads profiles and places characters)
----------------------------------------------------------------------

-- Respawns inside a match go to the team checkpoint; MatchService returns nil otherwise (lobby).
if type(MatchService) == "table" and type(MatchService.GetRespawnCFrame) == "function" then
	call("PlayerService.SetSpawnProvider", PlayerService, "SetSpawnProvider", MatchService.GetRespawnCFrame)
else
	warn(TAG .. "no spawn provider: players will always respawn in the lobby")
end

-- Lobby respawns (after the first spawn) go to the owner's spot when they have one.
if type(SpotService) == "table" and type(SpotService.GetSpot) == "function" then
	call("PlayerService.SetHomeProvider", PlayerService, "SetHomeProvider", function(player)
		local spot = SpotService.GetSpot(player)
		if spot then
			return spot.SpawnCFrame
		end
		return nil
	end)
end

-- Pet perks raise max health; a refresh keeps the health fraction.
if type(PetService) == "table" and type(PetService.GetPerks) == "function" then
	call("PlayerService.SetPerkProvider", PlayerService, "SetPerkProvider", PetService.GetPerks)
	if hasSignal(PetService, "PerksChanged") then
		step("PerksChanged wiring", function()
			PetService.PerksChanged:Connect(function(player)
				if type(PlayerService) == "table" and type(PlayerService.RefreshMaxHealth) == "function" then
					local ok, err = pcall(PlayerService.RefreshMaxHealth, player)
					if not ok then
						warn(TAG .. "RefreshMaxHealth failed: " .. tostring(err))
					end
				end
			end)
		end)
	end
else
	warn(TAG .. "no pet perks: max health stays at the base value")
end

call("PlayerService.Init", PlayerService, "Init", lobbyInfo)

----------------------------------------------------------------------
-- 5. Match flow, portals, gates
----------------------------------------------------------------------

call("MatchService.Init", MatchService, "Init", {
	PlayerService = PlayerService,
	DamageService = DamageService,
	DataService = DataService,
	HazardService = HazardService,
	TokenService = TokenService,
	CourseBuilder = CourseBuilder,
	PetService = PetService,
})

if type(ItemService) == "table" and type(ItemService.SetMatchService) == "function" then
	call("ItemService.SetMatchService", ItemService, "SetMatchService", MatchService)
end

call("PortalService.Init", PortalService, "Init", lobbyInfo, MatchService)

-- Phase 5 (6.2): the Gate Court prompts (the Altar gate; Phase 6: no Home gate; the Obby and Dungeon gates are their services')
if GateService then call("GateService.Init", GateService, "Init", lobbyInfo, {
	SpotService = SpotService,
	PortalService = PortalService,
	StormAltar = StormAltar,
	ArenaInfo = arenaInfo, -- the Arena gate teleports to ArenaInfo.Spawn
	MatchService = MatchService,
	DataService = DataService,
}) end

-- v3: Pet Index rewards, lobby NPC pets, new-player tutorial (each handles players who joined before Init).
if IndexService then call("IndexService.Init", IndexService, "Init", { DataService = DataService, PetService = PetService }) end
if NpcService then call("NpcService.Init", NpcService, "Init", lobbyInfo, {}) end
if TutorialService then call("TutorialService.Init", TutorialService, "Init", lobbyInfo, {
	DataService = DataService,
	PetService = PetService,
	MatchService = MatchService,
	SpotService = SpotService,
	IndexService = IndexService,
	BattleService = BattleService, -- Phase 3: tutorial chapter 3 listens to BattleService.BattleEnded
	ArenaInfo = arenaInfo,
	DungeonInfo = dungeonInfo, -- Phase 5: chapter 3 points at the Dungeon gate (the module tables below Init later)
	DungeonService = DungeonService,
}) end
-- Phase 4: TycoonService (the home portal), PetCareService (feeding / evolving / training) and FusionService refuse
-- pets in a running battle or Champion Ring run: they get BattleService's module table now (its Init runs below).
if TycoonService then call("TycoonService.Init", TycoonService, "Init", lobbyInfo, {
	DataService = DataService,
	PetService = PetService,
	SpotService = SpotService,
	BattleService = BattleService,
}) end
if PetCareService then call("PetCareService.Init", PetCareService, "Init", {
	DataService = DataService,
	PetService = PetService,
	TycoonService = TycoonService,
	BattleService = BattleService,
}) end
if FusionService then call("FusionService.Init", FusionService, "Init", {
	DataService = DataService,
	PetService = PetService,
	TycoonService = TycoonService,
	BattleService = BattleService,
}) end
if GemService then call("GemService.Init", GemService, "Init", {
	DataService = DataService,
	PetService = PetService,
}) end
if BattleService then call("BattleService.Init", BattleService, "Init", {
	DataService = DataService,
	PetService = PetService,
	PetCareService = PetCareService,
	TycoonService = TycoonService,
	ArenaBuilder = ArenaBuilder,
	ArenaInfo = arenaInfo,
}) end
-- Phase 5 (5.4, C16): the dungeon lands AFTER BattleService and registers itself with BattleService.SetRunProvider
-- inside its own Init; BattleService never requires DungeonService.
if DungeonService then call("DungeonService.Init", DungeonService, "Init", {
	DataService = DataService,
	PetCareService = PetCareService,
	TycoonService = TycoonService,
	BattleService = BattleService,
	DungeonBuilder = DungeonBuilder,
	DungeonInfo = dungeonInfo,
	LobbyInfo = lobbyInfo,
	PetService = PetService,
}) end
if EventService then call("EventService.Init", EventService, "Init", {
	DataService = DataService,
	BattleService = BattleService,
	PetCareService = PetCareService,
	ArenaInfo = arenaInfo,
}) end
if DevService then call("DevService.Init", DevService, "Init", {
	DataService = DataService,
	PetService = PetService,
	TutorialService = TutorialService,
	IndexService = IndexService,
	BattleService = BattleService, -- Phase 3: /raid and the DEV panel's raid button
	EventService = EventService,
	DungeonService = DungeonService, -- Phase 5: /reset is refused during a dungeon run
}) end

----------------------------------------------------------------------
-- 6. Dash relay: validate the cooldown server-side, then show the trail to everyone
----------------------------------------------------------------------

step("Dash remote", function()
	local dashRemote = Remotes.Get("Dash")
	local dashFx = Remotes.Get("DashFx")
	local lastDash = {} -- [player] = os.clock() of the last accepted dash
	-- The client enforces the exact cooldown; allow 20% slack for latency and frame timing.
	local minInterval = Config.Physics.DashCooldown * 0.8

	dashRemote.OnServerEvent:Connect(function(player)
		if player:GetAttribute(Config.Attr.Downed) == true then
			return
		end
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		local now = os.clock()
		local last = lastDash[player]
		if last and now - last < minInterval then
			return
		end
		lastDash[player] = now
		dashFx:FireAllClients(player.UserId)
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastDash[player] = nil
	end)
end)

-- Everything is wired: let characters spawn (providers are set, the lobby exists). With a Phase 5 PlayerService the
-- gate stays closed and PlayerService spawns the characters itself (7.2).
step("Release spawns", releaseSpawns)

print(TAG .. "ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="832">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="833">
          <Properties>
            <string name="Name">ArenaBuilder</string>
            <string name="Source"><![CDATA[-- ArenaBuilder (Phase 3, arenaworld; Phase 5 worldlobby: the Trials are gone, the two Gate Court gates are built with
-- WorldStyle.BuildGate): the Battle Arena island, Portal_Ring + Portal_Arena in the plaza's Gate Court and the private
-- Champion Ring pockets in the sky, in the DETAILED VOXEL style (ARCHITECTURE_V3.md "Phase 3: Pet battles", "Phase 3 build contract"
-- and its "Interfaces between the Phase 3 modules"; ART DIRECTION; World text rule). A server module: Main calls
-- Build(lobbyInfo) once after the lobby; BattleService / EventService / TutorialService get the ArenaInfo it returns.
--
-- Contract API:
--   ArenaBuilder.Build(lobbyInfo) -> ArenaInfo    builds workspace.BattleArena (safe to call again: rebuilds)
--     ArenaInfo = {
--       Model        = workspace.BattleArena (Model)
--       Center       = CFrame   the colosseum floor centre on the walking surface, LookVector = towards the lobby (the
--                               main gate, the forum and the bridge are on that side)
--       Floor        = { CFrame, Size, Zone }   the boss stage (Mode "Raid"): CFrame on the floor surface at the
--                               colosseum centre (rotated like Center), Size = the battle floor (X, height, Z: studs; X / Z
--                               = BattleCatalog.Zones.Raid), Zone = its NC_BattleZone part
--       Rings        = { { CFrame, Size, Pads = { BasePart... }, Zone, Index }... }   the duel rings (Mode "Duel"); the
--                               challenge pads carry the "Arena" prompts
--       Spawn        = CFrame   arrival point on the forum (the Arena Gate teleport lands here), looking at the gate
--       ReturnCFrame = CFrame   on the plaza in front of Portal_Ring, looking at the plaza (ring climbers come back)
--       RingPortal   = BasePart (Phase 4) the Champion Ring portal's pad (Portal_Ring in the Gate Court, prompt
--                               "RingPrompt" with OpenPanel = "Ring"; ring starts are accepted near it). RingSite = the
--                               gate centre (LobbyInfo.GateSites.Ring, LookVector = towards the plaza)
--       ArenaPortal  = BasePart (Phase 5) Portal_Arena's prompt part (ArenaPortalPrompt -> Spawn)
--       LobbyCFrame  = CFrame   (Phase 5) in front of Portal_Arena, looking at the plaza (the forum's Return gate)
--       -- extras
--       Radius, Bounds = { CFrame, Size }   the island (InArena uses its real outline); Link = "Bridge" | "Portal"
--       EventBoard = { Model, Gui, Labels }, Leaderboard = { Model, Gui, Rows }   the SurfaceGuis (see ApplyArenaState)
--       ApplyArenaState = ArenaBuilder.ApplyArenaState, InArena = ArenaBuilder.InArena
--     }
--   ArenaBuilder.BuildPocket(index, kind) -> { Model, CFrame, Size, Spawn, Zone, Index, Kind } | nil
--       a private battle pocket (index 1..MAX_POCKETS), cloned from one template, far out in the sky on its own grid
--       cell; CFrame = floor surface centre (axis aligned), Size = the battle floor (BattleCatalog.Zones.Ring), Spawn =
--       where the fighter stands (side 1, -Z, looking at the enemy side). Phase 5: the only kind is "Ring" (nil and
--       unknown kinds build it too; the Trial pocket is deleted): the Champion Ring, a round ring (16-gon floor of
--       apothem 33: the 44 x 44 square fits at any rotation) with a gold rim, four crown posts and a small cheering crowd of cloud puffs on a cloud bleacher behind the champion's
--       side (<= 220 parts, zone Mode "Ring", ZoneId "Ring"). Building an index that exists returns it.
--   ArenaBuilder.FreePocket(zone)              removes that pocket (the table from BuildPocket, its index or Model)
--   ArenaBuilder.ApplyArenaState(state)        EventService: draws the ArenaState table (the same one it broadcasts:
--       { Next = { Kind, BossId, StartsIn }, Raid = { Active, BossId, Hp, MaxHp, Players, EndsIn }, Double = { Active,
--       EndsIn }, Leaderboard = { { UserId, Name, Trophies }... } }) on the event board and the trophy leaderboard; the
--       countdowns tick down every second between two states. Without any state for a while the boards show the
--       schedule and the trophies of the players in the server (DataService) on their own.
--   ArenaBuilder.InArena(position) -> bool      on (or just above) the arena island
--   ArenaBuilder.ZoneAt(position) -> part|nil   the NC_BattleZone part that contains the position
--   ArenaBuilder.GetInfo() / GetPocket(index)   what was built
--   ArenaBuilder.Teleported                     Util.Signal: Fire(player, "Arena" | "Lobby", source) after a teleport
--
-- World (island-local frame: origin = colosseum floor centre on the walking surface, -Z = towards the lobby):
--   * placed beyond the home plots on the ray of LobbyInfo.ArenaAngle (the spoke just past the last portal), at the
--     first distance where nothing of the lobby (homes, gardens, the Storm Altar, sky clouds) comes near its outline;
--     the sky dragon flies 120+ studs higher. Linked to the plaza by a stone BRIDGE that leaves the street at
--     LobbyInfo.ArenaDock (the junction's outer rail is open there) and runs straight between the two plots, with an
--     entrance arch ("BATTLE ARENA") and torches in the element colours. Phase 5: Portal_Arena in the Gate Court and the
--     Return gate on the forum link it too, always (the bridge stays when its corridor is clear).
--   * Island: a big puffy voxel cloud; the forum in front (paving, the avenue with a crimson runner, torches, a golden
--     trophy statue, banners, planters) and the COLOSSEUM behind: a 16-sided stadium whose sand floor (apothem 72)
--     holds the raid zone at any rotation, an element wheel in its centre, a podium wall, four tiers of seats in the
--     eight element colours, an outer wall with blind arches, element banners and crenellations, pillars with
--     braziers; the main gate (sign "BATTLE ARENA", an "Arena" prompt), two side gates and the boss gate at the back.
--   * Two DUEL RINGS on the forum (16-sided, apothem 33: the duel zone fits at any rotation) with a coloured curb,
--     torch posts, a crossed-swords emblem and two challenge pads each (prompt "Duel", attribute OpenPanel = "Arena").
--   * The EVENT BOARD and the TROPHY LEADERBOARD: free-standing stone frames flanking the avenue in front of the main
--     gate, SurfaceGuis at 50 px per stud (titles >= 1.1 studs, every line >= 0.6 stud).
--   * Battle zones: invisible parts tagged NC_BattleZone with the attributes Mode ("Raid" | "Duel" | "Ring"), Size
--     (Vector3, the battle floor: X, height, Z), ZoneId and Index; the part itself covers the floor plus a small margin
--     (where the controls work). CanCollide / CanTouch / CanQuery false: test membership with the part's CFrame + Size.
--   * The Gate Court gates (Phase 5, 6.1 / 6.2, C4 / C12): Portal_Ring and Portal_Arena are WorldStyle.BuildGate gates
--     at LobbyInfo.GateSites.Ring / .Arena, parented to LobbyInfo.GatesFolder (workspace.NimbusLobby.Gates; the arena
--     island's budget no longer holds them). Portal_Ring: gold, the crown glyph, a pad, two crowned pedestals, the
--     prompt "RingPrompt" (OpenPanel = "Ring") on the pad and the tag "Champion Ring" / "Beat the champion, meet a
--     stronger one" with the pill "Best in this server: Alex - Round 31" drawn from the RingBoard attribute
--     BattleService writes on the model (or its pad) when a run ends ("Alex|31;Sam|24;Kim|20"). Portal_Arena: red, the
--     swords glyph, two torches, "ArenaPortalPrompt" (Travel / Battle Arena) -> ArenaInfo.Spawn; the forum's Return
--     gate ("ArenaReturnPrompt") lands in front of it (ArenaInfo.LobbyCFrame). Each gate <= 120 parts.
--   * Safe zones (contract 3.11): battles start only inside NC_BattleZone parts (the raid floor, the duel rings, the
--     ring pockets); the plaza, the forum, the stands, the bridge and the gates have none.
--   * The home Arena Gate (HomeBuilder's ArenaGatePrompt) teleports its owner to ArenaInfo.Spawn: refused in a match
--     or a battle, only near the gate, rate limited; the Arena / Return gates use the same checks.
-- Look (Phase 6 A1: back to the Phase 4 look, 7aa0df2; the helper table `Art`): every world part SmoothPlastic (Neon
-- for glow, Glass / ForceField for water and shimmer), the P4 arena palette `C` (light cream stone colosseum walls,
-- white marble trims, golden sand floors, a lime lawn, cream paving, a crimson carpet, gold trim, seats and banners in
-- the full element colours), blocky voxel shapes only (square posts, no Cylinder / Ball), P4 white / light-blue voxel
-- clouds tagged NC_StyleExempt, warm lanterns (<= 1.5, range <= 16, no shadows), small parts cast no shadow, pure
-- decor tagged NC_Detail. Art.enforce is a safety net (the attribute ArtFixes counts what it had to fix: 0 when every
-- piece is built in the look). Budgets: the arena <= 2800 parts (10.3), a ring pocket <= 250. Portal_Ring /
-- Portal_Arena / Portal_Return are WorldStyle.BuildGate gates (the P4 hoop family, 6.0.3).
-- No server-side animation (Replication rule): torches, glows and particles only. Every text uses Theme roles.
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local ArenaBuilder = {}
ArenaBuilder.Teleported = Util.Signal()

local function loadShared(name)
	local inst = Shared:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[ArenaBuilder] shared/" .. name .. " unavailable: " .. tostring(result))
	return nil
end

local Voxel = loadShared("Voxel")
local Remotes = loadShared("Remotes")
local WorldStyle = loadShared("WorldStyle") -- the Phase 5 art kit (Kerb, Chamfer, BuildGate, Tags)

-- other engineers' modules, resolved when first needed (a build may not have them yet)
local lazyCache = {}
local function lazy(key, find)
	local entry = lazyCache[key]
	if entry == nil then
		entry = false
		local inst = find()
		if inst then
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				entry = result
			end
		end
		lazyCache[key] = entry
	end
	return entry or nil
end
local function battleCatalog()
	return lazy("BattleCatalog", function()
		return Shared:FindFirstChild("BattleCatalog")
	end)
end
local function dataService()
	return lazy("DataService", function()
		return script.Parent and script.Parent:FindFirstChild("DataService")
	end)
end

local floor, ceil, sqrt, abs, max, min = math.floor, math.ceil, math.sqrt, math.abs, math.max, math.min
local sin, cos, rad, pi = math.sin, math.cos, math.rad, math.pi

local function atan2(y, x)
	if math.atan2 then
		return math.atan2(y, x)
	end
	return math.atan(y, x)
end

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------
local MAT = Enum.Material
local LOBBY = Config.Lobby
local ORIGIN = LOBBY.Origin
local TOP = ORIGIN.Y -- the lobby's walking height; the arena island's walking surface is at the same height
local ARENA_NAME = "BattleArena"
local ZONE_TAG = "NC_BattleZone"
local ATTR_IN_BATTLE = "InBattle" -- BattleService's player attribute (battle id) from the contract
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local SEED = 20261011
local DEFAULT_ANGLE = 202.5 -- the arena's direction from the plaza when the lobby reserves none
local STEP16 = pi * 2 / 16
local TAN16 = math.tan(pi / 16) -- half width per stud of apothem of a 16-sided polygon (tan 11.25 degrees)
local PART_BUDGET = 2800 -- the island and its bridge (Phase 5 10.3: arena <= 2800; its gates stand in the Gate Court)
local POCKET_BUDGET = 250
local MAX_POCKETS = 64
local POCKET_ORIGIN = Vector3.new(-3600, 1500, -3600) -- far from the lobby, the obby match slots (+X) and each other
local POCKET_SPACING = 380
local POCKET_COLUMNS = 8
local ZONE_H = 30 -- studs: height of a battle zone part (from 4 under the floor)
local PROMPT_RANGE = 10
local TELEPORT_COOLDOWN = 2 -- seconds between two teleports of one player (Arena Gate / fallback portals)
local TELEPORT_SLACK = 8 -- studs beyond a prompt's range that still count as "at the gate" (latency)
local BOARD_SILENCE = 20 -- seconds without an ApplyArenaState before the boards fill themselves in
local FALLBACK_REFRESH = 10 -- seconds between two self-made leaderboards

-- Battle floor sizes (BattleCatalog.Zones; local defaults when the catalog is missing or odd). The floors are built
-- so that these squares fit at ANY rotation: the colosseum floor's apothem 72 holds a 96 x 96 square (half diagonal
-- 67.9), a duel ring's apothem 33 holds 44 x 44 (31.1), a pocket's 64 x 64 square floor holds 56 x 56.
local DEFAULT_ZONES = { Raid = { X = 96, Z = 96 }, Duel = { X = 44, Z = 44 }, Ring = { X = 44, Z = 44 } }
local MAX_ZONE = { Raid = 100, Duel = 45, Ring = 45 } -- the biggest square each floor can hold

-- Island layout (island-local studs; the colosseum centre is the origin, -Z points at the lobby)
local ISL = {
	FrontZ = -205, -- the forum's front edge (the bridge docks here)
	HalfW = 103, -- forum half width (Phase 5: = DiscR, so the forum's long sides run straight into the disc's side edges)
	BackZ = -20, -- the forum rectangle reaches into the colosseum disc up to here
	DiscR = 103, -- the colosseum disc: a 16-gon (apothem 103) around the stands, like the colosseum itself
	Corner = 30, -- forum corner radius
	Clearance = 14, -- studs kept between the island's cloud and anything of the lobby
}
local COL = {
	FloorR = 72, -- floor apothem
	PodiumR = 74, -- podium wall 72..74, cap on top (top at 6)
	Tier0 = 74, -- tiers: 4 x 4 studs deep, tops 7 / 9 / 11 / 13
	Tiers = 4,
	TierDepth = 4,
	WallIn = 90, -- outer wall 90..92, top 20, merlons to 22
	WallOut = 92,
	WallH = 20,
	PillarOut = 97,
	GateHalf = 6, -- passages are 13 studs wide (|x| <= 6.5)
	GateH = 13,
}
local RING_A = 33 -- duel ring apothem
local RING_Y = 0.6 -- duel ring floor top above the forum
local RINGS = {
	{ X = -52, Z = -150, Accent = Color3.fromRGB(226, 84, 86), Name = "Duel Ring 1" },
	{ X = 52, Z = -150, Accent = Color3.fromRGB(84, 146, 232), Name = "Duel Ring 2" },
}
local BRIDGE_W = 12

----------------------------------------------------------------------
-- Palette: the lobby's calm stone and cloud colours, gold trim, battle crimson and the eight element colours
----------------------------------------------------------------------
local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local C = {
	CloudLight = rgb(244, 247, 252),
	Cloud = rgb(232, 238, 249),
	CloudShade = rgb(212, 222, 241),
	Mist = rgb(194, 211, 240),
	MistDark = rgb(170, 190, 228),
	Stone = rgb(208, 202, 190),
	StoneLight = rgb(226, 221, 209),
	StoneDark = rgb(172, 164, 154),
	StoneEdge = rgb(146, 138, 132),
	Marble = rgb(236, 230, 218),
	Paving = rgb(214, 206, 192),
	PavingLight = rgb(228, 222, 208),
	PavingDark = rgb(192, 184, 170),
	PavingWorn = rgb(203, 195, 181),
	PavingWarm = rgb(224, 212, 190),
	Sand = rgb(234, 210, 160),
	SandDark = rgb(214, 186, 136),
	SandLight = rgb(242, 224, 182),
	SandDrift = rgb(222, 196, 146),
	Gold = rgb(244, 198, 84),
	GoldDark = rgb(206, 154, 62),
	Iron = rgb(64, 70, 92),
	IronLight = rgb(96, 104, 130),
	Crimson = rgb(204, 62, 72),
	CrimsonDark = rgb(150, 42, 54),
	Navy = rgb(34, 42, 76),
	Violet = rgb(68, 60, 118),
	Recess = rgb(70, 74, 104),
	Grass = rgb(108, 186, 86),
	GrassLight = rgb(132, 202, 98),
	GrassDark = rgb(86, 160, 76),
	Hedge = rgb(74, 146, 72),
	Soil = rgb(120, 86, 64),
	Steel = rgb(214, 222, 236),
	Lamp = rgb(255, 214, 140),
	Text = rgb(238, 243, 252),
	TextGold = rgb(246, 216, 132),
	TextDim = rgb(206, 216, 240),
	Ink = (Theme.Colors and Theme.Colors.TextStroke) or rgb(16, 22, 50),
}

local ELEMENTS = {} -- { { Id, Color } } in Config.Elements.Order
do
	local cfg = Config.Elements
	local order = (type(cfg) == "table" and type(cfg.Order) == "table") and cfg.Order or { "Water", "Flame", "Frost", "Nature", "Earth", "Storm", "Celestial", "Shadow" }
	for _, id in ipairs(order) do
		local info = type(cfg) == "table" and type(cfg.Info) == "table" and cfg.Info[id]
		ELEMENTS[#ELEMENTS + 1] = { Id = id, Color = (info and typeof(info.Color) == "Color3") and info.Color or C.Gold }
	end
end
local function elementColor(i)
	local e = ELEMENTS[((i - 1) % #ELEMENTS) + 1]
	return e and e.Color or C.Gold
end
local function flameColor(color)
	return color:Lerp(rgb(255, 250, 230), 0.18)
end

local GLYPH = {
	Trophy = "\240\159\143\134",
	Swords = "\226\154\148",
	Dot = "\194\183",
	Dash = "\226\128\147",
	Clock = "\226\143\176",
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	if parent then
		m.Parent = parent
	end
	return m
end

-- One anchored block. opts: Collide, Query, Material, Transparency, Shadow.
-- Phase 6 A1 (back to the P4 look): the only materials a part may use
local P4_MATS = { [MAT.SmoothPlastic] = true, [MAT.Neon] = true, [MAT.Glass] = true, [MAT.ForceField] = true }

local function box(parent, name, cf, size, color, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	local mat = opts.Material or MAT.SmoothPlastic
	if not P4_MATS[mat] then
		mat = MAT.SmoothPlastic -- Phase 6 A1: SmoothPlastic look (Glass / Neon / ForceField stay)
	end
	p.Material = mat
	p.Transparency = opts.Transparency or 0
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.Collide == true
	p.CanQuery = opts.Collide == true or opts.Query == true
	p.CanTouch = false
	if opts.Shadow ~= nil then
		p.CastShadow = opts.Shadow == true
	else
		p.CastShadow = max(size.X, size.Y, size.Z) >= 4
	end
	p.Parent = parent
	return p
end

local function anchorPart(parent, name, cf, size)
	return box(parent, name, cf, size or Vector3.new(1, 1, 1), C.Cloud, { Transparency = 1, Shadow = false })
end

local FADE_IN_OUT = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.25, 0.2),
	NumberSequenceKeypoint.new(0.75, 0.2),
	NumberSequenceKeypoint.new(1, 1),
})

local function popSize(maxSize)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, maxSize),
		NumberSequenceKeypoint.new(1, 0),
	})
end

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.Color = ColorSequence.new(C.TextGold)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = 5
	e.Lifetime = NumberRange.new(1.2, 2)
	e.Speed = NumberRange.new(1, 2)
	e.Size = popSize(0.6)
	e.Transparency = FADE_IN_OUT
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	for k, v in pairs(props or {}) do
		e[k] = v
	end
	e.Parent = parent
	return e
end

local function pointLight(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

local function countParts(root)
	local n = 0
	if not root then
		return 0
	end
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

-- flat look: a CFrame at `pos` facing `target` horizontally
local function flatLook(pos, target)
	local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	if d.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + d)
end

local function polar(angleDeg, radius, y)
	local a = rad(angleDeg)
	return Vector3.new(ORIGIN.X + cos(a) * radius, y or TOP, ORIGIN.Z + sin(a) * radius)
end

-- Clones a template built around the origin to `cf` (every part moved; attachments ride their parts).
local function place(tpl, cf, parent, name)
	if not tpl then
		return nil
	end
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	if m:IsA("BasePart") then
		m.CFrame = cf * m.CFrame
	end
	if name then
		m.Name = name
	end
	m.Parent = parent
	return m
end

local function recolor(root, name, color)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == name then
			d.Color = color
		end
	end
end

----------------------------------------------------------------------
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7, owner art-arenadungeon): Blender mesh dressing. Every Part build in
-- this file stays exactly as it is (the fallback, the colliders, every name / prompt / zone / sign). The static
-- decoration subtrees are tagged with MeshLibrary.Tag(target, key, look, keep) and clients Dress them (Parts hidden
-- locally, Keep parts stay: Neon flames / glows and sign panels). Keys: blender/catalog/arenadungeon.json (baked by
-- blender/kit/props/arena.py from this very build). A key is tagged only once it has an uploaded id
-- (MeshLibrary.Status ~= "missing": the shipped empty MeshIds change nothing) and only while the live build still
-- matches the manifest's "LayoutSig" attachment (part count + position / size sums in origin space), so a layout
-- change can never show a stale mesh (scaled pieces, the trees, carry none). Targets never nest (one dress each).
----------------------------------------------------------------------
local Mesh = { Lib = nil, Placed = setmetatable({}, { __mode = "k" }) } -- Placed: target -> its Tag call (tests, the kit)

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

-- part count + weighted sums of every visible BasePart's position / size in `origin` space, divided by `scale`, the
-- keep names left out (blender/kit/props/arena.py stores the same numbers in the key's LayoutSig)
function Mesh.Signature(target, origin, scale, keep)
	local inv = origin:Inverse()
	local s = tonumber(scale) or 1
	local kept = {}
	for _, k in ipairs(keep or {}) do
		kept[k] = true
	end
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 and not kept[d.Name] then
			local p = inv * d.Position
			local z = d.Size
			n = n + 1
			a = a + (p.X + p.Y * 0.37 + p.Z * 0.61) / s
			b = b + (z.X + z.Y * 1.3 + z.Z * 1.7) / s
		end
	end
	return n, a, b
end

function Mesh.sigOk(ML, key, target, origin, scale, keep)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	if not man then
		return false
	end
	local att = man.Attachments and man.Attachments.LayoutSig
	if not att then
		return true -- a scaled piece (the trees): no layout to match
	end
	local pos = att.Pos or att.pos
	if type(pos) ~= "table" then
		return false
	end
	local n, a, b = Mesh.Signature(target, origin, scale, keep)
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- target: Model subtree; key: mesh key; origin: world CFrame of the mesh pivot; look: { Primary, Secondary } (the tint
-- parts); keep: part names that stay visible; scale: uniform placement scale (nil = 1). Returns true when tagged.
function Mesh.tag(target, key, origin, look, keep, scale)
	if typeof(target) ~= "Instance" or typeof(origin) ~= "CFrame" then
		return false
	end
	Mesh.Placed[target] = { Key = key, Origin = origin, Look = look, Keep = keep, Scale = scale }
	local kit = ArenaBuilder._Kit
	if type(kit) == "table" and type(kit.Targets) == "table" then
		kit.Targets[#kit.Targets + 1] = { Key = key, Target = target, Origin = origin, Look = look, Keep = keep, Scale = scale }
	end
	local ML = Mesh.lib()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" or not Mesh.sigOk(ML, key, target, origin, scale, keep) then
		return false
	end
	local tagLook = {}
	for k, v in pairs(look or {}) do
		tagLook[k] = v
	end
	local pivot = target:IsA("BasePart") and target.CFrame or target:GetPivot() -- (a Part's pivot: PivotOffset is never set here)
	tagLook.Offset = pivot:Inverse() * origin
	if scale and scale ~= 1 then
		target:SetAttribute("ML_Scale", scale)
	end
	ML.Tag(target, key, tagLook, keep)
	return true
end

-- the first BasePart named `name` under root (the tint colour a mesh part takes)
function Mesh.colorOf(root, name)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == name then
			return d.Color
		end
	end
	return nil
end

-- keep lists (parts that stay visible over a dressed piece)
Mesh.Keep = {
	Flame = { "Flame" },
	Floor = { "ElementGem" },
	Ring = { "Flame", "CurbInlay", "PadGlow" },
	Board = { "Panel", "Flame" },
	Lantern = { "LanternLamp" },
	Trophy = { "TrophyStar", "Gem" },
	Bridge = { "Flame", "ArchSign" },
	Pocket = { "RingRimInlay", "EmblemGem", "CrownGem", "SpawnGlow", "ChampionGlow" },
}
ArenaBuilder._Mesh = Mesh

----------------------------------------------------------------------
-- Voxel helpers
----------------------------------------------------------------------
local VX = {}

function VX.Fill(g, x0, x1, y0, y1, z0, z1, key)
	for y = y0, y1 do
		for x = x0, x1 do
			for z = z0, z1 do
				Voxel.Set(g, x, y, z, key)
			end
		end
	end
end

function VX.Disc(g, cx, cz, r, y0, y1, key, keep)
	local ri = ceil(r) + 1
	local r2 = r * r
	for y = y0, y1 do
		for x = floor(cx) - ri, ceil(cx) + ri do
			for z = floor(cz) - ri, ceil(cz) + ri do
				local dx, dz = x - cx, z - cz
				if dx * dx + dz * dz <= r2 and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

function VX.RoundRect(g, cx, cz, sx, sz, round, y0, y1, key, keep)
	local hx, hz = sx / 2, sz / 2
	round = max(0, min(round, hx, hz))
	for y = y0, y1 do
		for x = floor(cx - hx) - 1, ceil(cx + hx) + 1 do
			for z = floor(cz - hz) - 1, ceil(cz + hz) + 1 do
				local qx, qz = abs(x - cx) - (hx - round), abs(z - cz) - (hz - round)
				local ox, oz = max(qx, 0), max(qz, 0)
				local d = sqrt(ox * ox + oz * oz) + min(max(qx, qz), 0)
				if d <= round and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- Voxel.Build with this file's defaults. o: V, Pal, Name, CF (where voxel 0,0,0 sits), Parent, Collide, MaxParts,
-- Keep, Shadow.
function VX.Build(g, o)
	if not g or g.Count == 0 then
		return nil
	end
	local model = Voxel.Build(g, {
		VoxelSize = o.V or 1,
		Palette = o.Pal,
		Name = o.Name or "Voxels",
		CFrame = o.CF or CFrame.new(),
		CanCollide = o.Collide == true,
		CanQuery = o.Collide == true,
		MaxParts = o.MaxParts,
		Keep = o.Keep,
		CastShadow = o.Shadow,
	})
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and not P4_MATS[p.Material] then
			p.Material = MAT.SmoothPlastic -- Phase 6 A1 (palette entries may still name a Phase 5 material)
		end
	end
	if o.Parent then
		model.Parent = o.Parent
	end
	return model
end

-- hash noise in [0, 1) and smooth value noise (deterministic)
local function hash3(x, y, z, seed)
	local h = (x * 73856093 + y * 19349663 + z * 83492791 + (seed or 0) * 2654435761) % 2147483647
	h = (h * 16807) % 2147483647
	local a = h % 65521
	a = (a * a + (seed or 0) * 7919 + 12345) % 65521
	h = ((h + a * 32771) * 16807) % 2147483647
	return (h % 1000003) / 1000003
end

local function vnoise(x, z, scale, seed)
	local fx, fz = x / scale, z / scale
	local ix, iz = floor(fx), floor(fz)
	local tx, tz = fx - ix, fz - iz
	tx = tx * tx * (3 - 2 * tx)
	tz = tz * tz * (3 - 2 * tz)
	local a = hash3(ix, 0, iz, seed)
	local b = hash3(ix + 1, 0, iz, seed)
	local c = hash3(ix, 0, iz + 1, seed)
	local d = hash3(ix + 1, 0, iz + 1, seed)
	return (a + (b - a) * tx) + ((c + (d - c) * tx) - (a + (b - a) * tx)) * tz
end

local TIER_KEYS = { "CloudLight", "Cloud", "CloudShade", "Mist", "MistDark" }
-- Phase 5 (6.4 rule 9): the voxel clouds are shaded for the pink sky (tops 250,244,252; sides 226,214,240;
-- undersides 186,172,222) and tagged NC_StyleExempt (they keep their voxel look on purpose)
local CLOUD_PAL = { -- P4 white / light-blue clouds (style.md 4)
	CloudLight = C.CloudLight,
	Cloud = C.Cloud,
	CloudShade = C.CloudShade,
	Mist = C.Mist,
	MistDark = C.MistDark,
}

-- A voxel cloud from a footprint signed distance. spec: V (studs per voxel), Sdf(x, z) -> studs (negative inside),
-- Bounds = { x0, x1, z0, z1 } studs, Tiers = { { Inset, H }... } from the top level (0) down, Puffs / Rim =
-- { { x, y, z, rx, ry, rz }... } studs (relative to the top centre), Carve(x, y, z) -> remove?, Seed.
local function cloudGrid(spec)
	local V = spec.V or 3
	local g = Voxel.NewGrid(16)
	local b = spec.Bounds
	for i = floor(b[1] / V), ceil(b[2] / V) do
		for k = floor(b[3] / V), ceil(b[4] / V) do
			local d = spec.Sdf(i * V, k * V)
			local y = 0
			for ti, t in ipairs(spec.Tiers) do
				local h = t.H or 1
				if d <= -(t.Inset or 0) then
					for yy = y - h + 1, y do
						Voxel.Set(g, i, yy, k, TIER_KEYS[min(ti, #TIER_KEYS)])
					end
				end
				y = y - h
			end
		end
	end
	for _, p in ipairs(spec.Puffs or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Puff", KeepExisting = true })
	end
	for _, p in ipairs(spec.Rim or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Rim", KeepExisting = true })
	end
	if spec.Carve then
		local remove = {}
		for key in pairs(g.Cells) do
			local x, yy, z = Voxel.Unpack(key)
			if spec.Carve(x * V, yy * V, z * V) then
				remove[#remove + 1] = key
			end
		end
		for _, key in ipairs(remove) do
			g.Cells[key] = nil
			g.Count = g.Count - 1
		end
	end
	Voxel.Shade(g, { Only = { Puff = true, Rim = true }, Smooth = 2, Seed = spec.Seed or 1 })
	Voxel.Remap(g, {
		Puff = "Cloud",
		Puff_Light = "CloudLight",
		Puff_Dark = "Mist",
		Rim = "Cloud",
		Rim_Light = "CloudLight",
		Rim_Dark = "CloudShade",
	})
	return g
end

-- A small puffy cloud (a support under a bridge), top at y = 0
local function puffTemplate(scale)
	local s = scale or 1
	local g = cloudGrid({
		V = 2,
		Sdf = function(x, z)
			return sqrt(x * x + z * z) - 6 * s
		end,
		Bounds = { -8 * s, 8 * s, -8 * s, 8 * s },
		Tiers = { { Inset = 0, H = 1 }, { Inset = 2, H = 1 } },
		Puffs = {
			{ 5 * s, -1.5, 2 * s, 5 * s, 3.5 * s, 4.5 * s },
			{ -5 * s, -2, -1.5 * s, 5.5 * s, 4 * s, 5 * s },
			{ 0, -4 * s, 0, 6 * s, 4.5 * s, 6 * s },
		},
		Seed = 3,
	})
	return VX.Build(g, { V = 2, Pal = CLOUD_PAL, Name = "CloudPuff", CF = CFrame.new(0, -1, 0), MaxParts = 16 })
end

----------------------------------------------------------------------
-- GUI helpers (World text rule: pixel-sized tags, signs at 50 px per stud; Theme font roles only)
----------------------------------------------------------------------
local SIGN_PPS = 50
local TAG_RANGE = 110

local function rounded(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function outline(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function vgradient(parent, top, bottom)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

local function padding(parent, top, left, bottom, right)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, top)
	p.PaddingLeft = UDim.new(0, left)
	p.PaddingBottom = UDim.new(0, bottom or top)
	p.PaddingRight = UDim.new(0, right or left)
	p.Parent = parent
	return p
end

local function listLayout(parent, direction, gap)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 0)
	l.Parent = parent
	return l
end

local function plainFrame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

-- Pixel-sized tag on `adornee`: the transparent w x h container's BOTTOM edge sits `lift` studs over the adornee.
local function newTag(adornee, name, w, h, lift, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name or "Tag"
	gui.Size = UDim2.fromOffset(w, h)
	gui.SizeOffset = Vector2.new(0, 0.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift or 0, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or TAG_RANGE
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

-- the compact solid plate of a tag (navy gradient, rounded, outlined), sized to its content
local function tagPlate(gui, edge, minW)
	local plate = plainFrame(gui, "Plate", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(minW or 0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.04,
	})
	rounded(plate, 16)
	outline(plate, edge or C.TextGold, 3.5)
	vgradient(plate, (Theme.Colors and Theme.Colors.PanelLight) or C.Violet, (Theme.Colors and Theme.Colors.Panel) or C.Navy)
	padding(plate, 7, 16, 9)
	listLayout(plate, Enum.FillDirection.Vertical, 2)
	return plate
end

local function tagText(parent, name, text, role, size, color, order)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color or C.Text,
		Stroke = 1,
		Outline = 2.5,
		OutlineColor = C.Ink,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, size + 4),
			TextWrapped = false,
			LayoutOrder = order or 0,
		},
	})
	label.Parent = parent
	return label
end

local function tagPill(parent, name, text, role, size, fill, order)
	local pill = plainFrame(parent, name, {
		Size = UDim2.fromOffset(0, size + 8),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = fill,
		BackgroundTransparency = 0,
		LayoutOrder = order or 0,
	})
	rounded(pill, floor(size * 0.55))
	outline(pill, C.Ink, 2.5)
	padding(pill, 2, floor(size * 0.5), 3)
	local label = tagText(pill, name .. "Label", text, role, size, C.Text, 1)
	return pill, label
end

local function surfaceGui(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SIGN_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	gui.Parent = part
	return gui
end

-- navy -> violet rounded panel with an outline, filling the whole SurfaceGui
local function signPanel(gui, strokeColor)
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	panel.BorderSizePixel = 0
	vgradient(panel, C.Violet, C.Navy)
	rounded(panel, 24)
	outline(panel, strokeColor or C.TextGold, 6, 0.15)
	panel.Parent = gui
	return panel
end

-- fixed-size sign text (px at SIGN_PPS) placed with fractions of its parent
local function signText(parent, name, text, role, size, color, x, y, w, h, align)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Stroke = 1,
		Outline = max(2, floor(size / 16 + 0.5)),
		OutlineColor = C.Ink,
		Props = {
			Name = name,
			Position = UDim2.new(x, 0, y, 0),
			Size = UDim2.new(w, 0, h, 0),
			TextWrapped = false,
			TextXAlignment = align or Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	label.Parent = parent
	return label
end

-- Fits a text into `widthPx` at `px` (the smoke audit's 0.5 em per character estimate): cuts it with "..." when needed.
local function fitText(text, px, widthPx)
	text = tostring(text or "")
	local maxChars = floor(widthPx / (0.5 * px))
	local n = 0
	for _ in text:gmatch("[^\128-\191]") do
		n = n + 1
	end
	if n <= maxChars then
		return text
	end
	local out, count = {}, 0
	for ch in text:gmatch("[%z\1-\127\194-\244][\128-\191]*") do
		count = count + 1
		if count > maxChars - 3 then
			break
		end
		out[#out + 1] = ch
	end
	return table.concat(out) .. "..."
end

local function clockText(seconds)
	seconds = max(0, floor((tonumber(seconds) or 0) + 0.5))
	local h = floor(seconds / 3600)
	local m = floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%02d:%02d", m, s)
end

local function commas(n)
	if Util.Commas then
		local ok, text = pcall(Util.Commas, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return tostring(n)
end

