	cloud_obby_far_3 = 131913458110599,
	cloud_obby_far_4 = 137934493228359,
	cloud_obby_sea_1 = 116773648973916,
	cloud_obby_sea_2 = 138225605546965,
	cloud_obby_under_l = 127815225544805,
	cloud_obby_under_m = 94176924209074,
	cloud_obby_under_pad = 85611839745417,
	cloud_obby_under_s = 105066677046695,
