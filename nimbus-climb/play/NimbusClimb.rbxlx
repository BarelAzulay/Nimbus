----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not Net.Warned[key] then
		Net.Warned[key] = true
		warn("[MenuController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function makeFrame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel with optional property overrides. kit-b U6: every menu text sits on its window or card, so it
-- reads by contrast and has no outline (was a 0.25 classic stroke under a 1.5 px glyph outline).
local function makeText(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Props = p,
	})
	label.Parent = parent
	return label
end

-- radius: a Theme.Radius token ("S", "M", "None"; kit-b U6), "M" by default
local function corner(parent, radius)
	return Theme.Corner(parent, radius or "M")
end

local function round(parent)
	return Theme.Corner(parent, "Round")
end

local function stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

local function pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function listLayout(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

-- Vertical ScrollingFrame with an automatic canvas.
local function scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.Parent = parent
	return SignKit.Scroll(Util.Create("ScrollingFrame", p)) -- (U9-7 look, LOOK-ui) the kit's wood list bar, square ends
end

local function tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

local function commas(n)
	return Util.Commas(tonumber(n) or 0)
end


local function inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

-- (kit-b U7a) a difficulty rating on an empty label: `count` gold PixelIcon stars of five, the rest dim
local function starRating(label, count)
	count = Util.Clamp(math.floor(tonumber(count) or 0), 0, 5)
	label.Text = ""
	PixelIcon.Lead(label, "star", { Count = count, Of = 5, Px = 18 })
end

local function petTotals()
	local distinct, total = 0, 0
	for id, count in pairs(State.Get().Pets) do
		if PetCatalog.Get(id) then
			distinct = distinct + 1
			total = total + count
		end
	end
	return distinct, total
end

-- Catalog pets discovered (v3: every pet ever owned or rolled; owned pets always count).
local function discoveredCount()
	local n = 0
	for _, def in ipairs(PetCatalog.Pets or {}) do
		local found
		if type(State.IsDiscovered) == "function" then
			found = State.IsDiscovered(def.Id)
		else
			found = State.OwnedCount(def.Id) > 0
		end
		if found then
			n = n + 1
		end
	end
	return n
end

local function catalogTotal()
	if type(PetCatalog.TotalCount) == "function" then
		local ok, n = pcall(PetCatalog.TotalCount)
		if ok and type(n) == "number" then
			return n
		end
	end
	return #(PetCatalog.Pets or {})
end

-- A solid coloured pill (tier / hybrid badges, "MAX", locks): white text on its own colour (kit-b U6: no outline).
local function colorPill(parent, name, text, color, textSize, layoutOrder)
	local size = textSize or 18
	local pill = Theme.Label(text, "Heading", {
		Size = size,
		Color = WHITE,
		Props = {
			Name = name,
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, size + 9),
			LayoutOrder = layoutOrder or 0,
		},
	})
	round(pill)
	stroke(pill, NAVY, 2, 0)
	Theme.Gradient(pill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 206, 226), 90)
	pad(pill, 9, 0, 9, 1)
	pill.Parent = parent
	return pill
end

----------------------------------------------------------------------
-- Phase 2 data helpers: pet copy keys, levels, the home, Cash / Gems (fields of ONE local table, P2: the main chunk
-- is close to Lua's 200-local limit)
----------------------------------------------------------------------
local P2 = {}

-- what the pet windows share (team balance: UI/PetBits)
for _, name in ipairs({ "defOfKey", "petLevel", "homeData", "catalogCall", "stage", "job", "formatCash", "formatRate" }) do
	P2[name] = PetBits[name]
end

function P2.stationLevelOf(home, id)
	local stations = type(home) == "table" and home.Stations or nil
	local level = type(stations) == "table" and stations[id] or nil
	if type(level) == "number" and level == level then
		return math.max(0, math.floor(level))
	end
	return 0
end

-- true while the local player owns (claimed) a home plot this session
function P2.hasHome()
	return LocalPlayer ~= nil and type(LocalPlayer:GetAttribute(Config.Attr.SpotIndex)) == "number"
end

function P2.cashBalance()
	if type(State.Cash) == "function" then
		local ok, value = pcall(State.Cash)
		if ok and type(value) == "number" then
			return value
		end
	end
	return 0
end

function P2.stationDef(id)
	local def = P2.catalogCall("Get", id)
	if type(def) == "table" then
		return def
	end
	return nil
end

-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.4-3.7): CareController (the Food Machine list, the garden
-- picker, the Training Place window and the EVOLVE moment), loaded lazily; nil when the build has none.
function P2.care()
	if P2.CareTried then
		return P2.Care
	end
	P2.CareTried = true
	local module = script.Parent:FindFirstChild("CareController")
	if module then
		local ok, mod = pcall(require, module)
		if ok and type(mod) == "table" and type(mod.Open) == "function" then
			P2.Care = mod
		end
	end
	return P2.Care
end

----------------------------------------------------------------------
-- Remotes (sent at most every FIRE_GAP seconds each, the server rate-limits as well)
----------------------------------------------------------------------
local function getRemote(name)
	local cached = Net.Cache[name]
	if cached then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		Net.Cache[name] = remote
		return remote
	end
	return nil
end

-- Sends remote `name` with the given arguments unless the same `key` was sent less than K.FIRE_GAP seconds ago.
local function fireKeyed(key, name, ...)
	local now = os.clock()
	if Net.Last[key] and now - Net.Last[key] < K.FIRE_GAP then
		return false
	end
	local remote = getRemote(name)
	if not remote then
		return false
	end
	Net.Last[key] = now
	local args = { n = select("#", ...), ... }
	local ok = pcall(function()
		remote:FireServer(unpack(args, 1, args.n))
	end)
	return ok
end

local function fire(name, ...)
	return fireKeyed(name, name, ...)
end

----------------------------------------------------------------------
-- IndexController (optional module written next to this one)
----------------------------------------------------------------------
local function getIndex()
	if not Index.Tried then
		Index.Tried = true
		local moduleScript = script.Parent:FindFirstChild("IndexController")
		if moduleScript then
			local ok, result = pcall(require, moduleScript)
			if ok and type(result) == "table" then
				Index.Module = result
			else
				warnOnce("IndexController", result)
			end
		end
	end
	return Index.Module
end

local function indexOpen()
	local index = Index.Module
	if index and type(index.IsOpen) == "function" then
		local ok, open = pcall(index.IsOpen)
		return ok and open == true
	end
	return false
end

function closeIndex()
	local index = Index.Module
	if index and type(index.Close) == "function" and indexOpen() then
		safe("Index.Close", index.Close)
	end
end

----------------------------------------------------------------------
-- Screen size helpers
----------------------------------------------------------------------
local function guiSize()
	local size = gui and gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function screenFactor()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return Theme.ScreenFactor(vp.Y)
	end
	return Theme.ScreenFactor(guiSize().Y)
end

local function screenMargin()
	if touchDevice or U.StickSeen then -- the same touch decision as P5.stickShown (the phone's margin in the emulator)
		return K.TOUCH_EDGE
	end
	return K.EDGE
end

-- Right edge (gui px) of the menu column.
local function columnRight()
	local column = U.Column
	if column and column.Visible and column.AbsoluteSize.X > 0 then
		return column.AbsolutePosition.X + column.AbsoluteSize.X
	end
	return 0
end

----------------------------------------------------------------------
-- Side hint (tiny message next to the menu column; never in the middle of the screen)
----------------------------------------------------------------------
local function buildHint()
	local frame = makeFrame(gui, "MenuHint", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 120, 0.5, 0),
		Size = UDim2.fromOffset(0, 0), -- showHint sizes it to its text (the padding and the lip under the last line)
		BackgroundColor3 = Theme.Sign.Tile,
		BackgroundTransparency = 0,
		Visible = false,
		ZIndex = 9,
	})
	-- (kit-b gate U9 round 3: it was the old rounded navy gradient box) a kit B stone block as the toasts': tile face, a
	-- mitred wood edge, its lip in the message's kind (HINT_LIP), ink text
	pad(frame, 14, 8, 14, 8 + CloudUI.SignMetrics.Lip)
	CloudUI.SignBlock(frame, "Stone", { EdgePx = 3 })
	-- the width is set per message (one line when it fits, else wrapped at Hint.MaxW); the height follows the text
	local label = makeText(frame, "Text", "", "Toast", 20, Theme.Sign.Text, {
		Size = UDim2.fromOffset(300, 24),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 10,
	})
	-- (kit-b gate U9 r4: a bare box beside the toasts' icon tiles) the toasts' kind chip at the left: its face and lip by
	-- the message's kind, a wood edge, the kind's pixel icon (NotifyController.KindChip: info bulb on sky, good check on
	-- grass, bad x on red, token coin on gold), so a hint and a toast are one component
	local chip = makeFrame(frame, "Icon", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(Hint.CHIP, Hint.CHIP),
		BackgroundColor3 = Theme.Sign.Sky,
		BackgroundTransparency = 0,
		ZIndex = 10,
	})
	CloudUI.SignBlock(chip, { Face = Theme.Sign.Sky, Lip = Theme.Sign.SkyLip, Edge = Theme.Sign.Wood, Text = Theme.Sign.Text }, { EdgePx = 2, LipPx = 3, Pad = false })
	label.Position = UDim2.fromOffset(Hint.CHIP + Hint.CHIP_GAP, 0)
	Hint.Chip = chip
	Hint.MaxW = 300
	Hint.Frame = frame
	Hint.Label = label
	Hint.Scale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = frame })
end

-- (kit-b gate U9 r4) the hint's chip in the kind's face / lip with the kind's pixel icon (NotifyController.KindChip)
function P5.paintHintChip(kind)
	local chip = Hint.Chip
	if not chip then
		return
	end
	local chips = nil
	pcall(function()
		local nc = require(script.Parent:FindFirstChild("NotifyController"))
		chips = type(nc) == "table" and nc.KindChip or nil
	end)
	local SIGN = Theme.Sign
	local look = (chips and (chips[kind or "info"] or chips.info)) or { Face = SIGN.Sky, Lip = SIGN.SkyLip, Icon = "bulb", Ink = SIGN.Text }
	chip.BackgroundColor3 = look.Face
	local lip = chip:FindFirstChild("Lip")
	if lip then
		lip.BackgroundColor3 = look.Lip
	end
	if chip:GetAttribute("Kind") ~= (kind or "info") then
		chip:SetAttribute("Kind", kind or "info")
		local old = chip:FindFirstChild("Glyph")
		if old then
			old:Destroy()
		end
		local icon = PixelIcon.New(chip, look.Icon, Hint.GLYPH, look.Ink)
		if icon then
			icon.Name = "Glyph"
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.new(0.5, 0, 0.5, -1) -- (centred on the face above the lip, as the toasts')
			icon.ZIndex = 11
			for _, c in ipairs(icon:GetChildren()) do
				if c:IsA("GuiObject") then
					c.ZIndex = 11
				end
			end
		end
	end
end

-- (playtest 2026-11-28 C24: the hint, centred on the column, lay on the vitals card's name plank at 640 x 360 / 844 x 390
-- and reached the Gift block at 360 x 640) its centre moved (from the column's, Hint.BaseY) so the block ends GAP above
-- the vitals card's name tab and starts GAP under the gift, where it shares their columns (NimbusHud's published rects);
-- where both cannot hold, the vitals card wins.
-- (C24 round 2: at 568 x 320 the vitals' limit lifted the block 34 px over the gui's top, under the top bar's pill; on the
-- party pad at 360 x 640 it ended on RUN) the touch keys in its columns are limits too (above: under them; below: over
-- them), as the vitals card; where the limits cross, the text wraps wider (fewer lines, a shorter block) up to the room
-- left of the HUD's top-right block; and the block's top never goes over the gui's top + 4 px
function P5.hintLimits(x0, w, h, cy)
	local hud = gui and gui.Parent and gui.Parent:FindFirstChild("NimbusHud")
	local x1 = x0 + w
	local GAP = 8
	local lo, hi = h / 2 + 4, math.huge
	local function num(name)
		return hud and tonumber(hud:GetAttribute(name)) or nil
	end
	local gl, gt, gs = num("GiftLeft"), num("GiftTop"), num("GiftSize")
	if gl and gt and gs and gs > 0 and x1 + GAP > gl and x0 - GAP < gl + gs then
		lo = math.max(lo, gt + gs + GAP + h / 2)
	end
	local vt, vl, vr = num("BottomCentreTop"), num("BottomCentreLeft"), num("BottomCentreRight")
	if vt and vl and vr and vt > 0 and x1 + GAP > vl and x0 - GAP < vr then
		hi = vt - GAP - h / 2
	end
	local mobile = gui and gui.Parent and gui.Parent:FindFirstChild("MobileControls")
	if mobile and mobile:IsA("LayerCollector") and mobile.Enabled then
		local dy = mobile.IgnoreGuiInset and P5.inset() or 0 -- (its keys in our gui-area px)
		for _, key in ipairs(mobile:GetDescendants()) do
			if key:IsA("GuiButton") and key.Visible and key.AbsoluteSize.X > 0 then
				local kx0, ky0 = key.AbsolutePosition.X, key.AbsolutePosition.Y - dy
				local kx1, ky1 = kx0 + key.AbsoluteSize.X, ky0 + key.AbsoluteSize.Y
				local shown = true
				local cur = key.Parent
				while cur and cur ~= mobile do
					if cur:IsA("GuiObject") and not cur.Visible then
						shown = false
					end
					cur = cur.Parent
				end
				if shown and x1 + GAP > kx0 and x0 - GAP < kx1 then
					if (ky0 + ky1) / 2 > cy then
						hi = math.min(hi, ky0 - GAP - h / 2)
					else
						lo = math.max(lo, ky1 + GAP + h / 2)
					end
				end
			end
		end
	end
	return lo, hi, num("TopRightLeft"), gl
end

function P5.clampHint()
	local f = Hint.Frame
	if not (f and Hint.Scale) then
		return
	end
	local base = Hint.MaxW or 300
	local s = Hint.ReadScale or Hint.Scale.Scale -- (the screen's read scale relayoutMenu set; a block shrunk below is put back)
	if Hint.Wide then
		-- (widened or shrunk for an earlier screen) back to the column's width and the read scale first
		Hint.Wide = nil
		Hint.Scale.Scale = s
		P5.sizeHint(base)
	end
	local x0 = f.Position.X.Offset
	local cy = Hint.BaseY or f.Position.Y.Offset
	local w, h = f.Size.X.Offset * s, f.Size.Y.Offset * s
	local lo, hi, blockLeft, giftLeft = P5.hintLimits(x0, w, h, cy)
	if hi < lo and Hint.Label and Hint.Label.Text ~= "" then
		-- the limits cross: wider, so fewer lines, while the block stays left of the HUD's top-right block (and the gift);
		-- then (568 x 320: no room to widen) the block a little smaller, its text never under 14 screen px
		local right = (gui and gui.AbsoluteSize.X or 0) - 8
		for _, edge in ipairs({ blockLeft or 0, giftLeft or 0 }) do
			if edge > x0 then
				right = math.min(right, edge - 8)
			end
		end
		local chrome = 28 + Hint.CHIP + Hint.CHIP_GAP -- (the block's padding and the chip beside the text, design px)
		local floorScale = 14 / math.max(1, Hint.Label.TextSize)
		local scales = { s }
		for sc = s - 0.05, floorScale, -0.05 do
			scales[#scales + 1] = sc
		end
		if s > floorScale then
			scales[#scales + 1] = floorScale
		end
		local fits = false
		local best = { Short = lo - hi, Scale = s, MaxW = base }
		for _, sc in ipairs(scales) do
			local most = math.floor((right - x0) / sc) - chrome
			local tries = {}
			if sc < s then
				tries[1] = base
			end
			for maxW = base + 20, most - 1, 20 do
				tries[#tries + 1] = maxW
			end
			if most > base then
				tries[#tries + 1] = most -- (the whole room last)
			end
			for _, maxW in ipairs(tries) do
				Hint.Scale.Scale = sc
				P5.sizeHint(maxW)
				Hint.Wide = true
				w, h = f.Size.X.Offset * sc, f.Size.Y.Offset * sc
				lo, hi = P5.hintLimits(x0, w, h, cy)
				if hi >= lo then
					fits = true
					break
				end
				if lo - hi < best.Short - 0.5 then
					best = { Short = lo - hi, Scale = sc, MaxW = maxW }
				end
			end
			if fits then
				break
			end
		end
		if not fits and Hint.Wide then
			-- nothing fits: the shortest block tried (the least it lies over), the vitals card's limit over the gift's, the
			-- top's over both
			Hint.Scale.Scale = best.Scale
			P5.sizeHint(best.MaxW)
			Hint.Wide = best.Scale ~= s or best.MaxW ~= base or nil
			w, h = f.Size.X.Offset * best.Scale, f.Size.Y.Offset * best.Scale
			lo, hi = P5.hintLimits(x0, w, h, cy)
		end
	end
	cy = math.max(math.min(math.max(cy, lo), hi), h / 2 + 4)
	f.Position = UDim2.new(0, x0, 0, math.floor(cy + 0.5))
end

function showHint(text, kind)
	if not Hint.Frame then
		return
	end
	Hint.Token = Hint.Token + 1
	local mine = Hint.Token
	Hint.Label.Text = tostring(text)
	Hint.Label.TextColor3 = Theme.Sign.Text
	local lip = Hint.Frame:FindFirstChild("Lip")
	if lip then
		local SIGN = Theme.Sign
		local HINT_LIP = { good = SIGN.GrassLip, bad = SIGN.RedLip, token = SIGN.GoldLip }
		lip.BackgroundColor3 = HINT_LIP[kind or "info"] or SIGN.StoneLip
	end
	P5.paintHintChip(kind)
	Hint.Wide = nil
	Hint.Scale.Scale = Hint.ReadScale or Hint.Scale.Scale -- (a block shrunk for the last text: the screen's read scale back)
	P5.sizeHint(Hint.MaxW or 300)
	P5.clampHint()
	Hint.Frame.Visible = true
	task.delay(K.HINT_SECONDS, function()
		if Hint.Token == mine and Hint.Frame then
			Hint.Frame.Visible = false
		end
	end)
end

-- the hint's block for its text wrapped at `maxW` design px: one line when it fits, the label as tall as its lines
function P5.sizeHint(maxW)
	local width = maxW
	local ok, bounds = pcall(function()
		return Theme.MeasureLabel(Hint.Label, Hint.Label.Text, Hint.Label.TextSize, 4000)
	end)
	-- (gate U9 round 3) Theme.Measure runs about 13 % short of the drawn face: a 15 % spare, or a one-line text wrapped
	local SPARE = 1.15
	if ok and typeof(bounds) == "Vector2" and bounds.X * SPARE + 6 < maxW then
		width = math.ceil(bounds.X * SPARE) + 6
	end
	-- (kit-b gate U9 round 3: a wrapped second line ran onto the block's lip) the text box as tall as its wrapped lines, so
	-- the block's padding and lip sit under the last line whatever measures AutomaticSize
	-- (the lines counted by a greedy word wrap at the measured widths with the spare: the wrapped measure ran a line short)
	local lineH = Hint.Label.TextSize + 4
	local function wordW(word)
		local okW, v = pcall(function()
			return Theme.MeasureLabel(Hint.Label, word, Hint.Label.TextSize, 4000)
		end)
		return (okW and typeof(v) == "Vector2") and v.X * SPARE or #word * Hint.Label.TextSize * 0.6
	end
	local space = math.max(0, wordW("a a") - wordW("aa"))
	local lines, run = 1, 0
	for word in string.gmatch(Hint.Label.Text, "%S+") do
		local ww = wordW(word)
		if run > 0 and run + space + ww > width then
			lines, run = lines + 1, ww
		else
			run = run + (run > 0 and space or 0) + ww
		end
	end
	local textH = lines * lineH
	local rowH = math.max(textH, Hint.CHIP) -- (the chip's row: a one-line text is centred on it)
	Hint.Label.Size = UDim2.fromOffset(width, textH)
	Hint.Label.Position = UDim2.fromOffset(Hint.CHIP + Hint.CHIP_GAP, math.floor((rowH - textH) / 2))
	Hint.Frame.Size = UDim2.fromOffset(width + 28 + Hint.CHIP + Hint.CHIP_GAP, rowH + 16 + CloudUI.SignMetrics.Lip)
end

----------------------------------------------------------------------
-- Window manager
-- window = { Id, Spec, Holder, Fit (UIScale), Pop (UIScale), Panel, Shown, Built, Dirty, Token, W, H,
--            Tab, Refresh = fn(), OnOpen = fn(args), OnClose = fn(), OnLayout = fn(w, h, narrow) }
----------------------------------------------------------------------
-- Roblox's top bar height (gui px): our ScreenGui does not ignore it, SideRect measures from the screen top
function P5.inset()
	local inset = 58
	pcall(function()
		inset = game:GetService("GuiService"):GetGuiInset().Y
	end)
	return inset
end

-- The window rule (6.6): NeonKit.Dock puts the holder on its SideRect (docked RIGHT on landscape screens, a bottom
-- sheet on portrait ones) and keeps it there when the screen changes; the window re-lays its content when its
-- design size changes.
local function layoutWindow(win)
	if not win.Dock then
		local size = K.WIN[win.Id] or { 820, 900 }
		win.Dock = P5.Kit.Dock(win.Holder, win.Fit, size[1], size[2])
	end
	win.Dock.Refresh()
	local rect = win.Dock.Rect
	if not rect then
		return
	end
	-- (LOOK-ui, kitb-look1: the docked Home window's band and tail ran off the screen's edge) a Signboard window's band goes
	-- out over its frame with its tails only with P5.BAND_ROOM screen px to both screen edges; docked at an edge (12 px)
	-- or a bottom sheet it stays inside the rim, as the Index's
	if win.Panel and win.Panel.TitleBar and win.Spec.Skin == "Signboard" then
		local camera = workspace.CurrentCamera
		local vpX = camera and camera.ViewportSize.X or 0
		SignKit.HeaderOverhang(win.Panel.TitleBar, vpX > 0 and math.min(rect.x, vpX - rect.x - rect.w) >= P5.BAND_ROOM)
	end
	local w, h = math.floor(rect.designW + 0.5), math.floor(rect.designH + 0.5)
	local changed = win.W ~= w or win.H ~= h
	win.W, win.H = w, h
	if changed and win.Built and win.OnLayout then
		safe("layout " .. win.Id, win.OnLayout, w, h, w < K.NARROW, h < K.SHORT, w < K.TALL)
	end
	if win.Shown then
		P5.currencyFor(win, true) -- (LOOK-ui) over the strips or clear of them now (HideCurrency "Over")
		P5.vitalsFor(win, true) -- (U9-3 review) the docked box moved: over the vitals card or clear of it now
	end
end

local function createWindow(spec)
	local size = K.WIN[spec.Id] or { 820, 900 }
	local win = { Id = spec.Id, Spec = spec, Shown = false, Built = false, Dirty = true, Token = 0 }
	win.Holder = makeFrame(gui, "Window_" .. spec.Id, {
		Size = UDim2.fromOffset(size[1], size[2]),
		Visible = false,
		ZIndex = 3,
	})
	win.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = win.Holder })
	win.Panel = CloudUI.Panel({
		Name = spec.Id .. "Panel",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Title = spec.Title,
		Closable = true,
		Category = spec.Category,
		Accent = spec.Accent,
		Skin = spec.Skin, -- (kit-b U9-1) "Signboard": the Home window on the kit B sign
		Icon = spec.Icon,
		OnClose = function()
			closeWindow(spec.Id)
		end,
		Parent = win.Holder,
	})
	win.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = win.Panel.Root })
	windows[spec.Id] = win
	return win
end

-- (kit-b U9-1) a window with HideTouch takes Roblox's thumbstick and jump button away on a touch-only screen while it is
-- shown (its scrolling list runs through both bottom corners), as the Pets window and the Index do; they come back as they
-- were when it closes (MenuController.SetTouchHidden keeps the one owner set)
function P5.touchFor(win, on)
	if not win.Spec.HideTouch then
		return
	end
	local want = on == true and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	safe("touch " .. win.Id, MenuController.SetTouchHidden, win.Id, want and true or false)
end

-- (kit-b U9-3; the U9-3 renders, as the render gate found for the Shop) a window with HideCurrency steps the HUD's currency
-- strips aside while it is shown (HudController.SetCurrencyHidden, keyed by the window's id): docked right on a 1280x720
-- screen its awning and X lay over them. They come back when it closes
-- the HudController module, or nil (looked up once)
function P5.hud()
	if P5.HudModule == nil then
		P5.HudModule = false
		local module = script.Parent:FindFirstChild("HudController")
		local ok, mod = pcall(function()
			return module and require(module)
		end)
		if ok and type(mod) == "table" then
			P5.HudModule = mod
		end
	end
	return P5.HudModule or nil
end

-- (LOOK-ui) HideCurrency = "Over": only while the docked box and its awning lie over the strips (HudController.Overlaps;
-- a 1280x720 window reaches them, a 1080p one starts under them), checked again on every layout
P5.BAND_ROOM = 24 -- (LOOK-ui) screen px a Signboard window keeps to both screen edges for its band's tails
P5.AWNING = 10 -- design px of awning over a Signboard window's top (CloudUI.Panel's roof at Y -10)
function P5.currencyFor(win, on)
	if not win.Spec.HideCurrency then
		return
	end
	local hud = P5.hud()
	if hud and type(hud.SetCurrencyHidden) == "function" then
		local want = on == true
		local rect = win.Dock and win.Dock.Rect
		if want and win.Spec.HideCurrency == "Over" and type(hud.Overlaps) == "function" then
			local ok, _, strips = pcall(hud.Overlaps, rect, P5.AWNING * ((rect and rect.scale) or 1))
			want = ok and strips == true
		end
		safe("currency " .. win.Id, hud.SetCurrencyHidden, win.Id, want)
	end
end

-- (U9-3 review; the U9-3 renders: at 844x390 the docked Stats window cut the vitals card's bars) a window with HideVitals
-- hides the HUD's vitals card while it is shown and its docked box lies over the card's slot by more than a shared edge
-- (HudController.SetVitalsHidden, keyed by the window's id): on a phone it reaches over the card, on PC it clears it and
-- the card stays. Checked again on every layout (the screen turned or resized); the card comes back when it closes
function P5.vitalsFor(win, on)
	if not win.Spec.HideVitals then
		return
	end
	local hud = P5.hud()
	if not (hud and type(hud.SetVitalsHidden) == "function") then
		return
	end
	local over = false
	local rect = on == true and win.Dock and win.Dock.Rect
	if rect and type(hud.GetLayout) == "function" then
		local ok, layout = pcall(hud.GetLayout)
		local slot = ok and type(layout) == "table" and layout.VitalsSlot
		if slot then
			-- the dock's box is in screen px (top bar included), the HUD's in gui-area px
			local y = rect.y - P5.inset()
			-- (LOOK-ui, kitb-look1: at 1280x720 the Stats window docked 3 px from the card) within K.VITALS_MARGIN px counts
			local m = K.VITALS_MARGIN
			local w = math.min(rect.x + rect.w, slot.X + slot.W + m) - math.max(rect.x, slot.X - m)
			local h = math.min(y + rect.h, slot.Y + slot.H + m) - math.max(y, slot.Y - m)
			over = w > 0 and h > 0
		end
	end
	safe("vitals " .. win.Id, hud.SetVitalsHidden, win.Id, over)
end

local function ensureBuilt(win)
	if win.Built then
		return
	end
	win.Built = true
	safe("build " .. win.Id, win.Spec.Build, win)
	if win.OnLayout and win.W then
		safe("layout " .. win.Id, win.OnLayout, win.W, win.H, win.W < K.NARROW, win.H < K.SHORT, win.W < K.TALL)
	end
end

local function refreshWindow(win)
	if not win or not win.Built then
		return
	end
	if win.Shown then
		win.Dirty = false
		if win.Refresh then
			safe("refresh " .. win.Id, win.Refresh)
		end
	else
		win.Dirty = true
	end
end

function refreshOpenWindow()
	if openId then
		refreshWindow(windows[openId])
	end
end

-- Team balance: the Pets window is PetsController's (required on use, it boots after this controller)
function P5.pets()
	if P5.Pets == nil then
		P5.Pets = false
		local module = script.Parent:FindFirstChild("PetsController")
		local ok, mod = pcall(function()
			return module and require(module)
		end)
		if ok and type(mod) == "table" then
			P5.Pets = mod
		end
	end
	return P5.Pets or nil
end

function P5.petsOpen()
	local pets = P5.pets()
	return pets ~= nil and pets.IsOpen() == true
end

-- something else takes over: the window goes silently (nothing it was given to go back to)
function P5.closePets()
	if P5.petsOpen() then
		safe("pets close", P5.Pets.Close, true)
	end
end

-- an optional module, required on first use (cached in P5[field]; false = unavailable): folder:FindFirstChild(name)
function P5.lazy(field, folder, name)
	if P5[field] == nil then
		P5[field] = false
		local module = folder and folder:FindFirstChild(name)
		local ok, mod = pcall(function()
			return module and require(module)
		end)
		if ok and type(mod) == "table" and type(mod.Open or mod.Request) == "function" then
			P5[field] = mod
		end
	end
	return P5[field] or nil
end

-- lobby-shop Task 22: the one Shop window (ShopController; the StoreController forwarder when a build lacks it) and the
-- egg stage (client/UI/EggStage) it plays every spin through. The ONE path of OpenPanel("Shop") / OpenPanel("Store")
-- (onOpenPanel); neither listens to OpenPanel itself.
function P5.shop()
	return P5.lazy("Shop", script.Parent, "ShopController") or P5.lazy("ShopForwarder", script.Parent, "StoreController")
end

function P5.hatch()
	return P5.lazy("Hatch", Client:FindFirstChild("UI"), "EggStage")
end

function P5.shopOpen()
	local shop = P5.shop()
	return shop ~= nil and type(shop.IsOpen) == "function" and shop.IsOpen() == true
end

function P5.hatchShowing()
	local hatch = P5.hatch()
	return hatch ~= nil and type(hatch.IsShowing) == "function" and hatch.IsShowing() == true
end

-- refused while the egg stage shows (ShopController.Open refuses it too) and in a match (the Shop's own hint)
function P5.openShop(args)
	local shop = P5.shop()
	if shop and not P5.hatchShowing() then
		safe("shop open", shop.Open, args)
	end
end
P5.openStore = P5.openShop

function P5.closeShop()
	if P5.shopOpen() then
		safe("shop close", P5.shop().Close)
	end
end

-- the stage closes from here only through closeEverything (MenuController.Close, a match start): it toasts the pulls
-- not shown yet ("You hatched: ...")
function P5.closeHatch()
	local hatch = P5.hatch()
	if hatch and type(hatch.Close) == "function" then
		safe("hatch close", hatch.Close)
	end
end

function P5.openPets(args)
	local pets = P5.pets()
	if pets and not P5.hatchShowing() then
		safe("pets open", pets.Open, args)
	end
end

function openWindow(id, args)
	local win = windows[id]
	if not win or P5.hatchShowing() then
		return
	end
	args = type(args) == "table" and args or {}
	closeIndex()
	P5.closePets()
	if openId and openId ~= id then
		closeWindow(openId, true)
	end
	local wasShown = win.Shown
	win.Shown = true
	win.Token = win.Token + 1
	openId = id
	syncBackBinding()
	layoutWindow(win)
	ensureBuilt(win)
	P5.touchFor(win, true)
	P5.currencyFor(win, true)
	P5.vitalsFor(win, true) -- after the currency step: the HUD re-lays out then
	win.Holder.Visible = true
	if not wasShown then
		win.Pop.Scale = 1
	end
	if win.OnOpen then
		safe("open " .. id, win.OnOpen, args)
	end
	refreshWindow(win)
	if not wasShown then
		SignKit.Rise(win.Pop.Parent) -- (Pitch 2 F0) the kit's open: it rises 12 px in 3 hard steps (no scale bounce)
	end
	updateMenuActive()
	if not wasShown then
		MenuController.WindowOpened:Fire(id)
	end
end

function closeWindow(id, instant)
	local win = windows[id]
	if not win or not win.Shown then
		return
	end
	win.Shown = false
	win.Token = win.Token + 1
	local mine = win.Token
	if openId == id then
		openId = nil
	end
	syncBackBinding()
	P5.touchFor(win, false)
	P5.currencyFor(win, false)
	P5.vitalsFor(win, false)
	if win.OnClose then
		safe("close " .. id, win.OnClose)
	end
	if instant then
		-- another window takes over right away
		win.Holder.Visible = false
	else
		tween(win.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.13, function()
			if win.Token == mine and not win.Shown then
				win.Holder.Visible = false
			end
		end)
	end
	updateMenuActive()
end

-- Button behaviour: open, or close when it is already showing.
function toggleWindow(id, args)
	local win = windows[id]
	if not win then
		return
	end
	if win.Shown then
		closeWindow(id)
	else
		openWindow(id, args)
	end
end

-- MenuController.Close / a match start / Settings: the Shop first (so it never comes back over the game when the stage
-- closes), then the egg stage (one "You hatched: ..." toast for the pulls not shown), then everything else. A match
-- start (forMatch) leaves the stage to its own InMatch listener (EggStage closes with the reason "Match", same toast).
local function closeEverything(forMatch)
	P5.closeShop()
	if not forMatch then
		P5.closeHatch()
	end
	if openId then
		closeWindow(openId)
	end
	P5.closePets()
	closeIndex()
end

-- Esc / gamepad B: close the open menu window. Returns true when something was closed.
-- (The Pet Index, the Shop and the egg stage handle Esc / B themselves: the stage's one Esc path is the Shop's.)
function handleBack()
	if openId then
		closeWindow(openId)
		return true
	end
	return false
end

-- Gamepad B is also the dash button (MovementController binds "NimbusDash" at Default priority), and
-- UserInputService.InputBegan cannot stop that action. So B is owned here through ContextActionService at
-- High priority, but only while something closable is open: the press then closes it and is sunk, so
-- the character does not dash (or spend stamina / start the cooldown) on the same press. With nothing open
-- the binding is gone and B dashes as usual. Esc stays on the plain InputBegan path (onInput).
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin then
		Back.Busy = true
		local ok, handled = pcall(handleBack)
		Back.Busy = false
		if not ok then
			warnOnce("back", handled)
			handled = false
		end
		Back.Swallowed = handled == true
		if Back.Swallowed then
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end
	-- release / cancel: sink it when the press was ours, so nothing below sees half a press
	local swallowed = Back.Swallowed
	Back.Swallowed = false
	if swallowed then
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

-- Binds B while a menu window is open and unbinds it when none is. Called after every change of openId.
function syncBackBinding()
	local wanted = openId ~= nil
	if wanted == Back.Bound then
		return
	end
	if wanted then
		Back.Bound = true
		local ok, err = pcall(function()
			ContextActionService:BindActionAtPriority(
				K.BACK_ACTION,
				onBackAction,
				false,
				Enum.ContextActionPriority.High.Value,
				Enum.KeyCode.ButtonB
			)
		end)
		if not ok then
			warnOnce("bind back", err)
		end
	elseif Back.Busy then
		-- the press that closed the last thing is still being dispatched: unbind right after it
		task.defer(syncBackBinding)
	else
		Back.Bound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

----------------------------------------------------------------------
-- Menu tiles (left-centre column; a 2 x 3 grid on short screens)
----------------------------------------------------------------------
local function menuActionPets()
	if P5.petsOpen() then
		safe("pets close", P5.Pets.Close)
	else
		P5.openPets({})
	end
end

local function openIndex(groupId)
	local index = getIndex()
	if not index or type(index.Open) ~= "function" then
		showHint("The Pet Index is getting ready. Try again soon!", "info")
		return
	end
	if P5.hatchShowing() then
		return
	end
	if openId then
		closeWindow(openId, true)
	end
	P5.closePets()
	safe("Index.Open", index.Open, groupId)
end

local function menuActionIndex()
	if indexOpen() then
		closeIndex()
	else
		openIndex(nil)
	end
end

-- The Home tile (id "Spot"): the Home window. Phase 6: also before a home is claimed; then its Claim a home hero
-- walks the player to a free gate (Remotes.GoToSpot: the home portal toward the last plot when it is free, else the
-- nearest free one) where E claims it.
local function menuActionSpot()
	if inMatch() then
		showHint("You cannot go home during a match.", "info")
		return
	end
	toggleWindow("Home")
end

local function menuActionStats()
	toggleWindow("Stats")
end

-- Phase 5 (6.6): the Settings gear opens MainMenuController's settings panel (menu W3); a hint until it exists.
-- HUD cleanup: public (the top-left pill's gear, TopBarController; Open("Settings"))
function MenuController.OpenSettings()
	local module = script.Parent:FindFirstChild("MainMenuController")
	local ok, mod = pcall(function()
		return module and require(module)
	end)
	if ok and type(mod) == "table" then
		for _, name in ipairs({ "OpenSettings", "Settings", "ShowSettings" }) do
			if type(mod[name]) == "function" then
				closeEverything()
				safe("settings", mod[name])
				return
			end
		end
		if type(mod.Open) == "function" then
			closeEverything()
			safe("settings", mod.Open, "Settings")
			return
		end
	end
	showHint("Settings are getting ready. Try again soon!", "info")
end
P5.openSettings = MenuController.OpenSettings

-- The menu (bug batch 2 #1, option A "Split & shift"; HUD cleanup): ONE slim column of four neon tiles against the
-- left edge, vertically centred (Pets, Index, Home, Stats; Shop / Travel / Settings live in TopBarController's pill in
-- Roblox's top bar), with a small arrow tab beside its last tile that slides the column off the edge and back
-- (remembered for the session). Each tile is a NeonKit.Tile whose root is the TextButton MenuButton_<Id> inside a
-- frame Entry_<Id> of the frame "MenuColumn" (names kept: the tutorial rings them; a Gear = true entry would get a
-- Gear_<Id> frame; the tab is MenuColumn.Toggle, so everything that measures the column also keeps clear of the tab). Tiles are designed at 66 px under one UIScale: 56 px on a 1080p
-- desktop (x the screen factor), 50 px on touch screens, never below 44 px (a thumb). Where one column does not fit
-- that minimum (the band above a landscape phone's thumbstick, the strip above a portrait phone's sheet) the tiles
-- wrap into two slim columns of four (three columns on the shortest phones), still clear of the stick and never
-- reaching into the middle of the screen.
local MENU = {
	{ Id = "Pets", Label = "Pets", Icon = "Pets", Color = "Orange", Action = menuActionPets },
	{ Id = "Index", Label = "Index", Icon = "Index", Color = "Purple", Action = menuActionIndex },
	{ Id = "Spot", Label = "Home", Icon = "Home", Color = "Yellow", Action = menuActionSpot },
	{ Id = "Stats", Label = "Stats", Icon = "Stats", Color = "Cyan", Action = menuActionStats },
}
P5.TILE = 66 -- design px of a tile
P5.GAP = 12 -- between two tiles (design px). (LOOK-ui) 6 + both 3 px wood edges (a Border stroke draws outside the
-- tile): 6 px of sky shows between two tiles at 1080p, so each tile is its own block with its own lip as in the pitch
P5.TILE_PX = 56 -- on-screen tile on a 1080p desktop (x the screen factor)
P5.TOUCH_TILE_PX = 50 -- ... on touch screens (tablets: the larger of this and TILE_PX x the factor)
P5.MIN_TILE_PX = 44 -- one column needs this much per tile, else the tiles wrap into two columns (a thumb)
P5.TAB_GAP = 4 -- design px between the tiles and the arrow tab
P5.TAB_W = 30 -- design width of the arrow tab (touch: TAB_W_TOUCH, wider for a thumb). (LOOK-ui) 30: its 27 px pixel
-- arrow fits inside the wood edge
P5.TAB_W_TOUCH = 30
P5.BADGE = 22 -- (Pitch 2 item 04) the folded tab's red "!" block (its face; 26 with the 2 px wood edge). (look review r0:
-- an 18 px face held the 18 px bang over its 3 px lip) 22: the bang on the face, 1 px clear above the lip, as in the mock ...
P5.BADGE_X = 4 -- ... its face's left / top in the tab (the edge keeps 2 px of the tab's face clear each side)
P5.BADGE_DROP = 14 -- px the arrow steps down while it shows (2 px under the block's edge)
P5.BADGE_LIP = 3 -- the block's lip (design px)
P5.MAX_COLS = 3 -- the tiles wrap into at most this many columns (the shortest landscape phones)
P5.CENTRE_TOL = 0.145 -- the column never reaches into the screen middle (|dx| < 14.5% of the width: HudController's rule)
P5.SLIDE = 0.25 -- seconds of the collapse / expand slide

-- active (its window is open): the gold glow ring + a gold label; disabled (in a match): grey. (kit-b U8) The tiles are kit B
-- stone tiles (NeonKit.Tile Skin "Sign"): active = the gold face, disabled = the sunk well; the skin paints its own label
local function paintTile(entry)
	local tile = entry.Tile
	if not tile then
		return
	end
	local color = entry.Disabled and "Grey" or entry.Color
	-- (U9-9 look 2) a tile the tutorial points at (SetPointed) wears the same gold face: the kit's Selected look
	local gold = entry.Active or (entry.Pointed and not entry.Disabled)
	if entry.Painted ~= tostring(color) .. tostring(gold) then
		entry.Painted = tostring(color) .. tostring(gold)
		tile.SetColor(gold and "Gold" or color)
		tile.Card.SetGlow(entry.Active == true)
		if tile.Label and tile.Skin ~= "Sign" then
			tile.Label.TextColor3 = entry.Active and Theme.Lighten(GOLD, 0.45) or WHITE
		end
	end
	entry.Button:SetAttribute("Disabled", entry.Disabled == true)
end

local function buildTile(column, spec, index)
	local size = P5.TILE
	local entry = { Id = spec.Id, Color = spec.Color }
	entry.Root = makeFrame(column, (spec.Gear and "Gear_" or "Entry_") .. spec.Id, {
		Size = UDim2.fromOffset(size, size),
		LayoutOrder = index,
		ZIndex = 2,
	})
	local tile = P5.Kit.Tile({
		Name = "MenuButton_" .. spec.Id,
		Size = size,
		Color = spec.Color,
		Icon = spec.Icon,
		Label = (not spec.Gear) and spec.Label or nil, -- the gear stays icon-only
		Glow = false,
		Skin = "Sign", -- (kit-b U8) the pitch's HUD tiles
		Parent = entry.Root,
		Callback = function()
			safe("menu " .. spec.Id, spec.Action)
		end,
	})
	entry.Tile = tile
	entry.Button = tile.Root
	entry.Label = tile.Label
	-- icon-only tiles (the small row) name themselves on hover / long-press
	CloudUI.Tooltip(tile.Root, function()
		return spec.Label
	end)
	function entry.SetBadge(on)
		tile.SetBadge(on)
		P5.paintTab() -- a folded column still shows that a tile wants attention
	end
	paintTile(entry)
	Entries[spec.Id] = entry
	P5.tileVisibility(entry) -- a battle on a landscape phone (SetColumnHidden) / a collapsed column hide the tiles
	return entry
end

-- A tile shows unless a battle holds the left edge (SetColumnHidden) or the column is folded away (after its slide).
function P5.tileVisibility(entry)
	if entry and entry.Root then
		entry.Root.Visible = not U.ColumnHidden and not U.TilesFolded and not U.Covered
	end
end

-- Roblox's touch thumbstick is (or will be) on screen: a touch-only device, or a screen where PlayerModule's TouchGui
-- shows a thumbstick frame although the device also has a keyboard (Studio's device emulator, touch laptops,
-- tablets with a keyboard: TouchEnabled AND KeyboardEnabled, so `touchDevice` is false there). The column then uses
-- the touch layout: the band above the stick, thumb-sized tiles and tab. Polled by P5.watchSheets until it is true.
-- LATCHED: once seen, true for the rest of the session. PlayerModule hides the stick on respawn and while the Esc menu
-- is open (TouchGui.Enabled, not read here) and on every mouse / keyboard input of a hybrid device (the frame's
-- Visible); following those would snap the column between layouts. A keyboard-only PC never gets the stick frames.
function P5.stickShown()
	if touchDevice or U.StickSeen then
		return true
	end
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local touchGui = pg and pg:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	if not (frame and frame:IsA("GuiObject") and frame.Visible) then
		return false
	end
	for _, name in ipairs(K.STICK_FRAMES) do
		local stick = frame:FindFirstChild(name)
		if stick and stick:IsA("GuiObject") and stick.Visible then
			U.StickSeen = true -- latched for the session (U lives as long as the client)
			return true
		end
	end
	return false
end

-- Design size of the column frame for `cols` tile columns: the tiles plus the arrow tab beside them.
function P5.columnSize(cols)
	local rows = math.ceil(#MENU / cols)
	local tilesW = cols * P5.TILE + (cols - 1) * P5.GAP
	local tabW = U.StickShown and P5.TAB_W_TOUCH or P5.TAB_W
	return tilesW + P5.TAB_GAP + tabW, rows * P5.TILE + (rows - 1) * P5.GAP, tilesW
end

-- Places the tiles in `cols` columns (row by row: Pets Index / Home Stats in two columns) and the tab beside
-- the last row, right after its last tile (the gear: with 3 columns that row holds only 2 tiles, and the tab must not
-- leave an empty slot before it). Sets U.ColumnW / U.ColumnH / U.TilesW / U.TabX (design px).
function P5.placeTiles(cols)
	local touch = U.StickShown == true -- the tab's width follows the touch layout
	if U.Cols == cols and U.ColsTouch == touch then
		return
	end
	U.Cols = cols
	U.ColsTouch = touch
	local w, h, tilesW = P5.columnSize(cols)
	for index, spec in ipairs(MENU) do
		local entry = Entries[spec.Id]
		if entry and entry.Root then
			local i = index - 1
			entry.Root.Position = UDim2.fromOffset((i % cols) * (P5.TILE + P5.GAP), math.floor(i / cols) * (P5.TILE + P5.GAP))
		end
	end
	local lastRow = #MENU - (math.ceil(#MENU / cols) - 1) * cols
	U.ColumnW, U.ColumnH, U.TilesW = w, h, tilesW
	U.TabX = lastRow * (P5.TILE + P5.GAP) - P5.GAP + P5.TAB_GAP
	U.Column.Size = UDim2.fromOffset(w, h)
	if U.Tab then
		U.Tab.Size = UDim2.fromOffset(w - tilesW - P5.TAB_GAP, P5.TILE)
		U.Tab.Position = UDim2.fromOffset(U.TabX, h - P5.TILE)
		P5.sizeTabHit()
	end
end

-- (Pitch 2 look review r0, the lobby:fold render) the "!" on the folded tab's red block. PixelIcon draws whole screen-px
-- cells (an 18 px icon never under 2 px a cell), so under the column's scale below 1 (0.85 on a 1080p desktop, about 0.7
-- on a phone) the 18 px bang drew 18 screen px on a 15 - 16 px face, over its top edge and its lip. The bang is 18 px
-- where its drawn cells fit the face above the lip with a px to spare, else the 9 px one (1 px cells), centred on that
-- face. Again whenever the column's scale changes (relayoutMenu)
function P5.fitTabBang()
	local badge = U.TabBadge
	if not badge then
		return
	end
	local s = U.ColumnScale and U.ColumnScale.Scale or 1
	s = s > 0 and s or 1
	local room = P5.BADGE - P5.BADGE_LIP
	local px = (PixelIcon.BoxPx(18, 0, s) + 1 <= room) and 18 or 9
	local bang = badge:FindFirstChild("Mark")
	if bang and bang:GetAttribute("BangPx") == px then
		return
	end
	if bang then
		bang:Destroy()
	end
	bang = PixelIcon.New(badge, "bang", px, Theme.Sign.Text)
	if not bang then
		return
	end
	bang.Name = "Mark"
	bang:SetAttribute("BangPx", px)
	bang.AnchorPoint = Vector2.new(0.5, 0)
	bang.Position = UDim2.new(0.5, 0, 0, math.floor((room - px) / 2))
	bang.ZIndex = 6
	for _, cell in ipairs(bang:GetChildren()) do
		if cell:IsA("GuiObject") then
			cell.ZIndex = 6
		end
	end
end

-- the fold tab's hit pad (touch only): 44 screen px each way at the column's scale, from the tab's bottom-left corner
function P5.sizeTabHit()
	local hit, tab = U.TabHit, U.Tab
	if not (hit and tab) then
		return
	end
	local s = U.ColumnScale and U.ColumnScale.Scale or 1
	s = s > 0 and s or 1
	local need = math.ceil(44.5 / s)
	hit.Size = UDim2.fromOffset(math.max(tab.Size.X.Offset, need), math.max(tab.Size.Y.Offset, need))
	hit.Visible = U.StickShown == true or UserInputService.TouchEnabled == true
end

-- The tab's arrow points where a click sends the column ("<" fold away, ">" bring back); while folded, a red dot
-- repeats any tile's badge (new pets, Index rewards).
function P5.paintTab()
	if not U.Tab then
		return
	end
	local arrow = U.Collapsed and ">" or "<"
	if U.TabArrow:GetAttribute("Dir") ~= arrow then
		U.TabArrow:SetAttribute("Dir", arrow)
		local old = U.TabArrow:FindFirstChild("Icon")
		if old then
			old:Destroy()
		end
		local icon = PixelIcon.New(U.TabArrow, U.Collapsed and "arrow" or "left", 27, Theme.Sign.Text)
		if icon then
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
			icon.ZIndex = 4
			for _, cell in ipairs(icon:GetChildren()) do
				cell.ZIndex = 4
			end
		end
	end
	local badge = false
	if U.Collapsed then
		for _, entry in pairs(Entries) do
			local dot = entry.Tile and entry.Tile.Badge
			badge = badge or (dot ~= nil and dot.Visible == true)
		end
	end
	if U.TabBadge.Visible ~= badge then
		U.TabBadge.Visible = badge
		-- (Pitch 2 item 04) the arrow steps down under the "!" block while it shows
		U.TabArrow.Position = UDim2.fromOffset(0, badge and P5.BADGE_DROP or 0)
	end
	if U.Tab:GetAttribute("Collapsed") ~= (U.Collapsed == true) then
		U.Tab:SetAttribute("Collapsed", U.Collapsed == true)
	end
end

-- Folds the column away against the left edge (only the tab stays) or brings it back. Remembered for the session
-- (U.Collapsed lives as long as the client; the menu gui never resets on respawn).
function P5.setCollapsed(on, animate)
	on = on == true
	if U.Collapsed == on then
		return
	end
	U.Collapsed = on
	U.FoldSerial = (U.FoldSerial or 0) + 1
	local serial = U.FoldSerial
	if not on then
		U.TilesFolded = false
		for _, entry in pairs(Entries) do
			P5.tileVisibility(entry)
		end
	end
	P5.paintTab()
	if gui and gui:GetAttribute("MenuCollapsed") ~= on then
		gui:SetAttribute("MenuCollapsed", on)
	end
	P5.slideAnimate = animate == true
	relayoutMenu()
	P5.slideAnimate = false
	if on then
		-- the tiles hide once they are off screen: nothing measures, rings or selects a tile nobody can see
		local function fold()
			if U.Collapsed and U.FoldSerial == serial then
				U.TilesFolded = true
				for _, entry in pairs(Entries) do
					P5.tileVisibility(entry)
				end
			end
		end
		if animate then
			task.delay(P5.SLIDE + 0.05, fold)
		else
			fold()
		end
	end
end

-- The tutorial needs a tile while one of its steps points at the menu: a folded column comes back for it.
function P5.tutorialWantsMenu()
	if P5.Tutorial == nil then
		P5.Tutorial = false
		local controllers = script.Parent
		local inst = controllers and controllers:FindFirstChild("TutorialController")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" and type(mod.GetState) == "function" then
				P5.Tutorial = mod
			end
		end
	end
	if not P5.Tutorial then
		return false
	end
	local ok, st = pcall(P5.Tutorial.GetState)
	return ok and type(st) == "table" and not st.Done and type(st.Target) == "table" and st.Target.Kind == "Menu"
end

local function buildColumn()
	local column = makeFrame(gui, "MenuColumn", {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, K.EDGE, 0.5, 0),
		ZIndex = 2,
	})
	U.Column = column
	U.ColumnScale = Util.Create("UIScale", { Name = "ViewportScale", Scale = 1, Parent = column })
	for index, spec in ipairs(MENU) do
		buildTile(column, spec, index)
	end
	-- the hide / show tab: a slim navy tab with an arrow, beside the last tile (the gear), so the tutorial's pointer
	-- at Pets / Team / Index / Home never lands on it
	-- (kit-b U8) a stone tab in a wood edge like the tiles, the arrow in brown
	local tab = Util.Create("TextButton", {
		Name = "Toggle",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Sign.Tile,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = column,
	})
	U.TabStroke = stroke(tab, Theme.Sign.Wood, 3, 0)
	U.TabStroke.LineJoinMode = Enum.LineJoinMode.Miter
	-- (LOOK-ui) the tab is a kit block like the tiles: the same 6 px stone lip, and the arrow a PixelIcon ("left" while the
	-- column is out, "arrow" (right) while folded; attribute Dir "<" / ">"), not the "<" letter
	makeFrame(tab, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 6),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.StoneLip,
		ZIndex = 3,
	})
	U.TabArrow = makeFrame(tab, "Arrow", {
		Size = UDim2.new(1, 0, 1, -6),
		ZIndex = 4,
	})
	-- (Pitch 2 item 04_world_ui, the owner's pick B: the 14 px pink dot straddled the tab's corner, half off the folded
	-- tab at the screen's edge) the "!" is a red kit block INSIDE the tab's top (a 2 px mitred wood edge, a 3 px lip, the
	-- pixel bang in the kit's brown ink); the arrow steps down under it while it shows (P5.paintTab)
	U.TabBadge = makeFrame(tab, "Badge", {
		Position = UDim2.fromOffset(P5.BADGE_X, P5.BADGE_X),
		Size = UDim2.fromOffset(P5.BADGE, P5.BADGE),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.Red,
		Visible = false,
		ZIndex = 5,
	})
	local badgeEdge = stroke(U.TabBadge, Theme.Sign.Wood, 2, 0)
	badgeEdge.Name = "SignEdge"
	badgeEdge.LineJoinMode = Enum.LineJoinMode.Miter
	makeFrame(U.TabBadge, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, P5.BADGE_LIP),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.RedLip,
		ZIndex = 5,
	})
	-- (the mock's tab and the NPC signs' "!": the kit's brown ink on the block; it was stone) its size follows the
	-- column's scale (P5.fitTabBang)
	P5.fitTabBang()
	U.Tab = tab
	tab.Activated:Connect(function()
		safe("menu fold", P5.setCollapsed, not U.Collapsed, true)
	end)
	-- (Pitch 2 F0 A, look review of finish pass A, major 7: the tab is 21 px wide on a phone) on touch an invisible hit pad
	-- over the tab, reaching right into the free sky, gives the thumb 44 screen px each way (P5.sizeTabHit); the tab's
	-- look stays the slim kit tab
	U.TabHit = Util.Create("TextButton", {
		Name = "ToggleHit",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Visible = false,
		ZIndex = 6,
		Parent = tab,
	})
	U.TabHit:SetAttribute("HitFor", "Toggle")
	U.TabHit.Activated:Connect(function()
		safe("menu fold", P5.setCollapsed, not U.Collapsed, true)
	end)
	CloudUI.Tooltip(tab, function()
		return U.Collapsed and "Show menu" or "Hide menu"
	end)
	P5.placeTiles(1)
	P5.paintTab()
end

-- Phase 5 (6.6): on a portrait phone a window is a bottom sheet; while ANY docked sheet is up (ours, the Care / Index /
-- Fusion windows, the dungeon or arena side panels) the tile grid steps aside so the screen stays <= 60% covered.
-- Checked 4 times a second, only on portrait screens: the ScreenGuis' window holders carry NeonKit.Dock's DockMode.
function P5.sheetUp()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	for _, g in ipairs(pg and pg:GetChildren() or {}) do
		if g:IsA("ScreenGui") and g.Enabled then
			for _, holder in ipairs(g:GetChildren()) do
				if holder:IsA("GuiObject") and holder.Visible and holder:GetAttribute("DockMode") == "Sheet" then
					return true
				end
			end
		end
	end
	return false
end

-- The bottom (gui px; both guis keep Roblox's inset) of HudController's top-left panels, 0 when none is shown.
function P5.hudTopLeftBottom()
	local hud = P5.Hud
	if not (hud and hud.Parent and hud.Enabled) then
		return 0
	end
	return tonumber(hud:GetAttribute("TopLeftBottom")) or 0
end

-- relayout as soon as the HUD's top-left panels appear / go (the portrait grid steps below them)
function P5.watchHud()
	if P5.Hud and P5.Hud.Parent then
		return
	end
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if hud and hud:IsA("ScreenGui") then
		P5.Hud = hud
		hud:GetAttributeChangedSignal("TopLeftBottom"):Connect(function()
			safe("hud panels", relayoutMenu)
		end)
		hud:GetPropertyChangedSignal("Enabled"):Connect(function()
			safe("hud panels", relayoutMenu)
		end)
		safe("hud panels", relayoutMenu)
	end
end

function P5.watchSheets()
	task.spawn(function()
		while gui and gui.Parent do
			P5.watchHud()
			local area = guiSize()
			local hide = area.X < area.Y and P5.sheetUp()
			if U.Column and hide ~= (U.SheetHidden == true) then
				U.SheetHidden = hide
				U.Column.Visible = not hide
				if not hide then
					safe("menu covers", P5.applyCovers) -- (look review r0) a cover asked for while the column was away
				end
			end
			-- a tutorial step that points at a tile brings a folded column back (the ring needs the tile on screen)
			if U.Collapsed and P5.tutorialWantsMenu() then
				safe("menu unfold", P5.setCollapsed, false, true)
			elseif U.Collapsed then
				safe("menu tab", P5.paintTab) -- the tab's dot follows the tiles' badges
			end
			-- Roblox's thumbstick appeared (hybrid devices, the emulator): the column moves above it, for good (latched)
			if U.Column and not U.StickShown and P5.stickShown() then
				safe("menu stick", relayoutMenu)
			end
			task.wait(0.25)
		end
	end)
end

-- the column's place and scale: left-centre on desktops; on touch landscape screens (P5.stickShown: a touch device or
-- Roblox's thumbstick on screen) in the band between the top margin and the thumbstick; on portrait phones above the
-- bottom sheet's top (0.44 H). One column when it fits at P5.MIN_TILE_PX per tile, else two; folded (U.Collapsed) the
-- column sits left of the edge with only its tab showing.
function relayoutMenu()
	if not gui or not U.Column then
		return
	end
	local area = guiSize()
	local factor = screenFactor()
	local touchLayout = P5.stickShown() -- first: it latches U.StickSeen, which screenMargin reads
	U.StickShown = touchLayout
	local margin = screenMargin()
	local pref = factor * P5.TILE_PX / P5.TILE
	if touchLayout then
		pref = math.max(P5.TOUCH_TILE_PX, factor * P5.TILE_PX) / P5.TILE
	end
	local minScale = P5.MIN_TILE_PX / P5.TILE
	local first, avail -- gui px: the top of the band the column is centred in, and its height
	if area.X >= area.Y then
		local bottom = area.Y - margin
		if touchLayout then
			-- the ring's size follows TouchControlFrame's AbsoluteSize, which is this gui area (neither ignores the top
			-- bar), not the camera viewport: a 540 px tall screen (482 px area) still gets the small ring
			local big = math.min(area.X, area.Y) > K.STICK_BIG
			bottom = area.Y - (big and K.STICK_TOP_LARGE or K.STICK_TOP_SMALL) - K.STICK_GAP
		end
		first = margin
		avail = bottom - margin
	else
		local inset = P5.inset()
		local bottom = (area.Y + inset) * 0.44 - inset - margin -- the bottom sheet's top edge (0.44 of the SCREEN)
		first = margin + 80 * factor -- under the HUD's top-left corner
		local hudBottom = P5.hudTopLeftBottom()
		if hudBottom > 0 and hudBottom + margin > first then
			-- a party / match panel is up: there is no room for it beside the tiles on a phone this narrow, so the
			-- panel keeps the top-left corner and the tiles step below it (no sheet is up: the tiles hide for one)
			first = hudBottom + margin
			local _, h2 = P5.columnSize(2)
			bottom = math.max(bottom, first + h2 * pref)
		end
		avail = math.max(60, bottom - first)
	end
	-- one column when it fits with tiles >= MIN_TILE_PX, else the fewest columns that do
	local cols = 1
	while cols < P5.MAX_COLS and avail < select(2, P5.columnSize(cols)) * minScale do
		cols = cols + 1
	end
	P5.placeTiles(cols)
	local w, h = U.ColumnW, U.ColumnH
	-- never into the middle of the screen (a narrow portrait phone): the column's right edge stays left of it
	local camera = workspace.CurrentCamera
	local vpX = (camera and camera.ViewportSize.X > 2) and camera.ViewportSize.X or area.X
	-- (LOOK-ui) the free scale stays (the owner's 56 px tile at 1080p): the tiles' icons, edges and lips snap to whole
	-- screen px themselves (PixelIcon.New, PixelIcon.WholeTree on NimbusMenu)
	local scale = math.min(pref, avail / h, math.max(minScale * 0.9, (vpX * (0.5 - P5.CENTRE_TOL) - 2 - margin) / w))
	local top = first + math.max(0, (avail - h * scale) / 2)
	U.ColumnScale.Scale = scale
	P5.sizeTabHit()
	P5.fitTabBang()
	-- a squeezed column (short screens) grows its labels so they stay >= 14 screen px
	local labelPx = math.min(26, math.max(18, math.ceil(14.5 / math.max(scale, 0.3))))
	-- ... and so does the "!" of a tile's red badge (its dot grows around it)
	local markPx = math.max(14, math.ceil(14.5 / math.max(scale, 0.3)))
	for _, entry in pairs(Entries) do
		if entry.Label then
			entry.Label.TextSize = labelPx
			entry.Label.Size = UDim2.new(1, 12, 0, labelPx + 2)
		end
		local badge = entry.Tile and entry.Tile.Badge
		local mark = badge and badge:FindFirstChild("Mark")
		if mark and mark:IsA("TextLabel") then
			mark.TextSize = markPx
			badge.Size = UDim2.fromOffset(math.max(22, markPx + 4), math.max(22, markPx + 4))
		end
	end
	local left = margin
	if U.Collapsed then
		left = -math.floor(U.TabX * scale + 0.5) -- only the tab shows, flush with the edge
	end
	local goal = UDim2.new(0, left, 0, math.floor(top + 0.5))
	U.Column.AnchorPoint = Vector2.new(0, 0)
	if U.SlideTween then
		U.SlideTween:Cancel()
		U.SlideTween = nil
	end
	if P5.slideAnimate then
		U.SlideTween = tween(U.Column, P5.SLIDE, { Position = goal }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	else
		U.Column.Position = goal
	end
	if Hint.Frame then
		-- next to the column, and never wide enough to reach the middle of the screen
		local hintLeft = left + w * scale + 10
		local room = math.max(120, area.X * 0.34 - hintLeft - 28 * factor)
		Hint.Scale.Scale = factor
		Hint.ReadScale = factor -- (C24 round 2: P5.clampHint may shrink the block a little, never under this read scale's 14 px floor)
		Hint.BaseY = math.floor(top + h * scale / 2 + 0.5) -- (playtest 2026-11-28 C24: P5.clampHint moves it off the HUD)
		Hint.Frame.Position = UDim2.new(0, hintLeft, 0, Hint.BaseY)
		Hint.MaxW = math.min(300, math.floor(room / factor))
		P5.clampHint()
	end
	for _, win in pairs(windows) do
		if win.Shown then
			layoutWindow(win)
		end
	end
end

local function setActive(id, on)
	local entry = Entries[id]
	if entry and entry.Active ~= (on and true or false) then
		entry.Active = on and true or false
		paintTile(entry)
	end
end

local function setDisabled(id, on)
	local entry = Entries[id]
	if entry and entry.Disabled ~= (on and true or false) then
		entry.Disabled = on and true or false
		paintTile(entry)
	end
end

function updateMenuActive()
	local petsUp = P5.petsOpen()
	setActive("Pets", petsUp)
	setActive("Index", indexOpen())
	setActive("Stats", windows.Stats ~= nil and windows.Stats.Shown)

	setActive("Spot", windows.Home ~= nil and windows.Home.Shown)
	if petsUp and Entries.Pets then
		Entries.Pets.SetBadge(false)
	end
	-- the Spot tile is greyed out in matches
	setDisabled("Spot", inMatch())
end

-- Red dot on the Index tile while a completed group's reward waits.
local function refreshIndexBadge()
	local entry = Entries.Index
	local index = Index.Module
	if not entry or not index or type(index.ClaimableCount) ~= "function" then
		return
	end
	local ok, count = pcall(index.ClaimableCount)
	entry.SetBadge(ok and type(count) == "number" and count > 0)
end

----------------------------------------------------------------------
-- Stats window
----------------------------------------------------------------------
-- (kit-b U9-3, finding 15) the Stats window on the Signboard kit (the window's Skin "Signboard": the awning, the navy
-- header with "Stats" as its ribbon, the wood frame round the stone body), as the Home window is. Each stat is a raised
-- stone block in its wood edge (P5.signBlock) with a square chip in its group's colour holding the stat's PixelIcon and
-- the number in brown (the pitch's pet stats: chip, caption, number); the groups: obby races sky, tokens gold, egg spins
-- the awning's pink, pets violet. The perks, the battle record and the best times sit under plain Section headings (the
-- owner's ruling 2026-11-14: the ribbon is for window titles only); each difficulty's row is a stone block whose lip and
-- side bar carry the difficulty's colour. The dark wells, the coloured numbers, the round corners went.
P5.STAT_TILES = {
	{ "Matches", "Matches played", "mountain", Theme.Sign.Sky },
	{ "Wins", "Victories", "trophy", Theme.Sign.Sky },
	{ "WinRate", "Win rate", "target", Theme.Sign.Sky },
	{ "Tokens", "Cloud Tokens", "token", Theme.Sign.Gold }, -- (playtest 2026-11-28 C20: Theme.Currency.Tokens.Name) -- the chip's coin is the token icon (U7a: no second coin)
	{ "Earned", "Tokens earned", "token", Theme.Sign.Gold },
	{ "Spins", "Roulette spins", "gumball", Theme.Sign.Roof },
	{ "Found", "Pets discovered", "book", Theme.Sign.Violet },
	{ "Owned", "Pets owned", "paw", Theme.Sign.Violet },
}

-- a stone card with a plain Section heading over a padded list (the perks, the battle record): the card is the block,
-- its "Inner" frame holds the padding and the list (the block's lip is a child of the card and must stay out of a list)
function P5.statCard(parent, name, title, order)
	local card = P5.signBlock(parent, name, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
	})
	local inner = makeFrame(card, "Inner", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	pad(inner, 14, 8, 14, 14)
	listLayout(inner, Enum.FillDirection.Vertical, 4)
	Theme.StyleTitle(makeText(inner, "Title", title, "Title", 24, P5.HS.Text, {
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	}), "Section")
	return card, inner
end

local function buildStats(win)
	local content = win.Panel.Content
	local tiles = {} -- key -> value label
	local rows = {} -- difficulty id -> time label

	-- left: stat tiles + pet perks
	local left = scroller(content, "Left", {
		Position = UDim2.fromOffset(14, 14),
		Size = UDim2.new(0.55, -21, 1, -28),
	})
	left.ScrollBarImageColor3 = P5.HS.Wood -- (kit-b U9-3)
	pad(left, 2, 2, 12, 6)
	listLayout(left, Enum.FillDirection.Vertical, 10)
	local grid = makeFrame(left, "Tiles", {
		Size = UDim2.new(1, 0, 0, 4 * 94 + 3 * 10),
		LayoutOrder = 1,
	})
	Util.Create("UIGridLayout", {
		CellSize = UDim2.new(0.5, -5, 0, 94),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = grid,
	})
	for index, spec in ipairs(P5.STAT_TILES) do
		local tile = P5.signBlock(grid, "Tile_" .. spec[1], { LayoutOrder = index })
		local chip = P5.signChip(tile, "Chip", spec[4], spec[3], 30)
		chip.Position = UDim2.fromOffset(12, 10)
		local value = makeText(tile, "Value", "0", "Display", 34, P5.HS.Text, {
			Position = UDim2.fromOffset(52, 5),
			Size = UDim2.new(1, -60, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 34, MinTextSize = 18, Parent = value })
		makeText(tile, "Caption", spec[2], "Heading", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(12, 52),
			Size = UDim2.new(1, -20, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		tiles[spec[1]] = value
	end

	local _, perks = P5.statCard(left, "Perks", "Pet perks", 3)
	local perksLabel = makeText(perks, "Lines", "", "Body", 19, P5.GOOD, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
	})

	-- Phase 3: the battle record (trophies from PvP duels, the Trial ladder, raids)
	local _, battle = P5.statCard(left, "Battle", "Pet battles", 4)
	local battleLabel = makeText(battle, "Lines", "", "Body", 19, P5.HS.Text, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 2,
	})

	-- right: best time per difficulty (kit-b U9-3: on the stone body itself, as the Home window's station list)
	-- (LOOK-ui, kitb-look1: two lists stacked in the narrow window, each with its own bar, each cutting a row in half) the
	-- best times are one section that moves: in their own column beside the stats on a wide window, under the stat tiles
	-- in the one list on a narrow one (the window is narrow at every PC size: 640 wide)
	local right = makeFrame(content, "Right", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.new(0.45, -21, 1, -28),
	})
	local list = scroller(right, "List", {
		Size = UDim2.new(1, 0, 1, 0),
	})
	list.ScrollBarImageColor3 = P5.HS.Wood
	pad(list, 2, 2, 14, 8)
	listLayout(list, Enum.FillDirection.Vertical, 8)
	local times = makeFrame(list, "BestTimes", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
	})
	listLayout(times, Enum.FillDirection.Vertical, 8)
	Theme.StyleTitle(makeText(times, "Title", "Best times", "Title", 24, P5.HS.Text, {
		Size = UDim2.new(1, 0, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 0,
	}), "Section")
	for index, difficulty in ipairs(Config.Difficulties) do
		local row = P5.signBlock(times, "Row_" .. difficulty.Id, {
			Size = UDim2.new(1, 0, 0, 70),
			LayoutOrder = index,
		}, difficulty.Color)
		-- the difficulty's colour down the left side, square, in the row's wood edge
		makeFrame(row, "Bar", {
			Position = UDim2.fromOffset(0, 0),
			Size = UDim2.new(0, 8, 1, -5),
			BackgroundTransparency = 0,
			BackgroundColor3 = difficulty.Color,
		})
		makeText(row, "Name", difficulty.DisplayName, "Title", 24, P5.HS.Text, {
			Position = UDim2.fromOffset(20, 5),
			Size = UDim2.new(0.55, -20, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		starRating(makeText(row, "Stars", "", "Heading", 18, P5.HS.GoldDeep, {
			Position = UDim2.fromOffset(20, 36),
			Size = UDim2.new(0.55, -20, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		}), difficulty.Stars)
		rows[difficulty.Id] = makeText(row, "Time", "--:--", "Display", 30, P5.HS.Text, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 0),
			Size = UDim2.new(0.45, 0, 1, -5),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end

	win.OnLayout = function(_w, _h, _narrow, _short, tall)
		left.Position = UDim2.fromOffset(14, 14)
		if tall then
			left.Size = UDim2.new(1, -28, 1, -28)
			times.Parent = left
			right.Visible = false
		else
			left.Size = UDim2.new(0.55, -21, 1, -28)
			times.Parent = list
			right.Visible = true
		end
	end

	win.Refresh = function()
		local snapshot = State.Get()
		local stats = snapshot.Stats
		local matches = stats.Matches or 0
		local wins = stats.Wins or 0
		tiles.Matches.Text = commas(matches)
		tiles.Wins.Text = commas(wins)
		if matches > 0 then
			tiles.WinRate.Text = string.format("%d%%", math.floor(wins / matches * 100 + 0.5))
		else
			tiles.WinRate.Text = G.Dash
		end
		tiles.Tokens.Text = commas(State.Tokens())
		tiles.Earned.Text = commas(stats.TokensEarned or 0)
		tiles.Spins.Text = commas(stats.Spins or 0)
		local _, total = petTotals()
		tiles.Found.Text = string.format("%d / %d", discoveredCount(), catalogTotal())
		tiles.Owned.Text = commas(total)

		for id, label in pairs(rows) do
			local seconds = stats.BestTimes[id]
			if type(seconds) == "number" and seconds > 0 then
				label.Text = Util.FormatTime(seconds)
				label.TextColor3 = P5.HS.Text
			else
				label.Text = "--:--"
				label.TextColor3 = P5.HS.TextMuted
			end
		end

		local okBattle, b = pcall(State.Battle)
		b = okBattle and type(b) == "table" and b or {}
		-- Phase 5 (10.5): the Trial ladder is gone; the dungeon line takes its place
		local dungeon = type(State.Dungeon) == "function" and State.Dungeon() or nil
		dungeon = type(dungeon) == "table" and dungeon or {}
		battleLabel.Text = string.format("Trophies: %s     Dungeon: floor %d cleared, %s runs\nDuels: %s won, %s lost     Boss raids: %s",
			commas(b.Trophies or 0), math.floor(tonumber(dungeon.Best) or 0), commas(math.floor(tonumber(dungeon.Runs) or 0)),
			commas(b.PvPWins or 0), commas(b.PvPLosses or 0), commas(b.Raids or 0))

		local lines = {}
		local order = PetCatalog.PerkOrder or { "MaxHealth", "TokenBonus", "StaminaRegen", "CheckpointHeal" }
		for _, key in ipairs(order) do
			local value = snapshot.Perks[key]
			if type(value) == "number" and value > 0 then
				table.insert(lines, PetCatalog.PerkLabel(key, value))
			end
		end
		if #lines > 0 then
			perksLabel.Text = table.concat(lines, "     ")
			perksLabel.TextColor3 = P5.GOOD
		else
			perksLabel.Text = "No perks yet. Put a pet in your team!"
			perksLabel.TextColor3 = P5.HS.TextMuted
		end
	end
end

----------------------------------------------------------------------
-- Home window (Phase 2): the house, income, the Collector, prestige, and every station with its upgrade
----------------------------------------------------------------------
-- (kit-b U9-1, finding 15) the Home window on the Signboard kit: brown ink on stone, wood edges, square blocks with a lip
-- in their role colour, no glow, gloss, sweep or round corner. The helpers (fields of P5: the main chunk is close to Lua's
-- 200-local limit):
--   P5.signBlock(parent, name, props, lip)  a raised stone block in its wood edge (CloudUI.SignBlock) with a lip of `lip`
--                                           (the stone's own lip when nil): a card, a station row, a strip tile, a step
--   P5.signTag(parent, name, text, px, order, role)  a small gold tag (MAX, NEXT, x1.25): brown FredokaOne on gold, wood
--                                           edge; role "Tag" (capitals) unless given ("Heading" keeps the x of x1.25)
--   P5.signChip(parent, name, color, glyph, px)  a square chip in a role colour holding a PixelIcon (NeonKit.Icon, "Icon")
--                                           in the ink that reads on it (Theme.TextOn): a station's or a strip tile's mark
P5.HS = Theme.Sign
-- the green of good news in text (cash, "ready", what you keep): the grass lip darkened until it reads 4.5:1 on stone at
-- a phone's small sizes (the lip itself is 3.5:1)
P5.GOOD = Theme.Darken(Theme.Sign.GrassLip, 0.25)
function P5.signBlock(parent, name, props, lip)
	local block = makeFrame(parent, name, props or {})
	CloudUI.SignBlock(block, "Stone", { Face = P5.HS.Tile, LipColor = lip or P5.HS.StoneLip, Pad = false })
	return block
end

function P5.signTag(parent, name, text, px, order, role)
	px = px or 18
	local tag = Theme.Label(text, role or "Tag", {
		Size = px,
		Color = P5.HS.Text,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, px + 10),
			LayoutOrder = order or 0,
		},
	})
	CloudUI.SignBlock(tag, "Selected", { EdgePx = 2, LipPx = 3 })
	local inset = tag:FindFirstChild("LipPad")
	if inset then
		inset.PaddingLeft = UDim.new(0, 9)
		inset.PaddingRight = UDim.new(0, 9)
	end
	tag.Parent = parent
	return tag
end

function P5.signChip(parent, name, color, glyph, px)
	local chip = makeFrame(parent, name, {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		Size = UDim2.fromOffset(px, px),
	})
	local edge = stroke(chip, P5.HS.Wood, 2, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	-- the icon at the largest multiple of 9 that leaves a 3 px margin (NeonKit.Icon hosts it at 0.9 x its size)
	local iconPx = math.max(9, 9 * math.floor((px - 6) / 9))
	local icon = P5.Kit.Icon(chip, glyph, math.floor(iconPx / 0.9 + 0.5))
	icon.TextColor3 = Theme.TextOn(color)
	return chip, icon
end

-- Phase 5 (3.4): the Home window's flow strip, the first item of its list: four tiles that tell the home loop
-- "Berry Farm Lv 13" -> "Pets earn Cash $3,000/min" -> "Berry Basket 1,240 / 3,000" -> "Food Machine: Feed = XP".
-- (kit-b U7b) each tile's Glyph is a PixelIcon name (NeonKit.Icon draws it); the second tile was "Pets eat & poop" with
-- the pile-of-poo emoji (rejects audit 5): it says what the player gets, the Cash note icon (Config.Icons.Cash).
-- (kit-b U9-1) each tile is a stone block whose lip and icon chip carry its colour (was a neon card in that colour)
P5.STRIP = {
	{ Id = "Farm", Title = "Berry Farm", Glyph = "berry", Color = Theme.Sign.Roof },
	{ Id = "Earn", Title = "Pets earn Cash", Glyph = "note", Color = Theme.Sign.Grass },
	{ Id = "Basket", Title = "Berry Basket", Glyph = "basket", Color = Theme.Sign.Violet },
	{ Id = "Machine", Title = "Food Machine", Glyph = "pot", Color = C2.Kind.FoodMachine },
}
function P5.buildStrip(H, _content)
	local strip = makeFrame(H.List, "FlowStrip", { Size = UDim2.new(1, 0, 0, 84), LayoutOrder = -1000 })
	H.Strip = strip
	H.StripTiles = {}
	H.StripArrows = {}
	for i, spec in ipairs(P5.STRIP) do
		local tile = P5.signBlock(strip, "Flow_" .. spec.Id, { Size = UDim2.fromOffset(180, 76) }, spec.Color)
		local chip = P5.signChip(tile, "Chip", spec.Color, spec.Glyph, 26)
		chip.Position = UDim2.fromOffset(7, 9)
		local title = makeText(tile, "Title", spec.Title, "Heading", 18, P5.HS.Text, {
			Position = UDim2.fromOffset(38, 7),
			Size = UDim2.new(1, -42, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 18, Parent = title })
		local value = makeText(tile, "Value", "", "Display", 22, P5.HS.Text, {
			Position = UDim2.fromOffset(10, 39),
			Size = UDim2.new(1, -16, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 18, Parent = value })
		H.StripTiles[i] = { Root = tile, Title = title, Value = value }
		if i < #P5.STRIP then
			H.StripArrows[i] = makeText(strip, "Arrow" .. i, "", "Title", 18, P5.HS.Wood, { Size = UDim2.fromOffset(20, 76) })
			-- (kit-b U7b: the gap between two tiles' rims is ~14 px; LOOK-ui, kitb-look1: the narrow nub at 18 px, the screen's
			-- 2 px cells, not "play" at 9 px and 1 px cells)
			PixelIcon.Host(H.StripArrows[i], HOME_ICON.Arrow, 18)
		end
	end
end

-- 1 x 4 on wide windows, 2 x 2 on narrow ones (each tile keeps its title on one line); returns 0 (the strip scrolls
-- with the list)
function P5.layoutStrip(H, w)
	if not H.Strip then
		return 0
	end
	local inner = w - 62
	local wide = inner >= 720
	local cols = wide and 4 or 2
	local arrowW = 22
	local tileW = math.floor((inner - (cols - 1) * arrowW) / cols)
	local tileH = 76
	for i, tile in ipairs(H.StripTiles) do
		local col = (i - 1) % cols
		local row = math.floor((i - 1) / cols)
		tile.Root.Position = UDim2.fromOffset(col * (tileW + arrowW), row * (tileH + 8))
		tile.Root.Size = UDim2.fromOffset(tileW, tileH)
		local arrow = H.StripArrows[i]
		if arrow then
			arrow.Visible = col < cols - 1
			arrow.Position = UDim2.fromOffset(col * (tileW + arrowW) + tileW + 1, row * (tileH + 8))
		end
	end
	local rows = math.ceil(#H.StripTiles / cols)
	H.Strip.Size = UDim2.new(1, 0, 0, rows * tileH + (rows - 1) * 8 + 4)
	return 0
end

function P5.paintStrip(H, home, income, open)
	if not H.StripTiles then
		return
	end
	local farm = P2.stationLevelOf(home, "Press1")
	local tiles = H.StripTiles
	tiles[1].Value.Text = farm >= 1 and ("Lv " .. farm) or "Build it!"
	local perMin = math.floor((tonumber(income) or 0) * 60 + 0.5)
	tiles[2].Value.Text = perMin > 0 and (P2.formatCash(perMin) .. " a minute") or "Garden pets"
	local berries = type(State.Berries) == "function" and State.Berries() or 0
	local folder = H.PlotFolder and H.PlotFolder() or nil
	local cap = folder and folder:GetAttribute("BerryCap")
	if type(cap) == "number" and cap > 0 then
		tiles[3].Value.Text = commas(berries) .. " / " .. commas(math.floor(cap))
	else
		tiles[3].Value.Text = commas(berries) .. " berries"
	end
	tiles[4].Value.Text = P2.stationLevelOf(home, "Kitchen") >= 1 and "Feed = XP" or "Build it!"
	H.StripOpen = open
end

-- Phase 6 (the player asked: no Home gate in the lobby, "improve the one in the inventory"): the Home window's hero.
-- A big button on top of the window, fixed above the scrolling list: the house, "Go home" and a short line, an arrow
-- badge on the right. Without a home the same spot shows "Claim a home" (Remotes.GoToSpot: the home portal toward a free
-- gate, the server checks everything) and the three steps of claiming one replace the list.
-- (kit-b U9-1) the hero is the window's ONE green action: a kit B grass plank (CloudUI.Button Skin "Sign": hover lightens
-- the face, a press sinks it onto its lip, no scale; in a match it is the sunk "Off" well), the house and the arrow on
-- stone squares, "Go home" a plain Section heading (the owner's ruling 2026-11-14: the ribbon is for window titles only).
-- The golden gloss card and its light sweep went (finding 15: no gloss, no glow)
K.HERO_H = 96 -- the hero's height (design px)
K.HERO_H_SHORT = 76 -- ... on short windows (landscape phones)
P5.HERO = {
	-- (kit-b U7a) the house and the badge draw PixelIcons
	GoHome = { Title = "Go home", Sub = "A magic portal for you and your pets", Short = "Hop in with your pets!", Glyph = "house", Badge = "arrow" },
	-- (playtest 2026-11-28 C23 review) Tiny: the line a narrow card fits ('Your own sky i...' at 640x360)
	ClaimHome = { Title = "Claim a home", ShortTitle = "Claim home", Sub = "Get your own sky island, free!", Short = "Your own sky island, free!", Tiny = "Free sky island!", Glyph = "house", Badge = "sparkle" },
}
-- the Prestige confirm's fixed lines, and a long "You get" line (H.Layout sizes the lines to the widest of these); Short:
-- (kit-b U9-1) the same said in fewer words for a short window (a landscape phone), so the three lines fit its box
P5.PRESTIGE_TEXT = {
	Reset = "Your Cash, the Cloud Cash on your lawn and your stations (not the Garden)",
	Keep = "Pets, levels, evolutions, training, your teams, berries, the Garden and decor",
	Gain = "Star 10: x9.31 Cash, garden place 12 and 1,000 Gems", -- (playtest 2026-11-28 C20: Cash, not "coins")
	Short = {
		Reset = "Cash, lawn Cash and stations (not the Garden)",
		Keep = "Pets, teams, berries, the Garden and decor",
		Gain = "Star 2: x1.56 Cash, garden place 5 and 25 Gems",
	},
}
-- what a home gives (the claim view's "Your home" tiles)
P5.CLAIM_GETS = {
	{ Glyph = "sprout", Title = "Pet Garden", Text = "Pets roam and play", Color = Theme.Sign.Grass },
	{ Glyph = "apple", Title = "Berry Farm", Text = "Berries feed pets", Color = Theme.Sign.Roof },
	{ Glyph = "note", Title = "Cloud Cash", Text = "Pets earn for you", Color = Theme.Sign.Sky },
}
P5.CLAIM_STEPS = {
	{ Glyph = "sparkle", Text = "Tap Claim a home: a magic portal opens" },
	{ Glyph = "dash", Text = "Walk into it: you land at a free home" },
	{ Glyph = "key", Text = "Press E at its gate. The home is yours!" },
}

-- a stone square in the grass plank's lip colour (the hero's house well and its arrow badge)
function P5.heroSquare(parent, name, px, z)
	local square = makeFrame(parent, name, {
		BackgroundTransparency = 0,
		BackgroundColor3 = P5.HS.Tile,
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(px, px),
		ZIndex = z,
	})
	local edge = stroke(square, P5.HS.GrassLip, 3, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	return square
end

-- one hero button (a kit B grass plank) -> { Root, Title, Sub, Orb, Badge, Id }
function P5.heroCard(parent, id, callback)
	local spec = P5.HERO[id]
	local root = CloudUI.Button({
		Name = id,
		Text = "",
		Style = "Green",
		Skin = "Sign",
		Size = UDim2.new(1, 0, 0, K.HERO_H),
		ZIndex = 4,
		Callback = function(button)
			callback(button)
		end,
		Parent = parent,
	})
	local hero = { Root = root, Id = id }
	-- the house on its stone square
	local orb = P5.heroSquare(root, "Orb", 64, 5)
	orb.Position = UDim2.new(0, 16, 0.5, -2)
	local icon = P5.Kit.Icon(orb, spec.Glyph, 40) -- a 36 px PixelIcon
	icon.TextColor3 = P5.HS.Text
	icon.ZIndex = 6
	hero.Orb = orb
	hero.Title = Theme.StyleTitle(makeText(root, "Title", spec.Title, "Title", 34, P5.HS.OnGrass, {
		Position = UDim2.new(0, 96, 0.5, -4),
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.new(1, -176, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextScaled = true,
		ZIndex = 6,
	}), "Section") -- (kit-b prep) a card's heading inside the Home window: the window's bar wears the ribbon
	Util.Create("UITextSizeConstraint", { MaxTextSize = 34, MinTextSize = 24, Parent = hero.Title })
	hero.Sub = makeText(root, "Sub", spec.Sub, "Body", 19, P5.HS.OnGrass, {
		Position = UDim2.new(0, 96, 0.5, 0),
		Size = UDim2.new(1, -176, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 6,
	})
	-- the arrow ("go") on a small stone square at the right
	local badge = P5.heroSquare(root, "Badge", 52, 6)
	badge.AnchorPoint = Vector2.new(1, 0.5)
	badge.Position = UDim2.new(1, -18, 0.5, -2)
	local badgeGlyph = makeText(badge, "Glyph", "", "Title", 28, P5.HS.Text, { Size = UDim2.fromScale(1, 1), ZIndex = 7 })
	PixelIcon.Host(badgeGlyph, spec.Badge, 27)
	hero.Badge = badge
	return hero
end

-- the hero buttons + the claim steps of the Home window (H = win.HomeUi)
function P5.buildHomeHero(H, win, onGoHome, onClaim)
	local content = win.Panel.Content
	local holder = makeFrame(content, "Hero", {
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.new(1, -24, 0, K.HERO_H),
		ZIndex = 4,
	})
	H.Hero = holder
	H.GoHomeHero = P5.heroCard(holder, "GoHome", onGoHome)
	H.ClaimHero = P5.heroCard(holder, "ClaimHome", onClaim)
	H.GoHome = H.GoHomeHero.Root
	H.ClaimHome = H.ClaimHero.Root
	-- without a home: three steps (fixed under the hero; scrolls on very short windows)
	local steps = scroller(content, "ClaimSteps", {
		Position = UDim2.fromOffset(12, K.HERO_H + 24),
		Size = UDim2.new(1, -24, 1, -(K.HERO_H + 36)),
		Visible = false,
	})
	steps.ScrollBarImageColor3 = P5.HS.Wood
	pad(steps, 2, 2, 14, 6)
	H.ClaimList = listLayout(steps, Enum.FillDirection.Vertical, 12)
	makeText(steps, "Caption", "How to get your home", "Heading", 21, P5.HS.TextMuted, {
		Size = UDim2.new(1, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 0,
	})
	for i, step in ipairs(P5.CLAIM_STEPS) do
		local row = P5.signBlock(steps, "Step" .. i, { Size = UDim2.new(1, 0, 0, 72), LayoutOrder = i })
		-- the step's number on a gold block (brown ink: 9:1)
		local num = makeFrame(row, "Num", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12, 0.5, -2),
			Size = UDim2.fromOffset(40, 40),
		})
		CloudUI.SignBlock(num, "Selected", { EdgePx = 2, LipPx = 4 })
		makeText(num, "N", tostring(i), "Title", 24, P5.HS.Text, { Size = UDim2.new(1, 0, 1, -4) })
		local glyph = P5.Kit.Icon(row, step.Glyph, 30) -- a 27 px PixelIcon
		glyph.TextColor3 = P5.HS.Wood
		glyph.AnchorPoint = Vector2.new(0, 0.5)
		glyph.Position = UDim2.new(0, 62, 0.5, -2)
		-- (kit-b gate U9 r4) "Press E" in the words of this device (CloudUI.PromptWords)
		local stepText = step.Text:gsub("^Press E", CloudUI.PromptWords(true))
		makeText(row, "Text", stepText, "Body", 21, P5.HS.Text, {
			Position = UDim2.new(0, 104, 0, 0),
			Size = UDim2.new(1, -114, 1, -5),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
		})
	end
	-- what a home gives: three small stone tiles, each with its colour's chip and lip
	makeText(steps, "GetsCaption", "Your home has", "Heading", 21, P5.HS.TextMuted, {
		Size = UDim2.new(1, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 10,
	})
	local gets = makeFrame(steps, "Gets", { Size = UDim2.new(1, 0, 0, 132), LayoutOrder = 11 })
	H.ClaimGetsGrid = Util.Create("UIGridLayout", {
		CellSize = UDim2.new(1 / 3, -8, 1, 0),
		CellPadding = UDim2.new(0, 12, 0, 0),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = gets,
	})
	H.ClaimGetTiles = {}
	for i, item in ipairs(P5.CLAIM_GETS) do
		local tile = P5.signBlock(gets, "Get" .. i, { Size = UDim2.fromOffset(160, 132), LayoutOrder = i }, item.Color)
		local chip = P5.signChip(tile, "Orb", item.Color, item.Glyph, 48)
		chip.AnchorPoint = Vector2.new(0.5, 0)
		chip.Position = UDim2.new(0.5, 0, 0, 10)
		local title = makeText(tile, "Title", item.Title, "Heading", 20, P5.HS.Text, {
			Position = UDim2.new(0, 6, 0, 66),
			Size = UDim2.new(1, -12, 0, 24),
		})
		local body = makeText(tile, "Text", item.Text, "Body", 18, P5.HS.TextMuted, {
			Position = UDim2.new(0, 6, 0, 92),
			Size = UDim2.new(1, -12, 0, 24),
		})
		H.ClaimGetTiles[i] = { Chip = chip, Title = title, Text = body }
	end
	H.ClaimGets = gets
	H.ClaimSteps = steps
end

-- shows the hero of the current state (home or none), its disabled look in a match (CloudUI's sunk "Off" well), and
-- places the list under it
function P5.paintHomeHero(H, hasHome, matchOn)
	if not H.Hero then
		return
	end
	H.GoHomeHero.Root.Visible = hasHome
	H.ClaimHero.Root.Visible = not hasHome
	H.ClaimSteps.Visible = not hasHome
	H.List.Visible = hasHome
	for _, hero in ipairs({ H.GoHomeHero, H.ClaimHero }) do
		hero.Root:SetAttribute("Disabled", matchOn and true or false)
		hero.Badge.Visible = not matchOn
	end
	H.HomeState = hasHome
end

-- (w: the window's design width; narrow windows get the short line under the title)
function P5.layoutHomeHero(H, short, w)
	if not H.Hero then
		return 0
	end
	local h = short and K.HERO_H_SHORT or K.HERO_H
	H.Hero.Size = UDim2.new(1, -24, 0, h)
	for _, hero in ipairs({ H.GoHomeHero, H.ClaimHero }) do
		hero.Root.Size = UDim2.new(1, 0, 0, h)
		local orb = short and 52 or 64
		hero.Orb.Size = UDim2.fromOffset(orb, orb)
		hero.Orb.Position = UDim2.new(0, short and 12 or 16, 0.5, -2)
		local x = short and 76 or 96
		hero.Title.Position = UDim2.new(0, x, 0.5, short and -2 or -4)
		hero.Title.Size = UDim2.new(1, -(x + 76), 0, short and 32 or 40)
		hero.Sub.Position = UDim2.new(0, x, 0.5, 0)
		hero.Sub.Size = UDim2.new(1, -(x + 76), 0, 26)
		local spec = P5.HERO[hero.Id]
		hero.Sub.Text = (short or (tonumber(w) or 999) < 640) and spec.Short or spec.Sub
		-- (playtest 2026-11-28 C23 review) the line under the title whole: the card's text box (the window less the
		-- content's and the hero's 12 px sides, the orb column and the badge's 76) takes the first line that fits it by the
		-- measure (a 15 % spare: the Body face drew wider than Theme.Measure), then Tiny; else it truncates as before
		local subRoom = (tonumber(w) or 0) - 48 - (x + 76)
		if subRoom > 0 then
			for _, line in ipairs({ hero.Sub.Text, spec.Tiny }) do
				if line and math.ceil(Theme.MeasureLabel(hero.Sub, line, hero.Sub.TextSize).X * 1.15) <= subRoom then
					hero.Sub.Text = line
					break
				end
				hero.Sub.Text = line or hero.Sub.Text
			end
		end
		hero.Badge.Size = UDim2.fromOffset(short and 44 or 52, short and 44 or 52)
	end
	-- (playtest 2026-11-28 C23) the claim title on ONE line: TextScaled with MinTextSize 24 wrapped 'CLAIM A / HOME' in
	-- its 32 px box at 640-667 px (the second line clipped or spilled over the card); the size steps down to 18 by
	-- the measure (with a 25 % spare: Theme.Measure read 23 % short of the drawn capitals in the renders), then the
	-- short title ("Claim home", 640 px), then truncates. The box:
	-- the window less the content's and the hero's 12 px sides, the orb column and the badge's 76
	local title = H.ClaimHero.Title
	local room = (tonumber(w) or 0) - 48 - ((short and 76 or 96) + 76)
	local function need(text, px)
		return math.ceil(Theme.MeasureLabel(title, text, px).X * 1.25)
	end
	local spec = P5.HERO.ClaimHome
	local text = (room > 0 and need(spec.Title, 18) > room and spec.ShortTitle) or spec.Title
	title.Text = text
	local size = short and 32 or 34
	while room > 0 and size > 18 and need(text, size) > room do
		size = size - 1
	end
	local fit = title:FindFirstChildOfClass("UITextSizeConstraint")
	if fit then
		fit.MinTextSize = 18
	end
	title.TextScaled = false
	title.TextWrapped = false
	title.TextTruncate = Enum.TextTruncate.AtEnd
	title.TextSize = size
	P5.layoutClaimGets(H, w)
	H.ClaimSteps.Position = UDim2.fromOffset(12, h + 22)
	H.ClaimSteps.Size = UDim2.new(1, -24, 1, -(h + 32))
	return h
end

-- (playtest 2026-11-28 C23) the "Your home has" tiles: three across while a tile holds its words (160 px tiles on a
-- PC), else one row each (the chip at the left, the title and its line beside it): at 640-667 px the tiles were 93 px
-- and cut 'Pets roam and play' / 'Pet Garden'
function P5.layoutClaimGets(H, w)
	if not (H.ClaimGetsGrid and H.ClaimGetTiles) then
		return
	end
	-- a tile: the window less the content's and the steps' sides (24 + 40), a third, less the grid's gap
	local tileW = math.floor(((tonumber(w) or 999) - 64) / 3) - 8
	local rows = false
	for _, t in ipairs(H.ClaimGetTiles) do
		for _, pair in ipairs({ { t.Title, 20 }, { t.Text, 18 } }) do
			rows = rows or math.ceil(Theme.MeasureLabel(pair[1], nil, pair[2]).X * 1.15) > tileW - 12
		end
	end
	local n = #H.ClaimGetTiles
	if rows then
		H.ClaimGetsGrid.CellSize = UDim2.new(1, 0, 0, 64)
		H.ClaimGetsGrid.CellPadding = UDim2.new(0, 0, 0, 10)
		H.ClaimGets.Size = UDim2.new(1, 0, 0, n * 64 + (n - 1) * 10)
	else
		H.ClaimGetsGrid.CellSize = UDim2.new(1 / 3, -8, 1, 0)
		H.ClaimGetsGrid.CellPadding = UDim2.new(0, 12, 0, 0)
		H.ClaimGets.Size = UDim2.new(1, 0, 0, 132)
	end
	for _, t in ipairs(H.ClaimGetTiles) do
		t.Chip.AnchorPoint = rows and Vector2.new(0, 0.5) or Vector2.new(0.5, 0)
		t.Chip.Position = rows and UDim2.new(0, 10, 0.5, -2) or UDim2.new(0.5, 0, 0, 10)
		for _, label in ipairs({ t.Title, t.Text }) do
			label.TextXAlignment = rows and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
			label.TextTruncate = Enum.TextTruncate.AtEnd
		end
		t.Title.Position = rows and UDim2.new(0, 70, 0, 6) or UDim2.new(0, 6, 0, 66)
		t.Title.Size = rows and UDim2.new(1, -80, 0, 24) or UDim2.new(1, -12, 0, 24)
		t.Text.Position = rows and UDim2.new(0, 70, 0, 32) or UDim2.new(0, 6, 0, 92)
		t.Text.Size = rows and UDim2.new(1, -80, 0, 24) or UDim2.new(1, -12, 0, 24)
	end
end

local buildHome -- (the window's helpers live in this do-block: Lua's 200-local limit of the main chunk)
do
	local HOME_SECTIONS = {
		{ Id = "Pets", Title = "Pets at home", Kinds = { Garden = true, FoodMachine = true, Training = true, Fusion = true } },
		{ Id = "Money", Title = "Berries & Cloud Cash", Kinds = { Farm = true, Plant = true, Magnet = true, Vault = true } },
		{ Id = "House", Title = "House", Kinds = { House = true, Arena = true } },
		{ Id = "Decor", Title = "Decor", Kinds = { Decor = true } },
	}

	local function shortPercent(fraction)
		local p = (tonumber(fraction) or 0) * 100
		if math.abs(p - math.floor(p + 0.5)) < 0.05 then
			return tostring(math.floor(p + 0.5)) .. "%"
		end
		return string.format("%.1f%%", p)
	end

	local function shortNumber(n)
		n = tonumber(n) or 0
		if math.abs(n - math.floor(n + 0.5)) < 1e-6 then
			return tostring(math.floor(n + 0.5))
		end
		return (string.format("%.2f", n):gsub("0+$", ""):gsub("%.$", ""))
	end

	-- What a station does at `level` (a short phrase), or nil.
	local function effectText(def, level)
		if type(def) ~= "table" or type(def.Effects) ~= "table" or level < 1 then
			return nil
		end
		local e = def.Effects[math.min(level, def.MaxLevel or level)]
		if type(e) ~= "table" then
			return nil
		end
		local kind = def.Kind
		if kind == "Farm" then
			return "+" .. shortNumber(e.Food) .. " food, more berries"
		elseif kind == "Plant" then
			return "+" .. shortNumber(e.Food) .. " food"
		elseif kind == "Magnet" then
			return "Scoop " .. shortNumber(e.Radius) .. " studs, piles " .. shortNumber((tonumber(e.PileSeconds) or 0) / 60) .. " min"
		elseif kind == "Garden" then
			local lucky = tonumber(e.Lucky) or 0
			if lucky <= 0 then
				return "Cloud Cash" -- (playtest 2026-11-28 C20: was "Rainbow coins")
			end
			return shortPercent(lucky) .. " Lucky Cash"
		elseif kind == "FoodMachine" then
			return "Feeds fill " .. shortPercent(e.FeedShare) .. " of a bar"
		elseif kind == "Training" then
			local slots = tonumber(e.Slots) or 0
			return slots .. (slots == 1 and " pet trains" or " pets train") .. " at once"
		elseif kind == "Vault" then
			return "Offline " .. shortPercent(e.OfflinePercent) .. " for " .. tostring(e.OfflineHours or 0) .. "h"
		elseif kind == "House" then
			return tostring(e.Name or e.Tier or "")
		elseif kind == "Fusion" then
			if (tonumber(e.TokenDiscount) or 0) > 0 then
				return "-" .. shortPercent(e.TokenDiscount) .. " fusion cost"
			end
			return "Fuse pets"
		elseif kind == "Arena" then
			return "Pet battles"
		elseif kind == "Decor" then
			return tostring(e.Style or "Decor") .. " style"
		end
		return nil
	end

	-- "Needs Cloud Press 2 Lv 2" for a station whose tree is not met yet (nil when it is)
	local function treeReason(def, home)
		if type(def) ~= "table" or type(def.Requires) ~= "table" then
			return nil
		end
		local keys = {}
		for key in pairs(def.Requires) do
			if key ~= "Prestige" and P2.stationDef(key) and key ~= "House" then
				keys[#keys + 1] = key
			end
		end
		table.sort(keys, function(a, b)
			return (P2.stationDef(a).Order or 0) < (P2.stationDef(b).Order or 0)
		end)
		for _, key in ipairs(keys) do
			local need = tonumber(def.Requires[key]) or 0
			if P2.stationLevelOf(home, key) < need then
				local other = P2.stationDef(key)
				local name = other and other.Name or key
				if need <= 1 then
					return "Needs the " .. name
				end
				return "Needs " .. name .. " Lv " .. need
			end
		end
		return nil
	end

	-- the Garden pets that eat (any role, open places, not training), as a slot -> TycoonCatalog.IncomePerSecond entry
	-- map (only places 1..GardenSlots count)
	local function gardenEntries(home)
		local entries = {}
		local slots = P2.catalogCall("GardenSlots", home) or 0
		local garden = type(home.Garden) == "table" and home.Garden or {}
		for slot = 1, slots do
			local key = garden[slot]
			if type(key) == "string" then
				local def = P2.defOfKey(key)
				if def and State.OwnedCount(key) > 0 and not P2.job(key) then
					entries[slot] = { Def = def, Level = (P2.petLevel(key)), Stage = P2.stage(key), Key = key }
				end
			end
		end
		return entries
	end

	-- cash/s, { Food, Pets, Lucky, Multiplier } computed here (the plot's IncomePerSecond attribute wins when present)
	local function homeIncome(home)
		local total, parts = P2.catalogCall("IncomePerSecond", home, gardenEntries(home))
		if type(total) ~= "number" then
			return 0, { Food = 0, Pets = 0, Lucky = 1, Multiplier = 1 }
		end
		if type(parts) ~= "table" then
			parts = { Food = 0, Pets = 0, Lucky = 1, Multiplier = 1 }
		end
		return total, parts
	end

	-- the local player's plot folder (workspace.NimbusLobby ... Spot_NN, attribute SpotIndex), or nil
	local function plotFolder()
		local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex)
		if type(index) ~= "number" then
			return nil
		end
		local folder = Home.Folder
		if folder and folder.Parent and folder:GetAttribute("SpotIndex") == index then
			return folder
		end
		folder = nil
		local lobby = workspace:FindFirstChild("NimbusLobby")
		if lobby then
			local named = lobby:FindFirstChild(string.format("Spot_%02d", index), true)
			if named and named:GetAttribute("SpotIndex") == index then
				folder = named
			end
		end
		Home.Folder = folder
		return folder
	end

	-- coins waiting on the lawn, income/s, income parts, open garden places: the plot's live attributes (CollectorCash,
	-- IncomePerSecond, GardenSlots), else computed from the synced home
	local function homeLive(home)
		local folder = plotFolder()
		local localIncome, parts = homeIncome(home)
		local income = folder and folder:GetAttribute("IncomePerSecond")
		if type(income) ~= "number" then
			income = localIncome
		end
		local cash = folder and folder:GetAttribute("CollectorCash")
		if type(cash) ~= "number" then
			cash = tonumber(home.CollectorCash) or 0
		end
		local open = folder and folder:GetAttribute("GardenSlots")
		if type(open) ~= "number" then
			open = P2.catalogCall("GardenSlots", home) or 0
		end
		return cash, income, parts, open
	end

	function buildHome(win)
		local content = win.Panel.Content
		local H = { Rows = {}, Sections = {}, Pads = {}, Tall = false, Cards = {} }
		win.HomeUi = H

		-- left: the summary column (scrolls on short screens); right: the station list
		local left = scroller(content, "Summary", {
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.new(0, K.HOME_LEFT_W, 1, -24),
		})
		left.ScrollBarImageColor3 = P5.HS.Wood -- (kit-b U9-1)
		pad(left, 2, 2, 12, 6)
		listLayout(left, Enum.FillDirection.Vertical, 10)
		H.Left = left
		local list = scroller(content, "Stations", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.new(1, -(K.HOME_LEFT_W + 36), 1, -24),
		})
		list.ScrollBarImageColor3 = P5.HS.Wood
		pad(list, 2, 2, 14, 8)
		listLayout(list, Enum.FillDirection.Vertical, 8)
		H.List = list
		-- Phase 5 (3.4): the flow strip on top (fixed, never scrolls): Berry Farm -> pets eat & poop -> Berry Basket ->
		-- Food Machine. It tells the whole home loop in four tiles.
		safe("home strip", P5.buildStrip, H, content)

		------------------------------------------------------------------
		-- summary cards
		------------------------------------------------------------------
		-- (kit-b U9-1) a raised stone block in its wood edge (was a dark inset well)
		local function card(name, order, height)
			local c = P5.signBlock(left, name, {
				Size = UDim2.new(1, 0, 0, height),
				LayoutOrder = order,
			})
			H.Cards[#H.Cards + 1] = c
			return c
		end

		-- house: tier, Home Level, prestige stars (top-right), the next house
		local house = card("HouseCard", 1, 116)
		-- (kit-b U9-1) the house on a square well (the pitch's pet well, its edge), brown ink
		local disc = makeFrame(house, "HouseDisc", {
			Position = UDim2.fromOffset(12, 12),
			Size = UDim2.fromOffset(64, 64),
			BackgroundTransparency = 0,
			BackgroundColor3 = P5.HS.PetWell,
		})
		stroke(disc, P5.HS.WellEdge, 2, 0).LineJoinMode = Enum.LineJoinMode.Miter
		H.HouseGlyph = makeText(disc, "Glyph", "", "Title", 36, P5.HS.Text, { Size = UDim2.new(1, 0, 1, 0) })
		PixelIcon.Set(H.HouseGlyph, HOME_ICON.House, 36) -- (kit-b U7b) the tier's PixelIcon (paintSummary)
		H.HouseName = makeText(house, "Tier", "Cottage", "Title", 30, P5.HS.Text, {
			Position = UDim2.fromOffset(88, 8),
			Size = UDim2.new(1, -170, 0, 36),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 20, Parent = H.HouseName })
		H.Stars = makeText(house, "Stars", "", "Title", 22, P5.HS.Wood, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 12),
			Size = UDim2.fromOffset(78, 28),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		H.HomeLevel = makeText(house, "HomeLevel", "Home Level 0", "Heading", 21, P5.HS.Text, {
			Position = UDim2.fromOffset(88, 46),
			Size = UDim2.new(1, -100, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		H.NextHouse = makeText(house, "NextHouse", "", "Body", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 84),
			Size = UDim2.new(1, -28, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 18, MinTextSize = 18, Parent = H.NextHouse })

		-- income per second (the prestige multiplier as a gold tag beside it)
		local income = card("IncomeCard", 2, 98)
		makeText(income, "Caption", "Income", "Heading", 19, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -28, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		H.Income = makeText(income, "PerSecond", G.Cash .. "0/s", "Display", 36, P5.GOOD, {
			Position = UDim2.fromOffset(14, 30),
			Size = UDim2.new(1, -110, 0, 40),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 36, MinTextSize = 22, Parent = H.Income })
		H.Multiplier = P5.signTag(income, "Multiplier", "x1", 19, 0, "Heading")
		H.Multiplier.AnchorPoint = Vector2.new(1, 0)
		H.Multiplier.Position = UDim2.new(1, -14, 0, 38)
		H.IncomeParts = makeText(income, "Parts", "", "Body", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 70),
			Size = UDim2.new(1, -28, 0, 22),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})

		-- the Pet Garden: coins waiting on the lawn, coins per minute, places, the legacy lines (no Collect: kids walk
		-- over their coins)
		local garden = card("GardenCard", 3, 168)
		PixelIcon.Lead(makeText(garden, "Caption", "Pet Garden", "Heading", 19, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(0.6, -14, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		}), HOME_ICON.Seedling) -- (kit-b U7b)
		H.Places = makeText(garden, "Places", "", "Heading", 18, P5.GOOD, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14, 0, 8),
			Size = UDim2.new(0.45, 0, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		H.CoinsWaiting = makeText(garden, "CoinsWaiting", "", "Display", 28, P5.GOOD, {
			Position = UDim2.fromOffset(14, 34),
			Size = UDim2.new(1, -28, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextScaled = true,
		})
		Util.Create("UITextSizeConstraint", { MaxTextSize = 28, MinTextSize = 20, Parent = H.CoinsWaiting })
		H.CoinsPerMin = makeText(garden, "CoinsPerMinute", "", "Heading", 18, P5.HS.Text, {
			Position = UDim2.fromOffset(14, 70),
			Size = UDim2.new(1, -28, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		H.GardenTip = makeText(garden, "Tip", "", "Body", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 96),
			Size = UDim2.new(1, -28, 0, 64),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})

		-- prestige: stars, Home Level progress, the requirement, the reward, the button
		local prestige = card("PrestigeCard", 4, 204)
		H.PrestigeTitle = makeText(prestige, "Caption", "Prestige", "Heading", 19, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 8),
			Size = UDim2.new(1, -28, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		H.PrestigeBar = CloudUI.Bar({
			Name = "PrestigeBar",
			Position = UDim2.fromOffset(14, 36),
			Size = UDim2.new(1, -28, 0, 30),
			Height = 30,
			TextSize = 20,
			Color = P5.HS.Gold,
			Skin = "Sign", -- (LOOK-ui) a block bar: gold blocks on the gold lip token, the level beside it
			LabelSide = "Right",
			Parent = prestige,
		})
		H.PrestigeNeed = makeText(prestige, "Need", "", "Heading", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 72),
			Size = UDim2.new(1, -28, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		H.PrestigeReward = makeText(prestige, "Reward", "", "Body", 18, P5.HS.TextMuted, {
			Position = UDim2.fromOffset(14, 98),
			Size = UDim2.new(1, -28, 0, 44),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
		})
		-- (kit-b U9-1) a stone plank: Go home is the window's one green action
		H.PrestigeButton = CloudUI.Button({
			Name = "Prestige",
			Text = "Prestige",
			Style = "Blue",
			Skin = "Sign",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -10),
			Size = UDim2.new(1, -28, 0, 50),
			TextSize = 24,
			Callback = function()
				if H.ShowConfirm then
					H.ShowConfirm(true)
				end
			end,
			Parent = prestige,
		})

		-- Phase 6: the big golden Go home hero on top (fixed above the list, always in view); without a home the same
		-- spot offers Claim a home (Remotes.GoToSpot: the home portal toward a free gate) with the three steps
		P5.buildHomeHero(H, win, function()
			if inMatch() then
				showHint("You cannot go home during a match.", "info")
				return
			end
			if fireKeyed("HomeAction:GoHome", "HomeAction", "GoHome") then
				closeWindow("Home")
			end
		end, function()
			if inMatch() then
				showHint("You cannot go home during a match.", "info")
				return
			end
			if fire("GoToSpot") then
				closeWindow("Home")
				showHint(CloudUI.PromptWords(true) .. " at the gate to claim your home!", "info")
			end
		end)

		------------------------------------------------------------------
		-- station rows
		------------------------------------------------------------------
		local function requestUpgrade(row)
			local pad = H.Pads[row.Id]
			if inMatch() then
				showHint("Homes are closed during a match.", "info")
				return
			end
			if not P2.hasHome() then
				showHint("Claim a home first: " .. CloudUI.PromptWords() .. " at a free gate.", "info")
				return
			end
			if not pad then
				return
			end
			if pad.Locked then
				showHint(tostring(pad.Locked), "info")
				return
			end
			local price = tonumber(pad.Price) or 0
			local cash = P2.cashBalance()
			if cash < price then
				showHint("You need " .. P2.formatCash(price - cash) .. " more Cash.", "bad")
				return
			end
			if fireKeyed("HomeAction:Upgrade:" .. row.Id, "HomeAction", "Upgrade", row.Id) then
				row.PendingAt = os.clock()
				row.PendingLevel = P2.stationLevelOf(P2.homeData(), row.Id)
				if H.Refresh then
					H.Refresh()
				end
			end
		end

		local function buildRow(def, parent, order)
			local color = C2.Kind[def.Kind] or BUTTONS.Blue
			local row = { Id = def.Id, Def = def, Pips = {} }
			-- (kit-b U9-1) a stone block whose lip and icon square carry the station's kind colour (colour by role)
			local frame = P5.signBlock(parent, "Station_" .. def.Id, {
				Size = UDim2.new(1, 0, 0, K.STATION_ROW_H),
				LayoutOrder = order,
			}, color)
			row.Frame = frame
			row.Disc = makeFrame(frame, "Icon", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 12, 0.5, 0),
				Size = UDim2.fromOffset(64, 64),
				BackgroundTransparency = 0,
				BackgroundColor3 = color,
			})
			stroke(row.Disc, P5.HS.Wood, 2, 0).LineJoinMode = Enum.LineJoinMode.Miter
			-- (kit-b U7b) the station's PixelIcon (its TycoonCatalog Icon), the house for one that names none; U9-1: in the
			-- ink that reads on the kind colour
			PixelIcon.Host(makeText(row.Disc, "Glyph", "", "Title", 34, Theme.TextOn(color), { Size = UDim2.new(1, 0, 1, 0) }), PixelIcon.Bitmaps[def.Icon] and def.Icon or HOME_ICON.House, 36)
			row.Name = makeText(frame, "Name", def.Name, "Title", 24, P5.HS.Text, {
				Position = UDim2.fromOffset(88, 6),
				Size = UDim2.new(1, -360, 0, 30),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextScaled = true,
			})
			Util.Create("UITextSizeConstraint", { MaxTextSize = 24, MinTextSize = 18, Parent = row.Name })
			row.Level = makeText(frame, "Level", "Lv 0/" .. tostring(def.MaxLevel), "Heading", 19, P5.HS.TextMuted, {
				Position = UDim2.fromOffset(88, 38),
				Size = UDim2.fromOffset(96, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			row.PipRow = makeFrame(frame, "Pips", {
				Position = UDim2.fromOffset(186, 42),
				Size = UDim2.fromOffset(170, 16),
			})
			-- (kit-b U9-1) a pip per level; (LOOK-ui, kitb-look1: every bar in the block-bar language) as kit blocks (a
			-- SignKit.BlockRow: wood edge, face, lip), painted by paintRow: built in the kind's colour, the next level the
			-- Selected gold, open levels the well, the levels behind the house's cap the stone
			local blocks = SignKit.BlockRow(row.PipRow, {
				Count = math.min(def.MaxLevel or 1, 10), BlockW = 14, BlockH = 14, Gap = 3, EdgePx = 2, LipPx = 3,
				Fill = color, FillLip = C2.KindLip[def.Kind] or Theme.Darken(color, 0.25),
				Position = UDim2.fromOffset(0, 1),
			})
			for i = 1, blocks:GetAttribute("Count") do
				local block = blocks:FindFirstChild("Block" .. i)
				row.Pips[i] = block and block:FindFirstChild("Face")
			end
			row.Info = makeText(frame, "Info", "", "Body", 18, P5.HS.TextMuted, {
				Position = UDim2.fromOffset(88, 64),
				Size = UDim2.new(1, -360, 0, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			-- right block: price + button, a lock reason, or MAX
			row.Right = makeFrame(frame, "Action", {
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -12, 0.5, 0),
				Size = UDim2.fromOffset(330, 76),
			})
			row.Price = makeText(row.Right, "Price", "", "Display", 26, P5.HS.Text, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 0, 0.5, 0),
				Size = UDim2.fromOffset(150, 32),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextScaled = true,
			})
			Util.Create("UITextSizeConstraint", { MaxTextSize = 26, MinTextSize = 18, Parent = row.Price })
			-- (kit-b U9-1) a stone plank (Build and Upgrade alike): Go home is the window's one green action; the gold NEXT
			-- tag marks the pads worth building next
			row.Button = CloudUI.Button({
				Name = "Upgrade",
				Text = "Upgrade",
				Style = "Blue",
				Skin = "Sign",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(164, 54),
				TextSize = 22,
				Callback = function()
					requestUpgrade(row)
				end,
				Parent = row.Right,
			})
			row.Lock = makeText(row.Right, "Locked", "", "Heading", 18, P5.HS.TextMuted, {
				Size = UDim2.new(1, 0, 1, 0),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Right,
				Visible = false,
			})
			row.Max = P5.signTag(row.Right, "Max", "MAX", 20, 1)
			row.Max.AnchorPoint = Vector2.new(1, 0.5)
			row.Max.Position = UDim2.new(1, 0, 0.5, 0)
			row.Max.Visible = false
			H.Rows[def.Id] = row
			return row
		end

		local order = 0
		local stations = TycoonCatalog and TycoonCatalog.Stations or {}
		for _, section in ipairs(HOME_SECTIONS) do
			order = order + 1
			local header = makeFrame(list, "Section_" .. section.Id, {
				Size = UDim2.new(1, 0, 0, 34),
				LayoutOrder = order,
			})
			Theme.StyleTitle(makeText(header, "Title", section.Title, "Title", 24, P5.HS.Text, {
				Position = UDim2.fromOffset(6, 0),
				Size = UDim2.new(1, -12, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
			}), "Section")
			H.Sections[#H.Sections + 1] = header
			for _, def in ipairs(stations) do
				if type(def) == "table" and section.Kinds[def.Kind] then
					order = order + 1
					buildRow(def, list, order)
				end
			end
		end
		if not TycoonCatalog then
			H.Missing = makeText(list, "Missing", "Your home is getting ready. Try again in a moment!", "Body", 20, P5.HS.TextMuted, {
				Size = UDim2.new(1, 0, 0, 60),
				TextWrapped = true,
				LayoutOrder = 1,
			})
		end

		------------------------------------------------------------------
		-- prestige confirmation (resets stations and Cash)
		------------------------------------------------------------------
		-- (kit-b U9-1) a small kit B sign over a navy shade: the stone body in a 6 px wood frame and its lip, a plain Section
		-- title (the owner's ruling 2026-11-14: the ribbon is for window titles), the lines on raised stone, Prestige! the
		-- dialog's one green plank and Not yet a stone one
		local confirm = makeFrame(content, "PrestigeConfirm", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 0.35,
			BackgroundColor3 = P5.HS.Navy,
			Visible = false,
			ZIndex = 30,
		})
		local box = makeFrame(confirm, "Box", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			Size = UDim2.fromOffset(K.CONFIRM_W, K.CONFIRM_H),
			ZIndex = 31,
		})
		CloudUI.SignBlock(box, "Stone", { Face = P5.HS.Stone, Edge = P5.HS.Wood, EdgePx = 6, Pad = false })
		H.ConfirmBox = box
		H.ConfirmTitle = Theme.StyleTitle(makeText(box, "Title", "Prestige now?", "Title", 32, P5.HS.Text, {
			Position = UDim2.fromOffset(16, 12),
			Size = UDim2.new(1, -32, 0, 40),
			ZIndex = 32,
		}), "Section") -- (kit-b prep) a dialog's title: the ribbon is for window titles only
		-- three lines: what starts over, what stays, what the new star gives
		-- (kit-b U9-1) the lines scroll when a phone's window is too short for them (H.FitConfirm sizes them to their text)
		local lines = scroller(box, "Lines", {
			Position = UDim2.fromOffset(16, 62),
			Size = UDim2.new(1, -32, 0, 3 * 62 + 2 * 8),
			ZIndex = 32,
		})
		lines.ScrollBarImageColor3 = P5.HS.Wood
		listLayout(lines, Enum.FillDirection.Vertical, 8)
		H.ConfirmLines = {}
		H.ConfirmRows = {}
		H.ConfirmList = lines
		for i, spec in ipairs({
			{ "Reset", "Starts over", P5.HS.RedLip },
			{ "Keep", "You keep", P5.GOOD },
			{ "Gain", "You get", P5.HS.Wood },
		}) do
			-- (kit-b U9-1 review) a line and its text are sized by H.FitConfirm from the text's real bounds, so the box and
			-- its list know every line's height (an AutomaticSize line grew behind their backs and was cut by the list)
			local line = P5.signBlock(lines, "Line_" .. spec[1], { Size = UDim2.new(1, 0, 0, 62), LayoutOrder = i, ZIndex = 32 })
			H.ConfirmRows[#H.ConfirmRows + 1] = line
			makeText(line, "Label", spec[2], "Heading", 19, spec[3], {
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(0, 116, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 33,
			})
			H.ConfirmLines[spec[1]] = makeText(line, "Text", "", "Body", 19, P5.HS.Text, {
				Position = UDim2.fromOffset(132, 0),
				Size = UDim2.new(1, -144, 0, 56),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = 33,
			})
		end
		local buttons = makeFrame(box, "Buttons", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -32, 0, 56),
			ZIndex = 32,
		})
		listLayout(buttons, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
		H.ConfirmButtons = buttons
		local yes = CloudUI.Button({
			Name = "ConfirmPrestige",
			Text = "Prestige!",
			Style = "Green",
			Skin = "Sign",
			Size = UDim2.fromOffset(220, 56),
			TextSize = 25,
			LayoutOrder = 1,
			ZIndex = 33,
			Callback = function()
				H.ShowConfirm(false)
				if inMatch() then
					showHint("Finish your match first.", "info")
					return
				end
				fireKeyed("HomeAction:Prestige", "HomeAction", "Prestige")
			end,
			Parent = buttons,
		})
		yes.ZIndex = 33
		H.ConfirmYes = yes
		local no = CloudUI.Button({
			Name = "CancelPrestige",
			Text = "Not yet",
			Style = "Blue",
			Skin = "Sign",
			Size = UDim2.fromOffset(170, 56),
			TextSize = 23,
			LayoutOrder = 2,
			ZIndex = 33,
			Callback = function()
				H.ShowConfirm(false)
			end,
			Parent = buttons,
		})
		no.ZIndex = 33
		H.ConfirmNo = no

		function H.ShowConfirm(on)
			if on then
				local home = P2.homeData()
				local ok = P2.catalogCall("CanPrestige", home)
				if not ok then
					showHint("Not ready to prestige yet.", "info")
					return
				end
				local stars = math.floor(tonumber(home.Prestige) or 0)
				local P = TycoonCatalog and TycoonCatalog.Prestige or {}
				local gems = P2.catalogCall("PrestigeGems", stars + 1) or P.GemReward or 0
				local mult = P2.catalogCall("PrestigeMultiplier", stars + 1) or ((P.IncomeMultiplier or 1.25) ^ (stars + 1))
				local words = H.ShortConfirm and P5.PRESTIGE_TEXT.Short or P5.PRESTIGE_TEXT
				H.ConfirmLines.Reset.Text = words.Reset
				H.ConfirmLines.Keep.Text = words.Keep
				local places = math.min(tonumber(P.GardenSlotsMax) or 12, (tonumber(P.GardenSlotsBase) or 3) + (tonumber(P.GardenSlotsPerStar) or 1) * (stars + 1))
				local gain = "Star " .. (stars + 1) .. ": x" .. shortNumber(math.floor(mult * 100 + 0.5) / 100) .. " Cash, garden place " .. places .. " and " .. commas(gems) .. " Gems"
				if stars + 1 == (tonumber(P.FusionUnlock) or 1) then
					gain = gain .. ", the Fusion Machine"
				end
				H.ConfirmLines.Gain.Text = gain
			end
			confirm.Visible = on == true
			if on then
				H.ConfirmRead = false -- (playtest 2026-11-28 C35) read from the top again
				H.ConfirmList.CanvasPosition = Vector2.new(0, 0)
				H.FitConfirm()
			end
		end

		-- (playtest 2026-11-28 C35) a list that scrolls keeps Prestige! off ('Read all') until the player has scrolled to
		-- its end: on landscape phones 'You keep' / 'You get' sat below the fold beside a live Prestige!
		-- (playtest 2026-11-28 C35 review) whether the list scrolls and where its end is, from the frame's own numbers
		-- (AbsoluteCanvasSize - AbsoluteWindowSize is the engine's reachable end; FitConfirm's sum only where the engine
		-- has none): an end computed a few px past the reachable one never unlocked Prestige!
		function H.ConfirmScroll()
			local ok, canvas, window = pcall(function()
				return lines.AbsoluteCanvasSize.Y, lines.AbsoluteWindowSize.Y
			end)
			if ok and type(canvas) == "number" and type(window) == "number" and window > 0 then
				return canvas - window > 1, canvas - window
			end
			return H.ConfirmEndY ~= nil, H.ConfirmEndY or 0
		end
		function H.PaintConfirmYes()
			local wait = H.ConfirmScroll() and not H.ConfirmRead
			H.ConfirmYes:SetAttribute("Disabled", wait)
			H.ConfirmYes.Text = wait and "Read all" or "Prestige!"
		end
		-- only a scroll to the end reads the list (a fit never does: a first fit that did not scroll left Prestige! live
		-- once the real text arrived and scrolled)
		lines:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
			local scrolls, endY = H.ConfirmScroll()
			if scrolls and not H.ConfirmRead and lines.CanvasPosition.Y >= endY - 2 then
				H.ConfirmRead = true
				H.PaintConfirmYes()
			end
		end)
		for _, prop in ipairs({ "AbsoluteCanvasSize", "AbsoluteWindowSize" }) do
			pcall(function()
				lines:GetPropertyChangedSignal(prop):Connect(function()
					if confirm.Visible then
						H.PaintConfirmYes()
					end
				end)
			end)
		end

		-- (kit-b U9-1 review) each line as tall as the text it really shows (its TextBounds at the column's width: the first
		-- star's "You get" names the Fusion Machine too, longer than any estimate from the sample words), the list as tall
		-- as the three lines and the box as tall as that or the room H.Layout found; the list scrolls only past that room.
		-- A text with no bounds yet (a hidden dialog, before its first layout) is estimated from its words.
		function H.FitConfirm()
			local fit = H.ConfirmFit
			if not fit then
				return
			end
			-- TextBounds is screen px; the sizes below are the box's own px (the window's UIScales sit above it)
			local scale, cur = 1, box
			while cur and not cur:IsA("LayerCollector") do
				local ui = cur:IsA("GuiObject") and cur:FindFirstChildOfClass("UIScale")
				if ui and ui.Scale > 0 then
					scale = scale * ui.Scale
				end
				cur = cur.Parent
			end
			local words = fit.Short and P5.PRESTIGE_TEXT.Short or P5.PRESTIGE_TEXT
			local content = 2 * 8
			local heights = {}
			for _, id in ipairs({ "Reset", "Keep", "Gain" }) do
				local text = H.ConfirmLines[id]
				local okB, bounds = pcall(function()
					return text.TextBounds
				end)
				local textH
				if text.Text ~= "" and okB and bounds and bounds.Y > 0 then
					textH = math.ceil(bounds.Y / scale)
				else
					local said = text.Text ~= "" and text.Text or words[id]
					textH = math.ceil(Theme.Measure(said, "Body", 19).X * 1.1 / fit.Column) * 23 -- (word wrap leaves a ragged edge)
				end
				local lineH = math.max(fit.Short and 50 or 62, textH + (fit.Short and 6 or 14))
				text.Parent.Size = UDim2.new(1, -12, 0, lineH)
				text.Size = UDim2.new(1, -144, 0, lineH - 6) -- the lip's room below
				content = content + lineH
				heights[#heights + 1] = lineH
			end
			local listH = math.min(content, fit.Room - fit.Top - fit.Foot)
			if listH < content then
				-- (playtest 2026-11-28 C35) a list that scrolls stops at a whole line (it sliced a line mid-text)
				local whole = 0
				for i, lineH in ipairs(heights) do
					local next = whole + lineH + (i > 1 and 8 or 0)
					if next > listH then
						break
					end
					whole = next
				end
				listH = whole > 0 and whole or listH
			end
			H.ConfirmEndY = listH < content and math.max(0, (content - listH) * scale) or nil
			H.ConfirmList.Size = UDim2.new(1, -32, 0, listH)
			box.Size = UDim2.fromOffset(fit.BoxW, fit.Top + listH + fit.Foot)
			H.PaintConfirmYes()
		end
		-- a text whose bounds arrive or change after the fit (Roblox lays text out on its next frame) fits again
		for _, text in pairs(H.ConfirmLines) do
			text:GetPropertyChangedSignal("TextBounds"):Connect(function()
				if confirm.Visible then
					H.FitConfirm()
				end
			end)
		end

		------------------------------------------------------------------
		-- refresh
		------------------------------------------------------------------
		local function paintRow(row, home, cash)
			local def = row.Def
			local level = P2.stationLevelOf(home, def.Id)
			local maxLevel = def.MaxLevel or 1
			local cap = P2.catalogCall("MaxLevelAt", def.Id, home) or maxLevel
			local pad = H.Pads[def.Id]
			local color = C2.Kind[def.Kind] or BUTTONS.Blue
			if row.PendingAt and (level ~= row.PendingLevel or os.clock() - row.PendingAt > 3) then
				row.PendingAt = nil
			end
			-- name (the House shows its tier)
			if def.Kind == "House" then
				local tier = level >= 1 and P2.catalogCall("HouseTier", level) or nil
				row.Name.Text = "House: " .. ((tier and tier.Name) or "not built")
			end
			row.Level.Text = "Lv " .. level .. "/" .. maxLevel
			row.Level.TextColor3 = level >= maxLevel and P5.HS.Text or P5.HS.TextMuted
			-- (kit-b U9-1) built = the kind colour, open now = a light well, behind the house's cap = the darker stone;
			-- (LOOK-ui) each pip a kit block: its face and its lip, the next level to buy the Selected gold
			local kindLip = C2.KindLip[def.Kind] or Theme.Darken(color, 0.25)
			for i, face in ipairs(row.Pips) do
				local lip = face:FindFirstChild("Lip")
				local f, l
				if i <= level then
					f, l = color, kindLip
				elseif i == level + 1 and i <= cap then
					f, l = Theme.Sign.Selected, Theme.Sign.GoldLip
				elseif i <= cap then
					f, l = P5.HS.Well, P5.HS.WellEdge
				else
					f, l = P5.HS.StoneLip, Theme.Darken(P5.HS.StoneLip, 0.12)
				end
				face.BackgroundColor3 = f
				if lip then
					lip.BackgroundColor3 = l
				end
			end
			-- what it does now -> next
			local now = effectText(def, level)
			local nextText = level < maxLevel and effectText(def, level + 1) or nil
			local info
			if level < 1 then
				info = nextText and ("Build: " .. nextText) or (def.Blurb or "")
			elseif nextText and nextText ~= now and now then
				-- "+10% press Cash -> +20% press Cash" reads as "+10% -> +20% press Cash"; when both halves do not fit
				-- the row, only the next level is shown ("Next: 6 dishes, x1.5 speed")
				local a1, aRest = now:match("^(%S+)(%s.+)$")
				local b1, bRest = nextText:match("^(%S+)(%s.+)$")
				if a1 and b1 and aRest == bRest then
					info = a1 .. " -> " .. b1 .. aRest
				else
					info = now .. " -> " .. nextText
				end
				if #info > K.INFO_CHARS then
					info = "Next: " .. nextText
				end
			else
				info = now or (def.Blurb or "")
			end
			row.Info.Text = info
			row.Info.TextColor3 = P5.HS.TextMuted
			-- right block
			local lock = nil
			if level >= maxLevel then
				row.Max.Visible = true
				row.Button.Visible = false
				row.Price.Visible = false
				row.Lock.Visible = false
				return
			end
			row.Max.Visible = false
			if pad then
				lock = pad.Locked
			else
				lock = treeReason(def, home) or "Not unlocked yet"
			end
			if lock then
				row.Button.Visible = false
				row.Price.Visible = false
				row.Lock.Visible = true
				row.Lock.Text = tostring(lock)
				PixelIcon.Mark(row.Lock, HOME_ICON.Lock) -- (kit-b U7b)
				return
			end
			row.Lock.Visible = false
			row.Button.Visible = true
			row.Price.Visible = true
			local price = tonumber(pad.Price) or 0
			row.Price.Text = price > 0 and P2.formatCash(price) or "FREE"
			local short = price > cash
			row.Price.TextColor3 = short and P5.HS.RedLip or P5.HS.Text
			local pending = row.PendingAt ~= nil
			row.Button.Text = pending and "..." or (level < 1 and "Build" or "Upgrade")
			CloudUI.SetDisabled(row.Button, short or pending or inMatch() or not P2.hasHome())
		end

		local function paintSummary(home)
			local tierIndex, tier = P2.catalogCall("HouseTierOf", home)
			local houseLevel = P2.stationLevelOf(home, "House")
			local tiers = TycoonCatalog and TycoonCatalog.HouseTiers or {}
			local homeLevel = P2.catalogCall("HomeLevelOf", home) or tonumber(home.Level) or 0
			local stars = math.floor(tonumber(home.Prestige) or 0)
			if houseLevel < 1 then
				H.HouseName.Text = "Empty yard"
			else
				H.HouseName.Text = (type(tier) == "table" and tier.Name) or "Cottage"
			end
			local houseIcon = type(tier) == "table" and tier.Icon or nil
			PixelIcon.Set(H.HouseGlyph, PixelIcon.Bitmaps[houseIcon] and houseIcon or HOME_ICON.House, 36)
			H.HomeLevel.Text = "Home Level " .. homeLevel
			-- prestige stars in the corner (none before the first prestige)
			H.Stars.Visible = stars > 0
			-- (kit-b U7b) PixelIcon stars: one per prestige up to three, then one star and "x7"
			H.Stars.Text = stars <= 3 and "" or ("x" .. stars)
			if stars > 0 then
				local shown = stars <= 3 and stars or 1
				PixelIcon.Mark(H.Stars, HOME_ICON.Star, { Count = shown, Of = shown, Colour = P5.HS.GoldDeep })
			end
			local nextTier = tiers[(houseLevel >= 1 and (tierIndex or 1) or 0) + 1]
			H.NextHouse.TextColor3 = P5.HS.TextMuted
			if houseLevel < 1 then
				H.NextHouse.Text = "Build your Cottage on the House pad"
			elseif type(nextTier) == "table" then
				local at = tonumber(nextTier.HomeLevel) or 0
				if homeLevel >= at then
					H.NextHouse.Text = "Upgrade the House to a " .. tostring(nextTier.Name) .. "!"
					H.NextHouse.TextColor3 = P5.GOOD
				else
					H.NextHouse.Text = "Next: " .. tostring(nextTier.Name) .. " at Home Level " .. at
				end
			else
				H.NextHouse.Text = "Your " .. ((type(tier) == "table" and tier.Name) or "house") .. " is complete!"
			end
			-- (playtest 2026-11-28 C58) a tip to act on leads with an up arrow; the done-check read as 'already done'
			PixelIcon.Mark(H.NextHouse, H.NextHouse.Text:sub(1, 7) == "Upgrade" and HOME_ICON.Up or nil) -- (kit-b U7b)
			-- prestige
			local P = TycoonCatalog and TycoonCatalog.Prestige or {}
			local need = tonumber(P.HomeLevel) or 40
			H.PrestigeTitle.Text = "Prestige  " .. stars .. "  ->  " .. (stars + 1) .. ((stars + 1 == 1) and " star" or " stars")
			H.PrestigeBar.SetFraction(need > 0 and math.min(1, homeLevel / need) or 0)
			H.PrestigeBar.SetText("Home Level " .. math.min(homeLevel, need) .. "/" .. need)
			local ok, reason = P2.catalogCall("CanPrestige", home)
			if ok then
				H.PrestigeNeed.Text = "Ready to prestige!"
				PixelIcon.Mark(H.PrestigeNeed, HOME_ICON.Check) -- (kit-b U7b)
				H.PrestigeNeed.TextColor3 = P5.GOOD
			else
				H.PrestigeNeed.Text = tostring(reason or "Not ready yet")
				PixelIcon.Mark(H.PrestigeNeed, HOME_ICON.Lock)
				H.PrestigeNeed.TextColor3 = P5.HS.TextMuted
			end
			local gems = P2.catalogCall("PrestigeGems", stars + 1) or P.GemReward or 0
			local reward = "Reward: x" .. shortNumber(P.IncomeMultiplier or 1.25) .. " Cash forever, +1 garden place, " .. commas(gems) .. " Gems"
			if stars + 1 == (tonumber(P.FusionUnlock) or 1) then
				reward = reward .. " + the Fusion Machine"
			end
			H.PrestigeReward.Text = reward
			CloudUI.SetDisabled(H.PrestigeButton, not ok or inMatch() or not P2.hasHome())
			P5.paintHomeHero(H, P2.hasHome(), inMatch())
		end

		H.PlotFolder = plotFolder
		function H.Live()
			local home = P2.homeData()
			local waiting, income, parts, open = homeLive(home)
			P5.paintStrip(H, home, income, open)
			H.Income.Text = P2.formatRate(income) .. "/s"
			local bits = {}
			local mult = 1
			if type(parts) == "table" then
				mult = tonumber(parts.Multiplier) or 1
				local food = tonumber(parts.Food) or 0
				if food > 0 then
					bits[#bits + 1] = "Food " .. shortNumber(food)
				end
				local lucky = tonumber(parts.Lucky) or 1
				if lucky > 1.0001 then
					bits[#bits + 1] = "Lucky +" .. shortPercent(lucky - 1)
				end
			end
			if P2.stationLevelOf(home, "Garden") >= 1 then
				local Pp = TycoonCatalog and TycoonCatalog.Prestige or {}
				bits[#bits + 1] = "Garden " .. math.floor(tonumber(open) or 0) .. "/" .. (tonumber(Pp.GardenSlotsMax) or 12) .. " places"
			end
			if #bits == 0 then
				bits[1] = "Put pets in your Garden to earn Cloud Cash"
			end
			H.IncomeParts.Text = table.concat(bits, "  " .. G.Bullet .. "  ")
			-- the prestige multiplier tag (stars x1.25 each)
			H.Multiplier.Visible = mult > 1.0001
			H.Multiplier.Text = "x" .. shortNumber(math.floor(mult * 100 + 0.5) / 100)
			-- the Garden card
			waiting = math.max(0, math.floor(tonumber(waiting) or 0))
			local built = P2.stationLevelOf(home, "Garden") >= 1
			local P = TycoonCatalog and TycoonCatalog.Prestige or {}
			local maxPlaces = tonumber(P.GardenSlotsMax) or 12
			H.CoinsWaiting.Text = P2.formatCash(waiting) .. " waiting"
			H.CoinsWaiting.TextColor3 = waiting > 0 and P5.GOOD or P5.HS.TextMuted
			H.CoinsPerMin.Text = "Cash " .. P2.formatCash(math.floor(income * 60 + 0.5)) .. "/min"
			H.Places.Text = built and ("Places " .. math.floor(open) .. "/" .. maxPlaces) or "Not built"
			local tips = {}
			local legacySlots = tonumber(home.LegacySlots)
			local kept = legacySlots and legacySlots > (tonumber(P.GardenSlotsBase) or 3) + math.floor(tonumber(home.Prestige) or 0)
			if not built then
				tips[1] = "Build your free Pet Garden: pets eat there and pop out Cloud Cash." -- (playtest 2026-11-28 C20)
			elseif kept or home.LegacyPrices == true then
				tips[1] = "Walk over your Cloud Cash to scoop it!"
				if kept and home.LegacyPrices == true then
					tips[2] = "Kept from your old home: " .. math.floor(legacySlots) .. " places and old prices until your next Prestige."
				elseif kept then
					tips[2] = "Kept from your old garden: " .. math.floor(legacySlots) .. " places until your next Prestige."
				else
					tips[2] = "Old prices until your next Prestige."
				end
			else
				tips[1] = "Walk over your Cloud Cash to scoop it! " .. tostring(P.GardenSlotsBase or 3) .. " places + 1 per prestige."
			end
			H.GardenTip.Text = table.concat(tips, " ")
		end

		function H.Refresh()
			local home = P2.homeData()
			local cash = P2.cashBalance()
			H.Pads = {}
			local padList = P2.catalogCall("AvailablePads", home) or {}
			for _, padInfo in ipairs(padList) do
				if type(padInfo) == "table" and type(padInfo.StationId) == "string" then
					H.Pads[padInfo.StationId] = padInfo
				end
			end
			-- Phase 5: the (at most 3) pads TycoonCatalog.SignedPads picks carry a "Next" tag, like their world signs
			local signed = P2.catalogCall("SignedPads", padList, cash)
			signed = type(signed) == "table" and signed or {}
			for _, row in pairs(H.Rows) do
				paintRow(row, home, cash)
				local show = signed[row.Id] == true and row.Button.Visible
				if show and not row.NextTag then
					row.NextTag = P5.signTag(row.Frame, "NextTag", "Next", 18, 0)
					row.NextTag.AnchorPoint = Vector2.new(1, 0)
					row.NextTag.Position = UDim2.new(1, -10, 0, 6)
					row.NextTag.ZIndex = 6
				end
				if row.NextTag then
					row.NextTag.Visible = show
				end
			end
			paintSummary(home)
			H.Live()
		end

		-- Phase 5: ONE scrolling column under the flow strip (summary first, the prestige card last), every size
		function H.Layout(w, _h, narrow, short, _tall)
			local tall = true
			local leftW = narrow and K.HOME_LEFT_W_NARROW or K.HOME_LEFT_W
			if tall ~= H.Tall then
				H.Tall = tall
				for i, c in ipairs(H.Cards) do
					c.Parent = tall and list or left
					c.LayoutOrder = tall and (i - 100) or i
				end
			end
			left.Visible = not tall
			-- Phase 6: the Go home hero sits on top; the list starts under it
			local heroH = P5.layoutHomeHero(H, short, w)
			local top = heroH > 0 and (heroH + 22) or 0
			if tall then
				local stripH = P5.layoutStrip(H, w)
				list.Position = UDim2.new(1, -10, 0, stripH + top + 6)
				list.Size = UDim2.new(1, -20, 1, -(stripH + top + 16))
				for i, c in ipairs(H.Cards) do
					-- the house + income cards first, the prestige card after the stations; the old garden card is gone
					-- (Phase 5: coins roam the yard; its places live in the income card)
					c.LayoutOrder = (c.Name == "PrestigeCard") and 1000 or (i - 100)
					c.Visible = c.Name ~= "GardenCard"
				end
			else
				left.Size = UDim2.new(0, leftW, 1, -24)
				list.Position = UDim2.new(1, -12, 0, 12)
				list.Size = UDim2.new(1, -(leftW + 36), 1, -24)
			end
			-- a list column too slim for one-line rows (landscape phones and small windows) stacks the rows like portrait
			local listW = tall and (w - 44) or (w - (leftW + 36) - 24)
			local stacked = listW < 640
			H.Stacked = stacked
			local rowH = stacked and K.STATION_ROW_H_TALL or K.STATION_ROW_H
			for _, row in pairs(H.Rows) do
				row.Frame.Size = UDim2.new(1, 0, 0, rowH)
				if stacked then
					row.Disc.AnchorPoint = Vector2.new(0, 0)
					row.Disc.Position = UDim2.fromOffset(10, 10)
					row.Disc.Size = UDim2.fromOffset(56, 56)
					row.Name.Position = UDim2.fromOffset(78, 6)
					row.Name.Size = UDim2.new(1, -88, 0, 30)
					row.Level.Position = UDim2.fromOffset(78, 38)
					row.PipRow.Position = UDim2.fromOffset(176, 42)
					row.Info.Position = UDim2.fromOffset(78, 62)
					row.Info.Size = UDim2.new(1, -88, 0, 24)
					row.Right.AnchorPoint = Vector2.new(1, 1)
					row.Right.Position = UDim2.new(1, -10, 1, -6)
					row.Right.Size = UDim2.new(1, -88, 0, 40)
					row.Button.Size = UDim2.fromOffset(150, 40)
					row.Price.Size = UDim2.new(1, -160, 1, 0)
				else
					row.Disc.AnchorPoint = Vector2.new(0, 0.5)
					row.Disc.Position = UDim2.new(0, 12, 0.5, 0)
					row.Disc.Size = UDim2.fromOffset(64, 64)
					row.Name.Position = UDim2.fromOffset(88, 6)
					row.Name.Size = UDim2.new(1, -(88 + (narrow and 300 or 340)), 0, 30)
					row.Level.Position = UDim2.fromOffset(88, 38)
					row.PipRow.Position = UDim2.fromOffset(186, 42)
					row.Info.Position = UDim2.fromOffset(88, 64)
					row.Info.Size = UDim2.new(1, -(88 + (narrow and 300 or 340)), 0, 24)
					row.Right.AnchorPoint = Vector2.new(1, 0.5)
					row.Right.Position = UDim2.new(1, -12, 0.5, 0)
					row.Right.Size = UDim2.fromOffset(narrow and 290 or 330, 76)
					row.Button.Size = UDim2.fromOffset(narrow and 140 or 164, 54)
					row.Price.Size = UDim2.new(1, -((narrow and 140 or 164) + 12), 0, 32)
				end
			end
			-- (kit-b U9-1) the box as wide as the window allows; H.FitConfirm makes each line as tall as its text and the box
			-- as tall as those lines or the window allows, its list scrolling past that
			local boxW = math.min(K.CONFIRM_W, w - 40)
			H.ShortConfirm = short == true
			-- a short window gets a tighter title and buttons, so its list keeps the room for its three lines
			local top = short and 50 or 62
			local buttonH = short and 48 or 56
			local foot = buttonH + (short and 22 or 30)
			H.ConfirmTitle.Position = UDim2.fromOffset(16, short and 6 or 12)
			H.ConfirmButtons.Size = UDim2.new(1, -32, 0, buttonH)
			H.ConfirmButtons.Position = UDim2.new(0.5, 0, 1, short and -10 or -14)
			-- (kit-b U9-1 review) the two buttons share their row (the box less its 16 px margins), so a phone's narrow box
			-- never pushes them onto the wood frame; a wide one keeps 220 and 170
			local rowW = boxW - 32
			local yesW = math.min(220, math.floor((rowW - 14) * 0.56))
			H.ConfirmYes.Size = UDim2.fromOffset(yesW, buttonH)
			H.ConfirmNo.Size = UDim2.fromOffset(math.min(170, rowW - 14 - yesW), buttonH)
			H.ConfirmFit = {
				BoxW = boxW,
				Column = math.max(80, boxW - 32 - 12 - 144),
				Short = short == true,
				Top = top,
				Foot = foot,
				Room = math.max(240, (tonumber(_h) or 900) - CloudUI.ContentInset(true) - 12 - 16),
			}
			H.ConfirmList.Position = UDim2.fromOffset(16, top)
			H.FitConfirm()
		end

		win.Refresh = H.Refresh
		win.OnLayout = function(w, h, narrow, short, tall)
			H.Layout(w, h, narrow, short, tall)
		end
		win.OnOpen = function()
			H.ShowConfirm(false)
			P5.paintHomeHero(H, P2.hasHome(), inMatch())
			Home.Folder = nil
			for _, conn in ipairs(Home.Conns) do
				conn:Disconnect()
			end
			Home.Conns = {}
			local folder = plotFolder()
			if folder then
				Home.Conns[#Home.Conns + 1] = folder.AttributeChanged:Connect(function(name)
					if name == "CollectorCash" or name == "GardenSlots" or name == "IncomePerSecond" or name == "HomeLevel" or name == "Prestige" or name == "BerryCap" then
						refreshHomeLive()
					end
				end)
			end
		end
		win.OnClose = function()
			H.ShowConfirm(false)
			for _, conn in ipairs(Home.Conns) do
				conn:Disconnect()
			end
			Home.Conns = {}
		end
	end

	-- Live numbers of the open Home window (the Collector fills every second): at most every K.LIVE_GAP seconds.
	function refreshHomeLive()
		local win = windows.Home
		local H = win and win.HomeUi
		if not H or not win.Shown then
			return
		end
		local now = os.clock()
		if now - Home.LiveAt < K.LIVE_GAP then
			if not Home.LivePending then
				Home.LivePending = true
				task.delay(K.LIVE_GAP, function()
					Home.LivePending = false
					refreshHomeLive()
				end)
			end
			return
		end
		Home.LiveAt = now
		safe("home live", H.Live)
	end
end

----------------------------------------------------------------------
-- Wiring
----------------------------------------------------------------------
-- OpenPanel(panelId, args): the server opens windows (roulette / item shop prompts, the tutorial).
local function onOpenPanel(panelId, args, fromRemote)
	if type(panelId) ~= "string" then
		return
	end
	args = type(args) == "table" and args or {}
	local key = panelId:lower()
	-- Phase 4: the Food Machine list, the garden picker, the Training Place and the EVOLVE moment are CareController's
	-- windows (it hears the OpenPanel remote itself; calls made on the client are forwarded)
	local careId = nil
	if key == "feed" or (key == "pets" and args.Action == "Feed") then
		careId = "Feed"
	elseif key == "pets" and args.Action == "Garden" then
		careId = "Garden"
	elseif key == "train" or key == "training" then
		careId = "Train"
	elseif key == "evolve" then
		careId = "Evolve"
	end
	if careId then
		local care = P2.care()
		if care then
			if not fromRemote then
				safe("care open", care.Open, careId, args)
			end
			return
		end
		if careId ~= "Feed" and careId ~= "Garden" then
			return
		end
		-- (no CareController in this build: the Pets window on that pet)
		args = { Key = args.Key }
		key = "pets"
	end
	if key == "shop" or key == "store" then
		P5.openShop(args) -- lobby-shop Task 22: the one Shop window (refused in a match by ShopController itself)
	elseif key == "pets" or key == "inventory" or key == "items" or key == "team" or key == "teams" then
		P5.openPets(args) -- team balance: the one Pets window (the Team and Items tabs are gone)
	elseif key == "home" or key == "spot" then
		if inMatch() then
			return
		end
		openWindow("Home", args) -- Phase 6: without a home it offers Claim a home
	elseif key == "index" then
		local groupId = args.GroupId or args.Group or args.Rarity
		openIndex(type(groupId) == "string" and groupId or nil)
	elseif key == "stats" then
		openWindow("Stats", args)
	elseif key == "settings" then
		MenuController.OpenSettings() -- HUD cleanup: the pill's gear
	elseif key == "close" then
		closeEverything()
	end
end

local function onStateChanged()
	-- red dot on the Pets tile when the collection grew while the Pets window was closed
	local _, total = petTotals()
	if Badge.LastPetTotal ~= nil and total > Badge.LastPetTotal and not P5.petsOpen() then
		if Entries.Pets then
			Entries.Pets.SetBadge(true)
		end
	end
	Badge.LastPetTotal = total
	refreshIndexBadge()

	for _, win in pairs(windows) do
		refreshWindow(win)
	end
end

local function onTokensChanged()
	refreshOpenWindow()
end

-- the claimed plot changed (claimed / released): the Home window follows (Phase 6: without a home it shows Claim a home)
local function onSpotChanged()
	Home.Folder = nil
	local win = windows.Home
	if win and win.Shown then
		if win.OnOpen then
			safe("home rebind", win.OnOpen, {})
		end
		refreshWindow(win)
	end
end

local function onMatchFlagChanged()
	if inMatch() then
		closeEverything(true)
	end
	updateMenuActive()
	refreshOpenWindow()
end

-- Escape only: gamepad B goes through the "NimbusMenuBack" action (syncBackBinding), because it must not
-- also reach MovementController's dash.
local function onInput(input)
	if input.KeyCode == Enum.KeyCode.Escape then
		handleBack()
	end
end

local function connectRemotes()
	local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
	if okOpen and openRemote then
		openRemote.OnClientEvent:Connect(function(panelId, args)
			safe("OpenPanel", onOpenPanel, panelId, args, true)
		end)
	else
		warn("[MenuController] OpenPanel remote is unavailable: " .. tostring(openRemote))
	end
	-- (lobby-shop Task 22: RouletteResult is EggStage's; ShopController calls EggStage.Init)
end

-- The Pet Index lives in IndexController: keep one window at a time, light the Index tile and relay
-- its opening as WindowOpened("Index").
local function connectIndex()
	local index = getIndex()
	if not index then
		return
	end
	if type(index.Opened) == "table" and type(index.Opened.Connect) == "function" then
		index.Opened:Connect(function()
			if openId then
				closeWindow(openId, true)
			end
			P5.closePets()
			updateMenuActive()
			MenuController.WindowOpened:Fire("Index")
		end)
	end
	if type(index.Closed) == "table" and type(index.Closed.Connect) == "function" then
		index.Closed:Connect(function()
			updateMenuActive()
		end)
	end
	refreshIndexBadge()
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function MenuController.Open(panelId, args)
	if initialized then
		onOpenPanel(panelId, args)
	end
end

function MenuController.Close()
	if initialized then
		closeEverything()
	end
end

function MenuController.GetButton(id)
	if id == "Home" then
		id = "Spot" -- the Home tile keeps the v3 id
	end
	local entry = Entries[id]
	return entry and entry.Button or nil
end

-- (U9-9 look 2) the tutorial's pointer marks tile `id` with the kit's Selected look (the gold face and its lip, as an open
-- window's tile) instead of a ring round it: the rail's tiles lie edge to edge, so a ring covered the next one. on = false
-- gives the tile its own look back
function MenuController.SetPointed(id, on)
	if id == "Home" then
		id = "Spot"
	end
	local entry = Entries[id]
	if entry and (entry.Pointed == true) ~= (on == true) then
		entry.Pointed = on == true
		paintTile(entry)
	end
end

-- Opens the Food Machine list (CareController) with that pet copy first (key; nil = the garden pets first).
function MenuController.OpenFeed(key)
	if initialized then
		onOpenPanel("Pets", { Action = "Feed", Key = key })
	end
end

-- The Pets window showing `preset` (1-3; nil = the active one).
function MenuController.OpenTeam(preset)
	if initialized then
		onOpenPanel("Team", { Preset = preset })
	end
end

-- The menu's side hint (CareController's local refusals use it too; never in the screen centre). (roll-look review round
-- 1) While this gui is off (the egg stage hides the HUD: HatchLook.HideHud) the hint could not be seen, so it goes to
-- NotifyController's toast stack (NimbusNotify stays on); the hint again when that is not there.
function MenuController.Hint(text, kind)
	if initialized and type(text) == "string" then
		if gui and gui.Enabled == false then
			local module = script.Parent:FindFirstChild("NotifyController")
			local ok, nc = pcall(require, module)
			if ok and type(nc) == "table" and type(nc.Toast) == "function" and nc.Toast(text, kind or "info") then
				return
			end
		end
		showHint(text, kind)
	end
end

-- true while a menu window, the Pets window, the Shop or the egg stage covers the screen (the tutorial folds its card
-- and hides its menu pointer meanwhile)
function MenuController.IsOpen()
	return openId ~= nil or P5.petsOpen() or P5.shopOpen() or P5.hatchShowing()
end

-- Phase 3 (BattleController): hides the menu tiles while the battle team cards use the left edge of a landscape
-- phone (nothing may sit in the screen centre there); false shows them again. The (transparent) column frame keeps
-- its place, so the HUD, the tutorial and the DEV tile that measure it do not move.
function MenuController.SetColumnHidden(hidden)
	U.ColumnHidden = hidden == true
	for _, entry in pairs(Entries) do
		P5.tileVisibility(entry)
	end
	if U.Tab then
		U.Tab.Visible = not U.ColumnHidden and not U.Covered
	end
end

-- Team balance: a window reaches over the tiles from screen x `windowLeft` (a phone, a tablet); nil = it closed. `who` is
-- the window ("Pets" by default: PetsController; the Store and the Gifts window pass "Store" / "Daily", re-review 1): the
-- tiles step aside like SetColumnHidden's (the column frame keeps its place) while any window's left edge is left of
-- the column's right edge, so the Store closing on the Gifts window's WindowOpened never brings them back over it.
function MenuController.SetColumnCovered(windowLeft, who)
	U.Covers = type(U.Covers) == "table" and U.Covers or {}
	U.Covers[type(who) == "string" and who or "Pets"] = type(windowLeft) == "number" and windowLeft or nil
	P5.applyCovers()
end

-- (Pitch 2 12_elements, look review r0) the tiles step aside while any window in U.Covers reaches over the column. Also
-- run when the column comes back on a portrait phone (P5.watchSheets): a window that asked while a sheet hid the
-- column (right = 0, so "not covered") lay over the tiles once the sheet went (the Elements window over the Index)
function P5.applyCovers()
	U.Covers = type(U.Covers) == "table" and U.Covers or {}
	local right = columnRight()
	local covered = false
	for _, left in pairs(U.Covers) do
		if left < right then
			covered = true
		end
	end
	if covered == (U.Covered == true) then
		return
	end
	U.Covered = covered
	for _, entry in pairs(Entries) do
		P5.tileVisibility(entry)
	end
	if U.Tab then
		U.Tab.Visible = not U.ColumnHidden and not U.Covered
	end
end

-- Re-review 2: Roblox's touch controls (GuiService.TouchControlsEnabled) for the windows that fill a phone. `who` names
-- the window ("Pets" when left out), `on` = true while it wants them gone. They go when the first window asks and come
-- back as they were (the one snapshot, taken while no window held them) when the last one lets go, so the Store and
-- the Pets window opening over each other (each lays out before WindowOpened closes the other) never leave them off.
function MenuController.SetTouchHidden(who, on)
	U.TouchOwners = type(U.TouchOwners) == "table" and U.TouchOwners or {}
	local before = next(U.TouchOwners) ~= nil
	U.TouchOwners[type(who) == "string" and who or "Pets"] = (on == true) or nil
	local after = next(U.TouchOwners) ~= nil
	if before == after then
		return
	end
	pcall(function()
		local GuiService = game:GetService("GuiService")
		if after then
			U.TouchWas = GuiService.TouchControlsEnabled
			GuiService.TouchControlsEnabled = false
		else
			GuiService.TouchControlsEnabled = U.TouchWas ~= false
			U.TouchWas = nil
		end
	end)
end

-- Bug batch 2 #1: folds the menu column against the left edge (true) or brings it back (false); the arrow tab does
-- the same. IsColumnCollapsed() -> the remembered state (this session).
function MenuController.SetColumnCollapsed(collapsed, animate)
	safe("menu fold", P5.setCollapsed, collapsed == true, animate == true)
end

function MenuController.IsColumnCollapsed()
	return U.Collapsed == true
end

-- Debug helper (smoke tests): forget that Roblox's thumbstick was seen (a fresh session) and lay the column out again.
function MenuController.ResetStickSeen()
	U.StickSeen = nil
	if U.Column then
		safe("menu stick", relayoutMenu)
	end
end

function MenuController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	touchDevice = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	pcall(State.Init)

	gui = CloudUI.NewScreenGui("NimbusMenu", 20)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(gui)

	buildHint()
	buildColumn()
	-- (kit-b U9-3) the Stats window on the Signboard kit too; its lists scroll through both bottom corners on a phone, so the
	-- touch controls go while it is open (HideTouch, as Home), and the HUD's currency strips step aside (HideCurrency);
	-- (U9-3 review) on a phone, where it reaches over the vitals card, the card hides too (HideVitals)
	createWindow({ Id = "Stats", Title = "Stats", Category = "Stats", Build = buildStats, Tall = true, Skin = "Signboard", Icon = Config.Icons.Stats or "stats",
		HideTouch = true, HideCurrency = "Over", HideVitals = true }) -- (LOOK-ui) Home's box now: the strips step aside as for Home
	-- (LOOK-ui) Home steps the HUD aside as Stats does where it lies over it: the vitals card, the strips (only then)
	createWindow({ Id = "Home", Title = "My Home", Category = "Home", Build = buildHome, Tall = true, Skin = "Signboard", Icon = HOME_ICON.House, HideTouch = true,
		HideCurrency = "Over", HideVitals = true })
	relayoutMenu()
	updateMenuActive()

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", relayoutMenu)
	end)
	State.Changed:Connect(function()
		safe("State.Changed", onStateChanged)
	end)
	LocalPlayer:GetAttributeChangedSignal(Config.Attr.Tokens):Connect(function()
		safe("Tokens", onTokensChanged)
	end)
	LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
		safe("InMatch", onMatchFlagChanged)
	end)
	-- Phase 2: Cash / Gems balances (prices turn red / green), the claimed plot
	if type(State.BerriesChanged) == "table" and type(State.BerriesChanged.Connect) == "function" then
		State.BerriesChanged:Connect(function()
			safe("berries", refreshHomeLive)
		end)
	end
	for _, signalName in ipairs({ "CashChanged", "GemsChanged" }) do
		local signal = State[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				safe(signalName, onTokensChanged)
			end)
		end
	end
	LocalPlayer:GetAttributeChangedSignal(Config.Attr.SpotIndex):Connect(function()
		safe("SpotIndex", onSpotChanged)
	end)
	UserInputService.InputBegan:Connect(function(input)
		safe("input", onInput, input)
	end)

	-- remember the collection size so only later growth shows the "new pet" dot
	local _, total = petTotals()
	if State.IsLoaded and State.IsLoaded() then
		Badge.LastPetTotal = total
	end

	safe("connect index", connectIndex)
	-- the Pets window (PetsController) opened: one window at a time; its tile glows while it is up. Store W1 (spec 8):
	-- the Shop (lobby-shop Task 22: "Shop"; "Store" from an old build), the Gifts window and the Sky Trove close the
	-- menu's windows the same way, and the Pets window too
	MenuController.WindowOpened:Connect(function(id)
		if id == "Pets" or id == "Shop" or id == "Store" or id == "Daily" or id == "Trove" then
			if openId then
				closeWindow(openId, true)
			end
			closeIndex()
			if id ~= "Pets" then
				P5.closePets()
			end
			updateMenuActive()
		end
	end)
	local pets = P5.pets()
	if pets then
		pets.Closed:Connect(updateMenuActive)
	end
	task.spawn(connectRemotes)
	P5.watchSheets()
end

return MenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1150">
            <Properties>
              <string name="Name">MeshFallback</string>
              <string name="Source"><![CDATA[-- MeshFallback (Phase 6, review3 runtime-2; owner fix-meshlib): the per-device Part fallback for SERVER-built mesh pets.
--
-- NPC pets, the lobby fountain statue, the podium pets and the Storm Altar Stormfang are built (or swapped) on the
-- server and replicate as MeshParts. A device whose ContentProvider:PreloadAsync failed for one of their keys
-- (MeshLibrary.Status(key) == "failed" here) cannot draw them. On such a device this watcher hides the model's
-- MeshParts LOCALLY and puts a local Part copy inside it (PetBuilder.Build(PetBuilder.ServerDef(model)) with Parts =
-- true), welded to the model's root so it follows every move (PivotTo / root CFrame); the server model, its tags,
-- prompts and PetFx stay untouched. Recipe 4.8: "a client fetch failure degrades per key to the Part build".
--
-- Why this and not "hide the mesh only": hiding alone leaves an invisible pet; the server cannot keep a hidden Part
-- copy either (thousands of extra replicated parts for every player). The definition is already on the model
-- (PetBuilder.MESH.stamp: PBD_* attributes), so the copy is the exact Part pet this device would have built itself.
--
-- Cost: nothing while MeshIds is empty (Start returns before connecting anything = today's game). Otherwise one
-- CollectionService signal + one MeshLibrary.Changed handler; never per frame. A model is checked when it streams in
-- and when a key it uses changes status here; at most once rebuilt (weak-keyed memo).
--
--   MeshFallback.Start() / Init()   idempotent (Start(true): tests only, skips the MeshIds check); MeshFallback.Stop() disconnects (tests)
--   MeshFallback.Check(model) -> bool   (true = this device shows the Part copy for it)

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MeshFallback = {}

local COPY_NAME = "ML_PartCopy"
local started = false
local conns = {}
local done = setmetatable({}, { __mode = "k" }) -- model -> true once handled (copy made or nothing to do ever)
local ML, PB = nil, nil

local function shared(name)
	local folder = ReplicatedStorage:FindFirstChild("Shared")
	local mod = folder and folder:FindFirstChild(name)
	if not mod then
		return nil
	end
	local ok, res = pcall(require, mod)
	return ok and res or nil
end

local function keysOf(model)
	local raw = model:GetAttribute("PBD_Keys")
	if type(raw) ~= "string" or raw == "" then
		raw = model:GetAttribute("ML_Keys")
	end
	local out = {}
	for key in string.gmatch(type(raw) == "string" and raw or "", "[^,]+") do
		out[#out + 1] = key
	end
	return out
end

local function brokenHere(model)
	for _, key in ipairs(keysOf(model)) do
		if ML.Status(key) == "failed" then
			return true
		end
	end
	return false
end

-- the server model's own mesh parts go invisible here (local writes); lids / pulses keep their hidden value
local function hideMesh(model, copy)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("MeshPart") and not d:IsDescendantOf(copy) then
			d.Transparency = 1
			if d:GetAttribute("PB_T0") ~= nil then
				d:SetAttribute("PB_T0", 1)
			end
			if d:GetAttribute("PB_Pulse") ~= nil then
				d:SetAttribute("PB_Pulse", 1)
			end
		end
	end
end

function MeshFallback.Check(model)
	if not started or typeof(model) ~= "Instance" or not model:IsA("Model") or done[model] or not model.Parent then
		return false
	end
	if model:GetAttribute("ML_Mesh") ~= true or not brokenHere(model) then
		return false
	end
	done[model] = true
	local def, opts = PB.ServerDef(model)
	if not def then
		return false
	end
	local ok, copy = pcall(PB.Build, def, opts)
	if not ok or typeof(copy) ~= "Instance" then
		warn("[MeshFallback] no Part copy for " .. model:GetFullName() .. ": " .. tostring(copy))
		return false
	end
	copy.Name = COPY_NAME
	pcall(function()
		copy:PivotTo(model:GetPivot())
	end)
	local root = model.PrimaryPart
	for _, p in ipairs(copy:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanTouch = false
			p.CanQuery = false
			p.Massless = true
			if root then
				p.Anchored = false
				local weld = Instance.new("WeldConstraint")
				weld.Name = "ML_Weld"
				weld.Part0 = root
				weld.Part1 = p
				weld.Parent = p
			end
		end
	end
	hideMesh(model, copy)
	copy.Parent = model
	return true
end

-- testIds (TESTS ONLY, tools/smoke_p6_pets.lua): skip the MeshIds check (the fixture ids live in MeshLibrary._Configure)
function MeshFallback.Start(testIds)
	if started then
		return
	end
	local okIds, ids = pcall(function()
		return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MeshIds", 10))
	end)
	if testIds ~= true and (not okIds or type(ids) ~= "table" or next(ids) == nil) then
		return -- empty MeshIds: today's game, nothing connected
	end
	ML, PB = shared("MeshLibrary"), shared("PetBuilder")
	if type(ML) ~= "table" or type(ML.Status) ~= "function" or type(PB) ~= "table" or type(PB.ServerDef) ~= "function" then
		return
	end
	started = true
	local tag = PB.ServerMeshTag or "PB_ServerMesh"
	conns[#conns + 1] = CollectionService:GetInstanceAddedSignal(tag):Connect(MeshFallback.Check)
	if type(ML.Changed) == "table" then
		conns[#conns + 1] = ML.Changed:Connect(function(key)
			if ML.Status(key) ~= "failed" then
				return
			end
			for _, model in ipairs(CollectionService:GetTagged(tag)) do
				if not done[model] then
					MeshFallback.Check(model)
				end
			end
		end)
	end
	for _, model in ipairs(CollectionService:GetTagged(tag)) do
		MeshFallback.Check(model)
	end
end

function MeshFallback.Init()
	MeshFallback.Start()
end

function MeshFallback.Stop()
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	conns = {}
	started = false
	done = setmetatable({}, { __mode = "k" })
end

return MeshFallback
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1151">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[-- MovementController (client): smooth run, stamina, dash, camera feel and mobile buttons.
--
--   MovementController.Init()
--   MovementController.GetDashCooldownFraction() -> number   -- 0 = ready .. 1 = just used
--   MovementController.HelpDevice(inputType) -> "Keyboard" | "Touch" | "Gamepad" | nil   -- kit-b O4: the course help
--                                              labels (Config.Course.Help) read the text of this device
--   MovementController._TouchButtons(on) -> gui | nil   (tests) the touch RUN / DASH in a world that booted as a desktop
--
-- How it works
--   * Input is bound once with ContextActionService (high priority, so Shift never toggles
--     Roblox shift-lock and typing in a TextBox never triggers a dash).
--   * Everything that touches the character lives in a per-character context that is created on
--     CharacterAdded and torn down on CharacterRemoving / Died, so nothing leaks across respawns.
--   * WalkSpeed is "owned" by the server (PlayerService freezes/unfreezes it). We watch for
--     changes we did not make and treat that value as the base speed, so a frozen or Downed
--     player can never run or dash, and the server can still change the speed at any time.
--   * The dash is velocity-based: for DashDuration seconds the horizontal velocity of the
--     HumanoidRootPart is re-asserted every physics step while the vertical velocity is left alone.
--   * v2: stamina regenerates (1 + player attribute PerkStaminaRegen) times as fast (pet perk), and the mobile
--     RUN / DASH buttons are laid out around Roblox's jump button, the hotbar and the vitals card above it.
--   * Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 3.9 / 4.4; battleclient): BattleController drives three
--     battle switches on Start / Speed / End:
--       MovementController.SetDashKeys(keys | nil)   in battle Shift = DASH (keys = { LeftShift, RightShift, ButtonB }),
--                                                    Q is left to BattleController's SPECIAL; while Shift dashes, RUN
--                                                    moves to Ctrl (+ L3 / the mobile RUN button) and the mobile DASH
--                                                    button hides (the battle cluster has its own); nil restores Q / B
--       MovementController.SetFreeDash(on, cooldown) a dash costs no stamina while on (cooldown = the battle's
--                                                    DashCooldown; Config.Physics is never touched)
--       MovementController.SetBattleSpeed(walk, run | nil)  the character walks at `walk` (written as the base speed:
--                                                    the "server owns WalkSpeed" watch is suspended, except that a
--                                                    server write of 0 (Downed / frozen) still wins) and runs at `run`
--                                                    (default walk x 1.3) instead of Config.Physics.RunSpeed;
--                                                    SetBattleSpeed(nil) gives the server's base back at once
--     plus MovementController.TryDash() -> bool (the battle DASH button), SetDashListener(fn | nil) (called after every
--     dash: BattleController sends BattleCommand "Dash") and GetSpeedState() (tests).
--   * Dungeon fixes (decision 5): MovementController.SetPetDash(fn | nil): in a battle Shift (+ RightShift, gamepad B)
--     is the PET's dash: the keys call fn() only (BattleController sends BattleCommand "Dash"); the character gets NO
--     velocity impulse, spends no stamina and starts no dash cooldown (tryDash / TryDash refuse while it is set, so
--     the vitals card's dash ring never shows a character dash); RUN moves to Ctrl (as with SetDashKeys) and the
--     mobile DASH button hides (the battle cluster's DASH sends the same command). nil restores Q / B, Shift = run.
--     BattleController uses it instead of SetDashKeys / SetFreeDash / SetDashListener. EXHAUST_RESUME is 22 (15% of the
--     150 MaxStamina). Run / dash input is ignored until UiGate.HasPlayed() (the main menu, 7.2; no UiGate = played).
--   * Bug batch 2 (#19): MovementController.SetZoomMax(n | nil) caps LocalPlayer.CameraMaxZoomDistance at n (DungeonController:
--     14 while a dungeon run lasts, so the camera never leaves the 16-stud rooms); nil gives the normal ZOOM_MAX 40 back.
--     The cap survives a respawn (applyCameraSettings re-applies it); junk (NaN, <= 0, inf, non-numbers) is ignored;
--     CameraMinZoomDistance is only lowered when it would sit above the cap (first person is never forced).
--   * Wave 5 dungeon camera (bugs #15 / #26; DungeonController / BattleController). This controller is the one place
--     that writes Camera.FieldOfView and the character's WalkSpeed every frame, so the cinematics go through it:
--       MovementController.SetFovOverride(fov | nil)  while set the FOV is `fov` (+ a live punch) instead of 70 + run +
--                                                    dash; nil = the normal FOV again
--       MovementController.FovPunch(degrees, seconds) a quick zoom punch: + degrees * (1 - p)^2 over `seconds` on top
--                                                    of whatever is written (a second punch keeps the larger one)
--       MovementController.SetCinematic(walkSpeed | nil)  a scripted walk (the room walk-in): run / dash input is
--                                                    ignored, the mobile buttons dim like Downed, WalkSpeed = walkSpeed
--                                                    (the "server owns WalkSpeed" watch suspended, a server 0 still
--                                                    wins); nil = the normal speed rules at once. GetSpeedState().Cinematic
--   * Unlimited stamina in the lobby: inside Config.InLobbyZone, out of a match and a battle, running drains nothing, a
--     dash costs no stamina (its cooldown stays) and the bar is full, so the HUD simply shows it full. GetSpeedState().StaminaFree
--   * Dev 2x speed (DevService "speed"): while the server's hint NC_DevSpeed is on our PlayerGui, walking and running are
--     written at twice their speed on top of the server's base (never on top of our own write, so it cannot stack). Not in
--     a battle or a scripted walk: BattleService leashes the character to the server fighter there. GetSpeedState().DevSpeed
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)
local PixelIcon = require(Shared.PixelIcon) -- (kit-b U9-8) the touch keys' icons
local Remotes = require(Shared.Remotes)

local MovementController = {}

-- Luau/Lua 5.1 have math.atan2; Lua 5.3+ folds it into math.atan(y, x). Support both.
local atan2 = math.atan2 or function(y, x)
	return math.atan(y, x)
end

local LocalPlayer = Players.LocalPlayer
local P = Config.Physics
local ATTR = Config.Attr

----------------------------------------------------------------------
-- Tuning (feel only; gameplay numbers live in Config.Physics)
----------------------------------------------------------------------
local BASE_FOV = 70
local RUN_FOV_BOOST = 4 -- extra degrees at full run
local DASH_FOV_BOOST = 12 -- 70 -> 82 -> 70 punch
local PUNCH_ATTACK = 0.07 -- seconds to reach the peak
local PUNCH_TOTAL = 0.5 -- seconds until the punch has fully relaxed

local ZOOM_MAX = 40 -- LocalPlayer.CameraMaxZoomDistance
local zoomMax = ZOOM_MAX -- the cap in force (SetZoomMax: 14 inside a dungeon run)

local EXHAUST_RESUME = 22 -- stamina needed to run again after hitting 0 (Phase 5: 15% of MaxStamina, Config.Movement.ExhaustResume)
local RUN_RAMP_UP = 9 -- exponential smoothing rates (1/s)
local RUN_RAMP_DOWN = 7
local RUN_REGEN_DELAY = 0.25 -- seconds after running before stamina regenerates
local DASH_REGEN_DELAY = 0.5
local DASH_BUFFER = 0.18 -- a dash pressed this close to "ready" is queued
local FROZEN_SPEED = 0.5 -- WalkSpeed below this means "frozen by the server"
local SPEED_EPS = 0.05 -- tolerance when comparing WalkSpeed with what we wrote
local MOVE_EPS = 0.1 -- MoveDirection magnitude that counts as "moving"
local DEV_SPEED_HINT = "NC_DevSpeed" -- PlayerGui attribute set by DevService (only for developers)
local DEV_SPEED_MULT = 2

local LINE_COUNT = 18 -- screen speed lines
-- (kit-b U9-8) the touch keys: the wood edge, the lip under the face, how far a press sinks the face onto it, the charge's
-- step (px), and the icon's size from this key size up (27 px, else 18)
local KEY_EDGE, KEY_LIP, KEY_SINK, KEY_STEP, KEY_BIG = 3, 5, 3, 2, 72

local FxSprites = require(Shared.FxSprites) -- the game's own particle sprites (kit B X1)

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local ctx = nil -- active character context, nil when there is none
local bindToken = 0 -- bumps on every bind/unbind so stale async binds can abort

local stamina = P.MaxStamina
local regenMul = 1 -- 1 + attribute PerkStaminaRegen (pet perk, written by the server)
local lastMirrored = nil
local exhausted = false -- hit 0 stamina; blocked from running until EXHAUST_RESUME

local shiftHeld = false -- physical Shift key
local runToggled = false -- mobile button / gamepad L3
local runBlend = 0 -- 0 = walk speed .. 1 = full run speed

local baseSpeed = P.WalkSpeed -- the walk speed we build on: the server's, or the battle walk (Phase 5)
local serverSpeed = P.WalkSpeed -- WalkSpeed as set by the server (the last value we did not write)
local lastWritten = nil -- the WalkSpeed value WE last wrote (nil = we are not overriding)
-- Phase 5 battle switches (BattleController)
local battleSpeed = nil -- { walk = n, run = n } while a battle sets the character's legal speeds
local freeDash = false -- a dash costs no stamina
local dashLength = P.DashCooldown -- the cooldown of the current / last dash (the battle's DashCooldown while free)
local freeDashCooldown = nil
local dashKeys = nil -- the battle's dash keys (nil = the obby keys Q / B)
local dashListener = nil -- called after every dash (BattleController: BattleCommand "Dash")
local cinematic = nil -- wave 5: the walk speed of a scripted walk-in (SetCinematic); run / dash ignored while set
local fovOverride = nil -- wave 5: SetFovOverride (the cinematics' FOV)
local fovPunch = nil -- wave 5: { amount, t0, dur } FovPunch
local petDash = nil -- dungeon fixes: the battle's pet dash (SetPetDash); while set the dash keys call it and the character never dashes
local PET_DASH_KEYS = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonB }
local uiGate = nil -- client/UiGate (menu W3), loaded lazily; false when missing
local regenBlockedUntil = 0

local cooldownEnd = 0
local dashBufferUntil = 0
local dash = nil -- { dir = Vector3, startTime = n, endTime = n } while dashing
local punchStart = -10

local dashRemote = nil
local ui = nil -- { holder, lines, flashToken, mobile } once the GUI is built

-- forward declarations
local unbindCharacter
local tryDash

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function isLocked()
	if LocalPlayer:GetAttribute(ATTR.Downed) == true then
		return true
	end
	return baseSpeed < FROZEN_SPEED
end

-- In the lobby (not in a match or a battle) stamina is unlimited.
local function staminaFree(root)
	if LocalPlayer:GetAttribute(ATTR.InMatch) == true then
		return false
	end
	local inBattle = LocalPlayer:GetAttribute(ATTR.InBattle or "InBattle")
	if inBattle ~= nil and inBattle ~= false and inBattle ~= "" then
		return false
	end
	return Config.InLobbyZone(root.Position)
end

-- 2 while the dev speed is on and nothing else owns the speed (a battle's legal speeds, a scripted walk); else 1.
local function devSpeedMult()
	if battleSpeed or cinematic then
		return 1
	end
	local inBattle = LocalPlayer:GetAttribute(ATTR.InBattle or "InBattle")
	if inBattle ~= nil and inBattle ~= false and inBattle ~= "" then
		return 1
	end
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if pg and pg:GetAttribute(DEV_SPEED_HINT) == true then
		return DEV_SPEED_MULT
	end
	return 1
end

-- Phase 5 (7.2): run / dash input waits for PLAY on the main menu (no UiGate module = always open)
local function gateOpen()
	if uiGate == nil then
		uiGate = false
		local client = script.Parent and script.Parent.Parent
		local inst = client and client:FindFirstChild("UiGate")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				uiGate = mod
			end
		end
	end
	if uiGate and type(uiGate.HasPlayed) == "function" then
		local ok, played = pcall(uiGate.HasPlayed)
		return (not ok) or played ~= false
	end
	return true
end

-- Mirror stamina into the player attribute the HUD reads; throttled to avoid attribute spam.
local function mirrorStamina(force)
	local value = Util.Clamp(stamina, 0, P.MaxStamina)
	if lastMirrored ~= nil and not force then
		if value == lastMirrored then
			return
		end
		local atEdge = value <= 0 or value >= P.MaxStamina
		if not atEdge and math.abs(value - lastMirrored) < 0.1 then
			return
		end
	end
	lastMirrored = value
	LocalPlayer:SetAttribute(ATTR.Stamina, value)
end

local function applyCameraSettings()
	pcall(function()
		if LocalPlayer.CameraMinZoomDistance > zoomMax then
			LocalPlayer.CameraMinZoomDistance = math.min(0.5, zoomMax)
		end
		LocalPlayer.CameraMaxZoomDistance = zoomMax
	end)
end

-- Pet perk: stamina regenerates (1 + PerkStaminaRegen) times as fast. Sanitised because attributes can
-- hold anything; the server already caps the value (Config.Pets.PerkCaps.StaminaRegen).
local function refreshRegenPerk()
	local value = LocalPlayer:GetAttribute(ATTR.PerkStaminaRegen)
	if type(value) ~= "number" or value ~= value then
		value = 0
	end
	regenMul = 1 + Util.Clamp(value, 0, 5)
end

local function tween(instance, seconds, goal, style, direction)
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(instance, info, goal)
	t:Play()
	return t
end

----------------------------------------------------------------------
-- GUI: screen speed lines + mobile buttons
----------------------------------------------------------------------
-- (kit-b gate U9 r4) MobileHolds[who] = true while a modal card (the Loss card) wants the RUN / DASH buttons gone;
-- MobileWanted = what the movement state last asked for, shown again when the last hold lets go
local MobileHolds, MobileWanted = {}, true
local function setMobileVisible(visible)
	MobileWanted = visible
	visible = visible and next(MobileHolds) == nil
	if ui and ui.mobile then
		-- (roll-look review round 1) HudKeepOff: the egg stage may already have this gui off (its HUD hide), where this
		-- write changes nothing it can see; the attribute keeps the buttons off when the stage restores the HUD
		ui.mobile.Gui:SetAttribute("HudKeepOff", not visible)
		ui.mobile.Gui.Enabled = visible
	end
end

-- Short burst of white streaks radiating from the screen centre.
local function flashSpeedLines()
	if not ui or not ui.holder then
		return
	end
	ui.flashToken = ui.flashToken + 1
	local token = ui.flashToken
	ui.holder.Visible = true
	for _, line in ipairs(ui.lines) do
		local frame = line.Frame
		frame.Position = UDim2.fromScale(line.X, line.Y)
		frame.BackgroundTransparency = 0.35 + line.Alpha
		tween(frame, 0.34, { BackgroundTransparency = 1, Position = UDim2.fromScale(line.OutX, line.OutY) })
	end
	task.delay(0.4, function()
		if ui and ui.flashToken == token then
			ui.holder.Visible = false
		end
	end)
end

local function buildSpeedLines(playerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "MovementFx"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 2
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local holder = Instance.new("Frame")
	holder.Name = "SpeedLines"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.Visible = false
	holder.Parent = gui

	local rng = Random.new(11)
	local lines = {}
	for i = 1, LINE_COUNT do
		local angle = ((i - 1) / LINE_COUNT) * math.pi * 2 + rng:NextNumber(-0.09, 0.09)
		local radius = rng:NextNumber(0.3, 0.45)
		local cosA = math.cos(angle)
		local sinA = math.sin(angle)

		local frame = Instance.new("Frame")
		frame.Name = "Line"
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = Theme.Colors.White
		frame.BackgroundTransparency = 1
		frame.Size = UDim2.fromOffset(rng:NextInteger(90, 170), rng:NextInteger(2, 4))
		-- aim the streak along the pixel-space direction of its position (assumes ~16:9)
		frame.Rotation = math.deg(atan2(sinA * 9, cosA * 16))
		frame.Parent = holder

		-- fade the inner end so the streak looks like it comes out of the distance
		local gradient = Instance.new("UIGradient")
		gradient.Transparency = NumberSequence.new(1, 0)
		gradient.Parent = frame

		table.insert(lines, {
			Frame = frame,
			X = 0.5 + cosA * radius,
			Y = 0.5 + sinA * radius,
			OutX = 0.5 + cosA * (radius + 0.07),
			OutY = 0.5 + sinA * (radius + 0.07),
			Alpha = rng:NextNumber(0, 0.25),
		})
	end

	gui.Parent = playerGui
	return holder, lines
end

-- (kit-b U9-8; was a round see-through button with a dark cooldown overlay and a squash) a square kit B keycap: the
-- TextButton keeps the layout's box and the input, inside it the Block (the face in a wood edge) sits on its Lip, the pixel
-- icon over the caption; Charge is the sky rising from the face's bottom while the dash cools down. look = { Face, Lip, Ink }
-- at rest; paintKey draws the state ("ready", "on" = gold, "cool", "off"), a press sinks the face onto its lip
local function makeKeyButton(parent, name, text, iconName, size, position, look, onPress)
	local Sign = Theme.Sign
	local button = Instance.new("TextButton")
	button.Name = name
	button.AnchorPoint = Vector2.new(1, 1)
	button.Size = UDim2.fromOffset(size, size)
	button.Position = position
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.Parent = parent

	local block = Instance.new("Frame")
	block.Name = "Block"
	block.BorderSizePixel = 0
	block.BackgroundTransparency = 0
	block.BackgroundColor3 = look.Face
	block.Size = UDim2.fromScale(1, 1)
	block.Parent = button
	local edge = Theme.Stroke(block, Sign.Wood, KEY_EDGE, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter

	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BorderSizePixel = 0
	lip.BackgroundColor3 = look.Lip
	lip.AnchorPoint = Vector2.new(0, 1)
	lip.Position = UDim2.new(0, 0, 1, 0)
	lip.Size = UDim2.new(1, 0, 0, KEY_LIP)
	lip.ZIndex = 2
	lip.Parent = block

	local charge = Instance.new("Frame")
	charge.Name = "Charge"
	charge.BorderSizePixel = 0
	charge.BackgroundColor3 = Sign.Sky
	charge.AnchorPoint = Vector2.new(0, 1)
	charge.Visible = false
	charge.ZIndex = 2
	charge.Parent = block

	local label = Theme.Label(text, "Heading", {
		Size = math.floor(size * 0.26),
		Color = look.Ink,
		Props = { ZIndex = 4, TextXAlignment = Enum.TextXAlignment.Center },
	})
	label.Name = "Label"
	label.Parent = block

	local handle = {
		Button = button,
		Block = block,
		Lip = lip,
		Edge = edge,
		Charge = charge,
		Label = label,
		Look = look,
		IconName = iconName,
		Icon = nil,
		IconPx = 0,
		Size = 0,
		State = "ready",
		Fill = 0,
		Pressed = false,
		Shake = 0,
		Drawn = nil,
	}

	local lastPress = 0
	button.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.Touch or kind == Enum.UserInputType.MouseButton1 then
			local now = os.clock()
			handle.Pressed = true
			handle.Drawn = nil
			if now - lastPress > 0.12 then -- guards against touch + emulated-mouse double events
				lastPress = now
				onPress()
			end
		end
	end)
	button.InputEnded:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.Touch or kind == Enum.UserInputType.MouseButton1 then
			handle.Pressed = false
			handle.Drawn = nil
		end
	end)

	return handle
end

-- draws a key for its state (a no-op when nothing changed): sunk while pressed, cooling down or off; the face, lip and ink by
-- state; the icon over the caption, centred on the face above the lip; the charge (cool only) `Fill` of the face high
-- from its bottom in whole steps
local function paintKey(h)
	local Sign = Theme.Sign
	local sunk = h.Pressed or h.State == "cool" or h.State == "off"
	local sink = sunk and KEY_SINK or 0
	local lipPx = KEY_LIP - sink
	local faceH = h.Size - sink - lipPx
	local chargePx = 0
	if h.State == "cool" then
		chargePx = math.floor(Util.Clamp(h.Fill, 0, 1) * faceH / KEY_STEP) * KEY_STEP
	end
	local d = h.Drawn
	if d and d.State == h.State and d.Sink == sink and d.Charge == chargePx and d.Size == h.Size and d.Shake == h.Shake then
		return
	end
	h.Drawn = { State = h.State, Sink = sink, Charge = chargePx, Size = h.Size, Shake = h.Shake }
	local face, lip, ink = h.Look.Face, h.Look.Lip, h.Look.Ink
	if h.State == "on" then
		face, lip = Sign.Gold, Sign.GoldLip
	elseif h.State == "cool" then
		face, lip = Sign.Well, Sign.WellEdge -- (the caption stays dark: it reads on the well and on the sky charge)
	elseif h.State == "off" then
		face, lip, ink = Sign.Well, Sign.Well, Sign.TextMuted
	end
	h.Block.Position = UDim2.fromOffset(h.Shake, sink)
	h.Block.Size = UDim2.new(1, 0, 1, -sink)
	h.Block.BackgroundColor3 = face
	h.Lip.Size = UDim2.new(1, 0, 0, lipPx)
	h.Lip.BackgroundColor3 = lip
	h.Charge.Visible = chargePx > 0
	h.Charge.Position = UDim2.new(0, 0, 1, -lipPx)
	h.Charge.Size = UDim2.new(1, 0, 0, chargePx)
	local textH = h.Label.TextSize
	local top = math.floor((faceH - (h.IconPx + 2 + textH)) / 2)
	if h.Icon then
		h.Icon.Position = UDim2.fromOffset(math.floor((h.Size - h.IconPx) / 2), top)
		PixelIcon.Tint(h.Icon, ink)
	end
	h.Label.Position = UDim2.fromOffset(0, top + h.IconPx + 2)
	h.Label.Size = UDim2.new(1, 0, 0, textH)
	h.Label.TextColor3 = ink
end

-- the key's size (the layout's): the button's box, the caption's size and the icon (redrawn when its size changes)
local function fitKey(h, size)
	h.Button.Size = UDim2.fromOffset(size, size)
	if h.Size == size then
		return
	end
	h.Size = size
	-- (the battle's 48 px RUN, Pitch 2 item 1b: never under the 14 px phone floor)
	h.Label.TextSize = math.max(14, math.floor(size * 0.26))
	local px = (size >= KEY_BIG) and 27 or 18
	if h.IconPx ~= px then
		if h.Icon then
			h.Icon:Destroy()
		end
		h.Icon = PixelIcon.New(h.Block, h.IconName, px, h.Look.Ink)
		h.Icon.ZIndex = 4
		h.IconPx = px
	end
	h.Drawn = nil
	paintKey(h)
end

local function setKeyState(h, state, fill)
	h.State = state
	h.Fill = fill or 0
	paintKey(h)
end

-- (kit-b U9-8; was a rotating wobble) a refused tap: the wood edge flashes red and fades back, the face shakes sideways in
-- whole px
local function denyFeedback(handle)
	if not handle then
		return
	end
	handle.Edge.Color = Theme.Sign.Red
	tween(handle.Edge, 0.4, { Color = Theme.Sign.Wood })
	handle.ShakeToken = (handle.ShakeToken or 0) + 1
	local token = handle.ShakeToken
	task.spawn(function()
		for _, dx in ipairs({ 3, -3, 2, -2, 1, -1, 0 }) do
			if handle.ShakeToken ~= token then
				return
			end
			handle.Shake = dx
			paintKey(handle)
			task.wait(0.04)
		end
	end)
end

local function toggleRun()
	if not ctx or isLocked() or cinematic then
		return
	end
	if exhausted and not runToggled then
		denyFeedback(ui and ui.mobile and ui.mobile.run)
		return
	end
	runToggled = not runToggled
end

-- Footprints of the other things that live at the bottom of a touch screen. KEEP IN SYNC with
-- HotbarController.lua (SLOT/GAP/TOUCH_BOTTOM, scale 0.75..1.2) and HudController.lua (VITALS_W, VITALS_H /
-- VG.Compact.H, HOTBAR_GAP, scale Theme.ScreenFactor). Only used to keep our buttons clear of them.
-- (On a narrow phone the hotbar slides a few px LEFT of centre to clear the jump button; our buttons are all
-- right of it, so the centred footprint below still covers every spot they could touch.)
-- bug batch 2 #1: the vitals card is bottom-CENTRE now, right above the hotbar (8 px), centred on it; the regular
-- card is 100 design px tall (U9-8 look: was 93), the compact one (short touch screens, height <= 500) 80. The HUD itself
-- then keeps the card clear of RUN / DASH (it measures them), so this only steers RUN to a spot that leaves the card alone.
local HOTBAR_W, HOTBAR_H, HOTBAR_BOTTOM = 280, 64, 16
local VITALS_W, VITALS_H, VITALS_H_COMPACT, VITALS_GAP = 300, 100, 80, 8

-- Rectangles are { left, bottom, right, top } in pixels from the screen's left / BOTTOM edge.
local function rectsOverlap(a, b)
	return a[1] < b[3] and b[1] < a[3] and a[2] < b[4] and b[2] < a[4]
end

-- Places DASH and RUN around Roblox's own jump button without covering it, the hotbar (bottom centre)
-- or the vitals card right above it.
--
-- Roblox's default TouchJump is a J x J square (J = 70 when min(screen axis) <= 500, else 120) whose left edge
-- is 1.5 J + 10 px and whose right edge is 0.5 J + 10 px from the screen's right edge; its bottom edge is
-- 20 px (small) or 0.75 J (large) above the screen's bottom.
--   * DASH goes straight above the jump button (the thumb's natural "up" flick);
--   * RUN prefers the spot left of the jump button; on narrow phones that spot runs into the hotbar, so it
--     moves to the diagonal above-left, and as a last resort onto the top of the DASH button.
local function layoutMobileControls(m)
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local w, h = vp.X, vp.Y
	local small = math.min(w, h) <= 500

	local jump = small and 70 or 120
	local jumpRight = jump * 0.5 + 10
	local jumpLeft = jump * 1.5 + 10
	local jumpBottom = small and 20 or jump * 0.75
	local jumpTop = jumpBottom + jump

	local hotbarScale = Util.Clamp(math.min(w / 1280, h / 720), 0.75, 1.2)
	local hotbarHalf = HOTBAR_W * hotbarScale * 0.5 + 8
	local hotbar = {
		w * 0.5 - hotbarHalf,
		HOTBAR_BOTTOM - 4,
		w * 0.5 + hotbarHalf,
		HOTBAR_BOTTOM + HOTBAR_H * hotbarScale + 8,
	}
	local vitalsScale = Theme.ScreenFactor(h)
	local vitalsHalf = VITALS_W * vitalsScale * 0.5 + 8
	local vitalsBottom = HOTBAR_BOTTOM + HOTBAR_H * hotbarScale + VITALS_GAP
	local vitals = {
		w * 0.5 - vitalsHalf,
		vitalsBottom - 4,
		w * 0.5 + vitalsHalf,
		vitalsBottom + (h <= 500 and VITALS_H_COMPACT or VITALS_H) * vitalsScale + 6,
	}
	local jumpRect = { w - jumpLeft - 4, jumpBottom - 4, w - jumpRight + 4, jumpTop + 4 }

	-- DASH
	local dashSize = small and 66 or 84
	local dashRight = math.max(14, jump + 10 - dashSize * 0.5) -- centred over the jump button
	local dashBottom = jumpTop + 10
	local dashRect = { w - dashRight - dashSize, dashBottom, w - dashRight, dashBottom + dashSize }

	-- RUN: first candidate that touches nothing wins; in a battle (the battle cluster has its own DASH, so the
	-- mobile DASH hides) RUN is the right thumb's third key (Pitch 2 item 1b, option C "Three buttons", the owner's pick
	-- 2026-11-20: .superpowers/slop-audit/round3/build/PITCH2/A_battle_hud/repitch/repitch_01b.py layout_C), 48 px (60 on a
	-- big screen): straight above the jump button on a wide screen, left of it on a tall one; the battle's MOVE and DASH go
	-- round it (BattleController Hud.ClusterLayout)
	local runSize = small and 58 or 72
	if dashKeys then
		local s = small and 1 or 1.25
		runSize = math.floor(48 * s + 0.5)
		local runRight = math.max(14, jump + 10 - runSize * 0.5)
		local runBottom = jumpTop + math.floor(16 * s + 0.5)
		if h > w then
			runRight = jumpLeft + math.floor(20 * s + 0.5)
			runBottom = jumpBottom + math.floor(4 * s + 0.5)
		end
		fitKey(m.run, runSize)
		m.run.Button.Position = UDim2.new(1, -runRight, 1, -runBottom)
		m.dash.Button.Visible = false
		m.rects = {
			jump = { jumpRect[1] + 4, jumpRect[2] + 4, jumpRect[3] - 4, jumpRect[4] - 4 },
			run = { w - runRight - runSize, runBottom, w - runRight, runBottom + runSize },
		}
		return
	end
	m.dash.Button.Visible = true
	local candidates = {
		{ jumpLeft + 12, jumpBottom + 4 }, -- beside the jump button
		{ dashRight + dashSize + 12, jumpTop + 6 }, -- diagonal: above-left of the jump button
		{ dashRight, dashBottom + dashSize + 10 }, -- on top of DASH
	}
	local runRight, runBottom = candidates[3][1], candidates[3][2]
	for _, c in ipairs(candidates) do
		local rect = { w - c[1] - runSize, c[2], w - c[1], c[2] + runSize }
		local onScreen = rect[1] >= 6 and rect[4] <= h - 80
		if onScreen
			and not rectsOverlap(rect, hotbar)
			and not rectsOverlap(rect, vitals)
			and not rectsOverlap(rect, jumpRect)
			and not rectsOverlap(rect, dashRect)
		then
			runRight, runBottom = c[1], c[2]
			break
		end
	end

	fitKey(m.dash, dashSize)
	m.dash.Button.Position = UDim2.new(1, -dashRight, 1, -dashBottom)
	fitKey(m.run, runSize)
	m.run.Button.Position = UDim2.new(1, -runRight, 1, -runBottom)
	m.rects = {
		jump = { jumpRect[1] + 4, jumpRect[2] + 4, jumpRect[3] - 4, jumpRect[4] - 4 },
		run = { w - runRight - runSize, runBottom, w - runRight, runBottom + runSize },
		dash = dashRect,
	}
end

local function buildMobileControls(playerGui)
	local gui = Instance.new("ScreenGui")
	gui.Name = "MobileControls"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 4
	gui.Enabled = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	-- an arc above / left of the default jump button, within thumb reach; the exact offsets depend on the
	-- size of Roblox's jump button and on the HUD, so layoutMobileControls places (and sizes) them below
	-- (kit-b U9-8) colour by role: DASH the sky (the dash's colour: the HUD's dash key, the battle DASH), RUN the stone tile
	-- with the bolt of the stamina it spends (gold while it is on)
	local Sign = Theme.Sign
	local dashButton = makeKeyButton(gui, "DashButton", "DASH", "dash", 76, UDim2.new(1, -30, 1, -175), { Face = Sign.Sky, Lip = Sign.SkyLip, Ink = Sign.Text }, function()
		tryDash()
	end)
	local runButton = makeKeyButton(gui, "RunButton", "RUN", "bolt", 64, UDim2.new(1, -120, 1, -150), { Face = Sign.Tile, Lip = Sign.StoneLip, Ink = Sign.Text }, function()
		toggleRun()
	end)

	local controls = {
		Gui = gui,
		dash = dashButton,
		run = runButton,
		locked = nil,
		runOn = nil,
		lowStamina = nil,
	}
	layoutMobileControls(controls)

	-- re-lay out when the viewport changes (rotation, window resize, foldables); the gui is built
	-- once and never destroyed, so the only connection to manage is the one on the current camera
	local cameraConn = nil
	local function bindCamera()
		if cameraConn then
			cameraConn:Disconnect()
			cameraConn = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				layoutMobileControls(controls)
			end)
		end
		layoutMobileControls(controls)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()

	gui.Parent = playerGui
	return controls
end

-- Called every frame from the character step; only touches properties that changed (paintKey skips an unchanged key).
-- (kit-b U9-8) DASH: the Off key while locked or short of stamina, sunk with its charge while it cools down, else ready;
-- RUN: the Off key while locked, gold while running is on
local function updateMobileUi(locked)
	local m = ui and ui.mobile
	if not m then
		return
	end
	local cd = MovementController.GetDashCooldownFraction()
	local lowStamina = (not freeDash) and stamina < P.DashStaminaCost
	local dashState = "ready"
	if locked or lowStamina then
		dashState = "off"
	elseif cd > 0.001 then
		dashState = "cool"
	end
	setKeyState(m.dash, dashState, 1 - cd)
	local runState = "ready"
	if locked then
		runState = "off"
	elseif runToggled then
		runState = "on"
	end
	setKeyState(m.run, runState)
	m.locked, m.runOn, m.lowStamina = locked, runToggled, lowStamina
end

local function buildGui()
	local playerGui = LocalPlayer:WaitForChild("PlayerGui", 30)
	if not playerGui then
		return
	end
	local built = { flashToken = 0 }
	local okLines, holder, lines = pcall(buildSpeedLines, playerGui)
	if okLines then
		built.holder = holder
		built.lines = lines
	else
		warn("[MovementController] speed lines failed: " .. tostring(holder))
	end
	if UserInputService.TouchEnabled then
		local okMobile, mobile = pcall(buildMobileControls, playerGui)
		if okMobile then
			built.mobile = mobile
		else
			warn("[MovementController] mobile controls failed: " .. tostring(mobile))
		end
	end
	ui = built
	if ctx then
		setMobileVisible(true)
	end
end

----------------------------------------------------------------------
-- Character effects (trail, dust, bursts)
----------------------------------------------------------------------
local function newEmitter(parent, props)
	local emitter = Instance.new("ParticleEmitter")
	FxSprites.Apply(emitter, props.Sprite) -- props.Sprite: an FxSprites role (texture + flipbook)
	for key, value in pairs(props) do
		if key ~= "Sprite" then
			emitter[key] = value
		end
	end
	emitter.Parent = parent
	return emitter
end

-- Builds everything under the HumanoidRootPart; returns the fx table and a list to destroy.
local function buildCharacterFx(humanoid, root)
	local fx = {}
	local instances = {}

	local feetOffset = 3
	if humanoid.RigType == Enum.HumanoidRigType.R15 then
		feetOffset = humanoid.HipHeight + root.Size.Y * 0.5
	end
	feetOffset = Util.Clamp(feetOffset, 2, 5)

	local feet = Instance.new("Attachment")
	feet.Name = "NC_Feet"
	feet.Position = Vector3.new(0, -feetOffset + 0.15, 0)
	feet.Parent = root
	table.insert(instances, feet)

	-- soft footstep dust (toggled while running on the ground)
	fx.dust = newEmitter(feet, {
		Name = "NC_RunDust",
		Sprite = "Puff",
		Color = ColorSequence.new(Theme.Colors.Cloud, Theme.Colors.CloudShade),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.6),
			NumberSequenceKeypoint.new(1, 2.2),
		}),
		Lifetime = NumberRange.new(0.35, 0.65),
		Speed = NumberRange.new(1, 3),
		SpreadAngle = Vector2.new(35, 35),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-45, 45),
		Acceleration = Vector3.new(0, 3, 0),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 0.15,
		LockedToPart = false,
		Rate = 20,
		Enabled = false,
	})

	-- bigger puff for landings and the dash take-off (manual :Emit only)
	fx.puff = newEmitter(feet, {
		Name = "NC_Puff",
		Sprite = "Puff",
		Color = ColorSequence.new(Theme.Colors.Cloud, Theme.Colors.CloudShade),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 3.4),
		}),
		Lifetime = NumberRange.new(0.4, 0.7),
		Speed = NumberRange.new(6, 11),
		SpreadAngle = Vector2.new(80, 80),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Drag = 3,
		Acceleration = Vector3.new(0, 2, 0),
		EmissionDirection = Enum.NormalId.Top,
		LightEmission = 0.1,
		LockedToPart = false,
		Rate = 0,
		Enabled = false,
	})

	-- sparkle burst for the dash
	fx.sparks = newEmitter(root, {
		Name = "NC_DashSparks",
		Sprite = "Sparkle",
		Color = ColorSequence.new(Theme.Colors.White, Theme.Colors.Stamina),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.9),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		LightEmission = 1,
		LockedToPart = false,
		Rate = 0,
		Enabled = false,
	})
	table.insert(instances, fx.dust)
	table.insert(instances, fx.puff)
	table.insert(instances, fx.sparks)

	-- trail through the torso, only enabled while dashing
	local top = Instance.new("Attachment")
	top.Name = "NC_TrailTop"
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "NC_TrailBottom"
	bottom.Position = Vector3.new(0, -1.4, 0)
	bottom.Parent = root
	table.insert(instances, top)
	table.insert(instances, bottom)

	local trail = Instance.new("Trail")
	trail.Name = "NC_DashTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.32
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 0.7
	trail.Color = ColorSequence.new(Theme.Colors.White, Theme.Colors.Stamina)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	trail.Enabled = false
	trail.Parent = root
	fx.trail = trail
	table.insert(instances, trail)

	return fx, instances
end

----------------------------------------------------------------------
-- Dash
----------------------------------------------------------------------
-- Horizontal unit vector: move input if any, else the camera look, else the body facing.
-- Second return value tells whether the player was actually steering.
local function computeDashDirection(humanoid, root)
	local md = humanoid.MoveDirection
	local flat = Vector3.new(md.X, 0, md.Z)
	if flat.Magnitude > MOVE_EPS then
		return flat.Unit, true
	end
	local camera = workspace.CurrentCamera
	if camera then
		local look = camera.CFrame.LookVector
		flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.05 then
			return flat.Unit, false
		end
	end
	local facing = root.CFrame.LookVector
	flat = Vector3.new(facing.X, 0, facing.Z)
	if flat.Magnitude > 0.05 then
		return flat.Unit, false
	end
	return Vector3.new(0, 0, 1), false
end

-- Returns nil when a dash may start, otherwise a short reason string.
local function dashBlockedReason()
	local c = ctx
	if not c then
		return "nochar"
	end
	local humanoid = c.humanoid
	if humanoid.Health <= 0 or humanoid.Sit or humanoid.PlatformStand then
		return "state"
	end
	if isLocked() then
		return "locked"
	end
	if cinematic then
		return "cinematic"
	end
	if dash then
		return "dashing"
	end
	if os.clock() < cooldownEnd then
		return "cooldown"
	end
	if not freeDash and stamina < P.DashStaminaCost then
		return "stamina"
	end
	return nil
end

-- Stop the dash. Normally the character is handed a sane post-dash speed so it does not keep
-- flying at DashSpeed (the course generator assumes the dash ends at run speed). With halt = true
-- (Downed / frozen by the server) the horizontal velocity is simply cancelled.
local function endDash(halt)
	local d = dash
	if not d then
		return
	end
	dash = nil
	local c = ctx
	if not c then
		return
	end
	local root = c.root
	local humanoid = c.humanoid
	if not root.Parent or humanoid.Health <= 0 then
		return
	end
	local exitSpeed = 0
	if not halt then
		exitSpeed = humanoid.WalkSpeed
		if humanoid.FloorMaterial == Enum.Material.Air then
			exitSpeed = math.max(exitSpeed, P.RunSpeed)
		end
		exitSpeed = math.min(exitSpeed, P.DashSpeed)
	end
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(d.dir.X * exitSpeed, v.Y, d.dir.Z * exitSpeed)
end

local function playDashFx(c)
	local fx = c.fx
	local now = os.clock()
	if fx.trail then
		fx.trail.Enabled = true
		c.trailOffAt = now + P.DashDuration + 0.06
	end
	if fx.puff then
		fx.puff:Emit(8)
	end
	if fx.sparks then
		fx.sparks:Emit(10)
	end
	flashSpeedLines()
end

function tryDash()
	if petDash then
		return false -- a battle: Shift / B are the pet's dash (onDashAction), the character never dashes
	end
	local reason = dashBlockedReason()
	if reason == "cooldown" then
		-- queue a press that arrives just before the cooldown ends so it still feels instant
		local now = os.clock()
		if cooldownEnd - now <= DASH_BUFFER and (freeDash or stamina >= P.DashStaminaCost) then
			dashBufferUntil = now + DASH_BUFFER
		end
		return false
	elseif reason == "stamina" then
		denyFeedback(ui and ui.mobile and ui.mobile.dash)
		return false
	elseif reason ~= nil then
		return false
	end

	local c = ctx
	local humanoid = c.humanoid
	local root = c.root
	local now = os.clock()
	local dir, steering = computeDashDirection(humanoid, root)

	if not freeDash and not staminaFree(root) then
		stamina = stamina - P.DashStaminaCost
		if stamina <= 0 then
			stamina = 0
			exhausted = true
			runToggled = false
		end
		regenBlockedUntil = now + DASH_REGEN_DELAY
	end
	dashLength = (freeDash and freeDashCooldown) or P.DashCooldown
	cooldownEnd = now + dashLength
	dashBufferUntil = 0
	dash = { dir = dir, startTime = now, endTime = now + P.DashDuration }
	punchStart = now
	mirrorStamina(false)

	-- face the dash when the player was not steering (the humanoid already turns toward input)
	if not steering then
		local pos = root.Position
		root.CFrame = CFrame.new(pos, pos + dir)
	end
	-- apply immediately so the press feels instant; Stepped keeps re-asserting it afterwards
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(dir.X * P.DashSpeed, v.Y, dir.Z * P.DashSpeed)

	playDashFx(c)
	if dashRemote then
		pcall(function()
			dashRemote:FireServer()
		end)
	end
	if dashListener then
		local ok, err = pcall(dashListener)
		if not ok then
			warn("[MovementController] dash listener failed: " .. tostring(err))
		end
	end
	return true
end

-- Runs just before every physics step while a character is bound.
local function onStepped()
	local d = dash
	if not d then
		return
	end
	local c = ctx
	if not c or not c.root.Parent then
		dash = nil
		return
	end
	if isLocked() then
		endDash(true)
		return
	end
	if os.clock() >= d.endTime then
		endDash(false)
		return
	end
	local root = c.root
	local v = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(d.dir.X * P.DashSpeed, v.Y, d.dir.Z * P.DashSpeed)
end

----------------------------------------------------------------------
-- Per-frame update (run, stamina, effects, camera)
----------------------------------------------------------------------
local function dashPunchValue(now)
	local t = now - punchStart
	if t < 0 or t >= PUNCH_TOTAL then
		return 0
	end
	if t < PUNCH_ATTACK then
		return t / PUNCH_ATTACK
	end
	local u = (t - PUNCH_ATTACK) / (PUNCH_TOTAL - PUNCH_ATTACK)
	return 1 - u * u * (3 - 2 * u) -- smoothstep release
end

local function step(dt)
	local c = ctx
	if not c then
		return
	end
	local humanoid = c.humanoid
	local root = c.root
	if not humanoid.Parent or not root.Parent or humanoid.Health <= 0 then
		unbindCharacter()
		return
	end
	local now = os.clock()
	dt = Util.Clamp(dt, 0, 0.1)

	-- 1. Whatever WalkSpeed we did not write ourselves belongs to the server (freeze, revive...). In a battle the
	--    battle walk is the base instead, but a server freeze (0) still wins.
	local current = humanoid.WalkSpeed
	if lastWritten == nil or math.abs(current - lastWritten) > SPEED_EPS then
		serverSpeed = current
		lastWritten = nil
	end
	baseSpeed = serverSpeed
	if battleSpeed and serverSpeed >= FROZEN_SPEED then
		baseSpeed = battleSpeed.walk
	end
	if cinematic and serverSpeed >= FROZEN_SPEED then
		baseSpeed = cinematic
	end

	-- 2. Lockout: Downed or frozen players cannot run or dash (nor during a scripted walk-in).
	local locked = isLocked() or cinematic ~= nil
	if locked then
		if dash then
			endDash(true)
		end
		runToggled = false
		runBlend = 0 -- snap back to the server's speed immediately
		dashBufferUntil = 0
	end

	-- 3. Run + stamina (none spent in the lobby: the bar is full there).
	local free = staminaFree(root)
	if free then
		stamina = P.MaxStamina
		exhausted = false
	end
	local moving = humanoid.MoveDirection.Magnitude > MOVE_EPS
	local wantsRun = (shiftHeld or runToggled) and not locked
	local running = wantsRun and moving and not exhausted and stamina > 0 and not humanoid.Sit
	if dash then
		running = false
	end
	if free then
		regenBlockedUntil = 0
	elseif running then
		stamina = stamina - P.RunStaminaDrain * dt
		regenBlockedUntil = math.max(regenBlockedUntil, now + RUN_REGEN_DELAY)
		if stamina <= 0 then
			stamina = 0
			exhausted = true
			runToggled = false
			running = false
		end
	elseif now >= regenBlockedUntil then
		stamina = math.min(P.MaxStamina, stamina + P.StaminaRegen * regenMul * dt)
	end
	if exhausted and stamina >= EXHAUST_RESUME then
		exhausted = false
	end
	mirrorStamina(false)

	-- 4. Smooth run blend (held steady while dashing so the speed does not dip afterwards).
	if not dash then
		local target = 0
		if running then
			target = 1
		end
		local rate = RUN_RAMP_DOWN
		if target > runBlend then
			rate = RUN_RAMP_UP
		end
		runBlend = runBlend + (target - runBlend) * (1 - math.exp(-rate * dt))
		if math.abs(target - runBlend) < 0.005 then
			runBlend = target
		end
	end

	-- 5. Write WalkSpeed: base speed + run boost (the battle run instead of RunSpeed in a battle), times the dev speed.
	--    Outside a battle it stops touching it when not running; in a battle the walk itself is ours to write.
	local speedMult = devSpeedMult()
	if baseSpeed >= FROZEN_SPEED and (runBlend > 0.001 or battleSpeed ~= nil or cinematic ~= nil or speedMult ~= 1) then
		local runTarget = (cinematic and baseSpeed) or (battleSpeed and battleSpeed.run) or math.max(baseSpeed, P.RunSpeed)
		local speed = (baseSpeed + (runTarget - baseSpeed) * runBlend) * speedMult
		if lastWritten == nil or math.abs(speed - lastWritten) > 0.001 or math.abs(current - speed) > SPEED_EPS then
			humanoid.WalkSpeed = speed
			lastWritten = speed
		end
	elseif lastWritten ~= nil then
		humanoid.WalkSpeed = baseSpeed
		lastWritten = nil
	end

	-- 6. Dash end (Stepped normally does this; this is the safety net) and queued dash.
	if dash and now >= dash.endTime then
		endDash(false)
	end
	if dashBufferUntil > 0 then
		if now >= dashBufferUntil then
			dashBufferUntil = 0
		elseif now >= cooldownEnd and not dash then
			dashBufferUntil = 0
			tryDash()
		end
	end

	-- 7. Effects: trail off, dust, landing puff.
	local fx = c.fx
	if fx.trail and fx.trail.Enabled and not dash and now >= c.trailOffAt then
		fx.trail.Enabled = false
	end
	local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	local wantDust = grounded and moving and runBlend > 0.5
	if wantDust ~= c.dustOn then
		c.dustOn = wantDust
		fx.dust.Enabled = wantDust
	end
	local vy = root.AssemblyLinearVelocity.Y
	if grounded and not c.wasGrounded and c.lastVy < -30 then
		fx.puff:Emit(Util.Clamp(math.floor(-c.lastVy / 8), 3, 10))
	end
	c.wasGrounded = grounded
	c.lastVy = vy

	-- 8. Camera FOV: widen while running, punch on dash.
	local camera = workspace.CurrentCamera
	if camera then
		local fov = fovOverride or (BASE_FOV + RUN_FOV_BOOST * runBlend + DASH_FOV_BOOST * dashPunchValue(now))
		local fp = fovPunch
		if fp then
			local p = (now - fp.t0) / fp.dur
			if p >= 1 or p < 0 then
				fovPunch = nil
			else
				fov = fov + fp.amount * (1 - p) * (1 - p)
			end
		end
		if c.lastFov == nil or math.abs(fov - c.lastFov) > 0.01 then
			camera.FieldOfView = fov
			c.lastFov = fov
		end
	end

	-- 9. Mobile button visuals.
	updateMobileUi(locked)
end

----------------------------------------------------------------------
-- Character lifecycle
----------------------------------------------------------------------
function unbindCharacter()
	bindToken = bindToken + 1 -- cancels any bind that is still waiting for children
	local c = ctx
	if not c then
		return
	end
	ctx = nil -- first, so re-entrant calls (Died + CharacterRemoving) are harmless

	dash = nil
	dashBufferUntil = 0
	runToggled = false
	runBlend = 0

	for _, conn in ipairs(c.conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	c.conns = {}

	-- give the server's WalkSpeed back untouched if we had it overridden
	if lastWritten ~= nil then
		pcall(function()
			if c.humanoid.Parent then
				c.humanoid.WalkSpeed = serverSpeed
			end
		end)
	end
	lastWritten = nil

	for _, inst in ipairs(c.instances) do
		pcall(function()
			inst:Destroy()
		end)
	end
	c.instances = {}

	fovPunch = nil
	local camera = workspace.CurrentCamera
	if camera and c.lastFov ~= nil and c.lastFov ~= BASE_FOV and fovOverride == nil then
		pcall(function()
			camera.FieldOfView = BASE_FOV
		end)
	end
	setMobileVisible(false)
end

local function bindCharacter(char)
	unbindCharacter()
	local token = bindToken

	local humanoid = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if token ~= bindToken then
		return -- a newer bind/unbind happened while we waited
	end
	if not humanoid or not root or not humanoid:IsA("Humanoid") or not root:IsA("BasePart") then
		return
	end
	if humanoid.Health <= 0 or not char:IsDescendantOf(game) then
		return
	end

	-- fresh state for this life
	stamina = P.MaxStamina
	exhausted = false
	runToggled = false
	runBlend = 0
	serverSpeed = humanoid.WalkSpeed
	baseSpeed = serverSpeed
	if battleSpeed and serverSpeed >= FROZEN_SPEED then
		baseSpeed = battleSpeed.walk
	end
	lastWritten = nil
	regenBlockedUntil = 0
	dashBufferUntil = 0
	dash = nil
	mirrorStamina(true)
	applyCameraSettings()

	local fx, instances = buildCharacterFx(humanoid, root)
	local c = {
		char = char,
		humanoid = humanoid,
		root = root,
		conns = {},
		instances = instances,
		fx = fx,
		dustOn = false,
		wasGrounded = true,
		lastVy = 0,
		trailOffAt = 0,
		lastFov = nil,
	}
	ctx = c

	table.insert(c.conns, RunService.Stepped:Connect(onStepped))
	table.insert(c.conns, RunService.RenderStepped:Connect(step))
	table.insert(c.conns, humanoid.Died:Connect(function()
		if ctx == c then
			unbindCharacter()
		end
	end))
	table.insert(c.conns, char.AncestryChanged:Connect(function()
		if ctx == c and not char:IsDescendantOf(game) then
			unbindCharacter()
		end
	end))

	setMobileVisible(true)
end

----------------------------------------------------------------------
-- Input (ContextActionService)
----------------------------------------------------------------------
local function onRunAction(_name, state, input)
	local isToggleKey = input ~= nil and input.KeyCode == Enum.KeyCode.ButtonL3
	if state == Enum.UserInputState.Begin then
		if UserInputService:GetFocusedTextBox() ~= nil then
			return Enum.ContextActionResult.Pass
		end
		if not gateOpen() then
			return Enum.ContextActionResult.Pass -- the main menu is still up (7.2)
		end
		if isToggleKey then
			toggleRun()
		else
			shiftHeld = true
		end
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		if not isToggleKey then
			shiftHeld = false
		end
	end
	return Enum.ContextActionResult.Sink
end

local function onDashAction(_name, state)
	if state == Enum.UserInputState.Begin then
		if not gateOpen() then
			return Enum.ContextActionResult.Pass -- the main menu is still up (7.2)
		end
		if UserInputService:GetFocusedTextBox() == nil then
			local fn = petDash
			if fn then
				local ok, err = pcall(fn) -- the pet dashes (BattleCommand "Dash"); no impulse, no stamina
				if not ok then
					warn("[MovementController] pet dash failed: " .. tostring(err))
				end
			else
				tryDash()
			end
		end
	end
	return Enum.ContextActionResult.Sink
end

local unpackList = table.unpack or unpack

local DEFAULT_RUN_KEYS = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3 }
local DEFAULT_DASH_KEYS = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB }

-- the run keys that do not dash (Shift dashes in a battle: RUN moves to Ctrl there)
local function runKeys()
	if not dashKeys then
		return DEFAULT_RUN_KEYS
	end
	local taken = {}
	for _, k in ipairs(dashKeys) do
		taken[k] = true
	end
	local out = {}
	for _, k in ipairs(DEFAULT_RUN_KEYS) do
		if not taken[k] then
			out[#out + 1] = k
		end
	end
	if taken[Enum.KeyCode.LeftShift] or taken[Enum.KeyCode.RightShift] then
		out[#out + 1] = Enum.KeyCode.LeftControl
	end
	return out
end

local function bindKeys()
	pcall(function()
		ContextActionService:UnbindAction("NimbusRun")
	end)
	pcall(function()
		ContextActionService:UnbindAction("NimbusDash")
	end)
	-- High priority beats Roblox's shift-lock (Medium), so Shift is ours alone.
	ContextActionService:BindActionAtPriority("NimbusRun", onRunAction, false, Enum.ContextActionPriority.High.Value, unpackList(runKeys()))
	-- a battle's dash keys (Shift) need the High priority too (the run action had them before)
	local priority = dashKeys and Enum.ContextActionPriority.High.Value or Enum.ContextActionPriority.Default.Value
	ContextActionService:BindActionAtPriority("NimbusDash", onDashAction, false, priority, unpackList(dashKeys or DEFAULT_DASH_KEYS))
end

local function bindInput()
	bindKeys()

	-- never leave Shift "stuck" when focus moves away from the game
	UserInputService.WindowFocusReleased:Connect(function()
		shiftHeld = false
	end)
	UserInputService.TextBoxFocused:Connect(function()
		shiftHeld = false
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function MovementController.GetDashCooldownFraction()
	local remaining = cooldownEnd - os.clock()
	if remaining <= 0 then
		return 0
	end
	return Util.Clamp(remaining / math.max(0.05, dashLength), 0, 1)
end

----------------------------------------------------------------------
-- Phase 5 battle switches (BattleController; contract 3.9 / 4.4)
----------------------------------------------------------------------
local function finite(v)
	return type(v) == "number" and v == v and v > -math.huge and v < math.huge
end

-- keys: a list of Enum.KeyCode (in battle { LeftShift, RightShift, ButtonB }); nil restores the obby keys (Q / B)
function MovementController.SetDashKeys(keys)
	local list = nil
	if type(keys) == "table" then
		list = {}
		for _, k in ipairs(keys) do
			if typeof(k) == "EnumItem" then
				list[#list + 1] = k
			end
		end
		if #list == 0 then
			list = nil
		end
	end
	dashKeys = list
	shiftHeld = false -- Shift may have just changed hands
	if initialized then
		pcall(bindKeys)
	end
	-- the battle cluster has its own DASH button: the mobile one steps aside while a battle owns the dash keys and
	-- RUN takes its spot above the jump button (layoutMobileControls)
	local m = ui and ui.mobile
	if m and m.dash and m.dash.Button then
		m.dash.Button.Visible = dashKeys == nil
		pcall(layoutMobileControls, m)
	end
end

-- fn: the battle's pet dash (BattleController: BattleCommand "Dash"); Shift / RightShift / B call it and nothing else
-- (no character impulse, no stamina, no dash cooldown), RUN moves to Ctrl. nil: the obby keys again (Q / B dash,
-- Shift runs)
function MovementController.SetPetDash(fn)
	petDash = type(fn) == "function" and fn or nil
	if petDash and dash then
		endDash(false) -- a dash that was running when the battle started ends now
	end
	MovementController.SetDashKeys(petDash and PET_DASH_KEYS or nil)
end

-- the touch buttons in screen px { left, bottom, right, top } (from the left / BOTTOM edge): jump (Roblox's), run,
-- dash (nil in a battle); nil without the mobile controls
-- (kit-b gate U9 r4) a modal card hides the RUN / DASH touch buttons while it shows: `who` names it, on = true holds them
-- off; they come back as the movement state wants them when the last hold lets go
function MovementController.SetMobileHidden(who, on)
	MobileHolds[type(who) == "string" and who or "?"] = (on == true) or nil
	setMobileVisible(MobileWanted)
end

function MovementController.MobileLayout()
	local m = ui and ui.mobile
	return m and m.rects or nil
end

-- (tests, kit B U9-9 review) smoke_kitb_ui runs its phone sizes in the desktop client world, where buildGui made no touch
-- buttons: on = build them there once (as a touch boot does, laid out for the current screen) and show them; off = take
-- the ones built here out of the PlayerGui again (kept for the next call; a touch boot's own are never touched).
-- -> the MobileControls gui (nil while off, or before buildGui ran)
local parkedMobile = nil
function MovementController._TouchButtons(on)
	if not ui then
		return nil
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if on and not ui.mobile and playerGui then
		if parkedMobile then
			ui.mobile, parkedMobile = parkedMobile, nil
			ui.mobile.Gui.Parent = playerGui
		else
			ui.mobile = buildMobileControls(playerGui)
			ui.mobile.ForTests = true
		end
		layoutMobileControls(ui.mobile)
		setMobileVisible(true)
	elseif not on and ui.mobile and ui.mobile.ForTests then
		parkedMobile, ui.mobile = ui.mobile, nil
		parkedMobile.Gui.Parent = nil
	end
	return ui.mobile and ui.mobile.Gui or nil
end

-- on: a dash costs no stamina (and never exhausts); cooldown: the dash cooldown meanwhile (the battle's DashCooldown)
function MovementController.SetFreeDash(on, cooldown)
	freeDash = on == true
	freeDashCooldown = (freeDash and finite(cooldown) and cooldown > 0) and math.min(cooldown, 30) or nil
end

-- walk / run: the fighter's legal battle speeds (BattleCatalog.Fighter.WalkOf / RunOf, the Speed events); nil clears
function MovementController.SetBattleSpeed(walk, run)
	if not finite(walk) or walk <= 0 then
		battleSpeed = nil
	else
		walk = Util.Clamp(walk, 1, 100)
		if not finite(run) or run <= 0 then
			run = walk * 1.3
		end
		battleSpeed = { walk = walk, run = Util.Clamp(math.max(run, walk), 1, 100) }
	end
	-- apply at once (no frame of the old speed)
	local c = ctx
	if not c or not c.humanoid or not c.humanoid.Parent then
		return
	end
	local humanoid = c.humanoid
	local current = humanoid.WalkSpeed
	if lastWritten == nil or math.abs(current - lastWritten) > SPEED_EPS then
		serverSpeed = current -- a server write since our last one
		lastWritten = nil
	end
	if serverSpeed < FROZEN_SPEED then
		return -- frozen / Downed: the server's 0 wins
	end
	if battleSpeed then
		baseSpeed = battleSpeed.walk
		local speed = baseSpeed + (battleSpeed.run - baseSpeed) * runBlend
		humanoid.WalkSpeed = speed
		lastWritten = speed
	else
		baseSpeed = serverSpeed
		if lastWritten ~= nil then
			local speed = baseSpeed
			if runBlend > 0.001 then
				speed = baseSpeed + (math.max(baseSpeed, P.RunSpeed) - baseSpeed) * runBlend
				lastWritten = speed
			else
				lastWritten = nil
			end
			humanoid.WalkSpeed = speed
		end
	end
end

-- the battle DASH button: the same dash as the dash key (-> bool)
function MovementController.TryDash()
	if not gateOpen() then
		return false
	end
	return tryDash() == true
end

-- fn() runs after every dash (nil clears it)
function MovementController.SetDashListener(fn)
	dashListener = type(fn) == "function" and fn or nil
end

-- bug batch 2 (#19): n caps the camera zoom (DungeonController: 14 in a run); nil restores ZOOM_MAX. Junk is ignored.
function MovementController.SetZoomMax(n)
	if n == nil then
		zoomMax = ZOOM_MAX
	elseif finite(n) and n > 0 then
		zoomMax = Util.Clamp(n, 0.5, 400)
	else
		return zoomMax
	end
	if LocalPlayer then
		applyCameraSettings()
	end
	return zoomMax
end

-- tests / tools: the speed ownership state
function MovementController.GetSpeedState()
	return {
		Server = serverSpeed,
		Base = baseSpeed,
		Walk = battleSpeed and battleSpeed.walk or nil,
		Run = battleSpeed and battleSpeed.run or nil,
		RunTarget = battleSpeed and battleSpeed.run or math.max(baseSpeed, P.RunSpeed),
		FreeDash = freeDash,
		DashCooldown = (freeDash and freeDashCooldown) or P.DashCooldown,
		DashKeys = dashKeys,
		PetDash = petDash ~= nil,
		Stamina = stamina,
		ExhaustResume = EXHAUST_RESUME,
		Written = lastWritten,
		Cinematic = cinematic ~= nil,
		FovOverride = fovOverride,
		StaminaFree = ctx ~= nil and staminaFree(ctx.root),
		DevSpeed = devSpeedMult() ~= 1,
	}
end

-- wave 5 (bugs #15 / #26): the cinematics' FOV (nil = 70 + run + dash again); written at once when a character is bound
function MovementController.SetFovOverride(fov)
	if not finite(fov) then
		fovOverride = nil
	else
		fovOverride = Util.Clamp(fov, 20, 110)
	end
	local camera = workspace.CurrentCamera
	local c = ctx
	if camera and fovOverride then
		pcall(function()
			camera.FieldOfView = fovOverride
		end)
		if c then
			c.lastFov = fovOverride
		end
	elseif c then
		c.lastFov = nil -- (the next frame writes the normal FOV)
	elseif camera then
		pcall(function()
			camera.FieldOfView = BASE_FOV -- (no character bound: no frame will write it back)
		end)
	end
end

-- a quick zoom punch (big attacks in a dungeon): + degrees, easing out over `seconds`; the larger of two live punches wins
function MovementController.FovPunch(degrees, seconds)
	if not finite(degrees) or degrees <= 0 then
		return false
	end
	seconds = (finite(seconds) and seconds > 0) and math.min(seconds, 2) or 0.25
	local now = os.clock()
	local live = fovPunch
	if live then
		local p = (now - live.t0) / live.dur
		if p >= 0 and p < 1 and live.amount * (1 - p) * (1 - p) >= degrees then
			return false
		end
	end
	fovPunch = { amount = math.min(degrees, 20), t0 = now, dur = seconds }
	return true
end

-- a scripted walk (the room walk-in): WalkSpeed = walkSpeed, run / dash ignored; nil gives the normal rules back at once
function MovementController.SetCinematic(walkSpeed)
	if not finite(walkSpeed) or walkSpeed <= 0 then
		if cinematic == nil then
			return
		end
		cinematic = nil
		local c = ctx
		if c and c.humanoid and c.humanoid.Parent and lastWritten ~= nil then
			local current = c.humanoid.WalkSpeed
			if math.abs(current - lastWritten) <= SPEED_EPS then
				baseSpeed = (battleSpeed and serverSpeed >= FROZEN_SPEED) and battleSpeed.walk or serverSpeed
				c.humanoid.WalkSpeed = baseSpeed
				lastWritten = battleSpeed and baseSpeed or nil
			end
		end
		return
	end
	cinematic = Util.Clamp(walkSpeed, 1, 100)
	runToggled = false
	runBlend = 0
	if dash then
		endDash(true)
	end
	local c = ctx
	if not c or not c.humanoid or not c.humanoid.Parent then
		return
	end
	local humanoid = c.humanoid
	local current = humanoid.WalkSpeed
	if lastWritten == nil or math.abs(current - lastWritten) > SPEED_EPS then
		serverSpeed = current
		lastWritten = nil
	end
	if serverSpeed < FROZEN_SPEED then
		return -- frozen / Downed: the server's 0 wins
	end
	baseSpeed = cinematic
	humanoid.WalkSpeed = cinematic
	lastWritten = cinematic
end

-- kit-b O4 (finding 12): course help text that names keys (Config.Course.Help, one text per device). A label with the
-- help tag and a HelpKey (CourseBuilder: the HOW TO CLIMB board, the DASH! hints) reads the text of the device in use,
-- and every one is swapped when the player changes device.
local HELP = Config.Course and Config.Course.Help
local helpDevice = "Keyboard"

-- "Keyboard" (keys and the mouse), "Touch" or "Gamepad" for an input type; nil for one that says nothing about the
-- device (text input, focus, sensors). None (nothing pressed yet): what the client has (a touch-only screen is Touch).
function MovementController.HelpDevice(inputType)
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	end
	local name = inputType and inputType.Name or "None"
	if string.sub(name, 1, 7) == "Gamepad" then
		return "Gamepad"
	elseif name == "Keyboard" or string.sub(name, 1, 5) == "Mouse" then
		return "Keyboard"
	elseif name == "None" then
		if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
			return "Touch"
		elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
			return "Gamepad"
		end
		return "Keyboard"
	end
	return nil
end

local function applyHelp(label)
	local set = HELP[label:GetAttribute("HelpKey")]
	if type(set) == "table" and label:IsA("TextLabel") then
		local text = set[helpDevice] or set.Keyboard
		if type(text) == "string" then
			label.Text = text
		end
	end
end

local function startHelpText()
	if type(HELP) ~= "table" or type(HELP.Tag) ~= "string" then
		return
	end
	local CollectionService = game:GetService("CollectionService")
	helpDevice = MovementController.HelpDevice(UserInputService:GetLastInputType()) or "Keyboard"
	CollectionService:GetInstanceAddedSignal(HELP.Tag):Connect(applyHelp)
	for _, label in ipairs(CollectionService:GetTagged(HELP.Tag)) do
		applyHelp(label)
	end
	UserInputService.LastInputTypeChanged:Connect(function(inputType)
		local device = MovementController.HelpDevice(inputType)
		if device and device ~= helpDevice then
			helpDevice = device
			for _, label in ipairs(CollectionService:GetTagged(HELP.Tag)) do
				applyHelp(label)
			end
		end
	end)
end

function MovementController.Init()
	if initialized then
		return
	end
	initialized = true
	if not LocalPlayer then
		return
	end

	stamina = P.MaxStamina
	mirrorStamina(true)
	applyCameraSettings()
	bindInput()
	local okHelp, errHelp = pcall(startHelpText)
	if not okHelp then
		warn("[MovementController] course help text: " .. tostring(errHelp))
	end

	refreshRegenPerk()
	LocalPlayer:GetAttributeChangedSignal(ATTR.PerkStaminaRegen):Connect(refreshRegenPerk)

	-- Remotes.Get yields until the folder replicates, so never block Init on it
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "Dash")
		if ok then
			dashRemote = remote
		else
			warn("[MovementController] Dash remote unavailable: " .. tostring(remote))
		end
	end)
	task.spawn(buildGui)

	LocalPlayer.CharacterAdded:Connect(function(char)
		bindCharacter(char)
	end)
	LocalPlayer.CharacterRemoving:Connect(function()
		unbindCharacter()
	end)
	if LocalPlayer.Character then
		task.spawn(bindCharacter, LocalPlayer.Character)
	end
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1152">
            <Properties>
              <string name="Name">NotifyController</string>
              <string name="Source"><![CDATA[-- NotifyController (client, v3): the game's side-of-screen voice. Nothing here is ever centred.
--
--   NotifyController.Init()
--   NotifyController.Toast(text, kind, duration) -> bool   (roll-look review round 1) a local toast exactly as the Notify
--                                    remote shows one (MenuController.Hint routes here while its NimbusMenu gui is off:
--                                    the egg stage's HUD hide)
--   NotifyController.SetHeld(who, on) (quick wins 2026-11-12, win 1) owner-keyed hold, like HudController.SetVitalsHidden:
--                                    while any owner holds (the main menu: "MainMenu", from Open until the PLAY fade
--                                    ends) every gameplay toast waits instead of showing (Notify remote and Toast alike).
--                                    Not held: "bad" (an error / a refusal), a Notify sent with opts.System (the
--                                    save-wait toasts) and "pull" (a chat line, posted at once). Identical held toasts
--                                    merge; up to HELD_MAX (16) distinct ones are kept, the oldest token / good one
--                                    dropped first and an opts.Keep one (the join welcome) last. When the last owner lets
--                                    go, the ones older than HELD_SECONDS (60) are dropped unless Keep, and the rest are
--                                    shown in the order sent, one every HELD_PACE (0.35 s) while the column has room.
--   NotifyController.IsHeld() -> bool  true while any owner holds
--
-- Remotes handled
--   Notify(text, kind, duration[, opts])  opts (optional table): System / Keep, see SetHeld above.
--                                 -> compact toast stack on the RIGHT edge, from the top (below the HUD currency
--                                    stack when that sits top-right on a short screen, and below the top-left
--                                    panel on a narrow one). Max 4, 250 design px wide, newest on top, slide in
--                                    from the right, `Toast` role font at the readable 18 px, a coloured accent
--                                    bar + icon by kind (info|good|bad|token). Identical toasts that are still
--                                    showing are merged into "text x2". A toast the column has no room for
--                                    (a short landscape phone fits one) waits and shows once room frees up.
--                                    Kind "pull" (lobby-shop spec 5.5, the server's Legendary+ hatch line
--                                    "<Name> hatched a <Rarity> <Pet>!") is a system chat line instead:
--                                    TextChatService.TextChannels.RBXSystem:DisplaySystemMessage, rich text
--                                    escaped, the rarity word in its Config.Rarities colour (Config.Eggs.ChatColors
--                                    overrides one: Secret's near-black is #B496FF on the dark chat, spec 16.5);
--                                    no channel (the legacy chat, not replicated yet) or an error -> a "good" toast.
--   MatchResult(result)           -> compact result card on the right edge (about 45% down): VICTORY!/DEFEAT in
--                                    the Title font with a gradient, difficulty + stars, time, tokens, bonus,
--                                    a small member list and a "Back to lobby in Ns" line. It closes when the
--                                    server clears MatchState (the player is back in the lobby), when the
--                                    player presses its X, or a few seconds after the countdown ends.
--                                    (U9-9 review) On a touch screen it stays clear of Roblox's jump button, the
--                                    touch RUN and the currency strip; the touch DASH lies wholly under it or wholly
--                                    clear (its taps pass through the card); where even the compact rows do not fit
--                                    (a 360 to 390 px tall landscape phone, a portrait phone above the centre band)
--                                    it is the mini card (no team, no difficulty line, 250 wide); the HUD's vitals
--                                    card steps aside under it.
--   MatchState(nil)               -> closes the result card.
--   DashFx(userId)                -> a cheap puff + trail on that player's character (own dashes are ignored,
--                                    MovementController already shows those).
--
-- kit B U9-9 (finding 15, the pitch's .toast; it was v5's neon pill): a toast is a kit B block like the HUD's currency
-- strips above it: the stone tile face, a 2 px wood edge, the darker stone lip along its bottom, square, no glow or
-- gradient; the kind's colour by role on a square chip in its left end (info sky + the bulb, good grass + the tick, bad red
-- + the x, token gold + the coin, with a pixel sparkle: a reward), the pixel icon on whole screen pixels at any scale
-- (client/UI/PixelCrisp), the text brown. A merged repeat flashes the face pale gold. The result card is a Signboard
-- CloudUI.Panel (wood frame, stone body, an awning as wide as the card): VICTORY! a gold banner block and DEFEAT a stone
-- one (plain Section titles: a pop-up's title, not a window's ribbon), the stats stone rows with brown values, the
-- member list brown with a tick / x chip, the footer brown; its confetti the kit's gold and pink bits (no rainbow).
-- The GUI is "NimbusNotify" (display order 30, IgnoreGuiInset = false). Sizes follow the v3 readability rule:
-- panels are designed in 1080p pixels and carry a UIScale of Theme.ScreenFactor() (same as the HUD), inside
-- full-screen holder frames whose UIPadding is the screen margin, so scaling never detaches them from the edge.
-- Where the HUD sits is read from the attributes HudController publishes on the NimbusHud gui.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the toast and result card icons

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local PixelCrisp = require(Client:WaitForChild("UI"):WaitForChild("PixelCrisp")) -- (kit B U9-9) whole-pixel icons

local NotifyController = {}

local LocalPlayer = Players.LocalPlayer

----------------------------------------------------------------------
-- Tuning (design px of a 1080p screen)
----------------------------------------------------------------------
-- toasts
local MAX_TOASTS = 4
local TOAST_W = 250
-- (U9-9 look) the column's rows in multiples of 5 design px, whole screen px at the phones' 0.8 and at 1080p (a UDim's
-- Offset is whole in Roblox, so 8 px of padding would draw 6.4): the gap, the padding, the lip
local TOAST_GAP = 10
local TOAST_PAD = 10
local TOAST_TEXT_SIZE = 18
local TOAST_TEXT_MIN = 25 -- a one-line toast's text row (the card is then 50 design px: 40 px at 0.8)
local TOAST_ICON = 30
local TOAST_BG = 0 -- (kit B U9-9) an opaque stone block
local TOAST_EDGE = 2 -- the wood edge (as the HUD's currency strips)
local TOAST_LIP = 5 -- the darker stone lip along the bottom (4 px at 0.8)
local TOAST_CHIP_LIP = 3 -- the chip's own lip
local TOAST_GLYPH = 18 -- the chip's pixel icon (2 px cells at 1080p)
local DEFAULT_DURATION = 3
local MIN_DURATION = 1.5
local MAX_DURATION = 8
local MAX_TOAST_CHARS = 90
local MIN_TOAST_H = 52 -- a one-line toast (design px)
-- a toast the screen had no room for (a short landscape phone fits one) waits and comes back when room frees up,
-- so two toasts sent together (/devhelp) are both read: up to WAIT_MAX wait, each for at most WAIT_SECONDS
local WAIT_MAX = 3
local WAIT_SECONDS = 20
local WAIT_MIN_SHOWN = 1.5 -- seconds a toast must have been readable before it may be pushed out for good
-- (quick wins, win 1; review round 1) toasts held by SetHeld (the title screen): parked, then shown one by one once the
-- hold ends, so nothing is cut. Identical held toasts merge ("x2"). Over HELD_MAX distinct ones the oldest low-value
-- one (HELD_LOW: token / good) goes first, then the oldest plain one; a Keep one (opts.Keep: the join welcome) last.
-- At release a held toast older than HELD_SECONDS is dropped as stale (a "Double Rewards in 2 minutes" line), unless Keep.
local HELD_MAX = 16
local HELD_SECONDS = 60
local HELD_LOW = { token = true, good = true }
local HELD_PACE = 0.35 -- seconds between two released toasts (and between two room checks while the column is full)

-- KEEP IN SYNC with HudController.lua: EDGE and TOUCH_EDGE.
local EDGE = 12
local TOUCH_EDGE = 20
local HUD_GAP = 10 -- kept below the HUD pieces the stack has to clear
local GIFT_GAP = 8 -- (kit-b) design px beside the gift's square on a portrait screen (HudController K.GIFT_GAP)

-- result card
local RESULT_W = 290
local RESULT_ROOF_OVER = 10 -- (kit B U9-9) the awning reaches this far past each side of the card ...
-- ... and this far above its top: the card is placed so the awning clears the HUD too. (P2 fix A) Read from the kit: since
-- the F0 finish pass seats the awning on the frame (SignKit.RoofSeat, 20 design px over the card) the old 10 put the awning
-- of a card placed under the strip 8 px up into the token strip on a 360 px tall phone
local RESULT_ROOF_UP = -require(Shared:WaitForChild("SignKit")).RoofSeat()
-- (kit B U9-9) the card's rows (design px): the full card, and the compact one for a screen whose room for the card
-- (resultRoom: under the HUD's top-right block and the awning, above the touch buttons, the lower quarter or the centre
-- band) is less than the full card's height (a landscape phone): the stat blocks thinner, the banner and the gaps
-- tighter and the card's top room under the awning used (Trim; Slack the room under the footer), no "Win bonus" row
-- when there is no bonus (a loss: it read "-") and a team of three or four in two columns of names with their ticks /
-- crosses (the player's own tokens are the Tokens row). Every text stays >= 18 design px (14.4 px at the phones' 0.8).
-- A member line stays 26 high: at 0.8 its 18 px icons (2 px cells, PixelCrisp) need that room to sit apart line to line.
-- (U9-9 review) Mini: where even the compact card is taller than its room (a 360 to 390 px tall landscape phone, between
-- the currency strip and the jump button; a portrait phone, above the centre band): the compact rows with no team and no
-- difficulty line (the result, the reason in its short words, the stats and the countdown), W 250 (the toast column's
-- width, so it clears the centre band on a 640 px phone)
-- (U9-9 look) every row a multiple of 5 design px, so its edges land on whole screen px at the phones' 0.8 and at 1080p,
-- and a stat block tall enough for its 18 px coin: Row - RowGap is the block (30 -> 24 px at 0.8: its value row 20 px, a
-- pixel clear of the coin above and of its lip below), RowGap the stone between two blocks (their 2 px edges and 4 px of
-- stone between them at 0.8); Close the red close block
-- (inside the banner's face above its lip); Diff the difficulty's role chip (30 high, 4 px under the banner's edge). The
-- mini card's win bonus rides in the Tokens row ("11 +10", MergeBonus)
local RESULT_ROWS = {
	Full = { Title = 45, Headline = 34, Diff = 45, Reason = 25, Gap = 5, Row = 45, RowGap = 10, Member = 30, Foot = 30, Value = 20, Trim = 0,
		Slack = 10, Close = 35, W = RESULT_W },
	Compact = { Title = 40, Headline = 30, Diff = 45, Reason = 25, Gap = 5, Row = 40, RowGap = 10, Member = 30, Foot = 25, Value = 18, Trim = 10,
		Slack = 5, Close = 30, SkipZeroBonus = true, Columns = 2, W = RESULT_W },
	-- (U9-9 look 2) Mini: Slack 5 under the countdown (it stood on the outcome lip, its "y" in it), taken from the Gap
	Mini = { Title = 40, Headline = 30, Diff = 0, Reason = 25, Gap = 5, Row = 40, RowGap = 10, Member = 30, Foot = 20, Value = 18, Trim = 10,
		Slack = 5, Close = 30, SkipZeroBonus = true, MergeBonus = true, NoTeam = true, NoDiff = true, ShortReason = true, W = 250 },
	-- (P2 fix A) Micro: where even the mini card is taller than its room (a lost match's mini card, its reason line 25 more,
	-- on a 360 px tall landscape phone: 200 of 177.5 between the strip, the awning and the jump button): the mini card with
	-- no Time row, so the result, the reason, the tokens and the countdown all show and the awning clears the strip
	Micro = { Title = 40, Headline = 30, Diff = 0, Reason = 25, Gap = 5, Row = 40, RowGap = 10, Member = 30, Foot = 20, Value = 18, Trim = 10,
		Slack = 5, Close = 30, SkipZeroBonus = true, MergeBonus = true, NoTeam = true, NoDiff = true, ShortReason = true, NoTime = true, W = 250 },
}
local RESULT_ROW_LIP = 5 -- a stat block's lip (4 px at 0.8)
local RESULT_BANNER_LIP = 5
local RESULT_ICON_GAP = 5 -- the room between a value and its coin / tick (4 px at 0.8)
local RESULT_NAIL = 4 -- (U9-9 look) the stone body's two nails at its top corners (the dungeon End card's, U9-7) ...
local RESULT_NAIL_IN = 5 -- ... this far in from the corner
local RESULT_CHIP_H = 20 -- (U9-9 look 2) the mini card's win bonus chip (the HUD's gold run chip): its height and lip
local RESULT_CHIP_LIP = 3
local RESULT_TIERS = { "Full", "Compact", "Mini", "Micro" } -- the first whose card fits its room (the last when none does)
NotifyController.ResultRows = RESULT_ROWS
local RESULT_Y = 0.47 -- vertical position (fraction of the screen), right edge
-- On narrow (portrait) screens the scaled card reaches into the middle of the screen. The game must never say
-- anything there, so the card moves up until it sits above this central band (fractions of the screen size).
local CENTRE_BAND = 0.15
local CENTRE_MARGIN = 6
local CONFETTI_PIECES = 22

-- dash puffs of other players
local FX_MAX_DISTANCE = 140
local FX_MIN_INTERVAL = 0.2
local FxSprites = require(Shared:WaitForChild("FxSprites")) -- the game's own particle sprites (kit B X1)

local Colors = Theme.Colors

local FALLBACK_KINDS = {
	info = Color3.fromRGB(90, 158, 234),
	good = Color3.fromRGB(96, 196, 108),
	bad = Color3.fromRGB(228, 90, 92),
	token = Color3.fromRGB(240, 188, 66),
}
-- (kit B U9-9) each kind's chip: its colour by role (the pitch's .ti, the HUD's coin squares), the lip under it and the
-- pixel icon in the ink that reads on it. Every kind is a PixelIcon now (the "i" / "!" letters went)
local SIGN = Theme.Sign
-- (U9-9 look 2) the result card's inline coins in the Shop's deep gold ("x3 [coin] 150", ShopEggs), not the brown ink:
-- one currency, one colour
local RESULT_COIN = SIGN.GoldLip
local KIND_CHIP = {
	info = { Face = SIGN.Sky, Lip = SIGN.SkyLip, Icon = "bulb", Ink = SIGN.Text },
	good = { Face = SIGN.Grass, Lip = SIGN.GrassLip, Icon = "check", Ink = SIGN.OnGrass },
	bad = { Face = SIGN.Red, Lip = SIGN.RedLip, Icon = "x", Ink = SIGN.Text },
	token = { Face = SIGN.Gold, Lip = SIGN.GoldLip, Icon = "token", Ink = SIGN.Text, Sparkle = true },
}
NotifyController.KindChip = KIND_CHIP
-- (U9-9 look) the result card's difficulty stars are drawn in the ink of the difficulty's chip (buildResults)

local REASON_TEXT = {
	defeat = "The whole team went down",
	timeout = "Out of time",
	abandoned = "Match abandoned",
}
-- (U9-9 review) the mini card's 250 px row cut "The whole team went down" short
local REASON_SHORT = {
	defeat = "The team went down",
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local rng = Random.new()
local UI = {} -- Gui, Stack, StackScale, ToastPad, ResultPad, ResultHolder
local scalers = {}
local toasts = {} -- live toasts, oldest first
local waiting = {} -- toasts pushed out for room: { Text, Kind, Duration, Until }, oldest first
local holders = {} -- SetHeld owners: { [who] = true }; any owner holds the non-"bad" toasts
local held = {} -- toasts waiting for the hold to end: { Text, Kind, Duration, Keep, Count, At }, oldest first (<= HELD_MAX)
local released = {} -- held toasts let go and not shown yet (the drain), oldest first
local drainArmed = false -- a drain step is scheduled
local toastSerial = 0
local result = { Panel = nil, Serial = 0, Height = 0, Width = RESULT_W } -- the open result card (Height, Width: design px)
local lastDashFx = {}
local hud = { Gui = nil, Conn = nil } -- the NimbusHud gui whose layout attributes we follow

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local tween = Util.Tween

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

-- The readability factor: clamp(viewportY / 1080, 0.8, 1.25) (the HUD uses the same).
local function currentScale()
	return Theme.ScreenFactor(viewportSize().Y)
end

local function topInset()
	local okInset, inset = pcall(GuiService.GetGuiInset, GuiService)
	return (okInset and inset and inset.Y) or 0
end

local function hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function newFrame(parent, name, props)
	local p = { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Themed TextLabel with any label property in props. kit-b U6: the toasts, the result card and the hints are all
-- plates, so their texts read by contrast with no outline and no classic stroke.
local function newText(parent, name, text, role, size, color, props)
	local extra = {
		Name = name,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	if props then
		for key, value in pairs(props) do
			extra[key] = value
		end
	end
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Props = extra,
	})
	label.Parent = parent
	return label
end

local function addViewportScale(root)
	local s = Instance.new("UIScale")
	s.Name = "ViewportScale"
	s.Scale = currentScale()
	s.Parent = root
	table.insert(scalers, s)
	return s
end

local function kindColor(kind)
	local name = "info"
	if type(kind) == "string" and FALLBACK_KINDS[string.lower(kind)] then
		name = string.lower(kind)
	end
	local fromTheme = Theme.Kinds and Theme.Kinds[name]
	return fromTheme or FALLBACK_KINDS[name], name
end

-- Cut a string to `maxChars` characters (UTF-8 aware) and add "..." when it was longer.
local function truncateText(text, maxChars)
	text = tostring(text or "")
	local okLen, len = pcall(utf8.len, text)
	if okLen and len then
		if len <= maxChars then
			return text
		end
		local okOff, offset = pcall(utf8.offset, text, maxChars + 1)
		if okOff and offset then
			return string.sub(text, 1, offset - 1) .. "..."
		end
	end
	if #text <= maxChars then
		return text
	end
	return string.sub(text, 1, maxChars) .. "..."
end

-- A transparent full-screen frame whose UIPadding is the screen margin.
local function newHolder(name)
	local holder = newFrame(UI.Gui, name, { Size = UDim2.fromScale(1, 1) })
	local pad = Instance.new("UIPadding")
	pad.Parent = holder
	return holder, pad
end

-- One layout attribute HudController publishes on NimbusHud (gui-area pixels, 0 = nothing there).
local function hudValue(name)
	local gui = hud.Gui
	if not gui or not gui.Parent then
		return 0
	end
	local value = gui:GetAttribute(name)
	if type(value) == "number" then
		return value
	end
	return 0
end

-- (kit B U9-9) Roblox's own jump button on a touch screen (its TouchGui is not the game's to read), as the kit's fit tests
-- place it: J = 70 px on a small screen (shorter side <= 500), from 1.5 J + 10 to 0.5 J + 10 in from the right and 20 + J
-- up from the bottom; a big screen's 120 px button sits higher (210 up). -> x0, x1, y0 in gui px; nil without touch
local function jumpButton()
	if not isTouchDevice() then
		return nil
	end
	local vp = viewportSize()
	local areaY = vp.Y - topInset()
	if math.min(vp.X, vp.Y) <= 500 then
		return vp.X - 115, vp.X - 45, areaY - 90
	end
	return vp.X - 190, vp.X - 50, areaY - 210
end

-- Lowest gui y a toast column whose left edge is at `toastLeft` (right edge `toastRight`) may reach: above the
-- centre band when the column reaches into it sideways (portrait phones), above the touch RUN / DASH buttons
-- under the column, (kit B U9-9) 6 px above Roblox's jump button, and never into the lower quarter of the screen.
-- (U9-9 review) card: the result card's limit. The touch DASH under it is left out and returned as its rows with its
-- stroke ({ Top, Bottom }, gui px): the card lies wholly over it or wholly clear of it (resultSpan), its taps pass through
-- the card. On a touch screen the touch buttons are the card's floor, not the lower quarter (the big phones' DASH reaches
-- into that quarter: a card over it ends at the jump button)
local function bottomLimitFor(toastLeft, toastRight, card)
	local vp = viewportSize()
	local inset = topInset()
	local limit = (card and isTouchDevice()) and (vp.Y - inset) or (vp.Y - inset) * 0.72
	if toastLeft < vp.X * (0.5 + CENTRE_BAND) and toastRight > vp.X * (0.5 - CENTRE_BAND) then
		limit = math.min(limit, vp.Y * (0.5 - CENTRE_BAND) - CENTRE_MARGIN - inset)
	end
	local jx0, jx1, jy0 = jumpButton()
	if jx0 and toastRight > jx0 - 6 and toastLeft < jx1 + 6 then
		limit = math.min(limit, jy0 - 6)
	end
	local dash = nil
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local mobile = playerGui and playerGui:FindFirstChild("MobileControls")
	if mobile and mobile:IsA("ScreenGui") and mobile.Enabled then
		local dy = mobile.IgnoreGuiInset and -inset or 0
		for _, d in ipairs(mobile:GetDescendants()) do
			if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.Visible and d.AbsoluteSize.X > 0 then
				local x0 = d.AbsolutePosition.X
				local x1 = x0 + d.AbsoluteSize.X
				if x1 > toastLeft and x0 < toastRight then
					local y0 = d.AbsolutePosition.Y + dy
					if card and d.Name == "DashButton" then
						local stroke = d:FindFirstChildOfClass("UIStroke")
						local s = (stroke and stroke.Enabled ~= false) and stroke.Thickness or 0
						dash = { Top = y0 - s, Bottom = y0 + d.AbsoluteSize.Y + s, Clear = y0 - TOAST_GAP }
					else
						limit = math.min(limit, y0 - TOAST_GAP)
					end
				end
			end
		end
	end
	return limit, dash
end

-- Where the toast column goes: { Top, Right (padding from the right edge), Bottom (lowest y) } in gui px.
-- Normally the top-right corner (below the HUD's currency stack when that sits there). On a short screen
-- where not even one toast fits between that stack and the touch buttons, the column moves to the left of
-- the stack instead; on a narrow screen it also stays below the top-left panel when the two would overlap.
local function toastPlacement()
	local side = isTouchDevice() and TOUCH_EDGE or EDGE
	local k = currentScale()
	local vp = viewportSize()
	local width = TOAST_W * k
	local right = side
	local top = EDGE
	local rightBottom = hudValue("TopRightBottom")
	if rightBottom > 0 then
		top = rightBottom + HUD_GAP
		-- (kit-b) on a portrait screen the gift's square under the strips (GiftLeft / GiftTop / GiftSize) would eat the
		-- column's room as a stack of strips would (HudController lines those up in one row there): the column starts
		-- level with the square, left of it, the square's own gap (HudController K.GIFT_GAP) away, so the cards' text
		-- stays in the screen's right part
		if vp.Y > vp.X and hudValue("GiftSize") > 0 and hudValue("GiftLeft") > 0 then
			right = math.max(side, vp.X - hudValue("GiftLeft") + GIFT_GAP * k)
			top = hudValue("GiftTop")
		end
		local left = vp.X - right - width
		local room = (bottomLimitFor(left, vp.X - right) - top) / math.max(0.01, k)
		local stackLeft = hudValue("TopRightLeft")
		if room < MIN_TOAST_H and stackLeft > 0 then
			right = math.max(side, vp.X - stackLeft + HUD_GAP)
			top = EDGE
		end
	end
	local toastLeft = vp.X - right - width
	local leftRight = hudValue("TopLeftRight")
	if leftRight > 0 and leftRight > toastLeft - 4 then
		top = math.max(top, hudValue("TopLeftBottom") + HUD_GAP)
	end
	return {
		Top = math.floor(top),
		Right = math.floor(right),
		Bottom = bottomLimitFor(toastLeft, vp.X - right),
	}
end

-- Conservative height of a toast in design px (wide glyphs, word wrap slack).
local function estimateToastHeight(text)
	local width = TOAST_W - 24 - (TOAST_ICON + 10)
	local perLine = math.max(1, math.floor(width / (TOAST_TEXT_SIZE * 0.62)))
	local okLen, len = pcall(utf8.len, tostring(text or ""))
	if not okLen or type(len) ~= "number" then
		len = #tostring(text or "")
	end
	local lines = math.max(1, math.ceil(len / perLine))
	-- (kit B U9-9) the stone tag's padding (over it, and with its lip under it) and its wood edge outside it
	return math.max(TOAST_TEXT_MIN, lines * math.ceil(TOAST_TEXT_SIZE * 1.15)) + 2 * TOAST_PAD + TOAST_LIP + 2 * TOAST_EDGE
end

-- (U9-9 look) a toast's text row: the height its wrapped text takes (TextBounds, in the label's own px; a measure until the
-- text is laid out), picked so the card's edges land on whole screen px (PixelCrisp.Len), at least one line's
-- TOAST_TEXT_MIN; the card is its padding, this row and its lip, each whole px, so its height is set, not automatic
local function sizeToastText(toast)
	local label, card = toast.Label, toast.Card
	if not (label and label.Parent and card) then
		return
	end
	local k = PixelCrisp.ScaleAbove(label)
	local h = label.TextBounds.Y / math.max(0.01, k)
	if h <= 0 then
		local room = TOAST_W - 2 * TOAST_PAD - (TOAST_ICON + 10)
		local okM, m = pcall(Theme.Measure, label.Text, "Toast", TOAST_TEXT_SIZE, room)
		h = (okM and typeof(m) == "Vector2") and m.Y or TOAST_TEXT_MIN
	end
	h = PixelCrisp.Len(math.max(TOAST_TEXT_MIN, math.ceil(h - 0.01)), k)
	local want = UDim2.new(1, -(TOAST_ICON + 10), 0, h)
	if label.Size ~= want then
		label.Size = want
	end
	local cardH = UDim2.new(1, 0, 0, 2 * TOAST_PAD + TOAST_LIP + h)
	if card.Size ~= cardH then
		card.Size = cardH
	end
end

-- (kit-b) a live toast's height in design px: its card as sizeToastText set it (padding, text row, lip: a set height
-- since U9-9) and its wood edge outside it; the estimate only while the card has no height yet
local function liveToastHeight(toast)
	local card = toast.Card
	local h = card and card.Size.Y.Scale == 0 and card.Size.Y.Offset or 0
	if h > 0 then
		return h + 2 * TOAST_EDGE
	end
	return estimateToastHeight(toast.Label.Text)
end

local dismissToast -- defined below

-- Keeps the newest toasts that fit above the column's lowest allowed y (always at least the newest one).
local function trimToasts()
	if #toasts == 0 then
		return
	end
	local k = currentScale()
	local place = toastPlacement()
	local budget = (place.Bottom - place.Top) / math.max(0.01, k)
	local used = 0
	local kept = 0
	local drop = {}
	for i = #toasts, 1, -1 do -- newest first
		local toast = toasts[i]
		local h = liveToastHeight(toast)
		if kept > 0 then
			h = h + TOAST_GAP
		end
		if kept >= 1 and used + h > budget then
			for j = i, 1, -1 do
				table.insert(drop, toasts[j])
			end
			break
		end
		used = used + h
		kept = kept + 1
	end
	local now = os.clock()
	for _, toast in ipairs(drop) do
		-- pushed out before it could be read: it waits for room (see flushWaiting)
		local shownFor = now - (toast.Born or now)
		local left = (toast.Expiry or now) - now
		if shownFor < WAIT_MIN_SHOWN and left > MIN_DURATION and #waiting < WAIT_MAX then
			table.insert(waiting, 1, { Text = toast.Text, Kind = toast.Kind, Duration = left, Until = now + WAIT_SECONDS })
		end
		dismissToast(toast)
	end
end

local function applyMargins()
	local side = isTouchDevice() and TOUCH_EDGE or EDGE
	if UI.ToastPad then
		local place = toastPlacement()
		UI.ToastPad.PaddingRight = UDim.new(0, place.Right)
		UI.ToastPad.PaddingTop = UDim.new(0, place.Top)
	end
	if UI.ResultPad then
		UI.ResultPad.PaddingRight = UDim.new(0, side)
	end
end

-- Where a result card `width` design px wide goes: true = at the right edge, from its left x to its right x (gui px).
-- (U9-9 review) Every landscape screen keeps it there (a phone under 720 px wide took the centre-band rule below, which
-- never asked bottomLimitFor about the touch buttons); a portrait one only when the scaled card stays right of the
-- centre band
local function resultOnEdge(width)
	local vp = viewportSize()
	local side = isTouchDevice() and TOUCH_EDGE or EDGE
	local cardLeft = vp.X - side - width * currentScale()
	return vp.X > vp.Y or cardLeft >= vp.X * (0.5 + CENTRE_BAND), cardLeft, vp.X - side
end

-- (kit B U9-9; review) The rows the right-edge card may use (gui px): Top = under the HUD's top-right block and the awning,
-- Clear = the lowest y that keeps the touch DASH wholly clear, Cover = the lowest y bottomLimitFor allows (jump button, RUN,
-- the centre band) when the card may lie wholly over DASH (it reaches past DASH's stroke), else Clear; Dash = DASH's rows
-- with its stroke (nil without one under the card). Never a sliver of DASH under the card's edge (the U9-4 rule)
local function resultSpan(width)
	local k = currentScale()
	local _, cardLeft, cardRight = resultOnEdge(width)
	local top = math.max(EDGE, hudValue("TopRightBottom") + HUD_GAP) + RESULT_ROOF_UP * k
	local cover, dash = bottomLimitFor(cardLeft, cardRight, true)
	local clear = cover
	if dash and dash.Clear < cover then
		clear = dash.Clear
		if cover < dash.Bottom then
			cover = clear
		end
	end
	return top, clear, cover, dash
end

-- a whole gui px for the card's centre y, kept inside lo .. hi when those leave one (the DASH window is 1 px)
local function snapInside(y, lo, hi)
	local a, b = math.ceil(lo), math.floor(hi)
	if a <= b then
		return math.min(math.max(math.floor(y + 0.5), a), b)
	end
	return math.floor(y)
end

-- Position of the (right-edge) result card: `xScale` 1 = on screen, > 1 = parked off screen. The card sits at
-- RESULT_Y of the screen height; when the screen is so narrow that the scaled card reaches into the centre band
-- it is lifted above that band instead (never below it: the thumb controls live there).
local function resultPosition(xScale, panelHeight, panelWidth)
	local vp = viewportSize()
	local k = currentScale()
	local width = panelWidth or result.Width
	local half = (panelHeight or result.Height) * k / 2
	local roof = RESULT_ROOF_UP * k -- (kit B U9-9) the awning over the card's top
	if resultOnEdge(width) then
		-- keep clear of a top-right currency stack on short screens
		local top, clear, cover, dash = resultSpan(width)
		local y = (vp.Y - topInset()) * RESULT_Y
		local lo, hi = top + half, clear - half
		if hi < lo and cover > clear then
			-- (U9-9 review) too tall to end above the touch DASH: the card lies wholly over it (a short landscape phone),
			-- or on a screen with no room either way it ends at the cover limit, never over the top edge
			lo, hi = math.max(lo, dash.Bottom - half), cover - half
			if lo <= hi then
				return UDim2.new(xScale, 0, 0, snapInside(y, lo, hi))
			end
			return UDim2.new(xScale, 0, 0, math.floor(math.max(hi, EDGE + roof + half)))
		end
		if hi < lo then
			-- no room at all (a tiny screen): as low as the limit lets it, never over the top edge
			return UDim2.new(xScale, 0, 0, math.floor(math.max(hi, EDGE + roof + half)))
		end
		-- v5: a short screen lifts the card under the HUD so it never covers the touch RUN / DASH / jump buttons below it
		if y > hi or y < lo then
			y = lo
		end
		return UDim2.new(xScale, 0, 0, snapInside(y, lo, hi))
	end
	-- the ScreenGui area starts below the top bar (IgnoreGuiInset = false), so gui y = screen y - inset
	local ceiling = vp.Y * (0.5 - CENTRE_BAND) - CENTRE_MARGIN - half - topInset()
	local floorY = math.max(EDGE, hudValue("TopRightBottom") + HUD_GAP) + roof + half
	return UDim2.new(xScale, 0, 0, math.floor(math.max(ceiling, floorY)))
end

-- (kit B U9-9) the design px of height a card `width` design px wide has where resultPosition puts it: from under the HUD's
-- top-right block and the awning down to the lowest y it may reach (the right edge: resultSpan's Cover), or to the centre
-- band (a narrow portrait screen)
local function resultRoom(width)
	local vp = viewportSize()
	local k = math.max(0.01, currentScale())
	if resultOnEdge(width) then
		local top, _, cover = resultSpan(width)
		return (cover - top) / k
	end
	local top = math.max(EDGE, hudValue("TopRightBottom") + HUD_GAP) + RESULT_ROOF_UP * k
	return (vp.Y * (0.5 - CENTRE_BAND) - CENTRE_MARGIN - topInset() - top) / k
end

-- (U9-9 review, look) the HUD's vitals card steps aside while the open card lies over a part of it (a short landscape
-- phone: the mini card's corner over the card's right end), as the Trove and Gifts windows do; back when the card goes
local function syncVitals()
	local off = false
	local panel = result.Panel
	local module = script.Parent:FindFirstChild("HudController")
	local okHud, hud = false, nil
	if module then
		okHud, hud = pcall(require, module)
	end
	if not (okHud and type(hud) == "table") then
		return
	end
	if panel and panel.Root and panel.Root.Parent and type(hud.GetLayout) == "function" then
		local okLayout, layout = pcall(hud.GetLayout)
		local slot = okLayout and type(layout) == "table" and layout.VitalsSlot
		if slot then
			local vp, k = viewportSize(), currentScale()
			local x1 = vp.X - (isTouchDevice() and TOUCH_EDGE or EDGE)
			local x0 = x1 - result.Width * k
			local pos = resultPosition(1)
			local cy = pos.Y.Scale * (vp.Y - topInset()) + pos.Y.Offset
			local y0, y1 = cy - result.Height * k / 2, cy + result.Height * k / 2
			local w = math.min(x1, slot.X + slot.W) - math.max(x0, slot.X)
			local h = math.min(y1, slot.Y + slot.H) - math.max(y0, slot.Y)
			off = w > 4 and h > 4
		end
	end
	if off ~= (result.VitalsOff == true) and type(hud.SetVitalsHidden) == "function" then
		result.VitalsOff = off
		pcall(hud.SetVitalsHidden, "ResultCard", off)
	end
end

-- Tells the HUD where the open result card starts (gui x of its left edge; 0 = no card), so on a narrow
-- screen it can tuck the match panel away instead of drawing both on top of each other.
local function publishResultCard()
	if not UI.Gui then
		return
	end
	local value = 0
	if result.Panel and result.Panel.Root and result.Panel.Root.Parent then
		local side = isTouchDevice() and TOUCH_EDGE or EDGE
		value = math.floor(viewportSize().X - side - result.Width * currentScale())
	end
	if UI.Gui:GetAttribute("ResultCardLeft") ~= value then
		UI.Gui:SetAttribute("ResultCardLeft", value)
	end
	syncVitals()
end

-- (P2 fix A look review r1, major 6) the result card's close pad: 44 screen px each way at the card's scale k
local function sizeCloseHit(k)
	local pad = UI.ResultCloseHit
	if not (pad and pad.Parent) then
		UI.ResultCloseHit = nil
		return
	end
	local hit = math.ceil(44 / math.max(0.05, k or 1))
	local size = math.max(UI.ResultCloseSize or 0, hit)
	pad.Size = UDim2.fromOffset(size, size)
end

local function relayout()
	local k = currentScale()
	for i = #scalers, 1, -1 do
		local s = scalers[i]
		if s.Parent then
			s.Scale = k
		else
			table.remove(scalers, i)
		end
	end
	sizeCloseHit(k)
	-- (U9-9 look) the column's scale rounded so its 250 px width is whole screen px (its cards' edges on whole px)
	if UI.StackScale then
		UI.StackScale.Scale = math.max(1, math.floor(TOAST_W * k + 0.5)) / TOAST_W
	end
	applyMargins()
	trimToasts()
	for _, toast in ipairs(toasts) do
		sizeToastText(toast)
	end
	PixelCrisp.Refresh(UI.Stack) -- (kit B U9-9) the icons and edges back on whole pixels at the new scale
	local panel = result.Panel
	if panel and panel.Root and panel.Root.Parent then
		panel.Root.Position = resultPosition(1)
		PixelCrisp.Refresh(panel.Root)
	end
	publishResultCard()
end

-- Follow the HUD's layout attributes (the HUD may be built before or after us, and rebuilt).
local function bindHud(gui)
	if hud.Gui == gui then
		return
	end
	if hud.Conn then
		hud.Conn:Disconnect()
		hud.Conn = nil
	end
	hud.Gui = gui
	if gui then
		hud.Conn = gui.AttributeChanged:Connect(function()
			pcall(relayout)
		end)
	end
	pcall(relayout)
end

local function watchHud()
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)
	if not playerGui then
		return
	end
	local existing = playerGui:FindFirstChild("NimbusHud")
	if existing and existing:IsA("ScreenGui") then
		bindHud(existing)
	end
	playerGui.ChildAdded:Connect(function(child)
		if child.Name == "NimbusHud" and child:IsA("ScreenGui") then
			bindHud(child)
		end
	end)
end

----------------------------------------------------------------------
-- Toasts
----------------------------------------------------------------------
-- a = 0 fully visible .. 1 fully faded
local function setToastAlpha(toast, a, seconds)
	local goals = {
		{ toast.Card, { BackgroundTransparency = TOAST_BG + (1 - TOAST_BG) * a } },
		{ toast.Stroke, { Transparency = a } },
		{ toast.Lip, { BackgroundTransparency = a } },
		{ toast.Label, { TextTransparency = a } },
		{ toast.Icon, { BackgroundTransparency = a } },
		{ toast.IconStroke, { Transparency = a } },
		{ toast.IconLip, { BackgroundTransparency = a } },
		{ toast.IconGlyph, { TextTransparency = a } },
		{ toast.Sparkle, { TextTransparency = a } },
	}
	for _, entry in ipairs(goals) do
		if entry[1] then
			if seconds and seconds > 0 then
				tween(entry[1], seconds, entry[2], Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			else
				for key, value in pairs(entry[2]) do
					entry[1][key] = value
				end
			end
		end
	end
end

function dismissToast(toast)
	if toast.Dead then
		return
	end
	toast.Dead = true
	for i, live in ipairs(toasts) do
		if live == toast then
			table.remove(toasts, i)
			break
		end
	end
	tween(toast.Card, 0.22, { Position = UDim2.new(0, TOAST_W + 40, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	setToastAlpha(toast, 1, 0.22)
	task.delay(0.25, function()
		local slot = toast.Slot
		if not slot or not slot.Parent then
			return
		end
		-- collapse the gap smoothly instead of popping the stack
		local scale = UI.StackScale and UI.StackScale.Scale or 1
		local height = slot.AbsoluteSize.Y / math.max(0.01, scale)
		slot.AutomaticSize = Enum.AutomaticSize.None
		slot.Size = UDim2.new(1, 0, 0, height)
		tween(slot, 0.15, { Size = UDim2.new(1, 0, 0, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.18, function()
			if slot.Parent then
				slot:Destroy()
			end
		end)
	end)
end

local flushWaiting -- defined after addToast

local function scheduleExpiry(toast, duration)
	toast.Expiry = os.clock() + duration
	task.delay(duration + 0.02, function()
		if not toast.Dead and os.clock() >= toast.Expiry then
			dismissToast(toast)
			if flushWaiting and #waiting > 0 then
				task.delay(0.3, flushWaiting)
			end
		end
	end)
end

local function refreshToastText(toast)
	local text = toast.Text
	if toast.Count > 1 then
		text = text .. "  x" .. tostring(toast.Count)
	end
	toast.Label.Text = text
	sizeToastText(toast) -- (U9-9 look) "x2" may take a second line
	PixelCrisp.Refresh(toast.Card)
end

-- (kit B U9-9) brown on the stone tile, whatever the kind (the chip carries the kind's colour)
local function toastTextColor()
	return SIGN.Text
end

local function buildToast(text, kind)
	local color, kindName = kindColor(kind)
	local chip = KIND_CHIP[kindName] or KIND_CHIP.info
	toastSerial = toastSerial + 1

	-- the slot is the list item (it keeps its place while the card slides); the card is what moves
	local slot = newFrame(UI.Stack, "ToastSlot", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = -toastSerial, -- newest on top
	})
	-- (kit B U9-9) the stone block: tile face, wood edge, the stone lip along its bottom (CloudUI.SignBlock keeps the lip
	-- flush with the block's edges under the padding)
	local card = newFrame(slot, "Toast", {
		Position = UDim2.new(0, TOAST_W + 40, 0, 0),
		Size = UDim2.new(1, 0, 0, 2 * TOAST_PAD + TOAST_LIP + TOAST_TEXT_MIN), -- sizeToastText
	})
	-- (U9-9 look) the card is a crisp root: it slides in, and its chip and icons sit on whole px of it at rest (its
	-- padding, text row and lip are whole px, so the column's cards rest on whole px too)
	PixelCrisp.Root(card)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, TOAST_PAD)
	pad.PaddingBottom = UDim.new(0, TOAST_PAD + TOAST_LIP)
	pad.PaddingLeft = UDim.new(0, TOAST_PAD)
	pad.PaddingRight = UDim.new(0, TOAST_PAD)
	pad.Parent = card
	local stroke, lip = CloudUI.SignBlock(card, { Face = SIGN.Tile, Lip = SIGN.StoneLip, Edge = SIGN.Wood, Text = SIGN.Text }, {
		EdgePx = TOAST_EDGE,
		LipPx = TOAST_LIP,
	})
	PixelCrisp.Edge(stroke, TOAST_EDGE)
	PixelCrisp.Lip(lip, TOAST_LIP)
	card.BackgroundTransparency = 1 -- faded in by setToastAlpha
	stroke.Transparency = 1
	lip.BackgroundTransparency = 1

	-- the kind's chip: its colour by role, a wood edge, its own darker lip; the pixel icon on whole screen pixels
	local icon = newFrame(card, "Icon", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(TOAST_ICON, TOAST_ICON),
		BackgroundTransparency = 1,
		BackgroundColor3 = chip.Face,
	})
	local iconStroke = Theme.Stroke(icon, SIGN.Wood, TOAST_EDGE, 1)
	iconStroke.Name = "SignEdge"
	iconStroke.LineJoinMode = Enum.LineJoinMode.Miter
	PixelCrisp.Edge(iconStroke, TOAST_EDGE)
	local iconLip = newFrame(icon, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, TOAST_CHIP_LIP),
		BackgroundTransparency = 1,
		BackgroundColor3 = chip.Lip,
	})
	PixelCrisp.Lip(iconLip, TOAST_CHIP_LIP)
	local holder, glyph = PixelCrisp.Icon(icon, chip.Icon, TOAST_GLYPH, chip.Ink, {
		Position = UDim2.new(0.5, 0, 0.5, -1), -- centred on the face above the lip
	})
	glyph.TextTransparency = 1 -- the icon fades in and out with the glyph's TextTransparency
	icon:SetAttribute("Kind", kindName)
	-- a reward gets one pixel sparkle on the chip's top-right corner (the Sky Trove's reward tags have two), in the deep
	-- gold that shows on the tile and at the icon's own pixel size (one pixel size per screen)
	local sparkle = nil
	if chip.Sparkle then
		local _, s = PixelCrisp.Icon(icon, "sparkle", TOAST_GLYPH, SIGN.GoldDeep, {
			Name = "Sparkle",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 2, 0, 2),
			ZIndex = 3,
		})
		sparkle = s
		sparkle.TextTransparency = 1
	end

	local label = newText(card, "Text", text, "Toast", TOAST_TEXT_SIZE, toastTextColor(), {
		Position = UDim2.new(0, TOAST_ICON + 10, 0, 0),
		Size = UDim2.new(1, -(TOAST_ICON + 10), 0, TOAST_TEXT_MIN),
		TextWrapped = true,
		TextTransparency = 1,
	})

	local toast = {
		Slot = slot, Card = card, Stroke = stroke, Lip = lip, Icon = icon, IconStroke = iconStroke, IconLip = iconLip,
		IconGlyph = glyph, IconHolder = holder, Sparkle = sparkle, Label = label, Text = text, Kind = kindName, Count = 1,
		Dead = false, Expiry = 0, Color = color,
	}
	-- (U9-9 look) the text row sized to whole px (again once the text is laid out), then the chip and its icons on whole
	-- px of the card
	sizeToastText(toast)
	label:GetPropertyChangedSignal("TextBounds"):Connect(function()
		if not toast.Dead then
			sizeToastText(toast)
			PixelCrisp.Refresh(card)
		end
	end)
	PixelCrisp.Box(icon)
	PixelCrisp.Refresh(card)
	return toast
end

-- (audio wave 2 fix) client/SoundFx, lazy; false = unavailable
local soundFxMod = nil
local function playSfx(name)
	if soundFxMod == nil then
		local module = Client:FindFirstChild("SoundFx")
		local ok, mod = false, nil
		if module then
			ok, mod = pcall(require, module)
		end
		soundFxMod = (ok and type(mod) == "table" and type(mod.Play) == "function") and mod or false
	end
	if soundFxMod then
		pcall(soundFxMod.Play, name)
	end
end

local function addToast(text, kind, duration)
	if not UI.Stack then
		return
	end
	text = truncateText(text, MAX_TOAST_CHARS)
	if text == "" then
		return
	end
	duration = Util.Clamp(tonumber(duration) or DEFAULT_DURATION, MIN_DURATION, MAX_DURATION)

	-- merge an identical toast that is still showing
	local _, kindName = kindColor(kind)
	for _, live in ipairs(toasts) do
		if not live.Dead and live.Text == text and live.Kind == kindName then
			live.Count = live.Count + 1
			refreshToastText(live)
			-- (kit B U9-9) the repeat flashes the stone face pale gold (the text stays brown and readable)
			live.Card.BackgroundColor3 = SIGN.Selected
			tween(live.Card, 0.35, { BackgroundColor3 = SIGN.Tile }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			scheduleExpiry(live, duration)
			return
		end
	end

	local toast = buildToast(text, kind)
	toast.Born = os.clock()
	if kindName == "bad" then
		playSfx("Error") -- a refused action (a NEW "bad" toast; its merged repeats stay silent; Config MinGap 1 s)
	end
	table.insert(toasts, toast)
	-- never more than MAX_TOASTS (and never further down than the screen allows): the oldest leave first
	while #toasts > MAX_TOASTS do
		dismissToast(toasts[1])
	end
	-- (U9-9 review) the column where trimToasts measures it: the touch RUN / DASH may have come or gone since the last
	-- relayout (MovementController shows them on a spawn), and nothing on the HUD moved to tell us
	applyMargins()
	trimToasts()

	toast.Card.Position = UDim2.new(0, TOAST_W + 40, 0, 0)
	tween(toast.Card, 0.38, { Position = UDim2.new(0, 0, 0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	setToastAlpha(toast, 0, 0.2)
	scheduleExpiry(toast, duration)
end

-- true when the toast column fits one more toast with this text under the live ones (height only)
local function columnFits(text)
	local k = currentScale()
	local place = toastPlacement()
	local used = 0
	for _, live in ipairs(toasts) do
		used = used + liveToastHeight(live) + TOAST_GAP
	end
	return used + estimateToastHeight(text) <= (place.Bottom - place.Top) / math.max(0.01, k)
end

-- Shows the oldest waiting toast when the column has room for it again (one at a time; stale ones are dropped).
function flushWaiting()
	local now = os.clock()
	while #waiting > 0 and waiting[1].Until < now do
		table.remove(waiting, 1)
	end
	local entry = waiting[1]
	if not entry or not UI.Stack then
		return
	end
	-- (kit-b) an empty column always takes it, as the held toasts' drain does (drainStep) and as a new toast is always
	-- shown (trimToasts keeps the newest): a text taller than a short column (the strips stacked down a landscape phone)
	-- waited for room it could never get and was never read
	if #toasts > 0 and not columnFits(entry.Text) then
		return -- still no room: tried again when the next toast leaves
	end
	table.remove(waiting, 1)
	addToast(entry.Text, entry.Kind, entry.Duration)
end

-- (quick wins, review round 1) the drain of the released held toasts: one every HELD_PACE seconds while the column has
-- room (fewer than MAX_TOASTS live and it fits; an empty column always takes one), so a long list is read one by one
-- instead of the newest pushing the first out. Paused while held again (the /menu reopen); resumed at that release.
-- A failing step drops the rest with a warning (drainReleased), so the chain can never stick armed.
local drainStep
local function drainReleased()
	local ok, err = pcall(drainStep)
	if not ok then
		drainArmed = false
		released = {}
		warn("[NotifyController] the held toasts failed: " .. tostring(err))
	end
end

function drainStep()
	drainArmed = false
	if next(holders) ~= nil or #released == 0 then
		return
	end
	local entry = released[1]
	if not UI.Stack then
		released = {} -- no toast column to show them on
		return
	end
	local live = #toasts
	if live == 0 or (live < MAX_TOASTS and columnFits(tostring(entry.Text))) then
		table.remove(released, 1)
		for _ = 1, math.max(1, entry.Count or 1) do
			addToast(entry.Text, entry.Kind, entry.Duration) -- repeats merge into "text x2"
		end
	end
	if #released > 0 then
		drainArmed = true
		task.delay(HELD_PACE, drainReleased)
	end
end

local function buildToastStack()
	local holder, pad = newHolder("ToastHolder")
	UI.ToastPad = pad
	local stack = newFrame(holder, "ToastStack", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(TOAST_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Right
	list.VerticalAlignment = Enum.VerticalAlignment.Top
	list.Padding = UDim.new(0, TOAST_GAP)
	list.Parent = stack
	UI.Stack = stack
	UI.StackScale = addViewportScale(stack)
	UI.StackScale.Scale = math.max(1, math.floor(TOAST_W * currentScale() + 0.5)) / TOAST_W -- (U9-9 look) as relayout
end

----------------------------------------------------------------------
-- Result card
----------------------------------------------------------------------
local function closeResults(immediate)
	local panel = result.Panel
	result.Serial = result.Serial + 1
	result.Panel = nil
	publishResultCard()
	if not panel or not panel.Root or not panel.Root.Parent then
		return
	end
	if immediate then
		panel.Destroy()
		return
	end
	tween(panel.Root, 0.3, { Position = resultPosition(1.8) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.35, function()
		if panel.Root.Parent then
			panel.Destroy()
		end
	end)
end

-- Count a label up from 0 to `target`. The serial stops it if the card closed meanwhile.
local function countUp(label, target, delay, seconds, format, serial)
	task.spawn(function()
		task.wait(delay)
		local started = os.clock()
		while true do
			if result.Serial ~= serial or not label.Parent then
				return
			end
			local a = (os.clock() - started) / seconds
			if a >= 1 then
				label.Text = format(target)
				return
			end
			local eased = 1 - (1 - a) * (1 - a) * (1 - a)
			label.Text = format(math.floor(target * eased + 0.5))
			task.wait(0.03)
		end
	end)
end

-- Square "pixel" confetti (the voxel world's little sparkle) falling over the card. (kit B U9-9) In the kit's gold and pink
-- with their lips (the Gifts window's week confetti), no rainbow.
local KIT_CONFETTI = { SIGN.Gold, SIGN.Roof, SIGN.GoldLip, SIGN.RoofLip }
NotifyController.Confetti = KIT_CONFETTI
local function burstConfetti(root, serial)
	local palette = KIT_CONFETTI
	for i = 1, CONFETTI_PIECES do
		local x = rng:NextNumber(0.06, 0.94)
		local startY = rng:NextNumber(-6, 18)
		local px = rng:NextInteger(6, 10)
		local piece = newFrame(root, "Confetti", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(x, 0, 0, startY),
			Size = UDim2.fromOffset(px, px),
			BackgroundTransparency = 1,
			BackgroundColor3 = palette[(i % #palette) + 1],
			Rotation = rng:NextInteger(0, 3) * 90,
			ZIndex = 12,
		})
		task.delay(rng:NextNumber(0.2, 0.7), function()
			if result.Serial ~= serial or not piece.Parent then
				return
			end
			piece.BackgroundTransparency = 0
			local fall = rng:NextNumber(130, 220)
			tween(piece, rng:NextNumber(0.9, 1.4), {
				Position = UDim2.new(Util.Clamp(x + rng:NextNumber(-0.12, 0.12), 0.02, 0.98), 0, 0, startY + fall),
				Rotation = piece.Rotation + rng:NextInteger(-2, 2) * 90,
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(1.5, function()
				if piece.Parent then
					piece:Destroy()
				end
			end)
		end)
	end
end

local function normaliseMembers(list)
	local out = {}
	if type(list) == "table" then
		for _, m in ipairs(list) do
			if type(m) == "table" then
				table.insert(out, {
					Name = tostring(m.Name or "?"),
					Tokens = math.max(0, math.floor(tonumber(m.MatchTokens) or 0)),
					Finished = m.Finished == true,
					Downed = m.Downed == true,
				})
			end
			if #out >= 4 then
				break
			end
		end
	end
	return out
end

local function isLocalName(name)
	return name == LocalPlayer.Name or name == LocalPlayer.DisplayName
end

local function buildResults(data)
	local won = data.Won == true
	local diff = Config.GetDifficulty and Config.GetDifficulty(data.DifficultyId) or nil
	local diffColor = (diff and diff.Color) or Colors.Stamina
	local starCount = tonumber(data.Stars) or (diff and diff.Stars) or 0
	local members = normaliseMembers(data.Members)
	local reason = (not won) and REASON_TEXT[tostring(data.Reason or "defeat")] or nil

	-- fixed vertical layout (inner coordinates); (kit B U9-9) the stat rows are stone blocks 6 px apart; the compact rows
	-- when the full card is taller than the screen's room for it, the mini card when the compact one is too (RESULT_ROWS)
	local insetTop, _, insetBottom = CloudUI.ContentInset(false, true)
	local hasBonus = (tonumber(data.Bonus) or 0) >= 1
	local function layoutWith(rows)
		local out = { Rows = rows }
		out.Stats = (rows.MergeBonus or (rows.SkipZeroBonus and not hasBonus)) and 2 or 3
		if rows.NoTime then
			out.Stats = out.Stats - 1 -- (P2 fix A) the micro card: no Time row
		end
		out.Cols = (rows.Columns and #members > 2) and rows.Columns or 1
		out.Members = #members > 1 and not rows.NoTeam
		local y = 0
		out.TitleY = y
		y = y + rows.Title
		out.DiffY = y
		y = y + rows.Diff
		out.ReasonY = y
		if reason then
			y = y + rows.Reason
		end
		y = y + rows.Gap
		out.StatsY = y
		y = y + rows.Row * out.Stats -- (U9-9 look) each row ends in its RowGap of stone
		out.MembersY = y
		if out.Members then
			y = y + math.ceil(#members / out.Cols) * rows.Member + 5
		end
		out.FootY = y
		y = y + rows.Foot
		out.PanelH = insetTop + insetBottom + rows.Slack + y - rows.Trim
		-- (U9-9 look) the card's height an even number of screen px where one is near: its centre sits on a whole px
		-- (resultPosition), so its top and bottom do too
		local k = currentScale()
		for add = 0, 20 do
			local v = (out.PanelH + add) * k
			if math.abs(v - math.floor(v + 0.5)) < 1e-4 and math.floor(v + 0.5) % 2 == 0 then
				out.PanelH = out.PanelH + add
				break
			end
		end
		return out
	end
	local L, tier = nil, nil
	for _, name in ipairs(RESULT_TIERS) do
		L, tier = layoutWith(RESULT_ROWS[name]), name
		local okRoom, room = pcall(resultRoom, L.Rows.W)
		if not okRoom or type(room) ~= "number" or L.PanelH <= room then
			break
		end
	end
	local R = L.Rows
	local TITLE_H, REASON_H, ROW_H, MEMBER_H, FOOT_H = R.Title, R.Reason, R.Row, R.Member, R.Foot
	local titleY, diffY, reasonY, statsY, membersY, footY = L.TitleY, L.DiffY, L.ReasonY, L.StatsY, L.MembersY, L.FootY
	local showMembers = L.Members
	local panelH, panelW = L.PanelH, R.W
	result.Height, result.Width = panelH, panelW

	-- (kit B U9-9) the Signboard skin: wood frame, stone body and its lip, the red close block; the awning as wide as the
	-- card (the pitch's roof reaches 10 px past each side; a fixed size, never stretched)
	local panel = CloudUI.Panel({
		Name = "ResultCard",
		Skin = "Signboard",
		Size = UDim2.fromOffset(panelW, panelH),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = resultPosition(1.8, panelH, panelW),
		Closable = true,
		CloseBlock = false, -- (merge U9-9 x kitb-look1) the close sits in the banner's face, sized and drawn below
		OnClose = function()
			closeResults(false)
		end,
		Parent = UI.ResultHolder,
	})
	panel.Body.Active = false
	if panel.Roof then
		panel.Roof.Size = UDim2.fromOffset(panelW + 2 * RESULT_ROOF_OVER, panel.Roof.Size.Y.Offset)
	end
	addViewportScale(panel.Root)
	local inner = newFrame(panel.Content, "Inner", {
		Position = UDim2.new(0, 4, 0, 2 - R.Trim),
		Size = UDim2.new(1, -8, 1, -4 + R.Trim),
	})
	panel.Root:SetAttribute("Compact", R ~= RESULT_ROWS.Full)
	panel.Root:SetAttribute("Rows", tier) -- (U9-9 review) Full / Compact / Mini, (P2 fix A) Micro
	-- (U9-9 look) the card is a crisp root: it slides in, and its blocks and icons sit on whole px of it at rest
	PixelCrisp.Root(panel.Root)

	-- (U9-9 look) one grammar with the run's other end cards (U9-6 RUN OVER, U9-7 FLOOR CLEARED): the outcome on the stone
	-- body's lip (green for a win, red for a loss) and two dark nails at the body's top corners (U9-7's SignKit.Nails look:
	-- WoodDark, 4 px, 5 in); the awning and the banner stay this card's own
	local stone = panel.Body and panel.Body:FindFirstChild("Stone")
	local stoneLip = stone and stone:FindFirstChild("Lip")
	if stoneLip then
		stoneLip.BackgroundColor3 = won and SIGN.GrassLip or SIGN.RedLip
		stoneLip:SetAttribute("Outcome", won and "Win" or "Loss")
		PixelCrisp.Lip(stoneLip, stoneLip.Size.Y.Offset)
	end
	if stone then
		-- on the root over the content: the compact cards' banner rides up under the awning (Trim), and the nails hold it
		local inX, inY = stone.Position.X.Offset + RESULT_NAIL_IN, stone.Position.Y.Offset + RESULT_NAIL_IN
		for _, side in ipairs({ 0, 1 }) do
			local nail = newFrame(panel.Root, side == 0 and "NailL" or "NailR", {
				AnchorPoint = Vector2.new(side, 0),
				Position = UDim2.new(side, side == 0 and inX or -inX, 0, inY),
				Size = UDim2.fromOffset(RESULT_NAIL, RESULT_NAIL),
				BackgroundTransparency = 0,
				BackgroundColor3 = SIGN.WoodDark,
				ZIndex = 9,
			})
			nail:SetAttribute("SignKit", "Nail")
			PixelCrisp.Adopt(nail, RESULT_NAIL) -- a whole-px square on a whole px
		end
	end

	-- the headline: a banner block across the card's top (VICTORY! gold, DEFEAT stone with the loss's red lip) with brown
	-- words, a plain Section title (a pop-up's title: the window ribbon is for window names); the red close block sits on
	-- its right end, inside the banner's face above its lip
	local banner = newFrame(inner, "Banner", {
		Position = UDim2.fromOffset(0, titleY),
		Size = UDim2.new(1, 0, 0, TITLE_H),
	})
	local bannerEdge, bannerLip = CloudUI.SignBlock(banner, won and "Selected" or "Stone", {
		EdgePx = 3,
		LipPx = RESULT_BANNER_LIP,
		Lip = (not won) and SIGN.RedLip or nil,
	})
	PixelCrisp.Edge(bannerEdge, 3)
	PixelCrisp.Lip(bannerLip, RESULT_BANNER_LIP)
	PixelCrisp.Box(banner)
	Theme.StyleTitle(newText(banner, "Headline", won and "VICTORY!" or "DEFEAT", "Title", R.Headline, SIGN.Text, {
		Size = UDim2.new(1, -(R.Close + 10), 1, -RESULT_BANNER_LIP),
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	}), "Section")
	if panel.CloseButton then
		local close = panel.CloseButton
		close.Size = UDim2.fromOffset(R.Close, R.Close)
		close.AnchorPoint = Vector2.new(1, 0.5)
		-- root px: the card's Content sits at (12, the untitled inset), Inner 4 / 2 inside it
		local insetTop2 = CloudUI.ContentInset(false, true)
		close.Position = UDim2.new(1, -(12 + 4 + 6), 0, insetTop2 + 2 - R.Trim + titleY + math.floor((TITLE_H - RESULT_BANNER_LIP) / 2))
		-- (U9-9 look) its wood edge and lip on whole px (2.4 px drew uneven)
		local lipPx = 0
		for _, c in ipairs(close:GetChildren()) do
			if c:IsA("UIStroke") then
				PixelCrisp.Edge(c, c:GetAttribute("CrispEdge") or c.Thickness)
			elseif c.Name == "Lip" and c:IsA("GuiObject") then
				lipPx = c:GetAttribute("CrispLip") or c.Size.Y.Offset
				PixelCrisp.Lip(c, lipPx)
			end
		end
		PixelCrisp.Box(close)
		-- (U9-9 look 2) the X is the pitch's pixel icon (ic("x")) on the card's 2 px cell, brown on the red block, centred in
		-- the face above the lip: NeonKit.CloseMark's four bars turned 45 degrees drew a smooth anti-aliased X beside the
		-- toasts' crisp pixel x. (The same change for every kit B window's close block belongs in NeonKit.CloseMark, a
		-- shared file: raised at the gate)
		local old = close:FindFirstChild("CloseMark")
		local z = old and old.ZIndex or (close.ZIndex + 2)
		if old then
			old:Destroy()
		end
		PixelCrisp.Icon(close, "x", 18, SIGN.Text, {
			Name = "CloseMark",
			Position = UDim2.new(0.5, 0, 0.5, -math.floor(lipPx / 2)),
			ZIndex = z + 1,
		})
		-- (P2 fix A look review r1, major 6: the close was 24 x 24 at 390x844) a thumb's 44 screen px on a touch screen: a
		-- clear hit pad (HitFor) centred on the block, over it (relayout sizes it for the card's scale)
		if UserInputService.TouchEnabled then
			local pad = Instance.new("TextButton")
			pad.Name = "CloseHit"
			pad.Text = ""
			pad.BackgroundTransparency = 1
			pad.AutoButtonColor = false
			pad.BorderSizePixel = 0
			pad.AnchorPoint = Vector2.new(0.5, 0.5)
			pad.Position = UDim2.fromScale(0.5, 0.5)
			pad.ZIndex = z + 2
			pad:SetAttribute("HitFor", "Close")
			pad.Parent = close
			pad.Activated:Connect(function()
				closeResults(false)
			end)
			UI.ResultCloseHit = pad
			UI.ResultCloseSize = R.Close
			sizeCloseHit(currentScale())
		end
	end
	-- (U9-9 look 2) the frame's parts on whole px on all four sides: the stone inside the wood (4.8 px), the awning and
	-- its face (14.4 px high, a 3.2 px border)
	PixelCrisp.Box(panel.Body)
	if stone then
		PixelCrisp.Box(stone)
	end
	if panel.Roof then
		PixelCrisp.Box(panel.Roof)
		local face = panel.Roof:FindFirstChild("Face")
		if face then
			PixelCrisp.Box(face)
		end
	end

	-- (U9-9 look) the difficulty is a role chip in the kit's tag language (as FIGHTER / HELPER and the rarity tags): its
	-- colour on the face, its darker lip, a 2 px wood edge, the word and its stars inside in the ink that reads on it, the
	-- whole chip centred 4 px under the banner (the short bar under the words read as a slip). The mini card has none
	if not R.NoDiff then
		local diffText = tostring(data.DifficultyName or data.DifficultyId or "")
		local k = currentScale()
		-- (kit-b U9 merge check) the chip's word is 18 px under the screen's scale: the face moves the least it takes to read
		-- 4.5:1 (Extreme's red read 3.86:1 with the brown ink); the lip keeps the difficulty's own colour
		local face, ink = Theme.ReadableFace(diffColor, 4.5)
		local stars = math.min(5, math.max(0, math.floor(starCount)))
		local starsW = stars > 0 and (stars * 18 + (stars - 1) * 2 + RESULT_ICON_GAP) or 0
		local chip = newFrame(inner, "DiffChip", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0, diffY + 10),
			Size = UDim2.fromOffset(200, 30),
		})
		local chipEdge, chipLip = CloudUI.SignBlock(chip, { Face = face, Lip = Theme.Darken(diffColor, 0.35), Edge = SIGN.Wood, Text = ink }, {
			EdgePx = 2,
			LipPx = RESULT_BANNER_LIP,
		})
		PixelCrisp.Edge(chipEdge, 2)
		PixelCrisp.Lip(chipLip, RESULT_BANNER_LIP)
		chip:SetAttribute("Difficulty", tostring(data.DifficultyId or ""))
		local diffLabel = newText(chip, "Difficulty", diffText, "Heading", 18, ink, {
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -20, 1, -RESULT_BANNER_LIP),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2,
		})
		if stars > 0 then -- (kit-b U7a) the stars are PixelIcons after the name, (U9-9 look) in the chip's ink
			PixelCrisp.Adopt(PixelIcon.Lead(diffLabel, "star", { After = true, Count = stars, Px = 18, Colour = ink, Gap = RESULT_ICON_GAP }))
		end
		-- the chip as wide as its word (as laid out; a measure until then) and its stars, whole px wide
		local function fitChip()
			local textW = diffLabel.TextBounds.X / math.max(0.01, PixelCrisp.ScaleAbove(diffLabel))
			if textW <= 0 then
				local okW, measured = pcall(Theme.Measure, diffText, "Heading", 18)
				textW = (okW and typeof(measured) == "Vector2") and measured.X or #diffText * 11
			end
			chip.Size = UDim2.fromOffset(PixelCrisp.Len(math.ceil(textW) + starsW + 20, k), 30)
			PixelCrisp.Refresh(chip)
		end
		fitChip()
		diffLabel:GetPropertyChangedSignal("TextBounds"):Connect(fitChip)
		PixelCrisp.Box(chip)
	end
	if reason then
		if R.ShortReason then
			reason = REASON_SHORT[tostring(data.Reason or "defeat")] or reason
		end
		newText(inner, "Reason", reason, "Body", 18, SIGN.TextMuted, {
			Position = UDim2.fromOffset(0, reasonY),
			Size = UDim2.new(1, 0, 0, REASON_H),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
	end

	-- stats
	local serial = result.Serial
	-- (kit B U9-9) a stat row: a stone block (tile face, 2 px wood edge, its lip), the caption and the value brown. (U9-9
	-- look) The block is Row - RowGap high (whole px at 0.8 and 1080p) and its value row ends on the lip, so an 18 px coin
	-- sits inside the face with a pixel clear above it and above the lip
	local function statRow(index, caption, valueText, valueColor)
		local rowY = statsY + (index - 1) * ROW_H
		local bar = newFrame(inner, "Row" .. caption, {
			Position = UDim2.fromOffset(2, rowY + 2),
			Size = UDim2.new(1, -4, 0, ROW_H - R.RowGap),
		})
		local barEdge, barLip = CloudUI.SignBlock(bar, "Stone", { EdgePx = 2, LipPx = RESULT_ROW_LIP })
		PixelCrisp.Edge(barEdge, 2)
		PixelCrisp.Lip(barLip, RESULT_ROW_LIP)
		PixelCrisp.Box(bar)
		newText(bar, "Caption", caption, "Body", 18, SIGN.Text, {
			Position = UDim2.new(0, 10, 0, 0),
			Size = UDim2.new(0.45, 0, 1, -RESULT_ROW_LIP),
		})
		return newText(bar, "Value", valueText, "Heading", R.Value, valueColor, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 0),
			Size = UDim2.new(0.55, 0, 1, -RESULT_ROW_LIP),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
	end
	local coinOpts = { After = true, Gap = RESULT_ICON_GAP, Colour = RESULT_COIN }

	-- MatchTokens is what was PAID OUT to this player (pet TokenBonus and rounding carry included), while
	-- TotalTokens is the course's raw token value, so the two must not be shown as "own / total" ("48 / 24"
	-- with a +100% pet). The row shows the personal payout on its own, like the member list below.
	local ownTokens = math.max(0, math.floor(tonumber(data.MatchTokens) or 0))
	local bonus = math.max(0, math.floor(tonumber(data.Bonus) or 0))
	local seconds = tonumber(data.Seconds) or 0

	-- (P2 fix A) the micro card leaves the Time row out: the Tokens row is its first
	local tokenIndex = 1
	if not R.NoTime then
		statRow(1, "Time", Util.FormatTime(seconds), SIGN.Text)
		tokenIndex = 2
	end
	-- (kit-b U7a) the amounts end in the Cloud Token coin (a PixelIcon after the number)
	local tokenValue = statRow(tokenIndex, "Tokens", "0", SIGN.Text)
	PixelCrisp.Adopt(PixelIcon.Lead(tokenValue, Theme.Currency.Tokens.Icon, coinOpts))
	-- (kit B U9-9) the compact card leaves a missing bonus out (L.Stats 2); (U9-9 look) the mini card shows it in the
	-- Tokens row. (U9-9 look 2) On a gold chip (the kit's Selected face and its lip, the HUD's run chip) left of the total,
	-- so the "+10" reads as the win bonus (plain "11  +10" said nothing)
	local merged = R.MergeBonus and bonus > 0
	local bonusValue = L.Stats >= 3 and statRow(3, "Win bonus", bonus > 0 and "+0" or "-", bonus > 0 and SIGN.Text or SIGN.TextMuted) or nil
	countUp(tokenValue, ownTokens, 0.45, 0.8, function(n)
		return tostring(n)
	end, serial)
	if merged then
		local row = tokenValue.Parent
		local text = "+" .. tostring(bonus)
		local okW, measured = pcall(Theme.Measure, text, "Heading", 18)
		local textW = (okW and typeof(measured) == "Vector2") and measured.X or #text * 11
		local chip = newFrame(row, "BonusChip", {
			AnchorPoint = Vector2.new(1, 0.5),
			Size = UDim2.fromOffset(math.ceil(textW) + 12, RESULT_CHIP_H), -- (PixelCrisp.Box below: on whole px)
			ZIndex = 2,
		})
		-- (no wood edge of its own: in the row's 20 px face the chip's edge doubled the row's wood line; the gold face and
		-- its lip set inside the stone with a clear pixel above and below)
		local chipEdge, chipLip = CloudUI.SignBlock(chip, "Selected", { EdgePx = 2, LipPx = RESULT_CHIP_LIP })
		chipEdge:Destroy()
		PixelCrisp.Lip(chipLip, RESULT_CHIP_LIP)
		chip:SetAttribute("Bonus", bonus)
		newText(chip, "Bonus", text, "Heading", 18, SIGN.Text, {
			Size = UDim2.new(1, 0, 1, -RESULT_CHIP_LIP),
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 3,
		})
		-- 6 px left of the count's first digit (the digits end RESULT_ICON_GAP before the coin, PixelIcon.Lead),
		-- re-placed as the count runs up; in the face above the row's lip
		local function placeChip()
			local k = math.max(0.01, PixelCrisp.ScaleAbove(tokenValue))
			local digits = tokenValue.TextBounds.X
			if digits <= 0 then
				local okV, v = pcall(Theme.Measure, tokenValue.Text, "Heading", R.Value)
				digits = ((okV and typeof(v) == "Vector2") and v.X or 0) * k
			end
			local coin = tokenValue:FindFirstChild("TrailIcon")
			local textR = coin and coin.AbsolutePosition.X - RESULT_ICON_GAP * k or (tokenValue.AbsolutePosition.X + tokenValue.AbsoluteSize.X)
			local fromRight = (row.AbsolutePosition.X + row.AbsoluteSize.X - (textR - digits)) / k
			chip.Position = UDim2.new(1, -math.ceil(fromRight + 6), 0.5, -math.floor(RESULT_ROW_LIP / 2))
		end
		placeChip()
		tokenValue:GetPropertyChangedSignal("TextBounds"):Connect(placeChip)
		tokenValue:GetPropertyChangedSignal("Text"):Connect(placeChip)
		PixelCrisp.Box(chip)
	end
	if bonus > 0 and bonusValue then
		PixelCrisp.Adopt(PixelIcon.Lead(bonusValue, Theme.Currency.Tokens.Icon, coinOpts))
		countUp(bonusValue, bonus, 0.9, 0.7, function(n)
			return "+" .. tostring(n)
		end, serial)
	end

	-- members
	if showMembers then
		-- (kit B U9-9) the compact card lays a team of three or four in two columns: each a name and its tick / cross
		local cols = L.Cols
		for i, m in ipairs(members) do
			local col = (i - 1) % cols
			local line = math.floor((i - 1) / cols)
			local row = newFrame(inner, "Member" .. i, {
				Position = UDim2.new(col / cols, col > 0 and 3 or 0, 0, membersY + line * MEMBER_H),
				Size = UDim2.new(1 / cols, cols > 1 and -3 or 0, 0, MEMBER_H),
			})
			PixelCrisp.Box(row) -- (U9-9 look) on a whole px of the card
			local mine = isLocalName(m.Name)
			-- (kit B U9-9) the player's own line on a pale gold strip (the selected face); every name brown
			if mine then
				row.BackgroundTransparency = 0
				row.BackgroundColor3 = SIGN.Selected
				row:SetAttribute("Mine", true)
			end
			-- (U9-9 look) the amount ends 5 design px (4 px at 0.8) before the tick's 18 px icon, the coin as far before it
			newText(row, "Name", m.Name, "Body", 18, SIGN.Text, {
				Position = UDim2.new(0, 6, 0, 0),
				Size = UDim2.new(1, cols > 1 and -36 or -110, 1, 0),
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
			if cols == 1 then
				local tokens = newText(row, "Tokens", tostring(m.Tokens), "Heading", 18, SIGN.Text, {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -35, 0, 0),
					Size = UDim2.fromOffset(70, MEMBER_H),
					TextXAlignment = Enum.TextXAlignment.Right,
				})
				-- (kit-b U7a) the coin before the amount
				PixelCrisp.Adopt(PixelIcon.Lead(tokens, Theme.Currency.Tokens.Icon, { Gap = RESULT_ICON_GAP, Colour = RESULT_COIN }))
			end
			-- (kit-b U7a) the state is a PixelIcon: a tick when finished, an x when downed (kit B: the grass / red lips'
			-- deep tones that read on stone)
			local mark, stateColor = nil, SIGN.Text
			if m.Finished then
				mark, stateColor = "check", SIGN.GrassLip
			elseif m.Downed then
				mark, stateColor = "x", SIGN.RedLip
			end
			local state = newText(row, "State", "", "Heading", 18, stateColor, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -5, 0, 0),
				Size = UDim2.fromOffset(25, MEMBER_H),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			if mark then
				state:SetAttribute("PixelIcon", mark)
				PixelCrisp.Adopt(PixelIcon.Host(state, mark, 18))
			end
		end
	end

	-- footer: countdown to the lobby
	local footer = newText(inner, "Footer", "", "Toast", 19, SIGN.TextMuted, {
		Position = UDim2.fromOffset(0, footY),
		Size = UDim2.new(1, 0, 0, FOOT_H),
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	PixelCrisp.Refresh(panel.Root) -- (U9-9 look) every block, lip, edge and icon on whole px of the card
	return panel, footer, serial
end

local function showResults(data)
	if type(data) ~= "table" or not UI.ResultHolder then
		return
	end
	closeResults(true)
	result.Serial = result.Serial + 1
	local ok, panel, footer, serial = pcall(buildResults, data)
	if not ok then
		warn("[NotifyController] result card failed: " .. tostring(panel))
		return
	end
	result.Panel = panel
	publishResultCard()

	tween(panel.Root, 0.5, { Position = resultPosition(1) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if data.Won == true then
		burstConfetti(panel.Root, serial)
	end

	-- "Back to lobby in Ns"
	task.spawn(function()
		local deadline = os.clock() + (Config.Match.EndScreenSeconds or 10)
		while result.Serial == serial and footer.Parent do
			local left = math.ceil(deadline - os.clock())
			if left <= 0 then
				footer.Text = "Going back to the lobby..."
				break
			end
			footer.Text = "Back to lobby in " .. tostring(left) .. "s"
			task.wait(0.2)
		end
		-- safety net: the server normally clears MatchState (which closes the card) right about now
		task.wait(5)
		if result.Serial == serial then
			closeResults(false)
		end
	end)
end

local function buildResultHolder()
	local holder, pad = newHolder("ResultHolder")
	UI.ResultHolder = holder
	UI.ResultPad = pad
end

----------------------------------------------------------------------
-- Other players' dash puffs
----------------------------------------------------------------------
local function newEmitter(parent, props)
	local emitter = Instance.new("ParticleEmitter")
	FxSprites.Apply(emitter, props.Sprite) -- props.Sprite: an FxSprites role (texture + flipbook)
	for key, value in pairs(props) do
		if key ~= "Sprite" then
			emitter[key] = value
		end
	end
	emitter.Parent = parent
	return emitter
end

local function dashPuff(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - root.Position).Magnitude > FX_MAX_DISTANCE then
		return
	end

	local feetOffset = 3
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R15 then
		feetOffset = humanoid.HipHeight + root.Size.Y * 0.5
	end
	feetOffset = Util.Clamp(feetOffset, 2, 5)

	local instances = {}
	local soft = Theme.Lighten(Colors.Stamina, 0.55)

	local feet = Instance.new("Attachment")
	feet.Name = "NC_DashFeet"
	feet.Position = Vector3.new(0, -feetOffset + 0.2, 0)
	feet.Parent = root
	table.insert(instances, feet)

	local puff = newEmitter(feet, {
		Name = "NC_DashPuff",
		Sprite = "Puff",
		Color = ColorSequence.new(Colors.Cloud, Colors.CloudShade),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 3.2),
		}),
		Lifetime = NumberRange.new(0.35, 0.6),
		Speed = NumberRange.new(5, 10),
		SpreadAngle = Vector2.new(70, 70),
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Drag = 3,
		LightEmission = 0.05,
		LockedToPart = false,
		Rate = 0,
		Enabled = false,
	})
	puff:Emit(7)

	local sparks = newEmitter(root, {
		Name = "NC_DashSparks",
		Sprite = "Sparkle",
		Color = ColorSequence.new(soft, Colors.Stamina),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Lifetime = NumberRange.new(0.25, 0.45),
		Speed = NumberRange.new(8, 18),
		SpreadAngle = Vector2.new(180, 180),
		Drag = 4,
		LightEmission = 0.8,
		LockedToPart = false,
		Rate = 0,
		Enabled = false,
	})
	sparks:Emit(6)
	table.insert(instances, sparks)

	-- a short ribbon through the torso while the dash lasts
	local top = Instance.new("Attachment")
	top.Name = "NC_DashTrailTop"
	top.Position = Vector3.new(0, 1.2, 0)
	top.Parent = root
	local bottom = Instance.new("Attachment")
	bottom.Name = "NC_DashTrailBottom"
	bottom.Position = Vector3.new(0, -1.4, 0)
	bottom.Parent = root
	table.insert(instances, top)
	table.insert(instances, bottom)

	local trail = Instance.new("Trail")
	trail.Name = "NC_DashTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Lifetime = 0.3
	trail.MinLength = 0.1
	trail.FaceCamera = true
	trail.LightEmission = 0.5
	trail.Color = ColorSequence.new(soft, Colors.Stamina)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0.2),
	})
	trail.Parent = root
	table.insert(instances, trail)

	task.delay(Config.Physics.DashDuration + 0.08, function()
		pcall(function()
			trail.Enabled = false
		end)
	end)
	task.delay(1.2, function()
		for _, inst in ipairs(instances) do
			pcall(function()
				inst:Destroy()
			end)
		end
	end)
end

local function onDashFx(userId)
	if type(userId) ~= "number" or userId == LocalPlayer.UserId then
		return
	end
	local player = Players:GetPlayerByUserId(userId)
	if not player then
		return
	end
	local now = os.clock()
	local last = lastDashFx[userId]
	if last and now - last < FX_MIN_INTERVAL then
		return
	end
	lastDashFx[userId] = now
	dashPuff(player)
end

----------------------------------------------------------------------
-- Remote handlers + wiring
----------------------------------------------------------------------
-- Kind "pull": the line into the system chat (RBXSystem), the rarity word after the last " hatched a " coloured by
-- Config.Rarities. Answers true when it went to the chat; never yields (FindFirstChild, no WaitForChild).
local function pullToChat(text)
	local channels = game:GetService("TextChatService"):FindFirstChild("TextChannels")
	local channel = channels and channels:FindFirstChild("RBXSystem")
	if not (channel and channel:IsA("TextChannel")) then
		return false
	end
	local line = text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")
	local at, from = nil, 1
	while true do -- the last " hatched a " (a display name could hold the words too)
		local s, e = string.find(line, " hatched a ", from, true)
		if not s then
			break
		end
		at, from = e, e + 1
	end
	local word = at and string.match(line, "^(%a+)", at + 1)
	-- Config.Eggs.ChatColors overrides a rarity colour that reads badly on the dark chat (Secret's near-black; Task 26)
	local chat = type(Config.Eggs) == "table" and type(Config.Eggs.ChatColors) == "table" and Config.Eggs.ChatColors or {}
	for _, rarity in ipairs(Config.Rarities) do
		local color = word and rarity.Id == word and (typeof(chat[word]) == "Color3" and chat[word] or rarity.Color)
		if typeof(color) == "Color3" then
			line = string.sub(line, 1, at) .. '<font color="' .. hex(color) .. '">' .. word .. "</font>" .. string.sub(line, at + 1 + #word)
			break
		end
	end
	channel:DisplaySystemMessage(line)
	return true
end

-- which held toast leaves when the list is full: the oldest low-value one (HELD_LOW), else the oldest that is not
-- Keep, else the oldest
local function heldVictim()
	local plain = nil
	for i, entry in ipairs(held) do
		if not entry.Keep then
			local _, name = kindColor(entry.Kind)
			if HELD_LOW[name] then
				return i
			end
			plain = plain or i
		end
	end
	return plain or 1
end

-- parks a toast while held (the title screen); an identical one already parked only counts up
local function holdToast(text, kind, duration, keep)
	local now = os.clock()
	for _, entry in ipairs(held) do
		if entry.Text == text and entry.Kind == kind then
			entry.Count = entry.Count + 1
			entry.At = now
			entry.Duration = duration
			entry.Keep = entry.Keep or keep
			return
		end
	end
	table.insert(held, { Text = text, Kind = kind, Duration = duration, Keep = keep, Count = 1, At = now })
	while #held > HELD_MAX do
		table.remove(held, heldVictim())
	end
end

-- opts (4th argument, optional table): System = true shows it even while held (the save-wait toasts: they describe the
-- moment, so they must not arrive late); Keep = true keeps it through the hold's age limit and its cap (the join welcome)
local function onNotify(text, kind, duration, opts)
	opts = type(opts) == "table" and opts or nil
	if kind == "pull" then
		-- a chat line, not a toast: never held (the chat is not the title screen's toast column)
		local ok, shown = pcall(pullToChat, tostring(text))
		if ok and shown then
			return
		end
		kind = "good" -- no chat channel (or it failed): today's toast
	end
	if next(holders) ~= nil and kind ~= "bad" and not (opts and opts.System == true) then
		holdToast(tostring(text), kind, duration, opts ~= nil and opts.Keep == true)
		return
	end
	addToast(text, kind, duration)
end

local function onMatchResult(data)
	showResults(data)
end

local function onMatchState(state)
	-- the server clears MatchState when it sends the player back to the lobby
	if state == nil then
		closeResults(false)
	end
end

-- Remotes.Get yields until the folder replicates, so every hook runs in its own thread.
local function hook(name, handler)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, name)
		if not ok or not remote then
			warn("[NotifyController] remote " .. name .. " unavailable: " .. tostring(remote))
			return
		end
		remote.OnClientEvent:Connect(function(...)
			local okCall, err = pcall(handler, ...)
			if not okCall then
				warn("[NotifyController] " .. name .. " handler failed: " .. tostring(err))
			end
		end)
	end)
end

local function hookCamera()
	local cameraConn = nil
	local function bind()
		if cameraConn then
			cameraConn:Disconnect()
			cameraConn = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				pcall(relayout)
			end)
		end
		pcall(relayout)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bind)
	bind()
	task.delay(0.5, function()
		pcall(relayout)
	end)
	task.delay(2, function()
		pcall(relayout)
	end)
end

-- (roll-look review round 1) a local toast, as the Notify remote would show it: for the menu's side hint while its gui
-- (NimbusMenu) is off (the egg stage hides the HUD; NimbusNotify stays). -> true when shown (or queued for room, or held)
function NotifyController.Toast(text, kind, duration)
	if not initialized or not UI.Stack or type(text) ~= "string" then
		return false
	end
	local ok = pcall(onNotify, text, kind or "info", duration)
	return ok
end

-- (quick wins, win 1) owner-keyed hold of the gameplay toasts (see the header). Letting go as the last owner drops the
-- stale ones (older than HELD_SECONDS, unless Keep) and shows the rest one by one in the order sent (drainReleased);
-- an owner that never held changes nothing.
function NotifyController.SetHeld(who, on)
	if type(who) ~= "string" or who == "" then
		return
	end
	if on == true then
		holders[who] = true
		return
	end
	if holders[who] == nil then
		return
	end
	holders[who] = nil
	if next(holders) ~= nil then
		return
	end
	local now = os.clock()
	for _, entry in ipairs(held) do
		if entry.Keep or now - entry.At <= HELD_SECONDS then
			table.insert(released, entry)
		end
	end
	held = {}
	if not drainArmed then
		drainReleased()
	end
end

function NotifyController.IsHeld()
	return next(holders) ~= nil
end

function NotifyController.Init()
	if initialized then
		return
	end
	initialized = true
	if not LocalPlayer then
		return
	end

	-- hook the remotes first so nothing sent while the GUI builds is lost to a yield
	hook("Notify", onNotify)
	hook("MatchResult", onMatchResult)
	hook("MatchState", onMatchState)
	hook("DashFx", onDashFx)

	local ok, err = pcall(function()
		UI.Gui = CloudUI.NewScreenGui("NimbusNotify", 30)
		buildResultHolder() -- first: toasts are created afterwards, so they draw on top of the card
		buildToastStack()
		applyMargins()
		hookCamera()
	end)
	if not ok then
		warn("[NotifyController] GUI setup failed: " .. tostring(err))
	end
	task.spawn(function()
		local okHud, hudErr = pcall(watchHud)
		if not okHud then
			warn("[NotifyController] could not follow the HUD layout: " .. tostring(hudErr))
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastDashFx[player.UserId] = nil
	end)
end

return NotifyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1153">
            <Properties>
              <string name="Name">NpcController</string>
              <string name="Source"><![CDATA[-- NpcController (client): brings the lobby NPC pets to life and shows their dialog (ARCHITECTURE_V3.md section 5).
--
--   NpcController.Init()
--   NpcController.Open(npcId)    opens the dialog of that NPC (what its ProximityPrompt does)
--   NpcController.Close()
--   NpcController.IsOpen() -> bool, npcId | nil
--
-- Idle (client only, the server never moves an NPC): every model tagged NpcDialog.Tag ("NC_Npc") gets a gentle
-- bob, a slow sway, a slow turn toward the nearest player (and toward you while you talk), low-frequency wing
-- flaps through PetBuilder.Animate and a little hop on every new line. To keep this cheap, the pet's static parts
-- are welded (locally) to its anchored PrimaryPart once it has fully replicated, so a pose is ONE CFrame write
-- plus the animated groups (wings, tail...); NPCs further than 140 studs from the camera are frozen, those past
-- 70 studs update every other frame. One RenderStepped connection drives everything.
--
-- Dialog (ScreenGui "NimbusNpcDialog", display order 13): a side card at the BOTTOM-LEFT, above the HUD's
-- bottom block (NimbusHud attribute BottomLeftTop: the bottom-centre vitals card) only when its x-span meets that
-- card (BottomCentreLeft / BottomCentreRight) or the hotbar under it, else near the bottom edge (desktops; touch
-- keeps the HUD's line above the thumbstick), and right of the menu column when they would overlap, never centred. It shows the NPC's name tab, a portrait viewport of the pet, its title, the line in a dark text
-- well with a typewriter reveal (numbers and key phrases highlighted), page dots, and Next / Close buttons.
-- kit B U9-9 (finding 15; it was v3's rounded cloud card with puffs and gradients): the card is a Signboard block, a 6 px
-- wood frame round the stone body with its stone lip, square, no shadow, glow or gradient. The name rides on a navy plank
-- (its gold-lip edge, its navy lip, two brass rivets) in gold, a plain Section title (a dialog's title, not a window's
-- ribbon); the portrait a sky well in a wood edge with the NPC's accent colour on its lip and a little pixel cloud; the title
-- under it a stone tag; the line brown on a pale well in a wood edge, a stepped pixel tail pointing at the portrait, its
-- highlights the accent / the numbers' gold moved until they read 4.5:1 there; the page dots square blocks (the line shown
-- gold, the rest the sunk well); Next the green plank (the dialog's one action), Close a stone plank. Pixel icons and wood
-- edges land on whole screen pixels at any card scale (client/UI/PixelCrisp).
-- Lines cycle (Next on the last line starts over). Triggering the prompt again (E) also advances; clicking the
-- text finishes the current line. The card closes when you walk away, die or enter a match.
-- Sounds (audio wave 2, client/SoundFx; a missing id is silent): "DialogOpen" when the card opens (not when switching
-- from another NPC mid-dialog), "DialogBlip" every 3rd letter the typewriter shows (never a space / punctuation;
-- Config MinGap), "DialogNext" when Next shows the next line (finishing a line early is silent). The NPC voices
-- (wordless, Config.Audio.Keys.Sfx Npc<Name><Kind>, <Name> = the NpcDialog Id in CamelCase: sparky_fox -> SparkyFox):
--   Greet    Config.Audio.Voice.GreetDelay (0.12 s) after the DialogOpen click, when this NPC's card opens (not when
--            switching mid-dialog), if the card is still open on it
--   Every Next that shows a new line (not a Next that only finishes the typewriter) gets one wordless reaction:
--   Pleased  the new line is the dialog's LAST line, or its text holds a "!"
--   Hmm      any other line (also line 1 again after "Again" on the last line, unless it holds a "!")
-- At most one voice per Voice.Gap (1.5 s) per NPC (a voice inside the gap is dropped), a new voice stops the NPC's
-- previous one, volume / pitch from Config.Audio.Volume / Pitch (0.6, 0.98-1.02). An NPC without voice keys is silent.
-- Designed in 1080p pixels under a UIScale of Theme.ScreenFactor() (body 20, captions 16, buttons 20, name 28),
-- shrunk to fit short screens but never below 14 px text. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local function optionalShared(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[NpcController] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local NpcDialog = optionalShared("NpcDialog")
local PetBuilder = optionalShared("PetBuilder")
local PetCatalog = optionalShared("PetCatalog")

local Client = script.Parent.Parent
local CloudUI = nil
do
	local ok, result = pcall(function()
		return require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
	end)
	if ok and type(result) == "table" then
		CloudUI = result
	end
end
local PixelCrisp = nil -- (kit B U9-9) whole-pixel icons and edges under the card's scale
do
	local ok, result = pcall(function()
		return require(Client:WaitForChild("UI"):WaitForChild("PixelCrisp"))
	end)
	if ok and type(result) == "table" then
		PixelCrisp = result
	end
end

local LocalPlayer = Players.LocalPlayer

local NpcController = {}

----------------------------------------------------------------------
-- Tunables (studs / seconds; UI sizes are design pixels of a 1080p screen)
----------------------------------------------------------------------
local K = {
	CULL = 140, -- NPCs further than this from the camera are frozen
	NEAR = 70, -- beyond this they update every other frame
	LOOK_RANGE = 26, -- they turn toward the nearest player within this distance
	MAX_TURN = math.rad(115),
	TURN_RATE = 2.2,
	TURN_SPEED = math.rad(80), -- max degrees per second: a slow, deliberate turn
	BOB_AMP = 0.22,
	BOB_PERIOD = 3.4,
	ROLL = math.rad(2.2),
	NOD = math.rad(2.6),
	HOP_TIME = 0.42,
	HOP_H = 0.55,
	FLAP = 0.4, -- PetBuilder.Animate flap speed multiplier while idle (about 0.8 beats a second)
	FLAP_TALK = 0.8,
	EXCITE_TALK = 0.35,
	TARGET_REFRESH = 0.25,
	CHECK_EVERY = 0.2,
	LAYOUT_EVERY = 0.5,
	CPS = 50, -- typewriter characters per second
	PAUSE_END = 0.22,
	PAUSE_MID = 0.09,
	READY_TIMEOUT = 12,
	-- dialog card
	W = 540, -- full card
	-- (kit B U9-9) taller than the bubble's 216: the footer clears the stone lip and the line keeps its room. (U9-9 look 2)
	-- the card's lengths are multiples of 10 design px where they can be (whole px at 0.7, 0.8 and 1.0; PixelCrisp snaps
	-- the rest), and the line keeps its room over the page dots under the wider stone between the well and the footer
	H = 230,
	W_MIN = 420, -- compact card for narrow screens (taller, so long lines still fit)
	H_COMPACT = 270,
	TAB_ABOVE = 24, -- the name tab rides this far above the card
	PAD = 14,
	PORTRAIT = 130,
	WELL_X = 160,
	WELL_TOP = 30,
	FOOTER_H = 40,
	NEXT_W = 120,
	CLOSE_W = 110,
	BUTTON_GAP = 14, -- (U9-9 look 2) between Close and Next, the well and the footer, the title tag and Close: one rhythm
	TAB_INSET = 22, -- (U9-9 look 2) the name's room starts this far in from each end of its plank (12 px clear of a rivet)
	NAME_ROW = 20, -- (U9-9 look 2) a name too long for one row at the 20 px floor grows its plank by one row
	TEXT = 20,
	NAME = 28,
	CAPTION = 20, -- the title under the portrait (wraps to two rows when needed)
	BUTTON = 20,
	MIN_SCALE = 0.7, -- every text of the card is >= 20 design px, so 20 * 0.7 = 14 px: the readability floor
	EDGE = 12,
	TOUCH_EDGE = 20,
	GAP = 10,
	MAX_DOTS = 6,
	DISPLAY_ORDER = 13,
	MAX_WIDTH_FRACTION = 0.62, -- on wide screens the card never reaches into the middle of the screen
	SMALL_WIDTH_FRACTION = 0.8, -- small screens have no middle to spare
	SMALL_SCREEN = 1100,
}

local TAU = math.pi * 2
local TAG = (NpcDialog and NpcDialog.Tag) or "NC_Npc"
local SETTINGS = (NpcDialog and NpcDialog.Settings) or {}
local CLOSE_DISTANCE = tonumber(SETTINGS.CloseDistance) or 16
local TOKEN_WORD = (Theme.Currency and Theme.Currency.Tokens and Theme.Currency.Tokens.Word) or "Tokens" -- (kit-b U7a) "50 Tokens"

-- (kit B U9-9) the Signboard palette (Theme.Sign)
local SIGN = Theme.Sign
local C = {
	White = Theme.Colors.White,
	Gold = SIGN.Gold,
	Text = SIGN.Text,
	Well = SIGN.Tile, -- the line's pale well
	DotOff = SIGN.Well,
}
K.FRAME = 6 -- the card's wood frame
K.EDGE_PX = 2 -- a block's wood edge (the well, the title tag, the dots)
K.PORTRAIT_EDGE = 3 -- the portrait's wood edge
K.PORTRAIT_LIP = 6 -- its lip in the NPC's accent colour
K.TAG_LIP = 3
K.NAME_LIP = 5 -- the name plank's navy lip
-- (kit B U9-9) the card's rows (design px): Well = the well's room under it (the footer, its gaps and the stone lip),
-- FootUp = the footer's offset from the card's bottom (its height and the room under it), Lip = the stone lip, Tab = the
-- name plank's height and TabAbove how far it rides over the card (its edge included; it ends 24 px into the card).
-- (U9-9 review) Short: a phone too short for the card even at MIN_SCALE (360 px tall: the top bar's pill drew over the
-- name plank) takes the 12 px back from the footer's gaps and the lip (Cut: the old bubble's 216 / 250 again, the line
-- keeps its room) and a plank 8 px lower, so the plank clears the pill. (U9-9 look 2) Well - FootUp is the stone between
-- the well and the footer: BUTTON_GAP on the tall card (the one rhythm: 14 between the buttons, 14 over them), 12 on the
-- short one (the 94 px line room allows no more), so their whole-px wood edges never meet (4 px of stone or more at 0.7;
-- 10 drew 3 px)
K.ROWS = {
	Tall = { Cut = 0, Well = 36, FootUp = 22, Lip = 8, Tab = 46, TabAbove = K.TAB_ABOVE, TitleTag = 50 },
	Short = { Cut = 12, Well = 26, FootUp = 14, Lip = 4, Tab = 38, TabAbove = K.TAB_ABOVE - 8, TitleTag = 46 },
}
K.DOT = 10
K.DOT_GAP = 8
-- (U9-9 look) a portrait phone's compact card is this much taller (there is free sky above it): its six-line speech kept 6
-- px over the page dots at the 0.7 floor
K.PORTRAIT_EXTRA = 30
K.PILL_GAP = 4 -- the name plank stays this far under the top bar's pill (NimbusTopBar, display order 21: it draws over us)
K.ICON = 18 -- the pixel icons (the cloud, the "more" chevron): 18 screen px everywhere (PixelCrisp), their slot 18 / k

-- `color` moved towards the brown ink until it reads `need`:1 on the line's pale well (a highlight keeps its hue)
local function inkOnWell(color, need)
	need = need or 4.5
	local out = color
	for step = 1, 20 do
		if Theme.Contrast(out, C.Well) >= need then
			return out
		end
		out = color:Lerp(SIGN.Text, step * 0.05)
	end
	return SIGN.Text
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local recs = {} -- array of NPC records
local byModel = {} -- [model] = record
local pending = {} -- [model] = true while waiting for it to replicate
local talkedTo = {} -- [npcId] = true once the local player has talked to it (hides the "!" badge)
local promptServiceHooked = false
local lastTrigger = {} -- [prompt] = clock of the last accepted trigger (guards double events)

local clock = 0
local loopConn = nil
local targetTimer = 0
local checkTimer = 0
local layoutTimer = 0
local initialized = false

-- (audio wave 2) the sounds
local BLIP_EVERY = 3 -- a DialogBlip on every 3rd visible letter
local VOICE = (type(Config.Audio) == "table" and type(Config.Audio.Voice) == "table") and Config.Audio.Voice or {}
local VOICE_GAP = tonumber(VOICE.Gap) or 1.5
local GREET_DELAY = tonumber(VOICE.GreetDelay) or 0.12
local voices = {} -- [npcId] = { At = os.clock() of its last voice, Sound = the Sound it played }
local soundFxMod = nil
local function soundFx()
	if soundFxMod == nil then
		local module = Client:FindFirstChild("SoundFx")
		local ok, mod = false, nil
		if module then
			ok, mod = pcall(require, module)
		end
		soundFxMod = (ok and type(mod) == "table" and type(mod.Play) == "function") and mod or false
	end
	return soundFxMod or nil
end
local function playSfx(name)
	local SF = soundFx()
	if not SF then
		return nil
	end
	local ok, s = pcall(SF.Play, name)
	return ok and s or nil
end

-- "sparky_fox" -> "SparkyFox"
local function camelId(id)
	local out = string.gsub(tostring(id or ""), "(%w)(%w*)", function(a, b)
		return string.upper(a) .. b
	end)
	return (string.gsub(out, "[^%w]", ""))
end

-- the NPC's voice of `kind` ("Greet" | "Hmm" | "Pleased"); -> the Sound or nil (no key / id, inside the gap)
local function playVoice(rec, kind)
	if not rec or type(rec.Id) ~= "string" then
		return nil
	end
	local SF = soundFx()
	if not SF then
		return nil
	end
	local name = "Npc" .. camelId(rec.Id) .. kind
	if type(SF.Id) == "function" and SF.Id("Sfx", name) == nil then
		return nil -- (no voice for this NPC: silent, the gap untouched)
	end
	local now = os.clock()
	local v = voices[rec.Id]
	if v and v.At and now - v.At < VOICE_GAP and now >= v.At then
		return nil
	end
	if v and v.Sound then
		pcall(function()
			v.Sound:Stop() -- (never two voices of one NPC at once)
		end)
	end
	local ok, s = pcall(SF.Play, name)
	if not ok or typeof(s) ~= "Instance" then
		return nil
	end
	voices[rec.Id] = { At = now, Sound = s }
	return s
end

local UI = {}
local dialog = {
	Open = false,
	Rec = nil,
	Lines = nil,
	Index = 1,
	Chars = {},
	Total = 0,
	Shown = 0,
	Timer = 0,
	Typing = false,
	Viewport = nil,
	SlideTween = nil,
	PendingOpen = nil, -- an NPC model whose prompt was used before it finished replicating
	Width = nil,
	VitalsOff = false, -- (U9-9 look) the HUD's vitals card is stepped aside under the card (HudController.SetVitalsHidden)
	ColumnCover = nil, -- (kit-b backlog 21 / 31) the card's left edge while it lies over the menu tiles (setColumnCover)
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- (kit B U9-9) a block's wood edge: a mitred border stroke named SignEdge, kept on whole screen pixels
local function edge(parent, color, px)
	local s = make("UIStroke", {
		Name = "SignEdge",
		Color = color or SIGN.Wood,
		Thickness = px,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
	}, parent)
	if PixelCrisp then
		PixelCrisp.Edge(s, px)
	end
	return s
end

-- a flat lip along the bottom of `parent` (px tall), (U9-9 look) whole screen px at any card scale
local function lipOf(parent, color, px)
	local lip = make("Frame", {
		Name = "Lip",
		BorderSizePixel = 0,
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, px),
		ZIndex = parent.ZIndex,
	}, parent)
	if PixelCrisp then
		PixelCrisp.Lip(lip, px)
	end
	return lip
end

-- (U9-9 look) a block's top-left on a whole screen px of the card (PixelCrisp.Box)
local function crispBox(obj)
	if PixelCrisp and obj then
		PixelCrisp.Box(obj)
	end
	return obj
end

local function box(name, props, parent)
	local f = make("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 }, nil)
	for k, v in pairs(props) do
		f[k] = v
	end
	if parent then
		f.Parent = parent
	end
	return f
end

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

local function hex(c)
	return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function playerGui()
	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

local function localRoot()
	local char = LocalPlayer and LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function topInset()
	local ok, inset = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(inset) == "Vector2" then
		return inset.Y
	end
	return 0
end

-- y offset that converts another gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

local function rectOf(inst, dy)
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	return { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

----------------------------------------------------------------------
-- Rich text: numbers and key phrases of a line are highlighted
----------------------------------------------------------------------
local function escapeRich(s)
	return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function isWordChar(ch)
	return ch ~= nil and ch ~= "" and string.find(ch, "^[%w]") ~= nil
end

-- returns richText, plainText
local function richLine(text, def, accent)
	text = tostring(text or "")
	local spans = {}
	local function free(s, e)
		for i = 1, #spans do
			local sp = spans[i]
			if s <= sp[2] and e >= sp[1] then
				return false
			end
		end
		return true
	end
	-- (kit B U9-9) on the pale well: the accent and the numbers' gold moved until they read (4.5:1)
	local keyColor = hex(inkOnWell(accent))
	local numColor = hex(inkOnWell(SIGN.GoldDeep))
	-- key phrases, longest first, whole words only
	local keys = {}
	if def and type(def.Keywords) == "table" then
		for _, k in ipairs(def.Keywords) do
			if type(k) == "string" and k ~= "" then
				keys[#keys + 1] = k
			end
		end
	end
	table.sort(keys, function(a, b)
		return #a > #b
	end)
	for _, k in ipairs(keys) do
		local init = 1
		while true do
			local s, e = string.find(text, k, init, true)
			if not s then
				break
			end
			local before = s > 1 and string.sub(text, s - 1, s - 1) or ""
			local after = string.sub(text, e + 1, e + 1)
			if not isWordChar(before) and not isWordChar(after) and free(s, e) then
				spans[#spans + 1] = { s, e, keyColor }
			end
			init = e + 1
		end
	end
	-- words painted in their own colour (element names), moved until they read on the pale well
	if def and type(def.ColorWords) == "table" then
		for word, color in pairs(def.ColorWords) do
			if type(word) == "string" and word ~= "" and typeof(color) == "Color3" then
				local wordColor = hex(inkOnWell(color))
				local from = 1
				while true do
					local s, e = string.find(text, word, from, true)
					if not s then
						break
					end
					local before = s > 1 and string.sub(text, s - 1, s - 1) or ""
					if not isWordChar(before) and not isWordChar(string.sub(text, e + 1, e + 1)) and free(s, e) then
						spans[#spans + 1] = { s, e, wordColor }
					end
					from = e + 1
				end
			end
		end
	end
	-- numbers: "+10", "x1.5", "1,000 Tokens", "40%", "1.6"
	local init = 1
	while true do
		local s, e = string.find(text, "[%+x]?%d[%d,%.]*%%?", init)
		if not s then
			break
		end
		if string.sub(text, s, s) == "x" and s > 1 and isWordChar(string.sub(text, s - 1, s - 1)) then
			s = s + 1 -- an "x" glued to a word is not a multiplier
		end
		while e > s and string.find(string.sub(text, e, e), "[,%.]") do
			e = e - 1
		end
		local glyph = " " .. TOKEN_WORD
		if string.sub(text, e + 1, e + #glyph) == glyph then
			e = e + #glyph
		end
		if free(s, e) then
			spans[#spans + 1] = { s, e, numColor }
		end
		init = e + 1
	end
	table.sort(spans, function(a, b)
		return a[1] < b[1]
	end)
	local out = {}
	local pos = 1
	for _, sp in ipairs(spans) do
		out[#out + 1] = escapeRich(string.sub(text, pos, sp[1] - 1))
		out[#out + 1] = '<font color="' .. sp[3] .. '">' .. escapeRich(string.sub(text, sp[1], sp[2])) .. "</font>"
		pos = sp[2] + 1
	end
	out[#out + 1] = escapeRich(string.sub(text, pos))
	return table.concat(out), text
end

-- UTF-8 characters of `text` into `into` (reused table); returns the count
local function splitChars(text, into)
	for i = #into, 1, -1 do
		into[i] = nil
	end
	local n = 0
	for ch in string.gmatch(text, "[\1-\127\194-\244][\128-\191]*") do
		n = n + 1
		into[n] = ch
	end
	return n
end

local function charDelay(ch)
	local d = 1 / K.CPS
	if ch == "." or ch == "!" or ch == "?" then
		d = d + K.PAUSE_END
	elseif ch == "," or ch == ":" then
		d = d + K.PAUSE_MID
	end
	return d
end

----------------------------------------------------------------------
-- NPC records
----------------------------------------------------------------------
local function countParts(model)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

local function isComplete(model)
	if model:GetAttribute("Ready") ~= true then
		return false
	end
	local wanted = model:GetAttribute("PetParts")
	if type(wanted) ~= "number" then
		return true -- an NPC without a pet
	end
	local pet = model:FindFirstChild("Pet")
	if not pet then
		return false
	end
	local root = pet.PrimaryPart or pet:FindFirstChild("Body")
	return root ~= nil and countParts(pet) >= wanted
end

-- Parts that PetBuilder.Animate re-poses every call (wings, tail, halo...). Eyelids ("lid" groups) only change
-- transparency, so they stay welded to the body like everything else.
local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

-- Welds every static part of the pet to its anchored root (local to this client): a pose is then one CFrame
-- write on the root. Returns true when the whole pet is welded.
local function weldStatic(pet, root)
	local ok, err = pcall(function()
		local inv = root.CFrame:Inverse()
		for _, part in ipairs(pet:GetDescendants()) do
			if part:IsA("BasePart") and part ~= root and not isAnimatedPart(part) then
				local weld = Instance.new("Weld")
				weld.Name = "NpcIdleWeld"
				weld.Part0 = root
				weld.Part1 = part
				weld.C0 = inv * part.CFrame
				weld.C1 = CFrame.new()
				weld.Parent = part
				part.Anchored = false
			end
		end
		root.Anchored = true
	end)
	if not ok then
		warn("[NpcController] could not weld an NPC pet, using PivotTo: " .. tostring(err))
	end
	return ok
end

local function scaleNameplate(rec)
	local gui = rec.Nameplate
	if not gui or not gui.Parent then
		return
	end
	local w = tonumber(gui:GetAttribute("BaseWidth"))
	local h = tonumber(gui:GetAttribute("BaseHeight"))
	local plate = gui:FindFirstChild("Plate")
	if not (w and h and plate and plate:IsA("GuiObject")) then
		return
	end
	local f = Theme.ScreenFactor()
	gui.Size = UDim2.fromOffset(math.floor(w * f + 0.5), math.floor(h * f + 0.5))
	local scale = plate:FindFirstChild("ReadScale")
	if not (scale and scale:IsA("UIScale")) then
		scale = make("UIScale", { Name = "ReadScale" }, plate)
	end
	scale.Scale = f
end

local function refreshBadge(rec)
	if rec.Badge then
		rec.Badge.Visible = not talkedTo[rec.Id]
	end
end

local onPrompt -- forward declaration (the dialog section defines it)
local ensureLoop

local function removeRec(rec)
	for i = #recs, 1, -1 do
		if recs[i] == rec then
			table.remove(recs, i)
		end
	end
	if rec.Model then
		byModel[rec.Model] = nil
	end
	if rec.PromptConn then
		rec.PromptConn:Disconnect()
		rec.PromptConn = nil
	end
	if dialog.Open and dialog.Rec == rec then
		NpcController.Close()
	end
end

local function setup(model)
	if byModel[model] or not model.Parent then
		return
	end
	local id = model:GetAttribute("NpcId")
	if type(id) ~= "string" then
		return
	end
	local rec = {
		Model = model,
		Id = id,
		Def = NpcDialog and NpcDialog.Get(id) or nil,
		Yaw = 0,
		Phase = (#recs * 1.37) % TAU,
		Skip = 0,
		Frame = 0,
		HopT = nil,
		Target = nil,
		AnimOpts = { Flap = K.FLAP, Excited = 0 },
		Accent = model:GetAttribute("Accent"),
	}
	if typeof(rec.Accent) ~= "Color3" then
		rec.Accent = (rec.Def and rec.Def.Accent) or Color3.fromRGB(120, 180, 236)
	end
	local pet = model:FindFirstChild("Pet")
	local root = pet and (pet.PrimaryPart or pet:FindFirstChild("Body"))
	if pet and root and root:IsA("BasePart") then
		rec.Pet = pet
		rec.Root = root
		rec.Base = root.CFrame
		rec.Welded = weldStatic(pet, root)
	end
	local promptPart = model:FindFirstChild("PromptPart")
	rec.Center = (promptPart and promptPart:IsA("BasePart") and promptPart.Position) or (rec.Base and rec.Base.Position)
		or model:GetPivot().Position
	rec.Prompt = model:FindFirstChild("TalkPrompt", true)
	rec.Nameplate = model:FindFirstChild("Nameplate", true)
	rec.Badge = rec.Nameplate and rec.Nameplate:FindFirstChild("Badge", true) or nil
	scaleNameplate(rec)
	refreshBadge(rec)
	if not promptServiceHooked and rec.Prompt and rec.Prompt:IsA("ProximityPrompt") then
		-- ProximityPromptService.PromptTriggered is unavailable: listen on the prompt itself
		local prompt = rec.Prompt
		rec.PromptConn = prompt.Triggered:Connect(function(player)
			onPrompt(prompt, player)
		end)
	end
	recs[#recs + 1] = rec
	byModel[model] = rec
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(game) and byModel[model] == rec then
			removeRec(rec)
		end
	end)
	ensureLoop()
	if dialog.PendingOpen == model then
		dialog.PendingOpen = nil
		task.defer(function()
			if byModel[model] == rec then
				NpcController.Open(rec.Id)
			end
		end)
	end
end

local function track(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	if byModel[model] or pending[model] then
		return
	end
	pending[model] = true
	task.spawn(function()
		local waited = 0
		while waited < K.READY_TIMEOUT and model.Parent and not isComplete(model) do
			task.wait(0.2)
			waited = waited + 0.2
		end
		pending[model] = nil
		if model.Parent then
			local ok, err = pcall(setup, model)
			if not ok then
				warn("[NpcController] NPC setup failed: " .. tostring(err))
			end
		end
	end)
end

local function recByPrompt(prompt)
	for _, rec in ipairs(recs) do
		if rec.Prompt == prompt then
			return rec
		end
	end
	-- a prompt we have not seen yet (the NPC is still replicating): find its NPC model
	local node = prompt
	while node and node ~= Workspace do
		local rec = byModel[node]
		if rec then
			return rec
		end
		node = node.Parent
	end
	return nil
end

----------------------------------------------------------------------
-- Idle animation
----------------------------------------------------------------------
local function refreshTargets()
	local roots = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") then
			roots[#roots + 1] = root
		end
	end
	local mine = localRoot()
	for _, rec in ipairs(recs) do
		local best, bestD = nil, K.LOOK_RANGE
		if dialog.Open and dialog.Rec == rec and mine then
			best = mine
		elseif rec.Center then
			for _, root in ipairs(roots) do
				local d = (root.Position - rec.Center).Magnitude
				if d < bestD then
					best, bestD = root, d
				end
			end
		end
		rec.Target = best
	end
end

local function poseNpc(rec, dt)
	local base = rec.Base
	-- slow turn toward the target (or back to the walkway)
	local desired = 0
	local target = rec.Target
	if target and target.Parent then
		local v = base:PointToObjectSpace(target.Position)
		if v.X * v.X + v.Z * v.Z > 0.25 then
			desired = clamp(math.atan2(-v.X, -v.Z), -K.MAX_TURN, K.MAX_TURN)
		end
	end
	local turn = (desired - rec.Yaw) * (1 - math.exp(-dt * K.TURN_RATE))
	local maxStep = K.TURN_SPEED * dt
	rec.Yaw = rec.Yaw + clamp(turn, -maxStep, maxStep)

	local talking = dialog.Open and dialog.Rec == rec
	local t = clock + rec.Phase
	local y = math.sin(t * TAU / K.BOB_PERIOD) * K.BOB_AMP
	if rec.HopT then
		rec.HopT = rec.HopT + dt
		local u = rec.HopT / K.HOP_TIME
		if u >= 1 then
			rec.HopT = nil
		else
			y = y + 4 * u * (1 - u) * K.HOP_H
		end
	end
	local pitch = 0
	if talking then
		local amount = 0.35
		if dialog.Typing then
			amount = 1
		end
		pitch = math.sin(t * 7.5) * K.NOD * amount
	end
	local roll = math.sin(t * 0.83) * K.ROLL
	local cf = base * CFrame.new(0, y, 0) * CFrame.Angles(0, rec.Yaw, 0) * CFrame.Angles(pitch, 0, roll)
	if rec.Welded then
		rec.Root.CFrame = cf
	else
		rec.Pet:PivotTo(cf)
	end

	local opts = rec.AnimOpts
	if talking then
		opts.Flap = K.FLAP_TALK
		opts.Excited = K.EXCITE_TALK
	else
		opts.Flap = K.FLAP
		opts.Excited = 0
	end
	if PetBuilder and PetBuilder.Animate then
		local ok = pcall(PetBuilder.Animate, rec.Pet, clock, opts)
		if not ok then
			rec.Pet = nil -- a broken rig: keep the NPC still from now on
		end
	end
end

-- distance from an NPC to the viewer: the camera or the local character, whichever is closer
local function viewDistance(pos, camPos, rootPos)
	local d = math.huge
	if camPos then
		d = (pos - camPos).Magnitude
	end
	if rootPos then
		d = math.min(d, (pos - rootPos).Magnitude)
	end
	if d == math.huge then
		return 0
	end
	return d
end

local function stepNpcs(dt, camPos, rootPos)
	for i = 1, #recs do
		local rec = recs[i]
		if rec.Pet and rec.Root and rec.Root.Parent then
			local d = viewDistance(rec.Base.Position, camPos, rootPos)
			if d <= K.CULL then
				rec.Frame = rec.Frame + 1
				rec.Skip = rec.Skip + dt
				if d <= K.NEAR or rec.Frame % 2 == 0 then
					local step = math.min(rec.Skip, 0.1)
					rec.Skip = 0
					poseNpc(rec, step)
				end
				-- (Pitch 2 item 04 B) the "!" is a gold block pinned on the sign's corner: it stays still (kit B world
				-- signs never sway; the old "new tips" wiggle turned it 12 degrees off the pixel grid)
			else
				rec.Skip = 0
			end
		end
	end
end

----------------------------------------------------------------------
-- Dialog UI
----------------------------------------------------------------------
local function newButton(text, style, size, callback, parent)
	if CloudUI and CloudUI.Button then
		local ok, button = pcall(CloudUI.Button, {
			Name = "Button_" .. text,
			Text = text,
			Style = style,
			Skin = "Sign", -- (kit B U9-9) a plank with its lip: a press sinks it onto the lip
			Size = size,
			TextSize = K.BUTTON,
			Callback = callback,
			Parent = parent,
		})
		if ok and button then
			return button
		end
	end
	local button = make("TextButton", {
		Name = "Button_" .. text,
		Size = size,
		AutoButtonColor = true,
		BorderSizePixel = 0,
		BackgroundColor3 = style == "Green" and SIGN.Grass or SIGN.Tile,
		Text = text,
	}, nil)
	Theme.Style(button, "Button", { Size = K.BUTTON, Color = style == "Green" and SIGN.OnGrass or SIGN.Text })
	edge(button, SIGN.Wood, 3)
	button.Activated:Connect(function()
		callback(button)
	end)
	button.Parent = parent
	return button
end

-- (kit B U9-9) the speech tail: a stepped pixel wedge (rows of 4 px, 4 / 8 / 12 / 8 / 4 wide) in the wood colour, its
-- point at the portrait, its base on the well's left edge
local TAIL_ROWS = { 4, 8, 12, 8, 4 }

local function buildDialog()
	local gui
	if CloudUI and CloudUI.NewScreenGui then
		gui = CloudUI.NewScreenGui("NimbusNpcDialog", K.DISPLAY_ORDER)
	else
		local pg = playerGui()
		local old = pg and pg:FindFirstChild("NimbusNpcDialog")
		if old then
			old:Destroy()
		end
		gui = make("ScreenGui", {
			Name = "NimbusNpcDialog",
			ResetOnSpawn = false,
			IgnoreGuiInset = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			DisplayOrder = K.DISPLAY_ORDER,
		}, pg)
	end
	UI.Gui = gui

	local root = box("NpcDialog", {
		Position = UDim2.new(0, K.EDGE, 1, -220 - K.H), -- (U9-9 look) by its top-left corner (layoutDialog)
		Size = UDim2.fromOffset(K.W, K.H),
		Visible = false,
	}, gui)
	UI.Root = root
	UI.Scale = make("UIScale", { Name = "ReadScale", Scale = 1 }, root)

	local slide = box("Slide", { Size = UDim2.fromScale(1, 1) }, root)
	UI.Slide = slide
	if PixelCrisp then
		PixelCrisp.Root(slide) -- (U9-9 look) it slides in; the card's parts sit on whole px of it at rest
	end

	-- the card: the wood frame round the stone body, its stone lip along the bottom (the Signboard window's parts)
	local card = box("Card", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Wood,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Active = true, -- clicks on the card never fall through to the world
	}, slide)
	card:SetAttribute("SignKit", "Frame")
	local stone = box("Stone", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME),
		ZIndex = 3,
	}, card)
	stone:SetAttribute("SignKit", "Body")
	UI.StoneLip = lipOf(stone, SIGN.StoneLip, K.ROWS.Tall.Lip)
	-- (U9-9 look 2) the card and the stone in it on whole px on all four sides: the wood frame round the stone is whole
	-- px wide on every side at any card scale (it drew 4.8 / 4.2 px, one side crisp and the other soft)
	UI.Card = crispBox(card)
	crispBox(stone)
	-- (Pitch 2 F0, finish pass A) the frame's light, the card's shadow, the stone sunk under the frame with its carved rim
	local SK = optionalShared("SignKit")
	if SK and SK.FinishFrame then
		SK.FinishFrame(card, { Body = stone })
	end

	-- portrait: a sky well in a wood edge, the NPC's accent colour on its lip, a little pixel cloud in its corner
	local portrait = box("Portrait", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Sky,
		Position = UDim2.fromOffset(K.PAD, 16),
		Size = UDim2.fromOffset(K.PORTRAIT, K.PORTRAIT),
		ZIndex = 5,
	}, card)
	edge(portrait, SIGN.Wood, K.PORTRAIT_EDGE)
	UI.PortraitLip = lipOf(portrait, SIGN.SkyLip, K.PORTRAIT_LIP)
	UI.PortraitLip.ZIndex = 8 -- over the pet's feet, like the ground it stands on
	UI.Portrait = crispBox(portrait)
	UI.PortraitHolder = box("Holder", { Size = UDim2.new(1, 0, 1, -K.PORTRAIT_LIP), ZIndex = 6 }, portrait)
	if PixelCrisp then
		-- (anchored at its top-left corner: at a 0.7 card its 18 screen px grow into the sky, away from the frame)
		PixelCrisp.Icon(portrait, "cloud", K.ICON, SIGN.Stone, {
			Name = "Cloud",
			AnchorPoint = Vector2.new(0, 0),
			Position = UDim2.fromOffset(6, 4),
			ZIndex = 6,
		})
	end

	-- title caption under the portrait: a stone tag ((U9-9 look) 50 high on the tall card: its two rows of words clear
	-- of its edge and lip). (U9-9 look 2) PORTRAIT + 2 wide: its 2 px edge lines up with the portrait's 3 px edge; its
	-- bottom on the footer's bottom line (layoutDialog)
	local titlePill = box("TitlePill", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Tile,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(K.PAD + K.PORTRAIT / 2, 16 + K.PORTRAIT + 12),
		Size = UDim2.fromOffset(K.PORTRAIT + 2, K.ROWS.Tall.TitleTag),
		ZIndex = 6,
	}, card)
	UI.TitleStroke = edge(titlePill, SIGN.Wood, K.EDGE_PX)
	lipOf(titlePill, SIGN.StoneLip, K.TAG_LIP)
	UI.TitlePill = crispBox(titlePill)
	UI.Title = Theme.Label("", "Label", {
		Size = K.CAPTION,
		Color = SIGN.Text,
		Props = {
			Name = "Title",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, -1),
			Size = UDim2.new(1, -10, 1, -(4 + K.TAG_LIP)),
			TextWrapped = true,
			LineHeight = 0.9,
			ZIndex = 7,
		},
	})
	UI.Title.Parent = titlePill

	-- the name on a navy plank riding on the top edge: gold, a plain Section title; a brass rivet at each end
	local nameTab = box("NameTab", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Navy,
		Position = UDim2.fromOffset(K.WELL_X, -22),
		Size = UDim2.fromOffset(250, 46),
		ZIndex = 8,
	}, slide)
	edge(nameTab, SIGN.GoldLip, 3)
	lipOf(nameTab, SIGN.NavyLip, K.NAME_LIP)
	for _, side in ipairs({ { "RivetL", 0, 6 }, { "RivetR", 1, -10 } }) do
		local rivet = box(side[1], {
			BackgroundTransparency = 0,
			BackgroundColor3 = SIGN.Brass,
			Position = UDim2.new(side[2], side[3], 0.5, -4),
			Size = UDim2.fromOffset(4, 4),
			ZIndex = 9,
		}, nameTab)
		if PixelCrisp then
			PixelCrisp.Adopt(rivet, 4) -- (U9-9 look) a whole-px square on a whole px
		end
	end
	UI.NameTab = crispBox(nameTab)
	UI.Name = Theme.Label("", "Title", {
		Scaled = true,
		Color = SIGN.Gold,
		Props = {
			Name = "Name",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, -2),
			-- (U9-9 look 2) TAB_INSET in from each end: the letters 12 px clear of the brass rivets
			Size = UDim2.new(1, -2 * K.TAB_INSET, 1, -(10 + K.NAME_LIP)),
			ZIndex = 9,
		},
	})
	make("UITextSizeConstraint", { MaxTextSize = K.NAME, MinTextSize = 20 }, UI.Name)
	Theme.StyleTitle(UI.Name, "Section")
	UI.Name.Parent = nameTab

	-- the stepped pixel tail toward the portrait, then the text well (pale, high contrast)
	local tail = box("Tail", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromOffset(K.WELL_X - K.EDGE_PX, K.WELL_TOP + 24),
		Size = UDim2.fromOffset(12, 4 * #TAIL_ROWS),
		ZIndex = 5,
	}, card)
	for i, w in ipairs(TAIL_ROWS) do
		box("Step" .. i, {
			BackgroundTransparency = 0,
			BackgroundColor3 = SIGN.Wood,
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, (i - 1) * 4),
			Size = UDim2.fromOffset(w, 4),
			ZIndex = 5,
		}, tail)
	end
	if PixelCrisp then
		PixelCrisp.Adopt(tail, 4) -- (U9-9 look) its steps whole px each (2.8 px drew uneven), from a whole px
	end
	local well = make("TextButton", {
		Name = "Well",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Well,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(K.WELL_X, K.WELL_TOP),
		Size = UDim2.new(1, -(K.WELL_X + K.PAD), 1, -(K.WELL_TOP + K.FOOTER_H + K.ROWS.Tall.Well)),
		ZIndex = 6,
	}, card)
	edge(well, SIGN.Wood, K.EDGE_PX)
	UI.Well = crispBox(well)
	local line = Theme.Label("", "Body", {
		Size = K.TEXT,
		Color = SIGN.Text,
		Props = {
			Name = "Line",
			RichText = true,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Position = UDim2.fromOffset(14, 10),
			-- the bottom row of the well holds the page dots, (U9-9 look) the speech ends 9 design px (6 px at 0.7) over them
			Size = UDim2.new(1, -28, 1, -37),
			LineHeight = 1.05,
			ZIndex = 7,
		},
	})
	line.Parent = well
	UI.Line = line
	-- the pixel down arrow: "there is more" (kit-b U7b; it was U+25BC), brown, on whole screen pixels
	local more = box("More", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -10, 1, -6),
		Size = UDim2.fromOffset(18, 18),
		Visible = false,
		ZIndex = 8,
	}, well)
	if PixelCrisp then
		-- (U9-9 look) from the slot's top-left, the slot itself on a whole px as it bobs (crispBox)
		PixelCrisp.Icon(more, "down", K.ICON, SIGN.Text, { ZIndex = 8, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(0, 0) })
	end
	UI.More = crispBox(more)

	-- page dots in the bottom row of the well: square blocks in a wood edge (the line shown gold, the rest the sunk well)
	local dots = box("Dots", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -8),
		Size = UDim2.fromOffset(K.MAX_DOTS * (K.DOT + K.DOT_GAP), K.DOT),
		ZIndex = 8,
	}, well)
	UI.Dots = {}
	for i = 1, K.MAX_DOTS do
		local dot = box("Dot" .. i, {
			BackgroundTransparency = 0,
			BackgroundColor3 = C.DotOff,
			Position = UDim2.fromOffset((i - 1) * (K.DOT + K.DOT_GAP), 0),
			Size = UDim2.fromOffset(K.DOT, K.DOT),
			ZIndex = 9,
			Visible = false,
		}, dots)
		edge(dot, SIGN.Wood, K.EDGE_PX)
		if PixelCrisp then
			PixelCrisp.Adopt(dot, K.DOT) -- (U9-9 look) every dot the same whole px square, on a whole px
		end
		UI.Dots[i] = dot
	end

	-- footer: Close (a stone plank), Next (the green plank: the dialog's one action), right-aligned under the well
	local footer = box("Footer", {
		Position = UDim2.new(0, K.WELL_X, 1, -(K.FOOTER_H + K.ROWS.Tall.FootUp)),
		Size = UDim2.new(1, -(K.WELL_X + K.PAD), 0, K.FOOTER_H),
		ZIndex = 6,
	}, card)
	UI.Footer = footer

	UI.Next = newButton("Next", "Green", UDim2.fromOffset(K.NEXT_W, K.FOOTER_H), function()
		NpcController.Advance()
	end, footer)
	UI.Next.AnchorPoint = Vector2.new(1, 0.5)
	UI.Next.Position = UDim2.new(1, 0, 0.5, 0)
	UI.Next.ZIndex = 8
	-- (U9-9 look 2) on the full card Close stands BUTTON_GAP left of Next; the compact card moves it into the left column
	-- under the title tag and Next spans the well (placeButtons)
	UI.Close = newButton("Close", "Gray", UDim2.fromOffset(K.CLOSE_W, K.FOOTER_H), function()
		NpcController.Close()
	end, footer)
	UI.Close.AnchorPoint = Vector2.new(1, 0.5)
	UI.Close.Position = UDim2.new(1, -(K.NEXT_W + K.BUTTON_GAP), 0.5, 0)
	UI.Close.ZIndex = 8
	-- (U9-9 look) the planks' wood edges and lips on whole px at the card's scale (2.1 px drew uneven), from whole px
	if PixelCrisp then
		for _, b in ipairs({ UI.Next, UI.Close }) do
			for _, c in ipairs(b:GetChildren()) do
				if c:IsA("UIStroke") then
					PixelCrisp.Edge(c, c.Thickness)
				elseif c.Name == "Lip" and c:IsA("GuiObject") then
					PixelCrisp.Lip(c, c.Size.Y.Offset)
				end
			end
			PixelCrisp.Box(b)
		end
	end

	well.Activated:Connect(function()
		if dialog.Typing then
			NpcController.Advance()
		end
	end)
end

----------------------------------------------------------------------
-- Dialog layout (bottom-left, above the HUD, clear of the menu column)
----------------------------------------------------------------------
local function menuColumnRect()
	local pg = playerGui()
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	if not (menu and menu:IsA("ScreenGui") and menu.Enabled) then
		return nil
	end
	local dy = insetShift(menu)
	local column = menu:FindFirstChild("MenuColumn", true)
	if column and column:IsA("GuiObject") and shownIn(column, menu) and column.AbsoluteSize.X > 0 then
		return rectOf(column, dy)
	end
	local rect = nil
	for _, d in ipairs(menu:GetDescendants()) do
		if d:IsA("GuiObject") and string.sub(d.Name, 1, 11) == "MenuButton_" and d.AbsoluteSize.X > 0 and shownIn(d, menu) then
			local r = rectOf(d, dy)
			if rect then
				rect.x0, rect.y0 = math.min(rect.x0, r.x0), math.min(rect.y0, r.y0)
				rect.x1, rect.y1 = math.max(rect.x1, r.x1), math.max(rect.y1, r.y1)
			else
				rect = r
			end
		end
	end
	return rect
end

local function tutorialRect()
	local pg = playerGui()
	local gui = pg and pg:FindFirstChild("NimbusTutorial")
	if not (gui and gui:IsA("ScreenGui") and gui.Enabled) then
		return nil
	end
	local panel = gui:FindFirstChild("TutorialPanel", true)
	if panel and panel:IsA("GuiObject") and shownIn(panel, gui) and panel.AbsoluteSize.X > 0 then
		return rectOf(panel, insetShift(gui))
	end
	return nil
end

-- The pet hotbar (NimbusHotbar.Hotbar, bottom centre) in gui-area pixels, nil while hidden or unmeasured.
local function hotbarRect()
	local pg = playerGui()
	local bar = pg and pg:FindFirstChild("NimbusHotbar")
	if not (bar and bar:IsA("ScreenGui") and bar.Enabled) then
		return nil
	end
	local holder = bar:FindFirstChild("Hotbar")
	if holder and holder:IsA("GuiObject") and shownIn(holder, bar) and holder.AbsoluteSize.X > 0 then
		return rectOf(holder, insetShift(bar))
	end
	return nil
end

-- (U9-9 look) the top bar's pill (NimbusTopBar, display order 21: it draws over the card) and its edge in our gui px,
-- nil while it is hidden or unmeasured
local function topBarPillRect()
	local pg = playerGui()
	local bar = pg and pg:FindFirstChild("NimbusTopBar")
	if not (bar and bar:IsA("ScreenGui") and bar.Enabled) then
		return nil
	end
	local pill = bar:FindFirstChild("Pill", true)
	if not (pill and pill:IsA("GuiObject") and shownIn(pill, bar) and pill.AbsoluteSize.X > 0) then
		return nil
	end
	local r = rectOf(pill, insetShift(bar))
	local stroke = pill:FindFirstChildOfClass("UIStroke")
	local e = stroke and stroke.Thickness or 0
	r.x0, r.y0, r.x1, r.y1 = r.x0 - e, r.y0 - e, r.x1 + e, r.y1 + e
	return r
end

-- (U9-9 look) the HUD's vitals card steps aside while the card lies over a part of it (the card stepped down under the
-- top bar's pill), as the result card and the Trove window do; back when it closes
local function setVitalsOff(off)
	if off == (dialog.VitalsOff == true) then
		return
	end
	local module = script.Parent:FindFirstChild("HudController")
	local okHud, hud = false, nil
	if module then
		okHud, hud = pcall(require, module)
	end
	if okHud and type(hud) == "table" and type(hud.SetVitalsHidden) == "function" then
		dialog.VitalsOff = off
		pcall(hud.SetVitalsHidden, "NpcDialog", off)
	end
end

-- (kit-b backlog 21 / 31) the menu tiles step aside while the card lies over them (layoutDialog's last box on a narrow
-- phone: MenuController.SetColumnCovered, the column frame keeping its place); back when it leaves them or closes
local function setColumnCover(left)
	if left == dialog.ColumnCover then
		return
	end
	local module = script.Parent:FindFirstChild("MenuController")
	local okMenu, menu = false, nil
	if module then
		okMenu, menu = pcall(require, module)
	end
	if okMenu and type(menu) == "table" and type(menu.SetColumnCovered) == "function" then
		dialog.ColumnCover = left
		pcall(menu.SetColumnCovered, left, "NpcDialog")
	end
end

-- (kit-b backlog 21 / 31) what a phone draws at the screen's foot, in our gui px: the touch RUN / DASH keys
-- (MovementController's MobileControls, their wood edge counted, as HudController measures them) and Roblox's thumb
-- stick's zone and jump button (where HudController's robloxTouchRects puts them)
local function touchRects(area)
	local out = {}
	local pg = playerGui()
	local mobile = pg and pg:FindFirstChild("MobileControls")
	if mobile and mobile:IsA("ScreenGui") and mobile.Enabled then
		local dy = insetShift(mobile)
		for _, d in ipairs(mobile:GetDescendants()) do
			if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.AbsoluteSize.X > 0 and shownIn(d, mobile) then
				local r = rectOf(d, dy)
				local block = d:FindFirstChild("Block")
				local edge = d:FindFirstChild("SignEdge") or (block and block:FindFirstChild("SignEdge"))
				local e = (edge and edge:IsA("UIStroke")) and edge.Thickness or 0
				r.x0, r.y0, r.x1, r.y1 = r.x0 - e, r.y0 - e, r.x1 + e, r.y1 + e
				table.insert(out, r)
			end
		end
	end
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or area
	local small = math.min(vp.X, vp.Y) <= 500
	local j = small and 70 or 120
	local foot = small and 20 or j * 0.75
	local stickH = small and (vp.Y > vp.X and 150 or 96) or 210
	table.insert(out, { x0 = 0, y0 = area.Y - stickH, x1 = small and 110 or 190, y1 = area.Y })
	table.insert(out, { x0 = area.X - (1.5 * j + 10), y0 = area.Y - foot - j, x1 = area.X - (0.5 * j + 10), y1 = area.Y - foot })
	return out
end

local function syncVitals(card)
	local off = false
	local module = script.Parent:FindFirstChild("HudController")
	local okHud, hud = false, nil
	if module then
		okHud, hud = pcall(require, module)
	end
	if card and okHud and type(hud) == "table" and type(hud.GetLayout) == "function" then
		local okLayout, layout = pcall(hud.GetLayout)
		local slot = okLayout and type(layout) == "table" and layout.VitalsSlot
		if slot then -- (gui-area px of an IgnoreGuiInset = false gui, as ours)
			local w = math.min(card.x1, slot.X + slot.W) - math.max(card.x0, slot.X)
			local h = math.min(card.y1, slot.Y + slot.H) - math.max(card.y0, slot.Y)
			off = w > 4 and h > 4
		end
	end
	setVitalsOff(off)
end

-- Fits the card into the box left..rightLimit x topLimit..bottom (gui px): returns scale, design width, design
-- height and its bottom rows (K.ROWS). Narrow boxes get the compact card, (U9-9 review) a box too short for it even at
-- K.MIN_SCALE the short rows; the scale may come out below K.MIN_SCALE (= does not fit). (U9-9 look) On a portrait
-- screen (`tall`) the compact card is K.PORTRAIT_EXTRA taller: its speech kept clear of the page dots.
-- (U9-9 look 2) the name plank on a card of design width w: on the compact card it spans the well (flush with its right
-- edge), on the full card it is at most 250 wide; its name gets one row, or a second NAME_ROW when the name at the 20 px floor is wider than its room (TAB_INSET in from
-- each end): the plank grows up by that row instead of TextScaled wrapping two rows inside a one-row plank. -> width, extra
local function tabFor(w)
	local tabW = w - K.WELL_X - K.PAD
	if w >= K.W - 60 then
		tabW = math.min(250, tabW) -- (the full card's plank: the compact card's spans its whole well)
	end
	local text = UI.Name and UI.Name.Text or ""
	if text ~= "" then
		local ok, size = pcall(Theme.Measure, text, "Title", 20)
		if ok and typeof(size) == "Vector2" and size.X > tabW - 2 * K.TAB_INSET then
			return tabW, K.NAME_ROW
		end
	end
	return tabW, 0
end

local function fitCard(left, bottom, topLimit, rightLimit, f, tall)
	local availW, availH = rightLimit - left, bottom - topLimit
	if availW <= 0 or availH <= 0 then
		return 0, K.W_MIN, K.H_COMPACT - K.ROWS.Short.Cut, K.ROWS.Short
	end
	local scale = f
	local w = K.W
	if w * scale > availW then
		w = math.max(K.W_MIN, math.floor(availW / scale))
		if w * scale > availW then
			scale = availW / w
		end
	end
	local h = K.H
	if w < K.W - 60 then
		h = K.H_COMPACT + (tall and K.PORTRAIT_EXTRA or 0)
	end
	local _, extra = tabFor(w)
	local rows = K.ROWS.Tall
	if (h + rows.TabAbove + extra) * K.MIN_SCALE > availH then
		rows = K.ROWS.Short
		h = h - rows.Cut
	end
	if (h + rows.TabAbove + extra) * scale > availH then
		scale = availH / (h + rows.TabAbove + extra)
	end
	-- (U9-9 look 2) a fitted scale steps down to a tenth (0.724 -> 0.7): the card's lengths, multiples of 10, are whole px
	-- there (at 0.724 none could be); never under MIN_SCALE (a scale under it still says "does not fit")
	if scale < f and scale >= K.MIN_SCALE then
		scale = math.max(K.MIN_SCALE, math.floor(scale * 10 + 1e-6) / 10)
	end
	return scale, w, h, rows
end

-- (kit-b backlog 21 / 31) the full card at MIN_SCALE as wide as the box left..rightLimit allows (from K.W - 60 design px
-- on; it is shorter than the compact card), its tall or short rows, in the box down to `bottom`: -> scale, width,
-- height, rows, or nil where it does not fit
local function fitWide(left, bottom, topLimit, rightLimit)
	local w = math.min(K.W, math.floor((rightLimit - left) / K.MIN_SCALE))
	if w < K.W - 60 then
		return nil
	end
	local _, extra = tabFor(w)
	for _, rows in ipairs({ K.ROWS.Tall, K.ROWS.Short }) do
		local h = K.H - rows.Cut
		if (h + rows.TabAbove + extra) * K.MIN_SCALE <= bottom - topLimit then
			return K.MIN_SCALE, w, h, rows
		end
	end
	return nil
end

-- (kitb-matchhud look0 N3: at 640 x 360 step 3 below put the full card at 0.7, 494 design px wide, whose line holds four
-- 20 px rows under its well: Granny Owl's and Mayor Panda's speeches wrap to five there, and 'rarer!' / 'there!' were cut)
-- the rows the open dialog's longest page wraps to in a line `width` design px wide, in the Line's font
-- (NpcController.Metrics.MEASURE(label, text, width) -> Vector2 when set: the offline renderer's font metrics, wrapped as
-- it draws; else TextService through Theme.MeasureLabel), cached per dialog and width
NpcController.Metrics = { MEASURE = nil }
local speechCache = { Lines = nil, Rows = {} }
local function speechRows(width)
	local lines = dialog.Lines
	if not (lines and UI.Line) then
		return 0
	end
	if speechCache.Lines ~= lines then
		speechCache.Lines, speechCache.Rows = lines, {}
	end
	local key = math.floor(width)
	if speechCache.Rows[key] then
		return speechCache.Rows[key]
	end
	local rec = dialog.Rec
	local most = 0
	for _, text in ipairs(lines) do
		local _, plain = richLine(text, rec and rec.Def, (rec and rec.Accent) or C.Gold)
		local ok, size = pcall(function()
			local hook = NpcController.Metrics.MEASURE
			if hook then
				return hook(UI.Line, plain, key)
			end
			return Theme.MeasureLabel(UI.Line, plain, K.TEXT, key)
		end)
		if ok and typeof(size) == "Vector2" then
			most = math.max(most, math.floor(size.Y / K.TEXT + 0.5))
		end
	end
	speechCache.Rows[key] = most
	return most
end

-- whether every page of the open dialog fits the line of a card w x h design px with `rows`' well (the Line: the well
-- less 28 x 37 design px; its rows K.TEXT * LineHeight tall)
local function speechFits(w, h, rows)
	local lineW = w - K.WELL_X - K.PAD - 28
	local lineH = h - K.WELL_TOP - K.FOOTER_H - rows.Well - 37
	return speechRows(lineW) * K.TEXT * ((UI.Line and UI.Line.LineHeight) or 1) <= lineH + 0.5
end

local function layoutDialog()
	local gui, root = UI.Gui, UI.Root
	if not (gui and root) then
		return
	end
	local area = gui.AbsoluteSize
	if area.X < 2 or area.Y < 2 then
		local cam = Workspace.CurrentCamera
		local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
		area = Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
	end
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local edge = touch and K.TOUCH_EDGE or K.EDGE
	local tall = area.Y > area.X -- (U9-9 look) a portrait screen: the compact card takes some of its free sky
	local f = Theme.ScreenFactor()
	local rightLimit = area.X * K.MAX_WIDTH_FRACTION
	if area.X < K.SMALL_SCREEN then
		rightLimit = math.max(rightLimit, area.X * K.SMALL_WIDTH_FRACTION)
	end
	rightLimit = math.min(rightLimit, area.X - edge)

	-- bottom: just above the HUD's bottom block (the vitals card, or an estimate of it); top: below the top-left panel
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local bottom = area.Y - edge - 190 * f
	local topLimit = edge
	local centre = nil -- the vitals card's x-span (bug batch 2 #1: it sits bottom-centre, not bottom-left)
	if hud and hud:IsA("ScreenGui") then
		local shift = insetShift(hud)
		local blt = hud:GetAttribute("BottomLeftTop")
		if type(blt) == "number" and blt > 0 then
			-- (kit-b backlog 21 / 31 re-verify: the card's hard shadow - SignKit.FinishFrame's, Theme.Finish.Window px at its
			-- scale, under its bottom edge - came 2 px from the vitals card's name tab at 800 x 450 .. 1024 x 768, 1 at 720 x 405)
			-- the gap is kept from the shadow (at most the screen factor's: the card's scale never exceeds f)
			bottom = blt + shift - K.GAP - math.floor((tonumber(Theme.Finish and Theme.Finish.Window) or 0) * f + 0.5)
		end
		local tlb = hud:GetAttribute("TopLeftBottom")
		if type(tlb) == "number" and tlb > 0 then
			topLimit = tlb + shift + K.GAP
		end
		local bcl, bcr = hud:GetAttribute("BottomCentreLeft"), hud:GetAttribute("BottomCentreRight")
		if type(bcl) == "number" and type(bcr) == "number" and bcr > bcl then
			centre = { x0 = bcl, x1 = bcr }
		end
	end
	bottom = clamp(bottom, 60, area.Y - edge)

	-- 1) bottom-left above the HUD, stepping aside from the menu column / the tutorial card on our rows
	local column = menuColumnRect()
	local tut = tutorialRect()
	local function placeAt(b)
		local left = edge
		local probeTop = b - (K.H + K.TAB_ABOVE) * f
		local function sharesRows(r)
			return r ~= nil and r.y1 > probeTop and r.y0 < b
		end
		if sharesRows(column) then
			left = math.max(left, column.x1 + K.GAP)
		end
		if sharesRows(tut) and tut.x0 < left + K.W * f then
			local alt = tut.x1 + K.GAP
			if alt + K.W_MIN * K.MIN_SCALE <= rightLimit then
				left = math.max(left, alt)
			end
		end
		local s, cw, ch, rows = fitCard(left, b, topLimit, rightLimit, f, tall)
		-- (re-verify, N1 at 390 x 844) a card from the edge under the tile column keeps GAP under it: the rows probe above
		-- reads the full card's height, the portrait's compact card is taller, and with the gap now kept from the card's
		-- shadow (bottom, above) its top met the column's Stats tile. Its own top limit there: the short rows where they fit
		if column and left < column.x1 + K.GAP and column.y1 + K.GAP > topLimit and column.y1 < b then
			local _, ex = tabFor(cw)
			if b - (ch + rows.TabAbove + ex) * math.max(K.MIN_SCALE, s) < column.y1 + K.GAP then
				local s2, cw2, ch2, rows2 = fitCard(left, b, column.y1 + K.GAP, rightLimit, f, tall)
				if s2 >= K.MIN_SCALE or rows2 ~= rows then
					s, cw, ch, rows = s2, cw2, ch2, rows2
				end
			end
		end
		return s, cw, ch, left, rows
	end
	local scale, w, h, left, rows = placeAt(bottom)
	-- desktops: the vitals card is bottom-CENTRE now, so the dialog only has to stand above it when its x-span
	-- actually meets the card (or the hotbar under it); otherwise it keeps its own default bottom near the edge.
	-- (Touch keeps the HUD's line: Roblox's thumbstick owns the bottom-left corner there.)
	if centre and not touch then
		local low = area.Y - edge
		local bar = hotbarRect()
		local function clear(b, l, s, cw)
			local x1 = l + cw * s
			if x1 + K.GAP > centre.x0 and l < centre.x1 + K.GAP then
				return false
			end
			return bar == nil or b <= bar.y0 - K.GAP or x1 + K.GAP <= bar.x0 or l >= bar.x1 + K.GAP
		end
		-- (U9-9 look 2) the corner dock is tried whenever there is room under the HUD's line, not only when the lifted card
		-- is already clear of the vitals: lifted, the menu rail pushed a 720p card right against the vitals card (it floated
		-- mid-left, 2 px from the vitals' corner); docked low it starts at the edge, clear of both (as at 1080p)
		if low > bottom + 1 then
			local s2, w2, h2, l2, r2 = placeAt(low)
			if clear(low, l2, s2, w2) then
				bottom, scale, w, h, left, rows = low, s2, w2, h2, l2, r2
			end
		end
	end
	local x, y = left, bottom
	if scale < K.MIN_SCALE and column and column.y0 > topLimit then
		-- 2) narrow screens: above the menu column, from the left edge
		local b2 = column.y0 - K.GAP
		local s2, w2, h2, r2 = fitCard(edge, b2, topLimit, area.X - edge, f, tall)
		if s2 >= K.MIN_SCALE then
			scale, w, h, x, y, rows = s2, w2, h2, edge, b2, r2
		end
	end
	local overColumn = false
	-- (re-verify, B0 guidechip:npc 390 x 844) only where the card forced to MIN_SCALE would leave the screen - past its
	-- right edge or up into Roblox's top band, the backlog's two faults -: at 390 x 844 the forced card stood whole above
	-- the vitals card, as on kit-b, and step 3 took the screen's width, sent the tiles and the vitals card aside and the
	-- guide chip, whose home is on the vitals stack, down onto Roblox's thumbstick
	local function leavesScreen()
		local _, extraTab = tabFor(w)
		local cardTop = y - (h + rows.TabAbove + extraTab) * K.MIN_SCALE
		return x + w * K.MIN_SCALE > area.X - edge + 0.5 or cardTop < 0
	end
	if scale < K.MIN_SCALE and touch and leavesScreen() then
		-- 3) (kit-b backlog 21 / 31: forced to MIN_SCALE in a box too small for it, the card ran 77 px past the right edge at
		-- 360 x 640, from right of the tile column, and into Roblox's top band at 640 x 360 / 667 x 375, above the lobby's
		-- vitals card) a phone gives it the rows down to its touch keys, Roblox's stick and jump button (the vitals card
		-- steps aside under it: syncVitals) right of the tile column; where that is still too narrow, the screen's width
		-- from the left edge (the tiles step aside under it: setColumnCover)
		-- Each box may also end GAP left of a key, its bottom then only over the keys it still reaches; where the compact
		-- card is too tall, the full one, as wide as the box (at 640 x 360 the 346 x 187 px between the column, DASH and
		-- RUN hold the full card at 0.7, not the compact one)
		local foot = touchRects(area)
		local found = false
		-- (kitb-matchhud look0 N3) first a box whose card shows every page of the speech whole (at 640 x 360 the full card
		-- from the left edge, the tiles aside under it: as wide as the speech's rows need), then any box as before
		for _, whole in ipairs({ true, false }) do
			for _, box in ipairs({ { left, rightLimit, false }, { edge, area.X - edge, true } }) do
				local l = box[1]
				local rights = { box[2] }
				for _, t in ipairs(foot) do
					if t.x0 - K.GAP > l and t.x0 - K.GAP < box[2] then
						rights[#rights + 1] = t.x0 - K.GAP
					end
				end
				table.sort(rights, function(a, b)
					return a > b
				end)
				for _, r in ipairs(rights) do
					local b = area.Y - edge
					for _, t in ipairs(foot) do
						if t.x0 < r + K.GAP and t.x1 > l - K.GAP then
							b = math.min(b, t.y0 - K.GAP)
						end
					end
					if b > topLimit then
						local s3, w3, h3, r3 = fitCard(l, b, topLimit, r, f, tall)
						if s3 < K.MIN_SCALE or (whole and not speechFits(w3, h3, r3)) then
							s3, w3, h3, r3 = fitWide(l, b, topLimit, r)
						end
						if s3 and s3 >= K.MIN_SCALE and (not whole or speechFits(w3, h3, r3)) then
							scale, w, h, x, y, rows, overColumn = s3, w3, h3, l, b, r3, box[3]
							found = true
							break
						end
					end
				end
				if found then
					break
				end
			end
			if found then
				break
			end
		end
	end
	scale = math.max(K.MIN_SCALE, scale) -- never below readable text, even if the card then overlaps a little
	-- (U9-9 look) the name plank never under the top bar's pill (it draws over the card: on a 640 x 360 window the pill
	-- hid the plank's words): the card steps down until the plank's gold edge is K.PILL_GAP under the pill, and the
	-- HUD's vitals card steps aside if the card then lies over it (syncVitals below)
	-- (U9-9 look 2) the plank spans the well (it was 104 px short of it: "CAPTAIN PENGUIN" wrapped to two rows on its lip)
	local tabW, extra = tabFor(w)
	local tabH = rows.Tab + extra
	local pill = topBarPillRect()
	if pill then
		local px0, px1 = x + (K.WELL_X - 3) * scale, x + (K.WELL_X + tabW + 3) * scale
		local ptop = y - h * scale + (24 - tabH - 3) * scale
		if px1 > pill.x0 and px0 < pill.x1 and ptop < pill.y1 + K.PILL_GAP then
			y = math.min(area.Y, y + (pill.y1 + K.PILL_GAP - ptop))
		end
	end
	root.Size = UDim2.fromOffset(w, h)
	-- (U9-9 review) the bottom rows of the tall or the short card: the well's room under it, the footer, the stone lip
	if UI.Well then
		UI.Well.Size = UDim2.new(1, -(K.WELL_X + K.PAD), 1, -(K.WELL_TOP + K.FOOTER_H + rows.Well))
	end
	if UI.Footer then
		UI.Footer.Position = UDim2.new(0, K.WELL_X, 1, -(K.FOOTER_H + rows.FootUp))
	end
	if UI.StoneLip then
		UI.StoneLip.Size = UDim2.new(1, 0, 0, rows.Lip)
	end
	UI.Root:SetAttribute("Rows", rows == K.ROWS.Short and "Short" or "Tall")
	-- (merge kitb-look1 x U9-9) the short card's 12 px of stone over the footer holds the kit's 5 px plank edge with
	-- 2 px to spare at 0.7: there the two planks keep U9-9's 3 px edge (CloudUI.Button's EdgePx attribute)
	for _, b in ipairs({ UI.Next, UI.Close }) do
		if b then
			b:SetAttribute("EdgePx", rows == K.ROWS.Short and 3 or nil)
		end
	end
	-- (U9-9 look 2) the left column ends on the footer's bottom line, as the right one does: the full card's title tag
	-- stands on that line under a square portrait; the compact card puts Close there (under the title tag, BUTTON_GAP
	-- apart) and lets Next span the well, its one wide action, and the portrait takes the column's height above them
	local compact = w < K.W - 60
	local footTop = h - (K.FOOTER_H + rows.FootUp)
	local tagTop = h - rows.FootUp - rows.TitleTag
	if compact then
		tagTop = footTop - K.BUTTON_GAP - rows.TitleTag
	end
	UI.Root:SetAttribute("Compact", compact)
	if UI.TitlePill then
		UI.TitlePill.Size = UDim2.fromOffset(K.PORTRAIT + 2, rows.TitleTag)
		UI.TitlePill.Position = UDim2.fromOffset(K.PAD + K.PORTRAIT / 2, tagTop)
	end
	if UI.Portrait then
		UI.Portrait.Size = UDim2.fromOffset(K.PORTRAIT, math.max(K.PORTRAIT - 30, tagTop - 12 - 16))
	end
	if UI.Close and UI.Next and UI.Footer and UI.Card then
		if compact then
			UI.Close.Parent = UI.Card
			UI.Close.AnchorPoint = Vector2.new(0, 0)
			UI.Close.Position = UDim2.fromOffset(K.PAD, footTop)
			UI.Close.Size = UDim2.fromOffset(K.PORTRAIT, K.FOOTER_H)
			UI.Next.Size = UDim2.new(1, 0, 0, K.FOOTER_H)
		else
			UI.Close.Parent = UI.Footer
			UI.Close.AnchorPoint = Vector2.new(1, 0.5)
			UI.Close.Position = UDim2.new(1, -(K.NEXT_W + K.BUTTON_GAP), 0.5, 0)
			UI.Close.Size = UDim2.fromOffset(K.CLOSE_W, K.FOOTER_H)
			UI.Next.Size = UDim2.fromOffset(K.NEXT_W, K.FOOTER_H)
		end
	end
	if UI.More then
		local slot = math.ceil(K.ICON / scale - 1e-6) -- (U9-9 look) the chevron's 18 screen px inside its slot
		UI.More.Size = UDim2.fromOffset(slot, slot)
	end
	-- (U9-9 look) placed by its top-left corner on a whole px (the UIScale grows it from there): every part of the card
	-- snaps to whole px of it; its bottom stays on the line it was fitted to
	local top = math.floor(y - h * scale + 0.5)
	root.Position = UDim2.fromOffset(math.floor(x + 0.5), top)
	UI.Scale.Scale = scale
	if UI.NameTab then
		UI.NameTab.Size = UDim2.fromOffset(tabW, tabH)
		UI.NameTab.Position = UDim2.fromOffset(K.WELL_X, 24 - tabH) -- it ends 24 px into the card
		UI.NameTab:SetAttribute("Rows", extra > 0 and 2 or 1)
	end
	syncVitals({ x0 = math.floor(x + 0.5), y0 = top, x1 = math.floor(x + 0.5) + w * scale, y1 = top + h * scale })
	local tabTop = top - rows.TabAbove * scale
	setColumnCover((overColumn and column and x < column.x1 + K.GAP and tabTop < column.y1 + K.GAP and top + h * scale > column.y0 - K.GAP)
		and math.floor(x + 0.5) or nil)
	if PixelCrisp then
		PixelCrisp.Refresh(root) -- (kit B U9-9) the icons and wood edges back on whole pixels at the new scale
	end
	dialog.Width = w
end

----------------------------------------------------------------------
-- Dialog flow
----------------------------------------------------------------------
-- (kit B U9-9) the line shown gold, the rest the sunk well; every dot the same square (no size jump)
local function setDots(count, index)
	for i, dot in ipairs(UI.Dots or {}) do
		dot.Visible = i <= count
		dot.BackgroundColor3 = i == index and C.Gold or C.DotOff
		dot:SetAttribute("Current", i == index)
	end
end

local function finishTyping()
	dialog.Typing = false
	dialog.Shown = dialog.Total
	if UI.Line then
		UI.Line.MaxVisibleGraphemes = -1
	end
	if UI.More then
		UI.More.Visible = true
	end
end

local function showLine(index)
	local lines = dialog.Lines
	if not lines or #lines == 0 then
		return
	end
	local n = #lines
	dialog.Index = ((index - 1) % n) + 1
	local rec = dialog.Rec
	local rich, plain = richLine(lines[dialog.Index], rec and rec.Def, (rec and rec.Accent) or C.Gold)
	UI.Line.Text = rich
	dialog.Plain = plain
	dialog.Total = splitChars(plain, dialog.Chars)
	dialog.Shown = 0
	dialog.Letters = 0
	dialog.Timer = 0
	dialog.Typing = dialog.Total > 0
	UI.Line.MaxVisibleGraphemes = 0
	UI.More.Visible = false
	setDots(math.min(n, K.MAX_DOTS), math.min(dialog.Index, K.MAX_DOTS))
	if UI.Next then
		if dialog.Index >= n then
			UI.Next.Text = "Again"
		else
			UI.Next.Text = "Next"
		end
	end
	if rec then
		rec.HopT = 0
	end
	if not dialog.Typing then
		finishTyping()
	end
end

local function stepTypewriter(dt)
	if not dialog.Typing then
		return
	end
	dialog.Timer = dialog.Timer + dt
	local changed = false
	while dialog.Typing do
		local nextChar = dialog.Chars[dialog.Shown + 1]
		local need = charDelay(nextChar)
		if dialog.Timer < need then
			break
		end
		dialog.Timer = dialog.Timer - need
		dialog.Shown = dialog.Shown + 1
		changed = true
		if isWordChar(nextChar) then
			dialog.Letters = (dialog.Letters or 0) + 1
			if dialog.Letters % BLIP_EVERY == 1 then
				playSfx("DialogBlip")
			end
		end
		if dialog.Shown >= dialog.Total then
			finishTyping()
		end
	end
	if changed and dialog.Typing then
		UI.Line.MaxVisibleGraphemes = dialog.Shown
	end
end

local function setPortrait(rec)
	if dialog.Viewport then
		pcall(dialog.Viewport.Destroy)
		dialog.Viewport = nil
	end
	local holder = UI.PortraitHolder
	if not holder then
		return
	end
	for _, child in ipairs(holder:GetChildren()) do
		child:Destroy()
	end
	local petId = rec.Model and rec.Model:GetAttribute("PetId")
	local petDef = nil
	if PetCatalog and type(PetCatalog.Get) == "function" and type(petId) == "string" then
		petDef = PetCatalog.Get(petId)
	end
	if petDef and CloudUI and CloudUI.PetViewport then
		local ok, handle = pcall(CloudUI.PetViewport, holder, petDef, UDim2.fromScale(1, 1), {
			Spin = "sway",
			Flap = 0.7,
			Detail = "High",
			ZIndex = 6,
		})
		if ok and handle then
			dialog.Viewport = handle
			return
		end
	end
	-- no viewport: the NPC's initial on the accent tile
	local name = (rec.Def and rec.Def.Name) or rec.Id
	local initial = Theme.Label(string.sub(tostring(name), 1, 1), "Title", {
		Size = 64,
		Color = SIGN.Text, -- brown on the sky well
		Props = { Name = "Initial", Size = UDim2.fromScale(1, 1), ZIndex = 7 },
	})
	initial.Parent = holder
end

local function setPromptText(rec, text)
	if rec and rec.Prompt and rec.Prompt.Parent then
		pcall(function()
			rec.Prompt.ActionText = text
		end)
	end
end

local function slideTo(visible)
	local slide = UI.Slide
	if not slide then
		return
	end
	if dialog.SlideTween then
		pcall(function()
			dialog.SlideTween:Cancel()
		end)
		dialog.SlideTween = nil
	end
	local hidden = UDim2.fromOffset(-((dialog.Width or K.W) + 80), 0)
	if visible then
		UI.Root.Visible = true
		slide.Position = hidden
		dialog.SlideTween = Util.Tween(slide, 0.32, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		local tween = Util.Tween(slide, 0.2, { Position = hidden }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		dialog.SlideTween = tween
		tween.Completed:Connect(function()
			if not dialog.Open and dialog.SlideTween == tween then
				UI.Root.Visible = false
			end
		end)
	end
end

local function openRec(rec)
	if not rec or not UI.Root then
		return
	end
	local lines = (rec.Def and rec.Def.Lines) or (NpcDialog and NpcDialog.GetLines(rec.Id)) or {}
	if #lines == 0 then
		lines = { "Hello there, climber!" }
	end
	local switching = dialog.Open and dialog.Rec ~= rec
	if dialog.Open and dialog.Rec == rec then
		return
	end
	if switching then
		setPromptText(dialog.Rec, "Talk")
	end
	dialog.Open = true
	dialog.Rec = rec
	dialog.Lines = lines
	talkedTo[rec.Id] = true
	refreshBadge(rec)
	setPromptText(rec, "Next")

	local def = rec.Def or {}
	local accent = rec.Accent or C.Gold
	UI.Name.Text = def.Name or rec.Model:GetAttribute("NpcName") or rec.Id
	UI.Title.Text = def.Title or rec.Model:GetAttribute("Title") or ""
	-- (kit B U9-9) the NPC's colour by role: on the portrait's lip (the ground it stands on), nothing glossy
	if UI.PortraitLip then
		UI.PortraitLip.BackgroundColor3 = accent
	end
	setPortrait(rec)
	layoutDialog()
	layoutTimer = 0
	checkTimer = 0
	refreshTargets()
	showLine(1)
	if not switching then
		slideTo(true)
		playSfx("DialogOpen")
		dialog.Greet = (dialog.Greet or 0) + 1
		local greet = dialog.Greet
		task.delay(GREET_DELAY, function()
			if dialog.Open and dialog.Rec == rec and dialog.Greet == greet then
				playVoice(rec, "Greet")
			end
		end)
	end
	ensureLoop()
end

function NpcController.Open(npcId)
	for _, rec in ipairs(recs) do
		if rec.Id == npcId then
			openRec(rec)
			return true
		end
	end
	return false
end

function NpcController.Close()
	if not dialog.Open then
		return
	end
	local rec = dialog.Rec
	dialog.Open = false
	dialog.Rec = nil
	dialog.Typing = false
	setPromptText(rec, "Talk")
	if dialog.Viewport then
		pcall(dialog.Viewport.Destroy)
		dialog.Viewport = nil
	end
	slideTo(false)
	setVitalsOff(false)
	setColumnCover(nil)
	refreshTargets()
end

-- Next: finish the current line, or go to the next one (wrapping to the first).
function NpcController.Advance()
	if not dialog.Open then
		return
	end
	if dialog.Typing then
		finishTyping()
	else
		showLine(dialog.Index + 1)
		playSfx("DialogNext")
		-- (the NPC's wordless reaction: Pleased on the last line or a "!" line, Hmm on any other line)
		local lines = dialog.Lines or {}
		if #lines > 0 then
			local last = dialog.Index == #lines
			local excited = string.find(tostring(dialog.Plain or lines[dialog.Index] or ""), "!", 1, true) ~= nil
			playVoice(dialog.Rec, (last or excited) and "Pleased" or "Hmm")
		end
	end
end

function NpcController.IsOpen()
	if dialog.Open and dialog.Rec then
		return true, dialog.Rec.Id
	end
	return false, nil
end

onPrompt = function(prompt, player)
	if player ~= nil and player ~= LocalPlayer then
		return
	end
	if typeof(prompt) ~= "Instance" then
		return
	end
	local rec = recByPrompt(prompt)
	if not rec then
		local id = prompt:GetAttribute("NpcId")
		if type(id) ~= "string" then
			return
		end
		local model = prompt:FindFirstAncestorOfClass("Model")
		while model and model:GetAttribute("NpcId") ~= id do
			model = model:FindFirstAncestorOfClass("Model")
		end
		if not model then
			return
		end
		dialog.PendingOpen = model -- opens as soon as the NPC has fully replicated
		track(model)
		return
	end
	local now = clock
	if lastTrigger[prompt] and now - lastTrigger[prompt] < 0.15 then
		return
	end
	lastTrigger[prompt] = now
	if dialog.Open and dialog.Rec == rec then
		NpcController.Advance()
	else
		openRec(rec)
	end
end

-- Closes the dialog when the player walked away, died or left the lobby.
local function checkDialog()
	if not dialog.Open then
		return
	end
	local rec = dialog.Rec
	local root = localRoot()
	local char = LocalPlayer and LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not rec or not rec.Model.Parent or not root or (humanoid and humanoid.Health <= 0) then
		NpcController.Close()
		return
	end
	if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		NpcController.Close()
		return
	end
	local center = rec.Center
	if center then
		local d = root.Position - center
		if Vector3.new(d.X, 0, d.Z).Magnitude > CLOSE_DISTANCE or math.abs(d.Y) > CLOSE_DISTANCE then
			NpcController.Close()
		end
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function onFrame(dt)
	dt = math.min(tonumber(dt) or 0, 0.25)
	clock = clock + dt
	targetTimer = targetTimer + dt
	if targetTimer >= K.TARGET_REFRESH then
		targetTimer = 0
		refreshTargets()
	end
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or nil
	local root = localRoot()
	stepNpcs(dt, camPos, root and root.Position or nil)

	if dialog.Open then
		stepTypewriter(dt)
		if UI.More and UI.More.Visible then
			UI.More.Position = UDim2.new(1, -10, 1, -6 - math.floor(math.abs(math.sin(clock * 5)) * 4 + 0.5)) -- (whole px steps)
		end
		checkTimer = checkTimer + dt
		if checkTimer >= K.CHECK_EVERY then
			checkTimer = 0
			checkDialog()
		end
		layoutTimer = layoutTimer + dt
		if layoutTimer >= K.LAYOUT_EVERY then
			layoutTimer = 0
			layoutDialog()
		end
	end
end

ensureLoop = function()
	if loopConn then
		return
	end
	loopConn = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(onFrame, dt)
		if not ok then
			warn("[NpcController] frame error: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function onViewportChanged()
	for _, rec in ipairs(recs) do
		scaleNameplate(rec)
	end
	if dialog.Open then
		layoutDialog()
	end
end

function NpcController.Init()
	if initialized then
		return
	end
	initialized = true
	if not NpcDialog then
		warn("[NpcController] shared/NpcDialog is unavailable: NPC dialogs are disabled")
	end

	local okUi, errUi = pcall(buildDialog)
	if not okUi then
		warn("[NpcController] dialog UI failed: " .. tostring(errUi))
	end

	-- prompts: the service-wide signal (one connection for every NPC)
	local okHook = pcall(function()
		local signal = ProximityPromptService.PromptTriggered
		if signal then
			signal:Connect(function(prompt, player)
				onPrompt(prompt, player)
			end)
			promptServiceHooked = true
		end
	end)
	if not okHook then
		promptServiceHooked = false
	end

	CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(model)
		pending[model] = nil
		local rec = byModel[model]
		if rec then
			removeRec(rec)
		end
	end)
	for _, model in ipairs(CollectionService:GetTagged(TAG)) do
		track(model)
	end

	-- readable nameplates on every screen + dialog relayout
	local cameraConn = nil
	local function bindCamera()
		if cameraConn then
			cameraConn:Disconnect()
			cameraConn = nil
		end
		local cam = Workspace.CurrentCamera
		if cam then
			cameraConn = cam:GetPropertyChangedSignal("ViewportSize"):Connect(onViewportChanged)
		end
		onViewportChanged()
	end
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()

	if LocalPlayer then
		LocalPlayer.CharacterRemoving:Connect(function()
			NpcController.Close()
		end)
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
				NpcController.Close()
			end
		end)
	end
end

return NpcController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1154">
            <Properties>
              <string name="Name">ObbyController</string>
              <string name="Source"><![CDATA[-- ObbyController (client, Phase 5, dungeonclient W4): the level picker of the ONE obby portal (ARCHITECTURE_V3.md
-- "Phase 5 build contract" 6.3, 6.6).
--
--   ObbyController.Init()
--   ObbyController.Open(levelId|nil, portal|nil) -> bool   the picker (the gate's ObbyPrompt "Pick level", OpenPanel("Obby"),
--                                             the party panel's CHANGE chip: HudController._onChangeLevel calls Open())
--   ObbyController.Close()
--   ObbyController.IsOpen() -> bool
--   ObbyController.Pick(levelId) -> bool      sends ObbyPick(levelId) for an unlocked level (the server checks it again with
--                                             its own copy of Stats.BestTimes: PortalService.PickLevel)
--   ObbyController.GetState() -> { Window, Picked, Highest, Levels = { {Id, Unlocked, Picked, Best}... }, Footer }
--   ObbyController.Opened / Closed (Util.Signal)
--
-- What the player sees: a docked kit B signboard (560 x 560 design px; docked right on landscape screens, a bottom sheet on
-- portrait phones; kit-b U9-8, was a NeonKit side panel) with the five levels of shared/ObbyLevels (Easy, Medium, Hard,
-- Extreme, Saint) as stone rows in a sunk well: the level's number on a square tile in its colour, name and stars,
-- "Best 3:42 . Win +35 tokens" or LOCKED "Beat Medium to unlock", a PICK / PICKED / LOCKED tag; the picked row is pale gold
-- and shows its blurb (not on a short screen). A level is open when the one before it was beaten (ObbyLevels.IsUnlocked on
-- State's Stats.BestTimes; the server decides). The line under the title says what happens next: "Step on the pad to start"
-- or "Party on the pad: Hard 2/4 - step on to join" (the gate's PartyLevel / PartyCount / PartyMax attributes), or the own
-- party's line while the player waits on the pad. On a touch screen Roblox's thumbstick and jump button go while it is
-- open. It closes when the player walks 40 studs away from the gate or steps onto the pad (a window opened there), with
-- Esc / gamepad B / the close block, or when another window opens. After a won match that unlocks the next level a kit B
-- toast says "Extreme unlocked! Pick it at the Obby portal." at the top right, clear of the result card and the HUD (a
-- screen with no room beside the result card shows it once the card has gone).
-- Remotes: OpenPanel (in), PartyState (in), MatchResult (in), ObbyPick (out). Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the levels' stars, lock and tick
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-8) the header, the list's bar, the toast's nails
local Remotes = require(Shared:WaitForChild("Remotes"))
local ObbyLevels = require(Shared:WaitForChild("ObbyLevels"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local State = require(Client:WaitForChild("State"))

local ObbyController = {}
ObbyController.Opened = Util.Signal()
ObbyController.Closed = Util.Signal()

local K = {
	DISPLAY_ORDER = 23,
	TOAST_ORDER = 31, -- above NimbusNotify's stack
	PREF_W = 560,
	PREF_H = 560, -- (kit-b U9-8) the five rows, the picked one open, with no empty stone under them (was 640)
	SHORT = 520, -- docked lower than this: no blurb on the picked row (landscape phones, portrait sheets)
	ROW_H = 66, -- (kit-b U9-8) a level row: name + stars, the info line, the lip
	ROW_H_SHORT = 60, -- (U9-8 look) a short dock's row (name at 4, info at 30): four rows fit a landscape phone's sheet
	PRESS = 2, -- (U9-8 look) a pressed row's face drops this far and its lip thins by as much (the kit's press)
	CHIP_LIP = 4, -- (U9-8 look) the PICK plank's lip (it sinks onto it while its row is pressed)
	BLURB_H = 46, -- the picked row's blurb (two lines) under its info line
	ROW_GAP = 6, -- between the rows, and the list's pad at its top and bottom (whole rows at the list's edges)
	CHIP_W = 122,
	CHIP_H = 30,
	CHIP_SMALL = 34, -- a narrow row's tag: its icon alone (the tick, the lock, the arrow), so the name and stars stay whole
	TOP_H = 36, -- the line under the title and its gap
	FIRE_GAP = 0.3,
	WALK_AWAY = 40,
	TICK = 0.25,
	TOAST_SECONDS = 6,
	TOAST_W = 380,
	TOAST_H = 72, -- (a landscape phone fits it in the top row, above the middle band)
	TOAST_NARROW = 600, -- a screen narrower than this (design px: a portrait phone) gets the narrow toast ...
	TOAST_NARROW_W = 300, -- ... right of the menu column
	TOAST_NARROW_H = 88,
	TOAST_WAIT = 30, -- seconds the toast may wait for room (beside the result card) before it shows anyway
	TOAST_GAP = 10, -- kept from the HUD, the result card and the touch buttons
	EDGE = 12, -- KEEP IN SYNC with HudController / NotifyController: EDGE and TOUCH_EDGE
	TOUCH_EDGE = 20,
	BACK_ACTION = "NimbusObbyBack",
}

local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local C = {
	Accent = SIGN.Sky, -- (kit-b U9-8) an unknown level's colour
	Star = SIGN.GoldLip, -- the stars on stone (the gold face itself is too pale there)
	StarOff = SIGN.WellEdge,
}

-- typography (kit-b U7b: the stars, the lock and the tick are PixelIcons, a level's tokens and best time say it in words)
local G = {
	Dot = "\194\183",
}

local LocalPlayer = nil
local initialized = false
local U = {}
local S = {
	Open = false,
	Token = 0,
	Want = nil, -- the optimistic pick until the ObbyLevel attribute / PartyState confirms it
	WantAt = 0,
	Party = nil, -- the last PartyState of the Obby portal (nil when not on the pad)
	AtPortal = nil,
	OpenedLocked = false,
	LastFire = {},
	BackBound = false,
	Highest = nil, -- the HighestUnlocked the player last saw
	Built = false,
	Short = false,
	Warned = {},
}
local H = {}

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
function H.safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not S.Warned[key] then
		S.Warned[key] = true
		warn("[ObbyController] " .. key .. ": " .. tostring(err))
	end
	return ok
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	return (ok and type(mod) == "table") and mod or nil
end

function H.frame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

function H.text(parent, name, text, role, size, color, props)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = tostring(text or "")
	-- kit-b U6: the window is a plate, so the text reads by contrast (no outline)
	Theme.Style(label, role or "Body", { Size = size, Color = color or INK })
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

-- (kit-b U9-8) a square edge with mitred corners (kit B has no rounded blocks). (U9-8 look) whole screen px under the
-- dock's scale (SignKit.Whole: a 2 px edge drew 1.6 px at 0.8)
function H.edge(parent, color, thickness)
	local px = thickness or 2
	local stroke = Util.Create("UIStroke", {
		Name = "SignEdge",
		Color = color,
		Thickness = px,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
	SignKit.Whole(stroke, function(sc)
		stroke.Thickness = SignKit.Px(px, sc)
	end)
	return stroke
end

-- a flat lip along the bottom of a square tile (the block's darker underside); (U9-8 look) whole screen px tall.
-- H.setLip(lip, px) changes its height later
function H.lip(parent, color, px)
	local lip = H.frame(parent, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, px or 4),
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
	})
	H.setLip(lip, px or 4)
	return lip
end

function H.setLip(lip, px)
	lip.Visible = px > 0
	SignKit.Whole(lip, function(sc)
		lip.Size = UDim2.new(1, 0, 0, SignKit.Px(px, sc))
	end)
end

function H.pad(parent, l, t, r, b)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		Parent = parent,
	})
end

-- the colour a level's tile paints: a mid-tone that no ink reads 4.5:1 on is lightened until brown does (the Dungeon's rule)
function H.readable(color)
	for _ = 1, 6 do
		if Theme.Contrast(Theme.TextOn(color), color) >= 4.6 then
			break
		end
		color = Theme.Lighten(color, 0.08)
	end
	return color
end

-- a square tag holding a centred label "Text" (a level's state); H.paintTag colours it. (U9-8 look) with a Lip for when
-- it is the PICK plank
function H.tag(parent, name, props)
	local tag = H.frame(parent, name, props)
	tag.BackgroundTransparency = 0
	H.edge(tag, SIGN.Wood, 2)
	H.lip(tag, SIGN.SkyLip, 0)
	H.text(tag, "Text", "", "Tag", 18, INK, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	return tag
end

-- (U9-8 look) a row's tag by its state. PICK, the picker's one action, is a small sky plank (CloudUI.SignLooks.Sky: the sky
-- face on its SkyLip lip in the wood edge) that sinks onto its lip while its row is pressed (the face drops K.PRESS, the
-- lip thins by as much, the bottom stays); PICKED (gold) and LOCKED (the well, muted ink) are states: flat tags, no lip.
-- Was a flat sky rectangle drawn like the states. `w` the tag's width (design px)
function H.paintTag(ui, state, w)
	local tag = ui.Chip
	local look = CloudUI.SignLooks.Sky
	local plank = state == "PICK"
	local face = (state == "PICKED" and SIGN.Gold) or (state == "LOCKED" and SIGN.Well) or look.Face
	local sink = (plank and ui.Pressed) and K.PRESS or 0
	local lipPx = plank and (K.CHIP_LIP - sink) or 0
	tag.BackgroundColor3 = face
	tag.Position = UDim2.new(1, -10, 0, ui.ChipY + sink)
	tag.Size = UDim2.fromOffset(w, K.CHIP_H - sink)
	local lip = tag:FindFirstChild("Lip")
	lip.BackgroundColor3 = look.Lip
	H.setLip(lip, lipPx)
	for _, label in ipairs({ ui.ChipText, ui.Mark }) do
		label.Size = UDim2.new(1, 0, 1, -lipPx)
		label.TextColor3 = (state == "LOCKED") and MUTED or Theme.TextOn(face)
	end
	tag:SetAttribute("Plank", plank)
end

function H.viewport()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

function H.touchOnly()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

function H.tween(inst, seconds, goal, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function H.bestTimes()
	local ok, snap = pcall(State.Get)
	local stats = ok and type(snap) == "table" and snap.Stats or nil
	return type(stats) == "table" and type(stats.BestTimes) == "table" and stats.BestTimes or {}
end

function H.diff(id)
	if type(Config.GetDifficulty) == "function" then
		local d = Config.GetDifficulty(id)
		if d then
			return d
		end
	end
	for _, d in ipairs(Config.Difficulties or {}) do
		if d.Id == id then
			return d
		end
	end
	return { Id = id, DisplayName = tostring(id), Stars = 1, Color = C.Accent }
end

-- (kit-b U7b) a level's difficulty: 1-5 PixelIcon stars right after its name. (U9-8) GoldLip on an open level's stone,
-- the well's edge colour on a locked one; set again only when that changes
function H.stars(ui, open)
	if ui.StarsOpen == open then
		return
	end
	ui.StarsOpen = open
	local n = math.max(1, math.min(5, math.floor(tonumber(ui.StarCount) or 0)))
	PixelIcon.Lead(ui.Name, "star", { After = true, Room = true, Count = n, Of = n, Px = 18, Gap = 6, Colour = open and C.Star or C.StarOff })
end

function H.clock(seconds)
	local s = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

function H.winTokens(id)
	local t = Config.Match and Config.Match.TokenBonusOnWin
	return type(t) == "table" and tonumber(t[id]) or nil
end

function H.highest()
	local ok, n = pcall(ObbyLevels.HighestUnlocked, H.bestTimes())
	return ok and tonumber(n) or 1
end

-- the level the player has picked: the optimistic pick, the party's level (on the pad), the ObbyLevel attribute, else
-- the highest unlocked one
function H.picked()
	local list = ObbyLevels.List()
	if S.Want and os.clock() - S.WantAt < 3 then
		return S.Want
	end
	S.Want = nil
	if S.Party and type(S.Party.Level) == "string" then
		return S.Party.Level
	end
	local attr = LocalPlayer and LocalPlayer:GetAttribute((Config.Attr and Config.Attr.ObbyLevel) or "ObbyLevel")
	if type(attr) == "string" and ObbyLevels.IsUnlocked(H.bestTimes(), attr) then
		return attr
	end
	return list[math.max(1, math.min(#list, H.highest()))]
end

function H.portal()
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	local gates = lobby and lobby:FindFirstChild("Gates")
	return (gates and gates:FindFirstChild("Portal_Obby")) or (lobby and lobby:FindFirstChild("Portal_Obby", true)) or nil
end

function H.positionOf(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(function()
			return inst:GetBoundingBox()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

function H.rootPosition()
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return (root and root:IsA("BasePart")) and root.Position or nil
end

function H.locked()
	local v = LocalPlayer and LocalPlayer:GetAttribute("PortalLocked")
	return v ~= nil and v ~= false and v ~= ""
end

function H.isLeader()
	return S.Party ~= nil and LocalPlayer ~= nil and S.Party.LeaderUserId == LocalPlayer.UserId
end

-- brief: (kit-b U9-8) the short wording for a narrow dock (a phone), where the full line does not fit under the title
function H.footer(brief)
	if S.Party then
		local d = H.diff(S.Party.Level)
		local count = #(type(S.Party.Players) == "table" and S.Party.Players or {})
		local line = "On the pad: " .. tostring(d.DisplayName) .. " " .. count .. "/" .. tostring(S.Party.Max or 4)
		if H.isLeader() then
			return line .. " " .. G.Dot .. (brief and " tap to change" or " tap a level to change it")
		end
		return line .. " " .. G.Dot .. (brief and " leader picks" or " the leader picks the level")
	end
	local portal = H.portal()
	local n = portal and tonumber(portal:GetAttribute("PartyCount")) or 0
	if n > 0 then
		local level = portal:GetAttribute("PartyLevel")
		local d = H.diff(level)
		return (brief and "Party: " or "Party on the pad: ") .. tostring(d.DisplayName) .. " " .. n .. "/" .. tostring(portal:GetAttribute("PartyMax") or 4)
			.. (brief and " - step on" or " - step on to join")
	end
	return "Step on the pad to start"
end

-- the line under the title: the full wording when it fits the line's width (design px), else the short one
function H.footerFor(label)
	local text = H.footer()
	local scale = (U.Dock and U.Dock.Rect and tonumber(U.Dock.Rect.scale)) or 1
	local room = label.AbsoluteSize.X / math.max(0.01, scale)
	if room > 0 and Theme.Measure(text, "Heading", label.TextSize).X + 2 > room then
		return H.footer(true)
	end
	return text
end

----------------------------------------------------------------------
-- the window
----------------------------------------------------------------------
function H.build()
	if S.Built then
		return
	end
	S.Built = true
	local holder = H.frame(U.Gui, "Window_Obby", { Size = UDim2.fromOffset(K.PREF_W, K.PREF_H), Visible = false, ZIndex = 3 })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	U.Dock = NeonKit.Dock(holder, U.Fit, K.PREF_W, K.PREF_H)
	local panel = CloudUI.Panel({
		Name = "ObbyPanel",
		Title = "Sky Obby",
		Closable = true,
		Skin = "Signboard", -- (kit-b U9-8) roof, navy header with the mountain, wood frame, stone body
		Icon = Config.Icons.Obby,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			ObbyController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	-- a docked window's band stays inside the frame, no tails (the Dungeon's header on the same dock)
	SignKit.HeaderOverhang(panel.TitleBar, false)
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	local PAD = CloudUI.Metrics.SignPagePad
	-- what happens next, right under the title (a phone sheet's bottom edge is the far end of the thumb's reach)
	U.Footer = H.text(content, "Footer", "", "Heading", 19, INK, {
		Position = UDim2.fromOffset(PAD, 0),
		Size = UDim2.new(1, -2 * PAD, 0, 30),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	-- the levels in a sunk well (the pitch's .wl), the kit's square wood bar
	U.List = Instance.new("ScrollingFrame")
	U.List.Name = "Levels"
	U.List.BackgroundColor3 = SIGN.Well
	U.List.BackgroundTransparency = 0
	U.List.BorderSizePixel = 0
	H.edge(U.List, SIGN.WellEdge, 2)
	SignKit.ScrollBar(U.List)
	U.List.ScrollingDirection = Enum.ScrollingDirection.Y
	U.List.AutomaticCanvasSize = Enum.AutomaticSize.Y
	U.List.CanvasSize = UDim2.new(0, 0, 0, 0)
	U.List.Position = UDim2.fromOffset(PAD, K.TOP_H)
	U.List.Size = UDim2.new(1, -2 * PAD, 0, 300)
	U.List.Parent = content
	H.pad(U.List, 8, K.ROW_GAP, 14, K.ROW_GAP)
	Util.Create("UIListLayout", { Padding = UDim.new(0, K.ROW_GAP), SortOrder = Enum.SortOrder.LayoutOrder, Parent = U.List })
	U.Cards = {}
	for i, id in ipairs(ObbyLevels.List()) do
		U.Cards[i] = H.card(i, id)
	end
end

-- one level row (a TextButton: tap to pick it). (kit-b U9-8) a stone block (pale gold with an ink edge when picked, the sunk
-- Off block when locked: H.refresh) with a square stripe in the level's colour, the level's number on a square tile in that
-- colour, the name with its stars, the info line, the blurb (the picked row only) and a square tag at the right
function H.card(i, id)
	local d = H.diff(id)
	local color = d.Color or C.Accent
	local row = Instance.new("TextButton")
	row.Name = "Level_" .. id
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, K.ROW_H)
	row.LayoutOrder = i
	row.Parent = U.List
	-- (U9-8 look) the kit's press: the row's parts drop K.PRESS (a padding: the lip stays on the bottom edge) while its lip
	-- thins by as much (H.refresh), so a tap shows before the server answers
	local press = H.pad(row, 0, 0, 0, 0)
	press.Name = "Press"
	CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = 4, Pad = false })
	local stripe = H.frame(row, "Stripe", { BackgroundTransparency = 0, BackgroundColor3 = color, Position = UDim2.fromOffset(4, 6), Size = UDim2.new(0, 6, 1, -16) })
	local face = H.readable(color)
	local badge = H.frame(row, "Badge", { BackgroundTransparency = 0, BackgroundColor3 = face, Position = UDim2.fromOffset(16, 8), Size = UDim2.fromOffset(42, 42) })
	H.edge(badge, SIGN.Wood, 2)
	H.lip(badge, Theme.Darken(face, 0.22), 4)
	H.text(badge, "Num", tostring(i), "Title", 22, Theme.TextOn(face), { Size = UDim2.new(1, 0, 1, -4), TextXAlignment = Enum.TextXAlignment.Center })
	local name = H.text(row, "LevelName", tostring(d.DisplayName or id), "Heading", 21, INK, {
		Position = UDim2.fromOffset(70, 6),
		Size = UDim2.new(1, -(80 + K.CHIP_W), 0, 28),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local info = H.text(row, "Info", "", "Body", 18, INK, {
		Position = UDim2.fromOffset(70, 34),
		Size = UDim2.new(1, -80, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local blurb = H.text(row, "Blurb", tostring(d.Blurb or ""), "Body", 18, MUTED, {
		Position = UDim2.fromOffset(70, 60),
		Size = UDim2.new(1, -80, 0, K.BLURB_H - 2),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		Visible = false,
	})
	local chip = H.tag(row, "Chip", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 6),
		Size = UDim2.fromOffset(K.CHIP_W, K.CHIP_H),
	})
	local mark = H.text(chip, "Mark", "", "Tag", 18, INK, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center, Visible = false })
	row.Activated:Connect(function()
		H.safe("pick", ObbyController.Pick, id)
	end)
	local ui = { Id = id, Root = row, Name = name, Blurb = blurb, Info = info, Chip = chip, ChipText = chip:FindFirstChild("Text"), Mark = mark, Color = color,
		StarCount = d.Stars, Stripe = stripe, Badge = badge, Press = press, Pressed = false, ChipY = 6 }
	local function setPressed(on)
		if ui.Pressed ~= on then
			ui.Pressed = on
			H.paintPress(ui)
		end
	end
	row.MouseButton1Down:Connect(function()
		setPressed(row:GetAttribute("Unlocked") ~= false)
	end)
	row.MouseButton1Up:Connect(function()
		setPressed(false)
	end)
	row.MouseLeave:Connect(function()
		setPressed(false)
	end)
	-- (a finger that lifts or slides into a scroll never produces MouseButton1Up)
	row.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			setPressed(false)
		end
	end)
	H.stars(ui, true)
	return ui
end

-- (U9-8 look) a row's parts for its height: a short dock's 60 px row (name at 4, info at 30) or the 66 px one (name at 6,
-- info at 34); the badge centred on the face above the lip, the tag beside the name
function H.rowGeometry(ui, short)
	local h = short and K.ROW_H_SHORT or K.ROW_H
	local nameY, infoY = short and 4 or 6, short and 30 or 34
	ui.Name.Position = UDim2.fromOffset(70, nameY)
	ui.Info.Position = UDim2.fromOffset(70, infoY)
	ui.Blurb.Position = UDim2.fromOffset(70, infoY + 26)
	ui.Badge.Position = UDim2.fromOffset(16, math.floor((h - 4 - 42) / 2))
	ui.Stripe.Position = UDim2.fromOffset(4, nameY)
	ui.Stripe.Size = UDim2.new(0, 6, 1, -(2 * nameY + 4))
	ui.ChipY = nameY
	return h
end

-- (U9-8 look) the kit's press on a row: its parts drop K.PRESS, its lip thins by as much, and a PICK plank sinks onto
-- its own lip (H.paintTag)
function H.paintPress(ui)
	local down = ui.Pressed and K.PRESS or 0
	ui.Press.PaddingTop = UDim.new(0, down)
	local lip = ui.Root:FindFirstChild("Lip")
	if lip and lip.Visible then
		lip.Size = UDim2.new(1, 0, 0, SignKit.Px(4 - down, SignKit.LayoutScale(lip)))
	end
	if ui.TagState then
		H.paintTag(ui, ui.TagState, ui.Chip.Size.X.Offset)
	end
end

-- (kit-b U9-8) a row's name and stars get all the room left of the tag, and the tags are the full word where every row's
-- name and stars fit beside it, else each its icon alone (a phone's narrow row ran 4 / 5 stars under PICK; one column of
-- tags, all words or all icons). H.compactTags decides for the list, H.fitName sizes a row. What a row needs: the name at
-- its measured width, never under 0.66 em a letter (FredokaOne's wide capitals) (a short measure cut "Extreme" to "Ext..."), and the stars
-- as PixelIcon.Lead draws them (18 px, 2 px apart, after a 6 px gap, with room for a 0.8 screen's whole-px cells)
function H.rowWidth()
	local scale = ((U.Dock.Rect and tonumber(U.Dock.Rect.scale)) or 1) * (U.Pop and U.Pop.Scale or 1)
	local first = U.Cards[1]
	local rowW = first and first.Root.AbsoluteSize.X / math.max(0.01, scale) or 0
	return rowW >= 1 and rowW or (K.PREF_W - 60)
end

function H.compactTags(rowW)
	for _, ui in ipairs(U.Cards) do
		local n = math.max(1, math.min(5, math.floor(tonumber(ui.StarCount) or 0)))
		local size = ui.Name.TextSize
		local textW = math.max(Theme.Measure(ui.Name.Text, "Heading", size).X, #ui.Name.Text * size * 0.66)
		if math.ceil(textW) + 6 + n * 18 + (n - 1) * 2 + 10 > rowW - 70 - (K.CHIP_W + 10) - 8 then
			return true
		end
	end
	return false
end

function H.fitName(ui, rowW, compact, state, face, ink)
	local chipW = compact and K.CHIP_SMALL or K.CHIP_W
	ui.TagState = state
	H.paintTag(ui, state, chipW)
	ui.Name.Size = UDim2.new(0, math.max(40, rowW - 70 - chipW - 18), 0, 28)
	ui.ChipText.Visible = not compact
	ui.Mark.Visible = compact
	PixelIcon.Set(ui.Mark, compact and ((state == "PICKED" and "check") or (state == "LOCKED" and "lock") or "arrow") or nil, 18, ink or Theme.TextOn(face))
end

-- (kit-b U9-8) the list's height and scroll: whole rows only at both edges. The rows and the list's pads share one gap, so a
-- row that ends at the list's edge is followed by the gap (never 2 px of the next row's lip); the picked row is brought
-- into view once after opening (CanvasPosition is screen px: the design px times the dock's scale)
function H.layoutList(heights, picked)
	local avail = math.max((S.Short and K.ROW_H_SHORT or K.ROW_H) + 2 * K.ROW_GAP, U.Holder.Size.Y.Offset - 82 - K.TOP_H)
	local tops, y = {}, K.ROW_GAP
	for i, h in ipairs(heights) do
		tops[i] = y
		y = y + h + K.ROW_GAP
	end
	local total = y
	local listH = total
	if total > avail then
		-- the most rows from the top that fit, each with its gap under it. (U9-8 look) the list then ends in the MIDDLE of
		-- the last gap: a row's wood edge is drawn outside it, so a list ending at the next row's top showed that edge as a
		-- brown line along the list's bottom (and, scrolled, the row above's along its top)
		listH = K.ROW_GAP
		for _, h in ipairs(heights) do
			if listH + h + K.ROW_GAP > avail then
				break
			end
			listH = listH + h + K.ROW_GAP
		end
		listH = listH - K.ROW_GAP / 2
	end
	local pad = CloudUI.Metrics.SignPagePad
	U.List.Size = UDim2.new(1, -2 * pad, 0, listH)
	if S.ScrollTo then
		S.ScrollTo = nil
		local want = 0
		if total > listH and picked and tops[picked] then
			want = math.min(total - listH, tops[picked] - K.ROW_GAP / 2) -- (U9-8 look: from the middle of the gap above it)
		end
		local scale = (U.Dock.Rect and tonumber(U.Dock.Rect.scale)) or 1
		U.List.CanvasPosition = Vector2.new(0, math.max(0, want) * scale)
	end
end

function H.refresh()
	if not S.Built or not S.Open then
		return
	end
	U.Dock.Refresh()
	local rect = U.Dock.Rect
	if rect then
		S.Short = rect.designH < K.SHORT
	end
	local short = S.Short
	local best = H.bestTimes()
	local picked = H.picked()
	local list = ObbyLevels.List()
	local heights, pickedIndex = {}, nil
	local rowW = H.rowWidth()
	local compact = H.compactTags(rowW)
	for i, ui in ipairs(U.Cards) do
		local id = ui.Id
		local open = ObbyLevels.IsUnlocked(best, id)
		local isPicked = open and id == picked
		local t = tonumber(best[id])
		local win = H.winTokens(id)
		local parts = {}
		if t and t > 0 then
			parts[#parts + 1] = "Best " .. H.clock(t)
		end
		if win then
			parts[#parts + 1] = "Win +" .. win .. " tokens"
		end
		-- the picked row opens to show its blurb (two lines; a short screen keeps every row one height)
		local withBlurb = isPicked and not short and ui.Blurb.Text ~= ""
		heights[i] = H.rowGeometry(ui, short) + (withBlurb and K.BLURB_H or 0)
		pickedIndex = isPicked and i or pickedIndex
		ui.Root.Size = UDim2.new(1, 0, 0, heights[i])
		ui.Blurb.Visible = withBlurb
		local prev = list[i - 1] and H.diff(list[i - 1]) or nil
		-- the tag by role: a locked level a sunk well in muted ink, the picked one gold with its tick, any other open level sky
		if not open then
			ui.Info.Text = "Beat " .. tostring(prev and prev.DisplayName or "the level before") .. " to unlock"
			PixelIcon.Mark(ui.Info, "lock") -- (kit-b U7b)
			ui.Info.TextColor3 = MUTED
			ui.ChipText.Text = "LOCKED"
			PixelIcon.Mark(ui.ChipText, nil)
			H.fitName(ui, rowW, compact, "LOCKED", SIGN.Well, MUTED)
		else
			ui.Info.Text = (#parts > 0) and table.concat(parts, "  " .. G.Dot .. "  ") or "Not beaten yet"
			PixelIcon.Mark(ui.Info, nil)
			ui.Info.TextColor3 = INK
			ui.ChipText.Text = isPicked and "PICKED" or "PICK"
			PixelIcon.Mark(ui.ChipText, isPicked and "check" or nil) -- (kit-b U7b)
			H.fitName(ui, rowW, compact, ui.ChipText.Text, isPicked and SIGN.Gold or SIGN.Sky)
		end
		CloudUI.SignBlock(ui.Root, open and "Stone" or "Off", {
			Face = isPicked and SIGN.Selected or nil,
			Edge = isPicked and SIGN.Text or nil,
			EdgePx = isPicked and 3 or 2,
			LipPx = 4,
			Pad = false,
		})
		if not open then
			ui.Pressed = false -- (a locked row has no press)
		end
		H.paintPress(ui)
		ui.Name.TextColor3 = open and INK or MUTED
		H.stars(ui, open)
		ui.Root:SetAttribute("Unlocked", open)
		ui.Root:SetAttribute("Picked", isPicked)
	end
	H.layoutList(heights, pickedIndex)
	if S.Hint and os.clock() < S.Hint.Until then
		U.Footer.Text = S.Hint.Text
		U.Footer.TextColor3 = MUTED
	else
		U.Footer.Text = H.footerFor(U.Footer)
		U.Footer.TextColor3 = INK
	end
end

function H.hint(text)
	S.Hint = { Text = tostring(text), Until = os.clock() + 3 }
	H.refresh()
end

----------------------------------------------------------------------
-- the unlock toast (kit-b U9-8: a kit B card at the top right, clear of the result card and the HUD; never centred)
----------------------------------------------------------------------
function H.buildToast()
	local gui = CloudUI.NewScreenGui("NimbusObbyToast", K.TOAST_ORDER)
	U.ToastGui = gui
	local card = H.frame(gui, "UnlockToast", { Size = UDim2.fromOffset(K.TOAST_W, K.TOAST_H), Visible = false })
	-- (a portrait phone: K.TOAST_NARROW_W wide, K.TOAST_NARROW_H high, so it fits right of the menu column: H.toastSize)
	-- (U9-8 look) the read scale first, so the card's edge and lip (SignKit.Whole) follow it to whole screen px
	U.ToastScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = card })
	CloudUI.SignBlock(card, "Stone", { EdgePx = 3, LipPx = 5, Pad = false })
	U.Toast = card
	-- the obby's mountain on a gold tile (the window's own icon), two nails holding the board up
	local tile = H.frame(card, "IconTile", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, Position = UDim2.fromOffset(14, 11), Size = UDim2.fromOffset(45, 45) })
	U.ToastTile = tile
	H.edge(tile, SIGN.Wood, 2)
	H.lip(tile, SIGN.GoldLip, 4)
	local icon = PixelIcon.New(tile, Config.Icons.Obby or "mountain", 27, INK)
	icon.Position = UDim2.fromOffset(9, 7)
	SignKit.Nails(card, { Size = 4, Inset = 5 })
	U.ToastText = H.text(card, "Text", "", "Heading", 20, INK, {
		Position = UDim2.fromOffset(72, 4),
		Size = UDim2.new(1, -84, 1, -13),
		TextWrapped = true,
	})
end

-- the toast's size for this screen (design px): a portrait phone's is narrower and a line taller (the text wraps in three)
function H.toastSize()
	local narrow = H.viewport().X / math.max(0.01, U.ToastScale.Scale) < K.TOAST_NARROW
	local w, h = narrow and K.TOAST_NARROW_W or K.TOAST_W, narrow and K.TOAST_NARROW_H or K.TOAST_H
	U.Toast.Size = UDim2.fromOffset(w, h)
	U.ToastTile.Position = UDim2.fromOffset(14, math.floor((h - 5 - 45) / 2)) -- (centred on the face above the 5 px lip)
	return w, h
end

-- what the toast keeps clear of, in this gui's px (an IgnoreGuiInset = false ScreenGui): the HUD's currency strips, match
-- panel, party panel and vitals, the menu column, the gift and the boost chips under it, NimbusNotify's result card (at its
-- final x: it slides in) and its toasts, the touch buttons
function H.toastAvoid()
	local out = {}
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return out
	end
	local okInset, inset = pcall(function()
		return game:GetService("GuiService"):GetGuiInset().Y
	end)
	inset = (okInset and tonumber(inset)) or 0
	local function shown(o)
		local cur = o
		while cur and not cur:IsA("LayerCollector") do
			if cur:IsA("GuiObject") and not cur.Visible then
				return false
			end
			cur = cur.Parent
		end
		return cur ~= nil and cur.Enabled ~= false
	end
	local function add(o, left)
		if o and o:IsA("GuiObject") and o.AbsoluteSize.X > 4 and o.AbsoluteSize.Y > 4 and shown(o) then
			local p, s = o.AbsolutePosition, o.AbsoluteSize
			local g = o:FindFirstAncestorWhichIsA("LayerCollector")
			local dy = (g and g:IsA("ScreenGui") and g.IgnoreGuiInset) and -inset or 0
			local x0 = left or p.X
			out[#out + 1] = { X = x0, Y = p.Y + (dy or 0), R = math.max(x0 + 1, left and H.viewport().X or (p.X + s.X)), B = p.Y + s.Y + (dy or 0) }
		end
	end
	local hud = pg:FindFirstChild("NimbusHud")
	for _, name in ipairs({ "Currency", "MatchPanel", "PartyPanel", "Vitals" }) do
		add(hud and hud:FindFirstChild(name, true))
	end
	for _, spec in ipairs({ { "NimbusMenu", "MenuColumn" }, { "NimbusDaily", "GiftsButton" }, { "NimbusBoosts", "Chip_Cash" }, { "NimbusBoosts", "Chip_Xp" } }) do
		local g = pg:FindFirstChild(spec[1])
		add(g and g:FindFirstChild(spec[2], true))
	end
	local notify = pg:FindFirstChild("NimbusNotify")
	local card = notify and notify:FindFirstChild("ResultCard", true)
	local left = notify and tonumber(notify:GetAttribute("ResultCardLeft")) or 0
	add(card, left > 0 and left or nil)
	local stack = notify and notify:FindFirstChild("ToastStack", true)
	for _, t in ipairs(stack and stack:GetChildren() or {}) do
		add(t)
	end
	local mobile = pg:FindFirstChild("MobileControls")
	if mobile and mobile:IsA("ScreenGui") and mobile.Enabled then
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("GuiButton") then
				add(d)
			end
		end
	end
	return out, inset
end

-- the toast's room at (x, y) for its size w x h (gui px): on the screen, never in the lower quarter, above the middle band of
-- the screen where it reaches into it sideways (NotifyController's rule), clear of every rect of H.toastAvoid
function H.toastFits(x, y, w, h, avoid, inset)
	local vp = H.viewport()
	local side = H.touchOnly() and K.TOUCH_EDGE or K.EDGE
	local r, b = x + w, y + h
	local lowest = (vp.Y - inset) * 0.72
	if x < vp.X * 0.65 and r > vp.X * 0.35 then
		lowest = math.min(lowest, vp.Y * 0.35 - 6 - inset)
	end
	if not (x >= side - 0.5 and y >= K.EDGE - 4 and r <= vp.X - side + 0.5 and b <= lowest) then
		return false
	end
	local g = K.TOAST_GAP / 2
	for _, a in ipairs(avoid) do
		if x < a.R + g and a.X < r + g and y < a.B + g and a.Y < b + g then
			return false
		end
	end
	return true
end

-- where the toast goes (its top-left, gui px), or nil when nothing has room: at the right edge under the currency strips,
-- else left of the result card, else under it, else left of the strips in the top row
function H.toastSpot()
	local vp = H.viewport()
	local k = U.ToastScale.Scale
	local w, h = H.toastSize()
	w, h = w * k, h * k
	local avoid, inset = H.toastAvoid()
	local side = H.touchOnly() and K.TOUCH_EDGE or K.EDGE
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local strips = hud and tonumber(hud:GetAttribute("TopRightBottom")) or 0
	local stripsLeft = hud and tonumber(hud:GetAttribute("TopRightLeft")) or 0
	local top = math.max(K.EDGE, strips > 0 and (strips + K.TOAST_GAP) or K.EDGE)
	local right = vp.X - side - w
	local spots = { { right, top } }
	local notify = pg and pg:FindFirstChild("NimbusNotify")
	local cardLeft = notify and tonumber(notify:GetAttribute("ResultCardLeft")) or 0
	local card = notify and notify:FindFirstChild("ResultCard", true)
	if cardLeft > 0 then
		spots[#spots + 1] = { cardLeft - K.TOAST_GAP - w, top }
		spots[#spots + 1] = { cardLeft - K.TOAST_GAP - w, K.EDGE }
		if card and card:IsA("GuiObject") then
			spots[#spots + 1] = { right, card.AbsolutePosition.Y + card.AbsoluteSize.Y + K.TOAST_GAP }
		end
	end
	if stripsLeft > 0 then
		spots[#spots + 1] = { stripsLeft - K.TOAST_GAP - w, K.EDGE }
	end
	for _, s in ipairs(spots) do
		local x, y = math.floor(s[1]), math.floor(s[2])
		if H.toastFits(x, y, w, h, avoid, inset) then
			return UDim2.fromOffset(x, y)
		end
	end
	return nil
end

-- shows the toast for K.TOAST_SECONDS once it has room (waiting up to K.TOAST_WAIT, then at the top right anyway). While it
-- shows it keeps its room: a panel that slides in under it (the match panel, a Notify toast) moves it to another spot, or
-- takes it away until there is room again (the time it was hidden does not count)
function H.toast(text)
	if not U.Toast then
		return
	end
	S.ToastToken = (S.ToastToken or 0) + 1
	local mine = S.ToastToken
	U.ToastText.Text = tostring(text)
	U.ToastScale.Scale = Theme.ScreenFactor()
	U.Toast.Visible = false
	local deadline = os.clock() + K.TOAST_WAIT
	task.spawn(function()
		task.wait() -- (the result card of the same MatchResult is built by the next frame)
		local shownFor, shown = 0, false
		while S.ToastToken == mine and shownFor < K.TOAST_SECONDS do
			if shown and not U.Toast.Visible then
				return -- (taken away from outside)
			end
			local k = U.ToastScale.Scale
			local avoid, inset = H.toastAvoid()
			local pos = U.Toast.Position
			if not (shown and H.toastFits(pos.X.Offset, pos.Y.Offset, U.Toast.Size.X.Offset * k, U.Toast.Size.Y.Offset * k, avoid, inset)) then
				local spot = H.toastSpot()
				if not spot and os.clock() >= deadline then
					spot = UDim2.fromOffset(math.floor(H.viewport().X - K.EDGE - U.Toast.Size.X.Offset * k), K.EDGE)
				end
				if spot then
					U.Toast.Position = spot
				end
				shown = spot ~= nil
				U.Toast.Visible = shown
			end
			local t0 = os.clock()
			task.wait(K.TICK)
			if shown then
				shownFor = shownFor + (os.clock() - t0)
			end
		end
		if S.ToastToken == mine then
			U.Toast.Visible = false
		end
	end)
end

----------------------------------------------------------------------
-- public API
----------------------------------------------------------------------
function H.onBack(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		ObbyController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

function H.syncBack()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, H.onBack, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

-- (kit-b U9-8) on a touch screen Roblox's thumbstick and jump button go while the picker is open (the jump button sat on the
-- lower rows of a landscape phone's dock) and come back as they were: MenuController keeps the one owner set (looked up at
-- open / close time: no require cycle), as the Dungeon and the Arena do
function H.syncTouch()
	local want = S.Open == true and H.touchOnly()
	if want == (S.TouchOff == true) then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		H.safe("touch", menu.SetTouchHidden, "Obby", want)
	end
end

function ObbyController.Open(levelId, portal)
	if not initialized then
		ObbyController.Init()
	end
	if not U.Gui then
		return false
	end
	if LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		return false
	end
	H.build()
	S.AtPortal = (typeof(portal) == "Instance") and portal or nil
	S.OpenedLocked = H.locked()
	local was = S.Open
	if not was then
		for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "ArenaController", "DungeonController" }) do
			local mod = H.controller(name)
			if mod and type(mod.Close) == "function" then
				pcall(mod.Close)
			end
		end
	end
	S.Open = true
	S.Token = S.Token + 1
	H.syncBack()
	H.syncTouch()
	U.Holder.Visible = true
	if not was then
		S.ScrollTo = true -- (kit-b U9-8) the picked level into view once
		U.Pop.Scale = 0.9
		H.tween(U.Pop, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if type(levelId) == "string" and ObbyLevels.IndexOf(levelId) then
		ObbyController.Pick(levelId)
	end
	H.refresh()
	if not was then
		ObbyController.Opened:Fire("Obby")
	end
	return true
end

function ObbyController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.AtPortal = nil
	S.Token = S.Token + 1
	local mine = S.Token
	H.syncBack()
	H.syncTouch()
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
			U.Pop.Scale = 1
		end
	end)
	ObbyController.Closed:Fire("Obby")
end

function ObbyController.IsOpen()
	return S.Open == true
end

function ObbyController.Pick(levelId)
	if type(levelId) ~= "string" or not ObbyLevels.IndexOf(levelId) then
		return false
	end
	if not ObbyLevels.IsUnlocked(H.bestTimes(), levelId) then
		local list = ObbyLevels.List()
		local i = ObbyLevels.IndexOf(levelId) or 1
		H.hint("Beat " .. tostring(H.diff(list[math.max(1, i - 1)]).DisplayName) .. " to unlock " .. tostring(H.diff(levelId).DisplayName))
		return false
	end
	if S.Party and not H.isLeader() then
		H.hint("The party leader picks the level")
		return false
	end
	local now = os.clock()
	if S.LastFire[levelId] and now - S.LastFire[levelId] < K.FIRE_GAP then
		return false
	end
	if not U.Remote then
		local ok, remote = pcall(Remotes.Get, "ObbyPick")
		U.Remote = ok and remote or nil
	end
	if not U.Remote then
		return false
	end
	S.LastFire[levelId] = now
	S.Want, S.WantAt = levelId, now
	pcall(function()
		U.Remote:FireServer(levelId)
	end)
	H.refresh()
	return true
end

function ObbyController.GetState()
	local best = H.bestTimes()
	local levels = {}
	local picked = H.picked()
	for _, id in ipairs(ObbyLevels.List()) do
		local open = ObbyLevels.IsUnlocked(best, id)
		levels[#levels + 1] = { Id = id, Unlocked = open, Picked = open and id == picked, Best = tonumber(best[id]) }
	end
	return { Window = S.Open and "Obby" or nil, Picked = picked, Highest = H.highest(), Levels = levels, Footer = H.footer() }
end

----------------------------------------------------------------------
-- server messages + Init
----------------------------------------------------------------------
function H.onParty(state)
	if type(state) == "table" and (state.PortalId == "Obby" or state.PortalId == nil) and type(state.Players) == "table" then
		S.Party = state
	else
		S.Party = nil
	end
	H.refresh()
end

-- a won match that raised the highest open level: "Extreme unlocked! Pick it at the Obby portal."
function H.onMatchResult(result)
	if type(result) ~= "table" or result.Won ~= true then
		return
	end
	S.WonAt = os.clock()
	local list = ObbyLevels.List()
	local before = S.Highest or H.highest()
	local index = ObbyLevels.IndexOf(result.DifficultyId) or 0
	local after = math.max(before, math.min(#list, index + 1))
	if after > before then
		S.Highest = after
		H.toast(tostring(H.diff(list[after]).DisplayName) .. " unlocked! Pick it at the Obby portal.")
	end
end

-- the gate's ObbyPrompt (OpenPanel = "Obby"): this controller opens the picker itself
function H.hookPrompt()
	game:GetService("ProximityPromptService").PromptTriggered:Connect(function(prompt)
		if typeof(prompt) == "Instance" and prompt:IsA("ProximityPrompt") and prompt:GetAttribute("OpenPanel") == "Obby" then
			H.safe("prompt", ObbyController.Open, nil, prompt.Parent)
		end
	end)
end

function ObbyController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusObby", K.DISPLAY_ORDER)
	H.buildToast()
	S.Highest = H.highest()
	State.Changed:Connect(function()
		-- the saved wins decide (a new profile can also lower it); a sync right after a won match that raised it
		-- (the MatchResult may come after the sync) shows the unlock toast here
		local now = H.highest()
		if S.Highest and now > S.Highest and os.clock() - (S.WonAt or -100) < 15 then
			local list = ObbyLevels.List()
			H.toast(tostring(H.diff(list[now]).DisplayName) .. " unlocked! Pick it at the Obby portal.")
		end
		S.Highest = now
		H.safe("State.Changed", H.refresh)
	end)
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		H.safe("relayout", H.refresh)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.ObbyLevel) or "ObbyLevel"):Connect(function()
			S.Want = nil
			H.safe("ObbyLevel", H.refresh)
		end)
		LocalPlayer:GetAttributeChangedSignal("PortalLocked"):Connect(function()
			-- stepping onto the pad closes a picker opened at the gate (the party panel's CHANGE reopens it)
			if S.Open and H.locked() and not S.OpenedLocked then
				ObbyController.Close()
			end
		end)
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
				ObbyController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			ObbyController.Close()
		end
	end)
	H.hookPrompt()
	task.spawn(function()
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) == "string" and panelId:lower() == "obby" then
					args = type(args) == "table" and args or {}
					H.safe("OpenPanel", ObbyController.Open, args.Level, H.portal())
				end
			end)
		end
		local okParty, partyRemote = pcall(Remotes.Get, "PartyState")
		if okParty and partyRemote then
			partyRemote.OnClientEvent:Connect(function(state)
				H.safe("PartyState", H.onParty, state)
			end)
		end
		local okResult, resultRemote = pcall(Remotes.Get, "MatchResult")
		if okResult and resultRemote then
			resultRemote.OnClientEvent:Connect(function(result)
				H.safe("MatchResult", H.onMatchResult, result)
			end)
		end
	end)
	task.defer(function()
		for _, spec in ipairs({ { "MenuController", "WindowOpened" }, { "IndexController", "Opened" }, { "FusionController", "Opened" },
			{ "CareController", "Opened" }, { "ArenaController", "Opened" }, { "DungeonController", "Opened" } }) do
			local mod = H.controller(spec[1])
			local signal = mod and mod[spec[2]]
			if type(signal) == "table" and type(signal.Connect) == "function" then
				signal:Connect(function(windowId)
					if windowId ~= "Obby" then
						ObbyController.Close()
					end
				end)
			end
		end
	end)
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick or not S.Open then
			return
		end
		nextTick = now + K.TICK
		local at = H.positionOf(S.AtPortal)
		local pos = H.rootPosition()
		if at and pos and (Vector3.new(pos.X - at.X, 0, pos.Z - at.Z)).Magnitude > K.WALK_AWAY then
			ObbyController.Close()
			return
		end
		H.safe("tick", H.refresh)
	end)
end

return ObbyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1155">
            <Properties>
              <string name="Name">PetController</string>
              <string name="Source"><![CDATA[-- PetController (client): every player's equipped pets follow their owner from BEHIND, with a floating pet card.
--
--   PetController.Init()
--   PetController.Stop()            -- tears everything down (tests / hot reload)
--   PetController.GetPetCount()     -- number of pet models currently alive (debug helper)
--   PetController.GetMoveStats()    -- { Rigid = n, Pivot = n }: pets posed in the last frame by one root write /
--                                      by the PivotTo fallback (debug helper for the smoke tests)
--   PetController.PlayEvolution(key, stage[, opts]) -> release()
--                                      Phase 4 (contract 3.6): parks the local player's follower of `key` (model and
--                                      card hidden) while CareController plays EvolutionFx on its own clones, then
--                                      rebuilds it at `stage` (1 | 2) and lets it fly back into its slot. opts: a number
--                                      (seconds to stay parked) or { Seconds = n, From = Vector3 (where the evolved
--                                      clone stood: the follower starts from there) }; default EvolutionFx.Duration
--                                      (stage) + 0.3 s. release(fromPosition?) ends the park early. The stage counts
--                                      until State's PetGrowth catches up (never lower than the stored stage).
--   PetController.GetCards()        -- debug: { { UserId, Key, Mode, Gui, Shown } } of every live pet card
--   PetController.GetFollowerInfo(player) -- debug: { { Key, Model, Stage = built model stage, Want = card stage,
--                                      Level, Card = BillboardGui | nil, Parked, Diving, Back / Side = the slot (studs), Width, Slot,
--                                      Sitting = the owner sits and the pet has its ground spot (bug batch 2 #7) } }
--   PetController.ParseHybrids(text) -> { Hybrids = { [uid] = record } }   (pure; the EquippedHybrids reader, field 6 =
--                                      Elements; public for the tests)
--
-- What it does
--   * Reads the player attribute `EquippedPets` (csv of pet KEYS, Config.Attr.EquippedPets) of EVERY player
--     and keeps one follower per player. A key is a plain pet id (Normal copy), "petId@Golden" / "petId@Rainbow"
--     (tier copies: PetBuilder draws the finish from Look.Finish) or "hyb:<uid>" (a fused hybrid). Every follower is
--     built from PetKeys.DefOf(key); hybrids need their record, which the server publishes for the equipped ones in
--     the attribute `EquippedHybrids` ("uid=Body/Style/Tier/Rarity[/Seed[/Elements]];...", PetService; field 6 =
--     the record's Elements joined by "+", so the first element matches the owner's). Keys that cannot be
--     described (unknown pets, a hybrid without its record yet) are ignored, at most Config.Pets.MaxEquipped are
--     used. All pets are drawn on this client only (workspace.ClientPets, one Folder per owner named after the
--     UserId); the server pays nothing.
--   * Each pet is a PetBuilder model. Right after it is built, every static part (body, head, eyes, eyelids...)
--     is welded once to the anchored PrimaryPart (like NpcController / ShowcaseController do), so a pose is ONE
--     CFrame write on the root: the engine carries the welded parts along. PetBuilder.Animate then re-poses only
--     the wing / tail / halo parts from the root (they stay anchored). A model that cannot be welded falls back
--     to PivotTo; a pet whose Animate keeps failing gets its animated parts welded too, so nothing trails behind.
--   * Phase 5 follow-behind (contract 3.8): pets trail in slots BEHIND the owner chosen from their measured widths
--     (PetController.FormationFor: 1 pet behind-right, 2 side by side with the smaller on the left, 3 as a V with the
--     biggest behind the right one; a 1.2-stud camera channel keeps the owner's centre line free), at about head
--     height, bob and sway a little with their own phase, ease towards their slot with a looser exponential filter
--     (rateH 4.2 + 0.6 per slot, LEAD_H 0.10), then a 2-pass separation pushes overlapping pets apart (and off the
--     owner) so big pets never touch or fuse; they face the direction the owner travels, bank into turns, pitch
--     forward when they speed up and flap harder when the owner runs or is in the air.
--   PetController.FormationFor(widths) -> { { side, back }, ... }   (pure; slots in the owner's frame, studs)
--   * Phase 4 evolved models (3.6): the stored evolution stage (State.PetGrowth(key).Evo for your own pets, the
--     player attribute EquippedInfo "level:stage,..." for others) is passed to PetBuilder.Build through opts.Evolved
--     only. Your own evolved followers are Low detail (<= petEvoLow 380 / petEvo2Low 520 parts); other players'
--     evolved followers are drawn evolved only within 40 studs and at most 6 at a time (nearest first), else as the
--     normal Low model (their card still shows the stars). Heights are measured once per key|stage (GetExtentsSize).
--   * Phase 4 pet cards (3.9, client/UI/PetCard.lua): your own followers show "Lv n" + the XP bar (State.PetLevel +
--     TycoonCatalog.XpToNext, refreshed on State.Changed) and the gold EVOLVE! pill when the pet is ready (a tap
--     opens the Pets panel on that pet); other players' followers show the level (and stars) from EquippedInfo
--     only, at most 12 cards at once (nearest first, MaxDistance 60). Cards hide while the owner is InBattle, while
--     a follower is parked or diving, and with the model. Card writes happen on events and in a 2 Hz tick only.
--   * Phase 4 home portal (3.10): when the owner's portal was just used (the player attribute HomePortal cleared /
--     PortalArrived written, and a teleport > 35 studs within 0.5 s of it) the followers fly into the portal centre
--     and shrink (0.4 s), then pop out of the arrival ring behind the owner (the fresh = 2 emerge path).
--   * bug batch 2 #7: while the owner sits (Humanoid.Sit / SeatPart: a lobby bench or any seat) the followers settle
--     on the ground in a row about 3 studs in front of the owner (side by side, no overlap), facing them, lying down in
--     HomeFx's nap pose (its LIE_ANGLE roll and SLEEP_ANIM slow wings, copied into SIT), and ease back into the
--     formation when the owner stands up. A battle still parks them first (that check comes before it).
--   * Phase 3: while the owner's player attribute `InBattle` is set (BattleService), the followers are parked: the
--     battle team fights on the floor, drawn by BattleController. They snap back into formation afterwards.
--     Wave 5 (bug #26): in a dungeon InBattle is the RUN id ("D12") for the whole run, so there the followers park
--     only while the attribute InFight is true (DungeonService: a room's fight); in the hall, the corridors, the
--     walk-ins and the treasure they follow. When InFight goes true -> nil they stay parked HANDOVER seconds more
--     (= BattleController's dungeon linger: the fighter model is still drawn), and longer while BattleController still
--     draws the fighter (BattleController.FighterDrawn: a LOST room's KO'd models linger), at most HANDOVER_MAX 5 s;
--     then they reappear and the fighter pet walks back into its slot from where BattleController last drew it
--     (BattleController.LastDrawn(userId)). The name cards show / hide with the followers.
--   * Owners that are downed keep their pets close; owners that teleport (> 35 studs in one step) or
--     respawn get their pets snapped back into formation. A pet that ends up > 60 studs from its slot snaps.
--   * Pets of OTHER players are only shown within 150 studs of the viewer (with a little hysteresis) and are
--     updated less often the further away they are (LOD). The local player's pets are always shown.
--   * Models are built lazily under a time budget (one per frame at least, more only while the frame's build
--     time stays under BUILD_BUDGET: a first-time High sculpt is far more expensive than a cached clone),
--     destroyed when the pet is unequipped, when the owner's character is removed or when the player leaves,
--     and parked (Parent = nil) while culled.
--
-- Performance: the per-frame code touches only numbers stored on long-lived tables, builds no tables or
-- closures, and creates exactly one CFrame per pet per update (the rotation matrix is written out by hand).
-- Per pet and frame Lua writes one root CFrame plus the animated parts (no part is written twice). Cards are
-- never written per frame. Everything is wrapped in pcall so one broken pet can never stop the others.
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local PetCatalog = require(Shared:WaitForChild("PetCatalog"))
local PetBuilder = require(Shared:WaitForChild("PetBuilder"))
-- Phase 2 pet keys (tiers + hybrids); without the module plain pet ids keep working through PetCatalog
local PetKeys = nil
do
	local module = Shared:FindFirstChild("PetKeys") or Shared:WaitForChild("PetKeys", 5)
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			PetKeys = result
		end
	end
end

-- optional modules: a build without one still draws the followers
local function optionalModule(parent, name, waitSeconds)
	if not parent then
		return nil
	end
	local inst = parent:FindFirstChild(name)
	if not inst and waitSeconds then
		inst = parent:WaitForChild(name, waitSeconds)
	end
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end
local Client = script.Parent and script.Parent.Parent
local TycoonCatalog = optionalModule(Shared, "TycoonCatalog")
local State = optionalModule(Client, "State")
local PetCard = optionalModule(Client and Client:FindFirstChild("UI"), "PetCard")

local PetController = {}

local LocalPlayer = Players.LocalPlayer
local ATTR = Config.Attr
local PHYS = Config.Physics

local sin, cos, exp, sqrt, abs = math.sin, math.cos, math.exp, math.sqrt, math.abs
-- Luau and Lua 5.1 have math.atan2; Lua 5.3+ folds it into math.atan(y, x). Support both.
local atan2 = math.atan2 or function(y, x)
	return math.atan(y, x)
end
local PI = math.pi
local TAU = math.pi * 2

----------------------------------------------------------------------
-- Tuning (feel only)
----------------------------------------------------------------------
local FOLDER_NAME = "ClientPets"
local HYBRID_ATTR = "EquippedHybrids" -- written by PetService (not in Config.Attr): looks of the equipped hybrids
local MAX_EQUIPPED = 3
if type(Config.Pets) == "table" and type(Config.Pets.MaxEquipped) == "number" then
	MAX_EQUIPPED = math.max(1, math.floor(Config.Pets.MaxEquipped))
end

-- Culling / level of detail (studs from the local player's character, or from the camera while it has
-- none; the local player's own pets ignore all of this)
local CULL_IN = 138 -- other players' pets appear inside this distance ...
local CULL_OUT = 150 -- ... and are parked beyond this one
local LOD_MID = 55 -- beyond this distance a follower is updated every 2nd frame
local LOD_FAR = 105 -- ... and beyond this one every 4th frame

-- Teleports and catch-up
local TELEPORT_STEP2 = 35 * 35 -- owner moved further than this in one update -> snap the formation
local SNAP_DIST2 = 60 * 60 -- a pet further than this from its slot snaps to it

-- wave 5 (bug #26): seconds the followers wait after a dungeon fight (= BattleController K.DUNGEON_LINGER)
local HANDOVER = 1.0
PetController.HANDOVER = HANDOVER
-- the hand-over also waits while BattleController still draws the fighter (a LOST room: the KO'd models linger
-- END_LINGER 3.5 s with the result card), but never longer than this after the fight ended
local HANDOVER_MAX = 5.0
PetController.HANDOVER_MAX = HANDOVER_MAX
local ATTR_IN_FIGHT = (Config.Attr and Config.Attr.InFight) or "InFight"

-- Time steps
local MAX_DT = 0.1
local MIN_DT = 1 / 240
local ROOT_POLL = 0.25 -- seconds between searches for a missing HumanoidRootPart
local SLOW_TICK = 0.5 -- seconds between housekeeping checks per follower
-- Builds per frame: a cached clone costs a few ms, a first-time High sculpt (~300 parts) tens of ms, so the
-- budget is time, not a count: the first build of a frame always runs, the next ones only while the frame has
-- spent less than BUILD_BUDGET seconds building, and never more than BUILD_MAX.
local BUILD_BUDGET = 0.004
local BUILD_MAX = 3
local BUILD_RETRY = 5 -- seconds before a failed build is tried again
local WELD_NAME = "PetFollowWeld"

-- Owner motion estimate
local VEL_RATE = 12 -- smoothing of the owner velocity (1/s)
local MAX_SPEED = 140 -- clamp for the instantaneous velocity (dash 85, cannons ~170)
local HEAD_MIN_SPEED = 3 -- below this the owner "faces" its LookVector instead of its velocity
local HEAD_RATE_MOVE = 4 -- how fast the formation swings round while the owner travels (1/s)
local HEAD_RATE_IDLE = 1.6 -- ... and while it stands still and turns on the spot
local RUN_K_FROM = 14 -- horizontal speed where the "running" factor starts ...
local RUN_K_SPAN = math.max(6, (PHYS and PHYS.RunSpeed or 27) - 14) -- ... and where it reaches 1
local RUN_RATE = 5
local AIR_RATE = 8
local DOWN_RATE = 4

-- Pet motion
local LEAD_H = 0.10 -- seconds of owner velocity added to the target (cancels most of the filter lag)
local LEAD_V = 0.05
local RUN_RISE = 0.6 -- studs the pets rise at full run speed
local FACE_RATE = 7 -- pet yaw easing (1/s)
local TILT_RATE = 9 -- pitch / roll easing (1/s)
local BANK_GAIN = 0.1 -- radians of roll per radian/second of yaw rate
local BANK_MAX = 0.55
local PITCH_GAIN = 0.0125 -- radians of nose-down pitch per stud/second of forward speed

-- Phase 5 formation (contract 3.8, the player's "big pets touch each other; follow without fusing, less attached"):
-- slots come from the measured model widths (PetController.FormationFor), a camera channel keeps every pet off the
-- owner's centre line, and a 2-pass separation after the filter keeps pets apart from each other and the owner.
local F5 = {
	OWNER_R = 1.5, -- the owner as a horizontal circle (studs)
	GAP_OWNER = 2.5, -- studs between the owner circle and the front row
	GAP_PET = 1.0, -- studs between the right-hand pet and the one behind it
	CHANNEL = 1.2, -- no pet within this many studs of the owner's centre line (the camera sees the player)
	DIAG = 0.35, -- the front row tucks in by this share of the smaller half width
	SEP_GAP = 0.4, -- studs the separation keeps between two pets / a pet and the owner
	DEFAULT_W = 3.2, -- width of a pet whose model is not measured yet (the stage-0 median)
	UP = { -- studs above the HumanoidRootPart per slot (n pets): about head height, the back pet a little higher
		[1] = { 2.3 },
		[2] = { 2.0, 2.6 },
		[3] = { 1.9, 2.5, 2.9 },
	},
	RATE_H = 4.2, -- horizontal filter rate of slot 1 (1/s), +RATE_STEP per further slot (looser than Phase 4)
	RATE_STEP = 0.6,
}

-- Phase 4 tuning (cards, evolved models, the portal dive)
local P4K = {
	CARD_HEIGHT = 0.7, -- studs above the top of the pet
	OTHER_CARDS = 12, -- other players' cards at once (nearest first) ...
	OTHER_CARD_DIST = 60, -- ... within this distance (also the cards' MaxDistance)
	OTHER_EVO_MAX = 6, -- other players' evolved models at once (nearest first) ...
	OTHER_EVO_IN = 40, -- ... within this distance
	OTHER_EVO_OUT = 46, -- an evolved model already shown keeps its look up to here (no flicker at the edge)
	EVO_GRACE = 0.6, -- s: a stage that rose without PlayEvolution waits this long (the animation may park it first)
	GLOBAL_TICK = 0.5, -- s between card / evolved-model selections
	DIVE_TIME = 0.4, -- s the followers take to fly into a used home portal
	DIVE_WINDOW = 0.5, -- s: a teleport this close to the portal closing is a portal trip
	DIVE_NEAR = 8, -- studs: an owner this close to an open portal who teleports used it
	PARK_DEFAULT = 4.6, -- s a follower stays parked by PlayEvolution when EvolutionFx cannot say
	OVERRIDE_GRACE = 15, -- s after the park: a PlayEvolution stage State never confirmed is dropped (State wins)
}

-- bug batch 2 #7 (the player: "when a player sits on [a bench] the pets sit on the ground"): the settle-while-sitting
-- tuning and helpers. The pose numbers are HomeFx's nap pose (G.LIE_ANGLE, G.SLEEP_ANIM), copied: HomeFx is not required.
local SIT = {
	AHEAD = 2.2, -- studs from the owner's root to the near edge of a pet (its centre: AHEAD + r, ~3-4 studs)
	GAP = 0.5, -- studs between two pets of the row
	LIE_ANGLE = 1.35, -- HomeFx G.LIE_ANGLE: radians a resting pet rolls onto its side
	ANIM_FLAP = 0.15, -- HomeFx G.SLEEP_ANIM = { Flap = 0.15 }
	RATE_V = 3, -- vertical filter rate while settling down / getting up (1/s; following: 7.5-10)
	TILT_RATE = 3, -- roll / pitch easing while settling down / getting up (1/s; following: TILT_RATE 9)
	EASE_OUT = 2, -- s after the owner stands up that the slower rates still apply
	MAX_SPEED = 14, -- studs/s a pet may glide while settling down / getting up (+ the owner's own speed): no zooming
	REPLAN = 1.5, -- studs the owner may move (a moving seat) before the row is laid out again
	DROP = 14, -- studs searched below the owner for the ground
	FALLBACK_DROP = 3, -- the ground under the owner's root when the ray finds nothing
	params = nil, -- RaycastParams (lazy, reused)
	lows = {}, -- ["key|stage"] = SIT.lieLow of the fresh model (wings / tail at rest, like HomeFx measures it)
}

-- Wing speed. PetBuilder.Animate beats the wings at FLAP_HZ * Flap * (1 + 1.25 * Excited) per second, so the
-- two channels multiply. Running while jumping is the normal state in a parkour game, and an uncapped product
-- reached 11-15 beats/s (4-5 frames per beat at 60 fps, strobing at 30 fps), so the speed-up is capped here.
local PB_FLAP_HZ = 2.0 -- PetBuilder's FLAP_HZ (beats per second at Flap = 1, Excited = 0)
local MAX_BEAT_HZ = 6.0 -- ceiling for the whole product, at the fastest per-pet flapVar
local FLAP_VAR_MAX = 1.15 -- 0.9 + 0.25, the top of the per-pet flapVar range

local BUILD_OPTS = { Scale = 1 }

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local petsFolder = nil -- workspace.ClientPets
local followers = {} -- [Player] = follower
local order = {} -- array of followers (swap-remove), iterated every frame
local followerCount = 0
local localFollower = nil -- the follower of LocalPlayer (reference point for culling)
local renderConn = nil
local playerConns = {}
local frameIndex = 0
local buildsThisFrame = 0 -- models built in the current frame
local meshVerNow = 0 -- Phase 6 (runtime-pets): PetBuilder.MeshVersion() of this frame (a change = some mesh keys usable)
local buildStart = 0 -- os.clock() when the frame's first build started
local movedRigid, movedPivot = 0, 0 -- pets posed in the current frame (root write / PivotTo fallback)
local lastRigid, lastPivot = 0, 0 -- ... in the last finished frame (GetMoveStats)
local nextFolderCheck = 0
local warnedAt = {} -- [key] = os.clock() of the last warning (rate limit)
-- Phase 4: every new helper lives in this table (keeps the file's active locals low)
local P4 = {
	heights = {}, -- ["key|stage"] = measured model height (GetExtentsSize Y, Scale 1)
	widths = {}, -- ["key|stage"] = measured model width (max of GetExtentsSize X / Z, Scale 1; FormationFor)
	overrides = {}, -- [key] = stage passed to PlayEvolution (until State's PetGrowth catches up)
	overrideUntil = {}, -- [key] = os.clock() after which an unconfirmed override is stale (park end + OVERRIDE_GRACE)
	parks = {}, -- [key] = { Until = os.clock(), From = Vector3 | nil } while PlayEvolution parks that follower
	nextGlobal = 0, -- os.clock() of the next card / evolved-model selection
	stateConn = nil,
	menu = nil, -- MenuController (lazy, for the EVOLVE! pill)
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function clamp(x, lo, hi)
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

-- Shortest signed difference of two angles, in [-PI, PI).
local function wrapAngle(a)
	return (a + PI) % TAU - PI
end

local function warnLimited(key, message)
	local now = os.clock()
	local last = warnedAt[key]
	if last == nil or now - last > 10 then
		warnedAt[key] = now
		warn("[PetController] " .. tostring(message))
	end
end

local function ensurePetsFolder()
	if petsFolder and petsFolder.Parent == workspace then
		return petsFolder
	end
	local existing = workspace:FindFirstChild(FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		petsFolder = existing
	else
		petsFolder = Instance.new("Folder")
		petsFolder.Name = FOLDER_NAME
		petsFolder.Parent = workspace
	end
	return petsFolder
end

----------------------------------------------------------------------
-- Slots
----------------------------------------------------------------------
-- side, up, back, ahead for pet `i` of `n` (a generic fan for unusual MaxEquipped values).
-- PetController.FormationFor(widths) -> { { side, back }, ... } (pure; contract 3.8): the slot of each pet (same order
-- as `widths`, studs in the owner's frame: side + = right, back = behind the root) from the pets' widths.
--   1 pet:  behind-right { Channel + w/2, OwnerRadius + GapOwner + w/2 - Diag x w/2 }
--   2 pets: the smaller left { -(Channel + wa/2), row }, the other right { Channel + wb/2, row },
--           row = OwnerRadius + GapOwner + max(wa, wb)/2 - Diag x min(wa, wb)/2
--   3 pets: the two smallest as for 2; the biggest behind the right one { Channel + wc/2, row + wb/2 + GapPet + wc/2 }
--   n > 3 (never with a team of 3): the V goes on, every further pet behind the last one of its side
-- Ties keep the input order. Junk widths count as F5.DEFAULT_W.
local function formationFor(widths)
	local out = {}
	if type(widths) ~= "table" then
		return out
	end
	local n = #widths
	if n == 0 then
		return out
	end
	local w = {}
	local order = {}
	for i = 1, n do
		local v = tonumber(widths[i])
		if not v or v ~= v or v <= 0 or v == math.huge then
			v = F5.DEFAULT_W
		end
		w[i] = v
		order[i] = i
	end
	table.sort(order, function(a, b)
		if w[a] ~= w[b] then
			return w[a] < w[b]
		end
		return a < b
	end)
	local C, R, G, D = F5.CHANNEL, F5.OWNER_R, F5.GAP_OWNER, F5.DIAG
	if n == 1 then
		local x = w[1]
		out[1] = { C + x / 2, R + G + x / 2 - D * x / 2 }
		return out
	end
	local a, b = order[1], order[2]
	local wa, wb = w[a], w[b]
	local row = R + G + math.max(wa, wb) / 2 - D * math.min(wa, wb) / 2
	out[a] = { -(C + wa / 2), row }
	out[b] = { C + wb / 2, row }
	-- the rest: behind the last pet of the right side, then the left, and so on (3 pets: the biggest behind the right one)
	local lastR, lastL = { b, row }, { a, row }
	for k = 3, n do
		local c = order[k]
		local wc = w[c]
		local right = (k % 2) == 1
		local last = right and lastR or lastL
		local back = last[2] + w[last[1]] / 2 + F5.GAP_PET + wc / 2
		out[c] = { (right and 1 or -1) * (C + wc / 2), back }
		if right then
			lastR = { c, back }
		else
			lastL = { c, back }
		end
	end
	return out
end

-- the slots of every pet of one follower from their measured widths (unmeasured: F5.DEFAULT_W)
local function assignSlots(f)
	local n = f.n
	local widths = {}
	for i = 1, n do
		widths[i] = f.pets[i].width or F5.DEFAULT_W
	end
	local slots = formationFor(widths)
	local ups = F5.UP[n]
	for i = 1, n do
		local p = f.pets[i]
		local s = slots[i]
		p.slot = i
		p.side, p.back, p.ahead = s[1], s[2], 0
		p.up = (ups and ups[i]) or (1.9 + (i % 3) * 0.5)
		p.r = (p.width or F5.DEFAULT_W) / 2
		p.rateH = F5.RATE_H + F5.RATE_STEP * (i - 1)
	end
end

----------------------------------------------------------------------
-- Pet records and models
----------------------------------------------------------------------
local function newPetRecord(def, key)
	local rnd = math.random
	return {
		def = def,
		id = key or def.Id, -- the copy's key (tier copies and hybrids are different followers than Normal ones)
		model = nil,
		slot = 1,
		side = 0,
		up = 2,
		back = 1,
		ahead = 0,
		lift = 0, -- extra hover for tall pets
		-- Phase 4
		key = key or def.Id,
		infoIndex = 0, -- position of the key in EquippedPets (EquippedInfo uses the same order)
		stage = 0, -- the stage the model was built at
		want = 0, -- the stage the pet has (card stars; the model follows unless capped)
		level = 1,
		width = nil, -- the measured model width (studs, FormationFor); nil until the model is built
		r = F5.DEFAULT_W / 2, -- half the width: the pet's circle for the separation
		height = 2.7,
		card = nil, -- PetCard (own pets always, others' only when selected)
		rebuildAt = nil, -- os.clock() when the model must be rebuilt at `want`
		parked = false, -- PlayEvolution: hidden while the evolution plays
		emergeFrom = nil, -- Vector3: the next fresh pose starts here (the evolved clone's spot)
		diveStep = 0,
		-- personality (so a group never moves in lockstep)
		phase = rnd() * TAU,
		phase2 = rnd() * TAU,
		bobRate = 2.3 + rnd() * 1.1,
		bobAmp = 0.34 + rnd() * 0.16,
		swayRate = 0.8 + rnd() * 0.6,
		swayAmp = 0.1 + rnd() * 0.08, -- small: the camera channel and the gaps hold while it sways
		rateH = F5.RATE_H, -- set by assignSlots from the slot
		rateV = 7.5 + rnd() * 2.5,
		flapVar = 0.9 + rnd() * 0.25,
		yawBias = (rnd() - 0.5) * 0.3,
		-- motion state
		x = 0,
		y = 0,
		z = 0,
		yaw = 0,
		pitch = 0,
		roll = 0,
		fresh = 1, -- 0 settled, 1 snap into the slot, 2 emerge from the owner
		retryAt = 0,
		animFails = 0,
		root = nil, -- the model's anchored PrimaryPart
		rigid = false, -- true: the static parts are welded to `root` (a pose is one root CFrame write)
		pivotInv = nil, -- inverse of root.PivotOffset when it is not the identity
		opts = { Flap = 1, Excited = 0 }, -- reused every frame for PetBuilder.Animate
	}
end

local function destroyPetModel(p)
	local model = p.model
	p.model = nil
	p.root = nil
	p.rigid = false
	if p.card then
		pcall(p.card.Destroy, p.card)
		p.card = nil
	end
	if model then
		pcall(model.Destroy, model)
	end
end

-- Parts that PetBuilder.Animate re-poses on every call: members of a PB_G group with a PB_Base pose, except the
-- eyelids ("lid" groups only change their transparency, they move with the head like every static part).
local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" or type(part:GetAttribute("PB_Base")) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

-- Welds parts of `model` to its anchored `root` at their current offset (once per build, never per frame).
-- all = false: the static parts only (Animate keeps posing the rest); true: every part that is still anchored.
local function weldParts(model, root, all)
	local inv = root.CFrame:Inverse()
	local identity = CFrame.new()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and part.Anchored and (all or not isAnimatedPart(part)) then
			local weld = Instance.new("Weld")
			weld.Name = WELD_NAME
			weld.Part0 = root
			weld.Part1 = part
			weld.C0 = inv * part.CFrame
			weld.C1 = identity
			weld.Parent = part
			part.Anchored = false
		end
	end
	root.Anchored = true
end

-- Builds the model of one pet (inside pcall: a broken definition must not take the controller down).
-- Phase 4: the stage goes through opts.Evolved only (never on the shared def); own evolved pets are Low detail.
local function buildModel(f, p)
	local stage = P4.modelStage(f, p)
	local detail = (f.isLocal and stage == 0) and "High" or "Low" -- v3 LOD: own pets High, others Low; evolved Low
	local opts = { Scale = BUILD_OPTS.Scale, Detail = detail }
	if stage > 0 then
		opts.Evolved = stage
	end
	local ok, model = pcall(PetBuilder.Build, p.def, opts)
	if not ok or typeof(model) ~= "Instance" then
		p.retryAt = os.clock() + BUILD_RETRY
		warnLimited("build_" .. tostring(p.id), "could not build pet " .. tostring(p.id) .. ": " .. tostring(model))
		return
	end
	p.stage = stage
	p.rebuildAt = nil
	-- the model's height and width, measured once per key|stage: taller pets hover a little higher, the card
	-- floats over the head, and the width decides the pet's slot (FormationFor) and its separation circle
	local hkey = tostring(p.key) .. "|" .. stage
	local h, wd = P4.heights[hkey], P4.widths[hkey]
	if not h or not wd then
		local okSize, size = pcall(model.GetExtentsSize, model)
		if okSize and typeof(size) == "Vector3" then
			h = size.Y
			wd = math.max(size.X, size.Z)
			P4.heights[hkey] = h
			P4.widths[hkey] = wd
		end
	end
	h = h or 2.7
	p.height = h
	-- bug batch 2 #7: the lying low point, measured on the fresh model (wings / tail at rest), once per key|stage
	local lo = SIT.lows[hkey]
	if lo == nil then
		lo = SIT.lieLow(model)
		SIT.lows[hkey] = lo
	end
	p.lieLo, p.lieModel = lo, model
	p.lift = clamp((h - 2.7) * 0.35, -0.4, 0.6)
	wd = wd or F5.DEFAULT_W
	if p.width ~= wd then
		p.width = wd
		assignSlots(f) -- a new width moves every slot of this follower (the filter eases the pets there)
	end
	pcall(model.SetAttribute, model, "PC_Key", tostring(p.key))
	pcall(model.SetAttribute, model, "PC_Stage", stage)
	-- weld the static parts to the anchored root once: every later pose is a single root CFrame write
	-- (followers live in workspace, where joints are solved; never do this inside a ViewportFrame)
	local root = model.PrimaryPart
	p.root, p.rigid, p.pivotInv = nil, false, nil
	if root and root:IsA("BasePart") then
		local okWeld, err = pcall(weldParts, model, root, false)
		if okWeld then
			p.root = root
			p.rigid = true
			local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = root.PivotOffset:GetComponents()
			if abs(x) + abs(y) + abs(z) > 1e-6 or abs(r00 - 1) + abs(r11 - 1) + abs(r22 - 1) + abs(r01) + abs(r02) + abs(r10) + abs(r12) + abs(r20) + abs(r21) > 1e-6 then
				p.pivotInv = root.PivotOffset:Inverse()
			end
		else
			warnLimited("weld_" .. tostring(p.id), "could not weld pet " .. tostring(p.id) .. ", using PivotTo: " .. tostring(err))
		end
	end
	p.model = model
	p.animFails = 0
	model.Parent = f.folder
	if f.isLocal or p.cardOk then
		P4.ensureCard(f, p) -- a rebuilt model keeps its card (others' cards: chosen by P4.globalTick)
	end
end

-- Animate gave up on this pet: weld its animated parts too (in their last pose), so they keep following.
local function freezeAnimatedParts(p)
	if p.rigid and p.model and p.root then
		pcall(weldParts, p.model, p.root, true)
	end
end

----------------------------------------------------------------------
-- Follower lifecycle
----------------------------------------------------------------------
local function newFollower(player)
	local folder = Instance.new("Folder")
	folder.Name = tostring(player.UserId)
	return {
		player = player,
		userId = player.UserId,
		isLocal = (player == LocalPlayer),
		folder = folder,
		visible = false,
		pets = {},
		n = 0,
		csv = "",
		hyb = "",
		applied = false,
		char = nil,
		root = nil,
		conns = {},
		index = 0,
		downed = false,
		established = false,
		-- bug batch 2 #7: the owner's Humanoid and the sitting row (SIT)
		hum = nil,
		sitPlanned = false,
		sitPx = 0,
		sitPy = 0,
		sitPz = 0,
		sitFx = 0,
		sitFz = -1,
		sitUntil = 0,
		failures = 0,
		disabled = false,
		nextRootCheck = 0,
		nextSlow = 0,
		accDt = 0,
		resetPending = true,
		-- owner motion estimate
		ox = 0,
		oy = 0,
		oz = 0,
		vx = 0,
		vy = 0,
		vz = 0,
		runK = 0,
		airK = 0,
		downK = 0,
		headYaw = 0,
		-- Phase 4
		info = {}, -- EquippedInfo: [index] = { level, stage }
		infoText = nil,
		dist = 0, -- studs from the viewer (2 Hz)
		portal = nil, -- the open home portal { x, y, z } (HomePortal attribute)
		portalGone = nil, -- the portal that closed last ...
		portalGoneAt = -1e9, -- ... and when (os.clock())
		arrivedAt = -1e9, -- PortalArrived seen (os.clock())
		dive = false, -- portal dive running
		diveT0 = 0,
		diveX = 0,
		diveY = 0,
		diveZ = 0,
	}
end

local function snapAllPets(f)
	for i = 1, f.n do
		f.pets[i].fresh = 1
	end
end

-- Shows / parks the follower's folder. Positions are stale after being parked, so snap on show.
local function setVisible(f, visible)
	if f.visible == visible then
		return
	end
	f.visible = visible
	if visible then
		f.folder.Parent = ensurePetsFolder()
		f.resetPending = true
		f.accDt = 0
		snapAllPets(f)
	else
		f.folder.Parent = nil
	end
	P4.syncCards(f)
end

-- The owner has no character (died, respawning, left): pets are destroyed and rebuilt for the new one.
local function releaseCharacter(f)
	f.root = nil
	f.char = nil
	f.hum = nil
	f.sitPlanned = false
	f.established = false
	f.nextRootCheck = 0
	setVisible(f, false)
	for i = 1, f.n do
		local p = f.pets[i]
		destroyPetModel(p)
		p.fresh = 1
	end
end

local function acquireRoot(f)
	local char = f.player.Character
	if not char then
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") or not root.Parent then
		return
	end
	f.root = root
	f.char = char
	local pos = root.Position
	f.ox, f.oy, f.oz = pos.X, pos.Y, pos.Z
	f.vx, f.vy, f.vz = 0, 0, 0
	f.runK, f.airK, f.downK = 0, 0, 0
	f.resetPending = true
	f.accDt = 0
	local look = root.CFrame.LookVector
	f.headYaw = atan2(-look.X, -look.Z)
	snapAllPets(f)
end

-- "uid=Body/Style/Tier/Rarity[/Seed[/Elements]];..." -> a stand-in profile { Hybrids = { [uid] = record } } for
-- PetKeys.DefOf. Field 6 (gui-redo) = the owner's Elements order joined by "+" -> rec.Elements (DefOf drops unknown names);
-- without it DefOf falls back to the parents' elements as before. Later fields are ignored.
local function parseHybrids(text)
	local hybrids = {}
	if type(text) ~= "string" then
		return { Hybrids = hybrids }
	end
	for entry in string.gmatch(text, "[^;]+") do
		local uid, rest = string.match(entry, "^%s*([%w_%-]+)=(.+)$")
		if uid then
			local fields = {}
			for field in string.gmatch(rest .. "/", "([^/]*)/") do
				fields[#fields + 1] = field
			end
			if fields[1] and fields[1] ~= "" and fields[2] and fields[2] ~= "" then
				local rec = { Body = fields[1], Style = fields[2], Tier = "Normal" }
				if fields[3] == "Golden" or fields[3] == "Rainbow" then
					rec.Tier = fields[3]
				end
				if fields[4] and fields[4] ~= "" then
					rec.Rarity = fields[4]
				end
				local seed = tonumber(fields[5])
				if seed then
					rec.Seed = seed
				end
				if fields[6] and fields[6] ~= "" then
					local elements = {}
					for e in string.gmatch(fields[6], "[^+]+") do
						elements[#elements + 1] = e
					end
					if #elements > 0 then
						rec.Elements = elements
					end
				end
				hybrids[uid] = rec
			end
		end
	end
	return { Hybrids = hybrids }
end
PetController.ParseHybrids = parseHybrids -- public for the tests (gui-redo Task 3); no new top-level local

-- The definition to build for one key (nil: skip it).
local function defForKey(key, hybridProfile)
	if PetKeys then
		local ok, def = pcall(PetKeys.DefOf, key, hybridProfile)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	return PetCatalog.Get(key)
end

-- Rebuilds the pet list from the player's attributes: keeps matching pets, destroys the rest, adds new ones.
local function applyEquipped(f)
	local csv = f.player:GetAttribute(ATTR.EquippedPets)
	if type(csv) ~= "string" then
		csv = ""
	end
	local hyb = f.player:GetAttribute(HYBRID_ATTR)
	if type(hyb) ~= "string" then
		hyb = ""
	end
	if f.applied and csv == f.csv and hyb == f.hyb then
		return
	end
	f.applied = true
	f.csv = csv
	f.hyb = hyb

	local hybridProfile = parseHybrids(hyb)
	local wanted, wantedKeys, wantedIndex = {}, {}, {}
	local index = 0
	for token in string.gmatch(csv, "[^,]+") do
		index = index + 1
		local key = string.match(token, "^%s*(.-)%s*$")
		local def = key ~= "" and defForKey(key, hybridProfile) or nil
		if def and #wanted < MAX_EQUIPPED then
			wanted[#wanted + 1] = def
			wantedKeys[#wanted] = key
			wantedIndex[#wanted] = index
		end
	end

	local old = f.pets
	local used = {}
	local pets = {}
	for i = 1, #wanted do
		local def = wanted[i]
		local key = wantedKeys[i]
		local found = nil
		for j = 1, #old do
			-- same key and the same definition (a hybrid whose record changed is rebuilt)
			if not used[j] and old[j].id == key and old[j].def == def then
				used[j] = true
				found = old[j]
				break
			end
		end
		if not found then
			found = newPetRecord(def, key)
			-- a pet equipped while its owner is already flying around emerges from the owner
			if f.established then
				found.fresh = 2
			end
		end
		found.infoIndex = wantedIndex[i]
		pets[i] = found
	end
	for j = 1, #old do
		if not used[j] then
			destroyPetModel(old[j])
		end
	end
	f.pets = pets
	f.n = #pets
	assignSlots(f)
	P4.refreshFollower(f)
end

local function destroyFollower(f)
	for i = 1, #f.conns do
		pcall(f.conns[i].Disconnect, f.conns[i])
	end
	f.conns = {}
	for i = 1, #f.pets do
		destroyPetModel(f.pets[i])
	end
	f.pets = {}
	f.n = 0
	f.root = nil
	f.char = nil
	local folder = f.folder
	f.folder = nil
	f.visible = false
	if folder then
		pcall(folder.Destroy, folder)
	end
end

local function removeFollower(player)
	local f = followers[player]
	if not f then
		return
	end
	followers[player] = nil
	if localFollower == f then
		localFollower = nil
	end
	local idx = f.index
	local last = order[followerCount]
	if last ~= f then
		order[idx] = last
		last.index = idx
	end
	order[followerCount] = nil
	followerCount = followerCount - 1
	destroyFollower(f)
end

local function trackPlayer(player)
	if followers[player] then
		return
	end
	local f = newFollower(player)
	followers[player] = f
	if f.isLocal then
		localFollower = f
	end
	followerCount = followerCount + 1
	f.index = followerCount
	order[followerCount] = f

	local conns = f.conns
	conns[#conns + 1] = player:GetAttributeChangedSignal(ATTR.EquippedPets):Connect(function()
		applyEquipped(f)
	end)
	conns[#conns + 1] = player:GetAttributeChangedSignal(HYBRID_ATTR):Connect(function()
		applyEquipped(f)
	end)
	conns[#conns + 1] = player:GetAttributeChangedSignal(ATTR.Downed):Connect(function()
		f.downed = player:GetAttribute(ATTR.Downed) == true
	end)
	conns[#conns + 1] = player.CharacterAdded:Connect(function()
		f.nextRootCheck = 0 -- look for the new HumanoidRootPart on the next frame
	end)
	-- wave 5 (bug #26): a dungeon fight ended (InFight true -> nil): the hand-over (the fighter model goes first)
	f.inFight = player:GetAttribute(ATTR_IN_FIGHT) == true
	conns[#conns + 1] = player:GetAttributeChangedSignal(ATTR_IN_FIGHT):Connect(function()
		local on = player:GetAttribute(ATTR_IN_FIGHT) == true
		if f.inFight and not on then
			f.handoverUntil = os.clock() + HANDOVER
			f.handoverCap = os.clock() + HANDOVER_MAX
		elseif on then
			f.handoverUntil = nil
			f.handoverCap = nil
		end
		f.inFight = on
	end)
	conns[#conns + 1] = player.CharacterRemoving:Connect(function(char)
		if f.char == char then
			releaseCharacter(f)
		end
	end)

	-- Phase 4: levels / stages of the equipped pets, the home portal
	conns[#conns + 1] = player:GetAttributeChangedSignal(P4.attr("EquippedInfo")):Connect(function()
		P4.readInfo(f)
		P4.refreshFollower(f)
	end)
	conns[#conns + 1] = player:GetAttributeChangedSignal(P4.attr("HomePortal")):Connect(function()
		P4.readPortal(f)
	end)
	conns[#conns + 1] = player:GetAttributeChangedSignal(P4.attr("PortalArrived")):Connect(function()
		f.arrivedAt = os.clock()
	end)

	f.downed = player:GetAttribute(ATTR.Downed) == true
	P4.readInfo(f)
	P4.readPortal(f)
	applyEquipped(f)
end

----------------------------------------------------------------------
-- Phase 4: levels, stages, pet cards, the evolution park and the portal dive (helpers live in P4)
----------------------------------------------------------------------
function P4.attr(name)
	return (type(ATTR) == "table" and ATTR[name]) or name
end

-- EquippedInfo "23:1,5:0" -> f.info[i] = { level, stage } (the order of EquippedPets)
function P4.readInfo(f)
	local text = f.player:GetAttribute(P4.attr("EquippedInfo"))
	if type(text) ~= "string" then
		text = ""
	end
	if text == f.infoText then
		return
	end
	f.infoText = text
	local info = {}
	local i = 0
	for token in string.gmatch(text, "[^,]+") do
		i = i + 1
		local lv, st = string.match(token, "^%s*(%d+)%s*:%s*(%d+)%s*$")
		if not lv then
			lv = string.match(token, "^%s*(%d+)%s*$")
		end
		info[i] = { math.max(1, math.floor(tonumber(lv) or 1)), clamp(math.floor(tonumber(st) or 0), 0, 2) }
	end
	f.info = info
end

-- HomePortal "x,y,z,yaw,closesAt" -> f.portal { x, y, z }; a portal that closes is remembered for the dive
function P4.readPortal(f)
	local text = f.player:GetAttribute(P4.attr("HomePortal"))
	local portal = nil
	if type(text) == "string" then
		local x, y, z = string.match(text, "^%s*([%-%d%.eE]+)%s*,%s*([%-%d%.eE]+)%s*,%s*([%-%d%.eE]+)")
		x, y, z = tonumber(x), tonumber(y), tonumber(z)
		if x and y and z and x == x and y == y and z == z then
			portal = { x, y, z }
		end
	end
	if not portal and f.portal then
		f.portalGone = f.portal
		f.portalGoneAt = os.clock()
	end
	f.portal = portal
end

-- the owner jumped > 35 studs: was it a trip through their home portal? (sets the dive centre)
function P4.portalJustUsed(f, now)
	local gone = f.portalGone
	if gone and (now - f.portalGoneAt <= P4K.DIVE_WINDOW or now - f.arrivedAt <= P4K.DIVE_WINDOW) then
		f.diveX, f.diveY, f.diveZ = gone[1], gone[2], gone[3]
		return true
	end
	local open = f.portal
	if open then
		local dx, dy, dz = f.ox - open[1], f.oy - open[2], f.oz - open[3]
		if dx * dx + dy * dy + dz * dz <= P4K.DIVE_NEAR * P4K.DIVE_NEAR then
			f.diveX, f.diveY, f.diveZ = open[1], open[2], open[3]
			return true
		end
	end
	return false
end

function P4.startDive(f, now)
	f.dive = true
	f.diveT0 = now
	f.diveY = f.diveY + 1.2 -- the swirl's centre stands above the ground point
	f.portalGone = nil
	for i = 1, f.n do
		local p = f.pets[i]
		p.diveStep = 0
		if p.model and p.rigid and p.root then
			-- everything follows the root now (the model is rebuilt when the dive ends)
			pcall(weldParts, p.model, p.root, true)
		end
	end
	P4.syncCards(f)
end

-- one frame of the dive: each pet flies into the portal centre (one root write) and shrinks in 3 steps
function P4.stepDive(f, dt, now, px, py, pz)
	f.ox, f.oy, f.oz = px, py, pz -- keep tracking the owner (no second teleport after the dive)
	local t = (now - f.diveT0) / P4K.DIVE_TIME
	if t >= 1 then
		P4.endDive(f)
		return
	end
	local remaining = math.max(0.02, (1 - t) * P4K.DIVE_TIME)
	local k = clamp(dt / remaining, 0, 1)
	local step = math.floor(t * 4)
	for i = 1, f.n do
		local p = f.pets[i]
		local model = p.model
		if model then
			local nx = p.x + (f.diveX - p.x) * k
			local ny = p.y + (f.diveY - p.y) * k
			local nz = p.z + (f.diveZ - p.z) * k
			p.x, p.y, p.z = nx, ny, nz
			local syw, cyw = sin(p.yaw), cos(p.yaw)
			local cf = CFrame.new(nx, ny, nz, cyw, 0, syw, 0, 1, 0, -syw, 0, cyw)
			local root = p.root
			if p.rigid and root and root.Parent == model then
				if p.pivotInv then
					root.CFrame = cf * p.pivotInv
				else
					root.CFrame = cf
				end
				movedRigid = movedRigid + 1
			else
				model:PivotTo(cf)
				movedPivot = movedPivot + 1
			end
			if step > p.diveStep then
				p.diveStep = step
				pcall(model.ScaleTo, model, math.max(0.15, 1 - 0.27 * step))
			end
		end
	end
end

-- the dive is over: fresh models pop out of the arrival ring behind the owner
function P4.endDive(f)
	f.dive = false
	f.vx, f.vy, f.vz = 0, 0, 0
	local root = f.root
	if root and root.Parent then
		local look = root.CFrame.LookVector
		if look.X * look.X + look.Z * look.Z > 0.04 then
			f.headYaw = atan2(-look.X, -look.Z)
		end
	end
	for i = 1, f.n do
		local p = f.pets[i]
		destroyPetModel(p)
		p.fresh = 2
		p.retryAt = 0
	end
end

-- the stored evolution stage of an own pet (State), never below a stage PlayEvolution announced while that stage is
-- fresh (the park + P4K.OVERRIDE_GRACE): an override State never confirmed is dropped then (State wins)
function P4.ownStage(p, level)
	local stored = 0
	if State and type(State.PetGrowth) == "function" then
		local ok, g = pcall(State.PetGrowth, p.key)
		if ok and type(g) == "table" then
			stored = tonumber(g.Evo) or 0
		end
	end
	local over = P4.overrides[p.key]
	if over then
		-- State caught up, or never did long after the animation (a /reset, a pet that came back fresh): State wins
		local untilAt = P4.overrideUntil[p.key]
		local stale = untilAt ~= nil and os.clock() > untilAt and P4.parks[p.key] == nil
		if stored >= over or stale then
			P4.overrides[p.key] = nil
			P4.overrideUntil[p.key] = nil
		else
			stored = over
		end
	end
	local ok, stage = pcall(PetCatalog.EvolutionStage, p.def, level, stored)
	if ok and type(stage) == "number" then
		return stage
	end
	return clamp(math.floor(stored), 0, 2)
end

-- level, stage, XP fill (0..1) and EVOLVE readiness of one pet
function P4.petInfo(f, p)
	local entry = f.info[p.infoIndex]
	local level, stage = entry and entry[1] or 1, entry and entry[2] or 0
	if not f.isLocal then
		local okMax, top = pcall(PetCatalog.MaxEvolution, p.def)
		if okMax and type(top) == "number" and stage > top then
			stage = top
		end
		return level, stage, 0, false
	end
	local xp = 0
	if State and type(State.IsLoaded) == "function" and State.IsLoaded() then
		local okL, lv, x = pcall(State.PetLevel, p.key)
		if okL and type(lv) == "number" then
			level, xp = lv, tonumber(x) or 0
		end
		stage = P4.ownStage(p, level)
	else
		local over = P4.overrides[p.key]
		if over and over > stage then
			stage = over
		end
	end
	local frac = 1
	local cap = nil
	local okCap, c = pcall(PetCatalog.LevelCap, p.def)
	if okCap and type(c) == "number" then
		cap = c
	end
	local need = nil
	if TycoonCatalog and type(TycoonCatalog.XpToNext) == "function" then
		local okN, n = pcall(TycoonCatalog.XpToNext, level)
		if okN and type(n) == "number" then
			need = n
		end
	end
	if not (cap and level >= cap) and need and need > 0 and need < math.huge then
		frac = clamp(xp / need, 0, 1)
	end
	local okR, nextStage = pcall(PetCatalog.CanEvolve, p.def, level, stage)
	return level, stage, frac, okR and nextStage ~= nil
end

-- the stage the model is built at: own pets always their stage, others' only when allowed (40 studs, 6 at most)
function P4.modelStage(f, p)
	if f.isLocal or p.evoOk then
		return p.want
	end
	return 0
end

-- re-reads levels / stages of a follower's pets: cards, and a rebuild when the model's stage is out of date
function P4.refreshFollower(f)
	local now = os.clock()
	for i = 1, f.n do
		local p = f.pets[i]
		local level, stage, frac, ready = P4.petInfo(f, p)
		p.level, p.want = level, stage
		if f.isLocal then
			local parked = P4.parks[p.key] ~= nil
			if parked and not p.parked then
				p.parked = true
				destroyPetModel(p)
			end
		end
		local card = p.card
		if card then
			pcall(card.SetLevel, card, level, stage, ready)
			if f.isLocal then
				pcall(card.SetXp, card, frac)
			end
		end
		if p.model and P4.modelStage(f, p) ~= p.stage then
			-- a stage that rose by itself waits a moment: PlayEvolution may park the pet for the animation first
			local wait = (f.isLocal and stage > p.stage) and P4K.EVO_GRACE or 0
			if not p.rebuildAt or p.rebuildAt > now + wait then
				p.rebuildAt = now + wait
			end
		elseif p.rebuildAt and p.model then
			p.rebuildAt = nil
		end
	end
end

function P4.openPets(key)
	if not P4.menu then
		P4.menu = optionalModule(script.Parent, "MenuController")
	end
	local MC = P4.menu
	if MC and type(MC.Open) == "function" then
		local ok, err = pcall(MC.Open, "Pets", { Tab = "Pets", Key = key, Action = "Evolve" })
		if not ok then
			warnLimited("menu_open", "could not open the Pets panel: " .. tostring(err))
		end
	end
end

-- shows / hides one pet card with its follower (parked, diving, culled, in battle)
function P4.syncCard(f, p)
	local card = p.card
	if card then
		pcall(card.SetShown, card, f.visible and not f.dive and not p.parked and p.model ~= nil)
	end
end

function P4.syncCards(f)
	for i = 1, f.n do
		P4.syncCard(f, f.pets[i])
	end
end

-- creates (or re-adorns) the card of a pet whose model exists
function P4.ensureCard(f, p)
	local adornee = p.root or (p.model and p.model.PrimaryPart)
	if not PetCard or not p.model or not adornee then
		return
	end
	local height = p.height * 0.5 + P4K.CARD_HEIGHT
	if p.card then
		pcall(p.card.SetAdornee, p.card, adornee, height)
	else
		local key = p.key
		local ok, card = pcall(PetCard.New, adornee, f.isLocal and "Follower" or "Other", height, {
			OnEvolve = function()
				P4.openPets(key)
			end,
		})
		if not ok or type(card) ~= "table" then
			warnLimited("card_" .. tostring(key), "could not build a pet card: " .. tostring(card))
			return
		end
		p.card = card
	end
	local level, stage, frac, ready = P4.petInfo(f, p)
	pcall(p.card.SetLevel, p.card, level, stage, ready)
	if f.isLocal then
		pcall(p.card.SetXp, p.card, frac)
	end
	P4.syncCard(f, p)
end

local function byDist(a, b)
	return a.dist < b.dist
end

-- 2 Hz: other players' cards (nearest 12 within 60 studs) and evolved models (nearest 6 within 40 studs)
function P4.globalTick(now, viewPos)
	if now < P4.nextGlobal then
		return
	end
	P4.nextGlobal = now + P4K.GLOBAL_TICK
	local list = {}
	for i = 1, followerCount do
		local f = order[i]
		if f and not f.isLocal then
			local root = f.root
			if f.visible and root and root.Parent and viewPos then
				local d = root.Position - viewPos
				f.dist = d.Magnitude
				list[#list + 1] = f
			else
				f.dist = math.huge
				for j = 1, f.n do
					local p = f.pets[j]
					p.evoOk = false
					p.cardOk = false
					if p.card then
						pcall(p.card.Destroy, p.card)
						p.card = nil
					end
				end
			end
		end
	end
	table.sort(list, byDist)
	local cards, evos = 0, 0
	for i = 1, #list do
		local f = list[i]
		for j = 1, f.n do
			local p = f.pets[j]
			-- evolved look: nearest first, at most 6, a shown one keeps it a little further out
			local ok = false
			if p.want > 0 and evos < P4K.OTHER_EVO_MAX then
				local reach = (p.stage > 0) and P4K.OTHER_EVO_OUT or P4K.OTHER_EVO_IN
				if f.dist <= reach then
					ok = true
					evos = evos + 1
				end
			end
			p.evoOk = ok
			if p.model and P4.modelStage(f, p) ~= p.stage and not p.rebuildAt then
				p.rebuildAt = now
			end
			-- the level card: nearest first, at most 12
			if not f.dive and cards < P4K.OTHER_CARDS and f.dist <= P4K.OTHER_CARD_DIST then
				cards = cards + 1
				p.cardOk = true
				if p.model and not p.card then
					P4.ensureCard(f, p)
				end
			else
				p.cardOk = false
				if p.card then
					pcall(p.card.Destroy, p.card)
					p.card = nil
				end
			end
		end
	end
end

-- per follower, a few times a second: parks that ran out
function P4.slowFollower(f, now)
	if not f.isLocal then
		return
	end
	for i = 1, f.n do
		local p = f.pets[i]
		if p.parked then
			local park = P4.parks[p.key]
			if not park or now >= park.Until then
				P4.parks[p.key] = nil
				P4.unparkKey(p.key, park and park.From or nil)
			end
		end
	end
end

function P4.unparkKey(key, from)
	local f = localFollower
	if not f then
		return
	end
	for i = 1, f.n do
		local p = f.pets[i]
		if p.key == key and p.parked then
			p.parked = false
			p.fresh = 2
			p.emergeFrom = from
			p.retryAt = 0
			p.rebuildAt = nil
		end
	end
	P4.refreshFollower(f)
end

-- seconds the evolution animation lasts (EvolutionFx.Duration), else a safe default
function P4.fxDuration(stage)
	local Fx = optionalModule(script.Parent, "EvolutionFx")
	if Fx and type(Fx.Duration) == "function" then
		local ok, d = pcall(Fx.Duration, stage)
		if ok and type(d) == "number" and d > 0 and d < 30 then
			return d + 0.3
		end
	end
	return P4K.PARK_DEFAULT
end

function P4.onStateChanged()
	if localFollower then
		P4.refreshFollower(localFollower)
	end
end

----------------------------------------------------------------------
-- Wave 5 (bug #26): the dungeon hand-over
----------------------------------------------------------------------
-- a dungeon run id ("D12"), not a battle id ("B7"; BattleService.Enc.isRunId)
function P4.isRunId(v)
	return type(v) == "string" and v:sub(1, 1) == "D"
end

-- true = the follower is parked now: InBattle set, unless it is a dungeon run id with no fight on (InFight) and no
-- hand-over running; the hand-over's end shows the follower again (P4.emerge)
function P4.parkWanted(f)
	local inBattle = f.player:GetAttribute("InBattle")
	if inBattle ~= nil and (f.player:GetAttribute(ATTR_IN_FIGHT) == true or not P4.isRunId(inBattle)) then
		return true
	end
	if f.handoverUntil then
		local now = os.clock()
		if now < f.handoverUntil or (now < (f.handoverCap or 0) and P4.fighterDrawn(f)) then
			return true
		end
		f.handoverUntil = nil
		f.handoverCap = nil
		if not f.visible then
			setVisible(f, true)
			P4.emerge(f)
		end
	end
	return false
end

-- BattleController still draws this player's dungeon fighter (a lost room's KO'd models linger)
function P4.fighterDrawn(f)
	if P4.BC == nil then
		P4.BC = optionalModule(script.Parent, "BattleController") or false
	end
	local BC = P4.BC
	if not BC or type(BC.FighterDrawn) ~= "function" then
		return false
	end
	local ok, drawn = pcall(BC.FighterDrawn, f.userId)
	return ok and drawn == true
end

-- the followers reappear after a dungeon fight: the fighter pet starts where BattleController last drew it
function P4.emerge(f)
	if P4.BC == nil then
		P4.BC = optionalModule(script.Parent, "BattleController") or false
	end
	local BC = P4.BC
	if not BC or type(BC.LastDrawn) ~= "function" then
		return
	end
	local ok, pos, key = pcall(BC.LastDrawn, f.userId)
	if not ok or typeof(pos) ~= "Vector3" then
		return
	end
	local target = nil
	for i = 1, f.n do
		local p = f.pets[i]
		if key ~= nil and p.key == key then
			target = p
			break
		end
	end
	target = target or f.pets[1]
	if target then
		target.emergeFrom = pos
	end
end

----------------------------------------------------------------------
-- Per-frame update
----------------------------------------------------------------------
-- Advances one follower by dt seconds. `viewPos` is where the viewer is (Vector3 or nil).
----------------------------------------------------------------------
-- bug batch 2 #7: settle while the owner sits (SIT)
----------------------------------------------------------------------
-- the owner sits on any seat (Humanoid.Sit, or a SeatPart: both replicate)
function SIT.isSitting(f)
	local hum = f.hum
	if not hum or hum.Parent ~= f.char then
		hum = f.char and f.char:FindFirstChildOfClass("Humanoid") or nil
		f.hum = hum
	end
	return hum ~= nil and (hum.Sit == true or hum.SeatPart ~= nil)
end

-- lays the row out across the owner's front (once per sit, again when the owner moved REPLAN studs): every pet gets
-- its lateral offset; its ground spot is found on its next update (SIT.place)
function SIT.plan(f, root, px, py, pz)
	local look = root.CFrame.LookVector
	local lx, lz = look.X, look.Z
	local m = sqrt(lx * lx + lz * lz)
	if m < 1e-3 then
		lx, lz, m = -sin(f.headYaw), -cos(f.headYaw), 1
	end
	f.sitFx, f.sitFz = lx / m, lz / m
	f.sitPx, f.sitPy, f.sitPz = px, py, pz
	local n = f.n
	local total = SIT.GAP * math.max(0, n - 1)
	for i = 1, n do
		total = total + 2 * f.pets[i].r
	end
	local cursor = -total / 2
	for i = 1, n do
		local p = f.pets[i]
		p.sitLat = cursor + p.r
		cursor = cursor + 2 * p.r + SIT.GAP
		p.sitModel = nil
	end
	f.sitPlanned = true
end

-- the lowest point of `model` below its pivot once it lies rolled SIT.LIE_ANGLE about its forward axis (HomeFx's
-- LieLo, with every part's own rotation): the corners' y after Rz(LIE_ANGLE) is x sin + y cos. The body only: the
-- wing / tail parts that Animate moves are left out (the body rests on the ground, the lower wing folds into it)
function SIT.lieLow(model)
	local okPivot, pivot = pcall(model.GetPivot, model)
	if not okPivot then
		return -1
	end
	local inv = pivot:Inverse()
	local ls, lc = sin(SIT.LIE_ANGLE), cos(SIT.LIE_ANGLE)
	local lo = nil
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency < 1 and not isAnimatedPart(part) then
			local rel = inv * part.CFrame
			local c, s = rel.Position, part.Size
			local ax, ay, az = rel.RightVector, rel.UpVector, rel.LookVector
			local y = c.X * ls + c.Y * lc - (abs(ax.X * ls + ax.Y * lc) * s.X + abs(ay.X * ls + ay.Y * lc) * s.Y + abs(az.X * ls + az.Y * lc) * s.Z) / 2
			if not lo or y < lo then
				lo = y
			end
		end
	end
	return lo or -1
end

-- the pet's spot in the row: the ground under it (a ray, the owner and every pet excluded) and the lying height
function SIT.place(f, p, model)
	local fx, fz = f.sitFx, f.sitFz
	local ahead = SIT.AHEAD + p.r
	local lat = p.sitLat or 0
	local x = f.sitPx + fx * ahead - fz * lat -- the owner's right = (-fz, fx)
	local z = f.sitPz + fz * ahead + fx * lat
	local ground = f.sitPy - SIT.FALLBACK_DROP
	local params = SIT.params
	if not params then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.RespectCanCollide = true
		SIT.params = params
	end
	params.FilterDescendantsInstances = { f.char, petsFolder }
	local ok, hit = pcall(workspace.Raycast, workspace, Vector3.new(x, f.sitPy + 1, z), Vector3.new(0, -SIT.DROP, 0), params)
	if ok and hit then
		ground = hit.Position.Y
	end
	if p.lieModel ~= model then
		p.lieLo = SIT.lieLow(model)
		p.lieModel = model
	end
	p.sitX, p.sitY, p.sitZ = x, ground - p.lieLo + 0.05, z
	p.sitYaw = atan2(fx, fz) -- forward (-sin, -cos) = towards the owner
	p.sitModel = model
end

local function stepFollower(f, dt, now, viewPos)
	-- 1. owner root ------------------------------------------------------------------------------
	local root = f.root
	if root and not root.Parent then
		releaseCharacter(f)
		root = nil
	end
	if not root then
		if now >= f.nextRootCheck then
			f.nextRootCheck = now + ROOT_POLL
			acquireRoot(f)
			root = f.root
		end
		if not root then
			return
		end
	end

	-- 2. housekeeping a few times per second ---------------------------------------------------
	if now >= f.nextSlow then
		f.nextSlow = now + SLOW_TICK + (f.index % 5) * 0.02
		if f.player.Character ~= f.char then
			releaseCharacter(f) -- the character was replaced; the next poll picks up the new one
			return
		end
		if f.visible and f.folder.Parent ~= petsFolder then
			f.folder.Parent = ensurePetsFolder()
		end
		P4.slowFollower(f, now)
	end

	local rootPos = root.Position
	local px, py, pz = rootPos.X, rootPos.Y, rootPos.Z
	if px ~= px or py ~= py or pz ~= pz then
		return -- a broken (NaN) character position: wait for it to recover instead of poisoning the pets
	end

	-- 2b. Phase 4: the home portal dive (played out wherever the owner went, before any culling) ----------------
	if not f.dive and f.visible and f.established then
		local jx, jy, jz = px - f.ox, py - f.oy, pz - f.oz
		if jx * jx + jy * jy + jz * jz > TELEPORT_STEP2 and P4.portalJustUsed(f, now) then
			P4.startDive(f, now)
		end
	end
	if f.dive then
		P4.stepDive(f, dt, now, px, py, pz)
		return
	end

	-- 3. culling + level of detail -------------------------------------------------------------
	-- Phase 3: the team fights (BattleController draws it): park the followers. Wave 5 (bug #26): a dungeon run id
	-- parks only during a room's fight (InFight) and the hand-over after it (P4.parkWanted)
	if P4.parkWanted(f) then
		setVisible(f, false)
		return
	end
	if f.isLocal then
		if not f.visible then
			setVisible(f, true)
		end
	else
		local dist = 0
		if viewPos then
			local cx, cy, cz = px - viewPos.X, py - viewPos.Y, pz - viewPos.Z
			dist = sqrt(cx * cx + cy * cy + cz * cz)
		end
		if f.visible then
			if dist > CULL_OUT then
				setVisible(f, false)
				return
			end
		else
			if dist > CULL_IN then
				return
			end
			setVisible(f, true)
		end
		local stride = 1
		if dist > LOD_FAR then
			stride = 4
		elseif dist > LOD_MID then
			stride = 2
		end
		f.accDt = f.accDt + dt
		if stride > 1 and (frameIndex + f.index) % stride ~= 0 then
			return
		end
		dt = f.accDt
		f.accDt = 0
		if dt > MAX_DT then
			dt = MAX_DT
		end
	end
	if dt < MIN_DT then
		dt = MIN_DT
	end

	-- 4. owner motion estimate ---------------------------------------------------------------------
	local dx, dy, dz = px - f.ox, py - f.oy, pz - f.oz
	f.ox, f.oy, f.oz = px, py, pz
	local teleported = f.resetPending
	f.resetPending = false
	if dx * dx + dy * dy + dz * dz > TELEPORT_STEP2 then
		teleported = true
	end
	if teleported then
		f.vx, f.vy, f.vz = 0, 0, 0
		snapAllPets(f)
	else
		local kv = 1 - exp(-VEL_RATE * dt)
		f.vx = f.vx + (clamp(dx / dt, -MAX_SPEED, MAX_SPEED) - f.vx) * kv
		f.vy = f.vy + (clamp(dy / dt, -MAX_SPEED, MAX_SPEED) - f.vy) * kv
		f.vz = f.vz + (clamp(dz / dt, -MAX_SPEED, MAX_SPEED) - f.vz) * kv
	end
	local vx, vz = f.vx, f.vz
	local hs = sqrt(vx * vx + vz * vz)

	-- formation heading: travel direction, or the owner's facing when standing still
	local targetHead = f.headYaw
	local headRate = HEAD_RATE_IDLE
	if hs > HEAD_MIN_SPEED then
		targetHead = atan2(-vx, -vz)
		headRate = HEAD_RATE_MOVE
	else
		local look = root.CFrame.LookVector
		if look.X * look.X + look.Z * look.Z > 0.04 then
			targetHead = atan2(-look.X, -look.Z)
		end
	end
	if teleported then
		f.headYaw = targetHead
	else
		f.headYaw = wrapAngle(f.headYaw + wrapAngle(targetHead - f.headYaw) * (1 - exp(-headRate * dt)))
	end

	local runTarget = clamp((hs - RUN_K_FROM) / RUN_K_SPAN, 0, 1.3)
	f.runK = f.runK + (runTarget - f.runK) * (1 - exp(-RUN_RATE * dt))
	local airTarget = clamp((abs(f.vy) - 8) / 30, 0, 1)
	f.airK = f.airK + (airTarget - f.airK) * (1 - exp(-AIR_RATE * dt))
	local downTarget = 0
	if f.downed then
		downTarget = 1
	end
	f.downK = f.downK + (downTarget - f.downK) * (1 - exp(-DOWN_RATE * dt))

	local runK, airK, downK = f.runK, f.airK, f.downK
	-- Excited does most of the speeding up (and also widens the wing sweep and wags the tail); Flap only adds a
	-- little on top, and is capped so FLAP_HZ * Flap * (1 + 1.25 * Excited) stays below MAX_BEAT_HZ.
	local flapBase = 1 + 0.2 * runK + 0.25 * airK
	local excited = clamp(0.55 * runK + 0.75 * airK, 0, 1)
	if downK > 0 then
		flapBase = flapBase * (1 - 0.4 * downK)
		excited = excited * (1 - downK)
	end
	local flapCap = MAX_BEAT_HZ / (PB_FLAP_HZ * (1 + 1.25 * excited) * FLAP_VAR_MAX)
	if flapBase > flapCap then
		flapBase = flapCap
	end
	local compact = 1 - 0.45 * downK -- downed owners keep their pets close
	local leadX, leadZ = vx * LEAD_H, vz * LEAD_H
	local leadY = clamp(f.vy * LEAD_V, -1, 1.5)

	local face = f.headYaw
	local sh, ch = sin(face), cos(face)
	local rx, rz = ch, -sh -- owner's right (horizontal)
	local fx, fz = -sh, -ch -- owner's forward (horizontal)

	-- 4b. bug batch 2 #7: the owner sits -> the pets settle on the ground in front of them (SIT)
	local sitting = SIT.isSitting(f)
	if sitting then
		local mx, my, mz = px - f.sitPx, py - f.sitPy, pz - f.sitPz
		if not f.sitPlanned or mx * mx + my * my + mz * mz > SIT.REPLAN * SIT.REPLAN then
			SIT.plan(f, root, px, py, pz)
		end
		f.sitUntil = now + SIT.EASE_OUT
	elseif f.sitPlanned then
		f.sitPlanned = false
	end
	local settling = now < f.sitUntil

	-- 5. pets: (a) build + the filter toward the slot, (b) the separation, (c) facing + the pose write --------
	local pets = f.pets
	local n = f.n
	for i = 1, n do
		local p = pets[i]
		local model = p.model
		p.live = false
		-- Phase 6 (runtime-pets): a Part-built pet whose Blender mesh keys became usable here is rebuilt as a mesh pet
		if model and p.meshVer ~= meshVerNow then
			p.meshVer = meshVerNow
			if not p.rebuildAt and PetBuilder.NeedsMeshRebuild and PetBuilder.NeedsMeshRebuild(model) then
				p.rebuildAt = now
			end
		end
		-- review3 runtime-4: the old model goes only when this frame still has a build slot for its replacement (the same
		-- gate as the build below), so a MeshVersion change that marks every pet in the lobby keeps each one on screen
		-- until its turn comes (no lobby-wide blink; at most BUILD_MAX swaps per frame, built in the same frame)
		if p.rebuildAt and now >= p.rebuildAt and not p.parked and now >= p.retryAt and buildsThisFrame < BUILD_MAX
			and (buildsThisFrame == 0 or os.clock() - buildStart < BUILD_BUDGET) then
			-- Phase 4: the stage changed (EVOLVE, EquippedInfo, the 40-stud rule): rebuild where the pet is
			p.rebuildAt = nil
			destroyPetModel(p)
			model = nil
		end
		if not model and not p.parked and now >= p.retryAt and buildsThisFrame < BUILD_MAX
			and (buildsThisFrame == 0 or os.clock() - buildStart < BUILD_BUDGET) then
			if buildsThisFrame == 0 then
				buildStart = os.clock()
			end
			buildsThisFrame = buildsThisFrame + 1
			buildModel(f, p)
			model = p.model
		end
		if model then
			-- target position in the owner's frame
			local bob = sin(now * p.bobRate + p.phase) * p.bobAmp * (1 - 0.5 * downK)
			local sway = sin(now * p.swayRate + p.phase2) * p.swayAmp
			local side = p.side * compact + sway
			local fwd = -p.back * compact
			local tx = px + rx * side + fx * fwd + leadX
			local tz = pz + rz * side + fz * fwd + leadZ
			local ty = py + p.up * (1 - 0.2 * downK) + p.lift + bob + 1.2 * RUN_RISE * runK + leadY
			if sitting then
				if p.sitModel ~= model then
					SIT.place(f, p, model)
				end
				tx, ty, tz = p.sitX, p.sitY, p.sitZ
			end

			if p.fresh ~= 0 then
				local from = p.emergeFrom
				if from then
					p.x, p.y, p.z = from.X, from.Y, from.Z -- Phase 4: where the evolved clone stood
					p.emergeFrom = nil
				elseif p.fresh == 2 then
					p.x, p.y, p.z = px, py + 0.5, pz -- emerge from the owner's chest (also out of the arrival ring)
				else
					p.x, p.y, p.z = tx, ty, tz
				end
				p.yaw = face
				p.pitch, p.roll = 0, 0
				p.fresh = 0
			end

			local ox, oy, oz = p.x, p.y, p.z
			local ex, ey, ez = tx - ox, ty - oy, tz - oz
			if ex * ex + ey * ey + ez * ez > SNAP_DIST2 then
				ox, oy, oz = tx, ty, tz
				ex, ey, ez = 0, 0, 0
				p.yaw = face
			end
			local kh = 1 - exp(-p.rateH * dt)
			local kvv = 1 - exp(-(settling and SIT.RATE_V or p.rateV) * dt)
			if settling then
				-- bug batch 2 #7: glide to / from the ground spot instead of zooming across (the filter alone starts at
				-- ~80 studs/s over the ~16 studs from a back slot to the front row)
				local cap = (SIT.MAX_SPEED + hs) * dt
				local mh = sqrt(ex * ex + ez * ez) * kh
				if mh > cap then
					kh = kh * cap / mh
				end
			end
			p.x, p.y, p.z = ox + ex * kh, oy + ey * kvv, oz + ez * kh
			p.lastX, p.lastZ = ox, oz
			p.live = true
		end
	end

	-- (b) Phase 5 separation (contract 3.8): 2 passes over the pets of this owner (n <= 3, so <= 3 pairs); two
	-- overlapping circles (centre distance < ra + rb + gap) are pushed apart half each, then a pet inside the
	-- owner's circle (OwnerRadius + r + gap) is put on it. Horizontal only; no tables, no allocations.
	local gap = F5.SEP_GAP
	for _ = 1, 2 do
		for i = 1, n - 1 do
			local a = pets[i]
			if a.live then
				for j = i + 1, n do
					local b = pets[j]
					if b.live then
						local ddx, ddz = b.x - a.x, b.z - a.z
						local d = sqrt(ddx * ddx + ddz * ddz)
						local need = a.r + b.r + gap
						if d < need then
							local ux, uz
							if d > 1e-4 then
								ux, uz = ddx / d, ddz / d
							else
								ux, uz = rx, rz -- exactly on top of each other: apart along the owner's right
							end
							local push = (need - d) / 2
							a.x, a.z = a.x - ux * push, a.z - uz * push
							b.x, b.z = b.x + ux * push, b.z + uz * push
						end
					end
				end
			end
		end
		for i = 1, n do
			local q = pets[i]
			if q.live then
				local ddx, ddz = q.x - px, q.z - pz
				local d = sqrt(ddx * ddx + ddz * ddz)
				local need = F5.OWNER_R + q.r + gap
				if d < need then
					if d > 1e-4 then
						q.x, q.z = px + ddx / d * need, pz + ddz / d * need
					else
						q.x, q.z = px - fx * need, pz - fz * need -- on the owner: straight behind
					end
				end
			end
		end
	end

	-- (c) facing, banking, pitch and the one pose write per pet
	for i = 1, n do
		local p = pets[i]
		local model = p.model
		if p.live and model then
			local nx, ny, nz = p.x, p.y, p.z
			local pvx, pvz = (nx - p.lastX) / dt, (nz - p.lastZ) / dt

			local yawOld = p.yaw
			local wobble = 0.1 * sin(now * 0.9 + p.phase2)
			local aim = face + p.yawBias + wobble
			if sitting and p.sitModel == model then
				aim = p.sitYaw + p.yawBias -- lying in front of the owner, looking at them
			end
			local yawStep = wrapAngle(aim - yawOld) * (1 - exp(-FACE_RATE * dt))
			local yaw = wrapAngle(yawOld + yawStep)
			p.yaw = yaw
			local syw, cyw = sin(yaw), cos(yaw)
			local forwardSpeed = -pvx * syw - pvz * cyw
			local lateralSpeed = pvx * cyw - pvz * syw
			local pitchT = -clamp(forwardSpeed * PITCH_GAIN, -0.28, 0.42)
			local rollT = clamp(yawStep / dt * BANK_GAIN, -BANK_MAX, BANK_MAX)
				- clamp(lateralSpeed * 0.015, -0.3, 0.3)
				+ 0.05 * sin(now * 1.3 + p.phase)
			if sitting then
				pitchT, rollT = 0, SIT.LIE_ANGLE -- HomeFx's nap pose: rolled onto the side
			end
			local kt = 1 - exp(-(settling and SIT.TILT_RATE or TILT_RATE) * dt)
			local pitch = p.pitch + (pitchT - p.pitch) * kt
			local roll = p.roll + (rollT - p.roll) * kt
			p.pitch, p.roll = pitch, roll

			if nx == nx and ny == ny and nz == nz and pitch == pitch and roll == roll and yaw == yaw then
				-- rotation = Ry(yaw) * Rx(pitch) * Rz(roll), written out so only one CFrame is created
				local spt, cpt = sin(pitch), cos(pitch)
				local srl, crl = sin(roll), cos(roll)
				local cf = CFrame.new(
					nx, ny, nz,
					cyw * crl + syw * spt * srl, -cyw * srl + syw * spt * crl, syw * cpt,
					cpt * srl, cpt * crl, -spt,
					-syw * crl + cyw * spt * srl, syw * srl + cyw * spt * crl, cyw * cpt
				)
				local root = p.root
				if p.rigid and root and root.Parent == model then
					-- one write: the welded static parts follow the anchored root
					if p.pivotInv then
						root.CFrame = cf * p.pivotInv
					else
						root.CFrame = cf
					end
					movedRigid = movedRigid + 1
				else
					model:PivotTo(cf)
					movedPivot = movedPivot + 1
				end

				if p.animFails < 3 then
					local o = p.opts
					o.Flap = sitting and SIT.ANIM_FLAP or flapBase * p.flapVar
					o.Excited = sitting and 0 or excited
					local okAnim = pcall(PetBuilder.Animate, model, now, o)
					if not okAnim then
						p.animFails = p.animFails + 1
						if p.animFails >= 3 then
							freezeAnimatedParts(p)
						end
					end
				end
			else
				-- numerical accident: restart this pet's motion from its slot on the next update
				p.fresh = 1
			end
		end
	end
	f.established = true
end

local function onRender(dt)
	local count = followerCount
	if count == 0 then
		return
	end
	frameIndex = frameIndex + 1
	buildsThisFrame = 0
	meshVerNow = PetBuilder.MeshVersion and PetBuilder.MeshVersion() or 0
	lastRigid, lastPivot = movedRigid, movedPivot
	movedRigid, movedPivot = 0, 0
	if dt > MAX_DT then
		dt = MAX_DT
	end
	local now = os.clock()
	if now >= nextFolderCheck then
		nextFolderCheck = now + 2
		ensurePetsFolder()
	end
	-- the viewer: the local character, else the camera
	local viewPos = nil
	local lf = localFollower
	if lf and lf.root and lf.root.Parent then
		viewPos = lf.root.Position
	else
		local camera = workspace.CurrentCamera
		if camera then
			viewPos = camera.CFrame.Position
		end
	end
	local okTick, errTick = pcall(P4.globalTick, now, viewPos)
	if not okTick then
		warnLimited("global_tick", "card / model selection failed: " .. tostring(errTick))
	end
	for i = 1, count do
		local f = order[i]
		if f and not f.disabled then
			local ok, err = pcall(stepFollower, f, dt, now, viewPos)
			if ok then
				f.failures = 0
			else
				f.failures = f.failures + 1
				warnLimited("step_" .. tostring(f.userId), "update failed: " .. tostring(err))
				if f.failures >= 10 then
					-- give up on this owner's pets rather than erroring every frame
					f.disabled = true
					releaseCharacter(f)
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- the formation slots for pets of these widths (pure; contract 3.8; see formationFor)
function PetController.FormationFor(widths)
	return formationFor(widths)
end

function PetController.GetPetCount()
	local total = 0
	for i = 1, followerCount do
		local f = order[i]
		for j = 1, f.n do
			if f.pets[j].model then
				total = total + 1
			end
		end
	end
	return total
end

-- Pets posed in the last finished frame: Rigid = one root CFrame write (welded statics), Pivot = PivotTo fallback.
function PetController.GetMoveStats()
	return { Rigid = lastRigid, Pivot = lastPivot }
end

-- Phase 4 (contract 3.6): parks the local follower of `key` while the evolution plays elsewhere, then rebuilds it
-- at `stage`. Returns release(fromPosition?) to end the park early (CareController calls it from EvolutionFx's
-- OnDone with the evolved clone's position).
function PetController.PlayEvolution(key, stage, opts)
	if type(key) ~= "string" or key == "" then
		return function() end
	end
	stage = clamp(math.floor(tonumber(stage) or 1), 1, 2)
	local seconds, from = nil, nil
	if type(opts) == "number" then
		seconds = opts
	elseif type(opts) == "table" then
		seconds = tonumber(opts.Seconds)
		if typeof(opts.From) == "Vector3" then
			from = opts.From
		end
	end
	if not seconds or seconds ~= seconds or seconds < 0 then
		seconds = P4.fxDuration(stage)
	end
	seconds = math.min(seconds, 30)
	P4.overrides[key] = math.max(P4.overrides[key] or 0, stage)
	P4.overrideUntil[key] = os.clock() + seconds + P4K.OVERRIDE_GRACE
	local park = { Until = os.clock() + seconds, From = from }
	P4.parks[key] = park
	if localFollower then
		P4.refreshFollower(localFollower)
	end
	local released = false
	return function(fromPosition)
		if released then
			return
		end
		released = true
		if P4.parks[key] == park then
			P4.parks[key] = nil
			P4.unparkKey(key, typeof(fromPosition) == "Vector3" and fromPosition or from)
		end
	end
end

-- debug helpers (smoke tests): every live pet card, and one owner's followers
function PetController.GetCards()
	local out = {}
	for i = 1, followerCount do
		local f = order[i]
		for j = 1, f.n do
			local p = f.pets[j]
			local card = p.card
			if card and card.Gui then
				out[#out + 1] = { UserId = f.userId, Key = p.key, Mode = card.mode, Gui = card.Gui, Shown = card.Gui.Enabled == true }
			end
		end
	end
	return out
end

function PetController.GetFollowerInfo(player)
	local f = followers[player]
	local out = {}
	if not f then
		return out
	end
	for i = 1, f.n do
		local p = f.pets[i]
		out[i] = {
			Key = p.key, Model = p.model, Stage = p.stage, Want = p.want, Level = p.level,
			Card = p.card and p.card.Gui or nil, Parked = p.parked, Diving = f.dive, Back = p.back,
			Side = p.side, Width = p.width, Slot = p.slot,
			Sitting = f.sitPlanned and p.model ~= nil and p.sitModel == p.model,
		}
	end
	return out
end

function PetController.Stop()
	if not initialized then
		return
	end
	initialized = false
	if renderConn then
		renderConn:Disconnect()
		renderConn = nil
	end
	for i = 1, #playerConns do
		playerConns[i]:Disconnect()
	end
	playerConns = {}
	if P4.stateConn then
		pcall(function()
			P4.stateConn:Disconnect()
		end)
		P4.stateConn = nil
	end
	P4.parks = {}
	P4.overrides = {}
	P4.overrideUntil = {}
	local list = {}
	for player in pairs(followers) do
		list[#list + 1] = player
	end
	for i = 1, #list do
		removeFollower(list[i])
	end
	if petsFolder then
		pcall(petsFolder.Destroy, petsFolder)
		petsFolder = nil
	end
end

function PetController.Init()
	if initialized then
		return
	end
	if not LocalPlayer then
		return
	end
	initialized = true

	-- a folder left over from an earlier run (hot reload) would hold orphaned models
	local old = workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	petsFolder = nil
	ensurePetsFolder()

	playerConns[#playerConns + 1] = Players.PlayerAdded:Connect(trackPlayer)
	playerConns[#playerConns + 1] = Players.PlayerRemoving:Connect(removeFollower)
	for _, player in ipairs(Players:GetPlayers()) do
		trackPlayer(player)
	end

	-- Phase 4: own pets' levels / XP / stages follow the profile snapshot
	if State and type(State.Changed) == "table" and type(State.Changed.Connect) == "function" then
		local ok, conn = pcall(function()
			return State.Changed:Connect(function()
				local okR, err = pcall(P4.onStateChanged)
				if not okR then
					warnLimited("state_changed", "pet card refresh failed: " .. tostring(err))
				end
			end)
		end)
		if ok then
			P4.stateConn = conn
		end
	end

	renderConn = RunService.RenderStepped:Connect(onRender)
end

return PetController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1156">
            <Properties>
              <string name="Name">PetsController</string>
              <string name="Source"><![CDATA[-- PetsController (client, team balance, spec s.3): the Pets window. One big window with no tabs and the team's 3 slots always
-- in view; it replaces the Pets and Team tabs of MenuController's old Window_Inventory.
--
--   PetsController.Init()
--   PetsController.Open(args)     args = { Key = string | nil (select this pet), Pick = 1..3 | nil (open in pick mode on that
--                                 slot), Preset = 1..3 | nil (show that team), ReturnTo = table | nil (handed back on close),
--                                 Action = "Evolve" | nil (with Key: the floating card's EVOLVE! pill, the confirm on top) }
--   PetsController.Close(silent)  closes the window; silent = true when something else takes over: ReturnTo is dropped
--   PetsController.IsOpen() -> bool
--   PetsController.SetSort("Strongest" | "Rarest" | "Level"), PetsController.Sort() -> mode
--   PetsController.Layout() -> "PC" | "Phone"
--   PetsController.ReturnArgs()   Open args that bring this window back as it is when a panel waits behind it, else nil (an
--                                 Evolve's cinematic closes the window silently: CareController opens it again after it)
--   PetsController.Opened         Util.Signal, Fire() per opening
--   PetsController.Closed         Util.Signal, Fire(returnTo | nil). ReturnTo (where a close that is not silent goes back to):
--                                 { Window = "Ring", Start, Portal } -> ArenaController.OpenRing(Start, Portal), { Window = "Dungeon", Floor,
--                                 Portal } -> DungeonController.Open(Floor, Portal), { Window = "Arena", Tab } -> ArenaController.OpenArena(Tab),
--                                 { Window = "Loss" } -> LossScreen.Reopen()
-- MenuController.Open("Pets" | "Team" | "Inventory", args), OpenTeam(preset) and the Pets tile come here; an opening fires
-- MenuController.WindowOpened("Pets") (the tutorial's Equipped hook; the other windows close on it), MenuController.Close()
-- closes this one silently.
--
-- Screen: ScreenGui "NimbusPets" (DisplayOrder 19, just under NimbusMenu's 20: MenuController's side hint, the toast of a
-- refused action, shows over the window; IgnoreGuiInset = true), Frame "PetsWindow" (a CloudUI.Panel, kit-b U8: the Signboard
-- skin with the paw on its header; every block is a kit B block: flat face, wood edge, darker lip, no glow). Sizes in screen px: a
-- 1920x1080 screen 1260x900 centred, a phone 844x390 820x330 under Roblox's top bar, others between (K.RECT). The layout is
-- "Phone" when the window is under K.PHONE_W x K.SHORT design px: there the design is in screen px (scale 1, texts >= 15).
--   PC: Slot1..3 (Face, Tag FIGHTER | HELPER, PetName, Level, Power, Busy, Glow, Empty), TeamPower, TeamBreakdown, AutoFill, ClearTeam
--       ("Tap again to clear" for 3 s), PresetA..C (attribute Selected on the active team, Shown on the team shown), Undo (6 s
--       after AutoFill); a GridWell with SortButton, PickBanner + PickCancel and Grid (the ONLY ScrollingFrame) of Card_<key>
--       (Picture, Level, Element, Power, Number, Busy, Tier, Stars, Count, Name; kit-b U8: the rarity is the card's Lip, in the
--       rarity's colour, with attribute Rarity; Element is a CloudUI.ElementChip, its drawn icon); Detail: the selected pet (Name,
--       Meta, XpBar, Row_Income | Power | Health | Speed with Label + Value, Work, Perks, ActPut | ActFighter + ActRemove, ActFeed,
--       ActTrain, ActGarden, ActEvolve).
--   Phone: the slots in a column on the left (a row on top when the screen is portrait), the same controls on the top row, 104 x
--       130 cards, and the Detail frame is the Sheet (renamed): over the grid, never over the slots, its actions at the bottom edge.
-- Picking: a tap on a slot = pick mode (banner + glow); a tap on a pet drops it in at once (BattleRequest "TeamSet", the slot shows
-- it with a pop and a heavy sound); a pet in another slot swaps; the slot's own pet ends pick mode on its details (Remove);
-- tap the slot again or X to cancel. Every write is a draft until a sync shows it: a "bad" Notify, or no sync in K.ANSWER s,
-- drops it AT ONCE with a toast and arms the same slot again (a pick that came from pick mode). A gardening pet asks first
-- (PetBits.askRecall, HomeAction "GardenRecall" stores the team in ONE request); a training pet is refused on the spot.
-- A hole ("") in a TeamSet keeps the others at their index: the server's kept rule lets a busy pet stay only in its slot.
-- Remotes used: BattleRequest ("TeamSet", "TeamSelect"), HomeAction ("GardenSet", "GardenRecall"), Notify (in).
-- (kit-b U8) One colour by role: green is the window's one main action (Put in team; Open Shop when there are no pets), gold
-- the selected thing (the active team, the selected card's face), red what removes (Remove, an armed Clear, the X), stone
-- everything else.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the power sword, the stars, the busy marks
local SignKit = require(Shared:WaitForChild("SignKit")) -- (render gate) the header's band in over a phone's title sign
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local Bits = require(Client:WaitForChild("UI"):WaitForChild("PetBits"))
local State = require(Client:WaitForChild("State"))
local SoundFx = require(Client:WaitForChild("SoundFx"))

local PetCatalog = require(Shared:WaitForChild("PetCatalog"))
local BattleCatalog = require(Shared:WaitForChild("BattleCatalog"))

local PetsController = {}
PetsController.Opened = Util.Signal()
PetsController.Closed = Util.Signal()

local K = {
	DISPLAY_ORDER = 19,
	MARGIN = 12, -- screen px left and right of the window
	PORTRAIT_TOP = 52, -- (render gate) a portrait screen's window starts this far under the gui inset: the HUD's currency
	-- row (its 12 px edge + a 32 px strip) and an 8 px gap
	RECT = { H0 = 390, W0 = 820, Y0 = 330, H1 = 1080, W1 = 1260, Y1 = 900 }, -- window px at the two screen heights
	PHONE_W = 900, -- design px: narrower, or lower than SHORT, is the phone layout (the PC top row needs this much)
	SHORT = 560,
	PC_MIN_H = 600, -- a landscape screen this tall keeps the window under PC_MAX_W of its width
	PC_MAX_W = 0.76,
	POWER_28_W = 290, -- (render gate) Team power keeps its 28 px text from this width (a six-figure power fits), else 24
	BAND_REACH = 28, -- (render gate) design px the header's T1 band and its tails reach past the window's frame on PC
	-- (SignKit.HeaderBand.Over 10 + a 34 px title's tail 24 - 7 under the band)
	SLOTS = 3,
	PRESETS = 3,
	SEND_GAP = 0.45, -- seconds between two TeamSet / TeamSelect (the server's cooldowns are 0.4 / 0.3: a closer one is dropped)
	SEND_BURST = 4, -- the server's shared BattleRequest bucket (BattleService REQUEST_BURST / REFILL, 4 and 1/s; a miss gets no answer)
	SEND_REFILL = 0.9, -- per second, a little under the server's: a late send followed by a quick one still arrives inside it
	ANSWER = 2.5, -- seconds a write waits for the sync or a refusal
	UNDO_SECONDS = 6,
	CLEAR_SECONDS = 3,
	FIRE_GAP = 0.3, -- client-side spacing of the same HomeAction
	TICK = 1, -- seconds between two refreshes of the shown training time
	BUILD_BUDGET = 0.004, -- card viewports: the first of a frame always, more while the frame spent < this many seconds
	BUILD_MAX = 3,
	BACK_ACTION = "NimbusPetsBack", -- owns gamepad B while the window is open (it would also dash)
	SORTS = { "Strongest", "Rarest", "Level" },
	TOUCH = 44, -- screen px: the smallest tap target
	PHONE_CHIPS = { 96, 116, 88 }, -- Sort, Auto-fill, Clear on a landscape phone's top row; they share what the close button leaves
	PC_CARD = { 116, 170, 8 }, -- w, h, gap
	POWER_W = 240, -- design px Team power needs beside the button columns (a big number at 24 px); with less (a tablet) the top row stacks
	STACK_W = 446, -- design px of a stacked top row: Auto-fill + Clear + the three team buttons
	STACK_CLEAR_W = 100, -- ... Clear's (or Undo's) part of it
	WIDE_W = 1150, -- design px: from this window width the buttons and the detail take their full size
	PHONE_CARD = { 104, 130, 6 },
	CARD_LIP = 6, -- (kit-b U8) px of a card's rarity lip
	PHONE_TITLE = { 140, 134, 42 }, -- a phone's title sign: portrait width, landscape width, height (LOOK-ui: room for the paw)
	PHONE_SLOT = 30, -- (LOOK-ui) the paw's gold square on a phone's title sign (18 px paw)
	CHIP = 26, -- px of a card's element / number / tier chips
	-- (Pitch 2 fix round B r1) the F0 A mock's busy band (finish_windows.busy_band): its word on a PC card (the mock's 16, under
	-- the card's 18), the lip along its foot, the gap between its mark and its word
	BUSY_TEXT = 16,
	BUSY_LIP = 3,
	BUSY_GAP = 4,
	TEAM_BUSY_TEXT = 18, -- (F0 review) the team's busy line under Team power; (C19 review) down to the 14 screen px floor to fit
}

-- (kit-b U8) the Signboard palette: brown ink on stone, the role tags on red / sky, the busy covers on violet / grass
local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local GOLD = SIGN.Gold
local FIGHTER_COLOR = SIGN.Red
local HELPER_COLOR = SIGN.Sky
local GARDEN_COLOR = SIGN.Grass
local TRAIN_COLOR = SIGN.Violet
local TIER_COLORS = { Golden = Color3.fromRGB(246, 196, 64), Rainbow = Color3.fromRGB(226, 110, 214), Hybrid = Color3.fromRGB(150, 110, 232) }
local XP_COLOR = SIGN.Sky
-- id, name, the short name a one-line tile falls back to (LOOK-ui: "Battle powe13,213" ran into its number)
-- (playtest 2026-11-28 C20) Income is "Cash" (Theme.Currency.Cash.Name; was "Coins")
local ROWS = { { "Income", "Cash", "Cash" }, { "Power", "Battle power", "Power" }, { "Health", "Health", "Health" }, { "Speed", "Speed", "Speed" } }

-- typography (kit-b U7b: the sword, the stars and the busy / work marks are PixelIcons, ICON; the emoji went)
local G = {
	Bullet = "\194\183",
	Close = "\195\151",
}
local ICON = { Power = "sword", Star = "star", Training = "weight", Garden = "sprout", Evolve = "sparkle" }
-- (LOOK-ui, kitb-look1) the detail's stat tiles (icon, role colour: the pitch's .ci) and the actions' lead icons
-- (playtest 2026-11-28 C20) Income is Cash: the banknote (Theme.Currency.Cash.Icon); a gold coin read as Cloud Tokens
local ROW_LOOK = { Income = { Theme.Currency.Cash.Icon or "note", Theme.Sign.Gold }, Power = { "sword", Theme.Sign.Red }, Health = { "heart", Theme.Sign.Roof }, Speed = { "dash", Theme.Sign.Sky } }
local ACT_ICON = { ActPut = "plus", ActFeed = "apple", ActTrain = "bell", ActGarden = "sprout", ActEvolve = "sparkle", ActFighter = "sword" }

local frame, text, stroke = Bits.frame, Bits.text, Bits.stroke

local initialized = false
local LocalPlayer = nil
local U = { Slots = {}, Cards = {}, Rows = {} } -- widgets
local S = {
	Open = false,
	Built = false,
	Token = 0,
	Sort = "Strongest",
	Selected = nil,
	Pick = nil, -- the slot in pick mode
	View = nil, -- the team shown when it is not the active one (Open's Preset)
	SheetOpen = false,
	Mode = "PC", -- "PC" | "Phone"
	Portrait = false,
	Draft = nil, -- { Preset, Keys (dense, shown), Send (holes kept), Sent, Pick } the write waiting for its sync
	Active = nil, -- { Preset, Sent } the team change waiting for its sync
	LastSend = 0,
	LastSelect = 0,
	SendTokens = K.SEND_BURST,
	SendAt = 0,
	Scale = 1,
	Waiting = false,
	TouchOff = false,
	Ready = {}, -- key -> true once the card has its viewport
	Filling = false,
	Order = {},
	Power = {}, -- key -> UnitPower (this refresh)
	ClearArmed = 0, -- a token while Clear waits for its second tap
	UndoId = 0,
	Undo = nil, -- { Preset, Keys } what Undo sends
	ReturnTo = nil,
	LastFire = {},
	Warned = {},
}
local H = {}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[PetsController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, a, b = pcall(fn, ...)
	if not ok then
		warnOnce(key, a)
	end
	return ok, a, b
end

-- (Pitch 2 F0, the owner's pick A: one number style) the window's numbers (power, team power, health, speed, XP) read
-- in Theme.Short ("13.2K", "19.8K", "659"), as the HUD's balances do; the name is kept for its callers
local function commas(n)
	return Theme.Short(tonumber(n) or 0)
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(x, y)
	inst.Size = UDim2.fromOffset(w, h)
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.hint(message, kind)
	local menu = H.controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		safe("hint", menu.Hint, message, kind or "info")
	end
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.remote(name)
	local ok, remote = pcall(Remotes.Get, name)
	return ok and remote or nil
end

function H.fireHome(key, action, arg)
	local now = os.clock()
	if S.LastFire[key] and now - S.LastFire[key] < K.FIRE_GAP then
		return false
	end
	local remote = H.remote("HomeAction")
	if not remote then
		return false
	end
	S.LastFire[key] = now
	return (pcall(function()
		remote:FireServer(action, arg)
	end))
end

----------------------------------------------------------------------
-- The team: what is shown = the draft while one waits, else the synced preset
----------------------------------------------------------------------
function H.teams()
	local ok, teams = pcall(State.Teams)
	if ok and type(teams) == "table" and type(teams.Presets) == "table" then
		return teams
	end
	return { Presets = { {}, {}, {} }, Active = 1, Slots = K.SLOTS }
end

function H.activePreset()
	if S.Active then
		return S.Active.Preset
	end
	local a = math.floor(tonumber(H.teams().Active) or 1)
	if a < 1 or a > K.PRESETS then
		a = 1
	end
	return a
end

function H.shownPreset()
	return S.View or H.activePreset()
end

function H.keys()
	local preset = H.shownPreset()
	if S.Draft and S.Draft.Preset == preset then
		return S.Draft.Keys
	end
	return H.teams().Presets[preset] or {}
end

local function sameList(a, b)
	if #a ~= #b then
		return false
	end
	for i = 1, #a do
		if a[i] ~= b[i] then
			return false
		end
	end
	return true
end

-- the three slots with false for an empty one (edits keep the others at their index)
function H.slotList()
	local keys = H.keys()
	local list = {}
	for i = 1, K.SLOTS do
		list[i] = keys[i] or false
	end
	return list
end

function H.indexOf(key)
	for i, k in ipairs(H.keys()) do
		if k == key then
			return i
		end
	end
	return nil
end

function H.powerOf(key)
	local cached = S.Power[key]
	if cached then
		return cached
	end
	local def = Bits.defOfKey(key)
	local level = Bits.petLevel(key)
	local power = def and Bits.battlePower(key, def, level) or 0
	S.Power[key] = power or 0
	return S.Power[key]
end

-- the strongest free pets (busy pets excluded): Auto-fill best
function H.best(count)
	local rows = {}
	for _, key in ipairs(Bits.ownedKeys()) do
		if not Bits.busyOf(key) then
			rows[#rows + 1] = key
		end
	end
	table.sort(rows, function(a, b)
		local x, y = H.powerOf(a), H.powerOf(b)
		if x ~= y then
			return x > y
		end
		return a < b
	end)
	local out = {}
	for i = 1, math.min(count, #rows) do
		out[i] = rows[i]
	end
	return out
end

function H.trainingText(key)
	local job = Bits.job(key)
	local name = Bits.displayName(key)
	if job then
		return name .. " is training (" .. Bits.jobLeft(job) .. " left)"
	end
	return name .. " is training"
end

----------------------------------------------------------------------
-- Writes: a draft shows at once; the sync confirms it, a refusal or silence drops it at once and says so
----------------------------------------------------------------------
function H.newDraft(preset, list, pickSlot)
	local last = 0
	for i = 1, K.SLOTS do
		if list[i] then
			last = i
		end
	end
	local dense, send = {}, {}
	for i = 1, last do
		send[i] = list[i] or ""
		if list[i] then
			dense[#dense + 1] = list[i]
		end
	end
	-- Before: the saved team this write replaces (a sync that changed it answered this write, whatever it now holds)
	local prior = S.Draft
	local before = H.teams().Presets[preset] or {}
	if prior and prior.Preset == preset then
		before = prior.Sent and prior.Keys or prior.Before
	end
	return { Preset = preset, Keys = dense, Send = send, Before = { unpack(before) }, Pick = pickSlot, Sent = false }
end

-- seconds until the server's request bucket lets one more through (the mirror of BattleService's takeToken)
function H.bucketWait()
	local now = os.clock()
	S.SendTokens = math.min(K.SEND_BURST, S.SendTokens + (now - S.SendAt) * K.SEND_REFILL)
	S.SendAt = now
	return S.SendTokens >= 1 and 0 or (1 - S.SendTokens) / K.SEND_REFILL
end

function H.armAnswer(draft)
	task.delay(K.ANSWER, function()
		if S.Draft == draft then
			H.dropDraft("Your team could not save. Try again!")
		end
	end)
end

function H.flushDraft()
	local draft = S.Draft
	if not draft or draft.Sent then
		return
	end
	local wait = math.max(K.SEND_GAP - (os.clock() - S.LastSend), H.bucketWait())
	if wait > 0 then
		if not S.Waiting then
			S.Waiting = true
			task.delay(wait, function()
				S.Waiting = false
				H.flushDraft()
			end)
		end
		return
	end
	S.LastSend = os.clock()
	S.SendTokens = S.SendTokens - 1
	draft.Sent = true
	local remote = H.remote("BattleRequest")
	if remote then
		safe("TeamSet", function()
			remote:FireServer("TeamSet", draft.Preset, draft.Send)
		end)
	end
	H.armAnswer(draft)
end

function H.write(list, pickSlot)
	S.Draft = H.newDraft(H.shownPreset(), list, pickSlot)
	H.flushDraft()
end

-- the write is gone: the slots show the saved team again at once; a pick is armed again on its slot
function H.dropDraft(message)
	local draft = S.Draft
	S.Draft = nil
	if draft and draft.Pick and S.Open then
		S.Pick = draft.Pick
	end
	if message then
		H.hint(message, "bad")
	end
	H.refresh()
end

function H.selectTeam(preset)
	S.Pick = nil
	S.View = nil
	S.Draft = nil
	if preset == math.floor(tonumber(H.teams().Active) or 1) and not S.Active then
		H.refresh()
		return
	end
	local want = { Preset = preset, Sent = false }
	S.Active = want
	H.flushSelect()
	H.refresh()
end

function H.flushSelect()
	local want = S.Active
	if not want or want.Sent then
		return
	end
	local wait = math.max(K.SEND_GAP - (os.clock() - S.LastSelect), H.bucketWait())
	if wait > 0 then
		task.delay(wait, H.flushSelect)
		return
	end
	S.LastSelect = os.clock()
	S.SendTokens = S.SendTokens - 1
	want.Sent = true
	local remote = H.remote("BattleRequest")
	if remote then
		safe("TeamSelect", function()
			remote:FireServer("TeamSelect", want.Preset)
		end)
	end
	task.delay(K.ANSWER, function()
		if S.Active == want then
			S.Active = nil
			H.hint("Your team could not change. Try again!", "bad")
			H.refresh()
		end
	end)
end

-- a "bad" Notify while a write waits: that was the server's answer
function H.onNotify(message, kind)
	if kind ~= "bad" or type(message) ~= "string" then
		return
	end
	local handled = false
	if S.Active and S.Active.Sent then
		S.Active = nil
		handled = true
	end
	if S.Draft and S.Draft.Sent then
		H.dropDraft(nil)
		handled = true
	end
	if handled then
		H.hint(message, "bad")
		H.refresh()
	end
end

-- a sync: the writes it confirms are done
function H.settle()
	local teams = H.teams()
	local draft = S.Draft
	if draft and draft.Sent then
		local saved = teams.Presets[draft.Preset] or {}
		if sameList(draft.Keys, saved) or not sameList(draft.Before, saved) then
			S.Draft = nil
		end
	end
	if S.Active and S.Active.Sent and S.Active.Preset == teams.Active then
		S.Active = nil
	end
end

----------------------------------------------------------------------
-- Picking
----------------------------------------------------------------------
function H.pop(slot)
	local item = U.Slots[slot]
	if item then
		item.Pop.Scale = 1.16
		Util.Tween(item.Pop, 0.26, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	local name = SoundFx.Id("Sfx", "SpinLand") and "SpinLand" or "Confirm"
	safe("snap", SoundFx.Play, name)
end

-- `slot` gets `key` (a swap when the pet sits in another slot). armed: the tap came from pick mode, so a refusal keeps it.
function H.placeKey(key, slot, armed)
	local list = H.slotList()
	local at = H.indexOf(key)
	if at == slot then
		-- the slot's own pet: its details offer Remove
		S.Pick = nil
		S.Selected = key
		S.SheetOpen = S.Mode == "Phone"
		H.refresh()
		return
	end
	local refusalSlot = armed and slot or nil
	if at then
		list[at] = list[slot]
		list[slot] = key
	else
		local busy = Bits.busyOf(key)
		if busy == "Training" then
			H.hint(H.trainingText(key), "bad")
			return
		end
		list[slot] = key
		if busy == "Garden" then
			-- ONE request takes it out and stores the team; No keeps everything as it is, pick mode armed
			local draft = H.newDraft(H.shownPreset(), list, refusalSlot)
			Bits.askRecall(U.Gui, key, { To = "Team", Preset = draft.Preset, Keys = draft.Send }, function()
				draft.Sent = true
				S.Draft = draft
				S.Pick = nil
				S.Selected = key
				S.SheetOpen = false
				H.armAnswer(draft)
				H.pop(slot)
				H.refresh()
			end, nil, function(action, arg)
				return H.fireHome("Recall", action, arg)
			end)
			return
		end
	end
	H.write(list, refusalSlot)
	S.Pick = nil
	S.Selected = key
	S.SheetOpen = false
	H.pop(slot)
	H.refresh()
end

function H.tapSlot(index)
	index = math.min(index, #H.keys() + 1)
	if S.Pick == index then
		S.Pick = nil
	else
		S.Pick = index
		S.Selected = H.keys()[index] or S.Selected
		S.SheetOpen = false
	end
	H.refresh()
end

function H.tapCard(key)
	if S.Pick then
		H.placeKey(key, S.Pick, true)
		return
	end
	S.Selected = key
	S.SheetOpen = S.Mode == "Phone"
	H.refresh()
end

function H.putInTeam()
	local key = S.Selected
	if not key or H.indexOf(key) then
		return
	end
	local count = #H.keys()
	if count >= K.SLOTS then
		S.Pick = 1
		S.SheetOpen = false
		H.refresh()
		return
	end
	H.placeKey(key, count + 1, false)
end

function H.makeFighter()
	local at = S.Selected and H.indexOf(S.Selected)
	if not at or at == 1 then
		return
	end
	local list = H.slotList()
	list[at], list[1] = list[1], list[at]
	H.write(list)
	S.SheetOpen = false
	H.pop(1)
	H.hint(Bits.displayName(S.Selected) .. " is your fighter now!", "good")
	H.refresh()
end

function H.removeSelected()
	local at = S.Selected and H.indexOf(S.Selected)
	if not at then
		return
	end
	local list = H.slotList()
	list[at] = false
	H.write(list)
	S.SheetOpen = false
	H.refresh()
end

function H.autoFill()
	local best = H.best(K.SLOTS)
	if #best == 0 then
		H.hint("You have no free pet to put in your team.", "bad")
		return
	end
	local preset = H.shownPreset()
	local previous = {}
	for i, key in ipairs(H.keys()) do
		previous[i] = key
	end
	S.Pick = nil
	H.write({ best[1] or false, best[2] or false, best[3] or false })
	H.hint("Team filled", "good")
	S.UndoId = S.UndoId + 1
	local mine = S.UndoId
	S.Undo = { Preset = preset, Keys = previous }
	task.delay(K.UNDO_SECONDS, function()
		if S.UndoId == mine then
			S.Undo = nil
			H.refreshTop()
		end
	end)
	H.refresh()
end

function H.undoFill()
	local undo = S.Undo
	if not undo then
		return
	end
	S.Undo = nil
	S.UndoId = S.UndoId + 1
	S.Draft = H.newDraft(undo.Preset, { undo.Keys[1] or false, undo.Keys[2] or false, undo.Keys[3] or false })
	H.flushDraft()
	H.refresh()
end

function H.clearTeam()
	if S.ClearArmed == 0 then
		S.ClearArmed = (S.ClearToken or 0) + 1
		S.ClearToken = S.ClearArmed
		local mine = S.ClearArmed
		task.delay(K.CLEAR_SECONDS, function()
			if S.ClearArmed == mine then
				S.ClearArmed = 0
				H.refreshTop()
			end
		end)
		H.refreshTop()
		return
	end
	S.ClearArmed = 0
	S.Pick = nil
	H.write({ false, false, false })
	H.refresh()
end

----------------------------------------------------------------------
-- Actions (today's behaviour and rules; a refusal says why at once)
----------------------------------------------------------------------
function H.careOpen(panelId)
	local key = S.Selected
	local care = H.controller("CareController")
	if not key then
		return
	end
	if not care then
		H.hint("Pet care is getting ready. Try again in a moment!", "info")
		return
	end
	if H.inMatch() then
		H.hint(panelId == "Feed" and "Pets eat at home, after the match." or "Pets are busy climbing during a match.", "info")
		return
	end
	if panelId == "Evolve" then
		safe("evolve confirm", care.ConfirmEvolve, key)
		return
	end
	-- the care window takes this one's place and comes back to it on the same pet, with what this one was given
	safe("care open", care.Open, panelId, { Key = key, ReturnTo = { Window = "Pets", Key = key, Preset = S.View, ReturnTo = S.ReturnTo } })
end

function H.doGarden()
	local key = S.Selected
	local def = key and Bits.defOfKey(key)
	if not def then
		return
	end
	if H.inMatch() then
		H.hint("Pets are busy climbing during a match.", "info")
		return
	end
	local home = Bits.homeData()
	local map = type(home.Garden) == "table" and home.Garden or {}
	local slots = Bits.catalogCall("GardenSlots", home) or 0
	local placed = Bits.slotsHolding(map, key)
	if #placed > 0 then
		H.fireHome("Garden", "GardenSet", { Slot = placed[#placed] })
		return
	end
	local job = Bits.job(key)
	if job then
		H.hint(Bits.displayName(key, def) .. " is training (" .. Bits.jobLeft(job) .. " left).", "info")
		return
	end
	if slots <= 0 then
		H.hint("Build the Pet Garden at your home first.", "info")
		return
	end
	local free = Bits.firstFreeSlot(map, slots)
	if not free then
		H.hint("Your Garden is full (" .. slots .. "/" .. slots .. "). Prestige for one more place!", "info")
		return
	end
	H.fireHome("Garden", "GardenSet", { Slot = free, Key = key })
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
function H.chipButton(name, label, style, callback)
	local button = CloudUI.Button({
		Name = name,
		Text = label,
		Style = style,
		Skin = "Sign",
		TextSize = 20,
		ZIndex = 2,
		Callback = function()
			safe(name, callback)
		end,
		Parent = U.Content,
	})
	button.TextWrapped = true
	button.TextTruncate = Enum.TextTruncate.None
	button.LineHeight = 0.92
	return button
end

function H.buildSlot(index)
	local item = { Index = index }
	local button = Util.Create("TextButton", {
		Name = "Slot" .. index,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		ZIndex = 2,
		Parent = U.Content,
	})
	item.Button = button
	-- (kit-b U8) a raised stone tile; its lip takes the pet's rarity colour (refreshSlots)
	CloudUI.SignBlock(button, "Stone", { Face = SIGN.Tile })
	item.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = button })
	item.Face = frame(button, "Face", { ZIndex = 2 })
	-- (kit-b U6) FIGHTER / HELPER is a tag: the Tag role (Theme keeps it in capitals); U8: a flat band, red / sky
	item.Tag = text(button, "Tag", "HELPER", "Tag", 18, INK, { BackgroundTransparency = 0, BackgroundColor3 = HELPER_COLOR, ZIndex = 5 })
	item.Name = text(button, "PetName", "", "Heading", 18, INK, { TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4 })
	item.Level = text(button, "Level", "", "Heading", 18, MUTED, { TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4 })
	item.Power = text(button, "Power", "", "Heading", 18, INK, { TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 4 })
	PixelIcon.Lead(item.Power, ICON.Power) -- (kit-b U7b)
	-- (render gate) the busy cover is opaque over the slot's top (tag and face): a see-through one left the HELPER tag, the
	-- name, level and power as a second washed-out layer; the name and power below it stay readable (layoutSlot)
	item.Busy = text(button, "Busy", "", "Heading", 18, INK, {
		BackgroundTransparency = 0,
		BackgroundColor3 = TRAIN_COLOR,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 6,
	})
	H.busyFinish(item.Busy)
	item.Empty = text(button, "Empty", "Empty", "Heading", 20, MUTED, {
		Size = UDim2.new(1, -8, 1, 0),
		Position = UDim2.fromOffset(4, 0),
		TextWrapped = true,
		ZIndex = 4,
	})
	-- pick mode's ring: a square gold frame round the slot (a selection mark, not a glow)
	item.Glow = frame(button, "PickRing", { Position = UDim2.fromOffset(-3, -3), Size = UDim2.new(1, 6, 1, 6), Visible = false, ZIndex = 7 })
	stroke(item.Glow, GOLD, 4, 0).LineJoinMode = Enum.LineJoinMode.Miter
	button.Activated:Connect(function()
		safe("slot", H.tapSlot, index)
	end)
	U.Slots[index] = item
	return item
end

function H.buildCard(key)
	local item = { Key = key }
	local button = Util.Create("TextButton", {
		Name = "Card_" .. key,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Parent = U.Grid,
	})
	item.Button = button
	-- (kit-b U8) the pitch's .pc: a stone tile with the rarity on its lip (refreshCards paints the lip, the selected face)
	CloudUI.SignBlock(button, "Stone", { Face = SIGN.Tile, LipPx = K.CARD_LIP, Pad = false })
	item.Picture = frame(button, "Picture", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell, ZIndex = 2 })
	item.Name = text(button, "Name", "", "Body", 18, INK, { TextWrapped = true, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3 })
	item.Level = text(button, "Level", "", "Heading", 18, MUTED, { TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3 })
	item.Power = text(button, "Power", "", "Heading", 18, INK, { TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3 })
	PixelIcon.Lead(item.Power, ICON.Power) -- (kit-b U7b)
	-- the team slot's number: a green square (the pitch's tick chip) with the dark green ink
	-- (render gate: over the busy cover, so a busy team pet still shows its slot)
	item.Number = text(button, "Number", "", "Button", 18, SIGN.OnGrass, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Grass, Visible = false, ZIndex = 8 })
	stroke(item.Number, SIGN.Wood, 2, 0).LineJoinMode = Enum.LineJoinMode.Miter
	item.Tier = frame(button, "Tier", { BackgroundTransparency = 0, BackgroundColor3 = GOLD, Visible = false, ZIndex = 5 })
	stroke(item.Tier, SIGN.Wood, 2, 0).LineJoinMode = Enum.LineJoinMode.Miter
	item.TierMark = text(item.Tier, "Mark", "", "Button", 18, INK, { Size = UDim2.new(1, 0, 1, 0), ZIndex = 6 })
	item.Stars = text(button, "Stars", "", "Title", 18, SIGN.GoldLip, { Visible = false, ZIndex = 5 })
	item.Count = text(button, "Count", "", "Heading", 18, INK, { TextXAlignment = Enum.TextXAlignment.Right, Visible = false, ZIndex = 4 })
	-- (render gate) opaque over the picture's top, its own label only (layoutCard: the level under it stays readable)
	item.Busy = text(button, "Busy", "", "Heading", 18, INK, {
		BackgroundTransparency = 0,
		BackgroundColor3 = TRAIN_COLOR,
		TextWrapped = true,
		Visible = false,
		ZIndex = 7,
	})
	H.busyFinish(item.Busy)
	button.Activated:Connect(function()
		safe("card", H.tapCard, key)
	end)
	U.Cards[key] = item
	H.layoutCard(item)
	return item
end

function H.buildDetail()
	local d = {}
	U.D = d
	-- (kit-b U8) the pitch's .dp: a sunk stone well
	d.Frame = frame(U.Content, "Detail", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Well, Active = true, ZIndex = 20 })
	d.Stroke = stroke(d.Frame, SIGN.WellEdge, 2, 0)
	d.Stroke.LineJoinMode = Enum.LineJoinMode.Miter
	d.Hint = text(d.Frame, "Hint", "Pick a pet to see its details.", "Body", 19, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -40, 0, 60),
		TextWrapped = true,
		ZIndex = 21,
	})
	-- the square light well the pet stands in (the pitch's .dw; was a soft gold disc)
	d.Glow = frame(d.Frame, "PetWell", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell, ZIndex = 21 })
	stroke(d.Glow, SIGN.WellEdge, 2, 0).LineJoinMode = Enum.LineJoinMode.Miter
	d.Picture = frame(d.Frame, "Picture", { ZIndex = 22 })
	d.Name = text(d.Frame, "Name", "", "Title", 30, INK, { TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 21 })
	-- (LOOK-ui, kitb-look1: the pitch's .di) the level line, then the rarity and the element as chips on one row (MetaRow:
	-- Meta "Lv 1 / 100" and its stars, a rarity tag in its colour, each element's CloudUI.ElementChip with its name)
	d.MetaRow = frame(d.Frame, "MetaRow", { ZIndex = 21 })
	d.MetaLayout = Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = d.MetaRow,
	})
	d.MetaLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		safe("metaOverflow", H.metaOverflow)
	end)
	d.Meta = text(d.MetaRow, "Meta", "", "Body", 19, MUTED, {
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(0, 80, 1, 0), -- (its width: the text and its stars, H.fitMeta)
		LayoutOrder = 1,
		ZIndex = 21,
	})
	-- (LOOK-ui, kitb-look1) the XP as a block bar (CloudUI.Bar Sign: ten sky blocks on the sky lip token), its numbers beside it
	d.Xp = CloudUI.Bar({ Name = "XpBar", Height = 26, TextSize = 18, Color = XP_COLOR, Skin = "Sign", LabelSide = "Right", Parent = d.Frame })
	d.Xp.Root.ZIndex = 21
	-- (LOOK-ui, kitb-look1: the pitch's .sv) each stat a tile: the tile face in its wood edge, an icon square in the stat's
	-- role colour with its pixel icon (coins gold, battle power red, health pink, speed sky), the name, the number. The
	-- square is sized from the icon's whole-px cells (PixelIcon.Chip), so the icon never hangs over it; H.placeRows lays the
	-- name over the number on PC (the pitch's two lines), beside it on a phone (H.fitRows keeps them apart)
	for _, row in ipairs(ROWS) do
		local look = ROW_LOOK[row[1]] or { "coin", SIGN.Gold }
		local holder = frame(d.Frame, "Row_" .. row[1], { ZIndex = 21, BackgroundTransparency = 0, BackgroundColor3 = SIGN.Tile })
		local edge = stroke(holder, SIGN.Wood, 2, 0)
		edge.Name = "SignEdge"
		edge.LineJoinMode = Enum.LineJoinMode.Miter
		SignKit.FinishBlock(holder, { Out = 2, Shadow = false }) -- (Pitch 2 F0) the light on its edge, the lit top band
		local chip = frame(holder, "Chip", { BackgroundTransparency = 0, BackgroundColor3 = look[2], ZIndex = 22 })
		local icon = PixelIcon.Chip(chip, look[1], 18, Theme.TextOn(look[2]))
		if icon then
			icon.ZIndex = 23
			for _, cell in ipairs(icon:GetChildren()) do
				cell.ZIndex = 23
			end
		end
		local label = text(holder, "Label", row[2], "Body", 18, MUTED, { TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 22 })
		local value = text(holder, "Value", "", "Heading", 19, INK, { TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 22 })
		local r = { Frame = holder, Label = label, Value = value, Chip = chip, Icon = icon, Name = row[2], Short = row[3] }
		U.Rows[row[1]] = r
		value:GetPropertyChangedSignal("Text"):Connect(function()
			H.fitRow(r)
		end)
	end
	-- (LOOK-ui, kitb-look1: the pitch's .sp) the pet's special on a Selected strip in its wood edge, the pixel star first
	d.Special = frame(d.Frame, "Special", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Selected, ZIndex = 21 })
	local specialEdge = stroke(d.Special, SIGN.Wood, 2, 0)
	specialEdge.Name = "SignEdge"
	specialEdge.LineJoinMode = Enum.LineJoinMode.Miter
	SignKit.FinishBlock(d.Special, { Out = 2, Shadow = false }) -- (Pitch 2 F0) the light on its edge, the lit top band
	d.SpecialText = text(d.Special, "SpecialText", "", "Heading", 18, INK, {
		Position = UDim2.fromOffset(8, 0),
		Size = UDim2.new(1, -16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 22,
	})
	d.Work = text(d.Frame, "Work", "", "Heading", 18, INK, {
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 21,
	})
	d.Perks = text(d.Frame, "Perks", "", "Body", 18, INK, {
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 21,
	})
	local function action(name, label, style, callback)
		local button = CloudUI.Button({
			Name = name,
			Text = label,
			Style = style,
			Skin = "Sign",
			TextSize = 22,
			ZIndex = 23,
			Callback = function()
				safe(name, callback)
			end,
			Parent = d.Frame,
		})
		button.TextWrapped = true
		button.TextTruncate = Enum.TextTruncate.None
		button.LineHeight = 0.92
		d[name] = button
		return button
	end
	-- (kit-b U8) one colour by role: Put in team is the green one, Remove the red one, the rest stone. (LOOK-ui, kitb-look1:
	-- red is the close block's alone) Remove is a stone plank with red ink
	action("ActPut", "Put in team", "Green", H.putInTeam)
	action("ActFighter", "Make fighter", "Gray", H.makeFighter)
	action("ActRemove", "Remove", "Gray", H.removeSelected)
	d.ActRemove:SetAttribute("Ink", SIGN.RedLip)
	action("ActFeed", "Feed", "Gray", function()
		H.careOpen("Feed")
	end)
	action("ActTrain", "Train", "Gray", function()
		H.careOpen("Train")
	end)
	action("ActGarden", "Garden", "Gray", H.doGarden)
	action("ActEvolve", "Evolve", "Gray", function()
		H.careOpen("Evolve")
	end)
	d.Close = CloudUI.Button({
		Name = "SheetClose",
		Text = "",
		Style = "Red",
		Skin = "Sign",
		TextSize = 22,
		ZIndex = 23,
		Callback = function()
			S.SheetOpen = false
			H.refresh()
		end,
		Parent = d.Frame,
	})
	NeonKit.CloseMark(d.Close, { Square = true, Ink = SIGN.RedLip, Color = INK }) -- slop audit 2026-11-12: a drawn X (no "X" letter, no glyph)
	NeonKit.CloseBlock(d.Close) -- (LOOK-ui, kitb-look1) the windows' one close block
end

function H.build()
	if S.Built then
		return
	end
	S.Built = true
	U.Holder = frame(U.Gui, "Window_Pets", { Visible = false, ZIndex = 3 })
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = U.Holder })
	U.Panel = CloudUI.Panel({
		Name = "PetsWindow",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Title = "Pets",
		Closable = true,
		Skin = "Signboard", -- (kit-b U8) the pitch's Pets window: roof, navy header with the paw, wood frame, stone body
		Icon = "paw",
		OnClose = function()
			PetsController.Close()
		end,
		Parent = U.Holder,
	})
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = U.Panel.Root })
	U.Content = U.Panel.Content
	U.Content.BackgroundTransparency = 1
	for i = 1, K.SLOTS do
		H.buildSlot(i)
	end
	U.TeamPower = text(U.Content, "TeamPower", "", "Heading", 28, INK, { TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2 })
	U.Breakdown = text(U.Content, "TeamBreakdown", "", "Body", 18, MUTED, {
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 2,
	})
	U.AutoFill = H.chipButton("AutoFill", "Auto-fill best", "Gray", H.autoFill)
	U.Clear = H.chipButton("ClearTeam", "Clear", "Gray", H.clearTeam)
	U.Undo = H.chipButton("Undo", "Undo", "Gray", H.undoFill)
	U.Undo.Visible = false
	U.Undo.ZIndex = 3
	U.Presets = {}
	for i = 1, K.PRESETS do
		local letter = string.sub("ABC", i, i)
		U.Presets[i] = H.chipButton("Preset" .. letter, letter, "Gray", function()
			H.selectTeam(i)
		end)
	end
	-- (kit-b U8) the cards sit in a sunk stone well (the pitch's .wl)
	U.Well = frame(U.Content, "GridWell", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Well, ZIndex = 2 })
	U.WellStroke = stroke(U.Well, SIGN.WellEdge, 2, 0)
	U.WellStroke.LineJoinMode = Enum.LineJoinMode.Miter
	U.Grid = CloudUI.Grid(U.Well, UDim2.fromOffset(116, 170), UDim2.fromOffset(8, 8))
	U.Grid.Name = "Grid"
	U.Grid.ZIndex = 3
	U.GridLayout = U.Grid:FindFirstChild("Layout")
	U.GridPad = U.Grid:FindFirstChildWhichIsA("UIPadding")
	U.Sort = H.chipButton("SortButton", "Strongest", "Gray", function()
		for i, mode in ipairs(K.SORTS) do
			if mode == S.Sort then
				PetsController.SetSort(K.SORTS[i % #K.SORTS + 1])
				return
			end
		end
	end)
	-- (playtest 2026-11-28 C36) the sort chip shows one word: it never wraps (it broke 'Stronges / t' at 640x360)
	U.Sort.TextWrapped = false
	U.Sort.TextTruncate = Enum.TextTruncate.AtEnd
	-- (Pitch 2 F0 A, look review of finish pass A, major 4) the sort row's pet count on its right, the team's busy helpers
	-- ("2 helpers in the garden") under a dotted rule below the breakdown, and the grid's empty slots (H.fillEmpty)
	U.PetCount = text(U.Content, "PetCount", "", "Heading", 20, MUTED, { TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 3, Visible = false })
	U.TeamRule = SignKit.Rule(U.Content, { Name = "TeamRule", ZIndex = 2, Visible = false })
	U.TeamBusy = text(U.Content, "TeamBusy", "", "Body", K.TEAM_BUSY_TEXT, MUTED, { TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 2, Visible = false })
	U.Empties = {}
	-- pick mode's banner: a small navy sign with the gold words
	U.Banner = text(U.Content, "PickBanner", "", "Heading", 20, GOLD, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Navy,
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 9,
	})
	stroke(U.Banner, SIGN.Wood, 3, 0).LineJoinMode = Enum.LineJoinMode.Miter
	U.PickCancel = H.chipButton("PickCancel", G.Close, "Red", function()
		S.Pick = nil
		H.refresh()
	end)
	U.PickCancel.Visible = false
	U.PickCancel.ZIndex = 10
	U.Empty = frame(U.Well, "Empty", { Size = UDim2.new(1, 0, 1, 0), Visible = false, ZIndex = 5 })
	U.EmptyTitle = text(U.Empty, "Title", "No pets yet!", "Title", 26, INK, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -34),
		Size = UDim2.new(1, -24, 0, 34),
		ZIndex = 6,
	})
	Theme.StyleTitle(U.EmptyTitle, "Section") -- (kit-b U8) the one title treatment, as the Index's empty Fusions card
	U.EmptyBody = text(U.Empty, "Body", "", "Body", 18, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -8),
		Size = UDim2.new(1, -24, 0, 44),
		TextWrapped = true,
		ZIndex = 6,
	})
	U.EmptyButton = CloudUI.Button({
		Name = "OpenShop",
		Text = "Open Shop",
		Style = "Green", -- (kit-b U8) the empty window's one main action
		Skin = "Sign",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 20),
		Size = UDim2.fromOffset(200, 48),
		TextSize = 20,
		ZIndex = 7,
		Callback = function()
			local menu = H.controller("MenuController")
			if menu then
				-- lobby shop 16.3 (Task 23): the Shop's Eggs tab (a bare open would show the session's last tab)
				safe("shop", menu.Open, "Shop", { Tab = "Eggs" })
			end
		end,
		Parent = U.Empty,
	})
	H.buildDetail()
	local mouseLock = Client:FindFirstChild("MouseLock")
	if mouseLock then
		local ok, mod = pcall(require, mouseLock)
		if ok and type(mod) == "table" and type(mod.WatchVisible) == "function" then
			safe("mouse lock", mod.WatchVisible, "Dock:" .. U.Holder.Name, U.Holder)
		end
	end
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
function H.viewport()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.X > 2 and vp.Y > 2 then
		return vp.X, vp.Y
	end
	return 1280, 720
end

function H.rect()
	local w, h = H.viewport()
	local inset = 58
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	local R = K.RECT
	local t = math.max(0, math.min(1, (h - R.H0) / (R.H1 - R.H0)))
	local factor = Theme.ScreenFactor(h)
	local big = math.max(1, factor)
	local pxW = math.min((R.W0 + (R.W1 - R.W0) * t) * big, w - 2 * K.MARGIN)
	-- (render gate) the header band's tails reach BAND_REACH past the frame: room for them on both sides of the screen
	local reach = K.BAND_REACH * factor
	local band = (w - pxW) / 2 >= reach + K.MARGIN
	if w > h and h >= K.PC_MIN_H then
		-- the menu tiles and the currency pills stay free (render gate: of the band's tails too, while the window keeps its
		-- full-size PC layout that way; a narrower screen keeps the window's width and the band stays inside)
		local cap = w * K.PC_MAX_W
		if pxW > cap - 2 * reach and (cap - 2 * reach) / factor < K.WIDE_W then
			pxW = math.min(pxW, cap)
			band = false
		else
			pxW = math.min(pxW, cap - 2 * reach)
		end
	end
	-- (render gate) a portrait screen keeps the HUD's currency row (under the gui inset) free, with a gap under it
	local top = w < h and K.PORTRAIT_TOP or 0
	local pxH = math.min((R.Y0 + (R.Y1 - R.Y0) * t) * big, h - inset - top - 2)
	local phone = pxW / factor < K.PHONE_W or pxH / factor < K.SHORT
	local scale = phone and 1 or factor
	return {
		x = math.floor((w - pxW) / 2 + 0.5),
		y = math.floor(math.max(inset + (h - inset - pxH) / 2, inset + top) + 0.5),
		w = pxW,
		h = pxH,
		scale = scale,
		mode = phone and "Phone" or "PC",
		portrait = pxH > pxW,
		band = band and not phone, -- the header's band out over the frame with its tails (SignKit.HeaderOverhang)
	}
end

-- the label's top inset (its UIPadding, shared with PixelIcon's lead inset, which insets the mark with the text)
function H.padTop(label, px)
	local pad = label:FindFirstChildOfClass("UIPadding") or Util.Create("UIPadding", { Parent = label })
	pad.PaddingTop = UDim.new(0, px)
end

function H.layoutCard(item)
	local phone = S.Mode == "Phone"
	local w, h = (phone and K.PHONE_CARD or K.PC_CARD)[1], (phone and K.PHONE_CARD or K.PC_CARD)[2]
	local fs = phone and 15 or 18
	for _, label in ipairs({ item.Level, item.Power, item.Name, item.Count, item.Busy, item.Number, item.Stars }) do
		label.TextSize = fs
	end
	-- (kit-b U8) the pet stands in its light well inside the edge; the element chip on its top-left, the team number top-right
	if phone then
		place(item.Picture, 4, 4, w - 8, 78)
		place(item.Level, 6, 84, 44, 22)
		place(item.Power, 4, 104, w - 10, 20)
		item.Name.Visible = false
	else
		place(item.Picture, 4, 4, w - 8, 92)
		place(item.Level, 8, 72, 52, 24)
		place(item.Name, 4, 98, w - 8, 40)
		place(item.Power, 4, 140, w - 10, 22)
		item.Name.Visible = true
	end
	item.TierMark.TextSize = fs
	if item.Element then
		item.Element.Position = UDim2.fromOffset(7, 7) -- (LOOK-ui) it sizes itself from its icon's whole-px cells
	end
	place(item.Number, w - 7 - K.CHIP, 7, K.CHIP, K.CHIP)
	place(item.Tier, w - 7 - K.CHIP, 11 + K.CHIP, K.CHIP, K.CHIP)
	place(item.Stars, w / 2 - 18, 4, 36, 22)
	place(item.Count, w - 44, phone and 60 or 72, 40, 22)
	-- (Pitch 2 fix round B, the F0 A mock: the opaque cover hid the portrait) a slim activity strip across the picture just
	-- under the chips row, its mark before the word: the pet stays visible round it, the level and the count below it.
	-- (fix round B r1, look review major: "fitted, not finished", the word edge to edge and its mark 1 px out past the strip)
	-- as the mock's band: across the card's whole face, the word its small tag (K.BUSY_TEXT on PC, the phone card's own size
	-- there), its lit top and lip (H.busyFinish)
	place(item.Busy, 0, 7 + K.CHIP + 3, w, phone and 24 or 28)
	-- (playtest 2026-11-28 C53) never under the 14 px floor on screen: 16 design px drew 12.8 px under the 0.8 window
	item.Busy.TextSize = phone and fs or math.max(K.BUSY_TEXT, math.ceil(14 / math.max(S.Scale or 1, 0.01)))
	if item.Busy.Text == "Gardening" or item.Busy.Text == "Garden" then
		item.Busy.Text = H.gardenWord(item)
	end
	H.padTop(item.Busy, 0)
	item.Busy.TextWrapped = false
end

-- (playtest 2026-11-28 C53) a grid card's garden word: "Gardening", or "Garden" on a PC card whose word went up to the
-- 14 px screen floor (a window under 1.0): the mark and "Gardening" at 18 design px filled the strip edge to edge
function H.gardenWord(item)
	return (S.Mode ~= "Phone" and item.Busy.TextSize > K.BUSY_TEXT) and "Garden" or "Gardening"
end

-- (Pitch 2 fix round B; was LOOK-ui kitb-look1's corner mark over the opaque cover) the card's busy mark is a slim strip now (layoutCard): the mark leads the word on its line, as on
-- the team slot's strip (PixelIcon.Mark); a corner mark left by an older layout goes
function H.busyMark(item, name)
	local busy = item.Busy
	local corner = busy:FindFirstChild("Icon")
	if corner then
		corner:Destroy()
	end
	PixelIcon.Mark(busy, name, { Gap = K.BUSY_GAP })
end

-- (Pitch 2 fix round B r1, look review major: the strip read "fitted, not finished" against F0_pets_optA) the mock's busy
-- band finish (finish_windows.busy_band) on a slot's or a card's strip: its face lit along the top (SignKit.Shine follows
-- the face), a lip of the face's own lip colour along its foot on whole screen px (the word and its mark sit above it),
-- and the ink of the face: the grass ink on the Gardening band, the brown ink on the violet Training band
function H.busyFinish(label)
	local pad = label:FindFirstChildOfClass("UIPadding") or Util.Create("UIPadding", { Parent = label })
	pad.PaddingBottom = UDim.new(0, K.BUSY_LIP)
	local lip = Util.Create("Frame", {
		Name = "Lip",
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.new(1, 0, 0, K.BUSY_LIP),
		ZIndex = label.ZIndex,
		Parent = label,
	})
	local function paint()
		local face, grass = label.BackgroundColor3, SIGN.Grass
		lip.BackgroundColor3 = Theme.SignLipOf(face)
		local onGrass = math.abs(face.R - grass.R) < 0.004 and math.abs(face.G - grass.G) < 0.004 and math.abs(face.B - grass.B) < 0.004
		label.TextColor3 = onGrass and SIGN.OnGrass or INK
	end
	paint()
	label:GetPropertyChangedSignal("BackgroundColor3"):Connect(paint)
	CloudUI.SyncLip(label) -- the lip reaches back out by the label's padding (the mark's inset), now and on every change
	SignKit.Whole(lip, function(sc)
		lip.Size = UDim2.new(1, lip.Size.X.Offset, 0, SignKit.Px(K.BUSY_LIP, sc))
	end)
	SignKit.Shine(label)
end

-- the slot's parts: a square on PC, a short wide card on a phone
function H.layoutSlot(item, w, h)
	local phone = S.Mode == "Phone"
	local fs = phone and 15 or 18
	for _, label in ipairs({ item.Tag, item.Name, item.Level, item.Power, item.Busy }) do
		label.TextSize = fs
	end
	item.Empty.TextSize = phone and 16 or 20
	if phone then
		place(item.Tag, 4, 4, 70, 22)
		place(item.Face, w - 58, 2, 56, math.min(56, h - 26))
		place(item.Level, 8, 28, 52, 22)
		place(item.Power, 6, h - 24, w - 12, 22)
		item.Name.Visible = false
	else
		place(item.Tag, 6, 6, 92, 26)
		place(item.Face, 14, 26, w - 28, h - 26 - 54)
		place(item.Name, 6, h - 54, w - 12, 24)
		place(item.Level, 8, h - 30, 50, 26)
		place(item.Power, 50, h - 30, w - 58, 26)
		item.Name.Visible = true
	end
	-- (Pitch 2 fix round B, the F0 A mock: the opaque cover hid the pet) the activity strip takes the FIGHTER / HELPER tag's
	-- row, the pet's face stays in view under it; the level, the power (and the name on PC) stay clear. On a phone the
	-- strip runs the slot's width ("Gardening" and its mark do not fit beside the face) and the face steps down under it
	-- while the pet is busy (H.placeSlotFace)
	-- (fix round B r1, look review major: "Gardening" ended on the strip's end on the 390x844 slots) the mock's band runs
	-- the slot's whole face along its top (finish_windows.busy_band), down over the whole FIGHTER / HELPER tag it stands for
	if phone then
		place(item.Busy, 0, 0, w, 26)
	else
		place(item.Busy, 0, 0, w, 32)
	end
	item.SlotW, item.SlotH = w, h
	H.placeSlotFace(item)
end

-- the phone slot's face: under the tag row (top right). (fix round B r1, look review minor: on the 390x844 slot the FIGHTER
-- tag lay over the portrait circle) the row always holds the FIGHTER / HELPER tag or the busy strip, so the face always
-- steps down under it (refreshSlots still calls this on a busy change)
function H.placeSlotFace(item)
	if S.Mode ~= "Phone" or not item.SlotW then
		return
	end
	local w, h = item.SlotW, item.SlotH
	place(item.Face, w - 58, 28, 56, math.max(24, math.min(56, h - 28 - 26)))
end

-- design px of a tap target: the PC layout runs under a UIScale, 0.8 on a small screen or a tablet
function H.touchSize()
	return math.max(K.TOUCH, math.ceil(K.TOUCH / S.Scale))
end

-- the four rows in two columns. On PC the right column is the wider one under the full detail's width: 'Battle power' is the long
-- label there and a pet's power the long number.
-- (LOOK-ui) the stat tiles two by two, ROW_VGAP between the lines; each tile's icon square, name and number inside it
local ROW_VGAP = 6
-- (LOOK-ui, kitb-look1: the blocker "Battle powe13,213") a PC tile is the pitch's .sv: two lines, the name small and muted
-- on top, the number under it in the Heading face (45 design px: whole px under the 0.8 Fit). A phone tile keeps one
-- line, its name fitted beside the number (H.fitRows)
local ROW2_H = 45
local ROW1_H = 30 -- (playtest 2026-11-28 C15) a short PC panel's one-line tile (its 22 px icon square and 18 px name)
function H.placeRows(x, y, totalW, rowH, gap, phone)
	-- (two lines: both columns the same width, the long name no longer shares its line with the number)
	local leftW = math.floor((totalW - gap) / 2)
	local rightW = leftW
	local two = not phone
	local s = S.Scale or 1
	local chipW = PixelIcon.BoxPx(18, 2, s) -- the icon square from its whole-px cells (PixelIcon.Chip sizes it the same)
	for i, row in ipairs(ROWS) do
		local right, line = (i - 1) % 2 == 1, math.floor((i - 1) / 2)
		local r = U.Rows[row[1]]
		local tileW = right and rightW or leftW
		place(r.Frame, right and x + leftW + gap or x, y + line * (rowH + ROW_VGAP), tileW, rowH)
		local chipY = Theme.Px(math.max(0, (rowH - chipW) / 2), s)
		r.Chip.Position = UDim2.fromOffset(Theme.Px(4, s), math.floor(chipY * s + 1e-6) / s)
		local textX = Theme.Px(4, s) + chipW + Theme.Px(8, s)
		r.TileW, r.TextX, r.Two = tileW, textX, two
		if two then
			r.Label.Text = r.Name
			r.Label.TextYAlignment = Enum.TextYAlignment.Top
			r.Value.TextXAlignment = Enum.TextXAlignment.Left
			r.Value.TextYAlignment = Enum.TextYAlignment.Top
			place(r.Label, textX, Theme.Px(3, s), tileW - textX - 6, 18)
			place(r.Value, textX, Theme.Px(21, s), tileW - textX - 6, 22)
		else
			r.Label.TextYAlignment = Enum.TextYAlignment.Center
			r.Value.TextXAlignment = Enum.TextXAlignment.Right
			r.Value.TextYAlignment = Enum.TextYAlignment.Center
			place(r.Value, 0, 0, tileW - 6, rowH)
		end
	end
	H.fitRows()
end

-- (LOOK-ui, kitb-look1) a one-line tile's name stops 6 px before its number (measured): the full name while it fits,
-- else the short one ("Power"), else truncated. Run after the numbers change (H.refreshDetail)
function H.fitRow(r)
	if not (r.TileW and not r.Two) then
		return
	end
	local ok, m = pcall(Theme.MeasureLabel, r.Value)
	local valueW = math.ceil((ok and typeof(m) == "Vector2" and m.X > 0) and m.X or #r.Value.Text * r.Value.TextSize * 0.6)
	local room = r.TileW - 6 - valueW - 6 - r.TextX
	local name = r.Name
	local okN, n = pcall(Theme.Measure, name, "Body", r.Label.TextSize)
	if okN and typeof(n) == "Vector2" and n.X > room and r.Short then
		name = r.Short
	end
	r.Label.Text = name
	place(r.Label, r.TextX, 0, math.max(0, room), r.Frame.Size.Y.Offset)
end

function H.fitRows()
	for _, r in pairs(U.Rows) do
		H.fitRow(r)
	end
end

function H.layoutDetail(w, h)
	local d = U.D
	d.LayoutW, d.LayoutH = w, h -- (merge) refreshDetail lays it out again for a pet whose perks need the room
	local phone = S.Mode == "Phone"
	local narrow = w < 420
	local pad = phone and 10 or 14
	local fs = phone and 15 or 18
	d.Name.TextSize = phone and 22 or 30
	d.Meta.TextSize = fs
	H.fitMeta()
	d.SpecialText.TextSize = phone and 15 or 18
	d.Work.TextSize = fs
	d.Perks.TextSize = fs
	for _, row in pairs(U.Rows) do
		row.Label.TextSize = fs
		row.Value.TextSize = phone and 15 or 19
	end
	d.Xp.Root.Parent = d.Frame
	-- (playtest 2026-11-28 C15) a panel that cannot grow (a phone's sheet, the short PC panel) steps down until the pet's
	-- Special has its line (H.fitLead picks the step): 1 = a phone's planks at the touch size (44), a short PC panel's
	-- tiles on one line with the Special's room kept over its planks; 2 = a landscape phone's tiles 24 px tall
	local squeeze = d.Squeeze or 0
	local buttonH = phone and 48 or math.max(h < 560 and 52 or 58, H.touchSize())
	if phone and squeeze >= 1 then
		buttonH = math.min(buttonH, H.touchSize())
	end
	local gap = phone and 6 or 8
	local bottomY = h - pad - buttonH
	d.ButtonH, d.Gap, d.BottomY, d.CareY = buttonH, gap, bottomY, bottomY - gap - buttonH
	local textW = w - 2 * pad
	local y
	if phone or h < 560 then
		-- the pet beside its name
		-- (playtest 2026-11-28 C15 review, round 3) a narrow sheet's last step (360x640) takes an 80 px picture, so its tiles
		-- move up under the XP bar (the wide sheet's 6 px) and a pet with two plank rows keeps its Special's strip
		local pic = phone and (narrow and ((squeeze >= 2) and 80 or 96) or 120) or 96
		place(d.Glow, pad + 4, 12, pic - 8, pic - 8)
		place(d.Picture, pad, 8, pic, pic)
		local x = pad + pic + 8
		local nameW = w - x - pad - (phone and 50 or 0)
		place(d.Name, x, 6, nameW, phone and 28 or 34)
		place(d.MetaRow, x, phone and 35 or 41, w - x - pad - (phone and narrow and 50 or 0), phone and 24 or 28)
		H.fitMetaRow()
		-- (LOOK-ui) a whole 6 px between the chips' row and the XP bar (it sat 0 to 1 px under them)
		place(d.Xp.Root, x, phone and 65 or 75, w - x - pad, 24)
		y = phone and 95 or 108
		if narrow then
			y = math.max(y, pic + 14)
		end
		local rowX = (narrow or not phone) and pad or x
		local rowH = phone and ((squeeze >= 2) and 24 or 26) or ROW2_H
		-- (playtest 2026-11-28 C15) a short PC panel's tiles on one line (the phone's tile: the name beside its number) when
		-- the Special has no room under the two-line ones
		local oneLine = phone or squeeze >= 1
		if not phone and oneLine then
			rowH = ROW1_H
		end
		H.placeRows(rowX, y, w - rowX - pad, rowH, 8, oneLine)
		d.RowsAt = { rowX, y, w - rowX - pad, rowH, 8, oneLine } -- (playtest 2026-11-28 C44) for the short panel's nudge
		d.RowsBottom = y + 2 * rowH + ROW_VGAP
		y = y + 2 * rowH + ROW_VGAP + 4
		if phone and not narrow then
			y = math.max(y, pic + 12)
		end
	else
		-- the pet on top
		-- (merge kitb-look1) the 130 px picture too for a pet whose special strip and perks need its 40 px (TightPerks)
		-- (playtest 2026-11-28 C15) and the 96 px one when even that left no row for the perks (H.detailPic)
		local pic = H.detailPic(h, d.TightPerks)
		place(d.Glow, math.floor(w / 2 - pic / 2) + 8, 12, pic - 16, pic - 16)
		place(d.Picture, math.floor(w / 2 - pic / 2), 4, pic, pic)
		y = pic + 6
		place(d.Name, pad, y, textW, 36)
		place(d.MetaRow, pad, y + 38, textW, 28)
		H.fitMetaRow()
		place(d.Xp.Root, pad, y + 72, textW, 26)
		y = y + 104
		local rowH = phone and 30 or ROW2_H
		H.placeRows(pad, y, textW, rowH, 10, phone)
		d.RowsAt = nil
		d.RowsBottom = y + 2 * rowH + ROW_VGAP
		y = y + 2 * rowH + ROW_VGAP + 6
	end
	d.TextY = y
	d.TextW = textW
	d.Pad = pad
	d.W = w
	-- (playtest 2026-11-28 C44) a short PC panel (1274x580) put the team row on the Health / Speed tiles' foot: the
	-- three button rows give up height (never under the touch size), then their gaps (never under 4 px), so the team
	-- row's drawn wood edge (5 px outside its box) starts 5 px under the tiles
	if not phone then
		local rowsBottom = y - 4 -- the rows' foot (y adds a 4-6 px gap under them)
		-- (playtest 2026-11-28 C15) squeezed, the Special's strip keeps its room between the tiles and the team row: its
		-- 32 px, the clear px and the edges over it (5) and under it (the strip's 2, 1, the plank's 5)
		local lead = (squeeze >= 1 and h < 560) and (5 + 32 + 8 - 10) or 0
		local need = rowsBottom + 10 + lead - (bottomY - 2 * (buttonH + gap))
		if need > 0 then
			-- (playtest 2026-11-28 C15) a mouse screen's planks may go down to the short panel's own 52 (the touch size is
			-- for fingers: 55 under the 0.8 window)
			local floor = H.touchSize()
			if lead > 0 and not UserInputService.TouchEnabled then
				floor = math.min(floor, 52)
			end
			local cut = math.max(0, math.min(buttonH - floor, math.ceil(need / 3)))
			buttonH, need = buttonH - cut, need - 3 * cut
			if need > 0 then
				local g = math.max(0, math.min(gap - 4, math.ceil(need / 2)))
				gap, need = gap - g, need - 2 * g
			end
			-- last, the tiles move up into the 9 px under the XP bar (it keeps 5) beside the picture
			local at = d.RowsAt
			if need > 0 and at and at[2] == y - (2 * at[4] + ROW_VGAP + 4) then
				local shift = math.min(need, 4)
				H.placeRows(at[1], at[2] - shift, at[3], at[4], at[5], at[6])
				y = y - shift
				d.TextY = y
				d.RowsBottom = d.RowsBottom - shift
			end
			bottomY = h - pad - buttonH
			d.ButtonH, d.Gap, d.BottomY, d.CareY = buttonH, gap, bottomY, bottomY - gap - buttonH
		end
	end
	if phone then
		place(d.Close, w - 50, 6, 44, 44)
	end
	d.Close.Visible = phone
	H.placeActions()
end

-- the actions along the bottom: team row at the very bottom on a phone, on top of the care row on PC
function H.placeActions()
	local d = U.D
	if not d or not d.W then
		return
	end
	local phone = S.Mode == "Phone"
	local pad, gap, w = d.Pad, d.Gap, d.W
	local innerW = w - 2 * pad
	local teamY = phone and d.BottomY or d.BottomY - 2 * (d.ButtonH + gap)
	local careY = phone and d.CareY or nil
	local fs = phone and 16 or 22
	local inTeam = d.InTeam
	local isFighter = d.IsFighter
	d.ActPut.Visible = not inTeam
	d.ActFighter.Visible = inTeam == true and not isFighter
	d.ActRemove.Visible = inTeam == true
	place(d.ActPut, pad, teamY, innerW, d.ButtonH)
	if isFighter then
		place(d.ActRemove, pad, teamY, innerW, d.ButtonH)
	else
		local half = math.floor((innerW - gap) / 2)
		place(d.ActFighter, pad, teamY, half, d.ButtonH)
		place(d.ActRemove, pad + half + gap, teamY, half, d.ButtonH)
	end
	local list = { d.ActFeed, d.ActTrain, d.ActGarden }
	if d.ActEvolve.Visible then
		list[4] = d.ActEvolve
	end
	for _, button in ipairs({ d.ActPut, d.ActFighter, d.ActRemove, d.ActFeed, d.ActTrain, d.ActGarden, d.ActEvolve }) do
		button.TextSize = fs
	end
	-- (C15 review, round 3) the planks are laid out on the Train plank's own word; the countdown goes on it after
	if d.TrainBase and d.ActTrain.Text ~= d.TrainBase then
		d.ActTrain.Text = d.TrainBase
	end
	-- (gate U9 round 3) a phone keeps one care row only while every label fits its cell on one line; otherwise (Evolve
	-- showing at 390 px, 'Leave Garden') it takes the PC's two rows: Feed | Train over Garden | Evolve
	local careTop = careY
	if phone then
		local cellW = math.floor((innerW - (#list - 1) * gap) / #list)
		local fits = true
		local needs, total = {}, 0
		for i, button in ipairs(list) do
			needs[i] = H.careNeed(button, fs)
			total = total + needs[i]
			fits = fits and needs[i] <= cellW
		end
		if fits then
			for i, button in ipairs(list) do
				place(button, pad + (i - 1) * (cellW + gap), careY, cellW, d.ButtonH)
			end
		elseif total + (#list - 1) * gap <= innerW then
			-- (playtest 2026-11-28 C15, the phone twin of C44) one row still holds every label when each plank takes its
			-- label's room and an even share of the rest: the two rows put Feed / Train on the Health / Speed tiles of a
			-- 640-667 px landscape sheet ('Leave Garden' beside Evolve)
			local share = math.floor((innerW - (#list - 1) * gap - total) / #list)
			local x = pad
			for i, button in ipairs(list) do
				local cw = (i == #list) and (pad + innerW - x) or (needs[i] + share)
				place(button, x, careY, cw, d.ButtonH)
				x = x + cw + gap
			end
		else
			local half = math.floor((innerW - gap) / 2)
			careTop = careY - d.ButtonH - gap
			place(d.ActFeed, pad, careTop, half, d.ButtonH)
			place(d.ActTrain, pad + half + gap, careTop, half, d.ButtonH)
			if d.ActEvolve.Visible then
				place(d.ActGarden, pad, careY, half, d.ButtonH)
				place(d.ActEvolve, pad + half + gap, careY, half, d.ButtonH)
			else
				place(d.ActGarden, pad, careY, innerW, d.ButtonH)
			end
		end
	else
		-- Feed | Train, Garden | Evolve (Garden takes the whole row while there is no Evolve)
		local half = math.floor((innerW - gap) / 2)
		local y1, y2 = teamY + d.ButtonH + gap, teamY + 2 * (d.ButtonH + gap)
		place(d.ActFeed, pad, y1, half, d.ButtonH)
		place(d.ActTrain, pad + half + gap, y1, half, d.ButtonH)
		if d.ActEvolve.Visible then
			place(d.ActGarden, pad, y2, half, d.ButtonH)
			place(d.ActEvolve, pad + half + gap, y2, half, d.ButtonH)
		else
			place(d.ActGarden, pad, y2, innerW, d.ButtonH)
		end
	end
	local buttonsTop = phone and careTop or teamY
	local bottomText = buttonsTop - gap
	d.PerkLineH = phone and 18 or 22
	-- (playtest 2026-11-28 C15 review) the strip's foot keeps one clear px over the planks' drawn edge: its own edge 2 px
	-- under its box, the clear px, the plank's 5 px over its box (it borrowed 2 px of the gap and touched them at
	-- 844x390); its top one clear px under the tiles' edge (both 2 px outside their boxes)
	local stripLimit = buttonsTop - 8
	local short = phone or (d.LayoutH or 0) < 560
	local stripTop0 = math.max(d.TextY + (short and 0 or 2), (d.RowsBottom or d.TextY) + 5)
	local lineH = phone and 20 or 24
	local full = d.WorkFull or d.Work.Text
	local fullH = full ~= "" and lineH * (d.WorkFullLines or d.WorkLines or 1) or 0
	-- (LOOK-ui) the special's strip first, the other perks under it
	local specialH = (d.HasSpecial and (phone and 26 or 32)) or 0
	local afterSpecial = phone and 4 or 6
	-- the lead line under a work note `workH` tall: the Special's strip, or for a pet without one its first perk row
	local function lead(workH)
		local top = workH > 0 and math.max(d.TextY + workH + 2, stripTop0) or stripTop0
		if specialH > 0 then
			return top + specialH <= stripLimit, top, top + specialH + afterSpecial
		end
		top = d.TextY + ((workH > 0 and workH + 2) or (short and 0 or 2))
		return top + d.PerkLineH <= bottomText, top, top
	end
	-- the room the perk rows had under the whole work note and the strip, wherever they land: the tall panel's picture
	-- steps read it (refreshDetail's TightPerks)
	local _, _, seqPerksY = lead(fullH)
	d.PerksFull = bottomText - seqPerksY
	-- (playtest 2026-11-28 C15) the work note, the strip and the perks fill the room in turn on a tall PC panel (its
	-- picture steps down first). A panel that cannot grow (a phone's sheet, the short PC panel, the tall one at its
	-- smallest picture) gives the Special's line its place first, then the work note (whole; or its first note while
	-- the whole one leaves perks only counted: the Evolve plank says 'ready'), then the perk rows: the note took the
	-- Special's room at 960x640 and on landscape phones
	local workText, workH = full, fullH
	local fits, stripTop, perksY = lead(fullH)
	local grows = not short and (d.TightPerks or 0) < 2
	if not grows and fullH > 0 then
		-- every perk shows (on the strip or in the rows) under the whole note: H.planPerks, as refreshDetail lays them
		local _, _, lost = H.planPerks(math.max(0, math.floor((bottomText - perksY) / d.PerkLineH)), fits)
		local wholeOk = fits and lost == 0
		if not wholeOk then
			local firstOk = false
			if d.WorkShort and d.WorkShort ~= full then
				firstOk, stripTop, perksY = lead(lineH)
				if firstOk then
					workText, workH, fits = d.WorkShort, lineH, true
				end
			end
			if not firstOk and not fits then
				workText, workH = "", 0
				fits, stripTop, perksY = lead(0)
			elseif not firstOk then
				fits, stripTop, perksY = lead(fullH)
			end
		end
	end
	if d.Work.Text ~= workText then
		d.Work.Text = workText
	end
	PixelIcon.Mark(d.Work, (workText ~= "" and (workText ~= full or (d.WorkFullLines or 1) == 1)) and d.WorkMark or nil) -- (kit-b U7b)
	place(d.Work, pad, d.TextY, d.TextW, workH)
	d.Work.Visible = workH > 0 and d.TextY + workH <= bottomText
	-- (playtest 2026-11-28 C15 review, round 3) a training pet's note was the only place its time left showed ('Training
	-- Attack Speed (2:07 left)'): where the note drops (a landscape sheet, the short PC panel) the Train plank keeps the
	-- countdown ('Training 2:07', else '2:07 left', else '2:07' beside its training icon: what its cell holds)
	if d.TrainLeft and not (d.Work.Visible and string.find(workText, d.TrainLeft, 1, true)) then
		local cellW = d.ActTrain.Size.X.Offset
		for _, t in ipairs({ d.TrainBase .. " " .. d.TrainLeft, d.TrainLeft .. " left", d.TrainLeft }) do
			d.ActTrain.Text = t
			if H.careNeed(d.ActTrain, fs) <= cellW then
				break
			end
			d.ActTrain.Text = d.TrainBase
		end
	end
	d.Special.Visible = specialH > 0 and fits
	if specialH > 0 then
		place(d.Special, pad, stripTop, d.TextW, specialH)
	end
	-- for the step search (H.fitLead): the Special's line has its place; the whole work note shows too
	d.LeadFits = fits
	d.WorkFits = fullH == 0 or (d.Work.Visible and workText == full)
	local perksH = bottomText - perksY
	place(d.Perks, pad, perksY, d.TextW, math.max(0, perksH))
	d.PerksH = perksH
end

function H.gridPad(px)
	if U.GridPad then
		U.GridPad.PaddingLeft = UDim.new(0, px)
		U.GridPad.PaddingRight = UDim.new(0, px)
		U.GridPad.PaddingTop = UDim.new(0, px)
		U.GridPad.PaddingBottom = UDim.new(0, px)
	end
end

function H.layoutPC(W, H0)
	local x0, gap = 20, 8
	local slot = math.max(116, math.min(168, math.floor(H0 * 0.19)))
	local top = 4
	local presetW, buttonW = 192, W >= K.WIDE_W and 190 or 160
	local right = W - x0
	local presetX = right - presetW
	local buttonX = presetX - 12 - buttonW
	local powerX = x0 + 3 * (slot + gap) + 4
	local powerW = buttonX - 12 - powerX
	-- a tablet has no room for Team power between the slots and the two button columns: power and breakdown go on top, the buttons
	-- in one row under them, and the slots give up what that row still lacks
	local stacked = powerW < K.POWER_W
	U.TopStacked = stacked
	if stacked then
		slot = math.max(116, math.min(slot, math.floor((right - K.STACK_W - 4 - x0) / 3) - gap))
		powerX = x0 + 3 * (slot + gap) + 4
		powerW = right - powerX
	end
	for i, item in ipairs(U.Slots) do
		place(item.Button, x0 + (i - 1) * (slot + gap), top, slot, slot)
		H.layoutSlot(item, slot, slot)
		item.Tag.Visible = true
	end
	U.Breakdown.Visible = true
	U.AutoFill.TextSize, U.Clear.TextSize, U.Undo.TextSize = 22, 20, 22
	S.BusyRoom = false
	if stacked then
		local barY = top + slot - 60
		local clearW = K.STACK_CLEAR_W
		local clearX = presetX - 8 - clearW
		U.TeamPower.TextSize = 28
		place(U.TeamPower, powerX, top, powerW, 34)
		place(U.Breakdown, powerX, top + 34, powerW, barY - top - 34 - 2)
		place(U.AutoFill, powerX, barY, clearX - 8 - powerX, 60)
		U.AutoFill.TextSize = 20
		place(U.Clear, clearX, barY, clearW, 60)
		place(U.Undo, clearX, barY, clearW, 60)
		for i, button in ipairs(U.Presets) do
			place(button, presetX + (i - 1) * 66, barY, 60, 60)
			button.TextSize = 26
		end
	else
		-- (render gate) 28 only while a six-figure power fits: "Team power 19,820" is 259 px at 28 in FredokaOne (the
		-- render's font metrics), so at 257 px it ran into Auto-fill best
		U.TeamPower.TextSize = powerW >= K.POWER_28_W and 28 or 24
		place(U.TeamPower, powerX, top + 8, powerW, 36)
		-- (F0 review) the breakdown's two lines, the dotted rule, the busy helpers' line (the mock's team column)
		place(U.Breakdown, powerX, top + 46, powerW, 48)
		SignKit.SetRule(U.TeamRule, math.min(powerW, 300))
		U.TeamRule.Position = UDim2.fromOffset(powerX, top + 100)
		place(U.TeamBusy, powerX, top + 108, powerW, 26)
		S.BusyRoom = true
		H.fitTeamBusy()
		place(U.AutoFill, buttonX, top + 8, buttonW, 60)
		place(U.Clear, buttonX, top + 80, buttonW, 60)
		for i, button in ipairs(U.Presets) do
			place(button, presetX + (i - 1) * 66, top + 8, 60, 60)
			button.TextSize = 26
		end
		place(U.Undo, presetX, top + 80, presetW, 60)
	end
	-- the well and the detail below
	local bodyY = top + slot + 14
	local bodyH = H0 - 62 - bodyY - 16
	local detailW = W >= K.WIDE_W and 425 or 360
	local wellW = W - 2 * x0 - detailW - 15
	place(U.Well, x0, bodyY, wellW, bodyH)
	U.Well.Visible = true
	local tap = H.touchSize()
	local cancelW = math.max(46, tap)
	place(U.Sort, x0 + 14, bodyY + 10, 150, tap)
	U.Sort.TextSize = 20
	place(U.PetCount, x0 + wellW - 14 - 220, bodyY + 10, 220, tap)
	S.CountRoom = true
	place(U.Banner, x0 + 172, bodyY + 10, wellW - 172 - cancelW - 20, tap)
	U.Banner.TextSize = 20
	place(U.PickCancel, x0 + wellW - 14 - cancelW, bodyY + 10, cancelW, tap)
	U.PickCancel.TextSize = 24
	place(U.Grid, 8, 16 + tap, wellW - 16, bodyH - 24 - tap)
	place(U.D.Frame, W - x0 - detailW, bodyY, detailW, bodyH)
	U.D.Frame.Name = "Detail"
	H.layoutDetail(detailW, bodyH)
	U.GridLayout.CellSize = UDim2.fromOffset(K.PC_CARD[1], K.PC_CARD[2])
	U.GridLayout.CellPadding = UDim2.fromOffset(K.PC_CARD[3], K.PC_CARD[3])
	H.gridPad(6)
	SignKit.Scroll(U.Grid) -- (LOOK-ui) the kit's one bar
	H.fillEmpty()
end

function H.layoutPhone(W, H0)
	local x0 = 10
	local closeW = 44
	local top = 4
	local chipH = 44
	local gridX, gridY, gridW, gridH
	local sheetX, sheetY, sheetW, sheetH
	if S.Portrait then
		-- the slots in a row under the controls, the grid below them
		-- (LOOK-ui, kitb-look1: the stone showed as an empty block between C and the X) A / B / C share the row from the
		-- title sign to the close block
		local px0 = K.PHONE_TITLE[1] + 6
		local pw = math.floor((W - closeW - 10 - px0 - 2 * 4) / 3)
		for i = 1, 3 do
			place(U.Presets[i], px0 + (i - 1) * (pw + 4), top, pw, chipH)
		end
		local rowY = top + chipH + 4
		local cell = math.floor((W - 2 * x0 - 2 * 6) / 3)
		place(U.Sort, x0, rowY, cell, chipH)
		place(U.AutoFill, x0 + cell + 6, rowY, cell, chipH)
		place(U.Clear, x0 + 2 * (cell + 6), rowY, cell, chipH)
		place(U.Undo, x0 + 2 * (cell + 6), rowY, cell, chipH)
		-- (F0 review, minor: the line sat on the slots' top) 6 px under the chips' row, 6 px over the slots
		place(U.TeamPower, x0, rowY + chipH + 6, W - 2 * x0, 20)
		local slotY = rowY + chipH + 32
		local slotW = cell
		for i, item in ipairs(U.Slots) do
			place(item.Button, x0 + (i - 1) * (slotW + 6), slotY, slotW, 92)
			H.layoutSlot(item, slotW, 92)
		end
		place(U.Banner, x0, rowY, W - 2 * x0 - 52, chipH)
		place(U.PickCancel, W - x0 - 46, rowY, 46, chipH)
		gridX, gridY = 6, slotY + 92 + 6
		gridW, gridH = W - 12, H0 - gridY - 6
		sheetX, sheetY, sheetW, sheetH = 6, gridY, W - 12, gridH
	else
		-- the slots in a column on the left, the controls on the top row
		local slotH = math.floor((H0 - 42 - 6 - 2 * 4) / 3)
		for i, item in ipairs(U.Slots) do
			place(item.Button, x0, 42 + (i - 1) * (slotH + 4), 128, slotH)
			H.layoutSlot(item, 128, slotH)
		end
		local x = x0 + 128 + 8
		for i, button in ipairs(U.Presets) do
			place(button, x + (i - 1) * 50, top, 46, chipH)
		end
		x = x + 3 * 50
		-- the chips share what is left before the close button (a 16:9 phone is under 660 design px wide)
		local chips = K.PHONE_CHIPS
		local fit = math.min(1, (W - closeW - 12 - x - 2 * 4) / (chips[1] + chips[2] + chips[3]))
		local sortW, fillW, clearW = math.floor(chips[1] * fit), math.floor(chips[2] * fit), math.floor(chips[3] * fit)
		-- (playtest 2026-11-28 C36) the sort chip gets the room its longest word needs, from Clear's spare first, then
		-- Auto-fill's (it wraps 'Auto-fill / best' at its space): an even squeeze cut 'Strongest' at 640x360
		local sortNeed = 0
		for _, mode in ipairs(K.SORTS) do
			sortNeed = math.max(sortNeed, H.chipNeed(U.Sort, mode, 15, 9)) -- its chevron: 9 px at the 15 px text
		end
		local short = sortNeed - sortW
		if short > 0 then
			local spare = math.max(0, clearW - math.max(H.chipNeed(U.Clear, U.Clear.Text, 15), H.chipNeed(U.Undo, U.Undo.Text, 16)))
			local give = math.min(short, spare)
			clearW, sortW, short = clearW - give, sortW + give, short - give
			spare = math.max(0, fillW - H.chipNeed(U.AutoFill, "Auto-fill", 15))
			give = math.min(short, spare)
			fillW, sortW = fillW - give, sortW + give
		end
		place(U.Sort, x, top, sortW, chipH)
		x = x + sortW + 4
		place(U.AutoFill, x, top, fillW, chipH)
		x = x + fillW + 4
		place(U.Clear, x, top, clearW, chipH)
		place(U.Undo, x, top, clearW, chipH)
		x = x + clearW + 4
		-- (F0 review, minor: the line ran into the close X) it ends 6 px before the close's box (the box is closeW + 6 from
		-- the right edge, its stroke 3 px outside it)
		local powerW = W - closeW - 12 - x
		U.PhonePowerRoom = powerW >= 100
		place(U.TeamPower, x, top, math.max(0, powerW), chipH)
		local bannerX = x0 + 128 + 8
		place(U.Banner, bannerX, top, W - closeW - 8 - bannerX - 52, chipH)
		place(U.PickCancel, W - closeW - 8 - 48, top, 46, chipH)
		gridX, gridY = bannerX, 52
		gridW, gridH = W - bannerX - 6, H0 - 58
		sheetX, sheetY, sheetW, sheetH = bannerX, 4, W - bannerX - 6, H0 - 8
	end
	U.TeamPower.TextSize = 15
	U.Breakdown.Visible = false
	S.BusyRoom, S.CountRoom = false, false
	for _, button in ipairs(U.Presets) do
		button.TextSize = 18
	end
	U.Sort.TextSize, U.AutoFill.TextSize, U.Clear.TextSize, U.Undo.TextSize = 15, 15, 15, 16
	U.Banner.TextSize = 16
	U.PickCancel.TextSize = 22
	-- the grid fills the well; the well is the grid's own frame here
	place(U.Well, gridX, gridY, gridW, gridH)
	U.Well.BackgroundTransparency = 1
	U.WellStroke.Enabled = false
	place(U.Grid, 0, 0, gridW, gridH)
	U.GridLayout.CellSize = UDim2.fromOffset(K.PHONE_CARD[1], K.PHONE_CARD[2])
	U.GridLayout.CellPadding = UDim2.fromOffset(K.PHONE_CARD[3], K.PHONE_CARD[3])
	H.gridPad(2)
	SignKit.Scroll(U.Grid, SignKit.Sizes.ScrollBarPhone)
	H.fillEmpty()
	place(U.D.Frame, sheetX, sheetY, sheetW, sheetH)
	U.D.Frame.Name = "Sheet"
	H.layoutDetail(sheetW, sheetH)
end

-- (kit-b U8) the Signboard header: the full-width navy plank over the window on PC (the content starts under it, 62 px);
-- on a phone the content takes the whole window, so the plank is a short sign at the top-left (the title only, no paw) with
-- the controls beside it (render gate: no roof there).
function H.layoutHeader(panel, phone, band)
	local head, title = panel.TitleBar, panel.TitleLabel
	local plate = title and title.Parent
	local slot = plate and plate:FindFirstChild("IconSlot")
	U.TitlePos = U.TitlePos or title.Position
	U.TitleSize = U.TitleSize or title.Size
	U.HeadSize = U.HeadSize or head.Size
	-- (render gate) the T1 band reaches out over the frame with its tails on PC (its title kept as built, U.TitlePos); a
	-- phone's short sign keeps it inside (its tails would land on the A button and off the screen's edge), its title
	-- placed on that plate below. A PC window with no room beside it (H.rect's band) pulls it in at the end
	SignKit.HeaderOverhang(head, not phone)
	if phone then
		local w = S.Portrait and K.PHONE_TITLE[1] or K.PHONE_TITLE[2]
		head.Position = UDim2.fromOffset(0, 0)
		head.Size = UDim2.fromOffset(w, K.PHONE_TITLE[3])
		title.TextSize = 24
		title.Position = UDim2.fromOffset(10, 0)
		-- (kit-b merge) the title's width in px (the plate's, less 16), so turning the phone resizes the title itself and its
		-- T1 ribbon re-fits the box (it follows the label's Size; the test mock fires no AbsoluteSize on a parent's resize)
		local plateW = plate and plate.Size.X.Scale == 1 and w + plate.Size.X.Offset or w
		title.Size = UDim2.new(0, plateW - 16, 1, 0)
	else
		head.Position = UDim2.fromOffset(0, 0)
		head.Size = U.HeadSize
		title.TextSize = 34
		title.Position = U.TitlePos
		title.Size = U.TitleSize
	end
	-- (LOOK-ui, kitb-look1: one style across screens) the paw on its gold square on a phone's sign too: a smaller square,
	-- the 18 px paw, the title after it
	if slot then
		U.SlotPos = U.SlotPos or slot.Position
		U.SlotSize = U.SlotSize or slot.Size
		local icon = slot:FindFirstChild("Icon")
		local iconName = icon and icon:GetAttribute("PixelIcon") or slot:GetAttribute("IconName")
		slot:SetAttribute("IconName", iconName)
		local px = phone and 18 or 27
		local side = phone and K.PHONE_SLOT or U.SlotSize.X.Offset
		slot.Position = phone and UDim2.new(0, 6, 0.5, 0) or U.SlotPos
		slot.Size = UDim2.fromOffset(side, side)
		if iconName and not (icon and icon:GetAttribute("Px") == px) then
			if icon then
				icon:Destroy()
			end
			icon = PixelIcon.New(slot, iconName, px, INK)
			if icon then
				icon:SetAttribute("Px", px)
				local inset = math.floor((side - px) / 2)
				icon.Position = UDim2.fromOffset(inset, inset)
			end
		end
		slot.Visible = true
		if phone then
			local x = 6 + K.PHONE_SLOT + 6
			title.Position = UDim2.fromOffset(x, 0)
			title.Size = UDim2.new(0, math.max(0, title.Size.X.Offset - (x - 10)), 1, 0)
		end
	end
	-- (render gate) no roof on a phone: over the short title sign it was a stub that covered the currency strips (portrait)
	-- or sat under Roblox's top-left buttons (landscape)
	local roof = panel.Roof
	if roof then
		roof.Visible = not phone
	end
	if not phone and not band then
		SignKit.HeaderOverhang(head, false) -- (the title and the paw stay where they are on the screen)
	end
end

function H.layout()
	if not S.Built then
		return
	end
	local r = H.rect()
	local modeChanged = S.Mode ~= r.mode or S.Portrait ~= r.portrait or S.Laid == nil
	-- (playtest 2026-11-28 C53) the cards' busy word sizes from the window's scale (the 14 px floor): a new scale lays them
	-- out again too (1920 -> 1024 kept the 1.0 window's 16 px, 12.8 on screen)
	local cardsStale = modeChanged or S.Scale ~= r.scale
	S.Mode, S.Portrait, S.Scale = r.mode, r.portrait, r.scale
	local W, H0 = r.w / r.scale, r.h / r.scale
	U.Holder.AnchorPoint = Vector2.new(0, 0)
	U.Holder.Position = UDim2.fromOffset(r.x, r.y)
	U.Holder.Size = UDim2.fromOffset(math.floor(W + 0.5), math.floor(H0 + 0.5))
	U.Fit.Scale = r.scale
	local key = table.concat({ math.floor(W + 0.5), math.floor(H0 + 0.5), r.mode, tostring(r.portrait), math.floor(r.scale * 100) }, "|")
	if S.Laid == key then
		H.coverColumn(r)
		return
	end
	S.Laid = key
	W, H0 = math.floor(W + 0.5), math.floor(H0 + 0.5)
	-- the panel's frame: the content takes the whole window; the title sits over its top-left corner
	local panel = U.Panel
	local phone = r.mode == "Phone"
	U.Content.Position = UDim2.fromOffset(0, phone and 0 or 62)
	U.Content.Size = UDim2.new(1, 0, 1, phone and 0 or -62)
	if panel.TitleBar then
		H.layoutHeader(panel, phone, r.band)
	end
	if panel.CloseButton then
		local size = phone and K.TOUCH or H.touchSize()
		panel.CloseButton.Size = UDim2.fromOffset(size, size)
		panel.CloseButton.AnchorPoint = Vector2.new(0, 0)
		panel.CloseButton.Position = phone and UDim2.new(1, -(size + 6), 0, 4) or UDim2.new(1, -(size + 16), 0, 8)
	end
	U.Well.BackgroundTransparency = 0
	U.WellStroke.Enabled = true
	if phone then
		H.layoutPhone(W, H0)
	else
		H.layoutPC(W, H0)
	end
	-- (F0 review) the sort plank leads with its chevron (led once it has its size and text)
	PixelIcon.Lead(U.Sort, "down", { Px = phone and 12 or 18 })
	H.showTeamExtras()
	if cardsStale then
		for _, item in pairs(U.Cards) do
			H.layoutCard(item)
		end
	end
	H.coverColumn(r)
end

-- The phone window fills the screen and a tablet's reaches them: Roblox's thumbstick and jump button would sit over slot 3
-- and the cards, or the Detail's buttons. They go while it is up and come back as they were: MenuController keeps ONE
-- owner set for every window (re-review 2: the Store opened over this window, or this one over the Store, lays out
-- before WindowOpened closes the other, so a snapshot per window would bring back the other's false).
function H.syncTouch()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local want = S.Open and (S.Mode == "Phone" or touchOnly)
	if want == S.TouchOff then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		safe("touch", menu.SetTouchHidden, "Pets", want)
		return
	end
	pcall(function()
		if want then
			S.TouchWas = GuiService.TouchControlsEnabled
			GuiService.TouchControlsEnabled = false
		else
			GuiService.TouchControlsEnabled = S.TouchWas ~= false
		end
	end)
end

-- a window that reaches over the menu tiles (phones, tablets) hides them while it is open
function H.coverColumn(r)
	local menu = H.controller("MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		safe("cover", menu.SetColumnCovered, S.Open and r and r.x or nil)
	end
	H.syncTouch()
end

----------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------
function H.teamEntries(keys)
	local entries = {}
	for _, key in ipairs(keys) do
		local def = Bits.defOfKey(key)
		if def and not Bits.busyOf(key) then
			entries[#entries + 1] = Bits.battleEntry(key, def, (Bits.petLevel(key)))
		end
	end
	return entries
end

function H.refreshSlots(keys)
	local fighterSeen = false
	for i, item in ipairs(U.Slots) do
		local key = keys[i]
		local def = key and Bits.defOfKey(key) or nil
		local busy = key and Bits.busyOf(key) or nil
		local fighter = false
		if key and not busy and not fighterSeen then
			fighter, fighterSeen = true, true
		elseif not key and i == 1 then
			fighter = true
		end
		item.Tag.Text = fighter and "FIGHTER" or "HELPER"
		item.Tag.BackgroundColor3 = fighter and FIGHTER_COLOR or HELPER_COLOR
		-- (kit-b U8) the rarity on the slot's lip, as on the cards; an empty slot keeps the stone lip
		CloudUI.SignBlock(item.Button, "Stone", { Face = SIGN.Tile, LipColor = def and CloudUI.RarityColor(def.Rarity) or SIGN.StoneLip, Pad = false })
		item.Button:SetAttribute("Rarity", def and def.Rarity or nil)
		item.Empty.Visible = def == nil
		item.Empty.Text = S.Pick == i and "Tap a pet" or "Empty"
		item.Level.Visible = def ~= nil -- (fix round B) the slim busy strip leaves the level row in view on a phone too
		item.Power.Visible = def ~= nil
		item.Face.Visible = def ~= nil
		item.Name.Visible = def ~= nil and S.Mode == "PC"
		item.Glow.Visible = S.Pick == i
		item.Busy.Visible = busy ~= nil
		item.Busy.Text = busy == "Training" and "Training" or (busy and "Gardening" or "")
		item.Busy.BackgroundColor3 = busy == "Training" and TRAIN_COLOR or GARDEN_COLOR
		PixelIcon.Mark(item.Busy, busy == "Training" and ICON.Training or (busy and ICON.Garden or nil), { Gap = K.BUSY_GAP }) -- (kit-b U7b)
		if item.BusyNow ~= (busy ~= nil) then
			item.BusyNow = busy ~= nil
			H.placeSlotFace(item)
		end
		local stage = def and Bits.stage(key) or 0
		local viewKey = def and (key .. "|" .. stage) or nil
		if item.ViewKey ~= viewKey then
			if item.Viewport then
				item.Viewport.Destroy()
				item.Viewport = nil
			end
			item.ViewKey = viewKey
			if def then
				local ok, handle = pcall(CloudUI.PetViewport, item.Face, def, UDim2.new(1, 0, 1, 0), {
					Spin = "sway",
					Animate = true,
					Detail = stage >= 1 and "Low" or "High",
					Evolved = stage >= 1 and stage or nil,
					ZIndex = 2,
				})
				if ok then
					item.Viewport = handle
				end
			end
		end
		if def then
			local level = Bits.petLevel(key)
			item.Name.Text = H.slotName(item.Name, Bits.displayName(key, def), Bits.tierOf(key, def))
			item.Level.Text = "L" .. level
			item.Power.Text = commas(H.powerOf(key))
		end
	end
end

function H.refreshTop()
	if not S.Built then
		return
	end
	local keys = H.keys()
	local entries = H.teamEntries(keys)
	local battle = Bits.battleCatalog()
	local power = 0
	if battle then
		local ok, p = pcall(battle.TeamPower, entries)
		power = ok and tonumber(p) or 0
	end
	U.TeamPower.Text = "Team power " .. commas(power)
	local phone = S.Mode == "Phone"
	local picking = S.Pick ~= nil
	U.TeamPower.Visible = not (phone and picking and not S.Portrait) and (S.Portrait or not phone or U.PhonePowerRoom == true)
	if #entries == 0 then
		U.Breakdown.Text = #keys == 0 and "Tap a slot, then a pet. The fighter battles, two helpers back it up." or "Your whole team is busy: training or gardening."
	else
		local parts = "Fighter " .. commas(H.powerOf(entries[1].Key))
		local helpers = {}
		for i = 2, #entries do
			helpers[#helpers + 1] = commas(H.powerOf(entries[i].Key))
		end
		if #helpers > 0 then
			parts = parts .. " + " .. (#helpers > 1 and "helpers " or "helper ") .. table.concat(helpers, ", ")
		end
		local bonus = nil
		if battle and type(battle.SynergyBonus) == "function" then
			local ok, syn = pcall(battle.SynergyBonus, entries)
			bonus = ok and type(syn) == "table" and type(syn.Entries) == "table" and #syn.Entries > 0
		end
		U.Breakdown.Text = parts .. (bonus and " + team bonus" or "")
	end
	local active, shown = H.activePreset(), H.shownPreset()
	for i, button in ipairs(U.Presets) do
		button:SetAttribute("Selected", i == active)
		button:SetAttribute("Shown", i == shown)
		-- (kit-b U8) the active team is the gold (selected) block; a team only being looked at keeps stone with the ink edge
		CloudUI.SetStyle(button, i == active and "Gold" or "Gray")
		button:SetAttribute("Outline", i == shown and i ~= active)
		button.Visible = not (phone and picking and not S.Portrait)
	end
	-- pick mode takes the controls' row on a phone, the sort's side on PC
	local rowHidden = phone and picking
	for _, button in ipairs({ U.Sort, U.AutoFill, U.Clear }) do
		button.Visible = not rowHidden
	end
	U.Banner.Visible = picking
	U.PickCancel.Visible = picking
	H.showTeamExtras() -- (F0 review) the pet count gives the banner its row while picking
	if picking then
		U.Banner.Text = S.Pick == 1 and "Pick your fighter" or ("Pick a helper for slot " .. S.Pick)
	end
	U.Clear.Text = S.ClearArmed ~= 0 and "Tap again to clear" or "Clear"
	CloudUI.SetStyle(U.Clear, S.ClearArmed ~= 0 and "Red" or "Gray")
	local undo = S.Undo ~= nil and not (phone and picking)
	U.Undo.Visible = undo
	if phone or U.TopStacked then
		U.Clear.Visible = U.Clear.Visible and not undo -- Undo sits in Clear's place
	end
	U.Sort.Text = S.Sort
end

function H.sortedKeys()
	local owned = Bits.ownedKeys()
	local rows = {}
	for i, key in ipairs(owned) do
		local def = Bits.defOfKey(key)
		rows[i] = { Key = key, Power = H.powerOf(key), Rarity = Bits.rarityOrder(def and def.Rarity), Level = (Bits.petLevel(key)), Index = i }
	end
	local sort = S.Sort
	table.sort(rows, function(a, b)
		if sort == "Rarest" and a.Rarity ~= b.Rarity then
			return a.Rarity > b.Rarity
		elseif sort == "Level" and a.Level ~= b.Level then
			return a.Level > b.Level
		end
		if a.Power ~= b.Power then
			return a.Power > b.Power
		end
		return a.Index < b.Index
	end)
	local out = {}
	for i, row in ipairs(rows) do
		out[i] = row.Key
	end
	return out
end

-- Card viewports attach under a per-frame time budget, so a big collection never builds ~30 models in the frame the window
-- opens; until then a card is its rarity tile.
-- (Pitch 2 F0 A: "empty slots drawn as sunk wells with a +"; look review of finish pass A, major 4: the grid left an empty
-- band about 220 px tall under the 12 cards at 1920) after the cards the grid's rows fill with sunk wells marked +: up to
-- the view's last whole row, else to the end of the last card's row. None while there are no pets (the Empty card shows)
function H.fillEmpty()
	local grid, layout = U.Grid, U.GridLayout
	if not (grid and layout and U.Empties) then
		return
	end
	local n = #(S.Order or {})
	local cs, cp = layout.CellSize, layout.CellPadding
	local cw, ch, gx, gy = cs.X.Offset, cs.Y.Offset, cp.X.Offset, cp.Y.Offset
	local pad = U.GridPad
	local w = grid.Size.X.Offset - (pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0)
	local h = grid.Size.Y.Offset - (pad and (pad.PaddingTop.Offset + pad.PaddingBottom.Offset) or 0)
	local cols = math.max(1, math.floor((w + gx) / math.max(1, cw + gx)))
	local rows = math.max(0, math.floor((h + gy) / math.max(1, ch + gy)))
	local want = n > 0 and (math.max(rows, math.ceil(n / cols)) * cols - n) or 0
	local tint = Theme.Mix(SIGN.Well, SIGN.WellEdge, 0.7)
	for i = 1, math.max(want, #U.Empties) do
		local well = U.Empties[i]
		if i <= want then
			if not well then
				-- (playtest 2026-11-28 C53) the "+" well does what it says: a tap opens the Shop's Eggs (it was an inert
				-- Frame that invited a tap); not while picking a pet for the team
				well = Instance.new("TextButton")
				well.Text = ""
				well.AutoButtonColor = false
				well.Name = "EmptySlot_" .. i
				well.BorderSizePixel = 0
				well.ZIndex = 3
				well:SetAttribute("Slot", "Empty")
				CloudUI.SignBlock(well, "Off")
				well.Activated:Connect(function()
					local menu = S.Pick == nil and H.controller("MenuController")
					if menu then
						safe("shop", menu.Open, "Shop", { Tab = "Eggs" })
					end
				end)
				local icon = PixelIcon.New(well, "plus", 18, tint)
				icon.AnchorPoint = Vector2.new(0.5, 0.5)
				icon.Position = UDim2.fromScale(0.5, 0.5)
				icon:SetAttribute("PixelIcon", "plus")
				well.Parent = grid
				U.Empties[i] = well
			end
			well.LayoutOrder = n + i
			well.Visible = true
		elseif well then
			well.Visible = false
		end
	end
end

-- (2026-11-28 playtest C19 review: one row as wide as the Team power column, 257 design px at 1280 x 720, and "1 fighter,
-- 1 helper in the garden" ran 14 px past it onto the Clear button, a whole busy team 126 px) the busy line fits its box:
-- the fighter and helpers named (S.BusyWords[1]) at TEAM_BUSY_TEXT or smaller down to the 14 screen px floor, else the
-- counts alone ("2 in the garden, 1 in training", as the training count always read) the same way; the short form at
-- the floor (cut at its end) only if neither fits
function H.fitTeamBusy()
	local words = S.BusyWords
	if not (U.TeamBusy and type(words) == "table") then
		return
	end
	local room = U.TeamBusy.Size.X.Offset
	local top = K.TEAM_BUSY_TEXT
	local floor = math.min(top, math.ceil(Theme.Readability.MinPx / math.max(0.01, S.Scale or 1) - 0.001))
	for _, line in ipairs(words) do
		for size = top, floor, -1 do
			local ok, m = pcall(Theme.Measure, line, "Body", size)
			if ok and typeof(m) == "Vector2" and m.X <= room then
				U.TeamBusy.Text, U.TeamBusy.TextSize = line, size
				return
			end
		end
	end
	U.TeamBusy.Text, U.TeamBusy.TextSize = words[#words], floor
end

-- the pet count and the busy helpers' line where the layout gave them room (not while picking: the banner and Cancel
-- take the sort row)
function H.showTeamExtras()
	if not U.PetCount then
		return
	end
	U.PetCount.Visible = S.CountRoom == true and S.Pick == nil and U.PetCount.Text ~= ""
	local busy = S.BusyRoom == true and U.TeamBusy.Text ~= ""
	U.TeamBusy.Visible = busy
	U.TeamRule.Visible = busy
end

function H.fillCards()
	if S.Filling then
		return
	end
	S.Filling = true
	task.spawn(function()
		task.wait()
		while S.Open do
			local start = os.clock()
			local count, more = 0, false
			for _, key in ipairs(S.Order) do
				local item = U.Cards[key]
				if item and not S.Ready[key] then
					if count >= K.BUILD_MAX or (count > 0 and os.clock() - start >= K.BUILD_BUDGET) then
						more = true
						break
					end
					S.Ready[key] = true
					count = count + 1
					local def = Bits.defOfKey(key)
					if def then
						local stage = Bits.stage(key)
						local ok, handle = pcall(CloudUI.PetViewport, item.Picture, def, UDim2.new(1, 0, 1, 0), {
							Spin = "sway",
							Animate = false,
							Detail = "Low",
							Evolved = stage >= 1 and stage or nil,
							ZIndex = 2,
						})
						if ok then
							item.Viewport = handle
							item.ViewStage = stage
							if stage >= 1 then
								handle.Frame.Name = "EvolvedView"
							end
						end
					end
				end
			end
			if not more then
				break
			end
			task.wait()
		end
		S.Filling = false
	end)
end

function H.refreshCards(keys)
	local order = H.sortedKeys()
	local owned, slotOf = {}, {}
	for _, key in ipairs(order) do
		owned[key] = true
	end
	for i, key in ipairs(keys) do
		slotOf[key] = i
	end
	for key, item in pairs(U.Cards) do
		if not owned[key] then
			if item.Viewport then
				item.Viewport.Destroy()
			end
			item.Button:Destroy()
			U.Cards[key] = nil
			S.Ready[key] = nil
		end
	end
	S.Order = order
	for index, key in ipairs(order) do
		local def = Bits.defOfKey(key)
		local item = U.Cards[key] or H.buildCard(key)
		item.Button.LayoutOrder = index
		local level = Bits.petLevel(key)
		local stage = Bits.stage(key)
		if item.Viewport and item.ViewStage ~= stage then
			item.Viewport.Destroy()
			item.Viewport = nil
			S.Ready[key] = nil
		end
		-- (kit-b U8) the rarity on the lip; the selected card takes the selected face and the ink edge
		local selected = key == S.Selected
		CloudUI.SignBlock(item.Button, "Stone", {
			Face = selected and SIGN.Selected or SIGN.Tile,
			Edge = selected and INK or nil,
			LipColor = CloudUI.RarityColor(def.Rarity),
			LipPx = K.CARD_LIP,
			Pad = false,
		})
		item.Button:SetAttribute("Rarity", def.Rarity)
		item.Button:SetAttribute("Selected", selected)
		item.Name.Text = Bits.displayName(key, def)
		item.Level.Text = "L" .. level
		item.Power.Text = commas(H.powerOf(key))
		-- the element chip: its drawn icon on the element's colour (was the element's first letter in a disc)
		local element = Bits.elementsOf(def)[1]
		if item.ElementId ~= element then
			if item.Element then
				item.Element:Destroy()
			end
			item.Element = element and CloudUI.ElementChip(item.Button, element, K.CHIP, { ZIndex = 4 }) or nil
			item.ElementId = element
			if item.Element then
				item.Element.Position = UDim2.fromOffset(7, 7)
			end
		end
		local slot = slotOf[key]
		item.Number.Visible = slot ~= nil
		item.Number.Text = slot and tostring(slot) or ""
		local tier = Bits.tierOf(key, def)
		local hybrid = Bits.isHybrid(key, def)
		local mark = (hybrid and "H") or (tier == "Rainbow" and "R") or (tier == "Golden" and "G") or nil
		item.Tier.Visible = mark ~= nil
		if mark then
			item.Tier.BackgroundColor3 = (hybrid and TIER_COLORS.Hybrid) or TIER_COLORS[tier]
			item.TierMark.Text = mark
			item.TierMark.TextColor3 = Theme.TextOn(item.Tier.BackgroundColor3)
		end
		item.Stars.Visible = stage > 0
		if stage > 0 then
			PixelIcon.Mark(item.Stars, ICON.Star, { Count = math.min(2, stage), Of = math.min(2, stage) }) -- (kit-b U7b)
		end
		local copies = State.OwnedCount(key)
		item.Count.Visible = copies > 1
		item.Count.Text = "x" .. copies
		local busy = Bits.busyOf(key)
		item.Busy.Visible = busy ~= nil
		item.Busy.Text = busy == "Training" and "Training" or (busy and H.gardenWord(item) or "")
		H.busyMark(item, busy == "Training" and ICON.Training or (busy and ICON.Garden or nil)) -- (kit-b U7b)
		item.Busy.BackgroundColor3 = busy == "Training" and TRAIN_COLOR or GARDEN_COLOR
	end
	U.Grid.Visible = #order > 0
	U.Empty.Visible = #order == 0
	if #order == 0 then
		local loaded = State.IsLoaded == nil or State.IsLoaded()
		U.EmptyTitle.Text = loaded and "No pets yet!" or "Loading..."
		U.EmptyBody.Text = loaded and "Spin a roulette in the Shop to hatch your first winged friend." or "Fetching your pets from the clouds."
		U.EmptyButton.Visible = loaded
	end
	H.fillCards()
	return order
end

-- (LOOK-ui) the level line as wide as its text and its stars' room (the padding PixelIcon.Mark left), so the chips follow
-- right after it and the stars stay inside its box
function H.fitMeta()
	local meta = U.D.Meta
	local ok, size = pcall(Theme.MeasureLabel, meta)
	local textW = (ok and typeof(size) == "Vector2" and size.X > 0) and size.X or #meta.Text * meta.TextSize * 0.6
	local pad = meta:FindFirstChildOfClass("UIPadding")
	local room = pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0
	meta.Size = UDim2.new(0, math.ceil(textW) + room + 2, 1, 0)
end

-- (LOOK-ui, kitb-look1: at 1280x720 the element chip ran 28 px past the detail, at 960x640 and 390x844 the rarity did)
-- the level line and its chips fit the row's width: first the element chips drop their names (their icon only, as the
-- cards' corner chips), then the level line drops its "/ 100". Measured from the texts (not AbsoluteSize: AutomaticSize
-- resolves a frame later), at the chips' own text size; rebuilds the chips when that changes
function H.metaSize()
	return S.Mode == "Phone" and 15 or 18 -- (the window's 18 design px floor on PC)
end

-- a chip text's width at `size` in the Heading face (Theme.Measure runs wide, never short), whole px
function H.metaTextW(text, size)
	local ok, v = pcall(Theme.Measure, text, "Heading", size)
	return math.ceil((ok and typeof(v) == "Vector2" and v.X > 0) and v.X or #text * size * 0.6)
end

-- (LOOK-ui, kitb-look1) the chips' height: the element chip's icon square (PixelIcon.BoxPx: 22 screen px at 2 px cells)
function H.metaChipH()
	return PixelIcon.BoxPx(18, 2, S.Scale or 1)
end

-- the measure's spare: Theme.Measure came out about 13 % short of the drawn FredokaOne in the renders, so the row steps
-- down early; the chips size themselves (AutomaticSize) and H.metaOverflow steps down once more if they still overrun
local META_SPARE = 1.15
local META_RANK = { Full = 1, Tight = 2, Hide = 3, Pill = 4 }

-- (gate U9 round 3) the room a care plank's label needs on one line: its text in the Button face with the measure's
-- spare, its icon's padding (PixelIcon.Lead) and a 4 px margin, whole px
function H.careNeed(button, size)
	local p = button:FindFirstChildOfClass("UIPadding")
	local inset = p and (p.PaddingLeft.Offset + p.PaddingRight.Offset) or 0
	return math.ceil(H.metaTextW(button.Text, size) * META_SPARE) + inset + 4
end

-- (playtest 2026-11-28 C44) a team slot's name: whole while it fits its label, else the first words as initials and the
-- last word ('O. Golem'), which keeps which pet it is where 'Obsidian...' cut it; a name that still runs over truncates.
-- (C44 review, round 3) a Golden / Rainbow copy (`tier`) keeps its finish word first ('Golden S. Owl', as
-- PetPicker.paintCard), then every word's initial ('G. S. Owl'), then the pet's own initials ('S. Owl': the slot's face
-- shows the finish) before a cut name
function H.slotName(label, name, tier)
	local room = label.Size.X.Offset
	-- (C44 review, round 3) strictly inside the label: the measure with the chips' spare (META_SPARE). The 5 % it let
	-- over drew 'Candy Unic...' (102 px of text in its 92 px label at 960x640)
	local function fits(text)
		return room <= 0 or math.ceil(H.metaTextW(text, label.TextSize) * META_SPARE) <= room
	end
	if fits(name) then
		return name
	end
	local function initialed(text)
		local words = {}
		for word in tostring(text):gmatch("%S+") do
			words[#words + 1] = word
		end
		if #words < 2 then
			return nil
		end
		local out = {}
		for i = 1, #words - 1 do
			out[i] = words[i]:sub(1, 1) .. "."
		end
		return table.concat(out, " ") .. " " .. words[#words]
	end
	local tries = {}
	local own = nil
	if tier == "Golden" or tier == "Rainbow" then
		local base = tostring(name):gsub("^" .. tier .. "%s+", "")
		own = base ~= name and (initialed(base) or base) or nil
		if own and own ~= base then
			tries[#tries + 1] = tier .. " " .. own
		end
	end
	tries[#tries + 1] = initialed(name)
	tries[#tries + 1] = own
	for _, short in ipairs(tries) do
		if fits(short) then
			return short
		end
	end
	return name
end

-- (playtest 2026-11-28 C36) the room a top-row chip needs for `text` on one line at `size` (its padding included; a
-- lead icon of `leadPx` sits left of the centred text, so it needs its width and a 6 px gap on both sides)
function H.chipNeed(button, text, size, leadPx)
	local p = button:FindFirstChildOfClass("UIPadding")
	local inset = p and (p.PaddingLeft.Offset + p.PaddingRight.Offset) or 0
	local leadW = (tonumber(leadPx) or 0) > 0 and (leadPx + 6) or 0
	return math.ceil(H.metaTextW(text, size) * META_SPARE) + inset + 12 + 2 * leadW -- 6 px clear of each wood edge
end

function H.fitMetaRow()
	local d = U.D
	local key = S.Selected
	local def = key and Bits.defOfKey(key) or nil
	local rowW = d.MetaRow.Size.X.Offset
	if not def or rowW <= 0 then
		return
	end
	local size = H.metaSize()
	local gap = 6 -- the row's UIListLayout padding
	local chipH = H.metaChipH()
	-- (LOOK-ui) a tag's text with 8 px each side; an element chip's square, 4 px, its name, 8 px
	local rarity = gap + H.metaTextW(tostring(def.Rarity), size) * META_SPARE + 16
	local chips, names = rarity, 0
	for _, element in ipairs(Bits.elementsOf(def)) do
		chips = chips + gap + chipH
		names = names + H.metaTextW(element, size) * META_SPARE + 12
	end
	if d.MetaFull then
		d.Meta.Text = d.MetaFull
	end
	H.fitMeta()
	local tight = d.Meta.Size.X.Offset + chips + names > rowW
	if tight and d.MetaShort and d.Meta.Size.X.Offset + chips > rowW then
		d.Meta.Text = d.MetaShort
		H.fitMeta()
	end
	-- (last: a 390 px portrait sheet with an evolved pet) the element chips stay off the line; the rarity keeps its tag
	local mode = (d.Meta.Size.X.Offset + chips > rowW and "Hide") or (tight and "Tight") or "Full"
	-- (playtest 2026-11-28 C44 review) and when the tag alone still runs past the row ('Legendary' 9 px onto the wood at
	-- 1024x768), it sizes to the room left: 4 px each side of its word (H.metaChips)
	if mode == "Hide" and d.Meta.Size.X.Offset + rarity > rowW then
		mode = "Pill"
	end
	d.PillW = math.max(0, rowW - d.Meta.Size.X.Offset - gap)
	-- (LOOK-ui) a step H.metaOverflow took for this pet at this width holds (no flicker back up on the next refresh)
	local floorKey = tostring(key) .. "|" .. rowW .. "|" .. size
	if d.MetaFloorKey == floorKey and d.MetaFloor and META_RANK[d.MetaFloor] > META_RANK[mode] then
		mode = d.MetaFloor
		if d.MetaFloorShort and d.MetaShort then
			d.Meta.Text = d.MetaShort
			H.fitMeta()
		end
	end
	if d.MetaRow:GetAttribute("Fit") ~= mode then
		d.MetaRow:SetAttribute("Fit", mode)
		H.metaChips(def)
	elseif mode == "Pill" then
		local tag = d.MetaRow:FindFirstChild("RarityChip")
		if tag then
			H.sizePill(tag, def)
		end
	end
	-- a frame later, laid out, once more (the list's signal does not see an AutomaticSize chip growing inside it)
	if not d.MetaCheck then
		d.MetaCheck = true
		task.delay(0, function()
			d.MetaCheck = false
			safe("metaOverflow", H.metaOverflow)
		end)
	end
end

-- (playtest 2026-11-28 C44 review) a "Pill" row's rarity tag: its word with the measure's spare and 4 px each side, no
-- wider than the room the level line leaves (d.PillW, H.fitMetaRow).
-- (C44 review, round 3) the word gets its room before it is cut: a px smaller (never under the 14 screen px floor), then
-- 3 px each side ('Legend..' at 390x844: the word needed 86 of the tag's 80 px). Narrower rows (360-375 px portrait
-- sheets, 50-66 px of tag) still cut it: a layout call
function H.sizePill(tag, def)
	local d = U.D
	local word = tostring(def.Rarity)
	local size = H.metaSize()
	local room = math.max(0, d.PillW or math.huge)
	local floorPx = math.ceil(((Theme.Readability and Theme.Readability.MinPx) or 14) / math.max(S.Scale or 1, 0.01))
	local function need(px, pad)
		return math.ceil(H.metaTextW(word, px) * META_SPARE) + 2 * pad
	end
	local px, pad = size, 4
	if need(size, 4) > room then
		for _, try in ipairs({ { size - 1, 4 }, { size - 1, 3 } }) do
			if try[1] >= floorPx and need(try[1], try[2]) <= room then
				px, pad = try[1], try[2]
				break
			end
		end
	end
	tag.TextSize = px
	local p = tag:FindFirstChildOfClass("UIPadding")
	if p and (p.PaddingLeft.Offset ~= pad or p.PaddingRight.Offset ~= pad) then
		p.PaddingLeft, p.PaddingRight = UDim.new(0, pad), UDim.new(0, pad)
	end
	tag.Size = UDim2.fromOffset(math.min(need(px, pad), room), H.metaChipH())
end

-- (LOOK-ui, kitb-look1) the detail's chips after its level line: the rarity's tag in its colour (CloudUI.RarityColor; the
-- ink by Theme.TextOn), each element's CloudUI.ElementChip with its name. Rebuilt only when the pet's set changes
function H.metaChips(def)
	local d = U.D
	local fit = d.MetaRow:GetAttribute("Fit") or "Full"
	local tight = fit == "Tight"
	local want = tostring(def.Rarity) .. "|" .. table.concat(Bits.elementsOf(def), ",") .. "|" .. fit .. "|" .. tostring(S.Mode)
	if d.ChipsKey == want then
		return
	end
	d.ChipsKey = want
	for _, child in ipairs(d.MetaRow:GetChildren()) do
		if child:IsA("GuiObject") and child ~= d.Meta then
			child:Destroy()
		end
	end
	local size = H.metaSize()
	-- (kit-b U9 merge check) the rarity word reads 4.5:1 on its chip at every size (Epic's violet read 4.25:1 with the
	-- brown ink under 18 px): Theme.ReadableFace moves the face the least it takes
	local color, chipInk = Theme.ReadableFace(CloudUI.RarityColor(def.Rarity), 4.5)
	local chipH = H.metaChipH()
	-- (LOOK-ui, kitb-look1: "Mythic" and "Legendary" filled their tags edge to edge) the chips size themselves to their
	-- drawn text (AutomaticSize) with 8 px each side; the element chip's name 4 px after its square (CloudUI.ElementChip)
	local tag = text(d.MetaRow, "RarityChip", tostring(def.Rarity), "Heading", size, chipInk, {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, chipH),
		LayoutOrder = 2,
		ZIndex = 22,
	})
	local tagEdge = stroke(tag, SIGN.Wood, 2, 0)
	tagEdge.Name = "SignEdge"
	tagEdge.LineJoinMode = Enum.LineJoinMode.Miter
	if fit == "Pill" then
		-- (playtest 2026-11-28 C44 review) the tag no wider than the row's room: 4 px each side of its word, the word cut at
		-- its end only if even that runs over (H.fitMetaRow; the AutomaticSize tag ran 9 px onto the panel's wood)
		Bits.pad(tag, 4, 0, 4, 0)
		tag.AutomaticSize = Enum.AutomaticSize.None
		tag.TextTruncate = Enum.TextTruncate.AtEnd
		H.sizePill(tag, def)
	else
		Bits.pad(tag, 8, 0, 8, 0)
	end
	for i, element in ipairs((fit == "Hide" or fit == "Pill") and {} or Bits.elementsOf(def)) do
		CloudUI.ElementChip(d.MetaRow, element, 25, {
			Label = not tight and element or nil,
			TextSize = size,
			Role = "Heading",
			Name = "Element_" .. element,
			LayoutOrder = 2 + i,
			ZIndex = 22,
		})
	end
end

-- (LOOK-ui, kitb-look1) laid out, the row's chips still run past it (the drawn face is wider than the measure): one step
-- down (names off the element chips, then the short level line, then the element chips off the line)
function H.metaOverflow()
	local d = U.D
	local layout = d and d.MetaLayout
	local key = S.Selected
	local def = key and Bits.defOfKey(key) or nil
	if not (layout and def and d.MetaRow.Visible) then
		return
	end
	local s = PixelIcon.RestScale(d.MetaRow)
	-- the row's content: the list's size, or the right edge of its farthest chip when that is wider (an AutomaticSize
	-- chip can grow after the list measured it)
	local content = layout.AbsoluteContentSize.X
	local left = d.MetaRow.AbsolutePosition.X
	for _, child in ipairs(d.MetaRow:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			content = math.max(content, child.AbsolutePosition.X + child.AbsoluteSize.X - left)
		end
	end
	local room = d.MetaRow.AbsoluteSize.X
	if s <= 0 or room <= 0 or content <= room + 0.5 then
		return
	end
	local fit = d.MetaRow:GetAttribute("Fit") or "Full"
	local floorKey = tostring(key) .. "|" .. d.MetaRow.Size.X.Offset .. "|" .. H.metaSize()
	if d.MetaFloorKey ~= floorKey then
		d.MetaFloorKey, d.MetaFloor, d.MetaFloorShort = floorKey, nil, nil
	end
	if fit == "Full" then
		fit = "Tight"
	elseif d.MetaShort and d.Meta.Text ~= d.MetaShort then
		d.Meta.Text = d.MetaShort
		d.MetaFloorShort = true
		H.fitMeta()
		return
	elseif fit == "Tight" then
		fit = "Hide"
	elseif fit == "Hide" then
		fit = "Pill" -- (playtest 2026-11-28 C44 review) the tag sizes to the row's room
		d.PillW = math.max(0, d.MetaRow.Size.X.Offset - d.Meta.Size.X.Offset - 6)
	else
		return
	end
	d.MetaFloor = fit
	d.MetaRow:SetAttribute("Fit", fit)
	H.metaChips(def)
end

function H.refreshDetail(keys, order)
	local d = U.D
	local key = S.Selected
	local def = key and Bits.defOfKey(key) or nil
	local has = def ~= nil and State.OwnedCount(key) > 0
	if S.Mode == "Phone" then
		d.Frame.Visible = has and S.SheetOpen
	else
		d.Frame.Visible = #order > 0
	end
	-- (a landscape sheet's own X sits where the window's is: one X at a time, the top one closes the top thing)
	U.Panel.CloseButton.Visible = not (d.Frame.Visible and S.Mode == "Phone" and not S.Portrait)
	d.Hint.Visible = not has
	for _, part in ipairs({ d.Glow, d.Picture, d.Name, d.MetaRow, d.Xp.Root, d.Work, d.Perks, d.Special, d.ActPut, d.ActFighter, d.ActRemove, d.ActFeed, d.ActTrain, d.ActGarden, d.ActEvolve }) do
		part.Visible = has
	end
	for _, row in pairs(U.Rows) do
		row.Frame.Visible = has
	end
	if not has then
		if d.Viewport then
			d.Viewport.Destroy()
			d.Viewport = nil
			d.ViewKey = nil
		end
		return
	end
	local stage = Bits.stage(key)
	local viewKey = key .. "|" .. stage
	if d.ViewKey ~= viewKey then
		if d.Viewport then
			d.Viewport.Destroy()
		end
		-- (an evolved pet shows its evolved form: Low detail keeps the big Evolved II models cheap)
		d.Viewport = CloudUI.PetViewport(d.Picture, def, UDim2.new(1, 0, 1, 0), {
			Spin = "spin",
			ZIndex = 2,
			Evolved = stage > 0 and stage or nil,
			Detail = stage > 0 and "Low" or nil,
		})
		d.ViewKey = viewKey
	end
	local tier = Bits.tierOf(key, def)
	d.Name.Text = Bits.displayName(key, def)
	-- "Lv 1 / 100, Epic, Celestial", the copy's tier / evolution in the same line
	local level, xp = Bits.petLevel(key)
	local cap = Bits.levelCap(key, def)
	-- (LOOK-ui) "Lv 1 / 100" (and the copy's tier / Hybrid), then the rarity and each element as chips (H.metaChips)
	local meta = { "Lv " .. level .. " / " .. cap }
	if tier ~= "Normal" then
		meta[#meta + 1] = tier
	end
	if Bits.isHybrid(key, def) then
		meta[#meta + 1] = "Hybrid"
	end
	d.MetaFull = table.concat(meta, " " .. G.Bullet .. " ")
	meta[1] = "Lv " .. level -- (LOOK-ui, kitb-look1) the line a narrow row shows (H.fitMetaRow)
	d.MetaShort = table.concat(meta, " " .. G.Bullet .. " ")
	d.Meta.Text = d.MetaFull
	H.metaChips(def)
	-- (kit-b U7b) the evolution stars after the line, drawn; (render gate) inside the line's box: the text truncates first
	PixelIcon.Mark(d.Meta, stage > 0 and ICON.Star or nil, { After = true, Room = true, Count = math.min(2, stage), Of = math.min(2, stage), Colour = SIGN.GoldLip })
	H.fitMeta()
	H.fitMetaRow()
	local need = Bits.xpToNext(level)
	if level >= cap then
		d.Xp.SetFraction(1)
		d.Xp.SetText("MAX LEVEL")
		d.Xp.SetColor(GOLD)
	else
		d.Xp.SetFraction(need > 0 and need < math.huge and math.min(1, xp / need) or 0)
		d.Xp.SetText(commas(math.floor(xp)) .. " / " .. commas(need) .. " XP")
		d.Xp.SetColor(XP_COLOR)
	end
	local stats = Bits.battleStatsAt(def, key, level) or {}
	local home = Bits.homeData()
	U.Rows.Income.Value.Text = Bits.formatRate(Bits.coinsPerSecond(key, def, home)) .. "/s"
	U.Rows.Power.Value.Text = commas(H.powerOf(key))
	U.Rows.Health.Value.Text = commas(math.floor((tonumber(stats.Health) or 0) + 0.5))
	U.Rows.Speed.Value.Text = commas(math.floor((tonumber(stats.Speed) or 0) + 0.5))
	H.fitRows() -- (LOOK-ui) a one-line tile's name keeps clear of its new number
	-- where it works / trains, and its evolution
	local job = Bits.job(key)
	local map = type(home.Garden) == "table" and home.Garden or {}
	local placed = #Bits.slotsHolding(map, key) > 0
	local ready = Bits.canEvolve(key, def, level)
	local work, lines, mark = "", 1, nil
	if job then
		work, mark = "Training " .. Bits.skillName(job.Stat) .. " (" .. Bits.jobLeft(job) .. " left)", ICON.Training
	elseif placed then
		work, mark = "Working in your Garden", ICON.Garden
	end
	if ready then
		if work ~= "" then
			work = work .. "\n"
			lines = 2
		end
		work = work .. "Ready to evolve!"
		mark = mark or ICON.Evolve
	end
	-- (playtest 2026-11-28 C15 review) the first note alone, for a panel whose room the whole note would take from the
	-- perks or the Special (H.placeActions): 'Ready to evolve!' is the Evolve plank's word too
	d.WorkShort = (lines == 2) and work:match("^([^\n]*)\n") or nil
	if lines == 2 and d.TextW then
		-- (playtest 2026-11-28 C15) the two notes share one line where it holds them ('Working in your Garden  ·  Ready to
		-- evolve!'): the second line took the Special's room on landscape phones and at 1080p
		local joined = work:gsub("\n", "  ·  ")
		if math.ceil(H.metaTextW(joined, d.Work.TextSize) * META_SPARE) <= d.TextW then
			work, lines = joined, 1
		end
	end
	d.Work.Text = work
	-- (kit-b U7b) a one-line work note leads with its mark (H.placeActions sets it for the note it shows)
	d.WorkFull, d.WorkFullLines, d.WorkMark = work, lines, mark
	d.WorkLines = lines
	-- the special, then the follow perks
	-- (LOOK-ui) the special on its own strip (d.Special), the other perks in the list under it
	local perkLines = {}
	d.HasSpecial = type(def.Special) == "table"
	if d.HasSpecial then
		d.SpecialName = tostring(BattleCatalog.FormNameOf(def.Id, def.Special.Kind, stage) or def.Special.Name or "Special")
		d.SpecialText.Text = "Special: " .. d.SpecialName
		d.SpecialBase = d.SpecialText.Text
		PixelIcon.Mark(d.SpecialText, ICON.Star, { Colour = SIGN.GoldLip })
	end
	if stage >= 1 then
		perkLines[#perkLines + 1] = string.format("Reach +%d%%", math.floor((BattleCatalog.ReachOf(stage) - 1) * 100 + 0.5))
	end
	if type(def.Perks) == "table" then
		local mult = Bits.tierMultiplier(key, def)
		for _, perkKey in ipairs(PetCatalog.PerkOrder or {}) do
			local value = def.Perks[perkKey]
			if type(value) == "number" and value ~= 0 then
				perkLines[#perkLines + 1] = PetCatalog.PerkLabel(perkKey, value * mult)
			end
		end
	end
	d.PerkLines = #perkLines > 0 and perkLines or (d.HasSpecial and {} or { "No perks" })
	for name, icon in pairs(ACT_ICON) do
		local button = d[name]
		if button and button:GetAttribute("LeadDone") ~= icon then
			button:SetAttribute("LeadDone", icon)
			PixelIcon.Mark(button, icon)
		end
	end
	-- the actions
	local at = H.indexOf(key)
	d.InTeam = at ~= nil
	d.IsFighter = at == 1
	d.ActEvolve.Visible = ready ~= nil
	-- (playtest 2026-11-28 C15 review, round 3) the plank's word, and the countdown H.placeActions puts on it where the
	-- work note (the only other place the time shows) drops
	d.TrainBase = job and "Training" or "Train"
	d.TrainLeft = job and Bits.jobLeft(job) or nil
	d.ActTrain.Text = d.TrainBase
	d.ActGarden.Text = placed and "Leave Garden" or "Garden"
	H.placeActions()
	-- (merge kitb-look1) the special's strip took the perks' room under the 170 px picture (PerksH 2 at 1080p: a pet with
	-- a special showed no perk at all): such a pet takes the 130 px one, the others keep the big picture
	-- (playtest 2026-11-28 C15) TightPerks is a step (0 = 170 px, 1 = 130, 2 = 96): the biggest picture that still
	-- shows the Special and every perk (one a row, else packed side by side); at 1080p the 130 px one left a pet's
	-- perks no row at all
	if S.Mode ~= "Phone" and d.LayoutH and d.LayoutH >= 560 then
		local now = H.detailPic(d.LayoutH, d.TightPerks)
		local want = 2
		for step = 0, 2 do
			-- (playtest 2026-11-28 C15 review) the room under the whole work note (PerksFull): the smallest picture lets the
			-- note shorten (H.placeActions), which must not read as room for a bigger picture
			local room = (d.PerksFull or d.PerksH) + now - H.detailPic(d.LayoutH, step)
			local rows = math.floor(room / d.PerkLineH)
			local specialOk = not d.HasSpecial or room >= -6
			local perksOk = #d.PerkLines == 0 or #d.PerkLines <= rows or (rows >= 1 and #H.packPerks(d.PerkLines, math.huge, d.TextW) <= rows)
			if specialOk and perksOk then
				want = step
				break
			end
		end
		if want ~= (d.TightPerks or 0) then
			d.TightPerks = want
			H.layoutDetail(d.LayoutW, d.LayoutH)
		end
	end
	H.fitLead(key)
	d.Perks.Visible = d.PerksH >= d.PerkLineH
	local rows = d.Perks.Visible and math.floor(d.PerksH / d.PerkLineH) or 0
	local line, perkRows = H.planPerks(rows, d.Special.Visible)
	if d.HasSpecial and line and d.SpecialText.Text ~= line then
		d.SpecialText.Text = line
	end
	d.Perks.Text = table.concat(perkRows, "\n")
end

-- (playtest 2026-11-28 C15) the perks the rows cannot hold (a landscape phone, a short PC panel, 1080p) ride first on
-- the Special's strip after its name, as far as they fit it ('Special: Aurora Mark  ·  Reach +15%'); the rest go in
-- the rows, and what still does not fit is counted ('+1 more') so none goes without notice. Returns the strip's line,
-- the rows' lines and how many perks are only counted (H.placeActions reads that to choose the work note's length)
function H.planPerks(rows, stripOn)
	local d = U.D
	local rest = d.PerkLines or {}
	local line = d.SpecialBase
	local counted = 0
	if d.HasSpecial and d.SpecialBase then
		if stripOn and #rest > 0 and #H.packPerks(rest, math.huge, d.TextW) > rows then
			local room = d.TextW - 16 - math.ceil(d.SpecialText.TextSize * 1.5) -- the strip's pads and its star
			-- (the measure alone: the strip's text truncates at its end if the face runs wider)
			local function fits(text)
				return H.metaTextW(text, d.SpecialText.TextSize) <= room
			end
			local n, taken = #rest, 0
			for i, perk in ipairs(rest) do
				local left = n - i
				local nextLine = line .. "  ·  " .. perk
				-- with no rows the strip keeps room for the count of the ones it leaves out
				if not fits((rows == 0 and left > 0) and (nextLine .. "  ·  +" .. left .. " more") or nextLine) then
					break
				end
				line, taken = nextLine, i
			end
			local left = {}
			for i = taken + 1, n do
				left[#left + 1] = rest[i]
			end
			rest = left
			if rows == 0 and #rest > 0 then
				-- (playtest 2026-11-28 C15 review) the count always shows: at 960x640 'Special: Aurora Mark  ·  +3 more' ran
				-- past the strip and the perks went without notice; the strip's star says "Special", so the word goes first
				counted = #rest
				local count = "  ·  +" .. #rest .. " more"
				local name = d.SpecialName or line
				for _, try in ipairs({ line .. count, name .. count, name .. "  ·  +" .. #rest }) do
					if fits(try) then
						line = try
						break
					end
					line = (try == name .. "  ·  +" .. #rest) and try or line
				end
			end
		end
	end
	local out, hidden = H.packPerks(rest, rows, d.TextW)
	if rows <= 0 and not (d.HasSpecial and stripOn) then
		hidden = #rest
	end
	return line, out, counted + (hidden or 0)
end

-- (playtest 2026-11-28 C15) the perk lines for `rows` rows of `w` px: one perk a row while they fit, else whole perks
-- side by side ("Reach +15%  ·  +14% Tokens") so a short panel (1080p, landscape phones) still shows them all; it cut
-- the list at the room's last row before, silently
function H.packPerks(lines, rows, w)
	if rows <= 0 then
		return {}
	end
	if #lines <= rows and rows ~= math.huge then
		return lines
	end
	local SEP = "  ·  "
	local function fits(text)
		return H.perkTextW(text) <= w -- (the Body measure runs wide of the drawn face; the label wraps, never runs on)
	end
	local packed, cur = {}, nil
	for _, line in ipairs(lines) do
		if cur and not fits(table.concat(cur, SEP) .. SEP .. line) then
			packed[#packed + 1] = cur
			cur = nil
		end
		cur = cur or {}
		cur[#cur + 1] = line
	end
	packed[#packed + 1] = cur
	local hidden = 0 -- (playtest 2026-11-28 C15 review) returned too: how many only got counted
	if #packed > rows then
		-- the rows left say how many perks did not fit ('+2 more'), so none goes without notice
		for i = rows + 1, #packed do
			hidden = hidden + #packed[i]
			packed[i] = nil
		end
		local last = packed[rows]
		while #last > 0 and not fits(table.concat(last, SEP) .. SEP .. "+" .. hidden .. " more") do
			table.remove(last)
			hidden = hidden + 1
		end
		last[#last + 1] = "+" .. hidden .. " more"
	end
	local out = {}
	for i, row in ipairs(packed) do
		out[i] = table.concat(row, SEP)
	end
	return out, hidden
end

-- (playtest 2026-11-28 C15 review) a panel that cannot grow (a phone's sheet, the short PC panel under 560 px) takes the
-- smallest step (d.Squeeze, H.layoutDetail) that gives the pet's Special its line: on a phone the one that keeps the
-- whole work note too where a step does. The 640-667 px landscape sheets and the 1274x580 / 960x640 panels showed no
-- Special and no perk at all. Searched again only when what decides it changes (the pet, the panel, the planks shown)
function H.fitLead(key)
	local d = U.D
	if not (d and d.LayoutW and d.LayoutH) then
		return
	end
	local phone = S.Mode == "Phone"
	if not phone and d.LayoutH >= 560 then
		if (d.Squeeze or 0) ~= 0 then
			d.Squeeze, d.SqueezeSig = 0, nil
			H.layoutDetail(d.LayoutW, d.LayoutH)
		end
		return
	end
	-- (the note's digits as zeros: a training timer's tick changes nothing here)
	-- (the Train plank's own word: H.placeActions may add the ticking countdown to it)
	local sig = table.concat({ tostring(key), d.LayoutW, d.LayoutH, tostring(S.Mode), (tostring(d.WorkFull):gsub("%d", "0")), tostring(d.HasSpecial), #(d.PerkLines or {}),
		tostring(d.ActEvolve.Visible), tostring(d.InTeam), tostring(d.IsFighter), d.ActGarden.Text, tostring(d.TrainBase or d.ActTrain.Text), tostring(UserInputService.TouchEnabled) }, "|")
	if d.SqueezeSig == sig then
		return
	end
	d.SqueezeSig = sig
	-- a phone: 1 = the planks at the touch size, 2 = the tiles 24 px (and a narrow sheet's 80 px picture, C15 review
	-- round 3: the 360x640 sheet had no step past 1); a short PC panel: 1 = one-line tiles
	local top = phone and 2 or 1
	local pick, leadOnly = nil, nil
	for s = 0, top do
		d.Squeeze = s
		H.layoutDetail(d.LayoutW, d.LayoutH)
		if d.LeadFits and (d.WorkFits or not phone) then
			pick = s
			break
		end
		if d.LeadFits and leadOnly == nil then
			leadOnly = s
		end
	end
	local want = pick or leadOnly or 0
	if want ~= d.Squeeze then
		d.Squeeze = want
		H.layoutDetail(d.LayoutW, d.LayoutH)
	end
end

-- (playtest 2026-11-28 C15) the detail's picture on top: 170 px on a tall panel, 130 when the perks need the room
-- (step 1), 96 when they need more (step 2)
function H.detailPic(h, step)
	step = tonumber(step) or 0
	if step >= 2 then
		return 96
	end
	return (h >= 620 and step == 0) and 170 or 130
end

function H.perkTextW(text)
	local ok, v = pcall(Theme.Measure, text, "Body", 18)
	return math.ceil((ok and typeof(v) == "Vector2" and v.X > 0) and v.X or #text * 18 * 0.6)
end

function H.refresh()
	if not (S.Built and S.Open) then
		return
	end
	S.Power = {}
	local keys = H.keys()
	local order = H.refreshCards(keys)
	-- keep the selection valid: prefer a team pet, else the strongest
	if not (S.Selected and State.OwnedCount(S.Selected) > 0) then
		S.Selected = nil
		for _, key in ipairs(keys) do
			if State.OwnedCount(key) > 0 then
				S.Selected = key
				break
			end
		end
		S.Selected = S.Selected or order[1]
		H.refreshCards(keys)
	end
	if S.Pick and S.Pick > #keys + 1 then
		S.Pick = #keys + 1
	end
	H.refreshSlots(keys)
	H.refreshTop()
	H.refreshDetail(keys, order)
	-- (F0 review) the pet count, the busy helpers' line and the grid's empty wells follow the pets
	U.PetCount.Text = #order == 1 and "1 pet" or (#order .. " pets")
	-- (2026-11-28 playtest C19) slot 1 is the fighter: a gardening fighter was counted as a "helper"
	local garden, training, fighter = 0, 0, 0
	for i, key in ipairs(keys) do
		local busy = Bits.busyOf(key)
		if busy == "Training" then
			training = training + 1
		elseif busy and i == 1 then
			fighter = 1
		elseif busy then
			garden = garden + 1
		end
	end
	-- (C19 review) and the counts alone, the line's short form where the named one does not fit (H.fitTeamBusy)
	local named, counted = {}, {}
	if fighter + garden > 0 then
		local who = {}
		if fighter > 0 then
			who[#who + 1] = "1 fighter"
		end
		if garden > 0 then
			who[#who + 1] = string.format("%d %s", garden, garden == 1 and "helper" or "helpers")
		end
		named[#named + 1] = table.concat(who, ", ") .. " in the garden"
		counted[#counted + 1] = string.format("%d in the garden", fighter + garden)
	end
	if training > 0 then
		named[#named + 1] = string.format("%d in training", training)
		counted[#counted + 1] = named[#named]
	end
	S.BusyWords = { table.concat(named, ", "), table.concat(counted, ", ") }
	H.fitTeamBusy()
	H.fillEmpty()
	H.showTeamExtras()
end

----------------------------------------------------------------------
-- Back: the recall question, the sheet, pick mode, then the window
----------------------------------------------------------------------
function H.back()
	if Bits.closeRecall() then
		return
	end
	if S.SheetOpen then
		S.SheetOpen = false
		H.refresh()
		return
	end
	if S.Pick then
		S.Pick = nil
		H.refresh()
		return
	end
	PetsController.Close()
end

function H.syncBack()
	if S.Open and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					safe("back", H.back)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	elseif not S.Open and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function PetsController.IsOpen()
	return S.Open
end

function PetsController.Sort()
	return S.Sort
end

function PetsController.SetSort(mode)
	for _, known in ipairs(K.SORTS) do
		if known == mode then
			S.Sort = mode
			H.refresh()
			return
		end
	end
end

function PetsController.Layout()
	if S.Open then
		return S.Mode
	end
	return H.rect().mode
end

function PetsController.ReturnArgs()
	if S.Open and S.ReturnTo then
		return { Key = S.Selected, Preset = S.View, ReturnTo = S.ReturnTo }
	end
	return nil
end

function PetsController.Open(args)
	if not initialized then
		PetsController.Init()
	end
	if not U.Gui then
		return false
	end
	args = type(args) == "table" and args or {}
	H.build()
	local wasOpen = S.Open
	S.Open = true
	S.Token = S.Token + 1
	if type(args.ReturnTo) == "table" then
		S.ReturnTo = args.ReturnTo
	elseif not wasOpen then
		S.ReturnTo = nil
	end
	local preset = tonumber(args.Preset)
	if preset and preset >= 1 and preset <= K.PRESETS and preset == math.floor(preset) then
		S.View = preset
	elseif not wasOpen then
		S.View = nil
	end
	if S.View and S.View == H.activePreset() then
		S.View = nil
	end
	local pick = tonumber(args.Pick)
	if pick and pick >= 1 and pick <= K.SLOTS and pick == math.floor(pick) then
		S.Pick = math.min(math.floor(pick), #H.keys() + 1)
	elseif not wasOpen then
		S.Pick = nil
	end
	H.layout()
	if type(args.Key) == "string" and State.OwnedCount(args.Key) > 0 then
		S.Selected = args.Key
		S.SheetOpen = S.Mode == "Phone"
	elseif not wasOpen then
		S.SheetOpen = false
	end
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 1
	end
	H.syncBack()
	H.settle()
	H.refresh()
	if not wasOpen then
		SignKit.Rise(U.Pop.Parent) -- (Pitch 2 F0) the kit's open: it rises 12 px in 3 hard steps (no scale bounce)
	end
	if not wasOpen then
		-- the training time ticks while the window is open
		local mine = S.Token
		task.spawn(function()
			while S.Open and S.Token == mine do
				task.wait(K.TICK)
				if S.Open and S.Token == mine and S.Selected and Bits.job(S.Selected) then
					safe("tick", H.refresh)
				end
			end
		end)
		PetsController.Opened:Fire()
		local menu = H.controller("MenuController")
		if menu and menu.WindowOpened then
			menu.WindowOpened:Fire("Pets")
		end
	end
	if args.Action == "Evolve" and type(args.Key) == "string" then
		-- the floating card's EVOLVE! pill: this window on that pet, with the EVOLVE confirm on top
		task.defer(function()
			if S.Open and S.Selected == args.Key then
				H.careOpen("Evolve")
			end
		end)
	end
	return true
end

-- ReturnTo: where the player goes when the window closes (not a silent close)
function H.returnTo(back)
	local arena = (back.Window == "Ring" or back.Window == "Arena") and H.controller("ArenaController") or nil
	if back.Window == "Loss" then
		local loss = H.controller("LossScreen")
		if loss then
			safe("back to loss", loss.Reopen)
		end
	elseif back.Window == "Ring" and arena then
		safe("back to ring", arena.OpenRing, back.Start, back.Portal)
	elseif back.Window == "Arena" and arena then
		safe("back to arena", arena.OpenArena, back.Tab)
	elseif back.Window == "Dungeon" then
		local dungeon = H.controller("DungeonController")
		if dungeon then
			safe("back to dungeon", dungeon.Open, back.Floor, back.Portal)
		end
	end
end

function PetsController.Close(silent)
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	local back = S.ReturnTo
	S.ReturnTo = nil
	S.Pick = nil
	S.SheetOpen = false
	S.View = nil
	S.ClearArmed = 0
	Bits.closeRecall()
	H.syncBack()
	H.coverColumn(nil)
	Util.Tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.13, function()
		if S.Token == mine and not S.Open then
			U.Holder.Visible = false
		end
	end)
	PetsController.Closed:Fire(silent ~= true and back or nil)
	if silent ~= true and back then
		H.returnTo(back)
	end
end

function PetsController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusPets", K.DISPLAY_ORDER)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(U.Gui)
	U.Gui.IgnoreGuiInset = true
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Open then
			safe("relayout", H.layout)
			safe("refresh", H.refresh)
		end
	end)
	State.Changed:Connect(function()
		H.settle()
		safe("refresh", H.refresh)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and S.Open then
			local care = H.controller("CareController")
			if not (care and type(care.IsOpen) == "function" and care.IsOpen()) then
				safe("back", H.back)
			end
		end
	end)
	task.spawn(function()
		local remote = H.remote("Notify")
		if remote then
			remote.OnClientEvent:Connect(function(message, kind)
				safe("notify", H.onNotify, message, kind)
			end)
		end
	end)
end

return PetsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1157">
            <Properties>
              <string name="Name">PortalFxController</string>
              <string name="Source"><![CDATA[-- PortalFxController (client, Phase 6): the gates come alive. Every gate WorldStyle.BuildGate builds (a Model with the
-- attribute GateId: the Gate Court's Obby / Dungeon / Ring / Arena / Altar gates, the arena's Return gate, the Dungeon
-- portal) gets a slow, soft, looping animation on the client only:
--   * Glow (the Neon ring)   a soft light runs round the ring (one lap in RING_PERIOD s, a wide cos^3 bump) on top of
--                            the gate's breath: the Neon colour eases toward white and back, so the ring seems to turn
--   * Swirl (the translucent disc)  breathes: its transparency and lightness swell and settle in a ripple that starts in
--                            the middle and runs outward (the swirl strips are timed by their distance from the centre)
--   * Gem / StarGem          twinkle one after another, left to right, then rest (a smooth bell, never a flash)
--   * GlowCore.GateLight     a soft brightness pulse with the breath
--   * GlowCore.Sparkles      drift gently upward (a small Acceleration while the gate is animated)
-- Rules: no Part is created, moved or resized (collision parts, prompt anchors and the stone / frame / trim voxels that
-- become Blender meshes, ML_Dress, are never touched; a Neon part that MeshLibrary hides for a mesh is skipped); only
-- Color / Transparency of those Neon parts, the light's Brightness and the emitter's Acceleration change, and every one
-- goes back to the value the server built when the gate stops animating. Cheap: ONE Heartbeat connection for all gates,
-- updates at UPDATE_HZ, at most MAX_ACTIVE gates (the nearest within RANGE studs of the camera), colours come from ramps
-- built once per part (no allocation per frame), and a property is written only when its value changes. Low graphics
-- (GraphicsQuality "Low") = static: everything restored, no updates. Streaming: gates are found by GateId as they
-- arrive (workspace.DescendantAdded), parts that stream into a gate later rescan it, removed gates are forgotten.
-- A gate without Swirl parts (spec 16.16: the Storm Altar island's green return ring, StormAltar's ReturnPortal) gets
-- its vortex through PortalVortex's Fixed path: the model carries a BasePart child VortexCenter (the opening's centre,
-- front = -Z) and the attributes VortexRadius, VortexColor and, for a ring a Blender mesh may dress, VortexMeshOffset
-- (a CFrame from VortexCenter to the mesh's opening) + VortexMeshRadius, used while the child VortexMeshChild names
-- (default "Ring") holds an ML_Mesh (MeshLibrary dressed it on this client; the ML_Mesh arriving or leaving rescans
-- the gate). A rescan keeps a fixed vortex whose spot and colour did not change; a moved spot rebuilds it, faded in.
--
--   PortalFxController.Init()        idempotent (Main.client.lua starts it)
--   PortalFxController.Stop()        disconnects everything and restores every gate
--   PortalFxController.Stats() -> { Gates, Active, Parts, Writes, Time, Quality }
--   PortalFxController.Gate(model) -> the record of a tracked gate (tests) | nil
--   PortalFxController.FindGate(id) -> the tracked gate Model whose GateId is `id` | nil (DungeonController's entrance
--                                      rush: no Workspace walk)
--   PortalFxController.K             the tuning numbers (tests read them)
--   PortalFxController.Flare(model, seconds) -> bool   wave 5 (bug #15): the Dungeon entrance: the ring and the light
--                                    flare up and settle over `seconds` (the same properties, restored as always);
--                                    false for an untracked / static gate (Low graphics)
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local PortalFx = {}

local K = {
	RANGE = 150, -- studs from the camera: farther gates stand still
	RANGE_OUT = 165, -- ... an animated gate stops only past this (no flicker at the edge)
	MAX_ACTIVE = 8, -- at most this many gates animate at once (the nearest)
	UPDATE_HZ = 30, -- property updates per second (the motion is slow: 30 Hz reads perfectly smooth)
	REFRESH = 0.5, -- seconds between two passes that pick the active gates, rescan and read the graphics quality
	FADE_IN = 0.8, -- seconds a gate takes to ease into its animation
	STEPS = 32, -- colour ramp steps per part
	-- the breath of the whole gate (swirl, light, the ring's base)
	BREATH_PERIOD = 3.6,
	-- the glow ring: a soft light running round it
	RING_PERIOD = 4.8, -- seconds per lap
	RING_LIFT = 0.5, -- the crest of the running light: this far toward white
	RING_BREATH = 0.1, -- the breath adds up to this much
	RING_POWER = 4, -- the bump's sharpness (cos^p over half the ring)
	-- the swirl: transparency and lightness swell outward from the middle
	SWIRL_AMP = 0.14, -- transparency +- this around the built value
	SWIRL_LIFT = 0.32,
	SWIRL_RIPPLE = 0.32, -- radians of delay per stud from the centre
	-- gems: twinkle in turn
	GEM_PERIOD = 4.2, -- one sweep over all gems, then rest
	GEM_SPACING = 0.32, -- seconds between two gems
	GEM_TWINKLE = 0.9, -- seconds one twinkle lasts
	GEM_LIFT = 0.6,
	-- the light pulse
	LIGHT_AMP = 0.22, -- brightness x (1 +- this)
	-- wave 5 (bug #15): the entrance flare (PortalFx.Flare): the ring toward white, the light brighter, settling
	FLARE_RING = 0.6,
	FLARE_LIGHT = 1.2, -- brightness + LightBase x this at the peak
	-- the sparkles drift upward while the gate is animated
	SPARKLE_RISE = Vector3.new(0, 1.1, 0),
}
PortalFx.K = K

local WHITE = Color3.new(1, 1, 1)
local TWO_PI = math.pi * 2
local GEM_NAMES = { Gem = true, StarGem = true }

local St = {
	Started = false,
	Gates = {}, -- [model] = record
	Count = 0,
	Active = {}, -- array of active records
	Conns = {},
	Time = 0, -- accumulated Heartbeat time (deterministic in tests)
	Acc = 0, -- time since the last property update
	RefreshAcc = 0,
	Quality = "High",
	Writes = 0, -- property writes so far (tests / profiling)
	Quality0 = nil, -- GraphicsQuality module (lazy)
	Vortex0 = nil, -- client/PortalVortex (lazy)
	TextureIds = {}, -- shared/TextureIds: empty = the fallback vortex (effects only)
	Folder = nil, -- workspace.PortalFxLocal: the client-only vortex planes
	Built = 0, -- vortices built so far (tests: built once per gate)
}
PortalFx._St = St

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------

local function smooth01(x)
	if x <= 0 then
		return 0
	elseif x >= 1 then
		return 1
	end
	return x * x * (3 - 2 * x)
end

-- a deterministic phase offset per gate id (gates do not breathe in unison)
local function phaseOf(id)
	local h = 0
	id = tostring(id or "")
	for i = 1, #id do
		h = (h * 31 + string.byte(id, i)) % 100003
	end
	return (h % 1000) / 1000 * TWO_PI
end

local function ramp(base, lift)
	local list = {}
	for i = 0, K.STEPS do
		list[i] = base:Lerp(WHITE, lift * i / K.STEPS)
	end
	return list
end

local function quality()
	if St.Quality0 == nil then
		St.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				St.Quality0 = mod
			end
		end
	end
	if St.Quality0 then
		local ok, mode = pcall(St.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

-- A part MeshLibrary hides for a Blender mesh (inside ML_Mesh, or under an ML_DressKey target that does not keep it)
-- or one that is already invisible is left alone.
local function skipPart(part, model)
	if part.Transparency >= 0.99 then
		return true
	end
	local node = part
	while node and node ~= model.Parent do
		if node.Name == "ML_Mesh" then
			return true
		end
		local key = node:GetAttribute("ML_DressKey")
		if key ~= nil or CollectionService:HasTag(node, "ML_Dress") then
			local keep = tostring(node:GetAttribute("ML_Keep") or "")
			local kept = false
			for name in string.gmatch(keep, "[^,]+") do
				if name == part.Name then
					kept = true
				end
			end
			if not kept then
				return true
			end
		end
		if node == model then
			break
		end
		node = node.Parent
	end
	return false
end

----------------------------------------------------------------------
-- one gate
----------------------------------------------------------------------

-- the Neon ring, gems, light and sparkles back to their built values (the swirl and the vortex are separate)
local function restoreNeon(rec)
	for _, e in ipairs(rec.Ring) do
		if e.Part.Parent then
			e.Part.Color = e.Base
		end
		e.Last = -1
	end
	for _, e in ipairs(rec.Gems) do
		if e.Part.Parent then
			e.Part.Color = e.Base
		end
		e.Last = -1
	end
	if rec.Light and rec.Light.Parent then
		rec.Light.Brightness = rec.LightBase
	end
	rec.LastLight = -1
	if rec.Emitter and rec.Emitter.Parent and rec.EmitterBase ~= nil then
		pcall(function()
			rec.Emitter.Acceleration = rec.EmitterBase
		end)
	end
	rec.Rising = false
end

local function restoreSwirl(rec)
	for _, e in ipairs(rec.Swirl) do
		if e.Part.Parent then
			e.Part.Color = e.Base
			e.Part.Transparency = e.BaseT
		end
		e.Last = -1
		e.LastT = -1
	end
	rec.SwirlLook = nil
end

local function vortexModule()
	if St.Vortex0 == nil then
		St.Vortex0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("PortalVortex")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Build) == "function" then
				St.Vortex0 = mod
			end
		end
	end
	return St.Vortex0 or nil
end

-- everything back to the server's build: the Neon parts, the swirl, and the vortex hidden
local function restore(rec)
	restoreNeon(rec)
	restoreSwirl(rec)
	local V = vortexModule()
	if V and rec.Vortex then
		V.Show(rec.Vortex, false)
	end
	rec.Shown = false
	rec.StaticDone = false
end

local function dropVortex(rec)
	local V = vortexModule()
	if V and rec.Vortex then
		V.Destroy(rec.Vortex)
	end
	rec.Vortex = nil
end

-- spec 16.16: the fixed vortex spot of a gate without Swirl parts (VortexCenter + VortexRadius), or nil. While the
-- gate's mesh child (the attribute VortexMeshChild, default "Ring") is dressed by a Blender mesh on this client (an
-- ML_Mesh under it) the mesh's opening is used instead (VortexCenter x VortexMeshOffset, VortexMeshRadius), so the
-- vortex sits in the ring the player actually sees. An ML_Mesh under any other child (the Pad) does not count.
local function fixedSpot(model)
	local radius = tonumber(model:GetAttribute("VortexRadius"))
	local vc = model:FindFirstChild("VortexCenter")
	if not radius or radius <= 0 or not (vc and vc:IsA("BasePart")) then
		return nil
	end
	local center = vc.CFrame
	local offset, meshR = model:GetAttribute("VortexMeshOffset"), tonumber(model:GetAttribute("VortexMeshRadius"))
	if typeof(offset) == "CFrame" and meshR and meshR > 0 then
		local name = model:GetAttribute("VortexMeshChild")
		name = (type(name) == "string" and name ~= "") and name or "Ring"
		local child = model:FindFirstChild(name)
		if child and child:FindFirstChild("ML_Mesh") then
			return { Center = center * offset, Radius = meshR }
		end
	end
	return { Center = center, Radius = radius }
end

-- two fixed spots (or nils) are the same place and size
local function sameSpot(a, b)
	if a == nil or b == nil then
		return a == b
	end
	return math.abs(a.Radius - b.Radius) < 1e-4 and (a.Center.Position - b.Center.Position).Magnitude < 1e-4
		and a.Center.LookVector:Dot(b.Center.LookVector) > 0.99999 and a.Center.UpVector:Dot(b.Center.UpVector) > 0.99999
end

-- the gate colour: its VortexColor attribute (spec 16.16), else the average of its glow ring (the arch glows violet
-- under gold)
local function gateColor(rec)
	if rec.Color then
		return rec.Color
	end
	local r, g, b, n = 0, 0, 0, 0
	for _, e in ipairs(rec.Ring) do
		r, g, b, n = r + e.Base.R, g + e.Base.G, b + e.Base.B, n + 1
	end
	if n == 0 then
		for _, e in ipairs(rec.Swirl) do
			r, g, b, n = r + e.Base.R, g + e.Base.G, b + e.Base.B, n + 1
		end
	end
	if n == 0 then
		return Color3.fromRGB(150, 120, 255)
	end
	return Color3.new(r / n, g / n, b / n)
end

local function sameColor(a, b)
	return typeof(a) == "Color3" and typeof(b) == "Color3" and math.abs(a.R - b.R) < 1e-4 and math.abs(a.G - b.G) < 1e-4 and math.abs(a.B - b.B) < 1e-4
end

-- (re)collects the animated parts of a gate; the gate is restored first so every base value is the built one
local function scan(rec)
	restore(rec)
	local model = rec.Model
	rec.Ring, rec.Swirl, rec.Gems = {}, {}, {}
	rec.Light, rec.Emitter, rec.EmitterBase = nil, nil, nil
	local core = model:FindFirstChild("GlowCore")
	if core and not core:IsA("BasePart") then
		core = nil
	end
	local origin = core and core.CFrame or nil
	if not origin then
		local ok, pivot = pcall(function()
			return model:GetPivot()
		end)
		origin = ok and pivot or CFrame.new()
		origin = origin * CFrame.new(0, 11.5, 0)
	end
	local prevFixed = rec.Fixed
	rec.Fixed = fixedSpot(model)
	if rec.Fixed then
		origin = rec.Fixed.Center
	end
	local moved = not sameSpot(prevFixed, rec.Fixed)
	if moved then
		rec.Fade = 0 -- review minor: the vortex rebuilt in its new spot (Part ring <-> mesh) fades in, never pops
	end
	rec.Center = origin.Position
	rec.Origin = origin
	local color = model:GetAttribute("VortexColor")
	rec.Color = typeof(color) == "Color3" and color or nil
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and d.Material == Enum.Material.Neon and (d.Name == "Glow" or d.Name == "Swirl" or GEM_NAMES[d.Name]) and not skipPart(d, model) then
			local lp = origin:PointToObjectSpace(d.Position)
			if d.Name == "Glow" then
				local angle = math.atan2(lp.Y, lp.X)
				rec.Ring[#rec.Ring + 1] = { Part = d, Base = d.Color, Ramp = ramp(d.Color, K.RING_LIFT + K.RING_BREATH), Angle = angle, Last = -1 }
			elseif d.Name == "Swirl" then
				local dist = math.sqrt(lp.X * lp.X + lp.Y * lp.Y)
				rec.Swirl[#rec.Swirl + 1] = { Part = d, Base = d.Color, BaseT = d.Transparency, Ramp = ramp(d.Color, K.SWIRL_LIFT), Dist = dist, Last = -1, LastT = -1 }
			else
				rec.Gems[#rec.Gems + 1] = { Part = d, Base = d.Color, Ramp = ramp(d.Color, K.GEM_LIFT), X = lp.X, Y = lp.Y, Last = -1 }
			end
		end
	end
	-- gems twinkle left -> right as seen from the plaza (the gate looks along -Z, so its +X is the viewer's left),
	-- then bottom -> top
	table.sort(rec.Gems, function(a, b)
		if math.abs(a.X - b.X) > 0.25 then
			return a.X > b.X
		end
		return a.Y < b.Y
	end)
	for i, e in ipairs(rec.Gems) do
		e.Index = i
	end
	if core then
		local light = core:FindFirstChild("GateLight")
		if light and light:IsA("Light") then
			rec.Light = light
			rec.LightBase = light.Brightness
		end
		local emitter = core:FindFirstChild("Sparkles")
		if emitter and emitter:IsA("ParticleEmitter") then
			rec.Emitter = emitter
			local ok, accel = pcall(function()
				return emitter.Acceleration
			end)
			rec.EmitterBase = (ok and typeof(accel) == "Vector3") and accel or nil
		end
	end
	-- the vortex is rebuilt on a rescan, except a fixed one whose spot and colour did not change (a dirty storm: the
	-- parts of a mesh dress or of the Part ring streaming in over several refreshes rebuild it once, not per part)
	local v = rec.Vortex
	if not (v and rec.Fixed and not moved and sameColor(v.Color, gateColor(rec))) then
		dropVortex(rec)
	end
	rec.Parts = #rec.Ring + #rec.Swirl + #rec.Gems + (rec.Fixed and 1 or 0) -- the fixed vortex counts (it animates)
	rec.Dirty = false
end

local function forget(model)
	local rec = St.Gates[model]
	if not rec then
		return
	end
	restore(rec)
	dropVortex(rec)
	for _, c in ipairs(rec.Conns) do
		c:Disconnect()
	end
	rec.Conns = {}
	St.Gates[model] = nil
	St.Count = St.Count - 1
	for i = #St.Active, 1, -1 do
		if St.Active[i] == rec then
			table.remove(St.Active, i)
		end
	end
end

local function track(model)
	if St.Gates[model] or not model:IsA("Model") or model:GetAttribute("GateId") == nil then
		return
	end
	local rec = {
		Model = model,
		Id = tostring(model:GetAttribute("GateId")),
		Ring = {}, Swirl = {}, Gems = {},
		Conns = {},
		Dirty = true,
		Fade = 0,
		Shown = false,
		Rising = false,
		LastLight = -1,
	}
	rec.Phase = phaseOf(rec.Id)
	St.Gates[model] = rec
	St.Count = St.Count + 1
	local function dirty(d)
		if d:IsA("BasePart") or d:IsA("Light") or d:IsA("ParticleEmitter") or d.Name == "ML_Mesh" then
			rec.Dirty = true
		end
	end
	rec.Conns[#rec.Conns + 1] = model.DescendantAdded:Connect(dirty)
	rec.Conns[#rec.Conns + 1] = model.DescendantRemoving:Connect(dirty)
	rec.Conns[#rec.Conns + 1] = model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			forget(model)
		end
	end)
	scan(rec)
end

----------------------------------------------------------------------
-- the animation (pure functions of the time; tests read them)
----------------------------------------------------------------------

function PortalFx.Breath(t, phase)
	return 0.5 + 0.5 * math.sin(TWO_PI * t / K.BREATH_PERIOD + (phase or 0))
end

-- 0..1 lift of a ring part at `angle` (radians) at time t
function PortalFx.RingLevel(t, angle, phase)
	local head = TWO_PI * t / K.RING_PERIOD + (phase or 0)
	local c = math.cos(angle - head) -- runs clockwise as seen from the plaza
	local bump = c > 0 and c ^ K.RING_POWER or 0
	local total = K.RING_LIFT + K.RING_BREATH
	return (K.RING_LIFT * bump + K.RING_BREATH * PortalFx.Breath(t, phase)) / total
end

-- 0..1 swell of a swirl strip `dist` studs from the centre
function PortalFx.SwirlLevel(t, dist, phase)
	return 0.5 + 0.5 * math.sin(TWO_PI * t / K.BREATH_PERIOD + (phase or 0) - K.SWIRL_RIPPLE * (dist or 0))
end

-- 0..1 twinkle of gem `index` (1-based) of `count`
function PortalFx.GemLevel(t, index, count, phase)
	local period = math.max(K.GEM_PERIOD, (count or 1) * K.GEM_SPACING + K.GEM_TWINKLE)
	local local_t = (t + (phase or 0) / TWO_PI * period) % period
	local start = ((index or 1) - 1) * K.GEM_SPACING
	local x = (local_t - start) / K.GEM_TWINKLE
	if x <= 0 or x >= 1 then
		return 0
	end
	local s = math.sin(math.pi * x)
	return smooth01(s * s)
end

local function setColor(e, level, fade)
	local i = math.floor(level * fade * K.STEPS + 0.5)
	if i < 0 then
		i = 0
	elseif i > K.STEPS then
		i = K.STEPS
	end
	if i ~= e.Last then
		e.Last = i
		e.Part.Color = e.Ramp[i]
		St.Writes = St.Writes + 1
	end
end

local NONE = {}

-- the old swirl's look while the vortex shows (written once)
local function applySwirlLook(rec, V)
	if rec.SwirlLook then
		return
	end
	local look = V.SwirlLook(rec.Vortex)
	rec.SwirlLook = look
	for _, e in ipairs(rec.Swirl) do
		if e.Part.Parent then
			e.Part.Color = look.Color
			e.Part.Transparency = look.Transparency
			St.Writes = St.Writes + 2
		end
		e.Last = -1
		e.LastT = -1
	end
end

local function localFolder()
	local f = St.Folder
	if f and f.Parent then
		return f
	end
	f = Instance.new("Folder")
	f.Name = "PortalFxLocal" -- client-only: created here, never replicated
	f.Parent = Workspace
	St.Folder = f
	return f
end

-- the vortex of a gate, built once (lazily, when it first animates) and shown
local function ensureVortex(rec)
	local V = vortexModule()
	if not V or (#rec.Swirl == 0 and not rec.Fixed) then
		return nil
	end
	if not rec.Vortex then
		local ok, v = pcall(V.Build, rec, localFolder(), St.TextureIds, gateColor(rec), math.floor(rec.Phase * 100000) + 7)
		if not ok then
			warn("[PortalFxController] vortex for " .. rec.Id .. ": " .. tostring(v))
			rec.Swirl = rec.Swirl -- keep the plain animation
			return nil
		end
		rec.Vortex = v
		St.Built = St.Built + 1
	end
	V.SetStatic(rec.Vortex, St.Quality == "Low")
	V.Show(rec.Vortex, true)
	return rec.Vortex
end

local function animate(rec, t)
	local fade = smooth01(rec.Fade)
	local phase = rec.Phase
	local flare = 0
	if rec.FlareAt then
		local p = (os.clock() - rec.FlareAt) / rec.FlareDur
		if p >= 1 or p < 0 then
			rec.FlareAt = nil
		else
			flare = 1 - p
		end
	end
	for _, e in ipairs(rec.Ring) do
		setColor(e, math.min(1, PortalFx.RingLevel(t, e.Angle, phase) + K.FLARE_RING * flare), fade)
	end
	local V = rec.Vortex and vortexModule()
	if V and rec.Vortex.Shown then
		applySwirlLook(rec, V)
		St.Writes = St.Writes + V.Animate(rec.Vortex, t, fade, PortalFx.Breath(t, phase), false)
	end
	for _, e in ipairs((V and rec.Vortex.Shown) and NONE or rec.Swirl) do
		local level = PortalFx.SwirlLevel(t, e.Dist, phase)
		setColor(e, level, fade)
		-- more solid at the swell, clearer between (quantised to 0.01 so a write happens only on a change)
		local tr = e.BaseT + K.SWIRL_AMP * fade * (1 - 2 * level)
		tr = math.floor(tr * 100 + 0.5) / 100
		if tr ~= e.LastT then
			e.LastT = tr
			e.Part.Transparency = tr
			St.Writes = St.Writes + 1
		end
	end
	local n = #rec.Gems
	for _, e in ipairs(rec.Gems) do
		setColor(e, PortalFx.GemLevel(t, e.Index, n, phase), fade)
	end
	if rec.Light then
		local b = rec.LightBase * (1 + K.LIGHT_AMP * fade * (2 * PortalFx.Breath(t, phase) - 1) + K.FLARE_LIGHT * flare)
		b = math.floor(b * 200 + 0.5) / 200
		if b ~= rec.LastLight then
			rec.LastLight = b
			rec.Light.Brightness = b
			St.Writes = St.Writes + 1
		end
	end
	if rec.Emitter and rec.EmitterBase ~= nil and not rec.Rising then
		rec.Rising = true
		pcall(function()
			rec.Emitter.Acceleration = K.SPARKLE_RISE
		end)
	end
	rec.Shown = true
end

----------------------------------------------------------------------
-- the loop
----------------------------------------------------------------------

local function viewPoint()
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position
	end
	return nil
end

-- picks the active gates (nearest first, within range, at most MAX_ACTIVE), rescans dirty ones, reads the quality
local function refresh()
	St.Quality = quality()
	local eye = viewPoint()
	local wanted = {}
	for model, rec in pairs(St.Gates) do
		if model.Parent == nil or not model:IsDescendantOf(Workspace) then
			forget(model)
		else
			if rec.Dirty then
				scan(rec)
			end
			local d = math.huge
			if eye and rec.Center then
				d = (rec.Center - eye).Magnitude
			end
			rec.Dist = d
			local limit = rec.On and K.RANGE_OUT or K.RANGE
			if d <= limit and rec.Parts > 0 then
				wanted[#wanted + 1] = rec
			end
		end
	end
	table.sort(wanted, function(a, b)
		return a.Dist < b.Dist
	end)
	local keep = {}
	for i = 1, math.min(#wanted, K.MAX_ACTIVE) do
		keep[wanted[i]] = true
	end
	for _, rec in pairs(St.Gates) do
		if keep[rec] then
			if not rec.On then
				rec.On = true
				rec.Fade = 0
			end
			local low = St.Quality == "Low"
			if low ~= rec.Low then
				rec.Low = low
				rec.StaticDone = false
				restoreNeon(rec) -- Low: the ring, gems and light hold their built values
				rec.SwirlLook = nil
			end
			ensureVortex(rec)
		elseif rec.On then
			rec.On = false
			rec.Fade = 0
			restore(rec)
		end
	end
	local active = {}
	for i = 1, math.min(#wanted, K.MAX_ACTIVE) do
		active[i] = wanted[i]
	end
	St.Active = active
end

function PortalFx.Step(dt)
	dt = tonumber(dt) or 0
	if dt <= 0 then
		return
	end
	St.Time = St.Time + dt
	St.RefreshAcc = St.RefreshAcc + dt
	if St.RefreshAcc >= K.REFRESH then
		St.RefreshAcc = 0
		refresh()
	end
	St.Acc = St.Acc + dt
	if St.Acc < 1 / K.UPDATE_HZ then
		return
	end
	local step = St.Acc
	St.Acc = 0
	for _, rec in ipairs(St.Active) do
		if rec.On and rec.Model.Parent then
			if rec.Low then
				-- Low graphics: a still vortex (posed once), no other motion
				if not rec.StaticDone then
					rec.StaticDone = true
					local V = rec.Vortex and vortexModule()
					if V then
						applySwirlLook(rec, V)
						St.Writes = St.Writes + V.Animate(rec.Vortex, 0, 1, 0.5, true)
					end
				end
			else
				rec.Fade = math.min(1, rec.Fade + step / K.FADE_IN)
				animate(rec, St.Time)
			end
		end
	end
end

function PortalFx.Stats()
	local parts = 0
	for _, rec in pairs(St.Gates) do
		parts = parts + (rec.Parts or 0)
	end
	local shown, mode = 0, nil
	for _, rec in pairs(St.Gates) do
		if rec.Vortex and rec.Vortex.Shown then
			shown = shown + 1
			mode = rec.Vortex.Mode
		end
	end
	return { Gates = St.Count, Active = #St.Active, Parts = parts, Writes = St.Writes, Time = St.Time, Quality = St.Quality,
		Vortices = shown, VortexMode = mode, Built = St.Built }
end

function PortalFx.Gate(model)
	return St.Gates[model]
end

function PortalFx.FindGate(id)
	id = tostring(id)
	for model, rec in pairs(St.Gates) do
		if rec.Id == id and model.Parent then
			return model
		end
	end
	return nil
end

-- wave 5 (bug #15): the gate flares up (the Dungeon entrance's rush); a static gate (Low, out of range) does nothing
function PortalFx.Flare(model, seconds)
	local rec = St.Gates[model]
	if not rec or St.Quality == "Low" or not rec.On then
		return false
	end
	rec.FlareAt = os.clock()
	rec.FlareDur = (type(seconds) == "number" and seconds > 0) and math.min(seconds, 3) or 0.6
	return true
end

function PortalFx.Stop()
	for _, c in ipairs(St.Conns) do
		c:Disconnect()
	end
	St.Conns = {}
	local models = {}
	for model in pairs(St.Gates) do
		models[#models + 1] = model
	end
	for _, model in ipairs(models) do
		forget(model)
	end
	St.Active = {}
	St.Started = false
	if St.Folder then
		St.Folder:Destroy()
		St.Folder = nil
	end
end

-- the vortex texture ids (shared/TextureIds; tests pass fake ones): every vortex is rebuilt in the new mode
function PortalFx.SetTextureIds(ids)
	St.TextureIds = type(ids) == "table" and ids or {}
	for _, rec in pairs(St.Gates) do
		restoreSwirl(rec)
		dropVortex(rec)
	end
	St.RefreshAcc = K.REFRESH
end

function PortalFx.Init()
	if St.Started then
		return
	end
	St.Started = true
	local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
	local idsModule = shared and shared:FindFirstChild("TextureIds")
	if idsModule then
		local ok, ids = pcall(require, idsModule)
		St.TextureIds = (ok and type(ids) == "table") and ids or {}
	end
	St.Conns[#St.Conns + 1] = Workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("GateId") ~= nil then
			track(inst)
		end
	end)
	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Model") and inst:GetAttribute("GateId") ~= nil then
			track(inst)
		end
	end
	St.Conns[#St.Conns + 1] = RunService.Heartbeat:Connect(PortalFx.Step)
	refresh()
end

return PortalFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1158">
            <Properties>
              <string name="Name">PromptController</string>
              <string name="Source"><![CDATA[-- PromptController (client): Pitch 2 item 04_world_ui, the owner's pick B "Stone tags" (docs/superpowers/specs/
-- 2026-11-20-pitch2-build-design.md; mock-up .superpowers/slop-audit/round3/build/PITCH2/D_world/04_world_ui_optB.png,
-- pitch_04_world_ui.py prompt "B"). Roblox's default ProximityPrompt (the grey rounded pill) was the last old-kit piece
-- in the world: every prompt in the workspace is set to Style Custom here (the engine still handles its key, range and
-- line of sight) and draws the kit's plank instead, a BillboardGui "PromptCard" in the PlayerGui on the prompt's part:
--   Tab    the wood tab (2 px dark wood edge, 3 px lip, its lit line) naming the object ("Storm Altar"), 18 px stone ink,
--          peeking over the plank's top-left; none when the prompt has no ObjectText
--   Plank  the Tile plank (3 px wood edge, 5 px lip in the stone lip): a TextButton, so a tap or a click holds the prompt
--          (prompt:InputHoldBegin / InputHoldEnd, as the default prompt's ClickablePrompt did)
--   Hit    (look review r0: the plank is 50 design px, 40 screen px under a phone's 0.8) a clear TextButton over the whole
--          plank, its edges included, at least K.TOUCH screen px tall (HitFor "Plank"): the thumb's target; same input
--   Key    the navy key block (2 px wood edge, 3 px lip) with the key in stone ink: E (its KeyboardKeyCode), X on a pad,
--          TAP on a touch screen
--   Action the ActionText ("Secret Roll") at 26 px in the kit's brown ink
--   Hold   a prompt with a HoldDuration fills the plank's lip in grass while it is held (a tween: no Lua per frame)
-- Sizes are 1080p design px under a UIScale (Theme.ScreenFactor). One card a shown prompt; it goes when the prompt hides,
-- is disabled or leaves. A text change while shown redraws it. Plain Lua 5.1-compatible syntax only.
--   PromptController.Init()                    idempotent
--   PromptController.CardOf(prompt) -> BillboardGui | nil
--   PromptController.Custom(prompt)            sets one prompt's Style (the watch calls it for every new prompt)
-- Init also starts WorldTag.WatchFit (look review r1, M4): the server's wide pixel boards marked with WorldTag.MarkFit
-- (the Storm Altar's header, the gates' boards) are fitted to each screen.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local CloudUI = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("CloudUI"))

local Sign = Theme.Sign

local PromptController = {}

local K = {
	NAME = "PromptCard",
	TAB_H = 28, -- the tab, its 2 px edge included
	TAB_X = 10,
	TAB_PAD = 10, -- px each side of the object name
	TAB_EDGE = 2,
	TAB_LIP = 3,
	TAB_OVER = 3, -- px of the tab behind the plank's top edge
	PLANK_H = 56, -- the plank, its 3 px edge included
	PLANK_EDGE = 3,
	PLANK_LIP = 5,
	KEY = 34, -- the key block, its 2 px edge included
	KEY_X = 10, -- px from the plank's face to the key
	KEY_EDGE = 2,
	KEY_LIP = 3,
	KEY_PX = 20,
	TAP_PX = 18, -- (look review r0) 16 drew 12.8 px under a phone's 0.8: 18 keeps TAP at 14.4 (Theme.Readability.MinPx 14)
	TOUCH = 44, -- (look review r0) screen px: the clear Hit button over the plank is at least this tall at any scale
	GAP = 12, -- the key to the action
	RIGHT = 18, -- px after the action
	ACTION_PX = 26,
	OBJECT_PX = 18,
	MAX_DISTANCE = 100,
	MAX_LIFT = 12, -- studs: the most a prompt's CardLift floats its plank
}
PromptController.K = K

local S = { started = false, cards = {}, conns = {} }
PromptController._S = S

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function pg()
	local player = Players.LocalPlayer
	return player and player:FindFirstChildOfClass("PlayerGui")
end

function PromptController.Custom(prompt)
	if typeof(prompt) == "Instance" and prompt:IsA("ProximityPrompt") and prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		pcall(function()
			prompt.Style = Enum.ProximityPromptStyle.Custom
		end)
	end
end

local function adorneeOf(prompt)
	local p = prompt.Parent
	if p and (p:IsA("BasePart") or p:IsA("Attachment")) then
		return p
	end
	if p and p:IsA("Model") then
		return p.PrimaryPart or p:FindFirstChildWhichIsA("BasePart", true)
	end
	return nil
end

local function keyText(prompt, inputType)
	if inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP", K.TAP_PX
	elseif inputType == Enum.ProximityPromptInputType.Gamepad then
		local code = prompt.GamepadKeyCode
		local name = (typeof(code) == "EnumItem" and code.Name) or "ButtonX"
		return (name:gsub("^Button", "")), K.KEY_PX
	end
	local code = prompt.KeyboardKeyCode
	local name = (typeof(code) == "EnumItem" and code.Name) or "E"
	return name, K.KEY_PX
end

local function width(text, role, px)
	return math.ceil(Theme.Measure(text, role, px).X)
end

local function drop(prompt)
	local rec = S.cards[prompt]
	S.cards[prompt] = nil
	if rec then
		for _, c in ipairs(rec.conns) do
			c:Disconnect()
		end
		if rec.tween then
			pcall(rec.tween.Cancel, rec.tween)
		end
		if rec.holding then
			pcall(function()
				prompt:InputHoldEnd()
			end)
		end
		rec.gui:Destroy()
	end
end

local function build(prompt, inputType)
	drop(prompt)
	local parent = pg()
	local adornee = adorneeOf(prompt)
	if not parent or not adornee then
		return nil
	end
	local action = tostring(prompt.ActionText or "")
	local object = tostring(prompt.ObjectText or "")
	local key, keyPx = keyText(prompt, inputType)
	local keyW = math.max(K.KEY, width(key, "Button", keyPx) + 12)
	local actionW = width(action, "Heading", K.ACTION_PX)
	local tabW = (object ~= "") and (width(object, "Heading", K.OBJECT_PX) + 2 * K.TAB_PAD) or 0
	local W = math.max(K.PLANK_EDGE + K.KEY_X + keyW + K.GAP + actionW + K.RIGHT + K.PLANK_EDGE, tabW + 2 * K.TAB_X)
	local plankY = (tabW > 0) and (K.TAB_H - K.TAB_OVER) or 0
	local H = plankY + K.PLANK_H
	local scale = 1
	pcall(function()
		scale = Theme.ScreenFactor()
	end)

	-- (look review r1, M2) a prompt's CardLift attribute (studs, 0..K.MAX_LIFT; GateService's gate prompts) floats the plank
	-- that far over its anchor
	local lift = tonumber(prompt:GetAttribute("CardLift")) or 0
	lift = (lift == lift) and math.clamp(lift, 0, K.MAX_LIFT) or 0
	local gui = make("BillboardGui", {
		Name = K.NAME,
		Adornee = adornee,
		StudsOffsetWorldSpace = Vector3.new(0, lift, 0),
		Size = UDim2.fromOffset(math.ceil(W * scale), math.ceil(H * scale)),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.MAX_DISTANCE,
		ResetOnSpawn = false,
		Active = true,
		ClipsDescendants = false,
	})
	gui:SetAttribute("Prompt", prompt:GetFullName())
	local root = make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromOffset(W, H) }, gui)
	make("UIScale", { Name = "ReadScale", Scale = scale }, root)

	if tabW > 0 then
		local e = K.TAB_EDGE
		local tab = make("Frame", {
			Name = "Tab",
			Position = UDim2.fromOffset(K.TAB_X + e, e),
			Size = UDim2.fromOffset(tabW - 2 * e, K.TAB_H - 2 * e),
			ZIndex = 1,
		}, root)
		CloudUI.SignBlock(tab, "Stone", { Face = Sign.Wood, Edge = Sign.WoodDark, Lip = Sign.WoodDark, EdgePx = e, LipPx = K.TAB_LIP, Pad = false, Finish = "Lean" })
		local t = Theme.Label(object, "Heading", { Size = K.OBJECT_PX, Color = Sign.Stone })
		t.Name = "Object"
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 1, -K.TAB_LIP)
		t.TextXAlignment = Enum.TextXAlignment.Center
		t.ZIndex = 2
		t.Parent = tab
	end

	local pe = K.PLANK_EDGE
	local plank = make("TextButton", {
		Name = "Plank",
		Text = "",
		AutoButtonColor = false,
		Position = UDim2.fromOffset(pe, plankY + pe),
		Size = UDim2.fromOffset(W - 2 * pe, K.PLANK_H - 2 * pe),
		ZIndex = 3,
		Active = true,
		Selectable = false,
	}, root)
	CloudUI.SignBlock(plank, "Stone", { Face = Sign.Tile, Edge = Sign.Wood, Lip = Sign.StoneLip, EdgePx = pe, LipPx = K.PLANK_LIP, Pad = false, Finish = "Lean" })
	local faceH = K.PLANK_H - 2 * pe - K.PLANK_LIP

	local ke = K.KEY_EDGE
	local keyBlock = make("Frame", {
		Name = "Key",
		Position = UDim2.fromOffset(K.KEY_X + ke, math.floor((faceH - K.KEY) / 2) + ke),
		Size = UDim2.fromOffset(keyW - 2 * ke, K.KEY - 2 * ke),
		ZIndex = 4,
	}, plank)
	CloudUI.SignBlock(keyBlock, "Navy", { Face = Sign.Navy, Edge = Sign.Wood, Lip = Sign.NavyLip, EdgePx = ke, LipPx = K.KEY_LIP, Pad = false, Finish = false })
	local kt = Theme.Label(key, "Button", { Size = keyPx, Color = Sign.Stone })
	kt.Name = "KeyText"
	kt.BackgroundTransparency = 1
	kt.Size = UDim2.new(1, 0, 1, -K.KEY_LIP)
	kt.TextXAlignment = Enum.TextXAlignment.Center
	kt.ZIndex = 5
	kt.Parent = keyBlock

	local ax = K.KEY_X + keyW + K.GAP
	local at = Theme.Label(action, "Heading", { Size = K.ACTION_PX, Color = Sign.Text })
	at.Name = "Action"
	at.BackgroundTransparency = 1
	at.Position = UDim2.fromOffset(ax, 0)
	at.Size = UDim2.new(1, -ax, 0, faceH)
	at.TextXAlignment = Enum.TextXAlignment.Left
	at.ZIndex = 4
	at.Parent = plank

	-- the hold: the lip fills in grass over HoldDuration
	local hold = make("Frame", {
		Name = "Hold",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(0, 0, 0, K.PLANK_LIP),
		BackgroundColor3 = Sign.Grass,
		BorderSizePixel = 0,
		ZIndex = 5,
	}, plank)

	-- the thumb's target: the whole plank with its edges, never under K.TOUCH screen px tall (centred on the plank)
	local hitH = math.max(K.PLANK_H, math.ceil(K.TOUCH / math.max(scale, 0.01)))
	local hitBtn = make("TextButton", {
		Name = "Hit",
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, plankY + math.floor((K.PLANK_H - hitH) / 2)),
		Size = UDim2.fromOffset(W, hitH),
		ZIndex = 6,
		Active = true,
		Selectable = false,
	}, root)
	hitBtn:SetAttribute("HitFor", "Plank")

	local rec = { gui = gui, conns = {}, prompt = prompt, input = inputType, holding = false }
	local function holdBegin()
		if rec.holding then
			return
		end
		rec.holding = true
		pcall(function()
			prompt:InputHoldBegin()
		end)
	end
	local function holdEnd()
		if not rec.holding then
			return
		end
		rec.holding = false
		pcall(function()
			prompt:InputHoldEnd()
		end)
	end
	local function onInput(io)
		local t = io.UserInputType
		return t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1
	end
	for _, button in ipairs({ plank, hitBtn }) do
		rec.conns[#rec.conns + 1] = button.InputBegan:Connect(function(io)
			if onInput(io) and prompt.ClickablePrompt ~= false then
				holdBegin()
			end
		end)
		rec.conns[#rec.conns + 1] = button.InputEnded:Connect(function(io)
			if onInput(io) then
				holdEnd()
			end
		end)
	end
	rec.conns[#rec.conns + 1] = prompt.PromptButtonHoldBegan:Connect(function()
		local d = tonumber(prompt.HoldDuration) or 0
		if d > 0 then
			hold.Size = UDim2.new(0, 0, 0, K.PLANK_LIP)
			local ok, tween = pcall(function()
				return TweenService:Create(hold, TweenInfo.new(d, Enum.EasingStyle.Linear), { Size = UDim2.new(1, 0, 0, K.PLANK_LIP) })
			end)
			if ok and tween then
				rec.tween = tween
				pcall(tween.Play, tween)
			end
		end
	end)
	rec.conns[#rec.conns + 1] = prompt.PromptButtonHoldEnded:Connect(function()
		if rec.tween then
			pcall(rec.tween.Cancel, rec.tween)
			rec.tween = nil
		end
		hold.Size = UDim2.new(0, 0, 0, K.PLANK_LIP)
	end)
	for _, prop in ipairs({ "ActionText", "ObjectText" }) do
		rec.conns[#rec.conns + 1] = prompt:GetPropertyChangedSignal(prop):Connect(function()
			if S.cards[prompt] == rec then
				task.defer(function()
					if S.cards[prompt] == rec then
						build(prompt, rec.input)
					end
				end)
			end
		end)
	end
	rec.conns[#rec.conns + 1] = prompt.AncestryChanged:Connect(function(_, newParent)
		if newParent == nil or not prompt:IsDescendantOf(workspace) then
			drop(prompt)
		end
	end)
	gui.Parent = parent
	S.cards[prompt] = rec
	return gui
end

function PromptController.CardOf(prompt)
	local rec = S.cards[prompt]
	return rec and rec.gui or nil
end

function PromptController.Init()
	if S.started then
		return
	end
	S.started = true
	-- (look review r1, M4) the world's wide pixel boards (the Storm Altar's header, the gates' boards) fit each screen
	local okW, WorldTag = pcall(require, Shared:WaitForChild("WorldTag"))
	if okW and type(WorldTag) == "table" and type(WorldTag.WatchFit) == "function" then
		local okF, why = pcall(WorldTag.WatchFit)
		if not okF then
			warn("[PromptController] the world boards' fit failed: " .. tostring(why))
		end
	end
	for _, d in ipairs(workspace:GetDescendants()) do
		if d.ClassName == "ProximityPrompt" then
			PromptController.Custom(d)
		end
	end
	S.conns[#S.conns + 1] = workspace.DescendantAdded:Connect(function(d)
		if d.ClassName == "ProximityPrompt" then
			PromptController.Custom(d)
		end
	end)
	local pps = game:GetService("ProximityPromptService")
	S.conns[#S.conns + 1] = pps.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style == Enum.ProximityPromptStyle.Custom then
			local ok, err = pcall(build, prompt, inputType)
			if not ok then
				warn("[PromptController] the plank failed: " .. tostring(err))
			end
		end
	end)
	S.conns[#S.conns + 1] = pps.PromptHidden:Connect(function(prompt)
		drop(prompt)
	end)
end

return PromptController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1159">
            <Properties>
              <string name="Name">RaidGateController</string>
              <string name="Source"><![CDATA[-- RaidGateController (client, boss raids; docs/superpowers/specs/2026-11-01-raid-boss-design.md): what a player sees of the raid boss
-- outside a fight. Nothing here decides anything: walking through the gate is the server's poll (BattleService), a dare is a
-- BattleRequest the server checks again.
--
--   RaidGateController.Init()
--   RaidGateController.OpenDare(prompt|nil) -> bool   the dare panel (the gate pillar's DarePrompt, OpenPanel = "Dare": ArenaController routes it)
--   RaidGateController.Close()
--   RaidGateController.IsOpen() -> bool
--   RaidGateController.Refresh()                      the idle boss and the tag, now
--   RaidGateController.Stop()                         tests: everything built here goes, the connections drop, Init starts it again
--   RaidGateController.Tier() -> tier                 my fight tier (BattleCatalog.RaidTiers row): the highest pet on the active team
--   RaidGateController.RewardLine() -> text           "Rewards ready" | "Rewards again in M:SS" (the saved Battle.RaidRewardAt)
--   RaidGateController.Opened / Closed (Util.Signal)
--
-- What the player sees
--   * The idle boss: workspace.ClientRaidGate.Boss_<id>, built here for this client alone at the centre of the colosseum floor (the
--     NC_BattleZone part with Mode "Raid" and ZoneId "Arena"), facing the lobby, in the colours and size of MY tier, while the
--     player is within K.RANGE studs and no fight has the floor (ArenaState.Raid: Active false, FloorHiddenIn 0). A floor fight's
--     "Start" takes it away at once, and it comes back only when BattleController has stopped drawing that fight (the end's linger: the
--     server says Active false at the end). Its head follows the player (at most 30 Hz, turning at K.TURN_SPEED rad/s). Graphics Low:
--     the Low model, no aura, it stands still.
--   * The gate tag: one pixel-sized BillboardGui RaidGateTag on the gate's crest (tag NC_RaidGateCrest, else the RaidGate part):
--     "<Boss> - your tier: <Tier> (L<n> boss)", the reward line, "<Tier> boss back in N s" while my tier's fight is closed, else "Walk
--     through to fight". Refreshed every second from the last ArenaState; hidden while the player fights.
--   * (kit-b U9-7: the tag is a stone notice nailed up, the panel a Signboard window with stone tiers and red Dare blocks)
--   * The dare panel: a NeonKit side panel (docked right on landscape screens, a bottom sheet on portrait phones) with one row per
--     tier above mine, "<Tier> - boss L<n>, hits x<h>, rewards x<r>" and a Dare button. One side panel at a time; Esc / gamepad B / the
--     red X / walking away from the pillar / my fight's Start close it. Dare with an empty team leads to the Pets window (TeamFaces.Ensure).
-- Remotes: ArenaState (in), BattleState ("Start" in); the dare goes out through ArenaController.Request. Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-7) the tag's nails

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local TeamFaces = require(UI:WaitForChild("TeamFaces"))
local State = require(Client:WaitForChild("State"))

local RaidGateController = {}
RaidGateController.Opened = Util.Signal()
RaidGateController.Closed = Util.Signal()

local K = {
	DISPLAY_ORDER = 23,
	PREF_W = 560, -- design px of the dare panel
	PREF_H = 500, -- (U9-7 look) the most it takes: H.fitDock sizes the panel to its rows (a fixed 500 left a third blank)
	INTRO_H = 30,
	ROW_H = 78, -- (U9-7 look) two lines: the tier's steps and chip, then its facts
	STEP = 8, -- (U9-7 look) a step of the tier's stair: 8 px wide, 6 px higher than the one before
	GAP = 8,
	BUTTON_W = 96, -- (U9-7 look) was 120: on a landscape phone the three fact tags ran under the Dare block
	BUTTON_H = 56, -- >= 44 px under the 0.8 touch scale
	TICK = 0.25, -- seconds between two looks at the state (the idle boss, the walk-away)
	TAG_EVERY = 1, -- seconds between two tag refreshes
	ANIM_GAP = 1 / 30, -- the idle boss moves at most at 30 Hz
	RANGE = 400, -- studs from the floor's centre within which the idle boss stands
	TURN_SPEED = 2, -- rad/s: how fast its head comes round
	YAW_MAX = 1, -- rad: BossBuilder's own limit
	LOOK_AHEAD = 100, -- studs: the point Animate's LookAt gets
	WALK_AWAY = 24, -- studs from the pillar that close a panel opened there (the server takes a dare within 20 of the gate)
	TAG_W = 380, -- px: fits a portrait phone; a long first line wraps
	TAG_H = 122,
	TAG_DISTANCE = 120,
	TAG_OFFSET = 5,
	BACK_ACTION = "NimbusRaidDareBack",
}

-- (kit-b U9-7) the Signboard palette (the Arena's): brown ink on stone, the muted brown for the intro, raised stone tiles
-- for the tiers; the gate's tag is a stone notice nailed up over the gate, its reward clock in the burnt orange that reads
-- 4.5:1 on stone
local SIGN = Theme.Sign
local INK = SIGN.Text
local C = {
	Muted = SIGN.TextMuted,
	Reward = Color3.fromRGB(148, 86, 10), -- #94560A
}

local LocalPlayer = nil
local initialized = false
local U = {} -- gui references
local S = {
	Open = false,
	Token = 0,
	At = nil, -- the pillar when the panel was opened there
	BackBound = false,
	Arena = nil, -- last ArenaState
	ArenaAt = 0, -- os.clock() when it arrived
	Tier = nil, -- my tier (cached until the next ProfileSync)
	Model = nil, -- the idle boss
	ModelKey = nil, -- "<boss>|<tier>|<detail>": another key builds it again (the size follows the tier)
	ModelCF = nil,
	Yaw = 0, -- its head's yaw now
	AnimAt = 0,
	TickAt = 0,
	TagAt = 0,
	Conns = {},
	Failed = {}, -- [key] = true: a boss that would not build is not tried again every tick
	Warned = {},
}
local Mods = { Catalog = nil, Boss = nil, Gfx = nil } -- lazy modules (false = unavailable)
local H = {}

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
function H.safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not S.Warned[key] then
		S.Warned[key] = true
		warn("[RaidGateController] " .. key .. ": " .. tostring(err))
	end
	return ok
end

function H.lazy(key, parent, name)
	if Mods[key] == nil then
		local module = parent:FindFirstChild(name)
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		Mods[key] = (ok and type(result) == "table") and result or false
	end
	return Mods[key] or nil
end

function H.catalog()
	return H.lazy("Catalog", Shared, "BattleCatalog")
end

function H.bossBuilder()
	return H.lazy("Boss", Shared, "BossBuilder")
end

function H.low()
	local gq = H.lazy("Gfx", Client, "GraphicsQuality")
	if gq and type(gq.Effective) == "function" then
		local ok, mode = pcall(gq.Effective)
		return ok and mode == "Low"
	end
	return false
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	return (ok and type(mod) == "table") and mod or nil
end

function H.clock(seconds)
	local s = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

function H.text(parent, name, text, role, size, color, props)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = tostring(text or "")
	-- kit-b U6: the window is a plate, so the text reads by contrast (no outline)
	Theme.Style(label, role or "Body", { Size = size, Color = color or INK })
	label.TextYAlignment = Enum.TextYAlignment.Center
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

function H.rootPosition()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
	return root and root.Position or nil
end

function H.fighting()
	local id = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InBattle)
	return type(id) == "string" and id ~= ""
end

-- ArenaState.Raid, as far as it can be read (the server's GetRaidStatus + the rotation)
function H.raid()
	local raid = type(S.Arena) == "table" and S.Arena.Raid or nil
	if type(raid) == "table" and type(raid.BossId) == "string" then
		return raid
	end
	return nil
end

-- seconds left of a countdown of the last ArenaState (they tick here between two states)
function H.left(value)
	local n = tonumber(value)
	if not n then
		return 0
	end
	return math.max(0, n - (os.clock() - S.ArenaAt))
end

function H.bossName(raid)
	local BC = H.catalog()
	local boss = BC and type(BC.Bosses) == "table" and BC.Bosses[raid.BossId]
	return tostring(raid.Name or (type(boss) == "table" and boss.Name) or "The boss")
end

----------------------------------------------------------------------
-- my tier, my reward clock
----------------------------------------------------------------------
function RaidGateController.Tier()
	if not S.Tier then
		local BC = H.catalog()
		if not BC or type(BC.RaidTierOfTeam) ~= "function" then
			return nil
		end
		S.Tier = BC.RaidTierOfTeam(TeamFaces.Entries())
	end
	return S.Tier
end

function RaidGateController.RewardLine()
	local BC = H.catalog()
	local ok, battle = pcall(State.Battle)
	local stamp = ok and type(battle) == "table" and tonumber(battle.RaidRewardAt) or 0
	local minutes = BC and type(BC.Raid) == "table" and tonumber(BC.Raid.RewardMinutes) or 20
	local left = stamp + minutes * 60 - os.time()
	if stamp <= 0 or left <= 0 then
		return "Rewards ready"
	end
	return "Rewards again in " .. H.clock(left)
end

----------------------------------------------------------------------
-- the world
----------------------------------------------------------------------
function H.floorZone()
	if U.Floor and U.Floor:IsDescendantOf(Workspace) then
		return U.Floor
	end
	U.Floor = nil
	for _, part in ipairs(CollectionService:GetTagged("NC_BattleZone")) do
		if part:GetAttribute("Mode") == "Raid" and part:GetAttribute("ZoneId") == "Arena" then
			U.Floor = part
			break
		end
	end
	return U.Floor
end

function H.tagAdornee()
	for _, tag in ipairs({ "NC_RaidGateCrest", "NC_RaidGate" }) do
		local part = CollectionService:GetTagged(tag)[1]
		if part then
			return part
		end
	end
	return nil
end

function H.folder()
	if not (U.Folder and U.Folder.Parent) then
		U.Folder = Instance.new("Folder")
		U.Folder.Name = "ClientRaidGate"
		U.Folder.Parent = Workspace
	end
	return U.Folder
end

----------------------------------------------------------------------
-- the idle boss
----------------------------------------------------------------------
function H.dropModel()
	if S.Model then
		pcall(S.Model.Destroy, S.Model)
	end
	S.Model, S.ModelKey, S.ModelCF = nil, nil, nil
end

-- the floor's surface under the zone part's centre (the zone stands on it: attribute FloorY), the zone's own turn: -Z faces the lobby
function H.floorFrame(zone)
	local y = tonumber(zone:GetAttribute("FloorY")) or zone.Position.Y
	return zone.CFrame * CFrame.new(0, y - zone.Position.Y, 0)
end

-- the fight's own boss still stands on the floor here (a lost fight: the end's linger, nothing on the server says so)
function H.fightOnFloor()
	local battle = H.controller("BattleController")
	return battle ~= nil and type(battle.DrawsRaidFloor) == "function" and battle.DrawsRaidFloor() == true
end

function H.syncBoss()
	local raid = H.raid()
	local zone = H.floorZone()
	local pos = H.rootPosition()
	local tier = RaidGateController.Tier()
	local want = raid ~= nil and raid.Active ~= true and H.left(raid.FloorHiddenIn) <= 0 and zone ~= nil and tier ~= nil and pos ~= nil
		and (pos - zone.Position).Magnitude <= K.RANGE and not H.fightOnFloor()
	if not want then
		H.dropModel()
		return
	end
	local low = H.low()
	local detail = low and "Low" or "High"
	local key = raid.BossId .. "|" .. tostring(tier.Id) .. "|" .. detail
	if S.ModelKey ~= key or not (S.Model and S.Model.Parent) then
		H.dropModel()
		local BB = H.bossBuilder()
		if not BB or S.Failed[key] then
			return
		end
		local cf = H.floorFrame(zone)
		local model = BB.Build(raid.BossId, { Tier = tier.Id, Detail = detail, NoAura = low, CFrame = cf, Parent = H.folder() })
		if not model then
			S.Failed[key] = true
			return
		end
		S.Model, S.ModelKey, S.ModelCF = model, key, cf
		S.Yaw = 0
	end
end

-- the head comes round at K.TURN_SPEED toward the player, the idle pose breathes under it (never on Low)
function H.animateBoss(now)
	local BB = H.bossBuilder()
	if not S.Model or not BB or now - S.AnimAt < K.ANIM_GAP or H.low() then
		return
	end
	local dt = math.min(now - S.AnimAt, K.TICK)
	S.AnimAt = now
	local pos = H.rootPosition()
	local target = 0
	if pos then
		local rel = S.ModelCF:PointToObjectSpace(pos)
		target = math.max(-K.YAW_MAX, math.min(K.YAW_MAX, math.atan2(-rel.X, -rel.Z)))
	end
	local step = K.TURN_SPEED * dt
	S.Yaw = S.Yaw + math.max(-step, math.min(step, target - S.Yaw))
	BB.Animate(S.Model, "Idle", now, { LookAt = (S.ModelCF * CFrame.Angles(0, S.Yaw, 0) * CFrame.new(0, 0, -K.LOOK_AHEAD)).Position })
end

----------------------------------------------------------------------
-- the gate tag
----------------------------------------------------------------------
function H.dropTag()
	if U.Tag then
		pcall(U.Tag.Destroy, U.Tag)
	end
	U.Tag, U.TagLines = nil, nil
end

function H.buildTag(adornee)
	local gui = Instance.new("BillboardGui")
	gui.Name = "RaidGateTag"
	gui.Size = UDim2.fromOffset(K.TAG_W, K.TAG_H)
	gui.StudsOffset = Vector3.new(0, K.TAG_OFFSET, 0)
	gui.MaxDistance = K.TAG_DISTANCE
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = adornee
	-- (kit-b U9-7) a stone notice in its wood edge with the stone lip, nailed up at its top corners (was a navy rounded
	-- plate with a gold rim)
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.BorderSizePixel = 0
	plate.Size = UDim2.new(1, 0, 1, 0)
	plate.Parent = gui
	CloudUI.SignBlock(plate, "Stone", { LipPx = 5 })
	SignKit.Nails(plate, { Inset = 5 })
	local lines = {}
	for i, spec in ipairs({ { "Heading", 22, INK, 6, 56 }, { "Body", 18, C.Reward, 62, 26 }, { "Heading", 18, INK, 88, 26 } }) do
		lines[i] = H.text(plate, "Line" .. i, "", spec[1], spec[2], spec[3], {
			Position = UDim2.fromOffset(8, spec[4]),
			Size = UDim2.new(1, -16, 0, spec[5]),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
		})
	end
	gui.Parent = H.folder()
	U.Tag, U.TagLines = gui, lines
end

function H.syncTag()
	local raid = H.raid()
	local tier = RaidGateController.Tier()
	local adornee = H.tagAdornee()
	if not raid or not tier or not adornee then
		H.dropTag()
		return
	end
	if not (U.Tag and U.Tag.Parent) then
		H.dropTag()
		H.buildTag(adornee)
	end
	U.Tag.Adornee = adornee
	U.Tag.Enabled = not H.fighting()
	U.TagLines[1].Text = H.bossName(raid) .. " - your tier: " .. tostring(tier.Id) .. " (L" .. tostring(tier.BossLevel) .. " boss)"
	U.TagLines[2].Text = RaidGateController.RewardLine()
	local closed = type(raid.Closed) == "table" and H.left(raid.Closed[tier.Id]) or 0
	if closed > 0 then
		U.TagLines[3].Text = tostring(tier.Id) .. " boss back in " .. tostring(math.ceil(closed)) .. " s"
	else
		U.TagLines[3].Text = "Walk through to fight"
	end
end

function RaidGateController.Refresh()
	H.safe("boss", H.syncBoss)
	H.safe("tag", H.syncTag)
end

----------------------------------------------------------------------
-- the dare panel
----------------------------------------------------------------------
function H.build()
	if U.Holder then
		return
	end
	local holder = Instance.new("Frame")
	holder.Name = "Dare"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(K.PREF_W, K.PREF_H)
	holder.Visible = false
	holder.ZIndex = 3
	holder.Parent = U.Gui
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	U.Dock = NeonKit.Dock(holder, U.Fit, K.PREF_W, K.PREF_H)
	local panel = CloudUI.Panel({
		Name = "DarePanel",
		Title = "Dare a higher tier",
		Closable = true,
		Skin = "Signboard", -- (kit-b U9-7) roof, navy header with the sword, wood frame, stone body
		Icon = Config.Icons.Battle,
		TitleSize = 30, -- (the prompt's words, "Dare a higher tier": at 34 px they ran 4 px past the header beside the icon on a phone;
		-- U9-7 look: 30, the band inside the frame on the dock and 12 px more clear of the X)
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			RaidGateController.Close()
		end,
		Parent = holder,
	})
	-- (U9-7 look) a docked window's band stays inside the frame, no tails (its right tail ran off the screen edge): the
	-- header shape Index and the Food Machine wear on the same dock
	SignKit.HeaderOverhang(panel.TitleBar, false)
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local list = Instance.new("Frame")
	list.Name = "Rows"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(CloudUI.Metrics.SignPagePad, 8) -- (U9-7 look) the dock family's page inset
	list.Size = UDim2.new(1, -2 * CloudUI.Metrics.SignPagePad, 1, -16)
	list.Parent = panel.Content
	Util.Create("UIListLayout", { Padding = UDim.new(0, K.GAP), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	U.List = list
end

function H.dare(tierId)
	RaidGateController.Close()
	TeamFaces.Ensure(function()
		local arena = H.controller("ArenaController")
		if arena and type(arena.Request) == "function" then
			arena.Request("RaidDare", tierId)
		end
	end)
end

-- (U9-7 look) the tier's stair: `n` gold steps rising left to right (the header ribbon's step motif), each on its lip
function H.steps(parent, n)
	local holder = Instance.new("Frame")
	holder.Name = "Steps"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(3 * (K.STEP + 2), 24)
	holder.LayoutOrder = 0
	holder.Parent = parent
	for j = 1, 3 do
		local lit = j <= n
		local step = Instance.new("Frame")
		step.Name = "Step" .. j
		step.BorderSizePixel = 0
		step.BackgroundColor3 = lit and SIGN.Gold or SIGN.Well
		step.AnchorPoint = Vector2.new(0, 1)
		step.Position = UDim2.new(0, (j - 1) * (K.STEP + 2), 1, 0)
		step.Size = UDim2.fromOffset(K.STEP, 6 * j + 4)
		step.Parent = holder
		local lip = Instance.new("Frame")
		lip.Name = "Lip"
		lip.BorderSizePixel = 0
		lip.BackgroundColor3 = lit and SIGN.GoldLip or SIGN.WellEdge
		lip.AnchorPoint = Vector2.new(0, 1)
		lip.Position = UDim2.new(0, 0, 1, 0)
		lip.Size = UDim2.new(1, 0, 0, 2)
		lip.Parent = step
	end
	return holder
end

function H.row(tier, order)
	-- (kit-b U9-7) a stone tile per tier; Dare is a red (risky) block, the window has no green. (U9-7 look) Two lines: the
	-- tier's rising steps and its chip, then its facts as the Raid page's tags (crown L40, sword x0.8, coin x0.7; the
	-- comma sentence wrapped on a phone)
	local row = Instance.new("Frame")
	row.Name = "Row_" .. tostring(tier.Id)
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, K.ROW_H)
	row.LayoutOrder = order
	row.Parent = U.List
	CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = 4 })
	local arena = H.controller("ArenaController")
	local rank = 0
	local BC = H.catalog()
	for i, id in ipairs(BC and BC.RaidTierOrder or {}) do
		if id == tier.Id then
			rank = i - 1
		end
	end
	local function line(name, y)
		local f = Instance.new("Frame")
		f.Name = name
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.Position = UDim2.fromOffset(12, y)
		f.Size = UDim2.new(1, -(K.BUTTON_W + 32), 0, 30)
		f.Parent = row
		Util.Create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Parent = f,
		})
		return f
	end
	local head = line("Head", 6)
	H.steps(head, math.max(1, math.min(3, rank)))
	local facts = line("Facts", 40)
	if arena and type(arena.TierFacts) == "function" then
		pcall(arena.TierFacts, facts, tier, head)
	else
		H.text(facts, "Text", tostring(tier.Id) .. "  L" .. tostring(tier.BossLevel) .. "  x" .. tostring(tier.Hit) .. "  x" .. tostring(tier.Reward), "Heading", 18, INK, {
			Size = UDim2.new(1, 0, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
	end
	CloudUI.Button({
		Name = "Dare_" .. tostring(tier.Id),
		Text = "Dare",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, -2),
		Size = UDim2.fromOffset(K.BUTTON_W, K.BUTTON_H),
		Style = "Red",
		Skin = "Sign",
		TextSize = 22,
		Parent = row,
		Callback = function()
			H.safe("dare", H.dare, tier.Id)
		end,
	})
	return row
end

function H.fillRows()
	for _, child in ipairs(U.List:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	local BC = H.catalog()
	local mine = RaidGateController.Tier()
	local count = 0
	for _, id in ipairs(BC and BC.RaidTierOrder or {}) do
		if mine and BC.RaidCanDare(mine.Id, id) then
			count = count + 1
			H.row(BC.RaidTierById(id), count + 1)
		end
	end
	H.text(U.List, "Intro", count > 0 and "Winning a dare pays that tier's rewards." or "You are already at the top tier.", "Body", 18, C.Muted, {
		Size = UDim2.new(1, 0, 0, K.INTRO_H),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	H.fitDock(count)
end

-- (U9-7 look) the panel as tall as its rows: the frame round Panel.Content (82), the list's 8 px top and bottom, the intro
-- and `count` rows (at least one), 14 px to spare; the dock is made again for a new height
function H.fitDock(count)
	local h = math.min(K.PREF_H, 82 + 8 + K.INTRO_H + math.max(1, count) * (K.ROW_H + K.GAP) + 8 + 14)
	if U.DockH == h or not U.Holder then
		return
	end
	U.DockH = h
	if U.Dock and U.Dock.Disconnect then
		U.Dock.Disconnect()
	end
	U.Dock = NeonKit.Dock(U.Holder, U.Fit, K.PREF_W, h)
end

function H.onBack(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		RaidGateController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

function H.syncBack()
	local want = S.Open == true
	if want == S.BackBound then
		return
	end
	S.BackBound = want
	if want then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, H.onBack, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

-- (kit-b U9-7) on a touch screen Roblox's thumbstick and jump button go while the panel is open (the jump button sat on
-- Dare_Max at 844x390) and come back as they were: MenuController keeps the one owner set, as the Arena and the Index do
function H.syncTouch()
	local want = S.Open == true and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if want == (S.TouchOff == true) then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		H.safe("touch", menu.SetTouchHidden, "Dare", want)
	end
end

function RaidGateController.OpenDare(prompt)
	if not initialized then
		RaidGateController.Init()
	end
	if not U.Gui or H.fighting() then
		return false
	end
	H.build()
	H.fillRows()
	-- a panel opened at the pillar closes when the player walks off
	S.At = nil
	local pillar = typeof(prompt) == "Instance" and prompt.Parent or nil
	local pos = H.rootPosition()
	if pillar and pillar:IsA("BasePart") and pos and (pos - pillar.Position).Magnitude <= K.WALK_AWAY then
		S.At = pillar
	end
	local was = S.Open
	if not was then
		for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "ArenaController", "DungeonController", "ObbyController" }) do
			local mod = H.controller(name)
			if mod and type(mod.Close) == "function" then
				pcall(mod.Close)
			end
		end
	end
	S.Open = true
	S.Token = S.Token + 1
	H.syncBack()
	H.syncTouch()
	if U.Dock and U.Dock.Refresh then
		U.Dock.Refresh()
	end
	U.Holder.Visible = true
	if not was then
		U.Pop.Scale = 0.9
		Util.Tween(U.Pop, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		RaidGateController.Opened:Fire("Dare")
	end
	return true
end

function RaidGateController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.At = nil
	S.Token = S.Token + 1
	local mine = S.Token
	H.syncBack()
	H.syncTouch()
	if U.Pop then
		Util.Tween(U.Pop, 0.12, { Scale = 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
			U.Pop.Scale = 1
		end
	end)
	RaidGateController.Closed:Fire("Dare")
end

function RaidGateController.IsOpen()
	return S.Open == true
end

----------------------------------------------------------------------
-- server messages + Init
----------------------------------------------------------------------
function H.onArenaState(state)
	if type(state) ~= "table" then
		return
	end
	S.Arena = state
	S.ArenaAt = os.clock()
	RaidGateController.Refresh()
end

function H.onBattleState(kind, payload)
	if kind ~= "Start" or type(payload) ~= "table" then
		return
	end
	if payload.Spectator ~= true and (payload.Side or 1) ~= 0 then
		RaidGateController.Close()
	end
	-- a fight on the real floor, seen before the next ArenaState: the fight's own boss stands there now
	local raid = H.raid()
	if raid and payload.Mode == "Raid" and type(payload.Raid) == "table" and payload.Raid.Pocket == false then
		raid.Active = true
		H.safe("boss", H.syncBoss)
	end
end

function H.heartbeat()
	local now = os.clock()
	H.safe("animate", H.animateBoss, now)
	if now < S.TickAt then
		return
	end
	S.TickAt = now + K.TICK
	H.safe("boss", H.syncBoss)
	if now >= S.TagAt then
		S.TagAt = now + K.TAG_EVERY
		H.safe("tag", H.syncTag)
	elseif U.Tag then
		U.Tag.Enabled = not H.fighting()
	end
	if S.Open and S.At then
		local pos = H.rootPosition()
		if pos and (pos - S.At.Position).Magnitude > K.WALK_AWAY then
			RaidGateController.Close()
		end
	end
end

function RaidGateController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusRaidGate", K.DISPLAY_ORDER)
	local conns = S.Conns
	conns[#conns + 1] = State.Changed:Connect(function()
		S.Tier = nil
		RaidGateController.Refresh()
	end)
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			RaidGateController.Close()
		end
	end)
	conns[#conns + 1] = RunService.Heartbeat:Connect(H.heartbeat)
	task.spawn(function()
		local okArena, arenaRemote = pcall(Remotes.Get, "ArenaState")
		if okArena and arenaRemote and initialized then
			conns[#conns + 1] = arenaRemote.OnClientEvent:Connect(function(state)
				H.safe("ArenaState", H.onArenaState, state)
			end)
		end
		local okBattle, battleRemote = pcall(Remotes.Get, "BattleState")
		if okBattle and battleRemote and initialized then
			conns[#conns + 1] = battleRemote.OnClientEvent:Connect(function(kind, payload)
				H.safe("BattleState", H.onBattleState, kind, payload)
			end)
		end
	end)
	-- one side panel at a time
	task.defer(function()
		for _, spec in ipairs({ { "MenuController", "WindowOpened" }, { "IndexController", "Opened" }, { "FusionController", "Opened" }, { "CareController", "Opened" },
			{ "ArenaController", "Opened" }, { "DungeonController", "Opened" }, { "ObbyController", "Opened" } }) do
			local mod = H.controller(spec[1])
			local signal = mod and mod[spec[2]]
			if type(signal) == "table" and type(signal.Connect) == "function" then
				conns[#conns + 1] = signal:Connect(function(windowId)
					if windowId ~= "Dare" then
						RaidGateController.Close()
					end
				end)
			end
		end
	end)
end

function RaidGateController.Stop()
	RaidGateController.Close()
	for _, conn in ipairs(S.Conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	S.Conns = {}
	H.dropModel()
	H.dropTag()
	if U.Folder then
		pcall(U.Folder.Destroy, U.Folder)
	end
	if U.Gui then
		pcall(U.Gui.Destroy, U.Gui)
	end
	U = {}
	S.Arena, S.Tier = nil, nil
	initialized = false
end

return RaidGateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1160">
            <Properties>
              <string name="Name">RingAmbience</string>
              <string name="Source"><![CDATA[-- RingAmbience (client, original audio): the Champion Ring's crowd and drums as positional loops.
--
-- Where: every Champion Ring pocket (workspace.BattlePockets.RingPocket_<i>, ArenaBuilder.BuildPocket: the ring on its
-- cloud with the cheering crowd on a stone bleacher behind the champion's side, the child model "Crowd"). Its crowd
-- gets SoundFx "CrowdCheer" at the middle of the bleacher; "DrumLoop" plays from the pocket's drummer when there is one
-- and, until a drummer exists, from the bleacher's back step at one end (the drummer's spot). Both are
-- SoundFx.Positional loops: RollOffMode InverseTapered, Config.Audio.Positional Min / Max studs (heard only near the
-- ring; pockets are 380 studs apart), slot volumes under the music (Config.Audio.Volume), the player's settings applied
-- (CrowdCheer: Sfx, DrumLoop: Music). A sound without an id (AudioIds) is simply not made.
--
-- THE DRUMMER HOOK (no drummer model exists in this branch): a model or part named "Drummer" anywhere in a ring pocket,
-- one with the attribute Drummer = true (the art-wave branch's crowd: ArenaBuilder Ring.spectator marks its drummer
-- "Spectator_drizzle" so), or ANY instance tagged "NC_RingDrummer" (CollectionService; e.g. a drummer at a plaza ring),
-- gets the DrumLoop; in a pocket it then replaces the fallback at the bleacher. Likewise "NC_RingCrowd" gives any
-- crowd / stand a CrowdCheer (a plaza ring with stands only has to tag them). Everything is client-side and never
-- replicated; a destroyed pocket takes its sounds with it.
--
-- LATE PARTS: a model replicates before its parts (a player joining while the pockets are still streaming in), so a
-- Scan can find a Crowd / drummer / tagged stand with no BasePart yet, or only some of them. Every BasePart that lands
-- in a pocket's Crowd or drummer (or in a tagged model) queues one deferred re-scan; the loop is made once the host has
-- a part and moved when its anchor part changes or its spot moves more than K.MOVE_EPS studs. A battle's VFX parts
-- elsewhere in the pocket do not trigger it.
--
--   RingAmbience.Init()                 watches workspace.BattlePockets and the two tags (once)
--   RingAmbience.Scan(pocket)           attaches the pocket's sounds now (idempotent; tests / a late child)
--   RingAmbience.Attach(host, name, offset) -> Sound | nil   a positional `name` loop at `host` (a Model, BasePart or
--                                       Attachment); offset = a world Vector3 from the host's centre
--   RingAmbience.Stats() -> { Sites, Crowd, Drums }
--
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent

local RingAmbience = {}

local K = {
	FOLDER = "BattlePockets",
	POCKET_PREFIX = "RingPocket_",
	CROWD = "Crowd", -- ArenaBuilder's crowd stand in the pocket
	DRUMMER = "Drummer", -- the hook: a drummer model / part in the pocket
	CROWD_TAG = "NC_RingCrowd",
	DRUMMER_TAG = "NC_RingDrummer",
	ANCHOR = "RingAudio_", -- the Attachments made here
	CROWD_LIFT = 3, -- studs above the bleacher's centre (the puffs' heads)
	DRUM_SPOT = { X = 0.36, Y = 1.5, Z = 0.25 }, -- the fallback drummer spot: x / z share of the stand's size from its centre
	MOVE_EPS = 4, -- studs: a re-scan moves a playing loop only when its anchor part changes or its spot moves this far
}
RingAmbience.K = K

local St = {
	started = false,
	sites = {}, -- [pocket Model] = { crowd = Sound|nil, drum = Sound|nil, drumHost = Instance|nil, crowdE / drumE = placement }
	tagged = {}, -- [tagged Instance] = { sound, host, part, at }
	pending = {}, -- [pocket Model] = true while a deferred re-scan is queued
	conns = {},
	SF = nil, -- client/SoundFx (lazy); false = unavailable
}
RingAmbience._St = St

local function soundFx()
	if St.SF == nil then
		local module = Client:FindFirstChild("SoundFx")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		St.SF = (ok and type(result) == "table") and result or false
	end
	return St.SF or nil
end

-- the biggest BasePart of a host (a stand's long step), the host itself when it is one
local function anchorPart(host)
	if host:IsA("BasePart") then
		return host
	end
	local best, bestV = nil, -1
	for _, d in ipairs(host:GetDescendants()) do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestV then
				best, bestV = d, v
			end
		end
	end
	return best
end

-- the host's world centre and size
local function bounds(host)
	if host:IsA("BasePart") then
		return host.Position, host.Size
	end
	if host:IsA("Model") then
		local ok, cf, size = pcall(function()
			return host:GetBoundingBox()
		end)
		if ok and cf then
			return cf.Position, size
		end
	end
	local part = anchorPart(host)
	if part then
		return part.Position, part.Size
	end
	return nil, nil
end

-- where a loop for `host` goes: the anchor part and the world spot (nil while the host has no BasePart yet)
local function placement(host, offset)
	if host:IsA("Attachment") then
		return host, host.WorldPosition
	end
	local part = anchorPart(host)
	local centre = bounds(host)
	if not part or not centre then
		return nil, nil
	end
	return part, centre + (offset or Vector3.new(0, K.CROWD_LIFT, 0))
end

-- a positional `name` loop on `part` at the world spot `at` (an Attachment host takes it directly)
local function attachAt(host, part, at, name)
	local SF = soundFx()
	if not SF or type(SF.Positional) ~= "function" then
		return nil
	end
	local parent = host
	if not host:IsA("Attachment") then
		local att = Instance.new("Attachment")
		att.Name = K.ANCHOR .. name
		att.Position = part.CFrame:PointToObjectSpace(at)
		att.Parent = part
		parent = att
	end
	local ok, sound = pcall(SF.Positional, name, parent)
	if ok and typeof(sound) == "Instance" then
		return sound
	end
	if parent ~= host then
		parent:Destroy() -- (no id: no sound, no empty anchor left behind)
	end
	return nil
end

function RingAmbience.Attach(host, name, offset)
	if typeof(host) ~= "Instance" then
		return nil
	end
	local part, at = placement(host, offset)
	if not part then
		return nil
	end
	return attachAt(host, part, at, name)
end

local function drop(sound)
	if typeof(sound) == "Instance" then
		local att = sound.Parent
		sound:Destroy()
		if att and att:IsA("Attachment") and string.sub(att.Name, 1, #K.ANCHOR) == K.ANCHOR then
			att:Destroy()
		end
	end
end

local function alive(sound)
	return typeof(sound) == "Instance" and sound.Parent ~= nil
end

-- keeps entry (= { sound, host, part, at }) a `name` loop at `host`: kept while its anchor part and spot hold; moved
-- (dropped + made again) when the host changes or its parts arrive later (a model replicates before its parts: the
-- first part to land would otherwise be the anchor and the "centre" for good). A host with no part yet keeps what is on.
local function ensure(entry, host, name, offset)
	if not host then
		return entry.sound
	end
	local part, at = placement(host, offset)
	if not part then
		return alive(entry.sound) and entry.sound or nil
	end
	if alive(entry.sound) and entry.host == host and entry.part == part and entry.at and (at - entry.at).Magnitude <= K.MOVE_EPS then
		return entry.sound
	end
	drop(entry.sound)
	entry.sound = attachAt(host, part, at, name)
	if entry.sound then
		entry.host, entry.part, entry.at = host, part, at
	else
		entry.host, entry.part, entry.at = nil, nil, nil
	end
	return entry.sound
end

local function isDrummer(inst)
	return inst.Name == K.DRUMMER or inst:GetAttribute(K.DRUMMER) == true
end

-- the pocket's drummer: a descendant named Drummer, marked Drummer = true or tagged NC_RingDrummer
local function drummerOf(pocket)
	local named = pocket:FindFirstChild(K.DRUMMER, true)
	if named then
		return named
	end
	for _, d in ipairs(pocket:GetDescendants()) do
		if d:GetAttribute(K.DRUMMER) == true then
			return d
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(K.DRUMMER_TAG)) do
		if inst:IsDescendantOf(pocket) then
			return inst
		end
	end
	return nil
end

function RingAmbience.Scan(pocket)
	if typeof(pocket) ~= "Instance" or not pocket.Parent then
		return nil
	end
	local site = St.sites[pocket]
	if not site then
		site = { crowdE = {}, drumE = {} }
		St.sites[pocket] = site
	end
	local crowd = pocket:FindFirstChild(K.CROWD)
	site.crowd = ensure(site.crowdE, crowd, "CrowdCheer")
	-- the drums: at the drummer once it has a part, else at the bleacher's back step at one end (the drummer's spot)
	local drummer = drummerOf(pocket)
	if drummer and not placement(drummer, Vector3.new(0, 0, 0)) then
		drummer = nil
	end
	local host, offset = drummer, Vector3.new(0, 0, 0)
	if not drummer and crowd then
		local _, size = bounds(crowd)
		size = size or Vector3.new(30, 4, 8)
		host, offset = crowd, Vector3.new(size.X * K.DRUM_SPOT.X, K.DRUM_SPOT.Y, size.Z * K.DRUM_SPOT.Z)
	end
	site.drum = ensure(site.drumE, host, "DrumLoop", offset)
	site.drumHost = site.drum and site.drumE.host or nil
	return site
end

local function isPocket(inst)
	return inst:IsA("Model") and string.sub(inst.Name, 1, #K.POCKET_PREFIX) == K.POCKET_PREFIX
end

-- a part of the crowd or of a drummer (walks up to the pocket: a few levels), not a battle's VFX part in the pocket
local function inCrowdOrDrummer(d, pocket)
	local a = d.Parent
	while a and a ~= pocket do
		if a.Name == K.CROWD or isDrummer(a) then
			return true
		end
		a = a.Parent
	end
	return false
end

-- one deferred re-scan per pocket for a burst of arriving parts
local function rescanSoon(pocket)
	if St.pending[pocket] then
		return
	end
	St.pending[pocket] = true
	task.defer(function()
		St.pending[pocket] = nil
		if St.sites[pocket] then
			RingAmbience.Scan(pocket)
		end
	end)
end

local function watchPocket(pocket)
	if not isPocket(pocket) or St.sites[pocket] then
		return
	end
	RingAmbience.Scan(pocket)
	-- a crowd / drummer that replicates after the pocket itself, and their parts that replicate after them
	table.insert(St.conns, pocket.DescendantAdded:Connect(function(d)
		if d.Name == K.CROWD or isDrummer(d) then
			RingAmbience.Scan(pocket)
		elseif d:IsA("BasePart") and inCrowdOrDrummer(d, pocket) then
			rescanSoon(pocket)
		end
	end))
	table.insert(St.conns, pocket.AncestryChanged:Connect(function()
		if not pocket.Parent then
			St.sites[pocket] = nil
		end
	end))
end

local function watchFolder(folder)
	for _, child in ipairs(folder:GetChildren()) do
		watchPocket(child)
	end
	table.insert(St.conns, folder.ChildAdded:Connect(watchPocket))
end

local function onTagged(inst, name)
	-- a drummer inside a ring pocket is the pocket's (Scan moves the drums there)
	for pocket in pairs(St.sites) do
		if inst:IsDescendantOf(pocket) then
			RingAmbience.Scan(pocket)
			return
		end
	end
	local entry = St.tagged[inst]
	if not entry then
		entry = {}
		St.tagged[inst] = entry
		-- a tagged model's parts can land after it (and after its tag): place the loop again as they arrive
		if not inst:IsA("BasePart") and not inst:IsA("Attachment") then
			local pending = false
			table.insert(St.conns, inst.DescendantAdded:Connect(function(d)
				if d:IsA("BasePart") and not pending then
					pending = true
					task.defer(function()
						pending = false
						if St.tagged[inst] and inst.Parent then
							ensure(St.tagged[inst], inst, name)
						end
					end)
				end
			end))
		end
		table.insert(St.conns, inst.AncestryChanged:Connect(function()
			if not inst.Parent then
				St.tagged[inst] = nil
			end
		end))
	end
	ensure(entry, inst, name)
end

function RingAmbience.Init()
	if St.started then
		return
	end
	St.started = true
	local folder = Workspace:FindFirstChild(K.FOLDER)
	if folder then
		watchFolder(folder)
	end
	table.insert(St.conns, Workspace.ChildAdded:Connect(function(child)
		if child.Name == K.FOLDER and child:IsA("Folder") then
			watchFolder(child)
		end
	end))
	for tag, name in pairs({ [K.CROWD_TAG] = "CrowdCheer", [K.DRUMMER_TAG] = "DrumLoop" }) do
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			onTagged(inst, name)
		end
		table.insert(St.conns, CollectionService:GetInstanceAddedSignal(tag):Connect(function(inst)
			onTagged(inst, name)
		end))
	end
end

function RingAmbience.Stats()
	local sites, crowd, drums = 0, 0, 0
	for pocket, site in pairs(St.sites) do
		if pocket.Parent then
			sites = sites + 1
			if site.crowd and site.crowd.Parent then
				crowd = crowd + 1
			end
			if site.drum and site.drum.Parent then
				drums = drums + 1
			end
		end
	end
	for _, entry in pairs(St.tagged) do
		local s = entry.sound
		if typeof(s) == "Instance" and s.Parent then
			if s.Name == "Loop_DrumLoop" then
				drums = drums + 1
			else
				crowd = crowd + 1
			end
		end
	end
	return { Sites = sites, Crowd = crowd, Drums = drums }
end

return RingAmbience
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1161">
            <Properties>
              <string name="Name">RingCrowdFx</string>
              <string name="Source"><![CDATA[-- RingCrowdFx (client, bug #11 "crowd needs animation and sound": this module is the ANIMATION; the player's pick:
-- the Sky-Sailors' Ring with a drummer): the Champion Ring's crowd of retired weather clouds comes alive. The server (ArenaBuilder Ring.spectator)
-- builds each spectator as a Model tagged "RingCrowd" with separate anchored ROOT parts: Body, ArmL, ArmR, Cap and
-- (Drizzle, the ship's drummer boy) Drum. Each root carries its mesh pivot in the "CrowdOff" attribute; once the
-- Blender keys are uploaded the dressed meshes are welded to the roots (ML_Weld) and simply ride them. Next to the
-- spectators hang the FlagLine (the signal flags) and the ship's Bell. Here, on this client only:
--   * idle: the whole stand sways in time with Drizzle's drum (120 beats a minute, the sticks alternate, every cloud
--     bobs on every second beat a little after the drum, each with its own lag, and breathes; Drizzle himself drops
--     onto every stroke with no lag, leaning in, and the drum dips under it), Fog's spyglass droops as he dozes,
--     the signal flags swing in the wind, Rain drips and Snow lets flakes drift (particles, off on Low graphics);
--   * a big hit or a KO (BattleState "Events" of a Champion Ring battle: a KO, a Special, or a hit far above the
--     battle's running average): everyone leans back with the arms up ("rumble-oooh"), the Thunder Captain flashes with
--     a lightning bolt (a PointLight + two Beams), Drizzle misses a beat, Fog snaps his spyglass up;
--   * a round won ("End" won): they hop and throw their arms up, the caps fly, the bell swings, the drum goes double
--     time;
--   * a round lost: they droop ("awww");
--   * a boss round ("Start".Ring.Champion.Boss): the clouds darken and lean in, drizzle falls from all of them, the
--     drum rolls, until that round ends.
-- NO SOUND HERE: the crowd and drum sounds belong to the audio branch (client RingAmbience + SoundFx, ids in AudioIds).
-- It finds this stand by its tags: the Crowd model is tagged "NC_RingCrowd" and Drizzle's model "NC_RingDrummer" (with
-- the attribute Drummer = true); ArenaBuilder Ring.crowdTemplate / Ring.spectator set them.
-- Cheap: ONE Heartbeat connection, UPDATE_HZ (LOW_HZ on Low graphics), only stands within RANGE studs of the camera
-- move; out of range, on Stop() or when the tag goes away every part returns exactly to its rest frame and colour.
--
--   RingCrowdFx.Init()                       idempotent (Main.client.lua starts it)
--   RingCrowdFx.Stop()                       everything back at rest, client instances removed
--   RingCrowdFx.Step(dt)                     one Heartbeat step (tests drive it)
--   RingCrowdFx.Cue(name)                    "Hit" | "Won" | "Lost" | "Boss" | "BossEnd" (the battle hooks call it; tests)
--   RingCrowdFx.HandleState(kind, payload)   the BattleState remote's handler (Start / Events / End)
--   RingCrowdFx.Pose(spec, t, cue, cueT, boss) -> pose   pure: the offsets of one spectator at time t
--   RingCrowdFx.StickAngle(side, beat, mode) -> radians  pure: a drumstick's lift (0 = on the drum head)
--   RingCrowdFx.Stats() -> { Spectators, Moving, Writes, Beats, Cue, Boss, Quality, Emitters }
--   RingCrowdFx.K                            the tuning numbers
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FxSprites = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("FxSprites"))

local RingCrowdFx = {}

local K = {
	TAG = "RingCrowd",
	RANGE = 160, -- studs from the camera: farther stands rest
	UPDATE_HZ = 30,
	LOW_HZ = 15,
	REFRESH = 0.5,
	BPM = 120, -- Drizzle's beat (a ship's quick march)
	-- the idle has to read from the fighter's spawn (~45 studs) for a whole run: the fix round raised it from
	-- 0.08 studs / 0.045 rad / 0.14 rad, which looked static even close up
	BOB = 0.3, -- studs: the idle bob on every second beat
	SWAY = 0.1, -- radians: the idle side-to-side roll (one sway per 4 beats)
	BREATHE = 0.05, -- radians: a slow breathing lean, back and forth (BREATH_S seconds)
	BREATH_S = 3.2,
	LAG = 0.22, -- beats: the most a cloud lags behind the drum
	ARM_IDLE = 0.3, -- radians the arms swing in idle
	STICK_UP = 0.65, -- radians a drumstick (the whole stick arm) lifts between two hits (0.5 before; more and the
	-- raised stick covers his eyes from the front)
	-- Drizzle carries the beat with his whole body, on the beat, no lag: he bobs up between hits and drops onto every
	-- hit, leaning into it, his shoulders rocking toward the hitting stick, and the drum dips under the stroke
	DRUM_DIP = 0.2, -- studs
	DRUM_LEAN = 0.1, -- radians (forward, on the hit)
	DRUM_ROLL = 0.06, -- radians (toward the stick that is coming down)
	DRUM_BOUNCE = 0.08, -- studs the drum dips under a stroke
	ROLL_HZ = 7, -- strokes per second per stick in a drum roll
	HIT_TIME = 1.2,
	WON_TIME = 2.8,
	LOST_TIME = 2.2,
	HOP = 0.9, -- studs: a round-won hop
	CAP_FLY = 2.2, -- studs a sailor cap flies up when a round is won (the captain's 1.2)
	BELL_SWING = 0.65, -- radians
	BOSS_DARK = 0.38, -- how far the clouds go toward the storm colour in a boss round
	BOSS_LEAN = -0.13, -- radians (forward)
	STORM = Color3.fromRGB(78, 84, 108),
	FLAG_SWING = 0.07, -- radians
	BIG_HIT = 1.8, -- a hit this many times the battle's running average is a big hit
	BIG_MIN_HITS = 3,
	CUE_GAP = 2.0, -- seconds between two big-hit cues
}
RingCrowdFx.K = K

local TWO_PI = math.pi * 2
local sin, cos, abs, max, min, exp, floor, sqrt = math.sin, math.cos, math.abs, math.max, math.min, math.exp, math.floor, math.sqrt
local SIDES = { "ArmL", "ArmR" }
local PIECES = { "Body", "ArmL", "ArmR", "Cap", "Drum" }

local St = {
	Started = false,
	Specs = {}, -- [model] = rec
	Count = 0,
	Extras = {}, -- [part] = { Part, Kind = "Flags" | "Bell", Rest, Kids }
	Conns = {},
	Time = 0,
	Acc = 0,
	RefreshAcc = 0,
	Quality = "High",
	Quality0 = nil,
	Writes = 0,
	Beats = 0,
	LastBeat = -1,
	Cue = nil, -- { Name, T0 }
	Boss = false,
	BossFade = 0,
	Battle = nil, -- { Id, Hits, Sum, LastCue }
	Emitters = 0,
}
RingCrowdFx._St = St

local function quality()
	if St.Quality0 == nil then
		St.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				St.Quality0 = mod
			end
		end
	end
	if St.Quality0 then
		local ok, mode = pcall(St.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

local function clamp01(x)
	return max(0, min(1, x))
end

-- 0 -> 1 -> 0 over `span` seconds (a cue's envelope)
local function env(t, span)
	if t < 0 or t > span then
		return 0
	end
	return sin(math.pi * t / span)
end

----------------------------------------------------------------------
-- Pure motion (tests and the renders use these)
----------------------------------------------------------------------
-- a drumstick's lift at `beat` (beats since start). side -1 = left (hits on even beats), 1 = right (odd beats).
-- mode: "idle" | "double" (two hits per beat) | "roll" (fast, small) | "miss" (both held up)
function RingCrowdFx.StickAngle(side, beat, mode)
	if mode == "miss" then
		return K.STICK_UP * 1.4
	end
	if mode == "roll" then
		local f = (beat * 60 / K.BPM) * K.ROLL_HZ + ((side < 0) and 0 or 0.5)
		return K.STICK_UP * 0.3 * sin(math.pi * (f % 1)) ^ 2
	end
	local per = (mode == "double") and 1 or 2 -- beats between two hits of one stick
	local off = (side < 0) and 0 or per / 2
	local p = ((beat - off) / per) % 1
	return K.STICK_UP * sin(math.pi * p) ^ 2
end

-- the pose of one spectator. spec = { Name, Phase (0..1), Drummer, Captain, Cap ("sailor" | "captain" | nil) };
-- cue = "Hit" | "Won" | "Lost" | nil and cueT = seconds since it began; boss = 0..1 (the boss fade).
-- -> { Lift, Lean, Roll, ArmL, ArmR (extra roll out, radians), StickL, StickR, Glass (spyglass pitch), CapUp, CapSpin,
--      Flash (0..1), BellSwing, DrumDip (studs, <= 0) }
-- out (optional): a table to fill in place (RingCrowdFx keeps one per spectator: no allocation per tick)
function RingCrowdFx.Pose(spec, t, cue, cueT, boss, out)
	local beat = t * K.BPM / 60
	local ph = spec.Phase or 0
	local b2 = (beat / 2 - ph * K.LAG * 2) % 1 -- every second beat, a little after the drum
	local pose = out or {}
	local bob = K.BOB * (0.5 + 0.5 * cos(TWO_PI * b2))
	pose.Lift = bob
	pose.Lean = K.BREATHE * sin(TWO_PI * (t / K.BREATH_S + ph))
	pose.Roll = K.SWAY * sin(TWO_PI * (beat / 4 + ph))
	pose.ArmL = K.ARM_IDLE * sin(TWO_PI * (beat / 2 + ph))
	pose.ArmR = K.ARM_IDLE * sin(TWO_PI * (beat / 2 + ph + 0.5))
	pose.StickL = 0
	pose.StickR = 0
	pose.Glass = -0.12 - 0.1 * (0.5 + 0.5 * sin(TWO_PI * (t / 7 + ph))) -- Fog dozes: the spyglass sinks, comes back
	pose.CapUp = 0
	pose.CapSpin = 0
	pose.Flash = 0
	pose.BellSwing = 0
	pose.DrumDip = 0
	local mode = "idle"
	boss = boss or 0
	if boss > 0 then
		pose.Lean = pose.Lean + K.BOSS_LEAN * boss
		pose.Lift = pose.Lift * (1 - 0.6 * boss)
		bob = bob * (1 - 0.6 * boss)
		mode = "roll"
	end
	if cue == "Hit" and cueT and cueT <= K.HIT_TIME then
		local e = env(cueT, K.HIT_TIME)
		pose.Lean = pose.Lean + 0.26 * e
		pose.ArmL = pose.ArmL + 0.9 * e
		pose.ArmR = pose.ArmR + 0.9 * e
		pose.Glass = pose.Glass + (0.3 - pose.Glass) * clamp01(e * 2) -- Fog wakes up and looks
		if spec.Captain then
			pose.Flash = clamp01(1 - cueT / 0.45)
		end
		if cueT < 0.6 then
			mode = "miss"
		end
	elseif cue == "Won" and cueT and cueT <= K.WON_TIME then
		local e = env(cueT, K.WON_TIME)
		local hopT = cueT + ph * 0.2
		pose.Lift = pose.Lift + K.HOP * abs(sin(math.pi * hopT / 0.62)) * (1 - cueT / K.WON_TIME)
		pose.ArmL = pose.ArmL + 1.7 * clamp01(e * 2)
		pose.ArmR = pose.ArmR + 1.7 * clamp01(e * 2)
		local fly = (spec.Cap == "captain") and K.CAP_FLY * 0.55 or K.CAP_FLY
		if cueT < 1.1 then
			pose.CapUp = fly * sin(math.pi * cueT / 1.1)
			pose.CapSpin = TWO_PI * cueT / 1.1
		end
		pose.BellSwing = K.BELL_SWING * exp(-cueT / 1.2) * sin(TWO_PI * cueT / 0.9)
		pose.Glass = 0.25
		mode = "double"
	elseif cue == "Lost" and cueT and cueT <= K.LOST_TIME then
		local e = env(cueT, K.LOST_TIME)
		pose.Lift = pose.Lift - 0.12 * e
		pose.Lean = pose.Lean - 0.14 * e
		pose.ArmL = pose.ArmL - 0.75 * e
		pose.ArmR = pose.ArmR - 0.75 * e
		mode = (cueT < 0.8) and "miss" or mode
	end
	if spec.Drummer then
		local sL = RingCrowdFx.StickAngle(-1, beat, mode)
		local sR = RingCrowdFx.StickAngle(1, beat, mode)
		pose.StickL, pose.StickR = sL, sR
		-- his body keeps the drum's time (not the crowd's lagged half-time bob): `up` is 0 on a stroke and 1 half way
		-- between two strokes; its square root makes a V, so he drops sharply onto every hit and floats up between
		local up = sqrt(clamp01(min(sL, sR) / (K.STICK_UP * 0.5)))
		local hit = 1 - up
		local amt = (mode == "roll") and 0.35 or 1
		pose.Lift = pose.Lift - bob + K.DRUM_DIP * up * amt
		pose.Lean = pose.Lean - K.DRUM_LEAN * hit * amt -- forward (negative, like BOSS_LEAN)
		pose.Roll = pose.Roll + K.DRUM_ROLL * (sR - sL) / K.STICK_UP * amt
		pose.DrumDip = -K.DRUM_BOUNCE * hit * amt
	end
	return pose
end

----------------------------------------------------------------------
-- Tracking
----------------------------------------------------------------------
-- a root part's rest record: its rest CFrame, its mesh pivot (CrowdOff) and its anchored kids' offsets
local function piece(part)
	if not part or not part:IsA("BasePart") then
		return nil
	end
	local off = part:GetAttribute("CrowdOff")
	if typeof(off) ~= "CFrame" then
		off = CFrame.new()
	end
	local rec = { Part = part, Rest = part.CFrame, Off = off, Pivot = part.CFrame * off, Kids = {}, Seen = {} }
	return rec
end

local function collectKids(rec)
	for _, d in ipairs(rec.Part:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored and not rec.Seen[d] then
			rec.Seen[d] = true
			rec.Kids[#rec.Kids + 1] = { Part = d, Offset = rec.Rest:ToObjectSpace(d.CFrame) }
		end
	end
end

-- puts a root (and its kids) where its mesh pivot is `pivot`
local function placePiece(rec, pivot)
	local cf = pivot * rec.Off:Inverse()
	rec.Part.CFrame = cf
	St.Writes = St.Writes + 1
	for _, k in ipairs(rec.Kids) do
		if k.Part.Parent and k.Part.Transparency < 0.99 then
			k.Part.CFrame = cf * k.Offset
			St.Writes = St.Writes + 1
		end
	end
end

local function restPiece(rec)
	if rec and rec.Part.Parent then
		rec.Part.CFrame = rec.Rest
		for _, k in ipairs(rec.Kids) do
			if k.Part.Parent then
				k.Part.CFrame = rec.Rest * k.Offset
			end
		end
	end
end

local function colourStore(rec)
	rec.Colours = rec.Colours or {}
	for _, d in ipairs(rec.Model:GetDescendants()) do
		if d:IsA("BasePart") and rec.Colours[d] == nil then
			rec.Colours[d] = d.Color
		end
	end
end

-- tints every part `amount` of the way to the storm colour; a no-op when that amount is already applied (a boss round
-- sits at a constant BOSS_DARK: no per-tick colour writes once the fade is done)
local function applyDark(rec, amount)
	if amount <= 0 and not rec.Dark then
		return
	end
	if rec.Dark and rec.DarkAmount == amount then
		return
	end
	colourStore(rec)
	for part, c in pairs(rec.Colours) do
		if part.Parent then
			part.Color = c:Lerp(K.STORM, amount)
		end
	end
	rec.Dark = amount > 0 or nil
	rec.DarkAmount = amount
end

local function restRec(rec)
	if not rec.Moving then
		return
	end
	for _, p in pairs(rec.Pieces) do
		restPiece(p)
	end
	if rec.Dark then
		applyDark(rec, 0)
		rec.Dark = nil
	end
	if rec.Light then
		rec.Light.Brightness = 0
	end
	if rec.Bolt then
		rec.Bolt.Parent = nil
	end
	for _, e in ipairs(rec.Emitters or {}) do
		e.Enabled = false
	end
	rec.Moving = false
end

local function shortName(model)
	local n = model:GetAttribute("Spectator")
	return type(n) == "string" and n or model.Name
end

local function trackExtras(crowd)
	if not crowd then
		return
	end
	for _, name in ipairs({ "FlagLine", "Bell" }) do
		local p = crowd:FindFirstChild(name)
		if p and p:IsA("BasePart") and not St.Extras[p] then
			local rec = piece(p)
			rec.Kind = (name == "FlagLine") and "Flags" or "Bell"
			collectKids(rec)
			St.Extras[p] = rec
		end
	end
end

local function track(model)
	if not model:IsA("Model") or St.Specs[model] then
		return
	end
	local name = shortName(model)
	local rec = {
		Model = model,
		Name = name,
		Phase = (St.Count * 0.37) % 1,
		Drummer = model:GetAttribute("Drummer") == true,
		Captain = name == "captain",
		Pieces = {},
		Moving = false,
	}
	local body0 = model:FindFirstChild("Body")
	if not (body0 and body0:IsA("BasePart")) then
		return -- not replicated yet: refresh() retries every REFRESH (it walks the tagged models)
	end
	for _, n in ipairs(PIECES) do
		local p = model:FindFirstChild(n)
		if p then
			rec.Pieces[n] = piece(p)
			collectKids(rec.Pieces[n])
		end
	end
	for _, side in ipairs(SIDES) do -- each arm's kind, read once (not two attribute reads per tick)
		local p = rec.Pieces[side]
		if p then
			p.Kind = p.Part:GetAttribute("CrowdKey")
			p.Sgn = (side == "ArmL") and -1 or 1
		end
	end
	local cap = rec.Pieces.Cap
	rec.Cap = cap and ((cap.Part:GetAttribute("CrowdKey") == "arena_crowd_captaincap") and "captain" or "sailor") or nil
	local body = rec.Pieces.Body
	if not body then
		return
	end
	rec.Seat = body.Pivot
	-- every other piece's pivot in the seat frame (they ride the body)
	for n, p in pairs(rec.Pieces) do
		p.Local = rec.Seat:ToObjectSpace(p.Pivot)
	end
	St.Specs[model] = rec
	St.Count = St.Count + 1
	trackExtras(model.Parent)
end

local function forget(model)
	local rec = St.Specs[model]
	if rec then
		restRec(rec)
		for _, inst in ipairs(rec.Owned or {}) do
			inst:Destroy()
		end
		St.Specs[model] = nil
		St.Count = St.Count - 1
	end
	-- extras whose crowd is gone
	for part, ex in pairs(St.Extras) do
		if not part.Parent then
			St.Extras[part] = nil
		end
	end
end

----------------------------------------------------------------------
-- Client-only bits: weather particles, the captain's flash
----------------------------------------------------------------------
local function own(rec, inst)
	rec.Owned = rec.Owned or {}
	rec.Owned[#rec.Owned + 1] = inst
	return inst
end

local function particles(rec, name, props)
	local body = rec.Pieces.Body and rec.Pieces.Body.Part
	if not body then
		return nil
	end
	local a = own(rec, Instance.new("Attachment"))
	a.Name = "CrowdFx_" .. name
	a.CFrame = rec.Pieces.Body.Off * CFrame.new(props.At or Vector3.new(0, 0.4, -0.6))
	a.Parent = body
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	FxSprites.Apply(e, props.Sprite or "Droplet") -- props.Sprite: an FxSprites role
	e.LightInfluence = 0.6
	e.Enabled = false
	for k, v in pairs(props) do
		if k ~= "At" and k ~= "Sprite" then
			e[k] = v
		end
	end
	e.Parent = a
	rec.Emitters = rec.Emitters or {}
	rec.Emitters[#rec.Emitters + 1] = e
	St.Emitters = St.Emitters + 1
	return e
end

local function ensureClientBits(rec)
	if rec.Bits then
		return
	end
	rec.Bits = true
	if rec.Name == "rain" then
		rec.Weather = particles(rec, "Drips", {
			Sprite = "Droplet",
			At = Vector3.new(0, 0.35, -0.9),
			Color = ColorSequence.new(Color3.fromRGB(126, 186, 242)),
			Rate = 3,
			Lifetime = NumberRange.new(0.5, 0.7),
			Speed = NumberRange.new(0.5, 1),
			Acceleration = Vector3.new(0, -14, 0),
			EmissionDirection = Enum.NormalId.Bottom,
			Size = NumberSequence.new(0.14),
			Transparency = NumberSequence.new(0.1),
		})
	elseif rec.Name == "snow" then
		rec.Weather = particles(rec, "Flakes", {
			Sprite = "Snow",
			At = Vector3.new(0, 3.4, -0.4),
			Color = ColorSequence.new(Color3.fromRGB(250, 252, 255)),
			Rate = 2,
			Lifetime = NumberRange.new(2.5, 3.5),
			Speed = NumberRange.new(0.3, 0.6),
			EmissionDirection = Enum.NormalId.Bottom,
			SpreadAngle = Vector2.new(30, 30),
			RotSpeed = NumberRange.new(-40, 40),
			Size = NumberSequence.new(0.16),
			Transparency = NumberSequence.new(0.15),
		})
	end
	-- boss-round drizzle under every cloud
	rec.Drizzle = particles(rec, "Drizzle", {
		Sprite = "Droplet",
		At = Vector3.new(0, 0.3, -0.5),
		Color = ColorSequence.new(Color3.fromRGB(150, 176, 220)),
		Rate = 6,
		Lifetime = NumberRange.new(0.45, 0.6),
		Speed = NumberRange.new(1, 2),
		Acceleration = Vector3.new(0, -16, 0),
		EmissionDirection = Enum.NormalId.Bottom,
		SpreadAngle = Vector2.new(25, 25),
		Size = NumberSequence.new(0.12),
		Transparency = NumberSequence.new(0.2),
	})
	if rec.Captain and rec.Pieces.Body then
		local body = rec.Pieces.Body.Part
		local light = own(rec, Instance.new("PointLight"))
		light.Name = "CrowdFx_Flash"
		light.Color = Color3.fromRGB(255, 236, 140)
		light.Brightness = 0
		light.Range = 14
		light.Shadows = false
		light.Parent = body
		rec.Light = light
		-- the lightning bolt: a zig-zag of two Beams over his cap (shown only during the flash)
		local bolt = own(rec, Instance.new("Folder"))
		bolt.Name = "CrowdFx_Bolt"
		local pts = { Vector3.new(-0.3, 7.2, -0.3), Vector3.new(0.5, 5.6, -0.4), Vector3.new(-0.1, 4.2, -0.5) }
		local atts = {}
		for i, p in ipairs(pts) do
			local a = Instance.new("Attachment")
			a.Name = "BoltA" .. i
			a.CFrame = rec.Pieces.Body.Off * CFrame.new(p)
			a.Parent = body
			atts[i] = own(rec, a)
		end
		for i = 1, 2 do
			local b = Instance.new("Beam")
			b.Name = "Bolt" .. i
			b.Attachment0 = atts[i]
			b.Attachment1 = atts[i + 1]
			b.Width0 = 0.55
			b.Width1 = 0.4
			b.Color = ColorSequence.new(Color3.fromRGB(255, 232, 90))
			b.LightEmission = 1
			b.FaceCamera = true
			b.Segments = 1
			b.Parent = bolt
		end
		rec.Bolt = bolt
	end
end

local function bodyPart(rec)
	return rec.Pieces.Body and rec.Pieces.Body.Part
end

----------------------------------------------------------------------
-- Cues and the battle hooks
----------------------------------------------------------------------
function RingCrowdFx.Cue(name)
	if name == "Boss" then
		St.Boss = true
		return
	end
	if name == "BossEnd" then
		St.Boss = false
		return
	end
	if name ~= "Hit" and name ~= "Won" and name ~= "Lost" then
		return
	end
	St.Cue = { Name = name, T0 = St.Time }
end

local function isRing(payload)
	return type(payload) == "table" and tostring(payload.Mode) == "Ring"
end

function RingCrowdFx.HandleState(kind, payload, battleId)
	if type(payload) ~= "table" and kind ~= "Events" then
		return
	end
	if kind == "Start" then
		if not isRing(payload) then
			return
		end
		St.Battle = { Id = payload.BattleId or battleId, Hits = 0, Sum = 0, LastCue = -math.huge }
		local ring = type(payload.Ring) == "table" and payload.Ring or {}
		local champ = type(ring.Champion) == "table" and ring.Champion or {}
		if champ.Boss == true then
			RingCrowdFx.Cue("Boss")
		else
			RingCrowdFx.Cue("BossEnd")
		end
	elseif kind == "Events" then
		local b = St.Battle
		if not b or type(payload) ~= "table" then
			return
		end
		if battleId ~= nil and b.Id ~= nil and battleId ~= b.Id then
			return
		end
		local big = false
		for _, ev in ipairs(payload) do
			if type(ev) == "table" then
				if ev.type == "KO" or ev.type == "Special" then
					big = true
				elseif ev.type == "Hit" and not ev.miss and tonumber(ev.dmg) then
					local dmg = tonumber(ev.dmg)
					if b.Hits >= K.BIG_MIN_HITS and dmg >= K.BIG_HIT * (b.Sum / b.Hits) then
						big = true
					end
					b.Hits = b.Hits + 1
					b.Sum = b.Sum + dmg
				end
			end
		end
		if big and St.Time - b.LastCue >= K.CUE_GAP then
			b.LastCue = St.Time
			RingCrowdFx.Cue("Hit")
		end
	elseif kind == "End" then
		local b = St.Battle
		local id = payload.BattleId or battleId
		if not b or (id ~= nil and b.Id ~= nil and id ~= b.Id) then
			return
		end
		if payload.Spectator ~= true then
			local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
			local won = payload.Won == true or payload.Outcome == "Win" or rw.Won == true
			RingCrowdFx.Cue(won and "Won" or "Lost")
		end
		RingCrowdFx.Cue("BossEnd")
		St.Battle = nil
	end
end

----------------------------------------------------------------------
-- The frame
----------------------------------------------------------------------
local function refresh()
	St.Quality = quality()
	-- a spectator whose tag arrived before its Body replicated was skipped by track(): pick it up now
	if St.Started then
		for _, model in ipairs(CollectionService:GetTagged(K.TAG)) do
			if not St.Specs[model] then
				track(model)
			end
		end
	end
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for model, rec in pairs(St.Specs) do
		local body = rec.Pieces.Body
		local near = camPos == nil or (body.Pivot.Position - camPos).Magnitude <= K.RANGE
		local on = near and model.Parent ~= nil and body.Part.Parent ~= nil
		if not on then
			restRec(rec)
		else
			ensureClientBits(rec)
			if not rec.Moving then
				for _, p in pairs(rec.Pieces) do
					collectKids(p)
				end
			end
		end
		rec.On = on
		local wet = on and St.Quality ~= "Low"
		if rec.Weather then
			rec.Weather.Enabled = wet
		end
	end
	for part, ex in pairs(St.Extras) do
		local near = camPos == nil or (ex.Pivot.Position - camPos).Magnitude <= K.RANGE
		local on = near and part.Parent ~= nil
		if not on and ex.Moving then
			restPiece(ex)
			ex.Moving = false
		end
		ex.On = on
	end
end

local function stepRec(rec, t, cueName, cueT)
	local pose = RingCrowdFx.Pose(rec, t, cueName, cueT, St.BossFade, rec.PoseBuf)
	rec.PoseBuf = pose
	local seat = rec.Seat * CFrame.new(0, pose.Lift, 0) * CFrame.Angles(pose.Lean, 0, pose.Roll)
	local P = rec.Pieces
	placePiece(P.Body, seat)
	for _, side in ipairs(SIDES) do
		local p = P[side]
		if p then
			local kind = p.Kind
			local rot
			if kind == "arena_crowd_stick" then
				rot = CFrame.Angles((p.Sgn < 0) and pose.StickL or pose.StickR, 0, 0)
			elseif kind == "arena_crowd_spyglass" then
				rot = CFrame.Angles(pose.Glass, 0, 0)
			else
				rot = CFrame.Angles(0, 0, p.Sgn * pose[side])
			end
			placePiece(p, seat * p.Local * rot)
		end
	end
	if P.Cap then
		placePiece(P.Cap, seat * P.Cap.Local * CFrame.new(0, pose.CapUp, 0) * CFrame.Angles(0, pose.CapSpin, 0))
	end
	if P.Drum then
		placePiece(P.Drum, seat * P.Drum.Local * CFrame.new(0, pose.DrumDip, 0)) -- dips under each stroke
	end
	if rec.Light then
		rec.Light.Brightness = 4 * pose.Flash
	end
	if rec.Bolt then
		rec.Bolt.Parent = (pose.Flash > 0.05) and bodyPart(rec) or nil
	end
	local dark = K.BOSS_DARK * St.BossFade
	if dark > 0 or rec.Dark then
		applyDark(rec, dark)
	end
	if rec.Drizzle then
		rec.Drizzle.Enabled = St.BossFade > 0.5 and St.Quality ~= "Low"
	end
	rec.Moving = true
	return pose
end

function RingCrowdFx.Step(dt)
	dt = tonumber(dt) or 0
	if dt <= 0 then
		return
	end
	St.Time = St.Time + dt
	St.BossFade = St.Boss and min(1, St.BossFade + dt) or max(0, St.BossFade - dt)
	St.RefreshAcc = St.RefreshAcc + dt
	if St.RefreshAcc >= K.REFRESH then
		St.RefreshAcc = 0
		refresh()
	end
	St.Acc = St.Acc + dt
	local hz = (St.Quality == "Low") and K.LOW_HZ or K.UPDATE_HZ
	if St.Acc < 1 / hz then
		return
	end
	St.Acc = 0
	local t = St.Time
	local cueName, cueT = nil, nil
	if St.Cue then
		cueName, cueT = St.Cue.Name, t - St.Cue.T0
		if cueT > K.WON_TIME + 0.5 then
			St.Cue = nil
			cueName, cueT = nil, nil
		end
	end
	local beat = floor(t * K.BPM / 60)
	if beat ~= St.LastBeat then
		St.LastBeat = beat
		St.Beats = St.Beats + 1
	end
	local bell = 0
	for _, rec in pairs(St.Specs) do
		if rec.On then
			local pose = stepRec(rec, t, cueName, cueT)
			bell = pose.BellSwing
		end
	end
	for _, ex in pairs(St.Extras) do
		if ex.On and ex.Part.Parent then
			if ex.Kind == "Flags" then
				local gust = St.Boss and 1.8 or 1
				local a = K.FLAG_SWING * gust * (0.65 * sin(TWO_PI * t / 3.1) + 0.35 * sin(TWO_PI * t / 1.7 + 1))
				placePiece(ex, ex.Pivot * CFrame.Angles(a, 0, 0))
			else
				placePiece(ex, ex.Pivot * CFrame.Angles(bell, 0, bell * 0.3))
			end
			ex.Moving = true
		end
	end
end

function RingCrowdFx.Stats()
	local moving = 0
	for _, rec in pairs(St.Specs) do
		if rec.Moving then
			moving = moving + 1
		end
	end
	return { Spectators = St.Count, Moving = moving, Writes = St.Writes, Beats = St.Beats,
		Cue = St.Cue and St.Cue.Name or nil, Boss = St.Boss, Quality = St.Quality, Emitters = St.Emitters }
end

function RingCrowdFx.Stop()
	for _, c in ipairs(St.Conns) do
		c:Disconnect()
	end
	St.Conns = {}
	local models = {}
	for model in pairs(St.Specs) do
		models[#models + 1] = model
	end
	for _, model in ipairs(models) do
		local rec = St.Specs[model]
		if rec then
			rec.Moving = true -- force the rest write
		end
		forget(model)
	end
	for part, ex in pairs(St.Extras) do
		restPiece(ex)
		St.Extras[part] = nil
	end
	St.Count = 0
	St.Emitters = 0
	St.Cue = nil
	St.Boss = false
	St.BossFade = 0
	St.Battle = nil
	St.Started = false
end

function RingCrowdFx.Init()
	if St.Started then
		return
	end
	St.Started = true
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceAddedSignal(K.TAG):Connect(track)
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceRemovedSignal(K.TAG):Connect(forget)
	for _, model in ipairs(CollectionService:GetTagged(K.TAG)) do
		track(model)
	end
	St.Conns[#St.Conns + 1] = RunService.Heartbeat:Connect(RingCrowdFx.Step)
	refresh()
	-- the battle flow (the same remote BattleController draws from; BattleState may arrive a little later)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
		local remote = folder and folder:WaitForChild("BattleState", 30)
		if not remote or not St.Started then
			return
		end
		St.Conns[#St.Conns + 1] = remote.OnClientEvent:Connect(function(kind, payload, battleId)
			pcall(RingCrowdFx.HandleState, kind, payload, battleId)
		end)
	end)
end

return RingCrowdFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1162">
            <Properties>
              <string name="Name">ShopController</string>
              <string name="Source"><![CDATA[-- ShopController (client; lobby-shop Tasks 21-22, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.3 "Who owns
-- it" / "Tabs and items" / "Window" / "Eggs tab" / "Packs, Passes, Boosts" / "Hooks"; moved with git mv from
-- StoreController, store W1 Task 7 of docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.1 / 8 / 13b): the ONE
-- Shop window. A left tab rail (Eggs, Gems, then the Robux items Packs, Passes, Boosts), the Eggs page (client/UI/ShopEggs:
-- the Secret Roulette hero and the four machine cards, every spin through client/UI/EggStage), the Gems page
-- (client/UI/ShopGems) and the Store's pack cards restyled into its content box. client/Controllers/StoreController is a
-- thin forwarder kept for old callers. (Task 22: the old Cloud Shop and its stage left MenuController.)
--
--   ShopController.Init()           also EggStage.Init() (the RouletteResult listener)
--   ShopController.Open(args)       args = { Tab = any alias NormalizeTab knows, RouletteId, Currency } | nil. Refused while
--                                   InMatch (the side hint "The Store is closed during a match.") and while the egg stage
--                                   shows -> false. No tab: the last tab of this session (the first time Eggs). RouletteId:
--                                   the Eggs tab, that card scrolled into view and outlined gold for 2.6 s
--                                   (ShopEggs.Focus); Currency alone never switches the tab. FromAltar = true (shop-area
--                                   16.17.3: the Storm Altar's prompt): the Secret card reads "at the altar" until Close
--                                   while the client has no live reading of the distance (ShopEggs.SetFromAltar; a live
--                                   reading always wins, so walking off locks the card; a later Open while open keeps it;
--                                   the server checks the distance again on every spin)
--   ShopController.Close()
--   ShopController.IsOpen() -> bool
--   ShopController.NormalizeTab(tab) -> "Eggs" | "Gems" | "Packs" | "Passes" | "Boosts" | nil   "egg*", "roul*", "Items",
--                                   "Shop" -> Eggs; "gem*", "Currency", "Tokens" -> Gems; Packs / Passes / Boosts in any case
--   ShopController.Tab() -> the tab shown (or last shown)
--   ShopController.Layout() -> "PC" | "Compact" (a PC design width under 1,400) | "Phone" | "Portrait"
--   ShopController.Portrait() -> bool
--   ShopController.Cards() -> { [key] = { State, Price, Tab } }   every card shown and every Gems-tab pack (tests)
--   ShopController.Palette(key) -> { Top, Bottom, Edge } | nil    a pack's own colours (tests, ShopGems)
--   ShopController.RobuxGlyph() -> "\238\128\130" (U+E002) or "R$" when the font lacks it
--   ShopController._S                the state table (tests: _S.Tab = nil is a fresh session)
--   signal ShopController.Toggled(open)  fired once per open (true) and per close (false); DailyController hides the
--                                    HUD Gifts button while the Shop is open (review round 1: it sat over the header)
--
-- Who opens it: the top bar's PillButton_Shop and a server OpenPanel("Shop" | "Store", args) through MenuController's
-- P5.openShop (and the forwarder). It fires MenuController.WindowOpened("Shop") on every open (spec 16.3 "WindowOpened";
-- the tutorial's ShopOpened); it closes on any other WindowOpened id, on Esc / gamepad B ("NimbusShopBack", High, bound
-- only while open, always Sink) / its X, on InMatch and on MenuController.Close(). MouseLock.WatchVisible("Shop",
-- ShopWindow) frees the cursor while it shows; on a phone or a touch-only device MenuController.SetTouchHidden("Shop",
-- true) and SetColumnCovered(windowLeft, "Shop").
-- The egg stage (Task 22): ShopWindow hides while EggStage shows (Opened) and comes back on Closed("Done" | "Error") while
-- the Shop is still open and not InMatch; any other Closed reason ("Match" | "Close") closes a still-open Shop. ONE Esc
-- handler: while the stage shows it calls EggStage.Back() (skip, then DONE) and stops there; else it closes the Shop.
-- While the stage shows B does nothing here (NimbusHatchBack, High + 1, is the stage's). The Eggs page repaints on
-- EggStage.Pending / Answered and once more WAIT_TIMEOUT after a Pending (the stage's timeout fires no signal).
-- The rail's FastHatch toggle (PC / Compact, Eggs only, under the tabs): ClientSettings.Set("FastHatch", not on).
--
-- Screen: ScreenGui "NimbusShop" (DisplayOrder 19, IgnoreGuiInset, ResetOnSpawn false) > Frame "ShopWindow" (UIScale
-- "Fit"; NeonKit.BigRect with RECT 820x330 at 390 px -> 1540x910 at 1080 px, PC_MAX_W 0.81) > Panel (the frame),
-- Header (Icon, Title "Shop", Balance_Gems and Balance_Tokens (Glyph: item 9 B's pixel gem / coin, Text: the amount),
-- CloseButton; balances Theme.ShortNumber
-- from 1e6), Rail (Tab_Eggs, Tab_Gems, RobuxDivider, Tab_Packs, Tab_Passes, Tab_Boosts: Icon + Label, attribute Selected;
-- Tab_Packs.Dot while the Starter Pack is on sale and unbought; FastHatch) and Body (the content box) > Page_Eggs
-- (ShopEggs), Page_Gems (ShopGems), Page_Packs / Page_Passes / Page_Boosts (ScrollingFrames of Card_<key>) and Soon ("The
-- Shop opens soon!" on an empty card page).
--   PC: header 76, rail 224 at x 18 (tabs 224 x 80 at y 16 + i * 92, +44 from Packs; the divider "Robux items"), content
--     x 262, width = window - 300 (1240). Compact: the rail 112 at x 8 (icon over label), content x 128, width window - 152.
--   Phone: header 50, rail 104 at x 8 (tabs 104 x 48 at 6 + i * 54 with a 280 px body; 104 x 44 at 4 + i * 49 under 276),
--     content x 120, width window - 128. Portrait: header rows (icon, Shop, X; both balances), the rail as one row of five
--     64 x 56 tabs, the body a vertical list.
-- Items: StoreCatalog.List(). Packs / Passes / Boosts show an item when created (Id > 0) or under the StorePreview
-- attribute (an Id 0 item is a "Preview" card: PREVIEW, disabled), as the Store did; the Gems page always shows its packs.
-- Card states: Buy, Owned (a pass in OwnedPasses), Claimed (a Once key in StoreBought), Loading (a Once item while
-- StoreBought is absent), Locked (lobby-shop 16.1: a Product that grants Tokens while PaidRandomItemsRestricted is not
-- false: "Token packs are not available on your account" / "Checking your account..." on the card, Buy inactive), Active /
-- HaveIt (an XP potion), Preview. Buy -> StoreRequest:FireServer("Buy", key) (1 s client gap; the gem potion's
-- StoreRequest("GemBuy", "XpPotionGems") shares it): the client never prompts a purchase or decides a price.
-- Prices: MarketplaceService:GetProductInfo once per session per created id, in the background, one retry after
-- Config.Store.PriceRetrySeconds; "..." meanwhile (Buy never waits for it).
-- Look (kit-b U9-2, finding 15: the Signboard kit of the Pets window): the wood frame round a stone body, the fixed-size
-- awning (SignKit.Roof) over the top, the navy header plank with the egg on its gold square and "Shop" as the window's
-- ribbon, the balances as stone tags, the red close block; tabs are stone blocks (the selected one gold); every card a
-- kit B block (NeonKit.Card Skin "Sign"): stone, a hero on the navy plank, a Have-it card the sunk well, the pack's own
-- PALETTE colour (the owner's "make colors for every pack") on its lip; card names plain Section headings; the hero's
-- Buy is the page's one green plank, every other Buy stone. While open the HUD's currency strips step aside
-- (HudController.SetCurrencyHidden("Shop")), so the balances show once.
-- Shine (GraphicsQuality High only, built on open, torn down on close): the hero's Buy pulses (1 -> 1.04) every 2.5 s, pet
-- cards show a turning CloudUI.PetViewport (kit B: no gloss gradient or sheen sweep).
-- Sounds: StorePop on a card tap (Click until AudioIds has it), StoreBuy on a purchase toast (Reward).
-- Art: the store_* render of spec 9 (TextureIds[ART_KEYS key], an ImageLabel "Image") when it has an id, else the glyph.
-- The Store switch (release step 1; Config.Store.Enabled through StoreCatalog.Enabled / ShownTabs, read on every refresh):
-- while it is off the rail shows Tab_Eggs only (plus Tab_Gems while a gem pack has an Id > 0), in the first slots of the
-- five-tab rail; the other tab buttons and RobuxDivider are hidden; no Card_<key> is built, StorePreview is ignored (no
-- PREVIEW), "The Shop opens soon!" and the Starter dot never show, no price is asked for a Store item, the gem potion
-- sends nothing, and a tab that is not on the rail (asked by name, or the session's last) opens Eggs. The Gems page shows
-- the created gem packs only (ShopGems). On = everything above, unchanged.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles; no asset ids (TextureIds numbers only).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local ContextActionService = game:GetService("ContextActionService")
local MarketplaceService = game:GetService("MarketplaceService")
local TextService = game:GetService("TextService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local StoreCatalog = require(Shared:WaitForChild("StoreCatalog"))
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-2) the awning over the window

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the header egg, the token coin, the card art
local ShopGems = require(Client:WaitForChild("UI"):WaitForChild("ShopGems"))
local ShopEggs = require(Client:WaitForChild("UI"):WaitForChild("ShopEggs"))
local EggStage = require(Client:WaitForChild("UI"):WaitForChild("EggStage"))
local State = require(Client:WaitForChild("State"))
local SoundFx = require(Client:WaitForChild("SoundFx"))
local ClientSettings = require(Client:WaitForChild("ClientSettings"))

local ShopController = {}
ShopController.Toggled = Util.Signal()

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local K = {
	DISPLAY_ORDER = 19,
	-- (kit-b U9-2) the Signboard: the wood frame's width round the stone body, the awning's fixed width
	FRAME = 6,
	ROOF_W = 360,
	-- the window box (NeonKit.BigRect; spec 16.3 "Window")
	RECT = { H0 = 390, W0 = 820, Y0 = 330, H1 = 1080, W1 = 1540, Y1 = 910 },
	MARGIN = 12,
	PHONE_W = 900,
	SHORT = 560,
	PC_MIN_H = 600,
	PC_MAX_W = 0.81,
	COMPACT_W = 1400, -- a PC design width under this is the Compact layout
	BUY_GAP = 1, -- seconds between two Buy sends
	TICK = 1, -- seconds between two refreshes while open (the potion's time left)
	BACK_ACTION = "NimbusShopBack",
	-- the rail's Fast hatch toggle (Eggs only): PC 224 x 52 ("Fast hatch" 20 px, the switch right), Compact 112 wide (the
	-- switch over the label, >= 44 px at the 0.8 scale)
	FAST = { PC = { W = 224, H = 52, Text = 20, SwitchW = 56, SwitchH = 30 }, Compact = { W = 112, H = 64, Text = 18, SwitchW = 48, SwitchH = 24 } },
	FAST_FOOT = 16, -- the toggle's gap over the rail's bottom
	FAST_GAP = 8, -- the least gap between the last tab and the toggle (a short window takes the rail's Short metrics)
	HATCH_WAIT = ((EggStage.Metrics and EggStage.Metrics.WAIT_TIMEOUT) or 7) + 0.1, -- an unanswered spin gives up: repaint
	PULSE_EVERY = 2.5,
	PULSE_SCALE = 1.04,
	ROBUX_GLYPH = "\238\128\130", -- U+E002
	ROBUX_FALLBACK = "R$",
	MATCH_HINT = "The Store is closed during a match.",
	SOON = "The Shop opens soon!",
	LOCK = "Token packs are not available on your account",
	CHECKING = "Checking your account...",
	SHORT_GEMS = "Not enough gems.",
	POTION_KEY = "XpPotionGems",
	RESTRICTED_ATTR = "PaidRandomItemsRestricted", -- GemService: true while restricted or unknown, false when allowed
	SCROLLBAR = SignKit.Sizes.ScrollBar, -- (LOOK-ui) the kit's one bar (was 6, black, round ends)
	ACCENT = rgb(90, 168, 232), -- the header (the A mock)
	NAVY = rgb(11, 16, 48),
	TABS = { "Eggs", "Gems", "Packs", "Passes", "Boosts" },
	GEM_PILES = { 1, 2, 4, 6 },
	-- the window per layout (design px): header, rail, content box
	WIN = {
		PC = { Header = 76, Icon = 42, TitleText = 34, TitleW = 200, GemsW = 140, TokW = 190, PillH = 44, PillText = 22, Close = 56,
			RailX = 18, RailW = 224, TabH = 80, TabY = 16, TabStep = 92, Split = 44, TabIcon = 40, TabLabel = 26, ContentX = 262, ContentR = 38,
			-- (Pitch 2 item 9 B; P2 icons review r1, major 4) the tabs' icons at the 54 px art size (3 px cells, the header
			-- glyph's), the label 12 px further right (TabArtX: the icon's inset)
			TabArt = 54, TabArtX = 12,
			-- (P2 icons look fin0) the balance pills' coin and gem at the glyph size (3 px cells; the mock-up's 27)
			PillIcon = 27,
			-- (a body too short for the five tabs + the Fast toggle: shorter tabs, the 12 px gap kept; the divider's 40 still
			-- fits; needs 504 of body)
			ShortTabH = 64, ShortTabY = 8, ShortTabStep = 76, ShortSplit = 52, ShortTabIcon = 32 },
		Compact = { Header = 76, Icon = 42, TitleText = 34, TitleW = 200, GemsW = 140, TokW = 190, PillH = 44, PillText = 22, Close = 56,
			RailX = 8, RailW = 112, TabH = 80, TabY = 16, TabStep = 92, Split = 44, TabIcon = 32, TabLabel = 18, ContentX = 128, ContentR = 24,
			-- (the owner's ~1024x600: 557 px of body, the full rail + toggle needs 596; Short needs 466, the shortest Compact
			-- body is 484; the label keeps its 18 above the 8 px lip, the tab 62 = 50 px on screen at the 0.8 scale, the
			-- 12 px gap between tabs kept so their wood edges do not meet)
			ShortTabH = 62, ShortTabY = 6, ShortTabStep = 74, ShortSplit = 14, ShortTabIcon = 24, PillIcon = 27 },
		Phone = { Header = 50, Icon = 28, TitleText = 20, TitleW = 130, GemsW = 96, TokW = 128, PillH = 32, PillText = 15, Close = 44,
			RailX = 8, RailW = 104, TabH = 48, TabY = 6, TabStep = 54, Split = 0, TabIcon = 24, TabLabel = 15, ContentX = 120, ContentR = 8,
			ShortBody = 276, ShortTabH = 44, ShortTabY = 4, ShortTabStep = 49 },
		Portrait = { Header = 84, Row = 44, Icon = 28, TitleText = 20, PillH = 32, PillText = 15, Close = 44,
			TabW = 64, TabH = 56, TabIcon = 22, TabLabel = 15, Pad = 8 },
	},
	-- the cards of Packs / Passes / Boosts (the Store's numbers)
	PHONE = { Gap = 8, Hero = 150, Card = 108, Art = 120, Pad = 8, Name = 24, Line = 16, Status = 15, Price = 20, BuyW = 150, BuyH = 48, BuyText = 20, Soon = 20 },
	PC = { Gap = 12, Hero = 250, Card = 150, Art = 210, Pad = 14, Name = 32, Line = 22, Status = 20, Price = 28, BuyW = 220, BuyH = 60, BuyText = 26, Soon = 30 },
	PORTRAIT = {
		Gap = 8, Art = 64, HeroArt = 84, Pad = 8, Name = 20, NameRows = 2, Line = 15, LineRows = 3, Status = 15, StatusRows = 3,
		Price = 20, PriceW = 92, BuyW = 104, BuyH = 44, BuyText = 18, Soon = 20,
	},
}

local Colors = Theme.Colors
local WHITE = Colors.White
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Theme.Neon.Gold
local SIGN = Theme.Sign -- (kit-b U9-2) the Signboard palette: brown ink on stone, wood edges, navy hero planks
local TAB_COLORS = { Eggs = "Green", Gems = "Blue", Packs = "Gold", Passes = "Purple", Boosts = "Pink" }

-- every pack's own colours (the owner's note, 2026-11-04): Top -> Bottom is the card's gradient (saturated, the Bottom
-- dark enough for white text), Edge its neon stroke and glow. No two packs share a pair.
local PALETTE = {
	Starter = { Top = rgb(255, 150, 30), Bottom = rgb(150, 40, 10), Edge = rgb(255, 214, 90) }, -- sunrise orange
	Pro = { Top = rgb(200, 70, 255), Bottom = rgb(70, 15, 140), Edge = rgb(255, 140, 255) }, -- royal purple
	VIP = { Top = rgb(255, 196, 40), Bottom = rgb(140, 70, 0), Edge = rgb(255, 236, 150) }, -- crown gold
	Cash2x = { Top = rgb(50, 215, 100), Bottom = rgb(5, 100, 45), Edge = rgb(150, 255, 170) }, -- money green
	PetXp2x = { Top = rgb(40, 190, 255), Bottom = rgb(15, 60, 170), Edge = rgb(150, 225, 255) }, -- sky blue
	XpPotion1 = { Top = rgb(255, 80, 170), Bottom = rgb(130, 15, 90), Edge = rgb(255, 170, 220) }, -- bubblegum
	XpPotion3 = { Top = rgb(140, 90, 255), Bottom = rgb(45, 20, 150), Edge = rgb(190, 160, 255) }, -- violet brew
	Tokens1 = { Top = rgb(90, 190, 255), Bottom = rgb(20, 80, 180), Edge = rgb(150, 220, 255) }, -- cloud blue
	Tokens2 = { Top = rgb(40, 210, 215), Bottom = rgb(5, 95, 120), Edge = rgb(150, 255, 245) }, -- lagoon
	Tokens3 = { Top = rgb(90, 110, 255), Bottom = rgb(30, 25, 160), Edge = rgb(170, 185, 255) }, -- storm cobalt
	Gems1 = { Top = rgb(50, 225, 160), Bottom = rgb(5, 110, 85), Edge = rgb(165, 255, 215) }, -- emerald
	Gems2 = { Top = rgb(255, 55, 95), Bottom = rgb(140, 10, 45), Edge = rgb(255, 160, 180) }, -- ruby
	Gems3 = { Top = rgb(190, 80, 255), Bottom = rgb(85, 15, 160), Edge = rgb(220, 150, 255) }, -- amethyst
	Gems4 = { Top = rgb(255, 130, 40), Bottom = rgb(175, 25, 120), Edge = rgb(255, 215, 130) }, -- fire opal
	Cash1 = { Top = rgb(130, 220, 60), Bottom = rgb(45, 110, 15), Edge = rgb(200, 255, 150) }, -- (not on sale: 13b.1)
	Cash2 = { Top = rgb(200, 225, 50), Bottom = rgb(100, 115, 5), Edge = rgb(240, 255, 150) },
	Cash3 = { Top = rgb(60, 200, 130), Bottom = rgb(10, 95, 55), Edge = rgb(170, 255, 205) },
}
local DIM_PALETTE = { Top = rgb(120, 124, 140), Bottom = rgb(45, 48, 60), Edge = rgb(150, 155, 170) } -- a Have-it card
local HERO_EDGE = 4.5 -- the hero's neon stroke (a card's is NeonKit's 3)
local CARD_EDGE = 3

-- the store_* render of each item (spec 9; TextureIds keys, the glyph while a key has no id)
local ART_KEYS = {
	Starter = "store_starter", Pro = "store_pro", VIP = "store_vip", Cash2x = "store_x2cash", PetXp2x = "store_x2xp",
	XpPotion1 = "store_potion_1h", XpPotion3 = "store_potion_3h",
}

local initialized = false
local LocalPlayer = nil
local U = { Tabs = {}, Pages = {}, Cards = {} } -- widgets
local S = {
	Open = false,
	Built = false,
	Token = 0,
	Tab = nil,
	Mode = "PC", -- NeonKit.BigRect's mode ("PC" | "Phone")
	Layout = "PC", -- "PC" | "Compact" | "Phone" | "Portrait"
	Scale = 1,
	Rect = nil,
	Items = {}, -- the card items shown (Packs / Passes / Boosts), in catalog order
	GemItems = {}, -- the Gems tab's items (always shown; the Store switch off: only the created gem packs)
	Tabs = { "Eggs", "Gems", "Packs", "Passes", "Boosts" }, -- the rail tabs shown (StoreCatalog.ShownTabs, re-read by refresh)
	ByKey = {},
	Signature = nil,
	States = {}, -- key -> { State, Status }
	Prices = {}, -- id -> whole Robux
	Asked = {}, -- id -> true once asked this session
	LastBuy = 0,
	Glyph = nil,
	TouchOff = false,
	CurrencyOff = false, -- (kit-b U9-2) the HUD's currency strips stepped aside (HudController.SetCurrencyHidden)
	BackBound = false,
	Shine = nil, -- { Tweens, Conn, Parts } while the shine runs
	Warned = {},
}
ShopController._S = S
local H = {}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[ShopController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, a, b = pcall(fn, ...)
	if not ok then
		warnOnce(key, a)
	end
	return ok, a, b
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

local function frame(name, parent, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function label(name, parent, text, role, size, props)
	local l = Theme.Label(text or "", role, { Size = size })
	l.Name = name
	l.BackgroundTransparency = 1
	l.TextWrapped = false
	l.TextTruncate = Enum.TextTruncate.AtEnd
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function csvSet(value)
	local out = {}
	if type(value) == "string" then
		for key in string.gmatch(value, "[^,%s]+") do
			out[key] = true
		end
	end
	return out
end

local function now()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

-- (kit-b U9-2) a square wood edge (mitred) on a kit B part
function H.edge(obj, px, color)
	local s = Util.Create("UIStroke", {
		Name = "SignEdge",
		Color = color or SIGN.Wood,
		Thickness = px or 3,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = obj,
	})
	-- (Pitch 2 F0, finish pass A) the kit's finish: the light on a wood edge and the face's lit top band (a tag on the
	-- band or in a card casts no shadow: the mock-up's)
	SignKit.FinishBlock(obj, { Out = px or 3, Wood = color == nil or color == SIGN.Wood, Shadow = false })
	return s
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.quality()
	local module = Client:FindFirstChild("GraphicsQuality")
	local ok, mod = pcall(function()
		return module and require(module)
	end)
	if ok and type(mod) == "table" and type(mod.Effective) == "function" then
		local okQ, q = pcall(mod.Effective)
		if okQ and q == "Low" then
			return "Low"
		end
	end
	return "High"
end

function H.hint(message)
	local menu = H.controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		safe("hint", menu.Hint, message, "info")
	end
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.attr(name)
	return LocalPlayer and LocalPlayer:GetAttribute(Config.Attr[name] or name) or nil
end

-- a purchase toast: the Store's "Thank you! ..." (StoreService.Thank) or a gem pack's "+550 Gems! Thank you for your
-- support!" (GemService.sendThanks)
function H.isThanks(message)
	if type(message) ~= "string" then
		return false
	end
	return message:sub(1, 9) == "Thank you" or string.match(message, "^%+[%d,]+ Gems! Thank you") ~= nil
end

function H.remote(name)
	local ok, remote = pcall(Remotes.Get, name)
	return ok and remote or nil
end

-- the sound of `key` when AudioIds has it, else the fallback (spec 5.1)
local function sfx(key, fallback)
	safe("sfx", function()
		SoundFx.Play(SoundFx.Id("Sfx", key) and key or fallback)
	end)
end

-- decided once on Init: the font draws the Robux glyph (wider than 2 px) or the text says "R$"
local function robuxGlyph()
	if S.Glyph then
		return S.Glyph
	end
	local ok, size = pcall(function()
		return Theme.Measure(K.ROBUX_GLYPH, Theme.Fonts.Display, 20, 1000)
	end)
	if ok and typeof(size) == "Vector2" and size.X > 2 then
		S.Glyph = K.ROBUX_GLYPH
	else
		S.Glyph = K.ROBUX_FALLBACK
	end
	return S.Glyph
end

-- shared/TextureIds (the upload session fills it; empty = every card keeps its glyph)
local function textureIds()
	if S.TextureIds == nil then
		local ok, ids = pcall(function()
			return require(Shared:FindFirstChild("TextureIds"))
		end)
		S.TextureIds = (ok and type(ids) == "table") and ids or {}
	end
	return S.TextureIds
end

-- the optional client/MouseLock (nil when missing)
function H.mouseLock()
	local module = Client:FindFirstChild("MouseLock")
	local ok, mod = pcall(function()
		return module and require(module)
	end)
	return (ok and type(mod) == "table" and type(mod.WatchVisible) == "function") and mod or nil
end

----------------------------------------------------------------------
-- What is shown
----------------------------------------------------------------------
-- the Store switch (release step 1): Config.Store.Enabled through StoreCatalog, read on every call
function H.storeOn()
	return StoreCatalog.Enabled()
end

function H.preview()
	return H.storeOn() and H.attr("StorePreview") == true
end

-- is this tab on the rail now (S.Tabs = StoreCatalog.ShownTabs)
function H.tabShown(tab)
	for _, name in ipairs(S.Tabs) do
		if name == tab then
			return true
		end
	end
	return false
end

-- the card items shown (created, or every one under StorePreview) and the Gems tab's items (always); the Eggs tab has none.
-- The Store switch off: no card item at all, and of the Gems tab only the CREATED gem packs (what the live game already
-- sold): nothing else is listed, priced, stated or sent.
function H.collect()
	local on = H.storeOn()
	local preview = H.preview()
	local items, gems, byKey, sig = {}, {}, {}, { on and (preview and "P" or "-") or "off" }
	for _, item in ipairs(StoreCatalog.List()) do
		if on then
			byKey[item.Key] = item
			if item.Tab == "Gems" then
				gems[#gems + 1] = item
			elseif item.Tab ~= "Eggs" and (item.Created or preview) then
				items[#items + 1] = item
				sig[#sig + 1] = item.Key .. ":" .. tostring(item.Id)
			end
		elseif item.Gem and item.Created then
			byKey[item.Key] = item
			gems[#gems + 1] = item
		end
	end
	return items, gems, byKey, table.concat(sig, "|")
end

-- the pass key that grants the x2 Pet XP perk (PetXp2x): a potion card says "you already have it" while it is owned
function H.xpPassKey()
	for _, item in ipairs(StoreCatalog.List()) do
		if item.Kind == "Pass" and type(item.Grants) == "table" and type(item.Grants.Perks) == "table" then
			for _, perk in ipairs(item.Grants.Perks) do
				if perk == "XpX2" then
					return item.Key
				end
			end
		end
	end
	return nil
end

function H.isPotion(item)
	return item.Tab == "Boosts" and not item.Once and type(item.Grants) == "table" and type(item.Grants.Boost) == "table"
		and type(item.Grants.Boost.XpPotion) == "number"
end

-- lobby-shop 16.1: the lock text while PaidRandomItemsRestricted is not false (true: restricted; absent: unknown), else nil
function H.lockText()
	local flag = LocalPlayer and LocalPlayer:GetAttribute(K.RESTRICTED_ATTR)
	if flag == false then
		return nil
	end
	return flag == true and K.LOCK or K.CHECKING
end

function H.timeLeft(seconds)
	local minutes = math.max(1, math.ceil(seconds / 60))
	if minutes >= 60 then
		return string.format("%d h %d m left", math.floor(minutes / 60), minutes % 60)
	end
	return string.format("%d m left", minutes)
end

-- -> state, status text (known = the StoreBought attribute exists: a real record is loaded)
function H.stateOf(item, owned, bought, xpPass, known, lock)
	if not item.Created then
		return "Preview", ""
	end
	if item.Once and not known then
		return "Loading", ""
	end
	if item.Kind == "Pass" then
		if owned[item.Key] then
			return "Owned", ""
		end
		return "Buy", ""
	end
	if item.Once and bought[item.Key] then
		return "Claimed", ""
	end
	if lock and type(item.Grants) == "table" and (tonumber(item.Grants.Tokens) or 0) > 0 then
		return "Locked", lock
	end
	if H.isPotion(item) then
		if xpPass and owned[xpPass] then
			return "HaveIt", "You already have x2 Pet XP forever!"
		end
		local ends = tonumber(H.attr("XpBoostEnds")) or 0
		local left = ends - now()
		local potion = type(Config.Store) == "table" and Config.Store.Potion or nil
		local cap = (type(potion) == "table" and tonumber(potion.CapSeconds)) or 7 * 86400
		if left >= cap then
			return "HaveIt", "Your potion is full!"
		end
		if left > 0 then
			return "Active", H.timeLeft(left)
		end
	end
	return "Buy", ""
end

-- the StoreBought attribute exists (absent = the record is loading or provisional: no Once pack can be decided)
function H.boughtKnown()
	return type(H.attr("StoreBought")) == "string"
end

function H.windowHero()
	local bought = csvSet(H.attr("StoreBought"))
	local starter = S.ByKey.Starter
	if starter and (starter.Created or H.preview()) and H.boughtKnown() and not bought.Starter then
		return starter
	end
	return S.ByKey.VIP
end

function H.tabItems(tab)
	local list = {}
	for _, item in ipairs(S.Items) do
		if item.Tab == tab then
			list[#list + 1] = item
		end
	end
	return list
end

-- the tab's hero: the window hero in its own tab, else the first Hero item not owned / claimed
function H.heroOf(tab)
	local hero = H.windowHero()
	local shown = {}
	for _, item in ipairs(H.tabItems(tab)) do
		shown[item.Key] = true
	end
	if hero and hero.Tab == tab and shown[hero.Key] then
		return hero
	end
	for _, item in ipairs(H.tabItems(tab)) do
		local st = S.States[item.Key]
		if item.Hero and not (st and (st.State == "Owned" or st.State == "Claimed" or st.State == "Loading")) then
			return item
		end
	end
	return nil
end

-- the heroes of every card tab, as a string: a change (a pack bought, the record arriving) rebuilds the pages
function H.heroSignature()
	local parts = {}
	for _, tab in ipairs({ "Packs", "Passes", "Boosts" }) do
		local hero = H.heroOf(tab)
		parts[#parts + 1] = hero and hero.Key or "-"
	end
	return table.concat(parts, "|")
end

function H.priceText(item)
	local n = item.Created and S.Prices[item.Id] or nil
	if n then
		return robuxGlyph() .. Util.Commas(n)
	end
	return "..."
end

----------------------------------------------------------------------
-- Prices (background, once per session per id, one retry)
----------------------------------------------------------------------
function H.fetchPrice(item, retry)
	local id = item.Id
	local infoType = item.Kind == "Pass" and Enum.InfoType.GamePass or Enum.InfoType.Product
	task.spawn(function()
		local ok, info = pcall(function()
			return MarketplaceService:GetProductInfo(id, infoType)
		end)
		local price = ok and type(info) == "table" and tonumber(info.PriceInRobux) or nil
		if price and price > 0 then
			S.Prices[id] = math.floor(price)
			if S.Open then
				safe("prices", H.paintCards)
			end
		elseif not retry then
			local seconds = (type(Config.Store) == "table" and tonumber(Config.Store.PriceRetrySeconds)) or 10
			task.delay(seconds, function()
				if not S.Prices[id] then
					H.fetchPrice(item, true)
				end
			end)
		end
	end)
end

function H.askPrices()
	for _, list in ipairs({ S.Items, S.GemItems }) do
		for _, item in ipairs(list) do
			if item.Created and not S.Asked[item.Id] then
				S.Asked[item.Id] = true
				H.fetchPrice(item, false)
			end
		end
	end
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
function H.build()
	if S.Built then
		return
	end
	S.Built = true
	local holder = frame("ShopWindow", U.Gui, { Visible = false, Active = true })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-2) the frame: the wood frame round the stone body with its lip (the Signboard skin of the Pets window)
	local panel = frame("Panel", holder, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Wood, Size = UDim2.fromScale(1, 1) })
	panel:SetAttribute("SignKit", "Frame")
	local stone = frame("Stone", panel, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME),
	})
	stone:SetAttribute("SignKit", "Body")
	frame("Lip", stone, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.StoneLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, SignKit.Sizes.Lip),
	})
	SignKit.FinishFrame(panel, { Body = stone }) -- (Pitch 2 F0) the frame's light, the window's shadow, the carved body

	-- the header: the navy plank, the egg on its gold square, "Shop", the two balances, the X
	local header = frame("Header", holder)
	U.Header = header
	U.Band = frame("Band", header, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Navy })
	frame("Lip", U.Band, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.NavyLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 4),
	})
	SignKit.BandTop(U.Band) -- (Pitch 2 F0) the navy band's lit top line
	U.Icon = label("Icon", header, "", "Display", 42, {
		TextTruncate = Enum.TextTruncate.None, BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, TextColor3 = SIGN.Text,
	})
	-- (LOOK-ui, kitb-look1: one style across screens) the Signboard header's icon slot: SignKit.Sizes.IconSlot square, a 2 px
	-- brown ink line (was a 46 px square in a 3 px wood edge)
	H.edge(U.Icon, 2, SIGN.Text)
	-- (Pitch 2 item 9 B; P2 icons review r1, major 5: the egg here read as the Eggs tab under it) the shop stall in its own
	-- colours on the gold slot (the mock-up's header), sized with the label
	PixelIcon.Host(U.Icon, NeonKit.IconName("Shop"))
	U.Title = label("Title", header, "Shop", "Title", 34, { TextXAlignment = Enum.TextXAlignment.Left })
	U.Title:SetAttribute("RibbonBand", "NoTails") -- (render gate) the band ends square on the navy plank (its tails read as a glitchy block there)
	Theme.StyleTitle(U.Title)
	-- (kit-b U9-2) the balances: stone tags in their wood edge, brown amounts (the HUD strips step aside while the Shop is
	-- open: HudController.SetCurrencyHidden, so they show once)
	local function pill(id)
		local cur = Theme.Currency[id]
		local root = frame("Balance_" .. id, header, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Tile })
		H.edge(root, 3)
		return root, cur
	end
	-- (P2 icons look fin0, major 2: the Gems pill held the cut GemIcon, a smooth square turned 45 degrees, beside the
	-- pixel coin) both pills as the mock-up's (10_optA): item 9 B's icon ("Glyph", in its own colours, at R.PillIcon:
	-- H.layoutHeader hosts it) and the amount ("Text"); the gem and its amount centred in their pill
	U.GemsPill = pill("Gems")
	U.GemGlyph = label("Glyph", U.GemsPill, "", "Display", 22, { TextColor3 = SIGN.Text, TextTruncate = Enum.TextTruncate.None })
	U.GemText = label("Text", U.GemsPill, "0", "Display", 22, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Text })
	local tokPill = pill("Tokens")
	U.TokPill = tokPill
	U.TokGlyph = label("Glyph", tokPill, "", "Display", 22, { TextColor3 = SIGN.GoldLip, TextTruncate = Enum.TextTruncate.None })
	U.TokText = label("Text", tokPill, "0", "Display", 22, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Text })
	U.Close = CloudUI.Button({
		Name = "CloseButton",
		Text = "",
		Style = "Red",
		Skin = "Sign",
		Size = UDim2.fromOffset(44, 44),
		TextSize = 22,
		Callback = function()
			ShopController.Close()
		end,
		Parent = header,
	})
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = SIGN.Text }) -- the drawn X in a Danger block's brown ink
	NeonKit.CloseBlock(U.Close) -- (LOOK-ui, kitb-look1) the windows' one close block: its x in 3 px cells (was 2 at the 0.8 Fit)
	-- the awning: one fixed-size piece over the top rim (never stretched with the window: the sign rule)
	U.Roof = SignKit.Roof(holder, { Width = K.ROOF_W, Y = SignKit.RoofSeat(), ZIndex = 3 }) -- (F0 review) seated on the frame

	-- the rail: stone tab blocks, the selected one gold (H.selectTab paints them)
	local rail = frame("Rail", holder)
	U.Rail = rail
	for i, tab in ipairs(K.TABS) do
		local button = Instance.new("TextButton")
		button.Name = "Tab_" .. tab
		button.Text = ""
		button.AutoButtonColor = false
		button.BorderSizePixel = 0
		button.LayoutOrder = i
		local name = label("Label", button, tab, "Button", 26, { TextXAlignment = Enum.TextXAlignment.Left })
		local outline = CloudUI.SignBlock(button, "Stone", { Pad = false })
		button.Parent = rail
		button.Activated:Connect(function()
			safe("tab", H.tapTab, tab)
		end)
		U.Tabs[tab] = { Button = button, Label = name, Stroke = outline }
	end
	-- the Starter Pack's mark: a small red square in its wood edge (the HUD tiles' attention badge)
	U.Dot = frame("Dot", U.Tabs.Packs.Button, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Red, Visible = false, ZIndex = 3 })
	H.edge(U.Dot, 2)
	U.Divider = frame("RobuxDivider", rail)
	-- (Pitch 2 F0 A: "'ROBUX ITEMS' as a captioned rule"; look review major 6: the Robux glyph drew as a dark square next to
	-- a loose label) the caption centred between two dotted rules (SignKit.Rule). The glyph stays built, hidden
	U.DivGlyph = label("Glyph", U.Divider, robuxGlyph(), "Display", 24, { TextColor3 = SIGN.Text, TextTruncate = Enum.TextTruncate.None, Visible = false })
	U.DivLabel = label("Label", U.Divider, "ROBUX ITEMS", "Body", 18, { TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = SIGN.TextMuted })
	U.DivRuleL = SignKit.Rule(U.Divider, { Name = "RuleL" })
	U.DivRuleR = SignKit.Rule(U.Divider, { Name = "RuleR" })
	U.DivLine = frame("Line", U.Divider, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.WellEdge })
	-- the Fast hatch toggle (Eggs only): a stone block with its Label and the kit's switch (CloudUI.SignSwitch: a sunk
	-- well, the square Knob slides; gold while on; the egg stage's Fast hatch chip draws the same part); attribute On
	local fast = Instance.new("TextButton")
	fast.Name = "FastHatch"
	fast.Text = ""
	fast.AutoButtonColor = false
	fast.BorderSizePixel = 0
	fast.Visible = false
	U.FastLabel = label("Label", fast, "Fast hatch", "Button", 20, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Text })
	CloudUI.SignBlock(fast, "Stone", { Pad = false })
	U.FastSwitch = CloudUI.SignSwitch(fast, { ZIndex = fast.ZIndex })
	U.FastKnob = U.FastSwitch:FindFirstChild("Knob")
	fast.Parent = rail
	fast.Activated:Connect(function()
		safe("fast hatch", H.toggleFast)
	end)
	U.Fast = fast

	-- the body (the content box): the Eggs page, the Gems page and the card pages
	local body = frame("Body", holder, { ClipsDescendants = true })
	U.Body = body
	local eggsPage = frame("Page_Eggs", body, { Visible = false })
	U.EggsPage = eggsPage
	ShopEggs.Build(eggsPage, {
		Tap = function()
			sfx("StorePop", "Click")
		end,
		-- (shop-area 16.17.3) the Secret card's TRAVEL closes the Shop once it has asked for the trip
		Close = function()
			ShopController.Close()
		end,
	})
	local gemsPage = frame("Page_Gems", body, { Visible = false })
	U.GemsPage = gemsPage
	ShopGems.Build(gemsPage, {
		Buy = function(key)
			safe("buy", H.buy, key)
		end,
		GemBuy = function()
			safe("gem buy", H.gemBuy)
		end,
		Palette = function(key)
			return ShopController.Palette(key)
		end,
		Price = function(item)
			return item.Created and S.Prices[item.Id] or nil
		end,
		Robux = robuxGlyph,
		Preview = H.preview,
		State = function(key)
			local st = S.States[key]
			return st and st.State or "Preview"
		end,
		LockText = H.lockText,
	})
	U.Soon = label("Soon", body, K.SOON, "Heading", 30, { Visible = false, TextWrapped = true, Size = UDim2.fromScale(1, 1), TextColor3 = SIGN.Text })
	local ml = H.mouseLock()
	if ml then
		safe("mouse lock", ml.WatchVisible, "Shop", holder)
	end
end

-- the tab's icon through NeonKit.Icon (the only path that reads Config.Icons): rebuilt when Config.Icons[tab] or the size
-- changed
function H.syncTabIcon(tab, px, art)
	local t = U.Tabs[tab]
	local icons = Config.Icons
	local want = type(icons) == "table" and icons[tab] or nil
	if type(want) ~= "string" or want == "" then
		want = false
	end
	if t.Icon and t.IconImage == want and t.IconPx == px and t.IconArt == art then
		return
	end
	if t.Icon then
		t.Icon:Destroy()
	end
	-- (Pitch 2 item 9 B; P2 icons review r1) the Gems tab draws the B gem like the other four (the finer cut gem mixed two
	-- pixel sizes in the column); `art`: the hosted icon drawn at that px (the PC rail's 54 px art size)
	t.Icon = NeonKit.Icon(t.Button, tab == "Gems" and "gem" or tab, px)
	local pixelName = art and t.Icon:GetAttribute("PixelIcon")
	if pixelName then
		PixelIcon.Host(t.Icon, pixelName, art)
	end
	if t.Icon:IsA("TextLabel") then -- an asset-id icon is an ImageLabel (no TextColor3: the write would throw)
		t.Icon.TextColor3 = SIGN.Text -- (kit-b U9-2) brown on the stone / gold tab
	end
	t.IconImage = want
	t.IconPx = px
	t.IconArt = art
end

-- the pack's colours (a key without an entry: its tab's neon colour)
function H.palette(item)
	local p = PALETTE[item.Key]
	if p then
		return p
	end
	local c = Theme.NeonColor(TAB_COLORS[item.Tab] or "Blue")
	return { Top = c, Bottom = Theme.Darken(c, 0.6), Edge = Theme.Lighten(c, 0.3) }
end

-- (kit-b U9-2) paints a card as a kit B block: the face stone (a hero the navy plank, a Have-it card the sunk well), the
-- wood edge, the lip in the pack's own colour (the owner's "make colors for every pack" lives there; one colour by role:
-- the face never carries it); the art in its well; the texts in the ink that reads on the face (H.ink)
function H.paint(entry, dim)
	local p = dim and DIM_PALETTE or H.palette(entry.Item)
	local hero = entry.Hero and not dim
	entry.Card.SetFill(hero and SIGN.Navy or (dim and SIGN.Well or SIGN.Tile))
	entry.Card.SetColor(dim and SIGN.WellEdge or p.Top)
	entry.Card.Stroke.Color = hero and SIGN.GoldLip or SIGN.Wood
	entry.Card.Stroke.Thickness = entry.Hero and HERO_EDGE or CARD_EDGE
	entry.Art.BackgroundColor3 = hero and SIGN.NavyLight or SIGN.PetWell
	entry.Glyph.TextColor3 = hero and SIGN.Gold or SIGN.Text
end

-- (kit-b U9-2) a card text's ink: on the navy hero the gold heading, white lines and gold status; on stone brown, the
-- muted brown for the small print
function H.ink(entry, kind)
	if entry.Hero and entry.Dim ~= true then
		if kind == "Name" or kind == "Status" then
			return SIGN.Gold
		end
		return WHITE
	end
	if kind == "Muted" or kind == "Status" then
		return SIGN.TextMuted
	end
	return SIGN.Text
end

-- the art box shows the render (Image) or the glyph, unless a pet viewport covers it (High)
function H.showArt(entry, on)
	if entry.Image then
		entry.Image.Visible = on
		entry.Glyph.Visible = false
	else
		entry.Glyph.Visible = on
	end
end

function H.artKey(item)
	if ART_KEYS[item.Key] then
		return ART_KEYS[item.Key]
	end
	local kind, n = string.match(item.Key, "^(%a+)(%d+)$")
	if kind == "Gems" or kind == "Tokens" or kind == "Cash" then
		return "store_" .. string.lower(kind) .. "_" .. n
	end
	return nil
end

-- one card: Art | Name + Gets you lines + Status | PricePill over Buy
function H.buildCard(item, page, isHero)
	-- (kit-b U9-2) a kit B block (NeonKit.Card Skin "Sign"): H.paint gives it its face, edge and the pack's lip
	local card = NeonKit.Card({
		Name = "Card_" .. item.Key,
		Class = "TextButton",
		Skin = "Sign",
		BodyOverLip = true, -- the card's rows lie over its lip, as the Shop drew them
		Size = UDim2.fromOffset(600, 108),
		ClipsDescendants = isHero == true,
		Parent = page,
	})
	card.Root:SetAttribute("Hero", isHero == true)
	card.Root:SetAttribute("Key", item.Key)
	card.Root.Activated:Connect(function()
		sfx("StorePop", "Click")
	end)
	local b = card.Body
	local art = frame("Art", b, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell })
	-- (LOOK-ui, kitb-look1: the pitch's .dw) the art's well in its 2 px edge, as the pet wells
	local artEdge = Instance.new("UIStroke")
	artEdge.Name = "SignEdge"
	artEdge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	artEdge.LineJoinMode = Enum.LineJoinMode.Miter
	artEdge.Color = SIGN.WellEdge
	artEdge.Thickness = 2
	artEdge.Parent = art
	local glyph = label("Glyph", art, "", "Display", 40, { Size = UDim2.fromScale(1, 1), TextTruncate = Enum.TextTruncate.None })
	glyph:SetAttribute("PixelIcon", H.artGlyph(item))
	PixelIcon.Host(glyph, H.artGlyph(item)) -- (kit-b U7a) the card's icon, sized with the art box
	local image = nil
	local artKey = H.artKey(item)
	local artId = artKey and tonumber(textureIds()[artKey]) or nil
	if artId and artId > 0 and artId == math.floor(artId) then
		image = Util.Create("ImageLabel", {
			Name = "Image",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = "rbxassetid://" .. tostring(artId),
			ScaleType = Enum.ScaleType.Fit,
			Size = UDim2.fromScale(1, 1),
			Parent = art,
		})
		glyph.Visible = false
	end
	-- (kit-b U9-2; the owner's ruling 2026-11-14) a card's name is a plain Section heading: the ribbon is the window's
	local name = Theme.StyleTitle(label("Name", b, item.Name or item.Key, "Title", 24, { TextXAlignment = Enum.TextXAlignment.Left }), "Section")
	local gets = label("GetsYou", b, "Gets you:", "Body", 16, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = MUTED })
	local lines = {}
	local texts = StoreCatalog.GrantLines(item.Grants)
	if type(item.Line) == "string" and item.Line ~= "" then
		texts[#texts + 1] = item.Line
	end
	for i, text in ipairs(texts) do
		lines[i] = label("Line" .. i, b, text, "Body", 16, { TextXAlignment = Enum.TextXAlignment.Left })
	end
	local status = label("Status", b, "", "Body", 15, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = GOLD })
	-- the price: a gold tag in its wood edge (brown ink)
	local pricePill = NeonKit.Card({ Name = "PricePill", Skin = "Sign", BodyOverLip = true, Face = SIGN.Gold, Lip = SIGN.GoldLip, Parent = b })
	pricePill.Stroke.Thickness = 2
	local price = label("Text", pricePill.Body, "...", "Display", 20, { Size = UDim2.fromScale(1, 1), TextColor3 = SIGN.Text })
	local buyHolder = frame("BuyHolder", b)
	local pulse = Util.Create("UIScale", { Name = "Pulse", Scale = 1, Parent = buyHolder })
	-- one colour by role: the hero's Buy is the page's one green plank, every other Buy a stone plank
	local buy = CloudUI.Button({
		Name = "Buy",
		Text = "Buy",
		Style = isHero and "Green" or "Blue",
		Skin = "Sign",
		Size = UDim2.fromScale(1, 1),
		TextSize = 20,
		Callback = function()
			safe("buy", H.buy, item.Key)
		end,
		Parent = buyHolder,
	})
	local entry = {
		Item = item, Card = card, Root = card.Root, Art = art, Glyph = glyph, Image = image, Name = name, GetsYou = gets,
		Lines = lines, Status = status, PricePill = pricePill, Price = price, BuyHolder = buyHolder, Pulse = pulse, Buy = buy,
		Hero = isHero == true,
	}
	H.paint(entry, false)
	U.Cards[item.Key] = entry
	return entry
end

-- (kit-b U7a) the PixelIcon a card's art box draws when it has no render
function H.artGlyph(item)
	local g = type(item.Grants) == "table" and item.Grants or {}
	if item.Key == "VIP" then
		return NeonKit.IconName("VipCrown")
	end
	if g.Tokens and not g.Pets then
		return Theme.Currency.Tokens.Icon
	end
	if g.Cash and not g.Pets then
		return Theme.Currency.Cash.Icon
	end
	-- (LOOK-ui, kitb-look1: one ticket on every pass, one potion on every boost) a pass shows what it doubles, a boost its
	-- potion
	if not g.Pets then
		for _, perk in ipairs(type(g.Perks) == "table" and g.Perks or {}) do
			if perk == "CashX2" then
				return Theme.Currency.Cash.Icon
			elseif perk == "XpX2" or perk == "ProXp" then
				return "star"
			end
		end
		if type(g.Boost) == "table" and g.Boost.XpPotion then
			return "potion"
		end
	end
	return NeonKit.IconName(item.Tab) or NeonKit.IconName("Store")
end

-- (re)builds every card page when the shown set changed
function H.rebuild()
	local wasShine = S.Shine ~= nil
	H.shineOff()
	for _, page in pairs(U.Pages) do
		page:Destroy()
	end
	U.Pages = {}
	U.Cards = {}
	-- the states first: the heroes depend on them
	H.computeStates()
	for i, tab in ipairs({ "Packs", "Passes", "Boosts" }) do
		local page = Instance.new("ScrollingFrame")
		page.Name = "Page_" .. tab
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		SignKit.Scroll(page, K.SCROLLBAR)
		page.ScrollingDirection = Enum.ScrollingDirection.Y
		page.CanvasSize = UDim2.new()
		page.Size = UDim2.fromScale(1, 1)
		page.Visible = false
		page.LayoutOrder = i
		page.Parent = U.Body
		U.Pages[tab] = page
		local hero = H.heroOf(tab)
		local order = 1
		if hero then
			H.buildCard(hero, page, true).Order = order
		end
		for _, item in ipairs(H.tabItems(tab)) do
			if item ~= hero then
				order = order + 1
				H.buildCard(item, page, false).Order = order
			end
		end
	end
	if wasShine and S.Open then
		H.shineOn()
	end
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
function H.cardMetrics()
	if S.Layout == "Portrait" then
		return K.PORTRAIT
	end
	return S.Layout == "Phone" and K.PHONE or K.PC
end

function H.layoutCard(entry, w, h, M)
	local pad = M.Pad
	place(entry.Root, entry.Root.Position.X.Offset, entry.Root.Position.Y.Offset, w, h)
	-- one line each (a portrait layout before may have wrapped them)
	entry.Name.TextWrapped = false
	entry.GetsYou.TextWrapped = false
	entry.Status.TextWrapped = false
	for _, line in ipairs(entry.Lines) do
		line.TextWrapped = false
	end
	local art = math.max(40, math.min(M.Art, h - 2 * pad, math.floor(w * 0.3)))
	place(entry.Art, pad, math.floor((h - art) / 2), art, art)
	entry.Glyph.TextSize = math.min(100, math.max(20, math.floor(art * 0.5))) -- Roblox caps TextSize at 100
	local buyW, buyH = math.min(M.BuyW, math.floor(w * 0.3)), M.BuyH
	local rightX = w - pad - buyW
	local buyY = h - pad - buyH
	place(entry.BuyHolder, rightX, buyY, buyW, buyH)
	entry.Buy.TextSize = M.BuyText
	local pillH = M.Price + 8
	place(entry.PricePill.Root, rightX + math.floor(buyW * 0.1), buyY - 4 - pillH, math.floor(buyW * 0.8), pillH)
	entry.Price.TextSize = M.Price
	local textX = pad + art + pad
	local textW = math.max(40, rightX - pad - textX)
	local nameH = M.Name + 4
	local lineH = M.Line + 3
	local statusOn = entry.Status.Text ~= ""
	place(entry.Name, textX, pad, textW, nameH)
	entry.Name.TextSize = M.Name
	local y = pad + nameH + 2
	-- a locked card says why first (lobby-shop 16.1), the lines that no longer fit step aside
	if statusOn and entry.StatusFirst then
		place(entry.Status, textX, y, textW, M.Status + 3)
		y = y + M.Status + 3
	end
	-- (LOOK-ui, kitb-look1: the Starter card said "Gets you:" over its lines, the Pro card under it did not, by room alone)
	-- the lines speak for themselves on every card: no "Gets you:" heading
	entry.GetsYou.Visible = false
	for _, line in ipairs(entry.Lines) do
		place(line, textX, y, textW, lineH)
		line.TextSize = M.Line
		line.Visible = not entry.StatusFirst or y + lineH <= h - pad + 2
		y = y + lineH
	end
	if not entry.StatusFirst then
		place(entry.Status, textX, y, textW, M.Status + 3)
	end
	entry.Status.TextSize = M.Status
	entry.Status.Visible = statusOn
end

-- the rows `text` wraps to at `size` in `width` px (TextService measures the real font; 1 when it cannot)
local function rowsOf(lbl, text, size, width)
	local ok, v = pcall(function()
		return Theme.MeasureLabel(lbl, text, size, width)
	end)
	if not ok or typeof(v) ~= "Vector2" or v.Y <= 0 then
		return 1
	end
	return math.max(1, math.floor(v.Y / size + 0.5))
end

-- a portrait card (w wide): the art left of the texts, each text as many rows as it needs (up to its cap), the price
-- pill and Buy on a row under both; answers the card's height
function H.layoutCardPortrait(entry, w, M)
	local pad = M.Pad
	local art = entry.Hero and M.HeroArt or M.Art
	local textX = pad + art + pad
	local textW = w - textX - pad
	local y = pad
	local function put(lbl, size, maxRows, lineH)
		lbl.TextSize = size
		local rows = math.min(maxRows, rowsOf(lbl, lbl.Text, size, textW))
		lbl.TextWrapped = rows > 1
		place(lbl, textX, y, textW, rows * lineH)
		y = y + rows * lineH
	end
	put(entry.Name, M.Name, M.NameRows, M.Name + 2)
	y = y + 2
	local statusOn = entry.Status.Text ~= ""
	entry.Status.Visible = statusOn
	if statusOn and entry.StatusFirst then
		put(entry.Status, M.Status, M.StatusRows, M.Status + 3)
	end
	entry.GetsYou.Visible = false -- (LOOK-ui) no "Gets you:" heading on any card (as the landscape layout)
	for _, line in ipairs(entry.Lines) do
		line.Visible = true
		put(line, M.Line, M.LineRows, M.Line + 3)
	end
	if statusOn and not entry.StatusFirst then
		put(entry.Status, M.Status, M.StatusRows, M.Status + 3)
	end
	place(entry.Art, pad, pad, art, art)
	entry.Glyph.TextSize = math.min(100, math.max(20, math.floor(art * 0.5)))
	local rowY = math.max(y, pad + art) + 6
	local buyX = w - pad - M.BuyW
	place(entry.BuyHolder, buyX, rowY, M.BuyW, M.BuyH)
	entry.Buy.TextSize = M.BuyText
	local pillH = M.Price + 8
	place(entry.PricePill.Root, buyX - 8 - M.PriceW, rowY + math.floor((M.BuyH - pillH) / 2), M.PriceW, pillH)
	entry.Price.TextSize = M.Price
	local h = rowY + M.BuyH + pad
	place(entry.Root, entry.Root.Position.X.Offset, entry.Root.Position.Y.Offset, w, h)
	return h
end

-- the header (W wide): the accent band, the egg, "Shop", the balances right of it, the X; portrait: two rows
function H.layoutHeader(W, R)
	local portrait = S.Layout == "Portrait"
	place(U.Header, 0, 0, W, R.Header)
	-- (kit-b U9-2) the navy plank inside the wood frame (the frame's edge shows round it)
	local F = K.FRAME
	place(U.Band, F, F, W - 2 * F, (portrait and R.Row or R.Header) - F)
	local closeY = portrait and 0 or math.floor((R.Header - R.Close) / 2) -- (portrait: clear of the balances' row under it)
	place(U.Close, W - R.Close - (portrait and F + 3 or 10), closeY, R.Close, R.Close) -- (its drawn X scales with it)
	local rowH = portrait and R.Row or R.Header
	-- the egg on its gold square (the Signboard header's icon slot), the icon a little inside it
	local slot = R.Icon -- (LOOK-ui, kitb-look1) SignKit.Sizes.IconSlot on PC (42), as every Signboard window
	place(U.Icon, portrait and 10 or 16, F + math.floor((rowH - F - slot) / 2), slot, slot)
	U.Icon.TextSize = math.max(12, R.Icon - 10)
	U.Title.TextSize = R.TitleText
	local gw, tw, py
	if portrait then
		place(U.Title, 44, 0, W - 44 - R.Close - 8, R.Row)
		gw = math.floor((W - 2 * 8 - 8) / 2)
		tw = gw
		py = R.Row + 4
		place(U.GemsPill, 8, py, gw, R.PillH)
		place(U.TokPill, 8 + gw + 8, py, tw, R.PillH)
	else
		place(U.Title, R.Icon + 26, 0, R.TitleW, R.Header)
		gw, tw = R.GemsW, R.TokW
		py = math.floor((R.Header - R.PillH) / 2)
		local tokX = W - R.Close - 10 - 12 - tw
		place(U.TokPill, tokX, py, tw, R.PillH)
		place(U.GemsPill, tokX - 10 - gw, py, gw, R.PillH)
	end
	-- (P2 icons look fin0, minor: the coin was 18 px, the mock-up's about 27) the pills' icons at the screen's glyph size
	-- (R.PillIcon: 27 on PC, 3 px cells; 18 on a phone), the coin and the gem alike
	local ip = R.PillIcon or 18
	for _, g in ipairs({ { U.TokGlyph, Theme.Currency.Tokens.Icon }, { U.GemGlyph, "gem" } }) do
		if g[1]:GetAttribute("IconPx") ~= ip then
			g[1]:SetAttribute("IconPx", ip)
			PixelIcon.Host(g[1], g[2], ip)
		end
	end
	U.TokGlyph.TextSize = R.PillText
	U.GemGlyph.TextSize = R.PillText
	place(U.TokGlyph, 8, 0, ip + 6, R.PillH)
	place(U.TokText, ip + 18, 0, tw - ip - 24, R.PillH)
	U.TokText.TextSize = R.PillText
	U.GemText.TextSize = R.PillText
	U.PillR = R
	H.layoutGemPill()
end

-- the Gems pill's gem and amount centred in it (as GemIcon.Amount drew them), again whenever the amount changes
function H.layoutGemPill()
	local R = U.PillR
	if not R then
		return
	end
	local ip = R.PillIcon or 18
	local w = U.GemsPill.Size.X.Offset
	local ok, v = pcall(Theme.MeasureLabel, U.GemText, U.GemText.Text, R.PillText, 10000)
	local tw = (ok and typeof(v) == "Vector2") and math.ceil(v.X) or 0
	-- the icon 3 px into its box, 7 px of stone between it and the amount (the coin's spacing)
	local x = math.max(4, math.floor((w - (ip + 7 + tw)) / 2) - 3)
	place(U.GemGlyph, x, 0, ip + 6, R.PillH)
	place(U.GemText, x + ip + 10, 0, math.max(0, w - x - ip - 14), R.PillH)
end

-- the rail: PC / Compact / Phone a column at RailX; portrait one row of five tabs; answers the rail's bottom (portrait)
function H.layoutRail(W, Hh, R)
	local layout = S.Layout
	if layout == "Portrait" then
		local pad = R.Pad
		local gap = math.max(0, (W - 2 * pad - #K.TABS * R.TabW) / (#K.TABS - 1))
		place(U.Rail, 0, R.Header + 4, W, R.TabH)
		-- (the Store switch: only S.Tabs show; they keep the first slots of the five-tab row, so nothing jumps)
		for _, tab in ipairs(K.TABS) do
			U.Tabs[tab].Button.Visible = H.tabShown(tab)
		end
		for i, tab in ipairs(S.Tabs) do
			local t = U.Tabs[tab]
			place(t.Button, pad + (i - 1) * (R.TabW + gap), 0, R.TabW, R.TabH)
			H.syncTabIcon(tab, R.TabIcon)
			place(t.Icon, 0, 3, R.TabW, R.TabIcon + 4)
			-- (look review of finish pass A, major 8: "Eggs" lost its descenders under the lip) the label's box ends at the lip
			place(t.Label, 2, R.TabIcon + 6, R.TabW - 4, R.TabH - R.TabIcon - 6 - SignKit.Sizes.Lip)
			t.Label.TextSize = R.TabLabel
			t.Label.TextXAlignment = Enum.TextXAlignment.Center
		end
		U.Divider.Visible = false
		place(U.Dot, R.TabW - 15, 3, 12, 12)
		H.layoutFast(nil)
		return R.Header + 4 + R.TabH
	end
	local bodyH = Hh - R.Header
	local tabH, tabY, step, split, icon = R.TabH, R.TabY, R.TabStep, R.Split, R.TabIcon
	local short = false
	if layout == "Phone" then
		if bodyH < R.ShortBody then
			tabH, tabY, step = R.ShortTabH, R.ShortTabY, R.ShortTabStep
		end
	elseif R.ShortTabH then
		-- PC / Compact: the Fast toggle sits at the rail's bottom; a body too short for the five tabs over it takes the
		-- Short metrics (the toggle covered Tab_Boosts at ~1024x600). Every tab keeps them, so the rail does not jump
		local F = K.FAST[layout] or K.FAST.PC
		local need = tabY + (#K.TABS - 1) * step + split + tabH + K.FAST_GAP + F.H + K.FAST_FOOT
		if bodyH < need then
			short = true
			tabH, tabY, step, split, icon = R.ShortTabH, R.ShortTabY, R.ShortTabStep, R.ShortSplit, R.ShortTabIcon
		end
	end
	place(U.Rail, 0, R.Header, R.RailX + R.RailW + 8, bodyH)
	for _, tab in ipairs(K.TABS) do
		U.Tabs[tab].Button.Visible = H.tabShown(tab)
	end
	for i, tab in ipairs(S.Tabs) do
		local t = U.Tabs[tab]
		local y = tabY + (i - 1) * step + (i >= 3 and split or 0)
		place(t.Button, R.RailX, y, R.RailW, tabH)
		-- (Pitch 2 item 9 B) the PC rail at full height: the 54 px art (a short body keeps its 27 px glyph: 3 px cells too)
		local art = (layout == "PC" and not short and R.TabArt) or nil
		H.syncTabIcon(tab, icon, art)
		t.Label.TextSize = R.TabLabel
		if layout == "Compact" then
			-- the icon over the label
			-- (the label's box ends at the lip: the descenders clear it; F0 review, major 8: in every Compact rail)
			local iy, ly = 6, icon + 16
			if short then
				iy, ly = 4, icon + 12
			end
			local lh = tabH - ly - SignKit.Sizes.Lip
			place(t.Icon, 0, iy, R.RailW, icon + 8)
			place(t.Label, 2, ly, R.RailW - 4, lh)
			t.Label.TextXAlignment = Enum.TextXAlignment.Center
		else
			local ix = layout == "PC" and 16 or 8
			local lx = 10
			if art then
				-- the icon's box 2 px round the drawn art, the label 12 px clear of the art
				ix, icon, lx = R.TabArtX - 2, art, 14
			end
			-- (F0 review, major 8) the icon and the label centred on the block's face, over its lip (the label's box ran
			-- into the lip)
			local face = tabH - SignKit.Sizes.Lip
			place(t.Icon, ix, math.floor((face - icon - 4) / 2), icon + 4, icon + 4)
			place(t.Label, ix + icon + lx, 0, R.RailW - ix - icon - lx - 4, face)
			t.Label.TextXAlignment = Enum.TextXAlignment.Left
		end
	end
	-- the divider between Gems and Packs: PC "Robux items", Compact / Phone a 2 px line in the gap (none while the Store
	-- switch is off: no Robux card tab is on the rail)
	U.Divider.Visible = #S.Tabs > 2
	local gemsBottom = tabY + step + tabH
	local packsTop = tabY + 2 * step + split
	if layout == "PC" then
		place(U.Divider, R.RailX, gemsBottom + 12, R.RailW, 40)
		place(U.DivLabel, 0, 0, R.RailW, 40)
		local okW, m = pcall(Theme.MeasureLabel, U.DivLabel, U.DivLabel.Text, U.DivLabel.TextSize)
		local tw = okW and m and m.X or 110
		local side = math.max(0, math.floor((R.RailW - tw) / 2) - 10)
		SignKit.SetRule(U.DivRuleL, side)
		SignKit.SetRule(U.DivRuleR, side)
		U.DivRuleL.Position = UDim2.fromOffset(0, 19)
		U.DivRuleR.Position = UDim2.fromOffset(R.RailW - side, 19)
		U.DivGlyph.Visible, U.DivLabel.Visible, U.DivLine.Visible = false, true, false
		U.DivRuleL.Visible, U.DivRuleR.Visible = true, true
	else
		-- (Pitch 2 F0 review) a narrow rail: the kit's dotted rule alone in the gap (was a solid 2 px line)
		local mid = math.floor((gemsBottom + packsTop) / 2)
		place(U.Divider, R.RailX, mid - 1, R.RailW, 2)
		local ruleW = math.floor(R.RailW * 0.8)
		SignKit.SetRule(U.DivRuleL, ruleW)
		U.DivRuleL.Position = UDim2.fromOffset(math.floor((R.RailW - U.DivRuleL.Size.X.Offset) / 2), 0)
		U.DivGlyph.Visible, U.DivLabel.Visible, U.DivLine.Visible = false, false, false
		U.DivRuleL.Visible, U.DivRuleR.Visible = true, false
	end
	if layout == "Phone" then
		-- (Pitch 2 fix round B r1, look review minor: at 844x390 the red square lay over the 's' of "Packs", the label's
		-- words reaching the tab's right end) on a phone's rail the dot sits on the tab's top right corner, a notice badge
		-- clear of the word
		place(U.Dot, R.RailW - 9, -5, 14, 14)
	else
		place(U.Dot, R.RailW - 20, 6, 14, 14)
	end
	H.layoutFast(layout ~= "Phone" and { R = R, BodyH = bodyH } or nil)
	return R.Header
end

-- the Fast hatch toggle at the rail's bottom (PC / Compact; nil = none on this layout); shown on the Eggs tab only
function H.layoutFast(at)
	U.FastAt = at
	if not at then
		U.Fast.Visible = false
		return
	end
	local F = K.FAST[S.Layout] or K.FAST.PC
	local R = at.R
	place(U.Fast, R.RailX, at.BodyH - F.H - K.FAST_FOOT, F.W, F.H)
	U.FastLabel.TextSize = F.Text
	if S.Layout == "Compact" then
		place(U.FastSwitch, (F.W - F.SwitchW) / 2, 6, F.SwitchW, F.SwitchH)
		place(U.FastLabel, 2, F.SwitchH + 8, F.W - 4, F.H - F.SwitchH - 10)
		U.FastLabel.TextXAlignment = Enum.TextXAlignment.Center
	else
		place(U.FastLabel, 14, 0, F.W - F.SwitchW - 28, F.H)
		place(U.FastSwitch, F.W - F.SwitchW - 12, (F.H - F.SwitchH) / 2, F.SwitchW, F.SwitchH)
		U.FastLabel.TextXAlignment = Enum.TextXAlignment.Left
	end
	H.paintFast()
end

function H.paintFast()
	local on = false
	pcall(function()
		on = ClientSettings.Get("FastHatch") == true
	end)
	U.Fast:SetAttribute("On", on)
	U.Fast.Visible = U.FastAt ~= nil and S.Tab == "Eggs"
	-- (kit-b U9-2) gold while on (selected), the sunk well off; (U9-2b look review) the kit's one switch part
	CloudUI.SetSignSwitch(U.FastSwitch, on)
end

function H.toggleFast()
	sfx("StorePop", "Click")
	local on = ClientSettings.Get("FastHatch") == true
	ClientSettings.Set("FastHatch", not on) -- (one SettingsSet 0.4 s later; Changed repaints)
	H.paintFast()
end

function H.layoutCardPages(cw, ch)
	local M = H.cardMetrics()
	U.Soon.TextSize = M.Soon
	local w = cw - K.SCROLLBAR - 2
	for tab, page in pairs(U.Pages) do
		place(page, 0, 0, cw, ch)
		local list = {}
		for _, entry in pairs(U.Cards) do
			if entry.Item.Tab == tab then
				list[#list + 1] = entry
			end
		end
		table.sort(list, function(a, b)
			return (a.Order or 0) < (b.Order or 0)
		end)
		-- (a gap under the header, as the Gems page's hero at y 16; none in portrait, under the tab row)
		local top = S.Layout == "Portrait" and 0 or (S.Layout == "Phone" and 6 or 16)
		local cy = top
		for _, entry in ipairs(list) do
			entry.Root.Position = UDim2.fromOffset(0, cy)
			if S.Layout == "Portrait" then
				cy = cy + H.layoutCardPortrait(entry, w, M) + M.Gap
			else
				local h = entry.Hero and M.Hero or M.Card
				H.layoutCard(entry, w, h, M)
				cy = cy + h + M.Gap
			end
		end
		page.CanvasSize = UDim2.fromOffset(0, math.max(0, cy - M.Gap + top))
	end
end

function H.layout()
	if not S.Built then
		return
	end
	local r = NeonKit.BigRect(K)
	S.Rect = r
	S.Mode, S.Scale = r.mode, r.scale
	local W = math.floor(r.w / r.scale + 0.5)
	local Hh = math.floor(r.h / r.scale + 0.5)
	if r.mode == "Phone" then
		S.Layout = r.portrait and "Portrait" or "Phone"
	else
		S.Layout = W < K.COMPACT_W and "Compact" or "PC"
	end
	S.Portrait = S.Layout == "Portrait"
	local R = K.WIN[S.Layout]
	place(U.Holder, r.x, r.y, W, Hh)
	U.Fit.Scale = r.scale
	-- (kit-b U9-2) the awning reaches 10 px over the top on PC; no roof on a phone (the Pets rule: a phone window starts
	-- right under Roblox's top bar, and inside the short header the roof lay across the title and the pills)
	U.Roof.Position = UDim2.new(0.5, 0, 0, SignKit.RoofSeat())
	U.Roof.Visible = r.mode ~= "Phone"

	H.layoutHeader(W, R)
	local top = H.layoutRail(W, Hh, R)
	local bx, bw, by
	if S.Layout == "Portrait" then
		bx, bw, by = R.Pad, W - 2 * R.Pad, top + 8
	else
		bx, bw, by = R.ContentX, W - R.ContentX - R.ContentR, top
	end
	-- the body runs to the window's bottom (spec 16.3: 280 under the 50 px header at 844x390, 834 under 76 at 1920x1080)
	local bh = Hh - by - (S.Layout == "Portrait" and R.Pad or 0)
	place(U.Body, bx, by, bw, bh)
	H.layoutCardPages(bw, bh)
	safe("gems layout", ShopGems.Layout, U.GemsPage, { W = bw, H = bh }, S.Layout)
	place(U.GemsPage, 0, 0, bw, bh)
	place(U.EggsPage, 0, 0, bw, bh)
	safe("eggs layout", ShopEggs.Layout, U.EggsPage, { W = bw, H = bh }, S.Layout)
	H.coverColumn()
end

----------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------
function H.computeStates()
	local owned = csvSet(H.attr("OwnedPasses"))
	local bought = csvSet(H.attr("StoreBought"))
	local known = H.boughtKnown()
	local xpPass = H.xpPassKey()
	local lock = H.lockText()
	local states = {}
	for _, list in ipairs({ S.Items, S.GemItems }) do
		for _, item in ipairs(list) do
			local st, status = H.stateOf(item, owned, bought, xpPass, known, lock)
			states[item.Key] = { State = st, Status = status }
		end
	end
	S.States = states
end

local BUY_TEXT = { Buy = "Buy", Active = "Buy", Owned = "Owned", Claimed = "Claimed!", HaveIt = "Buy", Preview = "Preview", Loading = "...", Locked = "Locked" } -- (kit-b U9-2: sentence case)

function H.paintCards()
	local match = H.inMatch()
	for key, entry in pairs(U.Cards) do
		local st = S.States[key] or { State = "Buy", Status = "" }
		entry.Buy.Text = BUY_TEXT[st.State] or "Buy"
		local off = match or not (st.State == "Buy" or st.State == "Active")
		if (entry.Buy:GetAttribute("Disabled") == true) ~= off then
			CloudUI.SetDisabled(entry.Buy, off) -- (only on a change: a repaint tweens the face)
		end
		entry.Price.Text = H.priceText(entry.Item)
		entry.PricePill.Root.Visible = st.State ~= "Owned" and st.State ~= "Claimed" and st.State ~= "Locked"
		entry.Status.Text = st.Status
		entry.StatusFirst = st.State == "Locked"
		local dim = st.State == "HaveIt"
		entry.Dim = dim
		H.paint(entry, dim)
		entry.Name.TextColor3 = H.ink(entry, dim and "Muted" or "Name")
		entry.GetsYou.TextColor3 = H.ink(entry, "Muted")
		entry.Status.TextColor3 = H.ink(entry, "Status")
		for _, line in ipairs(entry.Lines) do
			line.TextColor3 = H.ink(entry, dim and "Muted" or "Line")
		end
	end
	-- the balances (Theme.ShortNumber from 1e6) and the Starter dot
	local function value(id)
		local fn = State[id]
		local ok, v = pcall(fn)
		return ok and tonumber(v) or 0
	end
	local gems = Theme.Short(value("Gems")) -- (Pitch 2 F0) the one number style: 1.25K, 12.5K
	if U.GemText.Text ~= gems then
		U.GemText.Text = gems
		H.layoutGemPill()
	end
	U.TokText.Text = Theme.Short(value("Tokens"))
	local starter = S.ByKey.Starter
	U.Dot.Visible = H.storeOn() and starter ~= nil and (starter.Created or H.preview()) and H.boughtKnown() and not csvSet(H.attr("StoreBought")).Starter
	safe("gems refresh", ShopGems.Refresh, U.GemsPage)
	safe("eggs refresh", ShopEggs.Refresh, U.EggsPage)
	H.paintFast()
end

function H.selectTab(tab)
	tab = ShopController.NormalizeTab(tab)
	if tab == nil then
		tab = S.Tab or "Eggs"
	end
	if not H.tabShown(tab) then
		tab = "Eggs" -- the Store switch: a tab that is not on the rail (asked by name, or the session's last) is the Eggs tab
	end
	S.Tab = tab
	for name, t in pairs(U.Tabs) do
		local on = name == tab
		t.Button:SetAttribute("Selected", on)
		-- (kit-b U9-2) a stone tab block, the selected one gold (one colour by role); brown ink and icon on both
		CloudUI.SignBlock(t.Button, on and "Selected" or "Stone", { Pad = false })
		t.Label.TextColor3 = SIGN.Text
		if t.Icon and t.Icon:IsA("TextLabel") then
			t.Icon.TextColor3 = SIGN.Text
		end
	end
	for name, page in pairs(U.Pages) do
		page.Visible = name == tab
	end
	U.GemsPage.Visible = tab == "Gems"
	U.EggsPage.Visible = tab == "Eggs"
	U.Soon.Visible = H.storeOn() and tab ~= "Gems" and tab ~= "Eggs" and #H.tabItems(tab) == 0
	H.paintFast()
end

-- re-reads the shown set (rebuilds on a change), the states, the prices and the layout
function H.refresh()
	if not S.Built then
		return
	end
	local items, gems, byKey, sig = H.collect()
	S.Items, S.GemItems, S.ByKey = items, gems, byKey
	S.Tabs = StoreCatalog.ShownTabs()
	H.computeStates()
	local heroes = H.heroSignature()
	if sig ~= S.Signature or heroes ~= S.Heroes then
		S.Signature = sig
		S.Heroes = heroes
		H.rebuild()
		if S.Open then
			H.askPrices()
		end
	end
	if S.Tab then
		H.selectTab(S.Tab)
	end
	H.paintCards()
	if S.Open then
		H.askPrices()
		H.layout()
	end
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
function H.send(action, key)
	local t = os.clock()
	if t - S.LastBuy < K.BUY_GAP then
		return
	end
	S.LastBuy = t
	local remote = H.remote("StoreRequest")
	if remote then
		safe("StoreRequest", function()
			remote:FireServer(action, key)
		end)
	end
end

function H.buy(key)
	sfx("StorePop", "Click")
	if H.inMatch() then
		H.hint(K.MATCH_HINT)
		ShopController.Close()
		return
	end
	local st = S.States[key]
	if not st or not (st.State == "Buy" or st.State == "Active") then
		return
	end
	H.send("Buy", key)
end

-- the gem XP Potion: only "Ready" sends (spec 16.3); "Short" says so
function H.gemBuy()
	sfx("StorePop", "Click")
	if H.inMatch() then
		H.hint(K.MATCH_HINT)
		ShopController.Close()
		return
	end
	if not H.storeOn() then
		return -- the Store switch: the gem potion is not shown, so nothing is sent
	end
	local state = ShopGems.PotionState()
	if state == "Short" then
		H.hint(K.SHORT_GEMS)
		return
	end
	if state == "Ready" then
		H.send("GemBuy", K.POTION_KEY)
	end
end

function H.tapTab(tab)
	sfx("StorePop", "Click")
	H.selectTab(tab)
	H.shineOff()
	if S.Open then
		H.layout()
		H.shineOn()
	end
end

----------------------------------------------------------------------
-- Shine (High only)
----------------------------------------------------------------------
function H.track(tween)
	if S.Shine and tween then
		local list = S.Shine.Tweens
		list[#list + 1] = tween
	end
	return tween
end

function H.heroEntry()
	for _, entry in pairs(U.Cards) do
		if entry.Hero and entry.Item.Tab == S.Tab then
			return entry
		end
	end
	return nil
end

-- one 1 -> 1.04 -> 1 pulse of a UIScale (0.3 s each way)
function H.pulse(scale)
	local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
	local ok, tween = pcall(function()
		return game:GetService("TweenService"):Create(scale, info, { Scale = K.PULSE_SCALE })
	end)
	if ok and tween then
		tween:Play()
		H.track(tween)
	end
end

-- true while the Secret card's SPIN can be tapped (ShopEggs.CardState not Locked / Altar / Loading / Pending / NoOdds;
-- shop-area 16.17.3: away from the Storm Altar SPIN is hidden under TRAVEL, so nothing pulses)
function H.eggPulseOn()
	local secret = type(Config.Gems) == "table" and type(Config.Gems.SecretRoulette) == "table" and Config.Gems.SecretRoulette.Id or "Secret"
	local ok, st = pcall(ShopEggs.CardState, secret, "Spin")
	return ok and st ~= "Locked" and st ~= "Altar" and st ~= "Loading" and st ~= "Pending" and st ~= "NoOdds"
end

function H.shineOn()
	if S.Shine or not S.Open then
		return
	end
	local high = H.quality() == "High"
	S.Shine = { Tweens = {}, Parts = {}, Views = {}, Conn = nil, High = high }
	local shine = S.Shine
	local hero = H.heroEntry()
	if hero then
		-- (kit-b U9-2, finding 15) no gloss on the hero any more: the turning HeroSpin gradient and the sheen sweep went;
		-- its Buy still pulses (High)
		if high then
			local mine = S.Token
			task.spawn(function()
				while S.Open and S.Token == mine and S.Shine == shine do
					task.wait(K.PULSE_EVERY)
					if not (S.Open and S.Token == mine and S.Shine == shine) or hero.Pulse.Parent == nil then
						break
					end
					H.pulse(hero.Pulse)
				end
			end)
		end
	end
	-- the Eggs tab: the Secret card's SPIN pulses the same way (spec 16.3, High only), and only while that button can be
	-- tapped (review round 1: never while it is Locked, Loading, Pending or without odds; checked on every beat, so the
	-- pulse starts by itself when the gem settle hold ends; the scale rests at 1 meanwhile)
	local eggPulse = (high and S.Tab == "Eggs") and ShopEggs.HeroPulse(U.EggsPage) or nil
	if eggPulse then
		local mine = S.Token
		task.spawn(function()
			while S.Open and S.Token == mine and S.Shine == shine do
				task.wait(K.PULSE_EVERY)
				if not (S.Open and S.Token == mine and S.Shine == shine) or eggPulse.Parent == nil then
					break
				end
				if H.eggPulseOn() then
					H.pulse(eggPulse)
				else
					eggPulse.Scale = 1
				end
			end
		end)
	end
	if high then
		-- the pet cards turn their pet (CloudUI.PetViewport) instead of the glyph
		for _, entry in pairs(U.Cards) do
			local pets = type(entry.Item.Grants) == "table" and entry.Item.Grants.Pets or nil
			if type(pets) == "table" and entry.Item.Tab == S.Tab then
				local petId = next(pets)
				local ok, view = pcall(CloudUI.PetViewport, entry.Art, petId, UDim2.fromScale(1, 1), {})
				if ok and type(view) == "table" then
					H.showArt(entry, false)
					shine.Views[#shine.Views + 1] = { View = view, Entry = entry }
				end
			end
		end
	end
end

function H.shineOff()
	local shine = S.Shine
	if not shine then
		return
	end
	S.Shine = nil
	if shine.Conn then
		shine.Conn:Disconnect()
	end
	for _, tween in ipairs(shine.Tweens) do
		pcall(function()
			tween:Cancel()
		end)
	end
	for _, part in ipairs(shine.Parts) do
		part:Destroy()
	end
	for _, v in ipairs(shine.Views) do
		pcall(function()
			if type(v.View.Destroy) == "function" then
				v.View.Destroy()
			elseif v.View.Frame then
				v.View.Frame:Destroy()
			end
		end)
		H.showArt(v.Entry, true)
	end
	for _, entry in pairs(U.Cards) do
		entry.Pulse.Scale = 1
	end
	local eggPulse = ShopEggs.HeroPulse(U.EggsPage)
	if eggPulse then
		eggPulse.Scale = 1
	end
end

----------------------------------------------------------------------
-- Touch controls, the menu column, gamepad B
----------------------------------------------------------------------
-- the phone window fills the screen: Roblox's thumbstick and jump button go while it is up (the PetsController rule),
-- through MenuController's one owner set (who "Shop")
function H.syncTouch()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local want = S.Open and (S.Mode == "Phone" or touchOnly)
	if want == S.TouchOff then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		safe("touch", menu.SetTouchHidden, "Shop", want)
		return
	end
	pcall(function()
		if want then
			S.TouchWas = GuiService.TouchControlsEnabled
			GuiService.TouchControlsEnabled = false
		else
			GuiService.TouchControlsEnabled = S.TouchWas ~= false
		end
	end)
end

function H.coverColumn()
	local menu = H.controller("MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		safe("cover", menu.SetColumnCovered, (S.Open and S.Rect) and S.Rect.x or nil, "Shop")
	end
	-- (kit-b U9-2; the render gate) the header shows Gems and Tokens beside the prices: the HUD's strips step aside while
	-- the Shop is open (they showed twice, and the X sat over them at 1280x720)
	if S.CurrencyOff ~= S.Open then
		local hud = H.controller("HudController")
		if hud and type(hud.SetCurrencyHidden) == "function" then
			S.CurrencyOff = S.Open
			safe("currency", hud.SetCurrencyHidden, "Shop", S.Open)
		end
	end
	H.syncTouch()
end

function H.syncBack()
	if S.Open and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				-- (while the egg stage shows B is its own: NimbusHatchBack at High + 1)
				if inputState == Enum.UserInputState.Begin and not EggStage.IsShowing() then
					safe("back", ShopController.Close)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	elseif not S.Open and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function ShopController.NormalizeTab(tab)
	if type(tab) ~= "string" then
		return nil
	end
	local t = tab:lower()
	if t:sub(1, 3) == "egg" or t:sub(1, 4) == "roul" or t == "items" or t == "shop" then
		return "Eggs"
	end
	if t:sub(1, 3) == "gem" or t == "currency" or t == "tokens" then
		return "Gems"
	end
	if t == "packs" then
		return "Packs"
	elseif t == "passes" then
		return "Passes"
	elseif t == "boosts" then
		return "Boosts"
	end
	return nil
end

function ShopController.IsOpen()
	return S.Open
end

function ShopController.Tab()
	return S.Tab
end

function ShopController.Layout()
	if S.Open then
		return S.Layout
	end
	local r = NeonKit.BigRect(K)
	if r.mode == "Phone" then
		return r.portrait and "Portrait" or "Phone"
	end
	return (r.w / r.scale) < K.COMPACT_W and "Compact" or "PC"
end

function ShopController.Portrait()
	return S.Portrait == true
end

function ShopController.RobuxGlyph()
	return robuxGlyph()
end

function ShopController.Cards()
	local out = {}
	for key, entry in pairs(U.Cards) do
		local st = S.States[key]
		out[key] = { State = st and st.State or "Buy", Price = entry.Price.Text, Tab = entry.Item.Tab }
	end
	for _, item in ipairs(S.GemItems) do
		local st = S.States[item.Key]
		local price = item.Created and H.priceText(item) or (item.Robux and (robuxGlyph() .. Util.Commas(item.Robux)) or "...")
		out[item.Key] = { State = st and st.State or "Preview", Price = price, Tab = item.Tab }
	end
	return out
end

function ShopController.Palette(key)
	local item = S.ByKey[key] or StoreCatalog.Item(key)
	if not item then
		return nil
	end
	local p = H.palette(item)
	return { Top = p.Top, Bottom = p.Bottom, Edge = p.Edge }
end

function ShopController.Open(args)
	if not initialized then
		ShopController.Init()
	end
	if not U.Gui then
		return false
	end
	args = type(args) == "table" and args or {}
	if H.inMatch() then
		H.hint(K.MATCH_HINT)
		return false
	end
	if EggStage.IsShowing() then
		return false -- (the stage covers the screen: DONE brings the Shop back)
	end
	local tab = ShopController.NormalizeTab(args.Tab)
	local focus = type(args.RouletteId) == "string" and args.RouletteId or nil
	if focus then
		tab = "Eggs"
	end
	H.build()
	local wasOpen = S.Open
	-- (shop-area 16.17.3) the altar prompt's open unlocks the Secret card until Close; a plain first open clears it
	if args.FromAltar == true or not wasOpen then
		safe("altar", ShopEggs.SetFromAltar, args.FromAltar == true)
	end
	S.Open = true
	if not wasOpen then
		S.Token = S.Token + 1
	end
	H.refresh()
	if tab or not wasOpen then
		H.selectTab(tab)
	end
	U.Holder.Visible = true
	H.layout()
	H.syncBack()
	if focus then
		safe("focus", ShopEggs.Focus, U.EggsPage, focus)
	elseif not wasOpen then
		safe("home", ShopEggs.ScrollHome, U.EggsPage) -- (playtest 2026-11-28 C18) the pill's open: the top, not the last machine
	end
	if not wasOpen then
		SignKit.Rise(U.Holder) -- (Pitch 2 F0, finish pass A) the kit's open: the window rises 12 px in 3 hard steps
		H.shineOn()
		local mine = S.Token
		task.spawn(function()
			while S.Open and S.Token == mine do
				task.wait(K.TICK)
				if S.Open and S.Token == mine then
					safe("tick", H.refresh)
				end
			end
		end)
		-- spec 16.3 "WindowOpened": "Shop" (the tutorial's ShopOpened; the menu's windows close on it)
		local menu = H.controller("MenuController")
		if menu and menu.WindowOpened then
			safe("window opened", function()
				menu.WindowOpened:Fire("Shop")
			end)
		end
		safe("toggled", function()
			ShopController.Toggled:Fire(true)
		end)
	else
		H.shineOff()
		H.shineOn()
	end
	return true
end

function ShopController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	safe("altar", ShopEggs.SetFromAltar, false)
	H.shineOff()
	if U.Holder then
		U.Holder.Visible = false
	end
	H.syncBack()
	H.coverColumn()
	safe("toggled", function()
		ShopController.Toggled:Fire(false)
	end)
end

function ShopController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	robuxGlyph()
	U.Gui = CloudUI.NewScreenGui("NimbusShop", K.DISPLAY_ORDER)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(U.Gui)
	U.Gui.IgnoreGuiInset = true
	U.Gui.ResetOnSpawn = false
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Open then
			safe("relayout", H.layout)
		end
	end)
	State.Changed:Connect(function()
		if S.Open then
			safe("balances", H.paintCards)
		end
	end)
	for _, name in ipairs({ "OwnedPasses", "StoreBought", "XpBoostEnds", "StorePreview", "GemsSettled", "XpPassState", K.RESTRICTED_ATTR, "SecretPityLeft" }) do
		LocalPlayer:GetAttributeChangedSignal(Config.Attr[name] or name):Connect(function()
			if S.Open then
				safe("refresh", H.refresh)
			end
		end)
	end
	for _, name in ipairs({ "Gems", "Tokens" }) do
		LocalPlayer:GetAttributeChangedSignal(Theme.Currency[name].Attr):Connect(function()
			if S.Open then
				safe("balances", H.paintCards)
			end
		end)
	end
	LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
		if H.inMatch() then
			ShopController.Close()
		end
	end)
	-- the ONE Esc handler (EggStage has none): while the stage shows, its Back (skip, then DONE) and nothing more; else
	-- Esc closes the open Shop
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode ~= Enum.KeyCode.Escape then
			return
		end
		if EggStage.IsShowing() then
			safe("hatch back", EggStage.Back)
		elseif S.Open then
			ShopController.Close()
		end
	end)
	-- one window at a time (spec 8): any other window's opening closes this one
	local menu = H.controller("MenuController")
	if menu and menu.WindowOpened then
		menu.WindowOpened:Connect(function(id)
			if id ~= "Shop" and S.Open then
				ShopController.Close()
			end
		end)
	end
	-- the egg stage (Task 22): the window steps aside while it shows and comes back after DONE (or a phase error) while
	-- the Shop is still open and not in a match; a match start or MenuController.Close() ends both
	EggStage.Init()
	EggStage.Opened:Connect(function()
		if S.Open and U.Holder then
			U.Holder.Visible = false
			H.shineOff()
			H.coverColumn()
		end
	end)
	EggStage.Closed:Connect(function(reason)
		if not S.Open then
			return
		end
		if (reason == "Done" or reason == "Error") and not H.inMatch() then
			if U.Holder then
				U.Holder.Visible = true
			end
			safe("hatch back refresh", H.refresh)
			H.shineOn()
		else
			ShopController.Close()
		end
	end)
	local function repaint()
		if S.Open then
			safe("eggs repaint", H.paintCards)
		end
	end
	EggStage.Pending:Connect(function()
		repaint()
		task.delay(K.HATCH_WAIT, repaint) -- (the stage's 7 s timeout fires no signal)
	end)
	EggStage.Answered:Connect(repaint)
	ClientSettings.Changed:Connect(function(key)
		if key == "FastHatch" and U.Fast then
			H.paintFast()
		end
	end)
	-- the server's thank-you toast for a granted purchase plays the coin clatter
	task.spawn(function()
		local remote = H.remote("Notify")
		if remote then
			remote.OnClientEvent:Connect(function(message)
				if H.isThanks(message) then
					sfx("StoreBuy", "Reward")
				end
			end)
		end
	end)
end

return ShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1163">
            <Properties>
              <string name="Name">ShowcaseController</string>
              <string name="Source"><![CDATA[-- ShowcaseController (client): brings the big showcase pets to life (ARCHITECTURE_V3.md section 10), e.g. the
-- StormfangShowcase on the Storm Altar.
--
--   ShowcaseController.Init()
--   ShowcaseController.Count() -> number of showcases being animated
--
-- Every model tagged "NC_Showcase" (also ones added later) gets, on this client only (the server never moves it):
--   * a gentle hover bob with a slow sway and roll around the pose the server built (attribute HoverAmp = studs)
--   * PetBuilder.Animate when the model carries a PetBuilder rig (attribute PB_Rig): the storm cloud drifts, the
--     tail sways, the eyes blink and the rig's own neon accents (PB_Pulse) breathe
--   * a soft pulse of every other Neon part (transparency), restored when the showcase stops
-- Cheap like the NPC idles: once the model has fully replicated (attributes Ready + PetParts), its static parts
-- are welded locally to the anchored PrimaryPart, so a pose is ONE CFrame write plus the animated groups.
-- Showcases further than CULL studs from the camera are frozen, past NEAR they update every other frame.
-- One RenderStepped connection, only while there is something to animate; nothing is created per frame.
-- Removing the model (or its tag) stops its animation cleanly. Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")

local function optionalShared(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[ShowcaseController] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local PetBuilder = optionalShared("PetBuilder")

local ShowcaseController = {}

local TAG = "NC_Showcase"
local TAU = math.pi * 2

local K = {
	CULL = 300, -- frozen beyond this distance from the camera
	NEAR = 120, -- every other frame beyond this
	BOB_AMP = 0.45, -- studs (attribute HoverAmp overrides)
	BOB_PERIOD = 3.8, -- seconds
	SWAY = math.rad(4), -- slow yaw sway
	ROLL = math.rad(1.4),
	FLAP = 0.55, -- PetBuilder.Animate speed: a slow drift of the storm cloud
	PULSE = 0.22, -- neon transparency swing
	PULSE_RATE = 1.9, -- radians per second
	MAX_PULSE = 80, -- neon parts pulsed per showcase (cost cap)
	READY_TIMEOUT = 15,
}

local recs = {} -- list of records
local byModel = {} -- [model] = record
local pending = {} -- [model] = true while waiting for it to replicate
local loopConn = nil
local clock = 0
local initialized = false
local frameWarned = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function countParts(model)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

local function isComplete(model)
	if model:GetAttribute("Ready") ~= true then
		return false
	end
	local wanted = model:GetAttribute("PetParts")
	if type(wanted) ~= "number" then
		return true
	end
	return countParts(model) >= wanted
end

local function rootOf(model)
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- Parts PetBuilder.Animate re-poses every call (wings / cloud halves, tail, halo, aura). Eyelids only change
-- their transparency, so they are welded like everything else.
local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

----------------------------------------------------------------------
-- Records
----------------------------------------------------------------------
-- ref: the root's CFrame the part's current CFrame belongs to (default: the server pose).
local function weldPart(rec, part, ref)
	if part == rec.Root or rec.Animated[part] or part:FindFirstChild("ShowcaseWeld") then
		return
	end
	local weld = Instance.new("Weld")
	weld.Name = "ShowcaseWeld"
	weld.Part0 = rec.Root
	weld.Part1 = part
	weld.C0 = (ref or rec.Base):Inverse() * part.CFrame
	weld.C1 = CFrame.new()
	weld.Parent = part
	rec.Welds[#rec.Welds + 1] = weld
	if part.Anchored then
		part.Anchored = false
		rec.Unanchored[#rec.Unanchored + 1] = part
	end
end

local function addNeon(rec, part)
	if #rec.Neon >= K.MAX_PULSE or part.Material ~= Enum.Material.Neon then
		return
	end
	-- the rig's own accents (PB_Pulse) breathe through PetBuilder.Animate already
	if rec.Animate and part:GetAttribute("PB_Pulse") ~= nil then
		return
	end
	rec.Neon[#rec.Neon + 1] = { Part = part, T0 = part.Transparency }
end

-- The server pose of a part (relative to the root's server CFrame) and its transparency, restored on untag.
local function remember(rec, part)
	if part ~= rec.Root and not rec.Rest[part] then
		rec.Rest[part] = { Rel = rec.Base:ToObjectSpace(part.CFrame), T = part.Transparency }
	end
end

-- Puts the model back the way the server built it (tag removed while the model stays): also the parts
-- PetBuilder.Animate re-poses (cloud halves, tail, aura) or pulses, which are not welded to the root.
local function restore(rec)
	pcall(function()
		for _, weld in ipairs(rec.Welds) do
			weld:Destroy()
		end
		for _, part in ipairs(rec.Unanchored) do
			if part.Parent then
				part.Anchored = true
			end
		end
		for _, n in ipairs(rec.Neon) do
			if n.Part.Parent then
				n.Part.Transparency = n.T0
			end
		end
		if rec.Root and rec.Root.Parent then
			rec.Root.CFrame = rec.Base
		end
		for part, r in pairs(rec.Rest) do
			if part.Parent and part:IsDescendantOf(rec.Model) then
				part.CFrame = rec.Base * r.Rel
				part.Transparency = r.T
			end
		end
	end)
	rec.Welds, rec.Unanchored = {}, {}
end

local function stopLoopIfIdle()
	if #recs == 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

local function removeRec(rec, putBack)
	for i = #recs, 1, -1 do
		if recs[i] == rec then
			table.remove(recs, i)
		end
	end
	if rec.Model and byModel[rec.Model] == rec then
		byModel[rec.Model] = nil
	end
	for _, conn in ipairs(rec.Conns) do
		conn:Disconnect()
	end
	rec.Conns = {}
	if putBack and rec.Model and rec.Model.Parent then
		restore(rec)
	end
	stopLoopIfIdle()
end

local ensureLoop -- forward declaration

local function setup(model, complete)
	if byModel[model] or not model.Parent then
		return
	end
	local root = rootOf(model)
	if not root then
		return
	end
	local amp = model:GetAttribute("HoverAmp")
	if type(amp) ~= "number" or amp ~= amp then
		amp = K.BOB_AMP
	end
	local rec = {
		Model = model,
		Root = root,
		Base = root.CFrame,
		Amp = math.max(0, math.min(amp, 3)),
		Phase = (#recs * 1.73) % TAU,
		Frame = 0,
		Animate = PetBuilder ~= nil and type(PetBuilder.Animate) == "function" and model:GetAttribute("PB_Rig") ~= nil,
		AnimOpts = { Flap = K.FLAP, Excited = 0 },
		Animated = {},
		Welds = {},
		Unanchored = {},
		Neon = {},
		Rest = {}, -- [part] = { Rel, T }: the server pose (see remember / restore)
		Conns = {},
		Welded = false,
	}
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
			remember(rec, d)
			if rec.Animate and isAnimatedPart(d) then
				rec.Animated[d] = true
			end
		end
	end
	for _, part in ipairs(parts) do
		addNeon(rec, part)
	end
	-- weld the static parts (only when the whole model is here; otherwise PivotTo moves whatever exists)
	if complete then
		local ok, err = pcall(function()
			for _, part in ipairs(parts) do
				weldPart(rec, part)
			end
			root.Anchored = true
		end)
		rec.Welded = ok
		if not ok then
			warn("[ShowcaseController] could not weld a showcase, using PivotTo: " .. tostring(err))
			restore(rec)
		end
	end
	recs[#recs + 1] = rec
	byModel[model] = rec

	-- parts that stream in later join the rig
	rec.Conns[#rec.Conns + 1] = model.DescendantAdded:Connect(function(d)
		if not d:IsA("BasePart") or byModel[model] ~= rec then
			return
		end
		remember(rec, d)
		if rec.Animate and isAnimatedPart(d) then
			rec.Animated[d] = true
		elseif rec.Welded then
			pcall(weldPart, rec, d)
		end
		addNeon(rec, d)
	end)
	rec.Conns[#rec.Conns + 1] = model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(game) and byModel[model] == rec then
			removeRec(rec, false)
		end
	end)
	ensureLoop()
end

local function track(model)
	if typeof(model) ~= "Instance" or not model:IsA("Model") then
		return
	end
	if byModel[model] or pending[model] then
		return
	end
	pending[model] = true
	task.spawn(function()
		local waited = 0
		while waited < K.READY_TIMEOUT and model.Parent and not isComplete(model) do
			task.wait(0.25)
			waited = waited + 0.25
		end
		pending[model] = nil
		if model.Parent and CollectionService:HasTag(model, TAG) then
			local ok, err = pcall(setup, model, isComplete(model))
			if not ok then
				warn("[ShowcaseController] showcase setup failed: " .. tostring(err))
			end
		end
	end)
end

----------------------------------------------------------------------
-- Animation
----------------------------------------------------------------------
local function pose(rec)
	local t = clock + rec.Phase
	local y = math.sin(t * TAU / K.BOB_PERIOD) * rec.Amp
	local yaw = math.sin(t * 0.37) * K.SWAY
	local roll = math.sin(t * 0.83) * K.ROLL
	local cf = rec.Base * CFrame.new(0, y, 0) * CFrame.Angles(0, yaw, roll)
	if rec.Welded then
		rec.Root.CFrame = cf
	else
		rec.Model:PivotTo(cf)
	end
	if rec.Animate then
		local ok = pcall(PetBuilder.Animate, rec.Model, clock, rec.AnimOpts)
		if not ok then
			-- a broken rig: its moving parts join the body, the hover and the pulse go on
			rec.Animate = false
			if rec.Welded then
				local ref = rec.Root.CFrame
				for part in pairs(rec.Animated) do
					rec.Animated[part] = nil
					pcall(weldPart, rec, part, ref)
				end
			end
		end
	end
	local neon = rec.Neon
	if #neon > 0 then
		local k = K.PULSE * (0.5 + 0.5 * math.sin(t * K.PULSE_RATE))
		for i = 1, #neon do
			local n = neon[i]
			n.Part.Transparency = math.min(1, n.T0 + k)
		end
	end
end

local function step(dt)
	clock = clock + dt
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or nil
	for i = #recs, 1, -1 do
		local rec = recs[i]
		if rec and rec.Root and rec.Root.Parent then
			local d = 0
			if camPos then
				d = (rec.Base.Position - camPos).Magnitude
			end
			if d <= K.CULL then
				rec.Frame = rec.Frame + 1
				if d <= K.NEAR or rec.Frame % 2 == 0 then
					pose(rec)
				end
			end
		elseif rec then
			removeRec(rec, false)
		end
	end
end

ensureLoop = function()
	if loopConn or #recs == 0 then
		return
	end
	loopConn = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(step, math.min(dt, 0.1))
		if not ok and not frameWarned then
			frameWarned = true -- once: a broken frame must not flood the output
			warn("[ShowcaseController] frame failed: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function ShowcaseController.Init()
	if initialized then
		return
	end
	initialized = true
	CollectionService:GetInstanceAddedSignal(TAG):Connect(track)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(model)
		pending[model] = nil
		local rec = byModel[model]
		if rec then
			removeRec(rec, true)
		end
	end)
	for _, model in ipairs(CollectionService:GetTagged(TAG)) do
		track(model)
	end
end

function ShowcaseController.Count()
	return #recs
end

return ShowcaseController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1164">
            <Properties>
              <string name="Name">SkyController</string>
              <string name="Source"><![CDATA[-- SkyController (client): the living sky on this client (docs/superpowers/specs/2026-10-30-living-sky-cycle-design.md,
-- plan docs/superpowers/plans/2026-10-30-living-sky.md Task 5). The server publishes the clock and the raid event as
-- Workspace attributes (server/Services/SkyService, Config.Sky.Attr); every Config.Sky.Cycle.Refresh (2) s this turns
-- them into the moment's look with shared/SkyCycle (+ shared/SkyFaces for the painted skybox) and moves the BASE of
-- client/LightingStack with a Cycle.Tween (2) s tween, so the Dungeon / GfxLow / AttackFxDim presets keep winning on
-- top. No per-frame code (one task.wait loop), no remote traffic. While a raid sky blends in or out the refresh runs
-- every Config.Sky.Transitions.Raid.Step (0.5) s with 0.5 s tweens instead (kit-b S1: the haze bridge around its skybox
-- swap is seen as a smooth rise, not 1-2 samples), and while a phase blends on a dev /sky speed above 1 (S1 review);
-- the loop wakes at most every Step s, counts the real seconds waited and refreshes when its step is due.
--
--   * no SkyEpoch attribute (an older server, tests): inert, the boot sky stays, nothing below runs
--   * the first apply after Start is instant (seconds 0): a late joiner never sees the boot afternoon fade away
--   * a refresh is skipped while LightingStack.Busy() (a Dungeon / AttackFxDim fade runs: never restarted); the next
--     refresh after it applies
--   * the clock: it tweens forward in the 2 s steps (SkyCycle's cycle clock only moves forward round the dial, the
--     Sunset -> Night and Night -> Dawn changes included). P2 F11 C's quick sunset (17.2 -> 18.9 h, SkyCycle steps it
--     (Refresh + Tween) / 2 s before the Sunset -> Night bridge peak) stays inside the Sunset segment, so it is tweened
--     too, over the first refresh from that step, so on screen it runs inside the peak +- 2 s, behind the cloud curtain
--     (never set at once). Set at once (LightingStack.SetBase's instant set) only
--     (a) when it passes midnight (23.9 -> 0.1: a tween would run back through the day; 24 h = 0 h, so invisible) and
--     (b) on a segment change (a raid sky's mid-blend, in or out) by more than Config.Sky.ClockJump h
--   * the raid sky: SkyEvent (a boss id with a RaidThemes sky) blends in over Transitions.Raid.In (8) s from SkyEventAt
--     (a late joiner mid-raid is on the raid sky at once) and back out over Raid.Out (6) s once SkyEvent is "" again. Each new
--     SkyEventAt starts a transition FROM what showed at that moment (St.From = { Id, Blend }): back-to-back raids
--     (SkyEvent storm_titan -> lava_golem, no clear) blend raid sky to raid sky (the skybox swap at the midpoint),
--     never back through the cycle look; a raid that ends half blended in leaves from where it was
--   * the local raid sky (SetLocalEvent, a fight in a side pocket): for this client alone it takes the place of the SkyEvent /
--     SkyEventAt attributes, with the same blend in and out; taken off, the attributes are back in charge (from that moment).
--     Both refresh at once (task.defer), not on the next loop tick (sky audit F3)
--   * the battle lift (Config.Sky.Lift): in an outdoor pet battle (Config.Attr.InBattle "B...") under a dark look
--     (Night, the eclipse raid) LightingStack.Push("SkyLift") over 1.5 s, popped over 1.5 s after the fight / at dawn
--   * the lamps (Config.Sky.Lamps): the lobby's LampGlass / LanternLight / StallLight / DomeGlow / TroveGlow PointLights
--     glow x1.4 under a dark look and dim to x0.35 under every other (bug batch 6: they burned at full strength all day),
--     never over 1.5; written on a look change, on a lamp that arrives under the lobby later, and on a lobby root that
--     arrives or is replaced later (the next refresh, same look); each lamp's own value is kept on the light (attribute
--     Lamps.BaseAttr, never a Lua-only weak cache: a lost base made the written value the next one); no clock / Stop =
--     their own value
--   * the fireflies (Config.Sky.Fireflies): at Night on High graphics a few emitters round the lobby trees (one local
--     folder, capped); none on Low (GraphicsQuality.Effective()) or by day
--   * Low graphics: GraphicsQuality.Recap after each applied refresh (the GfxLow cloud cap follows the sky, updated in
--     place and carried by the next refresh: it never cancels or re-eases these linear base tweens)
--   * the preload (kit-b S2, sky audit F4; client/SkyTransition): the next theme's six faces are fetched once per blend
--     window, at its first refresh inside it (about 37 s before the swap at blend 0.5), and the four raid themes
--     Transitions.Preload.RaidDelay (4) s after the menu's PLAY fires (UiGate.Played; after Start when Start comes after
--     PLAY), one at a time, once per Start
-- The "look" = the raid boss id from its eventBlend 0.5, else the next phase from the phase's Blend 0.5, else the phase
-- (the same moments the skybox swaps).
--
--   SkyController.Init() / Start()   idempotent: the loop, the attribute signals, a first (instant) refresh
--   SkyController.Stop()             tests: the loop ends, signals dropped, lift popped, lamps back, fireflies gone
--   SkyController.Refresh(now)       one step (tests drive it); now = server time (default Workspace:GetServerTimeNow())
--   SkyController.SetLocalEvent(bossId|nil) -> ok   the local raid sky on (a boss with a raid sky; anything else is refused) / off
--   SkyController.State() -> { Phase, Next, Look, Theme, Event, EventBlend, EventFrom, Local, Lift, Lamps, Fireflies, Applies,
--                              Skipped, Loops, Running }   (Lamps / Fireflies = how many lamps written / emitters on;
--                              EventFrom = the raid sky Event blends from on a back-to-back change, else nil;
--                              Local = the boss of the local raid sky, else nil)
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Client = script.Parent.Parent
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local SkyCycle = require(Shared:WaitForChild("SkyCycle"))
local SkyFaces = require(Shared:WaitForChild("SkyFaces"))
local LightingStack = require(Client:WaitForChild("LightingStack"))
local SkyTransition = require(Client:WaitForChild("SkyTransition"))

local SkyController = {}

local St = {
	Running = false,
	Gen = 0, -- the loop generation (Stop / Start: an older loop ends on its next wake)
	Loops = 0, -- loops alive (one at most)
	Thread = nil, -- the loop's thread (Stop cancels it)
	First = true, -- the next applied refresh is instant
	Conns = {},
	Phase = nil,
	Next = nil,
	Look = nil,
	Theme = nil,
	Event = nil,
	EventBlend = 0,
	EvSeen = false, -- the raid transition below has been read from the attributes once
	EvAt = nil, -- the SkyEventAt the current raid transition started at
	EvId = nil, -- the raid sky it goes to (nil = back to the cycle)
	From = nil, -- { Id, Blend }: the raid sky showing when it started (nil = the plain cycle)
	EventFrom = nil, -- the raid sky blending out under the new one (State)
	Local = nil, -- { Id, At }: the local raid sky (SetLocalEvent) in place of the attributes
	LocalOut = nil, -- { At, Attr }: it was taken off At, while SkyEventAt said Attr: the blend out runs from At until SkyEventAt moves
	Seg = nil, -- the clock segment applied last (a phase name or a raid boss id)
	Clock = nil, -- the ClockTime applied last
	Lift = false,
	LampLook = nil, -- the look the lamps were written for (each lamp's own Brightness: attribute Config.Sky.Lamps.BaseAttr)
	LampRoot = nil, -- the lobby root written and watched for lamps that arrive later ...
	LampConn = nil, -- ... and its DescendantAdded connection (dropped with the clock / on Stop)
	Lamps = 0,
	Fireflies = 0,
	FireflyFolder = nil,
	Applies = 0,
	Skipped = 0,
	Step = nil, -- the refresh step the last refresh chose (Cycle.Refresh, or Raid.Step while a raid sky blends)
	Waited = 0, -- real seconds the loop has waited since the last refresh (task.wait's return)
	GQ = nil, -- client/GraphicsQuality (lazy); false = unavailable
	Gate = nil, -- client/UiGate (lazy; tests put their own here); false = unavailable
	Preloaded = nil, -- the blend window ("<phase>><next>") whose next theme was preloaded; nil outside a window
	RaidsPreloaded = false, -- the four raid themes were preloaded since Start
}
SkyController._St = St

local function cfg()
	return Config.Sky
end

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

local function graphics()
	if St.GQ == nil then
		local module = Client:FindFirstChild("GraphicsQuality")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		St.GQ = (ok and type(result) == "table") and result or false
	end
	return St.GQ or nil
end

local function uiGate()
	if St.Gate == nil then
		local module = Client:FindFirstChild("UiGate")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		St.Gate = (ok and type(result) == "table") and result or false
	end
	return St.Gate or nil
end

local function lowGraphics()
	local GQ = graphics()
	if GQ and type(GQ.Effective) == "function" then
		local ok, mode = pcall(GQ.Effective)
		return ok and mode == "Low"
	end
	return false
end

local function raidId(id)
	local sky = cfg()
	if type(id) == "string" and sky.RaidThemes[id] and sky.Looks[id] then
		return id
	end
	return nil
end

-- the current raid transition's length: Raid.In toward a raid sky (from the cycle or another raid), Raid.Out back
local function raidSeconds()
	local R = cfg().Transitions.Raid
	return St.EvId and R.In or R.Out
end

-- what the current raid transition shows at server time t: id, blend, fromId, fromBlend (SkyCycle.Preset's event args)
local function shownAt(t)
	local x = 1
	if finite(St.EvAt) then
		x = math.max(0, math.min(1, (t - St.EvAt) / math.max(0.01, raidSeconds())))
	end
	local from = St.From
	if St.EvId then
		if from and from.Id ~= St.EvId and x < 1 then
			return St.EvId, x, from.Id, from.Blend -- raid to raid
		end
		local b0 = from and from.Blend or 0 -- the same raid sky again: on from where it was
		return St.EvId, b0 + (1 - b0) * x, nil, 0
	end
	if from then
		local back = from.Blend * (1 - x)
		if back > 0 then
			return from.Id, back, nil, 0
		end
	end
	return nil, 0, nil, 0
end

-- the raid sky now (SkyEventAt-based, the same on every client that saw the change; a late joiner starts plain):
-- id (or nil), its blend 0..1, and the raid sky it blends from (fromId, fromBlend) on a back-to-back change
local function eventNow(now)
	local sky = cfg()
	local id = raidId(Workspace:GetAttribute(sky.Attr.Event))
	local at = Workspace:GetAttribute(sky.Attr.EventAt)
	if not finite(at) then
		at = nil
	end
	if St.Local then
		id, at = raidId(St.Local.Id), St.Local.At
	elseif St.LocalOut then
		if at == St.LocalOut.Attr then
			at = St.LocalOut.At
		else
			St.LocalOut = nil
		end
	end
	if St.EvSeen and at ~= St.EvAt then
		-- a new transition starts from what the old one shows at its moment (one { Id, Blend }: a raid-to-raid blend
		-- still running hands over its dominant sky)
		local oldId, oldBlend, oldFrom, oldFromBlend = shownAt(at or now)
		if oldFrom and oldBlend < 0.5 then
			St.From = { Id = oldFrom, Blend = oldFromBlend }
		elseif oldId and oldBlend > 0 then
			St.From = { Id = oldId, Blend = oldBlend }
		else
			St.From = nil
		end
	end
	St.EvSeen, St.EvAt, St.EvId = true, at, id
	local shownId, blend, fromId, fromBlend = shownAt(now)
	if not shownId or (St.EvId and blend >= 1) then
		St.From = nil -- the transition is over: nothing left to blend from
	end
	return shownId, blend, fromId, fromBlend
end

local function resetEvent()
	St.EvSeen, St.EvAt, St.EvId, St.From, St.EventFrom = false, nil, nil, nil, nil
end

-- the refresh step and tween at server time now (after eventNow): Raid.Step / Raid.Step while a raid transition is
-- still running (something to blend, inside its In / Out s), else Cycle.Refresh / Cycle.Tween. Also Raid.Step while a
-- phase blends (at.Blend > 0) on a sped-up clock (the dev /sky speed, SkySpeed > 1; kit-b S1 review): at speed 10 a
-- 2 s step is 20 loop s against the 30 loop s haze bridge, so the faces could swap in clear air. The whole 75 s blend
-- (not only the bridge) so the last 2 s step before it can never jump past the bridge's start; at speed 1 (play) the
-- 2 s step is 2 loop s and stays
local function cadence(now, at)
	local sky = cfg()
	local step = sky.Transitions.Raid.Step
	if St.EvSeen and finite(St.EvAt) and (St.EvId ~= nil or St.From ~= nil) and now - St.EvAt < raidSeconds() then
		return step, step
	end
	local speed = Workspace:GetAttribute(sky.Attr.Speed)
	if finite(speed) and speed > 1 and type(at) == "table" and finite(at.Blend) and at.Blend > 0 then
		return step, step
	end
	return sky.Cycle.Refresh, sky.Cycle.Tween
end

----------------------------------------------------------------------
-- The battle lift
----------------------------------------------------------------------

local function outdoorBattle()
	local player = Players.LocalPlayer
	local value = player and player:GetAttribute(Config.Attr.InBattle)
	local prefix = cfg().Lift.Prefix
	return type(value) == "string" and value:sub(1, #prefix) == prefix
end

local function setLift()
	local L = cfg().Lift
	local want = St.Running and St.Look ~= nil and L.Looks[St.Look] == true and outdoorBattle()
	if want and not St.Lift then
		St.Lift = true
		pcall(LightingStack.Push, L.Id, L.Preset, L.Seconds)
	elseif not want and St.Lift then
		St.Lift = false
		pcall(LightingStack.Pop, L.Id, L.Seconds)
	end
end

----------------------------------------------------------------------
-- Lamps
----------------------------------------------------------------------

local function restoreLamps()
	local attr = cfg().Lamps.BaseAttr
	local root = St.LampRoot
	if St.LampConn then
		St.LampConn:Disconnect()
	end
	St.LampConn, St.LampRoot = nil, nil
	if root then
		for _, d in ipairs(root:GetDescendants()) do
			local base = d:IsA("PointLight") and d:GetAttribute(attr)
			if finite(base) then
				pcall(function()
					d.Brightness = base
					d:SetAttribute(attr, nil)
				end)
			end
		end
	end
	St.Lamps = 0
end

-- one lamp under the look in St.LampLook: its own value x Night (a dark look) or x Day, never over Max. The own value
-- is kept on the light (BaseAttr) the first time, so it never becomes a written one (no x0.35 on x0.35)
local function writeLamp(d)
	local C = cfg().Lamps
	if not (d:IsA("PointLight") and d.Parent and C.Names[d.Parent.Name]) then
		return false
	end
	local base = d:GetAttribute(C.BaseAttr)
	if not finite(base) then
		base = d.Brightness
		d:SetAttribute(C.BaseAttr, base)
	end
	local k = C.Looks[St.LampLook] and C.Night or C.Day
	d.Brightness = math.min(base * k, C.Max)
	return true
end

local function writeLamps()
	local root = Workspace:FindFirstChild(cfg().Lamps.Root)
	if not root then
		return
	end
	local n = 0
	for _, d in ipairs(root:GetDescendants()) do
		if writeLamp(d) then
			n = n + 1
		end
	end
	St.Lamps = n
	-- a lamp that replicates in later takes the look at once (by day its built value is the bright one)
	if St.LampRoot ~= root then
		if St.LampConn then
			St.LampConn:Disconnect()
		end
		St.LampRoot = root
		St.LampConn = root.DescendantAdded:Connect(function(d)
			if St.LampLook and writeLamp(d) then
				St.Lamps = St.Lamps + 1
			end
		end)
	end
end

-- written on a look change; under the same look only while the lobby root is missing or was replaced (a lobby that
-- replicates after the first refresh, a LobbyBuilder.Build), never again over the same root
local function setLamps()
	local look = St.Running and St.Look or nil
	if look == St.LampLook and (look == nil or (St.LampRoot and St.LampRoot.Parent)) then
		return
	end
	St.LampLook = look
	if look then
		writeLamps()
	else
		restoreLamps()
	end
end

----------------------------------------------------------------------
-- Fireflies
----------------------------------------------------------------------

local function clearFireflies()
	if St.FireflyFolder then
		pcall(function()
			St.FireflyFolder:Destroy()
		end)
	end
	St.FireflyFolder = nil
	St.Fireflies = 0
end

-- the lobby's trees (a "...Tree" model not inside another "...Tree"), sorted so every client picks the same ones
local function trees(root)
	local list = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("Model") and d.Name:sub(-4) == "Tree" and not (d.Parent and d.Parent.Name:sub(-4) == "Tree") then
			local ok, pivot = pcall(function()
				return d:GetPivot()
			end)
			if ok and pivot then
				list[#list + 1] = { Model = d, Pos = pivot.Position }
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Pos.X ~= b.Pos.X then
			return a.Pos.X < b.Pos.X
		end
		return a.Pos.Z < b.Pos.Z
	end)
	return list
end

local function buildFireflies()
	local F = cfg().Fireflies
	local root = Workspace:FindFirstChild(F.Root)
	if not root then
		return
	end
	local list = trees(root)
	if #list == 0 then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = F.Folder
	local n = 0
	for i = 1, math.min(F.Max, #list) do
		local host = Instance.new("Part")
		host.Name = "Fireflies"
		host.Anchored = true
		host.CanCollide = false
		host.CanTouch = false
		host.CanQuery = false
		host.CastShadow = false
		host.Transparency = 1
		host.Size = Vector3.new(F.Spread, F.Height * 0.6, F.Spread)
		host.CFrame = CFrame.new(list[i].Pos + Vector3.new(0, F.Height, 0))
		local e = require(Shared:WaitForChild("FxSprites")).Apply(Instance.new("ParticleEmitter"), "Glow") -- kit B X1: the own soft glow (was the default sparkle)
		e.Rate = F.Rate
		e.Lifetime = NumberRange.new(F.Lifetime[1], F.Lifetime[2])
		e.Speed = NumberRange.new(F.Speed[1], F.Speed[2])
		e.SpreadAngle = Vector2.new(180, 180)
		e.Color = ColorSequence.new(F.Color)
		e.LightEmission = 1
		e.LightInfluence = 0
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.2, F.Size),
			NumberSequenceKeypoint.new(0.8, F.Size),
			NumberSequenceKeypoint.new(1, 0),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.15),
			NumberSequenceKeypoint.new(0.75, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.Drag = 0.6
		e.Acceleration = Vector3.new(0, 0.05, 0)
		e.Parent = host
		host.Parent = folder
		n = n + 1
	end
	folder.Parent = Workspace
	St.FireflyFolder = folder
	St.Fireflies = n
end

local function setFireflies()
	local look = St.Running and St.Look or nil
	local want = look ~= nil and cfg().Fireflies.Looks[look] == true and not lowGraphics()
	if want and not (St.FireflyFolder and St.FireflyFolder.Parent) then
		clearFireflies()
		buildFireflies()
	elseif not want and St.FireflyFolder then
		clearFireflies()
	end
end

----------------------------------------------------------------------
-- Preload (kit-b S2)
----------------------------------------------------------------------

-- the next theme once per blend window (at = SkyCycle.At); a refresh outside every window clears the mark
local function preloadNext(at)
	if not (finite(at.Blend) and at.Blend > 0) then
		St.Preloaded = nil
		return
	end
	local key = tostring(at.Phase) .. ">" .. tostring(at.Next)
	if St.Preloaded ~= key then
		St.Preloaded = key
		pcall(SkyTransition.Preload, cfg().Themes[at.Next])
	end
end

-- the four raid themes (sorted by boss id: every client fetches them in the same order), once per Start: S2 review,
-- Transitions.Preload.RaidDelay s later (the lobby's own assets first), then one theme at a time in this one thread
-- (each PreloadAsync waits for the last); a Stop (or a new Start) ends the queue
local function preloadRaids()
	if St.RaidsPreloaded or not St.Running then
		return
	end
	St.RaidsPreloaded = true
	local gen = St.Gen
	local pre = cfg().Transitions.Preload
	local delay = type(pre) == "table" and tonumber(pre.RaidDelay) or 4
	task.delay(delay, function()
		local ids = {}
		for bossId in pairs(cfg().RaidThemes) do
			ids[#ids + 1] = bossId
		end
		table.sort(ids)
		for _, bossId in ipairs(ids) do
			if not St.Running or St.Gen ~= gen then
				return
			end
			pcall(SkyTransition.Preload, cfg().RaidThemes[bossId], true)
		end
	end)
end

----------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------

-- everything this controller adds goes away (no clock, Stop); the base stays where the sky left it
local function settle()
	St.Phase, St.Next, St.Look, St.Theme, St.Event, St.EventBlend = nil, nil, nil, nil, nil, 0
	resetEvent()
	setLift()
	setLamps()
	setFireflies()
end

function SkyController.Refresh(now)
	local sky = cfg()
	local A = sky.Attr
	local epoch = Workspace:GetAttribute(A.Epoch)
	St.Waited = 0
	if not finite(epoch) then
		St.Step = sky.Cycle.Refresh
		settle()
		return SkyController.State()
	end
	now = finite(now) and now or Workspace:GetServerTimeNow()
	local at = SkyCycle.At(now, epoch, Workspace:GetAttribute(A.Speed), Workspace:GetAttribute(A.Offset))
	preloadNext(at)
	local event, eventBlend, fromId, fromBlend = eventNow(now)
	local step, tween = cadence(now, at)
	St.Step = step
	local preset, theme = SkyCycle.Preset(at, event, eventBlend, SkyFaces.For, fromId, fromBlend)
	-- the raid sky in charge (the same moments SkyCycle switches the clock and the skybox): the new raid from its
	-- blend 0.5, else the one it blends from while that is at 0.5 or more
	local raid = nil
	if event ~= nil and eventBlend >= 0.5 then
		raid = event
	elseif fromId ~= nil and fromBlend >= 0.5 then
		raid = fromId
	end
	St.Phase, St.Next, St.Theme, St.Event, St.EventBlend, St.EventFrom = at.Phase, at.Next, theme, event, eventBlend, fromId
	St.Look = raid or (at.Blend >= 0.5 and at.Next or at.Phase)

	if LightingStack.Busy() then
		St.Skipped = St.Skipped + 1
	else
		local seconds = St.First and 0 or tween
		local clock = preset.Lighting.ClockTime
		local seg = raid or at.Phase
		local instant = nil
		if not St.First and finite(clock) and finite(St.Clock) then
			local jump = seg ~= St.Seg and math.abs(SkyCycle.ClockDelta(St.Clock, clock)) > sky.ClockJump
			local midnight = clock < St.Clock and SkyCycle.ClockDelta(St.Clock, clock) > 0 -- forward past 24 -> 0
			if jump or midnight then
				instant = { Lighting = { ClockTime = true } }
			end
		end
		LightingStack.SetBase(preset, seconds, instant)
		St.First = false
		St.Seg, St.Clock = seg, clock
		St.Applies = St.Applies + 1
		local GQ = graphics()
		if GQ and type(GQ.Recap) == "function" then
			pcall(GQ.Recap) -- in place: the cap rides the next SetBase, never a re-push over these tweens
		end
	end
	setLift()
	setLamps()
	setFireflies()
	return SkyController.State()
end

function SkyController.State()
	return {
		Phase = St.Phase,
		Next = St.Next,
		Look = St.Look,
		Theme = St.Theme,
		Event = St.Event,
		EventBlend = St.EventBlend,
		EventFrom = St.EventFrom,
		Local = St.Local and St.Local.Id or nil,
		Lift = St.Lift,
		Lamps = St.Lamps,
		Fireflies = St.Fireflies,
		Applies = St.Applies,
		Skipped = St.Skipped,
		Loops = St.Loops,
		Running = St.Running,
	}
end

local function safeRefresh()
	local ok, err = pcall(SkyController.Refresh)
	if not ok then
		warn("[SkyController] refresh failed: " .. tostring(err))
	end
end

function SkyController.Start()
	if St.Running then
		return
	end
	St.Running = true
	St.First = true
	St.Gen = St.Gen + 1
	local gen = St.Gen
	local A = cfg().Attr
	-- a dev jump / speed change or a raid start shows at the next moment, not up to 2 s later
	for _, key in ipairs({ A.Epoch, A.Speed, A.Offset, A.Event, A.EventAt }) do
		St.Conns[#St.Conns + 1] = Workspace:GetAttributeChangedSignal(key):Connect(function()
			task.defer(function()
				if St.Running and St.Gen == gen then
					safeRefresh()
				end
			end)
		end)
	end
	local player = Players.LocalPlayer
	if player then
		St.Conns[#St.Conns + 1] = player:GetAttributeChangedSignal(Config.Attr.InBattle):Connect(function()
			if St.Running and St.Gen == gen then
				pcall(setLift)
			end
		end)
	end
	-- the raid skies after PLAY (a raid becomes possible; RaidDelay s later), from now when PLAY came first
	St.RaidsPreloaded = false
	local gate = uiGate()
	if gate and type(gate.HasPlayed) == "function" and gate.HasPlayed() then
		preloadRaids()
	elseif gate and type(gate.Played) == "table" and type(gate.Played.Connect) == "function" then
		St.Conns[#St.Conns + 1] = gate.Played:Connect(function()
			if St.Running and St.Gen == gen then
				preloadRaids()
			end
		end)
	end
	safeRefresh()
	St.Loops = St.Loops + 1
	St.Thread = task.spawn(function()
		while true do
			-- wake at most every Raid.Step s (cheap), never past the due step; refresh when the step the last refresh
			-- chose is due, so a raid that starts mid-step goes onto the fast cadence at once. St.Waited counts the
			-- REAL seconds task.wait returns (each wait runs up to a frame late: four nominal 0.5 s ticks drifted the
			-- 2 s step to 2.13 s, a pause in the 2 s linear tweens); the last wait is only what is left, so a refresh
			-- is at most one frame late, as with one task.wait(2)
			local step = St.Step or cfg().Cycle.Refresh
			local dt = task.wait(math.max(0, math.min(cfg().Transitions.Raid.Step, step - St.Waited)))
			if not St.Running or St.Gen ~= gen then
				break
			end
			St.Waited = St.Waited + (tonumber(dt) or 0)
			if St.Waited >= step - 1e-6 then
				St.Waited = 0
				safeRefresh()
			end
		end
		if St.Gen == gen then
			St.Loops = St.Loops - 1
			St.Thread = nil
		end
	end)
end

SkyController.Init = SkyController.Start

-- a refresh right after this frame (a running controller only), like the attribute signals' (sky audit F3: the pocket
-- fight's sky used to wait for the next loop tick, and could open on the swap itself)
local function refreshSoon()
	if not St.Running then
		return
	end
	local gen = St.Gen
	task.defer(function()
		if St.Running and St.Gen == gen then
			safeRefresh()
		end
	end)
end

function SkyController.SetLocalEvent(bossId)
	if bossId == nil then
		if St.Local then
			St.LocalOut = { At = Workspace:GetServerTimeNow(), Attr = Workspace:GetAttribute(cfg().Attr.EventAt) }
			St.Local = nil
			refreshSoon()
		end
		return true
	end
	if not raidId(bossId) then
		return false
	end
	if not (St.Local and St.Local.Id == bossId) then
		St.Local = { Id = bossId, At = Workspace:GetServerTimeNow() }
		refreshSoon()
	end
	St.LocalOut = nil
	return true
end

function SkyController.Stop()
	if not St.Running then
		return
	end
	St.Running = false
	St.Gen = St.Gen + 1
	if St.Thread then
		pcall(task.cancel, St.Thread)
		St.Thread = nil
		St.Loops = St.Loops - 1
	end
	for _, c in ipairs(St.Conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	St.Conns = {}
	settle()
	St.Seg, St.Clock = nil, nil
	resetEvent()
	St.Local, St.LocalOut = nil, nil
end

return SkyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1165">
            <Properties>
              <string name="Name">SkyDragonController</string>
              <string name="Source"><![CDATA[-- SkyDragonController (client): the Sage Dragon, a big eastern (serpentine) dragon that swims through the sky in a
-- slow closed loop high above the lobby, purely for atmosphere (ARCHITECTURE_V3.md section 7 + "ART DIRECTION").
--
--   SkyDragonController.Init()
--   SkyDragonController.GetModel()      -- the dragon Model once it is built (nil before; debug / tests)
--   SkyDragonController.IsPaused()      -- true while the camera is far from the lobby (the dragon is frozen)
--   SkyDragonController.SetHeld(on)     -- GraphicsQuality Low / High: out of the world + no frame loop; kept across rebuilds
--   SkyDragonController.IsHeld()        -- the SetHeld flag
--
-- Look: detailed fine-voxel style, every piece sculpted with shared/Voxel.lua at ONE voxel scale (1 stud).
--   * head: a long snout with a bulbous upturned nose and carved nostrils, glowing amber eyes (slit pupil and a white
--     highlight voxel) set one voxel into the face under heavy overhanging brows, gold antlers with a forward tine,
--     layered ivory cheek frills, a mane collar and a crown tuft, gold whisker roots and fangs; the lower jaw (cream
--     chin plates and a wise sage's beard) is its own piece and slowly opens and closes;
--   * body: 14 tube segments of sage-green scales in three shades (light back, mid flanks, a dark flank line), a flat
--     cream belly with raised plate rims, a darker raised spine ridge and a tiered jade dorsal spine; thick at the
--     shoulders, tapering to a tail that ends in a puffy cloud tuft; four short legs with ivory claws and elbow
--     tufts paddle while it swims;
--   * block-chain whiskers (gold) and mane locks (ivory) trail from the head as follow-the-leader chains;
--   * small voxel cloud puffs drift off the tail tuft, swell and fade.
-- Big surfaces are auto-shaded with Voxel.Shade; small features use hand-placed shade keys (dark root, light tip),
-- and the forms are bevelled boxes and stepped tiers, which keeps the silhouettes crisp and the part count low.
-- Motion: the head flies a smooth closed 3D figure-eight (70 s per loop at constant speed) 140-220 studs above
-- Config.Lobby.Origin, with a vertical swimming bob and a little sway. Every body piece follows the head along the
-- path history (a ring buffer of head positions sampled every stud), so the whole body undulates like a real
-- serpent and banks into each turn exactly where the head banked.
-- Runtime: client only, in workspace.ClientFx; parts are anchored with collisions, touches, queries and shadows off.
-- One RenderStepped connection poses every part and moves them all with one workspace:BulkMoveTo call; the per-frame
-- code builds no tables, closures or instances (only the unavoidable CFrame values). Frozen while the camera is far
-- from the lobby (e.g. the player is in a match). About 295 parts.
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local SkyDragonController = {}

local sin, cos, sqrt, floor, max, min = math.sin, math.cos, math.sqrt, math.floor, math.max, math.min
local PI = math.pi
local TAU = PI * 2

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local VS = 1 -- studs per voxel, the same for every piece of the dragon
local FOLDER_NAME = "ClientFx"
local MODEL_NAME = "SkyDragon"
local TAG = "[SkyDragon] "
local FAR_SQ = 1500 * 1500 -- camera further than this from the lobby -> frozen
local MAX_DT = 0.1

-- Flight path (studs, relative to Config.Lobby.Origin): a figure-eight over the plaza and the home plots that crosses
-- itself at two different heights (47 studs apart), so the body never passes through itself.
local PATH = {
	Period = 70, -- seconds per loop
	AmpX = 280,
	AmpZ = 150,
	Altitude = 170,
	AltA = 32,
	AltB = 12,
	BobAmp = 4, -- the swimming wave that runs down the body
	BobPeriod = 3.4,
	SwayAmp = 3,
	SwayPeriod = 5.3,
	BankGain = 34, -- lean of the up vector per unit of curvature (studs)
	MaxTilt = 0.7, -- tan(35 degrees)
}

-- Body layout along the path (studs).
local BODY = {
	SegHalf = 5, -- a segment is 2 * SegHalf + 1 voxels long
	Spacing = 7.5, -- between segment centres (neighbours overlap by 3.5 studs, so bends never open gaps)
	HeadGap = 6, -- from the head pivot to the first segment centre
	TailGap = 6.5, -- from the last segment centre to the tail pivot
	LookBase = 3, -- half the path baseline used to aim a body piece
	HeadLook = 6, -- baseline used to aim the head
}

-- Radius (voxels) per segment, neck first; the first two carry the mane locks instead of a dorsal spine.
local SEGMENTS = {
	{ R = 3.0, Fin = false },
	{ R = 3.5, Fin = false },
	{ R = 4.0, Fin = true },
	{ R = 4.5, Fin = true },
	{ R = 4.5, Fin = true },
	{ R = 4.5, Fin = true },
	{ R = 4.0, Fin = true },
	{ R = 4.0, Fin = true },
	{ R = 3.5, Fin = true },
	{ R = 3.5, Fin = true },
	{ R = 3.0, Fin = true },
	{ R = 2.5, Fin = true },
	{ R = 2.0, Fin = true },
	{ R = 1.5, Fin = true },
}

-- Part budget per piece (Voxel.Build folds near-equal auto shades first when a piece is over it). Every piece is
-- designed to fit, so these are safety caps: ~73 head, 14 jaw, 7-13 per segment, 6 per leg, 11 tail.
local BUDGET = { Head = 80, Jaw = 14, Segment = 14, Leg = 6, Tail = 14, Puff = 2 }

-- Legs paddle as they swim: segment index, side, phase.
local LEGS = {
	{ Seg = 4, Side = 1, Phase = 0 },
	{ Seg = 4, Side = -1, Phase = PI },
	{ Seg = 10, Side = 1, Phase = PI * 0.5 },
	{ Seg = 10, Side = -1, Phase = PI * 1.5 },
}
local LEG = { RestPitch = -0.55, Splay = 0.3, Swing = 0.4, Freq = 1.9 }

-- Block chains trailing from the head (anchor in head-local studs; the head looks along -Z).
local CHAINS = {
	{ Key = "Whisker", Anchor = { 4.2, 0.5, -10.5 }, Links = 4, Length = 2.3, Thick = 0.8, ThickEnd = 0.45, Droop = 2.2, Flutter = 2.4, Freq = 2.6, Phase = 0 },
	{ Key = "Whisker", Anchor = { -4.2, 0.5, -10.5 }, Links = 4, Length = 2.3, Thick = 0.8, ThickEnd = 0.45, Droop = 2.2, Flutter = 2.4, Freq = 2.6, Phase = 1.9 },
	{ Key = "Mane", Anchor = { 0, 5.2, 6.2 }, Links = 4, Length = 2.3, Thick = 1.7, ThickEnd = 0.9, Droop = 0.5, Flutter = 1.4, Freq = 1.7, Phase = 0.7 },
	{ Key = "Mane", Anchor = { 3, 3.6, 6.4 }, Links = 4, Length = 2.2, Thick = 1.5, ThickEnd = 0.8, Droop = 0.8, Flutter = 1.4, Freq = 1.9, Phase = 2.3 },
	{ Key = "Mane", Anchor = { -3, 3.6, 6.4 }, Links = 4, Length = 2.2, Thick = 1.5, ThickEnd = 0.8, Droop = 0.8, Flutter = 1.4, Freq = 1.9, Phase = 4.1 },
}

-- Cloud puffs shed by the tail tuft.
local PUFF = { Pool = 5, Life = 4.2, Every = 0.85, Rise = 1.4, Point = { 0, 2, 11 } }

-- Path history and the arc-length table.
local TRAIL_STEP = 1
local TRAIL_CAP = 256
local ARC_STEPS = 1024

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local Voxel = nil
local palette = nil
local S = {
	Started = false,
	Paused = false,
	Held = false, -- GraphicsQuality Low: the model is out of the world and the frame loop is off (survives rebuilds)
	Connection = nil,
	Model = nil,
	Clock = 0,
	PathLength = 1,
	Speed = 1,
	UseBulk = true,
	BulkMode = nil,
	Rng = nil,
	JawHinge = nil,
	TuftV = nil,
	NextPuff = 1,
	PuffTimer = 0,
	-- part index ranges of the rigid pieces
	HeadFirst = 1,
	HeadLast = 0,
	JawFirst = 1,
	JawLast = 0,
	TailFirst = 1,
	TailLast = 0,
}
local ox, oy, oz = 0, 300, 0 -- lobby origin
local thetaAtS = {}

-- trail ring buffer (newest sample at trailNewest) and the current head pivot / tilt
local trX, trY, trZ, trTX, trTZ = {}, {}, {}, {}, {}
local trailNewest, trailCount, headLead = 1, 0, 0
local hx, hy, hz, htx, htz = 0, 0, 0, 0, 0
local lastRX, lastRY, lastRZ = 1, 0, 0

-- every moving part, its target CFrame and its offset from its piece's pivot
local parts, cfs, offsets = {}, {}, {}
local nParts = 0
local seg = { First = {}, Last = {}, CF = {} }
local leg = { First = {}, Last = {}, Base = {} }
local chain = { First = {}, Anchor = {}, X = {}, Y = {}, Z = {} }
local puff = { First = {}, Last = {}, Age = {}, X = {}, Y = {}, Z = {}, Rot = {}, Scale = {}, Pos = {}, Size = {} }

----------------------------------------------------------------------
-- Palette: a tidy set of colour families, 2-3 shades each
----------------------------------------------------------------------
local function makePalette()
	local rgb = Color3.fromRGB
	return {
		-- a fresh jade-sage (cheerful, not grey), lighter on the back, deeper underneath
		Scale = rgb(128, 188, 114), Scale_Light = rgb(166, 214, 140), Scale_Dark = rgb(94, 148, 92),
		Ridge = rgb(76, 128, 84), Ridge_Light = rgb(104, 158, 102),
		Fin = rgb(74, 168, 138), Fin_Light = rgb(128, 210, 174),
		Belly = rgb(246, 233, 198), BellyLine = rgb(206, 184, 138),
		Horn = rgb(228, 180, 74), Horn_Light = rgb(250, 218, 124), Horn_Dark = rgb(182, 130, 52),
		Whisker = rgb(238, 196, 92),
		Mane = rgb(244, 242, 232), Mane_Light = rgb(251, 249, 242), Mane_Dark = rgb(212, 216, 214),
		Cloud = rgb(236, 243, 253), Cloud_Light = rgb(248, 251, 255), Cloud_Dark = rgb(202, 218, 242),
		Claw = rgb(244, 236, 214), Claw_Light = rgb(255, 250, 236),
		Eye = { Color = rgb(255, 176, 52), Material = Enum.Material.Neon },
		Pupil = rgb(46, 26, 16),
		Shine = rgb(255, 255, 255),
		Mouth = rgb(122, 42, 56),
		Tooth = rgb(250, 247, 236),
		Nostril = rgb(58, 74, 54),
	}
end

-- keys the part-budget LOD must never recolour (features and the hand-placed shades)
local KEEP = { "Eye", "Pupil", "Shine", "Nostril", "Tooth", "Mouth", "BellyLine", "Horn_Light", "Horn_Dark", "Mane_Light",
	"Mane_Dark", "Ridge_Light", "Fin_Light", "Claw_Light", "Cloud_Light", "Cloud_Dark", "Scale_Dark" }

----------------------------------------------------------------------
-- Sculpting helpers (voxel units; every piece looks along -Z with +Y up)
----------------------------------------------------------------------
local function withExtra(t, extra)
	if extra then
		for k, v in pairs(extra) do
			t[k] = v
		end
	end
	return t
end

-- Phase 6 kit hook scale (SkyDragonController._Blueprint, read-only, never used by the game): the sculpt runs at MK
-- mesh voxels per dragon voxel; mesh cell i sits at (i - MO) / MK dragon voxels (MO = (MK - 1) / 2), so an
-- integer dragon voxel x covers exactly the mesh cells x * MK .. x * MK + MK - 1. MK = 1, MO = 0 in the game.
local MK, MO = 1, 0
local function mk(v)
	return v * MK + MO
end

local function rbox(g, key, c, size, round, extra)
	if MK ~= 1 then
		c = { mk(c[1]), mk(c[2]), mk(c[3]) }
		size = { size[1] * MK, size[2] * MK, size[3] * MK }
		round = round * MK
	end
	return Voxel.Shape(g, withExtra({ Kind = "RoundBox", Center = c, Size = size, Round = round, Key = key }, extra))
end

-- an axis-aligned block of voxels (inclusive voxel ranges); key nil + { Op = "Carve" } removes them
local function vbox(g, key, x0, x1, y0, y1, z0, z1, extra)
	return Voxel.Shape(g, withExtra({
		Kind = "Box",
		Center = { mk((x0 + x1) * 0.5), mk((y0 + y1) * 0.5), mk((z0 + z1) * 0.5) },
		Size = { (x1 - x0 + 1) * MK, (y1 - y0 + 1) * MK, (z1 - z0 + 1) * MK },
		Key = key,
	}, extra))
end

-- one dragon voxel (a block of MK^3 mesh cells in the kit)
local function vset(g, x, y, z, key)
	if MK == 1 then
		Voxel.Set(g, x, y, z, key)
	else
		vbox(g, key, x, x, y, y, z, z)
	end
end

-- the same block on the right (x0..x1 >= 0) and mirrored on the left
local function vpair(g, key, x0, x1, y0, y1, z0, z1, extra)
	vbox(g, key, x0, x1, y0, y1, z0, z1, extra)
	vbox(g, key, -x1, -x0, y0, y1, z0, z1, extra)
end

-- x of the outermost voxel of the row (y, z) on one side (side = 1: +X, -1: -X), or nil
local function outerX(g, side, y, z)
	for i = 16 * MK + MK - 1, 0, -1 do
		if Voxel.Get(g, i * side, y, z) ~= nil then
			return i * side
		end
	end
	return nil
end

-- y of the topmost voxel of the column (x, z), or nil
local function topY(g, x, z)
	for y = 16 * MK + MK - 1, -16 * MK, -1 do
		if Voxel.Get(g, x, y, z) ~= nil then
			return y
		end
	end
	return nil
end

-- Paints a small mask onto the outer side surface, set ONE voxel into it (the surface voxel is removed and the one
-- behind takes the key), so eyes sit inside the face instead of on it. rows: top row first; columns run from the
-- front (zFront) backwards; codes maps a character to a palette key ("." = untouched). Only cells whose surface
-- voxel is skin (a "Scale" key) are touched.
local SKIN = { Scale = true, Scale_Light = true, Scale_Dark = true }
local function sideMask(g, side, yTop, zFront, rows, codes)
	for r = 1, #rows do
		local row = rows[r]
		local y = yTop - (r - 1)
		for c = 1, #row do
			local key = codes[row:sub(c, c)]
			if key then
				local z = zFront + (c - 1)
				for dy = 0, MK - 1 do
					for dz = 0, MK - 1 do
						local ys, zs = y * MK + dy, z * MK + dz
						local x = outerX(g, side, ys, zs)
						if x and SKIN[Voxel.Get(g, x, ys, zs)] then
							Voxel.Set(g, x, ys, zs, nil)
							Voxel.Set(g, x - side, ys, zs, key)
						end
					end
				end
			end
		end
	end
end

local EYE_ROWS = { ".SEE.", "EEPEE", ".EPE." }
local EYE_CODES = { E = "Eye", P = "Pupil", S = "Shine" }
local PAINT_SCALE = { Op = "Paint", OnlyKeys = "Scale" }
local CARVE = { Op = "Carve" }

----------------------------------------------------------------------
-- The pieces
----------------------------------------------------------------------
-- Head: the pivot (0, 0, 0) is the neck joint; the nose reaches z = -13.
local function sculptHead()
	local g = Voxel.NewGrid(20)
	-- skull, long snout and the bulbous upturned nose
	rbox(g, "Scale", { 0, 1.5, 0 }, { 9, 8, 9 }, 2.4)
	rbox(g, "Scale", { 0, 0.5, -8 }, { 7, 5, 9 }, 1.6)
	rbox(g, "Scale", { 0, 2.3, -11.5 }, { 6, 3, 3.4 }, 1.1)
	-- the spine ridge runs on over the nose; heavy brows overhang the eyes and end in small crests
	vbox(g, "Ridge", 0, 0, 4, 4, -9, -4)
	vbox(g, "Ridge", -1, 1, 6, 6, -3, 0)
	vpair(g, "Ridge", 2, 5, 4, 5, -5, -2)
	vpair(g, "Ridge_Light", 3, 4, 6, 6, -3, -1)
	-- ivory mane: a collar behind the skull, layered cheek frills sweeping back, a crown tuft
	rbox(g, "Mane", { 0, 1.5, 5.5 }, { 11, 9, 4 }, 1.6, { KeepExisting = true })
	vpair(g, "Mane_Light", 5, 5, 1, 2, 1, 6)
	vpair(g, "Mane", 5, 6, -1, 0, 1, 8)
	vpair(g, "Mane_Dark", 5, 5, -3, -2, 2, 7)
	vbox(g, "Mane_Light", -1, 1, 7, 7, 1, 6)
	vbox(g, "Mane", 0, 0, 8, 8, 3, 8)
	-- gold antlers (dark at the root, light at the tip) with a forward tine, and gold whisker roots
	vpair(g, "Horn_Dark", 2, 3, 6, 7, 0, 1)
	vpair(g, "Horn", 2, 3, 8, 8, 1, 4)
	vpair(g, "Horn", 3, 3, 9, 9, 4, 7)
	vpair(g, "Horn_Light", 3, 4, 9, 9, 8, 9)
	vpair(g, "Horn_Light", 4, 4, 10, 11, 10, 11)
	vpair(g, "Horn", 2, 2, 9, 10, 1, 1)
	vpair(g, "Horn_Light", 2, 2, 11, 11, 0, 0)
	vpair(g, "Horn", 4, 4, 0, 1, -11, -10)
	-- palate (seen when the jaw opens) and fangs at the lip line
	vbox(g, "Mouth", -1, 1, -2, -2, -11, -4, PAINT_SCALE)
	vset(g, 3, -2, -11, "Tooth")
	vset(g, -3, -2, -11, "Tooth")
	Voxel.Shade(g, { Only = { Scale = true }, Crease = 0.15, Smooth = 2 })
	-- carved nostrils on top of the nose and glowing eyes set into the face under the brows
	for side = -1, 1, 2 do
		for x = 1, 2 do
			for dx = 0, MK - 1 do
				for dz = 0, MK - 1 do
					local xs, zs = side * x * MK + dx, -12 * MK + dz
					local y = topY(g, xs, zs)
					if y then
						Voxel.Set(g, xs, y, zs, nil)
						Voxel.Set(g, xs, y - 1, zs, "Nostril")
					end
				end
			end
		end
		sideMask(g, side, 3, -4, EYE_ROWS, EYE_CODES)
	end
	return g
end

-- Lower jaw, in head coordinates (it hinges at JAW_HINGE): mouth, fangs, cream chin plates and a sage's beard.
local JAW_HINGE = { 0, -2.5, 0.5 }
local function sculptJaw()
	local g = Voxel.NewGrid(20)
	rbox(g, "Scale", { 0, -4, -6.5 }, { 5, 3, 11 }, 1)
	vbox(g, "Mouth", -1, 1, -3, -3, -11, -2, PAINT_SCALE)
	vset(g, 2, -2, -11, "Tooth")
	vset(g, -2, -2, -11, "Tooth")
	vbox(g, "Belly", -1, 1, -5, -5, -11, -1, PAINT_SCALE)
	-- the beard: tiers narrowing downwards, swept back by the wind
	vbox(g, "Mane_Light", -1, 1, -6, -6, -11, -6)
	vbox(g, "Mane", -1, 1, -7, -7, -10, -6)
	vbox(g, "Mane", 0, 0, -8, -8, -9, -6)
	vbox(g, "Mane_Dark", 0, 0, -9, -9, -8, -7)
	vbox(g, "Mane_Dark", 0, 0, -10, -10, -7, -7)
	return g
end

-- One body segment: a straight tube of radius r (voxels) centred on (0, 0, 0) with a flat plated belly. It is
-- sculpted longer than it ends up, so the shading has no end effects, then trimmed to 2 * SegHalf + 1 voxels.
local function sculptSegment(r, withFin)
	local g = Voxel.NewGrid(20)
	local ry = r * 0.9
	local half = BODY.SegHalf
	local ext = half + 5
	Voxel.Shape(g, {
		Kind = "Ellipsoid",
		Center = { MO, MO, MO },
		Radius = { r * MK, ry * MK, 80 * MK },
		Key = "Scale",
		Pattern = function(_, _, z)
			-- (z - MO) / MK is the dragon-voxel coordinate; at MK = 1 this is exactly -ext <= z <= ext
			local zd = (z - MO) / MK
			if zd < -ext - 0.5 or zd > ext + 0.5 then
				return false
			end
			return nil
		end,
	})
	local top = floor(ry + 0.25)
	local bottom = -top
	if r >= 3 then
		-- flatten the belly: drop the narrow lowest row
		vbox(g, nil, -20, 20, bottom, bottom, -ext, ext, CARVE)
		bottom = bottom + 1
	end
	-- cream belly below the cut (left unshaded so it stays bright seen from below), darker raised spine ridge
	local cut = -floor(ry * 0.4 + 0.5)
	local w = (r >= 3.5) and 1 or 0
	vbox(g, "Belly", -20, 20, -20, cut, -ext, ext, PAINT_SCALE)
	vbox(g, "Ridge", -w, w, top, top + 1, -ext, ext)
	Voxel.Shade(g, { Only = { Scale = true }, Crease = 0, Smooth = 2 })
	if r >= 2.5 then
		-- a darker flank line just above the belly: the third scale shade, and a crisp belly outline from below
		vbox(g, "Scale_Dark", -20, 20, cut + 1, cut + 1, -ext, ext, PAINT_SCALE)
	end
	-- trim to length (the neighbours overlap both ends)
	vbox(g, nil, -20, 20, -20, 20, half + 1, ext + 1, CARVE)
	vbox(g, nil, -20, 20, -20, 20, -ext - 1, -half - 1, CARVE)
	if r >= 3 then
		-- belly plate edge: a scute rim one voxel proud of the belly, inset from the sides, in the stretch of the
		-- belly that only this segment shows
		local wb = 0
		while wb < 20 and Voxel.Get(g, (wb + 1) * MK, bottom * MK, 0) ~= nil do
			wb = wb + 1
		end
		wb = max(wb - 1, 0)
		vbox(g, "BellyLine", -wb, wb, bottom - 1, bottom - 1, -1, -1)
	end
	-- a flat jade dorsal spine in tiers that lean back, lighter at the tip
	if withFin then
		local h = max(2, floor(r + 0.5))
		local tiers = floor((h + 1) / 2)
		for t = 0, tiers - 1 do
			local y0 = top + 2 + t * 2
			local y1 = min(y0 + 1, top + 1 + h)
			local key = (tiers > 1 and t == tiers - 1) and "Fin_Light" or "Fin"
			vbox(g, key, 0, 0, y0, y1, -2 + t * 2, 2 + min(t, 1))
		end
	end
	return g
end

-- A short leg: the pivot is the shoulder / hip joint; it reaches down with the paw and its claws forward.
local function sculptLeg()
	local g = Voxel.NewGrid(10)
	vbox(g, "Scale", -1, 1, -3, 0, 0, 2)
	vbox(g, "Scale", -1, 1, -5, -3, -1, 0)
	vbox(g, "Scale_Dark", -1, 1, -6, -6, -3, 0)
	vbox(g, "Claw", -1, 1, -6, -6, -4, -4)
	vbox(g, "Claw_Light", 0, 0, -6, -6, -5, -5)
	vbox(g, "Mane", 0, 0, -3, -2, 3, 5)
	return g
end

-- Tail tip: tapers on from the last segment into a puffy cloud tuft (cloud white, light bumps on top, a cool
-- blue-white underside).
local function sculptTail()
	local g = Voxel.NewGrid(20)
	vbox(g, "Scale", -1, 1, -1, 1, -5, 2)
	vbox(g, "Scale", -1, 1, 0, 1, 3, 5)
	vbox(g, "Belly", -1, 1, -1, -1, -5, 2, PAINT_SCALE)
	vbox(g, "Ridge", 0, 0, 2, 2, -5, 4)
	vbox(g, "Cloud", -3, 3, 0, 3, 6, 12)
	vpair(g, "Cloud", 4, 4, 1, 2, 7, 11)
	vbox(g, "Cloud", -2, 2, 0, 2, 5, 5)
	vbox(g, "Cloud", -2, 2, 1, 2, 13, 13)
	vbox(g, "Cloud_Dark", -2, 2, -1, -1, 7, 11)
	vbox(g, "Cloud_Light", -3, 0, 4, 4, 6, 8)
	vbox(g, "Cloud_Light", 0, 2, 4, 4, 9, 11)
	vbox(g, "Cloud_Light", -1, 1, 5, 5, 7, 7)
	return g
end

-- A small voxel cloud puff, centred on (0, 0, 0): a flat base with a soft bump, lit from above.
local function sculptPuff()
	local g = Voxel.NewGrid(6)
	vbox(g, "Cloud", -2, 2, -1, 0, -1, 1)
	vbox(g, "Cloud_Light", -1, 1, 1, 1, -1, 1)
	return g
end

local function buildPiece(grid, name, maxParts)
	return Voxel.Build(grid, {
		VoxelSize = VS,
		Palette = palette,
		Name = name,
		MaxParts = maxParts,
		Keep = KEEP,
		CastShadow = false,
		Anchored = true,
	})
end

----------------------------------------------------------------------
-- Phase 6: Blender meshes (ARCHITECTURE_V3.md "## Phase 6", recipe 4.8; blender/catalog/creatures.json)
----------------------------------------------------------------------
-- Keys: dragon_head, dragon_jaw (head space, like the Part jaw), dragon_seg_<R*10>[f] (one per segment sculpt),
-- dragon_leg, dragon_tail, dragon_puff, dragon_link (one rounded chain bead, resized and recoloured per link).
-- Every piece's manifest pivot = the Part piece's own origin, so the pose code is the same for both builds. When
-- EVERY key is ready on this device the dragon is built from meshes, otherwise from Parts (never a mix); a Part
-- dragon rebuilds itself once when the keys become ready (MeshLibrary.Changed).
local MESH_KEYS = { Head = "dragon_head", Jaw = "dragon_jaw", Leg = "dragon_leg", Tail = "dragon_tail", Puff = "dragon_puff", Link = "dragon_link" }
local meshLib = nil -- MeshLibrary while the dragon is built from meshes

local function segmentKey(spec)
	return "dragon_seg_" .. tostring(floor(spec.R * 10 + 0.5)) .. (spec.Fin and "f" or "")
end

-- every key the mesh dragon needs (sorted, no duplicates)
function SkyDragonController.MeshKeys()
	local set = {}
	for _, key in pairs(MESH_KEYS) do
		set[key] = true
	end
	for _, spec in ipairs(SEGMENTS) do
		set[segmentKey(spec)] = true
	end
	local list = {}
	for key in pairs(set) do
		list[#list + 1] = key
	end
	table.sort(list)
	return list
end

-- a mesh piece: a Model named `name` whose MeshParts sit at the key's manifest centres around the identity origin
local function meshPiece(key, name)
	local model = meshLib.Assemble({ Name = name, Root = false, Parts = { { Key = key } } }, {}, { At = CFrame.new() })
	if not model then
		error("mesh key " .. key .. " did not assemble", 0)
	end
	local list = {}
	for _, d in ipairs(model:GetChildren()) do
		if d:IsA("BasePart") then
			d.CastShadow = false
			list[#list + 1] = d
		end
	end
	return model, list
end

-- one piece from its mesh key (mesh dragon) or from its sculpt (Part dragon)
local function piece(key, sculptFn, name, maxParts)
	if meshLib then
		return meshPiece(key, name)
	end
	return buildPiece(sculptFn(), name, maxParts)
end

-- Phase 6 kit hook (read-only, never called by the game): the dragon pieces sculpted at k mesh voxels per dragon
-- voxel (blender/kit/props/creatures.py). Grid cell i sits at (i - Offset) * VoxelStuds studs from the piece origin.
function SkyDragonController._Blueprint(k)
	k = math.max(1, floor(tonumber(k) or 1))
	Voxel = Voxel or require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Voxel"))
	local saved = palette
	MK, MO = k, (k - 1) / 2
	local ok, result = pcall(function()
		local pieces = { Head = sculptHead(), Jaw = sculptJaw(), Leg = sculptLeg(), Tail = sculptTail(), Puff = sculptPuff() }
		local segs = {}
		for _, spec in ipairs(SEGMENTS) do
			local key = segmentKey(spec)
			if not segs[key] then
				segs[key] = sculptSegment(spec.R, spec.Fin)
			end
		end
		return { Pieces = pieces, Segments = segs }
	end)
	MK, MO = 1, 0
	palette = saved
	if not ok then
		error(result, 0)
	end
	result.Palette = makePalette()
	result.Keep = KEEP
	result.K = k
	result.Offset = (k - 1) / 2
	result.VoxelStuds = VS / k
	result.Chains = CHAINS
	result.JawHinge = JAW_HINGE
	result.PuffPoint = PUFF.Point
	return result
end

----------------------------------------------------------------------
-- Flight path: the base figure-eight, its arc-length table and the bank tilt
----------------------------------------------------------------------
local function basePath(theta)
	return PATH.AmpX * sin(theta), PATH.Altitude + PATH.AltA * sin(theta + 0.9) + PATH.AltB * sin(2 * theta + 0.3), PATH.AmpZ * sin(2 * theta)
end

-- thetaAtS[k] = the path parameter at arc length k / ARC_STEPS of the loop (constant flying speed)
local function setupPath()
	local n = ARC_STEPS * 4
	local cum = { [0] = 0 }
	local px, py, pz = basePath(0)
	for i = 1, n do
		local x, y, z = basePath(TAU * i / n)
		local dx, dy, dz = x - px, y - py, z - pz
		cum[i] = cum[i - 1] + sqrt(dx * dx + dy * dy + dz * dz)
		px, py, pz = x, y, z
	end
	S.PathLength = max(cum[n], 1)
	S.Speed = S.PathLength / PATH.Period
	local j = 0
	for k = 0, ARC_STEPS do
		local s = S.PathLength * k / ARC_STEPS
		while j < n - 1 and cum[j + 1] < s do
			j = j + 1
		end
		local span = cum[j + 1] - cum[j]
		local f = 0
		if span > 1e-9 then
			f = min(max((s - cum[j]) / span, 0), 1)
		end
		thetaAtS[k] = TAU * (j + f) / n
	end
end

local function thetaOf(s)
	local length = S.PathLength
	local u = (s % length) / length * ARC_STEPS
	local k = floor(u)
	local f = u - k
	if k >= ARC_STEPS then
		k = ARC_STEPS - 1
		f = 1
	end
	local a = thetaAtS[k]
	return a + (thetaAtS[k + 1] - a) * f
end

-- the head pivot at time t (world) and the bank tilt (the horizontal lean of the up vector into the turn)
local function headAt(t)
	local theta = thetaOf(t * S.Speed)
	local x, y, z = basePath(theta)
	-- derivatives of the base path by theta
	local x1, x2 = PATH.AmpX * cos(theta), -PATH.AmpX * sin(theta)
	local z1, z2 = 2 * PATH.AmpZ * cos(2 * theta), -4 * PATH.AmpZ * sin(2 * theta)
	local y1 = PATH.AltA * cos(theta + 0.9) + 2 * PATH.AltB * cos(2 * theta + 0.3)
	local y2 = -PATH.AltA * sin(theta + 0.9) - 4 * PATH.AltB * sin(2 * theta + 0.3)
	local sp2 = x1 * x1 + y1 * y1 + z1 * z1
	local tx, tz = 0, 0
	if sp2 > 1e-9 then
		-- curvature vector = (P'' - (P'' . T) T) / |P'|^2: it points to the centre of the turn
		local d = (x1 * x2 + y1 * y2 + z1 * z2) / sp2
		tx = (x2 - d * x1) / sp2 * PATH.BankGain
		tz = (z2 - d * z1) / sp2 * PATH.BankGain
		local m = sqrt(tx * tx + tz * tz)
		if m > PATH.MaxTilt then
			tx, tz = tx * PATH.MaxTilt / m, tz * PATH.MaxTilt / m
		end
	end
	-- swimming bob and a gentle sideways sway (the body follows the head's trail, so the wave runs down it)
	local hl = sqrt(x1 * x1 + z1 * z1)
	local nx, nz = 0, 0
	if hl > 1e-9 then
		nx, nz = -z1 / hl, x1 / hl
	end
	local sway = PATH.SwayAmp * sin(t * TAU / PATH.SwayPeriod)
	local bob = PATH.BobAmp * sin(t * TAU / PATH.BobPeriod)
	return ox + x + nx * sway, oy + y + bob, oz + z + nz * sway, tx, tz
end

----------------------------------------------------------------------
-- Path history (ring buffer of head samples, TRAIL_STEP studs apart)
----------------------------------------------------------------------
local function pushSample(x, y, z, tx, tz)
	trailNewest = trailNewest % TRAIL_CAP + 1
	trX[trailNewest], trY[trailNewest], trZ[trailNewest] = x, y, z
	trTX[trailNewest], trTZ[trailNewest] = tx, tz
	if trailCount < TRAIL_CAP then
		trailCount = trailCount + 1
	end
end

-- moves the head to time t and records a sample every TRAIL_STEP studs along the way
local function advanceHead(t)
	hx, hy, hz, htx, htz = headAt(t)
	if trailCount == 0 then
		pushSample(hx, hy, hz, htx, htz)
	end
	local i = trailNewest
	local dx, dy, dz = hx - trX[i], hy - trY[i], hz - trZ[i]
	local dist = sqrt(dx * dx + dy * dy + dz * dz)
	local guard = 0
	while dist >= TRAIL_STEP and guard < TRAIL_CAP do
		guard = guard + 1
		local f = TRAIL_STEP / dist
		local px, py, pz = trX[i] + dx * f, trY[i] + dy * f, trZ[i] + dz * f
		pushSample(px, py, pz, trTX[i] + (htx - trTX[i]) * f, trTZ[i] + (htz - trTZ[i]) * f)
		i = trailNewest
		dx, dy, dz = hx - px, hy - py, hz - pz
		dist = sqrt(dx * dx + dy * dy + dz * dz)
	end
	headLead = dist
end

-- position and tilt at path distance d behind the head
local function trailAt(d)
	local i = trailNewest
	if d <= headLead then
		local a = 0
		if headLead > 1e-6 then
			a = max(d, 0) / headLead
		end
		return hx + (trX[i] - hx) * a, hy + (trY[i] - hy) * a, hz + (trZ[i] - hz) * a, htx + (trTX[i] - htx) * a, htz + (trTZ[i] - htz) * a
	end
	local k = (d - headLead) / TRAIL_STEP
	local n = floor(k)
	local f = k - n
	if n >= trailCount - 1 then
		n = max(trailCount - 1, 0)
		f = 0
	end
	local i1 = (trailNewest - 1 - n) % TRAIL_CAP + 1
	local i2 = (trailNewest - 2 - n) % TRAIL_CAP + 1
	return trX[i1] + (trX[i2] - trX[i1]) * f, trY[i1] + (trY[i2] - trY[i1]) * f, trZ[i1] + (trZ[i2] - trZ[i1]) * f,
		trTX[i1] + (trTX[i2] - trTX[i1]) * f, trTZ[i1] + (trTZ[i2] - trTZ[i1]) * f
end

-- CFrame at (x, y, z) looking along f, with the up vector leaning by the tilt (tx, tz)
local function orient(x, y, z, fx, fy, fz, tx, tz)
	local fl = sqrt(fx * fx + fy * fy + fz * fz)
	if fl < 1e-6 then
		fx, fy, fz = 0, 0, -1
	else
		fx, fy, fz = fx / fl, fy / fl, fz / fl
	end
	-- right = forward x (tx, 1, tz)
	local rx, ry, rz = fy * tz - fz, fz * tx - fx * tz, fx - fy * tx
	local rl = sqrt(rx * rx + ry * ry + rz * rz)
	if rl < 1e-6 then
		rx, ry, rz = lastRX, lastRY, lastRZ
	else
		rx, ry, rz = rx / rl, ry / rl, rz / rl
		lastRX, lastRY, lastRZ = rx, ry, rz
	end
	-- up = right x forward
	local ux, uy, uz = ry * fz - rz * fy, rz * fx - rx * fz, rx * fy - ry * fx
	return CFrame.new(x, y, z, rx, ux, -fx, ry, uy, -fy, rz, uz, -fz)
end

-- frame of a body piece at path distance d: aimed along the path, banked as the head was there
local function frameAt(d)
	local x, y, z, tx, tz = trailAt(d)
	local ax, ay, az = trailAt(d - BODY.LookBase)
	local bx, by, bz = trailAt(d + BODY.LookBase)
	return orient(x, y, z, ax - bx, ay - by, az - bz, tx, tz)
end

----------------------------------------------------------------------
-- Posing (per frame: numbers and CFrame values only)
----------------------------------------------------------------------
local function writeGroup(first, last, cf)
	for k = first, last do
		cfs[k] = cf * offsets[k]
	end
end

-- follow-the-leader chains: each block keeps its length to the one before it and is dragged along; a wave runs
-- down the strand and gravity pulls it down a little
local function poseChains(headCF, t, dt)
	local right, up, look = headCF.RightVector, headCF.UpVector, headCF.LookVector
	local cx, cy, cz = chain.X, chain.Y, chain.Z
	for c = 1, #CHAINS do
		local spec = CHAINS[c]
		local a = headCF * chain.Anchor[c]
		local px, py, pz = a.X, a.Y, a.Z
		local first = chain.First[c]
		for j = 1, spec.Links do
			local k = first + j - 1
			local dx, dy, dz = cx[k] - px, cy[k] - py, cz[k] - pz
			local w = sin(t * spec.Freq - j * 0.8 + spec.Phase) * spec.Flutter * dt
			local w2 = cos(t * spec.Freq * 0.7 - j * 0.6 + spec.Phase) * spec.Flutter * 0.6 * dt
			dx = dx + up.X * w + right.X * w2
			dy = dy + up.Y * w + right.Y * w2 - spec.Droop * dt
			dz = dz + up.Z * w + right.Z * w2
			local len = sqrt(dx * dx + dy * dy + dz * dz)
			if len < 1e-4 then
				dx, dy, dz, len = -look.X, -look.Y, -look.Z, 1
			end
			local f = spec.Length / len
			local nx, ny, nz = px + dx * f, py + dy * f, pz + dz * f
			cx[k], cy[k], cz[k] = nx, ny, nz
			cfs[k] = orient((px + nx) * 0.5, (py + ny) * 0.5, (pz + nz) * 0.5, px - nx, py - ny, pz - nz, 0, 0)
			px, py, pz = nx, ny, nz
		end
	end
end

-- lays every chain straight back from its anchor (at the start)
local function resetChains(headCF)
	local look = headCF.LookVector
	for c = 1, #CHAINS do
		local spec = CHAINS[c]
		local a = headCF * chain.Anchor[c]
		for j = 1, spec.Links do
			local k = chain.First[c] + j - 1
			chain.X[k] = a.X - look.X * spec.Length * j
			chain.Y[k] = a.Y - look.Y * spec.Length * j - 0.3 * j
			chain.Z[k] = a.Z - look.Z * spec.Length * j
		end
	end
end

-- sheds a puff from the tail tuft now and then; live puffs rise, swell and fade (dead ones stay invisible)
local function posePuffs(tailCF, dt)
	S.PuffTimer = S.PuffTimer - dt
	if S.PuffTimer <= 0 then
		S.PuffTimer = PUFF.Every
		local p = S.NextPuff
		S.NextPuff = S.NextPuff % PUFF.Pool + 1
		local src = tailCF * S.TuftV
		local rng = S.Rng
		puff.X[p] = src.X + rng:NextNumber(-1.5, 1.5)
		puff.Y[p] = src.Y + rng:NextNumber(-1, 1)
		puff.Z[p] = src.Z + rng:NextNumber(-1.5, 1.5)
		puff.Rot[p] = CFrame.Angles(0, rng:NextNumber(0, TAU), 0)
		puff.Scale[p] = rng:NextNumber(0.85, 1.2)
		puff.Age[p] = 0
	end
	for p = 1, PUFF.Pool do
		local age = puff.Age[p]
		if age >= 0 then
			age = age + dt
			if age >= PUFF.Life then
				puff.Age[p] = -1
				for k = puff.First[p], puff.Last[p] do
					parts[k].Transparency = 1
				end
			else
				puff.Age[p] = age
				local a = age / PUFF.Life
				local s = puff.Scale[p] * (0.7 + 0.7 * a)
				local alpha = min(age / 0.35, 1) * (1 - a) * (1 - a)
				local cf = CFrame.new(puff.X[p], puff.Y[p] + age * PUFF.Rise, puff.Z[p]) * puff.Rot[p]
				for k = puff.First[p], puff.Last[p] do
					local o = puff.Pos[k]
					cfs[k] = cf * CFrame.new(o.X * s, o.Y * s, o.Z * s)
					local part = parts[k]
					part.Size = puff.Size[k] * s
					part.Transparency = 1 - 0.85 * alpha
				end
			end
		end
	end
end

local function pose(t, dt)
	-- head: aimed along its own trail, with a slow look-around of its own
	local ax, ay, az = trailAt(BODY.HeadLook)
	local headCF = orient(hx, hy, hz, hx - ax, hy - ay, hz - az, htx, htz) * CFrame.Angles(0.07 * sin(t * 0.61), 0.13 * sin(t * 0.37), 0)
	writeGroup(S.HeadFirst, S.HeadLast, headCF)
	-- jaw: a calm breath, opening wider now and then
	local o = sin(t * 0.45)
	local open = 0.08 + 0.05 * sin(t * 1.3)
	if o > 0 then
		open = open + 0.22 * o * o * o
	end
	writeGroup(S.JawFirst, S.JawLast, headCF * S.JawHinge * CFrame.Angles(-open, 0, 0))
	-- body segments along the path history
	local nSeg = #SEGMENTS
	for i = 1, nSeg do
		local cf = frameAt(BODY.HeadGap + (i - 1) * BODY.Spacing)
		seg.CF[i] = cf
		writeGroup(seg.First[i], seg.Last[i], cf)
	end
	-- legs paddle around their shoulder / hip
	for l = 1, #LEGS do
		local spec = LEGS[l]
		local cf = seg.CF[spec.Seg] * leg.Base[l] * CFrame.Angles(LEG.RestPitch + LEG.Swing * sin(t * LEG.Freq + spec.Phase), 0, 0)
		writeGroup(leg.First[l], leg.Last[l], cf)
	end
	-- tail tip with a lazy flick
	local tailCF = frameAt(BODY.HeadGap + (nSeg - 1) * BODY.Spacing + BODY.TailGap) * CFrame.Angles(0.1 * sin(t * 1.1), 0.18 * sin(t * 0.8), 0)
	writeGroup(S.TailFirst, S.TailLast, tailCF)
	poseChains(headCF, t, dt)
	posePuffs(tailCF, dt)
	return headCF
end

local function step(dt)
	local model = S.Model
	if model == nil or model.Parent == nil then
		return -- removed by something else: nothing left to move
	end
	local camera = Workspace.CurrentCamera
	if camera then
		local p = camera.CFrame.Position
		local dx, dy, dz = p.X - ox, p.Y - oy, p.Z - oz
		S.Paused = dx * dx + dy * dy + dz * dz > FAR_SQ
		if S.Paused then
			return
		end
	end
	if type(dt) ~= "number" or dt ~= dt or dt < 0 then
		dt = 0
	elseif dt > MAX_DT then
		dt = MAX_DT
	end
	S.Clock = S.Clock + dt
	advanceHead(S.Clock)
	pose(S.Clock, dt)
	if S.UseBulk then
		Workspace:BulkMoveTo(parts, cfs, S.BulkMode)
	else
		for k = 1, nParts do
			parts[k].CFrame = cfs[k]
		end
	end
end

local function onRenderStep(dt)
	local ok, err = pcall(step, dt)
	if not ok then
		if S.Connection then
			S.Connection:Disconnect()
			S.Connection = nil
		end
		warn(TAG .. "stopped: " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
-- registers the parts of one piece; offsets are relative to `pivot` (nil = the identity the piece was built at)
local function addParts(list, pivot)
	local inv = nil
	if pivot then
		inv = pivot:Inverse()
	end
	local first = nParts + 1
	for _, part in ipairs(list) do
		nParts = nParts + 1
		parts[nParts] = part
		cfs[nParts] = part.CFrame
		if inv then
			offsets[nParts] = inv * part.CFrame
		else
			offsets[nParts] = part.CFrame
		end
	end
	return first, nParts
end

local function partsOf(model)
	local list = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			list[#list + 1] = d
		end
	end
	return list
end

-- head and jaw (the jaw's offsets are relative to its hinge)
local function buildHead(model)
	local head, headParts = piece(MESH_KEYS.Head, sculptHead, "Head", BUDGET.Head)
	head.Parent = model
	S.HeadFirst, S.HeadLast = addParts(headParts, nil)
	task.wait()
	S.JawHinge = CFrame.new(JAW_HINGE[1] * VS, JAW_HINGE[2] * VS, JAW_HINGE[3] * VS)
	local jaw, jawParts = piece(MESH_KEYS.Jaw, sculptJaw, "Jaw", BUDGET.Jaw)
	jaw.Parent = model
	S.JawFirst, S.JawLast = addParts(jawParts, S.JawHinge)
	task.wait()
end

-- body segments (one sculpt per radius / fin, cloned for the others), legs and the tail tip
local function buildBody(model)
	local templates = {}
	for i, spec in ipairs(SEGMENTS) do
		local key = tostring(spec.R) .. (spec.Fin and "F" or "")
		local segModel
		if templates[key] then
			segModel = templates[key]:Clone()
		else
			segModel = piece(segmentKey(spec), function()
				return sculptSegment(spec.R, spec.Fin)
			end, "Segment", BUDGET.Segment)
			templates[key] = segModel
			task.wait()
		end
		segModel.Name = string.format("Segment%02d", i)
		segModel.Parent = model
		seg.First[i], seg.Last[i] = addParts(partsOf(segModel), nil)
		seg.CF[i] = CFrame.new()
	end
	local legTemplate = piece(MESH_KEYS.Leg, sculptLeg, "Leg", BUDGET.Leg)
	for l, spec in ipairs(LEGS) do
		local legModel = (l == 1) and legTemplate or legTemplate:Clone()
		legModel.Name = "Leg" .. l
		legModel.Parent = model
		leg.First[l], leg.Last[l] = addParts(partsOf(legModel), nil)
		local r = (SEGMENTS[spec.Seg] and SEGMENTS[spec.Seg].R or 3) * VS
		leg.Base[l] = CFrame.new(spec.Side * r * 0.72, -r * 0.45, 0.4) * CFrame.Angles(0, 0, spec.Side * LEG.Splay)
	end
	task.wait()
	local tail, tailParts = piece(MESH_KEYS.Tail, sculptTail, "Tail", BUDGET.Tail)
	tail.Parent = model
	S.TailFirst, S.TailLast = addParts(tailParts, nil)
	S.TuftV = Vector3.new(PUFF.Point[1] * VS, PUFF.Point[2] * VS, PUFF.Point[3] * VS)
	task.wait()
end

-- block-chain whiskers and mane locks: single blocks, tapering towards the tip, every other one a shade lighter
local function buildChains(model)
	local holder = Instance.new("Model")
	holder.Name = "Chains"
	holder.Parent = model
	-- mesh dragon: one rounded bead MeshPart, cloned per link (resized + recoloured like the Part block)
	local bead = nil
	if meshLib then
		local _, beadParts = meshPiece(MESH_KEYS.Link, "Link")
		bead = beadParts[1]
		if not bead then
			error("mesh key " .. MESH_KEYS.Link .. " has no part", 0)
		end
	end
	for c, spec in ipairs(CHAINS) do
		chain.Anchor[c] = Vector3.new(spec.Anchor[1] * VS, spec.Anchor[2] * VS, spec.Anchor[3] * VS)
		local color = palette[spec.Key]
		if typeof(color) ~= "Color3" then
			color = palette.Mane
		end
		local list = {}
		for j = 1, spec.Links do
			local k = nParts + j
			chain.X[k], chain.Y[k], chain.Z[k] = 0, 0, 0
			local a = (spec.Links > 1) and (j - 1) / (spec.Links - 1) or 0
			local thick = (spec.Thick + (spec.ThickEnd - spec.Thick) * a) * VS
			local shade = color
			if j % 2 == 0 then
				shade = color:Lerp(Color3.new(1, 1, 1), 0.18)
			end
			if bead then
				local link = bead:Clone()
				link.Name = spec.Key
				link.Size = Vector3.new(thick, thick, (spec.Length + 0.25) * VS)
				link.Color = shade
				link.CFrame = CFrame.new()
				link.CastShadow = false
				link.Parent = holder
				list[j] = link
			else
				list[j] = Voxel.Box(holder, CFrame.new(), Vector3.new(thick, thick, (spec.Length + 0.25) * VS), shade, Enum.Material.SmoothPlastic, {
					Name = spec.Key,
					CastShadow = false,
				})
			end
		end
		chain.First[c] = addParts(list, nil)
	end
end

-- the cloud puff pool (invisible until shed)
local function buildPuffs(model)
	local holder = Instance.new("Model")
	holder.Name = "Puffs"
	holder.Parent = model
	local template = piece(MESH_KEYS.Puff, sculptPuff, "Puff", BUDGET.Puff)
	for p = 1, PUFF.Pool do
		local puffModel = (p == 1) and template or template:Clone()
		puffModel.Name = "Puff" .. p
		puffModel.Parent = holder
		local list = partsOf(puffModel)
		for _, part in ipairs(list) do
			part.Transparency = 1
		end
		puff.First[p], puff.Last[p] = addParts(list, nil)
		for k = puff.First[p], puff.Last[p] do
			puff.Pos[k] = parts[k].Position
			puff.Size[k] = parts[k].Size
		end
		puff.Age[p] = -1
		puff.X[p], puff.Y[p], puff.Z[p] = 0, 0, 0
		puff.Rot[p] = CFrame.new()
		puff.Scale[p] = 1
	end
	task.wait()
end

-- fills the path history so the whole body is already formed, then poses everything once
local function primeFlight()
	local back = (BODY.HeadGap + #SEGMENTS * BODY.Spacing + BODY.TailGap + 20) / max(S.Speed, 1)
	trailCount = 0
	local tt = -back
	while tt < 0 do
		advanceHead(tt)
		tt = tt + 1 / 30
	end
	S.Clock = 0
	advanceHead(0)
	local headCF = pose(0, 0)
	resetChains(headCF)
	poseChains(headCF, 0, 0)
	for k = 1, nParts do
		parts[k].CFrame = cfs[k]
	end
end

local function loadShared(name)
	local shared = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:WaitForChild("Shared", 10)
	if not shared then
		return nil
	end
	local inst = shared:FindFirstChild(name) or shared:WaitForChild(name, 10)
	if not inst then
		return nil
	end
	local ok, mod = pcall(require, inst)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

local function clientFxFolder()
	local folder = Workspace:FindFirstChild(FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = FOLDER_NAME
		folder.Parent = Workspace
	end
	return folder
end

local function build()
	local Config = loadShared("Config")
	Voxel = loadShared("Voxel")
	local kit = { "NewGrid", "Shape", "Shade", "Build", "Box", "Get", "Set" }
	for _, fn in ipairs(kit) do
		if Voxel and type(Voxel[fn]) ~= "function" then
			Voxel = nil
		end
	end
	if not Voxel then
		warn(TAG .. "shared/Voxel is missing: the Sage Dragon is not built")
		return false
	end
	local lobby = Config and Config.Lobby
	if type(lobby) == "table" and typeof(lobby.Origin) == "Vector3" then
		ox, oy, oz = lobby.Origin.X, lobby.Origin.Y, lobby.Origin.Z
	end
	palette = makePalette()
	meshLib = nil
	local ML = loadShared("MeshLibrary")
	if ML and type(ML.IsReady) == "function" and type(ML.Assemble) == "function" then
		S.MeshLib = ML
		local ok, ready = pcall(ML.IsReady, SkyDragonController.MeshKeys())
		if ok and ready == true and not S.NoMesh then
			meshLib = ML
		end
	end
	S.Rng = Random.new(7071)
	S.BulkMode = Enum.BulkMoveMode.FireCFrameChanged
	setupPath()

	local model = Instance.new("Model")
	model.Name = MODEL_NAME
	buildHead(model)
	buildBody(model)
	buildChains(model)
	buildPuffs(model)
	primeFlight()
	model.Parent = clientFxFolder()
	S.Model = model
	S.Mesh = meshLib ~= nil
	if S.Mesh then
		model:SetAttribute("ML_Mesh", true)
	end

	-- BulkMoveTo is the fast path; fall back to plain CFrame writes if it is unavailable
	S.UseBulk = pcall(Workspace.BulkMoveTo, Workspace, parts, cfs, S.BulkMode) and true or false
	return true
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- forgets every built part (a rebuild starts from scratch; the flight path is recomputed by build)
local function resetBuild()
	if S.Connection then
		S.Connection:Disconnect()
		S.Connection = nil
	end
	if S.Model then
		S.Model:Destroy()
		S.Model = nil
	end
	parts, cfs, offsets = {}, {}, {}
	nParts = 0
	seg = { First = {}, Last = {}, CF = {} }
	leg = { First = {}, Last = {}, Base = {} }
	chain = { First = {}, Anchor = {}, X = {}, Y = {}, Z = {} }
	puff = { First = {}, Last = {}, Age = {}, X = {}, Y = {}, Z = {}, Rot = {}, Scale = {}, Pos = {}, Size = {} }
	S.NextPuff, S.PuffTimer = 1, 0
end

-- builds the dragon (meshes when every key is ready here, else Parts) and starts the frame loop; a failed mesh
-- build falls back to the Part dragon
local function buildAndRun()
	local ok, result = pcall(build)
	if not ok and meshLib then
		warn(TAG .. "mesh dragon failed (" .. tostring(result) .. "); building the Part dragon")
		meshLib = nil
		resetBuild()
		S.NoMesh = true -- this one build is the Part dragon even though the keys are ready
		ok, result = pcall(build)
		S.NoMesh = false
	end
	if not ok then
		warn(TAG .. "could not build the Sage Dragon: " .. tostring(result))
		if S.Model then
			S.Model:Destroy()
			S.Model = nil
		end
		return false
	end
	if result then
		if S.Held then
			-- GraphicsQuality Low: a (re)build never brings the dragon back; SetHeld(false) does
			S.Model.Parent = nil
		else
			S.Connection = RunService.RenderStepped:Connect(onRenderStep)
		end
	end
	return result
end

-- a Part dragon rebuilds itself once from meshes when the last dragon key becomes ready on this device
local function watchMeshes()
	local ML = S.MeshLib
	if not ML or S.Mesh or S.MeshWatch or type(ML.Changed) ~= "table" then
		return
	end
	S.MeshWatch = ML.Changed:Connect(function()
		if S.Mesh or S.Rebuilding or not S.Model then
			return
		end
		local ok, ready = pcall(ML.IsReady, SkyDragonController.MeshKeys())
		if ok and ready == true then
			if S.MeshWatch then
				S.MeshWatch:Disconnect()
				S.MeshWatch = nil
			end
			S.Rebuilding = true
			task.spawn(function()
				resetBuild()
				buildAndRun()
				S.Rebuilding = false
			end)
		end
	end)
end

function SkyDragonController.Init()
	if S.Started then
		return
	end
	S.Started = true
	if not RunService:IsClient() then
		return
	end
	task.spawn(function()
		if buildAndRun() then
			watchMeshes()
		end
	end)
end

-- tests / tools: rebuild the dragon now (picks meshes or Parts again); yields while it builds. Returns true when
-- a dragon is flying afterwards.
function SkyDragonController._Rebuild()
	if not RunService:IsClient() or S.Rebuilding then
		return false
	end
	S.Rebuilding = true
	if S.MeshWatch then
		S.MeshWatch:Disconnect()
		S.MeshWatch = nil
	end
	resetBuild()
	local ok = buildAndRun()
	S.Rebuilding = false
	if ok then
		watchMeshes()
	end
	return ok and true or false
end

-- GraphicsQuality Low / High: held = the model leaves the world and the RenderStepped loop is disconnected (no
-- per-frame work at all); released = back in the client fx folder and flying. The flag outlives every rebuild (the
-- mesh rebuild, _Rebuild) so a dragon built while held is built held. Idempotent; never touches a destroyed model.
function SkyDragonController.SetHeld(on)
	on = on == true
	S.Held = on
	local model = S.Model
	if on then
		if S.Connection then
			S.Connection:Disconnect()
			S.Connection = nil
		end
		if model and model.Parent ~= nil then
			pcall(function()
				model.Parent = nil
			end)
		end
	elseif model and not S.Rebuilding then
		if model.Parent == nil and not pcall(function()
			model.Parent = clientFxFolder()
		end) then
			return S.Held -- destroyed by something else: nothing to fly
		end
		if not S.Connection then
			S.Connection = RunService.RenderStepped:Connect(onRenderStep)
		end
	end
	return S.Held
end

function SkyDragonController.IsHeld()
	return S.Held == true
end

-- tests: true while the RenderStepped frame loop is connected
function SkyDragonController._IsRunning()
	return S.Connection ~= nil
end

function SkyDragonController.IsMesh()
	return S.Mesh == true
end

function SkyDragonController.GetModel()
	return S.Model
end

function SkyDragonController.IsPaused()
	return S.Paused
end

return SkyDragonController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1166">
            <Properties>
              <string name="Name">StoreController</string>
              <string name="Source"><![CDATA[-- StoreController (client; lobby-shop Task 21, spec 16.3 "Who owns it"): a thin forwarder kept for old callers (the top
-- bar's PillButton_Shop, tests). The Robux Store moved into the one Shop window, client/Controllers/ShopController;
-- every call here goes there.
--
--   StoreController.Init()          nothing (ShopController boots on its own)
--   StoreController.Open(args) -> bool, Close(), IsOpen() -> bool, Cards(), Palette(key), RobuxGlyph(), Portrait()
--   StoreController.Layout() -> "PC" | "Phone"   (the Shop's Compact counts as PC, its Portrait as Phone: the Store's words)
--
-- Plain Lua 5.1-compatible syntax only.

local StoreController = {}

local function shop()
	return require(script.Parent:WaitForChild("ShopController"))
end

function StoreController.Init() end

function StoreController.Open(args)
	return shop().Open(args)
end

function StoreController.Close()
	return shop().Close()
end

function StoreController.IsOpen()
	return shop().IsOpen()
end

function StoreController.Cards()
	return shop().Cards()
end

function StoreController.Palette(key)
	return shop().Palette(key)
end

function StoreController.RobuxGlyph()
	return shop().RobuxGlyph()
end

function StoreController.Portrait()
	return shop().Portrait()
end

function StoreController.Layout()
	local layout = shop().Layout()
	if layout == "Compact" then
		return "PC"
	elseif layout == "Portrait" then
		return "Phone"
	end
	return layout
end

return StoreController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1167">
            <Properties>
              <string name="Name">TitleController</string>
              <string name="Source"><![CDATA[-- TitleController (client, lobby-shop Task 19; spec 16.6 "Client"): the rank and Creator titles above the head.
--
--   TitleController.Init()
--   TitleController.TagOf(player) -> BillboardGui | nil   that player's TitleTag (nil without a title or a head)
--   TitleController.SetCrown(player, on)                  VipController's crown rule for a titled player: the crown is
--                                                          drawn inside the TitleTag (a pixel gap, never a stud gap)
--
-- Per player: the Title / TitleRank attributes (only the server writes them: LeaderboardService), CharacterAdded and
-- InBattle. A BillboardGui "TitleTag" on the head (Adornee = Head, 240 x 40 px, 240 x 76 with the crown slot: the plate's
-- 36 plus its 2 px wood edge kept inside the clipping gui, MaxDistance 90, not on top, LightInfluence 0) > Plate (the
-- text's width, 2 px above the gui's bottom) > Label (22 px, 24 for Creator). Its height above Roblox's name is set in
-- pixels: StudsOffset (0, 2.0, 0) (about where Roblox anchors the name) and SizeOffset (0, 0.5 + (26 - 2) / H), so the
-- plate's bottom stays 26 px above that point at any distance (the tag, the crown and Roblox's name are all
-- constant-pixel billboards: a stud gap shrinks on screen with distance and lets them slide into each other).
-- (kit-b U9-3, finding 15) the tag is a kit B sign tag, one colour by role, no glow, gloss or animation: the Plate a flat
-- opaque face with its darker lip along the bottom and a 2 px wood edge, square (CloudUI.SignBlock); the Label FredokaOne
-- (Nameplate) in the ink that reads on that face, centred above the lip, no outline (the face is opaque). The rainbow, the
-- gradients and the navy glass plate went. (Pitch 2 F0) the plate wears the finish pass's lean variant (SignBlock Finish
-- "Lean": its lit top band only), so a tag stays within 6 instances.
--   Top10    "TOP 10 \194\183 #N": the gold block (CloudUI.SignLooks.Selected), brown letters.
--   Top100   "TOP 100": the stone block (Stone), brown letters.
--   Creator  "CREATOR", 24 px: (Pitch 2 item 04 B) a stone tag on a gold lip, brown letters, the pixel crown ("CrownMark",
--            18 px, the gold lip's colour) leading the word inside the tag.
--   The crown (SetCrown on): VipController.Crown (the gold pixel crown on its wood lip) as "Crown", 34 x 34 px, centred,
--   4 px above the Plate. Not over CREATOR (its tag carries its own crown: one crown, Pitch 2 item 04 B).
-- Hidden while that player is InBattle (the battle scene); for the local player also while the camera is within 2 studs
-- of the head (first person). One 4 Hz task does that check (local player only) and once a second rebuilds a titled
-- player's tag whose head changed (a respawn the CharacterAdded wait missed, a character streamed out and back). No
-- Heartbeat, no per-frame Lua, no tween. A tag and the connections go when the title clears, on a respawn (rebuilt on the
-- new head) or when the player leaves. Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Theme"))
local PixelIcon = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PixelIcon")) -- (Pitch 2 item 04) the CREATOR crown

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
-- (kit-b U9-3) the crown's look lives with the VIP pass (VipController.Crown); VipController requires this module only
-- lazily, from a call, so there is no loop at load
local VipController = require(script.Parent:WaitForChild("VipController"))

local TitleController = {}

local K = {
	NAME = "TitleTag",
	WIDTH = 240, -- the billboard (px)
	PLATE_H = 36,
	CROWN = 34, -- the crown slot (px)
	CROWN_GAP = 4, -- the crown's bottom to the plate's top (px)
	ABOVE = 26, -- the plate's bottom above the anchor (px; Roblox's name is about 20 px tall)
	STUDS = 2.0, -- the anchor above the head (about where Roblox draws the name; tuned in Studio, in studs only)
	MAX_DISTANCE = 90,
	PAD = 12, -- px each side of the text inside the plate
	TEXT = 22,
	CREATOR_TEXT = 24,
	EDGE = 2, -- (kit-b U9-3) the plate's wood edge (px)
	LIP = 4, -- ... and its darker lip along the bottom (px)
	-- (kit-b U9-3) each title's kit B look (CloudUI.SignLooks): the gold block, the stone block; (Pitch 2 item 04_world_ui,
	-- the owner's pick B "Stone tags"; it was the navy plank with gold letters, a glow pill before that) CREATOR is a stone
	-- tag on a gold lip in brown ink, led by the pixel crown (FACE: the colours over its look)
	LOOK = { Top10 = "Selected", Top100 = "Stone", Creator = "Stone" },
	FACE = { Creator = { Face = Theme.Sign.Stone, Lip = Theme.Sign.GoldLip, Text = Theme.Sign.Text } },
	CREATOR_CROWN = 18, -- the crown's px (a multiple of 9: whole-px cells)
	CREATOR_CROWN_PAD = 10, -- px from the face's left to the crown
	CREATOR_CROWN_GAP = 14, -- px from the crown to the word (look review r0: 8 read cramped; the mock's gap is ~16)
	TICK = 0.25, -- the 4 Hz check
	SWEEP = 4, -- ticks between two head sweeps (1 s)
	NEAR = 2, -- studs: the camera this close to the local head = first person
	TAGS = { Creator = "CREATOR", Top10 = "TOP 10", Top100 = "TOP 100" }, -- when Config has no RankTitles.Tag
}
TitleController.K = K

local S = {
	Tags = {}, -- [player] = { Gui, Plate, Label, Head, Key }
	Crown = {}, -- [player] = true while VipController wants the crown drawn in that player's tag
	Watch = {}, -- [player] = { connections }
	FirstPerson = false, -- the camera is at the local player's head
	Warned = {},
	Started = false,
}
TitleController._S = S

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not S.Warned[key] then
		S.Warned[key] = true
		warn("[TitleController] " .. key .. ": " .. tostring(err))
	end
	return ok
end

-- "Creator" | "Top10" | "Top100" | nil (anything else the attribute could hold draws nothing)
local function kindOf(player)
	local kind = player:GetAttribute(Config.Attr.Title or "Title")
	local rt = Config.Leaderboard and Config.Leaderboard.RankTitles
	local tags = (rt and rt.Tag) or K.TAGS
	if type(kind) == "string" and tags[kind] and K.LOOK[kind] then
		return kind
	end
	return nil
end

local function textOf(kind, player)
	local rt = Config.Leaderboard and Config.Leaderboard.RankTitles
	local text = tostring(((rt and rt.Tag) or K.TAGS)[kind])
	if kind == "Top10" then
		local rank = tonumber(player:GetAttribute(Config.Attr.TitleRank or "TitleRank"))
		if rank and rank >= 1 then
			text = text .. " \194\183 #" .. math.floor(rank)
		end
	end
	return text
end

local function headOf(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head
	end
	return nil
end

local function shown(player)
	if player:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil then
		return false
	end
	return not (player == Players.LocalPlayer and S.FirstPerson)
end

local function drop(player)
	local t = S.Tags[player]
	S.Tags[player] = nil
	if t then
		t.Gui:Destroy()
	end
end

-- (Pitch 2 item 04 B) the CREATOR tag leads with its pixel crown: CROWN_PAD, the icon, CROWN_GAP, then the word. The
-- label starts `lead` px into the plate and centres the word in the rest (PAD each side of it)
function TitleController.Lead(kind)
	return (kind == "Creator") and (K.CREATOR_CROWN_PAD + K.CREATOR_CROWN + K.CREATOR_CROWN_GAP - K.PAD) or 0
end

-- the plate's width for a `textW` px word: PAD each side, the crown's lead, at most the billboard less its edges
-- (the render scene's mirrored plate is re-fitted with this rule and the renderer's font metrics)
function TitleController.PlateWidth(kind, textW)
	return math.min(K.WIDTH - 2 * K.EDGE, (tonumber(textW) or 0) + 2 * K.PAD + TitleController.Lead(kind))
end

local function build(player, head, kind, text, crown)
	-- (U9-3 review) a BillboardGui clips its descendants and the wood edge is a Border stroke outside the plate: the gui
	-- keeps K.EDGE px under the plate (and above it without the crown; the crown slot's gap holds the edge otherwise)
	local top = crown and (K.CROWN + K.CROWN_GAP) or K.EDGE
	local H = top + K.PLATE_H + K.EDGE
	local gui = Instance.new("BillboardGui")
	gui.Name = K.NAME
	gui.Size = UDim2.fromOffset(K.WIDTH, H)
	gui.StudsOffset = Vector3.new(0, K.STUDS, 0)
	gui.SizeOffset = Vector2.new(0, 0.5 + (K.ABOVE - K.EDGE) / H) -- the plate's face, not the gui, 26 px up
	gui.MaxDistance = K.MAX_DISTANCE
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.Adornee = head

	local size = (kind == "Creator") and K.CREATOR_TEXT or K.TEXT
	local textW = math.ceil(Theme.Measure(text, "Nameplate", size, 4096).X)
	local lead = TitleController.Lead(kind)
	local plateW = TitleController.PlateWidth(kind, textW)
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.AnchorPoint = Vector2.new(0.5, 1)
	plate.Position = UDim2.new(0.5, 0, 1, -K.EDGE)
	plate.Size = UDim2.fromOffset(plateW, K.PLATE_H)
	plate.BorderSizePixel = 0
	-- (kit-b U9-3) the flat block: its face, the wood edge, the lip
	local look = CloudUI.SignLooks[K.LOOK[kind]]
	-- (Pitch 2 fix round B) the finish pass's lean variant: the lit top band only. The full finish (bevel strips, the card
	-- shadow) is 11 more instances on every titled head, over the tag's budget of 6 (Top10 15, crowned 46)
	local over = K.FACE[kind]
	CloudUI.SignBlock(plate, K.LOOK[kind], {
		EdgePx = K.EDGE, LipPx = K.LIP, Pad = false, Finish = "Lean",
		Face = over and over.Face or nil, Lip = over and over.Lip or nil, Text = over and over.Text or nil,
	})
	plate.Parent = gui

	local label = Theme.Label(text, "Nameplate", {
		Size = size,
		Color = (over and over.Text) or look.Text,
		Props = {
			Name = "Label",
			Position = UDim2.fromOffset(lead, 0),
			Size = UDim2.new(1, -lead, 1, -K.LIP), -- centred over the lip (right of the crown)
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	label.Parent = plate
	if kind == "Creator" then
		local icon = PixelIcon.New(plate, "crown", K.CREATOR_CROWN, Theme.Sign.GoldLip)
		if icon then
			icon.Name = "CrownMark"
			icon.Position = UDim2.fromOffset(K.CREATOR_CROWN_PAD, math.floor((K.PLATE_H - K.LIP - K.CREATOR_CROWN) / 2))
		end
	end

	if crown then
		local holder = VipController.Crown(gui, K.CROWN)
		holder.Name = "Crown"
		holder.AnchorPoint = Vector2.new(0.5, 0)
		holder.Position = UDim2.fromScale(0.5, 0)
	end

	gui.Enabled = shown(player)
	gui.Parent = head
	return { Gui = gui, Plate = plate, Label = label, Head = head }
end

-- builds, rebuilds (kind, text, crown or head changed), shows / hides or removes that player's tag; a no-op otherwise
local function refresh(player)
	if not player or not player.Parent then
		return
	end
	local kind = kindOf(player)
	local head = kind and headOf(player)
	if not head then
		drop(player)
		if not kind then
			S.Crown[player] = nil -- VipController sets it again when a title comes back
		end
		return
	end
	local text = textOf(kind, player)
	-- (Pitch 2 item 04 B, look review r0: two gold crowns stacked) the CREATOR tag carries its own pixel crown, so a VIP
	-- Creator gets no VIP crown slot over it (one crown, as in the mock)
	local crown = S.Crown[player] == true and kind ~= "Creator"
	local key = kind .. "|" .. text .. "|" .. tostring(crown)
	local t = S.Tags[player]
	if not (t and t.Key == key and t.Head == head and t.Gui.Parent ~= nil) then
		drop(player)
		t = build(player, head, kind, text, crown)
		t.Key = key
		S.Tags[player] = t
	end
	local want = shown(player)
	if t.Gui.Enabled ~= want then
		t.Gui.Enabled = want
	end
end

-- the camera within K.NEAR studs of the local player's head (first person)
local function firstPerson()
	local camera = workspace.CurrentCamera
	local t = S.Tags[Players.LocalPlayer]
	local head = t and t.Head
	if not (camera and head and head.Parent) then
		return false
	end
	return (camera.CFrame.Position - head.Position).Magnitude < K.NEAR
end

local function unwatch(player)
	local conns = S.Watch[player]
	S.Watch[player] = nil
	for _, c in ipairs(conns or {}) do
		c:Disconnect()
	end
	drop(player)
	S.Crown[player] = nil
end

local function watch(player)
	if S.Watch[player] then
		return
	end
	local conns = {}
	S.Watch[player] = conns
	local attr = Config.Attr
	for _, name in ipairs({ attr.Title or "Title", attr.TitleRank or "TitleRank", attr.InBattle or "InBattle" }) do
		conns[#conns + 1] = player:GetAttributeChangedSignal(name):Connect(function()
			safe("refresh", refresh, player)
		end)
	end
	conns[#conns + 1] = player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 5)
		safe("refresh", refresh, player)
	end)
	safe("refresh", refresh, player)
end

local function tick(sweep)
	local fp = firstPerson()
	if fp ~= S.FirstPerson then
		S.FirstPerson = fp
		refresh(Players.LocalPlayer)
	end
	if sweep then
		for player in pairs(S.Watch) do
			if not player.Parent then
				unwatch(player)
			elseif kindOf(player) then
				local t = S.Tags[player]
				if not t or t.Gui.Parent == nil or t.Head ~= headOf(player) then
					refresh(player)
				end
			end
		end
	end
end

function TitleController.TagOf(player)
	local t = S.Tags[player]
	if t and t.Gui.Parent ~= nil then
		return t.Gui
	end
	return nil
end

function TitleController.SetCrown(player, on)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return
	end
	on = on == true
	if (S.Crown[player] == true) == on then
		return
	end
	S.Crown[player] = on or nil
	safe("refresh", refresh, player)
end

function TitleController.Init()
	if S.Started then
		return
	end
	S.Started = true
	for _, player in ipairs(Players:GetPlayers()) do
		safe("watch", watch, player)
	end
	Players.PlayerAdded:Connect(function(player)
		safe("watch", watch, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		safe("unwatch", unwatch, player)
	end)
	task.spawn(function()
		local n = 0
		while true do
			task.wait(K.TICK)
			n = n + 1
			safe("tick", tick, n % K.SWEEP == 0)
		end
	end)
end

return TitleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1168">
            <Properties>
              <string name="Name">TokenFx</string>
              <string name="Source"><![CDATA[-- TokenFx: spins and bobs the cloud coins on this client only. The server leaves the coins still when
-- Config.Tokens.ClientAnimated is true (TokenService), so nothing here replicates and it costs the
-- network nothing. The motion matches TokenService's old server-side driver.
-- v3: the coin is a voxel coin (TokenService): its root block is posed here and every other block is welded
-- to it, so the whole coin spins; the soft "Halo" sphere is an anchored, unwelded child of the root that this
-- controller bobs along with the coin (it never needs to spin).
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local TokenFx = {}

local NORMAL = { spin = 2.0, bob = 0.45 } -- radians per second / studs
local GOLDEN = { spin = 2.6, bob = 0.6 }
local BOB_SPEED = 2.2 -- radians per second of the up/down sine
local CULL_DISTANCE = 140 -- only coins this close to the camera are posed (other matches are far away)
local CULL_DISTANCE_SQ = CULL_DISTANCE * CULL_DISTANCE

local HALO_RETRY = 0.5 -- seconds between looks for a halo that has not replicated yet

-- coin part -> { base, phase, spin, bob, halo = BasePart|nil, haloOffset = Vector3, nextHaloLook = number }
local coins = {}
local started = false

local function add(part)
	if coins[part] or not part:IsA("BasePart") then
		return
	end
	local look = NORMAL
	if CollectionService:HasTag(part, Config.Tags.GoldenToken) then
		look = GOLDEN
	end
	-- the server built the coin at its base position with a random yaw: reuse that yaw as the phase
	local _, yaw = part.CFrame:ToEulerAnglesYXZ()
	coins[part] = { base = part.Position, phase = yaw, spin = look.spin, bob = look.bob, nextHaloLook = 0 }
end

-- The glowing "Halo" ball is an anchored child of the coin (TokenService builds it unwelded so it never has to
-- spin). It must still bob with the coin, so remember where it sits relative to the coin's base position.
-- Children can replicate after the tag does, so look again a few times a second until it shows up.
local function findHalo(part, coin, now)
	if now < coin.nextHaloLook then
		return
	end
	coin.nextHaloLook = now + HALO_RETRY
	local halo = part:FindFirstChild("Halo")
	if halo and halo:IsA("BasePart") then
		coin.halo = halo
		coin.haloOffset = halo.Position - coin.base
	end
end

local function step()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local eye = camera.CFrame.Position
	local now = os.clock()
	for part, coin in pairs(coins) do
		if part.Parent == nil or part:GetAttribute("Collected") then
			coins[part] = nil -- gone, or being collected: the server's pickup animation takes over
		else
			local d = coin.base - eye
			if d:Dot(d) <= CULL_DISTANCE_SQ then
				local lift = math.sin(now * BOB_SPEED + coin.phase) * coin.bob
				part.CFrame = CFrame.new(coin.base.X, coin.base.Y + lift, coin.base.Z) * CFrame.Angles(0, now * coin.spin + coin.phase, 0)
				local halo = coin.halo
				if halo == nil or halo.Parent ~= part then
					coin.halo = nil
					findHalo(part, coin, now)
					halo = coin.halo
				end
				if halo then
					local o = coin.haloOffset
					halo.CFrame = CFrame.new(coin.base.X + o.X, coin.base.Y + o.Y + lift, coin.base.Z + o.Z)
				end
			end
		end
	end
end

function TokenFx.Init()
	if started or Config.Tokens.ClientAnimated ~= true then
		return
	end
	started = true
	local tag = Config.Tags.CloudToken
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(part)
		coins[part] = nil
	end)
	for _, part in ipairs(CollectionService:GetTagged(tag)) do
		add(part)
	end
	RunService.RenderStepped:Connect(step)
end

return TokenFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1169">
            <Properties>
              <string name="Name">TopBarController</string>
              <string name="Source"><![CDATA[-- TopBarController (client, HUD cleanup): the top-left pill in Roblox's top bar (the owner's pick "B" on the HUD
-- cleanup pitch) with Shop, Travel and Settings.
--
--   TopBarController.Init()
--   TopBarController.GetRect() -> { X0, X1, Y0, Y1 } | nil   the pill (screen px; nil while hidden)
--   TopBarController.TravelAllowed() -> boolean             the Travel button shows (not in a match or a battle)
--   TopBarController.Refresh()                              relayout now (tests; a changed top-bar inset)
--
-- Screen: ScreenGui "NimbusTopBar" (display order 21, IgnoreGuiInset = true, so its px are screen px).
--   * Frame "Pill": (kit-b U8: the pitch's HUD stage, "the top bar is a navy sign plank") one square navy sign plank with a
--     gold-lip edge, its darker lip along the bottom and the labels and icons in sign gold, inside Roblox's top-bar band (y 0 .. GuiService:GetGuiInset().Y), right of
--     Roblox's own buttons: GuiService.TopbarInset.Min.X + 8 (read under pcall; K.FALLBACK_LEFT 212 while it is not
--     available) and left of TopbarInset.Max.X (else K.RIGHT_RESERVE px off the right edge: the "..." button).
--     TextButtons PillButton_Shop (lobby shop 16.3, Task 23: ShopController.Open() with no tab, the one Shop window on
--     the last tab of this session, the first time Eggs; a second tap closes the open Shop; in a match the side hint "The
--     Store is closed during a match."; the StoreController forwarder or MenuController.Open("Shop") when a build lacks
--     ShopController), PillButton_Travel and PillButton_Settings
--     (MenuController.OpenSettings: MainMenuController's settings panel). Icon + label; icons only on phones (the
--     smaller screen side <= K.SMALL_PHONE) or when the labels do not fit; squeezed to K.MIN_BTN_W when even that
--     does not fit (a tooltip names an icon-only button).
--   * The ScreenGui carries the attributes PillRight / PillBottom (screen px of the pill's right / bottom edge, 0
--     while the gui is disabled): HudController starts a phone battle's TopBand currency row right of PillRight.
--   * A tap on Travel fires Remotes.QuickTravel("Plaza"): the server opens the same portal as Go home, leading to the lobby
--     spawn (GateService.Travel; every refusal, its toast and the cooldown are the server's). No menu: one destination.
--   * Travel shows everywhere Go home works, also at home and on the Arena and Altar islands (getting back to the lobby
--     from there is the point): hidden only in a match (InMatch) and in a battle / dungeon run / the Ring (InBattle),
--     followed through those attributes.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))

local TopBarController = {}

-- screen px (the top bar is not scaled by the screen factor: it is Roblox's own band)
local K = {
	PILL_H = 40, -- the pill's height in the 58 px band ...
	PILL_MIN_H = 32, -- ... never below this (a thumb)
	-- (Pitch 2 F0 A, look review of finish pass A, major 7: the pills were 36 px tall on phones) on a touch screen the pill
	-- is this tall, so its buttons (the pill less 4) are a 44 px thumb target, still inside Roblox's 58 px band
	PILL_TOUCH_H = 48,
	BTN_W = 44, -- one button's icon area
	LABEL_W = 70, -- a label's width when it cannot be measured
	LABEL_TEXT = 17,
	ICON = 22,
	PAD = 4, -- inside the pill, around the buttons
	BTN_GAP = 2,
	MIN_BTN_W = 30, -- icon-only buttons are squeezed this far at most
	EDGE_PAD = 8, -- right of TopbarInset.Min.X
	FALLBACK_LEFT = 212, -- the first free x on a PC when TopbarInset is not available
	BAND_INSET = 58, -- the top bar's height when the gui inset reads 0
	RIGHT_RESERVE = 72, -- Roblox's right-side buttons when TopbarInset is not available
	SMALL_PHONE = 500, -- icons only when the smaller screen side is at most this
	TRAVEL_GAP = 0.4, -- seconds between two QuickTravel sends (the portal's cooldown is 3 s)
}
TopBarController.K = K

local BUTTONS = {
	{ Id = "Shop", Label = "Shop", Icon = "Shop" },
	{ Id = "Travel", Label = "Travel", Icon = "Travel" },
	{ Id = "Settings", Label = "Settings", Icon = "Settings" },
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.PanelBottom or Color3.fromRGB(12, 15, 38)
local SIGN = Theme.Sign -- (kit-b U8) the navy sign plank

local LocalPlayer = nil
local initialized = false
local gui = nil
local U = { Buttons = {}, Pill = nil }
local S = {
	TravelShown = true,
	LastSend = 0,
	Layout = nil, -- { X, Y, W, H, Labels }
}
local warned = {}

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[TopBarController] " .. key .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function menu()
	local inst = script.Parent:FindFirstChild("MenuController")
	local ok, mod = pcall(function()
		return inst and require(inst)
	end)
	return ok and type(mod) == "table" and mod or nil
end

----------------------------------------------------------------------
-- Geometry (screen px)
----------------------------------------------------------------------
local function viewport()
	local cam = workspace.CurrentCamera
	local size = cam and cam.ViewportSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	return Vector2.new(1920, 1080)
end

local function topbarInset()
	local ok, rect = pcall(function()
		return GuiService.TopbarInset
	end)
	if ok and typeof(rect) == "Rect" and rect.Min.X > 0 and rect.Max.X > rect.Min.X then
		return rect
	end
	return nil
end

local function leftEdge()
	local rect = topbarInset()
	if rect then
		return rect.Min.X + K.EDGE_PAD
	end
	return K.FALLBACK_LEFT
end

local function rightLimit(vp)
	local rect = topbarInset()
	if rect then
		return rect.Max.X
	end
	return vp.X - K.RIGHT_RESERVE
end

local function inset()
	local y = 0
	pcall(function()
		y = GuiService:GetGuiInset().Y
	end)
	if not y or y <= 0 then
		return K.BAND_INSET
	end
	return y
end

local function labelWidth(text)
	local ok, bounds = pcall(function()
		return Theme.Measure(text, Theme.Fonts.Button, K.LABEL_TEXT, 1000)
	end)
	if ok and typeof(bounds) == "Vector2" and bounds.X > 0 then
		return math.ceil(bounds.X) + 10
	end
	return K.LABEL_W
end

----------------------------------------------------------------------
-- Travel: everywhere but a match or a battle
----------------------------------------------------------------------
function TopBarController.TravelAllowed()
	if not LocalPlayer then
		return false
	end
	if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		return false
	end
	if LocalPlayer:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil then
		return false
	end
	return true
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
local function writeAttributes()
	if not gui then
		return
	end
	local lay = S.Layout
	local on = gui.Enabled and lay ~= nil
	local right = on and (lay.X + lay.W) or 0
	local bottom = on and (lay.Y + lay.H) or 0
	if gui:GetAttribute("PillRight") ~= right then
		gui:SetAttribute("PillRight", right)
	end
	if gui:GetAttribute("PillBottom") ~= bottom then
		gui:SetAttribute("PillBottom", bottom)
	end
end

local function relayout()
	if not (gui and U.Pill) then
		return
	end
	local vp = viewport()
	local band = inset()
	local touch = UserInputService.TouchEnabled == true
	local h = math.floor(Util.Clamp(band - (touch and 6 or 10), K.PILL_MIN_H, touch and K.PILL_TOUCH_H or K.PILL_H))
	local y = math.max(0, math.floor((band - h) / 2))
	local left = leftEdge()
	local right = rightLimit(vp)
	local shown = {}
	for _, spec in ipairs(BUTTONS) do
		if spec.Id ~= "Travel" or S.TravelShown then
			shown[#shown + 1] = spec
		end
	end
	local n = #shown
	local function total(widths)
		local sum = 2 * K.PAD + (n - 1) * K.BTN_GAP
		for _, w in ipairs(widths) do
			sum = sum + w
		end
		return sum
	end
	local labels = math.min(vp.X, vp.Y) > K.SMALL_PHONE
	local widths = {}
	if labels then
		for i, spec in ipairs(shown) do
			widths[i] = K.BTN_W + labelWidth(spec.Label) - 8
		end
		if left + total(widths) > right then
			labels = false
		end
	end
	if not labels then
		local w = K.BTN_W
		if left + 2 * K.PAD + n * w + (n - 1) * K.BTN_GAP > right then
			w = math.max(K.MIN_BTN_W, math.floor((right - left - 2 * K.PAD - (n - 1) * K.BTN_GAP) / n))
		end
		for i = 1, n do
			widths[i] = w
		end
	end
	local x = K.PAD
	for _, spec in ipairs(BUTTONS) do
		local b = U.Buttons[spec.Id]
		if b then
			b.Root.Visible = spec.Id ~= "Travel" or S.TravelShown
		end
	end
	for i, spec in ipairs(shown) do
		local b = U.Buttons[spec.Id]
		local w = widths[i]
		b.Root.Position = UDim2.fromOffset(x, 2)
		b.Root.Size = UDim2.fromOffset(w, h - 4)
		b.Label.Visible = labels
		if labels then
			b.Icon.Position = UDim2.fromOffset(K.BTN_W / 2, (h - 4) / 2)
			b.Label.Position = UDim2.fromOffset(K.BTN_W - 6, 0)
			b.Label.Size = UDim2.new(1, -(K.BTN_W - 6), 1, 0)
		else
			b.Icon.Position = UDim2.fromOffset(w / 2, (h - 4) / 2)
		end
		x = x + w + K.BTN_GAP
	end
	local width = total(widths)
	U.Pill.Position = UDim2.fromOffset(left, y)
	U.Pill.Size = UDim2.fromOffset(width, h)
	S.Layout = { X = left, Y = y, W = width, H = h, Labels = labels }
	writeAttributes()
end

-- the Travel button follows TravelAllowed
local function applyTravel()
	local allowed = TopBarController.TravelAllowed()
	if allowed ~= S.TravelShown then
		S.TravelShown = allowed
		relayout()
	end
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
-- the one Shop window (lobby shop 16.3: ShopController; the StoreController forwarder in a build without it). Required
-- on use: both are optional and boot after this controller.
local function store()
	for _, name in ipairs({ "ShopController", "StoreController" }) do
		local inst = script.Parent:FindFirstChild(name)
		local ok, mod = pcall(function()
			return inst and require(inst)
		end)
		if ok and type(mod) == "table" and type(mod.Open) == "function" then
			return mod
		end
	end
	return nil
end

-- no tab: the Shop opens on the last tab of this session (the first time Eggs); a second tap closes it
local function onShop()
	local mc = menu()
	if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		if mc and type(mc.Hint) == "function" then
			mc.Hint("The Store is closed during a match.", "info")
		end
		return
	end
	local sc = store()
	if not sc then
		if mc then
			mc.Open("Shop") -- (a build without either: MenuController's own path)
		end
		return
	end
	if type(sc.IsOpen) == "function" and sc.IsOpen() then
		sc.Close()
		return
	end
	sc.Open()
end

local function onSettings()
	local mc = menu()
	if mc and type(mc.OpenSettings) == "function" then
		mc.OpenSettings()
	end
end

-- one destination: the tap asks the server for the portal
local function onTravel()
	if not S.TravelShown or os.clock() - S.LastSend < K.TRAVEL_GAP then
		return
	end
	S.LastSend = os.clock()
	local ok, remote = pcall(Remotes.Get, "QuickTravel")
	if ok and remote then
		remote:FireServer("Plaza")
	end
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
local function buildButton(parent, spec, order, callback)
	local root = Util.Create("TextButton", {
		Name = "PillButton_" .. spec.Id,
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = order,
		ZIndex = 3,
		Parent = parent,
	})
	local icon = NeonKit.Icon(root, spec.Icon, K.ICON)
	icon.ZIndex = 4
	icon.TextColor3 = SIGN.Gold
	-- (Pitch 2 item 9 B; P2 icons review r1, major 7: the gear read as a grey smudge on the navy plank) each icon in its
	-- own colours inside a 1-cell cream keyline (the mock-up's top bar), drawn again with it
	local pixelName = icon:GetAttribute("PixelIcon")
	if pixelName then
		icon:SetAttribute("IconKey", SIGN.Tile)
		PixelIcon.Host(icon, pixelName)
	end
	local label = Theme.Label(spec.Label, "Button", {
		Size = K.LABEL_TEXT,
		Color = SIGN.Gold,
		Props = {
			Name = "Label",
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 4,
		},
	})
	label.Parent = root
	local fx = nil
	fx = NeonKit.AttachFx(root, function(hover, press)
		-- (kit-b U8) hover lifts the plank's face a little lighter under the button; no scale
		root.BackgroundColor3 = SIGN.NavyLip
		root.BackgroundTransparency = (hover or press) and 0.55 or 1
	end, 1, 1)
	root.Activated:Connect(function()
		safe("pill " .. spec.Id, callback)
	end)
	CloudUI.Tooltip(root, function()
		return (S.Layout and S.Layout.Labels) and nil or spec.Label
	end)
	return { Root = root, Icon = icon, Label = label, Fx = fx }
end

local function build()
	local pill = Util.Create("Frame", {
		Name = "Pill",
		BackgroundColor3 = SIGN.Navy,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		ZIndex = 2,
		Parent = gui,
	})
	Util.Create("UIStroke", {
		Name = "SignEdge",
		Color = SIGN.GoldLip,
		Thickness = 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = pill,
	})
	Util.Create("Frame", {
		Name = "Lip",
		BackgroundColor3 = SIGN.NavyLip,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3),
		ZIndex = 2,
		Parent = pill,
	})
	U.Pill = pill
	local actions = { Shop = onShop, Travel = onTravel, Settings = onSettings }
	for i, spec in ipairs(BUTTONS) do
		U.Buttons[spec.Id] = buildButton(pill, spec, i, actions[spec.Id])
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function TopBarController.GetRect()
	if not (gui and gui.Enabled and U.Pill and U.Pill.Visible) then
		return nil
	end
	local p, s = U.Pill.AbsolutePosition, U.Pill.AbsoluteSize
	return { X0 = p.X, X1 = p.X + s.X, Y0 = p.Y, Y1 = p.Y + s.Y }
end

function TopBarController.Refresh()
	if not initialized then
		return
	end
	S.TravelShown = TopBarController.TravelAllowed()
	relayout()
end

function TopBarController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	gui = CloudUI.NewScreenGui("NimbusTopBar", 21)
	gui.IgnoreGuiInset = true
	build()
	S.TravelShown = TopBarController.TravelAllowed()
	relayout()

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", relayout)
	end)
	gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		safe("enabled", writeAttributes)
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
			safe("inset", relayout)
		end)
	end)
	for _, attr in ipairs({ Config.Attr.InMatch, Config.Attr.InBattle or "InBattle" }) do
		LocalPlayer:GetAttributeChangedSignal(attr):Connect(function()
			safe("travel", applyTravel)
		end)
	end
end

return TopBarController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1170">
            <Properties>
              <string name="Name">TrainController</string>
              <string name="Source"><![CDATA[-- TrainController (client, gui-redo Task 7): the Training Place window (docs/superpowers/specs/2026-11-06-window-redo-design.md
-- 5.1 and 5.5; plan docs/superpowers/plans/2026-11-06-window-redo.md Task 7). It took the Train page out of CareController,
-- which keeps Feed, Garden and Evolve and forwards Open("Train", args) here.
--
--   TrainController.Init()
--   TrainController.Open(args) -> boolean   args = { Key?, ReturnTo? }. Key: that pet; without one the first pet in training
--       (soonest done); none training (a Training Place and a pet exist): the pet picker sheet opens by itself. ReturnTo:
--       the Pets window's own Open args; closing this window (X, Esc, B) goes back to it unless DropReturn ran.
--   TrainController.Close()        closes the confirm, our sheet and the window
--   TrainController.IsOpen()       -> true while the window or its confirm is up
--   TrainController.Key()          -> the selected pet key or nil (the empty state)
--   TrainController.Select(key)    selects an owned pet
--   TrainController.Step(dir)      -1 = the previous, 1 = the next pet in the picker's default Train order (wraps; from no pet:
--                                  1 = the first, -1 = the last); never opens the sheet
--   TrainController.DropReturn()   another window, a match or a battle took over: closing does not go back to the Pets window
--   TrainController.Layout()       -> "PC" | "Phone" | "Portrait"
--   TrainController.SkillState(stat) -> "Ready" | "Training" | "Busy" | "Full" | "Short" | "Max" | "Match" | "NoPet" | "NoPlace"
--   TrainController.Mats(home, growthMap, selectedKey) -> { [1..5] = { State = "Job" | "Pending" | "Add" | "InUse" |
--       "Locked", Key = key | nil, Job = job | nil, Unlock = level | nil, LockBadge = boolean } }   (Task 8; pure: reads
--       only its arguments and the catalogs). Five mats always; TycoonCatalog.TrainingSlots(home) of them are open. Mat i
--       shows the job whose Job.Slot == i (two on one slot: the sooner done keeps it); a job with no Slot, or the second on
--       a taken slot, goes on the next free open mat (wrapping round), else the next free mat of all five; a job on a mat
--       above the open count keeps that mat with LockBadge = true (a Prestige closed it; running jobs survive). The free
--       spots are slots - jobs (the server's own count, every job): only that many open mats with no job are free, the
--       first holding the selected pet ("Pending") when it is not training, the others "Add"; the remaining open mats
--       with no job are "InUse" (a job on a closed mat holds their spot: the row never offers more room than the chip);
--       the rest "Locked" with Unlock = the Training Place level that opens them. Display only: the server picks the mat.
--
-- The mats row (Task 8, spec 5.5 "The mats row"): Mats > Mat1..Mat5 (TextButtons; attributes State, Key, LockBadge,
-- Selected). Job: the pet's face, its name, PC "Physique . Rank 5", a purple timer bar with "3:10 left"; tap = select that
-- pet. Pending: gold glow, the face, "Pick a skill below" (phone "Pick a skill"); tap = the sheet. Add: dashed, "+ Add a
-- pet"; tap = the sheet. InUse: an hourglass, "Spot in use" (phone "In use"); tap = the HintLine says a pet on a closed
-- spot holds it. Locked: a lock, "Training Place Lv i" (phone "Lv i"); tap = the HintLine says which level opens
-- it, and the house that allows that level when today's house caps the station (the Home window's "Needs the ..." rule).
-- With no Training Place the five mats are locked and the skills' place says how to build it.
--
-- One window at a time, through CareController (so no other controller changes): on open this closes the menu windows (the
-- Pets window, the Store, the Index with them), the Pet Index, the Fusion Machine, the Gifts window and Care's own Feed /
-- Garden window (CareController.CloseOwn), and tells CareController (NotifyTrain) so Care.Opened fires "Train" and
-- Care.Closed fires on close; CareController.Close() / its DropReturn close this one too. It never fires
-- MenuController.WindowOpened.
-- Instances: ScreenGui NimbusTrain (23, IgnoreGuiInset) > Window_Train (UIScale Fit) > Panel > Header (Icon, Title,
-- SpotsChip, CloseButton) and Body (Mats [Mat1..Mat5], PetCard [PickPrompt], PetName, PetLevel, PrevButton,
-- ChangeButton, NextButton, RestNote, Skills > Skill_<Id> [attribute State; Name, Rank, Bar, Now, Next, Cost, Time, Action,
-- MaxTag], Empty, HintLine); ConfirmShade + Confirm (Title, Text, Yes, No): siblings of Window_Train above it.
-- Sends PetCare("Train", key, stat) / PetCare("TrainStop", key), each asked first, at most every 0.3 s; the server checks
-- everything again (it picks the mat, the price and the time). Every number shown comes from the catalogs and the synced
-- profile. The layout is computed in the design box of NeonKit.BigRect (PC: the 1080p mock as its largest form; Phone: 820 x
-- 330 screen px; Portrait: one column). Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the skill, lock and wait icons
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-5) the awning over the window
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local PetPicker = require(UI:WaitForChild("PetPicker"))
local Bits = require(UI:WaitForChild("PetBits"))
local State = require(Client:WaitForChild("State"))

local function optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	return (ok and type(mod) == "table") and mod or nil
end

local BattleCatalog = optionalShared("BattleCatalog")
local TycoonCatalog = optionalShared("TycoonCatalog")

local TrainController = {}

----------------------------------------------------------------------
-- Tunables (design px; PC = the 1080p mock, Phone = screen px)
----------------------------------------------------------------------
