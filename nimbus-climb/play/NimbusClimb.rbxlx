		for i, form in ipairs(forms) do
			local okM, mM = pcall(Theme.Measure, form, "Heading", px(20))
			local need = (okM and typeof(mM) == "Vector2" and mM.X > 0) and (mM.X * 1.04 + 4) or textWidth(form, px(20))
			if need <= without or i == #forms then
