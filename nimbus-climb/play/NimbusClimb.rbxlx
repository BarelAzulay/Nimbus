-- Overall shape of a course, and the stage themes a course is assembled from.
-- (Semantics in ARCHITECTURE_V2.md. CourseBuilder owns the geometry.)
Config.Archetypes = { "Straight", "Zigzag", "Serpent", "Spiral" }
Config.StageThemes = {
	"Stones", -- plain steps of varied size/shape
	"Beams", -- narrow beams to balance on
	"Bounce", -- bounce pads launching to higher steps
	"Moving", -- clouds sliding back and forth
	"Spin", -- spinning-bar platforms
	"Storm", -- dark rain clouds that drizzle damage
	"Lightning", -- warned lightning strike zones
	"Vanish", -- steps that fade after you land
	"Cannon", -- cloud cannons that fling you to the next island
	"Wind", -- periodic wind gusts pushing sideways
	"Pendulum", -- swinging beams over narrow steps
	"Plates", -- co-op pressure-plate bridges
	"DashGap", -- gaps that need a dash
	"Gauntlet", -- short mixed hazard run
}
Config.Course = {
	MaxRadius = 170, -- no step further than this (horizontal) from the start platform centre
	-- Min free headroom above any walkable top surface (no overhanging steps). A full jump needs
	-- JumpHeight (~6.9, Config.Physics) + the character's height (~5.2) = ~12.1 studs of free air, so the
	-- generator keeps the underside of anything overhanging at least Clearance + 0.3 above the top. Do not
	-- lower this below ~12: an overhanging step would make a full jump bonk its head on it.
	Clearance = 13,
	-- kit-b O1 (slop-audit round 3, finding 1): the far puffs and the cloud sea wear Blender voxel cumulus, one invisible
	-- NC_Detail anchor each (CourseBuilder LM.Puff). Far / Sea list the obby's own variants: the ones with an id take
	-- turns (layout seed + puff order, so neighbours differ). While none has an id the lobby's sky cumulus stand in:
	-- Small for a far puff under SmallBelow studs of radius, Big above it and for the sea (at SeaScale). A puff whose key
	-- has no id keeps today's Part build (empty MeshIds = today's game).
	-- Fit[key]: Width = X size at scale 1 (the far scale is clamp(2r / Width, Min, Max), so the voxels stay near the
	-- lobby's), Lift / Top = pivot to the lowest / highest voxel, Reach = the farthest X / Z voxel from the pivot (the
	-- step clearance). A key without a Fit reads them from its manifest Bounds (Min 0.45, Max 1).
	Clouds = {
		Far = { "cloud_obby_far_1", "cloud_obby_far_2", "cloud_obby_far_3", "cloud_obby_far_4" },
		Sea = { "cloud_obby_sea_1", "cloud_obby_sea_2" },
		Small = "cloud_sky_small",
		Big = "cloud_sky_big",
		SmallBelow = 24,
		SeaScale = 1,
		Fit = {
			cloud_sky_small = { Width = 68, Lift = 10, Top = 22, Reach = 37, Min = 0.6, Max = 1.0 },
			cloud_sky_big = { Width = 117, Lift = 15, Top = 36, Reach = 61.5, Min = 0.45, Max = 1.0 },
		},
		-- kit-b O2 (finding 2): the voxel puff each platform's slab sits in (CourseBuilder Mesh.under). The obby's own
		-- puffs come first (UnderKeys, UnderPad below); the lobby's bridge puff Under stands in where they have no id or
		-- would reach another solid. UnderFit: scale = clamp(short side / Short, Min, Max) (then 1, then Min while the puff
		-- would reach another step's slab or the Clearance above it); Lo / Hi = the key's manifest Bounds at scale 1, so the
		-- top voxel (Hi[2] above the pivot) meets the slab's underside. No id, or no scale clears: the Part build stays.
		Under = "cloud_puff_s",
		UnderFit = { Short = 14, Min = 0.6, Max = 1.4, Lo = { -10.5, -10, -6.5 }, Hi = { 10.5, 3, 7.5 } },
		-- kit-b clouds wave (B1 ids): the obby's own platform puffs. Pivot = the Seat = the slab's underside centre, X along
		-- the long side; Slab = the footprint { long, short } its rim hugs at scale 1. A pad (Start / Checkpoint / Finish)
		-- wears UnderPad, any other platform the UnderKeys key whose fit max(long / Slab[1], short / Slab[2]) is nearest 1;
		-- scale = the fit clamped to UnderFit Min / Max, then 1, then Min while it would reach another solid. Lo / Hi come
		-- from the manifest Bounds.
		UnderKeys = {
			{ Key = "cloud_obby_under_s", Slab = { 12.5, 10 } },
			{ Key = "cloud_obby_under_m", Slab = { 15.5, 12.5 } },
			{ Key = "cloud_obby_under_l", Slab = { 19, 15.5 } },
		},
		UnderPad = { Key = "cloud_obby_under_pad", Slab = { 30, 30 } },
		-- kit-b O3 (finding 14): the dark cloud over a Storm step (CourseBuilder Mesh.storm), 2-3 anchors of the first key
		-- with an id, the lowest voxel StormBase studs over the platform top; its fit comes from the key's manifest. The
		-- lobby's cloud_storm_puff is left off on purpose: 8 boxes / 96 tris, it reads as a box at this size (O3 render).
		-- obby_storm_cloud has an id since the B1 upload; at id 0 the Part puffs come back. StormBase 7: at 4.5 the B1
		-- render put the cloud's bottom at the player's neck, so it hangs above the head (the top stays under Clearance).
		Storm = { "obby_storm_cloud" },
		StormBase = 7,
		-- kit-b clouds wave (owner's call 2026-11-13: trim far clouds on phones / Low, the 300k triangle budget stays):
		-- each course tags PhoneTrim of its far clouds (the heaviest keys first, the smaller one on a tie) PhoneTrimTag,
		-- and more while its cloud set still tops PhoneRoom (300,000 less the 151,554 of 16 players x 3 pets,
		-- tools/mesh_budget.py), then sea clouds once every far one is (3 of 125 probed courses, all Saint, went past 4;
		-- the heaviest trimmed 17 far + 1 sea); client GraphicsQuality parks them on a touch-only device (Low parks every
		-- NC_Detail cloud anyway). Desktop High keeps them all.
		-- tools/smoke_kitb_obby.lua obby_tris_budget_phone pins the worst case under 300k.
		PhoneTrim = 4,
		PhoneRoom = 148445,
		PhoneTrimTag = "NC_PhoneTrim",
	},
	-- kit-b O4 (finding 12): help text that names keys, one per device. CourseBuilder writes the Keyboard text and tags
	-- the label (Tag, attribute HelpKey); MovementController puts the text of the player's device on it and follows a
	-- change of device. Keys: Shift / Space / Q on a keyboard, L3 / A / B on a gamepad, the RUN / jump / DASH buttons on
	-- touch (MovementController's bindings).
	Help = {
		Tag = "NC_HelpText",
		Climb = {
			Keyboard = "Run:  SHIFT\nJump:  SPACE\nDash:  Q\nGrab the floating clouds!",
			Touch = "Run:  the RUN button\nJump:  the jump button\nDash:  the DASH button\nGrab the floating clouds!",
			Gamepad = "Run:  click L3\nJump:  A\nDash:  B\nGrab the floating clouds!",
		},
		Dash = {
			Keyboard = "press Q to dash",
			Touch = "tap DASH",
			Gamepad = "press B to dash",
		},
	},
}

