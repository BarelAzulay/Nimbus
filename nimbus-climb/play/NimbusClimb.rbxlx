----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local floor, max, min, abs, huge = math.floor, math.max, math.min, math.abs, math.huge

local function lerp(a, b, t)
	return a + (b - a) * t
end

local function serverNow()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function newFolder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

-- One anchored block (Voxel.Box when the kit is there). opts: Collide, Material, Transparency, Shadow, Reflectance,
-- Touch, Query.
local function box(parent, name, cf, size, color, opts)
	opts = opts or {}
	local p
	if Voxel and Voxel.Box then
		p = Voxel.Box(nil, cf, size, color, opts.Material or MAT.SmoothPlastic)
	else
		p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = opts.Material or MAT.SmoothPlastic
	end
	p.Name = name
	p.Transparency = opts.Transparency or 0
	if opts.Reflectance then
		p.Reflectance = opts.Reflectance
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.Collide == true
	p.CanQuery = opts.Collide == true or opts.Query == true
	p.CanTouch = opts.Touch == true
	if opts.Shadow ~= nil then
		p.CastShadow = opts.Shadow == true
	else
		p.CastShadow = max(size.X, size.Y, size.Z) >= 4
	end
	p.Parent = parent
	return p
end

local function anchorPart(parent, name, cf)
	return box(parent, name, cf, Vector3.new(1, 1, 1), C.Cloud, { Transparency = 1, Shadow = false })
end

local function countParts(inst)
	if not inst then
		return 0
	end
	local n = 0
	if inst:IsA("BasePart") then
		n = 1
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.LightEmission = 0.5
	e.LightInfluence = 0
	e.Rate = 4
	e.Lifetime = NumberRange.new(1, 2)
	e.Speed = NumberRange.new(1, 2)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-40, 40)
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.2, 0.25),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, 0.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	if props then
		for k, v in pairs(props) do
			e[k] = v
		end
	end
	e.Parent = parent
	return e
end

local function pointLight(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- GUI helpers (World text rule; fonts only through Theme roles)
----------------------------------------------------------------------
local function rounded(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = (type(radius) == "number") and UDim.new(0, radius) or radius
	c.Parent = parent
	return c
end

local function outline(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function vgradient(parent, top, bottom)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

local function padding(parent, top, left, bottom, right)
	local p = Instance.new("UIPadding")
	p.PaddingTop = UDim.new(0, top)
	p.PaddingLeft = UDim.new(0, left)
	p.PaddingBottom = UDim.new(0, bottom or top)
	p.PaddingRight = UDim.new(0, right or left)
	p.Parent = parent
	return p
end

local function listLayout(parent, direction, gap, hAlign)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction or Enum.FillDirection.Vertical
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	l.VerticalAlignment = Enum.VerticalAlignment.Center
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Padding = UDim.new(0, gap or 0)
	l.Parent = parent
	return l
end

local function plainFrame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	if props then
		for k, v in pairs(props) do
			f[k] = v
		end
	end
	f.Parent = parent
	return f
end

-- Fixed-size outlined text that sizes itself (tags, pills).
local function tagText(parent, name, text, role, size, color, order)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color or C.Text,
		Stroke = 1,
		Outline = 2.5,
		OutlineColor = C.Ink,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, size + 4),
			TextWrapped = false,
			LayoutOrder = order or 0,
		},
	})
	label.Parent = parent
	return label
end

-- Pixel-sized billboard (constant on-screen size) whose bottom edge sits on the adornee.
local function newTag(adornee, name, w, h, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = UDim2.fromOffset(w, h)
	gui.SizeOffset = Vector2.new(0, 0.5)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or PAD_SIGN_RANGE
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

local function tagPlate(gui, edge)
	local plate = plainFrame(gui, "Plate", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(150, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.04,
	})
	rounded(plate, 14)
	local stroke = outline(plate, edge or C.TextGold, 3.5)
	stroke.Name = "Edge"
	vgradient(plate, (Theme.Colors and Theme.Colors.PanelLight) or C.Violet, (Theme.Colors and Theme.Colors.Panel) or C.Navy)
	padding(plate, 6, 14, 8)
	listLayout(plate, Enum.FillDirection.Vertical, 3)
	return plate
end

local function surfaceGui(part, face, name)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name or "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SIGN_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	gui.Parent = part
	return gui
end

local function signText(parent, text, role, size, color, name, x, y, w, h)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Stroke = 1,
		Outline = max(2, floor(size / 16 + 0.5)),
		OutlineColor = C.Ink,
		Props = {
			Name = name,
			Position = UDim2.new(x, 0, y, 0),
			Size = UDim2.new(w, 0, h, 0),
			TextWrapped = false,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	label.Parent = parent
	return label
end

local function formatCash(n)
	local TC = catalog()
	if TC and type(TC.FormatCash) == "function" then
		local ok, s = pcall(TC.FormatCash, n)
		if ok and type(s) == "string" then
			return s
		end
	end
	n = floor(tonumber(n) or 0)
	if Util and Util.Commas then
		return "$" .. Util.Commas(n)
	end
	return "$" .. tostring(n)
end


----------------------------------------------------------------------
-- The art kit (Phase 6 A1: back to the Phase 4 look, 7aa0df2): SmoothPlastic everywhere (Glass / Neon / ForceField
-- only for glass, glow and holograms), the bright P4 palette, blocky voxel shapes only (no Cylinder / Ball: the
-- "round" helpers below build square prisms and cubes, roofs are stepped voxel stacks). The material keys stay so
-- the art code reads the same; every one of them is SmoothPlastic now. The detail comes later from the Blender
-- meshes (wave 2), so this is a revert, not new Part detail.
----------------------------------------------------------------------
local PLASTIC = MAT.SmoothPlastic
local M = {
	Slate = PLASTIC,
	Cobble = PLASTIC,
	Brick = PLASTIC,
	Marble = PLASTIC,
	Planks = PLASTIC,
	Wood = PLASTIC,
	Grass = PLASTIC,
	Leafy = PLASTIC,
	Sand = PLASTIC,
	Clay = PLASTIC,
	Shingles = PLASTIC,
	Metal = PLASTIC,
	Glass = MAT.Glass,
	Neon = MAT.Neon,
	Fabric = PLASTIC,
	Force = MAT.ForceField,
	Plastic = PLASTIC,
}
-- the materials a home part may use (Kit.finish turns anything else into SmoothPlastic)
local ALLOWED_MATS = { [PLASTIC] = true, [MAT.Neon] = true, [MAT.Glass] = true, [MAT.ForceField] = true }

-- the Phase 4 palette (7aa0df2 HomeBuilder.lua:151-191 + its House / station colours; style.md 4): bright stone,
-- white castle walls, blue and terracotta roofs, gold trim, juicy greens. The old key names stay.
local K = {
	SlateDark = rgb(160, 152, 144), -- P4 StoneDark: plinths and steps
	Slate = rgb(208, 202, 190), -- P4 Stone
	SlateLight = rgb(226, 221, 209), -- P4 StoneLight
	Marble = rgb(240, 240, 246), -- P4 Castle white
	MarbleShade = rgb(212, 216, 232), -- P4 CastleShade
	Cobble = rgb(208, 202, 190),
	Brick = rgb(250, 214, 196), -- P4 VillaWall (peach)
	BrickDark = rgb(220, 120, 80), -- P4 Terracotta
	Planks = rgb(196, 146, 98),
	PlanksLight = rgb(218, 170, 118),
	PlanksDark = rgb(146, 102, 70),
	Wood = rgb(128, 90, 62), -- P4 Bark
	WoodDark = rgb(150, 100, 66), -- P4 Door
	Whitewash = rgb(252, 248, 240), -- P4 VillaTrim
	Cream = rgb(250, 238, 214), -- P4 cottage Wall
	Manor = rgb(232, 226, 240), -- P4 ManorWall
	Grass = rgb(118, 192, 92),
	GrassLight = rgb(132, 202, 98),
	Leafy = rgb(98, 178, 80),
	LeafyDark = rgb(70, 146, 70),
	LeafyTeal = rgb(104, 196, 116), -- P4 Canopy
	Soil = rgb(122, 88, 66),
	SoilDark = rgb(100, 72, 56),
	Sand = rgb(236, 214, 166),
	Roof = rgb(222, 104, 82), -- P4 Roof (terracotta)
	RoofDark = rgb(190, 82, 68), -- P4 RoofTop
	RoofBlue = rgb(88, 136, 226), -- P4 Spire
	RoofBlueLight = rgb(110, 158, 238), -- P4 Spire2
	RoofBlueDark = rgb(70, 112, 204), -- P4 SpireTop
	Shingle = rgb(86, 106, 160), -- P4 manor Slate roof
	ShingleLight = rgb(102, 124, 178),
	BarnRed = rgb(226, 92, 90),
	Gold = rgb(244, 198, 84),
	GoldBright = rgb(255, 214, 96),
	Iron = rgb(74, 82, 108),
	IronDark = rgb(46, 52, 72),
	Copper = rgb(212, 134, 84),
	Glass = rgb(186, 224, 250),
	WarmGlass = rgb(255, 222, 150),
	Shutter = rgb(98, 148, 226),
	Fabric = rgb(246, 150, 188),
	Banner = rgb(236, 88, 110),
	Lantern = rgb(255, 214, 140),
	Water = rgb(92, 178, 236),
	WaterDeep = rgb(62, 136, 212),
	BerryRed = rgb(226, 58, 94),
	BerryRed2 = rgb(240, 92, 104),
	BerryBlue = rgb(84, 120, 230),
	BerryBlue2 = rgb(118, 160, 244),
	BerryGold = rgb(255, 210, 66),
	Star = rgb(255, 222, 96),
	CloudTop = rgb(244, 247, 252),
	CloudSide = rgb(232, 238, 249),
	CloudUnder = rgb(212, 222, 241),
}
local LANTERN = K.Lantern
local DETAIL_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail"
local EXEMPT_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Exempt) or "NC_StyleExempt"
local PI = math.pi
local rad = math.rad

local Kit = {}

-- one block in a world material; collide = true makes it solid (walkable / blocking)
function Kit.p(parent, name, cf, size, color, mat, collide, extra)
	local opts = { Material = mat or M.Slate, Collide = collide == true }
	if extra then
		for k, v in pairs(extra) do
			opts[k] = v
		end
	end
	return box(parent, name, cf, size, color, opts)
end

-- a "ball" (P6 A1: a voxel cube, no round primitives) centred on pos, d studs wide
function Kit.ball(parent, name, pos, d, color, mat, collide)
	return Kit.p(parent, name, CFrame.new(pos), Vector3.new(d, d, d), color, mat, collide)
end

-- an upright "cylinder" standing on (x, y0, z): a square voxel prism d wide, h tall
function Kit.cyl(parent, name, x, y0, z, d, h, color, mat, collide)
	return Kit.p(parent, name, CFrame.new(x, y0 + h / 2, z), Vector3.new(d, h, d), color, mat, collide)
end

-- a "cylinder" along an arbitrary CFrame's X axis (pipes, door wheels, medallions): a square bar / tile
function Kit.cylAt(parent, name, cf, length, d, color, mat, collide)
	return Kit.p(parent, name, cf, Vector3.new(length, d, d), color, mat, collide)
end

-- a wedge (P6 A1: no slopes either; a block of the same size)
function Kit.wedge(parent, name, cf, size, color, mat, collide)
	return Kit.p(parent, name, cf, size, color, mat or M.Planks, collide)
end

-- a round slab of width w and height h standing on y0: a square voxel slab
function Kit.oct(parent, name, x, y0, z, w, h, color, mat, collide)
	return Kit.cyl(parent, name, x, y0, z, w, h, color, mat, collide)
end

-- a stepped voxel roof over a rectangle (the P4 look): cf = the centre of the wall tops (ridge along local X),
-- len = ridge length, span = the width it covers (local Z), rise = ridge height. Layers of blocks shrink toward
-- the ridge (light / dark alternate like P4's stepped spires); the first layer overhangs the walls. opts: Overhang,
-- EndOverhang, Ridge (a ridge cap colour), Collide, Dark (the alternate layer colour). Returns the layers.
function Kit.gable(parent, name, cf, len, span, rise, color, mat, opts)
	opts = opts or {}
	local ov = opts.Overhang or 0.6
	local eo = opts.EndOverhang or 0.4
	local n = max(2, min(5, floor(rise / 0.9 + 0.5)))
	local lh = rise / n
	local w0 = span + 2 * ov
	local layers = {}
	for i = 0, n - 1 do
		local w = w0 * (1 - i / n)
		local c = (opts.Dark and i % 2 == 1) and opts.Dark or color
		layers[#layers + 1] = Kit.p(parent, name, cf * CFrame.new(0, (i + 0.5) * lh, 0), Vector3.new(len + 2 * eo, lh, max(0.5, w)), c, mat, opts.Collide)
	end
	if opts.Ridge then
		Kit.p(parent, name .. "Ridge", cf * CFrame.new(0, rise + 0.15, 0), Vector3.new(len + 2 * eo + 0.1, 0.3, 0.5), opts.Ridge, M.Wood)
	end
	return layers
end

-- a window on a wall: cf = the window centre ON the wall surface, local -Z = outward. A wooden frame and warm glass
-- set 0.08 proud of the wall, a sill below (3 parts)
function Kit.window(parent, cf, w, h, frameColor, glassColor, opts)
	opts = opts or {}
	Kit.p(parent, "WindowFrame", cf * CFrame.new(0, 0, -0.06), Vector3.new(w + 0.3, h + 0.3, 0.12), frameColor or K.Whitewash, M.Wood)
	Kit.p(parent, "Window", cf * CFrame.new(0, 0, -0.14), Vector3.new(w, h, 0.06), glassColor or K.WarmGlass, M.Glass, false, { Transparency = opts.Transparency or 0.1, Reflectance = 0.05 })
	if opts.Sill ~= false then
		Kit.p(parent, "Sill", cf * CFrame.new(0, -h / 2 - 0.2, -0.2), Vector3.new(w + 0.5, 0.18, 0.4), opts.SillColor or K.SlateLight, M.Slate)
	end
end

-- a wall lantern / post-top lantern: a dark iron cap and a glowing warm body; light = a PointLight (no shadows)
function Kit.lantern(parent, pos, size, light, style)
	size = size or 0.6
	local cap = (style == "Brass") and K.Gold or ((style == "Crystal") and K.Marble or K.IronDark)
	local body = Kit.p(parent, "Lantern", CFrame.new(pos), Vector3.new(size, size * 1.25, size), (style == "Crystal") and rgb(200, 236, 255) or LANTERN, M.Neon)
	Kit.p(parent, "LanternCap", CFrame.new(pos + Vector3.new(0, size * 0.75, 0)), Vector3.new(size * 1.35, size * 0.25, size * 1.35), cap, (style == "Crystal") and M.Marble or M.Metal)
	if light then
		pointLight(body, (style == "Crystal") and rgb(214, 236, 255) or LANTERN, 1.2, 12)
	end
	return body
end

-- an inset corner post (6.4 rule 4: a 0.6-stud post on a corner >= 4 studs tall)
function Kit.corner(parent, x, y0, z, h, color, mat)
	return Kit.p(parent, "CornerPost", CFrame.new(x, y0 + h / 2, z), Vector3.new(0.6, h, 0.6), color or K.Whitewash, mat or M.Wood)
end

-- the four inset corner posts of a box [x0, x1] x [z0, z1]
function Kit.corners(parent, x0, x1, z0, z1, y0, h, color, mat)
	for _, x in ipairs({ x0, x1 }) do
		for _, z in ipairs({ z0, z1 }) do
			Kit.corner(parent, x, y0, z, h, color, mat)
		end
	end
end

-- a sub-model of pure decoration (tagged NC_Detail: the Low graphics setting hides it)
function Kit.detail(parent, name)
	local d = Instance.new("Model")
	d.Name = name or "Detail"
	d.Parent = parent
	CollectionService:AddTag(d, DETAIL_TAG)
	return d
end

-- deterministic +-6 RGB shade noise for repeated pieces (P4 Voxel.Shade spirit: never one flat colour)
function Kit.jit(color, seed)
	local n = ((seed or 0) * 7919 + 13) % 13 - 6
	local function ch(v)
		return max(0, min(255, floor(v * 255 + 0.5) + n))
	end
	return Color3.fromRGB(ch(color.R), ch(color.G), ch(color.B))
end

-- a pixel billboard sign (World text rule): a title line and info lines on a navy plate; returns gui, labels
function Kit.sign(adornee, name, lift, title, infos, maxDistance, edge)
	local gui = newTag(adornee, name, 360, 120, maxDistance or 70)
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift or 3, 0)
	local plate = tagPlate(gui, edge or C.TextGold)
	local labels = {}
	labels.Title = tagText(plate, "Title", title, "Title", TAG_NAME, C.Text, 1)
	for i, info in ipairs(infos or {}) do
		local key = info.Name or ("Info" .. i)
		labels[key] = tagText(plate, key, info.Text, "Body", TAG_INFO, info.Color or C.TextGold, i + 1)
	end
	return gui, labels
end

----------------------------------------------------------------------
-- The style finish (a guard after every template, Phase 6 A1): every visible part is SmoothPlastic unless it is
-- Glass / Neon / ForceField, every Part is a Block (no Ball / Cylinder), Reflectance 0; parts < 4 studs cast no
-- shadow. Voxel clouds / pets / tokens (NC_StyleExempt) are skipped.
----------------------------------------------------------------------
local function exemptPart(p, root)
	local cur = p
	while cur and cur ~= root.Parent do
		if CollectionService:HasTag(cur, EXEMPT_TAG) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

function Kit.finish(root)
	for _, p in ipairs(root:GetDescendants()) do
		if p:IsA("BasePart") then
			local s = p.Size
			if max(s.X, s.Y, s.Z) < 4 then
				p.CastShadow = false
			end
			if not exemptPart(p, root) then
				if not ALLOWED_MATS[p.Material] then
					p.Material = PLASTIC
				end
				if p:IsA("Part") and p.Shape ~= Enum.PartType.Block then
					p.Shape = Enum.PartType.Block
				end
				if p.Material ~= MAT.Glass then
					p.Reflectance = 0
				end
			end
		end
	end
end
----------------------------------------------------------------------
-- Templates: every (station, level) is built once per server and cloned onto the plots. A template is
-- { Model = Model at the origin (front = -Z, ground = y 0), Points = { name = local Vector3 }, Info = {...} }.
----------------------------------------------------------------------
local templates = {}

local function newTemplate(name)
	local m = Instance.new("Model")
	m.Name = name
	return { Model = m, Points = {}, Info = {} }
end

-- clones a template model to `cf` (every part moved by cf), returns the clone (unparented)
local function cloneAt(tpl, cf)
	local m = tpl.Model:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	pcall(function()
		m.WorldPivot = cf
	end)
	return m
end

-- moves every child of `from` into `to` (merging sculpts into one model)
local function absorb(to, from)
	for _, c in ipairs(from:GetChildren()) do
		c.Parent = to
	end
	from:Destroy()
end

local function biggestPart(model, nameFilter)
	local best, bestVol = nil, -1
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p.Transparency < 1 and (not nameFilter or p.Name == nameFilter) then
			local v = p.Size.X * p.Size.Y * p.Size.Z
			if v > bestVol then
				best, bestVol = p, v
			end
		end
	end
	return best
end

local function attach(part, name, localPos, attrs)
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = part.CFrame:Inverse() * CFrame.new(localPos)
	if attrs then
		for k, v in pairs(attrs) do
			a:SetAttribute(k, v)
		end
	end
	a.Parent = part
	return a
end

local function newPrompt(name, action, object, stationId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("StationId", stationId)
	return prompt
end

----------------------------------------------------------------------
-- ART: stations. Each Art.<Kind>(def, level) returns a template.
----------------------------------------------------------------------
local Art = {}

----------------------------------------------------------------------
-- Berry Farm (Press1, Kind Farm, 40 levels; contract 3.6): a long terraced field beside the PressLane, front -Z
-- toward the lane, local +X = the north end. Three wooden-framed soil rows rise toward the back: the front row
-- grows red-berry bushes (one per level 1-10), the middle row blue-berry bushes (11-22), the back row a golden
-- trellis (a vine with gold berries per level 23-37), and the glowing Starberry tree on its mound at the north end
-- (38-40). Planted bushes keep growing for a few levels. A little red barn, berry crates and the farm sign stand
-- at the south end. <= 150 parts (L40 ~ 145).
----------------------------------------------------------------------
local Farm = {}
Farm.X0, Farm.X1 = -10.8, 13.2 -- the soil frame (local x)
Farm.ROWS = { { Z = -2.25, Top = 0.75 }, { Z = 0.0, Top = 1.15 }, { Z = 2.25, Top = 1.55 } }
Farm.RED, Farm.BLUE, Farm.VINES = 10, 12, 15 -- plants per row (levels 1-10, 11-22, 23-37)
Farm.TREE_X = 15.7

-- how grown a plant planted at level `at` is at `level` (0 = just planted .. 1 = full)
function Farm.age(level, at, span)
	return max(0, min(1, (level - at) / (span or 6)))
end

-- a berry bush: a leafy ball with berries on its front (the yard side)
function Farm.bush(parent, x, row, d, berry, berry2, n, seed)
	local r = Farm.ROWS[row]
	local cy = r.Top + d * 0.4
	Kit.ball(parent, "Bush", Vector3.new(x, cy, r.Z), d, Kit.jit(row == 1 and K.Leafy or K.LeafyDark, seed), M.Leafy)
	local spots = { { -0.28, 0.12 }, { 0.26, 0.26 }, { 0.04, -0.1 } }
	for k = 1, n do
		local o = spots[k]
		Kit.ball(parent, "Berry", Vector3.new(x + o[1] * d, cy + o[2] * d, r.Z - d * 0.4), 0.42 + 0.04 * k, (k % 2 == 0) and berry2 or berry, M.Plastic)
	end
end

function Art.Farm(def, level)
	local tpl = newTemplate("BerryFarm")
	local m = tpl.Model
	level = max(1, min(floor(level), (def and def.MaxLevel) or 40))
	local x0, x1 = Farm.X0, Farm.X1
	local len = x1 - x0
	local cx = (x0 + x1) / 2
	-- the field: a slate plinth, three soil rows stepping up toward the back (grass where a row is not planted yet)
	Kit.p(m, "Plinth", CFrame.new(cx + 2.4, 0.15, 0), Vector3.new(len + 4.8, 0.3, 7.0), K.SlateDark, M.Slate, true)
	for i, r in ipairs(Farm.ROWS) do
		local planted = (i == 1) or (i == 2 and level > Farm.RED) or (i == 3 and level > Farm.RED + Farm.BLUE)
		local top = r.Top -- an unplanted row is a grassed-over bed, ready for its bushes
		Kit.p(m, planted and "Soil" or "Grass", CFrame.new(cx, (0.3 + top) / 2, r.Z), Vector3.new(len - 0.3, top - 0.3, 2.15),
			planted and Kit.jit(K.Soil, i) or K.Grass, planted and M.Sand or M.Grass, true)
	end
	-- the wooden frame: the front board, two step boards between the rows, the back board and the two ends
	local fz = { -3.35, -1.12, 1.12, 3.35 }
	local fh = { 0.85, 1.25, 1.65, 1.65 }
	for i, z in ipairs(fz) do
		Kit.p(m, "Frame", CFrame.new(cx, fh[i] / 2, z), Vector3.new(len + 0.3, fh[i], 0.3), Kit.jit(K.Planks, 10 + i), M.Planks, i == 1 or i == 4)
	end
	for _, x in ipairs({ x0, x1 }) do
		Kit.p(m, "FrameEnd", CFrame.new(x, 0.85, 0), Vector3.new(0.3, 1.7, 7.0), K.PlanksDark, M.Planks, true)
	end
	-- the north mound where the Starberry tree grows
	Kit.cyl(m, "Mound", Farm.TREE_X, 0.3, 0, 4.4, 0.5, K.Grass, M.Grass, true)
	-- row 1: red berries (levels 1-10)
	local span = len - 1.2
	for i = 1, min(level, Farm.RED) do
		local x = x0 + 0.6 + (i - 0.5) * span / Farm.RED
		local g = Farm.age(level, i, 6)
		Farm.bush(m, x, 1, 1.45 + 0.5 * g, K.BerryRed, K.BerryRed2, (g >= 0.5) and 2 or 1, i)
	end
	-- row 2: blue berries (levels 11-22)
	for i = 1, min(level - Farm.RED, Farm.BLUE) do
		local x = x0 + 0.6 + (i - 0.5) * span / Farm.BLUE
		local g = Farm.age(level, Farm.RED + i, 6)
		Farm.bush(m, x, 2, 1.35 + 0.45 * g, K.BerryBlue, K.BerryBlue2, (g >= 0.5) and 2 or 1, 20 + i)
	end
	-- row 3: the golden trellis (levels 23-37): six posts and a top rail, then one vine with gold berries per level
	local vines = min(level - Farm.RED - Farm.BLUE, Farm.VINES)
	if vines > 0 then
		local r = Farm.ROWS[3]
		for k = 0, 5 do
			local px = x0 + 0.5 + k * (len - 1.0) / 5
			Kit.p(m, "TrellisPost", CFrame.new(px, r.Top + 1.75, r.Z + 0.35), Vector3.new(0.3, 3.5, 0.3), K.Wood, M.Wood)
		end
		Kit.p(m, "TrellisRail", CFrame.new(cx, r.Top + 3.4, r.Z + 0.35), Vector3.new(len - 0.6, 0.25, 0.25), K.Wood, M.Wood)
		local vspan = len - 1.4
		for j = 1, vines do
			local x = x0 + 0.7 + (j - 0.5) * vspan / Farm.VINES
			local g = Farm.age(level, Farm.RED + Farm.BLUE + j, 5)
			local h = ((j % 2 == 0) and 1.7 or 2.2) + 1.0 * g
			Kit.p(m, "Vine", CFrame.new(x, r.Top + h / 2, r.Z + 0.1), Vector3.new(0.85, h, 0.45), Kit.jit((j % 2 == 0) and K.Leafy or K.LeafyDark, 40 + j), M.Leafy)
			Kit.ball(m, "GoldBerry", Vector3.new(x + ((j % 2 == 0) and 0.25 or -0.25), r.Top + h * 0.62, r.Z - 0.3), 0.5 + 0.12 * g, K.BerryGold, M.Metal)
		end
	end
	-- a young sapling on the mound foreshadows the Starberry tree (30-37)
	if level >= 30 and level < 38 then
		Kit.cyl(m, "Sapling", Farm.TREE_X, 0.8, 0, 0.35, 1.6, K.Wood, M.Wood)
		Kit.ball(m, "SaplingLeaves", Vector3.new(Farm.TREE_X, 2.7, 0), 1.5, K.LeafyTeal, M.Leafy)
	end
	-- the Starberry tree (levels 38-40): a trunk, a teal crown of three puffs and glowing star fruit
	if level >= 38 then
		local t = level - 37 -- 1..3
		local trunkH = 2.6 + 0.7 * t
		local crown = 3.0 + 0.55 * t
		local tx = Farm.TREE_X
		Kit.cyl(m, "Trunk", tx, 0.8, 0, 0.9, trunkH, K.Wood, M.Wood)
		local cy = 0.8 + trunkH + crown * 0.3
		Kit.ball(m, "Crown", Vector3.new(tx, cy, 0), crown, K.LeafyTeal, M.Leafy)
		Kit.ball(m, "Crown", Vector3.new(tx - crown * 0.32, cy - crown * 0.22, -0.3), crown * 0.66, Kit.jit(K.LeafyTeal, 7), M.Leafy)
		Kit.ball(m, "Crown", Vector3.new(tx + crown * 0.32, cy - crown * 0.18, 0.3), crown * 0.62, Kit.jit(K.LeafyTeal, 9), M.Leafy)
		local stars = { { -0.35, -0.05, -0.5 }, { 0.3, 0.2, -0.48 }, { 0.0, 0.42, -0.36 }, { 0.42, -0.25, -0.3 } }
		for k = 1, min(#stars, t + 1) do
			local o = stars[k]
			local sp = Kit.p(m, "Starberry", CFrame.new(tx + o[1] * crown, cy + o[2] * crown, o[3] * crown) * CFrame.Angles(rad(45), rad(30), rad(45)),
				Vector3.new(0.55, 0.55, 0.55), K.Star, M.Neon)
			if k == 1 and t >= 3 then
				pointLight(sp, LANTERN, 1.2, 12)
				local att = Instance.new("Attachment")
				att.Name = "Sparkle"
				att.Parent = sp
				emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
			end
		end
	end
	-- the little red barn at the south end (its door faces the lane)
	local bx = -15.6
	local bw, bd, bh = 4.8, 5.4, 3.4
	local bz = 0.6
	Kit.p(m, "BarnPlinth", CFrame.new(bx, 0.25, bz), Vector3.new(bw + 0.5, 0.5, bd + 0.5), K.SlateDark, M.Slate, true)
	Kit.p(m, "Barn", CFrame.new(bx, 0.5 + bh / 2, bz), Vector3.new(bw, bh, bd), K.BarnRed, M.Planks, true)
	for _, sx in ipairs({ -1, 1 }) do
		Kit.corner(m, bx + sx * (bw / 2 - 0.15), 0.5, bz - bd / 2 + 0.15, bh, K.Whitewash, M.Wood)
	end
	-- the roof: its ridge runs front to back, so the gable (with the hay-loft door) faces the lane
	local roofCF = CFrame.new(bx, 0.5 + bh, bz) * CFrame.Angles(0, PI / 2, 0)
	local slabs = Kit.gable(m, "BarnRoof", roofCF, bd, bw, 2.0, K.Shingle, M.Shingles, { Overhang = 0.45, Ridge = K.WoodDark, GableColor = K.BarnRed })
	slabs[1].Name = "BarnRoof"
	Kit.p(m, "BarnDoor", CFrame.new(bx, 0.5 + 1.25, bz - bd / 2 - 0.06), Vector3.new(2.0, 2.5, 0.14), K.WoodDark, M.Wood)
	Kit.p(m, "DoorBrace", CFrame.new(bx, 0.5 + 1.25, bz - bd / 2 - 0.15) * CFrame.Angles(0, 0, math.atan(2.5 / 2.0)), Vector3.new(3.0, 0.22, 0.06), K.Whitewash, M.Wood)
	Kit.p(m, "LoftDoor", CFrame.new(bx, 0.5 + bh + 0.65, bz - bd / 2 - 0.2), Vector3.new(1.0, 0.9, 0.12), K.WoodDark, M.Wood)
	local sign = Kit.p(m, "SignBoard", CFrame.new(bx, 0.5 + bh - 0.45, bz - bd / 2 - 0.1), Vector3.new(2.8, 0.55, 0.12), K.Whitewash, M.Wood)
	if level >= 10 then
		Kit.lantern(m, Vector3.new(bx + 1.55, 0.5 + 2.6, bz - bd / 2 - 0.35), 0.45, true)
	end
	-- berry crates by the barn (pure decor)
	local d = Kit.detail(m, "Crates")
	local crates = { { -12.25, 0.55, -2.6, K.BerryRed }, { -12.25, 0.55, -1.3, K.BerryBlue }, { -12.25, 1.65, -1.95, K.BerryGold } }
	local nCrates = (level >= 23) and 3 or ((level >= 11) and 2 or 1)
	for i = 1, nCrates do
		local c = crates[i]
		Kit.p(d, "Crate", CFrame.new(c[1], c[2], c[3]) * CFrame.Angles(0, rad((i - 2) * 6), 0), Vector3.new(1.15, 1.1, 1.15), Kit.jit(K.PlanksLight, i), M.Planks)
		Kit.p(d, "CrateBerries", CFrame.new(c[1], c[2] + 0.6, c[3]) * CFrame.Angles(0, rad((i - 2) * 6), 0), Vector3.new(0.95, 0.18, 0.95), c[4], M.Plastic)
	end
	-- the farm sign (World text rule, MaxDistance 70)
	Kit.sign(sign, "FarmSign", 4.2, "Berry Farm Lv " .. level, { { Name = "Info", Text = "Grows berries for your pets", Color = C.TextGreen } }, 70, C.CashGlow)
	-- where HomeFx's berry flights start: the top of the planted rows, in the middle of the field
	local topRow = (vines > 0) and 3 or ((level > Farm.RED) and 2 or 1)
	tpl.Points.BerryPoint = Vector3.new(cx, Farm.ROWS[topRow].Top + 2.2, Farm.ROWS[topRow].Z)
	tpl.Info.Rows = topRow
	return tpl
end

----------------------------------------------------------------------
-- Pet Garden (Kind Garden; contract 3.3 / 3.6): front -Z = the entrance (Slot.Entrance, 4 wide) toward its pad. A
-- grass lawn inside a fence ring on the footprint edge (Slot.Fence 0.6: a cobble kerb, posts and a wooden rail),
-- the Food Bowl in the middle (Slot.Bowl, filled with berries; its "Food Bowl" sign) and 12 beds (Slot.Beds):
-- an OPEN bed = a wooden bed with a cushion under a tiny lean-to roof (Attachment Spot<i>, and a PromptPoint<i> with
-- the owner-only GardenSpotPrompt on its yard side), a CLOSED bed = a soil bed with a seedling (Stem + Sprout) and a
-- "Prestige to open" sign. The interior stays clear for the roaming pets (HomeRoam): every level's decor sits on the
-- fence (flower strips, the entrance arch, lanterns, bunting, gold rails at 8). The lawn top is y 0.2. <= 95 parts.
----------------------------------------------------------------------
local Garden = {}

Garden.PROMPT_RANGE = 3 -- studs (contract 3.6)
Garden.CUSHION_TOP = 0.95
Garden.LAWN_TOP = 0.2
Garden.CUSHIONS = { rgb(246, 150, 188), rgb(150, 224, 176), rgb(130, 170, 255), rgb(250, 214, 92) }

function Garden.places(def)
	return (def and def.Slot and type(def.Slot.Beds) == "table") and def.Slot.Beds or {}
end

function Garden.defaultOpen()
	local cat = catalog()
	local p = cat and type(cat.Prestige) == "table" and cat.Prestige or nil
	return (p and tonumber(p.GardenSlotsBase)) or 3
end

function Garden.clampOpen(open, places)
	open = tonumber(open)
	if not open or open ~= open then
		open = Garden.defaultOpen()
	end
	return max(0, min(floor(open), places))
end

-- the bed's frame: at the bed centre on the lawn, local -Z = toward the garden's interior, +Z = the fence behind it
function Garden.bedFrame(def, v)
	local hx = ((def.Slot.Footprint and def.Slot.Footprint.X) or 22) / 2
	local out
	if abs(v.X) >= hx - 3 then
		out = Vector3.new((v.X > 0) and 1 or -1, 0, 0)
	else
		out = Vector3.new(0, 0, 1)
	end
	local pos = Vector3.new(v.X, Garden.LAWN_TOP, v.Z)
	return CFrame.lookAt(pos, pos - out)
end

-- the prompt point of bed i (station frame): on the bed's interior side, half a stud over the cushion
function Garden.promptPoint(def, i)
	local v = Garden.places(def)[i]
	if typeof(v) ~= "Vector3" then
		return nil
	end
	local size = def.Slot.BedSize or 2.5
	return (Garden.bedFrame(def, v) * CFrame.new(0, 1.3, -(size / 2 + 0.35))).Position
end

-- the "Prestige to open" sign of a closed bed (World text rule: 50 px per stud, letters 0.6 stud)
function Garden.closedSign(parent, bedCF, size)
	local board = Kit.p(parent, "ClosedSign", bedCF * CFrame.new(0, 0.95, -(size / 2 + 0.05)), Vector3.new(3.4, 1.4, 0.15), K.PlanksLight, M.Planks)
	local gui = surfaceGui(board, Enum.NormalId.Front, "ClosedGui")
	local panel = plainFrame(gui, "Panel", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 0 })
	vgradient(panel, C.Violet, C.Navy)
	rounded(panel, 10)
	outline(panel, C.TextGold, 4, 0.1)
	signText(panel, GLYPH.Star, "Heading", 48, C.TextGold, "Star", 0.0, 0.0, 0.28, 1.0)
	signText(panel, "Prestige", "Heading", 30, C.TextGold, "Title", 0.28, 0.02, 0.72, 0.48)
	signText(panel, "to open", "Heading", 30, C.Text, "Info", 0.28, 0.5, 0.72, 0.48)
	return board
end

function Art.Garden(def, level, open)
	local tpl = newTemplate("Garden")
	local m = tpl.Model
	local slot = def.Slot
	local fp = slot.Footprint or Vector3.new(22, 4, 20)
	local hx, hz = fp.X / 2, fp.Z / 2
	local t = slot.Fence or 0.6
	local beds = Garden.places(def)
	local size = slot.BedSize or 2.5
	open = Garden.clampOpen(open, #beds)
	local ent = slot.Entrance or { Center = Vector3.new(0, 0, -hz), Width = 4 }
	local g0, g1 = ent.Center.X - ent.Width / 2, ent.Center.X + ent.Width / 2
	local gold = level >= 8
	-- the lawn
	local lawn = Kit.p(m, "Lawn", CFrame.new(0, Garden.LAWN_TOP / 2, 0), Vector3.new(fp.X, Garden.LAWN_TOP, fp.Z), K.GrassLight, M.Grass, true)
	-- the fence ring: kerb runs (the sides between the front and back runs), a rail on posts
	local kh, railY = 0.7, 1.55
	local runs = {
		{ "Back", 0, hz - t / 2, fp.X, t },
		{ "Left", -hx + t / 2, 0, t, fp.Z - 2 * t },
		{ "Right", hx - t / 2, 0, t, fp.Z - 2 * t },
		{ "FrontL", (-hx + g0) / 2, -hz + t / 2, g0 + hx, t },
		{ "FrontR", (g1 + hx) / 2, -hz + t / 2, hx - g1, t },
	}
	local railColor = gold and K.Gold or K.Planks
	local railMat = gold and M.Metal or M.Planks
	for i, r in ipairs(runs) do
		Kit.p(m, "Kerb", CFrame.new(r[2], Garden.LAWN_TOP + kh / 2, r[3]), Vector3.new(r[4], kh, r[5]), Kit.jit(K.Cobble, i), M.Cobble, true)
		Kit.p(m, "Rail", CFrame.new(r[2], railY, r[3]), Vector3.new(r[4], 0.22, r[5] * 0.6), railColor, railMat, true)
	end
	local postH = 1.85
	local posts = {
		{ -hx + t / 2, -hz + t / 2 }, { hx - t / 2, -hz + t / 2 }, { -hx + t / 2, hz - t / 2 }, { hx - t / 2, hz - t / 2 },
		{ -hx + t / 2, 0 }, { hx - t / 2, 0 }, { 0, hz - t / 2 },
	}
	for i, p in ipairs(posts) do
		Kit.p(m, "Post", CFrame.new(p[1], postH / 2, p[2]), Vector3.new(0.72, postH, 0.72), Kit.jit(K.Wood, 30 + i), M.Wood, true)
	end
	-- the entrance posts (taller from level 3: they carry the arch)
	local arch = level >= 3
	local eh = arch and 3.9 or postH + 0.2
	for _, x in ipairs({ g0 - 0.45, g1 + 0.45 }) do
		Kit.p(m, "EntrancePost", CFrame.new(x, eh / 2, -hz + t / 2), Vector3.new(0.75, eh, 0.75), K.Wood, M.Wood, true)
	end
	-- a cobble walk from the entrance to the bowl (flush with the lawn: pets and players walk over it)
	local walkZ0, walkZ1 = -hz + t, (slot.Bowl and (slot.Bowl.Center.Z - slot.Bowl.Radius) or -2.5) + 0.2
	Kit.p(m, "Walk", CFrame.new(ent.Center.X, Garden.LAWN_TOP + 0.03, (walkZ0 + walkZ1) / 2), Vector3.new(ent.Width - 0.6, 0.06, walkZ1 - walkZ0), K.Cobble, M.Cobble, true)
	-- the Food Bowl: a slate basin with a marble rim, full of berries
	local bowl = slot.Bowl or { Center = Vector3.new(0, 0, 0), Radius = 2.5 }
	local bc, br = bowl.Center, bowl.Radius
	local basin = Kit.cyl(m, "FoodBowl", bc.X, Garden.LAWN_TOP, bc.Z, 2 * br, 0.55, K.Slate, M.Slate, true)
	Kit.cyl(m, "BowlRim", bc.X, Garden.LAWN_TOP + 0.55, bc.Z, 2 * br + 0.2, 0.18, K.Marble, M.Marble, true)
	Kit.cyl(m, "BowlBerries", bc.X, Garden.LAWN_TOP + 0.73, bc.Z, 2 * br - 0.8, 0.16, rgb(226, 58, 94), M.Sand)
	local heap = { { -0.55, 0.1, K.BerryRed2 }, { 0.5, -0.3, K.BerryBlue } }
	for _, h in ipairs(heap) do
		Kit.ball(m, "BowlBerry", Vector3.new(bc.X + h[1], Garden.LAWN_TOP + 1.05, bc.Z + h[2]), 0.85, h[3], M.Plastic)
	end
	Kit.sign(basin, "BowlSign", 3.4, "Food Bowl", { { Name = "Info", Text = "Pets eat here, then poop Cloud Cash!", Color = C.TextGreen } }, 40, C.CashGlow)
	tpl.Points.BowlCenter = Vector3.new(bc.X, Garden.LAWN_TOP + 0.9, bc.Z)
	-- the beds
	for i, v in ipairs(beds) do
		local cf = Garden.bedFrame(def, v)
		if i <= open then
			Kit.p(m, "Bed", cf * CFrame.new(0, 0.225, 0), Vector3.new(size, 0.45, size), Kit.jit(K.Planks, 50 + i), M.Planks, true)
			Kit.p(m, "Cushion", cf * CFrame.new(0, 0.6, 0.05), Vector3.new(size - 0.5, 0.3, size - 0.55), Kit.jit(Garden.CUSHIONS[(i - 1) % 4 + 1], i), M.Fabric)
			Kit.p(m, "Headboard", cf * CFrame.new(0, 1.05, size / 2 - 0.12), Vector3.new(size, 1.7, 0.24), Kit.jit(K.PlanksDark, 70 + i), M.Planks)
			Kit.p(m, "BedRoof", cf * CFrame.new(0, 2.05, size / 2 - 0.55), Vector3.new(size + 0.4, 0.2, 1.5), Kit.jit(K.Roof, 60 + i), M.Clay)
		else
			Kit.p(m, "SoilBed", cf * CFrame.new(0, 0.175, 0), Vector3.new(size, 0.35, size), K.SoilDark, M.Sand, true)
			Kit.p(m, "Stem", cf * CFrame.new(0, 0.7, 0.3), Vector3.new(0.18, 0.7, 0.18), K.LeafyDark, M.Leafy)
			Kit.p(m, "Sprout", cf * CFrame.new(0, 1.1, 0.3), Vector3.new(0.75, 0.22, 0.45), K.GrassLight, M.Leafy)
			Garden.closedSign(m, cf, size)
		end
	end
	-- the level decor, all on the fence ring or overhead (the interior stays clear for the roaming pets)
	local d = Kit.detail(m, "GardenDecor")
	if level >= 2 then
		-- flower strips on the front kerb, both sides of the entrance
		for _, r in ipairs({ runs[4], runs[5] }) do
			Kit.p(d, "FlowerStrip", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.15, r[3]), Vector3.new(r[4] - 1.2, 0.3, 0.5), K.Leafy, M.Leafy)
			Kit.p(d, "Blooms", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.36, r[3]), Vector3.new(r[4] - 1.6, 0.14, 0.34), rgb(246, 150, 188), M.Fabric)
		end
	end
	if arch then
		Kit.p(m, "Arch", CFrame.new(ent.Center.X, eh + 0.2, -hz + t / 2), Vector3.new(ent.Width + 2.0, 0.4, 0.9), K.Planks, M.Planks)
		Kit.p(d, "Garland", CFrame.new(ent.Center.X, eh - 0.15, -hz + t / 2 - 0.1), Vector3.new(ent.Width + 0.8, 0.35, 0.6), K.Leafy, M.Leafy)
	end
	if level >= 4 then
		for _, x in ipairs({ g0 - 0.45, g1 + 0.45 }) do
			Kit.lantern(d, Vector3.new(x, eh - 1.0, -hz + t / 2 - 0.62), 0.42, x > ent.Center.X)
		end
	end
	if level >= 5 then
		for _, r in ipairs({ runs[2], runs[3] }) do
			Kit.p(d, "FlowerStrip", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.15, r[3]), Vector3.new(0.5, 0.3, r[5] - 2.0), K.Leafy, M.Leafy)
			Kit.p(d, "Blooms", CFrame.new(r[2], Garden.LAWN_TOP + kh + 0.36, r[3]), Vector3.new(0.34, 0.14, r[5] - 2.6), rgb(172, 142, 232), M.Fabric)
		end
	end
	if level >= 6 then
		for _, p in ipairs({ posts[3], posts[4] }) do
			Kit.lantern(d, Vector3.new(p[1], postH + 0.45, p[2]), 0.5, false)
		end
	end
	if level >= 7 then
		Kit.p(d, "Bunting", CFrame.new(0, railY - 0.3, hz - t / 2 - 0.05), Vector3.new(fp.X - 2.0, 0.4, 0.06), rgb(250, 168, 72), M.Fabric)
		Kit.p(d, "Bunting", CFrame.new(0, railY - 0.3, hz - t / 2 + 0.05), Vector3.new(fp.X - 2.4, 0.4, 0.06), rgb(118, 168, 236), M.Fabric)
	end
	if gold then
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		att.CFrame = lawn.CFrame:Inverse() * CFrame.new(ent.Center.X, eh + 0.6, -hz + t / 2)
		att.Parent = lawn
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	-- where pets sleep (Spot<i>, every bed) and the GardenSpotPrompts (open beds; SetGarden enables the empty ones)
	for i, v in ipairs(beds) do
		local cf = Garden.bedFrame(def, v)
		attach(lawn, "Spot" .. i, (cf * CFrame.new(0, Garden.CUSHION_TOP - Garden.LAWN_TOP, 0)).Position, { Slot = i, Open = i <= open })
		if i <= open then
			local pa = attach(lawn, "PromptPoint" .. i, Garden.promptPoint(def, i), { Slot = i })
			local prompt = newPrompt("GardenSpotPrompt", "Put a pet here", "Garden bed " .. i, "Garden")
			prompt.MaxActivationDistance = Garden.PROMPT_RANGE
			prompt.Enabled = false
			prompt:SetAttribute("Slot", i)
			prompt.Parent = pa
		end
	end
	tpl.Info.Open = open
	return tpl
end
----------------------------------------------------------------------
-- Food Machine (Kitchen, contract 3.4 / 3.6; the slot swapped with the Training Place): front -Z. A wooden cabinet
-- with iron bands on a slate plinth, a glass `Hopper` full of berries on a copper funnel (PetCareService puts the
-- FeedPrompt on it), a dispenser mouth with a chute over a tray, a big red FEED button, the Berry Basket beside it
-- (HomeFx's berry flights land in it) and the machine's sign: "Food Machine" / "Berries -> XP: press E" + the basket
-- line (TextLabel `BasketLine`, HomeFx rewrites it from the player attribute Berries and the plot's BerryCap).
-- Lamps (2+), a berry press barrel (3+), a shelf of bowls (4+), brass trims and a bell (5). Points ChuteMouth,
-- Tray, HopperTop, BasketTop. <= 55 parts.
----------------------------------------------------------------------
function Art.FoodMachine(def, level)
	local tpl = newTemplate("FoodMachine")
	local m = tpl.Model
	local gold = level >= 5
	local band = gold and K.Gold or K.IronDark
	local hw = ({ 2.6, 2.8, 3.0, 3.2, 3.4 })[level] or 3.4
	local top = ({ 4.2, 4.4, 4.6, 4.8, 5.0 })[level] or 5.0
	local z0, z1 = -1.6, 2.2
	local zc = (z0 + z1) / 2
	local dz = z1 - z0
	Kit.p(m, "Plinth", CFrame.new(0, 0.25, zc - 0.6), Vector3.new(2 * hw + 1.4, 0.5, dz + 2.6), K.SlateDark, M.Slate, true)
	local body = Kit.p(m, "Cabinet", CFrame.new(0, 0.5 + (top - 0.5) / 2, zc), Vector3.new(2 * hw, top - 0.5, dz), rgb(240, 112, 104), M.Planks, true)
	Kit.corners(m, -hw + 0.2, hw - 0.2, z0 + 0.2, z1 - 0.2, 0.5, top - 0.5, rgb(118, 168, 236), M.Wood)
	for _, y in ipairs({ 1.3, top - 0.9 }) do
		Kit.p(m, "Band", CFrame.new(0, y, z0 - 0.04), Vector3.new(2 * hw + 0.1, 0.22, 0.1), band, M.Metal)
	end
	Kit.p(m, "Cornice", CFrame.new(0, top + 0.17, zc), Vector3.new(2 * hw + 0.5, 0.35, dz + 0.5), rgb(92, 150, 230), M.Wood, true)
	Kit.p(m, "Panel", CFrame.new(0, 0.5 + (top - 0.5) / 2, z0 - 0.02), Vector3.new(2 * hw - 0.9, top - 1.6, 0.06), K.Whitewash, M.Planks)
	-- the dispenser: a slate mouth, a two-step copper chute, the tray with a few berries
	Kit.p(m, "Mouth", CFrame.new(-0.6, 2.4, z0 - 0.06), Vector3.new(1.7, 1.4, 0.14), K.IronDark, M.Slate)
	Kit.p(m, "Chute", CFrame.new(-0.6, 2.0, z0 - 0.45) * CFrame.Angles(rad(-25), 0, 0), Vector3.new(1.2, 0.18, 1.0), K.Copper, M.Metal)
	Kit.p(m, "Tray", CFrame.new(-0.6, 0.75, z0 - 1.0), Vector3.new(2.2, 0.3, 1.3), K.Iron, M.Metal, true)
	Kit.p(m, "TrayBerries", CFrame.new(-0.6, 0.95, z0 - 1.0), Vector3.new(1.6, 0.12, 0.8), K.BerryRed, M.Plastic)
	-- the FEED button (the one accent: berry red)
	Kit.cylAt(m, "ButtonRim", CFrame.new(hw - 1.0, 2.6, z0 - 0.06) * CFrame.Angles(0, PI / 2, 0), 0.12, 1.3, gold and K.Gold or K.Iron, M.Metal)
	Kit.cylAt(m, "Button", CFrame.new(hw - 1.0, 2.6, z0 - 0.16) * CFrame.Angles(0, PI / 2, 0), 0.14, 0.85, rgb(232, 64, 80), M.Neon)
	-- the hopper: a copper funnel, the glass Hopper (one part) with berry layers inside, a wooden lid with a knob
	local gw = (level >= 3) and 2.8 or 2.4
	local gh = 2.0 + 0.2 * level
	local gy0 = top + 0.35 + 0.5
	Kit.cyl(m, "Funnel", 0, top + 0.35, zc, 1.5, 0.5, K.Copper, M.Metal)
	local hopper = Kit.p(m, "Hopper", CFrame.new(0, gy0 + gh / 2, zc), Vector3.new(gw, gh, gw), rgb(214, 234, 246), M.Glass, false, { Transparency = 0.55 })
	hopper.CastShadow = false
	Kit.p(m, "HopperBerries", CFrame.new(0, gy0 + 0.4, zc), Vector3.new(gw - 0.3, 0.8, gw - 0.3), K.BerryRed, M.Plastic)
	Kit.p(m, "HopperBerries", CFrame.new(0, gy0 + 1.05, zc), Vector3.new(gw - 0.3, 0.5, gw - 0.3), K.BerryBlue, M.Plastic)
	Kit.p(m, "Lid", CFrame.new(0, gy0 + gh + 0.15, zc), Vector3.new(gw + 0.4, 0.3, gw + 0.4), rgb(92, 150, 230), M.Wood)
	for _, cx in ipairs({ -1, 1 }) do
		for _, cz2 in ipairs({ -1, 1 }) do
			Kit.p(m, "HopperRod", CFrame.new(cx * gw / 2, gy0 + gh / 2, zc + cz2 * gw / 2), Vector3.new(0.16, gh, 0.16), band, M.Metal)
		end
	end
	Kit.p(m, "Knob", CFrame.new(0, gy0 + gh + 0.45, zc), Vector3.new(0.5, 0.3, 0.5), gold and K.Gold or K.Copper, M.Metal)
	-- the Berry Basket on the plinth at the front right
	local bx = hw + 0.05
	Kit.cyl(m, "Basket", bx, 0.5, z0 - 1.05, 1.5, 0.75, K.PlanksLight, M.Planks)
	Kit.ball(m, "BasketBerries", Vector3.new(bx, 1.2, z0 - 1.05), 1.15, K.BerryRed2, M.Plastic)
	tpl.Points.BasketTop = Vector3.new(bx, 1.6, z0 - 1.05)
	local d = Kit.detail(m, "MachineDecor")
	if level >= 2 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.lantern(d, Vector3.new(sx * (hw + 0.1), top - 0.4, z0 - 0.35), 0.45, sx > 0)
		end
	end
	if level >= 3 then
		-- a berry press barrel on the left with a crank
		local px = -hw - 1.25
		Kit.cyl(m, "PressBarrel", px, 0.5, zc, 1.8, 1.9, K.Wood, M.Wood, true)
		Kit.cyl(m, "Hoop", px, 0.85, zc, 1.88, 0.18, band, M.Metal)
		Kit.cyl(m, "Hoop", px, 1.95, zc, 1.88, 0.18, band, M.Metal)
		Kit.p(m, "Crank", CFrame.new(px, 2.75, zc), Vector3.new(0.25, 0.9, 0.25), K.Iron, M.Metal)
		Kit.p(m, "PressPipe", CFrame.new((px - hw) / 2 + 0.2, 2.2, zc), Vector3.new(abs(px + hw) + 0.4, 0.35, 0.35), K.Copper, M.Metal)
	end
	if level >= 4 then
		-- a shelf of bowls on the right side
		local sx = hw + 1.0
		Kit.p(m, "Shelf", CFrame.new(sx, 1.4, zc + 0.6), Vector3.new(1.4, 1.8, 1.6), K.PlanksDark, M.Planks, true)
		local bowls = { K.BerryRed2, K.BerryBlue2, K.BerryGold }
		for i, c in ipairs(bowls) do
			Kit.cyl(d, "Bowl", sx, 2.3 + (i - 1) * 0.28, zc + 0.6, 1.2 - 0.12 * i, 0.26, c, M.Plastic)
		end
	end
	if gold then
		Kit.p(m, "Bell", CFrame.new(0, gy0 + gh + 0.95, zc), Vector3.new(0.7, 0.7, 0.7), K.GoldBright, M.Metal)
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		att.CFrame = body.CFrame:Inverse() * CFrame.new(0, gy0 + gh + 1.2, zc)
		att.Parent = body
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	-- the machine's sign (World text rule); HomeFx rewrites BasketLine for the owner
	Kit.sign(body, "MachineSign", (gy0 + gh + 1.6) - (0.5 + (top - 0.5) / 2), "Food Machine", {
		{ Name = "Info", Text = "Berries -> XP: press E", Color = C.TextGreen },
		{ Name = "BasketLine", Text = "Berry Basket", Color = C.TextGold },
	}, 60, C.CashGlow)
	tpl.Points.ChuteMouth = Vector3.new(-0.6, 2.0, z0 - 0.5)
	tpl.Points.Tray = Vector3.new(-0.6, 1.0, z0 - 1.0)
	tpl.Points.HopperTop = Vector3.new(0, gy0 + gh, zc)
	return tpl
end

----------------------------------------------------------------------
-- Training Place (Gym; its slot swapped with the Food Machine): front -Z, open toward the yard. A plank deck on a
-- slate plinth that grows from the left edge; one fabric mat per level at Slot.Spots (Attachments Spot1..5 on the
-- deck, attribute Slot; HomeFx puts the training pet and its skill prop on it) and behind each mat its skill corner:
-- a barbell rack (Physique, 1), two hurdles (Attack Speed, 2), a marble pedestal with a glowing orb (Ability, 3), a
-- shield wall (Defense, 4) and a scoreboard with a trophy (5). Pennant posts from 3. <= 90 parts.
----------------------------------------------------------------------
local TRAIN_MATS = { rgb(236, 92, 96), rgb(250, 204, 72), rgb(176, 120, 236), rgb(84, 140, 226), rgb(110, 200, 120) }

function Art.Training(def, level)
	local tpl = newTemplate("Training")
	local m = tpl.Model
	local fp = (def.Slot and def.Slot.Footprint) or Vector3.new(18, 10, 9)
	local hz = fp.Z / 2
	local spots = (def.Slot and def.Slot.Spots) or {}
	local w = ({ 9, 12, 15, 18, 18 })[level] or 18
	local x0 = -fp.X / 2
	local x1 = x0 + w
	local cx = (x0 + x1) / 2
	local gold = level >= 5
	local deckTop = 0.8
	Kit.p(m, "Plinth", CFrame.new(cx, 0.22, 0), Vector3.new(w, 0.44, fp.Z), K.SlateDark, M.Slate, true)
	local deck = Kit.p(m, "Deck", CFrame.new(cx, 0.44 + (deckTop - 0.44) / 2, 0.15), Vector3.new(w - 0.5, deckTop - 0.44, fp.Z - 0.8), K.Planks, M.Planks, true)
	Kit.p(m, "Kerb", CFrame.new(cx, 0.6, -hz + 0.2), Vector3.new(w, 0.32, 0.4), gold and K.Gold or K.Brick, gold and M.Metal or M.Brick, true)
	Kit.p(m, "BackRail", CFrame.new(cx, deckTop + 0.5, hz - 0.15), Vector3.new(w - 0.2, 1.0, 0.3), K.PlanksDark, M.Planks, true)
	local bz = 2.6 -- the skill corners stand behind the mats
	local function spotX(i)
		local p = spots[i]
		return (typeof(p) == "Vector3") and p.X or (x0 + 3 * i)
	end
	local y = deckTop
	-- 1 Physique: a barbell on a rack
	do
		local x = spotX(1)
		Kit.p(m, "Rack", CFrame.new(x, y + 0.4, bz), Vector3.new(2.6, 0.8, 1.0), K.IronDark, M.Metal, true)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "RackPost", CFrame.new(x + sx * 1.0, y + 1.35, bz), Vector3.new(0.25, 1.1, 0.25), K.Iron, M.Metal)
			Kit.cylAt(m, "Weight", CFrame.new(x + sx * 1.55, y + 1.9, bz), 0.3, 1.2, K.IronDark, M.Metal)
		end
		Kit.cylAt(m, "Bar", CFrame.new(x, y + 1.9, bz), 3.6, 0.2, K.Iron, M.Metal)
	end
	-- 2 Attack Speed: two hurdles with striped bars
	if level >= 2 then
		local x = spotX(2)
		for _, hx in ipairs({ x - 0.8, x + 0.8 }) do
			for _, lz in ipairs({ bz - 0.9, bz + 0.9 }) do
				Kit.p(m, "HurdleLeg", CFrame.new(hx, y + 0.65, lz), Vector3.new(0.2, 1.3, 0.2), K.Whitewash, M.Wood)
			end
			Kit.p(m, "Hurdle", CFrame.new(hx, y + 1.2, bz), Vector3.new(0.25, 0.3, 2.0), rgb(236, 86, 86), M.Wood)
		end
	end
	-- 3 Ability: a marble pedestal with a glowing orb
	if level >= 3 then
		local x = spotX(3)
		Kit.p(m, "Pedestal", CFrame.new(x, y + 0.2, bz), Vector3.new(1.6, 0.4, 1.6), K.MarbleShade, M.Marble, true)
		Kit.cyl(m, "Pedestal", x, y + 0.4, bz, 0.9, 1.4, K.Marble, M.Marble, true)
		Kit.p(m, "Pedestal", CFrame.new(x, y + 1.95, bz), Vector3.new(1.3, 0.3, 1.3), gold and K.Gold or K.MarbleShade, gold and M.Metal or M.Marble)
		Kit.ball(m, "Orb", Vector3.new(x, y + 2.75, bz), 1.2, rgb(176, 130, 255), M.Neon)
	end
	-- 4 Defense: a plank wall with a round shield
	if level >= 4 then
		local x = spotX(4)
		Kit.p(m, "ShieldWall", CFrame.new(x, y + 1.8, hz - 0.9), Vector3.new(2.8, 3.6, 0.4), K.PlanksDark, M.Planks, true)
		Kit.p(m, "ShieldWallCap", CFrame.new(x, y + 3.75, hz - 0.9), Vector3.new(3.2, 0.3, 0.7), K.WoodDark, M.Wood)
		Kit.cylAt(m, "Shield", CFrame.new(x, y + 1.9, hz - 1.18) * CFrame.Angles(0, PI / 2, 0), 0.16, 2.2, rgb(84, 140, 226), M.Metal)
		Kit.cylAt(m, "ShieldBoss", CFrame.new(x, y + 1.9, hz - 1.3) * CFrame.Angles(0, PI / 2, 0), 0.14, 0.7, gold and K.Gold or K.Iron, M.Metal)
	end
	-- 5: a scoreboard with three lights and a trophy on a little stand
	if gold then
		local x = spotX(5)
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "BoardPost", CFrame.new(x + sx * 1.8, y + 2.4, hz - 0.8), Vector3.new(0.35, 4.8, 0.35), K.WoodDark, M.Wood)
		end
		Kit.p(m, "Board", CFrame.new(x, y + 4.0, hz - 0.8), Vector3.new(3.4, 1.6, 0.3), K.SlateDark, M.Slate)
		local lights = { rgb(120, 220, 130), rgb(250, 214, 90), rgb(255, 120, 110) }
		for i, c in ipairs(lights) do
			Kit.p(m, "BoardLight", CFrame.new(x - 1.6 + 0.8 * i, y + 4.0, hz - 1.0), Vector3.new(0.5, 0.5, 0.12), c, M.Neon)
		end
		Kit.p(m, "TrophyStand", CFrame.new(x, y + 0.5, bz), Vector3.new(1.0, 1.0, 1.0), K.MarbleShade, M.Marble, true)
		Kit.cyl(m, "Trophy", x, y + 1.0, bz, 0.5, 0.6, K.GoldBright, M.Metal)
		Kit.cyl(m, "Trophy", x, y + 1.6, bz, 1.0, 0.55, K.GoldBright, M.Metal)
	end
	-- pennant posts at the deck's back corners (3+)
	if level >= 3 then
		local d = Kit.detail(m, "Pennants")
		for _, px in ipairs({ x0 + 0.4, x1 - 0.4 }) do
			Kit.p(d, "PennantPost", CFrame.new(px, y + 2.6, hz - 0.4), Vector3.new(0.3, 5.2, 0.3), gold and K.Gold or K.WoodDark, gold and M.Metal or M.Wood)
			local fx = (px < cx) and (px + 0.85) or (px - 0.85)
			Kit.p(d, "Pennant", CFrame.new(fx, y + 4.6, hz - 0.4), Vector3.new(1.4, 0.9, 0.06), rgb(236, 86, 86), M.Fabric)
		end
	end
	-- the training mats (one per level) and their Spot<i> attachments on the deck
	for i, p in ipairs(spots) do
		if i <= level then
			Kit.p(m, "Mat", CFrame.new(p.X, y + 0.05, p.Z), Vector3.new(2.6, 0.1, 2.6), Kit.jit(TRAIN_MATS[i] or TRAIN_MATS[1], i), M.Fabric)
			Kit.p(m, "MatIn", CFrame.new(p.X, y + 0.11, p.Z), Vector3.new(1.5, 0.04, 1.5), K.Whitewash, M.Fabric)
			attach(deck, "Spot" .. i, Vector3.new(p.X, y + 0.15, p.Z), { Slot = i })
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Vault: front -Z. A chamfered slate strongroom on a plinth with a marble cornice and a round metal door (1),
-- marble pilasters and a brass band (2), a glass gem case on top (3), coin stacks and sconces (4), a gold crown (5).
-- <= 80 parts.
----------------------------------------------------------------------
function Art.Vault(def, level)
	local tpl = newTemplate("Vault")
	local m = tpl.Model
	local w, d, h = 5.6, 6.0, 4.4
	Kit.p(m, "Plinth", CFrame.new(0, 0.3, 0), Vector3.new(w + 1.0, 0.6, d + 1.0), K.SlateDark, M.Slate, true)
	Kit.p(m, "Step", CFrame.new(0, 0.15, -d / 2 - 1.0), Vector3.new(3.2, 0.3, 1.2), K.Slate, M.Slate, true)
	Kit.p(m, "Vault", CFrame.new(0, 0.6 + h / 2, 0), Vector3.new(w, h, d), rgb(218, 212, 200), M.Slate, true)
	Kit.p(m, "Cornice", CFrame.new(0, 0.6 + h + 0.12, 0), Vector3.new(w + 0.6, 0.24, d + 0.6), rgb(100, 122, 170), M.Marble, true)
	Kit.p(m, "Roof", CFrame.new(0, 0.6 + h + 0.32, 0), Vector3.new(w - 0.4, 0.16, d - 0.4), rgb(84, 104, 150), M.Slate)
	for _, y in ipairs({ 1.55, 3.95 }) do
		Kit.p(m, "Course", CFrame.new(0, y, 0), Vector3.new(w + 0.12, 0.16, d - 1.2), K.SlateLight, M.Slate)
		Kit.p(m, "Course", CFrame.new(0, y, 0), Vector3.new(w - 1.2, 0.16, d + 0.12), K.SlateLight, M.Slate)
	end
	Kit.p(m, "Keystone", CFrame.new(0, 4.55, -d / 2 - 0.1), Vector3.new(0.9, 0.7, 0.2), K.MarbleShade, M.Marble)
	-- the round door: a metal disc, a hub, a three-spoke wheel
	local dz = -d / 2 - 0.08
	Kit.cylAt(m, "Door", CFrame.new(0, 2.6, dz) * CFrame.Angles(0, PI / 2, 0), 0.18, 3.0, K.Iron, M.Metal)
	Kit.cylAt(m, "DoorRing", CFrame.new(0, 2.6, dz - 0.1) * CFrame.Angles(0, PI / 2, 0), 0.06, 2.5, K.IronDark, M.Metal)
	Kit.cylAt(m, "Hub", CFrame.new(0, 2.6, dz - 0.18) * CFrame.Angles(0, PI / 2, 0), 0.16, 0.7, K.Gold, M.Metal)
	for k = 0, 2 do
		Kit.p(m, "Spoke", CFrame.new(0, 2.6, dz - 0.2) * CFrame.Angles(0, 0, rad(k * 60)), Vector3.new(1.9, 0.14, 0.08), K.Gold, M.Metal)
	end
	if level >= 2 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "Pilaster", CFrame.new(sx * 2.15, 0.6 + h / 2, -d / 2 - 0.15), Vector3.new(0.6, h, 0.3), K.MarbleShade, M.Marble)
		end
		Kit.p(m, "Band", CFrame.new(0, 0.6 + h - 0.35, -d / 2 - 0.12), Vector3.new(w - 1.4, 0.25, 0.1), K.Gold, M.Metal)
	end
	local topY = 0.6 + h + 0.4
	if level >= 3 then
		-- a glass gem case on the roof
		Kit.p(m, "CaseBase", CFrame.new(0, topY + 0.2, 0), Vector3.new(2.6, 0.4, 2.6), K.MarbleShade, M.Marble)
		Kit.p(m, "GemCase", CFrame.new(0, topY + 1.3, 0), Vector3.new(2.2, 1.8, 2.2), rgb(214, 234, 246), M.Glass, false, { Transparency = 0.6 })
		Kit.p(m, "CaseLid", CFrame.new(0, topY + 2.3, 0), Vector3.new(2.6, 0.2, 2.6), K.Gold, M.Metal)
		local gems = { { -0.45, rgb(120, 220, 255) }, { 0.5, rgb(255, 130, 190) }, { 0.0, rgb(140, 240, 160) } }
		for i, g in ipairs(gems) do
			Kit.p(m, "Gem", CFrame.new(g[1], topY + 0.75 + 0.15 * i, (i - 2) * 0.3) * CFrame.Angles(rad(45), rad(35), 0), Vector3.new(0.55, 0.55, 0.55), g[2], M.Neon)
		end
	end
	if level >= 4 then
		local deco = Kit.detail(m, "VaultDecor")
		for _, sx in ipairs({ -1, 1 }) do
			Kit.cyl(deco, "Coins", sx * 2.4, 0.6, -d / 2 - 0.9, 0.9, 0.5 + 0.15 * (sx + 1), K.GoldBright, M.Metal)
			Kit.lantern(deco, Vector3.new(sx * 2.15, 3.9, -d / 2 - 0.55), 0.42, sx > 0)
		end
	end
	if level >= 5 then
		local cy = topY + ((level >= 3) and 2.4 or 0)
		Kit.cyl(m, "Crown", 0, cy, 0, 1.8, 0.4, K.GoldBright, M.Metal)
		for k = 0, 3 do
			local a = k * PI / 2 + PI / 4
			Kit.p(m, "CrownPoint", CFrame.new(math.cos(a) * 0.65, cy + 0.65, math.sin(a) * 0.65) * CFrame.Angles(0, -a, 0), Vector3.new(0.3, 0.6, 0.3), K.GoldBright, M.Metal)
		end
		local att = Instance.new("Attachment")
		att.Name = "Sparkle"
		local anchor = biggestPart(m, "Cornice") or biggestPart(m)
		att.CFrame = anchor.CFrame:Inverse() * CFrame.new(0, cy + 1.0, 0)
		att.Parent = anchor
		emitter(att, { Color = ColorSequence.new(C.TextGold), Rate = 3, SpreadAngle = Vector2.new(180, 180) })
	end
	return tpl
end

----------------------------------------------------------------------
-- Fusion Machine: front -Z. A slate-and-marble dais with a neon inlay line, two glass input pods on metal pedestals
-- (cyan left, magenta right) piped into the marble-ringed glass chamber where the `Swirl` (a Model HomeFx spins: two
-- cloud puffs around a glowing heart) turns, and a small output pod in front. Brass trims and lamps (2), crystal
-- shards and sparkles (3). `FusionPrompt` ("Fuse", owner only) on PromptPoint, SwirlCenter, ChamberLight. <= 90.
----------------------------------------------------------------------
function Art.Fusion(def, level)
	local tpl = newTemplate("FusionMachine")
	local m = tpl.Model
	local gold = level >= 2
	local trim = gold and K.Gold or K.Iron
	local cz = 1.0
	local violet = rgb(170, 118, 255)
	Kit.oct(m, "Base", 0, 0, 0.5, 9.4, 0.5, rgb(84, 72, 160), M.Slate, true)
	local deckA = Kit.oct(m, "Deck", 0, 0.5, 0.5, 8.4, 0.45, rgb(150, 128, 226), M.Marble, true)
	deckA.Name = "Deck"
	Kit.oct(m, "Inlay", 0, 0.62, 0.5, 8.6, 0.08, violet, M.Neon)
	Kit.p(m, "Step", CFrame.new(0, 0.25, -4.7), Vector3.new(3.0, 0.5, 1.2), K.Slate, M.Slate, true)
	Kit.p(m, "StepInlay", CFrame.new(0, 0.52, -4.7), Vector3.new(2.0, 0.04, 0.3), violet, M.Neon)
	-- the input pods
	for _, sx in ipairs({ -1, 1 }) do
		local px = sx * 3.0
		local glow = (sx < 0) and rgb(110, 230, 240) or rgb(240, 120, 210)
		Kit.cyl(m, "PodBase", px, 0.95, cz, 1.9, 0.6, trim, M.Metal, true)
		Kit.cyl(m, "Pod", px, 1.55, cz, 1.5, 2.6, rgb(214, 234, 246), M.Glass).Transparency = 0.55
		Kit.cyl(m, "PodCore", px, 1.75, cz, 0.6, 1.6, glow, M.Neon)
		Kit.cyl(m, "PodLid", px, 4.15, cz, 1.9, 0.45, trim, M.Metal)
		-- a pipe from the lid into the chamber
		Kit.cylAt(m, "Pipe", CFrame.new(px * 0.62, 4.75, cz), abs(px) * 0.75, 0.4, K.Copper, M.Metal)
		Kit.p(m, "PipeElbow", CFrame.new(px, 4.55, cz), Vector3.new(0.45, 0.6, 0.45), K.Copper, M.Metal)
	end
	-- the chamber: a marble base ring and crown ring around a glass column, neon inlay bands and three marble ribs
	Kit.cyl(m, "ChamberBase", 0, 0.95, cz, 3.4, 0.7, K.Marble, M.Marble, true)
	Kit.cyl(m, "Chamber", 0, 1.65, cz, 2.8, 5.0, rgb(214, 226, 246), M.Glass).Transparency = 0.6
	Kit.cyl(m, "ChamberCrown", 0, 6.65, cz, 3.4, 0.7, K.Marble, M.Marble)
	Kit.cyl(m, "ChamberInlay", 0, 1.6, cz, 3.45, 0.12, violet, M.Neon)
	Kit.cyl(m, "ChamberInlay", 0, 6.6, cz, 3.45, 0.12, violet, M.Neon)
	for k = 0, 2 do
		local a = rad(90 + k * 120)
		Kit.p(m, "Rib", CFrame.new(math.cos(a) * 1.5, 4.15, cz + math.sin(a) * 1.5) * CFrame.Angles(0, -a, 0), Vector3.new(0.35, 5.0, 0.35), K.MarbleShade, M.Marble)
	end
	Kit.cyl(m, "ChamberCap", 0, 7.35, cz, 1.6, 0.5, trim, M.Metal)
	local crystalColor = (level >= 3) and rgb(255, 226, 150) or rgb(200, 170, 255)
	Kit.p(m, "Crystal", CFrame.new(0, 8.3, cz) * CFrame.Angles(rad(45), rad(45), 0), Vector3.new(0.7, 0.7, 0.7), crystalColor, M.Neon)
	-- the output pod in front
	Kit.cyl(m, "OutputBase", 0, 0.95, -2.6, 1.6, 0.5, trim, M.Metal, true)
	Kit.ball(m, "OutputDome", Vector3.new(0, 1.55, -2.6), 1.3, rgb(214, 234, 246), M.Glass).Transparency = 0.5
	if gold then
		local deco = Kit.detail(m, "FusionDecor")
		for _, sx in ipairs({ -1, 1 }) do
			Kit.lantern(deco, Vector3.new(sx * 3.6, 1.35, -3.0), 0.4, false)
		end
	end
	if level >= 3 then
		for _, sx in ipairs({ -1, 1 }) do
			Kit.p(m, "Shard", CFrame.new(sx * 3.4, 1.9, 3.6) * CFrame.Angles(0, rad(45), rad(sx * 12)), Vector3.new(0.6, 1.8, 0.6), rgb(150, 230, 255), M.Neon)
		end
	end
	-- the swirl (HomeFx spins it): two cloud puffs on a rising spiral around a glowing heart (voxel-cloud palette)
	local swirl = Instance.new("Model")
	swirl.Name = "Swirl"
	CollectionService:AddTag(swirl, EXEMPT_TAG)
	Kit.ball(swirl, "Cloud", Vector3.new(0.7, 3.2, cz), 1.3, K.CloudTop, M.Plastic)
	Kit.ball(swirl, "Cloud", Vector3.new(-0.7, 4.9, cz), 1.2, K.CloudSide, M.Plastic)
	Kit.p(swirl, "Heart", CFrame.new(0, 4.0, cz), Vector3.new(0.5, 2.4, 0.5), (level >= 3) and rgb(255, 230, 160) or rgb(214, 176, 255), M.Neon, false, { Transparency = 0.15 })
	swirl.Parent = m
	tpl.Points.SwirlCenter = Vector3.new(0, 4.1, cz)
	local prompt = newPrompt("FusionPrompt", "Fuse", "Fusion Machine", "FusionMachine")
	local deck = biggestPart(m, "Deck") or biggestPart(m)
	if deck then
		local att = attach(deck, "PromptPoint", Vector3.new(0, 2.5, -3.0))
		prompt.Parent = att
		local light = attach(deck, "ChamberLight", Vector3.new(0, 4.0, cz))
		pointLight(light, rgb(186, 120, 255), 1.2, 16)
		if level >= 3 then
			emitter(light, { Color = ColorSequence.new(rgb(214, 180, 255), C.TextGold), Rate = 4, SpreadAngle = Vector2.new(180, 180) })
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Arena Gate (Kind Arena): front -Z. The P4 home Arena Gate (7aa0df2 Art.Arena): two square stone pillars on
-- plinths, a stone lintel with a red shield crest and crossed swords, a violet neon inlay around the opening, the
-- violet portal + a ForceField shimmer, braziers on top and red banners. `ArenaGatePrompt` ("Go to Arena", owner
-- only, attributes StationId / Teleport = "Arena"; ArenaBuilder teleports). <= 80 parts.
----------------------------------------------------------------------
function Art.ArenaGate(def, level)
	local tpl = newTemplate("ArenaGate")
	local m = tpl.Model
	local accent = rgb(140, 96, 220) -- the P4 home Arena Gate: a violet portal under a red shield
	local cx = 2.55 -- column centres at +-cx
	local colH = 7.4
	for _, sx in ipairs({ -1, 1 }) do
		local x = sx * cx
		Kit.p(m, "Plinth", CFrame.new(x, 0.45, 0), Vector3.new(1.9, 0.9, 1.9), K.SlateDark, M.Slate, true)
		Kit.p(m, "PlinthBand", CFrame.new(x, 0.95, 0), Vector3.new(2.05, 0.15, 2.05), K.MarbleShade, M.Marble)
		Kit.cyl(m, "Column", x, 1.0, 0, 1.35, colH, K.Marble, M.Marble, true)
		Kit.p(m, "Capital", CFrame.new(x, 1.0 + colH + 0.25, 0), Vector3.new(1.8, 0.5, 1.8), K.MarbleShade, M.Marble)
		Kit.p(m, "Banner", CFrame.new(x, 5.0, -0.72), Vector3.new(0.9, 3.4, 0.06), rgb(214, 70, 74), M.Fabric)
		Kit.p(m, "Brazier", CFrame.new(x, 11.05, 0), Vector3.new(0.9, 0.5, 0.9), K.IronDark, M.Metal)
		local fire = Kit.p(m, "Fire", CFrame.new(x, 11.55, 0), Vector3.new(0.55, 0.6, 0.55), rgb(255, 170, 80), M.Neon)
		if sx > 0 then
			pointLight(fire, LANTERN, 1.2, 12)
		end
	end
	local ly = 1.0 + colH + 0.5
	Kit.p(m, "Lintel", CFrame.new(0, ly + 0.7, 0), Vector3.new(6.9, 1.4, 2.0), K.Slate, M.Slate, true)
	Kit.p(m, "Cornice", CFrame.new(0, ly + 1.55, 0), Vector3.new(7.0, 0.3, 2.3), K.MarbleShade, M.Marble)
	Kit.cylAt(m, "Medallion", CFrame.new(0, ly + 0.7, -1.05) * CFrame.Angles(0, PI / 2, 0), 0.2, 1.7, rgb(196, 58, 66), M.Marble)
	for _, sx in ipairs({ -1, 1 }) do
		local cf = CFrame.new(0, ly + 0.7, -1.2) * CFrame.Angles(0, 0, rad(sx * 40))
		Kit.p(m, "Sword", cf, Vector3.new(0.22, 1.7, 0.06), rgb(214, 222, 236), M.Metal)
		Kit.p(m, "Hilt", cf * CFrame.new(0, -0.7, 0), Vector3.new(0.7, 0.16, 0.08), K.GoldBright, M.Metal)
	end
	-- the opening: a neon inlay frame, the red disc and the ForceField shimmer (non-solid)
	local ow, oh = 3.5, colH
	Kit.p(m, "Inlay", CFrame.new(-ow / 2 - 0.12, 1.0 + oh / 2, -0.35), Vector3.new(0.18, oh, 0.18), accent, M.Neon)
	Kit.p(m, "Inlay", CFrame.new(ow / 2 + 0.12, 1.0 + oh / 2, -0.35), Vector3.new(0.18, oh, 0.18), accent, M.Neon)
	Kit.p(m, "Inlay", CFrame.new(0, ly - 0.05, -0.35), Vector3.new(ow + 0.42, 0.18, 0.18), accent, M.Neon)
	Kit.p(m, "Portal", CFrame.new(0, 1.0 + oh / 2, 0), Vector3.new(ow, oh, 0.12), accent, M.Neon, false, { Transparency = 0.35 })
	Kit.p(m, "Shimmer", CFrame.new(0, 1.0 + oh / 2, -0.1), Vector3.new(ow, oh, 0.05), rgb(206, 180, 255), M.Force, false, { Transparency = 0.2 })
	Kit.p(m, "Threshold", CFrame.new(0, 0.3, 0), Vector3.new(ow + 0.6, 0.6, 2.6), K.Slate, M.Slate, true)
	local prompt = newPrompt("ArenaGatePrompt", "Go to Arena", "Arena Gate", "ArenaGate")
	prompt:SetAttribute("Teleport", "Arena")
	local portal = biggestPart(m, "Portal") or biggestPart(m)
	if portal then
		prompt.Parent = attach(portal, "PromptPoint", Vector3.new(0, 3.0, -1.5))
	end
	return tpl
end
----------------------------------------------------------------------
-- House (4 tiers; Phase 6 A1 = the P4 colours): front -Z toward the gate (the HouseWalk ends at local z -10). Stone
-- plinths, walls with corner posts, stepped voxel roofs, glass windows, warm lanterns. Cottage (cream walls, a
-- terracotta roof, a chimney), Villa (two storeys: peach below, cream above, a porch, a cross gable, terracotta
-- roofs), Manor (a lavender-white hall with two wings, slate-blue roofs, a white portico), Sky Castle (a white keep,
-- four square towers with blue stepped spires and gold tips, pink banners, a rose window). <= 150 parts.
----------------------------------------------------------------------
local House = {}

-- a walled block: a plinth band, the walls (centre cx, cz; w x d; from y0, h tall) and its four corner posts
function House.block(m, name, cx, cz, w, d, y0, h, color, mat, postColor)
	Kit.p(m, name, CFrame.new(cx, y0 + h / 2, cz), Vector3.new(w, h, d), color, mat, true)
	Kit.corners(m, cx - w / 2 + 0.15, cx + w / 2 - 0.15, cz - d / 2 + 0.15, cz + d / 2 - 0.15, y0, h, postColor or K.WoodDark, M.Wood)
end

-- a row of windows on the front wall (z = the wall's front face)
function House.windows(m, xs, y, z, w, h, frame)
	for _, x in ipairs(xs) do
		Kit.window(m, CFrame.new(x, y, z), w, h, frame)
	end
end

function House.door(m, x, y0, z, w, h, frame)
	Kit.p(m, "DoorFrame", CFrame.new(x, y0 + (h + 0.3) / 2, z - 0.06), Vector3.new(w + 0.5, h + 0.3, 0.12), frame or K.Whitewash, M.Wood)
	Kit.p(m, "Door", CFrame.new(x, y0 + h / 2, z - 0.14), Vector3.new(w, h, 0.1), K.WoodDark, M.Wood)
end

function House.chimney(m, x, z, y0, h)
	Kit.p(m, "Chimney", CFrame.new(x, y0 + h / 2, z), Vector3.new(1.3, h, 1.3), K.Brick, M.Brick, true)
	Kit.p(m, "ChimneyCap", CFrame.new(x, y0 + h + 0.15, z), Vector3.new(1.6, 0.3, 1.6), K.SlateDark, M.Slate)
end

function House.cottage(m)
	Kit.p(m, "Plinth", CFrame.new(0, 0.35, 0), Vector3.new(13.2, 0.7, 9.2), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0, 12, 8, 0.7, 4.6, K.Cream, M.Planks, K.Wood)
	Kit.gable(m, "Roof", CFrame.new(0, 5.3, 0), 12, 8, 3.4, K.Roof, M.Clay, { Overhang = 0.8, Ridge = K.RoofDark, Dark = K.RoofDark })
	House.door(m, 0, 0.7, -4, 1.8, 3.0)
	House.windows(m, { -3.6, 3.6 }, 2.9, -4, 1.8, 1.5)
	Kit.window(m, CFrame.new(6, 2.9, 0) * CFrame.Angles(0, -PI / 2, 0), 1.6, 1.4)
	House.chimney(m, 3.8, 1.6, 6.0, 3.6)
	Kit.p(m, "Step", CFrame.new(0, 0.2, -5.2), Vector3.new(3.0, 0.4, 1.4), K.Slate, M.Slate, true)
	local d = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -1.6, 1.6 }) do
		Kit.lantern(d, Vector3.new(x, 3.2, -4.35), 0.45, x > 0)
	end
	for _, x in ipairs({ -3.6, 3.6 }) do
		Kit.p(d, "FlowerBox", CFrame.new(x, 1.75, -4.35), Vector3.new(1.9, 0.4, 0.5), K.PlanksDark, M.Planks)
		Kit.p(d, "Flowers", CFrame.new(x, 2.05, -4.35), Vector3.new(1.7, 0.25, 0.4), rgb(246, 150, 188), M.Leafy)
	end
	return 9.6
end

function House.villa(m)
	local w, d = 18, 11
	Kit.p(m, "Plinth", CFrame.new(0, 0.35, 0.5), Vector3.new(w + 1.2, 0.7, d + 1.2), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0.5, w, d, 0.7, 4.4, K.Brick, M.Brick, K.Whitewash)
	Kit.p(m, "Band", CFrame.new(0, 5.25, 0.5), Vector3.new(w + 0.4, 0.3, d + 0.4), K.SlateLight, M.Slate)
	House.block(m, "Upper", 0, 0.5, w - 0.4, d - 0.4, 5.4, 3.8, K.Cream, M.Planks, K.Whitewash)
	Kit.gable(m, "Roof", CFrame.new(0, 9.2, 0.5), w - 0.4, d - 0.4, 4.2, K.Roof, M.Clay, { Overhang = 0.9, Ridge = K.RoofDark, Dark = K.RoofDark })
	-- the cross gable over the entrance
	local fz = 0.5 - d / 2
	Kit.p(m, "Bay", CFrame.new(0, 7.3, fz - 0.6), Vector3.new(5.4, 3.8, 1.2), K.Cream, M.Planks, true)
	Kit.gable(m, "BayRoof", CFrame.new(0, 9.2, fz - 0.2) * CFrame.Angles(0, PI / 2, 0), 2.4, 5.4, 2.4, K.Roof, M.Clay, { Overhang = 0.5, Dark = K.RoofDark })
	House.door(m, 0, 0.7, fz, 2.4, 3.2)
	House.windows(m, { -6.4, -3.4, 3.4, 6.4 }, 2.9, fz, 1.6, 1.6)
	House.windows(m, { -6.4, -3.4, 3.4, 6.4 }, 7.2, fz + 0.2, 1.5, 1.5)
	Kit.window(m, CFrame.new(0, 7.4, fz - 1.2), 2.2, 1.6)
	-- the porch: a slate floor, two posts, a little roof
	Kit.p(m, "Porch", CFrame.new(0, 0.3, fz - 1.5), Vector3.new(5.4, 0.6, 3.0), K.Slate, M.Slate, true)
	for _, x in ipairs({ -2.4, 2.4 }) do
		Kit.p(m, "PorchPost", CFrame.new(x, 2.3, fz - 2.6), Vector3.new(0.4, 3.4, 0.4), K.Whitewash, M.Wood)
	end
	Kit.p(m, "PorchRoof", CFrame.new(0, 4.15, fz - 1.6) * CFrame.Angles(rad(12), 0, 0), Vector3.new(6.0, 0.3, 3.0), K.RoofDark, M.Clay)
	House.chimney(m, -5.6, 2.4, 9.6, 4.4)
	House.chimney(m, 5.6, 2.4, 9.6, 4.4)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -2.4, 2.4 }) do
		Kit.lantern(deco, Vector3.new(x, 3.4, fz - 0.4), 0.45, x > 0)
	end
	return 14
end

function House.manor(m)
	local cw, cd = 14, 12
	Kit.p(m, "Plinth", CFrame.new(0, 0.4, 0.5), Vector3.new(25.2, 0.8, cd + 1.4), K.SlateDark, M.Slate, true)
	House.block(m, "Walls", 0, 0.5, cw, cd, 0.8, 4.6, K.Manor, M.Brick, K.Whitewash)
	Kit.p(m, "Band", CFrame.new(0, 5.55, 0.5), Vector3.new(cw + 0.4, 0.3, cd + 0.4), K.Marble, M.Marble)
	House.block(m, "Upper", 0, 0.5, cw, cd, 5.7, 4.3, K.Manor, M.Brick, K.Whitewash)
	Kit.p(m, "Cornice", CFrame.new(0, 10.15, 0.5), Vector3.new(cw + 0.6, 0.3, cd + 0.6), K.Marble, M.Marble)
	Kit.gable(m, "Roof", CFrame.new(0, 10.3, 0.5), cw, cd, 5.6, K.Shingle, M.Clay, { Overhang = 0.8, Ridge = K.Gold, Dark = K.ShingleLight })
	-- the wings (their gables face the yard)
	for _, sx in ipairs({ -1, 1 }) do
		local wx = sx * 9.6
		House.block(m, "Wing", wx, 1.0, 5.0, 10, 0.8, 6.0, K.Manor, M.Brick, K.Whitewash)
		Kit.gable(m, "WingRoof", CFrame.new(wx, 6.8, 1.0) * CFrame.Angles(0, PI / 2, 0), 10, 5.0, 3.0, K.Shingle, M.Clay, { Overhang = 0.6, Dark = K.ShingleLight })
		Kit.window(m, CFrame.new(wx, 3.2, -4.0), 1.8, 2.0)
		Kit.window(m, CFrame.new(wx, 7.6, -4.15), 1.0, 1.0, nil, nil, { Sill = false })
	end
	local fz = 0.5 - cd / 2
	House.door(m, 0, 0.8, fz, 2.6, 3.4, K.Marble)
	House.windows(m, { -4.6, -2.3, 2.3, 4.6 }, 3.1, fz, 1.4, 1.9, K.Marble)
	House.windows(m, { -4.6, -2.3, 0, 2.3, 4.6 }, 7.8, fz, 1.4, 1.7, K.Marble)
	-- the marble portico: two columns, an entablature, a pediment, two steps
	for _, x in ipairs({ -2.2, 2.2 }) do
		Kit.cyl(m, "Column", x, 0.8, fz - 1.9, 0.75, 4.6, K.Marble, M.Marble, true)
	end
	Kit.p(m, "Entablature", CFrame.new(0, 5.65, fz - 1.1), Vector3.new(5.6, 0.5, 2.4), K.MarbleShade, M.Marble)
	Kit.gable(m, "Pediment", CFrame.new(0, 5.9, fz - 1.1) * CFrame.Angles(0, PI / 2, 0), 2.4, 5.6, 1.4, K.MarbleShade, M.Marble, { Overhang = 0.25, EndOverhang = 0.1, Dark = K.Marble })
	Kit.p(m, "Steps", CFrame.new(0, 0.5, fz - 1.5), Vector3.new(5.2, 1.0, 2.8), K.Slate, M.Slate, true)
	Kit.p(m, "Steps", CFrame.new(0, 0.2, fz - 3.2), Vector3.new(4.6, 0.4, 1.0), K.SlateLight, M.Slate, true)
	House.chimney(m, -4.2, 3.0, 11.0, 5.4)
	House.chimney(m, 4.2, 3.0, 11.0, 5.4)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -3.4, 3.4 }) do
		Kit.lantern(deco, Vector3.new(x, 3.6, fz - 0.35), 0.5, x > 0)
	end
	for _, sx in ipairs({ -1, 1 }) do
		Kit.lantern(deco, Vector3.new(sx * 9.6 + sx * 1.5, 3.4, -4.4), 0.45, false)
	end
	return 15
end

function House.castle(m)
	local hw, hd, hh = 16, 12, 9.0
	local cz = 0.5
	Kit.p(m, "Plinth", CFrame.new(0, 0.45, cz), Vector3.new(hw + 2.0, 0.9, hd + 1.6), K.SlateDark, M.Slate, true)
	House.block(m, "Keep", 0, cz, hw, hd, 0.9, hh, K.Marble, M.Marble, K.MarbleShade)
	Kit.p(m, "Band", CFrame.new(0, 5.2, cz), Vector3.new(hw + 0.3, 0.3, hd + 0.3), K.Gold, M.Slate)
	Kit.p(m, "Cornice", CFrame.new(0, 0.9 + hh + 0.2, cz), Vector3.new(hw + 0.6, 0.4, hd + 0.6), K.MarbleShade, M.Slate)
	-- battlements along the front and the back
	local fz = cz - hd / 2
	for k = 0, 5 do
		local x = -hw / 2 + 1.0 + k * (hw - 2.0) / 5
		for _, z in ipairs({ fz + 0.3, cz + hd / 2 - 0.3 }) do
			Kit.p(m, "Merlon", CFrame.new(x, 0.9 + hh + 0.95, z), Vector3.new(1.2, 1.1, 0.6), K.MarbleShade, M.Marble)
		end
	end
	-- the great door, the portcullis, the rose window
	Kit.p(m, "GateArch", CFrame.new(0, 2.9, fz - 0.1), Vector3.new(4.4, 4.6, 0.3), K.Gold, M.Slate)
	Kit.p(m, "Door", CFrame.new(0, 2.6, fz - 0.28), Vector3.new(3.2, 3.6, 0.12), K.WoodDark, M.Wood)
	Kit.p(m, "Portcullis", CFrame.new(0, 4.25, fz - 0.36), Vector3.new(3.2, 0.5, 0.1), K.Iron, M.Metal)
	Kit.cylAt(m, "RoseFrame", CFrame.new(0, 7.3, fz - 0.06) * CFrame.Angles(0, PI / 2, 0), 0.14, 2.9, K.SlateLight, M.Slate)
	Kit.cylAt(m, "RoseWindow", CFrame.new(0, 7.3, fz - 0.16) * CFrame.Angles(0, PI / 2, 0), 0.08, 2.3, rgb(220, 186, 240), M.Glass)
	House.windows(m, { -5.4, -2.8, 2.8, 5.4 }, 3.0, fz, 1.2, 2.0, K.MarbleShade)
	House.windows(m, { -5.4, -2.8, 2.8, 5.4 }, 7.4, fz, 1.2, 1.8, K.MarbleShade)
	-- the central tower behind the gate
	Kit.cyl(m, "Tower", 0, 0.9 + hh, cz + 1.5, 5.2, 6.0, K.Marble, M.Marble, true)
	Kit.cyl(m, "TowerBand", 0, 0.9 + hh + 6.0, cz + 1.5, 5.8, 0.45, K.Gold, M.Slate)
	Kit.window(m, CFrame.new(0, 0.9 + hh + 3.2, cz + 1.5 - 2.62), 1.1, 1.8, K.MarbleShade, nil, { Sill = false })
	local function spire(x, z, y0, d0, h)
		local steps = { 1.0, 0.8, 0.6, 0.42, 0.26 }
		for k, f in ipairs(steps) do
			Kit.cyl(m, "Spire", x, y0 + (k - 1) * h * 0.17, z, d0 * f, h * 0.17, (k % 2 == 0) and K.RoofBlueDark or K.RoofBlue, M.Clay)
		end
		Kit.cyl(m, "SpireTip", x, y0 + h * 0.85, z, d0 * 0.1, h * 0.2, K.Gold, M.Metal)
	end
	spire(0, cz + 1.5, 0.9 + hh + 6.45, 5.6, 6.2)
	-- four corner towers with spires, windows and banners
	local towers = { { -10.4, cz - 4.6 }, { 10.4, cz - 4.6 }, { -10.4, cz + 4.4 }, { 10.4, cz + 4.4 } }
	for i, t in ipairs(towers) do
		local th = (i <= 2) and 12.5 or 11.0
		Kit.cyl(m, "TowerBase", t[1], 0, t[2], 4.8, 0.9, K.SlateDark, M.Slate, true)
		Kit.cyl(m, "CornerTower", t[1], 0.9, t[2], 4.2, th, Kit.jit(K.Marble, i), M.Marble, true)
		Kit.cyl(m, "TowerBand", t[1], 0.9 + th, t[2], 4.7, 0.4, K.Gold, M.Slate)
		spire(t[1], t[2], 0.9 + th + 0.4, 4.9, 5.2)
		if i <= 2 then
			Kit.window(m, CFrame.new(t[1], 8.0, t[2] - 2.12), 0.9, 1.6, K.MarbleShade, nil, { Sill = false })
			Kit.p(m, "Banner", CFrame.new(t[1] + ((t[1] < 0) and 2.2 or -2.2), 6.4, fz - 0.12), Vector3.new(1.4, 3.6, 0.08), K.Banner, M.Fabric)
		end
	end
	-- the bridge steps and lanterns
	Kit.p(m, "Steps", CFrame.new(0, 0.45, fz - 1.0), Vector3.new(5.0, 0.9, 2.0), K.Slate, M.Slate, true)
	Kit.p(m, "Steps", CFrame.new(0, 0.2, fz - 2.5), Vector3.new(4.4, 0.4, 1.2), K.SlateLight, M.Slate, true)
	local deco = Kit.detail(m, "HouseDecor")
	for _, x in ipairs({ -2.9, 2.9 }) do
		Kit.lantern(deco, Vector3.new(x, 3.8, fz - 0.4), 0.5, true)
	end
	return 30
end

function Art.House(def, level)
	local tpl = newTemplate("House")
	local m = tpl.Model
	level = max(1, min(4, floor(level)))
	local top
	if level == 1 then
		top = House.cottage(m)
	elseif level == 2 then
		top = House.villa(m)
	elseif level == 3 then
		top = House.manor(m)
	else
		top = House.castle(m)
	end
	tpl.Info.Tier = level
	tpl.Points.RoofTop = Vector3.new(0, top, 0)
	return tpl
end

----------------------------------------------------------------------
-- Yard Fence (DecorFence, Perimeter: built in the PLOT frame just inside the lobby's fence, open at the gate),
-- the looks of the old Flower Beds + Banners merged in: picket panels + tulip boxes (1), a hedge + cloth banners +
-- the tulips (2), a cloudstone wall with cloud-capped pillars + royal banners + glowing starflowers (3). <= 90 parts.
----------------------------------------------------------------------
local Fence = {}

-- the runs { x0, z0, x1, z1 } along the yard's edge, the front split at the gate
function Fence.runs(half, inset)
	local e = half - (inset or 0.6)
	local gate = 8.6
	return {
		{ -e, e, e, e },
		{ -e, -e, -e, e },
		{ e, -e, e, e },
		{ -e, -e, -gate, -e },
		{ gate, -e, e, -e },
	}, e, gate
end

-- a box along a run: y0..y1 tall, `thick` across
function Fence.seg(parent, name, r, y0, y1, thick, color, mat, collide, shrink)
	local dx, dz = r[3] - r[1], r[4] - r[2]
	local len = math.sqrt(dx * dx + dz * dz) - (shrink or 0)
	local mid = Vector3.new((r[1] + r[3]) / 2, (y0 + y1) / 2, (r[2] + r[4]) / 2)
	local size = (abs(dx) > abs(dz)) and Vector3.new(len + thick, y1 - y0, thick) or Vector3.new(thick, y1 - y0, len + thick)
	return Kit.p(parent, name, CFrame.new(mid), size, color, mat, collide)
end

-- evenly spaced points along the runs (a corner shared by two runs comes once): fn(x, z, runIndex)
function Fence.points(runs, every, fn)
	local seen = {}
	for i, r in ipairs(runs) do
		local len = math.sqrt((r[3] - r[1]) ^ 2 + (r[4] - r[2]) ^ 2)
		local n = max(1, floor(len / every + 0.5))
		for k = 0, n do
			local f = k / n
			local x, z = lerp(r[1], r[3], f), lerp(r[2], r[4], f)
			local key = floor(x * 2 + 0.5) .. ":" .. floor(z * 2 + 0.5)
			if not seen[key] then
				seen[key] = true
				fn(x, z, i)
			end
		end
	end
end

-- the flower boxes beside the gate (inside the yard, along the front runs): a planter, foliage and blooms
function Fence.flowers(parent, e, gate, colors, glow)
	local d = Kit.detail(parent, "Flowers")
	for _, sx in ipairs({ -1, 1 }) do
		local x0, x1 = sx * 16.2, sx * 25.2
		local cx = (x0 + x1) / 2
		local z = -e + 1.2
		Kit.p(d, "Planter", CFrame.new(cx, 0.35, z), Vector3.new(9.0, 0.7, 0.9), K.PlanksDark, M.Planks)
		Kit.p(d, "Foliage", CFrame.new(cx, 0.85, z), Vector3.new(8.6, 0.4, 0.6), K.Leafy, M.Leafy)
		for k = 1, 5 do
			local bx = cx - 3.6 + (k - 1) * 1.8
			Kit.p(d, "Bloom", CFrame.new(bx, 1.25, z + ((k % 2 == 0) and 0.12 or -0.12)), Vector3.new(0.55, 0.55, 0.55), colors[(k % #colors) + 1], glow and M.Neon or M.Fabric)
		end
	end
end

-- a banner on a pole: pole, crossbar, cloth (+ an emblem for the royal ones)
function Fence.banner(parent, x, z, face, cloth, royal)
	local d = Kit.detail(parent, "Banner")
	local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, face, 0)
	Kit.p(d, "Pole", cf * CFrame.new(0, 3.3, 0), Vector3.new(0.35, 6.6, 0.35), royal and K.Gold or K.IronDark, M.Metal)
	Kit.p(d, "Crossbar", cf * CFrame.new(0, 6.3, -0.25), Vector3.new(2.2, 0.22, 0.22), royal and K.Gold or K.Wood, royal and M.Metal or M.Wood)
	Kit.p(d, "Cloth", cf * CFrame.new(0, 4.8, -0.3), Vector3.new(1.8, 2.8, 0.08), cloth, M.Fabric)
	if royal then
		Kit.p(d, "Emblem", cf * CFrame.new(0, 4.9, -0.36) * CFrame.Angles(0, 0, rad(45)), Vector3.new(0.7, 0.7, 0.06), K.GoldBright, M.Metal)
	end
end

function Art.Fence(def, level, plotSize)
	local tpl = newTemplate("DecorFence")
	local m = tpl.Model
	local half = (tonumber(plotSize) or 72) / 2
	level = max(1, min(3, floor(level)))
	-- the thicker looks step inward so they fit between the lobby's own fence posts (|x|, |z| >= 35.5) and the
	-- stations along the edge (the Pet Garden ends at x 34)
	local runs, e, gate = Fence.runs(half, ({ 0.6, 1.25, 1.25 })[level])
	if level == 1 then
		-- whitewashed picket panels between a top rail and posts every ~9 studs
		for _, r in ipairs(runs) do
			Fence.seg(m, "Pickets", r, 0, 1.9, 0.22, K.Whitewash, M.Planks, true)
			Fence.seg(m, "Rail", r, 1.55, 1.8, 0.4, Kit.jit(K.Whitewash, 3), M.Wood)
		end
		Fence.points(runs, 9, function(x, z, i)
			Kit.p(m, "Post", CFrame.new(x, 1.15, z), Vector3.new(0.55, 2.3, 0.55), K.Whitewash, M.Wood, true)
		end)
		Fence.flowers(m, e, gate, { rgb(236, 104, 108), rgb(250, 214, 92), rgb(246, 150, 188) }, false)
	elseif level == 2 then
		-- a clipped hedge on a brick kerb, brick pillars, the tulips and cloth banners at the gate and the corners
		for _, r in ipairs(runs) do
			Fence.seg(m, "Kerb", r, 0, 0.5, 1.2, K.Brick, M.Brick, true)
			Fence.seg(m, "Hedge", r, 0.5, 2.3, 1.1, K.Leafy, M.Leafy, true)
			Fence.seg(m, "HedgeTop", r, 2.3, 2.6, 0.8, K.GrassLight, M.Leafy)
		end
		Fence.points(runs, 18, function(x, z)
			Kit.p(m, "Pillar", CFrame.new(x, 1.45, z), Vector3.new(1.3, 2.9, 1.3), K.Brick, M.Brick, true)
			Kit.p(m, "PillarCap", CFrame.new(x, 3.05, z), Vector3.new(1.5, 0.3, 1.5), K.SlateLight, M.Slate)
		end)
		Fence.flowers(m, e, gate, { rgb(236, 104, 108), rgb(250, 214, 92), rgb(246, 150, 188) }, false)
		for _, sx in ipairs({ -1, 1 }) do
			Fence.banner(m, sx * (gate + 0.4), -e, 0, rgb(236, 88, 110), false)
			Fence.banner(m, sx * (e - 1.0), e - 1.0, PI, rgb(236, 88, 110), false)
		end
	else
		-- a cloudstone wall: a slate base, marble wall and cap, pillars with cloud puffs, royal banners, starflowers
		for _, r in ipairs(runs) do
			Fence.seg(m, "WallBase", r, 0, 0.5, 1.1, K.SlateDark, M.Slate, true)
			Fence.seg(m, "Wall", r, 0.5, 1.9, 0.9, K.Marble, M.Marble, true)
			Fence.seg(m, "WallCap", r, 1.9, 2.2, 1.1, K.MarbleShade, M.Marble)
		end
		local clouds = Kit.detail(m, "CloudPuffs")
		CollectionService:AddTag(clouds, EXEMPT_TAG)
		Fence.points(runs, 18, function(x, z)
			Kit.p(m, "Pillar", CFrame.new(x, 1.55, z), Vector3.new(1.3, 3.1, 1.3), K.Marble, M.Marble, true)
			Kit.ball(clouds, "Puff", Vector3.new(x, 3.5, z), 1.5, K.CloudTop, M.Plastic)
		end)
		Fence.flowers(m, e, gate, { rgb(196, 156, 255), rgb(140, 226, 255), rgb(255, 222, 140) }, true)
		for _, sx in ipairs({ -1, 1 }) do
			Fence.banner(m, sx * (gate + 0.4), -e, 0, rgb(150, 116, 226), true)
			Fence.banner(m, sx * (e - 1.0), e - 1.0, PI, rgb(150, 116, 226), true)
			Kit.lantern(m, Vector3.new(sx * gate, 4.6, -e), 0.6, true, "Crystal")
		end
	end
	return tpl
end

----------------------------------------------------------------------
-- Fountain (DecorFountain): the yard's centrepiece inside the ring of stone paths (radius <= 4.3), with the old
-- Lanterns merged in: a marble basin + 4 wood lanterns (1), a second tier + a cobble kerb + 6 brass lanterns (2),
-- a third tier with a cloud and a crystal + 8 crystal lanterns (3). The splash is a ParticleEmitter. <= 80 parts.
----------------------------------------------------------------------
function Art.Fountain(def, level)
	local tpl = newTemplate("DecorFountain")
	local m = tpl.Model
	level = max(1, min(3, floor(level)))
	local eff = (def and def.Effects and def.Effects[level]) or {}
	local style = eff.LanternStyle or ({ "Wood", "Brass", "Crystal" })[level]
	local count = tonumber(eff.Lanterns) or (2 + 2 * level)
	local water = K.Water
	Kit.oct(m, "Plinth", 0, 0, 0, 7.4, 0.4, K.SlateDark, M.Slate, true)
	local basin = Kit.cyl(m, "Basin", 0, 0.4, 0, 6.6, 1.0, K.Marble, M.Marble, true)
	Kit.cyl(m, "BasinFoot", 0, 0.4, 0, 6.9, 0.3, K.MarbleShade, M.Marble, true)
	Kit.cyl(m, "Water", 0, 1.4, 0, 5.9, 0.08, water, M.Glass, false).Transparency = 0.2
	Kit.cyl(m, "Column", 0, 1.4, 0, 0.9, 2.2, K.MarbleShade, M.Marble, true)
	Kit.cyl(m, "Bowl", 0, 3.6, 0, 2.6, 0.45, K.Marble, M.Marble)
	Kit.cyl(m, "BowlWater", 0, 4.0, 0, 2.2, 0.1, water, M.Glass).Transparency = 0.25
	local top = 4.1
	if level >= 2 then
		Kit.oct(m, "Kerb", 0, 0, 0, 8.4, 0.25, K.Cobble, M.Cobble, true)
		Kit.cyl(m, "Column", 0, 4.05, 0, 0.6, 1.6, K.MarbleShade, M.Marble)
		Kit.cyl(m, "Bowl", 0, 5.65, 0, 1.6, 0.35, K.Marble, M.Marble)
		Kit.cyl(m, "Trim", 0, 3.55, 0, 2.7, 0.12, K.Gold, M.Metal)
		top = 6.0
	end
	if level >= 3 then
		local clouds = Kit.detail(m, "Cloud")
		CollectionService:AddTag(clouds, EXEMPT_TAG)
		Kit.ball(clouds, "Puff", Vector3.new(0, 6.6, 0), 1.6, K.CloudTop, M.Plastic)
		Kit.ball(clouds, "Puff", Vector3.new(0.7, 6.3, 0.3), 1.1, K.CloudSide, M.Plastic)
		Kit.ball(clouds, "Puff", Vector3.new(-0.7, 6.25, -0.2), 1.0, K.CloudSide, M.Plastic)
		Kit.p(m, "Crystal", CFrame.new(0, 7.9, 0) * CFrame.Angles(rad(45), 0, rad(35)), Vector3.new(0.8, 0.8, 0.8), rgb(160, 226, 255), M.Neon)
		top = 7.2
	end
	-- the lanterns on an ellipse around the basin (clear of the paths), every other one lit
	local d = Kit.detail(m, "Lanterns")
	for i = 1, count do
		local a = (i - 0.5) / count * 2 * PI + PI / 4
		local x, z = math.cos(a) * 4.25, math.sin(a) * 3.65
		local postColor = (style == "Crystal") and K.Marble or ((style == "Brass") and K.IronDark or K.WoodDark)
		local postMat = (style == "Crystal") and M.Marble or ((style == "Brass") and M.Metal or M.Wood)
		Kit.p(d, "LanternPost", CFrame.new(x, 1.1, z), Vector3.new(0.3, 2.2, 0.3), postColor, postMat)
		Kit.lantern(d, Vector3.new(x, 2.45, z), 0.45, i % 2 == 1, style)
	end
	local att = Instance.new("Attachment")
	att.Name = "Splash"
	att.CFrame = basin.CFrame:Inverse() * CFrame.new(0, top + 0.4, 0)
	att.Parent = basin
	emitter(att, {
		Color = ColorSequence.new(rgb(206, 232, 250)),
		LightEmission = 0.2,
		Rate = 10 + level * 4,
		Lifetime = NumberRange.new(0.8, 1.3),
		Speed = NumberRange.new(4, 6),
		SpreadAngle = Vector2.new(18, 18),
		Acceleration = Vector3.new(0, -14, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.15) }),
	})
	return tpl
end

----------------------------------------------------------------------
-- Pet Podium (DecorPodium): dresses up the lobby's own podium (6 x 6, 3 tall; the best pet stands on it): a slate
-- stage with a marble step ring and corner posts: stone lanterns (1), marble pillars with gold caps + a carpet (2),
-- crystal pillars (3). The looks are unchanged from Phase 4; the materials follow 6.4. <= 80 parts.
----------------------------------------------------------------------
function Art.Podium(def, level)
	local tpl = newTemplate("DecorPodium")
	local m = tpl.Model
	level = max(1, min(3, floor(level)))
	Kit.p(m, "Stage", CFrame.new(0, 0.25, 0), Vector3.new(8, 0.5, 8), K.Slate, M.Slate, true)
	-- the step ring around the podium's foot (its middle left open: no face shared with the podium)
	for _, s in ipairs({ { 0, 3.25, 7, 0.5 }, { 0, -3.25, 7, 0.5 }, { 3.25, 0, 0.5, 6 }, { -3.25, 0, 0.5, 6 } }) do
		Kit.p(m, "Step", CFrame.new(s[1], 0.75, s[2]), Vector3.new(s[3], 0.5, s[4]), K.MarbleShade, M.Marble, true)
	end
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local x, z = sx * 3.5, sz * 3.5
			if level == 1 then
				Kit.p(m, "Post", CFrame.new(x, 1.75, z), Vector3.new(0.9, 1.5, 0.9), K.SlateLight, M.Slate)
				Kit.lantern(m, Vector3.new(x, 2.8, z), 0.55, false)
			elseif level == 2 then
				Kit.p(m, "Pillar", CFrame.new(x, 2.25, z), Vector3.new(0.9, 2.5, 0.9), K.Marble, M.Marble)
				Kit.p(m, "Cap", CFrame.new(x, 3.65, z), Vector3.new(1.1, 0.3, 1.1), K.Gold, M.Metal)
			else
				Kit.p(m, "Pillar", CFrame.new(x, 1.75, z), Vector3.new(0.9, 1.5, 0.9), K.Marble, M.Marble)
				Kit.p(m, "Cap", CFrame.new(x, 2.65, z), Vector3.new(1.1, 0.3, 1.1), K.Gold, M.Metal)
				Kit.p(m, "Crystal", CFrame.new(x, 3.5, z) * CFrame.Angles(0, rad(45), 0), Vector3.new(0.7, 1.4, 0.7), rgb(150, 220, 255), M.Neon)
			end
		end
	end
	if level >= 2 then
		for _, sz in ipairs({ -1, 1 }) do
			Kit.p(m, "Collar", CFrame.new(0, 2.25, sz * 2.85), Vector3.new(6.2, 0.4, 0.4), K.Gold, M.Metal)
			Kit.p(m, "Collar", CFrame.new(sz * 2.85, 2.25, 0), Vector3.new(0.4, 0.4, 5.3), K.Gold, M.Metal)
		end
		Kit.p(m, "Carpet", CFrame.new(0, 0.53, -4.35), Vector3.new(2.4, 0.06, 0.8), rgb(236, 88, 110), M.Fabric)
	end
	return tpl
end

----------------------------------------------------------------------
-- Template lookup
----------------------------------------------------------------------
local function fallbackTemplate(def, level)
	-- plain stand-in when the art fails: a slate block of the footprint
	local tpl = newTemplate(def.Id)
	local fp = (def.Slot and def.Slot.Footprint) or Vector3.new(6, 6, 6)
	local h = max(1, fp.Y * (0.5 + 0.5 * level / max(1, def.MaxLevel or 1)))
	Kit.p(tpl.Model, "Body", CFrame.new(0, h / 2, 0), Vector3.new(min(fp.X, 30), h, min(fp.Z, 30)), K.Slate, M.Slate, true)
	return tpl
end

local ART_BY_KIND = {
	Farm = Art.Farm,
	Garden = Art.Garden,
	FoodMachine = Art.FoodMachine,
	Training = Art.Training,
	Vault = Art.Vault,
	House = Art.House,
	Fusion = Art.Fusion,
	Arena = Art.ArenaGate,
}
local ART_BY_ID = {
	DecorFence = Art.Fence,
	DecorFountain = Art.Fountain,
	DecorPodium = Art.Podium,
}

-- template for (def, level); the Garden's open bed count changes its art (cache key Garden:<level>:<open>)
local function stationTemplate(def, level, accent, open)
	local key = def.Id .. ":" .. level
	local garden = def.Kind == "Garden"
	if garden then
		open = Garden.clampOpen(open, #Garden.places(def))
		key = key .. ":" .. open
	end
	local tpl = templates[key]
	if tpl then
		return tpl
	end
	local fn = ART_BY_ID[def.Id] or ART_BY_KIND[def.Kind]
	local ok, result = false, nil
	if fn then
		if garden then
			ok, result = pcall(fn, def, level, open)
		else
			ok, result = pcall(fn, def, level, TycoonCatalog and TycoonCatalog.PlotSize or 72, accent)
		end
		if not ok then
			warn("[HomeBuilder] art for " .. key .. " failed: " .. tostring(result))
		end
	end
	if not ok or type(result) ~= "table" then
		result = fallbackTemplate(def, level)
	end
	Kit.finish(result.Model)
	local primary = biggestPart(result.Model)
	if primary then
		result.Model.PrimaryPart = primary
	end
	result.Parts = countParts(result.Model)
	templates[key] = result
	return result
end

----------------------------------------------------------------------
-- Pads
----------------------------------------------------------------------
local PAD_COLORS = {
	Build = C.CashGlow,
	Upgrade = rgb(255, 210, 110),
	Locked = rgb(150, 160, 186),
	Prestige = rgb(196, 140, 255),
}

local function padState(pad)
	if pad.Prestige or pad.StationId == "Prestige" then
		return "Prestige"
	end
	if pad.Locked and pad.Locked ~= "" then
		return "Locked"
	end
	if (tonumber(pad.Level) or 0) <= 0 then
		return "Build"
	end
	return "Upgrade"
end

-- the pad's parts for one state, built once (origin = pad centre on the ground, front -Z = toward the station).
-- Four parts: a stone base (walkable; it carries the BuyPrompt and the sign), the glowing plate in the state's
-- colour and a two-part neon emblem: "+" build, an arrow toward the station upgrade, a padlock, a star (prestige).
local function padTemplate(state)
	local key = "Pad:" .. state
	if templates[key] then
		return templates[key]
	end
	local tpl = newTemplate("Pad")
	local m = tpl.Model
	local glow = PAD_COLORS[state] or PAD_COLORS.Build
	local size = Vector3.new(4, 0.6, 4)
	local cat = catalog()
	if cat and cat.Layout and typeof(cat.Layout.PadSize) == "Vector3" then
		size = cat.Layout.PadSize
	end
	local w, d = size.X, size.Z
	local base = box(m, "Base", CFrame.new(0, 0.2, 0), Vector3.new(w, 0.4, d), (state == "Locked") and C.StoneDark or C.StoneEdge, { Collide = true, Shadow = false })
	box(m, "Glow", CFrame.new(0, 0.45, 0), Vector3.new(w - 0.7, 0.1, d - 0.7), glow, { Material = MAT.Neon, Shadow = false, Collide = true })
	local ec = (state == "Locked") and rgb(214, 220, 236) or rgb(255, 255, 255)
	local eo = { Material = MAT.Neon, Shadow = false }
	local y = 0.52
	if state == "Build" then
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(1.8, 0.05, 0.5), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(0.5, 0.05, 1.8), ec, eo)
	elseif state == "Upgrade" then
		box(m, "Emblem", CFrame.new(0, y, 0.35), Vector3.new(0.5, 0.05, 1.3), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, -0.45) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(0.95, 0.05, 0.95), ec, eo)
	elseif state == "Locked" then
		box(m, "Emblem", CFrame.new(0, y, 0.3), Vector3.new(1.3, 0.05, 1.0), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, -0.45), Vector3.new(0.8, 0.05, 0.5), ec, eo)
	else
		box(m, "Emblem", CFrame.new(0, y, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(1.2, 0.05, 1.2), ec, eo)
		box(m, "Emblem", CFrame.new(0, y, 0), Vector3.new(1.2, 0.05, 1.2), ec, eo)
	end
	m.PrimaryPart = base
	templates[key] = tpl
	return tpl
end

----------------------------------------------------------------------
-- Plot records
----------------------------------------------------------------------
local lobbyInfo = nil
local plots = {} -- [key] = record
local initialized = false

HomeBuilder.StationBuilt = Util and Util.Signal and Util.Signal() or nil

local function spotKey(spotInfo)
	if type(spotInfo) == "table" then
		return tonumber(spotInfo.Index) or spotInfo
	end
	return tonumber(spotInfo)
end

local function resolveSpot(spotInfo)
	if type(spotInfo) == "number" then
		local spots = lobbyInfo and lobbyInfo.Spots
		return type(spots) == "table" and spots[spotInfo] or nil
	end
	if type(spotInfo) == "table" then
		return spotInfo
	end
	return nil
end

local function plotFrame(spotInfo)
	if typeof(spotInfo.PlotCFrame) == "CFrame" then
		return spotInfo.PlotCFrame
	end
	if typeof(spotInfo.Center) == "Vector3" then
		return CFrame.new(spotInfo.Center)
	end
	return nil
end

local function ownerId(rec)
	return rec.OwnerUserId or 0
end

-- the plot record (created by PreparePlot)
local function recordOf(spotInfo)
	local key = spotKey(spotInfo)
	return key ~= nil and plots[key] or nil
end

local function buildClaimSign(rec)
	if rec.ClaimSign then
		return rec.ClaimSign
	end
	local cf = rec.CF
	local half = (rec.Size or 72) / 2
	local m = Instance.new("Model")
	m.Name = "ClaimSign"
	-- a signboard on a wooden post on the verge beside the gate, facing the street. Two parts only: the free plots
	-- live inside the lobby and count toward its part budget. (World text rule: 50 px per stud, 1.1 stud title,
	-- 0.6 stud info, both fitting the 7 x 2.6 stud board; the GUI draws the board's frame.)
	local base = cf * CFrame.new(11, 0, -half - 2) * CFrame.Angles(0, math.pi, 0)
	box(m, "Post", base * CFrame.new(0, 1.6, 0), Vector3.new(0.6, 3.2, 0.6), C.PlankDark, { Collide = true })
	local board = box(m, "Board", base * CFrame.new(0, 3.9, 0), Vector3.new(7.0, 2.6, 0.4), C.Plank, { Collide = true, Shadow = false })
	local gui = surfaceGui(board, Enum.NormalId.Back, "ClaimGui")
	local panel = plainFrame(gui, "Panel", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(255, 255, 255), BackgroundTransparency = 0 })
	vgradient(panel, C.Violet, C.Navy)
	rounded(panel, 14)
	outline(panel, C.CashGlow, 5, 0.1)
	signText(panel, "FREE HOME", "Title", 56, C.TextGreen, "Title", 0.03, 0.06, 0.94, 0.5)
	signText(panel, "Press E at the gate", "Body", 30, C.Text, "Info", 0.03, 0.58, 0.94, 0.34)
	rec.ClaimSign = m
	return m
end

-- the lobby's own gate part closest to the gate opening (LobbyBuilder names them GateBeam / GateBase / GatePillar)
local GATE_PARTS = { GateBeam = 1, GateBase = 2, GatePillar = 3 }

local function gateHolder(parent, point)
	local best, bestRank, bestDist = nil, huge, huge
	for _, d in ipairs(parent:GetDescendants()) do
		local rank = GATE_PARTS[d.Name]
		if rank and d:IsA("BasePart") then
			local dist = (d.Position - point).Magnitude
			if dist <= 14 and (rank < bestRank or (rank == bestRank and dist < bestDist)) then
				best, bestRank, bestDist = d, rank, dist
			end
		end
	end
	return best
end

local function setClaimVisible(rec, free)
	if rec.ClaimPrompt then
		rec.ClaimPrompt.Enabled = free
	end
	local sign = buildClaimSign(rec)
	if free then
		if sign.Parent ~= rec.ClaimGate then
			sign.Parent = rec.ClaimGate
		end
	else
		sign.Parent = nil
	end
end

function HomeBuilder.PreparePlot(spotInfo)
	spotInfo = resolveSpot(spotInfo)
	if type(spotInfo) ~= "table" then
		return nil
	end
	local key = spotKey(spotInfo)
	local rec = plots[key]
	if rec and rec.Home and rec.Home.Parent then
		return rec.Home
	end
	local cf = plotFrame(spotInfo)
	if not cf then
		warn("[HomeBuilder] PreparePlot: SpotInfo " .. tostring(key) .. " has no PlotCFrame")
		return nil
	end
	local parent = spotInfo.Folder
	if typeof(parent) ~= "Instance" then
		parent = Workspace:FindFirstChild("NimbusHomes") or newFolder(Workspace, "NimbusHomes")
		parent = parent:FindFirstChild(string.format("Spot_%02d", tonumber(spotInfo.Index) or 0)) or newFolder(parent, string.format("Spot_%02d", tonumber(spotInfo.Index) or 0))
	end
	rec = {
		Key = key,
		Spot = spotInfo,
		Index = tonumber(spotInfo.Index) or 0,
		CF = cf,
		Size = tonumber(spotInfo.PlotSize) or (catalog() and catalog().PlotSize) or Config.Lobby.PlotSize or 72,
		Stations = {}, -- [id] = model
		Levels = {}, -- [id] = level
		Pads = {}, -- [id] = { Model, Sig, Prompt, ... }
		Ghosts = {},
		OwnerUserId = 0,
	}
	plots[key] = rec
	local old = parent:FindFirstChild("Home")
	if old then
		old:Destroy()
	end
	local home = newFolder(parent, "Home")
	home:SetAttribute("SpotIndex", rec.Index)
	home:SetAttribute("PlotCFrame", cf)
	home:SetAttribute("OwnerUserId", 0)
	home:SetAttribute("OwnerName", "")
	CollectionService:AddTag(home, HOME_TAG)
	rec.Home = home
	rec.PadFolder = newFolder(home, "Pads")

	-- the claim gate: the prompt rides an Attachment ("ClaimPoint") in the gate opening, on the lobby's own gate part
	-- when the plot has one (no extra part per plot), else on an invisible anchor (ClaimGate/ClaimAnchor)
	local oldGate = parent:FindFirstChild("ClaimGate")
	if oldGate then
		oldGate:Destroy()
	end
	for _, d in ipairs(parent:GetDescendants()) do
		if d:IsA("Attachment") and d.Name == "ClaimPoint" then
			d:Destroy()
		end
	end
	local gate = Instance.new("Model")
	gate.Name = "ClaimGate"
	gate.Parent = parent
	rec.ClaimGate = gate
	local gatePoint = cf * CFrame.new(0, 2.6, -rec.Size / 2)
	local holder = gateHolder(parent, gatePoint.Position) or anchorPart(gate, "ClaimAnchor", gatePoint)
	local anchor = Instance.new("Attachment")
	anchor.Name = "ClaimPoint"
	anchor.CFrame = holder.CFrame:ToObjectSpace(gatePoint)
	anchor.Parent = holder
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClaimPrompt"
	prompt.ActionText = "Claim Home"
	prompt.ObjectText = "Free home"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CLAIM_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("SpotIndex", rec.Index)
	prompt.Parent = anchor
	rec.ClaimPrompt = prompt
	setClaimVisible(rec, true)
	return home
end

----------------------------------------------------------------------
-- Paths (one merged voxel layer of every TycoonCatalog.Layout.Paths entry; built while the plot is owned)
----------------------------------------------------------------------
local PATH_EDGES = false -- a darker outline costs ~2x the parts (junctions fragment it)

local function pathTemplate()
	if templates.Paths then
		return templates.Paths
	end
	local tpl = newTemplate("Paths")
	local cat = catalog()
	local paths = cat and cat.Layout and cat.Layout.Paths or {}
	local g = Voxel and Voxel.NewGrid(1) or nil
	if g then
		local inside = {}
		local function key(i, k)
			return i * 4096 + k
		end
		for _, p in ipairs(paths) do
			local a, b, w = p.Start, p.Finish, p.Width or 4
			if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
				local x0, x1 = min(a.X, b.X) - w / 2, max(a.X, b.X) + w / 2
				local z0, z1 = min(a.Z, b.Z) - w / 2, max(a.Z, b.Z) + w / 2
				for i = floor(x0 + 0.5), floor(x1 + 0.5) - 1 do
					for k = floor(z0 + 0.5), floor(z1 + 0.5) - 1 do
						inside[key(i, k)] = true
					end
				end
			end
		end
		for code in pairs(inside) do
			local i = floor((code + 2048) / 4096)
			local k = code - i * 4096
			local edge = not (inside[key(i + 1, k)] and inside[key(i - 1, k)] and inside[key(i, k + 1)] and inside[key(i, k - 1)])
			local cellKey = edge and "PathEdge" or "Path"
			if not PATH_EDGES then
				cellKey = "Path"
			end
			Voxel.Set(g, i, 0, k, cellKey)
		end
		-- the border: one slab per path, 0.5 stud wider on each side and a hair lower than the path top
		for _, p in ipairs(paths) do
			local a, b, w = p.Start, p.Finish, p.Width or 4
			if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
				local x0, x1 = min(a.X, b.X) - w / 2 - 0.5, max(a.X, b.X) + w / 2 + 0.5
				local z0, z1 = min(a.Z, b.Z) - w / 2 - 0.5, max(a.Z, b.Z) + w / 2 + 0.5
				local half = (catalog() and catalog().PlotSize or 72) / 2 - 0.3
				x0, x1 = max(x0, -half), min(x1, half)
				z0, z1 = max(z0, -half), min(z1, half)
				box(tpl.Model, "PathEdge", CFrame.new((x0 + x1) / 2, -0.02, (z0 + z1) / 2), Vector3.new(x1 - x0, 0.2, z1 - z0), rgb(146, 138, 132), { Collide = true, Shadow = false })
			end
		end
		local model = Voxel.Build(g, {
			VoxelSize = 1,
			Palette = { Path = { Color = rgb(208, 202, 190), Material = MAT.SmoothPlastic }, PathEdge = { Color = rgb(146, 138, 132), Material = MAT.SmoothPlastic } },
			Name = "Paths",
			CFrame = CFrame.new(0.5, -0.32, 0.5), -- one voxel layer whose top sits 0.18 stud over the lawn
			CanCollide = true,
			CanQuery = true,
			CastShadow = false,
		})
		absorb(tpl.Model, model)
	end
	templates.Paths = tpl
	return tpl
end

local function setPaths(rec, on)
	local existing = rec.Home:FindFirstChild("Paths")
	if on then
		if not existing then
			local m = cloneAt(pathTemplate(), rec.CF)
			m.Name = "Paths"
			m.Parent = rec.Home
		end
	elseif existing then
		existing:Destroy()
	end
end

----------------------------------------------------------------------
-- The house lot: while the plot is owned and has no House yet (a new home, or right after a prestige) four stakes
-- and a string mark where the house will stand, with a little pile of planks and a stack of bricks beside it, so an
-- empty yard reads "your house goes here" (12 parts, gone as soon as the House is built; no collisions)
----------------------------------------------------------------------
local function lotTemplate()
	if templates.HouseLot then
		return templates.HouseLot
	end
	local tpl = newTemplate("HouseLot")
	local m = tpl.Model
	-- in the House slot's frame (front -Z, toward the yard); kept clear of the walk in front of the house
	local x0, x1, z0, z1 = -12, 12, -6.5, 8
	local rope = rgb(244, 238, 222)
	local deco = { Shadow = false }
	local plank = { Shadow = false }
	for _, x in ipairs({ x0, x1 }) do
		for _, z in ipairs({ z0, z1 }) do
			box(m, "Stake", CFrame.new(x, 0.8, z), Vector3.new(0.4, 1.6, 0.4), C.Plank, deco)
		end
	end
	box(m, "String", CFrame.new(0, 1.25, z0), Vector3.new(x1 - x0, 0.12, 0.12), rope, deco)
	box(m, "String", CFrame.new(0, 1.25, z1), Vector3.new(x1 - x0, 0.12, 0.12), rope, deco)
	box(m, "String", CFrame.new(x0, 1.25, (z0 + z1) / 2), Vector3.new(0.12, 0.12, z1 - z0), rope, deco)
	box(m, "String", CFrame.new(x1, 1.25, (z0 + z1) / 2), Vector3.new(0.12, 0.12, z1 - z0), rope, deco)
	-- planks (two crossed layers) and bricks inside the lot
	box(m, "Planks", CFrame.new(-6, 0.25, 1.5) * CFrame.Angles(0, math.rad(8), 0), Vector3.new(4.5, 0.5, 1.6), C.PlankLight, plank)
	box(m, "Planks", CFrame.new(-6, 0.75, 1.6) * CFrame.Angles(0, math.rad(-6), 0), Vector3.new(4.0, 0.5, 1.4), C.Plank, plank)
	box(m, "Bricks", CFrame.new(6, 0.5, 2.5), Vector3.new(2.4, 1.0, 1.6), rgb(220, 120, 80), { Shadow = false })
	box(m, "Bricks", CFrame.new(5.8, 1.25, 2.5) * CFrame.Angles(0, math.rad(10), 0), Vector3.new(1.6, 0.5, 1.2), rgb(232, 140, 98), { Shadow = false })
	templates.HouseLot = tpl
	return tpl
end

local function refreshLot(rec)
	local existing = rec.Home:FindFirstChild("HouseLot")
	local want = ownerId(rec) ~= 0 and (rec.Levels.House or 0) <= 0
	if want and not existing then
		local cat = catalog()
		local def = cat and cat.Get("House")
		if def and type(def.Slot) == "table" and typeof(def.Slot.CFrame) == "CFrame" then
			local m = cloneAt(lotTemplate(), rec.CF * def.Slot.CFrame)
			m.Name = "HouseLot"
			m.Parent = rec.Home
		end
	elseif existing and not want then
		existing:Destroy()
	end
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function stationDef(id)
	local cat = catalog()
	if not cat or type(id) ~= "string" then
		return nil
	end
	local def = cat.Get(id)
	if type(def) ~= "table" or def.Kind == "Prestige" or type(def.Slot) ~= "table" or typeof(def.Slot.CFrame) ~= "CFrame" then
		return nil
	end
	return def
end

local function applyOwnerAttr(rec, root)
	local uid = ownerId(rec)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name ~= "ClaimPrompt" then
			if d:GetAttribute("OwnerUserId") ~= uid then
				d:SetAttribute("OwnerUserId", uid)
			end
			-- buy pads follow their lock; garden places follow SetGarden (Garden.applyPrompts)
			if d.Name ~= "BuyPrompt" and d.Name ~= "GardenSpotPrompt" then
				d.Enabled = uid ~= 0
			end
		end
	end
	root:SetAttribute("OwnerUserId", uid)
end

----------------------------------------------------------------------
-- Garden places (SetGarden) and training mats (SetTraining): per-plot state re-applied to every rebuilt model
----------------------------------------------------------------------
function Garden.openOf(rec)
	local g = rec.Garden
	if g and g.Open then
		return g.Open
	end
	return Garden.defaultOpen()
end

-- GardenSpotPrompt.Enabled = owned AND open AND empty; OwnerUserId on every one (written only on change)
function Garden.applyPrompts(rec)
	local model = rec.Stations.Garden
	if not model then
		return
	end
	local uid = ownerId(rec)
	local open = Garden.openOf(rec)
	local valid = (rec.Garden and rec.Garden.Valid) or {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "GardenSpotPrompt" then
			local slot = tonumber(d:GetAttribute("Slot")) or 0
			local want = uid ~= 0 and slot >= 1 and slot <= open and valid[slot] == nil
			if d.Enabled ~= want then
				d.Enabled = want
			end
			if d:GetAttribute("OwnerUserId") ~= uid then
				d:SetAttribute("OwnerUserId", uid)
			end
		end
	end
end

-- the training mats show who trains on them: attributes Busy / Key / Stat / Ends on each Spot<i> (on change only)
function Garden.applyTraining(rec)
	local model = rec.Stations.Gym
	if not model then
		return
	end
	local pets = rec.Training or {}
	for i = 1, 5 do
		local att = model:FindFirstChild("Spot" .. i, true)
		if att then
			local job = pets[i]
			local busy = job ~= nil
			local values = {
				Busy = busy,
				Key = busy and job.Key or "",
				Stat = busy and job.Stat or "",
				Ends = busy and job.Ends or 0,
			}
			for name, v in pairs(values) do
				if att:GetAttribute(name) ~= v then
					att:SetAttribute(name, v)
				end
			end
		end
	end
end

local function removeGhost(rec, id)
	local g = rec.Ghosts[id]
	if g then
		g:Destroy()
		rec.Ghosts[id] = nil
	end
end

----------------------------------------------------------------------
-- Phase 6 (art-home, ARCHITECTURE_V3 6.1 A7 / recipe 4.8 "World path"): Blender meshes for the station art. Every
-- placed station is tagged with MeshLibrary.Tag(station, "home_<stem>_<level>"): the client hides the Part build
-- locally and shows the fine-voxel mesh (blender/catalog/home.json, built by blender/kit/props/home*.py from THIS
-- file's own Part build). The Part build stays: colliders, names, prompts, attachments, signs and the fallback.
-- Kept visible over the mesh (Mesh.keepOf): Neon / ForceField glow (HomeFx and the light pulse them), the parts HomeFx
-- moves (the Fusion `Swirl`), SurfaceGui sign boards (text stays Parts) and the Garden's bed pieces, which carry one
-- key each (home_bed_<piece>, tagged per Part, so a bed swap never needs a new station key). A key is tagged only
-- when it has an uploaded id (MeshLibrary.Status ~= "missing": the shipped empty MeshIds change nothing) and while
-- its manifest's "LayoutSig" (part count + position / size sums of the Part build it was baked from) still matches
-- the live build, so a later art change can never show a stale mesh. The kit reads Mesh.keepOf / Mesh.signature
-- through HomeBuilder._Mesh, so both sides use the same rules.
----------------------------------------------------------------------
local Mesh = {
	Lib = nil,
	-- key stem per station Kind (decor per Id): home_<stem>_<level>
	Stems = {
		Farm = "farm", Garden = "garden", FoodMachine = "foodmachine", Training = "training", Vault = "vault",
		House = "house", Fusion = "fusion", Arena = "arena", DecorFence = "fence", DecorFountain = "fountain",
		DecorPodium = "podium",
	},
	-- per-Part element keys (station Kind -> part name -> key); the element meshes' own parts use the same names
	Elements = {
		Garden = {
			Bed = "home_bed_frame", Cushion = "home_bed_cushion", Headboard = "home_bed_headboard",
			BedRoof = "home_bed_roof", SoilBed = "home_bed_soil", Stem = "home_bed_stem", Sprout = "home_bed_sprout",
			Post = "home_bed_post",
		},
	},
	NoElements = {},
}

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" and type(result.Status) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

function Mesh.elementsOf(def)
	return (def and Mesh.Elements[def.Kind]) or Mesh.NoElements
end

-- the part names that stay visible over a dressed station (sorted list) + the set
function Mesh.keepOf(model, elements)
	local set = {}
	for name in pairs(elements or Mesh.NoElements) do
		set[name] = true
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local keep = d.Material == MAT.Neon or d.Material == MAT.ForceField
				or (d.Material ~= MAT.Glass and d.Transparency > 0.05 and d.Transparency < 0.99)
				or d:FindFirstChildWhichIsA("SurfaceGui") ~= nil
			local a = d.Parent
			while not keep and a and a ~= model do
				if a.Name == "Swirl" then
					keep = true
				end
				a = a.Parent
			end
			if keep then
				set[d.Name] = true
			end
		end
	end
	local list = {}
	for name in pairs(set) do
		list[#list + 1] = name
	end
	table.sort(list)
	return list, set
end

-- part count + weighted sums of the visible, not kept BaseParts in `origin` space (LobbyBuilder Mesh.Signature's
-- formula; the kit stores the same numbers as the manifest attachment "LayoutSig")
function Mesh.signature(target, origin, skip)
	local inv = origin:Inverse()
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 and not (skip and skip[d.Name]) then
			local p = inv * d.Position
			local s = d.Size
			n = n + 1
			a = a + p.X + p.Y * 0.37 + p.Z * 0.61
			b = b + s.X + s.Y * 1.3 + s.Z * 1.7
		end
	end
	return n, a, b
end

function Mesh.sigOk(ML, key, n, a, b)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	local att = man and man.Attachments and (man.Attachments.LayoutSig or man.Attachments.layoutSig)
	local pos = att and (att.Pos or att.pos)
	if type(pos) ~= "table" then
		return false -- every home key is baked from a layout
	end
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- per template (cached): the station key, keep list and layout signature in template space
function Mesh.info(def, level, tpl)
	if tpl.Mesh then
		return tpl.Mesh
	end
	local stem = Mesh.Stems[def.Id] or Mesh.Stems[def.Kind]
	local elements = Mesh.elementsOf(def)
	local keepList, keepSet = Mesh.keepOf(tpl.Model, elements)
	local n, a, b = Mesh.signature(tpl.Model, CFrame.new(), keepSet)
	tpl.Mesh = { Key = stem and ("home_" .. stem .. "_" .. level) or nil, Keep = keepList, Sig = { n, a, b } }
	return tpl.Mesh
end

-- tags a placed station (model pivot = cf) and its element parts; returns the number of tags
function Mesh.station(m, def, level, tpl, cf)
	local ML = Mesh.lib()
	if not ML or not tpl or not tpl.Model then
		return 0
	end
	local info = Mesh.info(def, level, tpl)
	local tags = 0
	local key = info.Key
	if key and ML.Status(key) ~= "missing" and Mesh.sigOk(ML, key, info.Sig[1], info.Sig[2], info.Sig[3]) then
		ML.Tag(m, key, { Offset = m:GetPivot():Inverse() * cf }, info.Keep)
		tags = tags + 1
	end
	local elements = Mesh.elementsOf(def)
	if next(elements) then
		for _, d in ipairs(m:GetDescendants()) do
			local ekey = d:IsA("BasePart") and elements[d.Name]
			if ekey and d.Transparency < 0.99 and ML.Status(ekey) ~= "missing" then
				local n, a, b = Mesh.signature(d, d.CFrame)
				if Mesh.sigOk(ML, ekey, n, a, b) then
					ML.Tag(d, ekey, { Primary = d.Color }, nil) -- a tinted piece (the cushions) takes the part's colour
					tags = tags + 1
				end
			end
		end
	end
	return tags
end

HomeBuilder._Mesh = Mesh

local function placeStation(rec, def, level)
	local accent = (typeof(rec.Spot.Accent) == "Color3") and rec.Spot.Accent or nil
	local tpl = stationTemplate(def, level, accent, (def.Kind == "Garden") and Garden.openOf(rec) or nil)
	local slotCF = rec.CF * def.Slot.CFrame
	local m = cloneAt(tpl, slotCF)
	m.Name = "Station_" .. def.Id
	m:SetAttribute("StationId", def.Id)
	m:SetAttribute("Level", level)
	m:SetAttribute("Kind", def.Kind)
	m:SetAttribute("BuiltAt", serverNow())
	for name, p in pairs(tpl.Points) do
		m:SetAttribute(name, (slotCF * CFrame.new(p)).Position)
	end
	for name, v in pairs(tpl.Info) do
		m:SetAttribute(name, v)
	end
	applyOwnerAttr(rec, m)
	Mesh.station(m, def, level, tpl, slotCF) -- Phase 6: the Blender mesh (no-op without uploaded ids)
	return m
end

-- after a station model is placed: the per-plot state that lives on it (garden prompts, training mats)
local function afterPlace(rec, def)
	if def.Kind == "Garden" then
		Garden.applyPrompts(rec)
	elseif def.Kind == "Training" then
		Garden.applyTraining(rec)
	end
end

function HomeBuilder.SetStation(spotInfo, stationId, level)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	local def = stationDef(stationId)
	if not rec or not def then
		return nil
	end
	level = tonumber(level)
	if not level or level ~= level then
		return nil
	end
	level = floor(level)
	level = max(0, min(level, def.MaxLevel or level))
	local current = rec.Stations[stationId]
	if level == 0 then
		if current then
			current:Destroy()
		end
		rec.Stations[stationId] = nil
		rec.Levels[stationId] = nil
		if def.Kind == "House" then
			refreshLot(rec)
		end
		if HomeBuilder.StationBuilt then
			HomeBuilder.StationBuilt:Fire(rec.Spot, stationId, nil)
		end
		return nil
	end
	if current and current.Parent and rec.Levels[stationId] == level then
		return current
	end
	local ok, model = pcall(placeStation, rec, def, level)
	if not ok or not model then
		warn("[HomeBuilder] SetStation " .. tostring(stationId) .. " " .. tostring(level) .. " failed: " .. tostring(model))
		return nil
	end
	if current then
		current:Destroy()
	end
	removeGhost(rec, stationId)
	model.Parent = rec.Home
	rec.Stations[stationId] = model
	rec.Levels[stationId] = level
	afterPlace(rec, def)
	if def.Kind == "House" then
		refreshLot(rec)
	end
	if HomeBuilder.StationBuilt then
		HomeBuilder.StationBuilt:Fire(rec.Spot, stationId, model)
	end
	return model
end

-- every station of a Home table (others removed): a returning player's saved home on a fresh plot
function HomeBuilder.BuildHome(spotInfo, home)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	local cat = catalog()
	if not rec or not cat then
		return false
	end
	local stations = type(home) == "table" and type(home.Stations) == "table" and home.Stations or {}
	for _, def in ipairs(cat.Stations or {}) do
		HomeBuilder.SetStation(rec.Spot, def.Id, tonumber(stations[def.Id]) or 0)
	end
	return true
end

----------------------------------------------------------------------
-- Pads
----------------------------------------------------------------------
local function padSlot(id)
	local cat = catalog()
	local def = cat and cat.Get(id)
	if type(def) == "table" and type(def.Slot) == "table" and typeof(def.Slot.Pad) == "CFrame" then
		return def.Slot.Pad, def
	end
	return nil, def
end

-- "x1.25" (two decimals at most, no trailing zeros)
local function multText(m)
	local text = string.format("%.2f", m):gsub("0+$", ""):gsub("%.$", "")
	return "x" .. text
end

local function priceText(pad)
	local price = tonumber(pad.Price) or 0
	if pad.Prestige or pad.StationId == "Prestige" then
		-- what the reset buys: every star multiplies the income (the Home window says the same, per star)
		local cat = catalog()
		local m = cat and type(cat.Prestige) == "table" and tonumber(cat.Prestige.IncomeMultiplier) or nil
		if m and m == m and m > 1 and m < 100 then
			return "Reset: " .. multText(m) .. " income"
		end
		return "Start over: +1 " .. GLYPH.Star
	end
	if price <= 0 then
		return "FREE"
	end
	return formatCash(price)
end

local function padSignature(pad, uid)
	return table.concat({
		tostring(pad.NextLevel), tostring(pad.Price), tostring(pad.Locked or ""), tostring(pad.Title or pad.Name), tostring(pad.LevelText), tostring(uid), padState(pad),
	}, "|")
end

-- the floating sign (pixel tag): icon + name, then "Lv a -> b" + price, or the lock reason
local function buildPadSign(anchor, pad, state)
	local edge = PAD_COLORS[state] or C.TextGold
	local gui = newTag(anchor, "PadSign", 360, 130, PAD_SIGN_RANGE)
	gui.StudsOffsetWorldSpace = Vector3.new(0, PAD_SIGN_LIFT, 0)
	local plate = tagPlate(gui, edge)
	local row1 = plainFrame(plate, "NameRow", { AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 1 })
	listLayout(row1, Enum.FillDirection.Horizontal, 6)
	tagText(row1, "Icon", tostring(pad.Icon or GLYPH.Cloud), "Title", TAG_NAME, C.Text, 1)
	tagText(row1, "NameLabel", tostring(pad.Title or pad.Name or pad.StationId), "Title", TAG_NAME, C.Text, 2)
	local row2 = plainFrame(plate, "InfoRow", { AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 2 })
	listLayout(row2, Enum.FillDirection.Horizontal, 10)
	if state == "Locked" then
		tagText(row2, "LockLabel", GLYPH.Lock .. " " .. tostring(pad.Locked), "Body", TAG_INFO, C.TextLock, 1)
	else
		tagText(row2, "LevelLabel", tostring(pad.LevelText or ""), "Body", TAG_INFO, C.TextGold, 1)
		tagText(row2, "PriceLabel", priceText(pad), "Display", TAG_PRICE, (state == "Prestige") and rgb(226, 196, 255) or C.TextGreen, 2)
	end
	return gui
end

local function ghostFor(rec, id, def)
	if rec.Ghosts[id] or rec.Stations[id] or not def then
		return
	end
	local ok, tpl = pcall(stationTemplate, def, 1, nil)
	if not ok or type(tpl) ~= "table" then
		return
	end
	local m = cloneAt(tpl, rec.CF * def.Slot.CFrame)
	m.Name = "Ghost_" .. id
	-- a silhouette needs only the biggest blocks: keep GHOST_PARTS of them
	local parts = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
		end
	end
	table.sort(parts, function(a, b)
		return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z
	end)
	for k = GHOST_PARTS + 1, #parts do
		parts[k]:Destroy()
	end
	-- drawn as a soft blue hologram (the ForceField material shimmers on its own: no animation needed)
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Color = C.Ghost
			d.Material = MAT.ForceField
			d.Transparency = 0.3
			d.Reflectance = 0
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("ProximityPrompt") or d:IsA("ParticleEmitter") or d:IsA("Light") or d:IsA("SurfaceGui") then
			d:Destroy()
		end
	end
	m:SetAttribute("StationId", id)
	m.Parent = rec.Home
	rec.Ghosts[id] = m
end

local function updatePad(rec, pad)
	local id = pad.StationId
	local slotCF, def = padSlot(id)
	if not slotCF then
		return nil
	end
	local uid = ownerId(rec)
	local state = padState(pad)
	local sig = padSignature(pad, uid)
	local entry = rec.Pads[id]
	if entry and entry.Sig == sig and entry.Model.Parent then
		return entry
	end
	-- the pad parts only change with the state; the sign and the attributes with every change
	if not entry or entry.State ~= state or not entry.Model.Parent then
		if entry then
			entry.Model:Destroy()
		end
		local m = cloneAt(padTemplate(state), rec.CF * slotCF)
		m.Name = "Pad_" .. id
		m:SetAttribute("BuiltAt", serverNow())
		local base = m:FindFirstChild("Base")
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "BuyPrompt"
		-- the Prestige pad buys nothing: a deliberate hold opens the Home window's prestige confirmation
		local prestigePad = id == "Prestige"
		prompt.ActionText = prestigePad and "Prestige" or "Buy"
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.HoldDuration = prestigePad and PRESTIGE_HOLD or 0.25
		prompt.MaxActivationDistance = PROMPT_RANGE
		prompt.RequiresLineOfSight = false
		prompt:SetAttribute("StationId", id)
		prompt.Parent = base or m
		entry = { Model = m, Prompt = prompt, Anchor = base, State = state }
		rec.Pads[id] = entry
		m.Parent = rec.PadFolder
	end
	local m = entry.Model
	if entry.Sign then
		entry.Sign:Destroy()
	end
	entry.Sign = buildPadSign(entry.Anchor, pad, state)
	local locked = (pad.Locked ~= nil and pad.Locked ~= "") and tostring(pad.Locked) or ""
	m:SetAttribute("StationId", id)
	m:SetAttribute("OwnerUserId", uid)
	m:SetAttribute("NextLevel", tonumber(pad.NextLevel) or 1)
	m:SetAttribute("Level", tonumber(pad.Level) or 0)
	m:SetAttribute("Price", tonumber(pad.Price) or 0)
	m:SetAttribute("Locked", locked)
	m:SetAttribute("Title", tostring(pad.Title or pad.Name or id))
	m:SetAttribute("LevelText", tostring(pad.LevelText or ""))
	m:SetAttribute("Kind", tostring(pad.Kind or (def and def.Kind) or ""))
	entry.Prompt:SetAttribute("OwnerUserId", uid)
	entry.Prompt.ObjectText = tostring(pad.Title or pad.Name or id) .. ((locked == "") and ("  " .. priceText(pad)) or "")
	entry.Prompt.Enabled = locked == "" and uid ~= 0
	entry.Sig = sig
	-- a ghost of the station while it unlocks only later ("Unlocks at Prestige 1", "Coming soon")
	if locked ~= "" and (locked:find("Prestige", 1, true) or locked:find("Coming soon", 1, true)) and (tonumber(pad.Level) or 0) == 0 then
		ghostFor(rec, id, stationDef(id))
	else
		removeGhost(rec, id)
	end
	return entry
end

function HomeBuilder.SetPads(spotInfo, pads)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local keep = {}
	if type(pads) == "table" then
		for _, pad in ipairs(pads) do
			if type(pad) == "table" and type(pad.StationId) == "string" and not keep[pad.StationId] then
				local ok, entry = pcall(updatePad, rec, pad)
				if ok and entry then
					keep[pad.StationId] = true
				elseif not ok then
					warn("[HomeBuilder] pad " .. pad.StationId .. " failed: " .. tostring(entry))
				end
			end
		end
	end
	for id, entry in pairs(rec.Pads) do
		if not keep[id] then
			entry.Model:Destroy()
			rec.Pads[id] = nil
			removeGhost(rec, id)
		end
	end
	return true
end

----------------------------------------------------------------------
-- Owner, collector, clear
----------------------------------------------------------------------
function HomeBuilder.SetOwner(spotInfo, player)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local uid, name = 0, ""
	if typeof(player) == "Instance" and player:IsA("Player") then
		uid = player.UserId
		name = player.DisplayName ~= "" and player.DisplayName or player.Name
	end
	rec.OwnerUserId = uid
	rec.Home:SetAttribute("OwnerUserId", uid)
	rec.Home:SetAttribute("OwnerName", name)
	setClaimVisible(rec, uid == 0)
	setPaths(rec, uid ~= 0)
	refreshLot(rec)
	for _, model in pairs(rec.Stations) do
		applyOwnerAttr(rec, model)
	end
	Garden.applyPrompts(rec)
	for _, entry in pairs(rec.Pads) do
		entry.Model:SetAttribute("OwnerUserId", uid)
		entry.Prompt:SetAttribute("OwnerUserId", uid)
		local locked = entry.Model:GetAttribute("Locked")
		entry.Prompt.Enabled = uid ~= 0 and (locked == nil or locked == "")
		entry.Sig = nil
	end
	return true
end

-- SetGarden(spotInfo, valid, open): the Garden's open place count (3 + Prestige stars, at most 12: TycoonService's
-- GardenSlots, NOT the Garden level) and the placed keys valid = { [slot] = key }. A new open count rebuilds the
-- Garden model (template Garden:<level>:<open>); the GardenSpotPrompts follow the empty open places. Kept per plot,
-- so a Garden built later (or rebuilt with a new level) shows the same places.
function HomeBuilder.SetGarden(spotInfo, valid, open)
	local rec = recordOf(spotInfo)
	if not rec then
		HomeBuilder.PreparePlot(spotInfo)
		rec = recordOf(spotInfo)
	end
	if not rec then
		return false
	end
	local cat = catalog()
	local def = stationDef("Garden")
	local places = def and #Garden.places(def) or ((cat and cat.Prestige and tonumber(cat.Prestige.GardenSlotsMax)) or 12)
	local slots = {}
	if type(valid) == "table" then
		for k, v in pairs(valid) do
			local slot = tonumber(k)
			if slot and slot == slot and slot >= 1 and slot <= places and slot == floor(slot) and type(v) == "string" and v ~= "" then
				slots[slot] = v
			end
		end
	end
	local before = Garden.openOf(rec)
	open = Garden.clampOpen((open == nil) and before or open, places)
	rec.Garden = { Open = open, Valid = slots }
	local model = rec.Stations.Garden
	if def and model and model.Parent and open ~= before and (rec.Levels.Garden or 0) > 0 then
		-- the places changed (a Prestige): rebuild the Garden with the new open count
		local ok, fresh = pcall(placeStation, rec, def, rec.Levels.Garden)
		if ok and fresh then
			model:Destroy()
			fresh.Parent = rec.Home
			rec.Stations.Garden = fresh
			if HomeBuilder.StationBuilt then
				HomeBuilder.StationBuilt:Fire(rec.Spot, "Garden", fresh)
			end
		else
			warn("[HomeBuilder] SetGarden rebuild failed: " .. tostring(fresh))
		end
	end
	Garden.applyPrompts(rec)
	if rec.Stations.Garden and rec.Stations.Garden:GetAttribute("Open") ~= open then
		rec.Stations.Garden:SetAttribute("Open", open)
	end
	return true
end

-- SetTraining(spotInfo, pets): pets = { [mat] = { Key, Stat, Ends } } (PetCareService; HomeFx reads the plot's
-- TrainingPets attribute). Only attributes on the mats' Spot<i> attachments: Busy, Key, Stat, Ends.
function HomeBuilder.SetTraining(spotInfo, pets)
	local rec = recordOf(spotInfo)
	if not rec then
		return false
	end
	local map = {}
	if type(pets) == "table" then
		for k, v in pairs(pets) do
			local mat = tonumber(k)
			if mat and mat == mat and mat >= 1 and mat <= 5 and mat == floor(mat) and type(v) == "table" then
				local ends = tonumber(v.Ends) or 0
				if ends ~= ends or ends == huge or ends == -huge then
					ends = 0
				end
				map[mat] = { Key = tostring(v.Key or ""), Stat = tostring(v.Stat or ""), Ends = floor(ends) }
			end
		end
	end
	rec.Training = map
	Garden.applyTraining(rec)
	return true
end

function HomeBuilder.ClearPlot(spotInfo)
	local rec = recordOf(spotInfo)
	if not rec then
		return false
	end
	for id, model in pairs(rec.Stations) do
		model:Destroy()
		rec.Stations[id] = nil
	end
	rec.Levels = {}
	for id, entry in pairs(rec.Pads) do
		entry.Model:Destroy()
		rec.Pads[id] = nil
	end
	for id in pairs(rec.Ghosts) do
		removeGhost(rec, id)
	end
	rec.Garden = nil
	rec.Training = nil
	-- anything else a caller parented under Home (but keep the Pads folder)
	for _, c in ipairs(rec.Home:GetChildren()) do
		if c ~= rec.PadFolder and c.Name ~= "Paths" and c.Name ~= "HouseLot" then
			c:Destroy()
		end
	end
	for _, c in ipairs(rec.PadFolder:GetChildren()) do
		c:Destroy()
	end
	if ownerId(rec) == 0 then
		setPaths(rec, false)
	end
	refreshLot(rec)
	return true
end

----------------------------------------------------------------------
-- Extras
----------------------------------------------------------------------
function HomeBuilder.GetHomeFolder(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and rec.Home or nil
end

function HomeBuilder.GetStation(spotInfo, id)
	local rec = recordOf(spotInfo)
	return rec and rec.Stations[id] or nil
end

function HomeBuilder.GetPad(spotInfo, id)
	local rec = recordOf(spotInfo)
	local entry = rec and rec.Pads[id]
	return entry and entry.Model or nil
end

function HomeBuilder.GetClaimPrompt(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and rec.ClaimPrompt or nil
end

function HomeBuilder.PartCount(spotInfo)
	local rec = recordOf(spotInfo)
	return rec and countParts(rec.Home) or 0
end

-- a fresh copy of a station's model at the origin (front -Z), for renders and tests; open = the Garden's open place
-- count (default: Prestige.GardenSlotsBase)
function HomeBuilder.BuildStationModel(id, level, accent, open)
	local def = stationDef(id)
	if not def then
		return nil
	end
	level = max(1, min(floor(tonumber(level) or 1), def.MaxLevel or 1))
	local tpl = stationTemplate(def, level, accent, open)
	local m = cloneAt(tpl, CFrame.new())
	m.Name = "Station_" .. id
	m:SetAttribute("StationId", id)
	m:SetAttribute("Level", level)
	m:SetAttribute("Kind", def.Kind)
	for name, v in pairs(tpl.Info) do
		m:SetAttribute(name, v)
	end
	Mesh.station(m, def, level, tpl, CFrame.new()) -- Phase 6: the Blender mesh (no-op without uploaded ids)
	return m
end

-- local fx points of a station level (FruitPoint, MagnetCenter, ChuteMouth, Tray, HopperTop, SwirlCenter ...)
function HomeBuilder.Points(id, level)
	local def = stationDef(id)
	if not def then
		return nil
	end
	local tpl = stationTemplate(def, max(1, floor(tonumber(level) or 1)), nil)
	return tpl.Points, tpl.Info
end

HomeBuilder.Art = Art

function HomeBuilder.Init(info)
	if type(info) == "table" then
		lobbyInfo = info
	end
	initialized = true
	if type(lobbyInfo) == "table" and type(lobbyInfo.Spots) == "table" then
		for _, spot in pairs(lobbyInfo.Spots) do
			local ok, err = pcall(HomeBuilder.PreparePlot, spot)
			if not ok then
				warn("[HomeBuilder] PreparePlot failed: " .. tostring(err))
			end
		end
	end
	return true
end

function HomeBuilder.IsReady()
	return initialized
end

return HomeBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="848">
          <Properties>
            <string name="Name">IndexService</string>
            <string name="Source"><![CDATA[-- IndexService: Pet Index group rewards (ARCHITECTURE_V3.md section 3).
--
--   IndexService.Init(deps)                       deps = { DataService =, PetService = }
--   IndexService.CanClaim(player, groupId) -> bool, reason
--   IndexService.Claim(player, groupId)    -> ok, reason
--   IndexService.Completed                        Util.Signal, Fire(player, groupId) when a group becomes complete
--                                                 (its last pet was just discovered; the tutorial may listen)
--   Extras: IndexService.Claimed (Util.Signal, Fire(player, groupId, tokens) after a successful claim),
--           IndexService.GetProgress(player) -> { [groupId] = { Found, Total, Complete, Claimed, Reward } }
--
-- A group is one rarity (PetCatalog.IndexGroups). It is complete when every pet in it is in the profile's
-- Discovered set; its Config.Index reward can be claimed once (Profile.IndexClaimed[groupId] = true). Claims wait
-- while DataService.IsProvisional(player) (a load that failed during an outage: the defaults cannot tell which
-- rewards were already claimed).
-- Everything is server authoritative: the client only sends a group id through the IndexClaim remote, which
-- is type checked and rate limited; the reward goes through DataService.AddTokens, then the profile is synced.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local IndexService = {}
IndexService.Completed = Util.Signal()
IndexService.Claimed = Util.Signal()

local CLAIM_COOLDOWN = 0.5 -- seconds per player between IndexClaim requests
local MAX_ID_LENGTH = 48
local REMINDER_DELAY = 8 -- seconds after joining before the "unclaimed reward" reminder toast

----------------------------------------------------------------------
-- Collaborators (resolved defensively: other modules may be missing or broken)
----------------------------------------------------------------------

local function loadModule(parent, name)
	local module = parent and parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[IndexService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local PetCatalog = loadModule(Shared, "PetCatalog")
local DataService = nil
local PetService = nil

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local groups = {} -- array of { Id, Rarity, Pets = {PetDef...}, Reward } in rarity order
local groupById = {} -- [groupId] = group
local groupOfPet = {} -- [petId] = groupId

local completeState = {} -- [player] = { [groupId] = true } groups already complete (edge detection)
local lastClaim = {} -- [player] = os.clock() of the last accepted IndexClaim
local reminded = {} -- [player] = true once the unclaimed-reward reminder was sent this session
local initialized = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function fireClient(remoteName, player, ...)
	local ok, remote = pcall(Remotes.Get, remoteName)
	if ok and remote and player and player.Parent then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 4)
end

local function commas(n)
	local ok, text = pcall(Util.Commas, n)
	if ok and type(text) == "string" then
		return text
	end
	return tostring(n)
end

-- (Re)builds the group tables from the catalog (static data, so once is enough).
local function buildGroups()
	groups, groupById, groupOfPet = {}, {}, {}
	if not PetCatalog or type(PetCatalog.IndexGroups) ~= "function" then
		return
	end
	local ok, list = pcall(PetCatalog.IndexGroups)
	if not ok or type(list) ~= "table" then
		warn("[IndexService] PetCatalog.IndexGroups failed: " .. tostring(list))
		return
	end
	for _, group in ipairs(list) do
		if type(group) == "table" and type(group.Id) == "string" and type(group.Pets) == "table" and #group.Pets > 0 then
			table.insert(groups, group)
			groupById[group.Id] = group
			for _, def in ipairs(group.Pets) do
				if type(def) == "table" and type(def.Id) == "string" then
					groupOfPet[def.Id] = group.Id
				end
			end
		end
	end
end

-- Token reward of a group (Config.Index is the source of truth; the catalog copy is a fallback).
local function rewardTokens(group)
	local index = Config.Index
	local rewards = type(index) == "table" and index.Rewards
	local reward = type(rewards) == "table" and rewards[group.Id]
	if type(reward) ~= "table" then
		reward = group.Reward
	end
	local tokens = type(reward) == "table" and reward.Tokens
	if type(tokens) == "number" and tokens == tokens and tokens > 0 and tokens < math.huge then
		return math.floor(tokens)
	end
	return 0
end

local function getProfile(player)
	if not DataService or type(DataService.GetProfile) ~= "function" then
		return nil
	end
	local ok, profile = pcall(DataService.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

-- found, total for one group of a profile (an owned pet always counts as discovered).
local function groupProgress(profile, group)
	local discovered = type(profile.Discovered) == "table" and profile.Discovered or {}
	local owned = type(profile.Pets) == "table" and profile.Pets or {}
	local found = 0
	for _, def in ipairs(group.Pets) do
		local count = owned[def.Id]
		if discovered[def.Id] == true or (type(count) == "number" and count > 0) then
			found = found + 1
		end
	end
	return found, #group.Pets
end

local function isClaimed(profile, groupId)
	return type(profile.IndexClaimed) == "table" and profile.IndexClaimed[groupId] == true
end

local function isComplete(profile, group)
	local found, total = groupProgress(profile, group)
	return total > 0 and found >= total
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function IndexService.CanClaim(player, groupId)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(groupId) ~= "string" or #groupId == 0 or #groupId > MAX_ID_LENGTH then
		return false, "Unknown Index group"
	end
	if not DataService or #groups == 0 then
		return false, "The Pet Index is unavailable right now"
	end
	local group = groupById[groupId]
	if not group then
		return false, "Unknown Index group"
	end
	local profile = getProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	-- a profile whose load failed (DataStore outage) holds defaults: its IndexClaimed cannot tell what was claimed
	if type(DataService.IsProvisional) == "function" then
		local okProvisional, provisional = pcall(DataService.IsProvisional, player)
		if okProvisional and provisional == true then
			return false, "Your data is still loading"
		end
	end
	if isClaimed(profile, groupId) then
		return false, "Already claimed"
	end
	local found, total = groupProgress(profile, group)
	if found < total then
		return false, string.format("Discover every %s pet first (%d/%d)", groupId, found, total)
	end
	if rewardTokens(group) <= 0 then
		return false, "This group has no reward"
	end
	return true
end

function IndexService.Claim(player, groupId)
	local ok, reason = IndexService.CanClaim(player, groupId)
	if not ok then
		return false, reason
	end
	local group = groupById[groupId]
	local profile = getProfile(player)
	if not group or not profile then
		return false, "Your data is still loading"
	end
	local tokens = rewardTokens(group)
	-- Nothing below yields: the claimed flag is written before the tokens, so a claim pays exactly once.
	if type(profile.IndexClaimed) ~= "table" then
		profile.IndexClaimed = {}
	end
	profile.IndexClaimed[groupId] = true
	if type(DataService.AddTokens) == "function" then
		DataService.AddTokens(player, tokens)
	end
	if type(DataService.MarkDirty) == "function" then
		DataService.MarkDirty(player)
	end
	if type(DataService.Sync) == "function" then
		DataService.Sync(player)
	end
	notify(player, "Pet Index: " .. groupId .. " complete! +" .. commas(tokens) .. " Cloud Tokens", "token", 4)
	IndexService.Claimed:Fire(player, groupId, tokens)
	return true
end

-- Extra: per-group progress for a player (empty table until the profile is loaded).
function IndexService.GetProgress(player)
	local out = {}
	local profile = player and getProfile(player)
	if not profile then
		return out
	end
	for _, group in ipairs(groups) do
		local found, total = groupProgress(profile, group)
		out[group.Id] = {
			Found = found,
			Total = total,
			Complete = total > 0 and found >= total,
			Claimed = isClaimed(profile, group.Id),
			Reward = rewardTokens(group),
		}
	end
	return out
end

----------------------------------------------------------------------
-- Completion tracking (Completed signal + side toasts)
----------------------------------------------------------------------

-- Remembers which groups are complete right now without announcing them (join / rebase).
local function primePlayer(player)
	local profile = getProfile(player)
	if not profile then
		return
	end
	local state = {}
	local unclaimed = 0
	for _, group in ipairs(groups) do
		if isComplete(profile, group) then
			state[group.Id] = true
			if not isClaimed(profile, group.Id) and rewardTokens(group) > 0 then
				unclaimed = unclaimed + 1
			end
		end
	end
	completeState[player] = state
	-- once per session: a gentle side toast when a finished group still waits for its reward
	if unclaimed > 0 and not reminded[player] then
		reminded[player] = true
		task.delay(REMINDER_DELAY, function()
			if isLivePlayer(player) then
				local text = "You have an unclaimed Pet Index reward! Open the Index to claim it."
				if unclaimed > 1 then
					text = "You have " .. unclaimed .. " unclaimed Pet Index rewards! Open the Index to claim them."
				end
				notify(player, text, "good", 5)
			end
		end)
	end
end

-- After a discovery: fires Completed for every group that just became complete.
local function checkCompletions(player, petId)
	if not isLivePlayer(player) then
		return
	end
	local profile = getProfile(player)
	if not profile then
		return
	end
	local state = completeState[player]
	if not state then
		state = {}
		completeState[player] = state
	end
	-- the rolled pet's group first (the common case), then the rest (cheap: a handful of groups)
	local order = {}
	local first = type(petId) == "string" and groupOfPet[petId]
	if first and groupById[first] then
		table.insert(order, groupById[first])
	end
	for _, group in ipairs(groups) do
		if group.Id ~= first then
			table.insert(order, group)
		end
	end
	for _, group in ipairs(order) do
		if not state[group.Id] and isComplete(profile, group) then
			state[group.Id] = true
			if not isClaimed(profile, group.Id) then
				local tokens = rewardTokens(group)
				if tokens > 0 then
					notify(player, "Pet Index: every " .. group.Id .. " pet found! Claim " .. commas(tokens) .. " tokens in the Index.", "good", 5)
				end
			end
			IndexService.Completed:Fire(player, group.Id)
		end
	end
end

-- Extra: re-checks a player's groups after a discovery that did not come through PetService.Rolled.
function IndexService.Refresh(player, petId)
	checkCompletions(player, petId)
end

----------------------------------------------------------------------
-- Remote + lifecycle wiring
----------------------------------------------------------------------

local function connectRemote()
	local ok, remote = pcall(Remotes.Get, "IndexClaim")
	if not ok or not remote then
		warn("[IndexService] remote IndexClaim is missing (did Remotes.Init run?)")
		return
	end
	remote.OnServerEvent:Connect(function(player, groupId)
		if not isLivePlayer(player) then
			return
		end
		local now = os.clock()
		local last = lastClaim[player]
		if last and now - last < CLAIM_COOLDOWN then
			return
		end
		lastClaim[player] = now
		if type(groupId) ~= "string" or #groupId == 0 or #groupId > MAX_ID_LENGTH then
			return
		end
		local pok, success, reason = pcall(IndexService.Claim, player, groupId)
		if not pok then
			warn("[IndexService] Claim errored: " .. tostring(success))
			notify(player, "Something went wrong, try again", "bad", 3)
			return
		end
		if not success and reason then
			notify(player, tostring(reason), "bad", 3)
		end
	end)
end

local function hasSignal(module, name)
	return type(module) == "table" and type(module[name]) == "table" and type(module[name].Connect) == "function"
end

local function connectSignals()
	if hasSignal(PetService, "Rolled") then
		PetService.Rolled:Connect(function(player, petId)
			checkCompletions(player, petId)
		end)
	else
		warn("[IndexService] PetService.Rolled is missing: Index completions are only checked on claim")
	end
	if hasSignal(DataService, "ProfileLoaded") then
		DataService.ProfileLoaded:Connect(function(player)
			primePlayer(player)
		end)
	end
	if hasSignal(DataService, "ProfileRebased") then
		DataService.ProfileRebased:Connect(function(player)
			primePlayer(player)
		end)
	end
	Players.PlayerRemoving:Connect(function(player)
		completeState[player] = nil
		lastClaim[player] = nil
		reminded[player] = nil
	end)
	-- players whose profile loaded before Init
	for _, player in ipairs(Players:GetPlayers()) do
		if getProfile(player) then
			task.spawn(primePlayer, player)
		end
	end
end

function IndexService.Init(deps)
	if initialized then
		return
	end
	initialized = true
	if type(deps) == "table" then
		DataService = deps.DataService
		PetService = deps.PetService
	end
	local services = script.Parent
	if type(DataService) ~= "table" then
		DataService = loadModule(services, "DataService")
	end
	if type(PetService) ~= "table" then
		PetService = loadModule(services, "PetService")
	end
	if not PetCatalog then
		PetCatalog = loadModule(Shared, "PetCatalog")
	end
	buildGroups()
	if #groups == 0 then
		warn("[IndexService] no Pet Index groups (PetCatalog missing?): claims are refused")
	end
	if not DataService then
		warn("[IndexService] DataService is missing: claims are refused")
	end
	connectRemote()
	connectSignals()
end

return IndexService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="849">
          <Properties>
            <string name="Name">ItemService</string>
            <string name="Source"><![CDATA[-- ItemService: the item shop and usable match items (ARCHITECTURE_V2.md section 2).
--
--   ItemService.Init(lobbyInfo, deps)    deps = { DataService, DamageService, MatchService } (all optional;
--                                        siblings are required lazily). ItemService.SetMatchService(ms) also works.
--   ItemService.Buy(player, itemId, qty) -> ok, reason     lobby only, spends tokens, respects Config.Items.MaxCarry
--   ItemService.Use(player, itemId)      -> ok, reason     running match only (not the intro countdown), alive, not downed
--
-- Items (ItemCatalog.List order):
--   heal_cloud       heals 40% of max health (refused at full health, nothing consumed)
--   shield_bubble    8 s of invulnerability + a soft bubble around the character
--   phoenix_feather  revives the nearest downed teammate of your match (50% health via DamageService.Revive);
--                    consumed only if someone was actually revived
--
-- The remotes BuyItem / UseItem are connected here: rate limited, type checked, known ids only.
-- Plain Lua 5.1-compatible syntax only.

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local ItemService = {}

local HEAL_FRACTION = 0.4
local SHIELD_SECONDS = 8
local REMOTE_COOLDOWN = 0.25 -- seconds per player per remote
local USE_COOLDOWN = 0.6 -- after a successful use, so a double click cannot burn two items
local PROMPT_COOLDOWN = 0.5
local MAX_ID_LENGTH = 48
local PROMPT_NAME = "ItemShopPrompt"

----------------------------------------------------------------------
-- Optional collaborators (every use is guarded)
----------------------------------------------------------------------

local function loadShared(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[ItemService] missing shared module: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[ItemService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local ItemCatalog = loadShared("ItemCatalog")

local DamageService = nil
do
	local ok, result = pcall(require, script.Parent.DamageService)
	if ok and type(result) == "table" then
		DamageService = result
	end
end

local MatchService = nil
local matchResolved = false

-- MatchService is wired by Init(deps) or SetMatchService; as a last resort require the sibling.
local function getMatchService()
	if MatchService then
		return MatchService
	end
	if not matchResolved then
		matchResolved = true
		local ok, result = pcall(require, script.Parent.MatchService)
		if ok and type(result) == "table" then
			MatchService = result
		end
	end
	return MatchService
end

function ItemService.SetMatchService(matchService)
	MatchService = matchService
	matchResolved = true
end

----------------------------------------------------------------------
-- State + helpers
----------------------------------------------------------------------

local lastCall = {} -- [player] = { [key] = os.clock() }
local shields = {} -- [player] = { Bubble = Part|nil, Expires = os.clock() }
local useReadyAt = {} -- [player] = os.clock() after which the next Use is accepted
local remotesConnected = false
local playersConnected = false
local promptObject = nil

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function rateLimited(player, key, interval)
	local record = lastCall[player]
	if not record then
		record = {}
		lastCall[player] = record
	end
	local now = os.clock()
	local last = record[key]
	if last and now - last < interval then
		return true
	end
	record[key] = now
	return false
end

local function fireClient(remoteName, player, ...)
	local ok, remote = pcall(Remotes.Get, remoteName)
	if ok and remote and player and player.Parent then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function isDowned(player)
	if player:GetAttribute(Config.Attr.Downed) == true then
		return true
	end
	if DamageService and type(DamageService.IsDowned) == "function" then
		local ok, result = pcall(DamageService.IsDowned, player)
		return ok and result == true
	end
	return false
end

----------------------------------------------------------------------
-- Effects. Each returns ok, reasonOrMessage. None of them yields, so
-- "check the count, apply, consume" stays atomic.
----------------------------------------------------------------------

local function removeShield(player)
	local record = shields[player]
	if not record then
		return
	end
	shields[player] = nil
	local bubble = record.Bubble
	if bubble and bubble.Parent then
		Util.Tween(bubble, 0.4, { Transparency = 1 })
		Debris:AddItem(bubble, 0.5)
	end
end

local function makeBubble(player)
	local root = Util.GetRoot(player)
	local character = player.Character
	if not root or not character then
		return nil
	end
	local bubble = Instance.new("Part")
	bubble.Name = "ShieldBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.new(8, 8, 8)
	bubble.Material = Enum.Material.ForceField
	bubble.Color = Color3.fromRGB(120, 190, 235)
	bubble.Transparency = 0.25
	bubble.CastShadow = false
	bubble.CanCollide = false
	bubble.CanTouch = false
	bubble.CanQuery = false
	bubble.Massless = true
	bubble.Anchored = false
	bubble.CFrame = root.CFrame
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = bubble
	weld.Parent = bubble
	bubble.Parent = character
	return bubble
end

local function effectHeal(player, humanoid)
	if not DamageService or type(DamageService.Heal) ~= "function" then
		return false, "Healing is unavailable right now"
	end
	if humanoid.Health >= humanoid.MaxHealth - 0.01 then
		return false, "You are already at full health"
	end
	local ok, healed = pcall(DamageService.Heal, player, humanoid.MaxHealth * HEAL_FRACTION)
	if not ok or type(healed) ~= "number" or healed <= 0 then
		return false, "Could not heal right now"
	end
	return true, "Healed +" .. tostring(math.floor(healed + 0.5)) .. " HP"
end

local function effectShield(player)
	if not DamageService or type(DamageService.GrantInvulnerability) ~= "function" then
		return false, "Shields are unavailable right now"
	end
	local active = shields[player]
	if active and os.clock() < active.Expires and (active.Bubble == nil or active.Bubble.Parent ~= nil) then
		return false, "Your shield is still active"
	end
	removeShield(player)
	local ok = pcall(DamageService.GrantInvulnerability, player, SHIELD_SECONDS)
	if not ok then
		return false, "Could not raise the shield"
	end
	local record = { Bubble = makeBubble(player), Expires = os.clock() + SHIELD_SECONDS }
	shields[player] = record
	task.delay(SHIELD_SECONDS, function()
		if shields[player] == record then
			removeShield(player)
		end
	end)
	return true, "Shield up for " .. SHIELD_SECONDS .. " seconds"
end

-- Small ember burst where the teammate stands up.
local function phoenixBurst(player)
	local root = Util.GetRoot(player)
	if not root then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "PhoenixBurst"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = root.CFrame
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(226, 92, 70))
	emitter.LightEmission = 0.6
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.6),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(0.6, 1.1)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Acceleration = Vector3.new(0, 10, 0)
	emitter.Rate = 0
	emitter.Enabled = false
	emitter.Parent = anchor
	anchor.Parent = workspace
	emitter:Emit(28)
	Debris:AddItem(anchor, 2)
end

local function effectPhoenix(player, _, match)
	if not DamageService or type(DamageService.Revive) ~= "function" then
		return false, "Reviving is unavailable right now"
	end
	if not match or type(match.Players) ~= "table" then
		return false, "You are not in a match"
	end
	local ms = getMatchService()
	local myRoot = Util.GetRoot(player)
	local target = nil
	local bestDistance = math.huge
	for _, other in ipairs(match.Players) do
		if other ~= player and isLivePlayer(other) and isDowned(other) then
			local sameMatch = true
			if ms and type(ms.GetMatchOf) == "function" then
				local ok, theirs = pcall(ms.GetMatchOf, other)
				sameMatch = ok and theirs == match
			end
			if sameMatch then
				local root = Util.GetRoot(other)
				local distance = 1000000
				if root and myRoot then
					distance = (root.Position - myRoot.Position).Magnitude
				end
				if not target or distance < bestDistance then
					target = other
					bestDistance = distance
				end
			end
		end
	end
	if not target then
		return false, "No downed teammate to revive"
	end
	local ok = pcall(DamageService.Revive, target)
	if not ok or isDowned(target) then
		return false, "The feather could not revive them"
	end
	phoenixBurst(target)
	notify(target, player.DisplayName .. " revived you with a Phoenix Feather!", "good", 4)
	return true, "Revived " .. target.DisplayName .. "!"
end

local EFFECTS = {
	heal_cloud = effectHeal,
	shield_bubble = effectShield,
	phoenix_feather = effectPhoenix,
}

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function ItemService.Buy(player, itemId, qty)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(itemId) ~= "string" or #itemId > MAX_ID_LENGTH then
		return false, "Unknown item"
	end
	if qty == nil then
		qty = 1
	end
	local maxCarry = Config.Items.MaxCarry
	if type(qty) ~= "number" or qty ~= qty or qty < 1 or qty > maxCarry or qty % 1 ~= 0 then
		return false, "Invalid amount"
	end
	local def = ItemCatalog and ItemCatalog.Get(itemId)
	if not def then
		return false, "Unknown item"
	end
	if type(def.Price) ~= "number" or def.Price < 0 then
		return false, "That item is not for sale"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "The shop is closed during a match"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end

	local have = profile.Items[itemId] or 0
	local room = maxCarry - have
	if room <= 0 then
		return false, "You already carry the maximum (" .. maxCarry .. ")"
	end
	if qty > room then
		return false, "You can only carry " .. room .. " more"
	end
	local total = math.floor(def.Price * qty)
	if DataService.GetTokens(player) < total then
		return false, "Not enough cloud tokens"
	end
	if not DataService.SpendTokens(player, total) then
		return false, "Not enough cloud tokens"
	end
	profile.Items[itemId] = have + qty
	DataService.MarkDirty(player)
	DataService.Sync(player)
	return true
end

function ItemService.Use(player, itemId)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(itemId) ~= "string" or #itemId > MAX_ID_LENGTH then
		return false, "Unknown item"
	end
	local effect = EFFECTS[itemId]
	if not effect or not ItemCatalog or not ItemCatalog.Get(itemId) then
		return false, "Unknown item"
	end
	if player:GetAttribute(Config.Attr.InMatch) ~= true then
		return false, "Items only work inside a match"
	end
	if isDowned(player) then
		return false, "You can not use items while downed"
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return false, "You are not alive"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	if (profile.Items[itemId] or 0) <= 0 then
		return false, "You do not have that item"
	end
	local readyAt = useReadyAt[player]
	if readyAt and os.clock() < readyAt then
		return false, "Please wait a moment"
	end

	-- The match must exist and still be running.
	local match = nil
	local ms = getMatchService()
	if ms and type(ms.GetMatchOf) == "function" then
		local ok, found = pcall(ms.GetMatchOf, player)
		if ok then
			match = found
		end
		if not match then
			return false, "You are not in a match"
		end
		if match.State == "Ended" or match.Stopped == true then
			return false, "The match is over"
		end
		-- Items are for the run itself: the intro freeze (Countdown, or Setup before it) already grants
		-- invulnerability, so a shield used then would be wasted. Nothing is consumed on this refusal.
		if match.State ~= "Playing" then
			return false, "Wait for the countdown to finish"
		end
	end

	local ok, success, message = pcall(effect, player, humanoid, match)
	if not ok then
		warn("[ItemService] " .. itemId .. " errored: " .. tostring(success))
		return false, "Something went wrong"
	end
	if not success then
		return false, message
	end

	useReadyAt[player] = os.clock() + USE_COOLDOWN

	-- Consume exactly one (the effect did not yield, but re-read anyway).
	local remaining = (profile.Items[itemId] or 0) - 1
	if remaining > 0 then
		profile.Items[itemId] = remaining
	else
		profile.Items[itemId] = nil
	end
	DataService.MarkDirty(player)
	DataService.Sync(player)
	notify(player, message, "good", 2.5)
	return true
end

----------------------------------------------------------------------
-- Remotes (client -> server)
----------------------------------------------------------------------

local function connectRemotes()
	if remotesConnected then
		return
	end
	local okBuy, buyRemote = pcall(Remotes.Get, "BuyItem")
	local okUse, useRemote = pcall(Remotes.Get, "UseItem")
	if not (okBuy and okUse) then
		warn("[ItemService] item remotes are missing (did Remotes.Init run?)")
		return
	end
	remotesConnected = true

	buyRemote.OnServerEvent:Connect(function(player, itemId, qty)
		if rateLimited(player, "BuyItem", REMOTE_COOLDOWN) then
			return
		end
		if type(itemId) ~= "string" or #itemId > MAX_ID_LENGTH then
			return
		end
		if qty ~= nil and type(qty) ~= "number" then
			return
		end
		local ok, success, reason = pcall(ItemService.Buy, player, itemId, qty)
		if not ok then
			warn("[ItemService] Buy errored: " .. tostring(success))
			notify(player, "Something went wrong", "bad", 3)
		elseif success then
			local def = ItemCatalog and ItemCatalog.Get(itemId)
			local amount = qty or 1
			notify(player, "Bought " .. tostring(amount) .. " x " .. (def and def.Name or itemId), "good", 2.5)
		else
			notify(player, tostring(reason), "bad", 3)
		end
	end)

	useRemote.OnServerEvent:Connect(function(player, itemId)
		if rateLimited(player, "UseItem", REMOTE_COOLDOWN) then
			return
		end
		if type(itemId) ~= "string" or #itemId > MAX_ID_LENGTH then
			return
		end
		local ok, success, reason = pcall(ItemService.Use, player, itemId)
		if not ok then
			warn("[ItemService] Use errored: " .. tostring(success))
		elseif not success and reason then
			notify(player, tostring(reason), "bad", 2.5)
		end
	end)
end

local function connectPlayers()
	if playersConnected then
		return
	end
	playersConnected = true
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
		shields[player] = nil
		useReadyAt[player] = nil
	end)
end

----------------------------------------------------------------------
-- Item shop counter in the lobby
----------------------------------------------------------------------

local function buildPrompt(lobbyInfo)
	if promptObject and promptObject.Parent then
		promptObject:Destroy()
	end
	promptObject = nil

	local shop = type(lobbyInfo) == "table" and lobbyInfo.Shop
	local itemShop = type(shop) == "table" and shop.ItemShop
	local part = type(itemShop) == "table" and itemShop.PromptPart
	if not part or typeof(part) ~= "Instance" then
		warn("[ItemService] lobbyInfo.Shop.ItemShop.PromptPart missing: no item shop prompt created")
		return
	end
	local old = part:FindFirstChild(PROMPT_NAME)
	if old then
		old:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = PROMPT_NAME
	prompt.ActionText = "Open"
	prompt.ObjectText = "Item Shop"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	promptObject = prompt

	prompt.Triggered:Connect(function(player)
		if not isLivePlayer(player) then
			return
		end
		if player:GetAttribute(Config.Attr.InMatch) == true then
			return
		end
		if rateLimited(player, "Prompt", PROMPT_COOLDOWN) then
			return
		end
		fireClient("OpenPanel", player, "Shop", { Tab = "Items" })
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function ItemService.Init(lobbyInfo, deps)
	if type(deps) == "table" then
		if deps.DataService then
			DataService = deps.DataService
		end
		if deps.DamageService then
			DamageService = deps.DamageService
		end
		if deps.MatchService then
			ItemService.SetMatchService(deps.MatchService)
		end
	end
	if not ItemCatalog then
		warn("[ItemService] ItemCatalog is missing: the item shop is disabled")
	end
	connectRemotes()
	connectPlayers()
	buildPrompt(lobbyInfo)
end

return ItemService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="850">
          <Properties>
            <string name="Name">LightingService</string>
            <string name="Source"><![CDATA[-- LightingService: owns the sky, the atmosphere, the post effects, the moving sky clouds and the global
-- workspace rules (ARCHITECTURE_V3.md "Phase 6" 6.0.2 / 6.1 A2 and docs/phase6/style.md section 4).
--
-- Phase 6 look = the Phase 4 look again ("bright, warm afternoon"; P4 LOOK at 7aa0df2): a high warm sun, light shade
-- (no black creases on the voxels), exposure a little under 0 so the cloud whites keep their shades, subtle bloom
-- (only neon trims and tokens glow), colours a touch richer, faint sun rays. No golden hour, no purple haze.
--   * Look.Fallback no sky ids yet (the shipped Config): the stock sky with the P4 light sky-blue air and a soft peach
--                   horizon, white moving clouds and 2500 stars
--   * Look.Custom   the owner's painted skybox (branding/sky/*.png, the 6 ids pasted into Config.Sky.Faces): the same
--                   P4 light, a light pink air to match the painted sky, no engine stars (they are painted)
-- Init() picks Custom only when ALL SIX faces are set (one missing -> Fallback, with a warning that names it).
-- A face is the full content id Studio's Asset Manager copies (scheme://..., an Image id); anything else counts as unset.
-- The tuned numbers live in the Look table so the owner can tweak the mood in one place.
-- Lighting.Technology (ShadowMap, as in Phase 4) cannot be written from a script (plugin security):
-- default.project.json sets it. The server writes Lighting ONLY here, at boot; the client's LightingStack layers
-- its presets (dungeon, low graphics) on top. Plain Lua 5.1-compatible syntax only. Init() is idempotent.

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local LightingService = {}

local rgb = Color3.fromRGB

-- Shared by both looks (the same table in each, so a tweak applies to both): the Phase 4 numbers
local BLOOM = { Enabled = true, Intensity = 0.16, Size = 18, Threshold = 1.6 } -- only the brightest accents (neon, tokens) glow
local COLOR = { Enabled = true, Brightness = 0, Contrast = 0.1, Saturation = 0.14, TintColor = rgb(255, 250, 242) }
local SUNRAYS = { Enabled = true, Intensity = 0.06, Spread = 0.6 }
-- Depth of field stays off (it blurs the course edges players need to read).
local DOF = { Enabled = false, FarIntensity = 0.05, NearIntensity = 0, FocusDistance = 200, InFocusRadius = 160 }

-- The world light of Phase 4 (both looks): at latitude 34 and 14:30 the sun stands about 50 degrees up, voxel tops
-- are well lit, sides keep a readable shade and shadows stay short and crisp.
local function p4Light()
	return {
		ClockTime = 14.5,
		GeographicLatitude = 34,
		Brightness = 2.0,
		ExposureCompensation = -0.15, -- the near-white cloud voxels never blow out
		Ambient = rgb(98, 106, 132),
		OutdoorAmbient = rgb(132, 138, 160), -- no black creases
		ColorShift_Top = rgb(66, 50, 26), -- a warm sun
		ColorShift_Bottom = rgb(14, 20, 40), -- a cool sky bounce
		EnvironmentDiffuseScale = 0.6,
		EnvironmentSpecularScale = 0.35,
		GlobalShadows = true,
		ShadowSoftness = 0.3,
		FogStart = 0,
		FogEnd = 100000, -- the Atmosphere does the distance haze
	}
end

local FACE_KEYS = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }

LightingService.FaceKeys = FACE_KEYS

LightingService.Look = {
	Custom = {
		Lighting = p4Light(),
		Atmosphere = {
			Density = 0.28,
			Offset = 0.25,
			Color = rgb(240, 214, 232), -- light pink air to match the painted sky
			Decay = rgb(238, 200, 180), -- soft peach horizon
			Glare = 0.25,
			Haze = 1.0,
		},
		Sky = {
			StarCount = 0, -- the stars are painted in the custom sky
			CelestialBodiesShown = true,
			SunAngularSize = 11,
			MoonAngularSize = 9,
		},
		Clouds = { Enabled = true, Cover = 0.5, Density = 0.6, Color = rgb(252, 238, 246) },
		SunRays = SUNRAYS,
		Bloom = BLOOM,
		ColorCorrection = COLOR,
		DepthOfField = DOF,
	},
	Fallback = {
		Lighting = p4Light(),
		Atmosphere = {
			Density = 0.28,
			Offset = 0.25,
			Color = rgb(178, 198, 228), -- light sky-blue air (Phase 4)
			Decay = rgb(238, 200, 170), -- soft warm peach horizon (Phase 4)
			Glare = 0.25,
			Haze = 1.0,
		},
		Sky = {
			StarCount = 2500,
			CelestialBodiesShown = true,
			SunAngularSize = 16,
			MoonAngularSize = 9,
		},
		Clouds = { Enabled = true, Cover = 0.5, Density = 0.6, Color = rgb(240, 244, 252) }, -- soft white, never overcast
		SunRays = SUNRAYS,
		Bloom = BLOOM,
		ColorCorrection = COLOR,
		DepthOfField = DOF,
	},
}

-- the look Init() applied last: "Custom" | "Fallback" | nil (before Init)
LightingService.Current = nil

-- Assign every property in `props` to `inst`; a property that does not exist (or is not scriptable on this
-- engine version) only produces a warning instead of breaking boot.
local function setProps(inst, props)
	for key, value in pairs(props) do
		local ok, err = pcall(function()
			inst[key] = value
		end)
		if not ok then
			warn("[LightingService] could not set " .. inst.ClassName .. "." .. tostring(key) .. ": " .. tostring(err))
		end
	end
end

-- Reuse the first child of `className` under `parent`, otherwise create one (idempotent; a place that already
-- ships a Sky / Atmosphere does not double up).
local function ensure(parent, className, name)
	local inst = parent:FindFirstChildOfClass(className)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = parent
	end
	return inst
end

-- One face id: the trimmed content URL (the "Copy ID" text Studio gives, scheme://...), nil when empty or unusable
-- (a bare number, junk, a non-string), so the fallback look is used instead of a grey box.
function LightingService.FaceId(value)
	if type(value) ~= "string" then
		return nil
	end
	local s = value:match("^%s*(.-)%s*$")
	if s:match("^%a[%w%+%.%-]*://%S+$") then
		return s
	end
	return nil
end

-- { Bk = id, ... } when all six faces of Config.Sky.Faces are usable, else nil + the list of missing / bad keys.
function LightingService.CustomFaces()
	local faces = (type(Config.Sky) == "table" and type(Config.Sky.Faces) == "table") and Config.Sky.Faces or {}
	local out, missing, any = {}, {}, false
	for _, key in ipairs(FACE_KEYS) do
		local raw = faces[key]
		local id = LightingService.FaceId(raw)
		if id then
			out[key] = id
			any = true
		else
			missing[#missing + 1] = key
			if raw ~= nil and raw ~= "" then
				any = true
			end
		end
	end
	if #missing > 0 then
		return nil, missing, any
	end
	return out, missing, any
end

-- workspace.Terrain.Clouds (skipped quietly when the engine has no Terrain or no Clouds class).
local function applyClouds(props)
	local terrain = Workspace:FindFirstChildOfClass("Terrain")
	if not terrain then
		return
	end
	local ok, err = pcall(function()
		setProps(ensure(terrain, "Clouds", "NimbusClouds"), props)
	end)
	if not ok then
		warn("[LightingService] sky clouds skipped: " .. tostring(err))
	end
end

-- Global physics / world rules. StreamingEnabled is deliberately left alone (false). Spawning is NOT decided
-- here: Main / PlayerService hold the character until the menu's PLAY (7.2), so CharacterAutoLoads is untouched.
function LightingService.ApplyWorldRules()
	setProps(Workspace, {
		Gravity = Config.Physics.Gravity,
		FallenPartsDestroyHeight = -2000, -- far below the lobby kill plane and every course kill plane
	})
end

function LightingService.Init()
	local faces, missing, any = LightingService.CustomFaces()
	local name = faces and "Custom" or "Fallback"
	if not faces and any then
		-- the owner started pasting ids: say which ones are still missing / unreadable (a warning, not an error)
		warn("[LightingService] Config.Sky.Faces is missing " .. table.concat(missing, ", ") .. " (paste the full id from Asset Manager -> Copy ID): using the fallback sky until all six are set")
	end
	local look = LightingService.Look[name]

	setProps(Lighting, look.Lighting)
	setProps(ensure(Lighting, "Atmosphere", "NimbusAtmosphere"), look.Atmosphere)
	local sky = ensure(Lighting, "Sky", "NimbusSky")
	setProps(sky, look.Sky)
	local skybox = {}
	for _, key in ipairs(FACE_KEYS) do
		-- the fallback clears the faces (the engine's stock sky); Init twice gives the same Sky
		skybox["Skybox" .. key] = faces and faces[key] or ""
	end
	setProps(sky, skybox)
	setProps(ensure(Lighting, "BloomEffect", "NimbusBloom"), look.Bloom)
	setProps(ensure(Lighting, "SunRaysEffect", "NimbusSunRays"), look.SunRays)
	setProps(ensure(Lighting, "ColorCorrectionEffect", "NimbusColor"), look.ColorCorrection)
	setProps(ensure(Lighting, "DepthOfFieldEffect", "NimbusDepthOfField"), look.DepthOfField)
	applyClouds(look.Clouds)

	LightingService.Current = name
	LightingService.ApplyWorldRules()
	return name
end

return LightingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="851">
          <Properties>
            <string name="Name">LobbyBuilder</string>
            <string name="Source"><![CDATA[-- LobbyBuilder (v3): builds the Nimbus Climb sky village in the DETAILED VOXEL style
-- (ARCHITECTURE_V3.md, "ART DIRECTION" + section 6), sculpted with shared/Voxel.lua.
--
-- Top view (+X right, +Z up the page, angles in degrees: x = cos, z = sin, plaza centre = Origin):
--
--   * PLAZA          a big round cloud island (Phase 5: PlazaRadius 150, 1.8x the Phase 4 area). Its body is a tiered
--                    voxel cloud (white / light-blue, tagged NC_StyleExempt); the top is built in the Phase 4 look again
--                    (Phase 6, 6.0.2 / 6.1 A1: SmoothPlastic, bright lime grass, cream stone paths with darker borders,
--                    glow in Neon) on the Phase 5 layout: the spawn court (concentric cream stone tile rings, a light
--                    ring, a gold sun medallion with Neon arrows in the gate colours), the grand avenue to the Gate
--                    Court (stone kerbs, lamps every 16 studs, a tall cream welcome arch at r 40 carrying the welcome
--                    sign), the circle walk (r 100) with clipped hedges and lamps, the east / west walks, the shop
--                    boardwalk with the fountain roundabout, lawns with trees, benches, flower beds and the six NPC
--                    spots, a kerb along the edge.
--   * GATE COURT     (6.1) a sector 48..132 degrees, r 96..146: cream tile rings, a light rim, a raised terrace with
--                    hedges, a banner behind every gate and two obelisks. Five gates left -> right Obby, Dungeon, Ring,
--                    Arena, Altar on the arc r Config.Lobby.GateArcRadius, spread evenly over the court's six Phase 5
--                    slots (GateStep degrees apart) around GateFacing, the Ring gate in the middle, every gate facing
--                    the spawn (WorldStyle.BuildGate: the P4 round voxel hoop family, 6.0.3). Phase 6: no Home gate (the
--                    player asked; the Home window's Go home portal is the way home). This module builds Obby and Altar
--                    into the Gates folder; ArenaBuilder adds Ring + Arena, DungeonBuilder the Dungeon gate.
--   * SHOP ISLAND    at Config.Lobby.ShopOffset: four voxel gacha machines (Model Roulette_<Id>, built in
--                    the roulette colour), the striped item stall (Model ItemShop), a rarity board, a token
--                    statue and an entrance arch, joined to the plaza by a short stone neck.
--   * HOME PLOTS     Config.Lobby.SpotCount cloud islands on Config.Lobby.SpotRingRadius: a puffy cloud body
--                    (billows along the sides and back, a hanging cumulus underneath, a soft rim of puffs on the
--                    outer margins) under a flat PlotSize x PlotSize mowed lawn yard (kept EMPTY for the
--                    phase-2 home), fence posts and rails, a gate facing the ring street, a mailbox with the
--                    nameplate, the pet podium.
--   * RING STREET    a stone street along the front of every plot; wooden bridges join neighbouring plots
--                    at the junctions. Wooden spoke bridges (supported by cloud puffs) join the plaza to every
--                    other junction; two garden islands hang off the street; one junction slot stays free for
--                    the Storm Altar (LobbyInfo.AltarSite).
--   * SKY            voxel cumulus clouds around the village and one far below it.
--
-- LobbyBuilder.Build() -> LobbyInfo (ARCHITECTURE.md / _V2 / _V3 contract):
--   Folder, SpawnCFrame, Portals = { Obby = PortalInfo (+ Model, PromptPart) } (Phase 5: the one Sky Obby portal),
--   Spots[i] = SpotInfo, Shop = { Roulettes[id], ItemShop },
--   NpcSpots = { CFrame x6 }   ground-level CFrames on the plaza lawn beside the walkways, LookVector = towards
--                              the walkway / court, each with ~5 studs of free space for an NPC pedestal
--   AltarSite = CFrame | nil   reserved, empty spot inside the ring for the Storm Altar island (faces the plaza)
--   AltarDock = Vector3 | nil  inner edge of the street junction in front of it (where a bridge can dock; that
--                              junction's inner rope rail is left open for the altar's bridge and gate)
--   Phase 3 (built by ArenaBuilder into workspace.BattleArena; the lobby only keeps their ground free):
--   ArenaAngle = degrees | nil  the spoke just past the last portal; its junction's OUTER rope rail is open
--   ArenaDock = Vector3 | nil   outer edge of that junction on the spoke's ray: the arena bridge leaves the street here
--   ArenaBridgeWidth = studs    the arena bridge's deck width (the rail gap is 1.6 studs wider)
--   Phase 5 (6.1): GateSites = { Obby, Dungeon, Ring, Arena, Altar } ground CFrames of the gate centres
--                              (LookVector = towards the plaza centre); RingSite = GateSites.Ring; DungeonSite =
--                              GateSites.Dungeon; GatesFolder = workspace.NimbusLobby.Gates; Gates = { Obby, Altar
--                              = { Model, Pad, PromptPart } } (GateService / PortalService put the prompts on them).
--                              NimbusLobby.PartCount is written by Main after the last gate builder, not here.
-- SpotInfo also carries PlotCFrame (centre of the flat yard surface, LookVector = towards the gate),
-- PlotSize (= Config.Lobby.PlotSize), GateCFrame (gate, on the ground) and Accent (the plot colour).
-- Spot folders are named Spot_NN and carry the attribute SpotIndex; portal / roulette models are named
-- Portal_<Id> / Roulette_<Id> (tutorial targets).
--
-- Walkability: every walking surface is a flat collidable part at the plaza height (TOP); layers that meet
-- differ by at most 0.3 studs (no gaps, no jumps, no z-fighting: overlapping layers are offset in height).
-- Decor stands on the surface under it: props on the lawn sit LAWN studs under TOP (nothing hovers), pennants
-- hang from their rope, puffs under bridges stop at the deck, and no cloud rises over a path or an exit.
-- No server-side animation (v3 replication rule): life comes from ParticleEmitters and lights only.
--
-- Part budget: the lobby with all six gates <= 8000 parts after the greedy voxel merge (10.3). Repeated decor (trees, lamps, benches, flower beds,
-- the whole plot with its island, fence and gate, cloud puffs, sky clouds) is sculpted once and :Clone()d.
-- No external assets: Parts, built-in particle textures and Theme-styled GUI text. Deterministic (seeded).
-- ProximityPrompts are NOT created here: PetService / ItemService attach them to the PromptParts.
--
-- Robustness: gates, spots, the shop machines and the item stall are what other services depend on. Each
-- is built inside pcall with a plain-part fallback that still returns the same LobbyInfo shape (the
-- fallbacks also cover a missing shared/Voxel module), and all decoration runs in guarded sections.
-- Plain Lua 5.1-compatible syntax only.

local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)

local LobbyBuilder = {}

local function loadShared(name)
	local inst = Shared:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[LobbyBuilder] shared/" .. name .. " unavailable: " .. tostring(result))
	return nil
end

local Voxel = loadShared("Voxel")
local WorldStyle = loadShared("WorldStyle")
local DETAIL_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Detail) or "NC_Detail" -- pure decor (Low graphics hides it)
local EXEMPT_TAG = (WorldStyle and WorldStyle.Tags and WorldStyle.Tags.Exempt) or "NC_StyleExempt" -- voxel clouds / pets / tokens

----------------------------------------------------------------------
-- Constants
----------------------------------------------------------------------

local LOBBY = Config.Lobby
local ORIGIN = LOBBY.Origin
local TOP = ORIGIN.Y -- y of every walking surface
local LAWN = 0.4 -- the lawn layer's top sits this far under TOP (paths 0, borders -0.1, patches -0.3)
local OX, OZ = ORIGIN.X, ORIGIN.Z
local PLAZA_R = (LOBBY.PlazaRadius or 110) + 6 -- walkable radius of the plaza ground
local SPOT_R = LOBBY.SpotRingRadius or 300
local SPOT_COUNT = math.max(1, LOBBY.SpotCount or 16)
local PLOT = LOBBY.PlotSize or 72
local SEED = 20261009
local MAT = Enum.Material
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

-- Glyphs as UTF-8 byte escapes (keeps the source file ASCII).
local GLYPH = {
	StarFull = "\226\152\133",
	StarEmpty = "\226\152\134",
	Cloud = "\226\152\129",
	Bullet = "\226\128\162",
	Ellipsis = "\226\128\166",
}

local function atan2(y, x)
	if math.atan2 then
		return math.atan2(y, x)
	end
	return math.atan(y, x)
end

-- Layout numbers (studs). Plot-local frames: origin = yard centre on the ground, -Z = towards the plaza
-- (the gate side), +X = across.
local G = {}
-- Phase 5 Gate Court (6.1): six gates on an arc in front of the spawn
G.GateR = LOBBY.GateArcRadius or 118
G.GateStep = LOBBY.GateStep or 14.5
G.GateFacing = LOBBY.GateFacing or 90
G.CourtSlots = 6 -- Phase 6: the court keeps its Phase 5 width of six gate slots; the five gates spread over it
G.CourtR = 34 -- the spawn court (Slate rings + a Marble ring around the medallion)
G.AvenueHalf = 10 -- the grand avenue to the Gate Court (20 wide, Cobblestone, Brick kerbs)
G.RingRoadR = 100 -- the cobbled circle walk around the lawns (the spokes leave it)
G.CourtIn = 96 -- the Gate Court sector: Slate rings from r 96 ...
G.CourtOut = 146 -- ... to r 146
G.TerraceIn = 126 -- the raised terrace behind the gates (r 126 .. 146)
G.TerraceLift = 0.3
G.PadR = G.GateR - 14 -- pad centres (WorldStyle.BuildGate puts the pad 14 studs in front of the gate)
G.PathHalf = 5 -- radial stone paths (half width incl. border)
G.BoardHalf = 7 -- the wooden boardwalk to the shop
G.StubHalf = 5 -- sand paths to the spoke bridges
G.FountainD = 66 -- fountain roundabout, distance from the centre towards the shop
G.Step = 360 / SPOT_COUNT
G.HalfStep = G.Step / 2
G.PlotHalf = PLOT / 2
G.Verge = 4
G.StreetW = 14
G.StreetZ = -(G.PlotHalf + G.Verge + G.StreetW / 2) -- plot-local z of the street centre line
G.StreetR = SPOT_R + G.StreetZ -- distance of the street centre line from the origin
G.IslandHalfX = G.PlotHalf + 6
G.IslandBack = G.PlotHalf + 6
G.IslandFront = G.StreetZ - G.StreetW / 2
G.JunctionX = G.StreetR * math.tan(math.rad(G.HalfStep)) -- plot-local x of the junctions
G.StreetExt = (G.StreetW / 2) * math.tan(math.rad(G.HalfStep)) + 0.8 -- overlap past the junction
G.SpokeEndR = (G.StreetR - G.StreetW / 2) / math.cos(math.rad(G.HalfStep)) + 2.4
G.SpokeW = 10
G.GardenR = (PLAZA_R + G.StreetR - G.StreetW / 2) / 2 -- garden island centres, halfway between the plaza and the street (221)
G.GardenSize = 22 -- garden island radius
G.ArenaBridgeW = 12 -- Phase 3: the arena bridge (ArenaBuilder) leaves the street through a gap this wide + 1.6

----------------------------------------------------------------------
-- Palette: cheerful but not blinding. Nothing is pure white (cloud tops stay below 249 on red).
----------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Phase 6 (6.0.2 / 6.1 A1): the Phase 4 look again (7aa0df2 LobbyBuilder palette): bright lime grass, cream stone
-- paths with darker borders, white / light-blue clouds, everything SmoothPlastic (glow Neon, water Glass). The
-- Phase 5 layout keys (Slate courts, Marble rings and arches, Navy signs) keep their names with P4 colours.
local C = {
	CloudLight = rgb(244, 247, 252),
	Cloud = rgb(232, 238, 249),
	CloudShade = rgb(212, 222, 241),
	Mist = rgb(194, 211, 240),
	MistDark = rgb(170, 190, 228),
	Grass = rgb(108, 186, 86),
	GrassLight = rgb(132, 202, 98),
	GrassDark = rgb(86, 160, 76),
	Hedge = rgb(74, 146, 72),
	HedgeLight = rgb(100, 170, 84),
	Stone = rgb(208, 202, 190), -- cream stone paths
	StoneLight = rgb(226, 221, 209),
	StoneDark = rgb(172, 164, 154),
	StoneEdge = rgb(146, 138, 132), -- path borders / kerbs
	Slate = rgb(214, 208, 196), -- the courts: cream stone tiles (a hair lighter than the paths)
	SlateLight = rgb(228, 223, 211),
	SlateDark = rgb(172, 164, 154),
	Marble = rgb(242, 237, 226), -- the courts' light rings, arches, columns
	MarbleShade = rgb(226, 221, 209),
	Sand = rgb(236, 214, 166),
	SandDark = rgb(212, 186, 138),
	Plank = rgb(196, 146, 98),
	PlankLight = rgb(214, 166, 114),
	PlankDark = rgb(152, 108, 72),
	Bark = rgb(132, 92, 62),
	Iron = rgb(64, 70, 92),
	IronLight = rgb(96, 104, 130),
	Gold = rgb(244, 198, 84),
	GoldDark = rgb(206, 154, 62),
	Lamp = rgb(255, 214, 140),
	Water = rgb(92, 178, 236),
	WaterDeep = rgb(62, 136, 212),
	Leaf = rgb(98, 178, 80),
	Pine = rgb(60, 138, 92),
	Blossom = rgb(246, 174, 204),
	BlossomWhite = rgb(250, 228, 238),
	Soil = rgb(120, 86, 64),
	Navy = rgb(34, 42, 76),
	Violet = rgb(68, 60, 118),
	Ink = (Theme.Colors and Theme.Colors.Ink) or rgb(26, 32, 64),
	Text = rgb(238, 243, 252),
	TextDim = rgb(190, 202, 230),
	TextGold = rgb(246, 216, 132),
	StarOff = rgb(96, 104, 136),
	Rose = rgb(234, 120, 146),
	Cream = rgb(246, 234, 210),
	PanelTop = rgb(68, 60, 118), -- sign GUI panels only (never a part colour)
	PanelBottom = rgb(34, 42, 76),
}

-- Material of every colour key: the P4 look is SmoothPlastic everywhere; lamps glow (Neon), water is Glass.
-- (materialOf keeps the Phase 5 material names working: they all resolve to SmoothPlastic.)
local MATS = {
	Lamp = "Neon", Water = "Glass", WaterDeep = "Glass",
}
local LOOK_MATERIALS = { Neon = MAT.Neon, Glass = MAT.Glass, SmoothPlastic = MAT.SmoothPlastic }
local function materialOf(name)
	return LOOK_MATERIALS[name] or MAT.SmoothPlastic
end
-- colour -> material for box() calls that pass a C colour (keyed by "r,g,b": Color3 values are not table keys)
local function colorKey(color)
	return string.format("%d,%d,%d", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end
local MAT_BY_COLOR = {}
for key, name in pairs(MATS) do
	if C[key] then
		MAT_BY_COLOR[colorKey(C[key])] = materialOf(name)
	end
end

local FLOWERS = {
	rgb(246, 150, 188), -- pink
	rgb(250, 214, 92), -- yellow
	rgb(244, 244, 248), -- white (not pure)
	rgb(172, 142, 232), -- violet
	rgb(236, 104, 108), -- red
	rgb(112, 172, 240), -- blue
}

-- One accent per home plot (cycled): banner, mailbox flag, podium trim.
local ACCENTS = {
	rgb(232, 112, 132),
	rgb(240, 160, 84),
	rgb(236, 204, 92),
	rgb(108, 192, 124),
	rgb(86, 186, 206),
	rgb(98, 148, 226),
	rgb(154, 122, 222),
	rgb(222, 120, 192),
}

-- The five gates of the Gate Court, left -> right (6.1 / 6.2): id, gate colour (WorldStyle.Palette.Accent), glyph.
-- (Phase 6: the Home gate is gone; players go home with the Home window's Go home button.)
local GATE_SPECS = {
	{ Id = "Obby", Accent = "Blue", Glyph = "cloud" },
	{ Id = "Dungeon", Accent = "Purple", Glyph = "torch" },
	{ Id = "Ring", Accent = "Gold", Glyph = "crown" },
	{ Id = "Arena", Accent = "Red", Glyph = "swords" },
	{ Id = "Altar", Accent = "Cyan", Glyph = "bolt" },
}
local function gateAccent(name)
	local acc = WorldStyle and WorldStyle.Palette and WorldStyle.Palette.Accent
	return (acc and acc[name]) or C.Gold
end

-- One palette for every voxel grid (keys are shared; Voxel derives missing _Light / _Dark variants).
local P = {}
for key, color in pairs(C) do
	P[key] = { Color = color, Material = materialOf(MATS[key] or "SmoothPlastic") }
end
P.GoldGlow = { Color = C.Gold, Material = MAT.Neon }
P.Water = { Color = C.Water, Material = materialOf("Glass"), Transparency = 0.35 }
for i, color in ipairs(FLOWERS) do
	P["Flower" .. i] = { Color = color, Material = materialOf("LeafyGrass") }
end
for i, spec in ipairs(GATE_SPECS) do
	P["Gate" .. i] = { Color = gateAccent(spec.Accent), Material = MAT.Neon }
end

-- Cloud keys used by tiers, from the top tier down (height-banded shading: cheap and soft).
local TIER_KEYS = { "CloudLight", "Cloud", "CloudShade", "Mist", "MistDark" }

----------------------------------------------------------------------
-- Per-build state
----------------------------------------------------------------------

local templates = {} -- name -> unparented Model built at the origin, cloned with place()
local reserved = {} -- { x, z, radius } world circles taken by plaza decor (keeps props apart)

----------------------------------------------------------------------
-- Small math helpers
----------------------------------------------------------------------

local function polar(angleDeg, radius, y)
	local a = math.rad(angleDeg)
	return Vector3.new(OX + math.cos(a) * radius, y or TOP, OZ + math.sin(a) * radius)
end

local function dirOf(angleDeg)
	local a = math.rad(angleDeg)
	return Vector3.new(math.cos(a), 0, math.sin(a))
end

-- CFrame at `pos` looking (flat) at `target`.
local function flatLook(pos, target)
	local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	if d.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + d.Unit)
end

local function faceCentre(pos)
	return flatLook(pos, Vector3.new(OX, pos.Y, OZ))
end

local function angleDiff(a, b)
	local d = math.abs((a - b) % 360)
	if d > 180 then
		d = 360 - d
	end
	return d
end

local function nearAny(angle, list, half)
	for _, other in ipairs(list or {}) do
		if angleDiff(angle, other) < half then
			return true
		end
	end
	return false
end

-- angle inside [from, to] (degrees, from may be negative)
local function angleIn(angle, from, to)
	local a = (angle - from) % 360
	return a <= (to - from)
end

local function clamp(v, lo, hi)
	if v < lo then
		return lo
	elseif v > hi then
		return hi
	end
	return v
end

-- Deterministic hash of integers -> [0, 1). The squared term makes hashes with different seeds independent.
local function hash3(x, y, z, seed)
	local h = (x * 73856093 + y * 19349663 + z * 83492791 + seed * 2654435761) % 2147483647
	h = (h * 16807) % 2147483647
	local a = h % 65521
	a = (a * a + seed * 7919 + 12345) % 65521
	h = ((h + a * 32771) * 16807) % 2147483647
	return h / 2147483647
end

-- Smooth 2D value noise in 0..1 (deterministic).
local function vnoise(x, z, scale, seed)
	local fx, fz = x / scale, z / scale
	local x0, z0 = math.floor(fx), math.floor(fz)
	local tx, tz = fx - x0, fz - z0
	tx = tx * tx * (3 - 2 * tx)
	tz = tz * tz * (3 - 2 * tz)
	local a, b = hash3(x0, 0, z0, seed), hash3(x0 + 1, 0, z0, seed)
	local c, d = hash3(x0, 0, z0 + 1, seed), hash3(x0 + 1, 0, z0 + 1, seed)
	local ab = a + (b - a) * tx
	local cd = c + (d - c) * tx
	return ab + (cd - ab) * tz
end

----------------------------------------------------------------------
-- Instance helpers
----------------------------------------------------------------------

local function newFolder(parent, name)
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

local function newModel(parent, name)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- One anchored block. opts: Collide (default false), Material, Transparency, Shadow, Reflectance.
local function box(parent, name, cf, size, color, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	-- the P4 look: SmoothPlastic unless the caller (or the colour: lamps, water) says Neon / Glass
	p.Material = opts.Material or MAT_BY_COLOR[colorKey(color)] or MAT.SmoothPlastic
	p.Transparency = opts.Transparency or 0
	if opts.Reflectance then
		p.Reflectance = opts.Reflectance
	end
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = opts.Collide == true
	p.CanQuery = opts.Collide == true or opts.Query == true
	p.CanTouch = false
	if opts.Shadow ~= nil then
		p.CastShadow = opts.Shadow == true
	else
		p.CastShadow = math.max(size.X, size.Y, size.Z) >= 4
	end
	p.Parent = parent
	return p
end

-- Invisible part used to host emitters / billboards / lights.
local function anchorPart(parent, name, pos, size)
	local p = box(parent, name, CFrame.new(pos), size or Vector3.new(1, 1, 1), C.Cloud, { Transparency = 1, Shadow = false })
	return p
end

local FADE_IN_OUT = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.25, 0.2),
	NumberSequenceKeypoint.new(0.75, 0.2),
	NumberSequenceKeypoint.new(1, 1),
})

local function popSize(maxSize)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, maxSize),
		NumberSequenceKeypoint.new(1, 0),
	})
end

-- Sparkle ParticleEmitter with soft defaults; `props` overrides anything.
local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLES
	e.Color = ColorSequence.new(C.TextGold)
	e.LightEmission = 0.6
	e.LightInfluence = 0
	e.Rate = 6
	e.Lifetime = NumberRange.new(1.5, 2.5)
	e.Speed = NumberRange.new(1, 2)
	e.Size = popSize(0.7)
	e.Transparency = FADE_IN_OUT
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	if props then
		for key, value in pairs(props) do
			e[key] = value
		end
	end
	e.Parent = parent
	return e
end

local function pointLight(parent, color, brightness, range)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- GUI helpers (all text goes through Theme font roles)
----------------------------------------------------------------------
-- World text rule (ARCHITECTURE_V3.md, added after the playtest "letters too small"):
--   * Tags above things are PIXEL-sized BillboardGuis (offset UDim2), so their text keeps one on-screen size at
--     any distance: names >= 22 px and info lines >= 18 px at 1080p, outlined glyphs on a compact solid plate
--     that sizes itself to its text, LightInfluence 0 and a MaxDistance of ~60-120 studs.
--   * Signs on surfaces are SurfaceGuis at SIGN_PPS pixels per stud with FIXED text sizes: titles >= 1 stud,
--     info lines >= 0.6 stud.
--   * Never TextScaled in the world: the engine drew the auto-scaled world text tiny in the playtest.

local INK = (Theme.Colors and Theme.Colors.TextStroke) or C.Ink
local TAG_NAME = 28 -- px: the name / title of a tag
local TAG_INFO = 20 -- px: info lines of a tag
local TAG_SMALL = 18 -- px: badges and pills (the info-line minimum)
local TAG_RANGE = 110 -- studs: MaxDistance of an ordinary tag
local SIGN_PPS = 50 -- pixels per stud on every surface sign
local SIGN_TITLE = 56 -- px at SIGN_PPS = 1.12 studs
local SIGN_INFO = 30 -- px at SIGN_PPS = 0.6 stud

-- Pixel-sized tag on `adornee`. The `w` x `h` container is transparent (the plate inside sizes itself to its
-- text); SizeOffset puts the container's BOTTOM edge on the adornee, raised `lift` studs in world space, so the
-- tag grows upwards and never sinks into what it labels, whatever the camera distance.
local function newTag(adornee, name, w, h, lift, maxDistance)
	local gui = Instance.new("BillboardGui")
	gui.Name = name or "Tag"
	gui.Size = UDim2.fromOffset(w, h)
	gui.SizeOffset = Vector2.new(0, 0.5)
	gui.StudsOffsetWorldSpace = Vector3.new(0, lift or 0, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = maxDistance or TAG_RANGE
	gui.ClipsDescendants = false
	gui.Adornee = adornee
	gui.Parent = adornee
	return gui
end

local function listLayout(parent, direction, gap, hAlign)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction or Enum.FillDirection.Vertical
	layout.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, gap or 0)
	layout.Parent = parent
	return layout
end

local function padding(parent, top, left, bottom, right)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingLeft = UDim.new(0, left)
	pad.PaddingBottom = UDim.new(0, bottom or top)
	pad.PaddingRight = UDim.new(0, right or left)
	pad.Parent = parent
	return pad
end

local function rounded(parent, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = (type(radius) == "number") and UDim.new(0, radius) or radius
	corner.Parent = parent
	return corner
end

local function outline(parent, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = thickness
	stroke.Transparency = transparency or 0
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = parent
	return stroke
end

local function vgradient(parent, top, bottom)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

local function plainFrame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	if props then
		for key, value in pairs(props) do
			f[key] = value
		end
	end
	f.Parent = parent
	return f
end

-- The compact solid plate of a tag in the HUD card look (navy gradient, rounded, a thick outline in `edge`),
-- sized to its content and standing on the bottom centre of the tag; its children are laid out by a list.
local function tagPlate(gui, edge, minW, direction, gap)
	local plate = plainFrame(gui, "Plate", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(minW or 0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Color3.fromRGB(255, 255, 255), -- the gradient supplies the colour
		BackgroundTransparency = 0.04,
	})
	rounded(plate, 16)
	outline(plate, edge or C.TextGold, 3.5)
	vgradient(plate, (Theme.Colors and Theme.Colors.PanelLight) or C.Violet, (Theme.Colors and Theme.Colors.Panel) or C.Navy)
	padding(plate, 7, 16, 9)
	listLayout(plate, direction, gap or 2)
	return plate
end

-- Fixed-size outlined text that sizes itself to its text (tags, pills, list layouts).
local function tagText(parent, name, text, role, size, color, order, thickness)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color or C.Text,
		Stroke = 1, -- the glyph outline below replaces the classic text stroke
		Outline = thickness or 2.5,
		OutlineColor = INK,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, size + 4),
			TextWrapped = false,
			LayoutOrder = order or 0,
		},
	})
	label.Parent = parent
	return label
end

-- A rounded colour pill around one short text (status, price, rarity). Returns pill, label.
local function tagPill(parent, name, text, role, size, fill, order)
	local pill = plainFrame(parent, name, {
		Size = UDim2.fromOffset(0, size + 8),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = fill,
		BackgroundTransparency = 0,
		LayoutOrder = order or 0,
	})
	rounded(pill, math.floor(size * 0.55))
	outline(pill, INK, 2.5)
	padding(pill, 2, math.floor(size * 0.5), 3)
	local label = tagText(pill, name .. "Label", text, role, size, C.Text, 1, 2)
	return pill, label
end

local function surfaceGui(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SIGN_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = part
	return gui
end

-- Navy -> violet rounded panel with a soft golden outline, filling the whole SurfaceGui.
local function signPanel(gui, strokeColor)
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- UIGradient multiplies this
	panel.BorderSizePixel = 0
	vgradient(panel, C.PanelTop, C.PanelBottom)
	rounded(panel, 24)
	outline(panel, strokeColor or C.TextGold, 6, 0.2)
	panel.Parent = gui
	return panel
end

-- Sign text with a FIXED size (px at SIGN_PPS), placed with fractions of its parent (x, y, w, h).
local function signText(parent, text, role, size, color, name, x, y, w, h, align, wrap)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Stroke = 1,
		Outline = math.max(2, math.floor(size / 16 + 0.5)),
		OutlineColor = INK,
		Props = {
			Name = name,
			Position = UDim2.new(x, 0, y, 0),
			Size = UDim2.new(w, 0, h, 0),
			TextWrapped = wrap == true,
			TextXAlignment = align or Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	label.Parent = parent
	return label
end

local function textGradient(label, keypoints, rotation)
	local seq = {}
	for _, kp in ipairs(keypoints) do
		seq[#seq + 1] = ColorSequenceKeypoint.new(kp[1], kp[2])
	end
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(seq)
	g.Rotation = rotation or 0
	g.Parent = label
	return g
end

local function hex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

-- "50 <cloud>" / "5,000 <cloud>"
local function priceText(price)
	return Util.Commas(price) .. " " .. GLYPH.Cloud
end

-- Rich-text star row: `filled` gold stars then dim hollow ones up to `total`.
local function starRow(filled, total)
	local out = string.format('<font color="%s">%s</font>', hex(C.TextGold), string.rep(GLYPH.StarFull, filled))
	if total > filled then
		out = out .. string.format('<font color="%s">%s</font>', hex(C.StarOff), string.rep(GLYPH.StarEmpty, total - filled))
	end
	return out
end

-- A key-cap chip + a description: one row of a notice board (fractions of the 550 x 400 px board canvas).
local function keyRow(parent, y, rowH, keyText, descText)
	local chip = Instance.new("Frame")
	chip.Name = "KeyChip"
	chip.Size = UDim2.new(0.27, 0, rowH, 0)
	chip.Position = UDim2.new(0.04, 0, y, 0)
	chip.BackgroundColor3 = rgb(58, 66, 100)
	chip.BorderSizePixel = 0
	rounded(chip, 12)
	outline(chip, C.TextGold, 2.5, 0.25)
	chip.Parent = parent
	signText(chip, keyText, "Heading", SIGN_INFO, C.TextGold, "Key", 0, 0, 1, 1)
	signText(parent, descText, "Body", SIGN_INFO, C.Text, "Desc", 0.335, y, 0.64, rowH, Enum.TextXAlignment.Left)
end

----------------------------------------------------------------------
-- Voxel helpers
----------------------------------------------------------------------

local VX = {}

-- Vertical cylinder of voxels (voxel units). keep = only fill empty voxels.
function VX.Disc(g, cx, cz, r, y0, y1, key, keep)
	local ri = math.ceil(r) + 1
	local r2 = r * r
	for y = y0, y1 do
		for x = math.floor(cx) - ri, math.ceil(cx) + ri do
			for z = math.floor(cz) - ri, math.ceil(cz) + ri do
				local dx, dz = x - cx, z - cz
				if dx * dx + dz * dz <= r2 and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

function VX.Ring(g, cx, cz, r0, r1, y0, y1, key)
	local ri = math.ceil(r1) + 1
	for y = y0, y1 do
		for x = math.floor(cx) - ri, math.ceil(cx) + ri do
			for z = math.floor(cz) - ri, math.ceil(cz) + ri do
				local dx, dz = x - cx, z - cz
				local d = math.sqrt(dx * dx + dz * dz)
				if d >= r0 and d <= r1 then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- Inclusive integer box of voxels.
function VX.Fill(g, x0, x1, y0, y1, z0, z1, key)
	for y = y0, y1 do
		for x = x0, x1 do
			for z = z0, z1 do
				Voxel.Set(g, x, y, z, key)
			end
		end
	end
end

-- Rounded rectangle prism centred on (cx, cz): sx by sz voxels, corner radius `round`.
function VX.RoundRect(g, cx, cz, sx, sz, round, y0, y1, key, keep)
	local hx, hz = sx / 2, sz / 2
	round = math.max(0, math.min(round, hx, hz))
	for y = y0, y1 do
		for x = math.floor(cx - hx) - 1, math.ceil(cx + hx) + 1 do
			for z = math.floor(cz - hz) - 1, math.ceil(cz + hz) + 1 do
				local qx, qz = math.abs(x - cx) - (hx - round), math.abs(z - cz) - (hz - round)
				local ox, oz = math.max(qx, 0), math.max(qz, 0)
				local d = math.sqrt(ox * ox + oz * oz) + math.min(math.max(qx, qz), 0)
				if d <= round and (not keep or Voxel.Get(g, x, y, z) == nil) then
					Voxel.Set(g, x, y, z, key)
				end
			end
		end
	end
end

-- Moves every voxel whose base key is in `keys` into a new grid (for split collision / materials).
function VX.Split(g, keys)
	local out = Voxel.NewGrid(g.Resolution)
	local move = {}
	for k, v in pairs(g.Cells) do
		if keys[Voxel.BaseKey(v)] or keys[v] then
			move[#move + 1] = k
		end
	end
	for _, k in ipairs(move) do
		out.Cells[k] = g.Cells[k]
		out.Count = out.Count + 1
		g.Cells[k] = nil
		g.Count = g.Count - 1
	end
	return out
end

-- Voxel.Build with the lobby defaults. o: V (voxel size), Name, CF (where voxel 0,0,0 sits), Parent,
-- Collide, MaxParts, Keep, Shadow, Pal.
function VX.Build(g, o)
	if not g or g.Count == 0 then
		return nil
	end
	local model = Voxel.Build(g, {
		VoxelSize = o.V or 1,
		Palette = o.Pal or P,
		Name = o.Name or "Voxels",
		CFrame = o.CF or CFrame.new(),
		CanCollide = o.Collide == true,
		CanQuery = o.Collide == true,
		MaxParts = o.MaxParts,
		Keep = o.Keep,
		CastShadow = o.Shadow,
	})
	if o.Parent then
		model.Parent = o.Parent
	end
	return model
end

----------------------------------------------------------------------
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7, owner art-lobby): Blender mesh dressing. Every Part build in this
-- file stays exactly as it is (the fallback, the colliders, every name / prompt / zone / sign); the static decoration
-- subtrees are tagged with MeshLibrary.Tag(target, key, look, keep) and clients Dress them (Parts hidden locally, the
-- mesh placed at the target's pivot * ML_Offset = `origin`). Keys: blender/catalog/lobby.json. A key is tagged only
-- once it has an uploaded id (MeshLibrary.Status ~= "missing"): with the shipped empty MeshIds nothing changes.
-- Keys baked from this file's own layout (clouds, floors, the altar) carry a "LayoutSig" attachment in their manifest
-- (part count + position / size sums of the Part build, relative to `origin`): they are tagged only while the live
-- build still matches it, so a Config change can never show a stale mesh.
----------------------------------------------------------------------
local Mesh = {
	Lib = nil,
	-- template name -> mesh key (place() tags every clone)
	Templates = {
		TreeRound = "prop_tree_round",
		TreeBlossom = "prop_tree_blossom",
		TreePine = "prop_tree_pine",
		Lamp = "prop_lamp",
		Bench = "prop_bench",
		PuffS = "cloud_puff_s",
		PuffM = "cloud_puff_m",
		SkyBig = "cloud_sky_big",
		SkySmall = "cloud_sky_small",
		Plot = "prop_plot",
	},
	-- parts that stay visible over the mesh (live per-plot colour, signs)
	Keep = {
		Plot = { "PodiumBase", "Accent", "PodiumTop" },
	},
	Names = {}, -- template model -> template name
	-- the part names of a dressed cloud puff (Voxel cloud keys + the cloud mesh's parts): kept by the bridge that
	-- carries one, so the two dresses never hide each other
	CloudParts = { "Cloud", "CloudLight", "CloudShade", "Mist", "MistDark", "Puff" },
	Template = nil, -- the template being built (VX.CloudModel records it for the kit)
}

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

-- part count + weighted sums of every visible BasePart's position / size in `origin` space (the kit computes the
-- same numbers from the same build: blender/kit/props/lobby_world.py)
function Mesh.Signature(target, origin)
	local inv = origin:Inverse()
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			local p = inv * d.Position
			local s = d.Size
			n = n + 1
			a = a + p.X + p.Y * 0.37 + p.Z * 0.61
			b = b + s.X + s.Y * 1.3 + s.Z * 1.7
		end
	end
	return n, a, b
end

local function meshSigOk(ML, key, target, origin)
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	local att = man and man.Attachments and man.Attachments.LayoutSig
	if not att then
		return true -- a designed prop: no layout to match
	end
	local pos = att.Pos or att.pos
	if type(pos) ~= "table" then
		return false
	end
	local n, a, b = Mesh.Signature(target, origin)
	local tol = 0.05 + n * 1e-4
	return n == pos[1] and math.abs(a - pos[2]) <= tol and math.abs(b - pos[3]) <= tol
end

-- target: Model / Part subtree; key: mesh key; origin: world CFrame of the mesh pivot; look: { Primary, Secondary };
-- keep: part names that stay visible. Returns true when tagged.
function Mesh.tag(target, key, origin, look, keep)
	if typeof(target) ~= "Instance" or typeof(origin) ~= "CFrame" then
		return false
	end
	local kit = LobbyBuilder._Kit
	if type(kit) == "table" and type(kit.Targets) == "table" then
		kit.Targets[#kit.Targets + 1] = { Key = key, Target = target, Origin = origin, Look = look, Keep = keep }
	end
	local ML = Mesh.lib()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" or not meshSigOk(ML, key, target, origin) then
		return false
	end
	local tagLook = {}
	for k, v in pairs(look or {}) do
		tagLook[k] = v
	end
	tagLook.Offset = target:GetPivot():Inverse() * origin
	ML.Tag(target, key, tagLook, keep)
	return true
end

-- Clones a template (built at the origin) to `cf`; returns the clone.
local function place(tpl, cf, parent, name)
	if not tpl then
		return nil
	end
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	if not m.PrimaryPart and m:IsA("Model") then
		m.WorldPivot = cf -- the clone's pivot = where it was placed (TutorialController reads Plot:GetPivot())
	end
	if name then
		m.Name = name
	end
	m.Parent = parent
	local tname = Mesh.Names[tpl]
	local key = tname and (Mesh.Templates[tname] or (tname:match("^FlowerBed") and "prop_flowerbed"))
	if key then
		local look = nil
		local v = tonumber(tname:match("^FlowerBed(%d+)"))
		if v then -- the bed's two flower colours (Props.FlowerBed)
			look = { Primary = FLOWERS[v], Secondary = FLOWERS[v % #FLOWERS + 1] }
		end
		Mesh.tag(m, key, cf, look, Mesh.Keep[tname])
	end
	return m
end

local function template(name, make)
	local t = templates[name]
	if t == nil then
		local outer = Mesh.Template
		Mesh.Template = name
		local ok, result = pcall(make)
		Mesh.Template = outer
		if ok and result then
			t = result
			Mesh.Names[t] = name
		else
			warn("[LobbyBuilder] template " .. name .. " failed: " .. tostring(result))
			t = false
		end
		templates[name] = t
	end
	return t or nil
end

-- One flat layer of ground cells (a one-voxel-thick grid) whose top face sits at topY. fn(x, z) -> key | nil
-- gets the cell centre in studs relative to `centre`. Layers that overlap are offset in height (no z-fight).
local function groundLayer(parent, name, centre, radius, topY, cell, fn, maxParts)
	local g = Voxel.NewGrid(1)
	local n = math.ceil(radius / cell)
	for i = -n, n do
		for k = -n, n do
			local key = fn(i * cell, k * cell)
			if key then
				Voxel.Set(g, i, 0, k, key)
			end
		end
	end
	return VX.Build(g, {
		V = cell,
		Name = name,
		CF = CFrame.new(centre.X, topY - cell / 2, centre.Z),
		Collide = true,
		Shadow = false,
		Parent = parent,
		MaxParts = maxParts,
	})
end

-- A tiered voxel cloud body (tops at y = 0, V studs per voxel). spec:
--   Tiers = { { R = studs | SX =, SZ =, Round = studs, H = levels }, ... } from the top tier down
--   Puffs = { { x, y, z, rx, ry, rz } (studs, relative to the top centre) } soft bulges (shaded)
--   Rim = { same } puffs that rise above the walking surface; Carve = fn(x, y, z) -> remove voxel?
function VX.Cloud(spec)
	local V = spec.V or 3
	local g = Voxel.NewGrid(16)
	local y = 0
	for i, t in ipairs(spec.Tiers) do
		local key = t.Key or TIER_KEYS[math.min(i, #TIER_KEYS)]
		local h = t.H or 1
		if t.R then
			VX.Disc(g, 0, 0, t.R / V, y - h + 1, y, key)
		else
			VX.RoundRect(g, (t.X or 0) / V, (t.Z or 0) / V, t.SX / V, t.SZ / V, (t.Round or 6) / V, y - h + 1, y, key)
		end
		y = y - h
	end
	for _, p in ipairs(spec.Puffs or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Puff", KeepExisting = true })
	end
	for _, p in ipairs(spec.Rim or {}) do
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { p[1] / V, p[2] / V, p[3] / V }, Radius = { p[4] / V, p[5] / V, p[6] / V }, Key = "Rim", KeepExisting = true })
	end
	if spec.Carve then
		local remove = {}
		for k in pairs(g.Cells) do
			local x, yy, z = Voxel.Unpack(k)
			if spec.Carve(x * V, yy * V, z * V) then
				remove[#remove + 1] = k
			end
		end
		for _, k in ipairs(remove) do
			g.Cells[k] = nil
			g.Count = g.Count - 1
		end
	end
	Voxel.Shade(g, { Only = { Puff = true, Rim = true }, Smooth = 2, Seed = spec.Seed or 1 })
	Voxel.Remap(g, {
		Puff = "Cloud",
		Puff_Light = "CloudLight",
		Puff_Dark = "Mist",
		Rim = "Cloud",
		Rim_Light = "CloudLight",
		Rim_Dark = "CloudShade",
	})
	return g
end

-- Builds a cloud spec at a CFrame whose position is the top centre of the cloud.
function VX.CloudModel(spec, cf, parent, name, collide)
	local V = spec.V or 3
	local g = VX.Cloud(spec)
	local model = VX.Build(g, {
		V = V,
		Name = name or "Cloud",
		CF = cf * CFrame.new(0, -V / 2, 0),
		Collide = collide,
		MaxParts = spec.MaxParts,
		Parent = parent,
	})
	if model then
		CollectionService:AddTag(model, EXEMPT_TAG) -- the voxel clouds keep their look on purpose (6.4 rule 9)
		local kit = LobbyBuilder._Kit
		if type(kit) == "table" and type(kit.Clouds) == "table" then -- Phase 6 kit hook (blender/kit/props/lobby_world.py)
			kit.Clouds[model] = { Spec = spec, CF = cf, Template = Mesh.Template, Name = name }
		end
	end
	return model
end

----------------------------------------------------------------------
-- Prop templates (sculpted once, cloned everywhere)
----------------------------------------------------------------------

local Props = {}

-- Detailed voxel trees (~18 studs, ~1.1-stud voxels). kind: "Round" (green, red fruit), "Blossom" (pink), "Pine".
-- Shapes are written in 1.4-stud units and scaled by S, so the voxels get finer without the tree changing size.
function Props.Tree(kind)
	return template("Tree" .. kind, function()
		local S = 1.3
		local function v(x, y, z)
			return { x * S, y * S, z * S }
		end
		local g = Voxel.NewGrid(16)
		local leaf = (kind == "Blossom") and "Blossom" or ((kind == "Pine") and "Pine" or "Leaf")
		-- trunk with a slight bend, flared roots and two branch stubs into the canopy
		Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 0, 0), v(0.3, 2.4, 0), v(-0.2, 4.6, 0.2), v(0, 6.4, 0) }, Radius = 1.05 * S, RadiusB = 0.6 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(1.5, 0, 0.5), Radius = 0.55 * S, RadiusB = 0.25 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(-1.1, 0, -1.1), Radius = 0.55 * S, RadiusB = 0.25 * S, Key = "Bark" })
		Voxel.Shape(g, { Kind = "Capsule", A = v(0, 0.3, 0), B = v(-0.4, 0, 1.4), Radius = 0.5 * S, RadiusB = 0.25 * S, Key = "Bark" })
		if kind == "Pine" then
			-- three stacked, shrinking cone tiers
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 3.2, 0), B = v(0, 8.6, 0), Radius = 4.6 * S, RadiusB = 1.2 * S, Key = leaf })
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 6.6, 0), B = v(0, 11.4, 0), Radius = 3.7 * S, RadiusB = 0.8 * S, Key = leaf })
			Voxel.Shape(g, { Kind = "Cone", A = v(0, 9.6, 0), B = v(0, 14.2, 0), Radius = 2.6 * S, RadiusB = 0, Key = leaf })
		else
			Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 5.4, 0), v(1.8, 7, 0.6) }, Radius = 0.45 * S, Key = "Bark" })
			Voxel.Shape(g, { Kind = "Curve", Points = { v(0, 5.8, 0), v(-1.6, 7.2, -0.8) }, Radius = 0.45 * S, Key = "Bark" })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(0, 8.3, 0), Radius = { 3.8 * S, 3.0 * S, 3.8 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(2.3, 7.1, 1.1), Radius = { 2.4 * S, 2.1 * S, 2.4 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(-2.1, 7.3, -1.4), Radius = { 2.5 * S, 2.1 * S, 2.5 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(-0.8, 7.0, 2.3), Radius = { 2.2 * S, 2.0 * S, 2.2 * S }, Key = leaf })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = v(0.4, 10.6, -0.4), Radius = { 2.3 * S, 1.8 * S, 2.3 * S }, Key = leaf })
		end
		Voxel.Shade(g, { Smooth = 2, Noise = 0.05, Seed = 7 })
		local accent, onlyKey, chance = nil, nil, 0
		if kind == "Blossom" then
			accent, onlyKey, chance = "BlossomWhite", "Blossom_Light", 0.18 -- pale petals on the lit side
		elseif kind == "Round" then
			accent, onlyKey, chance = "Flower5", "Leaf", 0.05 -- small red fruit
		end
		if accent then
			Voxel.Shape(g, {
				Kind = "Ellipsoid",
				Center = v(0, 8.3, 0),
				Radius = { 5 * S, 4.5 * S, 5 * S },
				Op = "Paint",
				OnlyKeys = { [onlyKey] = true },
				Pattern = function(x, y, z)
					if hash3(x, y, z, 5) < chance then
						return accent
					end
					return false
				end,
			})
		end
		local V = 1.4 / S
		return VX.Build(g, { V = V, Name = kind .. "Tree", CF = CFrame.new(0, V / 2, 0), Collide = true, MaxParts = 54 })
	end)
end

-- Lamp post (~9 studs) with a warm neon lantern. Built from crafted blocks.
function Props.Lamp()
	return template("Lamp", function()
		local m = Instance.new("Model")
		m.Name = "Lamp"
		-- plinth + body + cap (6.4 rule 3): a Slate foot with a Marble band, an iron post, a glass lantern
		box(m, "LampBase", CFrame.new(0, 0.6, 0), Vector3.new(1.8, 1.2, 1.8), C.Slate, { Collide = true })
		box(m, "LampBand", CFrame.new(0, 1.3, 0), Vector3.new(2, 0.2, 2), C.MarbleShade)
		box(m, "LampPole", CFrame.new(0, 4.6, 0), Vector3.new(0.5, 6.6, 0.5), C.Iron, { Collide = true })
		box(m, "LampCollar", CFrame.new(0, 8, 0), Vector3.new(1.2, 0.3, 1.2), C.IronLight)
		box(m, "LampCage", CFrame.new(0, 8.85, 0), Vector3.new(1.3, 1.4, 1.3), C.Lamp, { Material = materialOf("Glass"), Transparency = 0.45 })
		box(m, "LampGlass", CFrame.new(0, 8.85, 0), Vector3.new(0.7, 1.0, 0.7), C.Lamp, { Material = MAT.Neon })
		box(m, "LampRoof", CFrame.new(0, 9.75, 0), Vector3.new(1.8, 0.4, 1.8), C.Iron)
		box(m, "LampTip", CFrame.new(0, 10.15, 0), Vector3.new(0.5, 0.4, 0.5), C.GoldDark)
		return m
	end)
end

-- Wooden bench (plain parts, no Seat: running past must never sit you down). Faces -Z.
function Props.Bench()
	return template("Bench", function()
		local m = Instance.new("Model")
		m.Name = "Bench"
		box(m, "Seat", CFrame.new(0, 1.55, -0.45), Vector3.new(5.6, 0.4, 1), C.PlankLight, { Collide = true })
		box(m, "Seat", CFrame.new(0, 1.55, 0.55), Vector3.new(5.6, 0.4, 1), C.Plank, { Collide = true })
		box(m, "Back", CFrame.new(0, 2.55, 1.05), Vector3.new(5.6, 0.7, 0.3), C.PlankLight)
		box(m, "Back", CFrame.new(0, 3.35, 1.05), Vector3.new(5.6, 0.7, 0.3), C.Plank)
		box(m, "Frame", CFrame.new(-2.4, 1.6, 0.25), Vector3.new(0.4, 3.2, 2.2), C.Iron, { Collide = true })
		box(m, "Frame", CFrame.new(2.4, 1.6, 0.25), Vector3.new(0.4, 3.2, 2.2), C.Iron, { Collide = true })
		return m
	end)
end

-- Raised wooden flower bed (6 x 3) with leaves and flower pixels. variant picks the flower colours.
function Props.FlowerBed(variant)
	return template("FlowerBed" .. variant, function()
		local g = Voxel.NewGrid(4)
		for x = -3, 2 do
			for z = -2, 1 do
				local edge = x == -3 or x == 2 or z == -2 or z == 1
				Voxel.Set(g, x, 0, z, edge and "PlankDark" or "Soil")
				if not edge then
					local h = hash3(x, variant, z, 3)
					if h < 0.45 then
						Voxel.Set(g, x, 1, z, "Flower" .. (((variant + x + z) % 3 == 0) and variant or (variant % #FLOWERS + 1)))
					else
						Voxel.Set(g, x, 1, z, "Leaf")
					end
				end
			end
		end
		return VX.Build(g, { V = 1, Name = "FlowerBed", CF = CFrame.new(0.5, 0.5, 0.5), Collide = true, MaxParts = 16 })
	end)
end

-- A small voxel cloud puff (supports under bridges). size: "S" | "M".
function Props.Puff(size)
	return template("Puff" .. size, function()
		local s = (size == "M") and 1.35 or 1
		local spec = {
			V = 3,
			Tiers = { { R = 6 * s, H = 1 }, { R = 4.5 * s, H = 1 } },
			Puffs = {
				{ 5 * s, -1, 2 * s, 5 * s, 4 * s, 5 * s },
				{ -5 * s, -2, -1 * s, 5.5 * s, 4.5 * s, 5 * s },
				{ 0, -4, 0, 6 * s, 5 * s, 6 * s },
			},
			MaxParts = 12,
			Seed = 3,
		}
		return VX.CloudModel(spec, CFrame.new(), nil, "CloudPuff", false)
	end)
end

-- Bunting: a sagging rope with stepped voxel pennants in the given colours between two points.
local function bunting(parent, a, b, colors, sag)
	local m = newModel(parent, "Bunting")
	local span = b - a
	local len = span.Magnitude
	if len < 2 then
		return m
	end
	sag = sag or math.min(2, len * 0.06)
	local dir = span.Unit
	local count = math.max(2, math.floor(len / 4))
	local pieces = 3
	local knots = {}
	for i = 0, pieces do
		local t = i / pieces
		knots[i] = a + span * t - Vector3.new(0, sag * 4 * t * (1 - t), 0)
	end
	for i = 1, pieces do
		local p, prev = knots[i], knots[i - 1]
		local mid = (p + prev) * 0.5
		box(m, "Rope", CFrame.lookAt(mid, p), Vector3.new(0.18, 0.18, (p - prev).Magnitude + 0.1), C.PlankDark, { Shadow = false })
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(1, 0, 0)
	end
	for i = 1, count do
		-- on the straight rope piece (not the parabola through its knots), so every pennant hangs from it
		local t = (i - 0.5) / count
		local k = math.min(pieces - 1, math.floor(t * pieces))
		local p = knots[k]:Lerp(knots[k + 1], t * pieces - k)
		local color = colors[(i - 1) % #colors + 1]
		local cf = CFrame.lookAt(p, p + flat) * CFrame.Angles(0, math.rad(90), 0)
		box(m, "Pennant", cf * CFrame.new(0, -0.4, 0), Vector3.new(0.12, 0.8, 1.3), color, { Shadow = false })
		box(m, "Pennant", cf * CFrame.new(0, -1.05, 0), Vector3.new(0.12, 0.6, 0.6), color, { Shadow = false })
	end
	return m
end

-- Tall banner pole with a hanging cloth in `color` (and a gold finial). cf at ground level.
local function bannerPole(parent, cf, color)
	local m = newModel(parent, "Banner")
	box(m, "Pole", cf * CFrame.new(0, 5.5, 0), Vector3.new(0.5, 11, 0.5), C.Iron, { Collide = true })
	box(m, "Finial", cf * CFrame.new(0, 11.3, 0), Vector3.new(0.9, 0.7, 0.9), C.Gold)
	box(m, "Bar", cf * CFrame.new(0.9, 10.5, 0), Vector3.new(2.4, 0.3, 0.3), C.Iron)
	box(m, "Cloth", cf * CFrame.new(1.2, 8.2, 0), Vector3.new(2, 4.2, 0.15), color, { Shadow = false })
	box(m, "ClothTip", cf * CFrame.new(1.2, 5.75, 0), Vector3.new(1, 0.7, 0.15), color, { Shadow = false })
	Mesh.tag(m, "prop_banner", cf, { Primary = color }) -- Phase 6: the cloth takes `color`
	return m
end

-- A wooden notice board with a small roof; returns the face part for the SurfaceGui. cf: ground, faces -Z.
local function noticeBoard(parent, cf, width, height, name)
	local m = newModel(parent, name or "NoticeBoard")
	local postH = height + 3.4
	for _, s in ipairs({ -1, 1 }) do
		box(m, "Post", cf * CFrame.new(s * (width / 2 + 0.5), postH / 2, 0), Vector3.new(1, postH, 1), C.PlankDark, { Collide = true })
		box(m, "PostFoot", cf * CFrame.new(s * (width / 2 + 0.5), 0.4, 0), Vector3.new(1.6, 0.8, 1.6), C.StoneDark, { Collide = true })
	end
	box(m, "Frame", cf * CFrame.new(0, 2.4 + height / 2, 0.15), Vector3.new(width + 0.6, height + 0.6, 0.6), C.Plank, { Collide = true })
	local face = box(m, "Face", cf * CFrame.new(0, 2.4 + height / 2, -0.2), Vector3.new(width, height, 0.2), C.Navy)
	box(m, "Roof", cf * CFrame.new(0, postH + 0.25, 0), Vector3.new(width + 3, 0.5, 2.4), C.PlankDark)
	box(m, "RoofTop", cf * CFrame.new(0, postH + 0.75, 0), Vector3.new(width + 1.6, 0.5, 1.4), C.Rose)
	-- Phase 6: prop_board_s (11 x 8) / prop_board_l (14 x 9); the Face keeps its SurfaceGui and stays visible
	local boardKey = (width == 11 and height == 8) and "prop_board_s" or ((width == 14 and height == 9) and "prop_board_l" or nil)
	if boardKey then
		Mesh.tag(m, boardKey, cf, nil, { "Face" })
	end
	return face, m
end

----------------------------------------------------------------------
-- Layout (derived once from Config.Lobby / Config.Difficulties)
----------------------------------------------------------------------

local function computeLayout()
	local L = {}

	-- Phase 5 Gate Court (6.1): the gates left -> right on the arc r G.GateR around G.GateFacing (the spawn looks this
	-- way); Phase 6: the court keeps its six-slot width ((G.CourtSlots - 1) * G.GateStep) and the five gates spread
	-- evenly over it (the end gates stand on the old end slots, Ring in the middle); the sector reaches 5.75 degrees
	-- past the end gates.
	L.MidAngle = G.GateFacing
	L.GateAngles = {}
	L.GateOrder = {}
	local nGates = #GATE_SPECS
	local span = (G.CourtSlots - 1) * G.GateStep
	local step = nGates > 1 and span / (nGates - 1) or 0
	for i, spec in ipairs(GATE_SPECS) do
		local a = G.GateFacing + (i - (nGates + 1) / 2) * step
		L.GateAngles[spec.Id] = a
		L.GateOrder[i] = spec.Id
	end
	L.CourtFrom = G.GateFacing - span / 2 - 5.75
	L.CourtTo = G.GateFacing + span / 2 + 5.75

	-- Shop island.
	local off = LOBBY.ShopOffset or Vector3.new(0, 0, -150)
	L.ShopCenter = Vector3.new(OX + off.X, TOP, OZ + off.Z)
	L.ShopDist = math.max(1, math.sqrt(off.X * off.X + off.Z * off.Z))
	L.ShopAngle = math.deg(atan2(off.Z, off.X)) % 360
	L.ShopR = clamp(L.ShopDist - PLAZA_R - 4, 18, 34)
	L.FountainX = math.cos(math.rad(L.ShopAngle)) * G.FountainD
	L.FountainZ = math.sin(math.rad(L.ShopAngle)) * G.FountainD

	-- Home plots sit between the junctions of the ring street; spokes join every other junction (never through the
	-- Gate Court, whose terrace fills the plaza edge behind the gates, and never right beside the shop neck).
	L.PlotAngles = {}
	for i = 1, SPOT_COUNT do
		L.PlotAngles[i] = (i - 1) * G.Step + G.HalfStep
	end
	L.Junctions = {}
	L.SpokeAngles = {}
	for j = 0, SPOT_COUNT - 1 do
		local a = j * G.Step
		local info = { Angle = a, Index = j }
		L.Junctions[#L.Junctions + 1] = info
		if j % 2 == 1 and angleDiff(a, L.ShopAngle) > 14 and not angleIn(a, L.CourtFrom - 8, L.CourtTo + 8) then
			info.Spoke = true
			L.SpokeAngles[#L.SpokeAngles + 1] = a
		end
	end

	-- Gardens (and the reserved Storm Altar site) hang off even junctions inside the ring.
	local function pickEven(target)
		local best, bestD = nil, 1e9
		for _, info in ipairs(L.Junctions) do
			local d = angleDiff(info.Angle, target)
			if not info.Spoke and not info.Garden and not info.Altar and d < bestD and angleDiff(info.Angle, L.ShopAngle) > 30 then
				best, bestD = info, d
			end
		end
		return best
	end
	L.Gardens = {}
	local specs = {
		{ Target = L.MidAngle - 45, Name = "Blossom Garden", Kind = "Blossom" },
		{ Target = L.MidAngle + 45, Name = "Lily Pond", Kind = "Pond" },
	}
	for _, spec in ipairs(specs) do
		local j = pickEven(spec.Target)
		if j then
			j.Garden = true
			L.Gardens[#L.Gardens + 1] = { Angle = j.Angle, Name = spec.Name, Kind = spec.Kind }
		end
	end
	local altar = pickEven(L.ShopAngle + 45)
	if altar then
		altar.Altar = true
		L.AltarAngle = altar.Angle
	end

	-- Phase 3 / 5: the Battle Arena island floats beyond the homes; its bridge continues the spoke junction nearest
	-- 135 degrees straight through the street (the junction's outer rail opens for it). Portal_Arena in the Gate Court
	-- is the other way in (ArenaBuilder).
	local arenaTarget = L.CourtTo + 3
	local arenaJ, arenaD = nil, 1e9
	for _, info in ipairs(L.Junctions) do
		if info.Spoke and not info.Garden and not info.Altar and angleDiff(info.Angle, L.ShopAngle) > 30
			and (not L.AltarAngle or angleDiff(info.Angle, L.AltarAngle) > 30) then
			local d = angleDiff(info.Angle, arenaTarget)
			if d < arenaD then
				arenaJ, arenaD = info, d
			end
		end
	end
	if arenaJ then
		arenaJ.Arena = true
		L.ArenaAngle = arenaJ.Angle
	end

	-- Exits through the plaza's soft cloud rim: spokes and the shop boardwalk.
	L.RimGaps = {}
	for _, a in ipairs(L.SpokeAngles) do
		L.RimGaps[#L.RimGaps + 1] = a
	end
	L.RimGaps[#L.RimGaps + 1] = L.ShopAngle

	-- Plaza path segments (plaza-local studs): { ax, az, dx, dz, len, half, kind }.
	local segs = {}
	local function segAB(ax, az, bx, bz, half, kind)
		local dx, dz = bx - ax, bz - az
		local len = math.max(0.01, math.sqrt(dx * dx + dz * dz))
		segs[#segs + 1] = { ax = ax, az = az, dx = dx / len, dz = dz / len, len = len, half = half, kind = kind }
	end
	local function seg(angle, r0, r1, half, kind)
		local d = dirOf(angle)
		segAB(d.X * r0, d.Z * r0, d.X * r1, d.Z * r1, half, kind)
	end
	-- the grand avenue (spawn court -> Gate Court), the shop boardwalk, the east / west walks to the circle walk
	seg(L.MidAngle, G.CourtR - 1, G.CourtIn + 1, G.AvenueHalf, "Stone")
	seg(L.ShopAngle, G.CourtR - 1, PLAZA_R + 1, G.BoardHalf, "Plank")
	L.CrossAngles = { (L.MidAngle + 90) % 360, (L.MidAngle - 90) % 360 }
	for _, a in ipairs(L.CrossAngles) do
		seg(a, G.CourtR - 1, G.RingRoadR, G.PathHalf, "Stone")
	end
	-- every spoke leaves the circle walk
	for _, a in ipairs(L.SpokeAngles) do
		seg(a, G.RingRoadR - 2, PLAZA_R + 1, G.StubHalf, "Stone")
	end
	L.PlazaSegs = segs
	return L
end

----------------------------------------------------------------------
-- Plaza: ground (layered voxel tiles), cloud body, decor
----------------------------------------------------------------------

local BORDER_KEY = { Stone = "StoneEdge", Sand = "SandDark", Plank = "PlankDark" }

local function segDist(px, pz, s)
	local rx, rz = px - s.ax, pz - s.az
	local t = rx * s.dx + rz * s.dz
	if t < 0 or t > s.len then
		return math.huge, t
	end
	return math.abs(-rx * s.dz + rz * s.dx), t
end

-- Signed lateral distance (studs) of a plaza-local point inside the Gate Court sector: > 0 inside, the distance to
-- the nearer side edge (the rays at L.CourtFrom / L.CourtTo).
local function courtSide(x, z, L)
	local a0, a1 = math.rad(L.CourtFrom), math.rad(L.CourtTo)
	-- the left edge ray at a0: inside is counter-clockwise of it; the right edge ray at a1: inside is clockwise
	local d0 = math.cos(a0) * z - math.sin(a0) * x
	local d1 = math.sin(a1) * x - math.cos(a1) * z
	return math.min(d0, d1)
end

-- Keys of the plaza ground layers at a cell centre (plaza-local studs):
-- l1 lawn patches / flowers, l2 borders and the grout under the tiled courts (just below the surface), l3 surfaces
-- (cobbles, planks); the spawn court and the Gate Court get their Slate tiles from Court.Tiles on top of the grout.
local function plazaCell(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r > PLAZA_R - 0.5 then
		return nil
	end
	local l1, l2, l3
	local n = vnoise(x + 400, z + 400, 46, 11)
	if r > PLAZA_R - 3.5 then
		n = 0.5 -- lawn only at the very edge (no patch faces flush with the lawn's edge)
	end
	if n < 0.17 then
		l1 = "GrassDark"
	elseif n > 0.83 then
		l1 = "GrassLight"
	end
	-- spawn court (tiles on top) and the Gate Court sector (tiles, terrace)
	if r <= G.CourtR + 1 then
		l2 = "SlateDark"
	end
	local side = courtSide(x, z, L)
	if r >= G.CourtIn - 2 and r <= G.CourtOut + 1 and side >= -1.5 then
		l2 = "SlateDark"
	end
	-- (the cobbled circle walk is built from arc segments by Court.RingRoad; keep its band free of lawn patches)
	if math.abs(r - G.RingRoadR) <= G.PathHalf + 0.5 then
		l1 = nil
	end
	-- fountain roundabout
	local fx, fz = x - L.FountainX, z - L.FountainZ
	local fr = math.sqrt(fx * fx + fz * fz)
	if fr <= 16 then
		l2 = l2 or "StoneEdge"
		if fr <= 14 then
			l3 = l3 or "Stone"
		end
	end
	-- paths
	for _, s in ipairs(L.PlazaSegs) do
		local d, t = segDist(x, z, s)
		if d <= s.half then
			l2 = l2 or BORDER_KEY[s.kind]
			-- (the surface stops one cell before the island's edge, its border runs on: no two layers end flush)
			if d <= s.half - 2 and not l3 and l2 ~= "SlateDark" and r <= PLAZA_R - 2.5 then
				if s.kind == "Plank" then
					l3 = (math.floor(t / 4) % 2 == 0) and "Plank" or "PlankLight"
				else
					-- cobbles in two shades by large soft patches (+-6 RGB, rule 2)
					l3 = (vnoise(x + 1300, z + 1300, 9, 3) > 0.5) and "Stone" or "StoneLight"
				end
			end
		end
	end
	-- flower pixels on open lawn: a scattered meadow near the rim and a few denser patches
	if not l2 and not l3 then
		local h = hash3(math.floor(x), 0, math.floor(z), 21)
		local meadow = vnoise(x + 900, z + 900, 26, 5) > 0.84
		if r < PLAZA_R - 3.5 and ((r > G.RingRoadR + 8 and r < PLAZA_R - 6 and h < 0.03) or (meadow and h < 0.07)) then
			l1 = "Flower" .. (math.floor(hash3(math.floor(x), 1, math.floor(z), 4) * #FLOWERS) + 1)
		end
	end
	return l1, l2, l3
end

-- The spawn medallion (1-stud inlay cells, thinned to 0.3-stud inlays when built): a Metal sun, a Marble ring and six
-- Neon arrows in the gate colours, each pointing at its gate.
local function courtInlay(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r <= 3.6 then
		return "Gold"
	elseif r <= 4.8 then
		return "GoldDark"
	elseif r >= 15.4 and r <= 16.9 then
		return "Marble"
	end
	for i, id in ipairs(L.GateOrder) do
		local pa = L.GateAngles[id]
		local dx, dz = math.cos(math.rad(pa)), math.sin(math.rad(pa))
		local t = x * dx + z * dz
		local d = math.abs(-x * dz + z * dx)
		if t >= 18 and t <= 23 and d <= (23.4 - t) * 0.4 then
			return "Gate" .. i
		end
	end
	-- short sun rays
	if r >= 5.6 and r <= 7.6 then
		local a = (math.deg(atan2(z, x)) - L.MidAngle) % 45
		if a < 7 or a > 38 then
			return "GoldDark"
		end
	end
	return nil
end

local function plazaKind(x, z, L)
	local r = math.sqrt(x * x + z * z)
	if r > PLAZA_R - 6 then
		return "edge"
	end
	local _, l2, l3 = plazaCell(x, z, L)
	if l2 or l3 then
		return "path"
	end
	return "lawn"
end

-- Is a circle (plaza-local) free lawn, away from paths, the rim and other decor?
local function plazaFree(x, z, radius, L)
	for _, o in ipairs({ { 0, 0 }, { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 }, { 0.7, 0.7 }, { -0.7, 0.7 }, { 0.7, -0.7 }, { -0.7, -0.7 } }) do
		if plazaKind(x + o[1] * radius, z + o[2] * radius, L) ~= "lawn" then
			return false
		end
	end
	for _, rsv in ipairs(reserved) do
		local dx, dz = x - rsv[1], z - rsv[2]
		local need = radius + rsv[3]
		if dx * dx + dz * dz < need * need then
			return false
		end
	end
	return true
end

local function reserve(x, z, radius)
	reserved[#reserved + 1] = { x, z, radius }
end

-- Places a prop on the plaza lawn when the spot is free; returns the world ground position or nil.
local function plazaSpot(angle, radius, clearance, L, force)
	local d = dirOf(angle)
	local x, z = d.X * radius, d.Z * radius
	if not force and not plazaFree(x, z, clearance, L) then
		warn(string.format("[LobbyBuilder] plaza decor skipped at %.0f deg r=%.0f (not free)", angle, radius))
		return nil
	end
	reserve(x, z, clearance)
	return Vector3.new(OX + x, TOP, OZ + z), x, z
end

local function buildPlazaGround(f, L)
	local cell = 2
	local n = math.ceil(PLAZA_R / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	local r2 = (PLAZA_R - 0.5) * (PLAZA_R - 0.5)
	for i = -n, n do
		for k = -n, n do
			local x, z = i * cell, k * cell
			if x * x + z * z <= r2 then
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local l1, l2, l3 = plazaCell(x, z, L)
				if l1 then
					Voxel.Set(grids[2], i, 0, k, l1)
				end
				if l2 then
					Voxel.Set(grids[3], i, 0, k, l2)
				end
				if l3 then
					Voxel.Set(grids[4], i, 0, k, l3)
				end
			end
		end
	end
	-- the medallion uses finer 1-stud cells
	local inlay = grids[5]
	local ci = math.ceil(G.CourtR)
	for i = -ci, ci do
		for k = -ci, ci do
			local key = courtInlay(i, k, L)
			if key then
				Voxel.Set(inlay, i, 0, k, key)
			end
		end
	end
	-- top surfaces: lawn -0.4, patches -0.3, borders -0.1, paths 0, inlays +0.1 (walkable steps, no z-fight;
	-- bridge decks that dock into the ground sit at -0.2)
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	local names = { "Lawn", "LawnPatches", "PathBorders", "Paths", "Inlays" }
	for li = 1, 5 do
		local cellSize = (li == 5) and 1 or cell
		local model = VX.Build(grids[li], {
			V = cellSize,
			Name = names[li],
			CF = CFrame.new(OX, TOP + tops[li] - cellSize / 2, OZ),
			Collide = li ~= 5,
			Shadow = false,
			Parent = f,
		})
		if li == 5 and model then
			-- the medallion: 0.3-stud inlays (rule 2: saturated colours only as thin inlays) on top of the court tiles
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") then
					local topY = p.Position.Y + p.Size.Y / 2
					p.Size = Vector3.new(p.Size.X, 0.3, p.Size.Z)
					p.CFrame = CFrame.new(p.Position.X, topY - 0.15, p.Position.Z)
					p.CanCollide = false
					p.CanQuery = false
				end
			end
		end
		if model then -- Phase 6: floor_plaza_<layer> (baked from this very build: LayoutSig)
			Mesh.tag(model, "floor_plaza_" .. string.lower(names[li]), CFrame.new(OX, TOP, OZ))
		end
	end
end

-- The plaza's cloud body: tiered, with lumpy side puffs and a soft rim of clouds around the lawn.
local function buildPlazaBody(f, L)
	local rng = Util.NewRng(SEED + 2)
	local R = PLAZA_R
	local puffs = {}
	for i = 1, 6 do
		local a = (i - 1) / 6 * math.pi * 2 + rng:Float(-0.2, 0.2)
		local tier = rng:Int(1, 2)
		local tr = ({ R - 8, R - 30 })[tier]
		local ty = ({ -7, -14 })[tier]
		local s = rng:Float(12, 17)
		puffs[#puffs + 1] = { math.cos(a) * tr, ty, math.sin(a) * tr, s, s * 0.7, s }
	end
	for i = 1, 3 do
		local a = rng:Float(0, math.pi * 2)
		local d = rng:Float(10, 40)
		puffs[#puffs + 1] = { math.cos(a) * d, -26, math.sin(a) * d, rng:Float(16, 24), rng:Float(8, 11), rng:Float(16, 24) }
	end
	-- the exits through the rim: unit direction + half width kept clear (path + border + a little air)
	local exits = {}
	for _, a in ipairs(L.RimGaps) do
		local d = dirOf(a)
		local half = ((angleDiff(a, L.ShopAngle) < 1) and G.BoardHalf or G.StubHalf) + 2.5
		exits[#exits + 1] = { d.X, d.Z, half }
	end
	-- rim puffs: one right beside every exit, the arcs between exits filled evenly (<= ~30 degrees apart)
	local rim = {}
	local gaps = {}
	for _, a in ipairs(L.RimGaps) do
		gaps[#gaps + 1] = a % 360
	end
	table.sort(gaps)
	local function addRim(adeg)
		local a = math.rad(adeg)
		local rr = R + rng:Float(-1, 1.5)
		local s = rng:Float(8.5, 11)
		rim[#rim + 1] = { math.cos(a) * rr, rng:Float(-1, 1.5), math.sin(a) * rr, s, s * 0.62, s }
	end
	if #gaps == 0 then
		gaps[1] = 0
	end
	for i, g0 in ipairs(gaps) do
		local g1 = gaps[i % #gaps + 1]
		local span = (g1 - g0) % 360
		if span == 0 then
			span = 360
		end
		local from, to = g0 + 9, g0 + span - 9
		if to > from then
			local n = math.max(1, math.ceil((to - from) / 30))
			for k = 0, n do
				addRim(from + (to - from) * k / n)
			end
		end
	end
	local spec = {
		V = 3,
		Tiers = {
			{ R = R + 3, H = 1 },
			{ R = R - 6, H = 2 },
			{ R = R - 28, H = 2 },
			{ R = R - 62, H = 3 },
		},
		Puffs = puffs,
		Rim = rim,
		-- keep the walking area clear: nothing of the body may rise above the lawn inside the rim, nor over an
		-- exit (the spoke bridges and the shop neck dock there)
		Carve = function(x, y, z)
			if y <= 0 then
				return false
			end
			if (x * x + z * z) < (R - 6) * (R - 6) then
				return true
			end
			for _, ex in ipairs(exits) do
				local along = x * ex[1] + z * ex[2]
				if along > R - 24 and math.abs(-x * ex[2] + z * ex[1]) < ex[3] then
					return true
				end
			end
			return false
		end,
		Seed = 4,
		MaxParts = 360,
	}
	-- top of tier 1 sits 1.2 under the lawn surface; rim puffs rise up to ~5 studs above the lawn
	local body = VX.CloudModel(spec, CFrame.new(OX, TOP - 1.2, OZ), f, "PlazaCloud", true)
	if body then
		Mesh.tag(body, "cloud_plaza", CFrame.new(OX, TOP - 1.2, OZ))
	end
end

-- Fountain on the roundabout: stone basin, translucent water, two tiers with falling water, spray, and
-- Nimbus the Cloudy Dragon (PetBuilder) perched on top when the pet modules are available.
local function buildFountain(f, centre, lookTarget)
	local m = newModel(f, "Fountain")
	local g = Voxel.NewGrid(16)
	VX.Ring(g, 0, 0, 7.6, 9.6, 0, 1, "Slate")
	VX.Ring(g, 0, 0, 7.2, 10.1, 2, 2, "MarbleShade")
	VX.Disc(g, 0, 0, 7.6, 0, 0, "WaterDeep")
	VX.Disc(g, 0, 0, 7.6, 1, 1, "Water")
	VX.Disc(g, 0, 0, 1.7, 1, 4, "Slate")
	VX.Disc(g, 0, 0, 4.3, 4, 4, "MarbleShade")
	VX.Ring(g, 0, 0, 3.4, 4.3, 5, 5, "MarbleShade")
	VX.Disc(g, 0, 0, 3.3, 5, 5, "Water")
	VX.Disc(g, 0, 0, 1.1, 6, 8, "Slate")
	VX.Disc(g, 0, 0, 2.5, 8, 8, "MarbleShade")
	VX.Ring(g, 0, 0, 1.7, 2.5, 9, 9, "MarbleShade")
	VX.Disc(g, 0, 0, 1.6, 9, 9, "Water")
	-- falling water from both bowls
	for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
		VX.Fill(g, d[1] * 5, d[1] * 5, 2, 4, d[2] * 5, d[2] * 5, "Water")
		VX.Fill(g, d[1] * 3, d[1] * 3, 6, 8, d[2] * 3, d[2] * 3, "Water")
	end
	-- gold trim studs on the rim
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Voxel.Set(g, math.floor(math.cos(a) * 8.6 + 0.5), 2, math.floor(math.sin(a) * 8.6 + 0.5), "Gold")
	end
	Voxel.Shade(g, { Only = { Slate = true, MarbleShade = true }, Smooth = 1, Seed = 2 })
	local water = VX.Split(g, { Water = true })
	local cf = CFrame.new(centre.X, TOP + 0.5, centre.Z)
	local basin = VX.Build(g, { V = 1, Name = "Basin", CF = cf, Collide = true, Parent = m, MaxParts = 64 })
	local waterModel = VX.Build(water, { V = 1, Name = "Water", CF = cf, Collide = false, Parent = m })
	-- Phase 6: the basin and its water (the Nimbus statue on top stays the pet build)
	local ground = CFrame.new(centre.X, TOP, centre.Z)
	if basin then
		Mesh.tag(basin, "prop_fountain", ground)
	end
	if waterModel then
		Mesh.tag(waterModel, "prop_fountain_water", ground)
	end

	local spray = anchorPart(m, "Spray", centre + Vector3.new(0, 10.6, 0))
	emitter(spray, {
		Color = ColorSequence.new(rgb(206, 236, 255), rgb(150, 208, 250)),
		Rate = 26,
		Lifetime = NumberRange.new(0.9, 1.4),
		Speed = NumberRange.new(5, 8),
		SpreadAngle = Vector2.new(24, 24),
		Acceleration = Vector3.new(0, -18, 0),
		Size = popSize(0.55),
		LightEmission = 0.3,
	})
	pointLight(spray, rgb(170, 220, 255), 0.6, 18)

	-- Nimbus on top (optional)
	local ok, err = pcall(function()
		local builderModule = Shared:FindFirstChild("PetBuilder")
		local catalogModule = Shared:FindFirstChild("PetCatalog")
		if not builderModule or not catalogModule then
			return
		end
		local PetBuilder = require(builderModule)
		local PetCatalog = require(catalogModule)
		local def = PetCatalog.Get and PetCatalog.Get("cloudy_dragon")
		if not def or type(PetBuilder.Build) ~= "function" then
			return
		end
		local opts = { Scale = 2.6, Detail = "Low" }
		local function statue()
			local pet = PetBuilder.Build(def, opts)
			if not pet then
				return nil
			end
			pet.Name = "NimbusStatue"
			local topY = TOP + 9.4 -- perched on the top bowl's rim (its stone top is TOP + 10)
			pet:PivotTo(CFrame.new(0, 0, 0))
			local boxCf, boxSize = pet:GetBoundingBox()
			local bottom = pet:GetPivot().Position.Y - (boxCf.Position.Y - boxSize.Y * 0.5)
			if type(bottom) ~= "number" or bottom ~= bottom or bottom < -50 or bottom > 100 then
				bottom = 2
			end
			local y = topY + bottom + 0.6
			pet:PivotTo(flatLook(Vector3.new(centre.X, y, centre.Z), lookTarget))
			for _, d in ipairs(pet:GetDescendants()) do
				if d:IsA("BasePart") then
					d.Anchored = true
					d.CanCollide = false
					d.CanTouch = false
					d.CanQuery = false
				end
			end
			CollectionService:AddTag(pet, EXEMPT_TAG) -- a pet statue: skipped by the 6.4 material / saturation audit
			return pet
		end
		local pet = statue()
		if not pet then
			return
		end
		pet.Parent = m
		-- Phase 6: the mesh Nimbus replaces this Part build once its keys load after boot (MeshLibrary.Swap)
		if type(PetBuilder.SwapWhenReady) == "function" then
			PetBuilder.SwapWhenReady(pet, def, opts, statue)
		end
	end)
	if not ok then
		warn("[LobbyBuilder] fountain statue skipped: " .. tostring(err))
	end
	return m
end

----------------------------------------------------------------------
-- Phase 5 courts (6.1; Phase 6: the P4 colours): the tiled spawn court, the Gate Court with its terrace, the avenue,
-- the welcome arch
----------------------------------------------------------------------
local Court = {}

-- Boxes along an annulus sector (plaza angles in degrees, radii in studs): each segment spans [r0, r1] radially and
-- about `seg` studs of arc. fn(i, n) -> color | nil (skip), topOffset (above TOP), material | nil. A grout gap
-- separates the tiles; neighbours overlap a little at the inner edge, so their heights alternate (rule 5).
function Court.Arc(parent, name, r0, r1, a0, a1, seg, thick, gap, fn)
	local span = a1 - a0
	local rm = (r0 + r1) / 2
	local n = math.max(1, math.floor(math.rad(span) * rm / seg + 0.5))
	local step = span / n
	local width = 2 * r1 * math.sin(math.rad(step) / 2) - gap
	for i = 1, n do
		local color, top, material = fn(i, n)
		if color then
			local a = a0 + (i - 0.5) * step
			local pos = polar(a, rm, TOP + top - thick / 2)
			local cf = CFrame.lookAt(pos, Vector3.new(OX, pos.Y, OZ))
			local p = box(parent, name, cf, Vector3.new(math.max(0.4, width), thick, (r1 - r0) - gap), color, { Collide = true, Material = material, Shadow = false })
			p.CanQuery = true
		end
	end
end

-- Tile colour: the base cream stone with a +-6 RGB jitter per tile, deterministic.
function Court.Jitter(color, a, b)
	local h = hash3(a, b, 7, 31) * 2 - 1
	local d = h * 6 / 255
	return Color3.new(clamp(color.R + d, 0, 1), clamp(color.G + d, 0, 1), clamp(color.B + d * 1.2, 0, 1))
end

-- The tiled courts: concentric Slate rings around the medallion (r 4 .. 32) inside a Marble ring (32 .. 34); the Gate
-- Court's lower level (r 96 .. 126) and its raised terrace (r 126 .. 146, a Marble step in front), Marble rims.
function Court.Tiles(f, L)
	local m = newModel(f, "Courts")
	local slate, slateL = C.Slate, C.SlateLight
	local ring = 0
	local function tiles(name, r0, r1, a0, a1, depth, seg, top)
		local r = r0
		while r < r1 - 0.5 do
			local rb = math.min(r1, r + depth)
			ring = ring + 1
			local thisRing = ring
			Court.Arc(m, name, r, rb, a0, a1, seg, top + 0.6, 0.22, function(i)
				local alt = (i + thisRing) % 2 == 0
				return Court.Jitter(alt and slateL or slate, i, thisRing), top + (alt and 0.05 or 0), materialOf("Slate")
			end)
			r = rb
		end
	end
	-- the spawn court
	tiles("SpawnTile", 4.6, 32, 0, 360, 4.6, 6, 0)
	Court.Arc(m, "SpawnRing", 32, 34.4, 0, 360, 7, 0.7, 0.12, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, 0.08
	end)
	-- the Gate Court (lower level + the raised terrace)
	tiles("CourtTile", G.CourtIn, G.TerraceIn - 1, L.CourtFrom, L.CourtTo, 6, 6, 0)
	Court.Arc(m, "CourtRim", G.CourtIn - 1.6, G.CourtIn + 0.2, L.CourtFrom, L.CourtTo, 8, 0.6, 0.1, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, 0.08
	end)
	Court.Arc(m, "TerraceStep", G.TerraceIn - 1, G.TerraceIn + 1.2, L.CourtFrom, L.CourtTo, 8, 0.9, 0.1, function(i)
		return (i % 2 == 0) and C.Marble or C.MarbleShade, G.TerraceLift + 0.05
	end)
	tiles("TerraceTile", G.TerraceIn + 1.2, G.CourtOut, L.CourtFrom, L.CourtTo, 6.3, 6, G.TerraceLift)
	-- the side edges of the sector: Marble kerbs from the rim to the back of the terrace
	for _, a in ipairs({ L.CourtFrom, L.CourtTo }) do
		local inward = (a == L.CourtFrom) and 1 or -1
		local mid = (G.CourtIn - 1.6 + G.CourtOut) / 2
		local len = G.CourtOut - (G.CourtIn - 1.6)
		local d = dirOf(a)
		local side = dirOf(a + 90) * inward
		local pos = Vector3.new(OX, TOP, OZ) + d * mid + side * 0.6 + Vector3.new(0, G.TerraceLift / 2 - 0.15, 0)
		local p = box(m, "CourtSide", CFrame.lookAt(pos, pos + d), Vector3.new(1.4, G.TerraceLift + 0.75, len), C.MarbleShade, { Collide = true })
		p.CanQuery = true
	end
	Mesh.tag(m, "floor_plaza_courts", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	return m
end

-- The cobbled circle walk (r RingRoadR, 8 wide + Brick borders) from one end of the Gate Court round to the other:
-- arc segments read smoother than voxel cells and cost fewer parts. Its tops sit 0.03 / 0.06 above the voxel paths
-- that cross it (no coplanar overlap).
function Court.RingRoad(f, L)
	local m = newModel(f, "CircleWalk")
	local a0, a1 = L.CourtTo + 0.4, L.CourtFrom + 360 - 0.4
	local R, h = G.RingRoadR, G.PathHalf - 1
	Court.Arc(m, "Walk", R - h, R + h, a0, a1, 8, 0.7, 0.05, function(i)
		local alt = i % 2 == 0
		return Court.Jitter(alt and C.StoneLight or C.Stone, i, 3), alt and 0.06 or 0.03, materialOf("Cobblestone")
	end)
	for _, rb in ipairs({ { R - h - 1.2, R - h + 0.05 }, { R + h - 0.05, R + h + 1.2 } }) do
		Court.Arc(m, "WalkBorder", rb[1], rb[2], a0, a1, 10, 0.6, 0.02, function(i)
			return C.StoneEdge, (i % 2 == 0) and 0.0 or 0.02, materialOf("Brick")
		end)
	end
	Mesh.tag(m, "floor_plaza_walk", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	return m
end

-- Angular gaps (degrees) of the walks crossing a ring of radius r: { centre, half } per crossing walk.
function Court.Gaps(L, r, extra)
	local gaps = {}
	local function add(a, half)
		gaps[#gaps + 1] = { a, math.deg((half + (extra or 0)) / r) }
	end
	for _, a in ipairs(L.SpokeAngles) do
		add(a, G.StubHalf)
	end
	for _, a in ipairs(L.CrossAngles) do
		add(a, G.PathHalf)
	end
	add(L.ShopAngle, G.BoardHalf)
	return gaps
end

-- Arcs of a ring between the gaps (and outside the Gate Court sector when `skipCourt`) -> { { a0, a1 } ... }
function Court.Runs(L, r, gaps, skipCourt)
	local cuts = {}
	for _, g in ipairs(gaps) do
		cuts[#cuts + 1] = { g[1] - g[2], g[1] + g[2] }
	end
	if skipCourt then
		cuts[#cuts + 1] = { L.CourtFrom - 1.5, L.CourtTo + 1.5 }
	end
	-- walk the circle in 0.5-degree steps and collect the free stretches (deterministic, cheap)
	local runs, start = {}, nil
	local function blocked(a)
		for _, c in ipairs(cuts) do
			if angleIn(a, c[1], c[2]) then
				return true
			end
		end
		return false
	end
	local base = 0
	while not blocked(base) and base < 360 do
		base = base + 0.5
	end
	for k = 0, 720 do
		local a = base + k * 0.5
		if not blocked(a) then
			start = start or a
		elseif start then
			if a - 0.5 - start >= 2 then
				runs[#runs + 1] = { start, a - 0.5 }
			end
			start = nil
		end
	end
	return runs
end

-- The plaza's edge: a low Brick kerb all round the lawn (6.4 rule 3: platform edges), open at every exit; clipped
-- hedges along the inner side of the circle walk; lamps along its outer side.
function Court.Edges(f, L)
	local m = newModel(f, "PlazaEdges")
	local rimR0, rimR1 = PLAZA_R - 4.6, PLAZA_R - 3.2
	for _, run in ipairs(Court.Runs(L, rimR1, Court.Gaps(L, rimR1, 2.5), false)) do
		Court.Arc(m, "EdgeKerb", rimR0, rimR1, run[1], run[2], 14, 1.1, 0.02, function(i)
			return C.StoneEdge, (i % 2 == 0) and 0.32 or 0.3, materialOf("Brick")
		end)
	end
	Mesh.tag(m, "floor_plaza_edges", CFrame.new(OX, TOP, OZ)) -- Phase 6 (LayoutSig)
	local decor = newModel(f, "WalkHedges")
	CollectionService:AddTag(decor, DETAIL_TAG)
	local hr0 = G.RingRoadR - G.PathHalf - 4.4
	local hr1 = hr0 + 2.2
	for _, run in ipairs(Court.Runs(L, hr1, Court.Gaps(L, hr1, 1.5), true)) do
		Court.Arc(decor, "Hedge", hr0, hr1, run[1], run[2], 11, 2.2, 0.15, function(i)
			return (i % 2 == 0) and C.Hedge or C.HedgeLight, (i % 2 == 0) and 1.4 or 1.45, materialOf("LeafyGrass")
		end)
	end
	local lampTpl = Props.Lamp()
	local lit = 0
	for _, a in ipairs({ 15, 165, 200, 236, 304, 340 }) do
		if angleDiff(a, L.ShopAngle) > 12 then
			local pos = polar(a, G.RingRoadR + G.PathHalf + 2.2, TOP - LAWN)
			local lamp = place(lampTpl, CFrame.new(pos), decor, "WalkLamp")
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			lit = lit + 1
			if glass and lit % 2 == 1 then
				pointLight(glass, C.Lamp, 1.0, 14)
			end
		end
	end
	return m
end

-- The grand avenue's Brick kerbs (WorldStyle.Kerb), lamp posts every 16 studs and the welcome arch at r 40.
function Court.Avenue(f, L)
	local m = newModel(f, "Avenue")
	local d = dirOf(L.MidAngle)
	local side = dirOf(L.MidAngle - 90) -- the viewer's right when looking up the avenue
	local r0, r1 = G.CourtR + 0.6, G.CourtIn - 1.8
	local mid = (r0 + r1) / 2
	if WorldStyle and WorldStyle.Kerb then
		for _, s in ipairs({ -1, 1 }) do
			local p = Vector3.new(OX, TOP, OZ) + d * mid + side * s * (G.AvenueHalf - 0.6)
			-- X along the edge, LookVector outward
			local cf = CFrame.fromMatrix(p, d * s, Vector3.new(0, 1, 0), -(side * s))
			pcall(WorldStyle.Kerb, m, cf, r1 - r0, materialOf("Brick"), C.StoneEdge)
		end
	end
	local lampTpl = Props.Lamp()
	local r = G.CourtR + 10
	local n = 0
	while r <= G.CourtIn - 6 do
		for _, s in ipairs({ -1, 1 }) do
			local pos = Vector3.new(OX, TOP - LAWN, OZ) + d * r + side * s * (G.AvenueHalf + 2)
			local lamp = place(lampTpl, CFrame.new(pos), m, "AvenueLamp")
			n = n + 1
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			if glass and n % 2 == 1 then
				pointLight(glass, C.Lamp, 1.1, 14)
			end
			reserve(pos.X - OX, pos.Z - OZ, 2)
		end
		r = r + 16
	end
	Court.WelcomeArch(m, L, 40)
	return m
end

-- A stone arch over the avenue with the welcome sign (replaces the rainbow arch): two chamfered Marble piers on Slate
-- plinths, a Slate beam with a Marble cornice, the sign board on the beam (readable from the spawn and the gates).
function Court.WelcomeArch(parent, L, radius)
	local m = newModel(parent, "WelcomeArch")
	local base = polar(L.MidAngle, radius, TOP)
	local cf = flatLook(base, base + dirOf(L.MidAngle)) -- local -Z = up the avenue, towards the gates
	local px = G.AvenueHalf + 2.4
	-- tall enough that the beam stays above the gates' tags seen from the spawn (eye 5 studs up: the tags at 27 studs
	-- and 118 studs out sit ~11 degrees up; the beam's underside at ~27.5 studs and 40 out ~29 degrees)
	local pierH = 24
	for _, s in ipairs({ -1, 1 }) do
		local pc = cf * CFrame.new(s * px, 0, 0)
		if WorldStyle then
			WorldStyle.Plinth(m, pc * CFrame.new(0, 0.7, 0), Vector3.new(4.4, 1.4, 4.4), materialOf("Slate"), C.Slate)
			WorldStyle.Chamfer(m, pc * CFrame.new(0, 1.4 + pierH / 2, 0), Vector3.new(3.2, pierH, 3.2), materialOf("Marble"), C.Marble, 0.5)
		else
			box(m, "Pier", pc * CFrame.new(0, pierH / 2 + 0.7, 0), Vector3.new(3.2, pierH + 1.4, 3.2), C.Marble, { Collide = true })
		end
		box(m, "PierCap", pc * CFrame.new(0, 1.4 + pierH + 0.35, 0), Vector3.new(4, 0.7, 4), C.MarbleShade)
		reserve(base.X - OX + cf.RightVector.X * s * px, base.Z - OZ + cf.RightVector.Z * s * px, 4)
	end
	local beamY = 1.4 + pierH + 0.7 + 1.1
	box(m, "Beam", cf * CFrame.new(0, beamY, 0), Vector3.new(px * 2 + 4, 2.2, 3), C.MarbleShade, { Collide = true })
	box(m, "Cornice", cf * CFrame.new(0, beamY + 1.3, 0), Vector3.new(px * 2 + 4.8, 0.4, 3.6), C.Marble)
	box(m, "Soffit", cf * CFrame.new(0, beamY - 1.25, 0), Vector3.new(px * 2 + 2.6, 0.3, 3.3), C.SlateDark)
	local inlay = box(m, "Inlay", cf * CFrame.new(0, beamY - 0.3, -1.55), Vector3.new(px * 2, 0.25, 0.2), gateAccent("Gold"), { Material = MAT.Neon, Shadow = false })
	inlay.CastShadow = false
	-- the sign on the beam
	local boardCf = cf * CFrame.new(0, beamY + 1.5 + 3.4, 0) * CFrame.Angles(0, math.pi, 0)
	box(m, "SignFrame", boardCf, Vector3.new(19.4, 6.4, 0.8), C.SlateDark)
	box(m, "SignCap", boardCf * CFrame.new(0, 3.45, 0), Vector3.new(20.2, 0.5, 1.2), C.MarbleShade)
	local board = box(m, "WelcomeSign", boardCf, Vector3.new(18.4, 5.4, 1.0), C.Navy, { Shadow = true })
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = surfaceGui(board, face)
		local panel = signPanel(gui, C.TextGold)
		signText(panel, "~ welcome to the clouds ~", "Script", 36, C.TextGold, "Welcome", 0.04, 0.05, 0.92, 0.17)
		local title = signText(panel, Config.GameName, "Title", 100, rgb(255, 255, 255), "Title", 0.03, 0.23, 0.94, 0.44)
		textGradient(title, {
			{ 0, rgb(255, 236, 160) },
			{ 0.5, rgb(255, 255, 255) },
			{ 1, rgb(180, 220, 255) },
		}, 90)
		signText(panel, Config.Tagline or "", "Script", 36, C.Text, "Tagline", 0.04, 0.72, 0.92, 0.17)
		gui.Parent = board
	end
	Mesh.tag(m, "prop_welcome_arch", cf, nil, { "WelcomeSign" }) -- Phase 6: the sign board stays (SurfaceGuis)
	return m
end

-- An obelisk (plinth + chamfered Marble shaft + a Metal cap and a small Neon band in `color`).
function Court.Obelisk(parent, ground, color)
	local m = newModel(parent, "Obelisk")
	local cf = CFrame.new(ground)
	if WorldStyle then
		WorldStyle.Plinth(m, cf * CFrame.new(0, 0.8, 0), Vector3.new(5, 1.6, 5), materialOf("Slate"), C.Slate)
		WorldStyle.Chamfer(m, cf * CFrame.new(0, 1.6 + 7, 0), Vector3.new(3, 14, 3), materialOf("Marble"), C.Marble, 0.5)
	else
		box(m, "Shaft", cf * CFrame.new(0, 8, 0), Vector3.new(3, 16, 3), C.Marble, { Collide = true })
	end
	box(m, "Band", cf * CFrame.new(0, 13, 0), Vector3.new(3.15, 0.3, 3.15), color, { Material = MAT.Neon, Shadow = false })
	box(m, "Cap", cf * CFrame.new(0, 15.95, 0), Vector3.new(3.4, 0.7, 3.4), C.MarbleShade)
	local tip = Instance.new("WedgePart")
	tip.Name = "Tip"
	tip.Anchored = true
	tip.CanCollide = false
	tip.CanQuery = false
	tip.CanTouch = false
	tip.CastShadow = false
	tip.Material = materialOf("Metal")
	tip.Color = C.Gold
	tip.Size = Vector3.new(2.2, 1.6, 1.1)
	tip.CFrame = cf * CFrame.new(0, 17.1, -0.55)
	tip.Parent = m
	local tip2 = tip:Clone()
	tip2.CFrame = cf * CFrame.new(0, 17.1, 0.55) * CFrame.Angles(0, math.pi, 0)
	tip2.Parent = m
	Mesh.tag(m, "prop_obelisk", cf, { Primary = color }) -- Phase 6: the band takes `color`
	return m
end

-- The Gate Court's dressing: hedges in Brick planters along the back of the terrace, a banner behind every gate in its
-- colour, two obelisks at the ends and lamps at the court's front corners.
function Court.Decor(f, L)
	local m = newModel(f, "GateCourtDecor")
	CollectionService:AddTag(m, DETAIL_TAG)
	-- hedges
	local hedgeR0, hedgeR1 = G.CourtOut - 3.4, G.CourtOut - 0.4
	Court.Arc(m, "Planter", hedgeR0, hedgeR1, L.CourtFrom + 1.2, L.CourtTo - 1.2, 10, 1.0, 0.3, function()
		return C.StoneEdge, G.TerraceLift + 1.0, materialOf("Brick")
	end)
	Court.Arc(m, "Hedge", hedgeR0 + 0.3, hedgeR1 - 0.3, L.CourtFrom + 1.2, L.CourtTo - 1.2, 10, 2.4, 0.5, function(i)
		return (i % 2 == 0) and C.Hedge or C.HedgeLight, G.TerraceLift + 3.2, materialOf("LeafyGrass")
	end)
	-- banners behind every gate (their colours, small cloth pieces: rule 2)
	for i, id in ipairs(L.GateOrder) do
		local a = L.GateAngles[id]
		for _, s in ipairs({ -1, 1 }) do
			local pos = polar(a + s * 3.4, G.TerraceIn + 6, TOP + G.TerraceLift)
			bannerPole(m, faceCentre(pos), gateAccent(GATE_SPECS[i].Accent))
		end
	end
	-- obelisks at both ends of the terrace
	for _, a in ipairs({ L.CourtFrom + 3.2, L.CourtTo - 3.2 }) do
		Court.Obelisk(m, polar(a, G.TerraceIn + 9, TOP + G.TerraceLift), gateAccent("Gold"))
	end
	-- lamps at the court's front corners (where the circle walk meets it)
	local lampTpl = Props.Lamp()
	for _, a in ipairs({ L.CourtFrom - 2.5, L.CourtTo + 2.5 }) do
		local pos = polar(a, G.CourtIn - 4, TOP - LAWN)
		local lamp = place(lampTpl, CFrame.new(pos), m, "CourtLamp")
		local glass = lamp and lamp:FindFirstChild("LampGlass")
		if glass then
			pointLight(glass, C.Lamp, 1.2, 16)
		end
	end
	return m
end

-- "How to play" and "Guide" notice boards on both sides of the avenue, facing the spawn.
local function buildBoards(f, L)
	local function spotFor(angle)
		local pos = plazaSpot(angle, 48, 6, L)
		if not pos then
			return nil
		end
		return faceCentre(pos - Vector3.new(0, LAWN, 0)) -- the board's face (-Z, the Front face) looks at the centre
	end
	-- 550 x 400 px canvas (11 x 8 studs): a 1.04-stud header, five 0.6-stud rows, a 0.6-stud footer
	-- (beside the lawns, clear of the sight lines from the spawn to the six gates)
	local howCf = spotFor(L.MidAngle - 58)
	if howCf then
		local face = noticeBoard(f, howCf, 11, 8, "HowToBoard")
		local gui = surfaceGui(face, Enum.NormalId.Front)
		local panel = signPanel(gui)
		signText(panel, "HOW TO PLAY", "Title", 52, C.TextGold, "Header", 0.04, 0.025, 0.92, 0.14)
		local rows = {
			{ "W A S D", "Move around" },
			{ "SHIFT", "Hold to run" },
			{ "Q", "Dash over wide gaps" },
			{ "SPACE", "Jump" },
			{ "E", "Use a gate" },
		}
		for i, row in ipairs(rows) do
			keyRow(panel, 0.18 + (i - 1) * 0.12, 0.105, row[1], row[2])
		end
		signText(panel, "Walk up the avenue to the GATES!", "Body", SIGN_INFO, C.TextGold, "Footer", 0.05, 0.785, 0.9, 0.19, nil, true)
		gui.Parent = face
	end
	local guideCf = spotFor(L.MidAngle + 58)
	if guideCf then
		local face = noticeBoard(f, guideCf, 11, 8, "GuideBoard")
		local gui = surfaceGui(face, Enum.NormalId.Front)
		local panel = signPanel(gui, rgb(150, 200, 255))
		signText(panel, "THE GATES", "Title", 52, C.TextGold, "Header", 0.04, 0.025, 0.92, 0.14)
		-- Phase 6: the 5 real Gate Court gates (no Home gate any more); the way home is the footer hint
		local lines = {
			{ "OBBY", "Climb with friends" },
			{ "DUNGEON", "Explore with your team" },
			{ "RING", "Beat the champion" },
			{ "ARENA", "Duels and raids" },
			{ "ALTAR", "Secret storm pets!" },
		}
		for i, line in ipairs(lines) do
			keyRow(panel, 0.18 + (i - 1) * 0.12, 0.105, line[1], line[2])
		end
		signText(panel, "Going home?\nTap Home, then Go home!", "Body", SIGN_INFO, C.TextGold, "Footer", 0.05, 0.785, 0.9, 0.19, nil, true)
		gui.Parent = face
	end
end

-- Plaza decor: courts, avenue, fountain, boards, NPC spots, trees, lamps, benches, flower beds.
local function buildPlazaDecor(f, L)
	reserve(L.FountainX, L.FountainZ, 15)
	reserve(0, 0, G.CourtR + 2)

	local fountainPos = Vector3.new(OX + L.FountainX, TOP, OZ + L.FountainZ)
	local okF, errF = pcall(buildFountain, f, fountainPos, Vector3.new(OX, TOP, OZ))
	if not okF then
		warn("[LobbyBuilder] fountain failed: " .. tostring(errF))
	end
	for _, part in ipairs({
		{ "court decor", Court.Decor },
		{ "avenue", Court.Avenue },
		{ "boards", buildBoards },
	}) do
		local ok, err = pcall(part[2], f, L)
		if not ok then
			warn("[LobbyBuilder] " .. part[1] .. " failed: " .. tostring(err))
		end
	end

	-- NPC spots (NpcService builds the pets): on the east / west lawns (6.1: r 62..80, >= 12 studs from any path),
	-- facing the nearest walk.
	L.NpcSpots = {}
	local npcPlan = { 20, 160, 215, 235, 305, 325 }
	for _, a in ipairs(npcPlan) do
		local pos = plazaSpot(a, 70, 5, L, false)
		if not pos then
			pos = plazaSpot(a, 76, 5, L, true)
		end
		L.NpcSpots[#L.NpcSpots + 1] = flatLook(pos, Vector3.new(OX, TOP, OZ))
	end

	local decor = newModel(f, "LawnDecor")
	CollectionService:AddTag(decor, DETAIL_TAG)
	-- Trees on the lawns, between the walks (never near the courts).
	local trees = {
		{ 8, 120, "Round" }, { 36, 130, "Pine" }, { 144, 130, "Pine" }, { 172, 120, "Round" },
		{ 196, 126, "Blossom" }, { 226, 130, "Round" }, { 314, 130, "Round" }, { 344, 126, "Blossom" },
	}
	for i, t in ipairs(trees) do
		local pos = plazaSpot(t[1], t[2], 6, L)
		if pos then
			place(Props.Tree(t[3]), CFrame.new(pos - Vector3.new(0, LAWN, 0)) * CFrame.Angles(0, math.rad(i * 77), 0), decor, t[3] .. "Tree")
		end
	end

	-- Lamps where the walks meet the circle walk and at every exit through the rim.
	local lampTpl = Props.Lamp()
	local lit = 0
	local function lampAt(pos, name, light)
		local lamp = place(lampTpl, CFrame.new(pos), decor, name)
		local glass = lamp and lamp:FindFirstChild("LampGlass")
		if glass and light and lit < 6 then
			lit = lit + 1
			pointLight(glass, C.Lamp, 1.0, 14)
		end
	end
	for _, a in ipairs(L.CrossAngles) do
		for _, s in ipairs({ -1, 1 }) do
			local pos = polar(a, G.RingRoadR - G.PathHalf - 2.2, TOP - LAWN) + dirOf(a + 90) * s * (G.PathHalf + 2)
			lampAt(pos, "WalkLamp", s > 0)
		end
	end
	for _, a in ipairs(L.RimGaps) do
		local half = (angleDiff(a, L.ShopAngle) < 1) and G.BoardHalf or G.StubHalf
		local side = dirOf(a + 90)
		for _, s in ipairs({ -1, 1 }) do
			if s > 0 or angleDiff(a, L.ShopAngle) < 1 then
				lampAt(polar(a, PLAZA_R - 6, TOP - LAWN) + side * s * (half + 1.8), "ExitLamp", angleDiff(a, L.ShopAngle) < 1)
			end
		end
	end

	-- Benches on the inner lawns facing the spawn, flower beds along the circle walk.
	local benchTpl = Props.Bench()
	for _, b in ipairs({ { 50, 44 }, { 130, 44 }, { 200, 44 }, { 340, 44 } }) do
		local pos = plazaSpot(b[1], b[2], 3.5, L)
		if pos then
			place(benchTpl, faceCentre(pos - Vector3.new(0, LAWN, 0)), decor, "Bench")
		end
	end
	local beds = { 30, 150, 190, 250, 290, 350 }
	for i, a in ipairs(beds) do
		local pos = plazaSpot(a, G.RingRoadR - G.PathHalf - 14, 4, L)
		if pos then
			place(Props.FlowerBed((i - 1) % #FLOWERS + 1), faceCentre(pos - Vector3.new(0, LAWN, 0)), decor, "FlowerBed")
		end
	end

	-- Fireflies and sparkle dust over the lawns.
	local flies = anchorPart(f, "Fireflies", Vector3.new(OX, TOP + 6, OZ), Vector3.new(PLAZA_R * 1.7, 10, PLAZA_R * 1.7))
	emitter(flies, {
		Color = ColorSequence.new(rgb(255, 236, 150), rgb(190, 240, 170)),
		Rate = 10,
		Lifetime = NumberRange.new(5, 8),
		Speed = NumberRange.new(0.3, 1),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.45),
	})
end

local function buildPlaza(root, L)
	local f = newFolder(root, "Plaza")
	buildPlazaGround(f, L)
	for _, part in ipairs({ { "court tiles", Court.Tiles }, { "circle walk", Court.RingRoad }, { "edges", Court.Edges } }) do
		local ok, err = pcall(part[2], f, L)
		if not ok then
			warn("[LobbyBuilder] " .. part[1] .. " failed: " .. tostring(err))
		end
	end
	local okBody, errBody = pcall(buildPlazaBody, f, L)
	if not okBody then
		warn("[LobbyBuilder] plaza cloud failed: " .. tostring(errBody))
	end
	local okDecor, errDecor = pcall(buildPlazaDecor, f, L)
	if not okDecor then
		warn("[LobbyBuilder] plaza decor failed: " .. tostring(errDecor))
	end
	return f
end

----------------------------------------------------------------------
-- Phase 5 Gate Court gates (6.1 / 6.2): Obby and Altar are built here with WorldStyle.BuildGate into the
-- Gates folder; Ring / Arena (ArenaBuilder) and Dungeon (DungeonBuilder, W3) stand at LobbyInfo.GateSites.
----------------------------------------------------------------------
local Gates = {}

Gates.Info = {
	Obby = { Title = "Sky Obby", Info = "Climb the clouds", Pad = true },
	Altar = { Title = "Storm Altar", Info = "The secret roulette", Pad = false },
}
Gates.Built = { "Obby", "Altar" } -- the lobby's own gates, in Build order (Phase 6: no Home gate)

function Gates.Spec(id)
	for _, s in ipairs(GATE_SPECS) do
		if s.Id == id then
			return s
		end
	end
	return GATE_SPECS[1]
end

-- Ground CFrame of every gate centre on the arc (LookVector = towards the plaza centre).
function Gates.Sites(L)
	local sites = {}
	for _, id in ipairs(L.GateOrder) do
		sites[id] = faceCentre(polar(L.GateAngles[id], G.GateR, TOP))
	end
	return sites
end

-- A plain gate when WorldStyle is missing or BuildGate throws: two columns, a lintel, the pad / step, the prompt anchor
-- and a pixel tag (the same names as BuildGate, so GateService / PortalService work unchanged).
function Gates.Fallback(parent, site, id, info, color)
	local model = newModel(parent, "Portal_" .. id)
	model:SetAttribute("GateId", id)
	for side = -1, 1, 2 do
		box(model, "Column", site * CFrame.new(side * 8.2, 8, 0), Vector3.new(2.4, 16, 2.4), C.Marble, { Collide = true })
	end
	local lintel = box(model, "Lintel", site * CFrame.new(0, 17.4, 0), Vector3.new(21.4, 2.4, 3), C.Slate, { Collide = true })
	box(model, "PortalDisc", site * CFrame.new(0, 8, 0), Vector3.new(13, 14, 0.2), color, { Material = MAT.Neon, Transparency = 0.35, Shadow = false })
	local pad
	if info.Pad then
		pad = box(model, "Pad", site * CFrame.new(0, 0.3, -14), Vector3.new(14, 0.6, 14), C.Slate, { Collide = true })
	else
		pad = box(model, "Step", site * CFrame.new(0, 0.15, -6), Vector3.new(10, 0.3, 6), C.Slate, { Collide = true })
	end
	local prompt = box(model, "PromptAnchor", site * CFrame.new(0, 3, -2.2), Vector3.new(2, 2, 1), C.Slate, { Transparency = 1, Shadow = false })
	local gui = newTag(lintel, "GateTag", 420, 150, 27 - 17.4, 120)
	local plate = tagPlate(gui, color, 190, Enum.FillDirection.Vertical, 2)
	tagText(plate, "Title", info.Title, "Heading", 28, rgb(255, 255, 255), 1)
	tagText(plate, "Info", info.Info, "Body", 20, C.TextDim, 2)
	local pill = tagPill(plate, "Pill", "", "Label", 18, color:Lerp(C.Ink, 0.55), 3)
	pill.Visible = false
	model.PrimaryPart = lintel
	return model, pad, prompt
end

-- One gate of the court -> { Model, Pad, PromptPart }.
function Gates.BuildOne(parent, site, id)
	local spec = Gates.Spec(id)
	local info = Gates.Info[id] or { Title = id, Info = "", Pad = false }
	local ok, model, pad, prompt = false, nil, nil, nil
	if WorldStyle and type(WorldStyle.BuildGate) == "function" then
		ok, model, pad, prompt = pcall(WorldStyle.BuildGate, parent, site, {
			Id = id,
			Title = info.Title,
			Info = info.Info,
			Color = spec.Accent,
			Glyph = spec.Glyph,
			Pad = info.Pad,
			Name = "Portal_" .. id,
		})
		if not ok then
			warn("[LobbyBuilder] gate " .. id .. " failed: " .. tostring(model))
			local broken = parent:FindFirstChild("Portal_" .. id)
			if broken then
				broken:Destroy()
			end
		end
	end
	if not ok or not model then
		model, pad, prompt = Gates.Fallback(parent, site, id, info, gateAccent(spec.Accent))
	end
	return { Model = model, Pad = pad, PromptPart = prompt, Site = site }
end

-- The Obby portal's PortalInfo: the gate + the PortalService zone on its pad (14 x 6 x 14, floor flush with the pad,
-- -Z facing the plaza) and the gate's pixel tag (PortalService writes the live party state into it).
function Gates.ObbyPortal(gate)
	local pad = gate.Pad
	local top = pad.Position.Y + pad.Size.Y / 2
	local zonePos = Vector3.new(pad.Position.X, top + 3, pad.Position.Z)
	local zone = box(gate.Model, "Zone_Obby", faceCentre(zonePos), Vector3.new(14, 6, 14), C.Slate, { Transparency = 1, Shadow = false })
	zone.CanQuery = false
	zone:SetAttribute("PortalId", "Obby")
	local tag = gate.Model:FindFirstChild("GateTag", true)
	local plate = tag and tag:FindFirstChild("Plate")
	local pill = plate and plate:FindFirstChild("Pill")
	return {
		Id = "Obby",
		Model = gate.Model,
		Zone = zone,
		Center = zone.Position,
		Pad = pad,
		PromptPart = gate.PromptPart,
		Billboard = tag,
		TitleLabel = plate and plate:FindFirstChild("Title"),
		InfoLabel = plate and plate:FindFirstChild("Info"),
		StatusPill = pill,
		StatusLabel = pill and (pill:FindFirstChild("Label") or pill:FindFirstChild("PillLabel")),
	}
end

----------------------------------------------------------------------
-- Shop island: four gacha-style roulette machines, the item stall, a rarity board, a token statue
----------------------------------------------------------------------

-- Size (studs) of the name + price card floating above every roulette machine.
local MACHINE_CARD_W = 14
local MACHINE_CARD_H = 7.6
local machineBoxCache = nil

-- Pixel tag of a roulette machine: the name in the roulette colour + a gold price. The machines stand ~15 studs
-- apart, so the tags hide beyond 60 studs (constant-size tags of neighbours would overlap on screen from afar).
local function machineTag(anchor, roulette, lift)
	local color = roulette.Color or C.Rose
	local gui = newTag(anchor, "PriceBillboard", 320, 110, lift, 60)
	local plate = tagPlate(gui, color, 160)
	tagText(plate, "NameLabel", roulette.DisplayName or roulette.Id, "Title", 26, color:Lerp(C.Text, 0.55), 1)
	tagText(plate, "PriceLabel", priceText(roulette.Price or 0), "Display", 24, C.TextGold, 2)
	return gui
end

-- Rarities (in Config order) that a roulette can actually pay out.
local function oddsRarities(roulette)
	local list = {}
	for _, rarity in ipairs(Config.Rarities) do
		if roulette.Odds and (roulette.Odds[rarity.Id] or 0) > 0 then
			list[#list + 1] = rarity
		end
	end
	return list
end

-- the P4 machine colours: the roulette colour on the cabinet, gold trims, cream wheel segments, a glass dome
local function machinePalette(roulette)
	local color = roulette.Color or C.Rose
	local pal = {
		Base = C.Iron,
		Body = color,
		Trim = C.Gold,
		Seg1 = color:Lerp(rgb(255, 255, 255), 0.45),
		Seg2 = C.Cream,
		Rim = C.GoldDark,
		Hub = C.Gold,
		Dark = rgb(42, 46, 70),
		Glass = { Color = rgb(214, 236, 255), Material = MAT.Glass, Transparency = 0.55 },
		Bulb = { Color = C.Lamp, Material = MAT.Neon },
		Knob = { Color = color, Material = MAT.Neon },
		Iron = C.IronLight,
	}
	local rarities = oddsRarities(roulette)
	for i = 1, 4 do
		local r = rarities[(i - 1) % math.max(1, #rarities) + 1]
		pal["Egg" .. i] = (r and r.Color) or color
	end
	return pal
end

-- The machine is sculpted and merged once; each roulette builds it with its own colours. Front = -Z.
-- Two resolutions: the cabinet, wheel and lever in fine half-stud voxels, the glass dome in 1-stud voxels
-- (translucent voxels cannot hide behind each other, so a coarse dome keeps the part count sane).
local function machineBoxes()
	if machineBoxCache then
		return machineBoxCache
	end
	local g = Voxel.NewGrid(28)
	VX.RoundRect(g, 0, 0, 18, 14, 3, 0, 1, "Base")
	VX.RoundRect(g, 0, 0, 15, 11, 2, 2, 2, "Trim")
	VX.RoundRect(g, 0, 0, 14, 10, 2, 3, 10, "Body")
	VX.RoundRect(g, 0, 0, 15, 11, 2, 11, 11, "Trim")
	VX.RoundRect(g, 0, 0, 8, 8, 2, 12, 13, "Trim")
	-- the prize wheel on the front: eight coloured segments, a gold rim and hub, a red pointer on top
	local wy = 7
	for x = -4, 4 do
		for y = 3, 11 do
			local dy = y - wy
			local d = math.sqrt(x * x + dy * dy)
			if d <= 3.7 then
				local key
				if d <= 1.0 then
					key = "Hub"
				elseif d >= 2.9 then
					key = "Rim"
				else
					local seg = math.floor((atan2(dy, x) + math.pi) / (math.pi / 4))
					key = (seg % 2 == 0) and "Seg1" or "Seg2"
				end
				Voxel.Set(g, x, y, -6, key)
			end
		end
	end
	Voxel.Set(g, 0, 11, -6, "Knob")
	Voxel.Set(g, 0, 11, -7, "Knob")
	-- prize chute + gold tray, marquee bulbs on the top band
	VX.Fill(g, -2, 2, 3, 3, -6, -6, "Dark")
	VX.Fill(g, -2, 2, 2, 2, -7, -6, "Trim")
	for _, x in ipairs({ -6, -3, 3, 6 }) do
		Voxel.Set(g, x, 11, -6, "Bulb")
	end
	-- lever on the right side
	Voxel.Shape(g, { Kind = "Capsule", A = { 7.4, 6, 0 }, B = { 9, 12, 0 }, Radius = 0.6, Key = "Iron" })
	Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 9, 13.2, 0 }, Radius = 1.3, Key = "Knob" })
	Voxel.Shade(g, {
		Skip = { Bulb = true, Seg1 = true, Seg2 = true, Hub = true, Rim = true, Dark = true, Knob = true },
		Smooth = 1,
		Seed = 12,
	})

	-- the glass dome full of pet eggs (1-stud voxels), sitting on the neck
	local d = Voxel.NewGrid(8)
	Voxel.Shape(d, { Kind = "Ellipsoid", Center = { 0, 9.4, 0 }, Radius = { 3.1, 2.9, 3.1 }, Key = "Glass" })
	local eggs = { { -1.2, 8.1, -0.9 }, { 1.2, 8.2, 0.7 }, { 0.2, 9.8, -1.3 }, { -0.9, 10, 1.1 }, { 1.4, 9.9, -0.2 }, { -0.1, 8.4, 1.6 } }
	for i, e in ipairs(eggs) do
		Voxel.Shape(d, { Kind = "Ellipsoid", Center = e, Radius = { 0.75, 0.95, 0.75 }, Key = "Egg" .. ((i - 1) % 4 + 1), Bias = 0.15 })
	end
	VX.RoundRect(d, 0, 0, 3, 3, 0.8, 12, 12, "Trim")
	Voxel.Set(d, 0, 13, 0, "Bulb")
	local pal = machinePalette(Config.Roulettes[1] or { Color = C.Rose })
	-- LOD only folds shade variants (the coloured keys differ per roulette, so they are kept as they are)
	local keep = { "Body", "Trim", "Seg1", "Seg2", "Rim", "Hub", "Glass", "Egg1", "Egg2", "Egg3", "Egg4", "Bulb", "Knob", "Base", "Iron", "Dark" }
	machineBoxCache = {
		Fine = Voxel.Merge(g, { Palette = pal, MaxParts = 70, Keep = keep }),
		Dome = Voxel.Merge(d, { Palette = pal, Keep = keep }),
	}
	return machineBoxCache
end

-- A gacha roulette machine (Model Roulette_<Id>). `cf` sits on the ground; LookVector = towards the customer.
local function buildMachine(parent, cf, roulette)
	local model = newModel(parent, "Roulette_" .. roulette.Id)
	local body = Instance.new("Model")
	body.Name = "Machine"
	-- the sculpt's front (-Z) faces along cf.LookVector (the customer)
	local boxes = machineBoxes()
	local pal = machinePalette(roulette)
	Voxel.BuildBoxes(boxes.Fine, { VoxelSize = 0.5, Palette = pal, CFrame = cf * CFrame.new(0, 0.25, 0), Model = body, CanCollide = true, CanQuery = true })
	Voxel.BuildBoxes(boxes.Dome, { VoxelSize = 1, Palette = pal, CFrame = cf * CFrame.new(0, 0.5, 0), Model = body, CanCollide = true, CanQuery = true })
	body.Parent = model
	-- Phase 6: one cabinet design for every roulette (cabinet + knob = the roulette colour, eggs = its top rarity)
	local rarities = oddsRarities(roulette)
	local top = rarities[#rarities]
	Mesh.tag(body, "prop_roulette", cf, { Primary = roulette.Color or C.Rose, Secondary = (top and top.Color) or C.Gold })
	local cabinet = nil
	for _, d in ipairs(body:GetChildren()) do
		if d:IsA("BasePart") and d.Name == "Body" and (not cabinet or d.Size.Magnitude > cabinet.Size.Magnitude) then
			cabinet = d
		end
	end
	local glow = anchorPart(model, "DomeGlow", (cf * CFrame.new(0, 9.5, 0)).Position)
	pointLight(glow, roulette.Color or C.Lamp, 0.9, 18)
	emitter(glow, {
		Color = ColorSequence.new((roulette.Color or C.Rose):Lerp(rgb(255, 255, 255), 0.4), C.TextGold),
		Rate = 3,
		Lifetime = NumberRange.new(1.5, 2.5),
		Speed = NumberRange.new(1, 2.5),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.5),
	})

	-- Name + price tag standing on the dome.
	local anchor = anchorPart(model, "PriceAnchor", (cf * CFrame.new(0, 14.2 + MACHINE_CARD_H * 0.5, 0)).Position)
	machineTag(anchor, roulette, 0.5 - MACHINE_CARD_H * 0.5)

	-- Invisible spot in front where PetService hangs the ProximityPrompt.
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5.4), Vector3.new(5, 4, 3), roulette.Color or C.Rose, { Transparency = 1, Shadow = false })
	prompt.CanQuery = false
	model.PrimaryPart = cabinet or prompt
	return {
		Id = roulette.Id,
		PromptPart = prompt,
		Center = (cf * CFrame.new(0, 3.5, 0)).Position,
		Model = model,
	}
end

local function fallbackMachine(parent, cf, roulette)
	local old = parent:FindFirstChild("Roulette_" .. roulette.Id)
	if old then
		old:Destroy()
	end
	local model = newModel(parent, "Roulette_" .. roulette.Id)
	local cabinet = box(model, "Cabinet", cf * CFrame.new(0, 3, 0), Vector3.new(7, 6, 5), roulette.Color or C.Rose, { Collide = true })
	local anchor = anchorPart(model, "PriceAnchor", (cf * CFrame.new(0, 10, 0)).Position)
	machineTag(anchor, roulette, -2.5)
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -5), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	model.PrimaryPart = cabinet
	return { Id = roulette.Id, PromptPart = prompt, Center = cabinet.Position, Model = model }
end

-- Striped market stall with goods on the shelf (Model ItemShop). Front (-Z of the sculpt) faces the customer.
local function buildItemStall(parent, cf)
	local model = newModel(parent, "ItemShop")
	local g = Voxel.NewGrid(14)
	VX.RoundRect(g, 0, 0, 10, 3, 0.6, 0, 2, "Wood")
	VX.RoundRect(g, 0, 0, 11, 4, 0.8, 3, 3, "Top")
	for x = -4, 4 do
		for y = 0, 2 do
			Voxel.Set(g, x, y, -2, (math.floor((x + 4) / 1) % 2 == 0) and "Rose" or "Cream")
		end
	end
	VX.Fill(g, -5, 5, 0, 8, 3, 3, "WoodDark")
	VX.Fill(g, -4, 4, 5, 5, 2, 2, "Wood")
	for _, sx in ipairs({ -6, 6 }) do
		VX.Fill(g, sx, sx, 0, 8, -3, -3, "Post")
		VX.Fill(g, sx, sx, 0, 10, 3, 3, "Post")
	end
	-- striped awning in three steps, sloping down to the front, with a scalloped fringe
	for x = -7, 7 do
		local stripe = (math.floor((x + 7) / 2) % 2 == 0) and "Rose" or "Cream"
		for z = -4, 4 do
			local y = 9 + math.floor((z + 4) / 3)
			Voxel.Set(g, x, y, z, stripe)
		end
		if x % 2 == 0 then
			Voxel.Set(g, x, 8, -4, stripe)
		end
	end
	-- goods: heal cloud, shield bubble, phoenix feather on the shelf; coins on the counter
	Voxel.Shape(g, { Kind = "Ellipsoid", Center = { -3, 6.5, 2 }, Radius = { 1.3, 0.8, 0.6 }, Key = "Heal" })
	Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 0, 6.7, 2 }, Radius = { 0.9, 0.9, 0.6 }, Key = "Shield" })
	Voxel.Shape(g, { Kind = "Curve", Points = { { 2.6, 6, 2 }, { 3.2, 7, 2 }, { 3.5, 8.1, 2 } }, Radius = 0.45, RadiusB = 0.2, Key = "Feather" })
	Voxel.Set(g, 3, 8, 2, "Gold")
	Voxel.Set(g, 2, 4, 0, "Gold")
	Voxel.Set(g, 3, 4, -1, "Gold")
	Voxel.Set(g, -3, 4, 0, "Heal")
	Voxel.Shade(g, { Skip = { Shield = true, Rose = true, Cream = true }, Smooth = 1, Seed = 13 })
	local stallModel = VX.Build(g, {
		V = 1,
		Name = "Stall",
		CF = cf * CFrame.new(0, 0.5, 0),
		Collide = true,
		Parent = model,
		Pal = {
			Wood = P.Plank,
			WoodDark = P.PlankDark,
			Post = P.PlankDark,
			Top = { Color = C.Cream, Material = materialOf("Fabric") },
			Rose = { Color = C.Rose, Material = materialOf("Fabric") },
			Cream = { Color = C.Cream, Material = materialOf("Fabric") },
			Heal = { Color = rgb(124, 214, 150), Material = materialOf("Glass") },
			Shield = { Color = rgb(120, 184, 250), Material = MAT.Glass, Transparency = 0.35 },
			Feather = rgb(244, 136, 70),
			Gold = C.Gold,
		},
		MaxParts = 80,
	})
	if stallModel then
		Mesh.tag(stallModel, "prop_item_stall", cf) -- Phase 6
	end
	local lamp = anchorPart(model, "StallLight", (cf * CFrame.new(0, 7.5, 0)).Position)
	pointLight(lamp, C.Lamp, 0.8, 16)

	-- name tag standing on the awning (bottom edge 13.3 studs up)
	local anchor = anchorPart(model, "SignAnchor", (cf * CFrame.new(0, 15.5, 0)).Position)
	local bb = newTag(anchor, "ItemShopBillboard", 320, 110, -2.2, 80)
	local plate = tagPlate(bb, C.Rose, 160)
	tagText(plate, "NameLabel", "Item Shop", "Title", TAG_NAME, C.Text, 1)
	tagText(plate, "SubLabel", "Heal " .. GLYPH.Bullet .. " Shield " .. GLYPH.Bullet .. " Revive", "Body", TAG_INFO, C.TextGold, 2, 2)

	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -4.6), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	local counter = model:FindFirstChild("Stall")
	model.PrimaryPart = (counter and counter.PrimaryPart) or prompt
	return { PromptPart = prompt, Center = (cf * CFrame.new(0, 1.7, 0)).Position, Model = model }
end

local function fallbackItemStall(parent, cf)
	local old = parent:FindFirstChild("ItemShop")
	if old then
		old:Destroy()
	end
	local model = newModel(parent, "ItemShop")
	local counter = box(model, "Counter", cf * CFrame.new(0, 1.7, 0), Vector3.new(9, 3.4, 3.2), C.Plank, { Collide = true })
	local prompt = box(model, "PromptPart", cf * CFrame.new(0, 2, -4.6), Vector3.new(5, 4, 3), C.Cloud, { Transparency = 1, Shadow = false })
	model.PrimaryPart = counter
	return { PromptPart = prompt, Center = counter.Position, Model = model }
end

-- Board that explains the roulettes: price, and which rarities each one can give.
local function buildRarityBoard(parent, cf)
	-- 700 x 450 px canvas (14 x 9 studs): a 1-stud header, then one row per roulette: the name and the price
	-- (0.6 stud) over rarity pills that spell out what it can pay (0.6 stud)
	local face = noticeBoard(parent, cf, 14, 9, "RarityBoard")
	local gui = surfaceGui(face, Enum.NormalId.Front)
	local panel = signPanel(gui)
	local H = 450
	signText(panel, "WINGED PETS", "Title", 50, C.Gold, "Header", 0.04, 6 / H, 0.92, 54 / H)
	signText(panel, "Pricier roulette = rarer pets", "Body", SIGN_INFO, C.Text, "Sub", 0.04, 60 / H, 0.92, 34 / H)
	for i, roulette in ipairs(Config.Roulettes) do
		local top = 102 + (i - 1) * 84
		local y = top / H
		local color = roulette.Color or C.Rose
		signText(panel, roulette.DisplayName or roulette.Id, "Heading", SIGN_INFO, color:Lerp(C.Text, 0.35), "Name" .. i, 0.04, y, 0.6, 36 / H, Enum.TextXAlignment.Left)
		signText(panel, priceText(roulette.Price or 0), "Body", SIGN_INFO, C.TextGold, "Price" .. i, 0.6, y, 0.36, 36 / H, Enum.TextXAlignment.Right)
		local pills = plainFrame(panel, "Rarities" .. i, {
			Position = UDim2.new(0.04, 0, (top + 38) / H, 0),
			Size = UDim2.new(0.92, 0, 36 / H, 0),
		})
		local layout = listLayout(pills, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left)
		layout.VerticalAlignment = Enum.VerticalAlignment.Center
		for k, rarity in ipairs(oddsRarities(roulette)) do
			local pill = tagPill(pills, "Rarity_" .. rarity.Id, rarity.Id, "Body", SIGN_INFO, rarity.Color:Lerp(C.Navy, 0.18), k)
			local pad = pill:FindFirstChildOfClass("UIPadding")
			if pad then -- a slim pill: the row keeps a clear gap to the next roulette
				pad.PaddingTop = UDim.new(0, 0)
				pad.PaddingBottom = UDim.new(0, 0)
			end
			pill.Size = UDim2.fromOffset(0, 34)
		end
	end
	gui.Parent = face
end

-- A big decorative voxel coin with a cloud emblem on a pedestal (NOT a collectible token).
local function buildTokenStatue(parent, ground)
	local m = newModel(parent, "TokenStatue")
	local g = Voxel.NewGrid(12)
	VX.RoundRect(g, 0, 0, 6, 6, 1.2, 0, 1, "StoneLight")
	VX.RoundRect(g, 0, 0, 4.4, 4.4, 1, 2, 2, "Stone")
	for x = -4, 4 do
		for y = -4, 4 do
			local d = math.sqrt(x * x + y * y)
			if d <= 4.3 then
				local key = (d >= 3.4) and "GoldDark" or "Gold"
				Voxel.Set(g, x, 7 + y, 0, key)
			end
		end
	end
	-- the cloud emblem in relief on both faces
	local emblem = {}
	for _, row in ipairs({ { 2, -1, 0 }, { 1, -2, 2 }, { 0, -3, 3 }, { -1, -2, 2 } }) do
		for x = row[2], row[3] do
			emblem[#emblem + 1] = { x, row[1] }
		end
	end
	for _, e in ipairs(emblem) do
		Voxel.Set(g, e[1], 7 + e[2], -1, "GoldGlow")
		Voxel.Set(g, e[1], 7 + e[2], 1, "GoldGlow")
	end
	VX.Fill(g, -1, 1, 3, 3, 0, 0, "GoldDark")
	Voxel.Shade(g, { Only = { StoneLight = true, Stone = true }, Smooth = 1 })
	local coinCf = flatLook(ground, Vector3.new(OX, ground.Y, OZ))
	local coin = VX.Build(g, { V = 1, Name = "Coin", CF = coinCf * CFrame.new(0, 0.5, 0), Collide = true, Parent = m })
	if coin then
		Mesh.tag(coin, "prop_token_statue", coinCf) -- Phase 6
	end
	local sparkle = anchorPart(m, "CoinSparkle", ground + Vector3.new(0, 7, 0), Vector3.new(6, 6, 2))
	emitter(sparkle, { Rate = 5, Lifetime = NumberRange.new(1.2, 2), Speed = NumberRange.new(0.5, 1.5), SpreadAngle = Vector2.new(180, 180), Size = popSize(0.6) })
	return m
end

local function buildShop(root, L)
	local f = newFolder(root, "Shop")
	local S = L.ShopCenter
	local R = L.ShopR
	local shopCF = flatLook(S, Vector3.new(OX, TOP, OZ)) -- local -Z = towards the plaza (the entrance)
	local function at(x, z)
		return (shopCF * CFrame.new(x, 0, z)).Position
	end
	local function local2(wx, wz)
		local p = shopCF:PointToObjectSpace(Vector3.new(S.X + wx, TOP, S.Z + wz))
		return p.X, p.Z
	end
	local rng = Util.NewRng(SEED + 4)

	-- Ground layers (2-stud cells): lawn, patches + flowers, borders, the stone court + entrance path, inlays.
	local cell = 2
	local n = math.ceil(R / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	for i = -n, n do
		for k = -n, n do
			local wx, wz = i * cell, k * cell
			local r = math.sqrt(wx * wx + wz * wz)
			if r <= R - 0.5 then
				local x, z = local2(wx, wz)
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local nz = vnoise(wx + 50, wz + 50, 22, 31)
				if r > R - 3 then
					nz = 0.5 -- lawn only at the very edge
				end
				if nz < 0.26 then
					Voxel.Set(grids[2], i, 0, k, "GrassDark")
				elseif nz > 0.76 then
					Voxel.Set(grids[2], i, 0, k, "GrassLight")
				end
				local court = r <= 21
				local path = z < 0 and math.abs(x) <= 7
				if court or path then
					Voxel.Set(grids[3], i, 0, k, "StoneEdge")
				end
				if r <= 19 or (z < 0 and math.abs(x) <= 5) then
					Voxel.Set(grids[4], i, 0, k, "Stone")
				elseif not court and not path and r > R - 7 and r < R - 3 and hash3(i, 3, k, 8) < 0.07 then
					Voxel.Set(grids[2], i, 0, k, "Flower" .. (math.floor(hash3(i, 4, k, 2) * #FLOWERS) + 1))
				end
				if r <= 19 then
					if r >= 12 and r <= 13.5 then
						Voxel.Set(grids[5], i, 0, k, "StoneLight")
					elseif r >= 4.5 and r <= 6.5 then
						Voxel.Set(grids[5], i, 0, k, "GoldDark")
					end
				end
			end
		end
	end
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	for li = 1, 5 do
		local layer = VX.Build(grids[li], { V = cell, Name = "Ground" .. li, CF = CFrame.new(S.X, TOP + tops[li] - cell / 2, S.Z), Collide = true, Shadow = false, Parent = f })
		if layer then
			Mesh.tag(layer, "floor_shop_" .. li, CFrame.new(S.X, TOP, S.Z)) -- Phase 6 (LayoutSig)
		end
	end

	-- The shop's cloud body + the stone neck to the plaza.
	local okBody, errBody = pcall(function()
		local rim = {}
		for i = 1, 9 do
			local a = (i - 1) / 9 * 360 + rng:Float(-5, 5)
			local wx, wz = math.cos(math.rad(a)) * (R + 1.5), math.sin(math.rad(a)) * (R + 1.5)
			local _, lz = local2(wx, wz)
			if lz > -R * 0.55 then
				local s = rng:Float(8, 10)
				rim[#rim + 1] = { wx, rng:Float(-1, 1), wz, s, s * 0.6, s }
			end
		end
		local puffs = {}
		for i = 1, 6 do
			local a = (i - 1) / 6 * math.pi * 2 + rng:Float(-0.3, 0.3)
			local s = rng:Float(7, 11)
			puffs[#puffs + 1] = { math.cos(a) * (R - 6), -7, math.sin(a) * (R - 6), s, s * 0.7, s }
		end
		local shopCloud = VX.CloudModel({
			V = 3,
			Tiers = { { R = R + 3, H = 1 }, { R = R - 3, H = 2 }, { R = R - 11, H = 2 }, { R = R - 19, H = 2 } },
			Puffs = puffs,
			Rim = rim,
			Carve = function(x, y, z)
				return y > 0 and (x * x + z * z) < (R - 4) * (R - 4)
			end,
			Seed = 5,
			MaxParts = 84,
		}, CFrame.new(S.X, TOP - 1.2, S.Z), f, "ShopCloud", true)
		if shopCloud then
			Mesh.tag(shopCloud, "cloud_shop", CFrame.new(S.X, TOP - 1.2, S.Z)) -- Phase 6 (LayoutSig)
		end
	end)
	if not okBody then
		warn("[LobbyBuilder] shop cloud failed: " .. tostring(errBody))
	end
	local neckA = polar(L.ShopAngle, PLAZA_R - 4, TOP)
	local neckB = polar(L.ShopAngle, L.ShopDist - R + 5, TOP)
	local neckMid = (neckA + neckB) * 0.5
	box(f, "ShopNeck", flatLook(neckMid, neckB) * CFrame.new(0, -0.2 - 0.6, 0), Vector3.new(G.BoardHalf * 2 - 0.3, 1.2, (neckB - neckA).Magnitude), C.Stone, { Collide = true })
	place(Props.Puff("S"), CFrame.new(neckMid - Vector3.new(0, 1.4, 0)), f, "NeckPuff")

	-- Roulette machines on an arc across the back, cheapest on the left as the customer walks in.
	local roulettes = {}
	local count = #Config.Roulettes
	local arcR = 19
	local stepDeg = math.deg(2 * math.asin(math.min(1, (MACHINE_CARD_W + 1) / (2 * arcR))))
	if count > 1 then
		stepDeg = math.min(stepDeg, 150 / (count - 1))
	end
	for i, roulette in ipairs(Config.Roulettes) do
		local phi = math.rad((i - (count + 1) / 2) * stepDeg)
		local pos = at(-math.sin(phi) * arcR, math.cos(phi) * arcR)
		local cf = flatLook(pos, S)
		local ok, result = pcall(buildMachine, f, cf, roulette)
		if not ok then
			warn("[LobbyBuilder] roulette machine " .. tostring(roulette.Id) .. " failed: " .. tostring(result))
			result = fallbackMachine(f, cf, roulette)
		end
		roulettes[roulette.Id] = result
	end

	-- Item stall (left of the entrance) and rarity board (right), both facing the centre.
	local stallPos = at(-21, -8) - Vector3.new(0, LAWN, 0) -- on the lawn layer
	local stallCF = flatLook(stallPos, S - Vector3.new(0, LAWN, 0))
	local okStall, stall = pcall(buildItemStall, f, stallCF)
	if not okStall then
		warn("[LobbyBuilder] item stall failed: " .. tostring(stall))
		stall = fallbackItemStall(f, stallCF)
	end
	local okBoard, errBoard = pcall(buildRarityBoard, f, flatLook(at(21, -8) - Vector3.new(0, LAWN, 0), S - Vector3.new(0, LAWN, 0)))
	if not okBoard then
		warn("[LobbyBuilder] rarity board failed: " .. tostring(errBoard))
	end

	-- Decor: token statue, entrance arch with the shop sign, lamps, bunting, flower beds, fireflies.
	local okDecor, errDecor = pcall(function()
		buildTokenStatue(f, S)
		local archCF = shopCF * CFrame.new(0, 0, -(R - 5)) * CFrame.Angles(0, math.pi, 0)
		local arch = newModel(f, "ShopArch")
		for _, s in ipairs({ -1, 1 }) do
			box(arch, "Pillar", archCF * CFrame.new(s * 7.6, 0.35, 0), Vector3.new(2.6, 1.7, 2.6), C.StoneDark, { Collide = true })
			box(arch, "Pillar", archCF * CFrame.new(s * 7.6, 5.6, 0), Vector3.new(1.8, 8.8, 1.8), C.StoneLight, { Collide = true })
			box(arch, "PillarCap", archCF * CFrame.new(s * 7.6, 10.3, 0), Vector3.new(2.6, 0.8, 2.6), C.Rose)
			box(arch, "PillarLamp", archCF * CFrame.new(s * 7.6, 11.2, 0), Vector3.new(1, 1, 1), C.Lamp, { Material = MAT.Neon })
		end
		box(arch, "Beam", archCF * CFrame.new(0, 10.3, 0), Vector3.new(13, 0.6, 1.2), C.PlankDark)
		local sign = box(arch, "ShopSign", archCF * CFrame.new(0, 12.38, 0), Vector3.new(12.4, 3.6, 0.8), C.Navy, { Shadow = true })
		box(arch, "SignRoof", archCF * CFrame.new(0, 14.46, 0), Vector3.new(14, 0.6, 1.8), C.Rose)
		Mesh.tag(arch, "prop_shop_arch", archCF, nil, { "ShopSign" }) -- Phase 6: the sign board stays (SurfaceGuis)
		-- 620 x 180 px canvas: the name 1.6 studs tall, the caption 0.68 stud
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local gui = surfaceGui(sign, face)
			local panel = signPanel(gui, C.TextGold)
			signText(panel, "CLOUD SHOP", "Title", 80, C.Gold, "Name", 0.03, 0.05, 0.94, 0.56)
			signText(panel, "pets & items", "Body", 34, C.Text, "Sub", 0.04, 0.62, 0.92, 0.3)
			gui.Parent = sign
		end
		local lampTpl = Props.Lamp()
		local lampTops = {}
		for i, p in ipairs({ { -9, -13 }, { 9, -13 }, { -25, 6 }, { 25, 6 } }) do
			local base = at(p[1], p[2]) - Vector3.new(0, (i > 2) and LAWN or 0, 0) -- the outer pair stands on the lawn
			local lamp = place(lampTpl, CFrame.new(base), f, "ShopLamp")
			local glass = lamp and lamp:FindFirstChild("LampGlass")
			if glass and i <= 2 then
				pointLight(glass, C.Lamp, 0.8, 16)
			end
			lampTops[i] = base + Vector3.new(0, 7.4, 0)
		end
		bunting(f, lampTops[1], lampTops[2], { C.Rose, C.Cream, C.Gold, rgb(120, 190, 235) }, 1.2)
		local down = Vector3.new(0, LAWN, 0)
		place(Props.FlowerBed(2), flatLook(at(-11.5, -19) - down, S - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
		place(Props.FlowerBed(4), flatLook(at(11.5, -19) - down, S - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
		local flies = anchorPart(f, "Fireflies", S + Vector3.new(0, 5, 0), Vector3.new(R * 1.5, 8, R * 1.5))
		emitter(flies, {
			Color = ColorSequence.new(rgb(255, 236, 150), rgb(190, 240, 170)),
			Rate = 5,
			Lifetime = NumberRange.new(5, 8),
			Speed = NumberRange.new(0.3, 1),
			SpreadAngle = Vector2.new(180, 180),
			Size = popSize(0.45),
		})
	end)
	if not okDecor then
		warn("[LobbyBuilder] shop decor failed: " .. tostring(errDecor))
	end
	return { Roulettes = roulettes, ItemShop = stall }
end

-- Last-resort shop: plain machines and a counter with their PromptParts, so pets and items stay purchasable.
local function fallbackShop(root, L)
	local f = newFolder(root, "ShopFallback")
	local S = L.ShopCenter
	box(f, "ShopTop", CFrame.new(S - Vector3.new(0, 1, 0)), Vector3.new(L.ShopR * 2, 2, L.ShopR * 2), C.Cloud, { Collide = true })
	local neckA = polar(L.ShopAngle, PLAZA_R - 4, TOP)
	local neckB = polar(L.ShopAngle, L.ShopDist - L.ShopR + 5, TOP)
	local mid = (neckA + neckB) * 0.5
	box(f, "ShopNeck", flatLook(mid, neckB) * CFrame.new(0, -0.8, 0), Vector3.new(14, 1.2, (neckB - neckA).Magnitude), C.Stone, { Collide = true })
	local roulettes = {}
	local count = #Config.Roulettes
	for i, roulette in ipairs(Config.Roulettes) do
		local pos = S + Vector3.new((i - (count + 1) / 2) * 12, 0, -12)
		roulettes[roulette.Id] = fallbackMachine(f, flatLook(pos, S), roulette)
	end
	local stallPos = S + Vector3.new(0, 0, 12)
	local stall = fallbackItemStall(f, flatLook(stallPos, S))
	return { Roulettes = roulettes, ItemShop = stall }
end

----------------------------------------------------------------------
-- Home plots (one per spot) and the ring street
----------------------------------------------------------------------

-- Local positions inside a plot (studs; origin = yard centre on the ground, -Z = gate / street side).
local PLOT_POS = {
	Gate = -G.PlotHalf,
	Mailbox = Vector3.new(-11, 0, -G.PlotHalf - 2),
	Podium = Vector3.new(G.PlotHalf - 12, 0, -G.PlotHalf + 10),
	Spawn = Vector3.new(0, 3, -12),
}

-- Everything every plot shares, built once in plot-local space and cloned per plot.
local function plotTemplate()
	return template("Plot", function()
		local m = Instance.new("Model")
		m.Name = "Plot"
		local half = G.PlotHalf
		local ix = G.IslandHalfX
		local front, back = G.IslandFront, G.IslandBack
		local depth = back - front
		local midZ = (back + front) / 2

		-- cloud island body (top 1.2 under the lawn): a puffy cushion, not a slab. Two flat tiers carry the lawn;
		-- overlapping billows bulge out along both sides and the back (a scalloped outline from above, round
		-- bumps from the side), a hanging cumulus of big lumps rounds the underside off, and a soft rim of
		-- small puffs rises from the outer margins (outside the fence; the yard, verge and street stay clear).
		local rng = Util.NewRng(SEED + 77)
		local puffs, rim = {}, {}
		local sideZ0, sideZ1 = front + 12, back - 8
		for _, sx in ipairs({ -1, 1 }) do
			for i = 0, 3 do
				local z = sideZ0 + i * (sideZ1 - sideZ0) / 3 + rng:Float(-3, 3)
				puffs[#puffs + 1] = { sx * (ix + rng:Float(1, 3)), rng:Float(-5, -3.5), z, rng:Float(8, 10), rng:Float(5.5, 7), rng:Float(10, 12.5) }
			end
			rim[#rim + 1] = { sx * (ix - 1), 0, rng:Float(-12, -4), 6, 4, 8 }
		end
		for i = 0, 2 do
			local x = -ix + 12 + i * (2 * ix - 24) / 2 + rng:Float(-3, 3)
			puffs[#puffs + 1] = { x, rng:Float(-5, -3.5), back + rng:Float(1, 3), rng:Float(12, 14), rng:Float(5.5, 7), rng:Float(8, 10) }
		end
		rim[#rim + 1] = { -ix + 2, 0, back - 1, 10, 6.5, 10 }
		rim[#rim + 1] = { ix - 2, 0, back - 1, 10, 6.5, 10 }
		-- the hanging underside (studs below the top of the cloud)
		local hang = {
			{ 0, -10, midZ, ix * 0.95, 7.5, depth * 0.48 },
			{ ix * 0.1, -15, midZ, 20, 6.5, 22 },
		}
		for _, h in ipairs(hang) do
			puffs[#puffs + 1] = h
		end
		-- 6-stud voxels: the island is cloned 16 times, so its body must stay cheap (~56 parts)
		VX.CloudModel({
			V = 6,
			Tiers = {
				{ SX = ix * 2 + 4, SZ = depth + 4, Z = midZ, Round = 10, H = 1 },
			},
			Puffs = puffs,
			Rim = rim,
			-- nothing may rise above the yard, the verge or the street
			Carve = function(x, y, z)
				return y > 0 and ((math.abs(x) < G.PlotHalf + 1.5 and z < G.PlotHalf + 1.5 and z > -G.PlotHalf - G.Verge - 1) or (z <= -G.PlotHalf - G.Verge - 1 and z > front - 3 and math.abs(x) < ix + 6))
			end,
			MaxParts = 80,
			Seed = 9,
		}, CFrame.new(0, -1.2, 0), m, "Island", true)

		-- mowed lawn stripes in the yard + darker margins and verge (all flush at the walking height)
		local stripeW = PLOT / 6
		for i = 1, 6 do
			local z = -half + (i - 0.5) * stripeW
			box(m, "Yard", CFrame.new(0, -0.5, z), Vector3.new(PLOT, 1, stripeW), (i % 2 == 0) and C.GrassLight or C.Grass, { Collide = true, Shadow = false })
		end
		local verge = G.Verge
		box(m, "Margin", CFrame.new(-(half + ix) / 2, -0.5, (back + (-half - verge)) / 2), Vector3.new(ix - half, 1, back + half + verge), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Margin", CFrame.new((half + ix) / 2, -0.5, (back + (-half - verge)) / 2), Vector3.new(ix - half, 1, back + half + verge), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Margin", CFrame.new(0, -0.5, (back + half) / 2), Vector3.new(PLOT, 1, back - half), C.GrassDark, { Collide = true, Shadow = false })
		box(m, "Verge", CFrame.new(0, -0.5, -half - verge / 2), Vector3.new(PLOT, 1, verge), C.GrassDark, { Collide = true, Shadow = false })
		-- stepping stones from the gate into the yard
		for i, z in ipairs({ -half + 2.5, -half + 6.5, -half + 10.5 }) do
			box(m, "SteppingStone", CFrame.new((i % 2 == 0) and 0.6 or -0.4, 0.05, z), Vector3.new(4, 0.1, 2.6), C.StoneLight, { Collide = true, Shadow = false })
		end

		-- the street in front: stone slabs in two shades with darker curbs
		local sw = G.StreetW
		local slabs = 4
		local slabLen = (ix * 2) / slabs
		for i = 1, slabs do
			local x = -ix + (i - 0.5) * slabLen
			box(m, "Street", CFrame.new(x, -0.5, G.StreetZ), Vector3.new(slabLen, 1, sw - 3), (i % 2 == 0) and C.StoneLight or C.Stone, { Collide = true, Shadow = false })
		end
		for _, s in ipairs({ -1, 1 }) do
			box(m, "Curb", CFrame.new(0, -0.5, G.StreetZ + s * (sw / 2 - 0.75)), Vector3.new(ix * 2, 1, 1.5), C.StoneDark, { Collide = true, Shadow = false })
		end
		-- low hedge along the plaza side of the street (keeps walkers from stepping off the island)
		box(m, "Hedge", CFrame.new(0, 0.9, front - 0.9), Vector3.new(ix * 2, 1.8, 1.8), C.Hedge, { Collide = true })
		box(m, "HedgeTop", CFrame.new(0, 1.9, front - 0.9), Vector3.new(ix * 2 - 1, 0.4, 1.3), C.HedgeLight)

		-- fence posts + rails around the yard, open at the gate
		local postSpots = {}
		for _, x in ipairs({ -half, -half / 3, half / 3, half }) do
			postSpots[#postSpots + 1] = { x, half }
		end
		for _, z in ipairs({ -half / 3, half / 3 }) do
			postSpots[#postSpots + 1] = { -half, z }
			postSpots[#postSpots + 1] = { half, z }
		end
		postSpots[#postSpots + 1] = { -half, -half }
		postSpots[#postSpots + 1] = { half, -half }
		for _, p in ipairs(postSpots) do
			box(m, "FencePost", CFrame.new(p[1], 1.5, p[2]), Vector3.new(1, 3, 1), C.PlankDark, { Collide = true })
		end
		for _, y in ipairs({ 2.3 }) do
			box(m, "FenceRail", CFrame.new(0, y, half), Vector3.new(PLOT, 0.35, 0.35), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(-half, y, 0), Vector3.new(0.35, 0.35, PLOT), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(half, y, 0), Vector3.new(0.35, 0.35, PLOT), C.Plank, { Collide = true })
			local seg = half - 8
			box(m, "FenceRail", CFrame.new(-half + seg / 2, y, -half), Vector3.new(seg, 0.35, 0.35), C.Plank, { Collide = true })
			box(m, "FenceRail", CFrame.new(half - seg / 2, y, -half), Vector3.new(seg, 0.35, 0.35), C.Plank, { Collide = true })
		end

		-- the gate: stone pillars with lanterns, a beam across
		for _, s in ipairs({ -1, 1 }) do
			box(m, "GateBase", CFrame.new(s * 7.2, 0.5, -half), Vector3.new(2.6, 1, 2.6), C.StoneDark, { Collide = true })
			box(m, "GatePillar", CFrame.new(s * 7.2, 4, -half), Vector3.new(2, 6, 2), C.StoneLight, { Collide = true })
			box(m, "GateCap", CFrame.new(s * 7.2, 7.3, -half), Vector3.new(2.6, 0.6, 2.6), C.Stone)
			box(m, "GateLantern", CFrame.new(s * 7.2, 8.1, -half), Vector3.new(1, 1, 1), C.Lamp, { Material = MAT.Neon })
		end
		box(m, "GateBeam", CFrame.new(0, 6.6, -half), Vector3.new(13.4, 0.8, 1), C.PlankDark)

		-- mailbox (the nameplate floats above it); the gate lanterns light the street
		local mb = PLOT_POS.Mailbox
		box(m, "MailPost", CFrame.new(mb.X, 1.5, mb.Z), Vector3.new(0.5, 3, 0.5), C.PlankDark, { Collide = true })
		box(m, "MailBox", CFrame.new(mb.X, 3.4, mb.Z), Vector3.new(1.4, 1.2, 2.2), C.IronLight)

		-- pet podium: stepped stone with a band in the plot accent (recoloured per plot)
		local pod = Instance.new("Model")
		pod.Name = "Podium"
		local pp = PLOT_POS.Podium
		box(pod, "PodiumBase", CFrame.new(pp + Vector3.new(0, 0.5, 0)), Vector3.new(6, 1, 6), C.StoneDark, { Collide = true })
		box(pod, "Accent", CFrame.new(pp + Vector3.new(0, 1.5, 0)), Vector3.new(4.4, 1, 4.4), C.Rose, { Collide = true })
		box(pod, "PodiumTop", CFrame.new(pp + Vector3.new(0, 2.5, 0)), Vector3.new(5.2, 1, 5.2), C.StoneLight, { Collide = true })
		pod.Parent = m
		return m
	end)
end

-- "No. 7" on both faces of the plot's gate sign: 220 x 90 px, the number 1.12 studs tall, gold on navy.
local function numberSign(sign, index, accent)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = surfaceGui(sign, face)
		local plate = plainFrame(gui, "Plate", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0,
		})
		vgradient(plate, C.Violet, C.Navy)
		rounded(plate, 10)
		outline(plate, accent:Lerp(C.TextGold, 0.5), 4)
		signText(plate, "No. " .. tostring(index), "Title", SIGN_TITLE, C.TextGold, "Number", 0.03, 0.04, 0.94, 0.92)
		gui.Parent = sign
	end
end

-- Home nameplate over the mailbox (World text rule): a compact pixel tag, readable from ~80 studs. Left: a round
-- avatar disc with the plot number badge; right: the name (big, outlined) and an info line. The disc holds
--   Headshot    ImageLabel: SpotService loads the owner's headshot into it (Players:GetUserThumbnailAsync)
--   Silhouette  the fallback built from frames (head + shoulders) while no headshot is available
--   FreeIcon    a "+" shown while the home is free
-- and the attributes OwnedColor / FreeColor (disc colour per state, read by SpotService).
-- Returns gui, nameLabel, subLabel.
local AVATAR_PX = 60

local function avatarDisc(parent, index, accent)
	local holder = plainFrame(parent, "AvatarHolder", { Size = UDim2.fromOffset(AVATAR_PX + 8, AVATAR_PX + 8), LayoutOrder = 1 })
	local freeColor = (Theme.Buttons and Theme.Buttons.Green) or rgb(96, 196, 108)
	local ownedColor = accent:Lerp(C.Cloud, 0.45)
	local disc = plainFrame(holder, "Avatar", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(AVATAR_PX, AVATAR_PX),
		BackgroundColor3 = freeColor,
		BackgroundTransparency = 0,
	})
	disc:SetAttribute("OwnedColor", ownedColor)
	disc:SetAttribute("FreeColor", freeColor)
	rounded(disc, UDim.new(0.5, 0))
	outline(disc, INK, 3)

	-- fallback avatar: head + shoulders in a deeper shade of the plot colour (fits inside the circle)
	local shade = Theme.Darken and Theme.Darken(accent, 0.38) or accent:Lerp(C.Navy, 0.38)
	local silhouette = plainFrame(disc, "Silhouette", { Size = UDim2.fromScale(1, 1), Visible = false })
	local head = plainFrame(silhouette, "Head", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(23, 23),
		BackgroundColor3 = shade,
		BackgroundTransparency = 0,
	})
	rounded(head, UDim.new(0.5, 0))
	local body = plainFrame(silhouette, "Shoulders", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 35),
		Size = UDim2.fromOffset(36, 19),
		BackgroundColor3 = shade,
		BackgroundTransparency = 0,
	})
	rounded(body, 10)

	-- free home: a chunky "+"
	local plus = plainFrame(disc, "FreeIcon", { Size = UDim2.fromScale(1, 1) })
	for _, size in ipairs({ Vector2.new(30, 9), Vector2.new(9, 30) }) do
		local bar = plainFrame(plus, "Bar", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size.X, size.Y),
			BackgroundColor3 = C.Text,
			BackgroundTransparency = 0,
		})
		rounded(bar, 4)
	end

	local shot = Instance.new("ImageLabel")
	shot.Name = "Headshot"
	shot.AnchorPoint = Vector2.new(0.5, 0.5)
	shot.Position = UDim2.fromScale(0.5, 0.5)
	shot.Size = UDim2.new(1, -4, 1, -4)
	shot.BackgroundTransparency = 1
	shot.BorderSizePixel = 0
	shot.Image = ""
	shot.ScaleType = Enum.ScaleType.Crop
	shot.Visible = false
	rounded(shot, UDim.new(0.5, 0))
	shot.Parent = disc

	-- plot number badge on the disc's lower-left edge
	local badge = plainFrame(holder, "NumberBadge", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 10, 1, -9),
		Size = UDim2.fromOffset(26, TAG_SMALL + 6),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = 0,
		ZIndex = 3,
	})
	rounded(badge, 10)
	outline(badge, INK, 2.5)
	padding(badge, 1, 6, 2)
	local number = tagText(badge, "Number", "#" .. tostring(index), "Display", TAG_SMALL, C.Text, 1, 2)
	number.ZIndex = 4
	return holder
end

local function homeNameplate(anchor, index, accent)
	-- bottom edge 7.2 studs up: a few studs over the mailbox, under the gate lanterns' glow
	local gui = newTag(anchor, "Nameplate", 460, 110, -2.4, 100)
	local plate = tagPlate(gui, accent, 230, Enum.FillDirection.Horizontal, 12)
	local pad = plate:FindFirstChildOfClass("UIPadding")
	if pad then -- the avatar disc hugs the left edge
		pad.PaddingLeft = UDim.new(0, 6)
		pad.PaddingRight = UDim.new(0, 18)
		pad.PaddingTop = UDim.new(0, 5)
		pad.PaddingBottom = UDim.new(0, 5)
	end
	avatarDisc(plate, index, accent)
	local texts = plainFrame(plate, "Texts", { AutomaticSize = Enum.AutomaticSize.XY, LayoutOrder = 2 })
	listLayout(texts, Enum.FillDirection.Vertical, 0, Enum.HorizontalAlignment.Left)
	local nameLabel = tagText(texts, "NameLabel", "Free home", "Title", TAG_NAME, C.Text, 1)
	local subLabel = tagText(texts, "SubLabel", "Step in to claim", "Body", TAG_INFO, C.TextGold, 2, 2)
	return gui, nameLabel, subLabel
end

local function buildSpot(parent, index, angle)
	local accent = ACCENTS[(index - 1) % #ACCENTS + 1]
	local f = newFolder(parent, string.format("Spot_%02d", index))
	f:SetAttribute("SpotIndex", index)
	local centre = polar(angle, SPOT_R, TOP)
	local plotCF = faceCentre(centre) -- LookVector = towards the gate / street / plaza
	local function at(v)
		return plotCF * CFrame.new(v)
	end

	local plot = place(plotTemplate(), plotCF, f, "Plot")
	if plot then
		-- the podium trim takes the plot accent
		local podium = plot:FindFirstChild("Podium")
		if podium then
			for _, d in ipairs(podium:GetChildren()) do
				if d:IsA("BasePart") and d.Name == "Accent" then
					d.Color = accent
				end
			end
		end
	else
		-- plain stand-in (template failed): a lawn slab so the spot stays usable
		box(f, "Yard", plotCF * CFrame.new(0, -0.5, -9), Vector3.new(PLOT + 12, 1, PLOT + 30), C.Grass, { Collide = true })
	end

	-- per-plot accents: banner pennants on the gate beam, mailbox flag, number sign
	for _, s in ipairs({ -1, 1 }) do
		box(f, "GateBanner", at(Vector3.new(s * 5.4, 5.4, PLOT_POS.Gate - 0.6)), Vector3.new(1.6, 2, 0.15), accent, { Shadow = false })
	end
	local mb = PLOT_POS.Mailbox
	box(f, "MailFlag", at(Vector3.new(mb.X + 0.77, 4.2, mb.Z + 0.4)), Vector3.new(0.15, 1, 0.8), accent, { Shadow = false })
	local sign = box(f, "NumberSign", at(Vector3.new(0, 7.9, PLOT_POS.Gate)), Vector3.new(4.4, 1.8, 0.5), C.Plank)
	numberSign(sign, index, accent)

	-- nameplate over the mailbox
	local anchor = anchorPart(f, "NameplateAnchor", at(Vector3.new(mb.X, 9.6, mb.Z)).Position)
	local gui, nameLabel, subLabel = homeNameplate(anchor, index, accent)

	local podiumTop = at(PLOT_POS.Podium + Vector3.new(0, 3, 0)).Position
	local spawnPos = at(PLOT_POS.Spawn).Position
	return {
		Index = index,
		Folder = f,
		Center = centre,
		SpawnCFrame = flatLook(spawnPos, centre + Vector3.new(0, 3, 0) + plotCF.LookVector * -30),
		NameLabel = nameLabel,
		SubLabel = subLabel,
		Nameplate = gui,
		PodiumCFrame = flatLook(podiumTop, podiumTop + plotCF.LookVector),
		PlotCFrame = plotCF,
		PlotSize = PLOT,
		GateCFrame = at(Vector3.new(0, 0, PLOT_POS.Gate)),
		Accent = accent,
	}
end

-- Bare-minimum spot (see fallbackPortal): a lawn slab, a podium and the two labels.
local function fallbackSpot(parent, index, angle)
	local old = parent:FindFirstChild(string.format("Spot_%02d", index))
	if old then
		old:Destroy()
	end
	local f = newFolder(parent, string.format("Spot_%02d", index))
	f:SetAttribute("SpotIndex", index)
	local centre = polar(angle, SPOT_R, TOP)
	local plotCF = faceCentre(centre)
	box(f, "Yard", plotCF * CFrame.new(0, -0.5, -9), Vector3.new(PLOT + 12, 1, PLOT + 30), C.Grass, { Collide = true })
	box(f, "PodiumBase", plotCF * CFrame.new(PLOT_POS.Podium + Vector3.new(0, 1.5, 0)), Vector3.new(5, 3, 5), C.Stone, { Collide = true })
	local anchor = anchorPart(f, "NameplateAnchor", (plotCF * CFrame.new(PLOT_POS.Mailbox + Vector3.new(0, 9.6, 0))).Position)
	local gui, nameLabel, subLabel = homeNameplate(anchor, index, C.TextGold)
	local podiumTop = (plotCF * CFrame.new(PLOT_POS.Podium + Vector3.new(0, 3, 0))).Position
	local spawnPos = (plotCF * CFrame.new(PLOT_POS.Spawn)).Position
	return {
		Index = index,
		Folder = f,
		Center = centre,
		SpawnCFrame = flatLook(spawnPos, centre + Vector3.new(0, 3, 0) + plotCF.LookVector * -30),
		NameLabel = nameLabel,
		SubLabel = subLabel,
		Nameplate = gui,
		PodiumCFrame = flatLook(podiumTop, podiumTop + plotCF.LookVector),
		PlotCFrame = plotCF,
		PlotSize = PLOT,
		GateCFrame = plotCF * CFrame.new(0, 0, PLOT_POS.Gate),
		Accent = C.TextGold,
	}
end

-- Rope rail with end posts along a straight edge (a, b = ground points).
local function rail(parent, a, b, height)
	height = height or 2.8
	local m = newModel(parent, "Rail")
	local dir = b - a
	local len = dir.Magnitude
	if len < 1 then
		return m
	end
	local posts = math.max(2, math.floor(len / 30) + 1)
	for i = 0, posts - 1 do
		local p = a + dir * (i / (posts - 1))
		box(m, "RailPost", CFrame.new(p + Vector3.new(0, height / 2, 0)), Vector3.new(0.6, height, 0.6), C.PlankDark, { Collide = true })
	end
	local mid = (a + b) * 0.5 + Vector3.new(0, height - 0.4, 0)
	box(m, "RailRope", CFrame.lookAt(mid, mid + dir), Vector3.new(0.3, 0.3, len), C.Plank, { Collide = true, Shadow = false })
	return m
end

-- A wooden bridge between two ground points (deck top `topOffset` below TOP): longitudinal planks, edge
-- beams, rope rails on both sides (open ends) and optional cloud puffs underneath.
local function woodBridge(parent, name, a, b, width, opts)
	opts = opts or {}
	local m = newModel(parent, name)
	local topY = TOP + (opts.Top or -0.2)
	a = Vector3.new(a.X, topY, a.Z)
	b = Vector3.new(b.X, topY, b.Z)
	local dir = b - a
	local len = dir.Magnitude
	local cf = CFrame.lookAt((a + b) * 0.5, b)
	local planks = math.max(3, math.floor(width / 2 + 0.5))
	local pw = width / planks
	for i = 1, planks do
		local x = -width / 2 + (i - 0.5) * pw
		box(m, "Plank", cf * CFrame.new(x, -0.5, 0), Vector3.new(pw, 1, len), (i % 2 == 0) and C.PlankLight or C.Plank, { Collide = true, Shadow = len > 8 })
	end
	if opts.Rails ~= false then
		local insetA = opts.RailInsetA or opts.RailInset or 3
		local insetB = opts.RailInsetB or opts.RailInset or 3
		local right = cf.RightVector
		for _, s in ipairs({ -1, 1 }) do
			if not (opts.NoRail and opts.NoRail[s]) then
				local off = right * (s * (width / 2 - 0.3))
				local p0 = a + dir.Unit * insetA + off
				local p1 = b - dir.Unit * insetB + off
				rail(m, Vector3.new(p0.X, topY, p0.Z), Vector3.new(p1.X, topY, p1.Z))
			end
		end
	end
	for _, t in ipairs(opts.Puffs or {}) do
		-- the puff's highest voxels reach 3 studs over its anchor: anchored 4 under the deck top, it touches the
		-- underside of the 1-stud planks and nothing pokes through
		place(Props.Puff(opts.PuffSize or "M"), CFrame.new(a + dir * t - Vector3.new(0, 4, 0)) * CFrame.Angles(0, t * 7, 0), m, "BridgePuff")
	end
	if opts.MeshKey then -- Phase 6 (LayoutSig); the puff under it is dressed on its own (its parts are kept)
		Mesh.tag(m, opts.MeshKey, cf, nil, Mesh.CloudParts)
	end
	return m
end

-- Ring street junctions (plank bridges between neighbouring plots), spoke bridges and garden bridges.
local function buildRoads(root, L)
	local f = newFolder(root, "Roads")
	local ext = G.JunctionX + G.StreetExt
	local ix = G.IslandHalfX
	local sw = G.StreetW
	for j, info in ipairs(L.Junctions) do
		local a = info.Angle
		local open = info.Spoke or info.Garden or info.Altar -- something docks on the plaza side here
		local jf = newModel(f, string.format("Junction_%02d", j))
		-- half A belongs to the plot before the junction (its local -X side), half B to the plot after it
		for half = 1, 2 do
			local plotAngle = (half == 1) and (a - G.HalfStep) or (a + G.HalfStep)
			local plotCF = faceCentre(polar(plotAngle, SPOT_R, TOP))
			local s = (half == 1) and -1 or 1
			local lift = (half == 1) and 0 or -0.1 -- the halves overlap at the junction: never coplanar
			local x0, x1 = s * ix, s * ext
			local len = math.abs(x1 - x0)
			local count = math.max(2, math.floor(len / 4 + 0.5))
			local pw = len / count
			for i = 1, count do
				local x = x0 + s * (i - 0.5) * pw
				box(jf, "Plank", plotCF * CFrame.new(x, -0.5 + lift, G.StreetZ), Vector3.new(pw, 1, sw), (i % 2 == 0) and C.PlankLight or C.Plank, { Collide = true, Shadow = false })
			end
		end
		-- one straight rail per side across both halves: outer always, inner unless a bridge docks here
		local plotA = faceCentre(polar(a - G.HalfStep, SPOT_R, TOP))
		local plotB = faceCentre(polar(a + G.HalfStep, SPOT_R, TOP))
		local sides = { G.StreetZ + sw / 2 - 0.9 }
		if not open then
			sides[2] = G.StreetZ - sw / 2 + 0.9
		end
		for k, z in ipairs(sides) do
			local pA = (plotA * CFrame.new(-ix - 0.8, 0, z)).Position
			local pB = (plotB * CFrame.new(ix + 0.8, 0, z)).Position
			if k == 1 and info.Arena then
				-- Phase 3: the outer rail opens around the junction's ray for the arena bridge (ArenaBuilder)
				local mid = (pA + pB) * 0.5
				local u = Vector3.new(pB.X - pA.X, 0, pB.Z - pA.Z).Unit
				local keep = G.ArenaBridgeW / 2 + 0.8
				local q0, q1 = mid - u * keep, mid + u * keep
				rail(jf, Vector3.new(pA.X, TOP, pA.Z), Vector3.new(q0.X, TOP, q0.Z))
				rail(jf, Vector3.new(q1.X, TOP, q1.Z), Vector3.new(pB.X, TOP, pB.Z))
			else
				rail(jf, Vector3.new(pA.X, TOP, pA.Z), Vector3.new(pB.X, TOP, pB.Z))
			end
		end
		if open then
			-- short inner rails on both sides of the docking bridge
			local zIn = G.StreetZ - sw / 2 + 0.9
			local dock = polar(a, G.StreetR / math.cos(math.rad(G.HalfStep)) - sw / 2, TOP)
			-- (the Storm Altar's bridge docks with a 14-stud entrance gate whose low walls close the gap)
			local keep = info.Altar and 7.6 or (((info.Spoke and G.SpokeW) or 8) / 2 + 0.8)
			for _, p in ipairs({ (plotA * CFrame.new(-ix - 0.8, 0, zIn)).Position, (plotB * CFrame.new(ix + 0.8, 0, zIn)).Position }) do
				local d = Vector3.new(dock.X - p.X, 0, dock.Z - p.Z)
				local len = d.Magnitude - keep
				if len > 1.5 then
					local q = p + d.Unit * len
					rail(jf, Vector3.new(p.X, TOP, p.Z), Vector3.new(q.X, TOP, q.Z))
				end
			end
		end
		-- Phase 6: one plank-deck mesh per junction kind (identical local geometry; LayoutSig)
		local kind = (info.Arena and "arena") or (info.Altar and "altar") or (info.Spoke and "spoke") or (info.Garden and "garden") or "plain"
		Mesh.tag(jf, "floor_junction_" .. kind, faceCentre(polar(a, G.StreetR, TOP)))
	end

	-- Spokes: plaza rim -> junction, over open sky, carried by cloud puffs.
	for _, a in ipairs(L.SpokeAngles) do
		local p0 = polar(a, PLAZA_R - 3, TOP)
		local p1 = polar(a, G.SpokeEndR, TOP)
		-- rails run from the plaza's cloud rim right up to the street edge (no open window over the sky)
		woodBridge(f, "Spoke", p0, p1, G.SpokeW, { Puffs = { 0.52 }, PuffSize = "S", RailInsetA = 6, RailInsetB = 2.6, MeshKey = "floor_spoke" })
	end
end

----------------------------------------------------------------------
-- Garden islands (hanging off the street) and the reserved Storm Altar site
----------------------------------------------------------------------

-- Five stacked ground layers around `centre` (2-stud cells). fn(x, z, r) -> l1, l2, l3, l4 (see plazaCell).
local function layeredGround(parent, centre, radius, fn, meshPrefix)
	local cell = 2
	local n = math.ceil(radius / cell)
	local grids = { Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1), Voxel.NewGrid(1) }
	for i = -n, n do
		for k = -n, n do
			local x, z = i * cell, k * cell
			local r = math.sqrt(x * x + z * z)
			if r <= radius - 0.5 then
				Voxel.Set(grids[1], i, 0, k, "Grass")
				local keys = { fn(x, z, r) }
				for li = 1, 4 do
					if keys[li] then
						Voxel.Set(grids[li + 1], i, 0, k, keys[li])
					end
				end
			end
		end
	end
	local tops = { -0.4, -0.3, -0.1, 0, 0.1 }
	for li = 1, 5 do
		local layer = VX.Build(grids[li], { V = cell, Name = "Ground" .. li, CF = CFrame.new(centre.X, TOP + tops[li] - cell / 2, centre.Z), Collide = true, Shadow = false, Parent = parent })
		if layer and meshPrefix then
			Mesh.tag(layer, meshPrefix .. li, CFrame.new(centre.X, TOP, centre.Z)) -- Phase 6 (LayoutSig)
		end
	end
end

local function buildPond(parent, ground)
	local g = Voxel.NewGrid(14)
	VX.Ring(g, 0, 0, 5.2, 6.9, 0, 1, "Stone")
	VX.Disc(g, 0, 0, 5.3, -1, -1, "WaterDeep")
	VX.Disc(g, 0, 0, 5.3, 0, 0, "Water")
	for _, p in ipairs({ { -2, 1 }, { 2, -2 }, { 1, 3 } }) do
		Voxel.Set(g, p[1], 0, p[2], "Leaf")
		Voxel.Set(g, p[1] + 1, 0, p[2], "Leaf")
	end
	Voxel.Set(g, 1, 1, 3, "Blossom")
	Voxel.Set(g, -2, 1, 1, "BlossomWhite")
	local water = VX.Split(g, { Water = true })
	local cf = CFrame.new(ground.X, TOP + 0.1, ground.Z)
	local stone = VX.Build(g, { V = 1, Name = "PondStone", CF = cf, Collide = true, Parent = parent })
	local pondWater = VX.Build(water, { V = 1, Name = "PondWater", CF = cf, Collide = false, Parent = parent })
	-- Phase 6: the pond ring and its water
	local ground0 = CFrame.new(ground.X, TOP, ground.Z)
	if stone then
		Mesh.tag(stone, "prop_pond", ground0)
	end
	if pondWater then
		Mesh.tag(pondWater, "prop_pond_water", ground0)
	end
	local sparkle = anchorPart(parent, "PondSparkle", ground + Vector3.new(0, 1, 0), Vector3.new(9, 1, 9))
	emitter(sparkle, { Color = ColorSequence.new(rgb(200, 236, 255)), Rate = 3, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(0.2, 0.6), Size = popSize(0.5) })
end

local function buildGarden(parent, spec, L)
	local f = newFolder(parent, "Garden_" .. (spec.Name:gsub("%s", "")))
	local a = spec.Angle
	local c = polar(a, G.GardenR, TOP)
	local R = G.GardenSize
	local out = dirOf(a)
	local rng = Util.NewRng(SEED + 40 + math.floor(a))
	local cf = flatLook(c, c + out) -- local -Z = outwards (towards the street bridge)

	local rim, puffs = {}, {}
	for i = 1, 6 do
		local deg = (i - 1) * 60 + a + 180 + rng:Float(-6, 6)
		if angleDiff(deg, a) > 30 then
			local s = rng:Float(8, 9.5)
			rim[#rim + 1] = { math.cos(math.rad(deg)) * (R + 1.5), rng:Float(-1.5, 0), math.sin(math.rad(deg)) * (R + 1.5), s, s * 0.62, s }
		end
	end
	for i = 1, 3 do
		local ang = (i - 1) / 3 * math.pi * 2 + rng:Float(-0.3, 0.3)
		local s = rng:Float(7, 9)
		puffs[#puffs + 1] = { math.cos(ang) * (R - 5), -6, math.sin(ang) * (R - 5), s, s * 0.7, s }
	end
	local gardenKind = (spec.Kind == "Pond") and "pond" or "blossom"
	local gardenCloud = VX.CloudModel({
		V = 3,
		Tiers = { { R = R + 3, H = 1 }, { R = R - 3, H = 2 }, { R = R - 10, H = 2 }, { R = R - 16, H = 1 } },
		Puffs = puffs,
		Rim = rim,
		Carve = function(x, y, z)
			return y > 0 and (x * x + z * z) < (R - 3) * (R - 3)
		end,
		MaxParts = 46,
		Seed = 20 + math.floor(a),
	}, CFrame.new(c.X, TOP - 1.2, c.Z), f, "GardenCloud", true)
	if gardenCloud then
		Mesh.tag(gardenCloud, "cloud_garden_" .. gardenKind, CFrame.new(c.X, TOP - 1.2, c.Z)) -- Phase 6 (LayoutSig)
	end

	layeredGround(f, c, R, function(x, z, r)
		local l1, l2, l3
		local nz = vnoise(x + a, z - a, 18, 17)
		if nz < 0.26 then
			l1 = "GrassDark"
		elseif nz > 0.76 then
			l1 = "GrassLight"
		end
		local ring = math.abs(r - 10)
		local t = x * out.X + z * out.Z
		local d = math.abs(-x * out.Z + z * out.X)
		-- the border reaches 2.2 studs past the sand (more than one 2-stud cell), so the sand never ends flush
		-- with it on the grid
		local onPath = t >= 9 and d <= 4.4
		if ring <= 4.4 or onPath then
			l2 = "SandDark"
		end
		if ring <= 2.2 or (t >= 9 and d <= 2.2 and r <= R - 2.5) then
			l3 = "Sand"
		end
		if r > R - 3 then
			l1 = nil -- lawn only at the very edge
		elseif not l2 and r > R - 6 and hash3(math.floor(x), 7, math.floor(z), 3) < 0.09 then
			l1 = "Flower" .. (math.floor(hash3(math.floor(x), 8, math.floor(z), 6) * #FLOWERS) + 1)
		end
		return l1, l2, l3, nil
	end, "floor_garden_" .. gardenKind .. "_")

	-- features
	local function localPos(deg, dist)
		-- deg measured from the outward direction
		return (cf * CFrame.Angles(0, math.rad(deg), 0) * CFrame.new(0, 0, -dist)).Position
	end
	local down = Vector3.new(0, LAWN, 0) -- props stand on the lawn layer
	if spec.Kind == "Pond" then
		buildPond(f, c)
		place(Props.Tree("Round"), CFrame.new(localPos(180, 16) - down) * CFrame.Angles(0, 1.3, 0), f, "RoundTree")
		place(Props.FlowerBed(6), flatLook(localPos(140, 16) - down, c - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
	else
		place(Props.Tree("Blossom"), CFrame.new(c - down) * CFrame.Angles(0, 0.7, 0), f, "BlossomTree")
		place(Props.FlowerBed(1), flatLook(localPos(180, 16) - down, c - down) * CFrame.Angles(0, math.rad(90), 0), f, "FlowerBed")
	end
	for _, deg in ipairs({ 75, -75 }) do
		local p = localPos(deg, 15.5) - down
		place(Props.Bench(), flatLook(p, c - down), f, "Bench")
	end

	-- name tag + the bridge to the street junction
	local tag = anchorPart(f, "NameTag", c + Vector3.new(0, 22, 0))
	local gui = newTag(tag, "NameTag", 320, 80, -1.7, 120)
	local plate = tagPlate(gui, rgb(150, 210, 160), 160)
	tagText(plate, "Text", spec.Name, "Title", TAG_NAME + 2, C.Text, 1)
	woodBridge(f, "GardenBridge", polar(a, G.GardenR + R - 3, TOP), polar(a, G.SpokeEndR, TOP), 8, { RailInsetA = 3, RailInsetB = 2.6, MeshKey = "floor_garden_bridge" })
	return f
end

----------------------------------------------------------------------
-- Sky: voxel cumulus around the village and one far below it (never collidable)
----------------------------------------------------------------------

-- kind: "Big" (96 studs) | "Small" (60 studs)
local function cumulus(kind)
	return template("Sky" .. kind, function()
		local r = Util.NewRng(SEED + #kind * 13)
		local w = (kind == "Big") and 96 or 60
		local rim = {}
		local n = 5
		for i = 1, n do
			local x = (i - (n + 1) / 2) / n * w * 0.9 + r:Float(-4, 4)
			local s = r:Float(0.16, 0.24) * w
			rim[#rim + 1] = { x, r:Float(0, 6), r:Float(-w * 0.12, w * 0.12), s, s * 0.8, s * 0.9 }
		end
		rim[#rim + 1] = { r:Float(-6, 6), w * 0.18, 0, w * 0.22, w * 0.2, w * 0.2 }
		local spec = {
			V = 6,
			Tiers = { { SX = w, SZ = w * 0.55, Round = w * 0.2, H = 1, Key = "Mist" } },
			Rim = rim,
			MaxParts = 32,
			Seed = #kind,
		}
		return VX.CloudModel(spec, CFrame.new(), nil, "SkyCloud", false)
	end)
end

local function buildSky(root)
	local f = newFolder(root, "Sky")
	local rng = Util.NewRng(SEED + 5)
	local count = 3
	for i = 1, count do
		local ang = (i - 1) * (360 / count) + rng:Float(-14, 14) + 20
		local dist = rng:Float(430, 620)
		local y = TOP + rng:Float(-40, 80)
		local kind = (i == 2) and "Small" or "Big"
		local pos = polar(ang, dist, y)
		place(cumulus(kind), CFrame.new(pos) * CFrame.Angles(0, math.rad(rng:Float(0, 360)), 0), f, "SkyCloud")
	end
	-- far below: one big puffy cumulus (depth under the village), not a flat sheet
	place(cumulus("Big"), CFrame.new(polar(rng:Float(40, 80), rng:Float(200, 320), TOP - rng:Float(130, 160))) * CFrame.Angles(0, math.rad(rng:Float(0, 360)), 0), f, "CloudSea")
	local dust = anchorPart(f, "SkyDust", Vector3.new(OX, TOP + 24, OZ), Vector3.new(560, 90, 560))
	emitter(dust, {
		Color = ColorSequence.new(rgb(255, 236, 200), rgb(200, 220, 255)),
		Rate = 14,
		Lifetime = NumberRange.new(8, 12),
		Speed = NumberRange.new(0.3, 1.2),
		SpreadAngle = Vector2.new(180, 180),
		Size = popSize(0.8),
	})
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

local function section(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[LobbyBuilder] section '" .. name .. "' failed: " .. tostring(err))
	end
	return ok
end

-- Six spots on the plaza lawn when the decor pass could not compute them.
local function defaultNpcSpots(L)
	local spots = {}
	local plan = { 22.5, 157.5, L.ShopAngle - 30, L.ShopAngle + 30, L.ShopAngle - 60, L.ShopAngle + 60 }
	for _, a in ipairs(plan) do
		local pos = polar(a, 58, TOP)
		spots[#spots + 1] = faceCentre(pos)
	end
	return spots
end

function LobbyBuilder.Build()
	templates = {}
	reserved = {}
	machineBoxCache = nil
	Mesh.Names = {}

	local old = Workspace:FindFirstChild("NimbusLobby")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "NimbusLobby"

	local L = computeLayout()
	if not Voxel then
		warn("[LobbyBuilder] shared/Voxel is missing: building the plain fallback lobby")
	end

	-- Gameplay-critical objects first (gates, spots, shop); each has a bare-bones fallback.
	-- The Gate Court (6.1): Obby, Altar here; Ring / Arena (ArenaBuilder) and Dungeon (DungeonBuilder) join the
	-- same folder later, at GateSites.
	local gatesFolder = newFolder(root, "Gates")
	local sites = Gates.Sites(L)
	local gates = {}
	for _, id in ipairs(Gates.Built) do
		local ok, gate = pcall(Gates.BuildOne, gatesFolder, sites[id], id)
		if not ok then
			warn("[LobbyBuilder] gate " .. id .. ": " .. tostring(gate))
			gate = { Model = nil }
		end
		if not gate.Model then
			local spec = Gates.Spec(id)
			local m, pad, prompt = Gates.Fallback(gatesFolder, sites[id], id, Gates.Info[id], gateAccent(spec.Accent))
			gate = { Model = m, Pad = pad, PromptPart = prompt, Site = sites[id] }
		end
		gates[id] = gate
	end
	local portals = {}
	local okObby, obbyInfo = pcall(Gates.ObbyPortal, gates.Obby)
	if okObby then
		portals.Obby = obbyInfo
	else
		warn("[LobbyBuilder] obby portal zone failed: " .. tostring(obbyInfo))
	end

	local spots = {}
	local spotFolder = newFolder(root, "Spots")
	for i = 1, SPOT_COUNT do
		local angle = L.PlotAngles[i]
		local ok, result = pcall(buildSpot, spotFolder, i, angle)
		if not ok then
			warn("[LobbyBuilder] spot " .. tostring(i) .. " failed: " .. tostring(result))
			result = fallbackSpot(spotFolder, i, angle)
		end
		spots[i] = result
	end

	local okShop, shop = pcall(buildShop, root, L)
	if not okShop then
		warn("[LobbyBuilder] shop failed: " .. tostring(shop))
		local broken = root:FindFirstChild("Shop")
		if broken then
			broken:Destroy()
		end
		shop = fallbackShop(root, L)
	end

	-- The plaza ground is where everyone spawns: keep a plain floor if the voxel plaza cannot be built.
	local okPlaza = section("plaza", function()
		buildPlaza(root, L)
	end)
	if not okPlaza or not root:FindFirstChild("Plaza") or not root.Plaza:FindFirstChild("Paths") then
		local floor = newFolder(root, "PlazaFallback")
		box(floor, "PlazaFloor", CFrame.new(OX, TOP - 1, OZ), Vector3.new(PLAZA_R * 1.7, 2, PLAZA_R * 1.7), C.Grass, { Collide = true })
		box(floor, "ShopNeckFloor", CFrame.new((Vector3.new(OX, TOP - 1, OZ) + L.ShopCenter - Vector3.new(0, 1, 0)) * 0.5), Vector3.new(16, 2, L.ShopDist), C.Stone, { Collide = true })
	end
	if type(L.NpcSpots) ~= "table" or #L.NpcSpots < 6 then
		L.NpcSpots = defaultNpcSpots(L)
	end

	section("roads", function()
		buildRoads(root, L)
	end)
	section("gardens", function()
		local gf = newFolder(root, "Gardens")
		for _, spec in ipairs(L.Gardens) do
			section("garden " .. spec.Name, function()
				buildGarden(gf, spec, L)
			end)
		end
	end)
	section("sky", function()
		buildSky(root)
	end)

	root.Parent = Workspace
	-- the templates and merged box lists are only needed while building
	templates = {}
	machineBoxCache = nil

	-- Spawn on the medallion in the middle of the spawn court, looking up the avenue at the Gate Court.
	local spawnPos = Vector3.new(OX, TOP + 3, OZ)
	local focus = polar(L.MidAngle, G.GateR, TOP + 3)
	local altarSite = nil
	local altarDock = nil
	if L.AltarAngle then
		altarSite = faceCentre(polar(L.AltarAngle, G.GardenR, TOP))
		altarDock = polar(L.AltarAngle, G.SpokeEndR - 2.4, TOP)
	end
	-- Phase 3: where ArenaBuilder links the Battle Arena (the outer edge of the junction on the arena spoke's ray)
	local arenaDock = nil
	if L.ArenaAngle then
		arenaDock = polar(L.ArenaAngle, (G.StreetR + G.StreetW / 2) / math.cos(math.rad(G.HalfStep)), TOP)
	end

	local parts = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") then
			parts = parts + 1
		end
	end
	print(string.format("[LobbyBuilder] lobby built (%d parts, %d gates, %d plots)", parts, #Gates.Built, #spots))

	local gateInfo = {}
	for id, g in pairs(gates) do
		gateInfo[id] = { Model = g.Model, Pad = g.Pad, PromptPart = g.PromptPart }
	end
	return {
		Folder = root,
		SpawnCFrame = flatLook(spawnPos, focus),
		Portals = portals, -- Phase 5: exactly { Obby = PortalInfo } (6.3)
		Spots = spots,
		Shop = shop,
		NpcSpots = L.NpcSpots,
		AltarSite = altarSite, -- the Storm Altar island (StormAltar.Build), faces the plaza
		AltarDock = altarDock, -- street inner edge where the bridge to the altar island docks
		-- Phase 3 (ArenaBuilder): the arena bridge leaves the street here, straight out along ArenaAngle (degrees, the
		-- spoke's ray through that junction, whose outer rail is open ArenaBridgeWidth + 1.6 studs)
		ArenaAngle = L.ArenaAngle,
		ArenaDock = arenaDock,
		ArenaBridgeWidth = G.ArenaBridgeW,
		-- Phase 5 Gate Court (6.1): ground CFrame of every gate centre (LookVector = towards the plaza centre), the
		-- folder every gate builder parents its gate to, and the lobby's own gates
		GateSites = sites,
		GatesFolder = gatesFolder,
		Gates = gateInfo,
		RingSite = sites.Ring, -- ArenaBuilder's Portal_Ring (C12)
		DungeonSite = sites.Dungeon, -- DungeonBuilder.BuildPortal (W3)
	}
end

----------------------------------------------------------------------
-- Phase 6 kit hooks (read-only; the game never calls them): blender/kit/props/lobby_world.py sets
-- LobbyBuilder._Kit = { Targets = {}, Clouds = {} } before Build() to list every mesh target (key, subtree, origin) and
-- every voxel cloud spec, then re-voxels a cloud at a finer grain with _CloudGrid. Tests use _Mesh (Signature, tag).
----------------------------------------------------------------------
LobbyBuilder._Kit = nil
LobbyBuilder._Mesh = Mesh

-- the cells of a recorded VX.Cloud spec at `V` studs per voxel (tier heights keep their stud thickness)
function LobbyBuilder._CloudGrid(spec, V)
	local V0 = spec.V or 3
	local copy = {}
	for k, v in pairs(spec) do
		copy[k] = v
	end
	copy.V = V
	copy.Tiers = {}
	for i, t in ipairs(spec.Tiers) do
		local tt = {}
		for k, v in pairs(t) do
			tt[k] = v
		end
		tt.H = math.max(1, math.floor((t.H or 1) * V0 / V + 0.5))
		copy.Tiers[i] = tt
	end
	return VX.Cloud(copy)
end

return LobbyBuilder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="852">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[-- MatchService (v2): match lifecycle + team rules for Nimbus Climb.
--
-- One match = one procedurally generated sky course in its own arena slot, a party of 1-4 players,
-- and a single worker loop (task.spawn + task.wait(0.25)) that drives the state machine:
--
--   Setup -> Countdown (frozen on the start platform) -> Playing -> Ended (results) -> cleanup
--
-- Server-authoritative: checkpoints, revives, void handling, tokens, victory/defeat/timeout.
-- Everything a match creates (course, hazard loops, token watcher, event connections, player
-- attributes) is torn down in cleanupMatch(), always in the same order, every step in a pcall so a
-- single failure can never leak a slot.
--
-- v2 additions:
--   * five difficulties (everything is looked up through Config.GetDifficulty / per-id Config tables)
--   * pet perks through deps.PetService: token pickups are multiplied by GetTokenMultiplier with a
--     per-player fractional carry (rounding stays fair over time), checkpoint heals are scaled by
--     the CheckpointHeal perk
--   * DataService.RecordMatch for every member at the end of a match, lifetime TokensEarned
--   * MatchResult.Stars
--   * courses are no longer a line toward +Z: all positions come from CourseInfo (StartCFrame,
--     Checkpoints[i].SpawnCFrame, Finish part, KillY), so spirals / zigzags / any heading work
--   * laps are stacked above each other (Spiral, overlapping lanes), so a missed jump often lands on a
--     LOWER lap long before the KillY plane. Besides the KillY plane there is a per-player fall rule:
--     a player who lands more than FALL_DROP studs below the last place they stood is treated exactly
--     like a void fall (VoidDamage + back to the team checkpoint). See landedOnLowerLap().
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local MatchService = {}
MatchService.MatchEnded = Util.Signal() -- Fire(match, won:boolean)

----------------------------------------------------------------------
-- Tunables local to this module
----------------------------------------------------------------------
local TICK = 0.25 -- worker loop period (also the void / checkpoint / finish poll rate)
local STATE_INTERVAL = 0.5 -- MatchState broadcast period while counting down / playing (2 Hz)
local START_SPREAD = 4 -- scatter radius on the start platform (platform is >= 24x24)
local CHECKPOINT_SPREAD = 3.5 -- scatter radius on a checkpoint pad (pads are >= 14x14)
local FINISH_SPREAD = 7.5 -- scatter radius on the finish pad (pad is >= 28x28)
local RESPAWN_FIX_DELAY = 0.4 -- let PlayerService place + stat a fresh character before we adjust it
local MAX_TICK_ERRORS = 40 -- consecutive worker errors before a match is force-closed
local SHORT_RESPAWN_TIME = 1.5 -- Players.RespawnTime cap, so reset-button deaths are quick
local LAYOUT_ATTEMPTS = 4 -- tries to get a layout that passes ValidateLayout
local TOKEN_TOAST_WINDOW = 0.6 -- pickups inside this window share one "+n cloud tokens" toast
local PAD_BELOW = 2 -- studs below a pad's underside that still count as "on" it (poll fallback)
local DEFAULT_KILL_DROP = 60 -- CourseInfo.KillY fallback: origin.Y - this

-- Fall-to-a-lower-lap rule (stacked laps, see landedOnLowerLap). The numbers come from the layout rules:
--   * a legitimate link never drops more than 4 studs (CourseLayout: "drop: rise >= -4 always", cannon
--     landings >= -3 below the pad) and the poll samples every 0.25 s, so two links cannot fit between
--     two samples: honest play never changes the standing height by more than ~4 per sample;
--   * hazard geometry (storm cloud, pendulum, lightning rods ...) is at most 12 studs above its step;
--   * two overlapping steps are always >= Config.Course.Clearance + 2 (step thickness) = 15 studs apart
--     top to top (the generator keeps the underside >= Clearance + 0.3 above the lower top); over the
--     ~55000 overlapping step pairs of 1500 generated layouts (5 difficulties x 300 seeds) the closest
--     was 15.3 and none was closer than 15, so stacked laps clear the 12 stud limit by about 3 studs.
-- So landing more than 12 studs below the last standing height is always a fall, never a link.
local FALL_DROP = 12
-- Ground probe: a standing root is ~3 studs over the floor (HipHeight 2 + half the root, up to ~4.5 on
-- tall avatars). 6 studs reaches the floor under a standing player and the first metres of a jump, but
-- not from the top of a full jump (~7 studs up, root ~10 over the floor).
local GROUND_REACH = 6
-- Vertical speeds (studs/s, downward) used to recognise a fall in progress. A standing player is at 0,
-- a fall reaches 30 after 0.15 s and 60 after 0.3 s (gravity 196):
--   * FALLING_SPEED: this fast is a fall even right above a floor (the player is about to land on it)
--   * DESCENT_SPEED: any clear downward motion; with no floor under the root it also marks a fall.
-- A poll in the air WITHOUT downward motion (jump apex, rising, or a position that was just moved) is
-- ignored: it proves nothing about a fall and must not count as one.
local FALLING_SPEED = 30
local DESCENT_SPEED = 4
local groundParams = nil -- RaycastParams, created on first use

-- A player standing on a pad has the root ~3 studs over its top surface. Anything higher than the
-- course headroom guarantee cannot be a player standing on the pad itself (it would be on a step
-- above it), so the poll fallback never fires from the floor above.
local PAD_ABOVE = 9
if type(Config.Course) == "table" and type(Config.Course.Clearance) == "number" then
	PAD_ABOVE = math.max(6, math.min(12, Config.Course.Clearance + 1))
end

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local deps = {}
local initialized = false
local slots = {} -- slot number -> match
local matches = {} -- match id -> match
local playerMatch = {} -- Player -> match
local nextMatchId = 0
local random = Random.new()
local remoteCache = {}
local tokenCarry = {} -- Player -> fractional pet-bonus tokens not yet paid out (0 <= x < 1)
local tokenToast = {} -- Player -> pending coalesced "+n cloud tokens" toast

-- forward declarations (functions that reference each other)
local endMatch
local cleanupMatch
local detachPlayer
local reachCheckpoint
local markFinished
local broadcastState

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function clock()
	return os.clock()
end

local function numberOr(v, default)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return default
end

local function copyList(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

local function removeValue(list, value)
	for i = #list, 1, -1 do
		if list[i] == value then
			table.remove(list, i)
		end
	end
end

local function nameOf(player)
	local n = player.DisplayName
	if type(n) ~= "string" or n == "" then
		n = player.Name
	end
	return n
end

-- Call deps[name][fnName](...) defensively. Returns ok, result1, result2.
local function callDep(name, fnName, ...)
	local dep = deps[name]
	if not dep then
		return false
	end
	local fn = dep[fnName]
	if type(fn) ~= "function" then
		return false
	end
	local ok, a, b = pcall(fn, ...)
	if not ok then
		warn("[MatchService] " .. name .. "." .. fnName .. " failed: " .. tostring(a))
		return false
	end
	return true, a, b
end

local function setAttr(player, name, value)
	pcall(function()
		player:SetAttribute(name, value)
	end)
end

local function isDowned(player)
	return player:GetAttribute(Config.Attr.Downed) == true
end

local function getRemote(name)
	local cached = remoteCache[name]
	if cached then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		remoteCache[name] = remote
		return remote
	end
	return nil
end

local function fireClient(name, player, ...)
	if not player or player.Parent == nil then
		return
	end
	local remote = getRemote(name)
	if not remote then
		return
	end
	pcall(remote.FireClient, remote, player, ...)
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function notifyAll(match, text, kind, duration, except)
	for _, p in ipairs(match.Players) do
		if p ~= except then
			notify(p, text, kind, duration)
		end
	end
end

local function isMember(match, player)
	return playerMatch[player] == match
end

-- Humanoid + root of a living character, or nil, nil.
local function getLive(player)
	local char = player.Character
	if not char or not char.Parent then
		return nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil, nil
	end
	return hum, root
end

local function teleportTo(player, cf)
	local char = player.Character
	if not char or not char.Parent then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local ok = pcall(function()
		char:PivotTo(cf)
	end)
	if not ok then
		return false
	end
	pcall(function()
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	-- a deliberate move (spawn, revive, void rescue, finish pad): forget where the player last stood, so
	-- the new height is never mistaken for a fall from the old one (see landedOnLowerLap)
	local match = playerMatch[player]
	local rec = match and match.Recs and match.Recs[player]
	if rec then
		rec.LastGroundY = nil
		rec.Airborne = false
	end
	return true
end

-- Place player `index` of `count` on a ring around `base` (in base's local space, so it follows
-- the pad's heading), with a little random jitter.
local function spreadCFrame(base, index, count, radius)
	count = math.max(count or 1, 1)
	local angle = ((index - 1) / count) * math.pi * 2 + math.pi / 4
	local x = math.cos(angle) * radius * 0.8 + random:NextNumber(-1, 1) * radius * 0.2
	local z = math.sin(angle) * radius * 0.8 + random:NextNumber(-1, 1) * radius * 0.2
	return base * CFrame.new(x, 0, z)
end

-- Random scatter around `base` (respawns).
local function jitterCFrame(base, radius)
	return base * CFrame.new(random:NextNumber(-radius, radius), 0, random:NextNumber(-radius, radius))
end

-- Freeze / unfreeze a character: zero speed + jump AND anchored root (the client may fight a
-- WalkSpeed change by itself while sprinting, an anchored root cannot be argued with).
local function setFrozen(player, frozen)
	local char = player.Character
	if not char then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if hum then
		pcall(function()
			hum.UseJumpPower = true
			if frozen then
				hum.WalkSpeed = 0
				hum.JumpPower = 0
			elseif not isDowned(player) then
				hum.WalkSpeed = Config.Physics.WalkSpeed
				hum.JumpPower = Config.Physics.JumpPower
			end
		end)
	end
	if root then
		pcall(function()
			root.Anchored = frozen
		end)
	end
end

-- Is `pos` above/inside the footprint of a block `part` (used instead of Touched for reliability)?
-- The test runs in the part's own space, so it works for pads rotated to any heading.
local function isOverPart(part, pos, padXZ, below, above)
	local rel = part.CFrame:PointToObjectSpace(pos)
	local hs = part.Size * 0.5
	return math.abs(rel.X) <= hs.X + padXZ
		and math.abs(rel.Z) <= hs.Z + padXZ
		and rel.Y >= -(hs.Y + below)
		and rel.Y <= hs.Y + above
end

-- Void height of a match's course (CourseInfo.KillY, else origin.Y - 60).
local function killYOf(match)
	local course = match.Course
	local y = course and course.KillY
	if type(y) == "number" and y == y then
		return y
	end
	if match.Origin then
		return match.Origin.Y - DEFAULT_KILL_DROP
	end
	return -1e9
end

local function teamSpawnCFrame(match)
	local course = match.Course
	if match.Checkpoint >= 1 then
		local cp = course.Checkpoints[match.Checkpoint]
		if cp and cp.SpawnCFrame then
			return cp.SpawnCFrame
		end
	end
	return course.StartCFrame
end

-- Standing spot at the centre of the finish pad, facing the pad's direction of travel (the pad's
-- local +Z). Follows the pad's heading so spiral / zigzag finishes spread correctly.
local function finishCFrame(match)
	local pad = match.Course and match.Course.Finish
	if pad and pad.Parent then
		local top = (pad.CFrame * CFrame.new(0, pad.Size.Y / 2 + 3.5, 0)).Position
		local look = pad.CFrame.LookVector
		local fwd = Vector3.new(-look.X, 0, -look.Z)
		if fwd.Magnitude < 0.01 then
			fwd = Vector3.new(0, 0, 1)
		end
		return CFrame.new(top, top + fwd.Unit)
	end
	return teamSpawnCFrame(match)
end

local function secondsLeft(match, t)
	t = t or clock()
	if match.State == "Countdown" then
		return math.max(0, math.ceil(match.CountdownEnd - t))
	elseif match.State == "Playing" then
		return math.max(0, math.ceil(match.Difficulty.TimeLimit - (t - match.StartedAt)))
	elseif match.State == "Ended" then
		return math.max(0, math.ceil((match.EndDeadline or t) - t))
	end
	return 0
end

----------------------------------------------------------------------
-- Pet perks (deps.PetService). Every call is guarded: no PetService => no bonus.
----------------------------------------------------------------------
local function perkCap(key, default)
	local caps = Config.Pets and Config.Pets.PerkCaps
	return numberOr(caps and caps[key], default)
end

-- Summed perk value (a fraction, 0.2 = +20%) for `key`, capped like PetCatalog.SumPerks.
local function perkOf(player, key)
	local pets = deps.PetService
	if not pets or type(pets.GetPerks) ~= "function" then
		return 0
	end
	local ok, perks = pcall(pets.GetPerks, player)
	if not ok or type(perks) ~= "table" then
		return 0
	end
	local value = numberOr(perks[key], 0)
	if value < 0 then
		value = 0
	end
	local cap = perkCap(key, nil)
	if cap and value > cap then
		value = cap
	end
	return value
end

-- >= 1. Never trusts the PetService to stay inside the configured cap.
local function tokenMultiplier(player)
	local pets = deps.PetService
	if pets and type(pets.GetTokenMultiplier) == "function" then
		local ok, mult = pcall(pets.GetTokenMultiplier, player)
		if ok then
			return Util.Clamp(numberOr(mult, 1), 1, 1 + perkCap("TokenBonus", 1))
		end
	end
	return 1
end

----------------------------------------------------------------------
-- MatchState broadcast
----------------------------------------------------------------------
local function buildState(match, phase)
	local diff = match.Difficulty
	local members = {}
	for _, p in ipairs(match.Players) do
		local fraction = 0
		local hum = Util.GetHumanoid(p)
		if hum and hum.MaxHealth > 0 then
			fraction = Util.Clamp(hum.Health / hum.MaxHealth, 0, 1)
		end
		members[#members + 1] = {
			UserId = p.UserId,
			Name = nameOf(p),
			Health = fraction,
			Downed = isDowned(p),
			Finished = match.Finished[p] == true,
			Tokens = match.Tokens[p] or 0,
		}
	end
	return {
		Phase = phase,
		DifficultyId = diff.Id,
		DifficultyName = diff.DisplayName,
		Color = diff.Color,
		Seconds = secondsLeft(match),
		Checkpoint = match.Checkpoint,
		TotalCheckpoints = match.TotalCheckpoints,
		TokensCollected = match.TeamTokens,
		TotalTokens = (match.Course and match.Course.TotalTokens) or 0,
		Members = members,
	}
end

broadcastState = function(match)
	if match.State == "Setup" then
		return
	end
	local state = buildState(match, match.State)
	for _, p in ipairs(match.Players) do
		fireClient("MatchState", p, state)
	end
	match.LastStateAt = clock()
end

----------------------------------------------------------------------
-- Stop helpers (idempotent)
----------------------------------------------------------------------
local function stopHazards(match)
	local fn = match.StopHazards
	match.StopHazards = nil
	if fn then
		local ok, err = pcall(fn)
		if not ok then
			warn("[MatchService] hazard stop failed: " .. tostring(err))
		end
	end
end

local function stopTokens(match)
	local fn = match.StopTokens
	match.StopTokens = nil
	if fn then
		local ok, err = pcall(fn)
		if not ok then
			warn("[MatchService] token stop failed: " .. tostring(err))
		end
	end
end

local function destroyCourse(match)
	local course = match.Course
	if course and course.Folder then
		pcall(function()
			course.Folder:Destroy()
		end)
	elseif match.Seed then
		-- belt and braces: a Build() that threw after parenting could leave an orphan folder.
		-- Sweep it by name, but never touch a folder that belongs to another live match.
		local name = "Course_" .. tostring(match.Seed)
		local claimed = {}
		for _, m in pairs(matches) do
			if m ~= match and m.Course and m.Course.Folder then
				claimed[m.Course.Folder] = true
			end
		end
		for _, child in ipairs(Workspace:GetChildren()) do
			if child.Name == name and not claimed[child] then
				pcall(function()
					child:Destroy()
				end)
			end
		end
	end
end

----------------------------------------------------------------------
-- Tokens
----------------------------------------------------------------------
-- Pay `n` tokens into the persistent wallet. Also keeps Stats.TokensEarned (lifetime) correct:
-- if DataService.AddTokens already counts it we leave it alone, otherwise we add it here, so the
-- stat is right whichever way DataService is written (and never double counted).
local function creditTokens(player, n)
	local ds = deps.DataService
	if not ds then
		return
	end
	local profile = nil
	local before = 0
	if type(ds.GetProfile) == "function" then
		local ok, p = pcall(ds.GetProfile, player)
		if ok and type(p) == "table" and type(p.Stats) == "table" then
			profile = p
			before = numberOr(p.Stats.TokensEarned, 0)
		end
	end
	callDep("DataService", "AddTokens", player, n)
	if profile and numberOr(profile.Stats.TokensEarned, 0) == before then
		profile.Stats.TokensEarned = before + n
		callDep("DataService", "MarkDirty", player)
	end
end

-- Several pickups within TOKEN_TOAST_WINDOW share one toast, so the (max 4) toast stack on the
-- right edge is not flooded by a row of tokens.
local function queueTokenToast(match, player, gained, base)
	local pending = tokenToast[player]
	if pending then
		pending.Gained = pending.Gained + gained
		pending.Base = pending.Base + base
		return
	end
	pending = { Gained = gained, Base = base }
	tokenToast[player] = pending
	task.delay(TOKEN_TOAST_WINDOW, function()
		if tokenToast[player] == pending then
			tokenToast[player] = nil
		end
		if player.Parent == nil or playerMatch[player] ~= match then
			return
		end
		local text = "+" .. pending.Gained .. " cloud token"
		if pending.Gained ~= 1 then
			text = text .. "s"
		end
		local extra = pending.Gained - pending.Base
		if extra > 0 then
			text = text .. " (pets +" .. extra .. ")"
		end
		notify(player, text, "token", 2)
	end)
end

-- TokenService calls this (through the match handle) with the pickup's base value.
-- Pets multiply the payout; a per-player carry keeps the rounding fair over time:
--   exact = base * multiplier + carry ; paid = floor(exact) ; carry = exact - paid
local function addTokens(match, player, n)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	if not isMember(match, player) then
		return
	end
	local base = math.floor(numberOr(n, 0) + 0.5)
	if base < 1 then
		return
	end
	local exact = base * tokenMultiplier(player) + (tokenCarry[player] or 0)
	local paid = math.floor(exact + 1e-6)
	if paid < base then
		paid = base -- the multiplier is >= 1, never pay less than the pickup is worth
	end
	tokenCarry[player] = math.max(0, exact - paid)

	local total = (match.Tokens[player] or 0) + paid
	match.Tokens[player] = total
	match.TeamTokens = match.TeamTokens + base -- team progress counts the course's own token value
	setAttr(player, Config.Attr.MatchTokens, total)
	creditTokens(player, paid)
	queueTokenToast(match, player, paid, base)
end

----------------------------------------------------------------------
-- Checkpoints, finish, void
----------------------------------------------------------------------
reachCheckpoint = function(match, index, byPlayer)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	if index <= match.Checkpoint then
		return
	end
	local cp = match.Course.Checkpoints[index]
	if not cp then
		return
	end
	match.Checkpoint = index
	notifyAll(match, string.format("Checkpoint %d/%d reached!", index, match.TotalCheckpoints), "good", 3.5)

	-- heal everyone who is up (pets can boost their owner's heal), collect the downed
	local downedList = {}
	for _, p in ipairs(copyList(match.Players)) do
		if isMember(match, p) then
			if isDowned(p) then
				table.insert(downedList, p)
			else
				local fraction = Config.Damage.CheckpointHealFraction * (1 + perkOf(p, "CheckpointHeal"))
				callDep("DamageService", "HealFraction", p, Util.Clamp(fraction, 0, 1))
			end
		end
	end

	-- lift up the downed teammates right here
	for i, p in ipairs(downedList) do
		teleportTo(p, spreadCFrame(cp.SpawnCFrame, i, #downedList, CHECKPOINT_SPREAD))
		callDep("DamageService", "Revive", p)
		local who = "your team"
		if byPlayer and byPlayer ~= p then
			who = nameOf(byPlayer)
		end
		notify(p, "Revived by " .. who .. "!", "good", 3)
	end
	if #downedList > 0 then
		notifyAll(match, "Team is back on its feet!", "good", 3)
	end
	broadcastState(match)
end

local function onCheckpointTouched(match, index, hit)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	local player = Util.PlayerFromPart(hit)
	if not player or not isMember(match, player) then
		return
	end
	if isDowned(player) or match.Finished[player] then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	reachCheckpoint(match, index, player)
end

markFinished = function(match, player)
	if match.State ~= "Playing" or match.Finished[player] then
		return
	end
	if isDowned(player) or not isMember(match, player) then
		return
	end
	match.Finished[player] = true
	match.FinishCount = match.FinishCount + 1
	-- park them safely on the pad and keep them out of harm's way
	teleportTo(player, spreadCFrame(finishCFrame(match), match.FinishCount, Config.Match.MaxPlayers, FINISH_SPREAD))
	setFrozen(player, true)
	callDep("DamageService", "GrantInvulnerability", player, 3)
	notify(player, "You made it! Wait for your team.", "good", 4)
	notifyAll(match, nameOf(player) .. " reached the finish!", "good", 3, player)
	broadcastState(match)
end

local function onFinishTouched(match, hit)
	if match.State ~= "Playing" or match.Stopped then
		return
	end
	local player = Util.PlayerFromPart(hit)
	if not player or not isMember(match, player) then
		return
	end
	local hum = Util.GetHumanoid(player)
	if not hum or hum.Health <= 0 then
		return
	end
	markFinished(match, player)
end

-- Player fell below the course. Damage them (unless downed / finished), then bring them back.
local function handleVoid(match, player, wasDowned, finished)
	if finished then
		teleportTo(player, finishCFrame(match))
		return
	end
	if not wasDowned then
		local dmg = Config.Damage.VoidDamage[match.DifficultyId] or 20
		callDep("DamageService", "Damage", player, dmg, "Void", { IgnoreIFrames = true })
	end
	teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
	if not isDowned(player) then
		callDep("DamageService", "GrantInvulnerability", player, 1.5)
	end
end

-- Is the player standing on (or a step above) something solid? Humanoid.FloorMaterial answers that on
-- the peer that simulates the character; this runs on the server, so a short ray down from the root
-- backs it up and the rule keeps working even where the server never sees a floor material.
-- CanCollide = false parts (tokens, storm / wind volumes, faded clouds) are ignored like physics does.
local function isGrounded(hum, root)
	local okFloor, floor = pcall(function()
		return hum.FloorMaterial
	end)
	if okFloor and floor ~= nil and floor ~= Enum.Material.Air then
		return true
	end
	local okRay, hit = pcall(function()
		if not groundParams then
			groundParams = RaycastParams.new()
			groundParams.FilterType = Enum.RaycastFilterType.Exclude
			groundParams.RespectCanCollide = true
		end
		groundParams.FilterDescendantsInstances = { root.Parent }
		return Workspace:Raycast(root.Position, Vector3.new(0, -GROUND_REACH, 0), groundParams)
	end)
	return okRay and hit ~= nil
end

-- Laps are stacked: a missed jump on a Spiral (or any overlapping layout) usually lands on a lower lap
-- 15-40 studs down, long before KillY, so the plane alone never punishes it and the player is stranded
-- behind the team. Per player we remember the height they last stood at (rec.LastGroundY) and whether
-- they have been in the air since (rec.Airborne). Touching ground again more than FALL_DROP studs below
-- that height is a fall: this returns true ONCE, then the caller rescues the player (handleVoid /
-- teleport), which also clears the memory.
--   * only a settled poll (on the ground, not falling fast) is judged and may move the reference, so a
--     cannon flight, bounce, dash or the last metres of a fall can neither trigger nor corrupt it; the
--     legitimate landings after a launch are at most 4 studs below the take-off (see FALL_DROP)
--   * a real fall always has a poll that is moving down in the air before the landing (>= 0.35 s in the
--     air against a 0.25 s poll), so a position that merely jumps (teleport, respawn, lag) with no such
--     poll in between is never read as a fall
--   * the reference is the player's OWN last standing height, not the team checkpoint: stragglers on the
--     previous stage can be ~15 studs below the new checkpoint and are not falling
--   * a new character (respawn) and every teleportTo() start with a clean slate
-- Call it only for live members who are neither downed nor finished.
local function landedOnLowerLap(match, player, hum, root)
	local rec = match.Recs[player]
	if not rec then
		return false
	end
	if rec.GroundRoot ~= root then
		rec.GroundRoot = root
		rec.LastGroundY = nil
		rec.Airborne = false
	end
	local vy = numberOr(root.AssemblyLinearVelocity.Y, 0)
	if vy < -FALLING_SPEED then
		rec.Airborne = true
		return false
	end
	if not isGrounded(hum, root) then
		if vy < -DESCENT_SPEED then
			rec.Airborne = true
		end
		return false
	end
	local y = root.Position.Y
	local last = rec.LastGroundY
	local flew = rec.Airborne == true
	rec.Airborne = false
	if flew and last and y < last - FALL_DROP then
		rec.LastGroundY = nil
		return true
	end
	rec.LastGroundY = y
	return false
end

----------------------------------------------------------------------
-- Per-player hooks: character respawn + death
----------------------------------------------------------------------
local function attachDied(match, player, hum)
	local rec = match.Recs[player]
	if not rec then
		return
	end
	if rec.DiedConn then
		rec.DiedConn:Disconnect()
		rec.DiedConn = nil
	end
	rec.DiedConn = hum.Died:Connect(function()
		if match.Stopped or not isMember(match, player) then
			return
		end
		-- a KO'd character that dies for real (reset button) comes back healthy at the checkpoint
		setAttr(player, Config.Attr.Downed, false)
		broadcastState(match)
	end)
end

local function onCharacterAdded(match, player, char)
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		if not hum or not root then
			return
		end
		if not isMember(match, player) or match.Stopped then
			return
		end
		attachDied(match, player, hum)

		task.wait(RESPAWN_FIX_DELAY)
		if match.Stopped or not isMember(match, player) then
			return
		end
		if player.Character ~= char or hum.Parent == nil or hum.Health <= 0 then
			return
		end

		-- PlayerService normally already placed us via GetRespawnCFrame; make sure.
		local finished = match.Finished[player] == true
		local target = teamSpawnCFrame(match)
		if finished then
			target = finishCFrame(match)
		end
		if (root.Position - target.Position).Magnitude > 80 then
			if finished then
				teleportTo(player, spreadCFrame(target, 1, Config.Match.MaxPlayers, FINISH_SPREAD))
			else
				teleportTo(player, jitterCFrame(target, CHECKPOINT_SPREAD))
			end
		end

		-- respawn rule: back at the checkpoint immediately, 50% health, no penalty
		setAttr(player, Config.Attr.Downed, false)
		callDep("DamageService", "SetHealthFraction", player, Config.Damage.ReviveHealthFraction)
		callDep("DamageService", "GrantInvulnerability", player, 2)
		if match.State == "Countdown" or finished then
			setFrozen(player, true)
		end
	end)
end

local function hookPlayer(match, player)
	local rec = match.Recs[player]
	if not rec then
		return
	end
	table.insert(rec.Conns, player.CharacterAdded:Connect(function(char)
		onCharacterAdded(match, player, char)
	end))
	local char = player.Character
	if char then
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			attachDied(match, player, hum)
		end
	end
end

----------------------------------------------------------------------
-- Membership
----------------------------------------------------------------------
local function enrollPlayer(match, player, index, count)
	playerMatch[player] = match
	match.Tokens[player] = 0
	match.Recs[player] = { Conns = {} }
	-- InMatch first: the lobby watchdog would otherwise yank a player standing at y=800 home
	setAttr(player, Config.Attr.InMatch, true)
	setAttr(player, Config.Attr.Downed, false)
	setAttr(player, Config.Attr.MatchTokens, 0)
	callDep("DamageService", "SetHealthFraction", player, 1)
	callDep("DamageService", "GrantInvulnerability", player, Config.Match.IntroCountdown + 2)
	teleportTo(player, spreadCFrame(match.Course.StartCFrame, index, count, START_SPREAD))
	setFrozen(player, true)
	hookPlayer(match, player)
end

-- Remove a player from a match and (optionally) send them home. Does not end the match.
detachPlayer = function(match, player, toLobby)
	if playerMatch[player] ~= match then
		return
	end
	playerMatch[player] = nil
	removeValue(match.Players, player)
	match.Alive[player] = nil
	local rec = match.Recs[player]
	match.Recs[player] = nil
	if rec then
		for _, conn in ipairs(rec.Conns) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		if rec.DiedConn then
			pcall(function()
				rec.DiedConn:Disconnect()
			end)
		end
	end
	if player.Parent == nil then
		return -- they left the game, nothing to restore
	end

	local wasDowned = isDowned(player)
	setFrozen(player, false)
	if wasDowned then
		-- silently leave the downed state (restores look + walk speed); fall back to a full Revive
		local cleared = callDep("DamageService", "ClearDowned", player)
		if not cleared then
			callDep("DamageService", "Revive", player)
		end
	end
	setAttr(player, Config.Attr.InMatch, false)
	setAttr(player, Config.Attr.Downed, false)
	setAttr(player, Config.Attr.MatchTokens, 0)
	fireClient("MatchState", player, nil)
	if toLobby then
		callDep("PlayerService", "ApplyHumanoidStats", player)
		callDep("PlayerService", "SendToLobby", player)
	end
end

----------------------------------------------------------------------
-- Cleanup
----------------------------------------------------------------------
cleanupMatch = function(match)
	if match.CleanedUp then
		return
	end
	match.CleanedUp = true
	match.Stopped = true
	if match.State ~= "Ended" then
		match.State = "Ended"
	end
	if not match.Reason then
		match.Reason = "abandoned"
	end

	-- 1. stop everything that runs inside the course
	stopHazards(match)
	stopTokens(match)

	-- 2. event connections owned by the match
	for _, conn in ipairs(match.Connections) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	match.Connections = {}

	-- 3. players home (each in its own pcall so one bad character cannot strand the rest)
	for _, p in ipairs(copyList(match.Players)) do
		local ok, err = pcall(detachPlayer, match, p, true)
		if not ok then
			warn("[MatchService] detach failed: " .. tostring(err))
			playerMatch[p] = nil
		end
	end
	match.Players = {}
	match.Alive = {}

	-- 4. the course itself
	destroyCourse(match)

	-- 5. free the slot
	if slots[match.Slot] == match then
		slots[match.Slot] = nil
	end
	matches[match.Id] = nil

	-- 6. tell the world
	MatchService.MatchEnded:Fire(match, match.Won == true)
end

----------------------------------------------------------------------
-- Ending a match (victory / defeat / timeout / abandoned)
----------------------------------------------------------------------
-- Stats for every member: Matches always, Wins + BestTimes only for finishers of a won match.
-- Runs off the worker thread so a slow DataService can never stall the match state machine.
local function recordStats(match, roster, won, seconds)
	local diffId = match.DifficultyId
	local finished = {}
	for _, p in ipairs(roster) do
		finished[p] = won and match.Finished[p] == true
	end
	task.spawn(function()
		for _, p in ipairs(roster) do
			if p.Parent ~= nil then
				callDep("DataService", "RecordMatch", p, diffId, finished[p] == true, seconds)
				callDep("DataService", "Sync", p)
			end
		end
	end)
end

endMatch = function(match, won, reason)
	if match.Stopped or match.State == "Ended" then
		return
	end
	local t = clock()
	local playSeconds = 0
	if match.StartedAt then
		playSeconds = t - match.StartedAt
	end
	if reason == "timeout" then
		playSeconds = match.Difficulty.TimeLimit
	end
	match.State = "Ended"
	match.Won = won
	match.Reason = reason
	match.EndedAt = t
	stopTokens(match)

	if reason == "abandoned" or #match.Players == 0 then
		cleanupMatch(match)
		return
	end

	-- victory bonus goes to everybody who made it to the finish
	local bonusValue = 0
	if won then
		bonusValue = Config.Match.TokenBonusOnWin[match.DifficultyId] or 0
	end
	local bonuses = {}
	for _, p in ipairs(match.Players) do
		if won and bonusValue > 0 and match.Finished[p] then
			bonuses[p] = bonusValue
			creditTokens(p, bonusValue)
		end
	end

	recordStats(match, copyList(match.Players), won, Util.Round(playSeconds, 1))

	local members = {}
	for _, p in ipairs(match.Players) do
		members[#members + 1] = {
			Name = nameOf(p),
			MatchTokens = match.Tokens[p] or 0,
			Finished = match.Finished[p] == true,
			Downed = isDowned(p),
		}
	end
	local diff = match.Difficulty
	for _, p in ipairs(match.Players) do
		fireClient("MatchResult", p, {
			Won = won,
			Reason = reason,
			Seconds = math.floor(playSeconds + 0.5),
			MatchTokens = match.Tokens[p] or 0,
			Bonus = bonuses[p] or 0,
			DifficultyId = diff.Id,
			DifficultyName = diff.DisplayName,
			Stars = diff.Stars,
			TotalTokens = (match.Course and match.Course.TotalTokens) or 0,
			Members = members,
		})
		callDep("DamageService", "GrantInvulnerability", p, 2)
	end

	match.EndDeadline = t + Config.Match.EndScreenSeconds
	broadcastState(match)
end

----------------------------------------------------------------------
-- The worker loop
----------------------------------------------------------------------
local function refreshAlive(match)
	local alive = {}
	for _, p in ipairs(match.Players) do
		if not isDowned(p) then
			alive[p] = true
		end
	end
	match.Alive = alive
end

local function beginPlaying(match, t)
	match.State = "Playing"
	match.StartedAt = t
	match.LastStateAt = 0
	for _, p in ipairs(copyList(match.Players)) do
		if isMember(match, p) and not match.Finished[p] then
			setFrozen(p, false)
		end
	end
	notifyAll(match, "Go! Climb together.", "good", 3.5)
	broadcastState(match)
end

local function processPlayerPlaying(match, player)
	local hum, root = getLive(player)
	if not hum or not root then
		return
	end
	local course = match.Course
	local downed = isDowned(player)
	local finished = match.Finished[player] == true

	if root.Position.Y < killYOf(match) then
		handleVoid(match, player, downed, finished)
		return
	end
	if downed or finished then
		return
	end

	-- missed jump onto a lower lap of a stacked course: same penalty as falling into the void
	if landedOnLowerLap(match, player, hum, root) then
		handleVoid(match, player, false, false)
		return
	end

	-- checkpoints: highest unreached one the player is standing on
	local pos = root.Position
	for index = match.MaxCheckpoint, match.Checkpoint + 1, -1 do
		local cp = course.Checkpoints[index]
		if cp and cp.Part and cp.Part.Parent and isOverPart(cp.Part, pos, 2, PAD_BELOW, PAD_ABOVE) then
			reachCheckpoint(match, index, player)
			break
		end
	end

	local pad = course.Finish
	if pad and pad.Parent and isOverPart(pad, pos, 1, PAD_BELOW, PAD_ABOVE) then
		markFinished(match, player)
	end
end

local function tickPlaying(match, t)
	for _, player in ipairs(copyList(match.Players)) do
		if isMember(match, player) and match.State == "Playing" and not match.Stopped then
			local ok, err = pcall(processPlayerPlaying, match, player)
			if not ok then
				warn("[MatchService] player tick failed: " .. tostring(err))
			end
			if match.Finished[player] then
				callDep("DamageService", "GrantInvulnerability", player, 1)
			end
		end
	end
	if match.State ~= "Playing" or match.Stopped then
		return
	end

	refreshAlive(match)
	local aliveCount = 0
	local finishedAlive = 0
	for p in pairs(match.Alive) do
		aliveCount = aliveCount + 1
		if match.Finished[p] then
			finishedAlive = finishedAlive + 1
		end
	end

	if aliveCount > 0 and finishedAlive == aliveCount then
		endMatch(match, true, "victory")
		return
	end
	if aliveCount == 0 then
		endMatch(match, false, "defeat")
		return
	end

	local limit = match.Difficulty.TimeLimit
	local left = limit - (t - match.StartedAt)
	if left <= 0 then
		endMatch(match, false, "timeout")
		return
	end
	if limit > 150 and left <= 60 and not match.Warned60 then
		match.Warned60 = true
		notifyAll(match, "One minute left!", "bad", 4)
	end

	if t - match.LastStateAt >= STATE_INTERVAL then
		broadcastState(match)
	end
end

local function tickEnded(match, t)
	local killY = killYOf(match)
	for _, player in ipairs(copyList(match.Players)) do
		if isMember(match, player) then
			callDep("DamageService", "GrantInvulnerability", player, 1)
			local hum, root = getLive(player)
			if hum and root then
				-- no damage on the results screen, just bring them back
				if root.Position.Y < killY then
					if match.Finished[player] then
						teleportTo(player, finishCFrame(match))
					else
						teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
					end
				elseif not match.Finished[player] and not isDowned(player) and landedOnLowerLap(match, player, hum, root) then
					-- missed jump onto a lower lap: same free rescue
					teleportTo(player, jitterCFrame(teamSpawnCFrame(match), CHECKPOINT_SPREAD))
				end
			end
		end
	end
	if t >= (match.EndDeadline or t) then
		cleanupMatch(match)
		return
	end
	if t - match.LastStateAt >= STATE_INTERVAL then
		broadcastState(match)
	end
end

local function tickMatch(match)
	local t = clock()
	if #match.Players == 0 then
		if match.State ~= "Ended" then
			match.State = "Ended"
			match.Won = false
			match.Reason = "abandoned"
		end
		cleanupMatch(match)
		return
	end
	refreshAlive(match)

	if match.State == "Countdown" then
		if t >= match.CountdownEnd then
			beginPlaying(match, t)
		else
			local remaining = math.ceil(match.CountdownEnd - t)
			if remaining ~= match.LastCountdown then
				match.LastCountdown = remaining
				broadcastState(match)
			end
		end
	elseif match.State == "Playing" then
		tickPlaying(match, t)
	elseif match.State == "Ended" then
		tickEnded(match, t)
	end
end

local function runMatch(match)
	local errors = 0
	while not match.Stopped do
		local ok, err = pcall(tickMatch, match)
		if ok then
			errors = 0
		else
			errors = errors + 1
			warn("[MatchService] tick error (match " .. tostring(match.Id) .. "): " .. tostring(err))
			if errors >= MAX_TICK_ERRORS then
				warn("[MatchService] closing broken match " .. tostring(match.Id))
				pcall(cleanupMatch, match)
				break
			end
		end
		task.wait(TICK)
	end
end

----------------------------------------------------------------------
-- Setup
----------------------------------------------------------------------
local function allocateSlot()
	for s = 1, Config.Match.MaxConcurrent do
		if slots[s] == nil then
			return s
		end
	end
	return nil
end

-- True when another live match already uses this layout seed (course folders are named after it).
local function seedInUse(match, seed)
	for _, m in pairs(matches) do
		if m ~= match and m.Seed == seed then
			return true
		end
	end
	return false
end

-- Keep only checkpoints the match can actually use: a table with a numeric index and a spawn
-- CFrame (derived from the pad when the builder did not supply one).
local function cleanCheckpoints(raw)
	local clean = {}
	local count = 0
	local maxIndex = 0
	for index, cp in pairs(raw or {}) do
		if type(index) == "number" and type(cp) == "table" then
			if typeof(cp.SpawnCFrame) ~= "CFrame" and cp.Part then
				cp.SpawnCFrame = cp.Part.CFrame * CFrame.new(0, cp.Part.Size.Y / 2 + 3.5, 0)
			end
			if typeof(cp.SpawnCFrame) == "CFrame" then
				clean[index] = cp
				count = count + 1
				if index > maxIndex then
					maxIndex = index
				end
			end
		end
	end
	return clean, count, maxIndex
end

-- Generate (and validate) a layout, build the course, attach hazards + token pickup, and hook the
-- checkpoint / finish touch events. Errors propagate to the caller (StartMatch cleans up).
local function setupCourse(match)
	local CB = deps.CourseBuilder
	if not CB or type(CB.GenerateLayout) ~= "function" or type(CB.Build) ~= "function" then
		error("CourseBuilder dependency missing")
	end
	match.Origin = Config.Match.ArenaOrigin + Vector3.new((match.Slot - 1) * Config.Match.SlotSpacing, 0, 0)

	local layout = nil
	for attempt = 1, LAYOUT_ATTEMPTS do
		-- match ids are unique per server, so ids far apart in seed space keep concurrent matches
		-- from sharing a seed (and thus a Course_<seed> folder name); bump past any live collision
		local seed = os.time() + match.Id * 100003 + attempt
		while seedInUse(match, seed) do
			seed = seed + 1
		end
		local okLayout, result = pcall(CB.GenerateLayout, match.DifficultyId, seed)
		if okLayout and type(result) == "table" then
			layout = result
			match.Seed = result.Seed or seed
			local valid = true
			if type(CB.ValidateLayout) == "function" then
				local okValid, isValid, problems = pcall(CB.ValidateLayout, result)
				if okValid and isValid == false then
					valid = false
					local first = "?"
					if type(problems) == "table" and problems[1] then
						first = tostring(problems[1])
					end
					warn("[MatchService] layout seed " .. tostring(seed) .. " failed validation: " .. first)
				end
			end
			if valid then
				break
			end
		else
			warn("[MatchService] GenerateLayout failed: " .. tostring(result))
		end
	end
	if not layout then
		error("could not generate a course layout")
	end

	local okBuild, info = pcall(CB.Build, layout, match.Origin, Workspace)
	if not okBuild or type(info) ~= "table" then
		error("course build failed: " .. tostring(info))
	end
	match.Layout = layout
	match.Course = info
	if typeof(info.StartCFrame) ~= "CFrame" or not info.Finish then
		error("course is missing its start or finish")
	end
	match.Archetype = info.Archetype or layout.Archetype

	local clean, count, maxIndex = cleanCheckpoints(info.Checkpoints)
	info.Checkpoints = clean
	match.TotalCheckpoints = count
	match.MaxCheckpoint = maxIndex

	-- hazards pause unless the match is actually being played
	local hazardHandle = {
		IsActive = function()
			return match.State == "Playing" and not match.Stopped
		end,
	}
	local HS = deps.HazardService
	if HS and type(HS.Attach) == "function" then
		local okH, stopH = pcall(HS.Attach, info.Folder, hazardHandle)
		if okH and type(stopH) == "function" then
			match.StopHazards = stopH
		elseif not okH then
			warn("[MatchService] HazardService.Attach failed: " .. tostring(stopH))
		end
	end

	local TS = deps.TokenService
	if TS and type(TS.Watch) == "function" then
		local tokenHandle = {
			AddTokens = function(player, n)
				addTokens(match, player, n)
			end,
		}
		local okT, stopT = pcall(TS.Watch, info.Folder, tokenHandle)
		if okT and type(stopT) == "function" then
			match.StopTokens = stopT
		elseif not okT then
			warn("[MatchService] TokenService.Watch failed: " .. tostring(stopT))
		end
	end

	-- Touched gives instant feedback, the 4 Hz proximity poll in the worker loop is the backup.
	for index, cp in pairs(info.Checkpoints) do
		if cp.Part then
			table.insert(match.Connections, cp.Part.Touched:Connect(function(hit)
				onCheckpointTouched(match, index, hit)
			end))
		end
	end
	table.insert(match.Connections, info.Finish.Touched:Connect(function(hit)
		onFinishTouched(match, hit)
	end))
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- deps = { PlayerService, DamageService, DataService, HazardService, TokenService, CourseBuilder,
--          PetService }  (ItemService is separate: it asks MatchService.GetMatchOf)
function MatchService.Init(d)
	deps = d or deps or {}
	if initialized then
		return
	end
	initialized = true

	-- Reset-button deaths should respawn quickly (the match rule is "back at the checkpoint").
	pcall(function()
		if Players.RespawnTime > SHORT_RESPAWN_TIME then
			Players.RespawnTime = SHORT_RESPAWN_TIME
		end
	end)

	local okRemote, leaveRemote = pcall(Remotes.Get, "LeaveMatch")
	if okRemote and leaveRemote then
		leaveRemote.OnServerEvent:Connect(function(player)
			MatchService.LeaveMatch(player)
		end)
	else
		warn("[MatchService] LeaveMatch remote unavailable")
	end

	Players.PlayerRemoving:Connect(function(player)
		local match = playerMatch[player]
		if match then
			detachPlayer(match, player, false)
			if #match.Players == 0 and not match.CleanedUp then
				if match.State ~= "Ended" then
					match.State = "Ended"
					match.Won = false
					match.Reason = "abandoned"
				end
				cleanupMatch(match)
			end
		end
		tokenCarry[player] = nil
		tokenToast[player] = nil
	end)

	local dmg = deps.DamageService
	if dmg and dmg.PlayerDowned and type(dmg.PlayerDowned.Connect) == "function" then
		dmg.PlayerDowned:Connect(function(player)
			local match = playerMatch[player]
			if not match or match.State ~= "Playing" or match.Stopped then
				return
			end
			notifyAll(match, nameOf(player) .. " is down! Next flag revives.", "bad", 4, player)
			broadcastState(match)
		end)
	end
end

-- Start a match for `players` on the lowest free slot. Returns the match, or nil when no arena
-- slot is free / the course could not be built.
function MatchService.StartMatch(difficultyId, players)
	if not initialized then
		warn("[MatchService] StartMatch before Init")
		return nil
	end
	local diff = Config.GetDifficulty(difficultyId)
	if not diff then
		warn("[MatchService] unknown difficulty " .. tostring(difficultyId))
		return nil
	end

	local candidates = {}
	local seen = {}
	for _, p in ipairs(players or {}) do
		if p and p.Parent ~= nil and not seen[p] and not playerMatch[p] and #candidates < Config.Match.MaxPlayers then
			seen[p] = true
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		return nil
	end

	local slot = allocateSlot()
	if not slot then
		return nil
	end

	nextMatchId = nextMatchId + 1
	local match = {
		Id = nextMatchId,
		DifficultyId = diff.Id,
		Difficulty = diff,
		Slot = slot,
		Players = {},
		Alive = {},
		State = "Setup",
		Checkpoint = 0,
		TotalCheckpoints = 0,
		MaxCheckpoint = 0,
		StartedAt = nil,
		Course = nil,
		Won = false,
		Reason = nil,
		TeamTokens = 0, -- course token value collected by the team (pet bonus not included)
		FinishCount = 0,
		LastStateAt = 0,
		Tokens = {}, -- Player -> tokens paid out this match (pet bonus included)
		Finished = {}, -- Player -> true
		Recs = {}, -- Player -> { Conns, DiedConn }
		Connections = {}, -- match-level connections (checkpoint / finish Touched)
		Stopped = false,
		CleanedUp = false,
	}
	slots[slot] = match -- reserve the slot before anything can yield
	matches[match.Id] = match

	local okSetup, errSetup = pcall(setupCourse, match)
	if not okSetup then
		warn("[MatchService] setup failed: " .. tostring(errSetup))
		match.Stopped = true
		stopHazards(match)
		stopTokens(match)
		for _, conn in ipairs(match.Connections) do
			pcall(function()
				conn:Disconnect()
			end)
		end
		destroyCourse(match)
		slots[slot] = nil
		matches[match.Id] = nil
		return nil
	end

	-- players may have left while the course was being built
	local present = {}
	for _, p in ipairs(candidates) do
		if p.Parent ~= nil and not playerMatch[p] then
			table.insert(present, p)
		end
	end
	if #present == 0 then
		match.Won = false
		match.Reason = "abandoned"
		cleanupMatch(match)
		return nil
	end

	match.Players = present
	for i, p in ipairs(present) do
		local ok, err = pcall(enrollPlayer, match, p, i, #present)
		if not ok then
			warn("[MatchService] enroll failed for " .. tostring(p.Name) .. ": " .. tostring(err))
		end
	end
	refreshAlive(match)

	match.State = "Countdown"
	match.CountdownEnd = clock() + Config.Match.IntroCountdown
	match.LastCountdown = math.ceil(Config.Match.IntroCountdown)
	broadcastState(match)

	local welcome = "Welcome to " .. diff.DisplayName .. "!"
	if type(match.Archetype) == "string" and match.Archetype ~= "" then
		welcome = diff.DisplayName .. ": " .. match.Archetype .. " course"
	end
	for _, p in ipairs(present) do
		notify(p, welcome, "info", 3)
	end

	task.spawn(runMatch, match)
	return match
end

function MatchService.GetMatchOf(player)
	return playerMatch[player]
end

-- SpawnProvider for PlayerService: team checkpoint spawn (scattered), nil => lobby spawn.
function MatchService.GetRespawnCFrame(player)
	local match = playerMatch[player]
	if not match or match.Stopped or not match.Course then
		return nil
	end
	if match.Finished[player] then
		return spreadCFrame(finishCFrame(match), random:NextInteger(1, 4), 4, FINISH_SPREAD)
	end
	local spread = CHECKPOINT_SPREAD
	if match.Checkpoint < 1 then
		spread = START_SPREAD
	end
	return jitterCFrame(teamSpawnCFrame(match), spread)
end

-- Player goes back to the lobby; the match carries on without them (or closes if they were last).
function MatchService.LeaveMatch(player)
	local match = playerMatch[player]
	if not match then
		return
	end
	local name = nameOf(player)
	detachPlayer(match, player, true)
	if #match.Players == 0 then
		if match.State ~= "Ended" then
			match.State = "Ended"
			match.Won = false
			match.Reason = "abandoned"
		end
		cleanupMatch(match)
	else
		notifyAll(match, name .. " left the match.", "info", 3)
		broadcastState(match)
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="853">
          <Properties>
            <string name="Name">NpcService</string>
            <string name="Source"><![CDATA[-- NpcService: builds the six NPC pets of the lobby (ARCHITECTURE_V3.md section 5).
--
--   NpcService.Init(lobbyInfo, deps)   builds every NPC of shared/NpcDialog at lobbyInfo.NpcSpots[i] (6 ground-level
--                                      CFrames facing the walkway; missing ones fall back to 6 points around the
--                                      plaza). Safe to call again: the old NPCs are replaced. Returns GetNpcs().
--   NpcService.GetNpcs() -> { { Id, Name, Model, Pet, Prompt, Spot }, ... }
--   NpcService.GetNpc(id) -> record | nil
--   NpcService.FallbackSpots(lobbyInfo, count) -> { CFrame, ... }
--   NpcService.Talked                  Util.Signal; Fire(player, npcId) when a player uses an NPC's prompt
--
-- Every NPC is a Model "Npc_<Id>" in workspace.NimbusNpcs, tagged NpcDialog.Tag ("NC_Npc") with the attributes
-- NpcId, NpcName, Title, PetId, Accent (Color3) and PetParts (the pet's part count, so a client can tell when it
-- has fully replicated). Inside it:
--   Pedestal     a crafted voxel plinth (shared/Voxel.lua): a stepped stone base with a coloured tile band, studs,
--                a gold plaque, moss on the rim, tiny flowers and a patterned rug in the NPC's accent colour
--   Pet          PetBuilder.Build(catalog pet, { Detail = "High", Scale = 2.2 }) hovering above the rug, facing the
--                spot's LookVector (the walkway)
--   Collider     one invisible collidable cylinder around plinth + pet (players bump into the NPC, never stand in it)
--   PromptPart   an invisible part at the pet's centre holding the BillboardGui "Nameplate" (name + title pills and
--                a gold "!" badge; Theme fonts, readable sizes), a soft light, a few rising sparkles and the Attachment
--                "PromptAnchor" (front of the cushion) with the ProximityPrompt "TalkPrompt" (ActionText "Talk",
--                ObjectText = Name, HoldDuration 0, MaxActivationDistance 10, RequiresLineOfSight false, attribute NpcId)
-- The server never moves an NPC after building it: client/Controllers/NpcController idles them and shows the
-- dialog. The pets are not part of the lobby folder, so the lobby's part budget is unaffected.
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local function optional(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[NpcService] shared module missing: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[NpcService] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local NpcDialog = optional("NpcDialog")
local PetCatalog = optional("PetCatalog")
local PetBuilder = optional("PetBuilder")
local Voxel = optional("Voxel")

local NpcService = {}
NpcService.Talked = Util.Signal()

local FOLDER_NAME = "NimbusNpcs"
local TAG = (NpcDialog and NpcDialog.Tag) or "NC_Npc"
local SETTINGS = (NpcDialog and NpcDialog.Settings) or {}
local NPC_SCALE = tonumber(SETTINGS.Scale) or 2.2
local PROMPT_DISTANCE = tonumber(SETTINGS.PromptDistance) or 10
local HOVER_GAP = tonumber(SETTINGS.HoverGap) or 1.0
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

-- Pedestal geometry (voxel units; one voxel = PV studs, about two pet voxels at Scale 2.2)
local PV = 0.4
local SINK = 0.15 -- the plinth starts slightly below the spot so it never floats over a lower ground tile
local R_BASE, R_DRUM, R_CAP = 10.6, 9.3, 9.8
local Y_BAND, Y_CAP, Y_CUSHION = 2, 4, 5
local PEDESTAL_TOP = (Y_CUSHION + 2) * PV - SINK -- studs above the spot: the cushion's top surface
local MAX_PEDESTAL_PARTS = 120 -- a safety net only: the design merges to about 100 parts

local records = {}
local folder = nil

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Same stone family as the lobby paths (LobbyBuilder palette), so the plinths belong to the plaza.
local STONE = {
	Base = rgb(150, 142, 136),
	Stone = rgb(208, 202, 190),
	Cap = rgb(226, 221, 209),
	Gold = rgb(244, 198, 84),
	Plaque = rgb(246, 234, 210),
	Moss = rgb(108, 180, 86),
	Leaf = rgb(82, 156, 74),
	Petal1 = rgb(246, 150, 188),
	Petal2 = rgb(250, 214, 92),
	Petal3 = rgb(172, 142, 232),
	Petal4 = rgb(244, 244, 248),
}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function toCFrame(value)
	if typeof(value) == "CFrame" then
		return value
	elseif typeof(value) == "Vector3" then
		return CFrame.new(value)
	elseif type(value) == "table" and typeof(value.CFrame) == "CFrame" then
		return value.CFrame
	end
	return nil
end

-- Keeps only the yaw of a spot (NPCs stand upright even if a spot CFrame is tilted).
local function flatten(cf)
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	local pos = cf.Position
	return CFrame.lookAt(pos, pos + flat.Unit)
end

local function lighten(c, t)
	return c:Lerp(Color3.new(1, 1, 1), t)
end

local function darken(c, t)
	return c:Lerp(Color3.fromRGB(26, 30, 52), t)
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(parent, px)
	return make("UICorner", { CornerRadius = UDim.new(0, px) }, parent)
end

local function stroke(parent, color, thickness)
	return make("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- Lowest / highest point and horizontal reach of every part of `model`, relative to `origin`.
local function extents(model, origin)
	local lo, hi, reach = math.huge, -math.huge, 0
	local inv = origin:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local cf = inv * d.CFrame
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
			local s = d.Size
			local hy = (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) / 2
			local hx = (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z) / 2
			local hz = (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z) / 2
			local p = cf.Position
			lo = math.min(lo, p.Y - hy)
			hi = math.max(hi, p.Y + hy)
			reach = math.max(reach, math.abs(p.X) + hx, math.abs(p.Z) + hz)
		end
	end
	if lo == math.huge then
		return nil
	end
	return lo, hi, reach
end

local function countParts(model)
	local n = 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	return n
end

----------------------------------------------------------------------
-- Spots
----------------------------------------------------------------------
-- Ground height under a point (the plaza surface), ignoring the NPC folder.
local function groundY(pos, fallbackY)
	local ok, hit = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		if folder then
			params.FilterDescendantsInstances = { folder }
		end
		return Workspace:Raycast(Vector3.new(pos.X, fallbackY + 30, pos.Z), Vector3.new(0, -60, 0), params)
	end)
	if ok and hit and hit.Position and math.abs(hit.Position.Y - fallbackY) <= 4 then
		return hit.Position.Y -- the plaza surface (a hit on a tree or an arch is ignored)
	end
	return fallbackY
end

-- Six points on the plaza lawn (radius 58): two between the portal walkways, four towards the shop island.
function NpcService.FallbackSpots(lobbyInfo, count)
	count = tonumber(count) or 6
	local lobby = Config.Lobby or {}
	local origin = lobby.Origin or Vector3.new(0, 300, 0)
	local shop = lobby.ShopOffset or Vector3.new(0, 0, -150)
	local shopAngle = math.deg(math.atan2(shop.Z, shop.X))
	local angles = { 22.5, 157.5, shopAngle - 30, shopAngle + 30, shopAngle - 60, shopAngle + 60 }
	local radius = math.min(58, (lobby.PlazaRadius or 110) * 0.53)
	local spots = {}
	for i = 1, count do
		local a = math.rad(angles[(i - 1) % #angles + 1] + math.floor((i - 1) / #angles) * 11)
		local pos = Vector3.new(origin.X + math.cos(a) * radius, origin.Y, origin.Z + math.sin(a) * radius)
		pos = Vector3.new(pos.X, groundY(pos, origin.Y), pos.Z)
		spots[i] = CFrame.lookAt(pos, Vector3.new(origin.X, pos.Y, origin.Z))
	end
	return spots
end

local function resolveSpots(lobbyInfo, count)
	local spots = {}
	local given = type(lobbyInfo) == "table" and lobbyInfo.NpcSpots or nil
	if type(given) == "table" then
		for i = 1, count do
			local cf = toCFrame(given[i])
			if cf then
				spots[i] = flatten(cf)
			end
		end
	end
	local fallback = nil
	for i = 1, count do
		if not spots[i] then
			fallback = fallback or NpcService.FallbackSpots(lobbyInfo, count)
			spots[i] = fallback[i]
		end
	end
	return spots
end

----------------------------------------------------------------------
-- Pedestal (sculpted voxel plinth)
----------------------------------------------------------------------
local function disc(g, r, y, key, test)
	local ri = math.ceil(r)
	local r2 = r * r
	for x = -ri, ri do
		for z = -ri, ri do
			local d2 = x * x + z * z
			if d2 <= r2 then
				local k = key
				if test then
					k = test(x, z, math.sqrt(d2))
				end
				if k then
					Voxel.Set(g, x, y, z, k)
				end
			end
		end
	end
end

local function pedestalPalette(accent)
	local pal = {}
	for k, v in pairs(STONE) do
		pal[k] = v
	end
	pal.Trim = darken(accent, 0.3)
	pal.Rug = darken(accent, 0.12)
	pal.RugTop = accent
	pal.RugTrim = lighten(accent, 0.42)
	pal.RugCenter = rgb(250, 224, 146)
	pal.Gold = { Color = STONE.Gold, Material = Enum.Material.SmoothPlastic, Reflectance = 0.05 }
	return pal
end

-- Voxel position on a circle (rounded to the grid).
local function onCircle(deg, r)
	local a = math.rad(deg)
	return math.floor(math.cos(a) * r + 0.5), math.floor(math.sin(a) * r + 0.5)
end

-- A plinth with a classic profile, its stone in three shades by height (dark foot, mid drum, pale cap):
-- foot, drum with a tile band in the accent colour + gold rivets + a gold-framed plaque at the front, an
-- overhanging cap with moss clumps, and a plump square cushion with a trim border, a gold medallion and tassels.
-- Whole flat layers keep the greedy merge cheap (about 100 parts), so no colour ever gets lost to the LOD.
local function sculptPedestal(seed)
	local g = Voxel.NewGrid(8)
	disc(g, R_BASE, 0, "Base")
	disc(g, R_DRUM, 1, "Stone")
	disc(g, R_DRUM, Y_BAND, "Trim")
	disc(g, R_DRUM, 3, "Stone")
	disc(g, R_CAP, Y_CAP, "Cap")

	-- gold rivets standing out of the band every 45 degrees (the front one gives way to the plaque)
	for i = 0, 7 do
		local deg = i * 45
		if deg ~= 270 then
			local x, z = onCircle(deg, R_DRUM + 0.9)
			Voxel.Set(g, x, Y_BAND, z, "Gold")
		end
	end

	-- plaque on the front (the pet faces -Z): a flat gold frame around a recessed cream plate
	local zFront = -math.floor(R_DRUM)
	for x = -3, 3 do
		for y = 1, 3 do
			if math.abs(x) == 3 or y ~= Y_BAND then
				Voxel.Set(g, x, y, zFront, "Gold")
			else
				Voxel.Set(g, x, y, zFront, nil)
				Voxel.Set(g, x, y, zFront + 1, "Plaque")
			end
		end
	end

	-- small moss clumps creeping over the cap rim: back and sides only, placement varies per NPC
	local clumps = { 30 + (seed * 17) % 120, 160 + (seed * 29) % 60, 330 + (seed * 13) % 40 }
	for _, deg in ipairs(clumps) do
		for k = -1, 1 do
			local x, z = onCircle(deg + k * 6, R_CAP - 0.4)
			Voxel.Set(g, x, Y_CAP, z, "Moss")
		end
		local ox, oz = onCircle(deg, R_CAP + 0.4)
		Voxel.Set(g, ox, Y_CAP - 1, oz, "Moss_Dark") -- a drip hanging over the edge
		local ix, iz = onCircle(deg + 3, R_CAP - 1.4)
		Voxel.Set(g, ix, Y_CAP + 1, iz, "Moss_Light") -- a tuft on top
	end

	-- cushion: side band, lighter top with a trim border, gold medallion, gold corner tassels
	local half = 6
	for x = -half, half do
		for z = -half, half do
			if math.abs(x) + math.abs(z) < 2 * half - 1 then -- clipped corners
				Voxel.Set(g, x, Y_CUSHION, z, "Rug")
			end
			local ax, az = math.abs(x), math.abs(z)
			if ax <= half - 1 and az <= half - 1 and ax + az < 2 * half - 3 then
				local key = "RugTop"
				if ax == half - 1 or az == half - 1 or ax + az == 2 * half - 4 then
					key = "RugTrim"
				elseif ax + az <= 2 then
					key = "RugCenter"
				end
				Voxel.Set(g, x, Y_CUSHION + 1, z, key)
			end
		end
	end
	for _, c in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
		Voxel.Set(g, c[1] * (half - 1), Y_CUSHION, c[2] * (half - 1), "Gold")
		Voxel.Set(g, c[1] * half, Y_CUSHION, c[2] * (half - 1), "Gold")
		Voxel.Set(g, c[1] * (half - 1), Y_CUSHION, c[2] * half, "Gold")
	end

	-- little flowers on the foot step: a leaf and a petal each
	for i, deg in ipairs({ 40 + seed * 11, 140 + seed * 7, 235 - seed * 13, 300 + seed * 5 }) do
		local x, z = onCircle(deg, R_BASE - 0.5)
		if Voxel.Get(g, x, 0, z) ~= nil and Voxel.Get(g, x, 1, z) == nil then
			Voxel.Set(g, x, 1, z, "Leaf")
			Voxel.Set(g, x, 2, z, "Petal" .. ((i + seed) % 4 + 1))
		end
	end
	return g
end

-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7): the Part pedestal stays (the fallback; the Collider is separate) and
-- is tagged for the Blender mesh npc_pedestal (one design; the rug / trim follow the NPC accent through ML_Primary).
-- Clients dress it (MeshLibrary.Dress). Only once the key has an uploaded id: with an empty MeshIds nothing changes.
local PEDESTAL_KEY = "npc_pedestal"
local meshLib = nil
local function meshLibrary()
	if meshLib == nil then
		meshLib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				meshLib = result
			end
		end
	end
	return meshLib or nil
end

local function tagPedestal(model, origin, accent)
	local ML = meshLibrary()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, PEDESTAL_KEY)
	if not okStatus or st == "missing" then
		return false
	end
	ML.Tag(model, PEDESTAL_KEY, { Primary = accent, Offset = model:GetPivot():Inverse() * origin })
	return true
end

local function buildPedestal(parent, spot, accent, seed)
	if not Voxel then
		-- no voxel kit: a plain two-tier plinth so the NPC still stands somewhere
		local m = make("Model", { Name = "Pedestal" }, nil)
		make("Part", {
			Name = "Base", Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false,
			Shape = Enum.PartType.Cylinder, Material = Enum.Material.SmoothPlastic, Color = STONE.Stone,
			Size = Vector3.new(PEDESTAL_TOP + SINK, R_DRUM * PV * 2, R_DRUM * PV * 2),
			CFrame = spot * CFrame.new(0, (PEDESTAL_TOP - SINK) / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
		}, m)
		m.Parent = parent
		return m
	end
	local g = sculptPedestal(seed)
	local origin = spot * CFrame.new(0, PV / 2 - SINK, 0) -- where grid voxel (0, 0, 0) sits = the mesh pivot
	local model = Voxel.Build(g, {
		VoxelSize = PV,
		Palette = pedestalPalette(accent),
		Name = "Pedestal",
		CFrame = spot * CFrame.new(0, PV / 2 - SINK, 0),
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		MaxParts = MAX_PEDESTAL_PARTS,
		Keep = { "Gold", "Trim", "Rug", "RugTop", "RugTrim", "RugCenter", "Plaque" },
		PrimaryKey = "Stone",
	})
	tagPedestal(model, origin, accent)
	model.Parent = parent
	return model
end

-- tests (tools/smoke_p6_creatures.lua): build one pedestal (Model "Pedestal") under `parent` at `spot`, tagged for
-- the mesh exactly like the NPCs' own. Returns the model.
function NpcService._BuildPedestal(parent, spot, accent, seed)
	return buildPedestal(parent, spot, accent, seed)
end

-- Phase 6 kit hook (read-only, never called by the game): the pedestal design for blender/kit/props/creatures.py
-- (key npc_pedestal): the voxel grid of seed `seed`, its palette for `accent`, and the layout numbers.
function NpcService._Blueprint(seed, accent)
	if not Voxel then
		return nil
	end
	accent = typeof(accent) == "Color3" and accent or rgb(120, 180, 236)
	return {
		Grid = sculptPedestal(tonumber(seed) or 1),
		Palette = pedestalPalette(accent),
		PV = PV,
		Sink = SINK,
		Top = PEDESTAL_TOP,
		Accent = accent,
		Keep = { "Gold", "Trim", "Rug", "RugTop", "RugTrim", "RugCenter", "Plaque" },
	}
end

----------------------------------------------------------------------
-- Nameplate
----------------------------------------------------------------------
-- World text rule (ARCHITECTURE_V3.md): a PIXEL-sized tag (constant on-screen size), the name >= 22 px and the
-- title >= 18 px at 1080p with FIXED text sizes (never TextScaled), outlined glyphs on compact solid pills that
-- size themselves to their text. The transparent Plate is the 1080p design box; NpcController scales the tag
-- and Plate (UIScale "ReadScale") with the screen-height factor (attributes BaseWidth / BaseHeight).
local PLATE_W, PLATE_H = 300, 96
local NAME_PX = 28
local TITLE_PX = 19
local INK = Theme.Colors.TextStroke or Theme.Colors.Ink

-- A rounded pill that the engine sizes to its (fixed-size, outlined) text, so no name is ever truncated whatever
-- the real glyph widths: the label carries the padding (its own UIPadding) and grows with AutomaticSize X from a
-- minimum width of minW (the text stays centred), and the pill wraps the label. No list layout, so the corner
-- badge can live on the pill; `extraRight` keeps room for it. Returns pill, label.
local function textPill(parent, name, text, role, size, padX, height, minW, thickness, extraRight)
	local frame = make("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(0, height),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Theme.Colors.White,
		BorderSizePixel = 0,
	}, parent)
	local label = Theme.Label(text, role, {
		Size = size,
		Stroke = 1, -- the glyph outline replaces the classic stroke
		Outline = thickness,
		OutlineColor = INK,
		Props = {
			Name = (name == "NamePill") and "Name" or "Title",
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(minW, height),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
		},
	})
	make("UIPadding", {
		PaddingLeft = UDim.new(0, padX + thickness),
		PaddingRight = UDim.new(0, padX + thickness + (extraRight or 0)),
	}, label)
	label.Parent = frame
	return frame, label
end

local function buildNameplate(parent, def, accent, offsetY)
	local gui = make("BillboardGui", {
		Name = "Nameplate",
		Size = UDim2.fromOffset(PLATE_W, PLATE_H),
		SizeOffset = Vector2.new(0, 0.5), -- the bottom edge sits offsetY studs over the pet's head
		StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0),
		AlwaysOnTop = false,
		MaxDistance = 85,
		LightInfluence = 0,
		ClipsDescendants = false,
	}, nil)
	gui:SetAttribute("BaseWidth", PLATE_W)
	gui:SetAttribute("BaseHeight", PLATE_H)

	local plate = make("Frame", {
		Name = "Plate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 1),
		Size = UDim2.fromOffset(PLATE_W, PLATE_H),
		BackgroundTransparency = 1,
	}, gui)

	-- title pill in the accent colour at the bottom; the name pill sits on it (4 px tucked behind)
	local titleH = TITLE_PX + 10
	local titlePill, title = textPill(plate, "TitlePill", def.Title or "Lobby Friend", "Label", TITLE_PX, 12, titleH, 110, 2)
	titlePill.Position = UDim2.new(0.5, 0, 1, 0)
	titlePill.BackgroundColor3 = darken(accent, 0.3)
	titlePill.ZIndex = 2
	title.ZIndex = 2
	corner(titlePill, 12)
	stroke(titlePill, Theme.Colors.Navy or Theme.Colors.Ink, 2.5)

	-- name pill: dark navy card, accent outline, big outlined name
	local namePill = textPill(plate, "NamePill", def.Name or "Friend", "Title", NAME_PX, 16, NAME_PX + 18, 150, 2.5, 10)
	namePill.Position = UDim2.new(0.5, 0, 1, -(titleH - 4))
	corner(namePill, 16)
	stroke(namePill, accent, 3.5)
	Theme.Gradient(namePill, Theme.Colors.PanelLight, Theme.Colors.Panel, 90)

	-- "!" badge on the name pill's corner: new tips here (the client hides it once the player has talked to this NPC)
	local badge = make("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = Theme.Colors.Gold or STONE.Gold,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, namePill)
	corner(badge, 16)
	stroke(badge, Theme.Colors.Navy or Theme.Colors.Ink, 3)
	local mark = Theme.Label("!", "Accent", {
		Size = 26,
		Stroke = 1,
		Outline = 2,
		OutlineColor = INK,
		Props = { Name = "Mark", Size = UDim2.fromScale(1, 1), ZIndex = 4 },
	})
	mark.Parent = badge

	gui.Parent = parent
	return gui
end

----------------------------------------------------------------------
-- One NPC
----------------------------------------------------------------------
local function catalogPet(def)
	if not PetCatalog or type(PetCatalog.Get) ~= "function" then
		return nil
	end
	local pet = PetCatalog.Get(def.PetId)
	if pet then
		return pet
	end
	-- the id vanished from the catalog: borrow another pet of the same species (or any pet)
	local list = PetCatalog.Pets or {}
	for _, p in ipairs(list) do
		if type(p) == "table" and type(p.Look) == "table" and p.Look.Species == def.Species then
			return p
		end
	end
	return list[1]
end

local function buildNpc(def, spot, index, detached)
	local accent = typeof(def.Accent) == "Color3" and def.Accent or rgb(120, 180, 236)
	local model = make("Model", { Name = "Npc_" .. tostring(def.Id) }, nil)
	model:SetAttribute("NpcId", def.Id)
	model:SetAttribute("NpcName", def.Name or def.Id)
	model:SetAttribute("Title", def.Title or "")
	model:SetAttribute("Accent", accent)

	local okPed, errPed = pcall(buildPedestal, model, spot, accent, index)
	if not okPed then
		warn("[NpcService] pedestal of " .. tostring(def.Id) .. " failed: " .. tostring(errPed))
	end

	-- the pet, hovering HOVER_GAP above the rug, facing the walkway (pets face -Z = the spot's LookVector)
	local petDef = catalogPet(def)
	local pet = nil
	local centerY = PEDESTAL_TOP + 3.2
	local topY = PEDESTAL_TOP + 6.4
	local reach = 3
	if petDef and PetBuilder and type(PetBuilder.Build) == "function" then
		local ok, built = pcall(PetBuilder.Build, petDef, { Scale = def.Scale or NPC_SCALE, Detail = "High" })
		if ok and typeof(built) == "Instance" then
			pet = built
			pet.Name = "Pet"
			local origin = CFrame.new()
			pet:PivotTo(origin)
			local lo, hi, r = extents(pet, origin)
			if lo then
				local pivotY = PEDESTAL_TOP + HOVER_GAP - lo
				centerY = pivotY
				topY = pivotY + hi
				reach = r
			end
			pet:PivotTo(spot * CFrame.new(0, centerY, 0))
			pet.Parent = model
			model:SetAttribute("PetId", petDef.Id)
			model:SetAttribute("PetParts", countParts(pet))
		else
			warn("[NpcService] PetBuilder.Build failed for " .. tostring(def.Id) .. ": " .. tostring(built))
		end
	end

	-- one invisible collider: players walk around the NPC instead of into it
	local colliderH = topY + SINK + 0.3
	local colliderR = math.max(R_DRUM * PV + 0.15, math.min(reach * 0.75, R_CAP * PV))
	make("Part", {
		Name = "Collider",
		Anchored = true,
		CanCollide = true,
		CanTouch = false,
		Transparency = 1,
		CastShadow = false,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(colliderH, colliderR * 2, colliderR * 2),
		CFrame = spot * CFrame.new(0, colliderH / 2 - SINK, 0) * CFrame.Angles(0, 0, math.rad(90)),
	}, model)

	-- prompt + nameplate + light + sparkles live on an invisible part at the pet's centre
	local promptPart = make("Part", {
		Name = "PromptPart",
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		CastShadow = false,
		Size = Vector3.new(1, 1, 1),
		CFrame = spot * CFrame.new(0, centerY, 0),
	}, model)
	local prompt = make("ProximityPrompt", {
		Name = "TalkPrompt",
		ActionText = "Talk",
		ObjectText = def.Name or "Friend",
		HoldDuration = 0,
		MaxActivationDistance = PROMPT_DISTANCE,
		RequiresLineOfSight = false,
	}, nil)
	prompt:SetAttribute("NpcId", def.Id)
	-- the prompt pops up at the front of the cushion, so its key hint never covers the pet's face
	local anchor = make("Attachment", {
		Name = "PromptAnchor",
		CFrame = promptPart.CFrame:Inverse() * (spot * CFrame.new(0, PEDESTAL_TOP + 0.9, -(R_CAP * PV - 0.6))),
	}, promptPart)
	prompt.Parent = anchor
	buildNameplate(promptPart, def, accent, topY - centerY + 0.9)

	make("PointLight", {
		Name = "Glow",
		Color = lighten(accent, 0.45),
		Brightness = 0.6,
		Range = 11,
		Shadows = false,
	}, promptPart)

	local rugAttachment = make("Attachment", {
		Name = "RugSparkles",
		CFrame = promptPart.CFrame:Inverse() * (spot * CFrame.new(0, PEDESTAL_TOP + 0.1, 0)),
	}, promptPart)
	make("ParticleEmitter", {
		Name = "Sparkles",
		Texture = SPARKLES,
		Color = ColorSequence.new(lighten(accent, 0.55), rgb(255, 236, 170)),
		LightEmission = 0.7,
		LightInfluence = 0,
		Rate = 2.2,
		Lifetime = NumberRange.new(1.6, 2.6),
		Speed = NumberRange.new(0.6, 1.3),
		SpreadAngle = Vector2.new(35, 35),
		EmissionDirection = Enum.NormalId.Top,
		Rotation = NumberRange.new(0, 360),
		RotSpeed = NumberRange.new(-60, 60),
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, 0.32),
			NumberSequenceKeypoint.new(1, 0),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
	}, rugAttachment)

	if pet and pet.PrimaryPart then
		model.PrimaryPart = pet.PrimaryPart
	else
		model.PrimaryPart = promptPart
	end

	prompt.Triggered:Connect(function(player)
		NpcService.Talked:Fire(player, def.Id)
	end)

	CollectionService:AddTag(model, TAG)
	model:SetAttribute("Ready", true)
	if not detached then
		model.Parent = folder -- parented last: the whole NPC replicates in one step
	end
	return {
		Id = def.Id,
		Name = def.Name,
		Model = model,
		Pet = pet,
		Prompt = prompt,
		Spot = spot,
	}
end

-- Phase 6: the NPCs are built at boot, usually before MeshLibrary has loaded the pet keys. Once they are ready the
-- whole NPC is rebuilt in place with the Blender mesh pet (MeshLibrary.Swap: same name and folder; the clients'
-- NpcController sets the new model up like any NPC) and the record takes the new instances. Empty MeshIds = nothing.
local function watchMeshPet(rec, def, spot, index)
	local petDef = catalogPet(def)
	if not rec.Pet or not petDef or not PetBuilder or type(PetBuilder.SwapWhenReady) ~= "function" then
		return
	end
	local built = nil
	pcall(PetBuilder.SwapWhenReady, rec.Model, petDef, { Scale = def.Scale or NPC_SCALE, Detail = "High" }, function()
		built = buildNpc(def, spot, index, true)
		return built and built.Model or nil
	end, function(fresh)
		if built and built.Model == fresh then
			for k, v in pairs(built) do
				rec[k] = v
			end
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function NpcService.Init(lobbyInfo, deps)
	local _ = deps
	if not NpcDialog or type(NpcDialog.Npcs) ~= "table" then
		warn("[NpcService] shared/NpcDialog is unavailable: no NPCs")
		return {}
	end
	local old = Workspace:FindFirstChild(FOLDER_NAME)
	if old then
		old:Destroy()
	end
	records = {}
	folder = make("Folder", { Name = FOLDER_NAME }, Workspace)

	local list = NpcDialog.Npcs
	local spots = resolveSpots(lobbyInfo, #list)
	for i, def in ipairs(list) do
		if type(def) == "table" and type(def.Id) == "string" and spots[i] then
			local ok, rec = pcall(buildNpc, def, spots[i], i)
			if ok and rec then
				records[#records + 1] = rec
				watchMeshPet(rec, def, spots[i], i)
			else
				warn("[NpcService] NPC " .. tostring(def.Id) .. " failed: " .. tostring(rec))
			end
		end
	end
	return NpcService.GetNpcs()
end

function NpcService.GetNpcs()
	local out = {}
	for i, rec in ipairs(records) do
		out[i] = rec
	end
	return out
end

function NpcService.GetNpc(id)
	for _, rec in ipairs(records) do
		if rec.Id == id then
			return rec
		end
	end
	return nil
end

return NpcService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="854">
          <Properties>
            <string name="Name">PetCareService</string>
            <string name="Source"><![CDATA[-- PetCareService (Phase 4, care): the Food Machine, EVOLVE and the Training Place (ARCHITECTURE_V3.md "Phase 4 build
-- contract" 3.4-3.7, 5.1-5.4). The Phase 2 Kitchen (cooking queue) and Gym (passive XP) that lived in this file are
-- gone: "Cook" / "GymSet" requests answer one toast that says where the feature went.
--
-- * Food Machine (station id Kitchen; Phase 5 contract 3.4): Feed(key) = exactly ONE machine feed paid in berries:
--   TycoonCatalog.FeedBerries(def, level) berries (= the Phase 4 FeedPrice: 1 berry = $1 of food) for
--   TycoonCatalog.FeedXp(level, machineLevel) XP (25-50% of the bar). Checks in order (each a toast, nothing moves
--   before the last): loaded and not provisional; owned; below the cap (PetCatalog.LevelCap: 100); not in a running
--   battle or dungeon run (BattleService.KeysInBattle); the Food Machine built ("Build the Food Machine at home
--   first"); berries >= the cost ("Not enough berries: a feed needs 340 (you have 120). Your garden pets grow more!").
--   Then ONE non-yielding step: DataService.SpendBerries, grantXp; an XP write of 0 refunds the berries in the same
--   step. A { Count } / { Food } / string second argument from an old client is ignored (one feed). The old Food
--   items were converted into berries once by DataService's P5Home step: there is no leftover path and no Cash path.
--   ONE toast per XP grant (a feed, a fight), never one per level: a level-up toast shows the new stats and "Ready to
--   evolve!" at 20 / 50 (PetCatalog.CanEvolve).
-- * EVOLVE: Evolve(key): owned, loaded and not provisional, level >= the next threshold (PetCatalog.EvolutionLevels
--   20 / 50), stage < PetCatalog.MaxEvolution(def) (Common / Uncommon / Rare once, Epic and rarer twice), not in a
--   running battle or ring run. Writes the stored stage (DataService.SetEvolution, only up), fires Evolved, toasts
--   "<Pet> evolved! +25% to everything", refreshes the EquippedInfo attribute (PetService.Refresh) and sends
--   OpenPanel("Evolve", { Key, Stage }) to that client only. Free. A training pet may evolve. The toast reads
--   "<Pet> evolved! Level bonus x1.5!" / "x1.875!" (PetCatalog.EvolutionBonusOf, Phase 5 3.1).
-- * Training Place (station id Gym): Train(key, stat) with stat Speed | Physique | Ability | Defense: needs the
--   station (TycoonCatalog.TrainingSlots(home) >= 1) and a free mat, an owned pet that is not training, a rank below
--   10, no running battle, TycoonCatalog.TrainCost(def, rank) Cash; rank r takes TycoonCatalog.TrainSeconds(r)
--   (r minutes). The Cash and the job (PetGrowth[key].Job = { Stat, Ends = os.time() + seconds, Rank = rank + 1, Slot =
--   mat, From, Paid }, DataService.MutateGrowth) are one step; a failed job write gives the Cash back. Starting takes
--   the pet off the player (PetService.UnequipKey, every copy) and out of the Garden (TycoonService.GardenSet) by
--   itself and remembers where it was in Job.From ("Garden:<slot>" wins over "Follow", else "Free"). The lock is
--   DataService.TrainingKeys (PetService.Equip, GardenSet, Fusion, teams and the ring read it). Completion is decided
--   from os.time() >= Job.Ends by the 1 s tick and on profile load / rebase (provisional saves wait): the rank is a
--   TARGET value (two servers completing one job give one rank), the pet goes back by itself ("Follow" -> re-equipped
--   when a slot is free; "Garden:n" -> that place when open and empty, else the first free open place, else it stays
--   in the list), TrainingDone fires. TrainStop(key) removes the job and refunds Job.Paid in the same step (a job
--   that is already due finishes instead). Running jobs survive a Prestige. Toasts: "Rocky started Physique training
--   (4:00)", "Rocky finished Physique training: Rank 3!", "Training done while you were away! ..." on load.
-- * Home.Gym is retired: on every home load (ProfileLoaded / ProfileRebased, or the first readable tick) the old Gym
--   slots are emptied (old Gym pets come back to the list) with one toast per session, also when DataService's
--   one-time Phase 4 migration emptied them (DataService.MigratedNow(player, "P4").GymPets).
-- * Prompts (owner only, HomeFx hides them from visitors): FeedPrompt "Feed pets" on the Food Machine's Hopper part
--   (its biggest part while HomeBuilder has no Hopper yet) -> OpenPanel("Pets", { Action = "Feed" }); TrainPrompt
--   "Train pets" on Station_Gym -> OpenPanel("Train"). Rebuilt when the station is rebuilt (the CareSig attribute
--   carries a "p5:" marker so stale prompts of a Phase 3 / Phase 4 server never survive: the stations swapped slots).
-- * Replication: the plot folder attribute TrainingPets = "1=cat:Physique:1760000000;2=fox@Golden:Speed:1760000420"
--   (mat=key:stat:Ends, written only on change; a hybrid key holds ":" itself, so readers split from the right) and
--   HomeBuilder.SetTraining(spotInfo, { [mat] = { Key, Stat, Ends } }) when HomeBuilder has such a function. Levels,
--   growth and food reach the owner through ProfileSync (DataService).
-- * Remote PetCare(action, a, b): "Feed" (key; b ignored), "Evolve" (key), "Train" (key, stat), "TrainStop" (key); "Cook" /
--   "GymSet" are retired (one toast). Types, lengths, ranges and NaN are checked; every action has a cooldown plus a
--   shared per-player burst budget; refusals answer with a side toast (repeated texts are throttled). Nothing here
--   moves parts (Replication rule).
--
-- Public API (the contract): Init(deps)   deps = { DataService, PetService, TycoonService, BattleService }
--   Feed(player, key) -> ok, { Xp, Levels, Level, Cap, Berries, Cost } | reason
--   Evolve(player, key) -> ok, stage | reason
--   Train(player, key, stat) -> ok, { Rank, Ends, Cost, Slot, From } | reason
--   TrainStop(player, key) -> ok, refund | reason
--   GrantXp(player, key, xp, source) -> xpGiven, levelsGained, reason   (cap-aware XP for other services, one toast)
--   LevelCap(player, key) -> n | nil          ClearSessions(player) -> true   (developer reset)
--   Signals Fed(player, key, "Berries", levelsGained), LevelUp(player, key, level,
--   source), Evolved(player, key, stage), TrainingStarted(player, key, stat), TrainingDone(player, key, stat, rank)
--
-- Every Phase 4 helper lives in the table `Care` (Lua's 200-local limit). Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local PetCareService = {}
PetCareService.Fed = Util.Signal() -- Fire(player, key, "Berries", levelsGained)
PetCareService.LevelUp = Util.Signal() -- Fire(player, key, newLevel, source)  source "Feed" | "Trial" | "Ring" | GrantXp's
PetCareService.Evolved = Util.Signal() -- Fire(player, key, stage)
PetCareService.TrainingStarted = Util.Signal() -- Fire(player, key, stat)
PetCareService.TrainingDone = Util.Signal() -- Fire(player, key, stat, rank)

local TICK = 1 -- seconds between training ticks (completions, prompts, the TrainingPets attribute)
local FEED_COOLDOWN = 0.1
local EVOLVE_COOLDOWN = 1
local TRAIN_COOLDOWN = 0.25
local PROMPT_COOLDOWN = 0.35
local BURST_SIZE = 12 -- PetCare requests a player may send at once...
local BURST_REFILL = 6 -- ...refilled at this many per second
local TOAST_GAP = 1.5 -- the same refusal text is not repeated within this many seconds
local LOAD_TOAST_DELAY = 3 -- seconds after a player's session starts before the load toasts show (the client is ready)
local MAX_TOAST_CHARS = 90 -- NotifyController shows up to 90 characters
local MAX_NAME_CHARS = 28 -- "Rainbow Starlight Unicorn" fits; the longest toast stays under 90 characters
local MAX_ACTION_LENGTH = 16
local MAX_ID_LENGTH = 48
local MAX_STAT_LENGTH = 24
local MAX_TRAIN_SLOTS = 5 -- Training Place mats (DataService P4.MAX_JOB_SLOT)
local FALLBACK_MAX_RANK = 10
local PROMPT_RANGE = 10
local PROMPT_HOLD = 0.3
local FALLBACK_LEVEL_CAPS = { Common = 100, Uncommon = 100, Rare = 100, Epic = 100, Legendary = 100, Mythic = 100, Secret = 100 }
local FALLBACK_MAX_LEVEL = 100
local PROMPT_KEYS = { Keyboard = Enum.KeyCode.E, Gamepad = Enum.KeyCode.ButtonX }
local ATTR_TRAINING = "TrainingPets"
local ATTR_IN_BATTLE = Config.Attr.InBattle or "InBattle"
local CARE_SIG = "CareSig" -- attribute on a station model: which prompts this service built on it
local CARE_MARK = "CareMade" -- attribute on every prompt this service made
local SIG_PREFIX = "p5:" -- stale Phase 3 / Phase 4 prompts (other signatures) never match a Phase 5 signature (the stations moved)
local LOADING = "Your save is still loading, try again in a moment"
local STATS = { "Speed", "Physique", "Ability", "Defense" }
local STAT_LABELS = { Speed = "Attack Speed", Physique = "Physique", Ability = "Ability", Defense = "Defense" }
local STAT_BY_NAME = { speed = "Speed", attackspeed = "Speed", physique = "Physique", ability = "Ability", defense = "Defense", defence = "Defense" }

local initialized = false
local running = false
local dataService = nil
local petService = nil
local tycoonService = nil
local battleService = nil
local catalog = nil -- TycoonCatalog
local petKeys = nil -- PetKeys (optional)
local petCatalog = nil -- PetCatalog (optional)
local homeBuilder = nil -- HomeBuilder (optional: GetStation, SetTraining)
local notifyRemote = nil
local openPanelRemote = nil

local Care = {} -- every Phase 4 helper (see the header)
local sessions = {} -- [Player] = { At, Pending = { { Text, Kind, Seconds }... }, Shown = { Folder, Info, Text } | nil, GymChecked, GymToast, MigrationSeen }
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local budgets = {} -- [Player] = { Tokens, At }
local toastAt = {} -- [Player] = { [text] = os.clock() }
local departed = setmetatable({}, { __mode = "k" })

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent ~= nil and not departed[player]
end

local function requireModule(container, name)
	local module = container and container:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[PetCareService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

-- cuts a text to n characters without splitting a UTF-8 character
local function clip(text, n)
	text = tostring(text)
	if #text <= n then
		return text
	end
	local cut = string.sub(text, 1, n - 3)
	cut = string.gsub(cut, "[\192-\255][\128-\191]*$", "")
	return cut .. "..."
end

local function remote(name)
	local ok, r = pcall(Remotes.Get, name)
	if ok then
		return r
	end
	return nil
end

local function notify(player, text, kind, seconds)
	if not isPlayer(player) or type(text) ~= "string" or text == "" then
		return
	end
	notifyRemote = notifyRemote or remote("Notify")
	if notifyRemote then
		pcall(function()
			notifyRemote:FireClient(player, clip(text, MAX_TOAST_CHARS), kind or "info", seconds or 3)
		end)
	end
end

-- A refusal toast; the same text is not repeated within TOAST_GAP (spam clicks stay quiet).
local function toastOnce(player, text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	local map = toastAt[player]
	if not map then
		map = {}
		toastAt[player] = map
	end
	local now = os.clock()
	local last = map[text]
	if last and now - last < TOAST_GAP then
		return
	end
	map[text] = now
	notify(player, text, kind or "bad", 3)
end

-- Per player per key cooldown.
local function cooldown(player, key, seconds)
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	local now = os.clock()
	local last = map[key]
	if last and now - last < seconds then
		return false
	end
	map[key] = now
	return true
end

-- Per player burst budget shared by every PetCare request and care prompt.
local function spend(player)
	local now = os.clock()
	local b = budgets[player]
	if not b then
		b = { Tokens = BURST_SIZE, At = now }
		budgets[player] = b
	end
	b.Tokens = math.min(BURST_SIZE, b.Tokens + (now - b.At) * BURST_REFILL)
	b.At = now
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

local function setAttr(inst, name, value)
	pcall(function()
		if inst:GetAttribute(name) ~= value then
			inst:SetAttribute(name, value)
		end
	end)
end

-- "Snack" -> "Snacks" (n ~= 1)
local function plural(name, n)
	name = tostring(name)
	if n == 1 then
		return name
	end
	return name .. "s"
end

-- 1234 -> "1.2K" (stat numbers in toasts)
local function compact(n)
	n = tonumber(n) or 0
	if not isFinite(n) then
		return "0"
	end
	local a = math.abs(n)
	local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
	for _, u in ipairs(units) do
		if a >= u[1] then
			local x = n / u[1]
			local s
			if math.abs(x) >= 100 then
				s = string.format("%d", math.floor(x))
			else
				s = string.format("%.1f", math.floor(x * 10) / 10)
				s = string.gsub(s, "%.0$", "")
			end
			return s .. u[2]
		end
	end
	return tostring(math.floor(n + 0.5))
end

----------------------------------------------------------------------
-- Data access (DataService; every call guarded)
----------------------------------------------------------------------

local function dsCall(fnName, ...)
	if not dataService or type(dataService[fnName]) ~= "function" then
		return false, nil, nil
	end
	local ok, a, b = pcall(dataService[fnName], ...)
	if not ok then
		warn("[PetCareService] DataService." .. fnName .. " failed: " .. tostring(a))
		return false, nil, nil
	end
	return true, a, b
end

local function getProfile(player)
	local ok, profile = dsCall("GetProfile", player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function getHome(player)
	local ok, home = dsCall("GetHome", player)
	if ok and type(home) == "table" then
		return home
	end
	return nil
end

-- true while the save is a stand-in (DataService refuses XP / growth writes then)
local function isProvisional(player)
	if dataService and type(dataService.IsProvisional) == "function" then
		local ok, result = pcall(dataService.IsProvisional, player)
		return ok and result == true
	end
	return false
end

local function getCash(player)
	local ok, cash = dsCall("GetCash", player)
	if ok and isFinite(cash) and cash > 0 then
		return math.floor(cash)
	end
	return 0
end

local function spendCash(player, n)
	local ok, result = dsCall("SpendCash", player, n)
	return ok and result == true
end

local function addCash(player, n)
	local ok, result = dsCall("AddCash", player, n)
	return ok and result == true
end

local function petLevel(player, key)
	local ok, level, xp = dsCall("GetPetLevel", player, key)
	if not ok or not isFinite(level) or level < 1 then
		level = 1
	end
	if not ok or not isFinite(xp) or xp < 0 then
		xp = 0
	end
	return math.floor(level), xp
end

local function addPetXp(player, key, xp)
	local ok, gained = dsCall("AddPetXp", player, key, xp)
	if ok and isFinite(gained) and gained > 0 then
		return math.floor(gained)
	end
	return 0
end

local function mutateHome(player, fn)
	local ok, result = dsCall("MutateHome", player, fn)
	return ok and result == true
end

----------------------------------------------------------------------
-- Catalog access (TycoonCatalog: the Food Machine, the Training Place, the XP curve)
----------------------------------------------------------------------

local function money(n)
	if catalog and type(catalog.FormatCash) == "function" then
		local ok, text = pcall(catalog.FormatCash, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return "$" .. tostring(math.floor(tonumber(n) or 0))
end

local function stationLevel(home, id)
	if catalog and type(catalog.StationLevel) == "function" then
		local ok, level = pcall(catalog.StationLevel, home, id)
		if ok and isFinite(level) then
			return math.max(0, math.floor(level))
		end
	end
	local v = type(home) == "table" and type(home.Stations) == "table" and home.Stations[id]
	return isFinite(v) and math.max(0, math.floor(v)) or 0
end

-- XP from `level` to level + 1 (the TycoonCatalog curve; DataService's own fallback curve without it)
local function xpToNext(level)
	if catalog and type(catalog.XpToNext) == "function" then
		local ok, need = pcall(catalog.XpToNext, level)
		if ok and type(need) == "number" and need == need and need > 0 then
			return need
		end
	end
	return math.floor(40 * level ^ 1.35 + 0.5)
end

local function maxPetLevel()
	if petCatalog and type(petCatalog.MaxPetLevel) == "function" then
		local ok, n = pcall(petCatalog.MaxPetLevel)
		if ok and isFinite(n) and n >= 1 then
			return math.floor(n)
		end
	end
	if catalog then
		local px = type(catalog.PetXp) == "table" and catalog.PetXp or nil
		for _, v in ipairs({ catalog.MaxPetLevel or false, px and px.MaxLevel or false }) do
			if isFinite(v) and v >= 1 then
				return math.floor(v)
			end
		end
	end
	return FALLBACK_MAX_LEVEL
end

----------------------------------------------------------------------
-- Pets (keys, defs, ownership, levels and caps)
----------------------------------------------------------------------

local function validKeyString(key)
	if type(key) ~= "string" or key == "" or #key > MAX_ID_LENGTH then
		return false
	end
	if petKeys and type(petKeys.Parse) == "function" then
		local ok, parsed = pcall(petKeys.Parse, key)
		return ok and parsed ~= nil
	end
	return string.find(key, "^[%w_%-:@]+$") ~= nil
end

local function defOf(key, profile)
	if not validKeyString(key) then
		return nil
	end
	if petKeys and type(petKeys.DefOf) == "function" then
		local ok, def = pcall(petKeys.DefOf, key, profile)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	if petCatalog and type(petCatalog.Get) == "function" then
		local def = petCatalog.Get(key)
		if type(def) == "table" then
			return def
		end
	end
	return nil
end

local function ownedCount(profile, key)
	if type(profile) ~= "table" or not validKeyString(key) then
		return 0
	end
	if petKeys and type(petKeys.Count) == "function" then
		local ok, n = pcall(petKeys.Count, profile, key)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
		return 0
	end
	local n = type(profile.Pets) == "table" and profile.Pets[key]
	return isFinite(n) and math.max(0, math.floor(n)) or 0
end

local function petName(def, key)
	local name = type(def) == "table" and (def.DisplayName or def.Name) or nil
	if type(name) ~= "string" or name == "" then
		name = tostring(key)
	end
	return clip(name, MAX_NAME_CHARS)
end

-- the level feeding / fights can raise this pet to (PetCatalog.LevelCap: 100 for every rarity, never above the curve)
local function levelCap(def)
	local top = maxPetLevel()
	local cap = nil
	if petCatalog and type(petCatalog.LevelCap) == "function" then
		local ok, n = pcall(petCatalog.LevelCap, def)
		if ok and isFinite(n) then
			cap = n
		end
	end
	if not cap and type(def) == "table" then
		cap = FALLBACK_LEVEL_CAPS[def.Rarity]
	end
	if not isFinite(cap) or cap < 1 then
		return top
	end
	return math.min(math.floor(cap), top)
end

-- XP the pet can still take before it reaches `cap`
local function xpRoom(level, xp, cap)
	if level >= cap then
		return 0
	end
	local total = 0
	for l = level, cap - 1 do
		local need = xpToNext(l)
		if not isFinite(need) then
			break
		end
		total = total + need
	end
	return math.max(0, total - (tonumber(xp) or 0))
end

local function statsOf(def, level)
	if not petCatalog or type(def) ~= "table" then
		return nil
	end
	local fn = petCatalog.StatsOf or petCatalog.GetStats
	if type(fn) ~= "function" then
		return nil
	end
	local ok, stats = pcall(fn, def, level)
	if ok and type(stats) == "table" then
		return stats
	end
	return nil
end

----------------------------------------------------------------------
-- Care helpers: growth, the lock, battles, catalog numbers, texts
----------------------------------------------------------------------

-- { Evo, Speed, Physique, Ability, Defense, Job | nil } (zeros when unknown)
function Care.growth(player, key)
	local ok, g = dsCall("GetGrowth", player, key)
	if ok and type(g) == "table" then
		return g
	end
	local e = { Evo = 0 }
	for _, stat in ipairs(STATS) do
		e[stat] = 0
	end
	return e
end

function Care.growthMap(player)
	local ok, map = dsCall("GetGrowthMap", player)
	if ok and type(map) == "table" then
		return map
	end
	return {}
end

function Care.mutateGrowth(player, fn)
	local ok, result = dsCall("MutateGrowth", player, fn)
	return ok and result == true
end

-- { [key] = true } of the keys in a running battle / ring run of this player, or nil when BattleService has no such
-- function yet (then the whole battle counts: InBattle attribute)
function Care.keysInBattle(player)
	if battleService and type(battleService.KeysInBattle) == "function" then
		local ok, set = pcall(battleService.KeysInBattle, player)
		if ok and type(set) == "table" then
			return set
		end
	end
	return nil
end

function Care.inBattle(player)
	local v = player:GetAttribute(ATTR_IN_BATTLE)
	return v ~= nil and v ~= false
end

function Care.busyInBattle(player, key)
	local set = Care.keysInBattle(player)
	if set then
		return set[key] == true
	end
	return Care.inBattle(player)
end

function Care.statOf(stat)
	if type(stat) ~= "string" or stat == "" or #stat > MAX_STAT_LENGTH then
		return nil
	end
	local s = string.lower((string.gsub(stat, "[%s_%-]", "")))
	return STAT_BY_NAME[s]
end

function Care.statLabel(stat)
	return STAT_LABELS[stat] or tostring(stat)
end

-- 130 -> "2:10", 3600 -> "60:00"
function Care.clock(seconds)
	local s = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

-- "x1.8" / "x19.3" / "x1.2K"
function Care.factorText(n)
	n = tonumber(n) or 0
	if not isFinite(n) or n < 0 then
		n = 0
	end
	if n < 100 then
		local s = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		s = string.gsub(s, "%.0$", "")
		return "x" .. s
	end
	return "x" .. compact(n)
end

function Care.feedXp(level, machineLevel)
	if catalog and type(catalog.FeedXp) == "function" then
		local ok, n = pcall(catalog.FeedXp, level, machineLevel)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return 0
end

function Care.feedPrice(def, level)
	if catalog and type(catalog.FeedPrice) == "function" then
		local ok, n = pcall(catalog.FeedPrice, def, level)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.trainCost(def, rank)
	if catalog and type(catalog.TrainCost) == "function" then
		local ok, n = pcall(catalog.TrainCost, def, rank)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.trainSeconds(rank)
	if catalog and type(catalog.TrainSeconds) == "function" then
		local ok, n = pcall(catalog.TrainSeconds, rank)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return nil
end

function Care.maxRank()
	local t = catalog and type(catalog.Training) == "table" and catalog.Training or nil
	local n = t and t.MaxRank
	if isFinite(n) and n >= 1 then
		return math.floor(n)
	end
	return FALLBACK_MAX_RANK
end

-- pets training at once (the Training Place level; 0 while it is not built)
function Care.trainingSlots(home)
	local n = nil
	if catalog and type(catalog.TrainingSlots) == "function" then
		local ok, v = pcall(catalog.TrainingSlots, home)
		if ok and isFinite(v) then
			n = v
		end
	end
	if n == nil then
		n = stationLevel(home, "Gym")
	end
	return math.max(0, math.min(math.floor(n), MAX_TRAIN_SLOTS))
end

function Care.gardenSlots(home)
	if catalog and type(catalog.GardenSlots) == "function" then
		local ok, n = pcall(catalog.GardenSlots, home)
		if ok and isFinite(n) and n > 0 then
			return math.floor(n)
		end
	end
	return 0
end

-- the next stage the pet may evolve to, or nil
function Care.canEvolve(def, level, stage)
	if petCatalog and type(petCatalog.CanEvolve) == "function" then
		local ok, nextStage = pcall(petCatalog.CanEvolve, def, level, stage)
		if ok and isFinite(nextStage) then
			return math.floor(nextStage)
		end
	end
	return nil
end

function Care.maxEvolution(def)
	if petCatalog and type(petCatalog.MaxEvolution) == "function" then
		local ok, n = pcall(petCatalog.MaxEvolution, def)
		if ok and isFinite(n) then
			return math.floor(n)
		end
	end
	return 1
end

-- "Level bonus x1.5" for stage 1, "x1.875" for stage 2 (PetCatalog.EvolutionBonusOf; contract 3.1)
function Care.boostText(stage)
	local m = 1
	if petCatalog and type(petCatalog.EvolutionBonusOf) == "function" then
		local ok, v = pcall(petCatalog.EvolutionBonusOf, stage)
		if ok and isFinite(v) and v >= 1 then
			m = v
		end
	elseif stage >= 2 then
		m = 1.875
	elseif stage >= 1 then
		m = 1.5
	end
	local text = string.format("%.3f", m):gsub("0+$", ""):gsub("%.$", "")
	return "Level bonus x" .. text
end

-- the garden coin power of a pet (TycoonCatalog.PetPower; stage = the stored evolution stage)
function Care.coinsText(def, level, stage)
	if catalog and type(catalog.PetPower) == "function" then
		local ok, power = pcall(catalog.PetPower, def, level, nil, stage)
		if ok and isFinite(power) and power > 0 then
			return "Coins " .. Care.factorText(power)
		end
	end
	return ""
end

-- "Coins x1.8" (Economy) / "Power 312, Health 1.2K, Speed 98" (Combat)
function Care.statsText(def, level, stage)
	if type(def) ~= "table" then
		return ""
	end
	if def.Role == "Economy" then
		return Care.coinsText(def, level, stage)
	end
	local stats = statsOf(def, level)
	if not stats then
		return ""
	end
	return "Power " .. compact(stats.Power) .. ", Health " .. compact(stats.Health) .. ", Speed " .. compact(stats.Speed)
end

-- ONE level-up toast per XP grant: "Pebble Pup reached Lv 20: Ready to evolve! Power 312, Health 1.2K, Speed 98"
local function levelUpText(def, key, level, cap, stage, ready)
	local text = petName(def, key) .. " reached Lv " .. level
	if level >= cap then
		text = text .. " (max)"
	end
	if ready then
		text = text .. ": Ready to evolve!"
	else
		text = text .. "!"
	end
	local stats = Care.statsText(def, level, stage)
	if stats ~= "" then
		text = text .. " " .. stats
	end
	return text
end

-- PetService republishes EquippedInfo (level:stage per equipped pet) after a level-up / evolution
function Care.refreshInfo(player)
	if petService and type(petService.Refresh) == "function" then
		pcall(petService.Refresh, player)
	end
end

-- Cap-aware XP. Returns xpGiven, levelsGained, reason (nil on success), the new level / XP / cap / def and whether the
-- pet is now ready to evolve.
local function grantXp(player, key, xp, source)
	-- whole XP only: DataService reads XP back as whole points, so a fraction could never be seen to arrive
	xp = isFinite(xp) and math.floor(xp) or 0
	if xp < 1 then
		return 0, 0, "No XP to give"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return 0, 0, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return 0, 0, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return 0, 0, "You do not own that pet"
	end
	local level, have = petLevel(player, key)
	local cap = levelCap(def)
	local room = xpRoom(level, have, cap)
	if room <= 0 then
		return 0, 0, petName(def, key) .. " is at max level (Lv " .. cap .. ")", level, have, cap, def
	end
	local give = math.min(xp, room)
	local gained = addPetXp(player, key, give)
	local level2, have2 = petLevel(player, key)
	if gained == 0 and level2 == level and have2 == have then
		return 0, 0, "That pet cannot gain XP right now", level, have, cap, def
	end
	local stage = Care.growth(player, key).Evo
	local ready = Care.canEvolve(def, level2, stage) ~= nil
	if level2 > level then
		PetCareService.LevelUp:Fire(player, key, level2, source)
		Care.refreshInfo(player)
	end
	return give, math.max(0, level2 - level), nil, level2, have2, cap, def, ready, stage
end

----------------------------------------------------------------------
-- Plots (TycoonService) and station models (HomeBuilder)
----------------------------------------------------------------------

local function plotOf(player)
	if tycoonService and type(tycoonService.GetPlot) == "function" then
		local ok, info = pcall(tycoonService.GetPlot, player)
		if ok and type(info) == "table" then
			return info
		end
	end
	return nil
end

function Care.stationModel(info, id)
	local folder = info and info.Folder
	if typeof(folder) ~= "Instance" then
		return nil
	end
	if homeBuilder and type(homeBuilder.GetStation) == "function" then
		local ok, model = pcall(homeBuilder.GetStation, info, id)
		if ok and typeof(model) == "Instance" and model.Parent and model:IsA("Model") then
			return model
		end
	end
	local homeFolder = folder:FindFirstChild("Home")
	local model = homeFolder and homeFolder:FindFirstChild("Station_" .. id) or nil
	if not model and not homeFolder then
		model = folder:FindFirstChild("Station_" .. id, true)
	end
	if model and model:IsA("Model") then
		return model
	end
	return nil
end

----------------------------------------------------------------------
-- Sessions (per player, this server only), deferred toasts, the TrainingPets attribute
----------------------------------------------------------------------

function Care.session(player)
	local s = sessions[player]
	if not s then
		s = { At = os.clock(), Pending = {}, Shown = nil, GymChecked = false, GymToast = false, MigrationSeen = false }
		sessions[player] = s
	end
	return s
end

-- a toast that waits until the client is surely listening (load toasts: LOAD_TOAST_DELAY after the session started)
function Care.queueToast(player, text, kind, seconds)
	local s = Care.session(player)
	s.Pending[#s.Pending + 1] = { Text = text, Kind = kind, Seconds = seconds }
end

function Care.flushToasts(player, s, now)
	if #s.Pending == 0 or now - s.At < LOAD_TOAST_DELAY then
		return
	end
	local list = s.Pending
	s.Pending = {}
	for _, t in ipairs(list) do
		notify(player, t.Text, t.Kind, t.Seconds)
	end
end

function Care.clearShown(player)
	local s = sessions[player]
	local shown = s and s.Shown
	if not shown then
		return
	end
	s.Shown = nil
	if typeof(shown.Folder) == "Instance" then
		setAttr(shown.Folder, ATTR_TRAINING, nil)
		if shown.Info and homeBuilder and type(homeBuilder.SetTraining) == "function" then
			pcall(homeBuilder.SetTraining, shown.Info, {})
		end
	end
end

-- TrainingPets on the plot folder (+ HomeBuilder.SetTraining when it exists), written only when it changes
function Care.publishTraining(player, map)
	local s = Care.session(player)
	local info = plotOf(player)
	local folder = info and info.Folder
	if typeof(folder) ~= "Instance" then
		Care.clearShown(player)
		return
	end
	if s.Shown and s.Shown.Folder ~= folder then
		Care.clearShown(player)
	end
	map = map or Care.growthMap(player)
	local rows = {}
	for key, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" then
			local slot = isFinite(job.Slot) and math.floor(job.Slot) or 0
			rows[#rows + 1] = { Slot = slot, Key = key, Job = job, Text = tostring(slot) .. "=" .. key .. ":" .. tostring(job.Stat) .. ":" .. tostring(math.floor(tonumber(job.Ends) or 0)) }
		end
	end
	table.sort(rows, function(a, b)
		if a.Slot == b.Slot then
			return a.Key < b.Key
		end
		return a.Slot < b.Slot
	end)
	local parts = {}
	for i, r in ipairs(rows) do
		parts[i] = r.Text
	end
	local text = table.concat(parts, ";")
	if s.Shown and s.Shown.Folder == folder and s.Shown.Text == text then
		return
	end
	s.Shown = { Folder = folder, Info = info, Text = text }
	setAttr(folder, ATTR_TRAINING, text)
	if homeBuilder and type(homeBuilder.SetTraining) == "function" then
		local pets = {}
		for _, r in ipairs(rows) do
			pets[r.Slot] = { Key = r.Key, Stat = r.Job.Stat, Ends = r.Job.Ends }
		end
		local ok, err = pcall(homeBuilder.SetTraining, info, pets)
		if not ok then
			warn("[PetCareService] HomeBuilder.SetTraining failed: " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- Feeding (the Food Machine: ONE feed, paid in berries; Phase 5 3.4)
----------------------------------------------------------------------

-- whole berries owned (0 before the load)
function Care.berries(player)
	local ok, n = dsCall("GetBerries", player)
	if ok and isFinite(n) and n > 0 then
		return math.floor(n)
	end
	return 0
end

-- berries of one feed of `def` at `level` (TycoonCatalog.FeedBerries = the Phase 4 FeedPrice: 1 berry = $1 of food)
function Care.feedBerries(def, level)
	if catalog and type(catalog.FeedBerries) == "function" then
		local ok, n = pcall(catalog.FeedBerries, def, level)
		if ok and isFinite(n) and n >= 0 then
			return math.floor(n)
		end
	end
	return Care.feedPrice(def, level)
end

-- Feed(player, key): exactly one Food Machine feed for FeedBerries(def, level) berries -> FeedXp(level, machineLevel) XP.
-- Checks in order (each a toast, nothing moves before the last): loaded and not provisional; owned; below the cap; not
-- in a running battle or dungeon run; the Food Machine built; berries >= the cost. Then ONE non-yielding step: spend
-- (DataService.SpendBerries), grantXp; an XP write of 0 refunds the berries in the same step. A { Count } / { Food } /
-- string second argument from an old client is ignored (one feed). The old Food items were converted into berries
-- once by DataService's P5Home step, so there is no leftover path.
local function feed(player, key)
	if not initialized then
		return false, "Feeding is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	local level, have = petLevel(player, key)
	local cap = levelCap(def)
	local room = xpRoom(level, have, cap)
	if room <= 0 then
		return false, name .. " is at max level (Lv " .. cap .. ")"
	end
	if Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local home = getHome(player)
	local machineLevel = home and stationLevel(home, "Kitchen") or 0
	if machineLevel < 1 then
		return false, "Build the Food Machine at home first"
	end
	local cost = Care.feedBerries(def, level)
	local give = Care.feedXp(level, machineLevel)
	if not cost or give < 1 then
		return false, "That pet cannot eat right now"
	end
	local berries = Care.berries(player)
	if berries < cost then
		return false, "Not enough berries: a feed needs " .. tostring(cost) .. " (you have " .. tostring(berries) .. "). Your garden pets grow more!"
	end
	-- the berries and the XP in one step (no yields); the berries come back when the XP was refused
	if cost > 0 then
		local okSpend, spent = dsCall("SpendBerries", player, cost)
		if not okSpend or spent ~= true then
			return false, "Not enough berries: a feed needs " .. tostring(cost) .. " (you have " .. tostring(Care.berries(player)) .. "). Your garden pets grow more!"
		end
	end
	local given, levels, reason, newLevel, newXp, cap2, _, ready, stage = grantXp(player, key, math.min(give, room), "Feed")
	if given <= 0 then
		if cost > 0 then
			dsCall("AddBerries", player, cost)
		end
		return false, reason or "That pet cannot eat right now"
	end
	local left = Care.berries(player)
	PetCareService.Fed:Fire(player, key, "Berries", levels)
	-- ONE toast per feed
	if levels > 0 then
		notify(player, levelUpText(def, key, newLevel, cap2 or cap, stage, ready), "good", 5)
	else
		local need = xpToNext(newLevel)
		local progress = isFinite(need) and (" (" .. math.floor(newXp) .. "/" .. need .. " to Lv " .. (newLevel + 1) .. ")") or ""
		notify(player, name .. " ate " .. tostring(cost) .. " berries: +" .. math.floor(given) .. " XP" .. progress, "good", 3)
	end
	return true, { Xp = given, Levels = levels, Level = newLevel, Cap = cap2 or cap, Berries = left, Cost = cost }
end

function PetCareService.Feed(player, key)
	return feed(player, key)
end

----------------------------------------------------------------------
-- EVOLVE
----------------------------------------------------------------------

function Care.openPanel(player, panelId, args)
	openPanelRemote = openPanelRemote or remote("OpenPanel")
	if openPanelRemote and isPlayer(player) then
		pcall(function()
			openPanelRemote:FireClient(player, panelId, args)
		end)
	end
end

function PetCareService.Evolve(player, key)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	if Care.inBattle(player) or Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local level = petLevel(player, key)
	local stage = Care.growth(player, key).Evo or 0
	local nextStage = Care.canEvolve(def, level, stage)
	if not nextStage then
		if stage >= Care.maxEvolution(def) then
			return false, name .. " is fully evolved"
		end
		local levels = petCatalog and type(petCatalog.EvolutionLevels) == "table" and petCatalog.EvolutionLevels or { 20, 50 }
		local need = levels[stage + 1] or 20
		return false, name .. " evolves at level " .. tostring(need) .. " (Lv " .. level .. " now)"
	end
	local ok, wrote = dsCall("SetEvolution", player, key, nextStage)
	if not ok or wrote ~= true then
		return false, "Could not evolve right now, try again"
	end
	PetCareService.Evolved:Fire(player, key, nextStage)
	notify(player, name .. " evolved! " .. Care.boostText(nextStage) .. "!", "good", 6)
	Care.refreshInfo(player)
	Care.openPanel(player, "Evolve", { Key = key, Stage = nextStage })
	return true, nextStage
end

----------------------------------------------------------------------
-- Training (the Training Place): start, stop, completion, auto-remove / auto-return
----------------------------------------------------------------------

-- the mats in use and the running job count of a player (from the clean growth map)
function Care.usedMats(player)
	local map = Care.growthMap(player)
	local used, n = {}, 0
	for _, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" then
			n = n + 1
			if isFinite(job.Slot) then
				used[math.floor(job.Slot)] = true
			end
		end
	end
	return used, n, map
end

-- where the pet is now: "Garden:<slot>" (the smallest place holding it) | "Follow" | "Free"
function Care.fromOf(profile, home, key)
	local best = nil
	if type(home) == "table" and type(home.Garden) == "table" then
		for slot, k in pairs(home.Garden) do
			if k == key and isFinite(slot) and (best == nil or slot < best) then
				best = math.floor(slot)
			end
		end
	end
	if best then
		return "Garden:" .. best
	end
	if type(profile) == "table" and type(profile.Equipped) == "table" then
		for _, k in ipairs(profile.Equipped) do
			if k == key then
				return "Follow"
			end
		end
	end
	return "Free"
end

-- clears one Garden place (TycoonService.GardenSet, else straight into the saved Home)
function Care.clearGarden(player, slot)
	if tycoonService and type(tycoonService.GardenSet) == "function" then
		local ok, done = pcall(tycoonService.GardenSet, player, slot, nil)
		if ok and done == true then
			return
		end
	end
	mutateHome(player, function(live)
		if type(live.Garden) ~= "table" or live.Garden[slot] == nil then
			return false
		end
		live.Garden[slot] = nil
		return true
	end)
end

-- a training pet leaves the player (every equipped copy) and the Garden by itself
function Care.removePet(player, key)
	if petService then
		if type(petService.UnequipKey) == "function" then
			pcall(petService.UnequipKey, player, key)
		elseif type(petService.Unequip) == "function" then
			for _ = 1, 8 do
				local ok, done = pcall(petService.Unequip, player, key)
				if not (ok and done == true) then
					break
				end
			end
		end
	end
	local home = getHome(player)
	if home and type(home.Garden) == "table" then
		local slots = {}
		for slot, k in pairs(home.Garden) do
			if k == key then
				slots[#slots + 1] = slot
			end
		end
		for _, slot in ipairs(slots) do
			Care.clearGarden(player, slot)
		end
	end
end

-- the pet comes back to where it was (Job.From): "Follow" -> re-equipped when a slot is free; "Garden:n" -> that
-- place when open and empty, else the first free open place; else it stays in the list
function Care.returnPet(player, key, from)
	if type(from) ~= "string" or not isPlayer(player) then
		return
	end
	if from == "Follow" then
		if petService and type(petService.Equip) == "function" then
			pcall(petService.Equip, player, key)
		end
		return
	end
	local slot = tonumber(string.match(from, "^Garden:(%d+)$"))
	if not slot then
		return
	end
	local home = getHome(player)
	if not home or type(home.Garden) ~= "table" then
		return
	end
	local open = Care.gardenSlots(home)
	local target = nil
	if slot <= open and home.Garden[slot] == nil then
		target = slot
	else
		for s = 1, open do
			if home.Garden[s] == nil then
				target = s
				break
			end
		end
	end
	if target and tycoonService and type(tycoonService.GardenSet) == "function" then
		pcall(tycoonService.GardenSet, player, target, key)
	end
end

-- Finishes a due job: the rank becomes the job's TARGET rank (two servers completing one job give one rank), the
-- job goes, the pet comes back. Returns true when this server completed it.
function Care.completeJob(player, key, job, atLoad)
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" or type(e.Job) ~= "table" or e.Job.Stat ~= job.Stat then
			return false -- changed meanwhile (stopped, or another server's state): nothing to do here
		end
		local rank = e.Job.Rank
		if (e[job.Stat] or 0) < rank then
			e[job.Stat] = rank
		end
		e.Job = nil
		return true
	end)
	if not wrote then
		return false
	end
	local def = defOf(key, getProfile(player))
	local name = petName(def, key)
	local label = Care.statLabel(job.Stat)
	pcall(Care.returnPet, player, key, job.From)
	Care.publishTraining(player)
	if atLoad then
		Care.queueToast(player, "Training done while you were away! " .. name .. ": " .. label .. " Rank " .. tostring(job.Rank), "good", 6)
	else
		notify(player, name .. " finished " .. label .. " training: Rank " .. tostring(job.Rank) .. "!", "good", 5)
	end
	PetCareService.TrainingDone:Fire(player, key, job.Stat, job.Rank)
	return true
end

-- completes every due job (os.time() >= Job.Ends) of a loaded, non-provisional player; returns how many, the map
function Care.settleJobs(player, atLoad)
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return 0, nil
	end
	local map = Care.growthMap(player)
	local now = os.time()
	local done = 0
	for key, e in pairs(map) do
		local job = type(e) == "table" and e.Job or nil
		if type(job) == "table" and isFinite(job.Ends) and now >= job.Ends then
			if ownedCount(profile, key) < 1 then
				Care.mutateGrowth(player, function(g)
					g[key] = nil -- a job of a pet that is gone (fused away elsewhere)
				end)
				done = done + 1
			elseif Care.completeJob(player, key, job, atLoad) then
				done = done + 1
			end
		end
	end
	if done > 0 then
		map = nil -- changed: let the caller re-read
	end
	return done, map
end

function PetCareService.Train(player, key, stat)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	stat = Care.statOf(stat)
	if not stat then
		return false, "Pick a skill: Attack Speed, Physique, Ability or Defense"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	if not def then
		return false, "Unknown pet"
	end
	if ownedCount(profile, key) < 1 then
		return false, "You do not own that pet"
	end
	local name = petName(def, key)
	local label = Care.statLabel(stat)
	local home = getHome(player)
	if not home then
		return false, LOADING
	end
	local slots = Care.trainingSlots(home)
	if slots < 1 then
		return false, "Build the Training Place at home first"
	end
	local growth = Care.growth(player, key)
	if type(growth.Job) == "table" then
		return false, name .. " is already training (" .. Care.clock((tonumber(growth.Job.Ends) or 0) - os.time()) .. " left)"
	end
	local rank = isFinite(growth[stat]) and math.floor(growth[stat]) or 0
	local maxRank = Care.maxRank()
	if rank >= maxRank then
		return false, name .. "'s " .. label .. " is at Rank " .. maxRank .. " (max)"
	end
	local used, runningJobs = Care.usedMats(player)
	local mat = nil
	for s = 1, slots do
		if not used[s] then
			mat = s
			break
		end
	end
	if runningJobs >= slots or not mat then
		return false, "The Training Place is full (" .. runningJobs .. "/" .. slots .. " training)"
	end
	if Care.busyInBattle(player, key) then
		return false, "Finish your battle first"
	end
	local cost = Care.trainCost(def, rank + 1)
	local seconds = Care.trainSeconds(rank + 1)
	if not cost or not seconds then
		return false, "That pet cannot train right now"
	end
	local short = "Not enough Cash: Rank " .. (rank + 1) .. " " .. label .. " costs " .. money(cost)
	if getCash(player) < cost then
		return false, short
	end
	local from = Care.fromOf(profile, home, key)
	-- the payment and the job in one step (no yields): a failed job write gives the Cash back
	if cost > 0 and not spendCash(player, cost) then
		return false, short
	end
	local ends = os.time() + seconds
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" then
			e = {}
			g[key] = e
		end
		if type(e.Job) == "table" then
			return false
		end
		e.Job = { Stat = stat, Ends = ends, Rank = (isFinite(e[stat]) and math.floor(e[stat]) or 0) + 1, Slot = mat, From = from, Paid = cost }
		return true
	end)
	if not wrote then
		if cost > 0 then
			addCash(player, cost)
		end
		return false, "Could not start training right now, try again"
	end
	-- the pet leaves the player and the Garden by itself (Job.From remembers where it was)
	pcall(Care.removePet, player, key)
	Care.publishTraining(player)
	notify(player, name .. " started " .. label .. " training (" .. Care.clock(seconds) .. ")", "good", 4)
	PetCareService.TrainingStarted:Fire(player, key, stat)
	return true, { Rank = rank + 1, Ends = ends, Cost = cost, Slot = mat, From = from }
end

function PetCareService.TrainStop(player, key)
	if not initialized then
		return false, "Pet care is not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validKeyString(key) then
		return false, "Unknown pet"
	end
	local profile = getProfile(player)
	if not profile or isProvisional(player) then
		return false, LOADING
	end
	local def = defOf(key, profile)
	local name = petName(def, key)
	local job = Care.growth(player, key).Job
	if type(job) ~= "table" then
		return false, name .. " is not training"
	end
	if isFinite(job.Ends) and os.time() >= job.Ends then
		-- already done: it finishes instead (the rank is earned, nothing to refund)
		Care.completeJob(player, key, job, false)
		return true, 0
	end
	local paid = isFinite(job.Paid) and math.max(0, math.floor(job.Paid)) or 0
	-- the job goes and the Cash comes back in the same step (they travel in the same save)
	local wrote = Care.mutateGrowth(player, function(g)
		local e = g[key]
		if type(e) ~= "table" or type(e.Job) ~= "table" then
			return false
		end
		e.Job = nil
		return true
	end)
	if not wrote then
		return false, "Could not stop training right now, try again"
	end
	if paid > 0 then
		addCash(player, paid)
	end
	pcall(Care.returnPet, player, key, job.From)
	Care.publishTraining(player)
	if paid > 0 then
		notify(player, name .. " stopped training: " .. money(paid) .. " back", "info", 3)
	else
		notify(player, name .. " stopped training", "info", 3)
	end
	return true, paid
end

----------------------------------------------------------------------
-- Home load: the retired Gym, offline completions
----------------------------------------------------------------------

-- empties Home.Gym (the Gym is the Training Place now) once the home is readable; one toast per session, also when
-- DataService's one-time migration freed the Gym pets this session
function Care.freeOldGym(player)
	local s = Care.session(player)
	if s.GymChecked then
		return
	end
	local home = getHome(player)
	if not home then
		return -- not loaded yet / provisional: ProfileRebased and the tick bring us back
	end
	s.GymChecked = true
	local freed = 0
	if type(home.Gym) == "table" and next(home.Gym) ~= nil then
		local n = 0
		local wrote = mutateHome(player, function(live)
			if type(live.Gym) ~= "table" then
				return false
			end
			local slots = {}
			for slot, k in pairs(live.Gym) do
				if type(k) == "string" then
					n = n + 1
				end
				slots[#slots + 1] = slot
			end
			for _, slot in ipairs(slots) do
				live.Gym[slot] = nil
			end
			return #slots > 0
		end)
		if wrote then
			freed = freed + n
		end
	end
	if not s.MigrationSeen then
		local ok, info = dsCall("MigratedNow", player, "P4")
		if ok and type(info) == "table" then
			s.MigrationSeen = true
			if isFinite(info.GymPets) and info.GymPets > 0 then
				freed = freed + math.floor(info.GymPets)
			end
		end
	end
	if freed > 0 and not s.GymToast then
		s.GymToast = true
		Care.queueToast(player, "The Gym is now the Training Place: your gym pets are back with you", "info", 6)
	end
end

-- ProfileLoaded / ProfileRebased (and players already here at Init): the old Gym, the jobs that ended meanwhile
function Care.onProfileReady(player)
	if not isPlayer(player) then
		return
	end
	local s = Care.session(player)
	s.GymChecked = false -- a rebased save may hold Gym pets again (a Phase 3 server during the rollout)
	if not getProfile(player) or isProvisional(player) then
		return
	end
	Care.freeOldGym(player)
	local done, map = Care.settleJobs(player, true)
	if done > 0 then
		map = nil
	end
	Care.publishTraining(player, map)
end

----------------------------------------------------------------------
-- Prompts (FeedPrompt on the Food Machine, TrainPrompt on the Training Place)
----------------------------------------------------------------------

local function biggestPart(model)
	if model.PrimaryPart then
		return model.PrimaryPart
	end
	local best, size = nil, -1
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local s = d.Size.X * d.Size.Y * d.Size.Z
			if s > size then
				best, size = d, s
			end
		end
	end
	return best
end

local function newPrompt(parent, name, action, object, ownerId)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.KeyboardKeyCode = PROMPT_KEYS.Keyboard
	prompt.GamepadKeyCode = PROMPT_KEYS.Gamepad
	prompt.HoldDuration = PROMPT_HOLD
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OwnerUserId", ownerId)
	prompt:SetAttribute(CARE_MARK, true)
	prompt.Parent = parent
	return prompt
end

local function clearCarePrompts(model)
	for _, d in ipairs(model:GetDescendants()) do
		if d.Parent and d:GetAttribute(CARE_MARK) == true then
			d:Destroy()
		end
	end
end

-- the part a prompt sits on: the named part (a part inside a named model) when the station has it, else its biggest
function Care.anchorOf(model, anchorName)
	if anchorName then
		local found = model:FindFirstChild(anchorName, true)
		if found then
			if found:IsA("BasePart") then
				return found
			end
			local inner = found:FindFirstChildWhichIsA("BasePart", true)
			if inner then
				return inner
			end
		end
	end
	return biggestPart(model)
end

-- one owner-only prompt per station (rebuilt when the station or its owner changes; the signature carries "p4:")
function Care.ensurePrompt(player, info, home, stationId, promptName, action, object, anchorName)
	local level = stationLevel(home, stationId)
	if level < 1 then
		return
	end
	local model = Care.stationModel(info, stationId)
	if not model then
		return
	end
	local sig = SIG_PREFIX .. stationId .. ":" .. tostring(level) .. ":" .. tostring(player.UserId)
	if model:GetAttribute(CARE_SIG) == sig then
		return
	end
	clearCarePrompts(model)
	local anchor = Care.anchorOf(model, anchorName)
	if not anchor then
		return
	end
	local prompt = newPrompt(anchor, promptName, action, object, player.UserId)
	prompt:SetAttribute("StationId", stationId)
	model:SetAttribute(CARE_SIG, sig)
end

function Care.ensurePrompts(player, info, home)
	Care.ensurePrompt(player, info, home, "Kitchen", "FeedPrompt", "Feed pets", "Food Machine", "Hopper")
	Care.ensurePrompt(player, info, home, "Gym", "TrainPrompt", "Train pets", "Training Place", nil)
end

local function onPromptTriggered(prompt, player)
	if typeof(prompt) ~= "Instance" or not isPlayer(player) then
		return
	end
	local name = prompt.Name
	if name ~= "FeedPrompt" and name ~= "TrainPrompt" then
		return
	end
	if prompt:GetAttribute(CARE_MARK) ~= true or prompt:GetAttribute("OwnerUserId") ~= player.UserId then
		return -- someone else's home (their prompts are disabled locally; never trust a stray trigger)
	end
	local info = plotOf(player)
	if not info or typeof(info.Folder) ~= "Instance" or not prompt:IsDescendantOf(info.Folder) then
		return
	end
	if not cooldown(player, "Prompt", PROMPT_COOLDOWN) or not spend(player) then
		return
	end
	if name == "FeedPrompt" then
		Care.openPanel(player, "Pets", { Tab = "Pets", Action = "Feed" })
	else
		Care.openPanel(player, "Train")
	end
end

----------------------------------------------------------------------
-- Extras
----------------------------------------------------------------------

-- Cap-aware XP for other services (battles, the Champion Ring): never past the pet's level cap. Returns xpGiven,
-- levelsGained, reason (nil when XP was given). ONE toast per grant: the level-up toast with the new stats (and
-- "Ready to evolve!" at 20 / 50), whatever the number of levels crossed.
function PetCareService.GrantXp(player, key, xp, source)
	if not initialized then
		return 0, 0, "Pet care is not ready yet"
	end
	if not isPlayer(player) or not validKeyString(key) then
		return 0, 0, "Unknown pet"
	end
	local given, levels, why, newLevel, _, cap, def, ready, stage = grantXp(player, key, tonumber(xp), source or "Other")
	if levels > 0 and def then
		notify(player, levelUpText(def, key, newLevel, cap, stage, ready), "good", 5)
	end
	return given, levels, why
end

function PetCareService.LevelCap(player, key)
	local def = defOf(key, player and getProfile(player) or nil)
	if not def then
		return nil
	end
	return levelCap(def)
end

-- Developer tools ("Reset my data"): drops this server's session state of the player (deferred toasts, the published
-- TrainingPets, the Gym check). The saved growth is wiped by DevService itself.
function PetCareService.ClearSessions(player)
	if not player then
		return false
	end
	Care.clearShown(player)
	local s = sessions[player]
	if s then
		s.Pending = {}
		s.GymChecked = false
		s.GymToast = false
		s.MigrationSeen = false
	end
	cooldowns[player] = nil
	return true
end

----------------------------------------------------------------------
-- Remote PetCare(action, a, b)
----------------------------------------------------------------------

local function onPetCare(player, action, a, b)
	if not isPlayer(player) or type(action) ~= "string" or #action > MAX_ACTION_LENGTH then
		return
	end
	if not spend(player) then
		return
	end
	if action == "Feed" then
		if not cooldown(player, "Feed", FEED_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		-- (a { Count } / { Food } / string in `b` from an old client is ignored: exactly one feed)
		local ok, reason = feed(player, key)
		if not ok then
			toastOnce(player, reason or "That pet cannot eat now", "bad")
		end
	elseif action == "Evolve" then
		if not cooldown(player, "Evolve", EVOLVE_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		local ok, reason = PetCareService.Evolve(player, key)
		if not ok then
			toastOnce(player, reason or "That pet cannot evolve now", "bad")
		end
	elseif action == "Train" then
		if not cooldown(player, "Train", TRAIN_COOLDOWN) then
			return
		end
		local key, stat = a, b
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
			stat = a.Stat
			if stat == nil then
				stat = a.Skill
			end
			if stat == nil then
				stat = a[2]
			end
		end
		local ok, reason = PetCareService.Train(player, key, stat)
		if not ok then
			toastOnce(player, reason or "That pet cannot train now", "bad")
		end
	elseif action == "TrainStop" then
		if not cooldown(player, "Train", TRAIN_COOLDOWN) then
			return
		end
		local key = a
		if type(a) == "table" then
			key = a.Key
			if key == nil then
				key = a[1]
			end
		end
		local ok, reason = PetCareService.TrainStop(player, key)
		if not ok then
			toastOnce(player, reason or "That pet is not training", "bad")
		end
	elseif action == "Cook" then
		toastOnce(player, "The Kitchen is now the Food Machine: press E at it to feed your pets", "info")
	elseif action == "GymSet" then
		toastOnce(player, "The Gym is now the Training Place: press E at it to train a pet", "info")
	end
end

----------------------------------------------------------------------
-- Tick + players
----------------------------------------------------------------------

local function tickPlayer(player, now)
	local s = Care.session(player)
	local profile = getProfile(player)
	local readable = profile ~= nil and not isProvisional(player)
	local map = nil
	if readable then
		if not s.GymChecked then
			Care.freeOldGym(player)
		end
		local done
		done, map = Care.settleJobs(player, false)
		if done > 0 then
			map = nil
		end
	end
	local info = plotOf(player)
	if info and readable then
		local home = getHome(player)
		if home then
			Care.ensurePrompts(player, info, home)
			Care.publishTraining(player, map)
		end
	elseif s.Shown then
		Care.clearShown(player)
	end
	Care.flushToasts(player, s, now)
end

local function tickAll()
	local now = os.clock()
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayer(player) then
			local ok, err = pcall(tickPlayer, player, now)
			if not ok then
				warn("[PetCareService] tick failed: " .. tostring(err))
			end
		end
	end
end

local function tickLoop()
	while running do
		task.wait(TICK)
		if not running then
			break
		end
		local ok, err = pcall(tickAll)
		if not ok then
			warn("[PetCareService] tick failed: " .. tostring(err))
		end
	end
end

local function onPlayerAdded(player)
	Care.session(player)
	if getProfile(player) and not isProvisional(player) then
		local ok, err = pcall(Care.onProfileReady, player)
		if not ok then
			warn("[PetCareService] load failed: " .. tostring(err))
		end
	end
end

local function onPlayerRemoving(player)
	departed[player] = true
	Care.clearShown(player)
	sessions[player] = nil
	cooldowns[player] = nil
	budgets[player] = nil
	toastAt[player] = nil
end

local function connectSignal(signal, fn, what)
	if type(signal) == "table" and type(signal.Connect) == "function" then
		local ok, err = pcall(function()
			signal:Connect(function(...)
				local okCall, callErr = pcall(fn, ...)
				if not okCall then
					warn("[PetCareService] " .. what .. " handler failed: " .. tostring(callErr))
				end
			end)
		end)
		if not ok then
			warn("[PetCareService] could not listen to " .. what .. ": " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function PetCareService.Init(deps)
	if initialized then
		return
	end
	deps = deps or {}
	local services = script.Parent
	dataService = deps.DataService or requireModule(services, "DataService")
	petService = deps.PetService
	tycoonService = deps.TycoonService
	battleService = deps.BattleService
	catalog = requireModule(Shared, "TycoonCatalog")
	petKeys = requireModule(Shared, "PetKeys")
	petCatalog = requireModule(Shared, "PetCatalog")
	if not catalog then
		warn("[PetCareService] TycoonCatalog is missing: the Food Machine, EVOLVE and the Training Place are disabled")
		return
	end
	if not dataService or type(dataService.AddPetXp) ~= "function" then
		warn("[PetCareService] DataService has no pet level API: the Food Machine, EVOLVE and the Training Place are disabled")
		return
	end
	if type(dataService.MutateGrowth) ~= "function" then
		warn("[PetCareService] DataService has no PetGrowth API: EVOLVE and training will refuse")
	end
	homeBuilder = services and services:FindFirstChild("HomeBuilder") and requireModule(services, "HomeBuilder") or nil
	initialized = true

	local petCare = remote("PetCare")
	if petCare then
		petCare.OnServerEvent:Connect(onPetCare)
	else
		warn("[PetCareService] the PetCare remote is missing (Config.Remotes)")
	end
	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	-- the old Gym is emptied and due jobs finish when a save becomes readable (load, rebase, dev reset)
	connectSignal(dataService.ProfileLoaded, Care.onProfileReady, "DataService.ProfileLoaded")
	connectSignal(dataService.ProfileRebased, Care.onProfileReady, "DataService.ProfileRebased")
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	running = true
	task.spawn(tickLoop)
end

return PetCareService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="855">
          <Properties>
            <string name="Name">PetService</string>
            <string name="Source"><![CDATA[-- PetService: pet ownership, roulette purchases, equipping and pet perks (ARCHITECTURE_V2.md s.2).
--
--   PetService.Init(lobbyInfo, deps)         deps = { DataService = }
--   PetService.BuyRoulette(player, rouletteId, currency|nil) -> ok, result|reason
--                                            currency: nil = the roulette's own ("Tokens"; the gems-only Secret
--                                            roulette: "Gems"), "Tokens" or "Gems" (also { Currency = ... })
--   PetService.Equip / Unequip(player, key)    -> ok, reason
--   PetService.GetEquipped(player) -> {key...}
--   PetService.GetPerks(player) -> {MaxHealth, TokenBonus, StaminaRegen, CheckpointHeal}
--   PetService.GetTokenMultiplier(player) -> number >= 1
--   PetService.PerksChanged                  Util.Signal, Fire(player)
--   PetService.Rolled                        Util.Signal, Fire(player, petId) after every successful roll (v3)
--   Extra (Phase 2): PetService.Refresh(player) -> changed   re-validates the equipped list against what the player
--                    owns (after FusionService / DevService removed copies: excess or vanished keys are unequipped),
--                    republishes the attributes and perks, MarkDirty + Sync when something changed.
-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.7, 5.3, 5.4):
--   * the training lock: Equip refuses a key with a running training job ("Rocky is training (2:10 left)"; the ONE
--     source is DataService.TrainingKeys), and the list re-validation drops training keys (a Phase 3 server may have
--     equipped one during the rollout).
--   * PetService.UnequipKey(player, key) -> removed   takes every equipped copy of the key off (PetCareService calls it
--     when a pet starts training).
--   * attribute EquippedInfo (Config.Attr) = "23:1,5:0": level:evolution stage per EquippedPets entry, written by
--     refreshPlayer (equip changes, Refresh after level-ups / evolutions) only when it changed and at most every 0.5 s
--     per player (a burst of level-ups coalesces into one deferred write); other clients draw the pet cards and the
--     evolved follower models from it.
--
-- v3 (ARCHITECTURE_V3.md section 3): every successful roll marks the pet as discovered for the Pet Index
-- (DataService.MarkDiscovered) before the ProfileSync goes out; RouletteResult.IsNew keeps meaning "first time
-- owned" and the payload also carries NewDiscovery (first time in the Index). Owned pets are re-checked as
-- discovered whenever a profile loads or is rebased.
--
-- Phase 2 (ARCHITECTURE_V3.md "Pet keys"): a pet COPY is a key (shared/PetKeys.lua): "petId" (Normal),
-- "petId@Golden", "petId@Rainbow", "hyb:<uid>" (a fused hybrid). Equip / Unequip take keys; an old plain petId is
-- the Normal key, so old callers keep working (Unequip(petId) also takes off a tier copy of that pet when no Normal
-- copy is equipped). Perks and the token multiplier sum PetKeys.DefOf(key).Perks x PetKeys.StatMultiplier(tier)
-- (DataService.ComputePerks), capped as before. The roulette still adds Normal copies (Pets[petId] + 1).
--
-- Phase 2 gems (ARCHITECTURE_V3.md "GemService"): a roulette can also be paid in Gems. GemService (looked up when
-- needed, so it may be missing) owns the gem prices (Config.Gems.RouletteGemPrices, the same odds as with tokens), the
-- PolicyService paid-random-items check and the gems-only Secret roulette (Config.Gems.SecretRoulette, rolled by
-- GemService.RollPet); its Quote is taken first, then the shared roll charges the Gems (DataService.SpendGems) and
-- grants in one non-yielding step. A gem roll without GemService, for a restricted (or not yet checked) account or
-- for a roulette without a gem price is refused before anything is charged. Secret pets only ever come out of a
-- roulette with AllowSecret = true: a Secret result of any other roulette is refused (nothing charged). The
-- BuyRoulette remote takes the optional currency as its second argument; RouletteResult gains Currency, Price, Gems.
--
-- Everything is server authoritative: the client only sends ids, we validate ownership, prices,
-- stack caps and slot limits, then write to the live profile and Sync it back.
--
-- Perk plumbing:
--   * attribute EquippedPets (csv of keys)   -> every client draws that player's followers
--   * attribute EquippedHybrids              -> the looks of the equipped hybrids (other clients cannot see the
--                                               owner's profile): "uid=Body/Style/Tier/Rarity[/Seed];..." -- set
--                                               BEFORE EquippedPets, only once a player ever equips a hybrid
--   * attribute PerkStaminaRegen         -> MovementController scales its stamina regen
--   * MaxHealth                          -> PlayerService (Main hands it GetPerks and calls RefreshMaxHealth
--                                           when PerksChanged fires), so this module never touches Humanoids
--   * TokenBonus / CheckpointHeal        -> read by MatchService through GetPerks / GetTokenMultiplier
-- perkState is updated BEFORE PerksChanged fires, so listeners always see the new numbers.
-- Equip / Unequip / BuyRoulette are refused while the player attribute InMatch is true, so the
-- loadout cannot be hot-swapped between token pickups and checkpoints.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local DataService = require(script.Parent.DataService)

local PetService = {}
PetService.PerksChanged = Util.Signal()
PetService.Rolled = Util.Signal()

local STRIP_LENGTH = 40 -- cosmetic roulette strip: the client scrolls it and stops on WIN_INDEX
local WIN_INDEX = 34
local REMOTE_COOLDOWN = 0.25 -- seconds per player per remote
local PROMPT_COOLDOWN = 0.5
local ANNOUNCE_DELAY = 5 -- seconds before the puller sees their own server-wide announcement
local MAX_ID_LENGTH = 48
local PROMPT_NAME = "RoulettePrompt"
local HYBRID_ATTR = "EquippedHybrids" -- not in Config.Attr (lead-owned): the looks of equipped hybrids, see the header
local SECRET_RARITY = "Secret" -- Secret pets come only from a roulette with AllowSecret = true (Phase 2 gems)
local MAX_CURRENCY_LENGTH = 16

----------------------------------------------------------------------
-- Optional collaborators (written by other modules; every use is guarded)
----------------------------------------------------------------------

local function loadShared(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[PetService] missing shared module: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[PetService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local PetCatalog = loadShared("PetCatalog")
local PetKeys = loadShared("PetKeys")

-- GemService (Phase 2, gems) is looked up when a gem roll needs it: an optional module that Main loads after this one
-- (requiring it here at load time would tie the two to their load order).
local gemModule = nil
local function getGemService()
	if gemModule then
		return gemModule
	end
	local inst = script.Parent:FindFirstChild("GemService")
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		gemModule = result
		return result
	end
	return nil
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local roulettes = {} -- [id] = Config.Roulettes entry
for _, entry in ipairs(Config.Roulettes) do
	roulettes[entry.Id] = entry
end

local rarityOrder = {} -- [rarityId] = Order
for _, entry in ipairs(Config.Rarities) do
	rarityOrder[entry.Id] = entry.Order
end
local ANNOUNCE_ORDER = rarityOrder.Rare or 3

local perkState = {} -- [player] = { Perks = {...} }
local lastCall = {} -- [player] = { [key] = os.clock() }
local infoState = {} -- [player] = { At = os.clock() of the last EquippedInfo write, Pending = true while a deferred write waits }
local INFO_GAP = 0.5 -- EquippedInfo is written at most this often per player (level-up bursts coalesce)
local remotesConnected = false
local playersConnected = false
local promptObjects = {}

local ZERO_PERKS = { MaxHealth = 0, TokenBonus = 0, StaminaRegen = 0, CheckpointHeal = 0 }

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function rateLimited(player, key, interval)
	local record = lastCall[player]
	if not record then
		record = {}
		lastCall[player] = record
	end
	local now = os.clock()
	local last = record[key]
	if last and now - last < interval then
		return true
	end
	record[key] = now
	return false
end

local function validId(id)
	return type(id) == "string" and #id > 0 and #id <= MAX_ID_LENGTH
end

-- Perks are read by MatchService at the moment of each pickup / checkpoint, so the loadout must not
-- change while a match runs (same rule as the roulette and the item shop).
local function inMatch(player)
	return player:GetAttribute(Config.Attr.InMatch) == true
end

local function fireClient(remoteName, player, ...)
	local ok, remote = pcall(Remotes.Get, remoteName)
	if ok and remote and player and player.Parent then
		remote:FireClient(player, ...)
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function countOf(list, id)
	local n = 0
	for _, value in ipairs(list) do
		if value == id then
			n = n + 1
		end
	end
	return n
end

-- every owned copy (Normal, tiers, hybrids): the very first pet ever is equipped automatically
local function totalPets(profile)
	local n = 0
	for _, count in pairs(profile.Pets) do
		n = n + count
	end
	for _, entry in pairs(type(profile.Tiers) == "table" and profile.Tiers or {}) do
		if type(entry) == "table" then
			for _, count in pairs(entry) do
				if type(count) == "number" then
					n = n + count
				end
			end
		end
	end
	for _ in pairs(type(profile.Hybrids) == "table" and profile.Hybrids or {}) do
		n = n + 1
	end
	return n
end

-- PetKeys.Parse(key) or nil (a plain petId when PetKeys is missing)
local function parseKey(key)
	if PetKeys and type(PetKeys.Parse) == "function" then
		local ok, parsed = pcall(PetKeys.Parse, key)
		if ok then
			return parsed
		end
		return nil
	end
	if validId(key) then
		return { Key = key, PetId = key, Tier = "Normal" }
	end
	return nil
end

-- The definition of a key (PetKeys.DefOf: catalog def, tier def or hybrid def), or nil for unknown keys.
-- Without PetKeys plain ids resolve through PetCatalog; without either nothing can be called unknown (true).
local function defOf(key, profile)
	if PetKeys and type(PetKeys.DefOf) == "function" then
		local ok, def = pcall(PetKeys.DefOf, key, profile)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	if PetCatalog and type(PetCatalog.Get) == "function" then
		local ok, def = pcall(PetCatalog.Get, key)
		if ok and type(def) == "table" then
			return def
		end
		return nil
	end
	return true
end

-- copies of `key` the profile owns
local function ownedCount(profile, key)
	if PetKeys and type(PetKeys.Count) == "function" then
		local ok, n = pcall(PetKeys.Count, profile, key)
		if ok and type(n) == "number" then
			return n
		end
		return 0
	end
	local n = profile.Pets[key]
	if type(n) == "number" then
		return n
	end
	return 0
end

-- "uid=Body/Style/Tier/Rarity[/Seed];..." for the equipped hybrids (what other clients need to draw them)
local function hybridLooks(profile)
	local parts, seen = {}, {}
	local hybrids = type(profile.Hybrids) == "table" and profile.Hybrids or {}
	for _, key in ipairs(profile.Equipped) do
		local parsed = parseKey(key)
		local uid = parsed and parsed.HybridId
		local rec = uid and hybrids[uid]
		if uid and not seen[uid] and type(rec) == "table" and type(rec.Body) == "string" and type(rec.Style) == "string" then
			seen[uid] = true
			local fields = { rec.Body, rec.Style, parsed.Tier, type(rec.Rarity) == "string" and rec.Rarity or "" }
			if type(rec.Seed) == "number" and rec.Seed == rec.Seed then
				fields[5] = tostring(math.floor(rec.Seed))
			end
			local text = uid .. "=" .. table.concat(fields, "/")
			if not string.find(text, "[,;]") then
				parts[#parts + 1] = text
			end
		end
	end
	return table.concat(parts, ";")
end

local function copyPerks(perks)
	return {
		MaxHealth = perks.MaxHealth or 0,
		TokenBonus = perks.TokenBonus or 0,
		StaminaRegen = perks.StaminaRegen or 0,
		CheckpointHeal = perks.CheckpointHeal or 0,
	}
end

----------------------------------------------------------------------
-- Perks + attributes
----------------------------------------------------------------------

-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.7, 4.1): the training lock. DataService.TrainingKeys is the
-- ONE source: { [key] = true } of the keys with a running training job ({} before the load / while provisional).
local function trainingKeys(player)
	if type(DataService.TrainingKeys) ~= "function" then
		return {}
	end
	local ok, set = pcall(DataService.TrainingKeys, player)
	if ok and type(set) == "table" then
		return set
	end
	return {}
end

-- "2:10" of training left for a key (its Job.Ends is a server os.time() stamp), or nil
local function trainingLeft(player, key)
	if type(DataService.GetGrowth) ~= "function" then
		return nil
	end
	local ok, growth = pcall(DataService.GetGrowth, player, key)
	local job = ok and type(growth) == "table" and growth.Job or nil
	local ends = type(job) == "table" and tonumber(job.Ends) or nil
	if not ends or ends ~= ends then
		return nil
	end
	local s = math.max(0, math.ceil(ends - os.time()))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

local function petLevelOf(player, key)
	if type(DataService.GetPetLevel) ~= "function" then
		return 1
	end
	local ok, level = pcall(DataService.GetPetLevel, player, key)
	if ok and type(level) == "number" and level == level and level >= 1 then
		return math.floor(level)
	end
	return 1
end

local function evolutionOf(player, key)
	if type(DataService.GetEvolution) ~= "function" then
		return 0
	end
	local ok, stage = pcall(DataService.GetEvolution, player, key)
	if ok and type(stage) == "number" and stage == stage and stage >= 0 then
		return math.floor(stage)
	end
	return 0
end

-- "23:1,5:0": level:stage per EquippedPets entry (Phase 4 contract 5.3; other clients draw the pet cards and the evolved
-- models from it, since PetLevels / PetGrowth only sync to the owner)
local function equippedInfo(player, profile)
	local parts = {}
	for i, key in ipairs(profile.Equipped) do
		parts[i] = tostring(petLevelOf(player, key)) .. ":" .. tostring(evolutionOf(player, key))
	end
	return table.concat(parts, ",")
end

-- Writes EquippedInfo when it changed, at most every INFO_GAP seconds per player (a burst of level-ups coalesces into
-- one deferred write that carries the final value). Written BEFORE EquippedPets when it is due, so a client that sees
-- a new list already has its levels.
local function publishInfo(player, profile)
	local attr = Config.Attr.EquippedInfo
	if type(attr) ~= "string" then
		return
	end
	local text = equippedInfo(player, profile)
	if player:GetAttribute(attr) == text then
		return
	end
	local now = os.clock()
	local state = infoState[player]
	if not state then
		state = { At = -math.huge, Pending = false }
		infoState[player] = state
	end
	if now - state.At >= INFO_GAP then
		state.At = now
		player:SetAttribute(attr, text)
		return
	end
	if state.Pending then
		return
	end
	state.Pending = true
	task.delay(INFO_GAP - (now - state.At), function()
		local s = infoState[player]
		if s then
			s.Pending = false
		end
		if not isLivePlayer(player) then
			return
		end
		local latest = DataService.GetProfile(player)
		if type(latest) ~= "table" or type(latest.Equipped) ~= "table" then
			return
		end
		local value = equippedInfo(player, latest)
		if player:GetAttribute(attr) ~= value then
			if s then
				s.At = os.clock()
			end
			player:SetAttribute(attr, value)
		end
	end)
end

-- Recomputes perks from the profile and publishes the attributes. `silent` skips PerksChanged.
local function refreshPlayer(player, silent)
	if not isLivePlayer(player) then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local perks = copyPerks(DataService.ComputePerks(profile.Equipped, profile))
	perkState[player] = { Perks = perks }
	-- the hybrid looks first: a client that sees the new EquippedPets can already draw every hybrid in it
	local looks = hybridLooks(profile)
	local currentLooks = player:GetAttribute(HYBRID_ATTR)
	if looks ~= "" or (currentLooks ~= nil and currentLooks ~= "") then
		if currentLooks ~= looks then
			player:SetAttribute(HYBRID_ATTR, looks)
		end
	end
	publishInfo(player, profile)
	player:SetAttribute(Config.Attr.EquippedPets, table.concat(profile.Equipped, ","))
	player:SetAttribute(Config.Attr.PerkStaminaRegen, perks.StaminaRegen)
	if not silent then
		PetService.PerksChanged:Fire(player)
	end
end

-- Drops equipped keys that are unknown (pets that left the catalog, hybrids whose record is gone), owned fewer
-- times than they are equipped (copies fused away) or training (Phase 4: a training pet cannot be on the player; a
-- Phase 3 server may have equipped one during the rollout), and trims to the slot limit. Returns true if anything changed.
local function validateEquipped(profile, player)
	if type(profile.Equipped) ~= "table" then
		profile.Equipped = {}
	end
	local training = player and trainingKeys(player) or {}
	local kept = {}
	local used = {}
	for _, key in ipairs(profile.Equipped) do
		if type(key) == "string" and #kept < Config.Pets.MaxEquipped and defOf(key, profile) and not training[key] then
			local n = (used[key] or 0) + 1
			if n <= ownedCount(profile, key) then
				used[key] = n
				table.insert(kept, key)
			end
		end
	end
	if #kept == #profile.Equipped then
		return false
	end
	for i = #profile.Equipped, 1, -1 do
		profile.Equipped[i] = nil
	end
	for i, id in ipairs(kept) do
		profile.Equipped[i] = id
	end
	return true
end

-- Pet Index: marks a pet as discovered. Returns true the first time. Safe when DataService predates v3.
local function markDiscovered(player, petId)
	if type(DataService.MarkDiscovered) ~= "function" then
		return false
	end
	local ok, isNew = pcall(DataService.MarkDiscovered, player, petId)
	if not ok then
		warn("[PetService] MarkDiscovered errored: " .. tostring(isNew))
		return false
	end
	return isNew == true
end

-- Every owned pet counts as discovered (DataService migrates stored profiles; this also covers pets
-- granted outside the roulette).
local function discoverOwned(player, profile)
	for petId, count in pairs(profile.Pets) do
		if type(count) == "number" and count > 0 then
			markDiscovered(player, petId)
		end
	end
	-- tier copies count for their base pet (the Index lists base pets)
	for petId, entry in pairs(type(profile.Tiers) == "table" and profile.Tiers or {}) do
		if type(entry) == "table" then
			markDiscovered(player, petId)
		end
	end
end

local function onProfileReady(player)
	if not isLivePlayer(player) then
		return
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return
	end
	local changed = validateEquipped(profile, player)
	discoverOwned(player, profile) -- the ProfileSync snapshot already lists owned pets, so no extra Sync
	refreshPlayer(player, false)
	if changed then
		DataService.MarkDirty(player)
		DataService.Sync(player)
	end
end

local function finishEquipChange(player)
	DataService.MarkDirty(player)
	refreshPlayer(player, false)
	DataService.Sync(player)
end

----------------------------------------------------------------------
-- Public API: perks
----------------------------------------------------------------------

function PetService.GetEquipped(player)
	local profile = player and DataService.GetProfile(player)
	local out = {}
	if profile then
		for i, id in ipairs(profile.Equipped) do
			out[i] = id
		end
	end
	return out
end

function PetService.GetPerks(player)
	local state = player and perkState[player]
	if state then
		return copyPerks(state.Perks)
	end
	return copyPerks(ZERO_PERKS)
end

function PetService.GetTokenMultiplier(player)
	local state = player and perkState[player]
	local bonus = state and state.Perks.TokenBonus or 0
	if type(bonus) ~= "number" or bonus ~= bonus or bonus < 0 then
		bonus = 0
	end
	return 1 + bonus
end

----------------------------------------------------------------------
-- Public API: equip / unequip
----------------------------------------------------------------------

function PetService.Equip(player, key)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if inMatch(player) then
		return false, "Pets are locked during a match"
	end
	if not validId(key) or not parseKey(key) then
		return false, "Unknown pet"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	if not defOf(key, profile) then
		return false, "Unknown pet"
	end
	local owned = ownedCount(profile, key)
	if owned <= 0 then
		return false, "You do not own that pet"
	end
	if trainingKeys(player)[key] then
		-- Phase 4: a training pet rests at home until its job is done (the lock: DataService.TrainingKeys)
		local def = defOf(key, profile)
		local name = type(def) == "table" and (def.DisplayName or def.Name) or key
		local left = trainingLeft(player, key)
		return false, tostring(name) .. " is training" .. (left and (" (" .. left .. " left)") or "")
	end
	local equipped = profile.Equipped
	if #equipped >= Config.Pets.MaxEquipped then
		return false, "All " .. Config.Pets.MaxEquipped .. " pet slots are full"
	end
	if countOf(equipped, key) >= owned then
		return false, "All your copies are already equipped"
	end
	table.insert(equipped, key)
	finishEquipChange(player)
	return true
end

-- Takes one copy of `key` off (the last one equipped). A plain petId also matches a tier copy of that pet when no
-- Normal copy is equipped (old callers only know pet ids).
function PetService.Unequip(player, key)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if inMatch(player) then
		return false, "Pets are locked during a match"
	end
	if not validId(key) then
		return false, "Unknown pet"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	local equipped = profile.Equipped
	for i = #equipped, 1, -1 do
		if equipped[i] == key then
			table.remove(equipped, i)
			finishEquipChange(player)
			return true
		end
	end
	local parsed = parseKey(key)
	if parsed and parsed.PetId and parsed.Tier == "Normal" then
		for i = #equipped, 1, -1 do
			local other = parseKey(equipped[i])
			if other and other.PetId == parsed.PetId then
				table.remove(equipped, i)
				finishEquipChange(player)
				return true
			end
		end
	end
	return false, "That pet is not equipped"
end

-- Phase 4 (contract 3.7 / 5.4): takes EVERY equipped copy of `key` off (PetCareService calls it when a pet starts
-- training; the server decides, so a running match does not lock it). Returns the number of copies removed.
function PetService.UnequipKey(player, key)
	if not isLivePlayer(player) or not validId(key) then
		return 0
	end
	local profile = DataService.GetProfile(player)
	if not profile or type(profile.Equipped) ~= "table" then
		return 0
	end
	local equipped = profile.Equipped
	local removed = 0
	for i = #equipped, 1, -1 do
		if equipped[i] == key then
			table.remove(equipped, i)
			removed = removed + 1
		end
	end
	if removed > 0 then
		finishEquipChange(player)
	end
	return removed
end

-- Extra: re-validates the equipped list against what the player owns now (FusionService / DevService call it after
-- removing copies; PetCareService after a level-up / evolution / training start), republishes the attributes
-- (EquippedPets, EquippedHybrids, EquippedInfo) and perks. Returns true when the list changed.
function PetService.Refresh(player)
	if not isLivePlayer(player) then
		return false
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false
	end
	local changed = validateEquipped(profile, player)
	refreshPlayer(player, false)
	if changed then
		DataService.MarkDirty(player)
		DataService.Sync(player)
	end
	return changed
end

----------------------------------------------------------------------
-- Public API: roulette
----------------------------------------------------------------------

-- Cosmetic strip: STRIP_LENGTH pet ids drawn like real rolls (so it shows realistic rarities),
-- with the real result at WIN_INDEX. `roll` = the roulette's roll (PetCatalog.RollPet when nil).
local function buildStrip(rouletteId, resultId, seed, roll)
	local rng = Util.NewRng(seed)
	local strip = {}
	for i = 1, STRIP_LENGTH do
		local id = nil
		local ok, rolled = pcall(roll or PetCatalog.RollPet, rouletteId, rng)
		if ok and type(rolled) == "string" then
			id = rolled
		end
		strip[i] = id or resultId
	end
	strip[WIN_INDEX] = resultId
	return strip
end

-- Tells the server about a rare pull. Everybody else sees it at once; the puller sees it after
-- the reveal animation so it does not spoil the result.
local function announcePull(player, def)
	local order = rarityOrder[def.Rarity] or 0
	if order < ANNOUNCE_ORDER then
		return
	end
	local text = player.DisplayName .. " pulled " .. def.Name .. "!"
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player then
			notify(other, text, "good", 4)
		end
	end
	task.delay(ANNOUNCE_DELAY, function()
		if player.Parent then
			notify(player, text, "good", 4)
		end
	end)
end

-- Copies of a pet in any form (Normal + tier copies): IsNew keeps meaning "first time owned".
local function ownedAnyForm(profile, petId)
	local n = profile.Pets[petId] or 0
	local entry = type(profile.Tiers) == "table" and profile.Tiers[petId]
	if type(entry) == "table" then
		for _, count in pairs(entry) do
			if type(count) == "number" and count > 0 then
				n = n + count
			end
		end
	end
	return n
end

-- The roll every way of paying shares (Cloud Tokens, or Gems through GemService's quote).
-- Roll first (pure), then check the stack cap, then charge() -> ok, reason (must not yield): a capped pull costs
-- nothing, which is the same outcome as "charge, refund, fail". Nothing between the charge and the grant yields, so
-- check + charge + grant is atomic. Grants ONE Normal copy (key = petId). `roll` (optional) replaces
-- PetCatalog.RollPet(rouletteId, rng) for roulettes the catalog does not list (the gems-only Secret roulette).
-- `opts` = { AllowSecret = bool (only then may a Secret pet come out), Currency = "Tokens"|"Gems", Price = n }.
-- Returns ok, result|reason.
local function rollAndGrant(player, profile, rouletteId, charge, roll, opts)
	opts = type(opts) == "table" and opts or {}
	local seed = (os.time() + player.UserId + profile.Stats.Spins + math.floor(os.clock() * 1000)) % 2147483647
	local rolledOk, petId = pcall(roll or PetCatalog.RollPet, rouletteId, Util.NewRng(seed))
	if not rolledOk or type(petId) ~= "string" then
		return false, "The roulette jammed, try again"
	end
	local def = PetCatalog.Get(petId)
	if not def then
		return false, "The roulette jammed, try again"
	end
	if def.Rarity == SECRET_RARITY and opts.AllowSecret ~= true then
		-- Secret pets only come from the gems-only Secret roulette: never from any other one, whatever it rolled
		return false, "The roulette jammed, try again"
	end
	local owned = profile.Pets[petId] or 0
	if owned >= Config.Pets.MaxPerStack then
		return false, "You already own the maximum of " .. def.Name
	end
	local everOwned = ownedAnyForm(profile, petId)
	local charged, reason = charge()
	if not charged then
		return false, reason or "Not enough cloud tokens"
	end

	-- Nothing below yields, so the check + charge + grant is atomic.
	local firstPetEver = totalPets(profile) == 0
	profile.Pets[petId] = owned + 1
	profile.Stats.Spins = profile.Stats.Spins + 1
	if firstPetEver and #profile.Equipped < Config.Pets.MaxEquipped then
		table.insert(profile.Equipped, petId)
	end
	local newDiscovery = markDiscovered(player, petId) -- before the Sync, so the snapshot shows it in the Index
	DataService.MarkDirty(player)
	refreshPlayer(player, false)
	DataService.Sync(player)

	local result = {
		Ok = true,
		RouletteId = rouletteId,
		PetId = petId,
		Key = petId, -- the copy's key (a roulette always grants a Normal copy)
		IsNew = everOwned == 0,
		NewDiscovery = newDiscovery,
		Count = owned + 1,
		Tokens = DataService.GetTokens(player),
		Strip = buildStrip(rouletteId, petId, seed + 7919, roll),
	}
	if opts.Currency then
		result.Currency = opts.Currency -- what paid this spin ("Tokens" | "Gems") and how much
		result.Price = opts.Price
	end
	if type(DataService.GetGems) == "function" then
		result.Gems = DataService.GetGems(player)
	end
	fireClient("RouletteResult", player, result)
	announcePull(player, def)
	PetService.Rolled:Fire(player, petId)
	return true, result
end

-- The optional currency of a spin: nil (the roulette's own), "Tokens" or "Gems" (any case; also { Currency = ... }).
-- Returns "Tokens" | "Gems" | nil, or false for anything else.
local function parseCurrency(currency)
	if currency == nil then
		return nil
	end
	if type(currency) == "table" then
		currency = rawget(currency, "Currency")
		if currency == nil then
			return nil
		end
	end
	if type(currency) ~= "string" or #currency > MAX_CURRENCY_LENGTH then
		return false
	end
	local lower = string.lower(currency)
	if lower == "gems" or lower == "gem" then
		return "Gems"
	elseif lower == "tokens" or lower == "token" or lower == "cloudtokens" then
		return "Tokens"
	end
	return false
end

-- A gems-only roulette (the Secret roulette at the Storm Altar) by id, or nil. GemService knows them.
local function gemsOnlyRoulette(rouletteId)
	local gems = getGemService()
	if not gems or type(gems.GetRoulette) ~= "function" then
		return nil
	end
	local ok, def = pcall(gems.GetRoulette, rouletteId)
	if ok and type(def) == "table" and def.GemsOnly == true then
		return def
	end
	return nil
end

-- A spin paid in Gems: GemService quotes it (gem price, PolicyService check, the roulette's roll), then the shared
-- roll charges the Gems and grants in one non-yielding step.
local function buyWithGems(player, profile, rouletteId)
	local gems = getGemService()
	if not gems or type(gems.Quote) ~= "function" or type(DataService.SpendGems) ~= "function" or type(DataService.GetGems) ~= "function" then
		return false, "Gem roulettes are not available right now"
	end
	local okQuote, ok, quote = pcall(gems.Quote, player, rouletteId)
	if not okQuote then
		warn("[PetService] GemService.Quote errored: " .. tostring(ok))
		return false, "Gem roulettes are not available right now"
	end
	if not ok then
		return false, type(quote) == "string" and quote or "Gem roulettes are not available right now"
	end
	local price = type(quote) == "table" and quote.Price or nil
	if type(price) ~= "number" or price ~= price or price < 1 or price ~= math.floor(price) or price > 1e9 then
		return false, "Gem roulettes are not available right now"
	end
	if DataService.GetGems(player) < price then
		return false, "Not enough Gems"
	end
	local roll = type(quote.Roll) == "function" and quote.Roll or nil
	return rollAndGrant(player, profile, rouletteId, function()
		if DataService.SpendGems(player, price) then
			return true
		end
		return false, "Not enough Gems"
	end, roll, { AllowSecret = quote.AllowSecret == true, Currency = "Gems", Price = price })
end

function PetService.BuyRoulette(player, rouletteId, currency)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(rouletteId) ~= "string" then
		return false, "Unknown roulette"
	end
	local paidWith = parseCurrency(currency)
	if paidWith == false then
		return false, "Unknown currency"
	end
	local roulette = roulettes[rouletteId]
	if not roulette then
		-- not a token roulette: a gems-only one (the Secret roulette) is paid in Gems even when no currency is named
		local gemsOnly = gemsOnlyRoulette(rouletteId)
		if not gemsOnly then
			return false, "Unknown roulette"
		end
		if paidWith == "Tokens" then
			return false, tostring(gemsOnly.DisplayName or "That roulette") .. " takes Gems only"
		end
		paidWith = "Gems"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "The shop is closed during a match"
	end
	if not PetCatalog or type(PetCatalog.RollPet) ~= "function" or type(PetCatalog.Get) ~= "function" then
		return false, "Pets are unavailable right now"
	end
	local profile = DataService.GetProfile(player)
	if not profile then
		return false, "Your data is still loading"
	end
	if paidWith == "Gems" then
		return buyWithGems(player, profile, rouletteId)
	end
	local price = roulette.Price
	if DataService.GetTokens(player) < price then
		return false, "Not enough cloud tokens"
	end
	return rollAndGrant(player, profile, rouletteId, function()
		if DataService.SpendTokens(player, price) then
			return true
		end
		return false, "Not enough cloud tokens"
	end, nil, { AllowSecret = roulette.AllowSecret == true, Currency = "Tokens", Price = price })
end

----------------------------------------------------------------------
-- Remotes (client -> server). Rate limited and type checked.
----------------------------------------------------------------------

local function connectRemotes()
	if remotesConnected then
		return
	end
	local okBuy, buyRemote = pcall(Remotes.Get, "BuyRoulette")
	local okEquip, equipRemote = pcall(Remotes.Get, "EquipPet")
	local okUnequip, unequipRemote = pcall(Remotes.Get, "UnequipPet")
	if not (okBuy and okEquip and okUnequip) then
		warn("[PetService] pet remotes are missing (did Remotes.Init run?)")
		return
	end
	remotesConnected = true

	-- BuyRoulette(rouletteId, currency|nil): currency "Tokens" / "Gems" (or nil: the roulette's own), see BuyRoulette
	buyRemote.OnServerEvent:Connect(function(player, rouletteId, currency)
		if rateLimited(player, "BuyRoulette", REMOTE_COOLDOWN) then
			return
		end
		if type(rouletteId) ~= "string" or #rouletteId > MAX_ID_LENGTH then
			return
		end
		local ok, success, info = pcall(PetService.BuyRoulette, player, rouletteId, currency)
		if not ok then
			warn("[PetService] BuyRoulette errored: " .. tostring(success))
			success, info = false, "Something went wrong, try again"
		end
		if not success then
			local answer = {
				Ok = false,
				Reason = tostring(info),
				RouletteId = rouletteId,
				Tokens = DataService.GetTokens(player),
			}
			if type(DataService.GetGems) == "function" then
				answer.Gems = DataService.GetGems(player)
			end
			if parseCurrency(currency) == "Gems" or gemsOnlyRoulette(rouletteId) then
				answer.Currency = "Gems"
			end
			fireClient("RouletteResult", player, answer)
		end
	end)

	local function handleEquip(remoteName, fn)
		return function(player, petId)
			if rateLimited(player, remoteName, REMOTE_COOLDOWN) then
				return
			end
			if type(petId) ~= "string" or #petId > MAX_ID_LENGTH then
				return
			end
			local ok, success, reason = pcall(fn, player, petId)
			if not ok then
				warn("[PetService] " .. remoteName .. " errored: " .. tostring(success))
				return
			end
			if not success and reason then
				notify(player, tostring(reason), "bad", 3)
			end
		end
	end
	equipRemote.OnServerEvent:Connect(handleEquip("EquipPet", PetService.Equip))
	unequipRemote.OnServerEvent:Connect(handleEquip("UnequipPet", PetService.Unequip))
end

----------------------------------------------------------------------
-- Roulette machines in the lobby: one ProximityPrompt each
----------------------------------------------------------------------

local function buildPrompts(lobbyInfo)
	for _, prompt in ipairs(promptObjects) do
		if prompt.Parent then
			prompt:Destroy()
		end
	end
	promptObjects = {}

	local shop = type(lobbyInfo) == "table" and lobbyInfo.Shop
	local machines = type(shop) == "table" and shop.Roulettes
	if type(machines) ~= "table" then
		warn("[PetService] lobbyInfo.Shop.Roulettes missing: no roulette prompts created")
		return
	end

	for _, roulette in ipairs(Config.Roulettes) do
		local machine = machines[roulette.Id]
		local part = type(machine) == "table" and machine.PromptPart
		if part and typeof(part) == "Instance" then
			local old = part:FindFirstChild(PROMPT_NAME)
			if old then
				old:Destroy()
			end
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = PROMPT_NAME
			prompt.ActionText = "Open"
			prompt.ObjectText = roulette.DisplayName
			prompt.HoldDuration = 0
			prompt.MaxActivationDistance = 12
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			table.insert(promptObjects, prompt)

			local rouletteId = roulette.Id
			prompt.Triggered:Connect(function(player)
				if not isLivePlayer(player) then
					return
				end
				if player:GetAttribute(Config.Attr.InMatch) == true then
					return
				end
				if rateLimited(player, "Prompt_" .. rouletteId, PROMPT_COOLDOWN) then
					return
				end
				fireClient("OpenPanel", player, "Shop", { Tab = "Roulette", RouletteId = rouletteId })
			end)
		else
			warn("[PetService] no PromptPart for roulette " .. tostring(roulette.Id))
		end
	end
end

----------------------------------------------------------------------
-- Player lifecycle
----------------------------------------------------------------------

local function onPlayerAdded(player)
	if DataService.GetProfile(player) then
		task.spawn(onProfileReady, player)
	end
end

local function connectPlayers()
	if playersConnected then
		return
	end
	playersConnected = true

	DataService.ProfileLoaded:Connect(function(player)
		onProfileReady(player)
	end)
	DataService.ProfileRebased:Connect(function(player)
		onProfileReady(player)
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		perkState[player] = nil
		lastCall[player] = nil
		infoState[player] = nil
	end)
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function PetService.Init(lobbyInfo, deps)
	if type(deps) == "table" then
		if deps.DataService then
			DataService = deps.DataService
		end
	end
	if type(DataService.Init) == "function" then
		pcall(DataService.Init)
	end
	if not PetCatalog then
		warn("[PetService] PetCatalog is missing: roulettes and equipping are limited")
	end
	connectRemotes()
	connectPlayers()
	buildPrompts(lobbyInfo)
end

return PetService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="856">
          <Properties>
            <string name="Name">PlayerService</string>
            <string name="Source"><![CDATA[-- PlayerService: per-player lifecycle, spawn placement, humanoid setup, leaderstats, lobby rules.
--
-- * PlayerAdded: attributes, leaderstats, saved profile (via DataService).
-- * CharacterAdded: perk-aware humanoid stats, placement, brief spawn i-frames.
--     placement order: spawn provider (match checkpoint) -> own spot (lobby respawns only)
--                      -> scattered plaza spawn (first spawn, or no spot).
-- * Perk-aware max health: Main hands us PetService.GetPerks via SetPerkProvider(fn) and calls
--   RefreshMaxHealth(player) whenever PetService.PerksChanged fires. A refresh keeps the health
--   FRACTION (a half-health player stays at half health with the new maximum).
-- * 0.5s lobby loop: players who fall off the lobby are sent back (no damage), the lobby keeps
--   everybody at full health, and max health self-heals if it ever drifts from the perks.
-- * PlayerRemoving: save + cleanup (DataService decides when the profile cache entry is released:
--   never while the final save failed).
--
-- Public API (ARCHITECTURE.md + v2):
--   Init(lobbyInfo)  SetSpawnProvider(fn)  SetPerkProvider(fn)  SetHomeProvider(fn)
--   SendToLobby(player)  GetLobbySpawnCFrame()  ApplyHumanoidStats(player)
--   GetMaxHealth(player)  RefreshMaxHealth(player)
--   SpawnPlayer(player) -> bool   HasSpawned(player) -> bool          (Phase 5, 7.2)
--
-- Phase 5 spawn gate (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2, judge M7 / C17): the SERVER holds the
-- character until the main menu's PLAY. Init sets Players.CharacterAutoLoads = false for the server's life (Main's
-- boot gate never re-enables it once SpawnPlayer exists), so every character is loaded here:
--   * Config.MainMenu.Enabled = true: PlayerAdded only records the player as waiting; the remote MenuPlay (c->s, no
--     args, the first one per session counts, 1 per second) or a Config.MainMenu.FallbackSeconds (90) timer calls
--     SpawnPlayer. A client that never sends MenuPlay (old client, script error, exploit) still spawns after 90 s (Y13).
--   * Config.MainMenu.Enabled = false: the character spawns at once on PlayerAdded (the Phase 4 behaviour).
--   * After the first spawn, Humanoid.Died -> task.delay(Players.RespawnTime) -> a new character (Roblox's automatic
--     respawn is off); the lobby loop also respawns a spawned player whose character vanished without dying.
-- SpawnPlayer = one player:LoadCharacter(), idempotent: skipped when the player left or already has a live character.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local DamageService = require(script.Parent.DamageService)

local PlayerService = {}

local SCATTER_RADIUS = 8 -- studs; plaza spawns are spread so players don't stack
local LOBBY_TICK = 0.5 -- seconds between lobby safety checks
local SPAWN_IFRAMES = 1.5 -- seconds of protection after every (re)spawn
local SAFE_MARGIN = 15 -- studs above KillY a position must be to count as "last safe"

local lobbySpawn = CFrame.new(Config.Lobby.Origin + Vector3.new(0, 3, 0))
local spawnProvider = nil -- fn(player) -> CFrame|nil   (match checkpoint)
local perkProvider = nil -- fn(player) -> { MaxHealth = fraction, ... }|nil
local homeProvider = nil -- fn(player) -> CFrame|nil    (the owner's lobby spot)
local initialized = false
local running = false
local perkWarned = false
-- perPlayer[player] = { Conns = { RBXScriptConnection... }, Spawned = bool, LastSafe = Vector3|nil }
local perPlayer = {}
local rng = Random.new()
-- Phase 5 spawn gate state (7.2). Tests read it through PlayerService._St.
--   waiting[player] = true until the first spawn; timers[player] = the fallback thread; played[player] = the clock of the
--   accepted MenuPlay (only the first counts); lastPlay[player] = the clock of the last MenuPlay (1/s rate);
--   spawned[player] = true after the first SpawnPlayer; respawning[player] = true while a respawn is scheduled
local Spawn = { St = { waiting = {}, timers = {}, played = {}, lastPlay = {}, spawned = {}, respawning = {}, missing = {} } }
PlayerService._St = Spawn.St

----------------------------------------------------------------------
-- Placement helpers
----------------------------------------------------------------------

-- A plaza spawn CFrame nudged to a random spot near the spawn point.
local function scatteredLobbyCFrame()
	local angle = rng:NextNumber(0, math.pi * 2)
	local radius = math.sqrt(rng:NextNumber(0, 1)) * SCATTER_RADIUS
	return lobbySpawn * CFrame.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- The owner's spot spawn, or nil when the player has none (or the provider is not wired).
local function homeCFrameFor(player)
	if not homeProvider then
		return nil
	end
	local ok, result = pcall(homeProvider, player)
	if ok and typeof(result) == "CFrame" then
		return result
	end
	if not ok then
		warn("[PlayerService] home provider failed: " .. tostring(result))
	end
	return nil
end

-- Teleport a character and kill any leftover momentum.
local function placeCharacter(char, cframe)
	if not char or not char.Parent then
		return
	end
	local ok, err = pcall(function()
		char:PivotTo(cframe)
	end)
	if not ok then
		warn("[PlayerService] PivotTo failed: " .. tostring(err))
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
end

-- Roblox's built-in "Health" script slowly regenerates health, which would heal players during a
-- match (and un-pin downed players). DamageService is the only authority, so remove it.
local function removeDefaultRegen(char)
	local regen = char:WaitForChild("Health", 3)
	if regen and regen:IsA("Script") then
		regen:Destroy()
	end
end

----------------------------------------------------------------------
-- Perks -> max health
----------------------------------------------------------------------

-- The perk table for a player, or nil (no provider / provider failed / not a table).
local function getPerks(player)
	if not perkProvider then
		return nil
	end
	local ok, perks = pcall(perkProvider, player)
	if ok then
		if type(perks) == "table" then
			return perks
		end
		return nil
	end
	if not perkWarned then
		perkWarned = true
		warn("[PlayerService] perk provider failed: " .. tostring(perks))
	end
	return nil
end

-- Config.Physics.MaxHealth * (1 + MaxHealth perk), rounded to a whole number and never below 1.
function PlayerService.GetMaxHealth(player)
	local bonus = 0
	local perks = getPerks(player)
	if perks then
		local value = perks.MaxHealth
		if type(value) == "number" and value == value then
			local cap = 1
			if Config.Pets and Config.Pets.PerkCaps and type(Config.Pets.PerkCaps.MaxHealth) == "number" then
				cap = Config.Pets.PerkCaps.MaxHealth
			end
			bonus = Util.Clamp(value, 0, cap)
		end
	end
	return math.max(1, math.floor(Config.Physics.MaxHealth * (1 + bonus) + 0.5))
end

-- Re-applies the perk-aware maximum to the live humanoid and KEEPS the health fraction.
-- A downed player keeps their pinned health (DamageService owns it).
function PlayerService.RefreshMaxHealth(player)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local newMax = PlayerService.GetMaxHealth(player)
	local oldMax = humanoid.MaxHealth
	if math.abs(oldMax - newMax) < 0.01 then
		return
	end
	local fraction = 1
	if oldMax > 0 then
		fraction = Util.Clamp(humanoid.Health / oldMax, 0, 1)
	end
	humanoid.MaxHealth = newMax
	if player:GetAttribute(Config.Attr.Downed) ~= true then
		humanoid.Health = math.max(Config.Damage.DownedHealth, math.min(newMax, newMax * fraction))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function PlayerService.GetLobbySpawnCFrame()
	return lobbySpawn
end

-- fn(player) -> CFrame|nil : the match checkpoint to (re)spawn at, nil => lobby.
function PlayerService.SetSpawnProvider(fn)
	if fn == nil or type(fn) == "function" then
		spawnProvider = fn
	else
		warn("[PlayerService] SetSpawnProvider expects a function or nil")
	end
end

-- fn(player) -> { MaxHealth = fraction, ... } (PetService.GetPerks). Applied to everyone right away.
function PlayerService.SetPerkProvider(fn)
	if fn == nil or type(fn) == "function" then
		perkProvider = fn
		perkWarned = false
	else
		warn("[PlayerService] SetPerkProvider expects a function or nil")
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		PlayerService.RefreshMaxHealth(player)
	end
end

-- fn(player) -> CFrame|nil : where a lobby RESPAWN goes (the owner's spot). The first spawn of a
-- session always uses the plaza.
function PlayerService.SetHomeProvider(fn)
	if fn == nil or type(fn) == "function" then
		homeProvider = fn
	else
		warn("[PlayerService] SetHomeProvider expects a function or nil")
	end
end

-- WalkSpeed / JumpPower / MaxHealth (perk-aware) / Health from Config. A downed player keeps
-- their frozen stats and their pinned health so a stray call can never "heal" them.
function PlayerService.ApplyHumanoidStats(player)
	local humanoid = Util.GetHumanoid(player)
	if not humanoid then
		return
	end
	humanoid.UseJumpPower = true
	humanoid.MaxHealth = PlayerService.GetMaxHealth(player)

	if player:GetAttribute(Config.Attr.Downed) == true then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	else
		humanoid.WalkSpeed = Config.Physics.WalkSpeed
		humanoid.JumpPower = Config.Physics.JumpPower
		humanoid.Health = humanoid.MaxHealth
	end

	-- Cosmetic: the custom HUD owns the health display, and auto-jump fights precise parkour.
	pcall(function()
		humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
		humanoid.AutoJumpEnabled = false
	end)
end

-- Clears InMatch/Downed, heals, and puts the player back on the lobby plaza.
function PlayerService.SendToLobby(player)
	if not player or not player.Parent then
		return
	end
	pcall(DamageService.ClearDowned, player)
	player:SetAttribute(Config.Attr.InMatch, false)
	player:SetAttribute(Config.Attr.Downed, false)

	local record = perPlayer[player]
	if record then
		record.LastSafe = nil
	end

	local char = player.Character
	local humanoid = Util.GetHumanoid(player)
	if char and humanoid and humanoid.Health > 0 then
		PlayerService.ApplyHumanoidStats(player)
		placeCharacter(char, scatteredLobbyCFrame())
	end
	-- If the character is dead or missing, the respawn flow places the new one in the lobby
	-- (InMatch is false now, so the spawn provider returns nil).
end

----------------------------------------------------------------------
-- Phase 5 spawn gate (7.2)
----------------------------------------------------------------------

function Spawn.menuEnabled()
	return type(Config.MainMenu) == "table" and Config.MainMenu.Enabled == true
end

function Spawn.hasLiveCharacter(player)
	local char = player.Character
	if not char or not char.Parent then
		return false
	end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	return humanoid == nil or humanoid.Health > 0
end

function Spawn.cancelFallback(player)
	local timer = Spawn.St.timers[player]
	Spawn.St.timers[player] = nil
	if timer and coroutine.running() ~= timer then
		pcall(task.cancel, timer)
	end
end

-- one LoadCharacter; true when a character was loaded
function Spawn.loadCharacter(player)
	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		warn("[PlayerService] LoadCharacter failed for " .. player.Name .. ": " .. tostring(err))
	end
	return ok
end

-- Loads the player's character once: skipped when the player left, is unknown here, or already has a live character.
function PlayerService.SpawnPlayer(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent or not perPlayer[player] then
		return false
	end
	Spawn.St.waiting[player] = nil
	Spawn.cancelFallback(player)
	if Spawn.hasLiveCharacter(player) then
		Spawn.St.spawned[player] = true
		return false
	end
	Spawn.St.spawned[player] = true
	return Spawn.loadCharacter(player)
end

-- True once the player's first spawn happened (MenuPlay, the fallback, or at once with the menu disabled).
function PlayerService.HasSpawned(player)
	return Spawn.St.spawned[player] == true
end

-- Roblox's automatic respawn is off (CharacterAutoLoads = false): a dead character comes back after RespawnTime.
function Spawn.scheduleRespawn(player, char)
	if Spawn.St.respawning[player] then
		return
	end
	Spawn.St.respawning[player] = true
	local delaySeconds = 5
	pcall(function()
		delaySeconds = Players.RespawnTime
	end)
	task.delay(delaySeconds, function()
		Spawn.St.respawning[player] = nil
		if not player.Parent or not perPlayer[player] then
			return
		end
		local current = player.Character
		if current ~= nil and current ~= char and Spawn.hasLiveCharacter(player) then
			return -- something else (a match) already gave the player a new character
		end
		Spawn.loadCharacter(player)
	end)
end

function Spawn.watchDeath(player, char, humanoid)
	humanoid.Died:Connect(function()
		if player.Character == char then
			Spawn.scheduleRespawn(player, char)
		end
	end)
end

-- MenuPlay (c->s, no args): only the first per session counts, at most one per second; junk arguments are ignored.
function Spawn.onMenuPlay(player)
	if typeof(player) ~= "Instance" or not perPlayer[player] then
		return
	end
	local now = os.clock()
	local last = Spawn.St.lastPlay[player]
	if last and now - last < 1 then
		return
	end
	Spawn.St.lastPlay[player] = now
	if Spawn.St.played[player] then
		return
	end
	Spawn.St.played[player] = now
	if Spawn.St.waiting[player] then
		PlayerService.SpawnPlayer(player)
	end
end

-- A new player: wait for PLAY (menu on, with the 90 s fallback) or spawn at once (menu off).
function Spawn.holdOrSpawn(player)
	if Spawn.St.spawned[player] or Spawn.St.waiting[player] then
		return
	end
	if not Spawn.menuEnabled() then
		PlayerService.SpawnPlayer(player)
		return
	end
	Spawn.St.waiting[player] = true
	local seconds = tonumber(Config.MainMenu.FallbackSeconds) or 90
	Spawn.St.timers[player] = task.delay(seconds, function()
		Spawn.St.timers[player] = nil
		if Spawn.St.waiting[player] and player.Parent then
			PlayerService.SpawnPlayer(player)
		end
	end)
end

-- Lobby loop safety net: a spawned player whose character vanished without dying (destroyed, not Died) gets a new one
-- after two quiet seconds.
function Spawn.checkMissing(player)
	if not Spawn.St.spawned[player] or Spawn.St.respawning[player] or Spawn.St.waiting[player] then
		Spawn.St.missing[player] = nil
		return
	end
	local char = player.Character
	if char and char.Parent then
		Spawn.St.missing[player] = nil
		return
	end
	local now = os.clock()
	local since = Spawn.St.missing[player]
	if not since then
		Spawn.St.missing[player] = now
	elseif now - since >= 2 then
		Spawn.St.missing[player] = nil
		Spawn.loadCharacter(player)
	end
end

----------------------------------------------------------------------
-- Character + player lifecycle
----------------------------------------------------------------------

local function onCharacterAdded(player, char)
	local humanoid = char:WaitForChild("Humanoid", 10)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not humanoid or not root then
		return
	end
	-- The player may have left or respawned again while we waited.
	if not player.Parent or player.Character ~= char or not char.Parent then
		return
	end
	local record = perPlayer[player]

	PlayerService.ApplyHumanoidStats(player)

	-- 1. A match checkpoint, when the provider has one for this player.
	local target = nil
	if spawnProvider then
		local ok, result = pcall(spawnProvider, player)
		if ok then
			if typeof(result) == "CFrame" then
				target = result
			end
		else
			warn("[PlayerService] spawn provider failed: " .. tostring(result))
		end
	end
	-- 2. A lobby respawn goes home (the first spawn of a session always uses the plaza).
	if not target and record and record.Spawned and player:GetAttribute(Config.Attr.InMatch) ~= true then
		target = homeCFrameFor(player)
	end
	-- 3. The plaza.
	if not target then
		target = scatteredLobbyCFrame()
	end
	placeCharacter(char, target)
	if record then
		record.Spawned = true
		record.LastSafe = nil
	end

	DamageService.GrantInvulnerability(player, SPAWN_IFRAMES)
	Spawn.watchDeath(player, char, humanoid)
	task.spawn(removeDefaultRegen, char)
end

local function setupPlayer(player)
	if perPlayer[player] then
		return
	end
	local record = { Conns = {}, Spawned = false, LastSafe = nil }
	perPlayer[player] = record

	-- Attributes first so the HUD never reads nil.
	player:SetAttribute(Config.Attr.Tokens, 0)
	player:SetAttribute(Config.Attr.MatchTokens, 0)
	player:SetAttribute(Config.Attr.InMatch, false)
	player:SetAttribute(Config.Attr.Downed, false)

	-- leaderstats.Tokens mirrors the CloudTokens attribute (DataService also pushes into it).
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	local tokensValue = stats:FindFirstChild("Tokens")
	if not tokensValue then
		tokensValue = Instance.new("IntValue")
		tokensValue.Name = "Tokens"
		tokensValue.Value = 0
		tokensValue.Parent = stats
	end

	table.insert(
		record.Conns,
		player:GetAttributeChangedSignal(Config.Attr.Tokens):Connect(function()
			local value = player:GetAttribute(Config.Attr.Tokens)
			if type(value) == "number" then
				tokensValue.Value = math.floor(value)
			end
		end)
	)

	-- Connect before the (yielding) data load so an early character is not missed.
	table.insert(
		record.Conns,
		player.CharacterAdded:Connect(function(char)
			onCharacterAdded(player, char)
		end)
	)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	-- Phase 5 (7.2): hold the character for the main menu, or spawn it now (menu disabled). Before the data load so a
	-- menu-less join gets its character at once, like the Phase 4 automatic spawn.
	Spawn.holdOrSpawn(player)

	-- Saved data. DataService.Load never errors; the pcall is belt and braces.
	pcall(DataService.Load, player)
	if not player.Parent then
		-- Left while loading: PlayerRemoving may already have run its save, so ask DataService to free
		-- the cache. Release is conditional (it keeps an entry that still holds unsaved progress).
		if type(DataService.Release) == "function" then
			pcall(DataService.Release, player)
		end
		return
	end
	-- Phase 5 (7.1): the loading screen waits for the player attribute ProfileLoaded (loaded or provisional). The contract
	-- has DataService write it; until it does, the end of Load (it never errors, provisional included) is the moment.
	local profileAttr = (Config.Attr and Config.Attr.ProfileLoaded) or "ProfileLoaded"
	if player:GetAttribute(profileAttr) ~= true then
		player:SetAttribute(profileAttr, true)
	end
	local okTokens, tokens = pcall(DataService.GetTokens, player)
	if okTokens and type(tokens) == "number" then
		player:SetAttribute(Config.Attr.Tokens, tokens)
		tokensValue.Value = math.floor(tokens)
	end
	-- Pet perks may be known by now; if PetService is slower it fires PerksChanged later.
	PlayerService.RefreshMaxHealth(player)
end

local function onPlayerRemoving(player)
	local record = perPlayer[player]
	perPlayer[player] = nil
	Spawn.cancelFallback(player)
	for _, map in pairs(Spawn.St) do
		map[player] = nil
	end
	if record then
		for _, conn in ipairs(record.Conns) do
			conn:Disconnect()
		end
	end
	-- Save only. Freeing the profile cache entry is DataService's decision (its own PlayerRemoving
	-- handler releases after ITS save): a failed final save must keep the entry for retries.
	pcall(DataService.Save, player)
end

----------------------------------------------------------------------
-- Lobby rules
----------------------------------------------------------------------

-- Where a player who fell off the village goes: their own spot when they fell closer to it than
-- to the plaza, otherwise the plaza.
local function recoverCFrame(player, record)
	if record and record.LastSafe then
		local home = homeCFrameFor(player)
		if home then
			local toHome = (record.LastSafe - home.Position).Magnitude
			local toPlaza = (record.LastSafe - lobbySpawn.Position).Magnitude
			if toHome < toPlaza then
				return home
			end
		end
	end
	return scatteredLobbyCFrame()
end

local function lobbyTick()
	for _, player in ipairs(Players:GetPlayers()) do
		if perPlayer[player] then
			Spawn.checkMissing(player)
		end
		if player:GetAttribute(Config.Attr.InMatch) ~= true then
			local char = player.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if humanoid and root and humanoid.Health > 0 then
				local record = perPlayer[player]
				local y = root.Position.Y
				if y < Config.Lobby.KillY then
					-- Fell off the cloud village: back home / to the plaza, no damage.
					placeCharacter(char, recoverCFrame(player, record))
					if record then
						record.LastSafe = nil
					end
				elseif record and y > Config.Lobby.KillY + SAFE_MARGIN and humanoid.FloorMaterial ~= Enum.Material.Air then
					record.LastSafe = root.Position
				end

				-- Safety net: max health follows the perks even if a PerksChanged event was missed.
				if math.abs(humanoid.MaxHealth - PlayerService.GetMaxHealth(player)) >= 0.5 then
					PlayerService.RefreshMaxHealth(player)
				end
				-- The lobby is safe: keep everybody topped up.
				if humanoid.Health < humanoid.MaxHealth then
					humanoid.Health = humanoid.MaxHealth
				end
			end
		end
	end
end

local function lobbyLoop()
	while running do
		task.wait(LOBBY_TICK)
		if not running then
			break
		end
		local ok, err = pcall(lobbyTick)
		if not ok then
			warn("[PlayerService] lobby loop error: " .. tostring(err))
		end
	end
end

function PlayerService.Init(lobbyInfo)
	if initialized then
		return
	end
	initialized = true

	-- Phase 5 (7.2): the server spawns every character itself (SpawnPlayer) for the server's life
	pcall(function()
		Players.CharacterAutoLoads = false
	end)
	local okRemote, menuPlay = pcall(Remotes.Get, "MenuPlay")
	if okRemote and menuPlay then
		menuPlay.OnServerEvent:Connect(Spawn.onMenuPlay)
	else
		warn("[PlayerService] no MenuPlay remote: players spawn after the fallback timer")
	end

	if type(lobbyInfo) == "table" and typeof(lobbyInfo.SpawnCFrame) == "CFrame" then
		lobbySpawn = lobbyInfo.SpawnCFrame
	else
		warn("[PlayerService] no lobbyInfo.SpawnCFrame; using the default lobby origin")
	end

	Players.PlayerAdded:Connect(setupPlayer)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(setupPlayer, player)
	end

	running = true
	task.spawn(lobbyLoop)
	game:BindToClose(function()
		running = false -- stop the lobby loop on shutdown
	end)
end

return PlayerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="857">
          <Properties>
            <string name="Name">PortalService</string>
            <string name="Source"><![CDATA[-- PortalService (v3 polish, Phase 5 6.3): forms the party on the ONE Sky Obby portal pad (Portal_Obby in the Gate
-- Court), locks the members in until launch and shows the party on the gate's readable tag.
--
-- Standing inside the portal Zone (the "ready pad") puts a player in the party. The first player starts a
-- countdown; a full party shortens it. When it reaches zero the party is handed to MatchService.StartMatch(level,
-- players). MatchService is passed in through Init (no require) so the two services never form a circular
-- dependency. ONE party slot keyed "Obby" (lobbyInfo.Portals.Obby); its level (party.Diff, a Config.Difficulties
-- entry) is mutable:
--   * the level picker (ObbyController, W4) fires Remotes.ObbyPick(levelId) -> PortalService.PickLevel(player,
--     levelId): a string <= 16 chars, a Config difficulty, 4/s burst 4, a loaded profile and ObbyLevels.IsUnlocked on
--     the SERVER copy of Stats.BestTimes -> the player's ObbyLevel attribute; refused: "Beat Medium to unlock Hard";
--     junk is dropped silently. The LEADER's pick before launch also changes the party's level (the countdown gets
--     at least 8 more seconds, the members get "Level: Hard").
--   * the first player on the empty pad picks the level: their ObbyLevel attribute if still unlocked, else their
--     highest unlocked level; anyone may JOIN whatever the level (friends carry friends).
--   * the gate's prompt "ObbyPrompt" (Pick level / Sky Obby, attribute OpenPanel = "Obby") opens the picker.
--
-- Lock-in (asked for after the playtest): a party member is LOCKED on the pad for the whole countdown.
--   * Their character parts move to the collision group NC_PortalLocked. Every pad has five invisible walls
--     (four sides + a ceiling) in NC_PortalWall, which collides ONLY with NC_PortalLocked: everybody else walks
--     straight through, and raycasts / overlap queries (Default group) never see the walls. Walking, jumping
--     and dashing (velocity based) all stop at the walls.
--   * Server safety net: the 5 Hz zone poll puts a locked player who is outside the zone anyway (flung,
--     teleported) back on the pad, with a side toast that explains the Leave button.
--   * The only way out is the Leave button of the party panel (Remotes.LeaveParty, validated + rate-limited):
--     unlock, LEAVE_LOCKOUT, and a step off the pad. Launch, a cancelled countdown, death, a match and leaving
--     the game unlock as well.
--   * While a countdown runs the side walls show a soft ForceField shimmer in the portal colour.
-- Billboard (World text rule, ARCHITECTURE_V3.md): a PIXEL-sized BillboardGui above each gate replaces the
-- studs-sized card LobbyBuilder made: difficulty name + stars, "2/4 players" and a status pill ("Step in to
-- play" / "Starting in 12"). It floats ~27 studs up, so it serves viewers further away.
-- Countdown face (eye level, for friends standing next to the portal): a SurfaceGui in the gate's swirl,
-- facing the plaza, ~11 studs above the pad: "Starting in", a 3.2-stud numeral on a round badge and the head
-- count. Shown only while the pad has a party.
-- The server writes a text only when it changes (at most once per second per line) and mirrors the numbers as
-- attributes on the portal model (PartyCount, PartyMax, Countdown).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local PhysicsService = game:GetService("PhysicsService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Theme = require(Shared.Theme)

local ObbyLevels = nil
do
	local inst = Shared:FindFirstChild("ObbyLevels")
	if inst then
		local ok, mod = pcall(require, inst)
		if ok and type(mod) == "table" then
			ObbyLevels = mod
		end
	end
end

local PortalService = {}

----------------------------------------------------------------------
-- Tunables local to this module
----------------------------------------------------------------------
local POLL = 0.2 -- zone poll period (5 Hz); also the safety-net reaction time
local STATE_INTERVAL = 1 -- PartyState refresh period
local LEAVE_LOCKOUT = 3 -- seconds a player cannot re-join after pressing Leave
local FAILED_LOCKOUT = 4 -- ... after a failed launch
local EJECT_DISTANCE = 12 -- studs the Leave button moves a player off the pad (outside the walls)
local ZONE_HYSTERESIS = 1.5 -- extra studs of tolerance for players already inside (no edge flicker)
local LEAVE_COOLDOWN = 0.5 -- LeaveParty rate limit per player
local PULL_TOAST_COOLDOWN = 5 -- seconds between two "press Leave" toasts after a safety-net pull
local PORTAL_ID = "Obby" -- the one portal (6.3)
local PICK_RATE, PICK_BURST = 4, 4 -- ObbyPick rate limit (per second, burst)
local PICK_EXTEND = 8 -- a leader's re-pick leaves the countdown at least this many seconds
local PICK_MAX_LEN = 16
local PROMPT_RANGE = 12

-- Lock-in walls. The inner faces sit ZONE_HYSTERESIS outside the zone, so a member's root always stays inside
-- the (hysteresis) zone and the safety net never fights the walls.
local LOCK_GROUP = "NC_PortalLocked"
local WALL_GROUP = "NC_PortalWall"
local WALL_THICKNESS = 2
local WALL_HEIGHT = 14 -- studs above the pad surface (a full jump tops out ~10 studs up)
local WALL_DEPTH = 2 -- studs the walls reach below the pad surface
local BARRIER_TRANSPARENCY = 0.55 -- side walls while a countdown runs (ForceField shimmer)
local PAD_ROOT_HEIGHT = 3.2 -- root height above the pad surface for a safety-net placement
local PAD_SPREAD = 2.5 -- members put back on the pad stand on a ring this wide

-- Billboard (pixels; World text rule: names >= 22 px, info lines >= 18 px, compact plate)
local BB = {
	Width = 380, -- transparent container; the plate inside is sized to its text
	Height = 150,
	MaxDistance = 120,
	Gap = 2.5, -- studs between the top of the gate and the bottom of the plate
	NameText = 32,
	InfoText = 21,
	StatusText = 25,
	PlateMinW = 190,
}

-- Countdown face (SurfaceGui, World text rule: 40-60 px per stud, titles >= 1 stud, info lines >= 0.6 stud).
-- Roblox caps TextSize at 100, so the numeral gets a UIScale: 100 px x 1.6 = 160 px = 3.2 studs at 50 px per stud.
local FACE = {
	Width = 8.4, -- studs; corners stay inside the gate ring's 6-stud hole
	Height = 7,
	Thickness = 0.2,
	PPS = 50,
	Lift = 11.2, -- studs above the pad surface when the gate has no SwirlCore
	WallGap = 0.3, -- studs in front of the back lock wall (no ForceField layer between the face and the plaza)
	SwirlGap = 0.6, -- studs in front of the swirl's centre plane
	Disc = 240, -- px: the round numeral badge (4.8 studs)
	TopY = 4, -- px: top of the "Starting in" ribbon (it overlaps the badge's rim)
	DiscY = 178, -- px: badge centre
	CountY = 312, -- px: centre of the head-count pill (it overlaps the badge's bottom)
	NumText = 100,
	NumScale = 1.6,
	TopText = 56, -- 1.12 studs
	CountText = 40, -- 0.8 stud
}

local STAR_FULL = "\226\152\133"
local STAR_EMPTY = "\226\152\134"
local MAX_STARS = 5

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local matchService = nil
local initialized = false
local running = false

local parties = {} -- portal id -> party
local order = {} -- portal ids in lobby order
local playerParty = {} -- Player -> portal id
local lockedUntil = {} -- Player -> clock deadline for re-joining
local mustExit = {} -- Player -> true until they have been seen outside every zone
local starting = {} -- Player -> true while a launched match is being built
local fullNotified = {} -- Player -> portal id they were told is full
local locks = {} -- Player -> { PortalId, Groups = { [BasePart] = previous group }, Conns }
local lastLeave = {} -- Player -> clock of the last accepted LeaveParty
local lastPullToast = {} -- Player -> clock of the last safety-net toast
local pickBuckets = {} -- Player -> { tokens, last } (ObbyPick rate limit)
local dataService = nil -- required lazily (PortalService never needs it at load time)
local groupsReady = false

local remoteCache = {}

-- forward declaration (the lock's Died handler leaves the party)
local removeFromParty

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clock()
	return os.clock()
end

local function copyList(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

local function removeValue(list, value)
	for i = #list, 1, -1 do
		if list[i] == value then
			table.remove(list, i)
		end
	end
end

local function nameOf(player)
	local n = player.DisplayName
	if type(n) ~= "string" or n == "" then
		n = player.Name
	end
	return n
end

local function isPlayer(value)
	return typeof(value) == "Instance" and value:IsA("Player")
end

local function getRemote(name)
	local cached = remoteCache[name]
	if cached then
		return cached
	end
	local ok, remote = pcall(Remotes.Get, name)
	if ok and remote then
		remoteCache[name] = remote
		return remote
	end
	return nil
end

local function fireClient(name, player, ...)
	if not player or player.Parent == nil then
		return
	end
	local remote = getRemote(name)
	if not remote then
		return
	end
	pcall(remote.FireClient, remote, player, ...)
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 3)
end

local function isInMatch(player)
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return true
	end
	-- 5.3 / Y12: a player in a battle or a dungeon run cannot take a pad seat
	local inBattle = player:GetAttribute(Config.Attr.InBattle or "InBattle")
	if inBattle ~= nil and inBattle ~= false and inBattle ~= "" then
		return true
	end
	if matchService and type(matchService.GetMatchOf) == "function" then
		local ok, match = pcall(matchService.GetMatchOf, player)
		if ok and match then
			return true
		end
	end
	return false
end

-- Root part of a living, non-downed character, or nil.
local function getAliveRoot(player)
	if player:GetAttribute(Config.Attr.Downed) == true then
		return nil
	end
	local char = player.Character
	if not char or not char.Parent then
		return nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hum or not root or hum.Health <= 0 then
		return nil
	end
	return root
end

local function zoneAlive(zone)
	return zone ~= nil and zone.Parent ~= nil
end

-- Is `position` inside `zone` (grown by `pad` studs sideways)? The zone reaches a little below its floor and
-- up to the ceiling of the lock walls, so a jump never counts as leaving.
local function inZone(zone, position, pad)
	local rel = zone.CFrame:PointToObjectSpace(position)
	local hs = zone.Size * 0.5
	return math.abs(rel.X) <= hs.X + pad
		and math.abs(rel.Z) <= hs.Z + pad
		and rel.Y >= -hs.Y - 2
		and rel.Y <= hs.Y + 8
end

-- Which portal zone (if any) contains `position`. Players already in `hintId` get a slightly
-- larger zone so standing on the edge does not flicker in and out of the party.
local function zoneAt(position, hintId)
	for _, id in ipairs(order) do
		local zone = parties[id].Info.Zone
		if zoneAlive(zone) then
			local pad = 0
			if hintId == id then
				pad = ZONE_HYSTERESIS
			end
			if inZone(zone, position, pad) then
				return id
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Obby levels (6.3): the server copy of BestTimes decides what a player may pick
----------------------------------------------------------------------
local function getDataService()
	if dataService == nil then
		dataService = false
		local inst = script.Parent:FindFirstChild("DataService")
		if inst then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" then
				dataService = mod
			end
		end
	end
	return dataService or nil
end

-- The player's Stats.BestTimes from the server profile; nil while the profile is not loaded.
local function bestTimesOf(player)
	local ds = getDataService()
	if not ds or type(ds.GetProfile) ~= "function" then
		return nil
	end
	local ok, profile = pcall(ds.GetProfile, player)
	if not ok or type(profile) ~= "table" then
		return nil
	end
	local stats = profile.Stats
	if type(stats) == "table" and type(stats.BestTimes) == "table" then
		return stats.BestTimes
	end
	return {}
end

local function levelUnlocked(bestTimes, levelId)
	if ObbyLevels then
		return ObbyLevels.IsUnlocked(bestTimes, levelId) == true
	end
	local first = Config.Difficulties[1]
	return first ~= nil and first.Id == levelId
end

local function highestLevel(bestTimes)
	local index = ObbyLevels and ObbyLevels.HighestUnlocked(bestTimes) or 1
	return Config.Difficulties[index] or Config.Difficulties[1]
end

-- The level of a party the player starts on the empty pad: their pick (ObbyLevel) while it is still unlocked, else
-- their highest unlocked level.
local function levelForNewParty(player)
	local bestTimes = bestTimesOf(player) or {}
	local picked = player:GetAttribute(Config.Attr.ObbyLevel)
	if type(picked) == "string" and levelUnlocked(bestTimes, picked) then
		local d = Config.GetDifficulty(picked)
		if d then
			return d
		end
	end
	return highestLevel(bestTimes)
end

-- ObbyPick token bucket (PICK_RATE per second, PICK_BURST burst).
local function allowPick(player)
	local t = clock()
	local b = pickBuckets[player]
	if not b then
		b = { Tokens = PICK_BURST, Last = t }
		pickBuckets[player] = b
	end
	b.Tokens = math.min(PICK_BURST, b.Tokens + math.max(0, t - b.Last) * PICK_RATE)
	b.Last = t
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

local function hex(color)
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

----------------------------------------------------------------------
-- Collision groups + lock walls
----------------------------------------------------------------------
-- NC_PortalWall collides with NC_PortalLocked only. Groups registered by other code later keep the engine
-- default (collidable), so this runs again whenever a pad gets locked (cheap, idempotent).
local function setupCollisionGroups()
	for _, name in ipairs({ LOCK_GROUP, WALL_GROUP }) do
		local registered = false
		pcall(function()
			registered = PhysicsService:IsCollisionGroupRegistered(name)
		end)
		if not registered then
			local ok, err = pcall(function()
				PhysicsService:RegisterCollisionGroup(name)
			end)
			if not ok and not groupsReady then
				warn("[PortalService] could not register collision group " .. name .. ": " .. tostring(err))
			end
		end
	end
	local names = { "Default" }
	pcall(function()
		for _, info in ipairs(PhysicsService:GetRegisteredCollisionGroups()) do
			if type(info) == "table" and type(info.name) == "string" and info.name ~= "Default" then
				table.insert(names, info.name)
			end
		end
	end)
	for _, name in ipairs(names) do
		if name ~= LOCK_GROUP then
			pcall(function()
				PhysicsService:CollisionGroupSetCollidable(WALL_GROUP, name, false)
			end)
		end
	end
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(WALL_GROUP, LOCK_GROUP, true)
	end)
	groupsReady = true
end

-- Four side walls + a ceiling around the zone, in the zone's own frame.
local function buildWalls(party)
	local zone = party.Info.Zone
	local parent = party.Info.Model or zone.Parent
	local old = parent:FindFirstChild("LockWalls")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "LockWalls"

	local hs = zone.Size * 0.5
	local ix, iz = hs.X + ZONE_HYSTERESIS, hs.Z + ZONE_HYSTERESIS -- inner faces
	local t = WALL_THICKNESS
	local floorY = -hs.Y -- pad surface in zone space
	local h = WALL_HEIGHT + WALL_DEPTH
	local cy = floorY - WALL_DEPTH + h / 2
	local specs = {
		{ "WallFront", CFrame.new(0, cy, -(iz + t / 2)), Vector3.new(2 * (ix + t), h, t), true },
		{ "WallBack", CFrame.new(0, cy, iz + t / 2), Vector3.new(2 * (ix + t), h, t), true },
		{ "WallLeft", CFrame.new(-(ix + t / 2), cy, 0), Vector3.new(t, h, 2 * iz), true },
		{ "WallRight", CFrame.new(ix + t / 2, cy, 0), Vector3.new(t, h, 2 * iz), true },
		{ "Ceiling", CFrame.new(0, floorY + WALL_HEIGHT + t / 2, 0), Vector3.new(2 * (ix + t), t, 2 * (iz + t)), false },
	}
	local sides = {}
	for _, spec in ipairs(specs) do
		local wall = Instance.new("Part")
		wall.Name = spec[1]
		wall.Anchored = true
		wall.CanCollide = true
		wall.CanTouch = false
		wall.CastShadow = false
		wall.Size = spec[3]
		wall.CFrame = zone.CFrame * spec[2]
		wall.Material = Enum.Material.ForceField
		wall.Color = party.Diff.Color
		wall.Transparency = 1
		wall.TopSurface = Enum.SurfaceType.Smooth
		wall.BottomSurface = Enum.SurfaceType.Smooth
		pcall(function()
			wall.CollisionGroup = WALL_GROUP
		end)
		if wall.CollisionGroup ~= WALL_GROUP then
			wall.CanCollide = false -- no group: a Default wall would block everybody; the safety net still holds the lock
		end
		wall:SetAttribute("PortalId", party.Id)
		wall.Parent = folder
		if spec[4] then
			table.insert(sides, wall)
		end
	end
	folder.Parent = parent
	party.Walls = folder
	party.SideWalls = sides
	party.BarrierOn = false
end

-- Side-wall shimmer on while the pad has a party, off when it is empty.
local function setBarrier(party, on)
	if party.BarrierOn == on or not party.SideWalls then
		return
	end
	party.BarrierOn = on
	for _, wall in ipairs(party.SideWalls) do
		if wall.Parent then
			wall.Transparency = on and BARRIER_TRANSPARENCY or 1
		end
	end
end

----------------------------------------------------------------------
-- Locking players
----------------------------------------------------------------------
local function lockPart(rec, inst)
	if inst:IsA("BasePart") and rec.Groups[inst] == nil then
		rec.Groups[inst] = inst.CollisionGroup
		pcall(function()
			inst.CollisionGroup = LOCK_GROUP
		end)
	end
end

local function unlockPlayer(player)
	local rec = locks[player]
	if not rec then
		return
	end
	locks[player] = nil
	for _, conn in ipairs(rec.Conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	for part, group in pairs(rec.Groups) do
		if part.Parent ~= nil then
			pcall(function()
				if part.CollisionGroup == LOCK_GROUP then
					part.CollisionGroup = group
				end
			end)
		end
	end
	if player.Parent ~= nil then
		player:SetAttribute("PortalLocked", nil)
	end
end

local function lockPlayer(player, id)
	unlockPlayer(player)
	setupCollisionGroups()
	local rec = { PortalId = id, Groups = {}, Conns = {} }
	locks[player] = rec
	local char = player.Character
	if char then
		for _, d in ipairs(char:GetDescendants()) do
			lockPart(rec, d)
		end
		-- accessories / tools added while locked
		table.insert(rec.Conns, char.DescendantAdded:Connect(function(d)
			if locks[player] == rec then
				lockPart(rec, d)
			end
		end))
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			table.insert(rec.Conns, hum.Died:Connect(function()
				if locks[player] == rec then
					removeFromParty(player)
				end
			end))
		end
	end
	table.insert(rec.Conns, player.CharacterRemoving:Connect(function()
		if locks[player] == rec then
			removeFromParty(player)
		end
	end))
	player:SetAttribute("PortalLocked", id)
end

-- A spot on the pad for member `player` (a small ring, so several pulls never stack players inside each other).
local function padCFrame(party, player)
	local zone = party.Info.Zone
	local hs = zone.Size * 0.5
	local index, count = 1, math.max(1, #party.Players)
	for i, p in ipairs(party.Players) do
		if p == player then
			index = i
		end
	end
	local radius = (count > 1) and PAD_SPREAD or 0
	local angle = (index - 1) / count * math.pi * 2
	local pos = zone.CFrame:PointToWorldSpace(Vector3.new(math.cos(angle) * radius, -hs.Y + PAD_ROOT_HEIGHT, math.sin(angle) * radius))
	local look = zone.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.new(pos, pos + flat.Unit)
end

-- Safety net: a locked player outside the zone goes straight back onto the pad.
local function returnToPad(player, party, t)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local cf = padCFrame(party, player)
	pcall(function()
		char:PivotTo(cf)
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	if t - (lastPullToast[player] or -1e9) >= PULL_TOAST_COOLDOWN then
		lastPullToast[player] = t
		notify(player, "You're locked in the portal. Press Leave to step out.", "info", 4)
	end
end

----------------------------------------------------------------------
-- Billboard (pixel-sized, World text rule)
----------------------------------------------------------------------
local INK = Theme.Colors.TextStroke or Theme.Colors.Ink
local GOLD = Theme.Colors.Gold or Theme.Colors.Token
local STAR_OFF = Color3.fromRGB(150, 158, 186)

local function starText(filled)
	filled = math.max(0, math.min(MAX_STARS, math.floor(tonumber(filled) or 1)))
	local out = string.format('<font color="%s">%s</font>', hex(GOLD), string.rep(STAR_FULL, filled))
	if filled < MAX_STARS then
		out = out .. string.format('<font color="%s">%s</font>', hex(STAR_OFF), string.rep(STAR_EMPTY, MAX_STARS - filled))
	end
	return out
end

local function plateLabel(parent, name, text, role, size, color, outlineColor, order)
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Stroke = 1, -- the glyph outline below replaces the classic stroke
		Outline = 2.5,
		OutlineColor = outlineColor or INK,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, size + 4),
			TextWrapped = false,
			LayoutOrder = order or 0,
		},
	})
	label.Parent = parent
	return label
end

local function listLayout(parent, direction, padding)
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = direction
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding)
	layout.Parent = parent
	return layout
end

local function uiPadding(parent, top, side, bottom)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingBottom = UDim.new(0, bottom)
	pad.PaddingLeft = UDim.new(0, side)
	pad.PaddingRight = UDim.new(0, side)
	pad.Parent = parent
	return pad
end

-- World height of the gate's top (the star gems), or a sensible height above the zone.
local function gateTopY(info)
	local top = nil
	local model = info.Model
	if model then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and (d.Name == "StarGem" or d.Name == "StarGemOff") then
				local y = d.Position.Y + 1.1
				if not top or y > top then
					top = y
				end
			end
		end
	end
	if not top and zoneAlive(info.Zone) then
		top = info.Zone.Position.Y + info.Zone.Size.Y * 0.5 + 10
	end
	return top
end

local function billboardAnchor(party)
	local info = party.Info
	local anchor = info.Model and info.Model:FindFirstChild("BillboardAnchor")
	if anchor and anchor:IsA("BasePart") then
		return anchor
	end
	anchor = Instance.new("Part")
	anchor.Name = "BillboardAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanTouch = false
	anchor.CanQuery = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = CFrame.new(info.Zone.Position + Vector3.new(0, 14, 0))
	anchor.Parent = info.Model or info.Zone.Parent
	return anchor
end

-- Phase 5: the gate already carries a pixel tag (WorldStyle.BuildGate's "GateTag": Title / Info / Pill.Label); the
-- party state is written into it (title "Sky Obby", info "Hard ★★★ - 2/4 players", the status pill). true when used.
local function useGateTag(party)
	local info = party.Info
	local tag = info.Billboard
	if typeof(tag) ~= "Instance" or not tag:IsA("BillboardGui") or tag.Name ~= "GateTag" then
		return false
	end
	if not info.StatusLabel or not info.StatusPill then
		return false
	end
	party.Billboard = tag
	party.Pill = info.StatusPill
	party.PillStroke = info.StatusPill:FindFirstChildOfClass("UIStroke")
	party.PillMode = nil
	info.StatusPill.Visible = true
	return true
end

local function buildBillboard(party)
	if useGateTag(party) then
		return
	end
	local info = party.Info
	local diff = party.Diff
	local color = diff.Color
	local anchor = billboardAnchor(party)

	-- the old studs-sized card (text shrank with distance) goes away
	local old = info.Billboard
	if old and old.Parent and old ~= party.Billboard then
		old:Destroy()
	end

	local gui = Instance.new("BillboardGui")
	gui.Name = "PortalBillboard"
	gui.Size = UDim2.fromOffset(BB.Width, BB.Height)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the container's bottom edge sits on the anchor point
	local topY = gateTopY(info)
	local offsetY = 0
	if topY then
		offsetY = topY + BB.Gap - anchor.Position.Y
	end
	gui.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.MaxDistance = BB.MaxDistance
	gui.ClipsDescendants = false
	gui.Adornee = anchor

	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.AnchorPoint = Vector2.new(0.5, 1)
	plate.Position = UDim2.new(0.5, 0, 1, 0)
	plate.Size = UDim2.fromOffset(BB.PlateMinW, 0)
	plate.AutomaticSize = Enum.AutomaticSize.XY
	plate.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- the gradient supplies the colour
	plate.BackgroundTransparency = 0.04
	plate.BorderSizePixel = 0
	Theme.Corner(plate, UDim.new(0, 16))
	Theme.Stroke(plate, Theme.Lighten(color, 0.15), 4, 0)
	Theme.Gradient(plate, Theme.Darken(color, 0.48), Theme.Darken(color, 0.72), 90)
	uiPadding(plate, 8, 18, 10)
	listLayout(plate, Enum.FillDirection.Vertical, 3)
	plate.Parent = gui

	local title = plateLabel(plate, "TitleLabel", diff.DisplayName or diff.Id, "Title", BB.NameText, Theme.Lighten(color, 0.6), Theme.Darken(color, 0.7), 1)

	local infoRow = Instance.new("Frame")
	infoRow.Name = "InfoRow"
	infoRow.BackgroundTransparency = 1
	infoRow.Size = UDim2.fromOffset(0, BB.InfoText + 4)
	infoRow.AutomaticSize = Enum.AutomaticSize.XY
	infoRow.LayoutOrder = 2
	listLayout(infoRow, Enum.FillDirection.Horizontal, 12)
	infoRow.Parent = plate
	local stars = plateLabel(infoRow, "StarLabel", "", "Heading", BB.InfoText, GOLD, INK, 1)
	stars.RichText = true
	stars.Text = starText(diff.Stars)
	local count = plateLabel(infoRow, "CountLabel", "0/" .. tostring(Config.Match.MaxPlayers) .. " players", "Heading", BB.InfoText, Theme.Colors.White, INK, 2)

	local pill = Instance.new("Frame")
	pill.Name = "StatusPill"
	pill.Size = UDim2.fromOffset(0, BB.StatusText + 10)
	pill.AutomaticSize = Enum.AutomaticSize.XY
	pill.BorderSizePixel = 0
	pill.BackgroundTransparency = 0
	pill.LayoutOrder = 3
	Theme.Corner(pill, UDim.new(0, 12))
	local pillStroke = Theme.Stroke(pill, INK, 2.5, 0)
	uiPadding(pill, 3, 14, 4)
	pill.Parent = plate
	local status = plateLabel(pill, "StatusLabel", "Step in to play", "Display", BB.StatusText, Theme.Colors.White, INK, 1)

	gui.Parent = anchor

	party.Billboard = gui
	party.Pill = pill
	party.PillStroke = pillStroke
	party.PillMode = nil
	-- keep the LobbyInfo contract (Billboard + labels) pointing at the live billboard
	info.Billboard = gui
	info.TitleLabel = title
	info.StarLabel = stars
	info.CountLabel = count
	info.StatusLabel = status
end

----------------------------------------------------------------------
-- Countdown face (eye level, SurfaceGui in the gate's swirl)
----------------------------------------------------------------------
-- In the zone's frame (-Z faces the plaza): the swirl's centre, pulled just in front of the back lock wall so
-- viewers on the plaza look through the front wall only. Without a SwirlCore: the back edge of the pad.
local function faceCFrame(party)
	local zone = party.Info.Zone
	local hs = zone.Size * 0.5
	local inner = hs.Z + ZONE_HYSTERESIS -- the back wall's inner face
	local model = party.Info.Model
	local swirl = model and model:FindFirstChild("SwirlCore") -- (the Phase 5 gate has none: the face stands at the back wall)
	local rel
	if swirl and swirl:IsA("BasePart") then
		rel = zone.CFrame:PointToObjectSpace(swirl.Position)
	else
		rel = Vector3.new(0, -hs.Y + FACE.Lift, inner)
	end
	local z = math.min(rel.Z - FACE.SwirlGap, inner - FACE.WallGap - FACE.Thickness / 2)
	return zone.CFrame * CFrame.new(rel.X, rel.Y, z)
end

local function buildFace(party)
	local info = party.Info
	local color = party.Diff.Color
	local parent = info.Model or info.Zone.Parent
	local old = parent:FindFirstChild("CountdownFace")
	if old then
		old:Destroy()
	end

	local part = Instance.new("Part")
	part.Name = "CountdownFace"
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(FACE.Width, FACE.Height, FACE.Thickness)
	part.CFrame = faceCFrame(party)
	part:SetAttribute("PortalId", party.Id)

	local gui = Instance.new("SurfaceGui")
	gui.Name = "CountdownGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = FACE.PPS
	gui.CanvasSize = Vector2.new(FACE.Width * FACE.PPS, FACE.Height * FACE.PPS)
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Enabled = false -- shown while the pad has a party
	gui.Adornee = part

	-- round badge: portal-coloured gradient, gold rim, a soft inner ring
	local disc = Instance.new("Frame")
	disc.Name = "Disc"
	disc.AnchorPoint = Vector2.new(0.5, 0.5)
	disc.Position = UDim2.new(0.5, 0, 0, FACE.DiscY)
	disc.Size = UDim2.fromOffset(FACE.Disc, FACE.Disc)
	disc.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- the gradient supplies the colour
	disc.BackgroundTransparency = 0.04
	disc.BorderSizePixel = 0
	Theme.Corner(disc, UDim.new(0.5, 0))
	local discStroke = Theme.Stroke(disc, GOLD, 9, 0)
	Theme.Gradient(disc, Theme.Darken(color, 0.38), Theme.Darken(color, 0.74), 90)
	disc.Parent = gui
	local ring = Instance.new("Frame")
	ring.Name = "Ring"
	ring.AnchorPoint = Vector2.new(0.5, 0.5)
	ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromOffset(FACE.Disc - 26, FACE.Disc - 26)
	ring.BackgroundTransparency = 1
	Theme.Corner(ring, UDim.new(0.5, 0))
	Theme.Stroke(ring, Theme.Lighten(color, 0.35), 3, 0.35)
	ring.Parent = disc

	-- the numeral fills the badge box (its UIScale grows it around the centre)
	local num = Theme.Label("0", "Display", {
		Size = FACE.NumText,
		Color = Theme.Colors.White,
		Stroke = 1,
		Outline = 6,
		OutlineColor = INK,
		Props = {
			Name = "NumeralLabel",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromScale(1, 1),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = 3,
		},
	})
	local numScale = Instance.new("UIScale")
	numScale.Scale = FACE.NumScale
	numScale.Parent = num
	num.Parent = disc

	-- "Starting in" ribbon over the badge's top edge
	local top = Instance.new("Frame")
	top.Name = "TopPill"
	top.AnchorPoint = Vector2.new(0.5, 0)
	top.Position = UDim2.new(0.5, 0, 0, FACE.TopY)
	top.Size = UDim2.fromOffset(0, FACE.TopText + 12)
	top.AutomaticSize = Enum.AutomaticSize.X
	top.BackgroundColor3 = GOLD
	top.BorderSizePixel = 0
	top.ZIndex = 4
	Theme.Corner(top, UDim.new(0, 22))
	local topStroke = Theme.Stroke(top, Theme.Darken(GOLD, 0.7), 5, 0)
	uiPadding(top, 3, 24, 5)
	top.Parent = gui
	local topLabel = plateLabel(top, "TopLabel", "Starting in", "Title", FACE.TopText, Theme.Colors.White, Theme.Darken(GOLD, 0.66), 1)
	topLabel.ZIndex = 5
	local topOutline = topLabel:FindFirstChild("TextOutline")
	if topOutline then
		topOutline.Thickness = 4
	end

	-- head count under the badge
	local bottom = Instance.new("Frame")
	bottom.Name = "CountPill"
	bottom.AnchorPoint = Vector2.new(0.5, 0.5)
	bottom.Position = UDim2.new(0.5, 0, 0, FACE.CountY)
	bottom.Size = UDim2.fromOffset(0, FACE.CountText + 12)
	bottom.AutomaticSize = Enum.AutomaticSize.X
	bottom.BackgroundColor3 = Theme.Colors.Panel or INK
	bottom.BorderSizePixel = 0
	bottom.ZIndex = 4
	Theme.Corner(bottom, UDim.new(0, 18))
	Theme.Stroke(bottom, Theme.Lighten(color, 0.15), 4, 0)
	uiPadding(bottom, 3, 18, 5)
	bottom.Parent = gui
	local countLabel = plateLabel(bottom, "CountLabel", "0/" .. tostring(Config.Match.MaxPlayers) .. " players", "Heading", FACE.CountText, Theme.Colors.White, INK, 1)
	countLabel.ZIndex = 5
	local countOutline = countLabel:FindFirstChild("TextOutline")
	if countOutline then
		countOutline.Thickness = 3
	end

	gui.Parent = part
	part.Parent = parent

	party.Face = {
		Part = part,
		Gui = gui,
		DiscStroke = discStroke,
		TopPill = top,
		TopStroke = topStroke,
		TopOutline = topOutline,
		Top = topLabel,
		Num = num,
		Count = countLabel,
		Shown = false,
	}
	info.CountdownFace = part
end

----------------------------------------------------------------------
-- Party bookkeeping
----------------------------------------------------------------------
-- Effective launch deadline: the normal timer, or the short "party is full" timer if sooner.
local function effectiveDeadline(party)
	local d = party.BaseDeadline
	if d and party.FullDeadline and party.FullDeadline < d then
		d = party.FullDeadline
	end
	return d
end

local function countdownOf(party, t)
	local d = effectiveDeadline(party)
	if not d then
		return nil
	end
	return math.max(0, math.ceil(d - (t or clock())))
end

local function isFull(party)
	return #party.Players >= Config.Match.MaxPlayers
end

-- Recompute the timers after a join/leave.
local function onMembershipChanged(party)
	local t = clock()
	local n = #party.Players
	setBarrier(party, n > 0)
	if n == 0 then
		party.BaseDeadline = nil
		party.FullDeadline = nil
		return
	end
	if not party.BaseDeadline then
		party.BaseDeadline = t + Config.Match.PartyCountdown
	end
	if isFull(party) then
		if not party.FullDeadline then
			party.FullDeadline = t + Config.Match.FullPartyCountdown
		end
	else
		party.FullDeadline = nil
	end
end

local function setText(label, text, cacheKey, party)
	if party[cacheKey] == text then
		return
	end
	party[cacheKey] = text
	if label then
		pcall(function()
			label.Text = text
		end)
	end
end

local function setModelAttr(party, name, value)
	local model = party.Info.Model
	if model and model.Parent and model:GetAttribute(name) ~= value then
		model:SetAttribute(name, value)
	end
end

-- Status pill colours: the portal colour while idle, gold while a countdown runs.
local function setPillMode(party, mode)
	if party.PillMode == mode or not party.Pill then
		return
	end
	party.PillMode = mode
	local base = (mode == "Countdown") and GOLD or Theme.Darken(party.Diff.Color, 0.2)
	party.Pill.BackgroundColor3 = base
	if party.PillStroke then
		party.PillStroke.Color = Theme.Darken(base, 0.7)
	end
	local outline = party.Info.StatusLabel and party.Info.StatusLabel:FindFirstChild("TextOutline")
	if outline then
		outline.Color = Theme.Darken(base, 0.66)
	end
	-- the face's ribbon and badge rim follow: gold while counting down, the portal colour while waiting
	local face = party.Face
	if face then
		face.TopPill.BackgroundColor3 = base
		face.TopStroke.Color = Theme.Darken(base, 0.7)
		if face.TopOutline then
			face.TopOutline.Color = Theme.Darken(base, 0.66)
		end
		face.DiscStroke.Color = (mode == "Countdown") and GOLD or Theme.Lighten(party.Diff.Color, 0.2)
	end
end

-- The eye-level face: hidden on an empty pad, otherwise "Starting in" / the seconds / the head count.
local function refreshFace(party, n, seconds, mode)
	local face = party.Face
	if not face then
		return
	end
	local shown = n > 0
	if face.Shown ~= shown then
		face.Shown = shown
		pcall(function()
			face.Gui.Enabled = shown
		end)
	end
	if not shown then
		return
	end
	local max = Config.Match.MaxPlayers
	setText(face.Top, (mode == "Countdown") and "Starting in" or "Waiting...", "LastFaceTop", party)
	setText(face.Num, tostring(seconds or 0), "LastFaceNum", party)
	local count
	if isFull(party) then
		count = string.format("Full! %d/%d", n, max)
	else
		count = string.format("%d/%d players", n, max)
	end
	setText(face.Count, count, "LastFaceCount", party)
end

-- Billboard above the portal: "2/4 players" and the status pill.
local function refreshLabels(party)
	local info = party.Info
	local n = #party.Players
	local max = Config.Match.MaxPlayers
	setText(info.CountLabel, string.format("%d/%d players", n, max), "LastCount", party)
	if info.InfoLabel then
		local diff = party.Diff
		local stars = math.max(0, math.min(MAX_STARS, math.floor(tonumber(diff.Stars) or 1)))
		setText(info.InfoLabel, string.format("%s %s - %d/%d players", tostring(diff.DisplayName or diff.Id), string.rep(STAR_FULL, stars), n, max), "LastInfo", party)
	end

	local status, mode
	local seconds = countdownOf(party)
	if n == 0 then
		status, mode = "Step in to play", "Idle"
	elseif n < Config.Match.MinPlayers then
		status, mode = "Waiting for players...", "Idle"
	elseif isFull(party) then
		status, mode = string.format("Full! Starting in %d", seconds or 0), "Countdown"
	else
		status, mode = string.format("Starting in %d", seconds or 0), "Countdown"
	end
	setText(info.StatusLabel, status, "LastStatus", party)
	setPillMode(party, mode)
	refreshFace(party, n, seconds, mode)
	setModelAttr(party, "PartyCount", n)
	setModelAttr(party, "PartyMax", max)
	if n > 0 then
		setModelAttr(party, "Countdown", seconds)
	else
		setModelAttr(party, "Countdown", nil)
	end
end

local function buildPartyState(party)
	local list = {}
	for _, p in ipairs(party.Players) do
		list[#list + 1] = { UserId = p.UserId, Name = nameOf(p) }
	end
	local leader = party.Leader
	return {
		PortalId = party.Id,
		Level = party.Diff.Id, -- Phase 5 (6.3): the party's obby level, its stars and the leader (who may change it)
		Stars = party.Diff.Stars,
		LeaderUserId = leader and leader.UserId or nil,
		DifficultyName = party.Diff.DisplayName,
		Color = party.Diff.Color,
		Players = list,
		Max = Config.Match.MaxPlayers,
		Countdown = countdownOf(party),
		Locked = true, -- members stay on the pad until launch; Leave is the only way out
	}
end

local function sendPartyState(party)
	if #party.Players == 0 then
		return
	end
	local state = buildPartyState(party)
	for _, p in ipairs(party.Players) do
		fireClient("PartyState", p, state)
	end
	party.LastStateAt = clock()
end

-- The party's level changed (a new party, a leader's pick): the model attribute, the old billboard's stars, the pill.
local function applyLevel(party)
	setModelAttr(party, "PartyLevel", party.Diff.Id)
	local info = party.Info
	if info.StarLabel then
		pcall(function()
			info.StarLabel.Text = starText(party.Diff.Stars)
		end)
	end
	party.PillMode = nil
	party.LastInfo = nil
end

local function addToParty(player, id)
	local party = parties[id]
	if not party then
		return false
	end
	if #party.Players == 0 then
		-- the first player on the empty pad picks the level (their pick if still unlocked, else their highest)
		party.Diff = levelForNewParty(player)
		applyLevel(party)
	end
	if isFull(party) then
		if fullNotified[player] ~= id then
			fullNotified[player] = id
			notify(player, "Party is full", "bad", 3)
		end
		return false
	end
	table.insert(party.Players, player)
	party.Leader = party.Players[1]
	playerParty[player] = id
	fullNotified[player] = nil
	lockPlayer(player, id)
	onMembershipChanged(party)
	refreshLabels(party)
	sendPartyState(party) -- everybody's list changed
	notify(player, "You're in the " .. tostring(party.Diff.DisplayName) .. " climb! Press Leave to step out.", "info", 4)
	return true
end

-- Leave the party (no lockout, no teleport) and unlock.
removeFromParty = function(player)
	unlockPlayer(player)
	local id = playerParty[player]
	if not id then
		return
	end
	playerParty[player] = nil
	local party = parties[id]
	if not party then
		return
	end
	removeValue(party.Players, player)
	party.Leader = party.Players[1]
	onMembershipChanged(party)
	refreshLabels(party)
	fireClient("PartyState", player, nil)
	sendPartyState(party)
end

-- Cancel a countdown: everybody is unlocked and leaves; they step out before they can join again.
local function cancelParty(party, message)
	local members = copyList(party.Players)
	local t = clock()
	for _, p in ipairs(members) do
		removeFromParty(p)
		lockedUntil[p] = t + LEAVE_LOCKOUT
		mustExit[p] = true
		if message then
			notify(p, message, "info", 4)
		end
	end
	return #members
end

----------------------------------------------------------------------
-- Launching a match
----------------------------------------------------------------------
local function launch(party)
	local members = copyList(party.Players)

	-- clear the party first: from here on these players belong to MatchService
	for _, p in ipairs(members) do
		playerParty[p] = nil
		unlockPlayer(p)
		starting[p] = true
		fireClient("PartyState", p, nil)
	end
	party.Players = {}
	party.Leader = nil
	local levelId = party.Diff.Id
	onMembershipChanged(party)
	refreshLabels(party)

	task.spawn(function()
		local match = nil
		if matchService and type(matchService.StartMatch) == "function" then
			local ok, result = pcall(matchService.StartMatch, levelId, members)
			if ok then
				match = result
			else
				warn("[PortalService] StartMatch failed: " .. tostring(result))
			end
		else
			warn("[PortalService] MatchService unavailable")
		end

		local t = clock()
		for _, p in ipairs(members) do
			starting[p] = nil
			if not match and p.Parent ~= nil then
				notify(p, "All sky arenas are busy, try again soon", "bad", 4)
				-- stop the pad from instantly re-forming the same party
				lockedUntil[p] = t + FAILED_LOCKOUT
				mustExit[p] = true
			end
		end
	end)
end

-- Per-party timer: launch when the deadline passes.
local function updateParty(party, t)
	-- drop anybody who vanished without us noticing
	for _, p in ipairs(copyList(party.Players)) do
		if p.Parent == nil then
			removeFromParty(p)
		end
	end

	local n = #party.Players
	if n > 0 and not zoneAlive(party.Info.Zone) then
		cancelParty(party, nil) -- the pad itself is gone
		n = 0
	end
	if n == 0 then
		refreshLabels(party)
		return
	end

	local deadline = effectiveDeadline(party)
	if deadline and t >= deadline then
		if n >= Config.Match.MinPlayers then
			launch(party)
			return
		end
		-- not enough players: the countdown is cancelled (nobody stays locked in an endless wait)
		cancelParty(party, "Not enough players to start. Step in again!")
		refreshLabels(party)
		return
	end

	refreshLabels(party)
	if t - (party.LastStateAt or 0) >= STATE_INTERVAL then
		sendPartyState(party)
	end
end

----------------------------------------------------------------------
-- Poll loop
----------------------------------------------------------------------
local function pollPlayer(player, t)
	if starting[player] then
		return
	end
	local current = playerParty[player]
	local inMatch = isInMatch(player)
	local root = nil
	if not inMatch then
		root = getAliveRoot(player)
	end

	if current then
		local party = parties[current]
		if inMatch or not root or not party then
			-- died, downed, no character, or pulled into a match: the seat (and the lock) ends here
			removeFromParty(player)
			current = nil
		elseif not zoneAlive(party.Info.Zone) then
			return -- updateParty cancels this party
		elseif inZone(party.Info.Zone, root.Position, ZONE_HYSTERESIS) then
			if not locks[player] then
				lockPlayer(player, current) -- a fresh character mid-countdown (should not happen, but never leave a member unlocked)
			end
			return
		else
			-- safety net: locked members cannot walk, jump, dash or get flung out
			returnToPad(player, party, t)
			return
		end
	end

	local zoneId = nil
	if root then
		zoneId = zoneAt(root.Position, nil)
	end
	if zoneId == nil then
		mustExit[player] = nil
		fullNotified[player] = nil
		return
	end

	local until_ = lockedUntil[player]
	if until_ and t >= until_ then
		lockedUntil[player] = nil
		until_ = nil
	end
	if until_ == nil and not mustExit[player] then
		addToParty(player, zoneId)
	end
end

local function pollOnce()
	local t = clock()
	for _, player in ipairs(Players:GetPlayers()) do
		local ok, err = pcall(pollPlayer, player, t)
		if not ok then
			warn("[PortalService] player poll failed: " .. tostring(err))
		end
	end
	for _, id in ipairs(order) do
		local ok, err = pcall(updateParty, parties[id], t)
		if not ok then
			warn("[PortalService] party update failed: " .. tostring(err))
		end
	end
end

local function pollLoop()
	while running do
		local ok, err = pcall(pollOnce)
		if not ok then
			warn("[PortalService] poll error: " .. tostring(err))
		end
		task.wait(POLL)
	end
end

----------------------------------------------------------------------
-- Leave button: unlock, remove from the party and step the player off the pad
----------------------------------------------------------------------
local function ejectFromPad(player, id)
	local party = parties[id]
	local root = Util.GetRoot(player)
	if not party or not root then
		return
	end
	local zone = party.Info.Zone
	local center = party.Info.Center
	if not center and zone then
		center = zone.Position
	end
	if not center then
		return
	end

	-- Move toward the plaza centre (the pads sit near the plaza rim, "outward" would be the void).
	local toPlaza = Vector3.new(Config.Lobby.Origin.X - center.X, 0, Config.Lobby.Origin.Z - center.Z)
	if toPlaza.Magnitude < 0.001 then
		toPlaza = Vector3.new(0, 0, 1)
	end
	local dir = toPlaza.Unit
	local target = center + dir * EJECT_DISTANCE

	local y = root.Position.Y
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character }
		local hit = Workspace:Raycast(Vector3.new(target.X, root.Position.Y + 6, target.Z), Vector3.new(0, -40, 0), params)
		if hit then
			y = hit.Position.Y + 3.2
		end
	end)

	local pos = Vector3.new(target.X, y, target.Z)
	pcall(function()
		player.Character:PivotTo(CFrame.new(pos, pos + dir))
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	end)
end

local function onLeaveParty(player)
	if not isPlayer(player) then
		return
	end
	local id = playerParty[player]
	if not id then
		return
	end
	local t = clock()
	if t - (lastLeave[player] or -1e9) < LEAVE_COOLDOWN then
		return
	end
	lastLeave[player] = t
	removeFromParty(player) -- unlocks first, so the step off the pad never meets a wall
	lockedUntil[player] = t + LEAVE_LOCKOUT
	mustExit[player] = true
	ejectFromPad(player, id)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- lobbyInfo: LobbyBuilder.Build() result; matchServiceArg: the MatchService module.
function PortalService.Init(lobbyInfo, matchServiceArg)
	matchService = matchServiceArg or matchService
	if initialized then
		return
	end
	initialized = true

	local okGroups, errGroups = pcall(setupCollisionGroups)
	if not okGroups then
		warn("[PortalService] collision groups: " .. tostring(errGroups))
	end

	-- Phase 5 (6.3): ONE party slot, the Sky Obby portal (lobbyInfo.Portals.Obby)
	local portals = (lobbyInfo and lobbyInfo.Portals) or {}
	local info = portals[PORTAL_ID]
	if info and not info.Zone then
		warn("[PortalService] the Obby portal has no Zone")
		info = nil
	end
	if info then
		parties[PORTAL_ID] = {
			Id = PORTAL_ID,
			Info = info,
			Diff = Config.Difficulties[1],
			Players = {},
			Leader = nil,
			BaseDeadline = nil,
			FullDeadline = nil,
			LastStateAt = 0,
		}
		table.insert(order, PORTAL_ID)
	else
		warn("[PortalService] the lobby has no Obby portal")
	end
	for _, id in ipairs(order) do
		local party = parties[id]
		local okWalls, errWalls = pcall(buildWalls, party)
		if not okWalls then
			warn("[PortalService] lock walls for " .. id .. ": " .. tostring(errWalls))
		end
		local okBoard, errBoard = pcall(buildBillboard, party)
		if not okBoard then
			warn("[PortalService] billboard for " .. id .. ": " .. tostring(errBoard))
		end
		local okFace, errFace = pcall(buildFace, party)
		if not okFace then
			party.Face = nil
			warn("[PortalService] countdown face for " .. id .. ": " .. tostring(errFace))
		end
		applyLevel(party)
		refreshLabels(party)
		local okPrompt, errPrompt = pcall(PortalService._MakePrompt, party.Info)
		if not okPrompt then
			warn("[PortalService] ObbyPrompt: " .. tostring(errPrompt))
		end
	end

	local okPick, pickRemote = pcall(Remotes.Get, "ObbyPick")
	if okPick and pickRemote then
		pickRemote.OnServerEvent:Connect(function(player, levelId)
			local ok, err = pcall(PortalService.PickLevel, player, levelId)
			if not ok then
				warn("[PortalService] ObbyPick: " .. tostring(err))
			end
		end)
	else
		warn("[PortalService] ObbyPick remote unavailable")
	end

	local okRemote, leaveRemote = pcall(Remotes.Get, "LeaveParty")
	if okRemote and leaveRemote then
		leaveRemote.OnServerEvent:Connect(onLeaveParty)
	else
		warn("[PortalService] LeaveParty remote unavailable")
	end

	Players.PlayerRemoving:Connect(function(player)
		removeFromParty(player)
		lockedUntil[player] = nil
		mustExit[player] = nil
		starting[player] = nil
		fullNotified[player] = nil
		lastLeave[player] = nil
		lastPullToast[player] = nil
		pickBuckets[player] = nil
	end)

	running = true
	task.spawn(pollLoop)
end

-- Leave the current party (no-op when not in one) and unlock. No lockout, no teleport.
function PortalService.RemovePlayer(player)
	removeFromParty(player)
end

function PortalService.GetParty(portalId)
	local party = parties[portalId or PORTAL_ID]
	if not party then
		return { Players = {}, Countdown = nil }
	end
	return { Players = copyList(party.Players), Countdown = countdownOf(party), Level = party.Diff.Id, Leader = party.Leader }
end

-- The Obby gate's prompt (6.3): "Pick level" / "Sky Obby", OpenPanel = "Obby" (ObbyController opens the picker).
function PortalService._MakePrompt(info)
	local part = info and info.PromptPart
	if typeof(part) ~= "Instance" or not part:IsA("BasePart") then
		return nil
	end
	local old = part:FindFirstChild("ObbyPrompt")
	if old then
		old:Destroy()
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ObbyPrompt"
	prompt.ActionText = "Pick level"
	prompt.ObjectText = "Sky Obby"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = PROMPT_RANGE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("OpenPanel", "Obby")
	prompt.Parent = part
	return prompt
end

-- ObbyPick (6.3, Y10): validates on the server copy of the profile and writes the player's ObbyLevel attribute; a
-- party LEADER's pick before launch also moves the party's level. Returns ok, reason ("junk" | "rate" | "profile" |
-- "locked"); junk is dropped silently, a locked level answers "Beat Medium to unlock Hard".
function PortalService.PickLevel(player, levelId)
	if not isPlayer(player) then
		return false, "junk"
	end
	if type(levelId) ~= "string" or #levelId == 0 or #levelId > PICK_MAX_LEN then
		return false, "junk"
	end
	local diff = Config.GetDifficulty(levelId)
	if not diff then
		return false, "junk"
	end
	if not allowPick(player) then
		return false, "rate"
	end
	local bestTimes = bestTimesOf(player)
	if not bestTimes then
		return false, "profile"
	end
	if not levelUnlocked(bestTimes, levelId) then
		local index = (ObbyLevels and ObbyLevels.IndexOf(levelId)) or 1
		local prev = Config.Difficulties[math.max(1, index - 1)] or diff
		notify(player, string.format("Beat %s to unlock %s", tostring(prev.DisplayName or prev.Id), tostring(diff.DisplayName or diff.Id)), "bad", 3)
		return false, "locked"
	end
	if player:GetAttribute(Config.Attr.ObbyLevel) ~= levelId then
		player:SetAttribute(Config.Attr.ObbyLevel, levelId)
	end
	local party = parties[playerParty[player] or ""]
	if party and party.Leader == player and #party.Players > 0 and not starting[player] and party.Diff.Id ~= levelId then
		party.Diff = diff
		local t = clock()
		party.BaseDeadline = math.max(party.BaseDeadline or t, t + PICK_EXTEND)
		if party.FullDeadline then
			party.FullDeadline = math.max(party.FullDeadline, t + PICK_EXTEND)
		end
		applyLevel(party)
		for _, p in ipairs(party.Players) do
			if p ~= player then
				notify(p, "Level: " .. tostring(diff.DisplayName or diff.Id), "info", 3)
			end
		end
		refreshLabels(party)
		sendPartyState(party)
	end
	return true
end

-- true, portalId while `player` is locked inside a portal pad (waiting for its countdown).
function PortalService.IsLocked(player)
	local rec = locks[player]
	if rec then
		return true, rec.PortalId
	end
	return false, nil
end

-- Cancels a running countdown: every member is unlocked and removed (they must step out before re-joining).
-- Returns how many players were in the party.
function PortalService.CancelParty(portalId, message)
	local party = parties[portalId]
	if not party then
		return 0
	end
	local n = cancelParty(party, message)
	refreshLabels(party)
	return n
end

-- Stops the poll loop and releases everybody (not needed in normal play; handy for tests / shutdown).
function PortalService.Stop()
	running = false
	for _, id in ipairs(order) do
		pcall(PortalService.CancelParty, id, nil)
	end
end

return PortalService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="858">
          <Properties>
            <string name="Name">SpotService</string>
            <string name="Source"><![CDATA[-- SpotService: the home plots on the outer lobby ring (one per player, claimed with E at the gate).
--
-- * Claiming (ARCHITECTURE_V3.md "Phase 2: Tycoon homes"; replaces the v2 auto-assignment): nobody gets a plot on
--   join. Each free plot's gate carries a "Claim Home" ProximityPrompt (HomeBuilder builds it, TycoonService handles
--   it and calls SpotService.Claim). One plot per player, refused during a match; the plot is the player's for the
--   session and is released when they leave (TycoonService clears the build, the gate reads "Claim Home" again).
--   The claimed index is mirrored on the player attribute Config.Attr.SpotIndex (absent while the player has no
--   plot) and remembered in Profile.SpotIndex as the player's LAST plot: a returning player whose last plot is free
--   gets the side toast "Welcome back! Press E at your gate", everyone else "Pick a free home: press E at its gate".
-- * Nameplate (LobbyBuilder builds it: a compact PIXEL-sized tag, World text rule): NameLabel = the owner's display
--   name, SubLabel = "Home Level 12 <bullet> <star><star>" (the Home Level and one star glyph per Prestige;
--   "<star> x7" past five stars),
--   refreshed whenever the home changes; the avatar disc shows the owner's headshot (Players:GetUserThumbnailAsync in
--   pcall, cached per user; the silhouette built from frames is the fallback). Free plots read "Free home" /
--   "Press E at the gate" with a "+" on the disc.
-- * Showcase podium: the owner's best pet (highest rarity, then the better tier: Rainbow > Golden > Normal, then an
--   equipped copy) stands on the podium by the gate with a small name / rarity tag. Pet keys (shared/PetKeys) are
--   understood: a Golden copy or a fused hybrid is built from PetKeys.DefOf. The model is rebuilt only when that
--   pet changes. Replication rule: the server builds it standing still (every part Anchored) and tags it
--   "NC_Showcase" (attributes PetId = the key, PetParts, HoverAmp, Ready); ShowcaseController on each CLIENT welds it
--   locally and hovers / sways / animates it. The server never moves it.
-- * Remotes.GoToSpot (rate limited, refused during a match and in a battle: Phase 4 safe zones): opens the player's
--   home portal (TycoonService.OpenHomePortal: it leads home when the player has a plot, otherwise to the gate of
--   their last plot when it is free, else of the nearest free plot); without TycoonService it teleports directly.
-- * Teleport(player) (TycoonService's portal, the Home tile): home when the player has a plot, otherwise in front of
--   the suggested free gate. Refused during a match, in a battle or ring run (the InBattle attribute) and while dead.
--
-- Public API: Init(lobbyInfo, deps)  GetSpot(player) -> SpotInfo|nil (the CLAIMED plot)  Teleport(player) -> boolean
-- Phase 2 (used by TycoonService; the plot data stays here):
--   Claim(player, index) -> ok, reason        validated: a known plot, free, the player has none, not in a match
--   Release(player) -> index|nil               frees the player's plot (also automatic on leave)
--   GetOwner(index) -> Player|nil, GetSpotByIndex(index) -> SpotInfo|nil, GetSpots() -> { [index] = SpotInfo }
--   FindFreeSpot(position|nil, preferIndex|nil) -> SpotInfo|nil   the preferred plot when free, else the free plot
--                                              nearest to `position` (the lowest index without one)
--   SuggestSpot(player) -> SpotInfo|nil, owned  the claimed plot, else the last plot when free, else the nearest free
--   GateCFrame(spotInfo) -> CFrame              the gate on the ground (LookVector = towards the street)
--   Signals Claimed (player, index), Released (player, index)
-- Extra: Refresh(player) (re-reads the profile now; normally automatic).
-- deps = { DataService = , PetService = }.
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local SpotService = {}
SpotService.Claimed = Util.Signal() -- Fire(player, index)
SpotService.Released = Util.Signal() -- Fire(player, index)

-- "\226\128\162" = bullet, "\226\152\133" = black star (escaped so the file stays plain ASCII).
local BULLET = "\226\128\162"
local STAR = "\226\152\133"
local MAX_STAR_GLYPHS = 5 -- more stars than this read "<star> x7"

local FREE_NAME = "Free home"
local FREE_SUB = "Press E at the gate"

-- Showcase tag (World text rule): pixel-sized, names >= 22 px, info >= 18 px, compact solid plate.
local TAG_W, TAG_H = 300, 96
local TAG_NAME_PX = 26
local TAG_RARITY_PX = 18
local TAG_RANGE = 80
local TAG_LIFT = -1.2 -- studs: the plate's bottom edge sits ~0.7 stud over the highest point of the bob
local INK = Theme.Colors.TextStroke or Theme.Colors.Ink

local SHOWCASE_SCALE = 1.4 -- the podium pet is a bit larger than a follower
local SHOWCASE_TAG = "NC_Showcase" -- ShowcaseController (client) hovers / sways / animates every model with this tag
local HOVER_HEIGHT = 0.9 -- studs between the podium top and the pet's lowest point (the client bobs it +/- HoverAmp)
local BOB_HEIGHT = 0.35 -- studs, +/-: the client's hover amplitude (attribute HoverAmp)
local TIER_ORDER = { Normal = 1, Golden = 2, Rainbow = 3 } -- a better tier wins a rarity tie on the podium
local REFRESH_INTERVAL = 1 -- seconds between profile signature checks
local PROFILE_WAIT = 20 -- give up waiting for a profile after this many seconds
local REMOTE_COOLDOWN = 0.25 -- per player per remote
local HEADSHOT_RETRY = 120 -- seconds before a failed headshot request may be tried again
local WELCOME_DELAY = 4 -- seconds after the profile loaded before the "press E at your gate" toast
local GATE_OUTSIDE = 6 -- studs in front of the gate (street side) where GoToSpot puts a player without a plot
local GATE_LIFT = 3 -- studs above the ground for that placement (the character's root height)
local ATTR_IN_BATTLE = Config.Attr.InBattle or "InBattle" -- BattleService's player attribute (the battle id)
local BATTLE_TEXT = "Finish your battle first!" -- the Arena Gate's refusal text (Phase 4 safe zones)

local initialized = false
local running = false
local dataService = nil
local petService = nil
local spots = {} -- [index] = SpotInfo
local spotCount = 0
local owners = {} -- [index] = Player
local spotOf = {} -- [Player] = index
local conns = {} -- [Player] = { RBXScriptConnection... }
local shows = {} -- [index] = showcase record (see makeShow)
local lastSig = {} -- [index] = last nameplate signature
local lastGo = {} -- [Player] = os.clock() of the last GoToSpot
local welcomed = {} -- [Player] = true once the join toast was scheduled
local headshots = {} -- [userId] = content string : the GetUserThumbnailAsync cache
local headshotFailed = {} -- [userId] = os.clock() of the last failed request (retried after HEADSHOT_RETRY)
local headshotPending = {} -- [userId] = true while a request runs
local refreshQueued = {} -- [Player] = true while a deferred refresh is pending
local notifyRemote = nil
local departed = setmetatable({}, { __mode = "k" }) -- [Player] = true once PlayerRemoving ran

local rarityOrder = {}
local rarityColor = {}
for _, r in ipairs(Config.Rarities or {}) do
	rarityOrder[r.Id] = r.Order or 0
	rarityColor[r.Id] = r.Color
end

----------------------------------------------------------------------
-- Optional shared modules (PetBuilder / PetCatalog are written by other agents)
----------------------------------------------------------------------

local sharedCache = {} -- [name] = module | false

local function loadShared(name)
	local cached = sharedCache[name]
	if cached ~= nil then
		return cached or nil
	end
	sharedCache[name] = false
	local module = Shared:FindFirstChild(name)
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			sharedCache[name] = result
			return result
		end
		warn("[SpotService] could not load " .. name .. ": " .. tostring(result))
	end
	return nil
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function notify(player, text, kind, seconds)
	if not player or not player.Parent then
		return
	end
	if not notifyRemote then
		local ok, remote = pcall(Remotes.Get, "Notify")
		if ok then
			notifyRemote = remote
		end
	end
	if notifyRemote then
		pcall(function()
			notifyRemote:FireClient(player, text, kind or "info", seconds or 3)
		end)
	end
end

local function getProfile(player)
	if dataService and type(dataService.GetProfile) == "function" then
		local ok, profile = pcall(dataService.GetProfile, player)
		if ok and type(profile) == "table" then
			return profile
		end
	end
	return nil
end

-- Phase 4 safe zones: no teleport may pull a player out of a battle or a Champion Ring run (X18).
local function inBattle(player)
	local v = player:GetAttribute(ATTR_IN_BATTLE)
	return v ~= nil and v ~= false and v ~= ""
end

-- TycoonService (a sibling module; it may be absent in a trimmed build): the home portal.
local tycoonCache = nil
local function tycoonService()
	if tycoonCache ~= nil then
		return tycoonCache or nil
	end
	tycoonCache = false
	local module = script.Parent and script.Parent:FindFirstChild("TycoonService")
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			tycoonCache = result
			return result
		end
	end
	return nil
end

local function displayNameOf(player)
	local name = player.DisplayName
	if type(name) ~= "string" or name == "" then
		name = player.Name
	end
	return name
end

local function setText(label, text)
	if not label then
		return
	end
	pcall(function()
		label.Text = text
	end)
end

local function setLabels(index, name, sub)
	local info = spots[index]
	if not info then
		return
	end
	setText(info.NameLabel, name)
	setText(info.SubLabel, sub)
end

-- The nameplate's avatar disc (built by LobbyBuilder; a nameplate without one is simply left alone).
local function avatarOf(index)
	local info = spots[index]
	if not info then
		return nil
	end
	local gui = info.Nameplate
	if typeof(gui) ~= "Instance" and typeof(info.NameLabel) == "Instance" then
		gui = info.NameLabel:FindFirstAncestorOfClass("BillboardGui")
	end
	if typeof(gui) ~= "Instance" then
		return nil
	end
	local disc = gui:FindFirstChild("Avatar", true)
	if disc and disc:IsA("GuiObject") then
		return disc
	end
	return nil
end

-- mode: "Free" (the "+"), "Owned" (silhouette) or "Headshot" (image = the thumbnail content).
local function setAvatar(index, mode, image)
	local disc = avatarOf(index)
	if not disc then
		return
	end
	pcall(function()
		local color = disc:GetAttribute(mode == "Free" and "FreeColor" or "OwnedColor")
		if typeof(color) == "Color3" then
			disc.BackgroundColor3 = color
		end
		local shot = disc:FindFirstChild("Headshot")
		local silhouette = disc:FindFirstChild("Silhouette")
		local free = disc:FindFirstChild("FreeIcon")
		if free then
			free.Visible = mode == "Free"
		end
		if silhouette then
			silhouette.Visible = mode == "Owned"
		end
		if shot then
			shot.Image = (mode == "Headshot" and image) or ""
			shot.Visible = mode == "Headshot"
		end
	end)
end

-- Shows the owner's headshot on their nameplate: cached per user, fetched once in the background (the call
-- yields and fails for Studio test players, so the silhouette stays as the fallback).
local function loadHeadshot(player, index)
	local userId = player.UserId
	local cached = headshots[userId]
	if cached then
		setAvatar(index, "Headshot", cached)
		return
	end
	local failedAt = headshotFailed[userId]
	if headshotPending[userId] or (failedAt and os.clock() - failedAt < HEADSHOT_RETRY) then
		return
	end
	headshotPending[userId] = true
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		headshotPending[userId] = nil
		if ok and type(content) == "string" and content ~= "" then
			headshots[userId] = content
			headshotFailed[userId] = nil
		else
			headshotFailed[userId] = os.clock()
			return
		end
		-- wherever this user owns a home now: matched by UserId, so a player who left and rejoined while the
		-- request ran (a new Player object) still gets it; a home freed meanwhile keeps its "+"
		for index, owner in pairs(owners) do
			if owner.UserId == userId and owner.Parent then
				setAvatar(index, "Headshot", content)
			end
		end
	end)
end

-- Pivot a character somewhere and kill its momentum.
local function placeCharacter(char, cframe)
	if not char or not char.Parent then
		return false
	end
	local ok = pcall(function()
		char:PivotTo(cframe)
	end)
	if not ok then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
	return true
end

----------------------------------------------------------------------
-- Showcase podium
----------------------------------------------------------------------

-- The tag floating above the pet (World text rule): a PIXEL-sized BillboardGui, so it reads the same at any
-- distance: the pet name (big, outlined) over a rarity pill in the rarity colour, on a compact navy plate with a
-- rarity-coloured outline that sizes itself to the text. Its bottom edge sits just over the bobbing pet.
local function tagLabel(parent, name, text, role, size, order)
	local label = Theme.Label(text, role, {
		Size = size,
		Stroke = 1, -- the glyph outline replaces the classic stroke
		Outline = 2.5,
		OutlineColor = INK,
		Props = {
			Name = name,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, size + 4),
			TextWrapped = false,
			LayoutOrder = order,
		},
	})
	label.Parent = parent
	return label
end

local function buildTag(info)
	local anchor = Instance.new("Part")
	anchor.Name = "ShowcaseAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.CFrame = CFrame.new(info.PodiumCFrame.Position + Vector3.new(0, 6, 0))

	local gui = Instance.new("BillboardGui")
	gui.Name = "ShowcaseTag"
	gui.Adornee = anchor
	gui.Size = UDim2.fromOffset(TAG_W, TAG_H)
	gui.SizeOffset = Vector2.new(0, 0.5) -- the bottom edge sits on the anchor (+ TAG_LIFT)
	gui.StudsOffsetWorldSpace = Vector3.new(0, TAG_LIFT, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = TAG_RANGE
	gui.LightInfluence = 0
	gui.ClipsDescendants = false
	gui.Enabled = false

	local card = Instance.new("Frame")
	card.Name = "Card"
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.new(0.5, 0, 1, 0)
	-- minimum width: catalog names are wider anyway; a short hybrid name ("Draar" + "Mythic") still gets a plate
	-- that hugs it (140 left ~75 px of empty plate around it)
	card.Size = UDim2.fromOffset(120, 0)
	card.AutomaticSize = Enum.AutomaticSize.XY
	card.BackgroundColor3 = Color3.fromRGB(255, 255, 255) -- the gradient below sets the real colour
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.Parent = gui
	Theme.Gradient(card, Theme.Colors.PanelLight, Theme.Colors.Panel, 90)
	Theme.Corner(card, UDim.new(0, 14))
	local stroke = Theme.Stroke(card, Theme.Colors.PanelLight, 3.5, 0)
	stroke.Name = "RarityStroke"
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 6)
	pad.PaddingBottom = UDim.new(0, 8)
	pad.PaddingLeft = UDim.new(0, 16)
	pad.PaddingRight = UDim.new(0, 16)
	pad.Parent = card
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 3)
	layout.Parent = card

	local nameLabel = tagLabel(card, "PetName", "", "Title", TAG_NAME_PX, 1)

	local pill = Instance.new("Frame")
	pill.Name = "RarityPill"
	pill.Size = UDim2.fromOffset(0, TAG_RARITY_PX + 8)
	pill.AutomaticSize = Enum.AutomaticSize.XY
	pill.BackgroundColor3 = Theme.Colors.PanelLight
	pill.BorderSizePixel = 0
	pill.LayoutOrder = 2
	pill.Parent = card
	Theme.Corner(pill, UDim.new(0, 10))
	Theme.Stroke(pill, INK, 2.5, 0)
	local pillPad = Instance.new("UIPadding")
	pillPad.PaddingTop = UDim.new(0, 2)
	pillPad.PaddingBottom = UDim.new(0, 3)
	pillPad.PaddingLeft = UDim.new(0, 10)
	pillPad.PaddingRight = UDim.new(0, 10)
	pillPad.Parent = pill
	local rarityLabel = tagLabel(pill, "PetRarity", "", "Heading", TAG_RARITY_PX, 1)

	anchor.Parent = info.Folder or workspace
	gui.Parent = anchor
	return {
		Anchor = anchor,
		Gui = gui,
		NameLabel = nameLabel,
		RarityLabel = rarityLabel,
		RarityPill = pill,
		Stroke = stroke,
	}
end

local function makeShow(index)
	local info = spots[index]
	local show = {
		Index = index,
		PetId = nil, -- the pet key on the podium
		Model = nil,
		Tag = nil,
	}
	local ok, tag = pcall(buildTag, info)
	if ok then
		show.Tag = tag
	else
		warn("[SpotService] could not build the showcase tag: " .. tostring(tag))
	end
	return show
end

local function clearShowModel(show)
	if show.Model then
		pcall(function()
			show.Model:Destroy()
		end)
		show.Model = nil
	end
	if show.Tag and show.Tag.Gui then
		show.Tag.Gui.Enabled = false
	end
end

-- Builds + places the podium pet: `key` is the pet key (nil = empty podium), `def` its def (PetKeys.DefOf or the
-- catalog). The model stands still on the server; the client animates it (SHOWCASE_TAG, see the header).
local function setShowcasePet(index, key, def, stage)
	local show = shows[index]
	local info = spots[index]
	if not show or not info then
		return
	end
	stage = (type(stage) == "number" and stage == stage and stage >= 1) and math.floor(stage) or 0
	if show.PetId == key and (show.Stage or 0) == stage then
		return
	end
	clearShowModel(show)
	show.PetId = key
	show.Stage = stage
	if not key or type(def) ~= "table" then
		return
	end

	local builder = loadShared("PetBuilder")
	if not builder or type(builder.Build) ~= "function" then
		return
	end
	-- Phase 5 (3.7): the podium draws the pet's STORED evolution stage; an evolved model is always built at Low
	local opts = { Detail = "High", Scale = SHOWCASE_SCALE }
	if stage >= 1 then
		opts.Detail = "Low"
		opts.Evolved = (stage >= 2) and 2 or 1
	end
	local podium = info.PodiumCFrame
	-- the finished, placed podium pet (not parented) and its height, or nil
	local function buildShow()
		local okBuild, model = pcall(builder.Build, def, opts)
		if not okBuild or typeof(model) ~= "Instance" then
			warn("[SpotService] PetBuilder.Build failed for " .. tostring(key) .. ": " .. tostring(model))
			return nil, 3
		end

		-- Visual only: nothing may collide, be touched or be hit by raycasts; every part Anchored (the client welds).
		local parts = 0
		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				inst.Anchored = true
				inst.CanCollide = false
				inst.CanTouch = false
				inst.CanQuery = false
				parts = parts + 1
			end
		end

		-- Measure the model at the origin: how far its lowest point sits below the pivot, and its height.
		local bottomOffset = 1.2
		local height = 3
		local okBox = pcall(function()
			model:PivotTo(CFrame.new(0, 0, 0))
			local boxCf, boxSize = model:GetBoundingBox()
			local pivotY = model:GetPivot().Position.Y
			bottomOffset = pivotY - (boxCf.Position.Y - boxSize.Y * 0.5)
			height = boxSize.Y
		end)
		if not okBox and type(builder.GetHeight) == "function" then
			local okH, h = pcall(builder.GetHeight, def)
			if okH and type(h) == "number" then
				height = h * SHOWCASE_SCALE
				bottomOffset = height * 0.5
			end
		end

		-- facing the street like the podium, hovering a little over it (the client bobs it by HoverAmp)
		local rest = podium.Position + Vector3.new(0, HOVER_HEIGHT + bottomOffset, 0)
		model.Name = "ShowcasePet"
		model:PivotTo(CFrame.new(rest) * (podium - podium.Position))
		model:SetAttribute("PetId", key)
		model:SetAttribute("PetParts", parts)
		model:SetAttribute("PB_Evolved", stage)
		model:SetAttribute("HoverAmp", BOB_HEIGHT)
		model:SetAttribute("Ready", true)
		pcall(function()
			CollectionService:AddTag(model, SHOWCASE_TAG)
			CollectionService:AddTag(model, "NC_StyleExempt") -- a pet: WorldStyle.Tags.Exempt (the 6.4 material audit skips it)
		end)
		return model, height
	end
	local model, height = buildShow()
	if not model then
		return
	end
	show.Model = model
	model.Parent = info.Folder or workspace
	-- Phase 6: the mesh pet replaces this Part build once its keys load after boot (MeshLibrary.Swap: same name and
	-- place, re-tagged, so the clients' ShowcaseController picks it up); show.Model follows. Empty MeshIds = nothing.
	if type(builder.SwapWhenReady) == "function" then
		pcall(builder.SwapWhenReady, model, def, opts, function()
			return (buildShow())
		end, function(fresh, old)
			if show.Model == old then
				show.Model = fresh
			end
		end)
	end

	-- Tag: name + rarity, floating above the highest point of the bob.
	local tag = show.Tag
	if tag then
		local color = rarityColor[def.Rarity] or Theme.Colors.PanelLight
		tag.Anchor.CFrame = CFrame.new(podium.Position + Vector3.new(0, HOVER_HEIGHT + height + BOB_HEIGHT + 1.9, 0))
		tag.NameLabel.Text = tostring(def.DisplayName or def.Name or key)
		tag.RarityLabel.Text = tostring(def.Rarity or "")
		tag.RarityPill.BackgroundColor3 = color:Lerp(Theme.Colors.Panel, 0.2)
		-- a very dark rarity colour (Secret) would vanish against the navy plate: lift the outline
		local luma = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
		tag.Stroke.Color = (luma < 0.35) and color:Lerp(Theme.Colors.Muted or Theme.Colors.White, 0.55) or color
		tag.Gui.Enabled = true
	end
end

----------------------------------------------------------------------
-- Nameplate + best pet
----------------------------------------------------------------------

-- Every owned pet copy as { Key, Def }: PetKeys (tiers + hybrids) when it is there, else the plain Pets counts.
local function ownedPets(profile)
	local out = {}
	if type(profile) ~= "table" then
		return out
	end
	local keys = loadShared("PetKeys")
	if keys and type(keys.List) == "function" and type(keys.DefOf) == "function" then
		local ok, list = pcall(keys.List, profile)
		if ok and type(list) == "table" then
			for _, key in ipairs(list) do
				local okDef, def = pcall(keys.DefOf, key, profile)
				if okDef and type(def) == "table" then
					out[#out + 1] = { Key = key, Def = def }
				end
			end
			return out
		end
	end
	local catalog = loadShared("PetCatalog")
	if not catalog or type(catalog.Get) ~= "function" or type(profile.Pets) ~= "table" then
		return out
	end
	for petId, count in pairs(profile.Pets) do
		if type(count) == "number" and count > 0 then
			local def = catalog.Get(petId)
			if def then
				out[#out + 1] = { Key = petId, Def = def }
			end
		end
	end
	return out
end

-- Highest rarity wins; ties prefer the better tier, then equipped copies, then the key (so the choice is stable).
-- Returns key, def (nil when the owner has no pet).
local function pickBestPet(profile)
	local equipped = {}
	if type(profile) == "table" and type(profile.Equipped) == "table" then
		for _, key in ipairs(profile.Equipped) do
			if type(key) == "string" then
				equipped[key] = true
			end
		end
	end
	local best, bestRank = nil, nil
	for _, entry in ipairs(ownedPets(profile)) do
		local def = entry.Def
		local rank = {
			rarityOrder[def.Rarity] or 0,
			TIER_ORDER[def.Tier] or 1,
			equipped[entry.Key] and 1 or 0,
		}
		local better = false
		if not bestRank then
			better = true
		else
			for i = 1, #rank do
				if rank[i] ~= bestRank[i] then
					better = rank[i] > bestRank[i]
					break
				end
				if i == #rank then
					better = tostring(entry.Key) < tostring(best.Key)
				end
			end
		end
		if better then
			best, bestRank = entry, rank
		end
	end
	if best then
		return best.Key, best.Def
	end
	return nil, nil
end

local function wholeNumber(v, maxValue)
	if type(v) ~= "number" or v ~= v or v < 0 then
		return 0
	end
	if v == math.huge then
		return maxValue
	end
	return math.min(math.floor(v), maxValue)
end

-- Home Level + Prestige stars of a profile's Home (the live table: read only).
local function homeStatsOf(profile)
	local home = profile and profile.Home
	if type(home) ~= "table" then
		return 0, 0
	end
	local level = nil
	local catalog = loadShared("TycoonCatalog")
	if catalog and type(catalog.HomeLevelOf) == "function" then
		local ok, value = pcall(catalog.HomeLevelOf, home)
		if ok and type(value) == "number" then
			level = value
		end
	end
	if level == nil then
		level = home.Level
	end
	return wholeNumber(level, 100000), wholeNumber(home.Prestige, 100000)
end

-- "Home Level 12" / "Home Level 12 <bullet> <star><star>" / "Home Level 3 <bullet> <star> x7"
local function homeLine(level, stars)
	local text = "Home Level " .. tostring(level)
	if stars > 0 then
		local glyphs
		if stars <= MAX_STAR_GLYPHS then
			glyphs = string.rep(STAR, stars)
		else
			glyphs = STAR .. " x" .. tostring(stars)
		end
		text = text .. " " .. BULLET .. " " .. glyphs
	end
	return text
end

-- Re-reads one owner's profile; touches the labels / podium only when something changed.
local function refreshSpot(index)
	local owner = owners[index]
	if not owner or not owner.Parent then
		return
	end
	local profile = getProfile(owner)
	local level, stars = homeStatsOf(profile)
	local bestKey, bestDef = pickBestPet(profile)
	local name = displayNameOf(owner)
	local stage = 0
	if bestKey and dataService and type(dataService.GetEvolution) == "function" then
		local okE, e = pcall(dataService.GetEvolution, owner, bestKey)
		if okE and type(e) == "number" and e == e and e >= 1 then
			stage = math.floor(e)
		end
	end

	local sig = name .. "|" .. tostring(level) .. "|" .. tostring(stars) .. "|" .. tostring(bestKey) .. "|" .. tostring(stage)
	if lastSig[index] == sig then
		return
	end
	lastSig[index] = sig
	setLabels(index, name, homeLine(level, stars))
	setShowcasePet(index, bestKey, bestDef, stage)
end

function SpotService.Refresh(player)
	local index = player and spotOf[player]
	if index then
		refreshSpot(index)
	end
end

-- Several changes in one frame produce a single refresh.
local function queueRefresh(player)
	if refreshQueued[player] then
		return
	end
	refreshQueued[player] = true
	task.defer(function()
		refreshQueued[player] = nil
		if player.Parent then
			SpotService.Refresh(player)
		end
	end)
end

local function refreshLoop()
	while running do
		task.wait(REFRESH_INTERVAL)
		if not running then
			break
		end
		for index = 1, spotCount do
			if owners[index] then
				local ok, err = pcall(refreshSpot, index)
				if not ok then
					warn("[SpotService] refresh failed: " .. tostring(err))
				end
			end
		end
	end
end

----------------------------------------------------------------------
-- Gates, free plots
----------------------------------------------------------------------

local function validIndex(index)
	return type(index) == "number" and index == index and index == math.floor(index) and spots[index] ~= nil
end

-- The gate on the ground (LookVector = towards the street): SpotInfo.GateCFrame, else derived from the plot.
function SpotService.GateCFrame(info)
	if type(info) ~= "table" then
		return nil
	end
	if typeof(info.GateCFrame) == "CFrame" then
		return info.GateCFrame
	end
	if typeof(info.PlotCFrame) == "CFrame" then
		local size = tonumber(info.PlotSize) or Config.Lobby.PlotSize or 72
		return info.PlotCFrame * CFrame.new(0, 0, -size / 2)
	end
	return nil
end

-- Where a player without a plot is put: just outside the gate (street side), facing into the yard.
local function gateArrivalCFrame(info)
	local gate = SpotService.GateCFrame(info)
	if not gate then
		return info and info.SpawnCFrame or nil
	end
	local pos = (gate * CFrame.new(0, GATE_LIFT, -GATE_OUTSIDE)).Position
	local inward = -gate.LookVector
	local flat = Vector3.new(inward.X, 0, inward.Z)
	if flat.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + flat.Unit)
end

local function gatePosition(info)
	local gate = SpotService.GateCFrame(info)
	if gate then
		return gate.Position
	end
	if typeof(info.Center) == "Vector3" then
		return info.Center
	end
	if typeof(info.SpawnCFrame) == "CFrame" then
		return info.SpawnCFrame.Position
	end
	return nil
end

function SpotService.FindFreeSpot(position, preferIndex)
	if validIndex(preferIndex) and not owners[preferIndex] then
		return spots[preferIndex]
	end
	local best, bestDist = nil, math.huge
	for index = 1, spotCount do
		local info = spots[index]
		if info and not owners[index] then
			if typeof(position) ~= "Vector3" then
				return info -- the lowest free index
			end
			local at = gatePosition(info)
			local d = at and (at - position).Magnitude or math.huge
			if d < bestDist then
				best, bestDist = info, d
			end
		end
	end
	return best
end

local function lastSpotIndex(player)
	local profile = getProfile(player)
	local wanted = profile and profile.SpotIndex
	if validIndex(wanted) then
		return wanted
	end
	return nil
end

function SpotService.SuggestSpot(player)
	if not player then
		return nil, false
	end
	local index = spotOf[player]
	if index then
		return spots[index], true
	end
	local root = Util.GetRoot(player)
	return SpotService.FindFreeSpot(root and root.Position or nil, lastSpotIndex(player)), false
end

----------------------------------------------------------------------
-- Claim / release
----------------------------------------------------------------------

local function freeSpot(player)
	refreshQueued[player] = nil
	local list = conns[player]
	conns[player] = nil
	if list then
		for _, conn in ipairs(list) do
			conn:Disconnect()
		end
	end
	local index = spotOf[player]
	spotOf[player] = nil
	if not index then
		return nil
	end
	if owners[index] == player then
		owners[index] = nil
	end
	lastSig[index] = nil
	if player.Parent then
		pcall(function()
			player:SetAttribute(Config.Attr.SpotIndex, nil)
		end)
	end
	local info = spots[index]
	if info and info.Folder then
		pcall(function()
			info.Folder:SetAttribute("OwnerUserId", nil)
		end)
	end
	if shows[index] then
		setShowcasePet(index, nil)
	end
	setLabels(index, FREE_NAME, FREE_SUB)
	setAvatar(index, "Free")
	return index
end

function SpotService.Claim(player, index)
	if not initialized then
		return false, "Homes are not ready yet"
	end
	if typeof(player) ~= "Instance" or not player:IsA("Player") or not player.Parent or departed[player] then
		return false, "Not in the game"
	end
	if not validIndex(index) then
		return false, "Unknown home"
	end
	if spotOf[player] then
		if spotOf[player] == index then
			return false, "This is already your home"
		end
		return false, "You already have a home"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "Finish your match first"
	end
	local owner = owners[index]
	if owner then
		if owner.Parent then
			return false, "This home belongs to " .. displayNameOf(owner)
		end
		freeSpot(owner) -- a stale owner (left without PlayerRemoving): free it now
	end

	owners[index] = player
	spotOf[player] = index
	lastSig[index] = nil
	pcall(function()
		player:SetAttribute(Config.Attr.SpotIndex, index)
	end)
	local info = spots[index]
	if info and info.Folder then
		pcall(function()
			info.Folder:SetAttribute("OwnerUserId", player.UserId)
		end)
	end

	-- remember the LAST plot (the welcome-back toast offers it again next time)
	local profile = getProfile(player)
	if profile and profile.SpotIndex ~= index then
		profile.SpotIndex = index
		if dataService and type(dataService.MarkDirty) == "function" then
			pcall(dataService.MarkDirty, player)
		end
	end

	if not shows[index] then
		shows[index] = makeShow(index)
	end
	setAvatar(index, "Owned")
	loadHeadshot(player, index)

	local list = {}
	conns[player] = list
	table.insert(list, player:GetAttributeChangedSignal(Config.Attr.EquippedPets):Connect(function()
		queueRefresh(player)
	end))
	refreshSpot(index)
	SpotService.Claimed:Fire(player, index)
	return true, nil
end

function SpotService.Release(player)
	if not player then
		return nil
	end
	local index = freeSpot(player)
	if index then
		SpotService.Released:Fire(player, index)
	end
	return index
end

----------------------------------------------------------------------
-- Join / leave
----------------------------------------------------------------------

local function hasProfile(player)
	if not dataService or type(dataService.GetProfile) ~= "function" then
		return true -- nothing to wait for
	end
	return getProfile(player) ~= nil
end

-- The join toast (side toast, never centred): the last plot when it is still free, any free gate otherwise.
local function scheduleWelcome(player)
	if welcomed[player] or not player.Parent or departed[player] then
		return
	end
	welcomed[player] = true
	task.delay(WELCOME_DELAY, function()
		if not player.Parent or departed[player] or spotOf[player] then
			return
		end
		local last = lastSpotIndex(player)
		if last and not owners[last] then
			notify(player, "Welcome back! Press E at your gate (#" .. tostring(last) .. ").", "info", 6)
		elseif SpotService.FindFreeSpot(nil, nil) then
			notify(player, "Pick a free home: press E at its gate!", "info", 6)
		else
			notify(player, "Every home is taken right now.", "info", 6)
		end
	end)
end

-- Waits (bounded) for the player's profile, then schedules the welcome toast. ProfileLoaded usually wins.
local function onPlayerAdded(player)
	task.spawn(function()
		local waited = 0
		while player.Parent and not hasProfile(player) and waited < PROFILE_WAIT do
			task.wait(0.25)
			waited = waited + 0.25
		end
		if player.Parent then
			scheduleWelcome(player)
		end
	end)
end

local function onPlayerRemoving(player)
	departed[player] = true
	lastGo[player] = nil
	welcomed[player] = nil
	SpotService.Release(player)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function SpotService.GetSpot(player)
	local index = player and spotOf[player]
	if index then
		return spots[index]
	end
	return nil
end

function SpotService.GetOwner(index)
	local owner = validIndex(index) and owners[index] or nil
	if owner and owner.Parent then
		return owner
	end
	return nil
end

function SpotService.GetSpotByIndex(index)
	if validIndex(index) then
		return spots[index]
	end
	return nil
end

function SpotService.GetSpots()
	return spots
end

-- Pivots the character home (claimed plot) or, without a plot, to the gate of the suggested free plot.
-- Ignored during a match, in a battle or ring run (Phase 4 safe zones) and while dead. Returns true when the
-- character was moved.
function SpotService.Teleport(player)
	if not player or not player.Parent then
		return false
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false
	end
	if inBattle(player) then
		return false
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local info = SpotService.GetSpot(player)
	if info and typeof(info.SpawnCFrame) == "CFrame" then
		return placeCharacter(player.Character, info.SpawnCFrame)
	end
	local free = SpotService.SuggestSpot(player)
	local target = free and gateArrivalCFrame(free)
	if typeof(target) ~= "CFrame" then
		return false
	end
	return placeCharacter(player.Character, target)
end

local function onGoToSpot(player)
	local now = os.clock()
	local last = lastGo[player]
	if last and now - last < REMOTE_COOLDOWN then
		return
	end
	lastGo[player] = now
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return
	end
	if inBattle(player) then
		notify(player, BATTLE_TEXT, "bad", 3)
		return
	end
	if not spotOf[player] and not SpotService.SuggestSpot(player) then
		notify(player, "Every home is taken right now.", "bad", 3)
		return
	end
	-- Phase 4: the Home tile opens the home portal (home, or toward a free gate); it teleports only when the
	-- owner walks in (TycoonService's 0.2 s loop). Without TycoonService the old direct teleport stays.
	local tycoon = tycoonService()
	if tycoon and type(tycoon.OpenHomePortal) == "function" then
		local ok, opened = pcall(tycoon.OpenHomePortal, player)
		if ok and opened ~= nil then
			return
		end
	end
	local moved = SpotService.Teleport(player)
	if moved and not spotOf[player] then
		notify(player, "Press E at the gate to claim this home!", "info", 4)
	end
end

function SpotService.Init(lobbyInfo, deps)
	if initialized then
		return
	end
	initialized = true
	deps = deps or {}
	dataService = deps.DataService
	petService = deps.PetService

	local list = lobbyInfo and lobbyInfo.Spots
	if type(list) ~= "table" then
		warn("[SpotService] lobbyInfo.Spots is missing; spots are disabled")
		list = {}
	end
	for index, info in pairs(list) do
		if type(index) == "number" and type(info) == "table" and typeof(info.SpawnCFrame) == "CFrame"
			and typeof(info.PodiumCFrame) == "CFrame" then
			spots[index] = info
			if index > spotCount then
				spotCount = index
			end
		end
	end
	for index = 1, spotCount do
		if spots[index] then
			setLabels(index, FREE_NAME, FREE_SUB)
			setAvatar(index, "Free")
		end
	end

	-- Join toast once the profile is there (no auto-assignment: plots are claimed with E at the gate).
	if dataService and dataService.ProfileLoaded and type(dataService.ProfileLoaded.Connect) == "function" then
		dataService.ProfileLoaded:Connect(function(player)
			if player and player.Parent then
				scheduleWelcome(player)
			end
		end)
	end
	-- Pet changes show up on the podium immediately.
	if petService and petService.PerksChanged and type(petService.PerksChanged.Connect) == "function" then
		petService.PerksChanged:Connect(function(player)
			if player and player.Parent then
				queueRefresh(player)
			end
		end)
	end
	-- Phase 5 (3.7): an EVOLVE rebuilds the podium pet in its evolved look (PetCareService.Evolved; its signal exists at
	-- module load, so the require here is safe before its Init)
	local careModule = script.Parent and script.Parent:FindFirstChild("PetCareService")
	if careModule then
		local okCare, care = pcall(require, careModule)
		if okCare and type(care) == "table" and care.Evolved and type(care.Evolved.Connect) == "function" then
			care.Evolved:Connect(function(player)
				if player and player.Parent then
					queueRefresh(player)
				end
			end)
		end
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	local okRemote, goRemote = pcall(Remotes.Get, "GoToSpot")
	if okRemote and goRemote then
		goRemote.OnServerEvent:Connect(onGoToSpot)
	else
		warn("[SpotService] GoToSpot remote unavailable")
	end

	running = true
	task.spawn(refreshLoop)
	game:BindToClose(function()
		running = false
	end)
end

return SpotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="859">
          <Properties>
            <string name="Name">StormAltar</string>
            <string name="Source"><![CDATA[-- StormAltar (server): the Storm Altar lobby landmark from the player's own Stormfang art
-- (ARCHITECTURE_V3.md section 10, branding/stormfang-concept.webp: the crystal altar ring on dark storm clouds).
--
--   StormAltar.Build(lobbyInfo) -> CFrame   builds Model "StormAltar" under the lobby folder and returns the
--                                           altar CFrame (centre of the dais on the island's walking surface,
--                                           LookVector = towards the plaza). Safe to call again (rebuilds).
--   StormAltar.GetModel() -> Model | nil
--   StormAltar.GetCFrame() -> CFrame | nil
--   StormAltar.GetLanding() -> CFrame | nil  Phase 5 (6.2): where the Gate Court's Altar gate (GateService) puts a
--                                           player: on the island deck at the bridge end, 3 studs up, facing the altar
--   StormAltar.Used                         Util.Signal; Fire(player) when a player uses the altar's prompt
--
-- What it builds (all static; the client animates the showcase, ShowcaseController):
--   Island     a dark navy storm cloud sculpted with shared/Voxel.lua, as in the art: a storm-blue walking top
--              (DECK studs above the lobby) ringed by overlapping 2-stud-voxel billows (a lower outer row, a main
--              row and a bank piled up behind the dais; open towards the bridge) with lighter blue-grey tops and
--              pale grey-white highlights on a few crowns, over a hanging cumulus belly of 3-stud voxels (tiers of
--              lumps narrowing downwards), navy, darker underneath.
--   Dais       a ring of charcoal stone blocks (radius ~12) with bevelled lighter tops, stepped clusters and
--              stacked mounts by the crystals, scattered rubble; a segmented inner rim around a dark navy portal
--              disc with a softer heart and dim glowing runes.
--   Crystals   as in the art seen from its front (the plaza): the head crystal, the biggest (a stepped diamond with
--              two small side shards), rises at the far side behind the showcase, a medium pair flanks it, a
--              smaller pair stands at the near sides and a low diamond gem is set into the near stone. Every shard
--              is a pale Glass shell around an electric-cyan Neon core.
--   Showcase   StormfangShowcase: PetBuilder.Build(stormfang, { Detail = "High", Scale = 3 }), anchored, hovering
--              over the portal on its storm cloud, leaning forward (prowling) towards the plaza; tagged
--              "NC_Showcase" with the attributes PetId, PetParts, HoverAmp and Ready. An invisible collider keeps
--              players out of the big (non-colliding) pet.
--   Bridge     a stone bridge from the island to LobbyInfo.AltarDock (the street junction, whose inner rail
--              LobbyBuilder leaves open for it): a short level deck over the island edge, then a gentle ramp down
--              to the street height (no steps into the street). Low parapets with crystal lanterns, a storm
--              puff underneath.
--   Sign       Model StormAltarSign: a stone entrance gate standing on the street over the bridge's foot, its
--              12 x 6.4-stud poster facing the street (SurfaceGui at 50 px per stud in the cloud UI style: the
--              player's art Config.Art.StormfangImage in a 5.7-stud well, "STORM ALTAR" in 1.1-stud letters,
--              "Secret pets" and "Awakens soon" in 0.64-stud letters: readable from ~30 studs), low walls between
--              the bridge and the pillars, and a pixel-sized "STORM ALTAR" / "Secret pets" title tag above the
--              altar, readable from the plaza.
--   Prompt     ProximityPrompt "Storm Altar" (ActionText "Summon"). Phase 2 (gems): it opens the Shop on the
--              gems-only Secret roulette (OpenPanel("Shop", { RouletteId = Config.Gems.SecretRoulette.Id,
--              Currency = "Gems" }), rate-limited per player) when GemService.SecretRouletteState says "Open";
--              an account where PolicyService restricts paid random items gets a side toast that the Secret
--              Roulette is not available there; while the gem system is missing or still checking the account the
--              phase 1 side toast "The Storm Altar awakens soon: summon Secret pets with Gems!" is sent (toasts:
--              Notify, rate-limited per player).
--   Lights     a few soft electric-blue PointLights with small ranges (portal, head crystal, gate).
-- No AltarSite: a free spot between the plaza and the plot ring road is searched (away from lobby parts, NPC spots
-- and the spawn), and the dock is found by raycasting for the street. Collision only on walkable parts (island
-- top and billows, dais stones, rim, disc, bridge, steps, gate) plus the invisible showcase collider. Part budget
-- <= ~450 without the showcase pet. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local function optional(name)
	local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
	if not module then
		warn("[StormAltar] shared module missing: " .. name)
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[StormAltar] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local Voxel = optional("Voxel")
local PetBuilder = optional("PetBuilder")
local PetCatalog = optional("PetCatalog")

local StormAltar = {}
StormAltar.Used = Util.Signal()

----------------------------------------------------------------------
-- Constants (studs; altar-local frame: origin = dais centre on the walking surface, -Z = front = the plaza)
----------------------------------------------------------------------
local MODEL_NAME = "StormAltar"
local SHOWCASE_TAG = "NC_Showcase"
local PET_ID = "stormfang"
local TOAST = "The Storm Altar awakens soon: summon Secret pets with Gems!"
local TOAST_RESTRICTED = "The Storm Altar's Secret Roulette is not available on your account."
local TOAST_COOLDOWN = 3 -- seconds between two toasts for the same player
local OPEN_COOLDOWN = 0.5 -- seconds between two "open the Secret roulette" for the same player
local SECRET_ROULETTE_ID = (type(Config.Gems) == "table" and type(Config.Gems.SecretRoulette) == "table"
	and type(Config.Gems.SecretRoulette.Id) == "string" and Config.Gems.SecretRoulette.Id) or "Secret"

local DECK = 3 -- the island's walking surface above the lobby walking height
local R_TOP = 23 -- walkable top radius
local RING_C, RING_D = 12.2, 3.2 -- stone ring: centre radius and radial depth (11 = 10.6 .. 13.8)
local RING_N = 22 -- stones around (one centred on the front, one on the back)
local RIM_R, RIM_D, RIM_H, RIM_N = 6.9, 1.6, 1.2, 14 -- inner portal rim
local DISC_S = 10.3 -- side of the four turned squares of the portal disc (union radius 6.2 .. 7.3)
local HOVER = 3.2 -- gap between the walking surface and the showcase's lowest point
local PROWL = math.rad(-8) -- forward lean of the showcase (nose down)
local BRIDGE_W = 8
local RAMP_LEVEL = 5 -- studs of level deck over the island edge before the ramp slopes down to the street
local GAP_HALF = 26 -- degrees kept free of rim billows around the bridge
local MAX_PARTS = 500
-- the entrance gate's poster (World text rule: a SurfaceGui at 50 px per stud, titles >= 1 stud, lines >= 0.6 stud)
local POSTER_PPS = 50
local PANEL_W, PANEL_H = 12, 6.4 -- studs = 600 x 320 px
local PANEL_BOTTOM = 8.3 -- studs above the street: everyone walks under it
local GATE_HALF = 5.6 -- pillar centres from the bridge's centre line (the junction wedge is ~13.8 studs wide
-- at the street's inner edge: the pillars stand clear of the neighbouring plots' street slabs)
local PILLAR_W = 1.3
local PILLAR_TOP = 15.2
local PANEL_Z = -(PILLAR_W / 2 + 0.2) -- centre of the poster's stone frame, on the street face of the pillars

local MAT = Enum.Material
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local C = {
	-- storm cloud (ARCHITECTURE_V3.md section 10: navy #2e3a66 / #44507f / lighter #6b77a8 tops, white puffs)
	StormDeep = rgb(34, 43, 78),
	Storm = rgb(46, 58, 102),
	StormMid = rgb(68, 80, 127),
	StormTop = rgb(107, 119, 168),
	Walk = rgb(86, 98, 143),
	Floor = rgb(36, 44, 80),
	Puff = rgb(222, 228, 242),
	PuffLight = rgb(242, 244, 250),
	PuffDark = rgb(186, 194, 220),
	-- charcoal stone (the armour greys of the art)
	StoneDeep = rgb(42, 44, 51),
	Stone = rgb(75, 77, 87),
	StoneB = rgb(66, 68, 78),
	StoneC = rgb(84, 87, 98),
	StoneLight = rgb(112, 115, 126),
	Bevel = rgb(163, 166, 174),
	RimSide = rgb(58, 66, 102),
	RimTop = rgb(104, 112, 146),
	Disc = rgb(26, 32, 64),
	DiscInner = rgb(33, 42, 84),
	-- crystals and glow
	CrystalCore = rgb(63, 200, 255),
	CrystalGlass = rgb(70, 172, 252),
	Rune = rgb(64, 150, 236),
	Electric = rgb(70, 170, 255),
	Violet = rgb(122, 60, 255),
	-- sign
	Navy = (Theme.Colors and Theme.Colors.Navy) or rgb(24, 34, 78),
	Ink = (Theme.Colors and Theme.Colors.TextStroke) or rgb(16, 22, 50),
	White = rgb(255, 255, 255),
	Cyan = rgb(150, 224, 255),
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local altarModel = nil
local altarCFrame = nil
local altarLanding = nil -- Phase 5: GetLanding()
local lastToast = {} -- [player] = os.clock() of the last toast
local lastOpen = {} -- [player] = os.clock() of the last OpenPanel (Secret roulette)
local playersHooked = false

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function atan2(y, x)
	if math.atan2 then
		return math.atan2(y, x)
	end
	return math.atan(y, x)
end

local function hash(a, b, seed)
	local h = (a * 73856093 + b * 19349663 + seed * 83492791) % 2147483647
	h = (h * 16807) % 2147483647
	h = (h * 16807) % 2147483647
	return h / 2147483647
end

local function angleDiff(a, b)
	local d = math.abs((a - b) % 360)
	if d > 180 then
		d = 360 - d
	end
	return d
end

-- Flat CFrame at pos looking (horizontally) at target.
local function flatLook(pos, target)
	local d = Vector3.new(target.X - pos.X, 0, target.Z - pos.Z)
	if d.Magnitude < 1e-3 then
		return CFrame.new(pos)
	end
	return CFrame.lookAt(pos, pos + d.Unit)
end

-- Altar-local polar placement: deg 0 = front (-Z), 90 = right (+X).
local function polarCF(A, deg, r, y)
	return A * CFrame.Angles(0, -math.rad(deg), 0) * CFrame.new(0, y or 0, -r)
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

-- One anchored block. opts: Material, Collide, Transparency, Shadow, Query.
local function block(parent, name, cf, size, color, opts)
	opts = opts or {}
	local part
	if Voxel and Voxel.Box then
		part = Voxel.Box(nil, cf, size, color, opts.Material or MAT.SmoothPlastic)
	else
		part = Instance.new("Part")
		part.Anchored = true
		part.Size = size
		part.CFrame = cf
		part.Color = color
		part.Material = opts.Material or MAT.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.CanTouch = false
	end
	part.Name = name
	part.CanCollide = opts.Collide == true
	part.CanQuery = opts.Collide == true or opts.Query == true
	part.CanTouch = false
	part.Transparency = opts.Transparency or 0
	if opts.Shadow ~= nil then
		part.CastShadow = opts.Shadow == true
	else
		part.CastShadow = math.max(size.X, size.Y, size.Z) >= 4
	end
	part.Parent = parent
	return part
end

local function invisible(parent, name, cf, size)
	return block(parent, name, cf, size or Vector3.new(1, 1, 1), C.Storm, { Transparency = 1, Shadow = false })
end

local function pointLight(parent, brightness, range)
	local l = Instance.new("PointLight")
	l.Name = "StormGlow"
	l.Color = C.Electric
	l.Brightness = brightness
	l.Range = range
	l.Shadows = false
	l.Parent = parent
	return l
end

local function sparkles(parent, rate, speed, size)
	local e = Instance.new("ParticleEmitter")
	e.Name = "StormSparkles"
	e.Texture = SPARKLES
	e.Color = ColorSequence.new(C.CrystalCore, C.Violet)
	e.LightEmission = 0.8
	e.LightInfluence = 0
	e.Rate = rate
	e.Lifetime = NumberRange.new(1.6, 2.8)
	e.Speed = NumberRange.new(speed * 0.5, speed)
	e.SpreadAngle = Vector2.new(30, 30)
	e.EmissionDirection = Enum.NormalId.Top
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	e.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.3, size),
		NumberSequenceKeypoint.new(1, 0),
	})
	e.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.25, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	e.Parent = parent
	return e
end

local function section(name, fn)
	local ok, err = pcall(fn)
	if not ok then
		warn("[StormAltar] " .. name .. " failed: " .. tostring(err))
	end
	return ok
end

----------------------------------------------------------------------
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6" A7, owner art-lobby): Blender mesh dressing, exactly like LobbyBuilder's
-- Mesh.tag: the Part build stays (fallback + colliders + every name / prompt / sign); static subtrees are tagged with
-- MeshLibrary.Tag once their key has an uploaded id (empty MeshIds = nothing changes). Keys baked from this build carry
-- a manifest "LayoutSig" (part count + position / size sums relative to the altar CFrame) and are tagged only while
-- the live build matches it (the island's bridge gap follows the dock bearing).
----------------------------------------------------------------------
local Mesh = {
	Lib = nil,
	PuffParts = { "Body", "BodyLight", "Body_Light", "Cloud" }, -- a dressed storm puff's parts (kept by the bridge)
}

function Mesh.lib()
	if Mesh.Lib == nil then
		Mesh.Lib = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" and type(result.Tag) == "function" then
				Mesh.Lib = result
			end
		end
	end
	return Mesh.Lib or nil
end

-- the same numbers as LobbyBuilder._Mesh.Signature (blender/kit/props/lobby_world.py computes them too)
function Mesh.Signature(target, origin)
	local inv = origin:Inverse()
	local n, a, b = 0, 0, 0
	local list = target:GetDescendants()
	list[#list + 1] = target
	for _, d in ipairs(list) do
		if d:IsA("BasePart") and d.Transparency < 0.99 then
			local p = inv * d.Position
			local sz = d.Size
			n = n + 1
			a = a + p.X + p.Y * 0.37 + p.Z * 0.61
			b = b + sz.X + sz.Y * 1.3 + sz.Z * 1.7
		end
	end
	return n, a, b
end

function Mesh.tag(target, key, origin, look, keep)
	if typeof(target) ~= "Instance" or typeof(origin) ~= "CFrame" then
		return false
	end
	local kit = StormAltar._Kit
	if type(kit) == "table" and type(kit.Targets) == "table" then
		kit.Targets[#kit.Targets + 1] = { Key = key, Target = target, Origin = origin, Look = look, Keep = keep }
	end
	local ML = Mesh.lib()
	if not ML or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" then
		return false
	end
	local man = type(ML.Manifest) == "function" and ML.Manifest(key)
	local att = man and man.Attachments and man.Attachments.LayoutSig
	if att then
		local pos = att.Pos or att.pos
		if type(pos) ~= "table" then
			return false
		end
		local n, a, b = Mesh.Signature(target, origin)
		local tol = 0.05 + n * 1e-4
		if n ~= pos[1] or math.abs(a - pos[2]) > tol or math.abs(b - pos[3]) > tol then
			return false
		end
	end
	local tagLook = {}
	for k, v in pairs(look or {}) do
		tagLook[k] = v
	end
	tagLook.Offset = target:GetPivot():Inverse() * origin
	ML.Tag(target, key, tagLook, keep)
	return true
end

----------------------------------------------------------------------
-- Site: LobbyInfo.AltarSite / AltarDock, or a free spot at the lobby edge
----------------------------------------------------------------------
-- Every visible part of the lobby near the walking height as an oriented box (for the free-spot search).
local function obstacleBoxes(folder, top)
	local list = {}
	if typeof(folder) ~= "Instance" then
		return list
	end
	for _, d in ipairs(folder:GetDescendants()) do
		if d:IsA("BasePart") and d.Transparency < 1 then
			local half = d.Size * 0.5
			local y = d.Position.Y
			if y + half.Magnitude > top - 30 and y - half.Magnitude < top + 40 then
				list[#list + 1] = { CF = d.CFrame, Half = half }
			end
		end
	end
	return list
end

-- Horizontal distance from p to the nearest obstacle box (capped at `cap`).
local function clearance(p, boxes, cap)
	local best = cap
	for i = 1, #boxes do
		local b = boxes[i]
		local q = b.CF:PointToObjectSpace(p)
		local dx = math.max(math.abs(q.X) - b.Half.X, 0)
		local dz = math.max(math.abs(q.Z) - b.Half.Z, 0)
		local d = math.sqrt(dx * dx + dz * dz)
		if d < best then
			best = d
			if best <= 0 then
				return 0
			end
		end
	end
	return best
end

-- A free spot between the plaza and the plot ring road, away from portals, machines, NPC spots and the spawn.
local function fallbackSite(lobbyInfo)
	local lobby = Config.Lobby or {}
	local origin = lobby.Origin or Vector3.new(0, 300, 0)
	local top = origin.Y
	local plazaR = (lobby.PlazaRadius or 110) + 6
	local streetIn = (lobby.SpotRingRadius or 300) - ((lobby.PlotSize or 72) / 2 + 4 + 14)
	local need = R_TOP + 6
	local r0 = math.max(plazaR + need + 8, (plazaR + streetIn) / 2)
	local shop = lobby.ShopOffset or Vector3.new(0, 0, -150)
	local prefer = math.deg(atan2(shop.Z, shop.X)) + 45
	local boxes = obstacleBoxes(lobbyInfo and lobbyInfo.Folder, top)
	local avoid = {}
	if type(lobbyInfo) == "table" then
		if type(lobbyInfo.NpcSpots) == "table" then
			for _, cf in ipairs(lobbyInfo.NpcSpots) do
				if typeof(cf) == "CFrame" then
					avoid[#avoid + 1] = cf.Position
				end
			end
		end
		if typeof(lobbyInfo.SpawnCFrame) == "CFrame" then
			avoid[#avoid + 1] = lobbyInfo.SpawnCFrame.Position
		end
	end
	local best, bestScore = nil, -math.huge
	for step = 0, 47 do
		local k = math.floor((step + 1) / 2) * ((step % 2 == 0) and 1 or -1)
		local deg = prefer + k * 7.5
		for _, r in ipairs({ r0, r0 - 10, r0 + 10 }) do
			if r - need > plazaR and r + need < streetIn - 4 then
				local a = math.rad(deg)
				local p = Vector3.new(origin.X + math.cos(a) * r, top, origin.Z + math.sin(a) * r)
				local score = clearance(p, boxes, need * 2)
				for _, q in ipairs(avoid) do
					local d = Vector3.new(q.X - p.X, 0, q.Z - p.Z).Magnitude
					score = math.min(score, d - 12)
				end
				if score >= need then
					return flatLook(p, Vector3.new(origin.X, top, origin.Z))
				end
				if score > bestScore then
					best, bestScore = p, score
				end
			end
		end
	end
	if not best then
		local a = math.rad(prefer)
		best = Vector3.new(origin.X + math.cos(a) * r0, top, origin.Z + math.sin(a) * r0)
	end
	return flatLook(best, Vector3.new(origin.X, top, origin.Z))
end

-- Walkable ground (a collidable, upward-facing surface at the lobby height) under p, or nil.
local function groundAt(p, top, exclude)
	local ok, hit = pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = exclude
		return Workspace:Raycast(Vector3.new(p.X, top + 12, p.Z), Vector3.new(0, -30, 0), params)
	end)
	if ok and hit and hit.Instance and hit.Instance.CanCollide and math.abs(hit.Position.Y - top) <= 1.5 then
		return hit.Position
	end
	return nil
end

-- Where a bridge can dock: the nearest walkable ground along the site's radial line, outwards first.
local function findDock(site, top, exclude)
	local centre = site.Position
	local back = -site.LookVector
	for _, dir in ipairs({ back, site.LookVector }) do
		for s = R_TOP + 4, R_TOP + 96, 2 do
			local hit = groundAt(centre + dir * s, top, exclude)
			if hit then
				return Vector3.new(hit.X, top, hit.Z)
			end
		end
	end
	return nil
end

----------------------------------------------------------------------
-- Island: a dark navy voxel storm cloud
----------------------------------------------------------------------
local ISLAND_PALETTE = {
	Body = C.Storm,
	Body_Light = C.StormMid,
	Body_Dark = C.StormDeep,
	Billow = C.StormMid,
	Billow_Light = C.StormTop,
	Billow_Dark = C.Storm,
	Puff = C.PuffDark,
	PuffTop = C.Puff,
}

-- Four squares turned 22.5 degrees apart: a 16-gon (union radius 0.601 .. 0.707 x side) in four parts.
local function polygon16(parent, name, cf, side, height, color, opts)
	for k = 0, 3 do
		block(parent, name, cf * CFrame.new(0, k * 0.004, 0) * CFrame.Angles(0, math.rad(k * 22.5), 0), Vector3.new(side, height, side), color, opts)
	end
end

local function ellipsoid(g, x, y, z, rx, ry, rz, key, keep)
	Voxel.Shape(g, { Kind = "Ellipsoid", Center = { x, y, z }, Radius = { rx, ry, rz }, Key = key, KeepExisting = keep })
end

-- Puffy rim billows (studs / BV voxels), open towards the bridge. Three overlapping rows make one continuous
-- cauliflower ring (no separate "teeth"): a lower outer row that bulges out over the belly, the main row on the
-- edge of the walking top and a bank piled up behind the dais (the front stays low: the view from the plaza
-- stays open). Lighter blue-grey tops, navy undersides, pale highlights painted onto a few crowns.
local BV = 2
local function sculptRim(gapDeg, bv)
	local BV = bv or BV -- (the kit re-voxels the rim finer: StormAltar._Blueprint)
	local g = Voxel.NewGrid(16)
	local function billow(deg, r, y, rx, ry, key)
		local a = math.rad(deg)
		ellipsoid(g, math.sin(a) * r / BV, y / BV, -math.cos(a) * r / BV, rx / BV, ry / BV, rx / BV, key or "Billow", true)
	end
	-- main row: overlapping billows on the edge of the walking top
	local count = 17
	for i = 1, count do
		local deg = (i - 0.5) * 360 / count + (hash(i, 3, 9) - 0.5) * 8
		if angleDiff(deg, gapDeg) > GAP_HALF then
			local front = angleDiff(deg, 0) < 55
			local rx = 3.3 + hash(i, 5, 9) * 1.3
			local ry = front and (1.5 + hash(i, 6, 9) * 0.4) or (2.3 + hash(i, 6, 9) * 1.3)
			billow(deg, R_TOP - 0.9 + (hash(i, 4, 9) - 0.5) * 1.2, -0.7 + (hash(i, 7, 9) - 0.5) * 0.6, rx, ry)
		end
	end
	-- lower outer row: smaller bulges that round the island's side off into the belly
	for i = 1, 12 do
		local deg = (i - 0.25) * 360 / 12 + (hash(i, 13, 9) - 0.5) * 10
		if angleDiff(deg, gapDeg) > GAP_HALF - 6 then
			billow(deg, R_TOP + 0.9, -2.3 - hash(i, 14, 9) * 0.6, 2.9 + hash(i, 15, 9) * 0.8, 1.8 + hash(i, 16, 9) * 0.5)
		end
	end
	-- the bank behind the dais (the art's cloud wall behind the ring)
	for i = 1, 8 do
		local deg = 180 + (i - 4.5) * 17 + (hash(i, 8, 9) - 0.5) * 6
		if angleDiff(deg, gapDeg) > GAP_HALF + 6 then
			billow(deg, R_TOP - 0.2, 1.5 + hash(i, 10, 9) * 1.1, 2.4 + hash(i, 11, 9) * 0.9, 2.0 + hash(i, 12, 9) * 0.8)
		end
	end
	Voxel.Shade(g, { Only = { Billow = true }, Smooth = 3, Seed = 11, LightAt = 0.5, Dark = false })
	-- pale grey-white highlights on a few crowns (the art's lit cloud tops): a grey-blue cap, whiter on top
	for i, deg in ipairs({ -42, 38, 96, 140, 180, 222, 262, -96 }) do
		if angleDiff(deg, gapDeg) > GAP_HALF + 4 then
			local a = math.rad(deg)
			local r = R_TOP - 0.8
			local x, z = math.sin(a) * r / BV, -math.cos(a) * r / BV
			local y = (angleDiff(deg, 180) < 60) and 4.2 or 2.4
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = { x, y / BV, z }, Radius = { 3.0 / BV, 2.4 / BV, 3.0 / BV }, Op = "Paint", OnlyKeys = { Billow_Light = true }, Key = "Puff" })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = { x, (y + 1.2) / BV, z }, Radius = { 1.8 / BV, 1.6 / BV, 1.8 / BV }, Op = "Paint", OnlyKeys = { Puff = true }, Key = "PuffTop" })
		end
	end
	return g
end

-- The belly under the walking top (3-stud voxels, top layer just under the walking surface): a hanging
-- cumulus, as wide as the rim at the top, then tiers of lumps that narrow downwards (a rounded, bumpy
-- underside instead of a flat slab); lighter where it faces up, navy, darker underneath.
local function sculptBelly(f)
	f = f or 1 -- the kit's finer grain: f voxels per 3-stud game voxel (StormAltar._Blueprint)
	local g = Voxel.NewGrid(8)
	local function ellipsoid(grid, x, y, z, rx, ry, rz, key, keep)
		Voxel.Shape(grid, { Kind = "Ellipsoid", Center = { x * f, y * f, z * f }, Radius = { rx * f, ry * f, rz * f }, Key = key, KeepExisting = keep })
	end
	ellipsoid(g, 0, -0.6, 0, 7.4, 1.2, 7.4, "Body")
	local function ring(n, r, y, rx, ry, seed, turn)
		for i = 1, n do
			local a = (i - 1) / n * math.pi * 2 + (turn or 0) + (hash(i, seed, 5) - 0.5) * 0.4
			local s = rx * (0.85 + hash(i, seed + 1, 5) * 0.3)
			ellipsoid(g, math.sin(a) * r, y + (hash(i, seed + 2, 5) - 0.5) * 0.5, -math.cos(a) * r, s, ry, s, "Body", true)
		end
	end
	ring(9, 6.3, -1.2, 2.4, 1.5, 20, 0.2) -- the bumpy outer silhouette under the rim
	ellipsoid(g, 0.3, -2.3, -0.2, 5.4, 1.4, 5.2, "Body", true)
	ring(7, 4.6, -2.8, 2.0, 1.3, 30, 0.6)
	ellipsoid(g, -0.2, -3.8, 0.4, 3.4, 1.3, 3.2, "Body", true)
	ring(4, 2.6, -4.3, 1.6, 1.1, 40, 1.1)
	ellipsoid(g, 0.4, -5.1, -0.2, 1.7, 1.0, 1.6, "Body", true)
	-- never above the walking surface
	local remove = {}
	for k in pairs(g.Cells) do
		local _, y = Voxel.Unpack(k)
		if y > 0 then
			remove[#remove + 1] = k
		end
	end
	for _, k in ipairs(remove) do
		g.Cells[k] = nil
		g.Count = g.Count - 1
	end
	Voxel.Shade(g, { Smooth = 2, Seed = 5, LightAt = 0.5, DarkAt = -0.25 })
	return g
end

-- Parts whose top reaches the walking surface collide; everything below is decoration.
local function collideTops(model, A)
	local inv = A:Inverse()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local topY = (inv * part.CFrame).Position.Y + part.Size.Y / 2
			if topY >= -0.05 then
				part.CanCollide = true
				part.CanQuery = true
			end
		end
	end
end

local function buildIsland(parent, A, gapDeg)
	local m = newModel(parent, "Island")
	-- walking top: a 16-gon of storm blue (its points hide in the rim billows), the dark floor inside the ring
	polygon16(m, "WalkTop", A * CFrame.new(0, -1, 0), 32, 2, C.Walk, { Collide = true })
	polygon16(m, "Floor", A * CFrame.new(0, 0.01, 0), 19.4, 0.04, C.Floor, { Collide = true, Shadow = false })
	if not Voxel then
		-- no voxel kit: two plain navy slabs under the top
		block(m, "IslandBody", A * CFrame.new(0, -4, 0), Vector3.new(R_TOP * 1.7, 4, R_TOP * 1.7), C.Storm)
		block(m, "IslandBelly", A * CFrame.new(0, -8, 0), Vector3.new(R_TOP, 4, R_TOP), C.StormDeep)
		return m
	end
	local rim = Voxel.Build(sculptRim(gapDeg), {
		VoxelSize = BV,
		Palette = ISLAND_PALETTE,
		Name = "RimClouds",
		CFrame = A,
		MaxParts = 150,
		Keep = { "Puff", "PuffTop" },
	})
	collideTops(rim, A)
	rim.Parent = m
	local belly = Voxel.Build(sculptBelly(), {
		VoxelSize = 3,
		Palette = ISLAND_PALETTE,
		Name = "Belly",
		CFrame = A * CFrame.new(0, -2.55, 0), -- (0.05 under the rim's voxel layers: no flush faces)
		MaxParts = 52,
	})
	belly.Parent = m
	return m
end

----------------------------------------------------------------------
-- Crystals: square prisms turned 45 degrees (a diamond from the front), stepped pyramid tips,
-- a pale Glass shell around an electric-cyan Neon core
----------------------------------------------------------------------
local function crystalBlock(parent, cf, w, h)
	block(parent, "CrystalGlass", cf, Vector3.new(w, h, w), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.25, Shadow = false })
	if w > 0.5 then
		block(parent, "CrystalCore", cf, Vector3.new(w * 0.56, h * 0.98, w * 0.56), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
	end
end

-- base: bottom centre of the body, Y = the shard's axis. Returns the model and the tip height above base.
local function crystal(parent, base, w, h, tipSteps, tipH, footSteps, footH)
	local m = newModel(parent, "Crystal")
	local axis = base * CFrame.Angles(0, math.rad(45), 0)
	crystalBlock(m, axis * CFrame.new(0, h / 2, 0), w, h)
	local y = h
	for i = 1, tipSteps do
		local s = w * (1 - i / (tipSteps + 1))
		local sh = tipH / tipSteps
		crystalBlock(m, axis * CFrame.new(0, y + sh / 2, 0), s, sh)
		y = y + sh
	end
	local yb = 0
	for i = 1, footSteps or 0 do
		local s = w * (1 - i / ((footSteps or 0) + 1))
		local sh = (footH or 0) / footSteps
		crystalBlock(m, axis * CFrame.new(0, yb - sh / 2, 0), s, sh)
		yb = yb - sh
	end
	return m, y
end

----------------------------------------------------------------------
-- Dais: stone ring, mounts + crystals, inner rim, portal disc
----------------------------------------------------------------------
local STONE_COLORS = { C.Stone, C.StoneB, C.StoneC }

-- Crystal stones (ring index -> shard). As in the art seen from its front (the plaza): the head crystal, the
-- biggest (a diamond), rises at the far side behind the showcase, a medium pair flanks it, a smaller pair stands
-- at the near sides and a low diamond gem is set into the near stone (index 0, facing the plaza).
-- W = width, H = body height, Steps / Tip = stepped point, FootSteps / Foot = stepped lower point,
-- Lean = degrees outwards, Mount = height of the stacked mount stone.
local HEAD = RING_N / 2
local CRYSTALS = {
	[HEAD] = { W = 3.6, H = 5.8, Steps = 4, Tip = 3.9, FootSteps = 2, Foot = 1.4, Lean = 3, Mount = 2.6 },
	[HEAD - 3] = { W = 2.4, H = 3.4, Steps = 3, Tip = 2.4, Lean = 9, Mount = 3.2 },
	[HEAD + 3] = { W = 2.4, H = 3.4, Steps = 3, Tip = 2.4, Lean = 9, Mount = 3.2 },
	[HEAD - 7] = { W = 2.1, H = 2.6, Steps = 3, Tip = 1.8, Lean = 11, Mount = 2.8 },
	[HEAD + 7] = { W = 2.1, H = 2.6, Steps = 3, Tip = 1.8, Lean = 11, Mount = 2.8 },
}

local function buildRing(parent, A)
	local m = newModel(parent, "Ring")
	local step = 360 / RING_N
	local width = 2 * math.pi * RING_C / RING_N - 0.22
	local tops = {}
	for i = 0, RING_N - 1 do
		local deg = i * step
		local key = i
		local spec = CRYSTALS[key]
		local h = 1.6 + math.floor(hash(i, 1, 21) * 4) * 0.4
		if spec then
			h = spec.Mount - 0.9
		elseif key == 0 then
			h = 2.8 -- the near stone carries the gem
		end
		local color = STONE_COLORS[(i % #STONE_COLORS) + 1]
		-- neighbours overlap at the ring's inner edge: alternate stones sit 0.06 higher (no flush tops)
		h = h + (i % 2) * 0.06
		local cf = polarCF(A, deg, RING_C, h / 2)
		block(m, "Stone", cf, Vector3.new(width, h, RING_D), color, { Collide = true })
		-- bevelled top: a lighter inset cap
		block(m, "StoneCap", cf * CFrame.new(0, h / 2 + 0.1, 0), Vector3.new(width - 0.5, 0.2, RING_D - 0.5), C.StoneLight, { Collide = true, Shadow = false })
		local topY = h + 0.2
		if spec then
			-- stacked mount block for the crystal
			local mh = 0.9
			local mcf = polarCF(A, deg, RING_C, h + 0.2 + mh / 2)
			block(m, "Mount", mcf, Vector3.new(width * 0.74, mh, RING_D * 0.74), C.StoneB, { Collide = true })
			block(m, "MountCap", mcf * CFrame.new(0, mh / 2 + 0.08, 0), Vector3.new(width * 0.74 - 0.4, 0.16, RING_D * 0.74 - 0.4), C.Bevel, { Collide = true, Shadow = false })
			topY = h + 0.2 + mh + 0.16
		elseif hash(i, 2, 21) < 0.4 and not (CRYSTALS[(i + 1) % RING_N] or CRYSTALS[(i - 1) % RING_N]) then
			-- a smaller stone stacked off-centre (the broken, stepped silhouette of the art)
			local sh = 0.8
			local off = (hash(i, 3, 21) < 0.5) and -0.55 or 0.55
			local scf = polarCF(A, deg + off * 4, RING_C + 0.4, h + 0.2 + sh / 2)
			block(m, "StoneStack", scf, Vector3.new(width * 0.48, sh, RING_D * 0.56), C.StoneC, { Collide = true, Shadow = false })
		end
		tops[key] = topY
		-- the stones beside a crystal step up towards it (the clustered blocks of the art)
		if CRYSTALS[(i + 1) % RING_N] or CRYSTALS[(i - 1) % RING_N] then
			local toward = CRYSTALS[(i + 1) % RING_N] and 1 or -1
			local sh = 0.7 + hash(i, 4, 21) * 0.6
			local scf = polarCF(A, deg + toward * step * 0.22, RING_C - 0.3, h + 0.2 + sh / 2)
			block(m, "StoneStack", scf, Vector3.new(width * 0.5, sh, RING_D * 0.62), C.StoneC, { Collide = true, Shadow = false })
		end
	end
	-- scattered rubble around the outer foot of the ring
	for i = 1, 3 do
		local deg = i * 120 + 25 + hash(i, 7, 21) * 14
		local s = 0.7 + hash(i, 8, 21) * 0.5
		local cf = polarCF(A, deg, RING_C + RING_D / 2 + 0.9 + hash(i, 9, 21) * 0.8, s / 2) * CFrame.Angles(0, hash(i, 10, 21) * 1.2, 0)
		block(m, "Rubble", cf, Vector3.new(s, s, s), (i % 2 == 0) and C.StoneC or C.StoneB, { Shadow = false })
	end
	return m, tops
end

local function buildCrystals(parent, A, tops)
	local m = newModel(parent, "Crystals")
	local step = 360 / RING_N
	local headTip = nil
	for key, spec in pairs(CRYSTALS) do
		local deg = key * step
		local baseY = (tops[key] or (spec.Mount + 0.2)) - 0.25
		if spec.FootSteps then
			baseY = baseY + (spec.Foot or 0) -- a diamond: its lower point rests on the mount
		end
		-- lean outwards a little (-Z of the polar frame points away from the centre)
		local base = polarCF(A, deg, RING_C, baseY) * CFrame.Angles(-math.rad(spec.Lean), 0, 0)
		local _, tip = crystal(m, base, spec.W, spec.H, spec.Steps, spec.Tip, spec.FootSteps, spec.Foot)
		if key == HEAD then
			headTip = baseY + tip
			-- two small side shards leaning away from the big one
			local mountTop = tops[key] or (spec.Mount + 0.2)
			for _, s in ipairs({ -1, 1 }) do
				local side = polarCF(A, deg, RING_C + 0.3, mountTop - 0.3) * CFrame.new(s * 1.6, 0, 0) * CFrame.Angles(0, 0, -s * math.rad(26))
				crystal(m, side, 0.9, 1.0, 2, 0.9)
			end
		end
	end
	-- the low diamond gem set into the outer face of the near stone: a dark setting, a Glass rim, a Neon core
	local near = polarCF(A, 0, RING_C + RING_D / 2 + 0.05, 1.6) * CFrame.Angles(0, 0, math.rad(45))
	block(m, "GemSetting", near * CFrame.new(0, 0, 0.06), Vector3.new(2.3, 2.3, 0.4), C.StoneDeep, { Shadow = false })
	block(m, "GemRim", near * CFrame.new(0, 0, -0.12), Vector3.new(1.8, 1.8, 0.4), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.25, Shadow = false })
	block(m, "GemCore", near * CFrame.new(0, 0, -0.2), Vector3.new(1.1, 1.1, 0.4), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
	return m, headTip
end

local function buildPortal(parent, A)
	local m = newModel(parent, "Portal")
	-- inner rim: segmented stone band with lighter tops
	local width = 2 * math.pi * RIM_R / RIM_N + 0.12
	for i = 0, RIM_N - 1 do
		local deg = (i + 0.5) * 360 / RIM_N
		local cf = polarCF(A, deg, RIM_R, RIM_H / 2)
		block(m, "Rim", cf, Vector3.new(width, RIM_H, RIM_D), C.RimSide, { Collide = true, Shadow = false })
		block(m, "RimTop", cf * CFrame.new(0, RIM_H / 2 + 0.06, 0), Vector3.new(width - 0.1, 0.12, RIM_D - 0.36), C.RimTop, { Collide = true, Shadow = false })
	end
	-- the dark navy disc (four turned squares: a 16-gon whose corners hide under the rim) with a lighter heart
	polygon16(m, "Disc", A * CFrame.new(0, 0.08, 0), DISC_S, 0.2, C.Disc, { Collide = true, Shadow = false })
	polygon16(m, "DiscHeart", A * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, math.rad(11.25), 0), 6.2, 0.2, C.DiscInner, { Shadow = false })
	-- dim glowing runes around the heart and a small diamond in the middle
	for i = 0, 7 do
		local cf = polarCF(A, i * 45 + 22.5, 5.05, 0.22)
		block(m, "Rune", cf, Vector3.new(0.9, 0.06, 0.36), C.Rune, { Material = MAT.Neon, Transparency = 0.35, Shadow = false })
	end
	block(m, "Rune", A * CFrame.new(0, 0.22, 0) * CFrame.Angles(0, math.rad(45), 0), Vector3.new(1.3, 0.06, 1.3), C.Rune, { Material = MAT.Neon, Transparency = 0.25, Shadow = false })
	return m
end

----------------------------------------------------------------------
-- Bridge: island -> dock, deck at the island height over the junction rail, steps down onto the street
----------------------------------------------------------------------
local puffTemplate = nil

local function stormPuff()
	if puffTemplate ~= nil then
		return puffTemplate or nil
	end
	puffTemplate = false
	if not Voxel then
		return nil
	end
	local ok, model = pcall(function()
		local g = Voxel.NewGrid(8)
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 0, 0, 0 }, Radius = { 3.2, 1.5, 2.3 }, Key = "Body" })
		Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 2.3, -0.5, 0.6 }, Radius = { 1.9, 1.3, 1.7 }, Key = "Body", KeepExisting = true })
		Voxel.Shade(g, { Smooth = 2, Seed = 4, Dark = false })
		return Voxel.Build(g, { VoxelSize = 1.4, Palette = ISLAND_PALETTE, Name = "StormPuff", MaxParts = 7 })
	end)
	if ok and model then
		puffTemplate = model
	else
		warn("[StormAltar] storm puff failed: " .. tostring(model))
	end
	return puffTemplate or nil
end

local function placePuff(parent, cf)
	local tpl = stormPuff()
	if not tpl then
		return
	end
	local m = tpl:Clone()
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then
			d.CFrame = cf * d.CFrame
		end
	end
	m.Parent = parent
	Mesh.tag(m, "cloud_storm_puff", cf) -- Phase 6
end

-- a stone post with a small crystal on top
local function lantern(parent, cf)
	block(parent, "LanternPost", cf * CFrame.new(0, 1.1, 0), Vector3.new(1.1, 2.2, 1.1), C.StoneB, { Collide = true, Shadow = false })
	local top = cf * CFrame.new(0, 2.2 + 0.45, 0) * CFrame.Angles(0, math.rad(45), 0)
	block(parent, "LanternGlass", top, Vector3.new(0.75, 0.9, 0.75), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.3, Shadow = false })
	block(parent, "LanternCore", top, Vector3.new(0.42, 0.86, 0.42), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
end

-- landing: island edge point, dock: street point (both world, any height). Returns the bridge model and the
-- ground CFrame of the entrance gate (on the street, just past the dock; LookVector = towards the street).
-- Profile: RAMP_LEVEL studs level at the island height, then a straight ramp down to the street height at the
-- dock, then a short level lip that rests on the junction (the junction's inner rail is left open for it).
local function buildBridge(parent, A, landing, dock)
	local deckTop = A.Position.Y + 0.1
	local street = dock.Y
	local endTop = street + 0.06
	local flatA = Vector3.new(landing.X, 0, landing.Z)
	local span = Vector3.new(dock.X, 0, dock.Z) - flatA
	local len = span.Magnitude
	if len < 10 then
		return nil
	end
	local dir = span.Unit
	local m = newModel(parent, "Bridge")
	local over = 1.2 -- the lip past the dock, resting on the street junction
	local level = math.min(RAMP_LEVEL, len * 0.3)
	local function topAt(s)
		if s <= level then
			return deckTop
		elseif s >= len then
			return endTop
		end
		return deckTop + (endTop - deckTop) * (s - level) / (len - level)
	end
	local function pointAt(s)
		local p = flatA + dir * s
		return Vector3.new(p.X, topAt(s), p.Z)
	end
	-- a segment frame: origin on the deck top at s0, -Z down the segment (tilted with the ramp)
	local function segFrame(s0, s1)
		return CFrame.lookAt(pointAt(s0), pointAt(s1))
	end
	local function segLen(s0, s1)
		return (pointAt(s1) - pointAt(s0)).Magnitude
	end

	-- deck: stone slabs with thin seams over a dark beam, per segment
	local slabIndex = 0
	for _, seg in ipairs({ { 0, level }, { level, len }, { len, len + over } }) do
		local cf = segFrame(seg[1], seg[2])
		local sLen = segLen(seg[1], seg[2])
		local slabs = math.max(1, math.floor(sLen / 7 + 0.5))
		local sl = sLen / slabs
		for i = 1, slabs do
			slabIndex = slabIndex + 1
			block(m, "Deck", cf * CFrame.new(0, -0.5, -(i - 0.5) * sl), Vector3.new(BRIDGE_W, 1, sl - 0.14), (slabIndex % 2 == 0) and C.StoneC or C.Stone, { Collide = true })
		end
		if sLen > 2 then
			block(m, "Beam", cf * CFrame.new(0, -1.4, -sLen / 2), Vector3.new(BRIDGE_W - 1.6, 0.9, sLen - 0.4), C.StoneDeep, { Shadow = false })
		end
	end

	-- low parapets (tilted with the deck) with upright crystal lanterns; they stop before the gate's walls
	local mid = (level + len) / 2
	local pieces = { { 1.75, level }, { level, mid - 0.55 }, { mid + 0.55, len - 1.2 } }
	for _, side in ipairs({ -1, 1 }) do
		local x = side * (BRIDGE_W / 2 - 0.35)
		for _, p in ipairs(pieces) do
			local sa, sb = p[1], p[2]
			if sb - sa > 1 then
				local cf = segFrame(sa, sb)
				local l = segLen(sa, sb)
				local c = cf * CFrame.new(x, 0.55, -l / 2)
				block(m, "Parapet", c, Vector3.new(0.7, 1.1, l), C.StoneB, { Collide = true })
				block(m, "ParapetCap", c * CFrame.new(0, 0.62, 0), Vector3.new(0.9, 0.14, l), C.StoneLight, { Collide = true, Shadow = false })
			end
		end
		for _, s in ipairs({ mid }) do
			local p = pointAt(s) + CFrame.lookAt(Vector3.new(), dir).RightVector * x
			lantern(m, CFrame.lookAt(p, p + dir) * CFrame.new(0, -0.4, 0))
		end
	end

	-- a storm puff carries the ramp (under the deck: nothing pokes through it)
	for _, t in ipairs({ 0.55 }) do
		local p = pointAt(len * t)
		placePuff(m, CFrame.lookAt(p, p + dir) * CFrame.new(0, -2.8, 0) * CFrame.Angles(0, t * 5, 0))
	end
	-- the entrance gate stands on the street over the bridge's foot, its poster facing the street
	local g = flatA + dir * (len + 0.85)
	local gate = Vector3.new(g.X, street, g.Z)
	return m, CFrame.lookAt(gate, gate + dir)
end

----------------------------------------------------------------------
-- Sign: the entrance gate with its art panel (SurfaceGui) + a title tag above the altar
----------------------------------------------------------------------
local function corner(parent, scaleOrPx, isScale)
	local c = Instance.new("UICorner")
	if isScale then
		c.CornerRadius = UDim.new(scaleOrPx, 0)
	else
		c.CornerRadius = UDim.new(0, scaleOrPx)
	end
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function frame(parent, name, pos, size, color)
	local f = Instance.new("Frame")
	f.Name = name
	f.Position = pos
	f.Size = size
	f.BackgroundColor3 = color or C.White
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

local function gradient(parent, top, bottom)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = 90
	g.Parent = parent
	return g
end

local function label(parent, text, role, props, outline)
	local l = Theme.Label(text, role, { Color = props.Color or C.White, Stroke = 0, Outline = outline or 2, OutlineColor = C.Ink, Scaled = props.Scaled, Size = props.Size })
	l.Name = props.Name or "Text"
	l.AnchorPoint = props.AnchorPoint or Vector2.new(0.5, 0.5)
	l.Position = props.Position or UDim2.fromScale(0.5, 0.5)
	l.Size = props.Box or UDim2.fromScale(1, 1)
	l.TextWrapped = false
	l.ZIndex = 3
	l.Parent = parent
	return l
end

-- glossy strip over the top half of a bar (the chunky cloud UI look)
local function gloss(parent, radiusPx)
	local g = frame(parent, "Gloss", UDim2.new(0, 4, 0, 3), UDim2.new(1, -8, 0.46, 0), C.White)
	g.BackgroundTransparency = 0.78
	g.ZIndex = 2
	corner(g, radiusPx)
	return g
end

-- Gate poster: a SurfaceGui of 600 x 320 px (PANEL_W x PANEL_H studs at 50 px per stud) in the chunky cloud UI
-- style. World text rule: "STORM ALTAR" in two 56 px lines (1.12 studs), "Secret pets" 34 px (0.68 stud) and
-- "Awakens soon" 32 px (0.64 stud), so every line reads from ~30 studs; the player's art fills a 284 px
-- (5.7-stud) square well on the left.
local function panelGui(board)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PosterGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = POSTER_PPS
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.Adornee = board

	local card = frame(gui, "Card", UDim2.fromOffset(6, 6), UDim2.new(1, -12, 1, -12), C.White)
	corner(card, 24)
	stroke(card, C.Navy, 6)
	gradient(card, C.StormTop, C.Storm)

	-- the player's art in a dark well (left)
	local well = frame(card, "ArtWell", UDim2.fromOffset(12, 12), UDim2.fromOffset(284, 284), C.White)
	corner(well, 18)
	stroke(well, C.CrystalCore, 4)
	gradient(well, rgb(40, 50, 92), rgb(20, 26, 54))
	local art = Instance.new("ImageLabel")
	art.Name = "StormfangArt"
	art.BackgroundTransparency = 1
	art.AnchorPoint = Vector2.new(0.5, 0.5)
	art.Position = UDim2.fromScale(0.5, 0.5)
	art.Size = UDim2.new(1, -12, 1, -12)
	art.Image = Config.Art and Config.Art.StormfangImage or ""
	art.ScaleType = Enum.ScaleType.Fit
	art.ZIndex = 3
	art.Parent = well
	corner(art, 12)

	-- right column (x 308..572): the title bar, the "Secret pets" pill, the phase 1 caption
	local colX, colW = 308, 264
	local bar = frame(card, "TitleBar", UDim2.fromOffset(colX, 12), UDim2.fromOffset(colW, 140), C.White)
	corner(bar, 20)
	stroke(bar, C.Navy, 5)
	gradient(bar, rgb(84, 196, 255), rgb(40, 112, 214))
	gloss(bar, 14)
	local title = label(bar, "STORM\nALTAR", "Title", { Name = "Title", Size = 56, Box = UDim2.new(1, -16, 1, -10) }, 4)
	title.LineHeight = 0.9

	local pill = frame(card, "SecretPill", UDim2.fromOffset(colX, 164), UDim2.fromOffset(colW, 58), C.White)
	corner(pill, 29)
	stroke(pill, C.Navy, 5)
	gradient(pill, rgb(150, 98, 255), rgb(88, 46, 204))
	gloss(pill, 22)
	label(pill, "Secret pets", "Title", { Name = "Subtitle", Size = 34, Box = UDim2.new(1, -16, 1, -6) }, 3)
	label(card, "Awakens soon", "Body", { Name = "Caption", Size = 32, Color = C.Cyan, AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(colX, 232), Box = UDim2.fromOffset(colW, 48) }, 3)

	gui.Parent = board
	return gui
end

-- Title tag above the altar (readable from the plaza and the street). World text rule: a PIXEL-sized billboard,
-- so "STORM ALTAR" (36 px) and "Secret pets" (22 px) keep their on-screen size at any distance.
local TAG_W, TAG_H, TAG_TITLE, TAG_SUB = 300, 100, 36, 22
local function titleTag(anchor)
	local gui = Instance.new("BillboardGui")
	gui.Name = "TitleTag"
	gui.Size = UDim2.fromOffset(TAG_W, TAG_H)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = 150
	gui.Adornee = anchor

	local card = frame(gui, "Card", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), C.White)
	card.BackgroundTransparency = 0.06
	corner(card, 0.3, true)
	stroke(card, C.Electric, 4)
	gradient(card, rgb(70, 60, 130), rgb(28, 36, 76))
	local shine = frame(card, "Gloss", UDim2.new(0.03, 0, 0.06, 0), UDim2.new(0.94, 0, 0.4, 0), C.White)
	shine.BackgroundTransparency = 0.86
	shine.ZIndex = 2
	corner(shine, 0.5, true)
	label(card, "STORM ALTAR", "Title", { Name = "Title", Size = TAG_TITLE, Position = UDim2.fromScale(0.5, 0.36), Box = UDim2.fromScale(0.9, 0.56) }, 3)
	label(card, "Secret pets", "Heading", { Name = "Subtitle", Size = TAG_SUB, Color = C.Cyan, Position = UDim2.fromScale(0.5, 0.78), Box = UDim2.fromScale(0.7, 0.3) }, 2)
	gui.Parent = anchor
	return gui
end

-- The stone entrance gate on the street, over the bridge's foot. cf: ground centre (the street surface),
-- LookVector = towards the street (the poster's face). Two charcoal pillars with crystal tips carry a lintel;
-- the poster hangs between them PANEL_BOTTOM studs up, in a light stone frame; low walls close the gaps between
-- the bridge and the pillars (the junction's inner rail is open here).
local function buildGate(parent, cf)
	local m = newModel(parent, "Gate")
	local px = GATE_HALF
	local pillarH = PILLAR_TOP + 0.6 -- from 0.6 under the street surface (rests in the junction planks)
	for _, side in ipairs({ -1, 1 }) do
		block(m, "GatePillar", cf * CFrame.new(side * px, PILLAR_TOP - pillarH / 2, 0), Vector3.new(PILLAR_W, pillarH, PILLAR_W), C.Stone, { Collide = true })
		block(m, "GatePlinth", cf * CFrame.new(side * px, 0.28, 0), Vector3.new(PILLAR_W + 0.6, 1.86, PILLAR_W + 0.6), C.StoneDeep, { Collide = true })
		-- a low wall from the bridge's edge to the pillar
		local wallW = px - PILLAR_W / 2 - BRIDGE_W / 2
		if wallW > 0.3 then
			local wcf = cf * CFrame.new(side * (BRIDGE_W / 2 + wallW / 2), 0.35, 0)
			block(m, "GateWall", wcf, Vector3.new(wallW, 1.9, 1), C.StoneB, { Collide = true })
			block(m, "GateWallCap", wcf * CFrame.new(0, 1.02, 0), Vector3.new(wallW, 0.16, 1.2), C.StoneLight, { Collide = true, Shadow = false })
		end
		-- a crystal on the lintel above each pillar
		local tip = cf * CFrame.new(side * px, PILLAR_TOP + 1.45, 0) * CFrame.Angles(0, math.rad(45), 0)
		block(m, "GateGemGlass", tip, Vector3.new(0.9, 1.6, 0.9), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.25, Shadow = false })
		local core = block(m, "GateGemCore", tip, Vector3.new(0.52, 1.5, 0.52), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
		pointLight(core, 0.8, 9)
	end
	local panelY = PANEL_BOTTOM + PANEL_H / 2
	-- lintel across the pillar tops; the poster's stone frame hangs from it on the street face of the pillars
	block(m, "GateLintel", cf * CFrame.new(0, PILLAR_TOP + 0.35, PANEL_Z / 2), Vector3.new(2 * px + PILLAR_W + 0.8, 0.7, PILLAR_W - PANEL_Z + 0.2), C.StoneLight, { Collide = true })
	local frameH = PILLAR_TOP - PANEL_BOTTOM + 0.4
	block(m, "GateFrame", cf * CFrame.new(0, PILLAR_TOP - frameH / 2, PANEL_Z), Vector3.new(PANEL_W + 0.6, frameH, 0.4), C.StoneLight, { Shadow = false })
	-- the back of the frame between the pillars, with a diamond emblem (seen from the island)
	block(m, "GateBack", cf * CFrame.new(0, panelY, PANEL_Z + 0.25), Vector3.new(2 * px - PILLAR_W, PANEL_H - 0.4, 0.1), C.StoneB, { Shadow = false })
	local emblem = cf * CFrame.new(0, panelY, PANEL_Z + 0.4) * CFrame.Angles(0, 0, math.rad(45))
	block(m, "GateGemGlass", emblem, Vector3.new(1.8, 1.8, 0.3), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.25, Shadow = false })
	block(m, "GateGemCore", emblem * CFrame.new(0, 0, 0.06), Vector3.new(1.1, 1.1, 0.3), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
	local gem = cf * CFrame.new(0, PILLAR_TOP + 1.25, PANEL_Z) * CFrame.Angles(0, 0, math.rad(45))
	block(m, "GateGemGlass", gem, Vector3.new(1.3, 1.3, 0.6), C.CrystalGlass, { Material = MAT.Glass, Transparency = 0.25, Shadow = false })
	block(m, "GateGemCore", gem * CFrame.new(0, 0, -0.08), Vector3.new(0.8, 0.8, 0.6), C.CrystalCore, { Material = MAT.Neon, Shadow = false })
	local board = block(m, "GatePanel", cf * CFrame.new(0, panelY, PANEL_Z - 0.25), Vector3.new(PANEL_W, PANEL_H, 0.3), C.Storm, { Shadow = false })
	panelGui(board)
	return m
end

-- gateCF: ground centre of the entrance gate (LookVector = towards the street), or nil.
local function buildSign(parent, A, gateCF, titleY)
	local m = newModel(parent, "StormAltarSign")
	if not gateCF then
		-- no bridge: a free-standing gate at the island's back edge
		local back = -A.LookVector
		local p = A.Position + back * (R_TOP - 5)
		gateCF = flatLook(p, p + back)
	end
	buildGate(m, gateCF)
	-- title tag above the showcase
	local anchor = invisible(m, "TitleAnchor", A * CFrame.new(0, titleY, 0))
	titleTag(anchor)
	return m
end

----------------------------------------------------------------------
-- Showcase: the big Stormfang
----------------------------------------------------------------------
local function stormfangDef()
	local def = nil
	if PetCatalog and type(PetCatalog.Get) == "function" then
		local ok, result = pcall(PetCatalog.Get, PET_ID)
		if ok and type(result) == "table" then
			def = result
		end
	end
	if not def then
		-- the catalog entry is not there (yet): a neutral look of the species
		def = { Id = PET_ID, Name = "Stormfang", Rarity = "Secret", Look = { Species = "Stormfang", WingStyle = "StormCloud" } }
	end
	return def
end

-- Lowest / highest point and horizontal reach of a model's parts relative to `origin`.
local function extents(model, origin)
	local lo, hi, reach = math.huge, -math.huge, 0
	local inv = origin:Inverse()
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local cf = inv * d.CFrame
			local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
			local s = d.Size
			local hy = (math.abs(r10) * s.X + math.abs(r11) * s.Y + math.abs(r12) * s.Z) / 2
			local hx = (math.abs(r00) * s.X + math.abs(r01) * s.Y + math.abs(r02) * s.Z) / 2
			local hz = (math.abs(r20) * s.X + math.abs(r21) * s.Y + math.abs(r22) * s.Z) / 2
			local p = cf.Position
			lo = math.min(lo, p.Y - hy)
			hi = math.max(hi, p.Y + hy)
			reach = math.max(reach, math.abs(p.X) + hx, math.abs(p.Z) + hz)
		end
	end
	if lo == math.huge then
		return nil
	end
	return lo, hi, reach
end

-- The finished, placed Stormfang showcase pet (not parented) and its extents, or nil.
local function makeShowcasePet(A)
	local def = stormfangDef()
	local ok, pet = pcall(PetBuilder.Build, def, { Detail = "High", Scale = 3 })
	if not ok or typeof(pet) ~= "Instance" then
		warn("[StormAltar] Stormfang showcase failed: " .. tostring(pet))
		return nil
	end
	pet.Name = "StormfangShowcase"
	pet:PivotTo(CFrame.new())
	local lo, hi, reach = extents(pet, CFrame.new())
	lo, hi, reach = lo or -4, hi or 5, reach or 4.5
	-- hover over the portal, leaning forward (prowling) about the bottom centre
	local pose = A * CFrame.new(0, HOVER, 0) * CFrame.Angles(PROWL, 0, 0) * CFrame.new(0, -lo, 0)
	pet:PivotTo(pose)
	local parts = 0
	for _, d in ipairs(pet:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			parts = parts + 1
		end
	end
	pet:SetAttribute("PetId", def.Id or PET_ID)
	pet:SetAttribute("PetParts", parts)
	pet:SetAttribute("HoverAmp", 0.45)
	pet:SetAttribute("Ready", true)
	CollectionService:AddTag(pet, SHOWCASE_TAG)
	return pet, lo, hi, reach
end

-- Returns the showcase model (or nil) and the height of its top above the walking surface.
local function buildShowcase(parent, A)
	if not PetBuilder or type(PetBuilder.Build) ~= "function" then
		warn("[StormAltar] PetBuilder is unavailable: no Stormfang showcase")
		return nil, HOVER + 10
	end
	local pet, lo, hi, reach = makeShowcasePet(A)
	if not pet then
		return nil, HOVER + 10
	end
	pet.Parent = parent
	-- Phase 6: the mesh Stormfang replaces this Part build once its keys load after boot (same name, same place;
	-- the clients' ShowcaseController picks the new tagged model up). Empty MeshIds = nothing.
	if type(PetBuilder.SwapWhenReady) == "function" then
		pcall(PetBuilder.SwapWhenReady, pet, stormfangDef(), { Detail = "High", Scale = 3 }, function()
			return (makeShowcasePet(A))
		end)
	end

	-- one invisible collider keeps players out of the big (non-colliding) pet
	local height = HOVER + (hi - lo)
	local radius = math.min(math.max(reach * 0.8, 3.5), RIM_R - 0.6)
	local col = block(parent, "ShowcaseCollider", A * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), Vector3.new(height, radius * 2, radius * 2), C.Storm, { Collide = true, Transparency = 1, Shadow = false })
	col.Shape = Enum.PartType.Cylinder
	col.CanQuery = false
	return pet, height
end

----------------------------------------------------------------------
-- Prompt, lights, sparkles
----------------------------------------------------------------------
-- A side toast for that player (rate-limited per player: TOAST_COOLDOWN).
local function notify(player, text)
	local now = os.clock()
	local last = lastToast[player]
	if last and now - last < TOAST_COOLDOWN then
		return
	end
	lastToast[player] = now
	local ok, remote = pcall(Remotes.Get, "Notify")
	if ok and remote and player.Parent then
		remote:FireClient(player, text or TOAST, "info", 5)
	end
end

-- GemService (Phase 2) is optional and loaded after this module: looked up when the prompt is used.
local gemModule = nil
local function gemService()
	if gemModule then
		return gemModule
	end
	local inst = script.Parent and script.Parent:FindFirstChild("GemService")
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		gemModule = result
		return result
	end
	return nil
end

-- "Open" | "Restricted" | "Checking" | "Unavailable" (no GemService: the phase 1 behaviour)
local function secretState(player)
	local gems = gemService()
	if not gems or type(gems.SecretRouletteState) ~= "function" then
		return "Unavailable"
	end
	local ok, state = pcall(gems.SecretRouletteState, player)
	if ok and type(state) == "string" then
		return state
	end
	return "Unavailable"
end

-- Opens the Shop on the gems-only Secret roulette (no Tab: the Shop picks the tab that holds that roulette).
local function openSecretRoulette(player)
	local now = os.clock()
	local last = lastOpen[player]
	if last and now - last < OPEN_COOLDOWN then
		return
	end
	lastOpen[player] = now
	local ok, remote = pcall(Remotes.Get, "OpenPanel")
	if ok and remote and player.Parent then
		remote:FireClient(player, "Shop", { RouletteId = SECRET_ROULETTE_ID, Currency = "Gems" })
	end
end

local function onAltarUsed(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") or player.Parent ~= Players then
		return
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return
	end
	local state = secretState(player)
	if state == "Open" then
		openSecretRoulette(player)
	elseif state == "Restricted" then
		notify(player, TOAST_RESTRICTED)
	else
		notify(player, TOAST) -- the gem system is missing or still checking this account
	end
	StormAltar.Used:Fire(player)
end

local function buildPrompt(parent, A)
	local part = invisible(parent, "AltarPrompt", A * CFrame.new(0, 2.4, 0))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "StormAltarPrompt"
	prompt.ActionText = "Summon"
	prompt.ObjectText = "Storm Altar"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 21
	prompt.RequiresLineOfSight = false
	prompt.Parent = part
	prompt.Triggered:Connect(onAltarUsed)
	-- the portal's soft glow and a few sparkles rising from it
	pointLight(part, 1.3, 14)
	local rise = Instance.new("Attachment")
	rise.Name = "PortalSparkles"
	rise.CFrame = CFrame.new(0, -2.1, 0)
	rise.Parent = part
	sparkles(rise, 4, 2.2, 0.5)
	return prompt
end

local function hookPlayers()
	if playersHooked then
		return
	end
	playersHooked = true
	Players.PlayerRemoving:Connect(function(player)
		lastToast[player] = nil
		lastOpen[player] = nil
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
local function containerOf(lobbyInfo)
	local folder = type(lobbyInfo) == "table" and lobbyInfo.Folder or nil
	if typeof(folder) == "Instance" and (folder:IsA("Folder") or folder:IsA("Model")) and folder:IsDescendantOf(Workspace) then
		return folder
	end
	return Workspace
end

function StormAltar.Build(lobbyInfo)
	hookPlayers()
	local container = containerOf(lobbyInfo)
	-- rebuild: replace an older altar
	local old = container:FindFirstChild(MODEL_NAME) or Workspace:FindFirstChild(MODEL_NAME, true)
	if old and old:IsA("Model") then
		old:Destroy()
	end
	altarModel, altarCFrame, altarLanding = nil, nil, nil

	local info = type(lobbyInfo) == "table" and lobbyInfo or {}
	local site = typeof(info.AltarSite) == "CFrame" and info.AltarSite or nil
	if not site then
		site = fallbackSite(info)
	end
	site = flatLook(site.Position, site.Position + site.LookVector) -- yaw only
	local top = site.Position.Y -- the lobby's walking height
	local A = site * CFrame.new(0, DECK, 0)

	local model = Instance.new("Model")
	model.Name = MODEL_NAME
	model:SetAttribute("Phase", 1)
	local core = invisible(model, "AltarCore", A)
	model.PrimaryPart = core

	local dock = typeof(info.AltarDock) == "Vector3" and info.AltarDock or nil
	if not dock then
		dock = findDock(site, top, { model })
	end
	-- bridge direction (altar-local angle) and the landing on the island's edge
	local gapDeg, landing = 180, nil
	if dock then
		local dl = A:PointToObjectSpace(dock)
		gapDeg = math.deg(atan2(dl.X, -dl.Z)) % 360
		local flat = Vector3.new(dock.X - A.Position.X, 0, dock.Z - A.Position.Z)
		if flat.Magnitude > R_TOP + 2 then
			landing = A.Position + flat.Unit * (R_TOP - 4)
		end
	end

	section("island", function()
		buildIsland(model, A, gapDeg)
	end)
	local tops = {}
	section("stone ring", function()
		local _, t = buildRing(model, A)
		tops = t or {}
	end)
	section("portal", function()
		buildPortal(model, A)
	end)
	local headTip = 0
	section("crystals", function()
		local _, tip = buildCrystals(model, A, tops)
		headTip = tip or 0
	end)
	local gateCF = nil
	if landing and dock then
		section("bridge", function()
			local _, g = buildBridge(model, A, landing, Vector3.new(dock.X, top, dock.Z))
			gateCF = g
		end)
	end
	local showTop = HOVER + 10
	section("showcase", function()
		local _, h = buildShowcase(model, A)
		showTop = h or showTop
	end)
	section("sign", function()
		-- the title tag floats clear of the showcase and the head crystal
		buildSign(model, A, gateCF, math.max(showTop, headTip) + 4.6)
	end)
	section("prompt", function()
		buildPrompt(model, A)
	end)
	section("lights", function()
		-- the head crystal glows softly onto the stones and the cloud
		local glow = invisible(model, "CrystalGlow", polarCF(A, 180, RING_C - 1.5, 7))
		pointLight(glow, 1, 10)
		sparkles(glow, 1.5, 1, 0.35)
	end)

	-- Phase 6: mesh dressing of the static pieces (origin = the altar CFrame A; the bridge keeps its puffs' parts,
	-- the sign keeps its poster board)
	local meshTargets = {
		{ "Island", "cloud_altar" },
		{ "Ring", "prop_altar_ring" },
		{ "Portal", "prop_altar_portal" },
		{ "Crystals", "prop_altar_crystals" },
		{ "Bridge", "floor_altar_bridge", Mesh.PuffParts },
		{ "StormAltarSign", "prop_altar_sign", { "GatePanel" } },
	}
	for _, t in ipairs(meshTargets) do
		local target = model:FindFirstChild(t[1])
		if target then
			Mesh.tag(target, t[2], A, nil, t[3])
		end
	end

	-- part budget (the showcase pet is excluded)
	local parts = 0
	local showcase = model:FindFirstChild("StormfangShowcase")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not (showcase and d:IsDescendantOf(showcase)) then
			parts = parts + 1
		end
	end
	if parts > MAX_PARTS then
		warn(string.format("[StormAltar] %d parts (budget %d)", parts, MAX_PARTS))
	end

	model.Parent = container -- parented last: the whole altar replicates in one step
	altarModel = model
	altarCFrame = A
	-- the Altar gate's arrival point: the island end of the bridge (else the front of the deck), facing the altar
	local arrive = landing or (A * CFrame.new(0, 0, -(R_TOP - 6))).Position
	arrive = Vector3.new(arrive.X, A.Position.Y, arrive.Z) + (Vector3.new(A.Position.X, arrive.Y, A.Position.Z) - Vector3.new(arrive.X, arrive.Y, arrive.Z)).Unit * 2
	altarLanding = flatLook(arrive + Vector3.new(0, 3, 0), A.Position + Vector3.new(0, 3, 0))
	print(string.format("[StormAltar] built (%d parts + showcase)", parts))
	return A
end

function StormAltar.GetModel()
	if altarModel and altarModel.Parent then
		return altarModel
	end
	return nil
end

function StormAltar.GetCFrame()
	return altarCFrame
end

function StormAltar.GetLanding()
	if altarModel and altarModel.Parent then
		return altarLanding
	end
	return nil
end

----------------------------------------------------------------------
-- Phase 6 kit hooks (read-only; the game never calls them): blender/kit/props/lobby_world.py sets
-- StormAltar._Kit = { Targets = {} } before Build() to list the mesh targets, and re-voxels the island's rim and belly
-- finer with _Blueprint. Tests use _Mesh.
----------------------------------------------------------------------
StormAltar._Kit = nil
StormAltar._Mesh = Mesh

-- rim: the billow grid at `bv` studs per voxel (game: 2), belly: f voxels per 3-stud game voxel (game: 1)
function StormAltar._Blueprint(gapDeg, bv, f)
	if not Voxel then
		return nil
	end
	return {
		Rim = sculptRim(gapDeg or 180, bv or BV),
		Belly = sculptBelly(f or 1),
		RimVoxel = bv or BV,
		BellyVoxel = 3 / (f or 1),
		Palette = ISLAND_PALETTE,
		RTop = R_TOP,
	}
end

return StormAltar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="860">
          <Properties>
            <string name="Name">TokenService</string>
            <string name="Source"><![CDATA[-- TokenService: the cloud tokens. MakeTokenPart builds the visual (a detailed voxel coin: a rounded golden disc
-- on a fine block lattice with a lighter glowing rim, a gold face and a cream cloud emblem in relief on both
-- sides, plus a soft halo), and Watch() turns tokens inside a match course into collectable pickups.
--
-- Animation: with Config.Tokens.ClientAnimated (the shipping setting) the server never poses a coin; the client
-- controller TokenFx spins + bobs every coin locally and moves the "Halo" child with it (the halo is an anchored,
-- unwelded child of the coin root, so it bobs but never has to spin). With the flag false a cheap server-side
-- driver poses only the coins next to a player (see "Shared animation driver").
--
-- Phase 5: the geometry lives in shared/TokenLook.lua (TokenLook.Build, palettes Cloud / Golden; the home's Cloud
-- Cash uses its Cash palettes); MakeTokenPart calls it and adds the attributes, tags and the animation record.
--
-- The voxel coin (v3, ARCHITECTURE_V3.md "ART DIRECTION"): every piece is a block on one lattice (u studs per
-- voxel, 11 voxels across). The round silhouette is three overlapping centred blocks (11x5, 9x9, 5x11 voxels: a
-- clean stepped circle) in a lighter glowing gold, the gold face sits half a voxel proud of the rim on both sides
-- (a 7x7 plate; an octagon of two plates on golden coins), and the cream cloud emblem (a 5x2 base under a
-- centred 3x1 dome: a cloud's rounded top) stands half a voxel proud of the face. Overlapping centred blocks keep
-- the part count tiny (a Saint course holds ~100 coins and the course part budget counts them, so the coin can
-- never grow): 7 parts per coin, 8 for a golden one, halo included.
--
-- v2: golden bonus tokens. MakeTokenPart(position, parent, value) with value >= Config.Tokens.GoldenValue
-- builds a bigger (1.5x), paler-gold, brighter-sparkling coin, tagged BOTH Config.Tags.GoldenToken and
-- Config.Tags.CloudToken. Watch() stays the only collector.
--
-- Plain Lua 5.1-compatible syntax only. No asset ids: Parts + built-in particle textures.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local TokenLook = require(Shared.TokenLook) -- the coin geometry (Phase 5 3.5: shared with the home's Cloud Cash)

local TokenService = {}

local TOKEN_TAG = Config.Tags.CloudToken
local GOLDEN_TAG = Config.Tags.GoldenToken
local DEFAULT_VALUE = Config.Tokens.DefaultValue
local GOLDEN_VALUE = Config.Tokens.GoldenValue
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds" -- the collect burst

----------------------------------------------------------------------
-- Tunables
----------------------------------------------------------------------
local ANIM_STEP = 1 / 15 -- the driver poses tokens at 15 Hz: a slow spin does not need more
local CULL_DISTANCE = 65 -- tokens farther than this from every player are left alone (not even looked at)
local PLAYER_REFRESH = 0.5 -- how often the driver re-reads player positions and re-picks the tokens to pose

local PICKUP_POLL = 0.12 -- backup proximity poll inside Watch()
local PICKUP_RADIUS = 3.2 -- studs from the character's root to the token centre
local GOLDEN_PICKUP_RADIUS = 4.4 -- golden tokens are bigger, so they are easier to grab
local COLLECT_FADE = 0.3

----------------------------------------------------------------------
-- Palette: the token looks live in TokenLook (Palettes Cloud / Golden); the collect effect reuses their colours
----------------------------------------------------------------------
local LOOKS = { normal = TokenLook.Palettes.Cloud, golden = TokenLook.Palettes.Golden }
local GOLD = LOOKS.normal.Face
local GLOW = LOOKS.normal.Glow
local GOLDEN_GLOW = LOOKS.golden.Glow
local GOLDEN_RIM = LOOKS.golden.Face

local BOB_SPEED = TokenLook.Motion.BobSpeed -- radians per second of the up/down sine

----------------------------------------------------------------------
-- Shared animation driver
--   One Heartbeat connection for every token in the server. Each token gets an entry with its
--   base position and a random phase so neighbours never move in lockstep.
--
--   Cost model (why it is built like this): the coin is an anchored root plus welded pieces, and
--   every pose is a CFrame write that replicates to every client, once per part of the moving
--   assembly. A Saint course has ~95 tokens (~20 golden, ~620 parts). Posing every token (6 parts,
--   golden 9) at 30 Hz was ~18k part updates per second for the whole server (measured on generated
--   courses with the smoke mock). Now only tokens within CULL_DISTANCE of a player are posed, at
--   15 Hz, and the aura (a sphere, so spinning never changes how it looks) is not part of the
--   moving assembly (5 parts per coin, 8 per golden one): ~1.4k updates per second with one player
--   on Saint, ~3.7k-4.2k with four (Easy: ~5k before, ~0.3k-1.9k now). The tokens that are not
--   posed are only looked at every PLAYER_REFRESH seconds (that is when the short list of tokens
--   to pose is rebuilt); the per-step work is a plain walk over that list.
--
--   Tokens that are not in the workspace yet wait; tokens that were destroyed are dropped.
--   Config.Tokens.ClientAnimated = true switches the whole driver off (clients animate locally).
----------------------------------------------------------------------
local SERVER_ANIMATION = Config.Tokens.ClientAnimated ~= true

local animated = {} -- token part -> { base, lastPos, phase, parented, spin, bob }
local active = {} -- array of the token parts near a player, rebuilt by refreshActive()
local driverConnection = nil
local nextStepAt = 0
local nextRefreshAt = 0
local phaseRng = Random.new()
local CULL_DISTANCE_SQ = CULL_DISTANCE * CULL_DISTANCE

-- If something else moved the token (e.g. its course was pivoted), follow along instead of
-- snapping it back to the old place.
local function followExternalMove(token, rec)
	local moved = token.Position - rec.lastPos
	if moved:Dot(moved) > 0.0625 then
		rec.base = rec.base + moved
		rec.lastPos = rec.lastPos + moved
	end
end

-- Re-read the player positions and rebuild `active`. Also forgets tokens that were in the world and
-- are gone (destroyed, or their course folder was: that leaves Parent set, hence IsDescendantOf).
local function refreshActive(now)
	nextRefreshAt = now + PLAYER_REFRESH
	local positions = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = Util.GetRoot(player)
		if root then
			positions[#positions + 1] = root.Position
		end
	end

	active = {}
	for token, rec in pairs(animated) do
		if token.Parent == nil or not token:IsDescendantOf(Workspace) then
			-- Not in the world. Never-parented tokens just wait; one that WAS in the world and is gone
			-- is forgotten so this table never keeps dead tokens alive.
			if rec.parented then
				animated[token] = nil
			end
		else
			-- Welded pieces only follow the root once the token is in the workspace.
			rec.parented = true
			followExternalMove(token, rec)
			local base = rec.base
			for _, position in ipairs(positions) do
				local d = base - position
				if d:Dot(d) <= CULL_DISTANCE_SQ then
					active[#active + 1] = token
					break
				end
			end
		end
	end
end

local function stepTokens()
	local now = os.clock()
	if now < nextStepAt then
		return
	end
	-- steady cadence: schedule from the previous due time, so a frame that lands a hair early does not
	-- cost a whole extra frame; after a hitch do not try to catch up
	nextStepAt = nextStepAt + ANIM_STEP
	if nextStepAt <= now then
		nextStepAt = now + ANIM_STEP
	end
	if next(animated) == nil then
		return
	end
	if now >= nextRefreshAt then
		refreshActive(now)
	end

	for i = 1, #active do
		local token = active[i]
		local rec = animated[token] -- nil once collected / forgotten since the last refresh
		if rec and token.Parent ~= nil then
			followExternalMove(token, rec)
			local base = rec.base
			local bob = math.sin(now * BOB_SPEED + rec.phase) * rec.bob
			local position = Vector3.new(base.X, base.Y + bob, base.Z)
			token.CFrame = CFrame.new(position) * CFrame.Angles(0, now * rec.spin + rec.phase, 0)
			rec.lastPos = position
		end
	end
end

local function ensureDriver()
	if driverConnection or not SERVER_ANIMATION then
		return
	end
	driverConnection = RunService.Heartbeat:Connect(function()
		local ok, err = pcall(stepTokens)
		if not ok then
			warn("[TokenService] animation step failed: " .. tostring(err))
		end
	end)
end

local function stopAnimating(token)
	animated[token] = nil
end

----------------------------------------------------------------------
-- The token visual
----------------------------------------------------------------------
-- True when `value` makes a token golden.
local function isGoldenValue(value)
	return type(value) == "number" and value >= GOLDEN_VALUE
end

-- THE visual cloud token. position: world Vector3 (centre of the coin). parent: Instance or nil.
-- value: how many tokens it is worth (attribute "Value", default Config.Tokens.DefaultValue).
-- value >= Config.Tokens.GoldenValue makes a golden token (also tagged GoldenToken).
-- The returned Part is the coin (its 9x9 voxel core block, built by TokenLook.Build): Anchored, CanCollide=false,
-- tagged CloudToken. The coin stands on its edge facing local X, so spinning it around the world Y axis shows both
-- faces. TokenLook builds the parts; this adds the attributes, the tags and the server animation record.
function TokenService.MakeTokenPart(position, parent, value)
	ensureDriver()
	if type(value) ~= "number" or value ~= value then
		value = DEFAULT_VALUE
	end
	local golden = isGoldenValue(value)
	local look = golden and LOOKS.golden or LOOKS.normal
	local phase = phaseRng:NextNumber(0, math.pi * 2)
	local token = TokenLook.Build({
		Position = position,
		Palette = golden and "Golden" or "Cloud",
		Phase = phase,
		Light = true,
		Sparkles = true,
		Halo = true,
	})
	token:SetAttribute("Value", value)
	if golden then
		token:SetAttribute("Golden", true)
	end
	CollectionService:AddTag(token, TOKEN_TAG)
	if golden then
		CollectionService:AddTag(token, GOLDEN_TAG)
	end
	if SERVER_ANIMATION then
		animated[token] = {
			base = position,
			lastPos = position,
			phase = phase,
			parented = false,
			spin = look.Spin,
			bob = look.Bob,
		}
	end
	token.Parent = parent
	return token
end

----------------------------------------------------------------------
-- Collection effect
----------------------------------------------------------------------
-- Sparkle burst + expanding glow bubble (both parented to `effectParent` so they vanish with the
-- course), while the coin itself pops upward, fades and is destroyed. Golden tokens get a bigger
-- burst and an expanding ground ring on top.
local function playCollectEffect(token, effectParent, golden)
	local position = token.Position
	local glow = golden and GOLDEN_GLOW or GLOW
	local core = golden and GOLDEN_RIM or GOLD

	local burst = Instance.new("Part")
	burst.Name = "TokenBurst"
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanTouch = false
	burst.CanQuery = false
	burst.CastShadow = false
	burst.Transparency = 1
	burst.Size = Vector3.new(1, 1, 1)
	burst.CFrame = CFrame.new(position)

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE_TEXTURE
	emitter.Color = ColorSequence.new(glow, core)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(0.45, golden and 1.1 or 0.85)
	emitter.Speed = NumberRange.new(12, golden and 30 or 24)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-180, 180)
	emitter.Acceleration = Vector3.new(0, -8, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, golden and 1.3 or 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.7, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = burst
	burst.Parent = effectParent
	emitter:Emit(golden and 44 or 22)
	Debris:AddItem(burst, 1.6)

	local bubble = Instance.new("Part")
	bubble.Name = "TokenBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.new(1.5, 1.5, 1.5)
	bubble.Material = Enum.Material.Neon
	bubble.Color = glow
	bubble.Transparency = 0.5
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanTouch = false
	bubble.CanQuery = false
	bubble.CastShadow = false
	bubble.CFrame = CFrame.new(position)
	bubble.Parent = effectParent
	local bubbleSize = golden and 11 or 7
	Util.Tween(bubble, 0.35, { Size = Vector3.new(bubbleSize, bubbleSize, bubbleSize), Transparency = 1 },
		Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(bubble, 0.6)

	if golden then
		-- flat ring racing outwards at the token's height
		local ring = Instance.new("Part")
		ring.Name = "TokenRing"
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.2, 2, 2)
		ring.Material = Enum.Material.Neon
		ring.Color = GOLDEN_GLOW
		ring.Transparency = 0.45
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanTouch = false
		ring.CanQuery = false
		ring.CastShadow = false
		ring.CFrame = CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2)
		ring.Parent = effectParent
		Util.Tween(ring, 0.6, { Size = Vector3.new(0.2, 16, 16), Transparency = 1 },
			Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		Debris:AddItem(ring, 0.9)
	end

	-- the coin itself: float up, fade every piece, dim the light, stop the sparkles
	local lift = Vector3.new(0, golden and 4 or 3, 0)
	for _, d in ipairs(token:GetDescendants()) do
		if d:IsA("BasePart") then
			local goal = { Transparency = 1 }
			if d.Anchored then
				-- the unwelded aura does not follow the coin: lift it by hand
				goal.CFrame = d.CFrame + lift
			end
			Util.Tween(d, COLLECT_FADE, goal, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		elseif d:IsA("PointLight") then
			Util.Tween(d, COLLECT_FADE, { Brightness = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		elseif d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	Util.Tween(token, COLLECT_FADE, {
		Transparency = 1,
		CFrame = token.CFrame + lift,
	}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(token, COLLECT_FADE + 0.15)
end

----------------------------------------------------------------------
-- Watch: make the tokens of one match course collectable
----------------------------------------------------------------------
local function isGoldenToken(token)
	return CollectionService:HasTag(token, GOLDEN_TAG) or token:GetAttribute("Golden") == true
end

-- container: the course Folder/Model. matchHandle = { AddTokens = function(player, n) end }.
-- Returns stopFn (idempotent): disconnects every Touched/poll/descendant hook.
function TokenService.Watch(container, matchHandle)
	if not container then
		warn("[TokenService] Watch called without a container")
		return function() end
	end

	local stopped = false
	local tokens = {} -- token part -> { conn = Touched connection, radiusSq = pickup radius squared }
	local collected = {} -- token part -> true; a token is only ever collected once
	local connections = {} -- container-level connections

	local function forget(token)
		local rec = tokens[token]
		if rec and rec.conn then
			rec.conn:Disconnect()
		end
		tokens[token] = nil
		stopAnimating(token)
	end

	-- Claim the token for `player`: effect, destroy, credit. Safe against being called twice.
	local function tryCollect(token, player)
		if stopped or collected[token] then
			return
		end
		if not token.Parent or token:GetAttribute("Collected") then
			return
		end
		if not player or player.Parent == nil then
			return -- the player left
		end
		if player:GetAttribute(Config.Attr.Downed) == true then
			return -- downed players cannot pick things up
		end
		local humanoid = Util.GetHumanoid(player)
		if not humanoid or humanoid.Health <= 0 then
			return
		end

		-- claim it first: everything below may yield or error, the token must stay claimed
		collected[token] = true
		token:SetAttribute("Collected", true)
		local golden = isGoldenToken(token)
		forget(token)

		local value = token:GetAttribute("Value")
		if type(value) ~= "number" or value ~= value then
			if golden then
				value = GOLDEN_VALUE
			else
				value = DEFAULT_VALUE
			end
		end
		value = math.max(1, math.floor(value + 0.5))

		if container.Parent then
			local ok, err = pcall(playCollectEffect, token, container, golden)
			if not ok then
				warn("[TokenService] collect effect failed: " .. tostring(err))
				token:Destroy()
			end
		else
			token:Destroy()
		end

		if matchHandle and type(matchHandle.AddTokens) == "function" then
			local ok, err = pcall(matchHandle.AddTokens, player, value)
			if not ok then
				warn("[TokenService] AddTokens failed: " .. tostring(err))
			end
		end
	end

	local function register(inst)
		if stopped or tokens[inst] or collected[inst] then
			return
		end
		if not inst:IsA("BasePart") or not CollectionService:HasTag(inst, TOKEN_TAG) then
			return
		end
		local radius = PICKUP_RADIUS
		if isGoldenToken(inst) then
			radius = GOLDEN_PICKUP_RADIUS
		end
		tokens[inst] = {
			radiusSq = radius * radius,
			conn = inst.Touched:Connect(function(hit)
				if stopped or collected[inst] then
					return
				end
				local player = Util.PlayerFromPart(hit)
				if player then
					tryCollect(inst, player)
				end
			end),
		}
	end

	for _, d in ipairs(container:GetDescendants()) do
		register(d)
	end
	table.insert(connections, container.DescendantAdded:Connect(register))

	-- Backup for Touched: anchored, spinning parts occasionally miss a fast-moving character, so
	-- also collect when a living player's root is within the pickup radius of a token.
	task.spawn(function()
		while not stopped do
			task.wait(PICKUP_POLL)
			if stopped then
				break
			end
			local nearby = {}
			for _, player in ipairs(Players:GetPlayers()) do
				local root = Util.GetRoot(player)
				if root then
					table.insert(nearby, { player = player, position = root.Position })
				end
			end
			if #nearby > 0 then
				for token, rec in pairs(tokens) do
					if token.Parent and not collected[token] then
						local tp = token.Position
						for _, entry in ipairs(nearby) do
							local d = tp - entry.position
							if d:Dot(d) <= rec.radiusSq then
								tryCollect(token, entry.player)
								break
							end
						end
					end
				end
			end
		end
	end)

	return function()
		if stopped then
			return
		end
		stopped = true
		for token in pairs(tokens) do
			forget(token)
		end
		tokens = {}
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
		connections = {}
	end
end

-- Start the shared animation driver (also started lazily by MakeTokenPart). Idempotent. Does nothing
-- when Config.Tokens.ClientAnimated is true (the clients spin and bob the coins).
function TokenService.Init()
	ensureDriver()
end

return TokenService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="861">
          <Properties>
            <string name="Name">TutorialService</string>
            <string name="Source"><![CDATA[-- TutorialService: server-authoritative progress of the new-player tutorial (ARCHITECTURE_V3.md section 4, the
-- Phase 2 "Tutorial" paragraph, rewritten by Phase 4 "Phase 4 build contract" section 9: claim a home, put a pet in the
-- Pet Garden, scoop its rainbow coins, build the Food Machine, feed a pet; the Phase 3 chapter: go to the Battle Arena,
-- set a battle team, win Trial 1, see a Boss Raid; and the Phase 4 chapter: train a pet, win a Champion Ring round, walk
-- through the home portal). Phase 5 ("Phase 5 build contract" 8; indices never move): the portal step points at the ONE
-- Obby portal (lobby.Portals.Obby), chapter 2 runs on the Phase 5 home (roaming pets poop Cloud Cash: the arrow finds the
-- biggest drop, TycoonService.Drops; the Berry Farm pad before the Food Machine pad; entering the feed step tops the
-- berries up to FEED_BERRIES once so the first feed works), chapter 3's step 17 is the Dungeon (DungeonWon: floor 1
-- cleared; the arrow at DungeonInfo.Pad; standing on that pad opens the Dungeon window on floor 1 once).
--
--   TutorialService.Init(lobbyInfo, deps)     deps = { DataService, PetService, MatchService, SpotService, IndexService,
--                                                      TycoonService, PetCareService, BattleService, ArenaInfo,
--                                                      DungeonInfo, DungeonService }
--                                                      (missing ones are looked up; ArenaInfo = ArenaBuilder.Build's,
--                                                      DungeonInfo = DungeonBuilder.Build's { Portal, Pad, PromptPart })
--   TutorialService.GetState(player) -> payload | nil       (the TutorialState payload below, a fresh copy)
--   TutorialService.HandleEvent(player, eventName) -> ok, reason      (what the TutorialEvent remote does)
--   TutorialService.Reload(player, opts) -> ok   drops the running tutorial and reads it again from the profile
--                                                (opts.Replay = true: no chapter rewards again; the developer tools)
--   TutorialService.StepCompleted              Util.Signal, Fire(player, stepId, stepIndex)
--   TutorialService.Finished                   Util.Signal, Fire(player, skipped)
--
-- Steps come from shared/TutorialSteps.lua, in CHAPTERS (1 = the basics, 2 = the tycoon home, 3 = pet battles, 4 = pets
-- make the money).
-- Progress lives in the
-- profile (DataService.GetTutorial / SetTutorial: { Step, Done, Gifted }); DataService merges Done and Gifted so they
-- stick once true, so the stored fields mean:
--   Done = false              chapter 1 is running at Step
--   Done = true, Step inside a later chapter (2..)   chapter 1 is behind the player and that chapter runs at Step
--                             (a player who finished the Phase 1 tutorial has Step = 10: the home chapter starts there)
--   Done = true, Step = #Steps + 1   everything finished (a chapter added later starts from there)
--   Done = true, Step = SKIPPED_STEP (or a chapter-1 step: old saves)   skipped: no tutorial any more
-- Completing a step marked ChapterEnd pays that chapter's reward once (the step is stored BEFORE paying, so a crash
-- can never pay twice): chapter 1 = Config.Tutorial.FinishReward (tokens), chapter 2 = HOME_FINISH_CASH Cash,
-- chapter 3 = ARENA_FINISH_TOKENS Cloud Tokens, chapter 4 = RING_FINISH_TOKENS Cloud Tokens.
--
-- A step completes on what the SERVER observes:
--   Claimed       the player owns a home plot (SpotService.GetSpot; TycoonService.Claimed / the SpotIndex attribute
--                 for an instant answer, a 2 Hz poll as the backup)
--   Built         the saved home has the step's Station at level >= 1 (DataService.GetHome; TycoonService.HomeChanged)
--   Collected     (Phase 2, retired with the Collector: no step uses it, a step that still did passes at once)
--   Fed           PetCareService.Fed (a feed at the Food Machine / the Pets panel)
--   GardenPlaced  (Phase 4) a pet sits in an OPEN place of the Pet Garden (Home.Garden, TycoonCatalog.GardenSlots;
--                 TycoonService.HomeChanged + the poll)
--   CoinsScooped  TycoonService.CoinsScooped while the step runs; a home that already has the Food Machine passes at once
--   TrainingStarted  PetCareService.TrainingStarted, or any training job / rank in DataService.GetGrowthMap
--   RingWon       BattleService.BattleEnded with Mode "Ring" and Won, or DataService.GetRing(player).Best >= 1
--   PortalUsed    TycoonService.PortalUsed while the step runs (the player walked through their home portal)
--   NearSpot      2 Hz poll: the character within 14 studs (horizontally) of SpotService.GetSpot(player).Center
--   Rolled        PetService.Rolled (backup: Profile.Stats.Spins grew since the step began)
--   Equipped      the equipped list changed to a non-empty one (PetService.PerksChanged / attribute EquippedPets),
--                 or the client reports "PetsOpened" while a pet is equipped
--   MatchStarted  / MatchEnded: the player attribute InMatch turning true / false
--   ArenaReached  (Phase 3) the character stands in the Battle Arena: ArenaBuilder.InArena(position), else within
--                 ArenaInfo.Radius of ArenaInfo.Center (2 Hz poll)
--   TeamSet       the active battle team holds the player's pets: DataService.ActiveTeamKeys has at least
--                 min(3, the pets that can join a team: DataService.FieldableKeys) entries, so a player with one pet
--                 passes with that one pet and a player with many must field three (DataService.TeamsChanged + the poll)
--   DungeonWon    (Phase 5, replaces TrialWon) Dungeon floor 1 is cleared: DungeonService.FloorCleared(player, floor),
--                 or the saved Dungeon.Best >= 1 / Cleared[1] (DataService.GetDungeon), or a legacy Battle.TrialCleared[1] /
--                 TrialBest >= 1 (DataService.GetBattle): a Phase 4 veteran does not redo the step
--   RaidSeen      the player joined a Boss Raid (BattleService.RaidJoined / a Raid BattleEnded naming them), has a raid
--                 in the record (Battle.Raids), or stands in the arena while BattleService.GetRaidStatus() is not nil
--   Next / ShopOpened / IndexOpened: client reports through the TutorialEvent remote, accepted only when they
--                 match the CURRENT step. "Skip" ends the tutorial (no reward, no later chapter); "Sync" asks for the
--                 current state again. The remote is type checked and rate limited.
-- Entering a Gift step grants Config.Tutorial.GiftTokens once (Tutorial.Gifted is stored first). A step that cannot
-- be done in this server because a service is missing (no PetService, MatchService, TycoonService, PetCareService)
-- is passed automatically, and so is a "Claimed" step while every plot stays taken for a minute.
--
-- Guide targets of the home steps are resolved HERE (the client only knows the lobby names): the gate of the plot to
-- claim (the claimed plot, else the last plot when free, else the nearest free one; pinned while it stays free so
-- the arrow does not hop between plots), a buy pad on the own plot (HomeBuilder.GetPad, else the TycoonCatalog slot),
-- the next pad on the way to a station (its prerequisites first), a built station (the Food Machine's Hopper, a
-- Training Place mat), the first empty open place of the Pet Garden, the fullest rainbow-coin pile
-- (TycoonService.Piles), or the Shop / the Pets menu button when a pet is missing. They are sent as
-- { Kind = "Spot", Position, SpotIndex, Label } (or { Kind = "Menu", Id = "Pets" }) with a matching Hint, and the
-- poll re-sends the state whenever the target or the hint changes. Phase 3 targets { Kind = "Arena", Place } are
-- resolved from ArenaInfo the same way (sent as Kind "Spot" + Position: the client draws its guide arrow for those):
-- "Gate" = the Arena gate of the Gate Court (ArenaInfo.ArenaPortal; else ArenaInfo.Spawn, the forum), "Floor" = the
-- colosseum floor, "Ring" = the Champion Ring portal (ArenaInfo.RingPortal; the gate of a free home first while the
-- player has none), "Dungeon" = the Dungeon gate's pad (DungeonInfo.Pad); no arrow while the player fights (attribute
-- InBattle) or runs the Dungeon (DungeonService.GetRun). The raid step's hint counts down to the next raid in minutes
-- (EventService.SecondsUntil) or says that one is running.
--
-- TutorialState payload (server -> that player, on join, on every change, on "Sync"):
--   { Step = n, Total = #Steps, Id, Title, Text, Target = {Kind, Id, Label, Position = Vector3|nil, SpotIndex},
--     CompleteOn, Hint, Button, Gift = bool, Chapter, Done = bool, Completed = bool (finished this session),
--     Skipped = bool, Reward = tokens granted on completion }
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local TutorialService = {}
TutorialService.StepCompleted = Util.Signal()
TutorialService.Finished = Util.Signal()

local POLL_INTERVAL = 0.5 -- seconds (NearSpot / level checks / target refresh run at 2 Hz)
local EVENT_COOLDOWN = 0.25 -- seconds per player between TutorialEvent requests
local SYNC_COOLDOWN = 1 -- seconds per player between "Sync" requests
local MAX_EVENT_LENGTH = 32
local NEAR_SPOT_RADIUS = 14 -- studs, horizontal
local NEAR_SPOT_HEIGHT = 24 -- studs of vertical slack (the root stands ~3 studs above the yard)
local NO_SPOT_GRACE = 10 -- seconds without a spot before a NearSpot step is passed
local NO_FREE_GRACE = 60 -- seconds without any free plot before a Claimed step is passed
local SKIPPED_STEP = 1000 -- Tutorial.Step of a skipped tutorial (DataService caps Step at 1000): no later chapter
-- Not in Config (lead-owned): the home chapter's reward, paid once when the "feed" step completes.
local HOME_FINISH_CASH = 1000
-- Not in Config (lead-owned): the pet-battle chapter's reward, paid once when its last step completes.
local ARENA_FINISH_TOKENS = 500
-- Not in Config (lead-owned): the Phase 4 chapter's reward ("Pets tutorial complete!"), paid once by its last step.
local RING_FINISH_TOKENS = 300
-- Phase 5: the first feed costs berries ("a feed needs 40"): entering the feed step tops the berries up to this many
-- (DataService.AddBerries of the difference; nothing when the player already has them). A top-up, not a payment: the
-- step completes on the first feed, so rejoining never adds more than one feed's worth of free berries.
local FEED_BERRIES = 500
local DUNGEON_PAD_RADIUS = 12 -- studs (horizontal) around DungeonInfo.Pad: standing there opens the Dungeon window once
local ARENA_RADIUS = 160 -- studs around ArenaInfo.Center that count as the arena when ArenaBuilder.InArena is missing
local ATTR_IN_BATTLE = "InBattle" -- BattleService's attribute (the battle id while the player fights)
local STATION_FRONT_GAP = 2.5 -- studs in front of a station's footprint where its guide arrow stands
local TOKEN_GLYPH = "\226\152\129" -- cloud

-- client event -> the CompleteOn it can complete (Skip / Sync are handled separately)
local EVENT_COMPLETES = {
	Next = "Next",
	ShopOpened = "ShopOpened",
	IndexOpened = "IndexOpened",
	PetsOpened = "Equipped",
}

local KNOWN_COMPLETE_ON = {
	Next = true,
	NearSpot = true,
	ShopOpened = true,
	Rolled = true,
	Equipped = true,
	IndexOpened = true,
	MatchStarted = true,
	MatchEnded = true,
	-- Phase 2 (the home chapter)
	Claimed = true,
	Built = true,
	Collected = true,
	Fed = true,
	-- Phase 3 (the pet-battle chapter)
	ArenaReached = true,
	TeamSet = true,
	RaidSeen = true,
	-- Phase 4 (chapter 2 rewritten + chapter 4)
	GardenPlaced = true,
	CoinsScooped = true,
	TrainingStarted = true,
	RingWon = true,
	PortalUsed = true,
	-- Phase 5 (chapter 3's step 17)
	DungeonWon = true,
}

----------------------------------------------------------------------
-- Collaborators (other engineers' modules: every use is guarded)
----------------------------------------------------------------------

local function loadModule(parent, name)
	local module = parent and parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[TutorialService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

local TutorialSteps = loadModule(Shared, "TutorialSteps")

local DataService = nil
local PetService = nil
local MatchService = nil
local SpotService = nil
local TycoonService = nil
local PetCareService = nil
local HomeBuilder = nil -- read-only lookups of pads / stations (GetPad / GetStation)
local TycoonCatalog = nil
local PetKeys = nil -- read-only: List(profile) (does the player own a pet?)
local lobby = nil
-- Phase 3 (the pet-battle chapter): every use is guarded
local BattleService = nil
local ArenaBuilder = nil -- read-only: InArena(position)
local EventService = nil -- read-only: SecondsUntil("BossRaid")
local BattleCatalog = nil
local arenaInfo = nil
-- Phase 5 (the Dungeon step): every use is guarded
local DungeonService = nil
local dungeonInfo = nil

local function hasSignal(module, name)
	return type(module) == "table" and type(module[name]) == "table" and type(module[name].Connect) == "function"
end

local function hasFunction(module, name)
	return type(module) == "table" and type(module[name]) == "function"
end

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------

local steps = {} -- validated copy of TutorialSteps.Steps
local tracks = {} -- [player] = track (see newTrack)
local playerConns = {} -- [player] = { RBXScriptConnection... }
local lastEvent = {} -- [player] = os.clock() of the last accepted TutorialEvent
local lastSync = {} -- [player] = os.clock() of the last answered "Sync"
local initialized = false
local running = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isLivePlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent == Players
end

local function fireClient(remoteName, player, ...)
	if not isLivePlayer(player) then
		return
	end
	local okGet, remote = pcall(Remotes.Get, remoteName)
	if not okGet or not remote then
		return
	end
	local args = { n = select("#", ...), ... }
	local ok, err = pcall(function()
		remote:FireClient(player, unpack(args, 1, args.n))
	end)
	if not ok then
		warn("[TutorialService] " .. remoteName .. " failed: " .. tostring(err))
	end
end

local function notify(player, text, kind, duration)
	fireClient("Notify", player, text, kind or "info", duration or 4)
end

local function positiveInt(n)
	if type(n) == "number" and n == n and n > 0 and n < math.huge then
		return math.floor(n)
	end
	return 0
end

local function giftTokens()
	local t = type(Config.Tutorial) == "table" and Config.Tutorial or {}
	return positiveInt(t.GiftTokens)
end

local function finishTokens()
	local t = type(Config.Tutorial) == "table" and Config.Tutorial or {}
	local reward = t.FinishReward
	if type(reward) == "table" then
		return positiveInt(reward.Tokens)
	end
	return positiveInt(reward)
end

local function formatText(text)
	text = tostring(text or "")
	text = text:gsub("{GiftTokens}", tostring(giftTokens()))
	text = text:gsub("{FinishTokens}", tostring(finishTokens()))
	if text:find("{RaidMinutes}", 1, true) then
		local minutes = 20
		local events = type(BattleCatalog) == "table" and BattleCatalog.Events
		local first = type(events) == "table" and type(events.Schedule) == "table" and events.Schedule[1]
		if type(first) == "table" and tonumber(first.EveryMinutes) then
			minutes = math.floor(tonumber(first.EveryMinutes))
		end
		text = text:gsub("{RaidMinutes}", tostring(minutes))
	end
	return text
end

local function commas(n)
	return Util.Commas(math.floor(tonumber(n) or 0))
end

local function money(n)
	return "$" .. commas(n)
end

-- Copies TutorialSteps.Steps into a clean local list (bad entries are dropped, unknown CompleteOn -> "Next").
local function buildSteps()
	steps = {}
	local source = type(TutorialSteps) == "table" and TutorialSteps.Steps
	if type(source) ~= "table" then
		return
	end
	for _, raw in ipairs(source) do
		if type(raw) == "table" and type(raw.Id) == "string" then
			local completeOn = raw.CompleteOn
			if not KNOWN_COMPLETE_ON[completeOn] then
				completeOn = "Next"
			end
			local target = nil
			if type(raw.Target) == "table" and type(raw.Target.Kind) == "string" then
				local t = raw.Target
				target = {
					Kind = t.Kind,
					Id = t.Id,
					Label = t.Label,
					Gate = t.Gate == true,
					Pad = type(t.Pad) == "string" and t.Pad or nil,
					Station = type(t.Station) == "string" and t.Station or nil,
					Path = t.Path == true,
					Food = t.Food == true,
					GardenSpot = t.GardenSpot == true,
					Coins = t.Coins == true,
					Place = type(t.Place) == "string" and t.Place or nil,
				}
			end
			local chapter = tonumber(raw.Chapter) or 1
			table.insert(steps, {
				Id = raw.Id,
				Chapter = math.max(1, math.floor(chapter)),
				ChapterEnd = raw.ChapterEnd == true,
				Title = type(raw.Title) == "string" and raw.Title or "",
				Text = type(raw.Text) == "string" and raw.Text or "",
				Target = target,
				CompleteOn = completeOn,
				Station = type(raw.Station) == "string" and raw.Station or nil,
				Gift = raw.Gift == true,
				Hint = type(raw.Hint) == "string" and raw.Hint or nil,
				Button = type(raw.Button) == "string" and raw.Button or nil,
			})
		end
	end
end

local function chapterOf(index)
	local step = steps[index]
	return step and step.Chapter or 1
end

-- true when a stored "Done" tutorial whose Step is `index` still has something to show (a later chapter)
local function resumable(index)
	return type(index) == "number" and index >= 1 and index <= #steps and chapterOf(index) > 1
end

local function inMatch(player)
	return player:GetAttribute(Config.Attr.InMatch) == true
end

local function getProfile(player)
	if not hasFunction(DataService, "GetProfile") then
		return nil
	end
	local ok, profile = pcall(DataService.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function spinsOf(player)
	local profile = getProfile(player)
	local stats = profile and profile.Stats
	if type(stats) == "table" and type(stats.Spins) == "number" then
		return stats.Spins
	end
	return 0
end

-- The equipped list as a csv (profile first, the replicated attribute as a fallback).
local function equippedCsv(player)
	local profile = getProfile(player)
	if profile and type(profile.Equipped) == "table" then
		local ids = {}
		for _, id in ipairs(profile.Equipped) do
			if type(id) == "string" then
				table.insert(ids, id)
			end
		end
		return table.concat(ids, ",")
	end
	local attr = player:GetAttribute(Config.Attr.EquippedPets)
	if type(attr) == "string" then
		return attr
	end
	return ""
end

local function getSpot(player)
	if not hasFunction(SpotService, "GetSpot") then
		return nil
	end
	local ok, spot = pcall(SpotService.GetSpot, player)
	if ok and type(spot) == "table" then
		return spot
	end
	return nil
end

local function rootOf(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function firstRouletteId()
	local list = Config.Roulettes
	if type(list) == "table" and type(list[1]) == "table" and type(list[1].Id) == "string" then
		return list[1].Id
	end
	return "Cloud"
end

-- the saved home (a copy) or nil
local function getHome(player)
	if not hasFunction(DataService, "GetHome") then
		return nil
	end
	local ok, home = pcall(DataService.GetHome, player)
	if ok and type(home) == "table" then
		return home
	end
	return nil
end

local function stationLevel(home, id)
	local stations = type(home) == "table" and home.Stations
	local level = type(stations) == "table" and stations[id]
	if type(level) == "number" and level == level then
		return level
	end
	return 0
end

-- true when the player owns at least one pet (PetKeys.List, else the plain Pets counts)
local function ownsPet(player)
	local profile = getProfile(player)
	if not profile then
		return false
	end
	if hasFunction(PetKeys, "List") then
		local ok, list = pcall(PetKeys.List, profile)
		if ok and type(list) == "table" then
			return #list > 0
		end
	end
	for _, n in pairs(type(profile.Pets) == "table" and profile.Pets or {}) do
		if type(n) == "number" and n > 0 then
			return true
		end
	end
	return false
end

local function stationDef(id)
	if not TycoonCatalog or type(id) ~= "string" then
		return nil
	end
	local ok, def = pcall(TycoonCatalog.Get, id)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

----------------------------------------------------------------------
-- Guide targets
----------------------------------------------------------------------

-- World position of a Phase 1 step target (nil when unknown); the client also finds the models by name.
local function lobbyPosition(player, target)
	local kind = target.Kind
	if kind == "Spot" then
		local spot = getSpot(player)
		if spot and typeof(spot.Center) == "Vector3" then
			return spot.Center
		end
	elseif kind == "Portal" then
		local portals = lobby and lobby.Portals
		local info = type(portals) == "table" and portals[target.Id or "Obby"]
		if type(info) == "table" and typeof(info.Center) == "Vector3" then
			return info.Center
		end
	elseif kind == "Roulette" or kind == "Shop" then
		local shop = lobby and lobby.Shop
		local roulettes = type(shop) == "table" and shop.Roulettes
		local info = type(roulettes) == "table" and roulettes[target.Id or firstRouletteId()]
		if type(info) == "table" and typeof(info.Center) == "Vector3" then
			return info.Center
		end
	end
	return nil
end

local function spotIndexOf(info)
	if type(info) ~= "table" then
		return nil
	end
	if type(info.Index) == "number" then
		return info.Index
	end
	local folder = info.Folder
	if typeof(folder) == "Instance" then
		local index = folder:GetAttribute("SpotIndex")
		if type(index) == "number" then
			return index
		end
	end
	return nil
end

local function spotByIndex(index)
	if type(index) ~= "number" then
		return nil
	end
	if hasFunction(SpotService, "GetSpotByIndex") then
		local ok, info = pcall(SpotService.GetSpotByIndex, index)
		if ok and type(info) == "table" then
			return info
		end
	end
	local spots = lobby and lobby.Spots
	if type(spots) == "table" and type(spots[index]) == "table" then
		return spots[index]
	end
	return nil
end

local function ownerOf(index)
	if hasFunction(SpotService, "GetOwner") then
		local ok, owner = pcall(SpotService.GetOwner, index)
		if ok then
			return owner
		end
	end
	return nil
end

local function gatePosition(info)
	if hasFunction(SpotService, "GateCFrame") then
		local ok, cf = pcall(SpotService.GateCFrame, info)
		if ok and typeof(cf) == "CFrame" then
			return cf.Position
		end
	end
	if typeof(info.GateCFrame) == "CFrame" then
		return info.GateCFrame.Position
	end
	if typeof(info.Center) == "Vector3" then
		return info.Center
	end
	return nil
end

-- The gate of the plot to claim: { Kind, Position, SpotIndex, Label } or nil. The suggestion is pinned on the track
-- while that plot stays free (the nearest free plot changes as the player walks).
local function gateTarget(player, track)
	local own = getSpot(player)
	if own then
		local position = typeof(own.Center) == "Vector3" and own.Center or gatePosition(own)
		return { Kind = "Spot", SpotIndex = spotIndexOf(own), Position = position, Label = "Your Home" }
	end
	local info = nil
	if track.GateIndex and ownerOf(track.GateIndex) == nil then
		info = spotByIndex(track.GateIndex)
	end
	if not info and hasFunction(SpotService, "SuggestSpot") then
		local ok, suggestion = pcall(SpotService.SuggestSpot, player)
		if ok and type(suggestion) == "table" then
			info = suggestion
		end
	end
	if not info then
		track.GateIndex = nil
		return nil
	end
	track.GateIndex = spotIndexOf(info)
	local position = gatePosition(info)
	if not position then
		return nil
	end
	return { Kind = "Spot", SpotIndex = track.GateIndex, Position = position, Label = "Free home" }
end

-- A model's pivot position, or nil.
local function pivotOf(model)
	if typeof(model) ~= "Instance" then
		return nil
	end
	local ok, cf = pcall(function()
		if model:IsA("Model") then
			return model:GetPivot()
		elseif model:IsA("BasePart") then
			return model.CFrame
		end
		return nil
	end)
	if ok and typeof(cf) == "CFrame" then
		return cf.Position
	end
	return nil
end

local function homeBuilderCall(fnName, spot, id)
	if not hasFunction(HomeBuilder, fnName) then
		return nil
	end
	local ok, result = pcall(HomeBuilder[fnName], spot, id)
	if ok and typeof(result) == "Instance" then
		return result
	end
	return nil
end

-- the buy pad of `id` on the claimed plot (HomeBuilder's model, else the catalog slot)
local function padPosition(spot, id)
	local at = pivotOf(homeBuilderCall("GetPad", spot, id))
	if at then
		return at
	end
	local def = stationDef(id)
	if def and type(def.Slot) == "table" and typeof(def.Slot.Pad) == "CFrame" and typeof(spot.PlotCFrame) == "CFrame" then
		return (spot.PlotCFrame * def.Slot.Pad).Position
	end
	return nil
end

-- the world position of a marker inside a model: a BasePart's Position or an Attachment's WorldPosition
local function markerPosition(model, name)
	local mark = typeof(model) == "Instance" and model:FindFirstChild(name, true) or nil
	if mark and mark:IsA("BasePart") then
		return mark.Position
	elseif mark and mark:IsA("Attachment") then
		return mark.WorldPosition
	end
	return nil
end

-- the marker of a built station the arrow points at (HomeBuilder's Phase 4 art): the Food Machine's Hopper, the first
-- Training Place mat
local STATION_MARKERS = { Kitchen = "Hopper", Gym = "Spot1" }

-- where a built station's arrow stands: its marker (STATION_MARKERS), else just in front of the station's footprint
local function stationPosition(spot, id)
	local model = homeBuilderCall("GetStation", spot, id)
	local marked = STATION_MARKERS[id] and markerPosition(model, STATION_MARKERS[id]) or nil
	if marked then
		return marked
	end
	local def = stationDef(id)
	if def and type(def.Slot) == "table" and typeof(def.Slot.CFrame) == "CFrame" and typeof(spot.PlotCFrame) == "CFrame" then
		local depth = typeof(def.Slot.Footprint) == "Vector3" and def.Slot.Footprint.Z or 8
		return (spot.PlotCFrame * def.Slot.CFrame * CFrame.new(0, 0, -(depth / 2 + STATION_FRONT_GAP))).Position
	end
	return pivotOf(model)
end

----------------------------------------------------------------------
-- Phase 4: the Pet Garden and its rainbow coins (Home.Garden, TycoonCatalog.GardenSlots, TycoonService.Piles)
----------------------------------------------------------------------
local Garden = {}

-- how many garden places are open (0 while the Pet Garden is not built)
function Garden.open(home)
	if not hasFunction(TycoonCatalog, "GardenSlots") or type(home) ~= "table" then
		return 0
	end
	local ok, n = pcall(TycoonCatalog.GardenSlots, home)
	if ok and type(n) == "number" and n == n then
		return math.max(0, math.floor(n))
	end
	return 0
end

-- the key in garden place `slot`, or nil
function Garden.keyAt(home, slot)
	local garden = type(home) == "table" and home.Garden or nil
	local key = type(garden) == "table" and (garden[slot] or garden[tostring(slot)]) or nil
	if type(key) == "string" and key ~= "" then
		return key
	end
	return nil
end

-- true when a pet sits in an open garden place (the "garden" step)
function Garden.placed(player)
	local home = getHome(player)
	if not home or stationLevel(home, "Garden") < 1 then
		return false
	end
	for slot = 1, Garden.open(home) do
		if Garden.keyAt(home, slot) then
			return true
		end
	end
	return false
end

-- the world position of garden place `slot` (the lawn's Spot<slot> attachment, else the catalog layout)
function Garden.placePosition(spot, slot)
	local model = homeBuilderCall("GetStation", spot, "Garden")
	local at = markerPosition(model, "Spot" .. tostring(slot))
	if at then
		return at
	end
	local def = stationDef("Garden")
	local spots = def and type(def.Slot) == "table" and def.Slot.Spots or nil
	local local3 = type(spots) == "table" and spots[slot] or nil
	if typeof(local3) == "Vector3" and typeof(def.Slot.CFrame) == "CFrame" and typeof(spot.PlotCFrame) == "CFrame" then
		return (spot.PlotCFrame * def.Slot.CFrame * CFrame.new(local3)).Position
	end
	return pivotOf(model)
end

-- the pile with the most Cash in it ({ Coins, Value, Pos } from TycoonService.Piles; "W" = the Welcome-back pile), or nil
function Garden.fullestPile(player)
	if not hasFunction(TycoonService, "Piles") then
		return nil
	end
	local ok, piles = pcall(TycoonService.Piles, player)
	if not ok or type(piles) ~= "table" then
		return nil
	end
	local best, bestValue = nil, -1
	for slot, pile in pairs(piles) do
		if type(pile) == "table" and typeof(pile.Pos) == "Vector3" then
			local value = tonumber(pile.Value) or 0
			local real = (slot == "W" and value >= 1) or (slot ~= "W" and (tonumber(pile.Coins) or 0) >= 1)
			if real and value > bestValue then
				best, bestValue = pile, value
			end
		end
	end
	return best
end

-- the "garden" step: no pet -> the Shop; no Pet Garden -> its free pad; else the first empty open place (or Pets)
function Garden.target(player, spot, home, index, step)
	if not ownsPet(player) then
		local shop = { Kind = "Shop", Id = firstRouletteId(), Label = "Cloud Shop" }
		local ok, position = pcall(lobbyPosition, player, shop)
		shop.Position = ok and typeof(position) == "Vector3" and position or nil
		return shop, "Spin a roulette for a pet"
	end
	if stationLevel(home, "Garden") < 1 then
		return { Kind = "Spot", SpotIndex = index, Position = padPosition(spot, "Garden"), Label = "Pet Garden pad" },
			"Press E on the Pet Garden pad"
	end
	for slot = 1, Garden.open(home) do
		if not Garden.keyAt(home, slot) then
			local at = Garden.placePosition(spot, slot)
			if at then
				return { Kind = "Spot", SpotIndex = index, Position = at, Label = step.Target.Label or "Pet Garden" },
					"Press E on a pet bed"
			end
		end
	end
	return { Kind = "Menu", Id = "Pets", Label = "Pets" }, "Open Pets and press Garden"
end

-- Phase 5: the biggest Cloud Cash drop of the yard (TycoonService.Drops: { Slot, Cycle, Position, Value, Poops, ... }
-- sorted slot then cycle; the first of equal values wins, so the pick is stable). A leftover fraction (Poops 0, under
-- $1) is invisible on the client and never picked. nil when the yard has none (or Drops is missing).
function Garden.biggestDrop(player)
	if not hasFunction(TycoonService, "Drops") then
		return nil
	end
	local ok, drops = pcall(TycoonService.Drops, player)
	if not ok or type(drops) ~= "table" then
		return nil
	end
	local best, bestValue = nil, 0
	for _, drop in ipairs(drops) do
		if type(drop) == "table" and typeof(drop.Position) == "Vector3" then
			local value = tonumber(drop.Value) or 0
			local poops = tonumber(drop.Poops)
			if value >= 1 and (poops == nil or poops >= 1) and value > bestValue then
				best, bestValue = drop, value
			end
		end
	end
	return best
end

-- the "coins" step: the biggest drop (the fullest pile on a server without Drops), else the Garden while its pets
-- roam toward their first poop
function Garden.coinsTarget(player, spot, index, step)
	local label = step.Target.Label or "Cloud Cash"
	local drop = Garden.biggestDrop(player)
	if drop then
		return { Kind = "Spot", SpotIndex = index, Position = drop.Position, Label = label }, "Walk over your Cloud Cash"
	end
	if not hasFunction(TycoonService, "Drops") then
		local pile = Garden.fullestPile(player)
		if pile then
			return { Kind = "Spot", SpotIndex = index, Position = pile.Pos, Label = label }, "Walk over your Cloud Cash"
		end
	end
	return { Kind = "Spot", SpotIndex = index, Position = stationPosition(spot, "Garden"), Label = "Pet Garden" },
		"Pets are roaming: wait a moment"
end

-- true when the player trains (or has trained) a pet: any Job or any rank in PetGrowth
local function hasTrained(player)
	if not hasFunction(DataService, "GetGrowthMap") then
		return false
	end
	local ok, map = pcall(DataService.GetGrowthMap, player)
	if not ok or type(map) ~= "table" then
		return false
	end
	for _, entry in pairs(map) do
		if type(entry) == "table" then
			if type(entry.Job) == "table" then
				return true
			end
			for _, stat in ipairs({ "Speed", "Physique", "Ability", "Defense" }) do
				if (tonumber(entry[stat]) or 0) > 0 then
					return true
				end
			end
		end
	end
	return false
end

-- true when the stored Champion Ring record has a won round
local function ringBest(player)
	if not hasFunction(DataService, "GetRing") then
		return 0
	end
	local ok, ring = pcall(DataService.GetRing, player)
	return ok and type(ring) == "table" and (tonumber(ring.Best) or 0) or 0
end

local function padsById(home)
	local byId = {}
	if not TycoonCatalog or not hasFunction(TycoonCatalog, "AvailablePads") then
		return byId
	end
	local ok, pads = pcall(TycoonCatalog.AvailablePads, home)
	if ok and type(pads) == "table" then
		for _, pad in ipairs(pads) do
			if type(pad) == "table" and type(pad.StationId) == "string" then
				byId[pad.StationId] = pad
			end
		end
	end
	return byId
end

-- The pad to buy next on the way to station `goal`: its own pad when it can be bought, else (depth first, in
-- catalog order) a prerequisite's. nil when nothing on the way can be bought right now.
local function padToward(home, byId, goal, depth, seen)
	if depth > 8 or seen[goal] then
		return nil
	end
	seen[goal] = true
	local pad = byId[goal]
	if pad and not pad.Locked then
		return pad
	end
	local def = stationDef(goal)
	if not def or type(def.Requires) ~= "table" then
		return nil
	end
	local keys = {}
	for key in pairs(def.Requires) do
		if stationDef(key) and key ~= "Prestige" then
			keys[#keys + 1] = key
		end
	end
	table.sort(keys, function(a, b)
		local da, db = stationDef(a), stationDef(b)
		return (da.Order or 0) < (db.Order or 0)
	end)
	for _, key in ipairs(keys) do
		if stationLevel(home, key) < (tonumber(def.Requires[key]) or 0) then
			local found = padToward(home, byId, key, depth + 1, seen)
			if found then
				return found
			end
		end
	end
	return nil
end

local function cheapestPad(byId)
	local best = nil
	for _, pad in pairs(byId) do
		if not pad.Locked and not pad.Prestige and type(pad.Price) == "number" then
			if not best or pad.Price < best.Price or (pad.Price == best.Price and pad.StationId < best.StationId) then
				best = pad
			end
		end
	end
	return best
end

local function padText(pad)
	local def = stationDef(pad.StationId)
	local name = (def and def.Name) or pad.Name or pad.StationId
	local price = tonumber(pad.Price) or 0
	local cost = price > 0 and (" for " .. money(price)) or " (free)"
	if (tonumber(pad.Level) or 0) > 0 then
		return name .. " Lv " .. tostring(pad.NextLevel) .. cost
	end
	return name .. cost
end

-- target, hint for a home step (Kind "Spot" targets with a Pad / Station / Gate / Food field)
local function homeTarget(player, track, step)
	local t = step.Target
	if t.Gate then
		local target = gateTarget(player, track)
		if target then
			track.NoFree = false
			if target.Label == "Your Home" then
				return target, "Your home is claimed!"
			end
			return target, step.Hint
		end
		track.NoFree = true
		return nil, "Wait for a free home"
	end
	local spot = getSpot(player)
	if not spot then
		-- every other home step happens on the player's own plot: claim one first
		return gateTarget(player, track), "Claim a home first"
	end
	local home = getHome(player) or {}
	local index = spotIndexOf(spot)
	if t.GardenSpot then
		return Garden.target(player, spot, home, index, step)
	end
	if t.Coins then
		return Garden.coinsTarget(player, spot, index, step)
	end
	if t.Food then
		local machine = t.Station or "Kitchen"
		if stationLevel(home, machine) >= 1 then
			return { Kind = "Spot", SpotIndex = index, Position = stationPosition(spot, machine), Label = t.Label or "Food Machine" },
				"Press E at the Food Machine"
		end
		local byId = padsById(home)
		local pad = padToward(home, byId, machine, 0, {}) or cheapestPad(byId)
		if pad then
			return { Kind = "Spot", SpotIndex = index, Position = padPosition(spot, pad.StationId), Label = padText(pad) },
				"Build the Food Machine first"
		end
		return nil, step.Hint
	end
	local stationId = t.Station
	if stationId and stationLevel(home, stationId) >= 1 then
		local hint = step.Hint
		if stationId == "Gym" then
			hint = "Press E at the Training Place"
		end
		return { Kind = "Spot", SpotIndex = index, Position = stationPosition(spot, stationId), Label = t.Label or stationId }, hint
	end
	local goal = t.Pad
	if not goal then
		return nil, step.Hint
	end
	local byId = padsById(home)
	local pad = byId[goal]
	if t.Path then
		local next = padToward(home, byId, goal, 0, {})
		if not next and not (pad and not pad.Locked) then
			next = cheapestPad(byId)
		end
		if next and next.StationId ~= goal then
			return { Kind = "Spot", SpotIndex = index, Position = padPosition(spot, next.StationId), Label = "Next: " .. padText(next) },
				"Next: " .. padText(next)
		end
	end
	local hint = step.Hint
	if pad and not pad.Locked and t.Path then
		hint = "Build " .. padText(pad)
	elseif pad and pad.Locked then
		hint = tostring(pad.Locked)
	end
	return { Kind = "Spot", SpotIndex = index, Position = padPosition(spot, goal), Label = t.Label or goal }, hint
end

----------------------------------------------------------------------
-- Phase 3: the Battle Arena (ArenaInfo from ArenaBuilder.Build, BattleService, EventService)
----------------------------------------------------------------------
local function positionOfInfo(value)
	if typeof(value) == "CFrame" then
		return value.Position
	elseif typeof(value) == "Vector3" then
		return value
	elseif typeof(value) == "Instance" then
		if value:IsA("BasePart") then
			return value.Position
		elseif value:IsA("Model") then
			local ok, cf = pcall(function()
				return value:GetPivot()
			end)
			if ok and cf then
				return cf.Position
			end
		end
	elseif type(value) == "table" then
		return positionOfInfo(value.CFrame)
	end
	return nil
end

-- the ArenaInfo (from Init, else ArenaBuilder.GetInfo once the arena is built)
local function getArenaInfo()
	if type(arenaInfo) == "table" then
		return arenaInfo
	end
	if hasFunction(ArenaBuilder, "GetInfo") then
		local ok, info = pcall(ArenaBuilder.GetInfo)
		if ok and type(info) == "table" then
			arenaInfo = info
			return info
		end
	end
	return nil
end

local function arenaKnown()
	return getArenaInfo() ~= nil or hasFunction(ArenaBuilder, "InArena")
end

-- true while the player's character stands in the Battle Arena
local function inArena(player)
	local root = rootOf(player)
	if not root then
		return false
	end
	if hasFunction(ArenaBuilder, "InArena") then
		local ok, inside = pcall(ArenaBuilder.InArena, root.Position)
		if ok and type(inside) == "boolean" then
			return inside
		end
	end
	local info = getArenaInfo()
	local center = info and positionOfInfo(info.Center)
	if not center then
		return false
	end
	local offset = root.Position - center
	local radius = tonumber(info.Radius) or ARENA_RADIUS
	return Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius and math.abs(offset.Y) <= 80
end

local function inBattle(player)
	local id = player:GetAttribute(ATTR_IN_BATTLE)
	return id ~= nil and id ~= false and id ~= ""
end

local function activeTeamSize(player)
	if not hasFunction(DataService, "ActiveTeamKeys") then
		return 0
	end
	local ok, keys = pcall(DataService.ActiveTeamKeys, player)
	if ok and type(keys) == "table" then
		return #keys
	end
	return 0
end

-- how many pets the player could put in a team (owned, not busy in the Garden / Gym); nil when unknown
local function fieldablePets(player)
	if not hasFunction(DataService, "FieldableKeys") then
		return nil
	end
	local ok, keys = pcall(DataService.FieldableKeys, player)
	if ok and type(keys) == "table" then
		return #keys
	end
	return nil
end

-- the "team" step: the team holds the player's pets, up to the three slots the text promises (one pet is enough
-- for a player who owns one)
local function teamFilled(player)
	local size = activeTeamSize(player)
	if size <= 0 then
		return false
	end
	local owned = fieldablePets(player) or size
	return size >= math.min(3, owned)
end

local function battleRecord(player)
	if not hasFunction(DataService, "GetBattle") then
		return nil
	end
	local ok, record = pcall(DataService.GetBattle, player)
	if ok and type(record) == "table" then
		return record
	end
	return nil
end

-- true when Dungeon floor 1 is behind the player: the saved Dungeon record (Best >= 1 or Cleared[1]), or a legacy
-- Phase 4 Trial 1 clear (Battle.TrialCleared[1] / TrialBest >= 1; P5Dungeon maps Trials 1-2 to no floor, but a
-- veteran who beat a Trial knows the fights and skips the tutorial floor)
local function dungeonOneCleared(player)
	if hasFunction(DataService, "GetDungeon") then
		local ok, record = pcall(DataService.GetDungeon, player)
		if ok and type(record) == "table" then
			if (tonumber(record.Best) or 0) >= 1 then
				return true
			end
			local cleared = record.Cleared
			if type(cleared) == "table" and (cleared[1] == true or cleared["1"] == true) then
				return true
			end
		end
	end
	local record = battleRecord(player)
	if not record then
		return false
	end
	if type(record.TrialCleared) == "table" and (record.TrialCleared[1] == true or record.TrialCleared["1"] == true) then
		return true
	end
	return (tonumber(record.TrialBest) or 0) >= 1
end

-- true while the player is inside a Dungeon run (DungeonService.GetRun)
local function inDungeonRun(player)
	if not hasFunction(DungeonService, "GetRun") then
		return false
	end
	local ok, run = pcall(DungeonService.GetRun, player)
	return ok and run ~= nil and run ~= false
end

-- the Dungeon gate's pad (DungeonInfo.Pad, else its prompt part / portal model), or nil
local function dungeonPadPosition()
	local info = type(dungeonInfo) == "table" and dungeonInfo or nil
	if not info then
		return nil
	end
	return positionOfInfo(info.Pad) or positionOfInfo(info.PromptPart) or positionOfInfo(info.Portal)
end

local function raidStatus()
	if not hasFunction(BattleService, "GetRaidStatus") then
		return nil
	end
	local ok, status = pcall(BattleService.GetRaidStatus)
	if ok and type(status) == "table" then
		return status
	end
	return nil
end

-- the raid step's hint: a running raid, or the minutes to the next one (minute steps: the state is re-sent rarely)
local function raidHint(step)
	local status = raidStatus()
	if status then
		return "A Boss Raid is on! Go to the colosseum"
	end
	if hasFunction(EventService, "SecondsUntil") then
		local ok, seconds = pcall(EventService.SecondsUntil, "BossRaid")
		if ok and type(seconds) == "number" and seconds >= 0 and seconds < math.huge then
			local minutes = math.max(1, math.ceil(seconds / 60))
			if minutes <= 1 then
				return "Next Boss Raid in under a minute!"
			end
			return "Next Boss Raid in " .. minutes .. " min"
		end
	end
	return step.Hint
end

-- { Kind = "Spot", Position, Label } for an Arena target (the client draws world arrows for Spot targets), or nil
local function arenaTarget(player, target)
	if inBattle(player) or inDungeonRun(player) then
		return nil
	end
	local position = nil
	if target.Place == "Dungeon" then
		-- Phase 5: the Dungeon gate in the Gate Court (no ArenaInfo needed)
		position = dungeonPadPosition()
		if typeof(position) ~= "Vector3" then
			return nil
		end
		return { Kind = "Spot", Position = position, Label = target.Label or "Dungeon portal", Arena = "Dungeon" }
	end
	local info = getArenaInfo()
	if not info then
		return nil
	end
	if target.Place == "Floor" then
		position = positionOfInfo(info.Floor) or positionOfInfo(info.Center)
	elseif target.Place == "Ring" then
		position = positionOfInfo(info.RingPortal) or positionOfInfo(info.RingSite)
	else
		-- "Gate": the Arena gate of the Gate Court (Phase 5), else the arrival forum
		position = positionOfInfo(info.ArenaPortal) or positionOfInfo(info.Spawn) or positionOfInfo(info.Center)
	end
	if typeof(position) ~= "Vector3" then
		return nil
	end
	return { Kind = "Spot", Position = position, Label = target.Label or "Battle Arena", Arena = target.Place or "Gate" }
end

-- The target (sent to the client) and the hint of the current step.
local function resolveStep(player, track, step)
	local target = step.Target
	local hint = step.Hint
	if step.CompleteOn == "RaidSeen" then
		hint = raidHint(step)
	end
	if not target then
		return nil, hint
	end
	if target.Kind == "Arena" then
		if target.Place == "Ring" and TycoonService ~= nil and getSpot(player) == nil and not inBattle(player) then
			-- the Champion Ring needs a claimed home: the gate of a free one first
			local okGate, gate = pcall(gateTarget, player, track)
			return okGate and gate or nil, "Claim a home first"
		end
		local ok, out = pcall(arenaTarget, player, target)
		return ok and out or nil, hint
	end
	if target.Kind == "Spot" and (target.Gate or target.Pad or target.Station or target.Food or target.GardenSpot or target.Coins) then
		local ok, out, hint = pcall(homeTarget, player, track, step)
		if not ok then
			return nil, step.Hint
		end
		if out and out.Kind == "Spot" and typeof(out.Position) ~= "Vector3" then
			out.Position = nil
		end
		return out, hint
	end
	local out = { Kind = target.Kind, Id = target.Id, Label = target.Label }
	if out.Kind == "Shop" and out.Id == nil then
		out.Id = firstRouletteId()
	end
	if out.Kind == "Spot" then
		local index = player:GetAttribute(Config.Attr.SpotIndex)
		if type(index) == "number" then
			out.SpotIndex = index
		end
	end
	local ok, position = pcall(lobbyPosition, player, out)
	if ok and typeof(position) == "Vector3" then
		out.Position = position
	end
	return out, step.Hint
end

local function targetSignature(target, hint)
	if not target then
		return "none|" .. tostring(hint)
	end
	local p = typeof(target.Position) == "Vector3" and target.Position or nil
	return table.concat({
		tostring(target.Kind),
		tostring(target.Id),
		tostring(target.SpotIndex),
		tostring(target.Label),
		tostring(target.Arena),
		p and string.format("%.0f,%.0f,%.0f", p.X, p.Y, p.Z) or "-",
		tostring(hint),
	}, "|")
end

local function currentStep(track)
	if not track or track.Done then
		return nil
	end
	return steps[track.Step]
end

----------------------------------------------------------------------
-- State payload + persistence
----------------------------------------------------------------------

local function buildPayload(player, track)
	local total = #steps
	local index = math.max(1, math.min(track.Step, total))
	local step = steps[index]
	local target, hint = nil, step.Hint
	if not track.Done then
		target, hint = resolveStep(player, track, step)
		track.TargetSig = targetSignature(target, hint)
	end
	return {
		Step = index,
		Total = total,
		Id = step.Id,
		Title = step.Title,
		Text = formatText(step.Text),
		Target = target,
		CompleteOn = step.CompleteOn,
		Hint = hint,
		Button = step.Button,
		Gift = step.Gift,
		Chapter = step.Chapter,
		Done = track.Done == true,
		Completed = track.Completed == true,
		Skipped = track.Skipped == true,
		Reward = track.Reward or 0,
	}
end

local function sendState(player, track)
	if not isLivePlayer(player) or not track or #steps == 0 then
		return
	end
	fireClient("TutorialState", player, buildPayload(player, track))
end

-- Writes the progress to the profile. Returns true when stored.
local function persist(player, track)
	if not hasFunction(DataService, "SetTutorial") then
		return false
	end
	local ok, stored = pcall(DataService.SetTutorial, player, {
		Step = track.Step,
		Done = track.Done == true or track.BaseDone == true,
		Gifted = track.Gifted == true,
	})
	return ok and stored == true
end

local function addTokens(player, amount)
	if amount <= 0 or not hasFunction(DataService, "AddTokens") then
		return false
	end
	local ok, err = pcall(DataService.AddTokens, player, amount)
	if not ok then
		warn("[TutorialService] AddTokens failed: " .. tostring(err))
	end
	return ok
end

local function addCash(player, amount)
	if amount <= 0 or not hasFunction(DataService, "AddCash") then
		return false
	end
	local ok, result = pcall(DataService.AddCash, player, amount)
	if not ok then
		warn("[TutorialService] AddCash failed: " .. tostring(result))
		return false
	end
	return result ~= false
end

-- Phase 5: the feed step needs berries (PetCareService.Feed: "a feed needs 40"). Tops the player's berries up to
-- FEED_BERRIES (DataService.AddBerries of the difference) and returns the berries added (0 when they have enough).
-- Server-decided and bounded: it only fills a gap below FEED_BERRIES, and the step it serves ends on the first feed.
local function topUpBerries(player)
	if not hasFunction(DataService, "GetBerries") or not hasFunction(DataService, "AddBerries") then
		return 0
	end
	local okGet, have = pcall(DataService.GetBerries, player)
	have = okGet and tonumber(have) or nil
	if not have or have ~= have or have >= FEED_BERRIES then
		return 0
	end
	local amount = FEED_BERRIES - math.max(0, math.floor(have))
	local ok, added = pcall(DataService.AddBerries, player, amount)
	if not ok or added == false then
		return 0
	end
	notify(player, "Nimbus filled your Berry Basket: " .. commas(amount) .. " berries for your first feed!", "good", 5)
	return amount
end

-- Pays the reward of a finished chapter (the progress is already stored). Returns the tokens paid (for the payload).
local function payChapter(player, track, chapter)
	if track.Replay then
		return 0
	end
	if chapter <= 1 then
		local amount = finishTokens()
		if amount > 0 and addTokens(player, amount) then
			notify(player, "Basics complete! +" .. amount .. " " .. TOKEN_GLYPH .. " from Nimbus", "good", 6)
			return amount
		end
		return 0
	end
	if chapter >= 4 then
		if RING_FINISH_TOKENS > 0 and addTokens(player, RING_FINISH_TOKENS) then
			notify(player, "Pets tutorial complete! +" .. commas(RING_FINISH_TOKENS) .. " Tokens", "good", 6)
			return RING_FINISH_TOKENS
		end
		return 0
	end
	if chapter >= 3 then
		if ARENA_FINISH_TOKENS > 0 and addTokens(player, ARENA_FINISH_TOKENS) then
			notify(player, "Battle tutorial complete! +" .. commas(ARENA_FINISH_TOKENS) .. " " .. TOKEN_GLYPH .. " from Nimbus", "good", 6)
			return ARENA_FINISH_TOKENS
		end
		return 0
	end
	if HOME_FINISH_CASH > 0 and addCash(player, HOME_FINISH_CASH) then
		notify(player, "Home tutorial complete! +" .. money(HOME_FINISH_CASH) .. " Cash from Nimbus", "good", 6)
	end
	return 0
end

----------------------------------------------------------------------
-- Step flow
----------------------------------------------------------------------

-- Called whenever a player arrives on a step (also on load): baselines + the one-time gift.
-- Returns true when it already stored the progress (the gift step does).
local function enterStep(player, track)
	local step = currentStep(track)
	if not step then
		return false
	end
	track.SpinsBase = spinsOf(player)
	track.LastEquipped = equippedCsv(player)
	track.NoSpotTime = 0
	track.NoFreeTime = 0
	track.TargetSig = nil
	track.DungeonWon = false
	track.DungeonPanel = false
	track.RaidSeen = false
	track.CoinsScooped = false
	track.TrainingStarted = false
	track.RingWon = false
	track.PortalUsed = false
	if step.CompleteOn == "Fed" then
		topUpBerries(player)
	end
	if step.Gift and not track.Gifted then
		local amount = giftTokens()
		track.Gifted = true
		-- Gifted is stored BEFORE the tokens are paid: a crash in between can never pay twice
		if persist(player, track) then
			if amount > 0 and addTokens(player, amount) then
				notify(player, "Nimbus gave you " .. amount .. " " .. TOKEN_GLYPH .. " Cloud Tokens!", "token", 5)
			end
			return true
		end
		track.Gifted = false -- not stored: try again on the next load
	end
	return false
end

local function finish(player, track, skipped)
	if track.Done then
		return
	end
	local chapter = chapterOf(math.min(track.Step, #steps))
	track.Done = true
	track.BaseDone = true
	if skipped then
		track.Skipped = true
		track.Step = SKIPPED_STEP -- no later chapter either
	else
		track.Completed = true
		track.Step = #steps + 1 -- one past the end: a chapter appended later starts from here
	end
	local stored = persist(player, track)
	if not skipped and stored then
		track.Reward = payChapter(player, track, chapter)
	elseif skipped then
		notify(player, "Tutorial skipped. Nimbus is cheering for you!", "info", 4)
	end
	sendState(player, track)
	TutorialService.Finished:Fire(player, skipped == true)
end

-- Completes the current step and moves on (the last step finishes the tutorial).
local function advance(player, track)
	local step = currentStep(track)
	if not step then
		return
	end
	local index = track.Step
	TutorialService.StepCompleted:Fire(player, step.Id, index)
	if index >= #steps then
		finish(player, track, false)
		return
	end
	local chapterDone = step.ChapterEnd == true or chapterOf(index + 1) ~= step.Chapter
	track.Step = index + 1
	if chapterDone then
		track.BaseDone = true -- the stored Done flips with the first chapter and sticks
	end
	local stored = enterStep(player, track)
	if not stored then
		stored = persist(player, track)
	end
	if chapterDone and step.ChapterEnd == true and stored then
		payChapter(player, track, step.Chapter)
	end
	sendState(player, track)
end

local function homeReady()
	return TycoonService ~= nil and TycoonCatalog ~= nil and hasFunction(DataService, "GetHome")
end

-- True when a step cannot be done in this server (a service is missing) and should be passed.
local function impossible(player, track, step)
	local kind = step.CompleteOn
	if kind == "Rolled" or kind == "Equipped" then
		return PetService == nil
	elseif kind == "NearSpot" then
		return not hasFunction(SpotService, "GetSpot") or (track.NoSpotTime or 0) >= NO_SPOT_GRACE
	elseif kind == "MatchStarted" or kind == "MatchEnded" then
		return MatchService == nil
	elseif kind == "Claimed" then
		return TycoonService == nil or not hasFunction(SpotService, "GetSpot") or (track.NoFreeTime or 0) >= NO_FREE_GRACE
	elseif kind == "Built" then
		return not homeReady() or stationDef(step.Station) == nil
	elseif kind == "Collected" then
		return true -- retired with the Collector (Phase 4): nothing can complete it any more
	elseif kind == "GardenPlaced" or kind == "CoinsScooped" then
		return not homeReady() or not hasFunction(TycoonService, "GardenSet")
	elseif kind == "TrainingStarted" then
		return not hasFunction(PetCareService, "Train")
	elseif kind == "RingWon" then
		return not hasFunction(BattleService, "StartRing")
	elseif kind == "PortalUsed" then
		return not hasFunction(TycoonService, "OpenHomePortal")
	elseif kind == "Fed" then
		return not hasSignal(PetCareService, "Fed")
	elseif kind == "ArenaReached" then
		return not arenaKnown()
	elseif kind == "TeamSet" then
		return not hasFunction(DataService, "ActiveTeamKeys")
	elseif kind == "DungeonWon" then
		return not hasFunction(DungeonService, "StartSolo")
	elseif kind == "RaidSeen" then
		return BattleService == nil or not (hasFunction(BattleService, "GetRaidStatus") or hasSignal(BattleService, "BattleEnded"))
	end
	return false
end

local function nearSpot(player)
	local spot = getSpot(player)
	local root = rootOf(player)
	if not spot or not root or typeof(spot.Center) ~= "Vector3" then
		return false
	end
	local offset = root.Position - spot.Center
	local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
	return flat <= NEAR_SPOT_RADIUS and math.abs(offset.Y) <= NEAR_SPOT_HEIGHT
end

-- Level-based completion checks (state the server can see right now).
local function satisfied(player, track, step)
	local kind = step.CompleteOn
	if kind == "MatchStarted" then
		return inMatch(player)
	elseif kind == "MatchEnded" then
		return not inMatch(player)
	elseif kind == "NearSpot" then
		return not inMatch(player) and nearSpot(player)
	elseif kind == "Rolled" then
		return spinsOf(player) > (track.SpinsBase or math.huge)
	elseif kind == "Claimed" then
		return getSpot(player) ~= nil
	elseif kind == "Built" then
		return step.Station ~= nil and stationLevel(getHome(player), step.Station) >= 1
	elseif kind == "GardenPlaced" then
		return Garden.placed(player)
	elseif kind == "CoinsScooped" then
		-- a mid-chapter veteran whose home already has the Food Machine knows the coins
		return track.CoinsScooped == true or stationLevel(getHome(player), "Kitchen") >= 1
	elseif kind == "TrainingStarted" then
		return track.TrainingStarted == true or hasTrained(player)
	elseif kind == "RingWon" then
		return track.RingWon == true or ringBest(player) >= 1
	elseif kind == "PortalUsed" then
		return track.PortalUsed == true
	elseif kind == "ArenaReached" then
		return not inMatch(player) and inArena(player)
	elseif kind == "TeamSet" then
		return teamFilled(player)
	elseif kind == "DungeonWon" then
		return track.DungeonWon == true or dungeonOneCleared(player)
	elseif kind == "RaidSeen" then
		if track.RaidSeen == true then
			return true
		end
		local record = battleRecord(player)
		if record and (tonumber(record.Raids) or 0) >= 1 then
			return true
		end
		return raidStatus() ~= nil and inArena(player)
	end
	return false
end

-- Advances through every step that is already complete (bounded by the step count).
local function settle(player, track)
	for _ = 1, #steps + 1 do
		local step = currentStep(track)
		if not step or not isLivePlayer(player) then
			return
		end
		if not (satisfied(player, track, step) or impossible(player, track, step)) then
			return
		end
		advance(player, track)
	end
end

-- Equip changes: complete "Equipped" when the list changed to a non-empty one.
local function onEquipChanged(player)
	local track = tracks[player]
	if not track or track.Done then
		return
	end
	local csv = equippedCsv(player)
	if csv == track.LastEquipped then
		return
	end
	track.LastEquipped = csv
	local step = currentStep(track)
	if step and step.CompleteOn == "Equipped" and csv ~= "" then
		advance(player, track)
		settle(player, track)
	end
end

-- Re-sends the state when a home step's target or hint changed (a pad got built, food arrived, a plot was taken).
local function refreshTarget(player, track)
	local step = currentStep(track)
	local t = step and step.Target
	local dynamic = step ~= nil and (step.CompleteOn == "RaidSeen" or (t ~= nil and t.Kind == "Arena"))
	if not dynamic and (not t or not (t.Gate or t.Pad or t.Station or t.Food or t.GardenSpot or t.Coins)) then
		return
	end
	local ok, target, hint = pcall(resolveStep, player, track, step)
	if not ok then
		return
	end
	if targetSignature(target, hint) ~= track.TargetSig then
		sendState(player, track)
	end
end

----------------------------------------------------------------------
-- Players
----------------------------------------------------------------------

local function newTrack(stored)
	local step = math.max(1, math.floor(tonumber(stored.Step) or 1))
	local track = {
		Step = step,
		Done = false,
		BaseDone = stored.Done == true,
		Gifted = stored.Gifted == true,
		Completed = false,
		Skipped = false,
		Reward = 0,
		NoSpotTime = 0,
		NoFreeTime = 0,
	}
	if not track.BaseDone then
		if track.Step > #steps then
			track.Step = #steps -- steps were removed since: land on the last one
		end
	elseif not resumable(track.Step) then
		track.Done = true -- finished (or skipped): nothing left to show
	end
	return track
end

-- Creates the player's track from the stored progress. Returns true once loaded.
local function loadPlayer(player)
	if tracks[player] then
		return true
	end
	if #steps == 0 or not isLivePlayer(player) or not hasFunction(DataService, "GetTutorial") then
		return false
	end
	local ok, stored = pcall(DataService.GetTutorial, player)
	if not ok or type(stored) ~= "table" then
		return false -- profile not loaded yet
	end
	local track = newTrack(stored)
	tracks[player] = track
	if not track.Done then
		enterStep(player, track)
	end
	sendState(player, track)
	settle(player, track)
	return true
end

-- Drops the running tutorial and reads it again from the profile (used by the developer tools after they rewind
-- the stored tutorial). opts.Replay = true marks a replay of a tutorial that was already finished once: its chapter
-- rewards are not paid again. Returns true when the player's tutorial is running again.
local function reloadPlayer(player, opts)
	if not isLivePlayer(player) then
		return false
	end
	tracks[player] = nil
	local ok = loadPlayer(player)
	local track = tracks[player]
	if track and type(opts) == "table" and opts.Replay == true then
		track.Replay = true
	end
	return ok == true
end

-- The stored profile changed under us (recovered load / another server): merge forward, never back.
local function onProfileRebased(player)
	local track = tracks[player]
	if not track then
		loadPlayer(player)
		return
	end
	if not hasFunction(DataService, "GetTutorial") then
		return
	end
	local ok, stored = pcall(DataService.GetTutorial, player)
	if not ok or type(stored) ~= "table" then
		return
	end
	local fresh = newTrack(stored)
	local changed = false
	if fresh.Gifted and not track.Gifted then
		track.Gifted = true
	end
	if fresh.BaseDone and not track.BaseDone then
		track.BaseDone = true
	end
	if not track.Done then
		if fresh.Done then
			-- finished or skipped elsewhere: it ends here too
			track.Done = true
			track.Step = fresh.Step
			changed = true
		elseif fresh.Step > track.Step then
			track.Step = math.min(fresh.Step, #steps)
			enterStep(player, track)
			changed = true
		end
	end
	if changed then
		sendState(player, track)
		settle(player, track)
	end
end

local function disconnectPlayer(player)
	local conns = playerConns[player]
	if conns then
		for _, conn in ipairs(conns) do
			pcall(function()
				conn:Disconnect()
			end)
		end
	end
	playerConns[player] = nil
end

local function onPlayerAdded(player)
	if playerConns[player] then
		return
	end
	local conns = {}
	playerConns[player] = conns
	table.insert(conns, player:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
		local track = tracks[player]
		if track then
			settle(player, track)
		end
	end))
	table.insert(conns, player:GetAttributeChangedSignal(Config.Attr.EquippedPets):Connect(function()
		onEquipChanged(player)
	end))
	-- a claimed plot: complete "Claimed" at once and point the home steps at the new plot
	table.insert(conns, player:GetAttributeChangedSignal(Config.Attr.SpotIndex):Connect(function()
		local track = tracks[player]
		local step = currentStep(track)
		if step then
			track.NoSpotTime = 0
			settle(player, track)
			track = tracks[player]
			if track and currentStep(track) then
				refreshTarget(player, track)
			end
		end
	end))
	task.spawn(loadPlayer, player)
end

local function onPlayerRemoving(player)
	disconnectPlayer(player)
	tracks[player] = nil
	lastEvent[player] = nil
	lastSync[player] = nil
end

----------------------------------------------------------------------
-- Client events
----------------------------------------------------------------------

function TutorialService.HandleEvent(player, eventName)
	if not isLivePlayer(player) then
		return false, "Player unavailable"
	end
	if type(eventName) ~= "string" or #eventName > MAX_EVENT_LENGTH then
		return false, "Bad event"
	end
	local track = tracks[player]
	if not track then
		if not loadPlayer(player) then
			return false, "Not loaded"
		end
		track = tracks[player]
	end
	if eventName == "Sync" then
		sendState(player, track)
		return true
	end
	if track.Done then
		return false, "Tutorial already finished"
	end
	if eventName == "Skip" then
		finish(player, track, true)
		return true
	end
	local completes = EVENT_COMPLETES[eventName]
	if not completes then
		return false, "Unknown event"
	end
	local step = currentStep(track)
	if not step or step.CompleteOn ~= completes then
		return false, "Not the current step"
	end
	if completes == "Equipped" and equippedCsv(player) == "" then
		return false, "Equip a pet first"
	end
	advance(player, track)
	settle(player, track)
	return true
end

local function onTutorialEvent(player, eventName)
	if type(eventName) ~= "string" or #eventName > MAX_EVENT_LENGTH then
		return
	end
	local now = os.clock()
	if eventName == "Sync" then
		local last = lastSync[player]
		if last and now - last < SYNC_COOLDOWN then
			return
		end
		lastSync[player] = now
	else
		local last = lastEvent[player]
		if last and now - last < EVENT_COOLDOWN then
			return
		end
		lastEvent[player] = now
	end
	local ok, err = pcall(TutorialService.HandleEvent, player, eventName)
	if not ok then
		warn("[TutorialService] event " .. eventName .. " failed: " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function TutorialService.Reload(player, opts)
	return reloadPlayer(player, opts)
end

function TutorialService.GetState(player)
	local track = player and tracks[player]
	if not track or #steps == 0 then
		return nil
	end
	return buildPayload(player, track)
end

-- Stops the poll loop (tests / shutdown). Tracks stay readable.
function TutorialService.Stop()
	running = false
end

----------------------------------------------------------------------
-- Poll loop (2 Hz): level checks, grace timers, home targets, profiles that loaded without a signal
----------------------------------------------------------------------

-- Phase 5: a player on the Dungeon step who stands on the Dungeon gate's pad gets the Dungeon window opened on floor 1
-- (OpenPanel("Dungeon", { Floor = 1 })), once per step entry; never in a fight or a run.
local function dungeonDoorstep(player, track)
	local step = currentStep(track)
	if not step or step.CompleteOn ~= "DungeonWon" or track.DungeonPanel then
		return false
	end
	local pad = dungeonPadPosition()
	local root = rootOf(player)
	if not pad or not root or inBattle(player) or inDungeonRun(player) then
		return false
	end
	local offset = root.Position - pad
	if Vector3.new(offset.X, 0, offset.Z).Magnitude > DUNGEON_PAD_RADIUS or math.abs(offset.Y) > NEAR_SPOT_HEIGHT then
		return false
	end
	track.DungeonPanel = true
	fireClient("OpenPanel", player, "Dungeon", { Floor = 1 })
	return true
end

local function pollPlayer(player, dt)
	local track = tracks[player]
	if not track then
		loadPlayer(player)
		return
	end
	local step = currentStep(track)
	if not step then
		return
	end
	if step.CompleteOn == "NearSpot" then
		if getSpot(player) then
			track.NoSpotTime = 0
		elseif not inMatch(player) then
			track.NoSpotTime = (track.NoSpotTime or 0) + dt
		end
	elseif step.CompleteOn == "Claimed" then
		if track.NoFree and not getSpot(player) and not inMatch(player) then
			track.NoFreeTime = (track.NoFreeTime or 0) + dt
		else
			track.NoFreeTime = 0
		end
	end
	settle(player, track)
	track = tracks[player]
	if track and currentStep(track) and not inMatch(player) then
		refreshTarget(player, track)
		dungeonDoorstep(player, track)
	end
end

local function pollLoop()
	local last = os.clock()
	while running do
		task.wait(POLL_INTERVAL)
		if not running then
			break
		end
		local now = os.clock()
		local dt = math.min(now - last, 2)
		last = now
		for _, player in ipairs(Players:GetPlayers()) do
			local ok, err = pcall(pollPlayer, player, dt)
			if not ok then
				warn("[TutorialService] poll failed: " .. tostring(err))
			end
		end
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

-- settles the current step of `player` (a signal said something changed)
local function nudge(player)
	local track = typeof(player) == "Instance" and tracks[player] or nil
	if track and not track.Done then
		settle(player, track)
		track = tracks[player]
		if track and currentStep(track) then
			refreshTarget(player, track)
		end
	end
end

function TutorialService.Init(lobbyInfo, deps)
	if initialized then
		return
	end
	initialized = true
	deps = type(deps) == "table" and deps or {}
	lobby = type(lobbyInfo) == "table" and lobbyInfo or nil
	local services = script.Parent
	DataService = deps.DataService or loadModule(services, "DataService")
	PetService = deps.PetService or loadModule(services, "PetService")
	MatchService = deps.MatchService or loadModule(services, "MatchService")
	SpotService = deps.SpotService or loadModule(services, "SpotService")
	-- Phase 2 (Main initialises these after this service: only their signals are used before then)
	TycoonService = deps.TycoonService or loadModule(services, "TycoonService")
	PetCareService = deps.PetCareService or loadModule(services, "PetCareService")
	HomeBuilder = loadModule(services, "HomeBuilder")
	TycoonCatalog = loadModule(Shared, "TycoonCatalog")
	PetKeys = loadModule(Shared, "PetKeys")
	-- Phase 3 (the pet-battle chapter)
	BattleService = deps.BattleService or loadModule(services, "BattleService")
	arenaInfo = type(deps.ArenaInfo) == "table" and deps.ArenaInfo or nil
	ArenaBuilder = loadModule(services, "ArenaBuilder")
	EventService = deps.EventService or loadModule(services, "EventService")
	BattleCatalog = loadModule(Shared, "BattleCatalog")
	-- Phase 5 (the Dungeon step; Main passes DungeonBuilder.Build's info and the module table, its Init runs later)
	DungeonService = deps.DungeonService or loadModule(services, "DungeonService")
	dungeonInfo = type(deps.DungeonInfo) == "table" and deps.DungeonInfo or nil

	buildSteps()
	if #steps == 0 then
		warn("[TutorialService] no tutorial steps (shared/TutorialSteps missing?): tutorial disabled")
		return
	end
	if not DataService then
		warn("[TutorialService] DataService unavailable: tutorial disabled")
		return
	end

	-- remote: client-observed events
	local okRemote, remote = pcall(Remotes.Get, "TutorialEvent")
	if okRemote and remote then
		remote.OnServerEvent:Connect(onTutorialEvent)
	else
		warn("[TutorialService] TutorialEvent remote missing: " .. tostring(remote))
	end

	-- profile lifecycle
	if hasSignal(DataService, "ProfileLoaded") then
		DataService.ProfileLoaded:Connect(function(player)
			loadPlayer(player)
		end)
	end
	if hasSignal(DataService, "ProfileRebased") then
		DataService.ProfileRebased:Connect(function(player)
			onProfileRebased(player)
		end)
	end

	-- pets
	if hasSignal(PetService, "Rolled") then
		PetService.Rolled:Connect(function(player)
			local track = tracks[player]
			local step = currentStep(track)
			if step and step.CompleteOn == "Rolled" then
				advance(player, track)
				settle(player, track)
			end
		end)
	end
	if hasSignal(PetService, "PerksChanged") then
		PetService.PerksChanged:Connect(function(player)
			onEquipChanged(player)
		end)
	end

	-- the home chapter
	if hasSignal(TycoonService, "Claimed") then
		TycoonService.Claimed:Connect(function(player)
			nudge(player)
		end)
	end
	if hasSignal(TycoonService, "HomeChanged") then
		TycoonService.HomeChanged:Connect(function(player)
			nudge(player)
		end)
	end
	if hasSignal(TycoonService, "Released") then
		TycoonService.Released:Connect(function(player)
			nudge(player)
		end)
	end
	if hasSignal(PetCareService, "Fed") then
		PetCareService.Fed:Connect(function(player)
			local track = typeof(player) == "Instance" and tracks[player] or nil
			local step = currentStep(track)
			if step and step.CompleteOn == "Fed" then
				advance(player, track)
				settle(player, track)
			end
		end)
	end
	-- Phase 4: the server signals of the new steps (each marks only the step that waits for it)
	local function markOn(module, signalName, mark)
		if hasSignal(module, signalName) then
			module[signalName]:Connect(function(player)
				local track = typeof(player) == "Instance" and tracks[player] or nil
				local step = currentStep(track)
				if step and step.CompleteOn == mark then
					track[mark] = true
					nudge(player)
				end
			end)
		end
	end
	markOn(TycoonService, "CoinsScooped", "CoinsScooped")
	markOn(TycoonService, "PortalUsed", "PortalUsed")
	markOn(PetCareService, "TrainingStarted", "TrainingStarted")

	-- the pet-battle chapter (signals exist at module load, so these connect even before those services Init)
	if hasSignal(DataService, "TeamsChanged") then
		DataService.TeamsChanged:Connect(function(player)
			nudge(player)
		end)
	end
	if hasSignal(BattleService, "BattleEnded") then
		BattleService.BattleEnded:Connect(function(_battleId, result)
			if type(result) ~= "table" then
				return
			end
			local mark = nil
			local list = nil
			if result.Mode == "Raid" then
				mark, list = "RaidSeen", result.Participants or result.Winners
			elseif result.Mode == "Ring" and result.Won == true then
				mark, list = "RingWon", result.Winners
			end
			if not mark or type(list) ~= "table" then
				return
			end
			for _, userId in ipairs(list) do
				local player = type(userId) == "number" and Players:GetPlayerByUserId(userId) or nil
				local track = player and tracks[player]
				local step = currentStep(track)
				if step and step.CompleteOn == mark then
					track[mark] = true
					nudge(player)
				end
			end
		end)
	end
	-- Phase 5: a cleared Dungeon floor (DungeonService fires it for every qualifying member, after the payments)
	if hasSignal(DungeonService, "FloorCleared") then
		DungeonService.FloorCleared:Connect(function(player, floor)
			local track = typeof(player) == "Instance" and tracks[player] or nil
			local step = currentStep(track)
			if step and step.CompleteOn == "DungeonWon" and type(floor) == "number" and floor >= 1 then
				track.DungeonWon = true
				nudge(player)
			end
		end)
	end
	if hasSignal(BattleService, "RaidJoined") then
		BattleService.RaidJoined:Connect(function(player)
			local track = typeof(player) == "Instance" and tracks[player] or nil
			local step = currentStep(track)
			if step and step.CompleteOn == "RaidSeen" then
				track.RaidSeen = true
				nudge(player)
			end
		end)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		onPlayerAdded(player)
	end

	running = true
	task.spawn(pollLoop)
end

return TutorialService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="862">
          <Properties>
            <string name="Name">TycoonService</string>
            <string name="Source"><![CDATA[-- TycoonService: the tycoon homes (ARCHITECTURE_V3.md "Phase 2: Tycoon homes" + "Phase 4: pets make the money", the
-- "Phase 4 build contract" sections 3.1-3.3, 3.10, 3.11, 5.1-5.4, 7, and the "Phase 5 build contract" 3.3-3.5, 10.2).
--
-- * Claiming: every free plot's gate carries a "Claim Home" ProximityPrompt named ClaimPrompt (HomeBuilder.PreparePlot
--   builds it; when HomeBuilder is missing or built none, this service puts a plain one on the gate). Pressing E
--   claims that plot for the session: one plot per player, refused during a match and while the save is still
--   loading. SpotService keeps the plot <-> player map (GetSpot answers the claimed plot). The SAVED progress is the
--   player's Home build (profile Home), not a plot number: it is rebuilt on whichever plot they claim. Leaving
--   releases the plot (the build is cleared, the gate reads "Claim Home" again). A claim also re-derives
--   Home.Level from the stations (TycoonCatalog.HomeLevelOf) when an older save disagrees. The gate's prompt must be
--   triggered from near the gate (its range + a little slack). The first claim of a migrated Phase 3 veteran shows
--   the one-time welcome toast (Migrations.P4Veteran -> P4Welcome, a union: never twice, also across servers).
-- * Buy pads: HomeBuilder.SetPads shows TycoonCatalog.AvailablePads(home) as pads `Pad_<StationId>` with a
--   ProximityPrompt `BuyPrompt` (attributes StationId, OwnerUserId). A purchase (pad or the Home window's "Upgrade")
--   is validated here: the player owns that plot, the station is in AvailablePads and not locked
--   (TycoonCatalog.CheckPurchase, whose price is the STAR price TycoonCatalog.PriceAt: x1.5 per Prestige star unless
--   Home.LegacyPrices), the price is paid with DataService.SpendCash and the level written with DataService.MutateHome
--   IN ONE NON-YIELDING STEP (the cash is refunded if the home write is refused). The station then appears
--   (HomeBuilder.SetStation; the client pops it in), the pads refresh and a side toast confirms it. The Prestige pad
--   (StationId "Prestige", prompt "Prestige") never resets anything by itself: E on it opens the Home window on its
--   prestige confirmation (OpenPanel("Home", { Action = "Prestige" })) and only HomeAction "Prestige" prestiges.
-- * Cloud Cash (the ONLY money source; Phase 5 contract 3.5): every open garden place (slot <= TycoonCatalog.GardenSlots)
--   with an owned, non-training pet roams the yard on the shared deterministic plan (shared/HomeRoam: seed = RoamSeed,
--   slot, cycle 24 s; epochs on workspace:GetServerTimeNow()) and poops once per cycle at HomeRoam.Plan(..).Poop a drop
--   worth TycoonCatalog.CoinValue(home, PetPower(pet), stars) x Coins.PoopMeals 3 (the pet's STORED evolution stage from
--   DataService.GetEvolution; Lucky x LuckyMult with LuckyChance). A NEW key in a slot gets Epoch = now + SettleSeconds 20
--   (first poop >= 24 s later; Y8 churn-proof: the same key back within one cycle keeps its epoch), a fresh ledger
--   staggers Epoch = now + Rng x 24. At most 2 catch-up poops per slot per tick. A slot whose lawn value reached
--   PileSeconds(home) x its coin rate naps (Roam ":N<cycle>", no poop) until a scoop below the cap wakes it (Epoch =
--   now + the back walk). A slot keeps DropsPerPet 3 drops, a further poop merges into its nearest drop. Keys above
--   the open count (LegacySlots ended) rest: no epoch, no poop. No pet in the garden = no coins. Every poop also grows
--   value x Berries.Share berries into Profile.Berries (DataService.AddBerries, whole; the fraction stays in the
--   ledger), clamped so a poop never lifts Berries above TycoonCatalog.BasketCap(home, income) ("Basket full! Feed
--   your pets" once); a cap below the berries removes none. Offline coins add offline x Share berries, cap ignored.
-- * The coin ledger (X4, exactly once): Home.CollectorCash IS the bank (persisted, delta-merged): the 1 s tick adds
--   every new poop to it in one MutateHome (+ AddBerries in the same step). The drops are SESSION memory
--   (Coins.state[player]: per slot a list of { Cycle, Value, Lucky, Poops, X, Z } + the Welcome-back pile) rebuilt
--   from the bank as the Welcome-back pile on load, claim and ProfileRebased, and always reconciled so that
--   sum(drops) + welcome == CollectorCash. Scooping: a 0.25 s loop reads the OWNER's HumanoidRootPart; every drop
--   within ScoopRadius(home) horizontally and SCOOP_HEIGHT vertically is paid: MutateHome(CollectorCash - take) then
--   DataService.AddCash(take) in one non-yielding step, clamped to the bank, refunded when AddCash fails; whole Cash
--   only, the fraction stays on the lawn as an unlisted drop. No pickup remote (X1 / Y7): HomeAction "Collect" /
--   Collect(player) = "scoop every drop in range" for old clients and tests. Only the plot's owner is ever checked (X2).
--   Offline coins (the Vault's OfflineEarnings on IncomePerSecond) go INTO the bank in the same MutateHome that
--   writes LastSeen (X6; the "Welcome back! Your pets made $X ..." toast).
-- * GardenSet (any role): slot 1..GardenSlots(home), an owned free copy, not a training key (DataService.TrainingKeys),
--   not a key in the caller's running battle (BattleService.KeysInBattle when it exists); nil / "" clears any slot.
-- * House tiers (every 10 Home Levels: Villa 10, Manor 20, Sky Castle 30) and the station caps per tier come from
--   TycoonCatalog (lock reasons on the pads). Prestige (Home Level 40 + Sky Castle): TycoonCatalog.StationsAfterPrestige
--   (decor kept, the Garden back at its ResetLevel 1 so the coins never stop), the bank and the piles zeroed, Cash to 0,
--   +1 star (coins x1.25 each), +1 garden place ("Garden place N unlocked!"), the Gems reward; at 1 star the Fusion
--   Machine pad unlocks. DataService.MutateHome clears LegacySlots / LegacyPrices itself when Prestige rises.
-- * The home portal (3.10): HomeAction "GoHome" / OpenHomePortal(player): refused in an obby match, in a battle or ring
--   run (InBattle), while locked in a portal party (PortalLocked), while dead; cooldown 3 s; one portal per player
--   (pressing again keeps the open one). It opens 6 studs ahead on the ground (server raycasts: forward stops 1.5
--   studs before a wall, down finds the floor, no floor -> the character's own spot) for 10 s as the player attribute
--   HomePortal = "x,y,z,yaw,closesAt". A 0.2 s loop checks ONLY the owner's root against open portals and teleports
--   them with SpotService.Teleport (home SpawnCFrame; without a home the suggested free gate + "Press E at the gate to
--   claim this home!"), writes PortalArrived = server time and fires PortalUsed. Zero server parts (HomePortalFx draws).
-- * Safe zones (3.11): nothing here starts damage or a fight; every teleport refuses InBattle.
-- * Remote HomeAction(action, arg): "Upgrade" stationId, "GardenSet" {slot, key|nil} (also {Slot =, Key =}),
--   "Collect", "Prestige", "GoHome". Types, ranges and NaN are checked; every action is rate limited (a per-action
--   cooldown plus a per-player burst budget); refusals answer with a side toast (repeated texts are throttled).
-- * Replication (5.3 / Phase 5 10.2): the plot folder (SpotInfo.Folder) carries attributes for the clients, written
--   only on change: HomeLevel, Prestige, CollectorCash (the bank, whole), IncomePerSecond, GardenPets ("1=cat;3=fox@Golden",
--   every placed owned key incl. resting ones), GardenInfo ("1=12:0;3=20:1" level:stage per placed slot), GardenSlots (the
--   open place count), RoamSeed ((OwnerUserId % 2147483646) + 1), RoamVersion (HomeRoam.Version), Roam
--   ("1=1760001234.5;3=1760001240.0:N812": slot = epoch with one decimal, :N<cycle> while napping), CoinDrops
--   ("1=812:1,813:2*;3=40:1;W=5": slot = cycle:stage[* Lucky] per drop, stages by poops Coins.DropStages {1, 2, 4, 8},
--   W the Welcome-back pile; <= one write per 2 s, <= 400 B), BerryCap (whole, <= 1 / s). The player attribute Berries
--   is DataService's alone. CoinPiles is gone. HomeBuilder.SetGarden(info, valid, open) gets the placed keys and the open
--   count. Nothing here moves parts (HomeFx poses the pets and the coins on the client from the same plan).
-- * Old station ids (Press2-4, Collector, DecorLamps / Flowers / Banners) from an old client answer "That station is now
--   part of the <Berry Farm | Pet Garden | Fountain | Yard Fence>" (3.3); the first claim after THIS session's P5Home
--   fold (DataService.MigratedNow(player, "P5Home").FirstTime) shows the one-time "Your home got simpler!" toast.
--
-- Public API (the contract, 5.4):
--   Init(lobbyInfo, deps)                deps = { DataService, PetService, SpotService, BattleService }
--   GetPlot(player) -> SpotInfo | nil    GetHome(player) -> home copy | nil
--   Buy(player, stationId) -> ok, newLevel | reason   (stations only: "Prestige" is refused, see the Prestige pad)
--   Collect(player) -> ok, amount | reason   scoops every pile in range of the owner
--   Prestige(player) -> ok, stars | reason
--   IncomePerSecond(player) -> cash/s, { Food, Pets, Lucky, Multiplier }
--   PileSeconds(player) -> seconds (+ CollectorCap alias), CoinsWaiting(player) -> whole Cash on the lawn
--   Drops(player) -> { { Slot, Cycle, Position, Value, Lucky, Poops, Stage } } (slot then cycle order; nil without a plot)
--   GardenSet(player, slot, key) -> ok, reason      OpenHomePortal(player) -> ok, reason   GoHome = OpenHomePortal
--   ClearCoins(player) (the developer reset: bank + piles to 0)
--   Signals HomeChanged(player), Claimed(player, spotInfo), Prestiged(player, stars), Released(player, spotInfo),
--           CoinsScooped(player, amount), PortalUsed(player)
-- Extras: Claim(player, index) -> ok, reason, Release(player), Piles(player) -> { [slot] = { Coins (= poops), Value, Lucky,
--   Full (= napping), Pos (the first drop) }, W = { Value, Pos } } (per-slot sums of the drops: tests, the tutorial arrow).
--
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local TycoonService = {}
TycoonService.HomeChanged = Util.Signal() -- Fire(player)
TycoonService.Claimed = Util.Signal() -- Fire(player, spotInfo)
TycoonService.Prestiged = Util.Signal() -- Fire(player, stars)
TycoonService.Released = Util.Signal() -- Fire(player, spotInfo)  (extra)
TycoonService.CoinsScooped = Util.Signal() -- Fire(player, amount)  Phase 4: whole Cash scooped from the lawn
TycoonService.PortalUsed = Util.Signal() -- Fire(player)  Phase 4: the owner went through their home portal

local TICK = 1 -- seconds between coin ticks
local MAX_TICK_DT = 5 -- a stalled server never pays more than this many seconds in one tick
local LASTSEEN_EVERY = 15 -- seconds between Home.LastSeen refreshes while online (offline pay starts after 120 s)
local PROFILE_WAIT = 90 -- seconds a joining player's home is waited for (then ProfileRebased takes over)
local CLAIM_COOLDOWN = 0.5
local BUY_COOLDOWN = 0.2
local COLLECT_COOLDOWN = 0.5
local GARDEN_COOLDOWN = 0.2
local PRESTIGE_COOLDOWN = 1
local COLLECT_TOAST_GAP = 3 -- seconds between "scooped" toasts of the explicit Collect action
local BURST_SIZE = 10 -- HomeAction / prompt requests a player may send at once...
local BURST_REFILL = 5 -- ...refilled at this many per second
local TOAST_GAP = 1.5 -- the same refusal text is not repeated within this many seconds
local OFFLINE_TOAST_DELAY = 3 -- the HUD / toasts are up a moment after the profile loaded
local MAX_ID_LENGTH = 48
local MAX_ACTION_LENGTH = 24
local MAX_SLOT = 64
local GATE_PROMPT_LIFT = 3.5 -- the fallback ClaimPrompt anchor above the gate's ground point
local CLAIM_DISTANCE = 12
local CLAIM_SLACK = 15 -- studs past the prompt's MaxActivationDistance a claimer may stand (latency, big avatars)
local ATTR_IN_BATTLE = Config.Attr.InBattle or "InBattle" -- BattleService's player attribute (battle id)

local initialized = false
local running = false
local dataService = nil
local petService = nil
local spotService = nil
local battleService = nil -- BattleService module table (its Init runs after ours: every call is guarded)
local homeBuilder = nil
local catalog = nil -- TycoonCatalog
local petKeys = nil -- PetKeys (optional)
local petCatalog = nil -- PetCatalog (optional)
local notifyRemote = nil
local openPanelRemote = nil -- OpenPanel (the Prestige pad opens the Home window on its confirmation)
local spotList = {} -- [index] = SpotInfo (from lobbyInfo.Spots)

local plots = {} -- [Player] = index
local plotOwner = {} -- [index] = Player (this service's own view; survives SpotService's release order)
local built = {} -- [index] = { [stationId] = level } what HomeBuilder shows right now
local padSig = {} -- [index] = signature of the last SetPads
local shown = {} -- [index] = { Cash, Income, Level, Prestige, Garden, Open, Piles, Info } last replicated values
local fallbackPrompts = {} -- [index] = ClaimPrompt this service created (no HomeBuilder prompt)
local lastTick = {} -- [Player] = os.clock() of the last coin tick
local lastSeenAt = {} -- [Player] = os.clock() of the last LastSeen write
local offlineDone = {} -- [Player] = true once the offline earnings were settled for this session
local watching = {} -- [Player] = true while a join waiter runs
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local budgets = {} -- [Player] = { Tokens, At }
local toastAt = {} -- [Player] = { [text] = os.clock() }
local departed = setmetatable({}, { __mode = "k" })
local hbWarned = {} -- [fnName] = count of warnings printed

-- Phase 4 helper tables (contract section 6: every new helper lives in Coins / Portal, not in a new local)
local Coins = {
	SCOOP_TICK = 0.25, -- seconds between owner proximity passes
	SCOOP_HEIGHT = 10, -- studs of vertical reach of a scoop
	MAX_POOPS_PER_TICK = 2, -- a stalled server catches up at most this many poops per slot per tick (3.5)
	DROPS_WRITE_GAP = 2, -- seconds between CoinDrops attribute writes (<= 0.5 / s per plot)
	state = {}, -- [Player] = the session ledger (see Coins.ensure)
}
local homeRoam = nil -- shared/HomeRoam (the deterministic roaming plans: poop times and points)
Coins.welcomedP5 = {} -- [Player] = true once the 'Your home got simpler!' toast was shown this session
-- old Phase 4 station ids an old client may still send: what they became (3.3 / FoldLegacy)
Coins.LEGACY_HOME = {
	Press2 = "Berry Farm", Press3 = "Berry Farm", Press4 = "Berry Farm", Collector = "Pet Garden",
	DecorLamps = "Fountain", DecorFlowers = "Yard Fence", DecorBanners = "Yard Fence",
}
local Portal = {
	TICK = 0.2, -- seconds between owner checks
	COOLDOWN = 3, -- contract 3.10 / X19: one portal request per 3 s
	ATTR_LOCKED = "PortalLocked", -- PortalService: locked on a portal pad for a party countdown
	AHEAD = 6, -- studs in front of the character
	WALL_GAP = 1.5, -- the portal stops this far before a wall
	OPEN_SECONDS = 10,
	ENTER_RADIUS = 3.5, -- horizontal studs from the portal point that count as "walked in"
	ENTER_HEIGHT = 5, -- vertical studs (the root stands ~3 studs over the floor)
	DROP = 24, -- studs the floor is searched for below a point
	open = {}, -- [Player] = { Pos = Vector3, Yaw, ClosesAt = os.clock() }
}

----------------------------------------------------------------------
-- Modules (other agents write some of them: every use is guarded)
----------------------------------------------------------------------

local function requireModule(container, name)
	local module = container and container:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[TycoonService] could not load " .. name .. ": " .. tostring(result))
	return nil
end

-- Calls HomeBuilder[fnName](...) under pcall. Missing functions are skipped quietly.
local function hb(fnName, ...)
	if not homeBuilder or type(homeBuilder[fnName]) ~= "function" then
		return nil
	end
	local ok, result = pcall(homeBuilder[fnName], ...)
	if not ok then
		local n = (hbWarned[fnName] or 0) + 1
		hbWarned[fnName] = n
		if n <= 3 then
			warn("[TycoonService] HomeBuilder." .. fnName .. " failed: " .. tostring(result))
		end
		return nil
	end
	return result
end

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------

local function isFinite(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge
end

local function notify(player, text, kind, seconds)
	if not player or not player.Parent or type(text) ~= "string" then
		return
	end
	if not notifyRemote then
		local ok, remote = pcall(Remotes.Get, "Notify")
		if ok then
			notifyRemote = remote
		end
	end
	if notifyRemote then
		pcall(function()
			notifyRemote:FireClient(player, text, kind or "info", seconds or 3)
		end)
	end
end

-- A refusal toast; the same text is not repeated within TOAST_GAP (spam clicks stay quiet).
local function toastOnce(player, text, kind)
	if type(text) ~= "string" or text == "" then
		return
	end
	local map = toastAt[player]
	if not map then
		map = {}
		toastAt[player] = map
	end
	local now = os.clock()
	local last = map[text]
	if last and now - last < TOAST_GAP then
		return
	end
	map[text] = now
	notify(player, text, kind or "bad", 3)
end

-- Per player per key cooldown.
local function cooldown(player, key, seconds)
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	local now = os.clock()
	local last = map[key]
	if last and now - last < seconds then
		return false
	end
	map[key] = now
	return true
end

-- Per player burst budget shared by every HomeAction / prompt request.
local function spend(player)
	local now = os.clock()
	local b = budgets[player]
	if not b then
		b = { Tokens = BURST_SIZE, At = now }
		budgets[player] = b
	end
	b.Tokens = math.min(BURST_SIZE, b.Tokens + (now - b.At) * BURST_REFILL)
	b.At = now
	if b.Tokens < 1 then
		return false
	end
	b.Tokens = b.Tokens - 1
	return true
end

local function money(n)
	if catalog and type(catalog.FormatCash) == "function" then
		local ok, text = pcall(catalog.FormatCash, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return "$" .. tostring(math.floor(tonumber(n) or 0))
end

-- 1.25 -> "1.25", 1.5625 -> "1.56", 2 -> "2"
local function multiplierText(mult)
	local text = string.format("%.2f", tonumber(mult) or 1)
	text = string.gsub(text, "0+$", "")
	text = string.gsub(text, "%.$", "")
	return text
end

local function isPlayer(player)
	return typeof(player) == "Instance" and player:IsA("Player") and player.Parent ~= nil and not departed[player]
end

local function getHome(player)
	if not dataService or type(dataService.GetHome) ~= "function" then
		return nil
	end
	local ok, home = pcall(dataService.GetHome, player)
	if ok and type(home) == "table" then
		return home
	end
	return nil
end

local function getProfile(player)
	if not dataService or type(dataService.GetProfile) ~= "function" then
		return nil
	end
	local ok, profile = pcall(dataService.GetProfile, player)
	if ok and type(profile) == "table" then
		return profile
	end
	return nil
end

local function mutateHome(player, fn)
	if not dataService or type(dataService.MutateHome) ~= "function" then
		return false
	end
	local ok, result = pcall(dataService.MutateHome, player, fn)
	return ok and result == true
end

local function getCash(player)
	if dataService and type(dataService.GetCash) == "function" then
		local ok, cash = pcall(dataService.GetCash, player)
		if ok and isFinite(cash) then
			return cash
		end
	end
	return 0
end

local function stationLevel(home, id)
	if catalog and type(catalog.StationLevel) == "function" then
		return catalog.StationLevel(home, id)
	end
	local v = type(home) == "table" and type(home.Stations) == "table" and home.Stations[id]
	return isFinite(v) and math.max(0, math.floor(v)) or 0
end

local function homeLevelOf(home)
	if catalog and type(catalog.HomeLevelOf) == "function" then
		return catalog.HomeLevelOf(home)
	end
	return 0
end

local function starsOf(home)
	local v = type(home) == "table" and home.Prestige
	if isFinite(v) and v > 0 then
		return math.floor(v)
	end
	return 0
end

local function stationName(id)
	local def = catalog and catalog.Get(id)
	return (def and def.Name) or tostring(id)
end

local function houseTierName(index)
	local tiers = catalog and catalog.HouseTiers
	local tier = type(tiers) == "table" and tiers[index]
	return (tier and tier.Name) or "house"
end

-- The bank: the Cash lying on the lawn (Home.CollectorCash), never negative or NaN.
local function bankOf(home)
	local v = type(home) == "table" and tonumber(home.CollectorCash) or 0
	if not isFinite(v) or v < 0 then
		return 0
	end
	return v
end

----------------------------------------------------------------------
-- Pets in the Garden
----------------------------------------------------------------------

local function validKeyString(key)
	return type(key) == "string" and key ~= "" and #key <= MAX_ID_LENGTH
end

-- def, tier of a pet key (any role; hybrids through PetKeys.DefOf); nil, nil, reason for junk keys / unknown pets.
local function petDefOf(key, profile)
	if not validKeyString(key) then
		return nil, nil, "Unknown pet"
	end
	local def, tier = nil, "Normal"
	if petKeys and type(petKeys.Parse) == "function" then
		local parsed = petKeys.Parse(key)
		if not parsed then
			return nil, nil, "Unknown pet"
		end
		tier = parsed.Tier or "Normal"
		if type(petKeys.DefOf) == "function" then
			local ok, result = pcall(petKeys.DefOf, key, profile)
			if ok and type(result) == "table" then
				def = result
			end
		end
	elseif petCatalog and type(petCatalog.Get) == "function" then
		def = petCatalog.Get(key)
	end
	if type(def) ~= "table" then
		return nil, nil, "Unknown pet"
	end
	return def, tier, nil
end

local function ownedCount(profile, key)
	if not profile or not validKeyString(key) then
		return 0
	end
	if petKeys and type(petKeys.Count) == "function" then
		local ok, n = pcall(petKeys.Count, profile, key)
		if ok and isFinite(n) then
			return n
		end
		return 0
	end
	local n = type(profile.Pets) == "table" and profile.Pets[key]
	return isFinite(n) and n or 0
end

local function petLevel(player, key)
	if dataService and type(dataService.GetPetLevel) == "function" then
		local ok, level = pcall(dataService.GetPetLevel, player, key)
		if ok and isFinite(level) and level >= 1 then
			return math.floor(level)
		end
	end
	return 1
end

-- The STORED evolution stage of a key (the boost counts only after EVOLVE was pressed, never from the level).
local function evolutionOf(player, key)
	if dataService and type(dataService.GetEvolution) == "function" then
		local ok, stage = pcall(dataService.GetEvolution, player, key)
		if ok and isFinite(stage) and stage > 0 then
			return math.floor(stage)
		end
	end
	return 0
end

-- { [key] = true } of the keys with a running training job: the ONE lock source (DataService.TrainingKeys).
local function trainingKeys(player)
	if dataService and type(dataService.TrainingKeys) == "function" then
		local ok, set = pcall(dataService.TrainingKeys, player)
		if ok and type(set) == "table" then
			return set
		end
	end
	return {}
end

local function gardenSlots(home)
	if catalog and type(catalog.GardenSlots) == "function" then
		return catalog.GardenSlots(home)
	end
	return 0
end

-- Every placed pet that counts: slots 1..MAX_SLOT of Home.Garden holding an owned key (one copy per slot) that is
-- not training (any role). Returns entries { [slot] = { Def, Level, Tier, Stage, Key } } (TycoonCatalog.PetPower
-- shapes; the catalog counts only entries[1 .. GardenSlots(home)], the rest rest) and valid { [slot] = key }.
local function gardenEntries(player, home, profile)
	local entries, valid = {}, {}
	local garden = type(home) == "table" and home.Garden
	if type(garden) ~= "table" then
		return entries, valid
	end
	local training = trainingKeys(player)
	local used = {}
	for slot = 1, MAX_SLOT do
		local key = garden[slot]
		if validKeyString(key) and not training[key] then
			local def, tier = petDefOf(key, profile)
			if def then
				used[key] = (used[key] or 0) + 1
				if used[key] <= ownedCount(profile, key) then
					entries[slot] = { Def = def, Level = petLevel(player, key), Tier = tier, Stage = evolutionOf(player, key), Key = key }
					valid[slot] = key
				end
			end
		end
	end
	return entries, valid
end

-- income per second (prestige multiplier applied), parts, valid garden map, entries
local function incomeOf(player, home)
	if not catalog or type(home) ~= "table" then
		return 0, { Food = 0, Pets = 0, Lucky = 1, Multiplier = 1 }, {}, {}
	end
	local entries, valid = gardenEntries(player, home, getProfile(player))
	local ok, income, parts = pcall(catalog.IncomePerSecond, home, entries, starsOf(home))
	if not ok or not isFinite(income) or income < 0 then
		return 0, { Food = 0, Pets = 0, Lucky = 1, Multiplier = 1 }, valid, entries
	end
	return income, parts, valid, entries
end

----------------------------------------------------------------------
-- The plot in the world (HomeBuilder) + replicated attributes
----------------------------------------------------------------------

local function plotInfo(index)
	if spotService and type(spotService.GetSpotByIndex) == "function" then
		local info = spotService.GetSpotByIndex(index)
		if info then
			return info
		end
	end
	return spotList[index]
end

local function setFolderAttr(info, name, value)
	local folder = info and info.Folder
	if typeof(folder) ~= "Instance" then
		return
	end
	pcall(function()
		if folder:GetAttribute(name) ~= value then
			folder:SetAttribute(name, value)
		end
	end)
end

local function gardenText(valid)
	local slots = {}
	for slot in pairs(valid) do
		slots[#slots + 1] = slot
	end
	table.sort(slots)
	local parts = {}
	for _, slot in ipairs(slots) do
		parts[#parts + 1] = tostring(slot) .. "=" .. valid[slot]
	end
	return table.concat(parts, ";")
end

-- "1=12:0;3=20:1": level:stage per placed slot (GardenInfo)
local function gardenInfoText(entries)
	local slots = {}
	for slot in pairs(entries) do
		slots[#slots + 1] = slot
	end
	table.sort(slots)
	local parts = {}
	for _, slot in ipairs(slots) do
		local e = entries[slot]
		parts[#parts + 1] = tostring(slot) .. "=" .. tostring(e.Level or 1) .. ":" .. tostring(e.Stage or 0)
	end
	return table.concat(parts, ";")
end

----------------------------------------------------------------------
-- Cloud Cash: the session ledger (Coins.state), the roaming epochs, the drops on the lawn, the scoop (Phase 5, 3.5)
----------------------------------------------------------------------

-- the shared server clock (workspace:GetServerTimeNow() on both sides; epochs ride in the Roam attribute)
function Coins.serverNow()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and isFinite(t) then
		return t
	end
	return os.time()
end

function Coins.seedOf(player)
	local id = tonumber(player and player.UserId) or 0
	return (math.floor(id) % 2147483646) + 1
end

function Coins.cycle()
	return (homeRoam and tonumber(homeRoam.Cycle)) or 24
end

function Coins.settle()
	return (homeRoam and tonumber(homeRoam.SettleSeconds)) or 20
end

function Coins.maxSlots()
	return (homeRoam and tonumber(homeRoam.MaxSlots)) or 12
end

-- epochs are rounded to 0.1 s so the server and every client compute from the SAME number (the attribute carries one decimal)
function Coins.roundEpoch(t)
	return math.floor(t * 10 + 0.5) / 10
end

function Coins.ensure(player)
	local st = Coins.state[player]
	if not st then
		st = {
			Drops = {}, -- [slot] = { { Cycle, Value, Lucky, Poops, X, Z }... } (creation order)
			Welcome = 0,
			Epoch = {}, -- [slot] = server time of cycle 0 (nil: no pet / resting)
			Nap = {}, -- [slot] = cycle the pet fell asleep in (no poop until a scoop below the cap)
			Done = {}, -- [slot] = the last cycle whose poop was decided
			Keys = {},
			Left = {}, -- [slot] = { Key, Epoch, Done, Nap, At } (churn: the same key back within a cycle keeps its epoch)
			Rng = Random.new(Coins.seedOf(player)),
			Fresh = true,
			BerryFrac = 0, -- the fraction of a berry the poops owe (whole berries go to DataService)
			RoamText = nil,
			DropsText = nil,
			DropsDirty = false,
			DropsAt = nil,
		}
		Coins.state[player] = st
	end
	return st
end

-- Rebuilds the ledger from the bank: every drop goes, the whole bank waits in the Welcome-back pile (on load, claim,
-- ProfileRebased, Prestige and the developer reset). The epochs start over (a fresh ledger staggers them).
function Coins.reset(player, bank)
	local st = Coins.ensure(player)
	st.Drops = {}
	st.Welcome = math.max(0, tonumber(bank) or 0)
	st.Epoch = {}
	st.Nap = {}
	st.Done = {}
	st.Keys = {}
	st.Left = {}
	st.Fresh = true
	st.DropsAt = nil -- a rebuilt ledger replicates its drops at once (a rare event, not a stream)
	return st
end

function Coins.slotValue(st, slot)
	local total = 0
	for _, d in ipairs(st.Drops[slot] or {}) do
		total = total + (d.Value or 0)
	end
	return total
end

function Coins.liveSum(st)
	local total = 0
	for _, list in pairs(st.Drops) do
		for _, d in ipairs(list) do
			total = total + (d.Value or 0)
		end
	end
	return total
end

-- Makes sum(drops) + welcome == bank. The bank only ever moves through this service's own MutateHome calls while
-- the plot is held, so normally this just sets the Welcome-back pile; when the bank shrank under the live drops
-- (another server scooped the same coins, a developer reset, a stale merge) the drops are trimmed from the newest.
function Coins.reconcile(st, bank)
	bank = math.max(0, tonumber(bank) or 0)
	local live = Coins.liveSum(st)
	if live <= bank + 1e-6 then
		st.Welcome = bank - live
		if st.Welcome < 1e-6 then
			st.Welcome = 0
		end
		return
	end
	st.Welcome = 0
	local over = live - bank
	for slot = MAX_SLOT, 1, -1 do
		local list = st.Drops[slot]
		if list then
			for i = #list, 1, -1 do
				if over <= 0 then
					break
				end
				local d = list[i]
				local cut = math.min(d.Value, over)
				d.Value = d.Value - cut
				over = over - cut
				if d.Value < 1e-6 then
					table.remove(list, i)
				end
			end
			if #list == 0 then
				st.Drops[slot] = nil
			end
		end
	end
end

-- the plot frame of a held plot (cached per ledger; a claim on another plot refreshes it)
function Coins.plotFrame(st, index)
	if st.Index == index and typeof(st.PlotCF) == "CFrame" then
		return st.PlotCF
	end
	local info = plotInfo(index)
	local plotCF = info and info.PlotCFrame
	if typeof(plotCF) ~= "CFrame" then
		return nil
	end
	st.Index = index
	st.PlotCF = plotCF
	st.WelcomePos = nil
	return plotCF
end

-- the world point of a plot-local (x, z) on the lawn
function Coins.worldPoint(st, index, x, z)
	local plotCF = Coins.plotFrame(st, index)
	if not plotCF or not isFinite(x) or not isFinite(z) then
		return nil
	end
	return plotCF:PointToWorldSpace(Vector3.new(x, 0, z))
end

function Coins.welcomePoint(st, index)
	if st.WelcomePos and st.Index == index then
		return st.WelcomePos
	end
	local plotCF = Coins.plotFrame(st, index)
	local def = catalog and catalog.Get("Garden")
	local local3 = def and def.Slot and def.Slot.WelcomePile
	if not plotCF or typeof(local3) ~= "Vector3" then
		return nil
	end
	st.WelcomePos = plotCF:PointToWorldSpace(local3)
	return st.WelcomePos
end

-- the drop stage (1..4) of `poops` poops by Coins.DropStages {1, 2, 4, 8}; 0 for a fraction left by a scoop
function Coins.stageOf(poops)
	local n = tonumber(poops) or 0
	local stages = catalog and catalog.Coins and catalog.Coins.DropStages or { 1, 2, 4, 8 }
	local stage = 0
	for i, need in ipairs(stages) do
		if n >= need then
			stage = i
		end
	end
	return stage
end

-- "1=812:1,813:2*;3=40:1;W=5" (slot = cycle:stage[* Lucky] per drop; W the Welcome-back pile while it holds >= $1)
function Coins.dropsText(st)
	local slots = {}
	for slot, list in pairs(st.Drops) do
		if #list > 0 then
			slots[#slots + 1] = slot
		end
	end
	table.sort(slots)
	local parts = {}
	for _, slot in ipairs(slots) do
		local items = {}
		for _, d in ipairs(st.Drops[slot]) do
			if (d.Poops or 0) >= 1 then
				items[#items + 1] = tostring(d.Cycle) .. ":" .. tostring(Coins.stageOf(d.Poops)) .. (d.Lucky and "*" or "")
			end
		end
		if #items > 0 then
			parts[#parts + 1] = tostring(slot) .. "=" .. table.concat(items, ",")
		end
	end
	if (st.Welcome or 0) >= 1 then
		parts[#parts + 1] = "W=5"
	end
	return table.concat(parts, ";")
end

-- "1=1760001234.5;3=1760001240.0:N812" (slot = epoch, one decimal; :N<cycle> while the pet naps)
function Coins.roamText(st)
	local slots = {}
	for slot in pairs(st.Epoch) do
		slots[#slots + 1] = slot
	end
	table.sort(slots)
	local parts = {}
	for _, slot in ipairs(slots) do
		local text = tostring(slot) .. "=" .. string.format("%.1f", st.Epoch[slot])
		if st.Nap[slot] then
			text = text .. ":N" .. tostring(st.Nap[slot])
		end
		parts[#parts + 1] = text
	end
	return table.concat(parts, ";")
end

-- Replicates the coin numbers of a plot (written only on change): CollectorCash (the bank, whole), IncomePerSecond,
-- RoamSeed / RoamVersion, Roam, CoinDrops (<= one write per Coins.DROPS_WRITE_GAP), BerryCap, GardenInfo, GardenSlots.
function Coins.show(index, st, home, income, entries, player)
	local info = plotInfo(index)
	if not info then
		return
	end
	local s = shown[index]
	if not s then
		s = {}
		shown[index] = s
	end
	local whole = math.floor(bankOf(home))
	if s.Cash ~= whole then
		s.Cash = whole
		setFolderAttr(info, "CollectorCash", whole)
	end
	local rate = math.floor((income or 0) * 10 + 0.5) / 10
	if s.Income ~= rate then
		s.Income = rate
		setFolderAttr(info, "IncomePerSecond", rate)
	end
	if player then
		local seed = Coins.seedOf(player)
		if s.RoamSeed ~= seed then
			s.RoamSeed = seed
			setFolderAttr(info, "RoamSeed", seed)
		end
		local version = (homeRoam and homeRoam.Version) or 0
		if s.RoamVersion ~= version then
			s.RoamVersion = version
			setFolderAttr(info, "RoamVersion", version)
		end
	end
	local roam = Coins.roamText(st)
	if s.Roam ~= roam then
		s.Roam = roam
		setFolderAttr(info, "Roam", roam)
	end
	local drops = Coins.dropsText(st)
	if s.Drops ~= drops then
		local now = os.clock()
		if st.DropsAt == nil or now - st.DropsAt >= Coins.DROPS_WRITE_GAP then
			s.Drops = drops
			st.DropsAt = now
			st.DropsDirty = false
			setFolderAttr(info, "CoinDrops", drops)
		else
			st.DropsDirty = true -- the next tick after the gap writes it
		end
	else
		st.DropsDirty = false
	end
	if catalog and type(catalog.BasketCap) == "function" then
		local okCap, cap = pcall(catalog.BasketCap, home, income or 0)
		if okCap and isFinite(cap) then
			cap = math.floor(cap)
			if s.BerryCap ~= cap then
				s.BerryCap = cap
				setFolderAttr(info, "BerryCap", cap)
			end
		end
	end
	local infoText = gardenInfoText(entries or {})
	if s.Info ~= infoText then
		s.Info = infoText
		setFolderAttr(info, "GardenInfo", infoText)
	end
	local open = gardenSlots(home)
	if s.Open ~= open then
		s.Open = open
		setFolderAttr(info, "GardenSlots", open)
	end
end

-- The epochs follow the placed keys: a NEW key in a slot gets Epoch = now + SettleSeconds (its first poop >= a full
-- cycle later: X5 / Y8); the same key back in its slot within one cycle keeps its old epoch (and its done / nap
-- marks: removing and re-placing a pet right after a poop gains nothing). Keys found on a fresh ledger (load / claim /
-- rebase) get a staggered start so a dozen pets do not all poop in the same second. A key resting above the open
-- count (`open`) owns no epoch: the place that opens later (a Prestige) starts with a settle, never with a backlog.
function Coins.followKeys(st, valid, now, cycle, open)
	for slot = 1, MAX_SLOT do
		local key = valid[slot]
		local was = st.Keys[slot]
		if key ~= was then
			if was ~= nil then
				st.Left[slot] = { Key = was, Epoch = st.Epoch[slot], Done = st.Done[slot], Nap = st.Nap[slot], At = now }
			end
			st.Keys[slot] = key
			if key ~= nil then
				local left = st.Left[slot]
				if left and left.Key == key and left.Epoch and now - left.At <= cycle then
					st.Epoch[slot] = left.Epoch
					st.Done[slot] = left.Done
					st.Nap[slot] = left.Nap
				elseif st.Fresh then
					st.Epoch[slot] = Coins.roundEpoch(now + st.Rng:NextNumber() * cycle)
					st.Done[slot] = -1
					st.Nap[slot] = nil
				else
					st.Epoch[slot] = Coins.roundEpoch(now + Coins.settle())
					st.Done[slot] = -1
					st.Nap[slot] = nil
				end
				st.Left[slot] = nil
			else
				st.Epoch[slot] = nil
				st.Done[slot] = nil
				st.Nap[slot] = nil
			end
		end
		if open ~= nil and slot > open and st.Epoch[slot] ~= nil then
			st.Epoch[slot] = nil -- resting: no poop is owed while the place is closed
			st.Done[slot] = nil
			st.Nap[slot] = nil
		end
	end
	st.Fresh = false
end

-- the lawn cap of one slot: PileSeconds(home) of that pet's coin rate (Lucky counted at its expected value)
function Coins.capOf(home, coin)
	local meal = catalog.Coins.MealSeconds
	return catalog.PileSeconds(home) * coin / meal * catalog.LuckyEV(home)
end

-- A napping slot wakes when its lawn value is below its cap again: the pet walks back from where it slept (the nap
-- cycle's OutLen / Speed) and the cycles start over from the new epoch. Returns true when something changed.
function Coins.wake(st, seed, slot, now, cap)
	local napCycle = st.Nap[slot]
	if not napCycle then
		return false
	end
	if Coins.slotValue(st, slot) >= cap - 1e-9 then
		return false
	end
	local back = Coins.cycle()
	local plan = homeRoam and homeRoam.Plan(seed, slot, napCycle)
	if plan and isFinite(plan.OutLen) and isFinite(plan.Speed) and plan.Speed > 0 then
		back = math.max(0, math.min(back, plan.OutLen / plan.Speed))
	end
	st.Nap[slot] = nil
	st.Epoch[slot] = Coins.roundEpoch(now + back)
	st.Done[slot] = -1
	return true
end

-- The poops of one tick: for every OPEN place with a pet, every poop whose time (HomeRoam.PoopTime on the slot's
-- epoch) has come drops Cloud Cash at the plan's poop point (Lucky with LuckyChance), at most MAX_POOPS_PER_TICK per
-- slot per tick (a stalled server catches up a little at a time). A slot whose lawn value reached its cap naps
-- instead (`:N<cycle>` in Roam, no poop) until a scoop below the cap wakes it. Returns the Cash of the new poops and
-- the list of { Slot, Cycle, Value, Lucky, X, Z } to lay down once the bank took them.
function Coins.poops(st, home, entries, valid, now, seed)
	if not homeRoam or type(homeRoam.PoopTime) ~= "function" then
		return 0, {}
	end
	local stars = starsOf(home)
	local lucky = catalog.LuckyChance(home)
	local luckyMult = catalog.Coins.LuckyMult
	local poopMeals = catalog.Coins.PoopMeals or 3
	local open = math.min(gardenSlots(home), MAX_SLOT, Coins.maxSlots())
	local added, drops = 0, {}
	for slot = 1, open do
		local entry = valid[slot] and entries[slot]
		if entry then
			if not st.Epoch[slot] then
				-- a place that just opened (or an epoch dropped while resting): a settle first, never a backlog
				st.Epoch[slot] = Coins.roundEpoch(now + Coins.settle())
				st.Done[slot] = -1
				st.Nap[slot] = nil
			end
			local coin = catalog.CoinValue(home, catalog.PetPower(entry), stars)
			local cap = Coins.capOf(home, coin)
			Coins.wake(st, seed, slot, now, cap)
			local epoch = st.Epoch[slot]
			local n = 0
			while n < Coins.MAX_POOPS_PER_TICK and not st.Nap[slot] do
				local c = (st.Done[slot] or -1) + 1
				local at = homeRoam.PoopTime(seed, slot, epoch, c)
				if not isFinite(at) or at > now then
					break
				end
				n = n + 1
				if coin <= 0 then
					st.Done[slot] = c
				elseif Coins.slotValue(st, slot) >= cap - 1e-9 then
					st.Nap[slot] = c -- full lawn: the pet naps where it stands until a scoop below the cap
				else
					local plan = homeRoam.Plan(seed, slot, c)
					local pt = plan and plan.Poop
					if not pt then
						st.Done[slot] = c
					else
						local v = coin * poopMeals
						local isLucky = false
						if lucky > 0 and st.Rng:NextNumber() < lucky then
							v = v * luckyMult
							isLucky = true
						end
						drops[#drops + 1] = { Slot = slot, Cycle = c, Value = v, Lucky = isLucky, X = pt.x or pt[1], Z = pt.z or pt[2] }
						added = added + v
						st.Done[slot] = c
					end
				end
			end
			-- never owe more than two cycles of backlog (a long stall is forgiven, the pets keep their rhythm)
			local lastDue = (st.Done[slot] or -1)
			if not st.Nap[slot] then
				local late = homeRoam.PoopTime(seed, slot, epoch, lastDue + 1)
				while isFinite(late) and now - late > 2 * Coins.cycle() do
					lastDue = lastDue + 1
					late = homeRoam.PoopTime(seed, slot, epoch, lastDue + 1)
				end
				st.Done[slot] = lastDue
			end
		end
	end
	return added, drops
end

-- Lays the new poops on the lawn: a slot keeps at most Coins.DropsPerPet drops, a further poop merges into the
-- NEAREST drop of that slot (its value and poop count grow, its cycle id stays).
function Coins.applyDrops(st, drops)
	local maxDrops = (catalog.Coins and catalog.Coins.DropsPerPet) or 3
	for _, d in ipairs(drops) do
		local list = st.Drops[d.Slot]
		if not list then
			list = {}
			st.Drops[d.Slot] = list
		end
		local real = 0
		for _, e in ipairs(list) do
			if (e.Poops or 0) >= 1 then
				real = real + 1
			end
		end
		if real < maxDrops then
			list[#list + 1] = { Cycle = d.Cycle, Value = d.Value, Lucky = d.Lucky == true, Poops = 1, X = d.X, Z = d.Z }
		else
			local best, bestD = nil, math.huge
			for _, e in ipairs(list) do
				if (e.Poops or 0) >= 1 then
					local dx, dz = (e.X or 0) - d.X, (e.Z or 0) - d.Z
					local dist = dx * dx + dz * dz
					if dist < bestD then
						best, bestD = e, dist
					end
				end
			end
			best.Value = best.Value + d.Value
			best.Poops = (best.Poops or 0) + 1
			if d.Lucky then
				best.Lucky = true
			end
		end
	end
end

-- Berries from the poops of one tick: value x Berries.Share whole berries into Profile.Berries (the fraction stays in
-- the ledger), clamped so the poops never lift Berries above BasketCap (a cap below the berries removes none; the lost
-- berries toast "Basket full!" once until the basket has room again). Non-yielding.
function Coins.berries(player, st, home, income, added)
	local B = catalog.Berries
	if type(B) ~= "table" or not dataService or type(dataService.AddBerries) ~= "function" then
		return 0
	end
	local pot = (st.BerryFrac or 0) + added * (tonumber(B.Share) or 0)
	local whole = math.floor(pot + 1e-9)
	st.BerryFrac = math.max(0, pot - whole)
	if whole < 1 then
		return 0
	end
	local have = 0
	if type(dataService.GetBerries) == "function" then
		local okH, h = pcall(dataService.GetBerries, player)
		if okH and isFinite(h) then
			have = h
		end
	end
	local cap = whole + have
	if type(catalog.BasketCap) == "function" then
		local okCap, c = pcall(catalog.BasketCap, home, income or 0)
		if okCap and isFinite(c) then
			cap = c
		end
	end
	local room = math.max(0, math.floor(cap) - have)
	local give = math.min(whole, room)
	if give < whole then
		if not st.BasketFull then
			st.BasketFull = true
			notify(player, "Basket full! Feed your pets", "info", 4)
		end
	elseif have + give < cap then
		st.BasketFull = nil
	end
	if give < 1 then
		return 0
	end
	local okAdd, wrote = pcall(dataService.AddBerries, player, give)
	if not okAdd or wrote ~= true then
		st.BerryFrac = st.BerryFrac + give -- not banked (not loaded yet): the next tick tries again
		return 0
	end
	return give
end

-- Scoops every drop within ScoopRadius(home) (horizontally; SCOOP_HEIGHT vertically) of the OWNER's root: the bank
-- pays `take` (whole Cash, clamped to the bank) in one MutateHome, then AddCash; refunded when AddCash fails.
-- Fractions stay on the lawn (an invisible drop below $1). Napping slots whose lawn fell under the cap wake up.
-- Returns ok, amount | reason.
function Coins.scoop(player, index)
	local st = Coins.state[player]
	local info = plotInfo(index)
	if not st or not info then
		return false, "Nothing to scoop yet"
	end
	local root = Util.GetRoot(player)
	if not root then
		return false, "Nothing to scoop yet"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	local radius = catalog.ScoopRadius(home)
	local at = root.Position
	local function inRange(pos)
		if typeof(pos) ~= "Vector3" then
			return false
		end
		local dx, dz = pos.X - at.X, pos.Z - at.Z
		return math.sqrt(dx * dx + dz * dz) <= radius and math.abs(pos.Y - at.Y) <= Coins.SCOOP_HEIGHT
	end
	local hit, sum = {}, 0
	local slots = {}
	for slot in pairs(st.Drops) do
		slots[#slots + 1] = slot
	end
	table.sort(slots)
	for _, slot in ipairs(slots) do
		for i, d in ipairs(st.Drops[slot]) do
			if d.Value > 0 and inRange(Coins.worldPoint(st, index, d.X, d.Z)) then
				hit[#hit + 1] = { Slot = slot, Index = i, Drop = d }
				sum = sum + d.Value
			end
		end
	end
	local welcomeIn = st.Welcome > 0 and inRange(Coins.welcomePoint(st, index))
	if welcomeIn then
		sum = sum + st.Welcome
	end
	local take = math.floor(sum + 1e-6)
	if take < 1 then
		return false, "Nothing to scoop yet"
	end
	local paid = 0
	local wrote = mutateHome(player, function(live)
		local cur = bankOf(live)
		paid = math.min(take, math.floor(cur + 1e-6)) -- clamped to the bank (X4)
		if paid < 1 then
			return false
		end
		live.CollectorCash = cur - paid
		return true
	end)
	if not wrote or paid < 1 then
		Coins.reconcile(st, bankOf(getHome(player) or home)) -- the bank holds less than the drops claim
		return false, "Nothing to scoop yet"
	end
	if not dataService.AddCash(player, paid) then
		mutateHome(player, function(live)
			live.CollectorCash = bankOf(live) + paid -- the Cash could not be banked: back onto the lawn
			return true
		end)
		return false, "Could not bank the Cash right now"
	end
	-- the drops in range are gone; the fraction below one Cash stays in the first of them (invisible: no poops)
	local left = math.max(0, sum - paid)
	local first = hit[1]
	for i = #hit, 1, -1 do
		local h = hit[i]
		local list = st.Drops[h.Slot]
		if list then
			for j = #list, 1, -1 do
				if list[j] == h.Drop then
					table.remove(list, j)
				end
			end
			if #list == 0 then
				st.Drops[h.Slot] = nil
			end
		end
	end
	if welcomeIn then
		st.Welcome = 0
	end
	if left > 1e-6 then
		if first then
			local list = st.Drops[first.Slot]
			if not list then
				list = {}
				st.Drops[first.Slot] = list
			end
			table.insert(list, 1, { Cycle = first.Drop.Cycle, Value = left, Lucky = false, Poops = 0, X = first.Drop.X, Z = first.Drop.Z })
		else
			st.Welcome = left
		end
	end
	Coins.reconcile(st, bankOf(getHome(player) or home))
	-- napping pets whose lawn has room again walk back to the bowl
	local seed = Coins.seedOf(player)
	local now = Coins.serverNow()
	local _, _, valid, entries = incomeOf(player, home)
	for slot in pairs(st.Nap) do
		local entry = valid[slot] and entries[slot]
		if entry then
			local coin = catalog.CoinValue(home, catalog.PetPower(entry), starsOf(home))
			Coins.wake(st, seed, slot, now, Coins.capOf(home, coin))
		else
			Coins.wake(st, seed, slot, now, math.huge)
		end
	end
	TycoonService.CoinsScooped:Fire(player, paid)
	return true, paid
end

-- The 0.25 s owner proximity pass over every held plot (X1 / X2: no remote, only the owner's root).
function Coins.scoopAll()
	for player, index in pairs(plots) do
		local st = Coins.state[player]
		if st and player.Parent and not departed[player] and (st.Welcome >= 1 or next(st.Drops) ~= nil) then
			local ok, paid = pcall(Coins.scoop, player, index)
			if not ok then
				warn("[TycoonService] scoop failed: " .. tostring(paid))
			elseif paid == true then
				local home = getHome(player)
				if home then
					local income, _, _, entries = incomeOf(player, home)
					Coins.show(index, st, home, income, entries, player)
				end
			end
		end
	end
end

function Coins.loop()
	while running do
		task.wait(Coins.SCOOP_TICK)
		if not running then
			break
		end
		local ok, err = pcall(Coins.scoopAll)
		if not ok then
			warn("[TycoonService] scoop pass failed: " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- The plot sync
----------------------------------------------------------------------

local function padSignature(pads)
	local parts = {}
	for i, pad in ipairs(pads) do
		parts[i] = tostring(pad.StationId) .. ":" .. tostring(pad.NextLevel) .. ":" .. tostring(pad.Price) .. ":" .. tostring(pad.Locked or "")
	end
	return table.concat(parts, "|")
end

-- Brings the plot in line with the home: stations (diff only), pads, coins, attributes, garden, nameplate.
-- Returns true when a station changed.
local function syncPlot(player, home, income, valid, entries)
	local index = plots[player]
	local info = index and plotInfo(index)
	if not info or type(home) ~= "table" or not catalog then
		return false
	end
	local map = built[index]
	if not map then
		map = {}
		built[index] = map
	end
	local changed = false
	for _, def in ipairs(catalog.Stations) do
		local id = def.Id
		local level = stationLevel(home, id)
		if (map[id] or 0) ~= level then
			map[id] = level
			hb("SetStation", info, id, level)
			changed = true
		end
	end
	local okPads, pads = pcall(catalog.AvailablePads, home)
	if okPads and type(pads) == "table" then
		local sig = padSignature(pads)
		if padSig[index] ~= sig then
			padSig[index] = sig
			hb("SetPads", info, pads)
		end
	end
	if income == nil or valid == nil or entries == nil then
		local parts
		income, parts, valid, entries = incomeOf(player, home)
	end
	local st = Coins.ensure(player)
	if st.Fresh then
		-- a rebuilt ledger (claim, load, rebase, prestige, reset): the keys already in the garden get their random
		-- start phase NOW, so a pet placed a moment later waits a full meal like every new placement (X5)
		Coins.followKeys(st, valid or {}, Coins.serverNow(), Coins.cycle(), gardenSlots(home))
	end
	Coins.reconcile(st, bankOf(home))
	Coins.show(index, st, home, income, entries, player)
	local s = shown[index] or {}
	shown[index] = s
	local level, stars = homeLevelOf(home), starsOf(home)
	if s.Level ~= level or s.Prestige ~= stars then
		s.Level, s.Prestige = level, stars
		setFolderAttr(info, "HomeLevel", level)
		setFolderAttr(info, "Prestige", stars)
		if spotService and type(spotService.Refresh) == "function" then
			pcall(spotService.Refresh, player)
		end
	end
	local garden = gardenText(valid or {})
	local open = gardenSlots(home)
	if s.Garden ~= garden or s.GardenOpen ~= open then
		s.Garden = garden
		s.GardenOpen = open
		setFolderAttr(info, "GardenPets", garden)
		hb("SetGarden", info, valid or {}, open)
	end
	return changed
end

local function resetPlotState(index)
	built[index] = nil
	padSig[index] = nil
	shown[index] = nil
end

local function clearPlotAttributes(info)
	for _, name in ipairs({ "HomeLevel", "Prestige", "CollectorCash", "IncomePerSecond", "GardenPets", "GardenInfo", "GardenSlots", "RoamSeed", "RoamVersion", "Roam", "CoinDrops", "BerryCap" }) do
		setFolderAttr(info, name, nil)
	end
end

----------------------------------------------------------------------
-- Gate prompts
----------------------------------------------------------------------

local function findPrompt(container, name)
	if typeof(container) ~= "Instance" then
		return nil
	end
	for _, d in ipairs(container:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == name then
			return d
		end
	end
	return nil
end

-- ClaimPrompts HomeBuilder built outside the spot folders, by their SpotIndex attribute (one scan at Init).
local function claimPromptsBySpot()
	local out = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "ClaimPrompt" then
			local index = d:GetAttribute("SpotIndex")
			if type(index) == "number" then
				out[index] = d
			end
		end
	end
	return out
end

-- A plain ClaimPrompt on the gate when HomeBuilder did not build one (or is missing).
local function ensureClaimPrompt(index, info, existing)
	if findPrompt(info.Folder, "ClaimPrompt") or (existing and existing[index]) then
		return
	end
	local gate = nil
	if spotService and type(spotService.GateCFrame) == "function" then
		gate = spotService.GateCFrame(info)
	end
	if typeof(gate) ~= "CFrame" then
		gate = typeof(info.GateCFrame) == "CFrame" and info.GateCFrame or info.SpawnCFrame
	end
	if typeof(gate) ~= "CFrame" or typeof(info.Folder) ~= "Instance" then
		return
	end
	local anchor = Instance.new("Part")
	anchor.Name = "ClaimAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.CastShadow = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.CFrame = gate * CFrame.new(0, GATE_PROMPT_LIFT, 0)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ClaimPrompt"
	prompt.ActionText = "Claim Home"
	prompt.ObjectText = "Free home"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = CLAIM_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt:SetAttribute("SpotIndex", index)
	prompt.Parent = anchor
	anchor.Parent = info.Folder
	fallbackPrompts[index] = prompt
end

local function setFallbackPrompt(index, owner)
	local prompt = fallbackPrompts[index]
	if not prompt or not prompt.Parent then
		return
	end
	pcall(function()
		prompt.Enabled = owner == nil
		prompt.ObjectText = "Free home"
	end)
end

----------------------------------------------------------------------
-- Claim / release
----------------------------------------------------------------------

local function validIndex(index)
	return type(index) == "number" and index == index and index == math.floor(index) and plotInfo(index) ~= nil
end

-- The one-time welcome toast of a migrated Phase 3 veteran (contract 4.3): Migrations.P4Veteran owes it,
-- P4Welcome marks it shown (a union in the merge: never twice, also across servers).
local function welcomeVeteran(player)
	if not dataService or type(dataService.IsMigrated) ~= "function" or type(dataService.MarkMigrated) ~= "function" then
		return false
	end
	local okV, veteran = pcall(dataService.IsMigrated, player, "P4Veteran")
	local okW, welcomed = pcall(dataService.IsMigrated, player, "P4Welcome")
	if not okV or not okW or veteran ~= true or welcomed ~= false then
		return false
	end
	local okMark, marked = pcall(dataService.MarkMigrated, player, "P4Welcome")
	if not okMark or marked ~= true then
		return false
	end
	notify(player, "Welcome to the new home! Your presses grew into food plants, the Collector is now a Coin Magnet, and your old Collector Cash waits in a coin pile by your garden. Put pets in your garden: they make the money now!", "good", 9)
	return true
end

-- The one-time 'Your home got simpler!' toast of a Phase 4 home folded by THIS session's P5Home step
-- (DataService.MigratedNow(player, "P5Home") answers only in the session that ran the fold for the first time).
local function welcomeP5(player)
	if Coins.welcomedP5[player] or not dataService or type(dataService.MigratedNow) ~= "function" then
		return false
	end
	local ok, info = pcall(dataService.MigratedNow, player, "P5Home")
	if not ok or type(info) ~= "table" or info.FirstTime ~= true then
		return false
	end
	if info.Folded ~= true and info.Veteran ~= true and (tonumber(info.Berries) or 0) < 1 then
		return false -- a brand-new profile marked on its first load: nothing changed for this player
	end
	Coins.welcomedP5[player] = true
	notify(player, "Your home got simpler! Your plants grew into one Berry Farm and your garden pets now roam your yard. Old snacks count as berries, and feeding is free: berries!", "good", 9)
	return true
end

function TycoonService.Claim(player, index)
	if not initialized or not spotService or type(spotService.Claim) ~= "function" then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not validIndex(index) then
		return false, "Unknown home"
	end
	if plots[player] then
		if plots[player] == index then
			return false, "This is already your home"
		end
		return false, "You already have a home"
	end
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return false, "Finish your match first"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	local ok, reason = spotService.Claim(player, index)
	if not ok then
		return false, reason or "This home is taken"
	end
	local info = plotInfo(index)
	plots[player] = index
	plotOwner[index] = player
	lastTick[player] = os.clock()
	-- Home.Level always mirrors the stations (an old or hand-edited save may disagree)
	local level = homeLevelOf(home)
	if home.Level ~= level then
		mutateHome(player, function(live)
			live.Level = homeLevelOf(live)
			return true
		end)
	end

	-- a clean plot, then the saved build on top of it; the coins waiting in the bank become the Welcome-back pile
	hb("ClearPlot", info)
	resetPlotState(index)
	hb("SetOwner", info, player)
	setFallbackPrompt(index, player)
	Coins.reset(player, bankOf(home))
	local income, _, valid, entries = incomeOf(player, home)
	syncPlot(player, home, income, valid, entries)

	TycoonService.Claimed:Fire(player, info)
	TycoonService.HomeChanged:Fire(player)
	if level > 0 then
		notify(player, "Welcome home! Rebuilt at Home Level " .. level .. ".", "good", 5)
	else
		notify(player, "Welcome home! Use the glowing pads to build.", "good", 6)
	end
	welcomeVeteran(player)
	welcomeP5(player)
	return true, nil
end

-- Clears this service's view of a plot and the build in the world (only while `player` still holds it).
local function dropPlot(player, index)
	if not index or plotOwner[index] ~= player then
		return nil
	end
	plotOwner[index] = nil
	if plots[player] == index then
		plots[player] = nil
	end
	Coins.state[player] = nil -- the piles are session memory: the bank waits as the Welcome-back pile next time
	local info = plotInfo(index)
	if info then
		hb("ClearPlot", info)
		hb("SetOwner", info, nil)
		clearPlotAttributes(info)
	end
	resetPlotState(index)
	setFallbackPrompt(index, nil)
	return info
end

function TycoonService.Release(player)
	if not player then
		return
	end
	local index = plots[player]
	plots[player] = nil
	local info = dropPlot(player, index)
	if spotService and type(spotService.Release) == "function" and spotService.GetSpot and spotService.GetSpot(player) then
		pcall(spotService.Release, player)
	end
	if info then
		TycoonService.Released:Fire(player, info)
	end
end

-- The prompt's world position (its part or attachment), or nil.
local function promptPosition(prompt)
	local parent = prompt.Parent
	if typeof(parent) ~= "Instance" then
		return nil
	end
	if parent:IsA("BasePart") then
		return parent.Position
	end
	if parent:IsA("Attachment") then
		return parent.WorldPosition
	end
	if parent:IsA("Model") then
		local ok, pivot = pcall(function()
			return parent:GetPivot()
		end)
		if ok and typeof(pivot) == "CFrame" then
			return pivot.Position
		end
	end
	return nil
end

-- A claim needs the player AT the gate (the engine checks prompt range too; this also covers a stray trigger).
local function nearPrompt(player, prompt)
	local at = promptPosition(prompt)
	local root = Util.GetRoot(player)
	if not at or not root then
		return at == nil -- no position to compare: allow; no character: refuse
	end
	local reach = (tonumber(prompt.MaxActivationDistance) or CLAIM_DISTANCE) + CLAIM_SLACK
	return (root.Position - at).Magnitude <= reach
end

local function onClaimPrompt(player, index, prompt)
	if prompt and not nearPrompt(player, prompt) then
		return
	end
	if not cooldown(player, "Claim", CLAIM_COOLDOWN) or not spend(player) then
		return
	end
	local ok, reason = TycoonService.Claim(player, index)
	if not ok then
		toastOnce(player, reason or "You cannot claim this home", "bad")
	end
end

----------------------------------------------------------------------
-- Purchases
----------------------------------------------------------------------

local function milestoneToasts(player, before, after)
	local levelBefore, levelAfter = homeLevelOf(before), homeLevelOf(after)
	local houseBefore, houseAfter = stationLevel(before, "House"), stationLevel(after, "House")
	if houseAfter > houseBefore and houseAfter >= 2 then
		notify(player, houseTierName(houseAfter) .. " built! Stations can level higher.", "good", 5)
	end
	local tiers = catalog.HouseTiers or {}
	for i, tier in ipairs(tiers) do
		local need = tonumber(tier.HomeLevel) or 0
		if i >= 2 and need > 0 and levelBefore < need and levelAfter >= need and houseAfter < i then
			notify(player, "Home Level " .. need .. ": the " .. tostring(tier.Name) .. " can be built!", "good", 5)
		end
	end
	if type(catalog.CanPrestige) == "function" then
		local wasReady = catalog.CanPrestige(before)
		local isReady = catalog.CanPrestige(after)
		if isReady and not wasReady then
			notify(player, "Prestige is ready at your home!", "good", 6)
		end
	end
	if stationLevel(before, "Garden") < 1 and stationLevel(after, "Garden") >= 1 then
		notify(player, "Put pets in your Pet Garden: they eat and pop out rainbow coins!", "info", 6)
	end
end

function TycoonService.Buy(player, stationId)
	if not initialized or not catalog then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if type(stationId) ~= "string" or #stationId > MAX_ID_LENGTH then
		return false, "Unknown station"
	end
	if stationId == "Prestige" then
		-- never a one-press reset: Prestige() / HomeAction "Prestige" (the Home window's confirm button) do that
		return false, "Prestige from the Home window (it shows what resets first)"
	end
	local def = catalog.Get(stationId)
	if not def and Coins.LEGACY_HOME[stationId] then
		-- an old client's pad id (Phase 4 presses, Collector, old decor): the fold moved it into a Phase 5 station
		return false, "That station is now part of the " .. Coins.LEGACY_HOME[stationId]
	end
	if not def or def.Kind == "Prestige" then
		return false, "Unknown station"
	end
	if not plots[player] then
		return false, "Claim a home first (E at a free gate)"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	-- CheckPurchase answers the STAR price (TycoonCatalog.PriceAt: x1.5 per star unless Home.LegacyPrices)
	local ok, price, reason = catalog.CheckPurchase(home, stationId)
	if not ok then
		return false, reason or "Not available yet"
	end
	price = tonumber(price) or 0
	if not isFinite(price) or price < 0 then
		return false, "Not available yet"
	end
	price = math.ceil(price)
	if price > getCash(player) then
		return false, "Not enough Cash: need " .. money(price)
	end
	local level = stationLevel(home, stationId)

	-- check + pay + write in ONE non-yielding step (MutateHome runs fn synchronously)
	local spent = false
	local wrote = mutateHome(player, function(live)
		if stationLevel(live, stationId) ~= level then
			return false
		end
		local okLive, priceLive = catalog.CheckPurchase(live, stationId)
		if not okLive or math.ceil(tonumber(priceLive) or -1) ~= price then
			return false
		end
		if price > 0 then
			if not dataService.SpendCash(player, price) then
				return false
			end
			spent = true
		end
		if type(live.Stations) ~= "table" then
			live.Stations = {}
		end
		live.Stations[stationId] = level + 1
		live.Level = homeLevelOf(live)
		if offlineDone[player] then
			live.LastSeen = os.time() -- income just rose: the next offline payout starts from here
		end
		return true
	end)
	if not wrote then
		if spent then
			dataService.AddCash(player, price) -- the home write was refused: give the cash back
		end
		if price > getCash(player) then
			return false, "Not enough Cash: need " .. money(price)
		end
		return false, "Could not build that right now"
	end

	local after = getHome(player) or home
	syncPlot(player, after)
	local newLevel = level + 1
	if level == 0 then
		notify(player, "Built " .. stationName(stationId) .. "!" .. (price > 0 and (" (-" .. money(price) .. ")") or ""), "good", 3)
	else
		notify(player, stationName(stationId) .. " is now Lv " .. newLevel .. "! (-" .. money(price) .. ")", "good", 3)
	end
	milestoneToasts(player, home, after)
	TycoonService.HomeChanged:Fire(player)
	return true, newLevel
end

----------------------------------------------------------------------
-- Collect = scoop every pile in range (old clients / tests; the 0.25 s loop does it by itself)
----------------------------------------------------------------------

function TycoonService.Collect(player, quiet)
	if not initialized or not dataService then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	local index = plots[player]
	if not index then
		return false, "Claim a home first (E at a free gate)"
	end
	local ok, result = Coins.scoop(player, index)
	if not ok then
		return false, result
	end
	local home = getHome(player)
	if home then
		local income, _, _, entries = incomeOf(player, home)
		Coins.show(index, Coins.ensure(player), home, income, entries, player)
	end
	if not quiet or cooldown(player, "CollectToast", COLLECT_TOAST_GAP) then
		notify(player, "+" .. money(result) .. " scooped!", "good", 2.5)
	end
	return true, result
end

----------------------------------------------------------------------
-- Prestige
----------------------------------------------------------------------

-- Can this player prestige right now? true, home | false, reason (no side effects).
local function prestigeCheck(player)
	if not initialized or not catalog then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	if not plots[player] then
		return false, "Claim a home first (E at a free gate)"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	local can, reason = catalog.CanPrestige(home)
	if not can then
		return false, reason or "Not ready to prestige yet"
	end
	return true, home
end

local function openPanel(player, panelId, args)
	if not player or not player.Parent then
		return false
	end
	if not openPanelRemote then
		local ok, remote = pcall(Remotes.Get, "OpenPanel")
		if ok then
			openPanelRemote = remote
		end
	end
	if not openPanelRemote then
		return false
	end
	local ok = pcall(function()
		openPanelRemote:FireClient(player, panelId, args)
	end)
	return ok
end

-- E on the Prestige pad. A prestige resets the whole build and all Cash, so one press never does it: the pad opens
-- the Home window on its prestige confirmation ("Starts over / You keep / You get"), and only that window's confirm
-- button (HomeAction "Prestige") prestiges. ok | false, reason
local function askPrestige(player)
	local ok, reason = prestigeCheck(player)
	if not ok then
		return false, reason
	end
	if not openPanel(player, "Home", { Action = "Prestige" }) then
		return false, "Open the Home window to prestige"
	end
	return true
end

function TycoonService.Prestige(player)
	local ready, homeOrReason = prestigeCheck(player)
	if not ready then
		return false, homeOrReason
	end
	local home = homeOrReason
	local stars = starsOf(home) + 1
	local gems = 0
	if type(catalog.PrestigeGems) == "function" then
		local okG, g = pcall(catalog.PrestigeGems, stars)
		if okG and isFinite(g) and g > 0 then
			gems = math.floor(g)
		end
	end

	-- reset the stations (decor kept, the Garden back at its ResetLevel), the bank, +1 star; then Cash to 0 and the
	-- gems: one non-yielding step (MutateHome itself drops LegacySlots / LegacyPrices when Prestige rises)
	local wrote = mutateHome(player, function(live)
		if starsOf(live) ~= stars - 1 or not catalog.CanPrestige(live) then
			return false
		end
		if type(live.Stations) ~= "table" then
			live.Stations = {}
		end
		local keep = catalog.StationsAfterPrestige(live.Stations)
		local ids = {}
		for id in pairs(live.Stations) do
			ids[#ids + 1] = id
		end
		for _, id in ipairs(ids) do
			live.Stations[id] = keep[id] -- in place: Home.Rooms stays the same table
		end
		for id, level in pairs(keep) do
			live.Stations[id] = level
		end
		live.Prestige = stars
		live.CollectorCash = 0
		live.Level = homeLevelOf(live)
		if offlineDone[player] then
			live.LastSeen = os.time()
		end
		return true
	end)
	if not wrote then
		return false, "Could not prestige right now"
	end
	local cash = math.floor(getCash(player))
	if cash > 0 then
		dataService.SpendCash(player, cash)
	end
	if gems > 0 and type(dataService.AddGems) == "function" then
		dataService.AddGems(player, gems)
	end
	-- the running training jobs keep going (3.7) but the Cash paid into them went with the old run: a Stop after the
	-- prestige refunds nothing (otherwise Cash parked in training would carry over the reset)
	if type(dataService.MutateGrowth) == "function" then
		dataService.MutateGrowth(player, function(growth)
			for _, entry in pairs(growth) do
				if type(entry) == "table" and type(entry.Job) == "table" then
					entry.Job.Paid = 0
				end
			end
			return true
		end)
	end

	Coins.reset(player, 0) -- the coins on the lawn are gone with the bank
	local after = getHome(player)
	if after then
		syncPlot(player, after)
	end
	local mult = 1
	if type(catalog.PrestigeMultiplier) == "function" then
		mult = catalog.PrestigeMultiplier(stars)
	end
	local text = "Prestige " .. stars .. "! Coins x" .. multiplierText(mult) .. " forever"
	if gems > 0 then
		text = text .. ", +" .. gems .. " Gems"
	end
	notify(player, text .. ".", "good", 6)
	local open = gardenSlots(after or home)
	if open > 0 then
		notify(player, "Garden place " .. open .. " unlocked!", "good", 6)
	end
	local fusionAt = catalog.Prestige and tonumber(catalog.Prestige.FusionUnlock) or 1
	if stars == fusionAt then
		notify(player, "Fusion Machine unlocked at your home!", "good", 6)
	end
	TycoonService.Prestiged:Fire(player, stars)
	TycoonService.HomeChanged:Fire(player)
	return true, stars
end

----------------------------------------------------------------------
-- Garden
----------------------------------------------------------------------

local function wholeSlot(slot)
	if type(slot) ~= "number" or slot ~= slot or slot == math.huge or slot == -math.huge then
		return nil
	end
	if slot ~= math.floor(slot) or slot < 1 or slot > MAX_SLOT then
		return nil
	end
	return slot
end

-- "2:10" of a training job's remaining time (DataService.GetGrowth(player, key).Job.Ends is server os.time())
local function trainingLeftText(player, key)
	if dataService and type(dataService.GetGrowth) == "function" then
		local ok, growth = pcall(dataService.GetGrowth, player, key)
		local job = ok and type(growth) == "table" and growth.Job
		local ends = type(job) == "table" and tonumber(job.Ends)
		if isFinite(ends) then
			local left = math.max(0, math.floor(ends - os.time()))
			return string.format("%d:%02d", math.floor(left / 60), left % 60)
		end
	end
	return nil
end

-- { [key] = true } of the caller's keys in a running battle or ring run (BattleService.KeysInBattle when it exists).
local function keysInBattle(player)
	if battleService and type(battleService.KeysInBattle) == "function" then
		local ok, set = pcall(battleService.KeysInBattle, player)
		if ok and type(set) == "table" then
			return set
		end
	end
	return {}
end

function TycoonService.GardenSet(player, slot, key)
	if not initialized or not catalog then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	slot = wholeSlot(slot)
	if not slot then
		return false, "Unknown garden slot"
	end
	if key == "" or key == false then
		key = nil
	end
	if key ~= nil and not validKeyString(key) then
		return false, "Unknown pet"
	end
	local home = getHome(player)
	if not home then
		return false, "Your home is still loading..."
	end
	-- (clearing works on any slot: a key resting above the open count can always be taken out)
	if key ~= nil and slot > gardenSlots(home) then
		if gardenSlots(home) <= 0 then
			return false, "Build the Pet Garden first"
		end
		return false, "Garden place locked: Prestige to open it"
	end
	local profile = getProfile(player)
	local def = nil
	if key ~= nil then
		local tier, why
		def, tier, why = petDefOf(key, profile)
		if not def then
			return false, why or "Unknown pet"
		end
		local name = tostring(def.DisplayName or def.Name or key)
		if trainingKeys(player)[key] then
			local left = trainingLeftText(player, key)
			return false, name .. " is training" .. (left and (" (" .. left .. " left)") or "")
		end
		if keysInBattle(player)[key] then
			return false, "Finish your battle first!"
		end
	end

	local why = nil
	local wrote = mutateHome(player, function(live)
		if key ~= nil and slot > gardenSlots(live) then
			why = "Garden place locked: Prestige to open it"
			return false
		end
		if type(live.Garden) ~= "table" then
			live.Garden = {}
		end
		if key == nil then
			if live.Garden[slot] == nil then
				return false
			end
			live.Garden[slot] = nil
			return true
		end
		if live.Garden[slot] == key then
			return false
		end
		local uses = 1
		for s, k in pairs(live.Garden) do
			if s ~= slot and k == key then
				uses = uses + 1
			end
		end
		if uses > ownedCount(profile, key) then
			why = "You have no free copy of that pet"
			return false
		end
		live.Garden[slot] = key
		if offlineDone[player] then
			live.LastSeen = os.time()
		end
		return true
	end)
	if not wrote then
		if why then
			return false, why
		end
		return true, nil -- nothing to change (already there / already empty)
	end
	if plots[player] then
		local after = getHome(player)
		if after then
			local income, _, valid, entries = incomeOf(player, after)
			local st = Coins.ensure(player)
			Coins.followKeys(st, valid, Coins.serverNow(), Coins.cycle(), gardenSlots(after)) -- X5 / Y8: the epoch rule, right away
			syncPlot(player, after, income, valid, entries)
		end
	end
	if key ~= nil then
		local name = (def and (def.DisplayName or def.Name)) or key
		notify(player, tostring(name) .. " is working in your Garden!", "good", 3)
	end
	TycoonService.HomeChanged:Fire(player)
	return true, nil
end

----------------------------------------------------------------------
-- Public reads
----------------------------------------------------------------------

function TycoonService.GetPlot(player)
	local index = player and plots[player]
	if index then
		return plotInfo(index)
	end
	return nil
end

function TycoonService.GetHome(player)
	return getHome(player)
end

function TycoonService.IncomePerSecond(player)
	local home = getHome(player)
	if not home then
		return 0, { Food = 0, Pets = 0, Lucky = 1, Multiplier = 1 }
	end
	local income, parts = incomeOf(player, home)
	return income, parts
end

-- The seconds of coins a place's pile holds (Coin Magnet + Vault; Coins.BasePileSeconds without a Magnet).
function TycoonService.PileSeconds(player)
	local home = getHome(player)
	if not home or not catalog or type(catalog.PileSeconds) ~= "function" then
		return catalog and catalog.Coins and catalog.Coins.BasePileSeconds or 0
	end
	return catalog.PileSeconds(home)
end
TycoonService.CollectorCap = TycoonService.PileSeconds -- Phase 3 name, kept one release

-- The whole Cash waiting on the lawn (the bank: live piles + the Welcome-back pile).
function TycoonService.CoinsWaiting(player)
	local home = getHome(player)
	if not home then
		return 0
	end
	return math.floor(bankOf(home))
end

-- The drops on the lawn (a copy of the session ledger, slot then cycle order): { { Slot, Cycle, Position, Value,
-- Lucky, Poops, Stage } } (nil without a plot). Drops of a fraction left by a scoop (Poops 0) are included.
function TycoonService.Drops(player)
	local index = player and plots[player]
	local st = index and Coins.state[player]
	if not st then
		return nil
	end
	local slots = {}
	for slot in pairs(st.Drops) do
		slots[#slots + 1] = slot
	end
	table.sort(slots)
	local out = {}
	for _, slot in ipairs(slots) do
		for _, d in ipairs(st.Drops[slot]) do
			out[#out + 1] = {
				Slot = slot,
				Cycle = d.Cycle,
				Position = Coins.worldPoint(st, index, d.X, d.Z),
				Value = d.Value,
				Lucky = d.Lucky == true,
				Poops = d.Poops or 0,
				Stage = Coins.stageOf(d.Poops),
			}
		end
	end
	return out
end

-- Per-slot sums of the drops (the Phase 4 shape, kept): { [slot] = { Coins (= poops), Value, Lucky, Full (= napping),
-- Pos (the first drop) }, W = { Value, Pos } } (nil without a plot).
function TycoonService.Piles(player)
	local index = player and plots[player]
	local st = index and Coins.state[player]
	if not st then
		return nil
	end
	local out = {}
	for slot, list in pairs(st.Drops) do
		if #list > 0 then
			local sum = { Coins = 0, Value = 0, Lucky = false, Full = st.Nap[slot] ~= nil, Pos = nil }
			for _, d in ipairs(list) do
				sum.Coins = sum.Coins + (d.Poops or 0)
				sum.Value = sum.Value + d.Value
				if d.Lucky then
					sum.Lucky = true
				end
				if not sum.Pos then
					sum.Pos = Coins.worldPoint(st, index, d.X, d.Z)
				end
			end
			out[slot] = sum
		end
	end
	for slot in pairs(st.Nap) do
		if not out[slot] then
			out[slot] = { Coins = 0, Value = 0, Lucky = false, Full = true, Pos = nil }
		end
	end
	out.W = { Value = st.Welcome, Pos = Coins.welcomePoint(st, index) }
	return out
end

-- The developer reset: the bank and every pile to 0 (the Home itself was reset by DataService.ResetFields).
function TycoonService.ClearCoins(player)
	if not isPlayer(player) then
		return false
	end
	mutateHome(player, function(live)
		live.CollectorCash = 0
		return true
	end)
	if plots[player] then
		Coins.reset(player, 0)
		local home = getHome(player)
		if home then
			syncPlot(player, home)
		end
	elseif Coins.state[player] then
		Coins.reset(player, 0)
	end
	return true
end

----------------------------------------------------------------------
-- The home portal (3.10)
----------------------------------------------------------------------

-- The reason a portal may not open / be used right now, or nil (in order: match, battle, portal party, dead).
function Portal.refuse(player)
	if player:GetAttribute(Config.Attr.InMatch) == true then
		return "Finish your match first"
	end
	local inBattle = player:GetAttribute(ATTR_IN_BATTLE)
	if (inBattle ~= nil and inBattle ~= false and inBattle ~= "") or (battleService and type(battleService.IsInBattle) == "function" and battleService.IsInBattle(player) == true) then
		return "Finish your battle first!"
	end
	if player:GetAttribute(Portal.ATTR_LOCKED) ~= nil then
		return "Leave the portal party first"
	end
	local humanoid = Util.GetHumanoid(player)
	if not humanoid or humanoid.Health <= 0 or not Util.GetRoot(player) then
		return "You cannot open a portal right now"
	end
	return nil
end

-- Where the portal opens: 6 studs ahead on the ground (raycasts stop 1.5 studs before a wall and find the floor;
-- with no floor ahead the character's own spot). Returns pos (Vector3), yaw (degrees).
function Portal.place(player)
	local root = Util.GetRoot(player)
	local char = player.Character
	if not root or not char then
		return nil
	end
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	else
		flat = flat.Unit
	end
	local yaw = math.deg(math.atan2(-flat.X, -flat.Z))
	local origin = root.Position
	local params = nil
	pcall(function()
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { char }
		params.RespectCanCollide = true
	end)
	local function cast(from, dir)
		local ok, hit = pcall(function()
			return workspace:Raycast(from, dir, params)
		end)
		if ok and hit then
			return hit
		end
		return nil
	end
	local ahead = Portal.AHEAD
	local wall = cast(origin, flat * ahead)
	if wall then
		ahead = math.max(0, wall.Distance - Portal.WALL_GAP)
	end
	local at = origin + flat * ahead
	local floor = cast(at + Vector3.new(0, 2, 0), Vector3.new(0, -Portal.DROP, 0))
	if floor then
		return floor.Position, yaw
	end
	local under = cast(origin + Vector3.new(0, 1, 0), Vector3.new(0, -Portal.DROP, 0))
	if under then
		return under.Position, yaw
	end
	return origin - Vector3.new(0, 3, 0), yaw
end

function Portal.close(player)
	Portal.open[player] = nil
	if typeof(player) == "Instance" and player.Parent then
		pcall(function()
			player:SetAttribute(Config.Attr.HomePortal, nil)
		end)
	end
end

-- Opens the player's home portal (one per player; pressing again keeps the open one). ok | false, reason.
function Portal.openFor(player)
	if not initialized or not spotService or type(spotService.Teleport) ~= "function" then
		return false, "Homes are not ready yet"
	end
	if not isPlayer(player) then
		return false, "Not in the game"
	end
	local reason = Portal.refuse(player)
	if reason then
		toastOnce(player, reason, "bad")
		return false, reason
	end
	local rec = Portal.open[player]
	if rec and os.clock() < rec.ClosesAt then
		return true, nil -- the open portal stays
	end
	if not plots[player] then
		local target = nil
		if type(spotService.SuggestSpot) == "function" then
			local okS, suggested = pcall(spotService.SuggestSpot, player)
			target = okS and suggested or nil
		end
		if not target then
			toastOnce(player, "Every home is taken right now.", "bad")
			return false, "Every home is taken right now."
		end
	end
	if not cooldown(player, "GoHome", Portal.COOLDOWN) then
		return false, "Wait a moment"
	end
	local pos, yaw = Portal.place(player)
	if typeof(pos) ~= "Vector3" then
		return false, "You cannot open a portal right now"
	end
	local closesAt = workspace:GetServerTimeNow() + Portal.OPEN_SECONDS
	Portal.open[player] = { Pos = pos, Yaw = yaw, ClosesAt = os.clock() + Portal.OPEN_SECONDS }
	pcall(function()
		player:SetAttribute(Config.Attr.HomePortal, string.format("%.2f,%.2f,%.2f,%.1f,%.3f", pos.X, pos.Y, pos.Z, yaw, closesAt))
	end)
	return true, nil
end

-- The owner walked in: SpotService.Teleport (home, or the suggested free gate), PortalArrived, PortalUsed.
function Portal.enter(player)
	if Portal.refuse(player) then
		Portal.close(player)
		return false
	end
	local hadHome = plots[player] ~= nil
	local ok, moved = pcall(spotService.Teleport, player)
	Portal.close(player)
	if not ok or moved ~= true then
		if not hadHome then
			toastOnce(player, "Every home is taken right now.", "bad")
		end
		return false
	end
	pcall(function()
		player:SetAttribute(Config.Attr.PortalArrived, workspace:GetServerTimeNow())
	end)
	if not hadHome then
		notify(player, "Press E at the gate to claim this home!", "info", 4)
	end
	TycoonService.PortalUsed:Fire(player)
	return true
end

-- The 0.2 s pass: expiry, and ONLY the owner's root against their own portal point.
function Portal.tick()
	local now = os.clock()
	for player, rec in pairs(Portal.open) do
		if not player.Parent or departed[player] or now >= rec.ClosesAt then
			Portal.close(player)
		else
			local root = Util.GetRoot(player)
			if root then
				local d = root.Position - rec.Pos
				if math.sqrt(d.X * d.X + d.Z * d.Z) <= Portal.ENTER_RADIUS and math.abs(d.Y) <= Portal.ENTER_HEIGHT then
					local ok, err = pcall(Portal.enter, player)
					if not ok then
						warn("[TycoonService] portal failed: " .. tostring(err))
						Portal.close(player)
					end
				end
			end
		end
	end
end

function Portal.loop()
	while running do
		task.wait(Portal.TICK)
		if not running then
			break
		end
		local ok, err = pcall(Portal.tick)
		if not ok then
			warn("[TycoonService] portal pass failed: " .. tostring(err))
		end
	end
end

function TycoonService.OpenHomePortal(player)
	return Portal.openFor(player)
end

function TycoonService.GoHome(player)
	return Portal.openFor(player)
end

----------------------------------------------------------------------
-- Profile load: offline coins into the bank, LastSeen
----------------------------------------------------------------------

local function touchLastSeen(player)
	lastSeenAt[player] = os.clock()
	local now = os.time()
	mutateHome(player, function(live)
		live.LastSeen = now
		return true
	end)
end

-- Runs once per session when the home is readable (profile loaded and not provisional); again on ProfileRebased.
local function onHomeLoaded(player)
	if not isPlayer(player) then
		return
	end
	local home = getHome(player)
	if not home then
		return -- not loaded yet / provisional: ProfileRebased brings us back
	end
	if offlineDone[player] then
		if plots[player] then
			-- the save was rebased (recovered or merged): the ledger is rebuilt from the merged bank (X4)
			Coins.reset(player, bankOf(home))
			syncPlot(player, home)
			TycoonService.HomeChanged:Fire(player)
		end
		return
	end
	offlineDone[player] = true
	local now = os.time()
	local last = tonumber(home.LastSeen) or 0
	local amount, away = 0, 0
	if isFinite(last) and last > 0 and now > last then
		away = now - last
		local income = incomeOf(player, home)
		local ok, value = pcall(catalog.OfflineEarnings, home, away, income)
		if ok and isFinite(value) and value >= 1 then
			amount = math.floor(value)
		end
	end
	lastSeenAt[player] = os.clock() -- the periodic refresh takes over from here
	if amount < 1 and isFinite(last) and last > 0 then
		return -- nothing paid: the stored LastSeen may stay until the first refresh (no needless write)
	end
	-- (a home seen for the first time - a new or migrated save - gets its LastSeen right away)
	-- the offline coins go INTO the bank (the Welcome-back pile) in the same step as the new LastSeen: a second load
	-- can never pay the same absence again (X6)
	local wrote = mutateHome(player, function(live)
		live.LastSeen = now
		if amount >= 1 then
			live.CollectorCash = bankOf(live) + amount
		end
		return true
	end)
	local berries = 0
	if wrote and amount >= 1 then
		-- the offline coins also grow their berries (offline x Share, the basket cap ignored), in the same step
		local share = catalog.Berries and tonumber(catalog.Berries.Share) or 0
		berries = math.floor(amount * share)
		if berries >= 1 and type(dataService.AddBerries) == "function" then
			local okB, gave = pcall(dataService.AddBerries, player, berries)
			if not okB or gave ~= true then
				berries = 0
			end
		end
	end
	if wrote and amount >= 1 then
		if plots[player] then
			local after = getHome(player)
			if after then
				Coins.reset(player, bankOf(after))
				syncPlot(player, after)
			end
		end
		task.delay(OFFLINE_TOAST_DELAY, function()
			local extra = berries >= 1 and (" and " .. tostring(berries) .. " berries") or ""
			notify(player, "Welcome back! Your pets made " .. money(amount) .. extra .. " while you were away: scoop it in your garden!", "good", 7)
		end)
	end
end

local function watchPlayer(player)
	if watching[player] or offlineDone[player] then
		return
	end
	watching[player] = true
	task.spawn(function()
		local waited = 0
		while isPlayer(player) and not offlineDone[player] and waited < PROFILE_WAIT do
			if getHome(player) then
				onHomeLoaded(player)
				break
			end
			task.wait(0.5)
			waited = waited + 0.5
		end
		watching[player] = nil
	end)
end

local function forget(player)
	plots[player] = nil
	lastTick[player] = nil
	lastSeenAt[player] = nil
	offlineDone[player] = nil
	watching[player] = nil
	cooldowns[player] = nil
	budgets[player] = nil
	toastAt[player] = nil
	Coins.state[player] = nil
	Portal.open[player] = nil
	Coins.welcomedP5[player] = nil
end

-- (LastSeen is not written here: the periodic refresh keeps it within LASTSEEN_EVERY of the leave and the offline pay
-- only starts after 120 s, so the leave save gains nothing from it. A write here would be saved, though: DataService's
-- leave save runs after the other PlayerRemoving handlers.)
local function onPlayerRemoving(player)
	departed[player] = true
	TycoonService.Release(player)
	forget(player)
end

----------------------------------------------------------------------
-- The coin tick (1 s): meals into the piles and the bank, the plot attributes
----------------------------------------------------------------------

local function tickPlayer(player, index, now)
	local last = lastTick[player] or now
	local dt = math.max(0, math.min(now - last, MAX_TICK_DT))
	lastTick[player] = now
	local home = getHome(player)
	if not home then
		return
	end
	local income, _, valid, entries = incomeOf(player, home)
	local st = Coins.ensure(player)
	local sNow = Coins.serverNow()
	Coins.followKeys(st, valid, sNow, Coins.cycle(), gardenSlots(home))
	if dt > 0 then
		local added, drops = Coins.poops(st, home, entries, valid, sNow, Coins.seedOf(player))
		if added > 0 then
			-- the bank takes the new coins and the basket its berries in ONE non-yielding step per tick
			local wrote = mutateHome(player, function(live)
				live.CollectorCash = bankOf(live) + added
				return true
			end)
			if wrote then
				Coins.applyDrops(st, drops)
				home.CollectorCash = bankOf(home) + added
				Coins.berries(player, st, home, income, added)
			end
		end
	end
	if st.DropsDirty and st.DropsAt and now - st.DropsAt >= Coins.DROPS_WRITE_GAP then
		st.DropsAt = nil -- the throttled CoinDrops write lands now (syncPlot -> Coins.show)
	end
	if syncPlot(player, home, income, valid, entries) then
		TycoonService.HomeChanged:Fire(player) -- another module changed the stations (rebase, dev reset)
	end
end

local function tickAll()
	local now = os.clock()
	for player, index in pairs(plots) do
		if player.Parent and not departed[player] then
			local ok, err = pcall(tickPlayer, player, index, now)
			if not ok then
				warn("[TycoonService] coin tick failed: " .. tostring(err))
			end
		else
			TycoonService.Release(player)
			forget(player)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if offlineDone[player] and now - (lastSeenAt[player] or 0) >= LASTSEEN_EVERY then
			touchLastSeen(player)
		end
	end
end

local function tickLoop()
	while running do
		task.wait(TICK)
		if not running then
			break
		end
		local ok, err = pcall(tickAll)
		if not ok then
			warn("[TycoonService] tick failed: " .. tostring(err))
		end
	end
end

----------------------------------------------------------------------
-- Prompts (one ProximityPromptService listener: prompts HomeBuilder rebuilds keep working)
----------------------------------------------------------------------

local function attrUp(inst, name, depth)
	local node = inst
	for _ = 1, depth or 10 do
		if typeof(node) ~= "Instance" or node == workspace or node == game then
			return nil
		end
		local v = node:GetAttribute(name)
		if v ~= nil then
			return v
		end
		node = node.Parent
	end
	return nil
end

-- The plot a prompt belongs to: its SpotIndex attribute (prompt or an ancestor), else the spot folder it is in.
local function plotIndexOf(inst)
	local index = attrUp(inst, "SpotIndex")
	if validIndex(index) then
		return index
	end
	for i, info in pairs(spotList) do
		if typeof(info.Folder) == "Instance" and inst:IsDescendantOf(info.Folder) then
			return i
		end
	end
	return nil
end

local function stationIdOf(prompt)
	local id = attrUp(prompt, "StationId", 6)
	if type(id) == "string" then
		return id
	end
	local node = prompt.Parent
	for _ = 1, 6 do
		if typeof(node) ~= "Instance" then
			break
		end
		local name = node.Name
		local padId = type(name) == "string" and name:match("^Pad_(.+)$")
		if padId then
			return padId
		end
		node = node.Parent
	end
	return nil
end

local function onBuyPrompt(player, prompt)
	local index = plots[player]
	if not index then
		return
	end
	local owner = attrUp(prompt, "OwnerUserId", 6)
	if owner ~= nil and owner ~= player.UserId then
		return -- someone else's pad (their prompts are disabled locally; never trust a stray trigger)
	end
	local promptPlot = plotIndexOf(prompt)
	if promptPlot ~= index then
		return
	end
	local stationId = stationIdOf(prompt)
	if type(stationId) ~= "string" then
		return
	end
	if not cooldown(player, "Buy", BUY_COOLDOWN) or not spend(player) then
		return
	end
	local ok, reason
	if stationId == "Prestige" then
		ok, reason = askPrestige(player) -- opens the confirmation; nothing resets here
	else
		ok, reason = TycoonService.Buy(player, stationId)
	end
	if not ok then
		toastOnce(player, reason or "Not available yet", "bad")
	end
end

local function onPromptTriggered(prompt, player)
	if typeof(prompt) ~= "Instance" or not isPlayer(player) then
		return
	end
	local name = prompt.Name
	if name == "ClaimPrompt" then
		local index = attrUp(prompt, "SpotIndex", 8)
		if not validIndex(index) then
			index = plotIndexOf(prompt)
		end
		if validIndex(index) then
			onClaimPrompt(player, index, prompt)
		end
	elseif name == "BuyPrompt" then
		onBuyPrompt(player, prompt)
	end
end

----------------------------------------------------------------------
-- Remote HomeAction(action, arg)
----------------------------------------------------------------------

local function gardenArgs(arg)
	if type(arg) ~= "table" then
		return nil, nil
	end
	local slot = arg.Slot
	local key = arg.Key
	if slot == nil then
		slot = arg[1]
	end
	if key == nil then
		key = arg[2]
	end
	return slot, key
end

local function onHomeAction(player, action, arg)
	if not isPlayer(player) or type(action) ~= "string" or #action > MAX_ACTION_LENGTH then
		return
	end
	if not spend(player) then
		return
	end
	if action == "Upgrade" then
		if type(arg) ~= "string" or #arg > MAX_ID_LENGTH or not cooldown(player, "Buy", BUY_COOLDOWN) then
			return
		end
		local ok, reason = TycoonService.Buy(player, arg)
		if not ok then
			toastOnce(player, reason or "Not available yet", "bad")
		end
	elseif action == "GardenSet" then
		if not cooldown(player, "Garden", GARDEN_COOLDOWN) then
			return
		end
		local slot, key = gardenArgs(arg)
		local ok, reason = TycoonService.GardenSet(player, slot, key)
		if not ok then
			toastOnce(player, reason or "You cannot place that pet", "bad")
		end
	elseif action == "Collect" then
		if not cooldown(player, "Collect", COLLECT_COOLDOWN) then
			return
		end
		local ok, reason = TycoonService.Collect(player, true)
		if not ok then
			toastOnce(player, reason or "Nothing to scoop yet", "info")
		end
	elseif action == "Prestige" then
		if not cooldown(player, "Prestige", PRESTIGE_COOLDOWN) then
			return
		end
		local ok, reason = TycoonService.Prestige(player)
		if not ok then
			toastOnce(player, reason or "Not ready to prestige yet", "bad")
		end
	elseif action == "GoHome" then
		Portal.openFor(player) -- its own 3 s cooldown and refusal toasts
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------

function TycoonService.Init(lobbyInfo, deps)
	if initialized then
		return
	end
	deps = deps or {}
	dataService = deps.DataService or requireModule(script.Parent, "DataService")
	petService = deps.PetService
	spotService = deps.SpotService or requireModule(script.Parent, "SpotService")
	battleService = deps.BattleService
	catalog = requireModule(Shared, "TycoonCatalog")
	homeRoam = requireModule(Shared, "HomeRoam")
	petKeys = requireModule(Shared, "PetKeys")
	petCatalog = requireModule(Shared, "PetCatalog")
	if not catalog then
		warn("[TycoonService] TycoonCatalog is missing: tycoon homes are disabled")
		return
	end
	if not dataService or type(dataService.MutateHome) ~= "function" then
		warn("[TycoonService] DataService has no Home API: tycoon homes are disabled")
		return
	end
	if not spotService or type(spotService.Claim) ~= "function" then
		warn("[TycoonService] SpotService cannot hand out plots: claiming is disabled")
	end
	initialized = true

	local list = lobbyInfo and lobbyInfo.Spots
	if type(list) == "table" then
		for index, info in pairs(list) do
			if type(index) == "number" and type(info) == "table" then
				spotList[index] = info
			end
		end
	end

	homeBuilder = requireModule(script.Parent, "HomeBuilder")
	if homeBuilder then
		hb("Init", lobbyInfo)
	else
		warn("[TycoonService] HomeBuilder is missing: plots get a plain claim prompt and no buildings")
	end
	local indices = {}
	for index in pairs(spotList) do
		indices[#indices + 1] = index
	end
	table.sort(indices)
	for _, index in ipairs(indices) do
		hb("PreparePlot", spotList[index])
	end
	local existing = nil
	if homeBuilder then
		local okScan, found = pcall(claimPromptsBySpot)
		existing = okScan and found or nil
	end
	for _, index in ipairs(indices) do
		local ok, err = pcall(ensureClaimPrompt, index, spotList[index], existing)
		if not ok then
			warn("[TycoonService] could not add a claim prompt: " .. tostring(err))
		end
	end

	ProximityPromptService.PromptTriggered:Connect(onPromptTriggered)
	local okRemote, remote = pcall(Remotes.Get, "HomeAction")
	if okRemote and remote then
		remote.OnServerEvent:Connect(onHomeAction)
	else
		warn("[TycoonService] HomeAction remote unavailable")
	end

	-- a plot released by SpotService itself (e.g. by another module) is cleared here too
	if spotService and spotService.Released and type(spotService.Released.Connect) == "function" then
		spotService.Released:Connect(function(player, index)
			if plotOwner[index] == player then
				local info = dropPlot(player, index)
				if info then
					TycoonService.Released:Fire(player, info)
				end
			end
		end)
	end

	if dataService.ProfileLoaded and type(dataService.ProfileLoaded.Connect) == "function" then
		dataService.ProfileLoaded:Connect(function(player)
			onHomeLoaded(player)
		end)
	end
	if dataService.ProfileRebased and type(dataService.ProfileRebased.Connect) == "function" then
		dataService.ProfileRebased:Connect(function(player)
			onHomeLoaded(player)
		end)
	end

	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player) -- players who joined before Init (PlayerService loads profiles first)
	end

	running = true
	task.spawn(tickLoop)
	task.spawn(Coins.loop)
	task.spawn(Portal.loop)
	game:BindToClose(function()
		running = false
		for _, player in ipairs(Players:GetPlayers()) do
			if offlineDone[player] then
				pcall(touchLastSeen, player)
			end
		end
	end)
end

return TycoonService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="863">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="864">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="865">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="866">
          <Properties>
            <string name="Name">ClientSettings</string>
            <string name="Source"><![CDATA[-- ClientSettings: the player's settings on the client (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2 / 7.3).
-- The saved values live in the profile (DataService, `Settings = { Music, Sfx, Gfx, Shake, SeenNotes, MouseLock }`) and
-- arrive through ProfileSync (State.Settings(); a key State does not know yet, like MouseLock, is read from the raw
-- ProfileSync payload, see rawSync); a change made here is applied locally AT ONCE (Changed fires) and sent to
-- the server with the remote SettingsSet(key, value) after a 0.4 s debounce (one send per key per burst of changes).
--
--   ClientSettings.Get(key)          -> the value (a local change first, then the synced profile, then the default)
--   ClientSettings.All()             -> { Music, Sfx, Gfx, Shake, SeenNotes, MouseLock } (a copy)
--   ClientSettings.Set(key, value)   -> bool  cleaned + clamped like the server does; false for junk / no change
--   ClientSettings.Changed           Util.Signal (key, value); fires on a local Set and when a sync changes a key
--   ClientSettings.Clean(key, value) -> value | nil   (the client copy of the server's validation)
--   ClientSettings.KEYS / DEFAULTS / DEBOUNCE
--
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local ClientSettings = {}

ClientSettings.KEYS = { "Music", "Sfx", "Gfx", "Shake", "SeenNotes", "MouseLock" }
ClientSettings.DEFAULTS = { Music = 6, Sfx = 8, Gfx = "Auto", Shake = true, SeenNotes = 0, MouseLock = false }
ClientSettings.GFX = { "Auto", "Low", "High" }
ClientSettings.DEBOUNCE = 0.4
ClientSettings.Changed = Util.Signal()

local St = {
	Local = {}, -- [key] = value set on this client (wins over the synced value)
	Pending = {}, -- [key] = the debounce thread of an unsent change
	Synced = nil, -- the last synced settings seen (State.Settings() + the raw keys State does not carry)
	Raw = nil, -- the Settings table of the last raw ProfileSync payload (see rawSync)
	RawHooked = false,
	State = nil, -- client/State (lazy; false when missing)
	Hooked = false,
}
ClientSettings._St = St

-- the server's rules (DataService.SetSetting): Music / Sfx whole 0..10, Gfx one of 3, Shake / MouseLock boolean,
-- SeenNotes whole 0..1000. Numbers are rounded and clamped here (a slider never sends 7.5); NaN / inf and wrong types give nil.
function ClientSettings.Clean(key, value)
	if key == "Music" or key == "Sfx" then
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return nil
		end
		return math.max(0, math.min(10, math.floor(value + 0.5)))
	elseif key == "SeenNotes" then
		if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
			return nil
		end
		return math.max(0, math.min(1000, math.floor(value + 0.5)))
	elseif key == "Gfx" then
		for _, name in ipairs(ClientSettings.GFX) do
			if value == name then
				return value
			end
		end
		return nil
	elseif key == "Shake" or key == "MouseLock" then
		if type(value) == "boolean" then
			return value
		end
		return nil
	end
	return nil
end

local function getState()
	if St.State == nil then
		St.State = false
		local client = script.Parent
		local module = client and client:FindFirstChild("State")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				St.State = mod
			end
		end
	end
	return St.State or nil
end

local function stateSettings()
	local State = getState()
	if State and type(State.Settings) == "function" then
		local ok, settings = pcall(State.Settings)
		if ok and type(settings) == "table" then
			return settings
		end
	end
	return nil
end

-- State's settings, with the keys it does not carry (an older State.lua drops MouseLock) taken from the raw payload
local function syncedSettings()
	local settings = stateSettings()
	local raw = St.Raw
	if not raw then
		return settings
	end
	local out = {}
	for _, key in ipairs(ClientSettings.KEYS) do
		local value = settings and settings[key]
		if value == nil then
			value = raw[key]
		end
		out[key] = value
	end
	return out
end

-- a sync that changed a key the player did not just change here: adopt it and tell the listeners
local function onSynced(settings)
	if type(settings) ~= "table" then
		return
	end
	local old = St.Synced or {}
	St.Synced = settings
	for _, key in ipairs(ClientSettings.KEYS) do
		local value = ClientSettings.Clean(key, settings[key])
		if value ~= nil and value ~= old[key] and St.Pending[key] == nil then
			-- the value the listeners saw so far (St.Synced is the new table already, so not ClientSettings.Get)
			local before = St.Local[key]
			if before == nil then
				before = ClientSettings.Clean(key, old[key])
				if before == nil then
					before = ClientSettings.DEFAULTS[key]
				end
			end
			St.Local[key] = nil
			if value ~= before then
				ClientSettings.Changed:Fire(key, value)
			end
		end
	end
end

-- the raw ProfileSync payload (a second listener next to State's): keeps the keys State.lua does not know
local function rawSync()
	if St.RawHooked then
		return
	end
	St.RawHooked = true
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "ProfileSync")
		if not (ok and remote and remote.OnClientEvent) then
			return
		end
		remote.OnClientEvent:Connect(function(snapshot)
			if type(snapshot) == "table" then
				St.Raw = type(snapshot.Settings) == "table" and snapshot.Settings or {} -- none: the defaults (like State)
				onSynced(syncedSettings())
			end
		end)
	end)
end

local function hook()
	if St.Hooked then
		return
	end
	St.Hooked = true
	local State = getState()
	if State and State.SettingsChanged and type(State.SettingsChanged.Connect) == "function" then
		State.SettingsChanged:Connect(function()
			onSynced(syncedSettings())
		end)
	end
	St.Synced = syncedSettings()
	rawSync()
end

function ClientSettings.Get(key)
	hook()
	local value = St.Local[key]
	if value ~= nil then
		return value
	end
	local settings = syncedSettings()
	if settings then
		value = ClientSettings.Clean(key, settings[key])
		if value ~= nil then
			return value
		end
	end
	return ClientSettings.DEFAULTS[key]
end

function ClientSettings.All()
	local out = {}
	for _, key in ipairs(ClientSettings.KEYS) do
		out[key] = ClientSettings.Get(key)
	end
	return out
end

local function send(key)
	St.Pending[key] = nil
	local value = St.Local[key]
	if value == nil then
		return
	end
	local ok, remote = pcall(Remotes.Get, "SettingsSet")
	if ok and remote then
		pcall(function()
			remote:FireServer(key, value)
		end)
	end
end

function ClientSettings.Set(key, value)
	hook()
	if ClientSettings.DEFAULTS[key] == nil then
		return false
	end
	local clean = ClientSettings.Clean(key, value)
	if clean == nil then
		return false
	end
	if key == "SeenNotes" and clean < (ClientSettings.Get("SeenNotes") or 0) then
		return false -- SeenNotes only goes up (the server refuses less)
	end
	if clean == ClientSettings.Get(key) and St.Pending[key] == nil then
		return false
	end
	St.Local[key] = clean
	ClientSettings.Changed:Fire(key, clean)
	local pending = St.Pending[key]
	if pending then
		pcall(task.cancel, pending)
	end
	St.Pending[key] = task.delay(ClientSettings.DEBOUNCE, send, key)
	return true
end

return ClientSettings
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="867">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="868">
            <Properties>
              <string name="Name">ArenaController</string>
              <string name="Source"><![CDATA[-- ArenaController (client, Phase 3, ui; Phase 5 dungeonclient W4): the battle windows and side cards of the Battle Arena
-- (ARCHITECTURE_V3.md "Phase 3: Pet battles", the "Phase 3 build contract", Phase 4 3.8 and the "Phase 5 build contract"
-- 3.7, 4.2, 5.3, 6.6, 10.5).
--
--   ArenaController.Init()
--   ArenaController.OpenArena(tab|nil)        the Arena panel: tab "Duels" | "Raid" | "Leaderboard" (OpenPanel("Arena",
--                                             {Tab}), the duel pads, the event board, the trophy board, the main gate)
--   ArenaController.OpenRing(start|nil, portal|nil)  Phase 4: the Champion Ring window (Portal_Ring's RingPrompt,
--                                             OpenPanel("Ring", {Start}))
--   ArenaController.Close()
--   Extras: ArenaController.IsOpen() -> bool, ArenaController.GetState() -> { Arena = last ArenaState, Lobby = last
--           BattleState "Lobby", Window = "Arena" | "Ring" | nil, Tab, RingStart }, ArenaController.Opened / Closed
--           (Util.Signal), ArenaController.Request(action, a, b) (sends BattleRequest like the buttons do: client-side
--           spacing, the server validates everything), ArenaController.StartRing() (the ring window's START),
--           ArenaController.RingInfo() -> { Best, Runs, Start, Starts, Board, Fighters, Source, Preview, Why }
--
-- Phase 5: the Trial window is gone (the Dungeon replaced it). Portal_Dungeon's DungeonPrompt (OpenPanel = "Dungeon") is
-- handed over to DungeonController.Open here, next to "Ring". Both windows are NeonKit side panels (640 x 860 design px,
-- NeonKit.Dock: docked right on landscape screens, a bottom sheet on portrait phones, no full-screen dimming; the hotbar
-- re-centres with HotbarController.SetAvoidRight). A challenge more than Duel.PracticeInvite apart carries
-- Practice = true: the invite says "Practice duel - no trophies or rewards". The Ring's fighter cards draw each pet's
-- stored evolution stage (State.PetStage -> CloudUI.PetViewport { Evolved }, a STAGE badge).
--
-- What the player sees
--   * Arena panel (OpenPanel = "Arena", OpenPanelTab = "Events" | "Leaderboard" | "Raid"; the duel pads carry
--     RingIndex / PadIndex): DUELS (the quick queue: Queue / Unqueue + the wait; challenge a player in the server:
--     Challenge(userId); incoming invites with Accept / Decline (the practice flag); the player's trophies and duel
--     record), BOSS RAID (the running raid: boss, element, HP, fighters, time left, JOIN / LEAVE; the next event with its
--     countdown; Double Rewards; which elements beat the boss; the reward tiers) and LEADERS (ArenaState.Leaderboard,
--     top 10, the player's own row highlighted).
--   * Champion Ring window (Portal_Ring's prompt, OpenPanel = "Ring"): the record "Best: Round N" and the runs, the best
--     of this server (Portal_Ring's RingBoard attribute, top 3), the start picker (round 1 or a boss round 10, 20 ...
--     already beaten), the start round's champion, "Next win: +$X +Y XP", the fighters the server will field (the battle
--     team, else the equipped pets, else the strongest pets; training pets skipped; evolved looks) and START / CONTINUE
--     -> BattleRequest("Ring", start). The server's refusal toasts also show in the footer. The Team screen gets a
--     "Champion Ring best: Round N" line from here. A side toast when the player crosses the arena's edge: "Battle
--     Arena: pets can battle here" / "Safe zone: no pet battles here".
--   * Side cards (right edge, above the hotbar, never in the screen centre; ScreenGui "NimbusArenaSide"): a duel
--     invite (BattleState "Lobby".Invites) with Accept / Decline and a draining timer, the invite the player sent,
--     the quick-queue status with Leave, the raid join card while a raid can be joined and the event countdown chip
--     ("Boss Raid in 1:45", "2x Rewards 29:12"). Countdowns tick locally between two ArenaState messages. All of it
--     hides in an obby match and while the player fights (attribute InBattle).
-- Remotes: BattleState ("Lobby" in), ArenaState (in), OpenPanel (in), Notify (in: ring refusals), BattleRequest (out:
-- Ring, Challenge, ChallengeReply, Queue, Unqueue, JoinRaid, LeaveRaid). Every request is spaced on the client too (K.FIRE_GAP).
-- One side panel at a time: opening one closes the menu windows, the Pet Index, the Fusion / Care windows, the Dungeon
-- window and the obby picker, and their opening closes this one. Esc / gamepad B / the red X close it; walking away from
-- the Ring portal closes the Ring window. Readability rule: everything is designed in 1080p pixels (body 19, captions
-- >= 18, buttons 22, titles 26-34) under ONE UIScale, so phones keep >= 14 px.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local State = require(Client:WaitForChild("State"))

-- other engineers' shared modules: optional, every use is guarded
local function optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[ArenaController] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetCatalog = optionalShared("PetCatalog")
local PetKeys = optionalShared("PetKeys")
local BattleCatalog = nil -- resolved on first use (see catalog())

local ArenaController = {}
ArenaController.Opened = Util.Signal()
ArenaController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- above NimbusMenu (20), the Pet Index (21) and the Fusion window (22)
	SIDE_ORDER = 12, -- side cards: above the HUD (10) and the hotbar (11), below the windows
	PREF_W = 640, -- Phase 5 (6.6): the Arena / Ring windows are NeonKit side panels of 640 x 860 design px
	PREF_H = 860,
	TALL = 760, -- windows narrower than this use the single-column layout (every docked window)
	NARROW = 1000,
	SHORT = 560, -- docked lower than this (landscape phones): the compact rows
	INSET_X = 24, -- the panel frame around Panel.Content (CloudUI.ContentInset)
	INSET_Y = 82,
	FIRE_GAP = 0.5, -- seconds between two sends of the same request
	RING_RANGE = 28, -- studs from the Champion Ring portal where START works (the server allows 30)
	WALK_AWAY = 70, -- studs from the portal that close a Ring window opened there
	ARENA_SLACK = 12, -- studs around the arena's bounding box that still count as "in the arena"
	SIDE_W = 340, -- side cards
	SIDE_BOTTOM = 112, -- design px above the bottom edge (clear of the hotbar's corner and the HUD)
	SIDE_BOTTOM_TOUCH = 210, -- touch screens: above Roblox's jump button
	SIDE_BOTTOM_PORTRAIT = 340, -- portrait phones: above the HUD's raised bottom-left block (vitals + currency)
	SIDE_MAX_CARDS = 3,
	SIDE_MAX_CARDS_SHORT = 1,
	ANNOUNCE = 120, -- seconds before an event when the countdown chip appears (BattleCatalog.Events.AnnounceSeconds)
	BACK_ACTION = "NimbusArenaBack",
	TICK = 0.25, -- seconds between two refreshes of the live numbers
	ATTR_IN_BATTLE = "InBattle", -- BattleService's attribute (the battle id while the player fights)
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local GOOD = Colors.Good
local BAD = Colors.Bad
local BUTTONS = Theme.Buttons or {}
local INSET = Color3.fromRGB(20, 30, 70)
local C = {
	Arena = Color3.fromRGB(214, 92, 96), -- the panels' accent (crimson)
	Practice = Color3.fromRGB(120, 196, 255), -- a practice duel (no trophies, no rewards)
	Power = Color3.fromRGB(255, 214, 110),
	GoodText = Color3.fromRGB(150, 236, 170),
	WarnText = Color3.fromRGB(255, 206, 120),
	BadText = Color3.fromRGB(255, 150, 150),
	Lock = Color3.fromRGB(255, 206, 120),
	Boss = Color3.fromRGB(226, 90, 92),
	Cleared = Color3.fromRGB(96, 196, 108),
	Next = Color3.fromRGB(90, 158, 234),
	Token = Colors.Token or GOLD,
	Gem = Colors.Gem or Color3.fromRGB(84, 196, 246),
	Double = Color3.fromRGB(150, 110, 232),
	Me = Color3.fromRGB(70, 110, 190),
	Medal = { Color3.fromRGB(246, 200, 70), Color3.fromRGB(200, 210, 226), Color3.fromRGB(214, 146, 92) },
}

-- glyphs as UTF-8 escapes (the source stays ASCII)
local G = {
	Swords = "\226\154\148",
	Trophy = "\240\159\143\134",
	Cloud = "\226\152\129",
	Gem = (Theme.Currency and Theme.Currency.Gems and Theme.Currency.Gems.Glyph) or "\226\151\134",
	Lock = "\240\159\148\146",
	Check = "\226\156\147",
	Crown = "\240\159\145\145",
	Clock = "\226\143\177",
	Star = "\226\152\133",
	Bullet = "\194\183",
	Heart = "\226\157\164",
	Skull = "\240\159\146\128",
	Double = "\226\156\150", -- heavy multiplication x
	Up = "\226\150\178",
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local U = {} -- gui references
local S = {
	Open = nil, -- "Arena" | "Ring" | nil
	Token = 0,
	Tab = "Duels",
	Arena = nil, -- last ArenaState
	ArenaAt = 0, -- os.clock() when it arrived
	Lobby = nil, -- last BattleState "Lobby"
	LobbyAt = 0,
	RingAt = nil, -- the portal part when the Champion Ring window was opened there
	BackBound = false,
	LastFire = {},
	Built = {},
	Tall = false,
	Narrow = false,
	Short = false,
	Warned = {},
	ArenaBox = nil, -- { CFrame, Size } of workspace.BattleArena (static, measured once)
}
local Win = {} -- per-window widget tables: Win.Arena, Win.Ring

local refreshOpen, refreshSide, screenFactor -- forward declarations

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[ArenaController] " .. key .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function catalog()
	if not BattleCatalog then
		BattleCatalog = optionalShared("BattleCatalog")
	end
	return BattleCatalog
end

local function makeFrame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

local function makeText(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Stroke = 0.25,
		StrokeColor = INK,
		Outline = 1.5,
		OutlineColor = INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

local function corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

local function round(parent)
	return Theme.Corner(parent, UDim.new(0.5, 0))
end

local function stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

local function pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function listLayout(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.ScrollBarThickness = 10
	p.ScrollBarImageColor3 = Colors.FrameTop or Colors.Cloud
	p.ScrollBarImageTransparency = 0.1
	p.Parent = parent
	return Util.Create("ScrollingFrame", p)
end

local function inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = INSET
	p.BackgroundTransparency = 0.42
	local frame = makeFrame(parent, name, p)
	corner(frame, 12)
	stroke(frame, Colors.WellEdge or NAVY, 3, 0.15)
	return frame
end

local function autoText(parent, name, text, role, size, color, order)
	return makeText(parent, name, text, role, size, color, {
		Size = UDim2.fromOffset(0, size + 8),
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = order or 0,
	})
end

local function wrapText(parent, name, text, role, size, color, order)
	return makeText(parent, name, text, role, size, color, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = order or 0,
	})
end

local function clearChildren(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function colorPill(parent, name, text, color, size, order)
	local dark = Theme.Darken(color, 0.62)
	local textSize = size or 18
	local pill = Theme.Label(text, "Heading", {
		Size = textSize,
		Color = WHITE,
		Stroke = 0.1,
		StrokeColor = dark,
		Outline = 1.5,
		OutlineColor = dark,
		Props = {
			Name = name,
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, textSize + 9),
			LayoutOrder = order or 0,
		},
	})
	round(pill)
	stroke(pill, NAVY, 2, 0)
	Theme.Gradient(pill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 206, 226), 90)
	pad(pill, 9, 0, 9, 1)
	pill.Parent = parent
	return pill
end

local function elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	return info and info.Color or Colors.PanelLight
end

local function elementPill(parent, element, size, order)
	return colorPill(parent, "Element_" .. tostring(element), tostring(element), elementColor(element), size, order)
end

local function commas(n)
	return Util.Commas(math.floor(tonumber(n) or 0))
end

local function clock(seconds)
	seconds = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	local h = math.floor(seconds / 3600)
	local m = math.floor((seconds % 3600) / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%d:%02d:%02d", h, m, s)
	end
	return string.format("%d:%02d", m, s)
end

local function tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

local function rarityColor(def)
	return CloudUI.RarityColor(def and def.Rarity)
end

local function rarityText(def)
	if def and def.Rarity == "Secret" then
		return Color3.fromRGB(196, 168, 255)
	end
	return Theme.Lighten(rarityColor(def), 0.3)
end

local function elementsOf(def)
	if type(def) ~= "table" then
		return {}
	end
	if PetCatalog and type(PetCatalog.ElementsOf) == "function" then
		local ok, list = pcall(PetCatalog.ElementsOf, def)
		if ok and type(list) == "table" then
			return list
		end
	end
	if type(def.Element) == "string" then
		return { def.Element }
	end
	return {}
end

----------------------------------------------------------------------
-- Game state readers
----------------------------------------------------------------------
local function attr(name)
	return LocalPlayer and LocalPlayer:GetAttribute(name) or nil
end

local function inMatch()
	return attr(Config.Attr.InMatch) == true
end

local function battleId()
	local id = attr((Config.Attr and Config.Attr.InBattle) or K.ATTR_IN_BATTLE)
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

local function battleData()
	if type(State.Battle) == "function" then
		local ok, b = pcall(State.Battle)
		if ok and type(b) == "table" then
			return b
		end
	end
	return { Trophies = 0, PvPWins = 0, PvPLosses = 0, Raids = 0 }
end

local function teamsData()
	if type(State.Teams) == "function" then
		local ok, t = pcall(State.Teams)
		if ok and type(t) == "table" and type(t.Presets) == "table" then
			return t
		end
	end
	return { Presets = { {}, {}, {} }, Active = 1, Slots = 3 }
end

-- the active preset as BattleCatalog entries { Def, Level, Key }
local function activeTeam()
	local teams = teamsData()
	local list = teams.Presets[teams.Active] or {}
	local out = {}
	for _, key in ipairs(list) do
		local def = nil
		if type(State.DefOf) == "function" then
			local ok, result = pcall(State.DefOf, key)
			if ok and type(result) == "table" then
				def = result
			end
		end
		if not def and PetCatalog and type(PetCatalog.Get) == "function" then
			def = PetCatalog.Get(key)
		end
		if def then
			local level = 1
			if type(State.PetLevel) == "function" then
				local ok, lv = pcall(State.PetLevel, key)
				if ok and type(lv) == "number" then
					level = lv
				end
			end
			out[#out + 1] = { Def = def, Level = level, Key = key }
		end
	end
	return out
end

local function teamPower(entries)
	local BC = catalog()
	if not BC or type(BC.TeamPower) ~= "function" then
		return 0
	end
	local ok, p = pcall(BC.TeamPower, entries)
	return ok and tonumber(p) or 0
end

local function petDef(petId, tier)
	if PetKeys and type(PetKeys.DefOf) == "function" and type(PetKeys.Make) == "function" and tier and tier ~= "Normal" then
		local ok, def = pcall(function()
			return PetKeys.DefOf(PetKeys.Make(petId, tier), nil)
		end)
		if ok and type(def) == "table" then
			return def
		end
	end
	if PetCatalog and type(PetCatalog.Get) == "function" then
		return PetCatalog.Get(petId)
	end
	return nil
end

-- seconds left of a countdown field of the last ArenaState, ticking locally
local function arenaSeconds(value)
	local n = tonumber(value)
	if not n then
		return nil
	end
	return math.max(0, n - (os.clock() - S.ArenaAt))
end

local function lobbySeconds(value)
	local n = tonumber(value)
	if not n then
		return nil
	end
	return math.max(0, n - (os.clock() - S.LobbyAt))
end

local function rootPosition()
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

local function arenaModel()
	return Workspace:FindFirstChild("BattleArena")
end

local function positionOf(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(function()
			return inst:GetBoundingBox()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- true / false when the arena is known, nil when it cannot be told (the server decides then)
local function inArena()
	local pos = rootPosition()
	local arena = arenaModel()
	if not pos or not arena or not arena:IsA("Model") then
		return nil
	end
	if not S.ArenaBox then
		local ok, cf, size = pcall(function()
			return arena:GetBoundingBox()
		end)
		if not ok or not cf then
			return nil
		end
		S.ArenaBox = { CFrame = cf, Size = size }
	end
	local rel = S.ArenaBox.CFrame:PointToObjectSpace(pos)
	local half = S.ArenaBox.Size / 2
	local m = K.ARENA_SLACK
	return math.abs(rel.X) <= half.X + m and math.abs(rel.Z) <= half.Z + m and rel.Y <= half.Y + 40 and rel.Y >= -half.Y - 40
end

----------------------------------------------------------------------
-- Requests (BattleRequest; spaced here, validated on the server)
----------------------------------------------------------------------
local requestRemote = nil

local function request(action, a, b)
	local now = os.clock()
	local key = action .. "|" .. tostring(a)
	if S.LastFire[key] and now - S.LastFire[key] < K.FIRE_GAP then
		return false
	end
	if not requestRemote then
		local ok, remote = pcall(Remotes.Get, "BattleRequest")
		if ok and remote then
			requestRemote = remote
		end
	end
	if not requestRemote then
		return false
	end
	S.LastFire[key] = now
	local ok, err = pcall(function()
		requestRemote:FireServer(action, a, b)
	end)
	if not ok then
		warnOnce("BattleRequest " .. action, err)
	end
	return ok
end

-- a short hint at the right edge (never in the screen centre), e.g. "Walk into the Battle Arena to duel!"
local function toast(text, kind)
	if not U.HintGui then
		return
	end
	S.HintToken = (S.HintToken or 0) + 1
	local mine = S.HintToken
	U.HintLabel.Text = tostring(text)
	U.HintFrame.BackgroundColor3 = (kind == "bad") and Color3.fromRGB(120, 40, 56) or Color3.fromRGB(28, 36, 78)
	U.HintFrame.Visible = true
	U.HintScale.Scale = screenFactor and screenFactor() or 1
	task.delay(2.8, function()
		if S.HintToken == mine and U.HintFrame then
			U.HintFrame.Visible = false
		end
	end)
end

local function otherController(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

local function openTeamWindow()
	local menu = otherController("MenuController")
	ArenaController.Close()
	if menu and type(menu.Open) == "function" then
		pcall(menu.Open, "Team", {})
	end
end

----------------------------------------------------------------------
-- Window frame (one CloudUI panel per window, both in the ScreenGui NimbusArena)
----------------------------------------------------------------------
local function guiArea()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

function screenFactor()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return Theme.ScreenFactor(vp.Y)
	end
	return Theme.ScreenFactor(guiArea().Y)
end

local function newWindow(id, title)
	local win = { Id = id }
	win.Holder = makeFrame(U.Gui, "Window_" .. id, {
		Size = UDim2.fromOffset(K.PREF_W, K.PREF_H),
		Visible = false,
		ZIndex = 3,
	})
	win.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = win.Holder })
	-- Phase 5 (6.6): docked right on landscape screens, a bottom sheet on portrait phones (NeonKit.Dock), no dimming
	win.Dock = NeonKit.Dock(win.Holder, win.Fit, K.PREF_W, K.PREF_H)
	win.Panel = CloudUI.Panel({
		Name = id .. "Panel",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Title = title,
		Closable = true,
		Category = (id == "Ring") and "Ring" or "Arena",
		OnClose = function()
			ArenaController.Close()
		end,
		Parent = win.Holder,
	})
	win.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = win.Panel.Root })
	Win[id] = win
	return win
end

-- the hotbar re-centres left of a docked window (HotbarController.SetAvoidRight; nil = no window)
local function avoidRight(x)
	local hb = otherController("HotbarController")
	if hb and type(hb.SetAvoidRight) == "function" then
		pcall(hb.SetAvoidRight, x)
	end
end

-- the docked size (design px) -> the window's own layout: every docked window is narrow ("tall" = one column);
-- "short" = a landscape phone (the window is lower than K.SHORT)
local function layoutWindow(win)
	if win.Dock and win.Dock.Refresh then
		win.Dock.Refresh()
	end
	local rect = win.Dock and win.Dock.Rect
	local w = rect and math.floor(rect.designW + 0.5) or K.PREF_W
	local h = rect and math.floor(rect.designH + 0.5) or K.PREF_H
	local tall = w < K.TALL
	S.Tall = tall
	S.Narrow = w < K.NARROW
	S.Short = h < K.SHORT
	if S.Open == win.Id then
		avoidRight(rect and rect.mode == "Side" and rect.x or nil)
	end
	if win.OnLayout and (win.W ~= w or win.H ~= h) then
		win.W, win.H = w, h
		safe("layout " .. win.Id, win.OnLayout, w, h, S.Narrow, S.Short, tall)
	end
end

----------------------------------------------------------------------
-- Champion Ring window (Phase 4, "Phase 4 build contract" 3.8): the record ("Best: Round N"), the best of this server
-- (Portal_Ring's RingBoard attribute), the start picker (round 1 or a boss round already beaten), the next round's
-- champion, the fighters with their power, "Next win: +$X +Y XP" and START -> BattleRequest("Ring", start). The
-- server decides everything again (StartRing); its refusal toasts also show in the window's footer. Every helper of
-- the ring lives in this one table (the file stays far under the 200-locals limit).
----------------------------------------------------------------------
local Ring = {
	Start = 1, -- the picked start round
	Pending = false, -- START was sent, no Start / refusal yet
	PendingAt = 0,
	Refusal = nil, -- the last ring refusal toast of the server (shown in the footer for a few seconds)
	RefusalAt = 0,
	LastZone = nil, -- safe-zone toast: true in the Battle Arena, false outside, nil unknown
	BattleAt = -100, -- os.clock() when the player last fought (no zone toast right after a battle's return teleport)
	CARD_H = 112, -- design px of a fighter card
	TILE_H = 66, -- design px of a start picker tile
}

-- the server's entry refusals (BattleService.StartRing; prefixes of its Notify texts)
Ring.REFUSALS = {
	"Claim your home first", "You need a pet", "Your pets are all training", "Walk to the Champion Ring portal",
	"Your save is still loading", "Start from round 1 or a boss round", "Every ring is busy", "Finish your obby match",
	"Leave the portal party", "You are already in a battle", "Wait until you respawn", "The server is restarting",
}

function Ring.cfg()
	local BC = catalog()
	return BC and type(BC.Ring) == "table" and BC.Ring or {}
end

function Ring.bossEvery()
	return math.max(1, math.floor(tonumber(Ring.cfg().BossEvery) or 10))
end

-- the record { Best, Runs } (State.Ring, synced by ProfileSync)
function Ring.record()
	local ok, r = pcall(function()
		return State.Ring()
	end)
	r = (ok and type(r) == "table") and r or {}
	return math.max(0, math.floor(tonumber(r.Best) or 0)), math.max(0, math.floor(tonumber(r.Runs) or 0))
end

function Ring.portal()
	local arena = arenaModel()
	local model = arena and arena:FindFirstChild("Portal_Ring", true) or nil
	if not model then
		model = Workspace:FindFirstChild("Portal_Ring", true)
	end
	return model
end

-- where the distance is measured to: the part the prompt sat on, else Portal_Ring's PortalPad (or the model)
function Ring.anchor()
	if S.RingAt and S.RingAt.Parent then
		return S.RingAt
	end
	local model = Ring.portal()
	return model and (model:FindFirstChild("PortalPad", true) or model) or nil
end

function Ring.distance()
	local pos = rootPosition()
	local at = positionOf(Ring.anchor())
	if not pos or not at then
		return nil
	end
	local d = pos - at
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

-- "Alex|31;Sam|24;Kim|20" (written by BattleService on Portal_Ring and its pad) -> { { Name, Round }... } best first
function Ring.board()
	local model = Ring.portal()
	local text = model and model:GetAttribute("RingBoard") or nil
	if type(text) ~= "string" or text == "" then
		local pad = model and model:FindFirstChild("PortalPad", true)
		text = pad and pad:GetAttribute("RingBoard") or nil
	end
	local list = {}
	if type(text) == "string" then
		for entry in text:gmatch("[^;]+") do
			local name, round = entry:match("^(.-)|(%d+)$")
			round = tonumber(round)
			if name and name ~= "" and round and round > 0 then
				list[#list + 1] = { Name = name:gsub("[%c<>&]", ""), Round = math.floor(round) }
			end
		end
	end
	table.sort(list, function(a, b)
		if a.Round ~= b.Round then
			return a.Round > b.Round
		end
		return a.Name < b.Name
	end)
	while #list > 3 do
		table.remove(list)
	end
	return list
end

-- the start rounds the server accepts: 1 and every boss round already beaten (the latest seven of them)
function Ring.starts(best)
	local every = Ring.bossEvery()
	local out = { 1 }
	local top = math.floor(best / every)
	for k = math.max(1, top - 6), top do
		out[#out + 1] = k * every
	end
	return out
end

function Ring.training(key)
	if type(State.IsTraining) ~= "function" then
		return false
	end
	local ok, busy = pcall(State.IsTraining, key)
	return ok and busy == true
end

-- a pet key as a BattleCatalog entry { Def, Level, Key, Evo, Train, Power }, or nil
function Ring.entryOf(key)
	local def = nil
	if type(State.DefOf) == "function" then
		local ok, result = pcall(State.DefOf, key)
		if ok and type(result) == "table" then
			def = result
		end
	end
	if not def and PetCatalog and type(PetCatalog.Get) == "function" then
		def = PetCatalog.Get(key)
	end
	if not def then
		return nil
	end
	local level = 1
	if type(State.PetLevel) == "function" then
		local ok, lv = pcall(State.PetLevel, key)
		if ok and type(lv) == "number" then
			level = lv
		end
	end
	local okG, g = pcall(function()
		return State.PetGrowth(key)
	end)
	g = (okG and type(g) == "table") and g or {}
	local entry = {
		Def = def,
		Level = level,
		Key = key,
		Evo = tonumber(g.Evo) or 0,
		Train = { Speed = g.Speed or 0, Physique = g.Physique or 0, Ability = g.Ability or 0, Defense = g.Defense or 0 },
		Power = 0,
	}
	local BC = catalog()
	if BC and type(BC.UnitPower) == "function" then
		local ok, p = pcall(BC.UnitPower, entry)
		entry.Power = ok and tonumber(p) or 0
	end
	return entry
end

function Ring.collect(keys)
	local out = {}
	for _, key in ipairs(type(keys) == "table" and keys or {}) do
		if type(key) == "string" and not Ring.training(key) then
			local entry = Ring.entryOf(key)
			if entry then
				out[#out + 1] = entry
			end
		end
	end
	return out
end

function Ring.ownedKeys()
	local ok, keys = pcall(State.Keys)
	return (ok and type(keys) == "table") and keys or {}
end

-- the fighters the server will pick (contract 3.8): the active team (training pets skipped), else the equipped pets,
-- else the best owned pets by power (up to the team slots); and where they came from ("team" | "equipped" | "best")
function Ring.fighters()
	local teams = teamsData()
	local list = Ring.collect(teams.Presets[teams.Active])
	if #list > 0 then
		return list, "team"
	end
	local okEq, equipped = pcall(function()
		return State.EquippedList()
	end)
	list = Ring.collect(okEq and equipped or nil)
	if #list > 0 then
		return list, "equipped"
	end
	list = Ring.collect(Ring.ownedKeys())
	table.sort(list, function(a, b)
		if a.Power ~= b.Power then
			return a.Power > b.Power
		end
		return tostring(a.Key) < tostring(b.Key)
	end)
	local slots = math.max(1, math.floor(tonumber(teams.Slots) or 3))
	while #list > slots do
		table.remove(list)
	end
	return list, "best"
end

-- the garden's coins per second (the plot attribute IncomePerSecond): ring Cash is a few seconds of it
function Ring.income()
	local index = attr(Config.Attr.SpotIndex)
	if type(index) ~= "number" then
		return 0
	end
	local folder = Ring.Folder
	if not (folder and folder.Parent and folder:GetAttribute("SpotIndex") == index) then
		local lobby = Workspace:FindFirstChild("NimbusLobby")
		folder = lobby and lobby:FindFirstChild(string.format("Spot_%02d", index), true) or nil
		Ring.Folder = folder
	end
	local value = folder and folder:GetAttribute("IncomePerSecond")
	return type(value) == "number" and value or 0
end

-- "Common", "Uncommon or Rare"
function Ring.bandText(round)
	local cfg = Ring.cfg()
	if round <= #(cfg.EasyRounds or {}) then
		return "Common"
	end
	for _, band in ipairs(cfg.Bands or {}) do
		if round >= (tonumber(band.From) or 0) and (band.To == nil or round <= band.To) then
			local names = band.Rarities or {}
			if #names <= 1 then
				return tostring(names[1] or "")
			end
			return table.concat(names, ", ", 1, #names - 1) .. " or " .. names[#names]
		end
	end
	return ""
end

-- the round `round`: { Boss, Power (about: the run's seed picks the species), Band, Cash, Xp, Tokens, Record }
function Ring.preview(round, best)
	local BC = catalog()
	local out = { Round = round, Boss = round % Ring.bossEvery() == 0, Power = 0, Band = Ring.bandText(round), Cash = 0, Xp = 0,
		Tokens = 0, Record = round > best }
	if BC and type(BC.RingPower) == "function" then
		local ok, p = pcall(BC.RingPower, round, 1)
		out.Power = ok and tonumber(p) or 0
	end
	if BC and type(BC.RingRewards) == "function" then
		local ok, r = pcall(BC.RingRewards, round, Ring.income(), out.Record)
		if ok and type(r) == "table" then
			out.Cash, out.Xp, out.Tokens = tonumber(r.Cash) or 0, tonumber(r.Xp) or 0, tonumber(r.Tokens) or 0
		end
	end
	return out
end

-- why START cannot work right now (the server's checks, in its order), or nil
function Ring.why(fighters)
	if type(attr(Config.Attr.SpotIndex)) ~= "number" then
		return "Claim your home first: press E at a free gate."
	end
	if #Ring.ownedKeys() == 0 then
		return "You need a pet: spin a roulette in the Cloud Shop."
	end
	if #(fighters or {}) == 0 then
		return "Your pets are all training right now."
	end
	if inMatch() then
		return "Finish your obby match first."
	end
	if battleId() then
		return "You are already in a battle."
	end
	local d = Ring.distance()
	if d and d > K.RING_RANGE then
		return "Walk to the Champion Ring portal."
	end
	if Ring.Refusal and os.clock() - Ring.RefusalAt < 6 then
		return Ring.Refusal
	end
	return nil
end

function Ring.money(n)
	return "$" .. commas(n)
end

-- one fighter card (viewport, name, level, power)
function Ring.fighterCard(parent, entry, order, handles)
	local def = entry.Def
	local card = makeFrame(parent, "Fighter" .. order, { BackgroundTransparency = 0, BackgroundColor3 = WHITE, LayoutOrder = order })
	corner(card, 12)
	stroke(card, NAVY, 3, 0)
	local tint = rarityColor(def)
	Theme.Gradient(card, Theme.Lighten(INSET, 0.3):Lerp(tint, 0.4), Theme.Darken(INSET, 0.05):Lerp(tint, 0.2), 90)
	local view = makeFrame(card, "ViewHolder", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(1, -10, 0, 54),
		ZIndex = 2,
	})
	-- Phase 5 (3.7): the stored evolution stage (an evolved model is always built Low)
	local stage = 0
	if type(State.PetStage) == "function" and entry.Key then
		local okStage, n = pcall(State.PetStage, entry.Key)
		stage = okStage and tonumber(n) or 0
	end
	card:SetAttribute("Stage", stage)
	pcall(function()
		local handle = CloudUI.PetViewport(view, def, UDim2.new(1, 0, 1, 0), { Spin = "sway", Detail = "Low", ZIndex = 2, Evolved = stage > 0 and stage or nil })
		table.insert(handles, handle)
	end)
	if stage > 0 then
		local badge = makeText(card, "StageBadge", (stage >= 2) and "EVO II" or "EVO I", "Button", 18, WHITE, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Darken(GOLD, 0.35),
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.fromOffset(62, 22),
			ZIndex = 4,
		})
		corner(badge, 8)
	end
	makeText(card, "PetName", tostring(def.DisplayName or def.Name or entry.Key), "Body", 18, WHITE, {
		Position = UDim2.fromOffset(4, 58),
		Size = UDim2.new(1, -8, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3,
	})
	local row = makeFrame(card, "Row", { Position = UDim2.fromOffset(4, 82), Size = UDim2.new(1, -8, 0, 26), ZIndex = 3 })
	listLayout(row, Enum.FillDirection.Horizontal, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	autoText(row, "Level", "Lv " .. tostring(entry.Level or 1), "Heading", 18, WHITE, 1)
	autoText(row, "Power", G.Swords .. " " .. commas(entry.Power), "Heading", 18, C.Power, 2)
	return card
end

-- the start picker tile of `round`
function Ring.startTile(ui, round, order)
	local boss = round > 1
	local tile = {}
	tile.Button = Util.Create("TextButton", {
		Name = "Start" .. round,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		LayoutOrder = order,
		Parent = ui.Picker,
	})
	corner(tile.Button, 14)
	tile.Stroke = stroke(tile.Button, NAVY, 3, 0)
	local base = boss and C.Boss or C.Next
	Util.Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Theme.Lighten(base, 0.22), Theme.Darken(base, 0.18)),
		Parent = tile.Button,
	})
	makeText(tile.Button, "Caption", boss and (G.Crown .. " BOSS") or "ROUND", "Heading", 18, WHITE, {
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, 0, 0, 22),
		ZIndex = 3,
	})
	makeText(tile.Button, "Number", tostring(round), "Display", 30, WHITE, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, 0, 0, 36),
		ZIndex = 3,
	})
	tile.Button.Activated:Connect(function()
		Ring.Start = round
		Ring.Picked = true
		Ring.Refusal = nil
		refreshOpen()
	end)
	CloudUI.Tooltip(tile.Button, function()
		if round <= 1 then
			return "Start a new run at round 1"
		end
		return "Continue from boss round " .. round .. " (you beat it)"
	end)
	ui.Tiles[round] = tile
	return tile
end

function Ring.build()
	local win = newWindow("Ring", "Champion Ring")
	local content = win.Panel.Content
	local ui = { Tiles = {}, Handles = {}, Board = {} }
	win.Ui = ui

	-- side column: the record, the best of this server, how it works
	ui.Side = scroller(content, "Side", {})
	pad(ui.Side, 4, 4, 14, 8)
	listLayout(ui.Side, Enum.FillDirection.Vertical, 10)
	local rec = inset(ui.Side, "Record", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 })
	pad(rec, 14, 8, 14, 10)
	listLayout(rec, Enum.FillDirection.Vertical, 2)
	makeText(rec, "Caption", "Your record", "Heading", 19, MUTED, {
		Size = UDim2.new(1, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	ui.BestLabel = makeText(rec, "Best", "", "Display", 34, C.Power, {
		Size = UDim2.new(1, 0, 0, 42),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 2,
	})
	ui.RunsLabel = wrapText(rec, "Runs", "", "Body", 19, WHITE, 3)

	local board = inset(ui.Side, "ServerBest", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
	pad(board, 14, 8, 14, 10)
	listLayout(board, Enum.FillDirection.Vertical, 4)
	makeText(board, "Caption", G.Trophy .. " Best in this server", "Heading", 20, WHITE, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	})
	for i = 1, 3 do
		local row = makeFrame(board, "Row" .. i, { Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 1 + i })
		local name = makeText(row, "Name", "", "Body", 19, WHITE, {
			Size = UDim2.new(1, -96, 1, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local round = makeText(row, "Round", "", "Heading", 19, C.Medal[i], {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(96, 28),
			TextXAlignment = Enum.TextXAlignment.Right,
		})
		ui.Board[i] = { Row = row, Name = name, Round = round }
	end
	ui.BoardEmpty = wrapText(board, "Empty", "No record yet: be the first!", "Body", 19, MUTED, 9)

	local how = inset(ui.Side, "How", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 })
	pad(how, 14, 8, 14, 10)
	listLayout(how, Enum.FillDirection.Vertical, 4)
	local every = Ring.bossEvery()
	local tokens = math.floor(tonumber(Ring.cfg().BossTokens) or 100)
	wrapText(how, "Text", "Beat the champion, meet a stronger one! Every " .. every .. "th round is a giant BOSS (first win: +"
		.. tokens .. " Tokens). A loss ends the run, but every win pays at once.", "Body", 19, WHITE, 1)
	ui.CashNote = wrapText(how, "CashNote", "", "Body", 18, MUTED, 2)

	-- detail: the start picker, the champion, the rewards, the fighters
	ui.Detail = inset(content, "Detail", {})
	ui.DetailScroll = scroller(ui.Detail, "Scroll", { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8) })
	pad(ui.DetailScroll, 14, 10, 16, 12)
	listLayout(ui.DetailScroll, Enum.FillDirection.Vertical, 10)
	local d = ui.DetailScroll
	makeText(d, "PickTitle", "Start from", "Heading", 20, MUTED, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	ui.Picker = makeFrame(d, "Picker", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
	ui.PickerLayout = Util.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(104, Ring.TILE_H),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.Picker,
	})

	local champ = inset(d, "Champion", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 })
	pad(champ, 14, 8, 14, 10)
	ui.Champ = champ
	listLayout(champ, Enum.FillDirection.Vertical, 6)
	-- the title row (wide windows also carry the tags in it; narrow ones show them on their own row)
	ui.ChampHead = makeFrame(champ, "Head", { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 1 })
	listLayout(ui.ChampHead, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	ui.ChampTitle = autoText(ui.ChampHead, "Title", "", "Title", 26, WHITE, 0)
	ui.ChampTitle.TextXAlignment = Enum.TextXAlignment.Left
	ui.ChampTags = makeFrame(champ, "Tags", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 })
	listLayout(ui.ChampTags, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local powers = makeFrame(champ, "Powers", { Size = UDim2.new(1, 0, 0, 62), LayoutOrder = 3 })
	makeText(powers, "ChampCaption", "Champion (about)", "Heading", 19, MUTED, {
		Size = UDim2.new(0.5, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	ui.ChampPower = makeText(powers, "ChampValue", "", "Display", 30, C.Power, {
		Position = UDim2.fromOffset(0, 24),
		Size = UDim2.new(0.5, 0, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	makeText(powers, "TeamCaption", "Your fighters", "Heading", 19, MUTED, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0.5, 0, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	ui.TeamPower = makeText(powers, "TeamValue", "", "Display", 30, WHITE, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 24),
		Size = UDim2.new(0.5, 0, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	ui.Verdict = wrapText(champ, "Verdict", "", "Body", 19, C.GoodText, 4)

	local rewards = inset(d, "Rewards", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 4 })
	pad(rewards, 14, 8, 14, 10)
	ui.Rewards = rewards
	listLayout(rewards, Enum.FillDirection.Vertical, 4)
	ui.NextWin = wrapText(rewards, "NextWin", "", "Heading", 22, WHITE, 1)
	ui.RecordLine = wrapText(rewards, "Record", "", "Body", 19, C.Power, 2)

	ui.FightersTitle = makeText(d, "FightersTitle", "Your fighters", "Heading", 20, MUTED, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 5,
	})
	ui.Fighters = makeFrame(d, "Fighters", { Size = UDim2.new(1, 0, 0, Ring.CARD_H), LayoutOrder = 6 })
	ui.FighterLayout = Util.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, Ring.CARD_H),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = ui.Fighters,
	})

	-- footer (always in view): why START is off, Edit team, START
	ui.Footer = makeFrame(ui.Detail, "Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -10),
		Size = UDim2.new(1, -28, 0, 56),
	})
	local actions = makeFrame(ui.Footer, "Actions", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 56),
	})
	ui.EditButton = CloudUI.Button({
		Name = "EditTeam",
		Text = "Edit team",
		Size = UDim2.fromOffset(170, 54),
		Style = "Blue",
		TextSize = 22,
		Parent = actions,
		Callback = function()
			openTeamWindow()
		end,
	})
	ui.StartButton = CloudUI.Button({
		Name = "Start",
		Text = "START",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(240, 54),
		Style = "Green",
		TextSize = 24,
		Parent = actions,
		Callback = function()
			safe("start ring", ArenaController.StartRing)
		end,
	})
	ui.Why = makeText(ui.Footer, "Why", "", "Body", 19, C.WarnText, {
		Size = UDim2.new(1, 0, 0, 44),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	})

	win.OnLayout = function(w, h, narrow, short, tall)
		local cw = w - K.INSET_X
		local sideW = narrow and 300 or 340
		local detailW
		if tall then
			-- one column (every docked window): the detail first, the record and the board below it; a landscape
			-- phone's short window shows the detail only (the record is on the Team screen too)
			local sideH = short and 0 or math.min(230, math.floor((h - K.INSET_Y) * 0.3))
			local detailH = h - K.INSET_Y - 20 - (short and 0 or (sideH + 10))
			ui.Side.Visible = not short
			ui.Detail.Position = UDim2.fromOffset(12, 10)
			ui.Detail.Size = UDim2.new(1, -24, 0, detailH)
			ui.Side.Position = UDim2.fromOffset(12, 10 + detailH + 10)
			ui.Side.Size = UDim2.new(1, -24, 0, sideH)
			detailW = cw - 24
		else
			ui.Side.Visible = true
			ui.Side.Position = UDim2.fromOffset(12, 10)
			ui.Side.Size = UDim2.new(0, sideW, 1, -20)
			ui.Detail.Position = UDim2.fromOffset(12 + sideW + 12, 10)
			ui.Detail.Size = UDim2.new(1, -(sideW + 36), 1, -20)
			detailW = cw - sideW - 36
		end
		local inner = detailW - 8 - 30
		local cols = math.max(1, math.min(4, math.floor((inner + 8) / (138 + 8))))
		local cardW = math.min(170, math.floor((inner - (cols - 1) * 8) / cols))
		ui.FighterLayout.CellSize = UDim2.fromOffset(cardW, Ring.CARD_H)
		ui.TagsInline = inner >= 640
		ui.FighterCols = cols
		local tileCols = math.max(3, math.min(8, math.floor((inner + 8) / (96 + 8))))
		local tileW = math.min(112, math.floor((inner - (tileCols - 1) * 8) / tileCols))
		ui.PickerLayout.CellSize = UDim2.fromOffset(tileW, Ring.TILE_H)
		-- a landscape phone's footer keeps 120 px clear of Roblox's jump button: smaller buttons there
		ui.StartButton.Size = UDim2.fromOffset(short and 160 or (inner < 420 and 190 or 240), 54)
		ui.EditButton.Size = UDim2.fromOffset(short and 124 or (inner < 420 and 150 or 170), 54)
		ui.Why.Size = UDim2.new(1, 0, 0, short and 26 or 44)
		ui.WhyH = short and 26 or 44
		-- landscape phones: "Next win" comes right under the picker, and the footer keeps clear of Roblox's jump
		-- button (bottom right corner of the screen)
		ui.Rewards.LayoutOrder = short and 3 or 4
		ui.Champ.LayoutOrder = short and 4 or 3
		ui.FooterInset = short and 120 or 28
	end

	win.Refresh = function()
		Ring.refresh(win, ui)
	end
	win.Live = function()
		Ring.live(win, ui)
	end
	return win
end

function Ring.verdict(mine, champ)
	if champ <= 0 then
		return "", C.GoodText
	end
	if mine <= 0 then
		return "Put pets in your team first!", C.WarnText
	end
	local ratio = mine / champ
	if ratio >= 1.15 then
		return "Your pets look ready: go for it!", C.GoodText
	elseif ratio >= 0.9 then
		return "A close fight: tap SPECIAL when it is ready.", C.WarnText
	end
	return "A strong champion! Feed, train or EVOLVE your pets.", C.BadText
end

function Ring.refresh(win, ui)
	local best, runs = Ring.record()
	local starts = Ring.starts(best)
	local valid = false
	for _, r in ipairs(starts) do
		valid = valid or r == Ring.Start
	end
	if not valid then
		Ring.Start = 1
	end
	local start = Ring.Start
	-- record + the server's best
	ui.BestLabel.Text = best > 0 and ("Best: Round " .. best) or "Best: none yet"
	ui.RunsLabel.Text = best > 0 and (commas(runs) .. (runs == 1 and " run so far" or " runs so far")) or "Win round 1 to set your first record!"
	local board = Ring.board()
	for i, row in ipairs(ui.Board) do
		local entry = board[i]
		row.Row.Visible = entry ~= nil
		if entry then
			local mine = LocalPlayer and entry.Name == LocalPlayer.Name
			row.Name.Text = i .. ". " .. entry.Name .. (mine and " (you)" or "")
			row.Name.TextColor3 = mine and C.GoodText or WHITE
			row.Round.Text = "Round " .. entry.Round
		end
	end
	ui.BoardEmpty.Visible = #board == 0
	-- the start picker (rebuilt when the beaten boss rounds change)
	local sig = table.concat(starts, ",")
	if ui.PickerSig ~= sig then
		ui.PickerSig = sig
		clearChildren(ui.Picker)
		ui.Tiles = {}
		for i, round in ipairs(starts) do
			Ring.startTile(ui, round, i)
		end
	end
	for round, tile in pairs(ui.Tiles) do
		local selected = round == start
		tile.Stroke.Color = selected and GOLD or NAVY
		tile.Stroke.Thickness = selected and 4.5 or 3
	end
	-- the champion of the start round
	local p = Ring.preview(start, best)
	ui.ChampTitle.Text = "Round " .. start .. " champion"
	clearChildren(ui.ChampTags)
	for _, child in ipairs(ui.ChampHead:GetChildren()) do
		if child:IsA("GuiObject") and child ~= ui.ChampTitle then
			child:Destroy()
		end
	end
	local tagParent = ui.TagsInline and ui.ChampHead or ui.ChampTags
	ui.ChampTags.Visible = not ui.TagsInline
	if p.Boss then
		colorPill(tagParent, "Boss", G.Crown .. " BOSS", C.Boss, 18, 1)
	end
	if p.Band ~= "" then
		colorPill(tagParent, "Band", p.Band, Color3.fromRGB(90, 120, 190), 18, 2)
	end
	-- the fighters (cards rebuilt only when they change)
	local fighters, source = Ring.fighters()
	local fsig = source
	for _, e in ipairs(fighters) do
		fsig = fsig .. "|" .. tostring(e.Key) .. ":" .. tostring(e.Level) .. ":" .. tostring(e.Power)
	end
	if ui.FighterSig ~= fsig then
		ui.FighterSig = fsig
		for _, handle in ipairs(ui.Handles) do
			pcall(handle.Destroy)
		end
		ui.Handles = {}
		clearChildren(ui.Fighters)
		for i, e in ipairs(fighters) do
			Ring.fighterCard(ui.Fighters, e, i, ui.Handles)
		end
	end
	local rows = math.max(1, math.ceil(#fighters / math.max(1, ui.FighterCols or 4)))
	ui.Fighters.Size = UDim2.new(1, 0, 0, #fighters > 0 and (rows * Ring.CARD_H + (rows - 1) * 8) or 0)
	local titles = { team = "Your fighters (your battle team)", equipped = "Your fighters (your equipped pets)", best = "Your fighters (your strongest pets)" }
	ui.FightersTitle.Text = #fighters > 0 and titles[source] or "Your fighters: none ready"
	local mine = teamPower(fighters)
	ui.ChampPower.Text = G.Swords .. " " .. commas(p.Power)
	ui.TeamPower.Text = G.Swords .. " " .. commas(mine)
	local ratio = p.Power > 0 and mine / p.Power or 1
	ui.TeamPower.TextColor3 = ratio >= 1 and C.GoodText or (ratio >= 0.9 and C.WarnText or C.BadText)
	local verdict, color = Ring.verdict(mine, p.Power)
	ui.Verdict.Text = verdict
	ui.Verdict.TextColor3 = color
	-- rewards of the next win
	ui.NextWin.Text = "Next win: +" .. Ring.money(p.Cash) .. "  +" .. commas(p.Xp) .. " XP"
	local recordText
	if p.Record then
		recordText = G.Star .. " New record: x" .. tostring(Ring.cfg().RecordMult or 3) .. " Cash!"
		if p.Boss and p.Tokens > 0 then
			recordText = recordText .. "  +" .. commas(p.Tokens) .. " Tokens for the boss"
		end
	else
		recordText = "Beat round " .. (best + 1) .. " for a new record: x" .. tostring(Ring.cfg().RecordMult or 3) .. " Cash!"
	end
	ui.RecordLine.Text = recordText
	ui.CashNote.Text = Ring.income() > 0 and "Each win pays a few seconds of your garden's coins (more every round) and XP to every fighter."
		or "Put pets in your Pet Garden: ring wins pay more when your garden makes coins!"
	Ring.live(win, ui)
end

-- the footer only (4 times a second while the window is open: the walk to the portal, the server's answer)
function Ring.live(_win, ui)
	if Ring.Pending and os.clock() - Ring.PendingAt > 4 then
		Ring.Pending = false
	end
	local fighters = Ring.fighters()
	local why = Ring.why(fighters)
	local start = Ring.Start
	CloudUI.SetDisabled(ui.StartButton, why ~= nil or Ring.Pending)
	if Ring.Pending then
		ui.StartButton.Text = "Starting..."
	else
		ui.StartButton.Text = start > 1 and "CONTINUE" or "START"
	end
	ui.Why.Text = why or ""
	ui.Why.Visible = why ~= nil
	local footerH = why and (60 + (ui.WhyH or 44)) or 56
	ui.Footer.Size = UDim2.new(1, -(ui.FooterInset or 28), 0, footerH)
	ui.DetailScroll.Size = UDim2.new(1, -8, 1, -(footerH + 22))
end

function ArenaController.StartRing()
	local fighters = Ring.fighters()
	local why = Ring.why(fighters)
	if why then
		toast(why, "info")
		return false
	end
	if request("Ring", Ring.Start) then
		Ring.Pending = true
		Ring.PendingAt = os.clock()
		Ring.Refusal = nil
		local win = Win.Ring
		if win and win.Ui then
			Ring.live(win, win.Ui)
		end
		return true
	end
	return false
end

-- a server toast: a ring refusal answers the START just sent (shown in the footer, START works again)
function Ring.onNotify(text)
	if type(text) ~= "string" or S.Open ~= "Ring" then
		return
	end
	for _, prefix in ipairs(Ring.REFUSALS) do
		if text:sub(1, #prefix) == prefix then
			Ring.Pending = false
			Ring.Refusal = text
			Ring.RefusalAt = os.clock()
			local win = Win.Ring
			if win and win.Ui then
				Ring.live(win, win.Ui)
			end
			return
		end
	end
end

-- the safe-zone side toast (contract 3.11): crossing the Battle Arena's edge, never right after a battle's teleport
function Ring.zoneTick()
	if battleId() or inMatch() then
		Ring.BattleAt = os.clock()
	end
	local inside = inArena()
	if inside == nil then
		return
	end
	local was = Ring.LastZone
	Ring.LastZone = inside
	if was == nil or was == inside or os.clock() - Ring.BattleAt < 6 then
		return
	end
	if inside then
		toast(G.Swords .. " Battle Arena: pets can battle here", "info")
	else
		toast(G.Heart .. " Safe zone: no pet battles here", "good")
	end
end

-- the Champion Ring line on the Team screen (MenuController's window "Team"; added from here, it stays below the
-- team sections): "Champion Ring best: Round 12 (9 runs)"
function Ring.teamLine()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	local holder = menu and menu:FindFirstChild("Window_Team", true)
	local top = holder and holder:FindFirstChild("TopBar", true)
	local left = top and top.Parent and top.Parent:FindFirstChild("Left")
	if not left then
		return nil
	end
	local label = left:FindFirstChild("RingRecord")
	if not label then
		label = makeText(left, "RingRecord", "", "Heading", 19, C.Power, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 999,
		})
	end
	local best, runs = Ring.record()
	label.Text = best > 0 and (G.Crown .. " Champion Ring best: Round " .. best .. " (" .. commas(runs) .. (runs == 1 and " run)" or " runs)"))
		or (G.Crown .. " Champion Ring: no record yet (the portal is on the plaza)")
	return label
end

-- the Champion Ring board in the Arena panel's Leaders tab: the best of this server (Portal_Ring's RingBoard) + the
-- player's own record
function Ring.leaderSection(parent, order)
	local box = inset(parent, "RingBoard", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order })
	pad(box, 14, 10, 14, 12)
	listLayout(box, Enum.FillDirection.Vertical, 4)
	wrapText(box, "Title", G.Crown .. " Champion Ring: best in this server", "Heading", 21, WHITE, 1)
	local board = Ring.board()
	for i, entry in ipairs(board) do
		local mine = LocalPlayer and entry.Name == LocalPlayer.Name
		wrapText(box, "Row" .. i, i .. ". " .. entry.Name .. (mine and " (you)" or "") .. ": Round " .. entry.Round,
			"Body", 19, mine and C.GoodText or WHITE, 1 + i)
	end
	if #board == 0 then
		wrapText(box, "Empty", "No ring record in this server yet: be the first!", "Body", 19, MUTED, 2)
	end
	local best = Ring.record()
	wrapText(box, "Mine", best > 0 and ("Your best: Round " .. best .. ". Beat it for triple Cash!")
		or "Press E at the Champion Ring portal on the plaza to set your record.", "Body", 19, C.Power, 9)
	return box
end

-- the Champion Ring numbers the window shows (tests / other controllers)
function ArenaController.RingInfo()
	local best, runs = Ring.record()
	local fighters, source = Ring.fighters()
	return {
		Best = best,
		Runs = runs,
		Start = Ring.Start,
		Starts = Ring.starts(best),
		Board = Ring.board(),
		Fighters = fighters,
		Source = source,
		Preview = Ring.preview(Ring.Start, best),
		Why = Ring.why(fighters),
	}
end

----------------------------------------------------------------------
-- Arena panel: Duels | Boss Raid | Leaders
----------------------------------------------------------------------
local TABS = {
	{ Id = "Duels", Label = G.Swords .. " Duels", Short = "Duels" },
	{ Id = "Raid", Label = G.Skull .. " Boss Raid", Short = "Raid" },
	{ Id = "Leaderboard", Label = G.Trophy .. " Leaders", Short = "Leaders" },
}

local function normalizeTab(tab)
	if type(tab) ~= "string" then
		return nil
	end
	local t = tab:lower()
	if t:find("duel", 1, true) or t:find("pvp", 1, true) or t:find("queue", 1, true) then
		return "Duels"
	elseif t:find("raid", 1, true) or t:find("event", 1, true) or t:find("boss", 1, true) then
		return "Raid"
	elseif t:find("leader", 1, true) or t:find("troph", 1, true) or t:find("rank", 1, true) then
		return "Leaderboard"
	end
	return nil
end

local function leaderboard()
	local list = S.Arena and S.Arena.Leaderboard
	return type(list) == "table" and list or {}
end

local function trophiesOf(userId)
	for _, row in ipairs(leaderboard()) do
		if type(row) == "table" and row.UserId == userId then
			return tonumber(row.Trophies)
		end
	end
	return nil
end

local function bossInfo(bossId)
	local BC = catalog()
	local boss = BC and type(BC.Bosses) == "table" and BC.Bosses[bossId]
	return type(boss) == "table" and boss or nil
end

-- the elements that hit `element` hard (Config.Elements.Strong)
local function countersOf(element)
	local out = {}
	local strong = (Config.Elements and Config.Elements.Strong) or {}
	for _, attacker in ipairs((Config.Elements and Config.Elements.Order) or {}) do
		for _, target in ipairs(strong[attacker] or {}) do
			if target == element then
				out[#out + 1] = attacker
			end
		end
	end
	return out
end

local function raidStatus()
	local raid = S.Arena and S.Arena.Raid
	if type(raid) == "table" and raid.Active ~= false then
		return raid
	end
	return nil
end

local function inRaid()
	local raid = raidStatus()
	local id = battleId()
	return raid ~= nil and id ~= nil and raid.BattleId ~= nil and tostring(raid.BattleId) == id
end

local function buildArena()
	local win = newWindow("Arena", "Battle Arena")
	local content = win.Panel.Content
	local ui = { Pages = {}, TabButtons = {}, Rows = {} }
	win.Ui = ui

	-- tab bar + trophies
	ui.Bar = makeFrame(content, "TabBar", { Position = UDim2.fromOffset(14, 10), Size = UDim2.new(1, -28, 0, 50) })
	local tabRow = makeFrame(ui.Bar, "Tabs", { Size = UDim2.new(1, -180, 1, 0) })
	listLayout(tabRow, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	for i, tab in ipairs(TABS) do
		ui.TabButtons[tab.Id] = CloudUI.Button({
			Name = "Tab_" .. tab.Id,
			Text = tab.Label,
			Size = UDim2.fromOffset(200, 46),
			Style = "Gray",
			TextSize = 22,
			LayoutOrder = i,
			Parent = tabRow,
			Callback = function()
				S.Tab = tab.Id
				refreshOpen()
			end,
		})
	end
	ui.TabRow = tabRow
	local chip = makeFrame(ui.Bar, "Trophies", {
		BackgroundTransparency = 0,
		BackgroundColor3 = INSET,
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(0, 48),
		AutomaticSize = Enum.AutomaticSize.X,
	})
	corner(chip, 12)
	stroke(chip, NAVY, 3, 0)
	pad(chip, 12, 0, 14, 0)
	listLayout(chip, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	ui.Trophies = autoText(chip, "Value", G.Trophy .. " 0", "Display", 28, WHITE, 1)
	ui.Chip = chip

	local function page(id)
		local frame = makeFrame(content, "Page_" .. id, { Visible = false })
		ui.Pages[id] = frame
		return frame
	end

	------------------------------------------------------------ Duels
	local duels = page("Duels")
	ui.DuelLeft = scroller(duels, "Left", {})
	pad(ui.DuelLeft, 2, 2, 12, 6)
	listLayout(ui.DuelLeft, Enum.FillDirection.Vertical, 10)
	local quick = inset(ui.DuelLeft, "Quick", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 })
	pad(quick, 14, 10, 14, 14)
	listLayout(quick, Enum.FillDirection.Vertical, 8)
	makeText(quick, "Title", "Quick match", "Title", 26, WHITE, {
		Size = UDim2.new(1, 0, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	wrapText(quick, "Text", "Get paired with a player near your trophies. Both of you stay in the arena: the duel runs on a free ring.", "Body", 19, MUTED, 2)
	ui.QueueStatus = wrapText(quick, "Status", "", "Heading", 20, C.Power, 3)
	local queueRow = makeFrame(quick, "Buttons", { Size = UDim2.new(1, 0, 0, 54), LayoutOrder = 4 })
	ui.QueueButton = CloudUI.Button({
		Name = "Queue",
		Text = "Find a match",
		Size = UDim2.fromOffset(240, 54),
		Style = "Green",
		TextSize = 24,
		Parent = queueRow,
		Callback = function()
			local lobby = S.Lobby
			local queued = lobby and type(lobby.Queue) == "table" and lobby.Queue.Queued == true
			if queued then
				request("Unqueue")
			else
				if inArena() == false then
					toast("Walk into the Battle Arena to duel!", "info")
					return
				end
				request("Queue")
			end
		end,
	})
	local record = inset(ui.DuelLeft, "Record", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
	pad(record, 14, 10, 14, 12)
	listLayout(record, Enum.FillDirection.Vertical, 4)
	makeText(record, "Title", "Your record", "Heading", 22, WHITE, {
		Size = UDim2.new(1, 0, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	ui.RecordText = wrapText(record, "Lines", "", "Body", 19, WHITE, 2)
	wrapText(record, "Rules", "Win: +" .. "20 " .. G.Trophy .. "   Loss: -10 " .. G.Trophy .. "   Nobody ever loses a pet!", "Body", 18, MUTED, 3)
	ui.RecordRules = record:FindFirstChild("Rules")
	ui.InviteBox = inset(ui.DuelLeft, "Invites", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 })
	pad(ui.InviteBox, 14, 10, 14, 12)
	listLayout(ui.InviteBox, Enum.FillDirection.Vertical, 8)

	ui.Challenge = inset(duels, "Challenge", {})
	ui.ChallengeList = scroller(ui.Challenge, "List", { Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 1, -8) })
	pad(ui.ChallengeList, 12, 8, 14, 10)
	listLayout(ui.ChallengeList, Enum.FillDirection.Vertical, 8)

	------------------------------------------------------------ Boss Raid
	local raid = page("Raid")
	ui.RaidScroll = scroller(raid, "Scroll", {})
	pad(ui.RaidScroll, 2, 2, 12, 6)
	listLayout(ui.RaidScroll, Enum.FillDirection.Vertical, 10)
	ui.BossCard = inset(ui.RaidScroll, "Boss", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 })
	pad(ui.BossCard, 16, 10, 16, 14)
	listLayout(ui.BossCard, Enum.FillDirection.Vertical, 8)
	local bossHead = makeFrame(ui.BossCard, "Head", { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1 })
	listLayout(bossHead, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	ui.BossState = colorPill(bossHead, "State", "LIVE", C.Boss, 18, 1)
	ui.BossName = autoText(bossHead, "Name", "", "Title", 30, WHITE, 2)
	ui.BossElement = makeFrame(bossHead, "Element", { Size = UDim2.fromOffset(0, 30), AutomaticSize = Enum.AutomaticSize.X, LayoutOrder = 3 })
	listLayout(ui.BossElement, Enum.FillDirection.Horizontal, 4, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	ui.BossBlurb = wrapText(ui.BossCard, "Blurb", "", "Body", 19, MUTED, 2)
	local hpTrack = makeFrame(ui.BossCard, "Hp", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(14, 20, 48),
		Size = UDim2.new(1, 0, 0, 30),
		LayoutOrder = 3,
	})
	corner(hpTrack, 10)
	stroke(hpTrack, NAVY, 3, 0)
	ui.BossHpFill = makeFrame(hpTrack, "Fill", {
		BackgroundTransparency = 0,
		BackgroundColor3 = C.Boss,
		Size = UDim2.new(1, 0, 1, 0),
	})
	corner(ui.BossHpFill, 10)
	Theme.Gradient(ui.BossHpFill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 170, 180), 90)
	ui.BossHpText = makeText(hpTrack, "Text", "", "Heading", 19, WHITE, { Size = UDim2.new(1, 0, 1, 0), ZIndex = 3 })
	ui.BossLine = wrapText(ui.BossCard, "Line", "", "Heading", 20, WHITE, 4)
	local raidButtons = makeFrame(ui.BossCard, "Buttons", { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 5 })
	ui.JoinButton = CloudUI.Button({
		Name = "JoinRaid",
		Text = "JOIN RAID",
		Size = UDim2.fromOffset(240, 56),
		Style = "Red",
		TextSize = 26,
		Parent = raidButtons,
		Callback = function()
			if inRaid() then
				request("LeaveRaid")
			else
				if inArena() == false then
					toast("Walk into the Battle Arena to join the raid!", "info")
					return
				end
				request("JoinRaid")
			end
		end,
	})
	ui.JoinWhy = makeText(raidButtons, "Why", "", "Body", 19, C.WarnText, {
		Position = UDim2.fromOffset(256, 0),
		Size = UDim2.new(1, -256, 1, 0),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	})

	ui.NextCard = inset(ui.RaidScroll, "Next", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 })
	pad(ui.NextCard, 16, 10, 16, 12)
	listLayout(ui.NextCard, Enum.FillDirection.Vertical, 4)
	makeText(ui.NextCard, "Title", "Next event", "Heading", 20, MUTED, {
		Size = UDim2.new(1, 0, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 1,
	})
	ui.NextName = wrapText(ui.NextCard, "Name", "", "Title", 24, WHITE, 2)
	ui.NextClock = makeText(ui.NextCard, "Clock", "--:--", "Display", 36, C.Power, {
		Size = UDim2.new(1, 0, 0, 42),
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 3,
	})
	ui.DoubleLine = wrapText(ui.NextCard, "Double", "", "Heading", 20, Theme.Lighten(C.Double, 0.35), 4)

	ui.Tips = inset(ui.RaidScroll, "Tips", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 })
	pad(ui.Tips, 16, 10, 16, 12)
	listLayout(ui.Tips, Enum.FillDirection.Vertical, 6)

	------------------------------------------------------------ Leaders
	local leaders = page("Leaderboard")
	ui.LeaderScroll = scroller(leaders, "Scroll", {})
	pad(ui.LeaderScroll, 2, 2, 12, 6)
	listLayout(ui.LeaderScroll, Enum.FillDirection.Vertical, 8)

	win.OnLayout = function(w, h, narrow, short, tall)
		local cw = w - K.INSET_X
		local barH = tall and 108 or 50
		ui.Bar.Size = UDim2.new(1, -28, 0, barH)
		local tabW = tall and math.floor((cw - 28 - 16) / 3) or (narrow and 180 or 200)
		for _, tab in ipairs(TABS) do
			local button = ui.TabButtons[tab.Id]
			button.Size = UDim2.fromOffset(tabW, 46)
			button.TextSize = tall and 20 or 22
			button.Text = tall and (tab.Short or tab.Label) or tab.Label
		end
		if tall then
			ui.TabRow.Size = UDim2.new(1, 0, 0, 48)
			ui.Chip.AnchorPoint = Vector2.new(0, 0)
			ui.Chip.Position = UDim2.fromOffset(0, 58)
		else
			ui.TabRow.Size = UDim2.new(1, -180, 1, 0)
			ui.Chip.AnchorPoint = Vector2.new(1, 0.5)
			ui.Chip.Position = UDim2.new(1, 0, 0.5, 0)
		end
		local top = 10 + barH + 12
		for _, frame in pairs(ui.Pages) do
			frame.Position = UDim2.fromOffset(14, top)
			frame.Size = UDim2.new(1, -28, 1, -(top + 10))
		end
		ui.RaidScroll.Size = UDim2.new(1, 0, 1, 0)
		ui.LeaderScroll.Size = UDim2.new(1, 0, 1, 0)
		if tall then
			ui.DuelLeft.Position = UDim2.fromOffset(0, 0)
			ui.DuelLeft.Size = UDim2.new(1, 0, 0.58, -6)
			ui.Challenge.Position = UDim2.new(0, 0, 0.58, 6)
			ui.Challenge.Size = UDim2.new(1, 0, 0.42, -6)
		else
			local leftW = math.floor((cw - 28) * 0.48)
			ui.DuelLeft.Position = UDim2.fromOffset(0, 0)
			ui.DuelLeft.Size = UDim2.new(0, leftW, 1, 0)
			ui.Challenge.Position = UDim2.fromOffset(leftW + 12, 0)
			ui.Challenge.Size = UDim2.new(1, -(leftW + 12), 1, 0)
		end
		ui.JoinWhy.Visible = not tall
		ui.BossName.TextSize = tall and 24 or 30
	end

	local function inviteRow(parent, invite, order)
		local row = makeFrame(parent, "Invite" .. order, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(60, 40, 90),
			Size = UDim2.new(1, 0, 0, 104),
			LayoutOrder = order,
		})
		corner(row, 12)
		local practice = invite.Practice == true
		stroke(row, practice and C.Practice or C.Arena, 3, 0)
		row:SetAttribute("Practice", practice)
		makeText(row, "Name", G.Swords .. " " .. tostring(invite.FromName or "Someone") .. (practice and " wants a practice duel" or " challenges you!"), "Heading", 20, WHITE, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		if practice then
			-- Phase 5 (4.2): the two teams are far apart in power: the duel is practice (no trophies, no rewards)
			row.Size = UDim2.new(1, 0, 0, 130)
			makeText(row, "PracticeFlag", "Practice duel - no trophies or rewards", "Heading", 18, C.Practice, {
				Position = UDim2.fromOffset(12, 100),
				Size = UDim2.new(1, -24, 0, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
			})
		end
		makeText(row, "Info", G.Trophy .. " " .. commas(invite.Trophies or 0) .. "    " .. G.Swords .. " " .. commas(invite.Power or 0)
			.. "    " .. clock(lobbySeconds(invite.ExpiresIn) or 0), "Body", 19, MUTED, {
			Position = UDim2.fromOffset(12, 34),
			Size = UDim2.new(1, -24, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		CloudUI.Button({
			Name = "Accept",
			Text = "Accept",
			Position = UDim2.fromOffset(12, 60),
			Size = UDim2.fromOffset(140, 40),
			Style = "Green",
			TextSize = 20,
			Parent = row,
			Callback = function()
				request("ChallengeReply", invite.FromUserId, true)
			end,
		})
		CloudUI.Button({
			Name = "Decline",
			Text = "Decline",
			Position = UDim2.fromOffset(160, 60),
			Size = UDim2.fromOffset(140, 40),
			Style = "Gray",
			TextSize = 20,
			Parent = row,
			Callback = function()
				request("ChallengeReply", invite.FromUserId, false)
			end,
		})
		return row
	end

	local function playerRow(player, order, sent)
		local row = makeFrame(ui.ChallengeList, "Player_" .. player.UserId, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(34, 50, 100),
			Size = UDim2.new(1, 0, 0, 62),
			LayoutOrder = order,
		})
		corner(row, 12)
		stroke(row, NAVY, 3, 0)
		makeText(row, "Name", player.DisplayName ~= "" and player.DisplayName or player.Name, "Title", 22, WHITE, {
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -190, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local trophies = trophiesOf(player.UserId)
		makeText(row, "Trophies", G.Trophy .. " " .. (trophies and commas(trophies) or "?"), "Heading", 18, C.Power, {
			Position = UDim2.fromOffset(12, 34),
			Size = UDim2.new(1, -190, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		if sent then
			local pill = colorPill(row, "Sent", "Sent " .. clock(lobbySeconds(sent.ExpiresIn) or 0), Color3.fromRGB(110, 118, 146), 18, 0)
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -12, 0.5, 0)
		else
			local button = CloudUI.Button({
				Name = "Challenge",
				Text = "Challenge",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(160, 46),
				Style = "Red",
				TextSize = 21,
				Parent = row,
				Callback = function()
					if inArena() == false then
						toast("Walk into the Battle Arena to duel!", "info")
						return
					end
					request("Challenge", player.UserId)
				end,
			})
			CloudUI.SetDisabled(button, S.Lobby ~= nil and S.Lobby.Sent ~= nil)
		end
		return row
	end

	local function refreshDuels()
		local lobby = S.Lobby or {}
		local queue = type(lobby.Queue) == "table" and lobby.Queue or {}
		if queue.Queued then
			local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
			ui.QueueStatus.Text = "Searching... " .. clock(seconds) .. "   (" .. commas(queue.Waiting or 1) .. " in the queue)"
			ui.QueueButton.Text = "Leave queue"
			CloudUI.SetStyle(ui.QueueButton, "Gray")
		else
			local waiting = tonumber(queue.Waiting) or 0
			ui.QueueStatus.Text = waiting > 0 and (commas(waiting) .. " waiting for a match right now") or "Nobody is queued yet: be the first!"
			ui.QueueButton.Text = "Find a match"
			CloudUI.SetStyle(ui.QueueButton, "Green")
		end
		CloudUI.SetDisabled(ui.QueueButton, battleId() ~= nil)
		local b = battleData()
		ui.RecordText.Text = G.Trophy .. " " .. commas(b.Trophies or 0) .. " trophies     " .. commas(b.PvPWins or 0) .. " won " .. G.Bullet .. " "
			.. commas(b.PvPLosses or 0) .. " lost"
		local BC = catalog()
		local rules = BC and type(BC.Trophies) == "table" and BC.Trophies or nil
		if rules and ui.RecordRules then
			ui.RecordRules.Text = "Win: +" .. commas(rules.Win or 0) .. " " .. G.Trophy .. "   Loss: " .. tostring(rules.Loss or 0) .. " "
				.. G.Trophy .. "   Nobody ever loses a pet!"
		end
		-- incoming invites
		clearChildren(ui.InviteBox)
		local invites = type(lobby.Invites) == "table" and lobby.Invites or {}
		ui.InviteBox.Visible = #invites > 0
		if #invites > 0 then
			makeText(ui.InviteBox, "Title", "Challenges for you", "Heading", 22, WHITE, {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 0,
			})
			for i, invite in ipairs(invites) do
				if type(invite) == "table" then
					inviteRow(ui.InviteBox, invite, i)
				end
			end
		end
		-- players to challenge
		clearChildren(ui.ChallengeList)
		makeText(ui.ChallengeList, "Title", "Challenge a player", "Title", 26, WHITE, {
			Size = UDim2.new(1, 0, 0, 32),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0,
		})
		local others = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				others[#others + 1] = p
			end
		end
		table.sort(others, function(x, y)
			return (trophiesOf(x.UserId) or 0) > (trophiesOf(y.UserId) or 0)
		end)
		local sent = type(lobby.Sent) == "table" and lobby.Sent or nil
		for i, p in ipairs(others) do
			playerRow(p, i, sent and sent.ToUserId == p.UserId and sent or nil)
		end
		if #others == 0 then
			wrapText(ui.ChallengeList, "Empty", "Nobody else is in this server yet. Invite a friend, or try the Dungeon meanwhile!", "Body", 19, MUTED, 1)
		end
	end

	local function tierLine(parent, tier, order)
		local row = makeFrame(parent, "Tier_" .. tostring(tier.Id), {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
		})
		listLayout(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
		local colors = { Gold = C.Medal[1], Silver = Color3.fromRGB(150, 164, 190), Bronze = C.Medal[3], Helper = Color3.fromRGB(90, 120, 190) }
		colorPill(row, "Name", tostring(tier.Id), colors[tier.Id] or Color3.fromRGB(90, 120, 190), 18, 1)
		local share = math.floor((tonumber(tier.MinShare) or 0) * 100 + 0.5)
		local text = (share > 0 and (share .. "%+ damage: ") or "Any damage: ") .. G.Cloud .. " " .. commas(tier.Tokens or 0)
		if (tonumber(tier.Gems) or 0) > 0 then
			text = text .. ", " .. math.floor((tonumber(tier.GemChance) or 0) * 100 + 0.5) .. "% for " .. G.Gem .. " " .. commas(tier.Gems)
		end
		makeText(row, "Text", text, "Body", 19, WHITE, {
			Size = UDim2.new(1, -96, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
		})
	end

	local function refreshRaid()
		local raid = raidStatus()
		local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
		local bossId = raid and raid.BossId or (nextEvent and nextEvent.BossId)
		local boss = bossInfo(bossId)
		local element = boss and boss.Element
		if ui.BossElementSig ~= tostring(element) then
			ui.BossElementSig = tostring(element)
			clearChildren(ui.BossElement)
			if element then
				elementPill(ui.BossElement, element, 18, 1)
			end
		end
		ui.BossName.Text = (raid and raid.Name) or (boss and boss.Name) or (nextEvent and nextEvent.Name) or "Boss Raid"
		ui.BossBlurb.Text = boss and tostring(boss.Blurb or "") or "A giant boss appears on the colosseum floor. Everyone in the arena can fight it together!"
		local hpVisible = false
		if raid then
			local maxHp = tonumber(raid.MaxHp) or 0
			local hp = tonumber(raid.Hp) or 0
			if raid.Waiting or maxHp <= 0 then
				ui.BossState.Text = "OPEN"
				ui.BossState.BackgroundColor3 = Color3.fromRGB(226, 160, 54)
				ui.BossLine.Text = "Waiting for the first fighter! Join closes in " .. clock(arenaSeconds(raid.JoinEndsIn) or 0)
			else
				hpVisible = true
				ui.BossState.Text = raid.Enraged and "ENRAGED" or "LIVE"
				ui.BossState.BackgroundColor3 = C.Boss
				ui.BossHpFill.Size = UDim2.new(Util.Clamp(hp / maxHp, 0, 1), 0, 1, 0)
				ui.BossHpText.Text = commas(hp) .. " / " .. commas(maxHp)
				local line = commas(raid.Players or 0) .. " fighting " .. G.Bullet .. " " .. clock(arenaSeconds(raid.EndsIn) or 0) .. " left"
				if raid.Joinable then
					line = line .. " " .. G.Bullet .. " join closes in " .. clock(arenaSeconds(raid.JoinEndsIn) or 0)
				end
				ui.BossLine.Text = line
			end
		else
			ui.BossState.Text = "SOON"
			ui.BossState.BackgroundColor3 = Color3.fromRGB(90, 120, 190)
			local starts = nextEvent and nextEvent.Kind == "BossRaid" and arenaSeconds(nextEvent.StartsIn) or nil
			ui.BossLine.Text = starts and ("Starts in " .. clock(starts) .. ". Be in the arena with your team!") or "No raid running right now."
		end
		ui.BossHpFill.Parent.Visible = hpVisible
		-- join / leave
		local why = nil
		local canJoin = raid ~= nil and (raid.Joinable == true or raid.Waiting == true)
		if inRaid() then
			ui.JoinButton.Text = "LEAVE RAID"
			CloudUI.SetStyle(ui.JoinButton, "Gray")
		else
			ui.JoinButton.Text = "JOIN RAID"
			CloudUI.SetStyle(ui.JoinButton, "Red")
			if not raid then
				why = "Raids start every " .. ((catalog() and catalog().Events and catalog().Events.Schedule and catalog().Events.Schedule[1]
					and catalog().Events.Schedule[1].EveryMinutes) or 20) .. " minutes."
			elseif not canJoin then
				why = "The join window has closed. Watch from the stands!"
			elseif battleId() then
				why = "Finish your current battle first."
			elseif #activeTeam() == 0 then
				why = "Pick your battle team first."
			elseif inArena() == false then
				why = "Walk into the Battle Arena to join."
			end
		end
		CloudUI.SetDisabled(ui.JoinButton, why ~= nil and not inRaid())
		ui.JoinWhy.Text = why or ""
		-- next event + double rewards
		if nextEvent then
			ui.NextClock.Text = clock(arenaSeconds(nextEvent.StartsIn) or 0)
			local kind = nextEvent.Kind == "DoubleRewards" and "Double Rewards hour" or "Boss Raid"
			ui.NextName.Text = kind .. ((nextEvent.Name and nextEvent.Kind ~= "DoubleRewards") and (": " .. tostring(nextEvent.Name)) or "")
		else
			ui.NextClock.Text = "--:--"
			ui.NextName.Text = "Nothing scheduled"
		end
		local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double or nil
		if double and double.Active then
			ui.DoubleLine.Text = G.Double .. "2 Double Rewards for " .. clock(arenaSeconds(double.EndsIn) or 0) .. ": every battle pays twice the tokens!"
			ui.DoubleLine.Visible = true
		else
			ui.DoubleLine.Visible = false
		end
		-- tips: elements that beat the boss + the reward tiers
		local sig = tostring(bossId)
		if ui.TipsSig ~= sig then
			ui.TipsSig = sig
			clearChildren(ui.Tips)
			makeText(ui.Tips, "Title", "How to win", "Heading", 22, WHITE, {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
			})
			if element then
				local counters = countersOf(element)
				if #counters > 0 then
					wrapText(ui.Tips, "CountersText", "Bring these pets: they hit " .. tostring(element) .. " hard.", "Body", 19, WHITE, 2)
					local row = makeFrame(ui.Tips, "Counters", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 })
					row.LayoutOrder = 3
					listLayout(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
					for i, e in ipairs(counters) do
						elementPill(row, e, 18, i)
					end
				end
			end
			wrapText(ui.Tips, "Retreat", "Glowing circles and lines on the floor mean a big hit is coming: press RETREAT to get your pets out!", "Body", 19, MUTED, 4)
			local BC = catalog()
			local tiers = BC and BC.Raid and BC.Raid.Tiers
			if type(tiers) == "table" then
				makeText(ui.Tips, "TiersTitle", "Rewards by damage dealt", "Heading", 20, WHITE, {
					Size = UDim2.new(1, 0, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 5,
				})
				for i, tier in ipairs(tiers) do
					tierLine(ui.Tips, tier, 5 + i)
				end
			end
		end
	end

	local function refreshLeaders()
		clearChildren(ui.LeaderScroll)
		makeText(ui.LeaderScroll, "Title", "Trophy leaders in this server", "Title", 26, WHITE, {
			Size = UDim2.new(1, 0, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0,
		})
		local list = leaderboard()
		local meShown = false
		for i, row in ipairs(list) do
			if i > 10 then
				break
			end
			if type(row) == "table" then
				local me = LocalPlayer and row.UserId == LocalPlayer.UserId
				meShown = meShown or me
				local frame = makeFrame(ui.LeaderScroll, "Rank" .. i, {
					BackgroundTransparency = 0,
					BackgroundColor3 = me and C.Me or Color3.fromRGB(34, 50, 100),
					Size = UDim2.new(1, 0, 0, 54),
					LayoutOrder = i,
				})
				corner(frame, 12)
				stroke(frame, me and GOLD or NAVY, me and 3.5 or 3, 0)
				local medal = makeFrame(frame, "Medal", {
					BackgroundTransparency = 0,
					BackgroundColor3 = C.Medal[i] or Color3.fromRGB(70, 90, 150),
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 10, 0.5, 0),
					Size = UDim2.fromOffset(40, 40),
				})
				round(medal)
				stroke(medal, NAVY, 2.5, 0)
				makeText(medal, "Rank", tostring(i), "Display", 24, WHITE, { Size = UDim2.new(1, 0, 1, 0) })
				makeText(frame, "Name", tostring(row.Name or "?") .. (me and "  (you)" or ""), "Title", 23, me and Theme.Lighten(GOLD, 0.35) or WHITE, {
					Position = UDim2.fromOffset(62, 0),
					Size = UDim2.new(1, -220, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				})
				makeText(frame, "Trophies", G.Trophy .. " " .. commas(row.Trophies or 0), "Display", 26, C.Power, {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 0),
					Size = UDim2.new(0, 160, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Right,
				})
			end
		end
		if #list == 0 then
			wrapText(ui.LeaderScroll, "Empty", "The leaderboard fills up as soon as the arena reports in.", "Body", 19, MUTED, 1)
		end
		if not meShown and LocalPlayer then
			wrapText(ui.LeaderScroll, "Mine", "You: " .. G.Trophy .. " " .. commas(battleData().Trophies or 0) .. " trophies. Win duels to climb the board!", "Heading", 20, C.Power, 20)
		end
		Ring.leaderSection(ui.LeaderScroll, 25)
		local BC = catalog()
		local rules = BC and type(BC.Trophies) == "table" and BC.Trophies or { Win = 20, Loss = -10 }
		local note = inset(ui.LeaderScroll, "HowTo", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 30 })
		pad(note, 14, 10, 14, 12)
		listLayout(note, Enum.FillDirection.Vertical, 4)
		wrapText(note, "Title", "How trophies work", "Heading", 20, WHITE, 1)
		wrapText(note, "Text", "Win a duel: +" .. commas(rules.Win or 20) .. " " .. G.Trophy .. "   Lose one: " .. tostring(rules.Loss or -10) .. " "
			.. G.Trophy .. " (never below 0). Duel on the rings in front of the colosseum, or join the quick queue!", "Body", 19, MUTED, 2)
	end

	win.Refresh = function()
		local tab = S.Tab
		if not ui.Pages[tab] then
			tab = "Duels"
			S.Tab = tab
		end
		for id, frame in pairs(ui.Pages) do
			frame.Visible = id == tab
		end
		for id, button in pairs(ui.TabButtons) do
			CloudUI.SetStyle(button, id == tab and "Red" or "Gray")
		end
		ui.Trophies.Text = G.Trophy .. " " .. commas(battleData().Trophies or 0)
		if tab == "Duels" then
			refreshDuels()
		elseif tab == "Raid" then
			refreshRaid()
		else
			refreshLeaders()
		end
	end
	-- the live numbers (countdowns) without rebuilding the lists
	win.Live = function()
		if S.Tab == "Raid" then
			refreshRaid()
		elseif S.Tab == "Duels" then
			local lobby = S.Lobby or {}
			local queue = type(lobby.Queue) == "table" and lobby.Queue or {}
			if queue.Queued then
				local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
				ui.QueueStatus.Text = "Searching... " .. clock(seconds) .. "   (" .. commas(queue.Waiting or 1) .. " in the queue)"
			end
		end
	end
	return win
end

----------------------------------------------------------------------
-- Side cards (right edge): duel invites, the sent invite, the queue, the raid join card, the event countdown
----------------------------------------------------------------------
local function sideCard(name, accent, order)
	local card = makeFrame(U.Side, name, {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(28, 36, 78),
		Size = UDim2.fromOffset(K.SIDE_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
	})
	corner(card, 14)
	stroke(card, NAVY, 3.5, 0)
	pad(card, 22, 8, 12, 10)
	-- the accent stripe sits in the left padding (the body below holds the card's list)
	local bar = makeFrame(card, "Accent", {
		BackgroundTransparency = 0,
		BackgroundColor3 = accent,
		Position = UDim2.new(0, -14, 0, 0),
		Size = UDim2.new(0, 6, 1, 0),
	})
	round(bar)
	local body = makeFrame(card, "Body", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	listLayout(body, Enum.FillDirection.Vertical, 4)
	return body
end

local function buildSide()
	local gui = CloudUI.NewScreenGui("NimbusArenaSide", K.SIDE_ORDER)
	U.SideGui = gui
	U.Side = makeFrame(gui, "SideStack", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -K.SIDE_BOTTOM),
		Size = UDim2.fromOffset(K.SIDE_W, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	U.SideScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = U.Side })
	listLayout(U.Side, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
	U.SideCards = {}
end

local function relayoutSide()
	if not U.Side then
		return
	end
	local factor = screenFactor()
	U.SideScale.Scale = factor
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local area = guiArea()
	local bottom = (touch and K.SIDE_BOTTOM_TOUCH or K.SIDE_BOTTOM) * factor
	if area.X < area.Y then
		bottom = K.SIDE_BOTTOM_PORTRAIT * factor
	end
	U.Side.Position = UDim2.new(1, -12, 1, -math.floor(bottom + 0.5))
end

-- true while a menu window, the Pet Index or the Fusion window covers the screen (the side cards step back)
local function otherWindowOpen()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "DungeonController", "ObbyController" }) do
		local mod = otherController(name)
		if mod and type(mod.IsOpen) == "function" then
			local ok, open = pcall(mod.IsOpen)
			if ok and open == true then
				return true
			end
		end
	end
	return false
end

-- rebuilds the side cards (cheap: a handful of frames, only when something changed; the clocks tick in place)
local function sideSignature()
	local parts = {}
	local lobby = S.Lobby or {}
	for _, inv in ipairs(type(lobby.Invites) == "table" and lobby.Invites or {}) do
		if type(inv) == "table" then
			parts[#parts + 1] = "i" .. tostring(inv.FromUserId)
		end
	end
	if type(lobby.Sent) == "table" then
		parts[#parts + 1] = "s" .. tostring(lobby.Sent.ToUserId)
	end
	if type(lobby.Queue) == "table" and lobby.Queue.Queued then
		parts[#parts + 1] = "q"
	end
	local raid = raidStatus()
	if raid and (raid.Joinable or raid.Waiting) and not inRaid() then
		parts[#parts + 1] = "r" .. tostring(raid.BossId) .. tostring(inArena())
	end
	local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
	local starts = nextEvent and arenaSeconds(nextEvent.StartsIn)
	if starts and starts <= K.ANNOUNCE and starts > 0 then
		parts[#parts + 1] = "n" .. tostring(nextEvent.Kind)
	end
	local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double
	if double and double.Active then
		parts[#parts + 1] = "d"
	end
	local area = guiArea()
	parts[#parts + 1] = tostring(area.Y < 500 or area.X < area.Y)
	return table.concat(parts, ",")
end

function refreshSide()
	if not U.Side then
		return
	end
	local hidden = inMatch() or battleId() ~= nil or S.Open ~= nil or otherWindowOpen()
	U.Side.Visible = not hidden
	if hidden then
		return
	end
	local sig = sideSignature()
	if sig ~= S.SideSig then
		S.SideSig = sig
		clearChildren(U.Side)
		U.SideCards = {}
		local area = guiArea()
		local maxCards = (area.Y < 500 or area.X < area.Y) and K.SIDE_MAX_CARDS_SHORT or K.SIDE_MAX_CARDS
		local count = 0
		local lobby = S.Lobby or {}
		-- 1. duel invites (most urgent first)
		for i, invite in ipairs(type(lobby.Invites) == "table" and lobby.Invites or {}) do
			if type(invite) == "table" and count < maxCards then
				count = count + 1
				local practice = invite.Practice == true
				local card = sideCard("Invite" .. i, practice and C.Practice or C.Arena, 10 + i)
				card.Parent:SetAttribute("Practice", practice)
				makeText(card, "Title", G.Swords .. (practice and " Practice duel" or " Duel challenge!"), "Heading", 21, practice and C.Practice or Theme.Lighten(C.Arena, 0.4), {
					Size = UDim2.new(1, 0, 0, 28),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 1,
				})
				if practice then
					-- Phase 5 (4.2): a challenge more than Duel.PracticeInvite apart in TeamPower
					makeText(card, "PracticeFlag", "No trophies or rewards", "Body", 18, C.Practice, {
						Size = UDim2.new(1, 0, 0, 22),
						TextXAlignment = Enum.TextXAlignment.Left,
						LayoutOrder = 2,
					})
				end
				makeText(card, "Name", tostring(invite.FromName or "Someone") .. " wants to battle", "Body", 19, WHITE, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = 2,
				})
				local info = makeText(card, "Info", "", "Heading", 18, C.Power, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 3,
				})
				local buttons = makeFrame(card, "Buttons", { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 4 })
				CloudUI.Button({
					Name = "Accept",
					Text = "Accept",
					Size = UDim2.new(0.5, -4, 0, 44),
					Style = "Green",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("ChallengeReply", invite.FromUserId, true)
					end,
				})
				CloudUI.Button({
					Name = "Decline",
					Text = "Decline",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0.5, -4, 0, 44),
					Style = "Gray",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("ChallengeReply", invite.FromUserId, false)
					end,
				})
				local track = makeFrame(card, "Timer", {
					BackgroundTransparency = 0,
					BackgroundColor3 = Color3.fromRGB(14, 20, 48),
					Size = UDim2.new(1, 0, 0, 6),
					LayoutOrder = 5,
				})
				round(track)
				local fill = makeFrame(track, "Fill", { BackgroundTransparency = 0, BackgroundColor3 = C.Arena, Size = UDim2.new(1, 0, 1, 0) })
				round(fill)
				local total = math.max(1, tonumber(invite.ExpiresIn) or 30)
				table.insert(U.SideCards, function()
					local left = lobbySeconds(invite.ExpiresIn) or 0
					info.Text = G.Trophy .. " " .. commas(invite.Trophies or 0) .. "   " .. G.Swords .. " " .. commas(invite.Power or 0) .. "   " .. G.Clock .. " " .. clock(left)
					fill.Size = UDim2.new(Util.Clamp(left / total, 0, 1), 0, 1, 0)
				end)
			end
		end
		-- 2. the invite I sent
		if type(lobby.Sent) == "table" and count < maxCards then
			count = count + 1
			local sent = lobby.Sent
			local card = sideCard("Sent", Color3.fromRGB(110, 118, 146), 20)
			local text = makeText(card, "Text", "", "Body", 19, WHITE, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
			})
			table.insert(U.SideCards, function()
				text.Text = G.Swords .. " Waiting for " .. tostring(sent.ToName or "them") .. " to accept... " .. clock(lobbySeconds(sent.ExpiresIn) or 0)
			end)
		end
		-- 3. the quick queue
		if type(lobby.Queue) == "table" and lobby.Queue.Queued and count < maxCards then
			count = count + 1
			local queue = lobby.Queue
			local card = sideCard("Queue", C.Next, 30)
			local row = makeFrame(card, "Row", { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1 })
			local text = makeText(row, "Text", "", "Body", 20, WHITE, {
				Size = UDim2.new(1, -112, 1, 0),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			CloudUI.Button({
				Name = "Leave",
				Text = "Leave",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(104, 42),
				Style = "Gray",
				TextSize = 20,
				Parent = row,
				Callback = function()
					request("Unqueue")
				end,
			})
			table.insert(U.SideCards, function()
				local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
				text.Text = "Finding a duel... " .. clock(seconds)
			end)
		end
		-- 4. the raid join card
		local raid = raidStatus()
		if raid and (raid.Joinable or raid.Waiting) and not inRaid() and count < maxCards then
			count = count + 1
			local card = sideCard("Raid", C.Boss, 40)
			makeText(card, "Title", G.Skull .. " BOSS RAID: " .. tostring(raid.Name or (bossInfo(raid.BossId) or {}).Name or "Boss"), "Heading", 21, Theme.Lighten(C.Boss, 0.45), {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = 1,
			})
			local line = makeText(card, "Line", "", "Body", 19, WHITE, {
				Size = UDim2.new(1, 0, 0, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 2,
			})
			local here = inArena()
			if here == false then
				makeText(card, "Where", "Head to the Battle Arena to join!", "Body", 19, C.WarnText, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 3,
				})
			else
				local buttons = makeFrame(card, "Buttons", { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3 })
				CloudUI.Button({
					Name = "Join",
					Text = "JOIN RAID",
					Size = UDim2.new(0.62, -4, 0, 44),
					Style = "Red",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("JoinRaid")
					end,
				})
				CloudUI.Button({
					Name = "Info",
					Text = "Info",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0.38, -4, 0, 44),
					Style = "Blue",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						ArenaController.OpenArena("Raid")
					end,
				})
			end
			table.insert(U.SideCards, function()
				local r = raidStatus() or raid
				line.Text = commas(r.Players or 0) .. " fighting " .. G.Bullet .. " join closes in " .. clock(arenaSeconds(r.JoinEndsIn) or 0)
			end)
		end
		-- 5. the event countdown chip (always last: closest to the hotbar corner)
		local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
		local starts = nextEvent and arenaSeconds(nextEvent.StartsIn)
		local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double
		local showNext = starts and starts <= K.ANNOUNCE and starts > 0
		if showNext or (double and double.Active) then
			local chip = makeFrame(U.Side, "Countdown", {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(28, 36, 78),
				Size = UDim2.fromOffset(0, 46),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = 90,
			})
			corner(chip, 23)
			stroke(chip, GOLD, 3, 0)
			pad(chip, 14, 0, 16, 0)
			listLayout(chip, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
			local label = autoText(chip, "Text", "", "Heading", 20, WHITE, 1)
			local clockLabel = autoText(chip, "Clock", "", "Display", 26, C.Power, 2)
			table.insert(U.SideCards, function()
				local s2 = nextEvent and arenaSeconds(nextEvent.StartsIn)
				if s2 and s2 <= K.ANNOUNCE and s2 > 0 then
					label.Text = (nextEvent.Kind == "DoubleRewards" and (G.Double .. "2 Rewards in") or (G.Skull .. " Boss Raid in"))
					clockLabel.Text = clock(s2)
				elseif double and double.Active then
					label.Text = G.Double .. "2 Rewards"
					clockLabel.Text = clock(arenaSeconds(double.EndsIn) or 0)
				end
			end)
		end
	end
	for _, tick in ipairs(U.SideCards) do
		pcall(tick)
	end
end

----------------------------------------------------------------------
-- Opening / closing
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		ArenaController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function syncBackBinding()
	local want = S.Open ~= nil
	if want == S.BackBound then
		return
	end
	S.BackBound = want
	if want then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		task.defer(function()
			if not S.BackBound then
				pcall(function()
					ContextActionService:UnbindAction(K.BACK_ACTION)
				end)
			end
		end)
	end
end

local function closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "DungeonController", "ObbyController" }) do
		local mod = otherController(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function refreshOpen()
	local win = S.Open and Win[S.Open]
	if win and win.Refresh then
		safe("refresh " .. S.Open, win.Refresh)
	end
	refreshSide()
end

local function ensureWindow(id)
	if S.Built[id] then
		return Win[id]
	end
	S.Built[id] = true
	local ok, result
	if id == "Ring" then
		ok, result = pcall(Ring.build)
	else
		ok, result = pcall(buildArena)
	end
	if not ok then
		warnOnce("build " .. id, result)
		return nil
	end
	return result
end

local function open(id)
	if not initialized then
		ArenaController.Init()
	end
	if not U.Gui or inMatch() then
		return false
	end
	local win = ensureWindow(id)
	if not win then
		return false
	end
	local was = S.Open
	if was and was ~= id and Win[was] then
		Win[was].Holder.Visible = false
	end
	if not was then
		closeOthers()
	end
	S.Open = id
	S.Token = S.Token + 1
	syncBackBinding()
	win.W = nil -- re-run the layout for the current screen
	layoutWindow(win)
	win.Holder.Visible = true
	if was ~= id then
		win.Pop.Scale = 0.86
		tween(win.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	refreshOpen()
	if was ~= id then
		ArenaController.Opened:Fire(id)
	end
	return true
end

function ArenaController.OpenArena(tab)
	S.Tab = normalizeTab(tab) or S.Tab or "Duels"
	return open("Arena")
end

function ArenaController.OpenRing(start, portal)
	local n = tonumber(start)
	if n then
		Ring.Start = math.floor(n)
	elseif S.Open ~= "Ring" then
		local best = Ring.record()
		local starts = Ring.starts(best)
		local keep = false
		for _, r in ipairs(starts) do
			keep = keep or (Ring.Picked and r == Ring.Start)
		end
		if not keep then
			Ring.Start = starts[#starts] -- the latest beaten boss round, else round 1 (a round the kid picked stays)
		end
	end
	Ring.Refusal = nil
	Ring.Pending = false
	S.RingAt = (typeof(portal) == "Instance") and portal or nil
	return open("Ring")
end

function ArenaController.Close()
	if not S.Open then
		return
	end
	local id = S.Open
	local win = Win[id]
	S.Open = nil
	S.RingAt = nil
	Ring.Pending = false
	S.Token = S.Token + 1
	local mine = S.Token
	syncBackBinding()
	if win then
		tween(win.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.13, function()
			if S.Token == mine and S.Open ~= id and win.Holder then
				win.Holder.Visible = false
			end
		end)
	end
	avoidRight(nil)
	refreshSide()
	ArenaController.Closed:Fire(id)
end

function ArenaController.IsOpen()
	return S.Open ~= nil
end

function ArenaController.GetState()
	return { Arena = S.Arena, Lobby = S.Lobby, Window = S.Open, Tab = S.Tab, RingStart = Ring.Start }
end

function ArenaController.Request(action, a, b)
	return request(action, a, b)
end

----------------------------------------------------------------------
-- Server messages
----------------------------------------------------------------------
local function onArenaState(state)
	if type(state) ~= "table" then
		return
	end
	S.Arena = state
	S.ArenaAt = os.clock()
	if S.Open == "Arena" then
		refreshOpen()
	else
		refreshSide()
	end
end

local function onBattleState(kind, payload)
	if kind == "Lobby" and type(payload) == "table" then
		S.Lobby = payload
		S.LobbyAt = os.clock()
		if S.Open == "Arena" and S.Tab == "Duels" then
			refreshOpen()
		else
			refreshSide()
		end
	elseif kind == "Start" and type(payload) == "table" and payload.Spectator ~= true and (payload.Side or 1) ~= 0 then
		-- my battle began: the windows step aside
		Ring.Pending = false
		ArenaController.Close()
	elseif kind == "End" and type(payload) == "table" and payload.Spectator ~= true then
		task.delay(0.5, refreshSide)
	end
end

local function onPromptTriggered(prompt)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") then
		return
	end
	local panel = prompt:GetAttribute("OpenPanel")
	if panel == "Ring" or prompt:GetAttribute("OpenPanelTab") == "Ring" then
		-- Portal_Ring's RingPrompt
		ArenaController.OpenRing(nil, prompt.Parent)
	elseif panel == "Dungeon" then
		-- Phase 5 (5.3): Portal_Dungeon's DungeonPrompt is handed to DungeonController (the Dungeon side panel)
		local dungeon = otherController("DungeonController")
		if dungeon and type(dungeon.Open) == "function" then
			ArenaController.Close()
			dungeon.Open(nil, prompt.Parent)
		end
	elseif panel == "Arena" then
		local tab = prompt:GetAttribute("OpenPanelTab")
		if tab == nil and prompt:GetAttribute("RingIndex") ~= nil then
			tab = "Duels"
		end
		ArenaController.OpenArena(tab)
	end
end

local function connectOthers()
	local function hook(name, signalName)
		local mod = otherController(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(windowId)
				if windowId ~= nil and (windowId == "Arena" or windowId == "Ring") then
					return
				end
				ArenaController.Close()
				if name == "MenuController" and windowId == "Team" then
					-- the Champion Ring record line on the Team screen (after its first layout)
					task.defer(function()
						safe("team line", Ring.teamLine)
					end)
				end
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
	hook("CareController", "Opened")
	hook("DungeonController", "Opened")
	hook("ObbyController", "Opened")
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function ArenaController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)

	local gui = CloudUI.NewScreenGui("NimbusArena", K.DISPLAY_ORDER)
	U.Gui = gui
	buildSide()
	relayoutSide()
	-- the hint (right edge, a third down: clear of the toasts at the top and the side cards at the bottom)
	U.HintGui = gui
	U.HintFrame = makeFrame(gui, "Hint", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(28, 36, 78),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.36, 0),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Visible = false,
		ZIndex = 20,
	})
	corner(U.HintFrame, 12)
	stroke(U.HintFrame, GOLD, 3, 0)
	pad(U.HintFrame, 14, 8, 14, 8)
	U.HintScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = U.HintFrame })
	U.HintLabel = makeText(U.HintFrame, "Text", "", "Heading", 20, WHITE, {
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 21,
	})

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", function()
			relayoutSide()
			S.SideSig = nil
			if S.Open and Win[S.Open] then
				layoutWindow(Win[S.Open])
				refreshOpen()
			else
				refreshSide()
			end
		end)
	end)
	State.Changed:Connect(function()
		safe("State.Changed", refreshOpen)
		safe("team line", Ring.teamLine)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if inMatch() then
				ArenaController.Close()
			end
			safe("InMatch", refreshSide)
		end)
		LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.InBattle) or K.ATTR_IN_BATTLE):Connect(function()
			S.SideSig = nil
			safe("InBattle", refreshOpen)
		end)
	end
	Players.PlayerAdded:Connect(function()
		if S.Open == "Arena" and S.Tab == "Duels" then
			safe("players", refreshOpen)
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if S.Open == "Arena" and S.Tab == "Duels" then
			task.defer(function()
				safe("players", refreshOpen)
			end)
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			ArenaController.Close()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", onPromptTriggered, prompt)
	end)

	task.spawn(function()
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) ~= "string" then
					return
				end
				args = type(args) == "table" and args or {}
				local key = panelId:lower()
				if key == "ring" then
					safe("OpenPanel", ArenaController.OpenRing, args.Start)
				elseif key == "arena" or key == "duels" or key == "raid" or key == "leaderboard" then
					local tab = args.Tab or ((key ~= "arena") and panelId or nil)
					safe("OpenPanel", ArenaController.OpenArena, tab)
				end
			end)
		end
		local okArena, arenaRemote = pcall(Remotes.Get, "ArenaState")
		if okArena and arenaRemote then
			arenaRemote.OnClientEvent:Connect(function(state)
				safe("ArenaState", onArenaState, state)
			end)
		end
		local okNotify, notifyRemote = pcall(Remotes.Get, "Notify")
		if okNotify and notifyRemote then
			notifyRemote.OnClientEvent:Connect(function(text)
				safe("Notify", Ring.onNotify, text)
			end)
		end
		local okBattle, battleRemote = pcall(Remotes.Get, "BattleState")
		if okBattle and battleRemote then
			battleRemote.OnClientEvent:Connect(function(kind, payload)
				safe("BattleState", onBattleState, kind, payload)
			end)
		end
	end)
	task.defer(function()
		safe("hooks", connectOthers)
	end)

	-- one light loop: countdowns, walk-away, the side cards' clocks (4 times a second)
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + K.TICK
		if S.Open == "Ring" and S.RingAt then
			local d = Ring.distance()
			if d and d > K.WALK_AWAY then
				ArenaController.Close()
				return
			end
		end
		if S.Open == "Arena" and Win.Arena and Win.Arena.Live then
			safe("live", Win.Arena.Live)
		elseif S.Open == "Ring" and Win.Ring and Win.Ring.Live then
			safe("ring live", Win.Ring.Live)
		end
		safe("zone", Ring.zoneTick)
		safe("side", refreshSide)
	end)
end

return ArenaController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="869">
            <Properties>
              <string name="Name">BattleController</string>
              <string name="Source"><![CDATA[-- BattleController (client; Phase 3 battleclient, Phase 5 rewrite of the HUD + controls): draws every pet battle the
-- server simulates and gives the local player the fighter's controls (ARCHITECTURE_V3.md "Phase 5 build contract" 4.7
-- and 3.9; the drawing / effects / unit cards / Ring cards of Phases 3-4 are kept). The server simulates, the clients
-- draw: nothing here is authoritative (Y1). Battle units are built locally (PetBuilder for pets, BossBuilder for raid
-- bosses) and animated between the server's 10 Hz snapshots (Replication rule).
--
-- API
--   BattleController.Init()                 connects BattleState, the frame loop and the input (once)
--   BattleController.Stop()                 tears everything down (tests / hot reload)
--   BattleController.HandleState(kind, payload, battleId)   what the BattleState remote does (tests / dump_gui)
--   BattleController.Command(action, arg) -> bool   sends BattleCommand: "Attack" (unitId|nil), "Element", "Special",
--                                           "Dash", "Target" (unitId|nil), "Buff" (slot), "Swap" (slot), "Forfeit",
--                                           with a local throttle and local checks (a refused press shakes its
--                                           button); false when refused here
--   BattleController.Focus(unitId)          lock an enemy (= Command("Target", unitId)); nil clears the lock
--   BattleController.GetBattle() -> { Id, Mode, Side, Spectator, Fighter, Ended, Units, Models, Lock, Focus (= Lock),
--                                     FighterId, Lives, Hud, Layout = "Wide" | "Compact", Cooldowns = { Element, Dash,
--                                     Swap, Buff = { [slot] = s } } (seconds left), Pending = { [action] = true },
--                                     Speed = { Walk, Run }, Dungeon, Threat, Cue ("Dash" | nil), InterpDelay, TeamPlace,
--                                     Round, Best, Next, ... } | nil
--   BattleController.GetUnit(id) -> { Id, Side, Kind, Name, Hp, MaxHp, State, Meter, Model, X, Z, World, Card, Level,
--                                     Evo, Xp, XpNext, Crowned, Writes, Benched, Windup, Drawn (the drawn root position) }
--   BattleController.GetStats() / ResetStats() / IsHudVisible() / ScreenPick(x, y) / GetTelegraphs()   (as Phase 3)
--
-- Messages (BattleState(kind, payload, battleId), sent by BattleService)
--   "Start"    battle:Describe() + Zone + Names + Side (0 = spectator) + Spectator + T + Ring / Dungeon (= the encounter's
--              Extra { Floor, Room, Wave, Waves, Name, Boss }) + Team = { Fighter, Bench, Lives, Speed = { Walk, Run },
--              Cooldowns = { Element, Dash, Swap, Buff = { ["2"] = s, ["3"] = s } } } (seconds left; the Buff keys are
--              STRINGS on the wire). A second "Start" for the same battle (a raid spectator who joins) refreshes it.
--   "Snapshot" { BattleId, T, U = { number... } }: BattleSim:SnapshotDelta's wire form (lives + the windup bit packed in
--              the code); the older { BattleId, T, Units } form (the tools' drivers) is taken as it is.
--   "Events"   BattleSim events (Hit, Special, KO, Telegraph, Spawn, Enrage, Order, Zone, Leave, End, Element, Dash,
--              Buff, Swap, Windup, Wave, EnemiesDown, Speed); a rejected Order reaches only its owner (the shake).
--   "End"      { BattleId, Mode, Result, Rewards, Outcome, Won, Spectator, Reason } (Rewards.Dungeon = true + Extra in
--              the dungeon: no result card for a cleared room, DungeonController shows the loot)
--
-- Drawing (kept from Phases 3-4; the Phase 5 lines marked *)
--   * Snapshots are buffered and drawn INTERP_DELAY seconds behind the estimated server clock; events are queued with
--     their arrival time and played on that delayed clock (lunges, numbers and telegraph impacts line up).
--   * Pets hover over the floor, face their target or path, bob, flap, lunge / shoot bolts, hop on a Pounce; static
--     parts welded to the anchored root once per build (a pose is one root CFrame write); raid boss poses; telegraphs
--     that fill until the dodge deadline then flash; hit flashes, pooled world damage numbers (never screen-centre),
--     KO poofs, special VFX; a PetCard above every pet unit (Phase 4, with the fighter's lives pips *).
--   * The player's CHARACTER is the fighter's body (B1): my fighter (High) is drawn at the shoulder offset (1.8, 0.5,
--     0.6) of the SERVER fighter position, blended toward the character root while the two are within 2 studs and
--     following the server position beyond (lerp 0.35 per 60 Hz frame), so what looks in reach is in reach. My two
--     helpers (Low) hover behind me at (-2, 1.2, 2) / (2, 1.2, 2), fly to the fighter on a Buff (0.6 s) and trade
--     places with it on a Swap (0.5 s). Other players' helpers are not drawn (~1 unit per player in a 16-raid).
--   * Enemies wind up visibly: Winding plays a crouch + a brief yellow Highlight (the dash cue), their list row flashes
--     "!"; "DODGED!" (cyan) on Hit.miss; buff names float above the fighter in the buff's colour; element attacks draw
--     their cone / circle / line; camera shakes x ClientSettings.Get("Shake") (Humanoid.CameraOffset, tiny, rare).
--
-- * The battle HUD (only while the local player fights; ScreenGui "NimbusBattle", designed in 1080p px under one
--   UIScale of Theme.ScreenFactor(), NeonKit cards, fonts via Theme roles, nothing in the screen centre):
--   * Team (top left): the FIGHTER card: name (Heading 26) + "Lv 34" pill + element badge + stars; HP 320 x 22 green
--     with a red loss trail draining 0.4 s behind (TweenService; HP written only on change); ENERGY 320 x 14 blue
--     ("ENERGY 72/100", gold at 100); 3 hearts = lives. Under it the two HELPER portraits (a round PetBuilder Low
--     picture in a ViewportFrame built once, a stroke in the pet's element colour) with "Lv n", the buff cooldown
--     ring (a two-half-disc UIGradient pie, written at 10 Hz), the buff name ("HEAL", "STONE SKIN") and the SWAP chip;
--     KO greys the portrait. Tap a portrait / key 1 / 2 = its buff, hold 0.5 s = swap.
--   * Enemies (right): one 300 x 44 row per living enemy (max 8 + "+n more"): icon disc, name, element stripe, red HP
--     bar; the LOCKED row first with a gold bracket + "TARGET"; a winding enemy's icon flashes "!"; rows reorder only
--     on a KO / a spawn / a lock change.
--   * TopCard (top centre, under the Roblox bar): the mode line "CHAMPION RING - Round 8 - Best 12", "DUNGEON - Floor
--     3 - Room 2" (purple), "DUEL - vs Sam", "BOSS RAID" + the timer; the boss bar (raid boss / dungeon mini-boss) with
--     its element / ENRAGED / minions / players / wave pills; the ring's pay pills.
--   * Commands (bottom right): ATTACK (88), ELEMENT, SPECIAL, DASH (64) round buttons with cooldown rings (SPECIAL =
--     the energy, gold at 100) and key chips on desktop; captions under them on wide screens.
--   * Compact layout (touch, or a screen under 900 x 600 px): a smaller fighter card, the portraits in a column, the
--     enemy list 2 rows, the mode line under the list when the top is full, the cluster a 2 x 2 grid above the jump /
--     RUN buttons (portrait) or left of the jump button (landscape); the menu column hides while fighting.
--   * LEAVE (Champion Ring only; two presses -> "Forfeit"), the ring's next-round side card, the result card (bottom
--     right; top right on phones) with "Lives left" and the dungeon's lines.
-- * Prediction: a press starts its button's ring at once and records St.pending; the matching event within 0.6 s
--   confirms it, a rejected Order (owner-only) or the timeout puts the ring back and shakes the button. HP, numbers,
--   kills and the meter are never predicted. Late joiners get their cooldowns from Start.Team.Cooldowns.
-- * MovementController (3.9 / 4.4, dungeon fixes 5): on Start SetPetDash(fn) (Shift / B = the PET's dash: "Dash" only,
--   no character impulse, no stamina; RUN on Ctrl) and SetBattleSpeed(walk, run) (again on every Speed event); both
--   reset on End.
-- * Dungeon fixes (docs/dungeon-fixes/plan.md): enemies spawned after "Start" come in Wave / Spawn events and are
--   added there (root cause A); an enemy whose info says Arrive > 0 arrives with EvolutionFx.Arrive (the model hidden
--   until the flash, then a hop); the fighter attacks by itself (server): ATTACK sends one "Attack" order per press
--   (the enemy clicked / under the screen centre while MouseLock holds the cursor, else nil = the nearest / the next),
--   no hold repeat, no predicted swing (lunges from the server's Hits); the gold arrow shows the enemy the pet attacks
--   (the lock, else its snapshot target, see-through); Dash events draw the pet's dash (mine on arrival); ELEMENT's E
--   passes to a shown ProximityPrompt; MouseLock.Hold / Release ("BattleResult", "BattleLeave") via a pcall'd require.
-- Keys (ContextActionService, High priority, sunk, bound ONLY while fighting and inert before UiGate.HasPlayed()):
-- F / X attack (pick the target), E / Y element (E passes while a prompt is shown), Q / RB special, Tab / T / RT / LT
-- lock, 1 / 2 (LB / D-up) buff (hold = swap), D-left / D-right swap; the item hotbar keeps 1-4 outside battles.
--
-- Cost: one RenderStepped connection, alive only while a battle is drawn or effects play. Per frame: one root CFrame
-- write per pet + PetBuilder.Animate per visible pet (strided for far / crowded ones; a strided frame moves the
-- animated parts with the root in one BulkMoveTo), one BossBuilder.Animate, the pooled
-- effects, HUD writes only when a shown value changes, the rings at 10 Hz. GetStats() reports the measured ms.
-- Plain Lua 5.1-compatible syntax only. Every font comes from a Theme role. No asset ids.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent

-- optional modules (a build without one still draws what it can)
local function optional(parent, name, waitSeconds)
	if not parent then
		return nil
	end
	local inst = parent:FindFirstChild(name)
	if not inst and waitSeconds then
		inst = parent:WaitForChild(name, waitSeconds)
	end
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[BattleController] " .. name .. " failed to load: " .. tostring(result))
	return nil
end

local PetBuilder = optional(Shared, "PetBuilder", 5)
local PetCatalog = optional(Shared, "PetCatalog", 5)
local PetKeys = optional(Shared, "PetKeys")
local BattleCatalog = optional(Shared, "BattleCatalog")
local BattleSim = optional(Shared, "BattleSim") -- constants only (States / Events); the client never simulates
local BossBuilder = nil -- loaded on the first raid (lazyBoss)
-- Phase 4 (optional too): the shared pet card (every unit's card), the local profile mirror (own pets' level / XP
-- after a fight), the XP curve and the voxel kit (the champion's crown)
local Mods = {
	PetCard = optional(Client:FindFirstChild("UI") or Client:WaitForChild("UI", 10), "PetCard", 5),
	NeonKit = optional(Client:FindFirstChild("UI") or Client:WaitForChild("UI", 10), "NeonKit", 5), -- Phase 5: the HUD's kit
	Movement = nil, -- MovementController (lazy: Hud.Movement)
	UiGate = nil, -- client/UiGate (lazy: Input.GateOpen)
	Settings = nil, -- client/ClientSettings (lazy: Me.ShakeScale)
	State = optional(Client, "State", 5),
	Tycoon = optional(Shared, "TycoonCatalog"),
	Voxel = optional(Shared, "Voxel"),
	Mesh = nil, -- shared/MeshLibrary (lazy: Units.FxMesh); false = unavailable
	Evo = nil, -- client/Controllers/EvolutionFx (lazy: Units.EvoFx, the enemies' arrival)
	MouseLock = nil, -- client/MouseLock (lazy, optional: Me.MouseHold); false = not there (yet)
}

local BattleController = {}
-- test hooks (smoke tests only): Gate() -> bool replaces UiGate.HasPlayed, Shake() -> bool replaces the Shake setting
BattleController.Hooks = {}

local LocalPlayer = Players.LocalPlayer
local sin, cos, sqrt, abs, floor, max, min, exp, pi = math.sin, math.cos, math.sqrt, math.abs, math.floor, math.max, math.min, math.exp, math.pi
local atan2 = math.atan2 or function(y, x)
	return math.atan(y, x)
end
local TAU = pi * 2

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local K = {
	GUI_NAME = "NimbusBattle",
	DISPLAY_ORDER = 12, -- above the HUD (10) and the hotbar (11), below windows (20) and toasts (30)
	FOLDER = "ClientBattle", -- workspace folder of the drawn battles
	INTERP_DELAY = 0.12, -- seconds behind the server clock (snapshots arrive every 0.1 s)
	INTERP_DELAY_SPECTATOR = 0.25, -- spectators get snapshots at 5 Hz (BattleService), so they draw further behind
	-- telegraph deadline: the fill completes when a RETREAT pressed now still reaches the server TELE_RUNOUT seconds
	-- before the hit (the pets need that long to run out: sim_battle "dodge", a 2.2 s telegraph escaped ~90% with a
	-- RETREAT 1.2-1.4 s after the warning); after that the shape flashes until the impact
	TELE_RUNOUT = 0.8,
	TELE_MIN_FILL = 0.5, -- seconds: the fill never gets shorter than this (a very slow connection)
	PING_DEFAULT = 0.1, -- round trip assumed when Player:GetNetworkPing is unavailable
	PING_MAX = 0.5,
	THREAT_PAD = 1.5, -- studs around a pet's centre that count as "in the shape" for the RETREAT! cue
	OFFSET_RATE = 0.1, -- clock offset filter
	MAX_SNAPS = 8,
	PET_SCALE = 1.3, -- battle pets are a little bigger than followers, so they read from the stands
	HOVER = 0.55, -- studs between the floor and a pet's lowest point
	BOB = 0.18,
	FACE_RATE = 10,
	LUNGE_TIME = 0.26,
	LUNGE_DIST = 1.5,
	RECOIL_DIST = 0.35,
	HOP_TIME = 0.4,
	HOP_HEIGHT = 2.6,
	KO_PARK = 0.3, -- seconds after a KO before the downed pet is parked (the poof covers it)
	BUILD_BUDGET = 0.006, -- seconds of model building per frame (the first build of a frame always runs)
	BUILD_MAX = 4,
	CROWD = 14, -- more units than this: other players' / enemy pets are drawn every other frame
	ANIM_MID = 90, -- studs from the camera: beyond this, other players' / enemy pets are drawn every 3rd frame ...
	ANIM_FAR = 160, -- ... and beyond this every 4th (a whole pet at once: root + wings, so nothing comes apart)
	MAX_FX_PARTS = 260,
	POOL_KEEP = 160,
	MAX_NUMBERS = 26,
	MAX_FLASHES = 8,
	FLASH_TIME = 0.2,
	NUMBER_TIME = 0.95,
	NUMBER_RISE = 2.6,
	NUMBER_PX = 26, -- 1080p pixel size of a damage number (World text rule: >= 22)
	CRIT_PX = 32,
	CALLOUT_PX = 26,
	NUMBER_DISTANCE = 170,
	BAR_DISTANCE = 140,
	END_LINGER = 3.5, -- seconds the floor stays drawn after the end
	SPECTATOR_LINGER = 1.5,
	RESULT_SECONDS = 12,
	CMD_GAP = 0.25, -- local throttle between two commands of a kind
	TAP_TIME = 0.35,
	TAP_MOVE = 14, -- px
	TAP_REACH = 64, -- px (1080p, scaled) around an enemy's centre on the screen
	ACTION_ATTACK = "NimbusBattleAttack",
	ACTION_ELEMENT = "NimbusBattleElement",
	ACTION_SPECIAL = "NimbusBattleSpecial",
	ACTION_TARGET = "NimbusBattleTarget",
	ACTION_HELPER = "NimbusBattleHelper",
	ATTACK_GAP = 0.2, -- local throttle of ATTACK (the hold repeats at the fighter's interval)
	CD_SLACK = 0.15, -- a press this close to the end of a cooldown is sent (the server's clock decides)
	PENDING_TIMEOUT = 0.6, -- seconds a prediction waits for its event
	SWAP_HOLD = 0.5, -- hold a helper key / portrait this long = swap
	RING_DT = 0.1, -- the rings / countdowns are written at 10 Hz
	LOSS_TIME = 0.4, -- the red HP loss trail drains this long behind a loss
	-- the drawn fighter / helpers (B1, 4.7)
	SHOULDER = Vector3.new(1.8, 0.5, 0.6), -- the fighter's offset from the character (right, up, back)
	BLEND_DIST = 2, -- within this many studs the drawn fighter blends toward the character root
	FOLLOW_LERP = 0.35, -- per 60 Hz frame toward the server position beyond BLEND_DIST
	HELPER_A = Vector3.new(-2, 1.2, 2),
	HELPER_B = Vector3.new(2, 1.2, 2),
	BUFF_FLY = 0.6, -- a helper flies to the fighter and back on its Buff
	SWAP_TIME = 0.5, -- fighter and helper trade places
	DASH_TIME = 0.35, -- the drawn PET dash (dungeon fixes decision 5): out and back along the Dash event's direction
	DASH_DIST = 4.5, -- studs
	WINDUP_FLASH = 0.35, -- the yellow Highlight of a wind-up
	SHAKE_MAX = 0.35, -- studs of camera shake at most (x ClientSettings Shake)
	-- HUD geometry (design px at 1080p)
	COMPACT_W = 900, -- screen px: narrower (or touch) = the compact phone layout
	COMPACT_H = 600,
	EDGE = 12,
	PAD = 10,
	FC_W = 352, -- the fighter card (bars 320)
	FC_H = 130,
	FC_W_COMPACT = 252, -- (bars 232)
	PORTRAIT = 64,
	PORTRAIT_COMPACT = 48,
	RING = 74,
	HELPER_W = 122,
	HELPER_W_COMPACT = 150,
	ROW_W = 300,
	ROW_H = 44,
	ROW_W_COMPACT = 210,
	ROW_H_COMPACT = 40,
	ROW_GAP = 6,
	ROWS_MAX = 8,
	ROWS_COMPACT = 2,
	TOP_W = 470,
	TOP_W_COMPACT = 300,
	MODE_H = 40,
	ATTACK_D = 88,
	ACTION_D = 64,
	MIN_TEXT_PX = 14, -- no HUD text is ever drawn smaller on the screen (Readability rule)
	RESULT_W = 440,
	-- LEAVE (Ring only): the first press arms it for LEAVE_CONFIRM seconds, the second sends "Forfeit"
	LEAVE_CONFIRM = 3,
	LEAVE_W = 150,
	LEAVE_H = 52,
	LEAVE_W_COMPACT = 150,
	LEAVE_W_TOP = 100, -- a landscape phone: right of the mode card
	LEAVE_H_COMPACT = 46,
	LEAVE_CARD_W = 230,
}

local STATES = (BattleSim and BattleSim.States) or { Idle = 0, Moving = 1, Attacking = 2, Benched = 3, Casting = 4, Down = 5, Stunned = 6, Dashing = 7 }
local S_DOWN, S_STUNNED, S_CASTING, S_ATTACKING = STATES.Down, STATES.Stunned, STATES.Casting, STATES.Attacking
local S_BENCHED, S_DASHING, S_MOVING = STATES.Benched or 3, STATES.Dashing or 7, STATES.Moving or 1
local EV = (BattleSim and BattleSim.Events) or {
	Hit = "Hit", Special = "Special", KO = "KO", Telegraph = "Telegraph", Spawn = "Spawn", Enrage = "Enrage",
	Order = "Order", Zone = "Zone", Leave = "Leave", End = "End",
}

local METER_MAX = tonumber(BattleCatalog and type(BattleCatalog.Fighter) == "table" and BattleCatalog.Fighter.SpecialMeterMax) or 100
local SPECIALS = (BattleCatalog and BattleCatalog.Specials) or {}

local COLORS = {
	Mine = Theme.Colors.Health,
	Ally = Color3.fromRGB(98, 172, 232),
	Enemy = Color3.fromRGB(236, 88, 100),
	Gold = Theme.Colors.Gold or Color3.fromRGB(244, 196, 78),
	Heal = Color3.fromRGB(120, 230, 140),
	Shield = Color3.fromRGB(150, 210, 255),
	Ice = Color3.fromRGB(170, 228, 255),
	Weak = Color3.fromRGB(176, 190, 214),
	Strong = Color3.fromRGB(255, 150, 70),
	White = Color3.fromRGB(255, 255, 255),
	Ink = Theme.Colors.TextStroke or Color3.fromRGB(16, 22, 50),
	Panel = Theme.Colors.Panel,
	PanelLight = Theme.Colors.PanelLight,
	Navy = Theme.Colors.Navy or Color3.fromRGB(24, 34, 78),
	Muted = Theme.Colors.Muted or Color3.fromRGB(212, 224, 246),
	Track = Color3.fromRGB(28, 36, 76),
	Storm = Color3.fromRGB(72, 78, 108),
	LateRim = Color3.fromRGB(255, 70, 60), -- a telegraph past its dodge deadline flashes in this
	Wait = Color3.fromRGB(150, 132, 84), -- a SPECIAL with a full meter that waits for ATTACK
	StormLight = Color3.fromRGB(112, 118, 150),
	-- Phase 5 HUD (the Neon kit colours)
	HpGreen = Theme.Neon and Theme.Neon.Green or Color3.fromRGB(72, 224, 120),
	Loss = Color3.fromRGB(236, 60, 72),
	Energy = Theme.Neon and Theme.Neon.Blue or Color3.fromRGB(64, 170, 255),
	EnergyText = Color3.fromRGB(150, 206, 255),
	Life = Color3.fromRGB(255, 86, 112),
	LifeLost = Color3.fromRGB(70, 76, 108),
	LevelPill = Color3.fromRGB(44, 60, 120),
	SwapEdge = Theme.Neon and Theme.Neon.Cyan or Color3.fromRGB(64, 226, 236),
	Alert = Color3.fromRGB(255, 226, 90),
	Dodge = Color3.fromRGB(110, 236, 255),
	Windup = Color3.fromRGB(255, 220, 60),
	Action = {
		Attack = Theme.Neon and Theme.Neon.Red or Color3.fromRGB(255, 76, 100),
		Element = Theme.Neon and Theme.Neon.Blue or Color3.fromRGB(64, 170, 255),
		Special = Theme.Neon and Theme.Neon.Gold or Color3.fromRGB(255, 196, 64),
		Dash = Theme.Neon and Theme.Neon.Cyan or Color3.fromRGB(64, 226, 236),
	},
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local St = {
	initialized = false,
	battle = nil, -- the drawn battle (see newBattle)
	old = {}, -- battles that ended and still fade out: { battle, until }
	conns = {}, -- long-lived connections
	loop = nil, -- RenderStepped connection (only while needed)
	folder = nil, -- workspace.ClientBattle
	fxFolder = nil,
	pool = {}, -- free effect parts
	fxLive = 0,
	effects = {}, -- live effects
	numbers = {}, -- live numbers
	numberPool = {},
	flashes = {}, -- live flashes
	flashPool = {},
	lastCmd = {}, -- [action .. arg] = os.clock()
	bound = false, -- ContextActionService bindings active
	gamepad = false, -- the last input was a gamepad
	tap = nil, -- { pos, t } a press that may become a tap
	frameNo = 0,
	perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} },
	warned = {},
	remoteCmd = nil,
	result = nil, -- result card timer
	prompts = {}, -- [ProximityPrompt] = true while shown to me (E passes through to it: Input.PromptShown)
	mouseHolds = {}, -- [reason] = true: our client/MouseLock holds (the cursor is free)
	holds = {}, -- [key] = { index, t, fired }: a helper key / portrait held (0.5 s = swap)
	movementOn = false, -- MovementController's battle switches are set
	shake = nil, -- { t0, dur, amp } camera shake
}

local Hud = {} -- the battle HUD (built once, lazily)
local Fx = {} -- pooled effects
local Units = {} -- battle units
local Tele = {} -- telegraphs and zones
local Input = {} -- keys, gamepad, taps
local Net = {} -- messages
local Cards = {} -- Phase 4: the PetCard above every battle unit
local Ring = {} -- Phase 4: the Champion Ring HUD (round / record / next-round side card / run card)
local Leave = {} -- LEAVE (two presses -> BattleCommand "Forfeit"): Champion Ring runs only
local Me = {} -- Phase 5: my fighter at the character's shoulder, my helpers behind me, the camera shake

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp(x, lo, hi)
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

local function warnOnce(key, message)
	if St.warned[key] then
		return
	end
	St.warned[key] = true
	warn("[BattleController] " .. tostring(message))
end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function wrapAngle(a)
	return (a + pi) % TAU - pi
end

local function elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	if info and typeof(info.Color) == "Color3" then
		return info.Color
	end
	return Color3.fromRGB(170, 180, 200)
end

local function myUserId()
	return LocalPlayer and LocalPlayer.UserId or 0
end

-- seconds the drawing runs behind the estimated server clock (spectators get 5 Hz snapshots)
local function interpDelay(B)
	return (B and B.Spectator) and K.INTERP_DELAY_SPECTATOR or K.INTERP_DELAY
end

-- the round trip to the server in seconds (Player:GetNetworkPing), clamped; a default when unavailable
local function networkPing()
	local ok, v = pcall(function()
		return LocalPlayer:GetNetworkPing()
	end)
	if ok and type(v) == "number" and v == v and v >= 0 then
		return clamp(v, 0, K.PING_MAX)
	end
	return K.PING_DEFAULT
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function fmtTime(seconds)
	seconds = max(0, floor(seconds + 0.5))
	return string.format("%d:%02d", floor(seconds / 60), seconds % 60)
end

local function lazyBoss()
	if BossBuilder == nil then
		BossBuilder = optional(Shared, "BossBuilder") or false
	end
	return BossBuilder or nil
end

local function battleFolder()
	if St.folder and St.folder.Parent == workspace then
		return St.folder
	end
	local f = workspace:FindFirstChild(K.FOLDER)
	if not f then
		f = make("Folder", { Name = K.FOLDER }, workspace)
	end
	St.folder = f
	return f
end

local function fxFolder()
	if St.fxFolder and St.fxFolder.Parent then
		return St.fxFolder
	end
	St.fxFolder = make("Folder", { Name = "Fx" }, battleFolder())
	return St.fxFolder
end

----------------------------------------------------------------------
-- Effects: pooled voxel parts
----------------------------------------------------------------------
function Fx.Part(color, material, transparency)
	local p = table.remove(St.pool)
	if not p then
		if St.fxLive >= K.MAX_FX_PARTS then
			return nil
		end
		p = make("Part", {
			Name = "BattleFx",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Massless = true,
			TopSurface = Enum.SurfaceType.Smooth,
			BottomSurface = Enum.SurfaceType.Smooth,
		})
	end
	St.fxLive = St.fxLive + 1
	p.Shape = Enum.PartType.Block
	p.Material = material or Enum.Material.Neon
	p.Color = color or COLORS.White
	p.Transparency = transparency or 0
	p.Parent = fxFolder()
	return p
end

function Fx.Free(p)
	if not p then
		return
	end
	St.fxLive = max(0, St.fxLive - 1)
	if #St.pool < K.POOL_KEEP then
		p.Parent = nil
		St.pool[#St.pool + 1] = p
	else
		p:Destroy()
	end
end

-- registers a live effect: update(e, p, now) -> nothing; e.parts are freed when it ends
function Fx.Add(dur, update, parts, data)
	local e = data or {}
	e.t0 = os.clock()
	e.dur = dur
	e.update = update
	e.parts = parts or {}
	St.effects[#St.effects + 1] = e
	BattleController._wake()
	return e
end

local function burstUpdate(e, p)
	local t = p * e.dur
	local g = e.gravity
	local fade = p * p
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		local x = e.ox + v[1] * t
		local y = e.oy + v[2] * t - 0.5 * g * t * t
		local z = e.oz + v[3] * t
		local a = v[4] * t
		local c, s = cos(a), sin(a)
		part.CFrame = CFrame.new(x, y, z, c, 0, s, 0, 1, 0, -s, 0, c)
		local size = e.size * (1 - 0.7 * p)
		part.Size = Vector3.new(size, size, size)
		part.Transparency = e.alpha + (1 - e.alpha) * fade
	end
end

-- a burst of voxel cubes flying out of `pos`
function Fx.Burst(pos, color, count, speed, size, dur, opts)
	opts = opts or {}
	local parts, vel = {}, {}
	local rnd = math.random
	for i = 1, count do
		local c = color
		if opts.color2 and i % 2 == 0 then
			c = opts.color2
		end
		local part = Fx.Part(c, opts.material, opts.alpha or 0)
		if not part then
			break
		end
		local a = rnd() * TAU
		local up = (opts.up or 0.6) + rnd() * 0.6
		local sp = speed * (0.55 + rnd() * 0.6)
		parts[#parts + 1] = part
		vel[#vel + 1] = { cos(a) * sp, up * sp, sin(a) * sp, (rnd() - 0.5) * 12 }
		part.Size = Vector3.new(size, size, size)
		part.CFrame = CFrame.new(pos)
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, burstUpdate, parts, {
		ox = pos.X, oy = pos.Y, oz = pos.Z, vel = vel, size = size, gravity = opts.gravity or 18, alpha = opts.alpha or 0,
	})
end

local function ringUpdate(e, p)
	local r = e.r * (0.25 + 0.75 * (1 - (1 - p) * (1 - p)))
	local n = #e.parts
	for i, part in ipairs(e.parts) do
		local a = (i / n) * TAU + e.spin * p
		part.CFrame = CFrame.new(e.ox + cos(a) * r, e.oy + 0.3 + 0.6 * p, e.oz + sin(a) * r)
		part.Transparency = e.alpha + (1 - e.alpha) * p
	end
end

-- a ring of cubes that expands from `pos` to radius r (shock waves)
function Fx.Ring(pos, r, color, count, size, dur, alpha)
	local parts = {}
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, alpha or 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size * 0.6, size)
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, ringUpdate, parts, { ox = pos.X, oy = pos.Y, oz = pos.Z, r = r, spin = 0.6, alpha = alpha or 0.1 })
end

local function riseUpdate(e, p)
	local t = p * e.dur
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		part.CFrame = CFrame.new(e.ox + v[1], e.oy + v[2] * t, e.oz + v[3])
		part.Transparency = 0.1 + 0.9 * p * p
	end
end

-- cubes rising around a point (heal sparks)
function Fx.Rise(pos, color, count, size, dur, spread)
	local parts, vel = {}, {}
	local rnd = math.random
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size, size)
		parts[#parts + 1] = part
		local a = rnd() * TAU
		local r = spread * (0.3 + rnd() * 0.7)
		vel[#vel + 1] = { cos(a) * r, 2 + rnd() * 3, sin(a) * r }
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, riseUpdate, parts, { ox = pos.X, oy = pos.Y - 0.6, oz = pos.Z, vel = vel })
end

local function boltUpdate(e, p)
	local q = clamp(p * 1.25, 0, 1)
	local x = e.ax + (e.bx - e.ax) * q
	local y = e.ay + (e.by - e.ay) * q + sin(q * pi) * e.arc
	local z = e.az + (e.bz - e.az) * q
	local core = e.parts[1]
	if core then
		core.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(e.bx, e.by, e.bz))
		core.Transparency = (p > 0.8) and 1 or 0
	end
	local tail = e.parts[2]
	if tail then
		local q2 = max(0, q - 0.12)
		tail.CFrame = CFrame.new(e.ax + (e.bx - e.ax) * q2, e.ay + (e.by - e.ay) * q2 + sin(q2 * pi) * e.arc, e.az + (e.bz - e.az) * q2)
		tail.Transparency = (p > 0.8) and 1 or 0.45
	end
	if p >= 0.8 and not e.landed then
		e.landed = true
		Fx.Burst(Vector3.new(e.bx, e.by, e.bz), e.color, 5, 7, 0.28, 0.35, { up = 0.3, gravity = 10 })
	end
end

-- a voxel bolt flying from a to b (ranged attacks), with a small burst where it lands
function Fx.Bolt(a, b, color, size, dur)
	local core = Fx.Part(color, Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.Size = Vector3.new(size, size, size * 1.8)
	local tail = Fx.Part(color, Enum.Material.Neon, 0.45)
	if tail then
		tail.Size = Vector3.new(size * 0.6, size * 0.6, size * 0.6)
	end
	local dist = (b - a).Magnitude
	return Fx.Add(dur, boltUpdate, { core, tail }, {
		ax = a.X, ay = a.Y, az = a.Z, bx = b.X, by = b.Y, bz = b.Z, arc = min(2.2, dist * 0.08), color = color,
	})
end

local function beamUpdate(e, p)
	local w = e.width * (1 - p * 0.85)
	local core, glow = e.parts[1], e.parts[2]
	if core then
		core.Size = Vector3.new(w * 0.45, w * 0.45, e.length)
		core.Transparency = p * p
	end
	if glow then
		glow.Size = Vector3.new(w, w, e.length)
		glow.Transparency = 0.55 + 0.45 * p
	end
end

-- a straight beam (Beam specials): cf = the beam's centre frame (LookVector along the beam)
function Fx.Beam(cf, length, width, color, dur)
	local core = Fx.Part(COLORS.White:Lerp(color, 0.35), Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.CFrame = cf
	core.Size = Vector3.new(width * 0.45, width * 0.45, length)
	local glow = Fx.Part(color, Enum.Material.Neon, 0.55)
	if glow then
		glow.CFrame = cf
		glow.Size = Vector3.new(width, width, length)
	end
	return Fx.Add(dur, beamUpdate, { core, glow }, { length = length, width = width })
end

local function trailUpdate(e, p)
	for i, part in ipairs(e.parts) do
		local k = i / #e.parts
		part.Transparency = clamp(0.2 + p * 1.2 - k * 0.3, 0, 1)
	end
end

-- a dash trail of fading cubes from a to b (Pounce)
function Fx.Trail(a, b, color, count, dur)
	local parts = {}
	for i = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.2)
		if not part then
			break
		end
		local k = (i - 0.5) / count
		local s = 0.35 + 0.35 * k
		part.Size = Vector3.new(s, s, s)
		part.CFrame = CFrame.new(a:Lerp(b, k) + Vector3.new(0, sin(k * pi) * 1.2, 0))
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, trailUpdate, parts, {})
end

local function zoneUpdate(e, p, now)
	local t = now - e.t0
	local fadeIn = clamp(t / 0.3, 0, 1)
	local fadeOut = clamp((e.dur - t) / 0.4, 0, 1)
	local vis = fadeIn * fadeOut
	local disc = e.parts[1]
	if disc then
		disc.Transparency = 1 - (1 - e.discAlpha) * vis
	end
	if e.cloud then
		-- the storm cloud bobs; bolts strike every 0.5 s
		local bob = sin(t * 2.2) * 0.25
		for i = 2, e.cloudEnd do
			local part = e.parts[i]
			local o = e.offsets[i]
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + o.Y + bob, e.oz + o.Z)
			part.Transparency = 1 - (1 - o.alpha) * vis
		end
		local phase = (t % 0.5) / 0.5
		for i = e.cloudEnd + 1, #e.parts do
			local part = e.parts[i]
			if phase < 0.3 and vis > 0.2 then
				if not e.boltFor or e.boltFor ~= floor(t / 0.5) then
					e.boltFor = floor(t / 0.5)
					local rnd = math.random
					local a, r = rnd() * TAU, rnd() * e.r * 0.8
					e.bx, e.bz = e.ox + cos(a) * r, e.oz + sin(a) * r
				end
				local k = i - e.cloudEnd
				local seg = (e.oy - e.floorY) / 3
				local y = e.oy - seg * (k - 0.5) - 0.3
				local jig = (k % 2 == 0) and 0.5 or -0.5
				part.CFrame = CFrame.new(e.bx + jig, y, e.bz - jig * 0.5) * CFrame.Angles(0, 0, jig * 0.4)
				part.Transparency = 0.05
			else
				part.Transparency = 1
			end
		end
	elseif e.bubbles then
		for i = 2, #e.parts do
			local part = e.parts[i]
			local o = e.offsets[i]
			local q = ((t * o.speed) + o.phase) % 1
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + q * 1.4, e.oz + o.Z)
			part.Transparency = 1 - (1 - 0.15) * vis * (1 - q)
		end
	end
end

-- a damaging area on the floor for `seconds`: Storm (a voxel storm cloud with lightning) or a lingering pool
function Fx.Zone(floorCF, r, seconds, color, kind)
	local parts = {}
	local disc = Fx.Part(color, Enum.Material.Neon, 0.7)
	if not disc then
		return nil
	end
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.12, r * 2, r * 2)
	disc.CFrame = floorCF * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, pi / 2)
	parts[1] = disc
	local pos = floorCF.Position
	local e = { ox = pos.X, oy = pos.Y, oz = pos.Z, floorY = pos.Y, r = r, offsets = {}, discAlpha = 0.62 }
	local rnd = math.random
	if kind == "Storm" then
		e.cloud = true
		e.oy = pos.Y + 7.5
		local puffs = 9
		for i = 1, puffs do
			local shade = (i % 3 == 0) and COLORS.StormLight or COLORS.Storm
			local part = Fx.Part(shade, Enum.Material.SmoothPlastic, 0.05)
			if not part then
				break
			end
			local a = (i / puffs) * TAU
			local rr = (i == 1) and 0 or r * (0.25 + rnd() * 0.45)
			local s = 1.6 + rnd() * 1.4
			part.Size = Vector3.new(s * 1.3, s * 0.8, s * 1.3)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Y = rnd() * 0.8, Z = sin(a) * rr, alpha = 0.05 }
		end
		e.cloudEnd = #parts
		for _ = 1, 3 do
			local bolt = Fx.Part(Color3.fromRGB(230, 236, 255), Enum.Material.Neon, 1)
			if not bolt then
				break
			end
			bolt.Size = Vector3.new(0.25, (e.oy - pos.Y) / 3 + 0.4, 0.25)
			parts[#parts + 1] = bolt
		end
	else
		e.bubbles = true
		for _ = 1, 7 do
			local part = Fx.Part(color:Lerp(COLORS.White, 0.25), Enum.Material.Neon, 0.3)
			if not part then
				break
			end
			local a, rr = rnd() * TAU, rnd() * r * 0.85
			local s = 0.35 + rnd() * 0.35
			part.Size = Vector3.new(s, s, s)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Z = sin(a) * rr, speed = 0.6 + rnd() * 0.8, phase = rnd() }
		end
	end
	return Fx.Add(seconds, zoneUpdate, parts, e)
end

function Fx.Update(now)
	local list = St.effects
	local i = 1
	while i <= #list do
		local e = list[i]
		local p = (now - e.t0) / e.dur
		local ok = true
		if p < 1 then
			ok = pcall(e.update, e, clamp(p, 0, 1), now)
		end
		if p >= 1 or not ok then
			for _, part in ipairs(e.parts) do
				Fx.Free(part)
			end
			e.parts = {}
			list[i] = list[#list]
			list[#list] = nil
		else
			i = i + 1
		end
	end
end

function Fx.ClearAll()
	for _, e in ipairs(St.effects) do
		for _, part in ipairs(e.parts) do
			Fx.Free(part)
		end
	end
	St.effects = {}
	for _, n in ipairs(St.numbers) do
		n.gui.Enabled = false
		n.gui.Adornee = nil
		St.numberPool[#St.numberPool + 1] = n
	end
	St.numbers = {}
	for _, f in ipairs(St.flashes) do
		f.hl.Enabled = false
		f.hl.Adornee = nil
		St.flashPool[#St.flashPool + 1] = f
	end
	St.flashes = {}
end

----------------------------------------------------------------------
-- Effects: floating numbers (pixel-sized billboards in the world: World text rule) and hit flashes
----------------------------------------------------------------------
local function newNumber()
	local gui = make("BillboardGui", {
		Name = "BattleNumber",
		Size = UDim2.fromOffset(240, 64),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.NUMBER_DISTANCE,
		Enabled = false,
	})
	local label = Theme.Label("", "Accent", { Size = K.NUMBER_PX, Stroke = 0, Outline = 2.5 })
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = gui
	local scale = make("UIScale", { Name = "Pop", Scale = 1 }, label)
	return { gui = gui, label = label, scale = scale }
end

-- shows `text` above `adornee` (a BasePart), rising and fading; kind tweaks size / life
function Fx.Number(adornee, height, text, color, px, life)
	if not adornee or not adornee.Parent then
		return nil
	end
	local n = table.remove(St.numberPool)
	if not n then
		if #St.numbers >= K.MAX_NUMBERS then
			n = table.remove(St.numbers, 1) -- recycle the oldest
		else
			n = newNumber()
		end
	end
	if not n then
		return nil
	end
	n.gui.Parent = fxFolder()
	n.gui.Adornee = adornee
	n.label.Text = text
	n.label.TextColor3 = color or COLORS.White
	n.label.TextSize = Theme.ScaledSize(px or K.NUMBER_PX, 22)
	n.label.TextTransparency = 0
	local outline = n.label:FindFirstChild("TextOutline")
	if outline then
		outline.Transparency = 0
	end
	n.t0 = os.clock()
	n.life = life or K.NUMBER_TIME
	n.base = height
	n.jx = (math.random() - 0.5) * 1.4
	n.gui.StudsOffset = Vector3.new(n.jx, height, 0)
	n.gui.Enabled = true
	St.numbers[#St.numbers + 1] = n
	BattleController._wake()
	return n
end

function Fx.UpdateNumbers(now)
	local list = St.numbers
	local i = 1
	while i <= #list do
		local n = list[i]
		local p = (now - n.t0) / n.life
		if p >= 1 or not n.gui.Adornee or not n.gui.Adornee.Parent then
			n.gui.Enabled = false
			n.gui.Adornee = nil
			table.remove(list, i)
			St.numberPool[#St.numberPool + 1] = n
		else
			local rise = 1 - (1 - p) * (1 - p)
			n.gui.StudsOffset = Vector3.new(n.jx, n.base + rise * K.NUMBER_RISE, 0)
			n.scale.Scale = 1 + 0.45 * max(0, 1 - p * 6)
			local fade = clamp((p - 0.6) / 0.4, 0, 1)
			n.label.TextTransparency = fade
			local outline = n.label:FindFirstChild("TextOutline")
			if outline then
				outline.Transparency = fade
			end
			i = i + 1
		end
	end
end

-- a short white (or tinted) flash on a model (a pooled Highlight)
function Fx.Flash(u, color, dur)
	if not u or not u.model or u.parked then
		return
	end
	local f = u.flash
	if not f then
		f = table.remove(St.flashPool)
		if not f then
			if #St.flashes >= K.MAX_FLASHES then
				return
			end
			f = {
				hl = make("Highlight", {
					Name = "HitFlash",
					DepthMode = "Occluded", -- Enum.HighlightDepthMode.Occluded by name (no flash through the arena walls)
					OutlineTransparency = 1,
					FillTransparency = 1,
					Enabled = false,
				}),
			}
		end
		f.hl.Parent = fxFolder()
		St.flashes[#St.flashes + 1] = f
		u.flash = f
		f.unit = u
	end
	f.t0 = os.clock()
	f.dur = dur or K.FLASH_TIME
	f.hl.FillColor = color or COLORS.White
	f.hl.Adornee = u.model
	f.hl.FillTransparency = 0.25
	f.hl.Enabled = true
	BattleController._wake()
end

function Fx.UpdateFlashes(now)
	local list = St.flashes
	local i = 1
	while i <= #list do
		local f = list[i]
		local p = (now - f.t0) / (f.dur or K.FLASH_TIME)
		if p >= 1 or not f.hl.Adornee then
			f.hl.Enabled = false
			f.hl.Adornee = nil
			if f.unit then
				f.unit.flash = nil
				f.unit = nil
			end
			list[i] = list[#list]
			list[#list] = nil
			St.flashPool[#St.flashPool + 1] = f
		else
			f.hl.FillTransparency = 0.25 + 0.75 * p
			i = i + 1
		end
	end
end

----------------------------------------------------------------------
-- Battle record + coordinates
----------------------------------------------------------------------
local function newBattle(payload, battleId)
	local zone = type(payload.Zone) == "table" and payload.Zone or {}
	local cf = zone.CFrame
	if typeof(cf) ~= "CFrame" then
		cf = CFrame.new()
	end
	local size = zone.Size
	local zx = num(zone.X, typeof(size) == "Vector3" and size.X or 60)
	local zz = num(zone.Z, typeof(size) == "Vector3" and size.Z or 60)
	local side = num(payload.Side, 0)
	local spectator = payload.Spectator == true or side == 0
	local B = {
		Id = payload.BattleId or battleId,
		Mode = tostring(payload.Mode or "Duel"),
		Side = side,
		Spectator = spectator,
		Fighter = not spectator,
		ZoneCF = cf,
		ZoneX = zx,
		ZoneZ = zz,
		Names = type(payload.Names) == "table" and payload.Names or {},
		-- Phase 5: the dungeon room's Extra { Floor, Room, Wave, Waves, Name, Boss }
		Dungeon = type(payload.Dungeon) == "table" and payload.Dungeon or nil,
		TimeLimit = num(payload.TimeLimit, 0),
		Level = payload.Level,
		BossId = payload.BossId,
		-- Phase 4: the Champion Ring's "Start".Ring = { Round, Best, Start, Champion = { PetId, Level, Tier, Boss, Name } }
		Ring = type(payload.Ring) == "table" and payload.Ring or nil,
		Round = num(payload.Round or (type(payload.Ring) == "table" and payload.Ring.Round), 0),
		ringNext = nil, -- a won ring round: { Round, Next, Cash, Xp, Tokens, Record, At } until the next "Start"
		units = {},
		list = {},
		mine = {},
		snaps = {},
		offset = 0,
		haveOffset = false,
		renderT = num(payload.T, 0),
		evq = {},
		teles = {},
		buildQueue = {},
		-- Phase 5: my team (Start.Team), the lock, the cooldowns (os.clock ready times) and the predictions
		fighterId = nil,
		lives = nil,
		speed = nil, -- { Walk, Run }
		lock = nil,
		cd = { Element = 0, Dash = 0, Swap = 0, Buff = {} },
		cdLen = { Element = 7, Dash = 2.5, Swap = 10, Buff = {} },
		pending = {},
		ended = false,
		simEnded = false,
		enraged = false,
		wave = 0,
		folder = nil,
	}
	-- the zone basis, so a zone-local point becomes a world point with plain arithmetic per frame
	local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	B.basis = { px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 }
	B.folder = make("Folder", { Name = "Battle_" .. tostring(B.Id) }, battleFolder())
	return B
end

-- zone-local (x, y, z) -> world Vector3
local function worldPoint(B, x, y, z)
	local b = B.basis
	return Vector3.new(b[1] + b[4] * x + b[5] * y + b[6] * z, b[2] + b[7] * x + b[8] * y + b[9] * z, b[3] + b[10] * x + b[11] * y + b[12] * z)
end

-- zone-local position + yaw (0 = facing -Z of the zone) -> world CFrame (one allocation)
local function worldFrame(B, x, y, z, yaw)
	local b = B.basis
	local c, s = cos(yaw), sin(yaw)
	-- R = Z * Ry(yaw): columns of Ry are (c,0,-s), (0,1,0), (s,0,c)
	local m00 = b[4] * c - b[6] * s
	local m01 = b[5]
	local m02 = b[4] * s + b[6] * c
	local m10 = b[7] * c - b[9] * s
	local m11 = b[8]
	local m12 = b[7] * s + b[9] * c
	local m20 = b[10] * c - b[12] * s
	local m21 = b[11]
	local m22 = b[10] * s + b[12] * c
	return CFrame.new(
		b[1] + b[4] * x + b[5] * y + b[6] * z,
		b[2] + b[7] * x + b[8] * y + b[9] * z,
		b[3] + b[10] * x + b[11] * y + b[12] * z,
		m00, m01, m02, m10, m11, m12, m20, m21, m22
	)
end

local function yawToward(dx, dz)
	return atan2(-dx, -dz)
end

----------------------------------------------------------------------
-- Units
----------------------------------------------------------------------
-- the definition PetBuilder draws for a unit (its look from the sim; else its key / pet id)
function Units.Def(info)
	local look = info.look
	local base = nil
	if PetCatalog and type(PetCatalog.Get) == "function" then
		if info.petId then
			local ok, d = pcall(PetCatalog.Get, info.petId)
			base = ok and type(d) == "table" and d or nil
		end
		if not base and type(look) == "table" and look.BodyId then
			local ok, d = pcall(PetCatalog.Get, look.BodyId)
			base = ok and type(d) == "table" and d or nil
		end
	end
	if type(look) == "table" then
		return { Id = tostring(info.key or info.petId or info.id), Rarity = base and base.Rarity or nil, Look = look }
	end
	if PetKeys and type(info.key) == "string" then
		local ok, d = pcall(PetKeys.DefOf, info.key)
		if ok and type(d) == "table" then
			return d
		end
	end
	return base
end

local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" or type(part:GetAttribute("PB_Base")) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

-- welds the static parts to the anchored root once: a pose is then one root CFrame write
local function weldStatic(model, root)
	local inv = root.CFrame:Inverse()
	local identity = CFrame.new()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and part.Anchored and not isAnimatedPart(part) then
			make("Weld", { Name = "BattleWeld", Part0 = root, Part1 = part, C0 = inv * part.CFrame, C1 = identity }, part)
			part.Anchored = false
		end
	end
	root.Anchored = true
end

function Units.Add(B, info)
	if type(info) ~= "table" then
		return nil
	end
	local id = tonumber(info.id)
	if not id then
		return nil
	end
	local u = B.units[id]
	if u then
		u.info = info
		return u
	end
	local me = myUserId()
	local side = num(info.side, 2)
	local mine = B.Fighter and info.owner == me
	local ally
	if B.Fighter then
		ally = side == B.Side
	else
		ally = side == 1
	end
	u = {
		id = id,
		info = info,
		side = side,
		owner = info.owner,
		slot = num(info.slot, 0),
		kind = tostring(info.kind or "Pet"),
		name = tostring(info.name or "Pet"),
		element = info.element,
		elements = type(info.elements) == "table" and info.elements or { info.element },
		maxHp = max(1, num(info.maxHp, 100)),
		level = num(info.level, 1),
		tier = info.tier,
		scale = num(info.scale, 1),
		ranged = info.ranged == true,
		radius = num(info.radius, 1.8),
		special = type(info.special) == "table" and info.special or nil,
		isBoss = info.kind == "Boss",
		bossId = info.boss,
		-- Phase 4: the stored evolution stage (the model and the card's stars), own pets' XP (the card's XP row), the
		-- ring champion's crown
		evo = clamp(floor(num(info.evo, 0)), 0, 2),
		xp = tonumber(info.xp),
		xpNext = tonumber(info.xpNext),
		crowned = info.crowned == true,
		-- Phase 5: a player team's bench (the static slot of a helper), its role, buff and element attack
		bench = tonumber(info.bench),
		benched = tonumber(info.bench) ~= nil,
		role = info.role,
		lives = nil,
		windup = false,
		mine = mine,
		ally = ally,
		x = 0,
		z = 0,
		seen = false,
		yaw = 0,
		hp = max(1, num(info.maxHp, 100)),
		state = 0,
		meter = 0,
		shield = 0,
		phase = math.random() * TAU,
		animOpts = { Flap = 1, Excited = 0 },
		bossOpts = { CFrame = nil, Progress = 0, Attack = nil, Enraged = false },
		pose = "Idle",
		poseAt = 0,
		poseDur = 0,
	}
	B.units[id] = u
	B.list[#B.list + 1] = u
	if u.isBoss then
		B.boss = u
	end
	if mine and u.slot >= 1 and u.slot <= 4 then
		B.mine[u.slot] = u
	end
	B.buildQueue[#B.buildQueue + 1] = u
	return u
end

-- a Spawn / Wave event's unit infos (server order: they may come after "Start"); a new unit whose info says Arrive > 0
-- (seconds) arrives: EvolutionFx.Arrive at its spot, the model hidden until the flash, then a hop (Units.Arrival)
function Units.AddList(B, list)
	for _, info in ipairs(type(list) == "table" and list or {}) do
		local known = type(info) == "table" and B.units[tonumber(info.id) or -1] ~= nil
		local u = Units.Add(B, info)
		if u and not known then
			local arrive = type(info) == "table" and tonumber(info.Arrive or info.arrive) or nil
			if arrive and arrive > 0 and not u.mine then
				u.arrive = min(arrive, 4)
			end
		end
	end
end

function Units.Destroy(u)
	if u.arriveFx then
		if not u.arriveFx.Done then
			pcall(u.arriveFx.Stop)
		end
		u.arriveFx = nil
	end
	if u.flash then
		u.flash.hl.Adornee = nil
	end
	Cards.Free(u)
	for _, key in ipairs({ "shieldPart", "icePart", "focusMark" }) do
		local p = u[key]
		if p then
			pcall(p.Destroy, p)
			u[key] = nil
		end
	end
	if u.model then
		pcall(u.model.Destroy, u.model)
	end
	u.model = nil
	u.root = nil
	u.bar = nil
	u.gone = true
end

function Units.Remove(B, id)
	local u = B.units[id]
	if not u then
		return
	end
	B.units[id] = nil
	for i, v in ipairs(B.list) do
		if v == u then
			table.remove(B.list, i)
			break
		end
	end
	for slot, v in pairs(B.mine) do
		if v == u then
			B.mine[slot] = nil
		end
	end
	if B.boss == u then
		B.boss = nil
	end
	Units.Destroy(u)
end

-- the pixel HP bar above a unit (no text: World text rule only covers text)
local function addBar(u, adornee, height)
	local color = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
	local w, h = Theme.ScaledSize(74, 50), Theme.ScaledSize(11, 8)
	local gui = make("BillboardGui", {
		Name = "HpBar",
		Adornee = adornee,
		Size = UDim2.fromOffset(w, h),
		StudsOffset = Vector3.new(0, height, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
	})
	local back = make("Frame", {
		Name = "Back",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLORS.Track,
		BorderSizePixel = 0,
	}, gui)
	Theme.Corner(back, UDim.new(0, 4))
	Theme.Stroke(back, u.mine and COLORS.Gold or COLORS.Ink, u.mine and 2 or 1.5, 0)
	local fill = make("Frame", {
		Name = "Fill",
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, back)
	Theme.Corner(fill, UDim.new(0, 3))
	gui.Parent = u.model
	u.bar = gui
	u.barFill = fill
	u.barFrac = 1
end

-- builds one unit's model (pcall'd by the caller)
local function buildUnit(B, u)
	if u.isBoss then
		local BB = lazyBoss()
		if not BB then
			error("BossBuilder is missing")
		end
		local cf = worldFrame(B, u.x, 0, u.z, u.yaw)
		local model = BB.Build(u.bossId, { Detail = "High", CFrame = cf })
		if not model then
			error("BossBuilder.Build returned nil for " .. tostring(u.bossId))
		end
		local okH, h = pcall(BB.GetHeight, model)
		u.height = (okH and num(h, 20)) or 20
		u.model = model
		u.root = model.PrimaryPart or model:FindFirstChild("Root")
		model.Parent = B.folder
		if B.enraged then
			pcall(BB.SetEnraged, model, true)
		end
		return
	end
	if not PetBuilder then
		error("PetBuilder is missing")
	end
	local def = Units.Def(u.info)
	if not def then
		error("no definition for unit " .. tostring(u.id))
	end
	if u.crowned then
		def = Ring.Crowned(def) -- the ring champion wears PetBuilder's voxel crown
	end
	-- evolved units use the Low evolved form (within the petEvoLow / petEvo2Low budgets), like evolved followers;
	-- Phase 5 (10.3): my fighter High, my helpers Low (a helper swapped in is rebuilt at High: Units.Rebuild)
	local detail = (u.mine and u.evo == 0 and not u.benched) and "High" or "Low"
	-- dungeon enemies wear the Wild look (contract 5.6 / C13): darker, tinted toward the floor's element, Neon eyes
	local wild = nil
	if u.info.wild and not u.ally then
		local c = elementColor((B.Dungeon and B.Dungeon.Element) or u.element)
		wild = { Tint = Theme.Darken(c, 0.35), Eyes = Theme.Lighten(c, 0.15) }
	end
	local model = PetBuilder.Build(def, { Scale = K.PET_SCALE * u.scale, Detail = detail, Evolved = u.evo > 0 and u.evo or nil, Wild = wild })
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then
		model:Destroy()
		error("pet model without a root")
	end
	local okSize, size = pcall(model.GetExtentsSize, model)
	u.height = (okSize and typeof(size) == "Vector3") and size.Y or 3.5
	u.centerY = u.height / 2 + K.HOVER
	-- weld at the built pose FIRST, then move: a pose is one root CFrame write from here on
	local okWeld = pcall(weldStatic, model, root)
	u.rigid = okWeld
	-- the parts PetBuilder.Animate poses (still anchored after the weld): moved with the root on a strided frame
	u.loose = {}
	u.looseBuf = {}
	if okWeld then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part ~= root and part.Anchored then
				u.loose[#u.loose + 1] = part
			end
		end
	end
	local cf = worldFrame(B, u.x, u.centerY, u.z, u.yaw)
	if okWeld then
		root.CFrame = cf
	else
		pcall(model.PivotTo, model, cf)
	end
	local old = u.model
	u.model = model
	u.root = root
	u.folder = B.folder
	u.detail = detail
	model.Name = "Unit_" .. tostring(u.id)
	model:SetAttribute("BC_Evo", u.evo)
	model:SetAttribute("BC_Detail", detail)
	if old then
		-- a rebuild (a helper that became my fighter): the card moves over, the old model goes
		u.rebuild = nil
		if u.card and u.card.Gui then
			u.card.Gui.Parent = model
			pcall(u.card.SetAdornee, u.card, root, (u.height or 3) / 2 + 0.9)
		end
		if u.flash then
			u.flash.hl.Adornee = nil
		end
		pcall(old.Destroy, old)
		u.parked = false
	else
		Cards.Add(B, u, root)
	end
	model.Parent = B.folder
end

-- my new fighter (a swap) is drawn at High detail: rebuilt by the build queue under its time budget
function Units.Rebuild(B, u)
	if u and u.model and u.detail == "Low" and u.evo == 0 and not u.isBoss and not u.rebuild then
		u.rebuild = true
		B.buildQueue[#B.buildQueue + 1] = u
	end
end

-- Phase 6 (runtime-pets): when MeshLibrary makes a pet's Blender mesh keys usable here (PetBuilder.MeshVersion
-- changes), its Part-built units are queued for a rebuild as mesh pets (KO'd / parked ones stay as they are)
function Units.MeshSweep(B)
	local ver = PetBuilder.MeshVersion()
	if ver == B.meshVer then
		return
	end
	B.meshVer = ver
	local ids = {}
	for id in pairs(B.units) do
		ids[#ids + 1] = id
	end
	table.sort(ids, function(a, b)
		return tostring(a) < tostring(b)
	end)
	for _, id in ipairs(ids) do
		local u = B.units[id]
		if u.model and not u.isBoss and not u.rebuild and not u.parked and not u.gone and PetBuilder.NeedsMeshRebuild(u.model) then
			u.rebuild = true
			B.buildQueue[#B.buildQueue + 1] = u
		end
	end
	-- the helpers' portraits (ViewportFrames) too
	for _, H in ipairs(Hud.helpers or {}) do
		if H.unit and H.model and PetBuilder.NeedsMeshRebuild(H.model) then
			H.built = false
			pcall(Hud.Portrait, H, H.unit)
		end
	end
end

function Units.BuildPending(B)
	if PetBuilder and PetBuilder.MeshVersion and B.units then
		Units.MeshSweep(B)
	end
	local q = B.buildQueue
	if #q == 0 then
		return
	end
	local t0 = os.clock()
	local built = 0
	while #q > 0 and built < K.BUILD_MAX do
		if built > 0 and os.clock() - t0 > K.BUILD_BUDGET then
			break
		end
		local u = table.remove(q, 1)
		if u.benched and not u.mine and not u.isBoss then
			u.needBuild = true -- another player's helper: not drawn while it sits on the bench
		elseif not u.gone and (not u.model or u.rebuild) then
			local ok, err = pcall(buildUnit, B, u)
			if not ok then
				warnOnce("build_" .. tostring(u.kind) .. tostring(u.info and (u.info.key or u.info.boss)), "could not build unit " .. tostring(u.name) .. ": " .. tostring(err))
				u.failed = true
			end
			built = built + 1
			St.perf.builds = St.perf.builds + 1
		end
	end
end

-- a pet's KO: poof, then the model is parked until the end
local function parkUnit(u, parked)
	if not u.model then
		return
	end
	if parked and not u.parked then
		u.parked = true
		u.model.Parent = nil
	elseif not parked and u.parked then
		u.parked = false
		u.model.Parent = u.folder or u.model.Parent
	end
end

function Units.SetPose(u, pose, dur, attackId)
	u.pose = pose
	u.poseAt = os.clock()
	u.poseDur = dur or 0
	if attackId then
		u.attackId = attackId
	end
end

-- per-frame update of one unit (position from the snapshots, facing, lunge / hop, animation)
local function updateUnit(B, u, now, dt, sa, sb, alpha, animate)
	return Units.Update(B, u, now, dt, sa, sb, alpha, animate)
end

function Units.Update(B, u, now, dt, sa, sb, alpha, animate)
	local a = sa and sa.Units[u.id]
	local b = sb and sb.Units[u.id]
	local x, z = u.x, u.z
	if type(a) == "table" and type(b) == "table" then
		x = a.x + (b.x - a.x) * alpha
		z = a.z + (b.z - a.z) * alpha
	elseif type(a) == "table" then
		x, z = a.x, a.z
	elseif type(b) == "table" then
		x, z = b.x, b.z
	end
	local d = (alpha >= 0.5 and type(b) == "table" and b) or (type(a) == "table" and a) or (type(b) == "table" and b) or nil
	if d then
		u.hp = num(d.hp, u.hp)
		u.state = num(d.state, u.state)
		u.target = d.target
		u.meter = num(d.meter, 0)
		u.shield = num(d.shield, 0)
		-- Phase 5: the team's lives, the wind-up bit, the bench
		if d.lives ~= nil then
			u.lives = num(d.lives, u.lives)
		end
		local winding = d.windup == true
		if winding and not u.windup and not u.ally then
			Fx.Flash(u, COLORS.Windup, K.WINDUP_FLASH) -- the dash cue
		end
		u.windup = winding
		local benched = u.state == S_BENCHED
		if benched ~= u.benched then
			u.benched = benched
			if not benched and not u.model and u.needBuild and not u.failed then
				u.needBuild = nil
				B.buildQueue[#B.buildQueue + 1] = u
			end
		end
		if u.mine and d.lives ~= nil and B.Fighter and not benched and (B.fighterId == nil or u.id == B.fighterId) then
			B.lives = u.lives -- (only the fighter's record carries the team's lives)
		end
	end
	x, z = num(x, u.x), num(z, u.z)
	local mx, mz = x - u.x, z - u.z
	if not u.seen then
		u.seen = true
		mx, mz = 0, 0
		-- face the floor centre at first
		u.yaw = yawToward(-x, -z)
	end
	u.x, u.z = x, z
	if u.arrive and Units.Arrival(B, u, now) then
		return -- still arriving: the model stays hidden until the flash
	end
	if not u.model then
		return
	end
	if u.benched and not u.mine and not u.isBoss then
		parkUnit(u, true) -- another player's helper is not drawn (B3)
		return
	end
	local down = u.state == S_DOWN or u.hp <= 0
	if u.isBoss then
		Units.UpdateBoss(B, u, now, down, dt)
		return
	end
	if u.card and (u.cardHp ~= u.hp or u.cardMeter ~= u.meter or u.cardLives ~= u.lives) then
		Cards.Live(u) -- only when the snapshot changed the HP / meter (at most 10 Hz), never a write per frame
	end
	-- downed pets: poof once, then park
	if down then
		if not u.downAt then
			u.downAt = now
			if not u.poofed then
				u.poofed = true
				local pos = worldPoint(B, x, u.centerY or 1.5, z)
				Fx.Burst(pos, Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
			end
		end
		if now - u.downAt >= K.KO_PARK then
			parkUnit(u, true)
		end
		return
	elseif u.parked then
		u.downAt = nil
		parkUnit(u, false)
	end
	u.accDt = (u.accDt or 0) + dt
	if u.mine and B.Fighter and not B.ended then
		u.accDt = 0
		return Me.Draw(B, u, now, dt, x, z) -- my fighter at my shoulder, my helpers behind me
	end
	if u.parked then
		return
	end
	-- every frame: the root (interpolated position + facing), so a far / crowded pet never stutters; the stride
	-- (animate = false) only skips the pose work (PetBuilder.Animate), its loose parts ride along (Units.CarryLoose)
	if animate then
		u.posed = true
	end
	u.accDt = 0
	-- facing: the target while fighting, else the way it moves
	local want = nil
	local tgt = u.target and B.units[u.target]
	if tgt and (u.state == S_ATTACKING or u.state == S_CASTING or mx * mx + mz * mz < 0.0004) then
		want = yawToward(tgt.x - x, tgt.z - z)
	elseif mx * mx + mz * mz > 0.0004 then
		want = yawToward(mx, mz)
	end
	if want and u.state ~= S_STUNNED then
		local k = 1 - exp(-K.FACE_RATE * dt)
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * k
	end
	-- lunge / recoil / hop
	local ox, oz, oy = 0, 0, 0
	if u.lungeAt then
		local p = (now - u.lungeAt) / K.LUNGE_TIME
		if p >= 1 then
			u.lungeAt = nil
		else
			local amt = sin(p * pi) * (u.ranged and -K.RECOIL_DIST or K.LUNGE_DIST)
			ox, oz = u.lungeX * amt, u.lungeZ * amt
		end
	end
	if u.hopAt then
		local p = (now - u.hopAt) / K.HOP_TIME
		if p >= 1 then
			u.hopAt = nil
		elseif p > 0 then
			oy = sin(p * pi) * K.HOP_HEIGHT
		end
	end
	if u.hurtAt then
		local p = (now - u.hurtAt) / 0.18
		if p >= 1 then
			u.hurtAt = nil
		else
			local amt = sin(p * pi) * 0.3
			ox, oz = ox + (u.hurtX or 0) * amt, oz + (u.hurtZ or 0) * amt
		end
	end
	if u.dashAt then
		local amt = K.DASH_DIST * Me.DashAmount(u, now)
		ox, oz = ox + (u.dashX or 0) * amt, oz + (u.dashZ or 0) * amt
	end
	local bob = 0
	local stunned = u.state == S_STUNNED
	if not stunned then
		bob = sin(now * 3.1 + u.phase) * K.BOB
	end
	if u.windup then
		oy = oy - 0.35 -- the wind-up crouch (Winding: the dash cue)
	end
	local cf = worldFrame(B, x + ox, (u.centerY or 1.5) + bob + oy, z + oz, u.yaw)
	if u.rigid then
		if not animate or u.animBroken or not PetBuilder then
			Units.CarryLoose(u, cf) -- no Animate this frame: the wings / animated parts keep their pose on the root
		end
		u.root.CFrame = cf
	else
		pcall(u.model.PivotTo, u.model, cf)
	end
	if animate and PetBuilder and not u.animBroken then
		local opts = u.animOpts
		opts.Flap = stunned and 0 or ((u.state == S_DASHING or mx * mx + mz * mz > 0.0004) and 1.8 or 1)
		opts.Excited = u.windup and 1 or ((u.state == S_ATTACKING or u.state == S_CASTING) and 0.6 or 0)
		local ok = pcall(PetBuilder.Animate, u.model, now + u.phase, opts)
		if not ok then
			u.animBroken = true
		end
	end
	-- the HP bar (only when it changes)
	local frac = clamp(u.hp / u.maxHp, 0, 1)
	if u.barFill and abs(frac - (u.barFrac or -1)) > 0.004 then
		u.barFrac = frac
		u.barFill.Size = UDim2.new(max(frac, 0.02), -2, 1, -2)
	end
	-- shield cube and ice crystals follow the unit
	Units.UpdateStatus(B, u, now, cf)
end

-- a strided frame (no PetBuilder.Animate): the root moves to cf and the anchored animated parts (wings, tails...) move
-- rigidly with it, keeping their last pose (one BulkMoveTo, a reused buffer: no table per frame)
function Units.CarryLoose(u, cf)
	local list = u.loose
	local n = list and #list or 0
	if n == 0 then
		return
	end
	local delta = cf * u.root.CFrame:Inverse()
	local buf = u.looseBuf
	for i = 1, n do
		buf[i] = delta * list[i].CFrame
	end
	local ok = pcall(workspace.BulkMoveTo, workspace, list, buf, Enum.BulkMoveMode.FireCFrameChanged)
	if not ok then
		for i = 1, n do
			list[i].CFrame = buf[i]
		end
	end
end

-- client/Controllers/EvolutionFx (the arrival effect); nil when missing
function Units.EvoFx()
	if Mods.Evo == nil then
		Mods.Evo = optional(script.Parent, "EvolutionFx") or false
	end
	local m = Mods.Evo
	return (m and type(m.Arrive) == "function") and m or nil
end

-- dungeon fixes (decision 3): an arriving enemy (Units.AddList, info Arrive > 0). Its first frame with a position
-- starts EvolutionFx.Arrive at its spot (effects only: rune ring, pillar, flash, sparkles, shock ring, sparks; Low
-- graphics = flash + ring); the model stays out of the world until the flash, then pops in with a hop. The server
-- keeps it inert and unhittable meanwhile (arriveUntil). -> true while the model is hidden (skip the frame)
function Units.Arrival(B, u, now)
	if u.isBoss then
		u.arrive = nil
		return false
	end
	if not u.arriveFx and not u.arriveShown then
		local fx = Units.EvoFx()
		local h = u.height or (3.2 * u.scale * K.PET_SCALE)
		local c = elementColor((B.Dungeon and B.Dungeon.Element) or u.element)
		local ok, handle = false, nil
		if fx then
			ok, handle = pcall(fx.Arrive, worldFrame(B, u.x, u.centerY or (h / 2 + K.HOVER), u.z, 0), {
				Parent = fxFolder(),
				Colors = { c, Theme.Lighten(c, 0.55) },
				Height = h,
				Radius = max(1, u.radius),
				Ground = worldPoint(B, u.x, 0, u.z).Y,
				Seconds = u.arrive,
				OnFlash = function()
					u.arriveShown = true
				end,
			})
		end
		if not ok or type(handle) ~= "table" then
			u.arrive = nil -- no effect module: the pet is simply there
			return false
		end
		u.arriveFx = handle
		St.arrivals = (St.arrivals or 0) + 1
	end
	if not u.arriveShown then
		u.hidden = true
		if u.model and u.model.Parent then
			u.model.Parent = nil
		end
		return true
	end
	-- the flash: the pet pops in
	u.arrive = nil
	u.hidden = nil
	if u.model and not u.model.Parent and not u.parked then
		u.model.Parent = u.folder or B.folder
	end
	u.hopAt = now
	return false
end

-- Phase 6: the Blender fx meshes (fx_shield / fx_ice / fx_arrow, creatures class) once they are usable on this
-- device: Units.FxMesh(key, scale) -> the MeshParts of a fresh rootless Assemble (sorted by name, Anchored, no
-- collisions) or nil (= the Part build). Same slot names and the same per-frame CFrame code either way.
function Units.FxMesh(key, scale)
	if Mods.Mesh == nil then
		Mods.Mesh = optional(Shared, "MeshLibrary") or false
	end
	local ML = Mods.Mesh
	if not ML or type(ML.Active) ~= "function" or not ML.Active() or not ML.IsReady(key) then
		return nil
	end
	local ok, model = pcall(ML.Assemble, key, nil, { Scale = scale or 1 })
	if not ok or typeof(model) ~= "Instance" then
		return nil
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
		end
	end
	table.sort(parts, function(a, b)
		return a.Name < b.Name
	end)
	for _, d in ipairs(parts) do
		d.Parent = nil
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
	end
	model:Destroy()
	if #parts == 0 then
		return nil
	end
	return parts
end

-- shield bubble (while the snapshot reports a shield) and ice (while stunned)
function Units.UpdateStatus(B, u, now, cf)
	local h = u.height or 3
	if u.shield > 0 then
		local p = u.shieldPart
		if not p then
			local mesh = Units.FxMesh("fx_shield")
			if mesh then
				-- the voxel bubble: one MeshPart sized like the Part cube (MeshPart.Size scales the mesh)
				p = mesh[1]
				p.Name = "ShieldCube"
				p.Size = Vector3.new(h * 1.25, h * 1.15, h * 1.25)
				p.Color = COLORS.Shield
				for i = 2, #mesh do
					mesh[i]:Destroy()
				end
				p.Parent = u.model
				u.shieldPart = p
			end
		end
		if not p then
			p = make("Part", {
				Name = "ShieldCube",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.ForceField,
				Color = COLORS.Shield,
				Transparency = 0,
				Size = Vector3.new(h * 1.25, h * 1.15, h * 1.25),
			}, u.model)
			u.shieldPart = p
		end
		p.CFrame = cf * CFrame.Angles(0, now * 0.8, 0)
	elseif u.shieldPart then
		u.shieldPart:Destroy()
		u.shieldPart = nil
	end
	local iced = u.state == S_STUNNED or (u.iceUntil and now < u.iceUntil)
	if iced then
		local p = u.icePart
		if not p then
			p = make("Model", { Name = "Ice" }, u.model)
			for i = 1, 5 do
				local a = (i / 5) * TAU
				local s = h * (0.28 + 0.06 * (i % 3))
				-- Phase 6: a Blender ice crystal (fx_ice, 1.1 tall) when ready: its main part is the "Crystal" the
				-- per-frame code moves, the light core rides on it (welded child, also named Crystal)
				local mesh = Units.FxMesh("fx_ice", s * 1.4 / 1.1)
				if mesh then
					local main = mesh[1]
					main.Name = "Crystal"
					main:SetAttribute("Angle", a)
					for k = 2, #mesh do
						local c = mesh[k]
						c.Name = "Crystal"
						c.Anchored = false
						c.Massless = true
						local weld = make("WeldConstraint", { Part0 = main, Part1 = c }, c)
						weld.Name = "IceWeld"
						c.Parent = main
					end
					main.Parent = p
				end
				if not mesh then
					make("Part", {
						Name = "Crystal",
						Anchored = true,
						CanCollide = false,
						CanQuery = false,
						CanTouch = false,
						CastShadow = false,
						Material = Enum.Material.Glass,
						Color = COLORS.Ice,
						Transparency = 0.35,
						Size = Vector3.new(s * 0.45, s * 1.4, s * 0.45),
					}, p):SetAttribute("Angle", a)
				end
			end
			u.icePart = p
		end
		local r = (u.radius or 1.8) * 0.75 * K.PET_SCALE * 0.6
		for _, c in ipairs(p:GetChildren()) do
			local a = c:GetAttribute("Angle") or 0
			c.CFrame = cf * CFrame.new(cos(a) * r, -h * 0.25, sin(a) * r) * CFrame.Angles(0.35 * cos(a), a, 0.35 * sin(a))
		end
	elseif u.icePart then
		u.icePart:Destroy()
		u.icePart = nil
	end
end

-- the raid boss: BossBuilder poses on the interpolated position
function Units.UpdateBoss(B, u, now, down, dt)
	local BB = lazyBoss()
	if not BB then
		return
	end
	local tgt = u.target and B.units[u.target]
	local want = nil
	if u.faceX then
		want = yawToward(u.faceX - u.x, u.faceZ - u.z)
	elseif tgt then
		want = yawToward(tgt.x - u.x, tgt.z - u.z)
	end
	if want and not down then
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * (1 - exp(-3 * (dt or 0.016)))
	end
	local pose = u.pose
	local progress = 0
	if down then
		if pose ~= "Down" then
			Units.SetPose(u, "Down", 1.6)
			pose = "Down"
		end
	end
	if u.poseDur > 0 then
		progress = clamp((now - u.poseAt) / u.poseDur, 0, 1)
		if progress >= 1 and pose ~= "Down" and pose ~= "Windup" then
			Units.SetPose(u, "Idle", 0)
			pose = "Idle"
			u.faceX, u.faceZ = nil, nil
		end
	end
	if pose == "Windup" and u.windupAt then
		progress = clamp((B.renderT - u.windupFrom) / max(0.1, u.windupAt - u.windupFrom), 0, 1)
	end
	local opts = u.bossOpts
	opts.CFrame = worldFrame(B, u.x, 0, u.z, u.yaw)
	opts.Progress = progress
	opts.Attack = u.attackId
	opts.Enraged = B.enraged
	local ok, err = pcall(BB.Animate, u.model, pose, now, opts)
	if not ok then
		warnOnce("bossanim", "BossBuilder.Animate failed: " .. tostring(err))
	end
end

-- the world point of a unit's body centre (effects, numbers)
local function unitCenter(B, u)
	if u.mine and u.drawn and B.Fighter and not u.parked then
		return u.drawn -- my fighter / helpers are drawn at my character, not at the server spot
	end
	local y = u.isBoss and (u.height or 20) * 0.55 or (u.centerY or 1.5)
	return worldPoint(B, u.x, y, u.z)
end

----------------------------------------------------------------------
-- Phase 5 (4.7 Models): my fighter at my character's shoulder, my helpers behind me, the camera shake
----------------------------------------------------------------------
-- the character's HumanoidRootPart (nil without one)
function Me.Root()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and root.Parent then
		return root
	end
	return nil
end

-- a zone-local direction (x, z) as a world vector (the zone's rotation)
local function zoneDir(B, x, z)
	local b = B.basis
	return Vector3.new(b[4] * x + b[6] * z, b[7] * x + b[9] * z, b[10] * x + b[12] * z)
end

-- the frame-rate independent share of a per-60-Hz-frame lerp
local function lerpShare(perFrame, dt)
	return 1 - (1 - perFrame) ^ (clamp(dt, 0, 0.25) * 60)
end

-- where my fighter is drawn: the shoulder of the SERVER fighter position (x, z), blended toward the character root
-- while the two are within BLEND_DIST studs (so what looks in reach IS in reach); returns the target and the share
function Me.FighterTarget(B, u, x, z)
	local server = worldPoint(B, x, u.centerY or 1.5, z)
	local root = Me.Root()
	if not root then
		return server, K.FOLLOW_LERP, nil
	end
	local rcf = root.CFrame
	local rp = rcf.Position
	local dx, dz = rp.X - server.X, rp.Z - server.Z
	local d = sqrt(dx * dx + dz * dz)
	local ax, az, share = server.X, server.Z, K.FOLLOW_LERP
	if d <= K.BLEND_DIST then
		local k = 1 - d / K.BLEND_DIST
		ax, az = server.X + dx * k, server.Z + dz * k
		share = 0.6
	end
	local off = rcf:VectorToWorldSpace(K.SHOULDER)
	return Vector3.new(ax + off.X, rp.Y + off.Y, az + off.Z), share, rcf
end

-- a helper's spot behind me (index 1 / 2 = HELPER_A / HELPER_B); without a character behind the drawn fighter
function Me.HelperSpot(B, index)
	local off = (index == 2) and K.HELPER_B or K.HELPER_A
	local root = Me.Root()
	if root then
		return root.CFrame:PointToWorldSpace(off)
	end
	local f = B.fighterId and B.units[B.fighterId]
	local base = (f and f.drawn) or worldPoint(B, 0, 2, 0)
	return base + Vector3.new(off.X, off.Y - 0.5, off.Z)
end

-- the bench index (1 / 2) of my helper u, in slot order
function Me.HelperIndex(B, u)
	local i = 0
	for slot = 1, 4 do
		local h = B.mine[slot]
		if h and h.id ~= B.fighterId then
			i = i + 1
			if h == u then
				return i
			end
		end
	end
	return 1
end

-- per frame: my fighter / my helpers (positions + facing + bob + animation; the server never moves these parts)
function Me.Draw(B, u, now, dt, x, z)
	if u.parked then
		return
	end
	local isFighter = u.id == B.fighterId or (B.fighterId == nil and not u.benched)
	local target, share, rcf
	if isFighter then
		target, share, rcf = Me.FighterTarget(B, u, x, z)
	else
		target, share = Me.HelperSpot(B, Me.HelperIndex(B, u)), 0.25
		-- a Buff: fly to the fighter and back (BUFF_FLY)
		if u.flyAt then
			local p = (now - u.flyAt) / K.BUFF_FLY
			local f = B.fighterId and B.units[B.fighterId]
			if p >= 1 or not f or not f.drawn then
				u.flyAt = nil
			else
				local k = sin(p * pi)
				target = target:Lerp(f.drawn + Vector3.new(0, 1.2, 0), k)
				share = 1
			end
		end
	end
	-- a swap: the two trade places along a little arc (SWAP_TIME)
	if u.swapAt and u.swapFrom then
		local p = (now - u.swapAt) / K.SWAP_TIME
		if p >= 1 then
			u.swapAt, u.swapFrom = nil, nil
		else
			local e = p * p * (3 - 2 * p)
			target = u.swapFrom:Lerp(target, e) + Vector3.new(0, sin(p * pi) * 1.6, 0)
			share = 1
		end
	end
	if not u.drawn then
		u.drawn = target
	else
		u.drawn = u.drawn:Lerp(target, lerpShare(share, dt))
	end
	-- facing: my fighter faces the enemy it fights (else where I look); helpers face where I look
	local want = nil
	local tgt = isFighter and ((u.target and B.units[u.target]) or (B.lock and B.units[B.lock])) or nil
	if tgt and tgt.model and not tgt.parked then
		local tp = unitCenter(B, tgt)
		local dx, dz = tp.X - u.drawn.X, tp.Z - u.drawn.Z
		if dx * dx + dz * dz > 0.01 then
			want = atan2(-dx, -dz)
		end
	end
	if not want then
		local look = (rcf or (Me.Root() and Me.Root().CFrame))
		if look then
			local lv = look.LookVector
			want = atan2(-lv.X, -lv.Z)
		end
	end
	u.wyaw = u.wyaw or (want or 0)
	if want and u.state ~= S_STUNNED then
		u.wyaw = u.wyaw + wrapAngle(want - u.wyaw) * (1 - exp(-K.FACE_RATE * dt))
	end
	-- the server's lunges (Hit events only: the pet attacks by itself, nothing is predicted) / hops / recoils and the
	-- pet's dash (zone-local -> world)
	local off = Vector3.new(0, 0, 0)
	if u.dashAt then
		off = off + zoneDir(B, u.dashX or 0, u.dashZ or 0) * (K.DASH_DIST * Me.DashAmount(u, now))
	end
	if u.lungeAt then
		local p = (now - u.lungeAt) / K.LUNGE_TIME
		if p >= 1 then
			u.lungeAt = nil
		else
			off = off + zoneDir(B, u.lungeX or 0, u.lungeZ or 0) * (sin(p * pi) * (u.ranged and -K.RECOIL_DIST or K.LUNGE_DIST))
		end
	end
	if u.hopAt then
		local p = (now - u.hopAt) / K.HOP_TIME
		if p >= 1 then
			u.hopAt = nil
		elseif p > 0 then
			off = off + Vector3.new(0, sin(p * pi) * K.HOP_HEIGHT, 0)
		end
	end
	if u.hurtAt then
		local p = (now - u.hurtAt) / 0.18
		if p >= 1 then
			u.hurtAt = nil
		else
			off = off + zoneDir(B, u.hurtX or 0, u.hurtZ or 0) * (sin(p * pi) * 0.3)
		end
	end
	local stunned = u.state == S_STUNNED
	local bob = stunned and 0 or sin(now * 3.1 + u.phase) * K.BOB
	local p = u.drawn + off + Vector3.new(0, bob, 0)
	local cf = CFrame.new(p) * CFrame.Angles(0, u.wyaw, 0)
	if u.rigid then
		u.root.CFrame = cf
	else
		pcall(u.model.PivotTo, u.model, cf)
	end
	u.posed = true
	if PetBuilder and not u.animBroken then
		local opts = u.animOpts
		local moving = rcf ~= nil and isFighter and u.state == S_MOVING
		opts.Flap = stunned and 0 or ((u.state == S_DASHING or u.dashAt or moving or u.flyAt) and 1.8 or 1)
		opts.Excited = (u.state == S_ATTACKING or u.state == S_CASTING) and 0.6 or 0
		local ok = pcall(PetBuilder.Animate, u.model, now + u.phase, opts)
		if not ok then
			u.animBroken = true
		end
	end
	Units.UpdateStatus(B, u, now, cf)
end

-- the zone-local direction (x, z) of a Dash event: ev.dir (an angle like Element's, or { x, z }), ev.dx / ev.dz, the
-- point ev.tx / ev.tz, else toward the pet's target / my lock, else where it faces (mine: where my character looks)
function Me.DashDir(B, u, ev)
	local dx, dz = nil, nil
	local dir = ev.dir
	if type(dir) == "number" then
		dx, dz = cos(dir), sin(dir)
	elseif type(dir) == "table" then
		dx, dz = tonumber(dir.x or dir.X or dir[1]), tonumber(dir.z or dir.Z or dir[2])
	end
	if not (dx and dz) and tonumber(ev.dx) and tonumber(ev.dz) then
		dx, dz = tonumber(ev.dx), tonumber(ev.dz)
	end
	if not (dx and dz) and tonumber(ev.tx) and tonumber(ev.tz) then
		dx, dz = tonumber(ev.tx) - u.x, tonumber(ev.tz) - u.z
	end
	if not (dx and dz) then
		local t = B.units[tonumber(ev.target) or u.target or (u.mine and B.lock) or -1]
		if t and t ~= u then
			dx, dz = t.x - u.x, t.z - u.z
		end
	end
	if not (dx and dz) and u.mine then
		local root = Me.Root()
		if root then
			-- world -> zone-local: the transpose of the zone's rotation
			local lv, b = root.CFrame.LookVector, B.basis
			dx, dz = b[4] * lv.X + b[7] * lv.Y + b[10] * lv.Z, b[6] * lv.X + b[9] * lv.Y + b[12] * lv.Z
		end
	end
	if not (dx and dz) then
		local yaw = u.wyaw or u.yaw or 0
		dx, dz = -sin(yaw), -cos(yaw)
	end
	local d = sqrt(dx * dx + dz * dz)
	if d < 1e-3 then
		return 0, -1
	end
	return dx / d, dz / d
end

-- starts the drawn dash of pet u (a streak out and back + a trail), once per event
function Me.StartDash(B, u, ev)
	u.dashEv = ev
	if not u.model or u.parked or u.hidden then
		return
	end
	u.dashX, u.dashZ = Me.DashDir(B, u, ev)
	u.dashAt = os.clock()
	local a = unitCenter(B, u)
	local b = a + zoneDir(B, u.dashX, u.dashZ) * K.DASH_DIST
	Fx.Trail(a, b, COLORS.Dodge, 6, K.DASH_TIME + 0.1)
	Fx.Burst(a, COLORS.Dodge, 8, 9, 0.4, 0.35, { up = 0.2, alpha = 0.2 })
	St.dashes = (St.dashes or 0) + 1
end

-- 0..1..0 of a running dash (quick out, a softer way back); clears it at the end
function Me.DashAmount(u, now)
	local p = (now - u.dashAt) / K.DASH_TIME
	if p >= 1 or p < 0 then
		u.dashAt = nil
		return 0
	end
	if p < 0.4 then
		local q = 1 - p / 0.4
		return 1 - q * q
	end
	local q = (p - 0.4) / 0.6
	return 1 - q * q * (3 - 2 * q)
end

-- client/MouseLock (the mouse lock option, a separate module: no hard dependency): Hold(reason) frees the cursor while
-- the result card / the LEAVE confirm is up, Release(reason) gives it back; idempotent per reason
function Me.MouseHold(reason, on)
	on = on == true
	if (St.mouseHolds[reason] == true) == on then
		return
	end
	if not Mods.MouseLock then
		local inst = Client:FindFirstChild("MouseLock")
		if inst then
			local ok, m = pcall(require, inst)
			Mods.MouseLock = (ok and type(m) == "table") and m or false
		end
	end
	local ML = Mods.MouseLock
	local fn = ML and ML[on and "Hold" or "Release"]
	if type(fn) == "function" then
		pcall(fn, reason)
	end
	St.mouseHolds[reason] = on or nil
end

-- the camera shake scale: ClientSettings.Get("Shake") (menu W3); 1 when the module is missing
function Me.ShakeScale()
	local hook = BattleController.Hooks.Shake
	if type(hook) == "function" then
		return hook() and 1 or 0
	end
	if Mods.Settings == nil then
		Mods.Settings = optional(Client, "ClientSettings") or false
	end
	local cs = Mods.Settings
	if cs and type(cs.Get) == "function" then
		local ok, v = pcall(cs.Get, "Shake")
		if ok then
			return v and 1 or 0
		end
	end
	return 1
end

-- a tiny, rare camera shake (my fighter hit hard / knocked out): Humanoid.CameraOffset, never the camera itself
function Me.Shake(amount, dur)
	local scale = Me.ShakeScale()
	St.shakeCount = (St.shakeCount or 0) + 1
	if scale <= 0 then
		return
	end
	St.shake = { t0 = os.clock(), dur = dur or 0.18, amp = min(K.SHAKE_MAX, (amount or 0.2) * scale) }
	BattleController._wake()
end

function Me.UpdateShake(now)
	local sh = St.shake
	if not sh then
		return
	end
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local p = (now - sh.t0) / sh.dur
	if p >= 1 or not hum then
		St.shake = nil
		if hum then
			hum.CameraOffset = Vector3.new(0, 0, 0)
		end
		return
	end
	local a = sh.amp * (1 - p)
	hum.CameraOffset = Vector3.new(sin(now * 71) * a, cos(now * 63) * a * 0.6, 0)
end

----------------------------------------------------------------------
-- Telegraphs (boss attacks) and zones
----------------------------------------------------------------------
function Tele.Start(B, ev)
	local id = ev.id
	if id == nil or B.teles[id] then
		return
	end
	local fill, edge = Color3.fromRGB(255, 110, 90), Color3.fromRGB(255, 220, 160)
	local BB = lazyBoss()
	local boss = ev.boss and B.units[ev.boss]
	local bossId = (boss and boss.bossId) or B.BossId
	if BB and bossId then
		local ok, f, e = pcall(BB.TelegraphColor, bossId, ev.attack)
		if ok and typeof(f) == "Color3" then
			fill = f
			if typeof(e) == "Color3" then
				edge = e
			end
		end
	end
	local hits = max(0.2, num(ev.hits, 1.5))
	local at = num(ev.at, B.renderT + hits)
	local tl = {
		id = id,
		shape = ev.shape == "Line" and "Line" or "Circle",
		x = num(ev.x, 0),
		z = num(ev.z, 0),
		r = num(ev.r, 6),
		angle = num(ev.angle, 0),
		length = num(ev.length, 30),
		width = num(ev.width, 4),
		at = at,
		from = at - hits,
		-- the dodge deadline on the render clock: the render delay + the round trip + the run-out before the hit
		safeAt = max(at - hits + min(K.TELE_MIN_FILL, hits * 0.5), at - (interpDelay(B) + networkPing() + K.TELE_RUNOUT)),
		fill = fill,
		edgeColor = edge,
		freeze = ev.freeze,
	}
	-- the danger area: the pale edge colour tinted toward the fill, so it still shows on the pale arena sand
	local edgePart = Fx.Part(edge:Lerp(fill, 0.35), Enum.Material.Neon, 0.6)
	local fillPart = Fx.Part(fill, Enum.Material.Neon, 0.35)
	tl.edge, tl.fillPart = edgePart, fillPart
	if tl.shape == "Circle" then
		local cf = worldFrame(B, tl.x, 0.08, tl.z, 0) * CFrame.Angles(0, 0, pi / 2)
		if edgePart then
			edgePart.Shape = Enum.PartType.Cylinder
			edgePart.Size = Vector3.new(0.1, tl.r * 2, tl.r * 2)
			edgePart.CFrame = cf
		end
		if fillPart then
			fillPart.Shape = Enum.PartType.Cylinder
			fillPart.Size = Vector3.new(0.14, 0.1, 0.1)
			fillPart.CFrame = cf * CFrame.new(0.04, 0, 0)
		end
	else
		-- a line from (x, z) along angle (atan2(dz, dx) in zone space)
		local dx, dz = cos(tl.angle), sin(tl.angle)
		tl.dx, tl.dz = dx, dz
		local yaw = yawToward(dx, dz)
		tl.yaw = yaw
		if edgePart then
			edgePart.Size = Vector3.new(tl.width, 0.1, tl.length)
			edgePart.CFrame = worldFrame(B, tl.x + dx * tl.length / 2, 0.08, tl.z + dz * tl.length / 2, yaw)
		end
		if fillPart then
			fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, 0.1)
		end
	end
	-- a crisp rim in the saturated telegraph colour: the pale area alone barely reads on the arena's sand, the rim
	-- says exactly where safety starts (16 segments round a circle; two rails and an end cap along a line)
	local rimColor = fill:Lerp(Color3.new(0, 0, 0), 0.22)
	tl.rim = {}
	if tl.shape == "Circle" then
		local segLen = 2 * tl.r * math.tan(pi / 16) + 0.12
		for j = 0, 15 do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = Vector3.new(segLen, 0.16, 0.55)
			seg.CFrame = worldFrame(B, tl.x, 0.14, tl.z, 0) * CFrame.Angles(0, j * pi / 8, 0) * CFrame.new(0, 0, -(tl.r - 0.27))
			tl.rim[#tl.rim + 1] = seg
		end
	else
		-- the frame of edgePart: local X across the line, local Z along it
		local mid = worldFrame(B, tl.x + tl.dx * tl.length / 2, 0.14, tl.z + tl.dz * tl.length / 2, tl.yaw)
		local tip = worldFrame(B, tl.x + tl.dx * (tl.length - 0.27), 0.14, tl.z + tl.dz * (tl.length - 0.27), tl.yaw)
		local pieces = {
			{ mid * CFrame.new(tl.width / 2 - 0.27, 0, 0), Vector3.new(0.55, 0.16, tl.length) },
			{ mid * CFrame.new(-(tl.width / 2 - 0.27), 0, 0), Vector3.new(0.55, 0.16, tl.length) },
			{ tip, Vector3.new(tl.width, 0.16, 0.55) },
		}
		for _, piece in ipairs(pieces) do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = piece[2]
			seg.CFrame = piece[1]
			tl.rim[#tl.rim + 1] = seg
		end
	end
	B.teles[id] = tl
	-- the boss winds up toward it
	if boss and boss.isBoss then
		Units.SetPose(boss, "Windup", hits, ev.attack)
		boss.windupFrom = tl.from
		boss.windupAt = tl.at
		if tl.shape == "Line" then
			boss.faceX, boss.faceZ = tl.x + (tl.dx or 0) * 10, tl.z + (tl.dz or 0) * 10
		else
			boss.faceX, boss.faceZ = tl.x, tl.z
		end
	end
end

function Tele.Free(tl)
	Fx.Free(tl.edge)
	Fx.Free(tl.fillPart)
	tl.edge, tl.fillPart = nil, nil
	for _, seg in ipairs(tl.rim or {}) do
		Fx.Free(seg)
	end
	tl.rim = nil
end

local function setRim(tl, transparency)
	for _, seg in ipairs(tl.rim or {}) do
		seg.Transparency = transparency
	end
end

-- is the zone-local point (x, z) inside the telegraph's shape (grown by pad studs)?
function Tele.Covers(tl, x, z, pad)
	local dx, dz = x - tl.x, z - tl.z
	if tl.shape == "Line" then
		local along = dx * (tl.dx or 1) + dz * (tl.dz or 0)
		if along < -pad or along > tl.length + pad then
			return false
		end
		return abs(dx * (tl.dz or 0) - dz * (tl.dx or 1)) <= tl.width / 2 + pad
	end
	return dx * dx + dz * dz <= (tl.r + pad) * (tl.r + pad)
end

-- my fighter stands in a telegraph that has not hit yet (the HUD's DASH cue: dash through it)
local function threatened(B, tl)
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED and Tele.Covers(tl, u.x, u.z, K.THREAT_PAD) then
			return true
		end
	end
	return false
end

function Tele.Update(B, now)
	local t = B.renderT
	local threat = false
	for id, tl in pairs(B.teles) do
		if not threat and B.Fighter and t < tl.at and threatened(B, tl) then
			threat = true
		end
		if t >= tl.at then
			if not tl.impactAt then
				tl.impactAt = now
				-- the hit: a flash of the shape + a shock ring / burst
				local center
				if tl.shape == "Circle" then
					center = worldPoint(B, tl.x, 0.4, tl.z)
					Fx.Ring(center, tl.r, tl.edgeColor, 18, 0.9, 0.45, 0.05)
					Fx.Burst(center, tl.fill, 12, 12, 0.6, 0.55, { up = 0.9, color2 = tl.edgeColor })
				else
					local mid = worldPoint(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2)
					Fx.Beam(worldFrame(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2, tl.yaw), tl.length, tl.width * 0.8, tl.fill, 0.4)
					Fx.Burst(mid, tl.edgeColor, 8, 10, 0.5, 0.5, { up = 0.7 })
				end
				if tl.freeze then
					local c = worldPoint(B, tl.x, 0.6, tl.z)
					Fx.Burst(c, COLORS.Ice, 10, 9, 0.55, 0.6, { material = Enum.Material.Glass, alpha = 0.2, up = 0.8 })
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05
				end
				local boss = B.boss
				if boss and boss.pose == "Windup" then
					Units.SetPose(boss, "Attack", 0.7)
					boss.windupAt = nil
				end
			end
			local p = (now - tl.impactAt) / 0.35
			if p >= 1 then
				Tele.Free(tl)
				B.teles[id] = nil
			else
				if tl.edge then
					tl.edge.Transparency = 0.6 + 0.4 * p
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05 + 0.95 * p
				end
				setRim(tl, 0.1 + 0.9 * p)
			end
		else
			-- the fill completes at the dodge deadline (safeAt), then the shape flashes until the hit
			local fillEnd = tl.safeAt or tl.at
			local p = clamp((t - tl.from) / max(0.05, fillEnd - tl.from), 0, 1)
			if t >= fillEnd then
				if not tl.late then
					tl.late = true
					for _, seg in ipairs(tl.rim or {}) do
						seg.Color = COLORS.LateRim
					end
				end
				local on = sin(now * 26) > 0
				if tl.edge then
					tl.edge.Transparency = on and 0.25 or 0.65
				end
				setRim(tl, on and 0 or 0.6)
			else
				local pulse = 0.5 + 0.5 * sin(now * 10)
				if tl.edge then
					tl.edge.Transparency = 0.5 + 0.2 * pulse
				end
				setRim(tl, 0.05 + 0.3 * pulse)
			end
			if tl.fillPart then
				if tl.shape == "Circle" then
					local d = max(0.1, tl.r * 2 * p)
					tl.fillPart.Size = Vector3.new(0.14, d, d)
				else
					local len = max(0.1, tl.length * p)
					tl.fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, len)
					tl.fillPart.CFrame = worldFrame(B, tl.x + tl.dx * len / 2, 0.12, tl.z + tl.dz * len / 2, tl.yaw)
				end
				tl.fillPart.Transparency = 0.45 - 0.25 * p
			end
		end
	end
	B.threat = threat
end

function Tele.ClearAll(B)
	for id, tl in pairs(B.teles) do
		Tele.Free(tl)
		B.teles[id] = nil
	end
end

----------------------------------------------------------------------
-- Events (played on the delayed render clock)
----------------------------------------------------------------------
local function specialColor(u, kind)
	if u and u.special and typeof(u.special.Color) == "Color3" then
		return u.special.Color
	end
	if u then
		return elementColor(u.element)
	end
	if kind == "Heal" then
		return COLORS.Heal
	end
	return COLORS.Gold
end

local function numberHeight(u)
	if u.isBoss then
		return (u.height or 20) * 0.5 + 2
	end
	return (u.height or 3) / 2 + 1.8
end

local Handlers = {}

Handlers[EV.Hit] = function(B, ev)
	local victim = B.units[tonumber(ev.to) or -1]
	local attacker = ev.from and B.units[tonumber(ev.from) or -1]
	if not victim then
		return
	end
	local dmg = num(ev.dmg, 0)
	-- Phase 5: a dodged hit (dash i-frames / out of reach at the impact)
	if ev.miss then
		if victim.root and not victim.parked then
			Fx.Number(victim.root, numberHeight(victim) + 0.4, "DODGED!", COLORS.Dodge, K.CALLOUT_PX, 0.9)
		end
		if attacker and not attacker.isBoss then
			local dx, dz = victim.x - attacker.x, victim.z - attacker.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				attacker.lungeAt = os.clock()
				attacker.lungeX, attacker.lungeZ = dx / d, dz / d
			end
		end
		return
	end
	-- attacker motion: plain attacks lunge (melee) or shoot a bolt (ranged); my fighter too (it attacks by itself:
	-- its lunges come only from these server hits, never from a press)
	if attacker and not ev.special and not ev.zone and not ev.tele and not ev.element then
		if attacker.isBoss then
			if attacker.pose ~= "Windup" and attacker.pose ~= "Attack" and attacker.pose ~= "Enrage" then
				Units.SetPose(attacker, "Basic", 0.6, ev.attack)
				attacker.faceX, attacker.faceZ = victim.x, victim.z
			end
			Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.7, 0.35)
		else
			local dx, dz = victim.x - attacker.x, victim.z - attacker.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				attacker.lungeAt = os.clock()
				attacker.lungeX, attacker.lungeZ = dx / d, dz / d
			end
			if attacker.ranged and attacker.model and not attacker.parked then
				Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.42, 0.24)
			end
		end
	end
	-- my fighter hit hard: a tiny camera shake (x the Shake setting)
	if victim.mine and B.Fighter and victim.id == B.fighterId and dmg >= victim.maxHp * 0.12 then
		Me.Shake(0.18, 0.16)
	end
	-- victim feedback
	if not victim.isBoss and attacker then
		local dx, dz = victim.x - attacker.x, victim.z - attacker.z
		local d = sqrt(dx * dx + dz * dz)
		if d > 0.01 then
			victim.hurtAt = os.clock()
			victim.hurtX, victim.hurtZ = dx / d, dz / d
		end
	end
	if not ev.zone or math.random() < 0.5 then
		Fx.Flash(victim, (ev.elem and ev.elem > 1) and Color3.fromRGB(255, 226, 190) or COLORS.White)
	end
	local adornee = victim.root
	if not adornee or victim.parked then
		return
	end
	local text, color, px = tostring(floor(dmg + 0.5)), COLORS.White, K.NUMBER_PX
	if ev.crit then
		text = "CRIT " .. text
		color = COLORS.Gold
		px = K.CRIT_PX
	elseif ev.elem and ev.elem > 1 then
		text = text .. "!"
		color = COLORS.Strong
		px = K.NUMBER_PX + 2
	elseif ev.elem and ev.elem < 1 then
		color = COLORS.Weak
	end
	if victim.mine then
		color = (color == COLORS.White) and Color3.fromRGB(255, 196, 196) or color
	end
	if ev.special and attacker then
		color = specialColor(attacker):Lerp(COLORS.White, 0.35)
		px = max(px, K.NUMBER_PX + 2)
	elseif ev.element and attacker then
		color = elementColor(attacker.element):Lerp(COLORS.White, 0.3)
		px = max(px, K.NUMBER_PX + 2)
	elseif ev.burn then
		text, color, px = "BURN " .. text, COLORS.Strong, K.NUMBER_PX - 4
	end
	if dmg > 0 then
		Fx.Number(adornee, numberHeight(victim), text, color, px)
	end
	if num(ev.absorbed, 0) > 0 then
		Fx.Number(adornee, numberHeight(victim) + 0.8, "BLOCK " .. tostring(floor(ev.absorbed + 0.5)), COLORS.Shield, K.NUMBER_PX - 2, 0.8)
	end
	if ev.freeze then
		victim.iceUntil = os.clock() + num(ev.freeze, 2)
	end
end

Handlers[EV.Special] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local kind = tostring(ev.kind or "")
	local color = specialColor(u, kind)
	local S = SPECIALS[kind] or {}
	if u and u.root and not u.parked then
		local label = tostring(ev.name or kind)
		Fx.Number(u.root, numberHeight(u) + 0.6, string.upper(label) .. "!", color:Lerp(COLORS.White, 0.2), K.CALLOUT_PX, 1.2)
		Fx.Burst(unitCenter(B, u), color, 8, 6, 0.35, 0.45, { up = 0.9, gravity = 4 })
	end
	local tx, tz = num(ev.tx, num(ev.x, 0)), num(ev.tz, num(ev.z, 0))
	if kind == "Blast" then
		local c = worldPoint(B, tx, 0.6, tz)
		local r = num(S.Radius, 7)
		Fx.Ring(c, r, color, 20, 0.8, 0.5, 0.05)
		Fx.Burst(c + Vector3.new(0, 0.8, 0), color, 16, 13, 0.6, 0.6, { color2 = COLORS.White:Lerp(color, 0.4), up = 0.8 })
	elseif kind == "Heal" then
		for _, h in ipairs(type(ev.heals) == "table" and ev.heals or {}) do
			local a = B.units[tonumber(h[1]) or -1]
			if a and a.root and not a.parked then
				Fx.Rise(unitCenter(B, a), COLORS.Heal, 8, 0.32, 0.9, 1.6)
				if num(h[2], 0) > 0 then
					Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(h[2], 0) + 0.5)), COLORS.Heal, K.NUMBER_PX)
				end
			end
		end
	elseif kind == "Shield" then
		local seconds = num(S.Seconds, 6)
		for _, id in ipairs(type(ev.shields) == "table" and ev.shields or {}) do
			local a = B.units[tonumber(id) or -1]
			if a and a.root and not a.parked then
				a.shieldUntil = os.clock() + seconds + 0.5
				Fx.Ring(unitCenter(B, a), 2.2, COLORS.Shield, 10, 0.4, 0.5, 0.2)
			end
		end
	elseif kind == "Pounce" then
		if u then
			local a = worldPoint(B, num(ev.x, u.x), 1.4, num(ev.z, u.z))
			local b = worldPoint(B, tx, 1.4, tz)
			Fx.Trail(a, b, color, 9, 0.5)
			u.hopAt = os.clock()
		end
		Fx.Burst(worldPoint(B, tx, 1.2, tz), color, 12, 11, 0.5, 0.55, { up = 0.7, color2 = COLORS.White })
	elseif kind == "Freeze" then
		local c = worldPoint(B, tx, 0.5, tz)
		local r = num(S.Radius, 6)
		Fx.Ring(c, r, COLORS.Ice, 16, 0.7, 0.55, 0.1)
		Fx.Burst(c + Vector3.new(0, 0.6, 0), COLORS.Ice, 14, 10, 0.55, 0.7, { material = Enum.Material.Glass, alpha = 0.15, up = 0.8, color2 = COLORS.White })
		local stun = num(S.Stun, 1) + 0.4
		for _, id in ipairs(type(ev.stunned) == "table" and ev.stunned or {}) do
			local a = B.units[tonumber(id) or -1]
			if a then
				a.iceUntil = os.clock() + stun
			end
		end
	elseif kind == "Beam" then
		local length = num(S.Length, 26)
		local width = num(S.Width, 4)
		local angle = num(ev.angle, 0)
		local dx, dz = cos(angle), sin(angle)
		local sx, sz = num(ev.x, u and u.x or 0), num(ev.z, u and u.z or 0)
		local cf = worldFrame(B, sx + dx * length / 2, 1.6, sz + dz * length / 2, yawToward(dx, dz))
		Fx.Beam(cf, length, width * 0.7, color, 0.5)
		Fx.Burst(worldPoint(B, sx + dx * length, 1.6, sz + dz * length), color, 8, 8, 0.4, 0.45, { up = 0.5 })
	elseif kind == "Rally" or kind == "Haste" then
		if u and u.model and not u.parked then
			Fx.Rise(unitCenter(B, u), kind == "Haste" and COLORS.Dodge or COLORS.Gold, 12, 0.34, 0.9, 1.8)
		end
	elseif kind == "Storm" then
		-- the Zone event that follows draws the cloud
		Fx.Burst(worldPoint(B, tx, 5, tz), COLORS.StormLight, 6, 5, 0.6, 0.5, { up = 0.3, gravity = 2 })
	end
end

Handlers[EV.Zone] = function(B, ev)
	local kind = tostring(ev.kind or "")
	local x, z = num(ev.x, 0), num(ev.z, 0)
	local r = num(ev.r, 6)
	local seconds = max(0.5, num(ev.seconds, 4))
	local floorCF = worldFrame(B, x, 0, z, 0)
	if kind == "Storm" then
		local u = B.units[tonumber(ev.unit) or -1]
		Fx.Zone(floorCF, r, seconds, specialColor(u, "Storm"), "Storm")
	else
		local color = Color3.fromRGB(255, 120, 60)
		local BB = lazyBoss()
		if BB and B.BossId then
			local ok, f = pcall(BB.TelegraphColor, B.BossId, ev.attack)
			if ok and typeof(f) == "Color3" then
				color = f
			end
		end
		Fx.Zone(floorCF, r, seconds, color, "Linger")
	end
end

Handlers[EV.KO] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return
	end
	if u.root and not u.parked then
		Fx.Number(u.root, numberHeight(u) + 0.4, "KO!", Color3.fromRGB(220, 226, 240), K.CALLOUT_PX, 1.1)
		if not u.isBoss and not u.poofed then
			u.poofed = true
			Fx.Burst(unitCenter(B, u), Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
		elseif u.isBoss then
			Fx.Burst(unitCenter(B, u), elementColor(u.element), 24, 16, 0.9, 1.1, { color2 = COLORS.White, up = 0.9 })
		end
	end
	u.hp = 0
	u.state = S_DOWN
	if B.lock == u.id then
		B.lock = nil
	end
	Hud.enemyDirty = true
	if u.mine and u.id == B.fighterId then
		Me.Shake(0.3, 0.3)
	end
end

Handlers[EV.Telegraph] = function(B, ev)
	Tele.Start(B, ev)
end

Handlers[EV.Spawn] = function(B, ev)
	Units.AddList(B, ev.units)
	if ev.wave then
		B.wave = num(ev.wave, 0)
		local boss = B.boss
		if boss and boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "MINIONS!", COLORS.Enemy:Lerp(COLORS.White, 0.3), K.CALLOUT_PX, 1.4)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.Enrage] = function(B, ev)
	B.enraged = true
	local boss = B.units[tonumber(ev.unit) or -1] or B.boss
	if boss and boss.model then
		local BB = lazyBoss()
		if BB then
			pcall(BB.SetEnraged, boss.model, true)
		end
		Units.SetPose(boss, "Enrage", 1.3)
		if boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "ENRAGED!", COLORS.Enemy, K.CRIT_PX, 1.6)
		end
		Fx.Ring(unitCenter(B, boss), 14, COLORS.Enemy, 24, 1, 0.8, 0.1)
	end
end

Handlers[EV.Order] = function()
	-- (handled on arrival: Net.Pre)
end

Handlers[EV.Leave] = function(B, ev)
	for _, id in ipairs(type(ev.units) == "table" and ev.units or {}) do
		local u = B.units[tonumber(id) or -1]
		if u then
			if u.root and not u.parked then
				Fx.Burst(unitCenter(B, u), Color3.fromRGB(226, 232, 246), 8, 7, 0.45, 0.5, { alpha = 0.1 })
			end
			Units.Remove(B, u.id)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.End] = function(B)
	B.simEnded = true
end

-- Phase 5 events (the visuals, on the render clock; the HUD / prediction side runs on arrival in Net.Pre)
local function calloutAbove(u, text, color, px, life)
	if u and u.root and not u.parked then
		Fx.Number(u.root, numberHeight(u) + 0.8, text, color, px or K.CALLOUT_PX, life or 1.1)
	end
end

Handlers[EV.Element or "Element"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local color = elementColor(ev.element or (u and u.element))
	local sx, sz = num(ev.x, u and u.x or 0), num(ev.z, u and u.z or 0)
	local angle = num(ev.angle, 0)
	local shape = tostring(ev.shape or "Cone")
	calloutAbove(u, string.upper(tostring(ev.name or ev.element or "")) .. "!", color:Lerp(COLORS.White, 0.25))
	if u and u.id ~= B.fighterId then
		u.hopAt = os.clock()
	end
	local dx, dz = cos(angle), sin(angle)
	if shape == "Circle" then
		local c = worldPoint(B, sx, 0.6, sz)
		Fx.Ring(c, 8, color, 22, 0.8, 0.5, 0.05)
		Fx.Burst(c + Vector3.new(0, 0.8, 0), color, 14, 11, 0.55, 0.55, { color2 = COLORS.White, up = 0.8 })
	elseif shape == "Line" then
		local length = 24
		local cf = worldFrame(B, sx + dx * length / 2, 1.6, sz + dz * length / 2, yawToward(dx, dz))
		Fx.Beam(cf, length, 3, color, 0.45)
	else
		-- a cone: bursts fanned out in front of the caster
		for i = -2, 2 do
			local a = angle + i * 0.22
			local r = 9 + abs(i) * 0.8
			Fx.Burst(worldPoint(B, sx + cos(a) * r, 1.2, sz + sin(a) * r), color, 5, 7, 0.45, 0.45, { up = 0.6, color2 = COLORS.White })
		end
		Fx.Trail(worldPoint(B, sx, 1.3, sz), worldPoint(B, sx + dx * 11, 1.3, sz + dz * 11), color, 8, 0.4)
	end
end

-- the PET dashes (the character never does, decision 5): every pet's Dash draws its streak; my own fighter's already
-- started when the event arrived (Net.Pre: no render delay for my own dodge)
Handlers[EV.Dash or "Dash"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if u and u.dashEv ~= ev then
		Me.StartDash(B, u, ev)
	end
end

Handlers[EV.Buff or "Buff"] = function(B, ev)
	local helper = B.units[tonumber(ev.unit) or -1]
	local fighter = B.units[tonumber(ev.target) or -1]
	local color = (helper and elementColor(helper.element)) or COLORS.Heal
	if helper and helper.mine then
		helper.flyAt = os.clock() -- fly to the fighter and back
	end
	if fighter then
		calloutAbove(fighter, string.upper(tostring(ev.name or ev.kind or "BUFF")), color:Lerp(COLORS.White, 0.2), K.CALLOUT_PX, 1.4)
		if fighter.model and not fighter.parked then
			Fx.Rise(unitCenter(B, fighter), color, 10, 0.32, 0.9, 1.6)
		end
	end
end

Handlers[EV.Swap or "Swap"] = function(B, ev)
	local incoming = B.units[tonumber(ev["in"]) or -1]
	local out = B.units[tonumber(ev.out) or -1]
	if incoming and incoming.model and not incoming.parked then
		calloutAbove(incoming, ev.auto and "GO!" or "SWAP!", COLORS.Dodge, K.CALLOUT_PX, 1)
		Fx.Burst(unitCenter(B, incoming), elementColor(incoming.element), 10, 8, 0.45, 0.45, { up = 0.7, color2 = COLORS.White })
	end
	local now = os.clock()
	for _, u in ipairs({ incoming, out }) do
		if u and u.mine and u.drawn then
			u.swapFrom = u.drawn
			u.swapAt = now
		end
	end
end

Handlers[EV.Windup or "Windup"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if u then
		-- the list row's "!" until the hit lands (at = sim time of the hit)
		u.windupUntil = os.clock() + max(0.2, num(ev.at, B.renderT + 0.45) - B.renderT) + 0.1
	end
end

-- dungeon fixes (root cause A): the server opens a room's encounter with an EMPTY side 2 ("Start") and spawns every
-- wave afterwards: the Wave event carries the enemies, so they are added here (deduped by id, like Spawn)
Handlers[EV.Wave or "Wave"] = function(B, ev)
	Units.AddList(B, ev.units)
	B.wave = num(ev.index, B.wave or 0)
	if B.Dungeon then
		B.Dungeon.Wave = B.wave
	end
	local f = B.fighterId and B.units[B.fighterId]
	calloutAbove(f, "WAVE " .. tostring(B.wave) .. "!", Theme.Neon and Theme.Neon.Purple or COLORS.Gold, K.CRIT_PX, 1.4)
	Hud.enemyDirty = true
	Hud.Rebuild()
end

Handlers[EV.EnemiesDown or "EnemiesDown"] = function(B)
	local f = B.fighterId and B.units[B.fighterId]
	calloutAbove(f, "WAVE CLEARED!", COLORS.Mine, K.CALLOUT_PX, 1.2)
end

Handlers[EV.Speed or "Speed"] = function()
	-- (handled on arrival: Net.Pre)
end

function Net.PlayDue(B, now)
	local q = B.evq
	if #q == 0 then
		return
	end
	local played = 0
	local t = B.renderT
	while #q > 0 and (q[1].t <= t or #q > 400) do
		local item = table.remove(q, 1)
		local fn = Handlers[item.ev.type]
		if fn then
			local ok, err = pcall(fn, B, item.ev)
			if not ok then
				warnOnce("event_" .. tostring(item.ev.type), "event " .. tostring(item.ev.type) .. " failed: " .. tostring(err))
			end
		end
		played = played + 1
		if played > 120 then
			break
		end
	end
end

----------------------------------------------------------------------
-- HUD (Phase 5, contract 4.7: the battle HUD of image 24.png on the Neon kit)
----------------------------------------------------------------------
local function label(parent, text, role, size, props)
	local l = Theme.Label(text, role, { Size = size, Stroke = 0.15, Outline = 2 })
	l.BackgroundTransparency = 1
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

local function smallPill(parent, text, color, props)
	local dark = Theme.Darken(color, 0.62)
	local l = Theme.Label(text, "Heading", { Size = 15, Stroke = 0.1, StrokeColor = dark, Outline = 1.5, OutlineColor = dark })
	l.Name = "Pill"
	l.BackgroundTransparency = 0
	l.BackgroundColor3 = color
	l.BorderSizePixel = 0
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, 22)
	l.TextXAlignment = Enum.TextXAlignment.Center
	Theme.Corner(l, UDim.new(0, 11))
	Theme.Stroke(l, COLORS.Navy, 2, 0)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, l)
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

-- a thin bar without text (timers): returns { Root, Fill }
local function thinBar(parent, name, height, color, props)
	local root = make("Frame", { Name = name, BackgroundColor3 = COLORS.Track, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height) }, parent)
	if props then
		for key, value in pairs(props) do
			root[key] = value
		end
	end
	Theme.Corner(root, UDim.new(0, max(2, floor(height / 2))))
	local fill = make("Frame", { Name = "Fill", BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, root)
	Theme.Corner(fill, UDim.new(0, max(2, floor(height / 2))))
	return { Root = root, Fill = fill, frac = 1 }
end

local function setThin(b, frac)
	frac = clamp(frac, 0, 1)
	if abs(frac - (b.frac or -1)) > 0.003 then
		b.frac = frac
		b.Fill.Size = UDim2.fromScale(max(frac, 0.001), 1)
		b.Fill.Visible = frac > 0.002
	end
end

-- a rough width of `text` in px at `size` (bold display fonts run ~0.62 em per character)
local function textWidth(text, size)
	return #tostring(text or "") * size * 0.62
end

local function setText(lbl, text)
	if lbl and lbl.Text ~= text then
		lbl.Text = text
	end
end

local function setVisible(obj, on)
	if obj and obj.Visible ~= (on == true) then
		obj.Visible = on == true
	end
end

-- a NeonKit card (a Theme panel when the kit is missing): { Root, Body, SetColor }
local function neonCard(parent, name, color, props)
	local c
	if Mods.NeonKit and type(Mods.NeonKit.Card) == "function" then
		local ok, result = pcall(Mods.NeonKit.Card, { Name = name, Color = color, Parent = parent, Size = props and props.Size, Glow = props and props.Glow, Floor = props and props.Floor, Class = props and props.Class })
		if ok and type(result) == "table" then
			c = result
		end
	end
	if not c then
		local f = Theme.Panel({ Name = name })
		f.Parent = parent
		c = { Root = f, Body = f, SetColor = function() end }
	end
	if props then
		for key, value in pairs(props) do
			if key ~= "Size" and key ~= "Glow" and key ~= "Floor" and key ~= "Class" then
				c.Root[key] = value
			end
		end
	end
	return c
end

-- the key hint chip (desktop / gamepad)
local function keyChip(parent, text, props)
	local chip = make("Frame", { Name = "Key", BackgroundColor3 = Theme.Colors.PanelInk or COLORS.Navy, BorderSizePixel = 0, Size = UDim2.fromOffset(30, 24), ZIndex = 8 }, parent)
	Theme.Corner(chip, UDim.new(0, 7))
	Theme.Stroke(chip, COLORS.White, 1.5, 0.3)
	local l = label(chip, text, "Heading", 15, { Name = "Text", Size = UDim2.fromScale(1, 1), ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center })
	if props then
		for key, value in pairs(props) do
			chip[key] = value
		end
	end
	return chip, l
end

-- every HUD text stays >= MIN_TEXT_PX on the screen: design sizes grow to MIN_TEXT_PX / factor on small screens
-- (the 1080p design sizes are kept as the attribute BaseText)
function Hud.FixText(root, factor)
	local minDesign = math.ceil(K.MIN_TEXT_PX / max(0.05, factor) - 1e-6)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			local base = d:GetAttribute("BaseText")
			if type(base) ~= "number" then
				base = d.TextSize
				d:SetAttribute("BaseText", base)
			end
			local want = max(base, minDesign)
			if d.TextSize ~= want then
				d.TextSize = want
			end
		end
	end
end

local function setDisabled(b, disabled)
	if (b:GetAttribute("Disabled") == true) ~= (disabled == true) then
		b:SetAttribute("Disabled", disabled == true)
	end
end

-- a round progress ring (a pie of two clipped half discs with a hard-edged UIGradient each; no asset ids): the
-- `frac` share of the circle from 12 o'clock clockwise in `color`, the rest the dark track. setPie writes only when
-- the shown share moves by a 5 degree step.
local SWEEP = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.5, 0),
	NumberSequenceKeypoint.new(0.501, 1),
	NumberSequenceKeypoint.new(1, 1),
})

local function newPie(parent, name, size, color, z)
	local root = make("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		ZIndex = z or 2,
	}, parent)
	local track = make("Frame", { Name = "Track", BackgroundColor3 = COLORS.Track, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = z or 2 }, root)
	Theme.Corner(track, UDim.new(0.5, 0))
	local pie = { Root = root, Track = track, frac = -1, color = color }
	for _, side in ipairs({ "R", "L" }) do
		local clip = make("Frame", {
			Name = side,
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Position = UDim2.fromScale(side == "R" and 0.5 or 0, 0),
			Size = UDim2.fromScale(0.5, 1),
			ZIndex = z or 2,
		}, root)
		local disc = make("Frame", {
			Name = "Disc",
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(side == "R" and -1 or 0, 0),
			Size = UDim2.fromScale(2, 1),
			Visible = false,
			ZIndex = z or 2,
		}, clip)
		Theme.Corner(disc, UDim.new(0.5, 0))
		local g = make("UIGradient", { Name = "Sweep", Transparency = SWEEP, Rotation = 0 }, disc)
		pie[side] = { clip = clip, disc = disc, g = g }
	end
	return pie
end

local function setPie(pie, frac, color)
	if color and pie.color ~= color then
		pie.color = color
		pie.R.disc.BackgroundColor3 = color
		pie.L.disc.BackgroundColor3 = color
	end
	local q = floor(clamp(frac, 0, 1) * 72 + 0.5) / 72
	if q == pie.frac then
		return
	end
	pie.frac = q
	local a = q * 360
	pie.R.disc.Visible = a > 0
	pie.R.g.Rotation = min(a, 180)
	pie.L.disc.Visible = a > 180
	pie.L.g.Rotation = max(0, a - 180) + 180
	St.ringWrites = (St.ringWrites or 0) + 1
end

local ELEMENT_GLYPH = {
	Water = "\240\159\146\167", -- droplet
	Flame = "\240\159\148\165", -- fire
	Frost = "\226\157\132", -- snowflake
	Nature = "\240\159\141\131", -- leaf
	Earth = "\226\155\176", -- mountain
	Storm = "\226\154\161", -- lightning
	Celestial = "\226\156\168", -- sparkles
	Shadow = "\240\159\140\153", -- moon
}
local GLYPH = {
	Attack = "\226\154\148", -- crossed swords
	Special = "\226\152\133", -- star
	Dash = "\240\159\146\168", -- dash
	Swap = "\226\135\132", -- left-right arrows
	Heart = "\226\153\165", -- heart
	Crown = "\240\159\145\145",
	Star = "\226\152\133",
}

function Hud.Ensure()
	if Hud.gui and Hud.gui.Parent then
		return true
	end
	local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end
	local old = playerGui:FindFirstChild(K.GUI_NAME)
	if old then
		old:Destroy()
	end
	local gui = make("ScreenGui", {
		Name = K.GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.DISPLAY_ORDER,
		Enabled = true,
	}, playerGui)
	local root = make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	Hud.scale = make("UIScale", { Name = "ReadScale", Scale = 1 }, root)
	Hud.gui, Hud.root = gui, root
	Hud.team = make("Frame", { Name = "Team", BackgroundTransparency = 1, Visible = false }, root)
	Hud.enemies = make("Frame", { Name = "Enemies", BackgroundTransparency = 1, Visible = false }, root)
	Hud.top = make("Frame", { Name = "TopCard", BackgroundTransparency = 1, Visible = false, AnchorPoint = Vector2.new(0.5, 0) }, root)
	Hud.cmd = make("Frame", { Name = "Commands", BackgroundTransparency = 1, Visible = false, AnchorPoint = Vector2.new(1, 1) }, root)
	Hud.resultCard = neonCard(root, "ResultCard", "Gold", { Visible = false, Size = UDim2.fromOffset(K.RESULT_W, 200), Floor = false })
	Hud.result = Hud.resultCard.Root
	Hud.rows = {}
	Hud.helpers = {}
	Hud.buttons = {}
	Hud.BuildFighter()
	Hud.BuildActions()
	Hud.BuildTop()
	return true
end

-- the screen in design pixels + the layout kind (Compact = a phone: touch, or a screen under 900 px wide / 600 high)
function Hud.Metrics()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	local f = Theme.ScreenFactor(vp.Y)
	local w = vp.X / f
	local h = max(200, vp.Y - inset) / f
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local compact = touch or vp.X < K.COMPACT_W or vp.Y < K.COMPACT_H
	return { W = w, H = h, F = f, Compact = compact, Touch = touch, Landscape = vp.X > vp.Y, VX = vp.X, VY = vp.Y, Inset = inset }
end

-- the key hints (keyboard / gamepad)
function Hud.KeyText(kind, index)
	if St.gamepad then
		return ({ Attack = "X", Element = "Y", Special = "RB", Dash = "B", Buff = (index == 2) and "\226\134\145" or "LB", Swap = (index == 2) and "\226\134\146" or "\226\134\144" })[kind] or ""
	end
	return ({ Attack = "F", Element = "E", Special = "Q", Dash = "\226\135\167", Buff = tostring(index or 1), Swap = "hold " .. tostring(index or 1) })[kind] or ""
end

----------------------------------------------------------------------
-- the fighter card (top left) + the two helper portraits under it
----------------------------------------------------------------------
local function heart(parent, i)
	local l = label(parent, GLYPH.Heart, "Display", 20, { Name = "Heart" .. i, Size = UDim2.fromOffset(22, 22), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = COLORS.Life })
	return l
end

function Hud.BuildFighter()
	local team = Hud.team
	local card = neonCard(team, "Fighter", "Green", { Size = UDim2.fromOffset(K.FC_W, K.FC_H), Floor = true })
	Hud.fighterCard = card
	local body = card.Body
	local F = {}
	F.Name = label(body, "", "Heading", 26, { Name = "PetName", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	F.Level = smallPill(body, "Lv 1", COLORS.LevelPill, { Name = "Level", AutomaticSize = Enum.AutomaticSize.None })
	F.Level.TextSize = 17
	F.Element = make("Frame", { Name = "Element", BackgroundColor3 = COLORS.Ally, BorderSizePixel = 0 }, body)
	Theme.Corner(F.Element, UDim.new(0.5, 0))
	Theme.Stroke(F.Element, COLORS.White, 1.5, 0.25)
	F.ElementGlyph = label(F.Element, "", "Display", 16, { Name = "Glyph", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	F.Stars = label(body, "", "Heading", 18, { Name = "Stars", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.Gold })
	-- HP: track, the red loss trail, the green fill, the numbers
	F.Hp = make("Frame", { Name = "Hp", BackgroundColor3 = COLORS.Track, BorderSizePixel = 0 }, body)
	Theme.Corner(F.Hp, UDim.new(0, 7))
	Theme.Stroke(F.Hp, Theme.Colors.PanelInk or COLORS.Navy, 2, 0)
	F.HpLoss = make("Frame", { Name = "Loss", BackgroundColor3 = COLORS.Loss, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, F.Hp)
	Theme.Corner(F.HpLoss, UDim.new(0, 7))
	F.HpFill = make("Frame", { Name = "Fill", BackgroundColor3 = COLORS.HpGreen, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, F.Hp)
	Theme.Corner(F.HpFill, UDim.new(0, 7))
	make("UIGradient", { Name = "Shine", Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 200, 190)) }, F.HpFill)
	F.HpTag = label(F.Hp, "HP", "Heading", 16, { Name = "Tag", ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Left })
	F.HpText = label(F.Hp, "", "Heading", 16, { Name = "Text", ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Right })
	-- ENERGY (the special meter)
	F.Energy = make("Frame", { Name = "Energy", BackgroundColor3 = COLORS.Track, BorderSizePixel = 0 }, body)
	Theme.Corner(F.Energy, UDim.new(0, 5))
	Theme.Stroke(F.Energy, Theme.Colors.PanelInk or COLORS.Navy, 2, 0)
	F.EnergyFill = make("Frame", { Name = "Fill", BackgroundColor3 = COLORS.Energy, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, F.Energy)
	Theme.Corner(F.EnergyFill, UDim.new(0, 5))
	F.EnergyText = label(body, "ENERGY 0/100", "Label", 15, { Name = "EnergyText", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.EnergyText })
	F.Lives = make("Frame", { Name = "Lives", BackgroundTransparency = 1 }, body)
	F.Hearts = {}
	for i = 1, 3 do
		F.Hearts[i] = heart(F.Lives, i)
	end
	Hud.F = F
	-- the helpers: a portrait each (round pet picture in a ViewportFrame, the buff cooldown ring around it, Lv,
	-- the buff name, the SWAP chip, the key hint); tap = buff, hold 0.5 s = swap
	Hud.helperHolder = make("Frame", { Name = "Helpers", BackgroundTransparency = 1 }, team)
	for i = 1, 2 do
		Hud.helpers[i] = Hud.BuildHelper(i)
	end
end

function Hud.BuildHelper(i)
	local H = { index = i }
	local cell = make("Frame", { Name = "Helper" .. i, BackgroundTransparency = 1 }, Hud.helperHolder)
	H.Cell = cell
	H.Disc = make("Frame", { Name = "Disc", BackgroundTransparency = 1 }, cell)
	H.Ring = newPie(H.Disc, "Ring", K.RING, COLORS.Ally, 2)
	local face = make("TextButton", {
		Name = "Portrait",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.PanelTop or COLORS.Navy,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		ZIndex = 4,
	}, H.Disc)
	Theme.Corner(face, UDim.new(0.5, 0))
	H.FaceStroke = Theme.Stroke(face, COLORS.Ally, 3, 0)
	H.Face = face
	H.View = make("ViewportFrame", {
		Name = "View",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 5,
		Ambient = Color3.fromRGB(200, 205, 220),
		LightColor = Color3.fromRGB(255, 250, 235),
	}, face)
	H.Initial = label(face, "", "Display", 26, { Name = "Initial", Size = UDim2.fromScale(1, 1), ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Center })
	H.KO = label(face, "KO", "Title", 22, { Name = "KO", Size = UDim2.fromScale(1, 1), ZIndex = 7, Visible = false, TextColor3 = COLORS.White, BackgroundTransparency = 0.35, BackgroundColor3 = Color3.fromRGB(40, 44, 60) })
	Theme.Corner(H.KO, UDim.new(0.5, 0))
	H.Count = label(face, "", "Display", 24, { Name = "Count", Size = UDim2.fromScale(1, 1), ZIndex = 7, Visible = false, TextXAlignment = Enum.TextXAlignment.Center })
	H.Level = smallPill(cell, "Lv 1", COLORS.LevelPill, { Name = "Level", AutomaticSize = Enum.AutomaticSize.None, ZIndex = 8 })
	H.Level.TextSize = 16
	H.Buff = label(cell, "", "Heading", 15, { Name = "Buff", TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	H.Swap = make("TextButton", { Name = "Swap", Text = GLYPH.Swap .. " SWAP", AutoButtonColor = true, BackgroundColor3 = Color3.fromRGB(40, 60, 120), BorderSizePixel = 0, ZIndex = 6 }, cell)
	Theme.Style(H.Swap, "Button", { Size = 15, Stroke = 0.2, Outline = 1.5 })
	Theme.Corner(H.Swap, UDim.new(0, 10))
	H.SwapStroke = Theme.Stroke(H.Swap, COLORS.SwapEdge, 2, 0)
	H.SwapFill = make("Frame", { Name = "HoldFill", BackgroundColor3 = COLORS.White, BackgroundTransparency = 0.7, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 7, Visible = false }, H.Swap)
	Theme.Corner(H.SwapFill, UDim.new(0, 10))
	H.Key = keyChip(cell, "1", { Name = "Key" })
	local index = i
	face.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			Input.HoldStart("portrait" .. index, index, os.clock())
		end
	end)
	face.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			Input.HoldEnd("portrait" .. index)
		end
	end)
	H.Swap.Activated:Connect(function()
		Input.Helper("Swap", index)
	end)
	return H
end

-- the round pet picture of a helper (PetBuilder Low in the ViewportFrame, built once per unit)
function Hud.Portrait(H, u)
	if H.unitId == u.id and H.built then
		return
	end
	H.unitId = u.id
	H.built = true
	for _, c in ipairs(H.View:GetChildren()) do
		c:Destroy()
	end
	setText(H.Initial, string.upper(string.sub(u.name or "?", 1, 1)))
	H.Initial.Visible = true
	if not PetBuilder then
		return
	end
	local ok = pcall(function()
		local def = Units.Def(u.info)
		if not def then
			return
		end
		local model = PetBuilder.Build(def, { Detail = "Low", Evolved = u.evo > 0 and u.evo or nil, Viewport = true })
		H.model = model
		local okBox, cf, size = pcall(model.GetBoundingBox, model)
		if not okBox or typeof(cf) ~= "CFrame" then
			cf, size = CFrame.new(), Vector3.new(3, 3, 3)
		end
		model.Parent = H.View
		local cam = make("Camera", { Name = "PortraitCamera", FieldOfView = 30 }, H.View)
		local r = max(size.X, size.Y, size.Z)
		local dist = r * 1.9 + 1
		local c = cf.Position + Vector3.new(0, size.Y * 0.08, 0)
		cam.CFrame = CFrame.new(c + Vector3.new(dist * 0.42, dist * 0.18, -dist * 0.9), c)
		H.View.CurrentCamera = cam
		H.Initial.Visible = false
	end)
	if not ok then
		H.Initial.Visible = true
	end
end

----------------------------------------------------------------------
-- the action cluster (bottom right): ATTACK (big), ELEMENT, SPECIAL, DASH; cooldown rings, key chips on desktop
----------------------------------------------------------------------
local ACTIONS = { "Attack", "Element", "Special", "Dash" }

function Hud.BuildActions()
	for _, kind in ipairs(ACTIONS) do
		local A = { kind = kind }
		local b = make("TextButton", {
			Name = kind .. "Button",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 2,
		}, Hud.cmd)
		A.Button = b
		A.Glow = make("Frame", { Name = "Glow", BackgroundColor3 = COLORS.Gold, BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 14, 1, 14), ZIndex = 1 }, b)
		Theme.Corner(A.Glow, UDim.new(0.5, 0))
		A.Ring = newPie(b, "Ring", 10, COLORS.Action[kind], 2)
		A.Ring.Root.Size = UDim2.new(1, 0, 1, 0)
		local face = make("Frame", { Name = "Face", BackgroundColor3 = Color3.fromRGB(255, 255, 255), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, -10, 1, -10), ZIndex = 3 }, b)
		Theme.Corner(face, UDim.new(0.5, 0))
		local base = COLORS.Action[kind]
		A.FaceGradient = make("UIGradient", { Name = "Fill", Rotation = 90, Color = ColorSequence.new(Theme.Darken(base, 0.35), Theme.Darken(base, 0.72)) }, face)
		A.FaceStroke = Theme.Stroke(face, Theme.Lighten(base, 0.25), 2.5, 0)
		A.Face = face
		A.Glyph = label(face, GLYPH[kind] or "", "Display", 30, { Name = "Glyph", Size = UDim2.fromScale(1, 1), ZIndex = 4, TextXAlignment = Enum.TextXAlignment.Center })
		A.Count = label(face, "", "Display", 26, { Name = "Count", Size = UDim2.fromScale(1, 1), ZIndex = 5, Visible = false, TextXAlignment = Enum.TextXAlignment.Center })
		A.Caption = label(b, string.upper(kind), "Heading", 15, { Name = "Caption", AnchorPoint = Vector2.new(0.5, 0), ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Center })
		A.Key = keyChip(b, Hud.KeyText(kind), { Name = "Key", AnchorPoint = Vector2.new(0.5, 0.5) })
		Hud.buttons[kind] = A
		local action = kind
		b.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
				Input.Press(action, true)
			end
		end)
		b.InputEnded:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
				Input.Press(action, false)
			end
		end)
	end
	Hud.attack = Hud.buttons.Attack.Button
	Hud.leave = Leave.Make(Hud.root, 20)
end

----------------------------------------------------------------------
-- the top card (top centre, under the Roblox bar): the mode line + timer; in raids / boss rooms the boss bar
----------------------------------------------------------------------
function Hud.BuildTop()
	local top = Hud.top
	local mode = neonCard(top, "ModeCard", "Blue", { Size = UDim2.fromOffset(K.TOP_W, K.MODE_H), Floor = false })
	Hud.modeCard = mode
	Hud.mode = label(mode.Body, "", "Heading", 20, { Name = "Mode", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	Hud.timer = label(mode.Body, "", "Display", 24, { Name = "Timer", TextXAlignment = Enum.TextXAlignment.Right })
	local boss = make("Frame", { Name = "BossBar", BackgroundTransparency = 1, Visible = false }, top)
	Hud.boss = boss
	Hud.bossName = label(boss, "", "Heading", 18, { Name = "BossName", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	Hud.bossTrack = make("Frame", { Name = "Hp", BackgroundColor3 = COLORS.Track, BorderSizePixel = 0 }, boss)
	Theme.Corner(Hud.bossTrack, UDim.new(0, 8))
	Theme.Stroke(Hud.bossTrack, Theme.Colors.PanelInk or COLORS.Navy, 2.5, 0)
	Hud.bossFill = make("Frame", { Name = "Fill", BackgroundColor3 = COLORS.Enemy, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, Hud.bossTrack)
	Theme.Corner(Hud.bossFill, UDim.new(0, 8))
	Hud.bossText = label(Hud.bossTrack, "", "Heading", 16, { Name = "Text", Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 1, 0), ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	Hud.pills = make("Frame", { Name = "Pills", BackgroundTransparency = 1 }, top)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, Hud.pills)
	Hud.bossElement = smallPill(Hud.pills, "", COLORS.Enemy, { Name = "Element", LayoutOrder = 1 })
	Hud.enragePill = smallPill(Hud.pills, "ENRAGED", COLORS.Enemy, { Name = "Enraged", LayoutOrder = 2, Visible = false })
	Hud.minionPill = smallPill(Hud.pills, "", Color3.fromRGB(150, 110, 220), { Name = "Minions", LayoutOrder = 3, Visible = false })
	Hud.playersPill = smallPill(Hud.pills, "", COLORS.Ally, { Name = "Players", LayoutOrder = 4, Visible = false })
	Hud.wavePill = smallPill(Hud.pills, "", Theme.Neon.Purple or COLORS.Ally, { Name = "Wave", LayoutOrder = 5, Visible = false })
	Ring.BuildInfo(top)
end

----------------------------------------------------------------------
-- the enemy list (right side): one row per living enemy, the LOCKED one first with a gold bracket + "TARGET"
----------------------------------------------------------------------
local function rowFor(i)
	local row = Hud.rows[i]
	if row then
		return row
	end
	row = {}
	local f = make("TextButton", { Name = "Row" .. i, Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.Colors.PanelTop or COLORS.Panel, BackgroundTransparency = 0.12, BorderSizePixel = 0 }, Hud.enemies)
	Theme.Corner(f, UDim.new(0, 12))
	row.Stroke = Theme.Stroke(f, Theme.Colors.PanelInk or COLORS.Navy, 2, 0)
	make("UIGradient", { Name = "Fill", Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 156, 186)) }, f)
	row.Frame = f
	row.Stripe = make("Frame", { Name = "Element", BorderSizePixel = 0, BackgroundColor3 = COLORS.Ally }, f)
	Theme.Corner(row.Stripe, UDim.new(0, 3))
	row.Icon = make("Frame", { Name = "Icon", BorderSizePixel = 0, BackgroundColor3 = COLORS.Enemy, ZIndex = 2 }, f)
	Theme.Corner(row.Icon, UDim.new(0.5, 0))
	row.IconStroke = Theme.Stroke(row.Icon, COLORS.White, 2, 0.2)
	row.IconText = label(row.Icon, "", "Display", 20, { Name = "Glyph", Size = UDim2.fromScale(1, 1), ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Center })
	row.Alert = label(row.Icon, "!", "Title", 24, { Name = "Alert", Size = UDim2.fromScale(1, 1), ZIndex = 4, Visible = false, TextColor3 = COLORS.Alert, BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(120, 30, 40) })
	Theme.Corner(row.Alert, UDim.new(0.5, 0))
	row.Name = label(f, "", "Body", 18, { Name = "PetName", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2 })
	row.Hp = thinBar(f, "Hp", 9, COLORS.Enemy, { ZIndex = 2 })
	row.Bracket = make("Frame", { Name = "Bracket", BackgroundTransparency = 1, Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4), Visible = false, ZIndex = 1 }, f)
	Theme.Corner(row.Bracket, UDim.new(0, 15))
	Theme.Stroke(row.Bracket, COLORS.Gold, 3, 0)
	row.Target = smallPill(f, "TARGET", COLORS.Gold, { Name = "Target", Visible = false, ZIndex = 5 })
	row.Target.TextColor3 = Theme.Colors.PanelInk or COLORS.Navy
	local index = i
	f.Activated:Connect(function()
		local id = row.unitId
		if id then
			local B = St.battle
			if B and B.lock == id and (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
				BattleController.Focus(nil) -- tap the locked row again: clear
			else
				BattleController.Focus(id)
			end
		end
		return index
	end)
	Hud.rows[i] = row
	return row
end

-- the enemies the list shows, the locked one first (the rest in id order: rows reorder only on a KO / lock change)
function Hud.EnemyList(B)
	local out, locked = {}, nil
	for _, u in ipairs(B.list) do
		if not u.ally and not u.isBoss and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED then
			if B.lock == u.id then
				locked = u
			else
				out[#out + 1] = u
			end
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	if locked then
		table.insert(out, 1, locked)
	end
	return out
end

-- lays the rows out (on Rebuild and when the set / the lock changed); returns the list's height
function Hud.LayoutEnemies(B, m)
	local list = Hud.EnemyList(B)
	Hud.enemyList = list
	local key = tostring(B.lock or 0)
	for _, u in ipairs(list) do
		key = key .. "," .. u.id
	end
	Hud.enemyKey = key
	local maxRows = m.Compact and K.ROWS_COMPACT or K.ROWS_MAX
	local n = min(#list, maxRows)
	local w, h = m.Compact and K.ROW_W_COMPACT or K.ROW_W, m.Compact and K.ROW_H_COMPACT or K.ROW_H
	local y = 0
	for i = 1, max(n, #Hud.rows) do
		local row = (i <= n) and rowFor(i) or Hud.rows[i]
		if row then
			row.Frame.Visible = i <= n
		end
		if i <= n then
			local u = list[i]
			local locked = B.lock == u.id
			row.unitId = u.id
			row.Frame.Size = UDim2.fromOffset(w, h)
			row.Frame.Position = UDim2.fromOffset(0, y)
			row.Stripe.Size = UDim2.fromOffset(5, h - 14)
			row.Stripe.Position = UDim2.fromOffset(6, 7)
			row.Stripe.BackgroundColor3 = elementColor(u.element)
			local icon = h - 10
			row.Icon.Size = UDim2.fromOffset(icon, icon)
			row.Icon.Position = UDim2.fromOffset(16, 5)
			row.Icon.BackgroundColor3 = elementColor(u.element):Lerp(COLORS.Navy, 0.25)
			local boss = u.kind == "MiniBoss" or u.info.boss ~= nil
			setText(row.IconText, boss and GLYPH.Crown or string.upper(string.sub(u.name, 1, 1)))
			row.IconText.TextSize = boss and (icon * 0.55) or (icon * 0.6)
			row.IconText:SetAttribute("BaseText", row.IconText.TextSize)
			local x = 16 + icon + 8
			row.Name.Position = UDim2.fromOffset(x, 3)
			row.Name.Size = UDim2.fromOffset(w - x - 10, h - 18)
			row.Name.TextSize = m.Compact and 16 or 18
			row.Name:SetAttribute("BaseText", row.Name.TextSize)
			setText(row.Name, (u.info.wild and not boss) and ("Wild " .. u.name) or u.name)
			row.Hp.Root.Position = UDim2.fromOffset(x, h - 15)
			row.Hp.Root.Size = UDim2.fromOffset(w - x - 10, 9)
			row.Bracket.Visible = locked
			-- "TARGET": a gold tab on the locked row's top edge (wide screens; a phone keeps the bracket only)
			row.Target.Visible = locked and not m.Compact
			row.Target.AnchorPoint = Vector2.new(1, 0.5)
			row.Target.Position = UDim2.new(1, -10, 0, -2)
			row.Target.Size = UDim2.fromOffset(78, 20)
			row.Target.AutomaticSize = Enum.AutomaticSize.None
			row.Target.TextSize = 15
			row.Stroke.Color = locked and COLORS.Gold or (boss and COLORS.Gold:Lerp(COLORS.Navy, 0.45) or (Theme.Colors.PanelInk or COLORS.Navy))
			row.hpKey = nil
			y = y + h + K.ROW_GAP
		end
	end
	local more = #list - n
	if not Hud.more then
		Hud.more = label(Hud.enemies, "", "Heading", 16, { Name = "More", TextXAlignment = Enum.TextXAlignment.Right })
	end
	Hud.more.Visible = more > 0
	if more > 0 then
		setText(Hud.more, "+" .. more .. " more")
		Hud.more.Position = UDim2.fromOffset(0, y)
		Hud.more.Size = UDim2.fromOffset(w, 22)
		y = y + 24
	end
	Hud.enemies.Size = UDim2.fromOffset(w, max(0, y - K.ROW_GAP))
	return y
end

----------------------------------------------------------------------
-- placement around the other GUIs (measured, not guessed)
----------------------------------------------------------------------
-- the bottom of the HUD's currency pills when they sit at the TOP (a landscape phone's top band / the top right),
-- in design px of our root (gui area below the top bar); 0 when they are elsewhere
function Hud.CurrencyTop(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local cur = hud and hud:FindFirstChild("Currency", true)
	if not cur or not cur:IsA("GuiObject") or not cur.Visible or cur.AbsoluteSize.X <= 0 then
		return 0, 0, 0
	end
	local p, s = cur.AbsolutePosition, cur.AbsoluteSize
	local f = max(0.05, m.F)
	if p.Y > m.VY * 0.3 then
		return 0, 0, 0 -- bottom left: not in our way at the top
	end
	return max(0, math.ceil((p.Y + s.Y) / f)), floor(p.X / f), math.ceil((p.X + s.X) / f)
end

-- the right edge (design px) of MenuController's tile column (NimbusMenu.MenuColumn; its frame keeps its place while
-- the tiles step aside), 0 when there is none
function Hud.MenuRight(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	local col = menu and menu:IsA("ScreenGui") and menu.Enabled and menu:FindFirstChild("MenuColumn", true)
	if not col or not col:IsA("GuiObject") or not col.Visible or col.AbsoluteSize.X <= 0 then
		return 0
	end
	local right = (col.AbsolutePosition.X + col.AbsoluteSize.X) / max(0.05, m.F)
	if right > m.W * 0.3 then
		return 0 -- not a left column
	end
	return math.ceil(right)
end

-- Roblox's touch jump button + MovementController's RUN button (screen px, from the left / BOTTOM edge)
function Hud.TouchRects(m)
	local small = min(m.VX, m.VY) <= 500
	local jump = small and 70 or 120
	local jb = small and 20 or jump * 0.75
	local rects = { jump = { m.VX - jump * 1.5 - 10, jb, m.VX - jump * 0.5 - 10, jb + jump } }
	local mc = Hud.Movement()
	if mc and type(mc.MobileLayout) == "function" then
		local ok, l = pcall(mc.MobileLayout)
		if ok and type(l) == "table" and type(l.run) == "table" then
			rects.run = l.run
		end
	end
	if not rects.run then
		local d = small and 66 or 84
		local right = max(14, jump + 10 - d * 0.5)
		local bottom = jb + jump + 10
		rects.run = { m.VX - right - d, bottom, m.VX - right, bottom + d }
	end
	return rects
end

-- the action buttons' centres + diameters (design px, Commands-local; Commands is anchored at its bottom-right
-- corner = the gui area's bottom-right corner) and the cluster's size. Touch phones: around Roblox's jump button and
-- the RUN button (MovementController puts RUN straight above the jump button in a battle), clear of the centre 40%.
function Hud.ClusterLayout(m)
	local big, small = K.ATTACK_D, K.ACTION_D
	local out = {}
	if not (m.Compact and m.Touch) then
		out.Attack = { -74, -98, big }
		out.Special = { -74 - big / 2 - 26 - small / 2, -90, small }
		out.Element = { -74, -98 - big / 2 - 36 - small / 2, small }
		out.Dash = { -74 - big / 2 - 26 - small / 2, -98 - big / 2 - 28 - small / 2, small }
		out.w, out.h = 236, 270
		return out
	end
	local f = max(0.05, m.F)
	local r = Hud.TouchRects(m)
	local gap = 7 * f
	local bigPx, smallPx = big * f, small * f
	local vx = m.VX
	-- screen px (x from the left, yb from the bottom) -> Commands-local design px
	local function at(cx, cyb, d)
		return { (cx - vx) / f, -cyb / f, d }
	end
	if m.VY >= m.VX then
		-- portrait: up the right edge above the RUN button: ATTACK, then [SPECIAL][ELEMENT], then DASH
		local right = vx - 10 * f
		local base = max(r.jump[4], r.run[4]) + gap + 2
		out.Attack = at(right - bigPx / 2 - 4 * f, base + bigPx / 2, big)
		local row2 = base + bigPx + gap
		out.Element = at(right - smallPx / 2, row2 + smallPx / 2, small)
		out.Special = at(right - smallPx - gap - smallPx / 2, row2 + smallPx / 2, small)
		local row3 = row2 + smallPx + gap
		out.Dash = at(right - smallPx / 2, row3 + smallPx / 2, small)
	else
		-- landscape: [SPECIAL][ATTACK] left of the jump button (the bottom strip), ELEMENT then DASH above ATTACK
		local left = r.jump[1] - gap
		local base = r.jump[2]
		out.Attack = at(left - bigPx / 2, base + bigPx / 2, big)
		out.Special = at(left - bigPx - gap - smallPx / 2, base + smallPx / 2, small)
		local row2 = base + bigPx + gap
		out.Element = at(left - bigPx / 2, row2 + smallPx / 2, small)
		out.Dash = at(left - bigPx / 2, row2 + smallPx + gap + smallPx / 2, small)
	end
	out.w, out.h = 10, 10
	return out
end

----------------------------------------------------------------------
-- (re)builds the HUD for the drawn battle and lays it out for the screen
----------------------------------------------------------------------
function Hud.Rebuild()
	local B = St.battle
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	Hud.m = m
	Hud.scale.Scale = m.F
	Hud.root.Size = UDim2.new(1 / m.F, 0, 1 / m.F, 0)
	if not B then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.enemies.Visible = false
		Hud.SetMenuHidden(false)
		Leave.Place(m, nil, false)
		return
	end
	local isFighting = B.Fighter and not B.ended
	-- between two ring rounds the top card and the fighter card stay (no flicker); the commands go
	local between = B.Fighter and B.ended and B.ringNext ~= nil
	local curBottom, curLeft, curRight = Hud.CurrencyTop(m)
	local topY = K.EDGE
	-- (a landscape phone's currency pills sit in the top band: stay below them where they reach down)
	local cardW = m.Compact and K.FC_W_COMPACT or K.FC_W
	Hud.fcW = nil
	if m.Compact and curBottom > 0 and curLeft >= K.EDGE + 208 and curLeft < K.EDGE + cardW + 8 then
		-- (a phone with the currency pills at the top right: a narrower fighter card fits beside them)
		Hud.fcW = curLeft - K.EDGE - 8
		cardW = Hud.fcW
	end
	local leftY = (curBottom > 0 and curLeft < K.EDGE + cardW + 8) and (curBottom + 6) or topY
	-- fighter card + helpers (top left) ----------------------------------------------------------
	Hud.team.Visible = isFighting or between
	local teamW, teamH = 0, 0
	if isFighting or between then
		teamW, teamH = Hud.LayoutFighter(B, m)
		-- a wide screen keeps the menu tiles (left centre): the fighter block starts right of their column
		local teamX = K.EDGE
		if not m.Compact then
			teamX = max(K.EDGE, Hud.MenuRight(m) + 10)
		end
		Hud.team.Position = UDim2.fromOffset(teamX, leftY)
		Hud.team.Size = UDim2.fromOffset(teamW, teamH)
		Hud.FillFighter(B)
	end
	Hud.teamPlace = (isFighting or between) and "TopLeft" or nil
	-- enemy list (right) -----------------------------------------------------------------------------
	local rightY = (curBottom > 0 and curRight > m.W * m.F - (K.ROW_W + 40) * m.F) and (curBottom + 6) or topY
	Hud.enemies.Visible = isFighting
	local listH = 0
	if isFighting then
		listH = Hud.LayoutEnemies(B, m)
		Hud.enemies.AnchorPoint = Vector2.new(1, 0)
		Hud.enemies.Position = UDim2.fromOffset(m.W - K.EDGE, rightY)
	end
	-- top card (mode line / boss bar) -------------------------------------------------------------
	Hud.LayoutTop(B, m, teamW, listH, rightY, isFighting or between)
	-- action cluster ---------------------------------------------------------------------------------
	Hud.cmd.Visible = isFighting
	if isFighting then
		local L = Hud.ClusterLayout(m)
		Hud.cmd.Size = UDim2.fromOffset(L.w, L.h)
		Hud.cmd.Position = UDim2.fromOffset(m.W, m.H)
		for _, kind in ipairs(ACTIONS) do
			local A = Hud.buttons[kind]
			local spec = L[kind]
			local d = spec[3]
			A.Button.Size = UDim2.fromOffset(d, d)
			A.Button.Position = UDim2.new(1, spec[1], 1, spec[2])
			A.Glyph.TextSize = floor(d * 0.4)
			A.Glyph:SetAttribute("BaseText", A.Glyph.TextSize)
			A.Count.TextSize = floor(d * 0.36)
			A.Count:SetAttribute("BaseText", A.Count.TextSize)
			A.Caption.Visible = not m.Touch
			A.Caption.Position = UDim2.new(0.5, 0, 1, 2)
			A.Caption.Size = UDim2.fromOffset(d + 24, 20)
			A.Caption.TextTruncate = Enum.TextTruncate.AtEnd
			A.Key.Visible = not m.Touch
			A.Key.Position = UDim2.new(0.15, 0, 0.15, 0)
		end
		Hud.Captions(B)
		Hud.Keys()
	end
	Hud.SetMenuHidden((isFighting or between) and m.Compact) -- a phone: the menu column steps aside (wide screens keep it)
	Leave.Place(m, B, isFighting)
	Ring.PlaceNext(B)
	Hud.FixText(Hud.root, m.F)
	Hud.last = {}
	Hud.enemyDirty = false
	Hud.Update(B, os.clock(), true)
end

-- the fighter card + helper cells (sizes + positions; Team-local); returns the Team block's size
function Hud.LayoutFighter(B, m)
	local F = Hud.F
	local compact = m.Compact
	local w = compact and (Hud.fcW or K.FC_W_COMPACT) or K.FC_W
	local pad = compact and 10 or 16
	local barW = w - 2 * pad
	local y = compact and 8 or 12
	local nameSize = compact and 20 or 26
	local nameH = compact and 26 or 32
	F.Name.TextSize = nameSize
	F.Name:SetAttribute("BaseText", nameSize)
	local minSize = math.ceil(K.MIN_TEXT_PX / max(0.05, m.F))
	local lvSize = max(compact and 15 or 17, minSize)
	local lvW = floor(textWidth("Lv 100", lvSize) * 0.9) + 14
	local badge = compact and 22 or 26
	local starsW = (B.fighterEvo or 0) > 0 and (compact and 30 or 38) or 0
	local nameW = barW - lvW - badge - starsW - 16
	F.Name.Position = UDim2.fromOffset(pad, y)
	F.Name.Size = UDim2.fromOffset(nameW, nameH)
	F.Level.Size = UDim2.fromOffset(lvW, compact and 22 or 26)
	F.Level.Position = UDim2.fromOffset(pad + nameW + 6, y + (nameH - (compact and 22 or 26)) / 2)
	F.Level.TextSize = lvSize
	F.Level:SetAttribute("BaseText", lvSize)
	F.Element.Size = UDim2.fromOffset(badge, badge)
	F.Element.Position = UDim2.fromOffset(pad + nameW + 6 + lvW + 5, y + (nameH - badge) / 2)
	F.ElementGlyph.TextSize = floor(badge * 0.6)
	F.ElementGlyph:SetAttribute("BaseText", F.ElementGlyph.TextSize)
	F.Stars.Position = UDim2.fromOffset(pad + nameW + 6 + lvW + 5 + badge + 4, y)
	F.Stars.Size = UDim2.fromOffset(starsW, nameH)
	F.Stars.Visible = starsW > 0
	y = y + nameH + (compact and 4 or 6)
	local hpH = compact and 18 or 22
	F.Hp.Position = UDim2.fromOffset(pad, y)
	F.Hp.Size = UDim2.fromOffset(barW, hpH)
	local hpText = compact and 14 or 16
	F.HpTag.TextSize = hpText
	F.HpText.TextSize = hpText
	F.HpTag:SetAttribute("BaseText", hpText)
	F.HpText:SetAttribute("BaseText", hpText)
	F.HpTag.Position = UDim2.fromOffset(8, 0)
	F.HpTag.Size = UDim2.new(0, 40, 1, 0)
	F.HpText.Position = UDim2.fromOffset(40, 0)
	F.HpText.Size = UDim2.new(1, -48, 1, 0)
	y = y + hpH + (compact and 5 or 7)
	local enH = compact and 10 or 14
	F.Energy.Position = UDim2.fromOffset(pad, y)
	F.Energy.Size = UDim2.fromOffset(barW, enH)
	y = y + enH + 3
	local capH = compact and 18 or 22
	local hs = compact and 18 or 22
	-- the caption ends where the lives hearts (anchored right) begin; a narrow card (a phone with the currency
	-- pills top right) drops the "ENERGY" word, so "98/100" never runs under the hearts
	local capW = max(0, barW - (3 * hs + 4) - 6)
	local capSize = compact and 14 or 15
	F.EnergyText.Position = UDim2.fromOffset(pad, y)
	F.EnergyText.Size = UDim2.fromOffset(capW, capH)
	F.EnergyText.TextSize = capSize
	F.EnergyText.TextTruncate = Enum.TextTruncate.AtEnd
	F.EnergyText:SetAttribute("BaseText", capSize)
	Hud.energyShort = textWidth("ENERGY " .. METER_MAX .. "/" .. METER_MAX, max(capSize, minSize)) > capW
	F.Lives.AnchorPoint = Vector2.new(1, 0)
	F.Lives.Position = UDim2.fromOffset(pad + barW, y + (capH - hs) / 2)
	F.Lives.Size = UDim2.fromOffset(3 * hs + 4, hs)
	for i, h in ipairs(F.Hearts) do
		h.Size = UDim2.fromOffset(hs, hs)
		h.Position = UDim2.fromOffset((i - 1) * (hs + 2), 0)
		h.TextSize = hs - 2
		h:SetAttribute("BaseText", hs - 2)
	end
	y = y + capH + (compact and 6 or 10)
	local cardH = y
	Hud.fighterCard.Root.Size = UDim2.fromOffset(w, cardH)
	Hud.fighterCard.Root.Position = UDim2.fromOffset(0, 0)
	-- helpers: side by side under the card (wide) / a column (compact)
	local disc = compact and K.PORTRAIT_COMPACT or K.PORTRAIT
	local ringD = disc + (compact and 8 or 10)
	local cellW = compact and K.HELPER_W_COMPACT or K.HELPER_W
	if compact then
		cellW = max(ringD + 70, min(cellW, floor(m.W * 0.3) - K.EDGE)) -- (a phone: the column ends before the centre 40%)
	end
	Hud.helperCellW = cellW
	local cellH = compact and max(ringD + 4, 56) or (ringD + 70)
	local hy = cardH + (compact and 8 or 10)
	Hud.helperHolder.Position = UDim2.fromOffset(0, hy)
	local shown = 0
	for i, H in ipairs(Hud.helpers) do
		local cell = H.Cell
		cell.Size = UDim2.fromOffset(cellW, cellH)
		if compact then
			-- [portrait] [buff name / SWAP chip]: a narrow column (clear of the vitals card on a landscape phone)
			cell.Position = UDim2.fromOffset(0, (i - 1) * (cellH + 6))
			H.Disc.Position = UDim2.fromOffset(0, 2)
			H.Disc.Size = UDim2.fromOffset(ringD, ringD)
			H.Level.Position = UDim2.fromOffset(ringD / 2 - 24, ringD - 14)
			H.Level.Size = UDim2.fromOffset(48, 18)
			H.Buff.Font = Theme.Fonts.Label
			H.Buff.Position = UDim2.fromOffset(ringD + 6, 0)
			H.Buff.Size = UDim2.fromOffset(cellW - ringD - 6, 22)
			H.Buff.TextXAlignment = Enum.TextXAlignment.Left
			H.Swap.Position = UDim2.fromOffset(ringD + 6, 24)
			H.Swap.Size = UDim2.fromOffset(cellW - ringD - 6, 30)
			H.Key.Position = UDim2.fromOffset(-4, -2)
		else
			cell.Position = UDim2.fromOffset((i - 1) * (cellW + 12), 0)
			H.Disc.Position = UDim2.fromOffset((cellW - ringD) / 2, 0)
			H.Disc.Size = UDim2.fromOffset(ringD, ringD)
			H.Level.Position = UDim2.fromOffset(cellW / 2 - 28, ringD - 12)
			H.Level.Size = UDim2.fromOffset(56, 20)
			H.Buff.Font = Theme.Fonts.Heading
			H.Buff.Position = UDim2.fromOffset(0, ringD + 12)
			H.Buff.Size = UDim2.fromOffset(cellW, 20)
			H.Buff.TextXAlignment = Enum.TextXAlignment.Center
			H.Swap.Position = UDim2.fromOffset((cellW - 104) / 2, ringD + 36)
			H.Swap.Size = UDim2.fromOffset(104, 28)
			H.Key.Position = UDim2.fromOffset((cellW - ringD) / 2 - 6, -4)
		end
		H.Ring.Root.Size = UDim2.fromOffset(ringD, ringD)
		H.Face.Size = UDim2.fromOffset(disc, disc)
		H.Initial.TextSize = floor(disc * 0.45)
		H.Initial:SetAttribute("BaseText", H.Initial.TextSize)
		H.Count.TextSize = floor(disc * 0.42)
		H.Count:SetAttribute("BaseText", H.Count.TextSize)
		H.Key.Visible = not m.Touch
		if cell.Visible then
			shown = shown + 1
		end
	end
	local helpersH = compact and (2 * cellH + 6) or cellH
	Hud.helperHolder.Size = UDim2.fromOffset(compact and cellW or (2 * cellW + 12), helpersH)
	return max(w, compact and cellW or (2 * cellW + 12)), hy + helpersH
end

-- the fighter card's static texts (name, level, element, stars) and the helper cells' pets (on Start / Swap)
function Hud.FillFighter(B)
	local F = Hud.F
	local f = B.fighterId and B.units[B.fighterId]
	if f then
		setText(F.Name, f.name)
		setText(F.Level, "Lv " .. tostring(floor(f.level)))
		F.Element.BackgroundColor3 = elementColor(f.element)
		setText(F.ElementGlyph, ELEMENT_GLYPH[f.element] or "")
		setText(F.Stars, string.rep(GLYPH.Star, clamp(f.evo or 0, 0, 2)))
		if Hud.fighterCard.SetColor then
			pcall(Hud.fighterCard.SetColor, elementColor(f.element):Lerp(Theme.Neon.Green or COLORS.Mine, 0.55))
		end
	end
	local bench = Hud.Bench(B)
	for i, H in ipairs(Hud.helpers) do
		local u = bench[i]
		H.unit = u
		H.Cell.Visible = u ~= nil
		if u then
			H.slot = u.slot
			setText(H.Level, "Lv " .. tostring(floor(u.level)))
			local buff = type(u.info.buff) == "table" and u.info.buff or nil
			H.buffName = buff and string.upper(tostring(buff.Name or buff.Kind or "BUFF")) or "BUFF"
			setText(H.Buff, H.buffName)
			local c = elementColor(u.element)
			H.FaceStroke.Color = c
			setPie(H.Ring, H.Ring.frac >= 0 and H.Ring.frac or 1, c)
			Hud.Portrait(H, u)
		end
		H.stateKey = nil
	end
end

-- my two helpers (benched units, by slot), as the portraits show them
function Hud.Bench(B)
	local out = {}
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u and u.id ~= B.fighterId then
			out[#out + 1] = u
		end
	end
	return out
end

-- the action captions: ATTACK picks the enemy the pet attacks (it attacks by itself), the element attack's name
function Hud.Captions(B)
	local f = B.fighterId and B.units[B.fighterId]
	local ea = f and type(f.info.elementAttack) == "table" and f.info.elementAttack or nil
	local caps = {
		Attack = "PICK TARGET",
		Element = ea and string.upper(tostring(ea.Name)) or "ELEMENT",
		Special = "SPECIAL",
		Dash = "DASH",
	}
	for kind, A in pairs(Hud.buttons) do
		setText(A.Caption, caps[kind] or kind)
		if kind == "Element" and f then
			setText(A.Glyph, ELEMENT_GLYPH[f.element] or GLYPH.Special)
			local c = elementColor(f.element)
			A.FaceGradient.Color = ColorSequence.new(Theme.Darken(c, 0.3), Theme.Darken(c, 0.7))
			A.FaceStroke.Color = Theme.Lighten(c, 0.25)
			setPie(A.Ring, A.Ring.frac >= 0 and A.Ring.frac or 1, c)
		end
	end
end

-- the top card: the mode line + timer (+ the boss bar in raids / boss rooms, the ring pills); returns nothing
function Hud.LayoutTop(B, m, teamW, listH, rightY, show)
	local top = Hud.top
	local spectator = not B.Fighter
	top.Visible = show or spectator
	if not top.Visible then
		return
	end
	local bossUnit = Hud.BossUnit(B)
	local w = m.Compact and K.TOP_W_COMPACT or K.TOP_W
	local x, y, anchor = m.W / 2, K.EDGE, 0.5
	local underList, leftTop = false, false
	local curBottom, curLeft, curRight = Hud.CurrencyTop(m)
	if m.Compact then
		-- between the fighter card and the enemy list when there is room, else under the enemy list (right)
		local free = m.W - (K.EDGE + teamW + 12) - (K.ROW_W_COMPACT + K.EDGE + 12)
		if free >= w then
			x = K.EDGE + teamW + 12 + free / 2
			if m.Landscape and Leave.Allowed(B) and free >= w + 8 + K.LEAVE_W_TOP then
				x = K.EDGE + teamW + 12 + (free - 8 - K.LEAVE_W_TOP) / 2 -- room for LEAVE on its right
			end
		elseif spectator then
			w = min(w, m.W - 2 * K.EDGE)
		else
			-- a tall phone: under the enemy list at the right edge, clear of the helper column on the left
			w = min(w, m.W - K.EDGE - K.HELPER_W_COMPACT - 24)
			x, anchor = m.W - K.EDGE, 1
			y = rightY + listH + 10
			underList = listH > 0
			local guess = K.MODE_H + 6 + (bossUnit and 32 or 0) + ((B.Mode == "Ring") and 30 or 0)
			if underList and not m.Landscape and Hud.team.Visible and Hud.fighterCard and y + guess > m.H * 0.3 - 4 then
				-- (the right column starts low - currency pills up there - and would reach the centre band: the top
				-- card goes under the fighter card instead, the helper column moves down under it)
				leftTop = true
				w = min(w, m.W - K.EDGE - K.ROW_W_COMPACT - 8 - K.EDGE)
				x, anchor = Hud.team.Position.X.Offset, 0
				y = Hud.team.Position.Y.Offset + Hud.fighterCard.Root.Size.Y.Offset + 8
				underList = false
			end
			if listH <= 0 and Hud.team.Visible and Hud.fighterCard then
				-- (between two ring rounds the enemy list is gone: stay under the fighter card, beside the helpers)
				y = max(y, Hud.team.Position.Y.Offset + Hud.fighterCard.Root.Size.Y.Offset + 8)
			end
		end
	end
	-- (a landscape phone's currency pills in the top band: stay under them where they overlap)
	if curBottom > 0 and anchor == 0.5 and curRight > x - w / 2 and curLeft < x + w / 2 then
		y = max(y, curBottom + 4)
	end
	top.AnchorPoint = Vector2.new(anchor, 0)
	top.Position = UDim2.fromOffset(x, y)
	local modeText, modeColor = Hud.ModeText(B)
	Hud.modeColor = modeColor
	if Hud.modeCard.SetColor then
		pcall(Hud.modeCard.SetColor, modeColor)
	end
	local mh = K.MODE_H
	Hud.modeCard.Root.Size = UDim2.fromOffset(w, mh)
	Hud.mode.Position = UDim2.fromOffset(14, 0)
	Hud.mode.Size = UDim2.fromOffset(w - 14 - 76, mh)
	Hud.mode.TextColor3 = COLORS.White
	Hud.timer.Position = UDim2.new(1, -78, 0, 0)
	Hud.timer.Size = UDim2.fromOffset(66, mh)
	local yy = mh + 6
	local compact = m.Compact
	Hud.boss.Visible = bossUnit ~= nil
	-- (a phone keeps the top card short: the boss's name goes into its bar, only the wave / ENRAGED pills stay)
	Hud.pills.Visible = not compact and (bossUnit ~= nil or B.Mode == "Dungeon")
	Hud.compactTop = compact
	local nameH = compact and 0 or 24
	if bossUnit then
		Hud.boss.Position = UDim2.fromOffset(0, yy)
		Hud.boss.Size = UDim2.fromOffset(w, nameH + 28)
		Hud.bossName.Visible = not compact
		Hud.bossName.Position = UDim2.fromOffset(4, 0)
		Hud.bossName.Size = UDim2.fromOffset(w - 8, 22)
		Hud.bossTrack.Position = UDim2.fromOffset(0, nameH)
		Hud.bossTrack.Size = UDim2.fromOffset(w, 26)
		Hud.bossFill.BackgroundColor3 = elementColor(bossUnit.element):Lerp(COLORS.Enemy, 0.5)
		setText(Hud.bossName, (bossUnit.kind == "MiniBoss" and (GLYPH.Crown .. " ") or "") .. bossUnit.name)
		setText(Hud.bossElement, tostring(bossUnit.element or "?"))
		Hud.bossElement.BackgroundColor3 = elementColor(bossUnit.element)
		yy = yy + nameH + 32
	end
	if Hud.pills.Visible then
		Hud.pills.Position = UDim2.fromOffset(0, yy)
		Hud.pills.Size = UDim2.fromOffset(w, 24)
		Hud.bossElement.Visible = bossUnit ~= nil and not compact
		yy = yy + 28
	end
	yy = Ring.LayoutInfo(B, w, yy)
	top.Size = UDim2.fromOffset(w, yy)
	if leftTop then
		local fcH = Hud.fighterCard.Root.Size.Y.Offset
		Hud.helperHolder.Position = UDim2.fromOffset(0, fcH + 8 + yy + 8)
	end
	if underList and y + yy > m.H * 0.3 - 4 then
		-- (a tall phone whose right column starts low: the top card first, the enemy list under it, both above
		-- the centre band)
		y = rightY
		top.Position = UDim2.fromOffset(x, y)
		Hud.enemies.Position = UDim2.fromOffset(m.W - K.EDGE, y + yy + 8)
	end
	Hud.topH = yy
	Hud.topRect = { x - anchor * w, y, x - anchor * w + w, y + yy }
end

-- the boss the top card shows: the raid boss, else a dungeon / wave mini-boss that is still up
function Hud.BossUnit(B)
	if B.boss then
		return B.boss
	end
	for _, u in ipairs(B.list) do
		if not u.ally and u.kind == "MiniBoss" and u.hp > 0 and u.state ~= S_DOWN then
			return u
		end
	end
	return nil
end

function Hud.Keys()
	for kind, A in pairs(Hud.buttons or {}) do
		local t = A.Key and A.Key:FindFirstChild("Text")
		if t then
			setText(t, Hud.KeyText(kind))
		end
	end
	for i, H in ipairs(Hud.helpers or {}) do
		local t = H.Key and H.Key:FindFirstChild("Text")
		if t then
			setText(t, Hud.KeyText("Buff", i))
		end
	end
end

-- seconds left of a cooldown (B.cd[kind], or the buff of helper slot), clamped >= 0
local function cdLeft(B, kind, slot, now)
	local cd = B.cd
	local readyAt = (kind == "Buff") and (cd.Buff[slot] or 0) or (cd[kind] or 0)
	return max(0, readyAt - now)
end

local function cdLen(B, kind, slot)
	local cd = B.cdLen
	if kind == "Buff" then
		return max(0.1, cd.Buff[slot] or 15)
	end
	return max(0.1, cd[kind] or 1)
end

-- per-frame HUD values: bars / texts only when they change, rings at 10 Hz
function Hud.Update(B, now, force)
	if not Hud.gui or not B then
		return
	end
	local last = Hud.last or {}
	Hud.last = last
	local modeText = Hud.ModeText(B)
	if last.mode ~= modeText then
		last.mode = modeText
		Hud.mode.Text = modeText
	end
	local left = B.TimeLimit > 0 and (B.TimeLimit - B.renderT) or 0
	local timerText = B.TimeLimit > 0 and fmtTime(left) or ""
	if last.timer ~= timerText then
		last.timer = timerText
		Hud.timer.Text = timerText
		Hud.timer.TextColor3 = (left < 15 and B.TimeLimit > 0) and COLORS.Enemy:Lerp(COLORS.White, 0.25) or COLORS.White
	end
	local bossUnit = Hud.boss.Visible and Hud.BossUnit(B) or nil
	if bossUnit then
		if force or last.bossHp ~= bossUnit.hp or last.bossMax ~= bossUnit.maxHp then
			last.bossHp, last.bossMax = bossUnit.hp, bossUnit.maxHp
			Hud.bossFill.Size = UDim2.fromScale(max(0.002, clamp(bossUnit.hp / bossUnit.maxHp, 0, 1)), 1)
			local fb = Hud.compactTop and 1000 or nil
			local numbers = Theme.ShortNumber(clamp(bossUnit.hp, 0, bossUnit.maxHp), fb) .. " / " .. Theme.ShortNumber(bossUnit.maxHp, fb)
			Hud.bossText.Text = Hud.compactTop and (bossUnit.name .. "  " .. Theme.ShortNumber(clamp(bossUnit.hp, 0, bossUnit.maxHp), fb)) or numbers
		end
	end
	if Hud.pills.Visible then
		if last.enraged ~= B.enraged then
			last.enraged = B.enraged
			Hud.enragePill.Visible = B.enraged == true
		end
		local minions, players = 0, {}
		for _, u in ipairs(B.list) do
			if u.kind == "Minion" and u.hp > 0 and u.state ~= S_DOWN then
				minions = minions + 1
			elseif u.side == 1 and u.owner ~= nil and u.kind ~= "Minion" then
				players[u.owner] = true
			end
		end
		local pc = 0
		for _ in pairs(players) do
			pc = pc + 1
		end
		if last.minions ~= minions then
			last.minions = minions
			Hud.minionPill.Visible = minions > 0 and not Hud.compactTop
			Hud.minionPill.Text = "Minions x" .. minions
		end
		local showPlayers = (B.Mode == "Raid" or (B.Mode == "Dungeon" and pc > 1)) and not Hud.compactTop
		if last.players ~= pc then
			last.players = pc
			Hud.playersPill.Visible = showPlayers and pc > 0
			Hud.playersPill.Text = pc == 1 and "1 player" or (pc .. " players")
		end
		local d = B.Dungeon
		local waveText = ""
		if d and num(d.Waves, 0) > 0 then
			waveText = "Wave " .. clamp(max(num(d.Wave, 1), B.wave or 0), 1, num(d.Waves, 1)) .. "/" .. num(d.Waves, 1)
		end
		if last.wave ~= waveText then
			last.wave = waveText
			Hud.wavePill.Visible = waveText ~= ""
			Hud.wavePill.Text = waveText
		end
	end
	if not B.Fighter then
		return
	end
	-- the fighter card ----------------------------------------------------------------------------------
	local F = Hud.F
	local f = B.fighterId and B.units[B.fighterId]
	if f and Hud.team.Visible then
		local hp = max(0, f.hp)
		local frac = clamp(hp / f.maxHp, 0, 1)
		if force or last.hp ~= hp or last.maxHp ~= f.maxHp or last.fid ~= f.id then
			local prev = (last.fid == f.id) and last.hpFrac or nil
			last.hp, last.maxHp, last.fid, last.hpFrac = hp, f.maxHp, f.id, frac
			F.HpFill.Size = UDim2.fromScale(max(frac, 0.001), 1)
			F.HpFill.Visible = frac > 0.002
			F.HpText.Text = Theme.ShortNumber(floor(hp + 0.5)) .. " / " .. Theme.ShortNumber(floor(f.maxHp + 0.5))
			Hud.hpWrites = (Hud.hpWrites or 0) + 1
			-- the red loss trail drains 0.4 s behind a loss; a heal moves it at once
			if Hud.lossTween then
				pcall(Hud.lossTween.Cancel, Hud.lossTween)
				Hud.lossTween = nil
			end
			if prev and frac < prev then
				Hud.lossFrom = prev
				local okT, tween = pcall(Util.Tween, F.HpLoss, K.LOSS_TIME, { Size = UDim2.fromScale(max(frac, 0.001), 1) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				Hud.lossTween = okT and tween or nil
				if not okT then
					F.HpLoss.Size = UDim2.fromScale(max(frac, 0.001), 1)
				end
			else
				F.HpLoss.Size = UDim2.fromScale(max(frac, 0.001), 1)
			end
		end
		local meter = clamp(floor(f.meter + 0.5), 0, METER_MAX)
		if force or last.meter ~= meter then
			last.meter = meter
			F.EnergyFill.Size = UDim2.fromScale(meter / METER_MAX, 1)
			F.EnergyFill.BackgroundColor3 = (meter >= METER_MAX) and COLORS.Gold or COLORS.Energy
			F.EnergyText.Text = (Hud.energyShort and "" or "ENERGY ") .. meter .. "/" .. METER_MAX
			F.EnergyText.TextColor3 = (meter >= METER_MAX) and COLORS.Gold or COLORS.EnergyText
		end
	end
	local lives = B.lives or 3
	if force or last.lives ~= lives then
		last.lives = lives
		for i, h in ipairs(F.Hearts) do
			h.TextColor3 = (i <= lives) and COLORS.Life or COLORS.LifeLost
			h.TextTransparency = (i <= lives) and 0 or 0.25
		end
	end
	if B.ended then
		return
	end
	-- rows of the enemy list: HP fills on change, the wind-up "!" while an enemy winds up -----------------
	if Hud.enemyDirty then
		Hud.enemyDirty = false
		local list = Hud.EnemyList(B)
		local key = tostring(B.lock or 0)
		for _, u in ipairs(list) do
			key = key .. "," .. u.id
		end
		if key ~= Hud.enemyKey and Hud.m then
			Hud.LayoutEnemies(B, Hud.m)
			Hud.FixText(Hud.enemies, Hud.m.F)
		end
	end
	for i, u in ipairs(Hud.enemyList or {}) do
		local row = Hud.rows[i]
		if row and row.Frame.Visible and row.unitId == u.id then
			setThin(row.Hp, clamp(u.hp / u.maxHp, 0, 1))
			setVisible(row.Alert, u.windupUntil ~= nil and now < u.windupUntil)
		end
	end
	-- 10 Hz: the rings, the countdowns, the helper states -------------------------------------------------
	if not force and now - (Hud.ringAt or 0) < K.RING_DT then
		return
	end
	Hud.ringAt = now
	Input.CheckPending(B, now)
	for kind, A in pairs(Hud.buttons) do
		local frac, color, countText = 1, COLORS.Action[kind], ""
		if kind == "Element" or kind == "Dash" then
			local leftS = cdLeft(B, kind, nil, now)
			frac = 1 - leftS / cdLen(B, kind)
			if leftS > 0.05 then
				countText = tostring(math.ceil(leftS - 0.05))
			end
			if kind == "Element" and f then
				color = elementColor(f.element)
			end
		elseif kind == "Special" then
			frac = f and clamp(f.meter / METER_MAX, 0, 1) or 0
			color = frac >= 1 and COLORS.Gold or COLORS.Action.Special
		end
		setPie(A.Ring, frac, color)
		setText(A.Count, countText)
		setVisible(A.Count, countText ~= "")
		local ready = frac >= 1
		A.Glyph.TextTransparency = (countText ~= "") and 0.7 or 0
		local cue = (kind == "Dash" and B.cue == "Dash") or (kind == "Special" and ready and f ~= nil and f.special ~= nil)
		local glow = cue and (0.45 + 0.35 * (0.5 + 0.5 * sin(now * 8))) or 1
		if abs(A.Glow.BackgroundTransparency - glow) > 0.02 then
			A.Glow.BackgroundTransparency = glow
			A.Glow.BackgroundColor3 = (kind == "Dash") and COLORS.Dodge or COLORS.Gold
		end
		setDisabled(A.Button, kind == "Special" and not ready)
	end
	local swapLeft = cdLeft(B, "Swap", nil, now)
	for i, H in ipairs(Hud.helpers) do
		local u = H.unit
		if u and H.Cell.Visible then
			local down = u.hp <= 0 or u.state == S_DOWN
			local leftS = cdLeft(B, "Buff", u.slot, now)
			setPie(H.Ring, down and 0 or (1 - leftS / cdLen(B, "Buff", u.slot)), down and COLORS.Weak or elementColor(u.element))
			local countText = (not down and leftS > 0.05) and tostring(math.ceil(leftS - 0.05)) or ""
			setText(H.Count, countText)
			setVisible(H.Count, countText ~= "")
			local stateKey = (down and "d" or "a") .. ((swapLeft > 0.05) and "s" or "")
			if H.stateKey ~= stateKey then
				H.stateKey = stateKey
				setVisible(H.KO, down)
				H.View.ImageTransparency = down and 0.6 or 0
				H.View.ImageColor3 = down and Color3.fromRGB(120, 124, 140) or Color3.fromRGB(255, 255, 255)
				H.Buff.TextColor3 = down and COLORS.Weak or COLORS.White
				setDisabled(H.Swap, down or swapLeft > 0.05)
				H.Swap.BackgroundColor3 = (down or swapLeft > 0.05) and Color3.fromRGB(60, 66, 92) or Color3.fromRGB(40, 70, 150)
				H.Swap.TextTransparency = (down or swapLeft > 0.05) and 0.45 or 0
			end
			local hold = Input.HoldFrac(i, now)
			setVisible(H.SwapFill, hold > 0)
			if hold > 0 then
				H.SwapFill.Size = UDim2.fromScale(hold, 1)
			end
			if swapLeft > 0.05 and not down then
				setText(H.Swap, GLYPH.Swap .. " " .. math.ceil(swapLeft - 0.05))
			else
				setText(H.Swap, GLYPH.Swap .. " SWAP")
			end
		end
		H.index = i
	end
end

function Hud.ModeText(B)
	local text, color
	if B.Mode == "Raid" then
		text, color = "BOSS RAID", COLORS.Enemy
	elseif B.Mode == "Dungeon" then
		local d = B.Dungeon or {}
		local compact = Hud.m and Hud.m.Compact
		text, color = "DUNGEON - Floor " .. tostring(num(d.Floor, 1)) .. " - Room " .. tostring(num(d.Room, 1)), Theme.Neon.Purple or COLORS.Ally
		if compact then
			-- (a phone's line is short: the room + the wave; DungeonController's side card shows the floor)
			local waves = num(d.Waves, 0)
			if waves > 1 then
				text = "Room " .. tostring(num(d.Room, 1)) .. " - Wave " .. clamp(max(num(d.Wave, 1), B.wave or 0), 1, waves) .. "/" .. waves
			else
				text = "Floor " .. tostring(num(d.Floor, 1)) .. " - Room " .. tostring(num(d.Room, 1))
			end
		end
		if d.Boss == true and num(d.Room, 0) >= 3 then
			text = text .. " (BOSS)"
		end
	elseif B.Mode == "Ring" then
		text, color = Ring.TitleText(B), Ring.GOLD
	else
		text, color = "DUEL", COLORS.Ally
		if B.Fighter then
			text = "DUEL - vs " .. Hud.SideName(B, B.Side == 1 and 2 or 1)
		end
	end
	if B.Spectator then
		text = "WATCHING - " .. ((B.Mode == "Duel") and (Hud.SideName(B, 1) .. " vs " .. Hud.SideName(B, 2)) or text)
	end
	return text, color
end

function Hud.SideName(B, side)
	local names = {}
	for _, owner in ipairs((B.sides and B.sides[side]) or {}) do
		local n = B.Names[tostring(owner)]
		if n then
			names[#names + 1] = n
		end
	end
	if #names > 0 then
		return table.concat(names, ", ")
	end
	if B.Mode == "Ring" and side == 2 then
		return "The Champion"
	end
	return side == 1 and "Blue side" or "Red side"
end

function Hud.TitleText(B)
	return (Hud.ModeText(B))
end

-- a short "not yet" wiggle (rotation only, so the layout is never disturbed)
function Hud.Shake(obj)
	if not obj or not obj.Parent then
		return
	end
	Hud.shakes = (Hud.shakes or 0) + 1
	obj:SetAttribute("Shakes", (obj:GetAttribute("Shakes") or 0) + 1)
	pcall(function()
		obj.Rotation = 7
		Util.Tween(obj, 0.06, { Rotation = -7 })
		task.delay(0.06, function()
			Util.Tween(obj, 0.1, { Rotation = 0 })
		end)
	end)
end

-- the button of an action (shakes on a refusal)
function Hud.ButtonOf(action, slot)
	if action == "Buff" or action == "Swap" then
		for _, H in ipairs(Hud.helpers or {}) do
			if H.unit and H.unit.slot == slot then
				return action == "Swap" and H.Swap or H.Face
			end
		end
		return nil
	end
	local A = Hud.buttons and Hud.buttons[action]
	return A and A.Button or nil
end

----------------------------------------------------------------------
-- the result card (bottom right; compact: top right; never centred)
----------------------------------------------------------------------
function Hud.ShowResult(B, payload)
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	local res = Hud.result
	local body = res:FindFirstChild("Body") or res
	for _, c in ipairs(body:GetChildren()) do
		if c:GetAttribute("ResultPart") then
			c:Destroy()
		end
	end
	local outcome = payload.Outcome
	if outcome == nil then
		outcome = payload.Won and "Win" or "Loss"
	end
	local raid = B.Mode == "Raid"
	local titleText, color = "DEFEAT", COLORS.Enemy
	if outcome == "Win" then
		titleText, color = raid and "BOSS DEFEATED!" or "VICTORY!", COLORS.Gold
	elseif outcome == "Draw" then
		titleText, color = "DRAW", COLORS.Ally
	elseif outcome == "Left" then
		titleText, color = "YOU LEFT", COLORS.Weak
	elseif raid then
		titleText = "THE BOSS WON"
	end
	local reasons = {
		BossDown = "The boss is down!",
		Wipe = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		KO = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		Timeout = "Time is up.",
		Forfeit = (outcome == "Win") and "Your opponent gave up." or "You gave up.",
		Left = "You left the battle.",
		Abandoned = "Everyone left.",
		Ended = "The raid has ended.",
		Error = "The battle was cancelled. No rewards were lost.",
		Void = "Both players left: this duel does not count.",
		Shutdown = raid and "The server is restarting: your damage so far still counts." or "The server is restarting: this battle does not count.",
		Cleared = "Room cleared!",
	}
	local sub = reasons[tostring(payload.Reason)] or ""
	if B.Mode == "Ring" then
		titleText, color, sub = Ring.ResultTitle(B, payload, sub)
	elseif B.Mode == "Dungeon" and outcome ~= "Win" then
		titleText, color = "KNOCKED OUT", Theme.Neon.Purple or COLORS.Enemy
	end
	local card = Hud.resultCard
	if card and card.SetColor then
		pcall(card.SetColor, color)
	end
	local w = m.Compact and min(K.RESULT_W, m.W - 16) or K.RESULT_W
	if m.Compact and m.Landscape then
		w = max(300, min(w, floor(m.W * 0.36)))
	end
	local y = K.PAD + 4
	local function part(inst)
		inst:SetAttribute("ResultPart", true)
		return inst
	end
	local short = m.Compact and m.Landscape
	-- (a short landscape screen: the OK button shares the title's line, long titles step down a size)
	local titleW = w - 2 * K.PAD - 8 - (short and 100 or 0)
	local titleSize = short and (#titleText > 9 and 25 or 30) or 34
	local title = part(label(body, titleText, "Title", titleSize, { Name = "Title", Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(titleW, 40), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color, TextTruncate = Enum.TextTruncate.AtEnd }))
	title.TextStrokeColor3 = COLORS.Ink
	y = y + 42
	local plain = { Wipe = true, KO = true, Cleared = true, BossDown = true }
	local floorLine = false
	if short and plain[tostring(payload.Reason)] then
		sub = "" -- (the title says it; a short screen keeps the card clear of the buttons under it)
		if B.Mode == "Dungeon" then
			local ex, dg = type(payload.Rewards) == "table" and type(payload.Rewards.Extra) == "table" and payload.Rewards.Extra or {}, B.Dungeon or {}
			sub = "Floor " .. tostring(num(ex.Floor, num(dg.Floor, 1))) .. " - Room " .. tostring(num(ex.Room, num(dg.Room, 1)))
			floorLine = true -- (a full-width line instead of a truncated pill)
		end
	elseif short and B.Mode == "Ring" then
		sub = (sub:gsub("^Champion Ring: (%l)", string.upper)) -- "You left after round 8": one line
	end
	if sub ~= "" then
		part(label(body, sub, "Body", 18, { Name = "Reason", Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(w - 2 * K.PAD - 8, 24), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextColor3 = COLORS.Muted }))
		y = y + 28
	end
	local list = part(make("Frame", { Name = "Rewards", BackgroundTransparency = 1, Position = UDim2.fromOffset(K.PAD, y), Size = UDim2.fromOffset(w - 2 * K.PAD, 10) }, body))
	local cols = 2
	local cellW = floor((w - 2 * K.PAD - 8) / cols)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(cellW, 30), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local lines = (B.Mode == "Ring") and Ring.ResultLines(B, rw) or Hud.RewardLines(B, rw)
	-- Phase 5: the lives left, the dungeon's lines
	if B.Fighter and B.Mode ~= "Ring" then
		local lives = B.lives or 0
		lines[#lines + 1] = { "Lives left: " .. lives, lives > 0 and COLORS.Life or COLORS.Weak }
	end
	if B.Mode == "Dungeon" then
		-- End.Rewards.Extra first, Start.Dungeon for what it leaves out
		local extra = type(rw.Extra) == "table" and rw.Extra or {}
		local dg = B.Dungeon or {}
		if not floorLine then
			lines[#lines + 1] = { "Floor " .. tostring(num(extra.Floor, num(dg.Floor, 1))) .. " - Room " .. tostring(num(extra.Room, num(dg.Room, 1))), Theme.Neon.Purple or COLORS.Ally }
		end
		local name = extra.Name or dg.Name
		if name then
			lines[#lines + 1] = { tostring(name), Theme.Neon.Purple or COLORS.Ally }
		end
	end
	for i, line in ipairs(lines) do
		local p = smallPill(list, line[1], line[2], { LayoutOrder = i, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromScale(1, 1) })
		p.TextSize = short and 14 or 16
		p.TextTruncate = Enum.TextTruncate.AtEnd
	end
	local rowsN = math.ceil(#lines / cols)
	list.Size = UDim2.fromOffset(w - 2 * K.PAD, max(0, rowsN * 36 - 6))
	y = y + rowsN * 36 + (rowsN > 0 and 4 or 0)
	local function okButton(size)
		local b
		if Mods.NeonKit and type(Mods.NeonKit.Button) == "function" then
			local okB, nb = pcall(Mods.NeonKit.Button, { Name = "OkButton", Text = "OK", Color = "Green", Size = size, TextSize = 22, Parent = body, Callback = function()
				Hud.HideResult()
			end })
			b = okB and nb or nil
		end
		if not b then
			b = make("TextButton", { Name = "OkButton", Text = "OK", Size = size, BackgroundColor3 = Theme.Buttons.Green, AutoButtonColor = true }, body)
			Theme.Style(b, "Button", { Size = 22 })
			Theme.Corner(b, UDim.new(0, 12))
			b.Activated:Connect(function()
				Hud.HideResult()
			end)
		end
		return part(b)
	end
	if short then
		local ok = okButton(UDim2.fromOffset(88, 44))
		ok.Position = UDim2.new(1, -K.PAD - 88, 0, K.PAD)
		Hud.resultTimer = thinBar(body, "Timer", 6, COLORS.Muted, { Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(w - 2 * K.PAD - 8, 6) })
		part(Hud.resultTimer.Root)
		y = y + 6 + K.PAD
	else
		local ok = okButton(UDim2.fromOffset(120, 46))
		ok.Position = UDim2.new(1, -K.PAD - 120, 0, y)
		Hud.resultTimer = thinBar(body, "Timer", 8, COLORS.Muted, { Position = UDim2.fromOffset(K.PAD + 4, y + 19), Size = UDim2.fromOffset(w - 2 * K.PAD - 140, 8) })
		part(Hud.resultTimer.Root)
		y = y + 46 + K.PAD
	end
	res.Size = UDim2.fromOffset(w, y)
	if m.Compact then
		-- a phone: top right, under the enemy list's place, never over the screen centre
		local curBottom = Hud.CurrencyTop(m)
		res.AnchorPoint = Vector2.new(1, 0)
		res.Position = UDim2.new(1, -8, 0, max(6, curBottom > 0 and (curBottom + 6) or 6))
	else
		res.AnchorPoint = Vector2.new(1, 1)
		res.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE)
	end
	res.Visible = true
	Hud.FixText(res, m.F)
	Ring.HideNext()
	Hud.top.Visible = false
	Hud.team.Visible = false
	Hud.cmd.Visible = false
	Hud.enemies.Visible = false
	Hud.teamPlace = nil
	Hud.SetMenuHidden(false)
	Leave.Place(m, nil, false)
	local keep = St.result and St.result.payload == payload and St.result.t0 -- a relayout (rotation) keeps the timer
	St.result = { t0 = keep or os.clock(), dur = K.RESULT_SECONDS, battle = B, payload = payload }
	Me.MouseHold("BattleResult", true) -- the cursor is free for the card's OK
	BattleController._wake()
end

function Hud.RewardLines(B, rw)
	local lines = {}
	local tokens = num(rw.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	local gems = num(rw.Gems, 0)
	if gems > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(gems) .. " Gems", Theme.Currency.Gems.Color }
	end
	local cash = num(rw.Cash, 0)
	if cash > 0 then
		lines[#lines + 1] = { "+$" .. Theme.ShortNumber(cash) .. " Cash", Theme.Currency.Cash and Theme.Currency.Cash.Color or COLORS.Mine }
	end
	if rw.Practice == true then
		lines[#lines + 1] = { "Practice duel: no rewards", COLORS.Weak }
	end
	local trophies = num(rw.Trophies, 0)
	if trophies ~= 0 or (B.Mode == "Duel" and rw.Practice ~= true and rw.Void ~= true) then
		lines[#lines + 1] = { (trophies >= 0 and "+" or "") .. tostring(trophies) .. " Trophies", trophies >= 0 and COLORS.Gold or COLORS.Enemy }
	end
	local xp = num(rw.Xp, 0)
	if xp > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(xp) .. " Pet XP", COLORS.Ally }
	end
	if rw.FirstClear == true then
		lines[#lines + 1] = { "First clear!", COLORS.Mine }
	end
	if rw.Tier == "None" then
		lines[#lines + 1] = { "No hits on the boss: no reward", COLORS.Weak }
	elseif rw.Tier then
		local share = num(rw.Share, 0)
		lines[#lines + 1] = { tostring(rw.Tier) .. " tier", COLORS.Gold }
		lines[#lines + 1] = { tostring(floor(share * 100 + 0.5)) .. "% of the damage", Color3.fromRGB(150, 110, 220) }
	end
	if rw.EventPet then
		local name = tostring(rw.EventPet)
		if PetCatalog and PetCatalog.Get then
			local ok, d = pcall(PetCatalog.Get, rw.EventPet)
			if ok and type(d) == "table" and d.Name then
				name = d.Name
			end
		end
		lines[#lines + 1] = { "New pet: " .. name, Color3.fromRGB(236, 110, 170) }
	end
	local ups = num(rw.LevelUps, 0)
	if ups > 0 then
		lines[#lines + 1] = { ups == 1 and "1 level up!" or (ups .. " level ups!"), COLORS.Mine }
	end
	if rw.Double == true then
		lines[#lines + 1] = { "Double rewards", COLORS.Gold }
	end
	return lines
end

function Hud.HideResult()
	St.result = nil
	Me.MouseHold("BattleResult", false)
	if Hud.result then
		Hud.result.Visible = false
	end
	if not St.battle then
		Hud.SetVisible(false)
	end
end

function Hud.UpdateResult(now)
	local r = St.result
	if not r then
		return
	end
	local p = (now - r.t0) / r.dur
	if p >= 1 then
		Hud.HideResult()
		return
	end
	if Hud.resultTimer then
		setThin(Hud.resultTimer, 1 - p)
	end
end

function Hud.SetVisible(on)
	if not Hud.gui then
		return
	end
	if not on then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.enemies.Visible = false
		Hud.teamPlace = nil
		Hud.SetMenuHidden(false)
		if Hud.leave then
			Hud.leave.Visible = false
		end
	end
end

-- the menu column (MenuController) steps aside while the battle HUD holds the left edge
function Hud.SetMenuHidden(on)
	on = on == true
	if (Hud.menuHidden == true) == on then
		return
	end
	local module = script.Parent:FindFirstChild("MenuController")
	local ok, menu = pcall(function()
		return module and require(module)
	end)
	if ok and type(menu) == "table" and type(menu.SetColumnHidden) == "function" and pcall(menu.SetColumnHidden, on) then
		Hud.menuHidden = on
	elseif not on then
		Hud.menuHidden = false
	end
end

-- MovementController (the battle dash keys, free dash, battle speed); nil when missing
function Hud.Movement()
	if Mods.Movement == nil then
		Mods.Movement = optional(script.Parent, "MovementController") or false
	end
	return Mods.Movement or nil
end

----------------------------------------------------------------------
-- LEAVE: stops a Champion Ring run (BattleCommand "Forfeit"; the server ends the run cleanly and the climber comes
-- back at the portal). Never in duels (a forfeit costs trophies), raids or the dungeon (DungeonController's LEAVE).
-- Two presses: the first turns it into "Sure? Tap again" for LEAVE_CONFIRM seconds, the second sends it. One button
-- beside the action cluster and one on the ring's next-round card; both share the confirm state.
----------------------------------------------------------------------
Leave.armedUntil = 0
Leave.sentUntil = 0
Leave.buttons = {}

function Leave.Allowed(B)
	return B ~= nil and B.Fighter == true and B.Mode == "Ring"
end

function Leave.Make(parent, textSize)
	local b = make("TextButton", { Name = "LeaveButton", Text = "LEAVE", AutoButtonColor = true, BackgroundColor3 = Theme.Buttons.Pink, BorderSizePixel = 0, Size = UDim2.fromOffset(K.LEAVE_W, K.LEAVE_H), Visible = false, ZIndex = 4 }, parent)
	Theme.Style(b, "Button", { Size = textSize, Stroke = 0.2, Outline = 2 })
	Theme.Corner(b, UDim.new(0, 12))
	Theme.Stroke(b, Theme.Colors.PanelInk or COLORS.Navy, 3, 0)
	b.TextWrapped = true
	b:SetAttribute("BaseText", textSize)
	b:SetAttribute("LeaveStyle", "Pink")
	b.Activated:Connect(function()
		Leave.Press()
	end)
	Leave.buttons[#Leave.buttons + 1] = b
	return b
end

function Leave.State(now)
	if now < Leave.sentUntil then
		return "Leaving...", "Gray"
	elseif now < Leave.armedUntil then
		return "Sure? Tap again", "Red"
	end
	return "LEAVE", "Pink"
end

function Leave.Paint()
	local text, style = Leave.State(os.clock())
	Me.MouseHold("BattleLeave", style ~= "Pink") -- "Sure? Tap again": the cursor is free for the second press
	local live = {}
	for _, b in ipairs(Leave.buttons) do
		if b.Parent then
			live[#live + 1] = b
			setText(b, text)
			if b:GetAttribute("LeaveStyle") ~= style then
				b:SetAttribute("LeaveStyle", style)
				b.BackgroundColor3 = Theme.Buttons[style] or COLORS.Ally
			end
		end
	end
	Leave.buttons = live
end

function Leave.Press()
	local now = os.clock()
	if now < Leave.sentUntil or not Leave.Allowed(St.battle) then
		return
	end
	if now < Leave.armedUntil then
		Leave.armedUntil = 0
		if BattleController.Command("Forfeit") then
			Leave.sentUntil = now + K.LEAVE_CONFIRM -- the run's End normally closes the HUD long before this
		end
	else
		Leave.armedUntil = now + K.LEAVE_CONFIRM
	end
	Leave.Paint()
	task.delay(K.LEAVE_CONFIRM + 0.05, Leave.Paint) -- back to LEAVE when nobody pressed again
end

-- a new battle (a ring round too) and the step from a fight to the next-round card start unarmed
function Leave.Track(B)
	local phase = B and B.ended and "next" or "fight"
	if Leave.battle ~= B or Leave.phase ~= phase then
		Leave.battle = B
		Leave.phase = phase
		Leave.armedUntil = 0
		Leave.sentUntil = 0
		Leave.Paint()
	end
end

-- the fight's LEAVE: wide = left of the action cluster at the bottom; compact = above the cluster, right edge
function Leave.Place(m, B, isFighting)
	local b = Hud.leave
	if not b then
		return
	end
	if B then
		Leave.Track(B)
	end
	b.Visible = B ~= nil and isFighting == true and Leave.Allowed(B)
	if not b.Visible then
		return
	end
	b.AnchorPoint = Vector2.new(1, 1)
	if not m.Compact then
		b.Size = UDim2.fromOffset(K.LEAVE_W, K.LEAVE_H)
		b.Position = UDim2.fromOffset(m.W - K.EDGE - 300, m.H - K.EDGE - 8)
	elseif m.Landscape and Hud.topRect and Hud.top.Visible and Hud.topRect[3] + 8 + K.LEAVE_W_TOP <= m.W - K.EDGE - K.ROW_W_COMPACT - 8 then
		-- a landscape phone: right of the mode card in the top strip (the cluster needs the right edge)
		b.AnchorPoint = Vector2.new(0, 0)
		b.Size = UDim2.fromOffset(K.LEAVE_W_TOP, K.MODE_H)
		b.Position = UDim2.fromOffset(Hud.topRect[3] + 8, Hud.topRect[2])
	else
		-- above the cluster's top row, at the right edge
		local L = Hud.ClusterLayout(m)
		local topY = 0
		for _, kind in ipairs(ACTIONS) do
			local s = L[kind]
			topY = min(topY, s[2] - s[3] / 2)
		end
		b.Size = UDim2.fromOffset(K.LEAVE_W_COMPACT, K.LEAVE_H_COMPACT)
		b.Position = UDim2.fromOffset(m.W - 8, m.H + topY - 10)
	end
	b.TextSize = 20
	Leave.Paint()
end

-- the next-round card's LEAVE: a row at the bottom of the card (returns the card's new height)
function Leave.PlaceOnCard(m, B, w, y, inline)
	local b = Hud.nextLeave
	if not b then
		return y
	end
	Leave.Track(B)
	b.Visible = Leave.Allowed(B)
	if not b.Visible then
		return y
	end
	Leave.Paint()
	if inline then
		-- beside the countdown (a landscape phone)
		b.Size = UDim2.fromOffset(92, 38)
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.new(1, -K.PAD - 4, 0, y)
		return y
	end
	b.Size = UDim2.fromOffset(min(w - 2 * K.PAD - 8, K.LEAVE_CARD_W), K.LEAVE_H_COMPACT)
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -K.PAD - 4, 0, y)
	return y + K.LEAVE_H_COMPACT + K.PAD
end

----------------------------------------------------------------------
-- Phase 4: unit cards (src/client/UI/PetCard.lua; ARCHITECTURE_V3.md "Phase 4 build contract" 3.9)
----------------------------------------------------------------------
-- the card above every pet unit: own pets "Unit" (level + HP + SPECIAL + XP), a teammate's "Ally" (level + HP),
-- enemies / NPCs "Enemy" (level + HP in red). The billboard keeps the Phase 3 name HpBar (its HP fill is
-- Plate.Hp.Fill). Fills are written only when the snapshot changed a value (Cards.Live), never per frame.
function Cards.ModeOf(u)
	if u.mine then
		return "Unit"
	elseif u.ally then
		return "Ally"
	end
	return "Enemy"
end

function Cards.Add(B, u, root)
	local h = (u.height or 3) / 2 + 0.9
	local ok, c = false, nil
	if Mods.PetCard and type(Mods.PetCard.New) == "function" then
		ok, c = pcall(Mods.PetCard.New, root, Cards.ModeOf(u), h, { Parent = u.model, Name = "HpBar" })
	end
	if not ok or type(c) ~= "table" then
		if Mods.PetCard then
			warnOnce("card", "PetCard.New failed: " .. tostring(c))
		end
		addBar(u, root, h) -- the Phase 3 bar (a build without PetCard)
		return
	end
	u.card = c
	u.cardWrites = 0
	u.cardHp, u.cardMeter, u.cardLives = nil, nil, -1
	Cards.Static(u)
	Cards.Live(u)
	if u.crowned then
		pcall(Ring.Tag, B, u, root, h)
	end
end

function Cards.Free(u)
	if u.card then
		pcall(u.card.Destroy, u.card)
		u.card = nil
	end
end

-- the XP curve (TycoonCatalog.XpToNext; nil past the cap) and the pet's cap (PetCatalog: 100 for every rarity)
function Cards.Need(level)
	local TC = Mods.Tycoon
	if TC and type(TC.XpToNext) == "function" then
		local ok, need = pcall(TC.XpToNext, level)
		need = ok and tonumber(need) or nil
		if need and need > 0 and need < math.huge then
			return need
		end
	end
	return nil
end

function Cards.Cap(u)
	if PetCatalog then
		if type(PetCatalog.LevelCap) == "function" then
			local ok, cap = pcall(PetCatalog.LevelCap, u.info and u.info.petId)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if type(PetCatalog.MaxPetLevel) == "function" then
			local ok, cap = pcall(PetCatalog.MaxPetLevel)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if tonumber(PetCatalog.MaxLevel) then
			return tonumber(PetCatalog.MaxLevel)
		end
	end
	return math.huge
end

-- XP bar: xp / xpNext; the server leaves xpNext out at the cap (a full bar); 0 when the XP is unknown
function Cards.XpFrac(u)
	if u.xp == nil then
		return 0
	end
	local need = u.xpNext
	if need == nil or need ~= need or need >= math.huge then
		return 1
	end
	return clamp(u.xp / max(1, need), 0, 1)
end

-- level, stars and XP (on Start, after the rewards, on a State change)
function Cards.Static(u)
	local c = u.card
	if not c then
		return
	end
	c:SetLevel(u.level, u.evo, false)
	if u.mine then
		c:SetXp(Cards.XpFrac(u))
	end
end

-- HP and SPECIAL from the latest snapshot values (called only when one of them changed)
function Cards.Live(u)
	local c = u.card
	if not c then
		return
	end
	if u.cardHp ~= u.hp then
		u.cardHp = u.hp
		c:SetHp(clamp(u.hp / u.maxHp, 0, 1))
		u.cardWrites = (u.cardWrites or 0) + 1
	end
	if u.cardMeter ~= u.meter then
		u.cardMeter = u.meter
		if u.mine then
			local frac = clamp(u.meter / METER_MAX, 0, 1)
			c:SetSpecial(frac, frac >= 1 and u.special ~= nil)
			u.cardWrites = (u.cardWrites or 0) + 1
		end
	end
	-- Phase 5: a player fighter's lives as pips (PetCard:SetLives); NPC units have none
	if u.cardLives ~= u.lives then
		u.cardLives = u.lives
		local player = u.owner ~= nil and St.battle ~= nil and St.battle.Names[tostring(u.owner)] ~= nil
		if type(c.SetLives) == "function" and player and not u.benched then
			pcall(c.SetLives, c, u.lives, max(3, u.lives or 0))
		elseif type(c.SetLives) == "function" then
			pcall(c.SetLives, c, nil)
		end
	end
end

-- a raid spectator who joins the fight: the card switches its mode with the side
function Cards.Restyle(u)
	if u.card then
		u.card:SetMode(Cards.ModeOf(u))
		u.cardHp, u.cardMeter = nil, nil
		Cards.Static(u)
		Cards.Live(u)
	end
end

-- display only: the fight's XP (End.Rewards.Xp per team pet) moves my cards' XP bars (levels roll over on the curve);
-- the next Start / the profile mirror bring the server's numbers
function Cards.AddXp(u, xp)
	if u.xp == nil or xp <= 0 then
		return
	end
	u.xp = u.xp + xp
	local cap, guard = Cards.Cap(u), 0
	while u.xpNext and u.xpNext < math.huge and u.xp >= u.xpNext and guard < 200 do
		u.xp = u.xp - u.xpNext
		u.level = u.level + 1
		guard = guard + 1
		u.xpNext = (u.level < cap) and Cards.Need(u.level) or nil
	end
	Cards.Static(u)
end

function Cards.AfterFight(B, payload)
	local rw = type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards or nil
	local xp = rw and num(rw.Xp, 0) or 0
	if xp <= 0 or not B.Fighter or payload.Spectator == true then
		return
	end
	for _, u in pairs(B.mine) do
		Cards.AddXp(u, xp)
	end
end

-- the profile mirror (State.PetLevel) only ever moves a card forward (a stale mirror never undoes the rewards)
function Cards.FromState(B)
	local S = Mods.State
	if not B or not B.Fighter or not S or type(S.PetLevel) ~= "function" then
		return
	end
	if type(S.IsLoaded) == "function" and not S.IsLoaded() then
		return
	end
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.xp ~= nil then
			local ok, lv, xp = pcall(S.PetLevel, key)
			lv, xp = ok and tonumber(lv) or nil, ok and tonumber(xp) or nil
			if lv and xp and (lv > u.level or (lv == u.level and xp > u.xp)) then
				u.level, u.xp = lv, xp
				u.xpNext = (lv < Cards.Cap(u)) and Cards.Need(lv) or nil
				Cards.Static(u)
			end
		end
	end
end

----------------------------------------------------------------------
-- Phase 4: the Champion Ring HUD (contract 3.8)
----------------------------------------------------------------------
Ring.GOLD = Color3.fromRGB(250, 190, 56) -- the ring's champion gold (ArenaBuilder's Ring.Color)
Ring.VIOLET = Color3.fromRGB(156, 96, 238)
Ring.INTERMISSION = tonumber(BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring.Intermission) or 3
Ring.LINGER = 15 -- seconds a won round's floor waits for the next Start (BattleService sends it after INTERMISSION)

function Ring.IsFinal(payload)
	return type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards.Final == true
end

-- a won round that the next one follows: End.Rewards.Next (never the run's final End)
function Ring.IsNext(B, payload)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or nil
	return B.Mode == "Ring" and rw ~= nil and rw.Next ~= nil and rw.Final ~= true
		and (payload.Won == true or payload.Outcome == "Win" or rw.Won == true)
end

function Ring.Money(n)
	return "$" .. Theme.ShortNumber(num(n, 0))
end

function Ring.TitleText(B)
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	if Hud.m and Hud.m.Compact then
		-- (a phone's mode line is short: the gold card says it is the ring)
		return best > 0 and ("Round " .. round .. " - Best " .. best) or ("Ring - Round " .. round)
	end
	if best > 0 then
		return "CHAMPION RING - Round " .. round .. " - Best " .. best
	end
	return "CHAMPION RING - Round " .. round
end

-- the champion is built wearing PetBuilder's voxel crown accessory (a copy of its definition, cached by look)
function Ring.Crowned(def)
	if type(def) ~= "table" or type(def.Look) ~= "table" then
		return def
	end
	local copy = {}
	for k, v in pairs(def) do
		copy[k] = v
	end
	local look = {}
	for k, v in pairs(def.Look) do
		look[k] = v
	end
	look.Accessory = "Crown"
	copy.Look = look
	return copy
end

-- the champion's name tag: a pixel billboard above its card (same anchor; the tag sits at the top of a taller,
-- transparent frame, so it keeps a fixed pixel gap above the card at any distance)
function Ring.Tag(B, u, root, h)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local name = tostring(champ.Name or u.name or "Champion")
	if not string.find(name, "^Champion") then
		name = "Champion " .. name
	end
	local px = Theme.ScaledSize(22, 16)
	local th = Theme.ScaledSize(32, 24)
	local gap = Theme.ScaledSize(8, 5)
	local cardH = (u.card and u.card.Gui and u.card.Gui.Size.Y.Offset) or th
	local w = floor(min(Theme.ScaledSize(300, 220), textWidth(name, px) + Theme.ScaledSize(30, 22)))
	local gui = make("BillboardGui", {
		Name = "ChampionTag",
		Adornee = root,
		Size = UDim2.fromOffset(w, cardH + 2 * (th + gap)),
		StudsOffset = Vector3.new(0, h, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
		ResetOnSpawn = false,
	})
	local plate = make("Frame", { Name = "Plate", BackgroundColor3 = COLORS.Navy, BackgroundTransparency = 0.08, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, th) }, gui)
	Theme.Corner(plate, UDim.new(0, 9))
	Theme.Stroke(plate, Ring.GOLD, 2, 0)
	local l = label(plate, name, "Heading", px, { Name = "Name", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Ring.GOLD })
	l.TextStrokeColor3 = COLORS.Ink
	gui.Parent = u.model
	u.tag = gui
end

-- "Win: +$X +Y XP" (BattleCatalog.RingRewards with the plot's IncomePerSecond, display only: the server pays)
function Ring.Income()
	local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex or "SpotIndex")
	if type(index) ~= "number" then
		return 0
	end
	local folder = Ring.plot
	if not (folder and folder.Parent and folder:GetAttribute("SpotIndex") == index) then
		local lobby = workspace:FindFirstChild("NimbusLobby")
		folder = lobby and lobby:FindFirstChild(string.format("Spot_%02d", index), true) or nil
		Ring.plot = folder
	end
	local value = folder and folder:GetAttribute("IncomePerSecond")
	return type(value) == "number" and value or 0
end

function Ring.Preview(B)
	if B.ringPreview then
		return B.ringPreview
	end
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	local cfg = BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring or {}
	local every = num(cfg.BossEvery, 10)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local p = { Round = round, Record = round > best, Boss = champ.Boss == true or (every > 0 and round % every == 0), Cash = 0, Xp = 0, Tokens = 0 }
	if BattleCatalog and type(BattleCatalog.RingRewards) == "function" then
		local ok, r = pcall(BattleCatalog.RingRewards, round, Ring.Income(), p.Record)
		if ok and type(r) == "table" then
			p.Cash, p.Xp, p.Tokens = num(r.Cash, 0), num(r.Xp, 0), num(r.Tokens, 0)
		end
	end
	B.ringPreview = p
	return p
end

-- the info row of the top card: ring (win pay, record, boss round)
function Ring.BuildInfo(top)
	local info = make("Frame", { Name = "RingInfo", BackgroundTransparency = 1, Visible = false }, top)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, info)
	Hud.info = info
	Hud.infoWin = smallPill(info, "", Theme.Currency.Cash.Color, { Name = "WinPay", LayoutOrder = 1 })
	Hud.infoRecord = smallPill(info, "RECORD x3", Ring.GOLD, { Name = "Record", LayoutOrder = 2, Visible = false })
	Hud.infoBoss = smallPill(info, "BOSS", Ring.VIOLET, { Name = "Boss", LayoutOrder = 3, Visible = false })
end

function Ring.LayoutInfo(B, topW, y)
	local info = Hud.info
	if not info then
		return y
	end
	local ring = B.Mode == "Ring" and B.Fighter
	if not ring then
		info.Visible = false
		return y
	end
	info.Visible = true
	Hud.infoWin.Visible = ring
	Hud.infoRecord.Visible = false
	Hud.infoBoss.Visible = false
	if ring then
		local p = Ring.Preview(B)
		-- (a compact top card drops the "Win:" so the pills fit its width)
		local compact = Hud.m and Hud.m.Compact
		setText(Hud.infoWin, (compact and "+" or "Win: +") .. Ring.Money(p.Cash) .. "  +" .. Theme.ShortNumber(p.Xp) .. " XP")
		Hud.infoRecord.Visible = p.Record and B.Round > 1
		Hud.infoBoss.Visible = p.Boss
	end
	info.Position = UDim2.fromOffset(K.PAD, y)
	info.Size = UDim2.fromOffset(topW - 2 * K.PAD, 26)
	return y + 30
end

-- the side card between two rounds: "Round 8 won!" / "+$319  +68 XP" / "Round 9 in 3" (never the screen centre:
-- where the commands were on a wide screen, under the team cards on a tall phone, at the right edge in landscape)
function Ring.EnsureNext()
	if Hud.next and Hud.next.Parent then
		return Hud.next
	end
	if not Hud.root then
		return nil
	end
	local f = neonCard(Hud.root, "NextRoundCard", Ring.GOLD, { Visible = false, Floor = false }).Root
	Hud.next = f
	Hud.nextTitle = label(f, "", "Title", 28, { Name = "Title", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ring.GOLD })
	Hud.nextTitle.TextStrokeColor3 = COLORS.Ink
	Hud.nextLine = label(f, "", "Heading", 21, { Name = "Pay", TextXAlignment = Enum.TextXAlignment.Left })
	Hud.nextExtra = label(f, "", "Label", 18, { Name = "Extra", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.Mine })
	Hud.nextCount = label(f, "", "Display", 24, { Name = "Countdown", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.White })
	Hud.nextBar = thinBar(f, "Timer", 8, Ring.GOLD)
	Hud.nextLeave = Leave.Make(f, 20) -- LEAVE between two rounds (BattleService takes "Forfeit" during the intermission)
	return f
end

function Ring.ShowNext(B, payload)
	local rw = payload.Rewards
	local round = num(rw.Round, B.Round)
	B.ringNext = {
		Round = round,
		Next = num(rw.Next, round + 1),
		Cash = num(rw.Cash, 0),
		Xp = num(rw.Xp, 0),
		Tokens = num(rw.Tokens, 0),
		Record = rw.Record == true,
		At = os.clock(),
		Seconds = Ring.INTERMISSION,
	}
	if rw.Record == true and B.Ring then
		B.Ring.Best = max(num(B.Ring.Best, 0), round)
	end
	St.next = B.ringNext
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	pcall(Hud.Rebuild) -- top card + team stay, the commands go, Ring.PlaceNext shows the side card
	BattleController._wake()
end

function Ring.PlaceNext(B)
	local nx = B and B.ringNext
	if not nx then
		if Hud.next then
			Hud.next.Visible = false
		end
		return
	end
	local f = Ring.EnsureNext()
	if not f then
		return
	end
	local m = Hud.m or Hud.Metrics()
	setText(Hud.nextTitle, "Round " .. nx.Round .. " won!")
	setText(Hud.nextLine, "+" .. Ring.Money(nx.Cash) .. "   +" .. Theme.ShortNumber(nx.Xp) .. " XP")
	local extra = {}
	if nx.Record then
		extra[#extra + 1] = "New record! Cash x3"
	end
	if nx.Tokens > 0 then
		extra[#extra + 1] = "+" .. Theme.ShortNumber(nx.Tokens) .. " Tokens"
	end
	Hud.nextExtra.Visible = #extra > 0
	setText(Hud.nextExtra, table.concat(extra, "  "))
	local w
	local portraitTop = nil
	if not m.Compact then
		-- where the action cluster was (bottom right)
		w = 380
		f.AnchorPoint = Vector2.new(1, 1)
		f.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE)
	else
		-- the right edge, under the currency pills / the top card when they reach there; never the screen centre
		w = m.Landscape and max(240, min(320, floor(m.W * 0.3) - 16)) or min(340, m.W - 24)
		local y0 = 6
		local cb = Hud.CurrencyTop(m)
		if cb > 0 then
			y0 = cb + 6
		end
		local tr = Hud.topRect
		if tr and Hud.top.Visible and tr[3] > m.W - w - 20 then
			-- a landscape phone: narrow the card to stay beside the top card (below it would reach the DASH button)
			local w2 = m.W - 8 - (tr[3] + 10)
			if m.Landscape and w2 >= 220 then
				w = w2
			else
				y0 = max(y0, tr[4] + 8)
			end
		end
		if m.Landscape then
			f.AnchorPoint = Vector2.new(1, 0)
			f.Position = UDim2.fromOffset(m.W - 8, y0)
		else
			-- a tall phone: under the top card at the right (clear of the fighter block), above the screen centre;
			-- else the lower right above the jump / RUN buttons (placed once the card's height is known)
			portraitTop = (tr and Hud.top.Visible) and (tr[4] + 8) or y0
			if Hud.team.Visible then
				local teamRight = Hud.team.Position.X.Offset + Hud.team.Size.X.Offset
				local teamBottom = Hud.team.Position.Y.Offset + Hud.team.Size.Y.Offset
				if Hud.fighterCard and portraitTop >= Hud.team.Position.Y.Offset + Hud.fighterCard.Root.Size.Y.Offset then
					teamRight = Hud.team.Position.X.Offset + (Hud.helperCellW or 0) -- (only the helper column reaches down here)
				end
				if teamBottom > portraitTop then
					w = min(w, m.W - 8 - teamRight - 8)
				end
			end
			if w < 240 then
				w = min(340, m.W - 24)
				portraitTop = nil
			end
		end
	end
	local inner = w - 2 * K.PAD - 8
	local y = K.PAD
	Hud.nextTitle.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextTitle.Size = UDim2.fromOffset(inner, 32)
	y = y + 34
	Hud.nextLine.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextLine.Size = UDim2.fromOffset(inner, 26)
	y = y + 28
	if #extra > 0 then
		Hud.nextExtra.Position = UDim2.fromOffset(K.PAD + 4, y)
		Hud.nextExtra.Size = UDim2.fromOffset(inner, 22)
		y = y + 26
	end
	-- a landscape phone: LEAVE shares the countdown's row (the card stays clear of the DASH / RUN buttons under it)
	local inline = m.Compact and m.Landscape and Leave.Allowed(B)
	local countW = inline and (inner - 92 - 6) or inner
	Hud.nextShort = countW < 150 -- ("Next in 3" when the row is short)
	Hud.nextCount.Position = UDim2.fromOffset(K.PAD + 4, y + (inline and 4 or 0))
	Hud.nextCount.Size = UDim2.fromOffset(countW, 30)
	local countY = y
	y = y + (inline and 42 or 32)
	Hud.nextBar.Root.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextBar.Root.Size = UDim2.fromOffset(inner, 8)
	y = y + 8 + K.PAD
	if inline then
		Leave.PlaceOnCard(m, B, w, countY, true)
	else
		y = Leave.PlaceOnCard(m, B, w, y)
	end
	f.Size = UDim2.fromOffset(w, y)
	if m.Compact and not m.Landscape then
		if portraitTop and portraitTop + y <= m.H * 0.5 - 4 then
			f.AnchorPoint = Vector2.new(1, 0)
			f.Position = UDim2.fromOffset(m.W - 8, portraitTop)
		else
			local r = Hud.TouchRects(m)
			local above = (max(r.jump[4], r.run[4]) + 12) / max(0.05, m.F)
			f.AnchorPoint = Vector2.new(1, 1)
			f.Position = UDim2.fromOffset(m.W - 8, m.H - above)
		end
	end
	f.Visible = true
	Hud.FixText(f, m.F)
	Ring.UpdateNext(os.clock())
end

-- the countdown (a text write only when the shown second changes)
function Ring.UpdateNext(now)
	local nx = St.next
	if not nx then
		return
	end
	local f = Hud.next
	if not f or not f.Visible or not St.battle or St.battle.ringNext ~= nx then
		Ring.HideNext()
		return
	end
	local left = nx.Seconds - (now - nx.At)
	local label = Hud.nextShort and "Next" or ("Round " .. nx.Next)
	local text = (left > 0.05) and (label .. " in " .. math.ceil(left - 0.05)) or (label .. "...")
	setText(Hud.nextCount, text)
	setThin(Hud.nextBar, clamp(left / max(0.1, nx.Seconds), 0, 1))
end

function Ring.HideNext()
	St.next = nil
	if Hud.next then
		Hud.next.Visible = false
	end
end

-- the run ended between two rounds (its final End names the last round's id): the result card replaces the side card
function Ring.FinalAfterWin(B, payload)
	B.ringNext = nil
	Ring.HideNext()
	B.linger = K.END_LINGER
	B.endAt = os.clock()
	Hud.ShowResult(B, payload)
end

-- my pets' models + cards out of a won round (to be handed to the next round's units of the same key)
function Ring.TakeModels(B)
	local out = {}
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.model and not u.failed and out[key] == nil then
			out[key] = { model = u.model, root = u.root, height = u.height, centerY = u.centerY, rigid = u.rigid, card = u.card, evo = u.evo, x = u.x, z = u.z, yaw = u.yaw }
			u.model, u.root, u.card = nil, nil, nil
			out[key].model.Parent = nil
		end
	end
	return out
end

function Ring.GiveModels(B, carry)
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		local c = type(key) == "string" and carry[key] or nil
		if c and c.evo == u.evo and not u.model then
			carry[key] = nil
			u.model, u.root, u.height, u.centerY, u.rigid, u.card = c.model, c.root, c.height, c.centerY, c.rigid, c.card
			u.x, u.z, u.yaw, u.seen = c.x, c.z, c.yaw, false
			u.folder = B.folder
			u.model.Name = "Unit_" .. tostring(u.id)
			u.model.Parent = B.folder
			u.cardWrites = 0
			u.cardHp, u.cardMeter = nil, nil
			u.carried = true
			if u.card then
				u.card:SetMode(Cards.ModeOf(u))
				Cards.Static(u)
				Cards.Live(u)
			end
		end
	end
	for _, c in pairs(carry) do
		if c.card then
			pcall(c.card.Destroy, c.card)
		end
		pcall(c.model.Destroy, c.model)
	end
end

-- the result card of a run: RUN OVER / NEW RECORD!, where it ended
function Ring.ResultTitle(B, payload, sub)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local run = type(rw.Run) == "table" and rw.Run or {}
	local round = num(run.Round, num(rw.Round, B.Round))
	local title = run.Record ~= nil and "NEW RECORD!" or "RUN OVER"
	local why
	if rw.Void == true then
		why = "server restart: round " .. round .. " does not count"
	elseif payload.Outcome == "Left" or payload.Reason == "Forfeit" or payload.Reason == "Left" then
		why = "you left after round " .. round
	elseif payload.Reason == "Timeout" then
		why = "time ran out in round " .. round
	else
		why = "the champion won round " .. round
	end
	return title, Ring.GOLD, "Champion Ring: " .. why
end

-- the run's lines: Rounds won, Cash, XP, Tokens, the record
function Ring.ResultLines(B, rw)
	local run = type(rw.Run) == "table" and rw.Run or nil
	if not run then
		return Hud.RewardLines(B, rw)
	end
	local lines = {}
	local wins = num(run.Wins, 0)
	lines[#lines + 1] = { "Rounds won: " .. wins, COLORS.Gold }
	lines[#lines + 1] = { "+" .. Ring.Money(run.Cash) .. " Cash", Theme.Currency.Cash.Color }
	lines[#lines + 1] = { "+" .. Theme.ShortNumber(num(run.Xp, 0)) .. " Pet XP", COLORS.Ally }
	local tokens = num(run.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	-- (level-ups are the server's toasts: the card stays short enough for a landscape phone)
	if run.Record ~= nil then
		lines[#lines + 1] = { "Best: round " .. tostring(run.Record) .. "!", COLORS.Mine }
	elseif num(run.Best, 0) > 0 then
		lines[#lines + 1] = { "Best: round " .. tostring(num(run.Best, 0)), COLORS.Weak }
	end
	return lines
end

----------------------------------------------------------------------
-- Input (contract 4.7 control map; bound through ContextActionService at High priority ONLY while fighting)
--   ATTACK  left click / F / X / the big round button: ONE "Attack" order per press (dungeon fixes decision 4): the
--           fighter attacks by itself (server auto-attack); "Attack"(id) = attack this one (a click on an enemy; with
--           the mouse locked the enemy under the screen centre), "Attack"() = the nearest / the next one
--   ELEMENT E / Y / its button (cooldown ring); E passes through while a ProximityPrompt is shown (exit, chest)
--   SPECIAL Q / RB / its button (lights gold at 100)
--   DASH    Shift / B / its button: the PET dashes ("Dash"; MovementController.SetPetDash: no character impulse, no
--           stamina); RUN moves to Ctrl in a battle
--   lock    Tab cycles (nearest first), click / tap an enemy or its row; T clears; RT cycles, LT clears
--   helpers 1 / 2 (LB / D-up) tap = its buff, hold 0.5 s = swap; the SWAP chip; D-left / D-right swap; the portrait
--           (tap = buff, hold = swap)
----------------------------------------------------------------------
local KEY_HELPER = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.ButtonL1] = 1,
	[Enum.KeyCode.DPadUp] = 2,
}
local KEY_SWAP = {
	[Enum.KeyCode.DPadLeft] = 1,
	[Enum.KeyCode.DPadRight] = 2,
}

local function sink()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Sink
	end)
	return ok and v or nil
end

local function pass()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Pass
	end)
	return ok and v or nil
end

local function fighting()
	local B = St.battle
	return B ~= nil and B.Fighter and not B.ended
end

-- the main menu is gone (UiGate.HasPlayed, 7.2); no UiGate module = always
function Input.GateOpen()
	local hook = BattleController.Hooks.Gate
	if type(hook) == "function" then
		return hook() ~= false
	end
	if Mods.UiGate == nil then
		Mods.UiGate = optional(Client, "UiGate") or false
	end
	local g = Mods.UiGate
	if g and type(g.HasPlayed) == "function" then
		local ok, played = pcall(g.HasPlayed)
		return (not ok) or played ~= false
	end
	return true
end

-- a ProximityPrompt shown to me that E would press (dungeon fixes 6: E stays the interaction key)
function Input.PromptShown()
	for prompt in pairs(St.prompts) do
		local ok, live = pcall(function()
			local code = prompt.KeyboardKeyCode
			return prompt.Parent ~= nil and prompt.Enabled ~= false and (code == nil or code == Enum.KeyCode.E)
		end)
		if ok and live then
			return true
		elseif not ok or prompt.Parent == nil then
			St.prompts[prompt] = nil
		end
	end
	return false
end

function Input.OnAction(name, state, input)
	if not fighting() or not Input.GateOpen() then
		return pass()
	end
	local began = state == Enum.UserInputState.Begin
	local key = input and input.KeyCode
	if name == K.ACTION_ELEMENT and key == Enum.KeyCode.E and Input.PromptShown() then
		return pass() -- the shown prompt (the room's exit, a chest) gets the E
	end
	local ended = state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel
	if name == K.ACTION_ATTACK then
		if began then
			Input.Press("Attack", true)
		end
	elseif name == K.ACTION_ELEMENT then
		if began then
			Input.Press("Element", true)
		end
	elseif name == K.ACTION_SPECIAL then
		if began then
			Input.Press("Special", true)
		end
	elseif name == K.ACTION_TARGET then
		if began then
			if key == Enum.KeyCode.T or key == Enum.KeyCode.ButtonL2 then
				BattleController.Focus(nil)
			else
				Input.CycleTarget()
			end
		end
	elseif name == K.ACTION_HELPER then
		local index = key and KEY_HELPER[key]
		local swapIndex = key and KEY_SWAP[key]
		if swapIndex then
			if began then
				Input.Helper("Swap", swapIndex)
			end
		elseif index then
			if began then
				Input.HoldStart("key" .. index, index, os.clock())
			elseif ended then
				Input.HoldEnd("key" .. index)
			end
		end
	end
	return sink()
end

function Input.Bind(on)
	if on == St.bound then
		return
	end
	St.bound = on
	if on then
		local priority = 2000
		pcall(function()
			priority = Enum.ContextActionPriority.High.Value
		end)
		pcall(function()
			ContextActionService:BindActionAtPriority(K.ACTION_ATTACK, Input.OnAction, false, priority, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
			ContextActionService:BindActionAtPriority(K.ACTION_ELEMENT, Input.OnAction, false, priority, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
			ContextActionService:BindActionAtPriority(K.ACTION_SPECIAL, Input.OnAction, false, priority, Enum.KeyCode.Q, Enum.KeyCode.ButtonR1)
			ContextActionService:BindActionAtPriority(K.ACTION_TARGET, Input.OnAction, false, priority, Enum.KeyCode.Tab, Enum.KeyCode.T, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
			ContextActionService:BindActionAtPriority(
				K.ACTION_HELPER, Input.OnAction, false, priority,
				Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.KeypadOne, Enum.KeyCode.KeypadTwo,
				Enum.KeyCode.ButtonL1, Enum.KeyCode.DPadUp, Enum.KeyCode.DPadLeft, Enum.KeyCode.DPadRight
			)
		end)
	else
		for _, name in ipairs({ K.ACTION_ATTACK, K.ACTION_ELEMENT, K.ACTION_SPECIAL, K.ACTION_TARGET, K.ACTION_HELPER }) do
			pcall(function()
				ContextActionService:UnbindAction(name)
			end)
		end
		St.holds = {}
	end
end

-- MovementController's battle switches (contract 3.9 / 4.4, dungeon fixes decision 5): Shift / B = the PET's dash
-- (SetPetDash: the keys only send "Dash", the character gets no impulse and spends no stamina; RUN moves to Ctrl),
-- the battle speeds. (An older MovementController without SetPetDash: the old character dash keys.)
function Input.Movement(B, on)
	local mc = Hud.Movement()
	if not mc then
		return
	end
	if on then
		if type(mc.SetPetDash) == "function" then
			pcall(mc.SetPetDash, Input.PetDash)
		else
			local F = BattleCatalog and BattleCatalog.Fighter or {}
			pcall(mc.SetDashKeys, { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonB })
			pcall(mc.SetFreeDash, true, num(F.DashCooldown, 2.5))
			if type(mc.SetDashListener) == "function" then
				pcall(mc.SetDashListener, Input.PetDash)
			end
		end
		local sp = B and B.speed
		if sp then
			pcall(mc.SetBattleSpeed, sp.Walk, sp.Run)
		end
		St.movementOn = true
	elseif St.movementOn then
		St.movementOn = false
		if type(mc.SetPetDash) == "function" then
			pcall(mc.SetPetDash, nil)
		else
			pcall(mc.SetDashKeys, nil)
			pcall(mc.SetFreeDash, false)
			if type(mc.SetDashListener) == "function" then
				pcall(mc.SetDashListener, nil)
			end
		end
		pcall(mc.SetBattleSpeed, nil)
	end
end

-- Shift / B in a battle (MovementController.SetPetDash calls it): the pet's dash
function Input.PetDash()
	if not fighting() or not Input.GateOpen() then
		return false
	end
	return BattleController.Command("Dash")
end

-- a button press of an action (keys, the round buttons): ONE command per press (ATTACK never repeats: the fighter
-- attacks by itself, ATTACK only tells it which enemy; arg = that enemy's id, nil = the nearest / the next one)
function Input.Press(kind, down, arg)
	if not down or not fighting() then
		return
	end
	if kind == "Attack" then
		BattleController.Command("Attack", arg)
		return
	end
	BattleController.Command(kind)
end

-- per frame: a helper key / portrait held 0.5 s swaps
function Input.Tick(B, now)
	if not B or not fighting() then
		return
	end
	for key, h in pairs(St.holds or {}) do
		if not h.fired and now - h.t >= K.SWAP_HOLD then
			h.fired = true
			Input.Helper("Swap", h.index)
		end
	end
end

function Input.HoldStart(key, index, t)
	if not fighting() or not Input.GateOpen() then
		return
	end
	St.holds = St.holds or {}
	St.holds[key] = { index = index, t = t, fired = false }
	BattleController._wake()
end

function Input.HoldEnd(key)
	local h = St.holds and St.holds[key]
	if not h then
		return
	end
	St.holds[key] = nil
	if not h.fired then
		Input.Helper("Buff", h.index)
	end
end

-- 0..1 of a running swap hold on helper `index` (the SWAP chip fills; nothing for a short tap)
function Input.HoldFrac(index, now)
	local best = 0
	for _, h in pairs(St.holds or {}) do
		if h.index == index and not h.fired then
			local p = (now - h.t - 0.1) / (K.SWAP_HOLD - 0.1)
			if p > best then
				best = min(1, p)
			end
		end
	end
	return best
end

-- "Buff" / "Swap" for the helper shown in portrait `index` (its team slot goes to the server)
function Input.Helper(action, index)
	local B = St.battle
	if not B or not fighting() then
		return false
	end
	local H = Hud.helpers and Hud.helpers[index]
	local u = H and H.unit
	if not u then
		local bench = Hud.Bench(B)
		u = bench[index]
	end
	if not u then
		return false
	end
	return BattleController.Command(action, u.slot)
end

-- Tab / RT: lock the next enemy, nearest to my fighter first
function Input.CycleTarget()
	local B = St.battle
	if not B then
		return
	end
	local f = B.fighterId and B.units[B.fighterId]
	local fx, fz = f and f.x or 0, f and f.z or 0
	local list = {}
	for _, u in ipairs(B.list) do
		if not u.ally and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED and not u.hidden and (u.model or u.isBoss) then
			local dx, dz = u.x - fx, u.z - fz
			list[#list + 1] = { u = u, d = dx * dx + dz * dz }
		end
	end
	if #list == 0 then
		return
	end
	table.sort(list, function(a, b)
		if a.d ~= b.d then
			return a.d < b.d
		end
		return a.u.id < b.u.id
	end)
	local pick = list[1].u
	for i, e in ipairs(list) do
		if e.u.id == B.lock then
			pick = list[(i % #list) + 1].u
			break
		end
	end
	BattleController.Focus(pick.id)
end

-- the enemy a tap / click at viewport pixel (x, y) picks (nearest projected enemy within reach), or nil
function BattleController.ScreenPick(x, y)
	local B = St.battle
	local cam = workspace.CurrentCamera
	if not B or not cam then
		return nil
	end
	local reach = K.TAP_REACH * Theme.ScreenFactor()
	local best, bestD = nil, math.huge
	for _, u in ipairs(B.list) do
		if not u.ally and u.model and not u.parked and not u.hidden and u.hp > 0 and u.state ~= S_DOWN then
			local ok, p, onScreen = pcall(cam.WorldToViewportPoint, cam, unitCenter(B, u))
			if ok and onScreen and p.Z > 0 then
				local dx, dy = p.X - x, p.Y - y
				local d = sqrt(dx * dx + dy * dy)
				local r = reach
				if u.isBoss then
					r = reach * 3
				elseif u.kind == "MiniBoss" then
					r = reach * 1.6
				end
				if d <= r and d < bestD then
					best, bestD = u.id, d
				end
			end
		end
	end
	return best
end

local function guiInset()
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	return inset
end

function Input.OnBegan(input, processed)
	local t = input.UserInputType
	if t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2 then
		if not St.gamepad then
			St.gamepad = true
			Hud.Keys()
		end
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if St.gamepad then
			St.gamepad = false
			Hud.Keys()
		end
	end
	if processed or not fighting() or not Input.GateOpen() then
		return
	end
	if t == Enum.UserInputType.Touch then
		St.tap = { x = input.Position.X, y = input.Position.Y, t = os.clock(), input = input }
	elseif t == Enum.UserInputType.MouseButton1 then
		-- one "Attack" order: the enemy under the cursor (the screen centre while MouseLock holds the cursor there),
		-- else the nearest / the next one
		local x, y = input.Position.X, input.Position.Y + guiInset()
		local cam = workspace.CurrentCamera
		if Input.MouseLocked() and cam then
			x, y = cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2
		end
		Input.Press("Attack", true, BattleController.ScreenPick(x, y))
	end
end

-- the cursor is locked at the screen centre (client/MouseLock's option: MouseBehavior LockCenter)
function Input.MouseLocked()
	local ok, locked = pcall(function()
		return UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
	end)
	return ok and locked == true
end

function Input.OnEnded(input)
	local t = input.UserInputType
	local tap = St.tap
	if not tap or t ~= Enum.UserInputType.Touch then
		return
	end
	St.tap = nil
	if not fighting() or os.clock() - tap.t > K.TAP_TIME then
		return
	end
	local dx, dy = input.Position.X - tap.x, input.Position.Y - tap.y
	if dx * dx + dy * dy > K.TAP_MOVE * K.TAP_MOVE then
		return
	end
	-- input positions are in GUI space (below the top bar); the camera projects into the full viewport
	local id = BattleController.ScreenPick(input.Position.X, input.Position.Y + guiInset())
	if id then
		BattleController.Focus(id)
	end
end

----------------------------------------------------------------------
-- Commands (BattleCommand(action, arg)); the server decides everything, the client predicts only the button's ring
----------------------------------------------------------------------
local VALID_ACTIONS = { Attack = true, Element = true, Special = true, Dash = true, Target = true, Buff = true, Swap = true, Forfeit = true }

local function commandRemote()
	if St.remoteCmd and St.remoteCmd.Parent then
		return St.remoteCmd
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild("BattleCommand")
	St.remoteCmd = r
	return r
end

-- the cooldown lengths of my team (BattleCatalog.Fighter; a helper's own Cooldown from its unit info)
function Input.CooldownLengths(B)
	local F = BattleCatalog and BattleCatalog.Fighter or {}
	B.cdLen = {
		Element = num(F.ElementCooldown, 7),
		Dash = num(F.DashCooldown, 2.5),
		Swap = num(F.SwapCooldown, 10),
		Buff = {},
	}
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u then
			local buff = type(u.info.buff) == "table" and u.info.buff or nil
			local default = (u.info.role == "Support") and num(F.SupportCooldown, 12) or num(F.HelperCooldown, 15)
			B.cdLen.Buff[slot] = num(buff and buff.Cooldown, default)
		end
	end
end

-- a local refusal: the button shakes, nothing is sent
local function refuse(action, slot)
	Hud.Shake(Hud.ButtonOf(action, slot))
	return false
end

function BattleController.Command(action, arg)
	local B = St.battle
	if not B or not B.Fighter then
		return false
	end
	-- a ring run can be left between two rounds too: the won round has ended, the next Start has not come yet
	if B.ended and not (action == "Forfeit" and B.Mode == "Ring" and B.ringNext ~= nil) then
		return false
	end
	if not VALID_ACTIONS[action] then
		return false
	end
	local key = action .. tostring(arg)
	local now = os.clock()
	local gap = (action == "Attack") and K.ATTACK_GAP or K.CMD_GAP
	if St.lastCmd[key] and now - St.lastCmd[key] < gap then
		return false
	end
	-- local checks: instant feedback, no pointless traffic (the server decides)
	local f = B.fighterId and B.units[B.fighterId]
	if action == "Element" or action == "Dash" or action == "Swap" then
		if cdLeft(B, action, nil, now) > K.CD_SLACK then
			return refuse(action)
		end
		if action == "Swap" then
			local u = B.mine[tonumber(arg) or 0]
			if not u or u.id == B.fighterId or u.hp <= 0 or u.state == S_DOWN then
				return refuse(action, tonumber(arg))
			end
		end
	elseif action == "Buff" then
		local slot = tonumber(arg) or 0
		local u = B.mine[slot]
		if not u or u.id == B.fighterId or u.hp <= 0 or u.state == S_DOWN or cdLeft(B, "Buff", slot, now) > K.CD_SLACK then
			return refuse(action, slot)
		end
	elseif action == "Special" then
		if not f or not f.special or f.meter < METER_MAX then
			return refuse(action)
		end
	elseif (action == "Attack" or action == "Target") and arg ~= nil then
		local u = B.units[arg]
		if not u or u.ally or u.hp <= 0 then
			return false
		end
	end
	St.lastCmd[key] = now
	local remote = commandRemote()
	if not remote then
		return false
	end
	local ok = pcall(function()
		if arg ~= nil then
			remote:FireServer(action, arg)
		else
			remote:FireServer(action)
		end
	end)
	if not ok then
		return false
	end
	St.sent = (St.sent or 0) + 1
	if action == "Forfeit" then
		return true -- the run's End does the rest
	end
	Input.Predict(B, action, arg, now)
	return true
end

-- lock-on: Target(id) (nil clears); the server echoes the lock (Order "Target")
function BattleController.Focus(unitId)
	local B = St.battle
	if not B or not B.Fighter or B.ended then
		return false
	end
	if unitId == nil and B.lock == nil then
		return false
	end
	return BattleController.Command("Target", unitId)
end

-- prediction: the button's own ring starts at once; the matching event (Element / Dash / Buff / Swap / Hit /
-- Special / Order) within PENDING_TIMEOUT confirms it, a rejected Order or the timeout puts the old ring back
function Input.Predict(B, action, arg, now)
	local pend = B.pending
	local cd = B.cd
	if action == "Element" or action == "Dash" or action == "Swap" then
		pend[action] = { t = now, prev = cd[action] or 0 }
		cd[action] = now + (B.cdLen[action] or 1)
	elseif action == "Buff" then
		local slot = tonumber(arg) or 0
		pend.Buff = { t = now, slot = slot, prev = cd.Buff[slot] or 0 }
		cd.Buff[slot] = now + (B.cdLen.Buff[slot] or 15)
		local H = nil
		for _, h in ipairs(Hud.helpers or {}) do
			if h.unit and h.unit.slot == slot then
				H = h
			end
		end
		if H then
			Hud.Pop(H.Face)
		end
	elseif action == "Target" then
		pend.Target = { t = now, prev = B.lock }
		B.lock = arg
		Hud.enemyDirty = true
	elseif action == "Attack" then
		-- no swing: the fighter attacks by itself (its lunges come from the server's Hits); a picked enemy shows the
		-- arrow at once (the server's lock echo / snapshot target follow)
		pend.Attack = { t = now, prev = B.lock }
		if arg ~= nil then
			B.lock = arg
			Hud.enemyDirty = true
		end
	elseif action == "Special" then
		pend.Special = { t = now }
	end
	if action ~= "Target" then
		Hud.Pop(Hud.ButtonOf(action, tonumber(arg)))
	end
	Hud.ringAt = 0 -- repaint the rings on the next frame
end

-- the server confirmed `action` (its event arrived)
function Input.Confirm(B, action, slot)
	local p = B.pending[action]
	if p and (action ~= "Buff" or slot == nil or p.slot == slot) then
		B.pending[action] = nil
		return true
	end
	return false
end

-- a refusal or a timeout: the ring goes back to what it showed before the press, the button shakes
function Input.Revert(B, action, shake)
	local p = B.pending[action]
	if not p then
		return
	end
	B.pending[action] = nil
	if action == "Element" or action == "Dash" or action == "Swap" then
		B.cd[action] = p.prev or 0
	elseif action == "Buff" then
		B.cd.Buff[p.slot] = p.prev or 0
	elseif action == "Target" or (action == "Attack" and p.prev ~= B.lock) then
		B.lock = p.prev
		Hud.enemyDirty = true
	end
	if shake then
		Hud.Shake(Hud.ButtonOf(action, p.slot))
	end
	Hud.ringAt = 0
end

-- predictions that no event confirmed in time (10 Hz from Hud.Update)
function Input.CheckPending(B, now)
	for action, p in pairs(B.pending) do
		if now - p.t > K.PENDING_TIMEOUT then
			if action == "Attack" or action == "Special" or action == "Target" then
				B.pending[action] = nil -- nothing to put back (a Target that never echoed keeps the lock)
			else
				Input.Revert(B, action, true)
				St.timeouts = (St.timeouts or 0) + 1
			end
		end
	end
end

-- a small press pop (scale) on a button
function Hud.Pop(obj)
	if not obj or not obj.Parent then
		return
	end
	local s = obj:FindFirstChild("PopScale")
	if not s then
		s = make("UIScale", { Name = "PopScale", Scale = 1 }, obj)
	end
	pcall(function()
		s.Scale = 0.9
		Util.Tween(s, 0.16, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end)
end


----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------
function Net.Cleanup(B, immediate)
	if not B then
		return
	end
	Tele.ClearAll(B)
	for _, u in ipairs(B.list) do
		Units.Destroy(u)
	end
	B.list = {}
	B.units = {}
	B.mine = {}
	if B.folder then
		pcall(B.folder.Destroy, B.folder)
		B.folder = nil
	end
	if St.battle == B then
		St.battle = nil
		if B.ringNext then
			Ring.HideNext()
		end
		if B.Mode == "Ring" then
			St.ringLast = B -- a run's final "End" may still come for this battle id (it ended between two rounds)
		end
		Input.Bind(false)
		Input.Movement(B, false)
		if not St.result then
			Hud.SetVisible(false)
		end
	end
	if immediate then
		Fx.ClearAll()
	end
end

function Net.Start(payload, battleId)
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	local B = St.battle
	if B and B.Id == id and not B.ended then
		-- a refresh (a raid spectator joins): keep the models, update the side and the units
		local side = num(payload.Side, 0)
		B.Side = side
		B.Spectator = payload.Spectator == true or side == 0
		B.Fighter = not B.Spectator
		B.Names = type(payload.Names) == "table" and payload.Names or B.Names
		B.sides = type(payload.Sides) == "table" and payload.Sides or B.sides
		local keep = {}
		for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
			local u = Units.Add(B, info)
			if u then
				keep[u.id] = true
				local me = myUserId()
				u.mine = B.Fighter and info.owner == me
				if B.Fighter then
					u.ally = u.side == B.Side
				else
					u.ally = u.side == 1
				end
				if u.mine and u.slot >= 1 then
					B.mine[u.slot] = u
				end
				if u.barFill then
					u.barFill.BackgroundColor3 = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
				end
				Cards.Restyle(u)
			end
		end
		for i = #B.list, 1, -1 do
			local u = B.list[i]
			if not keep[u.id] then
				Units.Remove(B, u.id)
			end
		end
		Net.Team(B, payload)
		Input.Bind(B.Fighter)
		Input.Movement(B, B.Fighter)
		Hud.Rebuild()
		return
	end
	-- the next Champion Ring round in the same pocket / the next dungeon room: my pets' models (and their cards)
	-- carry over, so nothing blinks between End and Start
	local chain = B and ((B.ringNext and tostring(payload.Mode) == "Ring") or (B.ended and B.Fighter and B.Mode == "Dungeon" and tostring(payload.Mode) == "Dungeon"))
	local carry = chain and Ring.TakeModels(B) or nil
	if B then
		Net.Cleanup(B, false)
	end
	B = newBattle(payload, battleId)
	B.sides = type(payload.Sides) == "table" and payload.Sides or {}
	St.battle = B
	B.renderT = num(payload.T, 0)
	for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
		Units.Add(B, info)
	end
	Net.Team(B, payload)
	if carry then
		Ring.GiveModels(B, carry)
	end
	Ring.HideNext()
	St.ringLast = nil
	-- spread the first positions from the static info until the first snapshot arrives
	if B.Mode == "Raid" then
		local BB = lazyBoss()
		if BB and B.BossId and type(BB.Preload) == "function" then
			pcall(BB.Preload, B.BossId)
		end
	end
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	Input.Bind(B.Fighter)
	Input.Movement(B, B.Fighter)
	Hud.Rebuild()
	BattleController._wake()
end

-- Phase 5: my team from "Start".Team = { Fighter, Bench, Lives, Speed = { Walk, Run }, Cooldowns } (a late joiner
-- gets the running cooldowns: seconds left; Buff keyed by slot STRINGS on the wire)
function Net.Team(B, payload)
	Input.CooldownLengths(B)
	local team = type(payload.Team) == "table" and payload.Team or nil
	if not B.Fighter then
		return
	end
	local now = os.clock()
	if team then
		B.fighterId = tonumber(team.Fighter) or B.fighterId
		B.lives = tonumber(team.Lives) or B.lives
		if type(team.Speed) == "table" and tonumber(team.Speed.Walk) then
			B.speed = { Walk = tonumber(team.Speed.Walk), Run = tonumber(team.Speed.Run) }
		end
		local cds = type(team.Cooldowns) == "table" and team.Cooldowns or {}
		for _, kind in ipairs({ "Element", "Dash", "Swap" }) do
			local left = num(cds[kind], 0)
			B.cd[kind] = left > 0 and (now + left) or 0
		end
		if type(cds.Buff) == "table" then
			for key, left in pairs(cds.Buff) do
				local slot = tonumber(key)
				if slot then
					B.cd.Buff[slot] = num(left, 0) > 0 and (now + num(left, 0)) or 0
				end
			end
		end
	end
	if not B.fighterId then
		-- (an older Start without Team: my slot-1 pet)
		local u = B.mine[1]
		B.fighterId = u and u.id or nil
	end
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u then
			u.benched = u.id ~= B.fighterId
		end
	end
	local f = B.fighterId and B.units[B.fighterId]
	B.fighterEvo = f and f.evo or 0
	if not B.speed and f then
		local walk, run = tonumber(f.info.walk), tonumber(f.info.run)
		if walk then
			B.speed = { Walk = walk, Run = run }
		end
	end
end

-- Phase 5: what an event changes for MY HUD, on arrival (the visuals play later on the render clock): predictions
-- confirmed / refused, cooldowns started, the lock, the fighter after a swap, the battle speed
function Net.Pre(B, ev)
	if not B.Fighter or B.ended then
		return
	end
	local me = myUserId()
	local t = ev.type
	local now = os.clock()
	if t == EV.Order then
		if ev.owner ~= me then
			return
		end
		local action = tostring(ev.order or "")
		if ev.rejected ~= nil then
			St.rejected = (St.rejected or 0) + 1
			local p = B.pending[action]
			if p then
				Input.Revert(B, action, true)
			elseif action ~= "Attack" and action ~= "Target" then
				Hud.Shake(Hud.ButtonOf(action, tonumber(ev.target)))
			end
		elseif action == "Target" or (action == "Attack" and tonumber(ev.target)) then
			-- the lock echo ("Attack"(id) / "Attack"() lock the enemy the pet now attacks)
			B.lock = tonumber(ev.target)
			B.pending[action] = nil
			Hud.enemyDirty = true
		end
	elseif t == EV.Element or t == EV.Dash then
		if t == EV.Dash and B.fighterId and tonumber(ev.unit) == B.fighterId then
			local f = B.units[B.fighterId]
			if f then
				Me.StartDash(B, f, ev) -- my pet's dash shows on arrival (the render clock would add its delay)
			end
		end
		if B.fighterId and tonumber(ev.unit) == B.fighterId then
			local kind = (t == EV.Element) and "Element" or "Dash"
			if not Input.Confirm(B, kind) then
				B.cd[kind] = now + (B.cdLen[kind] or 1)
			end
			Hud.ringAt = 0
		end
	elseif t == EV.Buff then
		if ev.owner == me then
			local h = B.units[tonumber(ev.unit) or -1]
			local slot = h and h.slot
			if slot and not Input.Confirm(B, "Buff", slot) then
				B.cd.Buff[slot] = now + (B.cdLen.Buff[slot] or 15)
			end
			Hud.ringAt = 0
		end
	elseif t == EV.Swap then
		if ev.owner == me then
			local predicted = Input.Confirm(B, "Swap")
			if not predicted and not ev.auto then
				B.cd.Swap = now + (B.cdLen.Swap or 10)
			end
			local old = B.fighterId
			B.fighterId = tonumber(ev["in"]) or B.fighterId
			local incoming = B.units[B.fighterId]
			if incoming then
				incoming.benched = false
				B.fighterEvo = incoming.evo or 0
				Units.Rebuild(B, incoming)
			end
			local out = old and B.units[old]
			if out and out ~= incoming then
				out.benched = true
			end
			pcall(Hud.Rebuild)
		end
	elseif t == EV.Hit then
		if B.fighterId and tonumber(ev.from) == B.fighterId and not ev.special and not ev.element and not ev.zone then
			Input.Confirm(B, "Attack")
		end
	elseif t == EV.Special then
		if B.fighterId and tonumber(ev.unit) == B.fighterId then
			Input.Confirm(B, "Special")
		end
	elseif t == EV.Speed then
		if ev.owner == me and tonumber(ev.walk) then
			B.speed = { Walk = tonumber(ev.walk), Run = tonumber(ev.run) }
			local mc = Hud.Movement()
			if mc and St.movementOn then
				pcall(mc.SetBattleSpeed, B.speed.Walk, B.speed.Run)
			end
		end
	end
end

function Net.Snapshot(payload, battleId)
	local B = St.battle
	if not B or type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if id ~= nil and id ~= B.Id then
		return
	end
	local T = num(payload.T, nil)
	if not T then
		return
	end
	local snaps = B.snaps
	local stale = #snaps > 0 and T <= snaps[#snaps].T
	if stale and payload.Units ~= nil then
		return -- out of order / duplicate (the old full form)
	end
	local units = payload.Units
	if type(units) ~= "table" then
		-- the wire form: only what changed since the last snapshot; the rest of the picture is carried forward
		if type(payload.U) ~= "table" or not BattleSim or type(BattleSim.DecodeSnapshot) ~= "function" then
			return
		end
		-- every delta is decoded, even one with no newer T (the server's baseline already counts it as sent)
		units = BattleSim.DecodeSnapshot(payload, B.lastUnits)
		B.lastUnits = units
		if stale then
			if T == snaps[#snaps].T then
				snaps[#snaps].Units = units
			end
			return
		end
	end
	snaps[#snaps + 1] = { T = T, Units = units }
	while #snaps > K.MAX_SNAPS do
		table.remove(snaps, 1)
	end
	local now = os.clock()
	local offset = T - now
	if not B.haveOffset then
		B.haveOffset = true
		B.offset = offset
	else
		-- follow slowly, but never let the render clock run ahead of what arrived
		B.offset = B.offset + (offset - B.offset) * K.OFFSET_RATE
		if offset < B.offset then
			B.offset = offset
		end
	end
end

function Net.Events(list, battleId)
	local B = St.battle
	if not B or type(list) ~= "table" then
		return
	end
	if battleId ~= nil and battleId ~= B.Id then
		return
	end
	-- played on the delayed render clock: stamp them with the estimated server time of their arrival
	local t = B.haveOffset and (os.clock() + B.offset) or B.renderT
	for _, ev in ipairs(list) do
		if type(ev) == "table" and type(ev.type) == "string" then
			local okPre, errPre = pcall(Net.Pre, B, ev)
			if not okPre then
				warnOnce("pre_" .. ev.type, "event " .. ev.type .. " (HUD) failed: " .. tostring(errPre))
			end
			-- telegraphs start at once (their fill must complete at the hit), the rest on the render clock
			if ev.type == EV.Telegraph then
				local fn = Handlers[ev.type]
				pcall(fn, B, ev)
			else
				B.evq[#B.evq + 1] = { t = t, ev = ev }
			end
		end
	end
end

function Net.End(payload, battleId)
	local B = St.battle
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if not B and St.ringLast and St.ringLast.Id == id and Ring.IsFinal(payload) then
		Hud.ShowResult(St.ringLast, payload) -- the run's card after the last round's floor was already freed
		St.ringLast = nil
		return
	end
	if not B or (id ~= nil and id ~= B.Id) then
		return
	end
	if B.ended then
		if B.ringNext and Ring.IsFinal(payload) then
			Ring.FinalAfterWin(B, payload) -- the run ended between two rounds (Forfeit, a leave, a shutdown...)
		end
		return
	end
	-- play what is still queued, so the last KO shows
	local latest = B.snaps[#B.snaps]
	B.renderT = max(B.renderT, (latest and latest.T or B.renderT)) + 5
	Net.PlayDue(B, os.clock())
	B.ended = true
	B.endAt = os.clock()
	Input.Bind(false)
	Input.Movement(B, false)
	B.pending = {}
	local participant = payload.Spectator ~= true and B.Fighter
	Cards.AfterFight(B, payload)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or nil
	if participant and B.Mode == "Dungeon" and (payload.Outcome == "Win" or payload.Won == true or (rw and rw.Dungeon == true and payload.Reason == "Cleared")) then
		-- a cleared dungeon room: no result card (DungeonController shows the loot); the floor waits for the next room
		B.linger = K.END_LINGER
		Hud.SetVisible(false)
		for _, u in ipairs(B.list) do
			if u.ally and u.root and not u.parked then
				u.hopAt = os.clock() + math.random() * 0.4
			end
		end
	elseif participant and Ring.IsNext(B, payload) then
		-- a won Champion Ring round: the side card "Round 8 won! ... Round 9 in 3", the floor stays until the next Start
		B.linger = Ring.LINGER
		Ring.ShowNext(B, payload)
		for _, u in ipairs(B.list) do
			if u.ally and u.root and not u.parked then
				u.hopAt = os.clock() + math.random() * 0.4
			end
		end
	elseif participant then
		B.linger = K.END_LINGER
		Hud.ShowResult(B, payload)
		-- winners cheer
		if payload.Outcome == "Win" or payload.Won then
			for _, u in ipairs(B.list) do
				if u.ally and u.root and not u.parked then
					u.hopAt = os.clock() + math.random() * 0.4
				end
			end
		end
	else
		B.linger = (payload.Reason == "OutOfRange") and 0 or K.SPECTATOR_LINGER
		Hud.SetVisible(false)
	end
	if B.linger <= 0 then
		Net.Cleanup(B, false)
	end
end

function BattleController.HandleState(kind, payload, battleId)
	if kind == "Start" then
		Net.Start(payload, battleId)
	elseif kind == "Snapshot" then
		Net.Snapshot(payload, battleId)
	elseif kind == "Events" then
		Net.Events(payload, battleId)
	elseif kind == "End" then
		Net.End(payload, battleId)
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function sampleSnaps(B)
	local snaps = B.snaps
	local n = #snaps
	if n == 0 then
		return nil, nil, 0
	end
	local t = B.renderT
	if t <= snaps[1].T then
		return snaps[1], nil, 0
	end
	for i = n - 1, 1, -1 do
		local a = snaps[i]
		if a.T <= t then
			local b = snaps[i + 1]
			local span = b.T - a.T
			local alpha = span > 0 and clamp((t - a.T) / span, 0, 1) or 1
			return a, b, alpha
		end
	end
	return snaps[n], nil, 0
end

-- per-section cost (only while a test injects BattleController.PerfClock)
local function section(name, t0)
	local clock = BattleController.PerfClock
	if not clock then
		return nil
	end
	local t = clock()
	if t0 then
		local split = St.perf.split
		split[name] = (split[name] or 0) + (t - t0) * 1000
	end
	return t
end

local function stepBattle(B, now, dt)
	local s0 = section()
	if not B.ended then
		if B.haveOffset then
			local latest = B.snaps[#B.snaps]
			local t = now + B.offset - interpDelay(B)
			if latest and t > latest.T + 0.15 then
				t = latest.T + 0.15
			end
			if t > B.renderT then
				B.renderT = t
			end
		end
		Net.PlayDue(B, now)
	end
	local sa, sb, alpha = sampleSnaps(B)
	s0 = section("Events", s0)
	Units.BuildPending(B)
	s0 = section("Builds", s0)
	local crowded = #B.list > K.CROWD
	local frameNo = St.frameNo
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for i, u in ipairs(B.list) do
		local animate = true
		if not u.mine and not u.isBoss then
			local stride = crowded and 2 or 1
			if camPos and u.root and not u.parked then
				local p = u.root.Position
				local dx, dy, dz = p.X - camPos.X, p.Y - camPos.Y, p.Z - camPos.Z
				local d2 = dx * dx + dy * dy + dz * dz
				if d2 > K.ANIM_FAR * K.ANIM_FAR then
					stride = 4
				elseif d2 > K.ANIM_MID * K.ANIM_MID then
					stride = 3
				end
			end
			-- a strided frame skips only the pose (PetBuilder.Animate); the root moves every frame and carries the
			-- animated parts rigidly (Units.CarryLoose), so the pet never stutters and never comes apart
			animate = (not u.posed) or ((frameNo + i) % stride) == 0
		end
		local ok, err = pcall(updateUnit, B, u, now, dt, sa, sb, alpha, animate)
		if not ok then
			warnOnce("unit", "unit update failed: " .. tostring(err))
		end
	end
	s0 = section("Units", s0)
	Tele.Update(B, now)
	Units.UpdateFocus(B, now)
	B.cue = B.threat and "Dash" or nil
	Input.Tick(B, now)
	s0 = section("Telegraphs", s0)
	if Hud.gui then
		local ok, err = pcall(Hud.Update, B, now)
		if not ok then
			warnOnce("hud", "HUD update failed: " .. tostring(err))
		end
	end
	section("Hud", s0)
end

-- the enemy my pet attacks: the lock (ATTACK / click / Tab), else the target my fighter auto-attacks (its snapshot
-- target, dungeon fixes decision 4); nil when none is drawn
function Units.FocusUnit(B)
	local u = B.lock and B.units[B.lock]
	local auto = false
	if not u and B.Fighter then
		local f = B.fighterId and B.units[B.fighterId]
		local t = f and f.target and B.units[f.target]
		if t and not t.ally then
			u, auto = t, true
		end
	end
	if not u or not u.model or u.parked or u.hidden or u.hp <= 0 or u.state == S_DOWN then
		return nil, false
	end
	return u, auto
end

-- a bobbing voxel arrow over the enemy my pet attacks (solid = picked, see-through = the one it chose by itself)
function Units.UpdateFocus(B, now)
	local u, auto = Units.FocusUnit(B)
	local mark = B.focusMark
	if not u or B.ended then
		if mark then
			mark.Parent = nil
		end
		return
	end
	if not mark then
		mark = make("Model", { Name = "FocusArrow" })
		local spec = { { 0, 0, 0.9 }, { 0, 0.7, 0.6 }, { 0, 1.3, 0.35 } }
		-- Phase 6: the Blender arrow (fx_arrow, 1 stud wide, pointing down) when ready: 1.4 studs wide like the Part
		-- arrow's top; each MeshPart's Y attribute keeps its manifest height under the same per-frame code
		local mesh = Units.FxMesh("fx_arrow", 1.4)
		if mesh then
			spec = {}
			for _, mp in ipairs(mesh) do
				mp:SetAttribute("Y", -mp.Position.Y / 0.8)
				mp.Parent = mark
			end
		end
		for i, s in ipairs(spec) do
			make("Part", {
				Name = "Arrow" .. i,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = COLORS.Gold,
				Size = Vector3.new(s[3] * 1.4, 0.5, s[3] * 1.4),
			}, mark):SetAttribute("Y", s[2])
		end
		B.focusMark = mark
	end
	if mark.Parent ~= B.folder then
		mark.Parent = B.folder
	end
	if (B.focusAuto == true) ~= auto then
		B.focusAuto = auto
		for _, p in ipairs(mark:GetChildren()) do
			if p:IsA("BasePart") then
				p.Transparency = auto and 0.4 or 0
			end
		end
	end
	B.focusId = u.id
	local top = u.isBoss and (u.height or 20) + 2 or (u.centerY or 1.5) + (u.height or 3) / 2 + 2.4
	local base = worldPoint(B, u.x, top + sin(now * 4) * 0.35, u.z)
	local spin = now * 2
	for _, p in ipairs(mark:GetChildren()) do
		p.CFrame = CFrame.new(base.X, base.Y - (p:GetAttribute("Y") or 0) * 0.8, base.Z) * CFrame.Angles(0, spin, 0)
	end
end

local function onFrame(dt)
	local perfClock = BattleController.PerfClock or os.clock
	local p0 = perfClock()
	local t0 = os.clock()
	St.frameNo = St.frameNo + 1
	local now = t0
	local B = St.battle
	if B then
		stepBattle(B, now, dt)
		if B.ended and now - (B.endAt or now) >= (B.linger or 0) then
			Net.Cleanup(B, false)
		end
	end
	local f0 = section()
	Fx.Update(now)
	Fx.UpdateNumbers(now)
	Fx.UpdateFlashes(now)
	Hud.UpdateResult(now)
	Ring.UpdateNext(now)
	Me.UpdateShake(now)
	section("Effects", f0)
	local ms = (perfClock() - p0) * 1000
	local perf = St.perf
	perf.frames = perf.frames + 1
	perf.total = perf.total + ms
	perf.last = ms
	if ms > perf.peak then
		perf.peak = ms
	end
	-- the loop sleeps when nothing is drawn
	if not St.battle and #St.effects == 0 and #St.numbers == 0 and #St.flashes == 0 and not St.result and not St.next and not St.shake then
		if St.loop then
			St.loop:Disconnect()
			St.loop = nil
		end
	end
end

function BattleController._wake()
	if St.loop or not St.initialized then
		return
	end
	St.loop = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(onFrame, dt)
		if not ok then
			warnOnce("frame", "frame failed: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function BattleController.GetBattle()
	local B = St.battle
	if not B then
		return nil
	end
	local models = 0
	for _, u in ipairs(B.list) do
		if u.model then
			models = models + 1
		end
	end
	return {
		Id = B.Id,
		Mode = B.Mode,
		Side = B.Side,
		Spectator = B.Spectator,
		Fighter = B.Fighter,
		Ended = B.ended,
		Units = #B.list,
		Models = models,
		Focus = B.lock,
		Lock = B.lock,
		FighterId = B.fighterId,
		Lives = B.lives,
		Speed = B.speed and { Walk = B.speed.Walk, Run = B.speed.Run } or nil,
		Dungeon = B.Dungeon,
		Wave = B.wave,
		MenuHidden = Hud.menuHidden == true,
		Cooldowns = (function()
			local now = os.clock()
			local out = { Buff = {} }
			for _, kind in ipairs({ "Element", "Dash", "Swap" }) do
				out[kind] = max(0, (B.cd[kind] or 0) - now)
			end
			for slot, t in pairs(B.cd.Buff) do
				out.Buff[slot] = max(0, t - now)
			end
			return out
		end)(),
		Pending = (function()
			local out = {}
			for k in pairs(B.pending) do
				out[k] = true
			end
			return out
		end)(),
		Hud = BattleController.IsHudVisible(),
		Layout = (Hud.m and Hud.m.Compact) and "Compact" or "Wide",
		RenderT = B.renderT,
		Telegraphs = (function()
			local n = 0
			for _ in pairs(B.teles) do
				n = n + 1
			end
			return n
		end)(),
		Threat = B.threat == true,
		Cue = B.cue,
		-- Phase 4: the ring round / record, the won round waiting for the next Start, duel overtime
		Round = B.Round > 0 and B.Round or nil,
		Best = B.Ring and num(B.Ring.Best, 0) or nil,
		Next = B.ringNext and B.ringNext.Next or nil,
		InterpDelay = interpDelay(B),
		TeamPlace = Hud.teamPlace,
	}
end

-- the drawn telegraphs (tests): { { Id, Shape, At, From, SafeAt, Late } ... } on the render clock
function BattleController.GetTelegraphs()
	local B = St.battle
	local out = {}
	for id, tl in pairs(B and B.teles or {}) do
		out[#out + 1] = { Id = id, Shape = tl.shape, At = tl.at, From = tl.from, SafeAt = tl.safeAt, Late = tl.late == true }
	end
	return out
end

function BattleController.GetUnit(id)
	local B = St.battle
	local u = B and B.units[id]
	if not u then
		return nil
	end
	return {
		Id = u.id, Side = u.side, Kind = u.kind, Name = u.name, Hp = u.hp, MaxHp = u.maxHp, State = u.state, Meter = u.meter,
		Model = u.model, X = u.x, Z = u.z, Parked = u.parked == true, Mine = u.mine, Ally = u.ally,
		World = u.model and unitCenter(B, u) or nil,
		-- Phase 4: the unit's PetCard ({ Gui, Mode }), level, evolution stage, XP, the ring champion's crown
		Card = u.card and { Gui = u.card.Gui, Mode = u.card.mode } or nil,
		Level = u.level, Evo = u.evo, Xp = u.xp, XpNext = u.xpNext, Crowned = u.crowned,
		Writes = u.cardWrites or 0,
		-- Phase 5: the bench, the wind-up, the drawn root position (my fighter / helpers), the team's lives, detail
		Benched = u.benched == true, Windup = u.windup == true, Lives = u.lives, Detail = u.detail,
		Drawn = u.root and u.root.Position or nil, FlyAt = u.flyAt, SwapAt = u.swapAt,
		-- dungeon fixes: arriving (the model hidden until the flash), the drawn pet dash, the wild look
		Arriving = u.arrive ~= nil, Hidden = u.hidden == true, ArriveFx = u.arriveFx ~= nil, DashAt = u.dashAt,
		Wild = u.info.wild == true,
	}
end

function BattleController.GetStats()
	local perf = St.perf
	local B = St.battle
	local models = 0
	if B then
		for _, u in ipairs(B.list) do
			if u.model then
				models = models + 1
			end
		end
	end
	local teles = 0
	if B then
		for _ in pairs(B.teles) do
			teles = teles + 1
		end
	end
	return {
		Frames = perf.frames,
		AvgMs = perf.frames > 0 and perf.total / perf.frames or 0,
		PeakMs = perf.peak,
		LastMs = perf.last,
		Units = B and #B.list or 0,
		Models = models,
		FxParts = St.fxLive,
		Effects = #St.effects,
		Numbers = #St.numbers,
		Flashes = #St.flashes,
		Telegraphs = teles,
		Builds = perf.builds,
		Bound = St.bound,
		HpWrites = Hud.hpWrites or 0,
		RingWrites = St.ringWrites or 0,
		Shakes = Hud.shakes or 0,
		CameraShakes = St.shakeCount or 0,
		Sent = St.sent or 0,
		Rejected = St.rejected or 0,
		Timeouts = St.timeouts or 0,
		Dashes = St.dashes or 0, -- pet dashes drawn (Dash events)
		Arrivals = St.arrivals or 0, -- arrival effects started (EvolutionFx.Arrive)
		Focus = (function()
			local b = St.battle
			local u, auto = nil, false
			if b then
				u, auto = Units.FocusUnit(b)
			end
			return u and { Id = u.id, Auto = auto } or nil
		end)(),
		Split = (function()
			local out = {}
			for k, v in pairs(perf.split or {}) do
				out[k] = perf.frames > 0 and v / perf.frames or 0
			end
			return out
		end)(),
	}
end

function BattleController.ResetStats()
	St.perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} }
end

function BattleController.IsHudVisible()
	return Hud.gui ~= nil and Hud.gui.Parent ~= nil and ((Hud.team and Hud.team.Visible) or (Hud.cmd and Hud.cmd.Visible) or (Hud.result and Hud.result.Visible)) == true
end

function BattleController.Stop()
	if St.battle then
		Net.Cleanup(St.battle, true)
	end
	Fx.ClearAll()
	Input.Bind(false)
	Input.Movement(nil, false)
	St.shake = nil
	for _, c in ipairs(St.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	St.conns = {}
	if St.loop then
		St.loop:Disconnect()
		St.loop = nil
	end
	Hud.SetMenuHidden(false)
	Me.MouseHold("BattleResult", false)
	Me.MouseHold("BattleLeave", false)
	St.prompts = {}
	if Hud.gui then
		Hud.gui:Destroy()
	end
	Hud.gui = nil
	Hud.rows = {}
	Hud.helpers = {}
	Hud.buttons = {}
	Hud.more = nil
	Hud.next = nil
	Hud.info = nil
	Hud.leave = nil
	Leave.buttons = {}
	St.result = nil
	St.next = nil
	St.ringLast = nil
	for _, p in ipairs(St.pool) do
		pcall(p.Destroy, p)
	end
	St.pool = {}
	St.fxLive = 0
	if St.folder then
		pcall(St.folder.Destroy, St.folder)
		St.folder = nil
		St.fxFolder = nil
	end
	St.initialized = false
end

function BattleController.Init()
	if St.initialized then
		return
	end
	St.initialized = true
	local conns = St.conns
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input, processed)
		local ok, err = pcall(Input.OnBegan, input, processed)
		if not ok then
			warnOnce("input", err)
		end
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
		local ok, err = pcall(Input.OnEnded, input)
		if not ok then
			warnOnce("input2", err)
		end
	end)
	local okGp, gpConn = pcall(function()
		return UserInputService.LastInputTypeChanged:Connect(function(t)
			local gp = t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2
			if gp ~= St.gamepad then
				St.gamepad = gp
				pcall(Hud.Keys)
			end
		end)
	end)
	if okGp and gpConn then
		conns[#conns + 1] = gpConn
	end
	-- the prompts shown to me: E presses them, not ELEMENT (Input.PromptShown)
	pcall(function()
		local pps = game:GetService("ProximityPromptService")
		conns[#conns + 1] = pps.PromptShown:Connect(function(prompt)
			St.prompts[prompt] = true
		end)
		conns[#conns + 1] = pps.PromptHidden:Connect(function(prompt)
			St.prompts[prompt] = nil
		end)
	end)
	-- own pets' level / XP from the profile mirror (after a fight's rewards land: the cards follow)
	local okS, sConn = pcall(function()
		return Mods.State and Mods.State.Changed and Mods.State.Changed:Connect(function()
			if St.battle then
				pcall(Cards.FromState, St.battle)
			end
		end)
	end)
	if okS and sConn then
		conns[#conns + 1] = sConn
	end
	local cam = workspace.CurrentCamera
	if cam then
		conns[#conns + 1] = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if St.battle then
				pcall(Hud.Rebuild)
			end
			local r = St.result
			if r and r.battle and Hud.result and Hud.result.Visible then
				pcall(Hud.ShowResult, r.battle, r.payload) -- the card re-places itself (top right on a landscape phone)
			end
		end)
	end
	-- the remote (BattleState may arrive a little after the controller starts)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
		local remote = folder and folder:WaitForChild("BattleState", 30)
		if not remote or not St.initialized then
			if St.initialized then
				warnOnce("remote", "BattleState remote not found: battles will not be drawn")
			end
			return
		end
		conns[#conns + 1] = remote.OnClientEvent:Connect(function(kind, payload, battleId)
			local ok, err = pcall(BattleController.HandleState, kind, payload, battleId)
			if not ok then
				warnOnce("state_" .. tostring(kind), "BattleState " .. tostring(kind) .. " failed: " .. tostring(err))
			end
		end)
		commandRemote()
	end)
end

BattleController._Units = Units -- TESTS ONLY (tools/smoke_p6_creatures.lua: the fx mesh slots)

return BattleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="870">
            <Properties>
              <string name="Name">CareController</string>
              <string name="Source"><![CDATA[-- CareController (client, Phase 4): the pet-care windows of ARCHITECTURE_V3.md "Phase 4 build contract" 3.4-3.7.
--
--   CareController.Init()
--   CareController.Open(panelId, args)   panelId = "Feed" | "Garden" | "Train" | "Evolve"
--       Feed    the Food Machine window (args.Key = the pet to show first): one row per owned pet copy, garden pets
--               first, then the followers, then the rest; each row has the pet, its name and stars, "Lv 57 / 100", the
--               XP bar, "Feed $340 (+90 XP)" (or "Feed (free Feast, 3 left)" while leftovers last), "Level up $1.2K"
--               (several feeds in ONE request, TycoonCatalog.FeedPrice per feed at the level it is eaten at) and
--               EVOLVE! when PetCatalog.CanEvolve says so; the footer lists the leftover food and the machine
--               ("Food Machine Lv 2: each feed fills 30% of the bar. Upgrade to Lv 3 (35%): $320K" + Upgrade).
--               -> PetCare("Feed", key, nil | {Count = n}); HomeAction("Upgrade", "Kitchen")
--       Garden  the garden picker for one place (args.Slot): every pet copy (any role) with its coins per second;
--               "Put here" -> HomeAction("GardenSet", {Slot, Key}); "Take out" -> HomeAction("GardenSet", {Slot})
--       Train   the Training Place window (args.Key = the pet to select): the pets on the left, the four skills
--               (Attack Speed / Physique / Ability / Defense) of the selected pet on the right with a rank bar, the
--               next rank's cost and time (TycoonCatalog.TrainCost / TrainSeconds) and Train; a training pet shows
--               its timer and Stop. Train and Stop ask first. -> PetCare("Train", key, stat) / PetCare("TrainStop", key)
--       Evolve  the evolution moment (the server's OpenPanel("Evolve", {Key, Stage}) after PetCare("Evolve")): every
--               window closes, PetController.PlayEvolution parks the follower of that key, EvolutionFx plays on two
--               fresh PetBuilder clones 5.5 studs in front of the player (with confetti), then the evolved clone
--               flies home as the follower (release(position)) and goes away
--   CareController.Close()               closes the window and any confirm
--   CareController.IsOpen() -> true while a care window or a confirm is up
--   Extras: CareController.Mode() -> "Feed" | "Garden" | "Train" | nil, CareController.ConfirmEvolve(key) (the EVOLVE
--           confirm, used by the Pets panel too), CareController.FeedPlan(key, count) -> { Count, Price, Xp, Free,
--           Food, Levels } (what a request would do; the server decides), CareController.Evolving() -> plays running,
--           CareController.Opened / Closed (Util.Signal; Opened fires the mode)
--
-- How the windows open: the server's OpenPanel("Pets", {Action = "Feed"}) (FeedPrompt on the Food Machine) and
-- OpenPanel("Train") (TrainPrompt) arrive here; MenuController forwards OpenPanel("Pets", {Action = "Feed" | "Garden"})
-- calls made on the client; E on an own GardenSpotPrompt opens the picker for its Slot. One window at a time: opening
-- one closes the menu windows, the Pet Index and the Fusion Machine; those opening close it. Esc, the red X or a click
-- outside close it, so does entering a match.
-- The client never decides money, XP or ranks: every number shown comes from the catalogs and the synced profile and the
-- server checks every request again. Readability rule: 1080p design pixels (body 18-19, buttons 20, titles 28-32) under
-- ONE UIScale = min(screen factor, fit); the window keeps >= 14 px text on phones (portrait: one column, landscape:
-- the compact rows). Pet viewports use PetBuilder's Low detail and are attached under a per-frame time budget.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local PetCatalog = safeRequire("PetCatalog") or { Get = function() return nil end }
local TycoonCatalog = safeRequire("TycoonCatalog")
local BattleCatalog = safeRequire("BattleCatalog")

local CareController = {}
CareController.Opened = Util.Signal()
CareController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- above NimbusMenu (20), the Pet Index (21) and the Fusion Machine (22)
	MARGIN = 12,
	PREF_W = 600, -- Phase 5 (6.6): the Care window is docked right / a bottom sheet (NeonKit.Dock), 600 x 820 design px
	PREF_H = 820,
	SHORT = 560, -- below this design height: the compact rows (landscape phones)
	WIDE = 930, -- at least this wide: one-line rows (the buttons beside the bar)
	TALL_W = 720, -- less than this free (design px) on a portrait screen: one column
	ROW_H = 112,
	BUTTONS_W = 610, -- the one-line row's button block (Feed 276 + Level up 190 + EVOLVE 128 + gaps)
	ROW_H_STACKED = 176,
	ROW_H_SHORT = 100,
	ROW_H_SHORT_STACKED = 160,
	VIEW = 88,
	VIEW_SHORT = 72,
	TOP_H = 46,
	FOOT_H = 108,
	FOOT_H_SHORT = 74,
	TRAIN_LIST_W = 360,
	TRAIN_ROW_H = 84,
	SKILL_H = 104,
	SKILL_H_SHORT = 88,
	CONFIRM_W = 560,
	CONFIRM_H = 286,
	BUILD_BUDGET = 0.004, -- seconds of pet viewport building per frame (at least one per frame)
	FIRE_GAP = 0.3, -- client-side spacing between two sends of the same action
	TICK = 0.5, -- seconds between two timer refreshes while a window is open
	MAX_FEEDS = 10, -- "Level up": at most this many feeds in one request (the server's MAX_FEEDS)
	-- the evolution moment (contract 3.6)
	EVO_AHEAD = 5.5, -- studs in front of the player
	EVO_HOVER = 0.7, -- studs between the clone's lowest point and the ground
	EVO_REST = 1.3, -- seconds the evolved clone stays before it flies home as the follower
	EVO_DETAIL = "High",
	EVO_FOLDER = "CareEvolution",
	RAY = 60,
	BACK_ACTION = "NimbusCareBack",
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local GOOD = Colors.Good
local BAD = Colors.Bad
local WELL_EDGE = Colors.WellEdge or NAVY
local INSET = Color3.fromRGB(20, 30, 70)
local CASH = Colors.Cash or Color3.fromRGB(112, 204, 98)
local XP = Color3.fromRGB(120, 200, 255)
local PURPLE = Color3.fromRGB(168, 118, 236)
local LOCK = Color3.fromRGB(255, 206, 120)
local ACCENTS = {
	Feed = Color3.fromRGB(240, 150, 80),
	Garden = Color3.fromRGB(110, 190, 90),
	Train = Color3.fromRGB(228, 104, 96),
}
local ROLE_COLORS = { Economy = Color3.fromRGB(96, 196, 108), Combat = Color3.fromRGB(228, 104, 96) }

-- glyphs as UTF-8 byte escapes (the source stays plain ASCII)
local G = {
	Star = "\226\152\133",
	Food = "\240\159\141\178", -- pot of food (the Food Machine)
	Seedling = "\240\159\140\177",
	Muscle = "\240\159\146\170",
	Lock = "\240\159\148\146",
	Bullet = "\194\183",
	Clock = "\226\143\177", -- stopwatch
	Sparkle = "\226\156\168",
	Berry = "\240\159\141\147", -- strawberry (Phase 5 berries)
}

local TITLES = {
	Feed = G.Food .. " Food Machine",
	Garden = G.Seedling .. " Pet Garden",
	Train = G.Muscle .. " Training Place",
}

local SKILLS = (BattleCatalog and type(BattleCatalog.TrainingSkills) == "table" and #BattleCatalog.TrainingSkills == 4)
		and BattleCatalog.TrainingSkills
	or {
		{ Id = "Speed", Name = "Attack Speed", Text = "+4% attacks per rank" },
		{ Id = "Physique", Name = "Physique", Text = "+5% max health per rank" },
		{ Id = "Ability", Name = "Ability", Text = "+4% special power and charge per rank" },
		{ Id = "Defense", Name = "Defense", Text = "-3% damage taken per rank" },
	}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local S = {
	Open = false, -- a window is shown
	Mode = nil, -- "Feed" | "Garden" | "Train"
	Token = 0,
	Built = false,
	Focus = nil, -- Feed: the pet to show first
	Slot = nil, -- Garden: the place the picker fills
	TrainKey = nil, -- Train: the selected pet
	Short = false,
	Tall = false,
	Stacked = false,
	Confirm = nil, -- { Kind, Key, Stat, Yes = fn } while a confirm is up
	Evolving = 0,
	EvoQueue = {},
	Last = {}, -- last send per action key (os.clock)
	Filling = false,
	RefreshPending = false,
}
local U = { Rows = {}, GardenRows = {}, TrainRows = {}, Skills = {} } -- ui references
local H = {} -- helpers (one table: the module stays far below Lua's local limit)

local function warnOnce(key, err)
	S.Warned = S.Warned or {}
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[CareController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok, err
end

----------------------------------------------------------------------
-- small UI helpers
----------------------------------------------------------------------
function H.frame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel (stroke + glyph outline: readable on any panel)
function H.text(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Stroke = 0.25,
		StrokeColor = INK,
		Outline = 1.5,
		OutlineColor = INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

function H.corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

function H.stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

function H.pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

function H.list(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function H.scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.ScrollBarThickness = 10
	p.ScrollBarImageColor3 = Colors.FrameTop or Colors.Cloud
	p.ScrollBarImageTransparency = 0.1
	p.Parent = parent
	return Util.Create("ScrollingFrame", p)
end

function H.inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = INSET
	p.BackgroundTransparency = 0.42
	local f = H.frame(parent, name, p)
	H.corner(f, 12)
	H.stroke(f, WELL_EDGE, 3, 0.15)
	return f
end

-- a solid coloured pill (role, status): white text with a dark outline of its own colour
function H.pill(parent, name, text, color, size, order)
	local dark = Theme.Darken(color, 0.62)
	local px = size or 18
	local pill = Theme.Label(text, "Heading", {
		Size = px,
		Color = WHITE,
		Stroke = 0.1,
		StrokeColor = dark,
		Outline = 1.5,
		OutlineColor = dark,
		Props = {
			Name = name,
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, px + 9),
			LayoutOrder = order or 0,
		},
	})
	Theme.Corner(pill, UDim.new(0.5, 0))
	H.stroke(pill, NAVY, 2, 0)
	Theme.Gradient(pill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 206, 226), 90)
	H.pad(pill, 9, 0, 9, 1)
	pill.Parent = parent
	return pill
end

function H.button(parent, name, text, style, size, textSize, callback)
	local b = CloudUI.Button({
		Name = name,
		Text = text,
		Style = style,
		Size = size,
		TextSize = textSize or 20,
		Callback = callback,
		Parent = parent,
	})
	return b
end

-- a button whose text may take two lines (the narrow rows): slimmer top / bottom padding
function H.twoLine(button)
	button.TextWrapped = true
	local p = button:FindFirstChildOfClass("UIPadding")
	if p then
		p.PaddingTop = UDim.new(0, 3)
		p.PaddingBottom = UDim.new(0, 3)
	end
end

function H.tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

----------------------------------------------------------------------
-- data helpers (the synced profile + the catalogs; display only)
----------------------------------------------------------------------
function H.call(mod, fnName, ...)
	if type(mod) ~= "table" or type(mod[fnName]) ~= "function" then
		return nil
	end
	local ok, a, b = pcall(mod[fnName], ...)
	if ok then
		return a, b
	end
	return nil
end

function H.def(key)
	if type(key) ~= "string" then
		return nil
	end
	local ok, def = pcall(State.DefOf, key)
	if ok and type(def) == "table" then
		return def
	end
	return PetCatalog.Get and PetCatalog.Get(key) or nil
end

function H.name(key, def)
	def = def or H.def(key)
	return def and tostring(def.DisplayName or def.Name or key) or tostring(key)
end

function H.level(key)
	local ok, level, xp = pcall(State.PetLevel, key)
	if ok and type(level) == "number" then
		return math.max(1, math.floor(level)), tonumber(xp) or 0
	end
	return 1, 0
end

function H.cap(def, key)
	local cap = H.call(PetCatalog, "LevelCap", def or key)
	if type(cap) == "number" and cap >= 1 then
		return math.floor(cap)
	end
	return tonumber(PetCatalog.MaxLevel) or (TycoonCatalog and tonumber(TycoonCatalog.MaxPetLevel)) or 100
end

function H.xpToNext(level)
	local n = H.call(TycoonCatalog, "XpToNext", level)
	if type(n) == "number" and n > 0 then
		return n
	end
	return math.huge
end

function H.growth(key)
	local ok, g = pcall(State.PetGrowth, key)
	if ok and type(g) == "table" then
		return g
	end
	return { Evo = 0, Speed = 0, Physique = 0, Ability = 0, Defense = 0 }
end

-- Phase 5 (3.7): the stored stage the way every site draws it (State.PetStage)
function H.stage(key)
	if type(State.PetStage) == "function" then
		local ok, stage = pcall(State.PetStage, key)
		if ok and type(stage) == "number" then
			return math.max(0, math.floor(stage))
		end
	end
	return math.max(0, math.floor(tonumber(H.growth(key).Evo) or 0))
end

-- Phase 5 (3.4): berries in the basket (the Berries attribute / State.Berries) and the basket size (plot BerryCap)
function H.berries()
	if type(State.Berries) == "function" then
		local ok, n = pcall(State.Berries)
		if ok and type(n) == "number" then
			return math.max(0, math.floor(n))
		end
	end
	return 0
end

function H.plot()
	local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex)
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	if type(index) ~= "number" or not lobby then
		return nil
	end
	local named = lobby:FindFirstChild(string.format("Spot_%02d", index), true)
	if named and named:GetAttribute("SpotIndex") == index then
		return named
	end
	return nil
end

-- one Food Machine feed of a pet copy: { Cost = berries (TycoonCatalog.FeedBerries), Xp = TycoonCatalog.FeedXp }
function H.berryFeed(key, def, level, machine)
	local cost = tonumber(H.call(TycoonCatalog, "FeedBerries", def or key, level)) or 0
	local xp = tonumber(H.call(TycoonCatalog, "FeedXp", level, math.max(1, machine))) or 0
	return { Cost = math.floor(cost), Xp = math.floor(xp) }
end

-- the next stage when the pet can EVOLVE now, else nil
function H.canEvolve(key, def, level)
	local nextStage = H.call(PetCatalog, "CanEvolve", def or key, level, H.stage(key))
	if type(nextStage) == "number" and nextStage >= 1 then
		return nextStage
	end
	return nil
end

function H.stars(stage)
	if stage and stage > 0 then
		return string.rep(G.Star, math.min(2, stage))
	end
	return ""
end

function H.home()
	local ok, home = pcall(State.Home)
	if ok and type(home) == "table" then
		return home
	end
	return { Stations = {}, Garden = {}, Prestige = 0 }
end

function H.station(home, id)
	local st = type(home) == "table" and home.Stations or nil
	local v = type(st) == "table" and st[id] or nil
	if type(v) == "number" and v == v then
		return math.max(0, math.floor(v))
	end
	return 0
end

function H.cash()
	local ok, v = pcall(State.Cash)
	if ok and type(v) == "number" then
		return v
	end
	return 0
end

function H.owned(key)
	local ok, n = pcall(State.OwnedCount, key)
	return ok and tonumber(n) or 0
end

function H.money(n)
	local text = H.call(TycoonCatalog, "FormatCash", n)
	if type(text) == "string" then
		return text
	end
	return "$" .. Util.Commas(math.floor(tonumber(n) or 0))
end

function H.rate(n)
	n = tonumber(n) or 0
	if n ~= n or n < 0 then
		n = 0
	end
	if n < 100 then
		local t = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		return "$" .. (t:gsub("%.0$", ""))
	end
	return H.money(n)
end

function H.commas(n)
	return Util.Commas(math.floor(tonumber(n) or 0))
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.hasHome()
	return LocalPlayer ~= nil and type(LocalPlayer:GetAttribute(Config.Attr.SpotIndex)) == "number"
end

function H.now()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

function H.clock(seconds)
	seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function H.minutes(seconds)
	local m = math.floor((tonumber(seconds) or 0) / 60 + 0.5)
	if m < 1 then
		return math.max(1, math.floor(seconds or 0)) .. " s"
	end
	return m .. " min"
end

function H.rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 1
		end
	end
	return 1
end

function H.rarityText(def)
	if def and def.Rarity == "Secret" then
		return Color3.fromRGB(196, 168, 255)
	end
	return Theme.Lighten(CloudUI.RarityColor(def and def.Rarity), 0.3)
end

-- every owned pet copy, rarest first (the Pets panel's order)
function H.ownedKeys()
	local ok, keys = pcall(State.Keys)
	if not ok or type(keys) ~= "table" then
		keys = {}
	end
	local info, out = {}, {}
	for i, key in ipairs(keys) do
		if type(key) == "string" and not info[key] and H.owned(key) > 0 then
			local def = H.def(key)
			if def then
				info[key] = { Order = H.rarityOrder(def.Rarity), Index = i }
				out[#out + 1] = key
			end
		end
	end
	table.sort(out, function(a, b)
		local x, y = info[a], info[b]
		if x.Order ~= y.Order then
			return x.Order > y.Order
		end
		return x.Index > y.Index
	end)
	return out
end

-- the Garden places holding `key` (ascending)
function H.gardenSlots(home, key)
	local out = {}
	if type(home.Garden) == "table" then
		for slot, k in pairs(home.Garden) do
			if k == key and type(slot) == "number" then
				out[#out + 1] = slot
			end
		end
	end
	table.sort(out)
	return out
end

function H.equippedCount(key)
	local ok, n = pcall(State.EquippedCount, key)
	return ok and tonumber(n) or 0
end

function H.equippedList()
	local ok, snap = pcall(State.Get)
	if ok and type(snap) == "table" and type(snap.Equipped) == "table" then
		return snap.Equipped
	end
	return {}
end

-- the running training job of a key { Stat, Ends, Rank, ... } or nil
function H.job(key)
	local job = H.growth(key).Job
	if type(job) == "table" then
		return job
	end
	return nil
end

function H.skillName(stat)
	for _, s in ipairs(SKILLS) do
		if s.Id == stat then
			return s.Name
		end
	end
	return tostring(stat)
end

-- where a pet copy is: "Physique 2:10" (training) | "In Garden" | "Following" | nil, and its colour
function H.whereText(key, home)
	local job = H.job(key)
	if job then
		local left = (tonumber(job.Ends) or 0) - H.now()
		return G.Muscle .. " " .. H.skillName(job.Stat) .. " " .. H.clock(left), Theme.Lighten(PURPLE, 0.3)
	end
	if #H.gardenSlots(home or H.home(), key) > 0 then
		return G.Seedling .. " In Garden", Theme.Lighten(GOOD, 0.3)
	end
	if H.equippedCount(key) > 0 then
		return G.Star .. " Following", GOLD
	end
	return nil, MUTED
end

-- the room left below the level cap, in XP
function H.room(level, xp, cap)
	if level >= cap then
		return 0
	end
	local room = 0
	for l = level, cap - 1 do
		local need = H.xpToNext(l)
		if need == math.huge then
			break
		end
		room = room + need
		if room > 1e12 then
			break
		end
	end
	return math.max(0, room - xp)
end

-- coins per second of a pet in this home's Garden (PetPower x food x stars / meal x the Lucky EV); a home without a
-- Garden counts the grass food
function H.coinsPerSecond(key, def, home)
	if not TycoonCatalog then
		return 0
	end
	local level = H.level(key)
	local power = H.call(TycoonCatalog, "PetPower", { Def = def, Level = level, Stage = H.stage(key), Key = key }) or 0
	local food = H.call(TycoonCatalog, "FoodOf", home) or 0
	local coins = TycoonCatalog.Coins or {}
	if food <= 0 then
		food = tonumber(coins.GrassFood) or 12
	end
	local stars = math.floor(tonumber(home.Prestige) or 0)
	local mult = H.call(TycoonCatalog, "PrestigeMultiplier", stars) or 1
	local lucky = H.call(TycoonCatalog, "LuckyEV", home) or 1
	local meal = tonumber(coins.MealSeconds) or 8
	return power * food * mult * lucky / meal
end

----------------------------------------------------------------------
-- remotes (each action at most every FIRE_GAP seconds; the server rate-limits as well)
----------------------------------------------------------------------
function H.fire(gapKey, name, ...)
	local now = os.clock()
	if S.Last[gapKey] and now - S.Last[gapKey] < K.FIRE_GAP then
		return false
	end
	local ok, remote = pcall(Remotes.Get, name)
	if not ok or not remote then
		warnOnce("remote " .. name, remote)
		return false
	end
	S.Last[gapKey] = now
	local args = { ... }
	local n = select("#", ...)
	local sent = pcall(function()
		remote:FireServer(unpack(args, 1, n))
	end)
	return sent
end

function H.hint(text, kind)
	-- the server answers every request with a side toast; local refusals use the menu's side hint (never centred)
	local menu = H.controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		pcall(menu.Hint, text, kind or "info")
	end
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

----------------------------------------------------------------------
-- window geometry (the FusionController pattern: one UIScale = min(screen factor, fit))
----------------------------------------------------------------------
function H.guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

function H.viewportHeight()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return H.guiSize().Y
end

-- the small centred confirm (Train / Stop / EVOLVE): its preferred size at the screen factor, shrunk to fit
function H.confirmFit(prefW, prefH, minW, minH)
	local area = H.guiSize()
	local factor = Theme.ScreenFactor(H.viewportHeight())
	local freeW = area.X - 2 * K.MARGIN
	local freeH = area.Y - 2 * K.MARGIN
	local w = Util.Clamp(math.floor(freeW / factor), minW, prefW)
	local h = Util.Clamp(math.floor(freeH / factor), minH, prefH)
	local scale = Util.Clamp(math.min(factor, freeW / w, freeH / h), 0.3, 1.25)
	return w, h, scale, area.X / 2, area.Y / 2
end

----------------------------------------------------------------------
-- pet viewports (Low detail, a few per frame)
----------------------------------------------------------------------
function H.queueView(row)
	if row.ViewReady or not row.ViewHolder then
		return
	end
	U.ViewQueue = U.ViewQueue or {}
	if not row.Queued then
		row.Queued = true
		U.ViewQueue[#U.ViewQueue + 1] = row
	end
	if S.Filling then
		return
	end
	S.Filling = true
	task.spawn(function()
		task.wait()
		while S.Open and U.ViewQueue and #U.ViewQueue > 0 do
			local t0 = os.clock()
			local built = 0
			while #U.ViewQueue > 0 and (built == 0 or os.clock() - t0 < K.BUILD_BUDGET) and built < 3 do
				local r = table.remove(U.ViewQueue, 1)
				if r then
					r.Queued = false
				end
				if r and not r.ViewReady and r.ViewHolder and r.ViewHolder.Parent and r.Def then
					r.ViewReady = true
					local stage = H.stage(r.Key)
					r.ViewStage = stage
					local ok, handle = pcall(CloudUI.PetViewport, r.ViewHolder, r.Def, UDim2.new(1, 0, 1, 0), {
						Spin = "sway",
						Detail = "Low",
						Evolved = stage > 0 and stage or nil,
						ZIndex = 4,
					})
					if ok then
						r.View = handle
					end
					built = built + 1
				end
			end
			task.wait()
		end
		S.Filling = false
	end)
end

function H.dropRow(row)
	if row.View then
		pcall(row.View.Destroy)
		row.View = nil
	end
	if row.Frame then
		row.Frame:Destroy()
	end
end

-- the pet disc of a row: a rarity-tinted circle with the viewport inside
function H.petDisc(parent, def, size)
	local color = CloudUI.RarityColor(def and def.Rarity)
	local disc = H.frame(parent, "Pet", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Darken(color, 0.35),
		ZIndex = 3,
	})
	Theme.Corner(disc, UDim.new(0, 14))
	H.stroke(disc, Theme.Lighten(color, 0.1), 3, 0)
	Theme.Gradient(disc, Theme.Lighten(color, 0.05), Theme.Darken(color, 0.45), 90)
	local holder = H.frame(disc, "ViewHolder", { Size = UDim2.new(1, 0, 1, 0), ZIndex = 4 })
	return disc, holder
end

