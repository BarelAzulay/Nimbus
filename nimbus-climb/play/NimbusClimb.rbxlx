		local tip = { math.cos(a) * 10.5, ctx.HeadTop + 2.5, c[3] + 1 - math.sin(a) * 6.5 }
		EVO.Leaf(ctx, base, tip, 1.4, (i % 2 == 0) and "Leaf" or "LeafDeep")
	end
	EVO.Necklace(ctx, { Size = 1.1, Drops = 2 })
