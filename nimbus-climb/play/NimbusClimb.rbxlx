          <string name="Name">TextureIds</string>
          <string name="Source"><![CDATA[-- GENERATED by tools/upload_assets.py --textures (Phase 6). Do not edit by hand.
-- Texture key -> Roblox Image asset id (numbers only). Empty = the gates' vortex uses its effects-only fallback.
return {}
