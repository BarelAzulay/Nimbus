-- Pet battles (most duel tunables are BattleService locals; this table holds the ones the owner sets).
Config.Battle = {
	-- lobby-shop 16.13 (the owner's answer, 2026-11-08): a duel won over a player who held fewer Trophies at the start than
	-- a loss takes (below |BattleCatalog.Trophies.Loss| = 10, 0 included; the review fix) pays floor(this x the normal win)
	-- Trophies, at least 1 (BattleService.ZeroTrophyPrize / LowTrophyOpponent); tokens and XP stay in full
	ZeroTrophyShare = 0.25,
	-- (battle-feel, 2026-11-10: docs/superpowers/specs/2026-11-10-battle-feel-design.md "The knob"; the owner can change any
	-- of these) how battles look and feel. Melee: the dash in + bite + hop back, the 8-stud standoff, the flurry under a
	-- 0.75 s attack gap. Aim: shots / beams / specials at the target's body centre ("Pivot" = the old pivot aim; rings stay
	-- on the real floor either way, FloorRay = one raycast per effect). Special: the "Weighty" x1.4 beats and the real
	-- server cast time per kind. The server reads Melee.Standoff, the strike window (Melee.In / Bite / Hold / Back /
	-- FlurryBelow / Out) and Special.RealCast / Cast / Carry (BattleCatalog.Damage).
	-- Off switches: Melee.Dash = false, Melee.Standoff = 0, Aim.Mode = "Pivot", Special.Weighty = false, Special.RealCast = false.
	-- (feel-balance, 2026-11-10, the owner's pick "Balance pass") Melee.Standoff = 8 and Special.RealCast = true ship ON:
	-- plan docs/superpowers/plans/2026-11-10-feel-balance.md. At 8 a melee pet rests 8 studs farther out and dashes in per
	-- attack; the server counts it at its BITE POINT while it strikes (Melee.Out = the share of the run in and of the hop back
	-- that counts as in), so a pet drawn inside a boss's slam is hit and one hopping back is not, and a melee pet's ELEMENT
	-- grows from its bite point. The real cast lands a special's effects at its cast end (a dash in the charge dodges it);
	-- Special.Carry keeps what the full meter would have gained during the charge for after the fire (no double tax).
	-- The raid refit that goes with 8 / true (BattleCatalog; each number's reading in BUILD_STATE.md 2026-11-11):
	-- BossRules.MinionDamage 0.06, RaidTiers Mid HpSeconds 95, HpTier storm_titan Mid 0.95, frost_wyrm Max 0.73,
	-- shadow_hydra Max 1.22. Change Standoff or RealCast -> re-run SIM_BATTLE=full and read the raid cells at 48 seeds.
	-- (feel-balance review, 2026-11-11) RaidTiers SoloHit Starter 1.33 / Mid 1.05 / High 0.96 (solos back to about 4-5%) and
	-- Damage.ModeDamage = { Duel = 1.1 } (the dodgeable cast had pushed mirror duels onto the 120 s clock).
	-- (review fix, battle-feel) MinGap 3 -> 1.5: the short dash + hop back plays against every boss whose box leaves room.
	Feel = {
		Melee = { Dash = true, Standoff = 8, In = 0.30, Bite = 0.08, Hold = 0.12, Back = 0.40, Hop = 0.5, Lunge = 0.6,
			FlurryBelow = 0.75, MinGap = 1.5, Streak = true, StreakMax = 4, Out = 0.5 },
		Aim = { Mode = "Centre", FloorRay = true },
		Special = { Weighty = true, Tempo = 1.4, ChargeMax = 1.1, Speed = 0.7, TravelMax = 0.7, Impact = 0.25, HitStop = 0.08,
			Afterglow = 1.5, Callout = 1.6, TravelHold = 0.3,
			RealCast = true, Carry = true, Cast = { Blast = 0.9, Beam = 0.8, Storm = 0.95, Freeze = 0.7, Pounce = 0.6, Heal = 0.55, Shield = 0.5, Rally = 0.55, Haste = 0.5 } },
	},
}

