	NAME_PX = 14,
	NAME_GLYPH = 0.55, -- ...and the glyph keeps at least this top share of the face where the tag leaves it room
	MIN_TEXT_PX = 14, -- no HUD text is ever drawn smaller on the screen (Readability rule)
	MIN_TEXT_PX_TALL = 15, -- ...on a screen 1000 px tall or more
	RESULT_W = 440,
	RESULT_MIN_W = 300, -- (playtest 2026-11-28 C33) the narrowest a landscape phone's card gets to clear a touch button
	-- LEAVE (Ring and Raid): the first press arms it for LEAVE_CONFIRM seconds, the second sends "Forfeit"
	LEAVE_CONFIRM = 3,
	LEAVE_W = 150,
	LEAVE_H = 52,
	LEAVE_W_COMPACT = 150,
	LEAVE_W_TOP = 100, -- a landscape phone: right of the mode card
	LEAVE_W_TOP_RAID = 150, -- ...a raid's: "No reward! Tap again" reads in two lines
	LEAVE_H_COMPACT = 46,
	LEAVE_CARD_W = 230,
	-- bug batch 6: the out-of-the-fight-area banner (AreaWarn), centred under the top band's cards
	AREA_W = 460,
	AREA_H = 74,
	AREA_TEXT = 28,
	AREA_TEXT_COMPACT = 22, -- a phone: the banner takes the top card's place (300 wide)
	AREA_SUB_TEXT = 17,
	-- wave 6: Cheer up! (Raid / Dungeon), right above the vitals card
	CHEER_W = 150,
	CHEER_H = 44,
	CHEER_GAP_PX = 8, -- screen px between the button's bottom and the vitals card's top
	CHEER_TOUCH_PX = 46, -- a touch screen: the button is at least this tall (screen px; the 44 px tap rule)
	CHEER_TOUCH_W_PX = 112,
	CHEER_CENTRE_TOL = 0.15, -- the screen middle it never enters (HudController's CENTRE_TOL 0.145 + a margin)
	RETREAT_PULSE = 3.5, -- evolved forms: rad/s of the Engage button's stroke
	-- Roblox's own thumbstick zone (screen px; HudController's numbers): the Retreat button under the vitals card keeps right of it
	STICK_SMALL_PHONE = 500, -- the smaller screen side at most this = the small controls
	STICK_W_SMALL = 110,
	STICK_W_LARGE = 190,
	STICK_H_TALL = 150, -- (Pitch 2 item 1b) its height: a tall small phone, a wide one, a big screen
	STICK_H_WIDE = 96,
	STICK_H_LARGE = 210,
}

local STATES = (BattleSim and BattleSim.States) or { Idle = 0, Moving = 1, Attacking = 2, Benched = 3, Casting = 4, Down = 5, Stunned = 6, Dashing = 7 }
local S_DOWN, S_STUNNED, S_CASTING, S_ATTACKING = STATES.Down, STATES.Stunned, STATES.Casting, STATES.Attacking
local S_BENCHED, S_DASHING, S_MOVING = STATES.Benched or 3, STATES.Dashing or 7, STATES.Moving or 1
local EV = (BattleSim and BattleSim.Events) or {
	Hit = "Hit", Special = "Special", KO = "KO", Telegraph = "Telegraph", Spawn = "Spawn", Enrage = "Enrage",
	Order = "Order", Zone = "Zone", Leave = "Leave", End = "End",
}

local METER_MAX = tonumber(BattleCatalog and type(BattleCatalog.Fighter) == "table" and BattleCatalog.Fighter.SpecialMeterMax) or 100
local SPECIALS = (BattleCatalog and BattleCatalog.Specials) or {}

local COLORS = {
	Mine = Theme.Colors.Health,
	Ally = Color3.fromRGB(98, 172, 232),
	Enemy = Color3.fromRGB(236, 88, 100),
	Gold = Theme.Colors.Gold or Color3.fromRGB(244, 196, 78),
	Heal = Color3.fromRGB(120, 230, 140),
	Shield = Color3.fromRGB(150, 210, 255),
	Ice = Color3.fromRGB(170, 228, 255),
	Weak = Color3.fromRGB(176, 190, 214),
	Strong = Color3.fromRGB(255, 150, 70),
	White = Color3.fromRGB(255, 255, 255),
	Ink = Theme.Colors.TextStroke or Color3.fromRGB(16, 22, 50),
	Panel = Theme.Colors.Panel,
	PanelLight = Theme.Colors.PanelLight,
	Navy = Theme.Colors.Navy or Color3.fromRGB(24, 34, 78),
	Muted = Theme.Colors.Muted or Color3.fromRGB(212, 224, 246),
	Track = Color3.fromRGB(28, 36, 76),
	Storm = Color3.fromRGB(72, 78, 108),
	LateRim = Color3.fromRGB(255, 70, 60), -- a telegraph past its dodge deadline flashes in this
	Wait = Color3.fromRGB(150, 132, 84), -- a SPECIAL with a full meter that waits for ATTACK
	StormLight = Color3.fromRGB(112, 118, 150),
	-- Phase 5 HUD (the Neon kit colours)
	HpGreen = Theme.Neon and Theme.Neon.Green or Color3.fromRGB(72, 224, 120),
	Loss = Color3.fromRGB(236, 60, 72),
	Energy = Theme.Neon and Theme.Neon.Blue or Color3.fromRGB(64, 170, 255),
	EnergyText = Color3.fromRGB(150, 206, 255),
	Life = Color3.fromRGB(255, 86, 112),
	LifeLost = Color3.fromRGB(70, 76, 108),
	LevelPill = Color3.fromRGB(44, 60, 120),
	SwapEdge = Theme.Neon and Theme.Neon.Cyan or Color3.fromRGB(64, 226, 236),
	Alert = Color3.fromRGB(255, 226, 90),
	Dodge = Color3.fromRGB(110, 236, 255),
	Windup = Color3.fromRGB(255, 220, 60),
	Action = {
		Target = Theme.Neon and Theme.Neon.Red or Color3.fromRGB(255, 76, 100),
		Element = Theme.Neon and Theme.Neon.Blue or Color3.fromRGB(64, 170, 255),
		Special = Theme.Neon and Theme.Neon.Gold or Color3.fromRGB(255, 196, 64),
		Dash = Theme.Neon and Theme.Neon.Cyan or Color3.fromRGB(64, 226, 236),
	},
}

-- (kit-b U9-6) the battle HUD on kit B (the owner's "Cloud Shop Signboard"): stone cards in a wood edge with a lip in the
-- card's role colour, a navy plank for the mode line, square bars and tags, flat faces, no glow, gloss or neon. One colour by
-- role: green = the result card's OK (the one main action), gold = the special / selected (the locked row, Cheer up!), red =
-- danger (the target, LEAVE, the enemies' HP), sky = the dash and the energy, the element's own colour for the element
local SIGN = Theme.Sign
local KB = {
	Face = SIGN.Tile,
	Well = SIGN.Well, -- a bar's track, a cooldown ring's
	Edge = SIGN.Wood,
	Ink = SIGN.Text,
	Muted = SIGN.TextMuted,
	Hp = SIGN.Grass,
	HpLip = SIGN.GrassLip,
	Loss = SIGN.Red, -- the HP's loss trail (brown reads on it 4.8:1, as on the well)
	Energy = SIGN.Sky,
	Life = SIGN.Red,
	LifeLost = SIGN.WellEdge,
	Action = { Target = SIGN.Red, Element = SIGN.Sky, Special = SIGN.Gold, Dash = SIGN.Sky },
	Mode = { Raid = SIGN.Red, Dungeon = SIGN.Violet, Ring = SIGN.Gold, Duel = SIGN.Sky },
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local St = {
	initialized = false,
	battle = nil, -- the drawn battle (see newBattle)
	old = {}, -- battles that ended and still fade out: { battle, until }
	conns = {}, -- long-lived connections
	loop = nil, -- RenderStepped connection (only while needed)
	folder = nil, -- workspace.ClientBattle
	fxFolder = nil,
	pool = {}, -- free effect parts
	fxLive = 0,
	effects = {}, -- live effects
	numbers = {}, -- live numbers
	numberPool = {},
	totals = {}, -- (Pitch 2 item 04) the live running totals, one a target (Fx.Total)
	totalPool = {},
	flashes = {}, -- live flashes
	flashPool = {},
	lastCmd = {}, -- [action .. arg] = os.clock()
	bound = false, -- ContextActionService bindings active
	gamepad = false, -- the last input was a gamepad
	tap = nil, -- { pos, t } a press that may become a tap
	frameNo = 0,
	fxFrame = 0, -- (fix round 2, M8) the frameNo of the last frame whose loop reached Atk.Update (equal at rest: no frame failed)
	perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} },
	warned = {},
	remoteCmd = nil,
	result = nil, -- result card timer
	prompts = {}, -- [ProximityPrompt] = true while shown to me (E passes through to it: Input.PromptShown)
	mouseHolds = {}, -- [reason] = true: our client/MouseLock holds (the cursor is free)
	holds = {}, -- [key] = { index, t, fired }: a helper key / portrait held (0.5 s = swap)
	movementOn = false, -- MovementController's battle switches are set
	shake = nil, -- { t0, dur, amp, base, last, hum } camera shake (base = the resting CameraOffset, e.g. the dungeon shoulder)
	lastDrawn = {}, -- wave 5 (bug #26): [userId] = { Pos, Key, At } where a dungeon fighter was drawn last (Net.Cleanup)
	dim = nil, -- (Task 11) { t0, dur, token, unit } a signature's battle dim (LightingStack K.DIM_ID pushed)
	pre = nil, -- (Task 11b) { B, unit, t0, untilT } my pressed SPECIAL's predicted charge, waiting for its event
	inhales = {}, -- (Task 11b) token -> { sound, t0, dur, vol } the charges' inhale sounds
	musicOn = nil, -- SoundFx's "Battle" layer as Net.Music last set it
	starting = nil, -- true while Net.Start cleans the battle before (Net.Cleanup leaves the music to Net.Start)
}

local Hud = {} -- the battle HUD (built once, lazily)
local Fx = {} -- pooled effects
local Units = {} -- battle units
local Tele = {} -- telegraphs and zones
local Input = {} -- keys, gamepad, taps
local Net = {} -- messages
local Cards = {} -- Phase 4: the PetCard above every battle unit
local Ring = {} -- Phase 4: the Champion Ring HUD (round / record / next-round side card / run card)
local Leave = {} -- LEAVE (two presses -> BattleCommand "Forfeit"): Champion Ring runs and boss raids
local CheerUp = {} -- wave 6: the Cheer up! button (BattleCommand "Cheer"): Raid / Dungeon fighters only
local Retreat = {} -- evolved forms: the Retreat / Engage button and the R key: boss raid fighters only
local AreaWarn = {} -- bug batch 6: the "Back to the fight! 3" banner (BattleState "Area": out of a raid's fight area)
local Me = {} -- Phase 5: my fighter at the character's shoulder, my helpers behind me, the camera shake
local Atk = {} -- pet attack VFX: client/Controllers/AttackFx first (the cube Fx.* as the fallback) + the battle poses

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp(x, lo, hi)
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

local function warnOnce(key, message)
	if St.warned[key] then
		return
	end
	St.warned[key] = true
	warn("[BattleController] " .. tostring(message))
end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function wrapAngle(a)
	return (a + pi) % TAU - pi
end

local function elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	if info and typeof(info.Color) == "Color3" then
		return info.Color
	end
	return Color3.fromRGB(170, 180, 200)
end

local function myUserId()
	return LocalPlayer and LocalPlayer.UserId or 0
end

-- seconds the drawing runs behind the estimated server clock (spectators get 5 Hz snapshots)
local function interpDelay(B)
	return (B and B.Spectator) and K.INTERP_DELAY_SPECTATOR or K.INTERP_DELAY
end

-- the round trip to the server in seconds (Player:GetNetworkPing), clamped; a default when unavailable
local function networkPing()
	local ok, v = pcall(function()
		return LocalPlayer:GetNetworkPing()
	end)
	if ok and type(v) == "number" and v == v and v >= 0 then
		return clamp(v, 0, K.PING_MAX)
	end
	return K.PING_DEFAULT
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function fmtTime(seconds)
	seconds = max(0, floor(seconds + 0.5))
	return string.format("%d:%02d", floor(seconds / 60), seconds % 60)
end

local function lazyBoss()
	if BossBuilder == nil then
		BossBuilder = optional(Shared, "BossBuilder") or false
	end
	return BossBuilder or nil
end

local function battleFolder()
	if St.folder and St.folder.Parent == workspace then
		return St.folder
	end
	local f = workspace:FindFirstChild(K.FOLDER)
	if not f then
		f = make("Folder", { Name = K.FOLDER }, workspace)
	end
	St.folder = f
	return f
end

local function fxFolder()
	if St.fxFolder and St.fxFolder.Parent then
		return St.fxFolder
	end
	St.fxFolder = make("Folder", { Name = "Fx" }, battleFolder())
	return St.fxFolder
end

----------------------------------------------------------------------
-- Effects: pooled voxel parts
----------------------------------------------------------------------
function Fx.Part(color, material, transparency)
	local p = table.remove(St.pool)
	if not p then
		if St.fxLive >= K.MAX_FX_PARTS then
			return nil
		end
		p = make("Part", {
			Name = "BattleFx",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Massless = true,
			TopSurface = Enum.SurfaceType.Smooth,
			BottomSurface = Enum.SurfaceType.Smooth,
		})
	end
	St.fxLive = St.fxLive + 1
	p.Shape = Enum.PartType.Block
	p.Material = material or Enum.Material.Neon
	p.Color = color or COLORS.White
	p.Transparency = transparency or 0
	p.Parent = fxFolder()
	return p
end

function Fx.Free(p)
	if not p then
		return
	end
	St.fxLive = max(0, St.fxLive - 1)
	if #St.pool < K.POOL_KEEP then
		p.Parent = nil
		St.pool[#St.pool + 1] = p
	else
		p:Destroy()
	end
end

-- registers a live effect: update(e, p, now) -> nothing; e.parts are freed when it ends
function Fx.Add(dur, update, parts, data)
	local e = data or {}
	e.t0 = os.clock()
	e.dur = dur
	e.update = update
	e.parts = parts or {}
	St.effects[#St.effects + 1] = e
	BattleController._wake()
	return e
end

local function burstUpdate(e, p)
	local t = p * e.dur
	local g = e.gravity
	local fade = p * p
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		local x = e.ox + v[1] * t
		local y = e.oy + v[2] * t - 0.5 * g * t * t
		local z = e.oz + v[3] * t
		local a = v[4] * t
		local c, s = cos(a), sin(a)
		part.CFrame = CFrame.new(x, y, z, c, 0, s, 0, 1, 0, -s, 0, c)
		local size = e.size * (1 - 0.7 * p)
		part.Size = Vector3.new(size, size, size)
		part.Transparency = e.alpha + (1 - e.alpha) * fade
	end
end

-- a burst of voxel cubes flying out of `pos`
function Fx.Burst(pos, color, count, speed, size, dur, opts)
	opts = opts or {}
	local parts, vel = {}, {}
	local rnd = math.random
	for i = 1, count do
		local c = color
		if opts.color2 and i % 2 == 0 then
			c = opts.color2
		end
		local part = Fx.Part(c, opts.material, opts.alpha or 0)
		if not part then
			break
		end
		local a = rnd() * TAU
		local up = (opts.up or 0.6) + rnd() * 0.6
		local sp = speed * (0.55 + rnd() * 0.6)
		parts[#parts + 1] = part
		vel[#vel + 1] = { cos(a) * sp, up * sp, sin(a) * sp, (rnd() - 0.5) * 12 }
		part.Size = Vector3.new(size, size, size)
		part.CFrame = CFrame.new(pos)
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, burstUpdate, parts, {
		ox = pos.X, oy = pos.Y, oz = pos.Z, vel = vel, size = size, gravity = opts.gravity or 18, alpha = opts.alpha or 0,
	})
end

local function ringUpdate(e, p)
	local r = e.r * (0.25 + 0.75 * (1 - (1 - p) * (1 - p)))
	local n = #e.parts
	for i, part in ipairs(e.parts) do
		local a = (i / n) * TAU + e.spin * p
		part.CFrame = CFrame.new(e.ox + cos(a) * r, e.oy + 0.3 + 0.6 * p, e.oz + sin(a) * r)
		part.Transparency = e.alpha + (1 - e.alpha) * p
	end
end

-- a ring of cubes that expands from `pos` to radius r (shock waves)
function Fx.Ring(pos, r, color, count, size, dur, alpha)
	local parts = {}
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, alpha or 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size * 0.6, size)
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, ringUpdate, parts, { ox = pos.X, oy = pos.Y, oz = pos.Z, r = r, spin = 0.6, alpha = alpha or 0.1 })
end

local function riseUpdate(e, p)
	local t = p * e.dur
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		part.CFrame = CFrame.new(e.ox + v[1], e.oy + v[2] * t, e.oz + v[3])
		part.Transparency = 0.1 + 0.9 * p * p
	end
end

-- cubes rising around a point (heal sparks)
function Fx.Rise(pos, color, count, size, dur, spread)
	local parts, vel = {}, {}
	local rnd = math.random
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size, size)
		parts[#parts + 1] = part
		local a = rnd() * TAU
		local r = spread * (0.3 + rnd() * 0.7)
		vel[#vel + 1] = { cos(a) * r, 2 + rnd() * 3, sin(a) * r }
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, riseUpdate, parts, { ox = pos.X, oy = pos.Y - 0.6, oz = pos.Z, vel = vel })
end

local function boltUpdate(e, p)
	local q = clamp(p * 1.25, 0, 1)
	local x = e.ax + (e.bx - e.ax) * q
	local y = e.ay + (e.by - e.ay) * q + sin(q * pi) * e.arc
	local z = e.az + (e.bz - e.az) * q
	local core = e.parts[1]
	if core then
		core.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(e.bx, e.by, e.bz))
		core.Transparency = (p > 0.8) and 1 or 0
	end
	local tail = e.parts[2]
	if tail then
		local q2 = max(0, q - 0.12)
		tail.CFrame = CFrame.new(e.ax + (e.bx - e.ax) * q2, e.ay + (e.by - e.ay) * q2 + sin(q2 * pi) * e.arc, e.az + (e.bz - e.az) * q2)
		tail.Transparency = (p > 0.8) and 1 or 0.45
	end
	if p >= 0.8 and not e.landed then
		e.landed = true
		Fx.Burst(Vector3.new(e.bx, e.by, e.bz), e.color, 5, 7, 0.28, 0.35, { up = 0.3, gravity = 10 })
	end
end

-- a voxel bolt flying from a to b (ranged attacks), with a small burst where it lands
function Fx.Bolt(a, b, color, size, dur)
	local core = Fx.Part(color, Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.Size = Vector3.new(size, size, size * 1.8)
	local tail = Fx.Part(color, Enum.Material.Neon, 0.45)
	if tail then
		tail.Size = Vector3.new(size * 0.6, size * 0.6, size * 0.6)
	end
	local dist = (b - a).Magnitude
	return Fx.Add(dur, boltUpdate, { core, tail }, {
		ax = a.X, ay = a.Y, az = a.Z, bx = b.X, by = b.Y, bz = b.Z, arc = min(2.2, dist * 0.08), color = color,
	})
end

local function beamUpdate(e, p)
	local w = e.width * (1 - p * 0.85)
	local core, glow = e.parts[1], e.parts[2]
	if core then
		core.Size = Vector3.new(w * 0.45, w * 0.45, e.length)
		core.Transparency = p * p
	end
	if glow then
		glow.Size = Vector3.new(w, w, e.length)
		glow.Transparency = 0.55 + 0.45 * p
	end
end

-- a straight beam (Beam specials): cf = the beam's centre frame (LookVector along the beam)
function Fx.Beam(cf, length, width, color, dur)
	local core = Fx.Part(COLORS.White:Lerp(color, 0.35), Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.CFrame = cf
	core.Size = Vector3.new(width * 0.45, width * 0.45, length)
	local glow = Fx.Part(color, Enum.Material.Neon, 0.55)
	if glow then
		glow.CFrame = cf
		glow.Size = Vector3.new(width, width, length)
	end
	return Fx.Add(dur, beamUpdate, { core, glow }, { length = length, width = width })
end

local function trailUpdate(e, p)
	for i, part in ipairs(e.parts) do
		local k = i / #e.parts
		part.Transparency = clamp(0.2 + p * 1.2 - k * 0.3, 0, 1)
	end
end

-- a dash trail of fading cubes from a to b (Pounce)
function Fx.Trail(a, b, color, count, dur)
	local parts = {}
	for i = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.2)
		if not part then
			break
		end
		local k = (i - 0.5) / count
		local s = 0.35 + 0.35 * k
		part.Size = Vector3.new(s, s, s)
		part.CFrame = CFrame.new(a:Lerp(b, k) + Vector3.new(0, sin(k * pi) * 1.2, 0))
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, trailUpdate, parts, {})
end

local function zoneUpdate(e, p, now)
	local t = now - e.t0
	local fadeIn = clamp(t / 0.3, 0, 1)
	local fadeOut = clamp(((e.live or e.dur) - t) / 0.4, 0, 1)
	local vis = fadeIn * fadeOut
	local disc = e.parts[1]
	if e.live then
		-- (attack effects, 2026-11-01) the damage ends: the disc goes straight to its dim look (never out and back), the cloud and
		-- bolts are gone, nothing moves; the last 0.3 s it fades out
		if disc then
			local a = e.discAlpha + (e.tailAlpha - e.discAlpha) * (1 - fadeOut)
			a = a + (1 - a) * clamp((t - (e.dur - 0.3)) / 0.3, 0, 1)
			disc.Transparency = 1 - (1 - a) * fadeIn
		end
		if t >= e.live then
			for i = #e.parts, 2, -1 do
				Fx.Free(e.parts[i])
				e.parts[i] = nil
			end
			return
		end
	elseif disc then
		disc.Transparency = 1 - (1 - e.discAlpha) * vis
	end
	if e.cloud then
		-- the storm cloud bobs; bolts strike every 0.5 s
		local bob = sin(t * 2.2) * 0.25
		for i = 2, e.cloudEnd do
			local part = e.parts[i]
			local o = e.offsets[i]
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + o.Y + bob, e.oz + o.Z)
			part.Transparency = 1 - (1 - o.alpha) * vis
		end
		local phase = (t % 0.5) / 0.5
		for i = e.cloudEnd + 1, #e.parts do
			local part = e.parts[i]
			if phase < 0.3 and vis > 0.2 then
				if not e.boltFor or e.boltFor ~= floor(t / 0.5) then
					e.boltFor = floor(t / 0.5)
					local rnd = math.random
					local a, r = rnd() * TAU, rnd() * e.r * 0.8
					e.bx, e.bz = e.ox + cos(a) * r, e.oz + sin(a) * r
				end
				local k = i - e.cloudEnd
				local seg = (e.oy - e.floorY) / 3
				local y = e.oy - seg * (k - 0.5) - 0.3
				local jig = (k % 2 == 0) and 0.5 or -0.5
				part.CFrame = CFrame.new(e.bx + jig, y, e.bz - jig * 0.5) * CFrame.Angles(0, 0, jig * 0.4)
				part.Transparency = 0.05
			else
				part.Transparency = 1
			end
		end
	elseif e.bubbles then
		for i = 2, #e.parts do
			local part = e.parts[i]
			local o = e.offsets[i]
			local q = ((t * o.speed) + o.phase) % 1
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + q * 1.4, e.oz + o.Z)
			part.Transparency = 1 - (1 - 0.15) * vis * (1 - q)
		end
	end
end

-- a damaging area on the floor for `seconds`: Storm (a voxel storm cloud with lightning), Field (the disc only: the
-- cloud is AttackFx's) or a lingering pool (a boss's: it ends on its seconds). Storm / Field hold a dim disc K.ZONE_TAIL longer
-- (attack effects, 2026-11-01), not on Graphics Low
function Fx.Zone(floorCF, r, seconds, color, kind)
	local parts = {}
	local disc = Fx.Part(color, Enum.Material.Neon, 0.7)
	if not disc then
		return nil
	end
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.12, r * 2, r * 2)
	disc.CFrame = floorCF * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, pi / 2)
	parts[1] = disc
	local pos = floorCF.Position
	if Mods.FxCat == nil then
		Mods.FxCat = optional(Shared, "AttackFxCatalog") or false
	end
	local e = { ox = pos.X, oy = pos.Y, oz = pos.Z, floorY = pos.Y, r = r, offsets = {}, discAlpha = 0.62, tailAlpha = Mods.FxCat and Mods.FxCat.TailTransparency or K.ZONE_TAIL_TRANS }
	local rnd = math.random
	if kind == "Storm" then
		e.cloud = true
		e.oy = pos.Y + 7.5
		local puffs = 9
		for i = 1, puffs do
			local shade = (i % 3 == 0) and COLORS.StormLight or COLORS.Storm
			local part = Fx.Part(shade, Enum.Material.SmoothPlastic, 0.05)
			if not part then
				break
			end
			local a = (i / puffs) * TAU
			local rr = (i == 1) and 0 or r * (0.25 + rnd() * 0.45)
			local s = 1.6 + rnd() * 1.4
			part.Size = Vector3.new(s * 1.3, s * 0.8, s * 1.3)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Y = rnd() * 0.8, Z = sin(a) * rr, alpha = 0.05 }
		end
		e.cloudEnd = #parts
		for _ = 1, 3 do
			local bolt = Fx.Part(Color3.fromRGB(230, 236, 255), Enum.Material.Neon, 1)
			if not bolt then
				break
			end
			bolt.Size = Vector3.new(0.25, (e.oy - pos.Y) / 3 + 0.4, 0.25)
			parts[#parts + 1] = bolt
		end
	elseif kind == "Field" then
		e.field = true -- (the disc alone)
	else
		e.bubbles = true
		for _ = 1, 7 do
			local part = Fx.Part(color:Lerp(COLORS.White, 0.25), Enum.Material.Neon, 0.3)
			if not part then
				break
			end
			local a, rr = rnd() * TAU, rnd() * r * 0.85
			local s = 0.35 + rnd() * 0.35
			part.Size = Vector3.new(s, s, s)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Z = sin(a) * rr, speed = 0.6 + rnd() * 0.8, phase = rnd() }
		end
	end
	if (kind == "Storm" or kind == "Field") and not St.fxLow then
		e.live = seconds
		seconds = seconds + K.ZONE_TAIL
	end
	return Fx.Add(seconds, zoneUpdate, parts, e)
end

function Fx.Update(now)
	local list = St.effects
	local i = 1
	while i <= #list do
		local e = list[i]
		local p = (now - e.t0) / e.dur
		local ok = true
		if p < 1 then
			ok = pcall(e.update, e, clamp(p, 0, 1), now)
		end
		if p >= 1 or not ok then
			for _, part in ipairs(e.parts) do
				Fx.Free(part)
			end
			e.parts = {}
			list[i] = list[#list]
			list[#list] = nil
		else
			i = i + 1
		end
	end
end

function Fx.ClearAll()
	for _, e in ipairs(St.effects) do
		for _, part in ipairs(e.parts) do
			Fx.Free(part)
		end
	end
	St.effects = {}
	for _, n in ipairs(St.numbers) do
		n.gui.Enabled = false
		n.gui.Adornee = nil
		St.numberPool[#St.numberPool + 1] = n
	end
	St.numbers = {}
	while #St.totals > 0 do
		Fx.FreeTotal(St.totals[#St.totals])
	end
	for _, f in ipairs(St.flashes) do
		f.hl.Enabled = false
		f.hl.Adornee = nil
		St.flashPool[#St.flashPool + 1] = f
	end
	St.flashes = {}
end

----------------------------------------------------------------------
-- Effects: floating numbers (pixel-sized billboards in the world: World text rule) and hit flashes
----------------------------------------------------------------------
local function newNumber()
	local gui = make("BillboardGui", {
		Name = "BattleNumber",
		Size = UDim2.fromOffset(240, 64),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.NUMBER_DISTANCE,
		Enabled = false,
	})
	-- over the 3D world with no plate: ONE outline (kit-b U6: was a classic stroke under it)
	local label = Theme.Label("", "Accent", { Size = K.NUMBER_PX, Outline = "World", OutlineThickness = 2.5 })
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = gui
	local scale = make("UIScale", { Name = "Pop", Scale = 1 }, label)
	return { gui = gui, label = label, scale = scale }
end

-- shows `text` above `adornee` (a BasePart), rising and fading; kind tweaks size / life
function Fx.Number(adornee, height, text, color, px, life)
	if not adornee or not adornee.Parent then
		return nil
	end
	local n = table.remove(St.numberPool)
	if not n then
		if #St.numbers >= K.MAX_NUMBERS then
			n = table.remove(St.numbers, 1) -- recycle the oldest
		else
			n = newNumber()
		end
	end
	if not n then
		return nil
	end
	n.gui.Parent = fxFolder()
	n.gui.Adornee = adornee
	n.label.Text = text
	n.label.TextColor3 = color or COLORS.White
	n.label.TextSize = Theme.ScaledSize(px or K.NUMBER_PX, 22)
	n.label.TextTransparency = 0
	local outline = n.label:FindFirstChild("TextOutline")
	if outline then
		outline.Transparency = 0
	end
	n.t0 = os.clock()
	n.life = life or K.NUMBER_TIME
	n.base = height
	n.riseK = 1 -- (Fx.Pop: a stacked pop rises K.HIT_RISE of it)
	n.lift = 0 -- (Fx.Pop: px its total stands over the unit's plate)
	n.jx = (math.random() - 0.5) * 1.4
	n.gui.StudsOffset = Vector3.new(n.jx, height, 0)
	n.gui.StudsOffsetWorldSpace = Vector3.new(0, 0, 0) -- (C60 round 2: a boss's pop takes its total's world height, Fx.Pop)
	n.gui.SizeOffset = Vector2.new(0, 0) -- (Pitch 2 item 04) a hit's pop moves beside its total (the hit handler)
	n.gui.Enabled = true
	St.numbers[#St.numbers + 1] = n
	BattleController._wake()
	return n
end

function Fx.UpdateNumbers(now)
	local list = St.numbers
	local i = 1
	while i <= #list do
		local n = list[i]
		local p = (now - n.t0) / n.life
		if p >= 1 or not n.gui.Adornee or not n.gui.Adornee.Parent then
			n.gui.Enabled = false
			n.gui.Adornee = nil
			table.remove(list, i)
			St.numberPool[#St.numberPool + 1] = n
		else
			local rise = 1 - (1 - p) * (1 - p)
			n.gui.StudsOffset = Vector3.new(n.jx, n.base + rise * K.NUMBER_RISE * (n.riseK or 1), 0)
			n.scale.Scale = 1 + 0.45 * max(0, 1 - p * 6)
			local fade = clamp((p - 0.6) / 0.4, 0, 1)
			n.label.TextTransparency = fade
			local outline = n.label:FindFirstChild("TextOutline")
			if outline then
				outline.Transparency = fade
			end
			i = i + 1
		end
	end
	-- (Pitch 2 item 04) a total clears after K.TOTAL_HOLD without a hit, or when its target went
	local totals = St.totals
	local j = #totals
	while j >= 1 do
		local t = totals[j]
		if now >= t.untilT or not t.gui.Adornee or not t.gui.Adornee.Parent then
			Fx.FreeTotal(t)
		end
		j = j - 1
	end
end

-- (C60 round 2: over a boss the total stood at Root + height + 1.4, inside the focus arrow's span, and its opaque
-- AlwaysOnTop chip hid "who my pet attacks") the studs over a boss's Root the focus arrow reaches at most: its anchor
-- (Units.UpdateFocus: height + 2), its 0.35 bob and its top half (the Part arrow's 0.25, the fx_arrow mesh's 0.41 at 1.4)
Fx.ARROW_OVER = 0.8
function Fx.ArrowTop(u)
	return (u.height or 20) + 2 + Fx.ARROW_OVER
end

-- the studs over a unit's centre its numbers start at (a boss's over its head)
function Fx.NumberHeight(u)
	if u.isBoss then
		-- (playtest 2026-11-28 C60: height x 0.5 + 2 put the total mid-body on a 20-stud boss) BossBuilder roots a boss at its
		-- feet (buildUnit's worldFrame at y 0; the lock mark's top is height + 2 too): over its head is the whole height,
		-- (round 2) and over the focus arrow there (the total stands on the arrow's top: Fx.Total)
		return Fx.ArrowTop(u) + 0.6
	end
	return (u.height or 3) / 2 + 1.8
end

-- (Pitch 2 item 04_world_ui B) one hit's pop: '+' .. Theme.Short(dmg) ("+20.6K"; it was the raw "20628"), its colour and
-- px: a plain hit in stone ink, a crit in gold (bigger), an element hit (ev.element: the attacker's element) or a strong
-- one in that element's colour (Storm violet), a weak one muted, a burn tick in red (smaller). The words ("CRIT", "BURN",
-- the "!") went: the colour and the size say it, so a pop never reads as a callout. -> text, colour, px
Fx.ElementInk = { Storm = Theme.Sign.Violet } -- (an element's pop ink where its own colour is not the kit's)
function Fx.HitLook(dmg, ev, element)
	ev = type(ev) == "table" and ev or {}
	local text = "+" .. Theme.Short(floor((tonumber(dmg) or 0) + 0.5))
	local color, px = Theme.Sign.Stone, K.HIT_PX
	local ink = (type(element) == "string" and element ~= "") and (Fx.ElementInk[element] or elementColor(element):Lerp(COLORS.White, 0.3)) or nil
	if ev.crit then
		color, px = Theme.Sign.Gold, K.HIT_CRIT_PX
	elseif ev.burn then
		color, px = Theme.Sign.Red, K.HIT_PX
	elseif ev.element or (ev.elem and ev.elem > 1) then
		color, px = ink or COLORS.Strong, K.HIT_ELEM_PX
	elseif ev.elem and ev.elem < 1 then
		color = COLORS.Weak
	end
	return text, color, px
end

function Fx.NewTotal()
	local gui = make("BillboardGui", {
		Name = "DamageTotal",
		Size = UDim2.fromOffset(220, K.TOTAL_H + 8),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.TOTAL_DISTANCE,
		ClipsDescendants = false,
		Enabled = false,
	})
	local e = K.TOTAL_EDGE
	local chip = make("Frame", {
		Name = "Chip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(60, K.TOTAL_H - 2 * e),
		BorderSizePixel = 0,
	}, gui)
	-- the stone chip: a 3 px mitred wood edge, the red lip (damage)
	local edge = make("UIStroke", { Name = "SignEdge", Color = Theme.Sign.Wood, Thickness = e, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Miter }, chip)
	chip.BackgroundColor3 = Theme.Sign.Stone
	chip.BackgroundTransparency = 0
	make("Frame", { Name = "Lip", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, K.TOTAL_LIP), BackgroundColor3 = Theme.Sign.RedLip, BorderSizePixel = 0 }, chip)
	local label = Theme.Label("", "Heading", { Size = K.TOTAL_PX, Color = Theme.Sign.Text })
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, -K.TOTAL_LIP)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.ZIndex = 2
	label.Parent = chip
	return { gui = gui, chip = chip, label = label, edge = edge, sum = 0, untilT = 0, owner = nil, shown = "" }
end

function Fx.FreeTotal(t)
	for i = #St.totals, 1, -1 do
		if St.totals[i] == t then
			table.remove(St.totals, i)
		end
	end
	if t.owner and t.owner.total == t then
		t.owner.total = nil
	end
	t.owner = nil
	t.sum = 0
	t.shown = "" -- (look review r0) a total taken from the pool is sized afresh (the screen may have changed)
	t.gui.Enabled = false
	t.gui.Adornee = nil
	St.totalPool[#St.totalPool + 1] = t
end

-- the billboard a unit's total stands on: the ring champion's tag (it holds the card under its plate), the unit card
-- (PetCard "HpBar": its Size holds the EVOLVE! pill), else the Phase 3 bar (addBar); only one on the unit's root.
-- nil for a raid boss (no world plate: its bar is the HUD's top card). -> BillboardGui or nil
function Fx.PlateOf(u)
	for _, g in ipairs({ u.tag or false, (u.card and u.card.Gui) or false, u.bar or false }) do
		if g and g.Parent and g.Adornee == u.root and g:IsA("BillboardGui") then
			return g
		end
	end
	return nil
end

-- adds `dmg` to unit `u`'s running total (u.root: the part it floats over) and shows it on its stone chip; a total that
-- went quiet (K.TOTAL_HOLD) starts afresh. -> the total's record (u.total) or nil
function Fx.Total(u, dmg)
	dmg = floor((tonumber(dmg) or 0) + 0.5)
	if type(u) ~= "table" or not u.root or not u.root.Parent or dmg <= 0 then
		return nil
	end
	local t = u.total
	if t and t.owner ~= u then
		t = nil
	end
	if not t then
		t = table.remove(St.totalPool)
		if not t then
			if #St.totals >= K.MAX_TOTALS then
				Fx.FreeTotal(St.totals[1]) -- recycle the oldest
				t = table.remove(St.totalPool)
			else
				t = Fx.NewTotal()
			end
		end
		t.owner, t.sum = u, 0
		u.total = t
		St.totals[#St.totals + 1] = t
	end
	t.sum = t.sum + dmg
	local text = Theme.Short(t.sum)
	t.label.Text = text
	if #text ~= #t.shown then
		local tpx = Theme.ScaledSize(K.TOTAL_PX, 22)
		t.label.TextSize = tpx
		local w = math.ceil(Theme.Measure(text, "Heading", tpx).X) + 2 * K.TOTAL_PAD
		-- (look review r0: at 1440p the 30 px figure ran over the red lip in the fixed 24 px box) the face holds the
		-- figure's px above its lip, never less than the 1080p chip
		local faceH = math.max(K.TOTAL_H - 2 * K.TOTAL_EDGE, tpx + K.TOTAL_LIP)
		t.chip.Size = UDim2.fromOffset(w, faceH)
		t.gui.Size = UDim2.fromOffset(math.max(220, w + 2 * K.TOTAL_EDGE + 8), faceH + 2 * K.TOTAL_EDGE + 8)
	end
	t.shown = text
	t.gui.Parent = fxFolder()
	t.gui.Adornee = u.root
	-- (bug "damage total covers the pet level card", 2026-11-27: it sat 0.3 studs over the card, so at fighting distance the
	-- 34 px chip covered the 43 px card but for the "L" of "Lv 4") the total stands on its unit's plate in screen px: on the
	-- plate's own anchor, its chip K.TOTAL_GAP px over the plate's top edge (SizeOffset: a share of its own px size, true
	-- at every distance and screen). No plate (a raid boss): over its head as before
	local plate = Fx.PlateOf(u)
	local height, lift, world = Fx.NumberHeight(u) - 0.6, 0, 0
	if plate then
		height = plate.StudsOffset.Y
		lift = plate.Size.Y.Offset / 2 + Theme.ScaledSize(K.TOTAL_GAP, 3) + (t.chip.Size.Y.Offset + 2 * K.TOTAL_EDGE) / 2
	elseif u.isBoss then
		-- (C60 round 2) a boss: on the focus arrow's top (Fx.ArrowTop), the whole chip K.TOTAL_GAP px over it at every
		-- distance. The arrow stands in world studs (Units.UpdateFocus), so the anchor does too: a camera-space StudsOffset
		-- of ~28 studs leans with the camera's tilt and would drift off the arrow
		height, world = 0, Fx.ArrowTop(u)
		lift = Theme.ScaledSize(K.TOTAL_GAP, 3) + (t.chip.Size.Y.Offset + 2 * K.TOTAL_EDGE) / 2
	end
	t.lift = lift
	t.gui.StudsOffsetWorldSpace = Vector3.new(0, world, 0)
	t.gui.StudsOffset = Vector3.new(0, height, 0)
	t.gui.SizeOffset = Vector2.new(0, lift / max(1, t.gui.Size.Y.Offset))
	t.gui.Enabled = true
	t.untilT = os.clock() + K.TOTAL_HOLD
	BattleController._wake()
	return t
end

-- (look review r1, M3: at 844x390 '+18.3K' sat on '+136K'; the pops' rise is in studs, so on a small screen two hits a
-- tempo apart rose less than a line apart) one hit on unit `u`: `dmg` onto its running total and the pop beside it
-- (Fx.Number at `height` over `adornee`). The target's live pops stack in hard steps of K.HIT_STEP screen px (1080p px
-- under Theme.ScaledSize): the newest at the chip, each older one a step higher (its SizeOffset Y), and since an older pop
-- has always risen at least as far, two never share a line at any screen size; past K.HIT_MAX the oldest goes.
-- -> pop, total
function Fx.Pop(u, adornee, height, text, color, px, dmg)
	local total = Fx.Total(u, dmg)
	local pop = Fx.Number(adornee, height, text, color, px)
	if not pop then
		return nil, total
	end
	if total then
		pop.gui.SizeOffset = Vector2.new(K.HIT_SIDE, 0)
		pop.riseK = K.HIT_RISE -- (every pop of the stack the same share: an older one has still risen at least as far)
		-- (bug 2026-11-27: the total stands on the card in px, Fx.Total) the pop keeps its place beside it: 0.6 studs over
		-- the total's anchor, lifted the same px (the stack below adds the lift to its steps)
		pop.base, pop.lift = total.gui.StudsOffset.Y + 0.6, total.lift or 0
		pop.gui.StudsOffset = Vector3.new(pop.jx, pop.base, 0)
		pop.gui.StudsOffsetWorldSpace = total.gui.StudsOffsetWorldSpace -- (C60 round 2: a boss's total stands in world studs)
	end
	if type(u) ~= "table" then
		return pop, total
	end
	-- the target's live pops, newest first (a pooled number reused since, or ended, has left the stack)
	local live = { { n = pop, t0 = pop.t0 } }
	for _, rec in ipairs(u.pops or {}) do
		local n = rec.n
		if n ~= pop and n.t0 == rec.t0 and n.gui.Enabled and n.gui.Adornee == adornee then
			live[#live + 1] = rec
		end
	end
	for i = #live, K.HIT_MAX + 1, -1 do
		local n = live[i].n
		n.t0 = n.t0 - n.life -- ends on the next update
		live[i] = nil
	end
	local step = Theme.ScaledSize(K.HIT_STEP, 22)
	for i, rec in ipairs(live) do
		local g = rec.n.gui
		g.SizeOffset = Vector2.new(g.SizeOffset.X, ((rec.n.lift or 0) + (i - 1) * step) / math.max(1, g.Size.Y.Offset))
	end
	u.pops = live
	return pop, total
end

-- a short white (or tinted) flash on a model (a pooled Highlight)
function Fx.Flash(u, color, dur)
	if not u or not u.model or u.parked then
		return
	end
	local f = u.flash
	if not f then
		f = table.remove(St.flashPool)
		if not f then
			if #St.flashes >= K.MAX_FLASHES then
				return
			end
			f = {
				hl = make("Highlight", {
					Name = "HitFlash",
					DepthMode = "Occluded", -- Enum.HighlightDepthMode.Occluded by name (no flash through the arena walls)
					OutlineTransparency = 1,
					FillTransparency = 1,
					Enabled = false,
				}),
			}
		end
		f.hl.Parent = fxFolder()
		St.flashes[#St.flashes + 1] = f
		u.flash = f
		f.unit = u
	end
	f.t0 = os.clock()
	f.dur = dur or K.FLASH_TIME
	f.hl.FillColor = color or COLORS.White
	f.hl.Adornee = u.model
	f.hl.FillTransparency = 0.25
	f.hl.Enabled = true
	BattleController._wake()
end

function Fx.UpdateFlashes(now)
	local list = St.flashes
	local i = 1
	while i <= #list do
		local f = list[i]
		local p = (now - f.t0) / (f.dur or K.FLASH_TIME)
		if p >= 1 or not f.hl.Adornee then
			f.hl.Enabled = false
			f.hl.Adornee = nil
			if f.unit then
				f.unit.flash = nil
				f.unit = nil
			end
			list[i] = list[#list]
			list[#list] = nil
			St.flashPool[#St.flashPool + 1] = f
		else
			f.hl.FillTransparency = 0.25 + 0.75 * p
			i = i + 1
		end
	end
end

----------------------------------------------------------------------
-- Battle record + coordinates
----------------------------------------------------------------------
local function newBattle(payload, battleId)
	local zone = type(payload.Zone) == "table" and payload.Zone or {}
	local cf = zone.CFrame
	if typeof(cf) ~= "CFrame" then
		cf = CFrame.new()
	end
	local size = zone.Size
	local zx = num(zone.X, typeof(size) == "Vector3" and size.X or 60)
	local zz = num(zone.Z, typeof(size) == "Vector3" and size.Z or 60)
	local side = num(payload.Side, 0)
	local spectator = payload.Spectator == true or side == 0
	local B = {
		Id = payload.BattleId or battleId,
		Mode = tostring(payload.Mode or "Duel"),
		Side = side,
		Spectator = spectator,
		Fighter = not spectator,
		ZoneCF = cf,
		ZoneX = zx,
		ZoneZ = zz,
		Names = type(payload.Names) == "table" and payload.Names or {},
		-- Phase 5: the dungeon room's Extra { Floor, Room, Wave, Waves, Name, Boss }
		Dungeon = type(payload.Dungeon) == "table" and payload.Dungeon or nil,
		TimeLimit = num(payload.TimeLimit, 0),
		Level = payload.Level,
		BossId = payload.BossId,
		-- boss raids: "Start".Raid = { Tier, Pocket, BossId, Enraged } (a late joiner comes in enraged)
		Raid = type(payload.Raid) == "table" and payload.Raid or nil,
		-- Phase 4: the Champion Ring's "Start".Ring = { Round, Best, Start, Champion = { PetId, Level, Tier, Boss, Name } }
		Ring = type(payload.Ring) == "table" and payload.Ring or nil,
		Round = num(payload.Round or (type(payload.Ring) == "table" and payload.Ring.Round), 0),
		ringNext = nil, -- a won ring round: { Round, Next, Cash, Xp, Tokens, Record, At } until the next "Start"
		units = {},
		list = {},
		mine = {},
		snaps = {},
		offset = 0,
		haveOffset = false,
		renderT = num(payload.T, 0),
		evq = {},
		fxEv = {}, -- [event] = what AttackFx did with it on arrival (Atk.Arrive / Atk.Result)
		fxHold = {}, -- [unit id] = render-clock time a ranged shot at it lands (Net.Queue / Net.Hold: its next events wait)
		teles = {},
		buildQueue = {},
		-- Phase 5: my team (Start.Team), the lock, the cooldowns (os.clock ready times) and the predictions
		fighterId = nil,
		lives = nil,
		speed = nil, -- { Walk, Run }
		lock = nil,
		cd = { Element = 0, Dash = 0, Swap = 0, Cheer = 0, Retreat = 0, Buff = {} },
		cdLen = { Element = 7, Dash = 2.5, Swap = 10, Cheer = 20, Retreat = 10, Buff = {} },
		cheerUntil = 0, -- wave 6: os.clock time the Cheer up! glow ends
		retreated = false, -- evolved forms: my team is back (Start.Team.Retreated, the Order echoes)
		pending = {},
		ended = false,
		simEnded = false,
		enraged = type(payload.Raid) == "table" and payload.Raid.Enraged == true,
		lethalPending = false, -- a lethal telegraph is up (the enrage pill says DASH!)
		wave = 0,
		folder = nil,
	}
	-- the zone basis, so a zone-local point becomes a world point with plain arithmetic per frame
	local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	B.basis = { px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 }
	B.folder = make("Folder", { Name = "Battle_" .. tostring(B.Id) }, battleFolder())
	return B
end

-- zone-local (x, y, z) -> world Vector3
local function worldPoint(B, x, y, z)
	local b = B.basis
	return Vector3.new(b[1] + b[4] * x + b[5] * y + b[6] * z, b[2] + b[7] * x + b[8] * y + b[9] * z, b[3] + b[10] * x + b[11] * y + b[12] * z)
end

-- zone-local position + yaw (0 = facing -Z of the zone) -> world CFrame (one allocation)
local function worldFrame(B, x, y, z, yaw)
	local b = B.basis
	local c, s = cos(yaw), sin(yaw)
	-- R = Z * Ry(yaw): columns of Ry are (c,0,-s), (0,1,0), (s,0,c)
	local m00 = b[4] * c - b[6] * s
	local m01 = b[5]
	local m02 = b[4] * s + b[6] * c
	local m10 = b[7] * c - b[9] * s
	local m11 = b[8]
	local m12 = b[7] * s + b[9] * c
	local m20 = b[10] * c - b[12] * s
	local m21 = b[11]
	local m22 = b[10] * s + b[12] * c
	return CFrame.new(
		b[1] + b[4] * x + b[5] * y + b[6] * z,
		b[2] + b[7] * x + b[8] * y + b[9] * z,
		b[3] + b[10] * x + b[11] * y + b[12] * z,
		m00, m01, m02, m10, m11, m12, m20, m21, m22
	)
end

local function yawToward(dx, dz)
	return atan2(-dx, -dz)
end

----------------------------------------------------------------------
-- Units
----------------------------------------------------------------------
-- the definition PetBuilder draws for a unit (its look from the sim; else its key / pet id)
function Units.Def(info)
	local look = info.look
	local base = nil
	if PetCatalog and type(PetCatalog.Get) == "function" then
		if info.petId then
			local ok, d = pcall(PetCatalog.Get, info.petId)
			base = ok and type(d) == "table" and d or nil
		end
		if not base and type(look) == "table" and look.BodyId then
			local ok, d = pcall(PetCatalog.Get, look.BodyId)
			base = ok and type(d) == "table" and d or nil
		end
	end
	if type(look) == "table" then
		return { Id = tostring(info.key or info.petId or info.id), Rarity = base and base.Rarity or nil, Look = look }
	end
	if PetKeys and type(info.key) == "string" then
		local ok, d = pcall(PetKeys.DefOf, info.key)
		if ok and type(d) == "table" then
			return d
		end
	end
	return base
end

local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" or type(part:GetAttribute("PB_Base")) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

-- welds the static parts to the anchored root once: a pose is then one root CFrame write
local function weldStatic(model, root)
	local inv = root.CFrame:Inverse()
	local identity = CFrame.new()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and part.Anchored and not isAnimatedPart(part) then
			make("Weld", { Name = "BattleWeld", Part0 = root, Part1 = part, C0 = inv * part.CFrame, C1 = identity }, part)
			part.Anchored = false
		end
	end
	root.Anchored = true
end

function Units.Add(B, info)
	if type(info) ~= "table" then
		return nil
	end
	local id = tonumber(info.id)
	if not id then
		return nil
	end
	local u = B.units[id]
	if u then
		u.info = info
		u.fxLook = nil -- (Atk.Look reads the new info)
		return u
	end
	local me = myUserId()
	local side = num(info.side, 2)
	local mine = B.Fighter and info.owner == me
	local ally
	if B.Fighter then
		ally = side == B.Side
	else
		ally = side == 1
	end
	u = {
		id = id,
		info = info,
		side = side,
		owner = info.owner,
		slot = num(info.slot, 0),
		kind = tostring(info.kind or "Pet"),
		name = tostring(info.name or "Pet"),
		element = info.element,
		elements = type(info.elements) == "table" and info.elements or { info.element },
		maxHp = max(1, num(info.maxHp, 100)),
		level = num(info.level, 1),
		tier = info.tier,
		scale = num(info.scale, 1),
		ranged = info.ranged == true,
		range = num(info.range, 0),
		radius = num(info.radius, 1.8),
		special = type(info.special) == "table" and info.special or nil,
		isBoss = info.kind == "Boss",
		bossId = info.boss,
		-- Phase 4: the stored evolution stage (the model and the card's stars), own pets' XP (the card's XP row), the
		-- ring champion's crown
		evo = clamp(floor(num(info.evo, 0)), 0, 2),
		xp = tonumber(info.xp),
		xpNext = tonumber(info.xpNext),
		crowned = info.crowned == true,
		-- Phase 5: a player team's bench (the static slot of a helper), its role, buff and element attack
		bench = tonumber(info.bench),
		benched = tonumber(info.bench) ~= nil,
		role = info.role,
		lives = nil,
		windup = false,
		mine = mine,
		ally = ally,
		x = 0,
		z = 0,
		seen = false,
		yaw = 0,
		hp = max(1, num(info.maxHp, 100)),
		state = 0,
		meter = 0,
		shield = 0,
		phase = math.random() * TAU,
		animOpts = { Flap = 1, Excited = 0 },
		bossOpts = { CFrame = nil, Progress = 0, Attack = nil, Enraged = false },
		pose = "Idle",
		poseAt = 0,
		poseDur = 0,
	}
	B.units[id] = u
	B.list[#B.list + 1] = u
	if u.isBoss then
		B.boss = u
	end
	if mine and u.slot >= 1 and u.slot <= 4 then
		B.mine[u.slot] = u
	end
	B.buildQueue[#B.buildQueue + 1] = u
	return u
end

-- a Spawn / Wave event's unit infos (server order: they may come after "Start"); a new unit whose info says Arrive > 0
-- (seconds) arrives: EvolutionFx.Arrive at its spot, the model hidden until the flash, then a hop (Units.Arrival)
function Units.AddList(B, list)
	for _, info in ipairs(type(list) == "table" and list or {}) do
		local known = type(info) == "table" and B.units[tonumber(info.id) or -1] ~= nil
		local u = Units.Add(B, info)
		if u and not known then
			local arrive = type(info) == "table" and tonumber(info.Arrive or info.arrive) or nil
			if arrive and arrive > 0 and not u.mine then
				u.arrive = min(arrive, 4)
			end
		end
	end
end

function Units.Destroy(u)
	if u.arriveFx then
		if not u.arriveFx.Done then
			pcall(u.arriveFx.Stop)
		end
		u.arriveFx = nil
	end
	if u.flash then
		u.flash.hl.Adornee = nil
	end
	Cards.Free(u)
	for _, key in ipairs({ "shieldPart", "icePart", "focusMark" }) do
		local p = u[key]
		if p then
			pcall(p.Destroy, p)
			u[key] = nil
		end
	end
	if u.model then
		pcall(u.model.Destroy, u.model)
	end
	u.model = nil
	u.root = nil
	u.bar = nil
	u.gone = true
end

function Units.Remove(B, id)
	local u = B.units[id]
	if not u then
		return
	end
	B.units[id] = nil
	for i, v in ipairs(B.list) do
		if v == u then
			table.remove(B.list, i)
			break
		end
	end
	for slot, v in pairs(B.mine) do
		if v == u then
			B.mine[slot] = nil
		end
	end
	if B.boss == u then
		B.boss = nil
	end
	Atk.Cancel(u.id) -- its own attack effects and its pose end with it
	Units.Destroy(u)
end

-- the pixel HP bar above a unit (no text: World text rule only covers text)
local function addBar(u, adornee, height)
	local color = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
	local w, h = Theme.ScaledSize(74, 50), Theme.ScaledSize(11, 8)
	local gui = make("BillboardGui", {
		Name = "HpBar",
		Adornee = adornee,
		Size = UDim2.fromOffset(w, h),
		StudsOffset = Vector3.new(0, height, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
	})
	-- (world signs kit-b, audit item 31: the rounded navy track went) a square sunk well (the Well face) in a mitred wood
	-- edge, inset by that edge (drawn outside it) so the billboard keeps it, its WellEdge lip along the bottom; the fill a
	-- square block over it (its size stays the caller's: UDim2.new(frac, -2, 1, -2) at 1, 1) with its own lip: the ink at
	-- 0.68 over the fill's colour, which is exactly WorldTag.LipOf(that colour) and follows a recolour of the fill. The
	-- bar's weight is SignKit's Micro (the kit's one weight for a bar on a world billboard: PetCard's HP row)
	local WorldTag = require(Shared:WaitForChild("WorldTag"))
	local micro = SignKit.Sizes.Micro
	local edge, lip = micro.Edge, micro.Lip
	local back = make("Frame", {
		Name = "Back",
		Position = UDim2.fromOffset(edge, edge),
		Size = UDim2.new(1, -2 * edge, 1, -2 * edge),
		BorderSizePixel = 0,
	}, gui)
	WorldTag.Block(back, SIGN.Well, SIGN.WellEdge, SIGN.Wood, edge, lip)
	local fill = make("Frame", {
		Name = "Fill",
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		ZIndex = back.ZIndex + 1,
	}, back)
	make("Frame", {
		Name = "Lip",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, lip),
		BackgroundColor3 = SIGN.Text,
		BackgroundTransparency = 0.68,
		BorderSizePixel = 0,
		ZIndex = fill.ZIndex,
	}, fill)
	gui.Parent = u.model
	u.bar = gui
	u.barFill = fill
	u.barFrac = 1
end
Units._AddBar = addBar -- TESTS ONLY (tools/smoke_p3_battleclient.lua: the fallback bar's kit look, a build without PetCard)

-- builds one unit's model (pcall'd by the caller)
local function buildUnit(B, u)
	if u.isBoss then
		local BB = lazyBoss()
		if not BB then
			error("BossBuilder is missing")
		end
		local cf = worldFrame(B, u.x, 0, u.z, u.yaw)
		-- a raid boss wears its fight's tier: colours, size (as the sim's radius grows), aura (none on Graphics Low)
		local tier = B.Raid and B.Raid.Tier or nil
		local model = BB.Build(u.bossId, { Detail = "High", CFrame = cf, Tier = tier, NoAura = tier ~= nil and Me.LowGraphics() })
		if not model then
			error("BossBuilder.Build returned nil for " .. tostring(u.bossId))
		end
		local okH, h = pcall(BB.GetHeight, model)
		u.height = (okH and num(h, 20)) or 20
		u.model = model
		u.root = model.PrimaryPart or model:FindFirstChild("Root")
		model.Parent = B.folder
		if B.enraged then
			pcall(BB.SetEnraged, model, true)
		end
		return
	end
	if not PetBuilder then
		error("PetBuilder is missing")
	end
	local def = Units.Def(u.info)
	if not def then
		error("no definition for unit " .. tostring(u.id))
	end
	if u.crowned then
		def = Ring.Crowned(def) -- the ring champion wears PetBuilder's voxel crown
	end
	-- evolved units use the Low evolved form (within the petEvoLow / petEvo2Low budgets), like evolved followers;
	-- Phase 5 (10.3): my fighter High, my helpers Low (a helper swapped in is rebuilt at High: Units.Rebuild)
	-- (fix round 2, I2-b) a held auto-swap's incoming pet (unbenchAt) is my next fighter: High while it waits
	local detail = (u.mine and u.evo == 0 and (not u.benched or u.unbenchAt ~= nil)) and "High" or "Low"
	-- dungeon enemies wear the Wild look (contract 5.6 / C13): darker, tinted toward the floor's element, Neon eyes
	local wild = nil
	if u.info.wild and not u.ally then
		local c = elementColor((B.Dungeon and B.Dungeon.Element) or u.element)
		wild = { Tint = Theme.Darken(c, 0.35), Eyes = Theme.Lighten(c, 0.15) }
	end
	local model = PetBuilder.Build(def, { Scale = K.PET_SCALE * u.scale, Detail = detail, Evolved = u.evo > 0 and u.evo or nil, Wild = wild })
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then
		model:Destroy()
		error("pet model without a root")
	end
	local okSize, size = pcall(model.GetExtentsSize, model)
	u.height = (okSize and typeof(size) == "Vector3") and size.Y or 3.5
	u.centerY = u.height / 2 + K.HOVER
	u.pbScale = num(model:GetAttribute("PB_Scale"), K.PET_SCALE * u.scale) -- (the pose body offsets are studs at scale 1)
	-- weld at the built pose FIRST, then move: a pose is one root CFrame write from here on
	local okWeld = pcall(weldStatic, model, root)
	u.rigid = okWeld
	-- the parts PetBuilder.Animate poses (still anchored after the weld): moved with the root on a strided frame
	u.loose = {}
	u.looseBuf = {}
	if okWeld then
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") and part ~= root and part.Anchored then
				u.loose[#u.loose + 1] = part
			end
		end
	end
	local cf = worldFrame(B, u.x, u.centerY, u.z, u.yaw)
	if okWeld then
		root.CFrame = cf
	else
		pcall(model.PivotTo, model, cf)
	end
	local old = u.model
	u.model = model
	u.root = root
	u.folder = B.folder
	u.detail = detail
	model.Name = "Unit_" .. tostring(u.id)
	model:SetAttribute("BC_Evo", u.evo)
	model:SetAttribute("BC_Detail", detail)
	if old then
		-- a rebuild (a helper that became my fighter): the card moves over, the old model goes
		u.rebuild = nil
		if u.card and u.card.Gui then
			u.card.Gui.Parent = model
			pcall(u.card.SetAdornee, u.card, root, (u.height or 3) / 2 + 0.9)
		end
		if u.flash then
			u.flash.hl.Adornee = nil
		end
		pcall(old.Destroy, old)
		u.parked = false
	else
		Cards.Add(B, u, root)
	end
	model.Parent = B.folder
end

-- my new fighter (a swap) is drawn at High detail: rebuilt by the build queue under its time budget
function Units.Rebuild(B, u)
	if u and u.model and u.detail == "Low" and u.evo == 0 and not u.isBoss and not u.rebuild then
		u.rebuild = true
		B.buildQueue[#B.buildQueue + 1] = u
	end
end

-- (evolved forms) a Rally's bigger pet (AttackFx Hooks.AuraScale, k = 1: its size again): Model:ScaleTo x k over the size it had. A look only: the unit's radius, range and hitboxes are the sim's
function Units.AuraScale(u, k)
	local m = u.model
	if not m or u.gone then
		u.auraBase = nil
		return
	end
	if k == 1 then
		if u.auraBase then
			pcall(m.ScaleTo, m, u.auraBase)
			u.auraBase = nil
		end
		return
	end
	if not u.auraBase then
		local ok, s = pcall(m.GetScale, m)
		u.auraBase = (ok and tonumber(s)) or 1
	end
	pcall(m.ScaleTo, m, u.auraBase * k)
end

-- Phase 6 (runtime-pets): when MeshLibrary makes a pet's Blender mesh keys usable here (PetBuilder.MeshVersion
-- changes), its Part-built units are queued for a rebuild as mesh pets (KO'd / parked ones stay as they are)
function Units.MeshSweep(B)
	local ver = PetBuilder.MeshVersion()
	if ver == B.meshVer then
		return
	end
	B.meshVer = ver
	local ids = {}
	for id in pairs(B.units) do
		ids[#ids + 1] = id
	end
	table.sort(ids, function(a, b)
		return tostring(a) < tostring(b)
	end)
	for _, id in ipairs(ids) do
		local u = B.units[id]
		if u.model and not u.isBoss and not u.rebuild and not u.parked and not u.gone and PetBuilder.NeedsMeshRebuild(u.model) then
			u.rebuild = true
			B.buildQueue[#B.buildQueue + 1] = u
		end
	end
	-- the helpers' portraits (ViewportFrames) too
	for _, H in ipairs(Hud.helpers or {}) do
		if H.unit and H.model and PetBuilder.NeedsMeshRebuild(H.model) then
			H.built = false
			pcall(Hud.Portrait, H, H.unit)
		end
	end
end

function Units.BuildPending(B)
	if PetBuilder and PetBuilder.MeshVersion and B.units then
		Units.MeshSweep(B)
	end
	local q = B.buildQueue
	if #q == 0 then
		return
	end
	local t0 = os.clock()
	local built = 0
	while #q > 0 and built < K.BUILD_MAX do
		if built > 0 and os.clock() - t0 > K.BUILD_BUDGET then
			break
		end
		local u = table.remove(q, 1)
		if u.benched and not u.mine and not u.isBoss and not u.unbenchAt then
			u.needBuild = true -- another player's helper: not drawn while it sits on the bench
		elseif not u.gone and (not u.model or u.rebuild) then
			local ok, err = pcall(buildUnit, B, u)
			if not ok then
				warnOnce("build_" .. tostring(u.kind) .. tostring(u.info and (u.info.key or u.info.boss)), "could not build unit " .. tostring(u.name) .. ": " .. tostring(err))
				u.failed = true
			end
			built = built + 1
			St.perf.builds = St.perf.builds + 1
		end
	end
end

-- a pet's KO: poof, then the model is parked until the end
local function parkUnit(u, parked)
	if not u.model then
		return
	end
	if parked and not u.parked then
		u.parked = true
		u.model.Parent = nil
	elseif not parked and u.parked then
		u.parked = false
		u.model.Parent = u.folder or u.model.Parent
	end
end

function Units.SetPose(u, pose, dur, attackId)
	u.pose = pose
	u.poseAt = os.clock()
	u.poseDur = dur or 0
	if attackId then
		u.attackId = attackId
	end
end

-- per-frame update of one unit (position from the snapshots, facing, lunge / hop, animation)
local function updateUnit(B, u, now, dt, sa, sb, alpha, animate)
	return Units.Update(B, u, now, dt, sa, sb, alpha, animate)
end

function Units.Update(B, u, now, dt, sa, sb, alpha, animate)
	local a = sa and sa.Units[u.id]
	local b = sb and sb.Units[u.id]
	local x, z = u.x, u.z
	if type(a) == "table" and type(b) == "table" then
		x = a.x + (b.x - a.x) * alpha
		z = a.z + (b.z - a.z) * alpha
	elseif type(a) == "table" then
		x, z = a.x, a.z
	elseif type(b) == "table" then
		x, z = b.x, b.z
	end
	local d = (alpha >= 0.5 and type(b) == "table" and b) or (type(a) == "table" and a) or (type(b) == "table" and b) or nil
	if d then
		local hp, state = num(d.hp, u.hp), num(d.state, u.state)
		-- (Task 11b) a late Special's hit (or a caster's last gasp) not landed yet: the drawn HP never drops under its
		-- hold and the unit is not drawn down before it (Units.Hold); the snapshots already carry the new HP
		if u.holdUntil then
			if now < u.holdUntil then
				if u.holdHp and hp < u.holdHp then
					hp = u.holdHp
				end
				if state == S_DOWN then
					state = u.holdState or STATES.Idle or 0
				end
			else
				Units.Unhold(u)
			end
		end
		u.hp = hp
		u.state = state
		u.target = d.target
		u.meter = num(d.meter, 0)
		u.shield = num(d.shield, 0)
		-- Phase 5: the team's lives, the wind-up bit, the bench
		if d.lives ~= nil then
			u.lives = num(d.lives, u.lives)
		end
		local winding = d.windup == true
		if winding and not u.windup and not u.ally then
			Fx.Flash(u, COLORS.Windup, K.WINDUP_FLASH) -- the dash cue
		end
		if winding and not u.windup then
			u.windAt = now -- (the held Windup pose gathers from here: Atk.PoseOf)
		end
		u.windup = winding
		local onBench = u.state == S_BENCHED
		local benched = onBench
		-- (fix round 2, I2-b) the incoming pet of a held auto-swap stays on the bench until its Swap plays (the handler
		-- unbenches it; UNBENCH_SLACK is the fall-back): another player's is built meanwhile, still parked
		if u.unbenchAt then
			if now < u.unbenchAt then
				benched = true
			else
				u.unbenchAt = nil
			end
		end
		if benched ~= u.benched then
			u.benched = benched
		end
		if not onBench and not u.model and u.needBuild and not u.failed then
			u.needBuild = nil
			B.buildQueue[#B.buildQueue + 1] = u
		end
		if u.mine and d.lives ~= nil and B.Fighter and not benched and (B.fighterId == nil or u.id == B.fighterId) then
			B.lives = u.lives -- (only the fighter's record carries the team's lives)
		end
	end
	x, z = num(x, u.x), num(z, u.z)
	local mx, mz = x - u.x, z - u.z
	if not u.seen then
		u.seen = true
		mx, mz = 0, 0
		-- face the floor centre at first
		u.yaw = yawToward(-x, -z)
	end
	u.x, u.z = x, z
	if u.arrive and Units.Arrival(B, u, now) then
		return -- still arriving: the model stays hidden until the flash
	end
	if not u.model then
		return
	end
	if u.benched and not u.mine and not u.isBoss then
		parkUnit(u, true) -- another player's helper is not drawn (B3)
		return
	end
	local down = u.state == S_DOWN or u.hp <= 0
	if u.isBoss then
		Units.UpdateBoss(B, u, now, down, dt)
		return
	end
	if u.card and (u.cardHp ~= u.hp or u.cardMeter ~= u.meter or u.cardLives ~= u.lives) then
		Cards.Live(u) -- only when the snapshot changed the HP / meter (at most 10 Hz), never a write per frame
	end
	-- downed pets: poof once, then park (AttackFx's Ko: the poof played, the pet tumbles and lies until KO_PARK_FX)
	if down then
		if not u.downAt then
			u.downAt = now
			if not u.poofed then
				u.poofed = true
				local pos = worldPoint(B, x, u.centerY or 1.5, z)
				Fx.Burst(pos, Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
			end
		end
		if now - u.downAt >= (u.koAt and K.KO_PARK_FX or K.KO_PARK) then
			parkUnit(u, true)
		end
		if not u.koAt or u.parked then
			return
		end
	else
		-- AttackFx's Ko plays when the KO event ARRIVES, before the render clock draws the pet down: only a pet that was
		-- drawn down and is up again (a revive), or a KO no snapshot confirmed within KO_CONFIRM, ends its Ko pose
		if u.koAt and (u.downAt or now > u.koAt + K.KO_CONFIRM) then
			u.koAt = nil
			u.poofed = nil
			Atk.Cancel(u.id)
		end
		if u.downAt or u.parked then
			u.downAt = nil
			u.poofed = nil -- (up again: its next KO poofs)
			parkUnit(u, false)
		end
	end
	u.accDt = (u.accDt or 0) + dt
	if u.mine and B.Fighter and not B.ended then
		u.accDt = 0
		return Me.Draw(B, u, now, dt, x, z) -- my fighter at my shoulder, my helpers behind me
	end
	if u.parked then
		return
	end
	-- every frame: the root (interpolated position + facing), so a far / crowded pet never stutters; the stride
	-- (animate = false) only skips the pose work (PetBuilder.Animate), its loose parts ride along (Units.CarryLoose)
	if animate then
		u.posed = true
	end
	u.accDt = 0
	-- facing: the target while fighting, else the way it moves
	local want = nil
	local tgt = u.target and B.units[u.target]
	if tgt and (u.state == S_ATTACKING or u.state == S_CASTING or mx * mx + mz * mz < 0.0004) then
		want = yawToward(tgt.x - x, tgt.z - z)
	elseif mx * mx + mz * mz > 0.0004 then
		want = yawToward(mx, mz)
	end
	if want and u.state ~= S_STUNNED then
		local k = 1 - exp(-K.FACE_RATE * dt)
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * k
	end
	-- lunge / recoil / hop
	local ox, oz, oy = 0, 0, 0
	if u.lungeAt then
		local p = (now - u.lungeAt) / K.LUNGE_TIME
		if p >= 1 then
			u.lungeAt = nil
		elseif not u.lungeFx then -- (AttackFx's Strike pose replaces the lunge / recoil of an attack it played)
			local amt = sin(p * pi) * (u.ranged and -K.RECOIL_DIST or K.LUNGE_DIST)
			ox, oz = u.lungeX * amt, u.lungeZ * amt
		end
	end
	if u.hopAt then
		local p = (now - u.hopAt) / K.HOP_TIME
		if p >= 1 then
			u.hopAt = nil
		elseif p > 0 then
			oy = sin(p * pi) * K.HOP_HEIGHT
		end
	end
	if u.hurtAt then
		local p = (now - u.hurtAt) / 0.18
		if p >= 1 then
			u.hurtAt = nil
		elseif not u.hurtFx then -- (AttackFx's Hurt pose replaces the nudge)
			local amt = sin(p * pi) * 0.3
			ox, oz = ox + (u.hurtX or 0) * amt, oz + (u.hurtZ or 0) * amt
		end
	end
	if u.dashAt then
		local amt = K.DASH_DIST * Me.DashAmount(u, now)
		ox, oz = ox + (u.dashX or 0) * amt, oz + (u.dashZ or 0) * amt
	end
	local bob = 0
	local stunned = u.state == S_STUNNED or down
	if not stunned then
		bob = sin(now * 3.1 + u.phase) * K.BOB
	end
	if u.windup and not Atk.Drives(u) then
		oy = oy - 0.35 -- the wind-up crouch (Winding: the dash cue; AttackFx shows its held Windup pose instead)
	end
	local cf = worldFrame(B, x + ox, (u.centerY or 1.5) + bob + oy, z + oz, u.yaw)
	local pose, body = Atk.PoseOf(u, now, down, false, animate, cf.Position)
	if body then
		cf = cf * body
	end
	if u.rigid then
		if not animate or u.animBroken or not PetBuilder then
			Units.CarryLoose(u, cf) -- no Animate this frame: the wings / animated parts keep their pose on the root
		end
		u.root.CFrame = cf
	else
		pcall(u.model.PivotTo, u.model, cf)
	end
	if animate and PetBuilder and not u.animBroken then
		local opts = u.animOpts
		opts.Flap = stunned and 0 or ((u.state == S_DASHING or mx * mx + mz * mz > 0.0004) and 1.8 or 1)
		opts.Excited = u.windup and 1 or ((u.state == S_ATTACKING or u.state == S_CASTING) and 0.6 or 0)
		opts.Pose = pose
		local ok = pcall(PetBuilder.Animate, u.model, now + u.phase, opts)
		if not ok then
			u.animBroken = true
		end
	end
	-- the HP bar (only when it changes)
	local frac = clamp(u.hp / u.maxHp, 0, 1)
	if u.barFill and abs(frac - (u.barFrac or -1)) > 0.004 then
		u.barFrac = frac
		u.barFill.Size = UDim2.new(max(frac, 0.02), -2, 1, -2)
	end
	-- shield cube and ice crystals follow the unit
	Units.UpdateStatus(B, u, now, cf)
end

-- a strided frame (no PetBuilder.Animate): the root moves to cf and the anchored animated parts (wings, tails...) move
-- rigidly with it, keeping their last pose (one BulkMoveTo, a reused buffer: no table per frame)
function Units.CarryLoose(u, cf)
	local list = u.loose
	local n = list and #list or 0
	if n == 0 then
		return
	end
	local delta = cf * u.root.CFrame:Inverse()
	local buf = u.looseBuf
	for i = 1, n do
		buf[i] = delta * list[i].CFrame
	end
	local ok = pcall(workspace.BulkMoveTo, workspace, list, buf, Enum.BulkMoveMode.FireCFrameChanged)
	if not ok then
		for i = 1, n do
			list[i].CFrame = buf[i]
		end
	end
end

-- client/Controllers/EvolutionFx (the arrival effect); nil when missing
function Units.EvoFx()
	if Mods.Evo == nil then
		Mods.Evo = optional(script.Parent, "EvolutionFx") or false
	end
	local m = Mods.Evo
	return (m and type(m.Arrive) == "function") and m or nil
end

-- dungeon fixes (decision 3): an arriving enemy (Units.AddList, info Arrive > 0). Its first frame with a position
-- starts EvolutionFx.Arrive at its spot (effects only: rune ring, pillar, flash, sparkles, shock ring, sparks; Low
-- graphics = flash + ring); the model stays out of the world until the flash, then pops in with a hop. The server
-- keeps it inert and unhittable meanwhile (arriveUntil). -> true while the model is hidden (skip the frame)
function Units.Arrival(B, u, now)
	if u.isBoss then
		u.arrive = nil
		return false
	end
	if not u.arriveFx and not u.arriveShown then
		local fx = Units.EvoFx()
		local h = u.height or (3.2 * u.scale * K.PET_SCALE)
		local c = elementColor((B.Dungeon and B.Dungeon.Element) or u.element)
		local ok, handle = false, nil
		if fx then
			ok, handle = pcall(fx.Arrive, worldFrame(B, u.x, u.centerY or (h / 2 + K.HOVER), u.z, 0), {
				Parent = fxFolder(),
				Colors = { c, Theme.Lighten(c, 0.55) },
				Height = h,
				Radius = max(1, u.radius),
				Ground = worldPoint(B, u.x, 0, u.z).Y,
				Seconds = u.arrive,
				OnFlash = function()
					u.arriveShown = true
				end,
			})
		end
		if not ok or type(handle) ~= "table" then
			u.arrive = nil -- no effect module: the pet is simply there
			return false
		end
		u.arriveFx = handle
		St.arrivals = (St.arrivals or 0) + 1
	end
	if not u.arriveShown then
		u.hidden = true
		if u.model and u.model.Parent then
			u.model.Parent = nil
		end
		return true
	end
	-- the flash: the pet pops in
	u.arrive = nil
	u.hidden = nil
	if u.model and not u.model.Parent and not u.parked then
		u.model.Parent = u.folder or B.folder
	end
	u.hopAt = now
	return false
end

-- Phase 6: the Blender fx meshes (fx_shield / fx_ice / fx_arrow, creatures class) once they are usable on this
-- device: Units.FxMesh(key, scale) -> the MeshParts of a fresh rootless Assemble (sorted by name, Anchored, no
-- collisions) or nil (= the Part build). Same slot names and the same per-frame CFrame code either way.
function Units.FxMesh(key, scale)
	if Mods.Mesh == nil then
		Mods.Mesh = optional(Shared, "MeshLibrary") or false
	end
	local ML = Mods.Mesh
	if not ML or type(ML.Active) ~= "function" or not ML.Active() or not ML.IsReady(key) then
		return nil
	end
	local ok, model = pcall(ML.Assemble, key, nil, { Scale = scale or 1 })
	if not ok or typeof(model) ~= "Instance" then
		return nil
	end
	local parts = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			parts[#parts + 1] = d
		end
	end
	table.sort(parts, function(a, b)
		return a.Name < b.Name
	end)
	for _, d in ipairs(parts) do
		d.Parent = nil
		d.Anchored = true
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
		d.CastShadow = false
	end
	model:Destroy()
	if #parts == 0 then
		return nil
	end
	return parts
end

-- shield bubble (while the snapshot reports a shield) and ice (while stunned)
function Units.UpdateStatus(B, u, now, cf)
	local h = u.height or 3
	if u.shield > 0 then
		local p = u.shieldPart
		if not p then
			local mesh = Units.FxMesh("fx_shield")
			if mesh then
				-- the voxel bubble: one MeshPart sized like the Part cube (MeshPart.Size scales the mesh)
				p = mesh[1]
				p.Name = "ShieldCube"
				p.Size = Vector3.new(h * 1.25, h * 1.15, h * 1.25)
				p.Color = COLORS.Shield
				for i = 2, #mesh do
					mesh[i]:Destroy()
				end
				p.Parent = u.model
				u.shieldPart = p
			end
		end
		if not p then
			p = make("Part", {
				Name = "ShieldCube",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.ForceField,
				Color = COLORS.Shield,
				Transparency = 0,
				Size = Vector3.new(h * 1.25, h * 1.15, h * 1.25),
			}, u.model)
			u.shieldPart = p
		end
		p.CFrame = cf * CFrame.Angles(0, now * 0.8, 0)
	elseif u.shieldPart then
		u.shieldPart:Destroy()
		u.shieldPart = nil
	end
	local iced = u.state == S_STUNNED or (u.iceUntil and now < u.iceUntil)
	if iced then
		local p = u.icePart
		if not p then
			p = make("Model", { Name = "Ice" }, u.model)
			for i = 1, 5 do
				local a = (i / 5) * TAU
				local s = h * (0.28 + 0.06 * (i % 3))
				-- Phase 6: a Blender ice crystal (fx_ice, 1.1 tall) when ready: its main part is the "Crystal" the
				-- per-frame code moves, the light core rides on it (welded child, also named Crystal)
				local mesh = Units.FxMesh("fx_ice", s * 1.4 / 1.1)
				if mesh then
					local main = mesh[1]
					main.Name = "Crystal"
					main:SetAttribute("Angle", a)
					for k = 2, #mesh do
						local c = mesh[k]
						c.Name = "Crystal"
						c.Anchored = false
						c.Massless = true
						local weld = make("WeldConstraint", { Part0 = main, Part1 = c }, c)
						weld.Name = "IceWeld"
						c.Parent = main
					end
					main.Parent = p
				end
				if not mesh then
					make("Part", {
						Name = "Crystal",
						Anchored = true,
						CanCollide = false,
						CanQuery = false,
						CanTouch = false,
						CastShadow = false,
						Material = Enum.Material.Glass,
						Color = COLORS.Ice,
						Transparency = 0.35,
						Size = Vector3.new(s * 0.45, s * 1.4, s * 0.45),
					}, p):SetAttribute("Angle", a)
				end
			end
			u.icePart = p
		end
		local r = (u.radius or 1.8) * 0.75 * K.PET_SCALE * 0.6
		for _, c in ipairs(p:GetChildren()) do
			local a = c:GetAttribute("Angle") or 0
			c.CFrame = cf * CFrame.new(cos(a) * r, -h * 0.25, sin(a) * r) * CFrame.Angles(0.35 * cos(a), a, 0.35 * sin(a))
		end
	elseif u.icePart then
		u.icePart:Destroy()
		u.icePart = nil
	end
end

-- the raid boss: BossBuilder poses on the interpolated position
function Units.UpdateBoss(B, u, now, down, dt)
	local BB = lazyBoss()
	if not BB then
		return
	end
	local tgt = u.target and B.units[u.target]
	local want = nil
	if u.faceX then
		want = yawToward(u.faceX - u.x, u.faceZ - u.z)
	elseif tgt then
		want = yawToward(tgt.x - u.x, tgt.z - u.z)
	end
	if want and not down then
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * (1 - exp(-3 * (dt or 0.016)))
	end
	local pose = u.pose
	local progress = 0
	if down then
		if pose ~= "Down" then
			Units.SetPose(u, "Down", 1.6)
			pose = "Down"
		end
	end
	if u.poseDur > 0 then
		progress = clamp((now - u.poseAt) / u.poseDur, 0, 1)
		if progress >= 1 and pose ~= "Down" and pose ~= "Windup" then
			Units.SetPose(u, "Idle", 0)
			pose = "Idle"
			u.faceX, u.faceZ = nil, nil
		end
	end
	if pose == "Windup" and u.windupAt then
		progress = clamp((B.renderT - u.windupFrom) / max(0.1, u.windupAt - u.windupFrom), 0, 1)
	end
	local opts = u.bossOpts
	opts.CFrame = worldFrame(B, u.x, 0, u.z, u.yaw)
	opts.Progress = progress
	opts.Attack = u.attackId
	opts.Enraged = B.enraged
	local ok, err = pcall(BB.Animate, u.model, pose, now, opts)
	if not ok then
		warnOnce("bossanim", "BossBuilder.Animate failed: " .. tostring(err))
	end
end

-- the world point of a unit's body centre (effects, numbers)
local function unitCenter(B, u)
	if u.mine and u.drawn and B.Fighter and not u.parked then
		return u.drawn -- my fighter / helpers are drawn at my character, not at the server spot
	end
	local y = u.isBoss and (u.height or 20) * 0.55 or (u.centerY or 1.5)
	return worldPoint(B, u.x, y, u.z)
end

----------------------------------------------------------------------
-- Phase 5 (4.7 Models): my fighter at my character's shoulder, my helpers behind me, the camera shake
----------------------------------------------------------------------
-- the character's HumanoidRootPart (nil without one)
function Me.Root()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") and root.Parent then
		return root
	end
	return nil
end

-- a zone-local direction (x, z) as a world vector (the zone's rotation)
local function zoneDir(B, x, z)
	local b = B.basis
	return Vector3.new(b[4] * x + b[6] * z, b[7] * x + b[9] * z, b[10] * x + b[12] * z)
end

-- the frame-rate independent share of a per-60-Hz-frame lerp
local function lerpShare(perFrame, dt)
	return 1 - (1 - perFrame) ^ (clamp(dt, 0, 0.25) * 60)
end

-- where my fighter is drawn: the shoulder of the SERVER fighter position (x, z), blended toward the character root
-- while the two are within BLEND_DIST studs (so what looks in reach IS in reach); returns the target and the share
function Me.FighterTarget(B, u, x, z)
	local server = worldPoint(B, x, u.centerY or 1.5, z)
	local root = Me.Root()
	if not root then
		return server, K.FOLLOW_LERP, nil
	end
	local rcf = root.CFrame
	local rp = rcf.Position
	local dx, dz = rp.X - server.X, rp.Z - server.Z
	local d = sqrt(dx * dx + dz * dz)
	local ax, az, share = server.X, server.Z, K.FOLLOW_LERP
	local k = 0
	if d <= K.BLEND_DIST then
		k = 1 - d / K.BLEND_DIST
		ax, az = server.X + dx * k, server.Z + dz * k
		share = 0.6
	end
	-- bug #22: the shoulder offset (and the character's height) fade with the blend share: at my side the pet sits on
	-- the shoulder as before; 2+ studs out (an ENGAGED pet fighting) it is drawn where the server has it
	local offW = rcf:VectorToWorldSpace(K.SHOULDER)
	local off = offW * k
	local y = server.Y + (rp.Y + offW.Y - server.Y) * k -- (the shoulder height scaled by k once, not k^2)
	return Vector3.new(ax + off.X, y, az + off.Z), share, rcf, d
end

-- a helper's spot behind me (index 1 / 2 = HELPER_A / HELPER_B); without a character behind the drawn fighter
function Me.HelperSpot(B, index)
	local off = (index == 2) and K.HELPER_B or K.HELPER_A
	local root = Me.Root()
	if root then
		return root.CFrame:PointToWorldSpace(off)
	end
	local f = B.fighterId and B.units[B.fighterId]
	local base = (f and f.drawn) or worldPoint(B, 0, 2, 0)
	return base + Vector3.new(off.X, off.Y - 0.5, off.Z)
end

-- the bench index (1 / 2) of my helper u, in slot order
function Me.HelperIndex(B, u)
	local i = 0
	for slot = 1, 4 do
		local h = B.mine[slot]
		if h and h.id ~= B.fighterId then
			i = i + 1
			if h == u then
				return i
			end
		end
	end
	return 1
end

-- per frame: my fighter / my helpers (positions + facing + bob + animation; the server never moves these parts)
-- wave 5 (bug #26): a dungeon fighter's first drawn spot is where its follower pet stood (PetController), so the pet
-- walks from the formation to the shoulder instead of popping there; nil = the shoulder as before
function Me.SeedFromFollower(B, u, target)
	if B.Mode ~= "Dungeon" or not LocalPlayer then
		return nil
	end
	if Mods.Pets == nil then
		Mods.Pets = optional(script.Parent, "PetController") or false
	end
	local pc = Mods.Pets
	if not pc or type(pc.GetFollowerInfo) ~= "function" then
		return nil
	end
	local ok, list = pcall(pc.GetFollowerInfo, LocalPlayer)
	if not ok or type(list) ~= "table" then
		return nil
	end
	local key = u.info and u.info.key
	for _, e in ipairs(list) do
		if e.Key == key and typeof(e.Model) == "Instance" then
			local okP, cf = pcall(e.Model.GetPivot, e.Model)
			if okP and typeof(cf) == "CFrame" and (cf.Position - target).Magnitude < 30 then
				return cf.Position
			end
		end
	end
	return nil
end

-- the active fighter unit of a player in battle B (mine: B.fighterId; others: their unit that is not on the bench)
function Me.FighterOf(B, userId)
	if userId == myUserId() and B.Fighter and B.fighterId and B.units[B.fighterId] then
		return B.units[B.fighterId]
	end
	for _, u in ipairs(B.list) do
		if u.owner == userId and not u.benched and u.side == 1 then
			return u
		end
	end
	return nil
end

function Me.SpotOf(u)
	if u.model and u.model.Parent then
		local ok, cf = pcall(u.model.GetPivot, u.model)
		if ok and typeof(cf) == "CFrame" then
			return cf.Position
		end
	end
	return u.drawn
end

-- before a dungeon floor goes: where every player's fighter was drawn (PetController's hand-over reads it)
function Me.RecordDrawn(B)
	local seen = {}
	for _, u in ipairs(B.list) do
		local uid = tonumber(u.owner)
		if uid and not seen[uid] then
			local f = Me.FighterOf(B, uid)
			if f then
				seen[uid] = true
				local pos = Me.SpotOf(f)
				if typeof(pos) == "Vector3" then
					St.lastDrawn[uid] = { Pos = pos, Key = f.info and f.info.key, At = os.clock() }
				end
			end
		end
	end
end

function Me.Draw(B, u, now, dt, x, z)
	if u.parked then
		return
	end
	local isFighter = u.id == B.fighterId or (B.fighterId == nil and not u.benched)
	local target, share, rcf, blendD
	if isFighter then
		target, share, rcf, blendD = Me.FighterTarget(B, u, x, z)
	else
		target, share = Me.HelperSpot(B, Me.HelperIndex(B, u)), 0.25
		-- a Buff: fly to the fighter and back (BUFF_FLY)
		if u.flyAt then
			local p = (now - u.flyAt) / K.BUFF_FLY
			local f = B.fighterId and B.units[B.fighterId]
			if p >= 1 or not f or not f.drawn then
				u.flyAt = nil
			else
				local k = sin(p * pi)
				target = target:Lerp(f.drawn + Vector3.new(0, 1.2, 0), k)
				share = 1
			end
		end
	end
	-- a swap: the two trade places along a little arc (SWAP_TIME)
	if u.swapAt and u.swapFrom then
		local p = (now - u.swapAt) / K.SWAP_TIME
		if p >= 1 then
			u.swapAt, u.swapFrom = nil, nil
		else
			local e = p * p * (3 - 2 * p)
			target = u.swapFrom:Lerp(target, e) + Vector3.new(0, sin(p * pi) * 1.6, 0)
			share = 1
		end
	end
	if not u.drawn then
		u.drawn = (isFighter and Me.SeedFromFollower(B, u, target)) or target
	else
		u.drawn = u.drawn:Lerp(target, lerpShare(share, dt))
	end
	-- facing: my fighter faces the enemy it fights (else where I look); helpers face where I look
	local want = nil
	local tgt = isFighter and ((u.target and B.units[u.target]) or (B.lock and B.units[B.lock])) or nil
	if tgt and tgt.model and not tgt.parked then
		local tp = unitCenter(B, tgt)
		local dx, dz = tp.X - u.drawn.X, tp.Z - u.drawn.Z
		if dx * dx + dz * dz > 0.01 then
			want = atan2(-dx, -dz)
		end
	end
	if not want then
		local look = (rcf or (Me.Root() and Me.Root().CFrame))
		if look then
			local lv = look.LookVector
			want = atan2(-lv.X, -lv.Z)
		end
	end
	u.wyaw = u.wyaw or (want or 0)
	if want and u.state ~= S_STUNNED then
		u.wyaw = u.wyaw + wrapAngle(want - u.wyaw) * (1 - exp(-K.FACE_RATE * dt))
	end
	-- the server's lunges (Hit events only: the pet attacks by itself, nothing is predicted) / hops / recoils and the
	-- pet's dash (zone-local -> world)
	local off = Vector3.new(0, 0, 0)
	if u.dashAt then
		off = off + zoneDir(B, u.dashX or 0, u.dashZ or 0) * (K.DASH_DIST * Me.DashAmount(u, now))
	end
	if u.lungeAt then
		local p = (now - u.lungeAt) / K.LUNGE_TIME
		if p >= 1 then
			u.lungeAt = nil
		elseif not u.lungeFx then -- (AttackFx's Strike pose replaces the lunge / recoil of an attack it played)
			off = off + zoneDir(B, u.lungeX or 0, u.lungeZ or 0) * (sin(p * pi) * (u.ranged and -K.RECOIL_DIST or K.LUNGE_DIST))
		end
	end
	if u.hopAt then
		local p = (now - u.hopAt) / K.HOP_TIME
		if p >= 1 then
			u.hopAt = nil
		elseif p > 0 then
			off = off + Vector3.new(0, sin(p * pi) * K.HOP_HEIGHT, 0)
		end
	end
	if u.hurtAt then
		local p = (now - u.hurtAt) / 0.18
		if p >= 1 then
			u.hurtAt = nil
		elseif not u.hurtFx then -- (AttackFx's Hurt pose replaces the nudge)
			off = off + zoneDir(B, u.hurtX or 0, u.hurtZ or 0) * (sin(p * pi) * 0.3)
		end
	end
	local down = u.state == S_DOWN or u.hp <= 0
	local stunned = u.state == S_STUNNED or down
	local bob = stunned and 0 or sin(now * 3.1 + u.phase) * K.BOB
	local p = u.drawn + off + Vector3.new(0, bob, 0)
	local cf = CFrame.new(p) * CFrame.Angles(0, u.wyaw, 0)
	-- no battle idle while my fighter moves under my input (or a helper flies / swaps)
	-- (bug #22: my walking only counts while the pet is at my side; an engaged pet keeps its battle idle)
	local busy = (isFighter and (u.state == S_MOVING or (Me.Walking() and (blendD == nil or blendD <= K.BLEND_DIST)))) or u.flyAt ~= nil or u.swapAt ~= nil
	-- a helper that only breathes (the battle idle) is posed every other frame, like the other pets (stepBattle)
	local animate = isFighter or u.poseSrc ~= "idle" or (St.frameNo + (u.slot or 0)) % 2 == 0
	local pose, body = Atk.PoseOf(u, now, down, busy, animate, p)
	if body then
		cf = cf * body
	end
	if u.rigid then
		if not animate then
			Units.CarryLoose(u, cf) -- (the wings keep their pose on the root this frame)
		end
		u.root.CFrame = cf
	else
		pcall(u.model.PivotTo, u.model, cf)
	end
	u.posed = true
	if animate and PetBuilder and not u.animBroken then
		local opts = u.animOpts
		local moving = rcf ~= nil and isFighter and u.state == S_MOVING
		opts.Flap = stunned and 0 or ((u.state == S_DASHING or u.dashAt or moving or u.flyAt) and 1.8 or 1)
		opts.Excited = (u.state == S_ATTACKING or u.state == S_CASTING) and 0.6 or 0
		opts.Pose = pose
		local ok = pcall(PetBuilder.Animate, u.model, now + u.phase, opts)
		if not ok then
			u.animBroken = true
		end
	end
	Units.UpdateStatus(B, u, now, cf)
end

local function moveDirection(hum)
	return hum.MoveDirection
end

-- the character walks under the player's input (Humanoid.MoveDirection)
function Me.Walking()
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then
		return false
	end
	local ok, dir = pcall(moveDirection, hum)
	return ok and typeof(dir) == "Vector3" and dir.Magnitude > 0.1
end

-- the zone-local direction (x, z) of a Dash event: ev.dir (an angle like Element's, or { x, z }), ev.dx / ev.dz, the
-- point ev.tx / ev.tz, else toward the pet's target / my lock, else where it faces (mine: where my character looks)
function Me.DashDir(B, u, ev)
	local dx, dz = nil, nil
	local dir = ev.dir
	if type(dir) == "number" then
		dx, dz = cos(dir), sin(dir)
	elseif type(dir) == "table" then
		dx, dz = tonumber(dir.x or dir.X or dir[1]), tonumber(dir.z or dir.Z or dir[2])
	end
	if not (dx and dz) and tonumber(ev.dx) and tonumber(ev.dz) then
		dx, dz = tonumber(ev.dx), tonumber(ev.dz)
	end
	if not (dx and dz) and tonumber(ev.tx) and tonumber(ev.tz) then
		dx, dz = tonumber(ev.tx) - u.x, tonumber(ev.tz) - u.z
	end
	if not (dx and dz) then
		local t = B.units[tonumber(ev.target) or u.target or (u.mine and B.lock) or -1]
		if t and t ~= u then
			dx, dz = t.x - u.x, t.z - u.z
		end
	end
	if not (dx and dz) and u.mine then
		local root = Me.Root()
		if root then
			-- world -> zone-local: the transpose of the zone's rotation
			local lv, b = root.CFrame.LookVector, B.basis
			dx, dz = b[4] * lv.X + b[7] * lv.Y + b[10] * lv.Z, b[6] * lv.X + b[9] * lv.Y + b[12] * lv.Z
		end
	end
	if not (dx and dz) then
		local yaw = u.wyaw or u.yaw or 0
		dx, dz = -sin(yaw), -cos(yaw)
	end
	local d = sqrt(dx * dx + dz * dz)
	if d < 1e-3 then
		return 0, -1
	end
	return dx / d, dz / d
end

-- starts the drawn dash of pet u (a streak out and back + a trail), once per event
-- my Swap: the incoming pet becomes my fighter (HUD, High detail), the out one goes to the bench, and the two trade
-- places along the SWAP_TIME arc from where they are drawn now. On the Swap's arrival (Net.Pre); a held auto-swap's
-- when it plays (fix round 2, I2-b: the KO'd fighter stays where it stood until its impact, and the arc starts from
-- the real spots: before, it started when the Swap played, after the pets had already slid most of the way)
function Me.Switch(B, ev)
	local old = B.fighterId
	B.fighterId = tonumber(ev["in"]) or B.fighterId
	local incoming = B.units[B.fighterId]
	if incoming then
		incoming.benched = false
		incoming.unbenchAt = nil
		B.fighterEvo = incoming.evo or 0
		Units.Rebuild(B, incoming)
	end
	local out = old and B.units[old]
	if out and out ~= incoming then
		out.benched = true
	end
	pcall(Hud.Rebuild)
	local now = os.clock()
	for _, u in ipairs({ incoming or false, out or false }) do
		if u and u.mine and u.drawn then
			u.swapFrom = u.drawn
			u.swapAt = now
		end
	end
end

function Me.StartDash(B, u, ev)
	u.dashEv = ev
	if not u.model or u.parked or u.hidden then
		return
	end
	u.dashX, u.dashZ = Me.DashDir(B, u, ev)
	u.dashAt = os.clock()
	local a = unitCenter(B, u)
	local b = a + zoneDir(B, u.dashX, u.dashZ) * K.DASH_DIST
	Fx.Trail(a, b, COLORS.Dodge, 6, K.DASH_TIME + 0.1)
	Fx.Burst(a, COLORS.Dodge, 8, 9, 0.4, 0.35, { up = 0.2, alpha = 0.2 })
	St.dashes = (St.dashes or 0) + 1
	if u.mine then
		Me.Sfx("Dash", 1) -- (audio wave 2) my own pets' dash only
	end
end

-- 0..1..0 of a running dash (quick out, a softer way back); clears it at the end
function Me.DashAmount(u, now)
	local p = (now - u.dashAt) / K.DASH_TIME
	if p >= 1 or p < 0 then
		u.dashAt = nil
		return 0
	end
	if p < 0.4 then
		local q = 1 - p / 0.4
		return 1 - q * q
	end
	local q = (p - 0.4) / 0.6
	return 1 - q * q * (3 - 2 * q)
end

-- client/MouseLock (the mouse lock option, a separate module: no hard dependency): Hold(reason) frees the cursor while
-- the result card / the LEAVE confirm is up, Release(reason) gives it back; idempotent per reason
function Me.MouseHold(reason, on)
	on = on == true
	if (St.mouseHolds[reason] == true) == on then
		return
	end
	if not Mods.MouseLock then
		local inst = Client:FindFirstChild("MouseLock")
		if inst then
			local ok, m = pcall(require, inst)
			Mods.MouseLock = (ok and type(m) == "table") and m or false
		end
	end
	local ML = Mods.MouseLock
	local fn = ML and ML[on and "Hold" or "Release"]
	if type(fn) == "function" then
		pcall(fn, reason)
	end
	St.mouseHolds[reason] = on or nil
end

-- the camera shake scale: ClientSettings.Get("Shake") (menu W3); 1 when the module is missing
function Me.ShakeScale()
	local hook = BattleController.Hooks.Shake
	if type(hook) == "function" then
		return hook() and 1 or 0
	end
	if Mods.Settings == nil then
		Mods.Settings = optional(Client, "ClientSettings") or false
	end
	local cs = Mods.Settings
	if cs and type(cs.Get) == "function" then
		local ok, v = pcall(cs.Get, "Shake")
		if ok then
			return v and 1 or 0
		end
	end
	return 1
end

-- a tiny, rare camera shake (my fighter hit hard / knocked out): Humanoid.CameraOffset, never the camera itself
function Me.Shake(amount, dur)
	local scale = Me.ShakeScale()
	St.shakeCount = (St.shakeCount or 0) + 1
	if scale <= 0 then
		return
	end
	local old = St.shake
	local now = os.clock()
	local amp = min(K.SHAKE_MAX, (amount or 0.2) * scale)
	-- (attack effects, 2026-11-01: every own attack kicks now) a small kick never cuts a stronger shake still playing
	if old and old.amp * (1 - (now - old.t0) / old.dur) > amp then
		return
	end
	St.shake = { t0 = now, dur = dur or 0.18, amp = amp, base = old and old.base, last = old and old.last, hum = old and old.hum }
	BattleController._wake()
end

function Me.UpdateShake(now)
	local sh = St.shake
	if not sh then
		return
	end
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	-- wave 5 (bug #15): the shake rides on the resting offset (the dungeon shoulder) and gives it back at the end; an
	-- offset someone else wrote meanwhile (DungeonController's shoulder on / off, a new character) becomes the base
	if hum then
		local cur = hum.CameraOffset
		if sh.hum ~= hum or sh.base == nil or sh.last == nil or (cur - sh.last).Magnitude > 1e-4 then
			sh.base = cur
			sh.hum = hum
		end
	end
	local p = (now - sh.t0) / sh.dur
	if p >= 1 or not hum then
		St.shake = nil
		if hum then
			hum.CameraOffset = sh.base or Vector3.new(0, 0, 0)
		end
		return
	end
	local a = sh.amp * (1 - p)
	local v = sh.base + Vector3.new(sin(now * 71) * a, cos(now * 63) * a * 0.6, 0)
	hum.CameraOffset = v
	sh.last = v
end

-- wave 5 (bug #15): a big attack (AttackFx's punch >= PUNCH_BIG: AttackFxCatalog.Kick decides, today a Legendary+ Special, a Rare / Epic
-- Special's crit, a Legendary+ element attack's crit, no basic hit) punches the FOV, in a
-- dungeon only; the Camera shake setting does NOT gate it (player ruling 2026-10-28: Shake OFF = only the hit shakes
-- go; the punch is a short zoom, not a shake). MovementController owns the FOV
function Me.FovPunch(amount)
	local B = St.battle
	amount = tonumber(amount) or 0
	if not B or B.Mode ~= "Dungeon" or amount < K.PUNCH_BIG then
		return false
	end
	local mc = Hud.Movement()
	if mc and type(mc.FovPunch) == "function" then
		local ok = pcall(mc.FovPunch, K.FOV_PUNCH * min(1, amount / 0.4), K.FOV_PUNCH_TIME)
		return ok
	end
	return false
end

-- AttackFx's screen hooks (own pets only, AttackFx decides when): a soft glow along the screen edges (a Secret pet's
-- hit), on its own ScreenGui UNDER the battle HUD; edge-only and see-through, never over the fight's centre (spec
-- "Never hide the fight"). Built on the first use. (A signature's battle dim is a Lighting preset since Task 11:
-- Me.Dim; the HUD is never darkened.)
function Me.ScreenFx()
	local g = St.screenFx
	if g and g.gui.Parent then
		return g
	end
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return nil
	end
	local gui = make("ScreenGui", { Name = "NimbusBattleFx", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = K.DISPLAY_ORDER - 3 })
	local edges = {}
	-- { position, size, gradient rotation (0 = opaque at the left) }: 9% of the height / 6% of the width deep
	for i, e in ipairs({
		{ UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.09), 90 },
		{ UDim2.fromScale(0, 0.91), UDim2.fromScale(1, 0.09), 270 },
		{ UDim2.fromScale(0, 0), UDim2.fromScale(0.06, 1), 0 },
		{ UDim2.fromScale(0.94, 0), UDim2.fromScale(0.06, 1), 180 },
	}) do
		local f = make("Frame", { Name = "Edge" .. i, Position = e[1], Size = e[2], BackgroundColor3 = COLORS.White, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false }, gui)
		make("UIGradient", { Rotation = e[3], Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
		edges[i] = f
	end
	gui.Parent = pg
	g = { gui = gui, edges = edges, glow = nil }
	St.screenFx = g
	return g
end

-- AttackFx.Hooks.ScreenGlow: the edges light up in `color` and fade over `seconds`
function Me.Glow(color, seconds)
	local g = Me.ScreenFx()
	if not g then
		return
	end
	g.glow = { t0 = os.clock(), dur = clamp(num(seconds, 0.35), 0.1, 1.5) }
	for _, f in ipairs(g.edges) do
		f.BackgroundColor3 = typeof(color) == "Color3" and color or COLORS.White
		f.Visible = true
	end
	BattleController._wake()
end

function Me.LowGraphics()
	if Mods.Gfx == nil then
		Mods.Gfx = optional(Client, "GraphicsQuality") or false
	end
	local gq = Mods.Gfx
	if gq and type(gq.Effective) == "function" then
		local ok, mode = pcall(gq.Effective)
		return ok and mode == "Low"
	end
	return false
end

-- an enraged raid boss: the same edges hold `color`, pulsing 0.35-0.55 at 1 Hz (steady 0.5 on Graphics Low), until EdgeHold(nil)
function Me.PaintHold(g, now)
	local a = Me.LowGraphics() and 0.5 or (0.45 + 0.1 * sin(now * 2 * pi))
	for _, f in ipairs(g.edges) do
		f.BackgroundColor3 = g.hold.color
		f.BackgroundTransparency = a
		f.Visible = true
	end
end

function Me.EdgeHold(color)
	if color == nil then
		local held = St.screenFx
		if held and held.hold then
			held.hold = nil
			if not held.glow then
				for _, f in ipairs(held.edges) do
					f.BackgroundTransparency = 1
					f.Visible = false
				end
			end
		end
		return
	end
	local g = Me.ScreenFx()
	if not g then
		return
	end
	g.hold = { color = color }
	Me.PaintHold(g, os.clock())
	BattleController._wake()
end

-- (Task 11) the battle dim's look: the world darker, a little desaturated and violet (Eclipse Nova's black sun); the
-- HUD and the effects' Neon stay bright. RELATIVE to the look under it (LightingStack.Value without the dim itself):
-- the arena (server ExposureCompensation -0.15, NimbusColor Brightness 0 / Saturation 0.14) -> -0.9 / -0.06 / -0.21,
-- and a dungeon battle (its own darker ColorCorrection) gets darker still, never brighter. Exposure / Brightness /
-- Saturation are added, the tint multiplies. LightingStack gives the look under it back on the Pop
Me.DIM_DELTA = { Exposure = -0.75, Brightness = -0.06, Saturation = -0.35, Tint = Color3.fromRGB(214, 198, 255) }

function Me.Lights()
	if Mods.Lights == nil then
		Mods.Lights = optional(Client, "LightingStack") or false
	end
	local ls = Mods.Lights
	return (ls and type(ls.Push) == "function" and type(ls.Pop) == "function") and ls or nil
end

-- the dim preset over what the battle shows now (a property whose instance is missing is left out)
function Me.DimPreset(ls)
	local d = Me.DIM_DELTA
	local function value(group, prop)
		if type(ls.Value) ~= "function" then
			return nil
		end
		local ok, v = pcall(ls.Value, group, prop, K.DIM_ID)
		return ok and v or nil
	end
	local preset = {}
	local exp = value("Lighting", "ExposureCompensation")
	if type(exp) == "number" then
		preset.Lighting = { ExposureCompensation = exp + d.Exposure }
	end
	local cc = {}
	local bri, sat, tint = value("ColorCorrection", "Brightness"), value("ColorCorrection", "Saturation"), value("ColorCorrection", "TintColor")
	if type(bri) == "number" then
		cc.Brightness = bri + d.Brightness
	end
	if type(sat) == "number" then
		cc.Saturation = max(-1, sat + d.Saturation)
	end
	if typeof(tint) == "Color3" then
		cc.TintColor = Color3.new(tint.R * d.Tint.R, tint.G * d.Tint.G, tint.B * d.Tint.B)
	end
	if next(cc) then
		preset.ColorCorrection = cc
	end
	return preset
end

-- AttackFx.Hooks.DimWorld (own pet only: AttackFx decides): the battle darkens for `seconds` (LightingStack preset
-- K.DIM_ID, in over DIM_IN; Me.UpdateScreenFx pops it over DIM_OUT when the time is up). `token` = the effect's own
-- token: Me.Undim(token) ends it early (that effect ended); `unit` = the caster's unit id: Me.UndimCaster(unit) ends it
-- on the caster's KO. A new dim replaces the old one (and its token: an older cast's end never lifts it).
function Me.Dim(seconds, token, unit)
	local ls = Me.Lights()
	if not ls then
		return false
	end
	if token == nil then
		token = true
	end
	St.dim = { t0 = os.clock(), dur = clamp(num(seconds, 0.6), 0.2, K.DIM_MAX), token = token, unit = unit }
	pcall(ls.Push, K.DIM_ID, Me.DimPreset(ls), K.DIM_IN)
	BattleController._wake()
	return true
end

-- the light comes back (over `fade` seconds, default DIM_OUT): token nil = whatever dims (a teardown), else only that
-- caster's dim. -> true when a dim ended
function Me.Undim(token, fade)
	local d = St.dim
	if not d or (token ~= nil and d.token ~= token) then
		return false
	end
	St.dim = nil
	local ls = Me.Lights()
	if ls then
		pcall(ls.Pop, K.DIM_ID, fade or K.DIM_OUT)
	end
	return true
end

-- the caster `unit` was knocked out: its battle dim (if the dim is its) ends now. -> true when a dim ended
function Me.UndimCaster(unit)
	local d = St.dim
	if not d or unit == nil or d.unit ~= unit then
		return false
	end
	return Me.Undim(d.token)
end

-- (Task 11b; original audio) the charges' own SoundFx sounds (Config.Audio.Sfx): "Inhale" = the inhale under a
-- Special's charge (PlaybackSpeed rising INHALE_PITCH[1] -> [2] to the release, a short fade in / out), "Shatter" = a
-- shattered charge. A missing id plays nothing and nothing breaks
function Me.Sound()
	if Mods.Sound == nil then
		Mods.Sound = optional(Client, "SoundFx") or false
	end
	return Mods.Sound or nil
end

-- (audio wave 2) the volume x a fight's one-shot plays at: 1 in my own fight, SFX_SPECTATOR for a spectator within
-- SFX_HEAR studs of the camera, nil (silent) further away
function Me.HearScale(B, u)
	if not B then
		return nil
	end
	if B.Fighter then
		return 1
	end
	local cam = workspace.CurrentCamera
	local ok, at = pcall(unitCenter, B, u)
	if not cam or not ok or typeof(at) ~= "Vector3" then
		return nil
	end
	if (cam.CFrame.Position - at).Magnitude > K.SFX_HEAR then
		return nil
	end
	return K.SFX_SPECTATOR
end

-- (audio wave 2) a fight's one-shot through SoundFx (a variant rotation with `variant`); a missing id is silent
function Me.Sfx(name, scale, variant)
	if not scale or scale <= 0 then
		return nil
	end
	local SF = Me.Sound()
	local fn = SF and (variant and SF.PlayVariant or SF.Play) or nil
	if type(fn) ~= "function" then
		return nil
	end
	local ok, s = pcall(fn, name, { Scale = scale })
	return ok and s or nil
end

-- AttackFx Hooks.Inhale: a token's first call starts the sound, a later one (the real Special taking over a press's
-- charge) retimes the same rise from where it is; others' pets at INHALE_OTHERS volume; INHALE_MAX at once
function Me.Inhale(seconds, token, mine)
	if token == nil then
		return false
	end
	seconds = clamp(num(seconds, 0), 0.05, 2)
	local rec = St.inhales[token]
	if not rec then
		local n, oldest = 0, nil
		for tk, r in pairs(St.inhales) do
			n = n + 1
			if not r.mine and (oldest == nil or r.start < St.inhales[oldest].start) then
				oldest = tk
			end
		end
		if mine and n >= K.INHALE_MAX and oldest ~= nil then
			Me.Hush(oldest) -- (fix round 1, M7) my own inhale (the cue this is for) never loses to others' pets'
			n = n - 1
		end
		local SF = n < K.INHALE_MAX and Me.Sound() or nil
		if not SF or type(SF.Play) ~= "function" then
			return false
		end
		local ok, s = pcall(SF.Play, "Inhale")
		if not ok or typeof(s) ~= "Instance" then
			return false
		end
		for tk, r in pairs(St.inhales) do
			if r.sound == s then
				St.inhales[tk] = nil -- (SoundFx's pool handed that sound out again)
			end
		end
		-- (fix round 2, M5') `start` (when it began) picks the oldest; t0 is the last retime
		rec = { sound = s, vol = s.Volume * (mine and 1 or K.INHALE_OTHERS), mine = mine == true, t0 = os.clock(), start = os.clock() }
		St.inhales[token] = rec
		s.PlaybackSpeed = K.INHALE_PITCH[1]
		s.Volume = 0
		pcall(Util.Tween, s, K.INHALE_IN, { Volume = rec.vol })
	end
	local stamp = os.clock()
	rec.t0, rec.dur, rec.stamp = stamp, seconds, stamp
	pcall(Util.Tween, rec.sound, seconds, { PlaybackSpeed = K.INHALE_PITCH[2] }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(seconds, function()
		if St.inhales[token] == rec and rec.stamp == stamp then
			Me.Hush(token)
		end
	end)
	return true
end

-- AttackFx Hooks.Hush (the charge ended early) and the release: the inhale fades out
function Me.Hush(token)
	local rec = token ~= nil and St.inhales[token] or nil
	if not rec then
		return
	end
	St.inhales[token] = nil
	if rec.sound and rec.sound.Parent then
		pcall(Util.Tween, rec.sound, K.INHALE_OUT, { Volume = 0 })
	end
end

-- AttackFx Hooks.Shatter: the "interrupted" cue of a broken press
function Me.ShatterSound(mine)
	local SF = Me.Sound()
	if SF and type(SF.Play) == "function" then
		local ok, s = pcall(SF.Play, "Shatter")
		if ok and typeof(s) == "Instance" and not mine then
			s.Volume = s.Volume * K.INHALE_OTHERS
		end
	end
end

-- per frame while a glow / dim shows; -> true while one does
function Me.UpdateScreenFx(now)
	if St.dim and now - St.dim.t0 >= St.dim.dur then
		Me.Undim(nil, K.DIM_OUT)
	end
	local g = St.screenFx
	if not g or not (g.glow or g.hold) then
		return St.dim ~= nil
	end
	if g.glow then
		local p = (now - g.glow.t0) / g.glow.dur
		local a = (p >= 1) and 1 or (0.45 + 0.55 * p * p) -- at most 55% opaque, at the very edge
		for _, f in ipairs(g.edges) do
			f.BackgroundTransparency = a
			f.Visible = p < 1
		end
		if p >= 1 then
			g.glow = nil
		end
	end
	if g.hold and not g.glow then
		Me.PaintHold(g, now) -- (a pet's glow on top gives the red edges back when it fades)
	end
	return g.glow ~= nil or g.hold ~= nil or St.dim ~= nil
end

----------------------------------------------------------------------
-- Pet attack VFX (docs/superpowers/specs/2026-10-23-pet-attack-vfx-design.md "Architecture", "Timing without server
-- changes", "Budgets, quality, readability"; plan Task 7). client/Controllers/AttackFx plays every pet attack FIRST;
-- each handler keeps its cube Fx.* as the fallback (AttackFx.Play false: the budget, Low limits, a missing texture,
-- an error). Bosses keep their own attack visuals (out of scope); a boss's hit on MY pet plays its Hurt reaction.
----------------------------------------------------------------------
local IDENTITY = CFrame.new()
local SUPPORT_KINDS = { Heal = true, Shield = true, Rally = true, Haste = true }
-- a helper buff's Effect (BattleCatalog.Buffs) -> the support special whose look it borrows
local BUFF_LOOK = { Heal = "Heal", Regen = "Heal", Shield = "Shield", Taken = "Shield", Damage = "Rally", Lifesteal = "Rally", Speed = "Haste", AttackSpeed = "Haste", Chill = "Haste" }
-- the events AttackFx plays (on arrival: Net.Events)
Atk.EVENTS = { [EV.Hit] = true, [EV.Special] = true, [EV.Element or "Element"] = true, [EV.KO] = true, [EV.Buff or "Buff"] = true, [EV.Swap or "Swap"] = true, [EV.Twist or "Twist"] = true,
	[EV.Cast or "Cast"] = true } -- (battle-feel T3: the real cast's charge starts on its arrival)
Atk.bodyOpts = { Pose = nil } -- (one table for every PetBuilder.PoseBody call)

-- AttackFx's hooks go to Me: camera kick = Me.Shake (the Shake setting and SHAKE_MAX apply), the edge glow, and a
-- signature's battle dim (Me.Dim / Me.Undim, Task 11)
function Atk.Hook(m)
	if type(m) ~= "table" or type(m.Hooks) ~= "table" then
		return
	end
	m.Hooks.Punch = function(amount, seconds)
		Me.Shake(amount, seconds)
		Me.FovPunch(amount)
	end
	m.Hooks.ScreenGlow = function(color, seconds)
		Me.Glow(color, seconds)
	end
	m.Hooks.DimWorld = function(seconds, token, unit)
		Me.Dim(seconds, token, unit)
	end
	m.Hooks.Undim = function(token)
		Me.Undim(token)
	end
	-- (Task 11b) the Special's charge sounds
	m.Hooks.Inhale = function(seconds, token, mine)
		return Me.Inhale(seconds, token, mine) -- (-> true when the sound plays)
	end
	m.Hooks.Hush = function(token)
		Me.Hush(token)
	end
	m.Hooks.Shatter = function(mine)
		Me.ShatterSound(mine)
	end
	-- (evolved forms) a Rally's bigger pet
	m.Hooks.AuraScale = function(unit, k)
		local B = St.battle
		local u = B and B.units[unit]
		if u then
			Units.AuraScale(u, k)
		end
	end
end

-- client/Controllers/AttackFx (nil when missing); on the first load its hooks go to Me (Atk.Hook) and the Graphics
-- setting is applied
function Atk.Mod()
	if Mods.AttackFx == nil then
		local m = optional(script.Parent, "AttackFx")
		Mods.AttackFx = (m and type(m.Play) == "function" and type(m.Pose) == "function" and type(m.Update) == "function") and m or false
		if Mods.AttackFx then
			Atk.Hook(m)
		end
		Atk.SyncQuality()
	end
	return Mods.AttackFx or nil
end

-- GraphicsQuality.Effective() -> AttackFx.SetQuality (at the first load and on every Graphics change, like PetFx;
-- before GraphicsQuality has started AttackFx follows it by itself)
function Atk.SyncQuality()
	local AF = Mods.AttackFx
	if not AF or type(AF.SetQuality) ~= "function" then
		return
	end
	if Mods.Gfx == nil then
		Mods.Gfx = optional(Client, "GraphicsQuality") or false
	end
	local gq = Mods.Gfx
	if gq and type(gq.Effective) == "function" and type(gq._St) == "table" and gq._St.Started then
		local ok, mode = pcall(gq.Effective)
		if ok and (mode == "Low" or mode == "High") then
			pcall(AF.SetQuality, mode)
			St.fxLow = mode == "Low" -- (no battle idle on the light path: Atk.Idles)
		end
	end
end

-- what a unit's effects look like: AttackFxCatalog.Unit(info) = { Element, Rarity, Stage, PetId, Ranged } (cached)
function Atk.Look(u)
	if u.fxLook then
		return u.fxLook
	end
	if Mods.FxCat == nil then
		Mods.FxCat = optional(Shared, "AttackFxCatalog") or false
	end
	local look = nil
	if Mods.FxCat and type(Mods.FxCat.Unit) == "function" then
		local ok, r = pcall(Mods.FxCat.Unit, u.info)
		look = ok and type(r) == "table" and r or nil
	end
	u.fxLook = look or {}
	return u.fxLook
end

-- drawn on this screen (not parked, not arriving, not another player's helper on the bench)
function Atk.Drawable(u)
	return u ~= nil and not u.gone and not u.parked and not u.hidden and not (u.benched and not u.mine)
end

-- an AttackFx side: the unit's model while it is drawn, else its point
function Atk.Side(B, u)
	return { Unit = u.id, Model = (u.model and not u.parked and not u.hidden) and u.model or nil, Pos = unitCenter(B, u) }
end

local function groundOf(B, u)
	return worldPoint(B, u.x, 0, u.z).Y
end

-- a zone-local angle (direction (cos a, sin a) on the floor, BattleSim's) as AttackFx's WORLD yaw
local function worldAngle(B, a)
	local w = zoneDir(B, cos(a), sin(a))
	return atan2(w.Z, w.X)
end

-- AttackFx.Play (pcall'd) -> true only when it plays (never during the End grace: the cube fallback then)
function Atk.Play(ctx)
	local AF = Atk.Mod()
	if not AF or St.fxEndAt then
		return false
	end
	local ok, played = pcall(AF.Play, ctx)
	return ok and played == true
end

-- (battle-feel T2) the seconds since the unit's last attack (the flurry's measured tempo; nil on its first)
function Atk.Tempo(u, now)
	if u.atkAt then
		u.tempo = now - u.atkAt
	end
	u.atkAt = now
	return u.tempo
end

-- (battle-feel T2, spec decisions 1 + 3) a melee pet's dash in, bite and hop back (AttackFx.Dash), its run ending at
-- `landAt` (os.clock): a pose only, the server keeps the pet at its rest spot (Damage.Standoff out). -> taken?
function Atk.Dash(B, a, v, landAt)
	local AF = Atk.Mod()
	if not (AF and type(AF.Dash) == "function") or B.ended or St.fxEndAt or a.isBoss or a.ranged or not v
		or not a.model or not Atk.Drawable(a) or not Atk.Drives(a) or not Atk.Posable() then
		return false
	end
	local now = os.clock()
	local ok, r = pcall(AF.Dash, a.id, Atk.Side(B, a), Atk.Side(B, v), landAt, now, { Mine = a.mine == true, Low = St.fxLow == true, Tempo = Atk.Tempo(a, now) })
	return ok and r == true
end

function Atk.Cancel(id)
	local AF = Mods.AttackFx
	if AF and type(AF.Cancel) == "function" then
		pcall(AF.Cancel, id)
	end
end

-- (evolved forms) a Rally's / Haste's aura ends with its buff, whatever else ends it: the wearer's KO, its swap, the battle's end (id nil = every aura)
function Atk.EndAura(id)
	local AF = Mods.AttackFx
	if AF and type(AF.EndAura) == "function" then
		pcall(AF.EndAura, id)
	end
end

-- every effect and pose ends now (a teardown: Leave of my team, Net.Cleanup, Stop); a pending End grace is over too
function Atk.ClearAll()
	St.fxEndAt = nil
	St.cheers = {}
	St.pre = nil -- (Task 11b: AttackFx.ClearAll drops the predicted charge too)
	for token in pairs(St.inhales) do
		Me.Hush(token)
	end
	local AF = Mods.AttackFx
	if AF and type(AF.ClearAll) == "function" then
		pcall(AF.ClearAll)
	end
	Me.Undim(nil, K.DIM_CUT) -- (Task 11) a torn-down battle never stays dark (AttackFx's own Undim came first if it could)
end

-- the battle's end (the sim's End event, or the End message if it comes first): no new effect (Atk.Play refuses),
-- the live ones get FX_END_GRACE seconds, then ClearAll; once per battle, so a late End event never cuts the
-- winners' Victory that starts after the grace
function Atk.EndSoon(B)
	if B.fxGrace or not Mods.AttackFx then
		return
	end
	B.fxGrace = true
	Atk.EndAura(nil) -- (evolved forms: the fight is over, so are its buffs)
	if not St.fxEndAt then
		St.fxEndAt = os.clock() + K.FX_END_GRACE
	end
	BattleController._wake()
end

function Atk.Update(now)
	local AF = Mods.AttackFx
	if not AF then
		return
	end
	St.fxFrame = St.frameNo -- (fix round 2, M8) the frame loop stepped AttackFx in this frame (StepsAttackFx)
	-- (Task 11b) a pressed SPECIAL whose event did not come within PRESS_WAIT: its predicted charge shatters
	local pre = St.pre
	if pre and now >= pre.untilT then
		Atk.Shatter(pre.B)
	end
	-- (battle-feel T3) a server cast whose Special did not come by its end + CAST_WAIT: its charge fades (no allocation:
	-- the records are walked in place)
	local B = St.battle
	local casts = B and B.casts
	if casts and next(casts) ~= nil then
		for id, rec in pairs(casts) do
			if now >= rec.DueAt + K.CAST_WAIT then
				Atk.EndCast(B, id, true)
			end
		end
	end
	local ok, err = pcall(AF.Update, now)
	if not ok then
		warnOnce("attackfx", "AttackFx.Update failed: " .. tostring(err))
	end
	-- the End grace: over at its deadline, or as soon as nothing plays any more
	if St.fxEndAt and (now >= St.fxEndAt or not Atk.Busy()) then
		local cheers = St.cheers or {}
		Atk.ClearAll()
		St.cheers = cheers
	end
	-- the winners' cheers wait for the grace (Net.Cheer): Victory, else the old hop
	local list = St.cheers
	if not St.fxEndAt and list and #list > 0 then
		local i = 1
		while i <= #list do
			local c = list[i]
			if now >= c.at then
				table.remove(list, i)
				if c.B == St.battle and not c.u.gone and not c.u.parked and not Atk.Lying(c.u) and not Atk.Victory(c.B, c.u, 0) then
					c.u.hopAt = now
				end
			else
				i = i + 1
			end
		end
	end
end

-- AttackFx still plays something (the frame loop stays awake)
function Atk.Busy()
	local s = Atk.Stats()
	return s ~= nil and ((s.Live or 0) + (s.Stepped or 0)) > 0
end

-- something of the pet attack VFX still needs frames (live effects, a lingering tail, the End grace, cheers waiting)
function Atk.Pending()
	if St.fxEndAt ~= nil or (St.cheers ~= nil and #St.cheers > 0) then
		return true
	end
	local s = Atk.Stats()
	return s ~= nil and ((s.Live or 0) + (s.Stepped or 0) + (s.Tails or 0)) > 0
end

function Atk.Stats()
	local AF = Mods.AttackFx
	if not AF or type(AF.Stats) ~= "function" then
		return nil
	end
	local ok, s = pcall(AF.Stats)
	return (ok and type(s) == "table") and s or nil
end

-- the poses can be drawn (PetBuilder.PoseBody / Animate opts.Pose in this build)
function Atk.Posable()
	return PetBuilder ~= nil and type(PetBuilder.PoseBody) == "function"
end

-- AttackFx drives this unit's body: loaded, poses drawable, and its last attack here was not refused (else the old
-- crouch / lunge / nudge come back until a play succeeds again)
function Atk.Drives(u)
	return (Mods.AttackFx and Atk.Posable() and u.fxDriven ~= false) and true or false
end

-- (attack effects, 2026-11-01) an area to draw: the number the server used (the event's r / length / width), else (an
-- unevolved pet's stay off the wire; an old recording) the catalog's x the caster's reach; nil when neither exists
local function areaOf(given, catalogNumber, u)
	local n = tonumber(given)
	if n and n == n and n > 0 then
		return n
	end
	n = tonumber(catalogNumber)
	if not n then
		return nil
	end
	return n * ((BattleCatalog and type(BattleCatalog.ReachOf) == "function") and BattleCatalog.ReachOf(u and u.evo) or 1)
end

-- an element attack's reach: a ranged fighter reaches out to its own range at least (BattleSim castElement's reachOut)
local function elementAreaOf(given, catalogNumber, u)
	local n = areaOf(given, catalogNumber, u)
	if n and u and u.ranged then
		return max(n, u.range)
	end
	return n
end

-- (Task 11 fix round 2, I1) the living enemies of `u` inside a Storm's zone: BattleSim's castSpecial puts the zone at the
-- aimed target (ev.tx, ev.tz) with radius ev.r (the catalog's x the caster's reach) and its
-- tickZones hits a body on the floor whose edge reaches the circle (inCircle: d <= r + its radius). The sim's Special
-- event names only the aimed target, so the effect's targets are gathered here, in the units' list order
local function stormZone(B, u, ev)
	local S = SPECIALS.Storm
	local r = areaOf(ev.r, type(S) == "table" and S.Radius or nil, u)
	local x, z = tonumber(ev.tx), tonumber(ev.tz)
	local out = {}
	if not (r and x and z) then
		return out
	end
	for _, e in ipairs(B.list) do
		if e.side ~= u.side and not e.gone and not e.benched and e.hp > 0 and e.state ~= S_DOWN then
			local dx, dz = e.x - x, e.z - z
			local reach = r + num(e.radius, 0)
			if dx * dx + dz * dz <= reach * reach then
				out[#out + 1] = e
			end
		end
	end
	return out
end

-- the hits of a played Special / Element on these sides are AttackFx's (their Hurt pose: no nudge)
local function cover(B, to, dueAt)
	for _, side in ipairs(to) do
		local t = side.Unit and B.units[side.Unit]
		if t then
			t.fxHitUntil = dueAt + K.FX_COVER
		end
	end
end

-- a play's look from the unit (AttackFxCatalog.Unit): Element (unless given), Rarity, Stage, PetId (unless given;
-- false = none: a helper buff never plays its pet's signature special)
local function lookCtx(u, ctx)
	local look = Atk.Look(u)
	ctx.Element = ctx.Element or look.Element
	ctx.Rarity = look.Rarity
	ctx.Stage = look.Stage
	if ctx.PetId == nil then
		ctx.PetId = look.PetId
	elseif ctx.PetId == false then
		ctx.PetId = nil
	end
	return ctx
end

-- a Hit: a pet's plain attack (melee swipe / ranged shot; Miss = it flies past), a boss's hit on MY pet (its Hurt;
-- other players' pets keep the nudge: a boss slam can hit a dozen pets and the budget is for the attacks). The damage
-- of a special / element / zone / burn is drawn by its own event.
-- (Task 10 review I1, Ruling 17) a hit the victim's shield absorbs: the bubble ripples (ShieldHit) on the victim at the
-- hit, in the look of the pet whose Shield it is (u.shieldBy while its shield lasts: u.shieldUntil), else the victim's
-- own. Never on a boss; a boss's hit ripples only MY pets (like its Hurt: one slam can hit a dozen pets).
-- (re-review M8) a zone / burn tick (`tick`) ripples only RIPPLE_TICK_GAP after the unit's last ripple (a Linger zone
-- ticks every 0.5 s on every shielded pet in it); a hit from an attacker always ripples
function Atk.ShieldHit(B, v, a, dueAt, tick)
	if v.isBoss or not v.model or not Atk.Drawable(v) or (a and a.isBoss and not v.mine) then
		return false
	end
	if tick and v.rippleAt and dueAt - v.rippleAt < K.RIPPLE_TICK_GAP then
		return false
	end
	-- (re-review M9) the caster's look only while its shield lasts: a shield the client never saw cast (a rejoin
	-- snapshot) ripples in the victim's own look, not in a stale caster's
	if v.shieldBy and not ((tonumber(v.shieldUntil) or 0) > os.clock()) then
		v.shieldBy = nil
	end
	local by = v.shieldBy and B.units[v.shieldBy] or nil
	local played = Atk.Play(lookCtx(by or v, { Attack = "ShieldHit", PetId = false, From = Atk.Side(B, v), Mine = v.mine == true, DueAt = dueAt, Ground = groundOf(B, v) }))
	if played then
		v.rippleAt = dueAt
	end
	return played
end

-- (evolved forms) a hit that is no swing of its own: a Double strike's extra hit flashes on the victim; a Shield's Thorns (from the wearer, to its attacker) is a thin bolt back,
-- one per RIPPLE_TICK_GAP (a boss's flurry would be a strobe). In the attacker's look: a Haste / Shield pet's flavour
-- (Pitch 2 item 5 "Bounce in" A) on a dashing biter (AttackFx.DashTwist): a Double strike is a second chomp about 0.1 s
-- after the bite, its gold sparks moved onto it; a Thorns prick snaps its head back and hops it away, the bolt on the bite
function Atk.DashTwist(biter, kind, dueAt)
	local AF = Atk.Mod()
	if not (biter and AF and type(AF.DashTwist) == "function") then
		return dueAt
	end
	local ok, at = pcall(AF.DashTwist, biter.id, kind, os.clock())
	return (ok and type(at) == "number" and at == at) and at or dueAt
end

function Atk.HitTwist(B, ev, dueAt, v, a)
	if not a or not Atk.Drawable(v) then
		return "none"
	end
	if ev.double then
		dueAt = Atk.DashTwist(a, "Double", dueAt)
		-- (look review r2, major 1) Flinch: the victim (From: the sparks are on it) is re-hit at DOUBLE_FLINCH on the second
		-- chomp, its Hurt stacking on the bite's (AttackFx); without it no Hurt was scheduled and the mock's second jolt
		-- never played
		return Atk.Play(lookCtx(a, { Attack = "Special", Kind = "Haste", Twist = "DoubleHit", From = Atk.Side(B, v), Flinch = K.DOUBLE_FLINCH,
			Mine = a.mine == true, DueAt = dueAt, Ground = groundOf(B, v) }))
	end
	if not Atk.Drawable(a) or (a.thornAt and dueAt - a.thornAt < K.RIPPLE_TICK_GAP) then
		return "none"
	end
	a.thornAt = dueAt
	local prick = Atk.DashTwist(v, "Thorns", dueAt)
	-- (gate review r0 minor) a fighter's bite lands Melee.In after its Hit: the prick's flash and number wait for it (hitPlay)
	ev.fxPrick = prick - dueAt
	dueAt = prick
	return Atk.Play(lookCtx(a, { Attack = "Special", Kind = "Shield", Twist = "Thorns", From = Atk.Side(B, a), To = Atk.Side(B, v), Mine = a.mine == true, DueAt = dueAt, Ground = groundOf(B, a) }))
end

-- the Hit's own play (Atk.Hit): its result and the seconds its impact lands after dueAt (a ranged shot's flight)
local function hitPlay(B, ev, dueAt, v, a)
	if ev.special or ev.element or ev.zone or ev.burn then
		return "none", 0
	end
	if ev.double or ev.thorns then
		local played = Atk.HitTwist(B, ev, dueAt, v, a)
		-- (Pitch 2 item 5, gate review r0 minor: "On Thorns it flashes") a Thorns hit on a dashing biter lands on its prick
		-- (AttackFx.DashTwist): a player's fighter bites Melee.In after its Hit, so the Hit (the biter's flash, the number)
		-- and the biter's next events wait that long, as the bite's own do (an NPC's prick is on the event: no wait)
		local late = ev.thorns and num(ev.fxPrick, 0) or 0
		if late > K.PRICK_LATE_MIN then
			ev.fxLate = min(late, K.FX_LATE_MAX)
			return played, ev.fxLate
		end
		return played, 0
	end
	if ev.tele or (a and a.isBoss) then
		if ev.miss or v.isBoss or not v.mine or not Atk.Drawable(v) then
			return "none", 0
		end
		local el = a and Atk.Look(a).Element or nil
		return Atk.Play(lookCtx(v, { Attack = "Hurt", Element = el, From = Atk.Side(B, v), Mine = true, Crit = ev.crit == true, DueAt = dueAt, Ground = groundOf(B, v) })), 0
	end
	if not a or not Atk.Drawable(a) then
		return "none", 0
	end
	local ctx = lookCtx(a, {
		Attack = a.ranged and "Ranged" or "Melee", From = Atk.Side(B, a), To = Atk.Side(B, v), Mine = a.mine == true,
		Crit = ev.crit == true, Strong = num(ev.elem, 1) > 1, Miss = ev.miss == true, DueAt = dueAt, Ground = groundOf(B, a),
	})
	-- (battle-feel T2) a melee bite is a dash: an NPC's was scheduled by its Windup (landing on this hit); a fighter's
	-- (no Windup) dashes now and lands Melee.In later, the Hit's number and the victim's next events held that long
	local dashLate = 0
	if not a.ranged then
		local now = os.clock()
		if a.dashedAt and now - a.dashedAt < K.DASH_SEEN then
			ctx.Dashed = true
			a.dashedAt = nil
		elseif type(a.owner) == "number" then -- (a player's fighter: an NPC's every bite follows its Windup)
			local M = Config.Battle and Config.Battle.Feel and Config.Battle.Feel.Melee
			local inS = M and num(M.In, 0.3) or 0.3
			if M and M.Dash == true and Atk.Dash(B, a, v, dueAt + inS) then
				ctx.Dashed = true
				ctx.DueAt = dueAt + inS
				dashLate = inS
			end
		end
	end
	local played = Atk.Play(ctx)
	a.fxDriven = played
	-- a ranged shot keeps its flight (AttackFx MinTravel): its impact may land after the event's time; Net.Events
	-- then plays the Hit (number, flash) and the victim's next events that much later, so they land with the shot
	local late = played and (dashLate > 0 and dashLate or tonumber(ctx.ImpactLate)) or 0
	if late == late and late > 0 then
		ev.fxLate = min(late, K.FX_LATE_MAX)
		return played, ev.fxLate
	end
	return played, 0
end

function Atk.Hit(B, ev, dueAt)
	local v = B.units[tonumber(ev.to) or -1]
	local a = ev.from ~= nil and B.units[tonumber(ev.from) or -1] or nil
	if not v or (ev.from ~= nil and not a) then
		return nil
	end
	local played, late = hitPlay(B, ev, dueAt, v, a)
	-- (any absorbed hit: a plain attack, a special's, an element's, a zone's; the attack's own effect is apart). After
	-- the hit's play (re-review I3): a ranged shot's ripple lands with the shot (dueAt + its late), like the BLOCK
	-- number, the Hurt pose and the impact (Net.Events holds them by ev.fxLate)
	if num(ev.absorbed, 0) > 0 and not ev.miss then
		Atk.ShieldHit(B, v, a, dueAt + late, (ev.zone or ev.burn) and true or false)
	end
	return played
end

-- (Task 11b) my SPECIAL press: when my own view says it can go (my fighter drawn, it has a special, the meter full in
-- the latest snapshot, not stunned / casting / down, the fight on), its charge shows at once on my fighter
-- (AttackFx.Precharge: the glow + motes, the rim, the inhale, the held Cast pose), aimed at my lock (else its snapshot
-- target). Its Special event takes it over (Atk.Special: impact still on the event's time); a rejected Order (Net.Pre)
-- or PRESS_WAIT without the event (Atk.Update) shatters it
function Atk.PreCharge(B, now)
	local f = B and B.fighterId and B.units[B.fighterId] or nil
	-- (fix round 2) never on a fighter whose KO arrived (Atk.Lying): a held auto-swap keeps it my fighter till its impact
	if not f or B.ended or B.simEnded or St.fxEndAt or not f.model or not Atk.Drawable(f) or Atk.Lying(f) then
		return false
	end
	local kind = type(f.special) == "table" and f.special.Kind or nil
	if type(kind) ~= "string" or kind == "" or num(f.meter, 0) < METER_MAX or num(f.hp, 0) <= 0 then
		return false
	end
	if f.state == S_STUNNED or f.state == S_CASTING or f.state == S_DOWN or f.state == S_BENCHED then
		return false
	end
	if St.pre and St.pre.B == B and St.pre.unit == f.id and now < St.pre.untilT then
		return false -- (fix round 1, M4) a second press while the first waits: one prediction (the sim answers the first)
	end
	local AF = Atk.Mod()
	if not AF or type(AF.Precharge) ~= "function" then
		return false
	end
	local tgt = (B.lock and B.units[B.lock]) or (f.target and B.units[f.target]) or nil
	local to = nil
	if tgt and not tgt.gone and not SUPPORT_KINDS[kind] then
		to = { Atk.Side(B, tgt) }
	end
	local ok, played = pcall(AF.Precharge, lookCtx(f, {
		Kind = kind, From = Atk.Side(B, f), To = to, Mine = true, Seconds = K.PRESS_WAIT, Ground = groundOf(B, f), Now = now,
	}))
	if ok and played == true then
		St.pre = { B = B, unit = f.id, t0 = now, untilT = now + K.PRESS_WAIT }
		return true
	end
	return false
end

-- (Task 11b) the predicted charge breaks (refused / no event): AttackFx's shards + Recoil + the "interrupted" sound;
-- `quiet` = it just fades (its Special came but could not play). (fix round 1, I3 / M5) quiet too when the fighter is
-- no longer up (KO'd: its KO arrived or it is drawn down) or no longer my fighter (swapped out): no shards, Recoil or
-- "interrupted" sound on a downed or benched pet
function Atk.Shatter(B, quiet)
	local p = St.pre
	St.pre = nil
	local AF = Mods.AttackFx
	if not p or not AF or type(AF.Shatter) ~= "function" then
		return false
	end
	local PB = p.B or B
	local u = PB and PB.units[p.unit]
	if not u or u.gone or u.parked or u.benched or Atk.Lying(u) or (PB.fighterId ~= nil and PB.fighterId ~= p.unit) then
		quiet = true
	end
	local ok, r = pcall(AF.Shatter, p.unit, os.clock(), quiet == true)
	return ok and r == true
end

-- (battle-feel T3, spec decision 6) the server's real cast starts (the Cast event's arrival; ev.at = the sim time its
-- effects land): the charge shows on the caster for everyone (AttackFx.Precharge, the glow + motes, rim, inhale, the
-- held Cast pose), due at `at` on the render clock; B.casts[unit] = { Kind, DueAt } until its Special takes it over
-- (Atk.Special), a CastBreak / a KO ends it (Atk.EndCast) or DueAt + CAST_WAIT passes (Atk.Update: a quiet fade). My own
-- press keeps its prediction (St.pre): its wait is extended to the cast's end + CAST_WAIT
function Atk.Cast(B, ev, dueAt)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return nil
	end
	if u.isBoss or not Atk.Drawable(u) then
		return "none"
	end
	local now = os.clock()
	local due = now + max(0, num(ev.at, B.renderT) - B.renderT)
	if due < dueAt then
		due = dueAt
	end
	local kind = tostring(ev.kind or "")
	B.casts = B.casts or {}
	local pre = St.pre
	if pre and pre.B == B and pre.unit == u.id then
		pre.untilT = max(pre.untilT, due + K.CAST_WAIT)
		B.casts[u.id] = { Kind = kind, DueAt = due }
		return true
	end
	local AF = Atk.Mod()
	if not AF or type(AF.Precharge) ~= "function" or not u.model or St.fxEndAt or Atk.Lying(u) then
		return false
	end
	local to = nil
	local tgt = B.units[tonumber(ev.target) or -1]
	if tgt and not tgt.gone and not SUPPORT_KINDS[kind] then
		to = { Atk.Side(B, tgt) }
	end
	local ok, played = pcall(AF.Precharge, lookCtx(u, {
		Kind = kind, From = Atk.Side(B, u), To = to, Mine = u.mine == true, Seconds = max(0.1, due - now), Ground = groundOf(B, u), Now = now,
		Form = tonumber(ev.form),
	}))
	if ok and played == true then
		B.casts[u.id] = { Kind = kind, DueAt = due }
		return true
	end
	return false
end

-- (battle-feel T3) a unit's cast ends without its Special (a CastBreak, its KO, the wait over): its charge shatters
-- (shards for mine unless `quiet`; another unit's only fades) and the record goes. My press's prediction: Atk.Shatter
function Atk.EndCast(B, id, quiet)
	local rec = B.casts and B.casts[id]
	if B.casts then
		B.casts[id] = nil
	end
	if St.pre and St.pre.unit == id then
		return Atk.Shatter(B, quiet)
	end
	local AF = Mods.AttackFx
	if not rec or not AF or type(AF.Shatter) ~= "function" then
		return false
	end
	local u = B.units[id]
	local loud = not quiet and u ~= nil and u.mine == true and not u.gone and not u.parked and not u.benched and not Atk.Lying(u)
	local ok, r = pcall(AF.Shatter, id, os.clock(), not loud)
	return ok and r == true
end

-- a Special: the caster's kind (its signature for the 12 top pets: PetId), at its targets / allies / the aimed spot.
-- (Task 11b) my pressed Special takes over its predicted charge (Precharged: backdated to the press, impact on dueAt);
-- every other one (bots, NPCs, allies, enemies, my pet with no press) gets its charge back: LateMax, the impact up to
-- LATE_MAX after dueAt (ev.fxSpLate: Net.Events holds this special's hits, the KOs they cause and a last gasp till then).
-- A Pounce never lands late: the server moves a pouncing bot onto its target at the event, its leap must land then
function Atk.Special(B, ev, dueAt)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return nil
	end
	if u.isBoss or not Atk.Drawable(u) then
		return "none"
	end
	local kind = tostring(ev.kind or "")
	local to, seen = {}, {}
	local function add(id)
		local t = B.units[tonumber(id) or -1]
		if t and not seen[t] and not t.gone then
			seen[t] = true
			to[#to + 1] = Atk.Side(B, t)
		end
	end
	if kind == "Heal" then
		for _, h in ipairs(type(ev.heals) == "table" and ev.heals or {}) do
			add(type(h) == "table" and h[1] or nil)
		end
	elseif kind == "Shield" then
		for _, id in ipairs(type(ev.shields) == "table" and ev.shields or {}) do
			add(id)
		end
	else
		add(ev.target) -- the aimed target first (AttackFx aims at To[1])
		for _, id in ipairs(type(ev.targets) == "table" and ev.targets or {}) do
			add(id)
		end
		if kind == "Storm" then -- (fix round 2, I1) + every other enemy in the zone (the event carries only the aimed one)
			for _, e in ipairs(stormZone(B, u, ev)) do
				add(e.id)
			end
		end
	end
	if #to == 0 then
		if SUPPORT_KINDS[kind] then
			add(u.id)
		else
			to[1] = { Pos = worldPoint(B, num(ev.tx, u.x), u.centerY or 1.5, num(ev.tz, u.z)) } -- (nobody in reach)
		end
	end
	local pre = St.pre
	local precharged = pre ~= nil and pre.B == B and pre.unit == u.id
	if precharged then
		St.pre = nil
	end
	-- (battle-feel T3) a Special after its server cast (a Cast record, or the event's `at`): the charge the Cast started
	-- hands over, the travel given back up to TRAVEL_HOLD (old recordings with neither: LATE_MAX as before)
	local rec = B.casts and B.casts[u.id]
	if B.casts then
		B.casts[u.id] = nil
	end
	local castDriven = rec ~= nil or tonumber(ev.at) ~= nil
	local castPre = false
	if rec and not precharged then
		local AF = Mods.AttackFx
		castPre = AF ~= nil and type(AF.Precharging) == "function" and AF.Precharging(u.id) ~= nil
	end
	local lateMax = nil
	if kind ~= "Pounce" then
		if castDriven then
			lateMax = K.TRAVEL_HOLD
		elseif not precharged then
			lateMax = K.LATE_MAX
		end
	end
	local S = SPECIALS[kind] or {}
	-- (evolved forms) a form's look: the pack's real charge line (the sim's floor space -> the world); a Rally's / Haste's aura, to the buff's end as it plays on the render clock
	local line = nil
	if tonumber(ev.x0) and tonumber(ev.z0) then
		local p = worldPoint(B, tonumber(ev.x0), 0, tonumber(ev.z0))
		line = { X0 = p.X, Z0 = p.Z, Angle = worldAngle(B, num(ev.angle, 0)), Length = num(ev.length, 0), Width = num(ev.width, 4) }
	end
	local seconds, scale = nil, nil
	if (kind == "Rally" or kind == "Haste") and tonumber(ev["until"]) then
		local simNow = B.haveOffset and (os.clock() + B.offset) or B.renderT
		seconds = (tonumber(ev["until"]) - simNow) + (dueAt - os.clock())
		scale = (kind == "Rally") and (K.AURA_SCALE[num(ev.form, 0)] or K.AURA_SCALE[0]) or nil
	end
	local ctx = lookCtx(u, {
		Attack = "Special", Kind = kind, From = Atk.Side(B, u), To = to, Mine = u.mine == true, DueAt = dueAt,
		Angle = tonumber(ev.angle) and worldAngle(B, tonumber(ev.angle)) or nil, Ground = groundOf(B, u),
		Radius = areaOf(ev.r, S.Radius, u), Length = areaOf(ev.length, S.Length, u), Width = areaOf(ev.width, S.Width, u),
		Precharged = (precharged or castPre) or nil, LateMax = lateMax,
		Form = tonumber(ev.form), Line = line, Seconds = seconds, Scale = scale,
	})
	local played = Atk.Play(ctx)
	u.fxDriven = played
	if precharged and not played then
		St.pre = pre
		Atk.Shatter(B, true) -- (the Special came but could not play: its prediction fades, no "interrupted" cue)
	elseif castPre and not played then
		local AF = Mods.AttackFx
		pcall(AF.Shatter, u.id, os.clock(), true) -- (battle-feel T3: the cast's charge just fades)
	end
	if played then
		local late = tonumber(ctx.ImpactLate) or 0
		if late == late and late > 0 then
			ev.fxSpLate = min(late, castDriven and K.TRAVEL_HOLD or K.LATE_MAX)
		end
		cover(B, to, dueAt)
		if kind == "Storm" then
			u.stormFxUntil = dueAt + 1 -- its Zone draws only the damage field (AttackFx's cloud rains)
		end
		-- (evolved forms) a stage-2 Pounce's Landing burst, at its real radius, round the target: no event of its own
		if tonumber(ev.burstR) then
			local struck = {}
			for _, id in ipairs(type(ev.burstTargets) == "table" and ev.burstTargets or {}) do
				local t = B.units[tonumber(id) or -1]
				if t and not t.gone then
					struck[#struck + 1] = Atk.Side(B, t)
				end
			end
			Atk.Play(lookCtx(u, {
				Attack = "Special", Kind = kind, Twist = "Landing", From = { Unit = u.id, Pos = worldPoint(B, num(ev.tx, u.x), u.centerY or 1.5, num(ev.tz, u.z)) }, To = struck,
				Radius = tonumber(ev.burstR), Mine = u.mine == true, DueAt = dueAt, Ground = groundOf(B, u),
			}))
			cover(B, struck, dueAt)
		end
	end
	return played
end

-- an element attack (Cone / Circle / Line of BattleCatalog.ElementAttacks) along the event's aim
function Atk.Element(B, ev, dueAt)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return nil
	end
	if u.isBoss or not Atk.Drawable(u) then
		return "none"
	end
	Atk.Look(u) -- (loads AttackFxCatalog)
	local cat = Mods.FxCat or nil
	local element = ev.element
	if not (cat and type(cat.Elements) == "table" and type(element) == "string" and cat.Elements[element]) then
		element = nil -- (lookCtx: the unit's own)
	end
	local shape = ev.shape
	local def = BattleCatalog and type(BattleCatalog.ElementAttacks) == "table" and BattleCatalog.ElementAttacks[ev.element] or nil
	local radius, length, width = nil, nil, nil
	if type(def) == "table" then
		if shape == "Line" then
			length, width = elementAreaOf(ev.length, def.Length, u), areaOf(ev.width, def.Width, u)
		elseif shape == "Circle" then
			radius = elementAreaOf(ev.r, def.Radius, u)
		else
			radius = elementAreaOf(ev.length, def.Length, u)
		end
	end
	-- the targets, the one nearest the aimed point first (AttackFx aims at To[1])
	local tx, tz = num(ev.tx, u.x), num(ev.tz, u.z)
	local list = {}
	for _, id in ipairs(type(ev.targets) == "table" and ev.targets or {}) do
		local t = B.units[tonumber(id) or -1]
		if t and not t.gone then
			list[#list + 1] = t
		end
	end
	table.sort(list, function(p, q)
		local dp = (p.x - tx) * (p.x - tx) + (p.z - tz) * (p.z - tz)
		local dq = (q.x - tx) * (q.x - tx) + (q.z - tz) * (q.z - tz)
		if dp ~= dq then
			return dp < dq
		end
		return p.id < q.id
	end)
	local to = {}
	for i, t in ipairs(list) do
		to[i] = Atk.Side(B, t)
	end
	-- (feel-balance Task 2) a melee pet with a standoff dashes in for its element too (the server grows it from the bite
	-- point it sends as ev.x / ev.z): the same dash as a bite, landing on the element's time; its Circle stands there
	local center = (shape == "Circle" and u.ranged) and worldPoint(B, tx, u.centerY or 1.5, tz) or nil
	local dashed = false
	if not u.ranged and list[1] then
		local ex, ez = num(ev.x, u.x), num(ev.z, u.z)
		dashed = Atk.Dash(B, u, list[1], dueAt)
		if dashed and shape == "Circle" and ((ex - u.x) * (ex - u.x) + (ez - u.z) * (ez - u.z)) > 0.25 then
			center = worldPoint(B, ex, u.centerY or 1.5, ez)
		end
	end
	local played = Atk.Play(lookCtx(u, {
		Attack = "Element", Shape = shape, Element = element, From = Atk.Side(B, u), To = (#to > 0) and to or nil,
		Angle = worldAngle(B, num(ev.angle, 0)), Radius = radius, Length = length, Width = width, Mine = u.mine == true, DueAt = dueAt,
		Ground = groundOf(B, u), Form = tonumber(ev.form),
		-- (evolved forms: a ranged pet's Circle stands on its aim point; the sim's too)
		Center = center,
		Dashed = dashed or nil, -- (the dash is the caster's body motion: no Cast / Strike pose over it)
	}))
	u.fxDriven = played
	if played then
		cover(B, to, dueAt)
	end
	return played
end

-- (evolved forms) a form's delayed hit (the Twist event, BattleSim's header has its fields): one effect of AttackFxCatalog.Twists in the caster's look, at the point the sim used.
-- The caster does not cast again; To = whoever it reached. A special's twist = its kind's, an element's: the element's
function Atk.Twist(B, ev, dueAt)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return nil
	end
	if u.isBoss or not Atk.Drawable(u) then
		return "none"
	end
	local kind = tostring(ev.kind or "")
	local special = SPECIALS[kind] ~= nil
	local function sides(list, first)
		local out = {}
		for _, entry in ipairs(type(list) == "table" and list or {}) do
			local t = B.units[tonumber(first and entry[1] or entry) or -1]
			if t and not t.gone then
				out[#out + 1] = Atk.Side(B, t)
			end
		end
		return out
	end
	local at = nil
	if tonumber(ev.x) and tonumber(ev.z) then
		at = worldPoint(B, tonumber(ev.x), u.centerY or 1.5, tonumber(ev.z))
	end
	local from, to, center = Atk.Side(B, u), sides(ev.targets), nil
	if type(ev.heals) == "table" then -- (Lingering on each ally healed; Starfall falls on the caster: AttackFx has no one else to flinch)
		to = (tostring(ev.twist) == "Lingering") and sides(ev.heals, true) or {}
	elseif type(ev.shields) == "table" then
		to = sides(ev.shields)
	elseif tonumber(ev.tx) and at then -- (Forked: from the last one struck to the next, wherever they have moved on the screen)
		from = { Unit = u.id, Pos = at }
		local t = tonumber(ev.targets and ev.targets[1])
		to = { { Unit = t, Pos = worldPoint(B, tonumber(ev.tx), u.centerY or 1.5, num(ev.tz, 0)) } }
	elseif tostring(ev.twist) == "Twin" then
		-- (a line from where the caster stands now: the sim's too)
		from = Atk.Side(B, u)
	elseif not special and tonumber(ev.r) then -- (an element's circle stands on the point; From stays the caster: its own effect's area)
		center = at
	elseif at and tostring(ev.twist) ~= "Chill" then
		from = { Unit = u.id, Pos = at }
	end
	local played = Atk.Play(lookCtx(u, {
		Attack = special and "Special" or "Element", Kind = special and kind or nil, Element = (not special) and kind or nil, Twist = tostring(ev.twist or ""),
		From = from, To = (#to > 0) and to or nil, Center = center, Mine = u.mine == true, DueAt = dueAt, Ground = groundOf(B, u),
		Angle = tonumber(ev.angle) and worldAngle(B, tonumber(ev.angle)) or nil, AimFixed = tonumber(ev.angle) and true or nil,
		Radius = tonumber(ev.r), Length = tonumber(ev.length), Width = tonumber(ev.width), Band = tonumber(ev.band),
	}))
	if played and not ev.heals and not ev.shields and tostring(ev.twist) ~= "Chill" then
		cover(B, to, dueAt)
	end
	return played
end

-- a KO: the element-coloured poof + the Ko pose (tumbles, then holds: the pet lies until it is parked)
function Atk.Ko(B, ev, dueAt)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return nil
	end
	if u.isBoss or not u.model or not Atk.Drawable(u) then
		return "none"
	end
	local played = Atk.Play(lookCtx(u, { Attack = "Ko", From = Atk.Side(B, u), Mine = u.mine == true, DueAt = dueAt, Ground = groundOf(B, u) }))
	if played then
		u.koAt = dueAt
		u.poofed = true -- (AttackFx's poof replaces the cube poof)
	end
	return played
end

-- a helper's buff on its fighter: the support special it is like (Heal / Shield / Rally / Haste) on the fighter
function Atk.Buff(B, ev, dueAt)
	local h = B.units[tonumber(ev.unit) or -1]
	local f = B.units[tonumber(ev.target) or -1]
	if not h or not f then
		return nil
	end
	if f.isBoss or not f.model or not Atk.Drawable(f) then
		return "none"
	end
	local def = BattleCatalog and type(BattleCatalog.Buffs) == "table" and BattleCatalog.Buffs[tostring(ev.kind)] or nil
	local kind = BUFF_LOOK[(type(def) == "table" and def.Effect) or tostring(ev.kind)] or "Rally"
	-- (another player's helper is not drawn: the buff rises from its fighter)
	local from = (h.model and Atk.Drawable(h)) and Atk.Side(B, h) or { Pos = unitCenter(B, f) }
	return Atk.Play(lookCtx(h, { Attack = "Special", Kind = kind, PetId = false, From = from, To = { Atk.Side(B, f) }, Mine = h.mine == true, DueAt = dueAt, Ground = groundOf(B, f) }))
end

-- a Swap: the incoming pet's entrance (Victory: hop-spin + sparkles)
function Atk.Swap(B, ev, dueAt)
	local inc = B.units[tonumber(ev["in"]) or -1]
	if not inc then
		return nil
	end
	if inc.isBoss or not inc.model or not Atk.Drawable(inc) then
		return "none"
	end
	return Atk.Play(lookCtx(inc, { Attack = "Victory", From = Atk.Side(B, inc), Mine = inc.mine == true, DueAt = dueAt, Ground = groundOf(B, inc) }))
end

-- the winners' cheer (Net.End): Victory after `delay` seconds; false = the old hop
-- a pet that is KO'd (its Ko played, or drawn down) lies until it is parked: it never cheers (Task 8 fix round 3: the
-- KO pose pin; a KO in the End batch had the pet hop up into Victory 1.4 s after the End)
function Atk.Lying(u)
	return u.koAt ~= nil or u.state == S_DOWN or (tonumber(u.hp) or 1) <= 0
end

function Atk.Victory(B, u, delay)
	if not Atk.Mod() or u.isBoss or not u.model or not Atk.Drawable(u) then
		return false
	end
	return Atk.Play(lookCtx(u, { Attack = "Victory", From = Atk.Side(B, u), Mine = u.mine == true, Now = os.clock() + delay, Ground = groundOf(B, u) }))
end

-- one event: true = AttackFx plays it (the handler draws no cube effect), false = refused (the handler's cube Fx.*),
-- "none" = nothing of AttackFx's, nil = a unit it names is not known yet (asked again when the event plays)
function Atk.Event(B, ev, dueAt)
	if B.ended or not Atk.Mod() then
		return "none"
	end
	local t = ev.type
	if t == EV.Hit then
		return Atk.Hit(B, ev, dueAt)
	elseif t == EV.Special then
		return Atk.Special(B, ev, dueAt)
	elseif t == (EV.Cast or "Cast") then
		return Atk.Cast(B, ev, dueAt)
	elseif t == (EV.Element or "Element") then
		return Atk.Element(B, ev, dueAt)
	elseif t == EV.KO then
		return Atk.Ko(B, ev, dueAt)
	elseif t == (EV.Buff or "Buff") then
		return Atk.Buff(B, ev, dueAt)
	elseif t == (EV.Swap or "Swap") then
		return Atk.Swap(B, ev, dueAt)
	elseif t == (EV.Twist or "Twist") then
		return Atk.Twist(B, ev, dueAt)
	end
	return "none"
end

-- an event ARRIVES (Net.Events): its effect starts now with the impact due when the event plays on the render clock
-- (`lead` seconds from now: the charge beat; AttackFx shortens the charge when the lead is short)
function Atk.Arrive(B, ev, lead)
	if not Atk.EVENTS[ev.type] then
		return
	end
	local ok, r = pcall(Atk.Event, B, ev, os.clock() + lead)
	if not ok then
		warnOnce("attackfx_" .. tostring(ev.type), "AttackFx for " .. tostring(ev.type) .. " failed: " .. tostring(r))
	elseif r ~= nil then
		B.fxEv[ev] = r
	end
end

-- the handler's answer when the event plays: did AttackFx play it? (an event that arrived before a unit it names was
-- known is played now, impact at once)
function Atk.Result(B, ev)
	local r = B.fxEv[ev]
	if r ~= nil then
		B.fxEv[ev] = nil
	else
		local ok, res = pcall(Atk.Event, B, ev, os.clock())
		r = ok and res or false
	end
	return r == true
end

-- PetBuilder.PoseBody of a pose (identity without one)
local function poseBody(pose)
	Atk.bodyOpts.Pose = pose
	local ok, cf = pcall(PetBuilder.PoseBody, Atk.bodyOpts)
	Atk.bodyOpts.Pose = nil
	return (ok and typeof(cf) == "CFrame") and cf or IDENTITY
end

-- the battle idle (PetPoses IdleBattle: breathing, a glance every 2-4 s) shows while AttackFx drives the unit and
-- nothing else does: not on Low graphics (the light path keeps the old drawing), not while down, stunned, winding,
-- dashing or moving under the player's input (my fighter: `busy`), never on a boss
function Atk.Idles(u, down, busy)
	return not busy and not down and not u.windup and not St.fxLow and u.state ~= S_STUNNED and u.state ~= S_DASHING
		and not u.dashAt and Atk.Drives(u)
end

-- the pose a battle pet shows now -> pose (PetBuilder.Animate opts.Pose) and its body offset (studs x the build
-- scale, for the root write: root = frame * body), or nil, nil (no pose: exactly the old drawing). In order:
-- AttackFx's pose (its crossfade honoured: Prev -> current over Blend); the Ko pose held after AttackFx let it go
-- (the End's ClearAll: the pet still lies there); PetPoses' Windup held while the snapshot says Winding (the dash
-- cue's crouch, for a unit AttackFx drives); the battle idle (Atk.Idles; P = time + a per-unit phase, so the pets do
-- not breathe or glance in step). A switch between those sources crossfades over AttackFx.CROSSFADE like AttackFx's
-- own Prev / Blend: the body blends, Animate keeps the previous pose for the first half. `base` = the unit's drawn spot
-- (world, before the pose): AttackFx.Pose shortens a Pounce leap by what the server's slide to the target has covered.
function Atk.PoseOf(u, now, down, busy, animate, base)
	local AF = Mods.AttackFx
	if not AF or u.isBoss or not Atk.Posable() then
		return nil, nil
	end
	if animate == false and not u.poseSwitch and u.poseSrc ~= "fx" then
		return u.poseLast, u.poseScaled -- a strided frame: the last pose rides along (Units.CarryLoose); an attack pose
		-- (src "fx") still runs so its body offset (the Strike lunge) moves every frame
	end
	local pose, body, src = nil, nil, nil
	local ok, ps = pcall(AF.Pose, u.id, base) -- (base: the drawn spot; a Pounce lands where the server slides the pet)
	if ok and type(ps) == "table" and type(ps.Name) == "string" then
		local cur = u.poseCur or {}
		u.poseCur = cur
		-- (Pitch 2 item 5) Feet: the model's paw lines (the melee motion pivots about them: nothing sinks or slides)
		cur.Name, cur.P, cur.Ranged, cur.Amp, cur.Reach, cur.Feet = ps.Name, ps.P, ps.Ranged, ps.Amp, ps.Reach, ps.Feet
		pose, body, src = cur, poseBody(cur), "fx"
		-- (battle-feel T2) a flurry's bite from the dash's edge: the held Forward (pose studs, scaled with the body below)
		local fwd = num(ps.Forward, 0)
		if fwd ~= 0 then
			body = CFrame.new(0, 0, -fwd) * body
		end
		local blend = num(ps.Blend, 1)
		if type(ps.Prev) == "table" and blend < 1 then
			local pf = num(ps.Prev.Forward, 0)
			local prevBody = poseBody(ps.Prev)
			if pf ~= 0 then
				prevBody = CFrame.new(0, 0, -pf) * prevBody
			end
			body = prevBody:Lerp(body, clamp(blend, 0, 1))
			if blend < 0.5 then
				pose = ps.Prev
			end
		end
	else
		local hold = u.poseHold or {}
		u.poseHold = hold
		if down and u.koAt then
			hold.Name, hold.P, hold.Ranged = "Ko", clamp((now - u.koAt) / K.KO_TIME, 0, 1), false
			src = "ko"
		elseif u.windup and not down and Atk.Drives(u) then
			hold.Name, hold.P, hold.Ranged = "Windup", min(K.WINDUP_HOLD, max(0, now - (u.windAt or now)) / K.WINDUP_IN * 0.5), u.ranged == true
			-- (Pitch 2 item 5) the melee wind-up rocks back about the hind paws (AttackFx.FeetOf: read once per model)
			hold.Feet = (not u.ranged and type(AF.FeetOf) == "function") and AF.FeetOf(u.model) or nil
			src = "hold"
		elseif Atk.Idles(u, down, busy) then
			hold.Name, hold.P, hold.Ranged = "IdleBattle", now + u.phase * K.IDLE_PHASE, false
			src = "idle"
		end
		if src then
			pose, body = hold, poseBody(hold)
		end
	end
	if src ~= u.poseSrc then
		-- the crossfade starts from what was shown (an IdleBattle keeps running while it fades out)
		u.poseSrc = src
		u.poseFrom = u.poseBody
		u.poseSwitch = now
		-- (look review r3 minor: "the first bite's snap is drawn softer than the mock": 0.12 s from the hit drew 0.069 of
		-- the knock-back's 0.106 at hit + 0.07; a re-hit, inside AttackFx, played in full) a hit's Hurt fades in over the
		-- hit stop, while its victim is held still: the knock-back after it is drawn at full strength
		u.poseFade = (src == "fx" and ps and ps.Name == "Hurt") and num(AF.HIT_STOP, 0.05) or num(AF.CROSSFADE, 0.12)
		local from = u.poseFromPose or {}
		u.poseFromPose = from
		from.Name, from.P, from.Ranged, from.Amp, from.Reach = u.poseShown, u.poseShownP, u.poseShownRanged, u.poseShownAmp, u.poseShownReach
	end
	if u.poseSwitch then
		local w = (now - u.poseSwitch) / num(u.poseFade, num(AF.CROSSFADE, 0.12))
		if w < 1 then
			body = (u.poseFrom or IDENTITY):Lerp(body or IDENTITY, max(0, w))
			local from = u.poseFromPose
			if w < 0.5 and from and from.Name then
				if from.Name == "IdleBattle" then
					from.P = now + u.phase * K.IDLE_PHASE
				end
				pose = from
			end
		else
			u.poseSwitch, u.poseFrom = nil, nil
		end
	end
	u.poseBody = body
	u.poseShown = pose and pose.Name or nil
	u.poseShownP = pose and pose.P or nil
	u.poseShownRanged = pose and pose.Ranged or nil
	u.poseShownAmp = pose and pose.Amp or nil
	u.poseShownReach = pose and pose.Reach or nil
	u.poseLast, u.poseScaled = pose, nil
	if not body then
		return pose, nil
	end
	local s = u.pbScale
	if not s then
		s = (u.model and num(u.model:GetAttribute("PB_Scale"), nil)) or K.PET_SCALE * (u.scale or 1)
		u.pbScale = s
	end
	if s ~= 1 then
		local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = body:GetComponents()
		body = CFrame.new(x * s, y * s, z * s, r00, r01, r02, r10, r11, r12, r20, r21, r22)
	end
	u.poseScaled = body
	return pose, body
end

----------------------------------------------------------------------
-- Telegraphs (boss attacks) and zones
----------------------------------------------------------------------
function Tele.Start(B, ev)
	local id = ev.id
	if id == nil or B.teles[id] then
		return
	end
	local fill, edge = Color3.fromRGB(255, 110, 90), Color3.fromRGB(255, 220, 160)
	local BB = lazyBoss()
	local boss = ev.boss and B.units[ev.boss]
	local bossId = (boss and boss.bossId) or B.BossId
	if BB and bossId then
		local ok, f, e = pcall(BB.TelegraphColor, bossId, ev.attack)
		if ok and typeof(f) == "Color3" then
			fill = f
			if typeof(e) == "Color3" then
				edge = e
			end
		end
	end
	local hits = max(0.2, num(ev.hits, 1.5))
	local at = num(ev.at, B.renderT + hits)
	local tl = {
		id = id,
		lethal = ev.lethal == true, -- the enraged boss's lethal attack: a thicker rim in the late colour, the DASH! callout
		shape = ev.shape == "Line" and "Line" or "Circle",
		x = num(ev.x, 0),
		z = num(ev.z, 0),
		r = num(ev.r, 6),
		angle = num(ev.angle, 0),
		length = num(ev.length, 30),
		width = num(ev.width, 4),
		at = at,
		from = at - hits,
		-- the dodge deadline on the render clock: the render delay + the round trip + the run-out before the hit
		safeAt = max(at - hits + min(K.TELE_MIN_FILL, hits * 0.5), at - (interpDelay(B) + networkPing() + K.TELE_RUNOUT)),
		fill = fill,
		edgeColor = edge,
		freeze = ev.freeze,
	}
	-- the danger area: the pale edge colour tinted toward the fill, so it still shows on the pale arena sand
	local edgePart = Fx.Part(edge:Lerp(fill, 0.35), Enum.Material.Neon, 0.6)
	local fillPart = Fx.Part(fill, Enum.Material.Neon, 0.35)
	tl.edge, tl.fillPart = edgePart, fillPart
	if tl.shape == "Circle" then
		local cf = worldFrame(B, tl.x, 0.08, tl.z, 0) * CFrame.Angles(0, 0, pi / 2)
		if edgePart then
			edgePart.Shape = Enum.PartType.Cylinder
			edgePart.Size = Vector3.new(0.1, tl.r * 2, tl.r * 2)
			edgePart.CFrame = cf
		end
		if fillPart then
			fillPart.Shape = Enum.PartType.Cylinder
			fillPart.Size = Vector3.new(0.14, 0.1, 0.1)
			fillPart.CFrame = cf * CFrame.new(0.04, 0, 0)
		end
	else
		-- a line from (x, z) along angle (atan2(dz, dx) in zone space)
		local dx, dz = cos(tl.angle), sin(tl.angle)
		tl.dx, tl.dz = dx, dz
		local yaw = yawToward(dx, dz)
		tl.yaw = yaw
		if edgePart then
			edgePart.Size = Vector3.new(tl.width, 0.1, tl.length)
			edgePart.CFrame = worldFrame(B, tl.x + dx * tl.length / 2, 0.08, tl.z + dz * tl.length / 2, yaw)
		end
		if fillPart then
			fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, 0.1)
		end
	end
	-- a crisp rim in the saturated telegraph colour: the pale area alone barely reads on the arena's sand, the rim
	-- says exactly where safety starts (16 segments round a circle; two rails and an end cap along a line)
	local rimColor = tl.lethal and COLORS.LateRim or fill:Lerp(Color3.new(0, 0, 0), 0.22)
	local rimWidth = tl.lethal and 1.1 or 0.55
	local rimIn = rimWidth / 2 - 0.005
	tl.rimWidth, tl.rimColor = rimWidth, rimColor
	tl.rim = {}
	if tl.lethal then
		B.lethalPending = true
	end
	if tl.shape == "Circle" then
		local segLen = 2 * tl.r * math.tan(pi / 16) + 0.12
		for j = 0, 15 do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = Vector3.new(segLen, 0.16, rimWidth)
			seg.CFrame = worldFrame(B, tl.x, 0.14, tl.z, 0) * CFrame.Angles(0, j * pi / 8, 0) * CFrame.new(0, 0, -(tl.r - rimIn))
			tl.rim[#tl.rim + 1] = seg
		end
	else
		-- the frame of edgePart: local X across the line, local Z along it
		local mid = worldFrame(B, tl.x + tl.dx * tl.length / 2, 0.14, tl.z + tl.dz * tl.length / 2, tl.yaw)
		local tip = worldFrame(B, tl.x + tl.dx * (tl.length - rimIn), 0.14, tl.z + tl.dz * (tl.length - rimIn), tl.yaw)
		local pieces = {
			{ mid * CFrame.new(tl.width / 2 - rimIn, 0, 0), Vector3.new(rimWidth, 0.16, tl.length) },
			{ mid * CFrame.new(-(tl.width / 2 - rimIn), 0, 0), Vector3.new(rimWidth, 0.16, tl.length) },
			{ tip, Vector3.new(tl.width, 0.16, rimWidth) },
		}
		for _, piece in ipairs(pieces) do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = piece[2]
			seg.CFrame = piece[1]
			tl.rim[#tl.rim + 1] = seg
		end
	end
	B.teles[id] = tl
	-- the boss winds up toward it
	if boss and boss.isBoss then
		Units.SetPose(boss, "Windup", hits, ev.attack)
		boss.windupFrom = tl.from
		boss.windupAt = tl.at
		if tl.shape == "Line" then
			boss.faceX, boss.faceZ = tl.x + (tl.dx or 0) * 10, tl.z + (tl.dz or 0) * 10
		else
			boss.faceX, boss.faceZ = tl.x, tl.z
		end
	end
end

function Tele.Free(tl)
	Fx.Free(tl.edge)
	Fx.Free(tl.fillPart)
	tl.edge, tl.fillPart = nil, nil
	for _, seg in ipairs(tl.rim or {}) do
		Fx.Free(seg)
	end
	tl.rim = nil
end

local function setRim(tl, transparency)
	for _, seg in ipairs(tl.rim or {}) do
		seg.Transparency = transparency
	end
end

-- is the zone-local point (x, z) inside the telegraph's shape (grown by pad studs)?
function Tele.Covers(tl, x, z, pad)
	local dx, dz = x - tl.x, z - tl.z
	if tl.shape == "Line" then
		local along = dx * (tl.dx or 1) + dz * (tl.dz or 0)
		if along < -pad or along > tl.length + pad then
			return false
		end
		return abs(dx * (tl.dz or 0) - dz * (tl.dx or 1)) <= tl.width / 2 + pad
	end
	return dx * dx + dz * dz <= (tl.r + pad) * (tl.r + pad)
end

-- (feel-balance review) the studs a melee, non-boss unit rests farther out (BattleSim standoffOf; 0 for a ranged unit or a boss)
function Tele.StandoffOf(u)
	if not u or u.ranged or u.isBoss then
		return 0
	end
	local so = BattleCatalog and type(BattleCatalog.Damage) == "table" and tonumber(BattleCatalog.Damage.Standoff)
	return (so and so > 0) and so or 0
end

-- (feel-balance review) where the server counts my striking melee pet: its BITE POINT (BattleSim Strike.point), the rest
-- spot moved toward its target by the free gap down to the Standoff-0 rest spot (range + the target's radius - 0.5), at most
-- the standoff (half of the gap while a melee target strikes back: both points are returned). The wire carries no body
-- point, so the client works it out the same way from the unit's target -> x, z, hx, hz | nil (no standoff, no target,
-- already at the edge)
function Tele.BitePoint(B, u)
	local so = Tele.StandoffOf(u)
	local tg = so > 0 and u.target and B.units[u.target] or nil
	if not tg or tg.hp <= 0 then
		return nil
	end
	local dx, dz = tg.x - u.x, tg.z - u.z
	local d = sqrt(dx * dx + dz * dz)
	local gap = d - (u.range + tg.radius - 0.5)
	if gap <= 0 or d < 0.01 then
		return nil
	end
	local adv = min(so, gap)
	local half = Tele.StandoffOf(tg) > 0 and min(so, gap * 0.5) or adv
	return u.x + dx / d * adv, u.z + dz / d * adv, u.x + dx / d * half, u.z + dz / d * half
end

-- my fighter's body reaches a telegraph that has not hit yet (the HUD's DASH cue: dash through it): the sim's own test,
-- the shape + the unit's radius, so every pet it would hit is warned. (feel-balance review) A melee pet with a standoff is
-- hit at its bite point while it strikes, so a shape over its bite point warns too (the sim's scripted player dodges on it)
local function threatened(B, tl)
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED then
			if Tele.Covers(tl, u.x, u.z, u.radius) then
				return u
			end
			local bx, bz, hx, hz = Tele.BitePoint(B, u)
			if bx and (Tele.Covers(tl, bx, bz, u.radius) or Tele.Covers(tl, hx, hz, u.radius)) then
				return u
			end
		end
	end
	return nil
end

function Tele.Update(B, now)
	local t = B.renderT
	local threat = false
	for id, tl in pairs(B.teles) do
		if not threat and B.Fighter and t < tl.at and threatened(B, tl) then
			threat = true
		end
		-- the lethal attack: the engaged pet does not follow the walking trainer, so the Dash is the escape and the copy says so
		if tl.lethal and B.Fighter and t < tl.at and now >= (tl.calloutAt or 0) then
			local inside = threatened(B, tl)
			if inside and inside.root then
				tl.calloutAt = now + K.LETHAL_CALLOUT
				Fx.Number(inside.root, (inside.height or 3) / 2 + 2.6, "DASH!", COLORS.LateRim, K.CRIT_PX, K.LETHAL_CALLOUT)
			end
		end
		if t >= tl.at then
			if not tl.impactAt then
				tl.impactAt = now
				if tl.lethal then
					B.lethalPending = false
				end
				-- the hit: a flash of the shape + a shock ring / burst
				local center
				if tl.shape == "Circle" then
					center = worldPoint(B, tl.x, 0.4, tl.z)
					Fx.Ring(center, tl.r, tl.edgeColor, 18, 0.9, 0.45, 0.05)
					Fx.Burst(center, tl.fill, 12, 12, 0.6, 0.55, { up = 0.9, color2 = tl.edgeColor })
				else
					local mid = worldPoint(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2)
					Fx.Beam(worldFrame(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2, tl.yaw), tl.length, tl.width * 0.8, tl.fill, 0.4)
					Fx.Burst(mid, tl.edgeColor, 8, 10, 0.5, 0.5, { up = 0.7 })
				end
				if tl.freeze then
					local c = worldPoint(B, tl.x, 0.6, tl.z)
					Fx.Burst(c, COLORS.Ice, 10, 9, 0.55, 0.6, { material = Enum.Material.Glass, alpha = 0.2, up = 0.8 })
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05
				end
				local boss = B.boss
				if boss and boss.pose == "Windup" then
					Units.SetPose(boss, "Attack", 0.7)
					boss.windupAt = nil
				end
			end
			local p = (now - tl.impactAt) / 0.35
			if p >= 1 then
				Tele.Free(tl)
				B.teles[id] = nil
			else
				if tl.edge then
					tl.edge.Transparency = 0.6 + 0.4 * p
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05 + 0.95 * p
				end
				setRim(tl, 0.1 + 0.9 * p)
			end
		else
			-- the fill completes at the dodge deadline (safeAt), then the shape flashes until the hit
			local fillEnd = tl.safeAt or tl.at
			local p = clamp((t - tl.from) / max(0.05, fillEnd - tl.from), 0, 1)
			if t >= fillEnd then
				if not tl.late then
					tl.late = true
					for _, seg in ipairs(tl.rim or {}) do
						seg.Color = COLORS.LateRim
					end
				end
				local on = sin(now * 26) > 0
				if tl.edge then
					tl.edge.Transparency = on and 0.25 or 0.65
				end
				setRim(tl, on and 0 or 0.6)
			else
				local pulse = 0.5 + 0.5 * sin(now * 10)
				if tl.edge then
					tl.edge.Transparency = 0.5 + 0.2 * pulse
				end
				setRim(tl, 0.05 + 0.3 * pulse)
			end
			if tl.fillPart then
				if tl.shape == "Circle" then
					local d = max(0.1, tl.r * 2 * p)
					tl.fillPart.Size = Vector3.new(0.14, d, d)
				else
					local len = max(0.1, tl.length * p)
					tl.fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, len)
					tl.fillPart.CFrame = worldFrame(B, tl.x + tl.dx * len / 2, 0.12, tl.z + tl.dz * len / 2, tl.yaw)
				end
				tl.fillPart.Transparency = 0.45 - 0.25 * p
			end
		end
	end
	B.threat = threat
end

function Tele.ClearAll(B)
	for id, tl in pairs(B.teles) do
		Tele.Free(tl)
		B.teles[id] = nil
	end
	B.lethalPending = false
end

----------------------------------------------------------------------
-- Events (played on the delayed render clock)
----------------------------------------------------------------------
local function specialColor(u, kind)
	if u and u.special and typeof(u.special.Color) == "Color3" then
		return u.special.Color
	end
	if u then
		return elementColor(u.element)
	end
	if kind == "Heal" then
		return COLORS.Heal
	end
	return COLORS.Gold
end

local numberHeight = Fx.NumberHeight -- (Pitch 2 item 04: moved up, Fx.Total needs it)

----------------------------------------------------------------------
-- wave 6: the trainer's cheer (TrainerCheer): my avatar loops the cheer emote while the server holds me on the podium
-- (Config.Attr.OnPodium: Champion Ring / PvP) and plays it once on my own Cheer event (Cheer up!, dungeon / raid).
-- Only my avatar: Roblox replicates a character's animation to everyone else. No sound (the sound wave).
----------------------------------------------------------------------
local Cheer = {}

function Cheer.Mod()
	if Mods.Cheer == nil then
		Mods.Cheer = optional(script.Parent, "TrainerCheer") or false
	end
	return Mods.Cheer or nil
end

-- the podium attribute -> the loop
function Cheer.SyncPodium()
	local m = Cheer.Mod()
	if not m then
		return
	end
	local attr = (Config.Attr and Config.Attr.OnPodium) or "OnPodium"
	if LocalPlayer and LocalPlayer:GetAttribute(attr) == true then
		if not m.IsLooping() then
			m.StartLoop(LocalPlayer.Character)
		end
	else
		m.StopLoop()
	end
end

-- my own Cheer up! landed on the server: one cheer (the button's glow and sweep start on arrival: Net.Pre)
function Cheer.Mine()
	local m = Cheer.Mod()
	if m and LocalPlayer then
		m.Play(LocalPlayer.Character)
	end
end

local Handlers = {}

Handlers[EV.Hit] = function(B, ev)
	local victim = B.units[tonumber(ev.to) or -1]
	local attacker = ev.from and B.units[tonumber(ev.from) or -1]
	if not victim then
		return
	end
	local dmg = num(ev.dmg, 0)
	-- (Task 11b, fix round 1 I1 / M2) a held unit's drawn HP follows each hit's number: the hold's floor drops by this
	-- hit's damage (a plain hit's on time, a late Special's at its impact; never under a last gasp's floor). A late
	-- Special's hit ends the hold only when it is the last one due: another special's hold on the unit stays
	if victim.holdHp and not ev.miss then
		victim.holdHp = max(victim.holdFloor or 0, victim.holdHp - dmg)
	end
	if ev.fxSpHeld and (not victim.holdUntil or os.clock() >= victim.holdUntil - K.HOLD_EPS) then
		Units.Unhold(victim)
	end
	-- AttackFx (played on arrival): a pet's plain attack (its swipe / shot, its Strike pose, the victim's Hurt pose) or
	-- my pet's hurt from a boss; false = the cube bolt / lunge / nudge below
	local played = Atk.Result(B, ev)
	-- Phase 5: a dodged hit (dash i-frames / out of reach at the impact); wave 6: a parried one already said PARRY!
	if ev.miss then
		if victim.root and not victim.parked and not ev.parry then
			Fx.Number(victim.root, numberHeight(victim) + 0.4, "DODGED!", COLORS.Dodge, K.CALLOUT_PX, 0.9)
		end
		if attacker and not attacker.isBoss then
			local dx, dz = victim.x - attacker.x, victim.z - attacker.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				attacker.lungeAt = os.clock()
				attacker.lungeX, attacker.lungeZ = dx / d, dz / d
				attacker.lungeFx = played and Atk.Posable()
			end
		end
		return
	end
	-- attacker motion: plain attacks lunge (melee) or shoot a bolt (ranged); my fighter too (it attacks by itself:
	-- its lunges come only from these server hits, never from a press). (evolved forms: a Thorns or Double strike hit is no swing)
	if attacker and not ev.special and not ev.zone and not ev.tele and not ev.element and not ev.thorns and not ev.double then
		if attacker.isBoss then
			if attacker.pose ~= "Windup" and attacker.pose ~= "Attack" and attacker.pose ~= "Enrage" then
				Units.SetPose(attacker, "Basic", 0.6, ev.attack)
				attacker.faceX, attacker.faceZ = victim.x, victim.z
			end
			Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.7, 0.35)
		else
			local dx, dz = victim.x - attacker.x, victim.z - attacker.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				attacker.lungeAt = os.clock()
				attacker.lungeX, attacker.lungeZ = dx / d, dz / d
				attacker.lungeFx = played and Atk.Posable() -- (the Strike pose replaces the lunge offset)
			end
			if not played and attacker.ranged and attacker.model and not attacker.parked then
				Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.42, 0.24)
			end
		end
	end
	-- my fighter hit hard: a tiny camera shake (x the Shake setting)
	if victim.mine and B.Fighter and victim.id == B.fighterId and dmg >= victim.maxHp * 0.12 then
		Me.Shake(0.18, 0.16)
	elseif victim.mine and B.Fighter and victim.id == B.fighterId and B.Mode == "Dungeon" and dmg > 0 then
		Me.Shake(K.HIT_SHAKE_LIGHT[1], K.HIT_SHAKE_LIGHT[2]) -- wave 5 (bug #15): a light shake on every hit in a dungeon
	end
	-- victim feedback
	if not victim.isBoss and attacker then
		local dx, dz = victim.x - attacker.x, victim.z - attacker.z
		local d = sqrt(dx * dx + dz * dz)
		if d > 0.01 then
			victim.hurtAt = os.clock()
			victim.hurtX, victim.hurtZ = dx / d, dz / d
			-- the Hurt pose instead of the nudge: this hit's effect played, or a played special / element covers it
			victim.hurtFx = Atk.Posable() and (played or (victim.fxHitUntil ~= nil and victim.hurtAt <= victim.fxHitUntil))
		end
	end
	if not ev.zone or math.random() < 0.5 then
		Fx.Flash(victim, (ev.elem and ev.elem > 1) and Color3.fromRGB(255, 226, 190) or COLORS.White)
	end
	local adornee = victim.root
	if not adornee or victim.parked then
		return
	end
	-- (Pitch 2 item 04 B) the pop: '+' .. Theme.Short in the kit's colours (Fx.HitLook), beside the target's running total
	local text, color, px = Fx.HitLook(dmg, ev, attacker and attacker.element or nil)
	if victim.mine and color == Theme.Sign.Stone then
		color = Color3.fromRGB(255, 196, 196) -- my unit's hurt (a plain hit)
	end
	if ev.special and attacker and not ev.crit then
		color = specialColor(attacker):Lerp(COLORS.White, 0.35)
		px = max(px, K.HIT_ELEM_PX)
	end
	if dmg > 0 then
		-- (look review r1, M3) the target's pops stack a line apart (Fx.Pop), beside its total
		Fx.Pop(victim, adornee, numberHeight(victim), text, color, px, dmg)
		-- (audio wave 2) the attacker's element hit (+ Crit's sparkle on top); a burn / zone tick is silent (they come
		-- in bursts), so is a hit with no attacker or element
		if not ev.burn and not ev.zone and attacker and type(attacker.element) == "string" then
			local scale = Me.HearScale(B, victim)
			Me.Sfx("Hit" .. attacker.element, scale)
			if ev.crit then
				Me.Sfx("Crit", scale)
			end
		end
	end
	if num(ev.absorbed, 0) > 0 then
		Fx.Number(adornee, numberHeight(victim) + 0.8, "BLOCK " .. tostring(floor(ev.absorbed + 0.5)), COLORS.Shield, K.NUMBER_PX - 2, 0.8)
	end
	if ev.freeze then
		victim.iceUntil = os.clock() + num(ev.freeze, 2)
	end
end

Handlers[EV.Special] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local kind = tostring(ev.kind or "")
	local color = specialColor(u, kind)
	local S = SPECIALS[kind] or {}
	-- AttackFx (played on arrival) draws the special; the cube Fx.* below only when it did not (the callout, the heal
	-- numbers and the shield / ice bookkeeping stay either way)
	local cubes = not Atk.Result(B, ev)
	if u and u.root and not u.parked then
		local label = tostring(ev.name or kind)
		Fx.Number(u.root, numberHeight(u) + 0.6, string.upper(label) .. "!", color:Lerp(COLORS.White, 0.2), K.CALLOUT_PX, K.SPECIAL_CALLOUT)
		if cubes then
			Fx.Burst(unitCenter(B, u), color, 8, 6, 0.35, 0.45, { up = 0.9, gravity = 4 })
		end
	end
	local tx, tz = num(ev.tx, num(ev.x, 0)), num(ev.tz, num(ev.z, 0))
	if not cubes then
		for _, h in ipairs(kind == "Heal" and type(ev.heals) == "table" and ev.heals or {}) do
			local a = B.units[tonumber(h[1]) or -1]
			if a and a.root and not a.parked and num(h[2], 0) > 0 then
				Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(h[2], 0) + 0.5)), COLORS.Heal, K.NUMBER_PX)
			end
		end
		local seconds = num(S.Seconds, 6)
		for _, id in ipairs(kind == "Shield" and type(ev.shields) == "table" and ev.shields or {}) do
			local a = B.units[tonumber(id) or -1]
			if a then
				-- (its later absorbed hits ripple in u's look while the shield lasts: Atk.ShieldHit)
				a.shieldUntil = os.clock() + seconds + 0.5
				a.shieldBy = u and u.id or nil
			end
		end
		local stun = num(S.Stun, 1) + 0.4
		for _, id in ipairs(kind == "Freeze" and type(ev.stunned) == "table" and ev.stunned or {}) do
			local a = B.units[tonumber(id) or -1]
			if a then
				a.iceUntil = os.clock() + stun
			end
		end
	elseif kind == "Blast" then
		local c = worldPoint(B, tx, 0.6, tz)
		local r = areaOf(ev.r, num(S.Radius, 7), u)
		Fx.Ring(c, r, color, 20, 0.8, 0.5, 0.05)
		Fx.Burst(c + Vector3.new(0, 0.8, 0), color, 16, 13, 0.6, 0.6, { color2 = COLORS.White:Lerp(color, 0.4), up = 0.8 })
	elseif kind == "Heal" then
		for _, h in ipairs(type(ev.heals) == "table" and ev.heals or {}) do
			local a = B.units[tonumber(h[1]) or -1]
			if a and a.root and not a.parked then
				Fx.Rise(unitCenter(B, a), COLORS.Heal, 8, 0.32, 0.9, 1.6)
				if num(h[2], 0) > 0 then
					Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(h[2], 0) + 0.5)), COLORS.Heal, K.NUMBER_PX)
				end
			end
		end
	elseif kind == "Shield" then
		local seconds = num(S.Seconds, 6)
		for _, id in ipairs(type(ev.shields) == "table" and ev.shields or {}) do
			local a = B.units[tonumber(id) or -1]
			if a and a.root and not a.parked then
				Fx.Ring(unitCenter(B, a), 2.2, COLORS.Shield, 10, 0.4, 0.5, 0.2)
			end
			if a then
				a.shieldUntil = os.clock() + seconds + 0.5
				a.shieldBy = u and u.id or nil
			end
		end
	elseif kind == "Pounce" then
		if u then
			local a = worldPoint(B, num(ev.x, u.x), 1.4, num(ev.z, u.z))
			local b = worldPoint(B, tx, 1.4, tz)
			Fx.Trail(a, b, color, 9, 0.5)
			u.hopAt = os.clock()
		end
		Fx.Burst(worldPoint(B, tx, 1.2, tz), color, 12, 11, 0.5, 0.55, { up = 0.7, color2 = COLORS.White })
	elseif kind == "Freeze" then
		local c = worldPoint(B, tx, 0.5, tz)
		local r = areaOf(ev.r, num(S.Radius, 6), u)
		Fx.Ring(c, r, COLORS.Ice, 16, 0.7, 0.55, 0.1)
		Fx.Burst(c + Vector3.new(0, 0.6, 0), COLORS.Ice, 14, 10, 0.55, 0.7, { material = Enum.Material.Glass, alpha = 0.15, up = 0.8, color2 = COLORS.White })
		local stun = num(S.Stun, 1) + 0.4
		for _, id in ipairs(type(ev.stunned) == "table" and ev.stunned or {}) do
			local a = B.units[tonumber(id) or -1]
			if a then
				a.iceUntil = os.clock() + stun
			end
		end
	elseif kind == "Beam" then
		local length = areaOf(ev.length, num(S.Length, 26), u)
		local width = areaOf(ev.width, num(S.Width, 4), u)
		local angle = num(ev.angle, 0)
		local dx, dz = cos(angle), sin(angle)
		local sx, sz = num(ev.x, u and u.x or 0), num(ev.z, u and u.z or 0)
		local cf = worldFrame(B, sx + dx * length / 2, 1.6, sz + dz * length / 2, yawToward(dx, dz))
		Fx.Beam(cf, length, width * 0.7, color, 0.5)
		Fx.Burst(worldPoint(B, sx + dx * length, 1.6, sz + dz * length), color, 8, 8, 0.4, 0.45, { up = 0.5 })
	elseif kind == "Rally" or kind == "Haste" then
		if u and u.model and not u.parked then
			Fx.Rise(unitCenter(B, u), kind == "Haste" and COLORS.Dodge or COLORS.Gold, 12, 0.34, 0.9, 1.8)
		end
	elseif kind == "Storm" then
		-- the Zone event that follows draws the cloud
		Fx.Burst(worldPoint(B, tx, 5, tz), COLORS.StormLight, 6, 5, 0.6, 0.5, { up = 0.3, gravity = 2 })
	end
end

Handlers[EV.Zone] = function(B, ev)
	local kind = tostring(ev.kind or "")
	local x, z = num(ev.x, 0), num(ev.z, 0)
	local r = num(ev.r, 6)
	local seconds = max(0.5, num(ev.seconds, 4))
	local floorCF = worldFrame(B, x, 0, z, 0)
	if kind == "Storm" then
		local u = B.units[tonumber(ev.unit) or -1]
		-- AttackFx's Storm special rains from its own cloud: the zone then draws only its damage field on the floor
		local field = u and u.stormFxUntil ~= nil and os.clock() <= u.stormFxUntil
		Fx.Zone(floorCF, r, seconds, specialColor(u, "Storm"), field and "Field" or "Storm")
	elseif kind == "Patch" then
		-- (evolved forms) a form's burning ground (Patch, Inferno): the disc of its real r in the colour of the special or the element it came from, the Field's dim tail after it
		local special = tostring(ev.special or "")
		Fx.Zone(floorCF, r, seconds, SPECIALS[special] and specialColor(B.units[tonumber(ev.unit) or -1], special) or elementColor(special), "Field")
	else
		local color = Color3.fromRGB(255, 120, 60)
		local BB = lazyBoss()
		if BB and B.BossId then
			local ok, f = pcall(BB.TelegraphColor, B.BossId, ev.attack)
			if ok and typeof(f) == "Color3" then
				color = f
			end
		end
		Fx.Zone(floorCF, r, seconds, color, "Linger")
	end
end

Handlers[EV.KO] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return
	end
	Units.Unhold(u) -- (Task 11b) a KO held for a late Special's impact (or a last gasp) plays now
	if St.pre and St.pre.unit == u.id then
		Atk.Shatter(B, true) -- (fix round 1, I3) my pressed fighter went down before its Special: the charge just fades
	end
	if B.casts and B.casts[u.id] then
		Atk.EndCast(B, u.id, true) -- (battle-feel T3) a caster KO'd in its cast: the server dropped it, its charge fades
	end
	Atk.Result(B, ev) -- AttackFx's Ko (played on arrival) marks the pet poofed: no cube poof below, it tumbles and lies
	if u.root and not u.parked then
		Fx.Number(u.root, numberHeight(u) + 0.4, "KO!", Color3.fromRGB(220, 226, 240), K.CALLOUT_PX, 1.1)
		-- (audio wave 2) KO: one of 4 files, never the same twice in a row; a boss's louder
		local scale = Me.HearScale(B, u)
		Me.Sfx("KO", scale and scale * (u.isBoss and K.SFX_BOSS_KO or 1), true)
		if not u.isBoss and not u.poofed then
			u.poofed = true
			Fx.Burst(unitCenter(B, u), Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
		elseif u.isBoss then
			Fx.Burst(unitCenter(B, u), elementColor(u.element), 24, 16, 0.9, 1.1, { color2 = COLORS.White, up = 0.9 })
		end
	end
	u.hp = 0
	u.state = S_DOWN
	Atk.EndAura(u.id) -- (evolved forms) its buff is over: the aura and the bigger pet end with it
	Me.UndimCaster(u.id) -- (Task 11) a knocked-out caster's battle dim ends with it (its effect may still finish its beats)
	if B.lock == u.id then
		B.lock = nil
	end
	Hud.enemyDirty = true
	if u.mine and u.id == B.fighterId then
		Me.Shake(0.3, 0.3)
	end
end

Handlers[EV.Telegraph] = function(B, ev)
	Tele.Start(B, ev)
end

Handlers[EV.Spawn] = function(B, ev)
	Units.AddList(B, ev.units)
	if ev.wave then
		B.wave = num(ev.wave, 0)
		local boss = B.boss
		if boss and boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "MINIONS!", COLORS.Enemy:Lerp(COLORS.White, 0.3), K.CALLOUT_PX, 1.4)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.Enrage] = function(B, ev)
	B.enraged = true
	local boss = B.units[tonumber(ev.unit) or -1] or B.boss
	if boss and boss.model then
		local BB = lazyBoss()
		if BB then
			pcall(BB.SetEnraged, boss.model, true)
		end
		Units.SetPose(boss, "Enrage", 1.3)
		if boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "ENRAGED!", COLORS.Enemy, K.CRIT_PX, 1.6)
		end
		Fx.Ring(unitCenter(B, boss), 14, COLORS.Enemy, 24, 1, 0.8, 0.1)
	end
	if B.Fighter then
		Me.EdgeHold(COLORS.Enemy)
	end
end

Handlers[EV.Order] = function()
	-- (handled on arrival: Net.Pre)
end

-- (Units.Remove ends each leaver's own AttackFx effects and pose: AttackFx.Cancel)
Handlers[EV.Leave] = function(B, ev)
	for _, id in ipairs(type(ev.units) == "table" and ev.units or {}) do
		local u = B.units[tonumber(id) or -1]
		if u then
			if u.root and not u.parked then
				Fx.Burst(unitCenter(B, u), Color3.fromRGB(226, 232, 246), 8, 7, 0.45, 0.5, { alpha = 0.1 })
			end
			Units.Remove(B, u.id)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.End] = function(B)
	B.simEnded = true
	-- the fight is over (Review Focus 4, Ruling 11): no new attack effect from here; the live ones (the killing blow
	-- lands visibly) finish for at most FX_END_GRACE, then AttackFx.ClearAll (Atk.Update)
	Atk.EndSoon(B)
end

-- Phase 5 events (the visuals, on the render clock; the HUD / prediction side runs on arrival in Net.Pre)
local function calloutAbove(u, text, color, px, life)
	if u and u.root and not u.parked then
		Fx.Number(u.root, numberHeight(u) + 0.8, text, color, px or K.CALLOUT_PX, life or 1.1)
	end
end

Handlers[EV.Element or "Element"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local color = elementColor(ev.element or (u and u.element))
	local sx, sz = num(ev.x, u and u.x or 0), num(ev.z, u and u.z or 0)
	local angle = num(ev.angle, 0)
	local shape = tostring(ev.shape or "Cone")
	local played = Atk.Result(B, ev) -- AttackFx (played on arrival): the shape in the element's textures + the cast pose
	calloutAbove(u, string.upper(tostring(ev.name or ev.element or "")) .. "!", color:Lerp(COLORS.White, 0.25))
	if played then
		return
	end
	if u and u.id ~= B.fighterId then
		u.hopAt = os.clock()
	end
	local dx, dz = cos(angle), sin(angle)
	if shape == "Circle" then
		local ranged = u and u.ranged -- (evolved forms: a ranged pet's Circle stands on its aim point)
		local c = worldPoint(B, ranged and num(ev.tx, sx) or sx, 0.6, ranged and num(ev.tz, sz) or sz)
		Fx.Ring(c, elementAreaOf(ev.r, 8, u), color, 22, 0.8, 0.5, 0.05)
		Fx.Burst(c + Vector3.new(0, 0.8, 0), color, 14, 11, 0.55, 0.55, { color2 = COLORS.White, up = 0.8 })
	elseif shape == "Line" then
		local length = elementAreaOf(ev.length, 24, u)
		local cf = worldFrame(B, sx + dx * length / 2, 1.6, sz + dz * length / 2, yawToward(dx, dz))
		Fx.Beam(cf, length, 3 * areaOf(ev.width, 4, u) / 4, color, 0.45)
	else
		-- a cone: bursts fanned out in front of the caster, as far as it reaches
		local far = elementAreaOf(ev.length, 14, u) / 14
		for i = -2, 2 do
			local a = angle + i * 0.22
			local r = (9 + abs(i) * 0.8) * far
			Fx.Burst(worldPoint(B, sx + cos(a) * r, 1.2, sz + sin(a) * r), color, 5, 7, 0.45, 0.45, { up = 0.6, color2 = COLORS.White })
		end
		Fx.Trail(worldPoint(B, sx, 1.3, sz), worldPoint(B, sx + dx * 11 * far, 1.3, sz + dz * 11 * far), color, 8, 0.4)
	end
end

-- the PET dashes (the character never does, decision 5): every pet's Dash draws its streak; my own fighter's already
-- started when the event arrived (Net.Pre: no render delay for my own dodge)
-- (evolved forms) a form's delayed hit: AttackFx (played on arrival) draws it, the cube ring when it did not; the name over the caster when the recipe calls it out, the heal and shield
-- numbers and the shield's bookkeeping either way (its damage comes as Hit events)
Handlers[EV.Twist or "Twist"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local kind = tostring(ev.kind or "")
	local color = SPECIALS[kind] and specialColor(u, kind) or elementColor(kind)
	local played = Atk.Result(B, ev)
	local twists = Mods.FxCat and Mods.FxCat.Twists
	local tw = type(twists) == "table" and twists[tostring(ev.twist)] or nil
	if tw and tw.Callout then
		calloutAbove(u, string.upper(tw.Name) .. "!", color:Lerp(COLORS.White, 0.2))
	end
	for _, h in ipairs(type(ev.heals) == "table" and ev.heals or {}) do
		local a = B.units[tonumber(h[1]) or -1]
		if a and a.root and not a.parked and num(h[2], 0) > 0 then
			Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(h[2], 0) + 0.5)), COLORS.Heal, K.NUMBER_PX)
		end
	end
	for _, id in ipairs(type(ev.shields) == "table" and ev.shields or {}) do
		local a = B.units[tonumber(id) or -1]
		if a then
			-- (its later absorbed hits ripple in u's look while the shield lasts: Atk.ShieldHit)
			a.shieldUntil = os.clock() + num(SPECIALS.Shield and SPECIALS.Shield.Seconds, 6) + 0.5
			a.shieldBy = u and u.id or nil
			if a.root and not a.parked and num(ev.amount, 0) > 0 then
				Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(ev.amount, 0) + 0.5)), COLORS.Shield, K.NUMBER_PX - 2)
			end
		end
	end
	if not played and tonumber(ev.x) and tonumber(ev.z) then
		Fx.Ring(worldPoint(B, tonumber(ev.x), 0.6, tonumber(ev.z)), num(ev.r, 4), color, 14, 0.6, 0.5, 0.05)
	end
end

Handlers[EV.Dash or "Dash"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if u and u.dashEv ~= ev then
		Me.StartDash(B, u, ev)
	end
end

-- wave 6: a timed Dash parried the threat (BattleSim's Parry): "PARRY!" in gold over the pet, a short gold ring + flash
-- (Low graphics: the callout only). The parried telegraph's Hit (miss + parry) shows no DODGED! and plays no hit: the
-- Parry sound plays from here only (audio wave 2; my own pets' parries)
Handlers[EV.Parry or "Parry"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return
	end
	St.parries = (St.parries or 0) + 1
	calloutAbove(u, "PARRY!", COLORS.Gold, K.CALLOUT_PX, 1.1)
	if u.mine then
		Me.Sfx("Parry", 1)
	end
	if not St.fxLow and u.root and not u.parked then
		Fx.Ring(unitCenter(B, u), 2.2, COLORS.Gold, 10, 0.35, 0.35, 0.05)
		Fx.Flash(u, COLORS.Gold, 0.25)
	end
end

-- wave 6: Cheer up! (dungeon / raid): only my own avatar cheers here (the others' avatars replicate)
Handlers[EV.Cheer or "Cheer"] = function(B, ev)
	if tonumber(ev.owner) == myUserId() then
		Cheer.Mine(B, ev)
	end
end

Handlers[EV.Buff or "Buff"] = function(B, ev)
	local helper = B.units[tonumber(ev.unit) or -1]
	local fighter = B.units[tonumber(ev.target) or -1]
	local color = (helper and elementColor(helper.element)) or COLORS.Heal
	local played = Atk.Result(B, ev) -- AttackFx: the support special the buff is like, on the fighter
	if helper and helper.mine then
		helper.flyAt = os.clock() -- fly to the fighter and back
	end
	local bdef = BattleCatalog and type(BattleCatalog.Buffs) == "table" and BattleCatalog.Buffs[tostring(ev.kind)] or nil
	if helper and fighter and type(bdef) == "table" and bdef.Effect == "Shield" then
		-- (the shield's later absorbed hits ripple in the helper's look while it lasts: Atk.ShieldHit)
		fighter.shieldBy = helper.id
		fighter.shieldUntil = os.clock() + num(bdef.Seconds, 6) + 0.5
	end
	if fighter then
		calloutAbove(fighter, string.upper(tostring(ev.name or ev.kind or "BUFF")), color:Lerp(COLORS.White, 0.2), K.CALLOUT_PX, 1.4)
		if not played and fighter.model and not fighter.parked then
			Fx.Rise(unitCenter(B, fighter), color, 10, 0.32, 0.9, 1.6)
		end
	end
end

Handlers[EV.Swap or "Swap"] = function(B, ev)
	local incoming = B.units[tonumber(ev["in"]) or -1]
	Atk.EndAura(tonumber(ev.out) or -1) -- (evolved forms: it left the floor, its aura does not wait for it)
	-- (fix round 2, I2-b) a held auto-swap: the incoming pet leaves the bench now (another player's is unparked for its
	-- GO!), and my two pets trade places now (Me.Switch; Net.Pre left it for this moment)
	if incoming and incoming.unbenchAt then
		incoming.unbenchAt = nil
		if not incoming.mine and incoming.state ~= S_BENCHED then
			incoming.benched = false
			parkUnit(incoming, false)
		end
	end
	if ev.fxSwitchLate and B.Fighter and not B.ended and ev.owner == myUserId() then
		Me.Switch(B, ev)
	end
	local played = Atk.Result(B, ev) -- AttackFx: the incoming pet's entrance (Victory)
	if incoming and incoming.model and not incoming.parked then
		calloutAbove(incoming, ev.auto and "GO!" or "SWAP!", COLORS.Dodge, K.CALLOUT_PX, 1)
		if not played then
			Fx.Burst(unitCenter(B, incoming), elementColor(incoming.element), 10, 8, 0.45, 0.45, { up = 0.7, color2 = COLORS.White })
		end
	end
	-- (my pets' arc starts at the trade: Me.Switch)
end

Handlers[EV.Windup or "Windup"] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if u then
		-- the list row's "!" until the hit lands (at = sim time of the hit)
		u.windupUntil = os.clock() + max(0.2, num(ev.at, B.renderT + 0.45) - B.renderT) + 0.1
		-- (battle-feel T2) a melee pet dashes in to land its bite on the hit's time (at = its sim time, on the render clock)
		local v = B.units[tonumber(ev.target) or -1]
		if v and not u.ranged and not u.isBoss and Atk.Dash(B, u, v, os.clock() + max(0.05, num(ev.at, B.renderT + 0.45) - B.renderT)) then
			u.dashedAt = os.clock()
		end
	end
end

-- (battle-feel T3) the server's real cast plays: the list row's "!" until its effects land (at = their sim time); the
-- charge itself started on the event's arrival (Atk.Cast)
Handlers[EV.Cast or "Cast"] = function(B, ev)
	Atk.Result(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if u then
		u.windupUntil = os.clock() + max(0.2, num(ev.at, B.renderT + 0.5) - B.renderT) + 0.1
	end
end

-- (battle-feel T3) a stun (or a retreat) broke the cast before it landed: the charge shatters (shards on mine, an
-- enemy's just fades); its meter stays full on the server
Handlers[EV.CastBreak or "CastBreak"] = function(B, ev)
	local id = tonumber(ev.unit) or -1
	local u = B.units[id]
	if u then
		u.windupUntil = nil
	end
	Atk.EndCast(B, id, not (u and u.mine))
end

-- dungeon fixes (root cause A): the server opens a room's encounter with an EMPTY side 2 ("Start") and spawns every
-- wave afterwards: the Wave event carries the enemies, so they are added here (deduped by id, like Spawn)
Handlers[EV.Wave or "Wave"] = function(B, ev)
	Units.AddList(B, ev.units)
	B.wave = num(ev.index, B.wave or 0)
	if B.Dungeon then
		B.Dungeon.Wave = B.wave
	end
	local f = B.fighterId and B.units[B.fighterId]
	calloutAbove(f, "WAVE " .. tostring(B.wave) .. "!", Theme.Neon and Theme.Neon.Purple or COLORS.Gold, K.CRIT_PX, 1.4)
	Hud.enemyDirty = true
	Hud.Rebuild()
end

Handlers[EV.EnemiesDown or "EnemiesDown"] = function(B)
	local f = B.fighterId and B.units[B.fighterId]
	calloutAbove(f, "WAVE CLEARED!", COLORS.Mine, K.CALLOUT_PX, 1.2)
end

-- (the HUD side: on arrival, Net.Pre) (evolved forms) a Haste's aura ends the moment its buff ends: the Speed event says so, a little ahead of the aura's own count when the
-- render clock has drifted. A slow moves the speed too: an aura with more than AURA_SNAP left runs on
Handlers[EV.Speed or "Speed"] = function(B, ev)
	local AF = Mods.AttackFx
	if not AF or type(AF.AuraLeft) ~= "function" then
		return
	end
	for _, u in ipairs(B.list) do
		if u.owner == ev.owner and not u.benched then
			local ok, left = pcall(AF.AuraLeft, u.id)
			if ok and left and left <= K.AURA_SNAP then
				Atk.EndAura(u.id)
			end
		end
	end
end

-- bug #22: my pet leaves me to fight (the server's engage rule): the arrival hop = "it goes"; nothing else (no parts,
-- the same on Low graphics); another player's pet just moves with its snapshots
Handlers[EV.Engage or "Engage"] = function(B, ev)
	if ev.on ~= true or not B.fighterId or tonumber(ev.unit) ~= B.fighterId then
		return
	end
	local u = B.units[B.fighterId]
	if u and u.model and not u.parked then
		u.hopAt = os.clock()
	end
	Hud.enemyDirty = true
end

-- the End: plays every queued event that is not held for a flying shot, in order; true when held ones are left
function Net.PlayUnheld(B)
	local q = B.evq
	local items = {}
	for i = 1, #q do
		items[i] = q[i]
	end
	for i = #q, 1, -1 do
		q[i] = nil
	end
	local held = false
	for _, item in ipairs(items) do
		if item.held then
			q[#q + 1] = item
			held = true
		else
			local fn = Handlers[item.ev.type]
			if fn then
				local ok, err = pcall(fn, B, item.ev)
				if not ok then
					warnOnce("event_" .. tostring(item.ev.type), "event " .. tostring(item.ev.type) .. " failed: " .. tostring(err))
				end
			end
		end
	end
	return held
end

function Net.PlayDue(B, now)
	local q = B.evq
	if #q == 0 then
		return
	end
	local played = 0
	local t = B.renderT
	while #q > 0 and (q[1].t <= t or #q > 400) do
		local item = table.remove(q, 1)
		local fn = Handlers[item.ev.type]
		if fn then
			local ok, err = pcall(fn, B, item.ev)
			if not ok then
				warnOnce("event_" .. tostring(item.ev.type), "event " .. tostring(item.ev.type) .. " failed: " .. tostring(err))
			end
		end
		played = played + 1
		if played > 120 then
			break
		end
	end
end

----------------------------------------------------------------------
-- HUD (Phase 5, contract 4.7: the battle HUD of image 24.png on the Neon kit)
----------------------------------------------------------------------
-- kit-b U6: the battle HUD's texts sit on their cards, chips and buttons, so they read by contrast with no outline (was
-- a classic stroke under a 2 px outline); the few that float over the arena with no plate pass world = true: ONE outline
-- (Theme Outline = "World")
local function label(parent, text, role, size, props, world)
	local l = Theme.Label(text, role, { Size = size, Outline = world and "World" or nil })
	l.BackgroundTransparency = 1
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

-- a pill's face and its text colour together (kit B: no outline; Theme.ReadableFace: the ink that reads on the face, a
-- mid tone darkened a little so its small text reaches 4.5:1); use it whenever a pill changes colour later
local function paintPill(pill, color)
	local face, ink = Theme.ReadableFace(color, 4.5)
	pill.BackgroundColor3 = face
	pill.TextColor3 = ink
end

-- (kit-b U9-6) a kit B edge: the wood line round a block (UIStroke "SignEdge", mitred corners: square)
local function signEdge(obj, color, thickness)
	local edge = obj:FindFirstChild("SignEdge")
	if not edge then
		edge = make("UIStroke", { Name = "SignEdge", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Miter }, obj)
	end
	edge.Color = color or KB.Edge
	edge.Thickness = thickness or 2
	edge.Transparency = 0
	return edge
end

-- (kit-b U9-6) paints a Frame / TextLabel / TextButton as a kit B block in place: a flat face, the wood edge and a darker lip
-- along its bottom (Frame "Lip"; lipPx 0 = none); a text object gets the ink. Calling it again repaints (a state change)
local function signBlock(obj, face, lip, ink, lipPx, edgePx)
	obj.BackgroundTransparency = 0
	obj.BackgroundColor3 = face
	obj.BorderSizePixel = 0
	signEdge(obj, nil, edgePx)
	lipPx = lipPx or 4
	local l = obj:FindFirstChild("Lip")
	if not l and lipPx > 0 then
		l = make("Frame", { Name = "Lip", BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), ZIndex = obj.ZIndex }, obj)
	end
	if l then
		-- (LOOK-ui2: Swap's lip started 18 px in, the OK's floated 5 px up) a UIPadding lays out the Lip child too (PixelIcon.Lead's
		-- left inset, a LipPad): the lip reaches back out by it, flush on the edge, as CloudUI.SignBlock's
		local pad = obj:FindFirstChildOfClass("UIPadding")
		local function sync()
			local pl = pad and pad.PaddingLeft.Offset or 0
			local pr = pad and pad.PaddingRight.Offset or 0
			local pb = pad and pad.PaddingBottom.Offset or 0
			l.Position = UDim2.new(0, -pl, 1, pb)
			l.Size = UDim2.new(1, pl + pr, 0, l:GetAttribute("LipPx") or lipPx)
		end
		l:SetAttribute("LipPx", lipPx)
		sync()
		-- (merge kitb-look1 x U9-6) again whenever the padding changes: Lead's inset follows the window's rest scale since
		-- kitb-look1 (read once, Swap's lip sat 6 px out at 1920 x 1080)
		if pad and not pad:GetAttribute("LipWatch") then
			pad:SetAttribute("LipWatch", true)
			pad.Changed:Connect(sync)
		end
		l.BackgroundColor3 = lip or Theme.SignLipOf(face)
		l.Visible = lipPx > 0
	end
	if ink and (obj:IsA("TextButton") or obj:IsA("TextLabel")) then
		obj.TextColor3 = ink
	end
	return obj
end

-- a kit B tag (the pitch's .tag): a flat block of `color` in a wood edge, square, the ink that reads on it (Theme.ReadableFace)
local function smallPill(parent, text, color, props)
	local l = Theme.Label(text, "Heading", { Size = 15 })
	l.Name = "Pill"
	l.BackgroundTransparency = 0
	paintPill(l, color)
	l.BorderSizePixel = 0
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, 22)
	l.TextXAlignment = Enum.TextXAlignment.Center
	signEdge(l, KB.Edge, 2)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, l)
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

-- (LOOK-ui2, the owner's look bar: "every bar in the same pixel block-bar language"; were flat fills in a 1 px edge) a bar
-- of `count` kit blocks laid out in its box (SignKit.FitBlocks: whole-px blocks, a wood edge, the darker lip, the first
-- ones lit in `fill` / `fillLip`, the rest stone): the fighter's HP and ENERGY, the enemies', the boss's, a helper's buff.
-- opts: Size, Position, Gap (3), ZIndex. (kit-b gate U9 r4) every battle bar the kit's one Bar weight (SignKit.Sizes.Bar:
-- edge 2, lip 3; the HP's lip 4, the boss's 5 and the cooldown's 2 were three more weights). Returns { Root, count, lit }
local function blockBar(parent, name, count, fill, fillLip, opts)
	opts = opts or {}
	local row = SignKit.FitBlocks(parent, { Name = name, Count = count, Size = opts.Size or UDim2.fromScale(1, 1), Position = opts.Position,
		Gap = opts.Gap or 3, Weight = "Bar", Fill = fill, FillLip = fillLip, ZIndex = opts.ZIndex })
	return { Root = row, count = count, lit = -1 }
end

-- lights the first k blocks (a write only when k changed); returns k
local function setBlocks(b, k)
	k = clamp(floor(k), 0, b.count)
	if k ~= b.lit then
		b.lit = k
		SignKit.FillBlocks(b.Root, k)
	end
	return k
end

-- the blocks a share shows: a health keeps a block lit while any of it is left (1 hp = one block), a charge lights one
-- only when it is full
local function healthBlocks(frac, count)
	return (frac <= 0) and 0 or max(1, math.ceil(clamp(frac, 0, 1) * count - 1e-6))
end
local function chargeBlocks(frac, count)
	return floor(clamp(frac, 0, 1) * count + 1e-6)
end

-- (LOOK-ui2: the result card's and the Ring's timers were 6-8 px flat lines) a countdown: five gold kit blocks (the Dungeon
-- countdown's row), one goes out per fifth of the time. Returns { Root, count, lit }
local function timerBlocks(parent, name)
	local row = SignKit.BlockRow(parent, { Name = name, Count = 5, BlockW = 22, BlockH = 14, Gap = 4, LipPx = 3 })
	return { Root = row, count = 5, lit = -1 }
end
local function setTimer(b, frac)
	setBlocks(b, math.ceil(clamp(frac, 0, 1) * b.count - 1e-6))
end

-- a rough width of `text` in px at `size` (bold display fonts run ~0.62 em per character)
local function textWidth(text, size)
	return #tostring(text or "") * size * 0.62
end

-- (kit-b U9-6, the render gate: "TARGET" spilled out of its fixed 78 px tab) a pill at least as wide as its text at its drawn
-- size (the larger of Theme's width and the rough 0.62 em) with its padding (a lead icon's inset too) and 4 px to spare, and
-- AutomaticSize X on top: the engine, which knows the face's real widths, grows it further where the guess is short
local function fitPill(l, h)
	local pad = l:FindFirstChildOfClass("UIPadding")
	local inset = pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 16
	local ok, size = pcall(Theme.MeasureLabel, l)
	local tw = max((ok and typeof(size) == "Vector2") and size.X or 0, textWidth(l.Text, l.TextSize))
	-- (U9-6 review: "TARGET" in capitals is wider than the 0.62 em guess) the role's own width too, with its spare widening
	local role = l:GetAttribute("FontRole")
	local okR, sizeR = pcall(Theme.Measure, l.Text, role, l.TextSize)
	if role and okR and typeof(sizeR) == "Vector2" then
		tw = max(tw, sizeR.X)
	end
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(math.ceil(tw) + inset + 4, h or 22)
end

local function setText(lbl, text)
	if lbl and lbl.Text ~= text then
		lbl.Text = text
	end
end

local function setVisible(obj, on)
	if obj and obj.Visible ~= (on == true) then
		obj.Visible = on == true
	end
end

-- a kit B card (NeonKit.Card Skin "Sign": a flat face, the wood edge, a lip along its bottom in the card's role colour;
-- props.Face, default stone; a Theme panel when the kit is missing): { Root, Body, SetColor }
local function neonCard(parent, name, color, props)
	local c
	if Mods.NeonKit and type(Mods.NeonKit.Card) == "function" then
		local ok, result = pcall(Mods.NeonKit.Card, { Name = name, Skin = "Sign", Face = props and props.Face or KB.Face, Color = color, LipPx = props and props.LipPx or 6,
			Parent = parent, Size = props and props.Size, Class = props and props.Class })
		if ok and type(result) == "table" then
			c = result
		end
	end
	if not c then
		local f = Theme.Panel({ Name = name })
		f.Parent = parent
		c = { Root = f, Body = f, SetColor = function() end }
	end
	if props then
		for key, value in pairs(props) do
			if key ~= "Size" and key ~= "Glow" and key ~= "Floor" and key ~= "Class" and key ~= "Face" and key ~= "LipPx" then
				c.Root[key] = value
			end
		end
	end
	return c
end

-- the key hint chip (desktop / gamepad): a navy key cap in its gold edge, square (kit B)
local function keyChip(parent, text, props)
	local chip = make("Frame", { Name = "Key", BackgroundColor3 = SIGN.Navy, BorderSizePixel = 0, Size = UDim2.fromOffset(30, 24), ZIndex = 8 }, parent)
	signEdge(chip, SIGN.GoldLip, 2) -- (LOOK-ui2: was 1.5, between two pixels)
	local l = label(chip, text, "Heading", 15, { Name = "Text", Size = UDim2.fromScale(1, 1), ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = SIGN.Stone })
	if props then
		for key, value in pairs(props) do
			chip[key] = value
		end
	end
	return chip, l
end

-- the readability floor on this screen (screen px): MIN_TEXT_PX_TALL on a screen 1000 px tall or more, MIN_TEXT_PX below
-- (kit-b U9-6: the render gate's floors, ARCHITECTURE_V3's Readability rule)
function Hud.FloorPx()
	local cam = workspace.CurrentCamera
	local vy = cam and cam.ViewportSize.Y or 1080
	return (vy >= 1000) and K.MIN_TEXT_PX_TALL or K.MIN_TEXT_PX
end

-- (kit-b U9-6) the first of `texts` that fits `l`'s box on one line at the size it is drawn at (the floor's design size on a
-- small screen; Theme.MeasureLabel: the real width), else the last (cut at its end)
function Hud.SetFit(l, texts, m)
	local f = max(0.05, (m and m.F) or 1)
	local px = max(l:GetAttribute("BaseText") or l.TextSize, math.ceil(Hud.FloorPx() / f - 1e-6))
	local room = l.Size.X.Offset - 2 / f
	for i, text in ipairs(texts) do
		local ok, size = pcall(Theme.MeasureLabel, l, text, px)
		if i == #texts or (ok and typeof(size) == "Vector2" and size.X <= room) then
			setText(l, text)
			return text
		end
	end
end

-- every HUD text stays >= the floor on the screen: design sizes grow to the floor / factor on small screens
-- (the 1080p design sizes are kept as the attribute BaseText)
function Hud.FixText(root, factor)
	local minDesign = math.ceil(Hud.FloorPx() / max(0.05, factor) - 1e-6)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			local base = d:GetAttribute("BaseText")
			if type(base) ~= "number" then
				base = d.TextSize
				d:SetAttribute("BaseText", base)
			end
			local want = max(base, minDesign)
			if d.TextSize ~= want then
				d.TextSize = want
			end
		end
	end
end

local function setDisabled(b, disabled)
	if (b:GetAttribute("Disabled") == true) ~= (disabled == true) then
		b:SetAttribute("Disabled", disabled == true)
	end
end

-- (kit-b U7b) the HUD's icons are PixelIcons (they were emoji): an element's, an action button's, the lives' hearts, a
-- boss's crown, the evolution stars; a D-pad key hint is its arrow (KEY_ICON)
local ELEMENT_ICON = {
	Water = "drop",
	Flame = "flame",
	Frost = "flake",
	Nature = "leaf",
	Earth = "mountain",
	Storm = "bolt",
	Celestial = "sparkle",
	Shadow = "moon",
}
local ICON = {
	Target = "target",
	Special = "star",
	Dash = "dash",
	Swap = "swap",
	Heart = "heart",
	Crown = "crown",
	Star = "star",
}
local KEY_ICON = { DPadDown = "down", DPadUp = "up", DPadRight = "arrow", DPadLeft = "left", Shift = "shift" } -- (the word would spill out of the 30 px chip)

function Hud.Ensure()
	if Hud.gui and Hud.gui.Parent then
		return true
	end
	local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end
	local old = playerGui:FindFirstChild(K.GUI_NAME)
	if old then
		old:Destroy()
	end
	local gui = make("ScreenGui", {
		Name = K.GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.DISPLAY_ORDER,
		Enabled = true,
	}, playerGui)
	local root = make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	Hud.scale = make("UIScale", { Name = "ReadScale", Scale = 1 }, root)
	Hud.gui, Hud.root = gui, root
	Hud.team = make("Frame", { Name = "Team", BackgroundTransparency = 1, Visible = false }, root)
	Hud.enemies = make("Frame", { Name = "Enemies", BackgroundTransparency = 1, Visible = false }, root)
	Hud.top = make("Frame", { Name = "TopCard", BackgroundTransparency = 1, Visible = false, AnchorPoint = Vector2.new(0.5, 0) }, root)
	Hud.cmd = make("Frame", { Name = "Commands", BackgroundTransparency = 1, Visible = false, AnchorPoint = Vector2.new(1, 1) }, root)
	Hud.resultCard = neonCard(root, "ResultCard", SIGN.Gold, { Visible = false, Size = UDim2.fromOffset(K.RESULT_W, 200), LipPx = K.PLANK_LIP })
	Hud.result = Hud.resultCard.Root
	-- (Pitch 2 item 02 B: the head band in the result's colour carries the card's top; no nails on it, as the pitch draws it)
	Hud.rows = {}
	Hud.helpers = {}
	Hud.buttons = {}
	Hud.BuildFighter()
	Hud.BuildActions()
	Hud.BuildTop()
	-- (LOOK-ui2: under the ReadScale of 0.8 a 2 px edge drew 1.6 screen px, a 6 px lip 4.8) every wood edge and lip of the
	-- HUD, now and as rows / cards are added, on whole screen px (PixelIcon.WholeTree, kitb-look1's one helper)
	PixelIcon.WholeTree(root)
	return true
end

-- the screen in design pixels + the layout kind (Compact = a phone: touch, or a screen under 900 px wide / 600 high)
function Hud.Metrics()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	local f = Theme.ScreenFactor(vp.Y)
	local w = vp.X / f
	local h = max(200, vp.Y - inset) / f
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local compact = touch or vp.X < K.COMPACT_W or vp.Y < K.COMPACT_H
	return { W = w, H = h, F = f, Compact = compact, Touch = touch, Landscape = vp.X > vp.Y, VX = vp.X, VY = vp.Y, Inset = inset }
end

-- the key hints (keyboard / gamepad)
function Hud.KeyText(kind, index)
	if St.gamepad then
		-- (kit-b U7b) the D-pad by name: Hud.SetKey draws its arrow (KEY_ICON)
		return ({ Target = "X", Element = "Y", Special = "RB", Dash = "B", Retreat = "DPadDown", Buff = (index == 2) and "DPadUp" or "LB", Swap = (index == 2) and "DPadRight" or "DPadLeft" })[kind] or ""
	end
	return ({ Target = "F", Element = "E", Special = "Q", Dash = "Shift", Retreat = "R", Buff = tostring(index or 1), Swap = "hold " .. tostring(index or 1) })[kind] or ""
end

-- (kit-b U7b) a key chip's label: a D-pad key or Shift draws its PixelIcon arrow, any other key is its text
function Hud.SetKey(lbl, key)
	if not lbl then
		return
	end
	local icon = KEY_ICON[key]
	PixelIcon.Set(lbl, icon, 18)
	if not icon then
		setText(lbl, key)
	end
end

----------------------------------------------------------------------
-- the fighter card (top left) + the two helper portraits under it
----------------------------------------------------------------------
local function heart(parent, i)
	local l = label(parent, "", "Display", 20, { Name = "Heart" .. i, Size = UDim2.fromOffset(22, 22), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = KB.Life })
	PixelIcon.Host(l, ICON.Heart, 18) -- (kit-b U7b) lit / lost by its TextColor3
	return l
end

function Hud.BuildFighter()
	local team = Hud.team
	-- (kit-b U9-6) a stone card with its lip in the fighter's element colour (Hud.FillFighter)
	local card = neonCard(team, "Fighter", KB.Hp, { Size = UDim2.fromOffset(K.FC_W, K.FC_H), LipPx = 6 })
	Hud.fighterCard = card
	local body = card.Body
	local F = {}
	F.Name = label(body, "", "Heading", 26, { Name = "PetName", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = KB.Ink })
	F.Level = smallPill(body, "Lv 1", SIGN.Navy, { Name = "Level", AutomaticSize = Enum.AutomaticSize.None })
	F.Level.TextSize = 17
	F.Element = make("Frame", { Name = "Element", BackgroundColor3 = COLORS.Ally, BorderSizePixel = 0 }, body)
	signEdge(F.Element, KB.Edge, 2) -- (kit-b U9-6) the pitch's square element chip
	F.ElementGlyph = label(F.Element, "", "Display", 16, { Name = "Glyph", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	F.Stars = label(body, "", "Heading", 18, { Name = "Stars", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.GoldDeep })
	-- (LOOK-ui2: was a flat green fill with the number drawn across it) HP: ten kit blocks in the grass, the blocks a hit took
	-- flash red for the loss trail's K.LOSS_TIME, then go stone (Hud.Update); the number beside the row in the ink
	F.Hp = make("Frame", { Name = "Hp", BackgroundTransparency = 1 }, body)
	F.HpBar = blockBar(F.Hp, "Blocks", K.HP_BLOCKS, KB.Hp, KB.HpLip, { Gap = 3 })
	F.HpText = label(body, "", "Heading", 16, { Name = "HpText", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = KB.Ink })
	-- ENERGY (the special meter): ten sky blocks, all of them gold at 100
	F.Energy = make("Frame", { Name = "Energy", BackgroundTransparency = 1 }, body)
	F.EnergyBar = blockBar(F.Energy, "Blocks", K.HP_BLOCKS, KB.Energy, SIGN.SkyLip, { Gap = 3 })
	F.EnergyText = label(body, "ENERGY 0/100", "Label", 15, { Name = "EnergyText", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink })
	F.Lives = make("Frame", { Name = "Lives", BackgroundTransparency = 1 }, body)
	F.Hearts = {}
	for i = 1, 3 do
		F.Hearts[i] = heart(F.Lives, i)
	end
	Hud.F = F
	-- the helpers: a portrait each (a square pet tile with its ViewportFrame picture, the buff cooldown's blocks under it, Lv,
	-- the buff name, the SWAP chip, the key hint); tap = buff, hold 0.5 s = swap
	Hud.helperHolder = make("Frame", { Name = "Helpers", BackgroundTransparency = 1 }, team)
	for i = 1, 2 do
		Hud.helpers[i] = Hud.BuildHelper(i)
	end
end

function Hud.BuildHelper(i)
	local H = { index = i }
	local cell = make("Frame", { Name = "Helper" .. i, BackgroundTransparency = 1 }, Hud.helperHolder)
	H.Cell = cell
	-- (LOOK-ui2: a round portrait in a gradient pie ring, the last round family in kit B) a square tile: the light well a pet
	-- stands in (the pitch's pet card), the wood edge, a lip in the helper's element colour; the buff's cooldown is four kit
	-- blocks under the tile (gold as they come back), the countdown and KO a square navy veil over it
	H.Disc = make("Frame", { Name = "Disc", BackgroundTransparency = 1 }, cell)
	local face = make("TextButton", {
		Name = "Portrait",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = SIGN.PetWell,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
	}, H.Disc)
	H.FaceStroke = signEdge(face, KB.Edge, 2)
	H.Lip = make("Frame", { Name = "Lip", BackgroundColor3 = COLORS.Ally, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 4), ZIndex = 6 }, face)
	H.Face = face
	H.View = make("ViewportFrame", {
		Name = "View",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, -4),
		ZIndex = 5,
		Ambient = Color3.fromRGB(200, 205, 220),
		LightColor = Color3.fromRGB(255, 250, 235),
	}, face)
	-- (LOOK-ui2: was the pet's initial, a bare letter) the element's pixel icon until the picture is built
	H.Initial = label(face, "", "Display", 26, { Name = "Initial", Size = UDim2.new(1, 0, 1, -4), ZIndex = 6, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = KB.Ink })
	H.KO = label(face, "KO", "Title", 22, { Name = "KO", Size = UDim2.fromScale(1, 1), ZIndex = 7, Visible = false, TextColor3 = SIGN.Stone, BackgroundTransparency = 0.2, BackgroundColor3 = SIGN.Navy })
	-- (kit-b U9-6 review: a white number on the light well read 1.35:1) the buff countdown in stone on a navy veil over the
	-- tile: it reads over the well and over any pet, and the dimmed pet says it is cooling down
	H.Count = label(face, "", "Display", 24, { Name = "Count", Size = UDim2.fromScale(1, 1), ZIndex = 7, Visible = false, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = SIGN.Stone, BackgroundTransparency = 0.25, BackgroundColor3 = SIGN.Navy })
	H.Cd = blockBar(cell, "Cooldown", K.CD_BLOCKS, SIGN.Gold, SIGN.GoldLip, { Gap = 2 })
	H.Level = smallPill(cell, "Lv 1", SIGN.Navy, { Name = "Level", AutomaticSize = Enum.AutomaticSize.None, ZIndex = 8 })
	H.Level.TextSize = 16
	-- (LOOK-ui2: was white text in a navy outline on the arena, a smear on the cloud band) the buff's name on a stone tag
	H.Buff = smallPill(cell, "", KB.Face, { Name = "Buff", AutomaticSize = Enum.AutomaticSize.None, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6 })
	-- (kit-b U9-6) SWAP: a small stone block (Hud.Update greys it to the sunk well while it cannot swap)
	H.Swap = make("TextButton", { Name = "Swap", Text = "Swap", AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 6 }, cell)
	Theme.Style(H.Swap, "Button", { Size = 15 })
	PixelIcon.Lead(H.Swap, ICON.Swap) -- (kit-b U7b) the swap arrows before "Swap" / the countdown
	signBlock(H.Swap, KB.Face, SIGN.StoneLip, KB.Ink, K.SMALL_LIP, K.SMALL_EDGE)
	H.SwapStroke = H.Swap:FindFirstChild("SignEdge")
	H.SwapFill = make("Frame", { Name = "HoldFill", BackgroundColor3 = SIGN.Gold, BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(0, 1), ZIndex = 7, Visible = false }, H.Swap)
	H.Key = keyChip(cell, "1", { Name = "Key" })
	local index = i
	face.InputBegan:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			Input.HoldStart("portrait" .. index, index, os.clock())
		end
	end)
	face.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
			Input.HoldEnd("portrait" .. index)
		end
	end)
	H.Swap.Activated:Connect(function()
		Input.Helper("Swap", index)
	end)
	-- (P2 fix A look review r1, major 6: SWAP was 24 px tall on a phone) a thumb's 44 screen px: a clear hit pad (HitFor)
	-- over the block, sized and placed by Hud.PlaceHelper on a touch screen
	H.SwapHit = make("TextButton", { Name = "SwapHit", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 9,
		Visible = false }, cell) -- (beside the block, not in it: the icon's lead pads the block's children)
	H.SwapHit:SetAttribute("HitFor", "Swap")
	H.SwapHit.Activated:Connect(function()
		Input.Helper("Swap", index)
	end)
	return H
end

-- the pet picture of a helper (PetBuilder Low in the ViewportFrame, built once per unit)
function Hud.Portrait(H, u)
	if H.unitId == u.id and H.built then
		return
	end
	H.unitId = u.id
	H.built = true
	for _, c in ipairs(H.View:GetChildren()) do
		c:Destroy()
	end
	setText(H.Initial, "")
	PixelIcon.Set(H.Initial, ELEMENT_ICON[u.element] or ICON.Star, 27, KB.Ink)
	H.Initial.Visible = true
	if not PetBuilder then
		return
	end
	local ok = pcall(function()
		local def = Units.Def(u.info)
		if not def then
			return
		end
		local model = PetBuilder.Build(def, { Detail = "Low", Evolved = u.evo > 0 and u.evo or nil, Viewport = true })
		H.model = model
		local okBox, cf, size = pcall(model.GetBoundingBox, model)
		if not okBox or typeof(cf) ~= "CFrame" then
			cf, size = CFrame.new(), Vector3.new(3, 3, 3)
		end
		model.Parent = H.View
		local cam = make("Camera", { Name = "PortraitCamera", FieldOfView = 30 }, H.View)
		local r = max(size.X, size.Y, size.Z)
		local dist = r * 1.9 + 1
		local c = cf.Position + Vector3.new(0, size.Y * 0.08, 0)
		cam.CFrame = CFrame.new(c + Vector3.new(dist * 0.42, dist * 0.18, -dist * 0.9), c)
		H.View.CurrentCamera = cam
		H.Initial.Visible = false
	end)
	if not ok then
		H.Initial.Visible = true
	end
end

----------------------------------------------------------------------
-- the action cluster (bottom right): SPECIAL (big), TARGET, ELEMENT, DASH; cooldown rings, key chips on desktop
----------------------------------------------------------------------
local ACTIONS = { "Special", "Target", "Element", "Dash" }

function Hud.BuildActions()
	for _, kind in ipairs(ACTIONS) do
		local A = { kind = kind }
		local b = make("TextButton", {
			Name = kind .. "Button",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 2,
		}, Hud.cmd)
		A.Button = b
		-- (LOOK-ui2: round discs in a gradient pie ring with a see-through halo, next to U9-8's square RUN / DASH keycaps) a kit
		-- keycap as MovementController's: a square face in the role's colour (KB.Action) in a 3 px wood edge on its lip, the
		-- 27 / 18 px pixel glyph on it; cooling down, the face sinks into the well and the role's colour rises from its lip in
		-- whole 2 px steps (Charge) with the seconds on it; the dodge / full-special cue flips the edge and lip to opaque gold
		-- (DASH: sky) and back, no halo (Hud.PaintKey)
		local base = KB.Action[kind]
		local face = make("Frame", { Name = "Face", BackgroundColor3 = base, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 3 }, b)
		A.FaceStroke = signEdge(face, KB.Edge, K.KEY_EDGE)
		A.Face = face
		A.Lip = make("Frame", { Name = "Lip", BackgroundColor3 = Theme.SignLipOf(base), BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, K.KEY_LIP), ZIndex = 4 }, face)
		A.Charge = make("Frame", { Name = "Charge", BackgroundColor3 = base, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Visible = false, ZIndex = 4 }, face)
		A.Glyph = label(face, "", "Display", 30, { Name = "Glyph", Size = UDim2.fromScale(1, 1), ZIndex = 5, TextXAlignment = Enum.TextXAlignment.Center })
		A.Count = label(face, "", "Display", 26, { Name = "Count", Size = UDim2.fromScale(1, 1), ZIndex = 6, Visible = false, TextXAlignment = Enum.TextXAlignment.Center })
		A.role = base
		Hud.PaintFace(A, base)
		-- (kit-b U9-6) the name's stone tag: on touch over the lower part of the face (Hud.PlaceFaceName), on wide screens under
		-- the key (LOOK-ui2: it was white text in an outline floating on the arena)
		A.NamePlate = make("Frame", { Name = "NamePlate", BackgroundColor3 = KB.Face, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Visible = false, ZIndex = 7 }, b)
		signEdge(A.NamePlate, KB.Edge, 2)
		-- (Label: the narrower caption face, so "MARSHMALLOW" stays one word on one line)
		A.Caption = label(b, string.upper(kind), "Label", K.CAPTION_TEXT, { Name = "Caption", AnchorPoint = Vector2.new(0.5, 0), ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextWrapped = true, TextColor3 = KB.Ink })
		A.Key = keyChip(b, "", { Name = "Key", AnchorPoint = Vector2.new(0.5, 0.5) })
		Hud.SetKey(A.Key:FindFirstChild("Text"), Hud.KeyText(kind))
		if kind == "Element" then
			-- (Pitch 2 item 1b, the three keys' MOVE) the special's meter: GoldLight rising from the lip in whole KEY_STEP steps
			-- under the glyph (Hud.PaintKey); a full meter's HOLD tag on the key's top edge (Hud.PlaceHoldTag)
			A.Meter = make("Frame", { Name = "Meter", BackgroundColor3 = SIGN.GoldLight, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Visible = false, ZIndex = 4 }, face)
			A.HoldTag = label(b, "HOLD", "Label", K.CAPTION_TEXT, { Name = "HoldTag", AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = 9, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = KB.Ink })
			signBlock(A.HoldTag, KB.Face, SIGN.StoneLip, KB.Ink, 3, 2)
		end
		Hud.buttons[kind] = A
		local action = kind
		b.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
				A.pressed = true -- (LOOK-ui2) the face sinks onto its lip while held (Hud.PaintKey)
				Hud.PaintKey(A, os.clock())
				if action == "Target" then
					-- a tap fires on release, a hold of 0.4 s clears the lock; the hold remembers its input + button so a slide
					-- off the button (whose own InputEnded may never fire) cancels it instead of re-targeting
					Input.HoldStart("targetButton", 0, os.clock(), "Target", input, b)
				elseif A.three then
					Input.MoveBegan(input, b)
				else
					Input.Press(action, true)
				end
			end
		end)
		b.InputEnded:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1 then
				A.pressed = false
				Hud.PaintKey(A, os.clock())
			end
			if action == "Target" and (t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1) then
				Input.TargetButtonEnded(input)
			elseif action == "Element" and (t == Enum.UserInputType.Touch or t == Enum.UserInputType.MouseButton1) then
				Input.MoveEnded(input)
			end
		end)
	end
	Hud.leave = Leave.Make(Hud.root, 20)
	CheerUp.Make(Hud.root)
	Retreat.Make(Hud.root)
	AreaWarn.Make(Hud.root)
end

----------------------------------------------------------------------
-- the top card (top centre, under the Roblox bar): the mode line + timer; in raids / boss rooms the boss bar
----------------------------------------------------------------------
function Hud.BuildTop()
	local top = Hud.top
	-- (Pitch 2 item 06 A "One strip", .superpowers/slop-audit/round3/build/PITCH2/A_battle_hud/06_boss_bar_optA.png;
	-- kit-b U9-6 had four loose navy pieces) ONE stone card in its 3 px wood edge on a 5 px lip, as tall as everything in
	-- it (Hud.LayoutTop): row 1 the mode (a raid: the wood RAID tag, the boss's name, its tier) and the clock + timer, with
	-- LEAVE laid over the row's right end (Leave.Place; it stays Root.LeaveButton); a boss under it: the baked pixel head
	-- (Config.BossHeads, when its image is uploaded) and ONE sunk track holding the HP blocks and the number behind a 2 px
	-- divider; then the state pills, wrapped into rows where the card is narrow; the ring's pay pills last
	local mode = neonCard(top, "ModeCard", SIGN.StoneLip, { Size = UDim2.fromOffset(K.TOP_W, K.MODE_H), Face = SIGN.Stone, LipPx = 5 })
	Hud.modeCard = mode
	Hud.modeTag = label(mode.Body, "RAID", "Heading", 18, { Name = "ModeTag", Visible = false, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = SIGN.Stone, ZIndex = 2 })
	make("UIPadding", { Name = "LipPad", PaddingBottom = UDim.new(0, 4) }, Hud.modeTag)
	signBlock(Hud.modeTag, SIGN.Wood, SIGN.WoodDark, SIGN.Stone, 4, 2)
	signEdge(Hud.modeTag, SIGN.WoodDark, 2)
	Hud.mode = label(mode.Body, "", "Heading", 20, { Name = "Mode", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = KB.Ink, ZIndex = 2 })
	Hud.timer = label(mode.Body, "", "Display", 24, { Name = "Timer", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = KB.Ink, ZIndex = 2 })
	Hud.clock = PixelIcon.New(mode.Body, "clock", 18, KB.Muted)
	Hud.clock.Name = "Clock"
	Hud.clock.ZIndex = 2
	local boss = make("Frame", { Name = "BossBar", BackgroundTransparency = 1, Visible = false, ZIndex = 2 }, top)
	Hud.boss = boss
	-- row 1's boss name (a raid) in the ink at the Heading size, its tier in the muted ink after it
	Hud.bossName = label(boss, "", "Heading", 24, { Name = "BossName", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Ink, ZIndex = 2 })
	Hud.bossTier = label(boss, "", "Heading", 18, { Name = "Tier", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = KB.Muted, ZIndex = 2 })
	-- the boss's head: a sunk navy well in its wood edge, the baked pixel image inside (pixelated, never a blurry shrink)
	Hud.portrait = make("Frame", { Name = "Portrait", BackgroundColor3 = SIGN.NavyLip, BorderSizePixel = 0, Visible = false, ZIndex = 2 }, boss)
	signEdge(Hud.portrait, KB.Edge, 2)
	Hud.portraitImage = make("ImageLabel", { Name = "Head", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 3,
		ResampleMode = Enum.ResamplerMode.Pixelated, ScaleType = Enum.ScaleType.Fit }, Hud.portrait)
	-- (keys lane, look fixA r1: with no head uploaded the PC strip had no portrait and read as a generic bar) until the head's
	-- image id exists, a PC's slot keeps its place with the gold pixel crown in the sunk well (the uploaded head replaces it)
	Hud.portraitCrown = PixelIcon.New(Hud.portrait, "crown", 54, SIGN.Gold)
	if Hud.portraitCrown then
		Hud.portraitCrown.Name = "Crown"
		Hud.portraitCrown.AnchorPoint = Vector2.new(0.5, 0.5)
		Hud.portraitCrown.Position = UDim2.fromScale(0.5, 0.5)
		Hud.portraitCrown.ZIndex = 3
	end
	-- the track: wood (its 2 px edge) round the sunk well face; the blocks, the divider and the number on that face
	Hud.bossTrack = make("Frame", { Name = "Hp", BackgroundColor3 = KB.Edge, BorderSizePixel = 0, ZIndex = 2 }, boss)
	Hud.bossFace = make("Frame", { Name = "Face", BackgroundColor3 = SIGN.Well, BorderSizePixel = 0, ZIndex = 2 }, Hud.bossTrack)
	Hud.bossBar = blockBar(Hud.bossTrack, "Blocks", K.BOSS_BLOCKS, KB.Loss, SIGN.RedLip, { Gap = 3, ZIndex = 3 })
	Hud.bossDivider = make("Frame", { Name = "Divider", BackgroundColor3 = SIGN.WellEdge, BorderSizePixel = 0, ZIndex = 3 }, Hud.bossTrack)
	Hud.bossText = label(Hud.bossTrack, "", "Display", 20, { Name = "Text", TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = KB.Ink, ZIndex = 3 })
	Hud.pills = make("Frame", { Name = "Pills", BackgroundTransparency = 1, ZIndex = 2 }, top)
	-- (look review round 1: a narrow card, a tall phone's, dropped RAID) the RAID tag as the first pill where row 1 has no room
	Hud.raidPill = smallPill(Hud.pills, "RAID", SIGN.Wood, { Name = "RaidPill", LayoutOrder = 0, Visible = false, ZIndex = 2 })
	Hud.bossElement = smallPill(Hud.pills, "", KB.Loss, { Name = "Element", LayoutOrder = 1, ZIndex = 2 })
	Hud.enragePill = smallPill(Hud.pills, "Enraged", SIGN.Red, { Name = "Enraged", LayoutOrder = 2, Visible = false, ZIndex = 2 })
	PixelIcon.Lead(Hud.enragePill, "skull")
	Hud.minionPill = smallPill(Hud.pills, "", SIGN.Violet, { Name = "Minions", LayoutOrder = 3, Visible = false, ZIndex = 2 })
	Hud.playersPill = smallPill(Hud.pills, "", SIGN.Sky, { Name = "Players", LayoutOrder = 4, Visible = false, ZIndex = 2 })
	PixelIcon.Lead(Hud.playersPill, "people")
	Hud.wavePill = smallPill(Hud.pills, "", SIGN.Tile, { Name = "Wave", LayoutOrder = 5, Visible = false, ZIndex = 2 })
	-- (the tier as a pill where row 1 has no room for it, as the pitch's rule)
	Hud.tierPill = smallPill(Hud.pills, "", SIGN.Tile, { Name = "TierPill", LayoutOrder = 6, Visible = false, ZIndex = 2 })
	Ring.BuildInfo(top)
	Hud.info.ZIndex = 2
end

-- (Pitch 2 item 06 A) the boss head's image: Config.BossHeads[bossId] is a shared/TextureIds key; its id when uploaded
-- ("rbxassetid://<id>"), else nil (no portrait: the card is whole without it). Hud.Textures: a test's key -> id table
function Hud.BossHead(bossId)
	local key = bossId and Config.BossHeads and Config.BossHeads[bossId]
	if not key then
		return nil
	end
	local ids = Hud.Textures
	if ids == nil then
		if Mods.TextureIds == nil then
			Mods.TextureIds = false
			local module = Shared:FindFirstChild("TextureIds")
			if module then
				local ok, t = pcall(require, module)
				if ok and type(t) == "table" then
					Mods.TextureIds = t
				end
			end
		end
		ids = Mods.TextureIds or {}
	end
	-- (keys look r4: check.mjs asset-id) Config.Art builds the URI, the joiner's rule kept
	return Config.Art.TextureImage(ids[key])
end

-- (Pitch 2 item 06 A) a label's text that fits `room` design px on one line: its design size steps down from `size` to
-- `floor`, then the text is cut with "..." (never drawn past its box). Returns the width it takes (design px)
function Hud.FitLine(l, text, size, floor, room)
	local function width(t, s)
		local ok, m = pcall(Theme.Measure, t, l:GetAttribute("FontRole") or "Heading", s)
		-- (never under the face's ~0.56 em a letter, 4% to spare: a flat measure runs short of the drawn face)
		return max((ok and typeof(m) == "Vector2") and m.X or 0, #t * s * 0.56) * 1.04
	end
	local s = size
	while s > floor and width(text, s) > room do
		s = s - 2
	end
	s = max(s, floor)
	if width(text, s) > room then
		local cut = text
		while #cut > 1 and width(cut .. "...", s) > room do
			cut = cut:sub(1, -2)
		end
		text = cut .. "..."
	end
	l.TextSize = s
	l:SetAttribute("BaseText", s)
	setText(l, text)
	return math.ceil(width(text, s))
end

----------------------------------------------------------------------
-- the enemy list (right side): one row per living enemy, the LOCKED one first with a gold bracket + "TARGET"
----------------------------------------------------------------------
local function rowFor(i)
	local row = Hud.rows[i]
	if row then
		return row
	end
	row = {}
	-- (kit-b U9-6) a stone row in its wood edge with a stone lip (the locked one gold: the selected look), a square element
	-- stripe and chip, a square red HP bar, the gold bracket and the gold TARGET tag
	local f = make("TextButton", { Name = "Row" .. i, Text = "", AutoButtonColor = false, BorderSizePixel = 0 }, Hud.enemies)
	signBlock(f, KB.Face, SIGN.StoneLip, nil, K.SMALL_LIP, K.SMALL_EDGE)
	row.Stroke = f:FindFirstChild("SignEdge")
	row.Frame = f
	row.Stripe = make("Frame", { Name = "Element", BorderSizePixel = 0, BackgroundColor3 = COLORS.Ally }, f)
	row.Icon = make("Frame", { Name = "Icon", BorderSizePixel = 0, BackgroundColor3 = COLORS.Enemy, ZIndex = 2 }, f)
	row.IconStroke = signEdge(row.Icon, KB.Edge, 2)
	row.IconText = label(row.Icon, "", "Display", 20, { Name = "Glyph", Size = UDim2.fromScale(1, 1), ZIndex = 3, TextXAlignment = Enum.TextXAlignment.Center })
	row.Alert = label(row.Icon, "!", "Title", 24, { Name = "Alert", Size = UDim2.fromScale(1, 1), ZIndex = 4, Visible = false, TextColor3 = SIGN.Gold, BackgroundTransparency = 0, BackgroundColor3 = SIGN.RedLip })
	row.Name = label(f, "", "Body", 18, { Name = "PetName", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 2, TextColor3 = KB.Ink })
	-- (LOOK-ui2: was a 9 px flat red line in a 1 px edge) ten small red kit blocks on their lip
	row.Hp = blockBar(f, "Hp", K.HP_BLOCKS, KB.Loss, SIGN.RedLip, { Gap = 2, ZIndex = 2 })
	row.Bracket = make("Frame", { Name = "Bracket", BackgroundTransparency = 1, Size = UDim2.new(1, 8, 1, 8), Position = UDim2.fromOffset(-4, -4), Visible = false, ZIndex = 1 }, f)
	signEdge(row.Bracket, SIGN.Gold, 3)
	row.Target = smallPill(f, "TARGET", SIGN.Gold, { Name = "Target", Visible = false, ZIndex = 5 })
	row.Target.TextColor3 = KB.Ink
	local index = i
	f.Activated:Connect(function()
		local id = row.unitId
		if id then
			local B = St.battle
			if B and B.lock == id and (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
				BattleController.Focus(nil) -- tap the locked row again: clear
			else
				BattleController.Focus(id)
			end
		end
		return index
	end)
	Hud.rows[i] = row
	return row
end

-- the enemies the list shows, the locked one first (the rest in id order: rows reorder only on a KO / lock change)
function Hud.EnemyList(B)
	local out, locked = {}, nil
	for _, u in ipairs(B.list) do
		if not u.ally and not u.isBoss and u.hp > 0 and u.state ~= S_DOWN and u.state ~= S_BENCHED then
			if B.lock == u.id then
				locked = u
			else
				out[#out + 1] = u
			end
		end
	end
	table.sort(out, function(a, b)
		return a.id < b.id
	end)
	if locked then
		table.insert(out, 1, locked)
	end
	return out
end

-- lays the rows out (on Rebuild and when the set / the lock changed); returns the list's height
function Hud.LayoutEnemies(B, m)
	local list = Hud.EnemyList(B)
	Hud.enemyList = list
	local key = tostring(B.lock or 0)
	for _, u in ipairs(list) do
		key = key .. "," .. u.id
	end
	Hud.enemyKey = key
	local maxRows = m.Compact and K.ROWS_COMPACT or K.ROWS_MAX
	local w, h = m.Compact and K.ROW_W_COMPACT or K.ROW_W, m.Compact and K.ROW_H_COMPACT or K.ROW_H
	-- (keys look r5 c06: K.ROW_GAP's 6 design px left two rows' 2 px frames 0.8 px apart, and the locked row's gold bracket
	-- lay 2.4-3 px on row 2's frame and on "+n more" at every size) the list's parts keep their inks apart: after a row
	-- (under it or beside it) Hud.ListAir, after the first row (the locked one's place, Hud.EnemyList) its bracket's reach
	-- too, locked or not: a lock never moves the list (only Hud.Rebuild places Cheer up! and the cards around it)
	local rowAir, lockAir = Hud.ListAir(m, false), Hud.ListAir(m, true)
	local function gapAfter(i)
		return (i == 1) and lockAir or rowAir
	end
	local function rowTop(i) -- design px from the list's top to row i's
		local at = 0
		for j = 1, i - 1 do
			at = at + h + gapAfter(j)
		end
		return at
	end
	-- (kit-b) a portrait phone's list ends above the action keys under it (Hud.listKeys, set by Hud.Rebuild): a player's
	-- three strips (Cash, Gems, tokens) start it low enough on a 360 x 640 phone that its second row and "+n more" tag ran
	-- under DASH and TARGET. Its rows stop above the keys under the list; the tag goes under the list's right end, or under
	-- its left end where a key (DASH) stands under the right one. One row stays whatever the room
	local keys = Hud.listKeys
	local left, top = m.W - K.EDGE - w, Hud.listTop or K.EDGE
	-- (P2 fix A: under a portrait phone's boss strip the list starts under the HUD's strips, and its second row reached the
	-- screen's centre band at 390 x 844) there its rows stop above the band (Hud.BandTop), as the top card's do
	local bandRoom = (Hud.bandOn == true and Hud.BandMode(B, m)) and (Hud.BandTop(m) - top) or nil
	if Hud.listX then
		-- (P2 fix A r1) the list under the fighter's block (Hud.Rebuild): its rows stop above Cheer up! / Retreat
		left = Hud.listX
		bandRoom = Hud.listRoom or bandRoom
	end
	-- (keys look r3: at 640 x 360 the dungeon run chip's Leave, dropped under the list, stood 10 px above RUN, its shadow on
	-- it) the room a card that hangs under the list asked for (BattleController.ReserveUnderList, screen px) stays free
	-- above the keys under it
	local reserve = (Hud.listReserve or 0) / max(0.05, m.F)
	if reserve > 0 and keys then
		-- (the chip hangs at the list's right end, over MovementController's RUN on a wide phone: RUN counts there too)
		local run = Hud.TouchRects(m).run
		if type(run) == "table" then
			local f = max(0.05, m.F)
			local list = {}
			for _, k in ipairs(keys) do
				list[#list + 1] = k
			end
			list[#list + 1] = { X0 = run[1] / f, X1 = run[3] / f, Y0 = m.H - run[4] / f, Y1 = m.H - run[2] / f }
			keys = list
		end
	end
	local function room(x0, x1) -- a list-local span -> its design px from the list's top to the first key under it
		local out = bandRoom or math.huge
		for _, k in ipairs(keys or {}) do
			if k.X1 > left + x0 and k.X0 < left + x1 then
				out = min(out, k.Y0 - top - 4 - reserve)
			end
		end
		return out
	end
	local morePx = max(16, math.ceil(Hud.FloorPx() / max(0.05, m.F) - 1e-6))
	local function tagSide(rows) -- nil: no tag; else 1 (right end) / 0 (left end), false when neither has room
		local more = #list - min(#list, rows)
		if more <= 0 then
			return nil
		end
		local tagW = math.ceil(textWidth("+" .. more .. " more", morePx)) + 18
		local bottom = rowTop(rows) + h + gapAfter(rows) + 22
		if bottom <= room(w - tagW, w) then
			return 1
		end
		if bottom <= room(0, tagW) then
			return 0
		end
		if reserve > 0 and bottom <= room(0, tagW) + reserve then
			-- (keys look r3) the card the reserve keeps room for hangs under the list's right end: the tag goes beside it, at
			-- the left end, in the same band
			return 0
		end
		-- (P2 fix A r1) the list under the fighter's block: beside its last row, right of it, where no key stands there
		local beside = Hud.listX and Hud.TagBeside(m, left, top + rowTop(rows), h, more, keys, gapAfter(rows))
		if beside then
			return 2, beside
		end
		return false
	end
	if keys or bandRoom then
		while maxRows > 1 and (rowTop(maxRows) + h > room(0, w) or tagSide(maxRows) == false) do
			maxRows = maxRows - 1
		end
	end
	local n = min(#list, maxRows)
	local y = 0
	for i = 1, max(n, #Hud.rows) do
		local row = (i <= n) and rowFor(i) or Hud.rows[i]
		if row then
			row.Frame.Visible = i <= n
		end
		if i <= n then
			local u = list[i]
			local locked = B.lock == u.id
			row.unitId = u.id
			row.Frame.Size = UDim2.fromOffset(w, h)
			row.Frame.Position = UDim2.fromOffset(0, y)
			row.Stripe.Size = UDim2.fromOffset(5, h - 14)
			row.Stripe.Position = UDim2.fromOffset(6, 7)
			row.Stripe.BackgroundColor3 = elementColor(u.element)
			local icon = h - 10
			row.Icon.Size = UDim2.fromOffset(icon, icon)
			row.Icon.Position = UDim2.fromOffset(16, 5)
			-- (kit-b U9-6) the chip in the element's colour, its icon in the ink that reads on it (Theme.ReadableFace)
			row.Icon.BackgroundColor3, row.IconText.TextColor3 = Theme.ReadableFace(elementColor(u.element), 4.5)
			local boss = u.kind == "MiniBoss" or u.info.boss ~= nil
			-- (LOOK-ui2: a bare letter, "B" for both Bubble Axolotl and Bamboo Panda) a boss's crown, else its element's pixel icon
			PixelIcon.Set(row.IconText, boss and ICON.Crown or (ELEMENT_ICON[u.element] or ICON.Star), 18)
			local x = 16 + icon + 8
			row.Name.Position = UDim2.fromOffset(x, 3)
			row.Name.Size = UDim2.fromOffset(w - x - 10, h - 18)
			row.Name.TextSize = m.Compact and 16 or 18
			row.Name:SetAttribute("BaseText", row.Name.TextSize)
			-- (kit-b U9-6, the render gate: a phone's row cut "Wild Bamboo Panda") the name whole: "Wild" goes first when the row is short
			Hud.SetFit(row.Name, (u.info.wild and not boss) and { "Wild " .. u.name, u.name } or { u.name }, m)
			row.Hp.Root.Position = UDim2.fromOffset(x, h - 17)
			row.Hp.Root.Size = UDim2.fromOffset(w - x - 10, 10)
			row.Bracket.Visible = locked
			-- "TARGET": a gold tab standing on the locked row's top edge, all of it over the row (wide screens; a phone keeps the
			-- bracket only; U9-6 review: it hung 9 px into the row, over the name's end). The locked row is the first, so the
			-- tab has the K.TARGET_OVER band above the list to itself
			row.Target.Visible = locked and not m.Compact
			row.Target.AnchorPoint = Vector2.new(1, 1)
			row.Target.Position = UDim2.new(1, -10, 0, 2)
			-- (sized at the size Hud.FixText will draw it at: the floor's design size on a small screen)
			row.Target.TextSize = max(15, math.ceil(Hud.FloorPx() / max(0.05, m.F) - 1e-6))
			row.Target:SetAttribute("BaseText", 15)
			fitPill(row.Target, 22)
			-- (fix6b, look1 #5: from 1920 x 1200 up, a screen factor over 1, 'TARGET' ran 3.4 - 3.9 px past its tab: the box
			-- leant on AutomaticSize to grow past fitPill's 0.62 em guess, which it did not under the HUD's scale) the box as
			-- wide as the capitals need on its own: 0.72 em a capital (FredokaOne's run past Theme's measure), 0.58 any other
			-- character, 0.3 a space, its padding and fitPill's 4 px to spare
			local tpad = row.Target:FindFirstChildOfClass("UIPadding")
			local tin = tpad and (tpad.PaddingLeft.Offset + tpad.PaddingRight.Offset) or 16
			local tem = 0
			for ch in tostring(row.Target.Text):gmatch(".") do
				tem = tem + ((ch == " ") and 0.3 or (ch:match("%u") and 0.72 or 0.58))
			end
			local tneed = math.ceil(tem * row.Target.TextSize) + tin + 4
			if row.Target.Size.X.Offset < tneed then
				row.Target.Size = UDim2.fromOffset(tneed, 22)
			end
			-- (kit-b U9-6) the locked row is the selected card (the gold face, the ink edge); a boss's row keeps a gold lip
			row.Stroke.Color = locked and KB.Ink or KB.Edge
			row.Frame.BackgroundColor3 = locked and SIGN.Selected or KB.Face
			local lip = row.Frame:FindFirstChild("Lip")
			if lip then
				lip.BackgroundColor3 = (locked or boss) and SIGN.GoldLip or SIGN.StoneLip
			end
			row.hpKey = nil
			y = y + h + gapAfter(i)
		end
	end
	local more = #list - n
	-- (keys look r5 c06) the list's height as before: its last part's foot and K.ROW_GAP (the callers' measure); the tag
	-- keeps the last row's air (its bracket's when it is the locked one)
	local lastBottom = (n > 0) and (rowTop(n) + h) or 0
	y = (n > 0) and (lastBottom + K.ROW_GAP) or 0
	if not Hud.more then -- (the tag takes the old line's 22 + 2 px: the cluster under the list keeps its place)
		-- (LOOK-ui2: was outlined text on the arena) a stone tag under the list's right end
		Hud.more = smallPill(Hud.enemies, "", KB.Face, { Name = "More", AutomaticSize = Enum.AutomaticSize.None, AnchorPoint = Vector2.new(1, 0) })
	end
	Hud.more.Visible = more > 0
	if more > 0 then
		setText(Hud.more, "+" .. more .. " more")
		local px = morePx
		Hud.more.TextSize = px
		Hud.more:SetAttribute("BaseText", 16)
		local at, besideText = 1, nil
		if keys or Hud.listX then
			at, besideText = tagSide(n)
			at = at or 1
		end
		if besideText then
			setText(Hud.more, besideText) -- (Hud.TagBeside: "+n" where "+n more" has no room beside the row)
		end
		Hud.more.Size = UDim2.fromOffset(math.ceil(textWidth(Hud.more.Text, px)) + 18, 22)
		if at == 2 then
			-- (P2 fix A r1) beside the last row (Hud.TagBeside): the list keeps its rows' height
			Hud.more.AnchorPoint = Vector2.new(0, 0)
			Hud.more.Position = UDim2.fromOffset(w + gapAfter(n), lastBottom - h + floor((h - 22) / 2))
		else
			local side = at == 0 and 0 or 1
			Hud.more.AnchorPoint = Vector2.new(side, 0)
			Hud.more.Position = UDim2.fromOffset(side * w, lastBottom + gapAfter(n))
			y = lastBottom + gapAfter(n) + 24
		end
	end
	Hud.enemies.Size = UDim2.fromOffset(w, max(0, y - K.ROW_GAP))
	return y
end

----------------------------------------------------------------------
-- placement around the other GUIs (measured, not guessed)
----------------------------------------------------------------------
-- the bottom of the HUD's currency pills when they sit at the TOP (a landscape phone's top band / the top right),
-- in design px of our root (gui area below the top bar); 0 when they are elsewhere
function Hud.CurrencyTop(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local cur = hud and hud:FindFirstChild("Currency", true)
	if not cur or not cur:IsA("GuiObject") or not cur.Visible or cur.AbsoluteSize.X <= 0 then
		return 0, 0, 0
	end
	local p, s = cur.AbsolutePosition, cur.AbsoluteSize
	local f = max(0.05, m.F)
	if p.Y > m.VY * 0.3 then
		return 0, 0, 0 -- bottom left: not in our way at the top
	end
	return max(0, math.ceil((p.Y + s.Y) / f)), floor(p.X / f), math.ceil((p.X + s.X) / f)
end

-- the right edge (design px) of MenuController's tile column (NimbusMenu.MenuColumn; its frame keeps its place while
-- the tiles step aside), 0 when there is none
-- (LOOK-ui2) the menu column's box in our design px (Left, Top, Right, Bottom), nil when it is not shown
function Hud.MenuBox(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	local col = menu and menu:IsA("ScreenGui") and menu.Enabled and menu:FindFirstChild("MenuColumn", true)
	if not col or not col:IsA("GuiObject") or not col.Visible or col.AbsoluteSize.X <= 0 then
		return nil
	end
	local f = max(0.05, m.F)
	local dy = menu.IgnoreGuiInset and -m.Inset or 0
	local p, s = col.AbsolutePosition, col.AbsoluteSize
	return { Left = p.X / f, Top = (p.Y + dy) / f, Right = (p.X + s.X) / f, Bottom = (p.Y + dy + s.Y) / f }
end

function Hud.MenuRight(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	local col = menu and menu:IsA("ScreenGui") and menu.Enabled and menu:FindFirstChild("MenuColumn", true)
	if not col or not col:IsA("GuiObject") or not col.Visible or col.AbsoluteSize.X <= 0 then
		return 0
	end
	local right = (col.AbsolutePosition.X + col.AbsoluteSize.X) / max(0.05, m.F)
	if right > m.W * 0.3 then
		return 0 -- not a left column
	end
	return math.ceil(right)
end

-- Roblox's touch jump button + MovementController's RUN button (screen px, from the left / BOTTOM edge)
function Hud.TouchRects(m)
	local small = min(m.VX, m.VY) <= 500
	local jump = small and 70 or 120
	local jb = small and 20 or jump * 0.75
	local rects = { jump = { m.VX - jump * 1.5 - 10, jb, m.VX - jump * 0.5 - 10, jb + jump } }
	local mc = Hud.Movement()
	if mc and type(mc.MobileLayout) == "function" then
		local ok, l = pcall(mc.MobileLayout)
		if ok and type(l) == "table" and type(l.run) == "table" then
			rects.run = l.run
			rects.dash = type(l.dash) == "table" and l.dash or nil -- (Pitch 2 item 02 B, look review: the result card keeps off it)
		end
	end
	if not rects.run then
		local d = small and 66 or 84
		local right = max(14, jump + 10 - d * 0.5)
		local bottom = jb + jump + 10
		rects.run = { m.VX - right - d, bottom, m.VX - right, bottom + d }
	end
	return rects
end

-- (Pitch 2 item 1b, look review r1) the top of Roblox's thumbstick ring (design px from the gui area's top): its ring as
-- wide as the jump button (TouchRects' size), its foot 20 px over the area's bottom, as render_gui draws it
function Hud.StickRingTop(m)
	local j = (min(m.VX, m.VY) <= 500) and 70 or 120
	return m.H - (20 + j) / max(0.05, m.F)
end

-- a caption's box under its button, two lines of the size FixText will give it (design px)
function Hud.CaptionH(m)
	local px = max(K.CAPTION_TEXT, math.ceil(K.MIN_TEXT_PX / max(0.05, m.F) - 1e-6))
	return 2 * math.ceil(px * 1.2)
end

-- the action buttons' centres + diameters (design px, Commands-local; Commands is anchored at its bottom-right
-- corner = the gui area's bottom-right corner) and the cluster's size. Touch screens: the three keys (below), around
-- Roblox's jump button and the RUN button (MovementController: above the jump button wide, left of it tall).
function Hud.ClusterLayout(m)
	local big, small = K.ATTACK_D, K.ACTION_D
	local out = {}
	if not (m.Compact and m.Touch) then
		out.Special = { -74, -98, big }
		out.Target = { -74 - big / 2 - 26 - small / 2, -90, small }
		-- (Element's tag may take two lines between it and SPECIAL; LOOK-ui2: a stone tag K.TAG_GAP under the key's edge)
		out.Element = { -74, -98 - big / 2 - max(36, Hud.CaptionH(m) + 4 + K.TAG_GAP + 2 * K.KEY_EDGE + 2) - small / 2, small }
		out.Dash = { -74 - big / 2 - 26 - small / 2, -98 - big / 2 - 28 - small / 2, small }
		out.w, out.h = 236, 270
		-- (keys look r5 c05: at 1280 x 720 SPECIAL's two-line name tag would pass the screen's foot, so it took one 222 px line
		-- and pushed TARGET's tag 67 px off its key; 06 A keeps every tag under its key) the cluster stands high enough for
		-- a two-line tag under SPECIAL (Hud.PlaceCaptionUnder's size: the floor's design size, its 2 px frame and 2 px kept
		-- above the foot); no name moves a key
		local f = max(0.05, m.F)
		local px = max(K.CAPTION_TEXT, math.ceil(Hud.FloorPx() / f - 1e-6))
		local foot = out.Special[2] + big / 2 + K.KEY_EDGE + K.TAG_GAP + 2 * math.ceil(px * 1.2) + 2 + 4 / f
		local lift = math.ceil(max(0, foot))
		if lift > 0 then
			for _, kind in ipairs({ "Special", "Target", "Element", "Dash" }) do
				out[kind][2] = out[kind][2] - lift
			end
			out.h = out.h + lift
		end
		return out
	end
	-- (Pitch 2 item 1b, option C "Three buttons", the owner's pick 2026-11-20: .superpowers/slop-audit/round3/build/PITCH2/
	-- A_battle_hud/repitch/01b_optC*.png, the spots of repitch_01b.py layout_C; it replaced the four-key phone cluster) the
	-- right thumb has three named keys that never move or hide: MOVE (the ELEMENT key: a tap = the element; a full meter turns
	-- it gold with a HOLD tag and a hold fires the SPECIAL, Input.MoveBegan), DASH and RUN (MovementController's, 48 px). No
	-- SPECIAL and no TARGET key: TARGET is automatic (a tap on an enemy locks it, Units.UpdateLock's LOCKED marker). Every
	-- spot comes from Roblox's jump button alone (never the names, the vitals or the list), so no state moves a key
	local f = max(0.05, m.F)
	local jump = Hud.TouchRects(m).jump -- screen px { left, bottom, right, top } from the left / BOTTOM edge
	local s = (min(m.VX, m.VY) <= 500) and 1 or K.THREE_BIG
	local vx = m.VX
	local move, dash = K.MOVE_PX * s, K.DASH_TOUCH_PX * s
	-- screen px (x from the left, yb from the bottom, d) -> Commands-local design px
	local function at(cx, cyb, d)
		return { (cx - vx) / f, -cyb / f, d / f }
	end
	if m.VY >= m.VX then
		-- a tall phone: MOVE above the jump button (its right edge 32 px in, its foot 24 px over the jump button's top), DASH
		-- left of MOVE (its foot 6 px over the jump button's top); RUN left of the jump button (MovementController)
		local right = vx - 32 * s
		out.Element = at(right - move / 2, jump[4] + 24 * s + move / 2, move)
		local dashRight = right - move - 20 * s
		out.Dash = at(dashRight - dash / 2, jump[4] + 6 * s + dash / 2, dash)
	else
		-- a wide phone: MOVE left of the jump button on its foot, DASH above MOVE (their right edges in line, 26 px between);
		-- RUN above the jump button (MovementController). MOVE gives up size where it would reach the screen's centre 40%
		local right = jump[1] - 16 * s
		move = clamp(right - vx * 0.7 - 1, K.MOVE_MIN_PX * s, move)
		out.Element = at(right - move / 2, jump[2] + move / 2, move)
		out.Dash = at(right - dash / 2, jump[2] + move + 26 * s + dash / 2, dash)
	end
	out.w, out.h = 10, 10
	return out
end

-- (Pitch 2 item 1b) the three keys' layout: a touch screen (the phone layout); a desktop / laptop / gamepad keeps its four
function Hud.ThreeKeys(m)
	m = m or Hud.m
	return m ~= nil and m.Compact == true and m.Touch == true
end

----------------------------------------------------------------------
-- (re)builds the HUD for the drawn battle and lays it out for the screen
----------------------------------------------------------------------
function Hud.Rebuild()
	local B = St.battle
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	Hud.m = m
	Hud.scale.Scale = m.F
	Hud.root.Size = UDim2.new(1 / m.F, 0, 1 / m.F, 0)
	if not B then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.enemies.Visible = false
		Hud.SetTopReserve(nil)
		Hud.HoldStrips("BattleKeys", false)
		Hud.HoldStrips("BattleList", false)
		Hud.SetMenuHidden(false)
		Hud.SetVitalsHidden(false)
		Leave.Place(m, nil, false)
		CheerUp.Place(m, nil, false)
		Retreat.Place(m, nil, false)
		AreaWarn.Hide()
		return
	end
	local isFighting = B.Fighter and not B.ended
	-- between two ring rounds the top card and the fighter card stay (no flicker); the commands go
	local between = B.Fighter and B.ended and B.ringNext ~= nil
	local curBottom, curLeft, curRight = Hud.CurrencyTop(m)
	local topY = K.EDGE
	-- (P2 fix A, item 06 A: at 390 x 844 the boss card was a 196 px tower under the enemy list, its name cut, its track 50 px)
	-- a portrait phone's boss fight: the pitch's strip spans the top first (Hud.BandMode), the HUD's strips start under it
	-- (HudController.SetTopReserve) and the fighter card and the enemy list under the strip, as the pitch's portrait draws it
	local band = (isFighting or between or not (B.Fighter or B.ended)) and Hud.BandMode(B, m)
	Hud.bandOn = band == true -- (LayoutTop reads it: the strip only while the HUD's strips are held under it)
	Hud.helpersRow = false
	Hud.listLeft = false
	local bandY = K.EDGE
	local listAside = false -- (P2 fix round C) the strips step aside for the enemy list under the boss strip (below)
	-- (keys look r4: at 360 x 640 the 8 px under the strip left its hard shadow 1.6 px on the fighter card) the strip's shadow,
	-- the card's 2 px edge and K.INK_AIR_PX of air at the least
	local bandGap = Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX)
	if band then
		Hud.LayoutTop(B, m, 0, 0, K.EDGE, true)
		-- (keys look r3: at 390 x 844 the fighter card and the enemy list under the strip started 0-0.4 px under its hard
		-- shadow; the mock-up keeps 14-23 px) where the fighter's block still has the room, they start the shadow and
		-- K.CARD_GAP_PX under the strip (else the 8 px as before: 360 x 640's block needs it)
		local wide = math.ceil((K.SHADOW_PX + K.CARD_GAP_PX) / max(0.05, m.F))
		if not (isFighting or between) or Hud.BandRoom(B, m, K.EDGE + (Hud.topH or 0) + wide) then
			bandGap = max(bandGap, wide)
		end
		bandY = K.EDGE + (Hud.topH or 0) + bandGap
		-- (P2 fix A: at 360 x 640 the fighter card and its helpers under the strip reached the vitals slot, where Cheer up!
		-- and Retreat stack) a short portrait phone keeps the right column's card where the fighter's block under the strip
		-- would reach that stack (Hud.BandRoom). (Look review r1: that card was the old 211 px one under DASH / TARGET /
		-- Leave, "Storm ..."; the pitch's portrait is the strip.) First the two helpers side by side under the fighter card, as
		-- a wide screen's: the block is one helper shorter
		if (isFighting or between) and not Hud.BandRoom(B, m, bandY) then
			Hud.helpersRow = true
			if not Hud.BandRoom(B, m, bandY) then
				band = false
				Hud.bandOn = false
				Hud.helpersRow = false
			end
		end
	end
	if band then
		local bandBottom = K.EDGE + (Hud.topH or 0)
		-- (keys look r4: at 360 x 640 the strips started 2 px into the strip's hard shadow) the band the strip spans reaches
		-- to its shadow's foot and the strips' own 2 px frame: the HUD's strips start their gap under that
		Hud.SetTopReserve(bandBottom * m.F + K.SHADOW_PX + 2)
		curBottom, curLeft, curRight = Hud.CurrencyTop(m)
		local trb = Hud.HudAttr("TopRightBottom")
		if curBottom > 0 and trb and trb > 0 then
			curBottom = math.ceil(trb / max(0.05, m.F)) -- (the strips' new place, published as the HUD laid them out)
		end
		topY = bandBottom + bandGap
		-- (P2 fix round C: at 390 x 844 a player's three strips under the boss strip ended at 271, the list's first row under
		-- them lay in the screen's centre band, and Hud.LayoutEnemies keeps one row whatever the room) where the strips push
		-- the list's first row into the band and right under the boss strip it would end above it, the strips step aside for
		-- the fight, as they do where they lie on the keys (BattleKeys below); once aside they stay aside for this fight on this
		-- screen (weighed from the HUD's laid-out edges, shown or aside, so they never flip)
		-- (kitb-matchhud look0 N2: between two ring rounds the strips came back under the ring's strip, beside a fighter card
		-- laid out without them - at 360 x 640 the token strip lay 9.6 px on it) the fight's choice holds between its rounds
		-- too (the top card and the fighter card stay then: no flicker), weighed during the fight only
		local listKey = (isFighting or between) and string.format("%s/%dx%d", tostring(B), m.VX, m.VY) or nil
		if isFighting and Hud.stripsListAt ~= listKey and Hud.StripsPushList(B, m, topY) then
			Hud.stripsListAt = listKey
		end
		listAside = listKey ~= nil and Hud.stripsListAt == listKey
		if listAside then
			curBottom, curLeft, curRight = 0, 0, 0
		end
		-- (P2 fix A, look review r1: at 360 x 640 the list under the strips stood under DASH and TARGET, beside the fighter
		-- card) where the right column has no room for the list's first row (and its "+n more" tag) above the keys and
		-- clear of the fighter card, the list goes under the fighter's block on the left, above Cheer up! / Retreat; the
		-- helpers go side by side for it where needed. No room there either: no strip (the old card, as before)
		if isFighting and not Hud.ListFits(B, m, max(topY, curBottom > 0 and curRight > m.W * m.F - (K.ROW_W + 40) * m.F and (curBottom + 6) or 0), bandY) then
			local need = Hud.ListMinH(B, m) + Hud.ListGap(m)
			local ok = Hud.BandRoom(B, m, bandY, need)
			if not ok and not Hud.helpersRow then
				Hud.helpersRow = true
				ok = Hud.BandRoom(B, m, bandY, need)
			end
			local n = #Hud.EnemyList(B)
			if not ok and n > 1 then
				-- (a raid's full strip, its pills in two rows) one row with its "+n more" tag beside it (Hud.TagBeside; keys
				-- look r5 c06: the first row's bracket air, Hud.ListAir)
				local rowH = m.Compact and K.ROW_H_COMPACT or K.ROW_H
				local _, teamH = Hud.LayoutFighter(B, m)
				local air = Hud.ListAir(m, true)
				ok = Hud.TagBeside(m, K.EDGE, bandY + teamH + Hud.ListGap(m), rowH, n - 1, m.Touch and Hud.KeyBoxes(m) or nil, air) ~= nil
					and Hud.BandRoom(B, m, bandY, rowH + Hud.ListGap(m))
			end
			if ok then
				Hud.listLeft = true
			else
				band = false
				Hud.bandOn = false
				Hud.helpersRow = false
				Hud.SetTopReserve(nil)
				listAside = false
				curBottom, curLeft, curRight = Hud.CurrencyTop(m)
				topY = K.EDGE
			end
		end
	else
		-- (Pitch 2 item 1b, look review r2: a fight whose boss strip turned down laid the enemy list and the top card out
		-- against the strips' place under the strip, read above before they came back up: at 360 x 640 the list started 175 px
		-- low and the top card under it lay on DASH and MOVE until the next relayout) where the strips leave the strip's band
		-- now, their new place as the HUD published it (as the strip's own layout reads it above)
		local reserved = Hud.topReserve ~= nil
		Hud.SetTopReserve(nil)
		if reserved and curBottom > 0 then
			local trb = Hud.HudAttr("TopRightBottom")
			if trb and trb > 0 then
				curBottom = math.ceil(trb / max(0.05, m.F))
			end
		end
	end
	-- (a landscape phone's currency pills sit in the top band: stay below them where they reach down)
	local cardW = m.Compact and K.FC_W_COMPACT or K.FC_W
	Hud.fcW = nil
	if m.Compact and curBottom > 0 and curLeft >= K.EDGE + 208 and curLeft < K.EDGE + cardW + 8 then
		-- (a phone with the currency pills at the top right: a narrower fighter card fits beside them)
		Hud.fcW = curLeft - K.EDGE - 8
		-- (keys look r3: at 360 x 640 the card's hard shadow filled those 8 px, 0.4 px from the strips) its shadow and 6 px
		-- clear, where the card keeps the 208 it needs
		local keep = math.ceil((K.SHADOW_PX + 6) / max(0.05, m.F))
		if curLeft - K.EDGE - keep >= 208 then
			Hud.fcW = curLeft - K.EDGE - keep
		end
		cardW = Hud.fcW
	end
	if m.Compact and not m.Landscape and isFighting and not Hud.listLeft and #Hud.EnemyList(B) > 0 then
		-- (keys look r3: at 390 x 844 the enemy list's first row started 0-1 px from the fighter card, over its hard shadow,
		-- and the selected row's outline merged with it; the mock-up keeps 14-23 px) a portrait phone whose list stands
		-- beside the fighter card: the card narrows to keep its shadow and K.CARD_GAP_PX between them (never under the
		-- 208 a narrow card keeps beside the strips)
		local listX0 = m.W - K.EDGE - K.ROW_W_COMPACT
		-- (kit-b backlog 9: the ring's card across the top put its list beside the fighter card, and the locked row's gold
		-- target bracket came 7.4 / 5.5 px from the card's shadow at 393 x 852 / 412 x 915) and at least the card's ink and
		-- the bracket's, on the whole screen px they draw on, and the list's 8 px of air: the card's edge and hard shadow
		-- (Hud.TeamGap's), the bracket's 4 design px and its 3 px stroke (2 on a 0.8 phone: SignKit.Px), nothing more (a
		-- design px more at 390 x 844 cut 'Biscuit Bear'; a fixed count of design px left 5.6 px at 428 x 926)
		local f = max(0.05, m.F)
		local stroke = SignKit.Px(3, f)
		local keep = max(math.ceil((K.SHADOW_PX + K.CARD_GAP_PX) / f),
			math.ceil(stroke + SignKit.Px(Theme.Finish.Card, f) + 4 + stroke + 8 / f - 1e-6))
		if K.EDGE + cardW + keep > listX0 and listX0 - keep - K.EDGE >= 208 then
			Hud.fcW = max(208, floor(listX0 - keep - K.EDGE))
			cardW = Hud.fcW
		end
	end
	local leftY =(curBottom > 0 and curLeft < K.EDGE + cardW + 8) and max(topY, curBottom + 6) or topY
	-- (keys look r4) the HUD's strips beside the fighter card (design px), for helpers side by side that reach under them
	Hud.stripsAbove = (curBottom > 0 and curLeft > 0) and { Left = curLeft, Bottom = curBottom } or nil
	-- fighter card + helpers (top left) ----------------------------------------------------------
	Hud.team.Visible = isFighting or between
	local teamW, teamH = 0, 0
	if isFighting or between then
		teamW, teamH = Hud.LayoutFighter(B, m, leftY)
		-- a wide screen keeps the menu tiles (left centre): the fighter block starts right of their column
		local teamX = K.EDGE
		if not m.Compact then
			teamX = max(K.EDGE, Hud.MenuRight(m) + 10)
		end
		Hud.team.Position = UDim2.fromOffset(teamX, leftY)
		Hud.team.Size = UDim2.fromOffset(teamW, teamH)
		Hud.FillFighter(B)
	end
	Hud.teamPlace = (isFighting or between) and "TopLeft" or nil
	-- enemy list (right) -----------------------------------------------------------------------------
	-- (kit-b U9-6, the render gate: the TARGET tab sat on the currency strip) a wide screen's locked row carries its TARGET
	-- tab over its top edge: the list starts that much lower under the strips
	-- (U9-6 review) with no strip up there the tab still needs its band: under the top edge, not into Roblox's bar
	-- (keys look r4: under 390 x 844's boss strip the selected row's gold target bracket, 4 design px and a 2 px stroke out
	-- of the row, stood 7.2 px under the strip's shadow) a phone's list under the strip starts the bracket's reach lower
	local over = m.Compact and (band and (4 + Hud.Air(m, 2)) or 0) or K.TARGET_OVER
	-- (keys look r4: on a PC the TARGET tab's frame stood 2.4-3 px under the strips' hard shadow) under the strips, their
	-- shadow, the tab's 2 px frame and K.INK_AIR_PX of air
	local underStrips = m.Compact and 6 or max(6, Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX))
	if m.Compact and not band and curBottom > 0 and curRight > m.W - K.EDGE - K.ROW_W_COMPACT then
		-- (fix6 look0 #3b: at 960 x 540, a small window with a keyboard, the token strip stands right over the list's
		-- column and the locked row's gold bracket lay 2.4 px on its foot, 0.8 px from it in a full raid) where the strips
		-- stand over the list's own column, a compact list starts as a PC's does under them: their shadow, the bracket's
		-- reach (4 design px and its 2 px stroke) and K.INK_AIR_PX of air
		underStrips = max(6, Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX)) + 4 + Hud.Air(m, 2)
	end
	-- (fix6b, look1 #5: the strips' right edge, design px, was held against the screen's width in screen px - m.W * m.F -
	-- so from 1440 px tall up, a factor over 1, the list missed them and lay on the token strip, 33.5 px at 2560 x 1440)
	-- both in design px
	local rightY = (curBottom > 0 and curRight > m.W - (K.ROW_W + 40)) and max(topY, curBottom + underStrips) + over or (topY + over)
	Hud.listTop = rightY
	Hud.listX = nil
	if Hud.listLeft then
		-- (P2 fix A r1) under the fighter's block on the left (Hud.ListFits said the right column has no room), its rows down to
		-- Cheer up! / Retreat (Hud.LayoutEnemies)
		Hud.listTop = leftY + teamH + Hud.ListGap(m)
		Hud.listX = Hud.team.Position.X.Offset
		-- (keys look r4: the "+n more" tag's frame stood 2.8 px over CHEER's at 360 x 640) its rows stop both frames and the
		-- air above the team orders' row
		Hud.listRoom = Hud.StackTop(B, m) - Hud.listTop - Hud.Air(m, 4 + K.INK_AIR_PX)
	end
	Hud.enemies.Visible = isFighting
	-- (kit-b) a portrait phone: the action keys' boxes (their wood edge too) in our design px, for the list above them
	-- (Hud.LayoutEnemies). The portrait cluster stands on Roblox's buttons and the vitals, never on the list
	-- (Pitch 2 item 1b) a wide phone's MOVE / DASH keep their spots too: the list stops above them there as well
	Hud.listKeys = nil
	if isFighting and Hud.ThreeKeys(m) then
		Hud.listKeys = Hud.KeyBoxes(m)
	end
	-- (P2 fix A r1: at 360 x 640 the strips under the boss strip lay on DASH and TARGET) they step aside for the fight; once
	-- aside they stay aside for this fight on this screen (the keys' place follows the vitals card's, which the HUD's own
	-- relayout of the strips moves for a frame: weighed again it flipped them on and off)
	-- ((kitb-matchhud look0 N2) and between its rounds, as the list's choice above)
	local stripsKey = (band and (isFighting or between) and m.Touch) and string.format("%s/%dx%d", tostring(B), m.VX, m.VY) or nil
	if isFighting and stripsKey and Hud.stripsKeysAt ~= stripsKey and Hud.StripsOnKeys(m) then
		Hud.stripsKeysAt = stripsKey
	end
	Hud.HoldStrips("BattleKeys", stripsKey ~= nil and Hud.stripsKeysAt == stripsKey)
	Hud.HoldStrips("BattleList", listAside)
	local listH = 0
	if isFighting then
		listH = Hud.LayoutEnemies(B, m)
		if Hud.listX then
			Hud.enemies.AnchorPoint = Vector2.new(0, 0)
			Hud.enemies.Position = UDim2.fromOffset(Hud.listX, Hud.listTop)
		else
			Hud.enemies.AnchorPoint = Vector2.new(1, 0)
			Hud.enemies.Position = UDim2.fromOffset(m.W - K.EDGE, rightY)
		end
	end
	-- top card (mode line / boss bar) -------------------------------------------------------------
	Hud.LayoutTop(B, m, teamW, listH, rightY, isFighting or between)
	-- action cluster ---------------------------------------------------------------------------------
	Hud.cmd.Visible = isFighting
	Hud.cluster = nil -- (the laid-out cluster: CheerUp.SlotClear keeps Cheer up! / Retreat off it)
	if isFighting then
		local L = Hud.ClusterLayout(m)
		Hud.cluster = L
		Hud.cmd.Size = UDim2.fromOffset(L.w, L.h)
		Hud.cmd.Position = UDim2.fromOffset(m.W, m.H)
		for _, kind in ipairs(ACTIONS) do
			local A = Hud.buttons[kind]
			local spec = L[kind]
			-- (Pitch 2 item 1b) the three keys' layout has no SPECIAL and no TARGET key (MOVE holds the special; TARGET is
			-- automatic): their buttons stay hidden there
			A.Button.Visible = spec ~= nil
			A.three = Hud.ThreeKeys(m) and kind == "Element"
			-- (look review r0) the three keys' MOVE and DASH are one block each, as RUN: glyph over name inside the face
			A.block = Hud.ThreeKeys(m) and (kind == "Element" or kind == "Dash")
			if spec then
				local d = spec[3]
				A.Button.Size = UDim2.fromOffset(d, d)
				A.Button.Position = UDim2.new(1, spec[1], 1, spec[2])
				Hud.PlaceFace(A, d, m)
				A.Key.Visible = not m.Touch
				A.Key.Position = UDim2.new(0.15, 0, 0.15, 0)
			end
		end
		Hud.PlaceHoldTag(m)
		Hud.Captions(B)
		Hud.Keys()
	end
	Hud.SetMenuHidden((isFighting or between) and m.Compact) -- a phone: the menu column steps aside (wide screens keep it)
	-- (quick wins, win 4) a fighter's own vitals card steps aside on every screen (a spectator keeps it); before CheerUp.Place,
	-- which reads its empty slot
	Hud.SetVitalsHidden(isFighting or between)
	Leave.Place(m, B, isFighting)
	CheerUp.Place(m, B, isFighting)
	Retreat.Place(m, B, isFighting)
	AreaWarn.Place(m, B)
	Ring.PlaceNext(B)
	Hud.FixText(Hud.root, m.F)
	Hud.last = {}
	Hud.enemyDirty = false
	Hud.Update(B, os.clock(), true)
end

-- the lines `text` takes in a box `w` design px wide at `px` (greedy word wrap at the HUD's 0.62 em estimate, textWidth)
local function wrapLines(text, w, px)
	local lines, cur = 0, -1
	for word in string.gmatch(tostring(text or ""), "%S+") do
		local ww = textWidth(word, px)
		if cur < 0 or cur + textWidth(" ", px) + ww > w then
			lines = lines + 1
			cur = ww
		else
			cur = cur + textWidth(" ", px) + ww
		end
	end
	return max(1, lines)
end

-- a key's glyph, countdown and name for its width d. Wide screens: the name on its stone tag under the key, up to 2 lines.
-- Touch: the name's tag lies on the lower part of the face (DASH keeps a plain face), the glyph and the countdown above it
function Hud.PlaceFace(A, d, m)
	-- (Pitch 2 item 1b: the three keys are named, DASH too, as the mock draws it)
	local inFace = m.Touch and (A.kind ~= "Dash" or Hud.ThreeKeys(m))
	A.size = d
	A.blockRow = nil -- (a block key's glyph row: Hud.PlaceBlockFace sets it again)
	-- (LOOK-ui2) the glyph in one of the kit's two icon sizes, 27 px on a big key, 18 on a small one (was 0.4 x the
	-- diameter: 36 px cells on a touch SPECIAL)
	A.iconPx = (d >= K.KEY_BIG) and 27 or 18
	PixelIcon.Set(A.Glyph, A.glyphName or ICON[A.kind], A.iconPx)
	A.Count.TextSize = floor(d * 0.36)
	A.Count:SetAttribute("BaseText", A.Count.TextSize)
	local cap, plate = A.Caption, A.NamePlate
	cap.TextScaled = false -- (kit-b U9-6) one size: the floor on touch (Hud.PlaceFaceName), CAPTION_TEXT under the key
	A.capTop = nil -- (a tag on the face: Hud.PlaceFaceName sets it, Hud.PaintKey moves the tag down with the pressed face)
	-- (keys look r5 c05) a new layout gives the tag its whole name again (Hud.SpreadCaptions measures the room anew)
	A.capRoom, A.capShown = nil, nil
	if A.capText ~= nil then
		setText(cap, A.capText)
	end
	if inFace then
		cap.Visible = true
		cap.TextTruncate = Enum.TextTruncate.None
		Hud.PlaceFaceName(A, d, false)
	elseif m.Touch then
		-- the touch DASH: no tag, its glyph says it
		cap.Visible = false
		plate.Visible = false
		A.Glyph.Position = UDim2.new()
		A.Glyph.Size = UDim2.new(1, 0, 1, -K.KEY_LIP)
		A.Count.Position = A.Glyph.Position
		A.Count.Size = A.Glyph.Size
	else
		Hud.PlaceCaptionUnder(A, d, m)
		A.Glyph.Position = UDim2.new()
		A.Glyph.Size = UDim2.new(1, 0, 1, -K.KEY_LIP)
		A.Count.Position = A.Glyph.Position
		A.Count.Size = A.Glyph.Size
	end
	A.drawn = nil
	Hud.PaintKey(A, os.clock())
end

-- (LOOK-ui2: white text in a navy outline over the arena, TARGET and COSY GUARD ran into each other at 1280x720) a PC key's
-- name on a stone tag under the key, centred, at most the key's width + 16 (two lines where it needs them). (keys lane,
-- look fixA r1: "COSY..." and "MARSHMALL / OW..." on PC: the tag was sized in Hud.PlaceFace for the caption's text before
-- Hud.Captions set the attack's name, and never again) Hud.Captions calls it again with the name it sets
function Hud.PlaceCaptionUnder(A, d, m)
	local cap, plate = A.Caption, A.NamePlate
	local f = max(0.05, m.F)
	local px = max(K.CAPTION_TEXT, math.ceil(Hud.FloorPx() / f - 1e-6))
	-- (keys lane: the 0.62 em guess is short for a capitals word, "MARSHMALLOW" broke mid-word in its tag) a word's width is
	-- the largest of the guess, the caption's own face measured (Theme.MeasureLabel) and the helper tags' rough advance
	-- (tagW: 0.72 em a capital, 0.58 any other letter or digit, 0.3 a space)
	local function wordW(word)
		local ok, s = pcall(Theme.MeasureLabel, cap, word, px)
		local est = 0
		for ch in tostring(word):gmatch(".") do
			est = est + ((ch == " ") and 0.3 or (ch:match("%u") and 0.72 or 0.58))
		end
		-- (5% to spare, as Hud.FitLine keeps 4%: FredokaOne draws "MARSHMALLOW" at 0.74 em a letter, its M and W wide)
		return max(textWidth(word, px), (ok and typeof(s) == "Vector2") and s.X or 0, est * px) * 1.05
	end
	local function wrapN(width, text)
		local n, cur = 0, -1
		local space = wordW("A A") - wordW("AA")
		for word in string.gmatch(tostring(text), "%S+") do
			local ww = wordW(word)
			if cur < 0 or cur + space + ww > width then
				n, cur = n + 1, ww
			else
				cur = cur + space + ww
			end
		end
		return max(1, n)
	end
	-- the tag's size (design px) and lines for a text
	local function sizeFor(text)
		local w = d + 16
		-- (a long word keeps its line: "MARSHMALLOW" widens its tag past the clamp rather than break)
		for word in string.gmatch(text, "%S+") do
			w = max(w, math.ceil(wordW(word)) + 12)
		end
		local lines = min(2, wrapN(w - 12, text))
		local single = math.ceil(wordW(text)) + 12
		if lines == 1 then
			w = max(min(w, single), min(d, single))
		end
		local h = lines * math.ceil(px * 1.2) + 2
		local spec0 = Hud.cluster and Hud.cluster[A.kind]
		if lines == 2 and type(spec0) == "table" and spec0[2] and spec0[3] then
			-- (keys look r4: at 1280 x 720 SPECIAL's two-line "COSY / GUARD" tag ran 1 px off the screen's foot) where the second
			-- line would pass the screen's foot (the tag's 2 px frame and 2 px kept: the cluster's spots are from Commands' bottom
			-- edge, the screen's), the tag takes one line, as wide as its words (Hud.ClusterLayout now stands the cluster high
			-- enough for two: keys look r5 c05)
			local foot = spec0[2] + spec0[3] / 2 + K.KEY_EDGE + K.TAG_GAP + h + 4 / f
			if foot > 0 then
				lines = 1
				w = max(w, single)
				h = math.ceil(px * 1.2) + 2
			end
		end
		return w, h
	end
	-- (keys look r5 c05: at 1280 x 720 the whole "MARSHMALLOW STAMPEDE" tag pushed TARGET's tag 67 px off its key; 06 A keeps
	-- every tag under its key) a tag given less room (A.capRoom: Hud.SpreadCaptions, its left neighbour's tag would leave
	-- its own key) shows the name's last whole words that fit, as an enemy row drops "Wild" (never a word cut)
	local fullText = tostring(cap.Text)
	local text = fullText
	local w, h = sizeFor(text)
	if A.capRoom and w > A.capRoom then
		local words = {}
		for word in string.gmatch(fullText, "%S+") do
			words[#words + 1] = word
		end
		for k = 2, #words do
			text = table.concat(words, " ", k)
			w, h = sizeFor(text)
			if w <= A.capRoom then
				break
			end
		end
		setText(cap, text)
	end
	cap.Visible = true
	plate.Visible = true
	cap.TextTruncate = Enum.TextTruncate.AtEnd
	cap.TextColor3 = KB.Ink
	cap.TextSize = px
	cap:SetAttribute("BaseText", px)
	-- (the wider tag of a long word stays on the screen: SPECIAL's sits near its right edge) moved aside only as far as the
	-- screen's edge needs, from the cluster's own numbers (Hud.FaceTagShift's reading)
	local spec = Hud.cluster and Hud.cluster[A.kind]
	local shift = 0
	if type(spec) == "table" and m.VX then
		local ax = m.VX + spec[1] * f
		local half = w * f / 2
		shift = max(min(0, m.VX - 4 - (ax + half)), 4 - (ax - half)) / f
	end
	cap.Position = UDim2.new(0.5, shift, 1, K.KEY_EDGE + K.TAG_GAP)
	cap.Size = UDim2.fromOffset(w, h)
	plate.Position = cap.Position
	plate.Size = cap.Size
	A.capText = fullText -- (the HUD's name: Hud.Update re-places the tag when it changes)
	A.capShown = text
	A.capBase = shift
	Hud.SpreadCaptions(m)
end

-- (keys lane: SPECIAL's "MARSHMALLOW" tag, as wide as the word, ran over TARGET's tag beside it at 1280 x 720) the PC tags
-- under the keys, right to left: a tag that would touch the one on its right in the same rows moves left by what it lacks
-- (4 px apart), never into the screen's middle 40% (Hud.FaceTagShift's rule); the keys never move. Each pass starts from
-- the tags' own places (A.capBase), so it can run after every tag placed. Design px from Commands' right edge (the screen's)
function Hud.SpreadCaptions(m)
	if not (m and not m.Touch and Hud.buttons and Hud.cluster) then
		return
	end
	local tags = {}
	local left = -0.3 * m.W
	for kind, A in pairs(Hud.buttons) do
		local spec = Hud.cluster[kind]
		local cap = A.Caption
		if type(spec) == "table" and A.capBase ~= nil and cap and cap.Visible and A.Button.Visible then
			local top = spec[2] + spec[3] / 2 + K.KEY_EDGE + K.TAG_GAP
			tags[#tags + 1] = { A = A, cx = spec[1], d = spec[3], shift = A.capBase, w = cap.Size.X.Offset, top = top, bot = top + cap.Size.Y.Offset }
		end
	end
	table.sort(tags, function(a, b)
		return a.cx + a.shift > b.cx + b.shift
	end)
	local air = Hud.Air(m, 4 + K.INK_AIR_PX)
	for i, a in ipairs(tags) do
		local pusher = nil
		for j = 1, i - 1 do
			local b = tags[j]
			if a.top < b.bot and b.top < a.bot then
				-- (keys look r4: 4 design px between the boxes left their 2 px frames 0.8 px over each other at 1280 x 720)
				-- both frames and K.INK_AIR_PX of air
				local over = (a.cx + a.shift + a.w / 2 + air) - (b.cx + b.shift - b.w / 2)
				if over > 0 then
					a.shift = a.shift - over
					pusher = b
				end
			end
		end
		a.shift = max(a.shift, min(0, left - (a.cx - a.w / 2)))
		-- (keys look r5 c05: at 1280 x 720 SPECIAL's whole-name tag pushed TARGET's 67 px off its key) a tag stays under its
		-- key, its right edge a quarter key past the key's centre at least; where the tag on its right pushed it further,
		-- that tag gets the room left (A.capRoom: Hud.PlaceCaptionUnder shows its name's last words that fit) and the tags
		-- are spread again from their own places
		local reach = a.cx + a.d / 4
		if pusher and a.cx + a.shift + a.w / 2 < reach - 0.5 then
			local b = pusher
			local edgeR = -4 / max(0.05, m.F) -- (the screen's right edge, 4 px kept: PlaceCaptionUnder's clamp)
			local from = min(reach, a.cx + a.w / 2) + air
			-- the widest tag for b whose left edge stays at `from`: centred under its key, or against the screen's edge
			local room = math.floor((b.cx - from <= edgeR - b.cx) and 2 * (b.cx - from) or (edgeR - from))
			if b.w > room and (b.A.capRoom == nil or room < b.A.capRoom) then
				b.A.capRoom = room
				setText(b.A.Caption, b.A.capText or b.A.Caption.Text)
				Hud.PlaceCaptionUnder(b.A, b.A.Button.Size.X.Offset, m) -- (spreads the tags again)
				return
			end
		end
	end
	for _, a in ipairs(tags) do
		local p = a.A.Caption.Position
		a.A.Caption.Position = UDim2.new(p.X.Scale, a.shift, p.Y.Scale, p.Y.Offset)
		a.A.NamePlate.Position = a.A.Caption.Position
	end
end

-- (kit-b U9-6) a key's colour (its role's, or the fighter's element for ELEMENT) and the ink of what sits on it
function Hud.PaintFace(A, color)
	A.faceColor = color
	A.drawn = nil
	Hud.PaintKey(A, os.clock())
end

-- (LOOK-ui2) draws a keycap for its state (a no-op when nothing changed; MovementController's paintKey): sunk onto its lip
-- while pressed or cooling down; cooling, the face is the well and the role's colour (Charge) rises from the lip in whole
-- K.KEY_STEP steps; the cue (DASH's dodge call, a full SPECIAL) flips the edge and the lip to opaque gold (DASH: sky) and
-- back; a refused press (Hud.Shake) shows a red edge for a moment and steps the face sideways in whole px
function Hud.PaintKey(A, now)
	if not (A and A.Face and A.Lip) then
		return
	end
	now = now or os.clock()
	if A.Button:GetAttribute("Cue") ~= (A.cue == true) then
		A.Button:SetAttribute("Cue", A.cue == true) -- (the blink's state for a test: the call is on, whatever its phase)
	end
	local d = A.size or A.Button.Size.X.Offset
	local cooling = A.cooling == true
	local sink = (A.pressed or cooling) and K.KEY_SINK or 0
	local lipPx = K.KEY_LIP - sink
	local inner = d - sink - lipPx
	-- (Pitch 2 item 1b) the three keys' MOVE shows the special's meter (GoldLight from the lip), not the element's charge: a
	-- cooling MOVE is the well with the meter and the seconds on it
	local chargePx = (cooling and not A.three) and (floor(clamp(A.fill or 0, 0, 1) * inner / K.KEY_STEP) * K.KEY_STEP) or 0
	local meterPx = (A.three and not A.full) and (floor(clamp(A.meter or 0, 0, 1) * inner / K.KEY_STEP) * K.KEY_STEP) or 0
	local cue = A.cue == true and sin(now * 8) > 0
	local deny = (A.Button:GetAttribute("DenyUntil") or 0) > now
	local shake = deny and ((floor(now * 30) % 2 == 0) and 2 or -2) or 0
	local color = A.faceColor or KB.Face
	local key = table.concat({ sink, chargePx, meterPx, cue and 1 or 0, deny and 1 or 0, shake, d, color.R, color.G, color.B }, ",")
	if A.drawn == key then
		return
	end
	A.drawn = key
	local cueColor = (A.kind == "Dash") and SIGN.Sky or SIGN.Gold
	A.Face.Position = UDim2.fromOffset(shake, sink)
	A.Face.Size = UDim2.new(1, 0, 1, -sink)
	if A.capTop then
		-- a touch key's name tag lies on the face: it sinks and steps with it
		A.Caption.Position = UDim2.new(0.5, (A.capShift or 0) + shake, 0, A.capTop + sink)
		A.NamePlate.Position = A.Caption.Position
	end
	A.Face.BackgroundColor3 = cooling and KB.Well or color
	A.FaceStroke.Color = deny and SIGN.Red or (cue and cueColor or KB.Edge)
	A.Lip.Size = UDim2.new(1, 0, 0, lipPx)
	A.Lip.BackgroundColor3 = cue and cueColor or (cooling and SIGN.WellEdge or Theme.SignLipOf(color))
	A.Charge.Visible = chargePx > 0
	A.Charge.BackgroundColor3 = color
	A.Charge.Position = UDim2.new(0, 0, 1, -lipPx)
	A.Charge.Size = UDim2.new(1, 0, 0, chargePx)
	if A.Meter then
		A.Meter.Visible = meterPx > 0
		A.Meter.Position = UDim2.new(0, 0, 1, -lipPx)
		A.Meter.Size = UDim2.new(1, 0, 0, meterPx)
	end
	-- the ink of the glyph and the countdown: brown on the well and the charge, else the ink that reads on the face
	local ink = cooling and KB.Ink or Theme.TextOn(color)
	A.Glyph.TextColor3 = ink
	A.Count.TextColor3 = ink
end

-- a touch button's name tag for `text` on a button `d` design px wide (kit-b U9-6): w, h, the text size (design px). At
-- NAME_PX on the screen, one size, a little wider than the face (TARGET's: the face's width), wider still where a word or
-- the 2-line wrap needs it, 1 or 2 lines (TARGET: 1). `whole`: TARGET's flash takes the whole face. Hud.ClusterLayout
-- leaves the tags their room with it (U9-6 review)
function Hud.FaceTag(kind, text, d, whole)
	local f = max(0.05, Hud.m and Hud.m.F or 1)
	local px = math.ceil(K.NAME_PX / f - 1e-6)
	local w = d + ((kind == "Target") and 0 or 14)
	local pad = 6
	for word in string.gmatch(tostring(text), "%S+") do
		w = max(w, math.ceil(textWidth(word, px)) + 2 * pad)
	end
	local maxLines = (whole or kind ~= "Target") and 2 or 1
	while wrapLines(text, w - 2 * pad, px) > maxLines and w < 3 * d do
		w = w + 2
	end
	local lines = min(maxLines, wrapLines(text, w - 2 * pad, px))
	return w, whole and (d - K.KEY_LIP) or (lines * math.ceil(px * 1.2) + 4), px
end

-- how far a tag `w` design px wide moves aside from the centre of its button (spec = Hud.ClusterLayout's { x, y, d }): only
-- to stay out of the screen's centre 40% (where its button is clear of it) and on the screen. From the layout's own numbers
-- (U9-6 review: it read AbsolutePosition, which can be stale before the first layout pass). Design px
function Hud.FaceTagShift(spec, w, m)
	if not (spec and m) or w <= spec[3] then
		return 0
	end
	local f = max(0.05, m.F)
	local vx = m.VX
	local ax = vx + spec[1] * f -- the button's centre on the screen (Commands' right edge is the screen's)
	local half, bhalf = w * f / 2, spec[3] * f / 2
	local shift = 0
	if ax >= vx / 2 and ax - bhalf >= vx * 0.7 - 0.5 and ax - half < vx * 0.7 then
		shift = vx * 0.7 - (ax - half)
	elseif ax < vx / 2 and ax + bhalf <= vx * 0.3 + 0.5 and ax + half > vx * 0.3 then
		shift = vx * 0.3 - (ax + half)
	end
	shift = min(shift, vx - 4 - (ax + half))
	shift = max(shift, 4 - (ax - half))
	return shift / f
end

-- a touch key's name (kit-b U9-6; was a TextScaled label at 11-15 px) on its stone tag over the lower part of the face, its
-- bottom on the lip (LOOK-ui2: a keycap's label strip; it lay on a round face with the ring's arc under it); the glyph and
-- the countdown keep the face above it. `whole`: TARGET's flash (NEXT / AUTO / ONE ENEMY) takes the whole face, no tag
function Hud.PlaceFaceName(A, d, whole)
	if A.block and not whole and Hud.PlaceBlockFace(A, d) then
		return
	end
	local f = max(0.05, Hud.m and Hud.m.F or 1)
	local cap, plate = A.Caption, A.NamePlate
	local w, h, px = Hud.FaceTag(A.kind, cap.Text, d, whole)
	cap.TextSize = px
	cap:SetAttribute("BaseText", px)
	local top = whole and 0 or (d - K.KEY_LIP - h)
	local shift = Hud.FaceTagShift(Hud.cluster and Hud.cluster[A.kind], w, Hud.m)
	cap.Position = UDim2.new(0.5, whole and 0 or shift, 0, top)
	A.capTop, A.capShift = top, whole and 0 or shift
	cap.Size = UDim2.fromOffset(whole and d or w, h)
	cap.TextYAlignment = Enum.TextYAlignment.Center
	cap.TextColor3 = whole and Theme.TextOn(A.faceColor or KB.Face) or KB.Ink
	plate.Visible = not whole
	plate.Position = cap.Position
	plate.Size = cap.Size
	-- the glyph and the countdown share what the tag leaves of the face (Pitch 2 item 1b: and what MOVE's HOLD tag leaves of
	-- its top while it shows)
	local skip = (A.three and A.full and A.HoldTag) and Hud.HoldTagIn() or 0
	-- (a long special's 2-line tag on a 68 px MOVE: the small star keeps its 18 px, its top under the HOLD tag's foot)
	skip = min(skip, max(0, top - 2 - 18))
	local room = whole and (d - K.KEY_LIP) or max(8, top - 2 - skip)
	A.blockRow = nil
	A.Glyph.Position = UDim2.fromOffset(0, skip)
	A.Glyph.Size = UDim2.new(1, 0, 0, room)
	A.Count.Position = A.Glyph.Position
	A.Count.Size = A.Glyph.Size
	if room < (A.iconPx or 18) + 4 and (A.iconPx or 18) > 18 then
		A.iconPx = 18
		PixelIcon.Set(A.Glyph, A.glyphName or ICON[A.kind], A.iconPx)
	elseif A.three and d >= K.KEY_BIG and A.iconPx ~= 27 and room >= 27 + 4 then
		-- (Pitch 2 item 1b) MOVE's HOLD tag gone again: its big glyph back
		A.iconPx = 27
		PixelIcon.Set(A.Glyph, A.glyphName or ICON[A.kind], A.iconPx)
	end
	A.Count.TextSize = max(math.ceil(K.MIN_TEXT_PX / f - 1e-6), min(floor(d * 0.3), room))
	A.Count:SetAttribute("BaseText", A.Count.TextSize)
end

-- (Pitch 2 item 1b, look review r0: MOVE and DASH kept kit-b's touch tag, a stone plate wider than the face over its lower
-- part, so only RUN was one block, and a cooling MOVE showed its seconds without its glyph) the three keys' MOVE / DASH as
-- the mock draws them and MovementController's RUN is: ONE block, the glyph over the name, centred on the face above its lip
-- (and under the part of MOVE's HOLD tag over its top edge), the name at the phone floor in at most 2 lines inside the face.
-- Cooling, the seconds stand beside the glyph in its row (Hud.PlaceBlockCount). -> false where the name cannot sit inside the
-- face at the 14 px floor (a word wider than the face, or 3 lines: an 80 px MOVE holds about 8 capitals a line; 11 of the 53
-- evolved specials, THUNDERHEAD BREATH, WISH UPON THE STARS...): that one keeps kit-b's tag (Hud.PlaceFaceName), the floor
-- holding
function Hud.PlaceBlockFace(A, d)
	local m = Hud.m
	local f = max(0.05, m and m.F or 1)
	local cap = A.Caption
	local px = math.ceil(Hud.FloorPx() / f - 1e-6)
	local iw = d - 4 -- (the face's width less 2 px a side, as the mock's; the wood edge is drawn outside it)
	for word in string.gmatch(tostring(cap.Text), "%S+") do
		if textWidth(word, px) > iw then
			return false
		end
	end
	local lines = wrapLines(cap.Text, iw, px)
	if lines > 2 then
		return false -- (WISH UPON THE STARS: three lines and the glyph do not fit the face at the floor)
	end
	local capH = lines * math.ceil(px * 1.2)
	local skip = (A.three and A.full and A.HoldTag) and Hud.HoldTagIn() or 0
	local faceH = d - K.KEY_LIP
	local iconPx = (d >= K.KEY_BIG) and 27 or 18
	if iconPx > 18 and iconPx + 2 + capH > faceH - skip - 4 then
		iconPx = 18
	end
	if A.iconPx ~= iconPx then
		A.iconPx = iconPx
		PixelIcon.Set(A.Glyph, A.glyphName or ICON[A.kind], iconPx)
	end
	local top = skip + max(0, floor((faceH - skip - (iconPx + 2 + capH)) / 2))
	A.blockRow = { top = top, icon = iconPx, d = d }
	cap.TextSize = px
	cap:SetAttribute("BaseText", px)
	cap.TextTruncate = Enum.TextTruncate.None
	cap.TextYAlignment = Enum.TextYAlignment.Center
	cap.TextColor3 = KB.Ink
	cap.Position = UDim2.new(0.5, 0, 0, top + iconPx + 2)
	cap.Size = UDim2.fromOffset(iw, capH)
	A.capTop, A.capShift = top + iconPx + 2, 0
	A.NamePlate.Visible = false
	-- the seconds: the glyph's height at most, the floor at least
	A.Count.TextSize = max(px, iconPx)
	A.Count:SetAttribute("BaseText", A.Count.TextSize)
	A.countPlaced = nil
	Hud.PlaceBlockCount(A)
	return true
end

-- (look review r0) a block key's glyph row: the glyph alone, centred; cooling, the glyph and the seconds side by side,
-- centred together (the seconds keep the glyph's ink and stay off its pixels). A no-op while the text is the one placed
function Hud.PlaceBlockCount(A)
	local row = A.blockRow
	if not row then
		return
	end
	local text = (A.Count.Visible and A.Count.Text) or ""
	if A.countPlaced == text then
		return
	end
	A.countPlaced = text
	if text == "" then
		A.Glyph.Position = UDim2.fromOffset(0, row.top)
		A.Glyph.Size = UDim2.new(1, 0, 0, row.icon)
		A.Count.Position = A.Glyph.Position
		A.Count.Size = A.Glyph.Size
		return
	end
	local gap = 4
	local cw = math.ceil(textWidth(text, A.Count.TextSize)) + 2
	local room = row.d - 4
	if row.icon + gap + cw > room then
		-- (a long count on a small key: the seconds at the floor)
		A.Count.TextSize = math.ceil(Hud.FloorPx() / max(0.05, Hud.m and Hud.m.F or 1) - 1e-6)
		A.Count:SetAttribute("BaseText", A.Count.TextSize)
		cw = math.ceil(textWidth(text, A.Count.TextSize)) + 2
	end
	local x0 = floor((row.d - (row.icon + gap + cw)) / 2)
	A.Glyph.Position = UDim2.fromOffset(x0, row.top)
	A.Glyph.Size = UDim2.fromOffset(row.icon, row.icon)
	A.Count.Position = UDim2.fromOffset(x0 + row.icon + gap, row.top)
	A.Count.Size = UDim2.fromOffset(cw, row.icon)
end

-- (keys look r4) design px for `px` screen px of air at the HUD's scale
function Hud.Air(m, px)
	return math.ceil(px / max(0.05, m and m.F or 1) - 1e-6)
end

-- (keys look r4) design px from the fighter card's box to its helpers: the card's edge (2 screen px on a phone, 3 on a
-- PC) and its hard shadow (SignKit.Shadow's Finish.Card on whole screen px), the helper's own 2 px frame and
-- K.INK_AIR_PX of air; a PC's key cap stands over its cell's top edge (Hud.PlaceHelper: 4 design px wide, 2 compact): that
-- too
function Hud.TeamGap(m)
	local f = max(0.05, m and m.F or 1)
	local cap = (m and not m.Touch) and (m.Compact and 2 or 4) or 0
	return math.ceil(SignKit.Px(3, f) + SignKit.Px(Theme.Finish.Card, f) - 1e-6) + cap + Hud.Air(m, 2 + K.INK_AIR_PX)
end

-- (keys look r4: 6 design px between the cells left helper 1's Swap 0.8 px off helper 2's tags) design px between two
-- helper cells: their two 2 px frames and K.INK_AIR_PX of air
function Hud.CellGap(m)
	return Hud.Air(m, 4 + K.INK_AIR_PX)
end

-- (keys look r4: 8 design px under the helpers left the selected row's gold target bracket 0.8 px over their Swap keys at
-- 360 x 640) design px from the team block to an enemy list under it: the bracket stands 4 design px and its 2 px stroke
-- outside the row, the helpers' 2 px frames, K.INK_AIR_PX of air
function Hud.ListGap(m)
	return 4 + Hud.Air(m, 4 + K.INK_AIR_PX)
end

-- the fighter card + helper cells (sizes + positions; Team-local); returns the Team block's size
-- (top: the Team block's top, design px, where Hud.Rebuild is about to put it; else where it stands)
function Hud.LayoutFighter(B, m, top)
	local F = Hud.F
	local compact = m.Compact
	local w = compact and (Hud.fcW or K.FC_W_COMPACT) or K.FC_W
	local pad = compact and 10 or 16
	local barW = w - 2 * pad
	local y = compact and 8 or 12
	local nameSize = compact and 20 or 26
	-- (keys look r4: a phone's name row 26 tall for its 22 px Lv tag and 20 px name; 640 x 360's helper column needed the 4)
	local nameH = compact and 22 or 32
	F.Name.TextSize = nameSize
	F.Name:SetAttribute("BaseText", nameSize)
	local minSize = math.ceil(K.MIN_TEXT_PX / max(0.05, m.F))
	local lvSize = max(compact and 15 or 17, minSize)
	-- (keys lane, look fixA r1 / keys r2 minor: "Biscuit B...", "Mallow ...", "Mallow Kitt..." at every size, even where the
	-- card had room) the Lv tag as wide as this fighter's own level ("Lv 34", not always "Lv 100"), and the name below steps
	-- down to the readability floor before it is cut
	local fu0 = B.fighterId and B.units and B.units[B.fighterId]
	local lvText = (fu0 and fu0.level) and ("Lv " .. tostring(floor(fu0.level))) or "Lv 100"
	-- ("Lv 100" kept 0.9 of the 0.62 em guess + 14; a shorter level's own text 4 px more: battle_family_fits read "Lv 30"
	-- at 62 px, wanting its spare past that)
	local lvW = floor(textWidth(lvText, lvSize) * 0.9) + ((lvText == "Lv 100") and 14 or 18)
	local badge = compact and 22 or 26
	local starsW = (B.fighterEvo or 0) > 0 and (compact and 30 or 38) or 0
	-- (keys look r4: the Lv tag's and the badge's 2 px frames met, 5 design px apart = 4 screen px at a phone's 0.8) the
	-- badge stands its frame, the tag's and 1 screen px off the Lv tag
	local f0 = max(0.05, m.F)
	local tagGap = max(5, math.ceil(5 / f0 - 1e-6))
	-- (keys look r3: 390 x 844's card narrowed off the enemy list read "Biscuit Bear" 83 px in 83) a phone's badge without
	-- stars ends on the column's right edge, as the HP number and the hearts under it (it stopped 5 px short): the name
	-- keeps those 5 px
	local nameW = barW - lvW - badge - starsW - ((compact and starsW == 0) and 11 or 16) - (tagGap - 5)
	local nameFloor = max(minSize, compact and 16 or 18)
	-- (keys lane: an evolved fighter's "Mallow Kitten" still read "Mallow K..." on every phone) where the name does not fit its
	-- row at the floor beside the stars, a phone's stars move down to the right end of the ENERGY caption's row
	local starsLow, badgeLow = false, false
	if compact and starsW > 0 and fu0 and fu0.name then
		local nm = tostring(fu0.name)
		local okN, sz = pcall(Theme.Measure, nm, F.Name:GetAttribute("FontRole") or "Heading", nameFloor)
		local need = max((okN and typeof(sz) == "Vector2") and sz.X or 0, #nm * nameFloor * 0.56) * 1.04
		if need > nameW then
			starsLow = true
			nameW = barW - lvW - badge - 11 - (tagGap - 5)
			-- (keys look r4: the badge under the hearts needs the card 7 design px taller, which 640 x 360's helper column has
			-- not got) the badge goes down only where the name, as the face measures it (4 % over), does not fit beside it:
			-- a landscape phone's 232 px row holds "Mallow Kitten" at the floor (117 px), 360 x 640's 210 does not
			local measured = (okN and typeof(sz) == "Vector2" and sz.X > 0) and (sz.X * 1.04) or need
			if measured > nameW then
				-- (360 x 640's narrow card, beside the currency chip: still "Mallow Kitt...") the element's badge goes down too,
				-- left of the stars (the card's lip already wears the element's colour)
				badgeLow = true
				nameW = barW - lvW - 6
			end
		end
	end
	if starsLow then
		-- (keys look r3: the 18 px badge and the evo star on the 14 px ENERGY caption's row lay 18 x 4 px on the card's gold
		-- lip and touched the hearts, at every phone size) the name's row is the Lv tag's height and starts 2 px higher: the
		-- 6 px it gives go to the row the stars (and the badge) moved to, which then holds them whole between the hearts and
		-- the lip; the card keeps its height (a taller card moved 360 x 640's boss strip off the top)
		y = 6
		nameH = 22
	end
	F.Name.Position = UDim2.fromOffset(pad, y)
	F.Name.Size = UDim2.fromOffset(nameW, nameH)
	if fu0 and fu0.name then
		Hud.FitLine(F.Name, tostring(fu0.name), nameSize, nameFloor, nameW)
		setText(F.Name, tostring(fu0.name)) -- (the whole name: TextTruncate cuts it only where the floor still runs past)
	end
	F.Level.Size = UDim2.fromOffset(lvW, compact and 22 or 26)
	F.Level.Position = UDim2.fromOffset(pad + nameW + 6, y + (nameH - (compact and 22 or 26)) / 2)
	F.Level.TextSize = lvSize
	F.Level:SetAttribute("BaseText", lvSize)
	F.Element.Size = UDim2.fromOffset(badge, badge)
	F.Element.Position = UDim2.fromOffset(pad + nameW + 6 + lvW + tagGap, y + (nameH - badge) / 2)
	F.ElementGlyph.TextSize = floor(badge * 0.6)
	F.ElementGlyph:SetAttribute("BaseText", F.ElementGlyph.TextSize)
	F.Stars.Position = UDim2.fromOffset(pad + nameW + 6 + lvW + tagGap + badge + 4, y)
	F.Stars.Size = UDim2.fromOffset(starsW, nameH)
	F.Stars.Visible = starsW > 0
	y = y + nameH + (compact and 4 or 6)
	-- (LOOK-ui2) HP: the block row and the number beside it (a phone's narrow card shows the HP only: "2,558", the row says the
	-- rest), the number's column as wide as the fighter's max HP drawn at the size Hud.FixText gives it
	local hpH = compact and 18 or 22
	local hpText = compact and 14 or 16
	local drawnPx = max(hpText, math.ceil(Hud.FloorPx() / max(0.05, m.F) - 1e-6))
	Hud.hpShort = compact
	local fu = B.fighterId and B.units[B.fighterId]
	local maxText = Theme.Short(floor((fu and fu.maxHp or 9999) + 0.5))
	local numText = compact and maxText or (maxText .. " / " .. maxText)
	local okN, sizeN = pcall(Theme.Measure, numText, "Heading", drawnPx)
	local numW = math.ceil(max((okN and typeof(sizeN) == "Vector2") and sizeN.X or 0, textWidth(numText, drawnPx) * 0.92)) + 4
	local rowW = barW - numW - 8
	F.Hp.Position = UDim2.fromOffset(pad, y)
	F.Hp.Size = UDim2.fromOffset(rowW, hpH)
	F.HpText.Position = UDim2.fromOffset(pad + rowW + 8, y)
	F.HpText.Size = UDim2.fromOffset(numW, hpH)
	F.HpText.TextSize = hpText
	F.HpText:SetAttribute("BaseText", hpText)
	y = y + hpH + (compact and 5 or 7)
	-- ENERGY: a row as long as HP's (one grid of blocks), the lives' hearts in the number's column beside it
	local enH = compact and 12 or 14
	local hs = compact and 18 or 22
	F.Energy.Position = UDim2.fromOffset(pad, y)
	F.Energy.Size = UDim2.fromOffset(rowW, enH)
	F.Lives.AnchorPoint = Vector2.new(1, 0)
	F.Lives.Position = UDim2.fromOffset(pad + barW, y + floor((enH - hs) / 2))
	F.Lives.Size = UDim2.fromOffset(3 * hs + 4, hs)
	for i, h in ipairs(F.Hearts) do
		h.Size = UDim2.fromOffset(hs, hs)
		h.Position = UDim2.fromOffset((i - 1) * (hs + 2), 0)
		h.TextSize = hs - 2
		h:SetAttribute("BaseText", hs - 2)
	end
	local livesFoot = y + floor((enH - hs) / 2) + hs
	y = y + enH + max(3, math.ceil((hs - enH) / 2) + 2)
	local capH = compact and 18 or 22
	local capSize = compact and 14 or 15
	local capW = starsLow and (barW - starsW - 4 - (badgeLow and (badge + 4) or 0)) or barW
	-- the caption's row; (keys look r3) where the stars (and the badge) moved down to it, the row runs from the hearts' foot
	-- and is as tall as the tallest of them (the star is 9 whole screen px cells: 18 px drawn at any scale) and 3 px more:
	-- all of it above the card's lip, the caption, the badge and the stars centred on one line
	local rowY, rowH = y, capH
	if starsLow and not badgeLow then
		-- (keys look r3) the stars alone: the row runs from the hearts' foot, as tall as the 18 screen px star and 3 px more
		-- (the star's points miss the hearts' tips: battle_hud_no_overlap measures the cells)
		rowY = livesFoot
		rowH = max(capH, math.ceil(18 / f0)) + 3
	elseif starsLow then
		-- (keys look r4: the heart's 16 px pixel art ran 1.6 px past its 14.4 px box onto the badge's frame under it, and the
		-- badge's frame 0.6 px onto the lip) the row runs from the hearts' INK (PixelIcon's whole-px cells: 9 of them from
		-- the icon's padded origin, Host's 18 px icon centred in the heart) and holds the badge with its 2 px frame (or the
		-- 18 px star) a whole screen px clear of the hearts above and the lip below: the card grows by what that needs
		local cellD = PixelIcon.Px(2, f0)
		local padD = floor((18 - 9 * cellD) / 2 * f0 + 1e-6) / f0
		local heartFoot = livesFoot - hs + floor((hs - 18) / 2) + padD + 9 * cellD
		local air = math.ceil(1.5 / f0 - 1e-6)
		rowY = max(livesFoot, math.ceil(heartFoot - 1e-6))
		rowH = max(capH, badgeLow and (badge + math.ceil(4 / f0 - 1e-6)) or 0, math.ceil(18 / f0 - 1e-6)) + 2 * air
	end
	F.EnergyText.Position = UDim2.fromOffset(pad, rowY + floor((rowH - capH) / 2))
	F.EnergyText.Size = UDim2.fromOffset(capW, capH)
	F.EnergyText.TextSize = capSize
	F.EnergyText.TextTruncate = Enum.TextTruncate.AtEnd
	F.EnergyText:SetAttribute("BaseText", capSize)
	-- (keys look r3: with the stars and the badge on its row, 390 x 844's narrower card read "83/100": the 0.62 em guess is
	-- 30 px wider than the words) the words' real width (Theme.Measure, 4 % over), the guess where it cannot measure
	local capText = "ENERGY " .. METER_MAX .. "/" .. METER_MAX
	local okC, mC = pcall(Theme.Measure, capText, "Label", max(capSize, minSize))
	local capNeed = (okC and typeof(mC) == "Vector2" and mC.X > 0) and (mC.X * 1.04 + 2) or textWidth(capText, max(capSize, minSize))
	Hud.energyShort = capNeed > capW
	if starsLow then
		F.Stars.Position = UDim2.fromOffset(pad + barW - starsW, rowY)
		F.Stars.Size = UDim2.fromOffset(starsW, rowH)
		if badgeLow then
			F.Element.Position = UDim2.fromOffset(pad + barW - starsW - 4 - badge, rowY + floor((rowH - badge) / 2))
		end
	end
	y = rowY + rowH + (compact and 6 or 10)
	local cardH = y
	Hud.fighterCard.Root.Size = UDim2.fromOffset(w, cardH)
	Hud.fighterCard.Root.Position = UDim2.fromOffset(0, 0)
	-- helpers (LOOK-ui2: square tiles): side by side under the card (wide) / a column (compact)
	local tile = compact and K.PORTRAIT_COMPACT or K.PORTRAIT
	local cellW = compact and K.HELPER_W_COMPACT or K.HELPER_W
	if compact then
		-- (a phone: the column ends before the centre 40%; kit-b U9-6: a landscape phone has room for a longer buff name)
		local room = floor(m.W * 0.3) - K.EDGE
		if m.Landscape and Hud.ThreeKeys(m) then
			-- (Pitch 2 item 1b) CHEER / BACK stand beside the column (CheerUp.TeamSpots): it ends that much sooner
			room = room - math.ceil((K.TEAM_KEY_W_PX + K.TEAM_KEY_GAP_PX + 2) / max(0.05, m.F))
		end
		cellW = max(tile + 78, min(m.Landscape and K.HELPER_W_WIDE or cellW, room))
		if not m.Landscape and Hud.ThreeKeys(m) and room < tile + 78 then
			-- (Pitch 2 item 1b, look review r1: at 360 x 640 "STONE SKIN" broke as "STON / E...") a small tall phone, whose
			-- column's least width already passes the centre 40%: the column is as wide as the CHEER / BACK row under it, so a
			-- word of the buff's name fits beside the tile (390 x 844 keeps its column, which holds the word, inside the 30%).
			-- (keys lane, look fixA r1 follow-up: the full raid's strip now spans 360 x 640's top, its two helpers side by side
			-- under the fighter card broke "STON / E..." again) two helpers side by side take the same cells: the row reaches
			-- further right, over the empty sky under the strips (battle_hud_no_overlap keeps it off every card)
			cellW = max(cellW, math.ceil((2 * K.TEAM_KEY_W_PX + K.TEAM_KEY_GAP_PX) / max(0.05, m.F)))
		end
	end
	-- (kit-b U9-6, the render gate: "Lv 34" spilled out of its 48 px pill) the tags' text stays at the floor on the screen
	local lvPx = max(16, minSize)
	local tall = compact and not m.Landscape
	local L = { Px = lvPx, H = lvPx + 6, Tile = tile, CdH = 8, CellW = cellW, Compact = compact, Tall = tall, BuffH = lvPx + 6, F = m.F, Touch = m.Touch }
	-- one cell height whatever the texts (FillFighter places the tags again once it knows them): wide, a column of the tile,
	-- its blocks, the Lv tag, the buff's tag and SWAP; a tall phone, the tags beside the tile (the buff's on two lines) and
	-- SWAP the cell's width under them; a landscape phone, the tags and SWAP beside the tile
	local cellH
	if not compact then
		cellH = tile + 4 + L.CdH + 4 + L.H + 4 + L.BuffH + 6 + 28
	elseif tall then
		cellH = max(tile + 4 + L.CdH, L.H + 4 + 2 * math.ceil(lvPx * 1.2) + 4) + 4 + 30
		if Hud.helpersRow then
			-- (keys look r4: under 360 x 640's boss strip the block had no room for the air the parts keep, the shadows counted,
			-- and the strip gave way to the old card) helpers side by side take the short phone's cell (Hud.PlaceHelper's
			-- LvSwap): the Lv tag and SWAP's arrows on the top row, the buff's name under them on two solid lines, 44 design px
			-- shorter; each cell as wide as the tile, "Lv 100"'s tag and the arrows need
			L.LvSwap = true
			L.NameH = 2 * lvPx + 4
			cellH = max(tile + 4 + L.CdH, L.H + 2 + L.NameH)
			local lv100 = math.ceil(3.34 * lvPx) + 14
			cellW = max(cellW, tile + 8 + lv100 + 4 + K.SWAP_ICON_W)
			L.CellW = cellW
		end
	else
		-- (keys look r5 c04: at 844 x 390, the approved 01b C's own size, the evolved fighter's card 4 design px taller left
		-- the Lv / name / Swap cells 3 px past the stick's ring, and both helpers took the short phone's arrows-only Swap)
		-- a landscape phone's Lv tag, name plate and SWAP share one frame between them, as 01b C draws its cells: 4 design
		-- px between the boxes stood their 2 px frames 0.8 px into each other, a 3.2 px double line
		L.RowGap = SignKit.Px(2, m.F)
		cellH = max(tile + 4 + L.CdH, L.H + L.RowGap + L.BuffH + L.RowGap + 30)
		if Hud.ThreeKeys(m) then
			-- (Pitch 2 item 1b, look review r1: at 640 x 360, 667 x 375 and 740 x 360 the second helper's SWAP lay on Roblox's
			-- stick ring; at 667 x 375 "STONE S...", "TIDE ME...") where the column of Lv / name / SWAP rows would reach the
			-- stick's ring, the Lv tag and SWAP (its arrows alone) share the top row and the name goes under them, on two lines
			-- where that column still ends above the ring (Hud.PlaceHelper)
			local colTop = (tonumber(top) or (Hud.team and Hud.team.Position.Y.Offset) or K.EDGE) + cardH + Hud.TeamGap(m)
			-- (keys look r4: at 640 x 360 helper 2's box ended 1 design px above the ring, its name tag's 2 px frame 1.2 px
			-- into it) the cells' ink, their frames, ends above the ring
			local ring = Hud.StickRingTop(m) - Hud.Air(m, 2)
			if colTop + 2 * cellH + Hud.CellGap(m) > ring then
				-- (keys look r4: the air under the fighter card's shadow and between the cells cost 844 x 390 the mock-up's cell,
				-- Lv / buff / Swap under each other, 5.5 design px short of the ring) first the same rows 2 px tighter each: the
				-- tags' 14.4 px text in 17.6 px tags (the fighter card's own), SWAP 28 tall (its pad is the 44 px thumb)
				local tH, tS = lvPx + 4, 28
				local tight = max(tile + 4 + L.CdH, tH + L.RowGap + tH + L.RowGap + tS)
				if colTop + 2 * tight + Hud.CellGap(m) <= ring then
					L.H, L.BuffH, L.SwapH = tH, tH, tS
					cellH = tight
				end
			end
			if colTop + 2 * cellH + Hud.CellGap(m) > ring then
				local nameH2 = 2 * math.ceil(lvPx * 1.2) + 2
				local two = max(tile + 4 + L.CdH, L.H + 2 + nameH2)
				L.LvSwap = true
				if colTop + 2 * two + Hud.CellGap(m) > ring then
					-- (keys lane, keys look r2: at 640 x 360 the 1.2 lines missed the ring by 6 design px and the names read
					-- "STONE ...", "TIDE M...") the two lines set solid (a line as tall as the text, the label's LineHeight 1:
					-- capitals have no descenders), 2 px over them
					nameH2 = 2 * lvPx + 4
					two = max(tile + 4 + L.CdH, L.H + 2 + nameH2)
				end
				if colTop + 2 * two + Hud.CellGap(m) > ring then
					-- (keys look r4: the air under the fighter card's shadow and between the cells took 640 x 360's last 10 design
					-- px, the names read "TIDE M...") the Lv row and the two lines 2 px tighter each: the tag's 14.4 px text in a
					-- 17.6 px tag (the fighter card's own), the lines 1.6 px over the text
					local h2, n2 = lvPx + 4, 2 * lvPx + 2
					local t2 = max(tile + 4 + L.CdH, h2 + 2 + n2)
					if colTop + 2 * t2 + Hud.CellGap(m) > ring then
						-- (keys look r4: 640 x 360's raid, the evolved fighter's card a row taller) the two lines exactly the
						-- text's height (capitals: the cap height leaves air inside the tag's frame)
						n2 = 2 * lvPx
						t2 = max(tile + 4 + L.CdH, h2 + 2 + n2)
					end
					if colTop + 2 * t2 + Hud.CellGap(m) <= ring then
						L.H, nameH2, two = h2, n2, t2
					end
				end
				if colTop + 2 * two + Hud.CellGap(m) <= ring then
					L.NameH = nameH2
					cellH = two
				else
					L.NameH = L.BuffH
					cellH = max(tile + 4 + L.CdH, L.H + 2 + L.BuffH)
				end
			end
		end
	end
	L.CellH = cellH
	Hud.helperLevel = L
	Hud.helperCellW = cellW
	-- (keys look r4: the card's 2 px edge and hard shadow lay 1.6 px on the helpers' Lv tags on every phone, 4 px on a PC's
	-- key caps) the helpers start that reach, their own 2 px frame and the air below the card's box
	local hy = cardH + Hud.TeamGap(m)
	local cellGap = Hud.CellGap(m)
	L.Gap = cellGap
	local strips = Hud.stripsAbove
	if compact and Hud.helpersRow and strips and tonumber(top) then
		-- (keys look r4: at 360 x 640 a run's third strip, under the card's foot, lay 0.8 px over helper 2's Lv tag) helpers
		-- side by side that reach under the strips start under the strips' hard shadow, their frames and the air
		if K.EDGE + 2 * cellW + cellGap + Hud.Air(m, 2 + K.INK_AIR_PX) > strips.Left then
			hy = max(hy, strips.Bottom + Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX) - top)
		end
	end
	Hud.helperHolder.Position = UDim2.fromOffset(0, hy)
	-- (P2 fix A r1) a short portrait phone under the boss strip: the two helpers side by side (Hud.Rebuild's Hud.helpersRow)
	local column = compact and Hud.helpersRow ~= true
	for i, H in ipairs(Hud.helpers) do
		local cell = H.Cell
		cell.Size = UDim2.fromOffset(cellW, cellH)
		cell.Position = column and UDim2.fromOffset(0, (i - 1) * (cellH + cellGap)) or UDim2.fromOffset((i - 1) * (cellW + cellGap), 0)
		Theme.SetRole(H.Buff, compact and "Label" or "Heading")
		H.Level.TextSize = lvPx
		H.Level:SetAttribute("BaseText", lvPx)
		H.Buff.TextSize = lvPx
		H.Buff:SetAttribute("BaseText", lvPx)
		H.Count.TextSize = floor(tile * 0.42)
		H.Count:SetAttribute("BaseText", H.Count.TextSize)
		H.Key.Visible = not m.Touch
		Hud.PlaceHelper(H)
	end
	local helpersH = column and (2 * cellH + cellGap) or cellH
	local helpersW = column and cellW or (2 * cellW + cellGap)
	Hud.helperHolder.Size = UDim2.fromOffset(helpersW, helpersH)
	return max(w, helpersW), hy + helpersH
end

-- (LOOK-ui2) a tag's width for its text at `px` (Theme's measure or 0.55 em a character, whichever is wider) and its padding
local function tagW(l, px, padding)
	local okM, size = pcall(Theme.MeasureLabel, l, nil, px)
	-- (capitals in the display face run past Theme's measure: "HALO" was cut to "HA...") the wider of Theme's measure and
	-- FredokaOne's rough advance: 0.72 em a capital, 0.58 any other letter or digit, 0.3 a space
	local est = 0
	for ch in tostring(l.Text):gmatch(".") do
		est = est + ((ch == " ") and 0.3 or (ch:match("%u") and 0.72 or 0.58))
	end
	local tw = max((okM and typeof(size) == "Vector2") and size.X or 0, est * px)
	return math.ceil(tw) + padding + 2
end

-- (fix6 look0 #3a: at 960 x 540, a small window with a keyboard, the '1' / '2' key caps, 30 x 24 on the 48 px tile, hid
-- the helper's cooldown count and 'KO') the count and KO keep clear of the key cap: where the cap shows and reaches the
-- centred text, they sit at the tile's foot (above its lip), at the size that leaves 2 px under the cap's gold edge, never
-- under the readability floor; elsewhere centred at their own sizes, as before
function Hud.HelperFace(H, L)
	local tile = tonumber(L and L.Tile) or 0
	local countPx = floor(tile * 0.42)
	local koPx = 22 -- (H.KO's size as made)
	local capped = false
	local s = countPx
	if H.Key and H.Key.Visible and tile > 0 then
		local kp, ks, dp = H.Key.Position, H.Key.Size, H.Disc.Position
		local edge = 2 -- (keyChip's gold edge, outside its box)
		local capR = kp.X.Offset + ks.X.Offset + edge - dp.X.Offset
		local capB = kp.Y.Offset + ks.Y.Offset + edge - dp.Y.Offset
		local big = max(countPx, koPx)
		capped = capB > (tile - big) / 2 and capR > (tile - big) / 2
		if capped then
			local fpx = math.ceil(Hud.FloorPx() / max(0.05, tonumber(L.F) or 1) - 1e-6)
			s = max(fpx, min(countPx, tile - 4 - (capB + 2)))
		end
	end
	for _, t in ipairs({ H.Count, H.KO }) do
		if t then
			local size = capped and s or ((t == H.KO) and koPx or countPx)
			t.TextSize = size
			t:SetAttribute("BaseText", size)
			t.TextYAlignment = capped and Enum.TextYAlignment.Bottom or Enum.TextYAlignment.Center
			local pad = t:FindFirstChild("CapPad")
			if capped and not pad then
				pad = make("UIPadding", { Name = "CapPad" }, t)
			end
			if pad then
				pad.PaddingBottom = UDim.new(0, capped and 4 or 0)
			end
		end
	end
end

-- (kit-b U9-6; LOOK-ui2: the Lv tag sat over the portrait's lower third, the buff's name floated on the arena) places a
-- helper cell's parts for its texts (Hud.LayoutFighter, and Hud.FillFighter once the texts are known): the square tile with
-- its four buff blocks under it, the navy Lv tag and the buff's stone tag (each as wide as its text, never over the pet),
-- SWAP. Wide: a centred column; a phone: the tags beside the tile (one line when both fit, else the buff's under the Lv)
-- (fix6b, look1 #4: at 720 x 405 the full raid cut helper 1's 'STONE SKIN' to 'STONE SK...' in its 88 px plate, 700 x 394
-- 'STONE S...' and 'TIDE MEN...': a landscape phone's Lv / name / Swap column there is too narrow for the name at the
-- floor size with the plate's 6 px sides) a capital name's width, the wider of the HUD's two faces (FredokaOne, Nunito
-- ExtraBold) a letter, em: tagW's flat 0.72 read 'I' as wide as 'O' (the buff's face has no Enum twin to measure with)
local CAP_EM = { A = 0.78, B = 0.72, C = 0.72, D = 0.79, E = 0.64, F = 0.64, G = 0.77, H = 0.81, I = 0.27, J = 0.55, K = 0.67,
	L = 0.59, M = 0.9, N = 0.79, O = 0.82, P = 0.69, Q = 0.83, R = 0.73, S = 0.66, T = 0.73, U = 0.77, V = 0.78, W = 1.18,
	X = 0.74, Y = 0.69, Z = 0.64 }
local function capNameNeed(text, px)
	local em = 0
	for ch in tostring(text or ""):gmatch(".") do
		em = em + (CAP_EM[ch] or ((ch == " ") and 0.3 or 0.58))
	end
	-- (its plate's 2 px sides and 2 to spare: Hud.PlaceHelper tightens the sides of a name that needs it)
	return math.ceil(em * px) + 2 * 2 + 2
end

-- where a shown helper's name does not fit its plate on one line even with tight sides, both cells take the short
-- phone's form (the Lv tag and SWAP's arrows on the top row, the name under them on two solid lines), as 640 x 360 and
-- 667 x 375 draw them; one form for both cells
local function namesTwoLine(L)
	if not (L.Compact and not L.Tall and not L.LvSwap) or L.H + 2 + 2 * L.Px + 4 > (L.CellH or 0) then
		return false
	end
	local room = L.CellW - (L.Tile + 8)
	for _, other in ipairs(Hud.helpers or {}) do
		local b = other.Buff
		if b and other.Cell and other.Cell.Visible and tostring(b.Text) ~= "" and capNameNeed(b.Text, L.Px) > room then
			return true
		end
	end
	return false
end

function Hud.PlaceHelper(H)
	local L = Hud.helperLevel
	if not L then
		return
	end
	local two = namesTwoLine(L)
	if (Hud.namesTwo == true) ~= two and not Hud.placingAll then
		-- (fix6b) the other cell takes the same form
		Hud.namesTwo = two
		Hud.placingAll = true
		for _, other in ipairs(Hud.helpers or {}) do
			if other ~= H then
				Hud.PlaceHelper(other)
				other.stateKey = nil
			end
		end
		Hud.placingAll = false
	end
	H.swapIcon = L.LvSwap == true or two -- (Pitch 2 item 1b, look review r1: SWAP's arrows alone, Hud.Update)
	local tile, cdH = L.Tile, L.CdH
	H.Level.AutomaticSize = Enum.AutomaticSize.None
	H.Level.AnchorPoint = Vector2.new(0, 0)
	H.Buff.AnchorPoint = Vector2.new(0, 0)
	for _, part in ipairs({ H.Level, H.Buff }) do
		local pad = part:FindFirstChildOfClass("UIPadding")
		if pad then
			pad.PaddingLeft = UDim.new(0, 6)
			pad.PaddingRight = UDim.new(0, 6)
		end
	end
	local lvW = tagW(H.Level, L.Px, 12)
	local buffW = tagW(H.Buff, L.Px, 12)
	H.Buff.TextWrapped = false
	H.Buff.TextTruncate = Enum.TextTruncate.AtEnd
	if not L.Compact then
		local x0 = floor((L.CellW - tile) / 2)
		H.Disc.Position = UDim2.fromOffset(x0, 0)
		H.Disc.Size = UDim2.fromOffset(tile, tile)
		H.Cd.Root.Position = UDim2.fromOffset(x0, tile + 4)
		H.Cd.Root.Size = UDim2.fromOffset(tile, cdH)
		local y = tile + 4 + cdH + 4
		H.Level.Position = UDim2.fromOffset(floor((L.CellW - lvW) / 2), y)
		H.Level.Size = UDim2.fromOffset(lvW, L.H)
		y = y + L.H + 4
		local bw = min(L.CellW, buffW)
		H.Buff.Position = UDim2.fromOffset(floor((L.CellW - bw) / 2), y)
		H.Buff.Size = UDim2.fromOffset(bw, L.BuffH)
		y = y + L.BuffH + 6
		H.Swap.Position = UDim2.fromOffset(floor((L.CellW - 104) / 2), y)
		H.Swap.Size = UDim2.fromOffset(104, 28)
		H.Key.Position = UDim2.fromOffset(x0 - 6, -4)
		Hud.HelperFace(H, L)
		Hud.PlaceSwapHit(H, L, 104, 28, nil)
		return
	end
	H.Disc.Position = UDim2.fromOffset(0, 0)
	H.Disc.Size = UDim2.fromOffset(tile, tile)
	H.Cd.Root.Position = UDim2.fromOffset(0, tile + 4)
	H.Cd.Root.Size = UDim2.fromOffset(tile, cdH)
	H.Key.Position = UDim2.fromOffset(-4, -2)
	Hud.HelperFace(H, L)
	local x = tile + 8
	local room = L.CellW - x
	if L.LvSwap or two then
		-- (Pitch 2 item 1b, look review r1) a short landscape phone (Hud.LayoutFighter): the Lv tag, then SWAP as its arrows
		-- alone to the cell's right edge, on the top row; the buff's name under them, on two lines where it is longer than
		-- the room and the cell has them (L.NameH; fix6b: a cell taking this form for a long name, two solid lines)
		local sw = min(room, max(K.SWAP_ICON_W, room - lvW - 4))
		local lw = max(10, room - sw - 4)
		H.Level.Position = UDim2.fromOffset(x, 0)
		H.Level.Size = UDim2.fromOffset(min(lvW, lw), L.H)
		H.Swap.Position = UDim2.fromOffset(L.CellW - sw, 0)
		H.Swap.Size = UDim2.fromOffset(sw, L.H)
		local bh = L.BuffH
		local nameH = L.LvSwap and L.NameH or (2 * L.Px + 4)
		if buffW > room and (nameH or 0) > L.BuffH then
			H.Buff.TextWrapped = true
			bh = nameH
		end
		H.Buff.Position = UDim2.fromOffset(x, L.H + 2)
		H.Buff.Size = UDim2.fromOffset(min(room, buffW), bh)
		-- (its 44 px pad stays inside the cell's right edge: CHEER / BACK stand right of it)
		Hud.PlaceSwapHit(H, L, sw, L.H, nil, true)
		return
	end
	H.Level.Position = UDim2.fromOffset(x, 0)
	H.Level.Size = UDim2.fromOffset(min(lvW, room), L.H)
	local by, bw, bh = 0, buffW, L.BuffH
	if lvW + 4 + buffW <= room then
		H.Buff.Position = UDim2.fromOffset(x + lvW + 4, 0)
	else
		by = L.H + (L.RowGap or 4)
		bw = min(room, buffW)
		if L.Tall and buffW > room then
			-- (a tall phone: "TIDE MEND" on two lines in the room beside the tile)
			H.Buff.TextWrapped = true
			bh = 2 * math.ceil(L.Px * 1.2) + 4
		elseif buffW > room and capNameNeed(H.Buff.Text, L.Px) <= room then
			-- (fix6b, look1 #4) a landscape phone's name a few px past its plate's 6 px sides: 2 px sides (the plate keeps the
			-- room's width; its centred word does not move)
			local pad = H.Buff:FindFirstChildOfClass("UIPadding")
			if pad then
				pad.PaddingLeft = UDim.new(0, 2)
				pad.PaddingRight = UDim.new(0, 2)
			end
		end
		H.Buff.Position = UDim2.fromOffset(x, by)
	end
	H.Buff.Size = UDim2.fromOffset(bw, bh)
	-- SWAP right under what it belongs to (the cell keeps its height: the room left goes under it, between the cells)
	if L.Tall then
		-- (P2 fix A r1) helpers side by side (Hud.helpersRow): both SWAPs on the cells' bottom line, level with each other
		local sy = Hud.helpersRow and (L.CellH - 30) or (max(tile + 4 + cdH, by + bh) + 4)
		H.Swap.Position = UDim2.fromOffset(0, sy)
		H.Swap.Size = UDim2.fromOffset(L.CellW, 30)
		Hud.PlaceSwapHit(H, L, L.CellW, 30, Hud.helpersRow and 4 or nil)
	else
		H.Swap.Position = UDim2.fromOffset(x, by + bh + (L.RowGap or 4))
		H.Swap.Size = UDim2.fromOffset(room, L.SwapH or 30)
		-- (a landscape phone: the second helper's SWAP sits just above the thumbstick's zone: its pad reaches up, over the
		-- tags beside the tile, not down)
		Hud.PlaceSwapHit(H, L, room, L.SwapH or 30, 0)
	end
end

-- (P2 fix A look review r1, major 6) SWAP's clear hit pad on a touch screen: 44 screen px each way over the w x h block,
-- centred on it, or reaching at most `below` design px under it (helpers side by side: the enemy list starts 8 px under
-- the cells) and the rest above it; right: the pad's right edge on the block's (the block ends at the cell's right edge)
function Hud.PlaceSwapHit(H, L, w, h, below, right)
	local pad = H.SwapHit
	if not pad then
		return
	end
	local hit = math.ceil(44 / max(0.05, L.F or 1))
	pad.Visible = L.Touch == true and (w < hit or h < hit)
	if not pad.Visible then
		return
	end
	local pw, ph = max(w, hit), max(h, hit)
	local under = floor((ph - h) / 2)
	if below then
		under = min(under, below)
	end
	-- (the pad is the block's sibling in the cell, placed from the block's corner)
	local at = H.Swap.Position
	local px0 = at.X.Offset + (right and (w - pw) or floor((w - pw) / 2))
	local py0 = at.Y.Offset + h + under - ph
	-- (keys look r3: at 640 x 360 / 667 x 375 helper 1's pad reached 6 px over the fighter card, helper 2's 8 px over helper
	-- 1's buff plate; at 390 x 844 helper 1's 5 px over helper 2) the pad stays inside its own cell, which is 44 screen px
	-- tall or more on every phone layout: it reaches over the cell's own tags (no buttons) instead
	local cw, ch = tonumber(L.CellW) or 0, tonumber(L.CellH) or 0
	if ch >= ph then
		py0 = clamp(py0, 0, ch - ph)
	end
	if cw >= pw then
		px0 = clamp(px0, 0, cw - pw)
	end
	pad.AnchorPoint = Vector2.new(0, 0)
	pad.Position = UDim2.fromOffset(px0, py0)
	pad.Size = UDim2.fromOffset(pw, ph)
end

-- (LOOK-ui2) the buff's tag again for a new name (a swap brings another helper)
function Hud.FitBuff(H)
	Hud.PlaceHelper(H)
end

-- (kit-b U9-6) the Lv tag again for a new level
function Hud.FitLevel(H)
	Hud.PlaceHelper(H)
end

-- (LOOK-ui2) the HP row's loss trail: the blocks the last hit took (Hud.hpTrail From + 1 .. To) red with the red lip until its
-- time is up, then the plain row (lit grass, the rest stone); attributes Lit / Trail on the Hp frame
function Hud.PaintHpTrail(now)
	local F = Hud.F
	if not (F and F.HpBar) then
		return
	end
	local row = F.HpBar.Root
	local t = Hud.hpTrail
	SignKit.FillBlocks(row, max(0, F.HpBar.lit))
	if t then
		for i = t.From + 1, t.To do
			local b = row:FindFirstChild("Block" .. i)
			local face = b and b:FindFirstChild("Face")
			if face then
				face.BackgroundColor3 = KB.Loss
				local lip = face:FindFirstChild("Lip")
				if lip then
					lip.BackgroundColor3 = SIGN.RedLip
				end
			end
		end
	end
	F.Hp:SetAttribute("Lit", max(0, F.HpBar.lit))
	F.Hp:SetAttribute("Trail", t and (t.To - t.From) or 0)
end

-- the fighter card's static texts (name, level, element, stars) and the helper cells' pets (on Start / Swap)
function Hud.FillFighter(B)
	local F = Hud.F
	local f = B.fighterId and B.units[B.fighterId]
	if f then
		setText(F.Name, f.name)
		setText(F.Level, "Lv " .. tostring(floor(f.level)))
		-- kit B: no outline on the badge; its small glyph reads on the face (Theme.ReadableFace)
		F.Element.BackgroundColor3, F.ElementGlyph.TextColor3 = Theme.ReadableFace(elementColor(f.element), 4.5)
		PixelIcon.Set(F.ElementGlyph, ELEMENT_ICON[f.element]) -- (kit-b U7b)
		local evo = clamp(f.evo or 0, 0, 2)
		setText(F.Stars, "")
		PixelIcon.Mark(F.Stars, evo > 0 and ICON.Star or nil, { Count = evo, Of = evo })
		if Hud.fighterCard.SetColor then
			pcall(Hud.fighterCard.SetColor, elementColor(f.element)) -- (kit-b U9-6) the card's lip in the fighter's element
		end
	end
	local bench = Hud.Bench(B)
	for i, H in ipairs(Hud.helpers) do
		local u = bench[i]
		H.unit = u
		H.Cell.Visible = u ~= nil
		if u then
			H.slot = u.slot
			setText(H.Level, "Lv " .. tostring(floor(u.level)))
			Hud.FitLevel(H)
			local buff = type(u.info.buff) == "table" and u.info.buff or nil
			H.buffName = buff and string.upper(tostring(buff.Name or buff.Kind or "BUFF")) or "BUFF"
			setText(H.Buff, H.buffName)
			H.Lip.BackgroundColor3 = elementColor(u.element) -- (LOOK-ui2) the tile's lip in the helper's element
			Hud.FitBuff(H)
			Hud.Portrait(H, u)
		end
		H.stateKey = nil
	end
end

-- my two helpers (benched units, by slot), as the portraits show them
function Hud.Bench(B)
	local out = {}
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u and u.id ~= B.fighterId then
			out[#out + 1] = u
		end
	end
	return out
end

-- the action captions: the attacks' names (the form's at the pet's stage), TARGET + its flash (NEXT / AUTO / ONE ENEMY)
function Hud.CaptionTexts(B)
	local f = B and B.fighterId and B.units[B.fighterId]
	local ea = f and type(f.info.elementAttack) == "table" and f.info.elementAttack or nil
	local sp = f and type(f.info.special) == "table" and f.info.special or nil
	return {
		Target = St.targetFlash or "TARGET",
		Element = ea and string.upper(tostring(ea.Name)) or "ELEMENT",
		Special = sp and string.upper(tostring(sp.Name)) or "SPECIAL",
		Dash = "DASH",
	}
end

function Hud.Captions(B)
	local f = B.fighterId and B.units[B.fighterId]
	local caps = Hud.CaptionTexts(B)
	local T = Hud.buttons.Target
	if T and Hud.m and Hud.m.Touch then
		-- (a phone: the flash takes the whole face, "ONE ENEMY" is two lines)
		setVisible(T.Glyph, St.targetFlash == nil)
	end
	for kind, A in pairs(Hud.buttons) do
		-- (Pitch 2 item 1b) the three keys' MOVE: the element's name on a stone face with the meter rising; a full meter turns it
		-- gold with the special's name and star (a hold fires it, the HOLD tag says so)
		local full = A.three and A.full == true
		local want = (full and caps.Special) or caps[kind] or kind
		-- (keys look r5 c05) a PC tag showing its name's last words (Hud.PlaceCaptionUnder, A.capRoom) keeps them while the
		-- name stays the same
		local pcTag = Hud.m and not Hud.m.Touch and A.capShown ~= nil and A.capText == want
		setText(A.Caption, pcTag and A.capShown or want)
		if Hud.m and Hud.m.Touch and (kind ~= "Dash" or Hud.ThreeKeys()) and A.Button.Visible then
			-- (kit-b U9-6) the name's tag follows its text (a swap changes the attack's name)
			Hud.PlaceFaceName(A, A.Button.Size.X.Offset, kind == "Target" and St.targetFlash ~= nil)
		elseif Hud.m and not Hud.m.Touch and A.Button.Visible and A.capText ~= want then
			-- (keys lane) a PC key's tag under it follows its text too
			Hud.PlaceCaptionUnder(A, A.Button.Size.X.Offset, Hud.m)
		end
		if kind == "Element" and f then
			A.glyphName = full and ICON.Special or (ELEMENT_ICON[f.element] or ICON.Special)
			PixelIcon.Set(A.Glyph, A.glyphName, A.iconPx)
			if A.three then
				Hud.PaintFace(A, full and SIGN.Gold or KB.Face)
			else
				Hud.PaintFace(A, elementColor(f.element))
			end
		end
	end
	setVisible(Hud.buttons.Element and Hud.buttons.Element.HoldTag, Hud.buttons.Element and Hud.buttons.Element.three and Hud.buttons.Element.full == true)
end

-- (Pitch 2 item 1b) the HOLD tag on MOVE's top edge, centred, at the phone floor (the mock's teaching ribbon)
function Hud.PlaceHoldTag(m)
	local A = Hud.buttons and Hud.buttons.Element
	local t = A and A.HoldTag
	if not t then
		return
	end
	local w, h, px = Hud.HoldTagSize(m)
	t.TextSize = px
	t:SetAttribute("BaseText", px)
	t.Size = UDim2.fromOffset(min(w, A.Button.Size.X.Offset - 8), h)
	-- (look review r0: 6 px over the face and the rest above, it hung under DASH's name and read as DASH's) pinned across the
	-- edge, half of it over the face, as the mock pins it (Hud.PlaceBlockFace keeps the glyph under that half)
	t.AnchorPoint = Vector2.new(0.5, 1)
	t.Position = UDim2.new(0.5, 0, 0, Hud.HoldTagIn(m))
	setVisible(t, A.three == true and A.full == true)
end

-- the HOLD tag's size for the screen (design px): w, h, its text size (the phone floor)
function Hud.HoldTagSize(m)
	m = m or Hud.m
	local px = max(K.CAPTION_TEXT, math.ceil(Hud.FloorPx() / max(0.05, m and m.F or 1) - 1e-6))
	return math.ceil(textWidth("HOLD", px)) + 14, math.ceil(px * 1.2) + 4 + 3, px
end

-- how far (design px) the HOLD tag reaches over MOVE's face: half its height
function Hud.HoldTagIn(m)
	local _, h = Hud.HoldTagSize(m)
	return floor(h / 2)
end

-- the top of a tall phone's centre band in our design px (the gui area starts under the Roblox top bar: the band is 30% of
-- the SCREEN's height down, so the inset comes off; kit-b U9-6: it was 30% of the gui area, 25 px too low at 390x844, and the
-- top card + boss bar reached into the band) less a 4 px margin
function Hud.BandTop(m)
	return (m.VY * 0.3 - m.Inset) / max(0.05, m.F) - 4
end

-- the top card: the mode line + timer (+ the boss bar in raids / boss rooms, the ring pills); returns nothing
function Hud.LayoutTop(B, m, teamW, listH, rightY, show)
	Hud.topArgs = { B, m, teamW, listH, rightY, show }
	local top = Hud.top
	local spectator = not B.Fighter
	top.Visible = show or spectator
	if not top.Visible then
		Hud.leaveSlot = nil
		return
	end
	local bossUnit = Hud.BossUnit(B)
	if bossUnit and bossUnit.name then
		Hud.lastBoss = bossUnit.name -- (the result card's "<boss> is down" after the boss is gone)
	end
	local compact = m.Compact
	-- (Pitch 2 item 06 A) one card: a boss's is the pitch's 640 (500 on a phone), the mode line's keeps its width
	local w
	if bossUnit then
		w = compact and K.TOP_W_BOSS_COMPACT or K.TOP_W_BOSS
	else
		w = compact and K.TOP_W_COMPACT or K.TOP_W
		if not compact and Leave.Allowed(B) and not B.ended then
			w = w + K.LEAVE_W_CARD + 10 -- (a wide screen: LEAVE's room on top, the mode line keeps its whole width)
		end
	end
	local x, y, anchor = m.W / 2, K.EDGE, 0.5
	local underList, leftTop = false, false
	local curBottom, curLeft, curRight = Hud.CurrencyTop(m)
	local band = Hud.bandOn == true and Hud.BandMode(B, m)
	if band then
		-- (P2 fix A, item 06 A) a portrait phone's boss strip: across the top, the pitch's 500 where it fits, else the screen
		-- less its edges (Hud.Rebuild put the HUD's strips, the fighter card and the enemy list under it); (keys lane) a
		-- duel's mode line spans it too, as the boss strips do
		w = bossUnit and min(w, m.W - 2 * K.EDGE) or (m.W - 2 * K.EDGE)
	elseif m.Compact then
		-- between the fighter card and the enemy list when there is room, else under the enemy list (right). (keys look r4:
		-- 12 design px off the fighter card left 1.9 px between its hard shadow and the card's edge at 640 x 360) the fighter
		-- card's edge and shadow, this card's 2 px edge and K.INK_AIR_PX of air
		local side = max(12, Hud.Air(m, K.SHADOW_PX + 2 + K.INK_AIR_PX))
		local teamR = teamW
		if m.Landscape and Hud.ThreeKeys(m) and Hud.cheer and (CheerUp.Allowed(B) or Retreat.Allowed(B)) then
			-- (keys look r4: at 740 x 360 CHEER, beside the helpers, ended 0.4 px past the fighter card's shadow, its 2 px edge
			-- 3.9 px off this card's) the team orders beside the helpers: their edge, this card's and the air past them too
			local spots, kw = CheerUp.TeamSpots(m)
			for _, sp in ipairs(spots or {}) do
