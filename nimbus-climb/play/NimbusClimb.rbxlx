        <Properties>
          <string name="Name">LoadingScreen</string>
          <string name="Source"><![CDATA[pcall(function() game:GetService("ReplicatedFirst"):RemoveDefaultLoadingScreen() end)
-- LoadingScreen (ReplicatedFirst; ARCHITECTURE_V3.md "Phase 5 build contract" 7.1). Roblox runs it before every other
-- client script, so it may only use what is already there: ReplicatedStorage.Shared (Config, Theme, SignKit, PixelIcon,
-- TextureIds, UpdateNotes) and plain Roblox services. Never a PlayerScripts module (boot order, m13).
--
-- kit B (U3 of .superpowers/slop-audit/round3/BUILD_PLAN.md; finding 4, sky F11; the owner's approved pitch,
-- kit_pitch_mockups.html "B. Cloud Shop Signboard", loading thumbnail): ScreenGui "NimbusLoading" (DisplayOrder 100,
-- IgnoreGuiInset, ResetOnSpawn false) over a flat day sky (127,196,242) -> (207,234,252) with stepped cloud puffs (3-4
-- stacked Frames, each row 12 px narrower on each side, no corners). A Signboard hangs from the top of the screen on two
-- ropes: the flat pink awning, the navy header plank, the 6 px wood frame round the stone body; width min(0.5 W, 620
-- design px) and at least 480, the screen less a 16 px gutter on each side on a portrait phone (below 700 px wide). On a
-- short screen the header, padding and tag line shrink until the swinging board ends above the tip card. (sign/logo
-- build, the owner's answer 2026-11-13) It sways like the title screen's board: +-Config.MainMenu.Sway.Degrees, a full
-- back-and-forth every Sway.Period (Sine InOut), endlessly; the gui's Sway attribute false (MainMenuController passes
-- the Camera shake setting on) stops it level. Once SignKit is there the board wears B2 "Sky-climber's rig" like the
-- title screen's (SignKit.Rig; its propellers flip while it sways), and once Logo is there the header shows the logo
-- (the L1 picture when its TextureIds key has an id, the live L2 until then; the typed title stays under it, off).
--   * Before Shared.Theme replicates: the sky, the clouds and the whole board (no text), drawn with this script's own copy
--     of the few Theme.Sign tokens and SignKit sizes it needs (smoke loading_tokens_match_theme pins them equal).
--   * Once Theme (and SignKit, PixelIcon) exist: "NIMBUS CLIMB" in FredokaOne gold on the navy plank (no outline), the
--     tag line (Config.Tagline, Nunito italic), 12 stone blocks that turn gold one by one with a 0.12 s pop, the caption
--     "Loading the sky... 64%" (FredokaOne; session lock, 2026-11-10: "Another server is still saving your progress..."
--     while the player attribute SaveWaiting is true), a tip from UpdateNotes.Tips in a SignKit.Notice with the pixel bulb
--     (a random first one, then the next every 5 s), and SKIP, a SignKit plank with the pixel arrow, after
--     Config.Loading.SkipAfter (6) seconds.
--   * The owner's picks (morning, uploads): the TextureIds keys named in Config.Loading.Images. A key with no id (tonight:
--     all three) leaves its fallback; with an id the logo image replaces the typed title, the lobby render replaces the
--     drawn sky and clouds, the mascot hops along the gold blocks.
-- Everything is laid out in design px of a 1080p screen under one UIScale (Theme.ScreenFactor's rule), again whenever the
-- viewport changes.
--
-- Progress = 5 weighted stages, each 0..1; the gui attribute Progress only moves forward and the blocks and caption
-- draw from it:
--   game loaded 0.30 (game:IsLoaded()) | shared modules 0.10 (Config, Theme, Util, Voxel present)
--   lobby replicated 0.30 (BaseParts under workspace.NimbusLobby vs its PartCount attribute; counted once, then by
--     DescendantAdded; after game:IsLoaded() a lobby / PartCount that is not there counts as done: the initial
--     replication is complete) | assets 0.15 (ContentProvider:PreloadAsync of the Sky and this gui)
--   profile 0.15 (the player attribute ProfileLoaded = true, written by DataService when the profile is loaded or
--     provisional)
-- Finish at 100%, at Config.Loading.MaxSeconds (25) or on SKIP: attribute Done = true on the gui. MainMenuController
-- fades it and destroys it; with the menu disabled (Config.MainMenu.Enabled ~= true) this script fades it (0.8 s) after
-- 2 s itself, and it also does so 12 s after Done if nobody took it (a menu that failed to load).
-- One 0.25 s poll loop that ends at Done; no per-frame work. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
	return
end

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local L = {
	POLL = 0.25,
	TIP_EVERY = 5,
	SELF_FADE = 2, -- seconds after Done when no main menu runs
	ORPHAN_FADE = 12, -- seconds after Done when the menu should take it but never does
	FADE = 0.8,
	BLOCKS = 12,
	POP = 0.12, -- one block turns gold every POP seconds, lifting 4 px and dropping back
	SWAY = 1, -- degrees each way and a full back-and-forth: Config.MainMenu.Sway's (smoke pins them equal) until Config
	SWAY_PERIOD = 3.6,
	SKY_TOP = rgb(127, 196, 242),
	SKY_BOTTOM = rgb(207, 234, 252),
	CLOUD = rgb(255, 255, 255),
	CLOUD_SHADE = rgb(207, 230, 248), -- the pitch's cloud underside (#CFE6F8)
	-- the kit B tokens the board needs before Shared.Theme exists: a copy of Theme.Sign (smoke loading_tokens_match_theme)
	SIGN = {
		Stone = rgb(255, 247, 230),
		StoneLip = rgb(220, 201, 160),
		Wood = rgb(140, 90, 46),
		Navy = rgb(35, 42, 110),
		NavyLight = rgb(46, 58, 122), -- (sign/logo build) the B2 canopy, navy from the first frame
		NavyLip = rgb(23, 28, 79),
		Gold = rgb(255, 210, 74),
		GoldLip = rgb(201, 154, 30),
		Roof = rgb(238, 111, 166),
		RoofEdge = rgb(122, 42, 82),
		RoofLip = rgb(196, 74, 130),
		Post = rgb(196, 138, 78),
		Text = rgb(59, 36, 18),
		TextMuted = rgb(118, 84, 54),
	},
	-- ...and of the SignKit.Sizes it draws with (same pin)
	ROOF_H = 18,
	ROOF_EDGE = 4,
	ROOF_LIP = 5,
	RIM = 6,
	FRAME = 6,
	LIP = 8,
	ROPE_W = 6,
	BLOCK_EDGE = 2,
	BLOCK_LIP = 4,
	SKIP_W = 150,
	SKIP_H = 56,
	-- the cloud puffs: x, y (of the screen), bottom row width (design px), rows
	PUFFS = {
		{ 0.07, 0.17, 168, 3 }, { 0.9, 0.12, 192, 4 }, { 0.2, 0.42, 120, 3 }, { 0.83, 0.47, 144, 3 },
		{ 0.04, 0.74, 216, 4 }, { 0.95, 0.8, 168, 3 }, { 0.32, 0.93, 240, 4 }, { 0.66, 0.97, 192, 3 },
	},
	IMAGES = { Logo = "nimbus_logo", Backdrop = "ui_loading_lobby", Mascot = "ui_mascot_hop" },
	WEIGHTS = { Loaded = 0.30, Shared = 0.10, Lobby = 0.30, Assets = 0.15, Profile = 0.15 },
	STAGES = { "Loaded", "Shared", "Lobby", "Assets", "Profile" },
	SHARED = { "Config", "Theme", "Util", "Voxel" },
}
local SIGN = L.SIGN

-- live state (tests read it through the gui's attributes: Progress, Done, Tip)
local St = {
	Stage = { Loaded = 0, Shared = 0, Lobby = 0, Assets = 0, Profile = 0 },
	Shown = 0, -- the progress shown (never goes down)
	Blocks = 0, -- gold blocks drawn
	BlockTarget = 0,
	Stepping = false,
	Done = false,
	Elapsed = 0,
	TipIndex = 0,
	TipAt = 0,
	Lobby = nil, -- the NimbusLobby being counted
	LobbyParts = 0,
	LobbyConn = nil,
	Ui = {},
	Geo = {}, -- the last layout (design px)
	Images = {}, -- Logo / Backdrop / Mascot -> "rbxassetid://<id>" for the picks that have an id
	Theme = nil,
	Config = nil,
	Tips = {},
	Waiting = false, -- session lock: the player attribute SaveWaiting (another server still saves the progress)
}

----------------------------------------------------------------------
-- the gui: sky, clouds and the board at once (no text until Theme arrives)
----------------------------------------------------------------------

local function make(className, props, parent)
	local inst = Instance.new(className)
	for key, value in pairs(props) do
		inst[key] = value
	end
	inst.Parent = parent
	return inst
end

local function block(name, colour, props, parent)
	props.Name = name
	props.BackgroundColor3 = colour
	props.BorderSizePixel = 0
	return make("Frame", props, parent)
end

local function kit(obj, kind)
	obj:SetAttribute("SignKit", kind)
	return obj
end

local function viewport()
	local camera = Workspace.CurrentCamera
	local size = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if size.X < 2 or size.Y < 2 then
		size = Vector2.new(1920, 1080)
	end
	return size
end

-- Theme.ScreenFactor's rule, here before Theme exists: clamp(H / 1080, 0.8, 1.25)
local function factor(height)
	return math.max(0.8, math.min(1.25, height / 1080))
end

local playerGui = LocalPlayer:WaitForChild("PlayerGui")
local gui = make("ScreenGui", {
	Name = "NimbusLoading",
	DisplayOrder = 100,
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, playerGui)
gui:SetAttribute("Progress", 0)
gui:SetAttribute("Done", false)

local function buildSkeleton()
	local ui = St.Ui
	ui.Sky = make("Frame", {
		Name = "Sky",
		BackgroundColor3 = L.CLOUD,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Active = true, -- swallows clicks meant for the world behind
	}, gui)
	-- the day sky is the backdrop's paint, not a panel's gloss (attribute Art: the neon walks leave an illustration alone)
	make("UIGradient", { Color = ColorSequence.new(L.SKY_TOP, L.SKY_BOTTOM), Rotation = 90 }, ui.Sky):SetAttribute("Art", "Sky")

	-- the stepped puffs: each row a plain Frame 12 px narrower on each side than the one under it, a pale underside
	ui.Clouds = make("Frame", { Name = "Clouds", BackgroundTransparency = 1, ZIndex = 2 }, ui.Sky)
	ui.CloudScale = make("UIScale", { Name = "ReadScale" }, ui.Clouds)
	for i, p in ipairs(L.PUFFS) do
		local w, rows = p[3], p[4]
		local puff = make("Frame", {
			Name = "Puff" .. i,
			BackgroundTransparency = 1,
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(p[1], p[2]),
			Size = UDim2.fromOffset(w, rows * 14 + 6),
			ZIndex = 2,
		}, ui.Clouds)
		block("Shade", L.CLOUD_SHADE, { Position = UDim2.fromOffset(0, rows * 14), Size = UDim2.fromOffset(w, 6), ZIndex = 2 }, puff)
		for r = 1, rows do
			block("Row" .. r, L.CLOUD, {
				Position = UDim2.fromOffset(12 * (r - 1), (rows - r) * 14),
				Size = UDim2.fromOffset(w - 24 * (r - 1), 14),
				ZIndex = 2,
			}, puff)
		end
	end

	-- everything else: design px under one UIScale
	ui.Content = make("Frame", { Name = "Content", BackgroundTransparency = 1, ZIndex = 5 }, ui.Sky)
	ui.ReadScale = make("UIScale", { Name = "ReadScale" }, ui.Content)
	ui.Swing = make("Frame", {
		Name = "Swing",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0),
		ZIndex = 5,
	}, ui.Content)
	ui.Ropes = {}
	for i = 1, 2 do
		local rope = kit(block("Rope", SIGN.Post, { Size = UDim2.fromOffset(L.ROPE_W, 60), ZIndex = 1 }, ui.Swing), "Rope")
		block("Shade", SIGN.Wood, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, math.max(1, math.floor(L.ROPE_W / 3)), 1, 0),
			ZIndex = 1,
		}, rope)
		ui.Ropes[i] = rope
	end
	ui.Board = make("Frame", { Name = "Board", BackgroundTransparency = 1, ZIndex = 2 }, ui.Swing)

	-- the flat awning (SignKit.Roof): a fixed size, wider than the board; (sign/logo build) the B2 canopy's navy until
	-- SignKit.Rig stripes it
	ui.Roof = kit(block("Roof", SIGN.NavyLip, { ZIndex = 3 }, ui.Board), "Roof")
	local face = block("Face", SIGN.NavyLight, {
		Position = UDim2.fromOffset(L.ROOF_EDGE, L.ROOF_EDGE),
		Size = UDim2.new(1, -2 * L.ROOF_EDGE, 1, -2 * L.ROOF_EDGE),
		ZIndex = 3,
	}, ui.Roof)
	block("Lip", SIGN.NavyLip, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, L.ROOF_LIP),
		ZIndex = 3,
	}, face)

	-- the navy header plank in its wood rim (SignKit.Header)
	ui.Head = kit(block("Head", SIGN.Wood, { ZIndex = 2 }, ui.Board), "Header")
	ui.Plate = block("Plate", SIGN.Navy, {
		Position = UDim2.fromOffset(L.RIM, L.RIM),
		Size = UDim2.new(1, -2 * L.RIM, 1, -L.RIM),
		ZIndex = 2,
	}, ui.Head)

	-- the wood frame and the stone body with its lip (SignKit.Frame / Body)
	ui.Wood = kit(block("Wood", SIGN.Wood, { ZIndex = 1 }, ui.Board), "Frame")
	ui.Body = kit(block("Body", SIGN.Stone, {
		Position = UDim2.fromOffset(L.FRAME, L.FRAME),
		Size = UDim2.new(1, -2 * L.FRAME, 1, -2 * L.FRAME),
		ZIndex = 1,
	}, ui.Wood), "Body")
	block("Lip", SIGN.StoneLip, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, L.LIP),
		ZIndex = 1,
	}, ui.Body)

	-- the progress: 12 stone blocks with a darker lip (SignKit.BlockRow)
	ui.Row = kit(make("Frame", { Name = "BlockRow", BackgroundTransparency = 1, ZIndex = 2 }, ui.Body), "BlockRow")
	ui.Row:SetAttribute("Count", L.BLOCKS)
	ui.Row:SetAttribute("Filled", 0)
	for i = 1, L.BLOCKS do
		local b = block("Block" .. i, SIGN.Wood, { ZIndex = 2 }, ui.Row)
		local bf = block("Face", SIGN.Stone, {
			Position = UDim2.fromOffset(L.BLOCK_EDGE, L.BLOCK_EDGE),
			Size = UDim2.new(1, -2 * L.BLOCK_EDGE, 1, -2 * L.BLOCK_EDGE),
			ZIndex = 2,
		}, b)
		block("Lip", SIGN.StoneLip, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, L.BLOCK_LIP),
			ZIndex = 2,
		}, bf)
	end

end

-- (sign/logo build) the sway: Config.MainMenu.Sway once Config is there (this script's copy before), off while the gui's
-- Sway attribute is false (Camera shake OFF, passed on by MainMenuController); B2's propellers turn while it sways
local function swayCfg()
	local W = St.Config and type(St.Config.MainMenu) == "table" and St.Config.MainMenu.Sway
	if type(W) == "table" then
		return tonumber(W.Degrees) or 0, tonumber(W.Period) or L.SWAY_PERIOD
	end
	return L.SWAY, L.SWAY_PERIOD
end

local function sway()
	local ui = St.Ui
	local deg, period = swayCfg()
	local on = gui:GetAttribute("Sway") ~= false and deg > 0
	local spin = St.Kit and on
	if St.SwayOn == on and St.SwayDeg == deg and St.SwayPeriod == period and St.Spinning == spin then
		return
	end
	if St.SwayOn ~= on or St.SwayDeg ~= deg or St.SwayPeriod ~= period then
		if ui.SwingTween then
			ui.SwingTween:Cancel()
			ui.SwingTween = nil
		end
		if on then
			ui.Swing.Rotation = -deg
			ui.SwingTween = TweenService:Create(ui.Swing, TweenInfo.new(period / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
				Rotation = deg,
			})
			ui.SwingTween:Play()
		else
			ui.Swing.Rotation = 0
		end
	end
	St.SwayOn, St.SwayDeg, St.SwayPeriod, St.Spinning = on, deg, period, spin
	if St.Kit then
		St.Kit.Spin(ui.Board, on)
	end
end

----------------------------------------------------------------------
-- layout (design px of a 1080p screen; again on a viewport change, when the tip card or the mascot arrives)
----------------------------------------------------------------------

local function layout()
	local ui, Theme = St.Ui, St.Theme
	local vp = viewport()
	local f = factor(vp.Y)
	local dw, dh = vp.X / f, vp.Y / f
	-- a portrait phone: the full-width board, SKIP above the tip card (a landscape phone keeps SKIP beside the card,
	-- unless that leaves the card too thin)
	local narrow = vp.X < 700 and (vp.X < vp.Y or dw - 2 * (L.SKIP_W + 48) < 360)
	for _, pair in ipairs({ { ui.Clouds, ui.CloudScale }, { ui.Content, ui.ReadScale } }) do
		pair[1].Size = UDim2.fromOffset(math.floor(dw + 0.5), math.floor(dh + 0.5))
		pair[2].Scale = f
	end

	-- the tip card and SKIP along the bottom (SKIP above the card on a narrow screen)
	local tipW = narrow and math.floor(dw - 40) or math.floor(math.min(760, dw - 2 * (L.SKIP_W + 48)))
	local tipSize = narrow and 18 or 19
	local tipH = narrow and 116 or 80
	if Theme and ui.Tip and #St.Tips > 0 then
		-- tall enough for the longest tip: its one-line width over the text box, plus a line for word breaks
		local lines = 1
		for _, tip in ipairs(St.Tips) do
			local ok, size = pcall(Theme.Measure, tip, "Body", tipSize)
			if ok and size then
				lines = math.max(lines, math.ceil(size.X / (tipW - 76) + 0.25)) -- the card less the bulb, its gap and the edges
			end
		end
		tipH = math.max(64, math.ceil(lines * tipSize * 1.25) + 28)
	end
	local tipTop = dh - 20 - tipH
	local bottom = narrow and (tipTop - 24 - L.SKIP_H) or (tipTop - 16)

	-- the board: min(0.5 W, 620 design px) but never under 480 (the title's room on a portrait tablet), within the 16 px
	-- gutter; the screen less the gutter on a narrow screen
	local boardW = math.floor(dw - 32 / f)
	if not narrow then
		boardW = math.floor(math.min(boardW, math.max(480, math.min(0.5 * vp.X, 620 * f) / f)))
	end
	local inner = boardW - 2 * L.FRAME
	local droop = math.ceil(0.5 * boardW * math.sin(math.rad((swayCfg())))) -- a lower corner at the end of the swing
	local minTop = math.ceil(58 / f) + 12 -- below Roblox's top bar
	-- on a short screen (a 360 px landscape phone) step down until the swinging board ends above `bottom`: 1 a slimmer
	-- header and padding, 2 also no tag line; past that it may hang higher, into the top bar's height
	local headH, titleSize, pad, gap, bw, bh, rowW, compact, capH, tagY, tagH, rowY, capY, bodyH, woodH, boardH
	local headY = L.ROOF_H - 3
	for short = 0, 2 do
		local slim = narrow or short >= 1
		headH = slim and 64 or 84
		titleSize = slim and 44 or 64
		pad = slim and 12 or 18
		gap = slim and 4 or 6
		bw = math.min(40, math.floor((inner - 2 * pad - (L.BLOCKS - 1) * gap) / L.BLOCKS))
		bh = math.floor(bw * 0.8)
		rowW = L.BLOCKS * bw + (L.BLOCKS - 1) * gap
		compact = boardW < 600 -- the session-lock caption takes two lines there
		capH = compact and 52 or 30
		tagY, tagH = pad - 4, short >= 2 and 0 or 26
		rowY = (tagH > 0 and (tagY + tagH + 10) or pad) + (St.Images.Mascot and 36 or 0)
		capY = rowY + bh + 6
		bodyH = capY + capH + pad - 6 + L.LIP
		woodH = bodyH + 2 * L.FRAME
		boardH = headY + headH + woodH
		if minTop + boardH + droop <= bottom then
			break
		end
	end
	local topY = math.max(minTop, math.floor((bottom - boardH) * 0.45))
	if topY + boardH + droop > bottom then
		topY = math.max(8, bottom - boardH - droop)
	end
	St.Geo = { BoardW = boardW, BlockW = bw, Gap = gap, RowY = rowY, RowX = math.floor((inner - rowW) / 2) }

	local half = topY + boardH
	local sideX = 32
	ui.Swing.Size = UDim2.fromOffset(boardW + 2 * sideX, 2 * half)
	ui.Board.Position = UDim2.fromOffset(sideX, half + topY)
	ui.Board.Size = UDim2.fromOffset(boardW, boardH)
	for i, rope in ipairs(ui.Ropes) do
		local x = sideX + math.floor((i == 1 and 0.18 or 0.82) * boardW) - L.ROPE_W / 2
		rope.Position = UDim2.fromOffset(x, half - 12)
		rope.Size = UDim2.fromOffset(L.ROPE_W, topY + 20)
	end
	ui.Roof.Position = UDim2.fromOffset(-12, 0)
	ui.Roof.Size = UDim2.fromOffset(boardW + 24, L.ROOF_H)
	ui.Head.Position = UDim2.fromOffset(0, headY)
	ui.Head.Size = UDim2.fromOffset(boardW, headH)
	ui.Wood.Position = UDim2.fromOffset(0, headY + headH)
	ui.Wood.Size = UDim2.fromOffset(boardW, woodH)
	ui.Row.Position = UDim2.fromOffset(St.Geo.RowX, rowY)
	ui.Row.Size = UDim2.fromOffset(rowW, bh)
	for i = 1, L.BLOCKS do
		local b = ui.Row:FindFirstChild("Block" .. i)
		b.Position = UDim2.fromOffset((i - 1) * (bw + gap), 0)
		b.Size = UDim2.fromOffset(bw, bh)
	end
	if ui.Title then
		-- stepped down until it fits the plate with 12 px each side
		local room = boardW - 2 * L.RIM - 24
		while titleSize > 24 do
			local ok, size = pcall(Theme.Measure, ui.Title.Text, "Title", titleSize)
			if not ok or not size or size.X <= room then
				break
			end
			titleSize = titleSize - 2
		end
		ui.Title.TextSize = titleSize
	end
	if ui.Tagline then
		ui.Tagline.Visible = tagH > 0
		ui.Tagline.Position = UDim2.fromOffset(pad, tagY)
		ui.Tagline.Size = UDim2.fromOffset(inner - 2 * pad, math.max(tagH, 1))
	end
	if ui.Caption then
		ui.Caption.Position = UDim2.fromOffset(pad, capY)
		ui.Caption.Size = UDim2.fromOffset(inner - 2 * pad, capH)
		ui.Caption.TextSize = compact and 20 or 22
	end
	if ui.TipCard then
		ui.TipCard.Position = UDim2.fromOffset(math.floor(dw / 2), math.floor(dh - 20))
		ui.TipCard.Size = UDim2.fromOffset(tipW, tipH)
		ui.Tip.TextSize = tipSize
	end
	if ui.Skip then
		if narrow then
			ui.Skip.Position = UDim2.fromOffset(math.floor(dw - 20), math.floor(tipTop - 12))
		else
			ui.Skip.Position = UDim2.fromOffset(math.floor(dw - 24), math.floor(dh - 24))
		end
	end
	if ui.Mascot then
		ui.Mascot.Position = UDim2.fromOffset(St.Geo.RowX + math.max(0, St.Blocks - 0.5) * (bw + gap), rowY)
	end
	-- (sign/logo build) the owner's B2 rig (SignKit.Rig, once SignKit is there), drawn again when the board changes size
	-- (its canopy is cut to the width, the lashings and the plate sit on its corners and foot)
	local rigKey = boardW .. "x" .. boardH .. "x" .. topY
	if St.Kit and St.RigKey ~= rigKey then
		St.RigKey = rigKey
		St.Kit.Rig({ Board = ui.Board, Roof = ui.Roof, Head = ui.Head, Frame = ui.Wood, Ropes = ui.Ropes }, {
			Width = boardW,
			Version = St.Latest and ("V" .. tostring(St.Latest)) or nil,
		})
	end
	-- the logo on the header (over the canopy: its bumps rise above the plate, its bolt ends at the plate's foot), built
	-- again when the header or the picture changes
	local logoKey = boardW .. "x" .. headH .. "x" .. tostring(St.Images.Logo)
	if St.LogoMod and St.LogoKey ~= logoKey then
		St.LogoKey = logoKey
		if ui.Logo then
			ui.Logo:Destroy()
		end
		local s = St.LogoMod.Fit(boardW - 2 * L.RIM, headH - L.RIM)
		ui.Logo = St.LogoMod.Build(ui.Board, {
			Image = St.Images.Logo,
			Scale = s,
			Position = UDim2.fromOffset(math.floor(boardW / 2), math.floor(headY + L.RIM - 18 * s)),
			ZIndex = 4,
		})
		if ui.Title then
			ui.Title.Visible = false
		end
	end
end

----------------------------------------------------------------------
-- the picks' images (Config.Loading.Images keys in TextureIds; the logo has its uploaded id, the backdrop and mascot none)
----------------------------------------------------------------------

local function applyImages(ids)
	local names = (St.Config and type(St.Config.Loading) == "table" and type(St.Config.Loading.Images) == "table" and St.Config.Loading.Images) or L.IMAGES
	for role, key in pairs(names) do
		local id = type(ids) == "table" and tonumber(ids[key]) or nil
		if id and id > 0 then
			local digits = string.format("%.0f", id) -- whole digits: a 15-digit id (nimbus_logo) never prints as 1.3e+14
			St.Images[role] = "rbxassetid://" .. digits
		end
	end
	local ui = St.Ui
	if St.Images.Backdrop and not ui.Backdrop then
		ui.Backdrop = make("ImageLabel", {
			Name = "Backdrop",
			BackgroundTransparency = 1,
			Image = St.Images.Backdrop,
			ScaleType = Enum.ScaleType.Crop,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
		}, ui.Sky)
		ui.Clouds.Visible = false
	end
	-- (sign/logo build) the logo picture (L1) goes on in layout(), on shared/Logo
	if St.Images.Mascot and not ui.Mascot then
		ui.Mascot = make("ImageLabel", {
			Name = "Mascot",
			BackgroundTransparency = 1,
			Image = St.Images.Mascot,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(34, 34),
			ZIndex = 4,
		}, ui.Body)
	end
	layout()
end

----------------------------------------------------------------------
-- the text, the tip card and SKIP (after Theme, on SignKit and PixelIcon)
----------------------------------------------------------------------

local function label(name, text, role, size, colour, props, parent)
	local obj = make("TextLabel", { Name = name, BackgroundTransparency = 1, Text = text }, parent)
	St.Theme.Style(obj, role, { Size = size, Color = colour })
	for key, value in pairs(props) do
		obj[key] = value
	end
	return obj
end

local function buildText(SignKit, PixelIcon)
	local ui, Sign = St.Ui, St.Theme.Sign
	ui.Title = label("Title", "NIMBUS CLIMB", "Title", 64, Sign.Gold, {
		Size = UDim2.fromScale(1, 1),
		Visible = St.LogoMod == nil, -- (sign/logo build) the logo shows the game's name once shared/Logo is there
		ZIndex = 3,
	}, ui.Plate)
	St.Theme.StyleTitle(ui.Title) -- (T0) the one title treatment, as every window title
	-- the game's tag line (Config.Tagline; St.Config is nil when Config failed to load)
	local tagline = (St.Config and type(St.Config.Tagline) == "string" and St.Config.Tagline) or "Climb the storm. Together."
	ui.Tagline = label("Tagline", tagline, "Script", 20, Sign.TextMuted, { ZIndex = 2 }, ui.Body)
	ui.Caption = label("Caption", "Loading the sky... 0%", "Heading", 22, Sign.Text, { TextWrapped = true, ZIndex = 2 }, ui.Body)
	if not (SignKit and PixelIcon) then
		return
	end
	St.Kit = type(SignKit.Rig) == "function" and SignKit or nil -- (sign/logo build) layout() draws the B2 rig
	-- the tip: a small wood-framed stone card with the pixel bulb on a gold chip
	local card, face = SignKit.Notice(ui.Content, {
		Name = "TipCard",
		Text = "",
		IconSlot = true,
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 5,
	})
	ui.TipCard = card
	ui.Tip = face:FindFirstChild("Text")
	if ui.Tip then
		ui.Tip.Name = "Tip"
	end
	local slot = face:FindFirstChild("IconSlot")
	if slot then
		slot.BackgroundTransparency = 0
		slot.BackgroundColor3 = Sign.Gold
		local icon = PixelIcon.New(slot, "bulb", 27, Sign.Text)
		if icon then
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Position = UDim2.fromScale(0.5, 0.5)
		end
	end
	-- SKIP: a stone plank with the pixel arrow (bottom-right; above the tip card on a narrow screen)
	ui.Skip = SignKit.Plank(ui.Content, {
		Name = "Skip",
		Text = "SKIP",
		Style = "Stone",
		IconSlot = true,
		Width = L.SKIP_W,
		Height = L.SKIP_H,
		AnchorPoint = Vector2.new(1, 1),
		Visible = false,
		ZIndex = 8,
		Callback = function()
			St.Skipped = true
		end,
	})
	local iconSlot = ui.Skip:FindFirstChild("IconSlot", true)
	if iconSlot then
		local arrow = PixelIcon.New(iconSlot, "arrow", 27, Sign.Text)
		if arrow then
			arrow.AnchorPoint = Vector2.new(0.5, 0.5)
			arrow.Position = UDim2.fromScale(0.5, 0.5)
		end
	end
end

----------------------------------------------------------------------
-- progress
----------------------------------------------------------------------

local function countLobby(lobby)
	if St.Lobby == lobby then
		return
	end
	if St.LobbyConn then
		St.LobbyConn:Disconnect()
	end
	St.Lobby = lobby
	local n = 0
	for _, d in ipairs(lobby:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
		end
	end
	St.LobbyParts = n
	St.LobbyConn = lobby.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			St.LobbyParts = St.LobbyParts + 1
		end
	end)
end

local function measure()
	local loaded = game:IsLoaded()
	St.Stage.Loaded = loaded and 1 or 0
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local have = 0
	for _, name in ipairs(L.SHARED) do
		if shared and shared:FindFirstChild(name) then
			have = have + 1
		end
	end
	St.Stage.Shared = have / #L.SHARED
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	local total = lobby and lobby:GetAttribute("PartCount") or nil
	if lobby and type(total) == "number" and total > 0 then
		countLobby(lobby)
		St.Stage.Lobby = math.min(1, St.LobbyParts / total)
	elseif loaded then
		St.Stage.Lobby = 1
	end
	local attr = (St.Config and St.Config.Attr and St.Config.Attr.ProfileLoaded) or "ProfileLoaded"
	St.Stage.Profile = LocalPlayer:GetAttribute(attr) == true and 1 or 0
	local sum = 0
	for _, name in ipairs(L.STAGES) do
		sum = sum + L.WEIGHTS[name] * St.Stage[name]
	end
	return sum
end

local function paintBlock(i, on)
	local b = St.Ui.Row:FindFirstChild("Block" .. i)
	local face = b and b:FindFirstChild("Face")
	if face then
		face.BackgroundColor3 = on and SIGN.Gold or SIGN.Stone
		local lip = face:FindFirstChild("Lip")
		if lip then
			lip.BackgroundColor3 = on and SIGN.GoldLip or SIGN.StoneLip
		end
	end
end

local function blocksShown(k)
	St.Blocks = k
	St.Ui.Row:SetAttribute("Filled", k)
	local mascot = St.Ui.Mascot
	if mascot then
		local g = St.Geo
		local at = UDim2.fromOffset(g.RowX + math.max(0, k - 0.5) * (g.BlockW + g.Gap), g.RowY)
		mascot.Position = at
		TweenService:Create(mascot, TweenInfo.new(L.POP, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), {
			Position = at + UDim2.fromOffset(0, -10),
		}):Play()
	end
end

-- one block at a time towards the target, each lifting 4 px and dropping back (a jump down is drawn at once)
local function stepBlocks()
	if St.Stepping then
		return
	end
	St.Stepping = true
	task.spawn(function()
		while St.Blocks < St.BlockTarget and gui.Parent do
			local i = St.Blocks + 1
			paintBlock(i, true)
			blocksShown(i)
			local b = St.Ui.Row:FindFirstChild("Block" .. i)
			if b then
				local at = b.Position
				TweenService:Create(b, TweenInfo.new(L.POP / 2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true), {
					Position = at + UDim2.fromOffset(0, -4),
				}):Play()
			end
			task.wait(L.POP)
		end
		St.Stepping = false
	end)
end

-- the blocks and the caption, from the gui attribute Progress
local function drawProgress()
	local p = tonumber(gui:GetAttribute("Progress")) or 0
	local k = math.max(0, math.min(L.BLOCKS, math.floor(p * L.BLOCKS + 1e-6)))
	St.BlockTarget = k
	if k < St.Blocks then
		for i = k + 1, St.Blocks do
			paintBlock(i, false)
		end
		blocksShown(k)
	elseif k > St.Blocks then
		stepBlocks()
	end
	local caption = St.Ui.Caption
	if caption then
		-- session lock (spec 18): while another server still saves this player's progress (the player attribute
		-- SaveWaiting, DataService's) the caption says so instead of the percentage
		if St.Waiting then
			caption.Text = "Another server is still saving your progress..."
		else
			caption.Text = "Loading the sky... " .. math.floor(p * 100 + 0.5) .. "%"
		end
	end
end

local function showProgress(value, force)
	if value <= St.Shown and not force then
		return
	end
	St.Shown = math.min(1, math.max(St.Shown, value))
	gui:SetAttribute("Progress", St.Shown)
	drawProgress()
end

-- true while the player attribute SaveWaiting is set; a change re-draws the caption even when the bar did not move
local function waitingChanged()
	local attr = (St.Config and St.Config.Attr and St.Config.Attr.SaveWaiting) or "SaveWaiting"
	local now = LocalPlayer:GetAttribute(attr) == true
	if now == St.Waiting then
		return false
	end
	St.Waiting = now
	return true
end

local function nextTip()
	local tips = St.Tips
	if #tips == 0 or not St.Ui.Tip then
		return
	end
	St.TipIndex = St.TipIndex % #tips + 1
	St.Ui.Tip.Text = tips[St.TipIndex]
	gui:SetAttribute("Tip", St.TipIndex)
end

----------------------------------------------------------------------
-- fade out (used when no main menu takes the screen)
----------------------------------------------------------------------

local function fadeAndDestroy()
	if not gui.Parent or gui:GetAttribute("Fading") then
		return
	end
	gui:SetAttribute("Fading", true)
	local info = TweenInfo.new(L.FADE)
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("GuiObject") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				TweenService:Create(d, info, { TextTransparency = 1 }):Play()
			elseif d:IsA("ImageLabel") then
				TweenService:Create(d, info, { ImageTransparency = 1 }):Play()
			end
		end
	end
	task.delay(L.FADE, function()
		gui:Destroy()
	end)
end

local function finish()
	if St.Done then
		return
	end
	St.Done = true
	showProgress(1)
	gui:SetAttribute("Done", true)
	if St.LobbyConn then
		St.LobbyConn:Disconnect()
		St.LobbyConn = nil
	end
	local menuOn = St.Config and type(St.Config.MainMenu) == "table" and St.Config.MainMenu.Enabled == true
	task.delay(menuOn and L.ORPHAN_FADE or L.SELF_FADE, fadeAndDestroy)
end

----------------------------------------------------------------------
-- boot
----------------------------------------------------------------------

buildSkeleton()
layout()
sway()
gui:GetAttributeChangedSignal("Progress"):Connect(drawProgress)
gui:GetAttributeChangedSignal("Sway"):Connect(function()
	pcall(sway)
end)
do
	local camera = Workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if gui.Parent then
				pcall(layout)
			end
		end)
	end
end

task.spawn(function()
	local shared = ReplicatedStorage:WaitForChild("Shared")
	local okConfig, Config = pcall(function()
		return require(shared:WaitForChild("Config"))
	end)
	St.Config = okConfig and Config or nil
	local okIds, ids = pcall(function()
		return require(shared:WaitForChild("TextureIds", 10))
	end)
	if okIds and type(ids) == "table" then
		local okImages, err = pcall(applyImages, ids)
		if not okImages then
			warn("[LoadingScreen] " .. tostring(err))
		end
	end
	local okTheme, Theme = pcall(function()
		return require(shared:WaitForChild("Theme"))
	end)
	if not okTheme or type(Theme) ~= "table" or not gui.Parent then
		return
	end
	St.Theme = Theme
	local okKit, SignKit = pcall(function()
		return require(shared:WaitForChild("SignKit", 10))
	end)
	local okIcon, PixelIcon = pcall(function()
		return require(shared:WaitForChild("PixelIcon", 10))
	end)
	local okNotes, notes = pcall(function()
		return require(shared:WaitForChild("UpdateNotes", 10))
	end)
	if okNotes and type(notes) == "table" and type(notes.Tips) == "table" then
		St.Tips = notes.Tips
	end
	if okNotes and type(notes) == "table" then
		St.Latest = notes.Latest -- (sign/logo build) the rig's brass version plate
	end
	local okLogo, LogoMod = pcall(function()
		return require(shared:WaitForChild("Logo", 10))
	end)
	St.LogoMod = okLogo and type(LogoMod) == "table" and type(LogoMod.Build) == "function" and LogoMod or nil
	if #St.Tips > 0 then
		-- a random first tip each load (UserId % #Tips showed a player the same tip every time); nextTip() moves to it
		St.TipIndex = math.random(1, #St.Tips) - 1
	end
	local okBuild, err = pcall(buildText, okKit and type(SignKit) == "table" and SignKit or nil, okIcon and type(PixelIcon) == "table" and PixelIcon or nil)
	if not okBuild then
		warn("[LoadingScreen] " .. tostring(err))
	end
	pcall(layout)
	pcall(sway) -- Config's sway numbers, and the propellers now that the rig is drawn
	nextTip()
	St.TipAt = St.Elapsed
	local okMeasure, value = pcall(measure)
	pcall(waitingChanged)
	showProgress(okMeasure and value or St.Shown, true)
	-- assets: the sky faces and this gui (the picks' images with it)
	task.spawn(function()
		local list = { gui }
		local skyInst = Lighting:FindFirstChildOfClass("Sky")
		if skyInst then
			list[#list + 1] = skyInst
		end
		pcall(function()
			ContentProvider:PreloadAsync(list)
		end)
		St.Stage.Assets = 1
	end)
end)

task.spawn(function()
	local loading = (St.Config and St.Config.Loading) or {}
	while not St.Done and gui.Parent do
		local dt = task.wait(L.POLL)
		St.Elapsed = St.Elapsed + (tonumber(dt) or L.POLL)
		loading = (St.Config and St.Config.Loading) or loading
		local ok, value = pcall(measure)
		local okWait, changed = pcall(waitingChanged)
		if ok then
			showProgress(value, okWait and changed)
		elseif okWait and changed then
			showProgress(St.Shown, true)
		end
		if St.Ui.Skip and not St.Ui.Skip.Visible and St.Elapsed >= (tonumber(loading.SkipAfter) or 6) then
			St.Ui.Skip.Visible = true
		end
		if St.Elapsed - St.TipAt >= L.TIP_EVERY then
			St.TipAt = St.Elapsed
			nextTip()
		end
		if St.Skipped or St.Shown >= 0.999 or St.Elapsed >= (tonumber(loading.MaxSeconds) or 25) then
			finish()
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="5">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">AttackFxCatalog</string>
          <string name="Source"><![CDATA[-- AttackFxCatalog: the look of every pet attack effect (docs/superpowers/specs/2026-10-23-pet-attack-vfx-design.md,
-- plan docs/superpowers/plans/2026-10-23-pet-attack-vfx.md Task 4). The single source of every effect's data: the
-- AttackFx engine (client) and BattleController only PLAY what Resolve returns. Pure data + pure functions: no
-- Instances, no services, no yields; safe on the server and the client. Plain Lua 5.1-compatible syntax only.
-- 2026-11-01: docs/superpowers/specs/2026-11-01-attack-fx-design.md (bigger, an impact package for every hit, lingering marks, the kick).
-- 2026-11-02: docs/superpowers/specs/2026-11-01-evolved-forms-design.md (every special and element form has its look).
--
-- Tables a designer tunes (each one mirrors a spec section):
--   Bands / Sizes / StageBonus / SizeCap        "Rarity ladder": 4 bands (Common+Uncommon, Rare+Epic, Legendary+Mythic,
--                                               Secret), sizes 1.3 .. 1.6, Evolved +15% / Evolved II +30%, hard cap 2.08
--                                               (attack effects spec 2026-11-01)
--   CloudCap                                    particle clouds stop growing at 1.6 (the target stays visible): evolved
--                                               size goes into rings, ground marks and shapes
--   ImpactScale[band]                           how strong the impact package plays: ring / ground mark / sparks / flash
--   Afterglow[band]                             seconds a Linger layer outlives the beats, dim and still (up to 2 s): visuals only,
--                                               ability timers never move (attack effects spec 2026-11-01 "Lasting longer")
--   Kick                                        the camera kick on your own attacks, by kind and band (spec "Camera kick")
--   CoreLook[band]                              the core's intensity and shape per band (plain -> hot inner core ->
--                                               blazing + upgraded shape -> white plasma with a colour-shifting rim)
--   Ladder                                      the layers each rarity ADDS (every rarity keeps all the layers below it)
--   LayerSlots[id]                              the layer templates the ladder names ("$Burst" etc. = the element's sheet)
--   Elements[element]                           "Elements: normal attacks": palette, melee swipe, ranged projectile +
--                                               trail, impact sheets, the "alive" detail, the Storm special's rain,
--                                               Tints[layerId]? (an explicit colour for a shared layer, like a signature's;
--                                               a signature's own Tints win)
--   Shapes[shape]                               the 8 element attacks (Cone / Circle / Line of BattleCatalog.ElementAttacks)
--   Specials[kind]                              "Specials (the 9 kinds)": core, beats, extra layers, skipped ladder layers;
--                                               each element retextures them by its sheets (slots) + Elements[e].Specials
--   Reactions (Hurt / Ko / Victory / ShieldHit) the small reaction effects (ShieldHit: a shield absorbs a later hit)
--   Signatures[petId]                           "Signature specials (12 pets)": overrides on top of their kind; Forms = { [1], [2] }: the
--                                               pet's unique evolved looks; Plain = true (four Epic / Legendary pets): no signature at
--                                               the start, their kind's recipe, only the forms are theirs
--   Forms[kind][stage]                          evolved forms: the shared look of a kind's form, in the pet's colours (Common to Rare
--                                               wear it as it is; a pet with Forms adds its own over it)
--   ElementForms[element][stage]                the normal attacks' forms, by element
--   Twists[id]                                  the short recipes of a form's delayed hits (Aftershock, Twin ...): no charge, the
--                                               element's colours
--   Textures[key]                               mirror of blender/vfx/textures.json { Grid = 4 | 1, Baked = bool } (smoke
--                                               p7vfx_catalog checks it): Grid 1 strips (fx_lightning, fx_speedlines) are
--                                               for Beam / Trail layers ONLY; every Emitter / Decal texture is a 4x4 flipbook
--
-- API:
--   AttackFxCatalog.BandOf(rarity) -> 1..4                         unknown rarity -> 1
--   AttackFxCatalog.SizeOf(rarity, stage) -> number                Sizes[rarity] x (1 + StageBonus[stage]), <= SizeCap 2.08;
--                                                                  unknown rarity = Common, stage clamped to 0..2 (non-number 0)
--   AttackFxCatalog.CloudSizeOf(rarity, stage) -> number           SizeOf, <= CloudCap 1.6: what an emitter's particles scale by
--   AttackFxCatalog.Resolve(req) -> recipe | nil                   req = { Element, Attack, Kind, Shape, Rarity, Stage, PetId,
--                                                                  Mine, Distance? }; Attack = "Melee" | "Ranged" | "Special" |
--                                                                  "Element" | "Hurt" | "Ko" | "Victory" | "ShieldHit"; Kind = one of the 9
--                                                                  special kinds (Special; a signature pet may leave it nil);
--                                                                  Shape = "Cone" | "Circle" | "Line" (Element; nil = the element's
--                                                                  BattleCatalog shape); Distance = studs to the target (projectile
--                                                                  travel, default 14). nil for an unknown element / attack / kind /
--                                                                  shape (the caller falls back to the cube Fx).
--                                                                  (evolved forms) Form = the stage of the form to draw (the event's, a
--                                                                  Special or an Element: absent = the plain recipe, so a helper's buff
--                                                                  stays plain); Twist = a Twists id (a form's delayed hit, nil when
--                                                                  unknown); Seconds = an aura's length (Rally / Haste: recipe.Aura)
--     recipe = { Element, Attack, Kind, Shape, Rarity, Stage, Band, Size, CloudSize, Density (1 mine / 0.6 others), Dropped?
--                ({ "Charge" | "Slash" | "Trail" | "Sparks" | "Pulse" }: the layers that yielded to the 6-emitter cap), Afterglow (seconds, Afterglow[band]; 0 on support casts
--                and reactions), CameraPunch (false, or { Amount, Crit, Seconds, Basic, Gap }: an own attack; never a reaction or a
--                support cast; the engine adds Crit on a crit, a Basic kick waits Gap since the last one), ScreenGlow (mine and band 4; not Quiet),
--                Signature (petId | nil), Sig = { Name, Twist, Actor, DimWorld } | nil (a form's Name; also when a form or twist has an Actor),
--                Twist (a Twists id | nil), Aura (seconds | nil: AllyRing, Rouse, Wind and Gust carry Linger, they hold until the aura ends),
--                Palette = { Core, Mid, Edge, Hot, Smoke }, Text,
--                Beats = { Charge, Release, Travel, Impact, Linger, MinTravel? } (seconds), ImpactAt (= Charge + Release +
--                Travel: the engine starts the effect so that impact lands on the server event, never later, except
--                that a basic Ranged shot keeps MinTravel of flight: player note 1, the shot is always seen crossing),
--                Core = { Key (vfx_* MeshIds key), Color, Material, Path ("Projectile"|"Swipe"|"Ground"|"Self"|"Allies"|
--                "Area"), Glow, InnerColor?, RimColor?, RimShift?, Upgraded, Speed?, Count?, Scale?, ... shape flags },
--                LowKeep = { layerId, ... } (Low quality keeps the Burst and then the first of these that the effect has: the
--                element's most characteristic emitter, chosen on purpose, not left to the engine's rank),
--                Layers = { { Id, Kind ("Emitter"|"Beam"|"Trail"|"Light"|"Ring"|"Decal"|"Mesh"), Beat, At, Texture?, Key?,
--                Color, Count?, Size?, Motion?, Delay?, Transparency? (0..1: lifts the layer's whole fade, see-through),
--                LightEmission? (overrides the sheet's / beam's default; the engine lights a layer under 0.5 by the scene
--                and starts a glow hot from 0.8), SpeedScale? (x the emitter preset's speed), KeepCount? (n: a Beam layer
--                that is the kind's / element's identity: under the 4-beam cap it gets n beams before any other layer's
--                second beam), (Studio findings round, 2026-10-27:) Height? (studs: an "Above" emitter this high over the hit
--                point instead of ABOVE x size: the Storm cloud low over its zone, the rain falls from it), Tint2? (a
--                second Palette entry -> Color2: an emitter's puffs are born in it and darken into Color: a two-tone cloud),
--                Streak? (a falling rain layer drawn as thin velocity-aligned streaks when its sheet is fx_streak), Ride?
--                (an emitter streaming off the caster through its leap: the Pounce's storm-cloud ride), Strike? (a Beam
--                layer whose bolts strike down round the hit: the Pounce slam), Level? (a vfx_ring at the hit's height,
--                not flat on the floor), OrbRadius? (a Ring's peak radius = this x the Blast orb's peak radius), Reach? (a
--                Ring peaking at the attack's real radius, eff.Reach: the ground ring that shows an area as it hits), Thin? (a
--                Ring whose height stops growing at its full size: a wide ring stays a line on the floor), PeakStuds? (a Ring is
--                at most this wide, studs across, and never past the attack's real radius), Linger? (a
--                ground mark / ember layer that outlives the beats by the Afterglow, dim and still: only Decal and Alive layers; in an aura, a
--                layer that holds until it ends), (evolved forms) Each? (a Ring At "Target": one on each target), NoLow? (not drawn on Graphics
--                Low), CountFixed? (a Count no band scales: Thunder Pack's 4 strikes), Seconds? (a Beam At "Path": how long it stays) ... } } (a template's
--                Except = { [Attack or special Kind] = true } leaves
--                it out of those attacks), Alive = { Kind ("Emitter"|"Beam"|"Decal"|"Mesh"), Texture?,
--                Key?, Motion, Color, Count, Seconds, Text } ({} = none) }
--     Layer kinds: Emitter = a flipbook ParticleEmitter (4x4 sheet); Beam / Trail = a grid-1 strip or untextured; Light =
--     a PointLight; Ring = an expanding solid vfx_* mesh (vfx_ring / vfx_shell); Decal = a ground-flat layer (a 4x4 sheet
--     played as a flat flipbook particle, or an untextured glow disc); Mesh = a solid vfx_* piece with a Motion (e.g.
--     Nature's roots erupting). Burst Motion: "Geyser" (an upward column), "Implode" (contracts inward first), "Shatter",
--     "Burst"; Delay = seconds after the beat starts (Shadow's glass shatters after the implosion).
--     Layer At: "Source" (mouth / paws), "Core" (on the moving core), "Path" (source -> target), "Target", "Ground" (under
--     the hit point), "Above" (over the target), "Behind" (behind the caster), "Self", "Allies". Counts are FULL density:
--     ladder / kind layers x CountScale[band]; the element's own impact detail and alive detail x DetailScale[band]
--     (reduced at band 1, growing by band). The engine multiplies them by Density and its quality factor. Recipes are
--     fresh tables every call.
--   AttackFxCatalog.Unit(info) -> { Element, Rarity, Stage, PetId, Ranged, Form }   from a BattleSim unitInfo (petId, key, look,
--                                                                  element, elements, evo, ranged): Rarity = an explicit
--                                                                  info.rarity / look.Rarity, else PetCatalog.Get(petId | key's
--                                                                  base).Rarity, else a hybrid's: the HIGHER of its look.BodyId
--                                                                  and look.StyleId pets' rarities (PetKeys' own rule), else
--                                                                  "Common"; Element = the FIRST of `elements` (else `element`);
--                                                                  Stage = evo clamped 0..2; Form = info.special.Form (a hybrid's
--                                                                  real stage too); PetId = info.petId, else the key's base: a
--                                                                  hybrid's is its own key ("hyb:<uid>@Tier"), never look.BodyId,
--                                                                  so it draws the SHARED form of its kind, never its body pet's
--                                                                  signature (Shadow Pack is Stormfang's alone)
--   AttackFxCatalog.Signatures[petId]                              the 12 signature pets + the 4 Plain ones (Element, Kind, Rarity, Twist, overrides, Forms)
--   AttackFxCatalog.Forms / ElementForms / Twists                  the evolved forms' looks (above)
--   AttackFxCatalog.AttackNames / KindNames / ShapeNames / Rarities   ordered name lists (the /fx dev command validates with them)

local Shared = script.Parent

local AttackFxCatalog = {}

local floor, min, max, huge = math.floor, math.min, math.max, math.huge

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end
local WHITE = rgb(255, 255, 255)

----------------------------------------------------------------------
-- Lazy modules (load order must never matter)
----------------------------------------------------------------------
local lazyCache = {}
local function lazy(name)
	local entry = lazyCache[name]
	if entry == nil then
		entry = false
		local inst = Shared:FindFirstChild(name)
		if inst then
			local ok, result = pcall(require, inst)
			if ok and type(result) == "table" then
				entry = result
			end
		end
		lazyCache[name] = entry
	end
	return entry or nil
end

local function finite(n)
	return type(n) == "number" and n == n and n ~= huge and n ~= -huge
end

local function copy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = copy(v)
	end
	return out
end

local function merge(into, from)
	if type(from) == "table" then
		for k, v in pairs(from) do
			into[k] = copy(v)
		end
	end
	return into
end

----------------------------------------------------------------------
-- Names
----------------------------------------------------------------------
AttackFxCatalog.Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }
AttackFxCatalog.AttackNames = { "Melee", "Ranged", "Special", "Element", "Hurt", "Ko", "Victory", "ShieldHit" }
AttackFxCatalog.KindNames = { "Blast", "Heal", "Shield", "Storm", "Pounce", "Freeze", "Beam", "Rally", "Haste" } -- PetCatalog.SpecialKinds
AttackFxCatalog.ShapeNames = { "Cone", "Circle", "Line" }

local rarityOrder = {}
for i, r in ipairs(AttackFxCatalog.Rarities) do
	rarityOrder[r] = i
end

----------------------------------------------------------------------
-- Rarity ladder (spec "Rarity ladder"): rarity shows through the core's intensity and shape in 4 bands, not sheer size
----------------------------------------------------------------------
AttackFxCatalog.Bands = { Common = 1, Uncommon = 1, Rare = 2, Epic = 2, Legendary = 3, Mythic = 3, Secret = 4 }
AttackFxCatalog.Sizes = { Common = 1.3, Uncommon = 1.35, Rare = 1.4, Epic = 1.45, Legendary = 1.5, Mythic = 1.55, Secret = 1.6 }
AttackFxCatalog.StageBonus = { [0] = 0, [1] = 0.15, [2] = 0.30 } -- Evolved +15%, Evolved II +30%
AttackFxCatalog.SizeCap = 2.08 -- (= Secret 1.6 x 1.3)
-- (Gemini, spec 2026-11-01: clouds past x1.6 hide the target) an emitter's particles stop at this; evolved size goes
-- into the cores, rings and ground marks, which take the full Size (a light's range stops at 1.4: AttackFx K.LIGHT_SIZE)
AttackFxCatalog.CloudCap = 1.6
AttackFxCatalog.ImpactScale = { 0.8, 0.95, 1.1, 1.25 } -- the impact package by band: Secret's is stronger than Common's
AttackFxCatalog.OthersDensity = 0.6 -- other players' and wild pets' effects (own team: 1)
-- (attack effects, 2026-11-01, "A. Visuals only") seconds a Linger layer outlives the beats, by band: dimmer, no pulse, so it clearly reads as over
AttackFxCatalog.Afterglow = { 0.8, 1.2, 1.6, 2.0 }
-- (review) how see-through a thing that is over starts: AttackFx's lingering marks and BattleController's zone tail read this one number;
-- a live Storm zone's disc is 0.62, so nothing over ever looks as solid as something that still hurts
AttackFxCatalog.TailTransparency = 0.85
-- (attack effects, 2026-11-01) the camera kick: base by kind + BandStep per band above 1, + Crit on a crit, <= Max (BattleController's SHAKE_MAX).
-- Basic hits land often: at most one per BasicGap, so a fight never becomes constant shaking; Seconds = how long a kick lasts
AttackFxCatalog.Kick = { Basic = 0.05, Element = 0.10, Special = 0.14, BandStep = 0.03, Crit = 0.04, Seconds = 0.15, BasicGap = 0.6, Max = 0.35 }
AttackFxCatalog.CountScale = { 1, 1.2, 1.4, 1.6 } -- particle counts per band: ladder / kind layers (full density)
AttackFxCatalog.DetailScale = { 0.5, 0.75, 1, 1.25 } -- the element's own impact + alive detail: every rarity, reduced at band 1

-- the core per band: Color / Inner / Rim name Palette entries ("White" = pure white)
AttackFxCatalog.CoreLook = {
	[1] = { Color = "Mid", Glow = 0 }, -- plain element colour (e.g. orange fire)
	[2] = { Color = "Mid", Inner = "Hot", Glow = 0.35 }, -- brighter, a hot inner core (e.g. blue-hot fire)
	[3] = { Color = "Core", Inner = "Hot", Glow = 0.7, Upgraded = true }, -- blazing core, upgraded shape (fins / a second blade)
	-- (Task 9 Studio, two rounds: a white core, solid or as a see-through shell, read as a white ball / sheet on the pale
	-- arena and hid the target (the Secret shot, the crescents, the spikes / roots). The white plasma is the HEART: a
	-- white-hot inner core inside a shell of the element's colour, the rim twin shifting colour. The cores with no inner
	-- heart (ground spikes / roots, the cone fan) stay in the element's colour. An element's PlasmaColor names the
	-- Palette entry its heart takes instead of white (Earth: a gold-hot heart in the rock).)
	[4] = { Color = "Mid", Inner = "White", Rim = "Edge", RimShift = true, Glow = 1, Upgraded = true, Material = "Neon" }, -- white plasma heart, colour-shifting rim
}

-- the layers each rarity adds, in rarity order (each keeps everything below it). The element's OWN impact detail
-- (Elements[e].Detail + the attack's own Layers) and its alive detail are NOT on the ladder: they show at every rarity.
AttackFxCatalog.Ladder = {
	-- (attack effects, 2026-11-01: the owner's "impact package for everyone": the ring, the flash, the sparks and the ground
	-- mark at every rarity, ImpactScale makes them stronger by band; a second, wider ring from Epic)
	{ Tier = "Common", Add = { "Charge", "Burst", "Shockwave", "Flash", "Sparks", "GroundGlow" } }, -- core shape + impact burst (+ the charge glow of beat 1) + the impact package
	{ Tier = "Uncommon", Add = { "Trail" } }, -- + element trail
	{ Tier = "Rare", Add = { "Slash" } }, -- + crescent slash arc
	{ Tier = "Epic", Add = { "Shockwave2" } }, -- + a second, wider ring
	{ Tier = "Legendary", Add = { "Afterimage", "Bloom" } }, -- + afterimages, bloom pulse (camera punch: own pet)
	{ Tier = "Mythic", Add = { "DoubleArc", "Field" } }, -- + double arcs, a ground-only lingering field
	{ Tier = "Secret", Add = { "PlasmaRim" } }, -- + the colour-shifting rim (signature layer on signature pets; screen glow: own pet)
}

-- layer templates: Texture / Kind / Key / Tint "$Name" = the element's (or attack's / kind's / signature's) slot; At "$Hit"
-- = where the attack lands (Target, or Self / Allies for those paths). Tint = a Palette entry (baked textures play white).
AttackFxCatalog.LayerSlots = {
	Charge = { Kind = "Emitter", Texture = "fx_glow", Beat = "Charge", At = "Source", Tint = "Mid", Count = 5, Size = 1.5 },
	Burst = { Kind = "Emitter", Texture = "$Burst", Beat = "Impact", At = "$Hit", Tint = "Mid", Count = 12, Size = 2.5 },
	Trail = { Kind = "Emitter", Texture = "$Trail", Beat = "Travel", At = "Core", Tint = "Mid", Count = 10, Size = 1 },
	-- (Task 9: in the pale Core tint the arc read as a big white sheet over the leap and the target at Secret; the
	-- element's colour, a little smaller and see-through)
	-- (Task 9 round 2: still additive (the sheet's LightEmission 1) the arc summed to white on the pale arena; half-lit it
	-- keeps the element's colour)
	Slash = { Kind = "Emitter", Texture = "fx_slash", Beat = "Release", At = "Source", Tint = "Mid", Count = 1, Size = 2.6, Transparency = 0.4, LightEmission = 0.35 },
	GroundGlow = { Kind = "Decal", Beat = "Impact", At = "Ground", Tint = "Edge", Size = 5, Seconds = 0.6, Linger = true }, -- an untextured glow disc
	-- (Task 8, Studio + Gemini: at 3 / 4 the flash + bloom washed the pets white and a 14-stud ring buried the target:
	-- lights <= 2 brightness / 8 studs range, the shockwave ~7 studs across and see-through)
	-- (attack effects, 2026-11-01: these now play from Common, x ImpactScale, with Size up to 2.08. Review: uncapped the rings reached
	-- 19 / 25 studs across and 2.5 studs tall, past the ring Task 8 cut: they stay a thin line (Thin), stop at 14 / 16 studs across
	-- (PeakStuds) and never pass the attack's real radius, so a Secret's evolved size shows in its core and ground marks; the light caps above are kept on
	-- screen too: AttackFx stops a light's Size at 1.4 (Flash 11.2 studs at most) and its Brightness at 2 after a crit; only a
	-- Studio check may move them)
	Shockwave = { Kind = "Ring", Key = "vfx_ring", Beat = "Impact", At = "Ground", Tint = "Mid", Grow = 1.7, Transparency = 0.35, Thin = true, PeakStuds = 14 },
	Shockwave2 = { Kind = "Ring", Key = "vfx_ring", Beat = "Impact", At = "Ground", Tint = "Core", Grow = 2.4, Delay = 0.08, Transparency = 0.5, Thin = true, PeakStuds = 16 },
	Flash = { Kind = "Light", Beat = "Impact", At = "$Hit", Tint = "Core", Brightness = 1.6, Range = 8 },
	-- (attack effects, 2026-11-01) a few hot sparks off every hit: the package's only emitter; at the cap another layer yields first (fitCap)
	Sparks = { Kind = "Emitter", Texture = "fx_sparks", Beat = "Impact", At = "$Hit", Tint = "Hot", Count = 5, Size = 0.6, SpeedScale = 1.5, LightEmission = 0.6 },
	Afterimage = { Kind = "Trail", Texture = "fx_speedlines", Beat = "Travel", At = "Core", Tint = "Edge", Afterimages = 2 },
	Bloom = { Kind = "Light", Beat = "Release", At = "Core", Tint = "Hot", Brightness = 1.4, Range = 8, Pulse = true },
	-- the second crescent, a curved Beam (Task 8 Studio: untextured it read as a flat white slab; streaked with the arc sheet)
	-- (Task 9: see-through, Gemini: >= 0.4, the Secret double slash hid the leap)
