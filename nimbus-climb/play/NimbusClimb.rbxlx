----------------------------------------------------------------------
-- Lobby (a big floating cloud village high in the sky)
----------------------------------------------------------------------
-- Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 6.1): a bigger plaza with the Gate Court (the six mode gates on
-- one arc: Home, Obby, Dungeon, Ring, Arena, Altar, left to right at GateFacing - 2.5 .. + 2.5 steps). Plaza-local
-- angles: 0 = +X, 90 = +Z.
Config.Lobby = {
	Origin = Vector3.new(0, 300, 0), -- centre of the main plaza surface
	PlazaRadius = 150, -- was 110
	GateArcRadius = 118, -- the six gates stand on this arc (replaces PortalRingRadius 88); pad centres at r 104
	GateStep = 14.5, -- degrees between gates (29.8 studs)
	GateFacing = 90, -- degrees: the arc's middle (+Z); the spawn looks this way
	SpotRingRadius = 340, -- was 300: the player home plots stand on this ring (spoke bridges stay 130 studs)
	SpotCount = 16, -- one saved spot per player; set the place's Max Players to <= this
	PlotSize = 72, -- flat square buildable area (studs) of each home plot (read by TycoonCatalog)
	ShopOffset = Vector3.new(0, 0, -196), -- shop island centre relative to Origin (was -150)
	KillY = 100, -- fall below this -> teleport back to the plaza
	ZoneRadius = 286, -- the lobby zone (Config.InLobbyZone): the plaza, the shop and garden islands and the spoke bridges, up to the ring street's inner edge
	ZoneBand = 80, -- studs above / below Origin that still count as the lobby zone
	ZoneAltarAttr = "AltarIslandAt", -- Workspace attribute (Vector3, StormAltar.Build): the Altar island sits inside ZoneRadius ...
	ZoneAltarReach = 32, -- ... so this many studs around it, and around its bridge out to the street, are not the lobby
}

-- True when a position is in the lobby proper: never a home plot, the ring street, the Arena island or a match course (they
-- lie outside ZoneRadius), nor the Altar island and its bridge (the hole around ZoneAltarAttr, read live: it replicates).
-- Safe on the server and the client; junk is false.
function Config.InLobbyZone(pos)
	if typeof(pos) ~= "Vector3" or pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then
		return false
	end
	local L = Config.Lobby
	local dx, dz = pos.X - L.Origin.X, pos.Z - L.Origin.Z
	if dx * dx + dz * dz > L.ZoneRadius * L.ZoneRadius or math.abs(pos.Y - L.Origin.Y) > L.ZoneBand then
		return false
	end
	local altar = workspace:GetAttribute(L.ZoneAltarAttr)
	if typeof(altar) == "Vector3" then
		-- the distance to the ray from the island's centre straight out from the plaza
		local ax, az = altar.X - L.Origin.X, altar.Z - L.Origin.Z
		local len = math.sqrt(ax * ax + az * az)
		if len > 0 then
			ax, az = ax / len, az / len
			local rx, rz = pos.X - altar.X, pos.Z - altar.Z
			local along = math.max(0, rx * ax + rz * az)
			local ox, oz = rx - ax * along, rz - az * along
			if ox * ox + oz * oz <= L.ZoneAltarReach * L.ZoneAltarReach then
				return false
			end
		end
	end
	return true
end

-- shop-area (spec 16.17.3): true when a position is at the Storm Altar, where the Secret roll happens: within
-- Config.Gems.SecretRoulette.AltarRange (+ slack, a number >= 0; anything else counts as 0) studs horizontally of the
-- island's site (the Workspace attribute Config.Lobby.ZoneAltarAttr, written by StormAltar.Build, replicated) and within
-- AltarBand studs of its height. No attribute, junk or a non-finite position: false (fails closed). Server (PetService's
-- rule, with AltarRangeSlack) and client (the Shop's Secret card, no slack) alike.
function Config.AtAltar(pos, slack)
	if typeof(pos) ~= "Vector3" then
		return false
	end
	local x, y, z = pos.X, pos.Y, pos.Z
	if x ~= x or y ~= y or z ~= z or math.abs(x) == math.huge or math.abs(y) == math.huge or math.abs(z) == math.huge then
		return false
	end
	local site = workspace:GetAttribute(Config.Lobby.ZoneAltarAttr)
	if typeof(site) ~= "Vector3" then
		return false
	end
	local def = type(Config.Gems) == "table" and Config.Gems.SecretRoulette or nil
	local range = type(def) == "table" and tonumber(def.AltarRange) or nil
	local band = type(def) == "table" and tonumber(def.AltarBand) or nil
	if not range or not band then
		return false
	end
	local extra = tonumber(slack) or 0
	if extra ~= extra or extra < 0 or extra == math.huge then
		extra = 0
	end
	local reach = range + extra
	local dx, dz = x - site.X, z - site.Z
	return dx * dx + dz * dz <= reach * reach and math.abs(y - site.Y) <= band
end

