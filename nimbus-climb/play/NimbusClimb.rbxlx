EVO.Look.rime_wyrmling = { Gem = { 70, 186, 255 }, GemB = { 214, 246, 255 }, Wing = { 168, 222, 250 }, Tip = { 240, 252, 255 } }
EVO.Look.hydralotl = { Gem = { 176, 255, 96 }, GemB = { 140, 255, 206 }, Wing = { 92, 56, 150 }, Tip = { 118, 255, 196 } }
