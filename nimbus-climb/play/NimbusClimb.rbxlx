function G.takeProp(stat)
	local spec = G.PROPS[stat] or G.PROPS.Speed
	local list = G.propPool[stat]
	if list and #list > 0 then
		return table.remove(list)
	end
	local prop = { Stat = stat, Parts = {}, Local = {}, Move = {} }
	for i, row in ipairs(spec) do
		local p = G.part("Train" .. row[1], row[2], row[4], row[5])
		prop.Parts[i] = p
		prop.Local[i] = row[3]
		prop.Move[i] = row[6]
	end
	return prop
end

function G.giveProp(prop)
	for _, p in ipairs(prop.Parts) do
		p.Parent = nil
	end
	local list = G.propPool[prop.Stat]
	if not list then
		list = {}
		G.propPool[prop.Stat] = list
	end
	list[#list + 1] = prop
end

function G.attachProp(entry)
	local prop = G.takeProp(entry.Stat)
	entry.Prop = prop
	prop.Mat = entry.Att.WorldCFrame
	for i, p in ipairs(prop.Parts) do
		p.CFrame = prop.Mat * prop.Local[i]
		p.Parent = ensureFolder()
	end
	G.stepProp(entry, 0)
end

-- a training pet's motion and its prop's moving parts (20 Hz, only homes within K.PET_ANIM_NEAR)
function G.stepProp(entry, t)
	local prop = entry.Prop
	if not prop then
		return
	end
	local stat = prop.Stat
	local lift, push = 0, 0
	local mat = prop.Mat
	local hi = entry.Top or 1.6
	local orbY = hi * 0.75 + 0.35
	for i, p in ipairs(prop.Parts) do
		local mv = prop.Move[i]
		if mv then
			local cf
			if mv == "Belt" or mv == "Belt2" then
				local z = (((t * 1.6) + ((mv == "Belt2") and 0.5 or 0)) % 1 - 0.5) * 2.0
				cf = mat * CFrame.new(0, 0, z) * prop.Local[i]
			elseif mv == "Lift" then
				local c = 0.5 + 0.5 * sin(t * 3)
				cf = mat * CFrame.new(0, hi + 0.35 + 0.4 * c, 0.05) * prop.Local[i]
			elseif mv == "Orb" or mv == "Shell" then
				local spin = (mv == "Orb") and t * 1.6 or -t * 0.9
				cf = mat * CFrame.new(0.95, orbY + 0.12 * sin(t * 2), -0.25) * CFrame.Angles(spin * 0.6, spin, pi / 4)
			elseif string.sub(mv, 1, 5) == "Spark" then
				local k = tonumber(string.sub(mv, 6)) or 1
				local a = t * 2.4 + k * 2.094
				cf = mat * CFrame.new(0.95 + math.cos(a) * 0.62, orbY + 0.18 * sin(a * 1.5), -0.25 + sin(a) * 0.62)
			elseif mv == "Wobble" then
				local ph = (t % 1.4) / 1.4
				local w = 0
				if ph >= 0.18 then
					w = 0.28 * math.exp(-(ph - 0.18) * 5) * math.cos((ph - 0.18) * 24)
				end
				local pivot = CFrame.new(1.3, 0.6, 0)
				cf = mat * pivot * CFrame.Angles(0, 0, -w) * pivot:Inverse() * prop.Local[i]
			end
			if cf then
				p.CFrame = cf
			end
		end
	end
	if stat == "Speed" then
		lift = 0.07 * abs(sin(t * 9))
	elseif stat == "Physique" then
		lift = -0.05 * (0.5 + 0.5 * sin(t * 3))
	elseif stat == "Ability" then
		lift = 0.08 * sin(t * 1.8)
	elseif stat == "Defense" then
		local ph = (t % 1.4) / 1.4
		if ph < 0.18 then
			push = ph / 0.18 * 0.32
		elseif ph < 0.4 then
			push = 0.32 * (1 - (ph - 0.18) / 0.22)
		end
	end
	G.pose(entry, 0, 0, lift, push)
end

function G.stepTraining(rec)
	if not rec.PetsAnimate then
		return
	end
	local tr = rec.Train
	if clock < (tr.MotionAt or 0) then
		return
	end
	tr.MotionAt = clock + K.MOTION_STEP
	for slot, entry in pairs(rec.Pet.Training.Pets) do
		if entry.Prop and entry.Model.Parent then
			G.stepProp(entry, clock + slot * 0.37)
		end
	end
end

----------------------------------------------------------------------
-- the owner's scoop ring: a faint circle of the scoop radius around the owner while they stand in their own yard
----------------------------------------------------------------------
function G.stepRing(rec)
	local show, root, plot = false, nil, nil
	if rec and rec.Near and rec.PetsNear then
		plot = R.plot(rec)
		root = G.localRoot()
		if plot and root then
			local lp = plot:PointToObjectSpace(root.Position)
			show = abs(lp.X) <= K.YARD_HALF and abs(lp.Z) <= K.YARD_HALF and lp.Y > -2 and lp.Y < 9
		end
	end
	if not show then
		if G.ringShown then
			for _, p in ipairs(G.ring) do
				p.Parent = nil
			end
			G.ringShown = false
		end
		return
	end
	if not G.ring then
		G.ring = {}
		for i = 1, K.RING_SEGMENTS do
			local p = G.part("ScoopRing", Vector3.new(1, 0.06, 0.16), COLORS.Ring, Enum.Material.Neon)
			p.Transparency = 0.55
			G.ring[i] = p
		end
	end
	local r = G.scoopRadius(rec)
	local c = root.Position
	local lp = plot:PointToObjectSpace(c)
	local y = plot:PointToWorldSpace(Vector3.new(lp.X, R.ground(lp.X, lp.Z) + 0.05, lp.Z)).Y
	local len = 2 * pi * r / K.RING_SEGMENTS * 0.8
	for i, p in ipairs(G.ring) do
		local a = (i - 0.5) / K.RING_SEGMENTS * 2 * pi
		if G.ringR ~= r then
			p.Size = Vector3.new(len, 0.06, 0.16)
		end
		p.CFrame = CFrame.new(c.X + math.cos(a) * r, y, c.Z + sin(a) * r) * CFrame.Angles(0, -a - pi / 2, 0)
		if not G.ringShown then
			p.Parent = ensureFolder()
		end
	end
	G.ringR = r
	G.ringShown = true
end

----------------------------------------------------------------------
-- the scoop: coins zip from the drops to the owner, a "+$1,234" label at the drop (never over the player's head)
----------------------------------------------------------------------
function G.zip(rec, key, point, stage)
	local root = G.localRoot()
	if not root then
		return
	end
	local n = min(K.ZIP_COINS, 2 + (stage or 1))
	for i = 1, n do
		local part = G.takeCoin(i)
		if not part then
			break
		end
		local off = Vector3.new((G.noise(i, clock) - 0.5) * 0.8, 0.3 + i * 0.05, (G.noise(clock, i) - 0.5) * 0.8)
		G.fly(rec, part, point + off, root.Position, K.ZIP_TIME + i * 0.035, 1.2, "coin", root)
	end
	G.stats.Zips = G.stats.Zips + 1
	local gd = rec.Garden
	if not gd.ZipAt or clock - gd.ZipAt > K.LABEL_PAIR or (stage or 0) > (gd.ZipStage or 0) then
		gd.ZipPoint, gd.ZipStage = point, stage or 0
	end
	gd.ZipAt = clock
end

-- a scoop is the drops that vanished near the owner + the bank (CollectorCash) dropping + the owner's Cash rising,
-- all within K.LABEL_PAIR seconds (the attributes may arrive in any order): then the label shows the drop
function G.pairLabel(rec)
	local gd = rec.Garden
	if not (gd.ZipAt and gd.DropAt and (gd.Drop or 0) >= 1) then
		return
	end
	if clock - gd.ZipAt > K.LABEL_PAIR or clock - gd.DropAt > K.LABEL_PAIR then
		return
	end
	local cashKnown = localPlayer and localPlayer:GetAttribute(CASH_ATTR) ~= nil
	if cashKnown and not (G.gainAt and clock - G.gainAt <= K.LABEL_PAIR) then
		return
	end
	local text = "+" .. formatCash(gd.Drop)
	G.showLabel(gd.ZipPoint, text, "cash")
	G.stats.Labels = G.stats.Labels + 1
	G.stats.LastLabel, G.stats.LastLabelAt = text, gd.ZipPoint
	gd.DropAt, gd.Drop, gd.ZipAt, gd.ZipPoint, gd.ZipStage = nil, nil, nil, nil, nil
	G.gainAt = nil
end

function G.onCash(rec)
	local gd = rec.Garden
	local v = tonumber(slotText(rec, "CollectorCash")) or 0
	if gd.Cash ~= nil and v < gd.Cash then
		gd.Drop = gd.Cash - v
		gd.DropAt = clock
		G.pairLabel(rec)
	end
	gd.Cash = v
end

function G.onLocalCash()
	local v = localPlayer and tonumber(localPlayer:GetAttribute(CASH_ATTR))
	if v and G.lastCash and v > G.lastCash then
		G.gainAt = clock
		local rec = G.ownRec()
		if rec then
			G.pairLabel(rec)
		end
	end
	G.lastCash = v
end

function G.newLabel()
	local anchor = G.part("ScoopLabel", Vector3.new(0.2, 0.2, 0.2), COLORS.Gold)
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "ScoopPop"
	gui.LightInfluence = 0
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Size = UDim2.fromOffset(240, 44)
	gui.Parent = anchor
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.TextStrokeTransparency = 0
	text.TextStrokeColor3 = Color3.fromRGB(46, 30, 12)
	text.Parent = gui
	if Theme then
		-- over the world with no plate: ONE outline (kit-b U6: no classic stroke under it)
		Theme.SetRole(text, "Display")
		text.TextStrokeTransparency = 1
		Theme.TextOutline(text, 2, Color3.fromRGB(46, 30, 12), 0)
	end
	return { Anchor = anchor, Gui = gui, Text = text }
end

-- a pixel-sized label floating up from a drop: "+$1,234" (gold, 30 px at 1080p) or the visitor hint (20 px)
function G.showLabel(point, text, style)
	if not point then
		return
	end
	local lab = table.remove(G.labelPool)
	if not lab and #G.labels >= K.MAX_LABELS then
		lab = table.remove(G.labels, 1)
	end
	lab = lab or G.newLabel()
	local hint = style == "hint"
	local px = hint and 20 or 30
	local size = px
	if Theme and type(Theme.ScaledSize) == "function" then
		local ok, s = pcall(Theme.ScaledSize, px)
		if ok and type(s) == "number" then
			size = s
		end
	end
	lab.Text.Text = text
	lab.Text.TextSize = size
	lab.Text.TextColor3 = hint and Color3.fromRGB(255, 255, 255) or COLORS.Gold
	lab.Text.TextTransparency = 0
	lab.Gui.Size = UDim2.fromOffset(hint and floor(size * 0.56 * #text + 24) or floor(size * 0.62 * #text + 28), floor(size * 1.5))
	lab.Gui.Name = hint and "OwnerHint" or "ScoopPop"
	lab.From = point + Vector3.new(0, hint and 1.6 or 1.0, 0)
	lab.T = 0
	lab.Dur = hint and K.HINT_TIME or K.LABEL_TIME
	lab.Rise = hint and 0.3 or 1.6
	lab.Anchor.CFrame = CFrame.new(lab.From)
	lab.Anchor.Parent = ensureFolder()
	G.labels[#G.labels + 1] = lab
end

function G.stepLabels(dt)
	local i = 1
	while i <= #G.labels do
		local lab = G.labels[i]
		lab.T = lab.T + dt
		local q = lab.T / lab.Dur
		if q >= 1 then
			lab.Anchor.Parent = nil
			table.remove(G.labels, i)
			G.labelPool[#G.labelPool + 1] = lab
		else
			lab.Anchor.CFrame = CFrame.new(lab.From + Vector3.new(0, lab.Rise * q, 0))
			if q > 0.65 then
				lab.Text.TextTransparency = (q - 0.65) / 0.35
			end
			i = i + 1
		end
	end
end

-- the one-time visitor hint at another player's Cloud Cash
function G.checkHint(rec, focus)
	if G.hinted or not focus or not rec.PetsNear or not G.dimmed(rec) then
		return
	end
	local function check(point)
		local d = point - focus
		if Vector3.new(d.X, 0, d.Z).Magnitude <= K.HINT_NEAR and abs(d.Y) < 8 then
			G.hinted = true
			G.stats.Hint = "Only the owner can pick these up"
			G.showLabel(point, G.stats.Hint, "hint")
			return true
		end
		return false
	end
	for _, c in pairs(rec.Roam.Coins) do
		if check(c.Point) then
			return
		end
	end
	local h = rec.Garden.Heaps.W
	if h then
		check(h.Point)
	end
end

----------------------------------------------------------------------
-- pet cards (client/UI/PetCard): own garden pets level + XP (+ EVOLVE!), own training pets + the timer, other
-- players' garden pets level only; only pets within K.CARD_NEAR studs of the local player carry one
----------------------------------------------------------------------
function G.lazy(field, path)
	if G[field] == nil then
		G[field] = false
		local node = script.Parent
		for _, name in ipairs(path) do
			if name == ".." then
				node = node and node.Parent
			else
				node = node and node:FindFirstChild(name)
			end
		end
		if node then
			local ok, mod = pcall(require, node)
			if ok and type(mod) == "table" then
				G[field] = mod
			end
		end
	end
	return G[field] or nil
end

function G.openPets(key)
	local MC = G.lazy("Menu", { "MenuController" })
	if MC and type(MC.Open) == "function" then
		pcall(MC.Open, "Pets", { Tab = "Pets", Key = key, Action = "Evolve" })
	end
end

function G.cardInfo(rec, kind, slot, entry)
	local own = localUid ~= 0 and homeOwner(rec) == localUid
	local key = entry.Key
	local level, stage = 1, 0
	local info = (kind == "Garden") and rec.Garden.Info[slot] or nil
	if info then
		level, stage = info.Level, info.Stage
	end
	if not own then
		if not info then
			return nil
		end
		return "Other", level, stage
	end
	local S = G.lazy("State", { "..", "State" })
	local xp = nil
	if S and type(S.Get) == "function" then
		local okG, data = pcall(S.Get)
		if okG and type(data) == "table" and type(data.PetLevels) == "table" and data.PetLevels[key] then
			local okL, l, x = pcall(S.PetLevel, key)
			if okL then
				level, xp = tonumber(l) or level, tonumber(x) or 0
			end
		end
		local okE, growth = pcall(S.PetGrowth, key)
		if okE and type(growth) == "table" and tonumber(growth.Evo) and growth.Evo > stage then
			stage = growth.Evo
		end
	end
	local def = petDefOf(key)
	local frac = 0
	local cap = nil
	if def and PetCatalog and type(PetCatalog.LevelCap) == "function" then
		local ok, c = pcall(PetCatalog.LevelCap, def)
		cap = ok and tonumber(c) or nil
	end
	local need = nil
	if TycoonCatalog and type(TycoonCatalog.XpToNext) == "function" then
		local ok, n = pcall(TycoonCatalog.XpToNext, level)
		need = ok and tonumber(n) or nil
	end
	if cap and level >= cap then
		frac = 1
	elseif xp and need and need > 0 then
		frac = clamp01(xp / need)
	end
	local ready = false
	if def and PetCatalog and type(PetCatalog.CanEvolve) == "function" then
		local ok, nxt = pcall(PetCatalog.CanEvolve, def, level, stage)
		ready = ok and nxt ~= nil
	end
	if kind == "Training" then
		local job = rec.Train.Jobs[slot]
		local left = job and max(0, (job.Ends or 0) - serverNow()) or 0
		local rank = 1
		if S and type(S.PetGrowth) == "function" then
			local ok, growth = pcall(S.PetGrowth, key)
			if ok and type(growth) == "table" and type(growth.Job) == "table" then
				rank = tonumber(growth.Job.Rank) or 1
			end
		end
		local total = 60 * max(1, rank)
		if TycoonCatalog and type(TycoonCatalog.TrainSeconds) == "function" then
			local ok, s = pcall(TycoonCatalog.TrainSeconds, rank)
			if ok and tonumber(s) and s > 0 then
				total = s
			end
		end
		total = max(total, left)
		local whole = floor(left + 0.999)
		local text = string.format("%d:%02d", floor(whole / 60), whole % 60)
		return "Training", level, stage, frac, ready, clamp01(1 - left / max(1, total)), text
	end
	return "Garden", level, stage, frac, ready
end

function G.updateCard(rec, kind, slot, entry)
	local PC = G.lazy("PetCard", { "..", "UI", "PetCard" })
	if not PC or type(PC.New) ~= "function" then
		return false
	end
	local mode, level, stage, xp, ready, tfrac, ttext = G.cardInfo(rec, kind, slot, entry)
	if not mode then
		return false
	end
	local adornee = entry.Model.PrimaryPart or entry.Model:FindFirstChildWhichIsA("BasePart")
	if not adornee then
		return false
	end
	local card = entry.Card
	if card and card.mode ~= mode then
		pcall(card.SetMode, card, mode)
	end
	if not card then
		local key = entry.Key
		local ok, c = pcall(PC.New, adornee, mode, (entry.Hi or 1.6) * 0.6 + 0.9, {
			Name = "HomePetCard",
			OnEvolve = function()
				G.openPets(key)
			end,
		})
		if not ok or type(c) ~= "table" then
			return false
		end
		card = c
		entry.Card = c
	end
	pcall(card.SetLevel, card, level, stage, ready)
	if xp then
		pcall(card.SetXp, card, xp)
	end
	if tfrac then
		pcall(card.SetTimer, card, tfrac, ttext)
	end
	return true
end

function G.stepCards()
	if clock < G.nextCards then
		return
	end
	G.nextCards = clock + K.CARD_CHECK
	local focus = focusPos()
	local count = 0
	for _, rec in ipairs(homeList) do
		for kind, pk in pairs(rec.Pet) do
			for slot, entry in pairs(pk.Pets) do
				local want = false
				if focus and rec.PetsNear and entry.Model.Parent then
					local d = (entry.Seat.Position - focus).Magnitude
					want = d <= (entry.Card and (K.CARD_NEAR + 6) or K.CARD_NEAR)
				end
				if want and not G.updateCard(rec, kind, slot, entry) then
					want = false
				end
				if not want and entry.Card then
					pcall(entry.Card.Destroy, entry.Card)
					entry.Card = nil
				end
				if entry.Card then
					count = count + 1
				end
			end
		end
		G.checkHint(rec, focus)
	end
	G.cardCount = count
end

-- one home's garden / training state (attributes changed)
function G.onInfo(rec)
	rec.Garden.Info = G.parseInfo(slotText(rec, "GardenInfo"))
	rec.Pet.Garden.Dirty = true
	R.nextBudget = 0
	G.nextCards = 0
end

function G.onOpen(rec)
	local open = G.openCount(rec)
	if open ~= rec.Garden.Open then
		rec.Garden.Open = open
		rec.Pet.Garden.Dirty = true
	end
end

-- everything client-made of one home goes away (frozen, far, removed)
function G.clearHome(rec)
	G.recycle(rec)
	local gd = rec.Garden
	local h = gd.Heaps.W
	if h then
		gd.Heaps.W = nil
		G.giveHeap(h.Look, h.Model)
	end
	R.clearCoins(rec)
	gd.HeapsDirty = true
end

function G.stepHome(rec, dt)
	if rec.PetsNear then
		R.stepPets(rec, dt)
		R.stepCoins(rec, dt)
		R.stepBerries(rec)
	end
	G.stepTraining(rec)
	if rec.Garden.HeapsDirty then
		G.syncHeaps(rec)
	end
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function stepSwirl(sw, dt)
	if sw.Popping then
		if sw.Popping.Done then
			sw.Popping = nil
		else
			return
		end
	end
	sw.Angle = (sw.Angle + dt * K.SWIRL_SPEED) % (2 * pi)
	local c = sw.Center
	local rot = CFrame.new(c.X, c.Y + sin(sw.Angle * 1.5) * K.SWIRL_BOB, c.Z) * CFrame.Angles(0, sw.Angle, 0)
	for i, p in ipairs(sw.Parts) do
		if p.Parent then
			p.CFrame = rot * sw.Local[i]
		end
	end
	sw.Wave = sw.Wave + dt * K.GLOW_RATE
	local swing = (0.5 + 0.5 * sin(sw.Wave)) * K.GLOW_SWING
	for i, p in ipairs(sw.Glows) do
		if p.Parent then
			p.Transparency = min(0.95, sw.GlowBase[i] + swing)
		end
	end
end

-- the Berry Farm's propeller weathervane (bug #20 B, HomeBuilder Art.Farm "Propeller"; its mesh is the element key
-- home_farm_propeller, dressed onto the Part): it turns slowly about its own axis (the Part's local Z, toward the
-- lane) with a gentle swell. The Part and its ML_Mesh (when dressed) move together; a pop-in finishes first.
function G.findVane(st)
	local p = st.Model:FindFirstChild("Propeller", true)
	if p and p:IsA("BasePart") then
		st.Vane = { Part = p, Base = p.CFrame, Angle = 0, Clock = 0 }
	end
end

-- a Propeller that replicates after its Station_ model (ChildAdded ran findVane before it was there) still gets its
-- weathervane record; true when it registered one
function G.lateVane(rec, d)
	local farm = rec.Farm
	if d.Name ~= "Propeller" or not farm or farm.Vane or not d:IsA("BasePart") or not d:IsDescendantOf(farm.Model)
		or d:FindFirstAncestor("ML_Mesh") then
		return false
	end
	G.findVane(farm)
	return farm.Vane ~= nil
end

-- (bug "doesnt show my pet in the training while hes training") a Training Place mat attachment (Spot<i>) that
-- replicates after its Station_Gym model (a join while a pet trains: the station's ChildAdded ran syncPets before the
-- Deck's attachments were there, found no seat and never looked again): the training pets are synced once more;
-- true when it marked them
function G.lateMat(rec, d)
	local st = rec.Pet.Training.Station
	if not st or not d:IsA("Attachment") or not string.match(d.Name, "^Spot%d+$") or not d:IsDescendantOf(st.Model) then
		return false
	end
	rec.Pet.Training.Dirty = true
	return true
end

function G.stepVane(st, dt)
	local v = st.Vane
	if st.Popping then
		if st.Popping.Done then
			st.Popping = nil
		else
			return
		end
	end
	if not v.Part.Parent then
		st.Vane = nil
		return
	end
	v.Clock = v.Clock + dt
	v.Angle = (v.Angle + dt * K.VANE_SPEED * (1 + K.VANE_GUST * sin(v.Clock * 0.45))) % (2 * pi)
	local cf = v.Base * CFrame.Angles(0, 0, v.Angle)
	v.Part.CFrame = cf
	local mesh = v.Part:FindFirstChild("ML_Mesh")
	if mesh then
		mesh:PivotTo(cf)
	end
end

-- the station kind (HomeBuilder writes Kind; older builds only the id)
local STATION_KINDS = { Press1 = "Farm", Kitchen = "FoodMachine", Gym = "Training", Garden = "Garden", FusionMachine = "Fusion" }

local function registerStation(rec, model)
	if rec.Stations[model] then
		return rec.Stations[model]
	end
	local id = tostring(model:GetAttribute("StationId") or string.sub(model.Name, 9))
	local kind = model:GetAttribute("Kind")
	if kind == nil or kind == "Gym" then
		kind = STATION_KINDS[id] or kind
	end
	local st = { Model = model, Id = id, Kind = kind, Level = numAttr(model, "Level", 1) }
	rec.Stations[model] = st
	if kind == "Farm" then
		rec.Farm = st
		G.findVane(st)
	elseif kind == "FoodMachine" then
		rec.Machine = st
		R.basket(rec)
	elseif PET_STATIONS[kind] then
		local pk = rec.Pet[kind]
		pk.Station = st
		pk.Dirty = true
		if kind == "Garden" then
			rec.Garden.HeapsDirty = true
			rec.Roam.CoinsDirty = true
			G.onOpen(rec)
		end
	elseif kind == "Fusion" then
		local swirl = model:FindFirstChild("Swirl")
		local center = vecAttr(model, "SwirlCenter")
		if swirl and center then
			local parts = collectParts(swirl)
			local loc = {}
			local base = CFrame.new(center)
			for i, p in ipairs(parts) do
				loc[i] = base:Inverse() * p.CFrame
			end
			st.Parts, st.Local, st.Center, st.Angle, st.Wave = parts, loc, center, 0, 0
			st.Glows, st.GlowBase = {}, {}
			for _, p in ipairs(collectParts(model)) do
				if p.Name == "Glow" and p.Material == Enum.Material.Neon then
					st.Glows[#st.Glows + 1] = p
					st.GlowBase[#st.GlowBase + 1] = p.Transparency
				end
			end
			rec.Swirls[#rec.Swirls + 1] = st
		end
	end
	return st
end

local function removeFrom(list, item)
	for i = #list, 1, -1 do
		if list[i] == item then
			table.remove(list, i)
		end
	end
end

local function unregisterStation(rec, model)
	local st = rec.Stations[model]
	if not st then
		return
	end
	rec.Stations[model] = nil
	removeFrom(rec.Swirls, st)
	if rec.Farm == st then
		rec.Farm = nil
	end
	if rec.Machine == st then
		rec.Machine = nil
	end
	for kind, pk in pairs(rec.Pet) do
		if pk.Station == st then
			pk.Station = nil
			pk.Dirty = true
			if kind == "Garden" then
				rec.Garden.HeapsDirty = true
				rec.Roam.CoinsDirty = true
			end
		end
	end
end

----------------------------------------------------------------------
-- Homes
----------------------------------------------------------------------
local function isNew(rec, inst)
	local built = tonumber(inst:GetAttribute("BuiltAt"))
	if built then
		return serverNow() - built < K.POP_WINDOW
	end
	return clock - rec.Found > K.POP_LIVE_AFTER
end

local function onDescendant(rec, d)
	if d:GetAttribute("ML_DressKey") ~= nil then
		rec.LodDirty = true -- a newly tagged station / bed piece: the plot LOD list is rebuilt at the next check
	end
	G.lateVane(rec, d)
	G.lateMat(rec, d)
	if d:IsA("ProximityPrompt") then
		if d.Name ~= "ClaimPrompt" then
			trackPrompt(d, rec)
		end
	elseif d:IsA("BillboardGui") and d.Name == "PadSign" then
		signs[d] = rec
		applySign(d)
		local pad = ancestorWith(d.Parent, "StationId", rec.Folder)
		local entry = pad and rec.Pads[pad]
		if entry then
			entry.PriceLabel = nil
			refreshPad(rec, entry)
		end
	end
end

-- (audio wave 2) a new station / buy pad of MY home pops in: SoundFx "StationBuild"; my house reaching a new tier
-- (Station_House at Level 2+, the server's "<tier> built!") plays "HouseTier" instead. Others' homes are silent
local soundFxMod = nil
local function buildSound(rec, child)
	if not localPlayer or homeOwner(rec) ~= localPlayer.UserId then
		return
	end
	if soundFxMod == nil then
		local module = script.Parent.Parent:FindFirstChild("SoundFx")
		local ok, mod = false, nil
		if module then
			ok, mod = pcall(require, module)
		end
		soundFxMod = (ok and type(mod) == "table" and type(mod.Play) == "function") and mod or false
	end
	if not soundFxMod then
		return
	end
	local house = child.Name == "Station_House" and (tonumber(child:GetAttribute("Level")) or 1) >= 2
	pcall(soundFxMod.Play, house and "HouseTier" or "StationBuild")
end
G.buildSound = buildSound

local function onHomeChild(rec, child, live)
	local name = child.Name
	if string.sub(name, 1, 8) == "Station_" and child:IsA("Model") then
		local st = registerStation(rec, child)
		if live and isNew(rec, child) then
			st.Popping = startPop(child, rec)
			buildSound(rec, child)
		end
	elseif name == "Pads" then
		rec.PadFolder = child
		for _, pad in ipairs(child:GetChildren()) do
			if pad:IsA("Model") then
				registerPad(rec, pad)
			end
		end
		rec.Conns[#rec.Conns + 1] = child.ChildAdded:Connect(function(pad)
			if pad:IsA("Model") then
				registerPad(rec, pad)
				if isNew(rec, pad) and rec.Pads[pad] then
					rec.Pads[pad].Popping = startPop(pad, rec)
					buildSound(rec, pad)
				end
			end
		end)
		rec.Conns[#rec.Conns + 1] = child.ChildRemoved:Connect(function(pad)
			rec.Pads[pad] = nil
		end)
	end
end

local function plotCenter(folder)
	local cf = folder:GetAttribute("PlotCFrame")
	if typeof(cf) == "CFrame" then
		return cf.Position
	end
	local v = folder:GetAttribute("PlotCenter")
	if typeof(v) == "Vector3" then
		return v
	end
	return nil
end

-- the plot attributes HomeFx follows (on the plot folder, also read on the Home folder): what each one changes
local HOME_ATTRS = {
	GardenPets = function(rec)
		rec.Pet.Garden.Dirty = true
		R.nextBudget = 0
	end,
	TrainingPets = function(rec)
		rec.Pet.Training.Dirty = true
		G.nextCards = 0
	end,
	GardenInfo = function(rec)
		G.onInfo(rec)
	end,
	GardenSlots = function(rec)
		G.onOpen(rec)
	end,
	CoinDrops = function(rec)
		R.onDrops(rec)
	end,
	Roam = function(rec)
		R.onRoam(rec)
	end,
	RoamSeed = function(rec)
		R.onRoam(rec)
	end,
	RoamVersion = function(rec)
		R.onRoam(rec)
	end,
	BerryCap = function(rec)
		R.basket(rec)
	end,
	CollectorCash = function(rec)
		G.onCash(rec)
	end,
}

local function addHome(folder)
	if homes[folder] or not folder:IsA("Folder") and not folder:IsA("Model") then
		return
	end
	local rec = {
		Folder = folder,
		Found = clock,
		Center = plotCenter(folder),
		Near = false,
		NextNear = 0,
		Stations = {},
		Swirls = {},
		Farm = nil, -- the Berry Farm (Station_Press1, Kind "Farm"): BerryPoint, its berry flights
		Machine = nil, -- the Food Machine (Station_Kitchen): BasketTop, the basket line
		Pads = {},
		Conns = {},
		SignMemo = {}, -- [StationId] = the layout's last answer for that pad's sign (a rebuilt sign starts with it)
		Pet = { -- by station Kind: { Station = record | nil, Pets = { [slot] = entry }, Dirty }
			Garden = { Station = nil, Pets = {}, Dirty = false },
			Training = { Station = nil, Pets = {}, Dirty = false },
		},
		-- GardenInfo parsed, the Welcome heap, the scoop pairing (see "Garden")
		Garden = { Info = {}, Heaps = {}, Open = 3, HeapsDirty = true },
		-- the roam (RoamSeed / RoamVersion / Roam), CoinDrops parsed, the Cloud Cash coins (see "Roaming")
		Roam = { Seed = nil, Ok = false, Epochs = {}, Naps = {}, Wake = {}, Drops = {}, W = nil, Coins = {}, Allow = {}, CoinsDirty = true },
		Train = { Jobs = {} },
		PetsNear = false,
		PetsAnimate = false,
	}
	homes[folder] = rec
	homeList[#homeList + 1] = rec
	rec.Index = #homeList
	R.onRoam(rec)
	rec.Roam.Drops, rec.Roam.W = R.parseDrops(slotText(rec, "CoinDrops"))
	rec.Garden.Info = G.parseInfo(slotText(rec, "GardenInfo"))
	rec.Garden.Cash = tonumber(slotText(rec, "CollectorCash"))
	for _, child in ipairs(folder:GetChildren()) do
		onHomeChild(rec, child, false)
	end
	for _, d in ipairs(folder:GetDescendants()) do
		onDescendant(rec, d)
	end
	G.onOpen(rec)
	rec.Conns[#rec.Conns + 1] = folder.ChildAdded:Connect(function(child)
		onHomeChild(rec, child, true)
	end)
	rec.Conns[#rec.Conns + 1] = folder.ChildRemoved:Connect(function(child)
		if rec.Stations[child] then
			cancelPopOf(child)
			unregisterStation(rec, child)
		end
	end)
	rec.Conns[#rec.Conns + 1] = folder.DescendantAdded:Connect(function(d)
		onDescendant(rec, d)
	end)
	rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		refreshHome(rec)
		for _, pad in pairs(rec.Pads) do
			refreshPad(rec, pad)
		end
		refreshOwnership()
		-- the owner changed: the coins' look (dimmed or not), the evolved forms, the basket line and the cards follow
		rec.Garden.HeapsDirty = true
		rec.Roam.CoinsDirty = true
		rec.Signed = nil
		rec.Pet.Garden.Dirty = true
		R.nextBudget = 0
		R.basket(rec)
		G.nextCards = 0
	end)
	rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal("PlotCFrame"):Connect(function()
		rec.Center = plotCenter(folder)
	end)
	-- the plot folder's (TycoonService / PetCareService) attributes; the gate (a sibling of the Home folder): its
	-- Claim Home prompt
	local spot = folder.Parent
	for attr, fn in pairs(HOME_ATTRS) do
		local function changed()
			local ok, err = pcall(fn, rec)
			if not ok and not frameWarned then
				frameWarned = true
				warn("[HomeFx] " .. attr .. ": " .. tostring(err))
			end
		end
		rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal(attr):Connect(changed)
		if spot then
			rec.Conns[#rec.Conns + 1] = spot:GetAttributeChangedSignal(attr):Connect(changed)
		end
	end
	if spot then
		for _, d in ipairs(spot:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "ClaimPrompt" then
				trackPrompt(d, rec)
			end
		end
		rec.Conns[#rec.Conns + 1] = spot.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") and d.Name == "ClaimPrompt" then
				trackPrompt(d, rec)
			end
		end)
	end
	refreshOwnership()
	refreshHome(rec)
end

local function resetHome(rec)
	clearPets(rec)
	G.clearHome(rec)
end

local function removeHome(folder)
	local rec = homes[folder]
	if not rec then
		return
	end
	homes[folder] = nil
	removeFrom(homeList, rec)
	for _, c in ipairs(rec.Conns) do
		c:Disconnect()
	end
	rec.Conns = {}
	for model in pairs(rec.Stations) do
		cancelPopOf(model)
	end
	resetHome(rec)
	for prompt, state in pairs(overrides) do
		if state.Home == rec then
			overrides[prompt] = nil
		end
	end
	for gui, r in pairs(signs) do
		if r == rec then
			signs[gui] = nil
		end
	end
	refreshOwnership()
end

----------------------------------------------------------------------
-- Phase 6 plot LOD (perf-plots W3; ARCHITECTURE_V3 6.5 "busiest phone view <= 300k tris"). A home plot's dressed
-- Blender meshes (HomeBuilder's station / bed-piece Tag targets + the lobby's `Plot` base next to the Home folder) take a
-- level by the plot's tier, from the camera distance to the plot centre (updateNear, every K.NEAR_CHECK, never per
-- frame; hysteresis K.LOD_HYST):
--   High (< K.LOD_HIGH)  everything on its High key (today's look)
--   Low                  every mesh on "<key>_low" (MeshLibrary.LowKey: when that key is uploaded and baked from the
--                        same layout, else the High key stays); a neighbour's plot seen from your own yard
--   Far (>= K.LOD_FAR)   only the landmarks (house, plot base) on their _low keys; every station and the decor (fence,
--                        fountain, podium, Garden bed pieces) hidden with their kept glow Parts: every plot seen from
--                        the lobby plaza is Far (the nearest is ~175 studs from a camera on the plaza edge)
-- MeshLibrary.SetLod does the work and touches nothing a client did not dress, so empty MeshIds (today's game) and Part
-- fallbacks are untouched; without a template folder (MeshLibrary.Active() false) this costs one call per check.
----------------------------------------------------------------------
G.LOD_CLASS = { -- ML_DressKey prefix -> class (first match; anything else on a plot is a "station")
	{ "prop_plot", "landmark" }, { "home_house_", "landmark" },
	{ "home_fence_", "decor" }, { "home_fountain_", "decor" }, { "home_podium_", "decor" }, { "home_bed_", "decor" },
}
G.LOD_LEVEL = { -- tier -> class -> MeshLibrary.SetLod level
	High = { landmark = "High", station = "High", decor = "High" },
	Low = { landmark = "Low", station = "Low", decor = "Low" },
	Far = { landmark = "Low", station = "Hide", decor = "Hide" },
}
G.lodStats = { Applied = 0, Scans = 0 }

function G.meshLib()
	if G.ML == nil then
		G.ML = optionalShared("MeshLibrary") or false
		if G.ML and type(G.ML.SetLod) ~= "function" then
			G.ML = false
		end
	end
	return G.ML or nil
end

function G.lodClass(key)
	for _, rule in ipairs(G.LOD_CLASS) do
		if string.sub(key, 1, #rule[1]) == rule[1] then
			return rule[2]
		end
	end
	return "station"
end

-- tier with hysteresis: a plot leaves High only beyond LOD_HIGH + LOD_HYST and leaves Far only inside LOD_FAR - LOD_HYST
function G.lodTier(prev, dist)
	local high = (prev == "High") and (K.LOD_HIGH + K.LOD_HYST) or K.LOD_HIGH
	local far = (prev == "Far") and (K.LOD_FAR - K.LOD_HYST) or K.LOD_FAR
	if dist < high then
		return "High"
	elseif dist < far then
		return "Low"
	end
	return "Far"
end

-- the plot's LOD targets: the lobby's dressed plot base (Spot_NN.Plot) + every tagged target inside the Home folder
function G.scanLod(rec)
	G.lodStats.Scans = G.lodStats.Scans + 1
	local list = {}
	local function add(inst)
		local key = inst:GetAttribute("ML_DressKey")
		if type(key) == "string" then
			list[#list + 1] = { Inst = inst, Class = G.lodClass(key), Done = false }
		end
	end
	local spot = rec.Folder.Parent
	local base = spot and spot:FindFirstChild("Plot")
	if base then
		add(base)
	end
	for _, d in ipairs(rec.Folder:GetDescendants()) do
		add(d)
	end
	rec.LodTargets = list
	rec.LodDirty = false
	rec.LodPending = #list
end

function G.applyLod(rec, all)
	local ML = G.meshLib()
	local levels = G.LOD_LEVEL[rec.Lod]
	local pending = 0
	for _, t in ipairs(rec.LodTargets) do
		if (all or not t.Done) and t.Inst.Parent then
			t.Done = ML.SetLod(t.Inst, levels[t.Class]) == true
			G.lodStats.Applied = G.lodStats.Applied + 1
			if not t.Done then
				pending = pending + 1
			end
		end
	end
	rec.LodPending = pending
	rec.LodRetryAt = clock + K.LOD_RETRY
end

function G.stepLod(rec, dist)
	local ML = G.meshLib()
	if not ML or not ML.Active() then
		return -- empty MeshIds: no template folder, nothing is ever dressed (today's game)
	end
	local fresh = rec.LodDirty or rec.LodTargets == nil
	if fresh then
		G.scanLod(rec)
	end
	local tier = G.lodTier(rec.Lod, dist)
	local changed = tier ~= rec.Lod
	rec.Lod = tier
	if changed or fresh then
		G.applyLod(rec, true)
	elseif rec.LodPending > 0 and clock >= (rec.LodRetryAt or 0) then
		G.applyLod(rec, false) -- targets whose mesh arrived since (Dress waits for the key on this device)
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function updateNear(rec, eye)
	if clock < rec.NextNear then
		return
	end
	rec.NextNear = clock + K.NEAR_CHECK
	if not rec.Center then
		rec.Center = plotCenter(rec.Folder)
		if not rec.Center then
			for model in pairs(rec.Stations) do
				local ok, pivot = pcall(function()
					return model:GetPivot()
				end)
				if ok and pivot then
					rec.Center = pivot.Position
					break
				end
			end
		end
	end
	local dist = (rec.Center ~= nil and eye ~= nil) and (rec.Center - eye).Magnitude or 0
	rec.Dist = dist
	if rec.Center ~= nil and eye ~= nil then
		G.stepLod(rec, dist)
	end
	local near = rec.Center ~= nil and dist <= K.NEAR
	local petsNear = near and dist <= (rec.PetsNear and (K.PET_NEAR + 20) or K.PET_NEAR)
	rec.PetsAnimate = petsNear and dist <= K.PET_ANIM_NEAR
	if petsNear ~= rec.PetsNear then
		rec.PetsNear = petsNear
		for _, pk in pairs(rec.Pet) do
			pk.Dirty = true
		end
		rec.Garden.HeapsDirty = true
		rec.Roam.CoinsDirty = true
		R.nextBudget = 0
		if not petsNear then
			G.recycle(rec)
			R.clearCoins(rec)
		end
	end
	if near ~= rec.Near then
		rec.Near = near
		if not near then
			resetHome(rec)
		end
	end
end

-- Phase 6 (runtime-pets): when MeshLibrary makes a pet's Blender mesh keys usable here (PetBuilder.MeshVersion
-- changes), its Part-built home pets (stations, garden roamers, the pool) are dropped and rebuilt as mesh pets; one
-- number compare per frame otherwise
function G.meshSweep()
	local ver = PetBuilder.MeshVersion()
	if ver == G.meshVer then
		return
	end
	G.meshVer = ver
	for i = #petPool, 1, -1 do
		local e = petPool[i]
		if PetBuilder.NeedsMeshRebuild(e.Model) then
			table.remove(petPool, i)
			petLows[e.Key] = nil
			pcall(e.Model.Destroy, e.Model)
		end
	end
	for _, rec in ipairs(homeList) do
		for _, pk in pairs(rec.Pet) do
			for slot, entry in pairs(pk.Pets) do
				if entry.Model and PetBuilder.NeedsMeshRebuild(entry.Model) then
					pk.Pets[slot] = nil
					G.releaseEntry(entry)
					petLows[entry.LowKey] = nil
					pcall(entry.Model.Destroy, entry.Model)
					pk.Dirty = true
				end
			end
		end
	end
end

local function step(dt)
	dt = min(tonumber(dt) or 0, 0.1)
	clock = clock + dt
	petFrameBuilds, petFramePlaced = 0, 0
	if PetBuilder and PetBuilder.MeshVersion then
		G.meshSweep()
	end
	R.frame = R.frame + 1
	if #pops > 0 then
		stepPops()
	end
	local eye = cameraPos()
	stepSigns()
	R.budget()
	for _, rec in ipairs(homeList) do
		if rec.Folder.Parent then
			updateNear(rec, eye)
			if rec.Near then
				if rec.Lod ~= "Far" then -- a Far plot's Fusion station is hidden (plot LOD): its swirl rests
					for _, sw in ipairs(rec.Swirls) do
						stepSwirl(sw, dt)
					end
					if rec.Farm and rec.Farm.Vane then -- the farm's propeller weathervane (rests with the hidden station)
						G.stepVane(rec.Farm, dt)
					end
				end
				stepPads(rec, dt)
				stepPetStations(rec)
				G.stepHome(rec, dt)
			elseif anyPetsDirty(rec) then
				syncAllPets(rec)
				G.syncHeaps(rec)
				R.syncCoins(rec)
			end
		end
	end
	if #G.flying > 0 then
		G.stepFlying(dt)
	end
	if #G.labels > 0 then
		G.stepLabels(dt)
	end
	if #R.puffs > 0 then
		R.stepPuffs(dt)
	end
	G.stepRing(G.ownRec())
	G.stepCards()
end

local function safeStep(dt)
	local ok, err = pcall(step, dt)
	if not ok and not frameWarned then
		frameWarned = true
		warn("[HomeFx] frame error: " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function HomeFx.Count()
	return #homeList
end

function HomeFx.Stats()
	local stations, near, hidden, hiddenSigns, pets, trainPets = 0, 0, 0, 0, 0, 0
	local heaps, heapParts, props, sleeping, coins, pending = 0, 0, 0, 0, 0, 0
	local unsigned = 0
	for _, rec in ipairs(homeList) do
		for _, entry in pairs(rec.Pet.Garden.Pets) do
			pets = pets + 1
			if entry.Sleep then
				sleeping = sleeping + 1
			end
		end
		for _, entry in pairs(rec.Pet.Training.Pets) do
			trainPets = trainPets + 1
			if entry.Prop then
				props = props + 1
			end
		end
		for _ in pairs(rec.Stations) do
			stations = stations + 1
		end
		for _, h in pairs(rec.Garden.Heaps) do
			heaps = heaps + 1
			heapParts = heapParts + #h.Model:GetChildren()
		end
		for _, c in pairs(rec.Roam.Coins) do
			coins = coins + 1
			if c.Pending then
				pending = pending + 1
			end
		end
		if rec.Near then
			near = near + 1
		end
	end
	for prompt, state in pairs(overrides) do
		if state.Hidden and prompt.Parent then
			hidden = hidden + 1
		end
	end
	local shownSigns, crowded, underHud, away = 0, 0, 0, 0
	for gui in pairs(signs) do
		if gui.Parent then
			if not gui.Enabled then
				hiddenSigns = hiddenSigns + 1
			end
			local why = signState[gui]
			if why == "Shown" then
				shownSigns = shownSigns + 1
			elseif why == "Crowded" then
				crowded = crowded + 1
				if signUnderHud[gui] then
					underHud = underHud + 1
				end
			elseif why == "Away" then
				away = away + 1
			elseif why == "Unsigned" then
				unsigned = unsigned + 1
			end
		end
	end
	return {
		Homes = #homeList,
		Near = near,
		Stations = stations,
		Pops = #pops,
		HiddenPrompts = hidden,
		HiddenSigns = hiddenSigns,
		SignsShown = shownSigns,
		SignsCrowded = crowded,
		SignsUnderHud = underHud,
		SignsAway = away,
		SignsUnsigned = unsigned,
		GardenPets = pets,
		TrainingPets = trainPets,
		GymPets = trainPets, -- the Phase 3 name of TrainingPets
		Sleeping = sleeping,
		Props = props,
		Heaps = heaps, -- the Welcome-back heaps
		HeapParts = heapParts,
		HeapsMade = G.heapsMade,
		Coins = coins, -- Cloud Cash coins drawn now (<= K.MAX_CASH)...
		CoinParts = R.cashParts, -- ...6 parts each (TokenLook "Cash", no light) + the glow ball of an own coin
		CashMade = R.cashMade, -- coin parts ever built (pooled per look)
		Pending = pending, -- coins popped by a pet, waiting for CoinDrops
		Poops = R.stats.Poops,
		Confirmed = R.stats.Confirmed,
		Faded = R.stats.Faded,
		Flying = G.coinsAlive, -- zip coins flying now (pool cap K.MAX_COINS)
		Bits = R.bitsAlive, -- berries in flight + puff cubes now (<= K.MAX_BITS)
		BitsMade = R.bitsMade,
		BerryFlights = R.stats.Berries,
		Puffs = R.stats.Puffs,
		Posed = R.stats.Posed, -- garden pets the budget lets pose (<= K.ROAM_MAX_PETS)
		PetParts = R.stats.PetParts, -- their parts (evolved while <= K.HOME_PET_PARTS)
		Zips = G.stats.Zips,
		Labels = G.stats.Labels,
		LastLabel = G.stats.LastLabel,
		LastLabelAt = G.stats.LastLabelAt,
		Hint = G.stats.Hint,
		Ring = G.ringShown,
		Cards = G.cardCount,
		PetBuilds = petStats.Builds,
		PetColdBuilds = petStats.Cold,
		PetPoolHits = petStats.PoolHits,
		PetPool = #petPool,
		PetFrameMost = petStats.FrameMost,
	}
end

-- one home's client garden (tests / debugging): the Welcome heap, the Cloud Cash coins, the roaming pets and their
-- states, the training pets + props
function HomeFx.Garden(folder)
	local rec = typeof(folder) == "Instance" and (homes[folder] or homes[folder:FindFirstChild("Home") or folder]) or nil
	if not rec then
		return nil
	end
	local ro = rec.Roam
	local out = { Heaps = {}, Coins = {}, Pets = {}, Training = {}, Open = rec.Garden.Open, Dim = G.dimmed(rec), Radius = G.scoopRadius(rec),
		RoamOk = ro.Ok, Seed = ro.Seed, Epochs = ro.Epochs, Naps = ro.Naps }
	for slot, h in pairs(rec.Garden.Heaps) do
		out.Heaps[slot] = { Model = h.Model, Point = h.Point, Stage = h.Stage, Dim = h.Dim, Parts = #h.Model:GetChildren() }
	end
	for key, c in pairs(ro.Coins) do
		out.Coins[key] = { Part = c.Part, Slot = c.Slot, Cycle = c.Cycle, Stage = c.Stage, Lucky = c.Lucky, Pending = c.Pending,
			Dim = c.Dim, Point = c.Point, Look = c.Look, Parts = #c.Pieces, Flying = c.Arc ~= nil }
	end
	for slot, e in pairs(rec.Pet.Garden.Pets) do
		out.Pets[slot] = { Key = e.Key, Model = e.Model, Sleep = e.Sleep == true, Zzz = e.Zzz and e.Zzz.Parts or nil, Card = e.Card,
			Stage = e.Stage, Seat = e.Seat, State = e.State, X = e.RX, Z = e.RZ, SepX = e.SepX or 0, SepZ = e.SepZ or 0,
			Cycle = e.Cycle, Hw = e.Hw, Yaw = e.Yaw }
	end
	for slot, e in pairs(rec.Pet.Training.Pets) do
		out.Training[slot] = { Key = e.Key, Model = e.Model, Stat = e.Stat, Prop = e.Prop and e.Prop.Parts or nil, Card = e.Card, Seat = e.Seat, Stage = e.Stage }
	end
	return out
end

-- why a pad sign shows or not: "Shown"; hidden: "Crowded" (no room on the screen: another sign or the HUD is there;
-- Stats().SignsUnderHud counts the HUD ones), "Away" (behind the camera, off the screen or past its MaxDistance),
-- "Pending" (not laid out yet), "Locked" (a locked pad far away), "Other" (not the local player's pad); nil for
-- anything HomeFx does not track
function HomeFx.SignState(gui)
	if typeof(gui) ~= "Instance" or not signs[gui] then
		return nil
	end
	return signState[gui]
end

function HomeFx.Init()
	if initialized then
		return
	end
	initialized = true
	localPlayer = localPlayer or Players.LocalPlayer
	localUid = localPlayer and localPlayer.UserId or 0
	CollectionService:GetInstanceAddedSignal(HOME_TAG):Connect(function(folder)
		local ok, err = pcall(addHome, folder)
		if not ok then
			warn("[HomeFx] could not track a home: " .. tostring(err))
		end
	end)
	CollectionService:GetInstanceRemovedSignal(HOME_TAG):Connect(removeHome)
	for _, folder in ipairs(CollectionService:GetTagged(HOME_TAG)) do
		local ok, err = pcall(addHome, folder)
		if not ok then
			warn("[HomeFx] could not track a home: " .. tostring(err))
		end
	end
	if localPlayer then
		G.lastCash = tonumber(localPlayer:GetAttribute(CASH_ATTR))
		localPlayer:GetAttributeChangedSignal(CASH_ATTR):Connect(function()
			for _, rec in ipairs(homeList) do
				if homeOwner(rec) == localUid then
					for _, pad in pairs(rec.Pads) do
						refreshPad(rec, pad)
					end
					rec.Signed = nil
				end
			end
			nextSignCheck = min(nextSignCheck, clock) -- the signed pads follow the Cash at once
			G.onLocalCash()
		end)
		-- the Berry Basket line on the own Food Machine follows the Berries attribute
		localPlayer:GetAttributeChangedSignal(BERRY_ATTR):Connect(function()
			local rec = G.ownRec()
			if rec then
				R.basket(rec)
			end
		end)
	end
	-- own pets' levels / XP / evolutions: the cards (and an evolved garden pet's form) follow State
	task.spawn(function()
		local S = G.lazy("State", { "..", "State" })
		if S and S.Changed and type(S.Changed.Connect) == "function" then
			S.Changed:Connect(function()
				G.nextCards = 0
				local rec = G.ownRec()
				if rec then
					rec.Pet.Garden.Dirty = true
					rec.Pet.Training.Dirty = true
				end
				R.nextBudget = 0 -- an evolution changes the posed-pet part budget
			end)
		end
	end)
	loopConn = RunService.RenderStepped:Connect(safeStep)
end

HomeFx._StartPop = startPop -- TESTS ONLY (tools/smoke_p6_mesh.lua: a dressed station never pops)
HomeFx._Vane = { Find = G.findVane, Late = G.lateVane, Step = G.stepVane, K = K } -- TESTS ONLY (tools/smoke_bug20_farm.lua: the farm's weathervane)

-- plot LOD (tests / debugging; tools/smoke_p6_lod.lua): the tier of one home ("High" | "Low" | "Far" | nil before the
-- first check or with empty MeshIds), its targets and the counters; the constants for tools/mesh_budget.py parity
function HomeFx.Lod(folder)
	local rec = typeof(folder) == "Instance" and (homes[folder] or homes[folder:FindFirstChild("Home") or folder]) or nil
	if not rec then
		return nil
	end
	local targets = {}
	for _, t in ipairs(rec.LodTargets or {}) do
		targets[#targets + 1] = { Inst = t.Inst, Class = t.Class, Done = t.Done }
	end
	return { Tier = rec.Lod, Dist = rec.Dist, Targets = targets, Pending = rec.LodPending or 0, Applied = G.lodStats.Applied,
		Scans = G.lodStats.Scans }
end
-- TESTS ONLY (tools/smoke_p6_lod.lua): run the plot LOD on a private MeshLibrary copy (nil = the shared one again);
-- every home re-scans and re-applies at its next check
function HomeFx._SetMeshLib(ml)
	G.ML = ml
	for _, rec in ipairs(homeList) do
		rec.LodTargets, rec.Lod, rec.LodDirty, rec.NextNear = nil, nil, true, 0
	end
end
HomeFx._LodK = { High = K.LOD_HIGH, Far = K.LOD_FAR, Hyst = K.LOD_HYST, Check = K.NEAR_CHECK, Tier = G.lodTier, Class = G.lodClass, Level = G.LOD_LEVEL }

return HomeFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1141">
            <Properties>
              <string name="Name">HomePortalFx</string>
              <string name="Source"><![CDATA[-- HomePortalFx (client, Phase 4): the home portal and the arrival ring (ARCHITECTURE_V3.md "Phase 4 build contract"
-- 3.10 / 6). Zero server parts: TycoonService only writes two player attributes, this client draws them.
--
--   HomePortalFx.Init()
--   HomePortalFx.Stop()            disconnects everything and removes every part it made
--   HomePortalFx.Stats() -> { Portals, Parts, Shown, Faded, Closing, Rings, RingParts, Opened, Arrivals }
--   HomePortalFx.Portal(player) -> { Model, Center, Yaw, ClosesAt, Faded, Closing, Name, Scale, Gui, Mesh } | nil   (tests / debugging)
--
-- * Config.Attr.HomePortal on a player = "x,y,z,yaw,closesAt" while their portal is open (x, y, z: the point on the
--   floor; yaw in degrees, CFrame.Angles(0, rad(yaw), 0).LookVector = the owner's facing when they opened it;
--   closesAt: workspace:GetServerTimeNow() when it closes, 10 s after opening). Every player's portal is drawn while it
--   is within K.DRAW_RANGE studs of the camera, facing back toward the owner: a small homestead gate (the Blender mesh
--   gate_homeportal via MeshLibrary.Assemble, or its Part copy while the key is not usable here: coursed stone pillars,
--   an oak arch, a keystone plate in the player's colour) around a vortex in the player's colour: the Gate Court gates'
--   own vortex (client/PortalVortex: 6 broad + 9 fine Beam spiral arms turning inward at two speeds, light streaks
--   pulled to the centre, rim crackles; the textured layers once shared/TextureIds has them) in front of a deep Neon
--   backdrop filling the 4 x 7 stud opening, a lighter well and a bright core (<= 40 parts in all), sparkles, and a 22 px name tag
--   "Alex's portal" (pixel-sized BillboardGui: a stone card with a lip in the portal's colour, World text rule). Other players'
--   portals are faded (only the owner and their pets can go through). It grows in when it opens and shrinks away when
--   the attribute is cleared (used) or closesAt passes (expired).
-- * Config.Attr.PortalArrived = server time of the last arrival: the arrival ring (<= 20 parts: a flat ring that
--   widens and fades around the player's feet + rising sparks) plays for 1.5 s where that player stands now.
-- * The followers' dive into the portal is PetController's (it reads HomePortal itself).
-- * (audio wave 2) SoundFx "PortalEnter" when MY portal swirls open and when I use a lobby Travel gate
--   (GateService's AltarGatePrompt / PlazaGatePrompt), "PortalArrive" on MY arrival ring. Others' portals are silent.
-- Cheap: one RenderStepped connection, per-frame writes only for portals near the camera (the swirl, grow / shrink)
-- and live arrival rings; parts are pooled per portal and never collide, query or touch. Plain Lua 5.1 syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local FxSprites = require(Shared:WaitForChild("FxSprites")) -- the game's own particle sprites (kit B X1)
local okTheme, Theme = pcall(function()
	return require(Shared:WaitForChild("Theme"))
end)
if not okTheme or type(Theme) ~= "table" then
	Theme = nil
end
-- (kit-b world signs) the name tag is the kit's stone card (shared/WorldTag; the rounded ink plate went)
local okTag, WorldTag = pcall(function()
	return require(Shared:WaitForChild("WorldTag"))
end)
if not okTag or type(WorldTag) ~= "table" then
	WorldTag = nil
end

local HomePortalFx = {}

local ATTR = Config.Attr or {}
local PORTAL_ATTR = ATTR.HomePortal or "HomePortal"
local ARRIVED_ATTR = ATTR.PortalArrived or "PortalArrived"

local K = {
	DRAW_RANGE = 150, -- studs from the camera: portals farther away are not drawn
	-- the homestead gate (blender gate_homeportal; bug 2026-10-24, pitch A + the player's note): the local frame's origin
	-- is the vortex centre, CENTER_Y above the floor point; the walk-through opening is x -2..2, y 0.5..7.5 above the
	-- floor (round top: centre 5.5 up, radius 2), the stone pillars 2 studs deep (the recess the vortex sits in)
	CENTER_Y = 4.0,
	MESH_KEY = "gate_homeportal",
	TOP = 9.125, -- the gate's top above the floor (the keystone's bronze cap; the name tag floats over it)
	OPEN_HALF = 2.0, -- half the opening's width
	ARCH_Y = 5.5, -- the arch centre above the floor (= the springing line on the caps)
	-- the vortex (fix round, review: one vortex family with the Gate Court gates): client/PortalVortex at the vortex
	-- centre, a little wider than the opening so its rim tucks behind the pillars and the arch (the swirl reads as seen
	-- THROUGH the doorway), turning faster than a 23-stud gate's (same rim speed on a smaller disc)
	VORTEX_R = 2.4,
	VORTEX_Z = -0.1, -- the vortex plane (local Z; the front is -Z): mid-recess, the pillars run -1..1
	VORTEX_SPEED = 1.6, -- x PortalVortex's speeds (arms 26, fine 48 deg/s): ~42 and ~77 deg/s (Gemini: slower reads heavier, less fan)
	CORE = 0.6, -- the bright core ball (Gemini: smaller, more of the deep well shows round it)
	CORE_Z = 0.25, -- just behind the vortex plane: the arms' faded inner ends run over it
	BACK_Z = 0.82, -- the deep backdrop (inside the pillars' back face at +1)
	BREATH_PERIOD = 3.6,
	OPEN_TIME = 0.35, -- grow in
	CLOSE_TIME = 0.4, -- shrink away
	FADED = 0.55, -- extra transparency of other players' portals
	ARRIVAL_TIME = 1.5,
	ARRIVAL_BLOCKS = 14,
	ARRIVAL_SPARKS = 6,
	MAX_ARRIVALS = 4,
	NAME_PX = 22, -- the name tag at 1080p
	-- (kit-b world signs) its stone card at 1080p (WorldTag.Sizes: the wood edge, the lip) and px each side of the name
	TAG_EDGE = 3,
	TAG_LIP = 5,
	TAG_PAD = 14,
}
HomePortalFx.K = K

-- the players' portal colours (by UserId): bright, never the gold of the coins
local PALETTE = {
	Color3.fromRGB(120, 196, 255),
	Color3.fromRGB(186, 128, 255),
	Color3.fromRGB(255, 136, 196),
	Color3.fromRGB(110, 226, 170),
	Color3.fromRGB(255, 170, 92),
	Color3.fromRGB(96, 214, 236),
}
local GOLD = Color3.fromRGB(255, 214, 92)
-- the name tag's stone card when shared/WorldTag cannot load (Theme.Sign's Stone / Text / Wood, copied)
local TAG_STONE = Color3.fromRGB(255, 247, 230)
local TAG_INK = Color3.fromRGB(59, 36, 18)

local localPlayer = Players.LocalPlayer
local portals = {} -- [player] = record
local arrivals = {} -- live arrival rings
local conns = {} -- global connections
local playerConns = {} -- [player] = { connections }
local folder = nil
local loopConn = nil
local initialized = false
local warned = false
local stats = { Opened = 0, Arrivals = 0 }
local clock = 0

local P = {} -- helpers (one table keeps the locals few)

function P.serverNow()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

function P.ensureFolder()
	if folder and folder.Parent then
		return folder
	end
	local f = Workspace:FindFirstChild("HomePortalFx")
	if not f then
		f = Instance.new("Folder")
		f.Name = "HomePortalFx"
		f.Parent = Workspace
	end
	folder = f
	return f
end

function P.part(name, size, color, material, transparency)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.Transparency = transparency or 0
	return p
end

function P.lighten(c, t)
	return Color3.new(c.R + (1 - c.R) * t, c.G + (1 - c.G) * t, c.B + (1 - c.B) * t)
end

function P.darken(c, t)
	return Color3.new(c.R * (1 - t), c.G * (1 - t), c.B * (1 - t))
end

function P.colorOf(player)
	local uid = tonumber(player and player.UserId) or 0
	return PALETTE[(math.abs(math.floor(uid)) % #PALETTE) + 1]
end

-- "x,y,z,yaw,closesAt" -> point (Vector3), yaw (degrees), closesAt; nil for junk
function P.parse(text)
	if type(text) ~= "string" then
		return nil
	end
	local vals = {}
	for item in string.gmatch(text, "[^,]+") do
		local n = tonumber(item)
		if n == nil or n ~= n or n == math.huge or n == -math.huge then
			return nil
		end
		vals[#vals + 1] = n
	end
	if #vals < 5 then
		return nil
	end
	return Vector3.new(vals[1], vals[2], vals[3]), vals[4], vals[5]
end

function P.cameraPos()
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

----------------------------------------------------------------------
-- The portal model: a homestead gate around a Neon vortex, local layout around the vortex centre (faces -Z)
--   Frame   the gate: the Blender mesh gate_homeportal (MeshLibrary.Assemble, when the key is usable here) or, until
--           then, a Part copy of the same silhouette (threshold, plinths, pillars, caps, a 7-block oak arch, the
--           keystone and its plate in the portal colour): <= 16 parts
--   Surface the deep backdrop filling the opening (a block + a disc for the round top) and the lighter well round the centre
--   Core    the bright eye at the back of the funnel (carries the sparkles and the name tag)
--   Vortex  client/PortalVortex.Build with a fixed layout (3 invisible client parts carrying the Beams / emitters, or
--           the textured SurfaceGui plane); SetLook grows / shrinks / dims it with the gate, Animate turns it
-- <= 40 parts in all.
----------------------------------------------------------------------
local STONE = Color3.fromRGB(226, 221, 209)
local SLAB = Color3.fromRGB(206, 200, 188)
local OAK = Color3.fromRGB(165, 125, 85)
local OAK_DARK = Color3.fromRGB(125, 85, 55)
local BRASS = Color3.fromRGB(196, 160, 86)
local NAVY = Color3.fromRGB(34, 42, 76)

function P.meshLib()
	if P.ML ~= nil then
		return P.ML or nil
	end
	local ok, ml = pcall(function()
		return require(Shared:FindFirstChild("MeshLibrary"))
	end)
	P.ML = (ok and type(ml) == "table") and ml or false
	return P.ML or nil
end

-- a client module next to Controllers (PortalVortex, GraphicsQuality), required once; nil when missing
function P.clientModule(name)
	P.Mods = P.Mods or {}
	if P.Mods[name] == nil then
		P.Mods[name] = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild(name)
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				P.Mods[name] = mod
			end
		end
	end
	return P.Mods[name] or nil
end

-- (audio wave 2) a SoundFx one-shot (missing id = silent)
function P.sfx(name)
	local SF = P.clientModule("SoundFx")
	if SF and type(SF.Play) == "function" then
		pcall(SF.Play, name)
	end
end

-- the lobby Travel gates' prompts (server/Services/GateService PROMPTS): using one starts the portal swirl sound
P.GATE_PROMPTS = { AltarGatePrompt = true, PlazaGatePrompt = true }

-- the vortex texture ids (shared/TextureIds, filled by the upload session; empty = PortalVortex's effects-only fallback)
function P.textureIds()
	if P.Ids == nil then
		local ok, ids = pcall(function()
			return require(Shared:FindFirstChild("TextureIds"))
		end)
		P.Ids = (ok and type(ids) == "table") and ids or {}
	end
	return P.Ids
end

-- Low graphics: the vortex holds still (as the gates' do)
function P.lowQuality()
	local GQ = P.clientModule("GraphicsQuality")
	if GQ and type(GQ.Effective) == "function" then
		local ok, mode = pcall(GQ.Effective)
		return ok and mode == "Low"
	end
	return false
end

-- the gate as the Blender mesh: true when it was used (every part an item of kind "Frame"), false = build the Parts
function P.meshFrame(rec, model, add)
	local ml = P.meshLib()
	if not ml or type(ml.Active) ~= "function" or not ml.Active() or not ml.IsReady(K.MESH_KEY) then
		return false
	end
	local ok, mesh = pcall(ml.Assemble, { Name = "HomePortalMesh", Root = false, Parts = { { Key = K.MESH_KEY } } },
		{ Primary = rec.Color }, { At = CFrame.new(0, -K.CENTER_Y, 0) })
	if not ok or not mesh then
		return false
	end
	for _, d in ipairs(mesh:GetChildren()) do
		if d:IsA("BasePart") then
			d.CastShadow = false
			d.Parent = model
			add(d, d.CFrame, d.Size, d.Transparency, "Frame")
		end
	end
	mesh:Destroy()
	return true
end

-- the Part copy of the gate (same silhouette, plain colours) while the mesh is not usable here
function P.partFrame(rec, add, part)
	local g = -K.CENTER_Y -- the floor in local Y
	local h = K.OPEN_HALF
	part(Vector3.new(7.5, 0.5, 3), CFrame.new(0, g + 0.25, 0), SLAB) -- threshold
	for s = -1, 1, 2 do
		part(Vector3.new(2, 0.75, 2.5), CFrame.new(s * (h + 0.75), g + 0.875, 0), SLAB) -- plinth
		part(Vector3.new(1.5, 3.75, 2), CFrame.new(s * (h + 0.75), g + 3.125, 0), STONE) -- pillar
		part(Vector3.new(2.25, 0.5, 2.5), CFrame.new(s * (h + 0.875), g + 5.25, 0), SLAB) -- impost cap
	end
	local arch = CFrame.new(0, g + K.ARCH_Y, 0)
	local n = 7
	for i = 1, n do
		if i ~= 4 then
			local a = (i - 0.5) / n * math.pi
			part(Vector3.new(1, math.pi * 2.5 / n * 1.06, 1.5), arch * CFrame.Angles(0, 0, a) * CFrame.new(2.5, 0, 0), OAK)
		end
	end
	part(Vector3.new(1.75, 1.75, 2), CFrame.new(0, g + 8.125, 0), OAK_DARK) -- keystone (polish 2026-10-27: 1.75 wide)
	part(Vector3.new(1.375, 1.5, 0.125), CFrame.new(0, g + 8.125, -1.06), rec.Color:Lerp(NAVY, 0.65)) -- its plate (the mesh Enamel recipe)
	part(Vector3.new(2, 0.125, 2), CFrame.new(0, g + 9.0625, 0), BRASS:Lerp(OAK_DARK, 0.6)) -- the bronze cap
end

function P.build(rec)
	local color = rec.Color
	local model = Instance.new("Model")
	model.Name = "HomePortal"
	local items = {} -- { Part, Local (CFrame), Size (Vector3), Trans, Kind, Arm, Block }
	local function add(p, cf, size, trans, kind)
		local it = { Part = p, Local = cf, Size = size, Trans = trans or 0, Kind = kind }
		items[#items + 1] = it
		return it
	end
	local function make(name, size, cf, c, material, trans, kind)
		local p = P.part(name, size, c, material, trans)
		p.Parent = model
		return add(p, cf, size, trans, kind)
	end
	rec.Mesh = P.meshFrame(rec, model, add)
	if not rec.Mesh then
		P.partFrame(rec, add, function(size, cf, c)
			make("Frame", size, cf, c, Enum.Material.SmoothPlastic, 0, "Frame")
		end)
	end
	-- the deep backdrop (a block up to the springing line + a disc for the round top), just inside the back face
	local deep = P.darken(color:Lerp(NAVY, 0.25), 0.55) -- a deep, rich well (Gemini review: not candy blue)
	local h = K.OPEN_HALF - 0.05
	local yMid = (0.5 + K.ARCH_Y) / 2 - K.CENTER_Y
	make("Surface", Vector3.new(h * 2, K.ARCH_Y - 0.5, 0.1), CFrame.new(0, yMid, K.BACK_Z), deep, Enum.Material.Neon, 0, "Surface")
	local disc = make("Surface", Vector3.new(0.1, h * 2, h * 2), CFrame.new(0, K.ARCH_Y - K.CENTER_Y, K.BACK_Z + 0.02) * CFrame.Angles(0, math.pi / 2, 0),
		deep, Enum.Material.Neon, 0, "Surface")
	disc.Part.Shape = Enum.PartType.Cylinder
	-- the well: a lighter disc round the centre, a step in front of the backdrop (the funnel's throat)
	local well = make("Surface", Vector3.new(0.1, 2.8, 2.8), CFrame.new(0, 0, K.BACK_Z - 0.06) * CFrame.Angles(0, math.pi / 2, 0),
		P.darken(color, 0.3), Enum.Material.Neon, 0, "Surface")
	well.Part.Shape = Enum.PartType.Cylinder
	-- the bright core at the back of the funnel
	local core = make("Core", Vector3.new(K.CORE, K.CORE, K.CORE), CFrame.new(0, 0, K.CORE_Z), P.lighten(color, 0.85), Enum.Material.Neon, 0, "Core")
	core.Part.Shape = Enum.PartType.Ball
	-- the vortex: the Gate Court gates' own (PortalVortex), at the vortex centre in front of the backdrop
	local V = P.clientModule("PortalVortex")
	if V and type(V.Build) == "function" and type(V.SetLook) == "function" then
		local seed = math.abs(math.floor(tonumber(rec.Player and rec.Player.UserId) or 0)) % 100000 + 11
		local ok, v = pcall(V.Build, { Fixed = { Center = rec.Frame * CFrame.new(0, 0, K.VORTEX_Z), Radius = K.VORTEX_R, Speed = K.VORTEX_SPEED } },
			model, P.textureIds(), color, seed)
		if ok and v then
			V.SetStatic(v, P.lowQuality())
			V.SetLook(v, 0.02, 0)
			V.Show(v, true)
			rec.Vortex = v
		elseif not warned then
			warned = true
			warn("[HomePortalFx] vortex: " .. tostring(v))
		end
	end
	local center = core.Part
	model.PrimaryPart = center
	-- sparkles drift out of the core
	local att = Instance.new("Attachment")
	att.Name = "Sparkles"
	att.Parent = center
	local ok = pcall(function()
		local em = Instance.new("ParticleEmitter")
		em.Name = "Sparkles"
		FxSprites.Apply(em, "Sparkle")
		em.Color = ColorSequence.new(P.lighten(color, 0.6), GOLD)
		em.Rate = 6
		em.Lifetime = NumberRange.new(0.8, 1.4)
		em.Speed = NumberRange.new(0.6, 1.4)
		em.SpreadAngle = Vector2.new(180, 180)
		em.LightInfluence = 0
		em.Parent = att
	end)
	if not ok then
		att:Destroy()
	end
	-- the name tag (pixel-sized, World text rule), over the gate's top. (kit-b world signs; NpcService's nameplate is the
	-- model) a stone card: the Stone face, a mitred wood edge (WorldTag's SignEdge, drawn outside the face, inside the gui),
	-- a lip in the portal's colour (WorldTag.LipOf), the name in the kit's brown ink with no outline (kit-b U6: it sits on the
	-- opaque face); the card sized from the measured name. The rounded see-through ink plate went.
	local gui = Instance.new("BillboardGui")
	gui.Name = "PortalName"
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.ClipsDescendants = false
	gui.StudsOffset = Vector3.new(0, K.TOP + 1.2 - K.CENTER_Y, 0)
	gui.Parent = center
	local px = K.NAME_PX
	if Theme and type(Theme.ScaledSize) == "function" then
		local okS, s = pcall(Theme.ScaledSize, K.NAME_PX)
		if okS and type(s) == "number" then
			px = s
		end
	end
	local f = px / K.NAME_PX -- the screen factor the text got: the card's edge, lip and padding follow it
	local edge = math.max(2, math.floor(K.TAG_EDGE * f + 0.5))
	local lip = math.max(3, math.floor(K.TAG_LIP * f + 0.5))
	local text = tostring(rec.Name) .. "'s portal"
	local tw = nil
	if Theme and type(Theme.Measure) == "function" then
		local okM, v = pcall(Theme.Measure, text, "Title", px)
		if okM and typeof(v) == "Vector2" and v.X > 0 then
			tw = v.X
		end
	end
	tw = tw or px * 0.62 * #text
	local w = math.ceil(tw + 2 * math.floor(K.TAG_PAD * f + 0.5))
	local h = math.floor(px * 1.6) + lip
	gui.Size = UDim2.fromOffset(w + 2 * edge, h + 2 * edge)
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.Position = UDim2.fromOffset(edge, edge)
	plate.Size = UDim2.fromOffset(w, h)
	plate.BackgroundColor3 = TAG_STONE
	plate.BackgroundTransparency = 0
	plate.BorderSizePixel = 0
	plate.Parent = gui
	if WorldTag and Theme and type(Theme.Sign) == "table" then
		WorldTag.Block(plate, Theme.Sign.Stone, WorldTag.LipOf(color), Theme.Sign.Wood, edge, lip)
	end
	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 1, -lip)
	label.Text = text
	label.TextSize = px
	label.TextColor3 = TAG_INK
	label.TextStrokeTransparency = 1
	label.TextWrapped = false
	label.TextScaled = false
	label.Parent = plate
	if Theme then
		Theme.SetRole(label, "Title") -- (kit-b U6) capitals, no outline and no classic stroke
		label.TextStrokeTransparency = 1
		if type(Theme.Sign) == "table" then
			label.TextColor3 = Theme.Sign.Text
		end
	end
	rec.Model, rec.Items, rec.Gui, rec.Label = model, items, gui, label
	rec.PlacedScale, rec.PlacedFade = nil, nil
	model.Parent = P.ensureFolder()
end

-- writes the parts for the current scale / fade (only portals near the camera, never for far ones): the gate, the
-- backdrop and the core only when the scale or fade changed (or the record is Dirty: just built); the vortex every
-- frame (PortalVortex writes only quantised changes: its two spinners' turn, plus its size / dimming while it grows,
-- shrinks or fades)
function P.place(rec)
	local s = math.max(0.02, rec.Scale)
	local frame = rec.Frame
	local fade = rec.Faded and K.FADED or 0
	local closing = rec.Closing and (1 - s) or 0
	local still = not rec.Dirty and rec.PlacedScale == s and rec.PlacedFade == fade + closing
	rec.PlacedScale, rec.PlacedFade, rec.Dirty = s, fade + closing, nil
	if not still then
		for _, it in ipairs(rec.Items) do
			local loc = it.Local
			it.Part.CFrame = frame * (CFrame.new(loc.Position * s) * (loc - loc.Position))
			it.Part.Size = it.Size * s
			local t = it.Trans + (1 - it.Trans) * fade
			t = t + (1 - t) * closing
			if it.Part.Transparency ~= t then
				it.Part.Transparency = t
			end
		end
	end
	local V = rec.Vortex and P.clientModule("PortalVortex")
	if V then
		V.SetLook(rec.Vortex, s, fade + (1 - fade) * closing)
		local breath = 0.5 + 0.5 * math.sin(rec.Time / K.BREATH_PERIOD * 2 * math.pi)
		V.Animate(rec.Vortex, rec.Time, s, breath, rec.Vortex.Static)
	end
	if rec.Gui then
		local show = s > 0.6 and not rec.Closing
		if rec.Gui.Enabled ~= show then
			rec.Gui.Enabled = show
		end
	end
end
function P.destroy(rec)
	local V = rec.Vortex and P.clientModule("PortalVortex")
	if V then
		V.Destroy(rec.Vortex)
	end
	if rec.Model then
		rec.Model:Destroy()
	end
	rec.Model, rec.Items, rec.Gui, rec.Label, rec.Vortex = nil, nil, nil, nil, nil
end

-- the HomePortal attribute of a player changed: open / move / close their portal (a moved portal is rebuilt at the
-- new place on the next frame: the vortex's centre is fixed when it is built)
function P.refresh(player)
	local text = player:GetAttribute(PORTAL_ATTR)
	local point, yaw, closesAt = P.parse(text)
	local rec = portals[player]
	if not point then
		if rec and not rec.Closing then
			rec.Closing = true
			rec.CloseT = 0
		end
		return
	end
	if rec and rec.Closing then
		P.destroy(rec)
		rec = nil
	end
	local frame = CFrame.new(point + Vector3.new(0, K.CENTER_Y, 0)) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(0, math.pi, 0)
	if rec and rec.Point and (rec.Point - point).Magnitude < 0.05 and math.abs((rec.Yaw or 0) - yaw) < 0.5 then
		rec.ClosesAt = closesAt
		return
	end
	if not rec then
		rec = { Player = player, Scale = 0, Time = 0, Opening = true }
		portals[player] = rec
		stats.Opened = stats.Opened + 1
		if player == localPlayer then
			P.sfx("PortalEnter")
		end
	elseif rec.Model then
		P.destroy(rec) -- moved: rebuilt where it now stands (P.step), at its current scale
	end
	rec.Point, rec.Yaw, rec.ClosesAt, rec.Frame = point, yaw, closesAt, frame
	rec.Name = (player.DisplayName ~= nil and player.DisplayName ~= "") and player.DisplayName or player.Name
	rec.Color = P.colorOf(player)
	rec.Faded = player ~= localPlayer
	rec.Center = frame.Position
	rec.Dirty = true
end

-- the arrival ring where the player stands now
function P.arrive(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local eye = P.cameraPos()
	-- (the local player's own arrival always plays: the camera catches up with the teleport a frame later)
	if player ~= localPlayer and eye and (root.Position - eye).Magnitude > K.DRAW_RANGE then
		return
	end
	if player == localPlayer then
		P.sfx("PortalArrive")
	end
	while #arrivals >= K.MAX_ARRIVALS do
		P.endArrival(table.remove(arrivals, 1))
	end
	local color = P.colorOf(player)
	local ring = { T = 0, Parts = {}, Base = root.Position - Vector3.new(0, 2.8, 0) }
	for i = 1, K.ARRIVAL_BLOCKS do
		local c = (i % 2 == 0) and P.lighten(color, 0.4) or color
		local p = P.part("ArrivalRing", Vector3.new(0.6, 0.18, 0.3), c, Enum.Material.Neon, 0.1)
		p.Parent = P.ensureFolder()
		ring.Parts[#ring.Parts + 1] = p
	end
	for i = 1, K.ARRIVAL_SPARKS do
		local p = P.part("ArrivalSpark", Vector3.new(0.22, 0.22, 0.22), (i % 2 == 0) and GOLD or P.lighten(color, 0.6), Enum.Material.Neon, 0)
		p.Parent = P.ensureFolder()
		ring.Parts[#ring.Parts + 1] = p
	end
	arrivals[#arrivals + 1] = ring
	stats.Arrivals = stats.Arrivals + 1
	P.stepArrival(ring, 0)
end

function P.endArrival(ring)
	for _, p in ipairs(ring.Parts) do
		p:Destroy()
	end
	ring.Parts = {}
end

-- the ring widens from 1 to 4.5 studs and fades; the sparks rise and spin out
function P.stepArrival(ring, dt)
	ring.T = ring.T + dt
	local q = math.min(1, ring.T / K.ARRIVAL_TIME)
	local ease = 1 - (1 - q) * (1 - q)
	local radius = 1 + 3.5 * ease
	local trans = 0.1 + 0.9 * q
	for i, p in ipairs(ring.Parts) do
		if i <= K.ARRIVAL_BLOCKS then
			local a = (i - 0.5) / K.ARRIVAL_BLOCKS * 2 * math.pi
			local len = 2 * math.pi * radius / K.ARRIVAL_BLOCKS * 0.85
			p.Size = Vector3.new(len, 0.18, 0.3)
			p.CFrame = CFrame.new(ring.Base + Vector3.new(math.cos(a) * radius, 0.15, math.sin(a) * radius)) * CFrame.Angles(0, -a - math.pi / 2, 0)
		else
			local k = i - K.ARRIVAL_BLOCKS
			local a = k / K.ARRIVAL_SPARKS * 2 * math.pi + q * 4
			local r = 0.8 + 1.4 * ease
			p.CFrame = CFrame.new(ring.Base + Vector3.new(math.cos(a) * r, 0.4 + 3.2 * ease, math.sin(a) * r)) * CFrame.Angles(q * 6, q * 4, 0)
		end
		p.Transparency = trans
	end
	return q >= 1
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
function P.step(dt)
	dt = math.min(tonumber(dt) or 0, 0.1)
	clock = clock + dt
	local eye = P.cameraPos()
	local now = P.serverNow()
	for player, rec in pairs(portals) do
		if not rec.Closing and rec.ClosesAt and now > rec.ClosesAt + 0.25 then
			rec.Closing = true -- expired (the server clears the attribute too)
			rec.CloseT = 0
		end
		local near = eye == nil or (rec.Center - eye).Magnitude <= K.DRAW_RANGE
		if rec.Closing then
			rec.CloseT = rec.CloseT + dt
			rec.Scale = math.max(0, 1 - rec.CloseT / K.CLOSE_TIME)
			if rec.Scale <= 0 or not near or not rec.Model then
				P.destroy(rec)
				portals[player] = nil
			end
		elseif near then
			if not rec.Model then
				P.build(rec)
				rec.Dirty = true
			end
			if rec.Scale < 1 then
				rec.Scale = math.min(1, rec.Scale + dt / K.OPEN_TIME)
			end
		elseif rec.Model then
			P.destroy(rec) -- too far: nothing drawn, it comes back when the camera nears
			rec.Scale = 1
		end
		if rec.Model and portals[player] then
			rec.Time = (rec.Time or 0) + dt
			P.place(rec)
		end
	end
	local i = 1
	while i <= #arrivals do
		if P.stepArrival(arrivals[i], dt) then
			P.endArrival(table.remove(arrivals, i))
		else
			i = i + 1
		end
	end
end

function P.safeStep(dt)
	local ok, err = pcall(P.step, dt)
	if not ok and not warned then
		warned = true
		warn("[HomePortalFx] frame error: " .. tostring(err))
	end
end

function P.watch(player)
	if playerConns[player] then
		return
	end
	local list = {}
	playerConns[player] = list
	list[#list + 1] = player:GetAttributeChangedSignal(PORTAL_ATTR):Connect(function()
		local ok, err = pcall(P.refresh, player)
		if not ok and not warned then
			warned = true
			warn("[HomePortalFx] " .. tostring(err))
		end
	end)
	list[#list + 1] = player:GetAttributeChangedSignal(ARRIVED_ATTR):Connect(function()
		if player:GetAttribute(ARRIVED_ATTR) ~= nil then
			local ok, err = pcall(P.arrive, player)
			if not ok and not warned then
				warned = true
				warn("[HomePortalFx] " .. tostring(err))
			end
		end
	end)
	if player:GetAttribute(PORTAL_ATTR) ~= nil then
		pcall(P.refresh, player)
	end
end

function P.unwatch(player)
	local list = playerConns[player]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
	end
	playerConns[player] = nil
	local rec = portals[player]
	if rec then
		P.destroy(rec)
		portals[player] = nil
	end
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function HomePortalFx.Stats()
	local n, parts, shown, faded, closing, ringParts = 0, 0, 0, 0, 0, 0
	for _, rec in pairs(portals) do
		n = n + 1
		if rec.Model then
			shown = shown + 1
			parts = parts + #rec.Items
			if rec.Faded then
				faded = faded + 1
			end
		end
		if rec.Closing then
			closing = closing + 1
		end
	end
	for _, ring in ipairs(arrivals) do
		ringParts = ringParts + #ring.Parts
	end
	return { Portals = n, Parts = parts, Shown = shown, Faded = faded, Closing = closing, Rings = #arrivals, RingParts = ringParts,
		Opened = stats.Opened, Arrivals = stats.Arrivals }
end

function HomePortalFx.Portal(player)
	local rec = player and portals[player]
	if not rec then
		return nil
	end
	return { Model = rec.Model, Center = rec.Center, Yaw = rec.Yaw, ClosesAt = rec.ClosesAt, Faded = rec.Faded, Closing = rec.Closing == true,
		Name = rec.Label and rec.Label.Text or nil, Scale = rec.Scale, Gui = rec.Gui, Mesh = rec.Mesh == true, Vortex = rec.Vortex }
end

-- the gate mesh became usable here: portals still wearing the Part copy are rebuilt with the mesh on the next frame
function P.meshArrived()
	for _, rec in pairs(portals) do
		if rec.Model and not rec.Mesh and not rec.Closing then
			P.destroy(rec)
		end
	end
end

function HomePortalFx.Init()
	if initialized then
		return
	end
	initialized = true
	localPlayer = localPlayer or Players.LocalPlayer
	for _, player in ipairs(Players:GetPlayers()) do
		P.watch(player)
	end
	conns[#conns + 1] = Players.PlayerAdded:Connect(P.watch)
	conns[#conns + 1] = Players.PlayerRemoving:Connect(P.unwatch)
	local okPps, pps = pcall(game.GetService, game, "ProximityPromptService")
	local signal = okPps and pps and pps.PromptTriggered or nil
	if signal then
		conns[#conns + 1] = signal:Connect(function(prompt, player)
			if (player == nil or player == localPlayer) and typeof(prompt) == "Instance" and P.GATE_PROMPTS[prompt.Name] then
				P.sfx("PortalEnter")
			end
		end)
	end
	loopConn = RunService.RenderStepped:Connect(P.safeStep)
	-- a waiter ranks gate_homeportal ahead of the ~800 keys preloading in arrival order (MeshLibrary: rank 1)
	local ml = P.meshLib()
	if ml and type(ml.OnReady) == "function" then
		pcall(ml.OnReady, K.MESH_KEY, function()
			if initialized then
				P.meshArrived()
			end
		end)
	end
end

function HomePortalFx.Stop()
	if loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	conns = {}
	local list = {}
	for player in pairs(playerConns) do
		list[#list + 1] = player
	end
	for _, player in ipairs(list) do
		P.unwatch(player)
	end
	for player, rec in pairs(portals) do
		P.destroy(rec)
		portals[player] = nil
	end
	for _, ring in ipairs(arrivals) do
		P.endArrival(ring)
	end
	arrivals = {}
	if folder then
		folder:Destroy()
		folder = nil
	end
	initialized = false
end

return HomePortalFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1142">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[-- HudController: the Nimbus Climb heads-up display (v3).
--
--   HudController.Init()
--   HudController.GetLayout() -> { TopLeftRight, TopLeftBottom, TopRightBottom, BottomLeftTop, Scale, CurrencyMode,
--                                  Vitals = { X, Y, W, H } | nil,   (wave 6: the vitals card's gui-area rect while it shows)
--                                  VitalsSlot = { X, Y, W, H } | nil }   (quick wins: the same rect shown or hidden; nil only
--                                  with no card. A fighter's pet battle hides the card and the battle HUD's Cheer up! /
--                                  Retreat buttons take its slot)
--   HudController.SetVitalsHidden(who, on)   (gui-redo) a window that would cover only part of the vitals card hides it
--                                  while open (the Gifts window, `who` = "Daily"; BattleController's fighter, `who` =
--                                  "Battle"); back when the last one lets go
--   HudController.SetCurrencyHidden(who, on)   (kit-b U9-2) a window that shows the balances itself steps the currency
--                                  strips aside while open (the Shop, `who` = "Shop": its header has Gems and Tokens, and
--                                  its X sat over the strips at 1280x720); back when the last one lets go
--
-- One ScreenGui "NimbusHud" (display order 10, IgnoreGuiInset = false, built by CloudUI.NewScreenGui).
-- Nothing the game announces is ever drawn in the middle of the screen. The layout map:
--
--   top-left      Match panel (difficulty, timer, checkpoint bar, team chips, Leave button) with the
--                 pre-match countdown numerals shown INSIDE it; the lobby Party panel takes the same
--                 slot (portal name + a big red Leave button, the only way out of a locked portal; the
--                 countdown; the members; "Locked until launch" + the head count); the small title card
--                 slides in there at join and leaves after four seconds
--   top-right     (bug batch 2 #1, option A "Split & shift") the currencies as thin strips stacked under
--                 Roblox's top bar, right-aligned: Cash, Gems, Cloud Tokens (coin + abbreviated number, "+n"
--                 chip on the token strip while in a match; Cash and Gems appear by themselves once those
--                 player attributes exist, and hide in a match). The toast stack (NotifyController) starts
--                 below them (TopRightBottom). A portrait screen lines them up in ONE row there (a stack would
--                 eat the toasts' room); a phone in a battle / dungeon run moves them into Roblox's top band
--                 when they fit there in one row (the battle HUD owns the top corners); a phone's dungeon End
--                 card starts below them (DungeonController reads TopRightBottom); one that still covers the
--                 corner (no room above the jump button) hides them meanwhile.
--   bottom-centre The vitals card, where it sat above the old item hotbar (HUD cleanup: the hotbar is gone, the card
--                 keeps its spot, K.HOTBAR_FALLBACK above the bottom edge, centred): heart badge +
--                 thick HP tube (white damage trail, hit flash + shake, low-health pulse, DOWNED state),
--                 lightning badge + stamina tube (dims when run dry) and the dash ring (cooldown sweep). Short touch
--                 screens get the flatter compact card (VG.Compact); it never shares rows with Roblox's
--                 thumbstick / jump button or the RUN / DASH buttons (it steps up above them where it must).
--   left-centre   MenuController's slim tile column (not ours; measured).
--
-- Sizes follow the v3 readability rule: every panel is designed in 1080p pixels (body text >= 18, numbers
-- 30+, titles 26-34) and carries a UIScale of Theme.ScreenFactor() = clamp(viewportY / 1080, 0.8, 1.25), so
-- the smallest text is 14.4 px on a phone. The UIScale sits on the panel, the margins on full-screen holder
-- frames, so scaling never moves a panel away from its corner.
--
-- Neighbours are MEASURED, not guessed: the menu column (NimbusMenu.MenuColumn, left-centre, drawn above us) and
-- the touch RUN / DASH buttons (MobileControls; HUD cleanup: the item hotbar is gone). Whatever of ours would
-- run into the column steps aside to its right; the vitals never reach under the touch buttons. The geometry is
-- re-checked twice a second and on every viewport change, and published as attributes on the NimbusHud
-- gui (TopLeftRight, TopLeftBottom, TopRightLeft, TopRightBottom, BottomLeftTop = the top of the bottom block (the
-- vitals card), BottomCentreTop / Left / Right = the vitals card, HudScale100; gui-area pixels) so the toasts,
-- dialogs and side panels can keep clear of the HUD. (kit-b U8) GiftLeft / GiftTop / GiftSize: the gift's dock under the
-- strips in the lobby (0 = none); DailyController puts its Gifts button there and TopRightBottom includes it.
-- kit-b U8 (the pitch's HUD stage, kit B): the strips are stone blocks with a coloured coin square, the vitals card a stone
-- card in a wood edge; no neon border, glow or gloss.
--
-- Data: Humanoid health, player attributes (CloudTokens, MatchTokens, InMatch, Downed, Stamina, Cash, Gems)
-- and the MatchState / PartyState remotes. Everything is nil-safe: no humanoid, no match, no party, a
-- missing menu and a missing MovementController all leave the HUD in a sensible idle state.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the coins' and the chips' icons
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b gate U9 r4) the vitals blocks' weight (Sizes.Bar)

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local okState, State = pcall(function()
	return require(Client:WaitForChild("State"))
end)
if not okState or type(State) ~= "table" then
	State = nil
end

local HudController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
-- K: layout + timing constants (one table keeps the module well under Lua's 200-locals limit)
local K = {
	EDGE = 12, -- margin to the screen edge
	TOUCH_EDGE = 20, -- larger side margin on touch devices (notches, rounded corners)
	SMALL_PHONE = 500, -- Roblox's own touch controls shrink when the smaller screen side is at most this

	VITALS_W = 430, -- (Pitch 2 item 08 C: the pitch's 430; was 300, bug batch 2 #1's compact card)
	VITALS_H = 128, -- the vitals slot: the name tab's 32 above the card + the 96 card (see VG; U9-8 look's card was 100)
	VITALS_MIN_W = 236, -- narrowest the vitals get squeezed on a small phone
	VITALS_EDGE = 2, -- (kit-b P2 fix6b) the card's wood edge, drawn outside its box (screen px)
	HOTBAR_GAP = 8, -- screen px between the old hotbar's top and the vitals card
	HOTBAR_FALLBACK = 78, -- gui px the old item hotbar reached above the bottom edge (14 + 64): the card keeps that spot
	OBSTACLE_GAP = 8, -- kept between the vitals and the column / the touch buttons / Roblox's stick and jump button
	-- (look:fix6b2 N2) the least air the card keeps where OBSTACLE_GAP would cut the player's name: the ink rule's 4 px
	-- (battle_hud_no_overlap MIN_GAP) and 1 px to spare
	OBSTACLE_TIGHT = 5,
	-- (kitb-matchhud, pick A "Slim bar") the slim bar's foot above the screen's bottom edge (gui px): where the pitch drew
	-- it, level with RUN's foot (24 px up on a phone), lifted 7 more (Gemini's tweak, accepted: a thumb at the rim must not
	-- clip it)
	SLIM_FOOT = 31,
	-- Roblox's own touch controls (gui px; small = the smaller screen side <= SMALL_PHONE): the thumbstick's zone at
	-- the bottom-left (width, height above the bottom edge: the dynamic stick's idle ring reaches ~93 px on phones)
	-- and the jump button (J x J square, left edge 1.5 J + 10 and right edge 0.5 J + 10 px from the right edge, bottom
	-- 20 px (small) or 0.75 J above the bottom edge)
	STICK_W_SMALL = 110,
	STICK_H_SMALL = 96,
	STICK_H_PORTRAIT = 150, -- a portrait phone's thumb roams higher: the card keeps the old raise there
	STICK_W_LARGE = 190,
	STICK_H_LARGE = 210,
	JUMP_SMALL = 70,
	JUMP_LARGE = 120,

	-- bug batch 2 #1 (option A): the currencies are thin strips stacked in the top-right corner, right-aligned
	STRIP_W = 168, -- one strip (design px); in a match the token strip grows by its "+n" chip
	STRIP_H = 32,
	STRIP_GAP = 6,
	STRIP_COIN = 24, -- the coin at the strip's left end (kit-b U8: a square inside the block, clear of its lip)
	STRIP_TEXT = 24, -- the number (shrinks to STRIP_TEXT_MIN for long numbers; >= 14 px on a phone)
	STRIP_TEXT_MIN = 18,
	STRIP_CHIP_W = 56, -- the "+n" match chip on the token strip
	-- (kit-b U8: the pitch's HUD stage) the gift docks under the strips in the lobby, right-aligned: this square (design px,
	-- x the screen factor, never under GIFT_MIN gui px: a thumb), GIFT_GAP under the last strip
	GIFT = 56,
	GIFT_MIN = 44,
	GIFT_GAP = 8,
	STRIP_CHIP_H = 24,
	-- ... except in a battle / dungeon run on a landscape phone, where the battle HUD needs the right edge: there the
	-- strips sit in ONE row inside Roblox's top band (the v5 place the battle HUD is laid out around)
	BAND_LEFT = 150, -- the row starts right of Roblox's top-bar buttons (screen px; HUD cleanup: right of
	-- TopBarController's pill, its NimbusTopBar PillRight + STRIP_GAP, this at least) ...
	BAND_RIGHT = 72, -- ... and ends left of its "..." button
	BAND_INSET = 58, -- the top bar's height when the gui inset cannot be measured
	BAND_MIN_W = 100, -- a strip in the band is squeezed to this at most (HUD cleanup: was 120; right of the pill three
	-- strips still fit one row down to a 640x360 phone, else they fell back to the stack under the battle HUD's LEAVE)
	-- ... and on a portrait screen the strips sit side by side in ONE row at the top right (a stack would eat the
	-- room the toasts below it need there), each this wide at most / at least
	ROW_MAX_W = 140,
	ROW_MIN_W = 104,

	COIN = 54, -- the v5 pill geometry (setRowGeometry false / true): the round coin badge of a full pill ...
	CHIP_W = 76, -- ... the "+n" match chip on it ...
	COIN_COMPACT = 42, -- ... and the coin of a compact pill

	-- (kit-b U9-8 A, the owner's pick "Stone signboard") the match + party cards: the pitch's 540 where the screen has the
	-- room (20-character names whole, two to a row) ...
	PANEL_W = 540,
	-- ... squeezed this far on short screens (keeps their text out of the screen middle) and on a portrait screen: the
	-- pitch's phone card, the narrowest where SAINT, its five stars and Leave share the top row (a name cuts to ~12 letters)
	PANEL_MIN_W = 372,
	CENTRE_TOL = 0.145, -- the screen middle: |dx| < 14.5% of the width and |dy| < 14.5% of the height
	TITLE_W = 300,
	TITLE_H = 78,

	-- Menu column fallback (only while MenuController's column cannot be measured)
	MENU_FALLBACK_W = 82, -- bug batch 2 #1: one column of eight 56 px tiles + its arrow tab
	MENU_FALLBACK_ENTRY = 56,
	MENU_FALLBACK_GAP = 5,
	MENU_FALLBACK_COUNT = 8,
	MENU_CLEARANCE = 8, -- empty strip kept between the column and whatever steps aside for it
	SPAN_MARGIN = 4, -- two vertical spans closer than this count as touching

	LOW_HEALTH = 0.3, -- below this the heart beats and the card pulses red
	TRAIL_HOLD = 0.45, -- seconds the white damage trail waits before it catches up
	TRAIL_SPEED = 0.6, -- ... then drains this much of the bar per second
	HIT_SECONDS = 0.32, -- damage flash + card shake
	SHAKE_PX = 5,
	STAMINA_RECOVER = 15, -- after running dry the stamina row stays dimmed up to this (MovementController's resume point)
	TITLE_CARD_SECONDS = 4,
	LEAVE_CONFIRM_SECONDS = 3,
	GO_SECONDS = 1.0, -- how long "GO!" replaces the timer
	STAR_PX = 18, -- (kit-b U7a) a difficulty star (PixelIcon) after the match / party level name
	-- (kitb-matchhud) the stars where the name would cut beside full-size ones (PK.FitName): one px cells, 9 px
	STAR_PX_MIN = 9,
	LAYOUT_POLL = 0.5, -- seconds between two geometry checks
}

-- VG: geometry of the vitals card in design px (1080p), width 236-300 (the bars stretch with it; the badges
-- and the dash key keep their size). H = the layout slot, CARD_H = the card drawn in it (from the top).
-- Left column: the heart badge over the lightning badge. (render gate, the pitch's .vit) both the same size, centred on
-- one column INSIDE the card (they overhung its left edge, the bolt below its bottom), each on its bar's row; the bars
-- start on one line right of them. Regular (desktops): the dash key ends the stamina row. Compact (short touch screens,
-- landscape phones): a flatter card that leaves a gap at the bottom of its slot, with a bigger dash key at the right end
-- spanning both rows. (kit-b U9-8) BADGE_ICON / KEY_ICON: the pixel icons on the badges and the key (18 / 27 px: whole
-- 2 / 3 px cells); KEY_STEP: the key's charge rises in steps of the icon's cell.
-- (U9-8 look) the HP bar is a row of HP_BLOCKS kit B blocks like the stamina (HP_H tall), its number right of them in a
-- box NUM_GAP away (the pitch's .vr: icon, bar, number); the regular card is 100 tall so 5 px of stone shows under the bolt
-- badge and the key above the lip (at 93 they sat on it). The compact card (landscape phones, always the 0.8 scale) is
-- 76 tall in its 80 slot and draws the heart and the bolt as bare pixel icons in their role's lip colour, as the pitch
-- does (BARE): at 0.8 an 18 px icon draws 18 screen px, which filled a 26 px tile edge to edge and fused the two tiles.
-- Every size here is design px; Vitals.Layout puts them on whole screen px under the card's scale.
-- (Pitch 2 item 08, option C "Name tab + stamp": .superpowers/slop-audit/round3/build/PITCH2/A_battle_hud/08_vitals_optC.png,
-- pitch_battle_hud.py vitals_C) the slot is the tab's TAB_UP above the card + the card. The wood tab (TAB_X in, TAB_H tall,
-- its foot behind the card's top edge) carries the stamp (STAMP square), the name (NAME_TEXT) and the trophies tag
-- (TROPHY_H, TROPHY_TEXT). The card: the bare heart (HEART_X) left of the HP track (TRACK_X .. W - PAD_R, HP_Y / HP_H from
-- the card's top: the blocks, a 2 px divider and the number at HP_TEXT in ONE sunk track) and under it the stamina group
-- (ST_Y / ST_H: the bare bolt, the stamina blocks ST_BLOCK wide, the dash state, the dash key KEY square at its right end
-- in ONE sunk well). Both geometries draw the badges bare; the compact card (landscape phones, always the 0.8 scale) is the
-- same card (its dash key is gone on a touch screen anyway)
local VG = {
	Regular = {
		Name = "Regular", H = K.VITALS_H, TAB_UP = 32, CARD_H = 96, CARD_X = 0, CARD_CORNER = 0, -- (kit-b U8: square)
		TAB_X = 14, TAB_H = 44, STAMP = 30, STAMP_TEXT = 26, NAME_TEXT = 20, NAME_MIN = 16, TROPHY_H = 26, TROPHY_TEXT = 18,
		HEART_X = 13, HEART = 24, HEART_TEXT = 22, BOLT = 24, BADGE_ICON = 18, BADGE_LIP = 0, BARE = true,
		TRACK_X = 39, HP_Y = 12, HP_H = 30, HP_TEXT = 18, PAD_R = 13,
		ST_Y = 48, ST_H = 30, ST_BLOCK = 28, ST_TEXT = 18,
		KEY = 26, KEY_ICON = 18, KEY_STEP = 2,
	},
	Compact = {
		Name = "Compact", H = K.VITALS_H, TAB_UP = 32, CARD_H = 96, CARD_X = 0, CARD_CORNER = 0,
		TAB_X = 14, TAB_H = 44, STAMP = 30, STAMP_TEXT = 26, NAME_TEXT = 20, NAME_MIN = 18, TROPHY_H = 26, TROPHY_TEXT = 18,
		HEART_X = 13, HEART = 24, HEART_TEXT = 22, BOLT = 24, BADGE_ICON = 18, BADGE_LIP = 0, BARE = true,
		TRACK_X = 39, HP_Y = 12, HP_H = 30, HP_TEXT = 18, PAD_R = 13,
		ST_Y = 48, ST_H = 30, ST_BLOCK = 28, ST_TEXT = 18,
		KEY = 26, KEY_ICON = 18, KEY_STEP = 2,
	},
	-- (kitb-matchhud, the owner's pick A "Slim bar" of 2026-11-27: .superpowers/slop-audit/round3/build/PITCH_MATCHHUD/
	-- A_640x360_match.png) a match / its countdown on a short landscape phone where the card above has no row clear of the
	-- keys, the panel and the rings: the card becomes ONE slim row of the same kit parts - the bare heart, the HP track (the
	-- blocks HP_BLOCK wide, down to HP_BLOCK_MIN where the row is narrower, the divider, the number), GROUP_GAP, the stamina
	-- well (the bare bolt, the blocks ST_BLOCK wide), PAD_R - CARD_H tall, the rows ROW_Y down. No stamp, no trophies, no dash
	-- words (the name and an HP bar are the panel's gold 'you' chip; the touch DASH key shows its own cool-down). Slim: with
	-- the small name tag (the card's wood tab, the name alone, NAME_TEXT) TAB_UP over the bar's top-left, where it fits whole
	-- with the bar's air (applyMargins); SlimBare: the bar alone (a 360-tall phone: no room under the panel)
	Slim = {
		Name = "Slim", Slim = true, H = 76, TAB_UP = 26, CARD_H = 50, CARD_X = 0, CARD_CORNER = 0,
		TAB_X = 14, TAB_H = 32, TAB_PAD = 9, NAME_TEXT = 18, NAME_MIN = 18,
		HEART_X = 10, HEART = 24, HEART_TEXT = 22, BOLT = 24, BADGE_ICON = 18, BADGE_LIP = 0, BARE = true,
		TRACK_X = 39, ROW_Y = 8, ROW_H = 30, HP_TEXT = 18, HP_BLOCK = 16, HP_BLOCK_MIN = 10, GROUP_GAP = 10, PAD_R = 10,
		ST_BLOCK = 22, ST_TEXT = 18, KEY = 26, KEY_ICON = 18, KEY_STEP = 2,
	},
	SlimBare = {
		Name = "SlimBare", Slim = true, H = 50, TAB_UP = 0, CARD_H = 50, CARD_X = 0, CARD_CORNER = 0,
		TAB_X = 14, TAB_H = 32, TAB_PAD = 9, NAME_TEXT = 18, NAME_MIN = 18,
		HEART_X = 10, HEART = 24, HEART_TEXT = 22, BOLT = 24, BADGE_ICON = 18, BADGE_LIP = 0, BARE = true,
		TRACK_X = 39, ROW_Y = 8, ROW_H = 30, HP_TEXT = 18, HP_BLOCK = 16, HP_BLOCK_MIN = 10, GROUP_GAP = 10, PAD_R = 10,
		ST_BLOCK = 22, ST_TEXT = 18, KEY = 26, KEY_ICON = 18, KEY_STEP = 2,
	},
	TRACK_EDGE = 2, TRACK_PAD = 3, DIVIDER = 2, -- the sunk track's / well's edge, its inside padding, the HP number's divider
	-- the dash's state in the stamina group (each state's longest form that fits whole: Vitals.Layout)
	DASH_WORDS = { ready = "Dash ready", cool = "Recharging", off = "Out of stamina" },
	-- (look review round 1: a phone's well kept its right half empty) the sets for a well too short for "Out of stamina"
	DASH_WORDS_SHORT = { ready = "Dash ready", cool = "Charging", off = "No stamina" },
	DASH_WORDS_TINY = { ready = "Ready", cool = "Wait", off = "Empty" },
	-- the stamp's five kit colours (UserId % 5 + 1) and their lips
	STAMPS = { { "Sky", "SkyLip" }, { "Grass", "GrassLip" }, { "Gold", "GoldLip" }, { "Red", "RedLip" }, { "Violet", "VioletLip" } },
	HP_BLOCKS = 5, -- (U9-8 look) the HP bar's blocks, a fifth of the health each
	-- (kit-b gate U9 r4: one bar language) the blocks: the kit's Bar weight (SignKit.Sizes.Bar: edge 2, lip 3, gap 3, as the
	-- Loss, Train and battle bars; were lip 4 / gap 4)
	BLOCK_EDGE = SignKit.Sizes.Bar.Edge, BLOCK_LIP = SignKit.Sizes.Bar.Lip, BLOCK_GAP = SignKit.Sizes.Bar.GapMax,
	CARD_EDGE = 3, CARD_LIP = 5, BADGE_EDGE = 2, KEY_EDGE = 2, -- (U9-8 look) the card's, a badge's and the key's wood / lip
	KEY_LIP = 4, KEY_SINK = 3, -- the key's lip at rest, and how far its face drops onto it while it cools down (the lip 4 -> 1)
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local INK = Colors.TextStroke or Colors.Ink
-- VS: the vitals card's colours
local VS = {
	PanelTop = Colors.PanelTop or Colors.PanelLight, -- v5: the Neon card fill (top -> bottom) and its darkest ink
	PanelBottom = Colors.PanelBottom or Colors.Panel,
	PanelInk = Colors.PanelInk or Colors.Ink,
	-- (render gate, the pitch's .vit) colour by role: the HP bar red, the stamina gold (bar, bolt badge, dash face)
	Hp = Theme.Sign.Red,
	HpDown = Theme.Sign.RedLip,
	Stamina = Theme.Sign.Gold,
	BoltInk = Theme.Sign.Text,
	Edge = Theme.Darken(NAVY, 0.3), -- outline of the tubes
	TrackTop = Color3.fromRGB(12, 16, 40), -- the dark inset track of the tubes
	TrackBottom = Color3.fromRGB(40, 52, 104),
	-- (kit-b U9-8) a stamina row you cannot dash on dims toward the stone's tan (no grey in kit B); the dash key's charge
	-- is the sky (the dash's colour: the battle HUD's DASH, the touch DASH key)
	Dim = Theme.Sign.StoneLip,
	DimLip = Theme.Sign.WellEdge,
	Charge = Theme.Sign.Sky,
}
local Vitals = {} -- builders and painters of the vitals card (one table keeps the chunk's locals down)

-- (U9-7 look) the docked side windows on screen (NeonKit.OpenDocks: Arena, Ring, Dungeon, the dare panel, Home, the Food
-- Machine...) in gui-area px; a portrait sheet covers the whole bottom and is left out. The vitals card keeps clear of them
function Vitals.DockRects(inset)
	local ok, docks = pcall(function()
		return require(Client:WaitForChild("UI"):WaitForChild("NeonKit")).OpenDocks()
	end)
	local out = {}
	for _, r in ipairs((ok and type(docks) == "table") and docks or {}) do
		if r.mode ~= "Sheet" then
			out[#out + 1] = { x0 = r.x0, y0 = r.y0 - inset, x1 = r.x1, y1 = r.y1 - inset }
		end
	end
	return out
end
local CUR = Theme.Currency or {}

-- Currency rows, top to bottom. Tokens is always shown (and sits right above the HP bar); the others appear
-- once their player attribute exists (phase 2 sets them).
-- v5: Neon = the pill's neon border (contract 6.6: Cash green, Tokens gold, Gems cyan).
local CURRENCY_ORDER = {
	{ Id = "Cash", Attr = Config.Attr.Cash, Def = CUR.Cash, Neon = "Green" },
	{ Id = "Gems", Attr = Config.Attr.Gems, Def = CUR.Gems, Neon = "Cyan" },
	{ Id = "Tokens", Attr = Config.Attr.Tokens, Def = CUR.Tokens, Always = true, Run = true, Neon = "Gold" },
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local player = nil
local initialized = false
local startedAt = 0
local connections = {}
local warned = {}
local remoteCache = {}
local scalers = {} -- UIScale objects driven by the screen factor
local pads = {} -- UIPadding objects of the corner holders
local padTweens = {} -- running PaddingLeft tween per holder
local padGoals = {} -- last PaddingLeft requested per holder
local M = nil -- layout metrics of the match / party panels, see panelMetrics()
local movementModule = nil
local movementNextTry = 0
local layoutKey = nil
local layoutPoll = 0
local published = {} -- the geometry attributes on the gui
local vitalsRect = nil -- wave 6: the vitals card's last laid-out rect (gui-area px: X, Y = top-left, W, H); GetLayout().Vitals
-- (playtest 2026-11-28 C31 r2) the top-right strips' own box for Overlaps (gui-area px: Left, Bottom = their foot, or the gift's
-- dock under them), nil with no strips in the top-right corner; TopRightLeft is the whole block's left (the gift beside)
local stripsBox = nil

local UI = {} -- instance references
local Items = {} -- sliding panels, see present()
local Cur = {} -- currency rows by id: { Def, Attr, Row, Amount, AmountScale, CoinScale, Target, Display, Shown, Seen, Visible }

local S = {
	match = nil, party = nil, downed = false, currencyMode = "TopRight", panelW = K.PANEL_W,
	yieldToResult = false, -- a narrow screen with the result card open: the match panel steps away
	vitalsOwners = {}, -- [window name] = true while that window wants the vitals card hidden (SetVitalsHidden)
	currencyOwners = {}, -- (kit-b U9-2) [window name] = true while that window wants the currency strips hidden (SetCurrencyHidden)
	topReserve = {}, -- (P2 fix A) [owner] = gui-area px of the top band a card spans (SetTopReserve): the strips start under it
}
local H = { -- health
	Char = nil, Humanoid = nil, Conns = {},
	Cur = 100, Max = 100, Target = 1, Fill = 1, Trail = 1,
	HoldUntil = 0, ColorKey = nil, Text = nil, Low = false,
	HitAt = -10, HitFx = false, -- last damage (flash + shake running while HitFx)
}
-- stamina + dash ring: Dim 0 = bright .. 1 = empty (eased), Charge = drawn cooldown sweep 0..1
local St = { Frac = 1, Dim = 0, DimDrawn = -1, Drained = false, Charge = -1, Ready = nil, Afford = nil }
local Tk = { RunSeen = 0 } -- the "+n" match chip
local Mt = { -- match panel bookkeeping
	Base = 0, At = 0, Phase = nil, Last = nil, GoUntil = 0, Rows = 1, Chips = {}, Count = 0,
	Compact = false, -- (kitb-matchhud) the checkpoints share the clock row on a narrow card (the slim layout: applyMargins)
}
local Pt = { -- party panel bookkeeping (Fit*: what the text sizes were last fitted for)
	Base = nil, At = 0, Rows = 1, Chips = {}, Count = 0, LastText = nil, LeaveLockUntil = 0,
	HintLong = "Locked until launch", HintShort = "Locked in", FitW = nil, FitTitle = nil, FitStatus = nil, FitHint = nil,
}
local LM = { ArmedUntil = 0, LockedUntil = 0 } -- leave-match confirmation
local TC = { Serial = 0, Shown = false } -- title card

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local tween = Util.Tween

local function track(conn)
	if conn then
		table.insert(connections, conn)
	end
	return conn
end

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[HudController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

-- pcall wrapper that reports each distinct failure once instead of spamming every frame.
local function guard(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

-- The readability factor: clamp(viewportY / 1080, 0.8, 1.25).
local function currentScale()
	return Theme.ScreenFactor(viewportSize().Y)
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

local function fireRemote(name)
	local remote = remoteCache[name]
	if not remote then
		local ok, found = pcall(Remotes.Get, name)
		if ok and found then
			remote = found
			remoteCache[name] = found
		end
	end
	if remote then
		remote:FireServer()
	end
end

----------------------------------------------------------------------
-- UI builders
----------------------------------------------------------------------
local function newFrame(parent, name, props)
	local p = { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Themed TextLabel. props may include Outline = "World" (text floating over the 3D world with no plate: ONE outline,
-- Theme's world rule) with OutlineColor / OutlineThickness, plus any label property. kit-b U6: every other HUD text sits
-- on its card, chip or coin and reads by contrast, so it gets no outline and no classic stroke.
local function newText(parent, name, text, role, size, color, props)
	local extra = {
		Name = name,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	local outline, outlineColor, thickness = nil, nil, nil
	if props then
		for key, value in pairs(props) do
			if key == "Outline" then
				outline = value
			elseif key == "OutlineColor" then
				outlineColor = value
			elseif key == "OutlineThickness" then
				thickness = value
			else
				extra[key] = value
			end
		end
	end
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Outline = outline,
		OutlineThickness = thickness,
		OutlineColor = outlineColor or INK,
		Props = extra,
	})
	label.Parent = parent
	return label
end

local function round(inst)
	return Theme.Corner(inst, "Round")
end

local function newScale(parent, value)
	local s = Instance.new("UIScale")
	s.Scale = value or 1
	s.Parent = parent
	return s
end

-- A UIScale driven by the screen factor (grows around the object's anchor point).
local function addViewportScale(root)
	local s = newScale(root, currentScale())
	s.Name = "ViewportScale"
	table.insert(scalers, s)
	return s
end

-- Springy "pop": jump a UIScale to `peak`, then ease back to 1.
local function pop(scaleObj, peak, seconds)
	if not scaleObj then
		return
	end
	scaleObj.Scale = peak
	tween(scaleObj, seconds or 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Face of a badge (kit-b U8: the kit B block): the flat colour, then a hard darker lip along the bottom. `glow` is kept for
-- the callers and no longer lightens the top (no gloss).
local function badgeSequence(color, glow)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, color),
		ColorSequenceKeypoint.new(0.8, color),
		ColorSequenceKeypoint.new(0.82, Theme.Darken(color, 0.28)),
		ColorSequenceKeypoint.new(1, Theme.Darken(color, 0.28)),
	})
end

-- A square kit B badge (kit-b U8: was a glossy round one): the flat face with its lip (a UIGradient named "Lip" with a hard
-- step), a wood edge. Returns the badge, its UIGradient and its UIStroke.
local function newBadge(parent, name, size, color, glow)
	local badge = newFrame(parent, name, {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
	})
	local stroke = Theme.Stroke(badge, Theme.Sign.Wood, 3, 0)
	stroke.LineJoinMode = Enum.LineJoinMode.Miter
	local g = Instance.new("UIGradient")
	g.Name = "Lip"
	g.Rotation = 90
	g.Color = badgeSequence(color, glow)
	g.Parent = badge
	return badge, g, stroke
end

-- Glossy coin badge: newBadge plus a glyph (kit B, no outline: in the ink that reads on the coin's gradient).
-- (kit-b U7a) `glyph` may be a PixelIcon name ("token", "note"): the coin's Glyph label is then empty and hosts that icon
-- at about glyphSize px (setCoinIcon redraws it at a new size)
local function setCoinIcon(label, name, px)
	local old = label:FindFirstChild("Icon")
	if old and old:GetAttribute("PixelIcon") == name and old.Size.X.Offset == PixelIcon.Snap(px * 0.8) then
		return -- the layout poll re-applies the geometry every 0.5 s: nothing to redraw
	end
	label:SetAttribute("PixelIcon", name)
	PixelIcon.Host(label, name, px * 0.8)
end

-- (kit-b U8) a square kit B block in `color` with a wood edge (the currency strip's coin square, the vitals' badges)
function Vitals.SignSquare(parent, name, size, color)
	local sq = newFrame(parent, name, {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
	})
	local edge = Theme.Stroke(sq, Theme.Sign.Wood, 2, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	return sq
end

local function newCoin(parent, name, size, color, glow, glyph, glyphSize)
	local coin = newBadge(parent, name, size, color, glow)
	local icon = PixelIcon.Bitmaps[glyph] and glyph or nil
	local label = newText(coin, "Glyph", icon and "" or glyph, "Display", glyphSize, Theme.TextOn(badgeSequence(color, glow)), {
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 0, 0, -1),
		ZIndex = 2,
	})
	if icon then
		setCoinIcon(label, icon, glyphSize)
	end
	return coin
end

-- Slide a panel in/out between item.Rest and item.Hidden (both UDim2).
local function present(item, show)
	if not item or not item.Root or item.Shown == show then
		return
	end
	item.Shown = show
	local root = item.Root
	if show then
		root.Position = item.Hidden
		root.Visible = true
		tween(root, 0.4, { Position = item.Rest }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		tween(root, 0.22, { Position = item.Hidden }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.28, function()
			if not item.Shown and root.Parent then
				root.Visible = false
			end
		end)
	end
end

local function newItem(root, hidden)
	root.Visible = false
	return { Root = root, Shown = false, Rest = root.Position, Hidden = hidden }
end

-- A transparent full-screen frame whose UIPadding is the screen margin of one corner.
local function newHolder(gui, name)
	local holder = newFrame(gui, name, { Size = UDim2.fromScale(1, 1) })
	local pad = Instance.new("UIPadding")
	pad.Parent = holder
	pads[name] = pad
	return holder
end

-- The area GUIs with IgnoreGuiInset = false are laid out in (below the top bar).
local function guiAreaSize()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	local vp = viewportSize()
	return Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
end

----------------------------------------------------------------------
-- Neighbour geometry (measured)
----------------------------------------------------------------------
local function playerGui()
	return player and player:FindFirstChildOfClass("PlayerGui")
end

-- y offset that converts a gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function rectOf(inst, dy)
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	return { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

-- MenuController's left-centre column in our coordinates (nil when there is none to avoid).
local function menuRect(area)
	local pg = playerGui()
	local menuGui = pg and pg:FindFirstChild("NimbusMenu")
	if menuGui and menuGui:IsA("ScreenGui") then
		if not menuGui.Enabled then
			return nil
		end
		local dy = insetShift(menuGui)
		local column = menuGui:FindFirstChild("MenuColumn") or menuGui:FindFirstChild("MenuColumn", true)
		if column and column:IsA("GuiObject") and shownIn(column, menuGui) and column.AbsoluteSize.X > 0 then
			return rectOf(column, dy)
		end
		-- no column frame: the union of the menu buttons
		local box = nil
		for _, d in ipairs(menuGui:GetDescendants()) do
			if d:IsA("GuiObject") and string.sub(d.Name, 1, 11) == "MenuButton_" and d.AbsoluteSize.X > 0 and shownIn(d, menuGui) then
				local r = rectOf(d, dy)
				if box then
					box.x0, box.y0 = math.min(box.x0, r.x0), math.min(box.y0, r.y0)
					box.x1, box.y1 = math.max(box.x1, r.x1), math.max(box.y1, r.y1)
				else
					box = r
				end
			end
		end
		if box then
			return box
		end
	end
	-- not built yet: a generous estimate of the v3 column (vertically centred against the left edge)
	local s = Util.Clamp(math.min(area.X / 1280, area.Y / 720), 0.72, 1.2)
	local height = (K.MENU_FALLBACK_COUNT * K.MENU_FALLBACK_ENTRY + (K.MENU_FALLBACK_COUNT - 1) * K.MENU_FALLBACK_GAP) * s
	return { x0 = 0, y0 = (area.Y - height) / 2, x1 = (K.MENU_FALLBACK_W + K.MENU_FALLBACK_GAP) * s, y1 = (area.Y + height) / 2 }
end

-- The touch RUN / DASH buttons (MovementController) in our coordinates.
local function mobileRects()
	local out = {}
	local pg = playerGui()
	local mobile = pg and pg:FindFirstChild("MobileControls")
	if not (mobile and mobile:IsA("ScreenGui") and mobile.Enabled) then
		return out
	end
	local dy = insetShift(mobile)
	for _, d in ipairs(mobile:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.AbsoluteSize.X > 0 and shownIn(d, mobile) then
			-- (LOOK-ui) a kit tile's wood edge is a Border stroke drawn outside its box: it counts. (kit-b P2 fix6b, look1 O3:
			-- RUN / DASH draw theirs on the key's Block, so it was missed and the vitals card's ink came 3 px off RUN's)
			local r = rectOf(d, dy)
			local block = d:FindFirstChild("Block")
			local edge = d:FindFirstChild("SignEdge") or (block and block:FindFirstChild("SignEdge"))
			local e = (edge and edge:IsA("UIStroke")) and edge.Thickness or 0
			r.x0, r.y0, r.x1, r.y1 = r.x0 - e, r.y0 - e, r.x1 + e, r.y1 + e
			table.insert(out, r)
		end
	end
	return out
end

local function rectKey(r)
	if not r then
		return "-"
	end
	return string.format("%d,%d,%d,%d", math.floor(r.x0), math.floor(r.y0), math.floor(r.x1), math.floor(r.y1))
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
-- What currently occupies the top-left slot: a match / party panel, the title card, and the design height
-- (0 while nothing does).
local function topLeftState()
	local hasPanel, hasTitle, h = false, false, 0
	if Items.Match and Items.Match.Shown and UI.Match then
		hasPanel = true
		h = math.max(h, UI.Match.Root.Size.Y.Offset)
	end
	if Items.Party and Items.Party.Shown and UI.Party then
		hasPanel = true
		h = math.max(h, UI.Party.Root.Size.Y.Offset)
	end
	if Items.Title and Items.Title.Shown then
		hasTitle = true
		h = math.max(h, K.TITLE_H)
	end
	return hasPanel, hasTitle, h
end

-- The currencies shown right now, top to bottom. In a match only Cloud Tokens count (and the stack stays
-- small next to the match panel); in the lobby every currency the player has.
local function visibleCurrencies()
	local list = {}
	local inMatch = S.match ~= nil or (player and player:GetAttribute(Config.Attr.InMatch) == true)
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c and c.Available and (c.Always or not inMatch) then
			table.insert(list, c)
		end
	end
	return list
end

-- Sets one corner holder's margins. The left margin eases to its new value when `animate` is set (a panel that
-- is showing grows a row and must not hop sideways); everything else snaps.
local function setPadding(name, left, top, right, bottom, animate)
	local pad = pads[name]
	if not pad then
		return
	end
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingRight = UDim.new(0, right)
	pad.PaddingBottom = UDim.new(0, bottom)
	if padGoals[name] == left then
		return -- already there, or already easing there
	end
	padGoals[name] = left
	local running = padTweens[name]
	if running then
		running:Cancel()
		padTweens[name] = nil
	end
	local goal = UDim.new(0, left)
	if animate and math.abs(pad.PaddingLeft.Offset - left) > 0.5 then
		padTweens[name] = tween(pad, 0.25, { PaddingLeft = goal })
	else
		pad.PaddingLeft = goal
	end
end

local function publish(name, value)
	value = math.floor((tonumber(value) or 0) + 0.5)
	if published[name] ~= value and UI.Gui then
		published[name] = value
		UI.Gui:SetAttribute(name, value)
	end
end

local layoutCurrencyRows -- (style, width) -> places the rows; defined with the currency code below
local setPanelWidth -- (designWidth) -> resizes the match / party panels; defined with the panels below
local setVitalsGeometry -- (VG.Regular | VG.Compact) -> places the vitals card's parts; defined with the card
-- (kitb-matchhud) (on) -> the match card's checkpoints in its clock row (true) or their own row; true when that changed its
-- size. And the design px that saves on a narrow card (0 where they already share the clock row). Defined with the panels
local setMatchCompact, compactSaving

-- Cards that own the top-right corner for a moment (in our coordinates, nil when none is up): the currency strips
-- step out of their way. Today: DungeonController's End card (NimbusDungeonRun.EndCard), which phones draw under the
-- strips while a run's result shows (and in the corner itself only when that leaves no room above the jump button).
local function cornerCardRect()
	local pg = playerGui()
	local run = pg and pg:FindFirstChild("NimbusDungeonRun")
	if not (run and run:IsA("ScreenGui") and run.Enabled) then
		return nil
	end
	local card = run:FindFirstChild("EndCard")
	if card and card:IsA("GuiObject") and card.AbsoluteSize.X > 0 and shownIn(card, run) then
		return rectOf(card, insetShift(run))
	end
	return nil
end

-- Roblox's own touch controls (thumbstick zone bottom-left, jump button bottom-right) in our coordinates.
local function robloxTouchRects(area, vp)
	local small = math.min(vp.X, vp.Y) <= K.SMALL_PHONE
	local j = small and K.JUMP_SMALL or K.JUMP_LARGE
	local jumpBottom = small and 20 or j * 0.75
	local stickW = small and K.STICK_W_SMALL or K.STICK_W_LARGE
	local stickH = small and K.STICK_H_SMALL or K.STICK_H_LARGE
	if small and vp.Y > vp.X then
		stickH = K.STICK_H_PORTRAIT
	end
	return {
		{ x0 = 0, y0 = area.Y - stickH, x1 = stickW, y1 = area.Y, soft = true }, -- (the zone the thumb roams: placeVitals)
		{ x0 = area.X - (1.5 * j + 10), y0 = area.Y - jumpBottom - j, x1 = area.X - (0.5 * j + 10), y1 = area.Y - jumpBottom },
	}
end

-- Where the vitals card goes (bug batch 2 #1): bottom centre, its bottom at `bottom` (gui px, where the old hotbar's
-- top was) and centred on `cx`, as wide as `w` design px (>= minW). Whatever shares its rows - the menu
-- column, the touch RUN / DASH buttons, Roblox's stick and jump button - limits it from the side it is on; when the
-- room left is narrower than minW the card steps up just above the lowest of those and tries again, but never with
-- its top above `ceiling` (the middle of the screen): there it keeps the last rows, squeezed to minW.
-- Returns left (gui px), width (design px), bottom (gui px). `air`: the air kept off them (default OBSTACLE_GAP).
-- (kitb-matchhud) `tabUp`: the screen px of the slot over the card's own top (its name tab's band): an obstacle marked
-- cardOnly (the match / party panel's hard shadow) is kept off the card's rows only - the tab, inset from the card's left
-- edge, already keeps its air off the panel's box
local function placeVitals(area, k, w, minW, h, bottom, cx, obstacles, side, ceiling, air, tabUp)
	-- (kit-b P2 fix6b, look1 O3) the card's own wood edge is drawn outside its box: the gap is kept from it
	local gap = (air or K.OBSTACLE_GAP) + K.VITALS_EDGE
	for _ = 1, 6 do
		local top = bottom - h * k
		local left, right = side, area.X - side
		local hardLeft, hardRight = side, area.X - side
		local step = nil
		for _, r in ipairs(obstacles) do
			if (r.cardOnly and (top + (tabUp or 0)) or top) < r.y1 + gap and bottom > r.y0 - gap then
				if (r.x0 + r.x1) / 2 < cx then
					left = math.max(left, r.x1 + gap)
					hardLeft = r.soft and hardLeft or math.max(hardLeft, r.x1 + gap)
				else
					right = math.min(right, r.x0 - gap)
					hardRight = r.soft and hardRight or math.min(hardRight, r.x0 - gap)
				end
				step = math.max(step or -math.huge, r.y0 - gap)
			end
		end
		if right - left < minW * k and step and step - h * k < ceiling and hardRight - hardLeft >= minW * k then
			-- (kit-b P2 fix6b, look1 O3: at 360 x 640 and 375 x 667 the card, squeezed at the middle's edge between the
			-- stick's zone and RUN / DASH, lay on both keys and cut the name to 'SkyCli...') at the last rows it may reach,
			-- the card gives way to the drawn keys and buttons only: it may share rows with the zone the stick's thumb roams
			-- (nothing is drawn there; its ring sits under the card)
			left, right = hardLeft, hardRight
		end
		if right - left >= minW * k or not step or step - h * k < ceiling then
			local width = math.floor(Util.Clamp((right - left) / k, minW, w))
			local half = width * k / 2
			local x = Util.Clamp(cx, left + half, math.max(left + half, right - half))
			return x - half, width, bottom
		end
		bottom = step
	end
	return cx - minW * k / 2, minW, bottom
end

-- Lays out the HUD (bug batch 2 #1, option A "Split & shift"). Inputs are measured every time; when nothing changed
-- since the last call the work is skipped (it runs twice a second). `animate` eases the top-left shift; `force`
-- skips the check.
--   * currencies: thin strips stacked in the top-right corner (right-aligned, below Roblox's top bar), every device;
--   * vitals: bottom centre, in the old item hotbar's spot (HUD cleanup: the hotbar is gone; K.HOTBAR_FALLBACK),
--     compact width; on touch screens it never shares rows with Roblox's stick / jump button
--     or the RUN / DASH buttons (it steps up above them on a portrait phone);
--   * the match / party panels and the title card keep the top-left corner (right of the menu column when they would
--     reach it).
-- HUD cleanup: TopBarController's pill (ScreenGui NimbusTopBar) sits in Roblox's top band right of its buttons; a
-- phone battle's TopBand currency row starts right of it (the PillRight attribute, screen px), K.BAND_LEFT at least.
local function topBarGui()
	local pg = playerGui()
	local bar = pg and pg:FindFirstChild("NimbusTopBar")
	return (bar and bar:IsA("ScreenGui")) and bar or nil
end

local function bandLeft()
	local right = 0
	pcall(function()
		local bar = topBarGui()
		right = (bar and bar.Enabled and tonumber(bar:GetAttribute("PillRight"))) or 0
	end)
	if right > 0 then
		return math.max(K.BAND_LEFT, right + K.STRIP_GAP)
	end
	return K.BAND_LEFT
end

local function applyMargins(animate, force)
	if not UI.Gui or not M then
		return
	end
	-- the pill moves (Travel hides in a battle, a resize): the band row follows it
	local topBar = topBarGui()
	if topBar and S.topBar ~= topBar then
		S.topBar = topBar
		track(topBar:GetAttributeChangedSignal("PillRight"):Connect(function()
			guard("top bar", applyMargins, false, true)
		end))
		track(topBar:GetPropertyChangedSignal("Enabled"):Connect(function()
			guard("top bar", applyMargins, false, true)
		end))
	end
	local bandX = bandLeft()
	local touch = isTouchDevice()
	local side = touch and K.TOUCH_EDGE or K.EDGE
	local vp = viewportSize()
	local k = currentScale()
	local area = guiAreaSize()
	local inset = math.max(0, vp.Y - area.Y)
	local column = menuRect(area)
	local buttons = touch and mobileRects() or {}
	local cornerCard = cornerCardRect()
	local docks = Vitals.DockRects(inset)
	local hasPanel, hasTitle, topH = topLeftState()
	local currencies = visibleCurrencies()
	local inMatch = S.match ~= nil or (player and player:GetAttribute(Config.Attr.InMatch) == true)
	local inBattle = player ~= nil and player:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil
	-- a phone in a battle / dungeon run: the strips go into Roblox's top band when they fit there in one row (the
	-- battle HUD owns the top corners; a landscape phone always has the room, a portrait one for a single strip),
	-- else (a portrait phone with Cash / Gems) they keep the narrow stack and the battle HUD's fighter card narrows
	local nCur = math.max(1, #currencies)
	local topBand = touch and inBattle and math.min(vp.X, vp.Y) <= K.SMALL_PHONE
		and nCur * K.BAND_MIN_W * k + (nCur - 1) * K.STRIP_GAP * k <= vp.X - bandX - K.BAND_RIGHT

	local parts = { area.X, area.Y, vp.X, vp.Y, k, touch and 1 or 0, hasPanel and 1 or 0, hasTitle and 1 or 0, topH,
		rectKey(column), rectKey(cornerCard), inMatch and 1 or 0, topBand and 1 or 0, inBattle and 1 or 0, bandX }
	for _, c in ipairs(currencies) do
		table.insert(parts, c.Id)
	end
	table.insert(parts, Vitals.FullName() .. "|" .. Vitals.TrophyText()) -- (look:fix6b2 N2: the name's room sets the card's air)
	for _, r in ipairs(buttons) do
		table.insert(parts, rectKey(r))
	end
	for _, r in ipairs(docks) do
		table.insert(parts, "d" .. rectKey(r))
	end
	local key = table.concat(parts, "|")
	if not force and key == layoutKey and not animate then
		return
	end
	layoutKey = key

	local function clearOfColumn(top, bottom)
		if column and top < column.y1 + K.SPAN_MARGIN and bottom > column.y0 - K.SPAN_MARGIN then
			return math.max(side, column.x1 + K.MENU_CLEARANCE)
		end
		return side
	end
	-- the middle of the screen the game must never write into (the layout rule), in gui-area pixels
	local band = {
		x0 = vp.X * (0.5 - K.CENTRE_TOL), x1 = vp.X * (0.5 + K.CENTRE_TOL),
		y0 = vp.Y * (0.5 - K.CENTRE_TOL) - inset, y1 = vp.Y * (0.5 + K.CENTRE_TOL) - inset,
	}

	-- top-left panels: right of the menu column when they would reach it, and on short screens no wider than
	-- what keeps their text out of the middle of the screen
	local topLeft = side
	local panelW = K.PANEL_W
	if topH > 0 then
		topLeft = clearOfColumn(K.EDGE, K.EDGE + topH * k)
		if topLeft > side and topLeft + K.PANEL_MIN_W * k > area.X - side then
			-- a narrow portrait phone has no room beside the tile column (the panel would run off the right edge): the
			-- panel keeps the corner and MenuController moves the tiles below it (our TopLeftBottom)
			topLeft = side
		end
		if K.EDGE + topH * k > band.y0 then
			panelW = math.floor(Util.Clamp((band.x0 - topLeft - 4) / k, K.PANEL_MIN_W, K.PANEL_W))
		end
	end
	-- (kit-b U9-8 A) a portrait screen takes the narrow card (the pitch's phone card), and no card runs off the screen
	if vp.X < vp.Y then
		panelW = math.min(panelW, K.PANEL_MIN_W)
	end
	panelW = math.max(1, math.min(panelW, math.floor((area.X - topLeft - side) / k)))
	-- ((kitb-matchhud) the width is set below, once the panel's clearance off the touch keys is known)

	-- vitals: the regular card, the flatter compact card on short touch screens (landscape phones: the bottom band
	-- between the stick and the jump button is busy there)
	local geometry = (touch and vp.Y <= K.SMALL_PHONE) and VG.Compact or VG.Regular
	-- (U9-8 look) the card's height and width whole screen px, so its top corner (it hangs from a whole-px bottom) is too
	local vitalsH = math.floor(geometry.H * k + 0.5) / k
	-- (HUD cleanup: no hotbar to measure any more; the card keeps the bottom-centre spot it had above it)
	local vitalsBottom = area.Y - K.HOTBAR_FALLBACK * k - K.HOTBAR_GAP
	local cx = area.X / 2
	-- (kitb-matchhud) the match / party panel's hard shadow (SignKit.Frame's, Theme.Finish.Window design px under its scale,
	-- whole screen px) below and right of its box: the card's ink came 1.6 - 2.4 px off it at 640 x 360 .. 932 x 430
	local shadowPx = hasPanel and math.floor((tonumber(Theme.Finish and Theme.Finish.Window) or 0) * k + 0.5) or 0
	-- the obstacles for a panel `pw` design px wide and `ph` tall: with `whole` its box and its shadow as one rect (the slim
	-- bar and its tag sit under it), else its box and the shadow kept off the card's rows only (cardOnly: the card's name
	-- tab, inset from its left edge, keeps its air off the box; at 800 x 450 the tab sits 9.6 px right of the shadow)
	local function obstaclesFor(pw, ph, whole)
		local list = {}
		if column then
			table.insert(list, column)
		end
		if ph > 0 then
			-- the match / party panel (a 4-player party on a landscape phone reaches the bottom band)
			local w = math.max(hasPanel and pw or 0, hasTitle and K.TITLE_W or 0)
			local box = { x0 = topLeft, y0 = K.EDGE, x1 = topLeft + w * k, y1 = K.EDGE + ph * k }
			if shadowPx > 0 and whole then
				box.x1, box.y1 = box.x1 + shadowPx, box.y1 + shadowPx
			end
			table.insert(list, box)
			if shadowPx > 0 and not whole then
				table.insert(list, { x0 = topLeft + shadowPx, y0 = K.EDGE + shadowPx, x1 = topLeft + pw * k + shadowPx, y1 = K.EDGE + ph * k + shadowPx, cardOnly = true })
			end
		end
		for _, r in ipairs(buttons) do
			table.insert(list, r)
		end
		if touch then
			for _, r in ipairs(robloxTouchRects(area, vp)) do
				table.insert(list, r)
			end
		end
		-- (U9-7 look) an open side dock: the card slides left until its right edge is OBSTACLE_GAP px from the dock's frame
		-- (its wood edge covered the HP bar's right end and the dash chip at 844x390 and touched the card at 1280x720)
		for _, r in ipairs(docks) do
			table.insert(list, r)
		end
		return list
	end
	-- (kitb-matchhud) the match card as kit-b lays it (its checkpoints in their own row): the slim layout below is decided
	-- against it, so the decision never flips with the shorter card it brings
	local topH0 = topH + ((hasPanel and Mt.Compact and Items.Match and Items.Match.Shown and compactSaving) and compactSaving() or 0)
	local obstacles = obstaclesFor(panelW, topH0, false)
	local tabUpPx = math.floor(geometry.TAB_UP * k + 0.5)
	local vitalsLeft, vitalsW
	local bottom0 = vitalsBottom
	vitalsLeft, vitalsW, vitalsBottom = placeVitals(area, k, K.VITALS_W, K.VITALS_MIN_W, vitalsH, bottom0, cx, obstacles, side, band.y1, nil, tabUpPx)
	-- (look:fix6b2 N2) a card too narrow for the player's whole name keeps only OBSTACLE_TIGHT of air where that gives the
	-- name its room (at 800 x 450 in a match / countdown it sat in the 211 px between the match panel and RUN's block edge,
	-- O3's 8 px of air + its 2 px edge on each side left it 190 px, under the 196 'SkyClimber' needs at its 14.4 px floor:
	-- 'SkyCli...', whole at e272588). Where even that leaves no room the card stays as it was
	local nameW = Vitals.WholeNameW(geometry, k)
	if math.floor(vitalsW * k) < nameW then
		local left2, w2, bottom2 = placeVitals(area, k, K.VITALS_W, K.VITALS_MIN_W, vitalsH, bottom0, cx, obstacles, side, band.y1, K.OBSTACLE_TIGHT, tabUpPx)
		if math.floor(w2 * k) >= nameW then
			vitalsLeft, vitalsW, vitalsBottom = left2, w2, bottom2
		end
	end
	vitalsW = math.floor(vitalsW * k) / k

	-- (kitb-matchhud, the owner's pick A "Slim bar" of 2026-11-27) whether a slot has its row: wholly on the screen inside
	-- the side margins, the player's whole name on it (nameNeed screen px), and every drawn obstacle (not the zone the
	-- stick's thumb roams) OBSTACLE_TIGHT of air off its ink, its wood edge counted
	local function rowClear(list, left, wPx, bottom, hPx, tabPx, nameNeed)
		if left < side - 0.5 or left + wPx > area.X - side + 0.5 or bottom > area.Y + 0.5 or bottom - hPx < -0.5 then
			return false
		end
		if nameNeed and math.floor(wPx) < nameNeed then
			return false
		end
		local g = K.OBSTACLE_TIGHT + K.VITALS_EDGE
		for _, r in ipairs(list) do
			local top = bottom - hPx + (r.cardOnly and tabPx or 0)
			if not r.soft and left < r.x1 + g - 0.5 and left + wPx > r.x0 - g + 0.5 and top < r.y1 + g - 0.5 and bottom > r.y0 - g + 0.5 then
				return false
			end
		end
		return true
	end
	-- On a touch screen in landscape, in a match / its countdown or on the party pad, where that card has no row (kit-b:
	-- at 640 x 360 .. 812 x 375 squeezed onto DASH, RUN and the jump ring, 'SkyCli...', off the right edge at 640):
	--   * in a match the card becomes the slim bar, and the match card's checkpoints move up into its clock row (a narrow
	--     card 28 design px shorter: at 640 x 360 its corner and shadow lay on RUN);
	--   * on the pad the vitals step aside while the panel shows (no damage comes on the pad; the tutorial's chip docks
	--     bottom-left there): the pitch's pad rule.
	local noRow = touch and vp.X > vp.Y and (hasPanel or inMatch)
		and not rowClear(obstacles, vitalsLeft, math.floor(vitalsW * k), vitalsBottom, vitalsH * k, tabUpPx, nameW)
	local slim = noRow and inMatch
	if setMatchCompact and setMatchCompact(slim and hasPanel) then
		hasPanel, hasTitle, topH = topLeftState()
	end
	-- (kitb-matchhud) a panel never reaches into a touch key or Roblox's jump button that shares its rows (kit-b: at 568 x 320
	-- the panel lay on RUN, DASH and the jump ring; at 640 x 360 the leader's full pad on RUN): narrower, OBSTACLE_TIGHT of
	-- air off its shadow
	if hasPanel and touch and topH > 0 then
		local inkBottom = K.EDGE + topH * k + shadowPx
		local limit = nil
		local keys = {}
		for _, r in ipairs(buttons) do
			table.insert(keys, r)
		end
		table.insert(keys, robloxTouchRects(area, vp)[2])
		for _, r in ipairs(keys) do
			if r.x0 > topLeft and r.y0 - K.OBSTACLE_TIGHT < inkBottom and r.y1 + K.OBSTACLE_TIGHT > K.EDGE then
				limit = math.min(limit or math.huge, r.x0 - K.OBSTACLE_TIGHT - shadowPx)
			end
		end
		if limit and topLeft + panelW * k > limit then
			panelW = math.max(1, math.floor((limit - topLeft) / k))
		end
	end
	if setPanelWidth then
		setPanelWidth(panelW)
		hasPanel, hasTitle, topH = topLeftState()
	end
	if slim then
		-- the slim bar: its foot SLIM_FOOT over the screen's bottom edge, between the stick's zone and RUN / the jump button,
		-- centred where it can be, under the panel and its shadow (OBSTACLE_GAP of air); with its name tag where the tag fits
		-- too and shows the whole name, else bare; where not even the bare bar has that row (568 x 320 under a two-row match
		-- card) the vitals step aside (the panel's gold 'you' chip shows the HP; DASH its cool-down)
		local slimObs = obstaclesFor(panelW, topH, true)
		local placed = nil
		for _, g in ipairs({ VG.Slim, VG.SlimBare }) do
			local P = Vitals.SlimParts(g, k)
			local h = math.floor(g.H * k + 0.5) / k
			local foot = area.Y - K.SLIM_FOOT
			local l, w, b = placeVitals(area, k, P.Pref / k, P.Min / k, h, foot, cx, slimObs, side, band.y1)
			w = math.floor(w * k) / k
			local tagNeed = g.TAB_UP > 0 and (Vitals.SlimTagW(g, k) + 2 * Vitals.Px(g.TAB_X, k)) or nil
			if math.abs(b - foot) < 0.5 and w * k >= P.Min - k - 0.5 and rowClear(slimObs, l, math.floor(w * k), b, h * k, 0, tagNeed) then
				placed = { g = g, l = l, w = w, b = b, h = h }
				break
			end
		end
		if placed then
			geometry, vitalsLeft, vitalsW, vitalsBottom, vitalsH = placed.g, placed.l, placed.w, placed.b, placed.h
		end
		noRow = placed == nil
	end
	if (S.vitalsOwners.NoRow == true) ~= (noRow == true) then
		S.vitalsOwners.NoRow = noRow or nil
		if UI.Vitals then
			UI.Vitals.Visible = next(S.vitalsOwners) == nil
		end
	end
	if setVitalsGeometry then
		setVitalsGeometry(geometry)
	end
	local vitalsTop = vitalsBottom - vitalsH * k
	-- ... and where no row beside the dock is wide enough the card steps aside while the dock is open (never half under it)
	local underDock = false
	for _, r in ipairs(docks) do
		if vitalsLeft < r.x1 and vitalsLeft + vitalsW * k > r.x0 and vitalsTop < r.y1 and vitalsBottom > r.y0 then
			underDock = true
		end
	end
	if (S.vitalsOwners.Dock == true) ~= underDock then
		S.vitalsOwners.Dock = underDock or nil
		if UI.Vitals then
			UI.Vitals.Visible = next(S.vitalsOwners) == nil
		end
	end
	if UI.Vitals then
		UI.Vitals.AnchorPoint = Vector2.new(0, 1)
		UI.Vitals.Size = UDim2.fromOffset(vitalsW, vitalsH)
		UI.VitalsW = vitalsW
		Vitals.Layout()
		UI.Vitals.Position = UDim2.new(0, math.floor(vitalsLeft + 0.5), 0, math.floor(vitalsBottom + 0.5))
	end
	vitalsRect = { X = math.floor(vitalsLeft + 0.5), Y = math.floor(vitalsBottom + 0.5) - vitalsH * k, W = vitalsW * k, H = vitalsH * k,
		TabUp = math.floor(geometry.TAB_UP * k + 0.5) } -- (P2 fix A) the name tab's band over the card's own top (Vitals.Layout's cardY)

	-- currencies: thin strips stacked top-right, right-aligned (the token strip carries the "+n" chip in a match)
	local n = math.max(1, #currencies)
	local stripW = K.STRIP_W
	for _, c in ipairs(currencies) do
		if c.Chip and inMatch then
			stripW = math.max(stripW, K.STRIP_W + K.STRIP_CHIP_W + 6)
		end
	end
	local stackH = n * K.STRIP_H + (n - 1) * K.STRIP_GAP
	local topRightBottom, topRightLeft = 0, 0
	local giftLeft, giftTop, giftSize = 0, 0, 0
	stripsBox = nil
	local mode = "TopRight"
	if UI.Currency and topBand then
		-- one row in the top band (above the gui area: the gui starts below Roblox's top bar)
		mode = "TopBand"
		local bandW = math.floor(Util.Clamp((vp.X - bandX - K.BAND_RIGHT - (n - 1) * K.STRIP_GAP * k) / n / k, K.BAND_MIN_W, stripW))
		if layoutCurrencyRows then
			layoutCurrencyRows(currencies, "Band", bandW)
		end
		UI.Currency.Parent = UI.TopRight
		UI.Currency.AnchorPoint = Vector2.new(0, 0.5)
		UI.Currency.Size = UDim2.fromOffset(n * bandW + (n - 1) * K.STRIP_GAP, K.STRIP_H)
		UI.Currency.Position = UDim2.new(0, bandX, 0, -math.max(inset, K.BAND_INSET) / 2)
		local want = next(S.currencyOwners) == nil -- (kit-b U9-2: a window with its own balances steps them aside)
		if UI.Currency.Visible ~= want then
			UI.Currency.Visible = want
		end
	elseif UI.Currency then
		local blockW, blockH = stripW, stackH
		if vp.X < vp.Y and n > 1 and not inBattle then
			-- portrait: one row, right-aligned (in a battle the narrow stack: the fighter card narrows beside it)
			local rowW = math.floor(Util.Clamp((area.X - 2 * side - (n - 1) * K.STRIP_GAP * k) / n / k, K.ROW_MIN_W, math.min(K.ROW_MAX_W, stripW)))
			blockW, blockH = n * rowW + (n - 1) * K.STRIP_GAP, K.STRIP_H
			if layoutCurrencyRows then
				layoutCurrencyRows(currencies, "Band", rowW)
			end
		elseif layoutCurrencyRows then
			layoutCurrencyRows(currencies, "Strips", stripW)
		end
		UI.Currency.Parent = UI.TopRight
		UI.Currency.AnchorPoint = Vector2.new(1, 0)
		UI.Currency.Size = UDim2.fromOffset(blockW, blockH)
		topRightLeft = area.X - side - blockW * k
		-- (kit-b gate U9 r4: on a portrait phone the strips lay over the match / party panel's Leave button) where the
		-- strips would reach over the top-left panel: in the lobby (a party) they sit under it, right-aligned as before; in
		-- a match they step aside while the panel shows (it counts the run's tokens itself; under it they pushed the
		-- result card into the middle of the screen)
		local stripTop = K.EDGE
		local overPanel = hasPanel and topRightLeft < topLeft + panelW * k + K.STRIP_GAP * k
		if overPanel and not inMatch then
			-- ((kitb-matchhud) GIFT_GAP of air under the panel's hard shadow, the strip's own wood edge counted: under the
			-- box alone the shadow lay 1.2 - 1.8 px over the strip's edge on the portrait pad)
			stripTop = math.floor(K.EDGE + topH * k + shadowPx + Vitals.Px(2, k) + K.GIFT_GAP * k + 0.5)
		end
		-- (P2 fix A, item 06 A) a card spanning a portrait phone's top band (the battle's boss strip, SetTopReserve): the
		-- strips start GIFT_GAP under it (the pitch's portrait: the strip under the boss card, beside the fighter card)
		local reserve = 0
		for _, px in pairs(S.topReserve) do
			reserve = math.max(reserve, px)
		end
		if reserve > 0 then
			stripTop = math.max(stripTop, math.floor(reserve + K.GIFT_GAP * k + 0.5))
		end
		UI.Currency.Position = UDim2.new(1, -side, 0, stripTop)
		topRightBottom = stripTop + blockH * k
		stripsBox = { Left = topRightLeft, Bottom = topRightBottom }
		-- a card that takes the corner for a moment (a dungeon run's result on a phone) hides the strips meanwhile
		local strips = { x0 = topRightLeft, y0 = stripTop, x1 = area.X - side, y1 = topRightBottom }
		local yield = cornerCard ~= nil and cornerCard.x0 < strips.x1 and strips.x0 < cornerCard.x1
			and cornerCard.y0 < strips.y1 and strips.y0 < cornerCard.y1
		local want = not yield and not (overPanel and inMatch) and next(S.currencyOwners) == nil
		if UI.Currency.Visible ~= want then
			UI.Currency.Visible = want
		end
		-- (kit-b U8) the gift's dock under the strips, in the lobby only (DailyController hides its button in a match or a
		-- battle anyway): DailyController puts its button on this square (GiftLeft / GiftTop / GiftSize), and the toasts,
		-- side panels and the tutorial start under it (TopRightBottom). While a corner card is up (a phone's dungeon End
		-- card) the gift steps aside, so the card starts right under the strips
		if not inMatch and not inBattle and cornerCard == nil then
			giftSize = math.max(K.GIFT_MIN, math.floor(K.GIFT * k)) -- (44 on a 844x390 phone, as the button was)
			giftTop = math.floor(topRightBottom + K.GIFT_GAP * k + 0.5)
			giftLeft = math.floor(area.X - side - giftSize + 0.5)
			-- (playtest 2026-11-28 C31: three strips stacked put the gift square on DASH at 640 x 360) where the square under
			-- the strips would meet a touch key (its wood edge and OBSTACLE_TIGHT of air counted), it docks left of the strips
			-- at their top, as the HUD without a dock had it (DailyController.layoutButton's fallback)
			local keys = {}
			for _, r in ipairs(buttons) do
				table.insert(keys, r)
			end
			if touch then
				table.insert(keys, robloxTouchRects(area, vp)[2])
			end
			local air = K.OBSTACLE_TIGHT + 3
			local onKey = false
			for _, r in ipairs(keys) do
				if giftLeft - air < r.x1 and r.x0 < giftLeft + giftSize + air and giftTop - air < r.y1 and r.y0 < giftTop + giftSize + air then
					onKey = true
				end
			end
			local besideLeft = math.floor(topRightLeft - K.GIFT_GAP * k - giftSize + 0.5)
			if onKey and besideLeft >= side and not (hasPanel and besideLeft < topLeft + panelW * k + K.GIFT_GAP * k and stripTop < K.EDGE + topH * k + shadowPx) then
				giftLeft, giftTop = besideLeft, stripTop
				-- (playtest 2026-11-28 C31 r2: the toasts, the tutorial's strip and the arena's side stack dock left of
				-- TopRightLeft, which still named the strips' edge, so they landed on the gift) the block's left is the gift's
				topRightLeft = giftLeft
			elseif onKey then
				-- (C31 r2: on the party pad at 640 x 360 the panel holds the row beside the strips and the square stayed on
				-- DASH) no room beside them either: the gift steps aside meanwhile (a dock of 0, as for a corner card)
				giftLeft, giftTop, giftSize = 0, 0, 0
			else
				stripsBox.Bottom = giftTop -- (Overlaps: the strips' box runs down to the gift's dock under them, as before)
			end
			topRightBottom = math.max(topRightBottom, giftTop + giftSize)
		end
	end
	S.currencyMode = mode

	setPadding("TopLeft", topLeft, K.EDGE, 0, 0, animate)
	setPadding("TopRight", 0, 0, 0, 0)
	setPadding("BottomLeft", 0, 0, 0, 0)

	-- tell the neighbours (toasts, side panels, NPC dialogs, the tutorial) where the HUD is, in gui-area pixels.
	-- BottomLeftTop keeps its name for them: the top of the HUD's bottom block, now the centred vitals card
	-- (BottomCentreTop / BottomCentreLeft / BottomCentreRight give the card's extent).
	local topW = 0
	if hasPanel then
		topW = panelW
	end
	if hasTitle then
		topW = math.max(topW, K.TITLE_W)
	end
	publish("HudScale100", k * 100)
	publish("TopLeftRight", topH > 0 and (topLeft + topW * k) or 0)
	publish("TopLeftBottom", topH > 0 and (K.EDGE + topH * k) or 0)
	publish("TopRightBottom", topRightBottom)
	publish("TopRightLeft", topRightLeft)
	publish("GiftLeft", giftLeft)
	publish("GiftTop", giftTop)
	publish("GiftSize", giftSize)
	publish("BottomLeftTop", vitalsTop)
	publish("BottomCentreTop", vitalsTop)
	-- (P2 fix A) the card's own top edge under its name tab (Vitals.Layout's cardY): what docks beside the card lines up
	-- with it (the mouse-lock plank), BottomCentreTop being the tab's top
	publish("BottomCentreCardTop", vitalsTop + math.floor(geometry.TAB_UP * k + 0.5))
	publish("BottomCentreLeft", vitalsLeft)
	publish("BottomCentreRight", vitalsLeft + vitalsW * k)
	if UI.Gui:GetAttribute("CurrencyMode") ~= mode then
		UI.Gui:SetAttribute("CurrencyMode", mode)
	end
end

local function relayout()
	local k = currentScale()
	for i = #scalers, 1, -1 do
		local s = scalers[i]
		if s.Parent then
			s.Scale = k
		else
			table.remove(scalers, i)
		end
	end
	applyMargins(false, true)
end

-- Layout numbers of the match / party panels (design px, 1080p). (kit-b U9-8 A, the owner's pick "Stone signboard":
-- .superpowers/slop-audit/round3/build/U9-8/pitch_match_party.py, its numbers) a stone card in the vitals card's tier (a
-- 3 px wood edge, a 5 px lip), 10 px inside the edge, the rows 6 px apart and 8 px above the lip; the small blocks (the
-- level badge, the chips, the tokens tile, Leave, Change) a 2 px wood edge on a 4 px lip. A block's size here is its whole
-- visible box, the wood included. Text is 18+ everywhere, so it stays >= 14 px on a phone. One Leave plank for both cards
-- (kit-b U9-8 minors): on a PC the match card's 84x34; touch devices get a thumb target for Leave and for the leader's
-- Change (56 tall: >= 44 px on screen at the 0.8 phone scale; the party's Leave is a locked portal's only way out)
local function panelMetrics(touch)
	local m = {
		Edge = 3, Lip = 5, Pad = 10, Below = 8, -- the card
		BlockEdge = 2, BlockLip = 4, -- a small block
		Badge = 34, BadgeText = 20, NameGap = 8, NameText = 22, -- the level badge, then the name and its stars in ink
		RowGap = 6,
		-- the match card. Row A: the badge, the level, Leave. Row B: the clock, (wide) the checkpoints, the tokens tile.
		-- (narrow) row C: the checkpoints. Then the members, 8 px under the rows
		LeaveW = 84, LeaveH = 34, LeaveText = 18,
		TimerH = 34, TimerText = 32, CountText = 42,
		TokensH = 34, TokensText = 20, TokensPad = 10,
		CpX = 96, CpH = 22, CpText = 18, CpBlockW = 26, CpBlockGap = 4, CpBlockLip = 3,
		-- (kitb-matchhud look0 N1) the blocks' floor at that gap; where the floor overflows the bar, the gap closes to
		-- CpGapTight, then the blocks narrow down to CpBlockThin on a 1 px wood edge (PK.BlockFit)
		CpBlockMin = 10, CpGapTight = 2, CpBlockThin = 5,
		TeamGap = 8, ChipH = 48, ChipGap = 6, ChipText = 18, StateText = 18, HpH = 10,
		Wide = 480, -- a card this wide or wider puts the checkpoints in row B (the pitch's 1920 card)
		-- the party card. Row A: the obby's gold icon square, the title, the big red Leave. Row B: the countdown after the
		-- clock, the head count after the people. The members. Row D: the level badge, its name and stars, the leader's
		-- Change (a sky plank); an older portal's party: the lock hint
		IconText = 18, TitleText = 24,
		PartyLeaveW = 84, PartyLeaveH = 34, PartyLeaveText = 18, -- (the match card's Leave)
		StatusH = 26, StatusText = 20, CountW = 80, PartyChipH = 36,
		LevelRowH = 34, HintText = 18, ChangeW = 96, ChangeH = 34, ChangeText = 18,
	}
	if touch then
		-- a thumb target (44.8 px tall on screen at the 0.8 phone scale), one plank for both cards
		m.LeaveW, m.LeaveH, m.LeaveText = 100, 56, 24
		m.PartyLeaveW, m.PartyLeaveH, m.PartyLeaveText = m.LeaveW, m.LeaveH, m.LeaveText
		m.ChangeW, m.ChangeH, m.ChangeText = 100, 56, 22 -- the leader's Change (34 was 27 px on a phone)
	end
	-- (a CloudUI plank's size is its frame, the frame the tests measure; its wood edge draws outside it)
	m.Inset = m.Edge + m.Pad -- the rows' frame inside the card ...
	m.Bottom = m.Below + m.Lip + m.Edge -- ... and what the card keeps under them
	m.RowA = math.max(m.Badge, m.LeaveH + 2 * m.BlockEdge)
	m.TimerY = m.RowA + m.RowGap
	m.PartyRowA = math.max(m.Badge, m.PartyLeaveH + 2 * m.BlockEdge)
	m.StatusY = m.PartyRowA + m.RowGap
	m.PlayersY = m.StatusY + m.StatusH + m.RowGap
	m.LevelRowH = math.max(m.LevelRowH, m.ChangeH + 2 * m.BlockEdge)
	return m
end

----------------------------------------------------------------------
-- Default CoreGui (the health bar)
----------------------------------------------------------------------
-- (lobby-shop review round 3) Roblox's player list stays on: spec 16.6, the owner's "make it be seen also in the players
-- server list", is its Rank column (leaderstats.Rank: Top 10 / Top 100 / Creator). It was hidden since 2026-10-08 because the
-- Tokens column sat over our top-right token strip; the strips stay where they are (an open owner question, spec 16.11).
local HIDDEN_CORE = { Enum.CoreGuiType.Health }

-- Separate pcalls so a failure on one does not skip the other.
local function hideDefaultCoreGui()
	local allOk = true
	for _, coreType in ipairs(HIDDEN_CORE) do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(coreType, false)
		end)
		allOk = allOk and ok
	end
	return allOk
end

local function disableDefaultHealth()
	task.spawn(function()
		for _ = 1, 60 do
			if hideDefaultCoreGui() then
				task.wait(3) -- the core scripts may re-enable them while loading: apply once more
				hideDefaultCoreGui()
				return
			end
			task.wait(0.5)
		end
	end)
	pcall(function()
		track(StarterGui.CoreGuiChangedSignal:Connect(function(coreType, enabled)
			if enabled and coreType == Enum.CoreGuiType.Health then
				pcall(function()
					StarterGui:SetCoreGuiEnabled(coreType, false)
				end)
			end
		end))
	end)
end

----------------------------------------------------------------------
-- Build: vitals card (bottom-left)
----------------------------------------------------------------------
-- One card (kit-b U8: the pitch's .vit, a stone card in a wood edge on its lip): the heart badge beside the HP bar and its
-- number ("117 / 117"; white damage trail, hit flash + card shake, low-health pulse); the lightning badge beside the
-- stamina bar (eases on drain / refill, dims when run dry); the dash key (pressed with a rising charge while the dash
-- recharges). (U9-8 look) Both bars are rows of kit B blocks (Vitals.NewBlocks) and every part sits on whole screen px
-- (Vitals.Layout). Shapes are Frames (no font glyphs, no images); the geometry is VG.Regular / VG.Compact.

-- (U9-8 look) n design px as whole SCREEN px under the scale k: round(n x k), never under 1 px for a part that has a size
-- (the rule PixelIcon uses for its cells). The card lives under the HUD's UIScale (0.8 on phones and on a 1280x720
-- window): a 2 px block edge placed in design px drew 1.6 px there, soft in a render and 1 or 2 px in Roblox by where it
-- fell. Vitals.Layout works in screen px and hands Roblox each value divided by k
function Vitals.Px(n, k)
	if n <= 0 then
		return 0
	end
	return math.max(1, math.floor(n * k + 0.5))
end

-- (U9-8 look) where a PixelIcon goes (design px, its parent's coordinates) so its drawn cells sit centred on whole screen
-- px in a box of w x h screen px under the scale k (PixelIcon draws whole-px cells centred on its own box, which is not
-- whole under 0.8: an 18 px icon's box is 14.4 px and its cells 18)
function Vitals.IconAt(icon, w, h, k)
	local px = icon.Size.X.Offset
	local cell = math.floor(px / 9)
	local screenCell = tonumber(icon:GetAttribute("CellPx")) or math.max(1, math.min(cell, 2), math.floor(cell * k + 0.5))
	local drawn = 9 * screenCell
	local pad = math.floor((px * k - drawn) / 2)
	return UDim2.fromOffset((math.floor((w - drawn) / 2) - pad) / k, (math.floor((h - drawn) / 2) - pad) / k)
end

-- (kit-b U9-8; U9-8 look: the owner's look bar, every bar in the BlockRow language) a bar of opts.Count equal kit B blocks
-- built like SignKit.BlockRow: a wood block, its face (the stone well) inset by the edge, the lit part from the left in
-- whole px in the role's colour on its darker lip (a Frame, no gradient), the pitch's .seg / .seg.off. Each block is a
-- 1 / Count share of the bar. opts: Count, Face / Lip (the lit colours), Trail (a white Trail under the lit part: the HP's
-- damage trail on the blocks that just went out), Flash (a white Flash over the lit part: the hit and the low-health
-- breath). bar.Layout(w, h, k) places the blocks for a row w x h SCREEN px under the scale k (equal blocks, whole px);
-- bar.SetFraction(f) lights f of the bar, bar.SetTrail(f) the trail, bar.SetFlash(t) the flash's transparency,
-- bar.SetColor(face, lip) the lit colours
function Vitals.NewBlocks(parent, name, opts)
	local n = math.max(1, math.floor(tonumber(opts.Count) or 4))
	local root = newFrame(parent, name, { ZIndex = 2 })
	local bar = { Root = root, Blocks = {}, Count = n, Shown = -1, ShownTrail = -1, K = 1, Flashed = -1 }
	for i = 1, n do
		local block = newFrame(root, "Block" .. i, { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Wood, ZIndex = 2 })
		local face = newFrame(block, "Face", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Well, ZIndex = 2 })
		local trail = nil
		if opts.Trail then
			trail = newFrame(face, "Trail", {
				BackgroundTransparency = 0.04,
				BackgroundColor3 = WHITE,
				Size = UDim2.new(0, 0, 1, 0),
				Visible = false,
				ZIndex = 3,
			})
		end
		local lit = newFrame(face, "Lit", {
			BackgroundTransparency = 0,
			BackgroundColor3 = opts.Face,
			Size = UDim2.new(0, 0, 1, 0),
			Visible = false,
			ZIndex = 4,
		})
		local lip = newFrame(lit, "Lip", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			BackgroundTransparency = 0,
			BackgroundColor3 = opts.Lip,
			ZIndex = 4,
		})
		local flash = nil
		if opts.Flash then
			flash = newFrame(lit, "Flash", {
				BackgroundTransparency = 1,
				BackgroundColor3 = WHITE,
				Size = UDim2.fromScale(1, 1),
				ZIndex = 5,
			})
		end
		bar.Blocks[i] = { Block = block, Face = face, Lit = lit, Lip = lip, Trail = trail, Flash = flash, FaceW = 0 }
	end
	-- n equal blocks across w screen px (what does not divide by n is left at the row's right end, under n px)
	function bar.Layout(w, h, k)
		local e, lipPx, gap = Vitals.Px(VG.BLOCK_EDGE, k), Vitals.Px(VG.BLOCK_LIP, k), Vitals.Px(VG.BLOCK_GAP, k)
		local bw = math.max(2 * e + 1, math.floor((w - (n - 1) * gap) / n))
		for i, b in ipairs(bar.Blocks) do
			b.Block.Position = UDim2.fromOffset((i - 1) * (bw + gap) / k, 0)
			b.Block.Size = UDim2.fromOffset(bw / k, h / k)
			b.Face.Position = UDim2.fromOffset(e / k, e / k)
			b.Face.Size = UDim2.new(1, -2 * e / k, 1, -2 * e / k)
			b.Lip.Size = UDim2.new(1, 0, 0, math.min(lipPx, h - 2 * e - 1) / k)
			b.FaceW = bw - 2 * e
		end
		bar.K = k
		bar.Shown, bar.ShownTrail = -1, -1
	end
	-- each block lit by its share of `value`, from its left in whole screen px
	local function light(value, field)
		for i, b in ipairs(bar.Blocks) do
			local part = b[field]
			if part then
				local px = math.floor(Util.Clamp(value * n - (i - 1), 0, 1) * b.FaceW + 0.5)
				part.Visible = px > 0
				part.Size = UDim2.new(0, px / bar.K, 1, 0)
			end
		end
	end
	function bar.SetFraction(value)
		value = Util.Clamp(tonumber(value) or 0, 0, 1)
		if value ~= bar.Shown then
			bar.Shown = value
			light(value, "Lit")
		end
	end
	function bar.SetTrail(value)
		value = Util.Clamp(tonumber(value) or 0, 0, 1)
		if value ~= bar.ShownTrail then
			bar.ShownTrail = value
			light(value, "Trail")
		end
	end
	function bar.SetFlash(transparency)
		if transparency ~= bar.Flashed then
			bar.Flashed = transparency
			for _, b in ipairs(bar.Blocks) do
				if b.Flash then
					b.Flash.BackgroundTransparency = transparency
				end
			end
		end
	end
	function bar.SetColor(face, lip)
		for _, b in ipairs(bar.Blocks) do
			b.Lit.BackgroundColor3 = face
			b.Lip.BackgroundColor3 = lip
		end
	end
	function bar.Invalidate()
		bar.Shown, bar.ShownTrail = -1, -1
	end
	return bar
end

-- (U9-8 look) the HP number's box (design px at `size`): the widest the number gets for this max health (its digits as
-- 0s, the widest digit, over the max), so the blocks keep their width while the number changes. (DOWNED takes the
-- whole row: Vitals.Layout)
function Vitals.NumberW(size)
	local max = tostring(math.max(1, math.ceil((H.Max or 100) - 0.001)))
	local ok, m = pcall(Theme.Measure, string.rep("0", #max) .. " / " .. max, "Display", size)
	return (ok and m and m.X > 0) and m.X or size * 4.2
end

-- (U9-8 look) a badge on whole screen px: `size` design px square, centred on (BADGE_X, cy); its edge, lip and icon by
-- Vitals.FitBadge
-- (Pitch 2 item 08 C) cx / cy: the badge's centre in SCREEN px of its parent
function Vitals.PlaceBadge(badge, size, cx, cy, g, k)
	local s = Vitals.Px(size, k)
	local x = math.floor(cx - s / 2 + 0.5)
	local y = math.floor(cy - s / 2 + 0.5)
	badge.Position = UDim2.fromOffset((x + s / 2) / k, (y + s / 2) / k) -- (anchored at its centre: the heart beats there)
	badge.Size = UDim2.fromOffset(s / k, s / k)
	Vitals.FitBadge(badge, g, s, k)
end

-- (Pitch 2 item 08 C) the player's first letter (one UTF-8 character, capital) and the stamp's kit colour (UserId % 5)
function Vitals.StampOf()
	local name = (player and (player.DisplayName ~= "" and player.DisplayName or player.Name)) or "?"
	local letter = string.match(tostring(name), "^[%z\1-\127\194-\244][\128-\191]*") or "?"
	local pick = VG.STAMPS[((player and tonumber(player.UserId) or 0) % 5) + 1]
	return letter:upper(), Theme.Sign[pick[1]], Theme.Sign[pick[2]]
end

-- (Pitch 2 item 08 C) the trophies the tag shows: Theme.Short of Battle.Trophies (State), "0" before the first sync
function Vitals.TrophyText()
	local n = 0
	if State and type(State.Battle) == "function" then
		local ok, b = pcall(State.Battle)
		if ok and type(b) == "table" then
			n = tonumber(b.Trophies) or 0
		end
	end
	return Theme.Short(math.max(0, math.floor(n)))
end

-- (Pitch 2 item 08 C) a text's width in screen px at `size` design px under the scale k
local function measureAt(text, role, size, k)
	local ok, m = pcall(Theme.Measure, text, role, size)
	-- (never under FredokaOne's ~0.56 em a letter: a flat measure runs short of the drawn face; then 4% to spare, the
	-- render's overflow report)
	local w = math.max((ok and m and m.X > 0) and m.X or 0, #tostring(text) * size * 0.56)
	return math.ceil(w * 1.04 * k)
end

-- the name the vitals card's tab shows (the display name, else the user name)
function Vitals.FullName()
	return (player and (player.DisplayName ~= "" and player.DisplayName or player.Name)) or ""
end

-- (look:fix6b2 N2) the tab's parts beside the name, in screen px under the scale k: fixed (the stamp, the gaps, the
-- trophies tag), the tag's width, its number's width, and the name's floor size (design px). LayoutTab lays them out;
-- WholeNameW asks how wide the card must be for the whole name
function Vitals.TabParts(g, k)
	local function px(n)
		return Vitals.Px(n, k)
	end
	local numW = measureAt(Vitals.TrophyText(), "Display", g.TROPHY_TEXT, k)
	local trW = px(8) + px(18) + px(5) + numW + px(9)
	local fixed = px(5) + px(g.STAMP) + px(8) + px(10) + trW + px(6)
	return fixed, trW, numW, math.max(g.NAME_MIN, math.ceil(14 / k - 1e-6))
end

-- (look:fix6b2 N2) the card's width (screen px) that shows the player's name whole at its floor size: LayoutTab cuts it
-- when the tab's room (the card less TAB_X a side, less the fixed parts) is narrower than the name there
function Vitals.WholeNameW(g, k)
	local fixed, _, _, minSize = Vitals.TabParts(g, k)
	return 2 * Vitals.Px(g.TAB_X, k) + fixed + measureAt(Vitals.FullName(), "Heading", minSize, k)
end

-- (Pitch 2 item 08 C) the wood name tab over the card's top edge: the stamp, the name (its design size steps down to the
-- floor, then the name is cut with "..." so it always fits whole), the trophies tag at the tab's right end; the tab as wide
-- as its contents, never wider than the card less TAB_X on each side. W: the slot's width in screen px
function Vitals.LayoutTab(g, k, W)
	local T = UI.Tab
	if not T then
		return
	end
	local function px(n)
		return Vitals.Px(n, k)
	end
	local letter, face, lip = Vitals.StampOf()
	T.Letter.Text = letter
	T.Stamp.BackgroundColor3 = face
	T.StampLip.BackgroundColor3 = lip
	T.Letter.TextColor3 = select(2, Theme.ReadableFace(face, 4.5))
	local tabX, tabH = px(g.TAB_X), px(g.TAB_H)
	local up = px(g.TAB_UP)
	local stampS = px(g.STAMP)
	local edge2 = px(2)
	-- the trophies tag: [8][icon 18][5][number][9]
	T.Value.Text = Vitals.TrophyText()
	T.Value.TextSize = g.TROPHY_TEXT
	local iconS = px(18)
	local fixed, trW, numW, minSize = Vitals.TabParts(g, k)
	local trH = px(g.TROPHY_H)
	-- the name: as wide as it needs, in the room the tab leaves
	local maxTab = W - 2 * tabX
	local room = maxTab - fixed
	local full = Vitals.FullName()
	local size, text = g.NAME_TEXT, full
	while size > minSize and measureAt(text, "Heading", size, k) > room do
		size = size - 2
	end
	size = math.max(size, minSize)
	if measureAt(text, "Heading", size, k) > room then
		local cut = full
		while #cut > 1 and measureAt(cut .. "...", "Heading", size, k) > room do
			cut = cut:sub(1, -2)
			-- (never end on half a UTF-8 character)
			while #cut > 1 and string.byte(cut, #cut) >= 128 and string.byte(cut, #cut) < 192 do
				cut = cut:sub(1, -2)
			end
		end
		text = cut .. "..."
	end
	T.Name.Text = text
	T.Name.TextSize = size
	local nameW = math.min(room, measureAt(text, "Heading", size, k) + px(2))
	local tabW = math.min(maxTab, fixed + nameW)
	T.Root.Position = UDim2.fromOffset(tabX / k, 0)
	T.Root.Size = UDim2.fromOffset(tabW / k, tabH / k)
	T.Edge.Thickness = edge2 / k
	T.Light.Position = UDim2.fromOffset(0, 0)
	T.Light.Size = UDim2.new(1, 0, 0, 1 / k)
	-- the stamp: 5 in, 4 down; its lip 3, its edge 2
	T.Stamp.Position = UDim2.fromOffset(px(5) / k, px(4) / k)
	T.Stamp.Size = UDim2.fromOffset(stampS / k, stampS / k)
	T.StampEdge.Thickness = edge2 / k
	T.StampLip.Size = UDim2.new(1, 0, 0, px(3) / k)
	T.Letter.Size = UDim2.new(1, 0, 1, -px(3) / k)
	T.Letter.TextSize = g.STAMP_TEXT
	-- the name, centred on the tab's shown height (above the card's top)
	local nameX = px(5) + stampS + px(8)
	T.Name.Position = UDim2.fromOffset(nameX / k, 0)
	T.Name.Size = UDim2.fromOffset(nameW / k, (up - px(2)) / k)
	-- the trophies tag at the tab's right end, 6 down
	local trX = tabW - px(6) - trW
	T.Trophies.Position = UDim2.fromOffset(trX / k, px(6) / k)
	T.Trophies.Size = UDim2.fromOffset(trW / k, trH / k)
	T.TrophyEdge.Thickness = edge2 / k
	T.TrophyLip.Size = UDim2.new(1, 0, 0, px(3) / k)
	local ip = Vitals.IconAt(T.Icon, iconS, trH - px(3), k)
	T.Icon.Position = UDim2.fromOffset(ip.X.Offset + px(8) / k, ip.Y.Offset)
	T.Value.Position = UDim2.fromOffset((px(8) + iconS + px(5)) / k, 0)
	T.Value.Size = UDim2.fromOffset((numW + px(4)) / k, (trH - px(3)) / k)
	UI.TabSig = text .. "|" .. T.Value.Text .. "|" .. letter
	T.Stamp.Visible, T.Trophies.Visible, T.Root.Visible = true, true, true
end

-- (kitb-matchhud, pick A "Slim bar") the slim bar's parts in screen px under the scale k: the stamina well's width (GroupW:
-- its edge, pad, the bolt, the blocks ST_BLOCK wide, pad, edge), DOWNED's box at the HP text size with 10 px of air (DownW:
-- the notice beside it keeps the rest of the row), and the bar's
-- width with its HP blocks HP_BLOCK wide (Pref) or HP_BLOCK_MIN wide (Min): the heart's column (TRACK_X), the HP track
-- (edge, pad, the blocks, pad, divider, pad, the number's box, pad, edge: Vitals.Layout's track), GROUP_GAP, the well, PAD_R
function Vitals.SlimParts(g, k)
	local function px(n)
		return Vitals.Px(n, k)
	end
	local e, pad, gap = px(VG.TRACK_EDGE), px(VG.TRACK_PAD), Vitals.Px(VG.BLOCK_GAP, k)
	local hpText = math.max(g.HP_TEXT, math.ceil(18 / k - 1e-6))
	local numW = math.ceil((Vitals.NumberW(hpText) + 16) * k)
	local nS = (UI.StBar and #UI.StBar.Blocks) or 4
	local edge1 = 2 * Vitals.Px(VG.BLOCK_EDGE, k) + 1
	local stCell = math.max(edge1, px(g.ST_BLOCK))
	local groupW = e + pad + px(g.BADGE_ICON) + px(6) + nS * stCell + (nS - 1) * gap + pad + e
	local nH = VG.HP_BLOCKS
	local function width(cell)
		local track = 2 * e + 4 * pad + px(VG.DIVIDER) + numW + nH * math.max(edge1, cell) + (nH - 1) * gap
		return px(g.TRACK_X) + track + px(g.GROUP_GAP) + groupW + px(g.PAD_R)
	end
	-- (DOWNED is all capitals: ~0.76 em a letter in the Display face, over measureAt's 0.56 floor - the render drew it 83.5
	-- px wide at 18.4 px, 5.5 px past a box measured at the floor)
	local downW = math.max(measureAt("DOWNED", "Display", hpText, k), math.ceil(6 * hpText * 0.78 * k))
	return { GroupW = groupW, DownW = downW + px(10),
		Pref = width(px(g.HP_BLOCK)), Min = width(px(g.HP_BLOCK_MIN)) }
end

-- (kitb-matchhud, pick A) the slim bar's name tag: the card's wood tab (Vitals.LayoutTab's), the name alone - no stamp, no
-- trophies - TAB_X in from the bar's left, TAB_UP over its top, as wide as the whole name (applyMargins shows the tag only
-- where the whole name fits: never a cut name); the bare bar (TAB_UP 0) hides it
function Vitals.SlimTagW(g, k)
	return 2 * Vitals.Px(g.TAB_PAD, k) + measureAt(Vitals.FullName(), "Heading", math.max(g.NAME_MIN, math.ceil(14 / k - 1e-6)), k) + Vitals.Px(2, k)
end

function Vitals.LayoutSlimTab(g, k, W)
	local T = UI.Tab
	if not T then
		return
	end
	T.Stamp.Visible, T.Trophies.Visible = false, false
	T.Root.Visible = g.TAB_UP > 0
	if g.TAB_UP <= 0 then
		UI.TabSig = "-"
		return
	end
	local function px(n)
		return Vitals.Px(n, k)
	end
	local size = math.max(g.NAME_TEXT, g.NAME_MIN, math.ceil(14 / k - 1e-6))
	local text = Vitals.FullName()
	local nameW = measureAt(text, "Heading", size, k) + px(2)
	local tabX, padX = px(g.TAB_X), px(g.TAB_PAD)
	local tabW = math.min(W - 2 * tabX, nameW + 2 * padX)
	T.Name.Text = text
	T.Name.TextSize = size
	T.Root.Position = UDim2.fromOffset(tabX / k, 0)
	T.Root.Size = UDim2.fromOffset(tabW / k, px(g.TAB_H) / k)
	T.Edge.Thickness = px(2) / k
	T.Light.Position = UDim2.fromOffset(0, 0)
	T.Light.Size = UDim2.new(1, 0, 0, 1 / k)
	T.Name.Position = UDim2.fromOffset(padX / k, 0)
	T.Name.Size = UDim2.fromOffset((tabW - 2 * padX) / k, (px(g.TAB_UP) - px(2)) / k)
	UI.TabSig = text
end

-- (kit-b U9-8; U9-8 look) places every part of the vitals card on whole screen px for its geometry (UI.VitalsGeometry),
-- its width (UI.VitalsW, design px) and its scale; a no-op when none of them changed (force: always). The card's own
-- size is snapped by the layout (applyMargins), so its corner is a whole screen px and every part here is a whole number
-- of screen px from it: the card's edge and lip, the HP blocks and the number's box, the stamina blocks ending KEY_GAP
-- before the dash key, the key, the two badges
function Vitals.Layout(force)
	local g = UI.VitalsGeometry
	if not g or not UI.HpBar or not UI.StBar or not UI.Key or not UI.Card or not UI.HpTrack then
		return
	end
	local k = (UI.VitalsScale and UI.VitalsScale.Scale) or 1
	if k <= 0 then
		k = 1
	end
	local function px(n)
		return Vitals.Px(n, k)
	end
	local function at(v)
		return math.floor(v * k + 0.5)
	end
	local W = px(UI.VitalsW or K.VITALS_W)
	-- (the number's box: its widest for this max health, centred behind the divider, the pitch's 16 px of air)
	-- (the pitch's 18 px, never under 18 screen px: 23 design px under a 0.8 scale, the phone's readability rule)
	local hpText = math.max(g.HP_TEXT, math.ceil(18 / k - 1e-6))
	local numW = math.ceil((Vitals.NumberW(hpText) + 16) * k)
	-- (kit-b gate U9 r4) on a touch screen the dash key is gone: the touch DASH button is the dash there, and the '>>' key
	-- at the stamina row's end read as a second button; the stamina blocks show the charges
	local keyOn = not isTouchDevice()
	local tabSig = (player and player.DisplayName or "") .. "|" .. Vitals.TrophyText()
	local sig = g.Name .. ":" .. W .. ":" .. k .. ":" .. numW .. ":" .. tostring(S.downed) .. ":" .. tostring(keyOn) .. ":" .. tabSig
	if UI.LayoutSig == sig and not force then
		return
	end
	UI.LayoutSig = sig
	-- (Pitch 2 item 08 C) the tab over the card's top edge, then the card under it: its height, its wood edge and its lip
	local cardY = at(g.TAB_UP)
	if g.Slim then
		Vitals.LayoutSlimTab(g, k, W)
	else
		Vitals.LayoutTab(g, k, W)
	end
	UI.Card.Position = UDim2.fromOffset(0, cardY / k)
	UI.Card.Size = UDim2.new(1, 0, 0, px(g.CARD_H) / k)
	UI.CardStroke.Thickness = px(VG.CARD_EDGE) / k
	UI.CardLip.Size = UDim2.new(1, 0, 0, px(VG.CARD_LIP) / k)
	local e, pad, gapPx = px(VG.TRACK_EDGE), px(VG.TRACK_PAD), Vitals.Px(VG.BLOCK_GAP, k)
	local trackX = at(g.TRACK_X)
	local trackW = W - px(g.PAD_R) - trackX
	-- the HP track's and the stamina group's rows: the card's two rows, (kitb-matchhud) or the slim bar's one row with the
	-- HP track (its blocks take what the row leaves) and the stamina well side by side GROUP_GAP apart
	local hpY, hpH = cardY + at(g.HP_Y or g.ROW_Y), px(g.HP_H or g.ROW_H)
	local stY, stH = cardY + at(g.ST_Y or g.ROW_Y), px(g.ST_H or g.ROW_H)
	local hpTrackW, stX0, stW0 = trackW, trackX, trackW
	if g.Slim then
		local P = Vitals.SlimParts(g, k)
		stW0 = P.GroupW
		if S.downed then
			-- (downed: DOWNED takes the HP track, as wide as the word; the notice takes the rest of the row)
			stW0 = math.max(P.GroupW, trackW - px(g.GROUP_GAP) - (2 * e + 2 * pad + P.DownW))
		end
		hpTrackW = trackW - px(g.GROUP_GAP) - stW0
		stX0 = trackX + hpTrackW + px(g.GROUP_GAP)
	end
	-- the HP track: one sunk well in its wood edge; the blocks, the 2 px divider and the number on the same face
	trackW = hpTrackW
	UI.HpTrack.Position = UDim2.fromOffset(trackX / k, hpY / k)
	UI.HpTrack.Size = UDim2.fromOffset(trackW / k, hpH / k)
	UI.HpFace.Position = UDim2.fromOffset(e / k, e / k)
	UI.HpFace.Size = UDim2.fromOffset((trackW - 2 * e) / k, (hpH - 2 * e) / k)
	local innerL, innerR = e + pad, trackW - e - pad
	local numX = innerR - numW
	local divX = numX - pad - px(VG.DIVIDER)
	UI.HpDivider.Position = UDim2.fromOffset(divX / k, e / k)
	UI.HpDivider.Size = UDim2.fromOffset(px(VG.DIVIDER) / k, (hpH - 2 * e) / k)
	UI.HpDivider.Visible = not S.downed
	local nH = #UI.HpBar.Blocks
	local bh = hpH - 2 * (e + pad)
	local cellW = math.max(2 * Vitals.Px(VG.BLOCK_EDGE, k) + 1, math.floor((divX - pad - innerL - (nH - 1) * gapPx) / nH))
	local hpW = nH * cellW + (nH - 1) * gapPx
	UI.VitalsCell = cellW
	UI.HpBar.Root.Position = UDim2.fromOffset(innerL / k, (e + pad) / k)
	UI.HpBar.Root.Size = UDim2.fromOffset(hpW / k, bh / k)
	UI.HpBar.Layout(hpW, bh, k)
	UI.HpBar.Root.Visible = not S.downed
	-- (downed: DOWNED takes the whole track, beside the heart's "!")
	local numL = S.downed and innerL or numX
	UI.HpNum.Position = UDim2.fromOffset(numL / k, e / k)
	UI.HpNum.Size = UDim2.fromOffset((innerR - numL) / k, (hpH - 2 * e) / k)
	-- ((kitb-matchhud) the slim bar's DOWNED centred in its own track, the number box's air round it: SlimParts' DownW)
	UI.HpNum.TextXAlignment = (S.downed and not g.Slim) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
	UI.HpNum.TextSize = hpText
	-- the stamina group: one sunk well (the well edge) with the bolt, the blocks, the dash state and the dash key
	UI.StGroup.Position = UDim2.fromOffset(stX0 / k, stY / k)
	UI.StGroup.Size = UDim2.fromOffset(stW0 / k, stH / k)
	UI.StFace.Position = UDim2.fromOffset(e / k, e / k)
	UI.StFace.Size = UDim2.fromOffset((stW0 - 2 * e) / k, (stH - 2 * e) / k)
	local key = UI.Key
	local keyS = math.min(px(g.KEY), stH - 2 * e)
	local keyX = stW0 - e - keyS
	key.Root.Position = UDim2.fromOffset(keyX / k, e / k)
	key.Root.Size = UDim2.fromOffset(keyS / k, keyS / k)
	key.Edge.Thickness = px(VG.KEY_EDGE) / k
	local lip = px(VG.KEY_LIP)
	key.Px = { K = k, Size = keyS, Lip = lip, Sink = math.min(px(VG.KEY_SINK), lip - 1), Step = (key.Icon and tonumber(key.Icon:GetAttribute("CellPx"))) or px(g.KEY_STEP) }
	key.Root.Visible = keyOn and not S.downed
	local nS = #UI.StBar.Blocks
	local stX = innerL + px(g.BADGE_ICON) + px(6)
	local sh = stH - 2 * (e + pad)
	local right = keyOn and (keyX - px(4)) or (stW0 - e - pad)
	local stCell = math.max(2 * Vitals.Px(VG.BLOCK_EDGE, k) + 1, px(g.ST_BLOCK))
	local stW = math.min(right - stX, nS * stCell + (nS - 1) * gapPx)
	UI.StBar.Root.Position = UDim2.fromOffset(stX / k, (e + pad) / k)
	UI.StBar.Root.Size = UDim2.fromOffset(stW / k, sh / k)
	UI.StBar.Layout(stW, sh, k)
	-- the dash's state after the blocks, where it fits whole
	local lx = stX + stW + px(8)
	-- (each state's longest word that fits whole: the full set, then the short, then the tiny one; the label is left-aligned
	-- after the blocks, so a shorter word moves nothing. None fits even the tiny set: no words)
	local words = {}
	for _, state in ipairs({ "ready", "cool", "off" }) do
		for _, set in ipairs({ VG.DASH_WORDS, VG.DASH_WORDS_SHORT, VG.DASH_WORDS_TINY }) do
			if not words[state] and right - lx >= measureAt(set[state], "Heading", g.ST_TEXT, k) + px(2) then
				words[state] = set[state]
			end
		end
	end
	if g.Slim or not (words.ready and words.cool and words.off) then
		words = nil -- ((kitb-matchhud) the slim bar has no dash words: the touch DASH key shows its own cool-down)
	end
	UI.DashWords = words or VG.DASH_WORDS
	UI.DashText.TextSize = g.ST_TEXT
	UI.DashText.Position = UDim2.fromOffset(lx / k, e / k)
	UI.DashText.Size = UDim2.fromOffset(math.max(0, right - lx) / k, (stH - 2 * e) / k)
	UI.DashText.Visible = not S.downed and words ~= nil
	local shownWord = UI.DashWords[UI.Key.State or "ready"]
	if shownWord and UI.DashText.Text ~= shownWord then
		UI.DashText.Text = shownWord
	end
	-- the badges: the bare heart left of the HP track, the bare bolt at the group's left end; then the key's look again
	Vitals.PlaceBadge(UI.Heart, g.HEART, at(g.HEART_X) + px(g.BADGE_ICON) / 2, hpY + hpH / 2, g, k)
	Vitals.PlaceBadge(UI.Bolt.Badge, g.BOLT, innerL + px(g.BADGE_ICON) / 2, stH / 2, g, k)
	if g.Slim then
		-- ((kitb-matchhud) the notice that replaces the stamina row while downed: over the slim bar's widened well)
		UI.DownedNotice.Position = UDim2.fromOffset((stX0 + e) / k, (stY + e) / k)
		UI.DownedNotice.Size = UDim2.fromOffset(math.max(0, stW0 - 2 * e) / k, math.max(0, stH - 2 * e) / k)
	end
	Vitals.PaintKey(key.State or "ready", St.Charge)
	St.DimDrawn = -1
end

-- the vitals card's edge (kit-b U8: the wood edge of kit B; the HP fill already shows green / amber / red): wood, the sign
-- red while low or downed
function Vitals.BorderColor()
	if S.downed or H.Target <= K.LOW_HEALTH then
		return Theme.Sign.Red
	end
	return Theme.Sign.Wood
end

function Vitals.PaintBorder()
	if UI.CardStroke then
		local c = Vitals.BorderColor()
		UI.CardStroke.Color = c
		UI.CardGlow.Color = c
	end
end

function Vitals.SetShapeTransparency(box, transparency)
	for _, part in ipairs(box:GetChildren()) do
		if part:IsA("GuiObject") then
			part.BackgroundTransparency = transparency
		end
	end
end

-- (kit-b U9-8) the dash key (was the sky sweep ring around a gold face): a kit B keycap with the pixel dash, the pitch's
-- .key. Block (the tile face in its wood edge), its Lip along the bottom, the Charge (the sky rising from the bottom of the
-- face while the dash cools down) and the Icon (drawn by setVitalsGeometry at the geometry's KEY_ICON). Vitals.PaintKey
-- sets its state; (U9-8 look) Vitals.Layout its sizes in whole screen px (key.Px)
function Vitals.NewDashKey(parent)
	local key = newFrame(parent, "DashKey", { ZIndex = 3 })
	local block = newFrame(key, "Block", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.Tile,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
	})
	local edge = Theme.Stroke(block, Theme.Sign.Wood, 2, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	local lip = newFrame(block, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, VG.KEY_LIP),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.StoneLip,
		ZIndex = 3,
	})
	local charge = newFrame(block, "Charge", {
		AnchorPoint = Vector2.new(0, 1),
		BackgroundTransparency = 0,
		BackgroundColor3 = VS.Charge,
		Visible = false,
		ZIndex = 3,
	})
	return { Root = key, Block = block, Edge = edge, Lip = lip, Charge = charge, Icon = nil, IconPx = 0, State = nil }
end

-- the key's look: "ready" raised on its lip, the tile face, the brown icon; "cool" pressed onto its lip (the face drops
-- KEY_SINK px, the lip thins to what is left, the bottom stays), the well face, the sky charge `charge` (0..1) of the
-- face high from its bottom in whole steps of the icon's cell, the icon muted; "off" (no dash to pay for) pressed, the
-- Off block (well face and lip), the icon muted and faded, no charge. (U9-8 look) every size in whole screen px (key.Px)
function Vitals.PaintKey(state, charge)
	local key = UI.Key
	local m = key and key.Px
	if not m then
		return
	end
	local Sign = Theme.Sign
	local k = m.K
	local sink = (state == "ready") and 0 or m.Sink
	local lipPx = m.Lip - sink
	key.Block.Position = UDim2.fromOffset(0, sink / k)
	key.Block.Size = UDim2.new(1, 0, 1, -sink / k)
	key.Lip.Size = UDim2.new(1, 0, 0, lipPx / k)
	key.Block.BackgroundColor3 = (state == "ready") and Sign.Tile or Sign.Well
	key.Lip.BackgroundColor3 = (state == "ready") and Sign.StoneLip or ((state == "off") and Sign.Well or Sign.WellEdge)
	local faceH = m.Size - sink - lipPx
	local step = math.max(1, m.Step)
	local px = (state == "cool") and math.floor(Util.Clamp(charge or 0, 0, 1) * faceH / step) * step or 0
	key.Charge.Visible = px > 0
	key.Charge.Position = UDim2.new(0, 0, 1, -lipPx / k)
	key.Charge.Size = UDim2.new(1, 0, 0, px / k)
	if key.Icon then
		key.Icon.Position = Vitals.IconAt(key.Icon, m.Size, faceH, k)
		local ink = (state == "ready") and Sign.Text or Sign.TextMuted
		local fade = (state == "off") and 0.35 or 0
		for _, cell in ipairs(key.Icon:GetChildren()) do
			if cell:IsA("GuiObject") then
				cell.BackgroundColor3 = ink
				cell.BackgroundTransparency = fade
			end
		end
	end
	key.State = state
end

-- (kit-b U9-8) a vitals badge (was a glossy square with a rotated-part shape): a kit B square in its role's colour, its
-- darker lip along the bottom, the pixel icon (attribute Icon, in attribute Ink) centred on the face above the lip.
-- (U9-8 look) attribute BareInk: the icon's colour when the geometry draws it bare (VG BARE: no square, no lip)
function Vitals.NewBadge(parent, name, color, lipColor, icon, bareInk)
	local badge = Vitals.SignSquare(parent, name, VG.Regular.BOLT, color)
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	local lip = newFrame(badge, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = lipColor,
	})
	badge:SetAttribute("Icon", icon)
	badge:SetAttribute("BareInk", bareInk)
	return badge, lip
end

-- dresses a badge for geometry g at s x s screen px under the scale k: the square, its edge and lip in whole px (or bare:
-- the icon alone), the icon (re)drawn at g's BADGE_ICON in its ink, its cells centred on whole px above the lip
function Vitals.FitBadge(badge, g, s, k)
	local bare = g.BARE == true
	local lipS = bare and 0 or Vitals.Px(g.BADGE_LIP, k)
	badge.BackgroundTransparency = bare and 1 or 0
	local edge = badge:FindFirstChild("SignEdge")
	if edge then
		edge.Enabled = not bare
		edge.Thickness = Vitals.Px(VG.BADGE_EDGE, k) / k
	end
	local lip = badge:FindFirstChild("Lip")
	if lip then
		lip.Visible = not bare
		lip.Size = UDim2.new(1, 0, 0, lipS / k)
	end
	local ink = (bare and badge:GetAttribute("BareInk")) or badge:GetAttribute("Ink") or Theme.Sign.Text
	local icon = badge:FindFirstChild("Icon")
	if not icon or icon.Size.X.Offset ~= g.BADGE_ICON then
		if icon then
			icon:Destroy()
		end
		icon = PixelIcon.New(badge, badge:GetAttribute("Icon"), g.BADGE_ICON, ink)
		icon.ZIndex = badge.ZIndex
	end
	for _, cell in ipairs(icon:GetChildren()) do
		if cell:IsA("GuiObject") then
			cell.BackgroundColor3 = ink
		end
	end
	icon.Position = Vitals.IconAt(icon, s, s - lipS, k)
	icon.Visible = not (badge == UI.Heart and S.downed)
	if badge == UI.Heart then
		UI.HeartIcon = icon
		if UI.HeartGlyph then
			UI.HeartGlyph.TextColor3 = bare and Theme.Sign.RedLip or WHITE -- (the "!" while downed: white on the red square)
		end
	elseif UI.Bolt and badge == UI.Bolt.Badge then
		UI.Bolt.Icon = icon
		St.DimDrawn = -1 -- (a redrawn bolt repaints its dim)
	end
end

-- Puts the card on one geometry (VG.Regular or VG.Compact) and places its parts (Vitals.Layout); a no-op when unchanged.
setVitalsGeometry = function(g)
	if UI.VitalsGeometry == g or not UI.HpBar then
		return
	end
	UI.VitalsGeometry = g
	UI.CardCorner.CornerRadius = UDim.new(0, g.CARD_CORNER)
	UI.RimCorner.CornerRadius = UDim.new(0, math.max(0, g.CARD_CORNER - 2))
	UI.GlowCorner.CornerRadius = UDim.new(0, g.CARD_CORNER + 3)
	local key = UI.Key
	if key.IconPx ~= g.KEY_ICON then
		if key.Icon then
			key.Icon:Destroy()
		end
		key.Icon = PixelIcon.New(key.Block, "dash", g.KEY_ICON, Theme.Sign.Text)
		key.Icon.ZIndex = 4
		key.IconPx = g.KEY_ICON
	end
	UI.HeartGlyph.TextSize = g.HEART_TEXT
	-- (Pitch 2 item 08 C) the notice takes the stamina group's place
	UI.DownedNotice.Position = UDim2.fromOffset(g.TRACK_X, g.TAB_UP + (g.ST_Y or g.ROW_Y))
	UI.DownedNotice.Size = UDim2.new(1, -(g.TRACK_X + g.PAD_R), 0, g.ST_H or g.ROW_H)
	Vitals.Layout(true)
end

-- (Pitch 2 item 08 C) a kit B block (Frame) with its 2 px edge and its lip along the bottom: { Root, Edge, Lip }
local function tabBlock(parent, name, face, lip, edge, zindex)
	local root = newFrame(parent, name, { BackgroundTransparency = 0, BackgroundColor3 = face, ZIndex = zindex })
	local stroke = Theme.Stroke(root, edge, 2, 0)
	stroke.Name = "SignEdge"
	stroke.LineJoinMode = Enum.LineJoinMode.Miter
	local l = newFrame(root, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 3),
		BackgroundTransparency = 0,
		BackgroundColor3 = lip,
		ZIndex = zindex,
	})
	return root, stroke, l
end

-- (Pitch 2 item 08 C) the wood name tab (drawn behind the card: ZIndex 0 under the card's 1): its lit top line, the stamp
-- (the letter on its kit-colour block), the name in the stone colour, the trophies tag (the pixel trophy, the number)
local function buildNameTab(body)
	local T = {}
	local tab = newFrame(body, "NameTab", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Wood, ZIndex = 0 })
	T.Root = tab
	T.Edge = Theme.Stroke(tab, Theme.Sign.WoodDark, 2, 0)
	T.Edge.Name = "SignEdge"
	T.Edge.LineJoinMode = Enum.LineJoinMode.Miter
	T.Light = newFrame(tab, "Light", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.WoodLight, ZIndex = 0 })
	T.Stamp, T.StampEdge, T.StampLip = tabBlock(tab, "Stamp", Theme.Sign.Sky, Theme.Sign.SkyLip, Theme.Sign.WoodDark, 0)
	T.Letter = newText(T.Stamp, "Letter", "?", "Display", 26, Theme.Sign.Text, { TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 0 })
	T.Name = newText(tab, "PlayerName", "", "Heading", 20, Theme.Sign.Stone, { ZIndex = 0 })
	T.Trophies, T.TrophyEdge, T.TrophyLip = tabBlock(tab, "Trophies", Theme.Sign.Tile, Theme.Sign.StoneLip, Theme.Sign.WoodDark, 0)
	T.Icon = PixelIcon.New(T.Trophies, "trophy", 18, Theme.Sign.GoldLip)
	T.Icon.ZIndex = 0
	T.Value = newText(T.Trophies, "Value", "0", "Display", 18, Theme.Sign.Text, { ZIndex = 0 })
	UI.Tab = T
	return T
end

local function buildVitals(holder)
	local root = newFrame(holder, "Vitals", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, K.EDGE, 1, -K.EDGE),
		Size = UDim2.fromOffset(K.VITALS_W, K.VITALS_H),
	})
	UI.VitalsScale = addViewportScale(root) -- (U9-8 look) Vitals.Layout reads it: the card is laid out in its screen px
	root.Visible = next(S.vitalsOwners) == nil -- (a window that asked it to step aside: HudController.SetVitalsHidden)
	UI.Vitals = root
	-- the layout owns the root's position; the damage shake nudges this full-size body instead
	local body = newFrame(root, "Body", { Size = UDim2.fromScale(1, 1) })
	UI.VitalsBody = body

	-- (kit-b U8: the pitch's .vit) the stone card in a wood edge, square, its darker lip along the bottom; the old glow ring
	-- and rim stay as hidden frames (the layout still sizes their corners)
	local card = newFrame(body, "Card", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.Stone,
	})
	UI.Card = card
	UI.CardCorner = Theme.Corner(card, "None")
	UI.CardStroke = Theme.Stroke(card, Theme.Sign.Wood, VG.CARD_EDGE, 0)
	UI.CardStroke.LineJoinMode = Enum.LineJoinMode.Miter
	UI.CardLip = newFrame(card, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, VG.CARD_LIP),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.StoneLip,
	})
	local glow = newFrame(card, "Glow", {
		Position = UDim2.fromOffset(-3, -3),
		Size = UDim2.new(1, 6, 1, 6),
		Visible = false,
	})
	UI.GlowCorner = Theme.Corner(glow, "None")
	UI.CardGlow = Theme.Stroke(glow, Theme.Sign.Wood, 5, 1)
	local rim = newFrame(card, "Rim", {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
		Visible = false,
	})
	UI.RimCorner = Theme.Corner(rim, "None")

	-- (U9-8 look) the HP bar: kit B blocks in the sign red on its RedLip lip (was a tube with a gradient lip and the number
	-- drawn three times over it), the white damage trail and the hit flash on the blocks; the number right of them on the
	-- stone. Then (kit-b U9-8) the stamina blocks, one per dash from full (MaxStamina / DashStaminaCost, rounded down; each
	-- an equal share of MaxStamina: U9-8 look, the narrow fifth block for the rest is gone), ending left of the dash key
	-- (Pitch 2 item 08 C) the name tab behind the card's top edge; the HP track (a wood-edged sunk well: the blocks, the
	-- divider and the number on one face) and the stamina group (a sunk well in the well edge: the bolt, the blocks, the
	-- dash's state and the dash key)
	buildNameTab(body)
	UI.HpTrack = newFrame(body, "HpTrack", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Wood, ZIndex = 2 })
	UI.HpFace = newFrame(UI.HpTrack, "Face", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Well, ZIndex = 2 })
	UI.HpDivider = newFrame(UI.HpTrack, "Divider", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.WellEdge, ZIndex = 3 })
	UI.StGroup = newFrame(body, "StaminaGroup", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.WellEdge, ZIndex = 2 })
	UI.StFace = newFrame(UI.StGroup, "Face", { BackgroundTransparency = 0, BackgroundColor3 = Theme.Sign.Well, ZIndex = 2 })
	UI.HpBar = Vitals.NewBlocks(UI.HpTrack, "HealthBar", { Count = VG.HP_BLOCKS, Face = VS.Hp, Lip = Theme.Sign.RedLip, Trail = true, Flash = true })
	UI.HpBar.Root.ZIndex = 3
	UI.HpNum = newText(UI.HpTrack, "HealthNumber", "100 / 100", "Display", VG.Regular.HP_TEXT, Theme.TextOn("Stone"), {
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 3,
	})
	local physics = Config.Physics or {}
	local dashes = math.floor((tonumber(physics.MaxStamina) or 150) / math.max(1, tonumber(physics.DashStaminaCost) or 35))
	UI.StBar = Vitals.NewBlocks(UI.StGroup, "StaminaBar", { Count = math.max(1, dashes), Face = VS.Stamina, Lip = Theme.Sign.GoldLip })
	UI.StBar.Root.ZIndex = 3
	UI.Key = Vitals.NewDashKey(UI.StGroup)
	UI.DashText = newText(UI.StGroup, "DashState", "Dash ready", "Heading", 18, Theme.Sign.TextMuted, { ZIndex = 3 })

	-- lightning badge (in the stamina group), then the heart badge (left of the HP track); (Pitch 2 item 08 C) both bare
	-- pixel icons in their role's lip colour, as the pitch draws them
	local bolt, boltLip = Vitals.NewBadge(UI.StGroup, "StaminaBadge", VS.Stamina, Theme.Sign.GoldLip, "bolt", Theme.Sign.GoldLip)
	bolt:SetAttribute("Ink", VS.BoltInk)
	bolt.ZIndex = 5
	boltLip.ZIndex = 5
	UI.Bolt = { Badge = bolt, Lip = boltLip }

	local heart, heartLip = Vitals.NewBadge(body, "Heart", Theme.Sign.Red, Theme.Sign.RedLip, "heart", Theme.Sign.RedLip)
	heart:SetAttribute("Ink", WHITE)
	heart.ZIndex = 6
	heartLip.ZIndex = 6
	UI.HeartScale = newScale(heart, 1)
	UI.HeartScale.Name = "Pulse" -- (a beat, not a layout scale: PixelIcon keeps the icon's cells as they are)
	UI.Heart = heart
	UI.HeartGlyph = newText(heart, "Glyph", "!", "Display", 34, WHITE, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Visible = false,
		ZIndex = 4,
	})

	-- "Wait for a teammate!" replaces the stamina row while downed (no running or dashing then anyway)
	UI.DownedNotice = newText(body, "DownedNotice", "Wait for a teammate!", "Display", 21, Colors.Bad, {
		TextXAlignment = Enum.TextXAlignment.Center,
		TextScaled = true,
		Visible = false,
		ZIndex = 5,
	})
	Util.Create("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 18, Parent = UI.DownedNotice })
	setVitalsGeometry(VG.Regular)
end

----------------------------------------------------------------------
-- Build: currency stack (bottom-left above the vitals, or top-right on short screens)
----------------------------------------------------------------------
local function buildCurrencyRow(parent, entry)
	local def = entry.Def or {}
	local color = def.Color or Colors.Token
	local row = newFrame(parent, "Currency_" .. entry.Id, {
		Size = UDim2.fromOffset(K.STRIP_W, K.STRIP_H),
		Visible = false,
	})

	-- (kit-b U8: the pitch's .cs) one stone block: the tile face, a wood edge, its darker lip along the bottom; the coin is a
	-- square in the currency's colour inside its left end (.ci), the amount in brown. No neon, no sheen, no corner
	local neon = Theme.NeonColor(entry.Neon or "Gold")
	local body = newFrame(row, "Body", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.Tile,
		Size = UDim2.fromScale(1, 1),
	})
	local bodyStroke = Theme.Stroke(body, Theme.Sign.Wood, 2, 0)
	bodyStroke.Name = "SignEdge"
	bodyStroke.LineJoinMode = Enum.LineJoinMode.Miter
	local lip = newFrame(body, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.StoneLip,
	})

	local coin, setGem
	if entry.Id == "Gems" then
		-- lobby-shop Task 15 (spec 5.7): the drawn cut gem (client/UI/GemIcon) at coin size; (kit-b U8) on a square of sign
		-- navy, so the cyan gem never sits on a cyan block; setRowGeometry rebuilds the gem whenever the coin changes size
		coin = Vitals.SignSquare(row, "Coin", K.COIN, Theme.Sign.Navy)
		setGem = function(px)
			local old = coin:FindFirstChild("GemIcon")
			if old then
				old:Destroy()
			end
			local gem = require(Client:WaitForChild("UI"):WaitForChild("GemIcon")).New(coin, px, { ZIndex = 2 })
			gem.AnchorPoint = Vector2.new(0.5, 0.5)
			gem.Position = UDim2.fromScale(0.5, 0.5)
		end
		setGem(K.COIN)
	else
		-- the coin square in the currency's own colour (Cash the grass green, Tokens gold), its PixelIcon in the ink that reads
		coin = Vitals.SignSquare(row, "Coin", K.COIN, color)
		local glyph = def.Icon or def.Glyph or "?"
		local icon = PixelIcon.Bitmaps[glyph] and glyph or nil
		local label = newText(coin, "Glyph", icon and "" or glyph, "Display", 30, Theme.TextOn(color), {
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 4,
		})
		if icon then
			setCoinIcon(label, icon, 30)
		end
	end
	coin.AnchorPoint = Vector2.new(0, 0.5)
	coin.Position = UDim2.new(0, 4, 0.5, -2)
	coin.ZIndex = 3

	local amount = newText(row, "Amount", "0", "Display", 32, Theme.Sign.Text, {
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 3,
	})

	local c = {
		Id = entry.Id, Def = def, Attr = entry.Attr, Always = entry.Always == true,
		Row = row, Body = body, Lip = lip, Coin = coin, CoinGlyph = coin:FindFirstChild("Glyph"), SetGem = setGem,
		Neon = neon, Stroke = bodyStroke,
		Amount = amount, AmountScale = newScale(amount, 1), CoinScale = newScale(coin, 1),
		Target = 0, Display = 0, Shown = nil, Seen = false, Available = false, ChipShown = false,
		Width = K.STRIP_W, Compact = nil,
	}

	if entry.Run then
		-- (kit-b U8) the "+n" match chip: a small gold block with brown text in a wood edge
		local chip = newFrame(row, "RunChip", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -7, 0.5, 0),
			Size = UDim2.fromOffset(K.CHIP_W, 32),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Sign.Gold,
			Visible = false,
			ZIndex = 4,
		})
		local chipEdge = Theme.Stroke(chip, Theme.Sign.Wood, 2, 0)
		chipEdge.LineJoinMode = Enum.LineJoinMode.Miter
		c.Chip = chip
		c.RunLabel = newText(chip, "Run", "+0", "Accent", 21, Theme.Sign.Text, {
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 5,
		})
		c.RunScale = newScale(c.RunLabel, 1)
	end
	return c
end

-- Coin size of a row for its geometry: a full pill has the big coin, a compact (paired / top band) one a smaller
-- coin, a strip (bug batch 2 #1: the thin top-right strips) the smallest.
local function coinSizeOf(c)
	if c.Compact == "Strip" then
		return K.STRIP_COIN
	end
	return c.Compact and K.COIN_COMPACT or K.COIN
end

-- Inner geometry of one pill (`compact`: false = full pill, true = compact pill, "Strip" = thin strip).
local function setRowGeometry(c, compact)
	if c.Compact == compact then
		return
	end
	c.Compact = compact
	local strip = compact == "Strip"
	local coinSize = coinSizeOf(c)
	c.Coin.Size = UDim2.fromOffset(coinSize, coinSize)
	if c.CoinGlyph then
		c.CoinGlyph.TextSize = strip and 19 or (compact and 24 or 30)
		local icon = c.CoinGlyph:GetAttribute("PixelIcon")
		if icon then
			setCoinIcon(c.CoinGlyph, icon, c.CoinGlyph.TextSize)
		end
	end
	if c.SetGem then
		c.SetGem(coinSize)
	end
	if c.Chip then
		c.Chip.Size = strip and UDim2.fromOffset(K.STRIP_CHIP_W, K.STRIP_CHIP_H) or UDim2.fromOffset(K.CHIP_W, 32)
		c.Chip.Position = UDim2.new(1, strip and -4 or -7, 0.5, 0)
		c.RunLabel.TextSize = strip and 18 or 21
	end
	-- (kit-b U8) the block spans the row; the coin square sits inside its left end, the amount after it. (LOOK-ui) The HUD's
	-- one edge token: a 3 px wood edge and a 5 px lip at 1080p, whole screen px below it (2 and 4 at 720p), as the vitals card
	-- and the Gift tile: the strip's 1.6 px edge sat right on the Gift's 3 px one
	c.Lip.Size = UDim2.new(1, 0, 0, 5)
	PixelIcon.WholeHeight(c.Lip, 5)
	c.Amount.Position = UDim2.new(0, 4 + coinSize + (strip and 6 or 8), 0.5, -2)
	if c.Stroke then
		PixelIcon.WholeStroke(c.Stroke, 3)
	end
end

local function buildCurrency(holder)
	local root = newFrame(holder, "Currency", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -K.EDGE, 0, K.EDGE),
		Size = UDim2.fromOffset(K.STRIP_W, K.STRIP_H),
	})
	addViewportScale(root)
	UI.Currency = root
	for _, entry in ipairs(CURRENCY_ORDER) do
		if entry.Attr ~= nil or entry.Always then
			Cur[entry.Id] = buildCurrencyRow(root, entry)
		end
	end
end

----------------------------------------------------------------------
-- Build: the match / party cards' parts (kit-b U9-8 A, the owner's pick "Stone signboard")
----------------------------------------------------------------------
-- PK: the cards' kit B parts and their layout (one table keeps the chunk's locals down). A small block is a Frame painted
-- by CloudUI.SignBlock (face, a mitred wood edge drawn outside it, a lip along its bottom; whole screen px): PK.Place puts
-- its visible box, the edge included, at x, y, w, h (the pitch's numbers)
local PK = {}
local SIGN = Theme.Sign

function PK.Paint(f, face, lip, edge, ink)
	CloudUI.SignBlock(f, { Face = face, Lip = lip, Edge = edge, Text = ink or SIGN.Text }, { EdgePx = M.BlockEdge, LipPx = M.BlockLip, Pad = false })
end

function PK.Block(parent, name, face, lip, edge)
	local f = newFrame(parent, name, { BackgroundTransparency = 0, BackgroundColor3 = face })
	PK.Paint(f, face, lip, edge)
	return f
end

-- (the edge as drawn: whole screen px under the card's scale)
function PK.EdgeW()
	return SignKit.Px(M.BlockEdge, currentScale())
end

function PK.Place(f, x, y, w, h)
	local e = PK.EdgeW()
	f.Position = UDim2.fromOffset(x + e, y + e)
	f.Size = UDim2.fromOffset(math.max(1, w - 2 * e), math.max(1, h - 2 * e))
end

-- the card: the wood frame, the stone body inset by the edge with its StoneLip lip (SignKit Frame + Body: whole screen
-- px), the rows' frame (Content.Inner) over it. Returns { Root, Content, Inner }. Its screen-factor UIScale comes first, so
-- every edge and lip under it is fitted to whole px from the start
function PK.Card(holder, name)
	local root = newFrame(holder, name, { Size = UDim2.fromOffset(S.panelW, 200) })
	addViewportScale(root)
	local wood = SignKit.Frame(root, {})
	wood.Active = false -- the HUD never swallows camera drags
	SignKit.Body(wood, { Inset = M.Edge, Lip = M.Lip })
	local content = newFrame(root, "Content", { Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	local inner = newFrame(content, "Inner", {
		Position = UDim2.fromOffset(M.Inset, M.Inset),
		Size = UDim2.new(1, -2 * M.Inset, 1, -(M.Inset + M.Bottom)),
	})
	return { Root = root, Content = content, Inner = inner }
end

-- a kit B plank (CloudUI's Sign skin: its .Text and its Callback stay the button's own) at the panels' 2 / 4 weight
function PK.Plank(parent, name, text, style, w, h, size, callback)
	local b = CloudUI.Button({
		Name = name,
		Text = text,
		Style = style,
		Skin = "Sign",
		TextSize = size,
		Size = UDim2.fromOffset(w, h),
		AnchorPoint = Vector2.new(1, 0.5),
		Callback = callback,
		Parent = parent,
	})
	b:SetAttribute("EdgePx", M.BlockEdge)
	b:SetAttribute("LipPx", M.BlockLip)
	return b
end

-- a level's colour as the picker paints its numbered tile: lightened until its ink reads 4.6:1 (ObbyController's H.readable)
function PK.Readable(color)
	for _ = 1, 6 do
		if Theme.Contrast(Theme.TextOn(color), color) >= 4.6 then
			break
		end
		color = Theme.Lighten(color, 0.08)
	end
	return color
end

-- a level's number: its place in the Sky Obby's list (the picker's tiles), else in Config.Difficulties
function PK.LevelNumber(id)
	local mod = Shared:FindFirstChild("ObbyLevels")
	if mod then
		local ok, OL = pcall(require, mod)
		if ok and type(OL) == "table" and type(OL.IndexOf) == "function" then
			local okI, i = pcall(OL.IndexOf, id)
			if okI and type(i) == "number" then
				return i
			end
		end
	end
	for i, d in ipairs(Config.Difficulties or {}) do
		if d.Id == id then
			return i
		end
	end
	return nil
end

-- the one level badge (the picker's numbered square in the level's colour, a 2 px wood edge, its lip)
function PK.Badge(parent)
	local b = PK.Block(parent, "Badge", SIGN.Sky, SIGN.SkyLip, SIGN.Wood)
	newText(b, "Num", "", "Title", M.BadgeText, SIGN.Text, {
		Size = UDim2.new(1, 0, 1, -M.BlockLip),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	return b
end

function PK.PaintBadge(b, number, color)
	local face = PK.Readable(typeof(color) == "Color3" and color or SIGN.Sky)
	local ink = Theme.TextOn(face)
	PK.Paint(b, face, Theme.Darken(face, 0.22), SIGN.Wood, ink)
	b.Num.Text = number and tostring(number) or "?"
	b.Num.TextColor3 = ink
end

-- the level's name in ink with its gold-lip stars after it (PixelIcon.Lead, the room kept inside the label).
-- ((kitb-matchhud) `px`: the stars' size, K.STAR_PX or the smaller K.STAR_PX_MIN PK.FitName steps down to; nil keeps the
-- label's)
function PK.Stars(label, n, px)
	n = math.max(0, math.min(5, math.floor(tonumber(n) or 0)))
	px = px or label:GetAttribute("StarPx") or K.STAR_PX
	if label:GetAttribute("Stars") == n and label:GetAttribute("StarPx") == px then
		return
	end
	label:SetAttribute("Stars", n)
	label:SetAttribute("StarPx", px)
	local old = label:FindFirstChild("TrailIcon")
	if old then
		old:Destroy()
	end
	if n > 0 then
		PixelIcon.Lead(label, "star", { After = true, Count = n, Px = px, Gap = M.NameGap, Room = true, Colour = SIGN.GoldLip })
	end
end

-- the design px the stars take after a name's text: their drawn box (a phone's 0.8 keeps 2 px cells, so an 18 px star
-- takes 22.5 design px there) and the gap
function PK.StarsW(label)
	local trail = label:FindFirstChild("TrailIcon")
	return trail and (trail.Size.X.Offset + M.NameGap) or 0
end

-- the level's name at the largest of 22 / 20 / 18 px that fits beside its stars in `room` design px (it cuts with "..."
-- below that)
function PK.FitName(label, room)
	-- (the engine's laid-out width over the measure at the current size: a face that runs wider than Theme.Measure says
	-- is fitted by what it draws)
	local m0 = PK.TextW(label.Text, "Heading", label.TextSize)
	local factor = (m0 > 0) and math.max(1, PK.LabelW(label, "Heading") / m0) or 1
	local n = label:GetAttribute("Stars") or 0
	-- (kitb-matchhud) the full-size stars where the name fits beside them at 22 / 20 / 18 px; else (a panel narrowed off
	-- the touch keys: 'Extr...' at 640 x 360 on the leader's pad) the smaller stars (K.STAR_PX_MIN) before the name cuts.
	-- The full-size stars' width: measured, or while the small ones show twice their box (a full-size cell never draws
	-- more than twice a small one's screen px), so the choice never flips between two fits
	local fullW = PK.StarsW(label)
	local trail = label:FindFirstChild("TrailIcon")
	if trail and label:GetAttribute("StarPx") == K.STAR_PX_MIN then
		fullW = 2 * trail.Size.X.Offset + M.NameGap
	end
	local size = nil
	for _, s in ipairs({ M.NameText, 20, 18 }) do
		if PK.TextW(label.Text, "Heading", s) * factor + 4 <= room - fullW then
			size = s
			break
		end
	end
	local starPx = (size == nil and n > 0) and K.STAR_PX_MIN or K.STAR_PX
	size = size or 18
	if (label:GetAttribute("StarPx") or K.STAR_PX) ~= starPx then
		PK.Stars(label, n, starPx)
	end
	if label.TextSize ~= size then
		label.TextSize = size
		-- the stars placed anew after the smaller name (not where the cut one ended)
		label:SetAttribute("Stars", nil)
		PK.Stars(label, n, starPx)
	end
end

-- the match card's name room: between the badge and Leave (design px)
function PK.MatchNameW()
	return (S.panelW - 2 * M.Inset) - (M.Badge + M.NameGap + M.LeaveW + 2 * PK.EdgeW() + 8) -- (innerWidth is declared below)
end

-- the countdown's pop (1.12x from its left edge) stops short of the head count: the status box is that much narrower
PK.STATUS_POP = 1.12
function PK.StatusW()
	return math.floor(((S.panelW - 2 * M.Inset) - (M.CountW + 8)) / PK.STATUS_POP)
end

-- the party card's level room: between the badge and Change (the leader's) or the card's edge
function PK.LevelRoom()
	return (S.panelW - 2 * M.Inset) - (M.Badge + M.NameGap) - (Pt.Leader and (M.ChangeW + 2 * PK.EdgeW() + 8) or 0)
end

-- a level name re-fits once the engine has laid it out (its TextBounds): the stars stay after the whole name
function PK.RefitOnLayout(label, room)
	local last = nil
	track(label:GetPropertyChangedSignal("TextBounds"):Connect(function()
		local w = label.TextBounds.X
		if w ~= last then
			last = w
			guard("level name fit", function()
				PK.FitName(label, room())
			end)
		end
	end))
end

function PK.Wide()
	return S.panelW >= M.Wide
end

function PK.TextW(text, role, size)
	local ok, m = pcall(Theme.Measure, tostring(text or ""), role, size)
	return (ok and typeof(m) == "Vector2") and math.ceil(m.X) or math.ceil(#tostring(text or "") * size * 0.6)
end

-- a label's text width in its own design px: the wider of Theme.Measure and what the engine laid out (TextBounds: screen
-- px under every UIScale above it, a pop included), so a box sized from it never cuts the text
function PK.LabelW(label, role)
	local w = PK.TextW(label.Text, role, label.TextSize)
	local s, cur = 1, label
	while cur and not cur:IsA("LayerCollector") do
		for _, c in ipairs(cur:GetChildren()) do
			if c:IsA("UIScale") and c.Scale > 0 then
				s = s * c.Scale
			end
		end
		cur = cur.Parent
	end
	local b = label.TextBounds.X
	if b > 0 and s > 0 then
		w = math.max(w, math.ceil(b / s))
	end
	return w
end

----------------------------------------------------------------------
-- Build: team / party chips (shared by the match and party panels)
----------------------------------------------------------------------
-- A member's chip (a small stone block, 2 px wood edge, 4 px lip): the name in ink, cut with "..." where it is long; in a
-- match a state mark (a pixel tick when finished, a pixel x when fallen) and the health: a one-block bar (a well in its
-- wood edge, the red lit part on its RedLip lip, whole px: Vitals.NewBlocks). PK.PaintChip gives it its look: my own chip
-- gold, a fallen one faded (the well, muted ink)
local function newChip(parent, index, withHealth)
	local frame = PK.Block(parent, "Chip" .. tostring(index), SIGN.Tile, SIGN.StoneLip, SIGN.Wood)
	frame.LayoutOrder = index
	frame.Visible = false
	local name = newText(frame, "Name", "", "Heading", M.ChipText, SIGN.Text, {
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local state = newText(frame, "State", "", "Heading", M.StateText, SIGN.RedLip, {
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		Visible = withHealth == true,
	})
	local hp = nil
	if withHealth then
		hp = Vitals.NewBlocks(frame, "Health", { Count = 1, Face = SIGN.Red, Lip = SIGN.RedLip })
	end
	return { Frame = frame, Name = name, State = state, Hp = hp, Health = withHealth == true, Frac = 1 }
end

function PK.PaintChip(chip, isMe, down)
	local face, lip, edge = SIGN.Tile, SIGN.StoneLip, SIGN.Wood
	if down then
		face, lip, edge = SIGN.Well, SIGN.Well, SIGN.WellEdge
	elseif isMe then
		face, lip = SIGN.Gold, SIGN.GoldLip
	end
	local key = tostring(isMe) .. tostring(down)
	if chip.Look ~= key then
		chip.Look = key
		PK.Paint(chip.Frame, face, lip, edge)
	end
	chip.Name.TextColor3 = down and SIGN.TextMuted or SIGN.Text
end

-- the parts inside a chip w x h design px (its visible box), on whole screen px under the panel's scale
function PK.LayChip(chip, w, h)
	local e, lip = PK.EdgeW(), M.BlockLip
	local fw, fh = w - 2 * e, h - 2 * e -- the frame's own px (the wood is drawn outside it)
	-- (the name gets the mark's room too while there is no mark)
	local mark = (chip.Health and chip.State:GetAttribute("PixelIcon") ~= nil) and (M.StateText + 8) or 0
	if chip.Health then
		chip.Name.Position = UDim2.fromOffset(8, 0)
		chip.Name.Size = UDim2.new(1, -(16 + mark), 0, 26)
		chip.State.Position = UDim2.new(1, -6, 0, 0)
		chip.State.Size = UDim2.fromOffset(M.StateText + 4, 26)
		local k = currentScale()
		local tw = fw - 12
		chip.Hp.Root.Position = UDim2.fromOffset(6, 26)
		chip.Hp.Root.Size = UDim2.fromOffset(tw, M.HpH)
		chip.Hp.Layout(Vitals.Px(tw, k), Vitals.Px(M.HpH, k), k)
		chip.Hp.SetFraction(chip.Frac or 0)
	else
		chip.Name.Position = UDim2.fromOffset(8, 0)
		chip.Name.Size = UDim2.new(1, -16, 1, -lip)
	end
	chip.Frame.Size = UDim2.fromOffset(fw, fh)
end

-- Lays out `count` chips two to a row (one when alone) inside a holder `width` wide, `h` tall each, 6 px apart. Returns
-- the row count.
local function layoutChips(chips, count, width, h)
	local cols = (count >= 2) and 2 or 1
	local gap = M.ChipGap
	local cellW = math.floor((width - gap * (cols - 1)) / cols)
	local rows = math.max(1, math.ceil(count / cols))
	for i, chip in ipairs(chips) do
		if i <= count then
			local col = (i - 1) % cols
			local row = math.floor((i - 1) / cols)
			PK.Place(chip.Frame, col * (cellW + gap), row * (h + gap), cellW, h)
			PK.LayChip(chip, cellW, h)
			chip.Frame.Visible = true
		else
			chip.Frame.Visible = false
		end
	end
	return rows
end

-- inner width of the match / party panels (the card less its edge and padding on both sides)
local function innerWidth()
	return S.panelW - 2 * M.Inset
end

----------------------------------------------------------------------
-- Build: match panel (top-left)
----------------------------------------------------------------------
local function buildMatch(holder)
	local panel = PK.Card(holder, "MatchPanel")
	UI.Match = panel
	Items.Match = newItem(panel.Root, UDim2.new(-1.5, 0, 0, 0))
	local inner = panel.Inner
	UI.MatchInner = inner

	-- row A: the level badge, the level's name and stars, Leave
	UI.MatchBadge = PK.Badge(inner)
	UI.MatchTitle = newText(inner, "Difficulty", "", "Heading", M.NameText, SIGN.Text, {
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	PK.RefitOnLayout(UI.MatchTitle, PK.MatchNameW)
	UI.LeaveBtn = PK.Plank(inner, "LeaveMatch", "Leave", "Pink", M.LeaveW, M.LeaveH, M.LeaveText, function(button)
		HudController._onLeaveMatch(button)
	end)

	-- row B: the clock / countdown numerals (left), the run's tokens on a stone tile (right)
	UI.Timer = newText(inner, "Timer", "0:00", "Display", M.TimerText, SIGN.Text, {
		AnchorPoint = Vector2.new(0, 0.5),
	})
	UI.TimerScale = newScale(UI.Timer, 1)
	UI.TimerScale.Name = "Pop" -- (a pop, not a layout scale)
	UI.MatchTokens = newText(inner, "Tokens", "", "Display", M.TokensText, SIGN.Text, {
		AnchorPoint = Vector2.new(1, 0.5),
	})
	CloudUI.SignBlock(UI.MatchTokens, { Face = SIGN.Tile, Lip = SIGN.StoneLip, Edge = SIGN.Wood, Text = SIGN.Text }, { EdgePx = M.BlockEdge, LipPx = M.BlockLip })
	local pad = UI.MatchTokens:FindFirstChild("LipPad")
	if pad then
		pad.PaddingLeft = UDim.new(0, M.TokensPad - M.BlockEdge)
		pad.PaddingRight = UDim.new(0, M.TokensPad - M.BlockEdge)
	end
	UI.TokensScale = newScale(UI.MatchTokens, 1)
	UI.TokensScale.Name = "Pop"
	PixelIcon.Mark(UI.MatchTokens, Theme.Currency.Tokens.Icon, { Colour = SIGN.GoldLip }) -- (kit-b U7a) the coin before the count

	-- the checkpoints: "Checkpoint 2/4" and a row of sky blocks (row B on a wide card, row C on a narrow one)
	UI.CpBar = newFrame(inner, "CheckpointBar", {})
	UI.CpLabel = newText(UI.CpBar, "Label", "Checkpoint 0/0", "Heading", M.CpText, SIGN.TextMuted, {})

	-- the members
	UI.Team = newFrame(inner, "Team", {})
	-- a face that finishes loading lays its text out anew: the tile and the blocks follow it
	local lastTile, lastCp = -1, -1
	track(UI.MatchTokens:GetPropertyChangedSignal("TextBounds"):Connect(function()
		local w = PK.LabelW(UI.MatchTokens, "Display")
		if w ~= lastTile then
			lastTile = w
			guard("match layout", PK.LayoutMatch)
		end
	end))
	track(UI.CpLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
		local w = PK.LabelW(UI.CpLabel, "Heading")
		if w ~= lastCp then
			lastCp = w
			guard("checkpoints", PK.LayCheckpoints)
		end
	end))
end

-- the checkpoints' blocks: `total` sky blocks, `cp` of them lit, the widest that fit `room` design px (26 at most)
function PK.SetCheckpoints(cp, total)
	UI.CpLabel.Text = string.format("Checkpoint %d/%d", cp, total)
	Mt.Cp, Mt.CpTotal = cp, total
	PK.LayCheckpoints()
end

-- (kitb-matchhud look0 N1: SAINT's 10 blocks at the 10 px floor and the 4 px gap overflowed their bar - in the slim layout's
-- clock row 3.2 px into the clock '24:53' and 7.6 px into a three-digit tokens tile at 640 x 360 .. 812 x 375; kit-b's wide
-- card 8.8 px into the tile at 1280 x 720) `total` blocks in `avail` design px -> width, gap, wood edge: the widest that fit
-- (26 at most) at the 4 px gap and the 10 px floor, as before; where the floor overflows, the gap closes to CpGapTight, then
-- the blocks narrow under the floor on a 1 px edge (a face kept) down to CpBlockThin, the gap at 1 px last
function PK.BlockFit(avail, total)
	local function widest(gap)
		return math.min(M.CpBlockW, math.floor((avail - (total - 1) * gap) / total))
	end
	local bw = widest(M.CpBlockGap)
	if bw >= M.CpBlockMin then
		return bw, M.CpBlockGap, M.BlockEdge
	end
	bw = widest(M.CpGapTight)
	if bw >= M.CpBlockMin then
		return bw, M.CpGapTight, M.BlockEdge
	end
	if bw >= M.CpBlockMin - 2 then
		return bw, M.CpGapTight, 1
	end
	return math.max(M.CpBlockThin, widest(1)), 1, 1
end

function PK.LayCheckpoints()
	local bar = UI.CpBar
	local total = Mt.CpTotal or 4
	local wide = PK.Wide()
	-- (kitb-matchhud, pick A) a narrow card in the slim layout: the blocks alone in the clock row, centred between the clock
	-- and the tokens tile ('8:53 [blocks] 7 / 24'); the 'Checkpoint 2/4' words go (the blocks count it)
	local bare = Mt.Compact and not wide
	UI.CpLabel.Visible = not bare
	local labelW = bare and 0 or (PK.LabelW(UI.CpLabel, "Heading") + 2)
	local room = bar.Size.X.Offset > 0 and bar.Size.X.Offset or (innerWidth() - labelW - 10)
	local avail = math.max(10, bare and room or (room - labelW - 10))
	local bw, gap, edge = PK.BlockFit(avail, total)
	local row = bar:FindFirstChild("BlockRow")
	if not row or row:GetAttribute("Count") ~= total or row:GetAttribute("BlockW") ~= bw or row:GetAttribute("BlockGap") ~= gap
		or row:GetAttribute("BlockEdge") ~= edge then
		if row then
			row:Destroy()
		end
		row = SignKit.BlockRow(bar, {
			Count = total, BlockW = bw, BlockH = M.CpH, Gap = gap, EdgePx = edge, LipPx = M.CpBlockLip,
			Fill = SIGN.Sky, FillLip = SIGN.SkyLip,
		})
		row:SetAttribute("BlockW", bw)
		row:SetAttribute("BlockGap", gap)
		row:SetAttribute("BlockEdge", edge)
	end
	UI.CpLabel.AnchorPoint = Vector2.new(0, 0.5)
	UI.CpLabel.Position = UDim2.new(0, 0, 0.5, 0)
	UI.CpLabel.Size = UDim2.new(0, labelW, 1, 0)
	if bare then
		row.AnchorPoint = Vector2.new(0.5, 0.5)
		row.Position = UDim2.new(0.5, 0, 0.5, 0)
	elseif wide then
		row.AnchorPoint = Vector2.new(0, 0.5)
		row.Position = UDim2.new(0, labelW + 10, 0.5, 0)
	else
		row.AnchorPoint = Vector2.new(1, 0.5)
		row.Position = UDim2.new(1, 0, 0.5, 0)
	end
	SignKit.FillBlocks(row, Mt.Cp or 0)
end

-- the tokens tile as wide as its coin and text (the pitch: 10 px, the coin, 6 px, the count, 10 px)
function PK.FitTokens()
	local t = UI.MatchTokens
	local pad = t:FindFirstChild("LipPad") or t:FindFirstChildOfClass("UIPadding")
	local left = pad and pad.PaddingLeft.Offset or 0
	local right = pad and pad.PaddingRight.Offset or 0
	local w = math.ceil(left + PK.LabelW(t, "Display") + right)
	local e = PK.EdgeW()
	t.Size = UDim2.fromOffset(w, M.TokensH - 2 * e)
	t.Position = UDim2.new(1, -e, 0, M.TimerY + M.TimerH / 2)
	return w + 2 * e
end

-- the match card's rows for its width (wide: the checkpoints in row B) and member count; sizes the card
function PK.LayoutMatch()
	if not UI.Match then
		return
	end
	local cw = innerWidth()
	-- (kitb-matchhud) a narrow card in the slim layout puts its checkpoints in row B too, as a wide card does (Mt.Compact)
	local wide = PK.Wide() or Mt.Compact
	local e = PK.EdgeW()
	-- row A
	PK.Place(UI.MatchBadge, 0, math.floor((M.RowA - M.Badge) / 2), M.Badge, M.Badge)
	local nameX = M.Badge + M.NameGap
	UI.MatchTitle.Position = UDim2.fromOffset(nameX, 0)
	UI.MatchTitle.Size = UDim2.new(1, -(nameX + M.LeaveW + 2 * e + 8), 0, M.RowA)
	PK.FitName(UI.MatchTitle, PK.MatchNameW())
	UI.LeaveBtn.Position = UDim2.new(1, -e, 0, M.RowA / 2)
	-- row B
	local tileW = PK.FitTokens()
	UI.Timer.Position = UDim2.new(0, 0, 0, M.TimerY + M.TimerH / 2)
	-- (centred on row B, as tall as the countdown's numeral: it overflowed the 34 px row's box)
	UI.Timer.Size = UDim2.new(0, wide and (M.CpX - 8) or math.floor(cw / 2), 0, math.max(M.TimerH, M.CountText))
	local teamY
	if wide then
		local x = math.max(M.CpX, Mt.TimerTextW and (Mt.TimerTextW + 12) or 0)
		UI.CpBar.Position = UDim2.fromOffset(x, M.TimerY + math.floor((M.TimerH - M.CpH) / 2))
		UI.CpBar.Size = UDim2.fromOffset(math.max(10, cw - tileW - 8 - x), M.CpH)
		teamY = M.TimerY + M.TimerH + M.TeamGap
	else
		UI.CpBar.Position = UDim2.fromOffset(0, M.TimerY + M.TimerH + M.RowGap)
		UI.CpBar.Size = UDim2.fromOffset(cw, M.CpH)
		teamY = M.TimerY + M.TimerH + M.RowGap + M.CpH + M.TeamGap
	end
	PK.LayCheckpoints()
	-- the members
	local rows = layoutChips(Mt.Chips, Mt.Count, cw, M.ChipH)
	Mt.Rows = rows
	local teamH = rows * M.ChipH + (rows - 1) * M.ChipGap
	UI.Team.Position = UDim2.fromOffset(0, teamY)
	UI.Team.Size = UDim2.new(1, 0, 0, teamH)
	UI.Match.Root.Size = UDim2.fromOffset(S.panelW, M.Inset + teamY + teamH + M.Bottom)
end

----------------------------------------------------------------------
-- Build: party panel (top-left, lobby only)
----------------------------------------------------------------------
local function buildParty(holder)
	local panel = PK.Card(holder, "PartyPanel")
	UI.Party = panel
	Items.Party = newItem(panel.Root, UDim2.new(-1.5, 0, 0, 0))
	local inner = panel.Inner
	UI.PartyInner = inner

	-- row A: the obby's gold icon square, the portal's name (the plain Section title: the ribbon is for window titles only)
	-- and the big red Leave (the only way out of a locked portal)
	UI.PartyIcon = PK.Block(inner, "Icon", SIGN.Gold, SIGN.GoldLip, SIGN.Wood)
	UI.PartyIconArt = PixelIcon.New(UI.PartyIcon, "mountain", M.IconText, SIGN.Text)
	UI.PartyTitle = Theme.StyleTitle(newText(inner, "Title", "Party", "Title", M.TitleText, SIGN.Text, {
		TextTruncate = Enum.TextTruncate.AtEnd,
	}), "Section") -- (kit-b prep) a HUD panel, not a window: no ribbon
	UI.PartyLeave = PK.Plank(inner, "LeaveParty", "Leave", "Red", M.PartyLeaveW, M.PartyLeaveH, M.PartyLeaveText, function()
		-- one request per press (the server rate-limits too)
		local now = os.clock()
		if now >= Pt.LeaveLockUntil then
			Pt.LeaveLockUntil = now + 0.8
			fireRemote("LeaveParty")
		end
	end)
	-- row B: the countdown after the clock (so "Full! Starting in 3s" fits on a phone too), the head count after the people
	UI.PartyStatus = newText(inner, "Status", "Waiting for players...", "Display", M.StatusText, SIGN.Text, {
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	UI.PartyStatusScale = newScale(UI.PartyStatus, 1)
	UI.PartyStatusScale.Name = "Pop"
	PixelIcon.Lead(UI.PartyStatus, "clock", { Px = K.STAR_PX, Gap = M.NameGap, Colour = SIGN.TextMuted })
	UI.PartyCount = newText(inner, "Count", "0 / 4", "Display", M.StatusText, SIGN.Text, {
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	PixelIcon.Lead(UI.PartyCount, "people", { Px = K.STAR_PX, Gap = M.NameGap, Colour = SIGN.TextMuted })
	-- the members
	UI.PartyTeam = newFrame(inner, "Players", {})
	-- row D: why the pad holds you (the walls) on an older portal's party ...
	UI.PartyHint = newText(inner, "Hint", "Locked until launch", "Label", M.HintText, SIGN.TextMuted, {
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	-- ... and on the obby's (v5, 6.3): the level badge, the level and its stars; the party leader gets Change, a sky plank
	-- (it opens the level picker)
	UI.PartyBadge = PK.Badge(inner)
	UI.PartyLevel = newText(inner, "Level", "", "Heading", M.NameText, SIGN.Text, {
		TextTruncate = Enum.TextTruncate.AtEnd,
		Visible = false,
	})
	UI.PartyChange = PK.Plank(inner, "ChangeLevel", "Change", "Sky", M.ChangeW, M.ChangeH, M.ChangeText, function()
		HudController._onChangeLevel()
	end)
	UI.PartyChange.Visible = false
	PK.RefitOnLayout(UI.PartyLevel, PK.LevelRoom)
end

-- the party card's rows for its width and member count; sizes the card
function PK.LayoutParty()
	if not UI.Party then
		return
	end
	local cw = innerWidth()
	local e = PK.EdgeW()
	local k = currentScale()
	-- row A
	PK.Place(UI.PartyIcon, 0, math.floor((M.PartyRowA - M.Badge) / 2), M.Badge, M.Badge)
	local face = M.Badge - 2 * e
	UI.PartyIconArt.Position = Vitals.IconAt(UI.PartyIconArt, Vitals.Px(face, k), Vitals.Px(face - M.BlockLip, k), k)
	local titleX = M.Badge + 10
	UI.PartyTitle.Position = UDim2.fromOffset(titleX, 0)
	UI.PartyTitle.Size = UDim2.new(1, -(titleX + M.PartyLeaveW + 2 * e + 8), 0, M.PartyRowA)
	UI.PartyLeave.Position = UDim2.new(1, -e, 0, M.PartyRowA / 2)
	-- row B
	UI.PartyStatus.Position = UDim2.fromOffset(0, M.StatusY)
	UI.PartyStatus.Size = UDim2.fromOffset(PK.StatusW(), M.StatusH)
	UI.PartyCount.Position = UDim2.new(1, 0, 0, M.StatusY)
	UI.PartyCount.Size = UDim2.fromOffset(M.CountW, M.StatusH)
	-- the members
	local rows = layoutChips(Pt.Chips, Pt.Count, cw, M.PartyChipH)
	Pt.Rows = rows
	local teamH = rows * M.PartyChipH + (rows - 1) * M.ChipGap
	UI.PartyTeam.Position = UDim2.fromOffset(0, M.PlayersY)
	UI.PartyTeam.Size = UDim2.new(1, 0, 0, teamH)
	-- row D
	local y = M.PlayersY + teamH + M.RowGap
	PK.Place(UI.PartyBadge, 0, y + math.floor((M.LevelRowH - M.Badge) / 2), M.Badge, M.Badge)
	local nameX = M.Badge + M.NameGap
	UI.PartyLevel.Position = UDim2.fromOffset(nameX, y)
	UI.PartyLevel.Size = UDim2.new(1, -(nameX + (Pt.Leader and (M.ChangeW + 2 * e + 8) or 0)), 0, M.LevelRowH)
	UI.PartyChange.Position = UDim2.new(1, -e, 0, y + M.LevelRowH / 2)
	UI.PartyHint.Position = UDim2.fromOffset(0, y)
	UI.PartyHint.Size = UDim2.new(1, 0, 0, M.LevelRowH)
	UI.Party.Root.Size = UDim2.fromOffset(S.panelW, M.Inset + y + M.LevelRowH + M.Bottom)
end

----------------------------------------------------------------------
-- Build: title card (top-left, small)
----------------------------------------------------------------------
local function buildTitleCard(holder)
	-- (kit-b U9 completeness gate) a kit B stone block (flat face, wood edge, lip; square), not the old neon card (gold neon
	-- ring, panel gradient, gloss strip). Its title is the plain Section title: the gold ribbon is for window titles only
	local card = newFrame(holder, "TitleCard", {
		Size = UDim2.fromOffset(K.TITLE_W, K.TITLE_H),
		Visible = false,
	})
	CloudUI.SignBlock(card, "Stone", { Pad = false })
	addViewportScale(card)
	UI.TitleCard = card
	Items.Title = newItem(card, UDim2.new(-1.5, 0, 0, 0))

	-- a gold cloud coin at the left
	local coin = newCoin(card, "Coin", 54, Colors.Token, Colors.TokenGlow, Theme.Currency.Tokens.Icon, 30)
	coin.AnchorPoint = Vector2.new(0, 0.5)
	coin.Position = UDim2.new(0, 11, 0.5, 0)

	Theme.StyleTitle(newText(card, "Title", string.upper(tostring(Config.GameName)), "Title", 26, Theme.Sign.Text, {
		-- (kit-b U9) 26 / 16 px: the name and the tagline whole in the card (32 / 19 cut both to "...")
		Position = UDim2.new(0, 74, 0, 10),
		Size = UDim2.new(1, -84, 0, 32),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}), "Section")
	newText(card, "Tagline", tostring(Config.Tagline), "Script", 16, Theme.Sign.Text, {
		Position = UDim2.new(0, 74, 0, 44),
		Size = UDim2.new(1, -84, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

local function hideTitleCard()
	if TC.Shown then
		TC.Shown = false
		TC.Serial = TC.Serial + 1
		present(Items.Title, false)
		applyMargins(true)
	end
end

local function playTitleCard()
	task.wait(1.5)
	if not Items.Title or S.match ~= nil or S.party ~= nil then
		return
	end
	TC.Serial = TC.Serial + 1
	local serial = TC.Serial
	TC.Shown = true
	present(Items.Title, true)
	applyMargins(true)
	task.wait(K.TITLE_CARD_SECONDS)
	if TC.Serial == serial and TC.Shown then
		TC.Shown = false
		present(Items.Title, false)
		applyMargins(true)
	end
end

----------------------------------------------------------------------
-- Health
----------------------------------------------------------------------
local function refreshHealthText()
	local text
	if S.downed then
		text = "DOWNED"
	else
		text = string.format("%d / %d", math.ceil(H.Cur - 0.001), math.ceil(H.Max - 0.001))
	end
	if text ~= H.Text and UI.HpBar then
		H.Text = text
		UI.HpNum.Text = text
		Vitals.Layout() -- (U9-8 look) a max with more digits widens the number's box (a no-op otherwise)
	end
end

local function onHealth(health, snap)
	local humanoid = H.Humanoid
	local max = (humanoid and humanoid.MaxHealth) or H.Max
	if type(max) ~= "number" or max < 1 then
		max = 1
	end
	local cur = Util.Clamp(tonumber(health) or 0, 0, max)
	local frac = cur / max
	if snap then
		H.Fill = frac
		H.Trail = frac
	elseif frac < H.Target - 0.0005 then
		-- took damage: the white trail holds a moment, the bar flashes, the card shakes, the heart pops
		local now = os.clock()
		H.HoldUntil = now + K.TRAIL_HOLD
		H.HitAt = now
		if not H.Low then
			pop(UI.HeartScale, 1.25, 0.35)
		end
	end
	H.Target = frac
	H.Cur = cur
	H.Max = max
	if frac > H.Trail then
		H.Trail = frac
	end
	refreshHealthText()
end

local function setDowned(downed)
	if S.downed == downed then
		return
	end
	S.downed = downed
	if UI.DownedNotice then
		UI.DownedNotice.Visible = downed
	end
	-- the stamina row (blocks, badge, dash key) makes room for the notice
	if UI.StBar then
		UI.StBar.Root.Visible = not downed
	end
	if UI.Key then
		UI.Key.Root.Visible = not downed and not isTouchDevice() -- (kit-b gate U9 r4: a touch screen has the DASH button)
	end
	if UI.Bolt then
		UI.Bolt.Badge.Visible = not downed
	end
	if UI.HeartGlyph then
		if UI.HeartIcon then
			UI.HeartIcon.Visible = not downed
		end
		UI.HeartGlyph.Visible = downed
	end
	Vitals.PaintBorder()
	H.ColorKey = nil -- repaint the bar
	refreshHealthText()
	Vitals.Layout() -- (U9-8 look) DOWNED takes the HP row
end

local function updateHealth(dt, now)
	if not UI.HpBar then
		return
	end
	-- the fill chases the target quickly, the trail waits and then catches up
	local diff = H.Target - H.Fill
	if math.abs(diff) > 0.0005 then
		H.Fill = H.Fill + diff * (1 - math.exp(-dt * 14))
	else
		H.Fill = H.Target
	end
	UI.HpBar.SetFraction(H.Fill)
	if H.Trail > H.Fill then
		if now >= H.HoldUntil then
			H.Trail = math.max(H.Fill, H.Trail - dt * K.TRAIL_SPEED)
		end
	else
		H.Trail = H.Fill
	end
	UI.HpBar.SetTrail(H.Trail)

	-- colour (render gate, the pitch's .vit): the HP bar is red at every level (low health shows on the card's red edge),
	-- the darker red while downed
	local key = "ok"
	local color = VS.Hp
	if S.downed then
		key = "down"
		color = VS.HpDown
	elseif H.Target <= K.LOW_HEALTH then
		key = "low"
	elseif H.Target <= 0.6 then
		key = "mid"
	end
	if key ~= H.ColorKey then
		H.ColorKey = key
		-- (U9-8 look) the lit face and its lip Frame: Sign.Red on Sign.RedLip; downed the RedLip on a darker lip
		UI.HpBar.SetColor(color, (color == VS.Hp) and Theme.Sign.RedLip or Theme.Darken(color, 0.22))
		if not H.Low then
			Vitals.PaintBorder()
		end
	end

	-- a hit: a white flash on the lit blocks and a short shake of the card, both fading out (U9-8 look: the shake moves the
	-- card by whole screen px, so its pixel edges stay crisp while it shakes)
	local bar = UI.HpBar
	local since = now - H.HitAt
	if since >= 0 and since < K.HIT_SECONDS then
		local k = 1 - since / K.HIT_SECONDS
		bar.SetFlash(1 - 0.85 * k)
		local amp = K.SHAKE_PX * k
		local s = (UI.VitalsScale and UI.VitalsScale.Scale) or 1
		local function whole(v)
			return math.floor(v * s + 0.5) / s
		end
		UI.VitalsBody.Position = UDim2.fromOffset(whole(math.sin(since * 70) * amp), whole(math.cos(since * 52) * amp * 0.5))
		H.HitFx = true
	elseif H.HitFx then
		H.HitFx = false
		bar.SetFlash(1)
		UI.VitalsBody.Position = UDim2.fromOffset(0, 0)
	end

	-- low health: the heart beats, the lit blocks breathe and the card's outline glows red with the beat (U9-8 look: the
	-- heart no longer rocks; a turned pixel heart is not on the pixel grid)
	local low = (H.Target <= K.LOW_HEALTH) and not S.downed
	if low then
		local beat = math.max(0, math.sin(now * 7.5))
		beat = beat * beat
		UI.HeartScale.Scale = 1 + 0.16 * beat
		UI.CardStroke.Color = Theme.Sign.RedLip:Lerp(Theme.Sign.Red, 0.25 + 0.75 * beat)
		UI.CardGlow.Transparency = 0.85 - 0.4 * beat
		if not H.HitFx then
			bar.SetFlash(1 - 0.3 * beat)
		end
		H.Low = true
	elseif H.Low then
		H.Low = false
		UI.Heart.Rotation = 0
		UI.HeartScale.Scale = 1
		Vitals.PaintBorder()
		if not H.HitFx then
			bar.SetFlash(1)
		end
	end
	if S.downed then
		UI.DownedNotice.TextTransparency = 0.05 + 0.2 * (0.5 + 0.5 * math.sin(now * 5))
	end
end

local function unbindHumanoid()
	for _, conn in ipairs(H.Conns) do
		conn:Disconnect()
	end
	H.Conns = {}
	H.Humanoid = nil
end

local function bindCharacter(char)
	unbindHumanoid()
	H.Char = char
	local humanoid = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 10)
	if not humanoid or H.Char ~= char then
		return
	end
	H.Humanoid = humanoid
	table.insert(H.Conns, humanoid.HealthChanged:Connect(function(health)
		guard("health", onHealth, health, false)
	end))
	table.insert(H.Conns, humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
		guard("max health", onHealth, humanoid.Health, true)
	end))
	guard("health", onHealth, humanoid.Health, true)
end

----------------------------------------------------------------------
-- Stamina + dash key
----------------------------------------------------------------------
local function dashCooldownFraction(now)
	if not movementModule then
		if now < movementNextTry then
			return 0
		end
		movementNextTry = now + 2
		local controllers = script.Parent
		local mod = controllers and controllers:FindFirstChild("MovementController")
		if mod then
			local ok, result = pcall(require, mod)
			if ok and type(result) == "table" then
				movementModule = result
			end
		end
		if not movementModule then
			return 0
		end
	end
	local fn = movementModule.GetDashCooldownFraction
	if type(fn) ~= "function" then
		return 0
	end
	local ok, value = pcall(fn)
	if ok and type(value) == "number" then
		return Util.Clamp(value, 0, 1)
	end
	return 0
end

-- dim 0 = bright .. 1 = empty (kit-b U9-8): the lit blocks and the bolt badge dim toward the stone's tan (no grey in
-- kit B), the bolt fades
function Vitals.PaintStaminaDim(dim)
	local k = 0.8 * dim
	local face = VS.Stamina:Lerp(VS.Dim, k)
	local lip = Theme.Sign.GoldLip:Lerp(VS.DimLip, k)
	UI.Bolt.Badge.BackgroundColor3 = face
	UI.Bolt.Lip.BackgroundColor3 = lip
	if UI.Bolt.Icon then
		Vitals.SetShapeTransparency(UI.Bolt.Icon, 0.5 * dim)
	end
	UI.StBar.SetColor(face, lip)
end

local function updateStamina(dt, now)
	if not UI.StBar or not UI.Key then
		return
	end
	local physics = Config.Physics or {}
	local maxSt = physics.MaxStamina or 100
	local value = player:GetAttribute(Config.Attr.Stamina)
	if type(value) ~= "number" then
		value = maxSt
	end
	local target = Util.Clamp(value / maxSt, 0, 1)
	St.Frac = St.Frac + (target - St.Frac) * (1 - math.exp(-dt * 18))
	if math.abs(target - St.Frac) < 0.002 then
		St.Frac = target
	end
	UI.StBar.SetFraction(St.Frac)

	-- dim: a little below one dash's cost, fully once run dry until running is possible again (eased,
	-- repainted on change only)
	local cost = physics.DashStaminaCost or 35
	if value <= 0.5 then
		St.Drained = true
	elseif value >= K.STAMINA_RECOVER then
		St.Drained = false
	end
	local dimGoal = 0
	if St.Drained then
		dimGoal = 1
	elseif value < cost then
		dimGoal = 0.35
	end
	St.Dim = St.Dim + (dimGoal - St.Dim) * (1 - math.exp(-dt * 10))
	if math.abs(dimGoal - St.Dim) < 0.01 then
		St.Dim = dimGoal
	end
	if math.abs(St.Dim - St.DimDrawn) > 0.02 or (St.Dim == dimGoal and St.DimDrawn ~= dimGoal) then
		St.DimDrawn = St.Dim
		Vitals.PaintStaminaDim(St.Dim)
	end

	-- (kit-b U9-8) the dash key: pressed while the dash cools down, its sky charge rising as the cooldown runs out; the Off
	-- key while there is no dash to pay for; raised again once a dash is possible (no pop: it rises back onto its lip)
	local cd = dashCooldownFraction(now)
	local charge = 1 - cd
	local afford = value >= cost
	local state = (not afford) and "off" or ((cd > 0.001) and "cool" or "ready")
	if state ~= UI.Key.State or (state == "cool" and math.abs(charge - St.Charge) > 0.004) then
		St.Charge = charge
		Vitals.PaintKey(state, charge)
	end
	-- (Pitch 2 item 08 C) the dash's state in words beside the blocks (the stamina group)
	local words = (UI.DashWords or VG.DASH_WORDS)[state]
	if UI.DashText and words and UI.DashText.Text ~= words then
		UI.DashText.Text = words
	end
	St.Ready = state == "ready"
	St.Afford = afford
end

----------------------------------------------------------------------
-- Currencies
----------------------------------------------------------------------
local function readCurrency(c)
	local value = nil
	if c.Id == "Tokens" and State and type(State.Tokens) == "function" then
		local ok, result = pcall(State.Tokens)
		if ok then
			value = result
		end
	end
	if type(value) ~= "number" and c.Attr then
		value = tonumber(player:GetAttribute(c.Attr))
	end
	if type(value) ~= "number" or value ~= value then
		value = 0
	end
	return math.max(0, math.floor(value))
end

local function matchTokensNow()
	return math.max(0, math.floor(tonumber(player:GetAttribute(Config.Attr.MatchTokens)) or 0))
end

local function inMatchNow()
	return S.match ~= nil or player:GetAttribute(Config.Attr.InMatch) == true
end

-- The number shrinks to fit the room left beside the coin and the optional "+n" chip.
local function setAmountText(c, n)
	local text = Theme.Short(n)
	local strip = c.Compact == "Strip"
	local coinSize = coinSizeOf(c)
	local chip = c.ChipShown and ((strip and K.STRIP_CHIP_W or K.CHIP_W) + 6) or 0
	local lead = 4 + coinSize + (strip and 6 or 8) -- (kit-b U8) the coin square sits 4 px inside the block
	local avail = c.Width - lead - 10 - chip
	local size = Util.Clamp(math.floor(avail / (math.max(1, #text) * 0.6)), strip and K.STRIP_TEXT_MIN or 18, strip and K.STRIP_TEXT or 32)
	c.Amount.Text = text
	c.Amount.TextSize = size
	c.Amount.Size = UDim2.new(1, -lead - 10 - chip, 1, -2)
end

-- Places the rows of `list` (top to bottom) in a stack `width` design px wide (bug batch 2 #1: style "Strips", one
-- thin strip per row, right-aligned; in a match the token strip is wider by its "+n" chip, so the chip never covers
-- the number), or (style "Band") side by side, each `width` wide (a landscape phone's top band in a battle). Other
-- rows are hidden.
layoutCurrencyRows = function(list, style, width)
	local shown = {}
	for _, c in ipairs(list) do
		shown[c] = true
	end
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c and not shown[c] then
			c.Row.Visible = false
		end
	end
	for j, c in ipairs(list) do
		local w = K.STRIP_W
		if c.Chip and inMatchNow() then
			w = K.STRIP_W + K.STRIP_CHIP_W + 6
		end
		if style == "Band" then
			w = width
			c.Row.Position = UDim2.fromOffset((j - 1) * (width + K.STRIP_GAP), 0)
		else
			c.Row.Position = UDim2.fromOffset(width - w, (j - 1) * (K.STRIP_H + K.STRIP_GAP))
		end
		c.Row.Size = UDim2.fromOffset(w, K.STRIP_H)
		c.Row.Visible = true
		local resized = c.Width ~= w
		c.Width = w
		setRowGeometry(c, "Strip")
		if resized or c.Shown == nil then
			setAmountText(c, c.Shown or c.Display)
		end
	end
end

-- Cash / Gems become available once their attribute exists (Tokens always is).
local function refreshCurrencyVisibility()
	local changed = false
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c then
			local available = c.Always or (c.Attr ~= nil and type(player:GetAttribute(c.Attr)) == "number")
			if available ~= c.Available then
				c.Available = available
				changed = true
				if available then
					c.Seen = false
					c.Shown = nil
					pop(c.CoinScale, 1.35, 0.45)
				end
			end
		end
	end
	if changed then
		applyMargins(false, true)
	end
end

local function onCurrencyChanged(c)
	if not c.Available then
		return
	end
	local v = readCurrency(c)
	local early = (os.clock() - startedAt) < 4 -- the saved totals arrive right after joining: no fanfare
	if not c.Seen or early or v < c.Target then
		c.Seen = true
		c.Target = v
		c.Display = v
		return
	end
	if v > c.Target then
		c.Target = v
		pop(c.CoinScale, 1.3, 0.4)
		pop(c.AmountScale, 1.2, 0.4)
	end
end

local function refreshRunChip()
	local c = Cur.Tokens
	if not c or not c.Chip then
		return
	end
	local inMatch = inMatchNow()
	if inMatch ~= c.ChipShown then
		c.ChipShown = inMatch
		c.Chip.Visible = inMatch
		setAmountText(c, c.Shown or c.Display)
	end
	local count = matchTokensNow()
	if count ~= Tk.RunSeen then
		local grew = count > Tk.RunSeen
		Tk.RunSeen = count
		c.RunLabel.Text = "+" .. Theme.Short(count)
		if grew then
			pop(c.RunScale, 1.3, 0.35)
		end
	end
end

local function updateCurrencies(dt)
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c and c.Available then
			local diff = c.Target - c.Display
			if diff ~= 0 then
				c.Display = c.Display + diff * (1 - math.exp(-dt * 7))
				if math.abs(c.Target - c.Display) < 0.5 then
					c.Display = c.Target
				end
			end
			local shown = math.floor(c.Display + 0.5)
			if shown ~= c.Shown then
				c.Shown = shown
				setAmountText(c, shown)
			end
		end
	end
end

----------------------------------------------------------------------
-- Match panel
----------------------------------------------------------------------
local function ensureChips(list, parent, count, withHealth)
	for i = #list + 1, count do
		list[i] = newChip(parent, i, withHealth)
	end
end

-- Short screens squeeze the match / party panels (applyMargins decides); a new width or a new scale lays both cards out
-- again (a wide card puts the checkpoints in its clock row; the chips' health bars sit on whole screen px)
setPanelWidth = function(width)
	local k = currentScale()
	if width == S.panelW and k == S.panelK then
		return
	end
	S.panelW, S.panelK = width, k
	PK.LayoutMatch()
	PK.LayoutParty()
end

-- (kitb-matchhud, pick A) the slim layout's match card: its checkpoints up in the clock row (applyMargins decides);
-- returns true when the card's height changed
setMatchCompact = function(on)
	on = on == true
	if Mt.Compact == on then
		return false
	end
	Mt.Compact = on
	if not UI.Match then
		return false
	end
	local before = UI.Match.Root.Size.Y.Offset
	PK.LayoutMatch()
	return UI.Match.Root.Size.Y.Offset ~= before
end

-- the design px the checkpoints' own row takes on a narrow card (its gap above and its height): what the slim layout saves
compactSaving = function()
	if not M or PK.Wide() then
		return 0
	end
	return M.RowGap + M.CpH
end

-- a card that grew or shrank (a row of chips more or less) may now reach the menu column (or no longer does)
local function resizePanel(panel, layout)
	local before = panel.Root.Size.Y.Offset
	layout()
	if panel.Root.Size.Y.Offset ~= before then
		applyMargins(true)
	end
end

local function updateTeam(members)
	local count = math.min(#members, 4)
	ensureChips(Mt.Chips, UI.Team, count, true)
	local localId = player.UserId
	for i = 1, count do
		local m = type(members[i]) == "table" and members[i] or {}
		local chip = Mt.Chips[i]
		local isMe = (m.UserId == localId)
		chip.Name.Text = tostring(m.Name or "?")
		PK.PaintChip(chip, isMe, m.Downed == true)
		chip.Frac = Util.Clamp(tonumber(m.Health) or 0, 0, 1)
		if m.Downed then
			chip.Frac = 0
		end
		chip.Hp.SetFraction(chip.Frac)
		-- (kit-b U7a) the state is a PixelIcon on the empty State label: a tick when finished, an x when downed
		local mark = m.Finished and "check" or (m.Downed and "x" or nil)
		if chip.State:GetAttribute("PixelIcon") ~= mark then
			local old = chip.State:FindFirstChild("Icon")
			if old then
				old:Destroy()
			end
			chip.State:SetAttribute("PixelIcon", mark)
			if mark then
				PixelIcon.Host(chip.State, mark, chip.State.TextSize)
			end
			chip.Name.Size = UDim2.new(1, -(16 + (mark and (M.StateText + 8) or 0)), 0, 26) -- (PK.LayChip's rule)
		end
		chip.State.Text = ""
		chip.State.TextColor3 = m.Finished and SIGN.Good or SIGN.RedLip
	end
	if count ~= Mt.Count then
		Mt.Count = count
		resizePanel(UI.Match, PK.LayoutMatch)
	end
end

-- (kit-b U9-8 A) "7 / 24" after the coin on the stone tile (the vitals card's "52 / 117"); "Get ready!" alone before the
-- run, the coin taken off
local function setTokensText(text, coin)
	PixelIcon.Mark(UI.MatchTokens, coin and Theme.Currency.Tokens.Icon or nil, { Colour = SIGN.GoldLip })
	if UI.MatchTokens.Text ~= text then
		UI.MatchTokens.Text = text
	end
	local before = UI.MatchTokens.Size.X.Offset
	PK.FitTokens()
	if (PK.Wide() or Mt.Compact) and UI.MatchTokens.Size.X.Offset ~= before then
		PK.LayoutMatch() -- (the checkpoints end left of the tile)
	end
end

local function updateTokensLine(state)
	local collected = math.floor(tonumber(state.TokensCollected) or 0)
	local text = tostring(collected) .. " / " .. tostring(math.floor(tonumber(state.TotalTokens) or 0))
	local grew = UI.MatchTokens.Text ~= text and Mt.TokensSeen ~= nil and collected > Mt.TokensSeen
	Mt.TokensSeen = collected
	setTokensText(text, true)
	if grew then
		pop(UI.TokensScale, 1.2, 0.3)
	end
end

-- Timer / countdown numerals. Runs every frame for the interpolated clock. (kit-b U9-8 A) inks that read on the stone:
-- 3 red, 2 wood, 1 sky, GO! the gain green, the clock brown (red from a minute left, pulsing from 30 s)
local function numeralColor(n)
	if n == 3 then
		return SIGN.RedLip
	elseif n == 2 then
		return SIGN.Wood
	elseif n == 1 then
		return SIGN.SkyLip
	end
	return SIGN.Text
end

local function setTimerText(text, color, size)
	if UI.Timer.Text ~= text or UI.Timer.TextSize ~= size then
		UI.Timer.Text = text
		UI.Timer.TextSize = size
		-- a long line ("Match over") pushes a wide card's checkpoints right
		local w = PK.TextW(text, "Display", size)
		local over = (w > M.CpX - 8) and w or nil
		if over ~= Mt.TimerTextW then
			Mt.TimerTextW = over
			if PK.Wide() or Mt.Compact then
				PK.LayoutMatch()
			end
		end
	end
	UI.Timer.TextColor3 = color
end

local function updateMatchClock(now)
	local state = S.match
	if not state or not UI.Timer then
		return
	end
	local phase = state.Phase
	local remaining = math.max(0, Mt.Base - (now - Mt.At))
	if phase == "Countdown" then
		local n = math.max(1, math.ceil(remaining - 0.05))
		if n ~= Mt.Last then
			Mt.Last = n
			setTokensText("Get ready!", false)
			pop(UI.TimerScale, 1.7, 0.5)
		end
		setTimerText(tostring(n), numeralColor(n), M.CountText)
	elseif phase == "Playing" then
		if now < Mt.GoUntil then
			setTimerText("GO!", SIGN.Good, M.CountText)
			return
		end
		local color = SIGN.Text
		if remaining <= 30 then
			color = SIGN.RedLip:Lerp(SIGN.Red, 0.5 + 0.5 * math.sin(now * 6))
		elseif remaining <= 60 then
			color = SIGN.RedLip
		end
		setTimerText(Util.FormatTime(remaining), color, M.TimerText)
	else
		setTimerText("Match over", SIGN.TextMuted, 26)
	end
end

local function disarmLeave()
	LM.ArmedUntil = 0
	if UI.LeaveBtn then
		UI.LeaveBtn.Text = "Leave"
		CloudUI.SetStyle(UI.LeaveBtn, "Pink")
	end
end

-- "Leave" in the match panel needs two presses within a few seconds.
-- v5 (6.3): the party leader's CHANGE chip. Opens the obby level picker (ObbyController.Open, dungeonclient W4)
-- when it exists; until then it asks the server for the next unlocked level (ObbyPick, validated server-side;
-- wraps back to the first level).
function HudController._onChangeLevel()
	if not Pt.Leader then
		return
	end
	local now = os.clock()
	if now < (Pt.ChangeLockUntil or 0) then
		return
	end
	Pt.ChangeLockUntil = now + 0.6
	local controllers = script.Parent
	local obby = controllers and controllers:FindFirstChild("ObbyController")
	if obby then
		local ok, mod = pcall(require, obby)
		if ok and type(mod) == "table" and type(mod.Open) == "function" then
			local opened = pcall(mod.Open)
			if opened then
				return
			end
		end
	end
	local levels = Shared:FindFirstChild("ObbyLevels")
	local okLevels, ObbyLevels = false, nil
	if levels then
		okLevels, ObbyLevels = pcall(require, levels)
	end
	local nextId = nil
	if okLevels and type(ObbyLevels) == "table" and type(ObbyLevels.List) == "function" then
		local bestTimes = nil
		if State and type(State.Get) == "function" then
			local okGet, snap = pcall(State.Get)
			if okGet and type(snap) == "table" and type(snap.Stats) == "table" then
				bestTimes = snap.Stats.BestTimes
			end
		end
		local list = ObbyLevels.List()
		local start = (ObbyLevels.IndexOf and ObbyLevels.IndexOf(Pt.Level)) or 1
		for step = 1, #list do
			local id = list[((start - 1 + step) % #list) + 1]
			if bestTimes == nil or ObbyLevels.IsUnlocked(bestTimes, id) then
				nextId = id
				break
			end
		end
	end
	if nextId and nextId ~= Pt.Level then
		local remote = remoteCache.ObbyPick
		if not remote then
			local ok, found = pcall(Remotes.Get, "ObbyPick")
			remote = ok and found or nil
			remoteCache.ObbyPick = remote
		end
		if remote then
			remote:FireServer(nextId)
		end
	end
end

function HudController._onLeaveMatch(button)
	local now = os.clock()
	if now < LM.LockedUntil then
		return
	end
	if now < LM.ArmedUntil then
		LM.LockedUntil = now + 1
		disarmLeave()
		fireRemote("LeaveMatch")
		return
	end
	LM.ArmedUntil = now + K.LEAVE_CONFIRM_SECONDS
	button.Text = "Sure?"
	CloudUI.SetStyle(button, "Red")
	task.delay(K.LEAVE_CONFIRM_SECONDS + 0.05, function()
		if LM.ArmedUntil > 0 and os.clock() >= LM.ArmedUntil then
			disarmLeave()
		end
	end)
end

local function refreshVisibility()
	local hasMatch = S.match ~= nil
	local showParty = S.party ~= nil and not hasMatch and player:GetAttribute(Config.Attr.InMatch) ~= true
	present(Items.Match, hasMatch and not S.yieldToResult)
	present(Items.Party, showParty)
	if hasMatch or showParty then
		hideTitleCard()
	end
	applyMargins(true) -- the top-left slot is taken or free: step aside for the menu column only when needed
	refreshRunChip()
end

local function clearMatch()
	S.match = nil
	Mt.Phase = nil
	Mt.Last = nil
	Mt.GoUntil = 0
	Mt.TokensSeen = nil
	disarmLeave()
	refreshVisibility()
end

local function applyMatchState(state)
	if type(state) ~= "table" then
		clearMatch()
		return
	end
	local now = os.clock()
	local prevPhase = Mt.Phase
	local phase = state.Phase
	S.match = state
	Mt.Phase = phase
	Mt.Base = tonumber(state.Seconds) or 0
	Mt.At = now
	if phase == "Playing" and prevPhase == "Countdown" then
		Mt.GoUntil = now + K.GO_SECONDS
		Mt.Last = nil
		-- (kitb-matchhud look0's minor: where the checkpoints share the clock row - the slim layout's narrow card - GO!'s 1.7
		-- pop put its '!' 17.5 px on the first block) there the pop stops 4 px of ink short of the first block
		local peak = 1.7
		local row = UI.CpBar and UI.CpBar:FindFirstChild("BlockRow")
		local k = currentScale()
		if Mt.Compact and not PK.Wide() and row and k > 0 then
			setTimerText("GO!", SIGN.Good, M.CountText)
			local w = PK.LabelW(UI.Timer, "Display")
			local room = (row.AbsolutePosition.X - UI.Timer.AbsolutePosition.X - 4) / k - 1
			if w > 0 then
				peak = math.max(1, math.min(peak, room / w))
			end
		end
		UI.TimerScale.Scale = peak
		tween(UI.TimerScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if phase ~= "Countdown" then
		Mt.Last = nil
	end

	local color = state.Color
	if typeof(color) ~= "Color3" then
		color = Colors.Stamina
	end
	local diff = Config.GetDifficulty and Config.GetDifficulty(state.DifficultyId) or nil
	-- (kit-b U9-8 A) the one level badge (the picker's numbered tile in the level's colour), then the level's name in ink
	-- and its stars (kit-b U7a: PixelIcons, in the gold's lip on the stone)
	PK.PaintBadge(UI.MatchBadge, PK.LevelNumber(state.DifficultyId), color)
	UI.MatchTitle.Text = tostring(state.DifficultyName or state.DifficultyId or "Match")
	PK.Stars(UI.MatchTitle, diff and diff.Stars or 0)
	PK.FitName(UI.MatchTitle, PK.MatchNameW())

	-- the checkpoints: sky blocks (green stays the one main action's, gold the stars' and the tokens')
	local total = math.max(1, math.floor(tonumber(state.TotalCheckpoints) or 1))
	local cp = Util.Clamp(math.floor(tonumber(state.Checkpoint) or 0), 0, total)
	PK.SetCheckpoints(cp, total)

	if phase ~= "Countdown" then
		updateTokensLine(state)
	end
	UI.LeaveBtn.Visible = (phase ~= "Ended")

	if type(state.Members) == "table" then
		updateTeam(state.Members)
	end
	refreshVisibility()
	updateMatchClock(now)
end

----------------------------------------------------------------------
-- Party panel
----------------------------------------------------------------------
local function partyStatusText(now)
	local party = S.party
	if not party then
		return ""
	end
	local count = type(party.Players) == "table" and #party.Players or 0
	local max = tonumber(party.Max) or Config.Match.MaxPlayers
	if party.Countdown ~= nil and Pt.Base ~= nil then
		local left = math.ceil(Pt.Base - (now - Pt.At) - 0.001)
		if left < 1 then
			return "Launching..." -- the server hands the party to the match any moment now
		end
		if count >= max then
			return "Full! Starting in " .. tostring(left) .. "s"
		end
		return "Starting in " .. tostring(left) .. "s"
	elseif count >= max then
		return "Party full!"
	end
	return "Waiting for players..."
end

-- Does `text` fit `width` design px at `size` in `font`? (Theme.Measure, which knows the Nunito faces; +5 px of spare)
local function textFits(text, font, size, width)
	local ok, bounds = pcall(function()
		return Theme.Measure(text, font, size, 4000)
	end)
	return not ok or typeof(bounds) ~= "Vector2" or bounds.X + 5 <= width
end

-- The largest of `sizes` (design px, largest first) at which `text` fits; the smallest one otherwise.
local function fittingSize(text, font, sizes, width)
	for _, size in ipairs(sizes) do
		if textFits(text, font, size, width) then
			return size
		end
	end
	return sizes[#sizes]
end

-- A squeezed panel (short screens, beside the menu column) shrinks the title / countdown a little and shortens
-- the hint instead of cutting "Medium" down to "Medi...". Runs only when a text or the panel width changed.
local function fitPartyTexts()
	local title, status = UI.PartyTitle.Text, UI.PartyStatus.Text
	if Pt.FitW == S.panelW and Pt.FitTitle == title and Pt.FitStatus == status and Pt.FitHint == Pt.HintLong
		and Pt.FitLevel == Pt.LevelPlain and Pt.FitLeader == Pt.Leader then
		return
	end
	Pt.FitW, Pt.FitTitle, Pt.FitStatus, Pt.FitHint, Pt.FitLevel, Pt.FitLeader = S.panelW, title, status, Pt.HintLong, Pt.LevelPlain, Pt.Leader
	local inner = innerWidth()
	local e = PK.EdgeW()
	local titleRoom = inner - (M.Badge + 10) - (M.PartyLeaveW + 2 * e + 8)
	-- v5: the one obby portal is "Sky Obby", or just "Obby" where that does not fit beside Leave (the Title role reads the
	-- text in capitals)
	local upper = string.upper(title)
	if (upper == "SKY OBBY" or upper == "OBBY") and Pt.LevelPlain then
		local wide = textFits("SKY OBBY", Theme.FontOf(UI.PartyTitle), M.TitleText - 4, titleRoom)
		title = wide and "Sky Obby" or "Obby"
		UI.PartyTitle.Text = title
		Pt.FitTitle = UI.PartyTitle.Text
	end
	UI.PartyTitle.TextSize = fittingSize(UI.PartyTitle.Text, Theme.FontOf(UI.PartyTitle), { M.TitleText, 22, 20 }, titleRoom)
	if Pt.LevelPlain then
		PK.FitName(UI.PartyLevel, PK.LevelRoom())
	end
	-- the countdown beside the head count, after the clock
	local statusRoom = PK.StatusW() - (K.STAR_PX + M.NameGap)
	UI.PartyStatus.TextSize = fittingSize(status, Theme.FontOf(UI.PartyStatus), { M.StatusText, 19, 18 }, statusRoom)
	if textFits(Pt.HintLong, Theme.FontOf(UI.PartyHint), M.HintText, inner) then
		UI.PartyHint.Text = Pt.HintLong
	else
		UI.PartyHint.Text = Pt.HintShort
	end
end

local function updatePartyClock(now)
	if not S.party or not UI.PartyStatus then
		return
	end
	local text = partyStatusText(now)
	if text ~= Pt.LastText then
		Pt.LastText = text
		UI.PartyStatus.Text = text
		if string.find(text, "Starting in", 1, true) then
			pop(UI.PartyStatusScale, PK.STATUS_POP, 0.25)
		end
	end
	fitPartyTexts()
end

local function applyPartyState(state)
	if type(state) ~= "table" then
		S.party = nil
		Pt.Base = nil
		Pt.LastText = nil
		refreshVisibility()
		return
	end
	local now = os.clock()
	S.party = state
	if state.Countdown ~= nil then
		Pt.Base = tonumber(state.Countdown) or 0
		Pt.At = now
	else
		Pt.Base = nil
	end

	local color = state.Color
	if typeof(color) ~= "Color3" then
		color = Colors.Good
	end
	-- v5 (6.3): one obby portal: the title names it, the level row shows the picked level's badge + name + stars; the
	-- leader may change the level (Change). An older payload (one portal per level) keeps its level as the title and the
	-- lock hint in the bottom row
	local levelId = state.Level or state.PortalId
	local diff = Config.GetDifficulty and Config.GetDifficulty(levelId) or nil
	local levelName = tostring((diff and diff.DisplayName) or state.DifficultyName or levelId or "?")
	local starCount = tonumber(state.Stars) or (diff and diff.Stars) or 0
	local obby = state.Level ~= nil
	if obby then
		UI.PartyTitle.Text = "Sky Obby"
	else
		UI.PartyTitle.Text = tostring(state.DifficultyName or "?")
	end
	UI.PartyTitle.TextColor3 = SIGN.Text
	-- (kit-b U9-8 A) the level badge (the picker's numbered tile in the level's colour), the name in ink, its stars after it
	starCount = math.max(0, math.min(5, math.floor(starCount)))
	UI.PartyLevel.Text = levelName
	PK.Stars(UI.PartyLevel, starCount)
	PK.PaintBadge(UI.PartyBadge, PK.LevelNumber(levelId), color)
	Pt.LevelPlain = obby and levelName or nil
	local leader = obby and state.LeaderUserId ~= nil and state.LeaderUserId == player.UserId
	local leaderChanged = leader ~= (Pt.Leader == true)
	Pt.Leader = leader
	Pt.Level = levelId
	UI.PartyLevel.Visible = obby
	UI.PartyBadge.Visible = obby
	UI.PartyHint.Visible = not obby
	UI.PartyChange.Visible = Pt.Leader == true
	-- members are held on the pad by the portal walls until launch (PortalService); Leave is the way out
	if state.Locked == false then
		Pt.HintLong, Pt.HintShort = "In the portal party", "In a party"
	else
		Pt.HintLong, Pt.HintShort = "Locked until launch", "Locked in"
	end
	UI.PartyHint.Text = Pt.HintLong
	Pt.FitHint = nil -- fitPartyTexts (via updatePartyClock below) picks the long or short hint

	local list = type(state.Players) == "table" and state.Players or {}
	local count = math.min(#list, 4)
	ensureChips(Pt.Chips, UI.PartyTeam, count, false)
	for i = 1, count do
		local entry = type(list[i]) == "table" and list[i] or {}
		local chip = Pt.Chips[i]
		chip.Name.Text = tostring(entry.Name or "?")
		PK.PaintChip(chip, entry.UserId == player.UserId, false)
	end
	if count ~= Pt.Count or leaderChanged then
		Pt.Count = count
		resizePanel(UI.Party, PK.LayoutParty)
	end
	UI.PartyCount.Text = string.format("%d / %d", #list, tonumber(state.Max) or Config.Match.MaxPlayers)
	Pt.LastText = nil
	updatePartyClock(now)
	refreshVisibility()
end

-- NotifyController publishes the left edge of its open result card; where it would cover the match panel
-- (portrait phones) the panel slides away until the card closes.
local function checkResultCard()
	local pg = playerGui()
	local notifyGui = pg and pg:FindFirstChild("NimbusNotify")
	local left = notifyGui and notifyGui:GetAttribute("ResultCardLeft")
	if type(left) ~= "number" then
		left = 0
	end
	local right = (padGoals.TopLeft or K.EDGE) + S.panelW * currentScale()
	local yield = left > 0 and right > left - 8
	if yield ~= S.yieldToResult then
		S.yieldToResult = yield
		refreshVisibility()
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function onRender(dt)
	local now = os.clock()
	guard("health", updateHealth, dt, now)
	guard("stamina", updateStamina, dt, now)
	guard("currencies", updateCurrencies, dt)
	guard("match clock", updateMatchClock, now)
	guard("party clock", updatePartyClock, now)
	layoutPoll = layoutPoll + dt
	if layoutPoll >= K.LAYOUT_POLL then
		layoutPoll = 0
		guard("layout", applyMargins, false, false) -- neighbours (menu column, touch buttons) may have moved
		guard("result card", checkResultCard)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
-- gui-redo review fix: a window that reaches over the vitals card without covering all of it (the Gifts window on PC: its
-- bottom edge cut the card in half at 1080p) hides the card while it is open. `who` names the window, `on` = true while
-- it wants the card gone; the card comes back when the last window lets go. The layout and its published edges stay as
-- they are (nothing else moves).
function HudController.SetVitalsHidden(who, on)
	S.vitalsOwners[type(who) == "string" and who or "?"] = (on == true) or nil
	if UI.Vitals then
		UI.Vitals.Visible = next(S.vitalsOwners) == nil
	end
end

-- (kit-b U9-2) a window that shows the balances itself (the Shop's Gems and Tokens tags) steps the currency strips aside
-- while it is open: `who` names the window, `on` = true while it wants them gone; they come back when the last window
-- lets go. The layout re-runs, so the gift's dock and the published edges follow (nothing else moves).
function HudController.SetCurrencyHidden(who, on)
	S.currencyOwners[type(who) == "string" and who or "?"] = (on == true) or nil
	if UI.Currency then
		relayout()
	end
end

-- (P2 fix A, item 06 A) a card that spans the top band of a portrait phone (BattleController's boss strip) keeps the band
-- down to `bottom` (gui-area px) for itself: the currency strips start under it. `who` names the card; nil / 0 lets go. The
-- layout re-runs only when the reserve changes
function HudController.SetTopReserve(who, bottom)
	who = type(who) == "string" and who or "?"
	local v = (type(bottom) == "number" and bottom > 0) and math.floor(bottom + 0.5) or nil
	if S.topReserve[who] == v then
		return
	end
	S.topReserve[who] = v
	if UI.Currency then
		relayout()
	end
end

-- (LOOK-ui, kitb-look1: the Index and Home windows lay over the vitals card and the strips) which HUD parts a docked
-- window lies over by more than a shared edge (4 px): `rect` its box in screen px (NeonKit.SideRect: x, y, w, h, the top
-- bar included), `above` px of awning over its top. Returns vitals, strips (booleans). The strips' box is the one the
-- layout placed (their left .. the screen's right, the top .. the gift's dock under them, else their own foot), whether
-- they show or not. (playtest 2026-11-28 C31 r2: with the gift docked beside the strips, GiftTop is the strips' top, and
-- the box read from it was 12 px tall)
function HudController.Overlaps(rect, above)
	if type(rect) ~= "table" or not (tonumber(rect.x) and tonumber(rect.y) and tonumber(rect.w) and tonumber(rect.h)) then
		return false, false
	end
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	local x0, x1 = rect.x, rect.x + rect.w
	local y0, y1 = rect.y - inset - (tonumber(above) or 0), rect.y - inset + rect.h
	local function over(ax0, ay0, ax1, ay1)
		return math.min(x1, ax1) - math.max(x0, ax0) > 4 and math.min(y1, ay1) - math.max(y0, ay0) > 4
	end
	local vitals = vitalsRect ~= nil and over(vitalsRect.X, vitalsRect.Y, vitalsRect.X + vitalsRect.W, vitalsRect.Y + vitalsRect.H)
	local strips = false
	local left = stripsBox and math.floor(stripsBox.Left + 0.5) -- (whole px, as the layout publishes them)
	if left and left > 0 then
		strips = over(left, 0, math.huge, math.floor(stripsBox.Bottom + 0.5))
	end
	return vitals, strips
end

-- Where the HUD currently is (gui-area pixels of an IgnoreGuiInset = false ScreenGui; 0 = nothing there).
function HudController.GetLayout()
	return {
		TopLeftRight = published.TopLeftRight or 0,
		TopLeftBottom = published.TopLeftBottom or 0,
		TopRightBottom = published.TopRightBottom or 0,
		BottomLeftTop = published.BottomLeftTop or 0,
		Scale = currentScale(),
		CurrencyMode = S.currencyMode,
		Vitals = (vitalsRect and UI.Vitals and UI.Vitals.Visible and UI.Gui and UI.Gui.Enabled)
			and { X = vitalsRect.X, Y = vitalsRect.Y, W = vitalsRect.W, H = vitalsRect.H, TabUp = vitalsRect.TabUp } or nil,
		-- quick wins (win 4): the card's rect whether it is shown or hidden (nil only with no card): a fighter's pet battle
		-- hides the card (SetVitalsHidden("Battle", true)) and BattleController puts Cheer up! / Retreat in its slot
		VitalsSlot = (vitalsRect and UI.Vitals) and { X = vitalsRect.X, Y = vitalsRect.Y, W = vitalsRect.W, H = vitalsRect.H, TabUp = vitalsRect.TabUp } or nil,
	}
end

----------------------------------------------------------------------
-- Wiring
----------------------------------------------------------------------
local function buildGui()
	M = panelMetrics(isTouchDevice())
	local gui = CloudUI.NewScreenGui("NimbusHud", 10)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(gui)
	UI.Gui = gui

	local topLeft = newHolder(gui, "TopLeft")
	local topRight = newHolder(gui, "TopRight")
	local bottomLeft = newHolder(gui, "BottomLeft")
	UI.TopRight = topRight
	UI.BottomLeft = bottomLeft

	buildVitals(bottomLeft) -- (the holder keeps its v3 name; the layout centres the card above the hotbar)
	buildCurrency(topRight)
	buildMatch(topLeft)
	buildParty(topLeft)
	buildTitleCard(topLeft)
	refreshCurrencyVisibility()
	applyMargins(false, true)
end

local function hookRemote(name, handler)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, name)
		if not ok or not remote then
			warnOnce("remote " .. name, remote)
			return
		end
		remoteCache[name] = remote
		if handler then
			track(remote.OnClientEvent:Connect(handler))
		end
	end)
end

local function hookCamera()
	local cameraConn = nil
	local function bind()
		if cameraConn then
			cameraConn:Disconnect()
			cameraConn = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			cameraConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				guard("relayout", relayout)
				-- the menu and the touch controls lay themselves out on the same signal: measure them again
				task.delay(0.1, function()
					guard("relayout", relayout)
				end)
			end)
		end
		guard("relayout", relayout)
	end
	track(workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bind))
	bind()
	if UI.Gui then
		track(UI.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			guard("relayout", relayout)
		end))
	end
	-- the viewport can still be 1x1 right at startup: re-check shortly afterwards
	task.delay(0.5, function()
		guard("relayout", relayout)
	end)
	task.delay(2, function()
		guard("relayout", relayout)
	end)
end

local function hookCurrencies()
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c and c.Attr then
			track(player:GetAttributeChangedSignal(c.Attr):Connect(function()
				guard("currency visibility", refreshCurrencyVisibility)
				guard("currency " .. c.Id, onCurrencyChanged, c)
			end))
		end
	end
	if State and State.TokensChanged and Cur.Tokens then
		pcall(function()
			track(State.TokensChanged:Connect(function()
				guard("currency Tokens", onCurrencyChanged, Cur.Tokens)
			end))
		end)
	end
	-- (Pitch 2 item 08 C) the vitals tab's trophies (a sync) and name (a display name change) follow (a no-op unless one moved)
	if State and State.Changed then
		pcall(function()
			track(State.Changed:Connect(function()
				guard("vitals tab", Vitals.Layout)
			end))
		end)
	end
	pcall(function()
		track(player:GetPropertyChangedSignal("DisplayName"):Connect(function()
			guard("vitals tab", Vitals.Layout)
		end))
	end)
	-- snap every counter to its current value (or 0)
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c then
			guard("currency " .. c.Id, onCurrencyChanged, c)
			-- no attribute yet: snap to the saved total when it lands
			c.Seen = c.Attr ~= nil and player:GetAttribute(c.Attr) ~= nil
			c.Shown = nil
		end
	end
end

function HudController.Init()
	if initialized then
		return
	end
	player = Players.LocalPlayer
	if not player then
		return
	end
	initialized = true
	startedAt = os.clock()

	disableDefaultHealth()
	buildGui()
	hookCamera()

	-- player attributes
	local attr = Config.Attr
	hookCurrencies()
	track(player:GetAttributeChangedSignal(attr.MatchTokens):Connect(function()
		guard("run chip", refreshRunChip)
	end))
	track(player:GetAttributeChangedSignal(attr.InMatch):Connect(function()
		if player:GetAttribute(attr.InMatch) ~= true and S.match ~= nil then
			guard("in match", clearMatch) -- back in the lobby: drop a stale match view
		else
			guard("in match", refreshVisibility)
		end
	end))
	track(player:GetAttributeChangedSignal(attr.Downed):Connect(function()
		guard("downed", setDowned, player:GetAttribute(attr.Downed) == true)
	end))
	-- a battle / dungeon run starts or ends: a landscape phone's strips move at once (the battle HUD lays out around them)
	track(player:GetAttributeChangedSignal(attr.InBattle or "InBattle"):Connect(function()
		guard("in battle", applyMargins, false, true)
	end))
	refreshRunChip()
	if player:GetAttribute(attr.Downed) == true then
		setDowned(true)
	end

	-- character / humanoid (respawn safe)
	track(player.CharacterAdded:Connect(function(char)
		task.spawn(bindCharacter, char)
	end))
	track(player.CharacterRemoving:Connect(function(char)
		if H.Char == char then
			unbindHumanoid()
			H.Char = nil
		end
	end))
	if player.Character then
		task.spawn(bindCharacter, player.Character)
	end

	-- server state
	hookRemote("MatchState", function(state)
		guard("match state", applyMatchState, state)
	end)
	hookRemote("PartyState", function(state)
		guard("party state", applyPartyState, state)
	end)
	hookRemote("LeaveParty", nil)
	hookRemote("LeaveMatch", nil)

	track(RunService.RenderStepped:Connect(onRender))
	task.spawn(function()
		guard("title card", playTitleCard)
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1143">
            <Properties>
              <string name="Name">IndexController</string>
              <string name="Source"><![CDATA[-- IndexController (client, v3): the Pet Index window (ARCHITECTURE_V3.md section 3, 10 and 11).
--
--   IndexController.Init()
--   IndexController.Open(groupId|nil)    -- groupId = a rarity id ("Common" .. "Secret"); nil = last / best group
--   IndexController.Close()
--   Extras: IndexController.IsOpen() -> bool, IndexController.ClaimableCount() -> n,
--           IndexController.Opened (Util.Signal, Fire(groupId) when the window opens),
--           IndexController.Closed (Util.Signal, Fire() when it closes),
--           IndexController.Metrics (the K table; MEASURE: a tab-name width hook for the offline renderer and tests)
--
-- MenuController opens it from the menu "Index" tile and from OpenPanel("Index"), and relays Opened as
-- MenuController.WindowOpened("Index") (the tutorial listens there). This module never requires
-- MenuController at load (no require cycle; it looks it up at open / close time for SetTouchHidden, and at click time
-- for the Home window). Open("Fusions") opens the Fusions tab.
--
-- kit-b U8: the window is a kit B sign (CloudUI.Panel Skin "Signboard", the book on its header): stone wells with brown
-- ink, no glow, gloss or neon border. The rarity groups are signboard tabs (a stone tab with the rarity on its lip, the
-- selected one gold-faced; in the tall layout's strip a whole number of tabs fills the strip, so none shows cut, and the
-- names sit at a fixed size that fits left of the badge corner, the count on the bar row under them). A pet tile is the Pets window's card: a stone tile, the pet in its light well, the
-- rarity on its lip (attribute Rarity), the element as a chip with its drawn icon. On a touch phone Roblox's thumbstick
-- and jump button go while the window is open (MenuController.SetTouchHidden("Index"), as Pets, Shop and Gifts do): the
-- jump button sat on CLAIM at 844x390.
--
-- Phase 2 (ARCHITECTURE_V3.md section 11 + "Phase 2 build contract"): a "Fusions" tile under the rarity groups
-- lists every fused pet the player owns: hybrids (mixed at the Fusion Machine, one of a kind) and Golden / Rainbow
-- copies, each with its look (PetKeys.DefOf: merged hybrid looks, tier finishes), a tier / hybrid badge and its
-- level. Fusions are not part of the group rewards: the rewards box explains how to fuse instead (and opens the
-- Fusion Machine window once the player has one). The detail card shows the tier, the parents of a hybrid, both
-- elements, and the stats at the pet's level x its tier.
--
-- Layout (cloud-styled through CloudUI, like the reference "Pet Index" window):
--   title bar "Pet Index" + red X
--   left    vertical group list: one rarity tab per rarity group with "3/6" progress,
--           (Pitch 2 item 12_index_badge B, no badge) a waiting reward's gold token chip "+800" or a claimed group's
--           grass check in the count's place; the strip snaps to whole tabs under its page dots; an "Elements" button
--           (in the header by the X in the column layout, fixed at the strip's end in the strip layout) that opens
--           the element chart as its own centred window (client/UI/ElementsWindow, Pitch 2 item 12_elements A; Esc and
--           its X return here; Open("Elements") opens the Index with the chart over it)
--   centre  group header with an x/N progress bar, a grid of pet tiles (ViewportFrame of the pet; pets not
--           discovered yet are black silhouettes via ViewportFrame.ImageColor3 = (0, 0, 0) with a "???"
--           caption), and the rewards box ("Rewards:" + the token amount) with a CLAIM button (green when
--           claimable, grey otherwise, "Claimed" when done) -> Remotes.IndexClaim(groupId)
--   right   detail card: big viewport, name or "???", rarity, element badge with "Strong vs / Weak vs",
--           Role, stats and the special attack once discovered (Stormfang also shows its 2D art banner)
--   footer  "Unlocked: x/N" over every pet in the catalog
-- The window is designed in 1080p pixels (readability rule: body 19, captions >= 18, buttons 22+, titles
-- 28-34) under ONE UIScale = min(screen factor, fit); its size adapts between 900x420 and 1240x760 design
-- pixels so phones keep a readable scale, every column scrolls when space is short.
-- Pet viewports are built under a per-frame time budget (only for the shown group), silhouettes never animate,
-- and every viewport runs on CloudUI's one shared update loop. Esc / gamepad B / the X / a click outside closes it.
--
-- Remotes: IndexClaim (out, rate-limited here and validated + rate-limited by the server).
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the reward's Cloud Token coin
local SignKit = require(Shared:WaitForChild("SignKit")) -- (render gate) the header band kept inside the docked window
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		return require(Shared:WaitForChild(name, 10))
	end)
	if ok and type(result) == "table" then
		return result
	end
	warn("[IndexController] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetCatalog = safeRequire("PetCatalog") or { Pets = {}, Get = function() return nil end }
local BattleCatalog = safeRequire("BattleCatalog")

local IndexController = {}
IndexController.Opened = Util.Signal()
IndexController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen)
----------------------------------------------------------------------
local K = {
	PREF_W = 860, -- Phase 5 (6.6): docked right / a bottom sheet (NeonKit.Dock), 860 x 900 design px (LOOK-ui: the docked
	-- windows' one box, MenuController K.DOCK_BOX; at 820 the 1080p three columns wrapped the group's heading)
	PREF_H = 900,
	MIN_W = 800,
	MIN_H = 380,
	MARGIN = 12, -- screen px kept free around the window
	NARROW = 1100, -- below this design width the side columns get narrower
	SHORT = 560, -- below this design height the compact layout is used (landscape phones)
	GROUP_W = 236,
	GROUP_W_NARROW = 184,
	DETAIL_W = 336,
	DETAIL_W_NARROW = 264,
	GAP = 12,
	TILE_W = 126,
	TILE_H = 154,
	TILE_W_NARROW = 114,
	TILE_H_NARROW = 142,
	TILE_H_SHORT = 132,
	TILE_H_LAND_MIN = 104, -- (fix round B) a landscape phone's tile, fitted to the grid's view, never under this
	-- (fix round B r1) a tile's pet picture: the tile's height less this (the name band, the lip and the margins) ...
	TILE_ART_FOOT = 52,
	-- ... and the element tag's foot under the picture's top, design px at the touch scale 0.8 (a 22 screen px chip 3 px in):
	-- the portrait inside the picture starts low enough that the tag covers at most a third of it
	TAG_FOOT = 31,
	TILE_GAP = 10,
	HEADER_H = 58,
	HEADER_H_SHORT = 48,
	REWARD_H = 96,
	REWARD_H_SHORT = 62,
	FOOTER_H = 46,
	VIEW_H = 180,
	VIEW_H_SHORT = 140,
	GROUP_TILE_H = 60, -- 7 rarity groups + the Fusions tile fit a 1080p window without scrolling
	GROUP_TILE_H_SHORT = 56,
	-- portrait screens (a phone held upright): the window may get as narrow as TALL_MIN_W and as tall as TALL_MAX_H
	-- design px, and below TALL design px wide it stacks: a strip of group tiles, the grid, the detail card
	TALL_MIN_W = 420,
	TALL_MAX_H = 1100,
	TALL = 760,
	STRIP_H = 64, -- the group strip of the tall layout (tiles + room for its scroll bar)
	STRIP_TILE_W = 150,
	-- (kit-b U8 review) a tab's name row: the name from TAB_NAME_X to the badge corner (the badge is 28 px centred 8 px in
	-- from the right edge, so the name stops TAB_BADGE_W short of it), sized down from 24 (column) / 20 (strip) to NAME_MIN
	-- until it fits with NAME_SPARE px to spare; the count sits on the bar row under it
	TAB_NAME_X = 12,
	TAB_BADGE_W = 22,
	NAME_MIN = 18,
	NAME_SPARE = 2,
	STRIP_TILE_MIN_W = 134, -- (kit-b U8) the narrowest strip tab: "Uncommon" (96.4 px of FredokaOne at 18) and its badge corner
	-- (U8 review) a tab name's width in px: nil = Theme.MeasureLabel (TextService knows FredokaOne in Roblox); the offline
	-- renderer and the tests put real font metrics here (the mock's TextService is a flat 0.5 em). (text, size, font) -> px
	MEASURE = nil,
	STRIP_PAD_L = 4, -- the strip's left padding and the gap between two tabs
	STRIP_GAP = 6,
	PANEL_INSET_W = 24, -- the Neon panel's content inset (left + right, design px)
	REWARD_ROOMY_W = 480, -- a reward box narrower than this (design px) gets the 150 x 52 CLAIM button
	REWARD_LABEL_W = 112, -- "Rewards:" (Heading 22) and its gap
	REWARD_AMOUNT_W = 148, -- the widest amount (the Secret group's "<coin> 10,000" in Display 30; LOOK-ui: measured 144)
	REWARD_SUB_MIN_W = 150, -- narrower than this, the line under the amount is left out (no 4-line wrap)
	-- (Pitch 2 F0 A, look review major 5) the group's name on one line: the room the header's progress keeps (its blocks
	-- and the "2/6" count), and the name's sizes tried from the biggest
	HEADER_PROGRESS_MIN = 120,
	-- (look review of finish pass A, major 7: on a phone the 0.8 window drew the strip's tabs, Elements and Claim 42 px
	-- tall) a touch screen's thumb target, design px: 44.8 screen px at the docked window's 0.8
	TOUCH_H = 56,
	HEADER_TITLE_SIZES = { 24, 22, 20, 18 },
	HEADER_BLOCK = 18, -- (fix round B) the group meter's square boxes, design px ...
	HEADER_BLOCK_MIN = 10, -- ... never under this (the Bar weight's 2 px edge leaves a 6 px face: still a box, not a pip)
	HEADER_COUNT_W = 58, -- the "2/6" count's box at the meter's right end
	ELEMENTS_STRIP_W = 132,
	ELEMENTS_BTN_H = 52,
	ELEMENTS_BTN_H_SHORT = 44,
	-- (Pitch 2 item 12_index_badge B) the column layout's Elements plank in the header: HEAD_PLANK_W x HEAD_PLANK_H (a
	-- touch screen's HEAD_PLANK_TOUCH_H), its right end HEAD_PLANK_R px in from the window's right (10 px left of the X,
	-- CloudUI's Signboard close: 44 px, 16 px in), its middle on the X's (HEAD_PLANK_Y)
	-- (look review r0: at 40 tall on the 54 px band its edge and hard shadow hung ~5 px under the navy onto the body) 36,
	-- its middle at 31: the plank, its 5 px edge and its 5 px shadow all on the band
	HEAD_PLANK_W = 150,
	HEAD_PLANK_H = 36,
	HEAD_PLANK_TOUCH_H = 44,
	HEAD_PLANK_R = 70,
	HEAD_PLANK_Y = 31,
	SNAP_DELAY = 0.25, -- (12_index_badge B) seconds after the strip stops moving before it settles on whole tabs
	-- (12_index_badge B, look review r0: the dots sat in the tabs' hard shadow, tan on cream, and read as a shadow line) the
	-- strip's page dots DOT_W x DOT_H, DOT_GAP px of clear stone under the tabs' drawn foot (TAB_DRAWN: a tab's outer edge
	-- and its hard shadow under its box) and over the centre, which steps down for them where it must
	DOT_W = 16,
	DOT_H = 3,
	DOT_GAP = 4,
	TAB_DRAWN = SignKit.Sizes.Edge + Theme.Finish.Card,
	-- pet viewports are attached under a per-frame TIME budget: the first of a frame always, more only while the
	-- frame has spent < TILE_BUDGET s and at most TILES_MAX (a first-time High sculpt of ~350 parts costs tens of
	-- ms, a cached clone a few: a fixed count hitched on fresh clients)
	TILE_BUDGET = 0.004,
	TILES_MAX = 3,
	TILE_LIP = 6, -- (kit-b U8) px of a pet tile's rarity lip (the Pets cards' CARD_LIP)
	CLAIM_GAP = 0.6, -- seconds between two IndexClaim sends
	CLAIM_TIMEOUT = 5, -- seconds the CLAIM button waits for the server before it resets
	BACK_ACTION = "NimbusIndexBack",
	DISPLAY_ORDER = 21, -- above NimbusMenu (20): on small screens the window may cover the menu column
}
IndexController.Metrics = K

local Colors = Theme.Colors
-- (kit-b U8) the Signboard palette: brown ink on stone and in the wells, wood edges
local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local GOLD = SIGN.Gold
local SILHOUETTE = Color3.new(0, 0, 0)
local ROLE_COLORS = { Economy = Color3.fromRGB(96, 196, 108), Combat = Color3.fromRGB(228, 104, 96) }
-- (kit-b U7b) the window's marks are PixelIcons, not emoji (the title says "Pet Index" in words: the menu tile has the book)
local ICON = { Check = "check", Star = "star", Arrow = "play", Swap = "swap", Sparkle = "sparkle" }

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local initialized = false
local LocalPlayer = nil
local U = {} -- UI references
local S = {
	Built = false,
	Open = false,
	Token = 0, -- bumps on every open / close (cancels stale delays)
	GroupId = nil, -- selected group
	PetId = nil, -- selected pet
	Groups = {}, -- PetCatalog.IndexGroups() result
	GroupById = {},
	GroupTiles = {}, -- groupId -> tile widgets
	Tiles = {}, -- petId -> tile widgets of the shown group
	TileOrder = {},
	Filling = false,
	DetailKey = nil, -- "<petId>|<discovered>" of the detail viewport
	DetailViewport = nil,
	DetailPills = {},
	PillKey = nil,
	Narrow = false,
	ClaimPending = nil, -- groupId while a claim waits for the server
	ClaimToken = 0,
	LastClaim = 0,
	BackBound = false,
	ElementsShown = false,
	StatMax = nil,
	FusionTile = nil, -- the "Fusions" group tile
	FusionSig = nil, -- the fusion keys shown in the grid (rebuilt when they change)
}
local FUSIONS = "Fusions" -- the Fusions tab's group id
local warned = {}
local claimRemote = nil

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[IndexController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function makeFrame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel. kit-b U6: every Index text sits on the window or a card, so it reads by contrast and has no
-- outline (was a 0.25 classic stroke under a 1.5 px glyph outline).
local function makeText(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

-- radius: a Theme.Radius token ("S", "M"; kit-b U6), "M" by default
local function corner(parent, radius)
	return Theme.Corner(parent, radius or "M")
end

local function stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or SIGN.Wood, thickness or 3, transparency or 0)
end

-- (kit-b U8) a square edge with mitred corners (kit B has no rounded blocks)
local function edge(parent, color, thickness)
	local s = stroke(parent, color, thickness, 0)
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

local function pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function listLayout(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

local function scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.Parent = parent
	return SignKit.ScrollBar(Util.Create("ScrollingFrame", p)) -- (U9-7 look) the kit's wood bar, square ends
end

local function tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

-- (kit-b U8) a sunk stone well (the pitch's .wl): flat, its own darker edge
local function inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = SIGN.Well
	p.BackgroundTransparency = 0
	local frame = makeFrame(parent, name, p)
	edge(frame, SIGN.WellEdge, 2)
	return frame
end

-- a small square tag (the pitch's .chp): the colour, the ink that reads on it, a wood edge (a mid-tone that no ink reads
-- 4.5:1 on is lightened until brown does)
local function signPill(text, color, parent)
	for _ = 1, 6 do
		if Theme.Contrast(Theme.TextOn(color), color) >= 4.6 then
			break
		end
		color = Theme.Lighten(color, 0.08)
	end
	local pill = Theme.Label(tostring(text or ""), "Heading", {
		Size = 18,
		Color = Theme.TextOn(color),
		Props = {
			Name = "Pill",
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 28),
			TextXAlignment = Enum.TextXAlignment.Center,
		},
	})
	edge(pill, SIGN.Wood, 2)
	pad(pill, 9, 0, 9, 0)
	Util.Create("UISizeConstraint", { MinSize = Vector2.new(34, 28), Parent = pill })
	pill.Parent = parent
	return pill
end

local function rarityColor(rarityId)
	return CloudUI.RarityColor(rarityId)
end

-- A rarity colour that still reads as a colour on dark panels (the Secret rarity is near-black).
local function rarityAccent(rarityId)
	local color = rarityColor(rarityId)
	if rarityId == "Secret" then
		return Color3.fromRGB(150, 110, 232)
	end
	return color
end

-- (Pitch 2 F0, one number style) the reward and the stat values read in Theme.Short ("50", "1.25K")
local function commas(n)
	return Theme.Short(tonumber(n) or 0)
end

-- (LOOK-ui, kitb-look1) a group's block bar: a block per pet up to 12, ten blocks (tenths) past that
local function H_blockCount(total)
	total = math.floor(tonumber(total) or 0)
	return total > 12 and 10 or math.max(1, total)
end

-- lights `found` of `total` on a block bar (a block per pet, or the tenths; any found pet lights one at least)
local function H_fillBlocks(row, found, total)
	local n = row:GetAttribute("Count") or 1
	local k = (total or 0) > 0 and math.floor(found / total * n) or 0
	if found > 0 then
		k = math.max(1, k)
	end
	SignKit.FillBlocks(row, k)
end

----------------------------------------------------------------------
-- Data helpers
----------------------------------------------------------------------
local function loadGroups()
	local groups = {}
	if type(PetCatalog.IndexGroups) == "function" then
		local ok, result = pcall(PetCatalog.IndexGroups)
		if ok and type(result) == "table" then
			groups = result
		end
	end
	if #groups == 0 then
		-- older catalog: one group per rarity from the pet list
		local byRarity = {}
		for _, def in ipairs(PetCatalog.Pets or {}) do
			local id = def.Rarity
			if type(id) == "string" then
				if not byRarity[id] then
					local rewards = Config.Index and Config.Index.Rewards or {}
					byRarity[id] = { Id = id, Rarity = id, Pets = {}, Reward = rewards[id] or { Tokens = 0 } }
				end
				table.insert(byRarity[id].Pets, def)
			end
		end
		for _, r in ipairs(Config.Rarities) do
			if byRarity[r.Id] then
				table.insert(groups, byRarity[r.Id])
			end
		end
	end
	local clean = {}
	for _, group in ipairs(groups) do
		if type(group) == "table" and type(group.Id) == "string" and type(group.Pets) == "table" and #group.Pets > 0 then
			table.insert(clean, group)
		end
	end
	S.Groups = clean
	S.GroupById = {}
	for _, group in ipairs(clean) do
		S.GroupById[group.Id] = group
	end
end

local function totalPets()
	if type(PetCatalog.TotalCount) == "function" then
		local ok, n = pcall(PetCatalog.TotalCount)
		if ok and type(n) == "number" then
			return n
		end
	end
	return #(PetCatalog.Pets or {})
end

local function unlockedCount()
	local n = 0
	for _, def in ipairs(PetCatalog.Pets or {}) do
		if State.IsDiscovered(def.Id) then
			n = n + 1
		end
	end
	return n
end

-- found, total, complete, claimed, claimable
local function groupStatus(group)
	local found = 0
	for _, def in ipairs(group.Pets) do
		if State.IsDiscovered(def.Id) then
			found = found + 1
		end
	end
	local total = #group.Pets
	local complete = total > 0 and found >= total
	local claimed = State.IsClaimed(group.Id)
	return found, total, complete, claimed, complete and not claimed
end

local function rewardTokens(group)
	local reward = group and group.Reward
	if type(reward) ~= "table" then
		local rewards = Config.Index and Config.Index.Rewards
		reward = rewards and group and rewards[group.Id]
	end
	if type(reward) == "table" and type(reward.Tokens) == "number" then
		return reward.Tokens
	end
	return 0
end

-- Element ids of a pet (v3 section 11), filtered by Config.Elements; empty while the catalog has none.
local function elementsOf(def)
	local info = Config.Elements and Config.Elements.Info
	if type(def) ~= "table" or type(info) ~= "table" then
		return {}
	end
	local raw = nil
	if type(PetCatalog.ElementsOf) == "function" then
		local ok, result = pcall(PetCatalog.ElementsOf, def)
		if ok then
			raw = result
		end
	end
	if raw == nil and type(PetCatalog.GetElements) == "function" then
		local ok, result = pcall(PetCatalog.GetElements, def.Id)
		if ok then
			raw = result
		end
	end
	if raw == nil then
		raw = def.Elements or def.Element
	end
	if type(raw) == "string" then
		raw = { raw }
	end
	local out, seen = {}, {}
	if type(raw) == "table" then
		for _, e in ipairs(raw) do
			if type(e) == "string" and info[e] and not seen[e] then
				seen[e] = true
				table.insert(out, e)
			end
		end
	end
	return out
end

local function elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	return info and info.Color or Colors.PanelLight
end

-- "Strong vs Flame  /  Weak vs Storm" for one element.
local function matchupText(element)
	local strongMap = Config.Elements and Config.Elements.Strong
	if type(strongMap) ~= "table" then
		return ""
	end
	local strong = {}
	for _, e in ipairs(strongMap[element] or {}) do
		table.insert(strong, e)
	end
	local weak = {}
	for attacker, list in pairs(strongMap) do
		for _, e in ipairs(list) do
			if e == element then
				table.insert(weak, attacker)
			end
		end
	end
	table.sort(weak)
	local parts = {}
	if #strong > 0 then
		table.insert(parts, "Strong vs " .. table.concat(strong, ", "))
	end
	if #weak > 0 then
		table.insert(parts, "Weak vs " .. table.concat(weak, ", "))
	end
	return table.concat(parts, "   " .. "/" .. "   ")
end

-- Power and Health are battle numbers (BattleCatalog.BattleStatsOf, so one window never shows two answers); Coins and Speed
-- stay the garden's. Writes into `stats`, a fresh table from PetCatalog.GetStats / StatsOf.
local function withBattleStats(stats, subject, level)
	if type(stats) == "table" and BattleCatalog and type(BattleCatalog.BattleStatsOf) == "function" then
		local ok, battle = pcall(BattleCatalog.BattleStatsOf, subject, level)
		if ok and type(battle) == "table" then
			stats.Power, stats.Health = battle.Power, battle.Health
		end
	end
	return stats
end

-- The highest shown stat of the catalog per key at level 1 (bar lengths are relative to it).
local function statMax()
	if S.StatMax then
		return S.StatMax
	end
	local out = {}
	local keys = PetCatalog.StatOrder or { "Income", "Power", "Health", "Speed" }
	for _, key in ipairs(keys) do
		out[key] = 1
	end
	if type(PetCatalog.GetStats) == "function" then
		for _, def in ipairs(PetCatalog.Pets or {}) do
			local ok, stats = pcall(PetCatalog.GetStats, def.Id, 1)
			if ok and type(stats) == "table" then
				withBattleStats(stats, def.Id, 1)
				for _, key in ipairs(keys) do
					local v = stats[key]
					if type(v) == "number" and v > out[key] then
						out[key] = v
					end
				end
			end
		end
	end
	S.StatMax = out
	return out
end

-- Where a pet can be found ("Cloud Roulette, Storm Roulette"), or nil.
local function sourcesText(def)
	if type(PetCatalog.PossiblePets) ~= "function" then
		return nil
	end
	local names = {}
	for _, roulette in ipairs(Config.Roulettes or {}) do
		local ok, list = pcall(PetCatalog.PossiblePets, roulette.Id)
		if ok and type(list) == "table" then
			for _, entry in ipairs(list) do
				if entry == def or (type(entry) == "table" and entry.Id == def.Id) then
					table.insert(names, roulette.DisplayName or roulette.Id)
					break
				end
			end
		end
	end
	if #names == 0 then
		return nil
	end
	return table.concat(names, ", ")
end

local function getClaimRemote()
	if claimRemote then
		return claimRemote
	end
	local ok, remote = pcall(Remotes.Get, "IndexClaim")
	if ok and remote then
		claimRemote = remote
	end
	return claimRemote
end

----------------------------------------------------------------------
-- Phase 2: fused pets (pet copy keys, shared/PetKeys through State)
----------------------------------------------------------------------
local FUSION_COLOR = Color3.fromRGB(150, 110, 232)
local TIER_COLORS = { Golden = Color3.fromRGB(246, 196, 64), Rainbow = Color3.fromRGB(226, 110, 214) }
local TIER_RANK = { Normal = 1, Golden = 2, Rainbow = 3 }

-- a catalog def, or the def of a pet copy key ("cat@Golden", "hyb:<uid>": tier finish / merged hybrid look)
local function defOf(id)
	if type(id) ~= "string" then
		return nil
	end
	local def = PetCatalog.Get(id)
	if def then
		return def
	end
	if type(State.DefOf) == "function" then
		local ok, derived = pcall(State.DefOf, id)
		if ok and type(derived) == "table" then
			return derived
		end
	end
	return nil
end

local function isHybridKey(key, def)
	if type(def) == "table" and def.IsHybrid == true then
		return true
	end
	return type(key) == "string" and key:sub(1, 4) == "hyb:"
end

local function tierOfKey(key, def)
	local t = type(def) == "table" and def.Tier or nil
	if t == "Golden" or t == "Rainbow" then
		return t
	end
	local suffix = type(key) == "string" and key:match("@(%a+)$") or nil
	if suffix == "Golden" or suffix == "Rainbow" then
		return suffix
	end
	return "Normal"
end

local function rarityRank(rarityId)
	for _, r in ipairs(Config.Rarities) do
		if r.Id == rarityId then
			return r.Order or 0
		end
	end
	return 0
end

-- the player's fused pets: hybrids first, then Rainbow and Golden copies, rarest first
local function fusionKeys()
	local keys = {}
	if type(State.Keys) == "function" then
		local ok, list = pcall(State.Keys)
		if ok and type(list) == "table" then
			keys = list
		end
	end
	local out, info = {}, {}
	for i, key in ipairs(keys) do
		if type(key) == "string" and not info[key] and (isHybridKey(key) or key:find("@", 1, true)) and State.OwnedCount(key) > 0 then
			local def = defOf(key)
			if def then
				info[key] = {
					Hybrid = isHybridKey(key, def) and 1 or 0,
					Tier = TIER_RANK[tierOfKey(key, def)] or 1,
					Rarity = rarityRank(def.Rarity),
					Index = i,
				}
				out[#out + 1] = key
			end
		end
	end
	table.sort(out, function(a, b)
		local x, y = info[a], info[b]
		if x.Hybrid ~= y.Hybrid then
			return x.Hybrid > y.Hybrid
		end
		if x.Tier ~= y.Tier then
			return x.Tier > y.Tier
		end
		if x.Rarity ~= y.Rarity then
			return x.Rarity > y.Rarity
		end
		return x.Index < y.Index
	end)
	return out
end

-- the defs of the player's fused pets (Id = the copy key) and a signature of the set (the grid is rebuilt when a
-- fusion adds or removes one while the Fusions tab is shown)
local function fusionDefs()
	local defs, ids = {}, {}
	for _, key in ipairs(fusionKeys()) do
		local def = defOf(key)
		if type(def) == "table" and type(def.Id) == "string" then
			defs[#defs + 1] = def
			ids[#ids + 1] = def.Id
		end
	end
	return defs, table.concat(ids, ",")
end

local function petLevelOf(key)
	if type(State.PetLevel) == "function" then
		local ok, level = pcall(State.PetLevel, key)
		if ok and type(level) == "number" then
			return math.max(1, math.floor(level))
		end
	end
	return 1
end

local function homeOf()
	if type(State.Home) == "function" then
		local ok, home = pcall(State.Home)
		if ok and type(home) == "table" then
			return home
		end
	end
	return { Prestige = 0, Stations = {} }
end

-- opens the Fusion Machine window (FusionController, loaded on demand: no require cycle at load time)
local function openFusionMachine()
	local module = script.Parent:FindFirstChild("FusionController")
	if not module then
		return
	end
	local ok, fusion = pcall(require, module)
	if ok and type(fusion) == "table" and type(fusion.Open) == "function" then
		IndexController.Close()
		pcall(fusion.Open, nil)
	end
end

-- true once the player owns the Fusion Machine station
local function hasFusionMachine()
	local home = homeOf()
	local stations = type(home.Stations) == "table" and home.Stations or {}
	return (tonumber(stations.FusionMachine) or 0) >= 1
end

-- the Home window (MenuController, required at click time: both modules are loaded by then, so no cycle)
local function openHomeWindow()
	local module = script.Parent:FindFirstChild("MenuController")
	if not module then
		return
	end
	local ok, menu = pcall(require, module)
	if ok and type(menu) == "table" and type(menu.Open) == "function" then
		IndexController.Close()
		pcall(menu.Open, "Home", {})
	end
end

----------------------------------------------------------------------
-- Visual helpers
----------------------------------------------------------------------
-- CloudUI.Pill with a text size that stays >= 14 px at the phone scale (0.8).
-- (kit-b U8) the kit B tag (was CloudUI.Pill's neon pill); 18 px
local function readablePill(text, kind, parent)
	return signPill(text, typeof(kind) == "Color3" and kind or SIGN.Stone, parent)
end

-- Small element chip with the element's drawn icon and its name (kit-b U8: CloudUI.ElementChip, the Pets cards' chip
-- with the name after the icon; was a rounded glossy pill).
local function elementPill(parent, element, textSize, layoutOrder)
	local chip = CloudUI.ElementChip(parent, element, (textSize or 17) + 9, {
		Label = element,
		TextSize = textSize or 17,
		Role = "Heading", -- (mixed case: "Celestial" fits a narrow tile at 18 px)
		Name = "Element_" .. element,
		LayoutOrder = layoutOrder or 0,
		ZIndex = 4,
	})
	if not chip then
		chip = signPill(element, elementColor(element), parent)
		chip.Name = "Element_" .. element
		chip.LayoutOrder = layoutOrder or 0
	end
	return chip
end

-- Confetti squares flying out of `centre` (a UDim2 inside `parent`).
local function burst(parent, color, amount, centre)
	local rng = Random.new()
	for i = 1, amount do
		local size = rng:NextInteger(8, 14)
		local pieceColor = color
		if i % 3 == 0 then
			pieceColor = GOLD
		elseif i % 3 == 1 then
			pieceColor = Theme.Lighten(color, 0.5)
		end
		local piece = makeFrame(parent, "Confetti", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = centre,
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 0,
			BackgroundColor3 = pieceColor,
			Rotation = rng:NextInteger(0, 90),
			ZIndex = 12,
		})
		corner(piece, "S")
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(60, 170)
		local target = UDim2.new(
			centre.X.Scale,
			centre.X.Offset + math.cos(angle) * distance,
			centre.Y.Scale,
			centre.Y.Offset + math.sin(angle) * distance * 0.7 - 20
		)
		local seconds = rng:NextNumber(0.6, 1.1)
		tween(piece, seconds, { Position = target, Rotation = piece.Rotation + rng:NextInteger(-200, 200) })
		tween(piece, seconds, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, seconds + 0.1)
	end
end

----------------------------------------------------------------------
-- Layout (readability rule + fit, keeps clear of the menu column)
----------------------------------------------------------------------
local function guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function viewportHeight()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return guiSize().Y
end

local function renderFooter()
	local total = totalPets()
	local unlocked = unlockedCount()
	if U.FooterText then
		U.FooterText.Text = string.format("Unlocked: %d/%d", unlocked, total)
		local n = U.FooterBlocks:GetAttribute("Count") or 10
		SignKit.FillBlocks(U.FooterBlocks, total > 0 and math.floor(unlocked / total * n) or 0)
		-- (playtest 2026-11-28 C45) rounded, not floored (1/35 read "2%"); 100% only once every pet is in
		local pct = total > 0 and math.floor(unlocked / total * 100 + 0.5) or 0
		U.FooterPercent.Text = string.format("%d%%", unlocked < total and math.min(pct, 99) or pct)
	end
	-- the compact layout has no footer: the title carries the count
	if U.Panel then
		if S.Short then
			if S.Tall then
				U.Panel.SetTitle(string.format("Pet Index %d/%d", unlocked, total))
			else
				U.Panel.SetTitle(string.format("Pet Index   Unlocked: %d/%d", unlocked, total))
			end
		else
			U.Panel.SetTitle("Pet Index")
		end
	end
end

local syncHud -- (LOOK-ui, kitb-look1) declared before fitWindow, which calls it (defined with the HUD helpers below)

-- Phase 5 (6.6): the window rule. NeonKit.Dock keeps the holder docked right (landscape) / a bottom sheet (portrait)
-- and returns its design size.
local function fitWindow()
	if not U.Dock then
		U.Dock = U.Kit.Dock(U.Holder, U.Fit, K.PREF_W, K.PREF_H)
	end
	U.Dock.Refresh()
	local r = U.Dock.Rect
	if S.Open and syncHud then
		syncHud() -- (LOOK-ui) the box moved: over the HUD's vitals / strips or clear of them now
	end
	return math.floor(r.designW + 0.5), math.floor(r.designH + 0.5)
end

-- (Pitch 2 F0 A: "one-line titles"; look review of finish pass A, major 5: COMMON PETS wrapped onto two lines at 1920) the
-- group's name on ONE line beside its progress: the biggest of K.HEADER_TITLE_SIZES that leaves the progress
-- K.HEADER_PROGRESS_MIN px of the header (S.HeaderW, design px), or the square meter's least room and its count when
-- that is more (fix round B); the progress takes the rest
local function fitHeader()
	local title = U.GroupTitle
	local track = U.Header and U.Header:FindFirstChild("Progress")
	local w = S.HeaderW
	if not (title and track and w and w > 0) then
		return
	end
	local extra = S.GroupId == FUSIONS and 30 or 0 -- (the sparkle mark before "Fusions")
	title.TextScaled = false
	title.TextWrapped = false
	local sc = SignKit.LayoutScale(title)
	-- (Pitch 2 fix round B, T1 look leftover 7) the count's room (the wider of its measure and the text it really draws,
	-- 10 px clear of the boxes) and the least the square meter needs: the title steps down before the boxes turn to pips
	local blocks, count = U.HeaderBlocks, U.HeaderCount
	local n = blocks and blocks:GetAttribute("Count") or 1
	local countW = K.HEADER_COUNT_W
	if count then
		local okC, mc = pcall(Theme.MeasureLabel, count, count.Text, count.TextSize)
		local okB, cb = pcall(function()
			return count.TextBounds.X / ((sc and sc > 0) and sc or 1)
		end)
		local textW = math.max(okC and mc and mc.X or 0, okB and cb or 0)
		countW = math.max(28, math.min(K.HEADER_COUNT_W, math.ceil(textW > 0 and textW or K.HEADER_COUNT_W - 10) + 10))
	end
	local meterMin = n * K.HEADER_BLOCK_MIN + (n - 1) * 2 + countW
	local room = w - 16 - 12 - 14 - math.max(K.HEADER_PROGRESS_MIN, meterMin)
	local size, tw = K.HEADER_TITLE_SIZES[#K.HEADER_TITLE_SIZES], 0
	for _, s in ipairs(K.HEADER_TITLE_SIZES) do
		-- the wider of the measure and the text the label really draws (its TextBounds, in its own px)
		title.TextSize = s
		local ok, m = pcall(Theme.MeasureLabel, title, title.Text, s)
		local okB, tb = pcall(function()
			return title.TextBounds.X / ((sc and sc > 0) and sc or 1)
		end)
		tw = math.max(ok and m and m.X or 0, okB and tb or 0) + extra
		size = s
		if tw <= room then
			break
		end
	end
	title.TextSize = size
	local boxW = math.max(0, math.min(room, math.ceil(tw) + 4))
	title.Size = UDim2.new(0, boxW, 1, 0)
	track.Size = UDim2.new(1, -(16 + boxW + 12 + 14), 0, 30)
	-- (Pitch 2 fix round B, T1 look leftover 7: on PC the blocks filled the track's width as thin pale pips, on a phone as
	-- flat bars) the meter is outlined SQUARE boxes (the F0 A mock): K.HEADER_BLOCK design px, smaller down to
	-- K.HEADER_BLOCK_MIN when the track is short, from the track's left; the count stays at its right end
	if blocks then
		local avail = (w - (16 + boxW + 12 + 14)) - countW
		-- the kit's Bar gap, 3 px, or its least, 2, when that makes room for the boxes
		local gap = 3
		local side = math.floor((avail - (n - 1) * gap) / n)
		if side < K.HEADER_BLOCK_MIN then
			gap = 2
			side = math.floor((avail - (n - 1) * gap) / n)
		end
		if side >= K.HEADER_BLOCK_MIN then
			side = math.min(K.HEADER_BLOCK, side)
			blocks:SetAttribute("Gap", gap)
			blocks.Size = UDim2.fromOffset(n * side + (n - 1) * gap, side)
		else
			blocks.Size = UDim2.new(1, -K.HEADER_COUNT_W - 6, 0, 18) -- (no room for boxes: the old fill)
		end
	end
end

-- (Pitch 2 item 12_index_badge B) a tab's bar row: the blocks and, in the count's place, the count, the waiting
-- reward's gold token chip or the claimed check. The chip and the check stand under the name row (S.TabH the tab's
-- height); the column's blocks give the chip its room, the strip's narrow tab drops them for it (the mock)
local function H_placeRow(tile)
	if not (tile and tile.Reward and tile.Claimed) then
		return
	end
	local tall = S.Tall == true
	local tabH = S.TabH or K.GROUP_TILE_H
	-- the name's drawn text ends 2 px over its box's foot (its box is 4 px taller than the text, from y 2)
	local nameBottom = 2 + 2 + (tall and 20 or 24)
	local h = math.max(16, math.min(24, tabH - 6 - nameBottom - 1))
	local size = math.max(16, math.min(19, h - 4))
	tile.Reward.TextSize = size
	local okM, m = pcall(function()
		return K.MEASURE and K.MEASURE(tile.Reward.Text, size, tile.Reward.Font) or Theme.MeasureLabel(tile.Reward, tile.Reward.Text, size).X
	end)
	local w = math.ceil(okM and tonumber(m) or (#tile.Reward.Text * size * 0.6)) + 18 + 4 + 14 -- the text, the token, its gap, the sides
	tile.Reward.Size = UDim2.fromOffset(w, h)
	tile.Reward.AnchorPoint = tall and Vector2.new(0, 1) or Vector2.new(1, 1)
	tile.Reward.Position = tall and UDim2.new(0, K.TAB_NAME_X, 1, -6) or UDim2.new(1, -8, 1, -6)
	tile.Claimed.Size = UDim2.fromOffset(h, h)
	local mark = tile.ClaimedMark
	if mark then
		mark.Position = UDim2.fromOffset(math.floor((h - 18) / 2), math.max(0, math.floor((h - 3 - 18) / 2)))
	end
	local track = tile.Blocks
	if track then
		local state = tile.State or "Count"
		track.Visible = not (tall and state == "Reward")
		local off = (state == "Reward" and (w + 28)) or (state == "Claimed" and (h + 28)) or 80
		track.Size = UDim2.new(1, -off, 0, 12)
	end
end

-- (12_index_badge B) the strip's page dots (a dot per strip-full of tabs, the one in view dark) and the snap: a swipe
-- that stops between two tabs settles on whole tabs (the strip's edge never cuts one at rest)
local function H_tabCount()
	local n = 0
	for _ in pairs(S.GroupTiles) do
		n = n + 1
	end
	return n + (S.FusionTile and 1 or 0)
end

-- (playtest 2026-11-28 C41) the strip canvas's units per design px: the window's resting scale (0.8 on a 360 px phone)
-- when the canvas counts screen px (its window size matches its screen size), else 1; the tab pitch is in design px, so
-- the snap, the dots and the reveal landed between tabs under a 0.8 window. Never the pop-in scale: it runs only while
-- the window opens, and a position outlives it
local function H_stripUnit()
	local list = U.GroupList
	local unit = math.max((U.Fit and U.Fit.Scale) or 1, 0.01)
	local okW, win = pcall(function()
		return list.AbsoluteWindowSize
	end)
	if okW and typeof(win) == "Vector2" and win.X > 0 and list.AbsoluteSize.X > 0 and win.X / list.AbsoluteSize.X < 0.98 then
		unit = 1
	end
	return unit
end

local function H_paintDots()
	local dots = U.PageDots
	if not (dots and S.Tall and S.StripN and S.StripTabW) then
		return
	end
	local pitch = (S.StripTabW + K.STRIP_GAP) * H_stripUnit()
	local idx = math.floor((U.GroupList.CanvasPosition.X) / pitch + 0.5)
	local pages = dots:GetAttribute("Pages") or 0
	local now = math.min(pages, math.floor(idx / S.StripN + 0.5) + 1)
	local last = math.max(0, H_tabCount() - S.StripN)
	if idx >= last and pages > 0 then
		now = pages
	end
	for i = 1, pages do
		local d = dots:FindFirstChild("Dot" .. i)
		if d then
			-- (look review r0) a dot not in view in the lit wood, so it reads on the stone (WellEdge was 2.1:1 there)
			d.BackgroundColor3 = (i == now) and INK or SIGN.WoodLight
		end
	end
	dots:SetAttribute("Page", now)
end

-- (look review r0) the dots' top in the strip: under the tabs' box (the strip less its foot), their edge and hard shadow,
-- and DOT_GAP of clear stone
local function H_dotsTop()
	return (K.STRIP_H - (S.StripFoot or 12)) + K.TAB_DRAWN + K.DOT_GAP
end

local function H_layoutDots(viewW)
	local dots = U.PageDots
	if not dots then
		return
	end
	dots.Visible = S.Tall == true
	if not S.Tall then
		return
	end
	local n = math.max(1, S.StripN or 1)
	local pages = math.max(1, math.ceil(H_tabCount() / n))
	-- (look review r0) under the tabs' drawn foot (their box, edge and hard shadow) by DOT_GAP, on clear stone
	local dw, gap, dh = K.DOT_W, 6, K.DOT_H
	for i = 1, math.max(pages, dots:GetAttribute("Pages") or 0) do
		local d = dots:FindFirstChild("Dot" .. i)
		if i <= pages then
			if not d then
				d = makeFrame(dots, "Dot" .. i, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.WoodLight, ZIndex = dots.ZIndex })
			end
			d.Position = UDim2.fromOffset((i - 1) * (dw + gap), 0)
			d.Size = UDim2.fromOffset(dw, dh)
		elseif d then
			d:Destroy()
		end
	end
	dots:SetAttribute("Pages", pages)
	local total = pages * dw + (pages - 1) * gap
	dots.Size = UDim2.fromOffset(total, dh)
	dots.AnchorPoint = Vector2.new(0.5, 0)
	dots.Position = UDim2.new(0, math.floor(K.STRIP_PAD_L + (viewW - K.STRIP_PAD_L) / 2), 0, H_dotsTop())
	H_paintDots()
end

local function H_snapStrip()
	local list = U.GroupList
	if not (list and S.Tall and S.StripTabW) then
		return
	end
	local pitch = (S.StripTabW + K.STRIP_GAP) * H_stripUnit() -- (playtest 2026-11-28 C41) in the canvas's units
	local x = list.CanvasPosition.X
	local last = math.max(0, H_tabCount() - (S.StripN or 1))
	local idx = math.max(0, math.min(last, math.floor(x / pitch + 0.5)))
	local want = idx * pitch
	if math.abs(want - x) > 0.5 then
		list.CanvasPosition = Vector2.new(want, list.CanvasPosition.Y)
	end
end

-- (Pitch 2 fix round B r1, look review major: at 844x390 the fitted tile's 52 px picture lay half under the Earth / Nature
-- tag, over the face's centre) the portrait starts this far down its picture, so the element tag covers at most a third
-- of it and never its centre (12_index_badge_optB: the tag above a clear portrait); 0 on a tall tile. For a tile
-- `cellH` design px tall; every built portrait moves with it (buildTileViewport reads S.PortraitTop)
local function H_seatPortraits(cellH)
	local art = cellH - K.TILE_ART_FOOT
	local top = math.max(0, math.ceil((3 * K.TAG_FOOT - art) / 2), 2 * K.TAG_FOOT - art)
	if S.PortraitTop == top then
		return
	end
	S.PortraitTop = top
	for _, tile in pairs(S.Tiles) do
		local frame = tile.Viewport and tile.Viewport.Frame
		if frame then
			frame.Position = UDim2.fromOffset(0, top)
			frame.Size = UDim2.new(1, 0, 1, -top)
		end
	end
end

-- (Pitch 2 fix round B, T1 look leftover 9) on a landscape phone the tiles are as tall as the grid's view allows (the
-- well less its 4 px inset each side and the grid's 8 px pads), down to K.TILE_H_LAND_MIN, so a whole row of tiles with
-- their names shows; anywhere else the layout's own height. Again whenever the well is resized
local function H_fitLandTiles()
	local layout, well = U.GridLayout, U.GridWell
	if not (layout and well and S.PetH) then
		return
	end
	local want = S.PetH
	if S.Land then
		local sc = SignKit.LayoutScale(well)
		local wellH = well.AbsoluteSize.Y / ((sc and sc > 0) and sc or 1)
		if wellH > 0 then
			want = math.max(K.TILE_H_LAND_MIN, math.min(S.PetH, math.floor(wellH - 8 - 16)))
		end
	end
	local cell = layout.CellSize
	if cell.Y.Offset ~= want then
		layout.CellSize = UDim2.fromOffset(cell.X.Offset, want)
	end
	H_seatPortraits(want)
end

local function relayout()
	if not S.Built then
		return
	end
	local w, h = fitWindow()

	-- narrow windows get narrower side columns, short ones the compact layout, tall ones (portrait phones) stack
	-- the group strip, the grid and the detail card
	local tall = w < K.TALL
	local narrow = w < K.NARROW
	local short = h < K.SHORT -- (Phase 5: a landscape-phone sheet is tall AND short: compact header, rewards, no footer)
	S.Narrow, S.Short, S.Tall = narrow, short, tall
	local groupW = narrow and K.GROUP_W_NARROW or K.GROUP_W
	local detailW = narrow and K.DETAIL_W_NARROW or K.DETAIL_W
	local headerH = short and K.HEADER_H_SHORT or K.HEADER_H
	local rewardH = short and K.REWARD_H_SHORT or K.REWARD_H
	local footerH = short and 0 or K.FOOTER_H
	S.HeaderW = (w - K.PANEL_INSET_W - 20) - (tall and 0 or (groupW + detailW + 2 * K.GAP)) -- the centre's width (fitHeader)
	U.Main.Size = UDim2.new(1, -20, 1, -(20 + footerH))
	U.Footer.Visible = not short
	-- (LOOK-ui) the footer's block bar: tenths where it has room, fifths on a narrow window (ten blocks were slivers)
	local footerBlocks = (w - K.PANEL_INSET_W - 370) >= 200 and 10 or 5
	if U.FooterBlocks and U.FooterBlocks:GetAttribute("Count") ~= footerBlocks then
		SignKit.SetBlockCount(U.FooterBlocks, footerBlocks)
		safe("footer", renderFooter)
	end
	if tall then
		-- top: a sideways strip of group tiles (+ Elements); then the centre (header, grid, rewards); the detail
		-- card fills the bottom
		local strip = K.STRIP_H
		U.Groups.Size = UDim2.new(1, 0, 0, strip)
		U.GroupLayout.FillDirection = Enum.FillDirection.Horizontal
		U.GroupLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		U.GroupLayout.VerticalAlignment = Enum.VerticalAlignment.Center
		U.GroupList.ScrollingDirection = Enum.ScrollingDirection.X
		-- (LOOK-ui) no bar under the sideways tab strip (a swipe moves it; the cut tile at its edge says there is more)
		SignKit.Scroll(U.GroupList, 0)
		U.GroupList.AutomaticCanvasSize = Enum.AutomaticSize.X
		U.GroupList.Size = UDim2.new(1, U.ElementsButton and -(K.ELEMENTS_STRIP_W + 8) or 0, 1, 0)
		U.GroupPad.PaddingTop = UDim.new(0, 0)
		-- (F0 review, major 7) the 12 px under the tabs held a scroll bar the strip no longer shows: on touch 8, so the tabs
		-- are K.TOUCH_H tall in the same strip
		local stripFoot = (UserInputService.TouchEnabled and K.STRIP_H - 8 >= K.TOUCH_H) and 8 or 12
		S.StripFoot = stripFoot
		U.GroupPad.PaddingBottom = UDim.new(0, stripFoot)
		U.GroupPad.PaddingLeft = UDim.new(0, K.STRIP_PAD_L)
		U.GroupPad.PaddingRight = UDim.new(0, 0)
		-- (look review r0) the centre keeps DOT_GAP of stone under the page dots (on touch the 56 px tabs leave them no
		-- room in the strip's 8 px foot)
		local centreTop = math.max(strip + 8, H_dotsTop() + K.DOT_H + K.DOT_GAP)
		-- Phase 5: a docked sheet is shorter; the grid gets 2/3 of it, and a landscape-phone window (< 600 design px
		-- tall) shows the grid only (the tiles carry name, rarity and element)
		local frac = (h < 600) and 0 or 0.34
		U.Detail.Visible = frac > 0
		U.Centre.Position = UDim2.new(0, 0, 0, centreTop)
		U.Centre.Size = UDim2.new(1, 0, 1 - frac, -centreTop)
		U.Detail.AnchorPoint = Vector2.new(0, 1)
		U.Detail.Position = UDim2.new(0, 0, 1, 0)
		U.Detail.Size = UDim2.new(1, 0, frac, -8)
	else
		U.Groups.Size = UDim2.new(0, groupW, 1, 0)
		U.GroupLayout.FillDirection = Enum.FillDirection.Vertical
		U.GroupLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		U.GroupLayout.VerticalAlignment = Enum.VerticalAlignment.Top
		U.GroupList.ScrollingDirection = Enum.ScrollingDirection.Y
		SignKit.Scroll(U.GroupList)
		U.GroupList.AutomaticCanvasSize = Enum.AutomaticSize.Y
		U.GroupPad.PaddingTop = UDim.new(0, 6)
		U.GroupPad.PaddingBottom = UDim.new(0, 6)
		U.GroupPad.PaddingLeft = UDim.new(0, 4)
		U.GroupPad.PaddingRight = UDim.new(0, 10)
		U.Detail.Visible = true
		U.Detail.AnchorPoint = Vector2.new(1, 0)
		U.Detail.Position = UDim2.new(1, 0, 0, 0)
		U.Detail.Size = UDim2.new(0, detailW, 1, 0)
		U.Centre.Position = UDim2.new(0, groupW + K.GAP, 0, 0)
		U.Centre.Size = UDim2.new(1, -(groupW + detailW + 2 * K.GAP), 1, 0)
	end
	-- (Pitch 2 fix round B, T1 look leftover 9: at 844x390 the grid's well was 68.8 px and no whole tile showed) a landscape
	-- phone (the stacked layout on a short window) gives the group header's row to the grid: the selected tab right above
	-- it carries the group's name, its blocks and its count (12_index_badge B); its tiles fit the well (H_fitLandTiles)
	local land = tall and short
	S.Land = land
	local headerRow = land and 0 or (headerH + 8)
	U.Header.Visible = not land
	U.Header.Size = UDim2.new(1, 0, 0, headerH)
	U.GridWell.Position = UDim2.fromOffset(0, headerRow)
	U.GridWell.Size = UDim2.new(1, 0, 1, -(headerRow + rewardH + 8))
	U.Rewards.Size = UDim2.new(1, 0, 0, rewardH)
	U.RewardSub.Visible = not short
	U.RewardLabel.Visible = not (short and narrow)
	-- (a landscape phone's grid well only has room for the empty Fusions card's title: no sparkle, no explanation)
	for _, part in ipairs({ "Glyph", "Body" }) do
		local child = U.FusionEmpty and U.FusionEmpty:FindFirstChild(part)
		if child then
			child.Visible = not short
		end
	end
	if short then
		U.RewardLabel.AnchorPoint = Vector2.new(0, 0.5)
		U.RewardLabel.Position = UDim2.new(0, 14, 0.5, 0)
		U.RewardAmount.AnchorPoint = Vector2.new(0, 0.5)
		U.RewardAmount.Position = UDim2.new(0, narrow and 14 or 128, 0.5, 0)
		U.RewardAmount.Size = UDim2.new(1, -(narrow and 180 or 294), 0, 34)
		U.ClaimButton.Size = UDim2.fromOffset(150, UserInputService.TouchEnabled and K.TOUCH_H or 52)
	else
		-- the reward box follows the centre's own width (a docked 1920x1080 window has a narrow centre between the
		-- group column and the detail card, like a portrait phone): a narrow centre gets the smaller CLAIM button,
		-- and when "Rewards:" and the amount do not both fit left of it the amount takes the label's place
		-- (Main is the window less the panel's content inset and its own 20 px)
		local mainW = w - K.PANEL_INSET_W - 20
		local centreW = tall and mainW or (mainW - groupW - detailW - 2 * K.GAP)
		local small = tall or centreW < K.REWARD_ROOMY_W
		local buttonW, buttonH = small and 150 or 184, small and 52 or 60
		if UserInputService.TouchEnabled then
			buttonH = math.max(buttonH, K.TOUCH_H) -- (F0 review, major 7) a thumb's Claim
		end
		local textW = math.max(0, centreW - 16 - (buttonW + 14 + 10)) -- the room left of the button
		if small and textW < K.REWARD_AMOUNT_W then
			-- (LOOK-ui: at 1080p the docked window sits at a whole scale of 1, a few px narrower) a narrower CLAIM before the
			-- amount is crowded
			buttonW = math.max(132, buttonW - (K.REWARD_AMOUNT_W - textW))
			textW = math.max(0, centreW - 16 - (buttonW + 14 + 10))
		end
		local withLabel = textW >= K.REWARD_LABEL_W + K.REWARD_AMOUNT_W
		U.RewardLabel.Visible = withLabel
		S.RewardLabelOk = withLabel
		U.RewardLabel.AnchorPoint = Vector2.new(0, 0)
		U.RewardLabel.Position = UDim2.fromOffset(16, 8)
		U.RewardAmount.AnchorPoint = Vector2.new(0, 0)
		U.RewardAmount.Position = UDim2.fromOffset(withLabel and (16 + K.REWARD_LABEL_W) or 16, 6)
		U.RewardAmount.Size = UDim2.new(0, math.max(0, withLabel and (textW - K.REWARD_LABEL_W) or textW), 0, 32)
		U.ClaimButton.Size = UDim2.fromOffset(buttonW, buttonH)
		S.RewardTextW = textW
	end
	if short then
		S.RewardLabelOk = not narrow
		S.RewardTextW = nil
	end
	U.View.Size = UDim2.new(1, 0, 0, (short or tall) and K.VIEW_H_SHORT or K.VIEW_H)
	local tileH = short and K.GROUP_TILE_H_SHORT or K.GROUP_TILE_H
	-- (kit-b U8) the strip shows a whole number of tabs: as many as fit at STRIP_TILE_MIN_W share the strip's width, so
	-- the strip's edge (and the Elements button beside it) never cuts one at rest (the owner's phone render: "UNCOMMON"
	-- half under the Elements button)
	local stripTabW = K.STRIP_TILE_W
	local stripViewW = 0
	if tall then
		local viewW = (w - K.PANEL_INSET_W - 20) - (U.ElementsButton and (K.ELEMENTS_STRIP_W + 8) or 0)
		local room = viewW - K.STRIP_PAD_L
		local n = math.max(1, math.floor((room + K.STRIP_GAP) / (K.STRIP_TILE_MIN_W + K.STRIP_GAP)))
		stripTabW = math.floor((room - (n - 1) * K.STRIP_GAP) / n)
		S.StripN, S.StripTabW, stripViewW = n, stripTabW, viewW -- (12_index_badge B) the snap and the page dots
	end
	S.TabH = tall and (K.STRIP_H - (S.StripFoot or 12)) or tileH
	local tileSize = tall and UDim2.new(0, stripTabW, 1, 0) or UDim2.new(1, -10, 0, tileH)
	-- the names sit at a fixed size (never TextScaled: it shrank "Uncommon" in the strip): 20 px in the strip, 24 px in
	-- the column, stepped down to NAME_MIN for a name that does not fit its row (U8 review: "Uncommon" and "Legendary" ran
	-- past the narrow column's box, and into the count in the strip). The row is one name tall from the top, so the
	-- count on the bar row below never meets it
	local tabW = tall and stripTabW or (groupW - U.GroupPad.PaddingLeft.Offset - U.GroupPad.PaddingRight.Offset - 10)
	local nameMax = tall and 20 or 24
	local nameRoom = tabW - K.TAB_NAME_X - K.TAB_BADGE_W
	local nameSize = UDim2.new(0, nameRoom, 0, nameMax + 4)
	local function placeName(label)
		local pad = label:FindFirstChildOfClass("UIPadding") -- (the Fusions sparkle's inset)
		local inset = pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0
		local size = nameMax
		while size > K.NAME_MIN do
			local w = K.MEASURE and K.MEASURE(label.Text, size, label.Font) or Theme.MeasureLabel(label, label.Text, size).X
			if inset + w + K.NAME_SPARE <= nameRoom then
				break
			end
			size = size - 1
		end
		label.Size = nameSize
		label.TextSize = size
	end
	for _, tile in pairs(S.GroupTiles) do
		tile.Button.Size = tileSize
		placeName(tile.Name)
		H_placeRow(tile)
	end
	if S.FusionTile then
		S.FusionTile.Button.Size = tileSize
		placeName(S.FusionTile.Name)
	end
	H_layoutDots(stripViewW)
	if U.ElementsButton then
		if tall then
			-- (12_index_badge B) the strip's end: fixed there, so the chart's entry point never scrolls away
			U.ElementsButton.Parent = U.Groups
			U.ElementsButton.ZIndex = 1
			U.ElementsButton.AnchorPoint = Vector2.new(1, 0)
			U.ElementsButton.Position = UDim2.new(1, 0, 0, 0)
			U.ElementsButton.Size = UDim2.new(0, K.ELEMENTS_STRIP_W, 1, -(S.StripFoot or 12))
		else
			-- (Pitch 2 item 12_index_badge B) the column layout: the plank in the Index's header by the X (the column's foot
			-- goes to the tabs). The X sits K.HEAD_CLOSE_R px from the right on the header's middle (CloudUI's Signboard)
			local buttonH = K.HEAD_PLANK_H
			if UserInputService.TouchEnabled then
				buttonH = math.max(buttonH, K.HEAD_PLANK_TOUCH_H)
			end
			U.ElementsButton.Parent = U.Panel.Root
			U.ElementsButton.ZIndex = 8
			U.ElementsButton.AnchorPoint = Vector2.new(1, 0.5)
			U.ElementsButton.Position = UDim2.new(1, -K.HEAD_PLANK_R, 0, K.HEAD_PLANK_Y)
			U.ElementsButton.Size = UDim2.fromOffset(K.HEAD_PLANK_W, buttonH)
			U.GroupList.Size = UDim2.new(1, 0, 1, 0)
		end
		-- (Pitch 2 F0 A, look review major 5) the plank carries its swap icon, as the mock's: led here, once the plank has
		-- its size and text (placed at build time it read the text before its size)
		PixelIcon.Lead(U.ElementsButton, ICON.Swap, { Px = 18 })
	end
	local petW = narrow and K.TILE_W_NARROW or K.TILE_W
	local petH = narrow and K.TILE_H_NARROW or K.TILE_H
	if short then
		petH = math.min(petH, K.TILE_H_SHORT)
	end
	U.GridLayout.CellSize = UDim2.fromOffset(petW, petH)
	S.PetH = petH
	H_fitLandTiles()
	fitHeader()
	renderFooter()
end

----------------------------------------------------------------------
-- Back button (gamepad B) while the window is open
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		if U.ElementsWin and U.ElementsWin.IsOpen() then
			U.ElementsWin.Close() -- (12_elements) back to the Index first
		else
			IndexController.Close()
		end
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function syncBackBinding()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		local ok, err = pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
		if not ok then
			warnOnce("bind back", err)
		end
	else
		task.defer(function()
			if not S.BackBound then
				pcall(function()
					ContextActionService:UnbindAction(K.BACK_ACTION)
				end)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Group list (left)
----------------------------------------------------------------------
local refreshAll, selectGroup, selectPet, renderDetail, showElements, revealGroupTile, H_paintTab, syncTouch

local function buildGroupTile(group, index)
	local color = rarityColor(group.Rarity)
	local accent = rarityAccent(group.Rarity)
	local tile = { Group = group, Lip = color }
	local button = Util.Create("TextButton", {
		Name = "Group_" .. group.Id,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Size = UDim2.new(1, -10, 0, K.GROUP_TILE_H),
		LayoutOrder = index,
		Parent = U.GroupList,
	})
	-- (kit-b U8) a signboard tab: a stone tab, the rarity on its lip (refreshGroupTiles gold-faces the selected one)
	CloudUI.SignBlock(button, "Stone", { Face = SIGN.Tile, LipColor = color, Pad = false })
	button:SetAttribute("Rarity", group.Rarity)
	-- name on top, then a slim progress bar with the "3/6" count at its right end (kit-b U6: a card name is a Heading, the
	-- Title face's capitals would not fit "LEGENDARY" in the narrow phone tile); U8: brown on the stone at a fixed size
	-- (relayout: 24 px in the column, 20 in the strip, smaller when a name needs it; its row stops at the badge corner)
	tile.Name = makeText(button, "GroupName", group.Rarity, "Heading", 24, INK, {
		Position = UDim2.fromOffset(K.TAB_NAME_X, 2),
		Size = UDim2.new(1, -(K.TAB_NAME_X + K.TAB_BADGE_W), 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})
	tile.Progress = makeText(button, "Progress", "0/0", "Heading", 19, MUTED, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -7),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 2,
	})
	-- (LOOK-ui, kitb-look1: every bar in the block-bar language) one small block per pet of the group (H.blockCount), the
	-- found ones in the rarity's colour
	tile.Blocks = SignKit.FitBlocks(button, {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.new(1, -80, 0, 12),
		Count = H_blockCount(#(group.Pets or {})),
		Gap = 2,
		Weight = "Bar",
		Fill = accent,
		FillLip = Theme.Darken(accent, 0.25),
		ZIndex = 2,
	})
	-- (Pitch 2 item 12_index_badge, the owner's pick B "Reward on the row") no badge on the title row (it poked over the
	-- tab and the list clipped it): a waiting reward is a gold token chip "+800" in the count's place (gold: it is tokens),
	-- a claimed group a grass check there. relayout sizes and places both; refreshGroupTiles shows one or the other
	tile.Reward = makeText(button, "Reward", "", "Heading", 18, INK, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(84, 24),
		Visible = false,
		ZIndex = 3,
	})
	CloudUI.SignBlock(tile.Reward, "Selected", { Face = GOLD, LipColor = SIGN.GoldLip, EdgePx = 2, LipPx = 3 })
	PixelIcon.Lead(tile.Reward, "token", { Px = 18 })
	tile.Claimed = makeFrame(button, "Claimed", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(24, 24),
		Visible = false,
		ZIndex = 3,
	})
	CloudUI.SignBlock(tile.Claimed, "Stone", { Face = SIGN.Grass, LipColor = SIGN.GrassLip, EdgePx = 2, LipPx = 3, Pad = false })
	tile.ClaimedMark = PixelIcon.New(tile.Claimed, ICON.Check, 18, INK)
	if tile.ClaimedMark then
		tile.ClaimedMark.Position = UDim2.fromOffset(3, 1)
		tile.ClaimedMark.ZIndex = 4
		for _, c in ipairs(tile.ClaimedMark:GetChildren()) do
			if c:IsA("GuiObject") then
				c.ZIndex = 4
			end
		end
	end
	tile.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = button })
	button.MouseEnter:Connect(function()
		tween(tile.Pop, 0.12, { Scale = 1.03 })
	end)
	button.MouseLeave:Connect(function()
		tween(tile.Pop, 0.12, { Scale = 1 })
	end)
	button.Activated:Connect(function()
		safe("select group", selectGroup, group.Id)
	end)
	tile.Button = button
	S.GroupTiles[group.Id] = tile
	return tile
end

-- The "Fusions" tile under the rarity groups (not a reward group): the player's hybrids and Golden / Rainbow copies.
local function buildFusionTile(index)
	local tile = { Lip = FUSION_COLOR }
	local button = Util.Create("TextButton", {
		Name = "Group_" .. FUSIONS,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		Size = UDim2.new(1, -10, 0, K.GROUP_TILE_H),
		LayoutOrder = index,
		Parent = U.GroupList,
	})
	-- (kit-b U8) the same signboard tab, the fusion violet on its lip and the sparkle before the name
	CloudUI.SignBlock(button, "Stone", { Face = SIGN.Tile, LipColor = FUSION_COLOR, Pad = false })
	tile.Name = makeText(button, "GroupName", "Fusions", "Heading", 24, INK, { -- (a card name, like the rarity tiles)
		Position = UDim2.fromOffset(K.TAB_NAME_X, 2),
		Size = UDim2.new(1, -(K.TAB_NAME_X + K.TAB_BADGE_W), 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})
	PixelIcon.Lead(tile.Name, ICON.Sparkle)
	tile.Progress = makeText(button, "Progress", "", "Heading", 19, MUTED, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -7),
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	})
	tile.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = button })
	button.MouseEnter:Connect(function()
		tween(tile.Pop, 0.12, { Scale = 1.03 })
	end)
	button.MouseLeave:Connect(function()
		tween(tile.Pop, 0.12, { Scale = 1 })
	end)
	button.Activated:Connect(function()
		safe("select group", selectGroup, FUSIONS)
	end)
	tile.Button = button
	S.FusionTile = tile
	return tile
end

-- (kit-b U8) a tab's look: stone, or gold-faced with the ink edge when it is the shown group; the lip keeps its rarity
function H_paintTab(tile, selected)
	CloudUI.SignBlock(tile.Button, "Stone", {
		Face = selected and SIGN.Selected or SIGN.Tile,
		Edge = selected and INK or nil,
		LipColor = tile.Lip,
		Pad = false,
	})
	tile.Button:SetAttribute("Selected", selected)
end

local function refreshGroupTiles()
	for _, group in ipairs(S.Groups) do
		local tile = S.GroupTiles[group.Id]
		if tile then
			local found, total, complete, claimed, claimable = groupStatus(group)
			tile.Progress.Text = string.format("%d/%d", found, total)
			H_fillBlocks(tile.Blocks, found, total)
			local selected = S.GroupId == group.Id
			H_paintTab(tile, selected)
			-- (12_index_badge B) the count, the waiting reward's chip or the claimed check: one of them on the bar row
			local state = claimable and "Reward" or (claimed and "Claimed" or "Count")
			tile.Reward.Text = "+" .. Theme.Short(rewardTokens(group))
			tile.Reward.Visible = state == "Reward"
			tile.Claimed.Visible = state == "Claimed"
			tile.Progress.Visible = state == "Count"
			tile.Button:SetAttribute("RowState", state)
			if tile.State ~= state or tile.RewardText ~= tile.Reward.Text then
				tile.State, tile.RewardText = state, tile.Reward.Text
				H_placeRow(tile)
			end
			tile.Progress.TextColor3 = complete and INK or MUTED
		end
	end
	local fusionTile = S.FusionTile
	if fusionTile then
		local n = #fusionKeys()
		fusionTile.Progress.Text = n == 1 and "1 fused pet" or (n .. " fused pets")
		H_paintTab(fusionTile, S.GroupId == FUSIONS)
	end
end

----------------------------------------------------------------------
-- Pet grid (centre)
----------------------------------------------------------------------
local function destroyTileViewport(tile)
	if tile.Viewport then
		pcall(tile.Viewport.Destroy)
		tile.Viewport = nil
	end
end

local function paintTile(tile)
	local def = tile.Def
	local discovered = State.IsDiscovered(def.Id)
	local selected = S.PetId == def.Id
	-- (kit-b U8) the Pets window's card: stone, the selected one gold-faced with the ink edge, the rarity on the lip
	CloudUI.SignBlock(tile.Button, "Stone", {
		Face = selected and SIGN.Selected or SIGN.Tile,
		Edge = selected and INK or nil,
		LipColor = rarityColor(def.Rarity),
		LipPx = K.TILE_LIP,
		Pad = false,
	})
	tile.Button:SetAttribute("Rarity", def.Rarity)
	if discovered then
		-- fused copies show the pet's own name: the chip carries the tier ("Golden Pebble Pup" needs three lines)
		if tile.FusionChip and not isHybridKey(def.Id, def) then
			tile.Caption.Text = def.Name or def.DisplayName
		else
			tile.Caption.Text = def.DisplayName or def.Name
		end
		tile.Caption.TextColor3 = INK
	else
		tile.Caption.Text = "???"
		tile.Caption.TextColor3 = MUTED
	end
	if tile.Viewport then
		local frame = tile.Viewport.Frame
		if frame then
			frame.ImageColor3 = discovered and Color3.new(1, 1, 1) or SILHOUETTE
		end
		local best = discovered and type(State.BestStage) == "function" and (tonumber(State.BestStage(def.Id)) or 0) or 0
		if tile.BuiltDiscovered ~= discovered or (tile.BuiltStage ~= nil and tile.BuiltStage ~= best) then
			-- the pet was just discovered (or evolved): rebuild with the new settings
			destroyTileViewport(tile)
		elseif discovered then
			tile.Viewport.SetAnimated(selected or tile.Hover)
		end
	end
	-- element badge, only once discovered (the tile has room for one; the detail card lists them all)
	local elements = discovered and elementsOf(def) or {}
	if #elements > 1 then
		elements = { elements[1] }
	end
	local key = table.concat(elements, ",")
	if tile.ElementKey ~= key then
		tile.ElementKey = key
		for _, child in ipairs(tile.Elements:GetChildren()) do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		-- (kit-b, owner's reskin rule: the tile names its element as before kit B) the element's name on its stone tag
		-- after a stripe of its colour (CloudUI.ElementChip Icon = false). (LOOK-ui, kitb-look1: "Nature" ran 5 px past a
		-- 91 px card with the icon square before it; the square and "Celestial" at 18 px never fit one card) the icon is in
		-- the detail's chip
		for i, element in ipairs(elements) do
			local chip = CloudUI.ElementChip(tile.Elements, element, 26, {
				Label = element,
				TextSize = 18,
				Role = "Heading",
				Icon = false,
				Name = "Element_" .. element,
				LayoutOrder = i,
				ZIndex = 4,
			})
			if not chip then
				elementPill(tile.Elements, element, 18, i)
			end
		end
	end
	-- fused pets: a tier / hybrid chip (top-right) and the copy's level
	if tile.FusionChip then
		local tier = tierOfKey(def.Id, def)
		local hybrid = isHybridKey(def.Id, def)
		tile.FusionChip.Visible = hybrid or tier ~= "Normal"
		tile.FusionChip.BackgroundColor3 = hybrid and FUSION_COLOR or (TIER_COLORS[tier] or GOLD)
		tile.FusionText.Text = hybrid and "H" or (tier == "Rainbow" and "R" or "G")
		tile.FusionText.TextColor3 = Theme.TextOn(tile.FusionChip.BackgroundColor3)
		local level = petLevelOf(def.Id)
		tile.LevelTag.Text = "Lv " .. level
		tile.LevelTag.Visible = level > 1
	end
end

local function buildTileViewport(tile)
	local def = tile.Def
	local discovered = State.IsDiscovered(def.Id)
	-- Phase 5 (3.7): the best stage over the owned copies of this pet (undiscovered: 0); evolved = Low
	local stage = discovered and type(State.BestStage) == "function" and (tonumber(State.BestStage(def.Id)) or 0) or 0
	local top = S.PortraitTop or 0 -- (fix round B r1) the portrait clear of the element tag (H_seatPortraits)
	local handle = CloudUI.PetViewport(tile.Art, def, UDim2.new(1, 0, 1, -top), {
		Position = UDim2.fromOffset(0, top),
		Animate = false,
		Spin = discovered and "sway" or "none",
		Evolved = stage >= 1 and stage or nil,
		Detail = stage >= 1 and "Low" or nil,
		ZIndex = 3,
	})
	tile.BuiltStage = stage
	if not handle then
		return
	end
	if handle.Frame then
		handle.Frame.ImageColor3 = discovered and Color3.new(1, 1, 1) or SILHOUETTE
	end
	tile.Viewport = handle
	tile.BuiltDiscovered = discovered
	if discovered and (S.PetId == def.Id or tile.Hover) then
		handle.SetAnimated(true)
	end
end

-- Attaches the missing viewports while the window is open, under the per-frame time budget (K.TILE_BUDGET).
local function fillViewports()
	if S.Filling then
		return
	end
	S.Filling = true
	task.spawn(function()
		task.wait() -- the frame that opens the window already builds it (and the detail card's pet)
		while S.Open do
			local built, start, more = 0, os.clock(), false
			for _, id in ipairs(S.TileOrder) do
				local tile = S.Tiles[id]
				if tile and not tile.Viewport and tile.Button.Parent and (built >= K.TILES_MAX or (built > 0 and os.clock() - start >= K.TILE_BUDGET)) then
					more = true
					break
				end
				if tile and not tile.Viewport and tile.Button.Parent then
					local ok, err = pcall(buildTileViewport, tile)
					if not ok or not tile.Viewport then
						-- never retry a broken build every frame: park a no-op handle
						if not ok then
							warnOnce("tile viewport", err)
						end
						tile.Viewport = { Destroy = function() end, SetAnimated = function() end }
						tile.BuiltDiscovered = State.IsDiscovered(id)
					end
					built = built + 1
				end
			end
			if not more then
				break
			end
			task.wait()
		end
		S.Filling = false
	end)
end

local function clearTiles()
	for _, tile in pairs(S.Tiles) do
		destroyTileViewport(tile)
		tile.Button:Destroy()
	end
	S.Tiles = {}
	S.TileOrder = {}
end

local function buildTile(def, index)
	local tile = { Def = def, Hover = false }
	local button = Util.Create("TextButton", {
		Name = "IndexPet_" .. def.Id,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		LayoutOrder = index,
		Parent = U.Grid,
	})
	tile.Button = button
	-- (kit-b U8) the pet stands in its light well (paintTile paints the card and its rarity lip)
	tile.Art = makeFrame(button, "Art", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(1, -8, 1, -K.TILE_ART_FOOT),
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.PetWell,
		ZIndex = 2,
	})
	local band = makeFrame(button, "NameBand", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(K.TILE_LIP + 1)),
		Size = UDim2.new(1, -10, 0, 40),
		ZIndex = 3,
	})
	-- 18 design px on up to two lines: never under 14 px at the phone scale (readability rule)
	tile.Caption = makeText(band, "Caption", "???", "Heading", 18, INK, {
		Position = UDim2.fromOffset(3, 0),
		Size = UDim2.new(1, -6, 1, 0),
		TextWrapped = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
		LineHeight = 0.92,
		ZIndex = 4,
	})
	tile.Elements = makeFrame(button, "Elements", {
		Position = UDim2.fromOffset(7, 7), -- (LOOK-ui) where the Pets card's corner chip sits
		Size = UDim2.new(1, -14, 0, 28),
		ZIndex = 4,
	})
	listLayout(tile.Elements, Enum.FillDirection.Horizontal, 3, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	if S.GroupId == FUSIONS then
		local chip = makeFrame(button, "FusionBadge", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -7, 0, 7),
			Size = UDim2.fromOffset(28, 28),
			BackgroundTransparency = 0,
			BackgroundColor3 = FUSION_COLOR,
			ZIndex = 5,
		})
		edge(chip, SIGN.Wood, 2)
		tile.FusionChip = chip
		tile.FusionText = makeText(chip, "Mark", "", "Button", 18, INK, { Size = UDim2.new(1, 0, 1, 0), ZIndex = 6 })
		tile.LevelTag = makeText(button, "LevelTag", "", "Heading", 18, INK, {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -8, 1, -48),
			Size = UDim2.fromOffset(70, 22),
			TextXAlignment = Enum.TextXAlignment.Right,
			Visible = false,
			ZIndex = 5,
		})
	end
	tile.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = button })
	button.MouseEnter:Connect(function()
		tile.Hover = true
		tween(tile.Pop, 0.12, { Scale = 1.03 })
		if tile.Viewport and tile.BuiltDiscovered then
			tile.Viewport.SetAnimated(true)
		end
	end)
	button.MouseLeave:Connect(function()
		tile.Hover = false
		tween(tile.Pop, 0.12, { Scale = 1 })
		if tile.Viewport and tile.BuiltDiscovered then
			tile.Viewport.SetAnimated(S.PetId == def.Id)
		end
	end)
	button.Activated:Connect(function()
		safe("select pet", selectPet, def.Id)
	end)
	S.Tiles[def.Id] = tile
	table.insert(S.TileOrder, def.Id)
	paintTile(tile)
	return tile
end

local function refreshTiles()
	for _, tile in pairs(S.Tiles) do
		paintTile(tile)
	end
	fillViewports()
end

local function renderHeader()
	if S.GroupId == FUSIONS then
		local n = #S.TileOrder
		U.GroupTitle.Text = "Fusions"
		PixelIcon.Mark(U.GroupTitle, ICON.Sparkle) -- (kit-b U7b)
		U.GroupTitle.TextColor3 = INK
		SignKit.SetBlockCount(U.HeaderBlocks, 1, FUSION_COLOR, Theme.Darken(FUSION_COLOR, 0.25))
		SignKit.FillBlocks(U.HeaderBlocks, n > 0 and 1 or 0)
		U.HeaderCount.Text = n == 1 and "1 fused pet" or (n .. " fused pets")
		fitHeader()
		return
	end
	local group = S.GroupById[S.GroupId]
	if not group then
		return
	end
	local found, total, complete = groupStatus(group)
	local accent = rarityAccent(group.Rarity)
	U.GroupTitle.Text = group.Rarity .. " Pets"
	PixelIcon.Mark(U.GroupTitle, nil)
	U.GroupTitle.TextColor3 = INK
	local lit = complete and SIGN.Grass or accent
	SignKit.SetBlockCount(U.HeaderBlocks, H_blockCount(total), lit, complete and SIGN.GrassLip or Theme.Darken(lit, 0.25))
	H_fillBlocks(U.HeaderBlocks, found, total)
	U.HeaderCount.Text = string.format("%d/%d", found, total)
	fitHeader()
end

local function renderRewards()
	if S.GroupId == FUSIONS then
		-- fusions are not a reward group: how to fuse, and the way to the Fusion Machine (or to the Home window
		-- that builds it / shows the prestige progress)
		local home = homeOf()
		local machine = hasFusionMachine()
		local stars = tonumber(home.Prestige) or 0
		U.RewardLabel.Visible = false
		U.RewardAmount.Visible = false
		U.AmountCaption.Visible = false
		U.RewardSub.Visible = true
		local compact = S.Short or S.Tall
		U.RewardSub.Position = UDim2.fromOffset(16, compact and 4 or 8)
		U.RewardSub.Size = UDim2.new(1, -(compact and 182 or 230), 1, compact and -8 or -16)
		if S.RewardTextW and not S.Short then
			-- (the same room as the reward line: left of the button)
			U.RewardSub.Size = UDim2.new(0, S.RewardTextW, 1, compact and -8 or -16)
		end
		if machine then
			U.RewardSub.Text = "Fuse 3 copies into Golden (x1.5), 3 Golden into Rainbow (x2.5), or mix two pets into a hybrid!"
		elseif stars >= 1 then
			U.RewardSub.Text = "Build the Fusion Machine at home for Golden, Rainbow and hybrid pets!"
		else
			U.RewardSub.Text = "Reach Prestige 1 at home to unlock the Fusion Machine!"
		end
		U.RewardSub.TextColor3 = MUTED
		local button = U.ClaimButton
		button.Text = machine and "Fuse pets" or "My Home"
		CloudUI.SetStyle(button, "Green") -- (kit-b U8) the tab's one main action
		CloudUI.SetDisabled(button, false)
		return
	end
	local group = S.GroupById[S.GroupId]
	if not group then
		return
	end
	-- back from the Fusions tab: the reward box's own layout
	U.RewardAmount.Visible = true
	U.RewardLabel.Visible = S.RewardLabelOk ~= false
	-- (the line under the amount, two lines at most, only when it is wide enough to read)
	local subW = S.RewardTextW
	U.RewardSub.Visible = not S.Short and subW ~= nil and subW >= K.REWARD_SUB_MIN_W
	U.RewardSub.Position = UDim2.fromOffset(16, 44)
	U.RewardSub.Size = UDim2.new(0, subW or 0, 0, 44)
	local found, total, complete, claimed, claimable = groupStatus(group)
	U.RewardAmount.Text = commas(rewardTokens(group))
	-- the short caption under the amount where the long line has no room (not on a short window's one-row box)
	local capOn = not U.RewardSub.Visible and not S.Short and not claimed and not claimable
	U.AmountCaption.Visible = capOn
	if capOn then
		U.AmountCaption.Text = string.format("at %d / %d", total, total)
		local pad = U.RewardAmount:FindFirstChildOfClass("UIPadding")
		local ax = U.RewardAmount.Position.X.Offset + (pad and pad.PaddingLeft.Offset or 0)
		U.AmountCaption.Position = UDim2.fromOffset(ax, U.RewardAmount.Position.Y.Offset + 36)
		U.AmountCaption.Size = UDim2.fromOffset(math.max(60, (S.RewardTextW or 160) - (ax - 16)), 22)
	end
	local button = U.ClaimButton
	local pending = S.ClaimPending == group.Id and not claimed
	if claimed then
		U.RewardSub.Text = "Reward claimed. Great collecting!"
		button.Text = "Claimed"
		CloudUI.SetStyle(button, "Gray")
		CloudUI.SetDisabled(button, true)
	elseif pending then
		U.RewardSub.Text = "Claiming your reward..."
		button.Text = "..."
		CloudUI.SetStyle(button, "Green")
		CloudUI.SetDisabled(button, true)
	elseif claimable then
		U.RewardSub.Text = "Every " .. group.Rarity .. " pet found. Claim it!"
		button.Text = "Claim"
		CloudUI.SetStyle(button, "Green")
		CloudUI.SetDisabled(button, false)
	else
		U.RewardSub.Text = string.format("Discover all %d %s pets (%d to go).", total, group.Rarity, total - found)
		button.Text = "Claim"
		CloudUI.SetStyle(button, "Gray")
		CloudUI.SetDisabled(button, true)
	end
	U.RewardSub.TextColor3 = claimable and INK or MUTED
	-- (kit-b U8) no glow pulses behind the button any more: a waiting reward is the green CLAIM block and the tab's red "!"
end

----------------------------------------------------------------------
-- Detail card (right)
----------------------------------------------------------------------
local function clearDetailPills()
	for _, pill in ipairs(S.DetailPills) do
		if pill.Parent then
			pill:Destroy()
		end
	end
	S.DetailPills = {}
end

function renderDetail()
	local def = S.PetId and defOf(S.PetId) or nil
	if not def then
		U.DetailBody.Visible = false
		U.DetailEmpty.Visible = true
		if S.DetailViewport then
			pcall(S.DetailViewport.Destroy)
			S.DetailViewport = nil
			S.DetailKey = nil
		end
		return
	end
	U.DetailBody.Visible = true
	U.DetailEmpty.Visible = false
	local discovered = State.IsDiscovered(def.Id)

	-- viewport: spinning when discovered, a still black silhouette otherwise
	local best = discovered and type(State.BestStage) == "function" and (tonumber(State.BestStage(def.Id)) or 0) or 0
	local key = def.Id .. "|" .. tostring(discovered) .. "|" .. best
	if S.DetailKey ~= key then
		if S.DetailViewport then
			pcall(S.DetailViewport.Destroy)
			S.DetailViewport = nil
		end
		local ok, handle = pcall(CloudUI.PetViewport, U.ViewHolder, def, UDim2.new(1, 0, 1, 0), {
			Animate = discovered,
			Spin = discovered and "spin" or "none",
			Evolved = best >= 1 and best or nil, -- Phase 5 (3.7): your best copy's look
			Detail = best >= 1 and "Low" or nil,
			ZIndex = 4,
		})
		if ok and handle then
			S.DetailViewport = handle
			if handle.Frame then
				handle.Frame.ImageColor3 = discovered and Color3.new(1, 1, 1) or SILHOUETTE
			end
		else
			warnOnce("detail viewport", handle)
		end
		S.DetailKey = key
	end
	U.Mystery.Visible = not discovered

	-- Stormfang (the player's own creature) shows its 2D art once discovered
	local art = Config.Art and Config.Art.StormfangImage
	U.Banner.Visible = discovered and def.Id == "stormfang" and type(art) == "string" and art ~= ""
	if U.Banner.Visible then
		U.Banner.Image = art
	end

	U.Name.Text = discovered and (def.DisplayName or def.Name) or "???"
	local tier = tierOfKey(def.Id, def)
	local hybrid = isHybridKey(def.Id, def)
	local fused = hybrid or tier ~= "Normal"
	U.Name.TextColor3 = discovered and INK or MUTED

	-- meta: rarity, element and role pills (rebuilt only when they change)
	local elements = discovered and elementsOf(def) or {}
	local role = discovered and def.Role or nil
	local pillKey = tostring(def.Rarity) .. "|" .. table.concat(elements, ",") .. "|" .. tostring(role) .. "|" .. tier .. "|" .. tostring(hybrid)
	if S.PillKey ~= pillKey then
		S.PillKey = pillKey
		clearDetailPills()
		local rarityPill = readablePill(def.Rarity, rarityColor(def.Rarity), U.Meta)
		rarityPill.LayoutOrder = 1
		table.insert(S.DetailPills, rarityPill)
		if tier ~= "Normal" then
			local tierPill = readablePill(tier, TIER_COLORS[tier] or GOLD, U.Meta)
			tierPill.LayoutOrder = 2
			table.insert(S.DetailPills, tierPill)
		end
		if hybrid then
			local hybridPill = readablePill("Hybrid", FUSION_COLOR, U.Meta)
			hybridPill.LayoutOrder = 3
			table.insert(S.DetailPills, hybridPill)
		end
		for i, element in ipairs(elements) do
			table.insert(S.DetailPills, elementPill(U.Meta, element, 18, 1 + i))
		end
		if role then
			local rolePill = readablePill(role, ROLE_COLORS[role] or SIGN.Sky, U.Meta)
			rolePill.LayoutOrder = 50
			table.insert(S.DetailPills, rolePill)
		end
	end
	U.RoleBlurb.Visible = role ~= nil
	if role then
		local blurbs = PetCatalog.RoleBlurbs or {}
		U.RoleBlurb.Text = blurbs[role] or ""
	end

	-- stats: real numbers once discovered, locked "?" rows before
	local stats = nil
	if discovered and fused and type(PetCatalog.StatsOf) == "function" then
		-- a fused copy: its stats at its own level x its tier (a hybrid's merged stats)
		local level = petLevelOf(def.Id)
		local ok, result = pcall(PetCatalog.StatsOf, def, level)
		if ok and type(result) == "table" then
			stats = withBattleStats(result, def, level)
		end
	elseif discovered and type(PetCatalog.GetStats) == "function" then
		local ok, result = pcall(PetCatalog.GetStats, def.Id, 1)
		if ok and type(result) == "table" then
			stats = withBattleStats(result, def.Id, 1)
		end
	end
	local maxes = statMax()
	for statKey, row in pairs(U.StatRows) do
		local value = stats and stats[statKey]
		if type(value) == "number" then
			row.Value.Text = commas(math.floor(value + 0.5))
			row.Value.TextColor3 = INK
			-- (a stat above zero lights one block at least)
			SignKit.FillBlocks(row.Fill, math.max(value > 0 and 1 or 0, math.floor(Util.Clamp(value / (maxes[statKey] or 1), 0, 1) * 5 + 0.5)))
		else
			row.Value.Text = "?"
			row.Value.TextColor3 = MUTED
			SignKit.FillBlocks(row.Fill, 0)
		end
	end

	-- special attack
	local special = discovered and type(def.Special) == "table" and def.Special or nil
	U.Special.Visible = special ~= nil
	if special then
		U.SpecialName.Text = tostring(special.Name or "Special")
		U.SpecialKind.Text = tostring(special.Kind or "")
		U.SpecialKind.Visible = special.Kind ~= nil
	end

	-- element matchups
	local matchups = {}
	for _, element in ipairs(elements) do
		local text = matchupText(element)
		if text ~= "" then
			table.insert(matchups, element .. ": " .. text)
		end
	end
	U.Matchup.Visible = #matchups > 0
	U.Matchup.Text = table.concat(matchups, "\n")

	-- blurb or how to find it
	if discovered then
		local text = tostring(def.Blurb or "")
		if hybrid then
			-- PetKeys' hybrid blurb names both parents ("A fusion of Maple Fox and Storm Tabby.")
			text = text .. " One of a kind: its parents' average stats x1.2."
		elseif tier ~= "Normal" then
			text = "A " .. tier .. " copy: x" .. (tier == "Rainbow" and "2.5" or "1.5") .. " stats and perks. " .. text
		end
		U.Info.Text = text
		U.Info.TextColor3 = INK
		local owned = State.OwnedCount(def.Id)
		U.Owned.Visible = true
		if owned > 0 and fused then
			U.Owned.Text = "Lv " .. petLevelOf(def.Id) .. "   " .. string.char(226, 128, 162) .. "   You own x" .. owned
			U.Owned.TextColor3 = INK
		elseif owned > 0 then
			U.Owned.Text = "You own x" .. owned
			U.Owned.TextColor3 = INK
		else
			U.Owned.Text = "Discovered"
			U.Owned.TextColor3 = MUTED
		end
	else
		local where = sourcesText(def)
		if def.Rarity == "Secret" then
			U.Info.Text = "A Secret pet. Summon it at the Storm Altar, or hatch it from the Celestial Roulette."
		elseif where then
			U.Info.Text = "Not discovered yet. Found in: " .. where .. "."
		else
			U.Info.Text = "Not discovered yet."
		end
		U.Info.TextColor3 = MUTED
		U.Owned.Visible = false
	end
end

----------------------------------------------------------------------
-- Selection
----------------------------------------------------------------------
function selectPet(petId)
	S.PetId = petId
	for _, tile in pairs(S.Tiles) do
		paintTile(tile)
	end
	renderDetail()
end

-- scrolls the group list so the tile of `groupId` is in view (Open("Fusions") on a short screen)
function revealGroupTile(groupId)
	local list = U.GroupList
	local index = nil
	if groupId == FUSIONS then
		index = #S.Groups + 1
	else
		for i, group in ipairs(S.Groups) do
			if group.Id == groupId then
				index = i
			end
		end
	end
	if not list or not index then
		return
	end
	if S.Tall then
		-- (playtest 2026-11-28 C41) the sideways strip of the portrait layout pages to the selected tab when it is out of
		-- view ('MYTHIC PETS 2/4' showed with the Common / Uncommon tabs in the strip); a tab in view stays put
		if not S.StripTabW then
			return
		end
		local unit = H_stripUnit()
		local pitch = S.StripTabW + K.STRIP_GAP
		local n = math.max(1, S.StripN or 1)
		local first = math.floor(list.CanvasPosition.X / unit / pitch + 0.5)
		if index - 1 >= first and index - 1 < first + n then
			return
		end
		local last = math.max(0, H_tabCount() - n)
		local want = math.min(last, math.floor((index - 1) / n) * n) * pitch * unit
		list.CanvasPosition = Vector2.new(want, list.CanvasPosition.Y)
		return
	end
	-- CanvasPosition is in the list's own (pre-UIScale) pixels, like the tile sizes; the window's pop-in UIScale
	-- may still be running (it starts at 0.86)
	local scale = math.max(((U.Fit and U.Fit.Scale) or 1) * ((U.Pop and U.Pop.Scale) or 1), 0.01)
	local visible = list.AbsoluteSize.Y / scale
	if visible <= 1 then
		return
	end
	local tileH = S.Short and K.GROUP_TILE_H_SHORT or K.GROUP_TILE_H
	local top = 6 + (index - 1) * (tileH + 6)
	local bottom = top + tileH
	local y = list.CanvasPosition.Y
	if top < y then
		y = top - 6
	elseif bottom > y + visible then
		y = bottom - visible + 6
	end
	list.CanvasPosition = Vector2.new(0, math.max(0, y))
end

local function defaultPetOf(group)
	-- the first discovered pet, else the first one
	for _, def in ipairs(group.Pets) do
		if State.IsDiscovered(def.Id) then
			return def.Id
		end
	end
	return group.Pets[1] and group.Pets[1].Id or nil
end

function selectGroup(groupId)
	-- the Fusions tab is a pseudo group: the player's fused copies (keys), rebuilt when that set changes
	local fusions = groupId == FUSIONS
	local group = S.GroupById[groupId]
	if not fusions and not group then
		return
	end
	local pets, sig
	if fusions then
		pets, sig = fusionDefs()
	else
		pets = group.Pets
	end
	local changed = S.GroupId ~= groupId or #S.TileOrder == 0 or (fusions and S.FusionSig ~= sig)
	S.GroupId = groupId
	if S.ElementsShown then
		showElements(false)
	end
	if changed then
		clearTiles()
		S.FusionSig = sig
		for index, def in ipairs(pets) do
			buildTile(def, index)
		end
		U.Grid.CanvasPosition = Vector2.new(0, 0)
		local keep = false
		for _, def in ipairs(pets) do
			if def.Id == S.PetId then
				keep = true
			end
		end
		if not keep then
			if fusions then
				S.PetId = pets[1] and pets[1].Id or nil
			else
				S.PetId = defaultPetOf(group)
			end
		end
	end
	if U.FusionEmpty then
		U.FusionEmpty.Visible = fusions and #pets == 0
	end
	if changed then
		revealGroupTile(groupId)
	end
	refreshGroupTiles()
	renderHeader()
	renderRewards()
	selectPet(S.PetId)
	fillViewports()
end

local function defaultGroup()
	-- a reward waiting first, then the first group still missing pets, else the first group
	for _, group in ipairs(S.Groups) do
		local _, _, _, _, claimable = groupStatus(group)
		if claimable then
			return group.Id
		end
	end
	for _, group in ipairs(S.Groups) do
		local _, _, complete = groupStatus(group)
		if not complete then
			return group.Id
		end
	end
	return S.Groups[1] and S.Groups[1].Id or nil
end

function refreshAll()
	if not S.Built then
		return
	end
	if S.GroupId == FUSIONS then
		-- a fusion added / used up a copy while the tab is shown: rebuild its grid
		local _, sig = fusionDefs()
		if sig ~= S.FusionSig then
			selectGroup(FUSIONS)
		end
	end
	refreshGroupTiles()
	refreshTiles()
	renderHeader()
	renderRewards()
	renderFooter()
	renderDetail()
end

----------------------------------------------------------------------
-- Claim
----------------------------------------------------------------------
local function requestClaim()
	local group = S.GroupById[S.GroupId]
	if not group then
		return
	end
	local _, _, _, _, claimable = groupStatus(group)
	if not claimable or S.ClaimPending then
		return
	end
	local now = os.clock()
	if now - S.LastClaim < K.CLAIM_GAP then
		return
	end
	local remote = getClaimRemote()
	if not remote then
		return
	end
	S.LastClaim = now
	local ok = pcall(function()
		remote:FireServer(group.Id)
	end)
	if not ok then
		return
	end
	S.ClaimPending = group.Id
	S.ClaimToken = S.ClaimToken + 1
	local mine = S.ClaimToken
	renderRewards()
	task.delay(K.CLAIM_TIMEOUT, function()
		if S.ClaimToken == mine and S.ClaimPending then
			S.ClaimPending = nil
			if S.Built then
				renderRewards()
			end
		end
	end)
end

----------------------------------------------------------------------
-- Elements: its own centred window over the Index (Pitch 2 item 12_elements, the owner's pick A "Wheel":
-- client/UI/ElementsWindow, Window_Elements in this ScreenGui). Before it, a scrolling card inside the centre column
-- showed 3 of the 8 elements with 18 px arrows and had no title bar and no X. Its X and Esc return to the Index
----------------------------------------------------------------------
function showElements(on)
	if not U.ElementsWin then
		if not on then
			return
		end
		local ok, EW = pcall(require, Client:WaitForChild("UI"):WaitForChild("ElementsWindow"))
		if not (ok and type(EW) == "table") then
			warnOnce("elements window", EW)
			return
		end
		U.ElementsWin = EW.New(U.Gui, {
			-- (look review r0: at 844x390 slivers of the menu tiles showed at the chart's left edge) the tiles step aside
			-- while the chart reaches over them, as for the Gifts and Shop windows (MenuController, required here at open
			-- time: no require cycle)
			OnPlace = function(left)
				local module = script.Parent:FindFirstChild("MenuController")
				local ok, menu = pcall(require, module)
				if ok and type(menu) == "table" and type(menu.SetColumnCovered) == "function" then
					safe("cover", menu.SetColumnCovered, left, "Elements")
				end
			end,
			OnClose = function()
				S.ElementsShown = false
				-- (the mock: the chart stands alone) the Index steps back in when it closes, if it is still open
				if U.Holder and S.Open then
					U.Holder.Visible = true
				end
			end,
		})
	end
	S.ElementsShown = on and true or false
	if S.ElementsShown then
		U.ElementsWin.Open()
		if U.Holder then
			U.Holder.Visible = false -- (the mock: the chart alone on the screen, not over a second awning)
		end
	else
		U.ElementsWin.Close()
	end
end

-- (12_elements) the Elements window is open over the Index (Esc and the back button close it first)
local function elementsUp()
	return U.ElementsWin ~= nil and U.ElementsWin.IsOpen()
end

----------------------------------------------------------------------
-- Window construction
----------------------------------------------------------------------
local function buildCentre(centre)
	-- header: group name + progress bar "x/N"
	local header = inset(centre, "GroupHeader", { Size = UDim2.new(1, 0, 0, K.HEADER_H) })
	U.Header = header
	U.GroupTitle = makeText(header, "GroupTitle", "", "Title", 28, INK, {
		Position = UDim2.fromOffset(16, 0),
		Size = UDim2.new(0.5, -16, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextScaled = true,
	})
	Util.Create("UITextSizeConstraint", { MaxTextSize = 28, MinTextSize = 18, Parent = U.GroupTitle })
	-- (kit-b U8) the group's progress; (LOOK-ui, kitb-look1) as a block bar: a block per pet, the found ones in the rarity's
	-- colour (all grass once complete), the "2/6" count at its right end on the stone
	local track = makeFrame(header, "Progress", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.new(0.48, -14, 0, 30),
	})
	U.HeaderBlocks = SignKit.FitBlocks(track, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -64, 0, 18),
		Count = 6,
		Gap = 3,
		Weight = "Bar",
	})
	U.HeaderCount = makeText(track, "Count", "0/0", "Display", 22, INK, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 58, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
	})

	-- the pet grid
	local well = inset(centre, "GridWell", {
		Position = UDim2.fromOffset(0, K.HEADER_H + 8),
		Size = UDim2.new(1, 0, 1, -(K.HEADER_H + 8 + K.REWARD_H + 8)),
	})
	U.GridWell = well
	well:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("landTiles", H_fitLandTiles) -- (fix round B) a landscape phone's tiles follow the well's height
	end)
	U.Grid = scroller(well, "PetGrid", {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.new(1, -8, 1, -8),
	})
	pad(U.Grid, 8, 8, 12, 8)
	U.GridLayout = Util.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(K.TILE_W, K.TILE_H),
		CellPadding = UDim2.fromOffset(K.TILE_GAP, K.TILE_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = U.Grid,
	})
	-- the Fusions tab without any fused pet yet
	U.FusionEmpty = makeFrame(well, "FusionEmpty", { Size = UDim2.new(1, 0, 1, 0), Visible = false, ZIndex = 5 })
	listLayout(U.FusionEmpty, Enum.FillDirection.Vertical, 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local emptyGlyph = makeText(U.FusionEmpty, "Glyph", "", "Title", 54, SIGN.VioletLip, {
		Size = UDim2.new(1, 0, 0, 60),
		LayoutOrder = 1,
		ZIndex = 5,
	})
	PixelIcon.Host(emptyGlyph, ICON.Sparkle, 54) -- (kit-b U7b)
	Theme.StyleTitle(makeText(U.FusionEmpty, "Title", "No fused pets yet", "Title", 28, INK, {
		Size = UDim2.new(1, -30, 0, 34),
		LayoutOrder = 2,
		ZIndex = 5,
	}), "Section")
	makeText(U.FusionEmpty, "Body", "Golden and Rainbow copies and the hybrids you mix at the Fusion Machine show up here.", "Body", 19, MUTED, {
		Size = UDim2.new(1, -60, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		LayoutOrder = 3,
		ZIndex = 5,
	})

	-- rewards box + CLAIM
	local rewards = inset(centre, "Rewards", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, K.REWARD_H),
	})
	U.Rewards = rewards
	U.RewardLabel = makeText(rewards, "Label", "Rewards:", "Heading", 22, INK, {
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.fromOffset(120, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	U.RewardAmount = makeText(rewards, "Amount", "", "Display", 30, INK, {
