}

-- Currencies (v3): glyph, attribute name (Config.Attr values) and the coin colours used by the HUD stack,
-- the shop and price tags. Cash and Gems arrive with the tycoon phase.
Theme.Currency = {
	Tokens = {
		Id = "Tokens",
		Name = "Cloud Tokens",
		Attr = "CloudTokens",
