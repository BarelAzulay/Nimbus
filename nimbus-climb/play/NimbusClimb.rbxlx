		curve(g, "Antler", { { s * 4.8, top + 3, z + 1 }, { s * 3, top + 6, z + 0.6 }, { s * 2.8, top + 7.6, z + 0.6 } }, 0.9, 0.6)
		EVO.Flower(ctx, { s * 9, top + 9, z + 2.2 }, 0.8)
		EVO.Flower(ctx, { s * 2.8, top + 8.2, z + 0.4 }, 0.7, "PetalDeep")
