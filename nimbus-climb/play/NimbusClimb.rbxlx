local function buildWindow()
	if S.Built then
		return true
	end
	loadGroups()
	if #S.Groups == 0 then
		warnOnce("groups", "the pet catalog has no Index groups")
		return false
	end

	local holder = makeFrame(U.Gui, "Window_Index", {
		Size = UDim2.fromOffset(K.PREF_W, K.PREF_H),
		Visible = false,
		ZIndex = 3,
	})
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	local panel = CloudUI.Panel({
		Name = "IndexPanel",
		Title = "Pet Index",
		Closable = true,
		Skin = "Signboard", -- (kit-b U8) roof, navy header with the book, wood frame, stone body
		Icon = "book",
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			IndexController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	-- (render gate) docked 12 px from the screen's edge (side) or across it (sheet), the T1 band's tails would leave the
	-- screen: the band stays the header's width inside the frame, no tails
	SignKit.HeaderOverhang(panel.TitleBar, false)
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content

	local main = makeFrame(content, "Main", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 1, -(20 + K.FOOTER_H)),
	})
	U.Main = main

	-- left: group list + Elements button
	local hasElements = type(Config.Elements) == "table" and type(Config.Elements.Order) == "table"
	U.Groups = makeFrame(main, "Groups", { Size = UDim2.new(0, K.GROUP_W, 1, 0) })
	local listHeight = hasElements and -(K.ELEMENTS_BTN_H + 8) or 0
	U.GroupList = scroller(U.Groups, "GroupList", { Size = UDim2.new(1, 0, 1, listHeight) })
	U.GroupPad = pad(U.GroupList, 4, 6, 10, 6)
	U.GroupLayout = listLayout(U.GroupList, Enum.FillDirection.Vertical, 6, Enum.HorizontalAlignment.Center)
	for index, group in ipairs(S.Groups) do
		buildGroupTile(group, index)
	end
	buildFusionTile(#S.Groups + 1)
	-- (12_index_badge B) the strip's page dots under its tabs, and the snap to whole tabs after a swipe
	U.PageDots = makeFrame(U.Groups, "PageDots", { Visible = false, ZIndex = 3 })
	S.SnapToken = 0
	U.GroupList:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		if not S.Tall then
			return
		end
		H_paintDots()
		S.SnapToken = S.SnapToken + 1
		local mine = S.SnapToken
		task.delay(K.SNAP_DELAY, function()
			if S.SnapToken == mine then
				safe("snap", H_snapStrip)
			end
		end)
	end)
	if hasElements then
		U.ElementsButton = CloudUI.Button({
			Name = "Elements",
			Text = "Elements",
			Style = "Gray",
			Skin = "Sign",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, 0),
			Size = UDim2.new(1, -10, 0, K.ELEMENTS_BTN_H),
			TextSize = 22,
			Callback = function()
				safe("elements", showElements, not S.ElementsShown)
			end,
			Parent = U.Groups,
		})
	end

	-- centre: header, grid, rewards
	U.Centre = makeFrame(main, "Centre", {
		Position = UDim2.new(0, K.GROUP_W + K.GAP, 0, 0),
		Size = UDim2.new(1, -(K.GROUP_W + K.DETAIL_W + 2 * K.GAP), 1, 0),
	})
	buildCentre(U.Centre)

	-- right: detail card
	U.Detail = inset(main, "Detail", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, K.DETAIL_W, 1, 0),
	})
	buildDetail(U.Detail)

	-- footer: "Unlocked: x/N" over every pet
	local footer = makeFrame(content, "Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 10, 1, -6),
		Size = UDim2.new(1, -20, 0, K.FOOTER_H - 6),
	})
	U.Footer = footer
	U.FooterText = makeText(footer, "Unlocked", "Unlocked: 0/0", "Title", 26, INK, {
		Size = UDim2.new(0, 260, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	-- (LOOK-ui, kitb-look1) ten gold blocks, a tenth of every pet each
	U.FooterBlocks = SignKit.FitBlocks(footer, {
		Name = "Bar",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 270, 0.5, 0),
		Size = UDim2.new(1, -350, 0, 20),
		Count = 10,
		Gap = 3,
		Weight = "Bar",
	})
	U.FooterPercent = makeText(footer, "Percent", "0%", "Display", 24, INK, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 70, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})

	S.Built = true
	relayout()
	return true
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
-- (kit-b U8) on a touch screen Roblox's thumbstick and jump button go while the window is open (the jump button sat on
-- CLAIM at 844x390) and come back as they were: MenuController keeps the one owner set (required here at open / close
-- time, when both modules are loaded: no require cycle)
function syncTouch()
	local want = S.Open and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if want == (S.TouchOff == true) then
		return
	end
	S.TouchOff = want
	local module = script.Parent:FindFirstChild("MenuController")
	local ok, menu = pcall(require, module)
	if ok and type(menu) == "table" and type(menu.SetTouchHidden) == "function" then
		safe("touch", menu.SetTouchHidden, "Index", want)
	end
end

-- (LOOK-ui, kitb-look1: the docked window cut the vitals card and lay over the strips at 1280x720) the HUD steps aside
-- where the open window and its awning lie over it (HudController.Overlaps, as MenuController's Home and Stats): the
-- vitals card, the currency strips; both back when it closes. Checked again on every layout
function syncHud()
	local module = script.Parent:FindFirstChild("HudController")
	local ok, hud = pcall(require, module)
	if not (ok and type(hud) == "table" and type(hud.Overlaps) == "function") then
		return
	end
	local vitals, strips = false, false
	local rect = S.Open and U.Dock and U.Dock.Rect
	if rect then
		local okO, v, st = pcall(hud.Overlaps, rect, 10 * (rect.scale or 1)) -- (the awning: CloudUI.Panel's roof at Y -10)
		vitals, strips = okO and v == true, okO and st == true
	end
	if type(hud.SetCurrencyHidden) == "function" then
		safe("currency", hud.SetCurrencyHidden, "Index", strips)
	end
	if type(hud.SetVitalsHidden) == "function" then
		safe("vitals", hud.SetVitalsHidden, "Index", vitals)
	end
end

function IndexController.IsOpen()
	return S.Open
end

function IndexController.ClaimableCount()
	if #S.Groups == 0 then
		loadGroups()
	end
	local n = 0
	for _, group in ipairs(S.Groups) do
		local _, _, _, _, claimable = groupStatus(group)
		if claimable then
			n = n + 1
		end
	end
	return n
end

function IndexController.Open(groupId)
	if not initialized then
		IndexController.Init()
	end
	if not U.Gui then
		return
	end
	if not buildWindow() then
		return
	end
	local target = nil
	-- (12_elements) Open("Elements"): the Index, then the Elements window over it (OpenPanel("Index", { GroupId =
	-- "Elements" }), the renderer's menu:Index:Elements)
	local wantElements = type(groupId) == "string" and groupId:lower() == "elements"
	if wantElements then
		groupId = nil
	end
	if type(groupId) == "string" then
		if S.GroupById[groupId] then
			target = groupId
		elseif groupId:lower() == FUSIONS:lower() or groupId:lower() == "fusion" then
			target = FUSIONS
		else
			-- accept any capitalisation ("common")
			for id in pairs(S.GroupById) do
				if id:lower() == groupId:lower() then
					target = id
				end
			end
		end
	end
	if not target and not S.Open then
		-- no group asked for: a waiting reward first, else where the player left off
		for _, group in ipairs(S.Groups) do
			local _, _, _, _, claimable = groupStatus(group)
			if claimable and not target then
				target = group.Id
			end
		end
	end
	target = target or S.GroupId or defaultGroup()
	local wasOpen = S.Open
	S.Open = true
	S.Token = S.Token + 1
	syncBackBinding()
	relayout()
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 1
	end
	safe("select", selectGroup, target)
	safe("refresh", refreshAll)
	syncTouch()
	syncHud()
	if not wasOpen then
		SignKit.Rise(U.Pop.Parent) -- (Pitch 2 F0) the kit's open: it rises 12 px in 3 hard steps (no scale bounce)
	end
	if not wasOpen then
		IndexController.Opened:Fire(target)
	end
	if wantElements and type(Config.Elements) == "table" then
		safe("elements", showElements, true)
	end
end

function IndexController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	if elementsUp() then
		showElements(false) -- (12_elements) the chart goes with the Index
	end
	syncBackBinding()
	syncTouch()
	syncHud()
	tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	IndexController.Closed:Fire()
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function onStateChanged()
	if not S.Built then
		return
	end
	local group = S.ClaimPending and S.GroupById[S.ClaimPending]
	if group and State.IsClaimed(group.Id) then
		-- the server confirmed the claim: celebrate on the rewards box
		S.ClaimPending = nil
		S.ClaimToken = S.ClaimToken + 1
		if S.Open and S.GroupId == group.Id and U.Rewards then
			burst(U.Rewards, rarityAccent(group.Rarity), 26, UDim2.new(1, -106, 0.5, 0))
		end
	end
	if S.Open then
		refreshAll()
	end
end

function IndexController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)

	local gui = CloudUI.NewScreenGui("NimbusIndex", K.DISPLAY_ORDER)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(gui)
	U.Gui = gui
	U.Kit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Built then
			safe("relayout", relayout)
		end
	end)
	State.Changed:Connect(function()
		safe("State.Changed", onStateChanged)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
				IndexController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and S.Open then
			if elementsUp() then
				showElements(false) -- (12_elements) Esc closes the Elements window and leaves the Index open
			else
				IndexController.Close()
			end
		end
	end)
	task.spawn(getClaimRemote)
end

return IndexController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1144">
            <Properties>
              <string name="Name">LeaderboardController</string>
              <string name="Source"><![CDATA[-- LeaderboardController (client, lobby-shop Task 24; spec 5.10 "Client", pages per section 15): the lobby board's face.
--
--   LeaderboardController.Init()
--   LeaderboardController.Page() -> stat         the page on the board ("Trophies" | "Pets" | "Ring": Config.Leaderboard.Pages)
--   LeaderboardController.SetPage(stat)          the tap path: shows that page and restarts the turn count
--   LeaderboardController.State() -> payload | nil   the last LeaderboardState (nil before the first)
--
-- A SurfaceGui "LobbyLeaderboard" in the PlayerGui (so its tabs take taps) adorned to the Face of the workspace model
-- LobbyLeaderboard (server/Services/LobbyBoardBuilder tags that Face Config.Tags.LeaderboardFace; found through
-- CollectionService: at Init and whenever a tagged Face arrives, so a rebuilt or streamed-in board re-adorns the same
-- SurfaceGui; the newest board wins; review round 1: no handler on every instance added to the workspace). It is built
-- when the first board is found, so a world without the board gets no SurfaceGui. Face Front,
-- PixelsPerStud 50: the 16 x 13 stud face is an 800 x 650 px canvas (CanvasSize says the same for tools; Roblox ignores
-- it under PixelsPerStud), MaxDistance 80, ResetOnSpawn false, LightInfluence 0. Layout (the pitch mock-up boardA):
--   (world signs kit-b, audit item 19: the navy gradient board with round badges went) the Board is the GuideBoard's
--   stone card ("THE GATES", LobbyBuilder): WorldTag.Block, a 6 px mitred wood edge and an 8 px lip, inset by its edge so
--   the canvas keeps it (788 x 638 at 6, 6); every text in the kit's brown ink, no outline; square, no corner, no gradient.
--   Board > IconL / IconR (the page's glyph), Title (50 px, Config.Leaderboard.Titles[stat]), Tabs > Tab_<stat> (one
--   TextButton per page, its Label: a stone block, the shown page's gold), Scope ("All players . all time" / "This
--   server only"), Rows > Row1..10 (38 px each, flat bands: Rank block, Head 34 px headshot in a square well with a
--   mitred wood edge, Name, Value; ranks 1-3 gold, silver, bronze blocks; my own row the selected gold), YouRow
--   ("You . 1,240 . #37" / "You . 1,240 . not in the top 100" / "You . ..." while my value is unknown), Footer
--   ("Refreshes in m:ss . tap a tab, or it turns in 0:ss", from NextAt on workspace:GetServerTimeNow()), Status
--   ("Loading scores..." before the first state / "No scores yet. Be the first!" for an empty page).
-- Every text is at least 30 px (0.6 stud: the project's world-text floor); values have commas, Theme.ShortNumber from 1e6.
-- The page turns by itself every Config.Leaderboard.TurnSeconds; a tap (SetPage) restarts that count. One 4 Hz task
-- turns the page, counts the footer down and drops a Face that left the workspace for any tagged one still there (no
-- Heartbeat).
-- Headshots: Players:GetUserThumbnailAsync(id, HeadShot, Size48x48) in a deferred pcall'd task, cached per user for the
-- session (a failed one stays blank: the square well shows). The client sends nothing.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local WorldTag = require(Shared:WaitForChild("WorldTag")) -- (world signs kit-b) the stone card, its blocks and ink

local Client = script.Parent.Parent
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))

local LocalPlayer = Players.LocalPlayer

local LeaderboardController = {}

local rgb = Color3.fromRGB
local Sign = Theme.Sign
-- (world signs kit-b) the board's layout is px INSIDE the stone card (the Board, inset by its wood edge EDGE): IW x IH,
-- the bottom LIP px of it the card's lip (no text over it). Every text keeps its old px (the 30 px floor)
local K = {
	MODEL = "LobbyLeaderboard", -- the workspace board model and the PlayerGui SurfaceGui
	PPS = 50, -- px per stud: 16 x 13 studs -> 800 x 650 px
	W = 800,
	H = 650,
	EDGE = 6, -- the card's mitred wood edge (drawn outside the Board: the Board is inset by it) ...
	LIP = 8, -- ... and its lip (the GuideBoard's 6 / 8)
	IW = 788, -- the Board: W - 2 x EDGE ...
	IH = 638, -- ... H - 2 x EDGE
	MAX_DISTANCE = 80,
	PAD = 14,
	TITLE_Y = 0, TITLE_H = 56, TITLE_TEXT = 50, ICON = 44, ICON_BOX = 56,
	TABS_Y = 60, TABS_H = 44, TAB_GAP = 10,
	SCOPE_Y = 106, SCOPE_H = 34,
	ROWS_Y = 142, ROW_H = 38, ROWS = 10,
	BADGE = 34, -- the rank block and the headshot well (px)
	BLOCK_EDGE = 2, -- a tab's, a rank block's, the head well's and the You row's mitred wood edge ...
	BLOCK_LIP = 4, -- ... a tab's and the You row's lip
	RANK_LIP = 3, -- a rank block's lip
	NAME_X = 90, NAME_W = 440, VALUE_W = 220,
	YOU_Y = 524, YOU_H = 40,
	FOOT_Y = 568, FOOT_H = 62, -- (ends at IH - LIP)
	TEXT = 30, -- the floor: every text on the board
	VALUE_TEXT = 32,
	STATUS_TEXT = 32,
	SHORT_FROM = 1e6, -- Theme.ShortNumber from here, commas below
	TICK = 0.25,
	HEAD_CACHE = 200, -- headshots kept before the cache starts over
	ICONS = { Trophies = "trophy", Pets = "Pets", Ring = "Ring" }, -- NeonKit icon ids / PixelIcon names (trophy, paw, crown)
	ICON_INK = { Trophies = Sign.GoldLip, Pets = Sign.Wood, Ring = Sign.GoldLip }, -- their colour on the stone
	MEDALS = { rgb(255, 201, 60), rgb(217, 224, 238), rgb(224, 149, 90) }, -- the rank blocks' faces (lip: WorldTag.LipOf)
	INK = Sign.Text,
	MUTED = Sign.TextMuted,
	BAND = Sign.Well, -- every other row's flat band (the rest show the stone)
	ME = Sign.Selected, -- my own row and the You row: the kit's selected gold
	ME_LIP = Sign.GoldLip,
	TAB_ON = Sign.Gold, TAB_ON_LIP = Sign.GoldLip,
	TAB_OFF = Sign.Tile, TAB_OFF_LIP = Sign.StoneLip,
	RANK = Sign.Tile, -- a rank block under 4th
	HEAD_BG = Sign.PetWell, -- the headshot's well (shows while the headshot loads, or when it failed)
}
LeaderboardController.K = K

local S = {
	Gui = nil, -- the SurfaceGui (built at the first board)
	Face = nil, -- the adorned Face part
	Ui = nil, -- { Board, Title, IconL, IconR, Tabs = { [stat] = button }, Scope, Rows = { { Frame, Rank, Head, Name, Value, UserId } }, RowsFrame, You, Footer, Status }
	State = nil, -- the last LeaderboardState
	Page = nil,
	TurnAt = 0, -- os.clock() of the next turn
	Icon = nil, -- the page whose glyph the title shows
	Heads = {}, -- [userId] = content | "" (failed) | false (asking)
	HeadCount = 0,
	Warned = {},
	Started = false,
}
LeaderboardController._S = S

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok and not S.Warned[key] then
		S.Warned[key] = true
		warn("[LeaderboardController] " .. key .. ": " .. tostring(err))
	end
	return ok
end

local function cfg()
	return type(Config.Leaderboard) == "table" and Config.Leaderboard or {}
end

local function pages()
	local list = cfg().Pages
	return type(list) == "table" and list or {}
end

local function turnSeconds()
	return math.max(1, tonumber(cfg().TurnSeconds) or 15)
end

-- "m:ss", counted up to the next whole second (a millisecond of slack: 138.4 - 123.4 is 15.000000000000014, not 16 s)
local function mmss(seconds)
	local s = math.max(0, math.ceil((tonumber(seconds) or 0) - 0.001))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

-- kit-b U6: every board text sits on the board, a row or a tab, so it reads by contrast (no classic stroke any more);
-- (world signs kit-b) WorldTag.Text: the kit's brown ink on the stone, no outline, never scaled
local function label(parent, name, text, role, size, props)
	props = props or {}
	local color = props.TextColor3 or K.INK
	props.TextColor3 = nil
	return WorldTag.Text(parent, name, text, role, size, color, props)
end

local function frame(parent, name, pos, size, color, alpha)
	local f = Instance.new("Frame")
	f.Name = name
	f.Position = pos
	f.Size = size
	f.BackgroundColor3 = color or Theme.Colors.White
	f.BackgroundTransparency = alpha or 0
	f.BorderSizePixel = 0
	f.Parent = parent
	return f
end

----------------------------------------------------------------------
-- the face
----------------------------------------------------------------------
local function setIcons(stat)
	local ui = S.Ui
	if not ui or S.Icon == stat then
		return
	end
	S.Icon = stat
	for _, holder in ipairs({ ui.IconL, ui.IconR }) do
		holder:ClearAllChildren()
		local icon = NeonKit.Icon(holder, K.ICONS[stat] or "Stats", K.ICON)
		-- (world signs kit-b) a pixel icon follows its host's text colour (white by default: lost on the stone)
		if typeof(icon) == "Instance" and (icon:IsA("TextLabel") or icon:IsA("TextButton")) then
			icon.TextColor3 = K.ICON_INK[stat] or K.INK
		end
	end
end

-- a mitred wood edge round a square well (the head well: a headshot fills it, so no lip over the picture)
local function woodEdge(obj, px)
	local edge = Instance.new("UIStroke")
	edge.Name = "SignEdge"
	edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	edge.Color = Sign.Wood
	edge.Thickness = px
	edge.Transparency = 0
	edge.Parent = obj
	return edge
end

-- a row: a flat square band (every other one the Well, my own the selected gold: render), the rank block (a medal's
-- face on its LipOf lip for ranks 1-3, a stone Tile below), the headshot's square well, the name and the value in ink
local function buildRow(parent, i)
	local rowW = K.IW - 20
	local row = frame(parent, "Row" .. i, UDim2.fromOffset(10, (i - 1) * K.ROW_H + 1), UDim2.fromOffset(rowW, K.ROW_H - 2), K.BAND, 1)
	local medal = K.MEDALS[i]
	local rank = label(row, "Rank", tostring(i), "Display", K.TEXT, {
		Position = UDim2.fromOffset(6, 1), Size = UDim2.fromOffset(K.BADGE, K.BADGE), ZIndex = 2,
	})
	WorldTag.Block(rank, medal or K.RANK, medal and WorldTag.LipOf(medal) or Sign.StoneLip, Sign.Wood, K.BLOCK_EDGE, K.RANK_LIP)
	local head = Instance.new("ImageLabel")
	head.Name = "Head"
	head.Position = UDim2.fromOffset(12 + K.BADGE, 1)
	head.Size = UDim2.fromOffset(K.BADGE, K.BADGE)
	head.BackgroundColor3 = K.HEAD_BG
	head.BackgroundTransparency = 0
	head.BorderSizePixel = 0
	head.Image = ""
	head.ScaleType = Enum.ScaleType.Crop -- (the square headshot fills the square well)
	head.ZIndex = 2
	woodEdge(head, K.BLOCK_EDGE)
	head.Parent = row
	local name = label(row, "Name", "", "Body", K.TEXT, {
		Position = UDim2.fromOffset(K.NAME_X, 0), Size = UDim2.fromOffset(K.NAME_W, K.ROW_H - 2),
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local value = label(row, "Value", "", "Display", K.VALUE_TEXT, {
		Position = UDim2.fromOffset(rowW - 12 - K.VALUE_W, 0), Size = UDim2.fromOffset(K.VALUE_W, K.ROW_H - 2),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	return { Frame = row, Rank = rank, Head = head, Name = name, Value = value, UserId = nil }
end

local function build()
	local gui = Instance.new("SurfaceGui")
	gui.Name = K.MODEL
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = K.PPS
	gui.CanvasSize = Vector2.new(K.W, K.H)
	pcall(function()
		gui.MaxDistance = K.MAX_DISTANCE -- (a pcall: the board still builds where the engine lacks the member)
	end)
	gui.ResetOnSpawn = false
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local ui = { Tabs = {}, Rows = {} }
	-- (world signs kit-b) the GuideBoard's stone card: inset by its 6 px wood edge (drawn outside it) so the canvas keeps
	-- the edge whole; its 8 px lip along the bottom
	local board = frame(gui, "Board", UDim2.fromOffset(K.EDGE, K.EDGE), UDim2.fromOffset(K.IW, K.IH), Sign.Stone, 0)
	WorldTag.Block(board, Sign.Stone, Sign.StoneLip, Sign.Wood, K.EDGE, K.LIP)
	ui.Board = board

	ui.IconL = frame(board, "IconL", UDim2.fromOffset(K.PAD, K.TITLE_Y), UDim2.fromOffset(K.ICON_BOX, K.ICON_BOX), nil, 1)
	ui.IconR = frame(board, "IconR", UDim2.fromOffset(K.IW - K.PAD - K.ICON_BOX, K.TITLE_Y), UDim2.fromOffset(K.ICON_BOX, K.ICON_BOX), nil, 1)
	ui.Title = label(board, "Title", "", "Heading", K.TITLE_TEXT, {
		Position = UDim2.fromOffset(K.PAD + K.ICON_BOX + 8, K.TITLE_Y), Size = UDim2.fromOffset(K.IW - 2 * (K.PAD + K.ICON_BOX + 8), K.TITLE_H),
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	-- the page tabs: stone blocks in a mitred wood edge on their lip, the shown page's gold (render)
	local tabs = frame(board, "Tabs", UDim2.fromOffset(K.PAD, K.TABS_Y), UDim2.fromOffset(K.IW - 2 * K.PAD, K.TABS_H), nil, 1)
	local list = pages()
	local n = math.max(1, #list)
	local tw = math.floor((K.IW - 2 * K.PAD - (n - 1) * K.TAB_GAP) / n)
	for i, stat in ipairs(list) do
		local b = Instance.new("TextButton")
		b.Name = "Tab_" .. stat
		b.AutoButtonColor = false
		b.BorderSizePixel = 0
		b.Position = UDim2.fromOffset((i - 1) * (tw + K.TAB_GAP), 0)
		b.Size = UDim2.fromOffset(tw, K.TABS_H)
		b.Text = tostring((type(cfg().Labels) == "table" and cfg().Labels[stat]) or stat)
		Theme.Style(b, "Button", { Size = K.TEXT, Color = K.INK })
		WorldTag.Block(b, K.TAB_OFF, K.TAB_OFF_LIP, Sign.Wood, K.BLOCK_EDGE, K.BLOCK_LIP)
		b.Parent = tabs
		b.Activated:Connect(function()
			safe("tap", LeaderboardController.SetPage, stat)
		end)
		ui.Tabs[stat] = b
	end

	ui.Scope = label(board, "Scope", "", "Body", K.TEXT, {
		Position = UDim2.fromOffset(K.PAD, K.SCOPE_Y), Size = UDim2.fromOffset(K.IW - 2 * K.PAD, K.SCOPE_H), TextColor3 = K.MUTED,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	ui.RowsFrame = frame(board, "Rows", UDim2.fromOffset(0, K.ROWS_Y), UDim2.fromOffset(K.IW, K.ROWS * K.ROW_H), nil, 1)
	for i = 1, K.ROWS do
		ui.Rows[i] = buildRow(ui.RowsFrame, i)
	end
	ui.Status = label(board, "Status", "", "Heading", K.STATUS_TEXT, {
		Position = UDim2.fromOffset(K.PAD, K.ROWS_Y), Size = UDim2.fromOffset(K.IW - 2 * K.PAD, K.ROWS * K.ROW_H), TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	-- my line: the selected gold block (a mitred wood edge, its GoldLip lip); its side padding pads the lip too, so the
	-- lip reaches back out by it (flush on the edge)
	ui.You = label(board, "YouRow", "", "Heading", K.TEXT, {
		Position = UDim2.fromOffset(10, K.YOU_Y), Size = UDim2.fromOffset(K.IW - 20, K.YOU_H), TextXAlignment = Enum.TextXAlignment.Left,
	})
	local _, youLip = WorldTag.Block(ui.You, K.ME, K.ME_LIP, Sign.Wood, K.BLOCK_EDGE, K.BLOCK_LIP)
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = ui.You
	youLip.Position = UDim2.new(0, -14, 1, 0)
	youLip.Size = UDim2.new(1, 28, 0, K.BLOCK_LIP)
	ui.Footer = label(board, "Footer", "", "Body", K.TEXT, {
		Position = UDim2.fromOffset(K.PAD, K.FOOT_Y), Size = UDim2.fromOffset(K.IW - 2 * K.PAD, K.FOOT_H), TextColor3 = K.MUTED, TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
	})

	S.Gui, S.Ui, S.Icon = gui, ui, nil
	gui.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

----------------------------------------------------------------------
-- headshots
----------------------------------------------------------------------
local applyHeads

-- the cached headshot of a user ("" until it arrives or when it failed); asks once per user, in a deferred task
local function headOf(userId)
	local h = S.Heads[userId]
	if type(h) == "string" then
		return h
	end
	if h == nil and type(userId) == "number" and userId > 0 then
		if S.HeadCount >= K.HEAD_CACHE then
			S.Heads, S.HeadCount = {}, 0
		end
		local heads = S.Heads
		heads[userId] = false
		S.HeadCount = S.HeadCount + 1
		task.defer(function()
			local ok, content = pcall(function()
				return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
			end)
			heads[userId] = (ok and type(content) == "string") and content or ""
			safe("heads", applyHeads)
		end)
	end
	return ""
end

applyHeads = function()
	for _, r in ipairs(S.Ui and S.Ui.Rows or {}) do
		local image = r.UserId and headOf(r.UserId) or ""
		if r.Head.Image ~= image then
			r.Head.Image = image
		end
	end
end

----------------------------------------------------------------------
-- rendering
----------------------------------------------------------------------
local function footer()
	local ui = S.Ui
	if not ui then
		return
	end
	local turn = "tap a tab, or it turns in " .. mmss(S.TurnAt - os.clock())
	local nextAt = S.State and tonumber(S.State.NextAt)
	local text
	if not nextAt then
		text = "Tap a tab, or it turns in " .. mmss(S.TurnAt - os.clock())
	elseif nextAt - Workspace:GetServerTimeNow() > 0 then
		text = "Refreshes in " .. mmss(nextAt - Workspace:GetServerTimeNow()) .. " \194\183 " .. turn
	else
		text = "Refreshing... \194\183 " .. turn
	end
	if ui.Footer.Text ~= text then
		ui.Footer.Text = text
	end
end

local function render()
	local ui = S.Ui
	if not ui then
		return
	end
	local stat = LeaderboardController.Page()
	local c = cfg()
	ui.Title.Text = tostring((type(c.Titles) == "table" and c.Titles[stat]) or string.upper(tostring(stat)))
	setIcons(stat)
	for key, b in pairs(ui.Tabs) do
		local on = key == stat
		b.BackgroundColor3 = on and K.TAB_ON or K.TAB_OFF
		local lip = b:FindFirstChild("Lip")
		if lip then
			lip.BackgroundColor3 = on and K.TAB_ON_LIP or K.TAB_OFF_LIP
		end
		b.TextColor3 = K.INK
	end
	local state = S.State
	ui.Scope.Text = (state and state.Scope == "Server") and "This server only" or "All players \194\183 all time"
	local data = state and type(state.Stats) == "table" and state.Stats[stat] or nil
	local top = type(data) == "table" and type(data.Top) == "table" and data.Top or {}
	local me = LocalPlayer and LocalPlayer.UserId
	for i, r in ipairs(ui.Rows) do
		local e = type(top[i]) == "table" and top[i] or nil
		r.Frame.Visible = e ~= nil
		r.UserId = e and tonumber(e.UserId) or nil
		if e then
			r.Name.Text = tostring(e.Name or "Player")
			r.Value.Text = Theme.ShortNumber(tonumber(e.Value) or 0, K.SHORT_FROM)
			-- flat square bands: my own row the selected gold, every other row the Well, the rest the card's stone
			local mine = r.UserId ~= nil and r.UserId == me
			r.Frame.BackgroundColor3 = mine and K.ME or K.BAND
			r.Frame.BackgroundTransparency = (mine or i % 2 == 1) and 0 or 1
		end
	end
	applyHeads()
	ui.Status.Text = (state == nil) and "Loading scores..." or "No scores yet. Be the first!"
	ui.Status.Visible = state == nil or type(top[1]) ~= "table"
	ui.RowsFrame.Visible = not ui.Status.Visible
	local you = type(data) == "table" and type(data.You) == "table" and data.You or {}
	local value, rank = tonumber(you.Value), tonumber(you.Rank)
	if not value then
		ui.You.Text = "You \194\183 ..."
	elseif rank then
		ui.You.Text = "You \194\183 " .. Theme.ShortNumber(value, K.SHORT_FROM) .. " \194\183 #" .. math.floor(rank)
	else
		ui.You.Text = "You \194\183 " .. Theme.ShortNumber(value, K.SHORT_FROM) .. " \194\183 not in the top " .. tostring(tonumber(c.ReadSize) or 100)
	end
	footer()
end

----------------------------------------------------------------------
-- the board in the workspace
----------------------------------------------------------------------
local function valid(face)
	return face ~= nil and face.Parent ~= nil and face:IsDescendantOf(Workspace)
end

local function adopt(face)
	if not (face and face:IsA("BasePart") and face:IsDescendantOf(Workspace)) then
		return
	end
	S.Face = face
	if not S.Gui then
		build()
		render()
	end
	S.Gui.Adornee = face
end

-- the board's Face carries Config.Tags.LeaderboardFace (LobbyBoardBuilder; review round 1: a CollectionService tag, not
-- a handler on every instance added to the workspace): a tagged Face arriving (a rebuild, streaming) is adopted, the
-- newest board wins; a Face that left is replaced by any tagged Face still in the workspace (the tick)
local function faceTag()
	return type(Config.Tags) == "table" and Config.Tags.LeaderboardFace or "NC_LeaderboardFace"
end

local function adoptAnyTagged()
	local tagged = game:GetService("CollectionService"):GetTagged(faceTag())
	for i = #tagged, 1, -1 do
		if valid(tagged[i]) and tagged[i]:IsA("BasePart") then
			adopt(tagged[i])
			return
		end
	end
end

local function tick()
	if S.Face and not valid(S.Face) then
		S.Face = nil
		if S.Gui then
			S.Gui.Adornee = nil
		end
		safe("find", adoptAnyTagged)
	end
	if S.Gui and not S.Gui.Parent then
		S.Gui.Parent = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	end
	local list = pages()
	if #list > 1 and os.clock() >= S.TurnAt then
		local cur = LeaderboardController.Page()
		local idx = 1
		for i, stat in ipairs(list) do
			if stat == cur then
				idx = i
			end
		end
		S.Page = list[idx % #list + 1]
		S.TurnAt = os.clock() + turnSeconds()
		render()
	else
		footer()
	end
end

----------------------------------------------------------------------
-- public
----------------------------------------------------------------------
function LeaderboardController.Page()
	local list = pages()
	for _, stat in ipairs(list) do
		if stat == S.Page then
			return stat
		end
	end
	return list[1]
end

function LeaderboardController.SetPage(stat)
	for _, s in ipairs(pages()) do
		if s == stat then
			S.Page = stat
			S.TurnAt = os.clock() + turnSeconds()
			render()
			return
		end
	end
end

function LeaderboardController.State()
	return S.State
end

function LeaderboardController.Init()
	if S.Started then
		return
	end
	S.Started = true
	S.Page = pages()[1]
	S.TurnAt = os.clock() + turnSeconds()
	game:GetService("CollectionService"):GetInstanceAddedSignal(faceTag()):Connect(function(inst)
		safe("added", adopt, inst)
	end)
	safe("find", adoptAnyTagged)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "LeaderboardState")
		if ok and remote then
			remote.OnClientEvent:Connect(function(state)
				if type(state) == "table" then
					S.State = state
					safe("render", render)
				end
			end)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(K.TICK)
			safe("tick", tick)
		end
	end)
end

return LeaderboardController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1145">
            <Properties>
              <string name="Name">LobbyFxController</string>
              <string name="Source"><![CDATA[-- LobbyFxController (client, lobby shop 2026-11-07, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.12 / 5.9 /
-- 16.5; plan Task 25): ONE Heartbeat for all lobby motion. The server builds and tags; only this client moves anything.
--   * Config.Tags.Spin (NC_Spin) on a Model or a Part: turns about its built pivot's Y, one turn in SpinSeconds, and bobs
--     BobStuds * sin(2 pi t / BobSeconds) from the built pivot (absolute each frame, never accumulating). Users: the world
--     gem (8 s, 0.6 / 3 s), the summon portal's GlowRing (6 s), the egg row's seven shelf eggs under the WINGED PETS board
--     (14 s, 0.12 / 3.2 s: a slow display turntable).
--   * Config.Tags.Bob (NC_Bob) on a BillboardGui: StudsOffset.Y = its built value + the same bob (the trove's Join sign,
--     0.5 / 2.4 s); on a Model or a Part: the bob alone.
--   * Every JoinBillboard (the trove's Join sign, found through its NC_Bob tag) has Enabled = false while
--     LocalPlayer:GetAttribute(Config.Attr.TroveGroupDone) == true, true otherwise, a sign built after a rebuild included.
-- Rules: only targets within RANGE studs of the camera move (a moving one rests only past RANGE_OUT: no flicker at the
-- edge); Low graphics (GraphicsQuality.Effective(), the read PortalFxController uses) = nothing moves. A target that stops
-- (out of range, Low, untagged, parked outside the workspace) is put back exactly at its built pivot / offset. The turn starts
-- from the built pose each time a target starts moving; the bob carries a small phase per target (from its built spot), so
-- the shelf eggs do not bob in lockstep.
-- How a Model / Part moves: each of its BaseParts is written absolutely as pose * (its offset), offsets taken against the
-- built pivot for parts the server built (they replicate at their built place, also when they stream in late) and against
-- the pose of the moment for a part inside an ML_Mesh (MeshLibrary.Dress builds it on this client at the target's current
-- pivot). A Model without a PrimaryPart gets its WorldPivot written too, so GetPivot() (and a mesh dressed mid-turn) follows.
-- Cheap: one Heartbeat, a pass every REFRESH s picks the near targets and re-reads attributes and the quality, no table
-- or closure made per frame; targets are found by CollectionService tags (added / removed signals: streaming and
-- rebuilds), each record drops its own connections when its target goes.
--
--   LobbyFxController.Init()            idempotent (Main.client.lua starts it)
--   LobbyFxController.Step(dt)          one frame (the Heartbeat handler; tests call it by hand)
--   LobbyFxController.Moving() -> { inst... }  the targets moved on the last step (a copy)
--   LobbyFxController.K                 the tuning numbers
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local LobbyFx = {}

local K = {
	RANGE = 150, -- studs from the camera: farther targets rest at their built pivot
	RANGE_OUT = 160, -- ... a moving target rests only past this
	REFRESH = 0.5, -- seconds between two passes (near targets, attributes, graphics quality, the Join signs)
	BOB_SECONDS = 3, -- a bob without BobSeconds
	JOIN = "JoinBillboard",
}
LobbyFx.K = K

local TAG = {
	Spin = (type(Config.Tags) == "table" and Config.Tags.Spin) or "NC_Spin",
	Bob = (type(Config.Tags) == "table" and Config.Tags.Bob) or "NC_Bob",
	Done = (type(Config.Attr) == "table" and Config.Attr.TroveGroupDone) or "TroveGroupDone",
	Mesh = "ML_Mesh",
}
local TWO_PI = math.pi * 2

local S = {
	Started = false,
	Recs = {}, -- [instance] = record
	Count = 0,
	Conns = {},
	Time = 0, -- accumulated Heartbeat time (deterministic in tests)
	RefreshAcc = 0,
	Low = false,
	Moving = {},
	Quality0 = nil, -- GraphicsQuality module (lazy; tests put a stub here)
}
LobbyFx._S = S

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------

local function quality()
	if S.Quality0 == nil then
		S.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				S.Quality0 = mod
			end
		end
	end
	if S.Quality0 then
		local ok, mode = pcall(S.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

local function positive(inst, name)
	local v = inst:GetAttribute(name)
	if type(v) == "number" and v > 0 and v == v then
		return v
	end
	return nil
end

-- where a target stands (the distance to the camera): a pose target's built pivot, a sign's adornee / parent
local function spotOf(rec)
	if not rec.Gui then
		return rec.Base.Position
	end
	local host = rec.Inst.Adornee or rec.Inst.Parent
	if host and host:IsA("BasePart") then
		return host.Position
	elseif host and host:IsA("Attachment") then
		return host.WorldPosition
	elseif host and host:IsA("Model") then
		return host:GetPivot().Position
	end
	return nil
end

-- a part joins a pose target: its offset against `from` (the built pivot, or the pose of the moment for a mesh part)
local function addPart(rec, part)
	if part:IsA("BasePart") then
		local from = part:FindFirstAncestor(TAG.Mesh) and rec.Cur or rec.Base
		rec.Parts[part] = from:Inverse() * part.CFrame
	end
end

-- writes a pose target at `pose` (its parts, and the WorldPivot of a Model without a PrimaryPart)
local function place(rec, pose)
	for part, rel in pairs(rec.Parts) do
		if part.Parent then
			part.CFrame = pose * rel
		end
	end
	if rec.Model and not rec.Inst.PrimaryPart then
		rec.Inst.WorldPivot = pose
	end
	rec.Cur = pose
end

-- back to the built pivot / offset (once)
local function rest(rec)
	if not rec.Moved then
		return
	end
	rec.Moved = false
	if rec.Gui then
		rec.Inst.StudsOffset = rec.Base
	else
		place(rec, rec.Base)
	end
end

local function joinDone()
	local lp = Players.LocalPlayer
	return lp ~= nil and lp:GetAttribute(TAG.Done) == true
end

local function applyJoin(rec, done)
	if rec.Join and rec.Inst.Enabled == done then
		rec.Inst.Enabled = not done
	end
end

local function applyJoins()
	local done = joinDone()
	for _, rec in pairs(S.Recs) do
		applyJoin(rec, done)
	end
end

-- re-reads a record's attributes (they may replicate after the tag) and which tags it has
local function readAttrs(rec)
	local inst = rec.Inst
	rec.Spin = (not rec.Gui and CollectionService:HasTag(inst, TAG.Spin)) and positive(inst, "SpinSeconds") or nil
	rec.Bob = positive(inst, "BobStuds") or 0
	rec.BobT = positive(inst, "BobSeconds") or K.BOB_SECONDS
end

local function untrack(inst)
	local rec = S.Recs[inst]
	if not rec then
		return
	end
	S.Recs[inst] = nil
	S.Count = S.Count - 1
	for _, c in ipairs(rec.Conns) do
		c:Disconnect()
	end
	if inst:IsDescendantOf(game) then
		rest(rec)
	end
end

-- any tagged instance in the game is recorded, but only one in the workspace ever moves: GraphicsQuality's Low parks
-- NC_Detail decor in ReplicatedStorage and puts it back on High without a tag signal, so a parked target keeps its
-- record (rested) and moves again once it is back
local function track(inst)
	if S.Recs[inst] or not inst:IsDescendantOf(game) then
		return
	end
	local rec = { Inst = inst, Conns = {}, Moved = false, Near = false, T0 = 0 }
	if inst:IsA("BillboardGui") then
		rec.Gui = true
		rec.Base = inst.StudsOffset
		rec.Join = inst.Name == K.JOIN
	elseif inst:IsA("BasePart") or inst:IsA("Model") then
		rec.Model = inst:IsA("Model")
		rec.Base = inst:GetPivot()
		rec.Cur = rec.Base
		rec.Parts = {}
		addPart(rec, inst)
		for _, d in ipairs(inst:GetDescendants()) do
			addPart(rec, d)
		end
		rec.Conns[1] = inst.DescendantAdded:Connect(function(d)
			addPart(rec, d)
		end)
		rec.Conns[2] = inst.DescendantRemoving:Connect(function(d)
			rec.Parts[d] = nil
		end)
	else
		return
	end
	local spot = spotOf(rec)
	-- a phase for the bob from the built spot (0..1 of a period), so neighbours do not bob in lockstep
	rec.Phase = spot and (math.sin(spot.X * 12.9898 + spot.Z * 78.233) * 43758.5453) % 1 or 0
	readAttrs(rec)
	S.Recs[inst] = rec
	S.Count = S.Count + 1
	applyJoin(rec, joinDone())
end

-- a tag went (or its instance left the game): keep it while it is in the game with one of the two tags
local function onRemoved(inst)
	if inst:IsDescendantOf(game) and (CollectionService:HasTag(inst, TAG.Spin) or CollectionService:HasTag(inst, TAG.Bob)) then
		return
	end
	untrack(inst)
end

----------------------------------------------------------------------
-- the loop
----------------------------------------------------------------------

-- picks the near targets, re-reads attributes and the quality, drops targets that left the game, re-applies the Join signs
local function refresh()
	S.Low = quality() == "Low"
	local cam = Workspace.CurrentCamera
	local eye = cam and cam.CFrame.Position
	for inst, rec in pairs(S.Recs) do
		if not inst:IsDescendantOf(game) then
			untrack(inst)
		else
			readAttrs(rec)
			local spot = inst:IsDescendantOf(Workspace) and spotOf(rec) or nil
			local near = false
			if eye and spot and not S.Low and (rec.Spin or rec.Bob > 0) then
				near = (spot - eye).Magnitude <= (rec.Near and K.RANGE_OUT or K.RANGE)
			end
			if near and not rec.Near then
				rec.T0 = S.Time -- the turn starts from the built pose
			elseif not near then
				rest(rec)
			end
			rec.Near = near
		end
	end
	applyJoins()
end

function LobbyFx.Step(dt)
	dt = tonumber(dt) or 0
	if dt <= 0 then
		return
	end
	S.Time = S.Time + dt
	S.RefreshAcc = S.RefreshAcc + dt
	if S.RefreshAcc >= K.REFRESH then
		S.RefreshAcc = 0
		refresh()
	end
	local moving = S.Moving
	for i = #moving, 1, -1 do
		moving[i] = nil
	end
	if S.Low then
		return
	end
	for inst, rec in pairs(S.Recs) do
		if rec.Near and inst.Parent then
			local t = S.Time - rec.T0
			local bob = rec.Bob > 0 and rec.Bob * math.sin(TWO_PI * (t / rec.BobT + rec.Phase)) or 0
			if rec.Gui then
				local b = rec.Base
				inst.StudsOffset = Vector3.new(b.X, b.Y + bob, b.Z)
			else
				local pose = rec.Base
				if rec.Spin then
					pose = pose * CFrame.Angles(0, TWO_PI * t / rec.Spin, 0)
				end
				place(rec, pose + Vector3.new(0, bob, 0))
			end
			rec.Moved = true
			moving[#moving + 1] = inst
		end
	end
end

function LobbyFx.Moving()
	local out = {}
	for i, inst in ipairs(S.Moving) do
		out[i] = inst
	end
	return out
end

function LobbyFx.Init()
	if S.Started then
		return
	end
	S.Started = true
	for _, tag in ipairs({ TAG.Spin, TAG.Bob }) do
		S.Conns[#S.Conns + 1] = CollectionService:GetInstanceAddedSignal(tag):Connect(track)
		S.Conns[#S.Conns + 1] = CollectionService:GetInstanceRemovedSignal(tag):Connect(onRemoved)
		for _, inst in ipairs(CollectionService:GetTagged(tag)) do
			track(inst)
		end
	end
	local lp = Players.LocalPlayer
	if lp then
		S.Conns[#S.Conns + 1] = lp:GetAttributeChangedSignal(TAG.Done):Connect(applyJoins)
	end
	S.Conns[#S.Conns + 1] = RunService.Heartbeat:Connect(LobbyFx.Step)
	refresh()
end

return LobbyFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1146">
            <Properties>
              <string name="Name">LossScreen</string>
              <string name="Source"><![CDATA[-- LossScreen (client, team balance Task 6; spec 2026-10-31 s.7): a lost Ring run or Dungeon floor feels like progress. The result
-- screen shows what the team gained, with Fight again and Edit team. BattleController and DungeonController load it when a loss
-- arrives; a build without it keeps today's cards. It has no Init: the first Show builds it.
--
--   LossScreen.Show(payload) -> bool
--       payload = { Mode = "Ring" | "Dungeon", Title, Color, Sub, Pets = { { Key, PetId, Before, After, XpFrac, XpBefore }... },
--                   Lines = { { text, color }... }, Start = round | floor, OnFightAgain = fn | nil, OnClose = fn | nil }
--       Pets come from the server (Rewards.Pets / End.Pets): the client never computes a level.
--   LossScreen.Reopen()     the last payload again, without the sound or the pop (PetsController's ReturnTo { Window = "Loss" })
--   LossScreen.Hide()       closed and forgotten
--   LossScreen.IsOpen() -> bool
--
-- ScreenGui NimbusLoss (DisplayOrder 24: above the battle HUD's result card, below Notify 30), card LossCard (NeonKit.Card, kit B's
-- cream sign with a red lip (kit-b U9-6: square, flat, colour by role: a loss is the danger red; brown ink), centred
-- under the top bar over a Shade that dims the screen below the top bar; 16 px side gutters on a phone; every button >= 44 px;
-- nailed up like the Dungeon End card): Title, Sub, PetRow1..3 (Face viewport, Name, Lift: Levels "L1", the pixel arrow, LevelTo
-- "L3" with a pop + one SoundFx "Reward" for the whole card and a gold sparkle on the row, or Levels "L1" + XpBar, ten sky kit
-- blocks lighting from XpBefore to XpFrac), Lines (the run's rewards as stone fact tags with their pixel icons), FightAgain
-- ("Fight again", hidden without OnFightAgain), EditTeam ("Edit team"), CloseButton (NeonKit.CloseBlock: its X drawn).
-- The buttons are kit B blocks (CloudUI.Button Skin "Sign": Fight again the one green action, Edit team stone, Close danger red).
-- Fight again and Edit team wait for the return teleport: while Config.Attr.InBattle is still set (RETURN_DELAY after the end) the
-- button says "Returning..." and ignores taps, then acts once. A refused start leaves the screen (the server's toast says why) and
-- the button works again after START_WAIT; the next battle's InBattle closes the screen.
-- Edit team opens PetsController's window with ReturnTo { Window = "Loss" }; its Close comes back through Reopen.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (LOOK-ui2) whole-px edges and lips, the reward and level icons
local SignKit = require(Shared:WaitForChild("SignKit")) -- (LOOK-ui2) the XP block rows, the nails
local State = require(Client:WaitForChild("State"))

local LossScreen = {}

local K = {
	DISPLAY_ORDER = 24,
	GUTTER_X = 16, -- screen px kept free around the card
	GUTTER_Y = 8,
	W_WIDE = 848, -- design px of a 1080p screen (at the phone scale the buttons end left of the jump button)
	W_TALL = 440, -- a portrait phone: the rows stack
	TOUCH_SCALE = 0.8, -- a narrow phone's card is narrower rather than under this fit: K.CLOSE and K.BUTTON_H stay >= 44 px
	JUMP_RIGHT = 120, -- a low screen: the buttons end this far from its right edge (Roblox's jump button: 70 px, 45 px in; kit-b U9-6)
	ROW_W_SHORT = 260, -- design px: a narrower pet row takes "L99 -> L100" at LEVELS_SHORT
	LEVELS_SHORT = 22,
	PAD = 16,
	TITLE_H = 44,
	SUB_H = 28,
	SUB_H_TALL = 52,
	ROW_H = 104,
	ROW_H_TALL = 96,
	ROW_GAP = 8,
	LINE_H = 36,
	TAG_H = 32, -- (LOOK-ui2) a reward's fact tag in its LINE_H row
	XP_BLOCKS = 10,
	SHADE = 0.55, -- the PetPicker's shade under the card
	BUTTON_H = 60,
	CLOSE = 56,
	SHORT = 500, -- a screen lower than this keeps the card up at the top, clear of the jump button
	POLL = 0.2, -- seconds between two looks at InBattle
	RETURN_WAIT = 7, -- BattleService / DungeonService RETURN_DELAY (4) + 3: longest wait for the return teleport
	START_WAIT = 2.5, -- a Fight again the server did not start: the button works again after this
	POP_DELAY = 0.3, -- the level-up moment, after the card shows
	POP_SECONDS = 0.35,
	XP_SECONDS = 0.9,
}

-- (kit-b U9-6) the Cloud Shop Signboard: brown ink on the cream sign, the pets in their wells; (LOOK-ui2) the XP a row of kit
-- blocks in XP's one role colour, sky (as Pets and Feed; it was grass here)
local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local LIP = SIGN.Red -- the card's lip: a loss
local LIFT = SIGN.Good or Theme.Darken(SIGN.GrassLip, 0.35) -- "L1 -> L3": the levels gained (kit B's good ink, as Care and Train)
local XP_FILL, XP_LIP = SIGN.Sky, SIGN.SkyLip
local ROW_BACK = SIGN.PetWell

-- (LOOK-ui2) a reward line's pixel icon (the dock family's fact tag: the Dungeon End card's chips), by what it pays
local REWARD_ICONS = {
	{ "Tokens", Config.Icons and Config.Icons.Tokens or "token" }, { "Gems", "gem" }, { "Cash", Config.Icons and Config.Icons.Cash or "note" },
	{ "Trophies", "trophy" }, { "Pet XP", "up" }, { "Rounds won", "crown" }, { "Best", "star" }, { "Floor", "key" },
}
local function rewardIcon(line)
	line = tostring(line or "")
	for _, pair in ipairs(REWARD_ICONS) do
		if line:find(pair[1], 1, true) then
			return pair[2]
		end
	end
	return nil
end

-- (LOOK-ui2) a rough drawn width (FredokaOne: 0.72 em a capital, 0.58 any other letter or digit, 0.3 a space), or
-- Theme.Measure's when it is wider
local function drawnW(value, role, px)
	local est = 0
	for ch in tostring(value):gmatch(".") do
		est = est + ((ch == " ") and 0.3 or (ch:match("%u") and 0.72 or 0.58))
	end
	local okM, size = pcall(Theme.Measure, tostring(value), role, px)
	return math.ceil(math.max(est * px, (okM and typeof(size) == "Vector2") and size.X or 0))
end

local LocalPlayer = Players.LocalPlayer
local IN_BATTLE = (Config.Attr and Config.Attr.InBattle) or "InBattle"

local U = nil -- the widgets, built by the first Show
local S = {
	Open = false,
	Payload = nil,
	Rows = {}, -- { Root, Handle } per pet
	Token = 0, -- a newer Show / Hide drops what an older one still has waiting
	Busy = false, -- Fight again / Edit team is waiting
	InBattleAtShow = nil,
}

local function warnOf(what, err)
	warn("[LossScreen] " .. what .. ": " .. tostring(err))
end

local function safe(what, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOf(what, err)
	end
	return ok
end

local function optional(parent, name)
	local inst = parent:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, mod = pcall(require, inst)
	return ok and type(mod) == "table" and mod or nil
end

local function inBattle()
	local v = LocalPlayer and LocalPlayer:GetAttribute(IN_BATTLE)
	return v ~= nil and v ~= false and v ~= ""
end

local function text(parent, name, value, role, size, color, props)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = tostring(value or "")
	-- kit-b U6: the card is a plate, so the text reads by contrast (no outline)
	Theme.Style(label, role, { Size = size, Color = color or INK })
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

-- (kit-b U9-6) a square wood edge (kit B: no rounded corners)
local function edge(obj, color, thickness)
	return Util.Create("UIStroke", { Name = "SignEdge", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Miter, Color = color, Thickness = thickness, Parent = obj })
end

----------------------------------------------------------------------
-- Layout: one UIScale fits the card inside the screen, under the top bar
----------------------------------------------------------------------
local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

local function layout()
	local vp = viewportSize()
	local tall = vp.X < vp.Y
	local w = math.min(tall and K.W_TALL or K.W_WIDE, math.floor((vp.X - 2 * K.GUTTER_X) / K.TOUCH_SCALE))
	local inner = w - 2 * K.PAD
	local y = 12
	U.Title.Position = UDim2.fromOffset(K.PAD + 4, y)
	U.Title.Size = UDim2.fromOffset(inner - K.CLOSE - 12, K.TITLE_H)
	U.Close.Position = UDim2.fromOffset(w - K.PAD - K.CLOSE, 10)
	U.Close.Size = UDim2.fromOffset(K.CLOSE, K.CLOSE)
	y = y + K.TITLE_H + 2
	local subH = tall and K.SUB_H_TALL or K.SUB_H
	U.Sub.Position = UDim2.fromOffset(K.PAD + 4, y)
	U.Sub.Size = UDim2.fromOffset(inner - 8 - (tall and 0 or K.CLOSE), subH)
	U.Sub.TextWrapped = tall
	y = y + subH + K.ROW_GAP

	-- the pets: three columns, stacked rows on a portrait phone
	local n = math.max(1, #S.Rows)
	local rowH = tall and K.ROW_H_TALL or K.ROW_H
	local rowW = tall and inner or math.floor((inner - (n - 1) * K.ROW_GAP) / n)
	for i, row in ipairs(S.Rows) do
		if tall then
			row.Root.Position = UDim2.fromOffset(K.PAD, y + (i - 1) * (rowH + K.ROW_GAP))
		else
			row.Root.Position = UDim2.fromOffset(K.PAD + (i - 1) * (rowW + K.ROW_GAP), y)
		end
		row.Root.Size = UDim2.fromOffset(rowW, rowH)
		if row.Gained then
			row.PlaceLift(rowW < K.ROW_W_SHORT and K.LEVELS_SHORT or 26)
		end
	end
	y = y + (tall and (n * (rowH + K.ROW_GAP)) or (rowH + K.ROW_GAP))

	-- the run's rewards (LOOK-ui2: were three bare text lines): fact tags as wide as their words, 6 px apart, in rows
	local lines = {}
	for _, c in ipairs(U.Lines:GetChildren()) do
		if c:IsA("TextLabel") then
			lines[#lines + 1] = c
		end
	end
	table.sort(lines, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	local lx, lineRows = 0, (#lines > 0) and 1 or 0
	for _, label in ipairs(lines) do
		local pad = label:FindFirstChildOfClass("UIPadding")
		-- (merge kitb-look1 x U9-6) 6 px spare (was 4): under the card's 0.67 at 1280 x 720 the icon keeps its 2 px cells
		-- (PixelIcon: never under 2) and 4 design px were 2.7 screen px, under the text's measured width
		local tw = math.min(inner, drawnW(label.Text, "Heading", label.TextSize) + (pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 20) + 6)
		if lx > 0 and lx + tw > inner then
			lx, lineRows = 0, lineRows + 1
		end
		label.Position = UDim2.fromOffset(lx, (lineRows - 1) * K.LINE_H + math.floor((K.LINE_H - K.TAG_H) / 2))
		label.Size = UDim2.fromOffset(tw, K.TAG_H)
		lx = lx + tw + 6
	end
	U.Lines.Position = UDim2.fromOffset(K.PAD, y)
	U.Lines.Size = UDim2.fromOffset(inner, lineRows * K.LINE_H)
	y = y + lineRows * K.LINE_H + K.ROW_GAP

	local buttonsY = y
	y = y + K.BUTTON_H + K.PAD

	U.Card.Root.Size = UDim2.fromOffset(w, y)
	local inset = 0
	local okI, topLeft = pcall(function()
		return (GuiService:GetGuiInset())
	end)
	if okI and typeof(topLeft) == "Vector2" then
		inset = topLeft.Y
	end
	local factor = 1
	local okF, f = pcall(CloudUI.ScreenFactor)
	if okF and tonumber(f) then
		factor = f
	end
	local fit = math.min((vp.X - 2 * K.GUTTER_X) / w, (vp.Y - inset - 2 * K.GUTTER_Y) / y)
	U.Fit.Scale = math.max(0.3, math.min(factor, fit))

	-- the buttons: on a low screen they end left of the jump button
	local buttonsW = inner
	if not tall and vp.Y < K.SHORT then
		local cardLeft = (vp.X - w * U.Fit.Scale) / 2
		buttonsW = math.min(inner, math.floor((vp.X - K.JUMP_RIGHT - cardLeft) / U.Fit.Scale) - K.PAD)
	end
	local again = U.FightAgain.Visible
	local half = math.floor((buttonsW - K.ROW_GAP) / 2)
	U.FightAgain.Position = UDim2.fromOffset(K.PAD, buttonsY)
	U.FightAgain.Size = UDim2.fromOffset(half, K.BUTTON_H)
	U.EditTeam.Position = again and UDim2.fromOffset(K.PAD + half + K.ROW_GAP, buttonsY) or UDim2.fromOffset(K.PAD, buttonsY)
	U.EditTeam.Size = again and UDim2.fromOffset(half, K.BUTTON_H) or UDim2.fromOffset(buttonsW, K.BUTTON_H)

	-- (LOOK-ui2: the HUD stayed live round the card: the wallet pills, half of DASH, the Index tile cut by its edge) the
	-- PetPicker's shade dims everything under the top bar while the card is up
	U.Shade.Position = UDim2.fromOffset(0, inset)
	U.Shade.Size = UDim2.fromOffset(vp.X, math.max(0, vp.Y - inset))
	U.Card.Root.AnchorPoint = Vector2.new(0.5, 0.5)
	local h = y * U.Fit.Scale
	local free = vp.Y - inset - h
	U.Card.Root.Position = UDim2.fromOffset(math.floor(vp.X / 2), math.floor(inset + (vp.Y < K.SHORT and math.min(free / 2, K.GUTTER_Y / 2) or free / 2) + h / 2))
end

----------------------------------------------------------------------
-- The pets
----------------------------------------------------------------------
local function clearRows()
	for _, row in ipairs(S.Rows) do
		if row.Handle and type(row.Handle.Destroy) == "function" then
			pcall(row.Handle.Destroy)
		end
		row.Root:Destroy()
	end
	S.Rows = {}
end

local function petRow(i, entry)
	local key = tostring(entry.Key)
	local before, after = math.floor(tonumber(entry.Before) or 1), math.floor(tonumber(entry.After) or 1)
	local gained = after > before
	local root = Instance.new("Frame")
	root.Name = "PetRow" .. i
	root.BackgroundColor3 = ROW_BACK
	root.BorderSizePixel = 0
	root.Parent = U.Card.Body
	edge(root, SIGN.Wood, 2)
	local rowH = viewportSize().X < viewportSize().Y and K.ROW_H_TALL or K.ROW_H
	local faceSize = rowH - 32 -- (the rest of the column holds "L99 -> L100" at this size)
	local face = Instance.new("Frame")
	face.Name = "Face"
	face.BackgroundTransparency = 1
	face.BorderSizePixel = 0
	face.Position = UDim2.fromOffset(8, 16)
	face.Size = UDim2.fromOffset(faceSize, faceSize)
	face.Parent = root
	local def = State.DefOf(key)
	local handle = nil
	if def then
		local stage = tonumber(State.PetStage(key)) or 0
		local okV, h = pcall(CloudUI.PetViewport, face, def, UDim2.fromScale(1, 1), { Spin = "sway", Detail = "Low", Evolved = stage > 0 and stage or nil })
		handle = okV and h or nil
	end
	local x = faceSize + 16
	text(root, "Name", def and (def.DisplayName or def.Name) or entry.PetId or key, "Body", 19, INK, {
		Position = UDim2.fromOffset(x, 8),
		Size = UDim2.new(1, -x - 6, 0, 26),
	})
	-- (LOOK-ui2: "L18 -> L20" with an ASCII arrow) the levels gained: "L18", the kit's pixel arrow, "L20" (Lift, which pops),
	-- and a gold pixel sparkle in the row's corner; no level-up: "L18" and the XP as ten sky kit blocks
	local lift = Instance.new("Frame")
	lift.Name = "Lift"
	lift.BackgroundTransparency = 1
	lift.BorderSizePixel = 0
	lift.Position = UDim2.fromOffset(x, 36)
	lift.Size = UDim2.new(1, -x - 6, 0, 36)
	lift.Parent = root
	local pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = lift })
	local levels = text(lift, "Levels", "L" .. (gained and before or after), "Heading", gained and 26 or 24, gained and LIFT or INK, {
		Size = UDim2.new(1, 0, 1, 0),
		TextTruncate = Enum.TextTruncate.None,
	})
	local out = { Root = root, Handle = handle, Gained = gained, Levels = levels, Pop = pop, To = math.max(0, math.min(1, tonumber(entry.XpFrac) or 0)) }
	if gained then
		local to = text(lift, "LevelTo", "L" .. after, "Heading", 26, LIFT, { TextTruncate = Enum.TextTruncate.None })
		local arrow = PixelIcon.New(lift, "arrow", 18, LIFT)
		arrow.Name = "Arrow"
		out.LevelTo, out.Arrow = to, arrow
		-- the line's parts side by side at `px`: the arrow 6 px off each number, centred on the line
		function out.PlaceLift(px)
			levels.TextSize, to.TextSize = px, px
			local w1 = drawnW(levels.Text, "Heading", px) + 2
			local w2 = drawnW(to.Text, "Heading", px) + 2
			levels.Size = UDim2.new(0, w1, 1, 0)
			arrow.AnchorPoint = Vector2.new(0, 0.5)
			arrow.Position = UDim2.new(0, w1 + 6, 0.5, 0)
			to.Position = UDim2.fromOffset(w1 + 6 + 18 + 6, 0)
			to.Size = UDim2.new(0, w2, 1, 0)
		end
		out.PlaceLift(26)
		local spark = PixelIcon.New(root, "sparkle", 18, SIGN.Gold)
		spark.Name = "Sparkle"
		spark.AnchorPoint = Vector2.new(1, 0)
		spark.Position = UDim2.new(1, -6, 0, 6)
	else
		out.Bar = SignKit.FitBlocks(root, { Name = "XpBar", Count = K.XP_BLOCKS, Gap = 2, Weight = "Bar", Fill = XP_FILL, FillLip = XP_LIP,
			Position = UDim2.fromOffset(x, 76), Size = UDim2.new(1, -x - 10, 0, 14) })
		SignKit.FillBlocks(out.Bar, math.floor(math.max(0, math.min(1, tonumber(entry.XpBefore) or 0)) * K.XP_BLOCKS + 1e-6))
	end
	return out
end

-- (LOOK-ui2) the XP row lights block by block from what it held to where it ends, over K.XP_SECONDS
local function xpTo(row, token)
	local bar = row.Bar
	if not bar then
		return
	end
	local from = bar:GetAttribute("Filled") or 0
	local to = math.floor(row.To * K.XP_BLOCKS + 1e-6)
	if to <= from then
		SignKit.FillBlocks(bar, to)
		return
	end
	local step = K.XP_SECONDS / (to - from)
	task.spawn(function()
		for k = from + 1, to do
			task.wait(step)
			if token ~= S.Token or not bar.Parent then
				return
			end
			SignKit.FillBlocks(bar, k)
		end
	end)
end

local function moment(token)
	local any = false
	for _, row in ipairs(S.Rows) do
		if row.Gained then
			any = true
			row.Pop.Scale = 0.4
		else
			xpTo(row, token)
		end
	end
	if not any then
		return
	end
	task.delay(K.POP_DELAY, function()
		if token ~= S.Token then
			return
		end
		for _, row in ipairs(S.Rows) do
			if row.Gained then
				TweenService:Create(row.Pop, TweenInfo.new(K.POP_SECONDS, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			end
		end
		local sound = optional(Client, "SoundFx")
		if sound and type(sound.Play) == "function" then
			safe("sound", sound.Play, "Reward")
		end
	end)
end

----------------------------------------------------------------------
-- The buttons
----------------------------------------------------------------------
-- fn() once the return teleport is over; the button says so meanwhile, and other taps are ignored
local function afterReturn(button, idleText, fn)
	if S.Busy then
		return
	end
	S.Busy = true
	local token = S.Token
	button.Text = "Returning..."
	task.spawn(function()
		local t0 = os.clock()
		while inBattle() and os.clock() - t0 < K.RETURN_WAIT do
			task.wait(K.POLL)
			if token ~= S.Token then
				return
			end
		end
		S.Busy = false
		button.Text = idleText
		if not inBattle() then
			safe("button", fn)
		end
	end)
end

-- (kit-b gate U9 r4: RUN, the DASH's "SH", the menu tiles and the vitals stayed drawn round the card, layered clutter on
-- the run's last screen) while the card shows, the HUD's controls step aside (each through its owner's who-aware hold:
-- MovementController.SetMobileHidden, MenuController.SetColumnCovered, HudController.SetVitalsHidden), back on hide
local function holdHud(on)
	if S.HudHeld == on then
		return
	end
	S.HudHeld = on
	local controllers = Client:FindFirstChild("Controllers")
	local move = controllers and optional(controllers, "MovementController")
	if move and type(move.SetMobileHidden) == "function" then
		safe("hud hold", move.SetMobileHidden, "Loss", on)
	end
	local menu = controllers and optional(controllers, "MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		safe("hud hold", menu.SetColumnCovered, on and 0 or nil, "Loss")
	end
	-- (the render: Roblox's jump circle sat on the card's corner and the landscape strips peeked out from under its edge)
	if menu and type(menu.SetTouchHidden) == "function" then
		safe("hud hold", menu.SetTouchHidden, "Loss", on and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
	end
	local hud = controllers and optional(controllers, "HudController")
	if hud and type(hud.SetVitalsHidden) == "function" then
		safe("hud hold", hud.SetVitalsHidden, "Loss", on)
	end
	if hud and type(hud.SetCurrencyHidden) == "function" then
		safe("hud hold", hud.SetCurrencyHidden, "Loss", on)
	end
end

local function hideCard()
	S.Open = false
	S.Token = S.Token + 1
	S.Busy = false
	if U then
		U.Card.Root.Visible = false
		U.Gui.Enabled = false
	end
	holdHud(false)
end

local function fightAgain()
	local payload = S.Payload
	if not payload or not payload.OnFightAgain then
		return
	end
	afterReturn(U.FightAgain, "Fight again", function()
		S.Busy = true
		local token = S.Token
		payload.OnFightAgain()
		task.delay(K.START_WAIT, function()
			if token == S.Token then
				S.Busy = false
			end
		end)
	end)
end

local function editTeam()
	afterReturn(U.EditTeam, "Edit team", function()
		local pets = optional(script.Parent, "PetsController")
		if pets and type(pets.Open) == "function" then
			hideCard()
			pets.Open({ ReturnTo = { Window = "Loss" } })
		end
	end)
end

local function build()
	if U and U.Gui.Parent then
		return true
	end
	local gui = CloudUI.NewScreenGui("NimbusLoss", K.DISPLAY_ORDER)
	if not gui then
		return false
	end
	gui.IgnoreGuiInset = true
	-- (LOOK-ui2: under the card's Fit of 0.8 a 2 px edge drew 1.6 screen px, a 8 px lip 6.4) every wood edge and lip of the
	-- card, now and as rows are added, on whole screen px (PixelIcon.WholeTree, kitb-look1's one helper)
	PixelIcon.WholeTree(gui)
	gui.Enabled = false
	-- (LOOK-ui2) the shade under the card (the PetPicker's: kit B's navy lip, see-through); an Active frame, not a button, so
	-- it takes the HUD's taps but never sits as a control under Roblox's thumbstick or jump button
	local shade = Util.Create("Frame", {
		Name = "Shade", BorderSizePixel = 0, Active = true, BackgroundColor3 = SIGN.NavyLip, BackgroundTransparency = K.SHADE, Parent = gui,
	})
	local card = NeonKit.Card({ Name = "LossCard", Skin = "Sign", Size = UDim2.fromOffset(K.W_WIDE, 400), Color = LIP, LipPx = 8, Active = true, Parent = gui })
	card.Root.Visible = false
	card.Root.ZIndex = math.max(2, card.Root.ZIndex)
	SignKit.Nails(card.Root, { Inset = 5, ZIndex = 3 }) -- (LOOK-ui2) nailed up like its sibling, the Dungeon End card
	local fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = card.Root })
	local body = card.Body
	local lines = Instance.new("Frame")
	lines.Name = "Lines"
	lines.BackgroundTransparency = 1
	lines.BorderSizePixel = 0
	lines.Parent = body
	U = {
		Gui = gui,
		Shade = shade,
		Card = card,
		Fit = fit,
		-- (owner ruling 2026-11-14: a pop-up's title is kit B's plain Section title, the gold ribbon is for windows)
		Title = Theme.StyleTitle(text(body, "Title", "", "Title", 34, INK, { TextXAlignment = Enum.TextXAlignment.Left }), "Section"),
		Sub = text(body, "Sub", "", "Body", 19, MUTED),
		Lines = lines,
		Close = CloudUI.Button({ Name = "CloseButton", Text = "", Style = "Red", Skin = "Sign", Size = UDim2.fromOffset(K.CLOSE, K.CLOSE), TextSize = 24, Parent = body, Callback = function()
			local payload = S.Payload
			LossScreen.Hide()
			if payload and payload.OnClose then
				safe("close", payload.OnClose)
			end
		end }),
		FightAgain = CloudUI.Button({ Name = "FightAgain", Text = "Fight again", Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(300, K.BUTTON_H), TextSize = 24, Parent = body, Callback = fightAgain }),
		EditTeam = CloudUI.Button({ Name = "EditTeam", Text = "Edit team", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(300, K.BUTTON_H), TextSize = 24, Parent = body, Callback = editTeam }),
	}
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = INK }) -- slop audit 2026-11-12: a drawn X (no "X" letter, no glyph)
	NeonKit.CloseBlock(U.Close) -- (LOOK-ui2) one close for kit B: never under 44 screen px, its x in 3 px cells
	local mouse = optional(Client, "MouseLock")
	if mouse and type(mouse.WatchVisible) == "function" then
		safe("mouse", mouse.WatchVisible, "LossScreen", card.Root) -- the cursor is free while the card shows
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(IN_BATTLE):Connect(function()
			if S.Open and inBattle() and LocalPlayer:GetAttribute(IN_BATTLE) ~= S.InBattleAtShow then
				LossScreen.Hide() -- the next battle started
			end
		end)
	end
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if S.Open then
				safe("layout", layout)
			end
		end)
	end
	return true
end

local function fill(payload)
	U.Card.SetColor(LIP) -- (kit-b U9-6: the lip by role; the payload's Color was the neon card's tint)
	U.Title.Text = tostring(payload.Title or "RUN OVER")
	U.Title.TextColor3 = INK
	U.Sub.Text = tostring(payload.Sub or "")
	for _, c in ipairs(U.Lines:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	for i, line in ipairs(type(payload.Lines) == "table" and payload.Lines or {}) do
		-- (LOOK-ui2) the dock family's fact tag: stone in a 2 px wood edge, the pixel icon before the words in the ink
		local tag = text(U.Lines, "Line" .. i, line[1], "Heading", 18, INK, { LayoutOrder = i, BackgroundTransparency = 0, BackgroundColor3 = SIGN.Tile,
			TextXAlignment = Enum.TextXAlignment.Center })
		edge(tag, SIGN.Wood, 2)
		Util.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = tag })
		local icon = rewardIcon(line[1])
		if icon then
			PixelIcon.Lead(tag, icon)
		end
	end
	clearRows()
	for i, entry in ipairs(type(payload.Pets) == "table" and payload.Pets or {}) do
		if i > 3 then
			break
		end
		S.Rows[i] = petRow(i, entry)
	end
	U.FightAgain.Text = "Fight again"
	U.EditTeam.Text = "Edit team"
	U.FightAgain.Visible = payload.OnFightAgain ~= nil
end

local function present(payload)
	S.Token = S.Token + 1
	S.Busy = false
	S.Open = true
	S.Payload = payload
	S.InBattleAtShow = LocalPlayer and LocalPlayer:GetAttribute(IN_BATTLE) or nil
	fill(payload)
	layout()
	U.Gui.Enabled = true
	U.Card.Root.Visible = true
	holdHud(true)
end

function LossScreen.Show(payload)
	if type(payload) ~= "table" or not build() then
		return false
	end
	present(payload)
	moment(S.Token)
	return true
end

function LossScreen.Reopen()
	local payload = S.Payload
	if S.Open or not payload or not build() then
		return
	end
	-- a battle started while the player was away: this loss is over
	if inBattle() and LocalPlayer:GetAttribute(IN_BATTLE) ~= S.InBattleAtShow then
		S.Payload = nil
		return
	end
	present(payload)
	for _, row in ipairs(S.Rows) do
		if row.Bar then
			SignKit.FillBlocks(row.Bar, math.floor(row.To * K.XP_BLOCKS + 1e-6))
		end
	end
end

function LossScreen.Hide()
	S.Payload = nil
	hideCard()
end

function LossScreen.IsOpen()
	return S.Open
end

return LossScreen
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1147">
            <Properties>
              <string name="Name">MainMenuController</string>
              <string name="Source"><![CDATA[-- MainMenuController: the main menu BEFORE spawning, the settings / updates / credits windows and the hand-off from
-- the loading screen (ARCHITECTURE_V3.md "Phase 5 build contract" 7.1-7.3; judge M7 / C17).
--
-- With Config.MainMenu.Enabled:
--   * The server holds the character until PLAY (PlayerService: MenuPlay or the 90 s fallback), so there is no
--     character behind the menu. Until PLAY every ScreenGui in PlayerGui that is not in UiGate.ALLOW (NimbusLoading,
--     NimbusMainMenu, NimbusNotify) is kept Enabled = false: the ones there now and any added later (ChildAdded); an
--     owner that switches its gui on meanwhile gets it back on at PLAY (its wish is remembered).
--   * (quick wins 2026-11-12, win 1) The title screen is clean: the world name cards (BillboardGuis named in
--     Config.MainMenu.HideCards: the gate / portal cards, the obby join board, the Sky Trove, garden names, NPC and
--     home nameplates, the raid gate and home portal tags) anywhere in the workspace are kept Enabled = false by the
--     same rule (there now, added later, an owner's wish remembered; one that was off stays off), client-side only;
--     and NotifyController.SetHeld("MainMenu", true) holds the gameplay toasts until the end of PLAY.
--   * The camera is Scriptable and orbits the Gate Court (centre = Lobby.Origin + GateArcRadius towards GateFacing;
--     Config.MainMenu OrbitRadius 90, OrbitHeight 38, OrbitPeriod 60 s; RenderStepped while the menu is up only).
--   * The loading screen (NimbusLoading) is faded (0.4 s) and destroyed once its Done attribute is true.
--   * PLAY (button, Enter / keypad Enter, gamepad A): MenuPlay fired once per session (no args), wait for the
--     character (<= 5 s, then go on anyway), 0.35 s fade, camera Custom on the humanoid, the guis and world cards back,
--     UiGate.MarkPlayed(), then the held toasts (SetHeld("MainMenu", false)).
--     Shown once per session; respawns never show it again. DevController's /menu reopens it (Open(): client-side
--     only, the character stays, MenuPlay is never sent again).
-- With Enabled false: UiGate.MarkPlayed() at once, nothing gated (the loading screen fades by itself).
-- Always: GraphicsQuality.Init() and SoundFx.Music(SoundFx.Wanted()) (Lobby unless a battle / dungeon layer is on).
--
-- Layout (kit B U4, .superpowers/slop-audit/round3/BUILD_PLAN.md, findings 5 and 19; SignKit / PixelIcon; design px of a
-- 1080p screen under one UIScale clamp(H / 1080, 0.8, 1.25)): no shade over the world. A Signboard on two ropes: landscape
-- at x 60 (right of the thumbstick zone on touch), 440 wide; portrait docked at the bottom above the thumb zones. The flat
-- awning, the navy header (Config.MainMenu.Header = "NIMBUS CLIMB", Title role; the greeting is the owner's pick M4), the
-- stone body: the tag line (Config.Tagline), PLAY (the one green plank, 72 tall, a 6 px lip, FredokaOne 40, the pixel
-- play triangle), SETTINGS (pixel gear) + UPDATES (pixel scroll; the pixel star while UpdateNotes.Latest >
-- Settings.SeenNotes is the one NEW marker) as half-width stone planks, the version line "<latest title>" (opens
-- UPDATES; the number "vN" shows once, on the rig's brass plate) and the hint (keyboard / gamepad / touch). The CREDITS
-- wood tag hangs on its own rope: bottom-right on a desktop, top-right under Roblox's buttons on touch, under the board
-- on two ropes straddling the brass plate on portrait. (sign build, the owner's picks on
-- .superpowers/sign-pitch) Entrance "Rope drop": once the loading screen has faded, the board falls on its ropes, the
-- ropes snap taut (two pixel dust puffs, the SignThunk hook), it bounces and swings gently (Config.MainMenu.Entrance),
-- the buttons pop from their centre 60 ms apart; then it sways +-1 degree about the rope tops until PLAY
-- (Config.MainMenu.Sway; Camera shake OFF = none). (sign/logo build, the owner's picks 2026-11-13) The board wears B2
-- "Sky-climber's rig" (SignKit.Rig: the navy and canvas canopy, lashings, carabiners, the propellers that flip while it
-- opens or sways, the brass version plate) and the header shows the logo (shared/Logo: the L1 picture once its
-- TextureIds key has an id, L2 until then; the typed Config.MainMenu.Header stays under it, off). The Camera shake
-- setting is passed on to the loading screen (its gui's Sway attribute). It is laid out again when the
-- viewport changes (a short screen shortens its ropes). PLAY: the board is pulled up (0.3 s, Quad In) while the camera
-- tweens to the spawn view (0.8 s, Sine InOut); the release (the HUD back, Custom) waits for it to land.
-- Behind Config.Preview.TitleShots (PICK, off): the camera holds Key A / Key P of Config.MainMenu.Shots (FOV 50) instead
-- of the orbit.
-- Windows (docked by NeonKit.Dock: right side panel / bottom sheet):
--   SETTINGS  Music and Sound (11 steps 0..10, - / + and the step segments), Graphics (Auto / Low / High chips),
--             Camera shake (ON / OFF), Mouse lock (ON / OFF, keyboard + mouse devices only; the L key toggles it too);
--             applied at once through ClientSettings.Set (sent after a 0.4 s debounce)
--   UPDATES   UpdateNotes.Notes newest first; opening it sends SettingsSet("SeenNotes", UpdateNotes.Latest)
--   (kit B U5, finding 5) Both are Signboards built from SignKit, like the title screen: the flat awning, the navy header
--             (SETTINGS / WHAT'S NEW in the Title role, gold, the pixel gear / scroll on its gold square, the red Close
--             plank with the pixel x), the wood frame and the stone body. Settings: each row its pixel icon (music,
--             speaker, monitor, camera shake, mouse; no emoji) and brown FredokaOne title; the 0..10 scale a BlockRow of
--             10 between the - / + planks; the chips planks (selected = gold with its lip). Updates: each version a navy
--             plank in FredokaOne gold, each line Nunito brown after a 6 px square bullet. Rebuilt when the screen
--             changes size.
--   CREDITS   (credits look B "Signed by the Maker", the owner's pick 2026-11-13) a Signboard window, not the neon panel:
--             a small pink roof (ONE fixed-size piece, K.CR.ROOF_W x ROOF_H, never stretched with the window), a navy header
--             with CREDITS (Theme Sign = LuckiestGuy, a dark drop line) and the drawn X, a wood frame round a cream body.
--             In the body: a polaroid (-5 deg, a red pin, the creator's headshot via Players:GetUserThumbnailAsync on a
--             sky gradient, "the boss"), a navy plank holding the studio's SAINTSFIELD wordmark picture (TextureIds
--             saintsfield_wordmark), CREATED BY, the signature (Theme.Fonts.Signature, -3 deg, a swash), the gold italic
--             thank-you line, and the round SF emblem sticker (TextureIds saintsfield_emblem, gold ring, 12 deg) in the
--             bottom-right corner, clear of every text. Every text is UpdateNotes.Credits; the headshot is game.CreatorId
--             for a user-owned game, else Config.CreatorUserId. Landscape: the polaroid left of the text; portrait: above
--             it (a portrait phone too short for that: beside it). The texts are measured (TextService): the polaroid
--             shrinks before the column gets too narrow, the signature fills its row, the thank-you line wraps to as
--             many rows as it needs, and only the rows that reach the sticker end left of it. Rebuilt when the screen
--             changes size.
--             (kit B, U2) The roof, header, wood frame and body are shared/SignKit parts; the gable (Shape = "Gable") and
--             the K.SIGN colours go in as overrides, so the window looks exactly as the owner approved it
--             (smoke credits_unchanged_on_signkit pins its dump).
-- Every window: X, Esc (InputBegan), gamepad B ("NimbusMenuWinBack", High, bound while one is open) and CloseWindows close
-- it; opening one fires MenuController.WindowOpened(<name>) (the game's windows close on it, as for each other) and
-- closes the DEV panel, so nothing peeks out from under it (the Restart / Skip tutorial buttons did, under Credits).
-- MouseLock (client/MouseLock.lua, dungeon-fixes decision 6): Init starts it (idempotent); the menu screen is a hold
-- ("MainMenu", from Open until the PLAY fade ends); the windows are holds through NeonKit.Dock.
--
-- Public: Init(), Open(), Play(), IsOpen(), OpenSettings(), OpenUpdates(), OpenCredits(), CloseWindows(), Window(),
-- CreditsMetrics (the K.CR table: sizes; MEASURE, a text-width hook for the offline renderer)
-- Plain Lua 5.1-compatible syntax only; fonts only through Theme roles.

