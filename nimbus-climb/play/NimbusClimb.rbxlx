	},
}

-- In-world palette for Parts (lobby, courses, tokens, hazards). Calm, never pure white; platform
-- tops are clearly lighter than their sides, hazards are a distinct dark red/purple, checkpoints
-- teal. Trim colours are per difficulty id (Config.Difficulties order) and also by index.
Theme.World = {
	-- Peaks are 214 / 184 / 150 on purpose: the same ceiling LobbyBuilder clamps to, so the lobby
	-- and every course platform (and the Start/Finish pads) share one calm palette and the blue
	-- channel does not clip towards white-cyan under the late-afternoon sun.
	CloudTop = rgb(183, 194, 214),
	CloudSide = rgb(135, 152, 184),
	CloudShadow = rgb(96, 113, 150),
	Hazard = rgb(160, 62, 94),
	HazardGlow = rgb(222, 100, 124),
	Checkpoint = rgb(62, 172, 152),
	Token = rgb(238, 194, 86),
	Storm = rgb(58, 64, 94),
	Wind = rgb(150, 198, 226),
	Water = rgb(96, 156, 214),
	Trim = {
		Easy = rgb(96, 190, 140),
		Medium = rgb(96, 160, 224),
		Hard = rgb(226, 150, 74),
		Extreme = rgb(214, 92, 104),
		Saint = rgb(150, 110, 220), -- violet, mirrors Config.Difficulties Saint (gold is reserved for stars/tokens)
		rgb(96, 190, 140),
		rgb(96, 160, 224),
		rgb(226, 150, 74),
		rgb(214, 92, 104),
		rgb(150, 110, 220),
	},
	Rainbow = {
		rgb(206, 96, 112),
		rgb(214, 148, 84),
		rgb(214, 190, 96),
		rgb(100, 174, 128),
		rgb(92, 150, 206),
		rgb(142, 118, 206),
	},
}

-- v5: a neon colour by category ("Pets"), by neon name ("Orange", any case) or a Color3 passed through; anything
-- else (nil, unknown) is the Blue neon.
function Theme.NeonColor(categoryOrColorName)
	if typeof(categoryOrColorName) == "Color3" then
		return categoryOrColorName
	end
	if type(categoryOrColorName) ~= "string" or categoryOrColorName == "" then
		return Theme.Neon.Blue
	end
	local name = categoryOrColorName
	local category = Theme.Category[name]
	if category then
		return Theme.Neon[category]
	end
	if Theme.Neon[name] then
		return Theme.Neon[name]
	end
	local lower = name:lower()
	for key, value in pairs(Theme.Category) do
		if key:lower() == lower then
			return Theme.Neon[value]
		end
	end
	for key, value in pairs(Theme.Neon) do
		if key:lower() == lower then
			return value
		end
	end
	if lower == "gray" then
		return Theme.Neon.Grey
	end
	return Theme.Neon.Blue
end

-- Colour for a health fraction 0..1 (green -> amber -> red).
function Theme.HealthColor(fraction)
	if fraction > 0.6 then
		return Theme.Colors.Health
	elseif fraction > 0.3 then
		return Theme.Colors.HealthMid
	end
	return Theme.Colors.HealthLow
end

----------------------------------------------------------------------
-- Colour helpers (shading stays navy-tinted so shadows feel cool, not muddy)
----------------------------------------------------------------------
local SHADE_TARGET = Color3.fromRGB(14, 20, 52)
local LIGHT_TARGET = Color3.fromRGB(238, 244, 255)

function Theme.Mix(a, b, t)
	return a:Lerp(b, t)
end

-- k in 0..1: how far towards the dark navy shade.
function Theme.Darken(color, k)
	return color:Lerp(SHADE_TARGET, k)
end

-- k in 0..1: how far towards soft pale cloud (never pure white).
function Theme.Lighten(color, k)
	return color:Lerp(LIGHT_TARGET, k)
end

----------------------------------------------------------------------
-- Numbers
----------------------------------------------------------------------
local SUFFIXES = { "K", "M", "B", "T", "Qa", "Qi" }

local function commas(n)
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local function trimDecimals(text)
	if text:find("%.") then
		text = text:gsub("0+$", "")
		text = text:gsub("%.$", "")
	end
	return text
end

-- Big-number display: below `fullBelow` (default 10000) with thousands separators ("9,999"), above it
-- three significant digits plus a suffix ("12.3K", "456K", "1.23M", "7B"). Digits are truncated, never
-- rounded up, so the display never claims more than the player has.
function Theme.ShortNumber(n, fullBelow)
	n = tonumber(n) or 0
	if n ~= n then -- NaN
		n = 0
	end
	local sign = ""
	if n < 0 then
		sign = "-"
		n = -n
	end
	n = math.floor(n)
	if n < (tonumber(fullBelow) or 10000) then
		return sign .. commas(n)
	end
	local value = n
	local index = 0
	while value >= 1000 and index < #SUFFIXES do
		value = value / 1000
		index = index + 1
	end
	if index == 0 then
		return sign .. commas(n)
	end
	local text
	if value >= 100 then
		text = tostring(math.floor(value))
	elseif value >= 10 then
		text = trimDecimals(string.format("%.1f", math.floor(value * 10) / 10))
	else
		text = trimDecimals(string.format("%.2f", math.floor(value * 100) / 100))
	end
	return sign .. text .. SUFFIXES[index]
end

----------------------------------------------------------------------
-- Text + small GUI builders
----------------------------------------------------------------------

-- Thick outline around the GLYPHS of a text object (a UIStroke in Contextual mode). Reuses an existing
-- outline made by this function. Use it on labels without a border stroke (a UIStroke in Border mode
-- outlines the box instead; CloudUI puts both on its buttons).
function Theme.TextOutline(obj, thickness, color, transparency)
	if not obj then
		return nil
	end
	local outline = obj:FindFirstChild("TextOutline")
	if not (outline and outline:IsA("UIStroke")) then
		outline = Instance.new("UIStroke")
		outline.Name = "TextOutline"
		outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		outline.LineJoinMode = Enum.LineJoinMode.Round
		outline.Parent = obj
	end
	outline.Color = color or Theme.Colors.TextStroke
	outline.Thickness = thickness or 2
	outline.Transparency = transparency or 0
	return outline
end

-- Apply a font role + outline to any TextLabel/TextButton/TextBox.
-- opts: Size (design px; default Theme.Sizes[role]), Color, Stroke (0..1 transparency of the classic text
--       stroke, default 0.4), StrokeColor, Scaled (bool), Outline (thickness: adds Theme.TextOutline),
--       OutlineColor, OnLight (bool: dark text stroke at full strength for pale or busy backgrounds)
function Theme.Style(obj, role, opts)
	opts = opts or {}
	obj.Font = Theme.Fonts[role] or Theme.Fonts.Body
	obj.TextColor3 = opts.Color or Theme.Colors.White
	obj.TextStrokeColor3 = opts.StrokeColor or Theme.Colors.Ink
	local stroke = opts.Stroke
	if stroke == nil then
		stroke = opts.OnLight and 0 or 0.4
	end
	obj.TextStrokeTransparency = stroke
	if opts.Scaled then
		obj.TextScaled = true
	elseif opts.Size then
		obj.TextSize = opts.Size
	else
		obj.TextSize = Theme.RoleSize(role)
	end
	if opts.Outline then
		local thickness = tonumber(opts.Outline) or 2
		Theme.TextOutline(obj, thickness, opts.OutlineColor or opts.StrokeColor or Theme.Colors.TextStroke, 0)
	end
	return obj
end

-- Build a styled TextLabel. props are applied after styling so you can override anything.
-- Theme.Label("Hello", "Title", {Size = 36, Outline = 2, Props = {Position = UDim2.new(0, 0, 0, 0)}})
function Theme.Label(text, role, opts)
	opts = opts or {}
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Text = text
	Theme.Style(label, role, opts)
	if opts.Props then
		for key, value in pairs(opts.Props) do
			label[key] = value
		end
	end
	return label
end

function Theme.Corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = radius or UDim.new(0, 12)
	c.Parent = parent
	return c
end

function Theme.Stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color or Theme.Colors.Ink
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0.2
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

-- Vertical two-colour gradient on a GuiObject.
function Theme.Gradient(parent, top, bottom, rotation)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(top, bottom)
	g.Rotation = rotation or 90
	g.Parent = parent
	return g
end

-- Rounded dark card used for compact HUD elements (windows use CloudUI.Panel). v3: a solid card (text on
-- it always reads), a thick navy outline and a soft top-to-bottom gradient.
function Theme.Panel(props)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = Theme.Colors.White
	frame.BackgroundTransparency = 0.08
	frame.BorderSizePixel = 0
	Theme.Corner(frame, UDim.new(0, 14))
	Theme.Stroke(frame, Theme.Colors.Navy, 3, 0)
	Theme.Gradient(frame, Theme.Colors.PanelLight, Theme.Colors.Panel, 90)
	if props then
		for key, value in pairs(props) do
			frame[key] = value
		end
	end
	return frame
end

return Theme
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="822">
        <Properties>
          <string name="Name">TokenLook</string>
          <string name="Source"><![CDATA[-- TokenLook: the look of the voxel cloud token, built by one function (ARCHITECTURE_V3.md "Phase 5 build contract"
-- 3.5). The obby's cloud tokens (TokenService.MakeTokenPart: palettes "Cloud" / "Golden", the output is the Phase 4
-- token part for part) and the Cloud Cash of the home (HomeFx: "Cash" / "GoldenCash", pooled, client only) share it.
-- Shared module: no yields, no animation (the callers own those); the only tag / attributes are the Phase 6 mesh ones.
-- Plain Lua 5.1-compatible syntax.
--
-- The voxel coin (v3 art direction): every piece is a block on one lattice (u studs per voxel, 11 voxels across). The
-- round silhouette is three overlapping centred blocks (the 9x9 root + 11x5 and 5x11 bands) in a lighter glowing rim,
-- the face sits half a voxel proud of the rim on both sides (a 7x7 plate; an octagon of two plates on golden coins),
-- and the cream cloud emblem (a 5x2 base under a centred 3x1 dome) stands half a voxel proud of the face. A soft
-- translucent halo (an anchored, unwelded ball: it never needs to spin) makes the coin read from far away.
--
-- API (the contract):
--   TokenLook.Build(opts) -> Part   the root (the 9x9 core block; Anchored, CanCollide false, CanTouch true, CanQuery
--     false) with the children RimWide, RimTall, Face (or FaceWide + FaceTall), CloudBase, CloudPuff (welded), Halo
--     (anchored, unwelded), TokenLight (PointLight) and Sparkles (ParticleEmitter). The coin stands on its edge facing
--     local X: spinning it about world Y shows both faces.
--     opts = { Position = Vector3 (centre; default 0,0,0), Parent = Instance | nil (set LAST), Palette = "Cloud" |
--       "Golden" | "Cash" | "GoldenCash" (default "Cloud"), Scale = number (default 1, x the palette's own scale),
--       Light = bool (default true), Sparkles = bool (default true), Phase = radians of yaw (default 0),
--       Halo = bool (extra; default true for Cloud / Golden, false for the cash palettes: 6 parts per Cash coin) }
--     Parts: Cloud 7, Golden 8 (halo included); Cash / GoldenCash 6 without the halo.
--   TokenLook.Palettes[name] = { Scale, Rim, Face, Cloud, Glow, Octagon, HaloScale, HaloTransparency, LightBrightness,
--     LightRange, SparkleRate, SparkleSize, SparkleLife, SparkleSpeed, SparkleAlpha, Spin, Bob, Name }   READ-ONLY
--   TokenLook.Motion = { Spin 2.0, GoldenSpin 2.6, Bob 0.45, GoldenBob 0.6, BobSpeed 2.2 }   (radians/s, studs)
--   TokenLook.Voxel = 0.32 (studs per voxel at Scale 1), TokenLook.HaloDiameter = 5.4
--   TokenLook.MeshKey(palette) -> "token_cloud" | "token_golden" | "token_cash" | "token_goldencash"
--
-- Phase 6 (ARCHITECTURE_V3.md "## Phase 6"; Blender keys token_<kind>, blender/catalog/creatures.json): the coin's
-- look becomes a Blender mesh while the root stays the same Part (the CanTouch hitbox, the light, the sparkles):
--   * client-built coins (HomeFx Cloud Cash): when the key is ready on this device the coin is the mesh: its
--     MeshParts (named by the mesh's colour keys: Rim, Face, Cloud ...) are welded to the root, which turns invisible;
--     the block children are not made. Otherwise the blocks exactly as before.
--   * server-built coins (TokenService): always the blocks; once the key has an uploaded id the root is tagged for
--     MeshLibrary (ML_DressKey, Keep = Halo, ML_Weld = true: the dressed mesh rides on the moving root), so every
--     client shows the mesh it could download and keeps the blocks otherwise. Empty MeshIds = nothing changes.

local Shared = script.Parent

local TokenLook = {}

-- Theme is only used for its in-world palette; a broken UI kit must never take the tokens down.
local themeModule = Shared:FindFirstChild("Theme")
local themeOk, Theme = false, nil
if themeModule then
	themeOk, Theme = pcall(require, themeModule)
end
if not themeOk or type(Theme) ~= "table" then
	Theme = {}
end

local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

local MESH_KEYS = { Cloud = "token_cloud", Golden = "token_golden", Cash = "token_cash", GoldenCash = "token_goldencash" }
function TokenLook.MeshKey(paletteName)
	return MESH_KEYS[paletteName] or MESH_KEYS.Cloud
end

local lazyMesh = nil
local function meshLibrary()
	if lazyMesh == nil then
		lazyMesh = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.IsReady) == "function" then
				lazyMesh = mod
			end
		end
	end
	return lazyMesh or nil
end

local IS_CLIENT = false
do
	local okRun, run = pcall(function()
		return game:GetService("RunService")
	end)
	if okRun and run then
		IS_CLIENT = run:IsClient()
	end
end

-- the welded mesh coin on a client-built root (true when it was made)
local function meshCoin(token, key, scale)
	local ML = meshLibrary()
	if not ML or not IS_CLIENT then
		return false
	end
	local okReady, ready = pcall(ML.IsReady, key)
	if not okReady or ready ~= true then
		return false
	end
	local okAsm, mesh = pcall(ML.Assemble, { Name = "Coin", Root = false, Parts = { { Key = key } } }, {}, { Scale = scale, At = token.CFrame })
	if not okAsm or not mesh then
		return false
	end
	for _, part in ipairs(mesh:GetChildren()) do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.Massless = true
			part.CastShadow = false
			part.Parent = token
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = token
			weld.Part1 = part
			weld.Parent = part
		end
	end
	mesh:Destroy()
	token.Transparency = 1
	return true
end

-- server-built coin: tag it for the clients' MeshLibrary.Dress once the key has an uploaded id
local function tagCoin(token, key)
	local ML = meshLibrary()
	if not ML or IS_CLIENT or type(ML.Tag) ~= "function" or type(ML.Status) ~= "function" then
		return false
	end
	local okStatus, st = pcall(ML.Status, key)
	if not okStatus or st == "missing" then
		return false
	end
	ML.Tag(token, key, nil, { "Halo" })
	token:SetAttribute("ML_Weld", true)
	return true
end

TokenLook.Voxel = 0.32 -- studs per coin voxel (a normal coin: 11 voxels = 3.5 studs across)
TokenLook.HaloDiameter = 5.4

TokenLook.Motion = {
	Spin = 2.0, -- radians per second around the vertical axis
	GoldenSpin = 2.6,
	Bob = 0.45, -- bob amplitude in studs
	GoldenBob = 0.6,
	BobSpeed = 2.2, -- radians per second of the up / down sine
}

local function colorOr(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	return fallback
end

local WORLD = type(Theme.World) == "table" and Theme.World or {}
local COLORS = type(Theme.Colors) == "table" and Theme.Colors or {}
local GOLD = colorOr(WORLD.Token, Color3.fromRGB(232, 168, 48))
local GLOW = GOLD:Lerp(Color3.fromRGB(255, 240, 190), 0.45)
local CASH = colorOr(COLORS.Cash, Color3.fromRGB(112, 204, 98))
local CASH_GLOW = colorOr(COLORS.CashGlow, Color3.fromRGB(196, 240, 150))
local M = TokenLook.Motion

-- Everything that differs between the looks (Cloud / Golden = the Phase 4 normal / golden token, unchanged).
TokenLook.Palettes = {
	Cloud = {
		Name = "CloudToken",
		Scale = 1,
		Rim = Color3.fromRGB(255, 206, 92), -- the glowing outer ring (Neon)
		Face = GOLD, -- the coin face
		Cloud = Color3.fromRGB(255, 244, 218), -- the cloud emblem in relief
		Glow = GLOW,
		Octagon = false,
		HaloScale = 1,
		HaloTransparency = 0.86,
		LightBrightness = 1.0,
		LightRange = 11,
		SparkleRate = 5,
		SparkleSize = 0.55,
		SparkleLife = NumberRange.new(0.9, 1.6),
		SparkleSpeed = NumberRange.new(0.4, 1.2),
		SparkleAlpha = 0.15,
		Spin = M.Spin,
		Bob = M.Bob,
	},
	Golden = {
		Name = "GoldenCloudToken",
		Scale = 1.5,
		Rim = Color3.fromRGB(255, 236, 156),
		Face = Color3.fromRGB(255, 212, 92),
		Cloud = Color3.fromRGB(255, 250, 238),
		Glow = Color3.fromRGB(255, 230, 150),
		Octagon = true,
		HaloScale = 1.2,
		HaloTransparency = 0.82,
		LightBrightness = 2.0,
		LightRange = 17,
		SparkleRate = 16,
		SparkleSize = 0.95,
		SparkleLife = NumberRange.new(1.1, 2.0),
		SparkleSpeed = NumberRange.new(0.4, 2.2),
		SparkleAlpha = 0.05,
		Spin = M.GoldenSpin,
		Bob = M.GoldenBob,
	},
	-- Cloud Cash (the home): a mint-green glowing rim (Theme Cash), a gold face, a white cloud
	Cash = {
		Name = "CashCoin",
		Scale = 1,
		Rim = CASH,
		Face = GOLD,
		Cloud = Color3.fromRGB(250, 252, 246),
		Glow = CASH_GLOW,
		Octagon = false,
		HaloScale = 1,
		HaloTransparency = 0.86,
		LightBrightness = 0.8,
		LightRange = 9,
		SparkleRate = 3,
		SparkleSize = 0.45,
		SparkleLife = NumberRange.new(0.8, 1.4),
		SparkleSpeed = NumberRange.new(0.3, 1.0),
		SparkleAlpha = 0.2,
		Spin = M.Spin,
		Bob = M.Bob,
	},
	-- a Lucky drop (x5): a bright gold rim around a mint-green face (still Cloud Cash, but golden), a brighter sparkle
	GoldenCash = {
		Name = "GoldenCashCoin",
		Scale = 1.15,
		Rim = Color3.fromRGB(255, 214, 72),
		Face = CASH,
		Cloud = Color3.fromRGB(255, 252, 240),
		Glow = Color3.fromRGB(255, 236, 150),
		Octagon = false,
		HaloScale = 1.2,
		HaloTransparency = 0.82,
		LightBrightness = 1.6,
		LightRange = 13,
		SparkleRate = 12,
		SparkleSize = 0.8,
		SparkleLife = NumberRange.new(1.0, 1.8),
		SparkleSpeed = NumberRange.new(0.4, 1.8),
		SparkleAlpha = 0.05,
		Spin = M.GoldenSpin,
		Bob = M.GoldenBob,
	},
}

-- A non-colliding block of the coin, positioned by `offset` (relative to the root). static = true: anchored and NOT
-- welded (the spherical halo, which the animating caller bobs along with the coin); otherwise welded to the root.
local function addPiece(token, name, shape, size, offset, color, material, transparency, static)
	local piece = Instance.new("Part")
	piece.Name = name
	piece.Shape = shape
	piece.Size = size
	piece.Material = material
	piece.Color = color
	piece.Transparency = transparency or 0
	piece.Anchored = static == true
	piece.Massless = true
	piece.CanCollide = false
	piece.CanTouch = false
	piece.CanQuery = false
	piece.CastShadow = false
	piece.TopSurface = Enum.SurfaceType.Smooth
	piece.BottomSurface = Enum.SurfaceType.Smooth
	piece.CFrame = token.CFrame * offset
	piece.Parent = token
	if not static then
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = token
		weld.Part1 = piece
		weld.Parent = piece
	end
	return piece
end

-- One block of the coin lattice: centre (y, z) and size (thickness x height x width) in voxels.
local function addBlock(token, name, u, y, z, thick, height, width, color, material)
	return addPiece(token, name, Enum.PartType.Block, Vector3.new(thick * u, height * u, width * u),
		CFrame.new(0, y * u, z * u), color, material, 0)
end

local function finiteNumber(v, fallback)
	if type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge then
		return v
	end
	return fallback
end

function TokenLook.Build(opts)
	opts = type(opts) == "table" and opts or {}
	local paletteName = TokenLook.Palettes[opts.Palette] and opts.Palette or "Cloud"
	local look = TokenLook.Palettes[paletteName]
	local cash = paletteName == "Cash" or paletteName == "GoldenCash"
	local scale = look.Scale * math.max(0.05, finiteNumber(opts.Scale, 1))
	local u = TokenLook.Voxel * scale
	local phase = finiteNumber(opts.Phase, 0)
	local position = typeof(opts.Position) == "Vector3" and opts.Position or Vector3.new(0, 0, 0)
	local neon = Enum.Material.Neon
	local smooth = Enum.Material.SmoothPlastic

	-- the root: the 9x9 core of the rim silhouette (2 voxels thick)
	local token = Instance.new("Part")
	token.Name = look.Name
	token.Shape = Enum.PartType.Block
	token.Size = Vector3.new(2 * u, 9 * u, 9 * u)
	token.Material = neon
	token.Color = look.Rim
	token.Anchored = true
	token.CanCollide = false
	token.CanTouch = true
	token.CanQuery = false
	token.CastShadow = false
	token.TopSurface = Enum.SurfaceType.Smooth
	token.BottomSurface = Enum.SurfaceType.Smooth
	token.CFrame = CFrame.new(position) * CFrame.Angles(0, phase, 0)

	local key = TokenLook.MeshKey(paletteName)
	if not meshCoin(token, key, scale) then
		-- the rest of the stepped round silhouette: a wide and a tall band (11x5 and 5x11 voxels)
		addBlock(token, "RimWide", u, 0, 0, 2, 5, 11, look.Rim, neon)
		addBlock(token, "RimTall", u, 0, 0, 2, 11, 5, look.Rim, neon)

		-- the face, half a voxel proud of the rim on both sides: a 7x7 plate, or an octagon of two plates
		if look.Octagon then
			addBlock(token, "FaceWide", u, 0, 0, 3, 5, 7, look.Face, smooth)
			addBlock(token, "FaceTall", u, 0, 0, 3, 7, 5, look.Face, smooth)
		else
			addBlock(token, "Face", u, 0, 0, 3, 7, 7, look.Face, smooth)
		end

		-- the cloud emblem in relief (both sides): a 5x2 base under a centred 3x1 dome
		addBlock(token, "CloudBase", u, -0.5, 0, 4, 2, 5, look.Cloud, smooth)
		addBlock(token, "CloudPuff", u, 1, 0, 4, 1, 3, look.Cloud, smooth)
		tagCoin(token, key)
	end

	-- the soft translucent halo (not welded: a ball looks the same however the coin turns)
	local wantHalo = opts.Halo
	if wantHalo == nil then
		wantHalo = not cash
	end
	if wantHalo then
		local haloSize = TokenLook.HaloDiameter * look.HaloScale * scale
		addPiece(token, "Halo", Enum.PartType.Ball, Vector3.new(haloSize, haloSize, haloSize),
			CFrame.new(0, 0, 0), look.Glow, neon, look.HaloTransparency, true)
	end

	if opts.Light ~= false then
		local light = Instance.new("PointLight")
		light.Name = "TokenLight"
		light.Color = look.Face
		light.Brightness = look.LightBrightness
		light.Range = look.LightRange
		light.Shadows = false
		light.Parent = token
	end

	if opts.Sparkles ~= false then
		local sparkles = Instance.new("ParticleEmitter")
		sparkles.Name = "Sparkles"
		sparkles.Texture = SPARKLE_TEXTURE
		sparkles.Color = ColorSequence.new(look.Glow, look.Face)
		sparkles.LightEmission = 1
		sparkles.LightInfluence = 0
		sparkles.Rate = look.SparkleRate
		sparkles.Lifetime = look.SparkleLife
		sparkles.Speed = look.SparkleSpeed
		sparkles.SpreadAngle = Vector2.new(180, 180)
		sparkles.Rotation = NumberRange.new(0, 360)
		sparkles.RotSpeed = NumberRange.new(-60, 60)
		sparkles.Acceleration = Vector3.new(0, 0.8, 0)
		sparkles.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.3, look.SparkleSize),
			NumberSequenceKeypoint.new(1, 0),
		})
		sparkles.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.2, look.SparkleAlpha),
			NumberSequenceKeypoint.new(1, 1),
		})
		sparkles.Parent = token
	end

	if typeof(opts.Parent) == "Instance" then
		token.Parent = opts.Parent
	end
	return token
end

return TokenLook
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="823">
        <Properties>
          <string name="Name">TutorialSteps</string>
          <string name="Source"><![CDATA[-- TutorialSteps: the new-player tutorial, told by Nimbus the Cloudy Dragon (ARCHITECTURE_V3.md section 4 and the
-- Phase 2 "Tutorial" paragraph). Data only: TutorialService (server) walks a player through these steps in order and
-- TutorialController (client) shows them in the side panel.
--
-- Chapters. Saved progress is the step INDEX (Profile.Tutorial.Step), so steps are only ever APPENDED: chapter 1
-- (steps 1-9, the Phase 1 basics) keeps its indices, chapter 2 (the tycoon home, Phase 2) follows, Phase 3 appends
-- the arena (chapter 3, Phase 3: go to the Battle Arena, set a battle team, win Trial 1, see a Boss Raid) and Phase 4
-- appends chapter 4 (pets make the money: train a pet, win a Champion Ring round, use the home portal). Phase 4 also
-- rewrote chapter 2 IN PLACE (claim, garden, coins, machine, feed: still five steps at indices 10-14, so a saved
-- index keeps its place). Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 8) rewrites texts and targets IN PLACE
-- again, indices never move (chapter 1 = 1-9, 2 = 10-14, 3 = 15-18, 4 = 19-21): the portal step points at the ONE Obby
-- portal, chapter 2 speaks of the Berry Farm, Cloud Cash and berries, chapter 3's step 17 "trial" became "dungeon"
-- (clear floor 1 of the Dungeon; a saved Step 17 lands on it, a veteran with Trial 1 cleared skips it). Every text is
-- 97-125 bytes once its placeholders are filled (p5ui_content). A player who finished an earlier chapter resumes at the first step of the next one when it
-- ships (TutorialService: a stored Done tutorial whose Step points into a later chapter carries on from there; a
-- finished Phase 3 tutorial stored Step 19 = chapter 4's first step).
--
-- Step fields
--   Id          unique step id inside its chapter (chapter 4's "portal" shares its id with chapter 1's: IndexOf keeps
--               the FIRST index of an id; use the step index / ChapterStart to tell them apart)
--   Chapter     1 (basics), 2 (home), 3 (pet battles) or 4 (pets make the money); defaults to 1
--   ChapterEnd  true on the last step of a chapter: completing it pays the chapter's reward once
--               (chapter 1: Config.Tutorial.FinishReward; chapters 2, 3 and 4: TutorialService's rewards)
--   Title       short headline shown above the text
--   Text        what Nimbus says (short, friendly). Placeholders filled in by TutorialService:
--               {GiftTokens} = Config.Tutorial.GiftTokens, {FinishTokens} = Config.Tutorial.FinishReward.Tokens,
--               {RaidMinutes} = minutes between two Boss Raids (BattleCatalog.Events; the raid step builds its text from
--               BattleCatalog when this module loads, so it needs no placeholder)
--   Target      nil, or where the guide arrow points:
--                 { Kind = "Spot" }                     the player's own home plot (SpotIndex attribute)
--                 { Kind = "Spot", Gate = true }        the gate of the plot the player should claim: their claimed
--                                                       plot, else their last plot when free, else the nearest free
--                                                       plot (SpotService.SuggestSpot)
--                 { Kind = "Spot", Pad = "Press1" }     a buy pad on the player's own plot (Pad_<StationId>)
--                     + Path = true                     ...or the next pad on the way to it (its prerequisites)
--                     + Station = "Gym"                 ...or that station once it is built
--                 { Kind = "Spot", Station = "Kitchen", Food = true }   the Food Machine (its Hopper) once it is built,
--                                                       else the pads on the way to it
--                 { Kind = "Spot", Pad = "Garden", Station = "Garden", GardenSpot = true }   no pet: the Shop; the free
--                                                       Pet Garden pad until it is built; then the first empty open
--                                                       garden place (else the Pets menu button)
--                 { Kind = "Spot", Station = "Garden", Coins = true }   the biggest Cloud Cash drop of the yard
--                                                       (TycoonService.Drops; Piles as a fallback), else the Garden
--                 { Kind = "Shop" }                     the roulette machines (Roulette_<first roulette id>)
--                 { Kind = "Roulette", Id = "Cloud" }   model Roulette_<Id> under workspace.NimbusLobby
--                 { Kind = "Portal", Id = "Obby" }      model Portal_<Id> under workspace.NimbusLobby (Phase 5: the ONE
--                                                       Obby portal in the Gate Court; lobby.Portals.Obby on the server)
--                 { Kind = "Menu", Id = "Pets" }        the menu button MenuButton_<Id> ("Team": the battle team tile)
--                 { Kind = "Arena", Place = "Gate" }    Phase 3, resolved by TutorialService from ArenaInfo and sent as
--                                                       { Kind = "Spot", Position, Label }: "Gate" = the Arena gate of the
--                                                       Gate Court (ArenaInfo.ArenaPortal; else the forum, ArenaInfo.Spawn),
--                                                       "Floor" = the colosseum floor (raids), "Ring" = the Champion Ring
--                                                       portal (ArenaInfo.RingPortal), "Dungeon" (Phase 5) = the Dungeon
--                                                       gate's pad (DungeonInfo.Pad)
--               Label (optional) names the target on the floating sign above the arrow. TutorialService resolves
--               the home targets on the server and sends Kind "Spot" + Position (or Kind "Menu") to the client.
--   CompleteOn  "Next"         the player presses Next (client event)
--               "NearSpot"     within 14 studs of the player's own SpotInfo.Center (server poll; kept for old data)
--               "Claimed"      the player owns a home plot (claimed with E at a gate)
--               "Built"        the home has the station `Station` at level 1 or more
--               "Collected"    (Phase 2, retired: no step uses it; a step that still did would pass at once)
--               "Fed"          the player fed a pet (PetCareService.Fed: the Food Machine / the Pets panel)
--               "ShopOpened"   the Shop window opened (client event)
--               "Rolled"       a roulette spin succeeded (PetService.Rolled)
--               "Equipped"     the player equips a pet / opens Pets with a pet equipped
--               "IndexOpened"  the Pet Index window opened (client event)
--               "MatchStarted" the player's InMatch attribute turned true
--               "MatchEnded"   the player's InMatch attribute turned false again
--               "ArenaReached" the player stands in the Battle Arena (ArenaBuilder.InArena, server poll)
--               "TeamSet"      the active battle team holds the player's pets: min(3, pets that can join a team)
--                              (DataService.TeamsChanged / ActiveTeamKeys / FieldableKeys)
--               "DungeonWon"   (Phase 5, replaces TrialWon) Dungeon floor 1 is cleared (DungeonService.FloorCleared, or the
--                              saved Dungeon.Best >= 1, or a legacy Battle.TrialCleared[1]: veterans skip it)
--               "RaidSeen"     the player joined a Boss Raid, or stood in the arena while one was running
--               "GardenPlaced" (Phase 4) a pet sits in an open place of the Pet Garden (Home.Garden)
--               "CoinsScooped" the player scooped Cloud Cash (TycoonService.CoinsScooped; a home that already has
--                              the Food Machine passes at once)
--               "TrainingStarted" a pet trains or has trained (PetCareService.TrainingStarted / PetGrowth job or rank)
--               "RingWon"      a Champion Ring round was won (BattleService.BattleEnded Mode "Ring", or Ring.Best >= 1)
--               "PortalUsed"   the player walked through their home portal (TycoonService.PortalUsed)
--   Station     the station id a "Built" step waits for
--   Gift        true: entering this step grants Config.Tutorial.GiftTokens once (Profile.Tutorial.Gifted)
--   Hint        short objective line shown under the text while the step waits for an action (TutorialService
--               may send a more precise one, e.g. the next pad on the way to the Kitchen)
--   Button      label of the Next button (CompleteOn = "Next" only)
--
-- Plain Lua 5.1-compatible syntax only.

local TutorialSteps = {}

-- the level of the first evolution for the chapter 2 text (PetCatalog.EvolutionLevels[1]; 20 without it)
local EVOLVE_LEVEL = 20
do
	local module = script.Parent:FindFirstChild("PetCatalog")
	if module then
		local ok, catalog = pcall(require, module)
		local levels = ok and type(catalog) == "table" and catalog.EvolutionLevels or nil
		if type(levels) == "table" and tonumber(levels[1]) then
			EVOLVE_LEVEL = math.floor(tonumber(levels[1]))
		end
	end
end

-- minutes between two Boss Raids for the chapter 3 text (BattleCatalog.Events; data read once, 20 without it) and the
-- name of Dungeon floor 1 (BattleCatalog.DungeonFloors[1].Name; "Mossy Cellar" without it)
local RAID_MINUTES = 20
local FLOOR_ONE = "Mossy Cellar"
do
	local module = script.Parent:FindFirstChild("BattleCatalog")
	if module then
		local ok, catalog = pcall(require, module)
		local events = ok and type(catalog) == "table" and catalog.Events or nil
		local first = type(events) == "table" and type(events.Schedule) == "table" and events.Schedule[1] or nil
		if type(first) == "table" and tonumber(first.EveryMinutes) then
			RAID_MINUTES = math.floor(tonumber(first.EveryMinutes))
		end
		local floors = ok and type(catalog) == "table" and catalog.DungeonFloors or nil
		local one = type(floors) == "table" and floors[1] or nil
		if type(one) == "table" and type(one.Name) == "string" and one.Name ~= "" then
			FLOOR_ONE = one.Name
		end
	end
end

TutorialSteps.Guide = {
	Name = "Nimbus",
	Title = "the Cloudy Dragon",
	PetId = "cloudy_dragon", -- PetCatalog id of the portrait in the side panel
}

TutorialSteps.Steps = {
	----------------------------------------------------------------------------------------------- chapter 1: basics
	{
		Id = "welcome",
		Chapter = 1,
		Title = "Hi there, climber!",
		Text = "I'm Nimbus, the Cloudy Dragon! Welcome to my sky village. Stick with me and I'll show you around. It's quick, promise!",
		Target = nil,
		CompleteOn = "Next",
		Button = "Let's go!",
	},
	{
		-- (Phase 2: homes are claimed with E at their gate, so this step now leads to a free gate)
		Id = "home",
		Chapter = 1,
		Title = "Your Home Plot",
		Text = "Every climber can have a home plot on the big ring! Follow my golden arrow to a free gate and press E to make it yours.",
		Target = { Kind = "Spot", Gate = true, Label = "Free home" },
		CompleteOn = "Claimed",
		Hint = "Press E at a free gate",
	},
	{
		Id = "shop",
		Chapter = 1,
		Title = "The Cloud Shop",
		Text = "Next stop: the Cloud Shop! Follow the arrow to the roulette machines and open one. The Shop button works too!",
		Target = { Kind = "Shop", Label = "Cloud Shop" },
		CompleteOn = "ShopOpened",
		Hint = "Open the shop",
	},
	{
		Id = "spin",
		Chapter = 1,
		Title = "Your First Pet",
		Text = "Here are {GiftTokens} Cloud Tokens, my treat! Spin the Cloud Roulette to hatch your very first pet buddy. Good luck!",
		Target = { Kind = "Roulette", Id = "Cloud", Label = "Cloud Roulette" },
		CompleteOn = "Rolled",
		Gift = true,
		Hint = "Spin a roulette",
	},
	{
		Id = "equip",
		Chapter = 1,
		Title = "Pick a Buddy",
		Text = "Aww, a new friend! Open Pets and equip your buddy so it follows right behind you. Pets give handy perks!",
		Target = { Kind = "Menu", Id = "Pets" },
		CompleteOn = "Equipped",
		Hint = "Tap the glowing Pets button",
	},
	{
		Id = "index",
		Chapter = 1,
		Title = "The Pet Index",
		Text = "Every pet you find lands in the Pet Index. Take a peek! Collect a whole rarity group for a big reward.",
		Target = { Kind = "Menu", Id = "Index" },
		CompleteOn = "IndexOpened",
		Hint = "Tap the glowing Index button",
	},
	{
		Id = "portal",
		Chapter = 1,
		Title = "Time to Climb!",
		-- (Phase 5: the ONE Obby portal of the Gate Court; the first player on its pad picks the level, Easy for a newcomer)
		Text = "Now the fun part! Step on the Obby portal pad - Easy is picked for you. Friends can hop in with you.",
		Target = { Kind = "Portal", Id = "Obby", Label = "Obby portal" },
		CompleteOn = "MatchStarted",
		Hint = "Stand on the Obby pad",
	},
	{
		Id = "finish",
		Chapter = 1,
		Title = "Up, Up and Away!",
		Text = "Hop from cloud to cloud, grab the shiny tokens and reach the finish. Checkpoints keep your progress. You've got this!",
		Target = nil,
		CompleteOn = "MatchEnded",
		Hint = "Reach the finish",
	},
	{
		Id = "done",
		Chapter = 1,
		ChapterEnd = true,
		Title = "You're a Natural!",
		Text = "That's the basics, climber! Here are {FinishTokens} Cloud Tokens to celebrate. Next up: your very own home in the sky!",
		Target = nil,
		CompleteOn = "Next",
		Button = "Collect!",
	},
	------------------------------------------------------------------------------------- chapter 2: the tycoon home
	{
		Id = "claim",
		Chapter = 2,
		Title = "Claim Your Home",
		Text = "Homes are the heart of Nimbus Village! Walk up to a free gate and press E. The plot is yours for as long as you play.",
		Target = { Kind = "Spot", Gate = true, Label = "Free home" },
		CompleteOn = "Claimed",
		Hint = "Press E at a free gate",
	},
	{
		-- (Phase 4: was "press", the first Cloud Press; the index stays 11)
		Id = "garden",
		Chapter = 2,
		Title = "Your Pet Garden",
		Text = "Your pets make the money! Build your free Pet Garden, then press E on a pet bed to put a pet in it.",
		Target = { Kind = "Spot", Pad = "Garden", Station = "Garden", GardenSpot = true, Label = "Pet Garden" },
		CompleteOn = "GardenPlaced",
		Hint = "Put a pet in your Pet Garden",
	},
	{
		-- (Phase 4: was "collect", the Collector; Phase 5: roaming pets poop Cloud Cash, the arrow finds the biggest drop)
		Id = "coins",
		Chapter = 2,
		Title = "Cloud Cash!",
		Text = "Garden pets roam your yard, eat at the Food Bowl and poop Cloud Cash. Only you can scoop it: walk over it!",
		Target = { Kind = "Spot", Station = "Garden", Coins = true, Label = "Cloud Cash" },
		CompleteOn = "CoinsScooped",
		Hint = "Walk over your Cloud Cash",
	},
	{
		-- (Phase 4: was "kitchen"; the station id stays Kitchen, its name is the Food Machine. Phase 5: the Path walks the
		-- Berry Farm pad (Press1, the Food Machine's prerequisite) until it is built, then the Food Machine pad)
		Id = "machine",
		Chapter = 2,
		Title = "Berries for XP!",
		Text = "Build the Berry Farm, then the Food Machine: the farm grows berries and the machine turns them into XP!",
		Target = { Kind = "Spot", Pad = "Kitchen", Path = true, Label = "Food Machine pad" },
		CompleteOn = "Built",
		Station = "Kitchen",
		Hint = "Berry Farm, then Food Machine",
	},
	{
		Id = "feed",
		Chapter = 2,
		ChapterEnd = true,
		Title = "Snack Time!",
		-- (Phase 5: feeding costs berries; entering this step tops the player's berries up for the first feed)
		Text = "Press E at the Food Machine and press Feed: your berries become XP. At level " .. EVOLVE_LEVEL
			.. " your pet can EVOLVE!",
		Target = { Kind = "Spot", Station = "Kitchen", Food = true, Label = "Food Machine" },
		CompleteOn = "Fed",
		Hint = "Feed a pet at the Food Machine",
	},
	-------------------------------------------------------------------------------------- chapter 3: pet battles
	{
		Id = "arena",
		Chapter = 3,
		Title = "The Battle Arena",
		Text = "Your pets are strong enough to battle now! Follow my arrow to the Arena gate and press E to visit the Battle Arena.",
		Target = { Kind = "Arena", Place = "Gate", Label = "Battle Arena" },
		CompleteOn = "ArenaReached",
		Hint = "Go to the Battle Arena",
	},
	{
		Id = "team",
		Chapter = 3,
		Title = "Pick Your Team",
		Text = "Battles need a team of 3 (a fighter + 2 helpers)! Tap Team and put your pets in. Same-element pets power each other up!",
		Target = { Kind = "Menu", Id = "Team" },
		CompleteOn = "TeamSet",
		Hint = "Tap Team and put in 3 pets",
	},
	{
		-- (Phase 5: was "trial", Trial 1 at the Trial Portal; the index stays 17)
		Id = "dungeon",
		Chapter = 3,
		Title = "Into the Dungeon!",
		Text = "Press E at the Dungeon portal, start Floor 1: the " .. FLOOR_ONE
			.. ". Beat every room: pets attack by themselves, helpers buff!",
		Target = { Kind = "Arena", Place = "Dungeon", Label = "Dungeon portal" },
		CompleteOn = "DungeonWon",
		Hint = "Clear Dungeon floor 1",
	},
	{
		Id = "raid",
		Chapter = 3,
		ChapterEnd = true,
		Title = "Boss Raids!",
		Text = "Every " .. RAID_MINUTES .. " minutes a giant boss stomps into the colosseum and everyone fights it together. Be there!",
		Target = { Kind = "Arena", Place = "Floor", Label = "Boss Raid floor" },
		CompleteOn = "RaidSeen",
		Hint = "Join or watch a Boss Raid",
	},
	---------------------------------------------------------------------- chapter 4: pets make the money (Phase 4)
	{
		Id = "train",
		Chapter = 4,
		Title = "Training Time",
		Text = "Your Training Place makes pets stronger: pick a pet and a skill. Training pets rest at home until they're done!",
		Target = { Kind = "Spot", Pad = "Gym", Station = "Gym", Path = true, Label = "Training Place" },
		CompleteOn = "TrainingStarted",
		Hint = "Start training a pet",
	},
	{
		Id = "ring",
		Chapter = 4,
		Title = "The Champion Ring",
		Text = "Claim your home, then press E at the Champion Ring portal on the plaza. Beat the champion: Cash and XP!",
		Target = { Kind = "Arena", Place = "Ring", Label = "Champion Ring" },
		CompleteOn = "RingWon",
		Hint = "Win a round in the Champion Ring",
	},
	{
		Id = "portal",
		Chapter = 4,
		ChapterEnd = true,
		Title = "Portal Home",
		Text = "Tap Home, then Go home: a magic portal opens just for you and your pets. Hop in and you're home in a blink!",
		Target = { Kind = "Menu", Id = "Home", Label = "Home" },
		CompleteOn = "PortalUsed",
		Hint = "Tap Home, then Go home",
	},
}

-- Id -> index lookup (the FIRST step with that id: chapter 1's "portal" is 7, chapter 4's is ChapterStart[4] + 2) and
-- the first step of every chapter (data, built once).
TutorialSteps.IndexOf = {}
TutorialSteps.ChapterStart = {}
for index, step in ipairs(TutorialSteps.Steps) do
	if not TutorialSteps.IndexOf[step.Id] then
		TutorialSteps.IndexOf[step.Id] = index
	end
	local chapter = step.Chapter or 1
	if not TutorialSteps.ChapterStart[chapter] then
		TutorialSteps.ChapterStart[chapter] = index
	end
end

return TutorialSteps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="824">
        <Properties>
          <string name="Name">TycoonCatalog</string>
          <string name="Source"><![CDATA[-- TycoonCatalog: every number of the tycoon homes (ARCHITECTURE_V3.md "Phase 4 build contract" 3.1-3.5, 3.7, 3.12,
-- 5.4 and the "Phase 5 build contract" 3.1, 3.3-3.5, 9.2): the 11 stations and their buy pads, prices (and the star
-- price rule), effects per level, house tiers, prestige, the Cloud Cash of the Pet Garden, berries, the Food Machine,
-- the Training Place, fusion costs, the pet XP curve, the one-time Phase 5 fold of old homes and where everything
-- stands on the 72 x 72 stud yard (+ the roaming layout HomeRoam builds its walk graph from).
-- Pure data + pure functions: no Instances, no services, no yields; safe on the server and the client.
-- Plain Lua 5.1-compatible syntax only.
--
-- PHASE 5 IN ONE PARAGRAPH: the home got simpler. ONE Berry Farm (id Press1, 40 levels, Kind "Farm": Effects.Food)
-- replaces the four plants; the Coin Magnet is merged into the Pet Garden (Effects.Radius / PileSeconds by Garden
-- level); three decor stations (Yard Fence, Fountain, Pet Podium) at 0.4x the Phase 4 price. Garden pets roam the yard
-- (shared/HomeRoam.lua builds its walk graph from RoamLayout()), eat at the Food Bowl and poop Cloud Cash worth
-- CoinValue x Coins.PoopMeals; every coin also grows Berries.Share berries into the Berry Basket (BasketCap). Feeding
-- at the Food Machine spends FeedBerries berries (no Cash). Station prices are the Phase 4 prices x1.25 (House and
-- decor not scaled). FoldLegacy(home, firstTime) turns a Phase 4 home into a Phase 5 one (DataService P5Home step).
--
-- BALANCE: the numbers come from tools/sim_tycoon.py (the home design's sim_p5.py model: 120 Monte Carlo players, 3
-- prestige runs each; `--ring 0.08 --dungeon 0.1` must print ALL TARGETS MET). Change a number here -> change the same
-- number in the constants block of tools/sim_tycoon.py (`--check`); tools/smoke_p4_economy.lua fails while they differ.
--
-- API (the contract):
--   Get(id) -> StationDef | nil (READ-ONLY; "Prestige" = the prestige pseudo-station), PriceFor(id, level), PriceAt(id,
--     level, home) = floor(PriceFor x StarPriceMultiplier), StarPriceMultiplier(home) = 1.5 ^ stars (1 with
--     LegacyPrices), AvailablePads(home) -> { pad... } (pad = { StationId, NextLevel, Price, BasePrice, Locked, Level,
--     MaxLevel, Name, Title, Kind, Icon, LevelText, Prestige }; a fresh home shows ONE pad, the free Pet Garden; the
--     Prestige pad once the Sky Castle is built), CheckPurchase(home, id) -> ok, price, reason,
--     StationsAfterPrestige(stations) (decor kept, the Garden at ResetLevel 1)
--   HomeLevelOf(home) = sum of station levels + (home.DecorCredit or 0) + LegacyMagnetLevel(home)
--   LegacyMagnetLevel(home) -> home.LegacyMagnet (1..5) while home.LegacyMagnetStar == home.Prestige, else 0
--   SignedPads(pads, cash, maxSigns) -> { [stationId] = true }   the pads that show a sign (3.3): the Prestige pad when
--     not Locked; then the maxSigns (SignRules.MaxSigns 3) cheapest not-Locked pads with Price <= cash; none affordable
--     -> the single cheapest not-Locked pad. Locked pads never get a sign.
--   FoldLegacy(home, firstTime) -> changed   (9.2 step 3; pure, mutates `home`): Press1-4 -> one Berry Farm (the food
--     floor on firstTime), Collector -> LegacyMagnet / LegacyMagnetStar, old decor -> Fence / Fountain + DecorCredit
--   Cloud Cash: FoodOf(home) (0 without a Garden, else Coins.GrassFood + the Farm's Food), PetPower(entry, level, tier,
--     stage) = RarityScale x PetCatalog.LevelFactor(level, stage) x TierMultiplier x RoleMult (stage = the STORED stage
--     cleaned by PetCatalog.EvolutionStage), GardenSlots(home), IncomePerSecond(home, entries, prestige) -> cash/s,
--     parts, LuckyChance, LuckyEV, CoinValue(home, power, prestige), ScoopRadius(home) = max(Garden Radius,
--     LegacyMagnet radius) (Coins.BaseRadius without a Garden), PileSeconds(home) = max(Garden PileSeconds, LegacyMagnet
--     pile) + Vault, OfflineEarnings(home, seconds, incomePerSecond)
--   Berries: BasketCap(home, incomePerSecond) = max(BasketMin, floor(ips x Share x 60 x BasketMinutes)),
--     FeedBerries(def, level) = round(XpToNext(level) x RarityScale x FeedBase) (= FeedPrice: 1 berry = the old $1)
--   Food Machine / training / XP: FeedXp(level, machineLevel), FeedPrice(def, level), TrainCost(def, rank),
--     TrainSeconds(rank), TrainingSlots(home), XpToNext(level), XpForLevel(level)
--   RoamLayout() -> { Half, Cell, Blocked = { {x0, z0, x1, z1, pad = n}... }, Beds = { {x, z}... }, Bowl = { X, Z, R },
--     EatRing, Welcome = {x, z}, Entrance = { X, Z, Width } }   plot-local; EVERY station footprint (built or not) +1,
--     every pad +0.5, the garden fence ring (entrance open), the bowl, the 12 beds: HomeRoam.Build() reads it
--   Validate() -> ok, { problem... }
-- Data: Stations (array in display order, also Stations.Press1) / ById / Order, Kinds, HouseTiers, Prestige, Coins,
--   Berries, SignRules, LegacyMagnet, LegacyPlants, FeedShare, FeedBase, Training, Fusion, PetXp, Layout.
--   Coins = { MealSeconds 8 (the income unit), GrassFood 12, LuckyMult 5, BaseRadius 6, BasePileSeconds 240,
--             PoopMeals 3 (one poop = 3 meals), DropsPerPet 3, DropStages {1, 2, 4, 8} (a drop's stage by poops) }
--   Berries = { Share 0.25, BasketMinutes 30, BasketMin 500, LegacyFood = { Snack 200, Meal 1200, Feast 6400 } }
--   StationDef = { Id, Name, Kind, Icon, Blurb, MaxLevel, Requires = { <stationId> = level, HomeLevel, House, Prestige },
--     LevelRequires = { [level] = { HomeLevel } }, TierCaps = { Cottage, Villa, Manor, SkyCastle }, Price, Effects,
--     Slot = { CFrame, Footprint, Pad, Walkable?, Perimeter?, Spots? (Training), Bowl / Beds / Fence / Entrance /
--     WelcomePile (Garden) }, KeepOnPrestige, ResetLevel, ComingSoon }
--   Effects by Kind: Farm { Food }, Garden { Lucky, Radius, PileSeconds }, FoodMachine { FeedShare }, Training
--     { Slots }, Vault { PileSeconds, OfflinePercent, OfflineHours }, House { Tier, TierIndex, Name }, Fusion
--     { TokenDiscount }, Arena { Battles }, Decor { Pieces, Style, ... build hints for HomeBuilder }
-- Slots (plot-local studs): origin = the yard centre on the ground (SpotInfo.PlotCFrame), -Z = the gate / street side,
--   +Z = the back fence. A station model goes at PlotCFrame * Slot.CFrame; its LookVector is its FRONT (pad side);
--   Footprint = (width along the front, height, depth). The Garden (station frame, -Z = its entrance / pad side):
--   Bowl = { Center (0, 0, 0), Radius 2.5 } (the Food Bowl), Beds = 12 bed centres (slot order, nearest the entrance
--   first), Fence = 0.6-stud ring on the footprint edge, Entrance = { Center (0, 0, -10), Width 4 }; WelcomePile =
--   PLOT-local (13.5, 0, 2.5), outside the fence beside the entrance.
-- Extras: HouseTierOf, HouseTier, MaxLevelAt, StationLevel, PrestigeMultiplier, PrestigeGems, CanPrestige, EffectsOf,
--   PadLevelText, FormatCash, ReachablePads, FootprintRect, PadRect, LocalRect, TierMultiplier, Icons, PrestigePad,
--   MaxPetLevel, StartCash, OfflineMinSeconds, PlotSize, Version (5).
--
-- Notes for the services: a Price of 0 is FREE (the Pet Garden). Prestige keeps the decor (KeepOnPrestige) and the
-- Garden at its ResetLevel, resets the rest (StationsAfterPrestige). Berries, training and roulettes never scale with
-- stars; station prices do (PriceAt).

local Shared = script.Parent
local Config = require(Shared.Config)

local TycoonCatalog = {}

local floor, max, min, huge = math.floor, math.max, math.min, math.huge

local PLOT = (type(Config.Lobby) == "table" and tonumber(Config.Lobby.PlotSize)) or 72
local HALF = PLOT / 2

TycoonCatalog.Version = 5 -- Phase 5: one Berry Farm, roaming pets, berries
TycoonCatalog.PlotSize = PLOT
TycoonCatalog.StartCash = 0 -- Cash of a brand-new profile; the Pet Garden is free
TycoonCatalog.OfflineMinSeconds = 120 -- shorter absences pay nothing (no rejoin farming)
TycoonCatalog.Kinds = { "Farm", "Garden", "FoodMachine", "Training", "Vault", "House", "Fusion", "Arena", "Decor" }
TycoonCatalog.TierMultiplier = { Normal = 1, Golden = 1.5, Rainbow = 2.5 } -- PetKeys.StatMultiplier

-- Icons (UTF-8 emoji, drawn as text on pad signs and in the Home window).
local ICON = {
	Cloud = "\226\152\129",
	Money = "\240\159\146\176",
	Seedling = "\240\159\140\177",
	Cook = "\240\159\141\179",
	Stew = "\240\159\141\178",
	Muscle = "\240\159\146\170",
	Bank = "\240\159\143\166",
	House = "\240\159\143\160",
	Castle = "\240\159\143\176",
	Crystal = "\240\159\148\174",
	Swords = "\226\154\148",
	Lantern = "\240\159\143\174",
	Garden = "\240\159\143\161",
	Tulip = "\240\159\140\183",
	Fountain = "\226\155\178",
	Flag = "\240\159\154\169",
	Trophy = "\240\159\143\134",
	Star = "\226\173\144",
	Berry = "\240\159\141\147",
	Carrot = "\240\159\165\149",
	Melon = "\240\159\141\136",
	Tree = "\240\159\140\179",
	Magnet = "\240\159\167\178",
}
TycoonCatalog.Icons = ICON

----------------------------------------------------------------------
-- House tiers (the House station's level IS the tier index; a home without a House counts as the Cottage tier)
----------------------------------------------------------------------
TycoonCatalog.HouseTiers = {
	{ Id = "Cottage", Name = "Cottage", Index = 1, HomeLevel = 0, Icon = ICON.House },
	{ Id = "Villa", Name = "Villa", Index = 2, HomeLevel = 10, Icon = ICON.House },
	{ Id = "Manor", Name = "Manor", Index = 3, HomeLevel = 20, Icon = ICON.House },
	{ Id = "SkyCastle", Name = "Sky Castle", Index = 4, HomeLevel = 30, Icon = ICON.Castle },
}
local TIERS = TycoonCatalog.HouseTiers
local TIER_INDEX = {}
local TIER_BY_ID = {}
for i, t in ipairs(TIERS) do
	TIER_INDEX[t.Id] = i
	TIER_BY_ID[t.Id] = t
end
setmetatable(TIERS, { __index = TIER_BY_ID }) -- HouseTiers.Villa works too

----------------------------------------------------------------------
-- Prestige: at Home Level 40 with the Sky Castle. Resets Cash, the coins on the lawn and every station that is not
-- KeepOnPrestige (the Garden stays at its ResetLevel 1). Gains +1 star: coins x1.25 per star (compounding), +1 garden
-- place (3 + stars, at most 12), a Gems reward and the Fusion Machine at 1 star. After every
-- Prestige station prices go up by half again: x(1 + PriceStep) ^ stars (LegacyPrices homes exempt for one run).
----------------------------------------------------------------------
TycoonCatalog.Prestige = {
	Id = "Prestige",
	HomeLevel = 40,
	House = "SkyCastle",
	IncomeMultiplier = 1.25, -- per star: PrestigeMultiplier(stars) = 1.25 ^ stars (coins)
	GemReward = 100, -- the first prestige; PrestigeGems(stars) lowers it by GemRewardStep per later star
	GemRewardStep = 10,
	GemRewardMin = 25,
	FusionUnlock = 1, -- the Fusion Machine pad unlocks at this many stars
	GardenSlotsBase = 3, -- garden places without a star ("at the start you can put up to 3 pets")
	GardenSlotsPerStar = 1, -- +1 place per star ("prestige 1 can put 4 and so on")
	GardenSlotsMax = 12, -- the places drawn in the garden (Garden.Slot.Spots)
	PriceStep = 0.5, -- station prices x(1 + PriceStep) ^ stars: x1.5, x2.25, x3.38 ...
	Icon = ICON.Star,
}

----------------------------------------------------------------------
-- Cloud Cash (Phase 4 3.2, Phase 5 3.5). Every open garden place with a pet eats one meal every MealSeconds (the income
-- unit: IncomePerSecond = Food / MealSeconds x Pets x LuckyEV x 1.25 ^ stars). A roaming pet poops one drop per
-- HomeRoam cycle worth CoinValue x PoopMeals (a Lucky drop x LuckyMult); a slot keeps at most DropsPerPet drops on the
-- lawn (more merge into the nearest); a drop's stage (CoinDrops attribute, HomeFx coin size) by its value in poops:
-- 1 (1), 2 (2-3), 3 (4-7), 4 (8+). The lawn of a slot holds PileSeconds(home) of its coins; the owner scoops drops
-- within ScoopRadius(home).
----------------------------------------------------------------------
TycoonCatalog.Coins = {
	MealSeconds = 8, -- the income unit: one meal per open place every 8 s
	GrassFood = 12, -- the Food of a built Garden before the Berry Farm
	LuckyMult = 5, -- a Lucky drop is worth 5 drops
	BaseRadius = 6, -- scoop radius (studs) without a Garden
	BasePileSeconds = 240, -- a slot's lawn holds 4 minutes of coins without a Garden
	PoopMeals = 3, -- one poop = 3 meals (HomeRoam.Cycle 24 s = 3 x MealSeconds)
	DropsPerPet = 3, -- drops of one slot on the lawn; a 4th poop merges into the nearest drop
	DropStages = { 1, 2, 4, 8 }, -- drop stage 1..4 from that many poops of value
}

----------------------------------------------------------------------
-- Berries (Phase 5 3.4): ONE food. Every Cloud Cash poop of value V adds V x Share berries to Profile.Berries (the
-- server ledger keeps the fraction), clamped so the poop never lifts the berries above BasketCap (30 minutes of
-- berries, at least BasketMin). A feed at the Food Machine costs FeedBerries(def, level) berries (= the Phase 4
-- FeedPrice in Cash: 1 berry = $1 of food). LegacyFood: the berries one leftover Phase 2-4 food is worth (the
-- DataService P5Home step converts Profile.Food once).
----------------------------------------------------------------------
TycoonCatalog.Berries = {
	Share = 0.25,
	BasketMinutes = 30,
	BasketMin = 500,
	LegacyFood = { Snack = 200, Meal = 1200, Feast = 6400 },
}

-- Pad signs (3.3): only the next affordable pads get a sign (SignedPads)
TycoonCatalog.SignRules = { MaxSigns = 3 }

----------------------------------------------------------------------
-- Pet XP curve: XpToNext(level) = round(Base * level ^ Exponent / Round) * Round, up to MaxLevel.
-- Pet stats grow +10% per level (PetCatalog.GetStats), so a level-50 pet earns 5.9x its level-1 coins and a level-100
-- pet 10.9x. Phase 4: every pet levels up to 100 (the player's rule); the evolutions stay at 20 and 50; each level
-- takes more XP than the one before (20 XP for L1 -> 2, 10,125 for L49 -> 50, 31,190 for L99 -> 100).
----------------------------------------------------------------------
TycoonCatalog.PetXp = { MaxLevel = 100, Base = 20, Exponent = 1.6, Round = 5 }
TycoonCatalog.MaxPetLevel = TycoonCatalog.PetXp.MaxLevel -- DataService.AddPetXp caps levels here

----------------------------------------------------------------------
-- The Food Machine (Phase 4 3.4, Phase 5 3.4): one feed fills FeedShare[machine level] of the pet's current XP bar (the
-- Kitchen's Effects.FeedShare, copied into TycoonCatalog.FeedShare below) and costs XpToNext(level) x RarityScale x
-- FeedBase BERRIES (FeedBerries), the same at every machine level (the upgrade gives more XP for the same berries).
----------------------------------------------------------------------
TycoonCatalog.FeedBase = 2.0

----------------------------------------------------------------------
-- The Training Place (section 3.7): rank r of a skill costs CostBase x r ^ 2 x RarityScale Cash and takes
-- r x MinutesPerRank minutes; ranks 1..MaxRank. Prices never scale with stars. (The skill effects live in
-- BattleCatalog.Training.)
----------------------------------------------------------------------
TycoonCatalog.Training = { MaxRank = 10, CostBase = 300, MinutesPerRank = 1 }

----------------------------------------------------------------------
-- Fusion Machine costs (section 11), by rarity (a Mix pays for the HIGHER rarity of its two inputs).
--   Upgrade[rarity].Golden  = 3 Normal copies -> 1 Golden;  Upgrade[rarity].Rainbow = 3 Golden -> 1 Rainbow
--   Mix[rarity]             = two different pets -> a hybrid; Mythic / Secret inputs cost Gems
----------------------------------------------------------------------
TycoonCatalog.Fusion = {
	Copies = 3,
	Upgrade = {
		Common = { Golden = { Tokens = 150 }, Rainbow = { Tokens = 450 } },
		Uncommon = { Golden = { Tokens = 300 }, Rainbow = { Tokens = 900 } },
		Rare = { Golden = { Tokens = 750 }, Rainbow = { Tokens = 2250 } },
		Epic = { Golden = { Tokens = 1800 }, Rainbow = { Tokens = 5400 } },
		Legendary = { Golden = { Tokens = 4500 }, Rainbow = { Tokens = 13500 } },
		Mythic = { Golden = { Tokens = 10000 }, Rainbow = { Tokens = 30000 } },
		Secret = { Golden = { Tokens = 25000 }, Rainbow = { Tokens = 75000 } },
	},
	Mix = {
		Common = { Tokens = 200 },
		Uncommon = { Tokens = 400 },
		Rare = { Tokens = 1000 },
		Epic = { Tokens = 2500 },
		Legendary = { Tokens = 6000 },
		Mythic = { Gems = 60 },
		Secret = { Gems = 150 },
	},
}
-- Fusion.ByRarity[rarity] = { Golden = cost, Rainbow = cost, Mix = cost } (also reachable as Fusion[rarity])
do
	local byRarity = {}
	for rarity, row in pairs(TycoonCatalog.Fusion.Upgrade) do
		byRarity[rarity] = { Golden = row.Golden, Rainbow = row.Rainbow, Mix = TycoonCatalog.Fusion.Mix[rarity] }
	end
	TycoonCatalog.Fusion.ByRarity = byRarity
	setmetatable(TycoonCatalog.Fusion, { __index = byRarity })
end

----------------------------------------------------------------------
-- Layout of the yard (plot-local studs, see the header). The yard is PlotSize x PlotSize inside the lobby fence;
-- nothing is placed outside |x|, |z| <= HALF - 1.5 except along-the-fence decor. (Phase 5: the Berry Farm fills the
-- four old press slots beside the PressLane path; the Coin Magnet corner and the old decor strips are lawn.)
----------------------------------------------------------------------
local function V3(x, y, z)
	return Vector3.new(x, y, z)
end

-- yaw: 0 = the front faces the gate (-Z), 180 = faces the back fence, 90 = faces -X, -90 = faces +X
local function at(x, z, yaw)
	return CFrame.new(x, 0, z) * CFrame.Angles(0, math.rad(yaw or 0), 0)
end

-- a pad on the ground at (x, z) looking toward (tx, tz) (the station it buys)
local function padAt(x, z, tx, tz)
	local from = V3(x, 0, z)
	local to = V3(tx, 0, tz)
	if (to - from).Magnitude < 1e-3 then
		return CFrame.new(from)
	end
	return CFrame.lookAt(from, to)
end

TycoonCatalog.Layout = {
	PlotSize = PLOT,
	Half = HALF,
	Margin = 1.5, -- stations keep this far from the fence line
	PadSize = V3(4, 0.6, 4), -- buy pads (flat, walkable)
	Gate = V3(0, 0, -HALF), -- centre of the gate opening (the lobby builds the gate; its pillars stand at x = +-7.2)
	GateWidth = 12, -- clear opening between the pillars
	Spawn = V3(0, 0, -12), -- the lobby's home spawn point (kept clear)
	-- stone paths (centre line + width); every pad touches one
	Paths = {
		{ Name = "Main", Start = V3(0, 0, -HALF), Finish = V3(0, 0, -7), Width = 6 },
		{ Name = "FountainWest", Start = V3(-7, 0, -7), Finish = V3(-7, 0, 5), Width = 4 },
		{ Name = "FountainEast", Start = V3(7, 0, -7), Finish = V3(7, 0, 5), Width = 4 },
		{ Name = "FountainSouth", Start = V3(-7, 0, -7), Finish = V3(7, 0, -7), Width = 4 },
		{ Name = "FountainNorth", Start = V3(-7, 0, 5), Finish = V3(7, 0, 5), Width = 4 },
		{ Name = "HouseWalk", Start = V3(0, 0, 5), Finish = V3(0, 0, 15), Width = 6 },
		{ Name = "FrontCross", Start = V3(-15, 0, -19), Finish = V3(26, 0, -19), Width = 4 },
		{ Name = "GateWalk", Start = V3(-14, 0, -32.5), Finish = V3(14, 0, -32.5), Width = 3 },
		{ Name = "PressLane", Start = V3(-15, 0, -24), Finish = V3(-15, 0, 23), Width = 4 },
		{ Name = "BackCross", Start = V3(-15, 0, 12), Finish = V3(29, 0, 12), Width = 4 },
		{ Name = "GardenWalk", Start = V3(7, 0, -1), Finish = V3(12, 0, -1), Width = 4 },
	},
	-- the strip in front of the Garden (toward its pad) where the Welcome-back pile may lie (Validate)
	GardenEntranceDepth = 6,
}

-- The Pet Garden interior (Phase 5 3.3), in its station frame: X along the front, -Z = the entrance / pad side. The
-- Food Bowl in the middle, 12 beds (slot order = nearest the entrance first) along the sides and the back, a 0.6-stud
-- fence on the footprint edge with a 4-stud entrance at the front.
local GARDEN_BOWL = { Center = V3(0, 0, 0), Radius = 2.5 }
local GARDEN_BEDS = {
	V3(-9, 0, -6.5), V3(9, 0, -6.5), V3(-9, 0, -2.5), V3(9, 0, -2.5), V3(-9, 0, 1.5), V3(9, 0, 1.5),
	V3(-9, 0, 5.5), V3(9, 0, 5.5), V3(-6, 0, 7.8), V3(6, 0, 7.8), V3(-2, 0, 7.8), V3(2, 0, 7.8),
}
local GARDEN_BED_SIZE = 2.5 -- beds are 2.5 x 2.5 studs
local GARDEN_FENCE = 0.6 -- fence thickness on the footprint edge
local GARDEN_ENTRANCE = { Center = V3(0, 0, -10), Width = 4 }

-- The Berry Farm (Phase 5 3.3, home design 2.1): price TO level 1..40 and the Food of every level (piecewise geometric
-- through the old cumulative plant food at the tier-cap boundaries 10 / 22 / 37 / 40)
local FARM_PRICE = {
	15, 70, 160, 450, 520, 1400, 1500, 3100, 4400, 7500, 11000, 19000, 22000, 25000, 28000, 31000, 45000, 48000, 110000,
	120000, 150000, 160000, 200000, 220000, 320000, 340000, 360000, 380000, 460000, 510000, 610000, 790000, 850000,
	1000000, 1400000, 1500000, 1800000, 2200000, 2800000, 4000000,
}
