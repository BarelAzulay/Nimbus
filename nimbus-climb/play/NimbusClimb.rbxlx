		local tierRoom = (raidTier ~= "" and leftEnd - lx - 4 >= nameNeed + tierNeed) and tierNeed or 0
		local nameW = Hud.FitLine(Hud.bossName, tostring(bossUnit.name or "?"), px(compact and 22 or 24), px(18), leftEnd - lx - 4 - tierRoom)
