	dragon_seg_25f = 91570140584397,
	dragon_seg_30 = 136574496982178,
	dragon_seg_30f = 76029558384894,
	dragon_seg_35 = 132119427845577,
	dragon_seg_35f = 124430180142125,
	dragon_seg_40f = 111177310781612,
	dragon_seg_45f = 110995233527062,
	dragon_tail = 131198018369800,
	dungeon_a_arch_10 = 84924744967990,
	dungeon_a_arch_6 = 81008886538768,
	dungeon_a_banner = 120643053814234,
	dungeon_a_brazier = 70417658462965,
	dungeon_a_carpet = 73039439838519,
	dungeon_a_curio = 85104788606765,
	dungeon_a_dais = 104720299839460,
	dungeon_a_door_8 = 131047832190500,
	dungeon_a_floor_28x22 = 111585228874393,
	dungeon_a_floor_28x24 = 128714027202957,
	dungeon_a_floor_44x48 = 103768313260485,
	dungeon_a_floor_48x48 = 103962576324641,
	dungeon_a_floor_60x72 = 123668766038801,
