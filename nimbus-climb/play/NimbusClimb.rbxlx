local floor, max, min, abs, sin, pi = math.floor, math.max, math.min, math.abs, math.sin, math.pi

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function serverNow()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

local function commas(n)
	if Util and type(Util.Commas) == "function" then
		local ok, s = pcall(Util.Commas, n)
		if ok and type(s) == "string" then
			return s
		end
	end
	local s = tostring(floor(n))
	local out = s
	while true do
		local k
		out, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return out
end

local function formatCash(n)
	n = tonumber(n) or 0
	if n ~= n then
		n = 0
	end
	if TycoonCatalog and type(TycoonCatalog.FormatCash) == "function" then
		local ok, s = pcall(TycoonCatalog.FormatCash, n)
		if ok and type(s) == "string" then
			return s
		end
	end
	return "$" .. commas(max(0, floor(n)))
end

local function vecAttr(inst, name)
	local v = inst and inst:GetAttribute(name)
	if typeof(v) == "Vector3" then
		return v
	end
	return nil
end

local function numAttr(inst, name, default)
	local v = inst and tonumber(inst:GetAttribute(name))
	if v == nil or v ~= v then
		return default
	end
	return v
end

local function ensureFolder()
	if fxFolder and fxFolder.Parent then
		return fxFolder
	end
	local root = Workspace:FindFirstChild("ClientFx")
	if not root then
		root = Instance.new("Folder")
		root.Name = "ClientFx"
		root.Parent = Workspace
	end
	local f = root:FindFirstChild("HomeFx")
	if not f then
		f = Instance.new("Folder")
		f.Name = "HomeFx"
		f.Parent = root
	end
	fxFolder = f
	return f
end

local function ensurePetFolder()
	if petFolder and petFolder.Parent then
		return petFolder
	end
	local root = ensureFolder().Parent
	local f = root:FindFirstChild("HomePets")
	if not f then
		f = Instance.new("Folder")
		f.Name = "HomePets"
		f.Parent = root
	end
	petFolder = f
	return f
end

local function collectParts(model, out)
	out = out or {}
	if model:IsA("BasePart") then
		out[#out + 1] = model
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			out[#out + 1] = d
		end
	end
	return out
end

-- the nearest ancestor (or self) that carries `attr`
local function ancestorWith(inst, attr, stop)
	local node = inst
	for _ = 1, 8 do
		if not node or node == stop then
			return nil
		end
		if node:GetAttribute(attr) ~= nil then
			return node
		end
		node = node.Parent
	end
	return nil
end

----------------------------------------------------------------------
-- Owner-only prompts and signs
----------------------------------------------------------------------
local function homeOwner(rec)
	return rec and tonumber(rec.Folder:GetAttribute("OwnerUserId")) or 0
end

local function promptOwner(prompt, rec)
	local uid = tonumber(prompt:GetAttribute("OwnerUserId"))
	if uid == nil then
		local holder = ancestorWith(prompt.Parent, "OwnerUserId", rec and rec.Folder.Parent)
		uid = holder and tonumber(holder:GetAttribute("OwnerUserId")) or nil
	end
	if uid == nil then
		uid = homeOwner(rec)
	end
	return uid or 0
end

-- what the server would have this prompt show (HomeBuilder's rules), used when HomeFx stops hiding it
local function serverEnabled(prompt, state)
	if prompt.Name == "ClaimPrompt" then
		return state.Home ~= nil and homeOwner(state.Home) == 0
	end
	if prompt.Name == "BuyPrompt" then
		local pad = ancestorWith(prompt.Parent, "Locked", state.Home and state.Home.Folder)
		local locked = pad and pad:GetAttribute("Locked")
		return (locked == nil or locked == "") and promptOwner(prompt, state.Home) ~= 0
	end
	return state.Server
end

local function shouldHide(prompt, state)
	if prompt.Name == "ClaimPrompt" then
		-- one home per player: the other plots' claim prompts go away while the local player owns one
		return ownsHome and homeOwner(state.Home) ~= localUid
	end
	return promptOwner(prompt, state.Home) ~= localUid
end

local function applyPrompt(prompt)
	local state = overrides[prompt]
	if not state or not prompt.Parent then
		return
	end
	local hide = shouldHide(prompt, state)
	if hide then
		state.Hidden = true
		if prompt.Enabled then
			state.Wrote = false
			prompt.Enabled = false
		end
	elseif state.Hidden then
		state.Hidden = false
		local want = serverEnabled(prompt, state) and true or false
		if prompt.Enabled ~= want then
			state.Wrote = want
			prompt.Enabled = want
		end
	end
end

local function trackPrompt(prompt, rec)
	if overrides[prompt] then
		overrides[prompt].Home = rec
		applyPrompt(prompt)
		return
	end
	local state = { Home = rec, Server = prompt.Enabled, Hidden = false, Wrote = nil }
	overrides[prompt] = state
	prompt:GetPropertyChangedSignal("Enabled"):Connect(function()
		local v = prompt.Enabled
		if state.Wrote ~= nil and v == state.Wrote then
			state.Wrote = nil -- the echo of our own write (signals may be deferred)
			return
		end
		state.Server = v
		if state.Hidden and v then
			applyPrompt(prompt)
		end
	end)
	prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		applyPrompt(prompt)
	end)
	applyPrompt(prompt)
end

-- true when a sign belongs to a locked pad and the local player is not close to it (hysteresis NEAR / FAR)
local function lockedAndFar(gui, rec)
	local pad = ancestorWith(gui.Parent, "Locked", rec.Folder)
	local locked = pad and pad:GetAttribute("Locked")
	if locked == nil or locked == "" or not signFocus then
		signNear[gui] = nil
		return false
	end
	local anchor = gui.Adornee or gui.Parent
	if not anchor or not anchor:IsA("BasePart") then
		return false
	end
	local d = (anchor.Position - signFocus).Magnitude
	local near = d <= (signNear[gui] and K.LOCKED_SIGN_FAR or K.LOCKED_SIGN_NEAR)
	signNear[gui] = near or nil
	return not near
end

-- the StationId of the pad a sign belongs to (its attribute, else the pad model's name "Pad_<Id>": a new pad model
-- gets its attributes only after its sign is built)
local function signKey(gui, rec)
	local key = signKeys[gui]
	if key then
		return key
	end
	local node = gui.Parent
	for _ = 1, 8 do
		if not node or node == rec.Folder then
			break
		end
		local id = node:GetAttribute("StationId")
		if (id == nil or id == "") and node:IsA("Model") and string.sub(node.Name, 1, 4) == "Pad_" then
			id = string.sub(node.Name, 5)
		end
		if id ~= nil and id ~= "" then
			key = tostring(id)
			break
		end
		node = node.Parent
	end
	signKeys[gui] = key
	return key
end

-- why a sign may not show at all: "Other" (not one of the local player's pads), "Locked" (one of their locked pads,
-- far away) or nil (it may show: the on-screen layout decides)
local function signBlock(gui, rec)
	local holder = ancestorWith(gui.Parent, "OwnerUserId", rec.Folder)
	local uid = holder and tonumber(holder:GetAttribute("OwnerUserId")) or homeOwner(rec)
	if uid ~= localUid or uid == 0 then
		return "Other"
	end
	if lockedAndFar(gui, rec) then
		return "Locked"
	end
	return nil
end

local function setSign(gui, show)
	if gui.Enabled ~= show then
		gui.Enabled = show
	end
end

-- a sign that changed (new, rebuilt, its pad locked / unlocked, its home changed hands) between two layout passes
local function applySign(gui)
	local rec = signs[gui]
	if not rec or not gui.Parent then
		return
	end
	local block = signBlock(gui, rec)
	if block then
		signLayout[gui] = nil
		signState[gui] = block
		setSign(gui, false)
		return
	end
	local answer = signLayout[gui]
	if answer == nil then
		-- not laid out yet: HomeBuilder rebuilds a pad's sign on every change, so a rebuilt sign takes its pad's
		-- last answer (no flicker); a new one waits for the layout, which runs on the next frame
		local key = signKey(gui, rec)
		answer = key and rec.SignMemo[key] or nil
		signLayout[gui] = answer
		nextSignCheck = min(nextSignCheck, clock)
	end
	signState[gui] = answer or "Pending"
	setSign(gui, answer == "Shown")
end

local function utf8len(text)
	local _, n = string.gsub(tostring(text or ""), "[^\128-\191]", "")
	return n
end

-- the plate's size when the layout engine has not measured it (yet): its rows of text
local function estimatePlate(plate)
	local w, h = 150, 70
	if not plate then
		return w, h
	end
	local widest, total, rows = 0, 0, 0
	for _, row in ipairs(plate:GetChildren()) do
		if row:IsA("GuiObject") then
			local rw, rh, n = 0, 0, 0
			for _, label in ipairs(row:GetChildren()) do
				if label:IsA("TextLabel") then
					local size = tonumber(label.TextSize) or 20
					local tw = label.TextBounds.X
					if not (tw > 0) then
						tw = utf8len(label.Text) * size * 0.56
					end
					rw = rw + tw + ((n > 0) and 8 or 0)
					rh = max(rh, size + 4)
					n = n + 1
				end
			end
			if n > 0 then
				widest = max(widest, rw)
				total = total + rh + ((rows > 0) and 3 or 0)
				rows = rows + 1
			end
		end
	end
	if rows > 0 then
		w, h = max(150, widest + 28), total + 14
	end
	return w, h
end

-- the sign's plate in pixels (it keeps that size on screen at any distance)
local function plateSize(gui)
	local plate = gui:FindFirstChild("Plate")
	if plate and plate:IsA("GuiObject") then
		local s = plate.AbsoluteSize
		if s.X >= 40 and s.Y >= 20 then
			plateSizes[gui] = s
			return s.X, s.Y
		end
	end
	local known = plateSizes[gui]
	if known then
		return known.X, known.Y
	end
	return estimatePlate(plate)
end

-- the world point the billboard hangs from: its adornee plus the studs offsets
local function signPoint(gui, cam)
	local anchor = gui.Adornee or gui.Parent
	local base = nil
	if anchor then
		if anchor:IsA("BasePart") then
			base = anchor.Position
		elseif anchor:IsA("Attachment") then
			base = anchor.WorldPosition
		elseif anchor:IsA("Model") then
			local ok, cf = pcall(anchor.GetPivot, anchor)
			base = ok and cf and cf.Position or nil
		end
	end
	if not base then
		return nil
	end
	local p = base + gui.StudsOffsetWorldSpace
	local so = gui.StudsOffset
	if so.X ~= 0 or so.Y ~= 0 or so.Z ~= 0 then
		p = p + cam.CFrame:VectorToWorldSpace(so)
	end
	return p
end

-- The HUD over the signs: every ScreenGui is drawn on top of every billboard, so a sign laid out where the HUD is
-- would be cut. measureHud returns where this game's own HUD covers the screen as rectangles in viewport px (the
-- space of Camera:WorldToViewportPoint), each grown by K.SIGN_HUD_GAP:
--   * NimbusMenu: the menu column (MenuColumn, left edge)
--   * NimbusHud: every shown panel of its corner holders (the currency pills, the vitals card, the match / party
--     panels, the title card) and the corner blocks HudController publishes on the gui (TopLeftRight x
--     TopLeftBottom; TopRightLeft .. the right edge x TopRightBottom: the currency stack on short screens)
--   * NimbusHotbar: the hotbar; MobileControls: the touch RUN / DASH buttons
--   * NimbusTutorial: the tutorial card, or only its portrait bubble (+ "!" badge, "Tap me!" tag) while it is folded
-- A ScreenGui with IgnoreGuiInset = false is laid out below Roblox's top bar: its AbsolutePosition is shifted by the
-- GUI inset (GuiService:GetGuiInset()) to reach viewport px; an IgnoreGuiInset = true gui (MobileControls) covers
-- the whole screen from its own AbsolutePosition. Every source is optional: a missing, disabled or hidden one covers
-- nothing.
local function guiInset()
	local inset = nil
	pcall(function()
		inset = GuiService:GetGuiInset()
	end)
	if typeof(inset) == "Vector2" then
		return inset.X, inset.Y
	end
	return 0, 0
end

-- true when `inst` is inside `root` and nothing between them is hidden
local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return node ~= nil
end

-- inst's box in viewport px grown by the gap (nil when it is not a shown GuiObject of `root` with a size)
local function hudBox(inst, root, dx, dy)
	if not (inst and inst:IsA("GuiObject") and shownIn(inst, root)) then
		return nil
	end
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	if not (s.X >= 1 and s.Y >= 1) then
		return nil
	end
	local g = K.SIGN_HUD_GAP
	return { X0 = p.X + dx - g, Y0 = p.Y + dy - g, X1 = p.X + s.X + dx + g, Y1 = p.Y + s.Y + dy + g, Hud = true }
end

local function measureHud(vp)
	local list = {}
	local pg = localPlayer and localPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return list
	end
	local insetX, insetY = guiInset()
	local function add(r)
		if r then
			list[#list + 1] = r
		end
		return r
	end
	-- a ScreenGui that is drawn now, and the offset from its descendants' AbsolutePosition to viewport px (one that
	-- covers the whole screen starts at its own AbsolutePosition: right whether Roblox counts that from the top of
	-- the screen, as this project's measurements assume, or from below the top bar)
	local function gui(name)
		local g = pg:FindFirstChild(name)
		if not (g and g:IsA("ScreenGui") and g.Enabled) then
			return nil, 0, 0
		end
		if g.IgnoreGuiInset then
			local origin = g.AbsolutePosition
			return g, -origin.X, -origin.Y
		end
		return g, insetX, insetY
	end
	local menu, mx, my = gui("NimbusMenu")
	if menu then
		add(hudBox(menu:FindFirstChild("MenuColumn"), menu, mx, my))
	end
	local hud, hx, hy = gui("NimbusHud")
	if hud then
		for _, holder in ipairs(hud:GetChildren()) do
			if holder:IsA("GuiObject") and holder.Visible then
				for _, panel in ipairs(holder:GetChildren()) do
					add(hudBox(panel, hud, hx, hy))
				end
			end
		end
		local function attr(name)
			local v = tonumber(hud:GetAttribute(name))
			if v == nil or v ~= v then
				return 0
			end
			return v
		end
		local g = K.SIGN_HUD_GAP
		local right, bottom = attr("TopLeftRight"), attr("TopLeftBottom")
		if right > 0 and bottom > 0 then
			add({ X0 = hx - g, Y0 = hy - g, X1 = hx + right + g, Y1 = hy + bottom + g, Hud = true })
		end
		local left = attr("TopRightLeft")
		bottom = attr("TopRightBottom")
		if left > 0 and bottom > 0 then
			add({ X0 = hx + left - g, Y0 = hy - g, X1 = vp.X + g, Y1 = hy + bottom + g, Hud = true })
		end
	end
	local hotbar, bx, by = gui("NimbusHotbar")
	if hotbar then
		add(hudBox(hotbar:FindFirstChild("Hotbar"), hotbar, bx, by))
	end
	local mobile, tx, ty = gui("MobileControls")
	if mobile then
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("GuiButton") then
				add(hudBox(d, mobile, tx, ty))
			end
		end
	end
	local tutorial, ux, uy = gui("NimbusTutorial")
	local card = tutorial and tutorial:FindFirstChild("TutorialPanel")
	if card then
		local main = card:FindFirstChild("Main", true)
		if main and shownIn(main, tutorial) then
			add(hudBox(card, tutorial, ux, uy))
		else
			local portrait = card:FindFirstChild("Portrait", true)
			local bubble = add(hudBox(portrait, tutorial, ux, uy))
			if bubble then
				for _, c in ipairs(portrait:GetChildren()) do
					local r = hudBox(c, tutorial, ux, uy)
					if r and (r.X0 < bubble.X0 or r.Y0 < bubble.Y0 or r.X1 > bubble.X1 or r.Y1 > bubble.Y1) then
						add(r) -- the badge / tag sticking out of the bubble
					end
				end
			end
		end
	end
	return list
end

-- the HUD rectangles for this layout pass: measured again every K.SIGN_HUD_CHECK seconds, and at once (then once
-- more K.SIGN_HUD_SETTLE later) when the viewport changes size
local function hudObstacles(vp)
	local resized = vp.X ~= hudViewX or vp.Y ~= hudViewY
	if resized or clock >= hudNext then
		hudViewX, hudViewY = vp.X, vp.Y
		hudNext = clock + (resized and K.SIGN_HUD_SETTLE or K.SIGN_HUD_CHECK)
		local ok, result = pcall(measureHud, vp)
		if ok and type(result) == "table" then
			hudRects = result
		else
			hudRects = {}
			if not hudWarned then
				hudWarned = true
				warn("[HomeFx] could not measure the HUD: " .. tostring(result))
			end
		end
	end
	return hudRects
end

-- The on-screen layout (World text rule: a pile of overlapping plates is unreadable). Every sign in `list` may show;
-- each is projected through the camera, the plate (bottom-centred on the billboard's bottom edge, like HomeBuilder's
-- tags) becomes a screen rectangle, and the signs nearest the player go first (a locked pad's sign, unless the player
-- stands right at it, as if K.SIGN_LOCKED_BACK studs farther: what can be bought now first): a sign is "Shown" when
-- its plate leaves the text of every plate shown before it alone (an overlap of at most K.SIGN_INSET_X px side by side
-- or K.SIGN_INSET_Y px above / below only covers padding), else "Crowded". The HUD (hudObstacles) is placed before
-- every sign and no plate may reach into it at all (its rectangles carry their own gap): a sign under the HUD is
-- "Crowded" as well (signUnderHud) and takes no room. A sign behind the camera, past its MaxDistance (Roblox does
-- not draw it) or mostly off the screen (less than K.SIGN_ONSCREEN of its plate inside: cut off, it reads as
-- nothing) is "Away" and takes no room. Hysteresis: a shown sign counts K.SIGN_KEEP studs nearer and is placed
-- before all others in its first K.SIGN_HOLD seconds; a hidden one needs K.SIGN_CLEAR px of extra room (from the
-- HUD: K.SIGN_HUD_CLEAR, scaled with the screen height) and K.SIGN_ONSCREEN_BACK of its plate on the screen, and
-- stays hidden at least K.SIGN_HOLD seconds, keeping the room it would get meanwhile.
local function layoutSigns(list)
	local cam = Workspace.CurrentCamera
	if not cam then
		for _, gui in ipairs(list) do
			signLayout[gui] = "Shown"
			signUnderHud[gui] = nil
		end
		return
	end
	local vp = cam.ViewportSize
	local eye = cam.CFrame.Position
	local focus = signFocus or eye
	local hud = hudObstacles(vp)
	local items = {}
	for _, gui in ipairs(list) do
		local item = nil
		local answer = signLayout[gui]
		local fresh = signSince[gui] ~= nil and clock - signSince[gui] < K.SIGN_HOLD
		local pos = signPoint(gui, cam)
		if pos then
			local maxD = tonumber(gui.MaxDistance) or 0
			if maxD <= 0 or (pos - eye).Magnitude <= maxD + K.SIGN_RANGE_SLACK then
				local ok, p = pcall(cam.WorldToViewportPoint, cam, pos)
				if ok and typeof(p) == "Vector3" and p.Z > 0 then
					local w, h = plateSize(gui)
					local size, off = gui.Size, gui.SizeOffset
					local bw, bh = size.X.Offset, size.Y.Offset
					local cx = p.X + off.X * bw
					local bottom = p.Y - off.Y * bh + bh / 2
					local x0, y0 = cx - w / 2, bottom - h
					local shown = answer == "Shown"
					local inside = max(0, min(vp.X, x0 + w) - max(0, x0)) * max(0, min(vp.Y, y0 + h) - max(0, y0))
					if inside >= w * h * (shown and K.SIGN_ONSCREEN or K.SIGN_ONSCREEN_BACK) then
						local dist = (pos - focus).Magnitude
						local d = dist
						if shown then
							d = d - K.SIGN_KEEP
						end
						local pad = ancestorWith(gui.Parent, "Locked", signs[gui].Folder)
						local locked = pad and pad:GetAttribute("Locked")
						if locked ~= nil and locked ~= "" then
							local near = K.SIGN_LOCKED_CLOSE
							d = d + K.SIGN_LOCKED_BACK * clamp01((dist - near) / near)
						end
						item = {
							Gui = gui,
							D = d,
							Key = signKey(gui, signs[gui]) or "",
							Shown = shown,
							Pinned = fresh and shown, -- shown a moment ago: placed first, it stays
							Held = fresh and not shown and answer ~= nil, -- hidden a moment ago: holds its room, not shown yet
							X0 = x0,
							Y0 = y0,
							X1 = x0 + w,
							Y1 = y0 + h,
						}
					end
				end
			end
		end
		if item then
			items[#items + 1] = item
		else
			signLayout[gui] = "Away"
			signUnderHud[gui] = nil
		end
	end
	table.sort(items, function(a, b)
		if a.Pinned ~= b.Pinned then
			return a.Pinned
		end
		if a.D ~= b.D then
			return a.D < b.D
		end
		return a.Key < b.Key
	end)
	local placed = {}
	for i, r in ipairs(hud) do
		placed[i] = r
	end
	-- the first thing already placed (the HUD first) that the plate of `it` runs into when it is grown by `grow` px
	-- against the other plates and by `hudGrow` px against the HUD; nil when there is room
	local function blocker(it, grow, hudGrow)
		for _, o in ipairs(placed) do
			local g, sx, sy = grow, K.SIGN_INSET_X, K.SIGN_INSET_Y
			if o.Hud then
				g, sx, sy = hudGrow, 0, 0
			end
			if min(it.X1 + g, o.X1) - max(it.X0 - g, o.X0) > sx and min(it.Y1 + g, o.Y1) - max(it.Y0 - g, o.Y0) > sy then
				return o
			end
		end
		return nil
	end
	local hudClear = max(K.SIGN_CLEAR, K.SIGN_HUD_CLEAR * vp.Y / 1080)
	for _, it in ipairs(items) do
		local hit = blocker(it, 0, 0)
		signUnderHud[it.Gui] = (hit ~= nil and hit.Hud == true) or nil
		if hit then
			signLayout[it.Gui] = "Crowded"
		elseif it.Shown or (not it.Held and not blocker(it, K.SIGN_CLEAR, hudClear)) then
			placed[#placed + 1] = it
			signLayout[it.Gui] = "Shown"
		else
			-- it fits but stays hidden for now: its hold keeps the room (no farther sign flashes up there until it
			-- comes back); one only short of K.SIGN_CLEAR keeps none (in a still view it would block for good)
			if it.Held then
				placed[#placed + 1] = it
			end
			signLayout[it.Gui] = "Crowded"
		end
	end
end

-- the local player's position for the locked-pad signs: the character, else the camera
local function focusPos()
	local character = localPlayer and localPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

-- every K.SIGN_CHECK: the signs of the local player's own home (locked pads show their reason only up close), laid
-- out on the screen so none covers the text of another
local function stepSigns()
	if clock < nextSignCheck then
		return
	end
	nextSignCheck = clock + K.SIGN_CHECK
	if not ownsHome then
		return
	end
	signFocus = focusPos()
	local list = {}
	for gui, rec in pairs(signs) do
		if gui.Parent and homeOwner(rec) == localUid then
			local block = signBlock(gui, rec)
			if block then
				signLayout[gui] = nil
				signState[gui] = block
				setSign(gui, false)
				local key = signKey(gui, rec)
				if key then
					rec.SignMemo[key] = nil
				end
			else
				list[#list + 1] = gui
			end
		end
	end
	local before = {}
	for i, gui in ipairs(list) do
		before[i] = signLayout[gui] == "Shown"
	end
	layoutSigns(list)
	for i, gui in ipairs(list) do
		local rec = signs[gui]
		local answer = signLayout[gui]
		if (answer == "Shown") ~= before[i] or signSince[gui] == nil then
			signSince[gui] = clock
		end
		signState[gui] = answer
		setSign(gui, answer == "Shown")
		local key = signKey(gui, rec)
		if key then
			rec.SignMemo[key] = answer
		end
	end
end

local function refreshHome(rec)
	for prompt, state in pairs(overrides) do
		if state.Home == rec then
			applyPrompt(prompt)
		end
	end
	for gui, r in pairs(signs) do
		if r == rec then
			applySign(gui)
		end
	end
end

-- recomputes "the local player owns a home" and refreshes every claim prompt when it changed
local function refreshOwnership()
	local owns = false
	for _, rec in ipairs(homeList) do
		if localUid ~= 0 and homeOwner(rec) == localUid then
			owns = true
		end
	end
	if owns ~= ownsHome then
		ownsHome = owns
		for prompt in pairs(overrides) do
			if prompt.Name == "ClaimPrompt" then
				applyPrompt(prompt)
			end
		end
	end
end

----------------------------------------------------------------------
-- Pop-in
----------------------------------------------------------------------
local function cameraPos()
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

local function easeBack(p)
	local s = 1.7
	local q = p - 1
	return 1 + q * q * ((s + 1) * q + s)
end

-- returns the pop record (nil when the model simply appears: too far, too much popping already, nothing visible)
local function startPop(model, rec)
	if popParts >= K.MAX_POP_PARTS then
		return nil
	end
	local parts = {}
	for _, p in ipairs(collectParts(model)) do
		if p.Transparency < 1 then
			parts[#parts + 1] = p
		end
	end
	if #parts == 0 then
		return nil
	end
	-- near enough to be seen?
	local eye = cameraPos()
	if eye and rec and rec.Center and (rec.Center - eye).Magnitude > K.NEAR + 60 then
		return nil
	end
	local bottoms = {}
	local lo, hi = math.huge, -math.huge
	for i, p in ipairs(parts) do
		local b = p.Position.Y - p.Size.Y / 2
		bottoms[i] = b
		lo, hi = min(lo, b), max(hi, b)
	end
	local span = max(0.001, hi - lo)
	local start = max(clock, nextPopStart)
	nextPopStart = start + K.POP_STAGGER
	local pop = { Model = model, Parts = parts, CF = {}, Size = {}, Trans = {}, Delay = {}, Start = start, Done = false }
	for i, p in ipairs(parts) do
		pop.CF[i] = p.CFrame
		pop.Size[i] = p.Size
		pop.Trans[i] = p.Transparency
		pop.Delay[i] = (bottoms[i] - lo) / span * K.POP_SPREAD
		p.Transparency = 1
	end
	pop.End = start + K.POP_SPREAD + K.POP_PART
	popParts = popParts + #parts
	pops[#pops + 1] = pop
	return pop
end

local function finishPop(pop)
	if pop.Done then
		return
	end
	pop.Done = true
	popParts = max(0, popParts - #pop.Parts)
	for i, p in ipairs(pop.Parts) do
		if p.Parent then
			p.Size = pop.Size[i]
			p.CFrame = pop.CF[i]
			p.Transparency = pop.Trans[i]
		end
	end
end

local function stepPops()
	local i = 1
	while i <= #pops do
		local pop = pops[i]
		if pop.Done or not pop.Model.Parent or clock >= pop.End then
			finishPop(pop)
			table.remove(pops, i)
		else
			local t = clock - pop.Start
			if t >= 0 then
				for j, p in ipairs(pop.Parts) do
					local q = (t - pop.Delay[j]) / K.POP_PART
					if q > 0 then
						if q >= 1 then
							if p.Transparency ~= pop.Trans[j] then
								p.Size = pop.Size[j]
								p.CFrame = pop.CF[j]
								p.Transparency = pop.Trans[j]
							end
						else
							local s = max(0.05, easeBack(q))
							p.Size = pop.Size[j] * s
							p.CFrame = pop.CF[j] + Vector3.new(0, -K.POP_LIFT * (1 - q), 0)
							local base = pop.Trans[j]
							p.Transparency = base + (1 - base) * (1 - clamp01(q * 2.5))
						end
					end
				end
			end
			i = i + 1
		end
	end
end

local function cancelPopOf(model)
	for _, pop in ipairs(pops) do
		if pop.Model == model then
			finishPop(pop)
		end
	end
end

----------------------------------------------------------------------
-- Pads (the local player's own: glow when affordable)
----------------------------------------------------------------------
local function localCash()
	local v = localPlayer and localPlayer:GetAttribute(CASH_ATTR)
	return tonumber(v)
end

local function padAffordable(pad)
	local model = pad.Model
	local locked = model:GetAttribute("Locked")
	if locked ~= nil and locked ~= "" then
		return nil -- locked pads keep the server's look
	end
	local cash = localCash()
	if cash == nil then
		return true
	end
	return cash >= numAttr(model, "Price", 0)
end

local function refreshPad(rec, pad)
	local ok = nil -- true = can pay, false = cannot yet, nil = not ours / locked / unknown
	if localUid ~= 0 and homeOwner(rec) == localUid then
		ok = padAffordable(pad)
	end
	pad.Afford = ok
	if not pad.PriceLabel or not pad.PriceLabel.Parent then
		pad.PriceLabel = pad.Model:FindFirstChild("PriceLabel", true)
		pad.PriceColor = pad.PriceLabel and pad.PriceLabel.TextColor3 or nil
	end
	local label = pad.PriceLabel
	if label and label.Parent and pad.PriceColor then
		label.TextColor3 = (ok == false) and COLORS.PriceShort or pad.PriceColor
	end
	if ok ~= true then
		for i, p in ipairs(pad.Glows) do
			if p.Parent then
				p.Transparency = (ok == false) and max(pad.GlowBase[i], K.PAD_DIM) or pad.GlowBase[i]
			end
		end
	end
end

local function registerPad(rec, model)
	if rec.Pads[model] then
		return
	end
	local pad = { Model = model, Glows = {}, GlowBase = {}, Wave = 0 }
	for _, p in ipairs(collectParts(model)) do
		if p.Name == "Glow" then
			pad.Glows[#pad.Glows + 1] = p
			pad.GlowBase[#pad.GlowBase + 1] = p.Transparency
		end
	end
	rec.Pads[model] = pad
	model:GetAttributeChangedSignal("Price"):Connect(function()
		refreshPad(rec, pad)
	end)
	model:GetAttributeChangedSignal("Locked"):Connect(function()
		refreshPad(rec, pad)
		local sign = model:FindFirstChild("PadSign", true)
		if sign then
			applySign(sign)
		end
	end)
	refreshPad(rec, pad)
end

local function stepPads(rec, dt)
	for _, pad in pairs(rec.Pads) do
		if pad.Popping and pad.Popping.Done then
			pad.Popping = nil
			refreshPad(rec, pad) -- the pop put back the look the pad had when it started
		end
		if pad.Afford == true and not pad.Popping then
			pad.Wave = pad.Wave + dt * K.PAD_PULSE
			local swing = (0.5 + 0.5 * sin(pad.Wave)) * 0.35
			for i, p in ipairs(pad.Glows) do
				if p.Parent then
					p.Transparency = min(0.9, pad.GlowBase[i] + swing)
				end
			end
		end
	end
end


----------------------------------------------------------------------
-- Pets at work (GardenPets on the Garden's cushions, TrainingPets on the Training Place's mats)
----------------------------------------------------------------------
local function parseSlots(text, maxSlot)
	local out = {}
	if type(text) ~= "string" then
		return out
	end
	maxSlot = maxSlot or K.MAX_GARDEN_SLOTS
	for slot, key in string.gmatch(text, "(%d+)=([%w_%-@:]+)") do
		local n = tonumber(slot)
		if n and n >= 1 and n <= maxSlot and n == floor(n) then
			out[n] = key
		end
	end
	return out
end

-- the attribute on the plot folder (TycoonService / PetCareService write it there), else on the Home folder
local function slotText(rec, attr)
	local folder = rec.Folder
	local v = folder.Parent and folder.Parent:GetAttribute(attr)
	if v == nil then
		v = folder:GetAttribute(attr)
	end
	return v
end

local function petDefOf(key)
	if PetKeys and type(PetKeys.DefOf) == "function" then
		local ok, def = pcall(PetKeys.DefOf, key)
		if ok and type(def) == "table" then
			return def
		end
	end
	if PetCatalog and type(PetCatalog.Get) == "function" then
		local ok, def = pcall(PetCatalog.Get, key)
		if ok and type(def) == "table" then
			return def
		end
	end
	return nil
end

-- a fresh Low-detail model of the pet (PetBuilder caches the sculpt and clones; stage > 0: its evolved form),
-- anchored and inert, plus the height of its lowest block under the pivot
local function buildPet(key, scale, stage)
	scale = tonumber(scale) or K.PET_SCALE
	stage = tonumber(stage) or 0
	local lowKey = key .. "|" .. scale .. "|" .. stage
	if not PetBuilder or petLows[lowKey] == false then
		return nil
	end
	local def = petDefOf(key)
	if not def then
		petLows[lowKey] = false
		return nil
	end
	local opts = { Detail = "Low", Scale = scale }
	if stage > 0 then
		opts.Evolved = stage
	end
	local ok, model = pcall(PetBuilder.Build, def, opts)
	if not ok or typeof(model) ~= "Instance" then
		petLows[lowKey] = false
		return nil
	end
	petStats.Builds = petStats.Builds + 1
	if petLows[lowKey] == nil then
		petStats.Cold = petStats.Cold + 1
	end
	model.Name = "HomePet"
	model:SetAttribute("PetKey", key)
	local list = collectParts(model)
	for _, part in ipairs(list) do
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	local lo = petLows[lowKey]
	if lo == nil then
		model:PivotTo(CFrame.new())
		lo = 0
		local hi, hw, lieLo = 0, 0.5, 0
		local first = true
		local ls, lc = sin(G.LIE_ANGLE), math.cos(G.LIE_ANGLE)
		for _, part in ipairs(list) do
			if part.Transparency < 1 then
				local p, s = part.Position, part.Size
				local bottom = p.Y - s.Y / 2
				-- the lowest point once the pet lies on its side (rolled G.LIE_ANGLE about its forward axis)
				local lying = p.X * ls + p.Y * lc - (abs(ls) * s.X + abs(lc) * s.Y) / 2
				if first or bottom < lo then
					lo, first = bottom, false
				end
				lieLo = min(lieLo, lying)
				hi = max(hi, p.Y + s.Y / 2)
				hw = max(hw, abs(p.X) + s.X / 2)
			end
		end
		petLows[lowKey] = lo
		petDims[lowKey] = { Hi = hi, Hw = min(hw, 2.5), LieLo = lieLo }
	end
	return model, lo
end

-- puts a pet model away (unparented) for the way back; the oldest beyond K.PET_POOL are destroyed
local function poolPet(lowKey, model, lo)
	local ok = lowKey ~= nil and lo ~= nil and pcall(function()
		model.Parent = nil
	end)
	if not ok then
		pcall(model.Destroy, model)
		return
	end
	petPool[#petPool + 1] = { Key = lowKey, Model = model, Lo = lo }
	while #petPool > K.PET_POOL do
		local old = table.remove(petPool, 1)
		pcall(old.Model.Destroy, old.Model)
	end
end

local function pooledPet(lowKey)
	for i = #petPool, 1, -1 do
		if petPool[i].Key == lowKey then
			return i
		end
	end
	return nil
end

local function dropPet(pk, slot)
	local entry = pk.Pets[slot]
	if entry then
		pk.Pets[slot] = nil
		G.releaseEntry(entry)
		if entry.Model then
			poolPet(entry.LowKey, entry.Model, entry.Lo)
		end
	end
end

-- may this frame still build (or take from the pool) a pet model? The first always may; a first-time build
-- (`cold`: a new sculpt or template, many times a clone's cost) only as the frame's first; then at most
-- K.PET_BUILD_MAX and only while the frame has spent less than K.PET_BUILD_BUDGET seconds on them
local function petBudget(cold)
	if petFrameBuilds == 0 then
		return true
	end
	if cold or petFrameBuilds >= K.PET_BUILD_MAX then
		return false
	end
	return os.clock() - petFrameStart < K.PET_BUILD_BUDGET
end

-- a pet model sitting on `seat` (a cushion / mat CFrame, already turned the way the pet looks): from the pool when
-- one waits there, else built; nil when it cannot be built
local function placePet(key, scale, stage, seat)
	local lowKey = key .. "|" .. scale .. "|" .. stage
	local i = pooledPet(lowKey)
	if i then
		local entry = table.remove(petPool, i)
		local ok = pcall(function()
			entry.Model:PivotTo(seat * CFrame.new(0, K.PET_HOVER - entry.Lo, 0))
			entry.Model.Parent = ensurePetFolder()
		end)
		if ok then
			petStats.PoolHits = petStats.PoolHits + 1
			return entry.Model, lowKey, entry.Lo
		end
		pcall(entry.Model.Destroy, entry.Model) -- destroyed while it waited: build a new one
	end
	local model, lo = buildPet(key, scale, stage)
	if not model then
		return nil
	end
	model:PivotTo(seat * CFrame.new(0, K.PET_HOVER - lo, 0))
	model.Parent = ensurePetFolder()
	return model, lowKey, lo
end

local function clearPets(rec)
	for _, pk in pairs(rec.Pet) do
		for slot in pairs(pk.Pets) do
			dropPet(pk, slot)
		end
	end
end

-- brings the pets of one station in line with its attribute (only while the home is near and the station stands)
local function syncPets(rec, kind)
	local pk = rec.Pet[kind]
	pk.Dirty = false
	local info = PET_STATIONS[kind]
	local st = pk.Station
	local want, stages = {}, {}
	if rec.PetsNear and st and st.Model.Parent then
		want, stages = G.wantPets(rec, kind)
	elseif kind == "Training" then
		G.wantPets(rec, kind) -- keeps the jobs (timers) current
	end
	for slot, entry in pairs(pk.Pets) do
		if want[slot] ~= entry.Key or (stages[slot] or 0) ~= entry.Stage or not st or entry.Station ~= st.Model
			or not entry.Model.Parent or entry.Pose ~= G.poseId(rec, kind, slot) then
			dropPet(pk, slot)
		end
	end
	-- slot by slot under the frame's build budget: what does not fit waits for the next frame (still Dirty)
	local scale = info.Scale
	for slot = 1, info.Slots do
		local key = want[slot]
		if key and not pk.Pets[slot] then
			local att = st.Model:FindFirstChild("Spot" .. slot, true)
			local stage = stages[slot] or 0
			local lowKey = key .. "|" .. scale .. "|" .. stage
			if att and att:IsA("Attachment") and petLows[lowKey] ~= false then
				local cold = petLows[lowKey] == nil and pooledPet(lowKey) == nil
				if not petBudget(cold) then
					pk.Dirty = true
					return
				end
				if petFrameBuilds == 0 then
					petFrameStart = os.clock()
				end
				petFrameBuilds = cold and K.PET_BUILD_MAX or (petFrameBuilds + 1)
				local seat = G.seat(rec, kind, slot, att)
				local model, lk, lo = placePet(key, scale, stage, seat)
				if model then
					model.Name = kind .. "Pet"
					local dims = petDims[lk] or {}
					local entry = {
						Key = key,
						Model = model,
						Station = st.Model,
						LowKey = lk,
						Lo = lo,
						Stage = stage,
						Seat = seat,
						Att = att,
						Base = seat * CFrame.new(0, K.PET_HOVER - lo, 0),
						Hw = dims.Hw or 0.8,
						Hi = dims.Hi or 1.6,
						Pose = G.poseId(rec, kind, slot),
						Slot = slot,
						Phase = G.noise(slot, clock + #homeList) * G.mealSeconds(),
					}
					entry.Lie = lo - (dims.LieLo or lo)
					entry.Top = K.PET_HOVER - lo + entry.Hi -- the pet's top above its seat
					pk.Pets[slot] = entry
					G.placed(rec, kind, slot, entry)
					petFramePlaced = petFramePlaced + 1
					if petFramePlaced > petStats.FrameMost then
						petStats.FrameMost = petFramePlaced
					end
				elseif stage > 0 then
					pk.Dirty = true -- the evolved form cannot be built: the plain look next frame (wantPets skips it)
				end
			end
		end
	end
end

local function syncAllPets(rec)
	for kind in pairs(rec.Pet) do
		syncPets(rec, kind)
	end
end

local function stepPetStations(rec)
	for kind, pk in pairs(rec.Pet) do
		if pk.Dirty then
			local st = pk.Station
			if not (st and st.Popping and not st.Popping.Done) then
				syncPets(rec, kind)
			end
		end
	end
	if not PetBuilder or not rec.PetsAnimate or clock < (rec.PetAnimAt or 0) then
		return
	end
	rec.PetAnimAt = clock + K.PET_ANIM_STEP
	for kind, pk in pairs(rec.Pet) do
		local anim = PET_STATIONS[kind].Anim
		for _, entry in pairs(pk.Pets) do
			if entry.Model.Parent then
				pcall(PetBuilder.Animate, entry.Model, clock, entry.Sleep and G.SLEEP_ANIM or anim)
			end
		end
	end
end

local function anyPetsDirty(rec)
	for _, pk in pairs(rec.Pet) do
		if pk.Dirty then
			return true
		end
	end
	return rec.Garden.HeapsDirty or rec.Garden.BowlsDirty
end

----------------------------------------------------------------------
-- Garden (contract 3.2 / 3.3 / 3.7 / 6): coin heaps from CoinPiles, bowls, eating pets, fruit, the Coin Magnet,
-- the scoop zip + "+$" label, the Training Place props, the pet cards. Every part here is a CLIENT part: pooled,
-- built only for homes within K.PET_NEAR, nothing created per coin or per frame, fills / texts written on change.
----------------------------------------------------------------------
G.HEAP_Y = 0.62 -- the sand walks' top in the Garden's station frame (the piles lie on the walks)
G.SLEEP_ANIM = { Flap = 0.15 }
G.LIE_ANGLE = 1.35 -- radians a napping pet rolls onto its side
-- coins / mound radius / height per heap stage (CoinPiles 1..5) and the Welcome-back pile ("W"): <= 40 / 60 parts
G.HEAP = {
	{ N = 3, R = 0.34, H = 0.22 },
	{ N = 7, R = 0.48, H = 0.42 },
	{ N = 13, R = 0.6, H = 0.66 },
	{ N = 22, R = 0.72, H = 0.95 },
	{ N = 33, R = 0.84, H = 1.25 },
	W = { N = 46, R = 1.0, H = 1.6 },
}
G.FRUIT = { -- the flying fruit of each plant look (HomeBuilder's Fruit attribute)
	Berry = Vector3.new(0.42, 0.42, 0.42),
	Carrot = Vector3.new(0.3, 0.66, 0.3),
	Melon = Vector3.new(0.66, 0.56, 0.66),
	Starfruit = Vector3.new(0.6, 0.6, 0.18),
}
G.GREY = Color3.fromRGB(118, 122, 140)

function G.mix(a, b, t)
	return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

-- deterministic 0..1 noise
function G.noise(a, b)
	local x = sin(a * 12.9898 + b * 78.233) * 43758.5453
	return x - floor(x)
end

function G.part(name, size, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.SmoothPlastic
	p.Size = size
	if color then
		p.Color = color
	end
	return p
end

function G.mealSeconds()
	local c = TycoonCatalog and TycoonCatalog.Coins
	local v = c and tonumber(c.MealSeconds)
	return (v and v > 0) and v or K.MEAL
end

function G.gardenDef()
	if TycoonCatalog and type(TycoonCatalog.Get) == "function" then
		local ok, def = pcall(TycoonCatalog.Get, "Garden")
		if ok and type(def) == "table" then
			return def
		end
	end
	return nil
end

function G.coinPoint(slot)
	if TycoonCatalog and type(TycoonCatalog.CoinPoint) == "function" then
		local ok, p = pcall(TycoonCatalog.CoinPoint, slot)
		if ok and typeof(p) == "Vector3" then
			return p
		end
	end
	return nil
end

function G.localRoot()
	local char = localPlayer and localPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

-- another player's home: their coins are drawn dimmed and never move
function G.dimmed(rec)
	local owner = homeOwner(rec)
	return owner ~= 0 and owner ~= localUid
end

-- the local player's own home record (or nil)
function G.ownRec()
	if localUid == 0 then
		return nil
	end
	for _, rec in ipairs(homeList) do
		if homeOwner(rec) == localUid and rec.Folder.Parent then
			return rec
		end
	end
	return nil
end

-- "1=3;2=5F;4=2*;W=5" -> { [slot] = { Stage, Full, Lucky }, W = { Stage } } (TycoonService's CoinPiles)
function G.parsePiles(text)
	local out = {}
	if type(text) ~= "string" then
		return out
	end
	for slot, stage, flags in string.gmatch(text, "(%w+)=(%d+)([F%*]*)") do
		local n = tonumber(stage)
		local key = (slot == "W") and "W" or tonumber(slot)
		local okKey = key == "W" or (key ~= nil and key >= 1 and key <= K.MAX_GARDEN_SLOTS and key == floor(key))
		if okKey and n and n >= 1 then
			out[key] = { Stage = min(5, floor(n)), Full = string.find(flags, "F", 1, true) ~= nil, Lucky = string.find(flags, "*", 1, true) ~= nil }
		end
	end
	return out
end

-- "1=12:0;3=20:1" -> { [slot] = { Level, Stage } } (GardenInfo)
function G.parseInfo(text)
	local out = {}
	if type(text) ~= "string" then
		return out
	end
	for slot, level, stage in string.gmatch(text, "(%d+)=(%d+):(%d+)") do
		local n = tonumber(slot)
		if n and n >= 1 and n <= K.MAX_GARDEN_SLOTS then
			out[n] = { Level = max(1, tonumber(level) or 1), Stage = min(2, tonumber(stage) or 0) }
		end
	end
	return out
end

-- "1=cat:Physique:1760000000;2=fox@Golden:Speed:1760000420" -> keys { [mat] = key }, jobs { [mat] = { Key, Stat, Ends } }
function G.parseTraining(text)
	local keys, jobs = {}, {}
	if type(text) ~= "string" then
		return keys, jobs
	end
	for item in string.gmatch(text, "[^;]+") do
		local slot, key, stat, ends = string.match(item, "^%s*(%d+)=(.+):(%a+):(%d+)%s*$")
		if not slot then
			slot, key = string.match(item, "^%s*(%d+)=([%w_%-@:]+)%s*$")
		end
		local n = tonumber(slot)
		if n and n >= 1 and n <= K.MAX_TRAIN_SLOTS and n == floor(n) and key and key ~= "" then
			keys[n] = key
			jobs[n] = { Key = key, Stat = stat or "Speed", Ends = tonumber(ends) or 0 }
		end
	end
	return keys, jobs
end

-- the open garden places (GardenSlots on the plot, else the Garden model's Open attribute, else 3)
function G.openCount(rec)
	local v = tonumber(slotText(rec, "GardenSlots"))
	if v == nil then
		local st = rec.Pet.Garden.Station
		v = st and st.Model.Parent and tonumber(st.Model:GetAttribute("Open")) or nil
	end
	return max(0, min(K.MAX_GARDEN_SLOTS, floor(v or 3)))
end

-- the Garden's station frame (its Lawn sits on it), re-read when the Garden is rebuilt
function G.frame(rec)
	local gd = rec.Garden
	local st = rec.Pet.Garden.Station
	if not st or not st.Model.Parent then
		return nil
	end
	if gd.FrameModel ~= st.Model then
		gd.FrameModel = st.Model
		gd.Frame = nil
		-- the plot frame first: the Lawn may be mid pop-in (its blocks spring up from below)
		local plot = rec.Folder:GetAttribute("PlotCFrame")
		local def = G.gardenDef()
		local lawn = st.Model:FindFirstChild("Lawn")
		if typeof(plot) == "CFrame" and def and def.Slot and typeof(def.Slot.CFrame) == "CFrame" then
			gd.Frame = plot * def.Slot.CFrame
		elseif lawn and lawn:IsA("BasePart") and not (st.Popping and not st.Popping.Done) then
			gd.Frame = lawn.CFrame * CFrame.new(0, -lawn.Size.Y / 2, 0)
		else
			gd.FrameModel = nil -- try again next time
		end
	end
	return gd.Frame
end

-- the world point a pile lies on: place n -> its CoinPoint on the walk; "W" -> the Welcome-back pile (plot-local)
function G.pilePoint(rec, slot)
	if slot == "W" then
		local plot = rec.Folder:GetAttribute("PlotCFrame")
		local def = G.gardenDef()
		local w = def and def.Slot and def.Slot.WelcomePile
		if typeof(plot) == "CFrame" and typeof(w) == "Vector3" then
			return plot:PointToWorldSpace(Vector3.new(w.X, w.Y + 0.02, w.Z))
		end
		return nil
	end
	local frame = G.frame(rec)
	local cp = G.coinPoint(slot)
	if not frame or not cp then
		return nil
	end
	return frame:PointToWorldSpace(Vector3.new(cp.X, G.HEAP_Y, cp.Z))
end

-- the scoop radius of a home: TycoonCatalog.ScoopRadius from the Coin Magnet's level (6 studs without one)
function G.scoopRadius(rec)
	local lv = rec.Magnet and rec.Magnet.Level or 0
	if TycoonCatalog and type(TycoonCatalog.ScoopRadius) == "function" then
		local ok, r = pcall(TycoonCatalog.ScoopRadius, { Stations = { Collector = lv } })
		if ok and type(r) == "number" and r > 0 then
			return r
		end
	end
	return 6
end

-- the food in the bowls: the fruit of the best plant built (Starfruit > Melons > Carrots > Berries), else grass
function G.foodColor(rec)
	local best, color = -1, COLORS.Grass
	for _, st in ipairs(rec.Plants) do
		local n = tonumber(string.match(st.Id, "%d+")) or 0
		local c = st.Model:GetAttribute("FruitColor")
		if n > best and typeof(c) == "Color3" then
			best, color = n, c
		end
	end
	return color
end

----------------------------------------------------------------------
-- pools: flying coins (<= K.MAX_COINS), fruit (<= K.MAX_FRUIT), heaps (cloned templates), sparkles, Zzz, bowls
----------------------------------------------------------------------
function G.takeCoin(i)
	if G.coinsAlive >= K.MAX_COINS then
		return nil
	end
	local p = table.remove(G.coinPool)
	if not p then
		p = G.part("FlyingCoin", Vector3.new(0.5, 0.12, 0.5), COLORS.Gold)
		G.coinsMade = G.coinsMade + 1
	end
	p.Color = COLORS.Coins[((i or 1) - 1) % #COLORS.Coins + 1]
	G.coinsAlive = G.coinsAlive + 1
	return p
end

function G.giveCoin(p)
	G.coinsAlive = max(0, G.coinsAlive - 1)
	p.Parent = nil
	G.coinPool[#G.coinPool + 1] = p
end

function G.takeFruit(look, color)
	if G.fruitAlive >= K.MAX_FRUIT then
		return nil
	end
	local p = table.remove(G.fruitPool)
	if not p then
		p = G.part("FlyingFruit", Vector3.new(0.4, 0.4, 0.4), COLORS.Grass)
		G.fruitMade = G.fruitMade + 1
	end
	p.Size = G.FRUIT[look] or G.FRUIT.Berry
	p.Color = color or COLORS.Grass
	G.fruitAlive = G.fruitAlive + 1
	return p
end

function G.giveFruit(p)
	G.fruitAlive = max(0, G.fruitAlive - 1)
	p.Parent = nil
	G.fruitPool[#G.fruitPool + 1] = p
end

-- a part flying from a to b (b follows `follow` when given) in an arc, back to its pool when it lands
function G.fly(rec, part, a, b, dur, arc, poolName, follow)
	part.CFrame = CFrame.new(a)
	part.Parent = ensureFolder()
	G.flying[#G.flying + 1] = { Part = part, Rec = rec, A = a, B = b, T = 0, Dur = max(0.05, dur), Arc = arc or 0, Pool = poolName,
		Follow = follow, Spin = G.noise(#G.flying, clock) * 6 }
end

function G.land(f)
	if f.Pool == "fruit" then
		G.giveFruit(f.Part)
	else
		G.giveCoin(f.Part)
	end
end

function G.stepFlying(dt)
	local list = G.flying
	local i = 1
	while i <= #list do
		local f = list[i]
		f.T = f.T + dt
		local q = f.T / f.Dur
		if q >= 1 then
			G.land(f)
			table.remove(list, i)
		else
			local b = f.B
			if f.Follow and f.Follow.Parent then
				b = f.Follow.Position
			end
			local pos = f.A:Lerp(b, q) + Vector3.new(0, f.Arc * 4 * q * (1 - q), 0)
			f.Part.CFrame = CFrame.new(pos) * CFrame.Angles(0.5, f.Spin + f.T * 9, 0)
			i = i + 1
		end
	end
end

-- the flying parts of one home go back to their pools (the home froze or went away)
function G.recycle(rec)
	local list = G.flying
	for i = #list, 1, -1 do
		if list[i].Rec == rec then
			G.land(list[i])
			table.remove(list, i)
		end
	end
end

function G.lookOf(slot, stage, dim)
	return ((slot == "W") and "W" or tostring(stage)) .. (dim and "d" or "")
end

-- a heap of rainbow coins: a golden core with coins piled into a dome (golden-angle spiral), built at the origin
function G.buildHeap(look)
	local stage, d = string.match(look, "^(%w)(d?)$")
	local spec = (stage == "W") and G.HEAP.W or G.HEAP[tonumber(stage) or 1] or G.HEAP[1]
	local dim = d == "d"
	local model = Instance.new("Model")
	model.Name = (stage == "W") and "WelcomeHeap" or "CoinHeap"
	local function tone(c)
		return dim and G.mix(c, G.GREY, 0.55) or c
	end
	-- the golden mass under the coins: a wide low block and a narrower tall one (a dome in two steps)
	local lowH, topH = max(0.08, spec.H * 0.42), max(0.1, spec.H * 0.8)
	local core = G.part("Core", Vector3.new(spec.R * 1.55, lowH, spec.R * 1.55), tone(COLORS.GoldDark))
	core.CFrame = CFrame.new(0, lowH / 2, 0)
	core.Parent = model
	local top = G.part("CoreTop", Vector3.new(spec.R * 0.95, topH, spec.R * 0.95), tone(COLORS.Gold))
	top.CFrame = CFrame.new(0, topH / 2, 0) * CFrame.Angles(0, pi / 4, 0)
	top.Parent = model
	model.PrimaryPart = core
	for i = 1, spec.N do
		local u = (i - 0.5) / spec.N
		local r = spec.R * math.sqrt(u)
		local a = i * 2.39996
		local y = spec.H * (1 - u) ^ 0.75 + 0.03
		local c = (i % 4 == 0) and COLORS.Gold or COLORS.Coins[(i % #COLORS.Coins) + 1]
		local coin = G.part("Coin", Vector3.new(0.56, 0.13, 0.56), tone(c))
		-- flat coins with a small tilt down the slope of the pile, every one turned a little
		coin.CFrame = CFrame.new(math.cos(a) * r, y, math.sin(a) * r) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, 0.08 + 0.22 * u)
			* CFrame.Angles(0, G.noise(i, 2) * 1.5, 0)
		if dim then
			coin.Transparency = 0.3
		end
		coin.Parent = model
	end
	if dim then
		core.Transparency = 0.3
		top.Transparency = 0.3
	end
	model:SetAttribute("Lift", lowH / 2)
	model:SetAttribute("Top", spec.H + 0.1)
	return model
end

function G.takeHeap(look)
	local list = G.heapPool[look]
	if list and #list > 0 then
		return table.remove(list)
	end
	if G.heapFrame >= K.HEAP_BUILD_MAX then
		return nil
	end
	G.heapFrame = G.heapFrame + 1
	local tpl = G.heapTpl[look]
	if not tpl then
		tpl = G.buildHeap(look)
		G.heapTpl[look] = tpl
	end
	G.heapsMade = G.heapsMade + 1
	return tpl:Clone()
end

function G.giveHeap(look, model)
	model.Parent = nil
	local list = G.heapPool[look]
	if not list then
		list = {}
		G.heapPool[look] = list
	end
	if #list < K.HEAP_POOL then
		list[#list + 1] = model
	else
		model:Destroy()
	end
end

-- the Lucky coin's sparkle: a golden four-point star (2 neon bars) that turns above the heap
function G.takeSpark()
	local s = table.remove(G.sparkPool)
	if not s then
		local a = G.part("LuckyStar", Vector3.new(0.7, 0.16, 0.16), COLORS.Gold, Enum.Material.Neon)
		local b = G.part("LuckyStar", Vector3.new(0.16, 0.7, 0.16), COLORS.Gold, Enum.Material.Neon)
		s = { a, b }
	end
	return s
end

function G.giveSpark(s)
	for _, p in ipairs(s) do
		p.Parent = nil
	end
	G.sparkPool[#G.sparkPool + 1] = s
end

-- "Zzz": two voxel Z letters (3 bars each) over a napping pet
function G.takeZzz()
	local z = table.remove(G.zzzPool)
	if not z then
		z = { Parts = {}, Local = {} }
		for li, s in ipairs({ 1, 0.65 }) do
			local ox, oy = (li - 1) * 0.42, (li - 1) * 0.5
			local bars = {
				{ Vector3.new(0.5 * s, 0.1 * s, 0.1), CFrame.new(ox, oy + 0.25 * s, 0) },
				{ Vector3.new(0.5 * s, 0.1 * s, 0.1), CFrame.new(ox, oy - 0.25 * s, 0) },
				{ Vector3.new(0.1 * s, 0.68 * s, 0.1), CFrame.new(ox, oy, 0) * CFrame.Angles(0, 0, -pi / 4) },
			}
			for _, b in ipairs(bars) do
				local p = G.part("Zzz", b[1], COLORS.Zzz)
				z.Parts[#z.Parts + 1] = p
				z.Local[#z.Local + 1] = b[2]
			end
		end
	end
	return z
end

function G.giveZzz(z)
	for _, p in ipairs(z.Parts) do
		p.Parent = nil
	end
	G.zzzPool[#G.zzzPool + 1] = z
end

-- a food bowl: a pastel dish and the food in it (2 parts)
function G.takeBowl()
	local b = table.remove(G.bowlPool)
	if not b then
		b = {
			Dish = G.part("Bowl", Vector3.new(0.8, 0.3, 0.8), COLORS.Bowls[1]),
			Food = G.part("BowlFood", Vector3.new(0.56, 0.12, 0.56), COLORS.Grass),
		}
	end
	return b
end

function G.giveBowl(b)
	b.Dish.Parent = nil
	b.Food.Parent = nil
	G.bowlPool[#G.bowlPool + 1] = b
end

----------------------------------------------------------------------
-- heaps and bowls of one home
----------------------------------------------------------------------
function G.dropHeap(gd, slot)
	local h = gd.Heaps[slot]
	if not h then
		return
	end
	gd.Heaps[slot] = nil
	if h.Spark then
		G.giveSpark(h.Spark)
	end
	G.giveHeap(h.Look, h.Model)
end

-- the heaps follow CoinPiles (stage -> look; '*' -> the sparkle); others' heaps dimmed and still
function G.syncHeaps(rec)
	local gd = rec.Garden
	gd.HeapsDirty = false
	local want = {}
	if rec.PetsNear and G.frame(rec) then
		want = gd.Piles
	end
	local dim = G.dimmed(rec)
	for slot, h in pairs(gd.Heaps) do
		local p = want[slot]
		if not p or h.Look ~= G.lookOf(slot, p.Stage, dim) or h.Frame ~= gd.Frame or not h.Model.Parent then
			G.dropHeap(gd, slot)
		end
	end
	for slot, p in pairs(want) do
		local h = gd.Heaps[slot]
		if not h then
			local point = G.pilePoint(rec, slot)
			local look = G.lookOf(slot, p.Stage, dim)
			local model = point and G.takeHeap(look) or nil
			if point and not model then
				gd.HeapsDirty = true -- over this frame's budget: the next frame
			elseif model then
				local lift = tonumber(model:GetAttribute("Lift")) or 0
				local seed = (slot == "W") and 13 or slot
				model:PivotTo(CFrame.new(point + Vector3.new(0, lift, 0)) * CFrame.Angles(0, G.noise(seed, 5) * 6.28, 0))
				model.Parent = ensureFolder()
				h = { Look = look, Model = model, Point = point, Frame = gd.Frame, Top = tonumber(model:GetAttribute("Top")) or 0.5, Dim = dim, Stage = p.Stage }
				gd.Heaps[slot] = h
			end
		end
		if h then
			local lucky = p.Lucky and not dim
			if lucky and not h.Spark then
				h.Spark = G.takeSpark()
				for _, part in ipairs(h.Spark) do
					part.CFrame = CFrame.new(h.Point + Vector3.new(0, h.Top + 0.45, 0))
					part.Parent = ensureFolder()
				end
			elseif not lucky and h.Spark then
				G.giveSpark(h.Spark)
				h.Spark = nil
			end
		end
	end
end

-- a bowl in front of every open place, toward its pile (the walk); the food is the best plant's fruit
function G.syncBowls(rec)
	local gd = rec.Garden
	gd.BowlsDirty = false
	local frame = rec.PetsNear and G.frame(rec) or nil
	local def = G.gardenDef()
	local spots = def and def.Slot and def.Slot.Spots
	local open = (frame and spots) and min(gd.Open, #spots) or 0
	if gd.BowlFrame ~= frame then
		for slot, b in pairs(gd.Bowls) do
			G.giveBowl(b)
			gd.Bowls[slot] = nil
		end
		gd.BowlFrame = frame
	end
	for slot, b in pairs(gd.Bowls) do
		if slot > open then
			G.giveBowl(b)
			gd.Bowls[slot] = nil
		end
	end
	local color = G.foodColor(rec)
	for slot = 1, open do
		local b = gd.Bowls[slot]
		if not b then
			local p = spots[slot]
			local cp = G.coinPoint(slot) or p
			local dir = (cp.Z > p.Z) and 1 or -1
			local c = frame * CFrame.new(p.X, 1.0, p.Z + dir * 1.25)
			b = G.takeBowl()
			b.Dish.CFrame = c * CFrame.new(0, 0.15, 0)
			b.Food.CFrame = c * CFrame.new(0, 0.36, 0)
			b.Dish.Color = COLORS.Bowls[(slot - 1) % #COLORS.Bowls + 1]
			b.Top = c.Position + Vector3.new(0, 0.45, 0)
			b.Dish.Parent = ensureFolder()
			b.Food.Parent = ensureFolder()
			gd.Bowls[slot] = b
		end
		b.Food.Color = color
	end
end

-- a bowl for a fruit: one of a pet's (random), else any
function G.pickBowl(rec)
	local gd = rec.Garden
	local withPet, any = {}, {}
	for slot, b in pairs(gd.Bowls) do
		any[#any + 1] = b
		if rec.Pet.Garden.Pets[slot] then
			withPet[#withPet + 1] = b
		end
	end
	local list = (#withPet > 0) and withPet or any
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

----------------------------------------------------------------------
-- pets: seats, poses, eating, napping, training props
----------------------------------------------------------------------
-- what a placed pet depends on besides its key (a training pet's skill decides its seat and prop)
function G.poseId(rec, kind, slot)
	if kind == "Training" then
		local job = rec.Train.Jobs[slot]
		return job and job.Stat or ""
	end
	return ""
end

function G.wantPets(rec, kind)
	local stages = {}
	if kind == "Training" then
		local keys, jobs = G.parseTraining(slotText(rec, "TrainingPets"))
		rec.Train.Jobs = jobs
		return keys, stages
	end
	local keys = parseSlots(slotText(rec, "GardenPets"), K.MAX_GARDEN_SLOTS)
	if localUid ~= 0 and homeOwner(rec) == localUid then
		-- the local player's own evolved garden pets show their evolved form (at most K.EVO_MAX of them)
		local n = 0
		for slot = 1, K.MAX_GARDEN_SLOTS do
			local info = rec.Garden.Info[slot]
			if keys[slot] and info and info.Stage > 0 and n < K.EVO_MAX then
				local lk = keys[slot] .. "|" .. PET_STATIONS.Garden.Scale .. "|" .. info.Stage
				if petLows[lk] ~= false then
					stages[slot] = info.Stage
					n = n + 1
				end
			end
		end
	end
	return keys, stages
end

-- the CFrame a pet sits on: garden pets look at their bowl, training pets by skill (a treadmill lifts them, the
-- shield dummy stands beside them)
function G.seat(rec, kind, slot, att)
	local cf = att.WorldCFrame
	if kind == "Garden" then
		local def = G.gardenDef()
		local spot = def and def.Slot and def.Slot.Spots and def.Slot.Spots[slot]
		local cp = G.coinPoint(slot)
		if spot and cp and cp.Z > spot.Z then
			cf = cf * CFrame.Angles(0, pi, 0)
		end
		return cf
	end
	local job = rec.Train.Jobs[slot]
	local stat = job and job.Stat
	if stat == "Speed" then
		return cf * CFrame.new(0, 0.26, 0)
	elseif stat == "Defense" then
		return cf * CFrame.Angles(0, -pi / 2, 0)
	end
	return cf
end

-- writes a pet's pose only when it changed (dip into the bowl, wiggle, lift, a push forward)
function G.pose(entry, dip, wig, lift, push)
	local qd = floor(dip * 20 + 0.5)
	local qw = floor(wig * 50 + 0.5)
	local ql = floor((lift or 0) * 50 + 0.5)
	local qp = floor((push or 0) * 50 + 0.5)
	local key = qd + 32 * (qw + 64) + 4096 * (ql + 64) + 524288 * (qp + 64)
	if entry.PoseKey == key then
		return
	end
	entry.PoseKey = key
	local cf = entry.Base
	if qd ~= 0 then
		cf = cf * CFrame.new(0, -0.22 * dip, -0.32 * dip) * CFrame.Angles(-0.38 * dip, 0, 0)
	end
	if qw ~= 0 then
		cf = cf * CFrame.Angles(0, wig, 0)
	end
	if ql ~= 0 or qp ~= 0 then
		cf = cf * CFrame.new(0, lift or 0, -(push or 0))
	end
	entry.Model:PivotTo(cf)
end

-- napping (a full pile, or a place above the open count): the pet lies on its side with a "Zzz"
function G.setSleep(entry, sleep)
	entry.PoseKey = nil
	entry.Sleep = sleep
	if sleep then
		entry.Model:PivotTo(entry.Base * CFrame.new(0, entry.Lie or 0, 0) * CFrame.Angles(0, 0, G.LIE_ANGLE))
		if not entry.Zzz then
			entry.Zzz = G.takeZzz()
			for _, p in ipairs(entry.Zzz.Parts) do
				p.Parent = ensureFolder()
			end
			G.stepZzz(entry, true)
		end
	else
		entry.Model:PivotTo(entry.Base)
		if entry.Zzz then
			G.giveZzz(entry.Zzz)
			entry.Zzz = nil
		end
	end
end

function G.stepZzz(entry, force)
	local z = entry.Zzz
	if not z then
		return
	end
	local t = clock + (entry.Slot or 0) * 0.7
	local q = (t * 0.5) % 1
	local pos = entry.Seat.Position + Vector3.new(0.3, (entry.Hw or 0.8) * 1.4 + 0.5 + q * 0.6, 0)
	local cam = Workspace.CurrentCamera
	local look = cam and cam.CFrame.Position or (pos + Vector3.new(0, 0, -1))
	local flat = Vector3.new(look.X, pos.Y, look.Z)
	if (flat - pos).Magnitude < 0.01 then
		flat = pos + Vector3.new(0, 0, -1)
	end
	local base = CFrame.lookAt(pos, flat)
	for i, p in ipairs(z.Parts) do
		p.CFrame = base * z.Local[i]
	end
end

-- a pet just placed: a training pet gets its prop
function G.placed(rec, kind, slot, entry)
	if kind == "Training" then
		local job = rec.Train.Jobs[slot]
		entry.Stat = job and job.Stat or "Speed"
		G.attachProp(entry)
	end
end

-- a pet going away: its card, Zzz and prop are put away
function G.releaseEntry(entry)
	if entry.Card then
		pcall(entry.Card.Destroy, entry.Card)
		entry.Card = nil
	end
	if entry.Zzz then
		G.giveZzz(entry.Zzz)
		entry.Zzz = nil
	end
	if entry.Prop then
		G.giveProp(entry.Prop)
		entry.Prop = nil
	end
end

-- one coin hops from an eating pet onto its pile (only while the home is near: purely a look)
function G.dropCoin(rec, slot, entry)
	local h = rec.Garden.Heaps[slot]
	local target = (h and (h.Point + Vector3.new(0, h.Top, 0))) or G.pilePoint(rec, slot)
	if not target then
		return
	end
	local part = G.takeCoin(slot)
	if not part then
		return
	end
	local from = (entry.Base * CFrame.new(0, (entry.Hi or 1.6) * 0.6, 0)).Position
	G.fly(rec, part, from, target, K.COIN_FLIGHT, 1.8, "coin")
	G.stats.Drops = G.stats.Drops + 1
end

-- every garden pet: the meal rhythm (dip, dip, a coin pops out, a wiggle), naps on a full pile or a closed bed
function G.stepGarden(rec, dt)
	local gd = rec.Garden
	local pk = rec.Pet.Garden
	local meal = G.mealSeconds()
	local motion = clock >= (gd.MotionAt or 0)
	if motion then
		gd.MotionAt = clock + K.MOTION_STEP
	end
	for slot, entry in pairs(pk.Pets) do
		if entry.Model.Parent then
			local pile = gd.Piles[slot]
			local sleep = slot > gd.Open or (pile ~= nil and pile.Full)
			if sleep ~= (entry.Sleep == true) then
				G.setSleep(entry, sleep)
			end
			if sleep then
				if motion and rec.PetsAnimate then
					G.stepZzz(entry)
				end
			else
				local prev = entry.Phase or 0
				local ph = prev + dt
				local dip, wig = 0, 0
				if rec.PetsAnimate then
					if ph >= K.DIP_START and ph < K.DIP_START + K.DIP_TIME then
						local s = sin((ph - K.DIP_START) / K.DIP_TIME * 2 * pi)
						dip = s * s
					elseif ph >= K.POP_AT and ph < K.POP_AT + K.WIGGLE_TIME then
						wig = 0.18 * sin((ph - K.POP_AT) / K.WIGGLE_TIME * pi * 4)
					end
					if prev < K.POP_AT and ph >= K.POP_AT then
						G.dropCoin(rec, slot, entry)
					end
				end
				if ph >= meal then
					ph = ph - meal
				end
				entry.Phase = ph
				if motion then
					G.pose(entry, dip, wig)
				end
			end
		end
	end
	if gd.HeapsDirty then
		G.syncHeaps(rec)
	end
	if gd.BowlsDirty then
		G.syncBowls(rec)
	end
	if motion and rec.PetsAnimate then
		for _, h in pairs(gd.Heaps) do
			if h.Spark then
				local cf = CFrame.new(h.Point + Vector3.new(0, h.Top + 0.45 + 0.12 * sin(clock * 2.5), 0)) * CFrame.Angles(0, clock * 2, 0)
				h.Spark[1].CFrame = cf
				h.Spark[2].CFrame = cf
			end
		end
	end
end

----------------------------------------------------------------------
-- the Training Place props: treadmill (Speed), dumbbell (Physique), orb (Ability), shield dummy (Defense)
----------------------------------------------------------------------
G.PROPS = {
	-- { name, size, local CFrame (mat frame, the pet looks at -Z), colour, material, moves? }
	Speed = {
		{ "Deck", Vector3.new(1.7, 0.2, 2.3), CFrame.new(0, 0.1, 0), Color3.fromRGB(78, 84, 104) },
		{ "Belt", Vector3.new(1.45, 0.06, 2.1), CFrame.new(0, 0.23, 0), Color3.fromRGB(40, 42, 54) },
		{ "Stripe", Vector3.new(1.45, 0.03, 0.18), CFrame.new(0, 0.27, 0), Color3.fromRGB(140, 148, 176), nil, "Belt" },
		{ "Stripe", Vector3.new(1.45, 0.03, 0.18), CFrame.new(0, 0.27, 0), Color3.fromRGB(140, 148, 176), nil, "Belt2" },
		{ "Post", Vector3.new(0.16, 1.1, 0.16), CFrame.new(-0.72, 0.75, -1.1), Color3.fromRGB(206, 212, 228) },
		{ "Post", Vector3.new(0.16, 1.1, 0.16), CFrame.new(0.72, 0.75, -1.1), Color3.fromRGB(206, 212, 228) },
		{ "Console", Vector3.new(1.6, 0.28, 0.34), CFrame.new(0, 1.36, -1.1), Color3.fromRGB(92, 152, 232) },
		{ "Screen", Vector3.new(0.62, 0.14, 0.04), CFrame.new(0, 1.39, -1.28), Color3.fromRGB(120, 255, 170), Enum.Material.Neon },
	},
	Physique = {
		{ "Bar", Vector3.new(1.9, 0.12, 0.12), CFrame.new(0, 0, 0), Color3.fromRGB(196, 202, 216), nil, "Lift" },
		{ "Grip", Vector3.new(0.5, 0.17, 0.17), CFrame.new(0, 0, 0), Color3.fromRGB(250, 214, 92), nil, "Lift" },
		{ "Plate", Vector3.new(0.16, 0.7, 0.7), CFrame.new(-0.6, 0, 0), Color3.fromRGB(62, 66, 84), nil, "Lift" },
		{ "Plate", Vector3.new(0.16, 0.7, 0.7), CFrame.new(0.6, 0, 0), Color3.fromRGB(62, 66, 84), nil, "Lift" },
		{ "Plate", Vector3.new(0.12, 0.5, 0.5), CFrame.new(-0.78, 0, 0), Color3.fromRGB(230, 84, 100), nil, "Lift" },
		{ "Plate", Vector3.new(0.12, 0.5, 0.5), CFrame.new(0.78, 0, 0), Color3.fromRGB(230, 84, 100), nil, "Lift" },
		{ "Rack", Vector3.new(0.5, 0.12, 0.5), CFrame.new(1.05, 0.06, 0.85), Color3.fromRGB(62, 66, 84) },
		{ "Rack", Vector3.new(0.38, 0.1, 0.38), CFrame.new(1.05, 0.17, 0.85), Color3.fromRGB(230, 84, 100) },
	},
	Ability = {
		{ "Rune", Vector3.new(2.0, 0.04, 0.14), CFrame.new(0, 0.03, 0) * CFrame.Angles(0, pi / 4, 0), Color3.fromRGB(176, 120, 255), Enum.Material.Neon },
		{ "Rune", Vector3.new(2.0, 0.04, 0.14), CFrame.new(0, 0.03, 0) * CFrame.Angles(0, -pi / 4, 0), Color3.fromRGB(176, 120, 255), Enum.Material.Neon },
		{ "Core", Vector3.new(0.5, 0.5, 0.5), CFrame.new(0, 0, 0), Color3.fromRGB(196, 126, 255), Enum.Material.Neon, "Orb" },
		{ "Shell", Vector3.new(0.82, 0.82, 0.82), CFrame.new(0, 0, 0), Color3.fromRGB(220, 196, 255), nil, "Shell" },
		{ "Spark", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, 0, 0), Color3.fromRGB(255, 232, 140), Enum.Material.Neon, "Spark1" },
		{ "Spark", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, 0, 0), Color3.fromRGB(255, 232, 140), Enum.Material.Neon, "Spark2" },
		{ "Spark", Vector3.new(0.14, 0.14, 0.14), CFrame.new(0, 0, 0), Color3.fromRGB(255, 232, 140), Enum.Material.Neon, "Spark3" },
	},
	Defense = {
		{ "Base", Vector3.new(0.8, 0.14, 0.8), CFrame.new(1.3, 0.07, 0), Color3.fromRGB(150, 104, 70) },
		{ "Post", Vector3.new(0.16, 0.9, 0.16), CFrame.new(1.3, 0.55, 0), Color3.fromRGB(120, 84, 56) },
		{ "Body", Vector3.new(0.45, 0.75, 0.66), CFrame.new(1.3, 1.25, 0), Color3.fromRGB(232, 198, 122), nil, "Wobble" },
		{ "Rope", Vector3.new(0.48, 0.1, 0.68), CFrame.new(1.3, 1.05, 0), Color3.fromRGB(150, 104, 70), nil, "Wobble" },
		{ "Head", Vector3.new(0.42, 0.42, 0.42), CFrame.new(1.3, 1.85, 0), Color3.fromRGB(242, 214, 142), nil, "Wobble" },
		{ "Shield", Vector3.new(0.1, 0.86, 0.76), CFrame.new(1.02, 1.25, 0), Color3.fromRGB(84, 142, 232), nil, "Wobble" },
		{ "Boss", Vector3.new(0.06, 0.3, 0.3), CFrame.new(0.95, 1.25, 0), COLORS.Gold, Enum.Material.Neon, "Wobble" },
	},
}

function G.takeProp(stat)
	local spec = G.PROPS[stat] or G.PROPS.Speed
	local list = G.propPool[stat]
	if list and #list > 0 then
		return table.remove(list)
	end
	local prop = { Stat = stat, Parts = {}, Local = {}, Move = {} }
	for i, row in ipairs(spec) do
		local p = G.part("Train" .. row[1], row[2], row[4], row[5])
		prop.Parts[i] = p
		prop.Local[i] = row[3]
		prop.Move[i] = row[6]
	end
	return prop
end

function G.giveProp(prop)
	for _, p in ipairs(prop.Parts) do
		p.Parent = nil
	end
	local list = G.propPool[prop.Stat]
	if not list then
		list = {}
		G.propPool[prop.Stat] = list
	end
	list[#list + 1] = prop
end

function G.attachProp(entry)
	local prop = G.takeProp(entry.Stat)
	entry.Prop = prop
	prop.Mat = entry.Att.WorldCFrame
	for i, p in ipairs(prop.Parts) do
		p.CFrame = prop.Mat * prop.Local[i]
		p.Parent = ensureFolder()
	end
	G.stepProp(entry, 0)
end

-- a training pet's motion and its prop's moving parts (20 Hz, only homes within K.PET_ANIM_NEAR)
function G.stepProp(entry, t)
	local prop = entry.Prop
	if not prop then
		return
	end
	local stat = prop.Stat
	local lift, push = 0, 0
	local mat = prop.Mat
	local hi = entry.Top or 1.6
	local orbY = hi * 0.75 + 0.35
	for i, p in ipairs(prop.Parts) do
		local mv = prop.Move[i]
		if mv then
			local cf
			if mv == "Belt" or mv == "Belt2" then
				local z = (((t * 1.6) + ((mv == "Belt2") and 0.5 or 0)) % 1 - 0.5) * 2.0
				cf = mat * CFrame.new(0, 0, z) * prop.Local[i]
			elseif mv == "Lift" then
				local c = 0.5 + 0.5 * sin(t * 3)
				cf = mat * CFrame.new(0, hi + 0.35 + 0.4 * c, 0.05) * prop.Local[i]
			elseif mv == "Orb" or mv == "Shell" then
				local spin = (mv == "Orb") and t * 1.6 or -t * 0.9
				cf = mat * CFrame.new(0.95, orbY + 0.12 * sin(t * 2), -0.25) * CFrame.Angles(spin * 0.6, spin, pi / 4)
			elseif string.sub(mv, 1, 5) == "Spark" then
				local k = tonumber(string.sub(mv, 6)) or 1
				local a = t * 2.4 + k * 2.094
				cf = mat * CFrame.new(0.95 + math.cos(a) * 0.62, orbY + 0.18 * sin(a * 1.5), -0.25 + sin(a) * 0.62)
			elseif mv == "Wobble" then
				local ph = (t % 1.4) / 1.4
				local w = 0
				if ph >= 0.18 then
					w = 0.28 * math.exp(-(ph - 0.18) * 5) * math.cos((ph - 0.18) * 24)
				end
				local pivot = CFrame.new(1.3, 0.6, 0)
				cf = mat * pivot * CFrame.Angles(0, 0, -w) * pivot:Inverse() * prop.Local[i]
			end
			if cf then
				p.CFrame = cf
			end
		end
	end
	if stat == "Speed" then
		lift = 0.07 * abs(sin(t * 9))
	elseif stat == "Physique" then
		lift = -0.05 * (0.5 + 0.5 * sin(t * 3))
	elseif stat == "Ability" then
		lift = 0.08 * sin(t * 1.8)
	elseif stat == "Defense" then
		local ph = (t % 1.4) / 1.4
		if ph < 0.18 then
			push = ph / 0.18 * 0.32
		elseif ph < 0.4 then
			push = 0.32 * (1 - (ph - 0.18) / 0.22)
		end
	end
	G.pose(entry, 0, 0, lift, push)
end

function G.stepTraining(rec)
	if not rec.PetsAnimate then
		return
	end
	local tr = rec.Train
	if clock < (tr.MotionAt or 0) then
		return
	end
	tr.MotionAt = clock + K.MOTION_STEP
	for slot, entry in pairs(rec.Pet.Training.Pets) do
		if entry.Prop and entry.Model.Parent then
			G.stepProp(entry, clock + slot * 0.37)
		end
	end
end

----------------------------------------------------------------------
-- plants, the Food Machine and the Coin Magnet
----------------------------------------------------------------------
-- every plant sends its fruit into a bowl every ~3 s; the Food Machine drops one from its chute onto the tray
function G.stepPlants(rec)
	if not rec.PetsNear then
		return
	end
	for i, st in ipairs(rec.Plants) do
		if clock >= (st.NextFruit or 0) then
			st.NextFruit = clock + K.FRUIT_EVERY + (G.noise(clock, i) - 0.5)
			local bowl = G.pickBowl(rec)
			local from = vecAttr(st.Model, "FruitPoint")
			if bowl and from and st.Model.Parent and not (st.Popping and not st.Popping.Done) then
				local c = st.Model:GetAttribute("FruitColor")
				local part = G.takeFruit(st.Model:GetAttribute("Fruit"), typeof(c) == "Color3" and c or nil)
				if part then
					local d = (bowl.Top - from).Magnitude
					G.fly(rec, part, from, bowl.Top, 0.9 + d / 32, 2.5 + d * 0.2, "fruit")
					G.stats.Fruit = G.stats.Fruit + 1
				end
			end
		end
	end
	local m = rec.Machine
	if m and m.Model.Parent and not (m.Popping and not m.Popping.Done) and clock >= (m.NextFruit or 0) then
		m.NextFruit = clock + K.MACHINE_EVERY
		local a, b = vecAttr(m.Model, "ChuteMouth"), vecAttr(m.Model, "Tray")
		if a and b then
			local part = G.takeFruit("Berry", G.foodColor(rec))
			if part then
				G.fly(rec, part, a, b + Vector3.new(0, 0.2, 0), 0.45, 0.4, "fruit")
			end
		end
	end
end

function G.addMagnet(rec, st)
	local head = st.Model:FindFirstChild("MagnetHead")
	local center = vecAttr(st.Model, "MagnetCenter")
	st.Parts, st.Local, st.Angle, st.Boost = {}, {}, 0, 0
	if head and center then
		local inv = CFrame.new(center):Inverse()
		for i, p in ipairs(collectParts(head)) do
			st.Parts[i] = p
			st.Local[i] = inv * p.CFrame
		end
		st.Center = center
	end
	rec.Magnet = st
end

-- the Coin Magnet's head turns (faster for a moment after a scoop)
function G.stepMagnet(rec, dt)
	local st = rec.Magnet
	if not st or not st.Center or #st.Parts == 0 or not st.Model.Parent then
		return
	end
	if st.Popping then
		if st.Popping.Done then
			st.Popping = nil
		else
			return
		end
	end
	local speed = K.MAGNET_SPIN * ((st.Boost > 0) and 3 or 1)
	st.Boost = max(0, st.Boost - dt)
	st.Angle = (st.Angle + dt * speed) % (2 * pi)
	local rot = CFrame.new(st.Center) * CFrame.Angles(0, st.Angle, 0)
	for i, p in ipairs(st.Parts) do
		if p.Parent then
			p.CFrame = rot * st.Local[i]
		end
	end
end

-- the owner's scoop ring: a faint circle of the Magnet's radius around the owner while they stand in the garden
function G.stepRing(rec)
	local show, root, frame = false, nil, nil
	if rec and rec.Near and rec.PetsNear then
		frame = G.frame(rec)
		root = G.localRoot()
		if frame and root then
			local lp = frame:PointToObjectSpace(root.Position)
			show = abs(lp.X) <= 12 and abs(lp.Z) <= 11 and lp.Y > -2 and lp.Y < 9
		end
	end
	if not show then
		if G.ringShown then
			for _, p in ipairs(G.ring) do
				p.Parent = nil
			end
			G.ringShown = false
		end
		return
	end
	if not G.ring then
		G.ring = {}
		for i = 1, K.RING_SEGMENTS do
			local p = G.part("ScoopRing", Vector3.new(1, 0.06, 0.16), COLORS.Ring, Enum.Material.Neon)
			p.Transparency = 0.55
			G.ring[i] = p
		end
	end
	local r = G.scoopRadius(rec)
	local y = frame:PointToWorldSpace(Vector3.new(0, G.HEAP_Y + 0.05, 0)).Y
	local c = root.Position
	local len = 2 * pi * r / K.RING_SEGMENTS * 0.8
	for i, p in ipairs(G.ring) do
		local a = (i - 0.5) / K.RING_SEGMENTS * 2 * pi
		if G.ringR ~= r then
			p.Size = Vector3.new(len, 0.06, 0.16)
		end
		p.CFrame = CFrame.new(c.X + math.cos(a) * r, y, c.Z + sin(a) * r) * CFrame.Angles(0, -a - pi / 2, 0)
		if not G.ringShown then
			p.Parent = ensureFolder()
		end
	end
	G.ringR = r
	G.ringShown = true
end

----------------------------------------------------------------------
-- the scoop: coins zip from the piles to the owner, a "+$1,234" label at the pile (never over the player's head)
----------------------------------------------------------------------
function G.zip(rec, slot, point, stage)
	local root = G.localRoot()
	if not root then
		return
	end
	local n = min(K.ZIP_COINS, 2 + (stage or 1))
	for i = 1, n do
		local part = G.takeCoin(i)
		if not part then
			break
		end
		local off = Vector3.new((G.noise(i, clock) - 0.5) * 0.8, 0.3 + i * 0.05, (G.noise(clock, i) - 0.5) * 0.8)
		G.fly(rec, part, point + off, root.Position, K.ZIP_TIME + i * 0.035, 1.2, "coin", root)
	end
	G.stats.Zips = G.stats.Zips + 1
	local gd = rec.Garden
	if not gd.ZipAt or clock - gd.ZipAt > K.LABEL_PAIR or (stage or 0) > (gd.ZipStage or 0) then
		gd.ZipPoint, gd.ZipStage = point, stage or 0
	end
	gd.ZipAt = clock
	if rec.Magnet then
		rec.Magnet.Boost = 1
	end
end

-- a scoop is the piles that vanished near the owner + the bank (CollectorCash) dropping + the owner's Cash rising,
-- all within K.LABEL_PAIR seconds (the attributes may arrive in any order): then the label shows the drop
function G.pairLabel(rec)
	local gd = rec.Garden
	if not (gd.ZipAt and gd.DropAt and (gd.Drop or 0) >= 1) then
		return
	end
	if clock - gd.ZipAt > K.LABEL_PAIR or clock - gd.DropAt > K.LABEL_PAIR then
		return
	end
	local cashKnown = localPlayer and localPlayer:GetAttribute(CASH_ATTR) ~= nil
	if cashKnown and not (G.gainAt and clock - G.gainAt <= K.LABEL_PAIR) then
		return
	end
	local text = "+" .. formatCash(gd.Drop)
	G.showLabel(gd.ZipPoint, text, "cash")
	G.stats.Labels = G.stats.Labels + 1
	G.stats.LastLabel, G.stats.LastLabelAt = text, gd.ZipPoint
	gd.DropAt, gd.Drop, gd.ZipAt, gd.ZipPoint, gd.ZipStage = nil, nil, nil, nil, nil
	G.gainAt = nil
end

function G.onPiles(rec)
	local gd = rec.Garden
	local old = gd.Piles
	gd.Piles = G.parsePiles(slotText(rec, "CoinPiles"))
	gd.HeapsDirty = true
	if localUid == 0 or homeOwner(rec) ~= localUid or not rec.PetsNear then
		return
	end
	local root = G.localRoot()
	if not root then
		return
	end
	local reach = G.scoopRadius(rec) + 2.5
	local any = false
	for slot, p in pairs(old) do
		local q = gd.Piles[slot]
		if not q or q.Stage < p.Stage then
			local h = gd.Heaps[slot]
			local pt = (h and h.Point) or G.pilePoint(rec, slot)
			if pt then
				local d = root.Position - pt
				if Vector3.new(d.X, 0, d.Z).Magnitude <= reach and abs(d.Y) <= 12 then
					G.zip(rec, slot, pt, p.Stage)
					any = true
				end
			end
		end
	end
	if any then
		G.pairLabel(rec)
	end
end

function G.onCash(rec)
	local gd = rec.Garden
	local v = tonumber(slotText(rec, "CollectorCash")) or 0
	if gd.Cash ~= nil and v < gd.Cash then
		gd.Drop = gd.Cash - v
		gd.DropAt = clock
		G.pairLabel(rec)
	end
	gd.Cash = v
end

function G.onLocalCash()
	local v = localPlayer and tonumber(localPlayer:GetAttribute(CASH_ATTR))
	if v and G.lastCash and v > G.lastCash then
		G.gainAt = clock
		local rec = G.ownRec()
		if rec then
			G.pairLabel(rec)
		end
	end
	G.lastCash = v
end

function G.newLabel()
	local anchor = G.part("ScoopLabel", Vector3.new(0.2, 0.2, 0.2), COLORS.Gold)
	anchor.Transparency = 1
	local gui = Instance.new("BillboardGui")
	gui.Name = "ScoopPop"
	gui.LightInfluence = 0
	gui.AlwaysOnTop = true
	gui.MaxDistance = 120
	gui.Size = UDim2.fromOffset(240, 44)
	gui.Parent = anchor
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.TextStrokeTransparency = 0
	text.TextStrokeColor3 = Color3.fromRGB(46, 30, 12)
	text.Parent = gui
	if Theme then
		text.Font = Theme.Fonts.Display
		Theme.TextOutline(text, 2, Color3.fromRGB(46, 30, 12), 0)
	end
	return { Anchor = anchor, Gui = gui, Text = text }
end

-- a pixel-sized label floating up from a pile: "+$1,234" (gold, 30 px at 1080p) or the visitor hint (20 px)
function G.showLabel(point, text, style)
	if not point then
		return
	end
	local lab = table.remove(G.labelPool)
	if not lab and #G.labels >= K.MAX_LABELS then
		lab = table.remove(G.labels, 1)
	end
	lab = lab or G.newLabel()
	local hint = style == "hint"
	local px = hint and 20 or 30
	local size = px
	if Theme and type(Theme.ScaledSize) == "function" then
		local ok, s = pcall(Theme.ScaledSize, px)
		if ok and type(s) == "number" then
			size = s
		end
	end
	lab.Text.Text = text
	lab.Text.TextSize = size
	lab.Text.TextColor3 = hint and Color3.fromRGB(255, 255, 255) or COLORS.Gold
	lab.Text.TextTransparency = 0
	lab.Gui.Size = UDim2.fromOffset(hint and floor(size * 0.56 * #text + 24) or floor(size * 0.62 * #text + 28), floor(size * 1.5))
	lab.Gui.Name = hint and "OwnerHint" or "ScoopPop"
	lab.From = point + Vector3.new(0, hint and 1.6 or 1.0, 0)
	lab.T = 0
	lab.Dur = hint and K.HINT_TIME or K.LABEL_TIME
	lab.Rise = hint and 0.3 or 1.6
	lab.Anchor.CFrame = CFrame.new(lab.From)
	lab.Anchor.Parent = ensureFolder()
	G.labels[#G.labels + 1] = lab
end

function G.stepLabels(dt)
	local i = 1
	while i <= #G.labels do
		local lab = G.labels[i]
		lab.T = lab.T + dt
		local q = lab.T / lab.Dur
		if q >= 1 then
			lab.Anchor.Parent = nil
			table.remove(G.labels, i)
			G.labelPool[#G.labelPool + 1] = lab
		else
			lab.Anchor.CFrame = CFrame.new(lab.From + Vector3.new(0, lab.Rise * q, 0))
			if q > 0.65 then
				lab.Text.TextTransparency = (q - 0.65) / 0.35
			end
			i = i + 1
		end
	end
end

-- the one-time visitor hint at another player's pile
function G.checkHint(rec, focus)
	if G.hinted or not focus or not rec.PetsNear or not G.dimmed(rec) then
		return
	end
	for _, h in pairs(rec.Garden.Heaps) do
		local d = h.Point - focus
		if Vector3.new(d.X, 0, d.Z).Magnitude <= K.HINT_NEAR and abs(d.Y) < 8 then
			G.hinted = true
			G.stats.Hint = "Only the owner can pick these up"
			G.showLabel(h.Point, G.stats.Hint, "hint")
			return
		end
	end
end

----------------------------------------------------------------------
-- pet cards (client/UI/PetCard): own garden pets level + XP (+ EVOLVE!), own training pets + the timer, other
-- players' garden pets level only; only pets within K.CARD_NEAR studs of the local player carry one
----------------------------------------------------------------------
function G.lazy(field, path)
	if G[field] == nil then
		G[field] = false
		local node = script.Parent
		for _, name in ipairs(path) do
			if name == ".." then
				node = node and node.Parent
			else
				node = node and node:FindFirstChild(name)
			end
		end
		if node then
			local ok, mod = pcall(require, node)
			if ok and type(mod) == "table" then
				G[field] = mod
			end
		end
	end
	return G[field] or nil
end

function G.openPets(key)
	local MC = G.lazy("Menu", { "MenuController" })
	if MC and type(MC.Open) == "function" then
		pcall(MC.Open, "Pets", { Tab = "Pets", Key = key, Action = "Evolve" })
	end
end

function G.cardInfo(rec, kind, slot, entry)
	local own = localUid ~= 0 and homeOwner(rec) == localUid
	local key = entry.Key
	local level, stage = 1, 0
	local info = (kind == "Garden") and rec.Garden.Info[slot] or nil
	if info then
		level, stage = info.Level, info.Stage
	end
	if not own then
		if not info then
			return nil
		end
		return "Other", level, stage
	end
	local S = G.lazy("State", { "..", "State" })
	local xp = nil
	if S and type(S.Get) == "function" then
		local okG, data = pcall(S.Get)
		if okG and type(data) == "table" and type(data.PetLevels) == "table" and data.PetLevels[key] then
			local okL, l, x = pcall(S.PetLevel, key)
			if okL then
				level, xp = tonumber(l) or level, tonumber(x) or 0
			end
		end
		local okE, growth = pcall(S.PetGrowth, key)
		if okE and type(growth) == "table" and tonumber(growth.Evo) and growth.Evo > stage then
			stage = growth.Evo
		end
	end
	local def = petDefOf(key)
	local frac = 0
	local cap = nil
	if def and PetCatalog and type(PetCatalog.LevelCap) == "function" then
		local ok, c = pcall(PetCatalog.LevelCap, def)
		cap = ok and tonumber(c) or nil
	end
	local need = nil
	if TycoonCatalog and type(TycoonCatalog.XpToNext) == "function" then
		local ok, n = pcall(TycoonCatalog.XpToNext, level)
		need = ok and tonumber(n) or nil
	end
	if cap and level >= cap then
		frac = 1
	elseif xp and need and need > 0 then
		frac = clamp01(xp / need)
	end
	local ready = false
	if def and PetCatalog and type(PetCatalog.CanEvolve) == "function" then
		local ok, nxt = pcall(PetCatalog.CanEvolve, def, level, stage)
		ready = ok and nxt ~= nil
	end
	if kind == "Training" then
		local job = rec.Train.Jobs[slot]
		local left = job and max(0, (job.Ends or 0) - serverNow()) or 0
		local rank = 1
		if S and type(S.PetGrowth) == "function" then
			local ok, growth = pcall(S.PetGrowth, key)
			if ok and type(growth) == "table" and type(growth.Job) == "table" then
				rank = tonumber(growth.Job.Rank) or 1
			end
		end
		local total = 60 * max(1, rank)
		if TycoonCatalog and type(TycoonCatalog.TrainSeconds) == "function" then
			local ok, s = pcall(TycoonCatalog.TrainSeconds, rank)
			if ok and tonumber(s) and s > 0 then
				total = s
			end
		end
		total = max(total, left)
		local whole = floor(left + 0.999)
		local text = string.format("%d:%02d", floor(whole / 60), whole % 60)
		return "Training", level, stage, frac, ready, clamp01(1 - left / max(1, total)), text
	end
	return "Garden", level, stage, frac, ready
end

function G.updateCard(rec, kind, slot, entry)
	local PC = G.lazy("PetCard", { "..", "UI", "PetCard" })
	if not PC or type(PC.New) ~= "function" then
		return false
	end
	local mode, level, stage, xp, ready, tfrac, ttext = G.cardInfo(rec, kind, slot, entry)
	if not mode then
		return false
	end
	local adornee = entry.Model.PrimaryPart or entry.Model:FindFirstChildWhichIsA("BasePart")
	if not adornee then
		return false
	end
	local card = entry.Card
	if card and card.mode ~= mode then
		pcall(card.SetMode, card, mode)
	end
	if not card then
		local key = entry.Key
		local ok, c = pcall(PC.New, adornee, mode, (entry.Hi or 1.6) * 0.6 + 0.9, {
			Name = "HomePetCard",
			OnEvolve = function()
				G.openPets(key)
			end,
		})
		if not ok or type(c) ~= "table" then
			return false
		end
		card = c
		entry.Card = c
	end
	pcall(card.SetLevel, card, level, stage, ready)
	if xp then
		pcall(card.SetXp, card, xp)
	end
	if tfrac then
		pcall(card.SetTimer, card, tfrac, ttext)
	end
	return true
end

function G.stepCards()
	if clock < G.nextCards then
		return
	end
	G.nextCards = clock + K.CARD_CHECK
	local focus = focusPos()
	local count = 0
	for _, rec in ipairs(homeList) do
		for kind, pk in pairs(rec.Pet) do
			for slot, entry in pairs(pk.Pets) do
				local want = false
				if focus and rec.PetsNear and entry.Model.Parent then
					local d = (entry.Seat.Position - focus).Magnitude
					want = d <= (entry.Card and (K.CARD_NEAR + 6) or K.CARD_NEAR)
				end
				if want and not G.updateCard(rec, kind, slot, entry) then
					want = false
				end
				if not want and entry.Card then
					pcall(entry.Card.Destroy, entry.Card)
					entry.Card = nil
				end
				if entry.Card then
					count = count + 1
				end
			end
		end
		G.checkHint(rec, focus)
	end
	G.cardCount = count
end

-- one home's garden / training state (attributes changed)
function G.onInfo(rec)
	rec.Garden.Info = G.parseInfo(slotText(rec, "GardenInfo"))
	rec.Pet.Garden.Dirty = true
	G.nextCards = 0
end

function G.onOpen(rec)
	local open = G.openCount(rec)
	if open ~= rec.Garden.Open then
		rec.Garden.Open = open
		rec.Garden.BowlsDirty = true
	end
end

-- everything client-made of one home goes away (frozen, far, removed)
function G.clearHome(rec)
	G.recycle(rec)
	local gd = rec.Garden
	for slot in pairs(gd.Heaps) do
		G.dropHeap(gd, slot)
	end
	for slot, b in pairs(gd.Bowls) do
		G.giveBowl(b)
		gd.Bowls[slot] = nil
	end
	gd.HeapsDirty = true
	gd.BowlsDirty = true
end

function G.stepHome(rec, dt)
	G.stepGarden(rec, dt)
	G.stepTraining(rec)
	G.stepPlants(rec)
	if rec.PetsAnimate then
		G.stepMagnet(rec, dt)
	end
end

----------------------------------------------------------------------
-- Stations
----------------------------------------------------------------------
local function stepSwirl(sw, dt)
	if sw.Popping then
		if sw.Popping.Done then
			sw.Popping = nil
		else
			return
		end
	end
	sw.Angle = (sw.Angle + dt * K.SWIRL_SPEED) % (2 * pi)
	local c = sw.Center
	local rot = CFrame.new(c.X, c.Y + sin(sw.Angle * 1.5) * K.SWIRL_BOB, c.Z) * CFrame.Angles(0, sw.Angle, 0)
	for i, p in ipairs(sw.Parts) do
		if p.Parent then
			p.CFrame = rot * sw.Local[i]
		end
	end
	sw.Wave = sw.Wave + dt * K.GLOW_RATE
	local swing = (0.5 + 0.5 * sin(sw.Wave)) * K.GLOW_SWING
	for i, p in ipairs(sw.Glows) do
		if p.Parent then
			p.Transparency = min(0.95, sw.GlowBase[i] + swing)
		end
	end
end

-- the station kind (HomeBuilder writes Kind; older builds only the id)
local STATION_KINDS = { Collector = "Magnet", Kitchen = "FoodMachine", Gym = "Training", Garden = "Garden", FusionMachine = "Fusion" }

local function registerStation(rec, model)
	if rec.Stations[model] then
		return rec.Stations[model]
	end
	local id = tostring(model:GetAttribute("StationId") or string.sub(model.Name, 9))
	local kind = model:GetAttribute("Kind")
	if kind == nil or kind == "Gym" then
		kind = STATION_KINDS[id] or ((string.sub(id, 1, 5) == "Press") and "Plant" or kind)
	end
	local st = { Model = model, Id = id, Kind = kind, Level = numAttr(model, "Level", 1) }
	rec.Stations[model] = st
	if kind == "Plant" then
		rec.Plants[#rec.Plants + 1] = st
		rec.Garden.BowlsDirty = true -- the food colour
	elseif kind == "Magnet" then
		G.addMagnet(rec, st)
	elseif kind == "FoodMachine" then
		rec.Machine = st
	elseif PET_STATIONS[kind] then
		local pk = rec.Pet[kind]
		pk.Station = st
		pk.Dirty = true
		if kind == "Garden" then
			rec.Garden.FrameModel = nil
			rec.Garden.HeapsDirty = true
			rec.Garden.BowlsDirty = true
			G.onOpen(rec)
		end
	elseif kind == "Fusion" then
		local swirl = model:FindFirstChild("Swirl")
		local center = vecAttr(model, "SwirlCenter")
		if swirl and center then
			local parts = collectParts(swirl)
			local loc = {}
			local base = CFrame.new(center)
			for i, p in ipairs(parts) do
				loc[i] = base:Inverse() * p.CFrame
			end
			st.Parts, st.Local, st.Center, st.Angle, st.Wave = parts, loc, center, 0, 0
			st.Glows, st.GlowBase = {}, {}
			for _, p in ipairs(collectParts(model)) do
				if p.Name == "Glow" and p.Material == Enum.Material.Neon then
					st.Glows[#st.Glows + 1] = p
					st.GlowBase[#st.GlowBase + 1] = p.Transparency
				end
			end
			rec.Swirls[#rec.Swirls + 1] = st
		end
	end
	return st
end

local function removeFrom(list, item)
	for i = #list, 1, -1 do
		if list[i] == item then
			table.remove(list, i)
		end
	end
end

local function unregisterStation(rec, model)
	local st = rec.Stations[model]
	if not st then
		return
	end
	rec.Stations[model] = nil
	removeFrom(rec.Swirls, st)
	removeFrom(rec.Plants, st)
	if rec.Magnet == st then
		rec.Magnet = nil
	end
	if rec.Machine == st then
		rec.Machine = nil
	end
	for kind, pk in pairs(rec.Pet) do
		if pk.Station == st then
			pk.Station = nil
			pk.Dirty = true
			if kind == "Garden" then
				rec.Garden.HeapsDirty = true
				rec.Garden.BowlsDirty = true
			end
		end
	end
end

----------------------------------------------------------------------
-- Homes
----------------------------------------------------------------------
local function isNew(rec, inst)
	local built = tonumber(inst:GetAttribute("BuiltAt"))
	if built then
		return serverNow() - built < K.POP_WINDOW
	end
	return clock - rec.Found > K.POP_LIVE_AFTER
end

local function onDescendant(rec, d)
	if d:IsA("ProximityPrompt") then
		if d.Name ~= "ClaimPrompt" then
			trackPrompt(d, rec)
		end
	elseif d:IsA("BillboardGui") and d.Name == "PadSign" then
		signs[d] = rec
		applySign(d)
		local pad = ancestorWith(d.Parent, "StationId", rec.Folder)
		local entry = pad and rec.Pads[pad]
		if entry then
			entry.PriceLabel = nil
			refreshPad(rec, entry)
		end
	end
end

local function onHomeChild(rec, child, live)
	local name = child.Name
	if string.sub(name, 1, 8) == "Station_" and child:IsA("Model") then
		local st = registerStation(rec, child)
		if live and isNew(rec, child) then
			st.Popping = startPop(child, rec)
		end
	elseif name == "Pads" then
		rec.PadFolder = child
		for _, pad in ipairs(child:GetChildren()) do
			if pad:IsA("Model") then
				registerPad(rec, pad)
			end
		end
		rec.Conns[#rec.Conns + 1] = child.ChildAdded:Connect(function(pad)
			if pad:IsA("Model") then
				registerPad(rec, pad)
				if isNew(rec, pad) and rec.Pads[pad] then
					rec.Pads[pad].Popping = startPop(pad, rec)
				end
			end
		end)
		rec.Conns[#rec.Conns + 1] = child.ChildRemoved:Connect(function(pad)
			rec.Pads[pad] = nil
		end)
	end
end

local function plotCenter(folder)
	local cf = folder:GetAttribute("PlotCFrame")
	if typeof(cf) == "CFrame" then
		return cf.Position
	end
	local v = folder:GetAttribute("PlotCenter")
	if typeof(v) == "Vector3" then
		return v
	end
	return nil
end

-- the plot attributes HomeFx follows (on the plot folder, also read on the Home folder): what each one changes
local HOME_ATTRS = {
	GardenPets = function(rec)
		rec.Pet.Garden.Dirty = true
	end,
	TrainingPets = function(rec)
		rec.Pet.Training.Dirty = true
		G.nextCards = 0
	end,
	GardenInfo = function(rec)
		G.onInfo(rec)
	end,
	GardenSlots = function(rec)
		G.onOpen(rec)
	end,
	CoinPiles = function(rec)
		G.onPiles(rec)
	end,
	CollectorCash = function(rec)
		G.onCash(rec)
	end,
}

local function addHome(folder)
	if homes[folder] or not folder:IsA("Folder") and not folder:IsA("Model") then
		return
	end
	local rec = {
		Folder = folder,
		Found = clock,
		Center = plotCenter(folder),
		Near = false,
		NextNear = 0,
		Stations = {},
		Swirls = {},
		Plants = {},
		Magnet = nil,
		Machine = nil,
		Pads = {},
		Conns = {},
		SignMemo = {}, -- [StationId] = the layout's last answer for that pad's sign (a rebuilt sign starts with it)
		Pet = { -- by station Kind: { Station = record | nil, Pets = { [slot] = entry }, Dirty }
			Garden = { Station = nil, Pets = {}, Dirty = false },
			Training = { Station = nil, Pets = {}, Dirty = false },
		},
		-- CoinPiles / GardenInfo parsed, the client heaps / bowls, the scoop pairing (see "Garden")
		Garden = { Piles = {}, Info = {}, Heaps = {}, Bowls = {}, Open = 3, HeapsDirty = true, BowlsDirty = true },
		Train = { Jobs = {} },
		PetsNear = false,
		PetsAnimate = false,
	}
	homes[folder] = rec
	homeList[#homeList + 1] = rec
	rec.Garden.Piles = G.parsePiles(slotText(rec, "CoinPiles"))
	rec.Garden.Info = G.parseInfo(slotText(rec, "GardenInfo"))
	rec.Garden.Cash = tonumber(slotText(rec, "CollectorCash"))
	for _, child in ipairs(folder:GetChildren()) do
		onHomeChild(rec, child, false)
	end
	for _, d in ipairs(folder:GetDescendants()) do
		onDescendant(rec, d)
	end
	G.onOpen(rec)
	rec.Conns[#rec.Conns + 1] = folder.ChildAdded:Connect(function(child)
		onHomeChild(rec, child, true)
	end)
	rec.Conns[#rec.Conns + 1] = folder.ChildRemoved:Connect(function(child)
		if rec.Stations[child] then
			cancelPopOf(child)
			unregisterStation(rec, child)
		end
	end)
	rec.Conns[#rec.Conns + 1] = folder.DescendantAdded:Connect(function(d)
		onDescendant(rec, d)
	end)
	rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal("OwnerUserId"):Connect(function()
		refreshHome(rec)
		for _, pad in pairs(rec.Pads) do
			refreshPad(rec, pad)
		end
		refreshOwnership()
		-- the owner changed: the heaps' look (dimmed or not), the evolved forms and the cards follow
		rec.Garden.HeapsDirty = true
		rec.Pet.Garden.Dirty = true
		G.nextCards = 0
	end)
	rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal("PlotCFrame"):Connect(function()
		rec.Center = plotCenter(folder)
	end)
	-- the plot folder's (TycoonService / PetCareService) attributes; the gate (a sibling of the Home folder): its
	-- Claim Home prompt
	local spot = folder.Parent
	for attr, fn in pairs(HOME_ATTRS) do
		local function changed()
			local ok, err = pcall(fn, rec)
			if not ok and not frameWarned then
				frameWarned = true
				warn("[HomeFx] " .. attr .. ": " .. tostring(err))
			end
		end
		rec.Conns[#rec.Conns + 1] = folder:GetAttributeChangedSignal(attr):Connect(changed)
		if spot then
			rec.Conns[#rec.Conns + 1] = spot:GetAttributeChangedSignal(attr):Connect(changed)
		end
	end
	if spot then
		for _, d in ipairs(spot:GetDescendants()) do
			if d:IsA("ProximityPrompt") and d.Name == "ClaimPrompt" then
				trackPrompt(d, rec)
			end
		end
		rec.Conns[#rec.Conns + 1] = spot.DescendantAdded:Connect(function(d)
			if d:IsA("ProximityPrompt") and d.Name == "ClaimPrompt" then
				trackPrompt(d, rec)
			end
		end)
	end
	refreshOwnership()
	refreshHome(rec)
end

local function resetHome(rec)
	clearPets(rec)
	G.clearHome(rec)
end

local function removeHome(folder)
	local rec = homes[folder]
	if not rec then
		return
	end
	homes[folder] = nil
	removeFrom(homeList, rec)
	for _, c in ipairs(rec.Conns) do
		c:Disconnect()
	end
	rec.Conns = {}
	for model in pairs(rec.Stations) do
		cancelPopOf(model)
	end
	resetHome(rec)
	for prompt, state in pairs(overrides) do
		if state.Home == rec then
			overrides[prompt] = nil
		end
	end
	for gui, r in pairs(signs) do
		if r == rec then
			signs[gui] = nil
		end
	end
	refreshOwnership()
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function updateNear(rec, eye)
	if clock < rec.NextNear then
		return
	end
	rec.NextNear = clock + K.NEAR_CHECK
	if not rec.Center then
		rec.Center = plotCenter(rec.Folder)
		if not rec.Center then
			for model in pairs(rec.Stations) do
				local ok, pivot = pcall(function()
					return model:GetPivot()
				end)
				if ok and pivot then
					rec.Center = pivot.Position
					break
				end
			end
		end
	end
	local dist = (rec.Center ~= nil and eye ~= nil) and (rec.Center - eye).Magnitude or 0
	local near = rec.Center ~= nil and dist <= K.NEAR
	local petsNear = near and dist <= (rec.PetsNear and (K.PET_NEAR + 20) or K.PET_NEAR)
	rec.PetsAnimate = petsNear and dist <= K.PET_ANIM_NEAR
	if petsNear ~= rec.PetsNear then
		rec.PetsNear = petsNear
		for _, pk in pairs(rec.Pet) do
			pk.Dirty = true
		end
		rec.Garden.HeapsDirty = true
		rec.Garden.BowlsDirty = true
		if not petsNear then
			G.recycle(rec)
		end
	end
	if near ~= rec.Near then
		rec.Near = near
		if not near then
			resetHome(rec)
		end
	end
end

local function step(dt)
	dt = min(tonumber(dt) or 0, 0.1)
	clock = clock + dt
	petFrameBuilds, petFramePlaced = 0, 0
	G.heapFrame = 0
	if #pops > 0 then
		stepPops()
	end
	local eye = cameraPos()
	stepSigns()
	for _, rec in ipairs(homeList) do
		if rec.Folder.Parent then
			updateNear(rec, eye)
			if rec.Near then
				for _, sw in ipairs(rec.Swirls) do
					stepSwirl(sw, dt)
				end
				stepPads(rec, dt)
				stepPetStations(rec)
				G.stepHome(rec, dt)
			elseif anyPetsDirty(rec) then
				syncAllPets(rec)
				G.syncHeaps(rec)
				G.syncBowls(rec)
			end
		end
	end
	if #G.flying > 0 then
		G.stepFlying(dt)
	end
	if #G.labels > 0 then
		G.stepLabels(dt)
	end
	G.stepRing(G.ownRec())
	G.stepCards()
end

local function safeStep(dt)
	local ok, err = pcall(step, dt)
	if not ok and not frameWarned then
		frameWarned = true
		warn("[HomeFx] frame error: " .. tostring(err))
	end
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function HomeFx.Count()
	return #homeList
end

function HomeFx.Stats()
	local stations, near, hidden, hiddenSigns, pets, trainPets = 0, 0, 0, 0, 0, 0
	local heaps, heapParts, bowls, props, sleeping, plants = 0, 0, 0, 0, 0, 0
	for _, rec in ipairs(homeList) do
		for _, entry in pairs(rec.Pet.Garden.Pets) do
			pets = pets + 1
			if entry.Sleep then
				sleeping = sleeping + 1
			end
		end
		for _, entry in pairs(rec.Pet.Training.Pets) do
			trainPets = trainPets + 1
			if entry.Prop then
				props = props + 1
			end
		end
		for _ in pairs(rec.Stations) do
			stations = stations + 1
		end
		for _, h in pairs(rec.Garden.Heaps) do
			heaps = heaps + 1
			heapParts = heapParts + #h.Model:GetChildren() + (h.Spark and 2 or 0)
		end
		for _ in pairs(rec.Garden.Bowls) do
			bowls = bowls + 1
		end
		plants = plants + #rec.Plants
		if rec.Near then
			near = near + 1
		end
	end
	for prompt, state in pairs(overrides) do
		if state.Hidden and prompt.Parent then
			hidden = hidden + 1
		end
	end
	local shownSigns, crowded, underHud, away = 0, 0, 0, 0
	for gui in pairs(signs) do
		if gui.Parent then
			if not gui.Enabled then
				hiddenSigns = hiddenSigns + 1
			end
			local why = signState[gui]
			if why == "Shown" then
				shownSigns = shownSigns + 1
			elseif why == "Crowded" then
				crowded = crowded + 1
				if signUnderHud[gui] then
					underHud = underHud + 1
				end
			elseif why == "Away" then
				away = away + 1
			end
		end
	end
	return {
		Homes = #homeList,
		Near = near,
		Stations = stations,
		Plants = plants,
		Pops = #pops,
		HiddenPrompts = hidden,
		HiddenSigns = hiddenSigns,
		SignsShown = shownSigns,
		SignsCrowded = crowded,
		SignsUnderHud = underHud,
		SignsAway = away,
		GardenPets = pets,
		TrainingPets = trainPets,
		GymPets = trainPets, -- the Phase 3 name of TrainingPets
		Sleeping = sleeping,
		Props = props,
		Heaps = heaps,
		HeapParts = heapParts,
		HeapsMade = G.heapsMade,
		Bowls = bowls,
		Coins = G.coinsAlive, -- flying coins now (pool cap K.MAX_COINS)
		CoinPool = G.coinsMade, -- coin parts ever made
		Fruit = G.fruitAlive,
		FruitPool = G.fruitMade,
		FruitFlights = G.stats.Fruit,
		Drops = G.stats.Drops,
		Zips = G.stats.Zips,
		Labels = G.stats.Labels,
		LastLabel = G.stats.LastLabel,
		LastLabelAt = G.stats.LastLabelAt,
		Hint = G.stats.Hint,
		Ring = G.ringShown,
		Cards = G.cardCount,
		PetBuilds = petStats.Builds,
		PetColdBuilds = petStats.Cold,
		PetPoolHits = petStats.PoolHits,
		PetPool = #petPool,
		PetFrameMost = petStats.FrameMost,
	}
end

-- one home's client garden (tests / debugging): heaps by pile, bowls, pets and their poses, training pets + props
function HomeFx.Garden(folder)
	local rec = typeof(folder) == "Instance" and (homes[folder] or homes[folder:FindFirstChild("Home") or folder]) or nil
	if not rec then
		return nil
	end
	local out = { Heaps = {}, Bowls = {}, Pets = {}, Training = {}, Open = rec.Garden.Open, Dim = G.dimmed(rec), Radius = G.scoopRadius(rec) }
	for slot, h in pairs(rec.Garden.Heaps) do
		out.Heaps[slot] = { Model = h.Model, Point = h.Point, Stage = h.Stage, Dim = h.Dim, Lucky = h.Spark ~= nil, Parts = #h.Model:GetChildren() }
	end
	for slot, b in pairs(rec.Garden.Bowls) do
		out.Bowls[slot] = { Dish = b.Dish, Food = b.Food }
	end
	for slot, e in pairs(rec.Pet.Garden.Pets) do
		out.Pets[slot] = { Key = e.Key, Model = e.Model, Sleep = e.Sleep == true, Zzz = e.Zzz and e.Zzz.Parts or nil, Card = e.Card, Stage = e.Stage, Seat = e.Seat }
	end
	for slot, e in pairs(rec.Pet.Training.Pets) do
		out.Training[slot] = { Key = e.Key, Model = e.Model, Stat = e.Stat, Prop = e.Prop and e.Prop.Parts or nil, Card = e.Card, Seat = e.Seat }
	end
	return out
end

-- why a pad sign shows or not: "Shown"; hidden: "Crowded" (no room on the screen: another sign or the HUD is there;
-- Stats().SignsUnderHud counts the HUD ones), "Away" (behind the camera, off the screen or past its MaxDistance),
-- "Pending" (not laid out yet), "Locked" (a locked pad far away), "Other" (not the local player's pad); nil for
-- anything HomeFx does not track
function HomeFx.SignState(gui)
	if typeof(gui) ~= "Instance" or not signs[gui] then
		return nil
	end
	return signState[gui]
end

function HomeFx.Init()
	if initialized then
		return
	end
	initialized = true
	localPlayer = localPlayer or Players.LocalPlayer
	localUid = localPlayer and localPlayer.UserId or 0
	CollectionService:GetInstanceAddedSignal(HOME_TAG):Connect(function(folder)
		local ok, err = pcall(addHome, folder)
		if not ok then
			warn("[HomeFx] could not track a home: " .. tostring(err))
		end
	end)
	CollectionService:GetInstanceRemovedSignal(HOME_TAG):Connect(removeHome)
	for _, folder in ipairs(CollectionService:GetTagged(HOME_TAG)) do
		local ok, err = pcall(addHome, folder)
		if not ok then
			warn("[HomeFx] could not track a home: " .. tostring(err))
		end
	end
	if localPlayer then
		G.lastCash = tonumber(localPlayer:GetAttribute(CASH_ATTR))
		localPlayer:GetAttributeChangedSignal(CASH_ATTR):Connect(function()
			for _, rec in ipairs(homeList) do
				if homeOwner(rec) == localUid then
					for _, pad in pairs(rec.Pads) do
						refreshPad(rec, pad)
					end
				end
			end
			G.onLocalCash()
		end)
	end
	-- own pets' levels / XP / evolutions: the cards (and an evolved garden pet's form) follow State
	task.spawn(function()
		local S = G.lazy("State", { "..", "State" })
		if S and S.Changed and type(S.Changed.Connect) == "function" then
			S.Changed:Connect(function()
				G.nextCards = 0
				local rec = G.ownRec()
				if rec then
					rec.Pet.Garden.Dirty = true
				end
			end)
		end
	end)
	loopConn = RunService.RenderStepped:Connect(safeStep)
end

return HomeFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">HomePortalFx</string>
              <string name="Source"><![CDATA[-- HomePortalFx (client, Phase 4): the home portal and the arrival ring (ARCHITECTURE_V3.md "Phase 4 build contract"
-- 3.10 / 6). Zero server parts: TycoonService only writes two player attributes, this client draws them.
--
--   HomePortalFx.Init()
--   HomePortalFx.Stop()            disconnects everything and removes every part it made
--   HomePortalFx.Stats() -> { Portals, Parts, Shown, Faded, Closing, Rings, RingParts, Opened, Arrivals }
--   HomePortalFx.Portal(player) -> { Model, Center, Yaw, ClosesAt, Faded, Closing, Name } | nil   (tests / debugging)
--
-- * Config.Attr.HomePortal on a player = "x,y,z,yaw,closesAt" while their portal is open (x, y, z: the point on the
--   floor; yaw in degrees, CFrame.Angles(0, rad(yaw), 0).LookVector = the owner's facing when they opened it;
--   closesAt: workspace:GetServerTimeNow() when it closes, 10 s after opening). Every player's portal is drawn while it
--   is within K.DRAW_RANGE studs of the camera: a standing voxel ring (<= 30 parts) in the player's colour facing back
--   toward the owner, a swirl that turns inside it, a glowing surface, sparkles, and a 22 px name tag
--   "Alex's portal" (pixel-sized BillboardGui with a stroke and a backing plate, World text rule). Other players'
--   portals are faded (only the owner and their pets can go through). It grows in when it opens and shrinks away when
--   the attribute is cleared (used) or closesAt passes (expired).
-- * Config.Attr.PortalArrived = server time of the last arrival: the arrival ring (<= 20 parts: a flat ring that
--   widens and fades around the player's feet + rising sparks) plays for 1.5 s where that player stands now.
-- * The followers' dive into the portal is PetController's (it reads HomePortal itself).
-- Cheap: one RenderStepped connection, per-frame writes only for portals near the camera (the swirl, grow / shrink)
-- and live arrival rings; parts are pooled per portal and never collide, query or touch. Plain Lua 5.1 syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local okTheme, Theme = pcall(function()
	return require(Shared:WaitForChild("Theme"))
end)
if not okTheme or type(Theme) ~= "table" then
	Theme = nil
end

local HomePortalFx = {}

local ATTR = Config.Attr or {}
local PORTAL_ATTR = ATTR.HomePortal or "HomePortal"
local ARRIVED_ATTR = ATTR.PortalArrived or "PortalArrived"

local K = {
	DRAW_RANGE = 150, -- studs from the camera: portals farther away are not drawn
	RING_RADIUS = 2.6, -- studs: the ring's middle line
	RING_BLOCKS = 20, -- voxel blocks around the ring
	CENTER_Y = 3.0, -- the ring's centre above the floor point
	OPEN_TIME = 0.35, -- grow in
	CLOSE_TIME = 0.4, -- shrink away
	SWIRL_SPEED = 2.4, -- radians per second
	FADED = 0.55, -- extra transparency of other players' portals
	ARRIVAL_TIME = 1.5,
	ARRIVAL_BLOCKS = 14,
	ARRIVAL_SPARKS = 6,
	MAX_ARRIVALS = 4,
	NAME_PX = 22, -- the name tag at 1080p
}

-- the players' portal colours (by UserId): bright, never the gold of the coins
local PALETTE = {
	Color3.fromRGB(120, 196, 255),
	Color3.fromRGB(186, 128, 255),
	Color3.fromRGB(255, 136, 196),
	Color3.fromRGB(110, 226, 170),
	Color3.fromRGB(255, 170, 92),
	Color3.fromRGB(96, 214, 236),
}
local GOLD = Color3.fromRGB(255, 214, 92)
local INK = Color3.fromRGB(26, 30, 52)

local localPlayer = Players.LocalPlayer
local portals = {} -- [player] = record
local arrivals = {} -- live arrival rings
local conns = {} -- global connections
local playerConns = {} -- [player] = { connections }
local folder = nil
local loopConn = nil
local initialized = false
local warned = false
local stats = { Opened = 0, Arrivals = 0 }
local clock = 0

local P = {} -- helpers (one table keeps the locals few)

function P.serverNow()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.clock()
end

function P.ensureFolder()
	if folder and folder.Parent then
		return folder
	end
	local f = Workspace:FindFirstChild("HomePortalFx")
	if not f then
		f = Instance.new("Folder")
		f.Name = "HomePortalFx"
		f.Parent = Workspace
	end
	folder = f
	return f
end

function P.part(name, size, color, material, transparency)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.SmoothPlastic
	p.Size = size
	p.Color = color
	p.Transparency = transparency or 0
	return p
end

function P.lighten(c, t)
	return Color3.new(c.R + (1 - c.R) * t, c.G + (1 - c.G) * t, c.B + (1 - c.B) * t)
end

function P.darken(c, t)
	return Color3.new(c.R * (1 - t), c.G * (1 - t), c.B * (1 - t))
end

function P.colorOf(player)
	local uid = tonumber(player and player.UserId) or 0
	return PALETTE[(math.abs(math.floor(uid)) % #PALETTE) + 1]
end

-- "x,y,z,yaw,closesAt" -> point (Vector3), yaw (degrees), closesAt; nil for junk
function P.parse(text)
	if type(text) ~= "string" then
		return nil
	end
	local vals = {}
	for item in string.gmatch(text, "[^,]+") do
		local n = tonumber(item)
		if n == nil or n ~= n or n == math.huge or n == -math.huge then
			return nil
		end
		vals[#vals + 1] = n
	end
	if #vals < 5 then
		return nil
	end
	return Vector3.new(vals[1], vals[2], vals[3]), vals[4], vals[5]
end

function P.cameraPos()
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

----------------------------------------------------------------------
-- The portal model: <= 30 parts, local layout around the ring centre (the portal faces -Z of its frame)
----------------------------------------------------------------------
function P.build(rec)
	local color = rec.Color
	local model = Instance.new("Model")
	model.Name = "HomePortal"
	local items = {} -- { Part, Local (CFrame), Size (Vector3), Trans, Kind }
	local function add(name, size, cf, c, material, trans, kind)
		local p = P.part(name, size, c, material, trans)
		p.Parent = model
		items[#items + 1] = { Part = p, Local = cf, Size = size, Trans = trans or 0, Kind = kind }
		return p
	end
	local r = K.RING_RADIUS
	local seg = 2 * math.pi * r / K.RING_BLOCKS
	for i = 1, K.RING_BLOCKS do
		local a = (i - 0.5) / K.RING_BLOCKS * 2 * math.pi
		local shade = (i % 2 == 0) and P.lighten(color, 0.25) or color
		if i % 5 == 0 then
			shade = GOLD
		end
		-- each block sits on the circle, its long side along the ring (a voxel ring with stepped edges)
		add("Ring", Vector3.new(seg * 1.08, 0.55, 0.6), CFrame.Angles(0, 0, a) * CFrame.new(0, r, 0), shade, Enum.Material.SmoothPlastic, 0, "Ring")
	end
	-- the glowing surface inside (two crossed squares read as a round disc) and the swirl arms that turn
	add("Surface", Vector3.new(r * 1.27, r * 1.27, 0.08), CFrame.Angles(0, 0, math.pi / 4), P.darken(color, 0.1), Enum.Material.Neon, 0.3, "Surface")
	add("Surface", Vector3.new(r * 1.27, r * 1.27, 0.06), CFrame.new(0, 0, 0.02), P.darken(color, 0.25), Enum.Material.Neon, 0.35, "Surface")
	for k = 1, 3 do
		add("Swirl", Vector3.new(r * 1.5, 0.26, 0.1), CFrame.new(0, 0, -0.06), P.lighten(color, 0.75), Enum.Material.Neon, 0.05, "Swirl" .. k)
	end
	-- the base: a stone step under the ring and a glowing sill
	add("Base", Vector3.new(r * 1.6, 0.4, 1.4), CFrame.new(0, -r - 0.2, 0), P.darken(color, 0.45), Enum.Material.SmoothPlastic, 0, "Base")
	add("Sill", Vector3.new(r * 1.2, 0.12, 1.0), CFrame.new(0, -r + 0.06, 0), P.lighten(color, 0.5), Enum.Material.Neon, 0.2, "Base")
	local center = items[K.RING_BLOCKS + 1].Part
	model.PrimaryPart = center
	-- sparkles drift out of the surface
	local att = Instance.new("Attachment")
	att.Name = "Sparkles"
	att.Parent = center
	local ok = pcall(function()
		local em = Instance.new("ParticleEmitter")
		em.Name = "Sparkles"
		em.Color = ColorSequence.new(P.lighten(color, 0.6), GOLD)
		em.Rate = 6
		em.Lifetime = NumberRange.new(0.8, 1.4)
		em.Speed = NumberRange.new(0.6, 1.4)
		em.SpreadAngle = Vector2.new(180, 180)
		em.LightInfluence = 0
		em.Parent = att
	end)
	if not ok then
		att:Destroy()
	end
	-- the name tag (pixel-sized, World text rule)
	local gui = Instance.new("BillboardGui")
	gui.Name = "PortalName"
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.StudsOffset = Vector3.new(0, r + 1.4, 0)
	gui.Parent = center
	local px = K.NAME_PX
	if Theme and type(Theme.ScaledSize) == "function" then
		local okS, s = pcall(Theme.ScaledSize, K.NAME_PX)
		if okS and type(s) == "number" then
			px = s
		end
	end
	local text = tostring(rec.Name) .. "'s portal"
	local w = math.floor(px * 0.58 * #text + 28)
	gui.Size = UDim2.fromOffset(w, math.floor(px * 1.6))
	local plate = Instance.new("Frame")
	plate.Name = "Plate"
	plate.Size = UDim2.fromScale(1, 1)
	plate.BackgroundColor3 = INK
	plate.BackgroundTransparency = 0.25
	plate.BorderSizePixel = 0
	plate.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = plate
	local label = Instance.new("TextLabel")
	label.Name = "Name"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Text = text
	label.TextSize = px
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = INK
	label.Parent = plate
	if Theme then
		label.Font = Theme.Fonts.Title
		if type(Theme.TextOutline) == "function" then
			Theme.TextOutline(label, 2, INK, 0)
		end
	end
	rec.Model, rec.Items, rec.Gui, rec.Label = model, items, gui, label
	model.Parent = P.ensureFolder()
end

-- writes every part for the current scale / swirl angle / fade (only portals near the camera, never for far ones)
function P.place(rec)
	local s = math.max(0.02, rec.Scale)
	local frame = rec.Frame
	local fade = rec.Faded and K.FADED or 0
	for _, it in ipairs(rec.Items) do
		local loc = it.Local
		local kind = it.Kind
		if kind and string.sub(kind, 1, 5) == "Swirl" then
			local k = tonumber(string.sub(kind, 6)) or 1
			loc = CFrame.Angles(0, 0, rec.Angle + k * (math.pi / 3)) * loc
		end
		local p = loc.Position * s
		it.Part.CFrame = frame * (CFrame.new(p) * (loc - loc.Position))
		it.Part.Size = it.Size * s
		local t = it.Trans + (1 - it.Trans) * fade
		if rec.Closing then
			t = t + (1 - t) * (1 - s)
		end
		if it.Part.Transparency ~= t then
			it.Part.Transparency = t
		end
	end
	if rec.Gui then
		local show = s > 0.6 and not rec.Closing
		if rec.Gui.Enabled ~= show then
			rec.Gui.Enabled = show
		end
	end
end

function P.destroy(rec)
	if rec.Model then
		rec.Model:Destroy()
	end
	rec.Model, rec.Items, rec.Gui, rec.Label = nil, nil, nil, nil
end

-- the HomePortal attribute of a player changed: open / move / close their portal
function P.refresh(player)
	local text = player:GetAttribute(PORTAL_ATTR)
	local point, yaw, closesAt = P.parse(text)
	local rec = portals[player]
	if not point then
		if rec and not rec.Closing then
			rec.Closing = true
			rec.CloseT = 0
		end
		return
	end
	if rec and rec.Closing then
		P.destroy(rec)
		rec = nil
	end
	local frame = CFrame.new(point + Vector3.new(0, K.CENTER_Y, 0)) * CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(0, math.pi, 0)
	if rec and rec.Point and (rec.Point - point).Magnitude < 0.05 and math.abs((rec.Yaw or 0) - yaw) < 0.5 then
		rec.ClosesAt = closesAt
		return
	end
	if not rec then
		rec = { Player = player, Scale = 0, Angle = 0, Opening = true }
		portals[player] = rec
		stats.Opened = stats.Opened + 1
	end
	rec.Point, rec.Yaw, rec.ClosesAt, rec.Frame = point, yaw, closesAt, frame
	rec.Name = (player.DisplayName ~= nil and player.DisplayName ~= "") and player.DisplayName or player.Name
	rec.Color = P.colorOf(player)
	rec.Faded = player ~= localPlayer
	rec.Center = frame.Position
	rec.Dirty = true
end

-- the arrival ring where the player stands now
function P.arrive(player)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or not root:IsA("BasePart") then
		return
	end
	local eye = P.cameraPos()
	-- (the local player's own arrival always plays: the camera catches up with the teleport a frame later)
	if player ~= localPlayer and eye and (root.Position - eye).Magnitude > K.DRAW_RANGE then
		return
	end
	while #arrivals >= K.MAX_ARRIVALS do
		P.endArrival(table.remove(arrivals, 1))
	end
	local color = P.colorOf(player)
	local ring = { T = 0, Parts = {}, Base = root.Position - Vector3.new(0, 2.8, 0) }
	for i = 1, K.ARRIVAL_BLOCKS do
		local c = (i % 2 == 0) and P.lighten(color, 0.4) or color
		local p = P.part("ArrivalRing", Vector3.new(0.6, 0.18, 0.3), c, Enum.Material.Neon, 0.1)
		p.Parent = P.ensureFolder()
		ring.Parts[#ring.Parts + 1] = p
	end
	for i = 1, K.ARRIVAL_SPARKS do
		local p = P.part("ArrivalSpark", Vector3.new(0.22, 0.22, 0.22), (i % 2 == 0) and GOLD or P.lighten(color, 0.6), Enum.Material.Neon, 0)
		p.Parent = P.ensureFolder()
		ring.Parts[#ring.Parts + 1] = p
	end
	arrivals[#arrivals + 1] = ring
	stats.Arrivals = stats.Arrivals + 1
	P.stepArrival(ring, 0)
end

function P.endArrival(ring)
	for _, p in ipairs(ring.Parts) do
		p:Destroy()
	end
	ring.Parts = {}
end

-- the ring widens from 1 to 4.5 studs and fades; the sparks rise and spin out
function P.stepArrival(ring, dt)
	ring.T = ring.T + dt
	local q = math.min(1, ring.T / K.ARRIVAL_TIME)
	local ease = 1 - (1 - q) * (1 - q)
	local radius = 1 + 3.5 * ease
	local trans = 0.1 + 0.9 * q
	for i, p in ipairs(ring.Parts) do
		if i <= K.ARRIVAL_BLOCKS then
			local a = (i - 0.5) / K.ARRIVAL_BLOCKS * 2 * math.pi
			local len = 2 * math.pi * radius / K.ARRIVAL_BLOCKS * 0.85
			p.Size = Vector3.new(len, 0.18, 0.3)
			p.CFrame = CFrame.new(ring.Base + Vector3.new(math.cos(a) * radius, 0.15, math.sin(a) * radius)) * CFrame.Angles(0, -a - math.pi / 2, 0)
		else
			local k = i - K.ARRIVAL_BLOCKS
			local a = k / K.ARRIVAL_SPARKS * 2 * math.pi + q * 4
			local r = 0.8 + 1.4 * ease
			p.CFrame = CFrame.new(ring.Base + Vector3.new(math.cos(a) * r, 0.4 + 3.2 * ease, math.sin(a) * r)) * CFrame.Angles(q * 6, q * 4, 0)
		end
		p.Transparency = trans
	end
	return q >= 1
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
function P.step(dt)
	dt = math.min(tonumber(dt) or 0, 0.1)
	clock = clock + dt
	local eye = P.cameraPos()
	local now = P.serverNow()
	for player, rec in pairs(portals) do
		if not rec.Closing and rec.ClosesAt and now > rec.ClosesAt + 0.25 then
			rec.Closing = true -- expired (the server clears the attribute too)
			rec.CloseT = 0
		end
		local near = eye == nil or (rec.Center - eye).Magnitude <= K.DRAW_RANGE
		if rec.Closing then
			rec.CloseT = rec.CloseT + dt
			rec.Scale = math.max(0, 1 - rec.CloseT / K.CLOSE_TIME)
			if rec.Scale <= 0 or not near or not rec.Model then
				P.destroy(rec)
				portals[player] = nil
			end
		elseif near then
			if not rec.Model then
				P.build(rec)
				rec.Dirty = true
			end
			if rec.Scale < 1 then
				rec.Scale = math.min(1, rec.Scale + dt / K.OPEN_TIME)
			end
		elseif rec.Model then
			P.destroy(rec) -- too far: nothing drawn, it comes back when the camera nears
			rec.Scale = 1
		end
		if rec.Model and portals[player] then
			rec.Angle = (rec.Angle + dt * K.SWIRL_SPEED) % (2 * math.pi)
			P.place(rec)
		end
	end
	local i = 1
	while i <= #arrivals do
		if P.stepArrival(arrivals[i], dt) then
			P.endArrival(table.remove(arrivals, i))
		else
			i = i + 1
		end
	end
end

function P.safeStep(dt)
	local ok, err = pcall(P.step, dt)
	if not ok and not warned then
		warned = true
		warn("[HomePortalFx] frame error: " .. tostring(err))
	end
end

function P.watch(player)
	if playerConns[player] then
		return
	end
	local list = {}
	playerConns[player] = list
	list[#list + 1] = player:GetAttributeChangedSignal(PORTAL_ATTR):Connect(function()
		local ok, err = pcall(P.refresh, player)
		if not ok and not warned then
			warned = true
			warn("[HomePortalFx] " .. tostring(err))
		end
	end)
	list[#list + 1] = player:GetAttributeChangedSignal(ARRIVED_ATTR):Connect(function()
		if player:GetAttribute(ARRIVED_ATTR) ~= nil then
			local ok, err = pcall(P.arrive, player)
			if not ok and not warned then
				warned = true
				warn("[HomePortalFx] " .. tostring(err))
			end
		end
	end)
	if player:GetAttribute(PORTAL_ATTR) ~= nil then
		pcall(P.refresh, player)
	end
end

function P.unwatch(player)
	local list = playerConns[player]
	if list then
		for _, c in ipairs(list) do
			c:Disconnect()
		end
	end
	playerConns[player] = nil
	local rec = portals[player]
	if rec then
		P.destroy(rec)
		portals[player] = nil
	end
end

----------------------------------------------------------------------
-- Public
----------------------------------------------------------------------
function HomePortalFx.Stats()
	local n, parts, shown, faded, closing, ringParts = 0, 0, 0, 0, 0, 0
	for _, rec in pairs(portals) do
		n = n + 1
		if rec.Model then
			shown = shown + 1
			parts = parts + #rec.Items
			if rec.Faded then
				faded = faded + 1
			end
		end
		if rec.Closing then
			closing = closing + 1
		end
	end
	for _, ring in ipairs(arrivals) do
		ringParts = ringParts + #ring.Parts
	end
	return { Portals = n, Parts = parts, Shown = shown, Faded = faded, Closing = closing, Rings = #arrivals, RingParts = ringParts,
		Opened = stats.Opened, Arrivals = stats.Arrivals }
end

function HomePortalFx.Portal(player)
	local rec = player and portals[player]
	if not rec then
		return nil
	end
	return { Model = rec.Model, Center = rec.Center, Yaw = rec.Yaw, ClosesAt = rec.ClosesAt, Faded = rec.Faded, Closing = rec.Closing == true,
		Name = rec.Label and rec.Label.Text or nil, Scale = rec.Scale, Gui = rec.Gui }
end

function HomePortalFx.Init()
	if initialized then
		return
	end
	initialized = true
	localPlayer = localPlayer or Players.LocalPlayer
	for _, player in ipairs(Players:GetPlayers()) do
		P.watch(player)
	end
	conns[#conns + 1] = Players.PlayerAdded:Connect(P.watch)
	conns[#conns + 1] = Players.PlayerRemoving:Connect(P.unwatch)
	loopConn = RunService.RenderStepped:Connect(P.safeStep)
end

function HomePortalFx.Stop()
	if loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	conns = {}
	local list = {}
	for player in pairs(playerConns) do
		list[#list + 1] = player
	end
	for _, player in ipairs(list) do
		P.unwatch(player)
	end
	for player, rec in pairs(portals) do
		P.destroy(rec)
		portals[player] = nil
	end
	for _, ring in ipairs(arrivals) do
		P.endArrival(ring)
	end
	arrivals = {}
	if folder then
		folder:Destroy()
		folder = nil
	end
	initialized = false
end

return HomePortalFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">HotbarController</string>
              <string name="Source"><![CDATA[-- HotbarController (client, v3): four item slots at the bottom-centre of the screen.
--
--   HotbarController.Init()
--   HotbarController.UseSlot(index)      -- same as pressing key `index` (1..4)
--
-- ScreenGui "NimbusHotbar" (display order 11, IgnoreGuiInset = false). Slots 1-3 follow ItemCatalog.List
-- (Heal Cloud, Shield Bubble, Phoenix Feather); slot 4 is a locked placeholder. Keys 1-4 (also the keypad)
-- and a tap / click use the item through the UseItem remote; the server validates everything.
-- Counts come from State and re-render on State.Changed. Items only work in matches, so the whole
-- bar is dimmed in the lobby (and while downed, or when a stack is empty); a used slot flashes, pops and
-- shows a short cooldown bar.
--
-- v3 readability rule: the bar is designed in 1080p pixels (80 px slots) under ONE UIScale of the screen
-- factor clamp(viewportY / 1080, 0.8, 1.25). On touch screens it never grows past the footprint the touch
-- RUN / DASH buttons keep clear of (MovementController: 280 x 64 px at clamp(min(w/1280, h/720), 0.75, 1.2))
-- and it slides left of Roblox's jump button on narrow phones; slots stay >= 48 px (touch friendly). The
-- count / key / hint texts grow in design pixels when the bar is scaled down, so they never render below
-- 14.5 px on screen.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local okItems, ItemCatalog = pcall(function()
	return require(Shared:WaitForChild("ItemCatalog", 10))
end)
if not okItems or type(ItemCatalog) ~= "table" then
	warn("[HotbarController] ItemCatalog is unavailable: " .. tostring(ItemCatalog))
	ItemCatalog = { List = {}, ById = {} }
end

local HotbarController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local SLOT = 80
local GAP = 10
local BOTTOM = 14 -- screen px from the bottom edge
local TOUCH_BOTTOM = 16 -- screen px on touch devices (MovementController expects 16)
local JUMP_GAP = 8 -- clear space kept between the bar and Roblox's jump button (touch devices)
local SIDE_GAP = 6 -- the bar never slides closer than this to the left screen edge
local TOUCH_MIN_PX = 48 -- smallest on-screen slot
local MIN_TEXT_PX = 14.5 -- smallest on-screen text
local COUNT_TEXT = 22 -- design px of the "x3" stack count
local KEY_TEXT = 19 -- design px of the key chip number
local HINT_TEXT = 20 -- design px of the hint above the bar
local COOLDOWN = 0.8 -- seconds between two uses of the same slot
local HINT_SECONDS = 2.4
-- The touch-control footprint MovementController keeps clear of (keep in sync with it).
local MC_W, MC_H = 280, 64

local Colors = Theme.Colors
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local KINDS = Theme.Kinds or {}
local LOCK_GLYPH = "\240\159\148\146"

local KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.KeypadThree] = 3,
	[Enum.KeyCode.KeypadFour] = 4,
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local initialized = false
local LocalPlayer = nil
local gui = nil
local holder = nil
local holderScale = nil
local slots = {} -- index -> { Slot, Def, Punch (UIScale), Bar (cooldown frame), CoolUntil, LastCount, Count, Key }
local useRemote = nil
local hint = { Frame = nil, Label = nil, Limit = nil, Token = 0 }
local touchDevice = false
local warned = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[HotbarController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function guiSize()
	local size = gui and gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.X > 2 and vp.Y > 2 then
		return vp
	end
	return guiSize()
end

local function inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

local function isDowned()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.Downed) == true
end

local function slotCount()
	return math.max(1, math.floor(tonumber(Config.Items.HotbarSlots) or 4))
end

local function barWidth()
	local count = slotCount()
	return count * SLOT + (count - 1) * GAP
end

local function getUseRemote()
	if useRemote then
		return useRemote
	end
	local ok, remote = pcall(Remotes.Get, "UseItem")
	if ok and remote then
		useRemote = remote
	end
	return useRemote
end

-- Design text size that renders at least MIN_TEXT_PX on screen under `scale`.
local function readable(designPx, scale)
	if scale <= 0 then
		return designPx
	end
	return math.max(designPx, math.ceil(MIN_TEXT_PX / scale))
end

local function applyTextSizes(scale)
	local countSize = readable(COUNT_TEXT, scale)
	local keySize = readable(KEY_TEXT, scale)
	for _, entry in ipairs(slots) do
		if entry.Count then
			entry.Count.TextSize = countSize
			entry.Count.Size = UDim2.new(0.9, 0, 0, countSize + 2)
		end
		if entry.Key then
			entry.Key.TextSize = keySize
			local chip = entry.Key.Parent
			if chip and chip:IsA("GuiObject") then
				chip.Size = UDim2.fromOffset(keySize + 9, keySize + 9)
			end
		end
	end
	if hint.Label then
		local hintSize = readable(HINT_TEXT, scale)
		hint.Label.TextSize = hintSize
		if hint.Limit then
			hint.Limit.MaxSize = Vector2.new(math.floor(hintSize * 19), 200)
		end
	end
end

local function relayout()
	if not holder then
		return
	end
	local size = guiSize()
	local vp = viewportSize()
	local width = barWidth()
	local scale = Theme.ScreenFactor(vp.Y)
	local bottom = BOTTOM
	local shift = 0
	if touchDevice then
		bottom = TOUCH_BOTTOM
		-- stay inside the footprint the touch RUN / DASH buttons keep clear of
		local mcScale = Util.Clamp(math.min(vp.X / 1280, vp.Y / 720), 0.75, 1.2)
		scale = math.min(scale, MC_W * mcScale / width, MC_H * mcScale / SLOT)
		-- Roblox's own jump button sits bottom-right: its left edge is 1.5 J + 10 px from the right screen edge
		-- (J = 70 when the smaller screen axis is <= 500 px, else 120). On a narrow phone the centred bar would
		-- touch it, so it shrinks (never below the touch minimum) and slides left just far enough.
		local jump = math.min(vp.X, vp.Y) <= 500 and 70 or 120
		local reach = size.X - (jump * 1.5 + 10) - JUMP_GAP -- right-most x the bar may reach
		scale = math.min(scale, (reach - SIDE_GAP) / width)
	end
	-- never wider than the screen, never smaller than the touch minimum
	scale = math.min(scale, (size.X - 2 * SIDE_GAP) / width)
	scale = math.max(scale, TOUCH_MIN_PX / SLOT)
	holderScale.Scale = scale
	if touchDevice then
		local jump = math.min(vp.X, vp.Y) <= 500 and 70 or 120
		local reach = size.X - (jump * 1.5 + 10) - JUMP_GAP
		local half = width * scale / 2
		shift = math.min(0, reach - half - size.X / 2)
		shift = math.min(0, math.max(shift, half + SIDE_GAP - size.X / 2))
	end
	holder.Position = UDim2.new(0.5, math.floor(shift), 1, -bottom)
	applyTextSizes(scale)
end

----------------------------------------------------------------------
-- Small hint above the bar (why a press did nothing)
----------------------------------------------------------------------
local function buildHint()
	local frame = Util.Create("Frame", {
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -12),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = Colors.White, -- the gradient below multiplies this base colour
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
		Parent = holder,
	})
	Theme.Corner(frame, UDim.new(0, 12))
	Theme.Stroke(frame, NAVY, 3, 0)
	Theme.Gradient(frame, Colors.PanelLight, Colors.Panel, 90)
	Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, 14),
		PaddingRight = UDim.new(0, 14),
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 8),
		Parent = frame,
	})
	local label = Theme.Label("", "Toast", {
		Size = HINT_TEXT,
		Stroke = 0.2,
		Outline = 1.5,
		Props = {
			Name = "Text",
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 21,
		},
	})
	hint.Limit = Util.Create("UISizeConstraint", { MaxSize = Vector2.new(380, 200), Parent = label })
	label.Parent = frame
	hint.Frame = frame
	hint.Label = label
end

local function showHint(text, kind)
	if not hint.Frame then
		return
	end
	hint.Token = hint.Token + 1
	local mine = hint.Token
	local color = KINDS[kind or "info"] or KINDS.info or Colors.PanelLight
	hint.Label.Text = tostring(text)
	hint.Label.TextColor3 = Theme.Lighten(color, 0.55)
	hint.Frame.Visible = true
	task.delay(HINT_SECONDS, function()
		if hint.Token == mine and hint.Frame then
			hint.Frame.Visible = false
		end
	end)
end

----------------------------------------------------------------------
-- Slots
----------------------------------------------------------------------
local function itemForSlot(index)
	local list = ItemCatalog.List or {}
	return list[index]
end

local function paintSlot(entry)
	local slot = entry.Slot
	local def = entry.Def
	if not def then
		slot.SetCount(nil)
		slot.SetDimmed(true)
		return
	end
	local count = State.ItemCount(def.Id)
	slot.SetCount(count)
	-- a bigger stack than before: little celebration (not for the very first profile load)
	if State.IsLoaded == nil or State.IsLoaded() then
		if entry.LastCount ~= nil and count > entry.LastCount then
			slot.Flash()
			entry.Punch.Scale = 1.14
			Util.Tween(entry.Punch, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		end
		entry.LastCount = count
	end
	local usable = inMatch() and (not isDowned()) and count > 0
	local cooling = os.clock() < entry.CoolUntil
	slot.SetDimmed((not usable) or cooling)
end

local function refresh()
	for _, entry in ipairs(slots) do
		paintSlot(entry)
	end
end

local function startCooldown(entry)
	entry.CoolUntil = os.clock() + COOLDOWN
	entry.Bar.Visible = true
	entry.Bar.Size = UDim2.new(1, -14, 0, 6)
	Util.Tween(entry.Bar, COOLDOWN, { Size = UDim2.new(0, 0, 0, 6) }, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	paintSlot(entry)
	task.delay(COOLDOWN + 0.02, function()
		if entry.Bar and entry.Bar.Parent then
			entry.Bar.Visible = false
			paintSlot(entry)
		end
	end)
end

-- Press feedback for a slot that cannot be used right now.
local function shake(entry)
	local punch = entry.Punch
	punch.Scale = 0.88
	Util.Tween(punch, 0.25, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

function HotbarController.UseSlot(index)
	local entry = slots[index]
	if not entry then
		return
	end
	local def = entry.Def
	if not def then
		shake(entry)
		showHint("This slot is locked. More items are coming!", "info")
		return
	end
	if not inMatch() then
		shake(entry)
		showHint("Items only work during a match.", "info")
		return
	end
	if isDowned() then
		shake(entry)
		showHint("You cannot use items while downed.", "bad")
		return
	end
	if State.ItemCount(def.Id) <= 0 then
		shake(entry)
		showHint("No " .. def.Name .. " left. Buy more in the shop!", "info")
		return
	end
	if os.clock() < entry.CoolUntil then
		return
	end
	local remote = getUseRemote()
	if not remote then
		return
	end
	local ok = pcall(function()
		remote:FireServer(def.Id)
	end)
	if not ok then
		return
	end
	entry.Slot.Flash()
	entry.Punch.Scale = 0.86
	Util.Tween(entry.Punch, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	startCooldown(entry)
end

local function buildSlots()
	local count = slotCount()
	holder.Size = UDim2.fromOffset(barWidth(), SLOT)
	for index = 1, count do
		local def = itemForSlot(index)
		local slot = CloudUI.Slot({
			Name = "Hotbar" .. index,
			Size = UDim2.fromOffset(SLOT, SLOT),
			-- centre-anchored so the pop animation grows around the middle of the slot
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset((index - 1) * (SLOT + GAP) + SLOT / 2, SLOT / 2),
			Hotkey = tostring(index),
			Callback = function()
				HotbarController.UseSlot(index)
			end,
			Parent = holder,
		})
		if def then
			slot.SetContent({
				Glyph = def.Glyph,
				Color = def.Color,
				RarityColor = CloudUI.RarityColor(def.Rarity),
				Name = def.Name .. "  [" .. index .. "]",
				Blurb = def.Blurb,
			})
		else
			slot.SetContent({
				Glyph = LOCK_GLYPH,
				Color = MUTED,
				Name = "Locked slot",
				Blurb = "More items are coming soon.",
			})
		end

		local punch = Util.Create("UIScale", { Name = "Punch", Scale = 1, Parent = slot.Root })
		local bar = Util.Create("Frame", {
			Name = "Cooldown",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, -14, 0, 6),
			BackgroundColor3 = Colors.Gold or Colors.Token,
			BorderSizePixel = 0,
			Visible = false,
			ZIndex = 10,
			Parent = slot.Root,
		})
		Theme.Corner(bar, UDim.new(0.5, 0))
		Theme.Stroke(bar, NAVY, 1.5, 0)
		-- the kit's count / key labels, resized by relayout so they stay readable at any scale
		local countLabel = slot.Root:FindFirstChild("Count", true)
		local keyLabel = slot.Root:FindFirstChild("Key", true)
		if countLabel and not countLabel:IsA("TextLabel") then
			countLabel = nil
		end
		if keyLabel and not keyLabel:IsA("TextLabel") then
			keyLabel = nil
		end
		slots[index] = {
			Slot = slot,
			Def = def,
			Punch = punch,
			Bar = bar,
			CoolUntil = 0,
			LastCount = nil,
			Count = countLabel,
			Key = keyLabel,
		}
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function HotbarController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	touchDevice = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	pcall(State.Init)

	gui = CloudUI.NewScreenGui("NimbusHotbar", 11)
	holder = Util.Create("Frame", {
		Name = "Hotbar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -BOTTOM),
		Size = UDim2.fromOffset(barWidth(), SLOT),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Parent = gui,
	})
	holderScale = Util.Create("UIScale", { Name = "ViewportScale", Scale = 1, Parent = holder })

	buildSlots()
	buildHint()
	relayout()
	refresh()

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		local ok, err = pcall(relayout)
		if not ok then
			warnOnce("relayout", err)
		end
	end)
	State.Changed:Connect(function()
		local ok, err = pcall(refresh)
		if not ok then
			warnOnce("refresh", err)
		end
	end)
	for _, attribute in ipairs({ Config.Attr.InMatch, Config.Attr.Downed }) do
		LocalPlayer:GetAttributeChangedSignal(attribute):Connect(function()
			local ok, err = pcall(refresh)
			if not ok then
				warnOnce("attribute", err)
			end
		end)
	end

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local index = KEYS[input.KeyCode]
		if index then
			local ok, err = pcall(HotbarController.UseSlot, index)
			if not ok then
				warnOnce("key", err)
			end
		end
	end)

	task.spawn(getUseRemote)
end

return HotbarController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[-- HudController: the Nimbus Climb heads-up display (v3).
--
--   HudController.Init()
--   HudController.GetLayout() -> { TopLeftRight, TopLeftBottom, TopRightBottom, BottomLeftTop, Scale, CurrencyMode }
--
-- One ScreenGui "NimbusHud" (display order 10, IgnoreGuiInset = false, built by CloudUI.NewScreenGui).
-- Nothing the game announces is ever drawn in the middle of the screen. The layout map:
--
--   top-left      Match panel (difficulty, timer, checkpoint bar, team chips, Leave button) with the
--                 pre-match countdown numerals shown INSIDE it; the lobby Party panel takes the same
--                 slot (portal name + a big red Leave button, the only way out of a locked portal; the
--                 countdown; the members; "Locked until launch" + the head count); the small title card
--                 slides in there at join and leaves after four seconds
--   bottom-left   Currency stack (Cloud Tokens now: cloud coin + big abbreviated number, "+n" while in a
--                 match; Cash and Gems rows appear by themselves once those player attributes exist),
--                 above the vitals card: heart badge + thick HP tube (white damage trail, hit flash + shake,
--                 low-health pulse, DOWNED state), lightning badge + stamina tube (dims when run dry) and
--                 the dash ring (cooldown sweep). Raised on touch devices to clear the thumbstick; short
--                 touch screens get a compact card (VG.Compact) so it never sits on the hotbar.
--   top-right     The currency stack moves here on short screens (landscape phones) where there is no
--                 room above the raised vitals; the toast stack (NotifyController) then starts below it.
--
-- Sizes follow the v3 readability rule: every panel is designed in 1080p pixels (body text >= 18, numbers
-- 30+, titles 26-34) and carries a UIScale of Theme.ScreenFactor() = clamp(viewportY / 1080, 0.8, 1.25), so
-- the smallest text is 14.4 px on a phone. The UIScale sits on the panel, the margins on full-screen holder
-- frames, so scaling never moves a panel away from its corner.
--
-- Neighbours are MEASURED, not guessed: the menu column (NimbusMenu.MenuColumn, left-centre, drawn above us)
-- and the touch RUN / DASH buttons (MobileControls). Whatever of ours would run into the column steps aside
-- to its right; the vitals and the currency stack never reach under the touch buttons. The geometry is
-- re-checked twice a second and on every viewport change, and published as attributes on the NimbusHud
-- gui (TopLeftRight, TopLeftBottom, TopRightBottom, BottomLeftTop, HudScale; gui-area pixels) so the
-- toasts and side panels can keep clear of the HUD.
--
-- Data: Humanoid health, player attributes (CloudTokens, MatchTokens, InMatch, Downed, Stamina, Cash, Gems)
-- and the MatchState / PartyState remotes. Everything is nil-safe: no humanoid, no match, no party, a
-- missing menu and a missing MovementController all leave the HUD in a sensible idle state.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local okState, State = pcall(function()
	return require(Client:WaitForChild("State"))
end)
if not okState or type(State) ~= "table" then
	State = nil
end

local HudController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
-- K: layout + timing constants (one table keeps the module well under Lua's 200-locals limit)
local K = {
	EDGE = 12, -- margin to the screen edge
	TOUCH_EDGE = 20, -- larger side margin on touch devices (notches, rounded corners)
	TOUCH_RAISE_SMALL = 150, -- gui px the vitals are lifted on phones (thumbstick room)
	TOUCH_RAISE_LARGE = 220, -- ... and on tablets
	TOUCH_RAISE_MIN = 64, -- short landscape phones lift less so the top-left panel still fits above
	SMALL_PHONE = 500, -- Roblox's own touch controls shrink when the smaller screen side is at most this

	VITALS_W = 340,
	VITALS_H = 93, -- the vitals card (see VG below for its inside)
	VITALS_MIN_W = 236, -- narrowest the vitals get squeezed on a small phone
	STACK_GAP = 10, -- between the vitals and the currency stack (scaled)

	CUR_W = 240, -- one currency pill
	CUR_H = 46,
	CUR_GAP = 10,
	CUR_MIN_W = 190,
	CUR_PAIR_MIN_W = 236, -- two compact pills side by side need this much
	COIN = 54, -- the round coin badge overlapping the pill's left end
	CHIP_W = 76, -- the "+n" match chip on the token pill
	COIN_COMPACT = 42, -- coin of a compact (paired) pill

	PANEL_W = 330, -- match + party panels
	PANEL_MIN_W = 272, -- ... squeezed this far on short screens (keeps their text out of the screen middle)
	CENTRE_TOL = 0.145, -- the screen middle: |dx| < 14.5% of the width and |dy| < 14.5% of the height
	TITLE_W = 300,
	TITLE_H = 78,

	-- Menu column fallback (only while MenuController's column cannot be measured): 6 tiles of the v3 menu.
	MENU_FALLBACK_W = 76,
	MENU_FALLBACK_ENTRY = 82,
	MENU_FALLBACK_GAP = 6,
	MENU_FALLBACK_COUNT = 6,
	MENU_CLEARANCE = 8, -- empty strip kept between the column and whatever steps aside for it
	SPAN_MARGIN = 4, -- two vertical spans closer than this count as touching
	BUTTON_CLEARANCE = 8, -- kept between our blocks and the touch RUN / DASH buttons

	LOW_HEALTH = 0.3, -- below this the heart beats and the card pulses red
	TRAIL_HOLD = 0.45, -- seconds the white damage trail waits before it catches up
	TRAIL_SPEED = 0.6, -- ... then drains this much of the bar per second
	HIT_SECONDS = 0.32, -- damage flash + card shake
	SHAKE_PX = 5,
	STAMINA_RECOVER = 15, -- after running dry the stamina row stays dimmed up to this (MovementController's resume point)
	TITLE_CARD_SECONDS = 4,
	LEAVE_CONFIRM_SECONDS = 3,
	GO_SECONDS = 1.0, -- how long "GO!" replaces the timer
	LAYOUT_POLL = 0.5, -- seconds between two geometry checks
}

-- VG: geometry of the vitals card in design px (1080p), width 236-340 (the bars stretch with it; the badges
-- and the dash ring keep their size). H = the layout slot, CARD_H = the card drawn in it (from the top).
-- Left column: the heart badge over the lightning badge, both overlapping the card's left edge like the coins
-- of the currency pills above (same column). Regular: the dash ring ends the stamina row. Compact (short touch
-- screens, landscape phones, where the slot sits right on the hotbar): a flatter card that leaves a gap at the
-- bottom of its slot, with a bigger dash ring at the right end spanning both rows.
local VG = {
	Regular = {
		H = K.VITALS_H, CARD_H = K.VITALS_H, CARD_X = 20, CARD_CORNER = 22,
		BADGE_X = 28, HEART = 52, HEART_Y = 26, HEART_TEXT = 34, BOLT = 36, BOLT_Y = 72,
		HP_X = 46, HP_Y = 8, HP_H = 36, HP_TEXT = 26, PAD_R = 10,
		ST_X = 40, ST_Y = 61, ST_H = 22,
		RING = 40, RING_Y = 71, RING_GAP = 8, RING_FACE = 22, RING_TEXT = 20, RING_SPAN = false,
	},
	Compact = {
		H = 80, CARD_H = 70, CARD_X = 18, CARD_CORNER = 20,
		BADGE_X = 24, HEART = 44, HEART_Y = 22, HEART_TEXT = 30, BOLT = 28, BOLT_Y = 54,
		HP_X = 40, HP_Y = 7, HP_H = 30, HP_TEXT = 23, PAD_R = 9,
		ST_X = 34, ST_Y = 45, ST_H = 18,
		RING = 46, RING_Y = 35, RING_GAP = 8, RING_FACE = 30, RING_TEXT = 22, RING_SPAN = true,
	},
	COMPACT_SPARE = 10, -- use Compact when Regular leaves less than this above the minimum touch raise
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local HEART_RED = Color3.fromRGB(232, 84, 104)
-- VS: the vitals card's colours and the dash ring's sweep sequences
local VS = {
	BoltBlue = Color3.fromRGB(70, 156, 236),
	Edge = Theme.Darken(NAVY, 0.3), -- outline of the tubes and the dash ring
	TrackTop = Color3.fromRGB(12, 16, 40), -- the dark inset track of the tubes and the ring
	TrackBottom = Color3.fromRGB(40, 52, 104),
	Grey = Color3.fromRGB(128, 140, 168), -- a drained badge / a dash you cannot afford
	Arc = Color3.fromRGB(128, 214, 255), -- the bright cooldown sweep
	-- a hard step in the middle of each half-disc's gradient (partial sweep), or no step at all (full ring)
	Step = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.499, 0),
		NumberSequenceKeypoint.new(0.501, 1),
		NumberSequenceKeypoint.new(1, 1),
	}),
	Solid = NumberSequence.new(0),
}
local Vitals = {} -- builders and painters of the vitals card (one table keeps the chunk's locals down)
local CUR = Theme.Currency or {}

-- Currency rows, top to bottom. Tokens is always shown (and sits right above the HP bar); the others appear
-- once their player attribute exists (phase 2 sets them).
local CURRENCY_ORDER = {
	{ Id = "Cash", Attr = Config.Attr.Cash, Def = CUR.Cash },
	{ Id = "Gems", Attr = Config.Attr.Gems, Def = CUR.Gems },
	{ Id = "Tokens", Attr = Config.Attr.Tokens, Def = CUR.Tokens, Always = true, Run = true },
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local player = nil
local initialized = false
local startedAt = 0
local connections = {}
local warned = {}
local remoteCache = {}
local scalers = {} -- UIScale objects driven by the screen factor
local pads = {} -- UIPadding objects of the corner holders
local padTweens = {} -- running PaddingLeft tween per holder
local padGoals = {} -- last PaddingLeft requested per holder
local M = nil -- layout metrics of the match / party panels, see panelMetrics()
local movementModule = nil
local movementNextTry = 0
local layoutKey = nil
local layoutPoll = 0
local published = {} -- the geometry attributes on the gui

local UI = {} -- instance references
local Items = {} -- sliding panels, see present()
local Cur = {} -- currency rows by id: { Def, Attr, Row, Amount, AmountScale, CoinScale, Target, Display, Shown, Seen, Visible }

local S = {
	match = nil, party = nil, downed = false, currencyMode = "BottomLeft", panelW = K.PANEL_W,
	yieldToResult = false, -- a narrow screen with the result card open: the match panel steps away
}
local H = { -- health
	Char = nil, Humanoid = nil, Conns = {},
	Cur = 100, Max = 100, Target = 1, Fill = 1, Trail = 1,
	HoldUntil = 0, ColorKey = nil, Text = nil, Low = false,
	HitAt = -10, HitFx = false, -- last damage (flash + shake running while HitFx)
}
-- stamina + dash ring: Dim 0 = bright .. 1 = empty (eased), Charge = drawn cooldown sweep 0..1
local St = { Frac = 1, Dim = 0, DimDrawn = -1, Drained = false, Charge = -1, Ready = nil, Afford = nil }
local Tk = { RunSeen = 0 } -- the "+n" match chip
local Mt = { -- match panel bookkeeping
	Base = 0, At = 0, Phase = nil, Last = nil, GoUntil = 0, Rows = 1, Chips = {}, Count = 0,
}
local Pt = { -- party panel bookkeeping (Fit*: what the text sizes were last fitted for)
	Base = nil, At = 0, Rows = 1, Chips = {}, Count = 0, LastText = nil, LeaveLockUntil = 0,
	HintLong = "Locked until launch", HintShort = "Locked in", FitW = nil, FitTitle = nil, FitStatus = nil, FitHint = nil,
}
local LM = { ArmedUntil = 0, LockedUntil = 0 } -- leave-match confirmation
local TC = { Serial = 0, Shown = false } -- title card

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local tween = Util.Tween

local function track(conn)
	if conn then
		table.insert(connections, conn)
	end
	return conn
end

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[HudController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

-- pcall wrapper that reports each distinct failure once instead of spamming every frame.
local function guard(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

-- The readability factor: clamp(viewportY / 1080, 0.8, 1.25).
local function currentScale()
	return Theme.ScreenFactor(viewportSize().Y)
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

local function hex(color)
	return string.format(
		"#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5)
	)
end

local function fireRemote(name)
	local remote = remoteCache[name]
	if not remote then
		local ok, found = pcall(Remotes.Get, name)
		if ok and found then
			remote = found
			remoteCache[name] = found
		end
	end
	if remote then
		remote:FireServer()
	end
end

local function stars(count)
	return string.rep("\226\152\133", math.max(0, math.min(5, math.floor(tonumber(count) or 0))))
end

----------------------------------------------------------------------
-- UI builders
----------------------------------------------------------------------
local function newFrame(parent, name, props)
	local p = { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Themed TextLabel. props may include Stroke (classic text stroke transparency) and Outline (thickness of a
-- glyph outline, Theme.TextOutline) plus any label property.
local function newText(parent, name, text, role, size, color, props)
	local extra = {
		Name = name,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}
	local stroke = 0.3
	local strokeColor = nil
	local outline = nil
	local outlineColor = nil
	if props then
		for key, value in pairs(props) do
			if key == "Stroke" then
				stroke = value
			elseif key == "StrokeColor" then
				strokeColor = value
			elseif key == "Outline" then
				outline = value
			elseif key == "OutlineColor" then
				outlineColor = value
			else
				extra[key] = value
			end
		end
	end
	local label = Theme.Label(text, role, {
		Size = size,
		Color = color,
		Stroke = stroke,
		StrokeColor = strokeColor,
		Outline = outline,
		OutlineColor = outlineColor or INK,
		Props = extra,
	})
	label.Parent = parent
	return label
end

local function round(inst)
	return Theme.Corner(inst, UDim.new(0.5, 0))
end

local function newScale(parent, value)
	local s = Instance.new("UIScale")
	s.Scale = value or 1
	s.Parent = parent
	return s
end

-- A UIScale driven by the screen factor (grows around the object's anchor point).
local function addViewportScale(root)
	local s = newScale(root, currentScale())
	s.Name = "ViewportScale"
	table.insert(scalers, s)
	return s
end

-- Springy "pop": jump a UIScale to `peak`, then ease back to 1.
local function pop(scaleObj, peak, seconds)
	if not scaleObj then
		return
	end
	scaleObj.Scale = peak
	tween(scaleObj, seconds or 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

-- Face of a glossy round badge: a light top, the base colour, then a hard darker lip at the bottom.
local function badgeSequence(color, glow)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, glow),
		ColorSequenceKeypoint.new(0.55, color),
		ColorSequenceKeypoint.new(0.8, Theme.Darken(color, 0.08)),
		ColorSequenceKeypoint.new(0.82, Theme.Darken(color, 0.28)),
		ColorSequenceKeypoint.new(1, Theme.Darken(color, 0.32)),
	})
end

-- Glossy round badge (navy outline, soft shine). Returns the badge, its UIGradient and its UIStroke.
local function newBadge(parent, name, size, color, glow)
	local badge = newFrame(parent, name, {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
	})
	round(badge)
	local stroke = Theme.Stroke(badge, NAVY, 3, 0)
	local g = Instance.new("UIGradient")
	g.Rotation = 90
	g.Color = badgeSequence(color, glow)
	g.Parent = badge
	local shine = newFrame(badge, "Shine", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 0),
		Size = UDim2.new(0.56, 0, 0.24, 0),
		BackgroundTransparency = 0.6,
		BackgroundColor3 = WHITE,
	})
	round(shine)
	return badge, g, stroke
end

-- Glossy coin badge: newBadge plus a glyph.
local function newCoin(parent, name, size, color, glow, glyph, glyphSize)
	local coin = newBadge(parent, name, size, color, glow)
	newText(coin, "Glyph", glyph, "Display", glyphSize, WHITE, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 0, 0, -1),
		Stroke = 0.2,
		StrokeColor = Theme.Darken(color, 0.6),
		Outline = 2,
		OutlineColor = Theme.Darken(color, 0.6),
		ZIndex = 2,
	})
	return coin
end

-- Slide a panel in/out between item.Rest and item.Hidden (both UDim2).
local function present(item, show)
	if not item or not item.Root or item.Shown == show then
		return
	end
	item.Shown = show
	local root = item.Root
	if show then
		root.Position = item.Hidden
		root.Visible = true
		tween(root, 0.4, { Position = item.Rest }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	else
		tween(root, 0.22, { Position = item.Hidden }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.28, function()
			if not item.Shown and root.Parent then
				root.Visible = false
			end
		end)
	end
end

local function newItem(root, hidden)
	root.Visible = false
	return { Root = root, Shown = false, Rest = root.Position, Hidden = hidden }
end

-- A transparent full-screen frame whose UIPadding is the screen margin of one corner.
local function newHolder(gui, name)
	local holder = newFrame(gui, name, { Size = UDim2.fromScale(1, 1) })
	local pad = Instance.new("UIPadding")
	pad.Parent = holder
	pads[name] = pad
	return holder
end

-- The area GUIs with IgnoreGuiInset = false are laid out in (below the top bar).
local function guiAreaSize()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	local vp = viewportSize()
	return Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
end

----------------------------------------------------------------------
-- Neighbour geometry (measured)
----------------------------------------------------------------------
local function playerGui()
	return player and player:FindFirstChildOfClass("PlayerGui")
end

-- y offset that converts a gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function rectOf(inst, dy)
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	return { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

-- MenuController's left-centre column in our coordinates (nil when there is none to avoid).
local function menuRect(area)
	local pg = playerGui()
	local menuGui = pg and pg:FindFirstChild("NimbusMenu")
	if menuGui and menuGui:IsA("ScreenGui") then
		if not menuGui.Enabled then
			return nil
		end
		local dy = insetShift(menuGui)
		local column = menuGui:FindFirstChild("MenuColumn") or menuGui:FindFirstChild("MenuColumn", true)
		if column and column:IsA("GuiObject") and shownIn(column, menuGui) and column.AbsoluteSize.X > 0 then
			return rectOf(column, dy)
		end
		-- no column frame: the union of the menu buttons
		local box = nil
		for _, d in ipairs(menuGui:GetDescendants()) do
			if d:IsA("GuiObject") and string.sub(d.Name, 1, 11) == "MenuButton_" and d.AbsoluteSize.X > 0 and shownIn(d, menuGui) then
				local r = rectOf(d, dy)
				if box then
					box.x0, box.y0 = math.min(box.x0, r.x0), math.min(box.y0, r.y0)
					box.x1, box.y1 = math.max(box.x1, r.x1), math.max(box.y1, r.y1)
				else
					box = r
				end
			end
		end
		if box then
			return box
		end
	end
	-- not built yet: a generous estimate of the v3 column (vertically centred against the left edge)
	local s = Util.Clamp(math.min(area.X / 1280, area.Y / 720), 0.72, 1.2)
	local height = (K.MENU_FALLBACK_COUNT * K.MENU_FALLBACK_ENTRY + (K.MENU_FALLBACK_COUNT - 1) * K.MENU_FALLBACK_GAP) * s
	return { x0 = 0, y0 = (area.Y - height) / 2, x1 = (K.MENU_FALLBACK_W + K.MENU_FALLBACK_GAP) * s, y1 = (area.Y + height) / 2 }
end

-- The touch RUN / DASH buttons (MovementController) in our coordinates.
local function mobileRects()
	local out = {}
	local pg = playerGui()
	local mobile = pg and pg:FindFirstChild("MobileControls")
	if not (mobile and mobile:IsA("ScreenGui") and mobile.Enabled) then
		return out
	end
	local dy = insetShift(mobile)
	for _, d in ipairs(mobile:GetDescendants()) do
		if (d:IsA("TextButton") or d:IsA("ImageButton")) and d.AbsoluteSize.X > 0 and shownIn(d, mobile) then
			table.insert(out, rectOf(d, dy))
		end
	end
	return out
end

local function rectKey(r)
	if not r then
		return "-"
	end
	return string.format("%d,%d,%d,%d", math.floor(r.x0), math.floor(r.y0), math.floor(r.x1), math.floor(r.y1))
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
-- What currently occupies the top-left slot: a match / party panel, the title card, and the design height
-- (0 while nothing does).
local function topLeftState()
	local hasPanel, hasTitle, h = false, false, 0
	if Items.Match and Items.Match.Shown and UI.Match then
		hasPanel = true
		h = math.max(h, UI.Match.Root.Size.Y.Offset)
	end
	if Items.Party and Items.Party.Shown and UI.Party then
		hasPanel = true
		h = math.max(h, UI.Party.Root.Size.Y.Offset)
	end
	if Items.Title and Items.Title.Shown then
		hasTitle = true
		h = math.max(h, K.TITLE_H)
	end
	return hasPanel, hasTitle, h
end

-- The currencies shown right now, top to bottom. In a match only Cloud Tokens count (and the stack stays
-- small next to the match panel); in the lobby every currency the player has.
local function visibleCurrencies()
	local list = {}
	local inMatch = S.match ~= nil or (player and player:GetAttribute(Config.Attr.InMatch) == true)
	for _, entry in ipairs(CURRENCY_ORDER) do
		local c = Cur[entry.Id]
		if c and c.Available and (c.Always or not inMatch) then
			table.insert(list, c)
		end
	end
	return list
end

-- Rows of a currency stack style: "Column" = one pill per row, "Pairs" = two compact pills per row (a last
-- single pill gets the full width).
local function stackRows(count, style)
	if style == "Pairs" then
		return math.ceil(count / 2)
	end
	return count
end

local function stackHeight(count, style)
	local rows = math.max(1, stackRows(count, style))
	return rows * K.CUR_H + (rows - 1) * K.CUR_GAP
end

-- Sets one corner holder's margins. The left margin eases to its new value when `animate` is set (a panel that
-- is showing grows a row and must not hop sideways); everything else snaps.
local function setPadding(name, left, top, right, bottom, animate)
	local pad = pads[name]
	if not pad then
		return
	end
	pad.PaddingTop = UDim.new(0, top)
	pad.PaddingRight = UDim.new(0, right)
	pad.PaddingBottom = UDim.new(0, bottom)
	if padGoals[name] == left then
		return -- already there, or already easing there
	end
	padGoals[name] = left
	local running = padTweens[name]
	if running then
		running:Cancel()
		padTweens[name] = nil
	end
	local goal = UDim.new(0, left)
	if animate and math.abs(pad.PaddingLeft.Offset - left) > 0.5 then
		padTweens[name] = tween(pad, 0.25, { PaddingLeft = goal })
	else
		pad.PaddingLeft = goal
	end
end

local function publish(name, value)
	value = math.floor((tonumber(value) or 0) + 0.5)
	if published[name] ~= value and UI.Gui then
		published[name] = value
		UI.Gui:SetAttribute(name, value)
	end
end

local layoutCurrencyRows -- (style, width) -> places the rows; defined with the currency code below
local setPanelWidth -- (designWidth) -> resizes the match / party panels; defined with the panels below
local setVitalsGeometry -- (VG.Regular | VG.Compact) -> places the vitals card's parts; defined with the card

-- Lays out the four corners. Inputs are measured every time; when nothing changed since the last call the
-- work is skipped (it runs twice a second). `animate` eases the top-left shift; `force` skips the check.
--   * desktop 1920x1080 (scale 1): vitals y 940-1010 (gui), the token pill right above them, panels top-left;
--   * phone landscape 844x390 (scale 0.8): vitals lifted ~90 px, the currency stack moves top-right;
--   * phone portrait 390x844: vitals lifted 150 px, squeezed between the menu column and the DASH button;
--     three currencies pair up (two compact pills per row) so the stack stays out of the screen centre.
local function applyMargins(animate, force)
	if not UI.Gui or not M then
		return
	end
	local touch = isTouchDevice()
	local side = touch and K.TOUCH_EDGE or K.EDGE
	local vp = viewportSize()
	local k = currentScale()
	local area = guiAreaSize()
	local inset = math.max(0, vp.Y - area.Y)
	local column = menuRect(area)
	local buttons = touch and mobileRects() or {}
	local hasPanel, hasTitle, topH = topLeftState()
	local currencies = visibleCurrencies()

	local parts = { area.X, area.Y, vp.X, vp.Y, k, touch and 1 or 0, hasPanel and 1 or 0, hasTitle and 1 or 0, topH, rectKey(column) }
	for _, c in ipairs(currencies) do
		table.insert(parts, c.Id)
	end
	for _, r in ipairs(buttons) do
		table.insert(parts, rectKey(r))
	end
	local key = table.concat(parts, "|")
	if not force and key == layoutKey and not animate then
		return
	end
	layoutKey = key

	local function clearOfColumn(top, bottom)
		if column and top < column.y1 + K.SPAN_MARGIN and bottom > column.y0 - K.SPAN_MARGIN then
			return math.max(side, column.x1 + K.MENU_CLEARANCE)
		end
		return side
	end
	local function rightLimit(top, bottom)
		local limit = area.X - side
		for _, r in ipairs(buttons) do
			if top < r.y1 + K.BUTTON_CLEARANCE and bottom > r.y0 - K.BUTTON_CLEARANCE then
				limit = math.min(limit, r.x0 - K.BUTTON_CLEARANCE)
			end
		end
		return limit
	end
	-- the middle of the screen the game must never write into (the layout rule), in gui-area pixels
	local band = {
		x0 = vp.X * (0.5 - K.CENTRE_TOL), x1 = vp.X * (0.5 + K.CENTRE_TOL),
		y0 = vp.Y * (0.5 - K.CENTRE_TOL) - inset, y1 = vp.Y * (0.5 + K.CENTRE_TOL) - inset,
	}
	local function inBand(x0, x1, y0, y1)
		return x0 < band.x1 and x1 > band.x0 and y0 < band.y1 and y1 > band.y0
	end

	-- how high the bottom-left block sits, and how tall the vitals card is
	local raise = K.EDGE
	local geometry = VG.Regular
	if touch then
		local want = (math.min(vp.X, vp.Y) <= K.SMALL_PHONE) and K.TOUCH_RAISE_SMALL or K.TOUCH_RAISE_LARGE
		-- short landscape screens: keep room for the tallest top-left panel (4-player match) above the vitals;
		-- when the regular card would sit right on the hotbar, the compact card takes its place
		local room = area.Y - K.EDGE - M.TopReserve * k - K.STACK_GAP * k
		if room - VG.Regular.H * k < K.TOUCH_RAISE_MIN + VG.COMPACT_SPARE then
			geometry = VG.Compact
		end
		raise = math.floor(Util.Clamp(math.min(want, room - geometry.H * k), K.TOUCH_RAISE_MIN, want))
	end
	if setVitalsGeometry then
		setVitalsGeometry(geometry)
	end
	local vitalsH = geometry.H

	-- vitals and the currency stack share one left edge (the column above them or beside them)
	local vitalsBottom = area.Y - raise
	local vitalsTop = vitalsBottom - vitalsH * k
	local curBottom = vitalsTop - K.STACK_GAP * k
	local reserveBottom = K.EDGE + M.TopReserve * k + K.STACK_GAP * k
	local n = math.max(1, #currencies)

	-- currency stack: above the vitals as a column, else paired up, else in the top-right corner
	local mode, style = "TopRight", (n >= 3) and "Pairs" or "Column"
	local blockLeft = clearOfColumn(vitalsTop, vitalsBottom)
	local curLeft = blockLeft
	local curW = K.CUR_W
	local candidates = { "Column" }
	if n >= 2 then
		table.insert(candidates, "Pairs")
	end
	for _, candidate in ipairs(candidates) do
		local h = stackHeight(n, candidate) * k
		local top = curBottom - h
		local left = math.max(blockLeft, clearOfColumn(top, curBottom))
		local minW = (candidate == "Pairs") and K.CUR_PAIR_MIN_W or K.CUR_MIN_W
		local w = math.floor(Util.Clamp((rightLimit(top, curBottom) - left) / k, minW, K.CUR_W))
		if inBand(left, left + w * k, top, curBottom) then
			-- a slightly narrower stack may stay clear of the middle
			w = math.max(minW, math.floor(math.min(w, (band.x0 - left) / k)))
		end
		if top >= reserveBottom and not inBand(left, left + w * k, top, curBottom) then
			mode, style, curLeft, curW = "BottomLeft", candidate, left, w
			break
		end
	end
	if mode == "BottomLeft" then
		blockLeft = curLeft
	end

	local vitalsRoom = rightLimit(vitalsTop, vitalsBottom) - blockLeft
	local vitalsW = math.floor(Util.Clamp(vitalsRoom / k, K.VITALS_MIN_W, K.VITALS_W))
	if UI.Vitals then
		UI.Vitals.Size = UDim2.fromOffset(vitalsW, vitalsH)
		UI.Vitals.Position = UDim2.new(0, blockLeft, 1, -raise)
	end

	local stackH = stackHeight(n, style)
	local topRightBottom, topRightLeft = 0, 0
	local bottomLeftTop = vitalsTop
	if UI.Currency then
		if layoutCurrencyRows then
			layoutCurrencyRows(currencies, style, curW)
		end
		UI.Currency.Size = UDim2.fromOffset(curW, stackH)
		if mode == "BottomLeft" then
			UI.Currency.Parent = UI.BottomLeft
			UI.Currency.AnchorPoint = Vector2.new(0, 1)
			UI.Currency.Position = UDim2.new(0, curLeft, 1, -(raise + (vitalsH + K.STACK_GAP) * k))
			bottomLeftTop = curBottom - stackH * k
		else
			UI.Currency.Parent = UI.TopRight
			UI.Currency.AnchorPoint = Vector2.new(1, 0)
			UI.Currency.Position = UDim2.new(1, -side, 0, K.EDGE)
			topRightBottom = K.EDGE + stackH * k
			topRightLeft = area.X - side - curW * k
		end
	end
	S.currencyMode = mode

	-- top-left panels: right of the menu column when they would reach it, and on short screens no wider than
	-- what keeps their text out of the middle of the screen
	local topLeft = side
	local panelW = K.PANEL_W
	if topH > 0 then
		topLeft = clearOfColumn(K.EDGE, K.EDGE + topH * k)
		if K.EDGE + topH * k > band.y0 then
			panelW = math.floor(Util.Clamp((band.x0 - topLeft - 4) / k, K.PANEL_MIN_W, K.PANEL_W))
		end
	end
	if setPanelWidth then
		setPanelWidth(panelW)
	end
	setPadding("TopLeft", topLeft, K.EDGE, 0, 0, animate)
	setPadding("TopRight", 0, 0, 0, 0)
	setPadding("BottomLeft", 0, 0, 0, 0)

	-- tell the neighbours (toasts, side panels) where the HUD is, in gui-area pixels
	local topW = 0
	if hasPanel then
		topW = panelW
	end
	if hasTitle then
		topW = math.max(topW, K.TITLE_W)
	end
	publish("HudScale100", k * 100)
	publish("TopLeftRight", topH > 0 and (topLeft + topW * k) or 0)
	publish("TopLeftBottom", topH > 0 and (K.EDGE + topH * k) or 0)
	publish("TopRightBottom", topRightBottom)
	publish("TopRightLeft", topRightLeft)
	publish("BottomLeftTop", bottomLeftTop)
	if UI.Gui:GetAttribute("CurrencyMode") ~= mode then
		UI.Gui:SetAttribute("CurrencyMode", mode)
	end
end

local function relayout()
	local k = currentScale()
	for i = #scalers, 1, -1 do
		local s = scalers[i]
		if s.Parent then
			s.Scale = k
		else
			table.remove(scalers, i)
		end
	end
	applyMargins(false, true)
end

-- Layout numbers of the match / party panels (design px, 1080p). Text is 18+ everywhere, so it stays
-- >= 14 px on a phone; touch devices get a taller Leave button (it then owns the top-right corner of the
-- match panel and the token line drops under it, at the full right edge: squeezed inset left of the button,
-- it ran into the timer / countdown numeral on landscape phones).
local function panelMetrics(touch)
	local m = {
		LeaveW = 88, LeaveH = 32, LeaveText = 20,
		TitleH = 32, TitleText = 28,
		TimerY = 52, TimerH = 38, TimerText = 34, CountText = 42,
		TokensText = 22, TokensY = 52, TokensH = 38, -- the token line (centre y) shares the timer row
		CpY = 76, CpH = 24, CpText = 18,
		ChipH = 30, RowPitch = 34, NameText = 18, StateText = 18,
		-- party panel (a locked portal: Leave is the only way out, so it is big and sits beside the title),
		-- then the countdown row, the member chips and a "Locked until launch" line with the head count
		PartyLeaveW = 116, PartyLeaveNarrowW = 100, PartyLeaveH = 46, PartyLeaveText = 24, -- narrow: squeezed panels
		PartyStatusH = 30, PartyStatusText = 22, PartyHintH = 24, PartyHintText = 18, PartyCountW = 58,
	}
	if touch then
		m.LeaveW, m.LeaveH = 92, 40
		-- right under the Leave button (y 41-69): clear of it, of the checkpoint bar (76+) and of the timer text
		m.TokensY, m.TokensH = m.LeaveH + 15, 28
		m.PartyLeaveH, m.PartyLeaveText = 56, 26 -- a fat thumb target (>= 44 px on screen at the 0.8 phone scale)
	end
	m.TeamY = m.CpY + m.CpH + 8
	m.PartyTeamY = m.PartyLeaveH + 6 + m.PartyStatusH + 6
	-- panel = content inset top (cloud bumps) + bottom pad + the inner frame's 6 px top / bottom margins
	local insetTop, _, insetBottom = CloudUI.ContentInset(false, true)
	m.Frame = insetTop + insetBottom + 12
	m.MatchBaseH = m.Frame + m.TeamY - (m.RowPitch - m.ChipH) -- + RowPitch per chip row
	m.PartyBaseH = m.Frame + m.PartyTeamY - (m.RowPitch - m.ChipH) + 6 + m.PartyHintH -- + RowPitch per chip row
	m.TopReserve = math.max(m.MatchBaseH, m.PartyBaseH) + 2 * m.RowPitch -- the tallest top-left panel (4 players)
	return m
end

----------------------------------------------------------------------
-- Default CoreGui (health bar + player list)
----------------------------------------------------------------------
local HIDDEN_CORE = { Enum.CoreGuiType.Health, Enum.CoreGuiType.PlayerList }

-- Separate pcalls so a failure on one does not skip the other.
local function hideDefaultCoreGui()
	local allOk = true
	for _, coreType in ipairs(HIDDEN_CORE) do
		local ok = pcall(function()
			StarterGui:SetCoreGuiEnabled(coreType, false)
		end)
		allOk = allOk and ok
	end
	return allOk
end

local function disableDefaultHealth()
	task.spawn(function()
		for _ = 1, 60 do
			if hideDefaultCoreGui() then
				task.wait(3) -- the core scripts may re-enable them while loading: apply once more
				hideDefaultCoreGui()
				return
			end
			task.wait(0.5)
		end
	end)
	pcall(function()
		track(StarterGui.CoreGuiChangedSignal:Connect(function(coreType, enabled)
			if enabled and (coreType == Enum.CoreGuiType.Health or coreType == Enum.CoreGuiType.PlayerList) then
				pcall(function()
					StarterGui:SetCoreGuiEnabled(coreType, false)
				end)
			end
		end))
	end)
end

----------------------------------------------------------------------
-- Build: vitals card (bottom-left)
----------------------------------------------------------------------
-- One card in the style of the currency pills: a glossy navy plate with a thick outline; the heart badge
-- beside a thick HP tube ("117 / 117", white damage trail, hit flash + card shake, low-health pulse); the
-- lightning badge beside a matching stamina tube (eases on drain / refill, dims when run dry); the dash ring
-- (a sweep that fills clockwise while the dash recharges). Shapes are Frames (no font glyphs, no images);
-- the parts are placed by setVitalsGeometry (VG.Regular / VG.Compact).

-- Glossy fill of a vitals tube: a soft light top, the base colour, a gentle darker band at the bottom.
function Vitals.BarSequence(color)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Lighten(color, 0.45)),
		ColorSequenceKeypoint.new(0.4, color),
		ColorSequenceKeypoint.new(0.72, Theme.Darken(color, 0.05)),
		ColorSequenceKeypoint.new(0.76, Theme.Darken(color, 0.2)),
		ColorSequenceKeypoint.new(1, Theme.Darken(color, 0.24)),
	})
end

-- A chunky tube: dark inset track with a rounded outline, an optional white damage trail behind a gradient
-- fill with a highlight strip, a white flash layer on the fill and an optional centred number.
-- opts: Color, Trail (bool), Text. Placed and sized by setVitalsGeometry.
function Vitals.NewBar(parent, name, opts)
	local root = newFrame(parent, name, {
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		ZIndex = 2,
	})
	round(root)
	Theme.Stroke(root, VS.Edge, 3, 0)
	Theme.Gradient(root, VS.TrackTop, VS.TrackBottom, 90)

	local inner = newFrame(root, "Inner", {
		Position = UDim2.fromOffset(3, 3),
		Size = UDim2.new(1, -6, 1, -6),
	})
	local trail = nil
	if opts.Trail then
		trail = newFrame(inner, "DamageTrail", {
			BackgroundTransparency = 0.04,
			BackgroundColor3 = WHITE,
			Size = UDim2.fromScale(1, 1),
			ZIndex = 1,
		})
		round(trail)
	end
	local fill = newFrame(inner, "Fill", {
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	})
	round(fill)
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = Vitals.BarSequence(opts.Color)
	gradient.Parent = fill
	local shine = newFrame(fill, "Shine", {
		Position = UDim2.new(0, 7, 0.1, 0),
		Size = UDim2.new(1, -14, 0.26, 0),
		BackgroundTransparency = 0.45,
		BackgroundColor3 = WHITE,
		ZIndex = 3,
	})
	round(shine)
	local flash = newFrame(fill, "Flash", {
		BackgroundTransparency = 1,
		BackgroundColor3 = WHITE,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 4,
	})
	round(flash)
	local label = nil
	if opts.Text then
		label = newText(root, "Text", opts.Text, "Display", 26, WHITE, {
			TextXAlignment = Enum.TextXAlignment.Center,
			Position = UDim2.fromOffset(0, -1),
			Stroke = 0.1,
			Outline = 2.5,
			ZIndex = 6,
		})
	end

	local bar = { Root = root, Inner = inner, Fill = fill, Trail = trail, Flash = flash, Label = label }
	local shownFill, shownTrail = -1, -1
	function bar.SetFraction(value)
		value = Util.Clamp(tonumber(value) or 0, 0, 1)
		if value == shownFill then
			return
		end
		shownFill = value
		fill.Size = UDim2.fromScale(value, 1)
		-- the highlight strip is inset: it only fits once the fill is wider than tall
		local size = inner.AbsoluteSize
		shine.Visible = size.X * value >= size.Y
	end
	function bar.SetTrail(value)
		value = Util.Clamp(tonumber(value) or 0, 0, 1)
		if trail and value ~= shownTrail then
			shownTrail = value
			trail.Size = UDim2.fromScale(value, 1)
		end
	end
	function bar.SetColor(color)
		gradient.Color = Vitals.BarSequence(color)
	end
	function bar.Invalidate()
		shownFill = -1 -- the size changed: re-check the highlight strip on the next SetFraction
	end
	function bar.SetText(text)
		if label then
			label.Text = tostring(text or "")
		end
	end
	return bar
end

-- A heart from a square turned 45 degrees and two round lobes, filling `fraction` of its square parent.
-- Everything is in scale units, so it follows the badge's size.
function Vitals.HeartShape(parent, name, fraction, color, zIndex)
	local box = newFrame(parent, name, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(fraction, fraction),
		ZIndex = zIndex,
	})
	-- side a = 1 / (1 + sqrt(2) / 2) of the box width; lobes centred on the upper edges of the turned square
	local a, cy, d = 0.5858, 0.5431, 0.2071
	local tip = newFrame(box, "Tip", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, cy),
		Size = UDim2.fromScale(a, a),
		Rotation = 45,
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		ZIndex = zIndex,
	})
	Theme.Corner(tip, UDim.new(0, 2))
	for i, side in ipairs({ -1, 1 }) do
		local lobe = newFrame(box, (i == 1) and "LobeL" or "LobeR", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5 + side * d, cy - d),
			Size = UDim2.fromScale(a, a),
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			ZIndex = zIndex,
		})
		round(lobe)
	end
	return box
end

-- A chunky lightning bolt (a zig-zag of three rounded bars) filling `fraction` of its square parent.
function Vitals.BoltShape(parent, name, fraction, color, zIndex)
	local box = newFrame(parent, name, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(fraction, fraction),
		ZIndex = zIndex,
	})
	-- centre x, centre y, width, height (fractions of the box), rotation
	local parts = {
		{ 0.47, 0.27, 0.29, 0.62, 25 },
		{ 0.5, 0.5, 0.62, 0.24, -12 },
		{ 0.53, 0.73, 0.29, 0.62, 25 },
	}
	for i, p in ipairs(parts) do
		local part = newFrame(box, "Part" .. i, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(p[1], p[2]),
			Size = UDim2.fromScale(p[3], p[4]),
			Rotation = p[5],
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			ZIndex = zIndex,
		})
		Theme.Corner(part, UDim.new(0, 2))
	end
	return box
end

function Vitals.SetShapeTransparency(box, transparency)
	for _, part in ipairs(box:GetChildren()) do
		if part:IsA("GuiObject") then
			part.BackgroundTransparency = transparency
		end
	end
end

-- The dash ring: a round face with the dash glyph inside a ring whose sweep fills clockwise from 12 o'clock
-- as the cooldown runs out. The sweep is two half-discs, each clipped to its half of the ring, with a
-- hard-step transparency gradient turned to the sweep angle (see setSweep). Sized by setVitalsGeometry.
function Vitals.NewDashRing(parent)
	local root = newFrame(parent, "DashRing", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		ZIndex = 3,
	})
	round(root)
	Theme.Stroke(root, VS.Edge, 3, 0)
	Theme.Gradient(root, VS.TrackTop, VS.TrackBottom, 90)
	local sweep = newFrame(root, "Sweep", {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
	})
	local halves = {}
	for i, side in ipairs({ "Right", "Left" }) do
		local clip = newFrame(sweep, "Half" .. side, {
			Position = UDim2.fromScale((side == "Right") and 0.5 or 0, 0),
			Size = UDim2.fromScale(0.5, 1),
			ClipsDescendants = true,
		})
		local disc = newFrame(clip, "Disc", {
			Position = UDim2.fromScale((side == "Right") and -1 or 0, 0),
			Size = UDim2.fromScale(2, 1),
			BackgroundTransparency = 0,
			BackgroundColor3 = VS.Arc,
		})
		round(disc)
		local g = Instance.new("UIGradient")
		g.Transparency = VS.Solid
		g.Parent = disc
		halves[i] = { Disc = disc, Gradient = g }
	end
	local face, faceGradient, faceStroke = newBadge(root, "Face", 20, Colors.Stamina, Theme.Lighten(Colors.Stamina, 0.45))
	face.AnchorPoint = Vector2.new(0.5, 0.5)
	face.Position = UDim2.fromScale(0.5, 0.5)
	face.ZIndex = 2
	faceStroke.Thickness = 2
	local glyph = newText(face, "Glyph", "\194\187", "Display", 20, WHITE, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Position = UDim2.fromOffset(1, -2),
		Stroke = 0.2,
		StrokeColor = Theme.Darken(Colors.Stamina, 0.7),
		Outline = 2,
		OutlineColor = Theme.Darken(Colors.Stamina, 0.7),
		ZIndex = 2,
	})
	return {
		Root = root, Halves = halves, Face = face, FaceGradient = faceGradient, Glyph = glyph,
		GlyphOutline = glyph:FindFirstChild("TextOutline"), Scale = newScale(root, 1), Solid = true,
	}
end

-- Places every part of the card for one geometry (VG.Regular or VG.Compact); a no-op when unchanged.
setVitalsGeometry = function(g)
	if UI.VitalsGeometry == g or not UI.HpBar then
		return
	end
	UI.VitalsGeometry = g
	UI.Card.Position = UDim2.fromOffset(g.CARD_X, 0)
	UI.Card.Size = UDim2.new(1, -g.CARD_X, 0, g.CARD_H)
	UI.CardCorner.CornerRadius = UDim.new(0, g.CARD_CORNER)
	UI.RimCorner.CornerRadius = UDim.new(0, g.CARD_CORNER - 2)

	-- the ring ends the stamina row, or (RING_SPAN) both rows
	local ringRoom = g.RING + g.RING_GAP
	UI.HpBar.Root.Position = UDim2.fromOffset(g.HP_X, g.HP_Y)
	UI.HpBar.Root.Size = UDim2.new(1, -(g.HP_X + g.PAD_R + (g.RING_SPAN and ringRoom or 0)), 0, g.HP_H)
	UI.HpBar.Label.TextSize = g.HP_TEXT
	UI.StBar.Root.Position = UDim2.fromOffset(g.ST_X, g.ST_Y)
	UI.StBar.Root.Size = UDim2.new(1, -(g.ST_X + g.PAD_R + ringRoom), 0, g.ST_H)
	UI.HpBar.Invalidate()
	UI.StBar.Invalidate()

	local ring = UI.Ring
	ring.Root.Position = UDim2.new(1, -(g.PAD_R + g.RING / 2), 0, g.RING_Y)
	ring.Root.Size = UDim2.fromOffset(g.RING, g.RING)
	ring.Face.Size = UDim2.fromOffset(g.RING_FACE, g.RING_FACE)
	ring.Glyph.TextSize = g.RING_TEXT

	UI.Heart.Position = UDim2.fromOffset(g.BADGE_X, g.HEART_Y)
	UI.Heart.Size = UDim2.fromOffset(g.HEART, g.HEART)
	UI.HeartGlyph.TextSize = g.HEART_TEXT
	UI.Bolt.Badge.Position = UDim2.fromOffset(g.BADGE_X, g.BOLT_Y)
	UI.Bolt.Badge.Size = UDim2.fromOffset(g.BOLT, g.BOLT)

	UI.DownedNotice.Position = UDim2.fromOffset(g.CARD_X + 12, g.ST_Y - 5)
	UI.DownedNotice.Size = UDim2.new(1, -(g.CARD_X + 12 + g.PAD_R), 0, g.ST_H + 10)
end

local function buildVitals(holder)
	local root = newFrame(holder, "Vitals", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, K.EDGE, 1, -K.EDGE),
		Size = UDim2.fromOffset(K.VITALS_W, K.VITALS_H),
	})
	addViewportScale(root)
	UI.Vitals = root
	-- the layout owns the root's position; the damage shake nudges this full-size body instead
	local body = newFrame(root, "Body", { Size = UDim2.fromScale(1, 1) })
	UI.VitalsBody = body

	-- the card plate: the currency pills' glossy navy with a thin light bevel inside the outline
	local card = newFrame(body, "Card", {
		BackgroundTransparency = 0.04,
		BackgroundColor3 = WHITE,
	})
	UI.Card = card
	UI.CardCorner = Theme.Corner(card)
	UI.CardStroke = Theme.Stroke(card, NAVY, 3, 0)
	Theme.Gradient(card, Colors.PanelLight, Colors.Panel, 90)
	local rim = newFrame(card, "Rim", {
		Position = UDim2.fromOffset(2, 2),
		Size = UDim2.new(1, -4, 1, -4),
	})
	UI.RimCorner = Theme.Corner(rim)
	Theme.Stroke(rim, WHITE, 1.5, 0.82)

	-- health tube with the damage trail, then the thinner stamina tube (ends left of the dash ring)
	UI.HpBar = Vitals.NewBar(body, "HealthBar", { Color = Colors.Health, Trail = true, Text = "100 / 100" })
	UI.StBar = Vitals.NewBar(body, "StaminaBar", { Color = Colors.Stamina })
	UI.Ring = Vitals.NewDashRing(body)

	-- lightning badge (under the heart), then the heart badge on top
	local bolt, boltGradient = newBadge(body, "StaminaBadge", 36, VS.BoltBlue, Theme.Lighten(VS.BoltBlue, 0.45))
	bolt.AnchorPoint = Vector2.new(0.5, 0.5)
	bolt.ZIndex = 5
	local boltShadow = Vitals.BoltShape(bolt, "BoltShadow", 0.68, Theme.Darken(VS.BoltBlue, 0.6), 2)
	boltShadow.Position = UDim2.new(0.5, 0, 0.5, 2)
	UI.Bolt = {
		Badge = bolt, Gradient = boltGradient, Shadow = boltShadow,
		Shape = Vitals.BoltShape(bolt, "Bolt", 0.68, WHITE, 3),
	}

	local heart = newBadge(body, "Heart", 52, HEART_RED, Theme.Lighten(HEART_RED, 0.38))
	heart.AnchorPoint = Vector2.new(0.5, 0.5)
	heart.ZIndex = 6
	UI.HeartShadow = Vitals.HeartShape(heart, "HeartShadow", 0.58, Theme.Darken(HEART_RED, 0.6), 2)
	UI.HeartShadow.Position = UDim2.new(0.5, 0, 0.5, 3)
	UI.HeartShape = Vitals.HeartShape(heart, "HeartShape", 0.58, WHITE, 3)
	UI.HeartScale = newScale(heart, 1)
	UI.Heart = heart
	UI.HeartGlyph = newText(heart, "Glyph", "!", "Display", 34, WHITE, {
		TextXAlignment = Enum.TextXAlignment.Center,
		Stroke = 0.2,
		StrokeColor = Theme.Darken(HEART_RED, 0.6),
		Outline = 2.5,
		OutlineColor = Theme.Darken(HEART_RED, 0.6),
		Visible = false,
		ZIndex = 4,
	})

	-- "Wait for a teammate!" replaces the stamina row while downed (no running or dashing then anyway)
	UI.DownedNotice = newText(body, "DownedNotice", "Wait for a teammate!", "Display", 21, Colors.Bad, {
		TextXAlignment = Enum.TextXAlignment.Center,
		TextScaled = true,
		Stroke = 0.1,
		Outline = 2,
		Visible = false,
		ZIndex = 5,
	})
	Util.Create("UITextSizeConstraint", { MaxTextSize = 22, MinTextSize = 18, Parent = UI.DownedNotice })
	setVitalsGeometry(VG.Regular)
end

----------------------------------------------------------------------
-- Build: currency stack (bottom-left above the vitals, or top-right on short screens)
----------------------------------------------------------------------
local function buildCurrencyRow(parent, entry)
	local def = entry.Def or {}
	local color = def.Color or Colors.Token
	local glow = def.Glow or Colors.TokenGlow
	local row = newFrame(parent, "Currency_" .. entry.Id, {
		Size = UDim2.fromOffset(K.CUR_W, K.CUR_H),
		Visible = false,
	})

	-- the pill (its left end hides behind the coin)
	local body = newFrame(row, "Body", {
		BackgroundTransparency = 0.04,
		BackgroundColor3 = WHITE,
	})
	round(body)
	Theme.Stroke(body, NAVY, 3, 0)
	Theme.Gradient(body, Colors.PanelLight, Colors.Panel, 90)
	local shine = newFrame(body, "Shine", {
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundTransparency = 0.82,
		BackgroundColor3 = WHITE,
	})
	round(shine)
	-- a thin coloured rim at the bottom of the pill ties it to its coin colour
	local lip = newFrame(body, "Lip", {
		AnchorPoint = Vector2.new(0.5, 1),
		BackgroundTransparency = 0.45,
		BackgroundColor3 = color,
	})
	round(lip)

	local coin = newCoin(row, "Coin", K.COIN, color, glow, def.Glyph or "?", 30)
	coin.AnchorPoint = Vector2.new(0, 0.5)
	coin.Position = UDim2.new(0, 0, 0.5, 0)
	coin.ZIndex = 3

	local amount = newText(row, "Amount", "0", "Display", 32, WHITE, {
		AnchorPoint = Vector2.new(0, 0.5),
		Stroke = 0.15,
		Outline = 2.5,
		ZIndex = 3,
	})

	local c = {
		Id = entry.Id, Def = def, Attr = entry.Attr, Always = entry.Always == true,
		Row = row, Body = body, Shine = shine, Lip = lip, Coin = coin, CoinGlyph = coin:FindFirstChild("Glyph"),
		Amount = amount, AmountScale = newScale(amount, 1), CoinScale = newScale(coin, 1),
		Target = 0, Display = 0, Shown = nil, Seen = false, Available = false, ChipShown = false,
		Width = K.CUR_W, Compact = nil,
	}

	if entry.Run then
		local chip = newFrame(row, "RunChip", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -7, 0.5, 0),
			Size = UDim2.fromOffset(K.CHIP_W, 32),
			BackgroundTransparency = 0.05,
			BackgroundColor3 = Theme.Darken(color, 0.5),
			Visible = false,
			ZIndex = 4,
		})
		round(chip)
		Theme.Stroke(chip, color, 2, 0.1)
		c.Chip = chip
		c.RunLabel = newText(chip, "Run", "+0", "Accent", 21, glow, {
			TextXAlignment = Enum.TextXAlignment.Center,
			Stroke = 0.2,
			Outline = 1.5,
			ZIndex = 5,
		})
		c.RunScale = newScale(c.RunLabel, 1)
	end
	return c
end

-- Inner geometry of one pill: a full pill has the big coin, a compact (paired) one a smaller coin.
local function setRowGeometry(c, compact)
	if c.Compact == compact then
		return
	end
	c.Compact = compact
	local coinSize = compact and K.COIN_COMPACT or K.COIN
	c.Coin.Size = UDim2.fromOffset(coinSize, coinSize)
	if c.CoinGlyph then
		c.CoinGlyph.TextSize = compact and 24 or 30
	end
	c.Body.Position = UDim2.fromOffset(math.floor(coinSize * 0.4), 0)
	c.Body.Size = UDim2.new(1, -math.floor(coinSize * 0.4), 1, 0)
	c.Shine.Position = UDim2.new(0.5, math.floor(coinSize * 0.25), 0, 4)
	c.Shine.Size = UDim2.new(1, -math.floor(coinSize * 0.9), 0, 7)
	c.Lip.Position = UDim2.new(0.5, math.floor(coinSize * 0.25), 1, -4)
	c.Lip.Size = UDim2.new(1, -math.floor(coinSize * 0.9), 0, 3)
	c.Amount.Position = UDim2.new(0, coinSize + 8, 0.5, -1)
end

local function buildCurrency(holder)
	local root = newFrame(holder, "Currency", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, K.EDGE, 1, -K.EDGE - K.VITALS_H - K.STACK_GAP),
		Size = UDim2.fromOffset(K.CUR_W, K.CUR_H),
	})
	addViewportScale(root)
	UI.Currency = root
	for _, entry in ipairs(CURRENCY_ORDER) do
		if entry.Attr ~= nil or entry.Always then
			Cur[entry.Id] = buildCurrencyRow(root, entry)
		end
	end
end

----------------------------------------------------------------------
-- Build: team / party chips (shared by the match and party panels)
----------------------------------------------------------------------
-- A small name plate: name, optional state glyph, optional mini health bar.
local function newChip(parent, index, withHealth)
	local frame = newFrame(parent, "Chip" .. tostring(index), {
		BackgroundTransparency = 0.15,
		BackgroundColor3 = Colors.Ink,
		Size = UDim2.fromOffset(120, M.ChipH),
		LayoutOrder = index,
		Visible = false,
	})
	Theme.Corner(frame, UDim.new(0, 9))
	local stroke = Theme.Stroke(frame, Colors.PanelLight, 2, 0.2)
	local name = newText(frame, "Name", "", "Body", M.NameText, WHITE, {
		Position = UDim2.new(0, 8, 0, withHealth and -2 or 0),
		-- party chips (no health) never show a state glyph: their names get that room too
		Size = UDim2.new(1, withHealth and -34 or -16, 1, withHealth and -4 or 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		Stroke = 0.3,
	})
	local state = newText(frame, "State", "", "Heading", M.StateText, WHITE, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -6, 0, withHealth and -2 or 0),
		Size = UDim2.new(0, 24, 1, withHealth and -4 or 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local fill = nil
	if withHealth then
		local track_ = newFrame(frame, "HpTrack", {
			Position = UDim2.new(0, 8, 1, -8),
			Size = UDim2.new(1, -16, 0, 5),
			BackgroundTransparency = 0.1,
			BackgroundColor3 = Colors.Panel,
		})
		round(track_)
		fill = newFrame(track_, "Fill", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 0,
			BackgroundColor3 = Colors.Health,
		})
		round(fill)
	end
	return { Frame = frame, Stroke = stroke, Name = name, State = state, Fill = fill }
end

-- Lays out `count` chips in a grid of two columns inside a holder `width` wide. Returns the row count.
local function layoutChips(chips, count, width)
	local cols = (count >= 2) and 2 or 1
	local gap = 6
	local cellW = math.floor((width - gap * (cols - 1)) / cols)
	local rows = math.max(1, math.ceil(count / cols))
	for i, chip in ipairs(chips) do
		if i <= count then
			local col = (i - 1) % cols
			local row = math.floor((i - 1) / cols)
			chip.Frame.Position = UDim2.fromOffset(col * (cellW + gap), row * M.RowPitch)
			chip.Frame.Size = UDim2.fromOffset(cellW, M.ChipH)
			chip.Frame.Visible = true
		else
			chip.Frame.Visible = false
		end
	end
	return rows
end

-- inner width of the match / party panels (panel - frame pads - inner margins)
local function innerWidth()
	return S.panelW - 2 * CloudUI.Metrics.Pad - 20
end

