	------------------------------------------------------------ Leaders
	local leaders = page("Leaderboard")
	ui.LeaderScroll = scroller(leaders, "Scroll", {})
	pad(ui.LeaderScroll, 2, 2, 12, 6)
	listLayout(ui.LeaderScroll, Enum.FillDirection.Vertical, 8)

	win.OnLayout = function(w, h, narrow, short, tall)
		local cw = w - K.INSET_X
		local barH = tall and 108 or 50
		ui.Bar.Size = UDim2.new(1, -28, 0, barH)
		local tabW = tall and math.floor((cw - 28 - 16) / 3) or (narrow and 180 or 200)
		for _, tab in ipairs(TABS) do
			local button = ui.TabButtons[tab.Id]
			button.Size = UDim2.fromOffset(tabW, 46)
			button.TextSize = tall and 20 or 22
			button.Text = tall and (tab.Short or tab.Label) or tab.Label
		end
		if tall then
			ui.TabRow.Size = UDim2.new(1, 0, 0, 48)
			ui.Chip.AnchorPoint = Vector2.new(0, 0)
			ui.Chip.Position = UDim2.fromOffset(0, 58)
		else
			ui.TabRow.Size = UDim2.new(1, -180, 1, 0)
			ui.Chip.AnchorPoint = Vector2.new(1, 0.5)
			ui.Chip.Position = UDim2.new(1, 0, 0.5, 0)
		end
		local top = 10 + barH + 12
		for _, frame in pairs(ui.Pages) do
			frame.Position = UDim2.fromOffset(14, top)
			frame.Size = UDim2.new(1, -28, 1, -(top + 10))
		end
		ui.RaidScroll.Size = UDim2.new(1, 0, 1, 0)
		ui.LeaderScroll.Size = UDim2.new(1, 0, 1, 0)
		if tall then
			ui.DuelLeft.Position = UDim2.fromOffset(0, 0)
			ui.DuelLeft.Size = UDim2.new(1, 0, 0.58, -6)
			ui.Challenge.Position = UDim2.new(0, 0, 0.58, 6)
			ui.Challenge.Size = UDim2.new(1, 0, 0.42, -6)
		else
			local leftW = math.floor((cw - 28) * 0.48)
			ui.DuelLeft.Position = UDim2.fromOffset(0, 0)
			ui.DuelLeft.Size = UDim2.new(0, leftW, 1, 0)
			ui.Challenge.Position = UDim2.fromOffset(leftW + 12, 0)
			ui.Challenge.Size = UDim2.new(1, -(leftW + 12), 1, 0)
		end
		ui.JoinWhy.Visible = not tall
		ui.BossName.TextSize = tall and 24 or 30
	end

	local function inviteRow(parent, invite, order)
		local row = makeFrame(parent, "Invite" .. order, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(60, 40, 90),
			Size = UDim2.new(1, 0, 0, 104),
			LayoutOrder = order,
		})
		corner(row, 12)
		stroke(row, C.Arena, 3, 0)
		makeText(row, "Name", G.Swords .. " " .. tostring(invite.FromName or "Someone") .. " challenges you!", "Heading", 20, WHITE, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -24, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		makeText(row, "Info", G.Trophy .. " " .. commas(invite.Trophies or 0) .. "    " .. G.Swords .. " " .. commas(invite.Power or 0)
			.. "    " .. clock(lobbySeconds(invite.ExpiresIn) or 0), "Body", 19, MUTED, {
			Position = UDim2.fromOffset(12, 34),
			Size = UDim2.new(1, -24, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		CloudUI.Button({
			Name = "Accept",
			Text = "Accept",
			Position = UDim2.fromOffset(12, 60),
			Size = UDim2.fromOffset(140, 40),
			Style = "Green",
			TextSize = 20,
			Parent = row,
			Callback = function()
				request("ChallengeReply", invite.FromUserId, true)
			end,
		})
		CloudUI.Button({
			Name = "Decline",
			Text = "Decline",
			Position = UDim2.fromOffset(160, 60),
			Size = UDim2.fromOffset(140, 40),
			Style = "Gray",
			TextSize = 20,
			Parent = row,
			Callback = function()
				request("ChallengeReply", invite.FromUserId, false)
			end,
		})
		return row
	end

	local function playerRow(player, order, sent)
		local row = makeFrame(ui.ChallengeList, "Player_" .. player.UserId, {
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(34, 50, 100),
			Size = UDim2.new(1, 0, 0, 62),
			LayoutOrder = order,
		})
		corner(row, 12)
		stroke(row, NAVY, 3, 0)
		makeText(row, "Name", player.DisplayName ~= "" and player.DisplayName or player.Name, "Title", 22, WHITE, {
			Position = UDim2.fromOffset(12, 4),
			Size = UDim2.new(1, -190, 0, 30),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		local trophies = trophiesOf(player.UserId)
		makeText(row, "Trophies", G.Trophy .. " " .. (trophies and commas(trophies) or "?"), "Heading", 18, C.Power, {
			Position = UDim2.fromOffset(12, 34),
			Size = UDim2.new(1, -190, 0, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		if sent then
			local pill = colorPill(row, "Sent", "Sent " .. clock(lobbySeconds(sent.ExpiresIn) or 0), Color3.fromRGB(110, 118, 146), 18, 0)
			pill.AnchorPoint = Vector2.new(1, 0.5)
			pill.Position = UDim2.new(1, -12, 0.5, 0)
		else
			local button = CloudUI.Button({
				Name = "Challenge",
				Text = "Challenge",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(160, 46),
				Style = "Red",
				TextSize = 21,
				Parent = row,
				Callback = function()
					if inArena() == false then
						toast("Walk into the Battle Arena to duel!", "info")
						return
					end
					request("Challenge", player.UserId)
				end,
			})
			CloudUI.SetDisabled(button, S.Lobby ~= nil and S.Lobby.Sent ~= nil)
		end
		return row
	end

	local function refreshDuels()
		local lobby = S.Lobby or {}
		local queue = type(lobby.Queue) == "table" and lobby.Queue or {}
		if queue.Queued then
			local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
			ui.QueueStatus.Text = "Searching... " .. clock(seconds) .. "   (" .. commas(queue.Waiting or 1) .. " in the queue)"
			ui.QueueButton.Text = "Leave queue"
			CloudUI.SetStyle(ui.QueueButton, "Gray")
		else
			local waiting = tonumber(queue.Waiting) or 0
			ui.QueueStatus.Text = waiting > 0 and (commas(waiting) .. " waiting for a match right now") or "Nobody is queued yet: be the first!"
			ui.QueueButton.Text = "Find a match"
			CloudUI.SetStyle(ui.QueueButton, "Green")
		end
		CloudUI.SetDisabled(ui.QueueButton, battleId() ~= nil)
		local b = battleData()
		ui.RecordText.Text = G.Trophy .. " " .. commas(b.Trophies or 0) .. " trophies     " .. commas(b.PvPWins or 0) .. " won " .. G.Bullet .. " "
			.. commas(b.PvPLosses or 0) .. " lost"
		local BC = catalog()
		local rules = BC and type(BC.Trophies) == "table" and BC.Trophies or nil
		if rules and ui.RecordRules then
			ui.RecordRules.Text = "Win: +" .. commas(rules.Win or 0) .. " " .. G.Trophy .. "   Loss: " .. tostring(rules.Loss or 0) .. " "
				.. G.Trophy .. "   Nobody ever loses a pet!"
		end
		-- incoming invites
		clearChildren(ui.InviteBox)
		local invites = type(lobby.Invites) == "table" and lobby.Invites or {}
		ui.InviteBox.Visible = #invites > 0
		if #invites > 0 then
			makeText(ui.InviteBox, "Title", "Challenges for you", "Heading", 22, WHITE, {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 0,
			})
			for i, invite in ipairs(invites) do
				if type(invite) == "table" then
					inviteRow(ui.InviteBox, invite, i)
				end
			end
		end
		-- players to challenge
		clearChildren(ui.ChallengeList)
		makeText(ui.ChallengeList, "Title", "Challenge a player", "Title", 26, WHITE, {
			Size = UDim2.new(1, 0, 0, 32),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0,
		})
		local others = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer then
				others[#others + 1] = p
			end
		end
		table.sort(others, function(x, y)
			return (trophiesOf(x.UserId) or 0) > (trophiesOf(y.UserId) or 0)
		end)
		local sent = type(lobby.Sent) == "table" and lobby.Sent or nil
		for i, p in ipairs(others) do
			playerRow(p, i, sent and sent.ToUserId == p.UserId and sent or nil)
		end
		if #others == 0 then
			wrapText(ui.ChallengeList, "Empty", "Nobody else is in this server yet. Invite a friend, or beat the Trial Portal's levels meanwhile!", "Body", 19, MUTED, 1)
		end
	end

	local function tierLine(parent, tier, order)
		local row = makeFrame(parent, "Tier_" .. tostring(tier.Id), {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			LayoutOrder = order,
		})
		listLayout(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
		local colors = { Gold = C.Medal[1], Silver = Color3.fromRGB(150, 164, 190), Bronze = C.Medal[3], Helper = Color3.fromRGB(90, 120, 190) }
		colorPill(row, "Name", tostring(tier.Id), colors[tier.Id] or Color3.fromRGB(90, 120, 190), 18, 1)
		local share = math.floor((tonumber(tier.MinShare) or 0) * 100 + 0.5)
		local text = (share > 0 and (share .. "%+ damage: ") or "Any damage: ") .. G.Cloud .. " " .. commas(tier.Tokens or 0)
		if (tonumber(tier.Gems) or 0) > 0 then
			text = text .. ", " .. math.floor((tonumber(tier.GemChance) or 0) * 100 + 0.5) .. "% for " .. G.Gem .. " " .. commas(tier.Gems)
		end
		makeText(row, "Text", text, "Body", 19, WHITE, {
			Size = UDim2.new(1, -96, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 2,
		})
	end

	local function refreshRaid()
		local raid = raidStatus()
		local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
		local bossId = raid and raid.BossId or (nextEvent and nextEvent.BossId)
		local boss = bossInfo(bossId)
		local element = boss and boss.Element
		if ui.BossElementSig ~= tostring(element) then
			ui.BossElementSig = tostring(element)
			clearChildren(ui.BossElement)
			if element then
				elementPill(ui.BossElement, element, 18, 1)
			end
		end
		ui.BossName.Text = (raid and raid.Name) or (boss and boss.Name) or (nextEvent and nextEvent.Name) or "Boss Raid"
		ui.BossBlurb.Text = boss and tostring(boss.Blurb or "") or "A giant boss appears on the colosseum floor. Everyone in the arena can fight it together!"
		local hpVisible = false
		if raid then
			local maxHp = tonumber(raid.MaxHp) or 0
			local hp = tonumber(raid.Hp) or 0
			if raid.Waiting or maxHp <= 0 then
				ui.BossState.Text = "OPEN"
				ui.BossState.BackgroundColor3 = Color3.fromRGB(226, 160, 54)
				ui.BossLine.Text = "Waiting for the first fighter! Join closes in " .. clock(arenaSeconds(raid.JoinEndsIn) or 0)
			else
				hpVisible = true
				ui.BossState.Text = raid.Enraged and "ENRAGED" or "LIVE"
				ui.BossState.BackgroundColor3 = C.Boss
				ui.BossHpFill.Size = UDim2.new(Util.Clamp(hp / maxHp, 0, 1), 0, 1, 0)
				ui.BossHpText.Text = commas(hp) .. " / " .. commas(maxHp)
				local line = commas(raid.Players or 0) .. " fighting " .. G.Bullet .. " " .. clock(arenaSeconds(raid.EndsIn) or 0) .. " left"
				if raid.Joinable then
					line = line .. " " .. G.Bullet .. " join closes in " .. clock(arenaSeconds(raid.JoinEndsIn) or 0)
				end
				ui.BossLine.Text = line
			end
		else
			ui.BossState.Text = "SOON"
			ui.BossState.BackgroundColor3 = Color3.fromRGB(90, 120, 190)
			local starts = nextEvent and nextEvent.Kind == "BossRaid" and arenaSeconds(nextEvent.StartsIn) or nil
			ui.BossLine.Text = starts and ("Starts in " .. clock(starts) .. ". Be in the arena with your team!") or "No raid running right now."
		end
		ui.BossHpFill.Parent.Visible = hpVisible
		-- join / leave
		local why = nil
		local canJoin = raid ~= nil and (raid.Joinable == true or raid.Waiting == true)
		if inRaid() then
			ui.JoinButton.Text = "LEAVE RAID"
			CloudUI.SetStyle(ui.JoinButton, "Gray")
		else
			ui.JoinButton.Text = "JOIN RAID"
			CloudUI.SetStyle(ui.JoinButton, "Red")
			if not raid then
				why = "Raids start every " .. ((catalog() and catalog().Events and catalog().Events.Schedule and catalog().Events.Schedule[1]
					and catalog().Events.Schedule[1].EveryMinutes) or 20) .. " minutes."
			elseif not canJoin then
				why = "The join window has closed. Watch from the stands!"
			elseif battleId() then
				why = "Finish your current battle first."
			elseif #activeTeam() == 0 then
				why = "Pick your battle team first."
			elseif inArena() == false then
				why = "Walk into the Battle Arena to join."
			end
		end
		CloudUI.SetDisabled(ui.JoinButton, why ~= nil and not inRaid())
		ui.JoinWhy.Text = why or ""
		-- next event + double rewards
		if nextEvent then
			ui.NextClock.Text = clock(arenaSeconds(nextEvent.StartsIn) or 0)
			local kind = nextEvent.Kind == "DoubleRewards" and "Double Rewards hour" or "Boss Raid"
			ui.NextName.Text = kind .. ((nextEvent.Name and nextEvent.Kind ~= "DoubleRewards") and (": " .. tostring(nextEvent.Name)) or "")
		else
			ui.NextClock.Text = "--:--"
			ui.NextName.Text = "Nothing scheduled"
		end
		local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double or nil
		if double and double.Active then
			ui.DoubleLine.Text = G.Double .. "2 Double Rewards for " .. clock(arenaSeconds(double.EndsIn) or 0) .. ": every battle pays twice the tokens!"
			ui.DoubleLine.Visible = true
		else
			ui.DoubleLine.Visible = false
		end
		-- tips: elements that beat the boss + the reward tiers
		local sig = tostring(bossId)
		if ui.TipsSig ~= sig then
			ui.TipsSig = sig
			clearChildren(ui.Tips)
			makeText(ui.Tips, "Title", "How to win", "Heading", 22, WHITE, {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
			})
			if element then
				local counters = countersOf(element)
				if #counters > 0 then
					wrapText(ui.Tips, "CountersText", "Bring these pets: they hit " .. tostring(element) .. " hard.", "Body", 19, WHITE, 2)
					local row = makeFrame(ui.Tips, "Counters", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 })
					row.LayoutOrder = 3
					listLayout(row, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
					for i, e in ipairs(counters) do
						elementPill(row, e, 18, i)
					end
				end
			end
			wrapText(ui.Tips, "Retreat", "Glowing circles and lines on the floor mean a big hit is coming: press RETREAT to get your pets out!", "Body", 19, MUTED, 4)
			local BC = catalog()
			local tiers = BC and BC.Raid and BC.Raid.Tiers
			if type(tiers) == "table" then
				makeText(ui.Tips, "TiersTitle", "Rewards by damage dealt", "Heading", 20, WHITE, {
					Size = UDim2.new(1, 0, 0, 26),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 5,
				})
				for i, tier in ipairs(tiers) do
					tierLine(ui.Tips, tier, 5 + i)
				end
			end
		end
	end

	local function refreshLeaders()
		clearChildren(ui.LeaderScroll)
		makeText(ui.LeaderScroll, "Title", "Trophy leaders in this server", "Title", 26, WHITE, {
			Size = UDim2.new(1, 0, 0, 34),
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = 0,
		})
		local list = leaderboard()
		local meShown = false
		for i, row in ipairs(list) do
			if i > 10 then
				break
			end
			if type(row) == "table" then
				local me = LocalPlayer and row.UserId == LocalPlayer.UserId
				meShown = meShown or me
				local frame = makeFrame(ui.LeaderScroll, "Rank" .. i, {
					BackgroundTransparency = 0,
					BackgroundColor3 = me and C.Me or Color3.fromRGB(34, 50, 100),
					Size = UDim2.new(1, 0, 0, 54),
					LayoutOrder = i,
				})
				corner(frame, 12)
				stroke(frame, me and GOLD or NAVY, me and 3.5 or 3, 0)
				local medal = makeFrame(frame, "Medal", {
					BackgroundTransparency = 0,
					BackgroundColor3 = C.Medal[i] or Color3.fromRGB(70, 90, 150),
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, 10, 0.5, 0),
					Size = UDim2.fromOffset(40, 40),
				})
				round(medal)
				stroke(medal, NAVY, 2.5, 0)
				makeText(medal, "Rank", tostring(i), "Display", 24, WHITE, { Size = UDim2.new(1, 0, 1, 0) })
				makeText(frame, "Name", tostring(row.Name or "?") .. (me and "  (you)" or ""), "Title", 23, me and Theme.Lighten(GOLD, 0.35) or WHITE, {
					Position = UDim2.fromOffset(62, 0),
					Size = UDim2.new(1, -220, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
				})
				makeText(frame, "Trophies", G.Trophy .. " " .. commas(row.Trophies or 0), "Display", 26, C.Power, {
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, -14, 0, 0),
					Size = UDim2.new(0, 160, 1, 0),
					TextXAlignment = Enum.TextXAlignment.Right,
				})
			end
		end
		if #list == 0 then
			wrapText(ui.LeaderScroll, "Empty", "The leaderboard fills up as soon as the arena reports in.", "Body", 19, MUTED, 1)
		end
		if not meShown and LocalPlayer then
			wrapText(ui.LeaderScroll, "Mine", "You: " .. G.Trophy .. " " .. commas(battleData().Trophies or 0) .. " trophies. Win duels to climb the board!", "Heading", 20, C.Power, 20)
		end
		Ring.leaderSection(ui.LeaderScroll, 25)
		local BC = catalog()
		local rules = BC and type(BC.Trophies) == "table" and BC.Trophies or { Win = 20, Loss = -10 }
		local note = inset(ui.LeaderScroll, "HowTo", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 30 })
		pad(note, 14, 10, 14, 12)
		listLayout(note, Enum.FillDirection.Vertical, 4)
		wrapText(note, "Title", "How trophies work", "Heading", 20, WHITE, 1)
		wrapText(note, "Text", "Win a duel: +" .. commas(rules.Win or 20) .. " " .. G.Trophy .. "   Lose one: " .. tostring(rules.Loss or -10) .. " "
			.. G.Trophy .. " (never below 0). Duel on the rings in front of the colosseum, or join the quick queue!", "Body", 19, MUTED, 2)
	end

	win.Refresh = function()
		local tab = S.Tab
		if not ui.Pages[tab] then
			tab = "Duels"
			S.Tab = tab
		end
		for id, frame in pairs(ui.Pages) do
			frame.Visible = id == tab
		end
		for id, button in pairs(ui.TabButtons) do
			CloudUI.SetStyle(button, id == tab and "Red" or "Gray")
		end
		ui.Trophies.Text = G.Trophy .. " " .. commas(battleData().Trophies or 0)
		if tab == "Duels" then
			refreshDuels()
		elseif tab == "Raid" then
			refreshRaid()
		else
			refreshLeaders()
		end
	end
	-- the live numbers (countdowns) without rebuilding the lists
	win.Live = function()
		if S.Tab == "Raid" then
			refreshRaid()
		elseif S.Tab == "Duels" then
			local lobby = S.Lobby or {}
			local queue = type(lobby.Queue) == "table" and lobby.Queue or {}
			if queue.Queued then
				local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
				ui.QueueStatus.Text = "Searching... " .. clock(seconds) .. "   (" .. commas(queue.Waiting or 1) .. " in the queue)"
			end
		end
	end
	return win
end

----------------------------------------------------------------------
-- Side cards (right edge): duel invites, the sent invite, the queue, the raid join card, the event countdown
----------------------------------------------------------------------
local function sideCard(name, accent, order)
	local card = makeFrame(U.Side, name, {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(28, 36, 78),
		Size = UDim2.fromOffset(K.SIDE_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order,
	})
	corner(card, 14)
	stroke(card, NAVY, 3.5, 0)
	pad(card, 22, 8, 12, 10)
	-- the accent stripe sits in the left padding (the body below holds the card's list)
	local bar = makeFrame(card, "Accent", {
		BackgroundTransparency = 0,
		BackgroundColor3 = accent,
		Position = UDim2.new(0, -14, 0, 0),
		Size = UDim2.new(0, 6, 1, 0),
	})
	round(bar)
	local body = makeFrame(card, "Body", {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	listLayout(body, Enum.FillDirection.Vertical, 4)
	return body
end

local function buildSide()
	local gui = CloudUI.NewScreenGui("NimbusArenaSide", K.SIDE_ORDER)
	U.SideGui = gui
	U.Side = makeFrame(gui, "SideStack", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -K.SIDE_BOTTOM),
		Size = UDim2.fromOffset(K.SIDE_W, 10),
		AutomaticSize = Enum.AutomaticSize.Y,
	})
	U.SideScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = U.Side })
	listLayout(U.Side, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
	U.SideCards = {}
end

local function relayoutSide()
	if not U.Side then
		return
	end
	local factor = screenFactor()
	U.SideScale.Scale = factor
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local area = guiArea()
	local bottom = (touch and K.SIDE_BOTTOM_TOUCH or K.SIDE_BOTTOM) * factor
	if area.X < area.Y then
		bottom = K.SIDE_BOTTOM_PORTRAIT * factor
	end
	U.Side.Position = UDim2.new(1, -12, 1, -math.floor(bottom + 0.5))
end

-- true while a menu window, the Pet Index or the Fusion window covers the screen (the side cards step back)
local function otherWindowOpen()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = otherController(name)
		if mod and type(mod.IsOpen) == "function" then
			local ok, open = pcall(mod.IsOpen)
			if ok and open == true then
				return true
			end
		end
	end
	return false
end

-- rebuilds the side cards (cheap: a handful of frames, only when something changed; the clocks tick in place)
local function sideSignature()
	local parts = {}
	local lobby = S.Lobby or {}
	for _, inv in ipairs(type(lobby.Invites) == "table" and lobby.Invites or {}) do
		if type(inv) == "table" then
			parts[#parts + 1] = "i" .. tostring(inv.FromUserId)
		end
	end
	if type(lobby.Sent) == "table" then
		parts[#parts + 1] = "s" .. tostring(lobby.Sent.ToUserId)
	end
	if type(lobby.Queue) == "table" and lobby.Queue.Queued then
		parts[#parts + 1] = "q"
	end
	local raid = raidStatus()
	if raid and (raid.Joinable or raid.Waiting) and not inRaid() then
		parts[#parts + 1] = "r" .. tostring(raid.BossId) .. tostring(inArena())
	end
	local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
	local starts = nextEvent and arenaSeconds(nextEvent.StartsIn)
	if starts and starts <= K.ANNOUNCE and starts > 0 then
		parts[#parts + 1] = "n" .. tostring(nextEvent.Kind)
	end
	local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double
	if double and double.Active then
		parts[#parts + 1] = "d"
	end
	local area = guiArea()
	parts[#parts + 1] = tostring(area.Y < 500 or area.X < area.Y)
	return table.concat(parts, ",")
end

function refreshSide()
	if not U.Side then
		return
	end
	local hidden = inMatch() or battleId() ~= nil or S.Open ~= nil or otherWindowOpen()
	U.Side.Visible = not hidden
	if hidden then
		return
	end
	local sig = sideSignature()
	if sig ~= S.SideSig then
		S.SideSig = sig
		clearChildren(U.Side)
		U.SideCards = {}
		local area = guiArea()
		local maxCards = (area.Y < 500 or area.X < area.Y) and K.SIDE_MAX_CARDS_SHORT or K.SIDE_MAX_CARDS
		local count = 0
		local lobby = S.Lobby or {}
		-- 1. duel invites (most urgent first)
		for i, invite in ipairs(type(lobby.Invites) == "table" and lobby.Invites or {}) do
			if type(invite) == "table" and count < maxCards then
				count = count + 1
				local card = sideCard("Invite" .. i, C.Arena, 10 + i)
				makeText(card, "Title", G.Swords .. " Duel challenge!", "Heading", 21, Theme.Lighten(C.Arena, 0.4), {
					Size = UDim2.new(1, 0, 0, 28),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 1,
				})
				makeText(card, "Name", tostring(invite.FromName or "Someone") .. " wants to battle", "Body", 19, WHITE, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = 2,
				})
				local info = makeText(card, "Info", "", "Heading", 18, C.Power, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 3,
				})
				local buttons = makeFrame(card, "Buttons", { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 4 })
				CloudUI.Button({
					Name = "Accept",
					Text = "Accept",
					Size = UDim2.new(0.5, -4, 0, 44),
					Style = "Green",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("ChallengeReply", invite.FromUserId, true)
					end,
				})
				CloudUI.Button({
					Name = "Decline",
					Text = "Decline",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0.5, -4, 0, 44),
					Style = "Gray",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("ChallengeReply", invite.FromUserId, false)
					end,
				})
				local track = makeFrame(card, "Timer", {
					BackgroundTransparency = 0,
					BackgroundColor3 = Color3.fromRGB(14, 20, 48),
					Size = UDim2.new(1, 0, 0, 6),
					LayoutOrder = 5,
				})
				round(track)
				local fill = makeFrame(track, "Fill", { BackgroundTransparency = 0, BackgroundColor3 = C.Arena, Size = UDim2.new(1, 0, 1, 0) })
				round(fill)
				local total = math.max(1, tonumber(invite.ExpiresIn) or 30)
				table.insert(U.SideCards, function()
					local left = lobbySeconds(invite.ExpiresIn) or 0
					info.Text = G.Trophy .. " " .. commas(invite.Trophies or 0) .. "   " .. G.Swords .. " " .. commas(invite.Power or 0) .. "   " .. G.Clock .. " " .. clock(left)
					fill.Size = UDim2.new(Util.Clamp(left / total, 0, 1), 0, 1, 0)
				end)
			end
		end
		-- 2. the invite I sent
		if type(lobby.Sent) == "table" and count < maxCards then
			count = count + 1
			local sent = lobby.Sent
			local card = sideCard("Sent", Color3.fromRGB(110, 118, 146), 20)
			local text = makeText(card, "Text", "", "Body", 19, WHITE, {
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 1,
			})
			table.insert(U.SideCards, function()
				text.Text = G.Swords .. " Waiting for " .. tostring(sent.ToName or "them") .. " to accept... " .. clock(lobbySeconds(sent.ExpiresIn) or 0)
			end)
		end
		-- 3. the quick queue
		if type(lobby.Queue) == "table" and lobby.Queue.Queued and count < maxCards then
			count = count + 1
			local queue = lobby.Queue
			local card = sideCard("Queue", C.Next, 30)
			local row = makeFrame(card, "Row", { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1 })
			local text = makeText(row, "Text", "", "Body", 20, WHITE, {
				Size = UDim2.new(1, -112, 1, 0),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
			})
			CloudUI.Button({
				Name = "Leave",
				Text = "Leave",
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, 0, 0.5, 0),
				Size = UDim2.fromOffset(104, 42),
				Style = "Gray",
				TextSize = 20,
				Parent = row,
				Callback = function()
					request("Unqueue")
				end,
			})
			table.insert(U.SideCards, function()
				local seconds = (tonumber(queue.Seconds) or 0) + (os.clock() - S.LobbyAt)
				text.Text = "Finding a duel... " .. clock(seconds)
			end)
		end
		-- 4. the raid join card
		local raid = raidStatus()
		if raid and (raid.Joinable or raid.Waiting) and not inRaid() and count < maxCards then
			count = count + 1
			local card = sideCard("Raid", C.Boss, 40)
			makeText(card, "Title", G.Skull .. " BOSS RAID: " .. tostring(raid.Name or (bossInfo(raid.BossId) or {}).Name or "Boss"), "Heading", 21, Theme.Lighten(C.Boss, 0.45), {
				Size = UDim2.new(1, 0, 0, 28),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = 1,
			})
			local line = makeText(card, "Line", "", "Body", 19, WHITE, {
				Size = UDim2.new(1, 0, 0, 24),
				TextXAlignment = Enum.TextXAlignment.Left,
				LayoutOrder = 2,
			})
			local here = inArena()
			if here == false then
				makeText(card, "Where", "Head to the Battle Arena to join!", "Body", 19, C.WarnText, {
					Size = UDim2.new(1, 0, 0, 24),
					TextXAlignment = Enum.TextXAlignment.Left,
					LayoutOrder = 3,
				})
			else
				local buttons = makeFrame(card, "Buttons", { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3 })
				CloudUI.Button({
					Name = "Join",
					Text = "JOIN RAID",
					Size = UDim2.new(0.62, -4, 0, 44),
					Style = "Red",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						request("JoinRaid")
					end,
				})
				CloudUI.Button({
					Name = "Info",
					Text = "Info",
					AnchorPoint = Vector2.new(1, 0),
					Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0.38, -4, 0, 44),
					Style = "Blue",
					TextSize = 21,
					Parent = buttons,
					Callback = function()
						ArenaController.OpenArena("Raid")
					end,
				})
			end
			table.insert(U.SideCards, function()
				local r = raidStatus() or raid
				line.Text = commas(r.Players or 0) .. " fighting " .. G.Bullet .. " join closes in " .. clock(arenaSeconds(r.JoinEndsIn) or 0)
			end)
		end
		-- 5. the event countdown chip (always last: closest to the hotbar corner)
		local nextEvent = S.Arena and type(S.Arena.Next) == "table" and S.Arena.Next or nil
		local starts = nextEvent and arenaSeconds(nextEvent.StartsIn)
		local double = S.Arena and type(S.Arena.Double) == "table" and S.Arena.Double
		local showNext = starts and starts <= K.ANNOUNCE and starts > 0
		if showNext or (double and double.Active) then
			local chip = makeFrame(U.Side, "Countdown", {
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(28, 36, 78),
				Size = UDim2.fromOffset(0, 46),
				AutomaticSize = Enum.AutomaticSize.X,
				LayoutOrder = 90,
			})
			corner(chip, 23)
			stroke(chip, GOLD, 3, 0)
			pad(chip, 14, 0, 16, 0)
			listLayout(chip, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
			local label = autoText(chip, "Text", "", "Heading", 20, WHITE, 1)
			local clockLabel = autoText(chip, "Clock", "", "Display", 26, C.Power, 2)
			table.insert(U.SideCards, function()
				local s2 = nextEvent and arenaSeconds(nextEvent.StartsIn)
				if s2 and s2 <= K.ANNOUNCE and s2 > 0 then
					label.Text = (nextEvent.Kind == "DoubleRewards" and (G.Double .. "2 Rewards in") or (G.Skull .. " Boss Raid in"))
					clockLabel.Text = clock(s2)
				elseif double and double.Active then
					label.Text = G.Double .. "2 Rewards"
					clockLabel.Text = clock(arenaSeconds(double.EndsIn) or 0)
				end
			end)
		end
	end
	for _, tick in ipairs(U.SideCards) do
		pcall(tick)
	end
end

----------------------------------------------------------------------
-- Opening / closing
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		ArenaController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function syncBackBinding()
	local want = S.Open ~= nil
	if want == S.BackBound then
		return
	end
	S.BackBound = want
	if want then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		task.defer(function()
			if not S.BackBound then
				pcall(function()
					ContextActionService:UnbindAction(K.BACK_ACTION)
				end)
			end
		end)
	end
end

local function setBackdrop(on)
	local backdrop = U.Backdrop
	if not backdrop then
		return
	end
	if on then
		backdrop.Visible = true
		tween(backdrop, 0.18, { BackgroundTransparency = 0.55 })
	else
		tween(backdrop, 0.15, { BackgroundTransparency = 1 })
		local mine = S.Token
		task.delay(0.17, function()
			if S.Token == mine and not S.Open and backdrop.Parent then
				backdrop.Visible = false
			end
		end)
	end
end

local function closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = otherController(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function refreshOpen()
	local win = S.Open and Win[S.Open]
	if win and win.Refresh then
		safe("refresh " .. S.Open, win.Refresh)
	end
	refreshSide()
end

local function ensureWindow(id)
	if S.Built[id] then
		return Win[id]
	end
	S.Built[id] = true
	local ok, result
	if id == "Trials" then
		ok, result = pcall(buildTrials)
	elseif id == "Ring" then
		ok, result = pcall(Ring.build)
	else
		ok, result = pcall(buildArena)
	end
	if not ok then
		warnOnce("build " .. id, result)
		return nil
	end
	return result
end

local function open(id)
	if not initialized then
		ArenaController.Init()
	end
	if not U.Gui or inMatch() then
		return false
	end
	local win = ensureWindow(id)
	if not win then
		return false
	end
	local was = S.Open
	if was and was ~= id and Win[was] then
		Win[was].Holder.Visible = false
	end
	if not was then
		closeOthers()
	end
	S.Open = id
	S.Token = S.Token + 1
	syncBackBinding()
	win.W = nil -- re-run the layout for the current screen
	layoutWindow(win)
	win.Holder.Visible = true
	if was ~= id then
		win.Pop.Scale = 0.86
		tween(win.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	if not was then
		setBackdrop(true)
	end
	refreshOpen()
	if was ~= id then
		ArenaController.Opened:Fire(id)
	end
	return true
end

function ArenaController.OpenTrials(level, portal)
	local n = tonumber(level)
	if n and catalog() and trials()[math.floor(n)] then
		S.Level = math.floor(n)
	elseif S.Open ~= "Trials" then
		S.Level = nil -- the next level to beat
	end
	S.AtPortal = (typeof(portal) == "Instance") and portal or nil
	return open("Trials")
end

function ArenaController.OpenArena(tab)
	S.Tab = normalizeTab(tab) or S.Tab or "Duels"
	S.AtPortal = nil
	return open("Arena")
end

function ArenaController.OpenRing(start, portal)
	local n = tonumber(start)
	if n then
		Ring.Start = math.floor(n)
	elseif S.Open ~= "Ring" then
		local best = Ring.record()
		local starts = Ring.starts(best)
		local keep = false
		for _, r in ipairs(starts) do
			keep = keep or (Ring.Picked and r == Ring.Start)
		end
		if not keep then
			Ring.Start = starts[#starts] -- the latest beaten boss round, else round 1 (a round the kid picked stays)
		end
	end
	Ring.Refusal = nil
	Ring.Pending = false
	S.RingAt = (typeof(portal) == "Instance") and portal or nil
	return open("Ring")
end

function ArenaController.SelectLevel(level)
	local n = tonumber(level)
	if n and trials()[math.floor(n)] then
		S.Level = math.floor(n)
		if S.Open == "Trials" then
			refreshOpen()
		end
	end
end

function ArenaController.Close()
	if not S.Open then
		return
	end
	local id = S.Open
	local win = Win[id]
	S.Open = nil
	S.AtPortal = nil
	S.RingAt = nil
	Ring.Pending = false
	S.Token = S.Token + 1
	local mine = S.Token
	syncBackBinding()
	if win then
		tween(win.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(0.13, function()
			if S.Token == mine and S.Open ~= id and win.Holder then
				win.Holder.Visible = false
			end
		end)
	end
	setBackdrop(false)
	refreshSide()
	ArenaController.Closed:Fire(id)
end

function ArenaController.IsOpen()
	return S.Open ~= nil
end

function ArenaController.GetState()
	return { Arena = S.Arena, Lobby = S.Lobby, Window = S.Open, Tab = S.Tab, Level = S.Level, RingStart = Ring.Start }
end

function ArenaController.Request(action, a, b)
	return request(action, a, b)
end

----------------------------------------------------------------------
-- Server messages
----------------------------------------------------------------------
local function onArenaState(state)
	if type(state) ~= "table" then
		return
	end
	S.Arena = state
	S.ArenaAt = os.clock()
	if S.Open == "Arena" then
		refreshOpen()
	else
		refreshSide()
	end
end

local function onBattleState(kind, payload)
	if kind == "Lobby" and type(payload) == "table" then
		S.Lobby = payload
		S.LobbyAt = os.clock()
		if S.Open == "Arena" and S.Tab == "Duels" then
			refreshOpen()
		else
			refreshSide()
		end
	elseif kind == "Start" and type(payload) == "table" and payload.Spectator ~= true and (payload.Side or 1) ~= 0 then
		-- my battle began: the windows step aside
		Ring.Pending = false
		ArenaController.Close()
	elseif kind == "End" and type(payload) == "table" and payload.Spectator ~= true then
		task.delay(0.5, refreshSide)
	end
end

local function onPromptTriggered(prompt)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") then
		return
	end
	local panel = prompt:GetAttribute("OpenPanel")
	if panel == "Ring" or prompt:GetAttribute("OpenPanelTab") == "Ring" then
		-- Portal_Ring's RingPrompt (or its fallback on the Trial Portal: OpenPanel "Ring", OpenPanelTab "Ring")
		ArenaController.OpenRing(nil, prompt.Parent)
	elseif panel == "Trials" then
		ArenaController.OpenTrials(nil, prompt.Parent)
	elseif panel == "Arena" then
		local tab = prompt:GetAttribute("OpenPanelTab")
		if tab == nil and prompt:GetAttribute("RingIndex") ~= nil then
			tab = "Duels"
		end
		ArenaController.OpenArena(tab)
	end
end

local function connectOthers()
	local function hook(name, signalName)
		local mod = otherController(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(windowId)
				if windowId ~= nil and (windowId == "Trials" or windowId == "Arena" or windowId == "Ring") then
					return
				end
				ArenaController.Close()
				if name == "MenuController" and windowId == "Team" then
					-- the Champion Ring record line on the Team screen (after its first layout)
					task.defer(function()
						safe("team line", Ring.teamLine)
					end)
				end
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function ArenaController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)

	local gui = CloudUI.NewScreenGui("NimbusArena", K.DISPLAY_ORDER)
	U.Gui = gui
	U.Backdrop = Util.Create("TextButton", {
		Name = "Backdrop",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(8, 12, 32),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 1,
		Parent = gui,
	})
	U.Backdrop.Activated:Connect(function()
		ArenaController.Close()
	end)
	buildSide()
	relayoutSide()
	-- the hint (right edge, a third down: clear of the toasts at the top and the side cards at the bottom)
	U.HintGui = gui
	U.HintFrame = makeFrame(gui, "Hint", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(28, 36, 78),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.36, 0),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		Visible = false,
		ZIndex = 20,
	})
	corner(U.HintFrame, 12)
	stroke(U.HintFrame, GOLD, 3, 0)
	pad(U.HintFrame, 14, 8, 14, 8)
	U.HintScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = U.HintFrame })
	U.HintLabel = makeText(U.HintFrame, "Text", "", "Heading", 20, WHITE, {
		Size = UDim2.fromOffset(0, 28),
		AutomaticSize = Enum.AutomaticSize.X,
		ZIndex = 21,
	})

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", function()
			relayoutSide()
			S.SideSig = nil
			if S.Open and Win[S.Open] then
				layoutWindow(Win[S.Open])
				refreshOpen()
			else
				refreshSide()
			end
		end)
	end)
	State.Changed:Connect(function()
		safe("State.Changed", refreshOpen)
		safe("team line", Ring.teamLine)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if inMatch() then
				ArenaController.Close()
			end
			safe("InMatch", refreshSide)
		end)
		LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.InBattle) or K.ATTR_IN_BATTLE):Connect(function()
			S.SideSig = nil
			safe("InBattle", refreshOpen)
		end)
	end
	Players.PlayerAdded:Connect(function()
		if S.Open == "Arena" and S.Tab == "Duels" then
			safe("players", refreshOpen)
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if S.Open == "Arena" and S.Tab == "Duels" then
			task.defer(function()
				safe("players", refreshOpen)
			end)
		end
	end)
	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			ArenaController.Close()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", onPromptTriggered, prompt)
	end)

	task.spawn(function()
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) ~= "string" then
					return
				end
				args = type(args) == "table" and args or {}
				local key = panelId:lower()
				if key == "trials" or key == "trial" then
					safe("OpenPanel", ArenaController.OpenTrials, args.Level)
				elseif key == "ring" then
					safe("OpenPanel", ArenaController.OpenRing, args.Start)
				elseif key == "arena" or key == "duels" or key == "raid" or key == "leaderboard" then
					local tab = args.Tab or ((key ~= "arena") and panelId or nil)
					safe("OpenPanel", ArenaController.OpenArena, tab)
				end
			end)
		end
		local okArena, arenaRemote = pcall(Remotes.Get, "ArenaState")
		if okArena and arenaRemote then
			arenaRemote.OnClientEvent:Connect(function(state)
				safe("ArenaState", onArenaState, state)
			end)
		end
		local okNotify, notifyRemote = pcall(Remotes.Get, "Notify")
		if okNotify and notifyRemote then
			notifyRemote.OnClientEvent:Connect(function(text)
				safe("Notify", Ring.onNotify, text)
			end)
		end
		local okBattle, battleRemote = pcall(Remotes.Get, "BattleState")
		if okBattle and battleRemote then
			battleRemote.OnClientEvent:Connect(function(kind, payload)
				safe("BattleState", onBattleState, kind, payload)
			end)
		end
	end)
	task.defer(function()
		safe("hooks", connectOthers)
	end)

	-- one light loop: countdowns, walk-away, the side cards' clocks (4 times a second)
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + K.TICK
		if S.Open == "Trials" and S.AtPortal then
			local d = portalDistance()
			if d and d > K.WALK_AWAY then
				ArenaController.Close()
				return
			end
		end
		if S.Open == "Ring" and S.RingAt then
			local d = Ring.distance()
			if d and d > K.WALK_AWAY then
				ArenaController.Close()
				return
			end
		end
		if S.Open == "Arena" and Win.Arena and Win.Arena.Live then
			safe("live", Win.Arena.Live)
		elseif S.Open == "Ring" and Win.Ring and Win.Ring.Live then
			safe("ring live", Win.Ring.Live)
		end
		safe("zone", Ring.zoneTick)
		safe("side", refreshSide)
	end)
end

return ArenaController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">BattleController</string>
              <string name="Source"><![CDATA[-- BattleController (client, Phase 3, battleclient): draws every pet battle the server simulates and gives the local
-- player the battle controls (ARCHITECTURE_V3.md "Phase 3: Pet battles", "Phase 3 build contract", "Interfaces between
-- the Phase 3 modules"). The server simulates, the clients draw: nothing here is authoritative. Battle units are built
-- locally (PetBuilder for pets with their keys / looks, BossBuilder for raid bosses) and animated between the server's
-- 10 Hz snapshots (Replication rule).
--
-- API
--   BattleController.Init()                 connects BattleState, the frame loop and the input (once)
--   BattleController.Stop()                 tears everything down (tests / hot reload)
--   BattleController.HandleState(kind, payload, battleId)   what the BattleState remote does (tests / dump_gui)
--   BattleController.Command(action, arg) -> bool   sends BattleCommand ("Attack" (unitId|nil), "Retreat",
--                                           "Special" (slot), "Forfeit") with a local throttle; false when refused here
--   BattleController.Focus(unitId)          focus an enemy (= Command("Attack", unitId)); nil clears the focus
--   BattleController.GetBattle() -> { Id, Mode, Side, Spectator, Fighter, Ended, Units = n, Models = n, Focus,
--                                     Order, Hud = bool, Layout = "Wide" | "Compact" } | nil
--   BattleController.GetUnit(id) -> { Id, Side, Kind, Name, Hp, MaxHp, State, Meter, Model, X, Z, World (Vector3) } | nil
--   BattleController.GetStats() -> { Frames, AvgMs, PeakMs, LastMs, Units, Models, FxParts, Numbers, Flashes,
--                                     Telegraphs, Builds }  (cost of the frame loop, measured with os.clock, or with
--                                     BattleController.PerfClock when a test sets one; ResetStats() starts over)
--   BattleController.IsHudVisible() -> bool
--   BattleController.ScreenPick(x, y) -> unitId | nil   the enemy a tap / click at viewport pixel (x, y) would focus
--   BattleController.GetTelegraphs() -> { { Id, Shape, At, From, SafeAt, Late } }  (tests: the render-clock deadline)
--   GetBattle() also reports Threat (a telegraph covers one of my pets), Cue ("Attack" | "Retreat" | nil: the
--   pulsing command), InterpDelay and TeamPlace ("Right" | "Top" | "Left": where the team cards sit); Phase 4: Round /
--   Best (a Champion Ring round), Next (the round that follows a won one, until its Start) and Overtime (a duel)
--   GetUnit(id) also reports Card = { Gui, Mode } (the unit's PetCard), Level, Evo, Xp, XpNext, Crowned and Writes
--   (how many times its card's HP / SPECIAL were written: tests pin "only on change")
--
-- Messages (BattleState(kind, payload, battleId), sent by BattleService)
--   "Start"    battle:Describe() + Zone = { CFrame (floor centre), Size, X, Z } + Names + Side (0 = spectator) + Spectator
--              + T (+ Trial = { Level, Name, Chapter, MiniBoss }). A second "Start" for the same battle (a raid
--              spectator who joins) refreshes the units and the controls without rebuilding the models it keeps.
--   "Snapshot" { BattleId, T, U = { number... } }: BattleSim:SnapshotDelta's wire form (only the units whose picture
--              changed, as flat numbers); BattleSim.DecodeSnapshot turns it into { [id] = { x, z, hp, state, target?,
--              meter, shield } } against the previous picture. The older { BattleId, T, Units = { [id] = {...} } }
--              form (the tools' drivers feed it) is taken as it is.
--   "Events"   a list of BattleSim events (Hit, Special, KO, Telegraph, Spawn, Enrage, Order, Zone, Leave, End)
--   "End"      { BattleId, Mode, Result, Rewards, Outcome, Won, Spectator, Reason }
--
-- Drawing
--   * Snapshots are buffered and drawn INTERP_DELAY seconds behind the estimated server clock (smooth at 10 Hz,
--     no extrapolation overshoot); events are queued with their arrival time and played on that same delayed clock,
--     so lunges, numbers and telegraph impacts line up with the positions.
--   * Pets hover over the floor (zone-local x / z from the zone CFrame), face their target or their path, bob, flap
--     (PetBuilder.Animate), lunge on melee hits, recoil and shoot voxel bolts on ranged hits, hop on a Pounce. Static
--     parts are welded to the anchored root once per build, so a pose is one root CFrame write (like PetController).
--     Your own pets are built at High detail, everyone else's at Low; builds run under a per-frame time budget.
--   * The raid boss: BossBuilder model + BossBuilder.Animate poses (Idle, Windup during a telegraph, Attack at the hit,
--     Basic on its plain attacks, Enrage, Down) facing its target; SetEnraged on the Enrage event.
--   * Hit flashes (a pooled Highlight per hit victim), floating damage numbers (pooled pixel-sized BillboardGuis
--     above the victim in the world, never a screen-centre overlay: crits bigger and gold, strong / weak element hits
--     tinted, shield blocks light blue, heals green), KO poofs (voxel bursts; the downed pet is parked until the fight
--     ends), special callouts above the caster, and VFX per Special.Kind in the special's / element's colour: Blast
--     (voxel shock ring + burst), Heal (rising voxel sparks), Shield (a translucent force-field cube on every shielded
--     ally while the snapshot reports a shield), Storm (a voxel storm cloud with lightning over its zone), Pounce
--     (a dash trail + hop), Freeze (ice crystals on every stunned unit), Beam (a long neon beam).
--   * Boss telegraphs: a glowing floor circle / line in BossBuilder.TelegraphColor that FILLS UP until the dodge
--     DEADLINE (the hit minus the render delay, the round trip of Player:GetNetworkPing and TELE_RUNOUT: a RETREAT
--     pressed then still gets the pets out), then its rim flashes red until the hit; lingering pools (Zone "Linger")
--     glow for their seconds. Spectators draw INTERP_DELAY_SPECTATOR behind (5 Hz snapshots).
--   * A PetCard above every pet unit (Phase 4, below; the Phase 3 bar only without PetCard); a bobbing voxel arrow
--     marks the enemy your team focuses.
--   * Spectators (a player near a duel ring / the raid floor) see the same battle from the stands, with only a slim
--     top card (no controls).
--
-- The battle HUD (only while the local player fights; ScreenGui "NimbusBattle", designed in 1080p pixels under one
-- UIScale of Theme.ScreenFactor()): never in the screen centre.
--   * Top card (top centre, under the Roblox bar): the mode, the opponent / trial / boss, the time left; the boss HP
--     bar with its element and ENRAGED / minion pills in raids; one chip per enemy (name, element stripe, HP) in trials
--     and duels: tap / click a chip to focus that enemy.
--   * Team card (bottom right on wide screens): one row per team pet: slot key, name, level, element badge, HP bar,
--     special meter, and its SPECIAL button (lights up gold and pulses when the meter is full, shows KO when down).
--   * ATTACK / RETREAT above it (key hints F / R; gamepad X / Y; specials 1-4, gamepad LB / RB / LT / RT). ATTACK
--     shows the regroup countdown after a RETREAT, then reads ATTACK! with a pulsing ring while the team rests, and
--     RETREAT counts "RESTING n" down to BattleSim's auto resume (Damage.RetreatAutoResume; the Order { Attack, auto }
--     event puts the HUD back). A full SPECIAL waits while resting and says so ("RESTING" / "ATTACK first"; compact
--     "ATTACK 1st"). RETREAT reads RETREAT! with a pulsing ring while a telegraph that has not hit covers one of my
--     pets. The header names the focused enemy (tap it to clear the focus).
--   * Compact layout (touch screens and small windows): the team as a row of cards under the top card (tap a card =
--     its special); when that row would reach the middle of the screen (a landscape phone) the cards form a 2-column
--     grid at the top-left edge instead and the menu tiles step aside (MenuController.SetColumnHidden) until the
--     battle HUD goes; ATTACK / RETREAT as big touch buttons at the right edge, clear of the RUN / DASH buttons.
--   * LEAVE (Champion Ring and Trials only, never duels or raids): beside ATTACK / RETREAT (wide: left of them;
--     portrait phone: above ATTACK; landscape phone: under the team grid) and on the ring's next-round card; two
--     presses ("Sure? Tap again" for 3 s first) send BattleCommand "Forfeit", which Command also lets through between
--     two ring rounds (the won round has ended, the next Start has not come yet).
--   * Tap / click an enemy in the world to focus it (a short tap that is not a camera drag; the nearest enemy on the
--     screen within reach of the tap).
--   * Result card at the end (bottom right; compact: top centre on a tall phone, top right on a landscape phone,
--     re-placed on rotation; never centred): VICTORY / DEFEAT / DRAW, the reason, the rewards (tokens, gems,
--     trophies, XP, first clear, raid tier + damage share, event pet, level-ups, double rewards), OK; it closes by
--     itself after RESULT_SECONDS.
-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" 3.5 / 3.8 / 3.9):
--   * Unit cards: every pet unit carries a PetCard (src/client/UI/PetCard.lua; the billboard keeps the Phase 3 name
--     HpBar, its HP fill is Plate.Hp.Fill): mode "Unit" for my pets (Lv + HP + SPECIAL + XP from Start's xp / xpNext; a
--     full XP bar at the cap, where the server leaves xpNext out), "Ally" for a teammate's (Lv + green HP), "Enemy" for
--     enemies / NPCs (Lv + red HP), the evolution stars from unitInfo.evo. HP / SPECIAL are written only when a
--     snapshot changed them (Cards.Live), never per frame; the fight's XP (End.Rewards.Xp) and the profile mirror
--     (State.PetLevel, forward only) move my XP bars (the level-up toasts are the server's). The raid boss keeps its
--     top-card bar. Evolved units are built with PetBuilder opts.Evolved at Low detail (petEvoLow / petEvo2Low).
--   * Champion Ring (Mode "Ring", Start.Ring = { Round, Best, Start, Champion }): the top card reads "CHAMPION RING"
--     ("RING" on a compact card) + "Round 8 - Best 12" + a pill row: the pay of a win ("Win: +$X +Y XP": BattleCatalog.
--     RingRewards with the plot's IncomePerSecond, display only), "RECORD x3" past the best, "BOSS" on every 10th
--     round. The champion is built wearing PetBuilder's voxel Crown accessory, with a 22 px "Champion <name>" tag
--     above its card. A won round's End (Rewards.Next) shows no result card: the side card "Round 8 won! +$319 +68 XP
--     / Round 9 in 3" (where the commands were on a wide screen, under the team cards on a tall phone, at the right
--     edge in landscape), the top card and the team stay, the floor waits (Ring.LINGER) for the next Start, which
--     takes my pets' models and cards over (same key and stage: nothing blinks); the old battle's folder is freed by
--     its battle id. The run's final End (also one that names the won round's id after a Forfeit / leave between
--     rounds) shows the result card: RUN OVER / NEW RECORD!, where it ended, "Rounds won: n", "+$X Cash", "+Y Pet XP",
--     Tokens, "Best: round n".
--   * Duels: the Overtime event (BattleCatalog.Damage.Overtime) puts "OVERTIME: hits +15% a second" in the top card.
-- Keys 1-4 are bound through ContextActionService only while you fight (High priority, sunk), so the item hotbar does
-- not also fire them; they are released when the battle ends.
--
-- Cost: one RenderStepped connection, alive only while a battle is drawn or effects play. Per frame: one root CFrame
-- write + PetBuilder.Animate per visible pet (other players' / enemy pets are drawn every 2nd frame in a crowd, every
-- 3rd beyond ANIM_MID studs from the camera, every 4th beyond ANIM_FAR; your own pets every frame), one
-- BossBuilder.Animate, the live effect parts (pooled, capped at MAX_FX_PARTS), the live numbers (capped) and HUD
-- writes only when a shown value changes. GetStats() reports the measured milliseconds.
-- Plain Lua 5.1-compatible syntax only. Every font comes from a Theme role. No asset ids.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent

-- optional modules (a build without one still draws what it can)
local function optional(parent, name, waitSeconds)
	if not parent then
		return nil
	end
	local inst = parent:FindFirstChild(name)
	if not inst and waitSeconds then
		inst = parent:WaitForChild(name, waitSeconds)
	end
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warn("[BattleController] " .. name .. " failed to load: " .. tostring(result))
	return nil
end

local CloudUI = optional(Client:FindFirstChild("UI") or Client:WaitForChild("UI", 10), "CloudUI", 10)
local PetBuilder = optional(Shared, "PetBuilder", 5)
local PetCatalog = optional(Shared, "PetCatalog", 5)
local PetKeys = optional(Shared, "PetKeys")
local BattleCatalog = optional(Shared, "BattleCatalog")
local BattleSim = optional(Shared, "BattleSim") -- constants only (States / Events); the client never simulates
local BossBuilder = nil -- loaded on the first raid (lazyBoss)
-- Phase 4 (optional too): the shared pet card (every unit's card), the local profile mirror (own pets' level / XP
-- after a fight), the XP curve and the voxel kit (the champion's crown)
local Mods = {
	PetCard = optional(Client:FindFirstChild("UI") or Client:WaitForChild("UI", 10), "PetCard", 5),
	State = optional(Client, "State", 5),
	Tycoon = optional(Shared, "TycoonCatalog"),
	Voxel = optional(Shared, "Voxel"),
}

local BattleController = {}

local LocalPlayer = Players.LocalPlayer
local sin, cos, sqrt, abs, floor, max, min, exp, pi = math.sin, math.cos, math.sqrt, math.abs, math.floor, math.max, math.min, math.exp, math.pi
local atan2 = math.atan2 or function(y, x)
	return math.atan(y, x)
end
local TAU = pi * 2

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local K = {
	GUI_NAME = "NimbusBattle",
	DISPLAY_ORDER = 12, -- above the HUD (10) and the hotbar (11), below windows (20) and toasts (30)
	FOLDER = "ClientBattle", -- workspace folder of the drawn battles
	INTERP_DELAY = 0.12, -- seconds behind the server clock (snapshots arrive every 0.1 s)
	INTERP_DELAY_SPECTATOR = 0.25, -- spectators get snapshots at 5 Hz (BattleService), so they draw further behind
	-- telegraph deadline: the fill completes when a RETREAT pressed now still reaches the server TELE_RUNOUT seconds
	-- before the hit (the pets need that long to run out: sim_battle "dodge", a 2.2 s telegraph escaped ~90% with a
	-- RETREAT 1.2-1.4 s after the warning); after that the shape flashes until the impact
	TELE_RUNOUT = 0.8,
	TELE_MIN_FILL = 0.5, -- seconds: the fill never gets shorter than this (a very slow connection)
	PING_DEFAULT = 0.1, -- round trip assumed when Player:GetNetworkPing is unavailable
	PING_MAX = 0.5,
	THREAT_PAD = 1.5, -- studs around a pet's centre that count as "in the shape" for the RETREAT! cue
	OFFSET_RATE = 0.1, -- clock offset filter
	MAX_SNAPS = 8,
	PET_SCALE = 1.3, -- battle pets are a little bigger than followers, so they read from the stands
	HOVER = 0.55, -- studs between the floor and a pet's lowest point
	BOB = 0.18,
	FACE_RATE = 10,
	LUNGE_TIME = 0.26,
	LUNGE_DIST = 1.5,
	RECOIL_DIST = 0.35,
	HOP_TIME = 0.4,
	HOP_HEIGHT = 2.6,
	KO_PARK = 0.3, -- seconds after a KO before the downed pet is parked (the poof covers it)
	BUILD_BUDGET = 0.006, -- seconds of model building per frame (the first build of a frame always runs)
	BUILD_MAX = 4,
	CROWD = 14, -- more units than this: other players' / enemy pets are drawn every other frame
	ANIM_MID = 90, -- studs from the camera: beyond this, other players' / enemy pets are drawn every 3rd frame ...
	ANIM_FAR = 160, -- ... and beyond this every 4th (a whole pet at once: root + wings, so nothing comes apart)
	MAX_FX_PARTS = 260,
	POOL_KEEP = 160,
	MAX_NUMBERS = 26,
	MAX_FLASHES = 8,
	FLASH_TIME = 0.2,
	NUMBER_TIME = 0.95,
	NUMBER_RISE = 2.6,
	NUMBER_PX = 26, -- 1080p pixel size of a damage number (World text rule: >= 22)
	CRIT_PX = 32,
	CALLOUT_PX = 26,
	NUMBER_DISTANCE = 170,
	BAR_DISTANCE = 140,
	END_LINGER = 3.5, -- seconds the floor stays drawn after the end
	SPECTATOR_LINGER = 1.5,
	RESULT_SECONDS = 12,
	CMD_GAP = 0.25, -- local throttle between two commands of a kind
	TAP_TIME = 0.35,
	TAP_MOVE = 14, -- px
	TAP_REACH = 64, -- px (1080p, scaled) around an enemy's centre on the screen
	ACTION_ATTACK = "NimbusBattleAttack",
	ACTION_RETREAT = "NimbusBattleRetreat",
	ACTION_SPECIAL = "NimbusBattleSpecial",
	-- HUD geometry (design px at 1080p)
	TEAM_W = 470,
	ROW_H = 70,
	ROW_GAP = 6,
	HEAD_H = 34,
	PAD = 10,
	CMD_H = 62,
	TOP_W = 600,
	TOP_W_COMPACT = 460,
	CARD_W = 124,
	CARD_H = 100,
	TOUCH_W = 112, -- compact ATTACK / RETREAT buttons (design px)
	TOUCH_H = 72,
	WAIT_COMPACT = "ATTACK 1st", -- a compact card's SPECIAL with a full meter while the team rests
	ROW_MAX_Y = 0.42, -- a compact team row whose bottom passes this share of the screen height moves to the left edge
	SIDE_X = 12, -- design px: the left-edge team grid of a landscape phone
	MIN_TEXT_PX = 14, -- no HUD text is ever drawn smaller on the screen (Readability rule)
	EDGE = 16,
	RESULT_W = 440,
	-- LEAVE (Ring / Trial only): the first press arms it for LEAVE_CONFIRM seconds, the second sends "Forfeit"
	LEAVE_CONFIRM = 3,
	LEAVE_W = 150, -- wide screens: left of ATTACK / RETREAT, CMD_H tall
	LEAVE_H = 56, -- compact: above ATTACK (portrait) / under ATTACK; the next-round card's button
	LEAVE_W_GRID = 200, -- a landscape phone: under the left-edge team grid, one line
	LEAVE_H_GRID = 48,
	LEAVE_W_MIN = 100, -- the narrowest LEAVE (two lines when armed)
	LEAVE_TAB_W = 116, -- a landscape phone's next-round card: beside its bottom-left corner (DASH / RUN sit below it)
	LEAVE_CARD_W = 230, -- the next-round card's bottom row (wide screens / portrait phones)
}

local STATES = (BattleSim and BattleSim.States) or { Idle = 0, Moving = 1, Attacking = 2, Retreating = 3, Casting = 4, Down = 5, Stunned = 6 }
local S_DOWN, S_STUNNED, S_RETREATING, S_CASTING, S_ATTACKING = STATES.Down, STATES.Stunned, STATES.Retreating, STATES.Casting, STATES.Attacking
local EV = (BattleSim and BattleSim.Events) or {
	Hit = "Hit", Special = "Special", KO = "KO", Telegraph = "Telegraph", Spawn = "Spawn", Enrage = "Enrage",
	Order = "Order", Zone = "Zone", Leave = "Leave", End = "End",
}

local DMG = (BattleCatalog and BattleCatalog.Damage) or {}
local METER_MAX = tonumber(DMG.MeterMax) or 100
local RETREAT_LOCK = tonumber(DMG.RetreatLock) or 1.5
-- a retreating player team goes back to ATTACK by itself this long after the regroup lock (BattleSim; only once
-- every pet is parked at its spot and no telegraph covers one): the HUD's "RESTING" countdown
local AUTO_RESUME = tonumber(DMG.RetreatAutoResume) or 3
local SPECIALS = (BattleCatalog and BattleCatalog.Specials) or {}

local COLORS = {
	Mine = Theme.Colors.Health,
	Ally = Color3.fromRGB(98, 172, 232),
	Enemy = Color3.fromRGB(236, 88, 100),
	Gold = Theme.Colors.Gold or Color3.fromRGB(244, 196, 78),
	Heal = Color3.fromRGB(120, 230, 140),
	Shield = Color3.fromRGB(150, 210, 255),
	Ice = Color3.fromRGB(170, 228, 255),
	Weak = Color3.fromRGB(176, 190, 214),
	Strong = Color3.fromRGB(255, 150, 70),
	White = Color3.fromRGB(255, 255, 255),
	Ink = Theme.Colors.TextStroke or Color3.fromRGB(16, 22, 50),
	Panel = Theme.Colors.Panel,
	PanelLight = Theme.Colors.PanelLight,
	Navy = Theme.Colors.Navy or Color3.fromRGB(24, 34, 78),
	Muted = Theme.Colors.Muted or Color3.fromRGB(212, 224, 246),
	Track = Color3.fromRGB(28, 36, 76),
	Storm = Color3.fromRGB(72, 78, 108),
	LateRim = Color3.fromRGB(255, 70, 60), -- a telegraph past its dodge deadline flashes in this
	Wait = Color3.fromRGB(150, 132, 84), -- a SPECIAL with a full meter that waits for ATTACK
	StormLight = Color3.fromRGB(112, 118, 150),
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local St = {
	initialized = false,
	battle = nil, -- the drawn battle (see newBattle)
	old = {}, -- battles that ended and still fade out: { battle, until }
	conns = {}, -- long-lived connections
	loop = nil, -- RenderStepped connection (only while needed)
	folder = nil, -- workspace.ClientBattle
	fxFolder = nil,
	pool = {}, -- free effect parts
	fxLive = 0,
	effects = {}, -- live effects
	numbers = {}, -- live numbers
	numberPool = {},
	flashes = {}, -- live flashes
	flashPool = {},
	lastCmd = {}, -- [action .. arg] = os.clock()
	bound = false, -- ContextActionService bindings active
	gamepad = false, -- the last input was a gamepad
	tap = nil, -- { pos, t } a press that may become a tap
	frameNo = 0,
	perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} },
	warned = {},
	remoteCmd = nil,
	result = nil, -- result card timer
}

local Hud = {} -- the battle HUD (built once, lazily)
local Fx = {} -- pooled effects
local Units = {} -- battle units
local Tele = {} -- telegraphs and zones
local Input = {} -- keys, gamepad, taps
local Net = {} -- messages
local Cards = {} -- Phase 4: the PetCard above every battle unit
local Ring = {} -- Phase 4: the Champion Ring HUD (round / record / next-round side card / run card), duel overtime
local Leave = {} -- LEAVE (two presses -> BattleCommand "Forfeit"): Champion Ring runs and Trials only

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp(x, lo, hi)
	if x < lo then
		return lo
	elseif x > hi then
		return hi
	end
	return x
end

local function warnOnce(key, message)
	if St.warned[key] then
		return
	end
	St.warned[key] = true
	warn("[BattleController] " .. tostring(message))
end

local function num(v, default)
	v = tonumber(v)
	if v == nil or v ~= v or v == math.huge or v == -math.huge then
		return default
	end
	return v
end

local function wrapAngle(a)
	return (a + pi) % TAU - pi
end

local function elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	if info and typeof(info.Color) == "Color3" then
		return info.Color
	end
	return Color3.fromRGB(170, 180, 200)
end

local function myUserId()
	return LocalPlayer and LocalPlayer.UserId or 0
end

-- seconds the drawing runs behind the estimated server clock (spectators get 5 Hz snapshots)
local function interpDelay(B)
	return (B and B.Spectator) and K.INTERP_DELAY_SPECTATOR or K.INTERP_DELAY
end

-- the round trip to the server in seconds (Player:GetNetworkPing), clamped; a default when unavailable
local function networkPing()
	local ok, v = pcall(function()
		return LocalPlayer:GetNetworkPing()
	end)
	if ok and type(v) == "number" and v == v and v >= 0 then
		return clamp(v, 0, K.PING_MAX)
	end
	return K.PING_DEFAULT
end

local function make(className, props, parent)
	local inst = Instance.new(className)
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function fmtTime(seconds)
	seconds = max(0, floor(seconds + 0.5))
	return string.format("%d:%02d", floor(seconds / 60), seconds % 60)
end

local function lazyBoss()
	if BossBuilder == nil then
		BossBuilder = optional(Shared, "BossBuilder") or false
	end
	return BossBuilder or nil
end

local function battleFolder()
	if St.folder and St.folder.Parent == workspace then
		return St.folder
	end
	local f = workspace:FindFirstChild(K.FOLDER)
	if not f then
		f = make("Folder", { Name = K.FOLDER }, workspace)
	end
	St.folder = f
	return f
end

local function fxFolder()
	if St.fxFolder and St.fxFolder.Parent then
		return St.fxFolder
	end
	St.fxFolder = make("Folder", { Name = "Fx" }, battleFolder())
	return St.fxFolder
end

----------------------------------------------------------------------
-- Effects: pooled voxel parts
----------------------------------------------------------------------
function Fx.Part(color, material, transparency)
	local p = table.remove(St.pool)
	if not p then
		if St.fxLive >= K.MAX_FX_PARTS then
			return nil
		end
		p = make("Part", {
			Name = "BattleFx",
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
			Massless = true,
			TopSurface = Enum.SurfaceType.Smooth,
			BottomSurface = Enum.SurfaceType.Smooth,
		})
	end
	St.fxLive = St.fxLive + 1
	p.Shape = Enum.PartType.Block
	p.Material = material or Enum.Material.Neon
	p.Color = color or COLORS.White
	p.Transparency = transparency or 0
	p.Parent = fxFolder()
	return p
end

function Fx.Free(p)
	if not p then
		return
	end
	St.fxLive = max(0, St.fxLive - 1)
	if #St.pool < K.POOL_KEEP then
		p.Parent = nil
		St.pool[#St.pool + 1] = p
	else
		p:Destroy()
	end
end

-- registers a live effect: update(e, p, now) -> nothing; e.parts are freed when it ends
function Fx.Add(dur, update, parts, data)
	local e = data or {}
	e.t0 = os.clock()
	e.dur = dur
	e.update = update
	e.parts = parts or {}
	St.effects[#St.effects + 1] = e
	BattleController._wake()
	return e
end

local function burstUpdate(e, p)
	local t = p * e.dur
	local g = e.gravity
	local fade = p * p
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		local x = e.ox + v[1] * t
		local y = e.oy + v[2] * t - 0.5 * g * t * t
		local z = e.oz + v[3] * t
		local a = v[4] * t
		local c, s = cos(a), sin(a)
		part.CFrame = CFrame.new(x, y, z, c, 0, s, 0, 1, 0, -s, 0, c)
		local size = e.size * (1 - 0.7 * p)
		part.Size = Vector3.new(size, size, size)
		part.Transparency = e.alpha + (1 - e.alpha) * fade
	end
end

-- a burst of voxel cubes flying out of `pos`
function Fx.Burst(pos, color, count, speed, size, dur, opts)
	opts = opts or {}
	local parts, vel = {}, {}
	local rnd = math.random
	for i = 1, count do
		local c = color
		if opts.color2 and i % 2 == 0 then
			c = opts.color2
		end
		local part = Fx.Part(c, opts.material, opts.alpha or 0)
		if not part then
			break
		end
		local a = rnd() * TAU
		local up = (opts.up or 0.6) + rnd() * 0.6
		local sp = speed * (0.55 + rnd() * 0.6)
		parts[#parts + 1] = part
		vel[#vel + 1] = { cos(a) * sp, up * sp, sin(a) * sp, (rnd() - 0.5) * 12 }
		part.Size = Vector3.new(size, size, size)
		part.CFrame = CFrame.new(pos)
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, burstUpdate, parts, {
		ox = pos.X, oy = pos.Y, oz = pos.Z, vel = vel, size = size, gravity = opts.gravity or 18, alpha = opts.alpha or 0,
	})
end

local function ringUpdate(e, p)
	local r = e.r * (0.25 + 0.75 * (1 - (1 - p) * (1 - p)))
	local n = #e.parts
	for i, part in ipairs(e.parts) do
		local a = (i / n) * TAU + e.spin * p
		part.CFrame = CFrame.new(e.ox + cos(a) * r, e.oy + 0.3 + 0.6 * p, e.oz + sin(a) * r)
		part.Transparency = e.alpha + (1 - e.alpha) * p
	end
end

-- a ring of cubes that expands from `pos` to radius r (shock waves)
function Fx.Ring(pos, r, color, count, size, dur, alpha)
	local parts = {}
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, alpha or 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size * 0.6, size)
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, ringUpdate, parts, { ox = pos.X, oy = pos.Y, oz = pos.Z, r = r, spin = 0.6, alpha = alpha or 0.1 })
end

local function riseUpdate(e, p)
	local t = p * e.dur
	for i, part in ipairs(e.parts) do
		local v = e.vel[i]
		part.CFrame = CFrame.new(e.ox + v[1], e.oy + v[2] * t, e.oz + v[3])
		part.Transparency = 0.1 + 0.9 * p * p
	end
end

-- cubes rising around a point (heal sparks)
function Fx.Rise(pos, color, count, size, dur, spread)
	local parts, vel = {}, {}
	local rnd = math.random
	for _ = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.1)
		if not part then
			break
		end
		part.Size = Vector3.new(size, size, size)
		parts[#parts + 1] = part
		local a = rnd() * TAU
		local r = spread * (0.3 + rnd() * 0.7)
		vel[#vel + 1] = { cos(a) * r, 2 + rnd() * 3, sin(a) * r }
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, riseUpdate, parts, { ox = pos.X, oy = pos.Y - 0.6, oz = pos.Z, vel = vel })
end

local function boltUpdate(e, p)
	local q = clamp(p * 1.25, 0, 1)
	local x = e.ax + (e.bx - e.ax) * q
	local y = e.ay + (e.by - e.ay) * q + sin(q * pi) * e.arc
	local z = e.az + (e.bz - e.az) * q
	local core = e.parts[1]
	if core then
		core.CFrame = CFrame.lookAt(Vector3.new(x, y, z), Vector3.new(e.bx, e.by, e.bz))
		core.Transparency = (p > 0.8) and 1 or 0
	end
	local tail = e.parts[2]
	if tail then
		local q2 = max(0, q - 0.12)
		tail.CFrame = CFrame.new(e.ax + (e.bx - e.ax) * q2, e.ay + (e.by - e.ay) * q2 + sin(q2 * pi) * e.arc, e.az + (e.bz - e.az) * q2)
		tail.Transparency = (p > 0.8) and 1 or 0.45
	end
	if p >= 0.8 and not e.landed then
		e.landed = true
		Fx.Burst(Vector3.new(e.bx, e.by, e.bz), e.color, 5, 7, 0.28, 0.35, { up = 0.3, gravity = 10 })
	end
end

-- a voxel bolt flying from a to b (ranged attacks), with a small burst where it lands
function Fx.Bolt(a, b, color, size, dur)
	local core = Fx.Part(color, Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.Size = Vector3.new(size, size, size * 1.8)
	local tail = Fx.Part(color, Enum.Material.Neon, 0.45)
	if tail then
		tail.Size = Vector3.new(size * 0.6, size * 0.6, size * 0.6)
	end
	local dist = (b - a).Magnitude
	return Fx.Add(dur, boltUpdate, { core, tail }, {
		ax = a.X, ay = a.Y, az = a.Z, bx = b.X, by = b.Y, bz = b.Z, arc = min(2.2, dist * 0.08), color = color,
	})
end

local function beamUpdate(e, p)
	local w = e.width * (1 - p * 0.85)
	local core, glow = e.parts[1], e.parts[2]
	if core then
		core.Size = Vector3.new(w * 0.45, w * 0.45, e.length)
		core.Transparency = p * p
	end
	if glow then
		glow.Size = Vector3.new(w, w, e.length)
		glow.Transparency = 0.55 + 0.45 * p
	end
end

-- a straight beam (Beam specials): cf = the beam's centre frame (LookVector along the beam)
function Fx.Beam(cf, length, width, color, dur)
	local core = Fx.Part(COLORS.White:Lerp(color, 0.35), Enum.Material.Neon, 0)
	if not core then
		return nil
	end
	core.CFrame = cf
	core.Size = Vector3.new(width * 0.45, width * 0.45, length)
	local glow = Fx.Part(color, Enum.Material.Neon, 0.55)
	if glow then
		glow.CFrame = cf
		glow.Size = Vector3.new(width, width, length)
	end
	return Fx.Add(dur, beamUpdate, { core, glow }, { length = length, width = width })
end

local function trailUpdate(e, p)
	for i, part in ipairs(e.parts) do
		local k = i / #e.parts
		part.Transparency = clamp(0.2 + p * 1.2 - k * 0.3, 0, 1)
	end
end

-- a dash trail of fading cubes from a to b (Pounce)
function Fx.Trail(a, b, color, count, dur)
	local parts = {}
	for i = 1, count do
		local part = Fx.Part(color, Enum.Material.Neon, 0.2)
		if not part then
			break
		end
		local k = (i - 0.5) / count
		local s = 0.35 + 0.35 * k
		part.Size = Vector3.new(s, s, s)
		part.CFrame = CFrame.new(a:Lerp(b, k) + Vector3.new(0, sin(k * pi) * 1.2, 0))
		parts[#parts + 1] = part
	end
	if #parts == 0 then
		return nil
	end
	return Fx.Add(dur, trailUpdate, parts, {})
end

local function zoneUpdate(e, p, now)
	local t = now - e.t0
	local fadeIn = clamp(t / 0.3, 0, 1)
	local fadeOut = clamp((e.dur - t) / 0.4, 0, 1)
	local vis = fadeIn * fadeOut
	local disc = e.parts[1]
	if disc then
		disc.Transparency = 1 - (1 - e.discAlpha) * vis
	end
	if e.cloud then
		-- the storm cloud bobs; bolts strike every 0.5 s
		local bob = sin(t * 2.2) * 0.25
		for i = 2, e.cloudEnd do
			local part = e.parts[i]
			local o = e.offsets[i]
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + o.Y + bob, e.oz + o.Z)
			part.Transparency = 1 - (1 - o.alpha) * vis
		end
		local phase = (t % 0.5) / 0.5
		for i = e.cloudEnd + 1, #e.parts do
			local part = e.parts[i]
			if phase < 0.3 and vis > 0.2 then
				if not e.boltFor or e.boltFor ~= floor(t / 0.5) then
					e.boltFor = floor(t / 0.5)
					local rnd = math.random
					local a, r = rnd() * TAU, rnd() * e.r * 0.8
					e.bx, e.bz = e.ox + cos(a) * r, e.oz + sin(a) * r
				end
				local k = i - e.cloudEnd
				local seg = (e.oy - e.floorY) / 3
				local y = e.oy - seg * (k - 0.5) - 0.3
				local jig = (k % 2 == 0) and 0.5 or -0.5
				part.CFrame = CFrame.new(e.bx + jig, y, e.bz - jig * 0.5) * CFrame.Angles(0, 0, jig * 0.4)
				part.Transparency = 0.05
			else
				part.Transparency = 1
			end
		end
	elseif e.bubbles then
		for i = 2, #e.parts do
			local part = e.parts[i]
			local o = e.offsets[i]
			local q = ((t * o.speed) + o.phase) % 1
			part.CFrame = CFrame.new(e.ox + o.X, e.oy + q * 1.4, e.oz + o.Z)
			part.Transparency = 1 - (1 - 0.15) * vis * (1 - q)
		end
	end
end

-- a damaging area on the floor for `seconds`: Storm (a voxel storm cloud with lightning) or a lingering pool
function Fx.Zone(floorCF, r, seconds, color, kind)
	local parts = {}
	local disc = Fx.Part(color, Enum.Material.Neon, 0.7)
	if not disc then
		return nil
	end
	disc.Shape = Enum.PartType.Cylinder
	disc.Size = Vector3.new(0.12, r * 2, r * 2)
	disc.CFrame = floorCF * CFrame.new(0, 0.1, 0) * CFrame.Angles(0, 0, pi / 2)
	parts[1] = disc
	local pos = floorCF.Position
	local e = { ox = pos.X, oy = pos.Y, oz = pos.Z, floorY = pos.Y, r = r, offsets = {}, discAlpha = 0.62 }
	local rnd = math.random
	if kind == "Storm" then
		e.cloud = true
		e.oy = pos.Y + 7.5
		local puffs = 9
		for i = 1, puffs do
			local shade = (i % 3 == 0) and COLORS.StormLight or COLORS.Storm
			local part = Fx.Part(shade, Enum.Material.SmoothPlastic, 0.05)
			if not part then
				break
			end
			local a = (i / puffs) * TAU
			local rr = (i == 1) and 0 or r * (0.25 + rnd() * 0.45)
			local s = 1.6 + rnd() * 1.4
			part.Size = Vector3.new(s * 1.3, s * 0.8, s * 1.3)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Y = rnd() * 0.8, Z = sin(a) * rr, alpha = 0.05 }
		end
		e.cloudEnd = #parts
		for _ = 1, 3 do
			local bolt = Fx.Part(Color3.fromRGB(230, 236, 255), Enum.Material.Neon, 1)
			if not bolt then
				break
			end
			bolt.Size = Vector3.new(0.25, (e.oy - pos.Y) / 3 + 0.4, 0.25)
			parts[#parts + 1] = bolt
		end
	else
		e.bubbles = true
		for _ = 1, 7 do
			local part = Fx.Part(color:Lerp(COLORS.White, 0.25), Enum.Material.Neon, 0.3)
			if not part then
				break
			end
			local a, rr = rnd() * TAU, rnd() * r * 0.85
			local s = 0.35 + rnd() * 0.35
			part.Size = Vector3.new(s, s, s)
			parts[#parts + 1] = part
			e.offsets[#parts] = { X = cos(a) * rr, Z = sin(a) * rr, speed = 0.6 + rnd() * 0.8, phase = rnd() }
		end
	end
	return Fx.Add(seconds, zoneUpdate, parts, e)
end

function Fx.Update(now)
	local list = St.effects
	local i = 1
	while i <= #list do
		local e = list[i]
		local p = (now - e.t0) / e.dur
		local ok = true
		if p < 1 then
			ok = pcall(e.update, e, clamp(p, 0, 1), now)
		end
		if p >= 1 or not ok then
			for _, part in ipairs(e.parts) do
				Fx.Free(part)
			end
			e.parts = {}
			list[i] = list[#list]
			list[#list] = nil
		else
			i = i + 1
		end
	end
end

function Fx.ClearAll()
	for _, e in ipairs(St.effects) do
		for _, part in ipairs(e.parts) do
			Fx.Free(part)
		end
	end
	St.effects = {}
	for _, n in ipairs(St.numbers) do
		n.gui.Enabled = false
		n.gui.Adornee = nil
		St.numberPool[#St.numberPool + 1] = n
	end
	St.numbers = {}
	for _, f in ipairs(St.flashes) do
		f.hl.Enabled = false
		f.hl.Adornee = nil
		St.flashPool[#St.flashPool + 1] = f
	end
	St.flashes = {}
end

----------------------------------------------------------------------
-- Effects: floating numbers (pixel-sized billboards in the world: World text rule) and hit flashes
----------------------------------------------------------------------
local function newNumber()
	local gui = make("BillboardGui", {
		Name = "BattleNumber",
		Size = UDim2.fromOffset(240, 64),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.NUMBER_DISTANCE,
		Enabled = false,
	})
	local label = Theme.Label("", "Accent", { Size = K.NUMBER_PX, Stroke = 0, Outline = 2.5 })
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = gui
	local scale = make("UIScale", { Name = "Pop", Scale = 1 }, label)
	return { gui = gui, label = label, scale = scale }
end

-- shows `text` above `adornee` (a BasePart), rising and fading; kind tweaks size / life
function Fx.Number(adornee, height, text, color, px, life)
	if not adornee or not adornee.Parent then
		return nil
	end
	local n = table.remove(St.numberPool)
	if not n then
		if #St.numbers >= K.MAX_NUMBERS then
			n = table.remove(St.numbers, 1) -- recycle the oldest
		else
			n = newNumber()
		end
	end
	if not n then
		return nil
	end
	n.gui.Parent = fxFolder()
	n.gui.Adornee = adornee
	n.label.Text = text
	n.label.TextColor3 = color or COLORS.White
	n.label.TextSize = Theme.ScaledSize(px or K.NUMBER_PX, 22)
	n.label.TextTransparency = 0
	local outline = n.label:FindFirstChild("TextOutline")
	if outline then
		outline.Transparency = 0
	end
	n.t0 = os.clock()
	n.life = life or K.NUMBER_TIME
	n.base = height
	n.jx = (math.random() - 0.5) * 1.4
	n.gui.StudsOffset = Vector3.new(n.jx, height, 0)
	n.gui.Enabled = true
	St.numbers[#St.numbers + 1] = n
	BattleController._wake()
	return n
end

function Fx.UpdateNumbers(now)
	local list = St.numbers
	local i = 1
	while i <= #list do
		local n = list[i]
		local p = (now - n.t0) / n.life
		if p >= 1 or not n.gui.Adornee or not n.gui.Adornee.Parent then
			n.gui.Enabled = false
			n.gui.Adornee = nil
			table.remove(list, i)
			St.numberPool[#St.numberPool + 1] = n
		else
			local rise = 1 - (1 - p) * (1 - p)
			n.gui.StudsOffset = Vector3.new(n.jx, n.base + rise * K.NUMBER_RISE, 0)
			n.scale.Scale = 1 + 0.45 * max(0, 1 - p * 6)
			local fade = clamp((p - 0.6) / 0.4, 0, 1)
			n.label.TextTransparency = fade
			local outline = n.label:FindFirstChild("TextOutline")
			if outline then
				outline.Transparency = fade
			end
			i = i + 1
		end
	end
end

-- a short white (or tinted) flash on a model (a pooled Highlight)
function Fx.Flash(u, color)
	if not u or not u.model or u.parked then
		return
	end
	local f = u.flash
	if not f then
		f = table.remove(St.flashPool)
		if not f then
			if #St.flashes >= K.MAX_FLASHES then
				return
			end
			f = {
				hl = make("Highlight", {
					Name = "HitFlash",
					DepthMode = "Occluded", -- Enum.HighlightDepthMode.Occluded by name (no flash through the arena walls)
					OutlineTransparency = 1,
					FillTransparency = 1,
					Enabled = false,
				}),
			}
		end
		f.hl.Parent = fxFolder()
		St.flashes[#St.flashes + 1] = f
		u.flash = f
		f.unit = u
	end
	f.t0 = os.clock()
	f.hl.FillColor = color or COLORS.White
	f.hl.Adornee = u.model
	f.hl.FillTransparency = 0.25
	f.hl.Enabled = true
	BattleController._wake()
end

function Fx.UpdateFlashes(now)
	local list = St.flashes
	local i = 1
	while i <= #list do
		local f = list[i]
		local p = (now - f.t0) / K.FLASH_TIME
		if p >= 1 or not f.hl.Adornee then
			f.hl.Enabled = false
			f.hl.Adornee = nil
			if f.unit then
				f.unit.flash = nil
				f.unit = nil
			end
			list[i] = list[#list]
			list[#list] = nil
			St.flashPool[#St.flashPool + 1] = f
		else
			f.hl.FillTransparency = 0.25 + 0.75 * p
			i = i + 1
		end
	end
end

----------------------------------------------------------------------
-- Battle record + coordinates
----------------------------------------------------------------------
local function newBattle(payload, battleId)
	local zone = type(payload.Zone) == "table" and payload.Zone or {}
	local cf = zone.CFrame
	if typeof(cf) ~= "CFrame" then
		cf = CFrame.new()
	end
	local size = zone.Size
	local zx = num(zone.X, typeof(size) == "Vector3" and size.X or 60)
	local zz = num(zone.Z, typeof(size) == "Vector3" and size.Z or 60)
	local side = num(payload.Side, 0)
	local spectator = payload.Spectator == true or side == 0
	local B = {
		Id = payload.BattleId or battleId,
		Mode = tostring(payload.Mode or "Duel"),
		Side = side,
		Spectator = spectator,
		Fighter = not spectator,
		ZoneCF = cf,
		ZoneX = zx,
		ZoneZ = zz,
		Names = type(payload.Names) == "table" and payload.Names or {},
		Trial = type(payload.Trial) == "table" and payload.Trial or nil,
		TimeLimit = num(payload.TimeLimit, 0),
		Level = payload.Level,
		BossId = payload.BossId,
		-- Phase 4: the Champion Ring's "Start".Ring = { Round, Best, Start, Champion = { PetId, Level, Tier, Boss, Name } }
		Ring = type(payload.Ring) == "table" and payload.Ring or nil,
		Round = num(payload.Round or (type(payload.Ring) == "table" and payload.Ring.Round), 0),
		overtime = false, -- a duel past Damage.Overtime.At (the Overtime event)
		ringNext = nil, -- a won ring round: { Round, Next, Cash, Xp, Tokens, Record, At } until the next "Start"
		units = {},
		list = {},
		mine = {},
		snaps = {},
		offset = 0,
		haveOffset = false,
		renderT = num(payload.T, 0),
		evq = {},
		teles = {},
		buildQueue = {},
		focus = nil,
		order = "Attack",
		retreatAt = -math.huge,
		ended = false,
		simEnded = false,
		enraged = false,
		wave = 0,
		folder = nil,
	}
	-- the zone basis, so a zone-local point becomes a world point with plain arithmetic per frame
	local px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	B.basis = { px, py, pz, r00, r01, r02, r10, r11, r12, r20, r21, r22 }
	B.folder = make("Folder", { Name = "Battle_" .. tostring(B.Id) }, battleFolder())
	return B
end

-- zone-local (x, y, z) -> world Vector3
local function worldPoint(B, x, y, z)
	local b = B.basis
	return Vector3.new(b[1] + b[4] * x + b[5] * y + b[6] * z, b[2] + b[7] * x + b[8] * y + b[9] * z, b[3] + b[10] * x + b[11] * y + b[12] * z)
end

-- zone-local position + yaw (0 = facing -Z of the zone) -> world CFrame (one allocation)
local function worldFrame(B, x, y, z, yaw)
	local b = B.basis
	local c, s = cos(yaw), sin(yaw)
	-- R = Z * Ry(yaw): columns of Ry are (c,0,-s), (0,1,0), (s,0,c)
	local m00 = b[4] * c - b[6] * s
	local m01 = b[5]
	local m02 = b[4] * s + b[6] * c
	local m10 = b[7] * c - b[9] * s
	local m11 = b[8]
	local m12 = b[7] * s + b[9] * c
	local m20 = b[10] * c - b[12] * s
	local m21 = b[11]
	local m22 = b[10] * s + b[12] * c
	return CFrame.new(
		b[1] + b[4] * x + b[5] * y + b[6] * z,
		b[2] + b[7] * x + b[8] * y + b[9] * z,
		b[3] + b[10] * x + b[11] * y + b[12] * z,
		m00, m01, m02, m10, m11, m12, m20, m21, m22
	)
end

local function yawToward(dx, dz)
	return atan2(-dx, -dz)
end

----------------------------------------------------------------------
-- Units
----------------------------------------------------------------------
-- the definition PetBuilder draws for a unit (its look from the sim; else its key / pet id)
function Units.Def(info)
	local look = info.look
	local base = nil
	if PetCatalog and type(PetCatalog.Get) == "function" then
		if info.petId then
			local ok, d = pcall(PetCatalog.Get, info.petId)
			base = ok and type(d) == "table" and d or nil
		end
		if not base and type(look) == "table" and look.BodyId then
			local ok, d = pcall(PetCatalog.Get, look.BodyId)
			base = ok and type(d) == "table" and d or nil
		end
	end
	if type(look) == "table" then
		return { Id = tostring(info.key or info.petId or info.id), Rarity = base and base.Rarity or nil, Look = look }
	end
	if PetKeys and type(info.key) == "string" then
		local ok, d = pcall(PetKeys.DefOf, info.key)
		if ok and type(d) == "table" then
			return d
		end
	end
	return base
end

local function isAnimatedPart(part)
	local spec = part:GetAttribute("PB_G")
	if type(spec) ~= "string" or type(part:GetAttribute("PB_Base")) ~= "string" then
		return false
	end
	local kind = string.match(spec, "^[^:]*:([^:]*)")
	return kind ~= "lid"
end

-- welds the static parts to the anchored root once: a pose is then one root CFrame write
local function weldStatic(model, root)
	local inv = root.CFrame:Inverse()
	local identity = CFrame.new()
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root and part.Anchored and not isAnimatedPart(part) then
			make("Weld", { Name = "BattleWeld", Part0 = root, Part1 = part, C0 = inv * part.CFrame, C1 = identity }, part)
			part.Anchored = false
		end
	end
	root.Anchored = true
end

function Units.Add(B, info)
	if type(info) ~= "table" then
		return nil
	end
	local id = tonumber(info.id)
	if not id then
		return nil
	end
	local u = B.units[id]
	if u then
		u.info = info
		return u
	end
	local me = myUserId()
	local side = num(info.side, 2)
	local mine = B.Fighter and info.owner == me
	local ally
	if B.Fighter then
		ally = side == B.Side
	else
		ally = side == 1
	end
	u = {
		id = id,
		info = info,
		side = side,
		owner = info.owner,
		slot = num(info.slot, 0),
		kind = tostring(info.kind or "Pet"),
		name = tostring(info.name or "Pet"),
		element = info.element,
		elements = type(info.elements) == "table" and info.elements or { info.element },
		maxHp = max(1, num(info.maxHp, 100)),
		level = num(info.level, 1),
		tier = info.tier,
		scale = num(info.scale, 1),
		ranged = info.ranged == true,
		radius = num(info.radius, 1.8),
		special = type(info.special) == "table" and info.special or nil,
		isBoss = info.kind == "Boss",
		bossId = info.boss,
		-- Phase 4: the stored evolution stage (the model and the card's stars), own pets' XP (the card's XP row), the
		-- ring champion's crown
		evo = clamp(floor(num(info.evo, 0)), 0, 2),
		xp = tonumber(info.xp),
		xpNext = tonumber(info.xpNext),
		crowned = info.crowned == true,
		mine = mine,
		ally = ally,
		x = 0,
		z = 0,
		seen = false,
		yaw = 0,
		hp = max(1, num(info.maxHp, 100)),
		state = 0,
		meter = 0,
		shield = 0,
		phase = math.random() * TAU,
		animOpts = { Flap = 1, Excited = 0 },
		bossOpts = { CFrame = nil, Progress = 0, Attack = nil, Enraged = false },
		pose = "Idle",
		poseAt = 0,
		poseDur = 0,
	}
	B.units[id] = u
	B.list[#B.list + 1] = u
	if u.isBoss then
		B.boss = u
	end
	if mine and u.slot >= 1 and u.slot <= 4 then
		B.mine[u.slot] = u
	end
	B.buildQueue[#B.buildQueue + 1] = u
	return u
end

function Units.Destroy(u)
	if u.flash then
		u.flash.hl.Adornee = nil
	end
	Cards.Free(u)
	for _, key in ipairs({ "shieldPart", "icePart", "focusMark" }) do
		local p = u[key]
		if p then
			pcall(p.Destroy, p)
			u[key] = nil
		end
	end
	if u.model then
		pcall(u.model.Destroy, u.model)
	end
	u.model = nil
	u.root = nil
	u.bar = nil
	u.gone = true
end

function Units.Remove(B, id)
	local u = B.units[id]
	if not u then
		return
	end
	B.units[id] = nil
	for i, v in ipairs(B.list) do
		if v == u then
			table.remove(B.list, i)
			break
		end
	end
	for slot, v in pairs(B.mine) do
		if v == u then
			B.mine[slot] = nil
		end
	end
	if B.boss == u then
		B.boss = nil
	end
	Units.Destroy(u)
end

-- the pixel HP bar above a unit (no text: World text rule only covers text)
local function addBar(u, adornee, height)
	local color = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
	local w, h = Theme.ScaledSize(74, 50), Theme.ScaledSize(11, 8)
	local gui = make("BillboardGui", {
		Name = "HpBar",
		Adornee = adornee,
		Size = UDim2.fromOffset(w, h),
		StudsOffset = Vector3.new(0, height, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
	})
	local back = make("Frame", {
		Name = "Back",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = COLORS.Track,
		BorderSizePixel = 0,
	}, gui)
	Theme.Corner(back, UDim.new(0, 4))
	Theme.Stroke(back, u.mine and COLORS.Gold or COLORS.Ink, u.mine and 2 or 1.5, 0)
	local fill = make("Frame", {
		Name = "Fill",
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		BackgroundColor3 = color,
		BorderSizePixel = 0,
	}, back)
	Theme.Corner(fill, UDim.new(0, 3))
	gui.Parent = u.model
	u.bar = gui
	u.barFill = fill
	u.barFrac = 1
end

-- builds one unit's model (pcall'd by the caller)
local function buildUnit(B, u)
	if u.isBoss then
		local BB = lazyBoss()
		if not BB then
			error("BossBuilder is missing")
		end
		local cf = worldFrame(B, u.x, 0, u.z, u.yaw)
		local model = BB.Build(u.bossId, { Detail = "High", CFrame = cf })
		if not model then
			error("BossBuilder.Build returned nil for " .. tostring(u.bossId))
		end
		local okH, h = pcall(BB.GetHeight, model)
		u.height = (okH and num(h, 20)) or 20
		u.model = model
		u.root = model.PrimaryPart or model:FindFirstChild("Root")
		model.Parent = B.folder
		if B.enraged then
			pcall(BB.SetEnraged, model, true)
		end
		return
	end
	if not PetBuilder then
		error("PetBuilder is missing")
	end
	local def = Units.Def(u.info)
	if not def then
		error("no definition for unit " .. tostring(u.id))
	end
	if u.crowned then
		def = Ring.Crowned(def) -- the ring champion wears PetBuilder's voxel crown
	end
	-- evolved units use the Low evolved form (within the petEvoLow / petEvo2Low budgets), like evolved followers
	local detail = (u.mine and u.evo == 0) and "High" or "Low"
	local model = PetBuilder.Build(def, { Scale = K.PET_SCALE * u.scale, Detail = detail, Evolved = u.evo > 0 and u.evo or nil })
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then
		model:Destroy()
		error("pet model without a root")
	end
	local okSize, size = pcall(model.GetExtentsSize, model)
	u.height = (okSize and typeof(size) == "Vector3") and size.Y or 3.5
	u.centerY = u.height / 2 + K.HOVER
	-- weld at the built pose FIRST, then move: a pose is one root CFrame write from here on
	local okWeld = pcall(weldStatic, model, root)
	u.rigid = okWeld
	local cf = worldFrame(B, u.x, u.centerY, u.z, u.yaw)
	if okWeld then
		root.CFrame = cf
	else
		pcall(model.PivotTo, model, cf)
	end
	u.model = model
	u.root = root
	u.folder = B.folder
	model.Name = "Unit_" .. tostring(u.id)
	model:SetAttribute("BC_Evo", u.evo)
	Cards.Add(B, u, root)
	model.Parent = B.folder
end

function Units.BuildPending(B)
	local q = B.buildQueue
	if #q == 0 then
		return
	end
	local t0 = os.clock()
	local built = 0
	while #q > 0 and built < K.BUILD_MAX do
		if built > 0 and os.clock() - t0 > K.BUILD_BUDGET then
			break
		end
		local u = table.remove(q, 1)
		if not u.gone and not u.model then
			local ok, err = pcall(buildUnit, B, u)
			if not ok then
				warnOnce("build_" .. tostring(u.kind) .. tostring(u.info and (u.info.key or u.info.boss)), "could not build unit " .. tostring(u.name) .. ": " .. tostring(err))
				u.failed = true
			end
			built = built + 1
			St.perf.builds = St.perf.builds + 1
		end
	end
end

-- a pet's KO: poof, then the model is parked until the end
local function parkUnit(u, parked)
	if not u.model then
		return
	end
	if parked and not u.parked then
		u.parked = true
		u.model.Parent = nil
	elseif not parked and u.parked then
		u.parked = false
		u.model.Parent = u.folder or u.model.Parent
	end
end

function Units.SetPose(u, pose, dur, attackId)
	u.pose = pose
	u.poseAt = os.clock()
	u.poseDur = dur or 0
	if attackId then
		u.attackId = attackId
	end
end

-- per-frame update of one unit (position from the snapshots, facing, lunge / hop, animation)
local function updateUnit(B, u, now, dt, sa, sb, alpha, animate)
	local a = sa and sa.Units[u.id]
	local b = sb and sb.Units[u.id]
	local x, z = u.x, u.z
	if type(a) == "table" and type(b) == "table" then
		x = a.x + (b.x - a.x) * alpha
		z = a.z + (b.z - a.z) * alpha
	elseif type(a) == "table" then
		x, z = a.x, a.z
	elseif type(b) == "table" then
		x, z = b.x, b.z
	end
	local d = (alpha >= 0.5 and type(b) == "table" and b) or (type(a) == "table" and a) or (type(b) == "table" and b) or nil
	if d then
		u.hp = num(d.hp, u.hp)
		u.state = num(d.state, u.state)
		u.target = d.target
		u.meter = num(d.meter, 0)
		u.shield = num(d.shield, 0)
	end
	x, z = num(x, u.x), num(z, u.z)
	local mx, mz = x - u.x, z - u.z
	if not u.seen then
		u.seen = true
		mx, mz = 0, 0
		-- face the floor centre at first
		u.yaw = yawToward(-x, -z)
	end
	u.x, u.z = x, z
	if not u.model then
		return
	end
	local down = u.state == S_DOWN or u.hp <= 0
	if u.isBoss then
		Units.UpdateBoss(B, u, now, down, dt)
		return
	end
	if u.card and (u.cardHp ~= u.hp or u.cardMeter ~= u.meter) then
		Cards.Live(u) -- only when the snapshot changed the HP / meter (at most 10 Hz), never a write per frame
	end
	-- downed pets: poof once, then park
	if down then
		if not u.downAt then
			u.downAt = now
			if not u.poofed then
				u.poofed = true
				local pos = worldPoint(B, x, u.centerY or 1.5, z)
				Fx.Burst(pos, Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
			end
		end
		if now - u.downAt >= K.KO_PARK then
			parkUnit(u, true)
		end
		return
	elseif u.parked then
		u.downAt = nil
		parkUnit(u, false)
	end
	u.accDt = (u.accDt or 0) + dt
	if u.parked or not animate then
		return
	end
	u.posed = true
	dt = u.accDt -- the time since this pet was last drawn (strided far / crowded pets)
	u.accDt = 0
	-- facing: the target while fighting, else the way it moves
	local want = nil
	local tgt = u.target and B.units[u.target]
	if tgt and (u.state == S_ATTACKING or u.state == S_CASTING or (u.state ~= S_RETREATING and mx * mx + mz * mz < 0.0004)) then
		want = yawToward(tgt.x - x, tgt.z - z)
	elseif mx * mx + mz * mz > 0.0004 then
		want = yawToward(mx, mz)
	end
	if want and u.state ~= S_STUNNED then
		local k = 1 - exp(-K.FACE_RATE * dt)
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * k
	end
	-- lunge / recoil / hop
	local ox, oz, oy = 0, 0, 0
	if u.lungeAt then
		local p = (now - u.lungeAt) / K.LUNGE_TIME
		if p >= 1 then
			u.lungeAt = nil
		else
			local amt = sin(p * pi) * (u.ranged and -K.RECOIL_DIST or K.LUNGE_DIST)
			ox, oz = u.lungeX * amt, u.lungeZ * amt
		end
	end
	if u.hopAt then
		local p = (now - u.hopAt) / K.HOP_TIME
		if p >= 1 then
			u.hopAt = nil
		elseif p > 0 then
			oy = sin(p * pi) * K.HOP_HEIGHT
		end
	end
	if u.hurtAt then
		local p = (now - u.hurtAt) / 0.18
		if p >= 1 then
			u.hurtAt = nil
		else
			local amt = sin(p * pi) * 0.3
			ox, oz = ox + (u.hurtX or 0) * amt, oz + (u.hurtZ or 0) * amt
		end
	end
	local bob = 0
	local stunned = u.state == S_STUNNED
	if not stunned then
		bob = sin(now * 3.1 + u.phase) * K.BOB
	end
	local cf = worldFrame(B, x + ox, (u.centerY or 1.5) + bob + oy, z + oz, u.yaw)
	if u.rigid then
		u.root.CFrame = cf
	else
		pcall(u.model.PivotTo, u.model, cf)
	end
	if PetBuilder and not u.animBroken then
		local opts = u.animOpts
		opts.Flap = stunned and 0 or ((u.state == S_RETREATING or mx * mx + mz * mz > 0.0004) and 1.8 or 1)
		opts.Excited = (u.state == S_ATTACKING or u.state == S_CASTING) and 0.6 or 0
		local ok = pcall(PetBuilder.Animate, u.model, now + u.phase, opts)
		if not ok then
			u.animBroken = true
		end
	end
	-- the HP bar (only when it changes)
	local frac = clamp(u.hp / u.maxHp, 0, 1)
	if u.barFill and abs(frac - (u.barFrac or -1)) > 0.004 then
		u.barFrac = frac
		u.barFill.Size = UDim2.new(max(frac, 0.02), -2, 1, -2)
	end
	-- shield cube and ice crystals follow the unit
	Units.UpdateStatus(B, u, now, cf)
end

-- shield bubble (while the snapshot reports a shield) and ice (while stunned)
function Units.UpdateStatus(B, u, now, cf)
	local h = u.height or 3
	if u.shield > 0 then
		local p = u.shieldPart
		if not p then
			p = make("Part", {
				Name = "ShieldCube",
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.ForceField,
				Color = COLORS.Shield,
				Transparency = 0,
				Size = Vector3.new(h * 1.25, h * 1.15, h * 1.25),
			}, u.model)
			u.shieldPart = p
		end
		p.CFrame = cf * CFrame.Angles(0, now * 0.8, 0)
	elseif u.shieldPart then
		u.shieldPart:Destroy()
		u.shieldPart = nil
	end
	local iced = u.state == S_STUNNED or (u.iceUntil and now < u.iceUntil)
	if iced then
		local p = u.icePart
		if not p then
			p = make("Model", { Name = "Ice" }, u.model)
			for i = 1, 5 do
				local a = (i / 5) * TAU
				local s = h * (0.28 + 0.06 * (i % 3))
				make("Part", {
					Name = "Crystal",
					Anchored = true,
					CanCollide = false,
					CanQuery = false,
					CanTouch = false,
					CastShadow = false,
					Material = Enum.Material.Glass,
					Color = COLORS.Ice,
					Transparency = 0.35,
					Size = Vector3.new(s * 0.45, s * 1.4, s * 0.45),
				}, p):SetAttribute("Angle", a)
			end
			u.icePart = p
		end
		local r = (u.radius or 1.8) * 0.75 * K.PET_SCALE * 0.6
		for _, c in ipairs(p:GetChildren()) do
			local a = c:GetAttribute("Angle") or 0
			c.CFrame = cf * CFrame.new(cos(a) * r, -h * 0.25, sin(a) * r) * CFrame.Angles(0.35 * cos(a), a, 0.35 * sin(a))
		end
	elseif u.icePart then
		u.icePart:Destroy()
		u.icePart = nil
	end
end

-- the raid boss: BossBuilder poses on the interpolated position
function Units.UpdateBoss(B, u, now, down, dt)
	local BB = lazyBoss()
	if not BB then
		return
	end
	local tgt = u.target and B.units[u.target]
	local want = nil
	if u.faceX then
		want = yawToward(u.faceX - u.x, u.faceZ - u.z)
	elseif tgt then
		want = yawToward(tgt.x - u.x, tgt.z - u.z)
	end
	if want and not down then
		u.yaw = u.yaw + wrapAngle(want - u.yaw) * (1 - exp(-3 * (dt or 0.016)))
	end
	local pose = u.pose
	local progress = 0
	if down then
		if pose ~= "Down" then
			Units.SetPose(u, "Down", 1.6)
			pose = "Down"
		end
	end
	if u.poseDur > 0 then
		progress = clamp((now - u.poseAt) / u.poseDur, 0, 1)
		if progress >= 1 and pose ~= "Down" and pose ~= "Windup" then
			Units.SetPose(u, "Idle", 0)
			pose = "Idle"
			u.faceX, u.faceZ = nil, nil
		end
	end
	if pose == "Windup" and u.windupAt then
		progress = clamp((B.renderT - u.windupFrom) / max(0.1, u.windupAt - u.windupFrom), 0, 1)
	end
	local opts = u.bossOpts
	opts.CFrame = worldFrame(B, u.x, 0, u.z, u.yaw)
	opts.Progress = progress
	opts.Attack = u.attackId
	opts.Enraged = B.enraged
	local ok, err = pcall(BB.Animate, u.model, pose, now, opts)
	if not ok then
		warnOnce("bossanim", "BossBuilder.Animate failed: " .. tostring(err))
	end
end

-- the world point of a unit's body centre (effects, numbers)
local function unitCenter(B, u)
	local y = u.isBoss and (u.height or 20) * 0.55 or (u.centerY or 1.5)
	return worldPoint(B, u.x, y, u.z)
end

----------------------------------------------------------------------
-- Telegraphs (boss attacks) and zones
----------------------------------------------------------------------
function Tele.Start(B, ev)
	local id = ev.id
	if id == nil or B.teles[id] then
		return
	end
	local fill, edge = Color3.fromRGB(255, 110, 90), Color3.fromRGB(255, 220, 160)
	local BB = lazyBoss()
	local boss = ev.boss and B.units[ev.boss]
	local bossId = (boss and boss.bossId) or B.BossId
	if BB and bossId then
		local ok, f, e = pcall(BB.TelegraphColor, bossId, ev.attack)
		if ok and typeof(f) == "Color3" then
			fill = f
			if typeof(e) == "Color3" then
				edge = e
			end
		end
	end
	local hits = max(0.2, num(ev.hits, 1.5))
	local at = num(ev.at, B.renderT + hits)
	local tl = {
		id = id,
		shape = ev.shape == "Line" and "Line" or "Circle",
		x = num(ev.x, 0),
		z = num(ev.z, 0),
		r = num(ev.r, 6),
		angle = num(ev.angle, 0),
		length = num(ev.length, 30),
		width = num(ev.width, 4),
		at = at,
		from = at - hits,
		-- the dodge deadline on the render clock: the render delay + the round trip + the run-out before the hit
		safeAt = max(at - hits + min(K.TELE_MIN_FILL, hits * 0.5), at - (interpDelay(B) + networkPing() + K.TELE_RUNOUT)),
		fill = fill,
		edgeColor = edge,
		freeze = ev.freeze,
	}
	-- the danger area: the pale edge colour tinted toward the fill, so it still shows on the pale arena sand
	local edgePart = Fx.Part(edge:Lerp(fill, 0.35), Enum.Material.Neon, 0.6)
	local fillPart = Fx.Part(fill, Enum.Material.Neon, 0.35)
	tl.edge, tl.fillPart = edgePart, fillPart
	if tl.shape == "Circle" then
		local cf = worldFrame(B, tl.x, 0.08, tl.z, 0) * CFrame.Angles(0, 0, pi / 2)
		if edgePart then
			edgePart.Shape = Enum.PartType.Cylinder
			edgePart.Size = Vector3.new(0.1, tl.r * 2, tl.r * 2)
			edgePart.CFrame = cf
		end
		if fillPart then
			fillPart.Shape = Enum.PartType.Cylinder
			fillPart.Size = Vector3.new(0.14, 0.1, 0.1)
			fillPart.CFrame = cf * CFrame.new(0.04, 0, 0)
		end
	else
		-- a line from (x, z) along angle (atan2(dz, dx) in zone space)
		local dx, dz = cos(tl.angle), sin(tl.angle)
		tl.dx, tl.dz = dx, dz
		local yaw = yawToward(dx, dz)
		tl.yaw = yaw
		if edgePart then
			edgePart.Size = Vector3.new(tl.width, 0.1, tl.length)
			edgePart.CFrame = worldFrame(B, tl.x + dx * tl.length / 2, 0.08, tl.z + dz * tl.length / 2, yaw)
		end
		if fillPart then
			fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, 0.1)
		end
	end
	-- a crisp rim in the saturated telegraph colour: the pale area alone barely reads on the arena's sand, the rim
	-- says exactly where safety starts (16 segments round a circle; two rails and an end cap along a line)
	local rimColor = fill:Lerp(Color3.new(0, 0, 0), 0.22)
	tl.rim = {}
	if tl.shape == "Circle" then
		local segLen = 2 * tl.r * math.tan(pi / 16) + 0.12
		for j = 0, 15 do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = Vector3.new(segLen, 0.16, 0.55)
			seg.CFrame = worldFrame(B, tl.x, 0.14, tl.z, 0) * CFrame.Angles(0, j * pi / 8, 0) * CFrame.new(0, 0, -(tl.r - 0.27))
			tl.rim[#tl.rim + 1] = seg
		end
	else
		-- the frame of edgePart: local X across the line, local Z along it
		local mid = worldFrame(B, tl.x + tl.dx * tl.length / 2, 0.14, tl.z + tl.dz * tl.length / 2, tl.yaw)
		local tip = worldFrame(B, tl.x + tl.dx * (tl.length - 0.27), 0.14, tl.z + tl.dz * (tl.length - 0.27), tl.yaw)
		local pieces = {
			{ mid * CFrame.new(tl.width / 2 - 0.27, 0, 0), Vector3.new(0.55, 0.16, tl.length) },
			{ mid * CFrame.new(-(tl.width / 2 - 0.27), 0, 0), Vector3.new(0.55, 0.16, tl.length) },
			{ tip, Vector3.new(tl.width, 0.16, 0.55) },
		}
		for _, piece in ipairs(pieces) do
			local seg = Fx.Part(rimColor, Enum.Material.Neon, 0.1)
			if not seg then
				break
			end
			seg.Size = piece[2]
			seg.CFrame = piece[1]
			tl.rim[#tl.rim + 1] = seg
		end
	end
	B.teles[id] = tl
	-- the boss winds up toward it
	if boss and boss.isBoss then
		Units.SetPose(boss, "Windup", hits, ev.attack)
		boss.windupFrom = tl.from
		boss.windupAt = tl.at
		if tl.shape == "Line" then
			boss.faceX, boss.faceZ = tl.x + (tl.dx or 0) * 10, tl.z + (tl.dz or 0) * 10
		else
			boss.faceX, boss.faceZ = tl.x, tl.z
		end
	end
end

function Tele.Free(tl)
	Fx.Free(tl.edge)
	Fx.Free(tl.fillPart)
	tl.edge, tl.fillPart = nil, nil
	for _, seg in ipairs(tl.rim or {}) do
		Fx.Free(seg)
	end
	tl.rim = nil
end

local function setRim(tl, transparency)
	for _, seg in ipairs(tl.rim or {}) do
		seg.Transparency = transparency
	end
end

-- is the zone-local point (x, z) inside the telegraph's shape (grown by pad studs)?
function Tele.Covers(tl, x, z, pad)
	local dx, dz = x - tl.x, z - tl.z
	if tl.shape == "Line" then
		local along = dx * (tl.dx or 1) + dz * (tl.dz or 0)
		if along < -pad or along > tl.length + pad then
			return false
		end
		return abs(dx * (tl.dz or 0) - dz * (tl.dx or 1)) <= tl.width / 2 + pad
	end
	return dx * dx + dz * dz <= (tl.r + pad) * (tl.r + pad)
end

-- one of my living pets stands in a telegraph that has not hit yet (the HUD's RETREAT! cue)
local function threatened(B, tl)
	for slot = 1, 4 do
		local u = B.mine[slot]
		if u and u.hp > 0 and u.state ~= S_DOWN and Tele.Covers(tl, u.x, u.z, K.THREAT_PAD) then
			return true
		end
	end
	return false
end

function Tele.Update(B, now)
	local t = B.renderT
	local threat = false
	for id, tl in pairs(B.teles) do
		if not threat and B.Fighter and t < tl.at and threatened(B, tl) then
			threat = true
		end
		if t >= tl.at then
			if not tl.impactAt then
				tl.impactAt = now
				-- the hit: a flash of the shape + a shock ring / burst
				local center
				if tl.shape == "Circle" then
					center = worldPoint(B, tl.x, 0.4, tl.z)
					Fx.Ring(center, tl.r, tl.edgeColor, 18, 0.9, 0.45, 0.05)
					Fx.Burst(center, tl.fill, 12, 12, 0.6, 0.55, { up = 0.9, color2 = tl.edgeColor })
				else
					local mid = worldPoint(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2)
					Fx.Beam(worldFrame(B, tl.x + tl.dx * tl.length / 2, 1.4, tl.z + tl.dz * tl.length / 2, tl.yaw), tl.length, tl.width * 0.8, tl.fill, 0.4)
					Fx.Burst(mid, tl.edgeColor, 8, 10, 0.5, 0.5, { up = 0.7 })
				end
				if tl.freeze then
					local c = worldPoint(B, tl.x, 0.6, tl.z)
					Fx.Burst(c, COLORS.Ice, 10, 9, 0.55, 0.6, { material = Enum.Material.Glass, alpha = 0.2, up = 0.8 })
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05
				end
				local boss = B.boss
				if boss and boss.pose == "Windup" then
					Units.SetPose(boss, "Attack", 0.7)
					boss.windupAt = nil
				end
			end
			local p = (now - tl.impactAt) / 0.35
			if p >= 1 then
				Tele.Free(tl)
				B.teles[id] = nil
			else
				if tl.edge then
					tl.edge.Transparency = 0.6 + 0.4 * p
				end
				if tl.fillPart then
					tl.fillPart.Transparency = 0.05 + 0.95 * p
				end
				setRim(tl, 0.1 + 0.9 * p)
			end
		else
			-- the fill completes at the dodge deadline (safeAt), then the shape flashes until the hit
			local fillEnd = tl.safeAt or tl.at
			local p = clamp((t - tl.from) / max(0.05, fillEnd - tl.from), 0, 1)
			if t >= fillEnd then
				if not tl.late then
					tl.late = true
					for _, seg in ipairs(tl.rim or {}) do
						seg.Color = COLORS.LateRim
					end
				end
				local on = sin(now * 26) > 0
				if tl.edge then
					tl.edge.Transparency = on and 0.25 or 0.65
				end
				setRim(tl, on and 0 or 0.6)
			else
				local pulse = 0.5 + 0.5 * sin(now * 10)
				if tl.edge then
					tl.edge.Transparency = 0.5 + 0.2 * pulse
				end
				setRim(tl, 0.05 + 0.3 * pulse)
			end
			if tl.fillPart then
				if tl.shape == "Circle" then
					local d = max(0.1, tl.r * 2 * p)
					tl.fillPart.Size = Vector3.new(0.14, d, d)
				else
					local len = max(0.1, tl.length * p)
					tl.fillPart.Size = Vector3.new(tl.width * 0.96, 0.14, len)
					tl.fillPart.CFrame = worldFrame(B, tl.x + tl.dx * len / 2, 0.12, tl.z + tl.dz * len / 2, tl.yaw)
				end
				tl.fillPart.Transparency = 0.45 - 0.25 * p
			end
		end
	end
	B.threat = threat
end

function Tele.ClearAll(B)
	for id, tl in pairs(B.teles) do
		Tele.Free(tl)
		B.teles[id] = nil
	end
end

----------------------------------------------------------------------
-- Events (played on the delayed render clock)
----------------------------------------------------------------------
local function specialColor(u, kind)
	if u and u.special and typeof(u.special.Color) == "Color3" then
		return u.special.Color
	end
	if u then
		return elementColor(u.element)
	end
	if kind == "Heal" then
		return COLORS.Heal
	end
	return COLORS.Gold
end

local function numberHeight(u)
	if u.isBoss then
		return (u.height or 20) * 0.5 + 2
	end
	return (u.height or 3) / 2 + 1.8
end

local Handlers = {}

Handlers[EV.Hit] = function(B, ev)
	local victim = B.units[tonumber(ev.to) or -1]
	local attacker = ev.from and B.units[tonumber(ev.from) or -1]
	if not victim then
		return
	end
	local dmg = num(ev.dmg, 0)
	-- attacker motion: plain attacks lunge (melee) or shoot a bolt (ranged)
	if attacker and not ev.special and not ev.zone and not ev.tele then
		if attacker.isBoss then
			if attacker.pose ~= "Windup" and attacker.pose ~= "Attack" and attacker.pose ~= "Enrage" then
				Units.SetPose(attacker, "Basic", 0.6, ev.attack)
				attacker.faceX, attacker.faceZ = victim.x, victim.z
			end
			Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.7, 0.35)
		else
			local dx, dz = victim.x - attacker.x, victim.z - attacker.z
			local d = sqrt(dx * dx + dz * dz)
			if d > 0.01 then
				attacker.lungeAt = os.clock()
				attacker.lungeX, attacker.lungeZ = dx / d, dz / d
			end
			if attacker.ranged and attacker.model and not attacker.parked then
				Fx.Bolt(unitCenter(B, attacker), unitCenter(B, victim), elementColor(attacker.element), 0.42, 0.24)
			end
		end
	end
	-- victim feedback
	if not victim.isBoss and attacker then
		local dx, dz = victim.x - attacker.x, victim.z - attacker.z
		local d = sqrt(dx * dx + dz * dz)
		if d > 0.01 then
			victim.hurtAt = os.clock()
			victim.hurtX, victim.hurtZ = dx / d, dz / d
		end
	end
	if not ev.zone or math.random() < 0.5 then
		Fx.Flash(victim, (ev.elem and ev.elem > 1) and Color3.fromRGB(255, 226, 190) or COLORS.White)
	end
	local adornee = victim.root
	if not adornee or victim.parked then
		return
	end
	local text, color, px = tostring(floor(dmg + 0.5)), COLORS.White, K.NUMBER_PX
	if ev.crit then
		text = "CRIT " .. text
		color = COLORS.Gold
		px = K.CRIT_PX
	elseif ev.elem and ev.elem > 1 then
		text = text .. "!"
		color = COLORS.Strong
		px = K.NUMBER_PX + 2
	elseif ev.elem and ev.elem < 1 then
		color = COLORS.Weak
	end
	if victim.mine then
		color = (color == COLORS.White) and Color3.fromRGB(255, 196, 196) or color
	end
	if ev.special and attacker then
		color = specialColor(attacker):Lerp(COLORS.White, 0.35)
		px = max(px, K.NUMBER_PX + 2)
	end
	if dmg > 0 then
		Fx.Number(adornee, numberHeight(victim), text, color, px)
	end
	if num(ev.absorbed, 0) > 0 then
		Fx.Number(adornee, numberHeight(victim) + 0.8, "BLOCK " .. tostring(floor(ev.absorbed + 0.5)), COLORS.Shield, K.NUMBER_PX - 2, 0.8)
	end
	if ev.freeze then
		victim.iceUntil = os.clock() + num(ev.freeze, 2)
	end
end

Handlers[EV.Special] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	local kind = tostring(ev.kind or "")
	local color = specialColor(u, kind)
	local S = SPECIALS[kind] or {}
	if u and u.root and not u.parked then
		local label = tostring(ev.name or kind)
		Fx.Number(u.root, numberHeight(u) + 0.6, string.upper(label) .. "!", color:Lerp(COLORS.White, 0.2), K.CALLOUT_PX, 1.2)
		Fx.Burst(unitCenter(B, u), color, 8, 6, 0.35, 0.45, { up = 0.9, gravity = 4 })
	end
	local tx, tz = num(ev.tx, num(ev.x, 0)), num(ev.tz, num(ev.z, 0))
	if kind == "Blast" then
		local c = worldPoint(B, tx, 0.6, tz)
		local r = num(S.Radius, 7)
		Fx.Ring(c, r, color, 20, 0.8, 0.5, 0.05)
		Fx.Burst(c + Vector3.new(0, 0.8, 0), color, 16, 13, 0.6, 0.6, { color2 = COLORS.White:Lerp(color, 0.4), up = 0.8 })
	elseif kind == "Heal" then
		for _, h in ipairs(type(ev.heals) == "table" and ev.heals or {}) do
			local a = B.units[tonumber(h[1]) or -1]
			if a and a.root and not a.parked then
				Fx.Rise(unitCenter(B, a), COLORS.Heal, 8, 0.32, 0.9, 1.6)
				if num(h[2], 0) > 0 then
					Fx.Number(a.root, numberHeight(a), "+" .. tostring(floor(num(h[2], 0) + 0.5)), COLORS.Heal, K.NUMBER_PX)
				end
			end
		end
	elseif kind == "Shield" then
		local seconds = num(S.Seconds, 6)
		for _, id in ipairs(type(ev.shields) == "table" and ev.shields or {}) do
			local a = B.units[tonumber(id) or -1]
			if a and a.root and not a.parked then
				a.shieldUntil = os.clock() + seconds + 0.5
				Fx.Ring(unitCenter(B, a), 2.2, COLORS.Shield, 10, 0.4, 0.5, 0.2)
			end
		end
	elseif kind == "Pounce" then
		if u then
			local a = worldPoint(B, num(ev.x, u.x), 1.4, num(ev.z, u.z))
			local b = worldPoint(B, tx, 1.4, tz)
			Fx.Trail(a, b, color, 9, 0.5)
			u.hopAt = os.clock()
		end
		Fx.Burst(worldPoint(B, tx, 1.2, tz), color, 12, 11, 0.5, 0.55, { up = 0.7, color2 = COLORS.White })
	elseif kind == "Freeze" then
		local c = worldPoint(B, tx, 0.5, tz)
		local r = num(S.Radius, 6)
		Fx.Ring(c, r, COLORS.Ice, 16, 0.7, 0.55, 0.1)
		Fx.Burst(c + Vector3.new(0, 0.6, 0), COLORS.Ice, 14, 10, 0.55, 0.7, { material = Enum.Material.Glass, alpha = 0.15, up = 0.8, color2 = COLORS.White })
		local stun = num(S.Stun, 1) + 0.4
		for _, id in ipairs(type(ev.stunned) == "table" and ev.stunned or {}) do
			local a = B.units[tonumber(id) or -1]
			if a then
				a.iceUntil = os.clock() + stun
			end
		end
	elseif kind == "Beam" then
		local length = num(S.Length, 26)
		local width = num(S.Width, 4)
		local angle = num(ev.angle, 0)
		local dx, dz = cos(angle), sin(angle)
		local sx, sz = num(ev.x, u and u.x or 0), num(ev.z, u and u.z or 0)
		local cf = worldFrame(B, sx + dx * length / 2, 1.6, sz + dz * length / 2, yawToward(dx, dz))
		Fx.Beam(cf, length, width * 0.7, color, 0.5)
		Fx.Burst(worldPoint(B, sx + dx * length, 1.6, sz + dz * length), color, 8, 8, 0.4, 0.45, { up = 0.5 })
	elseif kind == "Storm" then
		-- the Zone event that follows draws the cloud
		Fx.Burst(worldPoint(B, tx, 5, tz), COLORS.StormLight, 6, 5, 0.6, 0.5, { up = 0.3, gravity = 2 })
	end
end

Handlers[EV.Zone] = function(B, ev)
	local kind = tostring(ev.kind or "")
	local x, z = num(ev.x, 0), num(ev.z, 0)
	local r = num(ev.r, 6)
	local seconds = max(0.5, num(ev.seconds, 4))
	local floorCF = worldFrame(B, x, 0, z, 0)
	if kind == "Storm" then
		local u = B.units[tonumber(ev.unit) or -1]
		Fx.Zone(floorCF, r, seconds, specialColor(u, "Storm"), "Storm")
	else
		local color = Color3.fromRGB(255, 120, 60)
		local BB = lazyBoss()
		if BB and B.BossId then
			local ok, f = pcall(BB.TelegraphColor, B.BossId, ev.attack)
			if ok and typeof(f) == "Color3" then
				color = f
			end
		end
		Fx.Zone(floorCF, r, seconds, color, "Linger")
	end
end

Handlers[EV.KO] = function(B, ev)
	local u = B.units[tonumber(ev.unit) or -1]
	if not u then
		return
	end
	if u.root and not u.parked then
		Fx.Number(u.root, numberHeight(u) + 0.4, "KO!", Color3.fromRGB(220, 226, 240), K.CALLOUT_PX, 1.1)
		if not u.isBoss and not u.poofed then
			u.poofed = true
			Fx.Burst(unitCenter(B, u), Color3.fromRGB(236, 240, 250), 12, 9, 0.5, 0.6, { color2 = elementColor(u.element), alpha = 0.05 })
		elseif u.isBoss then
			Fx.Burst(unitCenter(B, u), elementColor(u.element), 24, 16, 0.9, 1.1, { color2 = COLORS.White, up = 0.9 })
		end
	end
	u.hp = 0
	u.state = S_DOWN
	if B.focus == u.id then
		B.focus = nil
	end
end

Handlers[EV.Telegraph] = function(B, ev)
	Tele.Start(B, ev)
end

Handlers[EV.Spawn] = function(B, ev)
	for _, info in ipairs(type(ev.units) == "table" and ev.units or {}) do
		local u = Units.Add(B, info)
		if u then
			u.spawnFx = true
		end
	end
	if ev.wave then
		B.wave = num(ev.wave, 0)
		local boss = B.boss
		if boss and boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "MINIONS!", COLORS.Enemy:Lerp(COLORS.White, 0.3), K.CALLOUT_PX, 1.4)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.Enrage] = function(B, ev)
	B.enraged = true
	local boss = B.units[tonumber(ev.unit) or -1] or B.boss
	if boss and boss.model then
		local BB = lazyBoss()
		if BB then
			pcall(BB.SetEnraged, boss.model, true)
		end
		Units.SetPose(boss, "Enrage", 1.3)
		if boss.root then
			Fx.Number(boss.root, numberHeight(boss) + 1, "ENRAGED!", COLORS.Enemy, K.CRIT_PX, 1.6)
		end
		Fx.Ring(unitCenter(B, boss), 14, COLORS.Enemy, 24, 1, 0.8, 0.1)
	end
end

Handlers[EV.Order] = function(B, ev)
	if ev.owner ~= myUserId() then
		return
	end
	if ev.order == "Retreat" then
		B.order = "Retreat"
		B.retreatAt = os.clock()
		B.focus = nil
	elseif ev.order == "Attack" then
		B.order = "Attack"
		B.focus = tonumber(ev.target)
	end
end

Handlers[EV.Leave] = function(B, ev)
	for _, id in ipairs(type(ev.units) == "table" and ev.units or {}) do
		local u = B.units[tonumber(id) or -1]
		if u then
			if u.root and not u.parked then
				Fx.Burst(unitCenter(B, u), Color3.fromRGB(226, 232, 246), 8, 7, 0.45, 0.5, { alpha = 0.1 })
			end
			Units.Remove(B, u.id)
		end
	end
	Hud.Rebuild()
end

Handlers[EV.End] = function(B)
	B.simEnded = true
end

-- Phase 4 duel rule (BattleCatalog.Damage.Overtime): past `at` seconds every hit grows by `perSecond` per second; the
-- top card says so (a red OVERTIME pill under the enemies) for the rest of the duel
Handlers[EV.Overtime or "Overtime"] = function(B, ev)
	if B.overtime then
		return
	end
	B.overtime = true
	B.overtimeRate = num(ev.perSecond, 0.15)
	pcall(Hud.Rebuild)
end

function Net.PlayDue(B, now)
	local q = B.evq
	if #q == 0 then
		return
	end
	local played = 0
	local t = B.renderT
	while #q > 0 and (q[1].t <= t or #q > 400) do
		local item = table.remove(q, 1)
		local fn = Handlers[item.ev.type]
		if fn then
			local ok, err = pcall(fn, B, item.ev)
			if not ok then
				warnOnce("event_" .. tostring(item.ev.type), "event " .. tostring(item.ev.type) .. " failed: " .. tostring(err))
			end
		end
		played = played + 1
		if played > 120 then
			break
		end
	end
end

----------------------------------------------------------------------
-- HUD
----------------------------------------------------------------------
local function label(parent, text, role, size, props)
	local l = Theme.Label(text, role, { Size = size, Stroke = 0.15, Outline = 2 })
	l.BackgroundTransparency = 1
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

local function card(parent, name, props)
	local f = Theme.Panel(props)
	f.Name = name
	f.Parent = parent
	return f
end

local function smallPill(parent, text, color, props)
	local dark = Theme.Darken(color, 0.62)
	local l = Theme.Label(text, "Heading", { Size = 15, Stroke = 0.1, StrokeColor = dark, Outline = 1.5, OutlineColor = dark })
	l.Name = "Pill"
	l.BackgroundTransparency = 0
	l.BackgroundColor3 = color
	l.BorderSizePixel = 0
	l.AutomaticSize = Enum.AutomaticSize.X
	l.Size = UDim2.fromOffset(0, 22)
	l.TextXAlignment = Enum.TextXAlignment.Center
	Theme.Corner(l, UDim.new(0, 11))
	Theme.Stroke(l, COLORS.Navy, 2, 0)
	make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, l)
	if props then
		for key, value in pairs(props) do
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

local function bar(parent, name, height, color, props)
	if CloudUI and type(CloudUI.Bar) == "function" then
		local b = CloudUI.Bar({ Name = name, Height = height, Color = color, Parent = parent, TextSize = props and props.TextSize })
		if props then
			if props.Size then
				b.Root.Size = props.Size
			end
			if props.Position then
				b.Root.Position = props.Position
			end
			if props.AnchorPoint then
				b.Root.AnchorPoint = props.AnchorPoint
			end
		end
		return b
	end
	-- fallback without CloudUI
	local root = make("Frame", { Name = name, BackgroundColor3 = COLORS.Track, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height) }, parent)
	if props then
		for key, value in pairs(props) do
			if key ~= "TextSize" then
				root[key] = value
			end
		end
	end
	Theme.Corner(root, UDim.new(0, 6))
	local fill = make("Frame", { Name = "Fill", BackgroundColor3 = color, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1) }, root)
	Theme.Corner(fill, UDim.new(0, 6))
	local text = label(root, "", "Heading", 15, { Size = UDim2.fromScale(1, 1), ZIndex = 3 })
	return {
		Root = root,
		Fill = fill,
		Label = text,
		SetFraction = function(f)
			fill.Size = UDim2.fromScale(clamp(f, 0, 1), 1)
		end,
		SetText = function(t)
			text.Text = tostring(t or "")
		end,
		SetColor = function(c)
			fill.BackgroundColor3 = c
		end,
	}
end

-- a thin bar without text (the special meter, enemy chips): returns { Root, Fill }
local function thinBar(parent, name, height, color, props)
	local root = make("Frame", {
		Name = name,
		BackgroundColor3 = COLORS.Track,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, height),
	}, parent)
	if props then
		for key, value in pairs(props) do
			root[key] = value
		end
	end
	Theme.Corner(root, UDim.new(0, max(2, floor(height / 2))))
	Theme.Stroke(root, COLORS.Navy, 2, 0)
	local fill = make("Frame", {
		Name = "Fill",
		BackgroundColor3 = color,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
	}, root)
	Theme.Corner(fill, UDim.new(0, max(2, floor(height / 2))))
	return { Root = root, Fill = fill, frac = 1 }
end

local function setThin(b, frac)
	frac = clamp(frac, 0, 1)
	if abs(frac - (b.frac or -1)) > 0.003 then
		b.frac = frac
		b.Fill.Size = UDim2.fromScale(max(frac, 0.001), 1)
		b.Fill.Visible = frac > 0.002
	end
end

-- a rough width of `text` in px at `size` (bold display fonts run ~0.62 em per character)
local function textWidth(text, size)
	return #tostring(text or "") * size * 0.62
end

local function setText(lbl, text)
	if lbl and lbl.Text ~= text then
		lbl.Text = text
	end
end

local function keyChip(parent, text, props)
	local chip = make("Frame", {
		Name = "Key",
		BackgroundColor3 = COLORS.Navy,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(30, 26),
		ZIndex = 6,
	}, parent)
	Theme.Corner(chip, UDim.new(0, 7))
	Theme.Stroke(chip, COLORS.White, 1.5, 0.35)
	local l = label(chip, text, "Heading", 15, { Name = "Text", Size = UDim2.fromScale(1, 1), ZIndex = 7, TextXAlignment = Enum.TextXAlignment.Center })
	if props then
		for key, value in pairs(props) do
			chip[key] = value
		end
	end
	return chip, l
end

local function button(parent, name, text, style, size, callback)
	local b
	if CloudUI and type(CloudUI.Button) == "function" then
		b = CloudUI.Button({ Name = name, Text = text, Style = style, Size = size, TextSize = 22, Parent = parent, Callback = callback })
	else
		b = make("TextButton", { Name = name, Text = text, Size = size, BackgroundColor3 = Theme.Buttons[style] or COLORS.Ally, AutoButtonColor = true }, parent)
		Theme.Style(b, "Button", { Size = 22 })
		Theme.Corner(b, UDim.new(0, 12))
		b.Activated:Connect(function()
			callback(b)
		end)
	end
	return b
end

-- every HUD text stays >= MIN_TEXT_PX on the screen: design sizes grow to MIN_TEXT_PX / factor on small screens
-- (the 1080p design sizes are kept as the attribute BaseText)
function Hud.FixText(root, factor)
	local minDesign = math.ceil(K.MIN_TEXT_PX / max(0.05, factor) - 1e-6)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
			local base = d:GetAttribute("BaseText")
			if type(base) ~= "number" then
				base = d.TextSize
				d:SetAttribute("BaseText", base)
			end
			local want = max(base, minDesign)
			if d.TextSize ~= want then
				d.TextSize = want
			end
		end
	end
end

local function setDisabled(b, disabled)
	if (b:GetAttribute("Disabled") == true) ~= (disabled == true) then
		b:SetAttribute("Disabled", disabled == true)
	end
end


function Hud.Ensure()
	if Hud.gui and Hud.gui.Parent then
		return true
	end
	local playerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then
		return false
	end
	local old = playerGui:FindFirstChild(K.GUI_NAME)
	if old then
		old:Destroy()
	end
	local gui = make("ScreenGui", {
		Name = K.GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.DISPLAY_ORDER,
		Enabled = true,
	}, playerGui)
	local root = make("Frame", { Name = "Root", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, gui)
	Hud.scale = make("UIScale", { Name = "ReadScale", Scale = 1 }, root)
	Hud.gui, Hud.root = gui, root
	Hud.top = card(root, "TopCard", { Visible = false, AnchorPoint = Vector2.new(0.5, 0) })
	Hud.team = make("Frame", { Name = "Team", BackgroundTransparency = 1, Visible = false }, root)
	Hud.cmd = make("Frame", { Name = "Commands", BackgroundTransparency = 1, Visible = false }, root)
	Hud.result = card(root, "ResultCard", { Visible = false })
	Hud.rows = {}
	Hud.chips = {}
	Hud.BuildCommands()
	return true
end

-- the screen in design pixels + the layout kind
function Hud.Metrics()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	local f = Theme.ScreenFactor(vp.Y)
	local w = vp.X / f
	local h = max(200, vp.Y - inset) / f
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local compact = touch or w < 1150 or h < 640
	return { W = w, H = h, F = f, Compact = compact, Touch = touch, Landscape = w / h > 1.3, VX = vp.X, VY = vp.Y, Inset = inset }
end

function Hud.KeyText(kind, slot)
	if St.gamepad then
		if kind == "Attack" then
			return "X"
		elseif kind == "Retreat" then
			return "Y"
		end
		return ({ "LB", "RB", "LT", "RT" })[slot] or ""
	end
	if kind == "Attack" then
		return "F"
	elseif kind == "Retreat" then
		return "R"
	end
	return tostring(slot)
end

----------------------------------------------------------------------
-- LEAVE: stops a Champion Ring run or a Trial (BattleCommand "Forfeit"; the server ends the run cleanly and the
-- climber comes back at the portal). Never in duels (a forfeit costs trophies) or raids. Two presses, like
-- HudController's match Leave: the first turns it into "Sure? Tap again" for LEAVE_CONFIRM seconds, the second
-- sends it. One button beside the commands (a child of Commands, so it goes wherever they go) and one on the ring's
-- next-round card; both share the confirm state. Repainted only on a press / its timeout (task.delay), never per frame.
----------------------------------------------------------------------
Leave.armedUntil = 0
Leave.sentUntil = 0
Leave.buttons = {}

function Leave.Allowed(B)
	return B ~= nil and B.Fighter == true and (B.Mode == "Ring" or B.Mode == "Trial")
end

function Leave.Make(parent, textSize)
	local b = button(parent, "LeaveButton", "LEAVE", "Pink", UDim2.fromOffset(K.LEAVE_W, K.CMD_H), function()
		Leave.Press()
	end)
	b.TextWrapped = true
	b.TextSize = textSize
	b:SetAttribute("BaseText", textSize)
	b:SetAttribute("LeaveStyle", "Pink")
	Leave.buttons[#Leave.buttons + 1] = b
	return b
end

-- the shown text + style for the current confirm state
function Leave.State(now)
	if now < Leave.sentUntil then
		return "Leaving...", "Gray"
	elseif now < Leave.armedUntil then
		return "Sure? Tap again", "Red"
	end
	return "LEAVE", "Pink"
end

function Leave.Paint()
	local text, style = Leave.State(os.clock())
	local live = {}
	for _, b in ipairs(Leave.buttons) do
		if b.Parent then
			live[#live + 1] = b
			setText(b, text)
			if b:GetAttribute("LeaveStyle") ~= style then
				b:SetAttribute("LeaveStyle", style)
				if CloudUI and type(CloudUI.SetStyle) == "function" then
					CloudUI.SetStyle(b, style)
				else
					b.BackgroundColor3 = Theme.Buttons[style] or COLORS.Ally
				end
			end
		end
	end
	Leave.buttons = live
end

function Leave.Press()
	local now = os.clock()
	if now < Leave.sentUntil or not Leave.Allowed(St.battle) then
		return
	end
	if now < Leave.armedUntil then
		Leave.armedUntil = 0
		if BattleController.Command("Forfeit") then
			Leave.sentUntil = now + K.LEAVE_CONFIRM -- the run's End normally closes the HUD long before this
		end
	else
		Leave.armedUntil = now + K.LEAVE_CONFIRM
	end
	Leave.Paint()
	task.delay(K.LEAVE_CONFIRM + 0.05, Leave.Paint) -- back to LEAVE when nobody pressed again
end

-- a new battle (a ring round too) and the step from a fight to the next-round card start unarmed
function Leave.Track(B)
	local phase = B and B.ended and "next" or "fight"
	if Leave.battle ~= B or Leave.phase ~= phase then
		Leave.battle = B
		Leave.phase = phase
		Leave.armedUntil = 0
		Leave.sentUntil = 0
		Leave.Paint()
	end
end

-- the HUD's vitals card (NimbusHud BottomLeft.Vitals) in design px: left, top, right, bottom (nil when not shown;
-- like Ring.CurrencyBottom: both GUIs are laid out below the top bar)
function Leave.Vitals(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local v = hud and hud:FindFirstChild("Vitals", true)
	if not v or not v:IsA("GuiObject") or not v.Visible or v.AbsoluteSize.X <= 0 then
		return nil
	end
	local f = max(0.05, m.F)
	local p, size = v.AbsolutePosition, v.AbsoluteSize
	return floor(p.X / f), floor(p.Y / f), math.ceil((p.X + size.X) / f), math.ceil((p.Y + size.Y) / f)
end

local function leaveSize(b, w, h, text)
	b.Size = UDim2.fromOffset(w, h)
	b.TextSize = text
	b:SetAttribute("BaseText", text)
end

-- the commands' LEAVE: wide = left of ATTACK / RETREAT; compact portrait = above ATTACK in the right-edge column;
-- a landscape phone = under the left-edge team grid (the commands row has the currency pill above it and DASH under
-- RETREAT); a landscape screen with the team on top = under ATTACK. Positions are relative to the Commands frame.
function Leave.Place(m, B, isFighting)
	Leave.Track(B)
	local b = Hud.leave
	if not b then
		return
	end
	b.Visible = isFighting == true and Leave.Allowed(B)
	if not b.Visible then
		return
	end
	local cw, ch = Hud.cmd.Size.X.Offset, Hud.cmd.Size.Y.Offset
	if not m.Compact then
		leaveSize(b, K.LEAVE_W, K.CMD_H, 22)
		b.Position = UDim2.fromOffset(-K.LEAVE_W - 12, 0)
	elseif not m.Landscape then
		leaveSize(b, cw, K.LEAVE_H, 18)
		b.Position = UDim2.fromOffset(0, -K.LEAVE_H - 12)
	elseif Hud.teamPlace == "Left" then
		-- as wide as the grid, but never into the vitals card (a short phone puts it right next to the grid)
		local left = Hud.cmd.Position.X.Offset - cw -- Commands is anchored at its top-right corner
		local y = 6 + Hud.team.Size.Y.Offset + 10
		local w = min(Hud.team.Size.X.Offset, K.LEAVE_W_GRID)
		local vl, _, _, vb = Leave.Vitals(m)
		if vl and vb > y then
			w = max(K.LEAVE_W_MIN, min(w, vl - 10 - K.SIDE_X))
		end
		leaveSize(b, w, (w >= K.LEAVE_W_GRID - 10) and K.LEAVE_H_GRID or K.LEAVE_H, 18) -- narrower: "Sure? Tap again" takes two lines
		b.Position = UDim2.fromOffset(K.SIDE_X - left, y - Hud.cmd.Position.Y.Offset)
	else
		leaveSize(b, K.TOUCH_W, K.LEAVE_H, 18)
		b.Position = UDim2.fromOffset(0, ch + 10)
	end
	Hud.TrimButton(b, m.Compact)
	Leave.Paint()
end

-- the next-round card's LEAVE: a row at the bottom of the card (returns the card's new height); on a landscape phone
-- beside the card's bottom-left corner, under the top card (no room inside or below: the currency pill is above the
-- card, DASH / RUN below it)
function Leave.PlaceOnCard(m, B, w, y)
	local b = Hud.nextLeave
	if not b then
		return y
	end
	Leave.Track(B)
	b.Visible = Leave.Allowed(B)
	if not b.Visible then
		return y
	end
	Hud.TrimButton(b, m.Compact)
	Leave.Paint()
	if m.Compact and m.Landscape then
		leaveSize(b, K.LEAVE_TAB_W, K.LEAVE_H, 18)
		local cardTop = Hud.next.Position.Y.Offset -- the card is anchored at its top-right corner here
		local below = 6 + (Hud.topH or 80) + 8 - cardTop -- the top card's bottom + a gap, card-relative
		local at = y - K.LEAVE_H -- level with the card's bottom ...
		local vl, vt, vr = Leave.Vitals(m)
		local x1 = Hud.next.Position.X.Offset - w - 8 -- (the card's left edge - the gap)
		if vl and vr > x1 - K.LEAVE_TAB_W and vl < x1 then
			at = min(at, vt - cardTop - 8 - K.LEAVE_H) -- ... but above the vitals card when it reaches under it
		end
		b.AnchorPoint = Vector2.new(1, 0)
		b.Position = UDim2.fromOffset(-8, max(at, below))
		return y
	end
	leaveSize(b, min(w - 2 * K.PAD - 8, K.LEAVE_CARD_W), K.LEAVE_H - 4, m.Compact and 18 or 22) -- one line, also armed
	b.AnchorPoint = Vector2.new(1, 0)
	b.Position = UDim2.new(1, -K.PAD - 4, 0, y)
	return y + K.LEAVE_H - 4 + K.PAD
end

function Hud.BuildCommands()
	local cmd = Hud.cmd
	Hud.attack = button(cmd, "AttackButton", "ATTACK", "Red", UDim2.fromOffset(215, K.CMD_H), function()
		BattleController.Command("Attack", nil)
	end)
	Hud.retreat = button(cmd, "RetreatButton", "RETREAT", "Blue", UDim2.fromOffset(215, K.CMD_H), function()
		BattleController.Command("Retreat")
	end)
	Hud.leave = Leave.Make(cmd, 20)
	Hud.attackKey = keyChip(Hud.attack, "F", { Position = UDim2.fromOffset(-6, -8) })
	Hud.retreatKey = keyChip(Hud.retreat, "R", { Position = UDim2.fromOffset(-6, -8) })
	for _, b in ipairs({ Hud.attack, Hud.retreat }) do
		local ring = make("Frame", {
			Name = "ActiveRing",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 10, 1, 10),
			Position = UDim2.fromOffset(-5, -5),
			Visible = false,
			ZIndex = 0,
		}, b)
		Theme.Corner(ring, UDim.new(0, 16))
		Theme.Stroke(ring, COLORS.Gold, 3, 0)
	end
end

local function rowFor(i)
	local row = Hud.rows[i]
	if row then
		return row
	end
	row = {}
	local f = make("Frame", { Name = "Row" .. i, BackgroundColor3 = COLORS.Panel, BackgroundTransparency = 0.15, BorderSizePixel = 0 }, Hud.team)
	Theme.Corner(f, UDim.new(0, 12))
	Theme.Stroke(f, COLORS.Navy, 2, 0)
	row.Frame = f
	-- slot chip (element coloured, with the key)
	local chip = make("Frame", { Name = "Slot", BackgroundColor3 = COLORS.Ally, BorderSizePixel = 0 }, f)
	Theme.Corner(chip, UDim.new(0, 10))
	Theme.Stroke(chip, COLORS.Navy, 2, 0)
	row.Chip = chip
	row.ChipText = label(chip, tostring(i), "Display", 24, { Name = "Text", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center })
	row.Name = label(f, "", "Body", 18, { Name = "PetName", RichText = true, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
	row.Level = label(f, "", "Label", 16, { Name = "Level", TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = COLORS.Muted })
	row.Element = smallPill(f, "", COLORS.Ally, { Name = "Element" })
	row.Hp = bar(f, "Hp", 22, COLORS.Mine, { TextSize = 15 })
	row.Meter = thinBar(f, "Meter", 8, COLORS.Gold)
	-- the special button
	row.Glow = make("Frame", { Name = "Glow", BackgroundColor3 = COLORS.Gold, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, f)
	Theme.Corner(row.Glow, UDim.new(0, 16))
	local sb = make("TextButton", { Name = "Special", Text = "", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(110, 120, 150), BorderSizePixel = 0, ZIndex = 2 }, f)
	Theme.Corner(sb, UDim.new(0, 12))
	row.SpecialStroke = Theme.Stroke(sb, COLORS.Navy, 3, 0)
	row.SpecialTop = label(sb, "SPECIAL", "Button", 20, { Name = "Top", TextXAlignment = Enum.TextXAlignment.Center })
	row.SpecialSub = label(sb, "", "Label", 15, { Name = "Sub", TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	row.Special = sb
	-- the compact card: the whole card is the special button
	row.CardHit = make("TextButton", { Name = "CardHit", Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 8, Visible = false }, f)
	local slot = i
	sb.Activated:Connect(function()
		BattleController.Command("Special", Hud.SlotOfRow(slot))
	end)
	row.CardHit.Activated:Connect(function()
		BattleController.Command("Special", Hud.SlotOfRow(slot))
	end)
	Hud.rows[i] = row
	return row
end

function Hud.SlotOfRow(i)
	local row = Hud.rows[i]
	return row and row.slot or i
end

-- lays the team rows out (wide: rows; compact: cards in a row, or a grid of `cols` columns no wider than maxW)
function Hud.LayoutTeam(m, units, cols, maxW)
	local n = #units
	for i = 1, max(n, #Hud.rows) do
		local row = (i <= n) and rowFor(i) or Hud.rows[i]
		if row then
			row.Frame.Visible = i <= n
		end
	end
	if n == 0 then
		return 0, 0
	end
	if not m.Compact then
		local w = K.TEAM_W
		local y = K.PAD + K.HEAD_H
		for i = 1, n do
			local row = Hud.rows[i]
			local f = row.Frame
			f.Size = UDim2.fromOffset(w - 2 * K.PAD, K.ROW_H)
			f.Position = UDim2.fromOffset(K.PAD, y)
			row.Chip.Size = UDim2.fromOffset(40, 40)
			row.Chip.Position = UDim2.fromOffset(8, 15)
			row.Chip.Visible = true
			row.ChipText.TextSize = 24
			row.ChipText:SetAttribute("BaseText", 24)
			local mid = (w - 2 * K.PAD) - 144 - 8 - 56 -- the middle column between the slot chip and the button
			local pillW = 22 + textWidth(units[i].element or "?", max(15, math.ceil(K.MIN_TEXT_PX / max(0.05, m.F))))
			row.Name.Position = UDim2.fromOffset(56, 5)
			row.Name.Size = UDim2.fromOffset(max(60, mid - pillW - 8), 24)
			row.Name.TextSize = 18
			row.Name:SetAttribute("BaseText", 18)
			row.Level.Visible = false
			row.Element.Visible = true
			row.Element.AnchorPoint = Vector2.new(1, 0)
			row.Element.Position = UDim2.fromOffset(56 + mid, 6)
			row.Hp.Root.Visible = true
			row.Hp.Root.Position = UDim2.fromOffset(56, 32)
			row.Hp.Root.Size = UDim2.fromOffset(mid, 22)
			row.Meter.Root.Position = UDim2.fromOffset(56, 58)
			row.Meter.Root.Size = UDim2.fromOffset(mid, 8)
			row.Special.Visible = true
			row.Special.Size = UDim2.fromOffset(136, 56)
			row.Special.Position = UDim2.new(1, -144, 0, 7)
			row.Glow.Size = UDim2.fromOffset(146, 66)
			row.Glow.Position = UDim2.new(1, -149, 0, 2)
			row.SpecialTop.TextSize = 20
			row.SpecialTop:SetAttribute("BaseText", 20)
			row.SpecialTop.Position = UDim2.fromOffset(0, 5)
			row.SpecialTop.Size = UDim2.new(1, 0, 0, 24)
			row.SpecialSub.Visible = true
			row.SpecialSub.Position = UDim2.fromOffset(6, 30)
			row.SpecialSub.Size = UDim2.new(1, -12, 0, 20)
			row.CardHit.Visible = false
			y = y + K.ROW_H + K.ROW_GAP
		end
		return w, y - K.ROW_GAP + K.PAD
	end
	-- compact cards in a row (or a grid at the left edge of a landscape phone)
	cols = min(n, cols or n)
	local avail = maxW or (m.W - 16)
	if m.Landscape and not maxW then
		avail = avail - (2 * K.TOUCH_W + 30)
	end
	local cw = min(K.CARD_W, floor((avail - (cols - 1) * 8) / cols))
	for i = 1, n do
		local row = Hud.rows[i]
		local f = row.Frame
		local col, line = (i - 1) % cols, floor((i - 1) / cols)
		f.Size = UDim2.fromOffset(cw, K.CARD_H)
		f.Position = UDim2.fromOffset(col * (cw + 8), line * (K.CARD_H + 8))
		row.Chip.Visible = true
		row.Chip.Size = UDim2.fromOffset(26, 26)
		row.Chip.Position = UDim2.fromOffset(4, 4)
		row.ChipText.TextSize = 18
		row.ChipText:SetAttribute("BaseText", 18)
		row.Name.Position = UDim2.fromOffset(34, 6)
		row.Name.Size = UDim2.fromOffset(cw - 38, 22)
		row.Name.TextSize = 16
		row.Name:SetAttribute("BaseText", 16)
		row.Level.Visible = false
		row.Element.Visible = false
		row.Hp.Root.Visible = true
		row.Hp.Root.Position = UDim2.fromOffset(5, 32)
		row.Hp.Root.Size = UDim2.fromOffset(cw - 10, 21)
		row.Meter.Root.Position = UDim2.fromOffset(5, 57)
		row.Meter.Root.Size = UDim2.fromOffset(cw - 10, 8)
		row.Special.Visible = true
		row.Special.Size = UDim2.fromOffset(cw - 10, 28)
		row.Special.Position = UDim2.fromOffset(5, 68)
		row.Glow.Size = UDim2.fromOffset(cw - 2, 36)
		row.Glow.Position = UDim2.fromOffset(1, 64)
		row.SpecialTop.TextSize = 17
		row.SpecialTop:SetAttribute("BaseText", 17)
		row.SpecialTop.Position = UDim2.fromOffset(0, 2)
		row.SpecialTop.Size = UDim2.new(1, 0, 1, -4)
		row.SpecialSub.Visible = false
		row.CardHit.Visible = true
	end
	local lines = math.ceil(n / cols)
	return cols * cw + (cols - 1) * 8, lines * K.CARD_H + (lines - 1) * 8
end

-- the enemy chips of the top card (trials and duels)
local function chipFor(i)
	local chip = Hud.chips[i]
	if chip then
		return chip
	end
	chip = {}
	local f = make("TextButton", { Name = "Enemy" .. i, Text = "", AutoButtonColor = false, BackgroundColor3 = COLORS.Panel, BackgroundTransparency = 0.05, BorderSizePixel = 0 }, Hud.top)
	Theme.Corner(f, UDim.new(0, 10))
	chip.Stroke = Theme.Stroke(f, COLORS.Navy, 2, 0)
	chip.Stripe = make("Frame", { Name = "Element", BorderSizePixel = 0, Size = UDim2.new(1, -12, 0, 4), Position = UDim2.fromOffset(6, 3) }, f)
	Theme.Corner(chip.Stripe, UDim.new(0, 2))
	chip.Name = label(f, "", "Label", 15, { Name = "PetName", Position = UDim2.fromOffset(6, 8), Size = UDim2.new(1, -12, 0, 20), TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
	chip.Hp = thinBar(f, "Hp", 12, COLORS.Enemy, { Position = UDim2.fromOffset(6, 32), Size = UDim2.new(1, -12, 0, 12) })
	chip.Frame = f
	local index = i
	f.Activated:Connect(function()
		local id = chip.unitId
		if id then
			BattleController.Focus(id)
		end
		return index
	end)
	Hud.chips[i] = chip
	return chip
end

-- lists the units the HUD shows: my team by slot, enemies (non-boss) in id order
function Hud.Lists(B)
	local mine = {}
	for slot = 1, 4 do
		if B.mine[slot] then
			mine[#mine + 1] = B.mine[slot]
		end
	end
	local enemies = {}
	for _, u in ipairs(B.list) do
		if not u.ally and not u.isBoss and u.kind ~= "Minion" then
			enemies[#enemies + 1] = u
		end
	end
	return mine, enemies
end

-- (re)builds the HUD for the drawn battle and lays it out for the screen
function Hud.Rebuild()
	local B = St.battle
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	Hud.m = m
	Hud.scale.Scale = m.F
	Hud.root.Size = UDim2.new(1 / m.F, 0, 1 / m.F, 0)
	if not B then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.teamPlace = nil
		Hud.SetMenuHidden(false)
		return
	end
	local isFighting = B.Fighter and not B.ended
	-- between two ring rounds the top card and the team stay (no flicker); only the commands go
	local between = B.Fighter and B.ended and B.ringNext ~= nil
	Hud.teamPlace = nil
	local mine, enemies = Hud.Lists(B)
	Hud.mineList = mine
	Hud.enemyList = enemies
	-- top card ------------------------------------------------------------------------------
	local top = Hud.top
	local topW = m.Compact and min(K.TOP_W_COMPACT, m.W - 16) or K.TOP_W
	top.Visible = not B.ended or not B.Fighter or between
	top.Position = UDim2.new(0.5, 0, 0, 6)
	if not Hud.topBuilt then
		Hud.topBuilt = true
		Hud.mode = smallPill(top, "", COLORS.Ally, { Name = "Mode", Position = UDim2.fromOffset(K.PAD, 10) })
		Hud.title = label(top, "", "Heading", 22, { Name = "Title", TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
		Hud.timer = label(top, "", "Display", 26, { Name = "Timer", TextXAlignment = Enum.TextXAlignment.Right })
		Hud.bossBar = bar(top, "BossHp", 28, COLORS.Enemy, { TextSize = 18 })
		Hud.pills = make("Frame", { Name = "Pills", BackgroundTransparency = 1 }, top)
		make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, Hud.pills)
		Hud.bossElement = smallPill(Hud.pills, "", COLORS.Enemy, { Name = "Element", LayoutOrder = 1 })
		Hud.enragePill = smallPill(Hud.pills, "ENRAGED", COLORS.Enemy, { Name = "Enraged", LayoutOrder = 2, Visible = false })
		Hud.minionPill = smallPill(Hud.pills, "", Color3.fromRGB(150, 110, 220), { Name = "Minions", LayoutOrder = 3, Visible = false })
		Hud.playersPill = smallPill(Hud.pills, "", COLORS.Ally, { Name = "Players", LayoutOrder = 4, Visible = false })
		Hud.sideBars = {
			bar(top, "Side1", 22, COLORS.Ally, { TextSize = 15 }),
			bar(top, "Side2", 22, COLORS.Enemy, { TextSize = 15 }),
		}
		Ring.BuildInfo(top)
	end
	local y = K.PAD
	local pillSize = max(15, math.ceil(K.MIN_TEXT_PX / max(0.05, m.F)))
	local modeW = 30 + textWidth(Hud.ModeText(B), pillSize) * 1.2
	Hud.title.Position = UDim2.fromOffset(K.PAD + modeW + 10, y)
	Hud.title.Size = UDim2.fromOffset(topW - 2 * K.PAD - modeW - 10 - 84, 26)
	Hud.timer.Position = UDim2.new(1, -K.PAD - 80, 0, y - 2)
	Hud.timer.Size = UDim2.fromOffset(80, 30)
	y = y + 34
	local raid = B.Mode == "Raid" and B.boss ~= nil
	Hud.bossBar.Root.Visible = raid
	Hud.pills.Visible = raid
	Hud.sideBars[1].Root.Visible = false
	Hud.sideBars[2].Root.Visible = false
	for _, chip in ipairs(Hud.chips) do
		chip.Frame.Visible = false
	end
	if raid then
		Hud.bossBar.Root.Position = UDim2.fromOffset(K.PAD, y)
		Hud.bossBar.Root.Size = UDim2.fromOffset(topW - 2 * K.PAD, 28)
		Hud.bossBar.SetColor(elementColor(B.boss.element))
		y = y + 34
		Hud.pills.Position = UDim2.fromOffset(K.PAD, y)
		Hud.pills.Size = UDim2.fromOffset(topW - 2 * K.PAD, 24)
		setText(Hud.bossElement, tostring(B.boss.element or "?"))
		Hud.bossElement.BackgroundColor3 = elementColor(B.boss.element)
		y = y + 28
	elseif not isFighting and not between then
		-- spectator of a duel / trial: one HP bar per side
		for s = 1, 2 do
			local sb = Hud.sideBars[s]
			sb.Root.Visible = true
			sb.Root.Position = UDim2.fromOffset(K.PAD + (s - 1) * ((topW - 2 * K.PAD) / 2 + 4), y)
			sb.Root.Size = UDim2.fromOffset((topW - 2 * K.PAD) / 2 - 4, 22)
		end
		y = y + 28
	else
		local n = min(#enemies, 6)
		local gap = 6
		local cw = min(150, floor((topW - 2 * K.PAD - (n - 1) * gap) / max(1, n)))
		local x0 = floor((topW - (n * cw + (n - 1) * gap)) / 2)
		for i = 1, n do
			local chip = chipFor(i)
			local u = enemies[i]
			chip.unitId = u.id
			chip.Frame.Visible = true
			chip.Frame.Size = UDim2.fromOffset(cw, 50)
			chip.Frame.Position = UDim2.fromOffset(x0 + (i - 1) * (cw + gap), y)
			chip.Stripe.BackgroundColor3 = elementColor(u.element)
			setText(chip.Name, u.name)
			chip.boss = u.kind == "MiniBoss"
		end
		y = y + (n > 0 and 56 or 0)
	end
	y = Ring.LayoutInfo(B, topW, y)
	top.Size = UDim2.fromOffset(topW, y + K.PAD - 4)
	Hud.topH = y + K.PAD - 4
	-- team + commands ---------------------------------------------------------------------------
	Hud.team.Visible = isFighting or between
	Hud.cmd.Visible = isFighting
	if isFighting or between then
		for i, u in ipairs(mine) do
			local row = rowFor(i)
			row.slot = u.slot
			row.unitId = u.id
			row.Chip.BackgroundColor3 = elementColor(u.element)
			setText(row.ChipText, Hud.KeyText("Special", u.slot))
			if m.Compact then
				setText(row.Name, u.name)
			else
				-- the level first (muted), so a long name is what gets cut
				setText(row.Name, '<font color="#C9D6F2">Lv ' .. tostring(floor(u.level)) .. "</font> " .. u.name)
			end
			setText(row.Level, "Lv " .. tostring(floor(u.level)))
			setText(row.Element, tostring(u.element or "?"))
			row.Element.BackgroundColor3 = elementColor(u.element)
			local special = u.special
			row.kind = special and special.Kind or nil
			row.subText = special and tostring(special.Name or special.Kind) or "No special"
			setText(row.SpecialSub, row.subText)
			row.stateKey = nil
			row.last = nil
		end
		-- where the compact cards go: a row under the top card, unless that row would reach the middle of the screen
		-- (a landscape phone): then a 2-column grid at the top-left edge, where the menu column steps aside
		local place = m.Compact and "Top" or "Right"
		local gridW = nil
		if m.Compact and m.Landscape then
			local rowBottom = m.Inset + (6 + Hud.topH + 8 + K.CARD_H) * m.F
			if rowBottom > m.VY * K.ROW_MAX_Y then
				place = "Left"
				gridW = floor((m.W - topW) / 2) - K.SIDE_X - 10
			end
		end
		Hud.teamPlace = place
		local tw, th = Hud.LayoutTeam(m, mine, place == "Left" and 2 or nil, gridW)
		if not m.Compact then
			-- the team card: a panel behind the rows, bottom right
			if not Hud.teamBack then
				Hud.teamBack = card(Hud.team, "Back", { ZIndex = 0 })
				Hud.teamTitle = label(Hud.team, "YOUR TEAM", "Heading", 20, { Name = "Header", Position = UDim2.fromOffset(K.PAD + 4, K.PAD), Size = UDim2.fromOffset(160, 26), TextXAlignment = Enum.TextXAlignment.Left })
				Hud.focusPill = make("TextButton", { Name = "Focus", Text = "", AutoButtonColor = false, BackgroundColor3 = COLORS.Enemy, BorderSizePixel = 0, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26), AnchorPoint = Vector2.new(1, 0) }, Hud.team)
				Theme.Corner(Hud.focusPill, UDim.new(0, 13))
				Theme.Stroke(Hud.focusPill, COLORS.Navy, 2, 0)
				make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, Hud.focusPill)
				Hud.focusText = label(Hud.focusPill, "", "Heading", 15, { Name = "Text", AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 26) })
				Hud.focusPill.Activated:Connect(function()
					BattleController.Focus(nil)
				end)
			end
			Hud.teamBack.Visible = true
			Hud.teamTitle.Visible = true
			Hud.teamBack.Size = UDim2.fromScale(1, 1)
			Hud.team.AnchorPoint = Vector2.new(1, 1)
			Hud.team.Size = UDim2.fromOffset(tw, th)
			Hud.team.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE)
			Hud.focusPill.Position = UDim2.new(1, -K.PAD - 2, 0, K.PAD)
			-- commands above the team card
			Hud.cmd.AnchorPoint = Vector2.new(1, 1)
			Hud.cmd.Size = UDim2.fromOffset(tw, K.CMD_H)
			Hud.cmd.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE - th - 14)
			local bw = floor((tw - 12) / 2)
			Hud.attack.Size = UDim2.fromOffset(bw, K.CMD_H)
			Hud.attack.Position = UDim2.fromOffset(0, 0)
			Hud.retreat.Size = UDim2.fromOffset(bw, K.CMD_H)
			Hud.retreat.Position = UDim2.fromOffset(bw + 12, 0)
			Hud.attack.TextSize = 24
			Hud.retreat.TextSize = 24
			Hud.attack:SetAttribute("BaseText", 24)
			Hud.retreat:SetAttribute("BaseText", 24)
		else
			if Hud.teamBack then
				Hud.teamBack.Visible = false
				Hud.teamTitle.Visible = false
				Hud.focusPill.Visible = false
			end
			Hud.team.AnchorPoint = Vector2.new(0.5, 0)
			Hud.team.Size = UDim2.fromOffset(tw, th)
			local teamY = 6 + Hud.topH + 8
			local bw, bh = K.TOUCH_W, K.TOUCH_H
			local cx = m.W / 2
			if m.Landscape and cx + tw / 2 > m.W - (2 * bw + 30) then
				cx = (m.W - (2 * bw + 30)) / 2
			end
			if place == "Left" then
				Hud.team.AnchorPoint = Vector2.new(0, 0)
				Hud.team.Position = UDim2.fromOffset(K.SIDE_X, 6)
			else
				Hud.team.Position = UDim2.fromOffset(cx, teamY)
			end
			-- big touch buttons at the right edge, between the currency pill (top right) and RUN / DASH (bottom right)
			Hud.cmd.AnchorPoint = Vector2.new(1, 0)
			if m.Landscape then
				Hud.cmd.Size = UDim2.fromOffset(2 * bw + 10, bh)
				Hud.cmd.Position = UDim2.fromOffset(m.W - 8, floor(m.H * 0.3))
				Hud.attack.Position = UDim2.fromOffset(0, 0)
				Hud.retreat.Position = UDim2.fromOffset(bw + 10, 0)
			else
				Hud.cmd.Size = UDim2.fromOffset(bw, 2 * bh + 12)
				Hud.cmd.Position = UDim2.fromOffset(m.W - 8, floor(m.H * 0.47))
				Hud.attack.Position = UDim2.fromOffset(0, 0)
				Hud.retreat.Position = UDim2.fromOffset(0, bh + 12)
			end
			Hud.attack.Size = UDim2.fromOffset(bw, bh)
			Hud.retreat.Size = UDim2.fromOffset(bw, bh)
			Hud.attack.TextSize = 20
			Hud.retreat.TextSize = 20
			Hud.attack:SetAttribute("BaseText", 20)
			Hud.retreat:SetAttribute("BaseText", 20)
		end
		Hud.attackKey.Visible = not m.Touch
		Hud.retreatKey.Visible = not m.Touch
		Hud.Keys()
	end
	Hud.cmd.Visible = isFighting
	Hud.SetMenuHidden((isFighting or between) and Hud.teamPlace == "Left")
	Leave.Place(m, B, isFighting)
	Ring.PlaceNext(B)
	Hud.TrimButton(Hud.attack, m.Compact)
	Hud.TrimButton(Hud.retreat, m.Compact)
	Hud.FixText(Hud.root, m.F)
	Hud.last = {}
	Hud.Update(B, os.clock(), true)
end

-- compact buttons: less side padding (CloudUI pads 10 px), so ATTACK / RETREAT fit at a readable size
function Hud.TrimButton(b, compact)
	local pad = b and b:FindFirstChildOfClass("UIPadding")
	if pad then
		pad.PaddingLeft = UDim.new(0, compact and 3 or 10)
		pad.PaddingRight = UDim.new(0, compact and 3 or 10)
	end
end

function Hud.Keys()
	if not Hud.attackKey then
		return
	end
	local a = Hud.attackKey:FindFirstChild("Text")
	if a then
		setText(a, Hud.KeyText("Attack"))
	end
	local r = Hud.retreatKey:FindFirstChild("Text")
	if r then
		setText(r, Hud.KeyText("Retreat"))
	end
	-- the slot chip of a team row is the key of its SPECIAL (1-4, or LB / RB / LT / RT on a gamepad)
	for _, row in ipairs(Hud.rows) do
		if row.ChipText and row.slot then
			setText(row.ChipText, Hud.KeyText("Special", row.slot))
		end
	end
end

-- per-frame HUD values (writes only on change)
function Hud.Update(B, now, force)
	if not Hud.gui or not B then
		return
	end
	local last = Hud.last or {}
	Hud.last = last
	-- top card
	local modeText, modeColor = Hud.ModeText(B)
	if last.mode ~= modeText then
		last.mode = modeText
		Hud.mode.Text = modeText
		Hud.mode.BackgroundColor3 = modeColor
	end
	local title = Hud.TitleText(B)
	if last.title ~= title then
		last.title = title
		Hud.title.Text = title
	end
	local left = B.TimeLimit > 0 and (B.TimeLimit - B.renderT) or 0
	local timerText = B.TimeLimit > 0 and fmtTime(left) or ""
	if last.timer ~= timerText then
		last.timer = timerText
		Hud.timer.Text = timerText
		Hud.timer.TextColor3 = (left < 15 and B.TimeLimit > 0) and COLORS.Enemy:Lerp(COLORS.White, 0.25) or COLORS.White
	end
	if B.Mode == "Raid" and B.boss then
		local boss = B.boss
		local frac = clamp(boss.hp / boss.maxHp, 0, 1)
		if force or last.bossHp ~= boss.hp or last.bossMax ~= boss.maxHp then
			last.bossHp, last.bossMax = boss.hp, boss.maxHp
			Hud.bossBar.SetFraction(frac, false)
			Hud.bossBar.SetText(Theme.ShortNumber(clamp(boss.hp, 0, boss.maxHp)) .. " / " .. Theme.ShortNumber(boss.maxHp))
		end
		if last.enraged ~= B.enraged then
			last.enraged = B.enraged
			Hud.enragePill.Visible = B.enraged
		end
		local minions, players = 0, {}
		for _, u in ipairs(B.list) do
			if u.kind == "Minion" and u.hp > 0 and u.state ~= S_DOWN then
				minions = minions + 1
			elseif u.kind == "Pet" and u.side == 1 and u.owner ~= nil then
				players[u.owner] = true
			end
		end
		local pc = 0
		for _ in pairs(players) do
			pc = pc + 1
		end
		if last.minions ~= minions then
			last.minions = minions
			Hud.minionPill.Visible = minions > 0
			Hud.minionPill.Text = "Minions x" .. minions
		end
		if last.players ~= pc then
			last.players = pc
			Hud.playersPill.Visible = pc > 0
			Hud.playersPill.Text = pc == 1 and "1 player" or (pc .. " players")
		end
	elseif B.Spectator or (B.ended and B.Fighter) then
		local hp, maxHp = { 0, 0 }, { 0, 0 }
		for _, u in ipairs(B.list) do
			local s = (u.side == 1) and 1 or 2
			hp[s] = hp[s] + max(0, u.hp)
			maxHp[s] = maxHp[s] + u.maxHp
		end
		for s = 1, 2 do
			local key = "side" .. s
			local value = floor(hp[s])
			if force or last[key] ~= value then
				last[key] = value
				local sb = Hud.sideBars[s]
				sb.SetFraction(maxHp[s] > 0 and hp[s] / maxHp[s] or 0, false)
				sb.SetText(Hud.SideName(B, s))
			end
		end
	else
		for i, u in ipairs(Hud.enemyList or {}) do
			local chip = Hud.chips[i]
			if chip and chip.Frame.Visible then
				local frac = clamp(u.hp / u.maxHp, 0, 1)
				local down = u.hp <= 0 or u.state == S_DOWN
				setThin(chip.Hp, frac)
				local focused = B.focus == u.id
				local key = (down and "d" or "a") .. (focused and "f" or "")
				if force or chip.key ~= key then
					chip.key = key
					chip.Frame.BackgroundColor3 = down and Color3.fromRGB(70, 74, 92) or COLORS.Panel
					chip.Stroke.Color = focused and COLORS.Gold or (chip.boss and COLORS.Gold:Lerp(COLORS.Navy, 0.4) or COLORS.Navy)
					chip.Stroke.Thickness = focused and 3 or 2
					chip.Name.TextColor3 = down and COLORS.Weak or COLORS.White
					if down then
						chip.Name.Text = "KO"
					else
						chip.Name.Text = u.name
					end
				end
			end
		end
	end
	if not B.Fighter or B.ended then
		return
	end
	-- team rows
	local pulse = 0.5 + 0.5 * sin(now * 6)
	for i, u in ipairs(Hud.mineList or {}) do
		local row = Hud.rows[i]
		if row then
			local down = u.hp <= 0 or u.state == S_DOWN
			local frac = clamp(u.hp / u.maxHp, 0, 1)
			local hpKey = floor(u.hp)
			if force or row.hp ~= hpKey then
				row.hp = hpKey
				row.Hp.SetFraction(frac, false)
				row.Hp.SetText(down and "KO" or (Theme.ShortNumber(clamp(u.hp, 0, u.maxHp)) .. " / " .. Theme.ShortNumber(u.maxHp)))
				row.Hp.SetColor(Theme.HealthColor(frac))
			end
			setThin(row.Meter, u.meter / METER_MAX)
			local full = not down and row.kind ~= nil and u.meter >= METER_MAX and u.state ~= S_STUNNED
			local ready = full and B.order ~= "Retreat"
			-- a full meter while the team rests: the card says why it waits (specials need ATTACK first)
			local waiting = full and B.order == "Retreat"
			local stateKey = down and "down" or (ready and "ready" or (waiting and "wait" or (row.kind and "charge" or "none")))
			if force or row.stateKey ~= stateKey then
				row.stateKey = stateKey
				local sb = row.Special
				if stateKey == "ready" then
					sb.BackgroundColor3 = COLORS.Gold
					row.SpecialTop.TextColor3 = COLORS.White
				elseif stateKey == "wait" then
					sb.BackgroundColor3 = COLORS.Wait
				elseif stateKey == "down" then
					sb.BackgroundColor3 = Color3.fromRGB(80, 84, 104)
				else
					sb.BackgroundColor3 = Color3.fromRGB(96, 106, 140)
				end
				row.Frame.BackgroundTransparency = down and 0.45 or 0.15
				row.Meter.Fill.BackgroundColor3 = (ready or waiting) and COLORS.Gold or Color3.fromRGB(226, 186, 92)
				setText(row.SpecialSub, waiting and "ATTACK first" or (row.subText or ""))
			end
			local top
			if stateKey == "ready" then
				top = "SPECIAL!"
			elseif stateKey == "wait" then
				top = (Hud.m and Hud.m.Compact) and K.WAIT_COMPACT or "RESTING"
			elseif stateKey == "down" then
				top = "KO"
			elseif stateKey == "none" then
				top = "-"
			else
				top = tostring(floor(clamp(u.meter / METER_MAX, 0, 1) * 100)) .. "%"
			end
			setText(row.SpecialTop, top)
			if stateKey == "ready" then
				row.Glow.BackgroundTransparency = 0.35 + 0.45 * pulse
				row.SpecialStroke.Color = COLORS.White
			elseif row.Glow.BackgroundTransparency ~= 1 then
				row.Glow.BackgroundTransparency = 1
				row.SpecialStroke.Color = COLORS.Navy
			end
		end
	end
	-- commands: the regroup countdown on ATTACK, then ATTACK! pulses while the team rests (RETREAT counts down to
	-- the server's auto resume); RETREAT! pulses while a telegraph that has not hit yet covers one of my pets
	local compact = Hud.m and Hud.m.Compact
	local retreating = B.order == "Retreat"
	local since = retreating and (now - B.retreatAt) or 0
	local lockLeft = retreating and (RETREAT_LOCK - since) or 0
	local attackText, retreatText = "ATTACK", "RETREAT"
	local callAttack, callRetreat = false, false
	if retreating and lockLeft > 0.05 then
		attackText = compact and string.format("%.1f", lockLeft) or string.format("ATTACK %.1f", lockLeft)
		retreatText = compact and "RETREAT" or "RETREATING"
	elseif retreating then
		attackText = "ATTACK!"
		callAttack = true
		local resumeLeft = RETREAT_LOCK + AUTO_RESUME - since
		retreatText = resumeLeft > 0.05 and ("RESTING " .. tostring(math.ceil(resumeLeft - 0.05))) or "RESTING"
	elseif B.threat then
		retreatText = "RETREAT!"
		callRetreat = true
	end
	setText(Hud.attack, attackText)
	setDisabled(Hud.attack, lockLeft > 0.05)
	setText(Hud.retreat, retreatText)
	B.cue = callAttack and "Attack" or (callRetreat and "Retreat" or nil)
	local blink = 0.6 * (0.5 + 0.5 * sin(now * 9))
	Hud.SetRing(Hud.attack:FindFirstChild("ActiveRing"), callAttack or (B.order == "Attack" and B.focus ~= nil), callAttack and blink or 0)
	Hud.SetRing(Hud.retreat:FindFirstChild("ActiveRing"), retreating or callRetreat, callRetreat and blink or 0)
	if Hud.focusPill and not (Hud.m and Hud.m.Compact) then
		local f = B.focus and B.units[B.focus]
		local text = f and ("TARGET: " .. f.name .. "  X") or ""
		if last.focus ~= text then
			last.focus = text
			Hud.focusPill.Visible = f ~= nil
			Hud.focusText.Text = text
		end
	end
end

-- shows / hides an ActiveRing; a calling ring pulses (stroke transparency)
function Hud.SetRing(ring, on, transparency)
	if not ring then
		return
	end
	if ring.Visible ~= on then
		ring.Visible = on
	end
	local stroke = ring:FindFirstChildOfClass("UIStroke")
	if stroke and abs(stroke.Transparency - transparency) > 0.02 then
		stroke.Transparency = transparency
	end
end

function Hud.ModeText(B)
	local text, color
	if B.Mode == "Raid" then
		text, color = "BOSS RAID", COLORS.Enemy
	elseif B.Mode == "Trial" then
		text, color = "TRIAL " .. tostring(B.Trial and B.Trial.Level or B.Level or ""), Color3.fromRGB(150, 110, 220)
	elseif B.Mode == "Ring" then
		-- a compact top card keeps the room for "Round 8 - Best 12"
		text, color = (Hud.m and Hud.m.Compact) and "RING" or "CHAMPION RING", Ring.GOLD
	else
		text, color = "DUEL", COLORS.Ally
	end
	if B.Spectator then
		text = "WATCHING"
	end
	return text, color
end

function Hud.SideName(B, side)
	local names = {}
	for _, owner in ipairs((B.sides and B.sides[side]) or {}) do
		local n = B.Names[tostring(owner)]
		if n then
			names[#names + 1] = n
		end
	end
	if #names > 0 then
		return table.concat(names, ", ")
	end
	if B.Mode == "Trial" and side == 2 then
		return (B.Trial and B.Trial.Name) or "Trial team"
	end
	if B.Mode == "Ring" and side == 2 then
		return "The Champion"
	end
	return side == 1 and "Blue side" or "Red side"
end

function Hud.TitleText(B)
	if B.Mode == "Raid" then
		return (B.boss and B.boss.name) or "Boss Raid"
	elseif B.Mode == "Trial" then
		local t = B.Trial
		if t and t.Name then
			return tostring(t.Name)
		end
		return "Trial " .. tostring(B.Level or "")
	elseif B.Mode == "Ring" then
		return Ring.TitleText(B)
	end
	if B.Spectator then
		return Hud.SideName(B, 1) .. " vs " .. Hud.SideName(B, 2)
	end
	return "vs " .. Hud.SideName(B, B.Side == 1 and 2 or 1)
end

-- the result card at the end (bottom right; compact: top centre on a tall phone, top right on a landscape phone)
function Hud.ShowResult(B, payload)
	if not Hud.Ensure() then
		return
	end
	local m = Hud.Metrics()
	local res = Hud.result
	for _, c in ipairs(res:GetChildren()) do
		if not c:IsA("UICorner") and not c:IsA("UIStroke") and not c:IsA("UIGradient") then
			c:Destroy()
		end
	end
	local outcome = payload.Outcome
	if outcome == nil then
		outcome = payload.Won and "Win" or "Loss"
	end
	local raid = B.Mode == "Raid"
	local titleText, color = "DEFEAT", COLORS.Enemy
	if outcome == "Win" then
		titleText, color = raid and "BOSS DEFEATED!" or "VICTORY!", COLORS.Gold
	elseif outcome == "Draw" then
		titleText, color = "DRAW", COLORS.Ally
	elseif outcome == "Left" then
		titleText, color = "YOU LEFT", COLORS.Weak
	elseif raid then
		titleText = "THE BOSS WON"
	end
	local reasons = {
		BossDown = "The boss is down!",
		Wipe = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		KO = (outcome == "Win") and "Every enemy is knocked out." or "Your team was knocked out.",
		Timeout = "Time is up.",
		Forfeit = (outcome == "Win") and "Your opponent gave up." or "You gave up.",
		Left = "You left the battle.",
		Abandoned = "Everyone left the raid.",
		Ended = "The raid has ended.",
		Error = "The battle was cancelled. No rewards were lost.",
		Void = "Both players left: this duel does not count.",
		Shutdown = raid and "The server is restarting: your damage so far still counts." or "The server is restarting: this battle does not count.",
	}
	local sub = reasons[tostring(payload.Reason)] or ""
	if B.Mode == "Trial" then
		sub = "Trial " .. tostring(B.Trial and B.Trial.Level or B.Level or "") .. (sub ~= "" and (" - " .. sub) or "")
	elseif B.Mode == "Ring" then
		titleText, color, sub = Ring.ResultTitle(B, payload, sub)
	end
	local w = m.Compact and min(K.RESULT_W, m.W - 16) or K.RESULT_W
	if m.Compact and m.Landscape then
		w = max(300, min(w, floor(m.W / 2) - 16)) -- top right, clear of the screen centre
	end
	local y = K.PAD + 2
	-- a landscape phone: OK next to the title and a slim timer at the bottom (the card stays above the jump / dash
	-- buttons); an opaque card, since it sits over the currency pill in the top right
	local short = m.Compact and m.Landscape
	res.BackgroundTransparency = short and 0 or res.BackgroundTransparency
	local titleW = w - 2 * K.PAD - 8 - (short and 112 or 0)
	local title = label(res, titleText, "Title", short and 32 or 36, { Name = "Title", Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(titleW, 42), TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = color })
	title.TextStrokeColor3 = COLORS.Ink
	y = y + 44
	if sub ~= "" then
		label(res, sub, "Body", 18, { Name = "Reason", Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(w - 2 * K.PAD - 8, 24), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextColor3 = COLORS.Muted })
		y = y + 28
	end
	local list = make("Frame", { Name = "Rewards", BackgroundTransparency = 1, Position = UDim2.fromOffset(K.PAD, y), Size = UDim2.fromOffset(w - 2 * K.PAD, 10), AutomaticSize = Enum.AutomaticSize.Y }, res)
	make("UIGridLayout", { CellSize = UDim2.fromOffset(floor((w - 2 * K.PAD - 8) / 2), 30), CellPadding = UDim2.fromOffset(8, 6), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local lines = (B.Mode == "Ring") and Ring.ResultLines(B, rw) or Hud.RewardLines(B, rw)
	for i, line in ipairs(lines) do
		local p = smallPill(list, line[1], line[2], { LayoutOrder = i, AutomaticSize = Enum.AutomaticSize.None, Size = UDim2.fromScale(1, 1) })
		p.TextSize = 17
	end
	local rowsN = math.ceil(#lines / 2)
	y = y + rowsN * 36 + (rowsN > 0 and 4 or 0)
	if short then
		local ok = button(res, "OkButton", "OK", "Green", UDim2.fromOffset(100, 44), function()
			Hud.HideResult()
		end)
		ok.Position = UDim2.new(1, -K.PAD - 100, 0, K.PAD)
		Hud.resultTimer = thinBar(res, "Timer", 6, COLORS.Muted, { Position = UDim2.fromOffset(K.PAD + 4, y), Size = UDim2.fromOffset(w - 2 * K.PAD - 8, 6) })
		y = y + 6 + K.PAD
	else
		local ok = button(res, "OkButton", "OK", "Green", UDim2.fromOffset(120, 46), function()
			Hud.HideResult()
		end)
		ok.Position = UDim2.new(1, -K.PAD - 120, 0, y)
		Hud.resultTimer = thinBar(res, "Timer", 8, COLORS.Muted, { Position = UDim2.fromOffset(K.PAD + 4, y + 19), Size = UDim2.fromOffset(w - 2 * K.PAD - 140, 8) })
		y = y + 46 + K.PAD
	end
	res.Size = UDim2.fromOffset(w, y)
	if m.Compact and m.Landscape then
		-- a landscape phone is short: a top-centre card would cover the screen centre, so it sits top right
		res.AnchorPoint = Vector2.new(1, 0)
		res.Position = UDim2.new(1, -8, 0, 6)
	elseif m.Compact then
		res.AnchorPoint = Vector2.new(0.5, 0)
		res.Position = UDim2.new(0.5, 0, 0, 6)
	else
		res.AnchorPoint = Vector2.new(1, 1)
		res.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE)
	end
	res.Visible = true
	Hud.FixText(res, m.F)
	Ring.HideNext()
	Hud.top.Visible = false
	Hud.team.Visible = false
	Hud.cmd.Visible = false
	Hud.teamPlace = nil
	Hud.SetMenuHidden(false)
	local keep = St.result and St.result.payload == payload and St.result.t0 -- a relayout (rotation) keeps the timer
	St.result = { t0 = keep or os.clock(), dur = K.RESULT_SECONDS, battle = B, payload = payload }
	BattleController._wake()
end

function Hud.RewardLines(B, rw)
	local lines = {}
	local tokens = num(rw.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	local gems = num(rw.Gems, 0)
	if gems > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(gems) .. " Gems", Theme.Currency.Gems.Color }
	end
	if rw.Practice == true then
		lines[#lines + 1] = { "Practice duel: no rewards", COLORS.Weak }
	end
	local trophies = num(rw.Trophies, 0)
	if trophies ~= 0 or (B.Mode == "Duel" and rw.Practice ~= true and rw.Void ~= true) then
		lines[#lines + 1] = { (trophies >= 0 and "+" or "") .. tostring(trophies) .. " Trophies", trophies >= 0 and COLORS.Gold or COLORS.Enemy }
	end
	local xp = num(rw.Xp, 0)
	if xp > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(xp) .. " Pet XP", COLORS.Ally }
	end
	if rw.FirstClear == true then
		lines[#lines + 1] = { "First clear!", COLORS.Mine }
	end
	if rw.Tier == "None" then
		lines[#lines + 1] = { "No hits on the boss: no reward", COLORS.Weak }
	elseif rw.Tier then
		local share = num(rw.Share, 0)
		lines[#lines + 1] = { tostring(rw.Tier) .. " tier", COLORS.Gold }
		lines[#lines + 1] = { tostring(floor(share * 100 + 0.5)) .. "% of the damage", Color3.fromRGB(150, 110, 220) }
	end
	if rw.EventPet then
		local name = tostring(rw.EventPet)
		if PetCatalog and PetCatalog.Get then
			local ok, d = pcall(PetCatalog.Get, rw.EventPet)
			if ok and type(d) == "table" and d.Name then
				name = d.Name
			end
		end
		lines[#lines + 1] = { "New pet: " .. name, Color3.fromRGB(236, 110, 170) }
	end
	local ups = num(rw.LevelUps, 0)
	if ups > 0 then
		lines[#lines + 1] = { ups == 1 and "1 level up!" or (ups .. " level ups!"), COLORS.Mine }
	end
	if rw.Double == true then
		lines[#lines + 1] = { "Double rewards", COLORS.Gold }
	end
	return lines
end

function Hud.HideResult()
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	if not St.battle then
		Hud.SetVisible(false)
	end
end

function Hud.UpdateResult(now)
	local r = St.result
	if not r then
		return
	end
	local p = (now - r.t0) / r.dur
	if p >= 1 then
		Hud.HideResult()
		return
	end
	if Hud.resultTimer then
		setThin(Hud.resultTimer, 1 - p)
	end
end

function Hud.SetVisible(on)
	if not Hud.gui then
		return
	end
	if not on then
		Hud.top.Visible = false
		Hud.team.Visible = false
		Hud.cmd.Visible = false
		Hud.teamPlace = nil
		Hud.SetMenuHidden(false)
	end
end

-- the menu column (MenuController) steps aside while the team cards use the left edge of a landscape phone
function Hud.SetMenuHidden(on)
	on = on == true
	if (Hud.menuHidden == true) == on then
		return
	end
	local module = script.Parent:FindFirstChild("MenuController")
	local ok, menu = pcall(function()
		return module and require(module)
	end)
	if ok and type(menu) == "table" and type(menu.SetColumnHidden) == "function" and pcall(menu.SetColumnHidden, on) then
		Hud.menuHidden = on
	elseif not on then
		Hud.menuHidden = false
	end
end

----------------------------------------------------------------------
-- Phase 4: unit cards (src/client/UI/PetCard.lua; ARCHITECTURE_V3.md "Phase 4 build contract" 3.9)
----------------------------------------------------------------------
-- the card above every pet unit: own pets "Unit" (level + HP + SPECIAL + XP), a teammate's "Ally" (level + HP),
-- enemies / NPCs "Enemy" (level + HP in red). The billboard keeps the Phase 3 name HpBar (its HP fill is
-- Plate.Hp.Fill). Fills are written only when the snapshot changed a value (Cards.Live), never per frame.
function Cards.ModeOf(u)
	if u.mine then
		return "Unit"
	elseif u.ally then
		return "Ally"
	end
	return "Enemy"
end

function Cards.Add(B, u, root)
	local h = (u.height or 3) / 2 + 0.9
	local ok, c = false, nil
	if Mods.PetCard and type(Mods.PetCard.New) == "function" then
		ok, c = pcall(Mods.PetCard.New, root, Cards.ModeOf(u), h, { Parent = u.model, Name = "HpBar" })
	end
	if not ok or type(c) ~= "table" then
		if Mods.PetCard then
			warnOnce("card", "PetCard.New failed: " .. tostring(c))
		end
		addBar(u, root, h) -- the Phase 3 bar (a build without PetCard)
		return
	end
	u.card = c
	u.cardWrites = 0
	u.cardHp, u.cardMeter = nil, nil
	Cards.Static(u)
	Cards.Live(u)
	if u.crowned then
		pcall(Ring.Tag, B, u, root, h)
	end
end

function Cards.Free(u)
	if u.card then
		pcall(u.card.Destroy, u.card)
		u.card = nil
	end
end

-- the XP curve (TycoonCatalog.XpToNext; nil past the cap) and the pet's cap (PetCatalog: 100 for every rarity)
function Cards.Need(level)
	local TC = Mods.Tycoon
	if TC and type(TC.XpToNext) == "function" then
		local ok, need = pcall(TC.XpToNext, level)
		need = ok and tonumber(need) or nil
		if need and need > 0 and need < math.huge then
			return need
		end
	end
	return nil
end

function Cards.Cap(u)
	if PetCatalog then
		if type(PetCatalog.LevelCap) == "function" then
			local ok, cap = pcall(PetCatalog.LevelCap, u.info and u.info.petId)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if type(PetCatalog.MaxPetLevel) == "function" then
			local ok, cap = pcall(PetCatalog.MaxPetLevel)
			if ok and tonumber(cap) then
				return tonumber(cap)
			end
		end
		if tonumber(PetCatalog.MaxLevel) then
			return tonumber(PetCatalog.MaxLevel)
		end
	end
	return math.huge
end

-- XP bar: xp / xpNext; the server leaves xpNext out at the cap (a full bar); 0 when the XP is unknown
function Cards.XpFrac(u)
	if u.xp == nil then
		return 0
	end
	local need = u.xpNext
	if need == nil or need ~= need or need >= math.huge then
		return 1
	end
	return clamp(u.xp / max(1, need), 0, 1)
end

-- level, stars and XP (on Start, after the rewards, on a State change)
function Cards.Static(u)
	local c = u.card
	if not c then
		return
	end
	c:SetLevel(u.level, u.evo, false)
	if u.mine then
		c:SetXp(Cards.XpFrac(u))
	end
end

-- HP and SPECIAL from the latest snapshot values (called only when one of them changed)
function Cards.Live(u)
	local c = u.card
	if not c then
		return
	end
	if u.cardHp ~= u.hp then
		u.cardHp = u.hp
		c:SetHp(clamp(u.hp / u.maxHp, 0, 1))
		u.cardWrites = (u.cardWrites or 0) + 1
	end
	if u.cardMeter ~= u.meter then
		u.cardMeter = u.meter
		if u.mine then
			local frac = clamp(u.meter / METER_MAX, 0, 1)
			c:SetSpecial(frac, frac >= 1 and u.special ~= nil)
			u.cardWrites = (u.cardWrites or 0) + 1
		end
	end
end

-- a raid spectator who joins the fight: the card switches its mode with the side
function Cards.Restyle(u)
	if u.card then
		u.card:SetMode(Cards.ModeOf(u))
		u.cardHp, u.cardMeter = nil, nil
		Cards.Static(u)
		Cards.Live(u)
	end
end

-- display only: the fight's XP (End.Rewards.Xp per team pet) moves my cards' XP bars (levels roll over on the curve);
-- the next Start / the profile mirror bring the server's numbers
function Cards.AddXp(u, xp)
	if u.xp == nil or xp <= 0 then
		return
	end
	u.xp = u.xp + xp
	local cap, guard = Cards.Cap(u), 0
	while u.xpNext and u.xpNext < math.huge and u.xp >= u.xpNext and guard < 200 do
		u.xp = u.xp - u.xpNext
		u.level = u.level + 1
		guard = guard + 1
		u.xpNext = (u.level < cap) and Cards.Need(u.level) or nil
	end
	Cards.Static(u)
end

function Cards.AfterFight(B, payload)
	local rw = type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards or nil
	local xp = rw and num(rw.Xp, 0) or 0
	if xp <= 0 or not B.Fighter or payload.Spectator == true then
		return
	end
	for _, u in pairs(B.mine) do
		Cards.AddXp(u, xp)
	end
end

-- the profile mirror (State.PetLevel) only ever moves a card forward (a stale mirror never undoes the rewards)
function Cards.FromState(B)
	local S = Mods.State
	if not B or not B.Fighter or not S or type(S.PetLevel) ~= "function" then
		return
	end
	if type(S.IsLoaded) == "function" and not S.IsLoaded() then
		return
	end
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.xp ~= nil then
			local ok, lv, xp = pcall(S.PetLevel, key)
			lv, xp = ok and tonumber(lv) or nil, ok and tonumber(xp) or nil
			if lv and xp and (lv > u.level or (lv == u.level and xp > u.xp)) then
				u.level, u.xp = lv, xp
				u.xpNext = (lv < Cards.Cap(u)) and Cards.Need(lv) or nil
				Cards.Static(u)
			end
		end
	end
end

----------------------------------------------------------------------
-- Phase 4: the Champion Ring HUD (contract 3.8) and duel overtime
----------------------------------------------------------------------
Ring.GOLD = Color3.fromRGB(250, 190, 56) -- the ring's champion gold (ArenaBuilder's Ring.Color)
Ring.VIOLET = Color3.fromRGB(156, 96, 238)
Ring.INTERMISSION = tonumber(BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring.Intermission) or 3
Ring.LINGER = 15 -- seconds a won round's floor waits for the next Start (BattleService sends it after INTERMISSION)

function Ring.IsFinal(payload)
	return type(payload) == "table" and type(payload.Rewards) == "table" and payload.Rewards.Final == true
end

-- a won round that the next one follows: End.Rewards.Next (never the run's final End)
function Ring.IsNext(B, payload)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or nil
	return B.Mode == "Ring" and rw ~= nil and rw.Next ~= nil and rw.Final ~= true
		and (payload.Won == true or payload.Outcome == "Win" or rw.Won == true)
end

function Ring.Money(n)
	return "$" .. Theme.ShortNumber(num(n, 0))
end

function Ring.TitleText(B)
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	if best > 0 then
		return "Round " .. round .. " - Best " .. best
	end
	return "Round " .. round
end

-- the champion is built wearing PetBuilder's voxel crown accessory (a copy of its definition, cached by look)
function Ring.Crowned(def)
	if type(def) ~= "table" or type(def.Look) ~= "table" then
		return def
	end
	local copy = {}
	for k, v in pairs(def) do
		copy[k] = v
	end
	local look = {}
	for k, v in pairs(def.Look) do
		look[k] = v
	end
	look.Accessory = "Crown"
	copy.Look = look
	return copy
end

-- the champion's name tag: a pixel billboard above its card (same anchor; the tag sits at the top of a taller,
-- transparent frame, so it keeps a fixed pixel gap above the card at any distance)
function Ring.Tag(B, u, root, h)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local name = tostring(champ.Name or u.name or "Champion")
	if not string.find(name, "^Champion") then
		name = "Champion " .. name
	end
	local px = Theme.ScaledSize(22, 16)
	local th = Theme.ScaledSize(32, 24)
	local gap = Theme.ScaledSize(8, 5)
	local cardH = (u.card and u.card.Gui and u.card.Gui.Size.Y.Offset) or th
	local w = floor(min(Theme.ScaledSize(300, 220), textWidth(name, px) + Theme.ScaledSize(30, 22)))
	local gui = make("BillboardGui", {
		Name = "ChampionTag",
		Adornee = root,
		Size = UDim2.fromOffset(w, cardH + 2 * (th + gap)),
		StudsOffset = Vector3.new(0, h, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = K.BAR_DISTANCE,
		ResetOnSpawn = false,
	})
	local plate = make("Frame", { Name = "Plate", BackgroundColor3 = COLORS.Navy, BackgroundTransparency = 0.08, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, th) }, gui)
	Theme.Corner(plate, UDim.new(0, 9))
	Theme.Stroke(plate, Ring.GOLD, 2, 0)
	local l = label(plate, name, "Heading", px, { Name = "Name", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Ring.GOLD })
	l.TextStrokeColor3 = COLORS.Ink
	gui.Parent = u.model
	u.tag = gui
end

-- "Win: +$X +Y XP" (BattleCatalog.RingRewards with the plot's IncomePerSecond, display only: the server pays)
function Ring.Income()
	local index = LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.SpotIndex or "SpotIndex")
	if type(index) ~= "number" then
		return 0
	end
	local folder = Ring.plot
	if not (folder and folder.Parent and folder:GetAttribute("SpotIndex") == index) then
		local lobby = workspace:FindFirstChild("NimbusLobby")
		folder = lobby and lobby:FindFirstChild(string.format("Spot_%02d", index), true) or nil
		Ring.plot = folder
	end
	local value = folder and folder:GetAttribute("IncomePerSecond")
	return type(value) == "number" and value or 0
end

function Ring.Preview(B)
	if B.ringPreview then
		return B.ringPreview
	end
	local round = B.Round > 0 and B.Round or 1
	local best = B.Ring and num(B.Ring.Best, 0) or 0
	local cfg = BattleCatalog and type(BattleCatalog.Ring) == "table" and BattleCatalog.Ring or {}
	local every = num(cfg.BossEvery, 10)
	local champ = B.Ring and type(B.Ring.Champion) == "table" and B.Ring.Champion or {}
	local p = { Round = round, Record = round > best, Boss = champ.Boss == true or (every > 0 and round % every == 0), Cash = 0, Xp = 0, Tokens = 0 }
	if BattleCatalog and type(BattleCatalog.RingRewards) == "function" then
		local ok, r = pcall(BattleCatalog.RingRewards, round, Ring.Income(), p.Record)
		if ok and type(r) == "table" then
			p.Cash, p.Xp, p.Tokens = num(r.Cash, 0), num(r.Xp, 0), num(r.Tokens, 0)
		end
	end
	B.ringPreview = p
	return p
end

-- the info row of the top card: ring (win pay, record, boss round) or duel overtime
function Ring.BuildInfo(top)
	local info = make("Frame", { Name = "RingInfo", BackgroundTransparency = 1, Visible = false }, top)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Center }, info)
	Hud.info = info
	Hud.infoWin = smallPill(info, "", Theme.Currency.Cash.Color, { Name = "WinPay", LayoutOrder = 1 })
	Hud.infoRecord = smallPill(info, "RECORD x3", Ring.GOLD, { Name = "Record", LayoutOrder = 2, Visible = false })
	Hud.infoBoss = smallPill(info, "BOSS", Ring.VIOLET, { Name = "Boss", LayoutOrder = 3, Visible = false })
	Hud.infoOver = smallPill(info, "OVERTIME", COLORS.Enemy, { Name = "Overtime", LayoutOrder = 4, Visible = false })
end

function Ring.LayoutInfo(B, topW, y)
	local info = Hud.info
	if not info then
		return y
	end
	local ring = B.Mode == "Ring" and B.Fighter
	local over = B.overtime == true
	if not ring and not over then
		info.Visible = false
		return y
	end
	info.Visible = true
	Hud.infoWin.Visible = ring
	Hud.infoRecord.Visible = false
	Hud.infoBoss.Visible = false
	if ring then
		local p = Ring.Preview(B)
		-- (a compact top card drops the "Win:" so the pills fit its width)
		local compact = Hud.m and Hud.m.Compact
		setText(Hud.infoWin, (compact and "+" or "Win: +") .. Ring.Money(p.Cash) .. "  +" .. Theme.ShortNumber(p.Xp) .. " XP")
		Hud.infoRecord.Visible = p.Record and B.Round > 1
		Hud.infoBoss.Visible = p.Boss
	end
	Hud.infoOver.Visible = over
	if over then
		setText(Hud.infoOver, "OVERTIME: hits +" .. floor(num(B.overtimeRate, 0.15) * 100 + 0.5) .. "% a second")
	end
	info.Position = UDim2.fromOffset(K.PAD, y)
	info.Size = UDim2.fromOffset(topW - 2 * K.PAD, 26)
	return y + 30
end

-- the side card between two rounds: "Round 8 won!" / "+$319  +68 XP" / "Round 9 in 3" (never the screen centre:
-- where the commands were on a wide screen, under the team cards on a tall phone, at the right edge in landscape)
function Ring.EnsureNext()
	if Hud.next and Hud.next.Parent then
		return Hud.next
	end
	if not Hud.root then
		return nil
	end
	local f = card(Hud.root, "NextRoundCard", { Visible = false })
	Hud.next = f
	Hud.nextTitle = label(f, "", "Title", 28, { Name = "Title", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Ring.GOLD })
	Hud.nextTitle.TextStrokeColor3 = COLORS.Ink
	Hud.nextLine = label(f, "", "Heading", 21, { Name = "Pay", TextXAlignment = Enum.TextXAlignment.Left })
	Hud.nextExtra = label(f, "", "Label", 18, { Name = "Extra", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.Mine })
	Hud.nextCount = label(f, "", "Display", 24, { Name = "Countdown", TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = COLORS.White })
	Hud.nextBar = thinBar(f, "Timer", 8, Ring.GOLD)
	Hud.nextLeave = Leave.Make(f, 20) -- LEAVE between two rounds (BattleService takes "Forfeit" during the intermission)
	return f
end

function Ring.ShowNext(B, payload)
	local rw = payload.Rewards
	local round = num(rw.Round, B.Round)
	B.ringNext = {
		Round = round,
		Next = num(rw.Next, round + 1),
		Cash = num(rw.Cash, 0),
		Xp = num(rw.Xp, 0),
		Tokens = num(rw.Tokens, 0),
		Record = rw.Record == true,
		At = os.clock(),
		Seconds = Ring.INTERMISSION,
	}
	if rw.Record == true and B.Ring then
		B.Ring.Best = max(num(B.Ring.Best, 0), round)
	end
	St.next = B.ringNext
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	pcall(Hud.Rebuild) -- top card + team stay, the commands go, Ring.PlaceNext shows the side card
	BattleController._wake()
end

function Ring.PlaceNext(B)
	local nx = B and B.ringNext
	if not nx then
		if Hud.next then
			Hud.next.Visible = false
		end
		return
	end
	local f = Ring.EnsureNext()
	if not f then
		return
	end
	local m = Hud.m or Hud.Metrics()
	setText(Hud.nextTitle, "Round " .. nx.Round .. " won!")
	setText(Hud.nextLine, "+" .. Ring.Money(nx.Cash) .. "   +" .. Theme.ShortNumber(nx.Xp) .. " XP")
	local extra = {}
	if nx.Record then
		extra[#extra + 1] = "New record! Cash x3"
	end
	if nx.Tokens > 0 then
		extra[#extra + 1] = "+" .. Theme.ShortNumber(nx.Tokens) .. " Tokens"
	end
	Hud.nextExtra.Visible = #extra > 0
	setText(Hud.nextExtra, table.concat(extra, "  "))
	local teamW, teamH = Hud.team.Size.X.Offset, Hud.team.Size.Y.Offset
	local topW = Hud.top.Size.X.Offset
	local w
	if not m.Compact then
		w = max(teamW, 380)
		f.AnchorPoint = Vector2.new(1, 1)
		f.Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE - teamH - 14)
	elseif m.Landscape then
		-- under the currency pill, above the DASH / jump buttons (where the commands were)
		w = max(240, min(340, floor((m.W - topW) / 2) - 16))
		f.AnchorPoint = Vector2.new(1, 0)
		f.Position = UDim2.fromOffset(m.W - 8, max(floor(m.H * 0.2), Ring.CurrencyBottom(m)))
	else
		-- under the team cards, right-aligned and clear of the menu column at the left edge
		w = min(400, m.W - 16 - Ring.MenuRight(m))
		f.AnchorPoint = Vector2.new(1, 0)
		f.Position = UDim2.fromOffset(m.W - 8, 6 + (Hud.topH or 80) + 8 + teamH + 10)
	end
	local inner = w - 2 * K.PAD - 8
	local y = K.PAD
	Hud.nextTitle.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextTitle.Size = UDim2.fromOffset(inner, 32)
	y = y + 34
	Hud.nextLine.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextLine.Size = UDim2.fromOffset(inner, 26)
	y = y + 28
	if #extra > 0 then
		Hud.nextExtra.Position = UDim2.fromOffset(K.PAD + 4, y)
		Hud.nextExtra.Size = UDim2.fromOffset(inner, 22)
		y = y + 26
	end
	Hud.nextCount.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextCount.Size = UDim2.fromOffset(inner, 30)
	y = y + 32
	Hud.nextBar.Root.Position = UDim2.fromOffset(K.PAD + 4, y)
	Hud.nextBar.Root.Size = UDim2.fromOffset(inner, 8)
	y = y + 8 + K.PAD
	y = Leave.PlaceOnCard(m, B, w, y)
	f.Size = UDim2.fromOffset(w, y)
	f.Visible = true
	Hud.FixText(f, m.F)
	Ring.UpdateNext(os.clock())
end

-- the right edge of the menu column (MenuController's MenuColumn) in design px, 0 when it is hidden / missing
function Ring.MenuRight(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local menu = pg and pg:FindFirstChild("NimbusMenu")
	local col = menu and menu.Enabled ~= false and menu:FindFirstChild("MenuColumn", true)
	if not col or Hud.menuHidden then
		return 0
	end
	local right = col.AbsolutePosition.X + col.AbsoluteSize.X
	return max(0, math.ceil(right / max(0.05, m.F)) + 4)
end

-- the bottom of the HUD's currency pills (NimbusHud TopRight.Currency; 1 to 3 pills) in design px + a gap, 0 if none
function Ring.CurrencyBottom(m)
	local pg = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local top = hud and hud:FindFirstChild("TopRight", true)
	local cur = top and top:FindFirstChild("Currency") or top
	if not cur or not cur:IsA("GuiObject") or not cur.Visible then
		return 0
	end
	local bottom = cur.AbsolutePosition.Y + cur.AbsoluteSize.Y
	return max(0, math.ceil(bottom / max(0.05, m.F)) + 8)
end

-- the countdown (a text write only when the shown second changes)
function Ring.UpdateNext(now)
	local nx = St.next
	if not nx then
		return
	end
	local f = Hud.next
	if not f or not f.Visible or not St.battle or St.battle.ringNext ~= nx then
		Ring.HideNext()
		return
	end
	local left = nx.Seconds - (now - nx.At)
	local text = (left > 0.05) and ("Round " .. nx.Next .. " in " .. math.ceil(left - 0.05)) or ("Round " .. nx.Next .. "...")
	setText(Hud.nextCount, text)
	setThin(Hud.nextBar, clamp(left / max(0.1, nx.Seconds), 0, 1))
end

function Ring.HideNext()
	St.next = nil
	if Hud.next then
		Hud.next.Visible = false
	end
end

-- the run ended between two rounds (its final End names the last round's id): the result card replaces the side card
function Ring.FinalAfterWin(B, payload)
	B.ringNext = nil
	Ring.HideNext()
	B.linger = K.END_LINGER
	B.endAt = os.clock()
	Hud.ShowResult(B, payload)
end

-- my pets' models + cards out of a won round (to be handed to the next round's units of the same key)
function Ring.TakeModels(B)
	local out = {}
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		if type(key) == "string" and u.model and not u.failed and out[key] == nil then
			out[key] = { model = u.model, root = u.root, height = u.height, centerY = u.centerY, rigid = u.rigid, card = u.card, evo = u.evo, x = u.x, z = u.z, yaw = u.yaw }
			u.model, u.root, u.card = nil, nil, nil
			out[key].model.Parent = nil
		end
	end
	return out
end

function Ring.GiveModels(B, carry)
	for _, u in pairs(B.mine) do
		local key = u.info and u.info.key
		local c = type(key) == "string" and carry[key] or nil
		if c and c.evo == u.evo and not u.model then
			carry[key] = nil
			u.model, u.root, u.height, u.centerY, u.rigid, u.card = c.model, c.root, c.height, c.centerY, c.rigid, c.card
			u.x, u.z, u.yaw, u.seen = c.x, c.z, c.yaw, false
			u.folder = B.folder
			u.model.Name = "Unit_" .. tostring(u.id)
			u.model.Parent = B.folder
			u.cardWrites = 0
			u.cardHp, u.cardMeter = nil, nil
			u.carried = true
			if u.card then
				u.card:SetMode(Cards.ModeOf(u))
				Cards.Static(u)
				Cards.Live(u)
			end
		end
	end
	for _, c in pairs(carry) do
		if c.card then
			pcall(c.card.Destroy, c.card)
		end
		pcall(c.model.Destroy, c.model)
	end
end

-- the result card of a run: RUN OVER / NEW RECORD!, where it ended
function Ring.ResultTitle(B, payload, sub)
	local rw = type(payload.Rewards) == "table" and payload.Rewards or {}
	local run = type(rw.Run) == "table" and rw.Run or {}
	local round = num(run.Round, num(rw.Round, B.Round))
	local title = run.Record ~= nil and "NEW RECORD!" or "RUN OVER"
	local why
	if rw.Void == true then
		why = "server restart: round " .. round .. " does not count"
	elseif payload.Outcome == "Left" or payload.Reason == "Forfeit" or payload.Reason == "Left" then
		why = "you left after round " .. round
	elseif payload.Reason == "Timeout" then
		why = "time ran out in round " .. round
	else
		why = "the champion won round " .. round
	end
	return title, Ring.GOLD, "Champion Ring: " .. why
end

-- the run's lines: Rounds won, Cash, XP, Tokens, the record
function Ring.ResultLines(B, rw)
	local run = type(rw.Run) == "table" and rw.Run or nil
	if not run then
		return Hud.RewardLines(B, rw)
	end
	local lines = {}
	local wins = num(run.Wins, 0)
	lines[#lines + 1] = { "Rounds won: " .. wins, COLORS.Gold }
	lines[#lines + 1] = { "+" .. Ring.Money(run.Cash) .. " Cash", Theme.Currency.Cash.Color }
	lines[#lines + 1] = { "+" .. Theme.ShortNumber(num(run.Xp, 0)) .. " Pet XP", COLORS.Ally }
	local tokens = num(run.Tokens, 0)
	if tokens > 0 then
		lines[#lines + 1] = { "+" .. Theme.ShortNumber(tokens) .. " Tokens", Theme.Currency.Tokens.Color }
	end
	-- (level-ups are the server's toasts: the card stays short enough for a landscape phone)
	if run.Record ~= nil then
		lines[#lines + 1] = { "Best: round " .. tostring(run.Record) .. "!", COLORS.Mine }
	elseif num(run.Best, 0) > 0 then
		lines[#lines + 1] = { "Best: round " .. tostring(num(run.Best, 0)), COLORS.Weak }
	end
	return lines
end

----------------------------------------------------------------------
-- Input
----------------------------------------------------------------------
local SPECIAL_KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.KeypadOne] = 1,
	[Enum.KeyCode.KeypadTwo] = 2,
	[Enum.KeyCode.KeypadThree] = 3,
	[Enum.KeyCode.KeypadFour] = 4,
	[Enum.KeyCode.ButtonL1] = 1,
	[Enum.KeyCode.ButtonR1] = 2,
	[Enum.KeyCode.ButtonL2] = 3,
	[Enum.KeyCode.ButtonR2] = 4,
}

local function sink()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Sink
	end)
	return ok and v or nil
end

local function pass()
	local ok, v = pcall(function()
		return Enum.ContextActionResult.Pass
	end)
	return ok and v or nil
end

local function fighting()
	local B = St.battle
	return B ~= nil and B.Fighter and not B.ended
end

function Input.OnAction(name, state, input)
	if not fighting() then
		return pass()
	end
	if state ~= Enum.UserInputState.Begin then
		return sink()
	end
	if name == K.ACTION_ATTACK then
		BattleController.Command("Attack", nil)
	elseif name == K.ACTION_RETREAT then
		BattleController.Command("Retreat")
	elseif name == K.ACTION_SPECIAL then
		local slot = input and SPECIAL_KEYS[input.KeyCode]
		if slot then
			BattleController.Command("Special", slot)
		end
	end
	return sink()
end

function Input.Bind(on)
	if on == St.bound then
		return
	end
	St.bound = on
	if on then
		local priority = 2000
		pcall(function()
			priority = Enum.ContextActionPriority.High.Value
		end)
		pcall(function()
			ContextActionService:BindActionAtPriority(K.ACTION_ATTACK, Input.OnAction, false, priority, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
			ContextActionService:BindActionAtPriority(K.ACTION_RETREAT, Input.OnAction, false, priority, Enum.KeyCode.R, Enum.KeyCode.ButtonY)
			ContextActionService:BindActionAtPriority(
				K.ACTION_SPECIAL, Input.OnAction, false, priority,
				Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four,
				Enum.KeyCode.KeypadOne, Enum.KeyCode.KeypadTwo, Enum.KeyCode.KeypadThree, Enum.KeyCode.KeypadFour,
				Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1, Enum.KeyCode.ButtonL2, Enum.KeyCode.ButtonR2
			)
		end)
	else
		for _, name in ipairs({ K.ACTION_ATTACK, K.ACTION_RETREAT, K.ACTION_SPECIAL }) do
			pcall(function()
				ContextActionService:UnbindAction(name)
			end)
		end
	end
end

-- the enemy a tap at viewport pixel (x, y) focuses (nearest projected enemy within reach), or nil
function BattleController.ScreenPick(x, y)
	local B = St.battle
	local cam = workspace.CurrentCamera
	if not B or not cam then
		return nil
	end
	local reach = K.TAP_REACH * Theme.ScreenFactor()
	local best, bestD = nil, math.huge
	for _, u in ipairs(B.list) do
		if not u.ally and u.model and not u.parked and u.hp > 0 and u.state ~= S_DOWN then
			local ok, p, onScreen = pcall(cam.WorldToViewportPoint, cam, unitCenter(B, u))
			if ok and onScreen and p.Z > 0 then
				local dx, dy = p.X - x, p.Y - y
				local d = sqrt(dx * dx + dy * dy)
				local r = reach
				if u.isBoss then
					r = reach * 3
				elseif u.kind == "MiniBoss" then
					r = reach * 1.6
				end
				if d <= r and d < bestD then
					best, bestD = u.id, d
				end
			end
		end
	end
	return best
end

function Input.OnBegan(input, processed)
	local t = input.UserInputType
	if t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2 then
		if not St.gamepad then
			St.gamepad = true
			Hud.Keys()
		end
	elseif t == Enum.UserInputType.Keyboard or t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		if St.gamepad then
			St.gamepad = false
			Hud.Keys()
		end
	end
	if processed or not fighting() then
		return
	end
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
		St.tap = { x = input.Position.X, y = input.Position.Y, t = os.clock(), input = input }
	end
end

function Input.OnEnded(input)
	local tap = St.tap
	if not tap then
		return
	end
	local t = input.UserInputType
	if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then
		return
	end
	St.tap = nil
	if not fighting() or os.clock() - tap.t > K.TAP_TIME then
		return
	end
	local dx, dy = input.Position.X - tap.x, input.Position.Y - tap.y
	if dx * dx + dy * dy > K.TAP_MOVE * K.TAP_MOVE then
		return
	end
	-- input positions are in GUI space (below the top bar); the camera projects into the full viewport
	local inset = 36
	local ok, a = pcall(function()
		return GuiService:GetGuiInset()
	end)
	if ok and typeof(a) == "Vector2" then
		inset = a.Y
	end
	local id = BattleController.ScreenPick(input.Position.X, input.Position.Y + inset)
	if id then
		BattleController.Focus(id)
	end
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function commandRemote()
	if St.remoteCmd and St.remoteCmd.Parent then
		return St.remoteCmd
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local r = folder and folder:FindFirstChild("BattleCommand")
	St.remoteCmd = r
	return r
end

function BattleController.Command(action, arg)
	local B = St.battle
	if not B or not B.Fighter then
		return false
	end
	-- a ring run can be left between two rounds too: the won round has ended, the next Start has not come yet
	if B.ended and not (action == "Forfeit" and B.Mode == "Ring" and B.ringNext ~= nil) then
		return false
	end
	if action ~= "Attack" and action ~= "Retreat" and action ~= "Special" and action ~= "Forfeit" then
		return false
	end
	local key = action .. tostring(arg)
	local now = os.clock()
	if St.lastCmd[key] and now - St.lastCmd[key] < K.CMD_GAP then
		return false
	end
	-- local checks (the server decides; these only avoid pointless traffic and give instant feedback)
	if action == "Attack" then
		if B.order == "Retreat" and now - B.retreatAt < RETREAT_LOCK then
			return false
		end
		if arg ~= nil then
			local u = B.units[arg]
			if not u or u.ally or u.hp <= 0 then
				return false
			end
		end
	elseif action == "Retreat" then
		if B.order == "Retreat" then
			return false
		end
	elseif action == "Special" then
		local u = B.mine[tonumber(arg) or 0]
		local row = nil
		for _, r in ipairs(Hud.rows) do
			if r.slot == arg then
				row = r
			end
		end
		if not u or u.hp <= 0 or not u.special or u.meter < METER_MAX or B.order == "Retreat" then
			if row and row.Special then
				row.shakeAt = now
				Hud.Shake(row.Special)
			end
			if u and u.hp > 0 and u.special and u.meter >= METER_MAX and B.order == "Retreat" then
				Hud.Shake(Hud.attack) -- a full special waits for ATTACK: point at it
			end
			return false
		end
	end
	St.lastCmd[key] = now
	local remote = commandRemote()
	if not remote then
		return false
	end
	local ok = pcall(function()
		if arg ~= nil then
			remote:FireServer(action, arg)
		else
			remote:FireServer(action)
		end
	end)
	if not ok then
		return false
	end
	if action == "Forfeit" then
		return true -- the run's / trial's End does the rest
	end
	-- optimistic feedback (the Order event confirms)
	if action == "Retreat" then
		B.order = "Retreat"
		B.retreatAt = now
		B.focus = nil
	elseif action == "Attack" then
		B.order = "Attack"
		B.focus = arg
	end
	Hud.Update(B, now)
	return true
end

function BattleController.Focus(unitId)
	return BattleController.Command("Attack", unitId)
end

-- a short "not yet" wiggle (rotation only, so the layout is never disturbed)
function Hud.Shake(obj)
	if not obj or not obj.Parent then
		return
	end
	pcall(function()
		obj.Rotation = 5
		Util.Tween(obj, 0.06, { Rotation = -5 })
		task.delay(0.06, function()
			Util.Tween(obj, 0.08, { Rotation = 0 })
		end)
	end)
end

----------------------------------------------------------------------
-- Messages
----------------------------------------------------------------------
function Net.Cleanup(B, immediate)
	if not B then
		return
	end
	Tele.ClearAll(B)
	for _, u in ipairs(B.list) do
		Units.Destroy(u)
	end
	B.list = {}
	B.units = {}
	B.mine = {}
	if B.folder then
		pcall(B.folder.Destroy, B.folder)
		B.folder = nil
	end
	if St.battle == B then
		St.battle = nil
		if B.ringNext then
			Ring.HideNext()
		end
		if B.Mode == "Ring" then
			St.ringLast = B -- a run's final "End" may still come for this battle id (it ended between two rounds)
		end
		Input.Bind(false)
		if not St.result then
			Hud.SetVisible(false)
		end
	end
	if immediate then
		Fx.ClearAll()
	end
end

function Net.Start(payload, battleId)
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	local B = St.battle
	if B and B.Id == id and not B.ended then
		-- a refresh (a raid spectator joins): keep the models, update the side and the units
		local side = num(payload.Side, 0)
		B.Side = side
		B.Spectator = payload.Spectator == true or side == 0
		B.Fighter = not B.Spectator
		B.Names = type(payload.Names) == "table" and payload.Names or B.Names
		B.sides = type(payload.Sides) == "table" and payload.Sides or B.sides
		local keep = {}
		for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
			local u = Units.Add(B, info)
			if u then
				keep[u.id] = true
				local me = myUserId()
				u.mine = B.Fighter and info.owner == me
				if B.Fighter then
					u.ally = u.side == B.Side
				else
					u.ally = u.side == 1
				end
				if u.mine and u.slot >= 1 then
					B.mine[u.slot] = u
				end
				if u.barFill then
					u.barFill.BackgroundColor3 = u.mine and COLORS.Mine or (u.ally and COLORS.Ally or COLORS.Enemy)
				end
				Cards.Restyle(u)
			end
		end
		for i = #B.list, 1, -1 do
			local u = B.list[i]
			if not keep[u.id] then
				Units.Remove(B, u.id)
			end
		end
		Input.Bind(B.Fighter)
		Hud.Rebuild()
		return
	end
	-- the next Champion Ring round in the same pocket: my pets' models (and their cards) carry over, so nothing
	-- blinks between End and Start
	local carry = (B and B.ringNext and tostring(payload.Mode) == "Ring") and Ring.TakeModels(B) or nil
	if B then
		Net.Cleanup(B, false)
	end
	B = newBattle(payload, battleId)
	B.sides = type(payload.Sides) == "table" and payload.Sides or {}
	St.battle = B
	B.renderT = num(payload.T, 0)
	for _, info in ipairs(type(payload.Units) == "table" and payload.Units or {}) do
		Units.Add(B, info)
	end
	if carry then
		Ring.GiveModels(B, carry)
	end
	Ring.HideNext()
	St.ringLast = nil
	-- spread the first positions from the static info until the first snapshot arrives
	if B.Mode == "Raid" then
		local BB = lazyBoss()
		if BB and B.BossId and type(BB.Preload) == "function" then
			pcall(BB.Preload, B.BossId)
		end
	end
	St.result = nil
	if Hud.result then
		Hud.result.Visible = false
	end
	Input.Bind(B.Fighter)
	Hud.Rebuild()
	BattleController._wake()
end

function Net.Snapshot(payload, battleId)
	local B = St.battle
	if not B or type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if id ~= nil and id ~= B.Id then
		return
	end
	local T = num(payload.T, nil)
	if not T then
		return
	end
	local snaps = B.snaps
	local stale = #snaps > 0 and T <= snaps[#snaps].T
	if stale and payload.Units ~= nil then
		return -- out of order / duplicate (the old full form)
	end
	local units = payload.Units
	if type(units) ~= "table" then
		-- the wire form: only what changed since the last snapshot; the rest of the picture is carried forward
		if type(payload.U) ~= "table" or not BattleSim or type(BattleSim.DecodeSnapshot) ~= "function" then
			return
		end
		-- every delta is decoded, even one with no newer T (the server's baseline already counts it as sent)
		units = BattleSim.DecodeSnapshot(payload, B.lastUnits)
		B.lastUnits = units
		if stale then
			if T == snaps[#snaps].T then
				snaps[#snaps].Units = units
			end
			return
		end
	end
	snaps[#snaps + 1] = { T = T, Units = units }
	while #snaps > K.MAX_SNAPS do
		table.remove(snaps, 1)
	end
	local now = os.clock()
	local offset = T - now
	if not B.haveOffset then
		B.haveOffset = true
		B.offset = offset
	else
		-- follow slowly, but never let the render clock run ahead of what arrived
		B.offset = B.offset + (offset - B.offset) * K.OFFSET_RATE
		if offset < B.offset then
			B.offset = offset
		end
	end
end

function Net.Events(list, battleId)
	local B = St.battle
	if not B or type(list) ~= "table" then
		return
	end
	if battleId ~= nil and battleId ~= B.Id then
		return
	end
	-- played on the delayed render clock: stamp them with the estimated server time of their arrival
	local t = B.haveOffset and (os.clock() + B.offset) or B.renderT
	for _, ev in ipairs(list) do
		if type(ev) == "table" and type(ev.type) == "string" then
			-- telegraphs start at once (their fill must complete at the hit), the rest on the render clock
			if ev.type == EV.Telegraph then
				local fn = Handlers[ev.type]
				pcall(fn, B, ev)
			else
				B.evq[#B.evq + 1] = { t = t, ev = ev }
			end
		end
	end
end

function Net.End(payload, battleId)
	local B = St.battle
	if type(payload) ~= "table" then
		return
	end
	local id = payload.BattleId or battleId
	if not B and St.ringLast and St.ringLast.Id == id and Ring.IsFinal(payload) then
		Hud.ShowResult(St.ringLast, payload) -- the run's card after the last round's floor was already freed
		St.ringLast = nil
		return
	end
	if not B or (id ~= nil and id ~= B.Id) then
		return
	end
	if B.ended then
		if B.ringNext and Ring.IsFinal(payload) then
			Ring.FinalAfterWin(B, payload) -- the run ended between two rounds (Forfeit, a leave, a shutdown...)
		end
		return
	end
	-- play what is still queued, so the last KO shows
	local latest = B.snaps[#B.snaps]
	B.renderT = max(B.renderT, (latest and latest.T or B.renderT)) + 5
	Net.PlayDue(B, os.clock())
	B.ended = true
	B.endAt = os.clock()
	Input.Bind(false)
	local participant = payload.Spectator ~= true and B.Fighter
	Cards.AfterFight(B, payload)
	if participant and Ring.IsNext(B, payload) then
		-- a won Champion Ring round: the side card "Round 8 won! ... Round 9 in 3", the floor stays until the next Start
		B.linger = Ring.LINGER
		Ring.ShowNext(B, payload)
		for _, u in ipairs(B.list) do
			if u.ally and u.root and not u.parked then
				u.hopAt = os.clock() + math.random() * 0.4
			end
		end
	elseif participant then
		B.linger = K.END_LINGER
		Hud.ShowResult(B, payload)
		-- winners cheer
		if payload.Outcome == "Win" or payload.Won then
			for _, u in ipairs(B.list) do
				if u.ally and u.root and not u.parked then
					u.hopAt = os.clock() + math.random() * 0.4
				end
			end
		end
	else
		B.linger = (payload.Reason == "OutOfRange") and 0 or K.SPECTATOR_LINGER
		Hud.SetVisible(false)
	end
	if B.linger <= 0 then
		Net.Cleanup(B, false)
	end
end

function BattleController.HandleState(kind, payload, battleId)
	if kind == "Start" then
		Net.Start(payload, battleId)
	elseif kind == "Snapshot" then
		Net.Snapshot(payload, battleId)
	elseif kind == "Events" then
		Net.Events(payload, battleId)
	elseif kind == "End" then
		Net.End(payload, battleId)
	end
end

----------------------------------------------------------------------
-- Frame loop
----------------------------------------------------------------------
local function sampleSnaps(B)
	local snaps = B.snaps
	local n = #snaps
	if n == 0 then
		return nil, nil, 0
	end
	local t = B.renderT
	if t <= snaps[1].T then
		return snaps[1], nil, 0
	end
	for i = n - 1, 1, -1 do
		local a = snaps[i]
		if a.T <= t then
			local b = snaps[i + 1]
			local span = b.T - a.T
			local alpha = span > 0 and clamp((t - a.T) / span, 0, 1) or 1
			return a, b, alpha
		end
	end
	return snaps[n], nil, 0
end

-- per-section cost (only while a test injects BattleController.PerfClock)
local function section(name, t0)
	local clock = BattleController.PerfClock
	if not clock then
		return nil
	end
	local t = clock()
	if t0 then
		local split = St.perf.split
		split[name] = (split[name] or 0) + (t - t0) * 1000
	end
	return t
end

local function stepBattle(B, now, dt)
	local s0 = section()
	if not B.ended then
		if B.haveOffset then
			local latest = B.snaps[#B.snaps]
			local t = now + B.offset - interpDelay(B)
			if latest and t > latest.T + 0.15 then
				t = latest.T + 0.15
			end
			if t > B.renderT then
				B.renderT = t
			end
		end
		Net.PlayDue(B, now)
	end
	local sa, sb, alpha = sampleSnaps(B)
	s0 = section("Events", s0)
	Units.BuildPending(B)
	s0 = section("Builds", s0)
	local crowded = #B.list > K.CROWD
	local frameNo = St.frameNo
	local cam = workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for i, u in ipairs(B.list) do
		local animate = true
		if not u.mine and not u.isBoss then
			local stride = crowded and 2 or 1
			if camPos and u.root and not u.parked then
				local p = u.root.Position
				local dx, dy, dz = p.X - camPos.X, p.Y - camPos.Y, p.Z - camPos.Z
				local d2 = dx * dx + dy * dy + dz * dz
				if d2 > K.ANIM_FAR * K.ANIM_FAR then
					stride = 4
				elseif d2 > K.ANIM_MID * K.ANIM_MID then
					stride = 3
				end
			end
			-- a skipped frame skips the WHOLE pet (root and wings), so it never comes apart
			animate = (not u.posed) or ((frameNo + i) % stride) == 0
		end
		local ok, err = pcall(updateUnit, B, u, now, dt, sa, sb, alpha, animate)
		if not ok then
			warnOnce("unit", "unit update failed: " .. tostring(err))
		end
	end
	s0 = section("Units", s0)
	Tele.Update(B, now)
	Units.UpdateFocus(B, now)
	s0 = section("Telegraphs", s0)
	if Hud.gui then
		local ok, err = pcall(Hud.Update, B, now)
		if not ok then
			warnOnce("hud", "HUD update failed: " .. tostring(err))
		end
	end
	section("Hud", s0)
end

-- a bobbing voxel arrow over the enemy the team focuses
function Units.UpdateFocus(B, now)
	local u = B.focus and B.units[B.focus]
	local mark = B.focusMark
	if not u or not u.model or u.parked or u.hp <= 0 or B.ended then
		if mark then
			mark.Parent = nil
		end
		return
	end
	if not mark then
		mark = make("Model", { Name = "FocusArrow" })
		local spec = { { 0, 0, 0.9 }, { 0, 0.7, 0.6 }, { 0, 1.3, 0.35 } }
		for i, s in ipairs(spec) do
			make("Part", {
				Name = "Arrow" .. i,
				Anchored = true,
				CanCollide = false,
				CanQuery = false,
				CanTouch = false,
				CastShadow = false,
				Material = Enum.Material.Neon,
				Color = COLORS.Gold,
				Size = Vector3.new(s[3] * 1.4, 0.5, s[3] * 1.4),
			}, mark):SetAttribute("Y", s[2])
		end
		B.focusMark = mark
	end
	if mark.Parent ~= B.folder then
		mark.Parent = B.folder
	end
	local top = u.isBoss and (u.height or 20) + 2 or (u.centerY or 1.5) + (u.height or 3) / 2 + 2.4
	local base = worldPoint(B, u.x, top + sin(now * 4) * 0.35, u.z)
	local spin = now * 2
	for _, p in ipairs(mark:GetChildren()) do
		p.CFrame = CFrame.new(base.X, base.Y - (p:GetAttribute("Y") or 0) * 0.8, base.Z) * CFrame.Angles(0, spin, 0)
	end
end

local function onFrame(dt)
	local perfClock = BattleController.PerfClock or os.clock
	local p0 = perfClock()
	local t0 = os.clock()
	St.frameNo = St.frameNo + 1
	local now = t0
	local B = St.battle
	if B then
		stepBattle(B, now, dt)
		if B.ended and now - (B.endAt or now) >= (B.linger or 0) then
			Net.Cleanup(B, false)
		end
	end
	local f0 = section()
	Fx.Update(now)
	Fx.UpdateNumbers(now)
	Fx.UpdateFlashes(now)
	Hud.UpdateResult(now)
	Ring.UpdateNext(now)
	section("Effects", f0)
	local ms = (perfClock() - p0) * 1000
	local perf = St.perf
	perf.frames = perf.frames + 1
	perf.total = perf.total + ms
	perf.last = ms
	if ms > perf.peak then
		perf.peak = ms
	end
	-- the loop sleeps when nothing is drawn
	if not St.battle and #St.effects == 0 and #St.numbers == 0 and #St.flashes == 0 and not St.result and not St.next then
		if St.loop then
			St.loop:Disconnect()
			St.loop = nil
		end
	end
end

function BattleController._wake()
	if St.loop or not St.initialized then
		return
	end
	St.loop = RunService.RenderStepped:Connect(function(dt)
		local ok, err = pcall(onFrame, dt)
		if not ok then
			warnOnce("frame", "frame failed: " .. tostring(err))
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function BattleController.GetBattle()
	local B = St.battle
	if not B then
		return nil
	end
	local models = 0
	for _, u in ipairs(B.list) do
		if u.model then
			models = models + 1
		end
	end
	return {
		Id = B.Id,
		Mode = B.Mode,
		Side = B.Side,
		Spectator = B.Spectator,
		Fighter = B.Fighter,
		Ended = B.ended,
		Units = #B.list,
		Models = models,
		Focus = B.focus,
		Order = B.order,
		Hud = BattleController.IsHudVisible(),
		Layout = (Hud.m and Hud.m.Compact) and "Compact" or "Wide",
		RenderT = B.renderT,
		Telegraphs = (function()
			local n = 0
			for _ in pairs(B.teles) do
				n = n + 1
			end
			return n
		end)(),
		Threat = B.threat == true,
		Cue = B.cue,
		-- Phase 4: the ring round / record, the won round waiting for the next Start, duel overtime
		Round = B.Round > 0 and B.Round or nil,
		Best = B.Ring and num(B.Ring.Best, 0) or nil,
		Next = B.ringNext and B.ringNext.Next or nil,
		Overtime = B.overtime == true,
		InterpDelay = interpDelay(B),
		TeamPlace = Hud.teamPlace,
	}
end

-- the drawn telegraphs (tests): { { Id, Shape, At, From, SafeAt, Late } ... } on the render clock
function BattleController.GetTelegraphs()
	local B = St.battle
	local out = {}
	for id, tl in pairs(B and B.teles or {}) do
		out[#out + 1] = { Id = id, Shape = tl.shape, At = tl.at, From = tl.from, SafeAt = tl.safeAt, Late = tl.late == true }
	end
	return out
end

function BattleController.GetUnit(id)
	local B = St.battle
	local u = B and B.units[id]
	if not u then
		return nil
	end
	return {
		Id = u.id, Side = u.side, Kind = u.kind, Name = u.name, Hp = u.hp, MaxHp = u.maxHp, State = u.state, Meter = u.meter,
		Model = u.model, X = u.x, Z = u.z, Parked = u.parked == true, Mine = u.mine, Ally = u.ally,
		World = u.model and unitCenter(B, u) or nil,
		-- Phase 4: the unit's PetCard ({ Gui, Mode }), level, evolution stage, XP, the ring champion's crown
		Card = u.card and { Gui = u.card.Gui, Mode = u.card.mode } or nil,
		Level = u.level, Evo = u.evo, Xp = u.xp, XpNext = u.xpNext, Crowned = u.crowned,
		Writes = u.cardWrites or 0,
	}
end

function BattleController.GetStats()
	local perf = St.perf
	local B = St.battle
	local models = 0
	if B then
		for _, u in ipairs(B.list) do
			if u.model then
				models = models + 1
			end
		end
	end
	local teles = 0
	if B then
		for _ in pairs(B.teles) do
			teles = teles + 1
		end
	end
	return {
		Frames = perf.frames,
		AvgMs = perf.frames > 0 and perf.total / perf.frames or 0,
		PeakMs = perf.peak,
		LastMs = perf.last,
		Units = B and #B.list or 0,
		Models = models,
		FxParts = St.fxLive,
		Effects = #St.effects,
		Numbers = #St.numbers,
		Flashes = #St.flashes,
		Telegraphs = teles,
		Builds = perf.builds,
		Bound = St.bound,
		Split = (function()
			local out = {}
			for k, v in pairs(perf.split or {}) do
				out[k] = perf.frames > 0 and v / perf.frames or 0
			end
			return out
		end)(),
	}
end

function BattleController.ResetStats()
	St.perf = { frames = 0, total = 0, peak = 0, last = 0, builds = 0, split = {} }
end

function BattleController.IsHudVisible()
	return Hud.gui ~= nil and Hud.gui.Parent ~= nil and ((Hud.team and Hud.team.Visible) or (Hud.result and Hud.result.Visible)) == true
end

function BattleController.Stop()
	if St.battle then
		Net.Cleanup(St.battle, true)
	end
	Fx.ClearAll()
	Input.Bind(false)
	for _, c in ipairs(St.conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	St.conns = {}
	if St.loop then
		St.loop:Disconnect()
		St.loop = nil
	end
	Hud.SetMenuHidden(false)
	if Hud.gui then
		Hud.gui:Destroy()
	end
	Hud.gui = nil
	Hud.topBuilt = false
	Hud.teamBack = nil
	Hud.rows = {}
	Hud.chips = {}
	Hud.next = nil
	Hud.info = nil
	St.result = nil
	St.next = nil
	St.ringLast = nil
	for _, p in ipairs(St.pool) do
		pcall(p.Destroy, p)
	end
	St.pool = {}
	St.fxLive = 0
	if St.folder then
		pcall(St.folder.Destroy, St.folder)
		St.folder = nil
		St.fxFolder = nil
	end
	St.initialized = false
end

function BattleController.Init()
	if St.initialized then
		return
	end
	St.initialized = true
	local conns = St.conns
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input, processed)
		local ok, err = pcall(Input.OnBegan, input, processed)
		if not ok then
			warnOnce("input", err)
		end
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
		local ok, err = pcall(Input.OnEnded, input)
		if not ok then
			warnOnce("input2", err)
		end
	end)
	local okGp, gpConn = pcall(function()
		return UserInputService.LastInputTypeChanged:Connect(function(t)
			local gp = t == Enum.UserInputType.Gamepad1 or t == Enum.UserInputType.Gamepad2
			if gp ~= St.gamepad then
				St.gamepad = gp
				pcall(Hud.Keys)
			end
		end)
	end)
	if okGp and gpConn then
		conns[#conns + 1] = gpConn
	end
	-- own pets' level / XP from the profile mirror (after a fight's rewards land: the cards follow)
	local okS, sConn = pcall(function()
		return Mods.State and Mods.State.Changed and Mods.State.Changed:Connect(function()
			if St.battle then
				pcall(Cards.FromState, St.battle)
			end
		end)
	end)
	if okS and sConn then
		conns[#conns + 1] = sConn
	end
	local cam = workspace.CurrentCamera
	if cam then
		conns[#conns + 1] = cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if St.battle then
				pcall(Hud.Rebuild)
			end
			local r = St.result
			if r and r.battle and Hud.result and Hud.result.Visible then
				pcall(Hud.ShowResult, r.battle, r.payload) -- the card re-places itself (top right on a landscape phone)
			end
		end)
	end
	-- the remote (BattleState may arrive a little after the controller starts)
	task.spawn(function()
		local folder = ReplicatedStorage:WaitForChild("Remotes", 30)
		local remote = folder and folder:WaitForChild("BattleState", 30)
		if not remote or not St.initialized then
			if St.initialized then
				warnOnce("remote", "BattleState remote not found: battles will not be drawn")
			end
			return
		end
		conns[#conns + 1] = remote.OnClientEvent:Connect(function(kind, payload, battleId)
			local ok, err = pcall(BattleController.HandleState, kind, payload, battleId)
			if not ok then
				warnOnce("state_" .. tostring(kind), "BattleState " .. tostring(kind) .. " failed: " .. tostring(err))
			end
		end)
		commandRemote()
	end)
end

return BattleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">CareController</string>
              <string name="Source"><![CDATA[-- CareController (client, Phase 4): the pet-care windows of ARCHITECTURE_V3.md "Phase 4 build contract" 3.4-3.7.
--
--   CareController.Init()
--   CareController.Open(panelId, args)   panelId = "Feed" | "Garden" | "Train" | "Evolve"
--       Feed    the Food Machine window (args.Key = the pet to show first): one row per owned pet copy, garden pets
--               first, then the followers, then the rest; each row has the pet, its name and stars, "Lv 57 / 100", the
--               XP bar, "Feed $340 (+90 XP)" (or "Feed (free Feast, 3 left)" while leftovers last), "Level up $1.2K"
--               (several feeds in ONE request, TycoonCatalog.FeedPrice per feed at the level it is eaten at) and
--               EVOLVE! when PetCatalog.CanEvolve says so; the footer lists the leftover food and the machine
--               ("Food Machine Lv 2: each feed fills 30% of the bar. Upgrade to Lv 3 (35%): $320K" + Upgrade).
--               -> PetCare("Feed", key, nil | {Count = n}); HomeAction("Upgrade", "Kitchen")
--       Garden  the garden picker for one place (args.Slot): every pet copy (any role) with its coins per second;
--               "Put here" -> HomeAction("GardenSet", {Slot, Key}); "Take out" -> HomeAction("GardenSet", {Slot})
--       Train   the Training Place window (args.Key = the pet to select): the pets on the left, the four skills
--               (Attack Speed / Physique / Ability / Defense) of the selected pet on the right with a rank bar, the
--               next rank's cost and time (TycoonCatalog.TrainCost / TrainSeconds) and Train; a training pet shows
--               its timer and Stop. Train and Stop ask first. -> PetCare("Train", key, stat) / PetCare("TrainStop", key)
--       Evolve  the evolution moment (the server's OpenPanel("Evolve", {Key, Stage}) after PetCare("Evolve")): every
--               window closes, PetController.PlayEvolution parks the follower of that key, EvolutionFx plays on two
--               fresh PetBuilder clones 5.5 studs in front of the player (with confetti), then the evolved clone
--               flies home as the follower (release(position)) and goes away
--   CareController.Close()               closes the window and any confirm
--   CareController.IsOpen() -> true while a care window or a confirm is up
--   Extras: CareController.Mode() -> "Feed" | "Garden" | "Train" | nil, CareController.ConfirmEvolve(key) (the EVOLVE
--           confirm, used by the Pets panel too), CareController.FeedPlan(key, count) -> { Count, Price, Xp, Free,
--           Food, Levels } (what a request would do; the server decides), CareController.Evolving() -> plays running,
--           CareController.Opened / Closed (Util.Signal; Opened fires the mode)
--
-- How the windows open: the server's OpenPanel("Pets", {Action = "Feed"}) (FeedPrompt on the Food Machine) and
-- OpenPanel("Train") (TrainPrompt) arrive here; MenuController forwards OpenPanel("Pets", {Action = "Feed" | "Garden"})
-- calls made on the client; E on an own GardenSpotPrompt opens the picker for its Slot. One window at a time: opening
-- one closes the menu windows, the Pet Index and the Fusion Machine; those opening close it. Esc, the red X or a click
-- outside close it, so does entering a match.
-- The client never decides money, XP or ranks: every number shown comes from the catalogs and the synced profile and the
-- server checks every request again. Readability rule: 1080p design pixels (body 18-19, buttons 20, titles 28-32) under
-- ONE UIScale = min(screen factor, fit); the window keeps >= 14 px text on phones (portrait: one column, landscape:
-- the compact rows). Pet viewports use PetBuilder's Low detail and are attached under a per-frame time budget.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local PetCatalog = safeRequire("PetCatalog") or { Get = function() return nil end }
local TycoonCatalog = safeRequire("TycoonCatalog")
local BattleCatalog = safeRequire("BattleCatalog")

local CareController = {}
CareController.Opened = Util.Signal()
CareController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- above NimbusMenu (20), the Pet Index (21) and the Fusion Machine (22)
	MARGIN = 12,
	BUMPS = 28,
	PREF_W = 1240,
	PREF_H = 720,
	MIN_W = 780,
	MIN_H = 380,
	SHORT = 560, -- below this design height: the compact rows (landscape phones)
	WIDE = 930, -- at least this wide: one-line rows (the buttons beside the bar)
	TALL_W = 720, -- less than this free (design px) on a portrait screen: one column
	PREF_W_TALL = 560,
	MIN_W_TALL = 440,
	PREF_H_TALL = 1060,
	MIN_H_TALL = 600,
	ROW_H = 112,
	BUTTONS_W = 610, -- the one-line row's button block (Feed 276 + Level up 190 + EVOLVE 128 + gaps)
	ROW_H_STACKED = 176,
	ROW_H_SHORT = 100,
	ROW_H_SHORT_STACKED = 160,
	VIEW = 88,
	VIEW_SHORT = 72,
	TOP_H = 46,
	FOOT_H = 108,
	FOOT_H_SHORT = 74,
	TRAIN_LIST_W = 360,
	TRAIN_ROW_H = 84,
	SKILL_H = 104,
	SKILL_H_SHORT = 88,
	CONFIRM_W = 560,
	CONFIRM_H = 286,
	BUILD_BUDGET = 0.004, -- seconds of pet viewport building per frame (at least one per frame)
	FIRE_GAP = 0.3, -- client-side spacing between two sends of the same action
	TICK = 0.5, -- seconds between two timer refreshes while a window is open
	MAX_FEEDS = 10, -- "Level up": at most this many feeds in one request (the server's MAX_FEEDS)
	-- the evolution moment (contract 3.6)
	EVO_AHEAD = 5.5, -- studs in front of the player
	EVO_HOVER = 0.7, -- studs between the clone's lowest point and the ground
	EVO_REST = 1.3, -- seconds the evolved clone stays before it flies home as the follower
	EVO_DETAIL = "High",
	EVO_FOLDER = "CareEvolution",
	RAY = 60,
	BACK_ACTION = "NimbusCareBack",
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local GOOD = Colors.Good
local BAD = Colors.Bad
local WELL_EDGE = Colors.WellEdge or NAVY
local INSET = Color3.fromRGB(20, 30, 70)
local CASH = Colors.Cash or Color3.fromRGB(112, 204, 98)
local XP = Color3.fromRGB(120, 200, 255)
local PURPLE = Color3.fromRGB(168, 118, 236)
local LOCK = Color3.fromRGB(255, 206, 120)
local ACCENTS = {
	Feed = Color3.fromRGB(240, 150, 80),
	Garden = Color3.fromRGB(110, 190, 90),
	Train = Color3.fromRGB(228, 104, 96),
}
local ROLE_COLORS = { Economy = Color3.fromRGB(96, 196, 108), Combat = Color3.fromRGB(228, 104, 96) }

-- glyphs as UTF-8 byte escapes (the source stays plain ASCII)
local G = {
	Star = "\226\152\133",
	Food = "\240\159\141\178", -- pot of food (the Food Machine)
	Seedling = "\240\159\140\177",
	Muscle = "\240\159\146\170",
	Lock = "\240\159\148\146",
	Bullet = "\194\183",
	Clock = "\226\143\177", -- stopwatch
	Sparkle = "\226\156\168",
}

local TITLES = {
	Feed = G.Food .. " Food Machine",
	Garden = G.Seedling .. " Pet Garden",
	Train = G.Muscle .. " Training Place",
}

local SKILLS = (BattleCatalog and type(BattleCatalog.TrainingSkills) == "table" and #BattleCatalog.TrainingSkills == 4)
		and BattleCatalog.TrainingSkills
	or {
		{ Id = "Speed", Name = "Attack Speed", Text = "+4% attacks per rank" },
		{ Id = "Physique", Name = "Physique", Text = "+5% max health per rank" },
		{ Id = "Ability", Name = "Ability", Text = "+4% special power and charge per rank" },
		{ Id = "Defense", Name = "Defense", Text = "-3% damage taken per rank" },
	}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local S = {
	Open = false, -- a window is shown
	Mode = nil, -- "Feed" | "Garden" | "Train"
	Token = 0,
	Built = false,
	Focus = nil, -- Feed: the pet to show first
	Slot = nil, -- Garden: the place the picker fills
	TrainKey = nil, -- Train: the selected pet
	Short = false,
	Tall = false,
	Stacked = false,
	Confirm = nil, -- { Kind, Key, Stat, Yes = fn } while a confirm is up
	Evolving = 0,
	EvoQueue = {},
	Last = {}, -- last send per action key (os.clock)
	Filling = false,
	RefreshPending = false,
}
local U = { Rows = {}, GardenRows = {}, TrainRows = {}, Skills = {} } -- ui references
local H = {} -- helpers (one table: the module stays far below Lua's local limit)

local function warnOnce(key, err)
	S.Warned = S.Warned or {}
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[CareController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok, err
end

----------------------------------------------------------------------
-- small UI helpers
----------------------------------------------------------------------
function H.frame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel (stroke + glyph outline: readable on any panel)
function H.text(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for k, v in pairs(props) do
			p[k] = v
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Stroke = 0.25,
		StrokeColor = INK,
		Outline = 1.5,
		OutlineColor = INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

function H.corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

function H.stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

function H.pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

function H.list(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap or 0),
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function H.scroller(parent, name, props)
	local p = props or {}
	p.Name = name
	p.BackgroundTransparency = 1
	p.BorderSizePixel = 0
	p.CanvasSize = UDim2.new(0, 0, 0, 0)
	p.AutomaticCanvasSize = Enum.AutomaticSize.Y
	p.ScrollingDirection = Enum.ScrollingDirection.Y
	p.ScrollBarThickness = 10
	p.ScrollBarImageColor3 = Colors.FrameTop or Colors.Cloud
	p.ScrollBarImageTransparency = 0.1
	p.Parent = parent
	return Util.Create("ScrollingFrame", p)
end

function H.inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = INSET
	p.BackgroundTransparency = 0.42
	local f = H.frame(parent, name, p)
	H.corner(f, 12)
	H.stroke(f, WELL_EDGE, 3, 0.15)
	return f
end

-- a solid coloured pill (role, status): white text with a dark outline of its own colour
function H.pill(parent, name, text, color, size, order)
	local dark = Theme.Darken(color, 0.62)
	local px = size or 18
	local pill = Theme.Label(text, "Heading", {
		Size = px,
		Color = WHITE,
		Stroke = 0.1,
		StrokeColor = dark,
		Outline = 1.5,
		OutlineColor = dark,
		Props = {
			Name = name,
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, px + 9),
			LayoutOrder = order or 0,
		},
	})
	Theme.Corner(pill, UDim.new(0.5, 0))
	H.stroke(pill, NAVY, 2, 0)
	Theme.Gradient(pill, Color3.fromRGB(255, 255, 255), Color3.fromRGB(200, 206, 226), 90)
	H.pad(pill, 9, 0, 9, 1)
	pill.Parent = parent
	return pill
end

function H.button(parent, name, text, style, size, textSize, callback)
	local b = CloudUI.Button({
		Name = name,
		Text = text,
		Style = style,
		Size = size,
		TextSize = textSize or 20,
		Callback = callback,
		Parent = parent,
	})
	return b
end

-- a button whose text may take two lines (the narrow rows): slimmer top / bottom padding
function H.twoLine(button)
	button.TextWrapped = true
	local p = button:FindFirstChildOfClass("UIPadding")
	if p then
		p.PaddingTop = UDim.new(0, 3)
		p.PaddingBottom = UDim.new(0, 3)
	end
end

function H.tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

----------------------------------------------------------------------
-- data helpers (the synced profile + the catalogs; display only)
----------------------------------------------------------------------
function H.call(mod, fnName, ...)
	if type(mod) ~= "table" or type(mod[fnName]) ~= "function" then
		return nil
	end
	local ok, a, b = pcall(mod[fnName], ...)
	if ok then
		return a, b
	end
	return nil
end

function H.def(key)
	if type(key) ~= "string" then
		return nil
	end
	local ok, def = pcall(State.DefOf, key)
	if ok and type(def) == "table" then
		return def
	end
	return PetCatalog.Get and PetCatalog.Get(key) or nil
end

function H.name(key, def)
	def = def or H.def(key)
	return def and tostring(def.DisplayName or def.Name or key) or tostring(key)
end

function H.level(key)
	local ok, level, xp = pcall(State.PetLevel, key)
	if ok and type(level) == "number" then
		return math.max(1, math.floor(level)), tonumber(xp) or 0
	end
	return 1, 0
end

function H.cap(def, key)
	local cap = H.call(PetCatalog, "LevelCap", def or key)
	if type(cap) == "number" and cap >= 1 then
		return math.floor(cap)
	end
	return tonumber(PetCatalog.MaxLevel) or (TycoonCatalog and tonumber(TycoonCatalog.MaxPetLevel)) or 100
end

function H.xpToNext(level)
	local n = H.call(TycoonCatalog, "XpToNext", level)
	if type(n) == "number" and n > 0 then
		return n
	end
	return math.huge
end

function H.growth(key)
	local ok, g = pcall(State.PetGrowth, key)
	if ok and type(g) == "table" then
		return g
	end
	return { Evo = 0, Speed = 0, Physique = 0, Ability = 0, Defense = 0 }
end

function H.stage(key)
	return math.max(0, math.floor(tonumber(H.growth(key).Evo) or 0))
end

-- the next stage when the pet can EVOLVE now, else nil
function H.canEvolve(key, def, level)
	local nextStage = H.call(PetCatalog, "CanEvolve", def or key, level, H.stage(key))
	if type(nextStage) == "number" and nextStage >= 1 then
		return nextStage
	end
	return nil
end

function H.stars(stage)
	if stage and stage > 0 then
		return string.rep(G.Star, math.min(2, stage))
	end
	return ""
end

function H.home()
	local ok, home = pcall(State.Home)
	if ok and type(home) == "table" then
		return home
	end
	return { Stations = {}, Garden = {}, Prestige = 0 }
end

function H.station(home, id)
	local st = type(home) == "table" and home.Stations or nil
	local v = type(st) == "table" and st[id] or nil
	if type(v) == "number" and v == v then
		return math.max(0, math.floor(v))
	end
	return 0
end

function H.cash()
	local ok, v = pcall(State.Cash)
	if ok and type(v) == "number" then
		return v
	end
	return 0
end

function H.owned(key)
	local ok, n = pcall(State.OwnedCount, key)
	return ok and tonumber(n) or 0
end

function H.money(n)
	local text = H.call(TycoonCatalog, "FormatCash", n)
	if type(text) == "string" then
		return text
	end
	return "$" .. Util.Commas(math.floor(tonumber(n) or 0))
end

function H.rate(n)
	n = tonumber(n) or 0
	if n ~= n or n < 0 then
		n = 0
	end
	if n < 100 then
		local t = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		return "$" .. (t:gsub("%.0$", ""))
	end
	return H.money(n)
end

function H.commas(n)
	return Util.Commas(math.floor(tonumber(n) or 0))
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.hasHome()
	return LocalPlayer ~= nil and type(LocalPlayer:GetAttribute(Config.Attr.SpotIndex)) == "number"
end

function H.now()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

function H.clock(seconds)
	seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

function H.minutes(seconds)
	local m = math.floor((tonumber(seconds) or 0) / 60 + 0.5)
	if m < 1 then
		return math.max(1, math.floor(seconds or 0)) .. " s"
	end
	return m .. " min"
end

function H.rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 1
		end
	end
	return 1
end

function H.rarityText(def)
	if def and def.Rarity == "Secret" then
		return Color3.fromRGB(196, 168, 255)
	end
	return Theme.Lighten(CloudUI.RarityColor(def and def.Rarity), 0.3)
end

-- every owned pet copy, rarest first (the Pets panel's order)
function H.ownedKeys()
	local ok, keys = pcall(State.Keys)
	if not ok or type(keys) ~= "table" then
		keys = {}
	end
	local info, out = {}, {}
	for i, key in ipairs(keys) do
		if type(key) == "string" and not info[key] and H.owned(key) > 0 then
			local def = H.def(key)
			if def then
				info[key] = { Order = H.rarityOrder(def.Rarity), Index = i }
				out[#out + 1] = key
			end
		end
	end
	table.sort(out, function(a, b)
		local x, y = info[a], info[b]
		if x.Order ~= y.Order then
			return x.Order > y.Order
		end
		return x.Index > y.Index
	end)
	return out
end

-- the Garden places holding `key` (ascending)
function H.gardenSlots(home, key)
	local out = {}
	if type(home.Garden) == "table" then
		for slot, k in pairs(home.Garden) do
			if k == key and type(slot) == "number" then
				out[#out + 1] = slot
			end
		end
	end
	table.sort(out)
	return out
end

function H.equippedCount(key)
	local ok, n = pcall(State.EquippedCount, key)
	return ok and tonumber(n) or 0
end

function H.equippedList()
	local ok, snap = pcall(State.Get)
	if ok and type(snap) == "table" and type(snap.Equipped) == "table" then
		return snap.Equipped
	end
	return {}
end

-- the running training job of a key { Stat, Ends, Rank, ... } or nil
function H.job(key)
	local job = H.growth(key).Job
	if type(job) == "table" then
		return job
	end
	return nil
end

function H.skillName(stat)
	for _, s in ipairs(SKILLS) do
		if s.Id == stat then
			return s.Name
		end
	end
	return tostring(stat)
end

-- where a pet copy is: "Physique 2:10" (training) | "In Garden" | "Following" | nil, and its colour
function H.whereText(key, home)
	local job = H.job(key)
	if job then
		local left = (tonumber(job.Ends) or 0) - H.now()
		return G.Muscle .. " " .. H.skillName(job.Stat) .. " " .. H.clock(left), Theme.Lighten(PURPLE, 0.3)
	end
	if #H.gardenSlots(home or H.home(), key) > 0 then
		return G.Seedling .. " In Garden", Theme.Lighten(GOOD, 0.3)
	end
	if H.equippedCount(key) > 0 then
		return G.Star .. " Following", GOLD
	end
	return nil, MUTED
end

-- the leftover foods { {Id, Name, Xp, Count} } (biggest XP first)
function H.leftovers()
	local out = {}
	local foods = TycoonCatalog and TycoonCatalog.Foods or {}
	for _, f in ipairs(foods) do
		local ok, n = pcall(State.FoodCount, f.Id)
		n = ok and tonumber(n) or 0
		if n > 0 then
			out[#out + 1] = { Id = f.Id, Name = f.Name or f.Id, Xp = tonumber(f.Xp) or 0, Count = n }
		end
	end
	table.sort(out, function(a, b)
		return a.Xp > b.Xp
	end)
	return out
end

-- the room left below the level cap, in XP
function H.room(level, xp, cap)
	if level >= cap then
		return 0
	end
	local room = 0
	for l = level, cap - 1 do
		local need = H.xpToNext(l)
		if need == math.huge then
			break
		end
		room = room + need
		if room > 1e12 then
			break
		end
	end
	return math.max(0, room - xp)
end

-- What `count` feeds would do (PetCareService.planFeeds, mirrored for display): leftovers first and free (the biggest
-- one that fits the room, else the smallest), then machine feeds priced at the level each one is eaten at. Stops at
-- the cap or when no food is left (machine not built). Returns { Count, Price, Xp, Free, Food, Levels, FirstPrice }.
function H.plan(key, count, untilLevelUp)
	local def = H.def(key)
	local out = { Count = 0, Price = 0, Xp = 0, Free = 0, Levels = 0 }
	if not def then
		return out
	end
	local level, xp = H.level(key)
	local cap = H.cap(def, key)
	local room = H.room(level, xp, cap)
	local machine = H.station(H.home(), "Kitchen")
	local stock = {}
	for _, f in ipairs(H.leftovers()) do
		stock[#stock + 1] = { Id = f.Id, Name = f.Name, Xp = f.Xp, Count = f.Count }
	end
	local lv = level
	for _ = 1, count do
		if room <= 0 then
			break
		end
		local pick, smallest = nil, nil
		for _, f in ipairs(stock) do
			if f.Count > 0 then
				if f.Xp <= room and (not pick or f.Xp > pick.Xp) then
					pick = f
				end
				if not smallest or f.Xp < smallest.Xp then
					smallest = f
				end
			end
		end
		pick = pick or smallest
		local give
		if pick then
			pick.Count = pick.Count - 1
			give = math.min(pick.Xp, room)
			out.Free = out.Free + 1
			out.Food = out.Food or pick
		else
			if machine < 1 then
				break
			end
			local price = H.call(TycoonCatalog, "FeedPrice", def, lv)
			give = H.call(TycoonCatalog, "FeedXp", lv, machine) or 0
			if type(price) ~= "number" or give < 1 then
				break
			end
			give = math.min(give, room)
			out.Price = out.Price + price
			out.FirstPrice = out.FirstPrice or price
		end
		out.Count = out.Count + 1
		out.Xp = out.Xp + give
		room = room - give
		xp = xp + give
		while lv < cap do
			local need = H.xpToNext(lv)
			if need == math.huge or xp < need then
				break
			end
			xp = xp - need
			lv = lv + 1
		end
		if untilLevelUp and lv > level then
			break
		end
	end
	out.Levels = lv - level
	return out
end

-- coins per second of a pet in this home's Garden (PetPower x food x stars / meal x the Lucky EV); a home without a
-- Garden counts the grass food
function H.coinsPerSecond(key, def, home)
	if not TycoonCatalog then
		return 0
	end
	local level = H.level(key)
	local power = H.call(TycoonCatalog, "PetPower", { Def = def, Level = level, Stage = H.stage(key), Key = key }) or 0
	local food = H.call(TycoonCatalog, "FoodOf", home) or 0
	local coins = TycoonCatalog.Coins or {}
	if food <= 0 then
		food = tonumber(coins.GrassFood) or 12
	end
	local stars = math.floor(tonumber(home.Prestige) or 0)
	local mult = H.call(TycoonCatalog, "PrestigeMultiplier", stars) or 1
	local lucky = H.call(TycoonCatalog, "LuckyEV", home) or 1
	local meal = tonumber(coins.MealSeconds) or 8
	return power * food * mult * lucky / meal
end

----------------------------------------------------------------------
-- remotes (each action at most every FIRE_GAP seconds; the server rate-limits as well)
----------------------------------------------------------------------
function H.fire(gapKey, name, ...)
	local now = os.clock()
	if S.Last[gapKey] and now - S.Last[gapKey] < K.FIRE_GAP then
		return false
	end
	local ok, remote = pcall(Remotes.Get, name)
	if not ok or not remote then
		warnOnce("remote " .. name, remote)
		return false
	end
	S.Last[gapKey] = now
	local args = { ... }
	local n = select("#", ...)
	local sent = pcall(function()
		remote:FireServer(unpack(args, 1, n))
	end)
	return sent
end

function H.hint(text, kind)
	-- the server answers every request with a side toast; local refusals use the menu's side hint (never centred)
	local menu = H.controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		pcall(menu.Hint, text, kind or "info")
	end
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

----------------------------------------------------------------------
-- window geometry (the FusionController pattern: one UIScale = min(screen factor, fit))
----------------------------------------------------------------------
function H.guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

function H.viewportHeight()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return H.guiSize().Y
end

function H.fit(prefW, prefH, minW, minH, prefWT, prefHT, minWT, minHT)
	local area = H.guiSize()
	local factor = Theme.ScreenFactor(H.viewportHeight())
	local freeW = area.X - 2 * K.MARGIN
	local freeH = area.Y - 2 * K.MARGIN
	local tall = freeW / factor < K.TALL_W and freeH > freeW
	if tall then
		prefW, prefH, minW, minH = prefWT, prefHT, minWT, minHT
	end
	local w = Util.Clamp(math.floor(freeW / factor), minW, prefW)
	local h = Util.Clamp(math.floor((freeH - K.BUMPS * factor) / factor), minH, prefH)
	local scale = Util.Clamp(math.min(factor, freeW / w, freeH / h), 0.3, 1.25)
	local y = math.min(area.Y / 2 + K.BUMPS * scale / 2, area.Y - K.MARGIN / 2 - h * scale / 2)
	return w, h, scale, area.X / 2, math.max(y, h * scale / 2), tall
end

----------------------------------------------------------------------
-- pet viewports (Low detail, a few per frame)
----------------------------------------------------------------------
function H.queueView(row)
	if row.ViewReady or not row.ViewHolder then
		return
	end
	U.ViewQueue = U.ViewQueue or {}
	if not row.Queued then
		row.Queued = true
		U.ViewQueue[#U.ViewQueue + 1] = row
	end
	if S.Filling then
		return
	end
	S.Filling = true
	task.spawn(function()
		task.wait()
		while S.Open and U.ViewQueue and #U.ViewQueue > 0 do
			local t0 = os.clock()
			local built = 0
			while #U.ViewQueue > 0 and (built == 0 or os.clock() - t0 < K.BUILD_BUDGET) and built < 3 do
				local r = table.remove(U.ViewQueue, 1)
				if r then
					r.Queued = false
				end
				if r and not r.ViewReady and r.ViewHolder and r.ViewHolder.Parent and r.Def then
					r.ViewReady = true
					local stage = H.stage(r.Key)
					r.ViewStage = stage
					local ok, handle = pcall(CloudUI.PetViewport, r.ViewHolder, r.Def, UDim2.new(1, 0, 1, 0), {
						Spin = "sway",
						Detail = "Low",
						Evolved = stage > 0 and stage or nil,
						ZIndex = 4,
					})
					if ok then
						r.View = handle
					end
					built = built + 1
				end
			end
			task.wait()
		end
		S.Filling = false
	end)
end

function H.dropRow(row)
	if row.View then
		pcall(row.View.Destroy)
		row.View = nil
	end
	if row.Frame then
		row.Frame:Destroy()
	end
end

-- the pet disc of a row: a rarity-tinted circle with the viewport inside
function H.petDisc(parent, def, size)
	local color = CloudUI.RarityColor(def and def.Rarity)
	local disc = H.frame(parent, "Pet", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Darken(color, 0.35),
		ZIndex = 3,
	})
	Theme.Corner(disc, UDim.new(0, 14))
	H.stroke(disc, Theme.Lighten(color, 0.1), 3, 0)
	Theme.Gradient(disc, Theme.Lighten(color, 0.05), Theme.Darken(color, 0.45), 90)
	local holder = H.frame(disc, "ViewHolder", { Size = UDim2.new(1, 0, 1, 0), ZIndex = 4 })
	return disc, holder
end

----------------------------------------------------------------------
-- the window
----------------------------------------------------------------------
function H.buildFeedPage(body)
	local page = H.frame(body, "FeedPage", { Size = UDim2.new(1, 0, 1, 0), Visible = false })
	U.FeedPage = page
	U.FeedList = H.scroller(page, "FeedList", { Size = UDim2.new(1, 0, 1, -(K.FOOT_H + 10)) })
	H.pad(U.FeedList, 2, 2, 14, 6)
	H.list(U.FeedList, Enum.FillDirection.Vertical, 8)
	local foot = H.inset(page, "Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, K.FOOT_H),
	})
	U.Foot = foot
	U.Leftovers = H.text(foot, "Leftovers", "", "Heading", 18, Color3.fromRGB(255, 226, 150), {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -220, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.Machine = H.text(foot, "Machine", "", "Body", 19, WHITE, {
		Position = UDim2.fromOffset(14, 36),
		Size = UDim2.new(1, -220, 0, 62),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	U.Upgrade = H.button(foot, "UpgradeMachine", "Upgrade", "Gold", UDim2.fromOffset(190, 54), 21, function()
		H.upgradeMachine()
	end)
	U.Upgrade.AnchorPoint = Vector2.new(1, 0.5)
	U.Upgrade.Position = UDim2.new(1, -12, 0.5, 0)
	U.FeedEmpty = H.text(page, "Empty", "", "Body", 20, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 40),
		Size = UDim2.new(1, -60, 0, 80),
		TextWrapped = true,
		Visible = false,
	})
end

function H.buildGardenPage(body)
	local page = H.frame(body, "GardenPage", { Size = UDim2.new(1, 0, 1, 0), Visible = false })
	U.GardenPage = page
	local head = H.inset(page, "GardenHeader", { Size = UDim2.new(1, 0, 0, 72) })
	U.GardenHead = head
	U.GardenPlace = H.text(head, "Place", "", "Title", 24, WHITE, {
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(1, -220, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	U.GardenNow = H.text(head, "Now", "", "Body", 18, MUTED, {
		Position = UDim2.fromOffset(14, 38),
		Size = UDim2.new(1, -220, 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.TakeOut = H.button(head, "TakeOut", "Take out", "Pink", UDim2.fromOffset(180, 50), 21, function()
		if S.Slot then
			H.fire("garden", "HomeAction", "GardenSet", { Slot = S.Slot })
		end
	end)
	U.TakeOut.AnchorPoint = Vector2.new(1, 0.5)
	U.TakeOut.Position = UDim2.new(1, -12, 0.5, 0)
	U.GardenList = H.scroller(page, "GardenList", { Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 1, -82) })
	H.pad(U.GardenList, 2, 2, 14, 6)
	H.list(U.GardenList, Enum.FillDirection.Vertical, 8)
end

function H.buildTrainPage(body)
	local page = H.frame(body, "TrainPage", { Size = UDim2.new(1, 0, 1, 0), Visible = false })
	U.TrainPage = page
	U.TrainList = H.scroller(page, "TrainList", { Size = UDim2.new(0, K.TRAIN_LIST_W, 1, 0) })
	H.pad(U.TrainList, 2, 2, 12, 6)
	H.list(U.TrainList, Enum.FillDirection.Vertical, 6)
	local right = H.inset(page, "Skills", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(1, -(K.TRAIN_LIST_W + 12), 1, 0),
	})
	U.TrainRight = right
	U.TrainName = H.text(right, "TrainName", "", "Title", 26, WHITE, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.TrainSpots = H.text(right, "Spots", "", "Heading", 18, MUTED, {
		Position = UDim2.fromOffset(14, 42),
		Size = UDim2.new(1, -28, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	-- the running job: a purple timer bar + Stop
	local timer = H.frame(right, "TimerRow", { Position = UDim2.fromOffset(14, 72), Size = UDim2.new(1, -28, 0, 50), Visible = false })
	U.TimerRow = timer
	U.TrainTimer = CloudUI.Bar({
		Name = "TrainTimer",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -150, 0, 34),
		Height = 34,
		TextSize = 19,
		Color = PURPLE,
		Parent = timer,
	})
	U.StopTraining = H.button(timer, "StopTraining", "Stop", "Pink", UDim2.fromOffset(136, 48), 21, function()
		H.askStop(S.TrainKey)
	end)
	U.StopTraining.AnchorPoint = Vector2.new(1, 0.5)
	U.StopTraining.Position = UDim2.new(1, 0, 0.5, 0)
	local skills = H.scroller(right, "SkillList", { Position = UDim2.fromOffset(8, 128), Size = UDim2.new(1, -16, 1, -136) })
	U.SkillList = skills
	H.pad(skills, 4, 2, 12, 6)
	H.list(skills, Enum.FillDirection.Vertical, 8)
	for i, skill in ipairs(SKILLS) do
		local row = { Id = skill.Id, Pips = {} }
		local f = H.inset(skills, "Skill_" .. skill.Id, { Size = UDim2.new(1, 0, 0, K.SKILL_H), LayoutOrder = i })
		row.Frame = f
		row.Name = H.text(f, "Name", skill.Name, "Title", 22, WHITE, {
			Position = UDim2.fromOffset(12, 6),
			Size = UDim2.new(1, -250, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		row.Rank = H.text(f, "Rank", "Rank 0/10", "Heading", 19, GOLD, {
			Position = UDim2.fromOffset(12, 36),
			Size = UDim2.fromOffset(120, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
		})
		local pips = H.frame(f, "RankBar", { Position = UDim2.fromOffset(136, 40), Size = UDim2.fromOffset(200, 16) })
		row.PipRow = pips
		H.list(pips, Enum.FillDirection.Horizontal, 3, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
		for p = 1, 10 do
			local pip = H.frame(pips, "Pip" .. p, {
				Size = UDim2.fromOffset(16, 14),
				BackgroundTransparency = 0,
				BackgroundColor3 = Color3.fromRGB(14, 20, 52),
				LayoutOrder = p,
			})
			H.corner(pip, 3)
			H.stroke(pip, NAVY, 1.5, 0)
			row.Pips[p] = pip
		end
		row.What = H.text(f, "What", skill.Text, "Body", 18, MUTED, {
			Position = UDim2.fromOffset(12, 64),
			Size = UDim2.new(1, -250, 0, 26),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		row.Cost = H.text(f, "Cost", "", "Heading", 18, CASH, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -12, 0, 8),
			Size = UDim2.fromOffset(224, 26),
			TextXAlignment = Enum.TextXAlignment.Right,
			TextTruncate = Enum.TextTruncate.AtEnd,
		})
		row.Button = H.button(f, "Train", "Train", "Green", UDim2.fromOffset(150, 50), 21, function()
			H.askTrain(S.TrainKey, skill.Id)
		end)
		row.Button.AnchorPoint = Vector2.new(1, 1)
		row.Button.Position = UDim2.new(1, -12, 1, -8)
		row.Max = H.pill(f, "Max", "MAX", GOLD, 20, 1)
		row.Max.AnchorPoint = Vector2.new(1, 1)
		row.Max.Position = UDim2.new(1, -12, 1, -14)
		row.Max.Visible = false
		U.Skills[skill.Id] = row
	end
	U.TrainEmpty = H.text(right, "Empty", "", "Body", 20, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -60, 0, 90),
		TextWrapped = true,
		Visible = false,
	})
end

-- the confirm (Evolve / Train / Stop): its own holder above the window, so it also works over the Pets panel
function H.buildConfirm()
	local holder = H.frame(U.Gui, "CareConfirm", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(K.CONFIRM_W, K.CONFIRM_H),
		Visible = false,
		ZIndex = 30,
	})
	U.Confirm = holder
	U.ConfirmFit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	local box = H.frame(holder, "Box", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE, -- the UIGradient multiplies it
		ZIndex = 31,
	})
	H.corner(box, 16)
	U.ConfirmStroke = H.stroke(box, GOLD, 4, 0)
	Theme.Gradient(box, Colors.PanelLight, Colors.Panel, 90)
	U.ConfirmTitle = H.text(box, "Title", "", "Title", 30, GOLD, {
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -32, 0, 40),
		TextScaled = true,
		ZIndex = 32,
	})
	Util.Create("UITextSizeConstraint", { MaxTextSize = 30, MinTextSize = 22, Parent = U.ConfirmTitle })
	U.ConfirmText = H.text(box, "Text", "", "Body", 20, WHITE, {
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 1, -146),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 32,
	})
	local buttons = H.frame(box, "Buttons", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(1, -32, 0, 58),
		ZIndex = 32,
	})
	H.list(buttons, Enum.FillDirection.Horizontal, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	U.ConfirmYes = CloudUI.Button({
		Name = "ConfirmYes",
		Text = "Yes",
		Style = "Gold",
		Size = UDim2.fromOffset(230, 56),
		TextSize = 23,
		LayoutOrder = 1,
		Callback = function()
			local c = S.Confirm
			H.closeConfirm()
			if c and type(c.Yes) == "function" then
				safe("confirm", c.Yes)
			end
		end,
		Parent = buttons,
	})
	U.ConfirmYes.ZIndex = 33
	U.ConfirmNo = CloudUI.Button({
		Name = "ConfirmNo",
		Text = "Not now",
		Style = "Blue",
		Size = UDim2.fromOffset(170, 56),
		TextSize = 22,
		LayoutOrder = 2,
		Callback = function()
			H.closeConfirm()
		end,
		Parent = buttons,
	})
	U.ConfirmNo.ZIndex = 33
end

function H.buildWindow()
	if S.Built then
		return true
	end
	local holder = H.frame(U.Gui, "Window_Care", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(K.PREF_W, K.PREF_H),
		Visible = false,
		ZIndex = 3,
	})
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	local panel = CloudUI.Panel({
		Name = "CarePanel",
		Title = TITLES.Feed,
		Closable = true,
		Accent = ACCENTS.Feed,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			CareController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	-- the info line + the Cash chip
	U.Top = H.frame(content, "Top", { Position = UDim2.fromOffset(12, 8), Size = UDim2.new(1, -24, 0, K.TOP_H) })
	U.Info = H.text(U.Top, "Info", "", "Body", 19, MUTED, {
		Size = UDim2.new(1, -220, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	U.CashChip = H.pill(U.Top, "Cash", "$0", Theme.Darken(CASH, 0.15), 22, 0)
	U.CashChip.AnchorPoint = Vector2.new(1, 0.5)
	U.CashChip.Position = UDim2.new(1, 0, 0.5, 0)
	U.Body = H.frame(content, "Body", {
		Position = UDim2.fromOffset(12, K.TOP_H + 16),
		Size = UDim2.new(1, -24, 1, -(K.TOP_H + 26)),
	})
	H.buildFeedPage(U.Body)
	H.buildGardenPage(U.Body)
	H.buildTrainPage(U.Body)
	S.Built = true
	H.relayout()
	return true
end

----------------------------------------------------------------------
-- rows
----------------------------------------------------------------------
-- the left block of every row: pet disc, name (+ stars), "Lv 12 / 100", where it is
function H.rowHead(f, row, def)
	local disc, holder = H.petDisc(f, def, K.VIEW)
	disc.Position = UDim2.fromOffset(10, 10)
	row.Disc = disc
	row.ViewHolder = holder
	row.Name = H.text(f, "Name", "", "Title", 23, H.rarityText(def), {
		Position = UDim2.fromOffset(K.VIEW + 22, 6),
		Size = UDim2.new(0, 300, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	row.Level = H.text(f, "Level", "", "Heading", 19, WHITE, {
		Position = UDim2.fromOffset(K.VIEW + 22, 38),
		Size = UDim2.fromOffset(140, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	row.Where = H.text(f, "Where", "", "Heading", 18, MUTED, {
		Position = UDim2.fromOffset(K.VIEW + 166, 39),
		Size = UDim2.new(0, 260, 0, 24),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

function H.paintHead(row, key, def, home)
	local level = H.level(key)
	local cap = H.cap(def, key)
	local stage = H.stage(key)
	local stars = H.stars(stage)
	row.Name.Text = H.name(key, def) .. (stars ~= "" and ("  " .. stars) or "")
	row.Level.Text = "Lv " .. level .. " / " .. cap
	row.Level.TextColor3 = level >= cap and GOLD or WHITE
	local where, color = H.whereText(key, home)
	row.Where.Text = where or ""
	row.Where.TextColor3 = color
	return level, cap, stage
end

function H.newFeedRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.inset(U.FeedList, "Feed_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	row.Bar = CloudUI.Bar({
		Name = "XpBar",
		Position = UDim2.fromOffset(K.VIEW + 22, 70),
		Size = UDim2.new(0, 360, 0, 28),
		Height = 28,
		TextSize = 18,
		Color = XP,
		Parent = f,
	})
	local buttons = H.frame(f, "Buttons", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(K.BUTTONS_W, 60),
	})
	row.Buttons = buttons
	H.list(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	row.Feed = H.button(buttons, "Feed", "Feed", "Green", UDim2.fromOffset(240, 58), 20, function()
		H.feed(key, nil)
	end)
	row.Feed.LayoutOrder = 1
	row.LevelUp = H.button(buttons, "LevelUp", "Level up", "Blue", UDim2.fromOffset(178, 58), 20, function()
		H.feed(key, "levelup")
	end)
	row.LevelUp.LayoutOrder = 2
	row.Evolve = H.button(buttons, "Evolve", "EVOLVE!", "Gold", UDim2.fromOffset(122, 58), 20, function()
		CareController.ConfirmEvolve(key)
	end)
	row.Evolve.LayoutOrder = 3
	for _, b in ipairs({ row.Feed, row.LevelUp, row.Evolve }) do
		H.twoLine(b)
	end
	H.layoutFeedRow(row)
	return row
end

function H.layoutFeedRow(row)
	local stacked, short = S.Stacked, S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local h
	if stacked then
		h = short and K.ROW_H_SHORT_STACKED or K.ROW_H_STACKED
		if S.Tall then
			h = h + 22
		end
	else
		h = short and K.ROW_H_SHORT or K.ROW_H
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 128, short and 35 or 39)
	local barY = short and 62 or 70
	if stacked then
		row.Name.Size = UDim2.new(1, -(x + 10), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138), 0, 24)
		if S.Tall then
			-- portrait: "Lv 57 / 100" and where it is get a line each, the bar under them
			row.Where.Position = UDim2.fromOffset(x, 62)
			row.Where.Size = UDim2.new(1, -(x + 10), 0, 24)
			barY = 90
		end
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + 12), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(0.5, 1)
		row.Buttons.Position = UDim2.new(0.5, 0, 1, -8)
		row.Buttons.Size = UDim2.new(1, -20, 0, 60)
	else
		local right = K.BUTTONS_W + 20
		row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
		row.Where.Size = UDim2.new(1, -(x + 138 + right), 0, 24)
		row.Bar.Root.Position = UDim2.fromOffset(x, barY)
		row.Bar.Root.Size = UDim2.new(1, -(x + right), 0, 28)
		row.Buttons.AnchorPoint = Vector2.new(1, 0.5)
		row.Buttons.Position = UDim2.new(1, -10, 0.5, 0)
		row.Buttons.Size = UDim2.fromOffset(K.BUTTONS_W, 60)
	end
	-- stacked rows share the width: Feed 42%, Level up 33%, EVOLVE 25%
	if stacked then
		row.Feed.Size = UDim2.new(0.38, -6, 0, 58)
		row.LevelUp.Size = UDim2.new(0.32, -6, 0, 58)
		row.Evolve.Size = UDim2.new(0.30, -6, 0, 58)
	else
		row.Feed.Size = UDim2.fromOffset(276, 58)
		row.LevelUp.Size = UDim2.fromOffset(190, 58)
		row.Evolve.Size = UDim2.fromOffset(128, 58)
	end
end

function H.paintFeedRow(row, home, cash)
	local key, def = row.Key, row.Def
	local level, cap = H.paintHead(row, key, def, home)
	local _, xp = H.level(key)
	local need = H.xpToNext(level)
	local capped = level >= cap
	if capped then
		row.Bar.SetFraction(1)
		row.Bar.SetText("MAX LEVEL")
		row.Bar.SetColor(GOLD)
	else
		row.Bar.SetFraction(need > 0 and need < math.huge and math.min(1, xp / need) or 0)
		row.Bar.SetText(H.commas(xp) .. " / " .. H.commas(need) .. " XP")
		row.Bar.SetColor(XP)
	end
	local sep = S.Stacked and "\n" or " "
	local one = H.plan(key, 1)
	local machine = H.station(home, "Kitchen")
	local busy = H.inMatch()
	-- Feed: a leftover first (free), else one machine feed
	if capped then
		row.Feed.Text = "Max level"
		CloudUI.SetDisabled(row.Feed, true)
	elseif one.Free > 0 and one.Food then
		local left = 0
		for _, f in ipairs(H.leftovers()) do
			if f.Id == one.Food.Id then
				left = f.Count
			end
		end
		if S.Stacked then
			row.Feed.Text = "Free " .. tostring(one.Food.Name) .. "\n(" .. left .. " left)"
		else
			row.Feed.Text = "Feed (free " .. tostring(one.Food.Name) .. ", " .. left .. " left)"
		end
		CloudUI.SetDisabled(row.Feed, busy)
	elseif machine < 1 then
		row.Feed.Text = "Feed" .. sep .. "(no machine)"
		CloudUI.SetDisabled(row.Feed, true)
	else
		row.Feed.Text = "Feed " .. H.money(one.Price) .. sep .. "(+" .. H.commas(one.Xp) .. " XP)"
		CloudUI.SetDisabled(row.Feed, busy or cash < one.Price)
	end
	-- Level up: as many feeds as the next level needs (at most 10), one request
	local up = H.plan(key, K.MAX_FEEDS, true)
	row.UpCount = up.Count
	if capped or up.Count < 1 or (machine < 1 and up.Free == up.Count and up.Count <= 1) then
		row.LevelUp.Visible = not capped
		row.LevelUp.Text = "Level up"
		CloudUI.SetDisabled(row.LevelUp, true)
	else
		row.LevelUp.Visible = true
		if up.Price > 0 then
			row.LevelUp.Text = "Level up" .. sep .. H.money(up.Price)
		else
			row.LevelUp.Text = "Level up" .. sep .. "(free)"
		end
		CloudUI.SetDisabled(row.LevelUp, busy or cash < (up.FirstPrice or 0))
	end
	-- EVOLVE when ready
	local nextStage = H.canEvolve(key, def, level)
	row.Evolve.Visible = nextStage ~= nil
	row.Evolve.Text = S.Tall and "EVOLVE" or "EVOLVE!"
	row.Ready = nextStage
	CloudUI.SetDisabled(row.Evolve, busy)
	if row.Frame then
		local edge = row.Frame:FindFirstChildOfClass("UIStroke")
		if edge then
			edge.Color = nextStage and GOLD or WELL_EDGE
			edge.Transparency = nextStage and 0 or 0.15
		end
	end
end

function H.newGardenRow(key, def)
	local row = { Key = key, Def = def }
	local f = H.inset(U.GardenList, "Pick_" .. key, { Size = UDim2.new(1, 0, 0, K.ROW_H) })
	row.Frame = f
	H.rowHead(f, row, def)
	local info = H.frame(f, "Info", { Position = UDim2.fromOffset(K.VIEW + 22, 70), Size = UDim2.new(1, -(K.VIEW + 220), 0, 30) })
	row.Info = info
	row.InfoLayout = H.list(info, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	row.InfoLayout.Wraps = true
	local role = type(def.Role) == "string" and def.Role or "Combat"
	local mult = H.call(PetCatalog, "RoleMultiplier", def) or 1
	row.RoleText = role .. (mult > 1.001 and (" x" .. tostring(math.floor(mult * 10 + 0.5) / 10)) or "")
	row.RoleShort = role
	row.Role = H.pill(info, "Role", row.RoleText, ROLE_COLORS[role] or Theme.Buttons.Blue, 18, 1)
	row.Coins = H.pill(info, "Coins", "Coins $0/s", Theme.Darken(CASH, 0.2), 18, 2)
	row.Put = H.button(f, "PutHere", "Put here", "Green", UDim2.fromOffset(170, 56), 21, function()
		if S.Slot then
			H.fire("garden", "HomeAction", "GardenSet", { Slot = S.Slot, Key = key })
		end
	end)
	row.Put.AnchorPoint = Vector2.new(1, 0.5)
	row.Put.Position = UDim2.new(1, -12, 0.5, 0)
	H.layoutSimpleRow(row)
	return row
end

function H.layoutSimpleRow(row)
	local short = S.Short
	local view = short and K.VIEW_SHORT or K.VIEW
	local stacked = S.Tall
	local h = short and K.ROW_H_SHORT or K.ROW_H
	if stacked then
		h = h + 52 + 34 -- the button under the pills, the pills on two lines
	end
	row.Frame.Size = UDim2.new(1, 0, 0, h)
	row.Disc.Size = UDim2.fromOffset(view, view)
	row.Disc.Position = UDim2.fromOffset(10, short and 8 or 10)
	local x = view + 22
	local right = stacked and 10 or 200
	row.Name.Position = UDim2.fromOffset(x, short and 4 or 6)
	row.Name.Size = UDim2.new(1, -(x + right), 0, 30)
	row.Level.Position = UDim2.fromOffset(x, short and 34 or 38)
	row.Where.Position = UDim2.fromOffset(x + 144, short and 35 or 39)
	row.Where.Size = UDim2.new(1, -(x + 154 + right), 0, 24)
	row.Info.Position = UDim2.fromOffset(x, short and 64 or 70)
	row.Info.Size = UDim2.new(1, -(x + right), 0, stacked and 66 or 30)
	if stacked then
		row.Put.AnchorPoint = Vector2.new(1, 1)
		row.Put.Position = UDim2.new(1, -12, 1, -8)
		row.Put.Size = UDim2.fromOffset(170, 48)
	else
		row.Put.AnchorPoint = Vector2.new(1, 0.5)
		row.Put.Position = UDim2.new(1, -12, 0.5, 0)
		row.Put.Size = UDim2.fromOffset(170, 56)
	end
end

function H.paintGardenRow(row, home)
	local key, def = row.Key, row.Def
	H.paintHead(row, key, def, home)
	row.Role.Text = S.Tall and row.RoleShort or row.RoleText
	row.Coins.Text = "Coins " .. H.rate(H.coinsPerSecond(key, def, home)) .. "/s"
	local placed = #H.gardenSlots(home, key)
	local here = S.Slot and type(home.Garden) == "table" and home.Garden[S.Slot] == key
	local free = H.owned(key) - placed
	local training = H.job(key) ~= nil
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	if here then
		row.Put.Text = "Here now"
	elseif training then
		row.Put.Text = "Training"
	elseif free <= 0 then
		row.Put.Text = "In Garden"
	else
		row.Put.Text = "Put here"
	end
	CloudUI.SetDisabled(row.Put, here or training or free <= 0 or H.inMatch() or not S.Slot or S.Slot > open)
	return (here or training or free <= 0) and 1 or 0
end

function H.newTrainRow(key, def)
	local row = { Key = key, Def = def }
	local f = Util.Create("TextButton", {
		Name = "Train_" .. key,
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = INSET,
		BackgroundTransparency = 0.42,
		Size = UDim2.new(1, 0, 0, K.TRAIN_ROW_H),
		Parent = U.TrainList,
	})
	H.corner(f, 12)
	row.Edge = H.stroke(f, WELL_EDGE, 3, 0.15)
	row.Frame = f
	f.Activated:Connect(function()
		S.TrainKey = key
		H.refresh()
	end)
	local disc, holder = H.petDisc(f, def, 64)
	disc.Position = UDim2.fromOffset(8, 10)
	row.Disc = disc
	row.ViewHolder = holder
	row.Name = H.text(f, "Name", "", "Title", 21, H.rarityText(def), {
		Position = UDim2.fromOffset(82, 6),
		Size = UDim2.new(1, -90, 0, 28),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	row.Level = H.text(f, "Level", "", "Heading", 18, WHITE, {
		Position = UDim2.fromOffset(82, 34),
		Size = UDim2.new(1, -90, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	row.Where = H.text(f, "Where", "", "Heading", 18, MUTED, {
		Position = UDim2.fromOffset(82, 56),
		Size = UDim2.new(1, -90, 0, 22),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return row
end

function H.paintTrainRow(row, home)
	H.paintHead(row, row.Key, row.Def, home)
	local selected = row.Key == S.TrainKey
	row.Edge.Color = selected and GOLD or WELL_EDGE
	row.Edge.Transparency = selected and 0 or 0.15
	row.Frame.BackgroundTransparency = selected and 0.2 or 0.42
end

----------------------------------------------------------------------
-- refresh
----------------------------------------------------------------------
-- a keyed list: drop the rows of pets that are gone, add new ones, order the rest
function H.syncRows(map, keys, make)
	local want = {}
	for i, key in ipairs(keys) do
		want[key] = i
	end
	for key, row in pairs(map) do
		if not want[key] then
			H.dropRow(row)
			map[key] = nil
		end
	end
	for i, key in ipairs(keys) do
		local row = map[key]
		if not row then
			local def = H.def(key)
			if def then
				row = make(key, def)
				map[key] = row
			end
		end
		if row then
			row.Frame.LayoutOrder = i
			-- a pet that evolved meanwhile gets its new form
			if row.ViewReady and row.ViewStage ~= H.stage(key) then
				if row.View then
					pcall(row.View.Destroy)
					row.View = nil
				end
				row.ViewReady = false
			end
			H.queueView(row)
		end
	end
end

-- Feed order: garden pets (by place), then followers (equipped order), then the rest (rarest first)
function H.feedOrder(home)
	local keys = H.ownedKeys()
	local rank = {}
	local garden = type(home.Garden) == "table" and home.Garden or {}
	local slots = {}
	for slot in pairs(garden) do
		if type(slot) == "number" then
			slots[#slots + 1] = slot
		end
	end
	table.sort(slots)
	local n = 0
	for _, slot in ipairs(slots) do
		local k = garden[slot]
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	for _, k in ipairs(H.equippedList()) do
		if type(k) == "string" and not rank[k] then
			n = n + 1
			rank[k] = n
		end
	end
	local out = {}
	for i, k in ipairs(keys) do
		out[i] = k
		if not rank[k] then
			rank[k] = 1000 + i
		end
	end
	table.sort(out, function(a, b)
		return rank[a] < rank[b]
	end)
	-- the pet the window was opened for comes first
	if S.Focus then
		for i, k in ipairs(out) do
			if k == S.Focus then
				table.remove(out, i)
				table.insert(out, 1, k)
				break
			end
		end
	end
	return out
end

function H.refreshFeed(home, cash)
	local keys = H.feedOrder(home)
	H.syncRows(U.Rows, keys, H.newFeedRow)
	for _, row in pairs(U.Rows) do
		H.paintFeedRow(row, home, cash)
	end
	U.FeedEmpty.Visible = #keys == 0
	U.FeedEmpty.Text = "No pets yet! Spin a roulette in the Shop to hatch one."
	-- leftovers + the machine line
	local left = H.leftovers()
	if #left > 0 then
		local parts = {}
		for _, f in ipairs(left) do
			parts[#parts + 1] = f.Count .. " " .. tostring(f.Name) .. (f.Count == 1 and "" or "s")
		end
		U.Leftovers.Text = "Leftover food: " .. table.concat(parts, ", ") .. ". Pets eat it first, free!"
	else
		U.Leftovers.Text = "No leftover food: the Food Machine makes every meal."
	end
	local level = H.station(home, "Kitchen")
	local shares = TycoonCatalog and TycoonCatalog.FeedShare or {}
	local def = H.call(TycoonCatalog, "Get", "Kitchen")
	local maxLevel = def and def.MaxLevel or #shares
	local pad = H.kitchenPad(home)
	local pct = function(l)
		return math.floor((tonumber(shares[l]) or 0) * 100 + 0.5) .. "%"
	end
	local text
	if level < 1 then
		text = "Build the Food Machine at home first: each feed then fills " .. pct(1) .. " of a pet's XP bar."
		if pad and not pad.Locked then
			text = text .. " Build it: " .. H.money(pad.Price)
		end
	elseif level >= maxLevel then
		text = "Food Machine Lv " .. level .. " (max): each feed fills " .. pct(level) .. " of the bar."
	else
		text = "Food Machine Lv " .. level .. ": each feed fills " .. pct(level) .. " of the bar."
		if pad and not pad.Locked then
			text = text .. " Upgrade to Lv " .. (level + 1) .. " (" .. pct(level + 1) .. "): " .. H.money(pad.Price)
		elseif pad and pad.Locked then
			text = text .. " Lv " .. (level + 1) .. ": " .. tostring(pad.Locked)
		end
	end
	U.Machine.Text = text
	local canBuy = pad ~= nil and not pad.Locked and level < maxLevel
	U.Upgrade.Visible = canBuy
	U.Upgrade.Text = level < 1 and "Build" or "Upgrade"
	CloudUI.SetDisabled(U.Upgrade, not canBuy or cash < (tonumber(pad and pad.Price) or 0) or not H.hasHome() or H.inMatch())
	U.Info.Text = "Feed your pets for XP. Every level makes them stronger and their coins bigger!"
end

function H.kitchenPad(home)
	for _, p in ipairs(H.call(TycoonCatalog, "AvailablePads", home) or {}) do
		if type(p) == "table" and p.StationId == "Kitchen" then
			return p
		end
	end
	return nil
end

function H.upgradeMachine()
	if H.inMatch() then
		return
	end
	if not H.hasHome() then
		H.hint("Claim a home first: press E at a free gate.", "info")
		return
	end
	H.fire("upgrade", "HomeAction", "Upgrade", "Kitchen")
end

function H.refreshGarden(home)
	local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
	local slot = S.Slot
	local keys = H.ownedKeys()
	H.syncRows(U.GardenRows, keys, H.newGardenRow)
	-- the pets that can go here first (then the busy ones)
	local busy = {}
	for _, row in pairs(U.GardenRows) do
		busy[row.Key] = H.paintGardenRow(row, home)
	end
	local order = {}
	for i, k in ipairs(keys) do
		order[i] = k
	end
	local index = {}
	for i, k in ipairs(keys) do
		index[k] = i
	end
	table.sort(order, function(a, b)
		local x, y = busy[a] or 0, busy[b] or 0
		if x ~= y then
			return x < y
		end
		return index[a] < index[b]
	end)
	for i, k in ipairs(order) do
		if U.GardenRows[k] then
			U.GardenRows[k].Frame.LayoutOrder = i
		end
	end
	local current = slot and type(home.Garden) == "table" and home.Garden[slot] or nil
	U.GardenPlace.Text = slot and ("Garden place " .. slot .. (open > 0 and ("  (" .. open .. " open)") or "")) or "Pet Garden"
	if current and type(current) == "string" then
		U.GardenNow.Text = "Now here: " .. H.name(current) .. ". Pick a pet to swap, or take it out."
	elseif slot and slot > open then
		U.GardenNow.Text = G.Lock .. " This place opens with a Prestige."
	else
		U.GardenNow.Text = "Pick a pet: it eats here and pops out rainbow coins."
	end
	U.TakeOut.Visible = type(current) == "string"
	CloudUI.SetDisabled(U.TakeOut, H.inMatch())
	U.Info.Text = "Every pet can work here. Economy pets make 60% more coins!"
end

function H.refreshTrain(home, cash)
	-- the pets in training first (their timers), then the followers, then the rest (rarest first)
	local keys = H.ownedKeys()
	local rank = {}
	local equipped = {}
	for _, k in ipairs(H.equippedList()) do
		equipped[k] = true
	end
	for i, k in ipairs(keys) do
		rank[k] = (H.job(k) and 0 or (equipped[k] and 1000 or 2000)) + i
	end
	table.sort(keys, function(a, b)
		return rank[a] < rank[b]
	end)
	H.syncRows(U.TrainRows, keys, H.newTrainRow)
	local valid = false
	for _, k in ipairs(keys) do
		if k == S.TrainKey then
			valid = true
		end
	end
	if not valid then
		S.TrainKey = keys[1]
		-- prefer a pet that is training (its timer), else the first follower
		for _, k in ipairs(keys) do
			if H.job(k) then
				S.TrainKey = k
				break
			end
		end
	end
	for _, row in pairs(U.TrainRows) do
		H.paintTrainRow(row, home)
	end
	local level = H.station(home, "Gym")
	local slots = H.call(TycoonCatalog, "TrainingSlots", home) or 0
	local busyCount = 0
	for _, k in ipairs(keys) do
		if H.job(k) then
			busyCount = busyCount + 1
		end
	end
	-- (a job can also belong to a pet copy no longer in the list: count the growth map)
	local okMap, map = pcall(State.PetGrowthMap)
	if okMap and type(map) == "table" then
		local n = 0
		for _, e in pairs(map) do
			if type(e) == "table" and type(e.Job) == "table" then
				n = n + 1
			end
		end
		busyCount = math.max(busyCount, n)
	end
	local key = S.TrainKey
	local def = key and H.def(key)
	local hasPet = def ~= nil
	U.TrainEmpty.Visible = not hasPet
	U.TrainEmpty.Text = "No pets yet! Spin a roulette in the Shop to hatch one."
	U.TrainName.Visible = hasPet
	U.TrainSpots.Visible = hasPet
	U.SkillList.Visible = hasPet
	if level < 1 then
		U.Info.Text = "Build the Training Place at home first. Training makes pets tougher in battles!"
	else
		U.Info.Text = "Train a skill: Rank 3 takes 3 minutes. Training pets rest at home until they're done!"
	end
	if not hasPet then
		U.TimerRow.Visible = false
		return
	end
	local stage = H.stage(key)
	local lv = H.level(key)
	U.TrainName.Text = H.name(key, def) .. "  " .. G.Bullet .. "  Lv " .. lv .. " / " .. H.cap(def, key) .. (stage > 0 and ("  " .. H.stars(stage)) or "")
	U.TrainName.TextColor3 = H.rarityText(def)
	if level < 1 then
		U.TrainSpots.Text = G.Lock .. " No Training Place yet"
	else
		U.TrainSpots.Text = "Training spots: " .. busyCount .. " / " .. slots .. " in use"
	end
	local job = H.job(key)
	U.TimerRow.Visible = job ~= nil
	local g = H.growth(key)
	if job then
		local total = tonumber(H.call(TycoonCatalog, "TrainSeconds", job.Rank)) or 60
		local left = math.max(0, (tonumber(job.Ends) or 0) - H.now())
		U.TrainTimer.SetFraction(total > 0 and math.min(1, 1 - left / total) or 1)
		if S.Tall then
			U.TrainTimer.SetText("Rank " .. tostring(job.Rank) .. ": " .. H.clock(left) .. " left")
		else
			U.TrainTimer.SetText(H.skillName(job.Stat) .. " Rank " .. tostring(job.Rank) .. ": " .. H.clock(left) .. " left")
		end
	end
	local top = S.Short and 44 or 72
	U.TimerRow.Position = UDim2.fromOffset(14, top)
	if job then
		top = top + 56
	end
	U.SkillList.Position = UDim2.fromOffset(8, top + 2)
	U.SkillList.Size = UDim2.new(1, -16, 1, -(top + 10))
	CloudUI.SetDisabled(U.StopTraining, H.inMatch())
	U.TrainSpots.Visible = not S.Short
	local maxRank = (TycoonCatalog and TycoonCatalog.Training and TycoonCatalog.Training.MaxRank) or 10
	for _, skill in ipairs(SKILLS) do
		local row = U.Skills[skill.Id]
		local rank = math.max(0, math.floor(tonumber(g[skill.Id]) or 0))
		row.Rank.Text = "Rank " .. rank .. "/" .. maxRank
		for p, pip in ipairs(row.Pips) do
			if p <= rank then
				pip.BackgroundColor3 = Theme.Lighten(ACCENTS.Train, 0.25)
			elseif job and job.Stat == skill.Id and p == rank + 1 then
				pip.BackgroundColor3 = PURPLE
			else
				pip.BackgroundColor3 = Color3.fromRGB(14, 20, 52)
			end
		end
		local maxed = rank >= maxRank
		row.Max.Visible = maxed
		row.Button.Visible = not maxed
		if maxed then
			row.Cost.Text = ""
		else
			local cost = H.call(TycoonCatalog, "TrainCost", def, rank + 1) or 0
			local seconds = H.call(TycoonCatalog, "TrainSeconds", rank + 1) or 60
			row.Cost.Text = "Rank " .. (rank + 1) .. ": " .. H.money(cost) .. ", " .. H.minutes(seconds)
			row.Cost.TextColor3 = cash < cost and Theme.Lighten(BAD, 0.35) or CASH
			row.Price = cost
			local reason = nil
			if job then
				reason = "busy"
			elseif level < 1 then
				reason = "no station"
			elseif busyCount >= slots then
				reason = "full"
			elseif cash < cost then
				reason = "cash"
			end
			row.Button.Text = (job and job.Stat == skill.Id) and "Training" or "Train"
			CloudUI.SetDisabled(row.Button, reason ~= nil or H.inMatch())
		end
	end
end

function H.refresh()
	if not S.Built then
		return
	end
	local home = H.home()
	local cash = H.cash()
	U.CashChip.Text = H.money(cash)
	U.FeedPage.Visible = S.Mode == "Feed"
	U.GardenPage.Visible = S.Mode == "Garden"
	U.TrainPage.Visible = S.Mode == "Train"
	if S.Mode == "Feed" then
		H.refreshFeed(home, cash)
	elseif S.Mode == "Garden" then
		H.refreshGarden(home)
	elseif S.Mode == "Train" then
		H.refreshTrain(home, cash)
	end
end

-- State.Changed can come in bursts: one refresh per frame at most
function H.refreshSoon()
	if S.RefreshPending then
		return
	end
	S.RefreshPending = true
	task.defer(function()
		S.RefreshPending = false
		if S.Open then
			safe("refresh", H.refresh)
		end
	end)
end

function H.relayout()
	if not S.Built then
		return
	end
	local w, h, scale, x, y, tall = H.fit(K.PREF_W, K.PREF_H, K.MIN_W, K.MIN_H, K.PREF_W_TALL, K.PREF_H_TALL, K.MIN_W_TALL, K.MIN_H_TALL)
	U.Holder.Size = UDim2.fromOffset(w, h)
	U.Fit.Scale = scale
	U.Holder.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	local short = h < K.SHORT and not tall
	local stacked = tall or (w - 48) < K.WIDE
	local changed = short ~= S.Short or stacked ~= S.Stacked or tall ~= S.Tall
	S.Short, S.Stacked, S.Tall = short, stacked, tall
	-- landscape phones: no info line (the list needs the height); portrait: no Cash chip (the info line wraps)
	local topH = short and 0 or K.TOP_H
	U.Top.Visible = not short
	U.Top.Size = UDim2.new(1, -24, 0, topH)
	U.Top.Position = UDim2.fromOffset(12, 8)
	U.CashChip.Visible = not tall
	U.Info.Size = tall and UDim2.new(1, 0, 1, 0) or UDim2.new(1, -220, 1, 0)
	U.Body.Position = UDim2.fromOffset(12, topH + (short and 8 or 16))
	U.Body.Size = UDim2.new(1, -24, 1, -(topH + (short and 16 or 26)))
	-- feed footer
	local footH = short and K.FOOT_H_SHORT or K.FOOT_H
	if tall then
		footH = 150
	end
	U.Foot.Size = UDim2.new(1, 0, 0, footH)
	U.FeedList.Size = UDim2.new(1, 0, 1, -(footH + 10))
	if tall then
		U.Leftovers.Size = UDim2.new(1, -28, 0, 46)
		U.Leftovers.TextWrapped = true
		U.Leftovers.TextYAlignment = Enum.TextYAlignment.Top
		U.Machine.Size = UDim2.new(1, -28, 0, 50)
		U.Machine.Position = UDim2.fromOffset(14, 54)
		U.Upgrade.AnchorPoint = Vector2.new(1, 1)
		U.Upgrade.Position = UDim2.new(1, -12, 1, -8)
		U.Upgrade.Size = UDim2.fromOffset(170, 46)
	else
		U.Leftovers.TextWrapped = false
		U.Leftovers.Size = UDim2.new(1, -220, 0, 26)
		U.Machine.Size = UDim2.new(1, -220, 0, footH - 44)
		U.Machine.Position = UDim2.fromOffset(14, short and 30 or 36)
		U.Upgrade.AnchorPoint = Vector2.new(1, 0.5)
		U.Upgrade.Position = UDim2.new(1, -12, 0.5, 0)
		U.Upgrade.Size = UDim2.fromOffset(190, short and 48 or 54)
	end
	-- train: one column on portrait screens (the pets on top)
	if tall then
		U.TrainList.Size = UDim2.new(1, 0, 0.36, -6)
		U.TrainRight.AnchorPoint = Vector2.new(0, 1)
		U.TrainRight.Position = UDim2.new(0, 0, 1, 0)
		U.TrainRight.Size = UDim2.new(1, 0, 0.64, -6)
	else
		local listW = (w < 900) and 300 or K.TRAIN_LIST_W
		U.TrainList.Size = UDim2.new(0, listW, 1, 0)
		U.TrainRight.AnchorPoint = Vector2.new(1, 0)
		U.TrainRight.Position = UDim2.new(1, 0, 0, 0)
		U.TrainRight.Size = UDim2.new(1, -(listW + 12), 1, 0)
	end
	local skillH = short and K.SKILL_H_SHORT or K.SKILL_H
	for _, row in pairs(U.Skills) do
		row.Frame.Size = UDim2.new(1, 0, 0, tall and (skillH + 40) or skillH)
		if tall then
			row.Cost.AnchorPoint = Vector2.new(0, 1)
			row.Cost.Position = UDim2.new(0, 12, 1, -14)
			row.Cost.TextXAlignment = Enum.TextXAlignment.Left
			row.Name.Size = UDim2.new(1, -24, 0, 28)
			row.What.Size = UDim2.new(1, -24, 0, 26)
			row.Button.Size = UDim2.fromOffset(130, 46)
		else
			row.Cost.AnchorPoint = Vector2.new(1, 0)
			row.Cost.Position = UDim2.new(1, -12, 0, 8)
			row.Cost.TextXAlignment = Enum.TextXAlignment.Right
			row.Name.Size = UDim2.new(1, -250, 0, 28)
			row.What.Size = UDim2.new(1, -250, 0, 26)
			row.Button.Size = UDim2.fromOffset(150, short and 44 or 50)
		end
		row.What.Visible = not short or tall
	end
	-- the garden header
	U.GardenHead.Size = UDim2.new(1, 0, 0, tall and 118 or 72)
	U.GardenList.Position = UDim2.fromOffset(0, tall and 128 or 82)
	U.GardenList.Size = UDim2.new(1, 0, 1, -(tall and 128 or 82))
	U.GardenPlace.Size = UDim2.new(1, tall and -28 or -220, 0, 30)
	U.GardenNow.Size = UDim2.new(1, tall and -28 or -220, 0, tall and 48 or 26)
	U.GardenNow.TextWrapped = tall
	U.GardenNow.TextYAlignment = Enum.TextYAlignment.Top
	if tall then
		U.TakeOut.AnchorPoint = Vector2.new(1, 1)
		U.TakeOut.Position = UDim2.new(1, -12, 1, -8)
		U.TakeOut.Size = UDim2.fromOffset(160, 44)
	else
		U.TakeOut.AnchorPoint = Vector2.new(1, 0.5)
		U.TakeOut.Position = UDim2.new(1, -12, 0.5, 0)
		U.TakeOut.Size = UDim2.fromOffset(180, 50)
	end
	if changed then
		for _, row in pairs(U.Rows) do
			H.layoutFeedRow(row)
		end
		for _, row in pairs(U.GardenRows) do
			H.layoutSimpleRow(row)
		end
		if S.Open then
			H.refreshSoon()
		end
	end
	H.relayoutConfirm()
end

function H.relayoutConfirm()
	if not U.Confirm then
		return
	end
	local w, h, scale, x, y = H.fit(K.CONFIRM_W, K.CONFIRM_H, 440, 250, 460, K.CONFIRM_H, 440, 250)
	U.Confirm.Size = UDim2.fromOffset(w, h)
	U.ConfirmFit.Scale = scale
	U.Confirm.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
end

----------------------------------------------------------------------
-- actions
----------------------------------------------------------------------
function H.feed(key, how)
	if H.inMatch() then
		H.hint("Pets eat at home, after the match.", "info")
		return
	end
	if how == "levelup" then
		local row = U.Rows[key]
		local count = row and row.UpCount or H.plan(key, K.MAX_FEEDS, true).Count
		count = math.max(1, math.min(K.MAX_FEEDS, math.floor(count or 1)))
		H.fire("feed:" .. key, "PetCare", "Feed", key, { Count = count })
	else
		H.fire("feed:" .. key, "PetCare", "Feed", key, nil)
	end
end

function H.showConfirm(spec)
	if not U.Confirm then
		return
	end
	S.Confirm = spec
	U.ConfirmTitle.Text = spec.Title or ""
	U.ConfirmText.Text = spec.Text or ""
	U.ConfirmYes.Text = spec.Yes and (spec.YesText or "Yes") or "OK"
	CloudUI.SetStyle(U.ConfirmYes, spec.Style or "Gold")
	U.ConfirmStroke.Color = spec.Color or GOLD
	U.ConfirmTitle.TextColor3 = spec.Color or GOLD
	U.ConfirmNo.Text = spec.NoText or "Not now"
	H.relayoutConfirm()
	U.Confirm.Visible = true
	U.Backdrop.Visible = true
	U.Backdrop.BackgroundTransparency = 0.55
	local pop = U.Confirm:FindFirstChild("Pop") or Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = U.Confirm:FindFirstChild("Box") })
	pop.Scale = 0.9
	H.tween(pop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	H.syncBack()
end

function H.closeConfirm()
	S.Confirm = nil
	if U.Confirm then
		U.Confirm.Visible = false
	end
	if not S.Open and U.Backdrop then
		U.Backdrop.Visible = false
		U.Backdrop.BackgroundTransparency = 1
	end
	H.syncBack()
end

function H.askTrain(key, stat)
	local def = key and H.def(key)
	if not def then
		return
	end
	if H.inMatch() then
		return
	end
	local g = H.growth(key)
	local rank = math.max(0, math.floor(tonumber(g[stat]) or 0)) + 1
	local cost = H.call(TycoonCatalog, "TrainCost", def, rank) or 0
	local seconds = H.call(TycoonCatalog, "TrainSeconds", rank) or 60
	local name = H.name(key, def)
	H.showConfirm({
		Kind = "Train",
		Title = G.Muscle .. " Train " .. H.skillName(stat) .. "?",
		Text = name .. " goes to Rank " .. rank .. " " .. H.skillName(stat) .. " for " .. H.money(cost) .. ". It takes "
			.. H.minutes(seconds) .. ". " .. name .. " rests at home until it's done, then comes back by itself.",
		YesText = "Train " .. H.money(cost),
		Style = "Green",
		Color = Theme.Lighten(GOOD, 0.2),
		Yes = function()
			H.fire("train", "PetCare", "Train", key, stat)
		end,
	})
end

-- the Cash a Stop gives back: the job's Paid (0 after a Prestige)
function H.paidOf(key)
	local job = H.job(key)
	return type(job) == "table" and tonumber(job.Paid) or 0
end

function H.askStop(key)
	local def = key and H.def(key)
	if not def or not H.job(key) then
		return
	end
	H.showConfirm({
		Kind = "Stop",
		Title = "Stop training?",
		Text = (H.paidOf(key) > 0 and "You get the Cash back, no rank. " or "No rank and no Cash back (it was paid before your Prestige). ")
			.. H.name(key, def) .. " comes back to you right away.",
		YesText = "Stop training",
		NoText = "Keep training",
		Style = "Pink",
		Color = Color3.fromRGB(255, 160, 200),
		Yes = function()
			H.fire("trainstop", "PetCare", "TrainStop", key)
		end,
	})
end

----------------------------------------------------------------------
-- the evolution moment (contract 3.6)
----------------------------------------------------------------------
function H.playerFrame()
	local char = LocalPlayer and LocalPlayer.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

function H.groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = {}
	if char then
		ignore[#ignore + 1] = char
	end
	if U.EvoFolder then
		ignore[#ignore + 1] = U.EvoFolder
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- lowest point of a built pet below its root
function H.bottomOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or Vector3.new()
	return rel.Y - size.Y / 2
end

function H.evoFolder()
	if U.EvoFolder and U.EvoFolder.Parent then
		return U.EvoFolder
	end
	local f = Instance.new("Folder")
	f.Name = K.EVO_FOLDER
	f.Parent = Workspace
	U.EvoFolder = f
	return f
end

function H.closeAll()
	CareController.Close()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function H.playEvolution(key, stage)
	local def = H.def(key)
	local PetBuilder = safeRequire("PetBuilder")
	local Fx = H.controller("EvolutionFx")
	local PC = H.controller("PetController")
	stage = math.max(1, math.min(2, math.floor(tonumber(stage) or 1)))
	H.closeAll()
	local fxSeconds = (Fx and H.call(Fx, "Duration", stage)) or 4.6
	local release = function() end
	if PC and type(PC.PlayEvolution) == "function" then
		local ok, fn = pcall(PC.PlayEvolution, key, stage, { Seconds = fxSeconds + K.EVO_REST + 1 })
		if ok and type(fn) == "function" then
			release = fn
		end
	end
	if not (def and PetBuilder and Fx and type(Fx.Play) == "function") then
		release()
		return false
	end
	local okA, fromModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = (stage - 1 > 0) and (stage - 1) or nil })
	local okB, toModel = pcall(PetBuilder.Build, def, { Detail = K.EVO_DETAIL, Evolved = stage })
	if not (okA and okB and typeof(fromModel) == "Instance" and typeof(toModel) == "Instance" and fromModel.PrimaryPart and toModel.PrimaryPart) then
		release()
		return false
	end
	fromModel.Name = "Evolving_" .. tostring(def.Id)
	toModel.Name = "Evolved_" .. tostring(def.Id)
	local origin, look, char = H.playerFrame()
	local spot = Vector3.new(origin.X, 0, origin.Z) + look * K.EVO_AHEAD
	local ground = H.groundAt(Vector3.new(spot.X, origin.Y + 4, spot.Z), char, origin.Y - 3)
	local pos = Vector3.new(spot.X, ground + K.EVO_HOVER - H.bottomOf(fromModel), spot.Z)
	local pose = CFrame.lookAt(pos, pos - look) -- facing the player
	local folder = H.evoFolder()
	fromModel.Parent = folder
	local okColors, c1, c2 = pcall(PetBuilder.EvolutionColors, def, stage)
	S.Evolving = S.Evolving + 1
	local finished = false
	local function done(model)
		if finished then
			return
		end
		finished = true
		task.delay(K.EVO_REST, function()
			local at = nil
			if typeof(model) == "Instance" and model.PrimaryPart then
				at = model.PrimaryPart.Position
			end
			pcall(release, at)
			if typeof(model) == "Instance" then
				pcall(function()
					model:Destroy()
				end)
			end
			S.Evolving = math.max(0, S.Evolving - 1)
			H.nextEvolution()
		end)
	end
	local okPlay, handle = pcall(Fx.Play, fromModel, toModel, pose, {
		Parent = folder,
		Colors = okColors and { c1, c2 } or nil,
		Stage = stage,
		Ground = ground,
		Confetti = true,
		OnDone = done,
	})
	if not okPlay or type(handle) ~= "table" or handle.Done then
		pcall(function()
			fromModel:Destroy()
			toModel:Destroy()
		end)
		finished = true
		S.Evolving = math.max(0, S.Evolving - 1)
		release()
		return false
	end
	U.EvoHandle = handle
	return true
end

function H.nextEvolution()
	if S.Evolving > 0 then
		return
	end
	local nextOne = table.remove(S.EvoQueue, 1)
	if nextOne then
		safe("evolve", H.playEvolution, nextOne.Key, nextOne.Stage)
	end
end

----------------------------------------------------------------------
-- open / close
----------------------------------------------------------------------
function H.setBackdrop(on)
	local b = U.Backdrop
	if not b then
		return
	end
	if on then
		b.Visible = true
		H.tween(b, 0.18, { BackgroundTransparency = 0.55 })
	else
		H.tween(b, 0.15, { BackgroundTransparency = 1 })
		local mine = S.Token
		task.delay(0.17, function()
			if S.Token == mine and not S.Open and not S.Confirm and b.Parent then
				b.Visible = false
			end
		end)
	end
end

-- gamepad B closes the confirm / the window while one is up (bound only then, so it never eats the dash)
function H.syncBack()
	local want = S.Open or S.Confirm ~= nil
	local ContextActionService = game:GetService("ContextActionService")
	if want and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					if S.Confirm then
						H.closeConfirm()
					else
						CareController.Close()
					end
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	elseif not want and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function H.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function CareController.IsOpen()
	return S.Open or S.Confirm ~= nil
end

function CareController.Mode()
	return S.Open and S.Mode or nil
end

function CareController.Evolving()
	return S.Evolving
end

function CareController.FeedPlan(key, count)
	if count == "levelup" then
		return H.plan(key, K.MAX_FEEDS, true)
	end
	return H.plan(key, math.max(1, math.min(K.MAX_FEEDS, math.floor(tonumber(count) or 1))))
end

-- the EVOLVE confirm ("Evolve Pebble Pup? +25% to everything") -> PetCare("Evolve", key)
function CareController.ConfirmEvolve(key)
	if not initialized then
		CareController.Init()
	end
	local def = H.def(key)
	if not def or not U.Gui then
		return false
	end
	if H.inMatch() then
		return false
	end
	local level = H.level(key)
	local nextStage = H.canEvolve(key, def, level)
	local name = H.name(key, def)
	if not nextStage then
		local levels = PetCatalog.EvolutionLevels or { 20, 50 }
		local stage = H.stage(key)
		local maxStage = H.call(PetCatalog, "MaxEvolution", def) or 1
		local text
		if stage >= maxStage then
			text = name .. " is fully evolved!"
		else
			text = name .. " evolves at level " .. tostring(levels[stage + 1] or 20) .. " (Lv " .. level .. " now)."
		end
		H.hint(text, "info")
		return false
	end
	local boosts = PetCatalog.EvolutionBoost or { 1.25, 1.5 }
	local pct = math.floor(((tonumber(boosts[nextStage]) or 1.25) - 1) * 100 + 0.5)
	H.showConfirm({
		Kind = "Evolve",
		Key = key,
		Title = G.Sparkle .. " Evolve " .. name .. "?",
		Text = name .. " changes into its " .. (nextStage == 2 and "Evolved II" or "Evolved") .. " form: +" .. pct
			.. "% to everything (battle power, health and coins). It keeps its level.",
		YesText = "EVOLVE!",
		Style = "Gold",
		Color = GOLD,
		Yes = function()
			H.fire("evolve", "PetCare", "Evolve", key)
		end,
	})
	return true
end

function CareController.Open(panelId, args)
	if not initialized then
		CareController.Init()
	end
	if not U.Gui then
		return false
	end
	args = type(args) == "table" and args or {}
	local id = type(panelId) == "string" and panelId:lower() or ""
	if id == "evolve" then
		if type(args.Key) ~= "string" then
			return false
		end
		if S.Evolving > 0 then
			S.EvoQueue[#S.EvoQueue + 1] = { Key = args.Key, Stage = args.Stage }
			return true
		end
		local ok, played = safe("evolve", H.playEvolution, args.Key, args.Stage)
		return ok and played == true
	end
	local mode = (id == "feed" and "Feed") or (id == "garden" and "Garden") or ((id == "train" or id == "training") and "Train") or nil
	if not mode then
		return false
	end
	if H.inMatch() then
		return false
	end
	if not H.buildWindow() then
		return false
	end
	if mode == "Feed" then
		S.Focus = type(args.Key) == "string" and args.Key or nil
	elseif mode == "Garden" then
		local slot = tonumber(args.Slot)
		S.Slot = (slot and slot == math.floor(slot) and slot >= 1) and slot or nil
		if not S.Slot then
			-- no place given: the first open empty one
			local home = H.home()
			local open = H.call(TycoonCatalog, "GardenSlots", home) or 0
			for s = 1, open do
				if type(home.Garden) ~= "table" or home.Garden[s] == nil then
					S.Slot = s
					break
				end
			end
			S.Slot = S.Slot or 1
		end
	elseif mode == "Train" then
		if type(args.Key) == "string" then
			S.TrainKey = args.Key
		end
	end
	local wasOpen = S.Open
	if not wasOpen then
		H.closeOthers()
	end
	if mode ~= S.Mode then
		-- a fresh list order for the new window (the viewports are kept per row)
		if U.FeedList then
			U.FeedList.CanvasPosition = Vector2.new(0, 0)
		end
	end
	S.Mode = mode
	S.Open = true
	S.Token = S.Token + 1
	U.Panel.SetTitle(TITLES[mode])
	if U.Panel.SetAccent then
		pcall(U.Panel.SetAccent, ACCENTS[mode])
	end
	H.relayout()
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 0.86
		H.tween(U.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		H.setBackdrop(true)
	end
	safe("refresh", H.refresh)
	H.syncBack()
	-- timers tick while the window is open
	local mine = S.Token
	task.spawn(function()
		while S.Open and S.Token == mine do
			task.wait(K.TICK)
			if S.Open and S.Token == mine and (S.Mode == "Train" or S.Mode == "Feed" or S.Mode == "Garden") then
				safe("tick", H.refresh)
			end
		end
	end)
	CareController.Opened:Fire(mode)
	return true
end

function CareController.Close()
	if S.Confirm then
		H.closeConfirm()
	end
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	H.syncBack()
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	H.setBackdrop(false)
	CareController.Closed:Fire()
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function H.onPrompt(prompt)
	if typeof(prompt) ~= "Instance" or prompt.Name ~= "GardenSpotPrompt" then
		return
	end
	local owner = prompt:GetAttribute("OwnerUserId")
	if owner ~= nil and LocalPlayer and owner ~= LocalPlayer.UserId then
		return -- someone else's garden (HomeFx hides those prompts anyway)
	end
	CareController.Open("Garden", { Slot = prompt:GetAttribute("Slot") })
end

function H.onOpenPanel(panelId, args)
	if type(panelId) ~= "string" then
		return
	end
	args = type(args) == "table" and args or {}
	local id = panelId:lower()
	if id == "train" or id == "training" or id == "evolve" then
		CareController.Open(panelId, args)
	elseif id == "feed" then
		CareController.Open("Feed", args)
	elseif id == "pets" and (args.Action == "Feed" or args.Action == "Garden") then
		CareController.Open(args.Action, args)
	end
end

function H.connectOthers()
	local function hook(name, signalName)
		local mod = H.controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				CareController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
end

function CareController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusCare", K.DISPLAY_ORDER)
	U.Backdrop = Util.Create("TextButton", {
		Name = "Backdrop",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(8, 12, 32),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 1,
		Parent = U.Gui,
	})
	U.Backdrop.Activated:Connect(function()
		if S.Confirm then
			H.closeConfirm()
		else
			CareController.Close()
		end
	end)
	H.buildConfirm()
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", H.relayout)
		safe("relayout confirm", H.relayoutConfirm)
	end)
	State.Changed:Connect(function()
		if S.Open then
			H.refreshSoon()
		end
	end)
	if type(State.CashChanged) == "table" and type(State.CashChanged.Connect) == "function" then
		State.CashChanged:Connect(function()
			if S.Open then
				H.refreshSoon()
			end
		end)
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				CareController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape then
			if S.Confirm then
				H.closeConfirm()
			elseif S.Open then
				CareController.Close()
			end
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", H.onPrompt, prompt)
	end)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "OpenPanel")
		if ok and remote then
			remote.OnClientEvent:Connect(function(panelId, args)
				safe("OpenPanel", H.onOpenPanel, panelId, args)
			end)
		end
	end)
	task.defer(function()
		safe("connect", H.connectOthers)
	end)
end

return CareController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">DamageFx</string>
              <string name="Source"><![CDATA[-- DamageFx (client, v2): everything the player sees and feels when they get hurt (or get paid).
--
--   DamageFx.Init()
--
-- What it does
--   * Remotes.DamageTaken(amount, kind): a SUBTLE coloured vignette on the screen EDGES only (four gradient
--     strips, no images; the middle of the screen stays clear), a short camera shake, and a small floating
--     "-12" number with a kind word ("ZAP!") that pops, rises and fades above the local player's head.
--   * Storm damage arrives four times a second, so it is merged into one gentle number every
--     STORM_INTERVAL seconds instead of spamming the screen.
--   * The MatchTokens player attribute going up pops a golden "+n ☁" above the head (golden tokens get a
--     bigger, paler pop).
--
-- Colours follow the calmer v2 palette: nothing flashes white, the lightning flash is a faint warm wash.
-- v3 readability rule: the floating texts are sized with Theme.ScaledSize (1080p sizes scaled by the screen
-- height, never below 14 px) and carry a thick glyph outline, so they read over sky, clouds and grass alike.
--
-- Camera shake
--   The shake is driven through Humanoid.CameraOffset by a RenderStepped connection that exists only
--   while there is shake left. Whenever the shake ends, the character goes away or the humanoid
--   changes, CameraOffset is put back to zero, so the camera can never stay displaced.
--
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DamageFx = {}

local LocalPlayer = Players.LocalPlayer
local ATTR = Config.Attr

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local STORM_INTERVAL = 0.6 -- seconds between merged storm damage numbers
local MAX_LIVE_FLOATS = 12 -- hard cap on simultaneous floating texts

local SHAKE_MAX = 0.8 -- studs of camera offset at full trauma
local SHAKE_DECAY = 2.6 -- trauma lost per second
local SHAKE_SPEED = 1.0 -- multiplier for the shake oscillation speed

-- 1080p design sizes of the floating texts (scaled per screen by Theme.ScaledSize)
local FLOAT_W = 260
local FLOAT_H = 120
local NUMBER_SIZE = 40
local NUMBER_SIZE_BIG = 48 -- hits of 25+
local WORD_SIZE = 24
local TOKEN_SIZE = 34
local TOKEN_SIZE_GOLDEN = 42

local Colors = Theme.Colors

-- Per damage kind: the word, the number colour, the vignette colour and how hard it shakes.
-- (All kinds of Config.Damage.Kinds are covered; anything unknown falls back to Other.)
local KIND_STYLE = {
	Void = {
		Word = "SPLASH",
		Color = Color3.fromRGB(190, 168, 242),
		Vignette = Color3.fromRGB(120, 88, 214),
		Shake = 0.5,
	},
	Lightning = {
		Word = "ZAP!",
		Color = Color3.fromRGB(244, 226, 134),
		Vignette = Color3.fromRGB(226, 196, 84),
		Shake = 0.8,
		Flash = true,
	},
	SpinBar = {
		Word = "WHACK!",
		Color = Color3.fromRGB(240, 156, 112),
		Vignette = Color3.fromRGB(214, 84, 76),
		Shake = 0.6,
	},
	Pendulum = {
		Word = "BONK!",
		Color = Color3.fromRGB(236, 170, 120),
		Vignette = Color3.fromRGB(206, 100, 80),
		Shake = 0.6,
	},
	Storm = {
		Word = "DRIZZLE",
		Color = Color3.fromRGB(150, 192, 238),
		Vignette = Color3.fromRGB(80, 118, 196),
		Shake = 0.1,
		Soft = true,
	},
	Other = {
		Word = "OOF!",
		Color = Colors.Bad,
		Vignette = Color3.fromRGB(204, 72, 92),
		Shake = 0.4,
	},
}

-- Smooth falloff for the vignette strips (strongest at the screen edge, clear towards the middle).
local VIGNETTE_FALLOFF = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.4, 0.6),
	NumberSequenceKeypoint.new(0.75, 0.9),
	NumberSequenceKeypoint.new(1, 1),
})

-- rotation: UIGradient offset 0 sits at the screen edge. 90 = top edge, -90 = bottom, 0 = left, 180 = right.
-- The strips are narrow: only the outer fifth of the screen is ever tinted.
local EDGE_DEFS = {
	{ Name = "Top", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.22), Rotation = 90 },
	{ Name = "Bottom", Anchor = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.22), Rotation = -90 },
	{ Name = "Left", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 0 },
	{ Name = "Right", Anchor = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 180 },
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local rng = Random.new()

local vignette = nil -- { holder, edges, tweens, flash, flashTween, token }
local liveFloats = 0

local shake = { trauma = 0, clock = 0, conn = nil, humanoid = nil, px = 0, py = 0 }

local stormAccum = 0
local stormLastShow = -10
local stormScheduled = false

local lastMatchTokens = 0

----------------------------------------------------------------------
-- Screen vignette
----------------------------------------------------------------------
local function buildScreenGui()
	local gui = CloudUI.NewScreenGui("NimbusDamageFx", 5) -- below the HUD (10)

	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.Visible = false
	holder.Parent = gui

	local edges = {}
	for _, def in ipairs(EDGE_DEFS) do
		local edge = Instance.new("Frame")
		edge.Name = def.Name
		edge.AnchorPoint = def.Anchor
		edge.Position = def.Position
		edge.Size = def.Size
		edge.BorderSizePixel = 0
		edge.BackgroundColor3 = KIND_STYLE.Other.Vignette
		edge.BackgroundTransparency = 1
		edge.Parent = holder

		local gradient = Instance.new("UIGradient")
		gradient.Rotation = def.Rotation
		gradient.Transparency = VIGNETTE_FALLOFF
		gradient.Parent = edge

		table.insert(edges, edge)
	end

	-- faint warm wash used for lightning (never a white-out)
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(240, 228, 190)
	flash.BackgroundTransparency = 1
	flash.Visible = false
	flash.Parent = gui

	vignette = { holder = holder, edges = edges, tweens = {}, flash = flash, flashTween = nil, token = 0 }
end

-- Fade the kind-coloured edges from startT to invisible over 'seconds'.
local function flashVignette(color, startT, seconds)
	local v = vignette
	if not v then
		return
	end
	v.token = v.token + 1
	local token = v.token
	v.holder.Visible = true
	for i, edge in ipairs(v.edges) do
		-- a running tween would overwrite the value we set below, so stop it first
		local old = v.tweens[i]
		if old then
			old:Cancel()
		end
		edge.BackgroundColor3 = color
		edge.BackgroundTransparency = startT
		v.tweens[i] = Util.Tween(edge, seconds, { BackgroundTransparency = 1 })
	end
	task.delay(seconds + 0.05, function()
		if vignette and vignette.token == token then
			vignette.holder.Visible = false
		end
	end)
end

local function flashScreen(startT, seconds)
	local v = vignette
	if not v then
		return
	end
	if v.flashTween then
		v.flashTween:Cancel()
	end
	v.flash.Visible = true
	v.flash.BackgroundTransparency = startT
	local tween = Util.Tween(v.flash, seconds, { BackgroundTransparency = 1 })
	v.flashTween = tween
	task.delay(seconds + 0.05, function()
		if vignette and vignette.flashTween == tween then
			vignette.flash.Visible = false
		end
	end)
end

----------------------------------------------------------------------
-- Camera shake (Humanoid.CameraOffset, always restored)
----------------------------------------------------------------------
local function stopShake()
	if shake.conn then
		shake.conn:Disconnect()
		shake.conn = nil
	end
	shake.trauma = 0
	local humanoid = shake.humanoid
	shake.humanoid = nil
	if humanoid then
		pcall(function()
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end)
	end
end

local function stepShake(dt)
	local humanoid = shake.humanoid
	if not humanoid or not humanoid.Parent then
		stopShake()
		return
	end
	shake.trauma = shake.trauma - SHAKE_DECAY * dt
	if shake.trauma <= 0 then
		stopShake()
		return
	end
	shake.clock = shake.clock + dt * SHAKE_SPEED
	local t = shake.clock
	local magnitude = shake.trauma * shake.trauma * SHAKE_MAX
	-- two incommensurate sines per axis read as noise without needing a random value per frame
	local x = (math.sin(t * 41 + shake.px) + 0.6 * math.sin(t * 67 + shake.py)) / 1.6
	local y = (math.sin(t * 53 + shake.py) + 0.6 * math.sin(t * 79 + shake.px)) / 1.6
	humanoid.CameraOffset = Vector3.new(x * magnitude, y * magnitude, 0)
end

local function addShake(amount)
	if amount <= 0 then
		return
	end
	local humanoid = Util.GetHumanoid(LocalPlayer)
	if not humanoid then
		return
	end
	if shake.humanoid ~= humanoid then
		stopShake() -- gives the previous humanoid (if any) its camera back
		shake.humanoid = humanoid
		shake.px = rng:NextNumber(0, 6.28)
		shake.py = rng:NextNumber(0, 6.28)
	end
	shake.trauma = math.min(1, shake.trauma + amount)
	if not shake.conn then
		shake.conn = RunService.RenderStepped:Connect(stepShake)
	end
end

----------------------------------------------------------------------
-- Floating texts (damage numbers, token pops)
----------------------------------------------------------------------
-- The part floating text hangs above, plus how many studs higher to start for that part.
local function getAnchor()
	local char = LocalPlayer.Character
	if not char then
		return nil, 0
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head, 0
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root, 1.5
	end
	return nil, 0
end

-- cfg: Text, Word (optional kind word), Color, WordColor, TextSize, Rise, Life, StartX, StartY,
--      Gradient = { top, bottom } (optional; tints the number with a UIGradient)
local function spawnFloat(cfg)
	if liveFloats >= MAX_LIVE_FLOATS then
		return
	end
	local anchor, bias = getAnchor()
	if not anchor then
		return
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end

	local startOffset = Vector3.new(cfg.StartX or 0, (cfg.StartY or 2.6) + bias, 0)
	local endOffset = startOffset + Vector3.new(0, cfg.Rise or 3, 0)
	local life = cfg.Life or 1.1
	local factor = Theme.ScreenFactor()

	local board = Instance.new("BillboardGui")
	board.Name = "NC_FloatText"
	board.Adornee = anchor
	board.AlwaysOnTop = true
	board.LightInfluence = 0
	board.ResetOnSpawn = false
	board.Size = UDim2.fromOffset(math.floor(FLOAT_W * factor), math.floor(FLOAT_H * factor))
	board.StudsOffset = startOffset

	-- the scale pop lives on an inner frame so the billboard itself keeps its size
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = board

	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = root

	local texts = {}
	local outlines = {}
	local textSize = Theme.ScaledSize(cfg.TextSize or NUMBER_SIZE)
	local outlineColor = Theme.Darken(cfg.Color or Colors.Bad, 0.72)
	local number = Theme.Label(cfg.Text, "Accent", {
		Size = textSize,
		Color = cfg.Color,
		Stroke = 0.1,
		StrokeColor = outlineColor,
		Outline = 3,
		OutlineColor = outlineColor,
		Props = {
			Name = "Number",
			Size = UDim2.new(1, 0, 0, math.floor(textSize * 1.3)),
			Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5)),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	number.Parent = root
	table.insert(texts, number)
	table.insert(outlines, number:FindFirstChild("TextOutline"))
	if cfg.Gradient then
		-- UIGradient multiplies the text colour, so the label itself must be white
		number.TextColor3 = Colors.White
		Theme.Gradient(number, cfg.Gradient[1], cfg.Gradient[2], 90)
	end

	if cfg.Word then
		local wordSize = Theme.ScaledSize(WORD_SIZE)
		local wordColor = cfg.WordColor or cfg.Color
		local wordOutline = Theme.Darken(wordColor or Colors.Bad, 0.72)
		local word = Theme.Label(cfg.Word, "Accent", {
			Size = wordSize,
			Color = wordColor,
			Stroke = 0.15,
			StrokeColor = wordOutline,
			Outline = 2,
			OutlineColor = wordOutline,
			Props = {
				Name = "Word",
				Size = UDim2.new(1, 0, 0, math.floor(wordSize * 1.3)),
				Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5 + wordSize * 1.25)),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		})
		word.Parent = root
		table.insert(texts, word)
		table.insert(outlines, word:FindFirstChild("TextOutline"))
	end

	board.Parent = playerGui
	liveFloats = liveFloats + 1

	Util.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	Util.Tween(board, life, { StudsOffset = endOffset }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	task.delay(life * 0.55, function()
		if not board.Parent then
			return
		end
		for _, label in ipairs(texts) do
			Util.Tween(label, life * 0.45, { TextTransparency = 1, TextStrokeTransparency = 1 })
		end
		for _, outline in ipairs(outlines) do
			if outline then
				Util.Tween(outline, life * 0.45, { Transparency = 1 })
			end
		end
	end)
	task.delay(life + 0.1, function()
		liveFloats = math.max(0, liveFloats - 1)
		if board.Parent then
			board:Destroy()
		end
	end)
end

local function spawnDamageNumber(amount, kind)
	local style = KIND_STYLE[kind] or KIND_STYLE.Other
	local n = math.max(1, math.floor(amount + 0.5))
	local size = NUMBER_SIZE
	if n >= 25 then
		size = NUMBER_SIZE_BIG
	end
	spawnFloat({
		Text = "-" .. n,
		Word = style.Word,
		Color = style.Color,
		WordColor = Theme.Lighten(style.Color, 0.3),
		TextSize = size,
		Rise = 3,
		Life = 1.05,
		StartX = rng:NextNumber(-1.1, 1.1),
		StartY = 2.6,
	})
end

local function spawnTokenPop(delta)
	local golden = delta >= (Config.Tokens.GoldenValue or 5)
	spawnFloat({
		Text = "+" .. delta .. " \226\152\129",
		Color = Colors.Token,
		Gradient = golden and { Colors.White:Lerp(Colors.TokenGlow, 0.4), Colors.TokenGlow }
			or { Colors.TokenGlow, Colors.Token },
		TextSize = golden and TOKEN_SIZE_GOLDEN or TOKEN_SIZE,
		Rise = 3.2,
		Life = 1.2,
		StartX = rng:NextNumber(-1.4, 1.4),
		StartY = 3.4,
	})
end

----------------------------------------------------------------------
-- Storm merging
----------------------------------------------------------------------
local function showStormNumber()
	stormScheduled = false
	if stormAccum <= 0 then
		return
	end
	local total = stormAccum
	stormAccum = 0
	stormLastShow = os.clock()
	spawnDamageNumber(total, "Storm")
end

local function queueStormNumber(amount)
	stormAccum = stormAccum + amount
	if stormScheduled then
		return
	end
	stormScheduled = true
	local remaining = stormLastShow + STORM_INTERVAL - os.clock()
	if remaining <= 0.02 then
		showStormNumber()
	else
		task.delay(remaining, showStormNumber)
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------
local function onDamageTaken(amount, kind)
	amount = tonumber(amount) or 0
	if amount <= 0 then
		return
	end
	if type(kind) ~= "string" or not KIND_STYLE[kind] then
		kind = "Other"
	end
	local style = KIND_STYLE[kind]

	-- subtle: even the hardest hit only reaches a medium tint at the very edge
	local strength = Util.Clamp(amount / 30, 0.2, 1)
	local startT = Util.Lerp(0.82, 0.4, strength)
	local seconds = 0.45 + strength * 0.35
	if style.Soft then
		startT = 0.86
		seconds = 0.4
	end
	flashVignette(style.Vignette, startT, seconds)
	if style.Flash then
		flashScreen(0.78, 0.25)
	end
	addShake(style.Shake * Util.Clamp(0.5 + amount / 40, 0.5, 1.2))

	if kind == "Storm" then
		queueStormNumber(amount)
	else
		spawnDamageNumber(amount, kind)
	end
end

local function onMatchTokensChanged()
	local value = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	local delta = value - lastMatchTokens
	lastMatchTokens = value
	if delta > 0 then
		spawnTokenPop(math.floor(delta + 0.5))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function DamageFx.Init()
	if initialized then
		return
	end
	initialized = true
	if not LocalPlayer then
		return
	end

	task.spawn(function()
		local ok, err = pcall(buildScreenGui)
		if not ok then
			warn("[DamageFx] vignette setup failed: " .. tostring(err))
		end
	end)

	-- Remotes.Get yields until the folder replicates, so never block Init on it
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "DamageTaken")
		if not ok or not remote then
			warn("[DamageFx] DamageTaken remote unavailable: " .. tostring(remote))
			return
		end
		remote.OnClientEvent:Connect(function(amount, kind)
			local okFx, err = pcall(onDamageTaken, amount, kind)
			if not okFx then
				warn("[DamageFx] damage feedback failed: " .. tostring(err))
			end
		end)
	end)

	-- "+n ☁" whenever the match token count goes up
	lastMatchTokens = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	LocalPlayer:GetAttributeChangedSignal(ATTR.MatchTokens):Connect(function()
		local ok, err = pcall(onMatchTokensChanged)
		if not ok then
			warn("[DamageFx] token pop failed: " .. tostring(err))
		end
	end)

	-- never leave the camera displaced across respawns
	LocalPlayer.CharacterRemoving:Connect(function()
		stopShake()
	end)
end

return DamageFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">DevController</string>
              <string name="Source"><![CDATA[-- DevController (client): the owner-only DEV button and its "Developer tools" side panel (Config.Dev; the server
-- half is server/Services/DevService.lua).
--
--   DevController.Init()
--   Extras (tests): DevController.Open(), DevController.Close(), DevController.IsOpen(), DevController.Relayout()
--
-- Everything here only exists while the LocalPlayer's PlayerGui has the attribute NC_Dev = true (DevService sets it
-- for the game's owner, the Config.Dev.Admins and everyone testing in Studio; a PlayerGui only replicates to its own
-- player, so nobody else learns who the developers are). The attribute is watched; it is only a hint: the server
-- checks every command again. NC_DevTutorial = true (same place) shows "Restart tutorial": the server only sets it
-- when its TutorialService can restart a tutorial.
--
-- ScreenGui "NimbusDev" (display order 15, IgnoreGuiInset = false), built the first time NC_Dev turns true:
--   * DevTile: a chunky cloud tile in the menu tiles' style (glossy face, thick navy outline, big "DEV") with the
--     TextButton "DevButton", docked to the RIGHT edge. Its spot is MEASURED, never guessed: the lowest free place
--     on the right edge that touches none of the menu column, the HUD blocks (NimbusHud panels + its published
--     TopRight geometry), the hotbar, the tutorial panel, the touch RUN / DASH buttons and Roblox's jump button,
--     and stays out of the middle of the screen. On a PC that is the bottom-right corner; on phones and tablets it
--     sits just above the thumb buttons. The top of the side-toast column (NimbusNotify's ToastStack, measured;
--     room for its two newest toasts) is kept free too whenever the screen has room for that. Re-checked twice a
--     second and on every screen size change.
--   * DevPanel: a compact CloudUI panel docked to the right edge, never centred, titled "Developer tools":
--     "Give all pets", "+1M tokens" (Config.Dev.GrantTokens through Theme.ShortNumber), "Restart tutorial",
--     "Skip tutorial", "Start Boss Raid" (Phase 3: DevCommand "raid"), the pet showcase ("Evolve every pet" =
--     DevCommand("evolve", "all"), "Show all pets" / "Show evolved pets" / "Show Evolved II pets" =
--     DevCommand("pets", "0" | "1" | "2"), "Clear pet show" = DevCommand("clearpets"); client/Controllers/DevPetShow.lua
--     builds them), "Reset my data" (the first tap turns it into "Are you sure?"; only a second, separate tap
--     0.6 to 4 s later sends it, so a double click never resets) and the note "Only you can see this". For the
--     first 0.4 s after it opens its buttons ignore taps (the rest of a double click on the tile lands there).
--     It takes a free stretch of the right edge below the toasts' room, so the toasts that answer its buttons
--     never cover it, preferring a stretch where it fits whole (see placePanel): while open it may lie over the
--     thumb buttons or HUD pieces (one tap closes it), never in the middle. Only a very short screen (a landscape
--     phone) has no such stretch: there the newest toasts may cover its top. When the stretch is short the
--     buttons scroll instead of shrinking the text. The tile hides while it is open.
--     Built on the first open, so a developer who never opens it only carries the small tile.
-- Input: mouse, touch and gamepad. Both are Selectable TextButtons (Activated covers click, tap and gamepad A);
-- opening the panel with a gamepad selects its first button; B (ContextActionService, only while open), Esc, the
-- red X and the tile close it.
-- Readability rule: designed in 1080p pixels under one UIScale of the screen factor clamp(viewportY / 1080,
-- 0.8, 1.25): buttons 22 px, title 28 px, note 18 px -> never below 14 px on a phone.
-- Remote out: DevCommand(command, arg). Plain Lua 5.1-compatible syntax only. Fonts only via Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DevController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	ATTR = "NC_Dev", -- PlayerGui attributes set by DevService
	ATTR_TUTORIAL = "NC_DevTutorial",
	GUI_NAME = "NimbusDev",
	ORDER = 15, -- above the HUD (10), hotbar (11) and tutorial (12); below the menu windows (20) and toasts (30)
	EDGE = 12, -- KEEP IN SYNC with HudController.lua: EDGE and TOUCH_EDGE (screen px)
	TOUCH_EDGE = 20,
	GAP = 8, -- screen px kept free around every neighbour
	CENTRE_TOL = 0.145, -- the middle of the screen: |dx| < 14.5% of the width and |dy| < 14.5% of the height
	SCAN_STEP = 4, -- screen px between two candidate spots of the tile
	TILE = 84, -- same size as a menu tile
	TILE_TEXT = 30,
	PANEL_W = 340,
	TITLE_TEXT = 28,
	BUTTON_H = 50,
	BUTTON_TEXT = 22,
	NOTE_TEXT = 18,
	NOTE_H = 26,
	LIST_PAD = 10,
	LIST_GAP = 8,
	BUMPS = 30, -- room the panel's cloud bumps (and their outline) need above its top edge
	MIN_PANEL_H = 230, -- the shortest (scrolling) panel worth showing
	MIN_SCALE = 0.5, -- only for absurdly small windows
	POLL = 0.5, -- seconds between two layout checks
	CONFIRM_SECONDS = 4, -- an armed "Are you sure?" disarms itself after this many seconds
	CONFIRM_DELAY = 0.6, -- seconds the confirming tap must come after the first one (a double click never resets)
	OPEN_GUARD = 0.4, -- seconds after opening during which the panel's buttons ignore taps
	SEND_GAP = 0.35, -- seconds between two commands sent from this panel
	-- design px kept free at the top of the side-toast column: its two newest toasts (the answer to a DEV button
	-- of up to 3 lines and one more of up to 4). KEEP IN SYNC with NotifyController.lua's toast: 18 px text,
	-- 8 px padding above and below, TOAST_GAP 8
	TOAST_ROOM = 200,
	BACK_ACTION = "NimbusDevBack",
}

local BUTTONS = Theme.Buttons or {}
local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local INK = Colors.TextStroke or Colors.Ink
local DEV_COLOR = Theme.Mix(Colors.Storm, BUTTONS.Blue or Color3.fromRGB(90, 158, 234), 0.3) -- slate blue

local LocalPlayer = nil
local initialized = false
local enabled = false
local panelOpen = false
local pollSerial = 0
local lastSend = -math.huge
local openedAt = -math.huge -- os.clock() of the last Open()
local warned = {}

local UI = {} -- Gui, Tile, TileScale, TileButton, TileFx, Panel, PanelRoot, PanelScale, List, Buttons = {}, ResetButton
local Hint = { Gui = nil } -- the LocalPlayer's PlayerGui: DevService's NC_Dev / NC_DevTutorial live there
local Reset = { Until = 0, Serial = 0, ChangedAt = -math.huge } -- ChangedAt: when it was last armed or sent
local Back = { Bound = false }
local applied = {} -- last values written by relayout (only changes are written)

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[DevController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function guard(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function devConfig()
	if type(Config.Dev) == "table" then
		return Config.Dev
	end
	return {}
end

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- The area GUIs with IgnoreGuiInset = false are laid out in (below the top bar).
local function guiAreaSize()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	local vp = viewportSize()
	return Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
end

local function usingGamepad()
	local ok, kind = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	return ok and kind ~= nil and string.find(tostring(kind), "Gamepad", 1, true) ~= nil
end

local refreshTutorialButton -- defined with the panel (Building)

local function corner(parent, radius)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness)
	return Util.Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function plainFrame(parent, name, props)
	local frame = Util.Create("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 })
	for key, value in pairs(props or {}) do
		frame[key] = value
	end
	frame.Parent = parent
	return frame
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function devRemote()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("DevCommand")
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

-- Fires DevCommand(command, arg). Returns true when it was sent (a quick double tap is dropped).
local function send(command, arg)
	local now = os.clock()
	if now - lastSend < K.SEND_GAP then
		return false
	end
	local remote = devRemote()
	if not remote then
		warnOnce("remote", "the DevCommand remote is missing")
		return false
	end
	lastSend = now
	remote:FireServer(command, arg)
	return true
end

local function grantTokens()
	local amount = tonumber(devConfig().GrantTokens)
	if not amount or amount ~= amount or amount < 1 then
		amount = 1000000
	end
	return math.floor(amount)
end

local function tokensLabel()
	local amount = grantTokens()
	local text = nil
	if type(Theme.ShortNumber) == "function" then
		local ok, short = pcall(Theme.ShortNumber, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " tokens"
end

-- Phase 2: test amounts of Cash and Gems (Config.Dev.GrantCash / GrantGems).
local function grantAmount(key, fallback)
	local amount = tonumber(devConfig()[key])
	if not amount or amount ~= amount or amount < 1 then
		amount = fallback
	end
	return math.floor(amount)
end

local function amountLabel(amount, word)
	local text = nil
	if type(Theme.ShortNumber) == "function" then
		local ok, short = pcall(Theme.ShortNumber, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " " .. word
end

local function disarmReset()
	Reset.Until = 0
	Reset.Serial = Reset.Serial + 1
	if UI.ResetButton then
		UI.ResetButton.Text = "Reset my data"
	end
end

-- First tap arms the button ("Are you sure?"); a second tap sends the reset when it comes CONFIRM_DELAY to
-- CONFIRM_SECONDS later. A tap sooner than CONFIRM_DELAY after arming (or after sending) is ignored and the button
-- stays as it is: a double click, however fast, can never wipe the data.
local function onResetPressed()
	local now = os.clock()
	if now - Reset.ChangedAt < K.CONFIRM_DELAY then
		return
	end
	if Reset.Until > now then
		if send("reset") then
			disarmReset()
			Reset.ChangedAt = now
		end
		return
	end
	Reset.Until = now + K.CONFIRM_SECONDS
	Reset.ChangedAt = now
	Reset.Serial = Reset.Serial + 1
	local serial = Reset.Serial
	UI.ResetButton.Text = "Are you sure?"
	task.delay(K.CONFIRM_SECONDS, function()
		if Reset.Serial == serial then
			disarmReset()
		end
	end)
end

-- A panel button's press, ignored for OPEN_GUARD seconds after the panel opened: the panel opens where the DEV
-- tile was, so the second click of a double click on the tile would otherwise land on one of its buttons.
local function panelPress(action)
	return function()
		if os.clock() - openedAt < K.OPEN_GUARD then
			return
		end
		action()
	end
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
-- Glossy chunky face (same recipe as the menu tiles): light top, the colour, then a darker lip at the bottom.
local function tileSequence(c)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.34)),
		ColorSequenceKeypoint.new(0.5, Theme.Lighten(c, 0.05)),
		ColorSequenceKeypoint.new(0.78, Theme.Darken(c, 0.08)),
		ColorSequenceKeypoint.new(0.8, Theme.Darken(c, 0.32)),
		ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.4)),
	})
end

local function buildTile(gui)
	local tile = plainFrame(gui, "DevTile", {
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.TILE, K.TILE),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		ZIndex = 2,
	})
	UI.Tile = tile
	UI.TileScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = tile })

	local button = Util.Create("TextButton", {
		Name = "DevButton",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Selectable = true,
		ZIndex = 3,
		Parent = tile,
	})
	UI.TileButton = button
	corner(button, 18)
	local outline = stroke(button, NAVY, 4)
	local face = Util.Create("UIGradient", { Rotation = 90, Color = tileSequence(DEV_COLOR), Parent = button })
	local gloss = plainFrame(button, "Gloss", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.72,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 0.3, 0),
		ZIndex = 3,
	})
	corner(gloss, 10)
	-- two tiny pixel glints, like the menu tiles (a nod to the voxel world)
	for i, glint in ipairs({ { 10, 9, 6 }, { 18, 9, 4 } }) do
		plainFrame(button, "Glint" .. i, {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.15,
			Position = UDim2.fromOffset(glint[1], glint[2]),
			Size = UDim2.fromOffset(glint[3], glint[3]),
			ZIndex = 4,
		})
	end
	local label = Theme.Label("DEV", "Title", {
		Size = K.TILE_TEXT,
		Stroke = 0.1,
		StrokeColor = INK,
		Outline = 2.5,
		OutlineColor = INK,
		Props = {
			Name = "Label",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.new(1, -8, 0, 36),
			ZIndex = 5,
		},
	})
	label.Parent = button

	-- hover / press feedback (same feel as the menu tiles)
	local fx = Util.Create("UIScale", { Name = "FxScale", Scale = 1, Parent = button })
	local state = { Hovering = false, Pressing = false }
	local function paint()
		local color = DEV_COLOR
		local scale = 1
		if state.Pressing then
			color = Theme.Darken(DEV_COLOR, 0.08)
			scale = 0.93
		elseif state.Hovering then
			color = Theme.Lighten(DEV_COLOR, 0.1)
			scale = 1.07
		end
		face.Color = tileSequence(color)
		outline.Color = NAVY
		Util.Tween(fx, 0.1, { Scale = scale })
	end
	button.MouseEnter:Connect(function()
		state.Hovering = true
		paint()
	end)
	button.MouseLeave:Connect(function()
		state.Hovering, state.Pressing = false, false
		paint()
	end)
	button.MouseButton1Down:Connect(function()
		state.Pressing = true
		paint()
	end)
	button.MouseButton1Up:Connect(function()
		state.Pressing = false
		paint()
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			state.Hovering, state.Pressing = false, false
			paint()
		end
	end)
	button.Activated:Connect(function()
		guard("open", DevController.Open)
	end)
	CloudUI.Tooltip(button, function()
		return "Developer tools (only you)"
	end)
end

-- Design height of the whole panel when nothing is cut off.
local function fullPanelHeight(count)
	local top, _, bottom = CloudUI.ContentInset(true)
	local list = 2 * K.LIST_PAD + count * (K.BUTTON_H + K.LIST_GAP) + K.NOTE_H
	return top + list + bottom
end

-- True when the server says "Restart tutorial" works in this build (NC_DevTutorial on our PlayerGui).
local function tutorialAvailable()
	return Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR_TUTORIAL) == true
end

-- Shows "Restart tutorial" only when it works, and sizes the panel for the buttons that are shown.
function refreshTutorialButton()
	local button = UI.Buttons and UI.Buttons.tutorial
	if not button then
		return -- the panel is not built yet: it asks again when it is
	end
	button.Visible = tutorialAvailable()
	local shown = 0
	for _, b in ipairs(UI.Buttons) do
		if b.Visible then
			shown = shown + 1
		end
	end
	UI.FullHeight = fullPanelHeight(shown)
	DevController.Relayout()
end

local function buildPanel(gui)
	local specs = {
		{ Id = "allpets", Text = "Give all pets", Style = "Green" },
		{ Id = "tokens", Text = tokensLabel(), Style = "Gold" },
		{ Id = "cash", Text = amountLabel(grantAmount("GrantCash", 1000000), "Cash"), Style = "Green" },
		{ Id = "gems", Text = amountLabel(grantAmount("GrantGems", 1000), "Gems"), Style = "Blue" },
		{ Id = "tutorial", Text = "Restart tutorial", Style = "Blue" },
		{ Id = "skiptutorial", Text = "Skip tutorial", Style = "Pink" },
		{ Id = "raid", Text = "Start Boss Raid", Style = "Gold" }, -- Phase 3 (events): DevCommand("raid")
		-- the pet showcase (DevService: evolve / pets / clearpets)
		{ Id = "evolveall", Text = "Evolve every pet", Style = "Gold", Command = "evolve", Arg = "all" },
		{ Id = "pets0", Text = "Show all pets", Style = "Blue", Command = "pets", Arg = "0" },
		{ Id = "pets1", Text = "Show evolved pets", Style = "Blue", Command = "pets", Arg = "1" },
		{ Id = "pets2", Text = "Show Evolved II pets", Style = "Blue", Command = "pets", Arg = "2" },
		{ Id = "clearpets", Text = "Clear pet show", Style = "Gray", Command = "clearpets" },
		{ Id = "reset", Text = "Reset my data", Style = "Red" },
	}
	UI.FullHeight = fullPanelHeight(#specs)
	local panel = CloudUI.Panel({
		Name = "DevPanel",
		Title = "Developer tools",
		TitleSize = K.TITLE_TEXT,
		Closable = true,
		OnClose = function()
			DevController.Close()
		end,
		Accent = DEV_COLOR,
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.PANEL_W, UI.FullHeight),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		Parent = gui,
	})
	UI.Panel = panel
	UI.PanelRoot = panel.Root
	UI.PanelRoot.Visible = false
	UI.PanelScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = panel.Root })

	local list = Util.Create("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = WHITE,
		ZIndex = 5,
		Parent = panel.Content,
	})
	UI.List = list
	Util.Create("UIPadding", {
		PaddingTop = UDim.new(0, K.LIST_PAD),
		PaddingBottom = UDim.new(0, K.LIST_PAD),
		PaddingLeft = UDim.new(0, K.LIST_PAD),
		PaddingRight = UDim.new(0, K.LIST_PAD + 4),
		Parent = list,
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, K.LIST_GAP),
		Parent = list,
	})

	UI.Buttons = {}
	for index, spec in ipairs(specs) do
		local id = spec.Id
		local callback
		if id == "reset" then
			callback = panelPress(function()
				guard("reset", onResetPressed)
			end)
		elseif id == "tokens" then
			callback = panelPress(function()
				send("tokens", grantTokens())
			end)
		elseif id == "cash" then
			callback = panelPress(function()
				send("cash", grantAmount("GrantCash", 1000000))
			end)
		elseif id == "gems" then
			callback = panelPress(function()
				send("gems", grantAmount("GrantGems", 1000))
			end)
		elseif spec.Command then
			callback = panelPress(function()
				send(spec.Command, spec.Arg)
			end)
		else
			callback = panelPress(function()
				send(id)
			end)
		end
		local button = CloudUI.Button({
			Name = "Dev_" .. id,
			Text = spec.Text,
			Style = spec.Style,
			Size = UDim2.new(1, 0, 0, K.BUTTON_H),
			TextSize = K.BUTTON_TEXT,
			LayoutOrder = index,
			ZIndex = 6,
			Callback = callback,
			Parent = list,
		})
		button.Selectable = true
		UI.Buttons[id] = button
		UI.Buttons[index] = button
		if id == "reset" then
			UI.ResetButton = button
		end
	end
	local note = Theme.Label("Only you can see this", "Label", {
		Size = K.NOTE_TEXT,
		Color = Colors.Muted or WHITE,
		Stroke = 0.3,
		Outline = 1.5,
		Props = {
			Name = "Note",
			Size = UDim2.new(1, 0, 0, K.NOTE_H),
			LayoutOrder = #specs + 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 6,
		},
	})
	note.Parent = list
	refreshTutorialButton()
end

local function build()
	if UI.Gui and UI.Gui.Parent then
		return
	end
	local gui = CloudUI.NewScreenGui(K.GUI_NAME, K.ORDER)
	gui.Enabled = false
	UI.Gui = gui
	applied = {}
	UI.PanelRoot = nil -- the panel is built on first open (a developer who never opens it only pays for the tile)
	buildTile(gui)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		guard("relayout", DevController.Relayout)
	end)
end

----------------------------------------------------------------------
-- Layout: measured neighbours (all rectangles in our gui-area pixels)
----------------------------------------------------------------------
local function playerGui()
	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

-- y offset that converts a gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

local function addRect(list, inst, root, dy)
	if not (inst and inst:IsA("GuiObject")) then
		return
	end
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	if s.X <= 0 or s.Y <= 0 or not shownIn(inst, root) then
		return
	end
	list[#list + 1] = { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

local function enabledGui(pg, name)
	local gui = pg:FindFirstChild(name)
	if gui and gui:IsA("ScreenGui") and gui.Enabled then
		return gui
	end
	return nil
end

-- The side toasts (NimbusNotify, drawn above us): the measured left / right edges and top of the toast column,
-- reserved TOAST_ROOM design px down, so its newest toasts (the answers to the panel's buttons) stay readable.
-- nil when there is no toast column.
local function toastRoom(pg, factor)
	local notify = enabledGui(pg, "NimbusNotify")
	local stack = notify and notify:FindFirstChild("ToastStack", true)
	if not (stack and stack:IsA("GuiObject")) or stack.AbsoluteSize.X <= 0 then
		return nil
	end
	local p, s = stack.AbsolutePosition, stack.AbsoluteSize
	local top = p.Y + insetShift(notify)
	return { x0 = p.X, y0 = top, x1 = p.X + s.X, y1 = top + K.TOAST_ROOM * factor }
end

-- What the DEV tile and panel keep clear of (gui-area rectangles):
--   Others          the menu column, HUD blocks, hotbar, tutorial panel, touch buttons (the tile never touches them)
--   Toasts          the toast column's room, or nil
--   TopRightBottom  the bottom of the HUD's top-right block (0 if none), TopRightLeft its left edge
local function neighbours(area, factor)
	local out = {}
	local layout = { Others = out, Toasts = nil, TopRightBottom = 0, TopRightLeft = area.X }
	local pg = playerGui()
	if not pg then
		return layout
	end
	layout.Toasts = toastRoom(pg, factor)
	local menu = enabledGui(pg, "NimbusMenu")
	if menu then
		addRect(out, menu:FindFirstChild("MenuColumn"), menu, insetShift(menu))
	end
	local hud = enabledGui(pg, "NimbusHud")
	if hud then
		local dy = insetShift(hud)
		for _, holder in ipairs(hud:GetChildren()) do
			if holder:IsA("GuiObject") and holder.Visible then
				for _, panel in ipairs(holder:GetChildren()) do
					addRect(out, panel, hud, dy)
				end
			end
		end
		local trb = tonumber(hud:GetAttribute("TopRightBottom")) or 0
		if trb > 0 then
			layout.TopRightBottom = trb
			layout.TopRightLeft = tonumber(hud:GetAttribute("TopRightLeft")) or 0
			out[#out + 1] = { x0 = layout.TopRightLeft, y0 = 0, x1 = area.X, y1 = trb }
		end
	end
	local hotbar = enabledGui(pg, "NimbusHotbar")
	if hotbar then
		addRect(out, hotbar:FindFirstChild("Hotbar"), hotbar, insetShift(hotbar))
	end
	local tutorial = enabledGui(pg, "NimbusTutorial")
	if tutorial then
		addRect(out, tutorial:FindFirstChild("TutorialPanel"), tutorial, insetShift(tutorial))
	end
	-- touch RUN / DASH (MovementController)
	local mobile = enabledGui(pg, "MobileControls")
	if mobile then
		local dy = insetShift(mobile)
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("ImageButton") then
				addRect(out, d, mobile, dy)
			end
		end
	end
	-- Roblox's own jump button; when it cannot be measured, the footprint MovementController assumes
	-- (KEEP IN SYNC with MovementController.lua layoutMobileControls)
	local measured = false
	local touchGui = enabledGui(pg, "TouchGui")
	if touchGui then
		local jump = touchGui:FindFirstChild("JumpButton", true)
		if jump then
			local before = #out
			addRect(out, jump, touchGui, insetShift(touchGui))
			measured = #out > before
		end
	end
	if not measured and isTouchDevice() then
		local vp = viewportSize()
		local small = math.min(vp.X, vp.Y) <= 500
		local size = small and 70 or 120
		local bottom = small and 20 or size * 0.75
		local dy = area.Y - vp.Y -- screen -> gui area (minus the top bar)
		out[#out + 1] = {
			x0 = vp.X - (size * 1.5 + 10),
			y0 = vp.Y - bottom - size + dy,
			x1 = vp.X - (size * 0.5 + 10),
			y1 = vp.Y - bottom + dy,
		}
	end
	return layout
end

-- A new list with the rectangles of `a` and `b` (either may be a list, one rectangle or nil).
local function joined(a, b)
	local out = {}
	for _, part in ipairs({ a or {}, b or {} }) do
		if part.x0 then
			out[#out + 1] = part
		else
			for _, r in ipairs(part) do
				out[#out + 1] = r
			end
		end
	end
	return out
end

-- The middle of the screen the game never writes into (same band as the HUD), in gui-area pixels.
local function centreBand(area)
	local vp = viewportSize()
	local inset = math.max(0, vp.Y - area.Y)
	local tol = K.CENTRE_TOL
	return {
		x0 = vp.X * (0.5 - tol),
		x1 = vp.X * (0.5 + tol),
		y0 = vp.Y * (0.5 - tol) - inset,
		y1 = vp.Y * (0.5 + tol) - inset,
	}
end

local function touches(a, b, gap)
	return a.x0 < b.x1 + gap and a.x1 > b.x0 - gap and a.y0 < b.y1 + gap and a.y1 > b.y0 - gap
end

-- Bottom edge (gui px) of the lowest spot for a size x size tile at the right edge `right` that touches no
-- blocker and stays out of the band; nil when there is none.
local function lowestFreeSpot(area, side, right, size, blockers, band)
	local y1 = area.Y - side
	while y1 - size >= side do
		local rect = { x0 = right - size, y0 = y1 - size, x1 = right, y1 = y1 }
		local free = not touches(rect, band, 0)
		if free then
			for _, r in ipairs(blockers) do
				if touches(rect, r, K.GAP) then
					free = false
					break
				end
			end
		end
		if free then
			return y1
		end
		y1 = y1 - K.SCAN_STEP
	end
	return nil
end

-- Bottom-right corner (gui px) of the tile: the lowest free spot on the right edge, clear of the toasts' room
-- too when the screen has space for that (a short phone screen has not: then only toasts may touch it).
local function placeTile(area, side, size, layout, band)
	local right = area.X - side
	for _, blockers in ipairs({ joined(layout.Others, layout.Toasts), layout.Others }) do
		local y1 = lowestFreeSpot(area, side, right, size, blockers, band)
		if y1 then
			return right, y1
		end
	end
	-- no free spot at all (a tiny window): the top-right corner
	return right, math.min(area.Y - side, side + size)
end

-- Free vertical stretches [y0, y1] of the column [x0, x1] between top and bottom. `headroom` is kept free below
-- every blocker as well (the panel's cloud bumps stick out above its top edge).
local function freeStretches(x0, x1, top, bottom, blockers, headroom)
	local spans = {}
	for _, r in ipairs(blockers) do
		if r.x0 < x1 + K.GAP and r.x1 > x0 - K.GAP and r.y1 + K.GAP > top and r.y0 - K.GAP < bottom then
			spans[#spans + 1] = { r.y0 - K.GAP, r.y1 + K.GAP + headroom }
		end
	end
	table.sort(spans, function(a, b)
		return a[1] < b[1]
	end)
	local out = {}
	local cursor = top
	for _, span in ipairs(spans) do
		if span[1] > cursor then
			out[#out + 1] = { cursor, math.min(span[1], bottom) }
		end
		cursor = math.max(cursor, span[2])
	end
	if cursor < bottom then
		out[#out + 1] = { cursor, bottom }
	end
	return out
end

-- The tallest free stretch (the lower one on a tie); nil when none is at least minH tall.
local function bestStretch(stretches, minH)
	local best = nil
	for _, s in ipairs(stretches) do
		local h = s[2] - s[1]
		if h >= minH and (best == nil or h >= best[2] - best[1]) then
			best = s
		end
	end
	return best
end

-- Bottom-right corner, design height and scale of the open panel. While it is open the panel is what the
-- developer uses, so it should be whole and uncovered: it may then lie over the thumb buttons or HUD pieces (one
-- tap closes it), but never over the toasts' room or in the middle of the screen. Tried in this order:
--   1. clear of everything, full height        2. clear of the toasts' room and the middle, full height
--   3. clear of everything, scrolling           4. clear of the toasts' room and the middle, scrolling
--   5. out of the middle only (a very short screen: the newest toasts may cover its top)
local function placePanel(area, side, factor, layout, band)
	local scale = math.max(K.MIN_SCALE, math.min(factor, (area.X - 2 * side) / K.PANEL_W))
	local right = area.X - side
	local left = right - K.PANEL_W * scale
	local bumps = K.BUMPS * scale
	local top = side
	if layout.TopRightBottom > 0 and layout.TopRightLeft < right then
		top = math.max(top, layout.TopRightBottom + K.GAP) -- the HUD's top-right block always stays visible
	end
	top = top + bumps
	local bottom = area.Y - side
	local fullH = (UI.FullHeight or 400) * scale
	local minH = math.min(K.MIN_PANEL_H * scale, bottom - top)
	local bandBlock = nil
	if left < band.x1 and right > band.x0 then
		bandBlock = { x0 = left, x1 = right, y0 = band.y0 + K.GAP, y1 = band.y1 - K.GAP }
	end
	local everything = joined(joined(layout.Others, layout.Toasts), bandBlock)
	local toastsAndMiddle = joined(layout.Toasts, bandBlock)
	local tries = {
		{ everything, fullH },
		{ toastsAndMiddle, fullH },
		{ everything, minH },
		{ toastsAndMiddle, minH },
		{ joined(bandBlock, nil), minH },
	}
	local stretch = nil
	for _, try in ipairs(tries) do
		stretch = bestStretch(freeStretches(left, right, top, bottom, try[1], bumps), try[2])
		if stretch then
			break
		end
	end
	stretch = stretch or { top, bottom }
	local height = math.min(UI.FullHeight or 400, (stretch[2] - stretch[1]) / scale)
	return right, stretch[2], height, scale
end

local function setIfChanged(key, inst, prop, value)
	if applied[key] ~= value then
		applied[key] = value
		inst[prop] = value
	end
end

function DevController.Relayout()
	if not UI.Gui or not enabled then
		return
	end
	local area = guiAreaSize()
	local factor = Theme.ScreenFactor(viewportSize().Y)
	local side = isTouchDevice() and K.TOUCH_EDGE or K.EDGE
	local layout = neighbours(area, factor)
	local band = centreBand(area)
	local tx, ty = placeTile(area, side, K.TILE * factor, layout, band)
	setIfChanged("tileScale", UI.TileScale, "Scale", factor)
	setIfChanged("tilePos", UI.Tile, "Position", UDim2.fromOffset(math.floor(tx + 0.5), math.floor(ty + 0.5)))
	if panelOpen then
		local px, py, height, scale = placePanel(area, side, factor, layout, band)
		setIfChanged("panelScale", UI.PanelScale, "Scale", scale)
		setIfChanged("panelSize", UI.PanelRoot, "Size", UDim2.fromOffset(K.PANEL_W, math.floor(height)))
		setIfChanged("panelPos", UI.PanelRoot, "Position", UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5)))
	end
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and panelOpen then
		DevController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function bindBack(on)
	if on == Back.Bound then
		return
	end
	Back.Bound = on
	if on then
		guard("bind back", function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

local function selectionInside(root)
	local selected = GuiService.SelectedObject
	return selected ~= nil and root ~= nil and selected:IsDescendantOf(root)
end

function DevController.IsOpen()
	return panelOpen
end

function DevController.Open()
	if not enabled or not UI.Gui then
		return false
	end
	if panelOpen then
		DevController.Close()
		return false
	end
	if not (UI.PanelRoot and UI.PanelRoot.Parent) then
		if not guard("build panel", buildPanel, UI.Gui) then
			return false
		end
	end
	panelOpen = true
	openedAt = os.clock()
	disarmReset()
	UI.PanelRoot.Visible = true
	UI.Tile.Visible = false
	DevController.Relayout()
	bindBack(true)
	if usingGamepad() and UI.Buttons[1] then
		pcall(function()
			GuiService.SelectedObject = UI.Buttons[1]
		end)
	end
	return true
end

function DevController.Close()
	if not panelOpen then
		return
	end
	panelOpen = false
	disarmReset()
	local hadSelection = selectionInside(UI.PanelRoot)
	if UI.PanelRoot then
		UI.PanelRoot.Visible = false
	end
	if UI.Tile then
		UI.Tile.Visible = enabled
	end
	bindBack(false)
	if hadSelection then
		pcall(function()
			GuiService.SelectedObject = (enabled and usingGamepad()) and UI.TileButton or nil
		end)
	end
	DevController.Relayout()
end

----------------------------------------------------------------------
-- NC_Dev on / off
----------------------------------------------------------------------
local function startPolling()
	pollSerial = pollSerial + 1
	local serial = pollSerial
	task.spawn(function()
		while enabled and serial == pollSerial do
			guard("relayout", DevController.Relayout)
			task.wait(K.POLL)
		end
	end)
end

local function setEnabled(on)
	if on == enabled then
		return
	end
	if on then
		if not guard("build", build) then
			return
		end
		enabled = true
		UI.Gui.Enabled = true
		UI.Tile.Visible = not panelOpen
		applied = {}
		startPolling()
	else
		DevController.Close()
		enabled = false
		pollSerial = pollSerial + 1
		if UI.Gui then
			UI.Gui.Enabled = false
		end
	end
end

local function refreshFlag()
	setEnabled(Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR) == true)
end

-- Follows DevService's hints on our PlayerGui (never on the Player: that one every client can read).
local function watchHints()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 60)
	if not pg then
		return
	end
	Hint.Gui = pg
	pg:GetAttributeChangedSignal(K.ATTR):Connect(function()
		guard("NC_Dev", refreshFlag)
	end)
	pg:GetAttributeChangedSignal(K.ATTR_TUTORIAL):Connect(function()
		guard("NC_DevTutorial", refreshTutorialButton)
	end)
	guard("NC_Dev", refreshFlag)
end

function DevController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	if not LocalPlayer then
		return
	end
	UserInputService.InputBegan:Connect(function(input)
		if panelOpen and input.KeyCode == Enum.KeyCode.Escape then
			DevController.Close()
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			guard("relayout", DevController.Relayout)
		end)
	end
	task.spawn(watchHints)
end

return DevController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">DevPetShow</string>
              <string name="Source"><![CDATA[-- DevPetShow (client): the developer's pet showcase. The server half is DevService ("/pet", "/pets", "/evolve",
-- "/clearpets"): it checks the permission and sends DevPetShow(action, payload) to the developer's own client.
--
--   DevPetShow.Init()
--   Extras (tests): DevPetShow.Handle(action, payload) (what the remote does), DevPetShow.Count() -> showcase pets
--                   in the world, DevPetShow.Busy() -> a lineup is being built or an evolution is playing,
--                   DevPetShow.Folder() -> the workspace folder (nil before the first pet)
--
-- The pets are built here with PetBuilder at Scale 1 (the size they have in the game) into the workspace folder
-- "DevPetShow": only this player sees them, and the server never has to replicate thousands of parts.
--   Spawn {PetId, Stage}    the pet at stage 0 (normal), 1 (evolved) or 2 (second evolution) in front of the player,
--                           facing them and hovering over the ground, beside the ones already there (they stay
--                           until Clear; the oldest goes past MAX_PETS)
--   Lineup {Stage, PetIds}  clears, builds every listed pet (one per frame) and stands them in rows in front of the
--                           player, all facing the same way; Low detail when the lineup would pass LINEUP_PARTS parts
--   Evolve {Steps}          clears, then plays the evolution animations (client/Controllers/EvolutionFx.lua) one
--                           after another in front of the player; Steps = { {PetId, From, To}, ... } with To = From + 1.
--                           A pet's line carries on with the evolved pet (normal -> evolved -> evolved II); after a
--                           short pause the next pet of a reel takes its place. The last one stays.
--   Clear {}                stops an evolution or a lineup and removes every showcase pet
-- Lineup, Evolve and Clear take over from whatever was running; Spawn adds to it. Resting pets get the tag
-- NC_Showcase (ShowcaseController makes them hover, flap, wag and blink) and a compact name tag (World text rule:
-- pixel-sized, 24 px name and 19 px info line, outlined, on a solid plate sized to its text, LightInfluence 0,
-- MaxDistance 120). Payloads are checked again here (catalog ids, stages each pet really has).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local function optionalModule(parent, name)
	local module = parent:FindFirstChild(name) or parent:WaitForChild(name, 5)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[DevPetShow] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local PetBuilder = optionalModule(Shared, "PetBuilder")
local PetCatalog = optionalModule(Shared, "PetCatalog")
local EvolutionFx = optionalModule(script.Parent, "EvolutionFx")

local DevPetShow = {}

local K = {
	FOLDER = "DevPetShow",
	TAG = "NC_Showcase", -- ShowcaseController animates models with this tag
	MAX_PETS = 40,
	HOVER = 0.7, -- studs between a pet's lowest point and the ground
	BOB = 0.3, -- ShowcaseController hover amplitude (studs)
	AHEAD = 6, -- studs from the player to the nearest pet's edge
	GAP = 1.6, -- studs between two pets
	PER_ROW = 8,
	LINEUP_PARTS = 26000, -- above this a lineup is built at Low detail
	PARTS = { [0] = 350, [1] = 1560, [2] = 2000 }, -- High detail part caps per stage (PetBuilder header)
	LOOK = 0.6, -- seconds a pet is shown before it evolves
	STEP_PAUSE = 0.5, -- seconds between the two evolutions of one pet
	PAUSE = 1.8, -- seconds an evolved pet rests before the next pet of a reel
	NAME_PX = 24, -- World text rule: names >= 22 px, info lines >= 18 px (1080p design pixels)
	INFO_PX = 19,
	TAG_W = 280,
	TAG_H = 70,
	TAG_DISTANCE = 120,
	RAY = 90, -- studs searched down for the ground
}
local STAGE_NAMES = { [0] = "Normal", [1] = "Evolved", [2] = "Evolved II" }

local folder = nil
local pets = {} -- { { Model, Pos = Vector3 (root, flat), Radius } } resting showcase pets, oldest first
local generation = 0 -- Lineup / Evolve / Clear bump it: a running lineup or evolution stops when it changes
local current = nil -- the EvolutionFx handle that is playing
local busy = 0
local initialized = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function getFolder()
	if folder and folder.Parent then
		return folder
	end
	folder = Workspace:FindFirstChild(K.FOLDER)
	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name = K.FOLDER
		folder.Parent = Workspace
	end
	return folder
end

local function defOf(id)
	if type(id) ~= "string" or not PetCatalog then
		return nil
	end
	local ok, def = pcall(PetCatalog.Get, id)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function maxStage(def)
	local ok, top = pcall(PetBuilder.MaxEvolution, def)
	if ok and (top == 1 or top == 2) then
		return top
	end
	return 1
end

local function validStage(def, stage)
	return type(stage) == "number" and stage == math.floor(stage) and stage >= 0 and stage <= maxStage(def)
end

local function rarityColor(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity and typeof(r.Color) == "Color3" then
			if rarity == "Secret" then
				return Color3.fromRGB(150, 236, 255) -- the dark Secret colour does not show on the navy plate
			end
			return r.Color
		end
	end
	return Theme.Colors.Gold
end

-- The player's position and the flat direction they look at.
local function playerFrame()
	local player = Players.LocalPlayer
	local char = player and player.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

-- y of the ground under pos (the player's feet when nothing is found)
local function groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { getFolder() }
	if char then
		ignore[#ignore + 1] = char
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- The built pet's extent around its root (PetBuilder builds the root at the origin): lowest and highest point,
-- and the horizontal radius from the root.
local function extentOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5, 1.5, 2
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or cf.Position
	local bottom = rel.Y - size.Y / 2
	local top = rel.Y + size.Y / 2
	local radius = math.max(math.abs(rel.X) + size.X / 2, math.abs(rel.Z) + size.Z / 2)
	return bottom, top, radius
end

local function build(def, stage, detail)
	local ok, model = pcall(PetBuilder.Build, def, { Detail = detail or "High", Evolved = (stage > 0) and stage or nil })
	if not ok or typeof(model) ~= "Instance" or not model.PrimaryPart then
		warn("[DevPetShow] could not build " .. tostring(def.Id) .. " stage " .. tostring(stage) .. ": " .. tostring(model))
		return nil
	end
	model.Name = "DevPet_" .. tostring(def.Id) .. "_" .. stage
	model:SetAttribute("DevPetStage", stage)
	return model
end

-- Root CFrame of a pet standing at flat position `spot` (its lowest point HOVER above the ground), facing `facing`.
local function poseAt(spot, bottom, facing, char, fallbackY)
	local ground = groundAt(Vector3.new(spot.X, fallbackY + 4, spot.Z), char, fallbackY)
	local pos = Vector3.new(spot.X, ground + K.HOVER - bottom, spot.Z)
	return CFrame.lookAt(pos, pos + facing), ground
end

local function nameTag(model, def, stage, top)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local k = 1
	local okScale, factor = pcall(Theme.ScreenFactor)
	if okScale and type(factor) == "number" and factor > 0 then
		k = factor
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "DevPetTag"
	gui.Size = UDim2.fromOffset(math.floor(K.TAG_W * k), math.floor(K.TAG_H * k))
	gui.StudsOffsetWorldSpace = Vector3.new(0, top + 1.4, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = K.TAG_DISTANCE
	gui.ClipsDescendants = false
	gui.Adornee = root
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.BackgroundColor3 = Theme.Colors.Navy
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.fromScale(0.5, 1)
	card.Size = UDim2.fromOffset(0, 0)
	card.AutomaticSize = Enum.AutomaticSize.XY
	card.Parent = gui
	Theme.Corner(card, UDim.new(0, 12))
	Theme.Stroke(card, rarityColor(def.Rarity), 3, 0)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 1)
	list.Parent = card
	local scale = Instance.new("UIScale")
	scale.Name = "ReadScale"
	scale.Scale = k
	scale.Parent = card
	local name = Theme.Label(tostring(def.Name or def.Id), "Heading", { Size = K.NAME_PX, Color = Theme.Colors.White, Outline = 2 })
	name.Name = "Name"
	name.AutomaticSize = Enum.AutomaticSize.XY
	name.Size = UDim2.fromOffset(0, K.NAME_PX + 4)
	name.TextWrapped = false
	name.LayoutOrder = 1
	name.Parent = card
	local info = Theme.Label(STAGE_NAMES[stage] .. "  \226\128\162  " .. tostring(def.Rarity or ""), "Label", { Size = K.INFO_PX, Color = rarityColor(def.Rarity), Outline = 2 })
	info.Name = "Info"
	info.AutomaticSize = Enum.AutomaticSize.XY
	info.Size = UDim2.fromOffset(0, K.INFO_PX + 4)
	info.TextWrapped = false
	info.LayoutOrder = 2
	info.Parent = card
	gui.Parent = root
end

-- A pet at rest: name tag, then ShowcaseController brings it to life.
local function rest(model, def, stage, pos, radius)
	local _, top = extentOf(model)
	model:SetAttribute("Ready", true)
	model:SetAttribute("HoverAmp", K.BOB)
	nameTag(model, def, stage, top)
	CollectionService:AddTag(model, K.TAG)
	pets[#pets + 1] = { Model = model, Pos = Vector3.new(pos.X, 0, pos.Z), Radius = radius }
	while #pets > K.MAX_PETS do
		local old = table.remove(pets, 1)
		pcall(function()
			old.Model:Destroy()
		end)
	end
end

local function clearAll()
	if current then
		pcall(current.Stop)
		current = nil
	end
	for _, rec in ipairs(pets) do
		pcall(function()
			rec.Model:Destroy()
		end)
	end
	pets = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

-- The first free spot on the line in front of the player (nearest the middle first).
local function freeSpot(origin, look, radius)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
	for i = 0, 40 do
		local side = (i == 0) and 0 or (((i % 2 == 1) and 1 or -1) * math.ceil(i / 2))
		local spot = base + right * side * (radius + K.GAP)
		local free = true
		for _, rec in ipairs(pets) do
			if rec.Model.Parent and (rec.Pos - spot).Magnitude < rec.Radius + radius + K.GAP * 0.5 then
				free = false
				break
			end
		end
		if free then
			return spot
		end
	end
	return base
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
local function spawnPet(payload)
	local def = defOf(payload.PetId)
	if not def or not validStage(def, payload.Stage) then
		return false
	end
	local model = build(def, payload.Stage, "High")
	if not model then
		return false
	end
	local origin, look, char = playerFrame()
	local bottom, _, radius = extentOf(model)
	local spot = freeSpot(origin, look, radius)
	local pose = poseAt(spot, bottom, -look, char, origin.Y - 3)
	model:PivotTo(pose)
	model.Parent = getFolder()
	rest(model, def, payload.Stage, spot, radius)
	return true
end

local function lineup(payload, gen)
	local stage = payload.Stage
	if type(payload.PetIds) ~= "table" or type(stage) ~= "number" then
		return false
	end
	local defs = {}
	for _, id in ipairs(payload.PetIds) do
		local def = defOf(id)
		if def and validStage(def, stage) then
			defs[#defs + 1] = def
		end
	end
	if #defs == 0 then
		return false
	end
	busy = busy + 1
	local detail = (#defs * (K.PARTS[stage] or 350) > K.LINEUP_PARTS) and "Low" or "High"
	-- build them all first (one per frame), then stand them in rows
	local built = {}
	local maxR = 1
	for _, def in ipairs(defs) do
		if gen ~= generation then
			break
		end
		local model = build(def, stage, detail)
		if model then
			local bottom, _, radius = extentOf(model)
			built[#built + 1] = { Model = model, Def = def, Bottom = bottom, Radius = radius }
			maxR = math.max(maxR, radius)
		end
		task.wait()
	end
	if gen ~= generation then
		for _, b in ipairs(built) do
			pcall(function()
				b.Model:Destroy()
			end)
		end
		busy = busy - 1
		return false
	end
	local origin, look, char = playerFrame()
	local right = Vector3.new(-look.Z, 0, look.X)
	local perRow = math.min(K.PER_ROW, #built)
	local pitch = maxR * 2 + K.GAP
	local parent = getFolder()
	for i, b in ipairs(built) do
		local row = math.floor((i - 1) / perRow)
		local col = (i - 1) % perRow
		local inRow = math.min(perRow, #built - row * perRow)
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + maxR + row * (pitch + K.GAP)) + right * ((col - (inRow - 1) / 2) * pitch)
		local pose = poseAt(spot, b.Bottom, -look, char, origin.Y - 3)
		b.Model:PivotTo(pose)
		b.Model.Parent = parent
		rest(b.Model, b.Def, stage, spot, b.Radius)
	end
	busy = busy - 1
	return true
end

-- Groups the steps into chains: consecutive steps of one pet where each starts where the previous ended.
local function chainsOf(steps)
	local chains = {}
	local last = nil
	for _, st in ipairs(steps) do
		if type(st) == "table" then
			local def = defOf(st.PetId)
			if def and validStage(def, st.From) and validStage(def, st.To) and st.To == st.From + 1 then
				if last and last.Def == def and last.To == st.From then
					last.Steps[#last.Steps + 1] = st
					last.To = st.To
				else
					last = { Def = def, From = st.From, To = st.To, Steps = { st } }
					chains[#chains + 1] = last
				end
			end
		end
	end
	return chains
end

local function evolveReel(payload, gen)
	if type(payload.Steps) ~= "table" or not EvolutionFx then
		return false
	end
	local chains = chainsOf(payload.Steps)
	if #chains == 0 then
		return false
	end
	busy = busy + 1
	local onShow = nil -- the model resting from the previous chain
	for ci, chain in ipairs(chains) do
		if gen ~= generation then
			break
		end
		if onShow then
			task.wait(K.PAUSE)
			if gen ~= generation then
				break
			end
			pcall(function()
				onShow:Destroy()
			end)
			onShow = nil
		end
		-- every stage of the chain is built first: the biggest one decides where it stands
		local models = {}
		local bottom, radius = 0, 1
		for stage = chain.From, chain.To do
			local m = build(chain.Def, stage, "High")
			if not m then
				break
			end
			models[stage] = m
			local b, _, r = extentOf(m)
			bottom, radius = math.min(bottom, b), math.max(radius, r)
			task.wait()
		end
		if gen ~= generation or not models[chain.To] then
			for _, m in pairs(models) do
				pcall(function()
					m:Destroy()
				end)
			end
			break
		end
		local origin, look, char = playerFrame()
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
		local pose, ground = poseAt(spot, bottom, -look, char, origin.Y - 3)
		local parent = getFolder()
		local model = models[chain.From]
		model:PivotTo(pose)
		model.Parent = parent
		task.wait(K.LOOK)
		for si, st in ipairs(chain.Steps) do
			if gen ~= generation then
				break
			end
			if si > 1 then
				task.wait(K.STEP_PAUSE)
				if gen ~= generation then
					break
				end
			end
			local toModel = models[st.To]
			local okColors, a, b = pcall(PetBuilder.EvolutionColors, chain.Def, st.To)
			local handle = EvolutionFx.Play(model, toModel, pose, {
				Parent = parent,
				Colors = okColors and { a, b } or nil,
				Stage = st.To,
				Ground = ground,
			})
			current = handle
			while not handle.Done do
				if gen ~= generation then
					pcall(handle.Stop)
					break
				end
				task.wait(0.1)
			end
			if current == handle then
				current = nil
			end
			model = toModel
		end
		-- a stage built but never shown (stopped part-way) goes away
		for _, m in pairs(models) do
			if m ~= model then
				pcall(function()
					m:Destroy()
				end)
			end
		end
		if gen ~= generation then
			pcall(function()
				model:Destroy()
			end)
			break
		end
		if ci == #chains then
			rest(model, chain.Def, chain.To, spot, radius)
		else
			onShow = model
		end
	end
	if onShow and gen ~= generation then
		pcall(function()
			onShow:Destroy()
		end)
	end
	busy = busy - 1
	return true
end

function DevPetShow.Handle(action, payload)
	if type(action) ~= "string" then
		return false
	end
	payload = type(payload) == "table" and payload or {}
	if not (PetBuilder and PetCatalog) then
		warn("[DevPetShow] PetBuilder / PetCatalog are missing")
		return false
	end
	if action == "Spawn" then
		local ok, result = pcall(spawnPet, payload)
		if not ok then
			warn("[DevPetShow] Spawn failed: " .. tostring(result))
		end
		return ok and result == true
	end
	if action ~= "Lineup" and action ~= "Evolve" and action ~= "Clear" then
		return false
	end
	generation = generation + 1
	local gen = generation
	clearAll()
	if action == "Clear" then
		return true
	end
	task.spawn(function()
		local fn = (action == "Lineup") and lineup or evolveReel
		local ok, err = pcall(fn, payload, gen)
		if not ok then
			warn("[DevPetShow] " .. action .. " failed: " .. tostring(err))
			busy = math.max(0, busy - 1)
		end
	end)
	return true
end

function DevPetShow.Count()
	local n = 0
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") then
				n = n + 1
			end
		end
	end
	return n
end

function DevPetShow.Busy()
	return busy > 0
end

function DevPetShow.Folder()
	return folder
end

function DevPetShow.Init()
	if initialized then
		return
	end
	initialized = true
	local ok, remote = pcall(Remotes.Get, "DevPetShow")
	if not (ok and remote) then
		warn("[DevPetShow] the DevPetShow remote is missing")
		return
	end
	remote.OnClientEvent:Connect(function(action, payload)
		DevPetShow.Handle(action, payload)
	end)
end

return DevPetShow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">EvolutionFx</string>
              <string name="Source"><![CDATA[-- EvolutionFx (client): the evolution animation of a pet, played on this client only (its parts never exist on
-- the server, so nothing replicates). Used by the developer pet showcase (DevPetShow, "/evolve") and by the game's own
-- EVOLVE moment (CareController, Phase 4: two fresh PetBuilder clones in front of the player, with Confetti = true).
--
--   EvolutionFx.Play(fromModel, toModel, pose, opts) -> handle
--       fromModel  the pet as it is now: a PetBuilder model at rest (any stage), placed at `pose`
--       toModel    the evolved pet: a PetBuilder model at rest (parented to opts.Parent when it appears)
--       pose       CFrame of the pets' root (PrimaryPart) at rest: where both hover; LookVector = their facing
--       opts       { Parent = Instance for toModel and the effect parts (default workspace),
--                    Colors = { Color3, Color3 } (glow, sparks: PetBuilder.EvolutionColors),
--                    Stage = 1 | 2 (the stage reached; the second evolution is grander and longer),
--                    Ground = y of the floor under the pets (default: just under fromModel),
--                    Confetti = true (Phase 4, the game's EVOLVE moment: a burst of voxel confetti at the reveal),
--                    OnDone = function(toModel) (called once, after the animation or Stop) }
--       handle     { Done = false/true, Model = the pet on show (fromModel, then toModel), Stop = function() }
--                  Stop() ends it at once: fromModel destroyed, toModel at rest at `pose`, the effects gone.
--   EvolutionFx.Duration(stage) -> seconds the animation lasts
--   EvolutionFx.Count() -> evolutions playing right now
--
-- The animation (stage 1 about 4.3 s, stage 2 about 5 s):
--   charge  the pet rises and spins faster and faster while it starts to glow (a Highlight), a ring of voxel runes
--           grows on the ground under it (two counter-rotating rings for the second evolution), glowing motes
--           spiral in and a pillar of light rises
--   burst   the pet shrinks into a white flash and the pillar flares
--   reveal  the evolved pet pops out of the flash (overshoot, then settles), spins down to face forward exactly
--           as it was, sinks back to its hover height; a shock ring races over the ground, voxel sparks burst out
--           and sparkles fly; the glow fades
-- Pets are moved and scaled by placing / resizing their parts from their rest offsets (workspace:BulkMoveTo), so
-- PetBuilder.Animate must not run on them meanwhile; at the end toModel is back at rest, ready for Animate.
-- One RenderStepped connection while anything plays; every effect part is anchored, CanCollide / CanTouch /
-- CanQuery off, CastShadow off. Plain Lua 5.1-compatible syntax only.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local EvolutionFx = {}

local TAU = math.pi * 2
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local WHITE = Color3.fromRGB(255, 255, 255)

local K = {
	CHARGE = { 2.0, 2.6 }, -- seconds of charging, per stage reached
	BURST = 0.38,
	REVEAL = 1.35,
	SETTLE = 0.6,
	RISE = 0.28, -- the pet rises this share of its height while charging
	SPIN = 4.5, -- turns per second at the end of the charge
	REVEAL_TURNS = 2, -- turns the evolved pet spins down through
	MIN_SCALE = 0.04,
	RUNES = { 20, 28 }, -- voxel runes in the ground ring
	MOTES = { 18, 28 },
	SPARKS = { 22, 34 },
	PILLAR = { 9, 12 }, -- pillar height in pet heights... capped below
	PILLAR_MAX = 60, -- studs
	CONFETTI = 26, -- voxel confetti bits (opts.Confetti)
	CONFETTI_COLORS = {
		Color3.fromRGB(255, 96, 120),
		Color3.fromRGB(255, 176, 64),
		Color3.fromRGB(255, 226, 90),
		Color3.fromRGB(110, 214, 120),
		Color3.fromRGB(96, 176, 255),
		Color3.fromRGB(186, 128, 255),
	},
}

local plays = {}
local loopConn = nil

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

local function easeIn(x)
	x = clamp01(x)
	return x * x * x
end

local function easeOut(x)
	x = clamp01(x)
	local y = 1 - x
	return 1 - y * y * y
end

-- overshoots to about 1.1 and settles at 1
local function easeOutBack(x)
	x = clamp01(x)
	local c1 = 1.70158
	local c3 = c1 + 1
	local y = x - 1
	return 1 + c3 * y * y * y + c1 * y * y
end

local function lighten(c, t)
	return c:Lerp(WHITE, t)
end

-- a small deterministic "random" in [0, 1) per index
local function hash(i, salt)
	local h = math.sin(i * 12.9898 + (salt or 0) * 78.233) * 43758.5453
	return h - math.floor(h)
end

local function effectPart(play, name, shape, color, size)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Material = Enum.Material.Neon
	p.Color = color
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Parent = play.Folder
	return p
end

-- The pet's parts, their rest offsets from the root and their sizes.
local function rigOf(model)
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not (root and root:IsA("BasePart")) then
		return nil
	end
	local base = root.CFrame
	local rig = { Model = model, Root = root, Parts = {}, Pos = {}, Rot = {}, Size = {}, Scale = 1 }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = base:ToObjectSpace(d.CFrame)
			local n = #rig.Parts + 1
			rig.Parts[n] = d
			rig.Pos[n] = rel.Position
			rig.Rot[n] = rel - rel.Position
			rig.Size[n] = d.Size
		end
	end
	return rig
end

-- Places the pet with its root at cf, scaled by s around the root.
local function poseRig(rig, cf, s)
	if not rig or not rig.Model.Parent then
		return
	end
	local resize = s ~= rig.Scale
	local list = {}
	for i, part in ipairs(rig.Parts) do
		if resize then
			part.Size = rig.Size[i] * s
		end
		list[i] = cf * CFrame.new(rig.Pos[i] * s) * rig.Rot[i]
	end
	rig.Scale = s
	Workspace:BulkMoveTo(rig.Parts, list, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Height, radius (half the larger horizontal size) and the offset from the root down to the pet's lowest point.
local function measure(rig)
	local lo, hi = math.huge, -math.huge
	local rx = 0
	local base = rig.Root.CFrame
	for i, part in ipairs(rig.Parts) do
		if part.Transparency < 1 then
			local p = rig.Pos[i]
			local half = rig.Size[i].Magnitude / 2
			lo = math.min(lo, p.Y - half)
			hi = math.max(hi, p.Y + half)
			rx = math.max(rx, math.abs(p.X) + half, math.abs(p.Z) + half)
		end
	end
	if lo == math.huge then
		return 3, 2, -1.5, base
	end
	return hi - lo, rx, lo, base
end

----------------------------------------------------------------------
-- One play
----------------------------------------------------------------------
local function ringPose(play, i, n, radius, turn, lift)
	local a = i / n * TAU + turn
	local c = play.Pose
	local centre = Vector3.new(c.Position.X, play.Ground + (lift or 0.06), c.Position.Z)
	local pos = centre + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
	return CFrame.new(pos) * CFrame.Angles(0, -a, 0)
end

local function buildEffects(play)
	local stage = play.Stage
	local c1, c2 = play.Colors[1], play.Colors[2]
	local R, H = play.Radius, play.Height
	local u = math.max(0.6, math.min(R, H) * 0.22) -- size unit of the voxel bits
	play.Unit = u
	-- glow on the pet
	local hl = Instance.new("Highlight")
	hl.Name = "EvolveGlow"
	hl.FillColor = lighten(c1, 0.35)
	hl.OutlineColor = lighten(c2, 0.5)
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Adornee = play.From.Model
	hl.Parent = play.Folder
	play.Glow = hl
	-- the rune ring(s) on the ground
	play.Runes = {}
	local rings = (stage == 2) and 2 or 1
	for r = 1, rings do
		local n = K.RUNES[stage] - (r - 1) * 8
		for i = 1, n do
			local col = ((i + r) % 2 == 0) and c1 or c2
			local part = effectPart(play, "EvolveRune", nil, col, Vector3.new(u * 0.55, u * 0.14, u * ((i % 3 == 0) and 1.5 or 0.9)))
			part.Transparency = 1
			play.Runes[#play.Runes + 1] = { Part = part, I = i, N = n, Ring = r }
		end
	end
	-- motes that spiral in
	play.Motes = {}
	for i = 1, K.MOTES[stage] do
		local part = effectPart(play, "EvolveMote", nil, (i % 2 == 0) and c1 or c2, Vector3.new(u * 0.4, u * 0.4, u * 0.4))
		part.Transparency = 1
		play.Motes[i] = { Part = part, A = hash(i, 1) * TAU, Y = 0.15 + hash(i, 2) * 1.05, Delay = hash(i, 3) * 0.35 }
	end
	-- the pillar of light (a cylinder's axis is its X axis: turned upright)
	local pillar = effectPart(play, "EvolvePillar", Enum.PartType.Cylinder, lighten(c1, 0.45), Vector3.new(0.1, R * 1.4, R * 1.4))
	pillar.Transparency = 1
	play.Pillar = pillar
	play.PillarHeight = math.min(K.PILLAR_MAX, H * K.PILLAR[stage])
	local light = Instance.new("PointLight")
	light.Name = "EvolveLight"
	light.Color = lighten(c1, 0.3)
	light.Range = math.min(40, R * 4 + 8)
	light.Brightness = 0
	light.Parent = pillar
	play.Light = light
	-- the flash
	local flash = effectPart(play, "EvolveFlash", Enum.PartType.Ball, WHITE, Vector3.new(0.2, 0.2, 0.2))
	flash.Transparency = 1
	play.Flash = flash
	-- sparkles (emitted in bursts)
	local att = Instance.new("Attachment")
	att.Name = "EvolveSparkles"
	att.Parent = flash
	local em = Instance.new("ParticleEmitter")
	em.Name = "EvolveSparkles"
	em.Texture = SPARKLE
	em.Color = ColorSequence.new(lighten(c1, 0.3), lighten(c2, 0.3))
	em.LightEmission = 1
	em.LightInfluence = 0
	em.Rate = 0
	em.Lifetime = NumberRange.new(0.7, 1.4)
	em.Speed = NumberRange.new(R * 2.2, R * 4.4)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-180, 180)
	em.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.25, u * 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Parent = att
	play.Emitter = em
	-- shock ring + sparks (shown at the reveal)
	play.Shock = {}
	for i = 1, 28 do
		local part = effectPart(play, "EvolveShock", nil, (i % 2 == 0) and lighten(c2, 0.2) or WHITE, Vector3.new(u * 0.5, u * 0.18, u * 1.4))
		part.Transparency = 1
		play.Shock[i] = part
	end
	play.Sparks = {}
	for i = 1, K.SPARKS[stage] do
		local part = effectPart(play, "EvolveSpark", nil, (i % 3 == 0) and WHITE or ((i % 2 == 0) and c1 or c2), Vector3.new(u * 0.45, u * 0.45, u * 0.45))
		part.Transparency = 1
		local a = hash(i, 5) * TAU
		local speed = R * (2.4 + hash(i, 6) * 2.2)
		play.Sparks[i] = {
			Part = part,
			V = Vector3.new(math.cos(a) * speed, R * (2.2 + hash(i, 7) * 2.6), math.sin(a) * speed),
			Spin = Vector3.new(hash(i, 8) * 9, hash(i, 9) * 9, hash(i, 10) * 9),
		}
	end
	-- confetti (Phase 4's EVOLVE moment): flat voxel bits that pop up from the pet and flutter down
	play.Confetti = {}
	if play.ConfettiOn then
		for i = 1, K.CONFETTI do
			local col = K.CONFETTI_COLORS[(i - 1) % #K.CONFETTI_COLORS + 1]
			local part = effectPart(play, "EvolveConfetti", nil, col, Vector3.new(u * 0.5, u * 0.08, u * 0.32))
			part.Material = Enum.Material.SmoothPlastic
			part.Transparency = 1
			local a = hash(i, 13) * TAU
			local speed = R * (0.8 + hash(i, 14) * 1.6)
			play.Confetti[i] = {
				Part = part,
				V = Vector3.new(math.cos(a) * speed, R * (3 + hash(i, 15) * 2.4), math.sin(a) * speed),
				Spin = Vector3.new(4 + hash(i, 16) * 8, hash(i, 17) * 6, 3 + hash(i, 18) * 8),
				Phase = hash(i, 19) * TAU,
			}
		end
	end
end

local function cleanup(play)
	if play.Folder then
		pcall(function()
			play.Folder:Destroy()
		end)
		play.Folder = nil
	end
end

local function finish(play)
	if play.Handle.Done then
		return
	end
	play.Handle.Done = true
	-- fromModel goes, toModel rests exactly at the pose (scale 1)
	if play.From and play.From.Model then
		pcall(function()
			play.From.Model:Destroy()
		end)
	end
	if play.To and play.To.Model then
		if not play.To.Model.Parent then
			play.To.Model.Parent = play.Parent
		end
		poseRig(play.To, play.Pose, 1)
	end
	play.Handle.Model = play.To and play.To.Model or nil
	cleanup(play)
	for i = #plays, 1, -1 do
		if plays[i] == play then
			table.remove(plays, i)
		end
	end
	if #plays == 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
	if type(play.OnDone) == "function" and play.To then
		local ok, err = pcall(play.OnDone, play.To.Model)
		if not ok then
			warn("[EvolutionFx] OnDone failed: " .. tostring(err))
		end
	end
end

local function step(play, dt)
	play.T = play.T + dt
	local t = play.T
	local c, b, r, s = play.Charge, K.BURST, K.REVEAL, K.SETTLE
	local pose, H, R, u = play.Pose, play.Height, play.Radius, play.Unit
	local rise = H * K.RISE
	local runeTurn = t * 0.9
	-- the rune rings: grow while charging, stay through the reveal, fade while settling
	local ringP = smooth(t / (c * 0.6))
	local ringFade = clamp01((t - (c + b + r)) / s)
	local runeList, cfs = {}, {}
	for _, rune in ipairs(play.Runes) do
		local radius = R * (0.45 + 0.75 * ringP) * ((rune.Ring == 2) and 0.68 or 1)
		local turn = (rune.Ring == 2) and -runeTurn * 1.4 or runeTurn
		runeList[#runeList + 1] = rune.Part
		cfs[#cfs + 1] = ringPose(play, rune.I, rune.N, radius, turn, (rune.Ring == 2) and 0.1 or 0.06)
		rune.Part.Transparency = 1 - ringP * 0.9 * (1 - ringFade)
	end
	if #runeList > 0 then
		Workspace:BulkMoveTo(runeList, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	local centre = pose.Position + Vector3.new(0, rise * smooth(t / c), 0)
	if t < c then
		-- charge: rise, spin up, shake a little, glow; motes spiral in; the pillar rises
		local p = t / c
		play.Yaw = play.Yaw + dt * TAU * K.SPIN * p * p
		local shake = H * 0.015 * p * p
		local jx = (hash(math.floor(t * 30), 11) - 0.5) * shake
		local jz = (hash(math.floor(t * 30), 12) - 0.5) * shake
		poseRig(play.From, pose * CFrame.new(jx, rise * smooth(p), jz) * CFrame.Angles(0, play.Yaw, 0), 1)
		play.Glow.FillTransparency = 1 - 0.78 * smooth(p)
		play.Glow.OutlineTransparency = 1 - smooth(p * 1.4)
		local moteList, moteCfs = {}, {}
		for i, m in ipairs(play.Motes) do
			local q = clamp01((p - m.Delay) / (1 - m.Delay))
			local radius = R * 1.9 * (1 - easeIn(q)) + R * 0.1
			local a = m.A + q * TAU * 1.6
			local y = pose.Position.Y - H * 0.4 + H * m.Y * (1 - q * 0.5) + rise * smooth(p)
			moteList[i] = m.Part
			moteCfs[i] = CFrame.new(centre.X + math.cos(a) * radius, y, centre.Z + math.sin(a) * radius) * CFrame.Angles(t * 3 + i, t * 2, 0)
			m.Part.Transparency = (q > 0 and q < 0.98) and 0.05 or 1
		end
		Workspace:BulkMoveTo(moteList, moteCfs, Enum.BulkMoveMode.FireCFrameChanged)
		local ph = play.PillarHeight * smooth(p * 1.3)
		local w = R * (0.9 + 0.3 * p)
		play.Pillar.Size = Vector3.new(math.max(0.1, ph), w, w)
		play.Pillar.CFrame = CFrame.new(centre.X, play.Ground + ph / 2, centre.Z) * CFrame.Angles(0, 0, math.pi / 2)
		play.Pillar.Transparency = 1 - 0.38 * smooth(p * 1.5)
		play.Light.Brightness = 3 * p
	elseif t < c + b then
		-- burst: the pet shrinks into a white flash; the pillar flares
		if not play.BurstStarted then
			play.BurstStarted = true
			for _, m in ipairs(play.Motes) do
				m.Part.Transparency = 1
			end
		end
		local p = (t - c) / b
		play.Yaw = play.Yaw + dt * TAU * K.SPIN
		poseRig(play.From, pose * CFrame.new(0, rise, 0) * CFrame.Angles(0, play.Yaw, 0), math.max(K.MIN_SCALE, 1 - easeIn(p)))
		local fs = (R * 0.4 + R * 1.3 * easeOut(p)) * 2
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.CFrame = CFrame.new(centre)
		play.Flash.Transparency = 0.2 + 0.2 * p
		local w = R * (1.2 + 1.2 * easeOut(p))
		play.Pillar.Size = Vector3.new(play.PillarHeight, w, w)
		play.Pillar.Transparency = 0.55 + 0.45 * p
		play.Light.Brightness = 3 + 3 * p
	elseif t < c + b + r then
		-- reveal: swap the pets once, then the evolved pet pops out, spins down to face forward and sinks back
		if not play.Swapped then
			play.Swapped = true
			pcall(function()
				play.From.Model.Parent = nil
			end)
			play.To.Model.Parent = play.Parent
			play.Glow.Adornee = play.To.Model
			play.Glow.FillColor = WHITE
			play.Glow.FillTransparency = 0
			play.Glow.OutlineTransparency = 0
			play.Handle.Model = play.To.Model
			play.Pillar.Transparency = 1
			play.Emitter:Emit(play.Stage == 2 and 70 or 45)
			play.SparkT0 = t
		end
		local p = (t - c - b) / r
		local yaw = TAU * K.REVEAL_TURNS * easeOut(p)
		local scale = K.MIN_SCALE + (1 - K.MIN_SCALE) * easeOutBack(math.min(1, p * 1.25))
		poseRig(play.To, pose * CFrame.new(0, rise * (1 - smooth(p)), 0) * CFrame.Angles(0, yaw, 0), math.max(K.MIN_SCALE, scale))
		play.Glow.FillTransparency = smooth(p)
		play.Glow.OutlineTransparency = smooth(p * 0.8)
		local fs = R * 1.7 * 2 * (1 + 0.35 * p)
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.Transparency = 0.4 + 0.6 * smooth(p * 3)
		play.Light.Brightness = 6 * (1 - p)
	else
		-- settle: hold the pose while the effects fade, then finish
		poseRig(play.To, pose, 1)
		play.Glow.FillTransparency = 1
		play.Glow.OutlineTransparency = 1
		play.Flash.Transparency = 1
		play.Light.Brightness = 0
		if t >= c + b + r + s then
			finish(play)
			return
		end
	end
	-- the shock ring and the sparks (from the swap on)
	if play.SparkT0 then
		local q = t - play.SparkT0
		local shockP = clamp01(q / 0.85)
		local list, list2 = {}, {}
		for i, part in ipairs(play.Shock) do
			list[i] = part
			list2[i] = ringPose(play, i, #play.Shock, R * (0.8 + 2.4 * easeOut(shockP)), 0, 0.12)
			part.Transparency = (shockP < 1) and (0.1 + 0.9 * shockP) or 1
		end
		Workspace:BulkMoveTo(list, list2, Enum.BulkMoveMode.FireCFrameChanged)
		local sl, sc = {}, {}
		local base = pose.Position + Vector3.new(0, rise * 0.5, 0)
		for i, sp in ipairs(play.Sparks) do
			local pos = base + sp.V * q + Vector3.new(0, -0.5 * 26 * q * q, 0)
			if pos.Y < play.Ground + u * 0.2 then
				pos = Vector3.new(pos.X, play.Ground + u * 0.2, pos.Z)
			end
			sl[i] = sp.Part
			sc[i] = CFrame.new(pos) * CFrame.Angles(sp.Spin.X * q, sp.Spin.Y * q, sp.Spin.Z * q)
			sp.Part.Transparency = clamp01(q / 1.2)
		end
		Workspace:BulkMoveTo(sl, sc, Enum.BulkMoveMode.FireCFrameChanged)
		if #play.Confetti > 0 then
			-- up fast, then a slow flutter down (drag), fading out near the end of the settle
			local cl, cc = {}, {}
			local top = pose.Position + Vector3.new(0, H * 0.6, 0)
			local fade = clamp01((q - 1.3) / 0.6)
			for i, cf in ipairs(play.Confetti) do
				local k = 1 - math.exp(-2.2 * q)
				local drift = cf.V * (k / 2.2)
				local fall = 2.4 * math.max(0, q - 0.35) ^ 1.5
				local sway = math.sin(q * 6 + cf.Phase) * u * 0.6
				local pos = top + Vector3.new(drift.X + sway, drift.Y - fall * R, drift.Z)
				if pos.Y < play.Ground + u * 0.1 then
					pos = Vector3.new(pos.X, play.Ground + u * 0.1, pos.Z)
				end
				cl[i] = cf.Part
				cc[i] = CFrame.new(pos) * CFrame.Angles(cf.Spin.X * q, cf.Spin.Y * q, cf.Spin.Z * q)
				cf.Part.Transparency = fade
			end
			Workspace:BulkMoveTo(cl, cc, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	play.Handle.T = t
end

local function onFrame(dt)
	for i = #plays, 1, -1 do
		local play = plays[i]
		if play then
			local ok, err = pcall(step, play, math.min(dt, 0.1))
			if not ok then
				warn("[EvolutionFx] " .. tostring(err))
				pcall(finish, play)
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function EvolutionFx.Duration(stage)
	return K.CHARGE[(stage == 2) and 2 or 1] + K.BURST + K.REVEAL + K.SETTLE
end

function EvolutionFx.Count()
	return #plays
end

function EvolutionFx.Play(fromModel, toModel, pose, opts)
	opts = type(opts) == "table" and opts or {}
	local handle = { Done = false, Model = fromModel, T = 0 }
	local from = (typeof(fromModel) == "Instance") and rigOf(fromModel) or nil
	local to = (typeof(toModel) == "Instance") and rigOf(toModel) or nil
	if not (from and to) or typeof(pose) ~= "CFrame" then
		warn("[EvolutionFx] Play needs two PetBuilder models and a CFrame")
		handle.Done = true
		handle.Stop = function() end
		return handle
	end
	local stage = (opts.Stage == 2) and 2 or 1
	local colors = type(opts.Colors) == "table" and opts.Colors or {}
	local parent = (typeof(opts.Parent) == "Instance") and opts.Parent or Workspace
	local height, radius, low = measure(to)
	local play = {
		Handle = handle,
		From = from,
		To = to,
		Pose = pose,
		Stage = stage,
		Colors = {
			typeof(colors[1]) == "Color3" and colors[1] or Color3.fromRGB(255, 214, 90),
			typeof(colors[2]) == "Color3" and colors[2] or Color3.fromRGB(120, 200, 255),
		},
		Parent = parent,
		Charge = K.CHARGE[stage],
		Height = math.max(1, height),
		Radius = math.max(0.8, radius),
		Ground = (type(opts.Ground) == "number") and opts.Ground or (pose.Position.Y + low - 0.5),
		OnDone = opts.OnDone,
		ConfettiOn = opts.Confetti == true,
		T = 0,
		Yaw = 0,
	}
	local folder = Instance.new("Folder")
	folder.Name = "EvolutionFx"
	folder.Parent = parent
	play.Folder = folder
	toModel.Parent = nil
	poseRig(from, pose, 1)
	buildEffects(play)
	handle.Stop = function()
		pcall(finish, play)
	end
	plays[#plays + 1] = play
	if not loopConn then
		loopConn = RunService.RenderStepped:Connect(onFrame)
	end
	return handle
end

return EvolutionFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">FusionController</string>
              <string name="Source"><![CDATA[-- FusionController (client, Phase 2): the Fusion Machine window (ARCHITECTURE_V3.md section 11 and the
-- FusionService / FusionController paragraph of the "Phase 2 build contract").
--
--   FusionController.Init()
--   FusionController.Open(tab, args)   tab = "Upgrade" | "Mix" | nil (the last one); args (optional) =
--                                       { Key = key (Upgrade input / first Mix pet), KeyB = key (second Mix pet) }
--   FusionController.Close()
--   Extras: FusionController.IsOpen() -> bool, FusionController.Plan() -> the preview the window shows
--           ({ Ok, Reason, Action, Inputs, ResultKey, ResultName, Rarity, Tier, Cost = {Currency, Amount}, Notes }),
--           FusionController.Select(keyA, keyB) (picks pets like clicks do), FusionController.Fuse() (the FUSE
--           button), FusionController.Opened / Closed (Util.Signal)
--
-- How it opens: E at the player's own Fusion Machine (the FusionPrompt HomeBuilder puts on Station_FusionMachine;
-- other players' prompts are disabled locally by HomeFx and ignored here), or OpenPanel("Fusion", {Tab =, Key =})
-- from the server / other windows. One window at a time: opening it closes the menu windows, and a menu window or the
-- Pet Index opening closes it. Esc, gamepad B, the red X or a click outside close it; so does walking away from the
-- machine (when it was opened there) and entering a match.
--
-- Layout (CloudUI panel, violet like the machine):
--   top     two tabs, UPGRADE and MIX, and the player's Cloud Tokens / Gems
--   left    "Your pets": a grid of pet tiles (ViewportFrame, name, "x3" copies, a gold star when equipped).
--           UPGRADE lists every regular pet that can still go up a finish (3 copies needed, the others dimmed);
--           MIX lists every regular pet (hybrids are one of a kind and cannot be fused again).
--   right   the preview: UPGRADE = the input (x3) -> the next finish (Golden / Rainbow) in a big ViewportFrame with
--           its x1.5 / x2.5 bonus; MIX = Body + Style -> a preview of the hybrid (PetKeys.DefOf of a stand-in
--           record: the real one gets its own random look seed), its blended name, rarity, elements, tier.
--           Then the notes (copies that are equipped / working at home are taken off first; why a fusion is not
--           possible), the cost (TycoonCatalog.FusionCost with the machine's discount; red when short) and FUSE.
-- FUSE sends Remotes.Fusion("Upgrade", key) / ("Mix", keyA, keyB); the server checks everything again and answers
-- with Fusion:FireClient("Result", {Ok, Key, Name, Reason...}). On success a short fusion animation plays: the inputs
-- fly into the centre, a flash and a confetti burst, the new pet pops in with a NEW! ribbon, and a burst of glowing
-- cubes leaves the machine's output pod (client-only parts, gone after a second).
-- Readability rule: designed in 1080p pixels (body 18-19, captions 18, buttons 22, titles 28-34) under ONE
-- UIScale = min(screen factor, fit); the window adapts between 800x456 and 1080x700 design pixels so landscape
-- phones keep >= 14 px text; every text has a stroke and sits on a solid panel. Pet viewports are attached under a
-- per-frame time budget (cached Low clones in the grid, High in the preview), all on CloudUI's one update loop.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	warn("[FusionController] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetKeys = safeRequire("PetKeys")
local PetCatalog = safeRequire("PetCatalog")
local TycoonCatalog = safeRequire("TycoonCatalog")

local FusionController = {}
FusionController.Opened = Util.Signal()
FusionController.Closed = Util.Signal()

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen)
----------------------------------------------------------------------
local K = {
	PREF_W = 1080,
	PREF_H = 700,
	MIN_W = 800,
	MIN_H = 390,
	BUMPS = 28,
	MARGIN = 12,
	SHORT = 560, -- below this design height the compact layout is used (landscape phones)
	TOP_H = 54,
	TOP_H_SHORT = 44,
	-- portrait phones: the preview on top, the picker below (used when less than TALL_W design px are free)
	TALL_W = 700,
	PREF_W_TALL = 560,
	MIN_W_TALL = 360,
	PREF_H_TALL = 1000,
	MIN_H_TALL = 600,
	PREVIEW_TALL_H = 440,
	RESULT_TALL = 124,
	INPUT_TALL = 82,
	PICKER_W = 520,
	PICKER_W_NARROW = 396,
	NARROW = 960,
	GAP = 12,
	TILE_W = 112,
	TILE_H = 162,
	TILE_W_SHORT = 104,
	TILE_H_SHORT = 122,
	TILE_GAP = 10,
	RESULT = 176,
	RESULT_SHORT = 92,
	INPUT = 108,
	INPUT_SHORT = 68,
	TILE_BUDGET = 0.004, -- seconds of pet viewport building per frame (at least one per frame)
	TILES_MAX = 3,
	FUSE_TIMEOUT = 6, -- seconds the FUSE button waits for the server before it resets
	MACHINE_RANGE = 24, -- studs: the window closes when the player walks this far from the machine it opened at
	NEAR_RANGE = 30, -- studs: FUSE needs the player this close to their machine (the server allows a little more)
	BACK_ACTION = "NimbusFusionBack",
	DISPLAY_ORDER = 22, -- above NimbusMenu (20) and the Pet Index (21)
	PREVIEW_SEED = 4242, -- look seed of the Mix preview (the real hybrid draws its own)
}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token
local INK = Colors.TextStroke or Colors.Ink
local GOOD = Colors.Good
local BAD = Colors.Bad
local ACCENT = Color3.fromRGB(150, 104, 230) -- the machine's violet (title bar, tabs)
local INSET = Color3.fromRGB(20, 26, 66)
local TILE_FACE = Color3.fromRGB(58, 70, 136)
local TILE_SELECTED = Color3.fromRGB(110, 92, 196)
local WARN = Color3.fromRGB(255, 214, 110)
local TOKEN_INFO = Theme.Currency and Theme.Currency.Tokens or { Glyph = "\226\152\129", Color = GOLD }
local GEM_INFO = Theme.Currency and Theme.Currency.Gems or { Glyph = "\226\151\134", Color = Colors.Gem }
local TIER_COLORS = {
	Normal = Color3.fromRGB(150, 164, 196),
	Golden = Color3.fromRGB(240, 186, 60),
	Rainbow = Color3.fromRGB(214, 120, 230),
}
local G = {
	Crystal = "\240\159\148\174",
	Up = "\226\172\134",
	Dna = "\240\159\167\172",
	Arrow = "\226\150\182",
	Plus = "+",
	Star = "\226\152\133",
	Sparkle = "\226\156\168",
	Lock = "\240\159\148\146",
	Swap = "\226\135\132",
}
local NEXT_TIER = { Normal = "Golden", Golden = "Rainbow" }
local TIER_RANK = { Normal = 1, Golden = 2, Rainbow = 3 }

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local initialized = false
local LocalPlayer = nil
local warned = {}

local S = {
	Open = false,
	Built = false,
	Tab = "Upgrade",
	UpKey = nil, -- Upgrade input key
	MixA = nil, -- Mix: Body
	MixB = nil, -- Mix: Style
	Pending = nil, -- { Action, Token, At } while a request waits for the server
	Animating = false,
	Token = 0, -- bumps on every open / close (stale delayed callbacks check it)
	AtMachine = nil, -- the machine model the window was opened at (nil when opened from elsewhere)
	Tiles = {}, -- [key] = tile
	Queue = {}, -- tiles waiting for their viewport
	BackBound = false,
	Short = false,
	Narrow = false,
	Tall = false,
	Plan = nil,
	ResultSig = nil, -- what the result viewport shows (rebuilt only when it changes)
	InputSig = nil,
	FuseToken = 0,
}

local U = {} -- ui references

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[FusionController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function makeFrame(parent, name, props)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel with a readable stroke + glyph outline.
local function makeText(parent, name, text, role, size, color, props)
	local p = { Name = name }
	if props then
		for key, value in pairs(props) do
			p[key] = value
		end
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Stroke = 0.25,
		StrokeColor = INK,
		Outline = 1.5,
		OutlineColor = INK,
		Props = p,
	})
	label.Parent = parent
	return label
end

local function corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

local function round(parent)
	return Theme.Corner(parent, UDim.new(0.5, 0))
end

local function stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

local function pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

local function tween(inst, seconds, goal, style, direction)
	return Util.Tween(inst, seconds, goal, style, direction)
end

local function inset(parent, name, props)
	local p = props or {}
	p.BackgroundColor3 = INSET
	p.BackgroundTransparency = 0.38
	local frame = makeFrame(parent, name, p)
	corner(frame, 12)
	stroke(frame, Colors.WellEdge or NAVY, 3, 0.15)
	return frame
end

local function commas(n)
	return Util.Commas(math.max(0, math.floor(tonumber(n) or 0)))
end

local function rarityAccent(rarityId)
	if rarityId == "Secret" then
		return Color3.fromRGB(150, 110, 232)
	end
	return CloudUI.RarityColor(rarityId)
end

local function pill(parent, name, text, color, layoutOrder)
	local label = makeText(parent, name, text, "Label", 18, WHITE, {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Darken(color, 0.25),
		LayoutOrder = layoutOrder or 0,
	})
	round(label)
	stroke(label, NAVY, 2, 0)
	pad(label, 12, 0, 12, 1)
	return label
end

----------------------------------------------------------------------
-- Pets, rules and costs (a mirror of FusionService: the server decides)
----------------------------------------------------------------------
local function parse(key)
	if not PetKeys or type(key) ~= "string" then
		return nil
	end
	local ok, parsed = pcall(PetKeys.Parse, key)
	if ok and type(parsed) == "table" then
		return parsed
	end
	return nil
end

local function defOf(key)
	local ok, def = pcall(State.DefOf, key)
	if ok and type(def) == "table" then
		return def
	end
	if PetKeys then
		local ok2, def2 = pcall(PetKeys.DefOf, key, State.Get())
		if ok2 and type(def2) == "table" then
			return def2
		end
	end
	return nil
end

local function catalogDef(petId)
	if PetCatalog and type(PetCatalog.Get) == "function" and type(petId) == "string" then
		local ok, def = pcall(PetCatalog.Get, petId)
		if ok and type(def) == "table" then
			return def
		end
	end
	return nil
end

local function nameOf(def, key)
	if type(def) == "table" then
		return tostring(def.DisplayName or def.Name or key)
	end
	return tostring(key)
end

local function owned(key)
	local ok, n = pcall(State.OwnedCount, key)
	if ok and type(n) == "number" then
		return n
	end
	return 0
end

local function equippedCount(key)
	local ok, n = pcall(State.EquippedCount, key)
	if ok and type(n) == "number" then
		return n
	end
	return 0
end

local function homeOf()
	local ok, home = pcall(State.Home)
	if ok and type(home) == "table" then
		return home
	end
	return { Level = 0, Prestige = 0, Stations = {}, Garden = {}, Gym = {} }
end

local function balance(currency)
	if currency == "Gems" then
		local ok, n = pcall(State.Gems)
		return (ok and type(n) == "number") and n or 0
	end
	local ok, n = pcall(State.Tokens)
	return (ok and type(n) == "number") and n or 0
end

local function copiesNeeded()
	local f = TycoonCatalog and TycoonCatalog.Fusion
	local n = type(f) == "table" and tonumber(rawget(f, "Copies")) or nil
	if n and n >= 2 then
		return math.floor(n)
	end
	return 3
end

local function unlockStars()
	local p = TycoonCatalog and TycoonCatalog.Prestige
	local n = type(p) == "table" and tonumber(p.FusionUnlock) or nil
	return n and math.floor(n) or 1
end

local function machineLevel()
	local stations = homeOf().Stations
	local lv = type(stations) == "table" and tonumber(stations.FusionMachine) or nil
	return lv and math.floor(lv) or 0
end

-- ok, reason
local function unlocked()
	local home = homeOf()
	local stars = tonumber(home.Prestige) or 0
	if stars < unlockStars() then
		return false, G.Lock .. " The Fusion Machine unlocks at Prestige " .. unlockStars()
	end
	if machineLevel() < 1 then
		return false, G.Lock .. " Build the Fusion Machine at your home first"
	end
	return true
end

local function costOf(action, rarity, tier)
	if not TycoonCatalog or type(TycoonCatalog.FusionCost) ~= "function" then
		return nil
	end
	local ok, cost = pcall(TycoonCatalog.FusionCost, action, rarity, tier, machineLevel())
	if not ok or type(cost) ~= "table" then
		return nil
	end
	if type(cost.Gems) == "number" and cost.Gems > 0 then
		return { Currency = "Gems", Amount = math.ceil(cost.Gems) }
	end
	if type(cost.Tokens) == "number" then
		return { Currency = "Tokens", Amount = math.ceil(cost.Tokens) }
	end
	return nil
end

local function rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarityId then
			return r.Order or 0
		end
	end
	return 0
end

-- What taking these copies frees: notes for the player, and whether it would leave nothing equipped.
local function usageNotes(inputs)
	local snap = State.Get()
	local equippedTotal = type(snap.Equipped) == "table" and #snap.Equipped or 0
	local home = homeOf()
	local dropped, placedOff = 0, 0
	for _, input in ipairs(inputs) do
		local left = owned(input.Key) - input.Count
		dropped = dropped + math.max(0, equippedCount(input.Key) - left)
		local placed = 0
		for _, k in pairs(type(home.Garden) == "table" and home.Garden or {}) do
			if k == input.Key then
				placed = placed + 1
			end
		end
		for _, k in pairs(type(home.Gym) == "table" and home.Gym or {}) do
			if k == input.Key then
				placed = placed + 1
			end
		end
		placedOff = placedOff + math.max(0, placed - left)
	end
	-- every note has a Short form for the one-line layouts (landscape phones)
	local notes = {}
	if equippedTotal > 0 and dropped >= equippedTotal then
		return notes, "Those are your only equipped pets: unequip them or equip another pet first", "Equip another pet first"
	end
	if dropped > 0 then
		notes[#notes + 1] = {
			Text = dropped .. " equipped cop" .. (dropped == 1 and "y is" or "ies are") .. " taken off first; the new pet takes the slot",
			Short = "Unequips " .. dropped .. " cop" .. (dropped == 1 and "y" or "ies") .. " first",
			Color = WARN,
		}
	end
	if placedOff > 0 then
		notes[#notes + 1] = {
			Text = placedOff .. " cop" .. (placedOff == 1 and "y leaves" or "ies leave") .. " the Garden / Gym first; the new pet takes over",
			Short = placedOff .. " cop" .. (placedOff == 1 and "y leaves" or "ies leave") .. " the Garden / Gym first",
			Color = WARN,
		}
	end
	return notes, nil
end

-- The preview of the current selection (the same checks the server makes, in the same order).
local function computePlan()
	local plan = { Ok = false, Action = S.Tab, Notes = {} }
	local okUnlock, why = unlocked()
	if not okUnlock then
		plan.Reason = why
		plan.Locked = true
		return plan
	end
	if not PetKeys then
		plan.Reason = "Fusion is not available right now"
		return plan
	end
	if S.Tab == "Upgrade" then
		local key = S.UpKey
		local parsed = key and parse(key)
		if not parsed then
			plan.Reason = "Pick a pet with " .. copiesNeeded() .. " copies"
			plan.Empty = true
			return plan
		end
		local def = defOf(key)
		local base = catalogDef(parsed.PetId)
		local nextTier = NEXT_TIER[parsed.Tier]
		plan.Inputs = { { Key = key, Count = copiesNeeded() } }
		plan.InputDef = def
		if parsed.HybridId or not base then
			plan.Reason = "Hybrids are one of a kind: they cannot be upgraded"
			return plan
		end
		if not nextTier then
			plan.Reason = "Rainbow is the best finish: this pet cannot go higher"
			return plan
		end
		plan.Tier = nextTier
		plan.Rarity = base.Rarity
		plan.ResultKey = PetKeys.Make(parsed.PetId, nextTier)
		plan.ResultDef = plan.ResultKey and PetKeys.DefOf(plan.ResultKey) or nil
		plan.ResultName = nameOf(plan.ResultDef, plan.ResultKey)
		plan.Cost = costOf("Upgrade", base.Rarity, nextTier)
		local have = owned(key)
		if have < copiesNeeded() then
			plan.Reason = "You need " .. copiesNeeded() .. " copies of " .. nameOf(def, key) .. " (you have " .. have .. ")"
			return plan
		end
	elseif S.Tab == "Mix" then
		local a, b = S.MixA, S.MixB
		local pa, pb = a and parse(a), b and parse(b)
		plan.Inputs = {}
		if pa then
			plan.Inputs[#plan.Inputs + 1] = { Key = a, Count = 1 }
		end
		if pb then
			plan.Inputs[#plan.Inputs + 1] = { Key = b, Count = 1 }
		end
		if not pa or not pb then
			plan.Reason = "Pick two different pets to mix"
			plan.Empty = true
			return plan
		end
		if pa.HybridId or pb.HybridId then
			plan.Reason = "Hybrids cannot be mixed again: pick two regular pets"
			return plan
		end
		if pa.PetId == pb.PetId then
			plan.Reason = "Pick two different pets to mix"
			return plan
		end
		local baseA, baseB = catalogDef(pa.PetId), catalogDef(pb.PetId)
		if not baseA or not baseB then
			plan.Reason = "Unknown pet"
			return plan
		end
		local rarity = (rarityOrder(baseB.Rarity) > rarityOrder(baseA.Rarity)) and baseB.Rarity or baseA.Rarity
		local tier = ((TIER_RANK[pb.Tier] or 1) < (TIER_RANK[pa.Tier] or 1)) and pb.Tier or pa.Tier
		local name = "Hybrid"
		if type(PetKeys.BlendName) == "function" then
			local okName, blended = pcall(PetKeys.BlendName, baseA.Name, baseB.Name)
			if okName and type(blended) == "string" then
				name = blended
			end
		end
		local elements = {}
		for _, e in ipairs({ baseA.Element, baseB.Element }) do
			if type(e) == "string" and e ~= elements[1] then
				elements[#elements + 1] = e
			end
		end
		local record = { Body = pa.PetId, Style = pb.PetId, Tier = tier, Rarity = rarity, Name = name, Elements = elements, Seed = K.PREVIEW_SEED }
		local previewKey = PetKeys.HybridKey("preview", tier)
		local okDef, def = pcall(PetKeys.DefOf, previewKey, { Hybrids = { preview = record } })
		plan.ResultDef = okDef and def or nil
		plan.ResultName = (tier ~= "Normal" and (tier .. " ") or "") .. name
		plan.Rarity = rarity
		plan.Tier = tier
		plan.Elements = elements
		plan.Cost = costOf("Mix", rarity, nil)
		if owned(a) < 1 or owned(b) < 1 then
			plan.Reason = "You do not own those pets"
			return plan
		end
	else
		plan.Reason = "Pick a tab"
		return plan
	end
	if not plan.Cost then
		plan.Reason = "These pets cannot be fused"
		return plan
	end
	local notes, rule, ruleShort = usageNotes(plan.Inputs)
	plan.Notes = notes
	if rule then
		plan.Reason = rule
		plan.ReasonShort = ruleShort
		return plan
	end
	local have = balance(plan.Cost.Currency)
	plan.CanAfford = have >= plan.Cost.Amount
	if not plan.CanAfford then
		plan.Reason = "Not enough " .. ((plan.Cost.Currency == "Gems") and "Gems" or "Cloud Tokens") .. " (you have " .. commas(have) .. ")"
		return plan
	end
	if State.Get() and LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		plan.Reason = "Fusion is closed during a match"
		return plan
	end
	plan.Ok = true
	return plan
end

----------------------------------------------------------------------
-- The machine in the world (the player's own Station_FusionMachine)
----------------------------------------------------------------------
local function myMachine()
	local uid = LocalPlayer and LocalPlayer.UserId
	if not uid then
		return nil
	end
	for _, home in ipairs(CollectionService:GetTagged("NC_Home")) do
		if home:GetAttribute("OwnerUserId") == uid then
			local station = home:FindFirstChild("Station_FusionMachine")
			if station then
				return station
			end
		end
	end
	return nil
end

local function rootPart()
	local character = LocalPlayer and LocalPlayer.Character
	return character and character:FindFirstChild("HumanoidRootPart") or nil
end

local function distanceTo(model)
	local root = rootPart()
	if not root or not model or not model.Parent then
		return math.huge
	end
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if not ok or typeof(pivot) ~= "CFrame" then
		return math.huge
	end
	return (root.Position - pivot.Position).Magnitude
end

-- the output pod (where the FusionPrompt rides), or the model's pivot
local function outputPoint(model)
	if not model then
		return nil
	end
	local prompt = model:FindFirstChild("FusionPrompt", true)
	local holder = prompt and prompt.Parent
	if holder and holder:IsA("Attachment") then
		return holder.WorldPosition
	end
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if ok and typeof(pivot) == "CFrame" then
		return pivot.Position + Vector3.new(0, 3, 0)
	end
	return nil
end

----------------------------------------------------------------------
-- Layout (readability rule + fit)
----------------------------------------------------------------------
local function guiSize()
	local size = U.Gui and U.Gui.AbsoluteSize or Vector2.new(1280, 720)
	if size.X < 2 or size.Y < 2 then
		return Vector2.new(1280, 720)
	end
	return size
end

local function viewportHeight()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if vp and vp.Y > 2 then
		return vp.Y
	end
	return guiSize().Y
end

local function fitWindow()
	local area = guiSize()
	local factor = Theme.ScreenFactor(viewportHeight())
	local freeW = area.X - 2 * K.MARGIN
	local freeH = area.Y - 2 * K.MARGIN
	-- a screen too narrow for the side-by-side window (portrait phones) gets the tall layout
	local tall = freeW / factor < K.TALL_W and freeH > freeW
	local minW, prefW = K.MIN_W, K.PREF_W
	local minH, prefH = K.MIN_H, K.PREF_H
	if tall then
		minW, prefW = K.MIN_W_TALL, K.PREF_W_TALL
		minH, prefH = K.MIN_H_TALL, K.PREF_H_TALL
	end
	local w = Util.Clamp(math.floor(freeW / factor), minW, prefW)
	local h = Util.Clamp(math.floor((freeH - K.BUMPS * factor) / factor), minH, prefH)
	local scale = Util.Clamp(math.min(factor, freeW / w, freeH / h), 0.3, 1.25)
	local y = math.min(area.Y / 2 + K.BUMPS * scale / 2, area.Y - K.MARGIN / 2 - h * scale / 2)
	return w, h, scale, area.X / 2, math.max(y, h * scale / 2), tall
end

local layoutPreview -- defined below

local function relayout()
	if not S.Built then
		return
	end
	local w, h, scale, x, y, tall = fitWindow()
	U.Holder.Size = UDim2.fromOffset(w, h)
	U.Fit.Scale = scale
	U.Holder.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	S.Tall = tall
	local short = h < K.SHORT and not tall
	S.Short = short
	S.Narrow = w < K.NARROW
	local pickerW = S.Narrow and K.PICKER_W_NARROW or K.PICKER_W
	local topH = short and K.TOP_H_SHORT or K.TOP_H
	U.Top.Size = UDim2.new(1, -20, 0, topH)
	U.Top.Position = UDim2.fromOffset(10, short and 6 or 10)
	local tabW = short and 176 or 196
	if tall then
		tabW = math.floor((w - 20 - 30) / 2)
	end
	for i, name in ipairs({ "Upgrade", "Mix" }) do
		local tab = U.Tabs[name]
		tab.Size = UDim2.fromOffset(tabW, short and 42 or 50)
		tab.Position = UDim2.fromOffset((i - 1) * (tabW + 10), short and 1 or 2)
		tab.TextSize = short and 22 or 24
	end
	-- (the tall layout has no room for the balance chips: the cost line turns red and says what is missing)
	U.Chips.Visible = not tall
	U.Chips.Size = UDim2.new(0, 360, 0, short and 40 or 44)
	U.Chips.Position = UDim2.new(1, 0, 0, short and 2 or 5)
	for _, chip in ipairs({ U.TokenChip, U.GemChip }) do
		chip.Size = UDim2.fromOffset(0, short and 40 or 44)
		chip.TextSize = short and 22 or 24
	end
	U.Body.Position = UDim2.fromOffset(10, topH + (short and 12 or 16))
	U.Body.Size = UDim2.new(1, -20, 1, -(topH + (short and 18 or 26)))
	if tall then
		U.Preview.Position = UDim2.new(0, 0, 0, 0)
		U.Preview.Size = UDim2.new(1, 0, 0, K.PREVIEW_TALL_H)
		U.Picker.Position = UDim2.new(0, 0, 0, K.PREVIEW_TALL_H + K.GAP)
		U.Picker.Size = UDim2.new(1, 0, 1, -(K.PREVIEW_TALL_H + K.GAP))
	else
		U.Picker.Position = UDim2.new(0, 0, 0, 0)
		U.Picker.Size = UDim2.new(0, pickerW, 1, 0)
		U.Preview.Position = UDim2.new(0, pickerW + K.GAP, 0, 0)
		U.Preview.Size = UDim2.new(1, -(pickerW + K.GAP), 1, 0)
	end
	U.PickerTitle.Size = UDim2.new(0.45, 0, 0, short and 28 or 32)
	U.PickerTitle.Position = UDim2.fromOffset(14, short and 4 or 8)
	U.PickerHint.Position = UDim2.new(1, -14, 0, short and 4 or 10)
	U.Grid.Position = UDim2.fromOffset(8, short and 36 or 46)
	U.Grid.Size = UDim2.new(1, -16, 1, -(short and 42 or 54))
	U.GridLayout.CellSize = UDim2.fromOffset(short and K.TILE_W_SHORT or K.TILE_W, short and K.TILE_H_SHORT or K.TILE_H)
	for _, tile in pairs(S.Tiles) do
		tile.Mode = nil
	end
	layoutPreview()
end

----------------------------------------------------------------------
-- Back button (gamepad B) while the window is open
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		FusionController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function syncBackBinding()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		local ok, err = pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
		if not ok then
			warnOnce("bind back", err)
		end
	else
		task.defer(function()
			if not S.BackBound then
				pcall(function()
					ContextActionService:UnbindAction(K.BACK_ACTION)
				end)
			end
		end)
	end
end

----------------------------------------------------------------------
-- Pet tiles (left)
----------------------------------------------------------------------
local refresh -- defined below

-- keys the current tab lists, in display order
local function pickerKeys()
	local ok, keys = pcall(State.Keys)
	if not ok or type(keys) ~= "table" then
		keys = {}
	end
	local out = {}
	local need = copiesNeeded()
	for i, key in ipairs(keys) do
		local parsed = parse(key)
		if parsed and not parsed.HybridId then
			if S.Tab == "Mix" or NEXT_TIER[parsed.Tier] then
				out[#out + 1] = { Key = key, Order = i, Ready = owned(key) >= need }
			end
		end
	end
	if S.Tab == "Upgrade" then
		table.sort(out, function(a, b)
			if a.Ready ~= b.Ready then
				return a.Ready
			end
			return a.Order < b.Order
		end)
	end
	return out
end

local function destroyTileViewport(tile)
	if tile.Viewport then
		pcall(tile.Viewport.Destroy)
		tile.Viewport = nil
	end
end

local function buildTileViewport(tile)
	if tile.Viewport or not tile.Button.Parent then
		return
	end
	local def = defOf(tile.Key)
	if not def then
		return
	end
	tile.Viewport = CloudUI.PetViewport(tile.View, def, UDim2.new(1, 0, 1, 0), { Detail = "Low", Spin = "sway" })
end

local function onTileClicked(key)
	if S.Pending or S.Animating then
		return
	end
	if S.Tab == "Upgrade" then
		S.UpKey = (S.UpKey == key) and nil or key
	else
		if S.MixA == key then
			S.MixA = nil
		elseif S.MixB == key then
			S.MixB = nil
		elseif not S.MixA then
			S.MixA = key
		elseif not S.MixB then
			S.MixB = key
		else
			S.MixB = key
		end
	end
	refresh()
end

local function newTile(key)
	local tile = { Key = key }
	local button = Util.Create("TextButton", {
		Name = "Tile",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = TILE_FACE,
		Parent = U.Grid,
	})
	corner(button, 12)
	tile.Stroke = stroke(button, NAVY, 3, 0)
	Theme.Gradient(button, Color3.fromRGB(255, 255, 255), Color3.fromRGB(196, 204, 230), 90)
	tile.Button = button
	tile.View = makeFrame(button, "View", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(1, -16, 0, 92),
	})
	tile.Name = makeText(button, "PetName", "", "Label", 18, WHITE, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -6),
		Size = UDim2.new(1, -10, 0, 44),
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	tile.Count = makeText(button, "Count", "x1", "Heading", 18, WHITE, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -5, 0, 5),
		Size = UDim2.fromOffset(46, 26),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(30, 40, 90),
		ZIndex = 3,
	})
	round(tile.Count)
	stroke(tile.Count, NAVY, 2, 0)
	tile.Equipped = makeText(button, "Equipped", G.Star, "Heading", 18, GOLD, {
		Position = UDim2.fromOffset(5, 5),
		Size = UDim2.fromOffset(26, 26),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(30, 40, 90),
		ZIndex = 3,
		Visible = false,
	})
	round(tile.Equipped)
	-- the Mix pick order (1 = Body, 2 = Style) sits in the top-left corner, clear of the pet's face
	tile.Mark = makeText(button, "Mark", "", "Title", 20, WHITE, {
		Position = UDim2.fromOffset(4, 4),
		Size = UDim2.fromOffset(30, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = ACCENT,
		ZIndex = 4,
		Visible = false,
	})
	round(tile.Mark)
	stroke(tile.Mark, NAVY, 2, 0)
	tile.Dim = makeFrame(button, "Dim", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 0.5,
		BackgroundColor3 = Color3.fromRGB(10, 14, 36),
		ZIndex = 2,
		Visible = false,
	})
	corner(tile.Dim, 12)
	button.Activated:Connect(function()
		safe("tile", onTileClicked, key)
	end)
	S.Tiles[key] = tile
	S.Queue[#S.Queue + 1] = tile
	return tile
end

local function paintTile(tile, order, ready)
	local def = defOf(tile.Key)
	local mode = S.Short and "Short" or "Wide"
	if tile.Mode ~= mode then
		tile.Mode = mode
		tile.View.Size = UDim2.new(1, -16, 0, S.Short and 64 or 92)
		tile.Name.Size = UDim2.new(1, -10, 0, S.Short and 26 or 44)
		tile.Name.TextWrapped = not S.Short
		tile.Name.Position = UDim2.new(0.5, 0, 1, S.Short and -4 or -6)
	end
	tile.Button.LayoutOrder = order
	tile.Name.Text = nameOf(def, tile.Key)
	local n = owned(tile.Key)
	tile.Count.Text = "x" .. n
	local need = copiesNeeded()
	if S.Tab == "Upgrade" then
		tile.Count.BackgroundColor3 = (n >= need) and Theme.Darken(GOOD, 0.35) or Color3.fromRGB(30, 40, 90)
		tile.Dim.Visible = n < need
	else
		tile.Count.BackgroundColor3 = Color3.fromRGB(30, 40, 90)
		tile.Dim.Visible = false
	end
	tile.Equipped.Visible = equippedCount(tile.Key) > 0
	local selected = false
	local mark = nil
	if S.Tab == "Upgrade" then
		selected = S.UpKey == tile.Key
	else
		if S.MixA == tile.Key then
			selected, mark = true, "1"
		elseif S.MixB == tile.Key then
			selected, mark = true, "2"
		end
	end
	tile.Button.BackgroundColor3 = selected and TILE_SELECTED or TILE_FACE
	tile.Stroke.Color = selected and GOLD or NAVY
	tile.Stroke.Thickness = selected and 4 or 3
	tile.Mark.Visible = mark ~= nil
	tile.Mark.Text = mark or ""
	-- the equipped star moves down a row while the pick mark holds the corner
	tile.Equipped.Position = UDim2.fromOffset(mark and 6 or 5, mark and 38 or 5)
	local rarity = type(def) == "table" and def.Rarity or nil
	if not selected and rarity then
		tile.Stroke.Color = Theme.Darken(rarityAccent(rarity), 0.35)
	end
end

local function refreshTiles()
	local list = pickerKeys()
	local wanted = {}
	for i, entry in ipairs(list) do
		wanted[entry.Key] = true
		local tile = S.Tiles[entry.Key] or newTile(entry.Key)
		paintTile(tile, i, entry.Ready)
	end
	for key, tile in pairs(S.Tiles) do
		if not wanted[key] then
			destroyTileViewport(tile)
			tile.Button:Destroy()
			S.Tiles[key] = nil
		end
	end
	U.Empty.Visible = #list == 0
	if S.Tab == "Upgrade" then
		U.Empty.Text = "No pets to upgrade yet. Roll more copies at the roulettes!"
		U.PickerHint.Text = "Pick a pet with " .. copiesNeeded() .. " copies"
	else
		U.Empty.Text = "You need at least two different pets to mix."
		U.PickerHint.Text = "Pick two different pets"
	end
end

-- pet viewports under a per-frame time budget
local function fillViewports()
	if #S.Queue == 0 then
		return
	end
	local started = os.clock()
	local built = 0
	while #S.Queue > 0 and built < K.TILES_MAX do
		local tile = table.remove(S.Queue, 1)
		if tile.Button.Parent then
			safe("viewport", buildTileViewport, tile)
			built = built + 1
		end
		if os.clock() - started > K.TILE_BUDGET then
			break
		end
	end
end

----------------------------------------------------------------------
-- Preview (right)
----------------------------------------------------------------------
local function slotFrame(parent, name, size)
	local holder = makeFrame(parent, name, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(44, 54, 116),
		ZIndex = 3,
	})
	corner(holder, 14)
	local s = stroke(holder, NAVY, 3, 0)
	Theme.Gradient(holder, Color3.fromRGB(255, 255, 255), Color3.fromRGB(176, 186, 220), 90)
	local view = makeFrame(holder, "View", { Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), ZIndex = 4 })
	local q = makeText(holder, "Placeholder", "?", "Title", 40, MUTED, {
		Size = UDim2.new(1, 0, 1, 0),
		TextTransparency = 0.2,
		ZIndex = 4,
	})
	local scale = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = holder })
	return { Frame = holder, View = view, Stroke = s, Placeholder = q, Scale = scale, Viewport = nil, Def = nil }
end

local function setSlotPet(slot, def, detail)
	if slot.Def == def and slot.Viewport then
		return
	end
	if slot.Viewport then
		pcall(slot.Viewport.Destroy)
		slot.Viewport = nil
	end
	slot.Def = def
	slot.Placeholder.Visible = def == nil
	if def then
		local ok, handle = pcall(CloudUI.PetViewport, slot.View, def, UDim2.new(1, 0, 1, 0), { Detail = detail or "High", Spin = "spin", ZIndex = 4 })
		if ok then
			slot.Viewport = handle
		end
	end
end

layoutPreview = function()
	if not U.Preview then
		return
	end
	local short = S.Short
	local result = short and K.RESULT_SHORT or K.RESULT
	local input = short and K.INPUT_SHORT or K.INPUT
	if S.Tall then
		result, input = K.RESULT_TALL, K.INPUT_TALL
	end
	local mix = S.Tab == "Mix"
	U.PreviewTitle.Visible = not short
	local rowY = short and 4 or (S.Tall and 54 or 66)
	local rowH = result + ((mix or not short) and 26 or 8)
	U.SlotRow.Position = UDim2.new(0, 0, 0, rowY)
	U.SlotRow.Size = UDim2.new(1, 0, 0, rowH)
	local cy = result / 2 + 4
	-- result on the right third, inputs on the left
	U.ResultSlot.Frame.Size = UDim2.fromOffset(result, result)
	U.ResultSlot.Frame.Position = UDim2.new(0.76, 0, 0, cy)
	U.Arrow.Position = UDim2.new(0.53, 0, 0, cy)
	for _, slot in ipairs(U.InSlots) do
		slot.Frame.Size = UDim2.fromOffset(input, input)
	end
	if not mix then
		-- three copies fanned out like a stack of cards
		local fan = short and 10 or 16
		U.InSlots[1].Frame.Position = UDim2.new(0.25, -fan, 0, cy - fan * 0.75)
		U.InSlots[2].Frame.Position = UDim2.new(0.25, 0, 0, cy)
		U.InSlots[3].Frame.Position = UDim2.new(0.25, fan, 0, cy + fan * 0.75)
		U.InSlots[1].Frame.Rotation = -6
		U.InSlots[3].Frame.Rotation = 6
		U.InSlots[2].Frame.Rotation = 0
		U.InSlots[1].Frame.Visible = true
		U.InSlots[3].Frame.Visible = true
		U.Plus.Visible = false
		U.CaptionA.Visible = false
		U.CaptionB.Visible = false
		U.Swap.Visible = false
	else
		local gap = input * 0.62
		U.InSlots[1].Frame.Position = UDim2.new(0.25, -gap, 0, cy)
		U.InSlots[2].Frame.Position = UDim2.new(0.25, gap, 0, cy)
		U.InSlots[1].Frame.Rotation = 0
		U.InSlots[2].Frame.Rotation = 0
		U.InSlots[3].Frame.Visible = false
		U.InSlots[1].Frame.Visible = true
		U.Plus.Visible = true
		U.Plus.Position = UDim2.new(0.25, 0, 0, cy)
		U.CaptionA.Visible = true
		U.CaptionB.Visible = true
		U.CaptionA.Position = UDim2.new(0.25, -gap, 0, cy + input / 2 + 2)
		U.CaptionB.Position = UDim2.new(0.25, gap, 0, cy + input / 2 + 2)
		U.Swap.Visible = S.MixA ~= nil and S.MixB ~= nil
		U.Swap.Position = UDim2.new(0.25, 0, 0, cy - input / 2 - 2)
	end
	local y = rowY + rowH + 2
	if short then
		-- no room for the pills: the name (in its rarity colour) and a summary line instead
		U.ResultName.Position = UDim2.new(0, 14, 0, y)
		U.ResultName.Size = UDim2.new(1, -28, 0, 30)
		U.ResultName.TextSize = 24
		U.Pills.Visible = false
		y = y + 32
	else
		U.Pills.Visible = true
		U.ResultName.Position = UDim2.new(0, 14, 0, y)
		U.ResultName.Size = UDim2.new(1, -28, 0, 36)
		U.ResultName.TextSize = 28
		y = y + 38
		U.Pills.Position = UDim2.new(0, 14, 0, y)
		U.Pills.Size = UDim2.new(1, -28, 0, 32)
		U.PillsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
		y = y + 40
	end
	local compact = short or S.Tall
	local bottomH = short and 52 or 64
	U.Bottom.Size = UDim2.new(1, -28, 0, bottomH)
	U.Bottom.Position = UDim2.new(0, 14, 1, short and -6 or -12)
	U.Cost.TextSize = compact and 24 or 28
	U.FuseButton.Size = UDim2.fromOffset(compact and 170 or 214, short and 48 or 58)
	U.FuseButton.TextSize = compact and 24 or 28
	-- on a phone Roblox's jump button covers the bottom-right corner: FUSE goes to the left and the cost follows it
	-- (left-aligned right after the button), so the corner under the jump button stays empty
	local leftFuse = short and UserInputService.TouchEnabled
	S.CostOnly = leftFuse -- the cost shows without its "Cost:" label there (shorter, clear of the jump button)
	local fuseW = compact and 170 or 214
	U.FuseButton.AnchorPoint = leftFuse and Vector2.new(0, 0.5) or Vector2.new(1, 0.5)
	U.FuseButton.Position = leftFuse and UDim2.new(0, 0, 0.5, 0) or UDim2.new(1, 0, 0.5, 0)
	U.Cost.AnchorPoint = Vector2.new(0, 0.5)
	U.Cost.Position = leftFuse and UDim2.new(0, fuseW + 14, 0.5, 0) or UDim2.new(0, 0, 0.5, 0)
	U.Cost.TextXAlignment = Enum.TextXAlignment.Left
	U.Cost.Size = UDim2.new(1, -(fuseW + 14), 0, 40)
	U.Details.Position = UDim2.new(0, 14, 0, y)
	U.Details.Size = UDim2.new(1, -28, 1, -(y + bottomH + (short and 8 or 20)))
	U.ServerNote.Position = UDim2.new(0, 14, 1, -(bottomH + (short and 10 or 18)))
	-- the locked card: a smaller crystal and no teaser line on short screens
	if U.LockedSub then
		U.LockedSub.Visible = not short
		U.LockedIcon.Size = short and UDim2.fromOffset(64, 64) or UDim2.fromOffset(90, 90)
		U.LockedIcon.TextSize = short and 46 or 64
		U.LockedIcon.Position = UDim2.new(0.5, 0, short and 0.42 or 0.4, 0)
		U.LockedText.Position = UDim2.new(0.5, 0, short and 0.46 or 0.43, 0)
		U.LockedSub.Position = UDim2.new(0.5, 0, 0.43, 70)
	end
end

local function setNotes(plan)
	for _, child in ipairs(U.Details:GetChildren()) do
		if child:IsA("TextLabel") and child ~= U.Info then
			child:Destroy()
		end
	end
	U.Info.Visible = true
	S.NotesToken = (S.NotesToken or 0) + 1
	local mine = S.NotesToken
	local order = 1
	local function add(text, color)
		order = order + 1
		makeText(U.Details, "Note" .. order, text, "Body", 18, color or MUTED, {
			Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			LayoutOrder = order,
		})
	end
	local lines = {}
	if plan.Reason and not plan.Empty then
		lines[#lines + 1] = { Text = plan.Reason, Short = plan.ReasonShort, Color = BAD }
	end
	for _, note in ipairs(plan.Notes or {}) do
		lines[#lines + 1] = note
	end
	if plan.Ok and not S.MachineNear then
		lines[#lines + 1] = { Text = "Walk up to your Fusion Machine to fuse", Color = WARN }
	end
	if S.Short or (S.Tall and #lines > 0) then
		-- one line only: the most important note replaces the summary / explanation
		local first = lines[1]
		if first then
			U.Info.Text = (S.Short and first.Short) or first.Text
			U.Info.TextColor3 = first.Color or MUTED
		end
		return
	end
	for _, line in ipairs(lines) do
		add(line.Text, line.Color)
	end
	-- when the explanation and the notes do not both fit (smaller screens, long names), the notes win: the general
	-- explanation steps aside instead of a warning being clipped at the bottom
	if #lines > 0 then
		local function fit()
			-- (a newer refresh owns the details now; the one-line layouts never hide their only line)
			if S.NotesToken ~= mine or S.Short or S.Tall or not U.Details or not U.Info.Parent then
				return
			end
			U.Info.Visible = true
			-- the stacked height of the lines (their absolute sizes plus the list padding)
			local scale = (U.Fit and U.Fit.Scale) or 1
			local used, n = 0, 0
			for _, child in ipairs(U.Details:GetChildren()) do
				if child:IsA("GuiObject") and child.Visible then
					used = used + child.AbsoluteSize.Y
					n = n + 1
				end
			end
			used = used + math.max(0, n - 1) * 6 * scale
			local room = U.Details.AbsoluteSize.Y
			if room > 0 and used > room + 1 then
				U.Info.Visible = false
			end
		end
		fit()
		task.defer(fit)
	end
end

local function renderPills(plan)
	for _, child in ipairs(U.Pills:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	if not plan.ResultDef then
		return
	end
	if plan.Rarity then
		pill(U.Pills, "Rarity", tostring(plan.Rarity), rarityAccent(plan.Rarity), 1)
	end
	if plan.Tier and plan.Tier ~= "Normal" then
		pill(U.Pills, "Tier", plan.Tier, TIER_COLORS[plan.Tier] or ACCENT, 2)
	end
	local elements = plan.Elements
	if not elements and type(plan.ResultDef) == "table" then
		elements = plan.ResultDef.Elements or { plan.ResultDef.Element }
	end
	for i, e in ipairs(elements or {}) do
		local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[e]
		if info then
			pill(U.Pills, "Element" .. i, e, info.Color, 2 + i)
		end
	end
end

-- "Legendary  Frost + Flame" (the compact layout shows this line instead of the pills)
local function summaryText(plan)
	local parts = {}
	if plan.Rarity then
		parts[#parts + 1] = tostring(plan.Rarity)
	end
	if plan.Tier and plan.Tier ~= "Normal" then
		parts[#parts + 1] = plan.Tier
	end
	local elements = plan.Elements
	if not elements and type(plan.ResultDef) == "table" then
		elements = plan.ResultDef.Elements or { plan.ResultDef.Element }
	end
	if elements and #elements > 0 then
		parts[#parts + 1] = table.concat(elements, " + ")
	end
	return table.concat(parts, "  |  ")
end

local function infoText(plan)
	if S.Short then
		if plan.ResultDef then
			return summaryText(plan)
		end
		return (S.Tab == "Upgrade") and "3 copies fuse into the next finish" or "Two different pets make a new hybrid"
	end
	if S.Tab == "Upgrade" then
		if plan.Tier == "Golden" then
			return "3 copies become 1 Golden copy: stats and perks x1.5 and a gold shine."
		elseif plan.Tier == "Rainbow" then
			return "3 Golden copies become 1 Rainbow copy: stats and perks x2.5 and a rainbow shimmer."
		end
		return "3 copies of a pet fuse into its next finish: Golden (x1.5), then Rainbow (x2.5)."
	end
	if plan.ResultDef then
		return "Body gives the shape, Style the colours and wings. Stats: average x1.2. Every hybrid is unique!"
	end
	return "Mix two different pets into a brand-new hybrid with both elements."
end

local function renderPreview(plan)
	U.PreviewTitle.Text = (S.Tab == "Upgrade") and (G.Up .. " Upgrade") or (G.Dna .. " Mix")
	-- inputs
	local inputs = {}
	if S.Tab == "Upgrade" then
		local def = S.UpKey and defOf(S.UpKey) or nil
		local have = S.UpKey and owned(S.UpKey) or 0
		for i = 1, 3 do
			inputs[i] = (def and i <= math.max(1, math.min(have, 3))) and def or nil
		end
		U.InCount.Visible = def ~= nil
		U.InCount.Text = math.min(have, copiesNeeded()) .. "/" .. copiesNeeded()
		U.InCount.BackgroundColor3 = (have >= copiesNeeded()) and Theme.Darken(GOOD, 0.3) or Theme.Darken(BAD, 0.2)
	else
		inputs[1] = S.MixA and defOf(S.MixA) or nil
		inputs[2] = S.MixB and defOf(S.MixB) or nil
		U.InCount.Visible = false
	end
	for i, slot in ipairs(U.InSlots) do
		setSlotPet(slot, inputs[i], (S.Tab == "Upgrade" and i ~= 2) and "Low" or "High")
	end
	-- result
	if not S.Animating then
		setSlotPet(U.ResultSlot, plan.ResultDef, "High")
		U.ResultSlot.Stroke.Color = plan.Rarity and rarityAccent(plan.Rarity) or NAVY
	end
	U.ResultName.Text = plan.ResultName or ((S.Tab == "Upgrade") and "Pick a pet" or "Pick two pets")
	U.ResultName.TextColor3 = plan.ResultDef and (S.Short and plan.Rarity and Theme.Lighten(rarityAccent(plan.Rarity), 0.35) or WHITE) or MUTED
	renderPills(plan)
	U.Info.Text = infoText(plan)
	U.Info.TextColor3 = MUTED
	setNotes(plan)
	-- cost
	if plan.Cost then
		local info = (plan.Cost.Currency == "Gems") and GEM_INFO or TOKEN_INFO
		U.Cost.Text = (S.CostOnly and "" or "Cost: ") .. tostring(info.Glyph) .. " " .. commas(plan.Cost.Amount)
		U.Cost.TextColor3 = (plan.CanAfford == false) and BAD or (info.Color or GOLD)
	else
		U.Cost.Text = "Cost: -"
		U.Cost.TextColor3 = MUTED
	end
	local can = plan.Ok and S.MachineNear and not S.Pending and not S.Animating
	CloudUI.SetDisabled(U.FuseButton, not can)
	if S.Pending then
		U.FuseButton.Text = "Fusing..."
	else
		U.FuseButton.Text = G.Sparkle .. " FUSE"
	end
	U.Locked.Visible = plan.Locked == true
	if plan.Locked then
		U.LockedText.Text = plan.Reason or ""
	end
end

local function renderTop()
	U.TokenChip.Text = tostring(TOKEN_INFO.Glyph) .. " " .. Theme.ShortNumber(balance("Tokens"))
	U.GemChip.Text = tostring(GEM_INFO.Glyph) .. " " .. Theme.ShortNumber(balance("Gems"))
	for name, button in pairs(U.Tabs) do
		local on = name == S.Tab
		CloudUI.SetStyle(button, on and "Pink" or "Blue")
		local scale = button:FindFirstChild("TabScale")
		if scale then
			scale.Scale = on and 1 or 0.94
		end
	end
end

refresh = function()
	if not S.Built then
		return
	end
	-- drop selections the player no longer owns (fused away, traded...)
	if S.UpKey and owned(S.UpKey) < 1 then
		S.UpKey = nil
	end
	if S.MixA and owned(S.MixA) < 1 then
		S.MixA = nil
	end
	if S.MixB and owned(S.MixB) < 1 then
		S.MixB = nil
	end
	local machine = S.AtMachine or myMachine()
	S.MachineNear = machine ~= nil and distanceTo(machine) <= K.NEAR_RANGE
	if not machine and not myMachine() then
		-- no machine in the world to stand at (homes not built yet): the server decides
		S.MachineNear = true
	end
	renderTop()
	refreshTiles()
	layoutPreview()
	local plan = computePlan()
	S.Plan = plan
	renderPreview(plan)
end

----------------------------------------------------------------------
-- Fusing + the fusion animation
----------------------------------------------------------------------
local function burst(parent, color, amount, centre)
	local rng = Random.new()
	for i = 1, amount do
		local size = rng:NextInteger(9, 16)
		local pieceColor = color
		if i % 3 == 0 then
			pieceColor = GOLD
		elseif i % 3 == 1 then
			pieceColor = Theme.Lighten(color, 0.5)
		end
		local piece = makeFrame(parent, "Confetti", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = centre,
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 0,
			BackgroundColor3 = pieceColor,
			Rotation = rng:NextInteger(0, 90),
			ZIndex = 12,
		})
		corner(piece, 2)
		local angle = rng:NextNumber(0, math.pi * 2)
		local distance = rng:NextNumber(70, 190)
		local target = UDim2.new(centre.X.Scale, centre.X.Offset + math.cos(angle) * distance, centre.Y.Scale, centre.Y.Offset + math.sin(angle) * distance * 0.7 - 20)
		local seconds = rng:NextNumber(0.6, 1.1)
		tween(piece, seconds, { Position = target, Rotation = piece.Rotation + rng:NextInteger(-200, 200) })
		tween(piece, seconds, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(piece, seconds + 0.1)
	end
end

-- glowing cubes bursting out of the machine's output pod (client-only parts)
local function machineBurst(color)
	local machine = S.AtMachine or myMachine()
	local at = outputPoint(machine)
	if not at then
		return
	end
	local folder = workspace:FindFirstChild("ClientFx") or workspace
	local rng = Random.new()
	for i = 1, 10 do
		local part = Instance.new("Part")
		part.Name = "FusionSpark"
		part.Anchored = true
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = (i % 3 == 0) and GOLD or ((i % 3 == 1) and color or Theme.Lighten(color, 0.5))
		part.Size = Vector3.new(0.4, 0.4, 0.4)
		part.CFrame = CFrame.new(at)
		part.Parent = folder
		local dir = Vector3.new(rng:NextNumber(-1, 1), rng:NextNumber(0.6, 1.6), rng:NextNumber(-1, 1)).Unit
		tween(part, 0.8, { CFrame = CFrame.new(at + dir * rng:NextNumber(3, 6)) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), 0), Transparency = 1, Size = Vector3.new(0.1, 0.1, 0.1) })
		Debris:AddItem(part, 0.9)
	end
	local flash = Instance.new("Part")
	flash.Name = "FusionFlash"
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanTouch = false
	flash.CanQuery = false
	flash.CastShadow = false
	flash.Shape = Enum.PartType.Ball
	flash.Material = Enum.Material.Neon
	flash.Color = Theme.Lighten(color, 0.4)
	flash.Size = Vector3.new(1, 1, 1)
	flash.Transparency = 0.2
	flash.CFrame = CFrame.new(at)
	flash.Parent = folder
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 14
	light.Brightness = 2
	light.Parent = flash
	tween(flash, 0.5, { Size = Vector3.new(5, 5, 5), Transparency = 1 })
	tween(light, 0.5, { Brightness = 0 })
	Debris:AddItem(flash, 0.6)
end

local function slotCentre(slot)
	return slot.Frame.Position
end

local function playFusion(resultKey, rarity)
	S.Animating = true
	local mine = S.Token
	local color = rarity and rarityAccent(rarity) or ACCENT
	local target = slotCentre(U.ResultSlot)
	-- 1) the inputs fly into the machine (the result slot), spinning and shrinking
	local starts = {}
	for i, slot in ipairs(U.InSlots) do
		if slot.Frame.Visible then
			starts[i] = { Position = slot.Frame.Position, Rotation = slot.Frame.Rotation }
			tween(slot.Frame, 0.45, { Position = target, Rotation = slot.Frame.Rotation + 180 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tween(slot.Scale, 0.45, { Scale = 0.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
	end
	tween(U.ResultSlot.Scale, 0.45, { Scale = 0.7 })
	task.delay(0.45, function()
		if S.Token ~= mine then
			return
		end
		-- 2) a flash and a burst
		U.Flash.Position = target
		U.Flash.Size = UDim2.fromOffset(40, 40)
		U.Flash.BackgroundTransparency = 0.1
		U.Flash.BackgroundColor3 = Theme.Lighten(color, 0.6)
		U.Flash.Visible = true
		tween(U.Flash, 0.35, { Size = UDim2.fromOffset(300, 300), BackgroundTransparency = 1 })
		burst(U.SlotRow, color, 26, target)
		safe("machine fx", machineBurst, color)
		for i, slot in ipairs(U.InSlots) do
			if starts[i] then
				slot.Frame.Visible = false
			end
		end
		-- 3) the new pet pops in
		local def = defOf(resultKey)
		if def then
			setSlotPet(U.ResultSlot, def, "High")
		end
		U.ResultSlot.Scale.Scale = 0.4
		tween(U.ResultSlot.Scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		U.ResultSlot.Stroke.Color = color
		U.NewTag.Visible = true
		U.NewTag.Rotation = -8
		U.NewTag.Position = UDim2.new(target.X.Scale, target.X.Offset + 50, 0, target.Y.Offset - 70)
		if def then
			U.ResultName.Text = nameOf(def, resultKey)
		end
		task.delay(1.6, function()
			if S.Token ~= mine then
				return
			end
			-- 4) back to picking
			for i, slot in ipairs(U.InSlots) do
				if starts[i] then
					slot.Frame.Position = starts[i].Position
					slot.Frame.Rotation = starts[i].Rotation
					slot.Scale.Scale = 1
					slot.Frame.Visible = true
				end
			end
			U.Flash.Visible = false
			U.NewTag.Visible = false
			S.Animating = false
			refresh()
		end)
	end)
end

local function resetAnimation()
	S.Animating = false
	if not S.Built then
		return
	end
	for _, slot in ipairs(U.InSlots) do
		slot.Scale.Scale = 1
	end
	U.ResultSlot.Scale.Scale = 1
	U.Flash.Visible = false
	U.NewTag.Visible = false
end

local fusionRemote = nil
local function getRemote()
	if fusionRemote then
		return fusionRemote
	end
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("Fusion")
	if remote and remote:IsA("RemoteEvent") then
		fusionRemote = remote
	end
	return fusionRemote
end

function FusionController.Fuse()
	if not S.Open or S.Pending or S.Animating then
		return false
	end
	local plan = computePlan()
	S.Plan = plan
	if not plan.Ok or not S.MachineNear then
		refresh()
		return false
	end
	local remote = getRemote()
	if not remote then
		warnOnce("remote", "the Fusion remote is missing")
		return false
	end
	S.FuseToken = S.FuseToken + 1
	local token = S.FuseToken
	S.Pending = { Action = plan.Action, Token = token, At = os.clock(), Inputs = plan.Inputs }
	if plan.Action == "Upgrade" then
		remote:FireServer("Upgrade", S.UpKey)
	else
		remote:FireServer("Mix", S.MixA, S.MixB)
	end
	-- the inputs glow while the machine works
	for _, slot in ipairs(U.InSlots) do
		if slot.Frame.Visible then
			slot.Stroke.Color = GOLD
		end
	end
	refresh()
	task.delay(K.FUSE_TIMEOUT, function()
		if S.Pending and S.Pending.Token == token then
			S.Pending = nil
			refresh()
		end
	end)
	return true
end

local function onResult(payload)
	if type(payload) ~= "table" then
		return
	end
	local pending = S.Pending
	S.Pending = nil
	if payload.Ok == true and type(payload.Key) == "string" then
		local key = payload.Key
		if not S.Built or not S.Open then
			return
		end
		-- the inputs are gone: start the next pick from the new pet when it can go on
		local parsed = parse(key)
		if S.Tab == "Upgrade" then
			S.UpKey = (parsed and NEXT_TIER[parsed.Tier]) and key or nil
		else
			S.MixA, S.MixB = nil, nil
		end
		local function play()
			if S.Open and S.Built then
				playFusion(key, payload.Rarity)
			end
		end
		if defOf(key) then
			play()
		else
			-- the profile snapshot with the new pet may land a moment after the answer
			local conn
			local done = false
			conn = State.Changed:Connect(function()
				if not done and defOf(key) then
					done = true
					conn:Disconnect()
					play()
				end
			end)
			task.delay(2, function()
				if not done then
					done = true
					conn:Disconnect()
					play()
				end
			end)
		end
	else
		if pending and S.Built then
			if not payload.Quiet then
				local reason = type(payload.Reason) == "string" and payload.Reason or "That fusion did not work"
				U.ServerNote.Text = reason
				U.ServerNote.Visible = true
				local mine = S.Token
				task.delay(4, function()
					if S.Token == mine and U.ServerNote then
						U.ServerNote.Visible = false
					end
				end)
			end
			refresh()
		end
	end
end

----------------------------------------------------------------------
-- Window
----------------------------------------------------------------------
local function setTab(tab)
	if tab ~= "Upgrade" and tab ~= "Mix" then
		return
	end
	if S.Tab ~= tab then
		S.Tab = tab
		resetAnimation()
		if U.Grid then
			U.Grid.CanvasPosition = Vector2.new(0, 0)
		end
	end
	refresh()
end

local function buildTop(content)
	local top = makeFrame(content, "Top", {
		Position = UDim2.fromOffset(10, 10),
		Size = UDim2.new(1, -20, 0, K.TOP_H),
	})
	U.Top = top
	U.Tabs = {}
	local x = 0
	for _, spec in ipairs({ { "Upgrade", G.Up .. " UPGRADE" }, { "Mix", G.Dna .. " MIX" } }) do
		local name = spec[1]
		local button = CloudUI.Button({
			Name = "Tab_" .. name,
			Text = spec[2],
			Style = "Blue",
			Size = UDim2.fromOffset(196, 50),
			Position = UDim2.fromOffset(x, 2),
			TextSize = 24,
			Callback = function()
				safe("tab", setTab, name)
			end,
			Parent = top,
		})
		Util.Create("UIScale", { Name = "TabScale", Scale = 1, Parent = button })
		U.Tabs[name] = button
		x = x + 208
	end
	local function chip(name, color)
		local label = makeText(top, name, "", "Display", 24, color, {
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 44),
			BackgroundTransparency = 0,
			BackgroundColor3 = Color3.fromRGB(26, 34, 78),
			LayoutOrder = 1,
		})
		round(label)
		stroke(label, NAVY, 3, 0)
		pad(label, 16, 0, 16, 2)
		return label
	end
	local chips = makeFrame(top, "Chips", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 5),
		Size = UDim2.new(0, 360, 0, 44),
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Right,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = chips,
	})
	U.Chips = chips
	U.TokenChip = chip("Tokens", TOKEN_INFO.Color or GOLD)
	U.TokenChip.Parent = chips
	U.TokenChip.LayoutOrder = 1
	U.GemChip = chip("Gems", GEM_INFO.Color or Colors.Gem)
	U.GemChip.Parent = chips
	U.GemChip.LayoutOrder = 2
end

local function buildPicker(body)
	local picker = inset(body, "Picker", { Size = UDim2.new(0, K.PICKER_W, 1, 0) })
	U.Picker = picker
	U.PickerTitle = makeText(picker, "Title", "Your pets", "Heading", 24, WHITE, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(0.45, 0, 0, 32),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	U.PickerHint = makeText(picker, "Hint", "", "Body", 18, MUTED, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 10),
		Size = UDim2.new(0.58, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local grid = Util.Create("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, 46),
		Size = UDim2.new(1, -16, 1, -54),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 10,
		ScrollBarImageColor3 = Colors.FrameTop or Colors.Cloud,
		ScrollBarImageTransparency = 0.1,
		Parent = picker,
	})
	pad(grid, 4, 4, 14, 8)
	U.Grid = grid
	U.GridLayout = Util.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(K.TILE_W, K.TILE_H),
		CellPadding = UDim2.fromOffset(K.TILE_GAP, K.TILE_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		Parent = grid,
	})
	U.Empty = makeText(picker, "Empty", "", "Body", 19, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -60, 0, 80),
		TextWrapped = true,
		Visible = false,
	})
end

local function buildPreview(body)
	local preview = inset(body, "Preview", {
		Position = UDim2.new(0, K.PICKER_W + K.GAP, 0, 0),
		Size = UDim2.new(1, -(K.PICKER_W + K.GAP), 1, 0),
	})
	U.Preview = preview
	U.PreviewTitle = makeText(preview, "Title", "", "Title", 30, WHITE, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.new(1, -28, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
	})
	U.SlotRow = makeFrame(preview, "Slots", { Size = UDim2.new(1, 0, 0, 190), ZIndex = 3 })
	U.InSlots = {}
	for i = 1, 3 do
		U.InSlots[i] = slotFrame(U.SlotRow, "Input" .. i, K.INPUT)
	end
	-- the middle card of the Upgrade stack sits on top
	U.InSlots[2].Frame.ZIndex = 5
	U.InCount = makeText(U.InSlots[2].Frame, "Copies", "0/3", "Heading", 20, WHITE, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(64, 30),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(30, 40, 90),
		ZIndex = 8,
		Visible = false,
	})
	round(U.InCount)
	stroke(U.InCount, NAVY, 2, 0)
	U.Plus = makeText(U.SlotRow, "Plus", G.Plus, "Title", 40, WHITE, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(40, 40),
		ZIndex = 6,
	})
	U.CaptionA = makeText(U.SlotRow, "Body", "Body", "Heading", 18, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(110, 24),
	})
	U.CaptionB = makeText(U.SlotRow, "Style", "Style", "Heading", 18, MUTED, {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(110, 24),
	})
	U.Swap = CloudUI.Button({
		Name = "Swap",
		Text = G.Swap,
		Style = "Blue",
		TextSize = 22,
		Size = UDim2.fromOffset(44, 36),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 7,
		Callback = function()
			if not S.Pending and not S.Animating then
				S.MixA, S.MixB = S.MixB, S.MixA
				safe("swap", refresh)
			end
		end,
		Parent = U.SlotRow,
	})
	local swapPad = U.Swap:FindFirstChildOfClass("UIPadding")
	if swapPad then
		swapPad.PaddingLeft = UDim.new(0, 0)
		swapPad.PaddingRight = UDim.new(0, 0)
	end
	U.Arrow = makeText(U.SlotRow, "Arrow", G.Arrow, "Title", 36, GOLD, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(44, 44),
		ZIndex = 4,
	})
	U.ResultSlot = slotFrame(U.SlotRow, "Result", K.RESULT)
	U.ResultSlot.Frame.ZIndex = 6
	U.Flash = makeFrame(U.SlotRow, "Flash", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1,
		BackgroundColor3 = WHITE,
		ZIndex = 11,
		Visible = false,
	})
	round(U.Flash)
	U.NewTag = makeText(U.SlotRow, "New", "NEW!", "Title", 26, WHITE, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(92, 38),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(232, 84, 120),
		ZIndex = 13,
		Visible = false,
	})
	corner(U.NewTag, 10)
	stroke(U.NewTag, NAVY, 3, 0)

	U.ResultName = makeText(preview, "ResultName", "", "Title", 28, WHITE, {
		Size = UDim2.new(1, -28, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.Pills = makeFrame(preview, "Pills", { Size = UDim2.new(1, -28, 0, 32) })
	U.PillsLayout = Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = U.Pills,
	})
	-- the explanation and the notes share one list, so they never overlap
	U.Details = makeFrame(preview, "Details", { Size = UDim2.new(1, -28, 0, 100), ClipsDescendants = true })
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 6),
		Parent = U.Details,
	})
	U.Info = makeText(U.Details, "Info", "", "Body", 18, MUTED, {
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 1,
	})
	-- the cost and the FUSE button along the bottom
	local bottom = makeFrame(preview, "Bottom", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -12),
		Size = UDim2.new(1, -28, 0, 64),
	})
	U.Bottom = bottom
	U.Cost = makeText(bottom, "Cost", "Cost: -", "Display", 28, GOLD, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -230, 0, 40),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	U.FuseButton = CloudUI.Button({
		Name = "Fuse",
		Text = G.Sparkle .. " FUSE",
		Style = "Green",
		TextSize = 28,
		Size = UDim2.fromOffset(214, 62),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Callback = function()
			safe("fuse", FusionController.Fuse)
		end,
		Parent = bottom,
	})
	U.ServerNote = makeText(preview, "ServerNote", "", "Body", 18, BAD, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -82),
		Size = UDim2.new(1, -28, 0, 26),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.fromRGB(40, 20, 50),
		TextWrapped = true,
		Visible = false,
		ZIndex = 6,
	})
	corner(U.ServerNote, 8)

	-- locked overlay (no Prestige / no machine yet): an opaque card (nothing of the preview shows through it) with the
	-- crystal, the reason and a line about what the machine will do
	U.Locked = makeFrame(preview, "Locked", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE, -- the gradient below colours it
		ZIndex = 20,
		Visible = false,
	})
	corner(U.Locked, 12)
	Theme.Gradient(U.Locked, Color3.fromRGB(58, 46, 120), Color3.fromRGB(18, 22, 56), 90)
	U.LockedIcon = makeText(U.Locked, "Icon", G.Crystal, "Title", 64, WHITE, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.45, 0),
		Size = UDim2.fromOffset(90, 90),
		ZIndex = 21,
	})
	U.LockedText = makeText(U.Locked, "Text", "", "Heading", 24, WHITE, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.48, 0),
		Size = UDim2.new(1, -60, 0, 64),
		TextWrapped = true,
		ZIndex = 21,
	})
	U.LockedSub = makeText(U.Locked, "Sub", "Fuse 3 copies into a Golden or Rainbow pet, or mix two pets into a brand-new hybrid!",
		"Body", 19, Color3.fromRGB(196, 186, 240), {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.48, 70),
			Size = UDim2.new(1, -60, 0, 52),
			TextWrapped = true,
			ZIndex = 21,
		})
end

local function buildWindow()
	if S.Built then
		return true
	end
	local holder = makeFrame(U.Gui, "Window_Fusion", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(K.PREF_W, K.PREF_H),
		Visible = false,
		ZIndex = 3,
	})
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	local panel = CloudUI.Panel({
		Name = "FusionPanel",
		Title = G.Crystal .. " Fusion Machine",
		Closable = true,
		Accent = ACCENT,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			FusionController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	buildTop(content)
	U.Body = makeFrame(content, "Body", {
		Position = UDim2.fromOffset(10, K.TOP_H + 16),
		Size = UDim2.new(1, -20, 1, -(K.TOP_H + 26)),
	})
	buildPicker(U.Body)
	buildPreview(U.Body)
	S.Built = true
	relayout()
	return true
end

local function setBackdrop(on)
	local backdrop = U.Backdrop
	if not backdrop then
		return
	end
	if on then
		backdrop.Visible = true
		tween(backdrop, 0.18, { BackgroundTransparency = 0.55 })
	else
		tween(backdrop, 0.15, { BackgroundTransparency = 1 })
		local mine = S.Token
		task.delay(0.17, function()
			if S.Token == mine and not S.Open and backdrop.Parent then
				backdrop.Visible = false
			end
		end)
	end
end

-- the menu windows and the Pet Index share the screen: one window at a time
local function closeOthers()
	local controllers = script.Parent
	for _, name in ipairs({ "MenuController", "IndexController" }) do
		local module = controllers:FindFirstChild(name)
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Close) == "function" then
				pcall(mod.Close)
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function FusionController.IsOpen()
	return S.Open
end

function FusionController.Plan()
	return S.Plan
end

function FusionController.Select(keyA, keyB)
	if S.Tab == "Upgrade" then
		S.UpKey = keyA
	else
		S.MixA, S.MixB = keyA, keyB
	end
	if S.Built then
		refresh()
	end
end

function FusionController.Open(tab, args)
	if not initialized then
		FusionController.Init()
	end
	if not U.Gui then
		return
	end
	if LocalPlayer and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
		return
	end
	if not buildWindow() then
		return
	end
	args = type(args) == "table" and args or {}
	if tab == "Upgrade" or tab == "Mix" then
		S.Tab = tab
	end
	if type(args.Key) == "string" then
		if S.Tab == "Upgrade" then
			S.UpKey = args.Key
		else
			S.MixA = args.Key
			S.MixB = type(args.KeyB) == "string" and args.KeyB or S.MixB
		end
	end
	if typeof(args.Machine) == "Instance" then
		S.AtMachine = args.Machine
	elseif not S.Open then
		S.AtMachine = nil
	end
	local wasOpen = S.Open
	if not wasOpen then
		closeOthers()
	end
	S.Open = true
	S.Token = S.Token + 1
	syncBackBinding()
	relayout()
	U.Holder.Visible = true
	if not wasOpen then
		U.Pop.Scale = 0.86
		tween(U.Pop, 0.22, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		setBackdrop(true)
	end
	safe("refresh", refresh)
	if not wasOpen then
		FusionController.Opened:Fire(S.Tab)
	end
end

function FusionController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	S.AtMachine = nil
	resetAnimation()
	syncBackBinding()
	tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	setBackdrop(false)
	FusionController.Closed:Fire()
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
local function onPromptTriggered(prompt)
	if typeof(prompt) ~= "Instance" or prompt.Name ~= "FusionPrompt" then
		return
	end
	local owner = prompt:GetAttribute("OwnerUserId")
	if owner ~= nil and LocalPlayer and owner ~= LocalPlayer.UserId then
		return -- someone else's machine (its prompt is disabled locally anyway)
	end
	local model = prompt:FindFirstAncestor("Station_FusionMachine")
	FusionController.Open(nil, { Machine = model })
end

local function connectOthers()
	local controllers = script.Parent
	local function hook(name, signalName)
		local module = controllers:FindFirstChild(name)
		if not module then
			return
		end
		local ok, mod = pcall(require, module)
		local signal = ok and type(mod) == "table" and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				FusionController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
end

function FusionController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)

	local gui = CloudUI.NewScreenGui("NimbusFusion", K.DISPLAY_ORDER)
	U.Gui = gui
	U.Backdrop = Util.Create("TextButton", {
		Name = "Backdrop",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		BackgroundColor3 = Color3.fromRGB(8, 12, 32),
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		Visible = false,
		ZIndex = 1,
		Parent = gui,
	})
	U.Backdrop.Activated:Connect(function()
		FusionController.Close()
	end)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Built then
			safe("relayout", relayout)
		end
	end)

	State.Changed:Connect(function()
		if S.Open and not S.Animating then
			safe("State.Changed", refresh)
		end
	end)
	for _, signalName in ipairs({ "TokensChanged", "GemsChanged" }) do
		local signal = State[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				if S.Open and not S.Animating then
					safe("balance", refresh)
				end
			end)
		end
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if LocalPlayer:GetAttribute(Config.Attr.InMatch) == true then
				FusionController.Close()
			end
		end)
	end

	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			FusionController.Close()
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		safe("prompt", onPromptTriggered, prompt)
	end)

	task.spawn(function()
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) == "string" and panelId:lower() == "fusion" then
					local tab = type(args) == "table" and args.Tab or nil
					safe("OpenPanel", FusionController.Open, tab, args)
				end
			end)
		end
		local okFusion, remote = pcall(Remotes.Get, "Fusion")
		if okFusion and remote then
			fusionRemote = remote
			remote.OnClientEvent:Connect(function(kind, payload)
				if kind == "Result" then
					safe("result", onResult, payload)
				end
			end)
		end
	end)
	task.defer(function()
		safe("hooks", connectOthers)
	end)

	-- one light loop: pet viewports under a time budget, and the walk-away check (4 times a second)
	local checkAt = 0
	RunService.Heartbeat:Connect(function()
		if not S.Open then
			return
		end
		fillViewports()
		local now = os.clock()
		if now < checkAt then
			return
		end
		checkAt = now + 0.25
		if S.AtMachine then
			if distanceTo(S.AtMachine) > K.MACHINE_RANGE then
				FusionController.Close()
				return
			end
		end
		if S.Pending == nil and not S.Animating then
			local machine = S.AtMachine or myMachine()
			local near = machine == nil or distanceTo(machine) <= K.NEAR_RANGE
			if near ~= S.MachineNear then
				safe("near", refresh)
			end
		end
	end)
end

return FusionController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">HomeFx</string>
              <string name="Source"><![CDATA[-- HomeFx (client, Phase 2 homeworld + Phase 4 "pets make the money"): brings the tycoon homes that
-- server/Services/HomeBuilder builds to life on THIS client only (ARCHITECTURE_V3.md "Phase 4 build contract" 3.1-3.3,
-- 3.7, 3.9, 6; Replication rule: the server never animates and creates no Instance per coin).
--
--   HomeFx.Init()
--   HomeFx.Count() -> number of home plots tracked
--   HomeFx.Stats() -> { Homes, Near, Stations, Plants, Pops, HiddenPrompts, HiddenSigns, SignsShown, SignsCrowded,
--                       SignsUnderHud, SignsAway, GardenPets, TrainingPets (GymPets: the same), Sleeping, Props, Heaps,
--                       HeapParts, HeapsMade, Bowls, Coins, CoinPool, Fruit, FruitPool, FruitFlights, Drops, Zips,
--                       Labels, LastLabel, LastLabelAt, Hint, Ring, Cards, PetBuilds, PetColdBuilds, PetPoolHits,
--                       PetPool, PetFrameMost }   (Coins / Fruit: flying now, CoinPool / FruitPool: parts ever made;
--                       Drops / Zips / Labels: coins popped by eating pets, scooped piles, "+$" labels so far;
--                       Pet*: models built / first-time builds / taken from the pool, models waiting in the pool now,
--                       the most garden / training pets placed in one frame)
--   HomeFx.Garden(plotOrHomeFolder) -> { Heaps = { [slot | "W"] = { Model, Point, Stage, Dim, Lucky, Parts } },
--                       Bowls, Pets = { [slot] = { Key, Model, Sleep, Zzz, Card, Stage, Seat } }, Training =
--                       { [mat] = { Key, Model, Stat, Prop, Card, Seat } }, Open, Dim, Radius }   (tests / debugging)
--   HomeFx.SignState(padSign) -> "Shown" | "Crowded" | "Away" | "Pending" | "Locked" | "Other" | nil (see SignState)
--
-- Every Folder tagged "NC_Home" (HomeBuilder's per-plot `Home` folder; the plot folder above it carries TycoonService's
-- attributes GardenPets, GardenInfo, GardenSlots, CoinPiles, CollectorCash and PetCareService's TrainingPets) gets:
--   * a voxel pop-in when a `Station_*` (or a buy pad `Pad_*`) appears while the game runs: its blocks spring up from
--     the ground bottom-to-top in under a second, then everything is put back exactly where the server built it
--   * the Pet Garden (contract 3.2 / 3.3): the pets of GardenPets on their cushions (Spot<n>), each looking at a food
--     bowl (2 client parts per open place, toward its pile); twice per meal (TycoonCatalog.Coins.MealSeconds) an eating
--     pet dips into the bowl, a rainbow coin pops out and hops onto its pile, the pet wiggles. The piles are heaps of
--     rainbow coins at TycoonCatalog.CoinPoint(n) (the Welcome-back pile "W" at Garden.Slot.WelcomePile) that follow
--     CoinPiles: heap stage 1-5 (<= 35 parts, the Welcome-back heap <= 53), '*' a turning golden Lucky star, 'F' = the
--     pet naps (lies down, a voxel "Zzz"); a pet on a place above GardenSlots sleeps on its closed bed. Another
--     player's heaps are dimmed and never move. Fruit of every built plant (FruitPoint / FruitColor) flies into a
--     bowl every ~3 s, the Food Machine drops one from its chute (ChuteMouth -> Tray), the Coin Magnet's head
--     (MagnetHead about MagnetCenter) turns.
--   * the scoop (only the owner's coins are ever collectable): when the local player's own piles vanish from
--     CoinPiles while they stand within the Magnet's radius (TycoonCatalog.ScoopRadius), coins zip from each pile to
--     them, and when the bank (CollectorCash) dropped and their Cash rose in the same moment, a "+$1,234" pixel label
--     floats up AT THE PILE (never over the player's head: in third person that is the screen centre). A faint ring
--     of the scoop radius follows the owner while they stand in their garden. A visitor next to another player's pile
--     sees the hint "Only the owner can pick these up" once (at the pile).
--   * the Training Place (3.7): the pets of TrainingPets ("mat=key:Stat:Ends") on their mats (Spot<mat>), each with a
--     pooled voxel prop of its skill (Speed: treadmill, Physique: dumbbell, Ability: orb, Defense: shield dummy;
--     <= 8 parts) and a pose (running, lifting, floating, bumping the dummy).
--   * pet cards (3.9, client/UI/PetCard): own garden pets "Lv n" + XP (+ the EVOLVE! pill, which opens the Pets
--     panel), own training pets + the purple timer "2:10", other players' garden pets the level only (GardenInfo);
--     only pets within K.CARD_NEAR studs of the local player carry one; values written only on change.
--   * owner-only prompts: every ProximityPrompt inside a home that is not the local player's (BuyPrompt,
--     GardenSpotPrompt, FusionPrompt, ... by their OwnerUserId attribute, else the home's) is disabled locally, and the
--     pad signs (`PadSign`) of other players' pads are hidden; the "Claim Home" prompts of other plots are disabled
--     while the local player owns a home (one home per player). The server still checks everything. The signs of
--     the player's own LOCKED pads (their lock reason) only show within K.LOCKED_SIGN_NEAR studs, so the yard is not
--     a field of lock signs: from afar it shows what can be bought now, like a classic tycoon.
--   * readable pad signs (World text rule): the pad signs are pixel-sized billboards, so from the gate path a full
--     yard used to stack them into a pile nobody could read (worse on phones). Every K.SIGN_CHECK the local player's
--     own signs are laid out on the screen: projected through the camera (Camera:WorldToViewportPoint of the
--     adornee + studs offsets, plate size from the sign's Plate), taken nearest-to-the-player first (lock reasons
--     after what can be bought now, unless the player stands at that pad), and a sign whose plate would reach into
--     the text of a sign already shown is hidden ("Crowded") until there is room for it again; signs Roblox does not
--     draw or that are mostly off the screen take no room. The HUD is drawn OVER every billboard, so where this
--     game's own HUD covers the screen (the menu column, the currency pills and the rest of NimbusHud, the hotbar,
--     the touch buttons, the tutorial card) counts as signs already shown: a sign that would land under it is hidden
--     the same way and its room goes to another sign (measured every K.SIGN_HUD_CHECK seconds and when the screen
--     size changes, see measureHud). The pads keep their glow and pulse. A sign the layout has
--     not placed yet starts hidden (one frame), a rebuilt sign keeps its pad's last answer, and hysteresis
--     (K.SIGN_CLEAR px, K.SIGN_KEEP studs, K.SIGN_HOLD seconds) keeps signs from flickering while the camera moves.
--   * the local player's own pads glow when the Cash attribute can pay their Price and dim (price in red) when not.
-- Budgets (contract 6): pets, heaps, bowls, props and cards only for homes within K.PET_NEAR studs of the camera;
-- the 12 garden + 5 training pets of a home are built under a per-frame budget like every other pet builder (at most
-- K.PET_BUILD_MAX per frame and only while the frame has spent under K.PET_BUILD_BUDGET seconds building; a
-- first-time build alone in its frame); pets that leave wait unparented in a small pool (K.PET_POOL) for the way back;
-- heaps are clones of one template per look (at most K.HEAP_BUILD_MAX a frame) and pooled; flying coins (<= 40) and
-- fruit (<= 24) are pooled parts; poses are written at most 20 times a second and only when they changed.
-- Cheap: one RenderStepped connection; homes farther than K.NEAR studs from the camera are frozen; no collisions,
-- queries, touches or shadows on anything HomeFx makes. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local function optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

local TycoonCatalog = optionalShared("TycoonCatalog")
local Util = optionalShared("Util")
local PetBuilder = optionalShared("PetBuilder")
local PetKeys = optionalShared("PetKeys")
local PetCatalog = optionalShared("PetCatalog")
local Theme = optionalShared("Theme")

local HomeFx = {}

local HOME_TAG = "NC_Home"
local CASH_ATTR = (Config.Attr and Config.Attr.Cash) or "Cash"

local K = {
	NEAR = 230, -- studs from the camera: homes farther away are frozen (no coins, fruit, swirls)
	NEAR_CHECK = 0.5, -- seconds between distance checks
	POP_WINDOW = 6, -- a station whose BuiltAt is younger than this pops in
	POP_LIVE_AFTER = 1.5, -- children without BuiltAt pop when they arrive this long after the home was found
	POP_PART = 0.3, -- one block's spring
	POP_SPREAD = 0.6, -- bottom-to-top spread of one model's blocks
	POP_STAGGER = 0.1, -- between models that appear together (a claim rebuilds a whole home)
	POP_LIFT = 1.2, -- studs a block rises while it pops
	MAX_POP_PARTS = 3000, -- blocks animated at once (anything beyond simply appears)
	GLOW_RATE = 2.2, -- radians per second of the breathing glow
	GLOW_SWING = 0.3, -- transparency swing of a breathing glow
	SWIRL_SPEED = 1.4, -- radians per second of the Fusion Machine's swirl
	SWIRL_BOB = 0.25,
	PAD_PULSE = 3.2,
	PAD_DIM = 0.6, -- glow transparency of a pad the local player cannot pay for yet
	LOCKED_SIGN_NEAR = 30, -- studs: the sign of one of the local player's LOCKED pads (its lock reason) shows only
	LOCKED_SIGN_FAR = 34, -- this close (hidden again beyond FAR), so from afar the yard shows what can be bought now
	SIGN_CHECK = 0.1, -- seconds between two sign passes (those distance checks + the on-screen layout)
	SIGN_INSET_X = 8, -- px two plates may overlap side by side (only padding: HomeBuilder pads the text 14 px)...
	SIGN_INSET_Y = 2, -- ...and above / below each other (6 px top padding, 8 px bottom, a 3.5 px edge)
	SIGN_CLEAR = 6, -- px of extra room a hidden sign needs before it comes back (no flicker at the edge)
	SIGN_KEEP = 4, -- studs: a shown sign keeps its place unless a hidden one is this much nearer the player
	SIGN_HOLD = 0.35, -- seconds: a sign the layout hid stays hidden at least this long, one it showed stays (unless
	--                   it would overlap a sign shown just as recently): no flashes while the player walks
	SIGN_LOCKED_BACK = 15, -- studs: a locked pad's sign (its lock reason) yields to the pads that can be bought now...
	SIGN_LOCKED_CLOSE = 8, -- ...except up close (no penalty this near, the full one from twice as far): standing at a
	--                        locked pad shows why it is locked (its prompt is off, the sign is the only place to read it)
	SIGN_RANGE_SLACK = 2, -- studs past a sign's MaxDistance it still counts as drawn (Roblox measures to the adornee)
	SIGN_ONSCREEN = 0.85, -- share of a plate inside the screen to keep showing it (a cut-off plate reads as nothing)...
	SIGN_ONSCREEN_BACK = 0.95, -- ...and to show it again
	SIGN_HUD_GAP = 6, -- px kept between a plate and the HUD (the plate's 3.5 px outline, the HUD's strokes and coins)
	SIGN_HUD_CLEAR = 24, -- px at 1080p (scaled with the screen height): a sign hidden next to the HUD comes back only
	--                      this much farther from it. Signs move together, but against the HUD a sign moves as much
	--                      as the camera turns (0.5 degrees = ~7 px at 1080p), so K.SIGN_CLEAR is not enough there
	SIGN_HUD_CHECK = 1, -- seconds between two measurements of where the HUD is (not every pass: it rarely moves)...
	SIGN_HUD_SETTLE = 0.25, -- ...and after a screen size change, once more this soon (the HUD lays itself out again)
	PET_NEAR = 110, -- garden / training pets, heaps, bowls and props are shown for homes this close (hysteresis +20)
	PET_SCALE = 0.85,
	PET_ANIM_STEP = 0.125, -- seconds between two PetBuilder.Animate calls of the garden / training pets
	PET_ANIM_NEAR = 80, -- ...only this close (also the eating dips, the coins they pop out and the props' motion)
	PET_HOVER = 0.08, -- studs between a pet's lowest block and its cushion
	MAX_GARDEN_SLOTS = 12, -- the Pet Garden's places (contract 3.3)
	MAX_TRAIN_SLOTS = 5, -- the Training Place's mats (contract 3.7)
	PET_BUILD_MAX = 3, -- garden / training pet models built (or taken from the pool) in one frame at most...
	PET_BUILD_BUDGET = 0.004, -- ...and only while the frame has spent less than this building (the first always runs)
	PET_POOL = 20, -- pet models of homes gone out of range kept for the way back (oldest destroyed first)
	EVO_MAX = 6, -- evolved garden models of the local player's own home at most (the rest: the plain look + stars)
	MOTION_STEP = 0.05, -- seconds between two pose writes of a dipping / training pet (20 Hz, never per frame)
	MEAL = 8, -- seconds of one meal (TycoonCatalog.Coins.MealSeconds wins)
	DIP_START = 6.2, -- phase of the meal when the pet dips into its bowl (twice, DIP_TIME seconds)...
	DIP_TIME = 1.1,
	POP_AT = 7.35, -- ...a coin pops out onto the pile...
	WIGGLE_TIME = 0.45, -- ...and the pet wiggles
	COIN_FLIGHT = 0.55, -- seconds of a coin's hop from the pet onto its pile
	MAX_COINS = 40, -- flying coins alive at once over all homes (pooled parts)
	ZIP_COINS = 8, -- coins that zip from one scooped pile to the owner
	ZIP_TIME = 0.42,
	MAX_FRUIT = 24, -- flying fruit alive at once (pooled parts)
	FRUIT_EVERY = 3, -- seconds (+-0.5) between two fruits of one plant
	MACHINE_EVERY = 4, -- seconds between two fruits out of the Food Machine's chute
	HEAP_BUILD_MAX = 2, -- heaps cloned in one frame at most (the rest the next frames)
	HEAP_POOL = 6, -- idle heap models kept per look
	CARD_NEAR = 40, -- studs: garden / training pets this close to the local player carry a PetCard (hysteresis +6)
	CARD_CHECK = 0.5, -- seconds between two card passes (the timers tick in whole seconds)
	LABEL_TIME = 1.5, -- seconds the "+$1,234" label floats above a scooped pile
	MAX_LABELS = 3,
	LABEL_PAIR = 0.5, -- seconds: a CollectorCash drop and the piles that vanished belong to one scoop
	HINT_NEAR = 4.5, -- studs from another player's pile: the one-time hint "Only the owner can pick these up"
	HINT_TIME = 3.5,
	RING_SEGMENTS = 16, -- the owner's scoop ring (the Coin Magnet's radius) while standing in the garden
	MAGNET_SPIN = 1.1, -- radians per second of the Coin Magnet's head (x3 for a moment after a scoop)
}

