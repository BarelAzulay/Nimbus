			Atmosphere = { Density = 0.30, Offset = 0.18, Color = skyRgb(230, 170, 128), Decay = skyRgb(226, 120, 64), Glare = 0.5, Haze = 1.2 }, -- P2 F11 C clear air (was 0.34 / 1.8)
			Clouds = { Cover = 0.6, Density = 0.65, Color = skyRgb(255, 206, 170) },
