	})
	wrapText(quick, "Text", "Get paired with a player near your trophies. Both of you stay in the arena: the duel runs on a free ring.", "Body", 19, MUTED, 2)
	ui.QueueStatus = wrapText(quick, "Status", "", "Heading", 20, C.Power, 3)
