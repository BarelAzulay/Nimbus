-- The Robux Store (docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.1; store W0): every Robux item of the
-- full-size Store window (packs, passes, potions, Tokens). The gem packs stay Config.Gems.Products (StoreCatalog.List
-- appends them). Id 0 = not created on the Creator Hub yet: hidden outside the Studio preview and never sold; the owner
-- creates each product / pass there and pastes its id. Robux = the suggested Creator Hub price (for the owner and the
-- sims; never shown in the game).
Config.Store = {
	-- THE STORE SWITCH (release step 1). false = the Robux Store quick-wins added is OFF: the Packs / Passes / Boosts
	-- tabs, the token packs, the gem XP Potion, every PREVIEW badge and every purchase prompt of those are hidden on the
	-- client and refused on the server. What the live game already had keeps working: the Eggs tab, gem spins, and a gem
	-- pack whose Config.Gems.Products Id is > 0. Paid receipts and owned passes are ALWAYS honoured, on or off.
	-- Turn the Store on by changing this ONE line to true (StoreCatalog.Enabled reads it; only an explicit true is on).
	Enabled = false,
	PriceRetrySeconds = 10, -- the client reads GetProductInfo once per session in the background; one retry this long after a failure
	TrustLedgerAfter = 0, -- seconds of UserOwnsGamePassAsync failures after which a session trusts the saved Store.Passes; 0 = never
	Potion = {
		CapSeconds = 7 * 86400, -- an XP potion bank past this only dims the card (a paid receipt is never refused: it still extends)
		WarnSeconds = 300, -- the boost chip warns this close to the potion's end
	},
	-- lobby-shop 16.3: the Shop window's rail, in order (the Currency tab folded into Gems; Eggs is the old Roulettes tab)
	Tabs = { "Eggs", "Gems", "Packs", "Passes", "Boosts" },
	-- what each perk name does (Multipliers reads these; a pass or a Once pack lists the names it grants)
	Perks = {
		CashX2 = { Cash = 2 }, -- x2 Cash at the scoop, the Ring and the Dungeon (bank, piles and berries stay base)
		XpX2 = { PetXp = 2 }, -- x2 Pet XP forever; a potion gives the same x2 and the two never stack (max, not product)
		ProXp = { PetXpPvE = 1.5 }, -- x1.5 Pet XP in Dungeons and raids only (the Pro Pack): never duels, the Ring or feeding
		Vip = { DailyMult = 2 }, -- x2 on the Cash / Tokens streak cells of the daily gifts (never Gems, the pet or the play tiers)
	},
	-- { Key, Kind = "Product" | "Pass", Tab, Id, Robux, Name, Grants } plus Once (one per account), Hero (the tab's big
	-- card), Enabled = false (kept for the data, never listed or sold: 13b.1) and Line (a card's extra sentence).
	-- Grants, exactly: Pets = { [petId] = { Count, Level } }, Cash, Tokens, Boost = { XpPotion = seconds }, Perks = { name... }
	Items = {
		{ Key = "Starter", Kind = "Product", Tab = "Packs", Id = 0, Robux = 99, Name = "Starter Pack", Once = true, Hero = true,
			Grants = { Pets = { storm_tabby = { Count = 1, Level = 5 } }, Cash = 1000, Boost = { XpPotion = 3600 } } },
		{ Key = "Pro", Kind = "Product", Tab = "Packs", Id = 0, Robux = 799, Name = "Pro Pack", Once = true,
			Grants = { Pets = { crown_phoenix = { Count = 1, Level = 10 } }, Tokens = 5000, Perks = { "ProXp" } } },
		{ Key = "VIP", Kind = "Pass", Tab = "Passes", Id = 0, Robux = 399, Name = "VIP", Hero = true, Grants = { Perks = { "Vip" } } },
		{ Key = "Cash2x", Kind = "Pass", Tab = "Passes", Id = 0, Robux = 399, Name = "x2 Cash", Grants = { Perks = { "CashX2" } } },
		{ Key = "PetXp2x", Kind = "Pass", Tab = "Passes", Id = 0, Robux = 450, Name = "x2 Pet XP", Grants = { Perks = { "XpX2" } } },
		{ Key = "XpPotion1", Kind = "Product", Tab = "Boosts", Id = 0, Robux = 49, Name = "XP Potion (1 h)", Grants = { Boost = { XpPotion = 3600 } } },
		{ Key = "XpPotion3", Kind = "Product", Tab = "Boosts", Id = 0, Robux = 99, Name = "XP Potion (3 h)", Grants = { Boost = { XpPotion = 10800 } } },
		-- lobby-shop 16.1: a Product that grants Tokens (these three and the Pro Pack) is prompted only for an account whose
		-- GemService.PolicyState is "Allowed" (a token spin can give a Secret); a paid receipt is always granted
		{ Key = "Tokens1", Kind = "Product", Tab = "Gems", Id = 0, Robux = 49, Name = "1,500 Cloud Tokens", Grants = { Tokens = 1500 } },
		{ Key = "Tokens2", Kind = "Product", Tab = "Gems", Id = 0, Robux = 149, Name = "7,500 Cloud Tokens", Grants = { Tokens = 7500 } },
		{ Key = "Tokens3", Kind = "Product", Tab = "Gems", Id = 0, Robux = 399, Name = "30,000 Cloud Tokens", Grants = { Tokens = 30000 } },
		-- Cash packs: NOT on sale (13b.1: a kid who Prestiges five minutes after buying loses it). Kept with Enabled = false so
		-- the data is ready if the owner turns them on (Q5). Amounts = 20 min / 1 h / 3 h of the median minute-60 income of
		-- tools/sim_tycoon.py --quiet (146 Cash/s on 2026-11-04), rounded to two figures.
		{ Key = "Cash1", Kind = "Product", Tab = "Gems", Id = 0, Robux = 49, Name = "Cash (20 min)", Enabled = false,
			Grants = { Cash = 180000 }, Line = "Cash resets when you Prestige, so spend it!" },
		{ Key = "Cash2", Kind = "Product", Tab = "Gems", Id = 0, Robux = 149, Name = "Cash (1 h)", Enabled = false,
			Grants = { Cash = 530000 }, Line = "Cash resets when you Prestige, so spend it!" },
		{ Key = "Cash3", Kind = "Product", Tab = "Gems", Id = 0, Robux = 399, Name = "Cash (3 h)", Enabled = false,
			Grants = { Cash = 1600000 }, Line = "Cash resets when you Prestige, so spend it!" },
	},
	-- lobby shop (docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.3 / 5.8): items bought with gems, not Robux, through
	-- StoreRequest("GemBuy", key) -> StoreService.BuyWithGems. { Key, Gems, Name, Grants = { Boost = { XpPotion = seconds } } }:
	-- a gem item sells potion time only (StoreCatalog.Validate), refused while the x2 Pet XP pass is Owned or Checking and
	-- past Potion.CapSeconds; restricted accounts may buy it (it is not random)
	GemItems = {
		{ Key = "XpPotionGems", Gems = 100, Name = "XP Potion (30 min)", Grants = { Boost = { XpPotion = 1800 } } },
	},
}

-- Daily gifts (spec 5.2 / 13b): the 7-day streak and the per-day play-time gifts behind the one Gifts button. Every
-- number is a starting proposal the balance gate (spec 10) may move; the rules never move. Cash cells are minutes of
-- the player's income with a floor: the server resolves the amount (at state time and again at the claim) and the
-- client shows the number, never "minutes of income" (13b.3).
Config.Daily = {
	ReadySeconds = 20 * 3600, -- the next streak gift is ready this long after the last claim (the server clock)
	KeepSeconds = 48 * 3600, -- claimed within this of the last claim the streak is kept; later it steps back a day per missed day
	PipDelaySeconds = 20, -- the Gifts button's pip waits this long after the join (nothing is announced on join)
	FutureClockSlack = 300, -- a stored LastClaimAt further in the future than this is a wrong clock: counted as the now of its first sight on this server's clock (noted in Daily.ClampFrom / ClampAt / ClampJob, reused only on that server; LastClaimAt never written), refused once
	UnlockSeconds = 600, -- a streak claim needs this many counted play seconds of the current play-day (0 = off: no lock, no hold)
	-- the seven cells: cell ((Streak - 1) % 7) + 1 of the new Streak; re-earned, never re-paid (Paid = the highest Streak paid)
	Days = {
		{ Cash = { Minutes = 2, Min = 400 } },
		{ Tokens = 50 },
		{ Gems = 10 },
		{ Cash = { Minutes = 5, Min = 1000 } },
		{ Tokens = 250 },
		{ Gems = 25 },
		{ Pet = "week_wisp", Else = { Gems = 40 } }, -- every kept week a Week Wisp; Else only when its stack is full (13b.2)
	},
	-- play time per day on the same rolling clock (PlayStart); unclaimed tiers are lost with the play-day (Q17)
	Play = {
		DaySeconds = 20 * 3600, -- a new play-day on the first tick this long after PlayStart
		TickSeconds = 10, -- the play clock's tick
		ActiveWindow = 180, -- a tick counts when the root moved MoveStuds since the last sample OR an ActiveRemotes remote fired within this
		MoveStuds = 2,
		MaxDaySeconds = 36000, -- at most 10 h count per play-day
		ActiveRemotes = { "HomeAction", "PetCare", "BattleRequest", "BattleCommand", "DungeonRequest", "BuyRoulette", "Dash" },
		-- Min = play minutes of the day; Berries = "Basket" fills the Berry Basket to TycoonCatalog.BasketCap
		Tiers = {
			{ Min = 10, Cash = { Minutes = 1, Min = 200 } },
			{ Min = 20, Tokens = 40 },
			{ Min = 30, Cash = { Minutes = 3, Min = 600 } },
			{ Min = 60, Gems = 10 },
			{ Min = 90, Tokens = 150 },
			{ Min = 120, Berries = "Basket" },
			{ Min = 180, Gems = 25 },
		},
	},
}

-- The Sky Trove (spec 5.3 / 13b.5): the lobby chest in the old Item Shop stall's place that pays once per account for a
-- verified group join (Player:IsInGroupAsync once per server visit, only after the client's PromptJoinAsync said Joined).
Config.Trove = {
	GroupId = 0, -- the owner's Roblox group id; 0 = "Coming soon", no JOIN button (the Studio preview renders the row as PREVIEW)
	PromptRange = 10, -- studs: the chest's ProximityPrompt ("Sky Trove" / "Open")
	Slack = 6, -- studs past PromptRange the server still accepts an Open (16 in all)
	Cooldown = 5, -- seconds between two Opens / Joined of one player
	-- the panel's two rows (13b.5): Group (JOIN / DONE and its reward) and the Like line; the footer points at the game page
	Asks = {
		{ Id = "Group", Reward = { Cash = 2000, Tokens = 200 } },
		{ Id = "Like" },
	},
}

-- The global leaderboard (lobby shop, spec 5.10 with section 15: the third page is Ring best, no Climb wins page):
-- LeaderboardService keeps one OrderedDataStore per page (Stores) and sends LeaderboardState; the lobby board shows Top
-- rows per page and turns a page every TurnSeconds. Writes: SeedDelay s after a load (a value above 0), then a sweep every
-- SweepSeconds writes a changed value at most once per WriteEvery per stat, a leave writes what changed; never below the
-- request budget's BudgetFloor.Write, never in Studio unless WriteInStudio. Reads: GetSortedAsync(false, ReadSize) every
-- RefreshSeconds per stat, a failure retries after RetrySeconds (the last repeats). Before the first good pages, with no
-- store, or after failures before them: this server's live values, rebuilt every FallbackRefresh s. PollSeconds: the
-- own-value poll. Values are whole numbers 0 .. MaxValue.
Config.Leaderboard = {
	Stores = { Trophies = "NimbusClimb_LB_Trophies_v1", Pets = "NimbusClimb_LB_Pets_v1", Ring = "NimbusClimb_LB_Ring_v1" },
	Pages = { "Trophies", "Pets", "Ring" },
	Labels = { Trophies = "Trophies", Pets = "Pets found", Ring = "Ring best" },
	Titles = { Trophies = "TOP TROPHIES", Pets = "TOP PETS FOUND", Ring = "TOP RING ROUND" },
	Top = 10,
	ReadSize = 100,
	RefreshSeconds = 240,
	WriteEvery = 120,
	SweepSeconds = 60,
	SeedDelay = 30,
	RetrySeconds = { 30, 60, 120, 240 },
	BudgetFloor = { Write = 20, Read = 2 },
	TurnSeconds = 15,
	FallbackRefresh = 30,
	PollSeconds = 5,
	MaxValue = 1e12,
	WriteInStudio = false,
	-- Titles (spec 16.6): the global rank in Stat (index in the good top-ReadSize page; Gold <= ReadSize) gives Top10 up to
	-- Rainbow and Top100 up to Gold; the game's owner (DevService.IsOwner) gets Creator, which wins over a rank. Column = the
	-- leaderstats StringValue PlayerService makes after Tokens; ColumnText its plain text per kind ("" for none); Tag = the
	-- text of the tag above the head.
	RankTitles = {
		Stat = "Trophies",
		Rainbow = 10,
		Gold = 100,
		Column = "Rank",
		ColumnText = { Creator = "Creator", Top10 = "Top 10", Top100 = "Top 100" },
		Tag = { Creator = "CREATOR", Top10 = "TOP 10", Top100 = "TOP 100" },
	},
}

-- Developer tools (owner only). The game's owner (and the extra UserIds in Admins, and everyone while testing in
-- Roblox Studio) gets a small DEV button and chat commands: /allpets, /tokens <n>, /cash <n>, /gems <n>, /reset, /tutorial, /skiptutorial,
-- /devhelp. Nobody else can use them: the server checks every request.
Config.Dev = {
	Enabled = true, -- master switch for the developer tools
	AllowInStudio = true, -- everyone counts as a developer while playing in Roblox Studio
	Admins = {}, -- extra Roblox UserIds allowed in the live game (the game's owner is always allowed)
	StudioAutoGrant = false, -- true: in Studio, start every test with every pet and GrantTokens tokens
	GrantTokens = 1000000, -- tokens added by the "+ tokens" button and by StudioAutoGrant
	GrantCash = 1000000, -- Phase 2: Cash added by the "+ Cash" button (/cash n)
	GrantGems = 1000, -- Phase 2: Gems added by the "+ Gems" button (/gems n)
	GrantBerries = 5000, -- Phase 5: Berries added by the "+ Berries" button (/berries n)
	MaxTokensPerCommand = 100000000,
}

-- v3: 2D artwork the player uploaded to Roblox. Used for Stormfang's Pet Index banner and the Storm Altar poster.
-- The source files live in branding/ (stormfang-art.png has a transparent background). These must be IMAGE ids:
-- an upload's Decal id (here 129423539279679) fails in an ImageLabel ("Asset type does not match"); the Image id is
-- the Decal's Texture (InsertService:LoadAsset(decalId) in Studio).
Config.Art = {
	StormfangImage = "rbxassetid://101827417487186",
}
-- (Pitch 2 items 9 B / 10 A; P2 icons look fin1, tools/check.mjs asset-id) an owner-uploaded sheet's image
-- (Config.IconSheet.Id, Config.MachineSheet.Id: a whole number above 0) as its asset URL. Asset URLs are made only here
-- in Config.Art, on the allowed art's own scheme (no second asset literal anywhere); nil for 0 or junk (nothing uploaded
-- yet: the callers keep their fallback drawing)
function Config.Art.Image(id)
	id = tonumber(id)
	if not (id and id > 0 and id == math.floor(id)) then
		return nil
	end
	return Config.Art.StormfangImage:match("^%a+://") .. string.format("%d", id)
end

-- (keys look r4, tools/check.mjs asset-id: BattleController built this URI itself) the image of a shared/TextureIds number
-- for a file outside check.mjs's TextureIds joiners (the battle top card's boss head, Pitch 2 item 06 A): the prefix joined
-- to the id's whole digits only (a 15-digit id never prints as 1.05e+14), never a literal id; nil for no id or id <= 0
function Config.Art.TextureImage(id)
	id = tonumber(id)
	if not id or id <= 0 then
		return nil
	end
	local digits = string.format("%d", id)
	return "rbxassetid://" .. digits
end

----------------------------------------------------------------------
-- Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 6.4-6.5, 7): sky, audio, icons, loading screen, main menu
----------------------------------------------------------------------
-- The painted sky: six Image ids (NOT Decal ids) from branding/sky/*.png, uploaded by the owner through Studio's Asset
-- Manager -> Bulk Import, then pasted here as "rbxassetid://<id>" (Bk Dn Ft Lf Rt Up by file name; left and right swapped =
-- swap the Lf and Rt ids). While any of the six is empty LightingService shows its built-in fallback sky (a pink-lavender
-- haze, a tinted cloud layer and 3000 stars). README "Phase 5: owner checklist", step 2.
-- The living sky (docs/superpowers/specs/2026-10-30-living-sky-cycle-design.md): one server-synced 20 minute loop
-- Dawn 2 -> Day 6 -> Sunset 9 -> Night 3 min, each phase blending into the next over its last Blend seconds, plus a
-- server-wide raid sky while a raid boss is up. shared/SkyCycle turns the server time into a phase and a preset; the
-- client re-applies it every Refresh s with a Tween s tween (LightingStack base). Faces stays LightingService's boot sky
-- (empty = the painted theme of the loop's first phase, else the Day's; kit-b S2).
-- Each skybox swap hides behind the haze bridge (Transitions, Bridge).
--   Themes / RaidThemes  the painted skybox (blender/sky/sky_themes.py theme id) per phase / per raid boss id; the faces
--                        are TextureIds "sky_<theme>_<Face>" (shared/SkyFaces); a theme without all six = the boot sky
--   Looks[phase | boss]  the world light per LightingStack group + Clock = { from, to } (the ClockTime walked through
--                        the phase, unwrapped: to may pass 24, the Night's 31 = 7 h next morning; on toward the next
--                        phase's from across the blend; a raid look's is fixed). The copper / indigo comes from the world light (ColorShift,
--                        Ambient, Atmosphere, clouds); TintColor stays within Floor.TintMax of white (Amber Burn shows
--                        11 of 20 minutes, the HUD and rarity colours keep their true colours)
--   Floor                the readability floor in every phase and raid (night is indigo, never black)
--   AirV2 / CloudsV2     (kit-b S4, staged) the painted skies' air colours per phase / the thin Terrain clouds, used by
--                        shared/SkyCycle in place of the looks' only while Config.Preview.SkyAir / ThinClouds is true
--                        (SkyAir changes only Atmosphere Color on screen under the painted skies: Glare is 0 there)
local skyRgb = Color3.fromRGB
Config.Sky = {
	Faces = { Bk = "", Dn = "", Ft = "", Lf = "", Rt = "", Up = "" },
	Cycle = {
		Order = { "Dawn", "Day", "Sunset", "Night" },
		Seconds = { Dawn = 120, Day = 360, Sunset = 540, Night = 180 }, -- a 1200 s (20 min) loop
		Blend = 75, -- seconds at the end of each phase that blend into the next
		-- (P2 F11 C, the quick sunset) hours the clock walks on into a phase change's clock gap (the Sunset's 17 h ->
		-- the Night's 18.9 h, the only gap): from the phase's own walk it reaches 17 + 0.2 = 17.2 h at the step, and from
		-- the step it is the next phase's start, so the engine sun never sits on the horizon on screen. The step is
		-- (Refresh + Tween) / 2 = 2 s before the bridge peak (P2 F11 C look review: stepping AT the peak let the client's
		-- 2 s tween run up to 4 s after it, k 0.81), so on screen it lies in the peak +- 2 s behind the cloud curtain.
		-- Against the mock-up (fade_frames.quick_sunset 17.0 -> 17.2 h, then 18.9): the build matches at the step
		-- (17.2 h) and from it on; at the blend's start it is the Sunset's own walk, 16.86 h (Sunset.Clock { 16, 17 }
		-- over its 540 s; the mock-up's 17.00 rounds that walk, as its "today" row does). nil = the old even walk across
		-- the whole blend. Used only where the phase change has a haze bridge (the skybox changes)
		GapWalk = 0.2,
		Refresh = 2, -- the client re-applies the sky every Refresh s ...
		Tween = 2, -- ... with a tween this long (no per-frame work); Transitions.Raid.Step while a raid sky blends
	},
	-- the haze bridge (kit-b S1, sky audit F1-F3): Roblox cannot blend two skyboxes, so around each skybox swap the air and
	-- the cloud deck thicken toward a bridge colour, the faces, StarCount and a raid's fixed clock switch at the peak
	-- (shared/SkyCycle.Bridge: k = 1 at blend 0.5, 0 outside |blend - 0.5| < BridgeHalf) and the air clears again.
	-- Density / Haze / Cover = the peak the bridge lifts each toward (never lowers one already thicker); Glare goes to 0.
	-- CloudDensity = the Clouds Density peak, used only while Config.Preview.ThinClouds is on (S4 review: the thin deck
	-- rests at 0.3, and Atmosphere Density does not veil the skybox itself; the looks' own decks sit near these).
	-- Tune in Studio: the faces about 85% hidden at the peak, the next obby platform (60 studs) still clearly visible.
	-- P2 F11 C (the owner: "the fade switching day time is making the world look like there's a heavy mist, it looks bad";
	-- pick C "Clear air + a quick sunset behind the clouds"): the air stays clear (Cycle Density 0.65 -> 0.36, Haze
	-- 3.4 -> 1.6; Raid 0.7 -> 0.42, 4.0 -> 2.2) and the cloud deck is the curtain (Cover 0.95, CloudDensity 0.75); the
	-- tint is the light's and the sky's (the Bridge colours below lifted from brown to a light twilight). NOTE: with
	-- Config.Preview.ThinClouds off (the default) CloudDensity does nothing (see above): the curtain is Cover 0.95 over
	-- the looks' own deck Density, about 0.5 at the Sunset -> Night peak (Sunset 0.65 / Night 0.35). OWED in Studio: that
	-- deck hides the skybox swap (if not, the lever is letting the cycle bridge lift Clouds Density with the switch off)
	--   Cycle   a phase change. BridgeHalf 0.284 of the smoothstep Blend = the middle 30 s of the 75 s window
	--   Raid    a raid sky in (In s from SkyEventAt; raid to raid too) and out (Out s); the client refreshes every Step s
	--           with Step s tweens while one blends (else Cycle.Refresh / Tween); the bridge colour = the raid look's
	--           Atmosphere Decay
	--   Zone    (kit-b S3, sky audit F9) a zone mood pushed over the world (DungeonController's "Dungeon" light, Sine through
	--           LightingStack): In s to dim at the run's start, Late s for a tier mood read late (the pocket streamed in
	--           after the start: a slow re-tint, not a 1 s shift mid-play), Out s back at the end (0 s while the screen is
	--           black under a fade)
	--   Screen  (S3, F10) screen-space effects: Out = SkyTransition.BlurOut's default fade (Quad In), Lift = the dungeon's
	--           black fade frame tweened out when End arrives under it
	--   Preload (S2 review) RaidDelay = seconds after PLAY before the four raid skies preload, one at a time (the lobby's
	--           own assets load first)
	Transitions = {
		Cycle = { BridgeHalf = 0.284, Density = 0.36, Haze = 1.6, Cover = 0.95, CloudDensity = 0.75 },
		Raid = { In = 8, Out = 6, Step = 0.5, BridgeHalf = 0.3, Density = 0.42, Haze = 2.2, Cover = 0.95, CloudDensity = 0.7 },
		Zone = { In = 1.5, Late = 2.5, Out = 2 },
		Screen = { Out = 0.35, Lift = 0.3 },
		Preload = { RaidDelay = 4 },
	},
	-- the cycle's bridge colour per skybox pair (Themes[phase] .. ">" .. Themes[next]): Color = the average of the two
	-- painted skies' horizon band (the 15% above the horizon of Ft / Bk / Lf / Rt, .superpowers/sky-final), Decay = the
	-- average of their lower band. A pair with no entry keeps the looks' own lerp. P2 F11 C lifted both pairs to a light
	-- twilight (dusk <> night was the brown 122,90,69 / 117,94,90 of the owner's red-brown "mist"; day <> dusk was
	-- 199,167,149 / 212,198,189), so the air keeps near the two looks' own mix and the light and the sky carry the colour
	Bridge = {
		["dusk_amber>day_vivid"] = { Color = skyRgb(206, 190, 186), Decay = skyRgb(220, 210, 206) },
		["day_vivid>dusk_amber"] = { Color = skyRgb(206, 190, 186), Decay = skyRgb(220, 210, 206) },
		["dusk_amber>night_aurora"] = { Color = skyRgb(132, 126, 160), Decay = skyRgb(138, 128, 164) },
		["night_aurora>dusk_amber"] = { Color = skyRgb(132, 126, 160), Decay = skyRgb(138, 128, 164) },
	},
	-- (kit-b S4, sky audit F6, PICK: read only with Config.Preview.SkyAir) each phase's air taken from its painted sky, so
	-- the haze band and the far islands carry the sky's own hue (the looks' air was tuned for the old pink sky: violet
	-- under the teal night, pink under the orange dawn). Color = the average horizon band (the 15% above the horizon of
	-- Ft / Bk / Lf / Rt, the band Bridge uses), Decay = the same band on the sun side (Ft: every theme's sun, moon and
	-- feature face Ft). From blender/textures/sky/<theme>; Dawn and Sunset share Amber Burn. Raid looks keep their own.
	-- Under the painted skies only Color shows: Atmosphere Decay is the hue away from the sun and needs Glare above 0,
	-- and SkyCycle.Preset sets Glare 0 whenever a theme's faces resolve. The Decay values (the sun side Ft) would sit in
	-- the away-from-sun slot if Glare ever came back (a theme with no faces); a sun-side gradient (Ft in Color, Bk in
	-- Decay, a small Glare) is a separate pick. Judge only Color in the A/B
	AirV2 = {
		Dawn = { Color = skyRgb(220, 109, 45), Decay = skyRgb(237, 133, 64) },
		Day = { Color = skyRgb(177, 225, 252), Decay = skyRgb(178, 226, 253) },
		Sunset = { Color = skyRgb(220, 109, 45), Decay = skyRgb(237, 133, 64) },
		Night = { Color = skyRgb(23, 70, 92), Decay = skyRgb(23, 69, 91) },
	},
	-- (S4, world clouds 6, PICK: read only with Config.Preview.ThinClouds) the engine's Terrain clouds thinned to a haze in
	-- every look (phases and raids): Cover and Density at rest never above these, so the painted sky and the voxel cumulus
	-- carry the clouds. The bridge still lifts Cover and Density to Transitions' peaks (Cover, CloudDensity) around a
	-- skybox swap
	CloudsV2 = { Cover = 0.25, Density = 0.3 },
	Speed = { Default = 1, Min = 0.1, Max = 120 }, -- the dev /sky speed clamp (SkySpeed attribute)
	-- the Workspace attributes server/Services/SkyService publishes (the clock: no remote traffic): Epoch = the server
	-- time at boot, Speed / Offset = the dev /sky speed and phase jump (loop seconds), Event = the raid boss id whose sky
	-- is up ("" = none), EventAt = the server time Event last changed (the clients blend in / out from it: Transitions.Raid)
	Attr = { Epoch = "SkyEpoch", Speed = "SkySpeed", Offset = "SkyOffset", Event = "SkyEvent", EventAt = "SkyEventAt" },
	EventWatch = 5, -- seconds between the server's checks that a raid sky still has its raid (a missed end never sticks)
	Themes = { Dawn = "dusk_amber", Day = "day_vivid", Sunset = "dusk_amber", Night = "night_aurora" },
	RaidThemes = { storm_titan = "storm_teal", lava_golem = "lava_obsidian", frost_wyrm = "frost_glacial", shadow_hydra = "shadow_eclipse" },
	Floor = {
		Brightness = 1.0, -- Lighting.Brightness never below
		OutdoorAmbientMin = 70, -- every OutdoorAmbient channel (0-255) never below: voxel sides still read
		TintMax = 8, -- ColorCorrection TintColor channels stay within this of 255
	},
	-- client/Controllers/SkyController (the client half; Refresh / Tween above):
	ClockJump = 0.5, -- hours: a ClockTime step bigger than this at a phase / raid change (a raid sky's fixed clock at
	-- mid-blend) is set at once, never tweened through the hours between. The cycle itself never needs it: the
	-- Sunset 17 -> Night 18.9 gap is crossed inside the Sunset segment (P2 F11 C: a walk on to 17.2 h, then one step 2 s
	-- before the bridge peak that SkyController tweens over one refresh, not a jump) and the Night runs on through midnight to
	-- Dawn's 7 h (SkyCycle.Preset); passing midnight (23.9 -> 0.1) is the one other instant set (24 h = 0 h: invisible)
	-- the battle lift: while I am in an outdoor pet battle (Config.Attr.InBattle starts with Prefix: a duel, raid,
	-- Champion Ring run or PvP; a dungeon run "D.." stays under the dungeon preset) and the look is one of Looks, the
	-- LightingStack preset Id lifts my night toward twilight over Seconds and settles back after the fight (me only)
	Lift = {
		Id = "SkyLift",
		Prefix = "B",
		Seconds = 1.5,
		Looks = { Night = true, shadow_hydra = true },
		Preset = {
			Lighting = {
				Brightness = 1.6,
				ExposureCompensation = 0.15,
				Ambient = skyRgb(116, 108, 148),
				OutdoorAmbient = skyRgb(150, 142, 192),
			},
		},
	},
	-- the lobby's lamps (LobbyBuilder pointLight() on these part names, under workspace.<Root>): their PointLight
	-- Brightness x Night under the Looks, x Day under every other look, never over Max (art rule 7: warm lanterns <= 1.5);
	-- their own (built) value with no clock. Written on a look change, and on a lamp that arrives later. Bug batch 6 (the
	-- owner: "whats up with the brightness with the lights"): they burned at their full value all day (Day was 1)
	Lamps = {
		Root = "NimbusLobby",
		Names = { LampGlass = true, LanternLight = true, StallLight = true, DomeGlow = true, TroveGlow = true },
		Night = 1.4,
		Day = 0.35,
		Max = 1.5,
		Looks = { Night = true, shadow_hydra = true },
		-- the client keeps each lamp's own value on the light itself in this attribute (local, never replicated) while it
		-- is written: a Lua-only weak cache could lose it, and the written value would become the next base
		BaseAttr = "SkyLampBase",
	},
	-- a few soft fireflies round the lobby trees (models named "...Tree" under workspace.<Root>) under the Looks, on
	-- High graphics only: one local folder, at most Max emitters (one per tree), the default sparkle, pale
	-- yellow-green, slow; Size / Height / Spread in studs, Lifetime / Speed = NumberRange { min, max }
	Fireflies = {
		Root = "NimbusLobby",
		Folder = "NimbusFireflies",
		Looks = { Night = true },
		Max = 6,
		Rate = 1.2,
		Color = skyRgb(212, 255, 150),
		Lifetime = { 4, 7 },
		Speed = { 0.2, 0.6 },
		Size = 0.22,
		Height = 5,
		Spread = 10,
	},
	LowCloudStep = 0.02, -- GraphicsQuality re-pushes its GfxLow cloud cap once the capped density moves this much
	Looks = {
		-- the bright pastel morning (preview A) under the Amber Burn sky: a low warm sun, pink air, peach clouds
		Dawn = {
			Clock = { 7.0, 9.0 },
			Lighting = {
				Brightness = 1.7,
				ExposureCompensation = -0.05,
				Ambient = skyRgb(112, 104, 132),
				OutdoorAmbient = skyRgb(150, 136, 162),
				ColorShift_Top = skyRgb(78, 52, 40),
				ColorShift_Bottom = skyRgb(30, 24, 48),
				EnvironmentDiffuseScale = 0.6,
				EnvironmentSpecularScale = 0.3,
			},
			Atmosphere = { Density = 0.29, Offset = 0.2, Color = skyRgb(236, 206, 214), Decay = skyRgb(246, 190, 150), Glare = 0.35, Haze = 1.1 }, -- P2 F11 C clear air (was 0.32 / 1.4)
			Clouds = { Cover = 0.55, Density = 0.6, Color = skyRgb(255, 228, 220) },
			ColorCorrection = { Brightness = 0.02, Contrast = 0.06, Saturation = 0.1, TintColor = skyRgb(255, 250, 248) },
			Sky = { StarCount = 0 },
		},
		-- the long bright day = today's Phase 4 light (LightingService p4Light, sky-blue air, white clouds) under Vivid Skylands
		Day = {
			Clock = { 9.0, 16.0 },
			Lighting = {
				Brightness = 2.0,
				ExposureCompensation = -0.15,
				Ambient = skyRgb(98, 106, 132),
				OutdoorAmbient = skyRgb(132, 138, 160),
				ColorShift_Top = skyRgb(66, 50, 26),
				ColorShift_Bottom = skyRgb(14, 20, 40),
				EnvironmentDiffuseScale = 0.6,
