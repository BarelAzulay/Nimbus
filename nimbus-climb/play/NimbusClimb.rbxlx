----------------------------------------------------------------------
-- Secret aura: a ring of floating glowing voxels (orbits)
----------------------------------------------------------------------
local function auraGrid(ctx)
	local a = Voxel.NewGrid(30)
	local count = ctx.High and 10 or 6
	local keys = { "AuraA", "AuraB", "AuraC" }
	for i = 0, count - 1 do
		local ang = i / count * TAU
		local r = 13.4 + (i % 2) * 1.6
		local y = -4 + (i * 7 % 13)
		local size = ctx.High and ((i % 3 == 0) and 1.6 or 1.1) or 2
		box(a, keys[i % 3 + 1], { math.cos(ang) * r, y, math.sin(ang) * r }, { size, size, size })
	end
	local P, S, E = ctx.Look.Primary, ctx.Look.Secondary, ctx.Look.Eye
	ctx.Pal.AuraA = { Color = hueShift(S, 0), Material = NEON }
	ctx.Pal.AuraB = { Color = hueShift(S, 0.12), Material = NEON }
	ctx.Pal.AuraC = { Color = hueShift(mix(E, P, 0.3), -0.1), Material = NEON }
	return a
end

----------------------------------------------------------------------
-- Blueprint: sculpt -> shade -> merge (cached per look + detail)
----------------------------------------------------------------------
local blueprints = {}
local lidBoxes -- defined below

local function mergeGroup(ctx, grid, budget)
	return Voxel.Merge(grid, { Palette = ctx.Pal, MaxParts = budget, Keep = ctx.Keep })
end

-- lean: nil, 1 (drop the optional small details) or 2 (also sculpt a little coarser)
local function buildBlueprint(look, detail, lean)
	local k = (detail == "Low") and LOW_K or 1
	if lean and detail == "Low" then
		k = LEAN_LOW_K
	elseif lean == 2 then
		k = LEAN_HIGH_K
	end
	if look.Evolved then
		k = ((detail == "Low") and 0.65 or 1.25) * (lean and 0.85 or 1)
	end
	if MESH_K then
		k = MESH_K
	end
	SK = k
	local ok, result = pcall(function()
		local ctx = newContext(look, detail)
		if lean then
			ctx.Fine = false
		end
		local budget = budgetOf(look, detail)
		if look.Evolved then
			EVO.Sculpt(ctx)
			if look.Accessory and not EVO.Pets[look.Base] then
				ACCESSORIES[look.Accessory](ctx)
			end
		else
			SPECIES[look.Species](ctx)
			if look.Accessory then
				ACCESSORIES[look.Accessory](ctx)
			end
		end
		-- Phase 2: a fused hybrid gets its Style parent's signature feature (before the eyes are carved)
		applyHybrid(ctx)
		carveEyes(ctx)
		-- (a species may tune its body and tail shading with ctx.BodyShade = Voxel.Shade options)
		local bodyShade = { Skip = ctx.NoShade }
		for k, v in pairs(ctx.BodyShade or {}) do
			bodyShade[k] = v
		end
		Voxel.Shade(ctx.Body, bodyShade)
		if look.Evolved then
			EVO.SculptWing(ctx, ctx.Wing)
		else
			WINGS[look.WingStyle](ctx, ctx.Wing)
		end
		if not ctx.WingNoShade then
			Voxel.Shade(ctx.Wing, { Skip = ctx.NoShade, LightAt = 0.5, Smooth = look.Evolved and 2 or nil })
			if ctx.Wing2 then
				Voxel.Shade(ctx.Wing2, { Skip = ctx.NoShade, LightAt = 0.5, Smooth = 2 })
			end
		end
		-- Phase 2: a Golden copy's sparkle stars (outside the shaded surface, touching it)
		if look.Finish == "Golden" then
			goldSparkles(ctx)
		end

		local bp = { Groups = {}, Pal = ctx.Pal, Look = look, Detail = detail, K = k, Pulse = ctx.Pulse, Grow = ctx.Grow, Stars = ctx.StarSpots }
		local bodyGroup = { Name = "Body" }
		bp.Groups[#bp.Groups + 1] = bodyGroup

		-- wings: left from the grid, right = exact mirror image
		local wh = ctx.WingHinge
		local hingeR = CFrame.new(wh[1], wh[2], wh[3]) * CFrame.Angles(0, -ctx.WingSweep, 0) * CFrame.Angles(0, 0, ctx.WingTilt)
		local hingeL = mirrorCF(hingeR)
		local wingBoxes = mergeGroup(ctx, ctx.Wing, budget.Wing)
		local wingKind = ctx.WingKind or "wing"
		bp.Groups[#bp.Groups + 1] = { Name = "WingL", Boxes = wingBoxes, Hinge = hingeL, Kind = wingKind, Side = 1, K = ctx.Wing.K }
		bp.Groups[#bp.Groups + 1] = { Name = "WingR", Boxes = Voxel.MirrorBoxes(wingBoxes), Hinge = hingeR, Kind = wingKind, Side = -1, K = ctx.Wing.K }
		-- a second, lower pair of wings (second evolution), flapping with the first
		if ctx.Wing2 then
			local w2 = ctx.Wing2Hinge
			local h2R = CFrame.new(w2[1], w2[2], w2[3]) * CFrame.Angles(0, -ctx.Wing2Sweep, 0) * CFrame.Angles(0, 0, ctx.Wing2Tilt)
			local w2Boxes = mergeGroup(ctx, ctx.Wing2, budget.Wing2)
			bp.Groups[#bp.Groups + 1] = { Name = "Wing2L", Boxes = w2Boxes, Hinge = mirrorCF(h2R), Kind = "wing", Side = 1, K = ctx.Wing2.K }
			bp.Groups[#bp.Groups + 1] = { Name = "Wing2R", Boxes = Voxel.MirrorBoxes(w2Boxes), Hinge = h2R, Kind = "wing", Side = -1, K = ctx.Wing2.K }
		end

		if ctx.Tail then
			Voxel.Shade(ctx.Tail, bodyShade)
			local th = ctx.TailHinge
			bp.Groups[#bp.Groups + 1] = {
				Name = "Tail", Boxes = mergeGroup(ctx, ctx.Tail, budget.Tail),
				Hinge = CFrame.new(th[1], th[2], th[3]), Kind = "tail", Amp = ctx.TailWag, K = ctx.Tail.K,
			}
		end
		if ctx.Halo then
			local ha = ctx.HaloAt
			bp.Groups[#bp.Groups + 1] = {
				Name = "Halo", Boxes = mergeGroup(ctx, ctx.Halo, budget.Halo),
				Hinge = CFrame.new(ha[1], ha[2], ha[3]), Kind = "bob", Amp = 0.6,
			}
		end
		if ctx.AuraGrid then
			-- the second evolution's elemental aura
			local at = ctx.AuraAt or { 0, 1, 0 }
			bp.Groups[#bp.Groups + 1] = {
				Name = "Aura", Boxes = Voxel.Merge(ctx.AuraGrid, { Palette = ctx.Pal, MaxParts = budget.Aura }),
				Hinge = CFrame.new(at[1], at[2], at[3]), Kind = "orbit", Amp = 0.8,
			}
		elseif look.Rarity == "Secret" and not ctx.NoAura then
			bp.Groups[#bp.Groups + 1] = {
				Name = "Aura", Boxes = Voxel.Merge(auraGrid(ctx), { Palette = ctx.Pal }),
				Hinge = CFrame.new(0, 1, 0), Kind = "orbit", Amp = 0.8,
			}
		end
		-- blink lids: per eye an upper lid, a dark lash line and a lower lid, flat boxes in front of the carved
		-- eye (hidden until a blink)
		for i, cells in ipairs(ctx.LidCells or {}) do
			bp.Groups[#bp.Groups + 1] = { Name = "EyeLid", Boxes = lidBoxes(cells, not ctx.High), Kind = "lid", Index = i }
		end
		-- the body gets whatever the other groups left of the total budget (it can always give up shading)
		local used = 1 -- the root
		for _, gr in ipairs(bp.Groups) do
			if gr.Boxes then
				used = used + #gr.Boxes
			end
		end
		-- (a species that sets ctx.BodyFill may fill the whole remaining total, so its shades and colours survive)
		bodyGroup.Boxes = mergeGroup(ctx, ctx.Body, max(30, min(ctx.BodyFill and budget.Total or budget.Body, budget.Total - used)))
		-- Phase 2: the finish recolours the palette the parts are instanced with (the merge used the base colours)
		applyFinishPalette(ctx, bp)
		if MESH_K then
			-- (kit hook only) where the separate meshes attach, in design units; the eyes in sculpted voxels
			bp.Anchors = {
				HeadTop = ctx.HeadTop, HeadC = ctx.HeadC, HeadR = ctx.HeadR, EarX = ctx.EarX,
				Hat = { 0, ctx.HeadTop, ctx.HeadC[3] }, Neck = { 0, ctx.NeckY, ctx.NeckZ }, NeckR = ctx.NeckR,
				Flower = ctx.FlowerAt, HornBase = ctx.HornBase, Tail = ctx.TailHinge, Wing = ctx.WingHinge,
				WingTilt = ctx.WingTilt, WingSweep = ctx.WingSweep, Halo = ctx.HaloAt, Aura = ctx.AuraAt,
				Eyes = ctx.Eyes, LidCells = ctx.LidCells, NoShade = ctx.NoShade, Keep = ctx.Keep,
			}
		end
		return bp
	end)
	SK = 1
	if not ok then
		error(result, 0)
	end
	return result
end

-- flat lid boxes covering one carved eye: rows above the lash line, the lash line, rows below it (Low detail:
-- one plain lid)
lidBoxes = function(cells, single)
	local x0, x1, y0, y1, z = math.huge, -math.huge, math.huge, -math.huge, math.huge
	local counts = {}
	local lineY = nil
	for _, c in ipairs(cells) do
		x0, x1 = min(x0, c[1]), max(x1, c[1])
		y0, y1 = min(y0, c[2]), max(y1, c[2])
		z = min(z, c[3])
		if c[4] == "LidLine" then
			lineY = c[2]
		else
			counts[c[4]] = (counts[c[4]] or 0) + 1
		end
	end
	if x0 > x1 then
		return {}
	end
	local key, best = "Lid", -1
	for k, n in pairs(counts) do
		if n > best or (n == best and k < key) then
			key, best = k, n
		end
	end
	lineY = lineY or floor((y0 + y1) / 2)
	if single then
		-- Low detail: one closed lid over the whole eye
		return { { X0 = x0, X1 = x1, Y0 = y0, Y1 = y1, Z0 = z, Z1 = z, Key = key } }
	end
	local out = {}
	if y1 > lineY then
		out[#out + 1] = { X0 = x0, X1 = x1, Y0 = lineY + 1, Y1 = y1, Z0 = z, Z1 = z, Key = key }
	end
	out[#out + 1] = { X0 = x0, X1 = x1, Y0 = lineY, Y1 = lineY, Z0 = z, Z1 = z, Key = "LidLine" }
	if y0 < lineY then
		out[#out + 1] = { X0 = x0, X1 = x1, Y0 = y0, Y1 = lineY - 1, Z0 = z, Z1 = z, Key = key }
	end
	return out
end

local function partCount(bp)
	local n = 1
	for _, gr in ipairs(bp.Groups) do
		n = n + #gr.Boxes
	end
	return n
end

local function getBlueprint(look, detail)
	local key = lookSignature(look) .. "|" .. detail
	local bp = blueprints[key]
	if not bp then
		bp = buildBlueprint(look, detail)
		-- a rare heavy combination (big wings + bushy tail + accessory + aura): sculpt again without the
		-- optional small details and keep whichever fits
		local cap = budgetOf(look, detail).Cap
		for level = 1, 2 do
			if partCount(bp) <= cap then
				break
			end
			local lean = buildBlueprint(look, detail, level)
			if partCount(lean) < partCount(bp) then
				bp = lean
			end
		end
		blueprints[key] = bp
	end
	return bp, key
end

----------------------------------------------------------------------
-- Instancing
----------------------------------------------------------------------
local function flagPart(part)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
end

-- base colours before their shades, bigger boxes first (the first part of a name gets the bare name)
local function sortBoxes(boxes)
	local list = {}
	local info = {}
	for i, b in ipairs(boxes) do
		list[i] = b
		local base, variant = Voxel.BaseKey(b.Key)
		info[b] = { Variant = variant ~= nil, Base = tostring(base), Vol = (b.X1 - b.X0 + 1) * (b.Y1 - b.Y0 + 1) * (b.Z1 - b.Z0 + 1) }
	end
	table.sort(list, function(a, b)
		local ia, ib = info[a], info[b]
		if ia.Variant ~= ib.Variant then
			return not ia.Variant
		end
		if ia.Vol ~= ib.Vol then
			return ia.Vol > ib.Vol
		end
		if ia.Base ~= ib.Base then
			return ia.Base < ib.Base
		end
		if a.Y0 ~= b.Y0 then
			return a.Y0 < b.Y0
		end
		if a.X0 ~= b.X0 then
			return a.X0 < b.X0
		end
		return a.Z0 < b.Z0
	end)
	return list
end

local function groupSpec(gr)
	return table.concat({ gr.Name, gr.Kind or "static", tostring(gr.Side or 1), tostring(gr.Amp or 0), tostring(gr.Index or 0) }, ":")
end

local function instantiate(bp, scale)
	scale = scale * (bp.Grow or 1) -- (the second evolution is built bigger)
	local model = Instance.new("Model")
	model.Name = "Pet_" .. bp.Look.Id
	local designStud = VOXEL * scale -- hinge positions are in design voxels
	local vs = VOXEL / bp.K * scale -- box coordinates are in sculpted voxels
	local used = {}
	local function uniqueName(name)
		local c = (used[name] or 0) + 1
		used[name] = c
		if c > 1 then
			return name .. c
		end
		return name
	end
	-- the invisible root at the pet's centre (sized so rarity sparkles rise from the whole body)
	local root = Instance.new("Part")
	root.Name = uniqueName("Body")
	flagPart(root)
	root.Transparency = 1
	root.Size = Vector3.new(0.9, 1.1, 0.9) * scale
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local specs = {}
	local rainbow = {} -- Rainbow finish: { Part, Volume } of every part with a rainbow key
	for _, gr in ipairs(bp.Groups) do
		local boxes = sortBoxes(gr.Boxes)
		local hinge = nil
		if gr.Hinge then
			local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = gr.Hinge:GetComponents()
			hinge = CFrame.new(x * designStud, y * designStud, z * designStud, r00, r01, r02, r10, r11, r12, r20, r21, r22)
		end
		local _, parts = Voxel.BuildBoxes(boxes, {
			VoxelSize = gr.K and (VOXEL / gr.K * scale) or vs, -- (a group may have its own resolution)
			Palette = bp.Pal,
			CFrame = hinge or CFrame.new(),
			Model = model,
			CastShadow = false,
		})
		local animated = gr.Kind ~= nil and gr.Kind ~= "static"
		for i, part in ipairs(parts) do
			local base = Voxel.BaseKey(boxes[i].Key)
			local name = base
			if gr.Name == "Tail" or gr.Name == "Halo" or gr.Name == "Aura" then
				name = gr.Name
			elseif gr.Name ~= "Body" then
				name = gr.Name
			end
			part.Name = uniqueName(name)
			flagPart(part)
			if bp.RainbowKeys and bp.RainbowKeys[base] and gr.Kind ~= "lid" then
				local s = part.Size
				rainbow[#rainbow + 1] = { Part = part, Volume = s.X * s.Y * s.Z }
			end
			if bp.Pulse and bp.Pulse[base] then
				-- glowing parts that pulse softly (Animate)
				part:SetAttribute("PB_Pulse", part.Transparency)
			end
			if animated then
				part:SetAttribute("PB_G", groupSpec(gr))
				local rel = hinge and hinge:ToObjectSpace(part.CFrame) or part.CFrame
				part:SetAttribute("PB_Base", cfToString(rel))
				if gr.Kind == "lid" then
					part:SetAttribute("PB_T0", part.Transparency)
					part.Transparency = 1
				end
			end
		end
		if gr.Hinge then
			specs[#specs + 1] = groupSpec(gr) .. "=" .. cfToString(hinge)
		end
	end
	model:SetAttribute("PB_Rig", table.concat(specs, ";"))
	model:SetAttribute("PB_Scale", scale)
	model:SetAttribute("PB_Detail", bp.Detail)
	model:SetAttribute("PetId", bp.Look.Id)
	model:SetAttribute("PB_Seed", hashString(bp.Look.Id .. bp.Look.Species))
	if bp.Finish then
		model:SetAttribute("PB_Finish", bp.Finish)
	end
	if bp.Look.Hybrid then
		model:SetAttribute("PB_Hybrid", true)
	end
	if #rainbow > 0 then
		-- a fixed rainbow sweeping up the pet and out along the wings; the biggest parts also cycle (Animate)
		local unit = 2.8 * scale
		for _, e in ipairs(rainbow) do
			local p = e.Part.Position
			local phase = (0.95 + 1.1 * (p.Y / unit) + 0.9 * (abs(p.X) / unit)) % 1
			local neon = e.Part.Material == Enum.Material.Neon
			e.Part.Color = Color3.fromHSV(phase, neon and 0.42 or 0.52, 1)
			e.Phase = phase
		end
		table.sort(rainbow, function(a, b)
			if a.Volume ~= b.Volume then
				return a.Volume > b.Volume
			end
			return a.Phase < b.Phase
		end)
		local n = HUE_PARTS[bp.Detail] or HUE_PARTS.High
		for i = 1, math.min(n, #rainbow) do
			rainbow[i].Part:SetAttribute("PB_Hue", rainbow[i].Phase)
		end
	end
	return model
end

----------------------------------------------------------------------
-- Rig (animation state per model, rebuilt from attributes for clones)
----------------------------------------------------------------------
local rigs = setmetatable({}, { __mode = "k" })

local function parseGroup(spec)
	local f = {}
	for token in string.gmatch(spec, "[^:]+") do
		f[#f + 1] = token
	end
	return { Name = f[1], Kind = f[2] or "static", Side = tonumber(f[3]) or 1, Amp = tonumber(f[4]) or 0, Index = tonumber(f[5]) or 0 }
end

local function buildRig(model)
	local groups = {}
	local byKey = {}
	local rigAttr = model:GetAttribute("PB_Rig")
	if type(rigAttr) == "string" then
		for entry in string.gmatch(rigAttr, "[^;]+") do
			local spec, cf = string.match(entry, "^(.-)=(.*)$")
			if spec then
				local gr = parseGroup(spec)
				gr.Hinge = stringToCF(cf) or CFrame.new()
				gr.Parts, gr.Base = {}, {}
				groups[#groups + 1] = gr
				byKey[spec] = gr
			end
		end
	end
	local lids = {}
	local pulse = {}
	local hue = {}
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") then
			local p0 = part:GetAttribute("PB_Pulse")
			if type(p0) == "number" then
				pulse[#pulse + 1] = { Part = part, T0 = p0 }
			end
			local h0 = part:GetAttribute("PB_Hue")
			if type(h0) == "number" then
				local _, s, v = part.Color:ToHSV()
				hue[#hue + 1] = { Part = part, Phase = h0, S = s, V = v }
			end
			local spec = part:GetAttribute("PB_G")
			if type(spec) == "string" then
				local gr = byKey[spec]
				if not gr then
					gr = parseGroup(spec)
					gr.Hinge = CFrame.new()
					gr.Parts, gr.Base = {}, {}
					groups[#groups + 1] = gr
					byKey[spec] = gr
				end
				local base = stringToCF(part:GetAttribute("PB_Base"))
				if base then
					gr.Parts[#gr.Parts + 1] = part
					gr.Base[#gr.Base + 1] = base
				end
			end
		end
	end
	local moving = {}
	for _, gr in ipairs(groups) do
		if gr.Kind == "lid" then
			for _, p in ipairs(gr.Parts) do
				lids[#lids + 1] = { Part = p, T0 = tonumber(p:GetAttribute("PB_T0")) or 0 }
			end
		elseif #gr.Parts > 0 then
			moving[#moving + 1] = gr
		end
	end
	local seed = model:GetAttribute("PB_Seed")
	if type(seed) ~= "number" then
		seed = 1
	end
	local scale = model:GetAttribute("PB_Scale")
	if type(scale) ~= "number" or scale <= 0 then
		scale = 1
	end
	return {
		Groups = moving,
		Lids = lids,
		Pulse = pulse,
		Hue = hue, -- Rainbow finish: the few parts whose hue cycles
		HueAt = nil,
		Blinking = false,
		St = { Flap = 0, Wag = 0, Sway = 0, Excite = 0, Stud = VOXEL * scale },
		Offset = (seed % 628) / 100,
		BlinkPeriod = 3.1 + (seed % 17) * 0.13,
		BlinkOffset = (seed % 29) * 0.11,
		LastT = nil,
	}
end

local function getRig(model)
	local rig = rigs[model]
	if rig then
		return rig
	end
	if rig == false then
		return nil
	end
	local ok, built = pcall(buildRig, model)
	if ok and built then
		rigs[model] = built
		return built
	end
	rigs[model] = false
	return nil
end

-- clocks are accumulated (not t * speed) so changing Flap / Excited never makes a wing jump
local function advance(rig, t, flapMul, excited)
	local st = rig.St
	local first = rig.LastT == nil
	local dt = 0
	if not first then
		dt = clamp(t - rig.LastT, 0, 0.1)
	end
	rig.LastT = t
	if first then
		st.Excite = excited
	else
		st.Excite = st.Excite + (excited - st.Excite) * (1 - math.exp(-dt * 8))
	end
	local ex = st.Excite
	local flapRate = TAU * FLAP_HZ * flapMul * (1 + 1.25 * ex)
	local wagRate = TAU * WAG_HZ * (1 + 1.6 * ex)
	local swayRate = TAU * SWAY_HZ
	if first then
		st.Flap = t * flapRate + rig.Offset
		st.Wag = t * wagRate + rig.Offset * 0.7
		st.Sway = t * swayRate + rig.Offset * 0.5
	else
		st.Flap = st.Flap + dt * flapRate
		st.Wag = st.Wag + dt * wagRate
		st.Sway = st.Sway + dt * swayRate
	end
end

-- motion of one group in its hinge frame
local function groupMotion(gr, st)
	local kind = gr.Kind
	if kind == "wing" then
		local a = FLAP_AMP * (1 + 0.15 * st.Excite) * sin(st.Flap)
		local sweep = 0.12 * sin(st.Flap - 1.2)
		return CFrame.Angles(0, sweep * gr.Side, a * gr.Side)
	elseif kind == "cloud" then
		-- a storm cloud half: a slow, gentle roll (~0.4 Hz, +-7 degrees) and a small drift that keeps the rider
		-- sitting in it (it rides the flap clock, so Flap / Excited speed it up)
		local a = 0.12 * sin(st.Flap * 0.2)
		return CFrame.new(0, st.Stud * 0.8 * sin(st.Flap * 0.15 + 1), 0) * CFrame.Angles(0.04 * sin(st.Flap * 0.12), 0, a * gr.Side)
	elseif kind == "tail" then
		local a = gr.Amp * (1 + 0.5 * st.Excite) * sin(st.Wag)
		return CFrame.Angles(0.06 * sin(st.Wag * 0.5), a, 0)
	elseif kind == "bob" then
		return CFrame.new(0, gr.Amp * st.Stud * sin(st.Sway * 1.6) * 3, 0)
	elseif kind == "orbit" then
		return CFrame.new(0, gr.Amp * st.Stud * sin(st.Sway * 1.3) * 3, 0) * CFrame.Angles(0, st.Sway * 0.7, 0)
	end
	return CFrame.new()
end

-- neon accents breathe softly (Stormfang)
local function updatePulse(rig, t)
	local list = rig.Pulse
	if #list == 0 then
		return
	end
	local k = 0.2 * (0.5 + 0.5 * sin(t * 2.2))
	for i = 1, #list do
		local e = list[i]
		e.Part.Transparency = e.T0 + k
	end
end

-- Rainbow finish: the flagged parts slide through the rainbow (at most every HUE_STEP seconds per model)
local function updateHue(rig, t)
	local list = rig.Hue
	if #list == 0 then
		return
	end
	local last = rig.HueAt
	if last and t >= last and t - last < HUE_STEP then
		return
	end
	rig.HueAt = t
	local shift = t * HUE_RATE
	for i = 1, #list do
		local e = list[i]
		e.Part.Color = Color3.fromHSV((e.Phase + shift) % 1, e.S, e.V)
	end
end

local function updateBlink(rig, t)
	local lids = rig.Lids
	if #lids == 0 then
		return
	end
	local u = (t + rig.BlinkOffset) % rig.BlinkPeriod
	local closed = u < BLINK_TIME
	if closed == rig.Blinking then
		return
	end
	rig.Blinking = closed
	for i = 1, #lids do
		local l = lids[i]
		if l.Part.Parent then
			if closed then
				l.Part.Transparency = l.T0
			else
				l.Part.Transparency = 1
			end
		end
	end
end

----------------------------------------------------------------------
-- Templates (one per look + detail + scale; Build hands out clones)
----------------------------------------------------------------------
local templates = {}
local templateOrder = {}
local MAX_TEMPLATES = 40

local function getTemplate(bp, bpKey, scale)
	local key = bpKey .. "|" .. string.format("%.4f", scale)
	local tpl = templates[key]
	if tpl then
		return tpl
	end
	tpl = instantiate(bp, scale)
	templates[key] = tpl
	templateOrder[#templateOrder + 1] = key
	if #templateOrder > MAX_TEMPLATES then
		local old = table.remove(templateOrder, 1)
		local m = templates[old]
		templates[old] = nil
		if m then
			pcall(m.Destroy, m)
		end
	end
	return tpl
end

local MESH -- Phase 6 mesh path state (defined with its functions below, before the public API)

function PetBuilder.ClearCache()
	for _, m in pairs(templates) do
		pcall(m.Destroy, m)
	end
	templates = {}
	templateOrder = {}
	blueprints = {}
	if MESH then
		for _, m in pairs(MESH.Templates) do
			pcall(m.Destroy, m)
		end
		MESH.Templates, MESH.Order, MESH.Plans = {}, {}, {}
	end
end

----------------------------------------------------------------------
-- Rarity flair
----------------------------------------------------------------------
local SPARKLE_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

local function addSparkles(model, look, rate, scale)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "RaritySparkles"
	emitter.Texture = SPARKLE_TEXTURE
	local a, b = lighten(look.WingColor, 0.5), lighten(look.Primary, 0.35)
	if look.Rarity == "Secret" then
		a, b = hueShift(look.Secondary, 0), hueShift(look.Secondary, 0.15)
	end
	emitter.Color = ColorSequence.new(a, b)
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.8, 1.5)
	emitter.Speed = NumberRange.new(0.3 * scale, 1.1 * scale)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.4, 0.22 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.2),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = root
end

-- Phase 2 finishes: a soft gold (Golden) or rainbow (Rainbow) sparkle emitter on the root
local function addFinishSparkles(model, look, rate, scale)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FinishSparkles"
	emitter.Texture = SPARKLE_TEXTURE
	if look.Finish == "Golden" then
		emitter.Color = ColorSequence.new(rgb(255, 214, 96), rgb(255, 248, 214))
	else
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, rgb(255, 140, 160)),
			ColorSequenceKeypoint.new(0.25, rgb(255, 214, 120)),
			ColorSequenceKeypoint.new(0.5, rgb(140, 236, 160)),
			ColorSequenceKeypoint.new(0.75, rgb(130, 190, 255)),
			ColorSequenceKeypoint.new(1, rgb(210, 150, 255)),
		})
	end
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Rate = rate
	emitter.Lifetime = NumberRange.new(0.7, 1.3)
	emitter.Speed = NumberRange.new(0.2 * scale, 0.8 * scale)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-120, 120)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.35, 0.26 * scale),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = root
end

-- Phase 5 (contract C13): the Wild look of dungeon enemies, applied to the clone only (the cached templates and
-- every owned pet stay untouched): the body darker (x0.75 brightness, -20% saturation) and pulled a quarter toward
-- opts.Wild.Tint, the irises / pupils / eye rings Neon in opts.Wild.Eyes (the floor's element colour). The white eye
-- highlights stay so the face still reads. The model carries PB_Wild = true.
local applyWild
local WILD_EYES = { EyeIris = true, EyePupil = true, EyeRing = true }
local WILD_KEEP = { EyeShine = true, EyeGlint = true, Spark = true, AuraA = true, AuraB = true, AuraC = true, HaloGlow = true }

applyWild = function(model, wild)
	local tint = typeof(wild.Tint) == "Color3" and wild.Tint or nil
	local eyes = typeof(wild.Eyes) == "Color3" and wild.Eyes or rgb(255, 72, 72)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency < 1 then
			local base = string.match(part.Name, "^(%a+)") or part.Name
			if WILD_EYES[base] then
				part.Color = eyes
				part.Material = Enum.Material.Neon
			elseif not WILD_KEEP[base] then
				local h, sat, v = part.Color:ToHSV()
				local c = Color3.fromHSV(h, sat * 0.8, v * 0.75)
				if tint then
					c = c:Lerp(tint, 0.25)
				end
				part.Color = c
			end
		end
	end
	model:SetAttribute("PB_Wild", true)
end

----------------------------------------------------------------------
-- Phase 6 mesh path (ARCHITECTURE_V3.md 6.3 runtime-pets, docs/phase6/recipe.md 4.8 "Pet path"). When EVERY key the
-- pet needs is usable here (MeshLibrary.IsReady: body, wings, accessory, hybrid feature, Golden star, evolved form +
-- its wings) Build assembles the pet from the Blender meshes (MeshLibrary.Assemble): an invisible `Body` root, the
-- recipe 4.3 part names, PB_G / PB_Base / PB_T0 / PB_Pulse / PB_Hue, model PB_Rig (PetBuilder's group order) /
-- PB_Scale / PB_Detail / PetId / PB_Seed / PB_Finish / PB_Hybrid, so Animate, the followers, battle units, cards and
-- PetFx work unchanged. Otherwise (empty MeshIds, a key loading / failed / broken on this device, no manifest for
-- this look) the whole pet is today's Part build: never a mix. One table (main-chunk local budget).
--   PetBuilder.MeshKeys(petDef, opts) -> { keys } | nil   the keys this build would need (nil = no mesh design)
--   PetBuilder.NeedsMeshRebuild(model) -> bool             a Part-built model whose keys are all usable now
--   PetBuilder.MeshVersion() -> number                     MeshLibrary.Version() (0 without it): poll, then ask above
----------------------------------------------------------------------
MESH = {
	Tried = false,
	Lib = nil,
	Plans = {}, -- plan key -> plan | false
	Templates = {}, -- look signature | detail | scale -> mesh model template
	Order = {},
	Max = 40,
	PartInfo = setmetatable({}, { __mode = "k" }), -- Part-built model -> { Look, Detail, Stage } (NeedsMeshRebuild)
	RigRank = { WingL = 1, WingR = 2, Wing2L = 3, Wing2R = 4, Tail = 5, Halo = 6, Aura = 7 },
	HyKeys = { HyA = true, HyB = true, HyTip = true, HyHorn = true, HyGlow = true },
}

function MESH.lib()
	if not MESH.Tried then
		MESH.Tried = true
		local inst = script.Parent:FindFirstChild("MeshLibrary")
		if inst and inst:IsA("ModuleScript") then
			local ok, mod = pcall(require, inst)
			if ok and type(mod) == "table" and type(mod.Assemble) == "function" and type(mod.Active) == "function" then
				MESH.Lib = mod
			end
		end
	end
	return MESH.Lib
end

-- manifest group list { {Id, Attach} } (the kit writes a map keyed by id; hand-made fixtures may use a list)
function MESH.groups(man)
	local raw = man and man.Groups or {}
	local out = {}
	if #raw > 0 then
		for i, g in ipairs(raw) do
			out[#out + 1] = { Id = tostring(g.Id or g.id or g.Name or g.name or i), Attach = g.Attach or g.attach }
		end
	else
		for id, g in pairs(raw) do
			out[#out + 1] = { Id = id, Attach = type(g) == "table" and (g.Attach or g.attach) or nil }
		end
		table.sort(out, function(a, b)
			return a.Id < b.Id
		end)
	end
	return out
end

function MESH.att(man, name)
	local a = man and man.Attachments and man.Attachments[name]
	local pos = a and (a.Pos or a.pos)
	if type(pos) == "table" then
		return Vector3.new(pos[1] or 0, pos[2] or 0, pos[3] or 0)
	end
	return nil
end

function MESH.meta(man)
	local raw = man and man.Raw
	return type(raw) == "table" and type(raw.Meta or raw.meta) == "table" and (raw.Meta or raw.meta) or {}
end

-- a wing key: its manifest, the body attachment its pivot goes to (the group's Attach) or nil when unusable
function MESH.wing(ML, bodyMan, key, default)
	local man = ML.Manifest(key)
	if not man then
		return nil
	end
	local attach = default
	for _, g in ipairs(MESH.groups(man)) do
		if type(g.Attach) == "string" then
			attach = g.Attach
		end
	end
	if not MESH.att(bodyMan, attach) then
		return nil
	end
	return { Key = key, At = attach }
end

-- The plan of one look (scale-free): keys, entries (At = attachment name | Vector3 offset in studs at Scale 1),
-- root size, grow. false = no mesh design for this look (a missing manifest), so it always takes the Part path.
function MESH.plan(ML, look, detail, stage)
	local hy = look.Hybrid
	local pk = table.concat({ look.Id, tostring(look.Base), look.Species, look.WingStyle, tostring(look.Accessory),
		hy and tostring(hy.Species) or "-", tostring(look.Finish), tostring(stage), detail }, "|")
	local cached = MESH.Plans[pk]
	if cached ~= nil then
		return cached
	end
	local plan = MESH.makePlan(ML, look, detail, stage) or false
	MESH.Plans[pk] = plan
	return plan
end

function MESH.makePlan(ML, look, detail, stage)
	local sfx = (detail == "Low") and "_low" or ""
	local hy = look.Hybrid
	local body
	if stage > 0 then
		if type(look.Base) ~= "string" then
			return nil -- fused hybrids evolve with their species' design: no per-pet mesh, Part build
		end
		body = "evo" .. stage .. "_" .. look.Base .. sfx
	else
		local sp = string.lower(look.Species)
		body = "pet_" .. sp .. sfx
		-- species variants keyed by the pet id (pet_dog_corgi): the same rule as the sculpt (string.find(Id, "corgi"))
		for token in string.gmatch(string.lower(look.Id), "%w+") do
			if ML.Manifest("pet_" .. sp .. "_" .. token .. sfx) then
				body = "pet_" .. sp .. "_" .. token .. sfx
				break
			end
		end
	end
	local bm = ML.Manifest(body)
	if not bm then
		return nil
	end
	local meta = MESH.meta(bm)
	local rs = type(meta.rootSize) == "table" and meta.rootSize or { 0.9, 1.1, 0.9 }
	local plan = {
		Keys = { body },
		Entries = {},
		Grow = tonumber(meta.grow) or 1,
		Root = Vector3.new(rs[1] or 0.9, rs[2] or 1.1, rs[3] or 0.9),
		Hybrid = nil,
		Stars = nil,
	}
	local bodyEntry = { Key = body }
	plan.Entries[1] = bodyEntry
	local function add(e)
		plan.Entries[#plan.Entries + 1] = e
		plan.Keys[#plan.Keys + 1] = e.Key
	end
	-- wings (L and R are separate keys; the pivot goes to the body's WingL / WingR / Wing2L / Wing2R attachment)
	local pairsList
	if stage > 0 then
		pairsList = { { "evowing_" .. look.Base .. "_" .. stage, true } }
		if stage == 2 then
			pairsList[2] = { "evowing_" .. look.Base .. "_2b", false }
		end
	else
		pairsList = { { "wing_" .. string.lower(look.WingStyle), true } }
	end
	for i, wp in ipairs(pairsList) do
		local l = MESH.wing(ML, bm, wp[1] .. "_L" .. sfx, (i == 1) and "WingL" or "Wing2L")
		local r = MESH.wing(ML, bm, wp[1] .. "_R" .. sfx, (i == 1) and "WingR" or "Wing2R")
		if l and r then
			add(l)
			add(r)
		elseif wp[2] or l or r then
			return nil -- a required pair (or half of an optional one) has no mesh design
		end
	end
	-- the accessory (base stage only; an evolved form wears its own jewellery)
	if stage == 0 and look.Accessory then
		local key = "acc_" .. string.lower(look.Accessory) .. sfx
		local am = ML.Manifest(key)
		local attach = am and (MESH.meta(am).attach or "Hat")
		if not am or not MESH.att(bm, attach) then
			return nil
		end
		add({ Key = key, At = attach })
	end
	-- a fused hybrid's feature (High keys only, small): head features moved onto this body's HeadCenter, its own
	-- tail (when the trait swaps the tail) onto the body's Tail attachment instead of the body's tail
	if stage == 0 and hy then
		local key = (hy.Species == nil or hy.Species == look.Species) and "hyb_same" or ("hyb_" .. string.lower(hy.Species))
		if key ~= "hyb_same" and not HAS_EARS[look.Species] and ML.Manifest(key .. "_ears") then
			key = key .. "_ears" -- a bear/dog hybrid on an earless body: the variant that grows the round ears
		end
		local hm = ML.Manifest(key)
		if not hm then
			return nil
		end
		local hc, bc = MESH.att(hm, "HeadCenter"), MESH.att(bm, "HeadCenter")
		local headOff = (hc and bc) and (bc - hc) or Vector3.new()
		local hasTail = false
		for _, g in ipairs(MESH.groups(hm)) do
			if g.Id == "Tail" then
				hasTail = true
			end
		end
		-- Each feature part is anchored by its height in the feature key's reference body (MESH.assemble): above the
		-- head centre it blends toward the head TOP (Hat attachments: ears / horns / crests sit on a flat frog head or
		-- a tall owl head alike), below it toward the FLOOR (paw socks stay on the paws), the head centre in between.
		local hh, bh = MESH.att(hm, "Hat"), MESH.att(bm, "Hat")
		local ref = ML.Manifest("pet_" .. string.lower(tostring(MESH.meta(hm).species or "dog")))
		local function floorOf(m)
			local b = m and m.Bounds
			local lo = b and (b.Min or b.min)
			return type(lo) == "table" and tonumber(lo[2]) or nil
		end
		local rf, bf = floorOf(ref), floorOf(bm)
		local head = { OffY = headOff.Y, HC = hc and hc.Y or 0 }
		if hc and bc and hh and bh and hh.Y > hc.Y + 0.05 then
			head.Y1, head.Top = hh.Y, (bh - hh) - headOff
		end
		if hc and rf and bf and hc.Y > rf + 0.05 then
			head.Y0, head.Ground = rf, Vector3.new(0, bf - rf, 0) - headOff
		end
		add({ Key = key, Off = headOff, Skip = { Tail = true }, Head = head })
		if hasTail then
			local ht, bt = MESH.att(hm, "Tail"), MESH.att(bm, "Tail")
			bodyEntry.Skip = { Tail = true }
			add({ Key = key, Off = (ht and bt) and (bt - ht) or Vector3.new(), Groups = { Tail = true } })
		end
		plan.Hybrid = true
	end
	-- Golden: the sparkle stars (a hero star standing on the head, a glint on the cheek)
	if look.Finish == "Golden" then
		if not ML.Manifest("star_gold") then
			return nil
		end
		local hat, hc = MESH.att(bm, "Hat"), MESH.att(bm, "HeadCenter")
		if hat and hc then
			local r = math.max(0.3, hat.Y - hc.Y)
			add({ Key = "star_gold", Off = hat + Vector3.new(r * 0.3, r * 0.6, 0), Scale = 0.52, Star = true })
			add({ Key = "star_gold", Off = hc + Vector3.new(-r * 0.62, -r * 0.3, -r * 0.92), Scale = 0.24, Star = true })
		end
		plan.Stars = true
	end
	return plan
end

function MESH.dedupe(list)
	local out, seen = {}, {}
	for _, k in ipairs(list) do
		if not seen[k] then
			seen[k] = true
			out[#out + 1] = k
		end
	end
	return out
end

-- colours of a fused hybrid's Hy* keys: exactly applyHybrid's palette (same seed, same order of draws)
function MESH.hybridColors(look)
	local hy = look.Hybrid
	local r = seededRandom(hy.Seed)
	local a = hy.Primary
	if colorDistance(a, look.Primary) < 0.2 then
		a = (luminance(look.Primary) > 0.5) and darken(a, 0.32) or lighten(a, 0.32)
	end
	local h, s, v = a:ToHSV()
	a = Color3.fromHSV((h + r(-0.025, 0.025)) % 1, clamp(s + r(-0.06, 0.06), 0, 1), clamp(v + r(-0.05, 0.05), 0, 1))
	local b = look.Secondary
	if colorDistance(b, a) < 0.12 then
		b = (luminance(a) > 0.5) and darken(b, 0.3) or lighten(b, 0.35)
	end
	return { HyA = a, HyB = b, HyTip = darken(a, 0.42), HyHorn = mix(CREAM or rgb(255, 242, 218), b, 0.3), HyGlow = lighten(b, 0.3) }
end

-- Golden / Rainbow on mesh parts, by palette key (MK_Key): the Part build's goldPalette / rainbowPalette + instancing
function MESH.finish(model, look, detail, scale)
	if not GOLD_DEEP then
		GOLD_DEEP = rgb(140, 88, 26)
		GOLD_MID = rgb(240, 180, 52)
		GOLD_PALE = rgb(255, 230, 140)
		PEARL = rgb(246, 244, 255)
	end
	local rainbow = {}
	local unit = 2.8 * scale
	for _, part in ipairs(model:GetChildren()) do
		local key = part:IsA("BasePart") and part:GetAttribute("MK_Key")
		if type(key) == "string" and not FINISH_KEEP[key] and part.Name ~= "Body" and not part:GetAttribute("PB_Star") then
			local neon = part.Material == Enum.Material.Neon
			if look.Finish == "Golden" then
				if GOLD_METAL[key] then
					part.Color = goldTone(part.Color, 0.95)
					if not neon then
						part.Material = Enum.Material.Metal
					end
					part.Reflectance = 0.18
				else
					part.Color = goldTone(part.Color, 0.86)
				end
			elseif RAINBOW_KEYS[key] and not part:GetAttribute("PB_T0") then
				local p = part.Position
				local phase = (0.95 + 1.1 * (p.Y / unit) + 0.9 * (abs(p.X) / unit)) % 1
				part.Color = Color3.fromHSV(phase, neon and 0.42 or 0.52, 1)
				local s = part.Size
				rainbow[#rainbow + 1] = { Part = part, Volume = s.X * s.Y * s.Z, Phase = phase }
			else
				part.Color = part.Color:Lerp(PEARL, 0.3)
			end
		end
	end
	if #rainbow > 0 then
		table.sort(rainbow, function(a, b)
			if a.Volume ~= b.Volume then
				return a.Volume > b.Volume
			end
			return a.Phase < b.Phase
		end)
		for i = 1, min(HUE_PARTS[detail] or HUE_PARTS.High, #rainbow) do
			rainbow[i].Part:SetAttribute("PB_Hue", rainbow[i].Phase)
		end
	end
end

-- PB_Rig in instantiate's order (WingL, WingR, Wing2L, Wing2R, Tail, Halo, Aura, the rest after)
function MESH.sortRig(model)
	local rig = model:GetAttribute("PB_Rig")
	if type(rig) ~= "string" or rig == "" then
		return
	end
	local list = {}
	for entry in string.gmatch(rig, "[^;]+") do
		local name = string.match(entry, "^([^:=]+)")
		list[#list + 1] = { E = entry, R = MESH.RigRank[name] or 50, I = #list + 1 }
	end
	table.sort(list, function(a, b)
		if a.R ~= b.R then
			return a.R < b.R
		end
		return a.I < b.I
	end)
	local out = {}
	for i, e in ipairs(list) do
		out[i] = e.E
	end
	model:SetAttribute("PB_Rig", table.concat(out, ";"))
end

-- the mesh model of a look (a fresh Assemble; Build caches it as a template and hands out clones) or nil
function MESH.assemble(ML, look, detail, plan, scale)
	local parts = {}
	local headFix = nil
	for i, e in ipairs(plan.Entries) do
		local entry = { Key = e.Key, From = 1, Groups = e.Groups, Skip = e.Skip, Scale = e.Scale }
		if e.Head then
			headFix = e.Head
		end
		if type(e.At) == "string" then
			entry.At = e.At
		elseif e.Off then
			entry.At = CFrame.new(e.Off * scale)
		end
		parts[i] = entry
	end
	local grown = scale * plan.Grow
	local attrs = {
		PB_Detail = detail,
		PetId = look.Id,
		PB_Seed = hashString(look.Id .. look.Species),
	}
	if look.Finish then
		attrs.PB_Finish = look.Finish
	end
	if look.Hybrid then
		attrs.PB_Hybrid = true
	end
	local model = ML.Assemble({
		Name = "Pet_" .. look.Id,
		Root = { Name = "Body", Size = plan.Root * grown },
		Parts = parts,
		Attributes = attrs,
	}, look, { Scale = scale })
	if not model then
		return nil
	end
	model:SetAttribute("PB_Scale", grown) -- (Animate's orbit / bob amplitudes follow the grown size, as instantiate)
	MESH.sortRig(model)
	local hyc = plan.Hybrid and MESH.hybridColors(look) or nil
	local stars = 0
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "Body" then
			part.CastShadow = false -- (pets never cast shadows, like the Part build)
			local key = part:GetAttribute("MK_Key")
			if hyc and MESH.HyKeys[key] then
				part.Color = hyc[key]
			end
			-- hybrid features: anchored by height (head top / head centre / floor, see MESH.makePlan)
			if headFix and string.sub(tostring(part:GetAttribute("ML_Key")), 1, 4) == "hyb_" and part:GetAttribute("PB_G") == nil then
				local y = part.Position.Y / scale - headFix.OffY -- (height in the feature key's own space, Scale 1)
				local d = nil
				if y >= headFix.HC and headFix.Top then
					d = headFix.Top * clamp((y - headFix.HC) / (headFix.Y1 - headFix.HC), 0, 1)
				elseif y < headFix.HC and headFix.Ground then
					d = headFix.Ground * (1 - clamp((y - headFix.Y0) / (headFix.HC - headFix.Y0), 0, 1))
				end
				if d then
					part.CFrame = CFrame.new(d * scale) * part.CFrame
				end
			end
			if part:GetAttribute("ML_Key") == "star_gold" then
				stars = stars + 1
				part.Name = (stars > 1) and ("GoldSpark" .. stars) or "GoldSpark"
				part.Color = rgb(255, 238, 160)
				part.Material = Enum.Material.Neon
				part:SetAttribute("PB_Star", true)
				part:SetAttribute("PB_Pulse", part.Transparency)
			end
		end
	end
	if look.Glow then -- Glow pets: Neon irises, glints and wing edges, as makePalette does for the Part build
		for _, part in ipairs(model:GetChildren()) do
			local key = part:IsA("BasePart") and part:GetAttribute("MK_Key")
			if key == "EyeIris" or key == "EyeGlint" or key == "WingEdge" then
				part.Material = Enum.Material.Neon
			end
		end
	end
	if look.Finish then
		MESH.finish(model, look, detail, scale)
	end
	return model
end

-- Build's mesh step: a clone of the cached mesh template of this look, or nil (= the Part build)
function MESH.build(look, detail, stage, scale)
	local ML = MESH.lib()
	if not ML or not ML.Active() then
		return nil
	end
	local plan = MESH.plan(ML, look, detail, stage)
	if not plan or not ML.IsReady(plan.Keys) then
		return nil
	end
	local key = lookSignature(look) .. "|" .. detail .. "|" .. string.format("%.4f", scale)
	local tpl = MESH.Templates[key]
	if not tpl then
		local ok, built = pcall(MESH.assemble, ML, look, detail, plan, scale)
		if not ok then
			warn("[PetBuilder] mesh build failed, using the Part build: " .. tostring(built))
			return nil
		end
		if not built then
			return nil
		end
		tpl = built
		MESH.Templates[key] = tpl
		MESH.Order[#MESH.Order + 1] = key
		if #MESH.Order > MESH.Max then
			local old = table.remove(MESH.Order, 1)
			local m = MESH.Templates[old]
			MESH.Templates[old] = nil
			if m then
				pcall(m.Destroy, m)
			end
		end
	end
	return tpl:Clone()
end

-- the evolution stage Build would use for (petDef, opts) and the look it builds
function MESH.lookOf(petDef, opts)
	local look = readLook(petDef)
	local stage = opts.Evolved
	if stage == nil and type(petDef) == "table" then
		stage = petDef.Evolved
	end
	stage = (stage == true) and 1 or tonumber(stage) or 0
	stage = min(floor(stage), ASCEND_RARITY[look.Rarity] and 2 or 1)
	look.Evolved = (stage == 2) and 2 or (stage == 1) or nil
	return look, stage
end

function PetBuilder.MeshKeys(petDef, opts)
	initConstants()
	opts = type(opts) == "table" and opts or {}
	local ML = MESH.lib()
	if not ML then
		return nil
	end
	local look, stage = MESH.lookOf(petDef, opts)
	local plan = MESH.plan(ML, look, (opts.Detail == "Low") and "Low" or "High", stage)
	return plan and MESH.dedupe(plan.Keys) or nil
end

function PetBuilder.NeedsMeshRebuild(model)
	local info = typeof(model) == "Instance" and MESH.PartInfo[model] or nil
	if not info then
		return false
	end
	local ML = MESH.lib()
	if not ML or not ML.Active() then
		return false
	end
	local plan = MESH.plan(ML, info.Look, info.Detail, info.Stage)
	return (plan and ML.IsReady(plan.Keys)) and true or false
end

function PetBuilder.MeshVersion()
	local ML = MESH.lib()
	return (ML and type(ML.Version) == "function") and ML.Version() or 0
end

-- A Golden PART pet (its body keys are not usable here) still wears the Blender star_gold mesh once that key is ready:
-- the body's voxel sparkle stars (goldSparkles: the hero star on the head, the cheek and chest glints) become
-- star_gold MeshParts of the same span at the same centres (names GoldSpark / GoldSpark2 ..., Neon, PB_Star,
-- PB_Pulse, like the mesh path). The wing glints flap with their wing and stay voxels. star_gold not ready = no change.
function MESH.partStars(model, bp, scale)
	local ML = MESH.lib()
	if not ML or not ML.Active() or not ML.IsReady("star_gold") then
		return false
	end
	local man = ML.Manifest("star_gold")
	local b = man and man.Bounds
	local size = b and (b.Size or b.size)
	local span = (type(size) == "table" and tonumber(size[1])) or 1.0625
	local vs = VOXEL / bp.K * scale * (bp.Grow or 1)
	local made = {}
	for _, spot in ipairs(bp.Stars) do
		local ok, star = pcall(ML.Assemble, "star_gold", nil, {
			Scale = (2 * spot[4] + 1) * vs / span,
			At = CFrame.new(spot[1] * vs, spot[2] * vs, spot[3] * vs),
		})
		if not ok or typeof(star) ~= "Instance" then
			for _, m in ipairs(made) do
				m:Destroy()
			end
			return false
		end
		made[#made + 1] = star
	end
	for _, p in ipairs(model:GetChildren()) do
		if p:IsA("BasePart") and string.sub(p.Name, 1, 9) == "GoldSpark" and p:GetAttribute("PB_G") == nil then
			p:Destroy()
		end
	end
	local n = 0
	for _, star in ipairs(made) do
		local parts = {}
		for _, p in ipairs(star:GetDescendants()) do
			if p:IsA("BasePart") then
				parts[#parts + 1] = p
			end
		end
		table.sort(parts, function(a, c)
			return a.Name < c.Name
		end)
		for _, p in ipairs(parts) do
			n = n + 1
			p.Name = (n > 1) and ("GoldSpark" .. n) or "GoldSpark"
			p.Color = rgb(255, 238, 160)
			p.Material = Enum.Material.Neon
			p.CastShadow = false
			p:SetAttribute("PB_Star", true)
			p:SetAttribute("PB_Pulse", p.Transparency)
			p.Parent = model
		end
		star:Destroy()
	end
	model:SetAttribute("PB_MeshStars", n)
	return true
end

-- SERVER builders (NpcService, LobbyBuilder fountain, StormAltar, SpotService podium) build their pets once at boot,
-- usually before MeshLibrary has loaded the keys. SwapWhenReady(model, petDef, opts, buildFn, onSwapped) -> bool:
-- when `model` is a Part build whose mesh keys still load, MeshLibrary.Swap rebuilds it ONCE they are ready (buildFn
-- returns the finished, placed model; onSwapped(fresh, old) lets the caller take the new one). Empty MeshIds (no
-- template folder) or a key without an id = false and no state at all.
function PetBuilder.SwapWhenReady(model, petDef, opts, buildFn, onSwapped)
	if typeof(model) ~= "Instance" or type(buildFn) ~= "function" or model:GetAttribute("ML_Mesh") == true then
		return false
	end
	local ML = MESH.lib()
	if not ML or type(ML.Swap) ~= "function" or not ML.Active() then
		return false
	end
	local ok, keys = pcall(PetBuilder.MeshKeys, petDef, opts)
	if not ok or type(keys) ~= "table" or #keys == 0 or ML.IsReady(keys) then
		return false
	end
	-- a key with no id, or one that FAILED to load (review3 world-3), never becomes ready: nothing waits on it
	for _, key in ipairs(keys) do
		local st = ML.Status(key)
		if st == "missing" or st == "failed" then
			return false
		end
	end
	ML.Swap(model, buildFn, keys, { Place = false, OnSwapped = onSwapped })
	return true
end

-- review3 runtime-2: a SERVER-built mesh pet (NPC pets, the fountain statue, podium pets, the Storm Altar Stormfang)
-- replicates as MeshParts; a device whose PreloadAsync failed for one of its keys cannot draw it. The server stamps the
-- pet's definition on the model (PBD_* attributes: ids, rarity, the flat Look and the hybrid StyleDef Look, stage,
-- detail, scale, keys) and tags it SERVER_MESH_TAG; the client's MeshFallback rebuilds the Part pet from
-- PetBuilder.ServerDef(model) on such a device. Nothing is stamped on the Part path or on the client (empty MeshIds =
-- today's game).
MESH.ServerTag = "PB_ServerMesh"
function MESH.isServer()
	if MESH.IsServer == nil then
		local ok, v = pcall(function()
			return game:GetService("RunService"):IsServer()
		end)
		MESH.IsServer = ok and v == true
	end
	return MESH.IsServer
end

local function stampable(v)
	local t = typeof(v)
	return t == "string" or t == "number" or t == "boolean" or t == "Color3"
end

function MESH.stampLook(model, prefix, look)
	if type(look) ~= "table" then
		return
	end
	for k, v in pairs(look) do
		if type(k) == "string" and string.match(k, "^[%a_][%w_]*$") and #k <= 60 and stampable(v) then
			model:SetAttribute(prefix .. k, v)
		end
	end
end

function MESH.stamp(model, petDef, detail, stage, scale)
	if type(petDef) ~= "table" then
		return
	end
	pcall(function()
		for _, k in ipairs({ "Id", "PetId", "Rarity", "IsHybrid", "DisplayName" }) do
			if stampable(petDef[k]) then
				model:SetAttribute("PBD_" .. k, petDef[k])
			end
		end
		MESH.stampLook(model, "PBDL_", petDef.Look)
		if type(petDef.StyleDef) == "table" then
			if stampable(petDef.StyleDef.Id) then
				model:SetAttribute("PBD_StyleId", petDef.StyleDef.Id)
			end
			MESH.stampLook(model, "PBDS_", petDef.StyleDef.Look)
		end
		model:SetAttribute("PBD_Detail", detail)
		model:SetAttribute("PBD_Stage", stage)
		model:SetAttribute("PBD_Scale", scale)
		local plan = MESH.plan(MESH.lib(), MESH.lookOf(petDef, { Evolved = stage }), detail, stage)
		if plan then
			model:SetAttribute("PBD_Keys", table.concat(MESH.dedupe(plan.Keys), ","))
		end
		game:GetService("CollectionService"):AddTag(model, MESH.ServerTag)
	end)
end

-- PetBuilder.ServerDef(model) -> petDef, opts | nil: the definition MESH.stamp put on a server-built mesh pet, and the
-- Build opts that rebuild it as the Part pet (Parts = true, NoFx = true: the mesh model keeps its own PetFx).
-- PetBuilder.ServerMeshTag = the CollectionService tag of those models.
PetBuilder.ServerMeshTag = MESH.ServerTag
function PetBuilder.ServerDef(model)
	if typeof(model) ~= "Instance" or type(model:GetAttribute("PBD_Detail")) ~= "string" then
		return nil
	end
	local def, look, style = { Look = {} }, nil, nil
	for name, v in pairs(model:GetAttributes()) do
		local f = string.match(name, "^PBDL_(.+)$")
		local g = string.match(name, "^PBDS_(.+)$")
		local h = string.match(name, "^PBD_(.+)$")
		if f then
			def.Look[f] = v
		elseif g then
			style = style or { Look = {} }
			style.Look[g] = v
		elseif h and h ~= "Detail" and h ~= "Stage" and h ~= "Scale" and h ~= "Keys" and h ~= "StyleId" then
			def[h] = v
		end
	end
	look = model:GetAttribute("PBD_StyleId")
	if style or look ~= nil then
		style = style or { Look = {} }
		style.Id = look
		def.StyleDef = style
	end
	local opts = {
		Parts = true,
		NoFx = true,
		Detail = model:GetAttribute("PBD_Detail"),
		Scale = tonumber(model:GetAttribute("PBD_Scale")) or 1,
		Evolved = tonumber(model:GetAttribute("PBD_Stage")) or 0,
	}
	return def, opts
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function PetBuilder.Build(petDef, opts)
	initConstants()
	if not Voxel then
		error("PetBuilder needs shared/Voxel")
	end
	opts = type(opts) == "table" and opts or {}
	local scale = clamp(tonumber(opts.Scale) or 1, 0.05, 40)
	local detail = (opts.Detail == "Low") and "Low" or "High"
	local look = readLook(petDef)
	-- evolution stage: true / 1 = evolved, 2 = second evolution (Epic and up; others stop at their first)
	local stage = opts.Evolved
	if stage == nil and type(petDef) == "table" then
		stage = petDef.Evolved
	end
	stage = (stage == true) and 1 or tonumber(stage) or 0
	stage = min(floor(stage), ASCEND_RARITY[look.Rarity] and 2 or 1)
	look.Evolved = (stage == 2) and 2 or (stage == 1) or nil
	-- Phase 6: the Blender mesh pet when every key it needs is usable here, else the whole Part build (opts.Parts =
	-- true forces the Part build)
	local model = nil
	if opts.Parts ~= true then
		model = MESH.build(look, detail, stage, scale)
		if model and MESH.isServer() then
			MESH.stamp(model, petDef, detail, stage, scale)
		end
	end
	if not model then
		local bp, bpKey = getBlueprint(look, detail)
		local tpl = getTemplate(bp, bpKey, scale)
		model = tpl:Clone()
		MESH.PartInfo[model] = { Look = look, Detail = detail, Stage = stage }
		if bp.Stars and look.Finish == "Golden" and opts.Parts ~= true then
			MESH.partStars(model, bp, scale)
		end
	end
	model.PrimaryPart = model:FindFirstChild("Body")
	if look.Rarity == "Legendary" or look.Rarity == "Mythic" or look.Rarity == "Secret" then
		addSparkles(model, look, (detail == "Low") and 3 or 5, scale)
	end
	if look.Finish then
		addFinishSparkles(model, look, FINISH_SPARKLE_RATE[detail] or 3, scale)
	end
	-- Phase 5 (contract 3.7): the stage this model was built at, for the tests of the "evolved looks everywhere" rule
	model:SetAttribute("PB_Evolved", look.Evolved == 2 and 2 or (look.Evolved and 1 or 0))
	if type(opts.Wild) == "table" then
		applyWild(model, opts.Wild)
	end
	-- Phase 6 (contract 6.4): auras, particles and lights of evolved pets (both the Part and the mesh path)
	if stage > 0 and PetFx and opts.NoFx ~= true then
		PetFx.Apply(model, look, stage, { Detail = detail, Scale = scale, Viewport = opts.Viewport, Fx = opts.Fx, Element = opts.Element })
	end
	return model
end

-- the glow colours of an evolution into `stage` (1: gold + the evolved form's gem, 2: the second evolution's
-- two neon accents), for the evolution animation (client/Controllers/EvolutionFx.lua)
function PetBuilder.EvolutionColors(petDef, stage)
	initConstants()
	local look = readLook(petDef)
	if stage == 2 then
		local st = ASC.Look[look.Base]
		if st and st.Glow and st.GlowB then
			return evoRGB(st.Glow), evoRGB(st.GlowB)
		end
		return lighten(look.Secondary, 0.3), lighten(look.WingColor, 0.4)
	end
	local st = EVO.Look[look.Base]
	return rgb(255, 214, 90), (st and st.Gem) and evoRGB(st.Gem) or lighten(look.Secondary, 0.2)
end

-- how far a pet can evolve (petDef or a rarity name): 2 (a second evolution) for Epic, Legendary, Mythic and
-- Secret pets, 1 for the rest
function PetBuilder.MaxEvolution(petDef)
	local rarity = petDef
	if type(petDef) == "table" then
		rarity = petDef.Rarity
	end
	return ASCEND_RARITY[rarity] and 2 or 1
end

function PetBuilder.Animate(model, t, opts)
	if typeof(model) ~= "Instance" then
		return
	end
	local rig = getRig(model)
	if not rig then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not root or not root:IsA("BasePart") then
		return
	end
	if type(t) ~= "number" then
		t = os.clock()
	end
	local flapMul, excited = 1, 0
	if type(opts) == "table" then
		if type(opts.Flap) == "number" then
			flapMul = clamp(opts.Flap, 0, 8)
		end
		if type(opts.Excited) == "number" then
			excited = clamp(opts.Excited, 0, 1)
		end
	end
	advance(rig, t, flapMul, excited)
	local base = root.CFrame
	local st = rig.St
	local groups = rig.Groups
	for i = 1, #groups do
		local gr = groups[i]
		local cur = base * gr.Hinge * groupMotion(gr, st)
		local parts, bases = gr.Parts, gr.Base
		for j = 1, #parts do
			parts[j].CFrame = cur * bases[j]
		end
	end
	updateBlink(rig, t)
	updatePulse(rig, t)
	updateHue(rig, t)
end

-- Height of the resting pose (studs, Scale 1), measured once per look from the High build.
local heightCache = {}
local DEFAULT_HEIGHT = 2.8

function PetBuilder.GetHeight(petDef)
	initConstants()
	if not Voxel then
		return DEFAULT_HEIGHT
	end
	local look = readLook(petDef)
	local key = lookSignature(look)
	local cached = heightCache[key]
	if cached then
		return cached
	end
	local h = DEFAULT_HEIGHT
	local ok, model = pcall(PetBuilder.Build, petDef, { Scale = 1 })
	if ok and model then
		local lo, hi = math.huge, -math.huge
		for _, inst in ipairs(model:GetDescendants()) do
			if inst:IsA("BasePart") then
				local _, y, _, _, _, _, r10, r11, r12 = inst.CFrame:GetComponents()
				local half = (abs(r10) * inst.Size.X + abs(r11) * inst.Size.Y + abs(r12) * inst.Size.Z) / 2
				if y - half < lo then
					lo = y - half
				end
				if y + half > hi then
					hi = y + half
				end
			end
		end
		if hi > lo then
			h = hi - lo
		end
		model:Destroy()
	end
	heightCache[key] = h
	return h
end

-- Phase 6 kit hook (read-only, never used by the game): the blueprint of a pet at the mesh resolution k (sculpted
-- voxels per design unit) with no part budget, plus bp.Anchors. petDef as in Build (petDef.Evolved = 1 | 2).
-- The kit (blender/kit/bridge.py) reads the shaded grids through Voxel.Shade / Voxel.Merge; nothing is cached.
function PetBuilder._Blueprint(petDef, detail, k)
	initConstants()
	detail = (detail == "Low") and "Low" or "High"
	local look = readLook(petDef)
	local stage = (type(petDef) == "table") and petDef.Evolved or nil
	stage = (stage == true) and 1 or tonumber(stage) or 0
	stage = min(floor(stage), ASCEND_RARITY[look.Rarity] and 2 or 1)
	look.Evolved = (stage == 2) and 2 or (stage == 1) or nil
	MESH_K = tonumber(k) or 1
	local ok, bp = pcall(buildBlueprint, look, detail)
	MESH_K = nil
	if not ok then
		error(bp, 0)
	end
	return bp
end

return PetBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="816">
        <Properties>
          <string name="Name">PetCatalog</string>
          <string name="Source"><![CDATA[-- PetCatalog: every collectible winged pet in Nimbus Climb, plus the pure logic around them
-- (roulette rolling, odds, perk maths, v3 roles / stats / specials and the Pet Index groups).
-- Pure data + logic: no Instances, safe on server and client. Plain Lua 5.1-compatible syntax only.
--
-- API (contract in ARCHITECTURE_V2.md section 2 and ARCHITECTURE_V3.md section 2):
--   PetCatalog.Species                    array of species names PetBuilder understands
--   PetCatalog.Pets                       array of PetDef, sorted by rarity order, then Name (a Signature pet
--                                         leads its rarity)
--   PetCatalog.ById                       map id -> PetDef
--   PetCatalog.Get(id)                    -> PetDef|nil
--   PetCatalog.ListByRarity(rarityId)     -> { PetDef... } (same order as Pets)
--   PetCatalog.GetRarity(rarityId)        -> { Id, Order, Color }|nil          (from Config.Rarities)
--   PetCatalog.RollPet(rouletteId, rng)   -> petId|nil   weighted rarity (Roulette.Odds), then uniform pet
--   PetCatalog.GetOdds(rouletteId)        -> { { PetId, Rarity, Chance }... }  Chance sums to 1
--   PetCatalog.PossiblePets(rouletteId)   -> { PetDef... }
--   PetCatalog.PerkLabel(perkType, value) -> "+12% Max Health"
--   PetCatalog.SumPerks(petIds)           -> { MaxHealth, TokenBonus, StaminaRegen, CheckpointHeal } (capped)
--   v3:
--   PetCatalog.IndexGroups()              -> { { Id, Rarity, Pets = {PetDef...}, Reward = {Tokens = n} }... }
--                                            one group per rarity that has pets, in rarity order (Secret last)
--   PetCatalog.GetStats(petId, level, tier, stage) -> { Income, Power, Health, Speed } | nil   (Phase 2: tier; Phase 5: stage)
--                                            base * Config.PetStats.RarityScale[rarity] * LevelFactor(level, stage)
--                                            * tier multiplier (Normal 1, Golden 1.5, Rainbow 2.5). The same numbers
--                                            as TycoonCatalog.PetPower x FoodOf / MealSeconds, so the Income shown is the Cash/s the Garden
--                                            pays (prestige not applied). petId may also be a pet key ("cat@Golden":
--                                            the tier comes from the key unless `tier` is given) or a def table
--                                            (PetKeys.DefOf: tier copies and fused hybrids). level defaults to 1 and
--                                            is clamped to 1..MaxPetLevel(); tier also takes a key or a multiplier.
--   PetCatalog.TotalCount()               -> number of pets in the catalog (Secret pets included)
--   Phase 2 pet levels (care agent; the XP curve itself is TycoonCatalog.XpToNext):
--   PetCatalog.LevelCap(subject)          -> the highest level XP (food, fights) can raise a pet to, by rarity
--                                            (subject = rarity id, pet id, pet key or def): Phase 4: 100 for every
--                                            rarity. TycoonCatalog may override them (PetXp.RarityCaps /
--                                            PetLevelCaps); never above MaxPetLevel(). nil for unknown pets.
--   PetCatalog.MaxPetLevel()              -> top of the XP curve (TycoonCatalog.MaxPetLevel, else MaxLevel = 100)
--   PetCatalog.LevelFactor(level, stage)  -> 1 + LevelBonus x (level - 1) x EvolutionBonus[stage]   (level clamped like
--                                            GetStats; stage nil -> 0; Phase 5 contract 3.1: the ONE level formula for
--                                            battle, coins and UI; rarity 1 examples: L1 1.0, L20 evo1 3.85, L50 evo2 10.19)
--   PetCatalog.StatsOf(def, level, tier, stage) -> the body of GetStats for a def table (stage = the STORED stage,
--                                            cleaned by EvolutionStage(def, level, stored); the level alone never evolves)
--   PetCatalog.EvolutionBonus             { [0] = 1, [1] = 1.5, [2] = 1.875 }: multiplies the LEVEL BONUS (not the stat)
--   PetCatalog.EvolutionBonusOf(stage)    -> 1 | 1.5 | 1.875  ("Level bonus x1.5" in texts; junk / nil -> 1)
--   PetCatalog.TierMultiplier(tier)       -> 1 | 1.5 | 2.5 (a tier name, a pet key, a def or a multiplier)
--   Phase 4 evolution and garden roles (ARCHITECTURE_V3.md "Phase 4 build contract" 3.2 / 3.6):
--   PetCatalog.EvolutionLevels            { 20, 50 }: the level a pet needs for stage 1 / stage 2
--   PetCatalog.RoleMult                   { Economy = 1.6, Combat = 1 }: garden coins by Role
--   PetCatalog.MaxEvolution(subject)      -> 1 | 2  (2 for Epic, Legendary, Mythic, Secret: the data mirror of
--                                            PetBuilder.MaxEvolution). subject = def, rarity id, pet id or pet key
--                                            (hybrid keys need their def: PetKeys.DefOf); unknown -> 1
--   PetCatalog.EvolutionStage(subject, level, stored) -> 0 | 1 | 2  the stored stage (PetGrowth[key].Evo, set by
--                                            pressing EVOLVE) cleaned to a whole number in 0..MaxEvolution; the
--                                            level alone never evolves a pet
--   PetCatalog.CanEvolve(subject, level, stage) -> nextStage | nil  when level >= EvolutionLevels[next] and
--                                            next <= MaxEvolution(subject)
--   PetCatalog.RoleMultiplier(subject)    -> RoleMult[def.Role] (1 for unknown roles / pets)
--   v3 elements (ARCHITECTURE_V3.md section 11, chart in Config.Elements):
--   PetCatalog.ElementsOf(def)            -> { element... }  a pet's Element, or a fused hybrid's Elements
--                                            (deduplicated, only names from Config.Elements.Order; {} otherwise)
--   PetCatalog.GetElements(petId)         -> { element... }  ElementsOf(Get(petId)); {} for unknown pets
--   PetCatalog.ElementMultiplier(attackElement, defendElement) -> number
--                                            StrongMultiplier (1.5) when the attacker beats the defender,
--                                            WeakMultiplier (0.75) when the defender beats the attacker, else 1.
--                                            Either side may also be a list (a dual-element hybrid): the attacker
--                                            uses its best element, a dual defender combines both matchups
--                                            (clamped to weak .. strong). Unknown / nil elements count as x1.
-- Extras (nothing depends on them): PerkOrder, PerkNames, Accessories, WingStyles, Roles, RoleBlurbs,
--   StatOrder, StatNames, SpecialKinds, GetRarityOdds, PerkLines, GetIndexGroup, IsRollable, Validate.
--   Phase 5 (contract 3.2): SpecialKinds + "Rally" (fighter damage +35% for 8 s) and "Haste" (attack + move speed
--   +35% for 8 s). Every Economy pet (a Support in battle) has exactly one Support kind: Heal, Shield, Rally or Haste;
--   ids kept, names kept where they fit. Combat pets keep their specials. Validate enforces it.
--
-- PetDef v3 fields (every pet has them):
--   Role    = "Economy" | "Combat". Economy pets earn Cash at home (phase 2): high Income, low Power/Health.
--             Combat pets fight in the arena (phase 3): high Power/Health, low Income. Roughly half of each per rarity.
--   Stats   = { Income, Power, Health, Speed }: BASE values at rarity scale 1. Income = Cash per second while
--             working at home, Power = damage per hit, Health = hit points, Speed = attack tempo rating.
--   Special = { Id, Name, Kind, Power, Color }: the pet's special attack. Kind decides the effect
--             (Blast / Pounce / Beam / Storm / Freeze deal damage, Freeze also slows, Heal restores HP,
--             Shield absorbs damage); Power is its base strength at rarity scale 1 (scale it like Stats);
--             Color tints the effect.
--   Element = one of Config.Elements.Order, chosen by species, look and theme (Phoenix / flame looks -> Flame,
--             Penguin / icy -> Frost, Frog / Axolotl / watery -> Water, Bunny / Panda / leafy -> Nature,
--             Bear / Dog / earthy -> Earth, Owl / electric / windy sky pets -> Storm, Unicorn / halo -> Celestial,
--             dark Secrets -> Shadow). Every element has at least 3 pets across several rarities.
--   Signature = true (optional): the player's own creature (Stormfang); it leads its rarity in every list.
--   EventOnly = true (optional, Phase 3 events): an exclusive Boss Raid drop. Never in any roulette (RollPet /
--             GetOdds / PossiblePets / IsRollable skip it and ListByRarity, the roulette pool every roulette
--             (token and gems-only) is built from, leaves it out unless asked with ListByRarity(rarity, true)).
--             It is still a full catalog pet: in PetCatalog.Pets, Get, TotalCount and its rarity's Pet Index group
--             (after the regular pets). Helpers: PetCatalog.EventPets() -> { PetDef... }, PetCatalog.IsEventOnly(id).
--
-- Secret pets (Rarity "Secret") come only from a roulette that sets `AllowSecret = true` (the gems-only Secret
-- roulette of phase 2). No current roulette does, so RollPet / GetOdds / PossiblePets never offer them.
--
-- Perk strength scales with rarity (Common ~2-4%, Mythic ~10-25%, Secret a step above Mythic). Pets never touch
-- run speed or jump power, so the course physics guarantees keep holding.

local Config = require(script.Parent.Config)

local PetCatalog = {}

PetCatalog.Species = {
	"Cat", "Dog", "Fox", "Bunny", "Bear", "Panda", "Dragon",
	"Owl", "Slime", "Unicorn", "Phoenix", "Frog", "Penguin", "Axolotl",
	"Stormfang", -- the player's own armoured storm lynx (ARCHITECTURE_V3.md section 10)
}

-- Values PetBuilder supports for the optional / enumerated Look fields.
PetCatalog.Accessories = { "Horns", "Crown", "Halo", "Leaf", "Mushroom", "Scarf", "Antlers", "Flower" }
PetCatalog.WingStyles = { "Feather", "Bat", "Fairy", "Cloud", "Crystal", "Flame", "StormCloud" } -- StormCloud: Stormfang's ride

-- Perk display order + player-facing names (keys match Config.Pets.PerkCaps).
PetCatalog.PerkOrder = { "MaxHealth", "TokenBonus", "StaminaRegen", "CheckpointHeal" }
PetCatalog.PerkNames = {
	MaxHealth = "Max Health",
	TokenBonus = "Cloud Tokens",
	StaminaRegen = "Stamina Regen",
	CheckpointHeal = "Checkpoint Heal",
}

-- v3: roles, stats and special kinds (display order + player-facing names).
PetCatalog.Roles = { "Economy", "Combat" }
PetCatalog.RoleBlurbs = {
	Economy = "Works at your home and earns Cash.",
	Combat = "Fights in the arena with strong attacks.",
}
PetCatalog.StatOrder = { "Income", "Power", "Health", "Speed" }
PetCatalog.StatNames = { Income = "Coins", Power = "Power", Health = "Health", Speed = "Speed" } -- Phase 4: pets make coins
PetCatalog.SpecialKinds = { "Blast", "Heal", "Shield", "Storm", "Pounce", "Freeze", "Beam", "Rally", "Haste" } -- Phase 5: + Rally / Haste (Support kinds)
PetCatalog.SupportKinds = { "Heal", "Shield", "Rally", "Haste" } -- Phase 5 contract 3.2: the kinds an Economy (Support) pet may have

local SECRET = "Secret"

local function C(r, g, b)
	return Color3.fromRGB(r, g, b)
end

-- Compact constructors for the v3 data (keeps the lineup readable).
local function Stats(income, power, health, speed)
	return { Income = income, Power = power, Health = health, Speed = speed }
end

local function Special(id, name, kind, power, color)
	return { Id = id, Name = name, Kind = kind, Power = power, Color = color }
end

----------------------------------------------------------------------
-- The lineup. Palettes are calm and slightly dusty (nothing blinding); the rarer the pet, the more
-- it glows. Wing colours are chosen to read against the sky, not to match the body exactly.
-- Stat bands at rarity scale 1:
--   Economy  Income 9-12, Power 2-4,  Health 24-36, Speed 7-13
--   Combat   Income 2-3,  Power 8-12, Health 50-72, Speed 7-14
-- Within a band the species decides the shape (bears/pandas tank, foxes/cats are quick, dragons hit hard).
----------------------------------------------------------------------
