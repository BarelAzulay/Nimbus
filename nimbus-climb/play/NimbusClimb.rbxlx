PixelIcon.Bitmaps.signpost = "....#..../#######../########./#########/########./#######../....#..../....#..../..#####.." -- Travel, one ink
PixelIcon.Bitmaps.rarity_common = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Common, one ink
PixelIcon.Bitmaps.rarity_uncommon = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Uncommon, one ink
PixelIcon.Bitmaps.rarity_rare = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Rare, one ink
PixelIcon.Bitmaps.rarity_epic = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Epic, one ink
PixelIcon.Bitmaps.rarity_legendary = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Legendary, one ink
PixelIcon.Bitmaps.rarity_mythic = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Mythic, one ink
PixelIcon.Bitmaps.rarity_secret = "........./...###.../..#####../.#######./.#######./.#######./..#####../...###.../........." -- Secret, one ink
-- each art-size icon's 19 x 19 cell in build/upload_sheets/icons_b.png (x, y); GreyY: the greyed twins' offset
PixelIcon.SheetCells = { Art = 19, GreyY = 40, note = { 0, 0 }, token = { 20, 0 }, gem = { 40, 0 }, pot = { 60, 0 }, egg = { 80, 0 }, bag = { 100, 0 }, gift = { 120, 0 }, box = { 140, 0 }, ticket = { 0, 20 }, potion = { 20, 20 }, paw = { 40, 20 }, book = { 60, 20 }, house = { 80, 20 }, stats = { 100, 20 }, gear = { 120, 20 }, signpost = { 140, 20 } }
-- END GENERATED icons_b
-- tick is the pitch's check (one drawing, two names)
PixelIcon.Bitmaps.tick = PixelIcon.Bitmaps.check

local cache = {}

-- (U5) the sizes warned about: [px] = 1. A size between multiples of 9 draws whole cells off-centre in a padded box, so
-- New warns once per such size (pass 18, 27, 36, ...)
PixelIcon.Warned = {}

-- the merged rectangles of an icon, { x, y, w, h } in cells (0-based), nil for an unknown name
function PixelIcon.Runs(name)
	if cache[name] then
		return cache[name]
	end
	local bmp = PixelIcon.Bitmaps[name]
	if type(bmp) ~= "string" then
		return nil
	end
	local rows = {}
	for row in (bmp .. "/"):gmatch("([^/]*)/") do
		rows[#rows + 1] = row
	end
	local rects = {}
	local open = {} -- [x .. ":" .. w] = the rectangle still growing down from the row above
	for y = 0, #rows - 1 do
		local row = rows[y + 1]
		local nextOpen = {}
		local x = 1
		while x <= #row do
			if row:sub(x, x) == "#" then
				local s = x
				while x <= #row and row:sub(x, x) == "#" do
					x = x + 1
				end
				local key = (s - 1) .. ":" .. (x - s)
				local r = open[key]
				if r then
					r[4] = r[4] + 1
				else
					r = { s - 1, y, x - s, 1 }
					rects[#rects + 1] = r
				end
				nextOpen[key] = r
			else
				x = x + 1
			end
		end
		open = nextOpen
	end
	cache[name] = rects
	return rects
end

----------------------------------------------------------------------
-- (Pitch 2 item 9 B) the own-colour glyphs, the greyed state and the uploaded sheet
----------------------------------------------------------------------
PixelIcon.Own = "Own" -- New's colour for "the icon's own colours" (Host and Lead pass it when the caller gave none)
PixelIcon.Art = PixelIcon.Art or {}
PixelIcon.SheetCells = PixelIcon.SheetCells or {}
local DROP_COLOUR = Color3.fromRGB(59, 36, 18) -- Theme.Sign.Text: the drop shadow, at 30 %
local DROP_T = 0.7
local GREY_TO = { 243, 230, 200 } -- Theme.Sign.Well: a greyed colour is its luminance a third of the way to it

-- the merged rectangles of an Art glyph, { x, y, w, h, letter } in cells (0-based; the drop shadow "~" in row / column 9
-- too): each row's runs of one letter, merged down while the next row has the same run. nil for a name with no Art
local artCache = {}
function PixelIcon.ArtRuns(name)
	if artCache[name] then
		return artCache[name]
	end
	local a = PixelIcon.Art[name]
	if type(a) ~= "table" or type(a.R) ~= "string" then
		return nil
	end
	-- (P2 icons review r1, major 6) the generated draw list: the glyph in layers, bottom first (the drop shadow, then one
	-- colour at a time over the colours drawn after it; tools/build_upload_sheets.py), 23 - 35 Frames where one Frame per
	-- run of one colour cost up to 51. Five characters a Frame: x, y, w, h in base 36 and the letter
	if type(a.L) == "string" and #a.L > 0 and #a.L % 5 == 0 then
		local rects = {}
		for i = 1, #a.L, 5 do
			rects[#rects + 1] = {
				tonumber(a.L:sub(i, i), 36), tonumber(a.L:sub(i + 1, i + 1), 36), tonumber(a.L:sub(i + 2, i + 2), 36),
				tonumber(a.L:sub(i + 3, i + 3), 36), a.L:sub(i + 4, i + 4),
			}
		end
		artCache[name] = rects
		return rects
	end
	local rects, open, y = {}, {}, 0
	for row in (a.R .. "/"):gmatch("([^/]*)/") do
		local nextOpen = {}
		local x = 1
		while x <= #row do
			local ch = row:sub(x, x)
			if ch ~= "." then
				local s = x
				while x <= #row and row:sub(x, x) == ch do
					x = x + 1
				end
				local key = ch .. (s - 1) .. ":" .. (x - s)
				local r = open[key]
				if r then
					r[4] = r[4] + 1
				else
					r = { s - 1, y, x - s, 1, ch }
					rects[#rects + 1] = r
				end
				nextOpen[key] = r
			else
				x = x + 1
			end
		end
		open = nextOpen
		y = y + 1
	end
	artCache[name] = rects
	return rects
end

-- (P2 icons review r1, major 7: on the navy top bar the gear's dark outline melted into the plank, a grey smudge) the
-- draw list of an Art glyph in a keyline: first its silhouette grown one cell every way (8 neighbours) as letter "@" (the
-- key colour: New draws it under the glyph, so only a 1-cell ring of it shows), then the glyph's layers without the drop
-- shadow (the mock-up's top bar: make_item9.keyline, no drop on a dark plate). Cells run -1 .. 10. nil with no Art
-- (P2 icons look fin0, minor: the Daily's claimed tick, green on Day 1's green bills) a one-ink glyph's keyline the same
-- way: its runs ("#", drawn in the caller's ink) over the grown ring
local keyCache = {}
function PixelIcon.KeyRuns(name)
	if keyCache[name] then
		return keyCache[name]
	end
	local art = PixelIcon.ArtRuns(name)
	if not art then
		local runs = PixelIcon.Runs(name)
		if not runs then
			return nil
		end
		art = {}
		for i, r in ipairs(runs) do
			art[i] = { r[1], r[2], r[3], r[4], "#" }
		end
	end
	local solid = {}
	for _, r in ipairs(art) do
		if r[5] ~= "~" then
			for y = r[2], r[2] + r[4] - 1 do
				for x = r[1], r[1] + r[3] - 1 do
					solid[y * 16 + x] = true
				end
			end
		end
	end
	local function grown(x, y)
		for dy = -1, 1 do
			for dx = -1, 1 do
				local xx, yy = x + dx, y + dy
				if xx >= 0 and yy >= 0 and xx <= 9 and yy <= 9 and solid[yy * 16 + xx] then
					return true
				end
			end
		end
		return false
	end
	local rects, open = {}, {}
	for y = -1, 10 do
		local nextOpen = {}
		local x = -1
		while x <= 10 do
			if grown(x, y) then
				local s = x
				while x <= 10 and grown(x, y) do
					x = x + 1
				end
				local k = s .. ":" .. (x - s)
				local r = open[k]
				if r then
					r[4] = r[4] + 1
				else
					r = { s, y, x - s, 1, "@" }
					rects[#rects + 1] = r
				end
				nextOpen[k] = r
			else
				x = x + 1
			end
		end
		open = nextOpen
	end
	for _, r in ipairs(art) do
		if r[5] ~= "~" then
			rects[#rects + 1] = r
		end
	end
	keyCache[name] = rects
	return rects
end

-- the colour of letter `ch` of Art glyph `name` (the drop shadow's for "~")
local colourCache = {}
local function artColour(name, ch)
	if ch == "~" then
		return DROP_COLOUR
	end
	local per = colourCache[name]
	if not per then
		per = {}
		colourCache[name] = per
	end
	if per[ch] == nil then
		local a = PixelIcon.Art[name]
		local n = tonumber(a and a.P and a.P[ch] or "", 16) or 0
		per[ch] = Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256)
	end
	return per[ch]
end

-- a colour's greyed twin (the disabled state; the sheet's greyed row is baked with the same rule)
local function greyOf(c)
	local r, g, b = c.R * 255, c.G * 255, c.B * 255
	local lum = 0.299 * r + 0.587 * g + 0.114 * b
	local function ch(t)
		return math.floor(lum + (t - lum) * 0.35 + 0.5)
	end
	return Color3.fromRGB(ch(GREY_TO[1]), ch(GREY_TO[2]), ch(GREY_TO[3]))
end

-- a Frame's transparency under a text's: its own (BaseT: the drop shadow's 30 %) composed with t
local function composeT(f, t)
	local base = f:GetAttribute("BaseT")
	if not base then
		return t
	end
	return 1 - (1 - base) * (1 - t)
end

-- the uploaded sheet's image id (Config.IconSheet.Id, a whole number above 0), else 0. Config is read when an art-size
-- icon draws, never at load; while it is not there yet (the loading screen) the icon draws its 9 x 9 glyph
local configMod = nil -- the module once required, false when requiring it failed
local function sheetId()
	if configMod == nil then
		local ok, mod = pcall(function()
			return require(script.Parent.Config)
		end)
		if ok and type(mod) == "table" then
			configMod = mod
		elseif ok then
			configMod = false
		end
	end
	local t = configMod and configMod.IconSheet
	local id = type(t) == "table" and tonumber(t.Id) or 0
	if id and id > 0 and id == math.floor(id) then
		return id
	end
	return 0
end

-- (P2 icons look fin1, tools/check.mjs asset-id) an uploaded sheet's image URL: Config.Art.Image, the one place asset
-- URLs are made ("" while Config is not there; the sheet paths run only with an id from it)
local function sheetImage(id)
	sheetId() -- (requires Config once)
	local art = configMod and configMod.Art
	return type(art) == "table" and type(art.Image) == "function" and art.Image(id) or ""
end

-- the sheet cell an Own icon of px draws from: art sizes only (2+ px cells on the 18 grid), a name the sheet holds, an id
local function sheetCellFor(name, px)
	local c = PixelIcon.SheetCells[name]
	if type(c) ~= "table" or math.floor(px / 18) < 2 then
		return nil
	end
	if sheetId() <= 0 then
		return nil
	end
	return c
end

----------------------------------------------------------------------
-- (LOOK-ui, kitb-look1: the owner's look bar 2026-11-17, "pixel edges snapped to whole pixels at every screen size")
-- whole device px under a UIScale. A window or the HUD sits under a Fit / ViewportScale of 0.8 or 0.85 below 1080p, so a
-- 2 px design cell drew 1.6 screen px (lumpy 1-and-2 px cells in the game, soft in the renders). A part that must stay
-- on the pixel grid asks for its design px through PixelIcon.Px(n, s): the nearest whole number of screen px (at least
-- one), back in design px. PixelIcon.Whole re-runs a part's sizing whenever the rest scale above it changes.
----------------------------------------------------------------------
-- n design px under rest scale s: a whole number of screen px (at least one while n > 0), in design px
function PixelIcon.Px(n, s)
	n = tonumber(n) or 0
	s = tonumber(s) or 1
	if n <= 0 or s <= 0 then
		return n
	end
	return math.max(1, math.floor(n * s + 0.5)) / s
end

-- a UIScale that tweens and rests at 1 (a pop, a pulse, the HUD's unnamed ones) is left out of the rest scale: the
-- grid is the one the part rests on
local TRANSIENT = { Pop = true, Pulse = true, PopScale = true, FxScale = true, UIScale = true }

-- the product of the resting UIScales on `obj` and every GuiObject above it, up to its ScreenGui; `found` (optional) gets
-- each one
local function restScaleOf(obj, found)
	local s = 1
	local cur = obj
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") then
			for _, ui in ipairs(cur:GetChildren()) do
				if ui:IsA("UIScale") and not TRANSIENT[ui.Name] then
					if ui.Scale > 0 then
						s = s * ui.Scale
					end
					if found then
						found[#found + 1] = ui
					end
				end
			end
		end
		cur = cur.Parent
	end
	return s
end
PixelIcon.RestScale = restScaleOf

local watched = setmetatable({}, { __mode = "k" }) -- [part] = { Fn = fn(s), S = the scale it was last sized for }
local hookedScales = setmetatable({}, { __mode = "k" }) -- [UIScale] = true once its Scale is watched
local passPending = false

local function applyWhole(part, entry, force)
	local found = {}
	local s = restScaleOf(part, found)
	for _, ui in ipairs(found) do
		if not hookedScales[ui] then
			hookedScales[ui] = true
			ui:GetPropertyChangedSignal("Scale"):Connect(function()
				if not passPending then
					passPending = true
					task.defer(function()
						passPending = false
						for p, e in pairs(watched) do
							if p.Parent then
								applyWhole(p, e, false)
							end
						end
					end)
				end
			end)
		end
	end
	if force or entry.S ~= s then
		entry.S = s
		entry.Fn(s)
	end
end

-- runs fn(s) now (s = the rest scale above `part`) and again whenever that scale changes: `part` moved under another
-- window, or a Fit / ViewportScale above it set to a new value. One watcher per part (a second call replaces fn)
function PixelIcon.Whole(part, fn)
	local entry = watched[part]
	if entry then
		entry.Fn = fn
		applyWhole(part, entry, true)
		return
	end
	entry = { Fn = fn, S = nil }
	watched[part] = entry
	applyWhole(part, entry, true)
	part.AncestryChanged:Connect(function()
		if part.Parent then
			applyWhole(part, entry, false)
		end
	end)
end

-- a stroke `n` design px thick (attribute DesignPx), drawn a whole number of screen px. Call again to change n; a
-- thickness its owner sets later (a selected card's thicker edge) is taken as the new design px and snapped too
local followed = setmetatable({}, { __mode = "k" }) -- [stroke or lip] = the value this module set last
function PixelIcon.WholeStroke(stroke, n)
	stroke:SetAttribute("DesignPx", tonumber(n) or stroke.Thickness)
	local first = followed[stroke] == nil
	followed[stroke] = -1
	PixelIcon.Whole(stroke, function(s)
		local px = PixelIcon.Px(stroke:GetAttribute("DesignPx") or 0, s)
		followed[stroke] = px
		stroke.Thickness = px
	end)
	if first then
		stroke:GetPropertyChangedSignal("Thickness"):Connect(function()
			if math.abs(stroke.Thickness - (followed[stroke] or -1)) > 1e-4 then
				PixelIcon.WholeStroke(stroke, stroke.Thickness)
			end
		end)
	end
	return stroke
end

-- a bar along an edge (a lip) `n` design px tall (attribute DesignPx; its width and position are the caller's), drawn a
-- whole number of screen px tall. Call again to change n; a height its owner sets later (a press thins the lip) is taken
-- as the new design px
function PixelIcon.WholeHeight(obj, n)
	obj:SetAttribute("DesignPx", tonumber(n) or obj.Size.Y.Offset)
	local first = followed[obj] == nil
	followed[obj] = -1
	PixelIcon.Whole(obj, function(s)
		local size = obj.Size
		local px = PixelIcon.Px(obj:GetAttribute("DesignPx") or 0, s)
		followed[obj] = px
		obj.Size = UDim2.new(size.X.Scale, size.X.Offset, size.Y.Scale, px)
	end)
	if first then
		obj:GetPropertyChangedSignal("Size"):Connect(function()
			local y = obj.Size.Y
			if y.Scale == 0 and math.abs(y.Offset - (followed[obj] or -1)) > 1e-4 then
				PixelIcon.WholeHeight(obj, y.Offset)
			end
		end)
	end
	return obj
end

-- (LOOK-ui) every kit edge (a Border UIStroke) and every kit lip (a Frame "Lip" of a fixed height) under `root`, now and
-- whenever one is added later, drawn on whole screen px (WholeStroke / WholeHeight). For a window's or the HUD's whole
-- gui, so a card built later (a list row, a pet card) stays on the grid without each builder asking. Once per root.
-- (LOOK-ui: border leaks) and no GuiObject there keeps Roblox's default 1 px dark border (BorderSizePixel 1 on a new
-- Frame / TextLabel: it showed round the Pets busy marks, the Shop's header icon, the BEST VALUE tag): kit B draws its
-- edges with strokes only
local treed = setmetatable({}, { __mode = "k" })
local function adopt(d)
	if d:IsA("GuiObject") and d.BorderSizePixel ~= 0 then
		d.BorderSizePixel = 0
	end
	if followed[d] ~= nil then
		return
	end
	if d:IsA("UIStroke") then
		if d.ApplyStrokeMode == Enum.ApplyStrokeMode.Border and d.Thickness > 0 then
			PixelIcon.WholeStroke(d, d.Thickness)
		end
	elseif d:IsA("Frame") and d.Name == "Lip" then
		local y = d.Size.Y
		if y.Scale == 0 and y.Offset > 0 then
			PixelIcon.WholeHeight(d, y.Offset)
		end
	end
end
function PixelIcon.WholeTree(root)
	if not root or treed[root] then
		return
	end
	treed[root] = true
	for _, d in ipairs(root:GetDescendants()) do
		adopt(d)
	end
	root.DescendantAdded:Connect(function(d)
		if d:IsA("GuiObject") and d.BorderSizePixel ~= 0 then
			d.BorderSizePixel = 0
		end
		if d:IsA("UIStroke") or (d:IsA("Frame") and d.Name == "Lip") then
			-- its builder names and sizes it right after parenting it: look once that is done
			task.defer(function()
				if d.Parent then
					adopt(d)
				end
			end)
		end
	end)
end

-- a face inset `e` design px from every side of its parent (`extra` px more off its height: the lip it leaves showing
-- under it), both whole screen px (attributes InsetPx, InsetExtra). Call again to change them (a plank's press)
function PixelIcon.WholeInset(face, e, extra)
	face:SetAttribute("InsetPx", tonumber(e) or 0)
	face:SetAttribute("InsetExtra", tonumber(extra) or 0)
	PixelIcon.Whole(face, function(s)
		local px = PixelIcon.Px(face:GetAttribute("InsetPx") or 0, s)
		local more = PixelIcon.Px(face:GetAttribute("InsetExtra") or 0, s)
		face.Position = UDim2.fromOffset(px, px)
		face.Size = UDim2.new(1, -2 * px, 1, -(2 * px + more))
	end)
	return face
end


-- (U9-7 look) the cells on whole SCREEN pixels under a window's or a HUD's UIScale. A dock at 0.8 drew a 27 px icon's 3 px
-- cells 2.4 px wide (Roblox rounds each Frame's edges to the pixel, so the columns came out 2 and 3 px: uneven) and an
-- 18 px icon's 1.6 px wide. A cell is now round(cell x scale) screen px (a half rounds down, never under 2 for a 2+ px
-- cell; at 0.7 - 0.8 both sizes draw 2 px cells: one pixel size on a phone), centred in the icon's box, which keeps its
-- design size (the layout is unchanged; PixelIcon.Lead keeps its gap to the text past what draws outside the box).
-- The short tweens on top (a press, a pop, a pulse) are not counted. Fitted when the icon is parented under a ScreenGui
-- (here, or when it or an ancestor moves there) and again when one of the UIScales above it changes. At scale 1 the
-- cells are exactly the old ones. Attribute CellPx = the screen px of a cell
local TWEEN_SCALES = { Pop = true, PopScale = true, FxScale = true, Punch = true, Pulse = true, Swell = true, Bounce = true }
local scaleSets = setmetatable({}, { __mode = "k" }) -- [UIScale] = { [icon] = true } (weak both ways)
local scaleConns = setmetatable({}, { __mode = "k" })

-- the product of the layout UIScales on `obj` and above it, the list of them, and whether it reached a ScreenGui
local function layoutScale(obj)
	local s, scales = 1, {}
	local cur = obj
	while cur do
		if cur:IsA("LayerCollector") then
			return s, scales, true
		end
		if cur:IsA("GuiObject") then
			local ui = cur:FindFirstChildOfClass("UIScale")
			if ui and ui.Scale > 0 and not TWEEN_SCALES[ui.Name] then
				s = s * ui.Scale
				scales[#scales + 1] = ui
			end
		end
		cur = cur.Parent
	end
	return s, scales, false
end

-- the screen px of a cell of `cell` design px under scale s: the nearest whole px (a half rounds up, as PixelIcon.Px and
-- PixelCrisp.Px: one rounding for every cell of a screen), and never under
-- 2 for a cell of 2 or more, so an 18 px icon stays legible and every icon of a phone screen (0.7 - 0.8) draws 2 px cells
local function screenCellOf(cell, s)
	return math.max(1, math.min(cell, 2), math.floor(cell * s + 0.5))
end

-- design px an icon of px draws past each side of its box under scale s (0 when it draws inside it)
local function overflowOf(px, s)
	local sc = screenCellOf(math.floor(px / 9), s)
	return math.max(0, (9 * sc / s - px) / 2)
end

local fitCells
local function watchScale(scale)
	if scaleConns[scale] then
		return scaleSets[scale]
	end
	local set = setmetatable({}, { __mode = "k" })
	scaleSets[scale] = set
	scaleConns[scale] = scale:GetPropertyChangedSignal("Scale"):Connect(function()
		for icon in pairs(set) do
			if icon.Parent then
				fitCells(icon)
			end
		end
	end)
	return set
end

fitCells = function(icon)
	if icon:GetAttribute("Sheet") then
		-- (Pitch 2 item 9 B) the sheet's art: 18 cells of px / 18, each a whole number of screen px (as below), centred.
		-- (P2 icons review r1, major 1) a FromSheet drawing: Grid cells (9) of px / Grid, its ArtW x ArtH cut
		local art = icon:FindFirstChild("Art")
		local s, scales, rooted = layoutScale(icon)
		if not (art and rooted) then
			return
		end
		local grid = icon:GetAttribute("Grid") or 18
		local px = icon.Size.X.Offset
		local screenCell = screenCellOf(math.floor(px / grid), s)
		local dc = screenCell / s
		local pad = math.floor((px * s - grid * screenCell) / 2) / s
		art.Position = UDim2.fromOffset(pad, pad)
		art.Size = UDim2.fromOffset((icon:GetAttribute("ArtW") or 19) * dc, (icon:GetAttribute("ArtH") or 19) * dc)
		icon:SetAttribute("CellPx", screenCell)
		for _, scale in ipairs(scales) do
			watchScale(scale)[icon] = true
		end
		return
	end
	local name = icon:GetAttribute("PixelIcon")
	local rects = (icon:GetAttribute("Key") and PixelIcon.KeyRuns(name)) or (icon:GetAttribute("Own") and PixelIcon.ArtRuns(name)) or PixelIcon.Runs(name)
	if not rects then
		return
	end
	-- (merge kitb-look1 x U9-9) from the icon itself: its own UIScale scales its cells too (PixelCrisp's "Crisp" on an
	-- icon it adopted; counted from above only, the cells were fitted twice and drew 2.5 px)
	local s, scales, rooted = layoutScale(icon)
	if not rooted then
		return
	end
	local px = icon.Size.X.Offset
	local cell = math.floor(px / 9)
	local screenCell = screenCellOf(cell, s)
	local dc = screenCell / s
	local pad = math.floor((px * s - 9 * screenCell) / 2) / s
	for i, r in ipairs(rects) do
		local f = icon:FindFirstChild("R" .. i)
		if f then
			f.Position = UDim2.fromOffset(pad + r[1] * dc, pad + r[2] * dc)
			f.Size = UDim2.fromOffset(r[3] * dc, r[4] * dc)
		end
	end
	icon:SetAttribute("CellPx", screenCell)
	for _, scale in ipairs(scales) do
		watchScale(scale)[icon] = true
	end
end

-- (merge kitb-look1 x U9-9) fits `root` and everything under it again now: every whole-px part (Whole) and every icon
-- (New). For a UIScale this module did not watch yet: client/UI/PixelCrisp's "Crisp" correction added on a Lead box
-- after Lead sized it (the box then drew its 2 px cells 2.5 px wide). From then on the new scale is watched
function PixelIcon.Refit(root)
	if not root then
		return
	end
	local list = root:GetDescendants()
	table.insert(list, 1, root)
	for _, d in ipairs(list) do
		local entry = watched[d]
		if entry and d.Parent then
			applyWhole(d, entry, false)
		end
		if d:GetAttribute("PixelIcon") and d:GetAttribute("Cell") then
			fitCells(d)
		end
	end
end

-- (U9-7 look) fits an icon made by PixelIcon.New to the UIScales above it now (New and a move do it by themselves)
function PixelIcon.Fit(icon)
	if icon and icon:GetAttribute("PixelIcon") then
		fitCells(icon)
	end
end

-- (kit-b prep, the leak hunt) while frozen (PixelIcon.SetFrozen, below), New, Host and Lead connect nothing
local frozen = false

-- draws icon `name` at px x px in `colour` into `parent`; nil for an unknown name. (Pitch 2 item 9 B) colour =
-- PixelIcon.Own: an Art icon in its own colours (an art size from the uploaded sheet once it has an id). (P2 icons review
-- r1) `key` (a Color3, own colours only): the glyph in a 1-cell keyline ring of it, no drop shadow (a dark plate: the
-- top bar), attribute Key; always the 9 x 9 Frames
function PixelIcon.New(parent, name, px, colour, key)
	local own = colour == PixelIcon.Own and PixelIcon.Art[name] ~= nil
	if colour == PixelIcon.Own and not own then
		colour = nil -- a one-ink glyph has no colours of its own: white, as with no colour
	end
	if typeof(key) ~= "Color3" then
		key = nil -- (P2 icons look fin0) a one-ink glyph takes a keyline too (KeyRuns)
	end
	local rects = (key and PixelIcon.KeyRuns(name)) or (own and PixelIcon.ArtRuns(name)) or PixelIcon.Runs(name)
	if not rects then
		return nil
	end
	px = math.max(9, math.floor(tonumber(px) or 18)) -- under 9 px a cell would be under a pixel: one px a cell
	if px % 9 ~= 0 and not PixelIcon.Warned[px] then
		PixelIcon.Warned[px] = 1
		warn("[PixelIcon] " .. px .. " px is not a multiple of 9: the cells draw at " .. (9 * math.floor(px / 9)) .. " px in a padded box")
	end
	local cell = math.floor(px / 9)
	local icon = Instance.new("Frame")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Size = UDim2.fromOffset(px, px)
	icon:SetAttribute("PixelIcon", name)
	icon:SetAttribute("Cell", cell)
	if own then
		icon:SetAttribute("Own", true)
	end
	if key then
		icon:SetAttribute("Key", true)
	end
	local sheetCell = own and not key and sheetCellFor(name, px)
	if sheetCell then
		-- (Pitch 2 item 9 B) the 18 x 18 art cut from the uploaded sheet: one ImageLabel, never a blurry scale
		icon:SetAttribute("Sheet", true)
		local dc = math.floor(px / 18)
		local pad = math.floor((px - 18 * dc) / 2)
		local art = Instance.new("ImageLabel")
		art.Name = "Art"
		art.BackgroundTransparency = 1
		art.BorderSizePixel = 0
		art.Image = sheetImage(sheetId())
		art.ImageRectOffset = Vector2.new(sheetCell[1], sheetCell[2])
		art.ImageRectSize = Vector2.new(PixelIcon.SheetCells.Art or 19, PixelIcon.SheetCells.Art or 19)
		art.ResampleMode = Enum.ResamplerMode.Pixelated
		art.ScaleType = Enum.ScaleType.Stretch
		art.Position = UDim2.fromOffset(pad, pad)
		art.Size = UDim2.fromOffset(19 * dc, 19 * dc)
		art.Parent = icon
		icon.Parent = parent
		fitCells(icon)
		if not frozen then
			icon.AncestryChanged:Connect(function()
				fitCells(icon)
			end)
		end
		return icon
	end
	local cells = {}
	for i, r in ipairs(rects) do
		local f = Instance.new("Frame")
		f.Name = "R" .. i
		f.BorderSizePixel = 0
		f.BackgroundTransparency = 0
		if key and r[5] == "@" then
			f.BackgroundColor3 = key
			f:SetAttribute("Ring", true) -- (a one-ink glyph's caller re-inks the glyph, never its ring: Host, Tint)
		elseif own then
			f.BackgroundColor3 = artColour(name, r[5])
			if r[5] == "~" then
				f.BackgroundTransparency = DROP_T
				f:SetAttribute("BaseT", DROP_T)
			end
		else
			f.BackgroundColor3 = colour or Color3.new(1, 1, 1)
		end
		f.Parent = icon
		cells[i] = f
	end
	local function lay(s)
		local dc = (math.abs(s - 1) < 1e-4) and cell or PixelIcon.Px(cell, s)
		-- the cells centred in the box, their origin on a whole screen px of the box
		local pad = math.floor((px - 9 * dc) / 2 * s + 1e-6) / s
		for i, r in ipairs(rects) do
			cells[i].Position = UDim2.fromOffset(pad + r[1] * dc, pad + r[2] * dc)
			cells[i].Size = UDim2.fromOffset(r[3] * dc, r[4] * dc)
		end
	end
	icon.Parent = parent
	-- (merge kitb-look1 x kitb-ui2) the design layout first (lay at scale 1), then fitCells puts the cells on whole
	-- screen px under the UIScales above (U9-7 look), now and whenever it lands under a ScreenGui
	lay(1)
	-- (U9-7 look) whole screen pixels under the UIScales above it, now and whenever it lands under a ScreenGui
	fitCells(icon)
	-- (kit-b gate U9 r4, the leak) a frozen build (a cached template that is only ever cloned: SetFrozen below) gets no
	-- follow listener here either; Host and Lead already skipped theirs, but this one sat on every template icon
	if not frozen then
		icon.AncestryChanged:Connect(function()
			fitCells(icon)
		end)
	end
	return icon
end

-- (P2 icons review r1, major 1: the odds chips under the pixel machines drew a smooth vector egg) a 9 x 9 drawing cut from
-- an uploaded sheet other than the icon sheet (item 10's odds chip eggs, the machines sheet's egg row): icon `name` at px
-- x px, ONE ImageLabel "Art" of image id `image` cut by `rect` { x, y, w, h } (the 9 x 9 cells + the drop shadow: 10 x
-- 10), ResampleMode Pixelated, px / 9 a cell on whole screen px under the UIScales above it (as New's). Attributes as
-- New's sheet icons (PixelIcon, Cell, Own, Sheet, CellPx) + Grid 9. nil without a whole image id above 0 or a rect
function PixelIcon.FromSheet(parent, name, px, image, rect)
	image = tonumber(image) or 0
	if not (image > 0 and image == math.floor(image) and type(rect) == "table" and tonumber(rect[3]) and tonumber(rect[4])) then
		return nil
	end
	px = math.max(9, math.floor(tonumber(px) or 18))
	local icon = Instance.new("Frame")
	icon.Name = "Icon"
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Size = UDim2.fromOffset(px, px)
	icon:SetAttribute("PixelIcon", name)
	icon:SetAttribute("Cell", math.floor(px / 9))
	icon:SetAttribute("Own", true)
	icon:SetAttribute("Sheet", true)
	icon:SetAttribute("Grid", 9)
	icon:SetAttribute("ArtW", rect[3])
	icon:SetAttribute("ArtH", rect[4])
	local dc = math.floor(px / 9)
	local pad = math.floor((px - 9 * dc) / 2)
	local art = Instance.new("ImageLabel")
	art.Name = "Art"
	art.BackgroundTransparency = 1
	art.BorderSizePixel = 0
	art.Image = sheetImage(image)
	art.ImageRectOffset = Vector2.new(rect[1], rect[2])
	art.ImageRectSize = Vector2.new(rect[3], rect[4])
	art.ResampleMode = Enum.ResamplerMode.Pixelated
	art.ScaleType = Enum.ScaleType.Stretch
	art.Position = UDim2.fromOffset(pad, pad)
	art.Size = UDim2.fromOffset(rect[3] * dc, rect[4] * dc)
	art.Parent = icon
	icon.Parent = parent
	fitCells(icon)
	if not frozen then
		icon.AncestryChanged:Connect(function()
			fitCells(icon)
		end)
	end
	return icon
end

-- (P2 icons review r1, major 2) the icon sheet's image id (Config.IconSheet.Id), 0 while nothing is uploaded: a caller
-- that caches its drawn art keys it with this, so the art redraws when a sheet is set (render_gui --sheets, the tests)
PixelIcon.SheetId = function()
	return sheetId()
end

-- (LOOK-ui, kitb-look1: the host from the snapped icon, not the icon from the host) the design px a box needs round icon
-- `px` with `margin` screen px of face on each side, under rest scale s: 9 whole-px cells plus the margins (22 screen px
-- for a 2 px cell, 31 for 3), back in design px. A box sized from its host (a 16 px chip at 0.8 under an 18 px icon) let
-- the icon hang over its edge
function PixelIcon.BoxPx(px, margin, s)
	s = (tonumber(s) or 1) > 0 and s or 1
	local cell = math.floor(math.max(9, tonumber(px) or 18) / 9)
	return (9 * screenCellOf(cell, s) + 2 * (tonumber(margin) or 2)) / s -- (merge) the cell rule of fitCells (New)
end

-- (LOOK-ui) icon `name` at px (its cell size) in `chip`, a square the caller places: the chip is sized from the icon's
-- whole-px cells (PixelIcon.BoxPx: `margin` screen px of face round them, default 2) and the cells start `margin` px in,
-- again whenever the rest scale above changes. Returns the icon (nil for an unknown name)
function PixelIcon.Chip(chip, name, px, colour, margin)
	px = math.max(9, math.floor(tonumber(px) or 18))
	margin = tonumber(margin) or 2
	local icon = PixelIcon.New(chip, name, px, colour)
	if not icon then
		return nil
	end
	local cell = math.floor(px / 9)
	PixelIcon.Whole(chip, function(s)
		local sc = screenCellOf(cell, s)
		local side = PixelIcon.BoxPx(px, margin, s)
		chip.Size = UDim2.fromOffset(side, side)
		-- New centres its cells in the px box with this inset (fitCells; negative when they overflow it): undo it,
		-- then the margin
		local pad = math.floor((px * s - 9 * sc) / 2) / s
		icon.AnchorPoint = Vector2.new(0, 0)
		icon.Position = UDim2.fromOffset(margin / s - pad, margin / s - pad)
	end)
	chip:SetAttribute("IconChip", name)
	return icon
end

-- recolours an icon made by PixelIcon.New (an own-colour glyph: every cell but its drop shadow, in one ink)
function PixelIcon.Tint(icon, colour)
	for _, f in ipairs(icon and icon:GetChildren() or {}) do
		if f:IsA("Frame") and not f:GetAttribute("BaseT") and not f:GetAttribute("Ring") then
			f.BackgroundColor3 = colour
		end
	end
end

-- (Pitch 2 item 9 B) the disabled state of an own-colour icon: on, the sheet's greyed row (an ImageLabel icon) or every
-- cell's grey twin (the 9 x 9 glyph; the drop shadow stays); off, its colours again. Attribute Grey. A one-ink icon is
-- left as it is (its caller tints it)
function PixelIcon.Grey(icon, on)
	if not icon then
		return
	end
	on = on == true
	local name = icon:GetAttribute("PixelIcon")
	if icon:GetAttribute("Sheet") then
		local art, c = icon:FindFirstChild("Art"), PixelIcon.SheetCells[name]
		if art and type(c) == "table" then
			art.ImageRectOffset = Vector2.new(c[1], c[2] + (on and (PixelIcon.SheetCells.GreyY or 0) or 0))
		end
	elseif icon:GetAttribute("Own") then
		local list = icon:GetAttribute("Key") and PixelIcon.KeyRuns(name) or PixelIcon.ArtRuns(name)
		for i, r in ipairs(list or {}) do
			local f = icon:FindFirstChild("R" .. i)
			if f and r[5] ~= "~" and r[5] ~= "@" then
				local c = artColour(name, r[5])
				f.BackgroundColor3 = on and greyOf(c) or c
			end
		end
	else
		return
	end
	icon:SetAttribute("Grey", on)
end

-- (U7a) the multiple of 9 nearest to px (at least 9): the size an icon standing in for a glyph of px draws at
function PixelIcon.Snap(px)
	return math.max(9, math.floor((tonumber(px) or 18) / 9 + 0.5) * 9)
end

-- (U7a) icon `name` of about px px centred in `host` (a text object): it takes the host's TextColor3 (unless `colour` is
-- given), TextTransparency and ZIndex and follows later changes to them, so a caller that tints, fades or layers the text
-- moves the icon with it. px nil: the icon is 0.9 x the host's TextSize and is redrawn when that changes (a glyph label
-- a layout resizes). Returns the icon Frame (attribute PixelIcon = name; a redraw replaces it); nil for an unknown name.
-- Hosting again on the same host drops the old icon and its connections first (a mark that changes, a coin resized).
local hosted = setmetatable({}, { __mode = "k" }) -- [host] = { icon = Frame, conns = { connections } }
local scaleOf -- (below, with Lead: the UIScales over an object)

-- (U9-4 look review 2: whole pixels) the host's padded box in its own px: its laid-out AbsoluteSize (a grid cell or an
-- aspect constraint can size it other than its Size), else, before its first layout, its Size where that is a fixed
-- offset; nil for a scaled host not laid out yet. A UIPadding insets the icon as it insets the text
local function hostBox(host)
	local size = host.Size
	local w, h = nil, nil
	local a, s = host.AbsoluteSize, scaleOf(host)
	if a.X > 0 and a.Y > 0 and s > 0 then
		w, h = math.floor(a.X / s + 0.5), math.floor(a.Y / s + 0.5)
	elseif size.X.Scale == 0 and size.Y.Scale == 0 and host.AutomaticSize == Enum.AutomaticSize.None then
		w, h = size.X.Offset, size.Y.Offset
	end
	if not w then
		return nil
	end
	local pad = host:FindFirstChildOfClass("UIPadding")
	if pad then
		w = w - pad.PaddingLeft.Offset - pad.PaddingRight.Offset - (pad.PaddingLeft.Scale + pad.PaddingRight.Scale) * w
		h = h - pad.PaddingTop.Offset - pad.PaddingBottom.Offset - (pad.PaddingTop.Scale + pad.PaddingBottom.Scale) * h
	end
	return w, h
end

-- the icon centred in its host by a whole-px offset (an AnchorPoint of 0.5 put it on a half pixel wherever the host and
-- the icon differ by an odd number of px); before a scaled host's first layout, centred by scale
local function centreIn(icon, host)
	local w, h = hostBox(host)
	local px = icon.Size.X.Offset
	if w then
		icon.AnchorPoint = Vector2.new(0, 0)
		icon.Position = UDim2.fromOffset(math.floor((w - px) / 2), math.floor((h - px) / 2))
	else
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
	end
end

-- (kit-b prep, the leak hunt) while frozen, Host and Lead draw and place the icon once and connect nothing: for a tree
-- that is only ever cloned (HomeBuilder's cached station templates; Clone copies no connections), where a follow
-- listener would only sit on the template for the server's life. SetFrozen(on) -> the previous setting
function PixelIcon.SetFrozen(on)
	local was = frozen
	frozen = on == true
	return was
end

function PixelIcon.Host(host, name, px, colour)
	local old = hosted[host]
	if old then
		hosted[host] = nil
		for _, c in ipairs(old.conns) do
			c:Disconnect()
		end
		if old.icon then
			old.icon:Destroy()
		end
	end
	if not PixelIcon.Bitmaps[name] then
		return nil
	end
	local entry = { icon = nil, conns = {} }
	hosted[host] = entry
	local icon = nil
	-- (Pitch 2 item 9 B) no colour given and the icon has its own: it keeps them (the text's colour does not tint it)
	local own = colour == nil and PixelIcon.Art[name] ~= nil
	local function sync()
		if not icon then
			return
		end
		icon.ZIndex = host.ZIndex
		for _, f in ipairs(icon:GetChildren()) do
			if f:IsA("Frame") then
				if not own and not f:GetAttribute("Ring") then
					f.BackgroundColor3 = colour or host.TextColor3
				end
				f.BackgroundTransparency = composeT(f, host.TextTransparency)
				f.ZIndex = host.ZIndex
			elseif f:IsA("ImageLabel") then
				f.ImageTransparency = host.TextTransparency
				f.ZIndex = host.ZIndex
			end
		end
	end
	local function draw()
		if icon then
			icon:Destroy()
		end
		-- (P2 icons review r1, major 7) a host's IconKey attribute (a Color3: the top bar's pill buttons) draws its own-colour
		-- icon in that keyline; (P2 icons look fin0) a one-ink one too (the Daily's claimed tick)
		local key = host:GetAttribute("IconKey")
		icon = PixelIcon.New(host, name, PixelIcon.Snap(px or (tonumber(host.TextSize) or 18) * 0.9), own and PixelIcon.Own or (colour or host.TextColor3), key)
		centreIn(icon, host)
		entry.icon = icon
		sync()
	end
	local function recentre()
		if icon then
			centreIn(icon, host)
		end
	end
	draw()
	if frozen then
		return icon
	end
	local conns = entry.conns
	conns[#conns + 1] = host:GetPropertyChangedSignal("TextColor3"):Connect(sync)
	conns[#conns + 1] = host:GetPropertyChangedSignal("TextTransparency"):Connect(sync)
	conns[#conns + 1] = host:GetPropertyChangedSignal("ZIndex"):Connect(sync)
	-- (U9-4 look review 2) a resized host keeps its icon on whole px
	conns[#conns + 1] = host:GetPropertyChangedSignal("Size"):Connect(recentre)
	conns[#conns + 1] = host:GetPropertyChangedSignal("AbsoluteSize"):Connect(recentre)
	if px == nil then
		conns[#conns + 1] = host:GetPropertyChangedSignal("TextSize"):Connect(function()
			if icon and icon.Size.X.Offset ~= PixelIcon.Snap((tonumber(host.TextSize) or 18) * 0.9) then
				draw()
			end
		end)
	end
	return icon
end

local leadConns = setmetatable({}, { __mode = "k" }) -- [label] = { [childName] = { connections } } (a re-call drops the old)

-- (U7a review) the product of the UIScales on `obj` and every GuiObject above it, up to its ScreenGui: Roblox's
-- TextBounds is screen px (after all of them), a Position offset is the object's own px. A HUD panel's ScreenFactor
-- (0.8 on a phone, up to 1.25) and a token pop (about 1.7) are among them
function scaleOf(obj)
	local s = 1
	local cur = obj
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") then
			local ui = cur:FindFirstChildOfClass("UIScale")
			if ui and ui.Scale > 0 then
				s = s * ui.Scale
			end
		end
		cur = cur.Parent
	end
	return s
end

-- (U7b review) the width of a label's text in its own px, for when TextBounds has none: Theme.MeasureLabel (TextService
-- with the label's font; a Nunito face, whose .Font reads Unknown, on its role's Enum font with the role's spare
-- widening, so it runs wide, never short). A Roblox server lays out no text (TextBounds reads 0 there), and the world
-- signs Lead on the server, where the icon's place is set once (no client places it again). Theme is required here, on
-- first use, not at load: PixelIcon loads without it (the loading screen draws icons before Theme arrives)
local function measuredWidth(label)
	local text = tostring(label.Text or "")
	if text == "" then
		return 0
	end
	local ok, v = pcall(function()
		local Theme = require(script.Parent.Theme)
		return Theme.MeasureLabel(label)
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return math.ceil(v.X)
	end
	return math.ceil(#text * (tonumber(label.TextSize) or 14) * 0.6)
end

function PixelIcon.Lead(label, name, opts)
	opts = opts or {}
	if not PixelIcon.Bitmaps[name] then
		return nil
	end
	local after = opts.After == true
	local childName = opts.Name or (after and "TrailIcon" or "LeadIcon")
	local old = label:FindFirstChild(childName)
	if old then
		old:Destroy()
	end
	leadConns[label] = leadConns[label] or {}
	for _, c in ipairs(leadConns[label][childName] or {}) do
		c:Disconnect()
	end
	local px = PixelIcon.Snap(opts.Px or (tonumber(label.TextSize) or 18) * 0.9)
	local cell = math.floor(px / 9)
	local count = math.max(0, math.floor(tonumber(opts.Count) or 1))
	local of = math.max(count, math.floor(tonumber(opts.Of) or count), 1)
	-- (LOOK-ui, kitb-look1: the box from the snapped icon, not the icon from the box) under a 0.8 Fit a 2 px cell draws 2
	-- screen px (2.5 design), so an 18 px icon spans 22.5 design px: a box of 18 let it run into the label ("+Put in team",
	-- 0 px apart). The box is 9 whole-px cells wide per icon and the gap a whole 6 screen px (opts.Gap: design px, snapped),
	-- both again whenever the rest scale changes (metrics)
	local w, iconW, dc = of * px + (of - 1) * cell, px, cell
	local gap = tonumber(opts.Gap) or 6 -- (U7b) opts.Gap: px between the text and the icons
	local pad = label:FindFirstChildOfClass("UIPadding")
	if not pad then
		pad = Instance.new("UIPadding")
		pad.Parent = label
	end
	-- the label's own insets, read once (a second call measures from them, not from the first icon's)
	local baseL, baseR = label:GetAttribute("LeadInsetL"), label:GetAttribute("LeadInsetR")
	if baseL == nil then
		baseL, baseR = pad.PaddingLeft.Offset, pad.PaddingRight.Offset
		label:SetAttribute("LeadInsetL", baseL)
		label:SetAttribute("LeadInsetR", baseR)
	end
	local box = Instance.new("Frame")
	box.Name = childName
	box.BackgroundTransparency = 1
	box.BorderSizePixel = 0
	box.Size = UDim2.fromOffset(w, px)
	box:SetAttribute("PixelIcon", name)
	box:SetAttribute("IconCount", count)
	local icons = {}
	-- (Pitch 2 item 9 B) no opts.Colour and the icon has its own: it keeps them (the label's colour does not tint it)
	local own = opts.Colour == nil and PixelIcon.Art[name] ~= nil
	for i = 1, of do
		local icon = PixelIcon.New(box, name, px, own and PixelIcon.Own or (opts.Colour or label.TextColor3))
		icon.Position = UDim2.fromOffset((i - 1) * (px + cell), 0)
		icons[i] = icon
	end
	local gapPx = gap
	-- the box, the icons in it and the gap for rest scale s: each icon's cells from the box's left, a cell apart
	local function metrics(s)
		s = (s and s > 0) and s or 1
		dc = screenCellOf(cell, s) / s -- (merge) the cell New draws (fitCells)
		iconW = 9 * dc
		w = of * iconW + (of - 1) * dc
		gap = opts.Gap and PixelIcon.Px(gapPx, s) or (gapPx / s)
		box.Size = UDim2.fromOffset(w, iconW)
		-- New centres its cells in its px box (a negative inset when they overflow it): undone here
		local inset = math.floor((px - 9 * dc) / 2 * s + 1e-6) / s
		for i, icon in ipairs(icons) do
			icon.Position = UDim2.fromOffset((i - 1) * (iconW + dc) - inset, -inset)
		end
	end
	metrics(restScaleOf(label))
	local function sync()
		box.ZIndex = label.ZIndex
		for i, icon in ipairs(icons) do
			icon.ZIndex = label.ZIndex
			-- an unlit icon of a rating is the same colour at a third of its strength
			local t = label.TextTransparency
			if i > count then
				t = 1 - (1 - t) * 0.35
			end
			for _, f in ipairs(icon:GetChildren()) do
				if f:IsA("Frame") then
					if not own then
						f.BackgroundColor3 = opts.Colour or label.TextColor3
					end
					f.BackgroundTransparency = composeT(f, t)
					f.ZIndex = label.ZIndex
				elseif f:IsA("ImageLabel") then
					f.ImageTransparency = t
					f.ZIndex = label.ZIndex
				end
			end
		end
	end
	local align = label.TextXAlignment
	-- (U9-7 look) the icon a whole design px from the label's padded box: its height from a fixed Size or, laid out, from
	-- AbsoluteSize (the label's own px), so the top is floor((h - px) / 2) and a centred text's icon floor(w / 2 ...) (half
	-- of an odd height or width put an icon on a half pixel); before the first layout the 0.5 scales
	local function padded()
		local s = scaleOf(label)
		local a = label.AbsoluteSize
		local pw, ph = nil, nil
		if a.X > 0 and a.Y > 0 and s > 0 then
			pw = math.floor(a.X / s + 0.5) - pad.PaddingLeft.Offset - pad.PaddingRight.Offset
			ph = math.floor(a.Y / s + 0.5) - pad.PaddingTop.Offset - pad.PaddingBottom.Offset
		end
		local sy = label.Size.Y
		local auto = label.AutomaticSize == Enum.AutomaticSize.Y or label.AutomaticSize == Enum.AutomaticSize.XY
		if sy.Scale == 0 and sy.Offset > 0 and not auto then
			ph = sy.Offset - pad.PaddingTop.Offset - pad.PaddingBottom.Offset
		end
		return pw, ph
	end
	local function vertical(ph)
		-- (merge kitb-look1 x U9-9) a box PixelCrisp adopted (its own UIScale "Crisp" grows it round its AnchorPoint and
		-- snaps its origin) stays centred: from its top it grew down onto the block's lip
		if ph and not box:FindFirstChild("Crisp") then
			-- (LOOK-ui) the snapped icon's height, its top on a whole screen px of the padded box
			local s = restScaleOf(label)
			s = s > 0 and s or 1
			return 0, UDim.new(0, math.floor((ph - iconW) / 2 * s + 1e-6) / s)
		end
		return 0.5, UDim.new(0.5, 0)
	end
	-- a UIPadding insets the label's children as it insets the text, so the icon is placed in the same padded box as the
	-- letters: scale 0 / 0.5 / 1 are the text area's left edge, centre and right edge. TextBounds is screen px: back to
	-- the label's own px (a UIScale tween changes TextBounds, so a pop re-places it at the new scale). (U7b review) No
	-- bounds for a text that has letters (the server; a client before its first layout, which re-places on TextBounds):
	-- measured (measuredWidth)
	local function place()
		local textW = label.TextBounds.X / scaleOf(label)
		if textW <= 0 and label.Text ~= "" then
			textW = measuredWidth(label)
		end
		if opts.Room == true and after and align == Enum.TextXAlignment.Left then
			-- (render gate) a truncated text's bounds can run past its text area: the icons start at that area's end at most
			local okA, boxW = pcall(function()
				return label.AbsoluteSize.X / scaleOf(label)
			end)
			if okA and type(boxW) == "number" and boxW > 0 then
				textW = math.min(textW, boxW - pad.PaddingLeft.Offset - pad.PaddingRight.Offset)
			end
		end
		local rawW = textW
		textW = math.ceil(textW - 0.01) -- (U9-7 look) the icon a whole px from the text's measured end
		local pw, ph = padded()
		local ay, y = vertical(ph)
		box.AnchorPoint = Vector2.new(after and 0 or 1, ay)
		if align == Enum.TextXAlignment.Right then
			box.Position = after and UDim2.new(1, gap, y.Scale, y.Offset) or UDim2.new(1, -(textW + gap), y.Scale, y.Offset)
		elseif align == Enum.TextXAlignment.Center and label.Text == "" and not after then
			-- (U7b) icons alone on an empty centred label (a rating badge): centred in the label (the left inset moved the
			-- text area's centre right by half of w + gap)
			box.AnchorPoint = Vector2.new(0.5, ay)
			box.Position = UDim2.new(0.5, -math.floor((w + gap) / 2), y.Scale, y.Offset)
			if pw then
				box.AnchorPoint = Vector2.new(0, ay)
				box.Position = UDim2.new(0, math.floor(pw / 2 - (w + gap) / 2 - w / 2), y.Scale, y.Offset)
			end
		elseif align == Enum.TextXAlignment.Center then
			box.Position = UDim2.new(0.5, math.floor(after and (textW / 2 + gap) or -(textW / 2 + gap)), y.Scale, y.Offset)
			if pw then
				-- (LOOK-ui) the text's end snapped outward to a whole screen px, then the whole-px gap: never closer than it.
				-- (merge kitb-look1 x U9-7) whole px at REST: a window's entrance Pop (0.9 when it placed) left the icon
				-- 7.78 px from its label once the pop ended
				local s = restScaleOf(label)
				s = s > 0 and s or 1
				local edge = after and math.ceil((pw / 2 + rawW / 2) * s - 1e-6) / s or math.floor((pw / 2 - rawW / 2) * s + 1e-6) / s
				box.Position = UDim2.new(0, after and edge + gap or edge - gap, y.Scale, y.Offset)
			end
		else
			box.Position = after and UDim2.new(0, textW + gap, y.Scale, y.Offset) or UDim2.new(0, -gap, y.Scale, y.Offset)
		end
	end
	local function inset()
		if not after and align ~= Enum.TextXAlignment.Right then
			pad.PaddingLeft = UDim.new(pad.PaddingLeft.Scale, baseL + w + gap)
		elseif after and (align ~= Enum.TextXAlignment.Left or opts.Room == true) then
			pad.PaddingRight = UDim.new(pad.PaddingRight.Scale, baseR + w + gap)
		end
	end
	inset()
	sync()
	place()
	box.Parent = label
	if frozen then
		leadConns[label][childName] = nil
		return box
	end
	-- (LOOK-ui) a new rest scale (the window's Fit) sizes the box, the gap and the text's inset again
	PixelIcon.Whole(box, function(s)
		if box.Parent then
			metrics(s)
			inset()
			place()
		end
	end)
	leadConns[label][childName] = {
		label:GetPropertyChangedSignal("TextColor3"):Connect(sync),
		label:GetPropertyChangedSignal("TextTransparency"):Connect(sync),
		label:GetPropertyChangedSignal("ZIndex"):Connect(sync),
		label:GetPropertyChangedSignal("TextBounds"):Connect(place),
		label:GetPropertyChangedSignal("Text"):Connect(place),
		label:GetPropertyChangedSignal("Size"):Connect(place), -- (U9-7 look) a new height moves the icon's whole-px top
	}
	-- (U9-7 look) a laid-out size places the icon on whole px (padded()): every lead follows its label's AbsoluteSize
	table.insert(leadConns[label][childName], label:GetPropertyChangedSignal("AbsoluteSize"):Connect(place))
	return box
end

-- (U7b) a status line's mark set on every refresh: PixelIcon.Lead only when the mark (name, Count, Of) changed since the
-- last call (the label's attribute Mark_<child>), PixelIcon.Clear when name is nil. Cheap to call each frame
function PixelIcon.Mark(label, name, opts)
	opts = opts or {}
	local attr = "Mark_" .. (opts.Name or (opts.After == true and "TrailIcon" or "LeadIcon"))
	local key = name and (name .. ":" .. tostring(opts.Count or "") .. ":" .. tostring(opts.Of or "")) or ""
	if label:GetAttribute(attr) == key then
		return
	end
	label:SetAttribute(attr, key)
	if name then
		PixelIcon.Lead(label, name, opts)
	else
		PixelIcon.Clear(label, opts)
	end
end

-- (U7b) PixelIcon.Host only when the icon changed since the last call (the host's attribute HostMark); nil or an
-- unknown name drops the icon. For a glyph label a refresh rewrites (a ready tick, a lock badge that comes and goes)
function PixelIcon.Set(host, name, px, colour)
	local key = (name and PixelIcon.Bitmaps[name]) and (name .. ":" .. tostring(px or "")) or ""
	if host:GetAttribute("HostMark") == key then
		return
	end
	host:SetAttribute("HostMark", key)
	host.Text = ""
	PixelIcon.Host(host, key ~= "" and name or "", px, colour)
end

-- (U7b) takes the icon PixelIcon.Lead put on `label` off again (opts.After / opts.Name as given to Lead) and puts the
-- label's own insets back: a row whose mark comes and goes (a pet that stops training, a rating that drops to none)
function PixelIcon.Clear(label, opts)
	opts = opts or {}
	local after = opts.After == true
	local childName = opts.Name or (after and "TrailIcon" or "LeadIcon")
	local old = label:FindFirstChild(childName)
	if old then
		old:Destroy()
	end
	if leadConns[label] then
		for _, c in ipairs(leadConns[label][childName] or {}) do
			c:Disconnect()
		end
		leadConns[label][childName] = nil
	end
	local pad = label:FindFirstChildOfClass("UIPadding")
	local baseL, baseR = label:GetAttribute("LeadInsetL"), label:GetAttribute("LeadInsetR")
	if pad and baseL ~= nil then
		if after then
			pad.PaddingRight = UDim.new(pad.PaddingRight.Scale, baseR)
		else
			pad.PaddingLeft = UDim.new(pad.PaddingLeft.Scale, baseL)
		end
	end
end

return PixelIcon
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1064">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Remotes: one place that creates (server) / fetches (client) every RemoteEvent.
-- Remotes.Get("Notify") works on both sides. Names come from Config.Remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

local Remotes = {}

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("Remotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Remotes"
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("Remotes")
	end
	return folder
end

-- Server: call once at boot to create every remote before clients ask for them.
function Remotes.Init()
	assert(RunService:IsServer(), "Remotes.Init is server-only")
	local f = getFolder()
	for _, name in ipairs(Config.Remotes) do
		if not f:FindFirstChild(name) then
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = f
		end
	end
end

function Remotes.Get(name)
	local f = getFolder()
	if RunService:IsServer() then
		local remote = f:FindFirstChild(name)
		assert(remote, "Unknown remote (did you call Remotes.Init?): " .. tostring(name))
		return remote
	end
	return f:WaitForChild(name)
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1065">
        <Properties>
          <string name="Name">SignKit</string>
          <string name="Source"><![CDATA[-- SignKit: the Signboard parts of kit B (U2 of .superpowers/slop-audit/round3/BUILD_PLAN.md, findings 5 and 7; the owner's
-- approved pitch, kit_pitch_mockups.html "B. Cloud Shop Signboard"). One shared set of parts that the loading screen
-- (ReplicatedFirst: Shared only) and every window build from. Square blocks, no slice image: a part is Frames in the
-- Theme.Sign colours, an edge, a darker bottom lip and a face, never a glow, a gradient or a scale bounce.
--   SignKit.Roof(parent, opts)    the flat pink awning with its dark edge and darker lip: ONE fixed-size piece (offset
--                                 only, never stretched with the window; Gemini's rule), centred on the window's top.
--                                 opts.Shape = "Gable": the Credits window's gable (two slopes, fascia, vent)
--   SignKit.Header(parent, opts)  the navy sign plank in a wood rim, its title in FredokaOne gold (Title role, through
--                                 Theme.StyleTitle); returns head, plate (the caller adds a close X to the plate).
--                                 opts.Ribbon: the untabbed window's header (Pitch 2 F0 A: its plate inside the
--                                 rim, no tails; the title wears the gold V-notched ribbon on it).
--                                 (U9-4 look review, the one header rule) every untabbed window and side panel
--                                 (Pets, Index, Stats, My Home, Settings, What's New, the Sky Trove) uses this
--                                 header with Ribbon. A TABBED window (the Shop, the Gifts window) keeps its navy
--                                 band inside the frame instead: its tabs sit on the band, where the ribbon's piping
--                                 and tails would run under them. Both share the icon square (Sizes.IconSlot, a 2 px
--                                 ink edge), the gold ribbon title and the red close block
--   SignKit.Frame(parent, opts)   the wood frame under the header
--   SignKit.Body(frame, opts)     the stone body inside it, with the stone lip along its bottom
--   SignKit.Plank(parent, opts)   a button with a real bottom lip: hover lifts the block 2 px, press sinks it 4 px and the
--                                 lip shrinks to 2 px (U5: the pitch's .dn); the label shrinks to fit, then truncates;
--                                 Style Off is disabled; SignKit.PlankState(plank, "Rest" | "Hover" | "Press") sets one
--   SignKit.Rope(parent, opts)    a rope / post the board hangs from
--   SignKit.BlockRow(parent, opts) n stone blocks with a darker lip; SignKit.FillBlocks(row, k) turns the first k gold
--   SignKit.FitBlocks(parent, opts) (LOOK-ui) a BlockRow filling its own box (a bar's place): n blocks of one whole width
--   SignKit.ScrollBar(scroll, opts) (U9-7 look) a list's bar: the kit's thickness, the wood, square ends
--   SignKit.FitBlocks(parent, opts) (LOOK-ui) a BlockRow filling its own box (a bar's place): n blocks of one whole width
--   SignKit.Notice(parent, opts)  a small wood-framed stone card (a tip, a notice); returns notice, face
--   SignKit.Nails(board, opts)    (U9-7) two nail heads on a hanging board's top corners (the handmade touch)
--   SignKit.Scroll(sf, thickness) (LOOK-ui) the kit's one scroll bar on a ScrollingFrame: wood, opaque, square ends
--   SignKit.Rig(parts, opts)      (sign/logo build: the owner's pick B2 "Sky-climber's rig", 2026-11-13; it replaced the
--                                 Workshop trim) a hanging board's canopy (canvas under navy stripes, a scalloped
--                                 valance with brass piping, a stitched patch), the frame's bevel, rope lashings on its
--                                 corners, the canvas body's hem, twisted ropes ending in carabiners on eye-bolts, two
--                                 propellers, the brass version plate. Opt-in: only the title screen's and the loading
--                                 screen's boards call it (Credits stays as approved). SignKit.Spin(root, on) flips the
--                                 propellers (2 frames, never a rotation); SignKit.PropFrame(root, n) sets one
-- Every part stamps attribute SignKit = its kind. Sizes are design px of a 1080p screen (the pitch's 0.8-scale px / 0.8);
-- opts override any colour or size, so a look the owner already approved (Credits) builds from these parts unchanged.
-- (LOOK-ui, kitb-look1) every edge, inset and lip is a whole number of screen px under the window's scale (PixelIcon.Px /
-- PixelIcon.Whole): at a 0.8 Fit a 2 px edge draws 2 screen px, not 1.6.
-- Requires only Theme and PixelIcon (Shared; PixelIcon requires nothing at load). Plain Lua 5.1-compatible syntax only.

local Theme = require(script.Parent:WaitForChild("Theme"))
local PixelIcon = require(script.Parent:WaitForChild("PixelIcon"))

local SignKit = {}

local Sign = Theme.Sign

SignKit.Sizes = {
	RoofW = 320, -- the awning's default width (a window passes its own, still a fixed offset)
	RoofH = 18,
	RoofEdge = 4, -- the dark border round the awning
	RoofLip = 5, -- its darker bottom lip
	-- (U9-4 look review 2) a phone window's awning (the portrait Gifts window, the portrait Trove sheet): 240, so its right
	-- end keeps clear of the close block on a 390 px screen (the 288 of the 0.8 windows lay over it)
	RoofPhoneW = 240,
	HeadH = 64,
	Rim = 6, -- the header's wood rim (top, left, right; the frame below closes it): the frame's width, so the edge runs straight
	TitleX = 18,
	IconSlot = 42, -- the gold icon square in a header
	-- (U9-4 look review 2: one pixel size per screen) a window's pixel icons draw at one of two sizes, one double the other:
	-- Glyph (a header icon, a sparkle, a clock, a reward's coin) and Art (a reward's art on its chip, a tick, a row's
	-- icon): 3 / 6 px cells on PC (27 / 54 at 1080p), 2 / 4 px on a phone (18 / 36). The Gifts window and the Trove read it
	Pixel = { PC = { Glyph = 27, Art = 54 }, Phone = { Glyph = 18, Art = 36 } },
	Frame = 6, -- the wood frame round a body
	Edge = 5, -- a block's edge (planks, notices)
	Lip = 8, -- a block's darker bottom lip
	PlankH = 50,
	Hover = 2, -- hover lifts a plank this far
	Sink = 4, -- press sinks the whole plank this far (the pitch's .dn translateY 4px) ...
	PressLip = 2, -- ... and its lip shrinks to this (.dn lip 2px)
	LabelPad = 6, -- a plank label's room inside the face, each side
	NoticeGap = 18, -- a notice's icon square to its text
	RopeW = 6,
	ScrollBar = 8, -- (U9-7 look) a scrolling list's bar on kit B: this thick, in the wood, opaque (every window's lists)
	ScrollBarPhone = 6, -- (LOOK-ui) the same bar in a phone layout's list
	BlockW = 28,
	BlockH = 22,
	BlockGap = 4,
	BlockEdge = 2,
	BlockLip = 4,
	-- (kit-b gate U9 r4: one bar language, the owner's look bar "every bar in the same block-bar language") the only two
	-- weights a bar (SignKit.FitBlocks, opts.Weight) may take: Bar for every bar on a screen (HP, XP, stamina, cooldown,
	-- progress, timers) and Micro only for a world billboard (a pet's floating card) or a tiny team pip. Edge / Lip / Gap
	-- design px (a Bar's gap 2 or 3: GapMax); MinEdge / MinLip SCREEN px, so a phone window's 0.5 Fit keeps a 2 px wood
	-- edge like its planks (the Food Machine's rows drew 1 px hairline boxes)
	Bar = { Edge = 2, Lip = 3, Gap = 2, GapMax = 3, MinEdge = 2, MinLip = 2 },
	Micro = { Edge = 1, Lip = 1, Gap = 1, GapMax = 1, MinEdge = 1, MinLip = 1 },
	NoticeEdge = 4,
	NoticeLip = 4,
	-- (LOOK-ui, kitb-look1: the Pets, Index, Home, Stats and Shop closes drew 35 to 47 screen px with 2 or 3 px cells, by
	-- their window's Fit) one close block: never under CloseMin screen px square, its x in CloseCell screen px cells
	-- (NeonKit.CloseBlock)
	CloseMin = 44,
	CloseCell = 3,
}
local Z = SignKit.Sizes

-- plank looks: face, lip, edge, text (the pitch's .bt, .bt.pri, .bt.sel, .bt.dng, .bt.off and the navy sign)
SignKit.Styles = {
	Stone = { Face = Sign.Tile, Lip = Sign.StoneLip, Edge = Sign.Wood, Text = Sign.Text },
	Grass = { Face = Sign.Grass, Lip = Sign.GrassLip, Edge = Sign.Wood, Text = Sign.OnGrass },
	Gold = { Face = Sign.Gold, Lip = Sign.GoldLip, Edge = Sign.Wood, Text = Sign.Text },
	Red = { Face = Sign.Red, Lip = Sign.RedLip, Edge = Sign.Wood, Text = Color3.new(1, 1, 1) },
	Navy = { Face = Sign.Navy, Lip = Sign.NavyLip, Edge = Sign.GoldLip, Text = Sign.Gold }, -- the pitch's sign edge (--signEdge)
	Off = { Face = Sign.Well, Lip = Sign.Well, Edge = Sign.WellEdge, Text = Sign.TextMuted, Off = true },
	-- (U9-8 look) a small secondary action in a row (the Sky Obby picker's PICK): the sky face on its SkyLip lip
	Sky = { Face = Sign.Sky, Lip = Sign.SkyLip, Edge = Sign.Wood, Text = Sign.Text },
}

local function frame(name, props, parent)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for key, value in pairs(props or {}) do
		f[key] = value
	end
	f.Parent = parent
	return f
end

local function fill(name, colour, props, parent)
	props = props or {}
	props.BackgroundTransparency = 0
	props.BackgroundColor3 = colour
	return frame(name, props, parent)
end

local function round(parent)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = parent
	return c
end

local function line(parent, colour, thickness)
	local s = Instance.new("UIStroke")
	s.Color = colour
	s.Thickness = thickness
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.LineJoinMode = Enum.LineJoinMode.Miter
	s.Parent = parent
	-- (U9-8 look; LOOK-ui) a whole number of screen px under the scale above it (SignKit.Whole, below: it counts every
	-- layout UIScale, so the Credits board under its own scale keeps the approved tree)
	SignKit.Whole(s, function(sc)
		s.Thickness = SignKit.Px(thickness, sc)
	end)
	return s
end

-- (LOOK-ui) a lip `n` design px tall along its parent's bottom, and a face inset `e` px from its parent's sides (`extra`
-- px more off its height: the lip it leaves showing), both whole screen px under the window's scale
local function lipOf(lip, n)
	return PixelIcon.WholeHeight(lip, n)
end
local function inset(face, e, extra)
	return PixelIcon.WholeInset(face, e, extra)
end
SignKit.Inset = inset

-- the caller's placement (Position, AnchorPoint, ZIndex, LayoutOrder, Name, Active, Visible), then the kind stamp
local PLACE = { "Position", "AnchorPoint", "ZIndex", "LayoutOrder", "Name", "Active", "Visible" }
local function place(obj, opts, kind)
	for _, key in ipairs(PLACE) do
		if opts[key] ~= nil then
			obj[key] = opts[key]
		end
	end
	obj:SetAttribute("SignKit", kind)
	return obj
end

local function text(name, value, role, size, colour, props, parent)
	local l = Theme.Label(tostring(value or ""), role, { Size = size, Color = colour, Stroke = 1 })
	l.Name = name
	for key, v in pairs(props) do
		l[key] = v
	end
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- whole screen pixels (U9-8 look)
----------------------------------------------------------------------

-- (U9-8 look; the owner's look bar: pixel edges on whole pixels at every screen size) a window or a HUD card lives under a
-- layout UIScale (0.8 on phones and on a 1280x720 window), so a part sized in design px landed between pixels: a 2 px edge
-- drew 1.6 px, a 4 px lip 3.2, a 6 px frame 4.8 (soft in a render, 1 or 2 px in Roblox by where it fell). The kit's sizes
-- (an edge, a lip, the frame, the roof, a nail) now resolve to whole SCREEN px under the scale above them, PixelIcon's
-- rule for its cells: round(px x scale), never under 1 px. A part whose two edges are a whole number of px apart draws
-- that many px wherever it sits (Roblox rounds both edges the same way). The tweens on top (a press, a pop, a pulse) are
-- not counted. SignKit.Px(px, s): the design px of round(px x s) screen px (0 stays 0). SignKit.LayoutScale(obj): the
-- product of the layout UIScales on obj and above it. SignKit.Whole(obj, fit): calls fit(s) now and again whenever obj
-- moves (it lands under a ScreenGui) or one of the layout UIScales above it changes (the latest fit given wins)
local TWEEN_SCALES = { Pop = true, PopScale = true, FxScale = true, Punch = true, Pulse = true, Swell = true, Bounce = true }
local wholeFits = setmetatable({}, { __mode = "k" }) -- [obj] = fit
local wholeSets = setmetatable({}, { __mode = "k" }) -- [UIScale] = { [obj] = true }
local wholeConns = setmetatable({}, { __mode = "k" })

local function layoutScale(obj)
	local s, scales = 1, {}
	local cur = obj
	while cur do
		if cur:IsA("LayerCollector") then
			break
		end
		if cur:IsA("GuiObject") then
			local ui = cur:FindFirstChildOfClass("UIScale")
			if ui and ui.Scale > 0 and not TWEEN_SCALES[ui.Name] then
				s = s * ui.Scale
				scales[#scales + 1] = ui
			end
		end
		cur = cur.Parent
	end
	return s, scales
end

function SignKit.LayoutScale(obj)
	return (layoutScale(obj))
end

function SignKit.Px(px, s)
	px = tonumber(px) or 0
	if px <= 0 then
		return 0
	end
	s = (s and s > 0) and s or 1
	return math.max(1, math.floor(px * s + 0.5)) / s
end

-- (Pitch 2 F0) a finish part also refits when a UIScale is ADDED above it after it was fitted (the match result card is
-- built, then scaled to the viewport: NotifyController's ViewportScale): SignKit.Whole only hears the scales that were
-- there at its fit. scaleWatch[obj] = true opts a part in; scaleAdds[ancestor] = { [obj] = true }
local scaleWatch = setmetatable({}, { __mode = "k" })
local scaleAdds = setmetatable({}, { __mode = "k" })
local refitWhole
local function hookScaleAdds(obj)
	local cur = obj.Parent
	while cur and not cur:IsA("LayerCollector") do
		local set = scaleAdds[cur]
		if not set then
			set = setmetatable({}, { __mode = "k" })
			scaleAdds[cur] = set
			cur.ChildAdded:Connect(function(c)
				if c:IsA("UIScale") then
					for o in pairs(set) do
						refitWhole(o)
					end
				end
			end)
		end
		set[obj] = true
		cur = cur.Parent
	end
end

refitWhole = function(obj)
	local fit = wholeFits[obj]
	if not fit then
		return
	end
	if scaleWatch[obj] then
		hookScaleAdds(obj)
	end
	local s, scales = layoutScale(obj)
	fit(s)
	for _, scale in ipairs(scales) do
		local set = wholeSets[scale]
		if not set then
			set = setmetatable({}, { __mode = "k" })
			wholeSets[scale] = set
			wholeConns[scale] = scale:GetPropertyChangedSignal("Scale"):Connect(function()
				for o in pairs(set) do
					refitWhole(o)
				end
			end)
		end
		set[obj] = true
	end
end

function SignKit.Whole(obj, fit)
	local first = wholeFits[obj] == nil
	wholeFits[obj] = fit
	if first then
		obj.AncestryChanged:Connect(function()
			refitWhole(obj)
		end)
	end
	refitWhole(obj)
end

----------------------------------------------------------------------
-- the finish (Pitch 2 item F0, the owner's pick A "Carved signboard", 2026-11-20)
----------------------------------------------------------------------

-- ONE light from the top left on every part (Theme.Finish; the mock-ups .superpowers/slop-audit/round3/build/PITCH2/
-- F_overall_finish/F0_*_optA.png): a wood edge lit WoodLight on its top and left and shaded WoodDark on its bottom and
-- right, the stone body sunk under its frame with a carved rim, a slot a sunk well, a raised card's two-step diagonal hard
-- shadow (no blur). Every finish part is a holder Frame named Finish<Kind> (attribute Finish = <Kind>) of plain square
-- Frames, ZIndex 0 (under its part's own children, over the part's face), laid over the part's box (or `out` px round it:
-- a block whose wood edge is a UIStroke outside its box) in whole screen px (SignKit.Whole on the holder, so the part's
-- own fit stays). It never moves or resizes the part, so no window's layout or fit changes. A UIPadding on the part (a
-- text block's LipPad) would move its children: the holders reach back out by it, now and whenever it changes. Calling a
-- finish again updates its one holder. A part built with opts.Finish = false (the approved Credits window) gets none.
-- (playtest 2026-11-28 C2 / C3) nor does a part whose children a layout (list, grid, page, table) places, or whose size
-- AutomaticSize takes from its children, now or when that comes later (most callers add the layout after SignBlock):
-- a layout laid the holders out as rows (the Ring champion and rewards cards and the Raid tier card came out empty,
-- the trophy chip blank, a stray shadow line beside the x2 countdown) and an AutomaticSize part grew round holders that
-- reach `out` px past it, which grew with it (the arena "pets can battle here" notice became a 568x157 board)
local FIN = Theme.Finish
local WHITE = Color3.new(1, 1, 1)
local FIN_PARTS = setmetatable({}, { __mode = "k" }) -- [part] = { [holder] = true }: refit when its padding or size changes

local function padOf(obj)
	local pad = obj:FindFirstChildOfClass("UIPadding")
	if not pad then
		return 0, 0, 0, 0
	end
	return pad.PaddingLeft.Offset, pad.PaddingTop.Offset, pad.PaddingRight.Offset, pad.PaddingBottom.Offset
end

-- the holder over obj's box, `out` px round it, whatever obj's padding
local function cover(obj, h, out)
	local l, t, r, b = padOf(obj)
	h.Position = UDim2.fromOffset(-l - out, -t - out)
	h.Size = UDim2.new(1, l + r + 2 * out, 1, t + b + 2 * out)
end

-- the finish parts of a part that has them (holders, its shine / top line; not an awning's trim)
local function finishParts(obj)
	local out = {}
	for _, c in ipairs(obj:GetChildren()) do
		local k = c:GetAttribute("Finish")
		if k ~= nil and k ~= "Awning" then
			out[#out + 1] = c
		end
	end
	return out
end

-- (C2 review) every layout class that places a part's children (Roblox's UIGridStyleLayout family, named one by one:
-- the test mock has no UIGridStyleLayout base class)
local LAYOUTS = { "UIListLayout", "UIGridLayout", "UIPageLayout", "UITableLayout" }
local function isLayout(c)
	for _, class in ipairs(LAYOUTS) do
		if c:IsA(class) then
			return true
		end
	end
	return false
end

-- (C2 / C3) true when a layout places obj's children or AutomaticSize sizes obj: it takes no finish parts
local function finishless(obj)
	if obj:IsA("GuiObject") and obj.AutomaticSize ~= Enum.AutomaticSize.None then
		return true
	end
	for _, c in ipairs(obj:GetChildren()) do
		if isLayout(c) then
			return true
		end
	end
	return false
end
SignKit.Finishless = finishless

local function shed(obj)
	for _, c in ipairs(finishParts(obj)) do
		c:SetAttribute("FinishOff", true)
		c.Visible = false
	end
end

local function track(obj, h)
	local set = FIN_PARTS[obj]
	if not set then
		set = setmetatable({}, { __mode = "k" })
		FIN_PARTS[obj] = set
		local function again()
			for x in pairs(set) do
				refitWhole(x)
			end
		end
		local function hook(c)
			if c:IsA("UIPadding") then
				c.Changed:Connect(again)
			end
		end
		for _, c in ipairs(obj:GetChildren()) do
			hook(c)
		end
		obj.ChildAdded:Connect(function(c)
			hook(c)
			if c:IsA("UIPadding") or c.Name == "CloseMark" then
				again()
			end
			if isLayout(c) then
				shed(obj) -- (C2) a layout came after the finish: its parts leave the layout
			end
		end)
		obj:GetPropertyChangedSignal("Size"):Connect(again)
		if obj:IsA("GuiObject") then
			obj:GetPropertyChangedSignal("AutomaticSize"):Connect(function()
				if finishless(obj) then
					shed(obj) -- (C3)
				end
			end)
		end
	end
	set[h] = true
end

local function holderOf(obj, name, kind)
	local h = obj:FindFirstChild(name)
	if not h then
		h = frame(name, { ZIndex = 0 }, obj)
		h:SetAttribute("Finish", kind)
	end
	scaleWatch[h] = true
	h:SetAttribute("FinishOff", nil)
	h.Visible = true
	track(obj, h)
	if finishless(obj) then
		shed(obj) -- (C2 / C3) built, so a repaint keeps one holder, but never shown
	end
	return h
end

local function strip(h, name, colour, transparency)
	local s = h:FindFirstChild(name)
	if not s then
		s = fill(name, colour, { ZIndex = 0 }, h)
	end
	s.BackgroundColor3 = colour
	s.BackgroundTransparency = transparency or 0
	return s
end

local function same(a, b)
	return typeof(a) == "Color3" and typeof(b) == "Color3" and math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end

-- hide a finish holder (it stays hidden until its finish is called again)
local function hide(obj, name)
	local h = obj and obj:FindFirstChild(name)
	if h then
		h:SetAttribute("FinishOff", true)
		h.Visible = false
	end
end
SignKit.HideFinish = hide

-- the light on a wood edge. opts: Px (thick: Finish.Bevel on a window frame, Finish.Line on a block), Out (design px of
-- the part's edge stroke outside its box, 0 = the edge is the part's own border), Sides ("TLBR"; a header's rim "TLR"),
-- Light / Dark (WoodLight / WoodDark). Children LitT, LitL, DarkB, DarkR (the shaded ones drawn last: they win the corners)
function SignKit.Bevel(obj, opts)
	opts = opts or {}
	local h = holderOf(obj, "FinishBevel", "Bevel")
	local px, out = tonumber(opts.Px) or FIN.Line, tonumber(opts.Out) or 0
	local sides = opts.Sides or "TLBR"
	local parts = {}
	for _, d in ipairs({ { "T", "LitT", opts.Light or Sign.WoodLight }, { "L", "LitL", opts.Light or Sign.WoodLight },
		{ "B", "DarkB", opts.Dark or Sign.WoodDark }, { "R", "DarkR", opts.Dark or Sign.WoodDark } }) do
		if sides:find(d[1], 1, true) then
			parts[d[1]] = strip(h, d[2], d[3])
		elseif h:FindFirstChild(d[2]) then
			h[d[2]]:Destroy()
		end
	end
	SignKit.Whole(h, function(sc)
		local t = SignKit.Px(px, sc)
		cover(obj, h, SignKit.Px(out, sc))
		if parts.T then
			parts.T.Position = UDim2.new(0, 0, 0, 0)
			parts.T.Size = UDim2.new(1, 0, 0, t)
		end
		if parts.L then
			parts.L.Position = UDim2.new(0, 0, 0, 0)
			parts.L.Size = UDim2.new(0, t, 1, 0)
		end
		if parts.B then
			parts.B.Position = UDim2.new(0, 0, 1, -t)
			parts.B.Size = UDim2.new(1, 0, 0, t)
		end
		if parts.R then
			parts.R.Position = UDim2.new(1, -t, 0, 0)
			parts.R.Size = UDim2.new(0, t, 1, 0)
		end
	end)
	return h
end

-- a block under Finish.SmallBlock design px tall (a chip, a key cap) casts no shadow; nor a close block or a part with
-- attribute NoShadow
local function noShadow(obj, sc)
	if obj:GetAttribute("NoShadow") == true or obj:FindFirstChild("CloseMark") then
		return true
	end
	local s = obj.Size
	local tall = s.Y.Scale == 0 and s.Y.Offset or ((obj.AbsoluteSize.Y > 0 and sc > 0) and obj.AbsoluteSize.Y / sc or math.huge)
	return tall < FIN.SmallBlock
end

-- the two-step diagonal hard shadow down and right of the part (no blur: a darker near band Px - Step wide, a lighter
-- outer step to Px). opts: Px (Finish.Card, Finish.Window), Out (as Bevel's), Block (a block: none when it is small).
-- Children FarR, FarB (drawn first), NearR, NearB, in the ink at Finish.Far / Finish.Near transparency
function SignKit.Shadow(obj, opts)
	opts = opts or {}
	local h = holderOf(obj, "FinishShadow", "Shadow")
	local off, out = tonumber(opts.Px) or FIN.Card, tonumber(opts.Out) or 0
	local farR, farB = strip(h, "FarR", Sign.Text, FIN.Far), strip(h, "FarB", Sign.Text, FIN.Far)
	local nearR, nearB = strip(h, "NearR", Sign.Text, FIN.Near), strip(h, "NearB", Sign.Text, FIN.Near)
	local block = opts.Block == true
	SignKit.Whole(h, function(sc)
		local f = SignKit.Px(off, sc)
		local n = SignKit.Px(math.max(1, off - FIN.Step), sc)
		cover(obj, h, SignKit.Px(out, sc))
		farR.Position, farR.Size = UDim2.new(1, 0, 0, f), UDim2.new(0, f, 1, 0)
		farB.Position, farB.Size = UDim2.new(0, f, 1, 0), UDim2.new(1, -f, 0, f)
		nearR.Position, nearR.Size = UDim2.new(1, 0, 0, n), UDim2.new(0, n, 1, 0)
		nearB.Position, nearB.Size = UDim2.new(0, n, 1, 0), UDim2.new(1, -n, 0, n)
		h.Visible = h:GetAttribute("FinishOff") ~= true and not (block and noShadow(obj, sc))
	end)
	return h
end

-- the stone body sunk under its frame: a StoneLip band Finish.Sink px along its top and left (SinkT, SinkL), the WellEdge
-- hairline at its top (RimT, RimL), a lit Tile line Finish.RimLit px down its right edge (LitR), and the carved line where
-- frame and body meet, Finish.Line px just outside it (LineT / LineL WoodDark, LineB / LineR WoodLight)
function SignKit.Carve(body)
	local h = holderOf(body, "FinishCarve", "Carve")
	local p = {}
	for _, d in ipairs({ { "LineT", Sign.WoodDark }, { "LineL", Sign.WoodDark }, { "LineB", Sign.WoodLight }, { "LineR", Sign.WoodLight },
		{ "SinkT", Sign.StoneLip }, { "SinkL", Sign.StoneLip }, { "RimT", Sign.WellEdge }, { "RimL", Sign.WellEdge }, { "LitR", Sign.Tile } }) do
		p[d[1]] = strip(h, d[1], d[2])
	end
	SignKit.Whole(h, function(sc)
		local l, k, r = SignKit.Px(FIN.Line, sc), SignKit.Px(FIN.Sink, sc), SignKit.Px(FIN.RimLit, sc)
		cover(body, h, l)
		p.LineT.Position, p.LineT.Size = UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, l)
		p.LineL.Position, p.LineL.Size = UDim2.new(0, 0, 0, 0), UDim2.new(0, l, 1, 0)
		p.LineB.Position, p.LineB.Size = UDim2.new(0, 0, 1, -l), UDim2.new(1, 0, 0, l)
		p.LineR.Position, p.LineR.Size = UDim2.new(1, -l, 0, 0), UDim2.new(0, l, 1, 0)
		p.SinkT.Position, p.SinkT.Size = UDim2.fromOffset(l, l), UDim2.new(1, -2 * l, 0, k)
		p.SinkL.Position, p.SinkL.Size = UDim2.fromOffset(l, l), UDim2.new(0, k, 1, -2 * l)
		p.RimT.Position, p.RimT.Size = UDim2.fromOffset(l, l), UDim2.new(1, -2 * l, 0, l)
		p.RimL.Position, p.RimL.Size = UDim2.fromOffset(l, l), UDim2.new(0, l, 1, -2 * l)
		p.LitR.Position, p.LitR.Size = UDim2.new(1, -l - r, 0, l), UDim2.new(0, r, 1, -2 * l)
	end)
	return h
end

-- a raised face's lit top band: Finish.Shine px of the face (opts.Color; without it the face's own colour, followed as it
-- changes) toward white by Finish.ShineMix; opts.Px, opts.Mix, opts.Name / opts.Kind (a navy plate's NavyTop line:
-- SignKit.BandTop)
local FOLLOW = setmetatable({}, { __mode = "k" }) -- [face] = true: its shine follows its colour
function SignKit.Shine(face, opts)
	opts = opts or {}
	local name = opts.Name or "FinishShine"
	local s = face:FindFirstChild(name)
	if not s then
		s = fill(name, WHITE, { ZIndex = 0 }, face)
		s:SetAttribute("Finish", opts.Kind or "Shine")
	end
	local mix = tonumber(opts.Mix) or FIN.ShineMix
	local follow = typeof(opts.Color) ~= "Color3"
	s:SetAttribute("Follow", follow and mix or nil)
	if follow and not FOLLOW[face] then
		FOLLOW[face] = true
		face:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
			local x = face:FindFirstChild("FinishShine")
			local k = x and x:GetAttribute("Follow")
			if k then
				x.BackgroundColor3 = Theme.Mix(face.BackgroundColor3, WHITE, k)
			end
		end)
	end
	local base = follow and face.BackgroundColor3 or opts.Color
	s.BackgroundColor3 = Theme.Mix(base, WHITE, mix)
	s:SetAttribute("FinishOff", nil)
	s.Visible = true
	track(face, s)
	if finishless(face) then
		shed(face) -- (C2 / C3)
	end
	scaleWatch[s] = true
	local px = tonumber(opts.Px) or FIN.Shine
	SignKit.Whole(s, function(sc)
		local l, t, r = padOf(face)
		s.Position = UDim2.fromOffset(-l, -t)
		s.Size = UDim2.new(1, l + r, 0, SignKit.Px(px, sc))
	end)
	return s
end

-- a navy plate's / band's lit top line (FinishTop: NavyTop, Finish.Shine px)
function SignKit.BandTop(band)
	return SignKit.Shine(band, { Name = "FinishTop", Kind = "Top", Color = Sign.NavyTop, Mix = 0 })
end

-- a sunk well (a slot, an Off block): the shaded top and left band (ShadeT, ShadeL: Finish.WellShade px, the face toward
-- its edge by Finish.WellMix) and the lit bottom line (LitB: Finish.Line px). opts.Face / opts.Edge: the colours (default
-- the part's own colour / WellEdge)
function SignKit.Sunk(obj, opts)
	opts = opts or {}
	local h = holderOf(obj, "FinishSunk", "Sunk")
	local face = typeof(opts.Face) == "Color3" and opts.Face or obj.BackgroundColor3
	local edge = typeof(opts.Edge) == "Color3" and opts.Edge or Sign.WellEdge
	local shade = Theme.Mix(face, edge, FIN.WellMix)
	local t, l = strip(h, "ShadeT", shade), strip(h, "ShadeL", shade)
	local b = strip(h, "LitB", Theme.Mix(face, WHITE, FIN.WellLitMix))
	SignKit.Whole(h, function(sc)
		local k, one = SignKit.Px(FIN.WellShade, sc), SignKit.Px(FIN.Line, sc)
		cover(obj, h, 0)
		t.Position, t.Size = UDim2.new(0, 0, 0, 0), UDim2.new(1, 0, 0, k)
		l.Position, l.Size = UDim2.new(0, 0, 0, 0), UDim2.new(0, k, 1, 0)
		b.Position, b.Size = UDim2.new(0, 0, 1, -one), UDim2.new(1, 0, 0, one)
	end)
	return h
end

-- a raised kit block's whole finish in one call (CloudUI.SignBlock, SignKit.Plank, SignKit.Notice). opts: Face (the
-- object whose top shines, default obj), FaceColor, Out (its edge stroke's design px outside the box), Wood (false: an
-- ink / gold edge takes no wood light), Well (a sunk well instead: no light, no shine, no shadow), Shadow (false: none)
function SignKit.FinishBlock(obj, opts)
	opts = opts or {}
	local face = opts.Face or obj
	if opts.Well then
		hide(obj, "FinishBevel")
		hide(obj, "FinishShadow")
		hide(face, "FinishShine")
		SignKit.Sunk(face, { Face = opts.FaceColor, Edge = opts.EdgeColor })
		return
	end
	hide(face, "FinishSunk")
	if opts.Wood == false then
		hide(obj, "FinishBevel")
	else
		SignKit.Bevel(obj, { Px = FIN.Line, Out = opts.Out })
	end
	SignKit.Shine(face, { Color = opts.FaceColor })
	if opts.Shadow == false then
		hide(obj, "FinishShadow")
	else
		SignKit.Shadow(obj, { Px = FIN.Card, Out = opts.Out, Block = true })
	end
end

-- a window frame's whole finish (SignKit.Frame, CloudUI's Signboard panel and the windows that lay their own frame: the
-- Shop, the Gifts window, ...): the Finish.Bevel light on the wood, the window's shadow, the carved rim of its body (the
-- child stamped SignKit = "Body", or opts.Body)
function SignKit.FinishFrame(wood, opts)
	opts = opts or {}
	SignKit.Bevel(wood, { Px = FIN.Bevel })
	if opts.Shadow ~= false then
		SignKit.Shadow(wood, { Px = FIN.Window })
	end
	local body = opts.Body
	if not body then
		for _, c in ipairs(wood:GetChildren()) do
			if c:GetAttribute("SignKit") == "Body" then
				body = c
				break
			end
		end
	end
	if body then
		SignKit.Carve(body)
	end
end

-- (the open) the window rises Finish.Rise px to where it is now in Finish.RiseSteps hard steps, Finish.RiseStep s apart:
-- no easing, no scale bounce. Called again mid-rise it starts over from the same rest; a layout that moves the window
-- mid-rise wins (the rise stops where the layout put it)
local RISE = setmetatable({}, { __mode = "k" })
local function samePos(a, b)
	return a.X.Scale == b.X.Scale and a.X.Offset == b.X.Offset and a.Y.Scale == b.Y.Scale and a.Y.Offset == b.Y.Offset
end
function SignKit.Rise(obj)
	if not (obj and obj:IsA("GuiObject")) then
		return
	end
	local run = RISE[obj]
	local rest = (run and run.at and samePos(obj.Position, run.at)) and run.rest or obj.Position
	local steps = math.max(1, math.floor(FIN.RiseSteps))
	run = { rest = rest }
	RISE[obj] = run
	local function at(k)
		local sc = SignKit.LayoutScale(obj)
		local p = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset + SignKit.Px(FIN.Rise * k / steps, sc))
		obj.Position = p
		run.at = p
	end
	local function step(k)
		if RISE[obj] ~= run then
			return
		end
		if not samePos(obj.Position, run.at) then
			RISE[obj] = nil
			return
		end
		if k <= 0 then
			obj.Position = rest
			RISE[obj] = nil
			return
		end
		at(k)
		task.delay(FIN.RiseStep, step, k - 1)
	end
	at(steps)
	task.delay(FIN.RiseStep, step, steps - 1)
end

-- the press's one darker frame: the face (Frame) shows Finish.PressDark darker for Finish.PressFrame s, then its colour
-- again (unless something repainted it meanwhile)
function SignKit.PressFrame(face)
	if not (face and face:IsA("GuiObject")) then
		return
	end
	local rest = face.BackgroundColor3
	local dark = Theme.Darken(rest, FIN.PressDark)
	face.BackgroundColor3 = dark
	task.delay(FIN.PressFrame, function()
		if same(face.BackgroundColor3, dark) then
			face.BackgroundColor3 = rest
		end
	end)
end

----------------------------------------------------------------------
-- scroll bar
----------------------------------------------------------------------

-- (U9-7 look) every kit B list's bar: Sizes.ScrollBar thick, opaque, in the wood, and square at both ends. Roblox's own
-- top / bottom images are round caps (a smooth capsule beside the square planks, a brown pill when the thumb is short):
-- all three parts take the built-in middle piece, so the bar is a plain block (no upload). opts: Thickness, Color.
-- Returns the ScrollingFrame.
SignKit.ScrollImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
function SignKit.ScrollBar(scroll, opts)
	opts = opts or {}
	scroll.ScrollBarThickness = tonumber(opts.Thickness) or Z.ScrollBar
	scroll.ScrollBarImageColor3 = opts.Color or Sign.Wood
	scroll.ScrollBarImageTransparency = 0
	scroll.TopImage = SignKit.ScrollImage
	scroll.MidImage = SignKit.ScrollImage
	scroll.BottomImage = SignKit.ScrollImage
	scroll:SetAttribute("SignBar", true)
	return scroll
end

----------------------------------------------------------------------
-- roof
----------------------------------------------------------------------

-- the Credits gable: two tilted slopes (their lower parts hide behind the header), a darker fascia board and a round vent
local function gable(roof, opts, w, h)
	local slopeT = opts.Slope or 52
	local halfW = w / 2
	local theta = math.atan2(h, halfW)
	local len = math.sqrt(halfW * halfW + h * h)
	-- the slope's top edge runs eave -> ridge; its centre sits half a thickness below that edge's middle
	local nx, ny = math.sin(theta), math.cos(theta)
	local cx, cy = halfW / 2 + nx * slopeT / 2, h / 2 + ny * slopeT / 2
	for _, side in ipairs({ { "SlopeL", cx, -1 }, { "SlopeR", w - cx, 1 } }) do
		fill(side[1], opts.Color or Sign.Roof, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(side[2], cy),
			Size = UDim2.fromOffset(len + 1, slopeT),
			Rotation = side[3] * math.deg(theta),
			ZIndex = 1,
		}, roof)
	end
	fill("Fascia", opts.Shade or Sign.RoofLip, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(w + 16, opts.Fascia or 9),
		ZIndex = 2,
	}, roof)
	local vent = fill("Vent", opts.Vent or Sign.Stone, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(halfW, math.floor(h * 0.52)),
		Size = UDim2.fromOffset(14, 14),
		ZIndex = 3,
	}, roof)
	round(vent)
	vent:SetAttribute("Art", "gable vent") -- (kit-b gate U9 round 3) the Credits gable's round vent: the drawn roof's own detail
	line(vent, opts.VentEdge or Sign.Wood, 2)
end

-- opts: Width, Height (fixed design px), Y, Shape ("Flat" | "Gable"), Color, Edge (border colour), Lip (lip colour),
-- EdgePx, LipPx; gable: Slope, Fascia, Shade, Vent, VentEdge
-- (LOOK-ui2: the Training Place, Fusion and the pet picker drew a bare gold icon on their hand-laid navy plank, Pets, My
-- Home, Battle Arena and the Food Machine put it in the gold square) SignKit.Header's IconSlot on a label a window lays out
-- itself: the gold square in a 2 px ink line, the pixel icon `name` in the ink at `px` (27 on a PC header, 18 on a phone's:
-- the kit's two icon sizes). Call again for a new icon or size; a nil name keeps the one it shows
function SignKit.IconSlot(host, name, px)
	host.BackgroundTransparency = 0
	host.BackgroundColor3 = Sign.Gold
	host.BorderSizePixel = 0
	host.Text = ""
	if not host:FindFirstChild("SlotLine") then
		line(host, Sign.Text, 2).Name = "SlotLine"
	end
	name = name or host:GetAttribute("SlotIcon")
	px = px or host:GetAttribute("SlotPx") or 27
	if name and (host:GetAttribute("SlotIcon") ~= name or host:GetAttribute("SlotPx") ~= px) then
		host:SetAttribute("SlotIcon", name)
		host:SetAttribute("SlotPx", px)
		PixelIcon.Host(host, name, px, Sign.Text)
	end
	return host
end

function SignKit.Roof(parent, opts)
	opts = opts or {}
	local w = tonumber(opts.Width) or Z.RoofW
	local h = tonumber(opts.Height) or Z.RoofH
	local roof = frame("Roof", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, tonumber(opts.Y) or 0),
		Size = UDim2.fromOffset(w, h),
	}, parent)
	if opts.Shape == "Gable" then
		gable(roof, opts, w, h)
	else
		local e = tonumber(opts.EdgePx) or Z.RoofEdge
		local lipPx = tonumber(opts.LipPx) or Z.RoofLip
		roof.BackgroundTransparency = 0
		roof.BackgroundColor3 = opts.Edge or Sign.RoofEdge
		local face = fill("Face", opts.Color or Sign.Roof, {
			Position = UDim2.fromOffset(e, e),
			Size = UDim2.new(1, -2 * e, 1, -2 * e),
		}, roof)
		inset(face, e)
		lipOf(fill("Lip", opts.Lip or Sign.RoofLip, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, lipPx),
		}, face), lipPx)
		-- (U9-8 look) the sprite itself whole screen px under the window's scale (was 14.4 px high at 0.8); its border
		-- and its lip snap through inset / lipOf (LOOK-ui)
		SignKit.Whole(roof, function(sc)
			roof.Size = UDim2.fromOffset(SignKit.Px(w, sc), SignKit.Px(h, sc))
		end)
		if opts.Finish ~= false then
			SignKit.Awning(roof, w, h, opts)
		end
	end
	return place(roof, opts, "Roof")
end

-- (Pitch 2 F0, the owner's pick A: "a striped scalloped awning seated on the frame on two wood end brackets"; the flat
-- awning floated half over the frame like a stray bar) the flat roof's trim, in its holder FinishTrim (attribute Finish =
-- "Awning") over the roof's face: cream stripes every other AwningSizes.Band px, the pink's lit top line, a scalloped
-- valance (one tab per band, its edge, face, shade and rounded tip) hanging AwningSizes.Hang px under the roof's box over
-- the frame's top rim, and a wood bracket at each end holding it to the frame. The roof's box (its size, its place) is
-- unchanged
SignKit.AwningSizes = { Band = 24, Hang = 8, Bracket = 8 }

-- (look review of finish pass A, major 1: the awning hung into the header band, its scallops over the Gifts window's Play
-- time tab, the Index's title and the phone's GIFTS) where a window's awning goes: the Y (design px) that puts its box
-- over the window's top edge `frameTop` (default 0) so that only its valance hangs over the frame, ending on the wood
-- rim (Sizes.Rim): the awning sits ON the frame (the mock: F0_*_optA.png), never over the header's tabs, title or close
function SignKit.RoofSeat(frameTop)
	return (tonumber(frameTop) or 0) - (Z.RoofH + SignKit.AwningSizes.Hang - Z.Rim)
end
local AWNING = setmetatable({}, { __mode = "k" }) -- [roof] = the "w x h" its trim was built for
function SignKit.Awning(roof, w, h)
	local A = SignKit.AwningSizes
	-- a window that resizes its roof (the Gifts window's phone awning) gets the trim again at the new width (design px:
	-- the size it set, or the whole-px size SignKit.Whole gave it)
	if AWNING[roof] == nil then
		roof:GetPropertyChangedSignal("Size"):Connect(function()
			local sc = SignKit.LayoutScale(roof)
			local nw = math.floor(roof.Size.X.Offset + 0.5)
			local built = AWNING[roof]
			if built and roof:FindFirstChild("FinishTrim") and math.abs(nw - built[1]) > math.max(1, 1 / sc) then
				SignKit.Awning(roof, nw, built[2])
			end
		end)
	end
	AWNING[roof] = { w, h }
	local t = roof:FindFirstChild("FinishTrim")
	if t then
		t:Destroy()
	end
	t = frame("FinishTrim", { ZIndex = 2, Size = UDim2.fromScale(1, 1) }, roof)
	t:SetAttribute("Finish", "Awning")
	local e = Z.RoofEdge
	local bands = {}
	local x = e
	local n = 0
	while x < w - e do
		n = n + 1
		bands[n] = { x, math.min(A.Band, w - e - x) }
		x = x + A.Band
	end
	local function box(name, colour, x0, y0, bw, bh)
		local f = fill(name, colour, { ZIndex = 2 }, t)
		f:SetAttribute("At", Vector2.new(x0, y0))
		f:SetAttribute("Box", Vector2.new(bw, bh))
		return f
	end
	for i, b in ipairs(bands) do
		if i % 2 == 0 then
			box("Stripe" .. i, Sign.Stone, b[1], e, b[2], h - 2 * e)
		end
	end
	box("TopLight", Theme.Mix(Sign.Roof, WHITE, 0.45), e, e, w - 2 * e, 2)
	for i, b in ipairs(bands) do
		local cream = i % 2 == 0
		local faceC = cream and Sign.Stone or Sign.Roof
		local shade = cream and Sign.StoneLip or Sign.RoofLip
		local bx, bw = b[1], b[2]
		box("Tab" .. i, Sign.RoofEdge, bx, h - 4, bw, 10)
		box("TabFace" .. i, faceC, bx + 2, h - 4, math.max(1, bw - 4), 8)
		box("TabShade" .. i, shade, bx + 2, h + 2, math.max(1, bw - 4), 2)
		if bw > 8 then
			box("TabTip" .. i, Sign.RoofEdge, bx + 4, h + 6, bw - 8, 2)
		end
		if bw > 12 then
			box("TabTipShade" .. i, shade, bx + 6, h + 4, bw - 12, 2)
		end
	end
	for _, side in ipairs({ { "BracketL", -A.Bracket }, { "BracketR", w } }) do
		box(side[1], Sign.WoodDark, side[2], -2, A.Bracket, h + 2 + A.Hang)
		box(side[1] .. "Wood", Sign.Wood, side[2] + 1, -1, A.Bracket - 2, h + A.Hang)
		box(side[1] .. "Lit", Sign.WoodLight, side[2] + 1, -1, A.Bracket - 2, 2)
	end
	-- every piece on whole screen px under the window's scale: its two edges each snapped
	scaleWatch[t] = true
	SignKit.Whole(t, function(sc)
		for _, f in ipairs(t:GetChildren()) do
			local at, sz = f:GetAttribute("At"), f:GetAttribute("Box")
			if at and sz then
				local x0, y0 = SignKit.Px(math.abs(at.X), sc) * (at.X < 0 and -1 or 1), SignKit.Px(math.abs(at.Y), sc) * (at.Y < 0 and -1 or 1)
				local x1, y1 = SignKit.Px(math.abs(at.X + sz.X), sc) * ((at.X + sz.X) < 0 and -1 or 1), SignKit.Px(at.Y + sz.Y, sc)
				f.Position = UDim2.fromOffset(x0, y0)
				f.Size = UDim2.fromOffset(math.max(SignKit.Px(1, sc), x1 - x0), math.max(SignKit.Px(1, sc), y1 - y0))
			end
		end
	end)
	return t
end

----------------------------------------------------------------------
-- header, frame, body
----------------------------------------------------------------------

-- (render gate, GATE_KITB; Pitch 2 F0 A, look review of finish pass A major 3) how far a Ribbon header's plate reaches
-- past the frame: 0. The finish's shared rule is "header bands inside the frame" (the mock keeps the plate at
-- x+6 .. x+w-6); the T1 band out over the frame with its dark notched tails is gone
SignKit.HeaderBand = { Over = 0 }

-- the plate inside the rim (every header: the F0 rule); SignKit.HeaderOverhang
local function placePlate(head, on)
	local plate = head:FindFirstChild("Plate")
	local rim = head:GetAttribute("Rim") or Z.Rim
	on = false -- (F0 A) never out over the frame
	local over = 0
	if not plate then
		return
	end
	-- the plate's own parts (the icon square, the title) keep their place on the screen when the plate moves
	local delta = (on and -over or rim) - plate.Position.X.Offset
	if delta ~= 0 then
		for _, c in ipairs(plate:GetChildren()) do
			if c:IsA("GuiObject") and c:GetAttribute("Ribbon") == nil then
				local p, s = c.Position, c.Size
				c.Position = UDim2.new(p.X.Scale, p.X.Offset - delta, p.Y.Scale, p.Y.Offset)
				if s.X.Scale == 1 then
					c.Size = UDim2.new(1, s.X.Offset + delta, s.Y.Scale, s.Y.Offset)
				end
			end
		end
	end
	plate.Position = UDim2.fromOffset(on and -over or rim, rim)
	plate.Size = UDim2.new(1, on and 2 * over or -2 * rim, 1, -rim)
	for _, side in ipairs({ "TailL", "TailR" }) do
		local tail = head:FindFirstChild(side)
		if tail then
			tail.Visible = on
		end
	end
	head:SetAttribute("Overhang", on)
end

-- (render gate) a Ribbon header's band out over the frame (on) or inside the rim (off). (Pitch 2 F0 A) both keep it inside
-- the rim with no tails now ("header bands inside the frame"); the callers keep calling it. The title does not move
function SignKit.HeaderOverhang(head, on)
	if head and head:GetAttribute("Ribbon") then
		placePlate(head, on == true)
	end
end

-- opts: Title, TitleRole ("Title"), TitleSize, TitleColor (gold), Drop (a Color3: a drop line 3 px under the title),
-- TitleX, Reserve (px kept free on the right, e.g. for a close X), Y, Height, Rim, RimColor (wood), Color (navy),
-- IconSlot (a gold square left of the title for a PixelIcon), Ribbon (the untabbed window's header: the plate stays
-- inside the rim, Pitch 2 F0 A; the title wears its own gold V-notched ribbon, RibbonBand = "Header")
function SignKit.Header(parent, opts)
	opts = opts or {}
	local rim = tonumber(opts.Rim) or Z.Rim
	local role = opts.TitleRole or "Title"
	local ribbon = opts.Ribbon == true and role == "Title"
	local shift = 0 -- (F0 A) the plate starts at the rim: nothing moves in
	local head = fill("Head", opts.RimColor or Sign.Wood, {
		Position = UDim2.fromOffset(0, tonumber(opts.Y) or 0),
		Size = UDim2.new(1, 0, 0, tonumber(opts.Height) or Z.HeadH),
		Active = true,
	}, parent)
	head:SetAttribute("Rim", rim)
	local plate = fill("Plate", opts.Color or Sign.Navy, {
		Position = UDim2.fromOffset(rim, rim),
		Size = UDim2.new(1, -2 * rim, 1, -rim),
	}, head)
	local size = tonumber(opts.TitleSize) or Theme.RoleSize(role)
	if ribbon then
		-- (Pitch 2 F0 A) no tails on the head: the plate stays inside the rim, the title's own ribbon carries the V tails
		head:SetAttribute("Ribbon", true)
		placePlate(head, false)
	end
	local x = (tonumber(opts.TitleX) or Z.TitleX) + shift
	if opts.IconSlot then
		local slot = fill("IconSlot", Sign.Gold, {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 12 + shift, 0.5, 0),
			Size = UDim2.fromOffset(Z.IconSlot, Z.IconSlot),
			ZIndex = 2, -- over the band's pipings
		}, plate)
		line(slot, Sign.Text, 2)
		x = 12 + Z.IconSlot + 12 + shift
	end
	local box = UDim2.new(1, -(x + (tonumber(opts.Reserve) or 0) + shift), 1, 0)
	if opts.Drop then
		text("TitleDrop", opts.Title, role, size, opts.Drop, {
			Position = UDim2.fromOffset(x, 3),
			Size = box,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 1,
		}, plate)
	end
	local title = text("Title", opts.Title, role, size, opts.TitleColor or Sign.Gold, {
		Position = UDim2.fromOffset(x, 0),
		Size = box,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 2,
	}, plate)
	if role == "Title" then
		if ribbon then
			title:SetAttribute("RibbonBand", "Header") -- the plate is its band
		end
		Theme.StyleTitle(title) -- (T0) the one title treatment; the Credits' Sign role keeps its approved look
	end
	place(head, opts, "Header")
	-- (U9-8 look) the rim whole screen px under the window's scale (the same rule as the frame's, so the two still match)
	SignKit.Whole(head, function(sc)
		head:SetAttribute("Rim", SignKit.Px(rim, sc))
		placePlate(head, head:GetAttribute("Overhang") == true)
	end)
	if opts.Finish ~= false then
		-- (Pitch 2 F0) the rim carries the frame's light (lit top and left, shaded right: the frame below closes it), the
		-- navy plate its lit top line
		SignKit.Bevel(head, { Px = FIN.Bevel, Sides = "TLR" })
		SignKit.BandTop(plate)
	end
	return head, plate
end

-- opts: Y, Height (nil = down to the parent's bottom), Color (wood), Finish (false: no finish, the approved Credits)
function SignKit.Frame(parent, opts)
	opts = opts or {}
	local y = tonumber(opts.Y) or 0
	local h = tonumber(opts.Height)
	local wood = fill("Wood", opts.Color or Sign.Wood, {
		Position = UDim2.fromOffset(0, y),
		Size = h and UDim2.new(1, 0, 0, h) or UDim2.new(1, 0, 1, -y),
		Active = true,
	}, parent)
	place(wood, opts, "Frame")
	if opts.Finish ~= false then
		-- (Pitch 2 F0) the frame's light and the window's shadow (its body, added next, carves itself)
		SignKit.Bevel(wood, { Px = FIN.Bevel })
		SignKit.Shadow(wood, { Px = FIN.Window })
	end
	return wood
end

-- opts: Inset (the frame's width), Color (stone), Lip (px; 0 = none), LipColor, Line = { Inset, Thickness, Color } (an
-- inner line drawn as a Border stroke)
function SignKit.Body(parentFrame, opts)
	opts = opts or {}
	local inset = tonumber(opts.Inset) or Z.Frame
	local body = fill("Body", opts.Color or Sign.Stone, {
		Position = UDim2.fromOffset(inset, inset),
		Size = UDim2.new(1, -2 * inset, 1, -2 * inset),
	}, parentFrame)
	local lip = tonumber(opts.Lip) or Z.Lip
	local lipFrame = nil
	if lip > 0 then
		lipFrame = lipOf(fill("Lip", opts.LipColor or Sign.StoneLip, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, lip),
		}, body), lip)
	end
	-- (U9-8 look) the wood frame round it and its lip whole screen px under the window's scale
	SignKit.Whole(body, function(sc)
		local i = SignKit.Px(inset, sc)
		body.Position = UDim2.fromOffset(i, i)
		body.Size = UDim2.new(1, -2 * i, 1, -2 * i)
		if lipFrame then
			lipFrame.Size = UDim2.new(1, 0, 0, SignKit.Px(lip, sc))
		end
	end)
	if type(opts.Line) == "table" then
		local li = tonumber(opts.Line.Inset) or 5
		local ln = frame("Line", {
			Position = UDim2.fromOffset(li, li),
			Size = UDim2.new(1, -2 * li, 1, -2 * li),
			ZIndex = 1,
		}, body)
		line(ln, opts.Line.Color or Sign.StoneLip, tonumber(opts.Line.Thickness) or 3)
	end
	place(body, opts, "Body")
	if opts.Finish ~= false then
		SignKit.Carve(body) -- (Pitch 2 F0) sunk under the frame, the carved rim
	end
	return body
end

----------------------------------------------------------------------
-- plank (button)
----------------------------------------------------------------------

-- the block offset and the lip a state shows (the plank and the block keep their size): hover lifts the block Hover px;
-- press sinks it Sink px and the face grows down over the lip until PressLip px of it shows (the pitch's .dn)
function SignKit.PlankState(plank, state)
	local block = plank and plank:FindFirstChild("Block")
	local face = block and block:FindFirstChild("Face")
	if not face then
		return
	end
	-- (U9-8 look) every size whole screen px under the window's scale
	local sc = SignKit.LayoutScale(plank)
	local e = SignKit.Px(plank:GetAttribute("EdgePx") or Z.Edge, sc)
	local lip = SignKit.Px(plank:GetAttribute("LipPx") or Z.Lip, sc)
	if plank:GetAttribute("Off") then
		state = "Rest"
	end
	if state ~= "Hover" and state ~= "Press" then
		state = "Rest"
	end
	if state == "Press" and plank:GetAttribute("PlankState") ~= "Press" then
		SignKit.PressFrame(face) -- (Pitch 2 F0) the press: one darker frame, then the sink
	end
	local shown = state == "Press" and math.min(lip, SignKit.Px(Z.PressLip, sc)) or lip
	block.Position = UDim2.fromOffset(0, (state == "Hover" and -SignKit.Px(Z.Hover, sc)) or (state == "Press" and SignKit.Px(Z.Sink, sc)) or 0)
	face.Position = UDim2.fromOffset(e, e)
	face.Size = UDim2.new(1, -2 * e, 1, -(2 * e + shown))
	local under = block:FindFirstChild("Lip")
	if under then
		under.Position = UDim2.fromOffset(e, e)
		under.Size = UDim2.new(1, -2 * e, 1, -2 * e)
	end
	plank:SetAttribute("PlankState", state)
end

-- the label's size: `size` stepped down until the text fits `room` px (Theme.Measure, Button role), never under 14
local function fitSize(textValue, size, room)
	while size > 14 do
		local ok, m = pcall(Theme.Measure, textValue, "Button", size)
		if not ok or not m or m.X <= room then
			break
		end
		size = size - 1
	end
	return size
end
SignKit.FitSize = fitSize -- (U5 review) for a caller that lays its own icon beside the label (MainMenuController)

-- opts: Text, Style (SignKit.Styles name, default Stone), Width, Height, TextSize (stepped down to fit the face, then the
-- label truncates), Face / Lip / Edge / TextColor overrides, LipPx (the lip's height, default Sizes.Lip), IconSlot (a
-- square left of the label for a PixelIcon), Callback (on Activated). Style Off is disabled: not Active, not Selectable,
-- no callback, it never moves
function SignKit.Plank(parent, opts)
	opts = opts or {}
	local look = SignKit.Styles[opts.Style or "Stone"] or SignKit.Styles.Stone
	local w = tonumber(opts.Width) or 160
	local h = tonumber(opts.Height) or Z.PlankH
	local e, lip = Z.Edge, tonumber(opts.LipPx) or Z.Lip
	local plank = Instance.new("TextButton")
	plank.Name = "Plank"
	plank.Text = ""
	plank.AutoButtonColor = false
	plank.BackgroundTransparency = 1
	plank.BorderSizePixel = 0
	plank.Size = UDim2.fromOffset(w, h)
	plank.Active = not look.Off
	plank.Selectable = not look.Off
	plank:SetAttribute("EdgePx", e)
	plank:SetAttribute("LipPx", lip)
	if look.Off then
		plank:SetAttribute("Off", true)
	end
	local block = fill("Block", opts.Edge or look.Edge, { Size = UDim2.fromScale(1, 1) }, plank)
	fill("Lip", opts.Lip or look.Lip, {
		Position = UDim2.fromOffset(e, e),
		Size = UDim2.new(1, -2 * e, 1, -2 * e),
	}, block)
	local face = fill("Face", opts.Face or look.Face, {
		Position = UDim2.fromOffset(e, e),
		Size = UDim2.new(1, -2 * e, 1, -(2 * e + lip)),
		ZIndex = 2,
	}, block)
	local x = 0
	if opts.IconSlot then
		local px = h - 2 * e - lip - 8
		frame("IconSlot", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 10, 0.5, 0),
			Size = UDim2.fromOffset(px, px),
			ZIndex = 3,
		}, face)
		x = 10 + px
	end
	local room = w - 2 * e - x - 2 * Z.LabelPad
	text("Label", opts.Text, "Button", fitSize(tostring(opts.Text or ""), tonumber(opts.TextSize) or 22, room), opts.TextColor or look.Text, {
		Position = UDim2.fromOffset(x, 0),
		Size = UDim2.new(1, -x, 1, 0),
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3,
	}, face)
	plank.MouseEnter:Connect(function()
		SignKit.PlankState(plank, "Hover")
	end)
	plank.MouseLeave:Connect(function()
		SignKit.PlankState(plank, "Rest")
	end)
	plank.MouseButton1Down:Connect(function()
		SignKit.PlankState(plank, "Press")
	end)
	plank.MouseButton1Up:Connect(function()
		SignKit.PlankState(plank, plank:GetAttribute("PlankState") == "Press" and "Hover" or "Rest")
	end)
	-- a finger that lifts never produces MouseLeave (nor MouseButton1Up once it slid off)
	plank.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			SignKit.PlankState(plank, "Rest")
		end
	end)
	if type(opts.Callback) == "function" and not look.Off then
		plank.Activated:Connect(opts.Callback)
	end
	if opts.Finish ~= false then
		-- (Pitch 2 F0) an Off plank is a sunk well; a raised one has the light on its wood edge, the face's lit top band and
		-- the card shadow (none under an ink-edged close block)
		local edge = opts.Edge or look.Edge
		if look.Off then
			SignKit.Sunk(face, { Face = opts.Face or look.Face, Edge = edge })
		else
			if same(edge, Sign.Wood) then
				SignKit.Bevel(block, { Px = FIN.Line })
			end
			SignKit.Shine(face)
			if not same(edge, Sign.Text) then
				SignKit.Shadow(plank, { Px = FIN.Card, Block = true })
			end
		end
	end
	plank.Parent = parent
	-- (U9-8 look) drawn again in whole screen px whenever it moves or the window's scale changes
	SignKit.Whole(plank, function()
		SignKit.PlankState(plank, plank:GetAttribute("PlankState") or "Rest")
	end)
	return place(plank, opts, "Plank")
end

----------------------------------------------------------------------
-- rope, block row, notice
----------------------------------------------------------------------

-- opts: Length, Width, Color (post), Shade (wood: its shaded side)
function SignKit.Rope(parent, opts)
	opts = opts or {}
	local w = tonumber(opts.Width) or Z.RopeW
	local rope = fill("Rope", opts.Color or Sign.Post, { Size = UDim2.fromOffset(w, tonumber(opts.Length) or 60) }, parent)
	fill("Shade", opts.Shade or Sign.Wood, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0, math.max(1, math.floor(w / 3)), 1, 0),
	}, rope)
	return place(rope, opts, "Rope")
end

-- opts: Count, BlockW, BlockH, Gap, (U9-7 look) LipPx (the lip under each face: Sizes.BlockLip; a small block keeps its
-- face about three quarters of its height, as the loading bar's), EdgePx (Sizes.BlockEdge), Fill / FillLip (the lit
-- blocks' face and lip: gold by default; a role colour, e.g. a boss's health in red)
local BLOCK_FILL = setmetatable({}, { __mode = "k" }) -- [row] = { face, lip }
function SignKit.BlockRow(parent, opts)
	opts = opts or {}
	local n = math.max(1, math.floor(tonumber(opts.Count) or 12))
	local bw, bh = tonumber(opts.BlockW) or Z.BlockW, tonumber(opts.BlockH) or Z.BlockH
	local gap = tonumber(opts.Gap) or Z.BlockGap
	local e = tonumber(opts.EdgePx) or Z.BlockEdge
	local lipPx = tonumber(opts.LipPx) or Z.BlockLip
	local row = frame("BlockRow", { Size = UDim2.fromOffset(n * bw + (n - 1) * gap, bh) }, parent)
	row:SetAttribute("Count", n)
	row:SetAttribute("LipPx", lipPx)
	BLOCK_FILL[row] = { typeof(opts.Fill) == "Color3" and opts.Fill or Sign.Gold, typeof(opts.FillLip) == "Color3" and opts.FillLip or Sign.GoldLip }
	for i = 1, n do
		local b = fill("Block" .. i, Sign.Wood, {
			Position = UDim2.fromOffset((i - 1) * (bw + gap), 0),
			Size = UDim2.fromOffset(bw, bh),
		}, row)
		local face = fill("Face", Sign.Stone, {
			Position = UDim2.fromOffset(e, e),
			Size = UDim2.new(1, -2 * e, 1, -2 * e),
		}, b)
		inset(face, e)
		lipOf(fill("Lip", Sign.StoneLip, {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, lipPx),
		}, face), lipPx)
	end
	-- (U9-8 look) each block's wood edge and lip whole screen px under the scale above the row (the blocks keep their
	-- design widths, so no window's layout moves)
	SignKit.Whole(row, function(sc)
		local ew, lw = SignKit.Px(e, sc), SignKit.Px(lipPx, sc)
		for i = 1, n do
			local b = row:FindFirstChild("Block" .. i)
			local face = b and b:FindFirstChild("Face")
			if face then
				face.Position = UDim2.fromOffset(ew, ew)
				face.Size = UDim2.new(1, -2 * ew, 1, -2 * ew)
				local lip = face:FindFirstChild("Lip")
				if lip then
					lip.Size = UDim2.new(1, 0, 0, lw)
				end
			end
		end
	end)
	place(row, opts, "BlockRow")
	SignKit.FillBlocks(row, 0)
	return row
end

-- (LOOK-ui, kitb-look1: the owner's look bar 2026-11-17, "every bar in the block-bar language") a BlockRow that fills its
-- own box, for a bar laid out by the screen (opts Size / Position / AnchorPoint, Scale allowed): Count blocks sharing its
-- width (each 1/Count of it less its share of the gaps: it fits whatever the box becomes, a block's edge and lip stay on
-- whole screen px). opts: Count, Gap (2), EdgePx (2), LipPx (3), Fill / FillLip, Size, Position, AnchorPoint, ZIndex,
-- Name. SignKit.FillBlocks lights it; SignKit.SetBlockCount changes Count
local function fitBlock(row, i, e, lipPx)
	local b = fill("Block" .. i, Sign.Wood, { Size = UDim2.new(0, 0, 1, 0) }, row)
	local face = fill("Face", Sign.Stone, {
		Position = UDim2.fromOffset(e, e),
		Size = UDim2.new(1, -2 * e, 1, -2 * e),
	}, b)
	inset(face, e)
	lipOf(fill("Lip", Sign.StoneLip, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, lipPx),
	}, face), lipPx)
	return b
end

-- (LOOK-ui, kitb-look1: blocks laid as shares of the row were fractional at every size, 11.67 px with a 7.67 px face at
-- 1080p, a 2 px smudge on a phone) laid out in whole screen px from the row's AbsoluteSize: every block w = floor((rowW -
-- (n - 1) x gap) / n) wide, block i at i x (w + gap), the spare px left at the row's end, the height whole; again when
-- the row's size or scale changes. A block whose face would be under 4 px drops its edge (an edgeless pip on its 2 px
-- lip). Before the first layout (no size yet) the shares stand in
local MIN_FACE = 4
local function layFit(row)
	local n = row:GetAttribute("Count") or 0
	if n < 1 then
		return
	end
	local gap = row:GetAttribute("Gap") or 2
	local abs = row.AbsoluteSize
	local s = PixelIcon.RestScale(row)
	if abs.X < 1 or abs.Y < 1 or s <= 0 then
		for i = 1, n do
			local b = row:FindFirstChild("Block" .. i)
			if b then
				b.Position = UDim2.new((i - 1) / n, (i - 1) * gap / n, 0, 0)
				b.Size = UDim2.new(1 / n, -(n - 1) * gap / n, 1, 0)
			end
		end
		return
	end
	local g = math.max(1, math.floor(gap * s + 0.5))
	local w = math.max(1, math.floor((math.floor(abs.X + 1e-6) - (n - 1) * g) / n))
	local h = math.max(1, math.floor(abs.Y + 1e-6))
	-- (kit-b gate U9 r4) the weight's edge and lip in whole screen px, never under its MinEdge / MinLip screen px; handed
	-- to WholeInset / WholeHeight as the design px that draw exactly that many
	local e = math.max(row:GetAttribute("MinEdge") or 1, math.max(1, math.floor((row:GetAttribute("EdgePx") or 2) * s + 0.5)))
	local lipScreen = math.max(row:GetAttribute("MinLip") or 1, math.max(1, math.floor((row:GetAttribute("LipPx") or 3) * s + 0.5)))
	local pip = w - 2 * e < MIN_FACE
	row:SetAttribute("Pips", pip)
	row:SetAttribute("BlockPx", w)
	-- each block is its share of the row plus the whole-px correction measured now: exact while the row keeps this size,
	-- and still inside the row if it changes before the next layout (the share follows it; a resize may not be signalled)
	local W, Hh = abs.X / s, abs.Y / s
	for i = 1, n do
		local b = row:FindFirstChild("Block" .. i)
		if b then
			b.Position = UDim2.new((i - 1) / n, (i - 1) * (w + g) / s - (i - 1) / n * W, 0, 0)
			b.Size = UDim2.new(1 / n, w / s - W / n, 1, h / s - Hh)
			b.BackgroundTransparency = pip and 1 or 0
			local face = b:FindFirstChild("Face")
			if face then
				PixelIcon.WholeInset(face, pip and 0 or e / s)
				local lip = face:FindFirstChild("Lip")
				if lip and pip then
					PixelIcon.WholeHeight(lip, 2)
				elseif lip then
					PixelIcon.WholeHeight(lip, lipScreen / s)
				end
			end
		end
	end
end

-- (kit-b gate U9 r4) opts.Weight "Bar" (default) or "Micro" (Sizes.Bar / Sizes.Micro): the row's edge, lip and min screen
-- px come from its weight only, its Gap is clamped into the weight's range (a caller's EdgePx / LipPx are not read)
function SignKit.FitBlocks(parent, opts)
	opts = opts or {}
	local weight = opts.Weight == "Micro" and "Micro" or "Bar"
	local wt = Z[weight]
	local row = frame("BlockRow", { Size = opts.Size or UDim2.new(1, 0, 0, Z.BlockH) }, parent)
	row:SetAttribute("Weight", weight)
	row:SetAttribute("Gap", math.max(wt.Gap, math.min(wt.GapMax, tonumber(opts.Gap) or wt.Gap)))
	row:SetAttribute("EdgePx", wt.Edge)
	row:SetAttribute("LipPx", wt.Lip)
	row:SetAttribute("MinEdge", wt.MinEdge)
	row:SetAttribute("MinLip", wt.MinLip)
	row:SetAttribute("Fit", true)
	BLOCK_FILL[row] = { typeof(opts.Fill) == "Color3" and opts.Fill or Sign.Gold, typeof(opts.FillLip) == "Color3" and opts.FillLip or Sign.GoldLip }
	place(row, opts, "BlockRow")
	SignKit.SetBlockCount(row, opts.Count)
	-- (LOOK-ui) whole screen px again whenever the row is laid out anew (a window resized, a Fit changed)
	row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		layFit(row)
	end)
	return row
end

-- a FitBlocks row with `n` blocks (rebuilt; none lit); Fill / FillLip (optional) the lit colours from now on
function SignKit.SetBlockCount(row, n, fillColor, fillLip)
	n = math.max(1, math.floor(tonumber(n) or 10))
	if typeof(fillColor) == "Color3" then
		BLOCK_FILL[row] = { fillColor, typeof(fillLip) == "Color3" and fillLip or fillColor }
	end
	if row:GetAttribute("Count") ~= n or not row:FindFirstChild("Block1") then
		for _, c in ipairs(row:GetChildren()) do
			if c.Name:match("^Block%d+$") then
				c:Destroy()
			end
		end
		row:SetAttribute("Count", n)
		for i = 1, n do
			fitBlock(row, i, row:GetAttribute("EdgePx") or 2, row:GetAttribute("LipPx") or 3)
		end
	end
	layFit(row)
	SignKit.FillBlocks(row, 0)
	return row
end

-- the first k blocks lit (gold, or the row's Fill: face and lip), the rest stone; k is floored and clamped to 0..Count.
-- Returns k
function SignKit.FillBlocks(row, k)
	local n = row:GetAttribute("Count") or 0
	local lit = BLOCK_FILL[row] or { Sign.Gold, Sign.GoldLip }
	k = math.max(0, math.min(n, math.floor(tonumber(k) or 0)))
	for i = 1, n do
		local b = row:FindFirstChild("Block" .. i)
		local face = b and b:FindFirstChild("Face")
		if face then
			local on = i <= k
			face.BackgroundColor3 = on and lit[1] or Sign.Stone
			local lip = face:FindFirstChild("Lip")
			if lip then
				lip.BackgroundColor3 = on and lit[2] or Sign.StoneLip
			end
		end
	end
	row:SetAttribute("Filled", k)
	return k
end

-- (LOOK-ui, kitb-look1: the owner's look bar, one style across screens) the kit's one scroll bar: in the wood, opaque,
-- square ends (Roblox's round end caps swapped for its straight middle piece), Sizes.ScrollBar thick (`thickness`:
-- Sizes.ScrollBarPhone in a phone layout's list, 0 for none). Call again to change the thickness
-- (merge kitb-look1 x kitb-ui2: the two builds of the kit's one bar are one) SignKit.ScrollBar draws it, thickness in px
function SignKit.Scroll(sf, thickness)
	return SignKit.ScrollBar(sf, { Thickness = math.floor(tonumber(thickness) or Z.ScrollBar) })
end

-- opts: Width, Height, Text, TextSize, IconSlot (a square at the left for a PixelIcon)
function SignKit.Notice(parent, opts)
	opts = opts or {}
	local e = Z.NoticeEdge
	local notice = fill("Notice", Sign.Wood, {
		Size = UDim2.fromOffset(tonumber(opts.Width) or 360, tonumber(opts.Height) or 64),
	}, parent)
	local face = fill("Face", Sign.Stone, {
		Position = UDim2.fromOffset(e, e),
		Size = UDim2.new(1, -2 * e, 1, -2 * e),
	}, notice)
	inset(face, e)
	lipOf(fill("Lip", Sign.StoneLip, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, Z.NoticeLip),
	}, face), Z.NoticeLip)
	local x = 12
	if opts.IconSlot then
		local px = 30
		frame("IconSlot", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 10, 0.5, -Z.NoticeLip / 2),
			Size = UDim2.fromOffset(px, px),
			ZIndex = 2,
		}, face)
		x = 10 + px + Z.NoticeGap -- (U5) the text keeps clear of the icon at the phones' 0.8 scale too
	end
	if opts.Text then
		text("Text", opts.Text, "Body", tonumber(opts.TextSize) or 18, Theme.TextOn("Stone"), {
			Position = UDim2.fromOffset(x, 0),
			Size = UDim2.new(1, -(x + 10), 1, -Z.NoticeLip),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 2,
		}, face)
	end
	-- (U9-8 look) its wood edge and lip whole screen px under the scale above it
	local noticeLip = face:FindFirstChild("Lip")
	SignKit.Whole(notice, function(sc)
		local ew = SignKit.Px(e, sc)
		face.Position = UDim2.fromOffset(ew, ew)
		face.Size = UDim2.new(1, -2 * ew, 1, -2 * ew)
		if noticeLip then
			noticeLip.Size = UDim2.new(1, 0, 0, SignKit.Px(Z.NoticeLip, sc))
		end
	end)
	place(notice, opts, "Notice")
	if opts.Finish ~= false then
		-- (Pitch 2 F0) a floating card: the light on its wood edge, its face's lit top band, the card shadow
		SignKit.Bevel(notice, { Px = FIN.Line })
		SignKit.Shine(face)
		SignKit.Shadow(notice, { Px = FIN.Card, Block = true })
	end
	return notice, face
end

-- (Pitch 2 F0 A: "dotted pixel rules", "'ROBUX ITEMS' as a captioned rule"; the mock's sep "dots") a dotted rule: Dot x Dot
-- px dots every Pitch px in `opts.Color` (WellEdge) in a holder `opts.Width` design px wide and Dot tall (attribute SignKit
-- = "Rule", each dot Rule = "Dot"). SignKit.SetRule(rule, w) lays it again at a new width (dots reused)
SignKit.RuleSizes = { Dot = 2, Pitch = 6 }
function SignKit.SetRule(rule, w)
	local R = SignKit.RuleSizes
	w = math.max(0, math.floor((tonumber(w) or 0) + 0.5))
	local n = w >= R.Dot and math.floor((w - R.Dot) / R.Pitch) + 1 or 0
	local dots = {}
	for _, c in ipairs(rule:GetChildren()) do
		if c:GetAttribute("Rule") == "Dot" then
			dots[#dots + 1] = c
		end
	end
	local colour = rule:GetAttribute("RuleColor") or Sign.WellEdge
	for i = 1, math.max(n, #dots) do
		local d = dots[i]
		if i <= n then
			if not d then
				d = fill("Dot", colour, { ZIndex = rule.ZIndex }, rule)
				d:SetAttribute("Rule", "Dot")
			end
			d.Position = UDim2.fromOffset((i - 1) * R.Pitch, 0)
			d.Size = UDim2.fromOffset(R.Dot, R.Dot)
		elseif d then
			d:Destroy()
		end
	end
	rule.Size = UDim2.fromOffset(w, R.Dot)
	return rule
end

-- opts: Width, Color, Position, ZIndex, Name, Visible (the caller's placement, as every part's)
function SignKit.Rule(parent, opts)
	opts = opts or {}
	local rule = frame(opts.Name or "Rule", { ZIndex = tonumber(opts.ZIndex) or 1 }, parent)
	rule:SetAttribute("RuleColor", opts.Color or Sign.WellEdge)
	place(rule, opts, "Rule")
	return SignKit.SetRule(rule, opts.Width)
end

-- (kit-b U9-7, the owner's look bar 2026-11-17: small handmade touches that read as this game) two nail heads on a
-- hanging board's top corners, so a card that hangs on the screen is nailed up, not floating: plain WoodDark squares
-- (opts.Size design px, default 4) opts.Inset px in from the corner (default 6), above the board's face (opts.ZIndex,
-- default one over the board). Returns the two Frames (NailL, NailR; attribute SignKit = "Nail")
function SignKit.Nails(board, opts)
	opts = opts or {}
	local s = math.max(2, math.floor(tonumber(opts.Size) or 4))
	local inset = math.floor(tonumber(opts.Inset) or 6)
	local z = tonumber(opts.ZIndex) or (board.ZIndex + 1)
	local out = {}
	for i, side in ipairs({ 0, 1 }) do
		local nail = fill(i == 1 and "NailL" or "NailR", opts.Color or Sign.WoodDark, {
			AnchorPoint = Vector2.new(side, 0),
			Position = UDim2.new(side, (side == 0) and inset or -inset, 0, inset),
			Size = UDim2.fromOffset(s, s),
			ZIndex = z,
		}, board)
		nail:SetAttribute("SignKit", "Nail")
		-- (U9-8 look) the nail head and its inset whole screen px under the scale above the board (3.2 px at 0.8 before)
		SignKit.Whole(nail, function(sc)
			local at = SignKit.Px(inset, sc)
			nail.Position = UDim2.new(side, (side == 0) and at or -at, 0, at)
			nail.Size = UDim2.fromOffset(SignKit.Px(s, sc), SignKit.Px(s, sc))
		end)
		out[i] = nail
	end
	return out[1], out[2]
end

----------------------------------------------------------------------
-- the sky-climber's rig (sign/logo build: the owner's pick B2, .superpowers/sign-logo-pitch/FINAL_OPTIONS.md "BOARD")
----------------------------------------------------------------------

-- The pitch drew B2 on a 250 px board; every size here is its px times k = the board's width / 250, clamped 1 .. 2 (as the
-- Workshop trim before it). Positions along the board follow its real width.
SignKit.RigSizes = {
	Stripe = 26, -- the canopy's navy stripes ...
	Gap = 14, -- ... and the canvas between them
	Scallop = 20, -- the valance's scallops: 20 wide, dropping 8 in three steps, brass piping under each step
	Drop = 8,
	Pipe = 2,
	PatchW = 16, -- the stitched patch at x 176 of 250
	PatchH = 12,
	PatchAt = 176,
	Stitch = 3,
	Lash = 14, -- a corner lashing's square
	Twist = 6, -- the ropes' twist blocks
	CaraW = 12, -- the carabiner and its open gate
	CaraH = 18,
	Gate = 8,
	Eye = 10, -- the eye-bolt on the canopy's top edge
	Bar = 3, -- the iron's bar
	Prop = 22, -- a propeller's blade, hub and bracket, centred 6 in from each end of the board, 4 above it
	PropW = 6,
	Hub = 6,
	BracketW = 8,
	BracketH = 10,
	PropIn = 6,
	PropUp = 4,
	PlateW = 40, -- the brass version plate on the bottom rail: 13 above the board's foot to 3 below it
	PlateH = 16,
	PlateUp = 13,
	PlateText = 11,
	Hem = 3, -- the canvas body's hem and its 2 px lit top / left
	HemLit = 2,
	Bevel = 2, -- the frame's lit top / left edge, 3 for its shaded bottom / right
	Shade = 3,
	Flip = 0.5, -- the propellers' 2-frame flip
}
local RZ = SignKit.RigSizes

-- one rig piece: a flat Frame stamped SignKit = "Rig", Rig = its kind (Trim = the B2 trim it belongs to)
local function piece(kind, colour, props, parent, trim)
	local f = fill("Rig" .. kind, colour, props, parent)
	f:SetAttribute("SignKit", "Rig")
	f:SetAttribute("Rig", kind)
	if trim then
		f:SetAttribute("Trim", trim)
	end
	return f
end

local function clearRig(parent)
	for _, c in ipairs(parent:GetChildren()) do
		if c:GetAttribute("SignKit") == "Rig" then
			c:Destroy()
		end
	end
end

-- a ring of four iron bars (w x h, bar thick): the eye-bolt, and the carabiner with its open gate on the right
local function ironRing(kind, w, h, bar, colour, dark, gate, z, parent, trim)
	local ring = frame("Rig" .. kind, { Size = UDim2.fromOffset(w, h), ZIndex = z }, parent)
	ring:SetAttribute("SignKit", "Rig")
	ring:SetAttribute("Rig", kind)
	ring:SetAttribute("Trim", trim)
	fill("Top", colour, { Size = UDim2.fromOffset(w, bar), ZIndex = z }, ring)
	fill("Bottom", colour, { Position = UDim2.fromOffset(0, h - bar), Size = UDim2.fromOffset(w, bar), ZIndex = z }, ring)
	fill("Left", colour, { Size = UDim2.fromOffset(bar, h), ZIndex = z }, ring)
	if gate and gate > 0 then
		local top = math.floor((h - gate) / 2)
		fill("Right", dark, { Position = UDim2.fromOffset(w - bar, 0), Size = UDim2.fromOffset(bar, top), ZIndex = z }, ring)
		fill("Right", dark, { Position = UDim2.fromOffset(w - bar, top + gate), Size = UDim2.fromOffset(bar, h - top - gate), ZIndex = z }, ring)
	else
		fill("Right", dark, { Position = UDim2.fromOffset(w - bar, 0), Size = UDim2.fromOffset(bar, h), ZIndex = z }, ring)
	end
	return ring
end

-- the blades of every propeller under root: frame 1 level (wider than tall), 2 upright. A flip swaps the blade's size,
-- never a Rotation (a turned Frame goes soft)
function SignKit.PropFrame(root, n)
	for _, d in ipairs(root:GetDescendants()) do
		if d:GetAttribute("Rig") == "Blade" then
			local long, short = d:GetAttribute("Long"), d:GetAttribute("Short")
			if long and short then
				d.Size = n == 2 and UDim2.fromOffset(short, long) or UDim2.fromOffset(long, short)
			end
		end
	end
	root:SetAttribute("PropFrame", n == 2 and 2 or 1)
end

-- the propellers under root turn (flip every RigSizes.Flip s) while `on`, else rest level. Called again it restarts;
-- the loop ends when root leaves the game
function SignKit.Spin(root, on)
	local gen = (root:GetAttribute("RigSpin") or 0) + 1
	root:SetAttribute("RigSpin", gen)
	SignKit.PropFrame(root, 1)
	if not on then
		return
	end
	task.spawn(function()
		local n = 1
		while true do
			task.wait(RZ.Flip)
			if not root.Parent or root:GetAttribute("RigSpin") ~= gen then
				return
			end
			n = 3 - n
			SignKit.PropFrame(root, n)
		end
	end)
end

-- parts: Board (the board Frame: the ropes, roof, header and frame are laid out in it), Roof (a flat SignKit.Roof),
-- Head (the header), Frame (the wood frame round the body), Ropes (the board's ropes, siblings of the board in its
-- Swing). opts: Width (the board's design width; default the board's), Version ("V6": the brass plate's text; none = no
-- plate). B2 on those parts: the canopy (the roof's face weathered canvas under navy stripes, a navy edge, a scalloped
-- valance with brass piping), a stitched patch on it, the frame's bevel (a lit top / left edge, a shaded bottom / right),
-- rope lashings on its four corners, the canvas body's hem (no seams), the twisted ropes ending in carabiners clipped to
-- eye-bolts on the canopy's top edge, two propellers at the canopy's top corners, the brass version plate on the bottom
-- rail. The five trims (lashings, hang rig, propellers, plate, patch) are B2's limit. Flat Frames in Theme.Sign colours,
-- offset sizes (nothing on the top is stretched or sliced), no glow. Calling it again redraws the rig (a re-layout).
-- Returns the number of pieces
function SignKit.Rig(parts, opts)
	opts = opts or {}
	local board, roof, head, wood = parts.Board, parts.Roof, parts.Head, parts.Frame
	-- (Pitch 2 F0) the rig draws its own approved bevel, canopy and hem (the B2 pick): the kit's finish steps aside on the
	-- parts it rigs
	local function unfinish(obj, names)
		for _, name in ipairs(names) do
			local h = obj and obj:FindFirstChild(name)
			if h then
				h:Destroy()
			end
		end
	end
	unfinish(wood, { "FinishBevel", "FinishShadow" })
	unfinish(wood and wood:FindFirstChild("Body"), { "FinishCarve" })
	unfinish(head, { "FinishBevel" })
	unfinish(head and head:FindFirstChild("Plate"), { "FinishTop" })
	unfinish(roof, { "FinishTrim" })
	local bw = tonumber(opts.Width) or (board and board.Size.X.Offset) or 440
	local bh = board and board.Size.Y.Offset or 0
	local k = math.min(math.max(bw / 250, 1), 2)
	local at = bw / 250 -- a position on the pitch's 250 px board
	local function px(v, least)
		return math.max(least or 1, math.floor(v * k + 0.5))
	end
	local n = 0
	if board then
		clearRig(board)
	end
	-- the canopy: the roof's face canvas, navy stripes across it, its edge and lip navy; the scalloped valance under it
	local roofW, roofH, roofX = 0, 0, 0
	if roof then
		clearRig(roof)
		roofW, roofH = roof.Size.X.Offset, roof.Size.Y.Offset
		roofX = roof.Position.X.Scale * bw + roof.Position.X.Offset - roof.AnchorPoint.X * roofW
		roof.BackgroundColor3 = Sign.NavyLip
		local face = roof:FindFirstChild("Face")
		if face then
			clearRig(face)
			face.BackgroundColor3 = Sign.Canvas
			local lip = face:FindFirstChild("Lip")
			if lip then
				lip.BackgroundColor3 = Sign.NavyLip
			end
			local faceW = roofW - 2 * Z.RoofEdge
			local x = 0
			while x < faceW do
				piece("Stripe", Sign.NavyLight, {
					Position = UDim2.fromOffset(x, 0),
					Size = UDim2.new(0, math.min(px(RZ.Stripe), faceW - x), 1, 0),
					ZIndex = face.ZIndex,
				}, face)
				n = n + 1
				x = x + px(RZ.Stripe) + px(RZ.Gap)
			end
		end
		-- the valance: scallops in the stripe colour above them, each three steps narrower to its foot, brass under each
		-- step's open edge
		local sw, rows, pipe = px(RZ.Scallop, 6), math.max(1, math.floor(px(RZ.Drop) / 3)), px(RZ.Pipe)
		local inset = math.max(1, math.floor(sw / 6))
		local period = px(RZ.Stripe) + px(RZ.Gap)
		local count = math.floor(roofW / sw)
		local x0 = math.floor((roofW - count * sw) / 2)
		for i = 0, count - 1 do
			local x = x0 + i * sw
			local mid = (x + sw / 2 - Z.RoofEdge) % period
			local colour = mid < px(RZ.Stripe) and Sign.NavyLight or Sign.Canvas
			local sc = frame("RigScallop", { Position = UDim2.new(0, x, 1, 0), Size = UDim2.fromOffset(sw, 3 * rows + pipe), ZIndex = roof.ZIndex }, roof)
			sc:SetAttribute("SignKit", "Rig")
			sc:SetAttribute("Rig", "Scallop")
			for r = 0, 2 do
				local cut = r * inset
				fill("Step", colour, { Position = UDim2.fromOffset(cut, r * rows), Size = UDim2.fromOffset(sw - 2 * cut, rows), ZIndex = roof.ZIndex }, sc)
				-- the brass piping under this step's open edge (the whole foot on the last step)
				if r == 2 then
					piece("Piping", Sign.Brass, { Position = UDim2.fromOffset(cut, 3 * rows), Size = UDim2.fromOffset(sw - 2 * cut, pipe), ZIndex = roof.ZIndex }, sc)
				else
					piece("Piping", Sign.Brass, { Position = UDim2.fromOffset(cut, (r + 1) * rows), Size = UDim2.fromOffset(inset, pipe), ZIndex = roof.ZIndex }, sc)
					piece("Piping", Sign.Brass, { Position = UDim2.fromOffset(sw - cut - inset, (r + 1) * rows), Size = UDim2.fromOffset(inset, pipe), ZIndex = roof.ZIndex }, sc)
				end
			end
			n = n + 1
		end
		-- the patch: canvas, four stitches along each long side, at x 176 of 250
		local pw, ph, st = px(RZ.PatchW), px(RZ.PatchH), px(RZ.Stitch, 2)
		local patch = piece("Patch", Sign.Stone, {
			Position = UDim2.fromOffset(math.floor(-roofX + RZ.PatchAt * at - pw / 2), math.floor((roofH - ph) / 2)),
			Size = UDim2.fromOffset(pw, ph),
			ZIndex = roof.ZIndex,
		}, roof, "Patch")
		for i = 0, 3 do
			local sx = math.floor((i + 0.5) * pw / 4 - st / 2)
			fill("Stitch", Sign.Wood, { Position = UDim2.fromOffset(sx, 0), Size = UDim2.fromOffset(st, math.max(1, math.floor(st / 2))), ZIndex = roof.ZIndex }, patch)
			fill("Stitch", Sign.Wood, { Position = UDim2.fromOffset(sx, ph - math.max(1, math.floor(st / 2))), Size = UDim2.fromOffset(st, math.max(1, math.floor(st / 2))), ZIndex = roof.ZIndex }, patch)
		end
		n = n + 1
	end
	-- the frame's bevel: a lit top / left edge, a shaded bottom / right (B1's skeleton under B2)
	for _, part in ipairs({ head, wood }) do
		if part then
			clearRig(part)
			local z = part.ZIndex
			piece("Bevel", Sign.WoodLight, { Size = UDim2.new(0, RZ.Bevel, 1, 0), ZIndex = z }, part)
			piece("Bevel", Sign.WoodDark, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, RZ.Shade, 1, 0), ZIndex = z }, part)
			if part == head then
				piece("Bevel", Sign.WoodLight, { Size = UDim2.new(1, 0, 0, RZ.Bevel), ZIndex = z }, part)
			else
				piece("Bevel", Sign.WoodDark, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, RZ.Shade), ZIndex = z }, part)
			end
			n = n + 4
		end
	end
	-- the canvas body: one sheet, a hem on its top, left and right (its lip is the foot), lit inside the hem; no seams
	local body = wood and wood:FindFirstChild("Body")
	if body then
		clearRig(body)
		local hem, lit = px(RZ.Hem), px(RZ.HemLit)
		piece("Hem", Sign.StoneLip, { Size = UDim2.new(1, 0, 0, hem), ZIndex = 1 }, body)
		piece("Hem", Sign.StoneLip, { Size = UDim2.new(0, hem, 1, 0), ZIndex = 1 }, body)
		piece("Hem", Sign.StoneLip, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, hem, 1, 0), ZIndex = 1 }, body)
		piece("HemLit", Sign.Tile, { Position = UDim2.fromOffset(hem, hem), Size = UDim2.new(1, -2 * hem, 0, lit), ZIndex = 1 }, body)
		piece("HemLit", Sign.Tile, { Position = UDim2.fromOffset(hem, hem), Size = UDim2.new(0, lit, 1, -hem), ZIndex = 1 }, body)
		n = n + 5
	end
	if not board then
		return n
	end
	local z = 5 -- over the roof (3), the header (2) and the logo (4)
	-- the corner lashings: rope wound round each corner of the frame (below the valance at the top), diagonal strands of
	-- rope and its shade over the dark wood
	local ls = px(RZ.Lash, 6)
	local cell = math.max(2, math.floor(ls / 5))
	ls = cell * 5
	local topY = roof and (roof.Position.Y.Offset + roofH + px(RZ.Drop) + px(RZ.Pipe)) or (head and head.Position.Y.Offset or 0)
	for _, c in ipairs({ { 0, topY }, { bw - ls, topY }, { 0, bh - ls }, { bw - ls, bh - ls } }) do
		local lash = piece("Lashing", Sign.WoodDark, { Position = UDim2.fromOffset(c[1], c[2]), Size = UDim2.fromOffset(ls, ls), ZIndex = z }, board, "Lashing")
		for r = 0, 4 do
			for col = 0, 4 do
				local d = (col - r) % 3
				if d < 2 then
					fill("Strand", d == 0 and Sign.Post or Sign.Wood, { Position = UDim2.fromOffset(col * cell, r * cell), Size = UDim2.fromOffset(cell, cell), ZIndex = z }, lash)
				end
			end
		end
		n = n + 1
	end
	-- the hang rig: each rope twisted (wood blocks down its length, its flat shade off), ending in a carabiner clipped to
	-- an eye-bolt on the canopy's top edge
	local bar = px(RZ.Bar, 2)
	local roofTop = roof and roof.Position.Y.Offset or 0
	for _, rope in ipairs(parts.Ropes or {}) do
		clearRig(rope)
		local shade = rope:FindFirstChild("Shade")
		if shade then
			shade.Visible = false
		end
		local tb = px(RZ.Twist, 3)
		local len = rope.Size.Y.Offset
		local y = 0
		while y < len do
			piece("Twist", Sign.Wood, { Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, math.min(tb, len - y)), ZIndex = rope.ZIndex }, rope, "HangRig")
			y = y + 2 * tb
			n = n + 1
		end
		local cx = rope.Position.X.Offset + rope.Size.X.Offset / 2 - board.Position.X.Offset
		local ew, cw, ch = px(RZ.Eye), px(RZ.CaraW), px(RZ.CaraH)
		local eyeY = roofTop - math.floor(ew / 2)
		ironRing("EyeBolt", ew, ew, bar, Sign.IronDark, Sign.IronDark, 0, z, board, "HangRig").Position = UDim2.fromOffset(math.floor(cx - ew / 2), eyeY)
		ironRing("Carabiner", cw, ch, bar, Sign.Iron, Sign.IronDark, px(RZ.Gate), z, board, "HangRig").Position = UDim2.fromOffset(math.floor(cx - cw / 2), eyeY - ch + bar)
		n = n + 2
	end
	-- the propellers: at the canopy's top corners, wooden blades (a darker lower edge) on a brass hub on a bracket
	local long, short, hub = px(RZ.Prop), px(RZ.PropW, 3), px(RZ.Hub, 3)
	local brW, brH = px(RZ.BracketW), px(RZ.BracketH)
	for _, x in ipairs({ RZ.PropIn * at, bw - RZ.PropIn * at }) do
		local cy = roofTop - RZ.PropUp * at
		local prop = frame("RigPropeller", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(cy + 0.5)),
			Size = UDim2.fromOffset(long, long),
			ZIndex = z,
		}, board)
		prop:SetAttribute("SignKit", "Rig")
		prop:SetAttribute("Rig", "Propeller")
		prop:SetAttribute("Trim", "Propeller")
		piece("Bracket", Sign.GoldLip, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(brW, brH), ZIndex = z }, prop)
		local blade = piece("Blade", Sign.Post, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(long, short), ZIndex = z }, prop)
		blade:SetAttribute("Long", long)
		blade:SetAttribute("Short", short)
		fill("Edge", Sign.Wood, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, math.max(1, math.floor(short / 3))), ZIndex = z }, blade)
		piece("Hub", Sign.Brass, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(hub, hub), ZIndex = z }, prop)
		n = n + 1
	end
	-- the version plate: brass on the bottom rail, centred, its rivets at the ends, "V6" in brown
	if opts.Version then
		local w, h = px(RZ.PlateW), px(RZ.PlateH)
		local plate = piece("Plate", Sign.GoldLip, {
			Position = UDim2.fromOffset(math.floor((bw - w) / 2), bh - px(RZ.PlateUp)),
			Size = UDim2.fromOffset(w, h),
			ZIndex = z,
		}, board, "Plate")
		local e = math.max(1, math.floor(k + 0.5))
		local face = fill("Face", Sign.Gold, { Position = UDim2.fromOffset(e, 0), Size = UDim2.new(1, -2 * e, 1, -e), ZIndex = z }, plate)
		fill("Shine", Sign.GoldLight, { Size = UDim2.new(1, 0, 0, math.max(1, math.floor(2 * k / 1.5))), ZIndex = z }, face)
		local rv = px(RZ.Bar, 2)
		for _, rx in ipairs({ e + 1, w - 2 * e - rv - 1 }) do
			fill("Rivet", Sign.GoldLip, { Position = UDim2.fromOffset(rx, math.floor((h - rv) / 2)), Size = UDim2.fromOffset(rv, rv), ZIndex = z }, face)
		end
		local l = text("PlateText", opts.Version, "Tag", math.max(18, px(RZ.PlateText)), Sign.Text, {
			Size = UDim2.fromScale(1, 1),
			ZIndex = z,
		}, face)
		l.TextYAlignment = Enum.TextYAlignment.Center
		n = n + 1
	end
	return n
end

return SignKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1066">
        <Properties>
          <string name="Name">SkyCycle</string>
          <string name="Source"><![CDATA[-- SkyCycle: the living sky's pure phase math and looks (docs/superpowers/specs/2026-10-30-living-sky-cycle-design.md,
-- plan docs/superpowers/plans/2026-10-30-living-sky.md Task 1). The server publishes one epoch / speed / offset (Workspace
-- attributes); every client turns the shared server time into the SAME phase, blend and lighting preset with these
-- functions, so the clock costs no remote traffic and a late joiner lands on the same values as a long-running client.
-- Pure Lua 5.1-compatible syntax; no Instances, no services, no yields, no state between calls.
--
-- API (the contract):
--   SkyCycle.At(serverNow, epoch, speed, offset) -> { Phase, Next, T, Blend, LoopT }
--       loop position = ((serverNow - epoch) x speed + offset) mod the loop (Config.Sky.Cycle: Dawn 120, Day 360,
--       Sunset 540, Night 180 s); T = 0..1 through the phase; Blend = 0 until the last Cycle.Blend (75) s of the phase,
--       then a smoothstep 0 -> 1 toward Next; LoopT = 0..1 through the loop. Junk never errors: a nil / NaN epoch,
--       now or offset = 0, speed clamped to Config.Sky.Speed (0.1..120; NaN / non-number = 1).
--   SkyCycle.Preset(at, eventId, eventBlend, facesFor, fromId, fromBlend) -> preset, themeId
--       preset = LightingStack groups { Lighting, Atmosphere, Clouds, ColorCorrection, Sky } (fresh tables every call):
--       the phase look mixed toward the next one by at.Blend, then toward the raid look Config.Sky.Looks[fromId] by
--       fromBlend (optional: the raid sky that showed when eventId's began, back-to-back raids), then toward the raid
--       look Config.Sky.Looks[eventId] by eventBlend (0..1; an unknown / empty id or a junk blend = no event; fromId =
--       eventId is ignored). So eventBlend 0 with fromId = the old raid at fromBlend 1 is exactly the old raid sky and
--       a new raid never flashes back toward the cycle. Numbers lerp, Color3 :Lerp; integers (StarCount), strings and
--       booleans switch at blend >= 0.5. ClockTime walks the phase's Clock range { from, to } with T on an UNWRAPPED
--       clock (to may pass 24: Night { 18.9, 31 } runs through midnight to 7 h next morning), always forward; in the
--       phase's blend window it crosses the gap to the next phase's start (the first from + 24k at or after to: only
--       Sunset 17 -> Night 18.9; Dawn -> Day, Day -> Sunset and Night 31 -> Dawn 7 meet already). P2 F11 C, the quick
--       sunset: behind a haze bridge with Config.Sky.Cycle.GapWalk set it walks on to GapWalk (0.2) h past the phase's
--       end (17.2 h) by the step and is the next phase's start from the step, (Cycle.Refresh + Cycle.Tween) / 2 = 2 s
--       before the bridge peak (blend 0.5, the skybox swap), so the client's 2 s tween of it lies in the peak +- 2 s
--       under the cloud curtain and the engine sun is never on the horizon on screen (the old even walk 17 -> 18.4 h lit
--       the island red through the air);
--       GapWalk nil or no bridge = walked evenly across the blend. The returned ClockTime is that clock mod 24 ([0, 24)), so
--       over a whole loop it only ever moves forward round the dial (SkyCycle.ClockDelta), wrapping 24 -> 0 once, in
--       the Night. A raid switches it to its look's fixed Clock at its blend >= 0.5 (fromId's first, then eventId's).
--       themeId =
--       Config.Sky.Themes[phase] (Themes[Next] from Blend 0.5, the skybox swap while the haze is thickest),
--       RaidThemes[fromId] from fromBlend 0.5, RaidThemes[eventId] from eventBlend 0.5. facesFor(themeId) (SkyFaces.For)
--       -> { SkyboxBk = id, ... } adds the Skybox* strings to the Sky group; nil / no facesFor = no Skybox keys, so the
--       Sky keeps what LightingService set at boot. The result is passed through Floor.
--       The haze bridge (kit-b S1, Config.Sky.Transitions): each layer whose skybox differs from the one under it (the
--       phase change when Themes[phase] ~= Themes[Next]; each raid layer) thickens by k = Bridge(its blend, its
--       BridgeHalf): Atmosphere Density / Haze and Clouds Cover rise toward the transition's peaks, Glare toward 0,
--       Atmosphere Color / Decay toward the bridge colour (Config.Sky.Bridge["<theme>><theme>"] for a phase change, the
--       raid look's Decay for a raid). The swaps above all sit at blend 0.5, the bridge's peak (k = 1), so they happen
--       behind the thickest air; a layer mixed over by a later one takes its haze with it (a full raid sky shows no
--       cycle bridge)
--       The staged looks (kit-b S4, read at every call): with Config.Preview.SkyAir a phase look's Atmosphere Color / Decay
--       are Config.Sky.AirV2[phase]'s (under the painted skies only Color shows: Decay needs Glare above 0), with
--       ThinClouds every look's resting Clouds Cover / Density are capped at Config.Sky.CloudsV2 and the bridge lifts
--       both back toward its peaks (Cover, CloudDensity). Both off: the looks exactly as written
--   SkyCycle.Bridge(blend, half) -> k   0 outside |blend - 0.5| < half, a smoothstep up to 1 at blend 0.5, symmetric;
--       junk / half <= 0 = 0
--   SkyCycle.Floor(preset) -> preset   the readability floor, in place: Lighting.Brightness >= Floor.Brightness (1.0),
--       every OutdoorAmbient channel >= Floor.OutdoorAmbientMin (70) / 255, every ColorCorrection TintColor channel
--       within Floor.TintMax (8) / 255 of white (the colour comes from the world light, never a screen tint).
--   SkyCycle.Integer = { StarCount = true }   the whole-number properties: switched here, never lerped, and set at
--       once by client/LightingStack (never tweened through fractions)
--   SkyCycle.ClockDelta(from, to) -> hours in [-12, 12)   the step from one ClockTime to another round the 24 h dial
--       (23.9 -> 0.1 = +0.2: 24 h and 0 h are the same sun position)
-- at.Phase / at.Next are checked against Config.Sky.Cycle.Order (a raid boss id is a Looks key, never a phase).
-- The cycle's clock never jumps: every 2 s refresh step is a small forward step round the dial (Night, the fastest:
-- 12.1 h in 180 s = 0.13 h per 2 s), save the quick sunset's one step 2 s before the Sunset -> Night bridge peak
-- (17.2 -> 18.9 h), which stays inside the Sunset segment, so SkyController tweens it over one refresh behind the cloud
-- curtain, done by 2 s after the peak (P2 F11 C). Client SkyController sets ClockTime at once only (a) when it passes midnight
-- (23.9 -> 0.1: a tween would run backwards through the day; the set is invisible, 24 h = 0 h, and only one refresh
-- step long) and (b) at a raid sky's mid-blend (its fixed clock, a step of more than Config.Sky.ClockJump h).

local Shared = script.Parent
local Config = require(Shared.Config)

local SkyCycle = {}

local floor, max, min = math.floor, math.max, math.min

-- the groups a preset carries, in a fixed order (deterministic output; LightingStack ignores the rest)
local GROUPS = { "Lighting", "Atmosphere", "Clouds", "ColorCorrection", "Sky" }
-- whole-number properties: set at once, never tweened or lerped
local INTEGER = { StarCount = true }
SkyCycle.Integer = INTEGER

local function cfg()
	return Config.Sky
end

local function finite(v)
	return type(v) == "number" and v == v and v ~= math.huge and v ~= -math.huge
end

-- a finite number, else `default`
local function num(v, default)
	if finite(v) then
		return v
	end
	return default
end

local function clamp(v, lo, hi)
	return max(lo, min(hi, v))
end

-- speed: NaN / non-number = the default, inf / huge / negative clamped into [Min, Max]
local function cleanSpeed(speed)
	local s = cfg().Speed
	if type(speed) ~= "number" or speed ~= speed then
		return s.Default
	end
	return clamp(speed, s.Min, s.Max)
end

function SkyCycle.At(serverNow, epoch, speed, offset)
	local cycle = cfg().Cycle
	local order, seconds = cycle.Order, cycle.Seconds
	local loop = 0
	for _, phase in ipairs(order) do
		loop = loop + seconds[phase]
	end
	local elapsed = (num(serverNow, 0) - num(epoch, 0)) * cleanSpeed(speed) + num(offset, 0)
	if not finite(elapsed) then
		elapsed = 0
	end
	local pos = elapsed - floor(elapsed / loop) * loop
	if pos < 0 or pos >= loop then
		pos = 0 -- float edge of the modulo
	end
	local start = 0
	for i, phase in ipairs(order) do
		local len = seconds[phase]
		if pos < start + len or i == #order then
			local into = clamp(pos - start, 0, len)
			local window = min(cycle.Blend, len)
			local left = len - into
			local blend = 0
			if left < window then
				local x = (window - left) / window
				blend = x * x * (3 - 2 * x)
			end
			local t = into / len
			if t >= 1 then
				t = 1 - 1e-9
			end
			return { Phase = phase, Next = order[i % #order + 1], T = t, Blend = blend, LoopT = pos / loop }
		end
		start = start + len
	end
	return { Phase = order[1], Next = order[2], T = 0, Blend = 0, LoopT = 0 }
end

local function copyLook(look)
	local out = {}
	for _, group in ipairs(GROUPS) do
		local props = {}
		for prop, v in pairs(look[group] or {}) do
			props[prop] = v
		end
		out[group] = props
	end
	return out
end

-- Config.Sky.CloudsV2 while Config.Preview.ThinClouds is on, else nil
local function thinClouds()
	local preview = type(Config.Preview) == "table" and Config.Preview or {}
	local thin = preview.ThinClouds == true and cfg().CloudsV2 or nil
	return type(thin) == "table" and thin or nil
end

-- a look by its Looks key, copied, with the staged kit-b S4 looks on top while their switch is on:
-- Config.Preview.SkyAir = the phase's Config.Sky.AirV2 Atmosphere Color / Decay (a raid look has none), ThinClouds = the
-- Clouds Cover / Density capped at Config.Sky.CloudsV2. Both off = exactly copyLook (the presets do not change)
local function lookOf(id)
	local sky = cfg()
	local out = copyLook(sky.Looks[id])
	local preview = type(Config.Preview) == "table" and Config.Preview or {}
	local air = preview.SkyAir == true and type(sky.AirV2) == "table" and sky.AirV2[id] or nil
	if type(air) == "table" then
		for _, prop in ipairs({ "Color", "Decay" }) do
			if typeof(air[prop]) == "Color3" then
				out.Atmosphere[prop] = air[prop]
			end
		end
	end
	local thin = thinClouds()
	if thin then
		for _, prop in ipairs({ "Cover", "Density" }) do
			if type(out.Clouds[prop]) == "number" and finite(thin[prop]) then
				out.Clouds[prop] = min(out.Clouds[prop], thin[prop])
			end
		end
	end
	return out
end

-- one property between a and b at t (0..1)
local function mixValue(prop, a, b, t)
	if a == nil then
		return b
	elseif b == nil then
		return a
	end
	if type(a) == "number" and type(b) == "number" and not INTEGER[prop] then
		return a + (b - a) * t
	end
	if typeof(a) == "Color3" and typeof(b) == "Color3" then
		return a:Lerp(b, t)
	end
	if t >= 0.5 then
		return b
	end
	return a
end

-- a fresh preset between two (copied) looks; t = 0 is exactly a, 1 exactly b
local function mix(a, b, t)
	local out = {}
	for _, group in ipairs(GROUPS) do
		local ga, gb = a[group] or {}, b[group] or {}
		local props = {}
		for prop, v in pairs(ga) do
			props[prop] = mixValue(prop, v, gb[prop], t)
		end
		for prop, v in pairs(gb) do
			if ga[prop] == nil then
				props[prop] = v
			end
		end
		out[group] = props
	end
	return out
end

local DAY = 24

-- a clock on the 24 h dial: [0, 24)
local function dial(c)
	local d = c - floor(c / DAY) * DAY
	if d < 0 or d >= DAY then
		d = 0
	end
	return d
end

function SkyCycle.ClockDelta(from, to)
	if not (finite(from) and finite(to)) then
		return 0
	end
	local d = dial(to - from + DAY / 2) - DAY / 2
	return d
end

-- the phase's (unwrapped) clock at T: Clock = { from, to }, walked linearly (a fixed clock when from == to)
local function clockAt(look, t)
	local c = look.Clock
	if type(c) ~= "table" then
		return nil
	end
	return c[1] + (c[2] - c[1]) * t
end

function SkyCycle.Floor(preset)
	local f = cfg().Floor
	local L = preset.Lighting
	if type(L) == "table" then
		if type(L.Brightness) == "number" then
			L.Brightness = max(L.Brightness, f.Brightness)
		end
		local oa = L.OutdoorAmbient
		if typeof(oa) == "Color3" then
			local m = f.OutdoorAmbientMin / 255
			L.OutdoorAmbient = Color3.new(max(oa.R, m), max(oa.G, m), max(oa.B, m))
		end
	end
	local cc = preset.ColorCorrection
	if type(cc) == "table" and typeof(cc.TintColor) == "Color3" then
		local m = 1 - (f.TintMax or 8) / 255
		local tc = cc.TintColor
		cc.TintColor = Color3.new(max(tc.R, m), max(tc.G, m), max(tc.B, m))
	end
	return preset
end

function SkyCycle.Bridge(blend, half)
	if not (finite(blend) and finite(half)) or half <= 0 then
		return 0
	end
	local x = 1 - math.abs(blend - 0.5) / half
	if x <= 0 then
		return 0
	elseif x >= 1 then
		return 1
	end
	return x * x * (3 - 2 * x)
end

-- v lifted toward peak by k (0..1); a value already past the peak stays
local function toward(v, peak, k)
	if type(v) ~= "number" or not finite(peak) then
		return v
	end
	return v + (max(v, peak) - v) * k
end

-- the haze bridge on a (fresh) preset, in place: tr = a Config.Sky.Transitions entry, colors = { Color, Decay } or nil
local function bridgeOn(preset, k, tr, colors)
	if not (k > 0 and type(tr) == "table") then
		return
	end
	local atm = preset.Atmosphere
	if type(atm) == "table" then
		atm.Density = toward(atm.Density, tr.Density, k)
		atm.Haze = toward(atm.Haze, tr.Haze, k)
		if type(atm.Glare) == "number" then
			atm.Glare = atm.Glare * (1 - k)
		end
		if type(colors) == "table" then
			for _, prop in ipairs({ "Color", "Decay" }) do
				if typeof(atm[prop]) == "Color3" and typeof(colors[prop]) == "Color3" then
					atm[prop] = atm[prop]:Lerp(colors[prop], k)
				end
			end
		end
	end
	local clouds = preset.Clouds
	if type(clouds) == "table" and type(clouds.Cover) == "number" then
		clouds.Cover = min(1, toward(clouds.Cover, tr.Cover, k))
	end
	-- the thin deck (ThinClouds) rests at Density 0.3: the bridge lifts it back toward the deck S1 was tuned on, since
	-- Atmosphere Density does not veil the skybox itself. Off: the looks keep their own deck (S1's presets, unchanged)
	if thinClouds() and type(clouds) == "table" and type(clouds.Density) == "number" then
		clouds.Density = min(1, toward(clouds.Density, tr.CloudDensity, k))
	end
end

-- (P2 F11 C look review) the blend at which the quick sunset steps: (Cycle.Refresh + Cycle.Tween) / 2 s before the bridge
-- peak (blend 0.5). SkyController sends the step at its first refresh from then and tweens it over Tween s, so on screen
-- it starts and ends inside the peak +- (Refresh + Tween) / 2 s (2 + 2 s: the bridge's middle 4 s, k >= 0.94, Cover
-- >= 0.92) whatever the client's refresh phase; stepping AT the peak let that tween end up to 4 s after it (k 0.81).
-- The blend is At's smoothstep of the window's time
local function stepBlend(cycle, phase)
	local window = min(num(cycle.Blend, 0), num(type(cycle.Seconds) == "table" and cycle.Seconds[phase], 0))
	if not (window > 0) then
		return 0.5
	end
	local x = clamp(0.5 - (num(cycle.Refresh, 0) + num(cycle.Tween, 0)) / 2 / window, 0, 0.5)
	return x * x * (3 - 2 * x)
end

function SkyCycle.Preset(at, eventId, eventBlend, facesFor, fromId, fromBlend)
	local sky = cfg()
	local order, looks = sky.Cycle.Order, sky.Looks
	at = type(at) == "table" and at or {}
	local isPhase = {}
	for _, name in ipairs(order) do
		isPhase[name] = looks[name] ~= nil
	end
	local phase = isPhase[at.Phase] and at.Phase or order[1]
	local nextPhase = isPhase[at.Next] and at.Next or phase
	local blend = clamp(num(at.Blend, 0), 0, 1)
	local t = clamp(num(at.T, 0), 0, 1)

	local preset = mix(lookOf(phase), lookOf(nextPhase), blend)
	local theme = sky.Themes[blend >= 0.5 and nextPhase or phase]
	local tr = type(sky.Transitions) == "table" and sky.Transitions or {}
	local themeA, themeB = sky.Themes[phase], sky.Themes[nextPhase]
	local bridged = themeA ~= themeB and type(tr.Cycle) == "table"

	local clock = clockAt(looks[phase], t)
	local range = looks[phase].Clock
	if clock and blend > 0 and nextPhase ~= phase and type(range) == "table" then
		-- the gap to the next phase's start (unwrapped: the first from + 24k at or after this phase's end); monotonic,
		-- the clock only gains. Behind a haze bridge with Cycle.GapWalk set (P2 F11 C, the quick sunset) it walks on from
		-- the phase's own walk to GapWalk h past the phase's end (the Sunset: 17 + 0.2 = 17.2 h) by the step, and is the
		-- next phase's start from the step (stepBlend: 2 s before the bridge peak, so the client's 2 s tween of it is
		-- over by 2 s after the peak, under the cloud curtain), so the engine sun never crosses the horizon on screen;
		-- else it is walked evenly across the blend
		local to, nextFrom = range[2], clockAt(looks[nextPhase], 0)
		if finite(to) and finite(nextFrom) then
			nextFrom = nextFrom + math.ceil((to - nextFrom - 1e-9) / DAY) * DAY
			local gap, lead = nextFrom - to, sky.Cycle.GapWalk
			if bridged and gap > 0 and finite(lead) and lead >= 0 then
				local stepAt = stepBlend(sky.Cycle, phase)
				if blend >= stepAt then
					clock = nextFrom
				else
					clock = clock + (max(clock, to + min(lead, gap)) - clock) * blend / stepAt
				end
			else
				clock = clock + gap * blend
			end
		end
	end
	preset.Lighting.ClockTime = clock and dial(clock) or nil

	-- the phase change's bridge (only when the skybox changes: no swap, nothing to hide)
	if bridged then
		local pair = type(sky.Bridge) == "table" and sky.Bridge[tostring(themeA) .. ">" .. tostring(themeB)] or nil
		bridgeOn(preset, SkyCycle.Bridge(blend, tr.Cycle.BridgeHalf), tr.Cycle, pair)
	end

	-- the raid sky that showed when this one began (back-to-back raids), then this raid sky on top
	local function raidOn(id, b)
		local look = type(id) == "string" and sky.RaidThemes[id] and looks[id] or nil
		b = clamp(num(b, 0), 0, 1)
		if look and b > 0 then
			local under = theme
			preset = mix(preset, lookOf(id), b)
			if sky.RaidThemes[id] ~= under and type(tr.Raid) == "table" then
				local decay = look.Atmosphere and look.Atmosphere.Decay
				bridgeOn(preset, SkyCycle.Bridge(b, tr.Raid.BridgeHalf), tr.Raid, { Color = decay, Decay = decay })
			end
			if b >= 0.5 then
				local fixed = clockAt(look, 0)
				preset.Lighting.ClockTime = fixed and dial(fixed) or nil
				theme = sky.RaidThemes[id]
			end
		end
	end
	if fromId ~= eventId then
		raidOn(fromId, fromBlend)
	end
	raidOn(eventId, eventBlend)

	local faces = type(facesFor) == "function" and facesFor(theme) or nil
	if type(faces) == "table" then
		for key, id in pairs(faces) do
			if type(key) == "string" and key:sub(1, 6) == "Skybox" and type(id) == "string" then
				preset.Sky[key] = id
			end
		end
		-- the painted skies carry their own sun / moon / black sun: the engine's would be a second one on top. Its disc
		-- goes, and so do the Atmosphere glare and the sun rays, which glow at the engine sun even with the disc hidden
		-- (checked in Studio 2026-10-30: a bright second "sun" next to the painted one until both were 0)
		preset.Sky.CelestialBodiesShown = false
		preset.Atmosphere = preset.Atmosphere or {}
		preset.Atmosphere.Glare = 0
		preset.SunRays = { Intensity = 0 }
	end
	return SkyCycle.Floor(preset), theme
end

return SkyCycle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1067">
        <Properties>
          <string name="Name">SkyFaces</string>
          <string name="Source"><![CDATA[-- SkyFaces: the living sky's painted skybox faces (plan docs/superpowers/plans/2026-10-30-living-sky.md Task 3). The
-- 7 themes of Config.Sky.Themes / RaidThemes (blender/sky/sky_themes.py, 1024 px faces) are Image assets in shared/
-- TextureIds under "sky_<theme>_<Face>" (blender/sky/build_sky_manifest.py indexes them, tools/upload_assets.py
-- --textures uploads them from the owner's keyed session and writes TextureIds). Until all six of a theme are there the
-- theme counts as missing: SkyCycle.Preset then carries no Skybox* keys and the Sky keeps LightingService's boot faces,
-- so a half-uploaded theme never shows a grey face. Pure Lua 5.1-compatible syntax; no Instances, no state.
--
-- API (the contract):
--   SkyFaces.For(themeId [, ids]) -> { SkyboxBk = "rbxassetid://<id>", ... the six } | nil (face Lf -> SkyboxRt and
--       Rt -> SkyboxLf: see SLOT)
--       nil unless all six ids[Keys(themeId)] are positive whole numbers (Image ids). ids = shared/TextureIds (tests
--       pass their own table). A fresh table every call.
--   SkyFaces.Keys(themeId) -> { "sky_<theme>_Bk", "_Dn", "_Ft", "_Lf", "_Rt", "_Up" } ({} for a junk theme id)
--   SkyFaces.Faces = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" } (the Roblox face names, the Sky's Skybox<Face> order)

local Shared = script.Parent
local TextureIds = require(Shared.TextureIds)

local SkyFaces = {}

local FACES = { "Bk", "Dn", "Ft", "Lf", "Rt", "Up" }
SkyFaces.Faces = FACES
-- the Sky property each rendered face goes to. sky_themes.py renders Lf looking -X and Rt looking +X, but Roblox
-- draws SkyboxRt on the -X side and SkyboxLf on the +X side (checked in Studio 2026-10-30: with the faces as rendered
-- every side corner showed a hard edge, swapped they join seamlessly), so the two side faces trade slots here.
local SLOT = { Bk = "SkyboxBk", Dn = "SkyboxDn", Ft = "SkyboxFt", Lf = "SkyboxRt", Rt = "SkyboxLf", Up = "SkyboxUp" }
SkyFaces.Slot = SLOT

local function validTheme(themeId)
	return type(themeId) == "string" and themeId ~= ""
end

-- an Image id: a finite, positive whole number (0 / NaN / a string = not uploaded)
local function validId(v)
	return type(v) == "number" and v == v and v > 0 and v ~= math.huge and v == math.floor(v)
end

function SkyFaces.Keys(themeId)
	local out = {}
	if validTheme(themeId) then
		for i, face in ipairs(FACES) do
			out[i] = "sky_" .. themeId .. "_" .. face
		end
	end
	return out
end

function SkyFaces.For(themeId, ids)
	if not validTheme(themeId) then
		return nil
	end
	ids = type(ids) == "table" and ids or TextureIds
	local out = {}
	for i, key in ipairs(SkyFaces.Keys(themeId)) do
		local id = ids[key]
		if not validId(id) then
			return nil
		end
		local digits = string.format("%.0f", id) -- a 15-digit id printed whole (tostring may give 1.4e+14 off Roblox)
		out[SLOT[FACES[i]]] = "rbxassetid://" .. digits
	end
	return out
end

return SkyFaces
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1068">
        <Properties>
          <string name="Name">StoreCatalog</string>
          <string name="Source"><![CDATA[-- StoreCatalog: the Robux Store's catalog (docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.1 / 5.4; the
-- store plan, Task 4): the ONE product / pass lookup over Config.Store.Items AND Config.Gems.Products, the "Gets you:"
-- lines of a grant, and Validate. Pure data + logic: no Instances, safe on server and client (GemService routes every
-- receipt through ProductById -> StoreService.ApplyGrant; ShopController draws List). Config.Store.Items,
-- Config.Gems.Products and Config.Store.GemItems (the items bought with gems, lobby shop 2026-11-07: GemItems / GemItem,
-- StoreService.BuyWithGems) are read on EVERY call (the owner pastes ids; tests change them). PetCatalog is required lazily
-- (only Validate and GrantLines touch it), so List / Item / ProductById / PassById stay cheap on the client and in the
-- sims. Plain Lua 5.1-compatible syntax only.
--
-- API
--   StoreCatalog.Tabs                    a copy of Config.Store.Tabs (lobby-shop 16.3: Eggs, Gems, Packs, Passes, Boosts)
--   StoreCatalog.Enabled() -> bool       the Store switch (release step 1): Config.Store.Enabled == true, read on every call
--   StoreCatalog.OnSale(item) -> bool    may this List item be shown and prompted: a gem pack always, any other item only
--                                        while Enabled() (the grant path never asks: a paid receipt is always granted)
--   StoreCatalog.ShownTabs() -> { tab... }  the rail: every tab while Enabled(); else Eggs, plus Gems while a gem pack has
--                                        an Id > 0
--   StoreCatalog.List() -> { item... }   every Config.Store.Items entry with Enabled ~= false as a cleaned copy
--                                        { Key, Kind, Tab, Id (whole, >= 0), Robux, Name, Grants (by reference), Once,
--                                        Hero, Line, Created = Id > 0 }, in Config order, then one item per
--                                        Config.Gems.Products entry: { Key = "Gems<i>", Kind = "Product", Tab = "Gems",
--                                        Id, Robux (the suggested price, lobby-shop 16.1), Name, Grants = { Gems }, Gem =
--                                        true, Index = i, Hero = (i == 3: the Chest is the Gems hero, lobby-shop 16.3), Created }
--   StoreCatalog.Item(key) -> item | nil        a List item by Key (an Enabled = false entry answers nil)
--   StoreCatalog.ProductById(id) -> item | nil  Kind "Product" with Id == id > 0, the first match; the gem packs included;
--                                        a disabled entry still resolves (a paid receipt is never eaten; it is only
--                                        never LISTED or sold: Item answers nil for it)
--   StoreCatalog.PassById(id) -> item | nil     likewise for Kind "Pass"
--   StoreCatalog.Created(item) -> bool   the item's Id is > 0 (a Config entry or a List item)
--   StoreCatalog.Perk(name) -> table | nil      Config.Store.Perks[name] ({ Cash = 2 } / { PetXp = 2 } / ...)
--   StoreCatalog.GrantLines(grants) -> { string... }   the literal "Gets you:" lines in the order Pets, Cash, Tokens,
--                                        Gems, Boost, Perks: "1x Storm Tabby (Lv 5)" (no "(Lv n)" without a Level),
--                                        "$1,000 Cash", "5,000 Cloud Tokens", "550 Gems", "1 h x2 Pet XP" (3600 -> "1 h",
--                                        10800 -> "3 h", else "<n> min"), "x2 Cash forever" / "x2 Pet XP forever" /
--                                        "x1.5 Pet XP in Dungeons and raids" / "VIP: x2 daily Cash and Tokens, [VIP] in chat"
--   StoreCatalog.GemItems() -> { { Key, Gems, Name, Grants }... }   (lobby shop, spec 5.3 / 5.8) every Config.Store.GemItems
--                                        entry as a copy (its Grants a deep copy), in Config order: the items bought with
--                                        gems through StoreRequest("GemBuy", key) (StoreService.BuyWithGems)
--   StoreCatalog.GemItem(key) -> item | nil     a GemItems copy by Key (never a Robux item: Item never answers a gem item)
--   StoreCatalog.Validate() -> ok, problems     keys unique and non-empty; every Id > 0 unique across the items AND the
--                                        gem products; Kind Product | Pass; Tab in Tabs; Once / Boost / Pets / Cash /
--                                        Tokens / Gems only on Products (a Pass grants Perks only); whole numbers: Cash
--                                        1..1e9, Tokens 1..1e7, Gems 1..1e7, Boost.XpPotion 60..Potion.CapSeconds; every
--                                        Pets key a PetCatalog id with Count 1..MaxPerStack and Level 1..MaxPetLevel();
--                                        every Perks name in Config.Store.Perks; Robux a whole number >= 0 when present;
--                                        at most one Hero per tab among the Config items; the Cash packs carry Line;
--                                        every GemItems entry: a Key unique among them AND the Store items, Gems a whole
--                                        number 1..1e7, a Name, Grants = { Boost = { XpPotion = 60..Potion.CapSeconds } } only

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local StoreCatalog = {}

local PERK_LINES = {
	CashX2 = "x2 Cash forever",
	XpX2 = "x2 Pet XP forever",
	ProXp = "x1.5 Pet XP in Dungeons and raids",
	Vip = "VIP: x2 daily Cash and Tokens, [VIP] in chat",
}
local LIMITS = { Cash = 1e9, Tokens = 1e7, Gems = 1e7 } -- the largest whole grant of each currency
local MIN_POTION_SECONDS = 60
local GRANT_KEYS = { Pets = true, Cash = true, Tokens = true, Gems = true, Boost = true, Perks = true }
local GEM_HERO_INDEX = 3 -- lobby-shop 16.3: the Chest of Gems is the Gems tab's hero (the A mock)

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------

-- PetCatalog, required on first use only (GemService's getCatalog shape): Validate and GrantLines need it, nothing else does
local petCatalogRef, petCatalogTried = nil, false
local function getPetCatalog()
	if not petCatalogTried then
		petCatalogTried = true
		local ok, result = pcall(function()
			return require(script.Parent.PetCatalog)
		end)
		if ok and type(result) == "table" then
			petCatalogRef = result
		end
	end
	return petCatalogRef
end

local function isWhole(n)
	return type(n) == "number" and n == n and n ~= math.huge and n ~= -math.huge and n == math.floor(n)
end

local function store()
	return type(Config.Store) == "table" and Config.Store or {}
end

local function configItems()
	local s = store()
	return type(s.Items) == "table" and s.Items or {}
end

local function gemProducts()
	local gems = Config.Gems
	return type(gems) == "table" and type(gems.Products) == "table" and gems.Products or {}
end

-- Config.Store.GemItems (lobby shop), read on every call like the other lists
local function gemItems()
	local s = store()
	return type(s.GemItems) == "table" and s.GemItems or {}
end

local function deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local out = {}
	for k, v in pairs(t) do
		out[k] = deepCopy(v)
	end
	return out
end

local function cleanId(id)
	if isWhole(id) and id >= 0 then
		return id
	end
	return 0
end

-- a Config entry as a List item (the Grants table by reference: GrantLines and the services read it as written)
local function cleanItem(entry)
	local id = cleanId(entry.Id)
	return {
		Key = entry.Key,
		Kind = entry.Kind,
		Tab = entry.Tab,
		Id = id,
		Robux = entry.Robux,
		Name = entry.Name,
		Grants = entry.Grants,
		Once = entry.Once == true or nil,
		Hero = entry.Hero == true or nil,
		Line = entry.Line,
		Created = id > 0,
	}
end

local function gemItem(index, product)
	local id = cleanId(product.Id)
	return {
		Key = "Gems" .. tostring(index),
		Kind = "Product",
		Tab = "Gems",
		Id = id,
		Robux = product.Robux,
		Name = product.Name,
		Grants = { Gems = product.Gems },
		Gem = true,
		Index = index,
		Hero = index == GEM_HERO_INDEX,
		Created = id > 0,
	}
end

-- every item of both lists, the disabled Config entries included when `all` is true (the id lookups of a paid receipt)
local function allItems(all)
	local out = {}
	for _, entry in ipairs(configItems()) do
		if type(entry) == "table" and (all or entry.Enabled ~= false) then
			out[#out + 1] = cleanItem(entry)
		end
	end
	for index, product in ipairs(gemProducts()) do
		if type(product) == "table" then
			out[#out + 1] = gemItem(index, product)
		end
	end
	return out
end

local function byId(kind, id)
	if not isWhole(id) or id <= 0 then
		return nil
	end
	for _, item in ipairs(allItems(true)) do
		if item.Kind == kind and item.Id == id then
			return item
		end
	end
	return nil
end

local function durationText(seconds)
	if seconds % 3600 == 0 then
		return string.format("%d h", seconds / 3600)
	end
	return string.format("%d min", math.floor(seconds / 60))
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

StoreCatalog.Tabs = {}
for i, tab in ipairs(store().Tabs or {}) do
	StoreCatalog.Tabs[i] = tab
end

-- The Store switch (release step 1): Config.Store.Enabled, read on every call. Only an explicit true is ON (a missing
-- line is off: fail closed). It decides what is SHOWN and PROMPTED, never what is GRANTED: List / Item / ProductById /
-- PassById are untouched, so a paid receipt and an owned pass resolve exactly as before.
function StoreCatalog.Enabled()
	return store().Enabled == true
end

-- May this List item be shown and prompted now? A gem pack (item.Gem: Config.Gems.Products, what the live game already
-- sold) always; every Config.Store.Items entry only while the Store is on.
function StoreCatalog.OnSale(item)
	return type(item) == "table" and (item.Gem == true or StoreCatalog.Enabled())
end

-- The Shop rail's tabs, in order. On: every Config.Store.Tabs entry. Off: "Eggs" (not the Store's), plus "Gems" while
-- a gem pack is created (Id > 0): no empty tab, no dead button.
function StoreCatalog.ShownTabs()
	local out = {}
	if StoreCatalog.Enabled() then
		for i, tab in ipairs(store().Tabs or {}) do
			out[i] = tab
		end
		return out
	end
	out[1] = "Eggs"
	for _, product in ipairs(gemProducts()) do
		if type(product) == "table" and cleanId(product.Id) > 0 then
			out[2] = "Gems"
			break
		end
	end
	return out
end

function StoreCatalog.List()
	return allItems(false)
end

function StoreCatalog.Item(key)
	if type(key) ~= "string" then
		return nil
	end
	for _, item in ipairs(allItems(false)) do
		if item.Key == key then
			return item
		end
	end
	return nil
end

function StoreCatalog.ProductById(id)
	return byId("Product", id)
end

function StoreCatalog.PassById(id)
	return byId("Pass", id)
end

function StoreCatalog.Created(item)
	return type(item) == "table" and isWhole(item.Id) and item.Id > 0
end

function StoreCatalog.GemItems()
	local out = {}
	for _, entry in ipairs(gemItems()) do
		if type(entry) == "table" then
			out[#out + 1] = { Key = entry.Key, Gems = entry.Gems, Name = entry.Name, Grants = deepCopy(entry.Grants) }
		end
	end
	return out
end

function StoreCatalog.GemItem(key)
	if type(key) ~= "string" then
		return nil
	end
	for _, item in ipairs(StoreCatalog.GemItems()) do
		if item.Key == key then
			return item
		end
	end
	return nil
end

function StoreCatalog.Perk(name)
	local perks = store().Perks
	if type(name) ~= "string" or type(perks) ~= "table" then
		return nil
	end
	local perk = perks[name]
	return type(perk) == "table" and perk or nil
end

function StoreCatalog.GrantLines(grants)
	local out = {}
	if type(grants) ~= "table" then
		return out
	end
	if type(grants.Pets) == "table" then
		local ids = {}
		for petId in pairs(grants.Pets) do
			ids[#ids + 1] = tostring(petId)
		end
		table.sort(ids)
		local pc = getPetCatalog()
		for _, petId in ipairs(ids) do
			local spec = grants.Pets[petId]
			local def = pc and type(pc.Get) == "function" and pc.Get(petId) or nil
			local name = (def and type(def.Name) == "string") and def.Name or petId
			local count = type(spec) == "table" and tonumber(spec.Count) or 1
			local level = type(spec) == "table" and tonumber(spec.Level) or nil
			out[#out + 1] = string.format("%dx %s", count, name) .. (level and string.format(" (Lv %d)", level) or "")
		end
	end
	if type(grants.Cash) == "number" then
		out[#out + 1] = "$" .. Util.Commas(grants.Cash) .. " Cash"
	end
	if type(grants.Tokens) == "number" then
		out[#out + 1] = Util.Commas(grants.Tokens) .. " Cloud Tokens"
	end
	if type(grants.Gems) == "number" then
		out[#out + 1] = Util.Commas(grants.Gems) .. " Gems"
	end
	if type(grants.Boost) == "table" and type(grants.Boost.XpPotion) == "number" then
		out[#out + 1] = durationText(grants.Boost.XpPotion) .. " x2 Pet XP"
	end
	if type(grants.Perks) == "table" then
		for _, name in ipairs(grants.Perks) do
			out[#out + 1] = PERK_LINES[name] or tostring(name)
		end
	end
	return out
end

function StoreCatalog.Validate()
	local problems = {}
	local function bad(msg)
		problems[#problems + 1] = msg
	end
	local s = store()
	if type(s.Items) ~= "table" then
		bad("Config.Store.Items is missing")
		return false, problems
	end
	local tabSet = {}
	for _, tab in ipairs(type(s.Tabs) == "table" and s.Tabs or {}) do
		tabSet[tab] = true
	end
	local perks = type(s.Perks) == "table" and s.Perks or {}
	local cap = (type(s.Potion) == "table" and isWhole(s.Potion.CapSeconds) and s.Potion.CapSeconds) or 7 * 86400
	local pc = getPetCatalog()
	local maxLevel = (pc and type(pc.MaxPetLevel) == "function" and pc.MaxPetLevel()) or 100
	local maxStack = (type(Config.Pets) == "table" and isWhole(Config.Pets.MaxPerStack) and Config.Pets.MaxPerStack) or 99
	local seenKeys, seenIds, heroByTab = {}, {}, {}
	local function checkId(label, id)
		if id ~= nil and (not isWhole(id) or id < 0) then
			bad(label .. ": Id must be a whole number >= 0")
		elseif isWhole(id) and id > 0 then
			if seenIds[id] then
				bad(label .. ": Id " .. tostring(id) .. " is also " .. seenIds[id] .. "'s")
			else
				seenIds[id] = label
			end
		end
	end
	for i, it in ipairs(s.Items) do
		local key = (type(it.Key) == "string" and it.Key ~= "") and it.Key or nil
		local label = key or ("item " .. tostring(i))
		if not key then
			bad(label .. ": Key must be a non-empty string")
		elseif seenKeys[key] then
			bad(label .. ": duplicate Key")
		else
			seenKeys[key] = true
		end
		if it.Kind ~= "Product" and it.Kind ~= "Pass" then
			bad(label .. ": Kind must be Product or Pass, got " .. tostring(it.Kind))
		end
		if not tabSet[it.Tab] then
			bad(label .. ": Tab " .. tostring(it.Tab) .. " is not in Config.Store.Tabs")
		end
		if type(it.Name) ~= "string" or it.Name == "" then
			bad(label .. ": Name must be a non-empty string")
		end
		checkId(label, it.Id)
		if it.Robux ~= nil and (not isWhole(it.Robux) or it.Robux < 0) then
			bad(label .. ": Robux must be a whole number >= 0")
		end
		if it.Hero == true then
			if heroByTab[it.Tab] then
				bad(label .. ": a second Hero in tab " .. tostring(it.Tab) .. " (" .. heroByTab[it.Tab] .. " is its hero)")
			else
				heroByTab[it.Tab] = label
			end
		end
		if it.Kind == "Pass" and it.Once then
			bad(label .. ": Once is for Products (a pass is owned for good anyway)")
		end
		local g = it.Grants
		if type(g) ~= "table" then
			bad(label .. ": Grants missing")
		else
			local any = false
			for k in pairs(g) do
				any = true
				if not GRANT_KEYS[k] then
					bad(label .. ": unknown grant " .. tostring(k))
				elseif it.Kind == "Pass" and k ~= "Perks" then
					bad(label .. ": a Pass grants Perks only, not " .. tostring(k))
				end
			end
			if not any then
				bad(label .. ": Grants is empty")
			end
			for _, currency in ipairs({ "Cash", "Tokens", "Gems" }) do
				local n = g[currency]
				if n ~= nil and (not isWhole(n) or n < 1 or n > LIMITS[currency]) then
					bad(label .. ": " .. currency .. " must be a whole number 1.." .. string.format("%d", LIMITS[currency]))
				end
			end
			if g.Boost ~= nil then
				if type(g.Boost) ~= "table" then
					bad(label .. ": Boost must be { XpPotion = seconds }")
				else
					local seconds = g.Boost.XpPotion
					if not isWhole(seconds) or seconds < MIN_POTION_SECONDS or seconds > cap then
						bad(label .. ": Boost.XpPotion must be whole seconds " .. MIN_POTION_SECONDS .. ".." .. tostring(cap))
					end
					for k in pairs(g.Boost) do
						if k ~= "XpPotion" then
							bad(label .. ": unknown boost " .. tostring(k))
						end
					end
				end
			end
			if g.Pets ~= nil then
				if type(g.Pets) ~= "table" then
					bad(label .. ": Pets must be { [petId] = { Count, Level } }")
				else
					for petId, spec in pairs(g.Pets) do
						local def = (pc and type(pc.Get) == "function") and pc.Get(petId) or nil
						if not def then
							bad(label .. ": unknown pet " .. tostring(petId))
						end
						if type(spec) ~= "table" then
							bad(label .. ": Pets." .. tostring(petId) .. " must be { Count, Level }")
						else
							if not isWhole(spec.Count) or spec.Count < 1 or spec.Count > maxStack then
								bad(label .. ": Pets." .. tostring(petId) .. ".Count must be 1.." .. tostring(maxStack))
							end
							if spec.Level ~= nil and (not isWhole(spec.Level) or spec.Level < 1 or spec.Level > maxLevel) then
								bad(label .. ": Pets." .. tostring(petId) .. ".Level must be 1.." .. tostring(maxLevel))
							end
						end
					end
				end
			end
			if g.Perks ~= nil then
				if type(g.Perks) ~= "table" or #g.Perks == 0 then
					bad(label .. ": Perks must be a non-empty list of Config.Store.Perks names")
				else
					for _, name in ipairs(g.Perks) do
						if type(name) ~= "string" or type(perks[name]) ~= "table" then
							bad(label .. ": perk " .. tostring(name) .. " is not in Config.Store.Perks")
						end
					end
				end
			end
			-- (a Cash pack: a Product whose only grant is Cash, whatever its tab: lobby-shop 16.3 folded the Currency tab)
			if it.Kind == "Product" and g.Cash ~= nil and next(g, next(g)) == nil and type(it.Line) ~= "string" then
				bad(label .. ": a Cash pack carries its Prestige Line")
			end
		end
	end
	for index, product in ipairs(gemProducts()) do
		local label = "Gems" .. tostring(index)
		if type(product) ~= "table" then
			bad(label .. ": not a table")
		else
			checkId(label, product.Id)
			if not isWhole(product.Gems) or product.Gems < 1 or product.Gems > LIMITS.Gems then
				bad(label .. ": Gems must be a whole number 1.." .. string.format("%d", LIMITS.Gems))
			end
			if type(product.Name) ~= "string" or product.Name == "" then
				bad(label .. ": Name must be a non-empty string")
			end
		end
	end
	-- the gem items (lobby shop): BuyWithGems sells potion time only
	if s.GemItems ~= nil and type(s.GemItems) ~= "table" then
		bad("Config.Store.GemItems must be a list")
	end
	local gemKeys = {}
	for i, it in ipairs(gemItems()) do
		local key = type(it) == "table" and type(it.Key) == "string" and it.Key ~= "" and it.Key or nil
		local label = key or ("gem item " .. tostring(i))
		if type(it) ~= "table" then
			bad(label .. ": not a table")
		else
			if not key then
				bad(label .. ": Key must be a non-empty string")
			elseif gemKeys[key] or seenKeys[key] then
				bad(label .. ": duplicate Key (gem items and Store items share one key space)")
			else
				gemKeys[key] = true
			end
			if not isWhole(it.Gems) or it.Gems < 1 or it.Gems > LIMITS.Gems then
				bad(label .. ": Gems must be a whole number 1.." .. string.format("%d", LIMITS.Gems))
			end
			if type(it.Name) ~= "string" or it.Name == "" then
				bad(label .. ": Name must be a non-empty string")
			end
			local g = it.Grants
			local boost = type(g) == "table" and g.Boost or nil
			local only = type(boost) == "table"
			for k in pairs(only and g or {}) do
				only = only and k == "Boost"
			end
			for k in pairs(type(boost) == "table" and boost or {}) do
				only = only and k == "XpPotion"
			end
			if not only then
				bad(label .. ": a gem item grants Boost = { XpPotion = seconds } only (BuyWithGems sells potion time)")
			elseif not isWhole(boost.XpPotion) or boost.XpPotion < MIN_POTION_SECONDS or boost.XpPotion > cap then
				bad(label .. ": Boost.XpPotion must be whole seconds " .. MIN_POTION_SECONDS .. ".." .. tostring(cap))
			end
		end
	end
	return #problems == 0, problems
end

return StoreCatalog
]]></string>
        </Properties>
      </Item>
