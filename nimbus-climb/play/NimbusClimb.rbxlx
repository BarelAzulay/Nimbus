-- state (tests read it through MainMenuController._M)
local M = {
	Started = false,
	Enabled = false,
	Open = false, -- the menu screen is up
	Playing = false, -- a PLAY is in progress
	SentPlay = false, -- MenuPlay fired (once per session)
	Gui = nil,
	Menu = nil, -- the full-screen menu frame
	Ui = {},
	Win = { Name = nil, Holder = nil, Dock = nil, Panel = nil, Resize = nil, Back = false },
	Heads = {}, -- [userId] = the headshot content (Players:GetUserThumbnailAsync, once per user)
	Gate = { On = false, Wanted = {}, Conns = {}, AddConn = nil },
	Cards = { On = false, Names = {}, Wanted = {}, Conns = {}, AddConn = nil }, -- the world cards (HideCards), like Gate
	Orbit = { Conn = nil, T = 0 },
	Mods = {},
	Notes = nil,
	Settings = { Rows = {} },
	MouseHeld = false, -- the "MainMenu" MouseLock hold is on
}
MainMenuController._M = M

local LocalPlayer = Players.LocalPlayer

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local H = {}

function H.safe(label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[MainMenuController] " .. label .. ": " .. tostring(err))
	end
	return ok, err
end

function H.optional(parent, name)
	local inst = parent and parent:FindFirstChild(name)
	if not inst then
		return nil
	end
	local ok, mod = pcall(require, inst)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.mod(name)
	if M.Mods[name] == nil then
		M.Mods[name] = H.optional(Client, name) or H.optional(Client:FindFirstChild("Controllers"), name) or false
	end
	return M.Mods[name] or nil
end

function H.notes()
	if M.Notes == nil then
		M.Notes = H.optional(Shared, "UpdateNotes") or false
	end
	return M.Notes or nil
end

function H.sound(name)
	local SoundFx = H.mod("SoundFx")
	if SoundFx and type(SoundFx.Play) == "function" then
		pcall(SoundFx.Play, name)
	end
end

function H.frame(name, props, parent)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for key, value in pairs(props or {}) do
		f[key] = value
	end
	f.Parent = parent
	return f
end

function H.label(name, text, role, size, props, parent)
	local outline = props.Outline or 2
	local l = Theme.Label(text, role, {
		Size = size,
		Stroke = 1,
		Outline = outline > 0 and outline or nil,
		OutlineColor = K.INK,
		Color = props.Color,
	})
	l.Name = name
	for key, value in pairs(props) do
		if key ~= "Outline" and key ~= "Color" then
			l[key] = value
		end
	end
	l.Parent = parent
	return l
end

function H.corner(parent, px)
	return Util.Create("UICorner", { CornerRadius = px and UDim.new(0, px) or UDim.new(1, 0), Parent = parent })
end

function H.viewport()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		vp = Vector2.new(1920, 1080)
	end
	return vp
end

function H.playerGui()
	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

function H.menuCfg()
	return type(Config.MainMenu) == "table" and Config.MainMenu or {}
end

-- the "rbxassetid://" image of a TextureIds key (TextureIds.lua holds only uploaded ids), nil while it has none (id 0)
function H.textureImage(key)
	local ids = H.optional(Shared, "TextureIds")
	local id = ids and ids[key]
	if type(id) == "number" and id > 0 then
		local digits = string.format("%.0f", id) -- whole digits (a 15-digit id never prints as 1.05e+14)
		return "rbxassetid://" .. digits
	end
	return nil
end

----------------------------------------------------------------------
-- the gate: every ScreenGui outside UiGate.ALLOW is off until PLAY
----------------------------------------------------------------------
local Gate = {}

function Gate.track(g)
	local G = M.Gate
	if not G.On or not g:IsA("ScreenGui") or UiGate.IsAllowed(g.Name) or G.Wanted[g] ~= nil then
		return
	end
	G.Wanted[g] = g.Enabled
	g.Enabled = false
	G.Conns[g] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
		if G.On and g.Enabled then
			G.Wanted[g] = true -- its owner switched it on: remember, keep it off until PLAY
			g.Enabled = false
		end
	end)
end

function Gate.close()
	local G = M.Gate
	if G.On then
		return
	end
	G.On = true
	local pg = H.playerGui()
	if not pg then
		return
	end
	for _, g in ipairs(pg:GetChildren()) do
		Gate.track(g)
	end
	G.AddConn = pg.ChildAdded:Connect(function(child)
		Gate.track(child)
	end)
end

function Gate.open()
	local G = M.Gate
	G.On = false
	if G.AddConn then
		G.AddConn:Disconnect()
		G.AddConn = nil
	end
	for g, conn in pairs(G.Conns) do
		conn:Disconnect()
		G.Conns[g] = nil
	end
	for g, want in pairs(G.Wanted) do
		if g.Parent then
			g.Enabled = want
		end
		G.Wanted[g] = nil
	end
end

----------------------------------------------------------------------
-- the world cards (quick wins, win 1): the BillboardGuis named in Config.MainMenu.HideCards anywhere in the workspace
-- are off while the menu is up (client-side only), the same rule as the gate: the ones there now and any that appear
-- later (a gate streaming in, /menu mid-game); an owner that switches one on meanwhile gets it back at PLAY; one that
-- was already off stays off. The owners that switch their card on and off at run time (LobbyFxController's join board,
-- HomePortalFx, RaidGateController) re-apply their own state every pass, so a card whose owner switched it off while
-- it was held off is put right by that owner's next pass after PLAY. Every other BillboardGui (players' TitleTag, pet
-- cards) is untouched.
----------------------------------------------------------------------
local Cards = {}

-- the names to hide, as a set: Config.MainMenu.HideCards (K.WORLD_CARDS when Config has no list)
function Cards.names()
	local list = H.menuCfg().HideCards
	local set = {}
	for _, name in ipairs(type(list) == "table" and list or K.WORLD_CARDS) do
		set[tostring(name)] = true
	end
	return set
end

function Cards.track(g)
	local C = M.Cards
	if not C.On or not C.Names[g.Name] or not g:IsA("BillboardGui") or C.Wanted[g] ~= nil then
		return
	end
	C.Wanted[g] = g.Enabled
	g.Enabled = false
	C.Conns[g] = g:GetPropertyChangedSignal("Enabled"):Connect(function()
		if C.On and g.Enabled then
			C.Wanted[g] = true -- its owner switched it on: remember, keep it off until PLAY
			g.Enabled = false
		end
	end)
end

function Cards.close()
	local C = M.Cards
	if C.On then
		return
	end
	C.On = true
	C.Names = Cards.names()
	for _, d in ipairs(Workspace:GetDescendants()) do
		Cards.track(d)
	end
	C.AddConn = Workspace.DescendantAdded:Connect(function(d)
		Cards.track(d)
	end)
end

function Cards.open()
	local C = M.Cards
	C.On = false
	if C.AddConn then
		C.AddConn:Disconnect()
		C.AddConn = nil
	end
	for g, conn in pairs(C.Conns) do
		conn:Disconnect()
		C.Conns[g] = nil
	end
	for g, want in pairs(C.Wanted) do
		-- every remembered card gets its wish back: a destroyed one is a harmless no-op (pcall), and one that was only
		-- taken out of the workspace meanwhile (streamed out, moved) is not left off for good if it comes back
		pcall(function()
			g.Enabled = want
		end)
		C.Wanted[g] = nil
	end
end

----------------------------------------------------------------------
-- the camera orbit around the Gate Court
----------------------------------------------------------------------
local Orbit = {}

function Orbit.centre()
	local lobby = type(Config.Lobby) == "table" and Config.Lobby or {}
	local origin = typeof(lobby.Origin) == "Vector3" and lobby.Origin or Vector3.new(0, 300, 0)
	local a = math.rad(tonumber(lobby.GateFacing) or 90)
	local r = tonumber(lobby.GateArcRadius) or 118
	return origin + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)
end

-- (kit B U4, PICK) the authored shot of Config.MainMenu.Shots while Config.Preview.TitleShots is on: Key A on a wide
-- screen, Key P on a portrait one, drifting sideways and back every DriftSeconds; returns cframe, fov (nil when off)
function Orbit.shot()
	local preview = Config.Preview
	local shots = H.menuCfg().Shots
	if not (type(preview) == "table" and preview.TitleShots == true and type(shots) == "table") then
		return nil
	end
	local vp = H.viewport()
	local key = vp.Y > vp.X and shots.P or shots.A
	if type(key) ~= "table" then
		return nil
	end
	local lobby = type(Config.Lobby) == "table" and Config.Lobby or {}
	local origin = typeof(lobby.Origin) == "Vector3" and lobby.Origin or Vector3.new(0, 300, 0)
	local a = math.rad(tonumber(lobby.GateFacing) or 90)
	local dir = Vector3.new(math.cos(a), 0, math.sin(a))
	local right = Vector3.new(-dir.Z, 0, dir.X)
	local drift = tonumber(key.Drift) or 0
	local period = math.max(1, tonumber(shots.DriftSeconds) or 30)
	local side = drift * (0.5 - 0.5 * math.cos(math.pi * M.Orbit.T / period)) - drift / 2
	local pos = origin + dir * (tonumber(shots.Arch) or 40) - dir * (tonumber(key.Back) or 26) + Vector3.new(0, tonumber(key.Up) or 6, 0) + right * side
	local pitch = math.rad(tonumber(key.Pitch) or 12)
	local look = dir * math.cos(pitch) + Vector3.new(0, math.sin(pitch), 0)
	return CFrame.lookAt(pos, pos + look), tonumber(shots.Fov) or 50
end

function Orbit.place(dt)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cfg = H.menuCfg()
	local period = tonumber(cfg.OrbitPeriod) or 60
	local radius = tonumber(cfg.OrbitRadius) or 90
	local height = tonumber(cfg.OrbitHeight) or 38
	local O = M.Orbit
	O.T = O.T + (tonumber(dt) or 0)
	local shot, fov = Orbit.shot()
	if shot then
		if O.Fov0 == nil then
			O.Fov0 = camera.FieldOfView -- given back at PLAY
		end
		camera.FieldOfView = fov
		camera.CFrame = shot
		return
	end
	local angle = (O.T / math.max(1, period)) * math.pi * 2
	local c = O.Centre
	camera.CFrame = CFrame.lookAt(
		Vector3.new(c.X + math.cos(angle) * radius, c.Y + height, c.Z + math.sin(angle) * radius),
		Vector3.new(c.X, c.Y + 8, c.Z)
	)
end

function Orbit.start()
	local O = M.Orbit
	if O.Fly then -- a PLAY's camera move still under way (/menu right after PLAY): drop it
		local fly = O.Fly
		O.Fly, O.Release = nil, false
		fly:Cancel()
	end
	if O.Conn then
		return
	end
	O.Centre = Orbit.centre()
	O.T = 0 -- each title screen starts its orbit (or a title shot's drift) from the start
	local camera = Workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	Orbit.place(0)
	O.Conn = RunService.RenderStepped:Connect(Orbit.place)
end

-- the orbit's frame loop off (the camera stays where it is, Scriptable); cleared before the disconnect, so one that throws
-- is reported once
function Orbit.halt()
	local O = M.Orbit
	local conn = O.Conn
	O.Conn = nil
	if conn then
		conn:Disconnect()
	end
end

-- (kit B U4) where the camera lands at PLAY: behind the character (or the lobby spawn, looking towards the gates), up a little
function Orbit.spawnView()
	local lobby = type(Config.Lobby) == "table" and Config.Lobby or {}
	local a = math.rad(tonumber(lobby.GateFacing) or 90)
	local dir = Vector3.new(math.cos(a), 0, math.sin(a))
	local at = (typeof(lobby.Origin) == "Vector3" and lobby.Origin or Vector3.new(0, 300, 0)) + Vector3.new(0, 3, 0)
	local root = LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		at = root.Position
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.1 then
			dir = flat.Unit
		end
	end
	return CFrame.lookAt(at - dir * 14 + Vector3.new(0, 6, 0), at + Vector3.new(0, 2, 0) + dir * 6)
end

-- (kit B U4) PLAY: the camera tweens to the spawn view (0.8 s, Sine InOut; a title shot's field of view goes back with it);
-- Custom follows when it lands, or at the release if that comes later (Orbit.stop)
function Orbit.fly()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local O = M.Orbit
	local goal = { CFrame = Orbit.spawnView() }
	if O.Fov0 then
		goal.FieldOfView = O.Fov0
	end
	local fly = TweenService:Create(camera, TweenInfo.new(K.BOARD.FLY, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), goal)
	O.Fly, O.Release = fly, false
	fly.Completed:Connect(function()
		if O.Fly ~= fly then
			return
		end
		O.Fly = nil
		if O.Release then
			O.Release = false
			Orbit.custom()
		end
	end)
	fly:Play()
end

-- the camera back to Custom on the humanoid, a title shot's field of view given back
function Orbit.custom()
	local O = M.Orbit
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if O.Fov0 then
		camera.FieldOfView = O.Fov0
		O.Fov0 = nil
	end
	camera.CameraType = Enum.CameraType.Custom
	local humanoid = LocalPlayer and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		camera.CameraSubject = humanoid
	end
end

-- the release after PLAY: the orbit off and the camera Custom, once the PLAY camera move has landed
function Orbit.stop()
	Orbit.halt()
	if M.Orbit.Fly then
		M.Orbit.Release = true
		return
	end
	Orbit.custom()
end

----------------------------------------------------------------------
-- the loading screen hand-off
----------------------------------------------------------------------
local Loading = {}

function Loading.fade(gui)
	if not gui or not gui.Parent or gui:GetAttribute("Fading") then
		return
	end
	gui:SetAttribute("Fading", true)
	local info = TweenInfo.new(K.LOADING_FADE)
	for _, d in ipairs(gui:GetDescendants()) do
		if d:IsA("GuiObject") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				TweenService:Create(d, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
	task.delay(K.LOADING_FADE, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

-- (sign/logo build) the loading screen's board sways like the title screen's; Camera shake OFF stops it. The loading
-- screen cannot read the settings (ReplicatedFirst), so the setting goes to its gui's Sway attribute (here, and again
-- whenever it changes or arrives with the profile)
function Loading.passSway(gui)
	if gui and gui.Parent and gui.Name == "NimbusLoading" then
		gui:SetAttribute("Sway", ClientSettings.Get("Shake") ~= false)
	end
end

function Loading.watch(gui)
	if not gui or gui.Name ~= "NimbusLoading" or not gui:IsA("ScreenGui") then
		return
	end
	Loading.passSway(gui)
	if gui:GetAttribute("Done") == true then
		Loading.fade(gui)
		return
	end
	local conn
	conn = gui:GetAttributeChangedSignal("Done"):Connect(function()
		if gui:GetAttribute("Done") == true then
			conn:Disconnect()
			Loading.fade(gui)
		end
	end)
end

-- watch the loading screen there now and any added later (once)
function Loading.hook()
	if M.LoadingHooked then
		return
	end
	local pg = H.playerGui()
	if not pg then
		return
	end
	M.LoadingHooked = true
	Loading.watch(pg:FindFirstChild("NimbusLoading"))
	pg.ChildAdded:Connect(Loading.watch)
end

function Loading.busy()
	local pg = H.playerGui()
	local gui = pg and pg:FindFirstChild("NimbusLoading")
	return gui ~= nil and gui:GetAttribute("Done") ~= true
end

-- (U4 review) runs fn once the loading screen is done (its Done, or it is gone), at once when none is up
function Loading.onDone(fn)
	local pg = H.playerGui()
	local gui = pg and pg:FindFirstChild("NimbusLoading")
	if not gui or gui:GetAttribute("Done") == true then
		fn()
		return
	end
	local conns = {}
	local function finish()
		if not conns[1] then
			return
		end
		for _, c in ipairs(conns) do
			c:Disconnect()
		end
		conns = {}
		fn()
	end
	conns[1] = gui:GetAttributeChangedSignal("Done"):Connect(function()
		if gui:GetAttribute("Done") == true then
			finish()
		end
	end)
	conns[2] = gui.AncestryChanged:Connect(function()
		if not gui.Parent then
			finish()
		end
	end)
end

-- (sign build) runs fn once the loading screen has faded away: when it is gone (Loading.fade destroys it), or its fade's
-- length after Done should it linger; at once when none is up. The owner's pick: the sign drops in only after the fade
function Loading.afterFade(fn)
	local pg = H.playerGui()
	local gui = pg and pg:FindFirstChild("NimbusLoading")
	if not gui then
		fn()
		return
	end
	local done, conn = false, nil
	local function finish()
		if done then
			return
		end
		done = true
		if conn then
			conn:Disconnect()
			conn = nil
		end
		fn()
	end
	conn = gui.AncestryChanged:Connect(function()
		if not gui.Parent then
			finish()
		end
	end)
	Loading.onDone(function()
		task.delay(K.LOADING_FADE + 0.15, finish)
	end)
end

----------------------------------------------------------------------
-- the menu screen
----------------------------------------------------------------------
local Menu = {}

function Menu.gui()
	if M.Gui and M.Gui.Parent then
		return M.Gui
	end
	local pg = H.playerGui()
	if not pg then
		return nil
	end
	local gui = pg:FindFirstChild(K.GUI)
	if not gui then
		gui = Instance.new("ScreenGui")
		gui.Name = K.GUI
		gui.DisplayOrder = K.ORDER
		gui.IgnoreGuiInset = true
		gui.ResetOnSpawn = false
		gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		gui.Parent = pg
	end
	M.Gui = gui
	return gui
end

function Menu.badge()
	local notes = H.notes()
	local latest = notes and tonumber(notes.Latest) or 0
	local seen = tonumber(ClientSettings.Get("SeenNotes")) or 0
	return latest > seen
end

function Menu.refreshBadge()
	local badge = M.Ui.NewBadge
	if badge then
		badge.Visible = Menu.badge()
	end
end

-- (kit B U4) a PixelIcon left of a plank's label, the two centred together on the face by a row layout (the engine
-- measures the text: AutomaticSize); returns the icon. (U5 review) The text is fitted again to the face less the icon
-- and the gap (SignKit fitted it to the bare face), and the auto-sized label never truncates: under the board's UIScale
-- a 1 px auto-size shortfall would otherwise draw "PLA..."
function Menu.plankIcon(plank, name, px, colour)
	local face = plank:FindFirstChild("Face", true)
	local label = face and face:FindFirstChild("Label")
	local icon = label and PixelIcon.New(face, name, px, colour)
	if not icon then
		return nil
	end
	local gap = math.floor(px * 0.4)
	local group = H.frame("Group", { Size = UDim2.fromScale(1, 1), ZIndex = 3 }, face)
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, gap),
		Parent = group,
	})
	icon.LayoutOrder = 1
	icon.ZIndex = 3
	icon.Parent = group
	local edge = plank:GetAttribute("EdgePx") or SignKit.Sizes.Edge
	local room = plank.Size.X.Offset - 2 * edge - 2 * SignKit.Sizes.LabelPad - icon.Size.X.Offset - gap
	label.TextSize = SignKit.FitSize(label.Text, label.TextSize, room)
	label.TextTruncate = Enum.TextTruncate.None
	label.LayoutOrder = 2
	label.AutomaticSize = Enum.AutomaticSize.X
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.new(0, 0, 1, 0)
	label.Parent = group
	return icon
end
MainMenuController._PlankIcon = Menu.plankIcon -- tests (U5 review)

-- the hint line's input: a gamepad (a console, or the pad was the last input), touch, else keyboard
function H.inputKind()
	local UIS = game:GetService("UserInputService")
	local last = nil
	pcall(function()
		last = UIS:GetLastInputType()
	end)
	local padLast = last ~= nil and string.find(tostring(last), "Gamepad", 1, true) ~= nil
	if UIS.GamepadEnabled and (not UIS.KeyboardEnabled or padLast) then
		return "Gamepad"
	end
	if H.isTouch() then
		return "Touch"
	end
	return "Keyboard"
end

-- (kit B U4) the title screen: the Signboard hanging on two ropes over the world (no shade). Design px of a 1080p screen
-- under one UIScale (Theme.ScreenFactor). Landscape: the board at x 60 (right of the thumbstick zone on a touch screen),
-- 440 wide, a little above the middle; portrait: docked at the bottom just above the thumbstick / jump zones, the screen
-- less a 16 px gutter wide (560 at most). In the board: the awning, the navy header (Config.MainMenu.Header, Title role),
-- the stone body with the tag line, PLAY (the one green plank), SETTINGS + UPDATES (half-width stone planks; the pixel
-- star on UPDATES is the one NEW marker), the version line (opens UPDATES) and the hint line. The CREDITS tag hangs on
-- its own rope: bottom-right on a desktop, top-right under Roblox's buttons on a landscape touch screen,
-- and under the board (swinging with it, between the thumb zones) on a portrait one, where the top strip has room only
-- for the board's two ropes (U4 review). The ropes keep right of Roblox's top-left buttons (ROPE_CLEAR).
-- `enter`: the board drops in on its ropes, settles with a swing, the buttons pop (Menu.enter)
function Menu.build(enter)
	local gui = Menu.gui()
	if not gui then
		return nil
	end
	local old = gui:FindFirstChild("Menu")
	if old then
		old:Destroy()
	end
	local B, Z, Sign = K.BOARD, SignKit.Sizes, Theme.Sign
	local vp = H.viewport()
	local f = Theme.ScreenFactor(vp.Y)
	local portrait = vp.Y > vp.X
	local dw, dh = vp.X / f, vp.Y / f
	local short = dh < 600
	local menu = H.frame("Menu", { Size = UDim2.fromScale(1, 1), Active = true, ZIndex = 1 }, gui)
	M.Menu = menu
	M.Ui = {}
	local content = H.frame("Content", { Size = UDim2.fromOffset(math.floor(dw + 0.5), math.floor(dh + 0.5)), ZIndex = 2 }, menu)
	Util.Create("UIScale", { Name = "ReadScale", Scale = f, Parent = content })

	-- Roblox's touch thumbstick (bottom-left) and jump button (bottom-right) zones in screen px, kept clear of every
	-- button: the classic stick / jump button of a small phone (<= 500 px on the short side), the big ones elsewhere
	-- (the rule TutorialController and MovementController use)
	local touch = H.isTouch()
	local zoneW, zoneH = 0, 0
	if touch then
		if math.min(vp.X, vp.Y) <= 500 then
			zoneW, zoneH = 104, 96
		else
			zoneW, zoneH = 206, 210
		end
	end

	-- (Pitch 2 fix round B, T1 look leftover 6: at 844x390 SETTINGS / UPDATES drew 41.6 px and CREDITS 35.2 px under the
	-- 0.8 read scale) on a touch screen the pair and the CREDITS plank are at least B.TOUCH screen px tall
	local tapH = touch and math.ceil(B.TOUCH / f) or 0
	local btnH, creditsH = math.max(B.BTN_H, tapH), math.max(B.TAG_H, tapH)

	-- the board's size: header, then the body rows top-down (the tag line drops out on a short screen)
	local boardW = portrait and math.floor(math.min(dw - 2 * B.GUTTER / f, B.W_MAX)) or B.W
	local inner = boardW - 2 * Z.Frame
	local pad = short and 14 or 18
	local headY = Z.RoofH - 3
	local headH = short and 56 or 72
	local tagH = short and 0 or 26
	local playW = inner - 2 * pad
	local y = pad
	local rows = {}
	if tagH > 0 then
		rows.Tag = y - 4
		y = y + tagH + 8
	end
	rows.Play = y
	y = y + B.PLAY_H + 10
	rows.Pair = y
	y = y + btnH + 8
	rows.Version = y
	y = y + 24 + 2
	rows.Hint = y
	y = y + 22 + pad
	local bodyH = y + Z.Lip
	local woodH = bodyH + 2 * Z.Frame
	local boardH = headY + headH + woodH

	-- the CREDITS tag: its rope, then the plank (kit-b prep, the owner's "v6 once": the version shows only on the rig's
	-- brass plate, no "vN" beside the tag)
	local notes = H.notes()
	local latest = tostring(notes and notes.Latest or 6)
	local tagW, ropeH = B.TAG_W, 22

	-- where it hangs: below Roblox's top bar; a portrait board docks above the thumb zones (and above the CREDITS tag
	-- hanging under it where there are no thumb zones)
	local minTop = math.ceil(58 / f) + 12
	local boardX, topY
	if portrait then
		boardX = math.floor((dw - boardW) / 2)
		local below = math.max(zoneH, math.ceil((ropeH + creditsH) * f) + 8)
		topY = math.max(minTop, math.floor(dh - (below + B.DOCK) / f - boardH))
	else
		boardX = math.max(B.X, touch and math.ceil((zoneW + 8) / f) or 0)
		topY = math.max(minTop, math.floor((dh - boardH) * 0.42))
	end
	-- (sign build) the swinging board ends B.BOTTOM screen px above the bottom: on a short screen its ropes shorten (it
	-- hangs higher, at most up to 8 design px from the top)
	local droop = math.ceil(0.5 * boardW * math.sin(math.rad(Menu.maxTilt())))
	local lowest = math.floor(dh - B.BOTTOM / f - droop - boardH)
	if topY > lowest then
		topY = math.max(8, lowest)
	end
	local half = topY + boardH
	local side = 32
	local swing = H.frame("Swing", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(boardX + math.floor(boardW / 2), 0),
		Size = UDim2.fromOffset(boardW + 2 * side, 2 * half),
		ZIndex = 2,
	}, content)
	-- the ropes: at ROPE_AT and its mirror, moved in together until the left one clears Roblox's top-left buttons
	-- (sign build) each from ROPE_UP above the screen top to 8 px into the board (no rope end shows through a bounce)
	local ropeAt = math.min(math.max(B.ROPE_AT, (B.ROPE_CLEAR / f + Z.RopeW / 2 - boardX) / boardW), 0.4)
	local ropes = {}
	for i, at in ipairs({ ropeAt, 1 - ropeAt }) do
		ropes[i] = SignKit.Rope(swing, {
			Name = "Rope",
			Length = topY + 8 + B.ROPE_UP,
			Position = UDim2.fromOffset(side + math.floor(at * boardW) - math.floor(Z.RopeW / 2), half - B.ROPE_UP),
			ZIndex = 1,
			LayoutOrder = i,
		})
	end
	local board = H.frame("Board", { Position = UDim2.fromOffset(side, half + topY), Size = UDim2.fromOffset(boardW, boardH), ZIndex = 2 }, swing)
	local roof = SignKit.Roof(board, { Width = boardW + 24, ZIndex = 3 })
	-- the header title: Config.MainMenu.Header in the Title role, stepped down until it fits the plate with 12 px each side
	local header = tostring(H.menuCfg().Header or K.HEADER)
	local titleSize = short and 44 or 54
	local room = boardW - 2 * Z.Rim - 24
	while titleSize > 24 do
		local ok, size = pcall(Theme.Measure, header, "Title", titleSize)
		if not ok or not size or size.X <= room then
			break
		end
		titleSize = titleSize - 2
	end
	local head, plate = SignKit.Header(board, { Title = header, TitleSize = titleSize, Y = headY, Height = headH, ZIndex = 2 })
	local title = plate:FindFirstChild("Title")
	if title then
		title.Position = UDim2.fromOffset(0, 0)
		title.Size = UDim2.fromScale(1, 1)
		title.TextXAlignment = Enum.TextXAlignment.Center
		title.Visible = false -- (sign/logo build) the logo below shows the game's name
	end
	-- (sign/logo build) the logo on the header (over the canopy: its bumps rise above the plate, its bolt ends at the
	-- plate's foot): the L1 picture when Config.Loading.Images.Logo has an id in TextureIds, else the live L2
	local logoScale = Logo.Fit(boardW - 2 * Z.Rim, headH - Z.Rim)
	M.Ui.Logo = Logo.Build(board, {
		Image = H.textureImage(Logo.Key(Config)),
		Scale = logoScale,
		Position = UDim2.fromOffset(math.floor(boardW / 2), math.floor(headY + Z.Rim - 18 * logoScale)),
		ZIndex = 4,
	})
	local wood = SignKit.Frame(board, { Y = headY + headH, Height = woodH, ZIndex = 1 })
	local body = SignKit.Body(wood)
	-- (sign/logo build) the owner's B2 "Sky-climber's rig" (it replaced the Workshop trim)
	SignKit.Rig({ Board = board, Roof = roof, Head = head, Frame = wood, Ropes = ropes }, { Width = boardW, Version = "V" .. latest })

	local tagline = Theme.Label(tostring(Config.Tagline or K.TAGLINE), "Body", { Size = 20, Color = Theme.TextOn("Stone") })
	tagline.Name = "Tagline"
	tagline.Position = UDim2.fromOffset(pad, rows.Tag or 0)
	tagline.Size = UDim2.fromOffset(playW, math.max(tagH, 1))
	tagline.Visible = tagH > 0
	tagline.ZIndex = 2
	tagline.Parent = body

	M.Ui.Play = SignKit.Plank(body, {
		Name = "PlayButton",
		Text = "PLAY",
		Style = "Grass",
		Width = playW,
		Height = B.PLAY_H,
		LipPx = B.PLAY_LIP,
		TextSize = 40,
		Position = UDim2.fromOffset(pad, rows.Play),
		ZIndex = 2,
		Callback = function()
			MainMenuController.Play()
		end,
	})
	Menu.plankIcon(M.Ui.Play, "play", 27, Sign.OnGrass) -- (U5) the label's dark green, like the pitch's icon (currentColor)
	local halfW = math.floor((playW - B.GAP) / 2)
	M.Ui.Settings = SignKit.Plank(body, {
		Name = "SettingsButton",
		Text = "SETTINGS",
		Width = halfW,
		Height = btnH,
		TextSize = 22,
		Position = UDim2.fromOffset(pad, rows.Pair),
		ZIndex = 2,
		Callback = function()
			MainMenuController.OpenSettings()
		end,
	})
	Menu.plankIcon(M.Ui.Settings, "gear", 18, Sign.Text)
	M.Ui.Updates = SignKit.Plank(body, {
		Name = "UpdatesButton",
		Text = "UPDATES",
		Width = halfW,
		Height = btnH,
		TextSize = 22,
		Position = UDim2.fromOffset(pad + playW - halfW, rows.Pair),
		ZIndex = 2,
		Callback = function()
			MainMenuController.OpenUpdates()
		end,
	})
	Menu.plankIcon(M.Ui.Updates, "scroll", 18, Sign.Text)
	-- (sign build, U4 minor) anchored at their centre, so the entrance's pop grows them from the middle, not a corner
	for _, plank in ipairs({ M.Ui.Play, M.Ui.Settings, M.Ui.Updates }) do
		local p, s = plank.Position, plank.Size
		plank.AnchorPoint = Vector2.new(0.5, 0.5)
		plank.Position = UDim2.fromOffset(p.X.Offset + math.floor(s.X.Offset / 2), p.Y.Offset + math.floor(s.Y.Offset / 2))
	end
	-- the one NEW marker: a gold pixel star on a dark tile at UPDATES' corner (shown while UpdateNotes.Latest > SeenNotes);
	-- (U5) the star is drawn at 18 (a multiple of 9) and the tile grows round it by a 4 px padding
	local badge = PixelIcon.New(M.Ui.Updates, "star", 18, Sign.Gold)
	badge.Name = "NewBadge"
	badge.Size = UDim2.fromOffset(26, 26)
	Util.Create("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingTop = UDim.new(0, 4), Parent = badge })
	badge.BackgroundTransparency = 0
	badge.BackgroundColor3 = Sign.Text
	badge.AnchorPoint = Vector2.new(0.5, 0.5)
	badge.Position = UDim2.new(1, -6, 0, 6)
	badge.ZIndex = 5
	M.Ui.NewBadge = badge
	Menu.refreshBadge()

	-- the version line (opens UPDATES) and the hint line, Nunito on the stone; the line names the latest update, its number
	-- is on the brass plate (kit-b prep, "v6 once")
	local first = notes and type(notes.Notes) == "table" and notes.Notes[1] or nil
	local versionText = K.NOTES_LINE
	if first and type(first.Title) == "string" then
		versionText = first.Title
	end
	local version = Instance.new("TextButton")
	version.Name = "VersionLine"
	version.AutoButtonColor = false
	version.BackgroundTransparency = 1
	version.Text = versionText
	Theme.Style(version, "Body", { Size = 18, Color = Sign.TextMuted })
	version.TextTruncate = Enum.TextTruncate.AtEnd
	version.Position = UDim2.fromOffset(pad, rows.Version)
	version.Size = UDim2.fromOffset(playW, 24)
	version.ZIndex = 2
	version.Parent = body
	version.Activated:Connect(function()
		MainMenuController.OpenUpdates()
	end)
	local hint = Theme.Label(K.HINTS[H.inputKind()] or K.HINTS.Keyboard, "Label", { Size = 18, Color = Sign.TextMuted })
	hint.Name = "Hint"
	hint.Position = UDim2.fromOffset(pad, rows.Hint)
	hint.Size = UDim2.fromOffset(playW, 22)
	hint.ZIndex = 2
	hint.Parent = body

	-- the CREDITS tag on its rope: bottom-right on a desktop; top-right under Roblox's buttons on a landscape touch screen
	-- (clear of the thumb zones); on a portrait screen it hangs from the board's bottom edge, centred between the thumb
	-- zones, and drops, swings and leaves with the board (it is in the Swing). (kit-b prep, gate GATE_KITB) Under the board
	-- one centred post would land on the rig's brass version plate, and between a phone's thumb zones there is no room to
	-- slide the tag past it, so there it hangs on two short ropes that straddle the plate
	local tag = H.frame("CreditsTag", { Size = UDim2.fromOffset(tagW, ropeH + creditsH), ZIndex = 3 }, portrait and swing or content)
	local posts = { math.floor(tagW / 2) }
	if portrait then
		tag.Position = UDim2.fromOffset(side + math.floor((boardW - tagW) / 2), half + topY + boardH)
		-- the plate's half width as SignKit.Rig draws it on this board, then the 6 px peg half and a 6 px gap
		local rk = math.min(math.max(boardW / 250, 1), 2)
		local d = math.min(math.floor(SignKit.RigSizes.PlateW * rk + 0.5) / 2 + 12, math.floor(tagW / 2) - 12)
		posts = { math.floor(tagW / 2 - d), math.ceil(tagW / 2 + d) }
	elseif touch then
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.fromOffset(math.floor(dw - 16 / f), math.ceil(58 / f) + 4)
	else
		tag.AnchorPoint = Vector2.new(1, 1)
		tag.Position = UDim2.fromOffset(math.floor(dw - 20), math.floor(dh - 18))
	end
	for i, x in ipairs(posts) do
		H.frame("Peg", { BackgroundTransparency = 0, BackgroundColor3 = Sign.Text, Position = UDim2.fromOffset(x - 6, 0), Size = UDim2.fromOffset(12, 6), ZIndex = 4, LayoutOrder = i }, tag)
		SignKit.Rope(tag, { Name = "Rope", Length = ropeH + 6, Position = UDim2.fromOffset(x - math.floor(Z.RopeW / 2), 2), ZIndex = 3, LayoutOrder = i })
	end
	M.Ui.Credits = SignKit.Plank(tag, {
		Name = "CreditsButton",
		Text = "CREDITS",
		Width = tagW,
		Height = creditsH,
		TextSize = 18,
		Face = Sign.Wood,
		Lip = K.SIGN.WoodDark,
		Edge = Sign.Text,
		TextColor = Sign.Stone,
		Position = UDim2.fromOffset(0, ropeH),
		ZIndex = 4,
		Callback = function()
			MainMenuController.OpenCredits()
		end,
	})

	M.Ui.Swing, M.Ui.Board, M.Ui.Tag = swing, board, tag
	M.Ui.TagTop = touch and not portrait -- (the tag at the top right, in the docked windows' column: Win.holder)
	M.Ui.Rest, M.Ui.Lift = swing.Position, half + 40
	-- (sign build) the screen it was laid out for, and where the dust puffs rise at the snap (beside the awning's ends)
	M.Ui.Vp, M.Ui.Content, M.Ui.Tw = vp, content, {}
	M.Ui.PuffAt = { L = boardX - 18, R = boardX + boardW + 18, Y = topY + 22 }
	if enter then
		Menu.enter()
	end
	return menu
end

-- (sign build) the entrance and sway numbers (Config.MainMenu.Entrance / Sway)
function Menu.entrance()
	local E = H.menuCfg().Entrance
	return type(E) == "table" and E or { Drop = 0.6, Bounce = {}, BounceTime = 0.13, Swing = {}, SwingTime = 0.32, Puff = 0.45 }
end

function Menu.swayCfg()
	local W = H.menuCfg().Sway
	return type(W) == "table" and W or { Degrees = 0, Period = 3.6 }
end

-- the sway is on: some degrees, and Settings Camera shake not OFF
function Menu.swayOn()
	return (tonumber(Menu.swayCfg().Degrees) or 0) > 0 and ClientSettings.Get("Shake") ~= false
end

-- the most the board turns (the entrance's swing, the sway): the layout keeps its lower corner on screen
function Menu.maxTilt()
	local most = tonumber(Menu.swayCfg().Degrees) or 0
	for _, d in ipairs(Menu.entrance().Swing or {}) do
		most = math.max(most, math.abs(tonumber(d) or 0))
	end
	return most
end

-- one motion of the board at a time per key ("Move" = Position, "Turn" = Rotation): a new one cancels the one before.
-- onDone runs when it completes (never when it was cancelled, the menu was rebuilt or PLAY began); a finished tween is
-- destroyed with its connection
function Menu.tween(ui, key, inst, info, goal, onDone)
	local old = ui.Tw[key]
	if old then
		ui.Tw[key] = nil
		old:Cancel()
	end
	local tw = TweenService:Create(inst, info, goal)
	ui.Tw[key] = tw
	tw.Completed:Connect(function(state)
		if ui.Tw[key] == tw then
			ui.Tw[key] = nil
		end
		tw:Destroy()
		if onDone and state == Enum.PlaybackState.Completed and M.Ui == ui and not M.Playing and inst.Parent then
			onDone()
		end
	end)
	tw:Play()
	return tw
end

-- steps = { { Info, Goal }, ... } played one after the other on `key`, then done()
function Menu.chain(ui, key, inst, steps, done)
	local i = 0
	local function step()
		i = i + 1
		local s = steps[i]
		if not s then
			if done then
				done()
			end
			return
		end
		Menu.tween(ui, key, inst, s[1], s[2], step)
	end
	step()
end

-- every board motion stopped (PLAY, a re-layout)
function Menu.stopMotion(ui)
	for key, tw in pairs(ui.Tw or {}) do
		ui.Tw[key] = nil
		tw:Cancel()
	end
end

-- (kit B U4; sign build, the owner's pick "Rope drop") the entrance. On a real join the menu opens at boot under the
-- loading screen: the board waits lifted, the buttons at pop scale 0, and the entrance starts once the loading screen
-- has FADED away (built again first if the screen changed size meanwhile); with no loading screen up (/menu) at once.
-- The board falls on its ropes (Entrance.Drop, Quad In) while PLAY, SETTINGS and UPDATES pop in from their centres
-- (a UIScale "Pop" 0 -> 1, 60 ms apart); Menu.snap follows
function Menu.enter()
	local ui = M.Ui
	if not Menu.lift(ui) then
		return
	end
	Loading.afterFade(function()
		if M.Ui ~= ui or not ui.Swing.Parent or M.Playing then
			return
		end
		local vp = H.viewport()
		if vp.X ~= ui.Vp.X or vp.Y ~= ui.Vp.Y then
			if not H.safe("build", Menu.build, false) or not M.Ui.Swing then
				return
			end
			ui = M.Ui
			Menu.lift(ui)
		end
		Menu.run(ui)
	end)
end

-- the board lifted off the top of the screen, the buttons at pop scale 0
function Menu.lift(ui)
	local swing, rest = ui.Swing, ui.Rest
	if not swing then
		return false
	end
	ui.Phase = "Waiting"
	swing.Position = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset - ui.Lift)
	ui.Pops = {}
	for i, plank in ipairs({ ui.Play, ui.Settings, ui.Updates }) do
		ui.Pops[i] = Util.Create("UIScale", { Name = "Pop", Scale = 0, Parent = plank })
	end
	return true
end

function Menu.run(ui)
	local B, E = K.BOARD, Menu.entrance()
	ui.Phase = "Entering"
	-- (sign/logo build) B2's propellers turn while the board opens; "Spinning" says so, so Menu.sway can stop them at rest
	ui.Board:SetAttribute("Spinning", true)
	SignKit.Spin(ui.Board, true)
	Menu.tween(ui, "Move", ui.Swing, TweenInfo.new(tonumber(E.Drop) or 0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = ui.Rest }, function()
		Menu.snap(ui)
	end)
	for i, pop in ipairs(ui.Pops) do
		TweenService:Create(pop, TweenInfo.new(B.POP_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, B.POP_START + (i - 1) * B.POP), { Scale = 1 }):Play()
	end
end

-- the ropes snap taut: the thunk, two dust puffs, then the gentle bounces (up Bounce[i] design px, Sine Out, back down,
-- Sine In) and the swing legs (Sine InOut from level: no instant tilt); with the sway on, the last leg ends where the
-- sway starts, else the board swings back to level. Then it rests (Menu.sway)
function Menu.snap(ui)
	local E = Menu.entrance()
	local swing, rest = ui.Swing, ui.Rest
	if type(E.Sound) == "string" then
		H.sound(E.Sound)
	end
	H.safe("puffs", Menu.puffs, ui)
	local half = tonumber(E.BounceTime) or 0.13
	local hops = {}
	for _, b in ipairs(E.Bounce or {}) do
		local up = UDim2.new(rest.X.Scale, rest.X.Offset, rest.Y.Scale, rest.Y.Offset - math.floor(tonumber(b) or 0))
		hops[#hops + 1] = { TweenInfo.new(half, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Position = up } }
		hops[#hops + 1] = { TweenInfo.new(half, Enum.EasingStyle.Sine, Enum.EasingDirection.In), { Position = rest } }
	end
	Menu.chain(ui, "Move", swing, hops)
	local legs = {}
	for _, d in ipairs(E.Swing or {}) do
		legs[#legs + 1] = tonumber(d) or 0
	end
	if Menu.swayOn() then
		legs[math.max(1, #legs)] = -(tonumber(Menu.swayCfg().Degrees) or 0)
	else
		legs[#legs + 1] = 0
	end
	local turns = {}
	for _, d in ipairs(legs) do
		turns[#turns + 1] = { TweenInfo.new(tonumber(E.SwingTime) or 0.32, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = d } }
	end
	Menu.chain(ui, "Turn", swing, turns, function()
		ui.Phase = "Rest"
		Menu.sway(ui)
	end)
end

-- two pixel dust puffs beside the awning's ends: three flat white blocks each (no image), drifting out and up while they
-- fade, then gone
function Menu.puffs(ui)
	local at, content = ui.PuffAt, ui.Content
	if not (at and content and content.Parent) then
		return
	end
	local info = TweenInfo.new(tonumber(Menu.entrance().Puff) or 0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, side in ipairs({ -1, 1 }) do
		local x = side < 0 and at.L or at.R
		local puff = H.frame("DustPuff", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(x, at.Y), Size = UDim2.fromOffset(40, 22), ZIndex = 4 }, content)
		for _, b in ipairs({ { 0, 8 }, { 10, 0 }, { 20, 8 } }) do
			local block = H.frame("PuffBlock", {
				BackgroundTransparency = 0,
				BackgroundColor3 = K.WHITE,
				Position = UDim2.fromOffset(b[1], b[2]),
				Size = UDim2.fromOffset(20, 14),
				ZIndex = 4,
			}, puff)
			TweenService:Create(block, info, { BackgroundTransparency = 1 }):Play()
		end
		local drift = TweenService:Create(puff, info, { Position = UDim2.fromOffset(x + side * 26, at.Y - 14) })
		drift.Completed:Connect(function()
			drift:Destroy()
			if puff.Parent then
				puff:Destroy()
			end
		end)
		drift:Play()
	end
end

-- (sign build, the owner's note "make it stay moving gently after dropping") the board at rest sways +-Sway.Degrees about
-- the rope tops (the Swing's centre at the screen top), Sway.Period a full back-and-forth, Sine InOut, endlessly, until
-- PLAY; Camera shake OFF = no sway: the board turns back to level. Called again when the setting changes
function Menu.sway(ui)
	local swing = ui and ui.Swing
	if not swing or not swing.Parent or ui.Phase ~= "Rest" or M.Playing or M.Ui ~= ui then
		return
	end
	local W = Menu.swayCfg()
	local d = tonumber(W.Degrees) or 0
	-- (sign/logo build) B2's propellers turn while it sways and rest level when it does not
	if ui.Board and (ui.Board:GetAttribute("RigSpin") == nil or (ui.Board:GetAttribute("Spinning") == true) ~= Menu.swayOn()) then
		ui.Board:SetAttribute("Spinning", Menu.swayOn())
		SignKit.Spin(ui.Board, Menu.swayOn())
	end
	if Menu.swayOn() then
		if ui.Swaying and ui.Tw.Turn == ui.Swaying then
			return
		end
		local function start()
			ui.Swaying = Menu.tween(ui, "Turn", swing, TweenInfo.new((tonumber(W.Period) or 3.6) / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Rotation = d })
		end
		if math.abs(swing.Rotation + d) > 0.01 then
			Menu.tween(ui, "Turn", swing, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Rotation = -d }, start)
		else
			start()
		end
	else
		ui.Swaying = nil
		if math.abs(swing.Rotation) > 1e-3 then
			Menu.tween(ui, "Turn", swing, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Rotation = 0 })
		elseif ui.Tw.Turn then
			local tw = ui.Tw.Turn
			ui.Tw.Turn = nil
			tw:Cancel()
		end
	end
end

-- (sign build) the title screen laid out again for the screen it is on now (a viewport change): the board keeps its
-- phase (still waiting for the loading screen, or at rest with its sway); an open portrait sheet keeps it hidden
function Menu.relayout()
	local old = M.Ui
	if not M.Open or M.Playing or not M.Menu or not old.Vp then
		return
	end
	local vp = H.viewport()
	if vp.X == old.Vp.X and vp.Y == old.Vp.Y then
		return
	end
	Menu.stopMotion(old)
	if not H.safe("relayout", Menu.build, false) or not M.Ui.Swing then
		return
	end
	local ui = M.Ui
	if old.Phase == "Waiting" then
		Menu.enter()
	else
		ui.Phase = "Rest"
		Menu.sway(ui)
	end
	if M.Win.Name and M.Win.Name ~= "Credits" and vp.Y > vp.X then
		ui.Swing.Visible = false
	end
end

-- (sign build) watch the viewport while the menu is open: every change (and a new CurrentCamera, as at boot) lays the
-- screen out again RELAYOUT s after the last one of a burst (a window drag fires many). on = false disconnects it
function Menu.watch(on)
	for _, key in ipairs({ "Resize", "CameraWatch" }) do
		if M[key] then
			M[key]:Disconnect()
			M[key] = nil
		end
	end
	M.RelayoutToken = (M.RelayoutToken or 0) + 1
	if not on then
		return
	end
	local function schedule()
		M.RelayoutToken = M.RelayoutToken + 1
		local token = M.RelayoutToken
		task.delay(K.BOARD.RELAYOUT, function()
			if M.RelayoutToken == token then
				H.safe("relayout", Menu.relayout)
			end
		end)
	end
	local function hook(camera)
		if M.Resize then
			M.Resize:Disconnect()
			M.Resize = nil
		end
		if camera then
			M.Resize = camera:GetPropertyChangedSignal("ViewportSize"):Connect(schedule)
		end
	end
	hook(Workspace.CurrentCamera)
	pcall(function()
		M.CameraWatch = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			hook(Workspace.CurrentCamera)
			schedule()
		end)
	end)
end

-- (kit B U4) PLAY: every board motion stops (the sway too), the board is pulled up off the screen (0.3 s, Quad In) and
-- the CREDITS tag fades with it
function Menu.leave()
	local B, ui = K.BOARD, M.Ui
	Menu.stopMotion(ui)
	ui.Phase, ui.Swaying = "Leaving", nil
	if ui.Board then
		ui.Board:SetAttribute("Spinning", false)
		SignKit.Spin(ui.Board, false)
	end
	local swing = ui.Swing
	if swing and swing.Parent then
		local p = ui.Rest or swing.Position
		TweenService:Create(swing, TweenInfo.new(B.PULL, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset - (ui.Lift or 600)),
		}):Play()
	end
	if ui.Tag and ui.Tag.Parent then
		Menu.fade(ui.Tag, B.PULL)
	end
end

function H.isTouch()
	local UIS = game:GetService("UserInputService")
	return UIS.TouchEnabled and not UIS.KeyboardEnabled
end

-- a keyboard + mouse device (where MouseLock does anything)
function H.isDesktop()
	local UIS = game:GetService("UserInputService")
	return UIS.KeyboardEnabled == true and UIS.MouseEnabled == true
end

-- MouseLock.Hold / Release for the menu screen (once each way; the module is optional)
function H.mouseHold(on)
	on = on == true
	if (M.MouseHeld == true) == on then
		return
	end
	local ml = H.mod("MouseLock")
	if not ml then
		return
	end
	M.MouseHeld = on
	pcall(on and ml.Hold or ml.Release, K.MOUSE_HOLD)
end

-- (quick wins, win 1) NotifyController.SetHeld for the menu screen: gameplay toasts wait for PLAY (the module is
-- optional; a missing or older one without SetHeld is skipped)
function H.holdToasts(on)
	local notify = H.mod("NotifyController")
	if notify and type(notify.SetHeld) == "function" then
		H.safe("toasts", notify.SetHeld, K.TOAST_HOLD, on == true)
	end
end

function Menu.bindKeys(on)
	if on then
		ContextActionService:BindActionAtPriority(K.ACTION, function(_, state)
			if state == Enum.UserInputState.Begin and M.Open and not M.Win.Name then
				MainMenuController.Play()
				return Enum.ContextActionResult.Sink
			end
			return Enum.ContextActionResult.Pass
		end, false, 3000, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.ButtonA)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.ACTION)
		end)
	end
end

function Menu.fade(menu, seconds)
	local info = TweenInfo.new(seconds)
	for _, d in ipairs(menu:GetDescendants()) do
		if d:IsA("GuiObject") then
			if d.BackgroundTransparency < 1 then
				TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
			end
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				TweenService:Create(d, info, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
end

----------------------------------------------------------------------
-- windows: settings / updates / credits (docked by the window rule)
----------------------------------------------------------------------
local Win = {}

-- gamepad B closes the open window: bound at High priority only while one is open (B is the dash button too), so the
-- press that closes it is sunk; the unbind waits a frame (that press is still being dispatched)
function Win.bindBack(on)
	local W = M.Win
	if on then
		if W.Back then
			return
		end
		W.Back = true
		H.safe("bind back", function()
			ContextActionService:BindActionAtPriority(K.WIN_BACK, function(_, state)
				if not M.Win.Name then
					return Enum.ContextActionResult.Pass
				end
				if state == Enum.UserInputState.Begin then
					H.sound("Click")
					Win.close()
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	elseif W.Back then
		task.defer(function()
			if M.Win.Name or not M.Win.Back then
				return -- another window opened meanwhile (it keeps the binding)
			end
			M.Win.Back = false
			pcall(function()
				ContextActionService:UnbindAction(K.WIN_BACK)
			end)
		end)
	end
end

function Win.close()
	local W = M.Win
	if W.Resize then
		W.Resize:Disconnect()
	end
	if W.Dock then
		pcall(W.Dock.Disconnect)
	end
	if W.Holder then
		W.Holder:Destroy()
	end
	W.Name, W.Holder, W.Dock, W.Panel, W.Resize = nil, nil, nil, nil, nil
	M.Settings.Rows = {}
	if M.Ui.Swing then
		M.Ui.Swing.Visible = true -- (U5) the title screen's board comes back (Win.open hid it behind a portrait sheet)
	end
	if M.Ui.Tag then
		M.Ui.Tag.Visible = true -- (fix round B) and the CREDITS tag (Win.holder hid it on a landscape touch screen)
	end
	Win.bindBack(false)
	Win.touch(false)
	Win.strips(false) -- (playtest 2026-11-28 C27) the currency strips back
end

-- what lies behind a window that opens: the game's windows close on MenuController.WindowOpened (as they do for each
-- other), and the DEV panel (docked right, under the menu's gui) is closed so its buttons never peek out from under it
function Win.clearBehind(name)
	local menu = H.mod("MenuController")
	local signal = menu and menu.WindowOpened
	if type(signal) == "table" and type(signal.Fire) == "function" then
		H.safe("WindowOpened", function()
			signal:Fire(name)
		end)
	end
	local dev = H.mod("DevController")
	if dev and type(dev.IsOpen) == "function" and type(dev.Close) == "function" and dev.IsOpen() then
		H.safe("dev panel", dev.Close)
	end
end

-- (look review of finish pass A, minor: at 844x390 the Settings window covered the title board's right edge) on a
-- landscape screen the window rule docks a window right at 44% of the width, and the board reaches 55% of an 844 px
-- screen: a window that would meet the board's edge (its stroke, shadow and a 4 px gap, and the window's 5 px bevel)
-- gives up those few design px of width. Where it would lose more than a tenth (a 667 px phone) it keeps its size and
-- covers the board as before. Returns the design width to dock
function Win.clearOfBoard(prefW, prefH)
	local vp = H.viewport()
	local board = M.Ui and M.Ui.Board
	if vp.Y > vp.X or not (board and board.Parent and board.Visible and M.Ui.Swing and M.Ui.Swing.Visible ~= false) then
		return prefW
	end
	local ok, r = pcall(NeonKit.SideRect, prefW, prefH)
	if not (ok and type(r) == "table" and r.scale and r.scale > 0) then
		return prefW
	end
	local right = board.AbsolutePosition.X + board.AbsoluteSize.X + 3 + 5 + 4 + 5
	local over = right - r.x
	if over <= 0 then
		return prefW
	end
	local width = r.w / r.scale
	local narrower = math.floor((r.w - over) / r.scale)
	if narrower < width * 0.9 then
		return prefW
	end
	return narrower
end

-- (Pitch 2 fix round B, T1 look leftover 8: at 1920x1080 the 640 px Settings window cut the Mouse lock row at its foot
-- with about 400 px of sky above it; at 844x390 its list's view ended on the Graphics heading, the chips under the fold)
-- a window's height from its list: `fit(contentW)` returns { Content, Rows, Pitch, Gap } (the list's design height at
-- that content width, its row count and pitch, and the gap between rows). The window is as tall as its list; where the
-- screen caps it, it ends on a whole row (never a heading without its strip) and the rest scrolls. Returns the design
-- height to dock, nil when it cannot tell
function Win.fitHeight(prefW, fit)
	local D, Z = K.WIN, SignKit.Sizes
	local ok, r0 = pcall(NeonKit.SideRect, prefW, K.WIN_H)
	if not (ok and type(r0) == "table" and r0.designW) then
		return nil
	end
	local okFit, spec = pcall(fit, math.floor(r0.designW + 0.5) - 2 * Z.Frame - 2 * D.PAD - D.BAR)
	if not (okFit and type(spec) == "table" and tonumber(spec.Content)) then
		return nil
	end
	-- the header, the wood frame round the stone body, the list's margin and the body's lip; SLACK covers the frame and
	-- lip drawn on whole screen px (SignKit.Px) under a phone's scale
	local chrome = D.HEAD_Y + D.HEAD_H + 2 * Z.Frame + 2 * D.PAD + Z.Lip + D.SLACK
	local want = math.ceil(chrome + spec.Content)
	local okR, r = pcall(NeonKit.SideRect, prefW, want)
	if not (okR and type(r) == "table" and r.designH) or r.designH >= want - 0.5 then
		return want
	end
	local pitch, gap = tonumber(spec.Pitch) or 0, tonumber(spec.Gap) or 0
	if pitch <= 0 then
		return nil
	end
	local rows = math.max(1, math.min(tonumber(spec.Rows) or 1, math.floor((r.designH - chrome + gap) / pitch)))
	return math.min(math.floor(r.designH), chrome + rows * pitch - gap)
end

-- a window's root, docked by the window rule (prefW x prefH design px); nil without a gui. `fit` (optional, see
-- Win.fitHeight) sizes its height to its list instead of prefH
function Win.holder(name, prefW, prefH, fit)
	Win.close()
	local gui = Menu.gui()
	if not gui then
		return nil
	end
	prefW = Win.clearOfBoard(prefW, prefH)
	if type(fit) == "function" then
		prefH = Win.fitHeight(prefW, fit) or prefH
	end
	-- (fix round B) on a landscape touch screen the CREDITS tag hangs at the top right, in the docked window's column: a
	-- window cut to its whole rows no longer reaches over it, so the tag waits hidden (half a tag behind the awning) and
	-- comes back on Win.close
	if M.Ui.Tag and M.Ui.TagTop then
		M.Ui.Tag.Visible = false
	end
	local W = M.Win
	local holder = H.frame("Window_" .. name, { Size = UDim2.fromOffset(prefW, prefH), ZIndex = 10 }, gui)
	local fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	W.Dock = NeonKit.Dock(holder, fit, prefW, prefH)
	W.Name, W.Holder = name, holder
	Win.cover(holder)
	Win.clearBehind(name)
	Win.bindBack(true)
	Win.touch(true)
	return holder
end

-- (playtest 2026-11-28 C27: on a landscape phone the docked window left half pieces peeking from under it: the title
-- board's PLAY / UPDATES cut in half where Win.clearOfBoard gave up narrowing, and the HUD's wallet strip beside the
-- awning after PLAY) on a landscape screen a window that still meets the board hides the board (Win.close brings it back,
-- as a portrait sheet's); on a landscape touch screen the currency strips step aside while the window's column reaches
-- under them (HudController.SetCurrencyHidden "MainMenuWin", let go by Win.close).
-- (C27 round 2: on the touch tablets, 1024 x 768 .. 1366 x 1024, the window starts 100+ px under the strips, yet a test of
-- x alone hid the wallet while Settings / What's New / Credits was open) the window's docked box (NeonKit.Dock's Rect, not
-- the holder's AbsolutePosition of the frame that placed it) with its awning decides, by HudController.Overlaps, as the
-- game's windows do (MenuController's HideCurrency "Over")
function Win.cover(holder)
	local vp = H.viewport()
	local rect = M.Win.Dock and M.Win.Dock.Rect
	if vp.X <= vp.Y or not (holder and holder.Parent and rect) then
		return
	end
	local board = M.Ui and M.Ui.Board
	if board and board.Parent and M.Ui.Swing and M.Ui.Swing.Visible ~= false then
		local right = board.AbsolutePosition.X + board.AbsoluteSize.X + 3 + 5 + 4 + 5 -- (Win.clearOfBoard's edge)
		if right > rect.x then
			M.Ui.Swing.Visible = false
		end
	end
	local uis = game:GetService("UserInputService")
	local hud = H.mod("HudController")
	local over = false
	if uis.TouchEnabled and hud and type(hud.Overlaps) == "function" then
		-- (the awning: SignKit.Roof seated at RoofSeat(HEAD_Y), over the window's top by that many design px)
		local above = math.max(0, -SignKit.RoofSeat(K.WIN.HEAD_Y)) * (rect.scale or 1)
		local ok, _, strips = pcall(hud.Overlaps, rect, above)
		over = ok and strips == true
	end
	Win.strips(over)
end

function Win.strips(on)
	on = on == true
	if on == (M.Win.StripsOff == true) then
		return
	end
	M.Win.StripsOff = on
	local hud = H.mod("HudController")
	if hud and type(hud.SetCurrencyHidden) == "function" then
		H.safe("currency strips", hud.SetCurrencyHidden, "MainMenuWin", on)
	end
end

-- (kit-b gate U9 r4) on a touch-only device Roblox's thumbstick and jump button go while a menu window (Settings, What's
-- New, Credits) is open: on 390x844 their zones lay over the Camera shake ON / OFF chips, on 844x390 the jump zone over
-- the list's right end, as the game's windows do (MenuController.SetTouchHidden("MainMenuWin")); back on Win.close
function Win.touch(on)
	local uis = game:GetService("UserInputService")
	local want = on == true and uis.TouchEnabled and not uis.KeyboardEnabled
	if want == (M.Win.TouchOff == true) then
		return
	end
	M.Win.TouchOff = want
	local menu = H.mod("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		H.safe("touch controls", menu.SetTouchHidden, "MainMenuWin", want)
	end
end

-- (F0 review, major 7) on a touch screen an invisible tap under `plank` (its sibling, drawn first so the plank keeps its
-- own press), at least K.WIN.TOUCH design px each way and centred on it; `fn` is the plank's action. Nothing on a mouse
-- screen. Returns the pad
function Win.pad(plank, fn)
	local uis = game:GetService("UserInputService")
	if not (plank and plank.Parent and uis.TouchEnabled) then
		return nil
	end
	local T = K.WIN.TOUCH
	local pw, ph = math.max(plank.Size.X.Offset, T), math.max(plank.Size.Y.Offset, T)
	local ax, ay = plank.AnchorPoint.X, plank.AnchorPoint.Y
	local pos = plank.Position
	local pad = Instance.new("TextButton")
	pad.Name = plank.Name .. "Tap"
	pad.Text = ""
	pad.AutoButtonColor = false
	pad.BackgroundTransparency = 1
	pad.BorderSizePixel = 0
	pad.Selectable = false
	pad.Size = UDim2.fromOffset(pw, ph)
	-- the pad's centre on the plank's centre, whatever the plank's anchor
	pad.AnchorPoint = Vector2.new(0.5, 0.5)
	pad.Position = UDim2.new(pos.X.Scale, pos.X.Offset + (0.5 - ax) * plank.Size.X.Offset, pos.Y.Scale, pos.Y.Offset + (0.5 - ay) * plank.Size.Y.Offset)
	pad.ZIndex = math.max(1, plank.ZIndex - 1)
	pad:SetAttribute("HitFor", plank.Name)
	pad.Activated:Connect(fn)
	pad.Parent = plank.Parent
	return pad
end

-- (kit B U5) a pixel icon in the middle of a plank's face (a plank with no text: Close, - and +); returns the icon
function Win.mark(plank, name, colour, px)
	local face = plank and plank:FindFirstChild("Face", true)
	local icon = face and PixelIcon.New(face, name, px or K.WIN.ICON, colour)
	if icon then
		icon.AnchorPoint = Vector2.new(0.5, 0.5)
		icon.Position = UDim2.fromScale(0.5, 0.5)
		icon.ZIndex = 4
	end
	return icon
end

-- (kit B U5) the window's scrolling list on the stone body (a 16 px margin, room for the scroll bar on the right, the
-- body's lip kept clear)
function Win.list(body)
	local D, Z = K.WIN, SignKit.Sizes
	local list = Instance.new("ScrollingFrame")
	list.Name = "List"
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.Position = UDim2.fromOffset(D.PAD, D.PAD)
	list.Size = UDim2.new(1, -2 * D.PAD, 1, -(2 * D.PAD + Z.Lip))
	list.CanvasSize = UDim2.new()
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.ScrollingDirection = Enum.ScrollingDirection.Y
	list.ScrollBarThickness = 6
	list.ScrollBarImageColor3 = Theme.Sign.Wood
	list.ZIndex = 2
	list.Parent = body
	Util.Create("UIPadding", { PaddingRight = UDim.new(0, D.BAR), Parent = list })
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, D.LIST_GAP),
		Parent = list,
	})
	return list
end

-- (kit B U5, finding 5) a Signboard window like the title screen's board: the flat awning (one fixed-size piece), the
-- navy header with `title` in the Title role (gold, stepped down until it fits), the pixel `icon` on its gold square and
-- the red Close plank with the pixel x, the wood frame and the stone body holding the scrolling list. It is built at the
-- docked design size and rebuilt by `reopen(true)` when the screen changes size (as Credits is). Returns the list and its
-- content width (design px)
function Win.open(name, title, icon, prefH, reopen, fit)
	local holder = Win.holder(name, K.WIN_W, prefH, fit)
	if not holder then
		return nil
	end
	local W, D, Z, Sign = M.Win, K.WIN, SignKit.Sizes, Theme.Sign
	local w = holder.Size.X.Offset
	local vp = H.viewport()
	if M.Ui.Swing and vp.Y > vp.X then
		-- a portrait sheet covers the docked title board but for its awning's ends: the board waits hidden (Win.close)
		M.Ui.Swing.Visible = false
	end
	local sign = H.frame(name .. "Sign", { Size = UDim2.fromScale(1, 1) }, holder)
	-- (look review of finish pass A, major 1: a full-width awning ran past the window and off the screen) the kit's one
	-- short awning, centred and seated on the header's rim as every window's (SignKit.RoofSeat)
	SignKit.Roof(sign, { Width = w >= 400 and 360 or SignKit.Sizes.RoofPhoneW, Y = SignKit.RoofSeat(D.HEAD_Y), ZIndex = 3 })
	local room = w - 2 * Z.Rim - (12 + Z.IconSlot + 12) - (D.CLOSE + 20)
	local size = Theme.RoleSize("Title")
	while size > 22 do
		local ok, m = pcall(Theme.Measure, title, "Title", size)
		-- (playtest 2026-11-28 C25: at 667 x 375 the text filled its box to 0.6 px and the ribbon's band lay flush on the
		-- letters) the room less the ribbon's least pads, 2 px a side (Theme's ribbonLayout)
		if not ok or not m or m.X + 4 <= room then
			break
		end
		size = size - 2
	end
	local _, plate = SignKit.Header(sign, {
		Title = title,
		TitleSize = size,
		IconSlot = true,
		Reserve = D.CLOSE + 20,
		Y = D.HEAD_Y,
		Height = D.HEAD_H,
		ZIndex = 2,
	})
	local slot = plate:FindFirstChild("IconSlot")
	local mark = slot and PixelIcon.New(slot, icon, D.ICON, Sign.Text)
	if mark then
		mark.AnchorPoint = Vector2.new(0.5, 0.5)
		mark.Position = UDim2.fromScale(0.5, 0.5)
	end
	local close = SignKit.Plank(plate, {
		Name = "Close",
		Text = "",
		Style = "Red",
		Width = D.CLOSE,
		Height = D.CLOSE,
		LipPx = 6,
		Edge = Sign.Text, -- the pitch's close X: an ink edge
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		ZIndex = 3,
		Callback = function()
			H.sound("Click")
			Win.close()
		end,
	})
	-- (look review of finish pass A, minor: the closes differed, this one a small white x) the kit's close mark: the 27 px
	-- pixel x in the brown ink on the red block, as the Gifts, Pets and Index windows' (NeonKit.CloseMark Square)
	Win.mark(close, "x", Theme.Sign.Text, 27)
	Win.pad(close, function()
		H.sound("Click")
		Win.close()
	end)
	local wood = SignKit.Frame(sign, { Y = D.HEAD_Y + D.HEAD_H, ZIndex = 1 })
	local body = SignKit.Body(wood)
	W.Panel = body
	local list = Win.list(body)
	local camera = Workspace.CurrentCamera
	if camera and reopen then
		-- one rebuild per burst of size changes (a window drag fires many)
		local pending = false
		W.Resize = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if pending then
				return
			end
			pending = true
			task.defer(function()
				if M.Win.Name == name and M.Win.Holder == holder then
					H.safe(name .. " resize", reopen, true)
				end
			end)
		end)
	end
	return list, w - 2 * Z.Frame - 2 * D.PAD - D.BAR
end

-- a setting's title line on the stone: its pixel icon, the title (brown FredokaOne) and, for a scale, the value
function Win.rowHead(row, title, icon, withValue, width)
	local D, ink = K.WIN, Theme.TextOn("Stone")
	local mark = PixelIcon.New(row, icon, D.ICON, ink)
	if mark then
		mark.Position = UDim2.fromOffset(0, 4)
	end
	local room = width - (D.ICON + 10 + (withValue and 90 or 0))
	local size = 24
	while size > 18 do
		local ok, m = pcall(Theme.Measure, title, "Heading", size)
		if not ok or not m or m.X <= room then
			break
		end
		size = size - 1
	end
	local label = Theme.Label(title, "Heading", { Size = size, Color = ink })
	label.Name = "Title"
	label.Position = UDim2.fromOffset(D.ICON + 10, 0)
	label.Size = UDim2.new(1, -(D.ICON + 10 + (withValue and 90 or 0)), 0, 34)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = row
	if not withValue then
		return nil
	end
	local value = Theme.Label("", "Display", { Size = 26, Color = ink })
	value.Name = "Value"
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, 0, 0, 0)
	value.Size = UDim2.fromOffset(90, 34)
	value.TextXAlignment = Enum.TextXAlignment.Right
	value.Parent = row
	return value
end

-- a 0..10 setting (kit B U5): the title line, then - [a SignKit BlockRow of 10, each block a tap target] +; the first
-- <value> blocks are gold
function Win.sliderRow(parent, key, title, icon, order, width)
	local D = K.WIN
	local row = H.frame("Row_" .. key, { Size = UDim2.new(1, 0, 0, D.ROW_H), LayoutOrder = order }, parent)
	local value = Win.rowHead(row, title, icon, true, width)
	local strip = H.frame("Strip", { Position = UDim2.fromOffset(0, D.STRIP_Y), Size = UDim2.new(1, 0, 0, D.BTN) }, row)
	local function step(delta)
		H.sound("Click")
		ClientSettings.Set(key, (tonumber(ClientSettings.Get(key)) or 0) + delta)
	end
	local minus = SignKit.Plank(strip, { Name = "Minus", Text = "", Width = D.BTN, Height = D.BTN, Callback = function()
		step(-1)
	end })
	Win.mark(minus, "minus", Theme.Sign.Text)
	local plus = SignKit.Plank(strip, { Name = "Plus", Text = "", Width = D.BTN, Height = D.BTN, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Callback = function()
		step(1)
	end })
	Win.mark(plus, "plus", Theme.Sign.Text)
	Win.pad(minus, function()
		step(-1)
	end)
	Win.pad(plus, function()
		step(1)
	end)
	local trackW = width - 2 * (D.BTN + D.GAP)
	local bw = math.max(10, math.floor((trackW - 9 * D.BLOCK_GAP) / 10))
	local rowW = 10 * bw + 9 * D.BLOCK_GAP
	local blocks = SignKit.BlockRow(strip, {
		Count = 10,
		BlockW = bw,
		BlockH = D.BLOCK_H,
		Gap = D.BLOCK_GAP,
		Position = UDim2.fromOffset(D.BTN + D.GAP + math.floor((trackW - rowW) / 2), math.floor((D.BTN - SignKit.Sizes.Lip - D.BLOCK_H) / 2) + 2),
	})
	for i = 1, 10 do
		local tap = Instance.new("TextButton")
		tap.Name = "Step" .. i
		tap.Text = ""
		tap.AutoButtonColor = false
		tap.BackgroundTransparency = 1
		tap.BorderSizePixel = 0
		tap.Size = UDim2.fromScale(1, 1)
		if game:GetService("UserInputService").TouchEnabled then
			-- (F0 review, major 7) a thumb's step: K.WIN.TOUCH tall, centred on the block, reaching half the gap to each
			-- neighbour (the ten taps touch: the strip is one slider)
			tap.AnchorPoint = Vector2.new(0.5, 0.5)
			tap.Position = UDim2.fromScale(0.5, 0.5)
			tap.Size = UDim2.new(1, D.BLOCK_GAP, 0, math.max(D.BLOCK_H, D.TOUCH))
		end
		tap.ZIndex = 3
		tap.Activated:Connect(function()
			H.sound("Click")
			local current = tonumber(ClientSettings.Get(key)) or 0
			ClientSettings.Set(key, (current == i and i == 1) and 0 or i)
		end)
		tap.Parent = blocks:FindFirstChild("Block" .. i)
	end
	local function paint()
		local v = tonumber(ClientSettings.Get(key)) or 0
		value.Text = v == 0 and "OFF" or tostring(v)
		SignKit.FillBlocks(blocks, v)
	end
	paint()
	M.Settings.Rows[key] = paint
	return row
end

-- chips (kit B U5): one of `options` ({ { Text, Value } }) for `key`, as planks side by side; the selected one is gold
-- with its lip (the pitch's .bt.sel: gold is "selected", green stays the one main action), the others stone. A chip is
-- rebuilt when its state changes
function Win.chipRow(parent, key, title, icon, options, order, width)
	local D = K.WIN
	local row = H.frame("Row_" .. key, { Size = UDim2.new(1, 0, 0, D.ROW_H), LayoutOrder = order }, parent)
	Win.rowHead(row, title, icon, false, width)
	local strip = H.frame("Chips", { Position = UDim2.fromOffset(0, D.STRIP_Y), Size = UDim2.new(1, 0, 0, D.BTN) }, row)
	local chips = {}
	local n = #options
	local chipW = math.floor((width - D.GAP * (n - 1)) / n)
	local function paint()
		local v = ClientSettings.Get(key)
		for i, opt in ipairs(options) do
			local selected = v == opt[2]
			local old = chips[i]
			if not old or old:GetAttribute("Selected") ~= selected then
				local chip = SignKit.Plank(strip, {
					Name = "Chip_" .. tostring(opt[1]),
					Text = opt[1],
					Style = selected and "Gold" or "Stone",
					Width = chipW,
					Height = D.BTN,
					TextSize = 22,
					Position = UDim2.fromOffset((i - 1) * (chipW + D.GAP), 0),
					LayoutOrder = i,
					Callback = function()
						H.sound("Click")
						ClientSettings.Set(key, opt[2])
					end,
				})
				chip:SetAttribute("Selected", selected)
				if old then
					old:Destroy()
				end
				chips[i] = chip
				-- (F0 review, major 7) the chip's thumb tap under it, made once (the chip is rebuilt on a change)
				if not strip:FindFirstChild(chip.Name .. "Tap") then
					local pad = Win.pad(chip, function()
						H.sound("Click")
						ClientSettings.Set(key, opt[2])
					end)
					if pad then
						pad.Size = UDim2.fromOffset(chipW, pad.Size.Y.Offset) -- (side by side: no reach over a neighbour)
					end
				end
			end
		end
	end
	paint()
	M.Settings.Rows[key] = paint
	return row
end

-- quiet: a rebuild after a screen resize (no click, the window was already open)
function MainMenuController.OpenSettings(quiet)
	local desktop = H.isDesktop()
	local note = "Low graphics hides small decorations and glow. Saved to your account."
	if desktop then
		local ml = H.mod("MouseLock")
		local free = (ml and ml.KEY_NAME) and (" (press " .. ml.KEY_NAME .. " to free it)") or ""
		note = "Mouse lock: the mouse turns the camera" .. free .. ". Low graphics hides small decorations and glow. Saved to your account."
	end
	-- (Pitch 2 fix round B, T1 look leftover 8) the window as tall as its rows and note (Win.fitHeight); a short screen
	-- ends it on a whole row
	local D = K.WIN
	local rows = desktop and 5 or 4
	local function fit(contentW)
		-- the note's lines from its one-line width (a tenth spare for the words that break early): TextService wraps a
		-- measure only in Roblox, not in the test mock
		local okM, m = pcall(Theme.Measure, note, "Label", 18)
		local lines = (okM and m and contentW > 0) and math.max(1, math.ceil(m.X / (contentW * 0.9))) or 3
		local noteH = math.max(24, lines * math.ceil((okM and m and m.Y > 0) and m.Y or 24))
		return { Content = rows * (D.ROW_H + D.LIST_GAP) + noteH, Rows = rows, Pitch = D.ROW_H + D.LIST_GAP, Gap = D.LIST_GAP }
	end
	local list, width = Win.open("Settings", "SETTINGS", "gear", K.WIN_H, MainMenuController.OpenSettings, fit)
	if not list then
		return
	end
	if quiet ~= true then
		H.sound("Click")
		SignKit.Rise(M.Win.Holder) -- (Pitch 2 F0, look review of finish pass A) the kit's open: 12 px in 3 hard steps
	end
	Win.sliderRow(list, "Music", "Music", "music", 1, width)
	Win.sliderRow(list, "Sfx", "Sound", "speaker", 2, width)
	Win.chipRow(list, "Gfx", "Graphics", "monitor", { { "AUTO", "Auto" }, { "LOW", "Low" }, { "HIGH", "High" } }, 3, width)
	Win.chipRow(list, "Shake", "Camera shake", "shake", { { "ON", true }, { "OFF", false } }, 4, width)
	if desktop then
		-- (bug batch 2 #21: on by default; the key that frees it is in the note below)
		Win.chipRow(list, "MouseLock", "Mouse lock (recommended)", "mouse", { { "ON", true }, { "OFF", false } }, 5, width)
	end
	local label = Theme.Label(note, "Label", { Size = 18, Color = Theme.Sign.TextMuted })
	label.Name = "Note"
	label.TextWrapped = true
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.Size = UDim2.new(1, 0, 0, 24)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.LayoutOrder = 6
	label.Parent = list
end

-- an update's version head (kit B U5): a navy plank (the pitch's sign: a gold-lip edge, a darker navy lip) with
-- "vN · Title" in FredokaOne gold, stepped down until it fits, then truncated
function Win.versionHead(parent, name, text, order, width, newest)
	local Z, Sign = SignKit.Sizes, Theme.Sign
	local h = newest and 50 or 44
	local head = H.frame(name, { Size = UDim2.new(1, 0, 0, h), LayoutOrder = order }, parent)
	local block = H.frame("Block", { BackgroundTransparency = 0, BackgroundColor3 = Sign.GoldLip, Size = UDim2.fromScale(1, 1) }, head)
	H.frame("Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Sign.NavyLip,
		Position = UDim2.fromOffset(Z.Edge, Z.Edge),
		Size = UDim2.new(1, -2 * Z.Edge, 1, -2 * Z.Edge),
	}, block)
	local face = H.frame("Face", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Sign.Navy,
		Position = UDim2.fromOffset(Z.Edge, Z.Edge),
		Size = UDim2.new(1, -2 * Z.Edge, 1, -(2 * Z.Edge + 6)),
		ZIndex = 2,
	}, block)
	local size = newest and 24 or 21
	local room = width - 2 * Z.Edge - 24
	while size > 16 do
		local ok, m = pcall(Theme.Measure, text, "Heading", size)
		if not ok or not m or m.X <= room then
			break
		end
		size = size - 1
	end
	local label = Theme.Label(text, "Heading", { Size = size, Color = Sign.Gold })
	label.Name = "Label"
	label.Position = UDim2.fromOffset(12, 0)
	label.Size = UDim2.new(1, -24, 1, 0)
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 3
	label.Parent = face
	return head
end

-- an update's line (kit B U5): a 6 px square bullet, then the text in Nunito brown on the stone, as tall as it wraps
function Win.noteLine(parent, name, text, order)
	local D, ink = K.WIN, Theme.TextOn("Stone")
	local line = H.frame(name, { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, parent)
	H.frame("Bullet", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Sign.Wood,
		Position = UDim2.fromOffset(4, 9),
		Size = UDim2.fromOffset(D.BULLET, D.BULLET),
	}, line)
	local label = Theme.Label(tostring(text), "Body", { Size = 19, Color = ink })
	label.Name = "Text"
	label.Position = UDim2.fromOffset(4 + D.BULLET + 10, 0)
	label.Size = UDim2.new(1, -(4 + D.BULLET + 10), 0, 24)
	label.AutomaticSize = Enum.AutomaticSize.Y
	label.TextWrapped = true
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Top
	label.Parent = line
	return line
end

-- quiet: a rebuild after a screen resize (no click, the window was already open)
function MainMenuController.OpenUpdates(quiet)
	local list, width = Win.open("Updates", "WHAT'S NEW", "scroll", K.WIN_H, MainMenuController.OpenUpdates)
	if not list then
		return
	end
	if quiet ~= true then
		H.sound("Click")
		SignKit.Rise(M.Win.Holder) -- (Pitch 2 F0, look review of finish pass A) the kit's open: 12 px in 3 hard steps
	end
	local notes = H.notes()
	local order = 0
	for _, note in ipairs(notes and notes.Notes or {}) do
		order = order + 1
		Win.versionHead(list, "Head" .. order, "v" .. tostring(note.Version) .. " \194\183 " .. tostring(note.Title or ""), order * 100, width, order == 1)
		for i, line in ipairs(note.Lines or {}) do
			Win.noteLine(list, "Line" .. order .. "_" .. i, line, order * 100 + i)
		end
	end
	if notes and tonumber(notes.Latest) then
		ClientSettings.Set("SeenNotes", notes.Latest)
	end
	Menu.refreshBadge()
end

----------------------------------------------------------------------
-- the Credits window (credits look B "Signed by the Maker"): a Signboard window built from Frames
----------------------------------------------------------------------
local Credits = {}

-- the owner's texts (UpdateNotes.Credits: the one place they live)
function Credits.texts()
	local notes = H.notes()
	local c = notes and notes.Credits
	return type(c) == "table" and c or {}
end

-- the headshot's user: the game's owner when a user owns it, else the creator's account (Config.CreatorUserId)
function Credits.creatorId()
	local id = nil
	pcall(function()
		if game.CreatorType == Enum.CreatorType.User and tonumber(game.CreatorId) and game.CreatorId > 0 then
			id = game.CreatorId
		end
	end)
	return id or tonumber(Config.CreatorUserId)
end

-- "rbxassetid://<id>" of a TextureIds key, nil while it has no id
function Credits.image(key)
	return H.textureImage(key)
end

-- the headshot into `label` (a web call: once per user, off the build)
function Credits.headshot(label, userId)
	if not userId then
		return
	end
	local cached = M.Heads[userId]
	if type(cached) == "string" then
		label.Image = cached
		return
	end
	task.spawn(function()
		local ok, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
		end)
		if ok and type(content) == "string" and content ~= "" then
			M.Heads[userId] = content
			if label.Parent then
				label.Image = content
			end
		end
	end)
end

-- a plain text on the cream body (no outline: dark ink on a light card reads by itself)
function Credits.text(name, text, role, size, color, props, parent)
	local l = Theme.Label(tostring(text or ""), role, { Size = size, Color = color, Stroke = 1 })
	l.Name = name
	for key, value in pairs(props) do
		l[key] = value
	end
	l.Parent = parent
	return l
end

function Credits.stroke(parent, color, thickness)
	return Util.Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = parent,
	})
end

-- a text's width in px (TextService: the real font). K.CR.MEASURE(text, size, font, face) replaces it when set:
-- tools/dump_gui.lua's renders pass the renderer's font metrics (the mock's GetTextSize is a flat 0.5 em per
-- character). GetTextSize knows no FontFace: a face text is measured with its role font, times FACE_SPARE.
function Credits.textW(text, size, font, face)
	local C = K.CR
	text = tostring(text or "")
	-- one layout tries many sizes: a text is measured once per build (Credits.layout starts a fresh cache)
	local key = text .. "|" .. tostring(size) .. "|" .. tostring(font) .. "|" .. tostring(face)
	local cache = Credits.Widths
	if cache and cache[key] then
		return cache[key]
	end
	local ok, v = pcall(function()
		if type(C.MEASURE) == "function" then
			return C.MEASURE(text, size, font, face)
		end
		local w = Theme.Measure(text, font, size, 100000).X
		return face and w * C.FACE_SPARE or w
	end)
	if not (ok and type(v) == "number") then
		v = #text * size * 0.55
	end
	if cache then
		cache[key] = v
	end
	return v
end

-- the rows `text` wraps to in `width` px (Roblox wraps on spaces) and the widest single word
function Credits.wrap(text, size, font, face, width)
	local rows, line, widest = 0, nil, 0
	for word in tostring(text or ""):gmatch("%S+") do
		widest = math.max(widest, Credits.textW(word, size, font, face))
		local try = line and (line .. " " .. word) or word
		if line and Credits.textW(try, size, font, face) > width then
			rows = rows + 1
			line = word
		else
			line = try
		end
	end
	return rows + (line and 1 or 0), widest
end

-- the polaroid's numbers for a side of P design px: white frame, square photo, caption band
function Credits.polaroidSize(L, P)
	L.P = P
	L.Border = math.max(6, math.floor(P * 0.055 + 0.5))
	L.Photo = P - 2 * L.Border
	L.CapSize = math.max(18, math.floor(P * 0.105 + 0.5))
	L.CapH = L.CapSize + math.max(10, math.floor(P * 0.09 + 0.5))
	L.PolH = L.Border + L.Photo + L.CapH
end

-- the column's rows top to bottom (column px) for its width L.ColW: a row that meets the sticker (narrow[row]) ends
-- left of it; the signature as big as its row allows (<= sigMax); the thank-you line as many rows as it wraps to
function Credits.rows(L, texts, sigMax, narrow)
	local C = K.CR
	local function rowW(key)
		return narrow[key] and math.floor(math.min(L.ColW, L.StickerLeft - L.ColX - 6)) or L.ColW
	end
	local small = L.Small
	-- the plank fits the wordmark (1024:230), as wide as the column allows
	L.PadX, L.PadY = small and 10 or 14, small and 8 or 10
	local wmH = small and 44 or 62
	local wmW = wmH * C.WM_ASPECT
	if wmW > L.ColW - 2 * L.PadX then
		wmW = L.ColW - 2 * L.PadX
		wmH = wmW / C.WM_ASPECT
	end
	L.WmW, L.WmH = math.floor(wmW), math.floor(wmH)
	L.PlankW, L.PlankH = L.WmW + 2 * L.PadX, L.WmH + 2 * L.PadY
	L.CreatedW, L.SigW, L.ThanksW = rowW("Created"), rowW("Sig"), rowW("Thanks")
	local sigFont = Theme.Fonts.Signature
	local em = Credits.textW(texts.Creator, 100, sigFont) / 100 * C.SIG_SPARE
	L.SigSize = math.max(C.SIG_MIN, math.min(sigMax, math.floor(L.SigW / math.max(em, 1))))
	L.SigH = math.ceil(L.SigSize * 1.2)
	local lines, widest = Credits.wrap(texts.Thanks, L.ThanksSize, Theme.Fonts.Body, Theme.Faces.Thanks, L.ThanksW - 2)
	L.ThanksLines = math.max(1, lines)
	-- every row's text fits its width: the signature on one line, CREATED BY, no thank-you word wider than its row
	local createdW = Credits.textW(texts.Role, L.CreatedSize, Theme.Fonts.Label, Theme.Faces.Caps)
	L.RowsFit = L.SigSize * em <= L.SigW and widest <= L.ThanksW - 2 and createdW <= L.CreatedW - 2
	L.ThanksH = L.ThanksLines * math.ceil(L.ThanksSize * 1.25) + 4
	local gapPlank = small and 8 or 14
	local gapThanks = small and 6 or 10
	L.PlankY = 0
	L.CreatedY = L.PlankH + gapPlank
	L.CreatedH = L.CreatedSize + 6
	L.SigY = L.CreatedY + L.CreatedH
	L.SwashY = L.SigY + math.floor(L.SigSize * 1.04) -- just under the name's baseline (the text sits centred in SigH)
	L.ThanksY = L.SwashY + gapThanks + 6
	L.ColH = L.ThanksY + L.ThanksH
end

-- the column in its room (centred below the polaroid when stacked, beside it otherwise); true when it fits. Rows that
-- reach down to the sticker's tilted box (the leaning signature's box a little lower) are narrowed and the column
-- laid out again, until no new row meets it
function Credits.placeColumn(L, texts, sigMax, pad)
	local narrow = {}
	local room = (L.BodyH - pad) - L.ColTop
	for _ = 1, 4 do
		Credits.rows(L, texts, sigMax, narrow)
		L.ColY = L.ColTop + math.max(0, math.floor((room - L.ColH) / 2))
		local added = false
		if L.ColX + L.ColW > L.StickerLeft then
			for _, row in ipairs({
				{ "Created", L.CreatedY + L.CreatedH },
				{ "Sig", L.SigY + L.SigH + math.ceil(L.SigW * 0.06) },
				{ "Thanks", L.ThanksY + L.ThanksH },
			}) do
				if not narrow[row[1]] and L.ColY + row[2] + 2 > L.StickerTop then
					narrow[row[1]] = true
					added = true
				end
			end
		end
		if not added then
			break
		end
	end
	return L.ColH <= room and L.RowsFit
end

-- every number of the body's layout for a window of w x h design px (stacked: the polaroid above the text; a portrait
-- screen too short for that falls back to side by side, L.Stacked says which)
function Credits.layout(w, h, stacked, texts)
	local C = K.CR
	Credits.Widths = {}
	local L = { Stacked = stacked }
	local small = stacked or (w - 2 * C.WOOD) < C.WIDE_MIN
	L.Small = small
	L.HeadH = small and C.HEAD_H_SMALL or C.HEAD_H
	L.HeadY = C.ROOF_H
	L.WoodY = L.HeadY + L.HeadH
	L.WoodH = h - L.WoodY - C.DROP
	L.BodyW = w - 2 * C.WOOD
	L.BodyH = L.WoodH - 2 * C.WOOD
	local pad = small and 12 or 18

	-- the sticker: bottom-right corner; its tilted box (ring included) is what the texts keep clear of
	L.S = small and 60 or 92
	L.Ring = small and 3 or 4
	local inset = small and 12 or 16
	L.StickerX = L.BodyW - inset - L.S / 2
	L.StickerY = L.BodyH - inset - L.S / 2
	local a = math.rad(C.STICKER_TILT)
	local half = L.S / 2 * (math.abs(math.cos(a)) + math.abs(math.sin(a))) + L.Ring
	L.StickerLeft = L.StickerX - half
	L.StickerTop = L.StickerY - half

	L.Pin = small and 18 or 22
	L.CreatedSize = small and 18 or 20
	L.ThanksSize = small and 18 or 20
	local sigMax = small and 54 or 72

	-- stacked: the column as wide as the body, the polaroid as big as the height left above it allows
	if stacked then
		L.ColX = pad + 4
		L.ColW = L.BodyW - 2 * L.ColX
		L.PolX = L.BodyW / 2
		for P = 140, C.STACK_P_MIN, -2 do
			Credits.polaroidSize(L, P)
			L.PolY = pad + L.Pin / 2 + L.PolH / 2
			L.ColTop = pad + L.Pin / 2 + L.PolH + 10
			if Credits.placeColumn(L, texts, sigMax, pad) then
				return L
			end
		end
		-- too short to stack (a small portrait phone): side by side in the same window
		L.Stacked = false
	end

	-- side by side: the polaroid as big as the height allows and the column's minimum width leaves; smaller still
	-- (then a smaller signature) until the column fits beside it
	local gapCol = small and 10 or 18
	local function side(P)
		Credits.polaroidSize(L, P)
		L.PolX = pad + P * 0.56
		L.PolY = L.BodyH / 2 + L.Pin / 4
		L.ColX = math.floor(P * 1.12) + pad + gapCol
		L.ColW = L.BodyW - L.ColX - pad
		L.ColTop = pad
	end
	local pMax = math.min(small and 150 or 210, math.floor((L.BodyH - 2 * pad - 20) / 1.22),
		math.floor((L.BodyW - 2 * pad - gapCol - C.COL_MIN) / 1.12))
	pMax = math.max(C.P_MIN, pMax)
	for P = pMax, C.P_MIN, -4 do
		side(P)
		if Credits.placeColumn(L, texts, sigMax, pad) then
			return L
		end
	end
	side(C.P_MIN)
	for size = sigMax - 2, C.SIG_MIN, -2 do
		if Credits.placeColumn(L, texts, size, pad) then
			return L
		end
	end
	return L
end

-- the roof: SignKit's gable (two tilted slopes whose lower parts hide behind the header, a darker fascia board, a round
-- vent) in this window's approved colours; one fixed-size piece centred on the header, whatever the window's width
function Credits.roof(parent)
	local C, S = K.CR, K.SIGN
	return SignKit.Roof(parent, {
		Shape = "Gable", -- the owner's approved look (not the kit's flat awning; morning item M5)
		Width = C.ROOF_W,
		Height = C.ROOF_H,
		Slope = C.SLOPE_T,
		Fascia = C.FASCIA_H,
		Color = S.Roof,
		Shade = S.RoofShade,
		Vent = S.Cream,
		VentEdge = S.WoodDark,
		ZIndex = 2,
	})
end

-- the header: SignKit's header (dark wood rim, navy plate) with CREDITS in white over its drop line, and the drawn red X
function Credits.head(parent, L)
	local C, S = K.CR, K.SIGN
	local closeSize = L.Small and 38 or 44
	local head, plate = SignKit.Header(parent, {
		Title = C.TITLE,
		TitleRole = "Sign",
		TitleSize = L.Small and 28 or Theme.Sizes.Sign,
		TitleColor = K.WHITE,
		Drop = S.Drop,
		TitleX = 18,
		Reserve = closeSize + 20,
		Y = L.HeadY,
		Height = L.HeadH,
		Rim = C.RIM,
		RimColor = S.WoodDark,
		Color = S.Navy,
		Finish = false, -- (Pitch 2 F0) the approved Credits look keeps its own finish (tools/fixtures/credits_tree_u1.txt)
		ZIndex = 3,
	})
	-- (kit-b gate U9 round 3: it drew the old rounded neon red button) the kit's one close block, as every kit B window's
	local close = CloudUI.Button({
		Name = "Close",
		Text = "",
		Style = "Red",
		Skin = "Sign",
		Finish = false, -- (Pitch 2 F0) the approved Credits window keeps its tree
		TextSize = 24,
		Size = UDim2.fromOffset(closeSize, closeSize),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		ZIndex = 3,
		Callback = function()
			H.sound("Click")
			Win.close()
		end,
		Parent = plate,
	})
	NeonKit.CloseMark(close, { Square = true, Ink = Theme.Sign.RedLip, Color = Theme.Sign.Text })
	NeonKit.CloseBlock(close)
	return head
end

-- the polaroid: white frame, sky-gradient photo with the headshot, a red pin, the marker caption
function Credits.polaroid(body, L, texts)
	local C, S = K.CR, K.SIGN
	H.frame("PolaroidShadow", {
		BackgroundTransparency = 0.78,
		BackgroundColor3 = S.Shadow,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(L.PolX + 4, L.PolY + 6),
		Size = UDim2.fromOffset(L.P, L.PolH),
		Rotation = C.POLAROID_TILT,
		ZIndex = 2,
	}, body)
	local pol = H.frame("Polaroid", {
		BackgroundTransparency = 0,
		BackgroundColor3 = K.WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(L.PolX, L.PolY),
		Size = UDim2.fromOffset(L.P, L.PolH),
		Rotation = C.POLAROID_TILT,
		ZIndex = 3,
	}, body)
	local photo = H.frame("Photo", {
		BackgroundTransparency = 0,
		BackgroundColor3 = K.WHITE,
		Position = UDim2.fromOffset(L.Border, L.Border),
		Size = UDim2.fromOffset(L.Photo, L.Photo),
	}, pol)
	Util.Create("UIGradient", { Color = ColorSequence.new(S.SkyTop, S.SkyBottom), Rotation = 90, Parent = photo })
	photo:SetAttribute("Art", "polaroid photo") -- (kit-b gate U9 round 3) the photo's sky is the picture's own paint, not a gloss
	Credits.stroke(photo, S.PhotoEdge, 1)
	local avatar = Instance.new("ImageLabel")
	avatar.Name = "Avatar"
	avatar.BackgroundTransparency = 1
	avatar.BorderSizePixel = 0
	avatar.Size = UDim2.fromScale(1, 1)
	avatar.ScaleType = Enum.ScaleType.Fit
	avatar.Image = ""
	avatar.Parent = photo
	Credits.headshot(avatar, Credits.creatorId())
	Credits.text("Caption", texts.Caption, "Signature", L.CapSize, S.Caption, {
		Position = UDim2.fromOffset(0, L.Border + L.Photo),
		Size = UDim2.fromOffset(L.P, L.CapH),
	}, pol)
	local pin = H.frame("Pin", {
		BackgroundTransparency = 0,
		BackgroundColor3 = S.Pin,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(L.P / 2, 2),
		Size = UDim2.fromOffset(L.Pin, L.Pin),
		ZIndex = 2,
	}, pol)
	H.corner(pin)
	pin:SetAttribute("Art", "push pin") -- (gate U9 round 3) the polaroid's round push pin is a drawn prop
	Credits.stroke(pin, S.PinDark, 1.5)
	local shine = H.frame("PinShine", {
		BackgroundTransparency = 0.15,
		BackgroundColor3 = K.WHITE,
		Position = UDim2.fromScale(0.24, 0.2),
		Size = UDim2.fromScale(0.3, 0.3),
		ZIndex = 3,
	}, pin)
	H.corner(shine)
	return pol
end

-- the text column: the plank with the wordmark, CREATED BY, the signature + swash, the thank-you line
function Credits.column(body, L, texts)
	local C, S = K.CR, K.SIGN
	local col = H.frame("Column", {
		Position = UDim2.fromOffset(L.ColX, L.ColY),
		Size = UDim2.fromOffset(L.ColW, L.ColH),
		ZIndex = 3,
	}, body)
	local plank = H.frame("Plank", {
		BackgroundTransparency = 0,
		BackgroundColor3 = S.Navy,
		Position = UDim2.fromOffset(0, L.PlankY),
		Size = UDim2.fromOffset(L.PlankW, L.PlankH),
	}, col)
	Credits.stroke(plank, S.WoodDark, 3)
	for _, side in ipairs({ { "NailL", 0 }, { "NailR", 1 } }) do
		local nail = H.frame(side[1], {
			BackgroundTransparency = 0,
			BackgroundColor3 = S.Ring,
			AnchorPoint = Vector2.new(side[2], 0.5),
			Position = UDim2.new(side[2], side[2] == 0 and 4 or -4, 0.5, 0),
			Size = UDim2.fromOffset(5, 5),
			ZIndex = 2,
		}, plank)
		-- (kit-b gate U9 round 3) square nail heads, as every kit B board's (SignKit.Nails); they were round
	end
	local wordmark = Credits.image(C.WORDMARK)
	if wordmark then
		local wm = Instance.new("ImageLabel")
		wm.Name = "Wordmark"
		wm.BackgroundTransparency = 1
		wm.BorderSizePixel = 0
		wm.AnchorPoint = Vector2.new(0.5, 0.5)
		wm.Position = UDim2.fromScale(0.5, 0.5)
		wm.Size = UDim2.fromOffset(L.WmW, L.WmH)
		wm.ScaleType = Enum.ScaleType.Fit
		wm.Image = wordmark
		wm.ZIndex = 3
		Util.Create("UIAspectRatioConstraint", { AspectRatio = C.WM_ASPECT, Parent = wm })
		wm.Parent = plank
	else
		-- no uploaded picture (a fresh place): the studio's name on the plank
		Credits.text("WordmarkText", texts.Studio, "Heading", L.Small and 18 or 22, K.WHITE, {
			Size = UDim2.fromScale(1, 1),
			ZIndex = 3,
		}, plank)
	end
	Credits.text("CreatedBy", texts.Role, "Label", L.CreatedSize, S.Muted, {
		Position = UDim2.fromOffset(2, L.CreatedY),
		Size = UDim2.fromOffset(L.CreatedW - 2, L.CreatedH),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
	}, col)
	Theme.Face(col:FindFirstChild("CreatedBy"), "Caps")
	local sig = Credits.text("Signature", texts.Creator, "Signature", L.SigSize, S.Navy, {
		Position = UDim2.fromOffset(0, L.SigY),
		Size = UDim2.fromOffset(L.SigW, L.SigH),
		TextXAlignment = Enum.TextXAlignment.Left,
		Rotation = C.SIG_TILT,
		ZIndex = 2,
	}, col)
	-- the swash: one round pen stroke under the name (a child of the name: it leans with it)
	local swashW = math.min(L.SigW - 24, math.floor(L.SigSize * 3.1))
	local swash = H.frame("Swash", { -- (gate U9 round 3: Art, the signature's pen stroke)
		BackgroundTransparency = 0,
		BackgroundColor3 = S.Navy,
		Position = UDim2.fromOffset(math.floor(L.SigSize * 0.12), L.SwashY - L.SigY),
		Size = UDim2.fromOffset(swashW, L.Small and 4 or 5),
	}, sig)
	H.corner(swash)
	swash:SetAttribute("Art", "signature swash")
	Credits.text("Thanks", texts.Thanks, "Body", L.ThanksSize, S.Gold, {
		Position = UDim2.fromOffset(2, L.ThanksY),
		Size = UDim2.fromOffset(L.ThanksW - 2, L.ThanksH),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	}, col)
	Theme.Face(col:FindFirstChild("Thanks"), "Thanks")
	return col
end

-- the round SF emblem, a gold ring, tilted, in the body's bottom-right corner
function Credits.sticker(body, L)
	local C, S = K.CR, K.SIGN
	local shadow = H.frame("StickerShadow", {
		BackgroundTransparency = 0.72,
		BackgroundColor3 = S.Shadow,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(L.StickerX + 2, L.StickerY + 4),
		Size = UDim2.fromOffset(L.S, L.S),
		ZIndex = 4,
	}, body)
	H.corner(shadow)
	shadow:SetAttribute("Art", "emblem sticker") -- (gate U9 round 3) the studio's round emblem sticker is a drawn prop
	-- the gold ring is its own round disc behind the emblem: a UIStroke on the ImageLabel drew as a square in Studio
	-- (2026-11-13), and a circle needs no tilt
	local ring = H.frame("StickerRing", {
		BackgroundTransparency = 0,
		BackgroundColor3 = S.Ring,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(L.StickerX, L.StickerY),
		Size = UDim2.fromOffset(L.S + 2 * L.Ring, L.S + 2 * L.Ring),
		ZIndex = 4,
	}, body)
	H.corner(ring)
	ring:SetAttribute("Art", "emblem sticker")
	local emblem = Credits.image(C.EMBLEM)
	local sticker = Instance.new("ImageLabel")
	sticker.Name = "Sticker"
	sticker.BackgroundTransparency = emblem and 1 or 0
	sticker.BackgroundColor3 = S.Navy
	sticker.BorderSizePixel = 0
	sticker.AnchorPoint = Vector2.new(0.5, 0.5)
	sticker.Position = UDim2.fromOffset(L.StickerX, L.StickerY)
	sticker.Size = UDim2.fromOffset(L.S, L.S)
	sticker.ScaleType = Enum.ScaleType.Fit
	sticker.Image = emblem or ""
	sticker.Rotation = C.STICKER_TILT
	sticker.ZIndex = 5
	H.corner(sticker)
	sticker:SetAttribute("Art", "emblem sticker")
	sticker.Parent = body
	return sticker
end

-- builds the whole window into the docked holder (its design size is the dock's)
function Credits.build(holder, stacked)
	local C, S = K.CR, K.SIGN
	local texts = Credits.texts()
	local w, h = holder.Size.X.Offset, holder.Size.Y.Offset
	local L = Credits.layout(w, h, stacked, texts)
	local sign = H.frame("CreditsSign", { Size = UDim2.fromScale(1, 1) }, holder)
	H.frame("Drop", {
		BackgroundTransparency = 0.6,
		BackgroundColor3 = S.Drop,
		Position = UDim2.fromOffset(0, L.HeadY + C.DROP),
		Size = UDim2.new(1, 0, 0, L.HeadH + L.WoodH),
		ZIndex = 1,
	}, sign)
	Credits.roof(sign)
	Credits.head(sign, L)
	local wood = SignKit.Frame(sign, { Y = L.WoodY, Height = L.WoodH, Color = S.Wood, ZIndex = 3, Finish = false })
	-- the cream body has no stone lip (the approved look); its inner line instead (no kit finish: Pitch 2 F0)
	local body = SignKit.Body(wood, {
		Inset = C.WOOD,
		Color = S.Cream,
		Lip = 0,
		Line = { Inset = C.LINE, Thickness = C.LINE_T, Color = S.CreamLine },
		Finish = false,
	})
	Credits.polaroid(body, L, texts)
	Credits.column(body, L, texts)
	Credits.sticker(body, L)
	holder:SetAttribute("CreditsLayout", L.Stacked and "Stacked" or (L.Small and "Small" or "Wide"))
	return sign
end

-- quiet: a rebuild after a screen resize (no click, the window was already open)
function MainMenuController.OpenCredits(quiet)
	local vp = H.viewport()
	local stacked = vp.Y > vp.X
	local holder = Win.holder("Credits", K.CR.W, stacked and K.CR.TALL_H or K.CR.H)
	if not holder then
		return
	end
	if quiet ~= true then
		H.sound("Click")
	end
	H.safe("credits", Credits.build, holder, stacked)
	local camera = Workspace.CurrentCamera
	if camera then
		-- one rebuild per burst of size changes (a window drag fires many)
		local pending = false
		M.Win.Resize = camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			if pending then
				return
			end
			pending = true
			task.defer(function()
				if M.Win.Name == "Credits" and M.Win.Holder == holder then
					H.safe("credits resize", MainMenuController.OpenCredits, true)
				end
			end)
		end)
	end
end

function MainMenuController.CloseWindows()
	Win.close()
end

function MainMenuController.Window()
	return M.Win.Holder, M.Win.Name
end

----------------------------------------------------------------------
-- open / play
----------------------------------------------------------------------

function MainMenuController.IsOpen()
	return M.Open
end

function MainMenuController.Open()
	if M.Open then
		return
	end
	M.Open = true
	M.Playing = false
	H.mouseHold(true)
	H.holdToasts(true)
	Loading.hook()
	Gate.close()
	H.safe("cards", Cards.close)
	local ok = H.safe("build", Menu.build, true)
	if not ok and M.Menu then
		M.Menu:Destroy()
		M.Menu = nil
	end
	Orbit.start()
	Menu.bindKeys(true)
	Menu.watch(true) -- (sign build) laid out again when the screen changes size
end

function MainMenuController.Play()
	if not M.Open or M.Playing then
		return false
	end
	if Loading.busy() then
		return false -- the loading screen is still up (SKIP takes it away)
	end
	M.Playing = true
	Menu.watch(false)
	H.sound("Confirm")
	Win.close()
	Menu.bindKeys(false)
	-- (kit B U4) the board goes up and the camera flies to the spawn view straight away (the release below waits as before)
	H.safe("leave", Menu.leave)
	H.safe("orbit", Orbit.halt)
	H.safe("fly", Orbit.fly)
	task.spawn(function()
		if not M.SentPlay and not UiGate.HasPlayed() then
			M.SentPlay = true
			local okRemote, remote = pcall(Remotes.Get, "MenuPlay")
			if okRemote and remote then
				pcall(function()
					remote:FireServer()
				end)
			end
			-- wait for the character the server spawns (<= 5 s, then on anyway)
			local waited = 0
			while not (LocalPlayer.Character and LocalPlayer.Character.Parent) and waited < K.CHAR_WAIT do
				waited = waited + task.wait(0.1)
			end
		end
		if M.Menu then
			H.safe("fade", Menu.fade, M.Menu, K.FADE)
		end
		task.wait(K.FADE)
		-- (sign build, U4 minor) the release waits for the camera move to land (the HUD came back mid-flight before); a
		-- tween's Completed fires on landing and on a cancel alike
		local fly = M.Orbit.Fly
		if fly and fly.PlaybackState == Enum.PlaybackState.Playing then
			fly.Completed:Wait()
		end
		-- (review round 1) the release always runs to the end: every step on its own guard, so one that fails never
		-- strands the next (the HUD, the world cards and the held toasts must come back whatever happens)
		local menu = M.Menu
		M.Menu = nil
		if menu then
			H.safe("destroy", function()
				menu:Destroy()
			end)
		end
		H.safe("orbit", Orbit.stop)
		H.safe("gate", Gate.open)
		H.safe("cards", Cards.open)
		M.Open = false
		M.Playing = false
		H.safe("mouse", H.mouseHold, false)
		H.safe("played", UiGate.MarkPlayed)
		H.sound("Whoosh")
		H.holdToasts(false) -- last: the held toasts land on the game screen, the HUD already back
	end)
	return true
end

----------------------------------------------------------------------
-- init
----------------------------------------------------------------------

local function onSettingChanged(key)
	local paint = M.Settings.Rows[key]
	if paint then
		pcall(paint)
	end
	if key == "SeenNotes" then
		Menu.refreshBadge()
	end
	if key == "Shake" and M.Open and not M.Playing then
		H.safe("sway", Menu.sway, M.Ui) -- (sign build) Camera shake OFF stops the title board's sway, ON brings it back
	end
	if key == "Shake" then
		local pg = H.playerGui()
		Loading.passSway(pg and pg:FindFirstChild("NimbusLoading")) -- (sign/logo build) ...and the loading board's
	end
end

function MainMenuController.Init()
	if M.Started then
		return
	end
	M.Started = true
	if not LocalPlayer then
		return
	end
	ClientSettings.Changed:Connect(onSettingChanged)
	-- Esc closes an open window (Settings / Updates / Credits; gamepad B: Win.bindBack)
	game:GetService("UserInputService").InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and M.Win.Name then
			H.sound("Click")
			Win.close()
		end
	end)
	local MouseLock = H.mod("MouseLock")
	if MouseLock and type(MouseLock.Start) == "function" then
		H.safe("MouseLock", MouseLock.Start) -- idempotent (Main.client.lua may start it first)
	end
	local GraphicsQuality = H.mod("GraphicsQuality")
	if GraphicsQuality and type(GraphicsQuality.Init) == "function" then
		H.safe("GraphicsQuality", GraphicsQuality.Init)
	end
	local SoundFx = H.mod("SoundFx")
	if SoundFx and type(SoundFx.Music) == "function" then
		-- the track the game state asks for (SoundFx layers: a battle / dungeon that is already on wins), else Lobby
		local context = type(SoundFx.Wanted) == "function" and SoundFx.Wanted() or "Lobby"
		H.safe("music", SoundFx.Music, context)
	end
	M.Enabled = H.menuCfg().Enabled == true
	if not M.Enabled then
		UiGate.MarkPlayed()
		return
	end
	local pg = LocalPlayer:WaitForChild("PlayerGui", 30)
	if not pg then
		UiGate.MarkPlayed()
		return
	end
	Loading.hook()
	if UiGate.HasPlayed() then
		return
	end
	MainMenuController.Open()
end

return MainMenuController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1148">
            <Properties>
              <string name="Name">MeadowFx</string>
              <string name="Source"><![CDATA[-- MeadowFx (client, bug #12 "Wind-Sown Sky Meadow"): grows the lobby's grass and wildflowers on THIS client and sways
-- them in the wind. The server only decides where things grow (LobbyBuilder Meadow: attributes on
-- workspace.NimbusLobby.Meadow, 9 characters per clump) and builds no grass parts at all (the lobby part budget).
--
-- What a clump is: one of eight Blender keys (meadow_tuft_tall / _short / _seed, meadow_sprig, meadow_flowers (petals
-- tinted per clump), meadow_cornflower, meadow_dandelion, meadow_clover), cloned from a MeshLibrary.Assemble template
-- once the key is ready here; until then (no uploaded id, still loading, a failed download on this device) a small
-- plain-part stand-in of the same kind (2-3 thin parts). A key that becomes ready later swaps its clumps over. Every
-- part is local, anchored, never collides / touches / is queried, casts no shadow.
--
-- Distance: clumps live in 16-stud buckets; every REFRESH seconds (or when the camera moved MOVE studs) the buckets
-- round the camera are walked: a clump shows while its fixed random rank is under the density at its distance (all of
-- them within FULL studs, a smooth fall to FAR_KEEP at FAR, none beyond; flowers count double so the colour carries
-- further). Spawns per pass are capped (no hitch); hidden clumps go back to a pool and are reused.
--
-- Wind (smooth, every frame): each shown clump within SWAY_FADE studs tilts about its foot, round the horizontal axis
-- across the wind, by
--     amp * (0.35 * breeze + 1.05 * gust^2 - 0.12) + flutter
--   gust    = a raised cosine band GUST_LEN studs long rolling downwind at GUST_LEN / GUST_PERIOD studs/s, its front
--             bent by a slow cross-wind wobble (so the wave is not a ruler line);
--   breeze  = a slow lobby-wide swell (0..1, 17 s), so no two loops look the same;
--   flutter = a small fast shiver (FLUTTER_HZ) with a random phase per clump.
-- Grass tilts up to ~12 degrees, flowers / seed heads ~17 (Gemini's numbers), the low clover and sprigs ~5. The
-- amplitude fades to 0 between SWAY_R and SWAY_FADE, so a clump leaving the moving ring stops at rest (no frozen
-- lean, no pop). All parts are written with ONE Workspace:BulkMoveTo per frame from reused buffers.
--
-- Low graphics (GraphicsQuality.Effective() == "Low") or Stop(): every clump is removed, nothing runs per frame.
--
--   MeadowFx.Init()                  idempotent (Main.client.lua starts it)
--   MeadowFx.Stop()                  everything removed, connections dropped
--   MeadowFx.Step(dt)                one Heartbeat (tests drive it)
--   MeadowFx.Tilt(t, along, cross, amp, flutter, phase) -> radians   (pure; tests)
--   MeadowFx.Density(d) -> 0..1      (pure; tests)
--   MeadowFx.Stats() -> { Clumps, Shown, Moving, Mesh, Parts, Writes, Quality, Time, Spawned }
--   MeadowFx.K                       the tuning numbers
-- Plain Lua 5.1-compatible syntax only.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MeadowFx = {}

local K = {
	FOLDER = "Meadow",
	FULL = 34, -- studs from the camera: every clump
	FAR = 95, -- ... falling to FAR_KEEP of them here; none beyond
	FAR_KEEP = 0.12,
	FLOWER_RANK = 0.5, -- flowers' rank is halved: they carry further
	FALLBACK_KEEP = 0.6, -- plain-part stand-ins: this share of the clumps (the meshes are what the meadow is for)
	BUCKET = 16,
	REFRESH = 0.25, -- seconds between LOD passes
	MOVE = 4, -- ... or as soon as the camera moved this far
	SPAWN_MAX = 300, -- clumps made per pass
	HYST = 0.05, -- a shown clump stays until its rank is this far over the density
	SWAY_R = 32, -- full sway within
	SWAY_FADE = 46, -- no sway beyond (at rest)
	GUST_LEN = 36, -- studs between gust fronts
	GUST_PERIOD = 4, -- seconds for one front to pass (9 studs/s)
	BREEZE_PERIOD = 17,
	WOBBLE = 0.16, -- how far (in gust lengths) the fronts bend across the wind
	FLUTTER_HZ = 1.3,
	-- per kind: amplitude (rad), flutter (rad); Kinds order of the server (LobbyBuilder MEADOW.Kinds)
	SWAY = {
		meadow_tuft_tall = { 0.2, 0.035 },
		meadow_tuft_short = { 0.16, 0.03 },
		meadow_tuft_seed = { 0.27, 0.06 },
		meadow_sprig = { 0.09, 0.02 },
		meadow_flowers = { 0.29, 0.065 },
		meadow_cornflower = { 0.29, 0.065 },
		meadow_dandelion = { 0.25, 0.05 },
		meadow_clover = { 0.07, 0.015 },
	},
	FLOWERY = { meadow_flowers = true, meadow_cornflower = true, meadow_dandelion = true },
	-- the low ones are gone sooner (their distance counts 1 / this): they are a few pixels past ~25 studs anyway
	RANGE = { meadow_sprig = 0.6, meadow_clover = 0.6 },
	-- Roblox's own graphics slider (1..10; 0 = Automatic): mid settings grow a thinner meadow (Low hides it all)
	SLIDER_MID = { 4, 6, 0.65 },
}
MeadowFx.K = K

local TWO_PI = math.pi * 2
local cos, sin, sqrt, floor = math.cos, math.sin, math.sqrt, math.floor

local St = {
	Started = false,
	Conns = {},
	Time = 0,
	RefreshAcc = 0,
	Quality = "High",
	Quality0 = nil,
	Lib = nil, -- MeshLibrary (or false)
	Folder = nil, -- the server's Meadow folder we parsed
	Holder = nil, -- our local folder of clump parts
	Wind = Vector3.new(1, 0, 0),
	Axis = Vector3.new(0, 0, -1),
	Base = 0,
	Kinds = {},
	Tints = {},
	N = 0,
	-- per clump (arrays)
	PX = {}, PY = {}, PZ = {}, Yaw = {}, Scale = {}, Kind = {}, Tint = {}, Rank = {}, Along = {}, Cross = {},
	Phase = {}, Bucket = {},
	Inst = {}, -- [i] = { Parts = { part... }, Offs = { CFrame... }, Mesh = bool, Key = poolKey }
	Buckets = {}, -- [bucketKey] = { i... }
	Live = {}, -- [bucketKey] = true (buckets with shown clumps)
	Moving = {}, -- list of i
	Fade = {}, -- [i] = sway amplitude factor (1 near, 0 at SWAY_FADE)
	Pools = {}, -- [poolKey] = { inst... }
	Protos = {}, -- [poolKey] = { Parts = { part... }, Offs = { CFrame... }, Mesh = bool } (unparented)
	LastCam = nil,
	Scale0 = 1, -- the graphics-slider density factor
	Shown = 0,
	Spawned = 0,
	Writes = 0,
	PartList = {},
	CFList = {},
}
MeadowFx._St = St

----------------------------------------------------------------------
-- pure helpers
----------------------------------------------------------------------

-- the tilt (radians) of a clump at time t; along / cross = its position along / across the wind (studs)
-- phase (0..1, per clump) also staggers the gust a little and sets the flutter rate (0.8x .. 1.2x), so neighbours never
-- move in lock-step (Gemini review: "a chorus line")
function MeadowFx.Tilt(t, along, cross, amp, flutter, phase)
	phase = phase or 0
	local u = along / K.GUST_LEN - t / K.GUST_PERIOD + K.WOBBLE * sin(cross / 23 + 0.4) + 0.05 * sin(cross / 7.3)
		+ 0.06 * phase
	local band = 0.5 - 0.5 * cos(TWO_PI * u)
	local gust = band * band
	local breeze = 0.5 + 0.5 * sin(TWO_PI * t / K.BREEZE_PERIOD + along / 90)
	return amp * (0.35 * breeze + 1.05 * gust - 0.12) + flutter * sin(TWO_PI * (K.FLUTTER_HZ * (0.8 + 0.4 * phase) * t + phase))
end

-- share of clumps shown at distance d from the camera
function MeadowFx.Density(d)
	if d <= K.FULL then
		return 1
	elseif d >= K.FAR then
		return 0
	end
	local x = (d - K.FULL) / (K.FAR - K.FULL)
	x = x * x * (3 - 2 * x)
	return 1 + (K.FAR_KEEP - 1) * x
end

local function hash01(i)
	local h = (i * 2654435761 + 40503) % 4294967296
	h = (h * 1103515245 + 12345) % 2147483648
	return (h % 100003) / 100003
end

-- the server's 9-character clump records (LobbyBuilder Meadow.encode)
local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64I = {}
for i = 1, #B64 do
	B64I[string.byte(B64, i)] = i - 1
end

function MeadowFx.Decode(s, i)
	local o = (i - 1) * 9
	local b = { string.byte(s, o + 1, o + 9) }
	if #b < 9 then
		return nil
	end
	local function v(a, len)
		local x = 0
		for j = a, a + len - 1 do
			x = x * 64 + (B64I[b[j]] or 0)
		end
		return x
	end
	local kt = v(1, 1)
	local tint = kt % 8
	local f = v(9, 1)
	return {
		Kind = (kt - tint) / 8 + 1,
		Tint = tint,
		X = v(2, 3) / 64 - 2048,
		Z = v(5, 3) / 64 - 2048,
		Yaw = v(8, 1) / 64 * TWO_PI,
		Scale = 0.7 + (f % 16) * 0.04,
		Patch = f >= 16,
	}
end

----------------------------------------------------------------------
-- environment
----------------------------------------------------------------------

local function quality()
	if St.Quality0 == nil then
		St.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				St.Quality0 = mod
			end
		end
	end
	if St.Quality0 then
		local ok, mode = pcall(St.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

local function readSlider()
	local v = UserSettings().GameSettings.SavedQualityLevel
	if typeof(v) == "EnumItem" then
		return v.Value
	end
	return tonumber(v)
end

local function sliderScale()
	local ok, level = pcall(readSlider) -- module-level function: no closure per call
	level = ok and tonumber(level) or 0
	local m = K.SLIDER_MID
	if level >= m[1] and level <= m[2] then
		return m[3]
	end
	return 1
end

local function meshLib()
	if St.Lib == nil then
		St.Lib = false
		local ok, lib = pcall(function()
			local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
			local m = shared and shared:FindFirstChild("MeshLibrary")
			return m and require(m)
		end)
		if ok and type(lib) == "table" and type(lib.IsReady) == "function" and type(lib.Assemble) == "function" then
			St.Lib = lib
			if type(lib.Changed) == "table" and type(lib.Changed.Connect) == "function" then
				local okC, conn = pcall(function()
					return lib.Changed:Connect(function(key)
						MeadowFx._KeyChanged(key)
					end)
				end)
				if okC and conn then
					St.Conns[#St.Conns + 1] = conn
				end
			end
		end
	end
	return St.Lib or nil
end

function MeadowFx._SetLib(lib) -- tests: a stand-in MeshLibrary (or false = none)
	St.Lib = lib
end

local function findFolder()
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	return lobby and lobby:FindFirstChild(K.FOLDER) or nil
end

----------------------------------------------------------------------
-- prototypes: one per (kind, tint) and look (mesh or parts)
----------------------------------------------------------------------

local function flagPart(p)
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
end

local GREEN = {
	Color3.fromRGB(72, 140, 62), Color3.fromRGB(98, 170, 78), Color3.fromRGB(128, 192, 92),
}
local STRAW = Color3.fromRGB(204, 196, 124)
local STEM = Color3.fromRGB(84, 150, 68)
local YELLOW = Color3.fromRGB(250, 214, 92)

-- the plain-part stand-in of a kind: parts at their offsets from the clump's foot (+X downwind)
local function standIn(key, tint)
	local parts, offs = {}, {}
	local function add(size, cf, color, shape)
		local p = Instance.new("Part")
		p.Name = "MeadowBit"
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if shape then
			p.Shape = shape
		end
		flagPart(p)
		parts[#parts + 1] = p
		offs[#offs + 1] = cf
	end
	local function blade(h, x, z, lean, side, col)
		add(Vector3.new(0.14, h, 0.05), CFrame.new(x, 0, z) * CFrame.Angles(side, 0, -lean) * CFrame.new(0, h / 2 - 0.04, 0), col)
	end
	if key == "meadow_tuft_tall" or key == "meadow_tuft_seed" then
		blade(0.95, 0, 0, 0.32, 0.12, GREEN[2])
		blade(0.75, 0.1, 0.12, 0.42, -0.25, GREEN[1])
		blade(0.65, -0.1, -0.1, 0.22, 0.3, key == "meadow_tuft_seed" and STRAW or GREEN[3])
	elseif key == "meadow_tuft_short" then
		blade(0.5, 0, 0, 0.3, 0.15, GREEN[2])
		blade(0.42, 0.12, 0.1, 0.45, -0.35, GREEN[3])
		blade(0.38, -0.1, -0.12, 0.2, 0.4, GREEN[1])
	elseif key == "meadow_sprig" then
		blade(0.38, 0, 0, 0.3, 0.2, GREEN[2])
		blade(0.3, 0.08, 0.08, 0.45, -0.3, GREEN[3])
	elseif key == "meadow_clover" then
		add(Vector3.new(0.5, 0.06, 0.4), CFrame.new(0, 0.12, 0), Color3.fromRGB(104, 176, 82))
		add(Vector3.new(0.12, 0.12, 0.12), CFrame.new(0.1, 0.28, 0.05), Color3.fromRGB(246, 222, 232))
	else
		local head = YELLOW
		if key == "meadow_flowers" then
			head = St.Tints[tint] or Color3.fromRGB(246, 150, 188)
		elseif key == "meadow_cornflower" then
			head = Color3.fromRGB(96, 140, 236)
		end
		add(Vector3.new(0.06, 0.8, 0.06), CFrame.new(0.08, 0.38, 0) * CFrame.Angles(0, 0, -0.18), STEM)
		add(Vector3.new(0.36, 0.08, 0.36), CFrame.new(0.15, 0.8, 0), head)
		if key == "meadow_dandelion" then
			add(Vector3.new(0.26, 0.26, 0.26), CFrame.new(-0.05, 0.95, 0.1), Color3.fromRGB(246, 246, 240), Enum.PartType.Ball)
		else
			add(Vector3.new(0.12, 0.06, 0.12), CFrame.new(0.15, 0.85, 0), YELLOW)
		end
	end
	return { Parts = parts, Offs = offs, Mesh = false }
end

local function meshProto(key, tint)
	local lib = meshLib()
	if not lib then
		return nil
	end
	local okReady, ready = pcall(lib.IsReady, key)
	if not okReady or not ready then
		return nil
	end
	local look = {}
	if key == "meadow_flowers" and St.Tints[tint] then
		look.Primary = St.Tints[tint]
	end
	local ok, model = pcall(lib.Assemble, key, look, { At = CFrame.new() })
	if not ok or typeof(model) ~= "Instance" then
		return nil
	end
	local parts, offs = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			flagPart(d)
			parts[#parts + 1] = d
			offs[#offs + 1] = d.CFrame -- relative to the foot (Assemble placed the pivot at the origin)
		end
	end
	for _, p in ipairs(parts) do
		p.Parent = nil
	end
	model:Destroy()
	if #parts == 0 then
		return nil
	end
	return { Parts = parts, Offs = offs, Mesh = true }
end

local function poolKey(kind, tint)
	return kind * 8 + tint
end

local function proto(kind, tint)
	local pk = poolKey(kind, tint)
	local p = St.Protos[pk]
	if p == nil then
		local key = St.Kinds[kind] or ""
		p = meshProto(key, tint) or standIn(key, tint)
		-- split each part offset once: its rotation (about the foot) and its position (scaled per clump at spawn)
		p.Rot, p.Pos = {}, {}
		for j, o in ipairs(p.Offs) do
			p.Rot[j] = o - o.Position
			p.Pos[j] = o.Position
		end
		St.Protos[pk] = p
	end
	return p
end

----------------------------------------------------------------------
-- clumps
----------------------------------------------------------------------

-- the wind tilt (radians) of shown clump i at the current time; f = its sway fade (1 near .. 0 at SWAY_FADE)
local function tiltOf(i, f)
	local sw = K.SWAY[St.Kinds[St.Kind[i]]] or K.SWAY.meadow_tuft_short
	return MeadowFx.Tilt(St.Time, St.Along[i], St.Cross[i], sw[1] * f, sw[2] * f, St.Phase[i])
end

-- part j of a shown clump sits at  foot * Tilt * Yaw * (Rot[j] + Pos[j] * scale);  the last three factors never change
-- while the clump is shown, so spawnClump keeps Yaw * (Rot[j] + Pos[j] * scale) as inst.Local[j] and a frame costs one
-- CFrame for the tilted foot (built straight from the tilt's quaternion) and one product per part (review: fewer
-- transient CFrames in the hot loop)
local function place(i, inst, tilt)
	local foot
	if tilt and tilt ~= 0 then
		local h = tilt * 0.5
		local sh = sin(h)
		local ax = St.Axis
		foot = CFrame.new(St.PX[i], St.PY[i], St.PZ[i], ax.X * sh, ax.Y * sh, ax.Z * sh, cos(h))
	else
		foot = CFrame.new(St.PX[i], St.PY[i], St.PZ[i])
	end
	local pl, cl = St.PartList, St.CFList
	local loc = inst.Local
	for j, part in ipairs(inst.Parts) do
		pl[#pl + 1] = part
		cl[#cl + 1] = foot * loc[j]
	end
end

local function flush()
	local pl, cl = St.PartList, St.CFList
	local n = #pl
	if n == 0 then
		return
	end
	local ok = pcall(function()
		Workspace:BulkMoveTo(pl, cl, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for j = 1, n do
			pl[j].CFrame = cl[j]
		end
	end
	St.Writes = St.Writes + n
	for j = n, 1, -1 do
		pl[j] = nil
		cl[j] = nil
	end
end

-- tilt: the clump's wind tilt right now (0 beyond SWAY_FADE), so a clump that appears inside the moving ring (a
-- teleport, a respawn, Low -> High) starts leaning with its neighbours instead of upright for a frame
local function spawnClump(i, tilt)
	local kind, tint = St.Kind[i], St.Tint[i]
	local pk = poolKey(kind, tint)
	local pool = St.Pools[pk]
	local inst = pool and table.remove(pool)
	if not inst then
		local p = proto(kind, tint)
		inst = { Parts = {}, Offs = p.Offs, Rot = p.Rot, Pos = p.Pos, Local = {}, Mesh = p.Mesh, Key = pk, BaseSize = {} }
		for j, src in ipairs(p.Parts) do
			inst.Parts[j] = src:Clone()
			inst.BaseSize[j] = src.Size
		end
	end
	local s = St.Scale[i]
	local yaw = CFrame.Angles(0, St.Yaw[i], 0)
	for j, part in ipairs(inst.Parts) do
		part.Size = inst.BaseSize[j] * s
		inst.Local[j] = yaw * (inst.Rot[j] + inst.Pos[j] * s)
	end
	place(i, inst, tilt or 0)
	for _, part in ipairs(inst.Parts) do
		part.Parent = St.Holder
	end
	St.Inst[i] = inst
	St.Shown = St.Shown + 1
	St.Spawned = St.Spawned + 1
end

local function despawnClump(i)
	local inst = St.Inst[i]
	if not inst then
		return
	end
	for _, part in ipairs(inst.Parts) do
		part.Parent = nil
	end
	local pool = St.Pools[inst.Key]
	if not pool then
		pool = {}
		St.Pools[inst.Key] = pool
	end
	pool[#pool + 1] = inst
	St.Inst[i] = nil
	St.Shown = St.Shown - 1
end

local function clearAll()
	for i in pairs(St.Inst) do
		despawnClump(i)
	end
	St.Moving = {}
	St.Live = {}
	flush()
end

local function destroyPools()
	for _, pool in pairs(St.Pools) do
		for _, inst in ipairs(pool) do
			for _, part in ipairs(inst.Parts) do
				part:Destroy()
			end
		end
	end
	St.Pools = {}
	for _, p in pairs(St.Protos) do
		for _, part in ipairs(p.Parts) do
			part:Destroy()
		end
	end
	St.Protos = {}
end

-- a key became ready (or broken) here: its clumps are rebuilt from the new prototype at the next pass
function MeadowFx._KeyChanged(key)
	local kind = nil
	for k, name in ipairs(St.Kinds) do
		if name == key then
			kind = k
		end
	end
	if not kind then
		return
	end
	for i, inst in pairs(St.Inst) do
		if St.Kind[i] == kind then
			despawnClump(i)
		end
	end
	for pk, pool in pairs(St.Pools) do
		if floor(pk / 8) == kind then
			for _, inst in ipairs(pool) do
				for _, part in ipairs(inst.Parts) do
					part:Destroy()
				end
			end
			St.Pools[pk] = nil
		end
	end
	for pk, p in pairs(St.Protos) do
		if floor(pk / 8) == kind then
			for _, part in ipairs(p.Parts) do
				part:Destroy()
			end
			St.Protos[pk] = nil
		end
	end
	St.LastCam = nil -- refresh at once
end

local function bucketOf(x, z)
	return floor(x / K.BUCKET) * 65536 + floor(z / K.BUCKET)
end

-- read the server's scatter (once per folder)
local function parse(folder)
	clearAll()
	destroyPools()
	St.Folder = folder
	local wind = folder:GetAttribute("Wind")
	if typeof(wind) == "Vector3" and wind.Magnitude > 0 then
		St.Wind = Vector3.new(wind.X, 0, wind.Z).Unit
	end
	St.Axis = Vector3.new(0, 1, 0):Cross(St.Wind) -- tilting about it pushes a clump's top downwind
	St.Base = tonumber(folder:GetAttribute("Base")) or 0
	local origin = folder:GetAttribute("Origin")
	local ox, oz = 0, 0
	if typeof(origin) == "Vector3" then
		ox, oz = origin.X, origin.Z
	end
	St.Kinds = {}
	for name in string.gmatch(tostring(folder:GetAttribute("Kinds") or ""), "[^,]+") do
		St.Kinds[#St.Kinds + 1] = name
	end
	St.Tints = {}
	for t = 1, 7 do
		local c = folder:GetAttribute("Tint" .. t)
		if typeof(c) == "Color3" then
			St.Tints[t] = c
		end
	end
	local n = 0
	St.Buckets = {}
	local chunks = tonumber(folder:GetAttribute("Chunks")) or 0
	local wx, wz = St.Wind.X, St.Wind.Z
	for ch = 1, chunks do
		local s = folder:GetAttribute("Clumps" .. ch)
		if type(s) == "string" then
			for j = 1, floor(#s / 9) do
				local c = MeadowFx.Decode(s, j)
				local key = c and St.Kinds[c.Kind]
				if key then
					n = n + 1
					local x, z = ox + c.X, oz + c.Z
					St.PX[n], St.PY[n], St.PZ[n] = x, St.Base + (c.Patch and 0.1 or 0), z
					St.Yaw[n], St.Scale[n], St.Kind[n], St.Tint[n] = c.Yaw, c.Scale, c.Kind, c.Tint
					local r = hash01(n)
					if K.FLOWERY[key] then
						r = r * K.FLOWER_RANK
					end
					St.Rank[n] = r
					St.Along[n] = x * wx + z * wz
					St.Cross[n] = -x * wz + z * wx
					St.Phase[n] = hash01(n + 7919)
					local b = bucketOf(x, z)
					St.Bucket[n] = b
					local list = St.Buckets[b]
					if not list then
						list = {}
						St.Buckets[b] = list
					end
					list[#list + 1] = n
				end
			end
		end
	end
	for j = n + 1, St.N do
		St.PX[j], St.PY[j], St.PZ[j], St.Yaw[j], St.Scale[j], St.Kind[j], St.Tint[j] = nil, nil, nil, nil, nil, nil, nil
		St.Rank[j], St.Along[j], St.Cross[j], St.Phase[j], St.Bucket[j] = nil, nil, nil, nil, nil
	end
	St.N = n
	St.LastCam = nil
end

local function cameraPos()
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

-- the LOD pass: show / hide by distance and rank, rebuild the moving list
local function refresh(force)
	St.Quality = quality()
	St.Scale0 = sliderScale()
	local folder = findFolder()
	if folder ~= St.Folder then
		if folder then
			parse(folder)
		else
			clearAll()
			St.Folder = nil
			St.N = 0
		end
	end
	if St.Quality == "Low" or St.N == 0 then
		if St.Shown > 0 then
			clearAll()
		end
		-- idle (Low, or no Meadow folder yet): look again on the REFRESH timer only, not every frame (Step re-runs the
		-- pass while LastCam is nil); the timer pass is forced, so a folder that arrives or a switch to High is seen
		St.LastCam = cameraPos() or Vector3.new()
		return
	end
	local cam = cameraPos()
	if not cam then
		return
	end
	if not St.Holder or not St.Holder.Parent then
		local h = Instance.new("Folder")
		h.Name = "MeadowLocal"
		h.Parent = Workspace
		St.Holder = h
	end
	if not force and St.LastCam and (cam - St.LastCam).Magnitude < K.MOVE and St.RefreshAcc < K.REFRESH then
		return
	end
	St.LastCam = cam
	local cx, cz, cy = cam.X, cam.Z, cam.Y
	local reach = K.FAR + K.BUCKET
	local b0x, b1x = floor((cx - reach) / K.BUCKET), floor((cx + reach) / K.BUCKET)
	local b0z, b1z = floor((cz - reach) / K.BUCKET), floor((cz + reach) / K.BUCKET)
	local live = {}
	local moving = {}
	local budget = K.SPAWN_MAX
	local fallbackKeep = K.FALLBACK_KEEP
	for bx = b0x, b1x do
		for bz = b0z, b1z do
			local b = bx * 65536 + bz
			local list = St.Buckets[b]
			if list then
				live[b] = true
				for _, i in ipairs(list) do
					local dx, dz, dy = St.PX[i] - cx, St.PZ[i] - cz, St.PY[i] - cy
					local d = sqrt(dx * dx + dz * dz + dy * dy * 0.25)
					local range = K.RANGE[St.Kinds[St.Kind[i]]] or 1
					local dens = MeadowFx.Density(d / range) * St.Scale0
					local inst = St.Inst[i]
					local rank = St.Rank[i]
					if not proto(St.Kind[i], St.Tint[i]).Mesh then
						dens = dens * fallbackKeep -- the plain stand-ins stay sparser
					end
					local f = nil -- sway fade inside the moving ring
					if d < K.SWAY_FADE then
						f = 1
						if d > K.SWAY_R then
							f = 1 - (d - K.SWAY_R) / (K.SWAY_FADE - K.SWAY_R)
							f = f * f * (3 - 2 * f)
						end
					end
					if inst then
						if rank > dens + K.HYST then
							despawnClump(i)
							inst = nil
						end
					elseif rank < dens and budget > 0 then
						spawnClump(i, f and tiltOf(i, f) or 0)
						budget = budget - 1
						inst = St.Inst[i]
					end
					if inst and f then
						moving[#moving + 1] = i
						St.Fade[i] = f
					end
				end
			end
		end
	end
	-- buckets that fell out of reach: everything in them goes back to the pools
	for b in pairs(St.Live) do
		if not live[b] then
			for _, i in ipairs(St.Buckets[b] or {}) do
				despawnClump(i)
			end
		end
	end
	St.Live = live
	-- clumps that stopped moving rest exactly at their rest pose
	local was = St.Moving
	local still = {}
	for _, i in ipairs(moving) do
		still[i] = true
	end
	for _, i in ipairs(was) do
		if not still[i] and St.Inst[i] then
			place(i, St.Inst[i], 0)
		end
	end
	flush()
	St.Moving = moving
	if budget <= 0 then
		St.LastCam = nil -- more to spawn: run again next frame
	end
end

function MeadowFx.Step(dt)
	dt = tonumber(dt) or 0
	if dt <= 0 then
		return
	end
	St.Time = St.Time + dt
	St.RefreshAcc = St.RefreshAcc + dt
	local cam = cameraPos()
	if St.RefreshAcc >= K.REFRESH or St.LastCam == nil or (cam and St.LastCam and (cam - St.LastCam).Magnitude >= K.MOVE) then
		refresh(St.RefreshAcc >= K.REFRESH)
		St.RefreshAcc = 0
	end
	if St.Quality == "Low" then
		return
	end
	local fade = St.Fade
	for _, i in ipairs(St.Moving) do
		local inst = St.Inst[i]
		if inst then
			place(i, inst, tiltOf(i, fade[i] or 1))
		end
	end
	flush()
end

function MeadowFx.Stats()
	local mesh, parts = 0, 0
	for _, inst in pairs(St.Inst) do
		if inst.Mesh then
			mesh = mesh + 1
		end
		parts = parts + #inst.Parts
	end
	return { Clumps = St.N, Shown = St.Shown, Moving = #St.Moving, Mesh = mesh, Parts = parts, Writes = St.Writes,
		Quality = St.Quality, Time = St.Time, Spawned = St.Spawned }
end

function MeadowFx.Stop()
	for _, c in ipairs(St.Conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	St.Conns = {}
	clearAll()
	destroyPools()
	if St.Holder then
		St.Holder:Destroy()
		St.Holder = nil
	end
	St.Folder = nil
	St.N = 0
	St.Lib = nil
	St.Quality0 = nil
	St.LastCam = nil
	St.Started = false
end

function MeadowFx.Init()
	if St.Started then
		return
	end
	St.Started = true
	meshLib()
	St.Conns[#St.Conns + 1] = RunService.Heartbeat:Connect(MeadowFx.Step)
	refresh(true)
end

return MeadowFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1149">
            <Properties>
              <string name="Name">MenuController</string>
              <string name="Source"><![CDATA[-- MenuController (client, v3 + Phase 2): the left menu of icon tiles and every window the player opens.
--
--   MenuController.Init()
--   MenuController.Open(panelId, args)   -- "Pets" | "Index" | "Shop" | "Store" | "Stats" | "Home" | "Settings" (what
--                                           OpenPanel does; args: Tab, RouletteId, Currency = "Gems", Action, Key, Preset,
--                                           Pick, ReturnTo). lobby-shop Task 22: "Shop" and "Store" open ShopController's
--                                           one Shop window (ShopController.Open(args); refused while the egg stage shows).
--                                           Team balance: "Pets", "Team" and "Inventory" open PetsController's window
--                                           (args go to PetsController.Open).
--                                           Phase 4: "Pets" with Action = "Feed" | "Garden", "Feed", "Train" and "Evolve"
--                                           go to CareController (the Food Machine list, the garden picker, the Training
--                                           Place window, the EVOLVE moment); Action = "Evolve" with a Key (the floating
--                                           card's EVOLVE! pill) opens the Pets window on that pet with the EVOLVE confirm
--   MenuController.Close()               -- closes whatever window / overlay is open: the Shop first, then the egg stage
--                                           (EggStage.Close: one "You hatched: ..." toast for the pulls not shown), then
--                                           the menu window, the Pets window and the Pet Index
--   MenuController.OpenSettings()        -- HUD cleanup: MainMenuController's settings panel (the top-left pill's gear,
--                                           TopBarController; a hint until that panel exists)
--   MenuController.OpenTeam(preset)      -- the Pets window showing that team
--   MenuController.WindowOpened          -- Util.Signal, Fire(windowId) whenever a window opens:
--                                           "Pets" (fired by PetsController), "Shop" (ShopController, lobby-shop Task 22;
--                                           "Store" from an old build), "Daily" (DailyController), "Trove"
--                                           (TroveController), "Stats", "Home" or "Index" (the tutorial listens); this
--                                           controller closes its own windows, the Pet Index and the Pets window on
--                                           "Pets", "Shop", "Store", "Daily" and "Trove" (store W1: those never overlap)
--   Extra: MenuController.GetButton(id) -> the MenuButton_<id> tile (or nil; "Home" is the Spot tile)
--          MenuController.IsOpen() -> true while a menu window, the Pets window, the Shop or the egg stage is up
--          MenuController.OpenFeed(key) -> the Food Machine list (CareController) with that pet copy first
--          MenuController.Hint(text, kind) -> the side hint (CareController's local refusals use it)
--          MenuController.SetColumnHidden(hidden) -> hides / shows the menu tiles (BattleController: the team cards
--          take the left edge of a landscape phone during a battle; the column frame keeps its place)
--          MenuController.SetColumnCovered(windowLeft, who) -> a window reaches over the tiles from that screen x (nil =
--          closed): the tiles step aside while ANY window covers them. `who` names the window ("Pets" when left out:
--          PetsController; "Store", "Daily"), so one window closing never brings the tiles back over another one
--          MenuController.SetTouchHidden(who, on) -> Roblox's thumbstick and jump button go while ANY window asked for
--          it (`who` = "Pets" / "Store") and come back as they were when the last one lets go: one owner set, one
--          snapshot taken while no window held them (re-review 2: a window handing over to another never restores a
--          value the other one wrote)
--          MenuController.SetColumnCollapsed(collapsed, animate) / IsColumnCollapsed() -> folds the column against the
--          left edge like its arrow tab does (bug batch 2 #1; remembered for the session)
--
-- Screen: ScreenGui "NimbusMenu" (display order 20, IgnoreGuiInset = false).
--   * Menu column, left-centre (bug batch 2 #1, option A; HUD cleanup): ONE slim column of four square neon tiles
--     with a glyph and a bold label - Pets, Index, Home, Stats - 56 px on a 1080p desktop (Shop / Travel / Settings
--     live in TopBarController's pill in Roblox's top bar; the Items and Team tiles are gone, the battle team is in the
--     Pets window, Open("Team")). Each tile is a TextButton named MenuButton_<Id> (Ids Pets, Index, Spot, Stats: the
--     Home tile keeps the v3 id "Spot" so saved tutorial targets keep working) inside a frame Entry_<Id> of the frame
--     "MenuColumn". The open window's tile glows gold; a red "!" marks new pets and Pet Index rewards waiting to be
--     claimed. A small arrow tab (MenuColumn.Toggle) folds the column against the left edge and back (remembered for
--     the session; the tab repeats a tile's red dot while folded; a tutorial step pointing at a tile unfolds it). On
--     short screens (landscape / portrait phones) the tiles wrap into two slim columns so they stay >= 44 px.
--   * Windows (CloudUI.Panel, centred because the player asked for them, nudged right only when the menu
--     column would cover them): Stats and Home (team balance: the Pets window is PetsController's, shared bits in
--     UI/PetBits; lobby-shop Task 22: the Cloud Shop, its odds popup and its roulette stage left for ShopController's
--     Eggs tab, client/UI/ShopEggs, and client/UI/EggStage). The Pet Index is IndexController's window: the Index tile and
--     OpenPanel("Index") open it. One window at a time; Esc / gamepad B / the red X / the tile again / a click
--     outside closes it. Gamepad B is bound (ContextActionService, High priority, sunk) only while something is open,
--     so it does not also fire MovementController's dash.
--   * Home window (Phase 4, "Phase 4 build contract" 3.1-3.3 / 8.1): the house tier, Home Level and prestige stars,
--     income per second (the plot's IncomePerSecond attribute; food and the Lucky bonus under it, the prestige
--     multiplier tag), the Pet Garden card (coins waiting = the plot's CollectorCash, coins per minute, places
--     "N/12" = the plot's GardenSlots: 3 + 1 per prestige, the LegacySlots / LegacyPrices lines; no Collect: kids
--     walk over their coins), the prestige progress (Home Level x/40 and the Sky Castle) with a confirmed Prestige
--     (what starts over, what stays, the new star's coins / garden place / Gems), Go home (Phase 6: the big golden
--     hero on top, HomeAction "GoHome": the home portal; without a home the window shows "Claim a home" (GoToSpot)
--     and the three claim steps instead) and every station of TycoonCatalog grouped Pets at home (Pet Garden, Food Machine, Training Place,
--     Fusion Machine), Coin makers (the plants, Coin Magnet, Vault), House, Decor, each with its level (pips), what it
--     does now -> next ("+7 -> +9 food", "Feeds fill 30% -> 35% of a bar", "2 pets train at once"), the next price
--     and Build / Upgrade (or why it is locked: "Reach Home Level 10", "Needs the Villa", "Unlocks at Prestige 1").
--     Everything is re-checked by the server (HomeAction "Upgrade" / "Prestige" / "GoHome").
--   * v3 readability rule: everything is designed in 1080p pixels (body 18-19, captions >= 18, buttons 20+,
--     titles 28-34) under ONE UIScale per window = min(screen factor clamp(viewportY / 1080, 0.8, 1.25), fit).
--     Window sizes adapt between a minimum and a preferred design size and their columns scroll, so phones
--     keep the 0.8 scale instead of shrinking the text.
--   * Every window re-renders from State.Changed (and when the token count or the InMatch attribute
--     changes). Pet slots are kept per pet id and updated in place, so nothing is rebuilt or leaked.
--   * Touch screens: the menu column never reaches Roblox's thumbstick (bottom-left); in landscape it sits in the
--     band between the top margin and the stick (two slim columns of four on a phone, labels >= 14 px). "Touch" is a
--     touch-only device OR any screen where PlayerModule's TouchGui shows a thumbstick (Studio's device emulator and
--     touch laptops / tablets with a keyboard report KeyboardEnabled too, but still get the stick: P5.stickShown).
--     Once the stick has been seen the touch layout stays for the session (respawn, the Esc menu and a hybrid's
--     mouse / touch switches hide the stick for a moment; the column must not snap back and forth).
--
-- Remotes used: OpenPanel (in); EquipPet, UnequipPet, GoToSpot, HomeAction, PetCare (out). Each remote action is sent at most every K.FIRE_GAP seconds (the server rate-limits as well).
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
