		Callback = function()
			if S.GroupId == FUSIONS then
				if hasFusionMachine() then
					safe("fusion machine", openFusionMachine)
				else
					safe("home window", openHomeWindow)
				end
			else
				safe("claim", requestClaim)
			end
		end,
		Parent = rewards,
	})
end

