-- (kit-b U9-5) the Signboard palette (the pitch's kit B; one colour by role): brown ink on stone, the navy header plank in
-- its wood frame, violet for a pet in training (as the Pets window's busy cover), a skill's own colour on its icon chip,
-- its lip and its lit rank blocks; green / red text darkened until it reads on stone (4.5:1)
local SIGN = Theme.Sign
local C = {
	White = Theme.Colors.White,
	Ink = SIGN.Text,
	Navy = SIGN.Navy,
	Stone = SIGN.Stone,
	Tile = SIGN.Tile,
	Wood = SIGN.Wood,
	Well = SIGN.Well,
	WellEdge = SIGN.WellEdge,
	Muted = SIGN.TextMuted,
	Gold = SIGN.Gold,
	GoldInk = SIGN.GoldLip, -- gold marks on stone (the evolution stars)
	Good = SIGN.Good, -- #2E7D32: 5.1:1 on the stone tile (LOOK-ui2: kit B's one good ink)
	Bad = SIGN.RedLip,
	Purple = SIGN.Violet,
	PurpleInk = SIGN.VioletLip, -- violet text on stone
	Grey = SIGN.StoneLip,
	SegOff = SIGN.Well,
	Accent = SIGN.Navy,
	-- (LOOK-ui2: the old neon set, #3FC8FF / #FF6B81 / #B47CFF / #FFB347) the four skills in the kit's own role colours
	Skill = {
		Speed = SIGN.Sky,
		Physique = SIGN.Red,
		Ability = SIGN.Violet,
		Defense = SIGN.Gold,
	},
}
-- (kit-b U9 merge check) a mat's "Pick a skill" call in the good ink, darkened the least it takes to read 4.5:1 on the
-- pending mat's gold-cream face too (SIGN.Selected: #2E7D32 read 4.27:1 there; the stone tile reads it at 5.1:1)
C.MatGood = C.Good
for step = 1, 25 do
	if Theme.Contrast(C.MatGood, SIGN.Selected) >= 4.6 then -- (a margin: the screen rounds the colour to 8 bits)
		break
	end
	C.MatGood = Theme.Darken(C.Good, step * 0.04)
end

-- typography as UTF-8 byte escapes (the source stays plain ASCII). kit-b U7b: the icons are PixelIcons (ICON), the
-- emoji went; "->" is the plain arrow of a rank's next step
local G = {
	Prev = "\226\128\185",
	Next = "\226\128\186",
	Arrow = "->",
	Dot = "\194\183",
	Plus = "+",
}
local ICON = {
	Train = "weight", -- the Training Place's station icon (TycoonCatalog Gym) and the picker's Train icon
	Lock = "lock",
	Wait = "hourglass", -- an open mat whose spot a job on a closed mat holds ("InUse")
	Skills = { Speed = "bolt", Physique = "heart", Ability = "sparkle", Defense = "shield" },
}

local SKILLS = (BattleCatalog and type(BattleCatalog.TrainingSkills) == "table" and #BattleCatalog.TrainingSkills == 4) and BattleCatalog.TrainingSkills
	or {
		{ Id = "Speed", Name = "Attack Speed" },
		{ Id = "Physique", Name = "Physique" },
		{ Id = "Ability", Name = "Ability" },
		{ Id = "Defense", Name = "Defense" },
	}
-- what one rank adds (BattleCatalog.Training) and the words after the number
local EFFECT = {
	Speed = { Per = 0.04, Words = "attack speed", Sign = "+" },
	Physique = { Per = 0.05, Words = "max health", Sign = "+" },
	Ability = { Per = 0.04, Words = "special power and charge", Short = "special power", Sign = "+" },
	-- (playtest 2026-11-28 C39) a minus skill always says what goes down ('Rank 1: -3%' in green read as a penalty);
	-- Lead heads the one-line card's "Hits 0% -> -3%"
	Defense = { Per = 0.03, Words = "damage taken", Sign = "-", Lead = "Hits" },
}
local HINTS = {
	NoPet = "Pick a pet first",
	NoPlace = "Build the Training Place at home first.",
	Busy = "This pet is already training. Stop it first to train another skill.",
	Full = "Every training spot is in use. Upgrade the Training Place for more!",
	Short = "Not enough Cash for this rank yet.",
	Match = "Pets train at home, after the match.",
}
local TEXTS = {
	NoPets = "No pets yet! Spin a roulette in the Shop to hatch one.",
	NoPlace = "Build the Training Place at home first. Training makes pets tougher in battles!",
	Rest = "Training pets rest at home until they're done.",
	-- the mats row (Task 8)
	BuildMat = "Build the Training Place at home to open this spot.",
	OpenMat = "Upgrade your Training Place to Lv %d to open this spot.",
	NeedsHouse = " Needs the %s.",
	InUseMat = "In use by a pet on a closed spot. Free again when that pet is done.",
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local S = {
	Open = false,
	Built = false,
	Token = 0,
	Key = nil, -- the selected pet (nil = the empty state)
	ReturnTo = nil, -- the Pets window's Open args to go back to
	BackTo = nil,
	Sheet = false, -- the picker sheet is up and ours
	SheetToken = 0,
	Confirm = nil, -- { Yes = fn } while the confirm is up
	Mode = "PC",
	Portrait = false,
	Scale = 1,
	Rect = nil,
	Card = "full", -- the skill cards' inside layout
	ViewId = nil, -- the shown viewport ("key#stage")
	States = {},
	Last = {},
	HintToken = 0,
	TouchOff = false,
	BackBound = false,
	RefreshPending = false,
	Warned = {},
	FitSigs = setmetatable({}, { __mode = "k" }), -- the mats' last text fits per label
	TypedAt = -1, -- os.clock() when a TextBox last let go of focus (H.typing)
}
local U = { Skills = {}, Views = {}, MatList = {}, MatViews = {} }
local H = {} -- helpers (one table: the module stays far below Lua's local limit)

local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[TrainController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok, err
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

local function label(parent, name, role, size, props)
	local l = Theme.Label("", role, { Size = size })
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextTruncate = Enum.TextTruncate.AtEnd
	l.TextColor3 = C.Ink -- (kit-b U9-5) brown ink on stone unless the caller says otherwise
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- (kit-b U9-5) a square edge (a mitred border UIStroke named SignEdge)
function H.edge(obj, color, px)
	local s = Theme.Stroke(obj, color, px or 2, 0)
	s.Name = "SignEdge"
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

-- (kit-b U9-5) the stone body inside a window's wood frame (K.FRAME px of wood on every side), its darker lip at the bottom
function H.signBody(panel)
	local stone = Util.Create("Frame", {
		Name = "Stone", BackgroundColor3 = C.Stone, BorderSizePixel = 0, Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME), ZIndex = 1, Parent = panel,
	})
	Util.Create("Frame", {
		Name = "Lip", BackgroundColor3 = SIGN.StoneLip, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 6), ZIndex = 1, Parent = stone,
	})
	return stone
end

----------------------------------------------------------------------
-- Data (display only: the synced profile + the catalogs)
----------------------------------------------------------------------
function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.now()
	local ok, t = pcall(function()
		return Workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		return t
	end
	return os.time()
end

function H.clock(seconds)
	seconds = math.max(0, math.ceil(tonumber(seconds) or 0))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

-- today's confirm wording ("1 min", "45 s")
function H.minutes(seconds)
	local m = math.floor((tonumber(seconds) or 0) / 60 + 0.5)
	if m < 1 then
		return math.max(1, math.floor(tonumber(seconds) or 0)) .. " s"
	end
	return m .. " min"
end

function H.money(n)
	return Bits.formatCash(n)
end

-- the card's exact cost ("$26,250")
function H.commas(n)
	return "$" .. Util.Commas(math.max(0, math.floor(tonumber(n) or 0)))
end

-- a Color3 as RichText's "rrggbb"
function H.hex(c)
	local function byte(v)
		return math.max(0, math.min(255, math.floor(v * 255 + 0.5)))
	end
	return string.format("%02x%02x%02x", byte(c.R), byte(c.G), byte(c.B))
end

function H.def(key)
	return type(key) == "string" and Bits.defOfKey(key) or nil
end

function H.owned(key)
	if type(key) ~= "string" then
		return false
	end
	local ok, n = pcall(State.OwnedCount, key)
	return ok and (tonumber(n) or 0) > 0
end

function H.valid(key)
	return H.owned(key) and H.def(key) ~= nil
end

function H.cash()
	local ok, v = pcall(State.Cash)
	return (ok and type(v) == "number") and v or 0
end

function H.maxRank()
	local tr = BattleCatalog and BattleCatalog.Training
	return (type(tr) == "table" and tonumber(tr.MaxRank)) or 10
end

function H.rank(key, stat)
	local g = Bits.growth(key)
	local r = math.floor(tonumber(g[stat]) or 0)
	return math.max(0, math.min(H.maxRank(), r))
end

function H.per(stat)
	local tr = BattleCatalog and BattleCatalog.Training
	local v = type(tr) == "table" and tonumber(tr[stat]) or nil
	return v or EFFECT[stat].Per
end

function H.pct(stat, rank)
	return math.floor(H.per(stat) * 100 * rank + 0.5)
end

function H.placeLevel(home)
	local st = type(home) == "table" and home.Stations or nil
	local v = type(st) == "table" and tonumber(st.Gym) or nil
	if v and v == v then
		return math.max(0, math.floor(v))
	end
	return 0
end

-- the open mats: TycoonCatalog.TrainingSlots(home), 0..5 (the server's Care.trainingSlots clamp)
function H.slots(home)
	local ok, n = pcall(function()
		return TycoonCatalog.TrainingSlots(home)
	end)
	n = ok and tonumber(n) or 0
	if n ~= n then
		n = 0
	end
	return math.max(0, math.min(K.MAX_MATS, math.floor(n)))
end

-- the Training Place level that opens mat i (the first Gym level whose Slots reach i)
function H.unlockOf(i)
	local def = TycoonCatalog and type(TycoonCatalog.Get) == "function" and TycoonCatalog.Get("Gym") or nil
	if type(def) == "table" and type(def.Effects) == "table" then
		for lv = 1, #def.Effects do
			local fx = def.Effects[lv]
			if type(fx) == "table" and (tonumber(fx.Slots) or 0) >= i then
				return lv
			end
		end
	end
	return i
end

-- the house tier name that first allows Training Place level lv (nil when none does)
function H.houseFor(lv)
	local def = TycoonCatalog and type(TycoonCatalog.Get) == "function" and TycoonCatalog.Get("Gym") or nil
	local tiers = TycoonCatalog and TycoonCatalog.HouseTiers
	if type(def) ~= "table" or type(def.TierCaps) ~= "table" or type(tiers) ~= "table" then
		return nil
	end
	for _, tier in ipairs(tiers) do
		if (tonumber(def.TierCaps[tier.Id]) or 0) >= lv then
			return tier.Name
		end
	end
	return nil
end

-- the HintLine text of a locked mat: the level that opens it, plus the house when today's house caps the station
function H.lockHint(lv)
	lv = math.max(1, math.floor(tonumber(lv) or 1))
	local home = Bits.homeData()
	if lv <= 1 then
		return TEXTS.BuildMat
	end
	local text = string.format(TEXTS.OpenMat, lv)
	local cap = tonumber(Bits.catalogCall("MaxLevelAt", "Gym", home)) or lv
	if lv > cap then
		local house = H.houseFor(lv)
		if house then
			text = text .. string.format(TEXTS.NeedsHouse, house)
		end
	end
	return text
end

-- the mat a job asks for: its Slot when it is a whole 1..5, else nil (no Slot: an old save sends 0)
function H.jobSlot(job)
	local s = tonumber(job.Slot)
	if s and s == s and s >= 1 and s <= K.MAX_MATS and s == math.floor(s) then
		return s
	end
	return nil
end

-- the pure mats row (see the header): five mats from the home, a growth map and the selected key
function H.mats(home, growthMap, selectedKey)
	local slots = H.slots(home)
	local mats = {}
	for i = 1, K.MAX_MATS do
		if i <= slots then
			mats[i] = { State = "Add", LockBadge = false }
		else
			mats[i] = { State = "Locked", Unlock = H.unlockOf(i), LockBadge = false }
		end
	end
	-- the jobs in a fixed order: by Slot (none last), then the sooner done, then the key
	local jobs = {}
	if type(growthMap) == "table" then
		for key, e in pairs(growthMap) do
			if type(key) == "string" and type(e) == "table" and type(e.Job) == "table" then
				local ends = tonumber(e.Job.Ends) or math.huge
				if ends ~= ends then
					ends = math.huge
				end
				jobs[#jobs + 1] = { Key = key, Job = e.Job, Slot = H.jobSlot(e.Job), Ends = ends }
			end
		end
	end
	table.sort(jobs, function(a, b)
		local sa, sb = a.Slot or 99, b.Slot or 99
		if sa ~= sb then
			return sa < sb
		end
		if a.Ends ~= b.Ends then
			return a.Ends < b.Ends
		end
		return a.Key < b.Key
	end)
	-- (a job on a closed mat keeps that mat's Unlock level next to its lock badge)
	local function put(i, j)
		local m = mats[i]
		m.State, m.Key, m.Job = "Job", j.Key, j.Job
		m.LockBadge = i > slots
	end
	local later = {}
	for _, j in ipairs(jobs) do
		if j.Slot and mats[j.Slot].Key == nil then
			put(j.Slot, j)
		else
			later[#later + 1] = j
		end
	end
	-- no Slot / a taken slot: the next free open mat after it (wrapping round), else the next free mat of all five
	for _, j in ipairs(later) do
		local from, at = j.Slot or 0, nil
		for step = 1, slots do
			local i = ((from + step - 1) % slots) + 1
			if mats[i].Key == nil then
				at = i
				break
			end
		end
		if not at then
			for step = 1, K.MAX_MATS do
				local i = ((from + step - 1) % K.MAX_MATS) + 1
				if mats[i].Key == nil then
					at = i
					break
				end
			end
		end
		if at then
			put(at, j)
		end
	end
	-- the free spots are slots - jobs (the server counts every job, also one on a closed mat): only that many empty open
	-- mats offer "+ Add a pet"; the others are "InUse" (a job on a closed mat holds their spot), so the row never shows
	-- more room than the chip (review fix)
	local free = math.max(0, slots - #jobs)
	local first = nil
	for i = 1, slots do
		if mats[i].Key == nil then
			if free > 0 then
				free = free - 1
				first = first or i
			else
				mats[i].State = "InUse"
			end
		end
	end
	-- the pending pet: selected, not training, on the first free mat (none when the place is full)
	if type(selectedKey) == "string" and first then
		local e = type(growthMap) == "table" and growthMap[selectedKey] or nil
		if not (type(e) == "table" and type(e.Job) == "table") then
			mats[first].State, mats[first].Key = "Pending", selectedKey
		end
	end
	return mats
end

-- the jobs running (the growth map: a job can belong to a copy no longer listed)
function H.used()
	local okMap, map = pcall(State.PetGrowthMap)
	local n = 0
	if okMap and type(map) == "table" then
		for _, e in pairs(map) do
			if type(e) == "table" and type(e.Job) == "table" then
				n = n + 1
			end
		end
	end
	return n
end

function H.skillName(stat)
	for _, s in ipairs(SKILLS) do
		if s.Id == stat then
			return s.Name
		end
	end
	return tostring(stat)
end

-- the picker's default Train order (training soonest first, the team, the rest by rarity then level)
function H.order()
	local ok, sorted = pcall(function()
		return PetPicker.Sorted("Train", PetPicker.Entries("Train"), "Default", "All", "")
	end)
	local out = {}
	if ok and type(sorted) == "table" then
		for i, e in ipairs(sorted) do
			out[i] = e.Key
		end
	end
	return out
end

function H.firstTraining()
	for _, key in ipairs(H.order()) do
		if Bits.job(key) then
			return key
		end
	end
	return nil
end

function H.skillState(stat)
	if H.placeLevel(Bits.homeData()) < 1 then
		return "NoPlace"
	end
	local key = S.Key
	local def = H.valid(key) and H.def(key) or nil
	if not def then
		return "NoPet"
	end
	if H.inMatch() then
		return "Match"
	end
	local job = Bits.job(key)
	if job and job.Stat == stat then
		return "Training"
	end
	local rank = H.rank(key, stat)
	if rank >= H.maxRank() then
		return "Max"
	end
	if job then
		return "Busy"
	end
	if H.used() >= H.slots(Bits.homeData()) then
		return "Full"
	end
	local cost = tonumber(Bits.catalogCall("TrainCost", def, rank + 1)) or 0
	if H.cash() < cost then
		return "Short"
	end
	return "Ready"
end

----------------------------------------------------------------------
-- Text fit (TextService: the real font)
----------------------------------------------------------------------
function H.width(text, size, font)
	local plain = tostring(text):gsub("<[^>]*>", "")
	local ok, v = pcall(function()
		return Theme.Measure(plain, font, size, 4096)
	end)
	if ok and typeof(v) == "Vector2" then
		return v.X
	end
	return #plain * size * 0.55
end

-- the first text that fits `width` at a size from maxSize down to minSize; the last text at minSize when none does
function H.fit(lbl, texts, width, maxSize, minSize, em)
	-- (kit-b U9-5) a capitals role (a title, a tag) is measured as it shows: in capitals. `em` (optional): a mixed-case
	-- text is never taken under that many em a letter (LOOK-ui2: the mats' pet names)
	local role = lbl:GetAttribute("FontRole")
	local caps = role ~= nil and Theme.CapsRoles[role] == true
	for _, t in ipairs(texts) do
		local size = maxSize
		while size >= minSize do
			-- (LOOK-ui2: "TRAINING PLACE" drew 158.6 px where it measured 139) capitals never under 0.62 em a letter
			local w = H.width(caps and Theme.Caps(t) or t, size, Theme.FontOf(lbl))
			if caps then
				w = math.max(w, #t * size * 0.62)
			elseif em then
				w = math.max(w, #t * size * em)
			end
			if w <= width then
				lbl.Text, lbl.TextSize = t, size
				return true
			end
			size = size - 1
		end
	end
	lbl.Text, lbl.TextSize = texts[#texts], minSize
	return false
end

-- the height of a wrapped text in `width` (TextService, never less than the lines its single-line width needs)
function H.wrappedHeight(text, size, font, width)
	local lineH = math.ceil(size * 1.25)
	local lines = math.max(1, math.ceil(H.width(text, size, font) / math.max(1, width * 0.9)))
	local h = lines * lineH
	local ok, v = pcall(function()
		return Theme.Measure(text, font, size, width)
	end)
	if ok and typeof(v) == "Vector2" and v.Y > h then
		h = v.Y
	end
	return h
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
function H.ensureGui()
	if U.Gui and U.Gui.Parent then
		return true
	end
	if not (LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")) then
		return false
	end
	U.Gui = CloudUI.NewScreenGui("NimbusTrain", K.DISPLAY_ORDER)
	U.Gui.IgnoreGuiInset = true
	-- (LOOK-ui2: under the window's Fit of 0.8 a 2 px edge drew 1.6 screen px, a 8 px lip 6.4) every wood edge and lip of the
	-- window, now and as rows are added, on whole screen px (PixelIcon.WholeTree, kitb-look1's one helper)
	PixelIcon.WholeTree(U.Gui)
	S.Built = false
	U.Skills, U.Views, S.ViewId = {}, {}, nil
	U.MatList, U.MatViews = {}, {}
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Open or S.Confirm then
			safe("relayout", H.layout)
		end
	end)
	return true
end

function H.build()
	if S.Built then
		return
	end
	S.Built = true
	local holder = Util.Create("Frame", { Name = "Window_Train", BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = 2, Parent = U.Gui })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-5) the window as a kit B sign: a wood frame (Panel) round a stone body (Stone, its lip along the bottom), the
	-- navy header plank on top (the title's T1 band is the plank: RibbonBand = "Header"), on a PC screen the pink awning
	-- (SignKit.Roof: one fixed-size piece, never stretched with the window); square, no glow, no gradient
	local panel = Util.Create("Frame", {
		Name = "Panel", BackgroundColor3 = C.Wood, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = holder,
	})
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel })
	H.signBody(panel)
	local header = Util.Create("Frame", { Name = "Header", BackgroundColor3 = C.Navy, BorderSizePixel = 0, ZIndex = 3, Parent = panel })
	U.Header = header
	U.HeaderFoot = Util.Create("Frame", { Name = "HeaderFoot", BackgroundColor3 = SIGN.NavyLip, BorderSizePixel = 0, ZIndex = 3, Parent = header })
	U.Roof = SignKit.Roof(panel, { Width = K.ROOF_W, Y = SignKit.RoofSeat(), ZIndex = 4 }) -- (F0 review) seated on the frame
	U.Icon = label(header, "Icon", "Title", 36, { ZIndex = 4, Text = "", TextColor3 = C.Gold, TextTruncate = Enum.TextTruncate.None })
	SignKit.IconSlot(U.Icon, ICON.Train, 27) -- (LOOK-ui2) the header's gold icon square, as Pets and the Food Machine
	U.Title = label(header, "Title", "Title", 34, { ZIndex = 4, Text = "Training Place", TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left })
	U.Title:SetAttribute("RibbonBand", "Header") -- the navy plank is the title's band
	Theme.StyleTitle(U.Title)
	-- the spots in use: a small stone tag on the plank
	U.Chip = label(header, "SpotsChip", "Heading", 20, {
		ZIndex = 4, BackgroundTransparency = 0, BackgroundColor3 = C.Stone, TextTruncate = Enum.TextTruncate.None,
	})
	H.edge(U.Chip, C.Wood, 2)
	U.Close = CloudUI.Button({
		Name = "CloseButton", Text = "", Style = "Red", Skin = "Sign", Size = UDim2.fromOffset(44, 44), TextSize = 22, ZIndex = 5,
		Callback = function()
			TrainController.Close()
		end,
		Parent = header,
	})
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = C.Ink }) -- slop audit 2026-11-12: a drawn X (no glyph)
	NeonKit.CloseBlock(U.Close) -- (LOOK-ui2) the kit's one close block: never under 44 screen px, its x in 3 px cells
	-- body
	local body = Util.Create("Frame", { Name = "Body", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = panel })
	U.Body = body
	-- the mats row: a plain band holding Mat1..Mat5 (each mat draws its own card)
	U.Mats = Util.Create("Frame", { Name = "Mats", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = body })
	for i = 1, K.MAX_MATS do
		H.newMat(i)
	end
	-- the big pet card (tap: the sheet)
	-- (kit-b U9-5) a stone card with the pet's rarity on its lip; the pet stands in a light well
	U.Card = NeonKit.Card({ Name = "PetCard", Class = "TextButton", Skin = "Sign", Color = C.Grey, LipPx = 8, ZIndex = 3, Parent = body })
	U.Card.Root.Activated:Connect(function()
		H.openSheet()
	end)
	U.Art = Util.Create("Frame", { Name = "Art", BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell, BorderSizePixel = 0, ZIndex = 4, Parent = U.Card.Body })
	-- the rarity: a stone tag (brown ink) in a wood edge; the element: a tag in its own colour's edge
	U.Rarity = label(U.Card.Body, "RarityChip", "Heading", 18, {
		ZIndex = 6, BackgroundTransparency = 0, BackgroundColor3 = C.Tile, TextTruncate = Enum.TextTruncate.None,
	})
	H.edge(U.Rarity, C.Wood, 2)
	U.Element = label(U.Card.Body, "ElementChip", "Heading", 18, {
		ZIndex = 6, BackgroundTransparency = 0, BackgroundColor3 = C.Tile, TextTruncate = Enum.TextTruncate.None,
	})
	U.ElementStroke = H.edge(U.Element, C.Wood, 2)
	U.Prompt = label(U.Card.Body, "PickPrompt", "Heading", 30, {
		ZIndex = 6, Visible = false, RichText = true, TextWrapped = true, TextTruncate = Enum.TextTruncate.None,
		Size = UDim2.fromScale(1, 1),
	})
	U.Name = label(body, "PetName", "Title", 42, { ZIndex = 3 })
	Theme.StyleTitle(U.Name, "Section") -- (kit-b U9-5) a card heading: the plain kit B title (the ribbon is for window titles)
	U.Level = label(body, "PetLevel", "Heading", 26, { ZIndex = 3, RichText = true, TextColor3 = C.Muted })
	U.Prev = CloudUI.Button({
		Name = "PrevButton", Text = G.Prev, Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(76, 76), TextSize = 40, ZIndex = 3,
		Callback = function()
			TrainController.Step(-1)
		end,
		Parent = body,
	})
	U.Change = CloudUI.Button({
		Name = "ChangeButton", Text = "Change pet", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(220, 76), TextSize = 24, ZIndex = 3,
		Callback = function()
			H.openSheet()
		end,
		Parent = body,
	})
	U.Next = CloudUI.Button({
		Name = "NextButton", Text = G.Next, Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(76, 76), TextSize = 40, ZIndex = 3,
		Callback = function()
			TrainController.Step(1)
		end,
		Parent = body,
	})
	U.Note = label(body, "RestNote", "Body", 19, { ZIndex = 3, Text = TEXTS.Rest, TextWrapped = true, TextColor3 = C.Muted, TextTruncate = Enum.TextTruncate.None })
	U.SkillsFrame = Util.Create("Frame", { Name = "Skills", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3, Parent = body })
	for _, skill in ipairs(SKILLS) do
		H.newSkill(skill)
	end
	U.Empty = label(body, "Empty", "Heading", 24, { ZIndex = 5, Visible = false, TextWrapped = true, TextTruncate = Enum.TextTruncate.None })
	-- the hint: a small navy sign with stone words
	U.Hint = label(body, "HintLine", "Heading", 20, {
		ZIndex = 9, Visible = false, BackgroundTransparency = 0, BackgroundColor3 = C.Navy, TextColor3 = C.Stone, TextWrapped = true,
	})
	H.edge(U.Hint, C.Wood, 3)
	U.Cache = Util.Create("Frame", { Name = "ViewCache", BackgroundTransparency = 1, Visible = false, Size = UDim2.fromOffset(10, 10), Parent = holder })
	H.buildConfirm()
	-- the cursor is free while the window is shown (client/MouseLock, as the Pets window)
	local mouseLock = Client:FindFirstChild("MouseLock")
	local okLock, lock = pcall(function()
		return mouseLock and require(mouseLock)
	end)
	if okLock and type(lock) == "table" and type(lock.WatchVisible) == "function" then
		safe("mouse lock", lock.WatchVisible, "Dock:" .. holder.Name, holder)
	end
end

function H.newSkill(skill)
	local id = skill.Id
	local color = C.Skill[id] or C.Accent
	-- (kit-b U9-5) a stone card with the skill's colour on its lip and on a square icon chip (was a neon card and a glossy orb)
	local card = NeonKit.Card({ Name = "Skill_" .. id, Skin = "Sign", Color = color, LipPx = 6, ZIndex = 3, Parent = U.SkillsFrame })
	local body = card.Body
	local item = { Id = id, Color = color, Card = card, Root = card.Root, Segs = {} }
	item.IconHolder = Util.Create("Frame", { Name = "IconHolder", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4, Parent = body })
	item.Orb = Util.Create("Frame", {
		Name = "Chip", BackgroundColor3 = color, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(64, 64), ZIndex = 4, Parent = item.IconHolder,
	})
	H.edge(item.Orb, C.Wood, 3)
	item.Icon = label(item.IconHolder, "Icon", "Display", 34, {
		ZIndex = 5, Text = "", Size = UDim2.fromScale(1, 1), TextColor3 = Theme.TextOn(color), TextTruncate = Enum.TextTruncate.None,
	})
	PixelIcon.Host(item.Icon, ICON.Skills[id] or ICON.Train) -- (kit-b U7b) the skill's PixelIcon in its orb
	item.NameL = label(body, "Name", "Title", 30, { ZIndex = 5, Text = skill.Name or H.skillName(id), TextXAlignment = Enum.TextXAlignment.Left })
	item.RankL = label(body, "Rank", "Heading", 22, { ZIndex = 5, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Left })
	item.Bar = Util.Create("Frame", { Name = "Bar", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Parent = body })
	-- (LOOK-ui2: a private row of flat squares in a 1 px edge, no lip, gaps of 2 and 3 px) ten kit blocks (SignKit.FitBlocks:
	-- whole px, the wood edge, the darker lip), lit in the skill's colour; the rank in training is the gold block
	item.Blocks = SignKit.FitBlocks(item.Bar, { Name = "Blocks", Size = UDim2.fromScale(1, 1), Count = 10, Gap = 3, Weight = "Bar", Fill = color, FillLip = Theme.SignLipOf(color), ZIndex = 6 })
	item.Now = label(body, "Now", "Body", 20, { ZIndex = 5, TextXAlignment = Enum.TextXAlignment.Left })
	item.Next = label(body, "Next", "Body", 20, { ZIndex = 5, TextColor3 = C.Good, TextXAlignment = Enum.TextXAlignment.Left })
	item.Cost = label(body, "Cost", "Display", 26, { ZIndex = 5, TextColor3 = C.Good, TextXAlignment = Enum.TextXAlignment.Left })
	item.Time = label(body, "Time", "Body", 20, { ZIndex = 5, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Left })
	item.Action = CloudUI.Button({ Name = "Action", Text = "TRAIN", Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(200, 64), TextSize = 24, ZIndex = 6, Parent = body })
	item.Action.RichText = true -- (the small cards' "TRAIN $26,250" shows a short price in red: H.paintSkill)
	-- (not the Button's Callback: a disabled button still says why, on the HintLine)
	item.Action.Activated:Connect(function()
		H.onAction(id)
	end)
	-- rank 10: a gold tag (the top rank is the card's "selected" thing)
	item.MaxTag = label(body, "MaxTag", "Display", 30, {
		ZIndex = 6, Visible = false, Text = "MAX", TextColor3 = C.Ink, BackgroundTransparency = 0, BackgroundColor3 = C.Gold,
		TextTruncate = Enum.TextTruncate.None,
	})
	H.edge(item.MaxTag, C.Wood, 3)
	U.Skills[id] = item
end

-- one mat: a clickable card with a face, two lines, a big glyph, a timer bar, a lock badge and the dashed edge of "+ Add a pet"
function H.newMat(i)
	-- (kit-b U9-5) a stone mat with its state on the lip (violet training, gold pending); no scale bounce (kit B)
	local card = NeonKit.Card({ Name = "Mat" .. i, Class = "TextButton", Skin = "Sign", Color = C.WellEdge, LipPx = 5, ZIndex = 4, Parent = U.Mats })
	local root, body = card.Root, card.Body
	root:SetAttribute("State", "Locked")
	root:SetAttribute("LockBadge", false)
	root:SetAttribute("Selected", false)
	local m = { Index = i, Card = card, Root = root, Dashes = {} }
	m.Dash = Util.Create("Frame", { Name = "Dashes", BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, Size = UDim2.fromScale(1, 1), ZIndex = 5, Parent = body })
	m.Art = Util.Create("Frame", { Name = "Face", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Parent = body })
	m.Line1 = label(body, "Line1", "Heading", 22, { ZIndex = 7 })
	m.Line2 = label(body, "Line2", "Body", 19, { ZIndex = 7 })
	m.Big = label(body, "Big", "Display", 48, { ZIndex = 7, TextTruncate = Enum.TextTruncate.None })
	-- (LOOK-ui2: a smooth violet fill with "2:07 left" across its edge) the timer: five violet kit blocks lit as the job runs,
	-- the time in the ink beside them (H.paintTimer)
	m.Bar = Util.Create("Frame", { Name = "TimerBar", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6, Parent = body })
	m.Blocks = SignKit.FitBlocks(m.Bar, { Name = "Blocks", Size = UDim2.fromScale(1, 1), Count = 5, Gap = 2, Weight = "Bar", Fill = SIGN.Violet, FillLip = SIGN.VioletLip, ZIndex = 7 })
	m.BarText = label(m.Bar, "Left", "Heading", 18, { ZIndex = 8, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0, 1),
		TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.None })
	m.Badge = label(body, "LockBadge", "Heading", 18, {
		ZIndex = 9, Visible = false, Text = "", BackgroundTransparency = 0, BackgroundColor3 = C.Gold, TextColor3 = C.Ink, TextTruncate = Enum.TextTruncate.None,
	})
	PixelIcon.Host(m.Badge, ICON.Lock) -- (kit-b U7b)
	H.edge(m.Badge, C.Wood, 2)
	root.Activated:Connect(function()
		safe("mat tap", H.onMat, i)
	end)
	U.MatList[i] = m
end

function H.buildConfirm()
	U.Shade = Util.Create("TextButton", {
		Name = "ConfirmShade", Text = "", AutoButtonColor = false, BorderSizePixel = 0, Active = true, Selectable = false, Visible = false,
		BackgroundColor3 = SIGN.NavyLip, BackgroundTransparency = 0.5, Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = U.Gui,
	})
	U.Shade.Activated:Connect(function()
		H.closeConfirm()
	end)
	local holder = Util.Create("Frame", { Name = "Confirm", BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = 41, Parent = U.Gui })
	U.Confirm = holder
	U.ConfirmFit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-5) a stone notice in a wood frame; the plain kit B title (the ribbon is for window titles)
	local box = Util.Create("Frame", { Name = "Box", BackgroundColor3 = C.Stone, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 42, Parent = holder })
	U.ConfirmStroke = H.edge(box, C.Wood, 6)
	U.ConfirmPop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = box })
	U.ConfirmTitle = Theme.StyleTitle(label(box, "Title", "Title", 30, { ZIndex = 43 }), "Section") -- (kit-b prep) a dialog's title
	U.ConfirmText = label(box, "Text", "Body", 20, {
		ZIndex = 43, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top,
	})
	U.ConfirmYes = CloudUI.Button({
		Name = "Yes", Text = "Yes", Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(250, 56), TextSize = 23, ZIndex = 44,
		Callback = function()
			local c = S.Confirm
			H.closeConfirm()
			if c and type(c.Yes) == "function" then
				safe("confirm", c.Yes)
			end
		end,
		Parent = box,
	})
	U.ConfirmNo = CloudUI.Button({
		Name = "No", Text = "Not now", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(190, 56), TextSize = 22, ZIndex = 44,
		Callback = function()
			H.closeConfirm()
		end,
		Parent = box,
	})
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
function H.layout()
	if not S.Built then
		return
	end
	local r = NeonKit.BigRect(K)
	S.Rect, S.Scale, S.Mode = r, r.scale, r.mode
	S.Portrait = r.mode == "Phone" and r.portrait == true
	local W = math.floor(r.w / r.scale + 0.5)
	local Hh = math.floor(r.h / r.scale + 0.5)
	place(U.Holder, r.x, r.y, W, Hh)
	U.Fit.Scale = r.scale
	S.W, S.H = W, Hh
	if S.Mode ~= "Phone" then
		H.layoutPC(W, Hh)
	elseif S.Portrait then
		H.layoutPortrait(W, Hh)
	else
		H.layoutPhone(W, Hh)
	end
	H.layoutConfirm()
	H.paint()
	H.coverColumn()
end

function H.metrics()
	return S.Mode == "Phone" and K.PHONE or K.PC
end

function H.layoutHeader()
	local M = H.metrics()
	local W = S.W or 0
	place(U.Header, 0, 0, W, M.Header)
	place(U.HeaderFoot, 0, M.Header - 5, W, 5) -- (kit-b U9-5) the plank's darker lip
	U.Roof.Visible = S.Mode ~= "Phone" -- (kit-b U9-5) a phone window sits right under Roblox's top bar: no awning stub
	place(U.Icon, M.HeadPad, (M.Header - M.Icon) / 2, M.Icon, M.Icon)
	SignKit.IconSlot(U.Icon, nil, M.IconPx)
	place(U.Close, W - M.HeadPad - M.Close, (M.Header - M.Close) / 2, M.Close, M.Close) -- (its drawn X scales with it)
	U.Chip.TextSize = M.ChipText
	local chipW = math.ceil(H.width(U.Chip.Text, M.ChipText, Theme.FontOf(U.Chip))) + 2 * M.ChipPad
	local chipX = W - M.HeadPad - M.Close - M.Gap - chipW
	place(U.Chip, chipX, (M.Header - M.ChipH) / 2, chipW, M.ChipH)
	local titleX = M.HeadPad + M.Icon + 12
	local titleW = math.max(40, chipX - M.Gap - titleX)
	place(U.Title, titleX, 6, titleW, M.Header - 12) -- (kit-b U9-5) 6 px in top and bottom: the ribbon lifts its letters (Drop), their box stays on the plank
	H.fit(U.Title, { "Training Place", "Training" }, titleW - 4, M.TitleText, M.TitleMin) -- (kit-b U9-5) 2 px each side for its outline
end

function H.layoutPC(W, Hh)
	local M = K.PC
	local bodyH = Hh - M.Header
	place(U.Body, 0, M.Header, W, bodyH)
	place(U.Mats, M.Pad, M.MatsY, W - 2 * M.Pad, M.MatsH)
	H.layoutMats(W - 2 * M.Pad, M.MatsH, K.MAT.pc.Gap)
	local y0 = M.Top
	local A = bodyH - y0 - M.Bottom
	local leftW = math.min(M.LeftMax, math.floor(W * M.LeftShare))
	local below = 4 + M.NameH + M.LevelH + 10 + M.Arrow + 10 + M.NoteH
	local cardH = A - below
	local note = true
	if cardH < 160 then
		note = false
		below = below - 10 - M.NoteH
		cardH = A - below
	end
	cardH = math.max(100, cardH)
	place(U.Card.Root, M.Pad, y0, leftW, cardH)
	H.layoutCardInside(leftW, cardH, false)
	local y = y0 + cardH + 4
	place(U.Name, M.Pad, y, leftW, M.NameH)
	U.Name.TextXAlignment = Enum.TextXAlignment.Center
	y = y + M.NameH
	place(U.Level, M.Pad, y, leftW, M.LevelH)
	U.Level.TextSize = M.LevelText
	U.Level.TextXAlignment = Enum.TextXAlignment.Center
	y = y + M.LevelH + 10
	place(U.Prev, M.Pad, y, M.Arrow, M.Arrow)
	place(U.Next, M.Pad + leftW - M.Arrow, y, M.Arrow, M.Arrow)
	place(U.Change, M.Pad + M.Arrow + 10, y, leftW - 2 * M.Arrow - 20, M.Arrow)
	U.Prev.TextSize, U.Next.TextSize = M.ArrowText, M.ArrowText
	y = y + M.Arrow + 10
	S.NoteOn = note
	place(U.Note, M.Pad, y, leftW, M.NoteH)
	U.Note.TextSize = M.NoteText
	-- the skill cards, 2 x 2
	local sx = M.Pad + leftW + M.ColGap
	local sw = W - sx - M.Pad
	place(U.SkillsFrame, sx, y0, sw, A)
	local cw = math.floor((sw - M.CardGap) / 2)
	local ch = math.floor((A - M.CardGap) / 2)
	S.Card = (ch >= 272 and "full") or (ch >= 222 and "compact") or "tight"
	for i, skill in ipairs(SKILLS) do
		local item = U.Skills[skill.Id]
		local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
		place(item.Root, col * (cw + M.CardGap), row * (ch + M.CardGap), cw, ch)
		if S.Card == "tight" then
			H.layoutSkillSmall(item, cw, ch, K.CARD.tight)
		else
			H.layoutSkillBig(item, cw, ch, K.CARD[S.Card])
		end
	end
	S.EmptyBody = { M.Pad, y0, W - 2 * M.Pad, A, M.Empty }
	S.EmptySkills = { sx + 20, y0, sw - 40, A, M.Empty }
	place(U.Hint, M.Pad + 40, bodyH - M.HintH - 10, W - 2 * M.Pad - 80, M.HintH)
	U.Hint.TextSize = M.Hint
end

function H.layoutPhone(W, Hh)
	local M = K.PHONE
	local bodyH = Hh - M.Header
	place(U.Body, 0, M.Header, W, bodyH)
	place(U.Mats, M.Pad, M.MatsY, W - 2 * M.Pad, M.MatsH)
	H.layoutMats(W - 2 * M.Pad, M.MatsH, K.MAT.phone.Gap)
	local y0 = M.Top
	local leftW = M.Left
	-- the card gives way on a lower phone so the buttons stay on the screen
	local cardH = math.max(80, math.min(M.CardH, bodyH - y0 - (2 + M.NameH + M.LevelH + 4 + M.Arrow) - M.Bottom))
	place(U.Card.Root, M.Pad, y0, leftW, cardH)
	H.layoutCardInside(leftW, cardH, true)
	local y = y0 + cardH + 2
	place(U.Name, M.Pad, y, leftW, M.NameH)
	U.Name.TextXAlignment = Enum.TextXAlignment.Center
	y = y + M.NameH
	place(U.Level, M.Pad, y, leftW, M.LevelH)
	U.Level.TextSize = M.LevelText
	U.Level.TextXAlignment = Enum.TextXAlignment.Center
	y = y + M.LevelH + 4
	place(U.Prev, M.Pad, y, M.Arrow, M.Arrow)
	place(U.Next, M.Pad + leftW - M.Arrow, y, M.Arrow, M.Arrow)
	place(U.Change, M.Pad + M.Arrow + 6, y, leftW - 2 * M.Arrow - 12, M.Arrow)
	U.Prev.TextSize, U.Next.TextSize = M.ArrowText, M.ArrowText
	S.NoteOn = false -- (no room on a landscape phone)
	local sx = M.Pad + leftW + M.ColGap
	local sw = W - sx - M.Pad
	local A = bodyH - y0 - M.Bottom
	place(U.SkillsFrame, sx, y0, sw, A)
	local cw = math.floor((sw - M.CardGapX) / 2)
	local ch = math.floor((A - M.CardGapY) / 2)
	S.Card = "phone"
	for i, skill in ipairs(SKILLS) do
		local item = U.Skills[skill.Id]
		local col, row = (i - 1) % 2, math.floor((i - 1) / 2)
		place(item.Root, col * (cw + M.CardGapX), row * (ch + M.CardGapY), cw, ch)
		H.layoutSkillSmall(item, cw, ch, K.CARD.phone)
	end
	S.EmptyBody = { M.Pad, y0, W - 2 * M.Pad, A, M.Empty }
	S.EmptySkills = { sx + 8, y0, sw - 16, A, M.Empty }
	place(U.Hint, M.Pad + 10, bodyH - M.HintH - 6, W - 2 * M.Pad - 20, M.HintH)
	U.Hint.TextSize = M.Hint
end

function H.layoutPortrait(W, Hh)
	local M = K.PHONE
	local bodyH = Hh - M.Header
	place(U.Body, 0, M.Header, W, bodyH)
	local pad = 12
	place(U.Mats, pad, M.MatsY, W - 2 * pad, 60)
	H.layoutMats(W - 2 * pad, 60, K.MAT.mini.Gap)
	local y0 = 72
	local cardW, cardH = 150, 140
	local gap = 8
	-- (playtest 2026-11-28 C39 review, round 3) a short portrait phone (360x640: 53 px cards, the line half under the lip)
	-- gives the skill cards the compact stack's height (K.CARD.row.Min): their gaps go to 6, then the pet card gives up
	-- height down to the landscape card's (M.CardH; its rest note hides under 30 px, as on a landscape phone)
	local rowMin = K.CARD.row.Min
	local function cardsH(cH, g)
		return math.floor((bodyH - (y0 + cH + 10) - 6 - 3 * g) / 4)
	end
	if cardsH(cardH, gap) < rowMin then
		gap = 6
		local short = rowMin - cardsH(cardH, gap)
		if short > 0 then
			cardH = math.max(M.CardH, cardH - 4 * short)
		end
	end
	place(U.Card.Root, pad, y0, cardW, cardH)
	H.layoutCardInside(cardW, cardH, true)
	local rx = pad + cardW + 10
	local rw = W - rx - pad
	place(U.Name, rx, y0 + 4, rw, 24)
	U.Name.TextXAlignment = Enum.TextXAlignment.Left
	place(U.Level, rx, y0 + 28, rw, 22)
	U.Level.TextSize = M.LevelText
	U.Level.TextXAlignment = Enum.TextXAlignment.Left
	local by = y0 + 56
	place(U.Prev, rx, by, M.Arrow, M.Arrow)
	place(U.Next, rx + rw - M.Arrow, by, M.Arrow, M.Arrow)
	place(U.Change, rx + M.Arrow + 6, by, rw - 2 * M.Arrow - 12, M.Arrow)
	U.Prev.TextSize, U.Next.TextSize = M.ArrowText, M.ArrowText
	place(U.Note, rx, by + M.Arrow + 6, rw, cardH - (by - y0) - M.Arrow - 6)
	U.Note.TextSize = 15
	S.NoteOn = U.Note.Size.Y.Offset >= 30
	local sy = y0 + cardH + 10
	local A = bodyH - sy - 6
	place(U.SkillsFrame, pad, sy, W - 2 * pad, A)
	local ch = math.floor((A - 3 * gap) / 4)
	S.Card = "row"
	for i, skill in ipairs(SKILLS) do
		local item = U.Skills[skill.Id]
		place(item.Root, 0, (i - 1) * (ch + gap), W - 2 * pad, ch)
		H.layoutSkillRow(item, W - 2 * pad, ch, K.CARD.row)
	end
	S.EmptyBody = { pad, y0, W - 2 * pad, bodyH - y0 - 6, M.Empty }
	S.EmptySkills = { pad + 6, sy, W - 2 * pad - 12, A, M.Empty }
	place(U.Hint, pad + 6, bodyH - 44, W - 2 * pad - 12, 38)
	U.Hint.TextSize = M.Hint
end

-- the big pet card's inside: the viewport, the rarity chip, the element chip (PC), the "Pick a pet" prompt
function H.layoutCardInside(w, h, small)
	local chipH = small and 22 or 32
	place(U.Art, 6, small and 4 or 10, w - 12, h - (small and 8 or 20))
	place(U.Rarity, 8, 8, 10, chipH)
	U.Rarity.TextSize = small and 15 or 18
	place(U.Element, w - 8 - 10, 8, 10, chipH)
	U.Element.TextSize = 18
	U.Prompt.TextSize = small and K.PHONE.PromptText or K.PC.PromptText
	place(U.Prompt, 4, 0, w - 8, h)
	S.CardW, S.CardSmall = w, small
end

-- the five mats across the band (equal widths, `gap` apart); the style follows the room: pc (a tall band), phone (a 52
-- band with mats >= 100 wide), mini (a portrait phone). Each mat's inside is placed by its paint (it depends on the state).
function H.layoutMats(bandW, bandH, gap)
	local n = K.MAX_MATS
	local w = math.floor((bandW - (n - 1) * gap) / n)
	local style = (bandH >= 96 and "pc") or (w >= 100 and "phone") or "mini"
	for i, m in ipairs(U.MatList) do
		place(m.Root, (i - 1) * (w + gap), 0, w, bandH)
		m.W, m.H, m.Style = w, bandH, style
		H.layoutDashes(m, w, bandH, K.MAT[style])
	end
end

-- the dashed edge of a "+ Add a pet" mat: short bars along each side, the rounded corners left open
function H.layoutDashes(m, w, h, mm)
	local thick, r = K.MAT.DashThick, K.MAT.Corner
	local n = 0
	local function edge(x0, y0, len, horizontal)
		local count = math.max(1, math.floor((len + mm.DashGap) / (mm.Dash + mm.DashGap)))
		local start = (len - (count * mm.Dash + (count - 1) * mm.DashGap)) / 2
		for k = 0, count - 1 do
			n = n + 1
			local piece = m.Dashes[n]
			if not piece then
				piece = Util.Create("Frame", { Name = "Dash", BackgroundColor3 = C.Muted, BorderSizePixel = 0, ZIndex = 6, Parent = m.Dash })
				m.Dashes[n] = piece
			end
			piece.Visible = true
			local off = start + k * (mm.Dash + mm.DashGap)
			if horizontal then
				place(piece, x0 + off, y0, mm.Dash, thick)
			else
				place(piece, x0, y0 + off, thick, mm.Dash)
			end
		end
	end
	edge(r, 1, w - 2 * r, true)
	edge(r, h - 1 - thick, w - 2 * r, true)
	edge(1, r, h - 2 * r, false)
	edge(w - 1 - thick, r, h - 2 * r, false)
	for k = n + 1, #m.Dashes do
		m.Dashes[k].Visible = false
	end
end

-- (LOOK-ui2) a mat's timer: the blocks lit for the share of the job done, `text` ("2:07 left") beside them in the ink
function H.paintTimer(m, frac, text)
	SignKit.FillBlocks(m.Blocks, math.floor(math.max(0, math.min(1, tonumber(frac) or 0)) * 5 + 1e-6))
	m.BarText.Text = text
	m.BarText.Visible = text ~= ""
	local tw = (text ~= "") and math.ceil(H.width(text, m.BarText.TextSize, Theme.FontOf(m.BarText)) * 1.1) + 4 or 0
	m.BarText.Size = UDim2.new(0, tw, 1, 0)
	m.Blocks.Size = UDim2.new(1, -(tw > 0 and tw + 6 or 0), 1, 0)
end

function H.layoutBar(item, x, y, w, h)
	place(item.Bar, x, y, w, math.max(10, h)) -- (the blocks lay themselves out in it; under 10 px a face would vanish)
end

-- PC full / compact: icon + name + rank, the bar, Now, Next, and the cost / time beside the button
function H.layoutSkillBig(item, w, h, m)
	item.IconHolder.Visible = true
	place(item.IconHolder, m.Pad, m.Pad, m.Icon, m.Icon)
	item.Orb.Size = UDim2.fromOffset(m.Icon, m.Icon)
	item.Icon.TextSize = m.IconText
	local tx = m.Pad + m.Icon + 12
	local tw = w - tx - m.Pad
	place(item.NameL, tx, m.NameY, tw, m.NameH)
	H.fit(item.NameL, { item.NameL.Text }, tw, m.Name, m.NameMin)
	place(item.RankL, tx, m.NameY + m.NameH, tw, m.RankH)
	item.RankL.TextSize = m.Rank
	item.RankL.TextXAlignment = Enum.TextXAlignment.Left
	H.layoutBar(item, m.Pad, m.BarY, w - 2 * m.Pad, m.BarH)
	item.Now.Visible, item.Next.Visible, item.Cost.Visible, item.Time.Visible = true, true, true, true
	place(item.Now, m.Pad, m.NowY, w - 2 * m.Pad, m.LineH)
	place(item.Next, m.Pad, m.NextY, w - 2 * m.Pad, m.LineH)
	item.Now.TextSize, item.Next.TextSize = m.Line, m.Line
	local by = h - m.Pad - m.BtnH
	place(item.Action, w - m.Pad - m.BtnW, by, m.BtnW, m.BtnH)
	place(item.MaxTag, w - m.Pad - m.BtnW, by, m.BtnW, m.BtnH)
	item.MaxTag.TextSize = m.MaxText
	local cw = w - 2 * m.Pad - m.BtnW - 10
	place(item.Cost, m.Pad, by, cw, m.CostH)
	place(item.Time, m.Pad, by + m.CostH, cw, m.TimeH)
	item.Cost.TextSize, item.Time.TextSize = m.Cost, m.Time
	item.Lay = m
end

-- phone (and the tight PC card): the name and "4/10" on top, the bar, one line, the button across the bottom
function H.layoutSkillSmall(item, w, h, m)
	item.IconHolder.Visible = false
	local pad = m.Pad
	local topH, barH, gap = m.TopH, m.BarH, 3
	-- (LOOK-ui2: at 844x390 the plank lay on the card's lip, the line on the plank) the plank's wood edge (drawn outside
	-- its box) ends 4 px above the card's 6 px lip, and the line keeps 6 px over that edge
	local edge = CloudUI.SignMetrics and CloudUI.SignMetrics.Edge or 5
	local by = h - m.BtnH - math.max(m.Bottom, 6 + 4 + edge)
	local lineY = m.Top + topH + gap + barH + gap
	if lineY + m.LineH + 6 + edge > by then
		-- a short card: a slimmer bar and gaps
		barH, gap = 10, 2
		topH = math.max(m.Name + 2, by - 6 - edge - m.LineH - m.Top - 2 * gap - barH)
		lineY = m.Top + topH + gap + barH + gap
	end
	local rankW = math.ceil(H.width("10/10", m.Rank, Theme.FontOf(item.RankL))) + 6
	place(item.NameL, pad, m.Top, w - 2 * pad - rankW - 4, topH)
	H.fit(item.NameL, { item.NameL.Text }, w - 2 * pad - rankW - 4, m.Name, m.NameMin)
	place(item.RankL, w - pad - rankW, m.Top, rankW, topH)
	item.RankL.TextSize = m.Rank
	item.RankL.TextXAlignment = Enum.TextXAlignment.Right
	H.layoutBar(item, pad, m.Top + topH + gap, w - 2 * pad, barH)
	item.Next.Visible, item.Cost.Visible, item.Time.Visible = false, false, false
	-- (the line only where it keeps 6 px over the plank's edge)
	item.Now.Visible = lineY + m.LineH + 6 + edge <= by
	place(item.Now, pad, lineY, w - 2 * pad, m.LineH)
	item.Now.TextSize = m.Line
	place(item.Action, pad, by, w - 2 * pad, m.BtnH)
	place(item.MaxTag, pad, by, w - 2 * pad, m.BtnH)
	item.MaxTag.TextSize = m.MaxText
	item.Lay = m
end

-- portrait: the name, "4/10", the bar and one line on the left, the button on the right
function H.layoutSkillRow(item, w, h, m)
	item.IconHolder.Visible = false
	local pad = m.Pad
	local bx = w - 8 - m.BtnW
	local lw = bx - pad - 8
	local rankW = math.ceil(H.width("10/10", m.Rank, Theme.FontOf(item.RankL))) + 6
	local top = math.max(4, math.floor((h - 64) / 2))
	-- the name 20, the bar at +24 (10), the line at +40 (20), the button centred on the card
	local nameH, barY, lineY, lineH, btnY = 20, top + 24, top + 40, 20, (h - m.BtnH) / 2
	local bodyH = h - (m.Lip or 6)
	if top + 60 > bodyH then
		-- (playtest 2026-11-28 C39 review, round 3) a short card (53 px at 360x640) ran the line 17 px past its body, half
		-- under the lip: the compact stack (name 18, bar 10, line 17; 2 and 3 px apart), centred in the body with the button
		top = math.max(1, math.floor((bodyH - 50) / 2))
		nameH, barY, lineY, lineH = 18, top + 20, top + 33, 17
		btnY = math.max(0, math.floor((bodyH - m.BtnH) / 2))
	end
	place(item.NameL, pad, top, lw - rankW - 4, nameH)
	H.fit(item.NameL, { item.NameL.Text }, lw - rankW - 4, m.Name, m.NameMin)
	place(item.RankL, pad + lw - rankW, top, rankW, nameH)
	item.RankL.TextSize = m.Rank
	item.RankL.TextXAlignment = Enum.TextXAlignment.Right
	H.layoutBar(item, pad, barY, lw, 10)
	item.Next.Visible, item.Cost.Visible, item.Time.Visible = false, false, false
	item.Now.Visible = true
	place(item.Now, pad, lineY, lw, lineH)
	item.Now.TextSize = m.Line
	place(item.Action, bx, btnY, m.BtnW, m.BtnH)
	place(item.MaxTag, bx, btnY, m.BtnW, m.BtnH)
	item.MaxTag.TextSize = m.MaxText
	item.Lay = m
end

function H.layoutConfirm()
	if not U.Confirm then
		return
	end
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local inset = 58
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	place(U.Shade, 0, 0, vp.X, vp.Y)
	local scale = Theme.ScreenFactor(vp.Y)
	local freeW, freeH = vp.X - 24, vp.Y - inset - 16
	local w = math.min(K.CONFIRM_W, math.floor(freeW / scale))
	local pad = 24
	local textW = w - 2 * pad
	local textH = H.wrappedHeight(U.ConfirmText.Text, 20, Theme.FontOf(U.ConfirmText), textW)
	local titleH = 40
	local btnY = pad + titleH + 12 + textH + 16
	local h = btnY + 56 + pad
	if h * scale > freeH then
		scale = math.max(0.5, freeH / h)
	end
	U.ConfirmFit.Scale = scale
	place(U.Confirm, (vp.X - w * scale) / 2, inset + (vp.Y - inset - h * scale) / 2, w, h)
	place(U.ConfirmTitle, pad, pad - 4, textW, titleH)
	H.fit(U.ConfirmTitle, { U.ConfirmTitle.Text }, textW, 30, 22)
	place(U.ConfirmText, pad, pad + titleH + 12, textW, textH)
	U.ConfirmText.TextSize = 20
	local noW = 190
	local yesW = math.min(260, textW - noW - 14)
	local bx = (w - yesW - noW - 14) / 2
	place(U.ConfirmYes, bx, btnY, yesW, 56)
	place(U.ConfirmNo, bx + yesW + 14, btnY, noW, 56)
	H.fit(U.ConfirmYes, { U.ConfirmYes.Text }, yesW - 16, 23, 18)
	H.fit(U.ConfirmNo, { U.ConfirmNo.Text }, noW - 16, 22, 18)
end

----------------------------------------------------------------------
-- Paint
----------------------------------------------------------------------
function H.chipText(level, used, slots)
	if level < 1 then
		return S.Portrait and "Not built yet" or "No Training Place yet"
	end
	if S.Mode == "Phone" then
		-- (LOOK-ui2: "1 / 2 spots" took the title's room, "TRAINING PL..") the count alone on a phone's plank
		return used .. "/" .. slots
	end
	return "Training spots: " .. used .. " / " .. slots .. " in use"
end

-- "Lv 57 / 100" and the evolution stars drawn after it (kit-b U7b: gold PixelIcon stars, 0-2)
function H.levelText(key, def)
	local lv = Bits.petLevel(key)
	return "Lv " .. lv .. " / " .. Bits.levelCap(key, def), math.min(2, Bits.stage(key))
end

function H.paint()
	if not S.Built then
		return
	end
	if S.Key and not H.valid(S.Key) then
		S.Key = nil -- the selected pet left the collection: the empty state
	end
	local home = Bits.homeData()
	local level = H.placeLevel(home)
	local used, slots = H.used(), H.slots(home)
	local hasPets = #H.order() > 0
	U.Chip.Text = H.chipText(level, used, slots)
	-- (kit-b U9-5) every spot in use: the tag turns gold (brown ink on both faces)
	U.Chip.BackgroundColor3 = (level >= 1 and slots > 0 and used >= slots) and C.Gold or C.Stone
	U.Chip.TextColor3 = C.Ink
	H.layoutHeader()
	-- the pet column
	for _, o in ipairs({ U.Card.Root, U.Name, U.Level, U.Prev, U.Change, U.Next, U.SkillsFrame }) do
		o.Visible = hasPets
	end
	-- (no Training Place: the build text takes the skills' place; the five mats show locked above it)
	U.SkillsFrame.Visible = hasPets and level >= 1
	U.Note.Visible = hasPets and S.NoteOn == true
	H.paintPet()
	for _, skill in ipairs(SKILLS) do
		safe("skill " .. skill.Id, H.paintSkill, U.Skills[skill.Id])
	end
	safe("mats", H.paintMats)
	-- the empty texts: no pets (the body), no Training Place (the skills' place)
	local spec, text = nil, nil
	if not hasPets then
		spec, text = S.EmptyBody, TEXTS.NoPets
	elseif level < 1 then
		spec, text = S.EmptySkills, TEXTS.NoPlace
	end
	U.Empty.Visible = spec ~= nil
	if spec then
		place(U.Empty, spec[1], spec[2], spec[3], spec[4])
		U.Empty.TextSize = spec[5]
		U.Empty.Text = text
	end
end

function H.paintPet()
	local key = S.Key
	local def = key and H.def(key) or nil
	local phone = S.Mode == "Phone"
	if not def then
		U.Card.SetColor(C.Grey)
		U.Prompt.Visible = true
		U.Prompt.Text = '<font size="' .. (phone and 34 or 64) .. '">' .. G.Plus .. "</font>\nPick a pet"
		U.Rarity.Visible, U.Element.Visible = false, false
		U.Name.Text, U.Level.Text = "", ""
		U.Change.Text = "Pick a pet"
		H.showView(nil)
	else
		local rarityColor = CloudUI.RarityColor(def.Rarity)
		U.Card.SetColor(rarityColor)
		U.Prompt.Visible = false
		-- the rarity chip
		U.Rarity.Visible = true
		U.Rarity.Text = string.upper(tostring(def.Rarity or "")) -- (kit-b U9-5) a stone tag; the colour is on the card's lip
		local rw = math.ceil(H.width(U.Rarity.Text, U.Rarity.TextSize, Theme.FontOf(U.Rarity))) + (phone and 14 or 22)
		U.Rarity.Size = UDim2.fromOffset(rw, U.Rarity.Size.Y.Offset)
		-- the element chip (PC: there is room)
		local elements = Bits.elementsOf(def)
		local el = elements[1]
		local info = el and Config.Elements and Config.Elements.Info and Config.Elements.Info[el]
		U.Element.Visible = (not S.CardSmall) and info ~= nil
		if U.Element.Visible then
			U.Element.Text = el
			U.ElementStroke.Color = info.Color or C.Wood -- (kit-b U9-5) the element's colour on the tag's edge, brown ink
			U.Element.TextColor3 = C.Ink
			local ew = math.ceil(H.width(el, U.Element.TextSize, Theme.FontOf(U.Element))) + 22
			place(U.Element, (S.CardW or 200) - 8 - ew, 8, ew, U.Element.Size.Y.Offset)
		end
		-- the name and the level
		local M = H.metrics()
		local name = Bits.displayName(key, def)
		local nameMax = S.Portrait and 18 or M.NameText
		local nameMin = S.Portrait and 15 or M.NameMin
		local last = name:match("(%S+)$") or name
		U.Name.TextWrapped = false
		if S.Portrait then
			H.fit(U.Name, { name, last }, U.Name.Size.X.Offset - 4, nameMax, nameMin)
		else
			-- (LOOK-ui2: "BLOSSOM BUN..." at 1280x720, a pet's name cut in the window's largest type) measured in the capitals
			-- it is drawn in, from 42 down to 26; past that its whole name on two lines, never cut, never just its last word
			local room = U.Name.Size.X.Offset - 4
			local size = nameMax
			local function capsW(px)
				return math.max(H.width(string.upper(name), px, Theme.FontOf(U.Name)), #name * px * 0.66)
			end
			while size > math.min(nameMax, 26) and capsW(size) > room do
				size = size - 1
			end
			U.Name.Text = name
			U.Name.TextTruncate = Enum.TextTruncate.None
			if capsW(size) <= room then
				U.Name.TextSize = size
			else
				U.Name.TextWrapped = true
				U.Name.TextSize = math.max(18, math.min(size, math.floor(U.Name.Size.Y.Offset / 2.3)))
			end
		end
		U.Name.TextColor3 = C.Ink
		local levelText, stars = H.levelText(key, def)
		U.Level.Text = levelText
		PixelIcon.Mark(U.Level, stars > 0 and "star" or nil, { After = true, Count = stars, Of = stars, Colour = C.GoldInk })
		U.Change.Text = (phone and "Change") or "Change pet"
		H.showView(key, def, Bits.stage(key))
	end
	H.fit(U.Change, { U.Change.Text, "Pick" }, U.Change.Size.X.Offset - 22, phone and K.PHONE.ChangeText or K.PC.ChangeText, phone and 15 or 18)
end

-- the pet viewport of key at its stage (cached per key and stage; parked ones are hidden and skip work)
function H.showView(key, def, stage)
	local id = key and (key .. "#" .. tostring(stage or 0)) or nil
	if S.ViewId == id and (not id or (U.Views[id] and U.Views[id].Handle.Frame.Parent == U.Art)) then
		return
	end
	if S.ViewId and U.Views[S.ViewId] then
		U.Views[S.ViewId].Handle.Frame.Parent = U.Cache
	end
	S.ViewId = nil
	if not id then
		return
	end
	local v = U.Views[id]
	if not v then
		local ok, handle = pcall(CloudUI.PetViewport, U.Art, def, UDim2.fromScale(1, 1), {
			Detail = "Low", Spin = "sway", Evolved = (stage or 0) >= 1 and stage or nil, ZIndex = 5,
		})
		if not (ok and type(handle) == "table" and handle.Frame) then
			warnOnce("viewport", handle)
			return
		end
		v = { Handle = handle }
		U.Views[id] = v
	end
	v.Handle.Frame.Parent = U.Art
	v.Used = os.clock()
	S.ViewId = id
	H.trimViews()
end

function H.trimViews()
	local list = {}
	for id, v in pairs(U.Views) do
		if id ~= S.ViewId then
			list[#list + 1] = { Id = id, Used = v.Used or 0 }
		end
	end
	table.sort(list, function(a, b)
		return a.Used < b.Used
	end)
	local extra = #list + 1 - K.VIEW_CACHE
	for i = 1, extra do
		local v = U.Views[list[i].Id]
		U.Views[list[i].Id] = nil
		if v then
			pcall(v.Handle.Destroy)
		end
	end
end

----------------------------------------------------------------------
-- The mats row (Task 8)
----------------------------------------------------------------------
function H.growthMap()
	local ok, map = pcall(State.PetGrowthMap)
	return (ok and type(map) == "table") and map or {}
end

function H.matsNow()
	local selected = (S.Key and H.valid(S.Key)) and S.Key or nil
	return H.mats(Bits.homeData(), H.growthMap(), selected), selected
end

function H.paintMats()
	if #U.MatList == 0 then
		return
	end
	local mats, selected = H.matsNow()
	for i, m in ipairs(U.MatList) do
		safe("mat " .. i, H.paintMat, m, mats[i] or { State = "Locked", Unlock = i }, selected)
	end
end

-- a text that fits `width`: refit only when the texts, the width or the label's own text changed (the 0.5 s tick
-- repaints the mats; TextService is not asked again for the same answer)
function H.fitMat(lbl, texts, width, maxSize, minSize, em)
	local sig = table.concat(texts, "\n") .. "|" .. width .. "|" .. maxSize .. "|" .. minSize .. "|" .. tostring(em)
	local c = S.FitSigs[lbl]
	if c and c.Sig == sig and c.Text == lbl.Text and c.Size == lbl.TextSize then
		return
	end
	-- (the outlined text needs a little more than its measured width: a quarter of its size, K.MAT.FitMargin)
	-- (LOOK-ui2: "Blossom Bun..." at 1280x720) `em`: a pet's name is never taken under 0.52 em a letter (K.MAT.NameEm), so
	-- its last word takes over before a cut
	H.fit(lbl, texts, width - math.ceil(maxSize * K.MAT.FitMargin), maxSize, minSize, em)
	S.FitSigs[lbl] = { Sig = sig, Text = lbl.Text, Size = lbl.TextSize }
end

function H.paintMat(m, spec, selected)
	local st, key = spec.State, spec.Key
	local root, card = m.Root, m.Card
	local style = m.Style or "pc"
	local mm = K.MAT[style]
	local w, h = m.W or 200, m.H or 100
	local isSelected = key ~= nil and key == selected
	root:SetAttribute("State", st)
	root:SetAttribute("Key", key)
	root:SetAttribute("LockBadge", spec.LockBadge == true)
	root:SetAttribute("Selected", isSelected)
	local def = key and H.def(key) or nil
	local name = def and Bits.displayName(key, def) or "A pet"
	local lastWord = name:match("(%S+)$") or name
	-- the card
	local job = st == "Job"
	-- (kit-b U9-5) the state on the lip (violet training, gold pending); a pet's mat is a raised stone tile, a free / locked
	-- one a sunk well (the free one with its dashed edge and no lip); selected = the gold-tinted face with the ink edge
	local color = C.WellEdge
	if job then
		color = C.Purple
	elseif st == "Pending" then
		color = C.Gold
	end
	card.SetColor(color)
	card.SetFace((job or st == "Pending") and C.Tile or C.Well)
	card.Lip.Visible = st ~= "Add"
	card.Stroke.Transparency = st == "Add" and 1 or 0
	root.BackgroundTransparency = 0
	card.SetGlow(st == "Pending" or (job and isSelected))
	m.Dash.Visible = st == "Add"
	-- reset the insides
	m.Line1.Visible, m.Line2.Visible, m.Big.Visible, m.Bar.Visible = false, false, false, false
	m.Line1.TextXAlignment, m.Line2.TextXAlignment = Enum.TextXAlignment.Left, Enum.TextXAlignment.Left
	m.Line1.TextColor3, m.Line2.TextColor3, m.Big.TextColor3 = C.Ink, C.Ink, C.Ink
	local face = (job or st == "Pending") and def ~= nil
	H.matView(m, face and key or nil, def, face and Bits.stage(key) or 0)
	m.Art.Visible = face
	-- the lock badge (a job on a mat a Prestige closed)
	local badge = job and spec.LockBadge == true
	m.Badge.Visible = badge
	local badgeW = 0
	if badge then
		badgeW = mm.Badge + 4
		place(m.Badge, w - mm.Badge - (style == "pc" and 8 or 2), style == "pc" and 8 or 2, mm.Badge, mm.Badge)
		m.Badge.TextSize = mm.BadgeText
	end
	-- the job's numbers
	local left, frac, statLines = 0, 0, nil
	if job then
		local j = spec.Job or {}
		left = math.max(0, (tonumber(j.Ends) or 0) - H.now())
		local rank = math.max(1, math.floor(tonumber(j.Rank) or 1))
		local total = tonumber(Bits.catalogCall("TrainSeconds", rank)) or 60
		frac = math.max(0, math.min(1, 1 - left / math.max(1, total)))
		local stat = tostring(j.Stat or "")
		statLines = { H.skillName(stat) .. " " .. G.Dot .. " Rank " .. rank, stat .. " " .. G.Dot .. " Rank " .. rank, "Rank " .. rank }
	end
	if style == "pc" then
		H.paintMatPC(m, st, spec, mm, w, h, name, lastWord, face, badgeW, left, frac, statLines)
	elseif style == "phone" then
		H.paintMatPhone(m, st, spec, mm, w, h, name, lastWord, face, badgeW, left, frac)
	else
		H.paintMatMini(m, st, spec, mm, w, h, face, left)
	end
end

function H.paintMatPC(m, st, spec, mm, w, h, name, lastWord, face, badgeW, left, frac, statLines)
	local pad = mm.Pad
	if st == "Job" or st == "Pending" then
		local fx = pad
		if face then
			place(m.Art, pad, mm.Top, mm.Face, mm.Face)
			fx = pad + mm.Face + 8
		end
		local nameW = w - fx - pad - badgeW
		m.Line1.Visible = true
		place(m.Line1, fx, mm.Top, nameW, mm.Face)
		H.fitMat(m.Line1, { name, lastWord }, nameW - 2, mm.Name, mm.NameMin, K.MAT.NameEm)
		local y2 = mm.Top + mm.Face + 2
		m.Line2.Visible = true
		place(m.Line2, pad, y2, w - 2 * pad, mm.LineH)
		local barY = h - pad - mm.BarH
		if st == "Job" then
			H.fitMat(m.Line2, statLines, w - 2 * pad - 2, mm.Line, mm.LineMin)
			m.Bar.Visible = true
			place(m.Bar, pad, barY, w - 2 * pad, mm.BarH)
			m.BarText.TextSize = mm.BarText
			H.paintTimer(m, frac, H.clock(left) .. " left")
		else
			-- the pending pet: its level, then the call to pick a skill
			local key = spec.Key
			local lv = key and Bits.petLevel(key) or 0
			m.Line2.TextColor3 = C.Muted
			H.fitMat(m.Line2, { "Lv " .. lv }, w - 2 * pad - 2, mm.Line, mm.LineMin)
			m.Big.Visible = true
			PixelIcon.Set(m.Big, nil) -- (kit-b U7b) a lock / wait icon from before goes
			Theme.SetRole(m.Big, "Body") -- U.Note's role (its .Font reads Unknown: a Nunito face)
			m.Big.TextColor3 = C.MatGood
			m.Big.TextXAlignment = Enum.TextXAlignment.Left
			place(m.Big, pad, barY, w - 2 * pad, mm.BarH)
			H.fitMat(m.Big, { "Pick a skill below", "Pick a skill" }, w - 2 * pad - 2, mm.Line, mm.LineMin)
		end
	elseif st == "Add" then
		local block = mm.Plus + 4 + 30
		local top = math.floor((h - block) / 2)
		m.Big.Visible = true
		Theme.SetRole(m.Big, "Title")
		m.Big.TextXAlignment = Enum.TextXAlignment.Center
		m.Big.TextSize = mm.Plus
		PixelIcon.Set(m.Big, nil)
		m.Big.Text = G.Plus
		place(m.Big, 0, top, w, mm.Plus)
		m.Line1.Visible = true
		m.Line1.TextXAlignment = Enum.TextXAlignment.Center
		place(m.Line1, pad, top + mm.Plus + 4, w - 2 * pad, 30)
		H.fitMat(m.Line1, { "Add a pet", "Add" }, w - 2 * pad - 2, mm.Name, mm.NameMin)
	else
		-- locked (the lock and its level) / in use (an hourglass: a job on a closed mat holds this spot)
		local lv = spec.Unlock or m.Index
		local inUse = st == "InUse"
		local block = mm.Lock + 8 + mm.LineH
		local top = math.floor((h - block) / 2)
		m.Big.Visible = true
		Theme.SetRole(m.Big, "Title")
		m.Big.TextXAlignment = Enum.TextXAlignment.Center
		m.Big.TextSize = mm.Lock
		PixelIcon.Set(m.Big, inUse and ICON.Wait or ICON.Lock, PixelIcon.Snap(mm.Lock)) -- (kit-b U7b)
		place(m.Big, 0, top, w, mm.Lock + 4)
		m.Line2.Visible = true
		m.Line2.TextXAlignment = Enum.TextXAlignment.Center
		m.Line2.TextColor3 = C.Muted
		place(m.Line2, pad, top + mm.Lock + 8, w - 2 * pad, mm.LineH)
		H.fitMat(m.Line2, inUse and { "Spot in use", "In use" } or { "Training Place Lv " .. lv, "Lv " .. lv }, w - 2 * pad - 2, mm.Line, mm.LineMin)
	end
end

function H.paintMatPhone(m, st, spec, mm, w, h, name, lastWord, face, badgeW, left, frac)
	local pad = mm.Pad
	if st == "Job" or st == "Pending" then
		local fx = pad + 2
		if face then
			place(m.Art, pad, math.floor((h - mm.Face) / 2), mm.Face, mm.Face)
			fx = pad + mm.Face + 4
		end
		local tw = w - fx - pad
		local job = st == "Job"
		local y1 = job and 3 or math.floor(h / 2) - mm.LineH - 1
		m.Line1.Visible = true
		place(m.Line1, fx, y1, tw - badgeW, mm.LineH)
		H.fitMat(m.Line1, { name, lastWord }, tw - badgeW - 2, mm.Text, mm.Text, K.MAT.NameEm)
		m.Line2.Visible = true
		place(m.Line2, fx, y1 + mm.LineH, tw, mm.LineH)
		if job then
			m.Line2.TextColor3 = C.PurpleInk
			H.fitMat(m.Line2, { H.clock(left) .. " left", H.clock(left) }, tw - 2, mm.Text, mm.Text)
			m.Bar.Visible = true
			place(m.Bar, fx, h - mm.BarH - 4, tw, mm.BarH)
			H.paintTimer(m, frac, "")
		else
			m.Line2.TextColor3 = C.MatGood
			H.fitMat(m.Line2, { "Pick a skill", "Pick" }, tw - 2, mm.Text, mm.Text)
		end
	else
		-- "+ Add a pet" / "In use" / the lock and its level, one centred line
		m.Line1.Visible = true
		m.Line1.TextXAlignment = Enum.TextXAlignment.Center
		place(m.Line1, pad, 0, w - 2 * pad, h)
		if st == "Add" then
			H.fitMat(m.Line1, { G.Plus .. " Add a pet", G.Plus .. " Add" }, w - 2 * pad - 2, mm.Text, mm.Text)
		elseif st == "InUse" then
			m.Line1.TextColor3 = C.Muted
			H.fitMat(m.Line1, { "In use" }, w - 2 * pad - 2, mm.Text, mm.Text)
		else
			m.Line1.TextColor3 = C.Muted
			H.fitMat(m.Line1, { "Opens at Lv " .. (spec.Unlock or m.Index), "Lv " .. (spec.Unlock or m.Index) }, w - 2 * pad - 2, mm.Text, mm.Text)
		end
	end
end

-- a portrait phone: the face (or a big glyph) over one short line
function H.paintMatMini(m, st, spec, mm, w, h, face, left)
	local lineY = h - mm.LineH - 2
	m.Line2.Visible = true
	m.Line2.TextXAlignment = Enum.TextXAlignment.Center
	place(m.Line2, mm.Pad, lineY, w - 2 * mm.Pad, mm.LineH)
	local text
	if st == "Job" or st == "Pending" then
		if face then
			place(m.Art, math.floor((w - mm.Face) / 2), 3, mm.Face, mm.Face)
		end
		if st == "Job" then
			m.Line2.TextColor3 = C.PurpleInk
			text = { H.clock(left) }
		else
			m.Line2.TextColor3 = C.MatGood
			text = { "Pick a skill", "Pick" }
		end
	else
		m.Big.Visible = true
		Theme.SetRole(m.Big, "Title")
		m.Big.TextXAlignment = Enum.TextXAlignment.Center
		local size = st == "Add" and mm.Plus or mm.Lock
		m.Big.TextSize = size
		if st == "Add" then
			PixelIcon.Set(m.Big, nil)
			m.Big.Text = G.Plus
		else
			PixelIcon.Set(m.Big, st == "InUse" and ICON.Wait or ICON.Lock, PixelIcon.Snap(size)) -- (kit-b U7b)
		end
		place(m.Big, 0, math.max(2, math.floor((lineY - size) / 2)), w, size + 4)
		if st == "Add" then
			text = { "Add" }
		elseif st == "InUse" then
			m.Line2.TextColor3 = C.Muted
			text = { "In use" }
		else
			m.Line2.TextColor3 = C.Muted
			text = { "Lv " .. (spec.Unlock or m.Index) }
		end
	end
	H.fitMat(m.Line2, text, w - 2 * mm.Pad - 2, mm.Text, mm.Text)
end

-- the mat's face: a Low viewport of key at its stage, cached per key and stage (a key shows on one mat at most)
function H.matView(m, key, def, stage)
	local id = key and (key .. "#" .. tostring(stage or 0)) or nil
	local v = id and U.MatViews[id] or nil
	if m.ViewId == id and (not id or (v and v.Handle.Frame.Parent == m.Art)) then
		return
	end
	if m.ViewId and U.MatViews[m.ViewId] and U.MatViews[m.ViewId].Handle.Frame.Parent == m.Art then
		U.MatViews[m.ViewId].Handle.Frame.Parent = U.Cache
	end
	m.ViewId = nil
	if not id then
		return
	end
	for _, other in ipairs(U.MatList) do
		if other ~= m and other.ViewId == id then
			other.ViewId = nil -- it moves over to this mat
		end
	end
	if not v then
		local ok, handle = pcall(CloudUI.PetViewport, m.Art, def, UDim2.fromScale(1, 1), {
			Detail = "Low", Spin = "sway", Evolved = (stage or 0) >= 1 and stage or nil, ZIndex = 6,
		})
		if not (ok and type(handle) == "table" and handle.Frame) then
			warnOnce("mat viewport", handle)
			return
		end
		v = { Handle = handle }
		U.MatViews[id] = v
	end
	v.Handle.Frame.Parent = m.Art
	v.Used = os.clock()
	m.ViewId = id
	-- the cache: drop the oldest parked faces
	local parked = {}
	for vid, pv in pairs(U.MatViews) do
		local shown = false
		for _, other in ipairs(U.MatList) do
			if other.ViewId == vid then
				shown = true
			end
		end
		if not shown then
			parked[#parked + 1] = { Id = vid, Used = pv.Used or 0 }
		end
	end
	table.sort(parked, function(a, b)
		return a.Used < b.Used
	end)
	for i = 1, #parked - (K.MAT_VIEW_CACHE - K.MAX_MATS) do
		local pv = U.MatViews[parked[i].Id]
		U.MatViews[parked[i].Id] = nil
		if pv then
			pcall(pv.Handle.Destroy)
		end
	end
end

-- a tap on mat i: a job selects its pet, a free mat opens the sheet, a locked one says how to open it
function H.onMat(i)
	if not S.Open or H.inMatch() then
		return
	end
	local spec = (H.matsNow())[i]
	if not spec then
		return
	end
	if spec.State == "Job" then
		if spec.Key and H.valid(spec.Key) then
			TrainController.Select(spec.Key)
		end
	elseif spec.State == "Pending" or spec.State == "Add" then
		if #H.order() == 0 then
			H.hint(TEXTS.NoPets)
		else
			H.openSheet()
		end
	elseif spec.State == "InUse" then
		-- every spot is taken (a job on a closed mat holds this one): the sheet would only offer "Spots full"
		H.hint(TEXTS.InUseMat)
	else
		H.hint(H.lockHint(spec.Unlock or i))
	end
end

function H.paintSkill(item)
	local id = item.Id
	local st = H.skillState(id)
	S.States[id] = st
	item.Root:SetAttribute("State", st)
	local key = S.Key
	local def = key and H.valid(key) and H.def(key) or nil
	local small = S.Card == "phone" or S.Card == "row" or S.Card == "tight"
	local m = item.Lay or K.CARD.full
	local maxRank = H.maxRank()
	local rank = def and H.rank(key, id) or 0
	local job = def and Bits.job(key) or nil
	local eff = EFFECT[id]
	local nowPct, nextPct = H.pct(id, rank), H.pct(id, rank + 1)
	local cost = def and (tonumber(Bits.catalogCall("TrainCost", def, rank + 1)) or 0) or 0
	local seconds = tonumber(Bits.catalogCall("TrainSeconds", rank + 1)) or 60
	local noPet = def == nil
	-- the card's colour
	local color = item.Color
	if st == "Training" then
		color = C.Purple
	elseif noPet or st == "NoPlace" or st == "Match" then
		color = C.Grey
	end
	item.Card.SetColor(color)
	-- the rank and the bar
	if noPet then
		item.RankL.Text = ""
	elseif small then
		item.RankL.Text = rank .. "/" .. maxRank
	else
		item.RankL.Text = "Rank " .. rank .. " / " .. maxRank
	end
	local trainingSeg = (st == "Training" and job) and math.floor(tonumber(job.Rank) or (rank + 1)) or nil
	SignKit.FillBlocks(item.Blocks, noPet and 0 or rank)
	-- (LOOK-ui2: it was violet, Ability's own colour) the rank in training: a gold block
	local b = trainingSeg and trainingSeg > rank and item.Blocks:FindFirstChild("Block" .. trainingSeg)
	local face = b and b:FindFirstChild("Face")
	if face then
		face.BackgroundColor3 = C.Gold
		local lip = face:FindFirstChild("Lip")
		if lip then
			lip.BackgroundColor3 = SIGN.GoldLip
		end
	end
	item.Blocks:SetAttribute("Training", face and trainingSeg or nil)
	-- the texts
	local nowText, nextText, costText, timeText = "", "", "", ""
	local nextColor, timeColor = C.Good, C.Muted
	local left = job and math.max(0, (tonumber(job.Ends) or 0) - H.now()) or 0
	local jobRank = job and math.floor(tonumber(job.Rank) or (rank + 1)) or (rank + 1)
	-- rank 0 has no bonus yet ("-0% damage taken" would read oddly)
	local nowShort = rank > 0 and (eff.Sign .. nowPct .. "%") or "0%"
	local words = rank > 0 and (eff.Sign .. nowPct .. "% " .. eff.Words) or "no bonus yet"
	local tail = eff.Sign == "-" and (" " .. eff.Words) or "" -- (playtest 2026-11-28 C39) "-3% damage taken"
	if noPet then
		nowText = ""
	elseif st == "Training" then
		nowText = "Now: " .. words
		nextText = "Rank " .. jobRank .. ": " .. eff.Sign .. H.pct(id, jobRank) .. "%" .. tail
		timeText = "Rank " .. jobRank .. " " .. G.Dot .. " " .. H.clock(left) .. " left"
		timeColor = C.PurpleInk
	elseif st == "Max" then
		nowText = "Now: " .. words
		nextText, nextColor = "Top rank!", C.Ink
	else
		nowText = "Now: " .. words
		nextText = "Rank " .. (rank + 1) .. ": " .. eff.Sign .. nextPct .. "%" .. tail
		costText = H.commas(cost)
		timeText = H.minutes(seconds)
	end
	if small then
		-- one line: "+16% -> +20% - 5 min" / "Rank 4 - 2:10 left" / "+40% - top rank"
		local line = ""
		if st == "Training" then
			line = timeText
		elseif st == "Max" then
			line = nowShort .. " " .. G.Dot .. " top rank"
		elseif not noPet then
			line = nowShort .. " " .. G.Arrow .. " " .. eff.Sign .. nextPct .. "% " .. G.Dot .. " " .. timeText
		end
		local plain = (line:gsub(" " .. G.Dot .. " .*$", ""))
		local fits = { line, plain }
		if eff.Lead and not noPet and st ~= "Training" then
			-- (playtest 2026-11-28 C39) "Hits 0% -> -3% - 1 min": the lead says what the minus takes off. Both lead lines
			-- come first: the time drops before the lead does (at 360x640 the bare "0% -> -3% - 1 min" won over
			-- "Hits 0% -> -3%", the penalty look the playtest named)
			fits = { eff.Lead .. " " .. line, eff.Lead .. " " .. plain, line, plain }
		end
		H.fit(item.Now, fits, item.Now.Size.X.Offset - 2, m.Line, m.Line)
		item.Now.TextColor3 = st == "Training" and timeColor or C.Ink
	else
		local fits = { nowText }
		if not noPet and rank > 0 then
			if eff.Short then
				fits[#fits + 1] = "Now: " .. eff.Sign .. nowPct .. "% " .. eff.Short
			end
			fits[#fits + 1] = "Now: " .. nowShort
		end
		H.fit(item.Now, fits, item.Now.Size.X.Offset - 2, m.Line, math.max(18, m.Line - 2))
		item.Now.TextColor3 = C.Ink
		item.Next.TextColor3 = nextColor
		-- (playtest 2026-11-28 C39) a minus skill's words drop only when its line has no room for them
		H.fit(item.Next, { nextText, (nextText:gsub(tail ~= "" and (" " .. eff.Words .. "$") or "^$", "")) }, item.Next.Size.X.Offset - 2, m.Line, m.Line)
		item.Cost.Text = costText
		item.Cost.TextColor3 = st == "Short" and C.Bad or C.Good
		item.Time.Text, item.Time.TextColor3 = timeText, timeColor
	end
	-- the button
	local maxed = st == "Max"
	item.Action.Visible = not maxed
	item.MaxTag.Visible = maxed
	if not maxed then
		-- (kit-b U9-5) one colour by role: the four TRAIN buttons are peers, so stone (no green action here); STOP is the red one
		local text, colorName, disabled = "TRAIN", "Gray", false
		if st == "Ready" or st == "Short" then
			if small then
				-- cash short: the price inside the greyed button in red, as the full card's Cost line (spec 5.5)
				local price = H.commas(cost)
				text = "TRAIN " .. (st == "Short" and ('<font color="#' .. H.hex(C.Bad) .. '">' .. price .. "</font>") or price)
			end
			disabled = st == "Short"
		elseif st == "Training" then
			text, colorName = "STOP", "Pink"
		elseif st == "Busy" then
			-- (playtest 2026-11-28 C58) the PET is busy (training another skill), not this skill: 'Busy training' sat on idle ones
			text, disabled = "Pet is busy", true
		elseif st == "Full" then
			text, disabled = "Spots full", true
		elseif st == "Match" then
			text, disabled = "In a match", true
		elseif st == "NoPet" then
			text, disabled = "Pick a pet first", true
		elseif st == "NoPlace" then
			text, disabled = "No Training Place", true
		end
		if item.Action:GetAttribute("Style") ~= colorName then
			CloudUI.SetStyle(item.Action, colorName)
		end
		if item.Action:GetAttribute("Disabled") ~= disabled then
			item.Action:SetAttribute("Disabled", disabled)
		end
		-- (the fallback drops the price, plain or in its red font tag: "TRAIN")
		H.fit(item.Action, { text, (text:gsub(" %$.*$", ""):gsub(" <font.*$", "")) }, item.Action.Size.X.Offset - 22, m.BtnText or 22, m.BtnMin or 18)
	end
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
function H.fire(gapKey, name, ...)
	local now = os.clock()
	if S.Last[gapKey] and now - S.Last[gapKey] < K.FIRE_GAP then
		return false
	end
	local ok, remote = pcall(Remotes.Get, name)
	if not ok or not remote then
		warnOnce("remote " .. name, remote)
		return false
	end
	S.Last[gapKey] = now
	local args = { ... }
	local n = select("#", ...)
	return (pcall(function()
		remote:FireServer(unpack(args, 1, n))
	end))
end

function H.hint(text)
	if not (U.Hint and S.Open) then
		return
	end
	S.HintToken = S.HintToken + 1
	local mine = S.HintToken
	U.Hint.Text = tostring(text)
	U.Hint.Visible = true
	task.delay(K.HINT_SECONDS, function()
		if S.HintToken == mine and U.Hint then
			U.Hint.Visible = false
		end
	end)
end

function H.onAction(stat)
	if not S.Open then
		return
	end
	local st = H.skillState(stat)
	if st == "Ready" then
		H.askTrain(S.Key, stat)
	elseif st == "Training" then
		H.askStop(S.Key)
	elseif HINTS[st] then
		H.hint(HINTS[st])
	end
end

function H.showConfirm(spec)
	if not U.Confirm then
		return
	end
	if S.Sheet then
		H.closeSheet() -- the sheet and the confirm are never up together
	end
	S.Confirm = spec
	U.ConfirmTitle.Text = spec.Title or ""
	U.ConfirmTitle.TextColor3 = C.Ink -- (kit-b U9-5) brown on stone; the wood frame stays (spec.Color was the neon edge)
	U.ConfirmText.Text = spec.Text or ""
	U.ConfirmYes.Text = spec.YesText or "Yes"
	CloudUI.SetStyle(U.ConfirmYes, spec.Style or "Green")
	U.ConfirmNo.Text = spec.NoText or "Not now"
	H.layoutConfirm()
	U.Shade.Visible = true
	U.Confirm.Visible = true
	U.ConfirmPop.Scale = 0.9
	Util.Tween(U.ConfirmPop, 0.18, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	H.syncBack()
end

function H.closeConfirm()
	S.Confirm = nil
	if U.Confirm then
		U.Confirm.Visible = false
		U.Shade.Visible = false
	end
	H.syncBack()
end

-- TRAIN asks first (CareController's texts of today)
function H.askTrain(key, stat)
	local def = H.valid(key) and H.def(key) or nil
	if not def or H.inMatch() then
		return
	end
	local rank = H.rank(key, stat) + 1
	local cost = tonumber(Bits.catalogCall("TrainCost", def, rank)) or 0
	local seconds = tonumber(Bits.catalogCall("TrainSeconds", rank)) or 60
	local name = Bits.displayName(key, def)
	H.showConfirm({
		Title = "Train " .. H.skillName(stat) .. "?",
		Text = name .. " goes to Rank " .. rank .. " " .. H.skillName(stat) .. " for " .. H.money(cost) .. ". It takes "
			.. H.minutes(seconds) .. ". " .. name .. " rests at home until it's done, then comes back by itself.",
		YesText = "Train " .. H.money(cost),
		Style = "Green",
		Color = Theme.Lighten(C.Good, 0.1),
		Yes = function()
			H.fire("train", "PetCare", "Train", key, stat)
		end,
	})
end

-- STOP asks first: the Cash comes back when the job was paid this Prestige (Job.Paid > 0)
function H.askStop(key)
	local def = H.valid(key) and H.def(key) or nil
	local job = def and Bits.job(key) or nil
	if not job then
		return
	end
	local paid = tonumber(job.Paid) or 0
	H.showConfirm({
		Title = "Stop training?",
		Text = (paid > 0 and "You get the Cash back, no rank. " or "No rank and no Cash back (it was paid before your Prestige). ")
			.. Bits.displayName(key, def) .. " comes back to you right away.",
		YesText = "Stop training",
		NoText = "Keep training",
		Style = "Pink",
		Color = Color3.fromRGB(255, 160, 200),
		Yes = function()
			H.fire("trainstop", "PetCare", "TrainStop", key)
		end,
	})
end

----------------------------------------------------------------------
-- The picker sheet (UI/PetPicker, Train context)
----------------------------------------------------------------------
function H.openSheet()
	if not S.Open or H.inMatch() then
		return
	end
	if #H.order() == 0 then
		return
	end
	H.closeConfirm()
	S.SheetToken = S.SheetToken + 1
	local mine = S.SheetToken
	local ok = PetPicker.Open({
		Context = "Train",
		Title = "Pick a pet to train",
		Selected = S.Key,
		OnPick = function(key)
			if S.Open then
				TrainController.Select(key)
			end
		end,
		OnClose = function()
			if S.SheetToken == mine then
				S.Sheet = false
			end
		end,
	})
	S.Sheet = ok == true
	H.syncBack()
end

function H.closeSheet()
	if S.Sheet then
		S.Sheet = false
		S.SheetToken = S.SheetToken + 1
		safe("sheet close", PetPicker.Close)
	end
end

----------------------------------------------------------------------
-- One window at a time, the touch controls, the menu column, Esc / B
----------------------------------------------------------------------
function H.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "DailyController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			safe("close " .. name, mod.Close)
		end
	end
	local care = H.controller("CareController")
	if care and type(care.CloseOwn) == "function" then
		safe("close care", care.CloseOwn)
	end
	if PetPicker.IsOpen() and not S.Sheet then
		safe("close sheet", PetPicker.Close) -- another window's sheet
	end
end

function H.notifyCare(open)
	local care = H.controller("CareController")
	if care and type(care.NotifyTrain) == "function" then
		safe("notify care", care.NotifyTrain, open)
	end
end

function H.syncTouch()
	local touchOnly = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local want = S.Open and (S.Mode == "Phone" or touchOnly)
	if want == S.TouchOff then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		safe("touch", menu.SetTouchHidden, "Train", want)
	end
end

function H.coverColumn()
	local menu = H.controller("MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		safe("cover", menu.SetColumnCovered, (S.Open and S.Rect) and S.Rect.x or nil, "Train")
	end
	H.coverVitals()
	H.syncTouch()
end

-- (LOOK-ui2: at 1920x1080 the window left a 6% sliver of the vitals card under its bottom edge) the open window hides
-- the HUD's vitals card while it covers any of it (HudController.SetVitalsHidden "Train"; the slot is gui-area px, the
-- window's rect screen px)
function H.coverVitals()
	local hud = H.controller("HudController")
	if not (hud and type(hud.SetVitalsHidden) == "function") then
		return
	end
	local cover = false
	local r = S.Open and S.Rect
	if r then
		local ok, layout = pcall(hud.GetLayout)
		local slot = ok and type(layout) == "table" and layout.VitalsSlot or nil
		if type(slot) == "table" and tonumber(slot.W) and slot.W > 0 then
			local okI, inset = pcall(function()
				return GuiService:GetGuiInset().Y
			end)
			local top = (okI and tonumber(inset)) or 0
			local x0, y0 = slot.X, slot.Y + top
			cover = r.x < x0 + slot.W and r.x + r.w > x0 and r.y < y0 + slot.H and r.y + r.h > y0
		end
	end
	safe("vitals", hud.SetVitalsHidden, "Train", cover)
end

-- Esc / B: the confirm first, then our sheet, then the window
function H.back()
	if S.Confirm then
		H.closeConfirm()
	elseif S.Sheet and PetPicker.IsOpen() then
		H.closeSheet()
	elseif S.Open then
		TrainController.Close()
	end
end

function H.syncBack()
	local want = S.Open or S.Confirm ~= nil
	if want and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					safe("back", H.back)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	elseif not want and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function H.refreshSoon()
	if S.RefreshPending then
		return
	end
	S.RefreshPending = true
	task.defer(function()
		S.RefreshPending = false
		if S.Open then
			safe("refresh", H.paint)
		end
	end)
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function TrainController.IsOpen()
	return S.Open or S.Confirm ~= nil
end

function TrainController.Key()
	return S.Key
end

function TrainController.Layout()
	local mode, portrait
	if S.Open and S.Rect then
		mode, portrait = S.Mode, S.Portrait
	else
		local r = NeonKit.BigRect(K)
		mode, portrait = r.mode, r.mode == "Phone" and r.portrait == true
	end
	if portrait then
		return "Portrait"
	end
	return mode
end

function TrainController.SkillState(stat)
	if not EFFECT[stat] then
		return nil
	end
	return H.skillState(stat)
end

-- the mats row as data (pure: its arguments and the catalogs only; see the header)
function TrainController.Mats(home, growthMap, selectedKey)
	return H.mats(home, growthMap, selectedKey)
end

function TrainController.Select(key)
	if not H.valid(key) then
		return false
	end
	S.Key = key
	if S.Open then
		safe("paint", H.paint)
	end
	return true
end

function TrainController.Step(dir)
	local order = H.order()
	local n = #order
	if n == 0 then
		return false
	end
	local back = (tonumber(dir) or 1) < 0
	local index = nil
	for i, key in ipairs(order) do
		if key == S.Key then
			index = i
			break
		end
	end
	local key
	if not index then
		key = back and order[n] or order[1]
	else
		key = order[((index - 1 + (back and -1 or 1)) % n) + 1]
	end
	return TrainController.Select(key)
end

function TrainController.DropReturn()
	S.ReturnTo = nil
	S.BackTo = nil
end

function TrainController.Open(args)
	if not initialized then
		TrainController.Init()
	end
	args = type(args) == "table" and args or {}
	if H.inMatch() or not H.ensureGui() then
		return false
	end
	H.build()
	local wasOpen = S.Open
	if not wasOpen then
		H.closeOthers()
		S.BackTo = nil
		S.ReturnTo = type(args.ReturnTo) == "table" and args.ReturnTo or nil
	end
	if H.valid(args.Key) then
		S.Key = args.Key
	elseif not wasOpen or not H.valid(S.Key) then
		S.Key = H.firstTraining()
	end
	S.Open = true
	if not wasOpen then
		S.Token = S.Token + 1
	end
	U.Holder.Visible = true
	H.layout()
	H.syncBack()
	if not wasOpen then
		U.Pop.Scale = K.OPEN_FROM
		Util.Tween(U.Pop, K.OPEN_TIME, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		local mine = S.Token
		task.spawn(function()
			while S.Open and S.Token == mine do
				task.wait(K.TICK)
				if S.Open and S.Token == mine then
					safe("tick", H.paint)
				end
			end
		end)
		H.notifyCare(true)
	end
	-- no pet chosen: the sheet opens by itself (a Training Place and a pet exist)
	if not S.Key and not S.Sheet and H.placeLevel(Bits.homeData()) >= 1 and #H.order() > 0 then
		H.openSheet()
	end
	return true
end

function TrainController.Close()
	H.closeConfirm()
	H.closeSheet()
	if not S.Open then
		return
	end
	S.Open = false
	S.Token = S.Token + 1
	local mine = S.Token
	local back = S.ReturnTo
	S.ReturnTo = nil
	S.HintToken = S.HintToken + 1
	if U.Hint then
		U.Hint.Visible = false
	end
	H.syncBack()
	H.coverColumn()
	if U.Pop then
		Util.Tween(U.Pop, 0.12, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
		end
	end)
	H.notifyCare(false)
	if back then
		-- came from the Pets window: back to it next, unless what closed this one takes over (DropReturn)
		S.BackTo = back
		task.defer(function()
			if S.BackTo == back then
				S.BackTo = nil
				local pets = H.controller("PetsController")
				if pets and type(pets.Open) == "function" and not H.inMatch() then
					safe("back to pets", pets.Open, back)
				end
			end
		end)
	end
end

-- Escape that only ends typing (a focused TextBox: the sheet's search, the chat) goes back nowhere. Roblox lets go of the
-- box as it handles that Escape, so a box let go this very moment counts too. (Not InputBegan's gameProcessed: Roblox's
-- own menu binds Escape, so a plain Escape can arrive processed as well, and the window would stop closing on Esc.)
function H.typing()
	return UserInputService:GetFocusedTextBox() ~= nil or os.clock() - S.TypedAt < K.TYPED_GAP
end

function TrainController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	H.ensureGui()
	State.Changed:Connect(function()
		if S.Open then
			H.refreshSoon()
		end
	end)
	for _, name in ipairs({ "CashChanged", "BerriesChanged" }) do
		local signal = State[name]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function()
				if S.Open then
					H.refreshSoon()
				end
			end)
		end
	end
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				TrainController.DropReturn()
				TrainController.Close()
			end
		end)
	end
	UserInputService.TextBoxFocusReleased:Connect(function()
		S.TypedAt = os.clock()
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and (S.Open or S.Confirm) and not H.typing() then
			safe("back", H.back)
		end
	end)
end

return TrainController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1171">
            <Properties>
              <string name="Name">TrainerCheer</string>
              <string name="Source"><![CDATA[-- TrainerCheer (client, wave 6 "fight focus", docs/superpowers/specs/2026-10-29-fight-focus-wave6-design.md goal 4):
-- the local player's OWN avatar cheers its pets on. On the Champion Ring / PvP podium (the server sets the player attribute
-- Config.Attr.OnPodium) it loops; a "Cheer up!" press in a dungeon / raid plays it once (BattleController, on the
-- server's Cheer event). The animation is the avatar's built-in /cheer emote through the default Animate script's
-- PlayEmote BindableFunction (R15 and R6), so no animation id is shipped (check.mjs asset-id). A rig without PlayEmote
-- plays nothing (the boost still works on the server). Each client plays only its own avatar: Roblox replicates the
-- character's animation to everyone else. No sound here (the sound wave owns that). Plain Lua 5.1-compatible syntax only.
--
-- API
--   TrainerCheer.Play(character) -> bool   invokes Animate.PlayEmote("cheer"); while the pose is not standing (PlayEmote
--                                          answers false) it retries every RETRY s for up to RETRY_FOR s; false when the
--                                          rig has no PlayEmote
--   TrainerCheer.StartLoop(character)      play now, then again every LOOP_GAP (2.5-4 s) until StopLoop / the character
--                                          goes (a second StartLoop restarts it)
--   TrainerCheer.StopLoop()
--   TrainerCheer.IsLooping() -> bool

local TrainerCheer = {}

TrainerCheer.EMOTE = "cheer"
TrainerCheer.RETRY = 0.2
TrainerCheer.RETRY_FOR = 1
TrainerCheer.LOOP_GAP = { 2.5, 4 }

local rng = Random.new()
local loopToken = 0
local looping = false

-- the character's PlayEmote BindableFunction | nil
local function playEmoteOf(character)
	if typeof(character) ~= "Instance" then
		return nil
	end
	local animate = character:FindFirstChild("Animate")
	local fn = animate and animate:FindFirstChild("PlayEmote")
	if fn and fn:IsA("BindableFunction") then
		return fn
	end
	return nil
end

local function invoke(fn)
	local ok, result = pcall(function()
		return fn:Invoke(TrainerCheer.EMOTE)
	end)
	return ok and result ~= false and result ~= nil
end

function TrainerCheer.Play(character)
	local fn = playEmoteOf(character)
	if not fn then
		return false
	end
	if invoke(fn) then
		return true
	end
	-- not standing yet (landing, the podium teleport): a few short retries, never a queue
	task.spawn(function()
		local waited = 0
		while waited < TrainerCheer.RETRY_FOR do
			task.wait(TrainerCheer.RETRY)
			waited = waited + TrainerCheer.RETRY
			if not character.Parent or invoke(fn) then
				return
			end
		end
	end)
	return true
end

function TrainerCheer.StopLoop()
	loopToken = loopToken + 1
	looping = false
end

function TrainerCheer.StartLoop(character)
	loopToken = loopToken + 1
	local token = loopToken
	looping = true
	task.spawn(function()
		while token == loopToken and typeof(character) == "Instance" and character.Parent do
			TrainerCheer.Play(character)
			local gap = TrainerCheer.LOOP_GAP
			task.wait(rng:NextNumber(gap[1], gap[2]))
		end
		if token == loopToken then
			looping = false
		end
	end)
end

function TrainerCheer.IsLooping()
	return looping
end

return TrainerCheer
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1172">
            <Properties>
              <string name="Name">TroveController</string>
              <string name="Source"><![CDATA[-- TroveController (client, store 2026-11-04; docs/superpowers/specs/2026-11-04-shop-retention-design.md 5.3 / 8 / 13b.5):
-- the Sky Trove panel and the chest's lid.
--
--   TroveController.Init()
--   TroveController.Open(state)   shows the panel (state = a TroveState table, optional: the last one is kept)
--   TroveController.Close()
--   TroveController.IsOpen() -> bool
--
-- How it opens: the server's OpenPanel("Trove") (TroveService, after the chest's prompt passed its checks) arrives here
-- (MenuController's onOpenPanel falls through for this id), TroveState(state) fills and refreshes the rows. The client
-- decides nothing: the server checks the group and pays.
--
-- The panel (ScreenGui NimbusTrove, DisplayOrder 18; IgnoreGuiInset false like every text-bearing gui, client_load):
-- docked right so the chest stays in view. Box: NeonKit.SideRect(520, 380, 420, 226) answers whether the 1080p design
-- fits; when it does the PC layout (520 x 380 design px at the rect's scale, 12 px x factor from the right, its top
-- 8 px x factor + the awning's 10 px under the HUD's currency strips and the gift's square: NimbusHud TopRightBottom, as
-- the Stats window docks; U9-4 look review: on top of them a sliver of the strips showed), otherwise (or where that dock
-- would run off a short desktop window) the phone layout at scale 1 (420 x 226, 12 px
-- from the right, top = inset + 8; on a touch screen where that box would end on the game's DASH button it reaches down
-- to THUMB_GAP px over Roblox's jump button instead, see phoneHeight); a portrait screen gets the bottom sheet (as wide
-- as the screen allows up to 400, 274 tall, 12 px over the bottom right) so the character stays clear.
-- (kit-b U9-4, finding 15) the Signboard kit: "TrovePanel" is the wood frame round "Stone" (the stone body with its
-- lip); (U9-4 look review) "Header" is SignKit.Header as the Stats / My Home side panels build theirs: the wood rim, the
-- navy "Plate" the title's band (look review 2: inside the rim with no tails at every size, the docked panel's rule)
-- holding "TroveIcon" (the gold icon square in its 2 px ink edge with the pixel chest), "TitleText" ("SKY TROVE" with its
-- stair), and "Close" (the red block on the plate, its X in brown ink; a phone: 36 px over its 44 px "CloseTap");
-- "Roof" the fixed-size awning (PC 360, the portrait sheet 240 under clear sky, never the landscape phone panel; never
-- stretched). Each ask is a stone block ("Row_Group",
-- "Row_Like") with a square icon chip ("Chip": the pixel people on sky, the heart on pink); the rewards are gold tags
-- ("CashChip" "$2,000", "TokenChip" the token coin + "200"); while the reward waits (Open) two pixel sparkles by the tags
-- take turns every second (the family's glint, as the Gifts window's today tile); "JoinButton" is the panel's one green
-- action. Nothing round or glossy, no neon.
--   PC:    header 60 (the 42 icon square, Title 32, X 40); subtitle Body 20 "Help Nimbus grow and the Trove pays you!"; rows 100 /
--          88 (chip 72 with its 54 px icon, label 20, tags 19 on 36, button 140 x 52); the footer 19 (>= 15 px at 1280x720's
--          0.8 scale)
--   phone: header 50 (a 36 square, Title 22, a 36 px X in its 44 px touch box); no subtitle (the panel keeps clear of the
--          jump button); rows 62 / 46 (chip 34, or 48 where both rows have room, label 15-16 on one line, tags 15,
--          button 96 x 44), the footer 15; (U9-4 review) the game's DASH
--          button sits 10 px over the jump button, so a 226 px panel ended on it on touch phones 390 to 460 px tall
--          (under the 58 px top bar: a sliver of DASH under its edge); there the panel stretches into that gap (228 at
--          844x390, 231 at 852x393, 268 at 932x430), covering DASH and its stroke whole and keeping the controls; a
--          quarter of the spare to each ask, the rest to the gaps round them; portrait: the lines wrap
-- The Group row: "Join the Nimbus Climb group" + the tags; its button reads Join (Open), Done (disabled, Done), Preview
-- (disabled, Preview: GroupId 0 in the Studio preview), sentence case (the kit's casing rule); no button for Checked /
-- Unavailable / Loading / Soon (Soon's label reads "Coming soon"). The Like row has no button. The footer: "Community
-- links are on our game page. Prizes go straight to you. Once per player." Join -> pcall(GroupService.PromptJoinAsync,
-- GroupId): Joined / AlreadyMember -> TroveRequest("Joined"); JoinRequestPending -> the hint "Your request is waiting
-- for the group. Come back later!"; None / an error -> "Not joined yet. Join from the game page, then come back in a new
-- server." (the hint takes the footer's place, in the kit's red ink).
-- Touch (the owner's rule: no control under Roblox's thumbstick or jump button): on a touch-only screen the panel keeps
-- Roblox's touch controls (the player can walk off) wherever its whole box clears the stick's zone and the jump button by
-- 6 px (HudController's rects); where it cannot (a short landscape phone, the portrait sheet) they go while it is open
-- (MenuController.SetTouchHidden("Trove")) and come back on Close. The HUD's vitals card steps aside while the panel lies
-- over it (HudController.SetVitalsHidden("Trove")).
-- The claim (a Done transition while the panel is open): the lid (CollectionService:GetTagged(Config.Tags.TroveLid)[1],
-- pivoted on its PrimaryPart hinge) swings 18 -> 70 degrees over 0.35 s (Back); on High 18 pooled client-only coins arc
-- from the chest into the character over 0.8 s; SoundFx "TroveOpen" ("Reward" until that key has an id); the toast is the
-- server's. Low: the lid and the sound only (the NC_Detail light and sparkles are already parked). No camera move.
-- One window at a time: opening fires MenuController.WindowOpened("Trove"); any other window id (and the other
-- controllers' Opened signals), entering a match and Esc close it.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local GroupService = game:GetService("GroupService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U9-4) the chest, the row icons, the token coin, the sparkles
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-4) the awning over the panel
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))

local TroveController = {}

local SIGN = Theme.Sign
local K = {
	DISPLAY_ORDER = 18,
	PREF_W = 520, PREF_H = 380, MIN_W = 420, MIN_H = 226,
	MARGIN = 12, TOP_GAP = 8,
	FRAME = 6, -- the wood frame round the stone body
	ROOF_W = 360, ROOF_OVER = -SignKit.RoofSeat(), -- the awning: a fixed 360 px, its top 20 design px over the panel's (seated, F0 review)
	-- (U9-4 look review) the portrait sheet's awning (SignKit.Sizes.RoofPhoneW: look review 2, 240, its right end clear of
	-- the close block), wherever ROOF_CLEAR px of clear screen lie over the sheet's top (never on the landscape panel,
	-- which starts under Roblox's top bar)
	ROOF_PHONE_W = SignKit.Sizes.RoofPhoneW, ROOF_CLEAR = 26, -- (F0 review) the seated awning: its box 20 + bracket 2 over the top, 4 clear
	-- (U9-4 look review 2) a phone plate's close: a CloseBlock px red block centred on the plate, its 3 px stroke
	-- CLOSE_INSET - 3 px inside the plate's right end, over its Close px touch box ("CloseTap", under it): the Gifts window's
	CLOSE_INSET = 7,
	REST_DEG = 18, OPEN_DEG = 70, LID_TIME = 0.35,
	COINS = 18, COIN_TIME = 0.8, COIN_FLIGHT = 0.55,
	TWINKLE = 1, -- s each sparkle stays lit
	-- Roblox's own touch controls (gui px; HudController's K: small = the smaller screen side <= SMALL_PHONE): the stick's
	-- zone at the bottom left, the jump button J x J from 1.5 J + 10 to 0.5 J + 10 off the right edge, its bottom 20 px
	-- (small) or 0.75 J over the bottom edge; the panel keeps THUMB_GAP px clear of both or the controls go
	SMALL_PHONE = 500, STICK_W_SMALL = 110, STICK_H_SMALL = 96, STICK_H_PORTRAIT = 150, STICK_W_LARGE = 190, STICK_H_LARGE = 210,
	JUMP_SMALL = 70, JUMP_LARGE = 120, THUMB_GAP = 6,
	-- (U9-4 review) the game's DASH button (MovementController's layoutMobileControls; keep in sync): D x D centred over
	-- the jump button, its bottom DASH_GAP px over the jump button's top, a DASH_STROKE px stroke round it
	DASH_SMALL = 66, DASH_LARGE = 84, DASH_GAP = 10, DASH_STROKE = 3,
}
-- design px; Header = the SignKit header's height (its wood rim on top, the navy plate under it); rows from the panel's
-- top. (U9-4 look review) the header is SignKit.Header as the Stats / My Home side panels build it: Slot = the gold icon
-- square (SignKit.Sizes.IconSlot on PC; a phone's 44 px plate takes a 36 px square), SlotIcon the pixel chest in it,
-- Close the red block on the plate (40 on PC as the Stats window's, 44 on a phone: the touch floor; look review 2, a
-- phone draws a CloseBlock px block in that touch box).
-- (U9-4 look review 2: one pixel size per screen) every pixel icon at one of the kit's two sizes (SignKit.Sizes.Pixel,
-- as the Gifts window): PC the chest, the coin and the sparkles at the glyph size (27, 3 px cells), a row's icon at the
-- art size (54 on a 72 chip); a phone the glyph size (18, 2 px cells) and a row's icon the art size (36 on a 48 chip,
-- ChipBig) where both rows have room for it, else the glyph size on the 34 px chip
local PX = SignKit.Sizes.Pixel
local PC = { W = 520, H = 380, Header = 60, Slot = 42, SlotIcon = PX.PC.Glyph, TitleText = 32, Close = 40, Pad = 16,
	Sub = 20, SubY = 72, SubH = 26, Row1 = 108, Row1H = 100, Row2 = 216, Row2H = 88, Chip = 72, ChipIcon = PX.PC.Art, Label = 20,
	Lines = 2, Tag = 19, TagH = 36, Coin = PX.PC.Glyph, BtnW = 140, BtnH = 52, BtnText = 24, Foot = 19, FootY = 310, FootH = 50,
	Spark = PX.PC.Glyph }
local PHONE = { W = 420, H = 226, Header = 50, Slot = 36, SlotIcon = PX.Phone.Glyph, TitleText = 22, Close = 44, CloseBlock = 36, Pad = 12,
	Sub = 0, Row1 = 56, Row1H = 62, Row2 = 124, Row2H = 46, Chip = 34, ChipIcon = PX.Phone.Glyph, ChipBig = 48, ChipIconBig = PX.Phone.Art,
	Label = 16, Lines = 1, Tag = 15, TagH = 24, Coin = PX.Phone.Glyph, BtnW = 96, BtnH = 44, BtnText = 20, Foot = 15, FootY = 174, FootH = 38,
	Spark = PX.Phone.Glyph }
local PORTRAIT = { W = 400, H = 274, Header = 50, Slot = 36, SlotIcon = PX.Phone.Glyph, TitleText = 22, Close = 44, CloseBlock = 36, Pad = 12,
	Sub = 0, Row1 = 56, Row1H = 80, Row2 = 142, Row2H = 62, Chip = 34, ChipIcon = PX.Phone.Glyph, ChipBig = 48, ChipIconBig = PX.Phone.Art,
	Label = 16, Lines = 2, Tag = 15, TagH = 24, Coin = PX.Phone.Glyph, BtnW = 96, BtnH = 44, BtnText = 20, Foot = 15, FootY = 208, FootH = 52,
	Spark = PX.Phone.Glyph }
local MODES = { PC = PC, Phone = PHONE, Portrait = PORTRAIT }
local TEXT = {
	Title = "SKY TROVE",
	Sub = "Help Nimbus grow and the Trove pays you!",
	Group = "Join the Nimbus Climb group",
	Soon = "Coming soon",
	Like = "Enjoying it? A thumbs up on our game page helps a lot!",
	Footer = "Community links are on our game page. Prizes go straight to you. Once per player.",
	Pending = "Your request is waiting for the group. Come back later!",
	NotJoined = "Not joined yet. Join from the game page, then come back in a new server.",
	Status = { Checked = "Rejoin to check", Unavailable = "Try again soon", Loading = "Loading..." },
	Button = { Open = "Join", Done = "Done", Preview = "Preview" }, -- (kit-b U9-4) sentence case, the kit's casing rule
}
-- (kit-b U9-4) each ask's chip: its pixel icon (Config.Icons: the people, the heart) on the block colour of its role
local ASK = {
	Group = { Icon = "Group", Face = SIGN.Sky, Lip = SIGN.SkyLip },
	Like = { Icon = "Like", Face = SIGN.Roof, Lip = SIGN.RoofLip },
}

local S = {
	Inited = false,
	Open = false,
	State = nil, -- the last TroveState
	Mode = nil, -- "PC" | "Phone" | "Portrait" (the built layout)
	Hint = nil,
	Joining = false,
	LidBase = setmetatable({}, { __mode = "k" }), -- [lid model] = the hinge CFrame at 0 degrees
	Pool = {}, -- the coin parts
	Anim = nil, -- the running claim animation (a Heartbeat connection)
	Rect = nil, -- the panel's box in gui-area px { x, y, w, h } (layout)
	TouchOff = false, -- true while this panel asked Roblox's touch controls away
	VitalsOff = false, -- true while this panel asked the vitals card aside
	Twinkle = nil, -- the sparkles' Heartbeat connection while open
	Lit = false, -- which sparkle is lit (false = A)
}
local U = {} -- Gui, Panel, Scale, M, the parts
TroveController._S = S

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function safe(label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[TroveController] " .. label .. " failed: " .. tostring(err))
	end
	return ok, err
end

local function controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

local function clientModule(name)
	local module = Client:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

local function localPlayer()
	return Players.LocalPlayer
end

local function inMatch()
	local p = localPlayer()
	return p ~= nil and p:GetAttribute(Config.Attr.InMatch) == true
end

local function groupAsk(state)
	local asks = type(state) == "table" and type(state.Asks) == "table" and state.Asks or {}
	for _, a in ipairs(asks) do
		if type(a) == "table" and a.Id == "Group" then
			return a
		end
	end
	return nil
end

local function groupStateOf(state)
	local a = groupAsk(state)
	return a and a.State or nil
end

local function commas(n)
	local out = tostring(math.floor(tonumber(n) or 0))
	while true do
		local k
		out, k = string.gsub(out, "^(-?%d+)(%d%d%d)", "%1,%2")
		if k == 0 then
			break
		end
	end
	return out
end

local function viewport()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

local function guiInset()
	local inset = NeonKit.Metrics.Inset
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

local function label(parent, name, text, role, size, props)
	local l = Theme.Label(text, role, { Size = size, Props = props })
	l.Name = name
	l.Parent = parent
	return l
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

-- a flat Frame (the frame, the body, a lip)
local function block(name, colour, parent, z)
	return Util.Create("Frame", { Name = name, BackgroundColor3 = colour, BorderSizePixel = 0, ZIndex = z or 1, Parent = parent })
end

-- a lip along the bottom of `parent`, px tall
local function lip(parent, colour, px)
	return Util.Create("Frame", {
		Name = "Lip", BackgroundColor3 = colour, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, px), ZIndex = parent.ZIndex, Parent = parent,
	})
end

-- a pixel icon whose cells sit at `z` (PixelIcon draws them at the default ZIndex)
local function icon(parent, name, px, colour, z)
	local i = PixelIcon.New(parent, name, px, colour)
	if i then
		i.ZIndex = z
		for _, f in ipairs(i:GetChildren()) do
			f.ZIndex = z
		end
	end
	return i
end

----------------------------------------------------------------------
-- the panel
----------------------------------------------------------------------
-- (kit-b U9-4) a gold reward tag in its wood edge with brown words (and, for the tokens, the token coin before them)
local function tag(parent, name, coin, M)
	local f = block(name, SIGN.Gold, parent, 6)
	CloudUI.SignBlock(f, "Selected", { EdgePx = 2, LipPx = 3 })
	if coin then
		U.Coin = icon(f, "token", M.Coin, SIGN.Text, 7) -- (look review 2: the layout's glyph size, 27 on PC)
		if U.Coin then
			U.Coin.Name = "Coin"
		end
	end
	label(f, "Text", "", "Heading", 18, {
		TextColor3 = SIGN.Text, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = false, ZIndex = 7,
	})
	return f
end

-- (kit-b U9-4) an ask: a stone block in its wood edge with its icon chip at the left
local function makeRow(id, M)
	local row = block("Row_" .. id, SIGN.Tile, U.Panel, 4)
	CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = SignKit.Sizes.BlockLip })
	local ask = ASK[id]
	local chip = block("Chip", ask.Face, row, 5)
	CloudUI.SignBlock(chip, { Face = ask.Face, Lip = ask.Lip, Edge = SIGN.Wood, Text = SIGN.Text }, { EdgePx = 2, LipPx = 3 })
	local glyph = icon(chip, NeonKit.IconName(ask.Icon) or Config.Icons[ask.Icon], M.ChipIcon, SIGN.Text, 6)
	if glyph then
		glyph.Name = "Glyph"
	end
	return row, chip
end

-- the reward's glint: Frame "Sparkles" over the Group row with two pixel sparkles (SparkleA / SparkleB, PixelIcon
-- "sparkle") that take turns (two frames, no tween, no glow)
local function makeSparkles(row, M)
	local box = Util.Create("Frame", { Name = "Sparkles", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		Active = false, Visible = false, ZIndex = 8, Parent = row })
	for i, name in ipairs({ "SparkleA", "SparkleB" }) do
		local s = icon(box, "sparkle", M.Spark, SIGN.GoldDeep, 8)
		if s then
			s.Name = name
			s.Visible = i == 1
		end
	end
	return box
end

local function build(mode)
	local M = MODES[mode] or PHONE
	if U.Panel then
		U.Panel:Destroy()
	end
	U.M = M
	U.Width = nil
	U.Height = nil
	S.Mode = mode
	S.Lit = false
	local F = K.FRAME
	-- the wood frame round the stone body with its lip
	local panel = block("TrovePanel", SIGN.Wood, U.Gui, 2)
	panel.Visible = S.Open
	panel.Active = true
	panel:SetAttribute("SignKit", "Frame")
	U.Panel = panel
	U.Scale = Util.Create("UIScale", { Name = "TroveScale", Scale = 1, Parent = panel })
	local stone = block("Stone", SIGN.Stone, panel, 2)
	stone:SetAttribute("SignKit", "Body")
	lip(stone, SIGN.StoneLip, SignKit.Sizes.Lip)
	place(stone, F, F, M.W - 2 * F, M.H - 2 * F)
	SignKit.FinishFrame(panel, { Body = stone }) -- (Pitch 2 F0) the frame's light, the window's shadow, the carved body
	-- (U9-4 look review) the header as the Stats / My Home side panels build theirs (SignKit.Header, Ribbon): the wood rim,
	-- the navy plate as the title's band with its piping the whole header wide (inside the rim: the dock rule below), the
	-- pixel chest on the gold icon square in its 2 px ink edge, SKY TROVE with its stair, the red close on the plate
	local head, plate = SignKit.Header(panel, {
		Title = TEXT.Title, TitleSize = M.TitleText, Height = M.Header, Rim = F, IconSlot = true, Ribbon = true,
		Reserve = M.Close + 18, Name = "Header", ZIndex = 5,
	})
	U.Header, U.Plate = head, plate
	U.Title = plate:FindFirstChild("Title")
	if U.Title then
		U.Title.Name = "TitleText"
		U.Title.TextTruncate = Enum.TextTruncate.AtEnd
	end
	U.Icon = plate:FindFirstChild("IconSlot")
	if U.Icon then
		U.Icon.Name = "TroveIcon"
		U.Icon.Size = UDim2.fromOffset(M.Slot, M.Slot)
		local edge = U.Icon:FindFirstChildOfClass("UIStroke")
		if edge then
			edge.Name = "SignEdge"
		end
		local chest = icon(U.Icon, Config.Icons.Trove or "chest", M.SlotIcon, SIGN.Text, 3)
		if chest then
			chest.Name = "Chest"
			local at = math.floor((M.Slot - M.SlotIcon) / 2) -- whole px inside the square
			chest.Position = UDim2.fromOffset(at, at)
		end
		if M.Slot ~= SignKit.Sizes.IconSlot and U.Title then
			-- (a phone's smaller square: the title keeps the kit's 12 px gap after it)
			local d = SignKit.Sizes.IconSlot - M.Slot
			U.Title.Position = U.Title.Position - UDim2.fromOffset(d, 0)
			U.Title.Size = U.Title.Size + UDim2.fromOffset(d, 0)
		end
	end
	-- (U9-4 look review 2) docked 12 px from the screen's edge (or across a phone), the band's tails would leave the screen
	-- (its right tail and notches ran past x 1920): the band stays the header's width inside the rim, no tails, the render
	-- gate's dock rule (the Index; the Arena / Dungeon docks on kitb-ui2)
	SignKit.HeaderOverhang(head, false)
	local blockPx = M.CloseBlock or M.Close
	U.Close = CloudUI.Button({ Name = "Close", Text = "", Style = "Red", Skin = "Sign", Size = UDim2.fromOffset(blockPx, blockPx), TextSize = 22,
		ZIndex = 3, Parent = head, Callback = function()
			TroveController.Close()
		end })
	-- slop audit 2026-11-12: a drawn X (the U+2715 glyph showed a missing-glyph box); kit B: square bars in brown ink
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = SIGN.Text })
	-- (merge kitb-look1 x U9-4) the pixel x at the screen's glyph size (one of the window's two pixel sizes), and on a phone
	-- the 36 px block keeps U9-4's 3 px edge and 5 px lip (the kit's 5 / 8 would hang out of the plate)
	NeonKit.CloseMarkPx(U.Close, (mode == "PC" and PX.PC or PX.Phone).Glyph)
	if M.CloseBlock then
		U.Close:SetAttribute("EdgePx", 3)
		U.Close:SetAttribute("LipPx", 5)
	end
	-- (U9-4 look review 2) a phone's 44 px touch box under the 36 px block (a tap on the ring round the block closes too)
	U.CloseTap = nil
	if M.CloseBlock then
		U.CloseTap = Util.Create("TextButton", {
			Name = "CloseTap", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Selectable = false,
			Active = true, ZIndex = 2, Parent = head,
		})
		U.CloseTap:SetAttribute("HitFor", "Close") -- (F0 review, major 7) the close's 44 px thumb target
		U.CloseTap.Activated:Connect(function()
			TroveController.Close()
		end)
	end
	-- the awning: one fixed-size piece over the top rim (never stretched with the panel: the sign rule); PC 360, the
	-- portrait sheet ROOF_PHONE_W where the sky over it is clear (layout), never the landscape phone panel
	U.Roof = SignKit.Roof(panel, { Width = mode == "PC" and K.ROOF_W or K.ROOF_PHONE_W, Y = SignKit.RoofSeat(), ZIndex = 7 }) -- (F0 review) seated on the frame
	U.Roof.Visible = mode == "PC"
	U.Subtitle = label(panel, "Subtitle", TEXT.Sub, "Body", math.max(15, M.Sub), {
		TextColor3 = SIGN.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 4, Visible = M.Sub > 0,
	})

	-- the Group row: its line, the reward tags (and their glint), Join or a status line
	local group = makeRow("Group", M)
	U.Group = group
	U.GroupLabel = label(group, "Label", TEXT.Group, "Body", M.Label, {
		TextColor3 = SIGN.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true, ZIndex = 6,
	})
	U.Chips = Util.Create("Frame", { Name = "Chips", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6, Parent = group })
	U.CashChip = tag(U.Chips, "CashChip", false, M)
	U.TokenChip = tag(U.Chips, "TokenChip", true, M)
	U.Sparkles = makeSparkles(group, M)
	U.Join = CloudUI.Button({ Name = "JoinButton", Text = TEXT.Button.Open, Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(M.BtnW, M.BtnH),
		TextSize = M.BtnText, ZIndex = 6, Parent = group, Callback = function()
			TroveController._Join()
		end })
	U.Status = label(group, "Status", "", "Body", M.Tag, {
		TextColor3 = SIGN.TextMuted, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true, ZIndex = 6, Visible = false,
	})

	-- the Like row (no button)
	local like = makeRow("Like", M)
	U.Like = like
	U.LikeLabel = label(like, "Label", TEXT.Like, "Body", M.Label, {
		TextColor3 = SIGN.Text, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
		TextWrapped = true, ZIndex = 6,
	})

	-- the footer and the hint that takes its place
	local footProps = {
		TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextWrapped = true, ZIndex = 4,
	}
	U.Footer = label(panel, "Footer", TEXT.Footer, "Body", M.Foot, footProps)
	U.Footer.TextColor3 = SIGN.TextMuted
	U.Hint = label(panel, "Hint", "", "Body", M.Foot, footProps)
	U.Hint.TextColor3 = SIGN.RedLip -- (kit-b U9-4) the notice in the kit's red ink
	U.Hint.Visible = false
end

-- the reward tags at (x, y) in the Group row, sized to their words; the sparkles round them
local function placeTags()
	local M = U.M
	if not (M and U.Chips) then
		return
	end
	local pad, gap = 8, 8
	local x = 0
	for _, chip in ipairs({ U.CashChip, U.TokenChip }) do
		local text = chip:FindFirstChild("Text")
		local coin = chip:FindFirstChild("Coin")
		text.TextSize = M.Tag
		-- (the words centred in a box with a little spare: a measure that runs short on the face's wide digits never
		-- spills them over the tag's edge)
		local tw = math.ceil(Theme.MeasureLabel(text).X * 1.15) + 2
		local cx = pad
		if coin then
			place(coin, pad, math.floor((M.TagH - 3 - M.Coin) / 2), M.Coin, M.Coin)
			cx = pad + M.Coin + 3
		end
		local w = cx + tw + pad - 2
		place(text, cx, 0, tw, M.TagH - 3)
		place(chip, x, 0, w, M.TagH)
		x = x + w + gap
	end
	-- the two sparkles on the stone just past the token tag (one up by its top corner, one lower and further out), where
	-- the gold reads; never over the words
	local right = U.Chips.Position.X.Offset + x - gap
	local top = U.Chips.Position.Y.Offset
	local px = M.Spark
	local a, b = U.Sparkles:FindFirstChild("SparkleA"), U.Sparkles:FindFirstChild("SparkleB")
	if a then
		a.Position = UDim2.fromOffset(math.floor(right + 2), math.floor(top - px * 0.6))
	end
	if b then
		b.Position = UDim2.fromOffset(math.floor(right + px * 0.9), math.floor(top + M.TagH - px * 0.9))
	end
end

-- the largest size from `size` down to 15 at which `l`'s text fits `w` px on one line
local function fitLine(l, size, w)
	for s = size, 15, -1 do
		l.TextSize = s
		if Theme.MeasureLabel(l).X <= w then
			return
		end
	end
end

-- every part's place for a panel W design px wide (the mode's metrics)
local function arrange(W)
	local M = U.M
	local F = K.FRAME
	local H = M.H
	place(U.Panel:FindFirstChild("Stone"), F, F, W - 2 * F, H - 2 * F)
	-- the header (SignKit.Header lays its plate out; the close sits on the plate, 10 px in from the frame's right edge as
	-- the Gifts window's, centred on the plate under the rim)
	place(U.Header, 0, 0, W, M.Header)
	if M.CloseBlock then
		-- (U9-4 look review 2) a phone: the 36 px block centred on the plate (4 px of plate over and under it, the icon
		-- square's height), its stroke 4 px inside the plate's right end; the 44 px touch box centred on it
		local b = M.CloseBlock
		local x, y = W - F - K.CLOSE_INSET - b, F + math.floor((M.Header - F - b) / 2)
		place(U.Close, x, y, b, b)
		local d = math.floor((M.Close - b) / 2)
		if U.CloseTap then
			place(U.CloseTap, x - d, y - d, M.Close, M.Close)
		end
	else
		place(U.Close, W - 10 - M.Close, F + math.floor((M.Header - F - M.Close) / 2), M.Close, M.Close)
	end
	if M.Sub > 0 then
		place(U.Subtitle, M.Pad + 2, M.SubY, W - 2 * M.Pad - 4, M.SubH)
	end
	-- the rows (row px; the lip under the face)
	local rowW = W - 2 * M.Pad
	local lipPx = SignKit.Sizes.BlockLip
	local inner = M.Pad == PC.Pad and 12 or 8
	-- (U9-4 look review 2) a phone's row icon at the art size on the bigger chip where both rows have room for it (4 px
	-- of face over and under the chip), else the glyph size on the small chip: both rows alike
	local chipPx, iconPx = M.Chip, M.ChipIcon
	if M.ChipBig and math.min(M.Row1H, M.Row2H) - lipPx >= M.ChipBig + 8 then
		chipPx, iconPx = M.ChipBig, M.ChipIconBig
	end
	U.ChipPx = chipPx
	local textX = inner + chipPx + (M.Pad == PC.Pad and 14 or 10)
	for _, r in ipairs({ { U.Group, M.Row1, M.Row1H, "Group" }, { U.Like, M.Row2, M.Row2H, "Like" } }) do
		local row, y, h = r[1], r[2], r[3]
		place(row, M.Pad, y, rowW, h)
		local chip = row:FindFirstChild("Chip")
		place(chip, inner, math.floor((h - lipPx - chipPx) / 2), chipPx, chipPx)
		local glyph = chip:FindFirstChild("Glyph")
		if glyph and glyph.Size.X.Offset ~= iconPx then
			glyph:Destroy()
			glyph = icon(chip, NeonKit.IconName(ASK[r[4]].Icon) or Config.Icons[ASK[r[4]].Icon], iconPx, SIGN.Text, 6)
			if glyph then
				glyph.Name = "Glyph"
			end
		end
		if glyph then
			place(glyph, math.floor((chipPx - iconPx) / 2), math.floor((chipPx - 3 - iconPx) / 2), iconPx, iconPx)
		end
	end
	local face1 = M.Row1H - lipPx
	local btnX = rowW - inner - M.BtnW
	place(U.Join, btnX, math.floor((face1 - M.BtnH) / 2), M.BtnW, M.BtnH)
	U.Join.TextSize = M.BtnText
	place(U.Status, btnX, math.floor((face1 - M.BtnH) / 2), M.BtnW, M.BtnH)
	U.Status.TextSize = M.Tag
	local labelW = btnX - (M.Pad == PC.Pad and 12 or 10) - textX
	local lineH = math.ceil(M.Label * 1.15)
	local labelH = M.Lines * lineH + 4
	local top = math.floor((face1 - labelH - 4 - M.TagH) / 2)
	place(U.GroupLabel, textX, top, labelW, labelH)
	U.GroupLabel.TextSize = M.Label
	if M.Lines == 1 then
		fitLine(U.GroupLabel, M.Label, labelW)
	end
	place(U.Chips, textX, top + labelH + 4, labelW, M.TagH)
	local face2 = M.Row2H - lipPx
	place(U.LikeLabel, textX, 2, rowW - textX - inner, face2 - 4)
	U.LikeLabel.TextSize = M.Label == PC.Label and M.Label or 15
	-- the footer and the hint
	for _, l in ipairs({ U.Footer, U.Hint }) do
		place(l, M.Pad, M.FootY, W - 2 * M.Pad, M.FootH)
		l.TextSize = M.Foot
	end
	placeTags()
end

-- the sparkles' turn: the lit one swaps every K.TWINKLE s while the panel is open and the reward waits
local function stopTwinkle()
	if S.Twinkle then
		S.Twinkle:Disconnect()
		S.Twinkle = nil
	end
end

local function startTwinkle()
	if S.Twinkle then
		return
	end
	local t = 0
	S.Twinkle = RunService.Heartbeat:Connect(function(dt)
		t = t + (tonumber(dt) or 0)
		if t < K.TWINKLE then
			return
		end
		t = t - K.TWINKLE
		S.Lit = not S.Lit
		local box = U.Sparkles
		local a, b = box and box:FindFirstChild("SparkleA"), box and box:FindFirstChild("SparkleB")
		if a and b then
			a.Visible, b.Visible = not S.Lit, S.Lit
		end
	end)
end

local function render()
	if not U.Panel then
		return
	end
	local state = S.State
	local a = groupAsk(state)
	local gs = a and a.State or "Loading"
	local reward = a and type(a.Reward) == "table" and a.Reward or {}
	U.GroupLabel.Text = (gs == "Soon") and TEXT.Soon or TEXT.Group
	local cashText = U.CashChip:FindFirstChild("Text")
	local tokenText = U.TokenChip:FindFirstChild("Text")
	if cashText then
		cashText.Text = "$" .. Theme.Short(reward.Cash or 2000) -- (Pitch 2 F0 A: one short-number style, as the Gifts' "$1K")
	end
	if tokenText then
		tokenText.Text = commas(reward.Tokens or 200) -- (kit-b U9-4, the U7a rule) the token coin before the amount
	end
	placeTags()
	local buttonText = TEXT.Button[gs]
	U.Join.Visible = buttonText ~= nil
	if buttonText then
		U.Join.Text = buttonText
		U.Join:SetAttribute("Disabled", gs ~= "Open")
	end
	local status = TEXT.Status[gs]
	U.Status.Visible = buttonText == nil and status ~= nil
	U.Status.Text = status or ""
	if gs ~= "Open" and gs ~= "Checked" then
		S.Hint = nil
	end
	U.Hint.Text = S.Hint or ""
	U.Hint.Visible = S.Hint ~= nil
	U.Footer.Visible = S.Hint == nil
	-- the glint while the reward waits for the player
	local glint = gs == "Open"
	U.Sparkles.Visible = glint
	if glint and S.Open then
		startTwinkle()
	else
		stopTwinkle()
	end
end

-- Roblox's stick zone and jump button in the gui's area (HudController's robloxTouchRects), each { x0, y0, x1, y1 }
local function thumbZones()
	local vp = viewport()
	local area = U.Gui and U.Gui.AbsoluteSize
	if not area or area.X < 2 or area.Y < 2 then
		area = Vector2.new(vp.X, vp.Y - guiInset())
	end
	local small = math.min(vp.X, vp.Y) <= K.SMALL_PHONE
	local j = small and K.JUMP_SMALL or K.JUMP_LARGE
	local jumpBottom = small and 20 or j * 0.75
	local stickW = small and K.STICK_W_SMALL or K.STICK_W_LARGE
	local stickH = small and K.STICK_H_SMALL or K.STICK_H_LARGE
	if small and vp.Y > vp.X then
		stickH = K.STICK_H_PORTRAIT
	end
	return {
		{ 0, area.Y - stickH, stickW, area.Y },
		{ area.X - (1.5 * j + 10), area.Y - jumpBottom - j, area.X - (0.5 * j + 10), area.Y - jumpBottom },
	}
end

-- (U9-4 review) the landscape phone panel's height: PHONE.H, unless on a touch screen (where the game's DASH button
-- shows) that box would end on DASH; then as tall as reaches THUMB_GAP px over Roblox's jump button, which lands in the
-- DASH_GAP px between the two, so DASH and its stroke lie whole under the panel and the controls stay. A screen short
-- enough that PHONE.H already passes the jump button keeps PHONE.H (DASH lies whole under it; the controls go)
local function phoneHeight()
	if not UserInputService.TouchEnabled then
		return PHONE.H
	end
	local vp = viewport()
	local jumpTop = thumbZones()[2][2]
	local dash = math.min(vp.X, vp.Y) <= K.SMALL_PHONE and K.DASH_SMALL or K.DASH_LARGE
	if K.TOP_GAP + PHONE.H <= jumpTop - K.DASH_GAP - dash - K.DASH_STROKE then
		return PHONE.H -- DASH lies whole below the panel
	end
	return math.max(PHONE.H, math.floor(jumpTop - K.THUMB_GAP - K.TOP_GAP))
end

-- the phone layout's metrics for a panel h design px tall (h >= PHONE.H): a quarter of the spare height to each ask's
-- block, the rest in three even steps to the gaps under the header and each ask; the footer takes what is left
local function stretched(h)
	local spare = math.max(0, math.floor(h - PHONE.H))
	if spare == 0 then
		return PHONE
	end
	local M = {}
	for k, v in pairs(PHONE) do
		M[k] = v
	end
	local grow = math.floor(spare / 4)
	local step = math.floor((spare - 2 * grow) / 3)
	M.H = PHONE.H + spare
	M.Row1 = PHONE.Row1 + step
	M.Row1H = PHONE.Row1H + grow
	M.Row2 = PHONE.Row2 + 2 * step + grow
	M.Row2H = PHONE.Row2H + grow
	M.FootY = PHONE.FootY + 3 * step + 2 * grow
	M.FootH = PHONE.FootH + spare - 3 * step - 2 * grow
	return M
end

-- while open on a touch-only screen Roblox's touch controls go if the panel comes within THUMB_GAP px of them, and the
-- HUD's vitals card steps aside while the panel lies over it by more than a shared edge; both come back on Close
local function cover()
	local r = S.Open and S.Rect or nil
	local touchOff = false
	if r and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local g = K.THUMB_GAP
		for _, z in ipairs(thumbZones()) do
			if r.x < z[3] + g and r.x + r.w > z[1] - g and r.y < z[4] + g and r.y + r.h > z[2] - g then
				touchOff = true
			end
		end
	end
	if touchOff ~= S.TouchOff then
		S.TouchOff = touchOff
		local menu = controller("MenuController")
		if menu and type(menu.SetTouchHidden) == "function" then
			safe("touch", menu.SetTouchHidden, "Trove", touchOff)
		end
	end
	local vitalsOff = false
	local hud = r and controller("HudController") or nil
	if hud and type(hud.GetLayout) == "function" then
		local ok, layout = pcall(hud.GetLayout)
		local slot = ok and type(layout) == "table" and layout.VitalsSlot
		if slot then
			local w = math.min(r.x + r.w, slot.X + slot.W) - math.max(r.x, slot.X)
			local h = math.min(r.y + r.h, slot.Y + slot.H) - math.max(r.y, slot.Y)
			vitalsOff = w > 4 and h > 4
		end
	end
	if vitalsOff ~= S.VitalsOff then
		S.VitalsOff = vitalsOff
		hud = hud or controller("HudController")
		if hud and type(hud.SetVitalsHidden) == "function" then
			safe("vitals", hud.SetVitalsHidden, "Trove", vitalsOff)
		end
	end
end

local layout -- (forward: the HUD watcher re-lays the panel out)

-- (U9-4 look review) the HUD's top-right block (the currency strips and the gift's square under them) in gui-area px:
-- its bottom (NimbusHud TopRightBottom, 0 = none) and the strips' own bottom (over the gift's square, which hides while
-- this panel is open). A change re-lays an open panel out (watched once, when the HUD is first found)
local function hudTop()
	local p = localPlayer()
	local pg = p and p:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud then
		return 0, 0
	end
	if not S.HudWatch then
		S.HudWatch = true
		hud:GetAttributeChangedSignal("TopRightBottom"):Connect(function()
			if S.Open then
				safe("layout", layout)
			end
		end)
	end
	local bottom = tonumber(hud:GetAttribute("TopRightBottom")) or 0
	local gift = tonumber(hud:GetAttribute("GiftSize")) or 0
	local strips = gift > 0 and (tonumber(hud:GetAttribute("GiftTop")) or bottom) or bottom
	return bottom, strips
end

-- the panel's box: the PC layout when the 1080p design fits SideRect and, docked under the HUD's strips, the screen, else
-- the phone layout at scale 1 (the bottom sheet on a portrait screen)
function layout()
	if not U.Gui then
		return
	end
	local vp = viewport()
	local W, H = vp.X, vp.Y
	local f = Theme.ScreenFactor(H)
	local rect = NeonKit.SideRect(K.PREF_W, K.PREF_H, K.MIN_W, K.MIN_H)
	local sheet = rect.mode == "Sheet"
	local inset = U.Gui.IgnoreGuiInset and 0 or guiInset()
	-- (U9-4 look review, the blocker) the PC panel docks UNDER the HUD's strips (and the gift's square: TopRightBottom),
	-- as the Stats window does: the old top dock, pushed 10 px down for the awning, left a sliver of the Cash strip over
	-- the frame's top and the strips' edges along its right. The $2,000 then lands in balances the player can see. Where
	-- that dock would run off the bottom (a short desktop window) the phone layout takes over (it covers the strips whole)
	local hudBottom, stripsBottom = hudTop()
	local dockY = hudBottom + K.TOP_GAP * f + K.ROOF_OVER * rect.scale
	local docks = dockY + K.PREF_H * rect.scale <= (H - inset) - K.MARGIN * f
	local phone = sheet or rect.designW < K.PREF_W - 0.5 or rect.designH < K.PREF_H - 0.5 or not docks
	local mode = sheet and "Portrait" or (phone and "Phone" or "PC")
	if S.Mode ~= mode or not U.Panel then
		build(mode)
	end
	local pw, ph = U.M.W, U.M.H
	if sheet then
		pw = math.min(PORTRAIT.W, W - 2 * K.MARGIN)
	elseif phone then
		ph = phoneHeight()
	end
	if U.Width ~= pw or U.Height ~= ph then
		U.Width, U.Height = pw, ph
		if mode == "Phone" then
			U.M = stretched(ph)
		end
		U.Panel.Size = UDim2.fromOffset(pw, ph)
		arrange(pw)
	end
	local M = U.M
	render()
	-- (the gui starts below Roblox's top bar: y is in the gui's area, so "inset + 8" on screen is 8 here)
	local x, y, scale
	if phone then
		scale = 1
		x = math.max(K.MARGIN, W - K.MARGIN - pw)
		if sheet then
			y = H - inset - K.MARGIN - M.H
		else
			y = K.TOP_GAP
		end
	else
		scale = rect.scale
		x = W - K.MARGIN * f - PC.W * scale
		y = dockY -- (the awning's top 8 px x factor under the HUD's block)
	end
	-- the awning: PC always; the portrait sheet where ROOF_CLEAR px of clear screen lie over its top (the strips' bottom,
	-- or the top of the gui's area)
	U.Roof.Visible = mode == "PC" or (sheet and y - K.ROOF_CLEAR >= stripsBottom)
	U.Scale.Scale = scale
	U.Panel.AnchorPoint = Vector2.new(0, 0)
	U.Panel.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	U.Panel:SetAttribute("TroveMode", mode)
	S.Rect = { x = math.floor(x + 0.5), y = math.floor(y + 0.5), w = pw * scale, h = M.H * scale }
	cover()
end

----------------------------------------------------------------------
-- Join
----------------------------------------------------------------------
local function setHint(text)
	S.Hint = text
	render()
end

function TroveController._Join()
	local state = S.State
	if S.Joining or groupStateOf(state) ~= "Open" then
		return
	end
	local gid = tonumber(state.GroupId) or 0
	if gid <= 0 then
		return
	end
	S.Joining = true
	task.spawn(function()
		local ok, result = pcall(GroupService.PromptJoinAsync, GroupService, gid)
		S.Joining = false
		local status = Enum.GroupMembershipStatus
		if ok and (result == status.Joined or result == status.AlreadyMember) then
			setHint(nil)
			local okR, remote = pcall(Remotes.Get, "TroveRequest")
			if okR and remote then
				remote:FireServer("Joined")
			end
		elseif ok and result == status.JoinRequestPending then
			setHint(TEXT.Pending)
		else
			setHint(TEXT.NotJoined)
		end
	end)
end

----------------------------------------------------------------------
-- the claim: the lid and the coins
----------------------------------------------------------------------
local function backOut(t)
	local c1 = 1.70158
	local c3 = c1 + 1
	local u = t - 1
	return 1 + c3 * u * u * u + c1 * u * u
end

local function lidModel()
	for _, m in ipairs(CollectionService:GetTagged(Config.Tags.TroveLid)) do
		if m:IsA("Model") and m.PrimaryPart and m:IsDescendantOf(workspace) then
			return m
		end
	end
	return nil
end

local function coinFolder()
	local f = workspace:FindFirstChild("TroveCoins")
	if not f then
		f = Instance.new("Folder")
		f.Name = "TroveCoins"
		f.Parent = workspace
	end
	return f
end

local function coin(i)
	local c = S.Pool[i]
	if not c then
		c = Instance.new("Part")
		c.Name = "TroveCoin"
		c.Size = Vector3.new(0.2, 0.8, 0.8) -- a square voxel coin (the world has no round primitives)
		c.Color = Theme.Neon and Theme.Neon.Gold or Color3.fromRGB(255, 204, 64)
		c.Material = Enum.Material.SmoothPlastic
		c.Anchored = true
		c.CanCollide = false
		c.CanQuery = false
		c.CanTouch = false
		c.CastShadow = false
		S.Pool[i] = c
	end
	return c
end

local function stopAnim()
	if S.Anim then
		S.Anim:Disconnect()
		S.Anim = nil
	end
	for _, c in ipairs(S.Pool) do
		c.Parent = nil
	end
end

local function playClaim()
	stopAnim()
	local lid = lidModel()
	local base
	if lid then
		base = S.LidBase[lid]
		if not base then
			base = lid.PrimaryPart.CFrame * CFrame.Angles(-math.rad(K.REST_DEG), 0, 0)
			S.LidBase[lid] = base
		end
	end
	local high = true
	local GQ = clientModule("GraphicsQuality")
	if GQ and type(GQ.Effective) == "function" then
		local ok, eff = pcall(GQ.Effective)
		high = not (ok and eff == "Low")
	end
	local flights = {}
	if high then
		local from = (lid and lid.PrimaryPart.Position or (base and base.Position)) or nil
		local char = localPlayer() and localPlayer().Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if from and root then
			local folder = coinFolder()
			local rng = Random.new()
			for i = 1, K.COINS do
				local c = coin(i)
				c.CFrame = CFrame.new(from)
				c.Parent = folder
				flights[i] = {
					Part = c,
					Delay = (i - 1) / (K.COINS - 1) * (K.COIN_TIME - K.COIN_FLIGHT),
					Side = Vector3.new(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3)),
					Lift = rng:NextNumber(3.5, 6),
					Spin = rng:NextNumber(6, 12),
				}
			end
			flights.From = from
			flights.Root = root
		end
	end
	local SoundFx = clientModule("SoundFx")
	if SoundFx and type(SoundFx.Play) == "function" then
		local id = type(SoundFx.Id) == "function" and SoundFx.Id("Sfx", "TroveOpen") or nil
		pcall(SoundFx.Play, id and "TroveOpen" or "Reward")
	end
	local t = 0
	S.Anim = RunService.Heartbeat:Connect(function(dt)
		t = t + (tonumber(dt) or 0)
		if lid and base and lid.Parent then
			local u = math.min(1, t / K.LID_TIME)
			local deg = K.REST_DEG + (K.OPEN_DEG - K.REST_DEG) * backOut(u)
			pcall(function()
				lid:PivotTo(base * CFrame.Angles(math.rad(deg), 0, 0))
			end)
		end
		local busy = false
		local target = flights.Root and flights.Root.Parent and flights.Root.Position or nil
		for i = 1, #flights do
			local fl = flights[i]
			if fl.Part.Parent then
				local u = (t - fl.Delay) / K.COIN_FLIGHT
				if u >= 1 or not target then
					fl.Part.Parent = nil
				else
					busy = true
					if u > 0 then
						local mid = math.sin(math.pi * u)
						local pos = flights.From:Lerp(target, u) + fl.Side * mid + Vector3.new(0, fl.Lift * mid, 0)
						fl.Part.CFrame = CFrame.new(pos) * CFrame.Angles(0, fl.Spin * t, math.rad(90))
					end
				end
			end
		end
		if not busy and t >= K.LID_TIME then
			stopAnim()
		end
	end)
end

----------------------------------------------------------------------
-- public
----------------------------------------------------------------------
function TroveController.IsOpen()
	return S.Open == true
end

function TroveController.Close()
	S.Open = false
	S.Hint = nil
	stopTwinkle()
	if U.Panel then
		U.Panel.Visible = false
	end
	cover()
end

function TroveController.Open(state)
	if not S.Inited then
		TroveController.Init()
	end
	if inMatch() then
		return false
	end
	if type(state) == "table" then
		S.State = state
	end
	local was = S.Open == true
	S.Open = true
	layout()
	render()
	U.Panel.Visible = true
	if not was then
		SignKit.Rise(U.Panel) -- (Pitch 2 F0, look review of finish pass A) the kit's open: it rises 12 px in 3 hard steps
	end
	local menu = controller("MenuController")
	if menu and type(menu.WindowOpened) == "table" and type(menu.WindowOpened.Fire) == "function" then
		safe("WindowOpened", function()
			menu.WindowOpened:Fire("Trove")
		end)
	end
	return true
end

local function onState(state)
	if type(state) ~= "table" then
		return
	end
	local before = groupStateOf(S.State)
	S.State = state
	local now = groupStateOf(state)
	if now ~= "Open" and now ~= "Checked" then
		S.Hint = nil
	end
	render()
	if S.Open and before ~= nil and before ~= "Done" and now == "Done" then
		safe("claim", playClaim)
	end
end

local function connectOthers()
	local function hook(name, signalName, filter)
		local mod = controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(id)
				if filter and id == "Trove" then
					return
				end
				if S.Open then
					TroveController.Close()
				end
			end)
		end
	end
	hook("MenuController", "WindowOpened", true)
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
	hook("CareController", "Opened")
	hook("ArenaController", "Opened")
	hook("DungeonController", "Opened")
	hook("ObbyController", "Opened")
end

function TroveController.Init()
	if S.Inited then
		return
	end
	S.Inited = true
	U.Gui = CloudUI.NewScreenGui("NimbusTrove", K.DISPLAY_ORDER)
	layout()
	local function bindCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				safe("layout", layout)
			end)
		end
	end
	bindCamera()
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		bindCamera()
		safe("layout", layout)
	end)
	local p = localPlayer()
	if p then
		p:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if inMatch() then
				TroveController.Close()
			end
		end)
	end
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and S.Open then
			TroveController.Close()
		end
	end)
	task.spawn(function()
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId)
				if type(panelId) == "string" and panelId:lower() == "trove" then
					safe("open", TroveController.Open)
				end
			end)
		end
	end)
	task.spawn(function()
		local okState, stateRemote = pcall(Remotes.Get, "TroveState")
		if okState and stateRemote then
			stateRemote.OnClientEvent:Connect(function(state)
				safe("state", onState, state)
			end)
		end
	end)
	task.defer(function()
		safe("connect", connectOthers)
	end)
end

return TroveController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1173">
            <Properties>
              <string name="Name">TutorialController</string>
              <string name="Source"><![CDATA[-- TutorialController (client): Nimbus the Cloudy Dragon guides a new player (ARCHITECTURE_V3.md section 4).
--
--   TutorialController.Init()
--   TutorialController.GetState() -> the last TutorialState payload (nil until one arrived)
--
-- What it shows (all client-side, nothing system-announced in the screen centre):
--   * Side panel (ScreenGui "NimbusTutorial", display order 12): a compact cloud card on the LEFT, below the HUD's
--     top-left panel area and right of the menu column (both MEASURED: NimbusHud attribute TopLeftBottom /
--     BottomLeftTop and NimbusMenu.MenuColumn / MenuButton_*). It holds a round portrait of Nimbus (PetBuilder
--     Cloudy Dragon in a ViewportFrame, gently flapping, livelier while talking), the step title, "Step 3/9",
--     progress pips, the typewriter text, a hint line with the live distance, a Next button (CompleteOn = "Next",
--     or AlsoNext) and a small "Skip tutorial" link that asks to confirm. Tapping the portrait folds the card into a
--     bubble (the portrait keeps flapping in it, at half the frame rate; Pitch 2 item 03_tutorial_dock B: the "bubble"
--     is the quest strip, QuestStrip: the portrait chip, the step's title, "3/21", the steps in chapter blocks and a
--     "+" block that opens the card; PC / a landscape phone top-left under the top bar, a portrait phone on the HUD
--     stack over the vitals card; too narrow or meeting the arena's side stack: the portrait chip alone);
--     screens too small for the card get the bubble automatically. The HUD's bottom-left block (HP / stamina card)
--     is a hard limit: a bubble that has no room under the top-left panel (party / match panel on a landscape
--     phone) sits beside that panel instead. A card the player opens in the plain lobby may cover the idle vitals
--     card (and, as a last resort, the idle hotbar) but never the thumbstick, the touch buttons or the screen edge;
--     with a party panel up (a match is about to start) the vitals card, the currency pills and the hotbar are hard
--     limits wherever the card goes (beside the panel too; no room: the bubble); in a match it never covers the
--     vitals (the bubble), and a card opened in the lobby is folded back when the match starts. During
--     a battle on a phone (BattleController's compact team cards at the top / left edge) the panel hides until the
--     battle ends. While a menu window / the Pet Index / the roulette is open the card folds into the bubble
--     and the menu pointer hides. Designed in 1080p pixels under a UIScale of
--     Theme.ScreenFactor() (readability rule: body 20, captions 18, buttons 22, title 30 -> >= 14.4 px on phones).
--     Step completion: a voxel confetti burst from the portrait; the end of the tutorial: a bigger one.
--   * Guide arrow for world targets (Spot / Shop / Roulette / Portal, found by name under workspace.NimbusLobby,
--     the server's Target.Position as a fallback): a golden voxel arrow sculpted with shared/Voxel.lua that hops in two
--     hard steps (Pitch 2 item 13 A: no spin, no tween, no light), a stone name + distance tag beside its shaft and a
--     trail of flat gold dot blocks on the ground from just ahead of the feet toward the target (it was a Beam of a
--     sparkle strip and a ring of Neon sparkles) (workspace.ClientFx.TutorialGuide).
--   * TutorialController.Guide (Pitch 2 item 13 A): the travel guide the Shop's "Show the way" starts (see the section
--     "Travel guide" below): the same world guide to the Storm Altar gate, a "Guiding to Storm Altar" chip with its X.
--   * Menu targets: a pulsing gold ring around MenuButton_<Id> and a small pixel-art arrow pointing at it ("Home" rings
--     the Home tile, MenuButton_Spot)
--     (ScreenGui "NimbusTutorialPointer", display order 21, above the menu), on the first side of the button
--     (right, above, below, left) that is clear of the other tiles and of the tutorial card; none free (the
--     middle of the phone's 2 x 3 grid): the ring alone. The card / bubble keeps the arrow's spot free.
--   * Hidden in a match except the "finish" step text; the guides only show in the lobby.
-- Events sent through TutorialEvent (the server validates them against the current step): "Next", "Skip",
-- "ShopOpened" / "IndexOpened" / "PetsOpened" (MenuController.WindowOpened / IndexController.WindowOpened, the
-- OpenPanel remote and clicks on the matching menu button) and "Sync" (asks for the state again).
-- Per-frame work runs in ONE RenderStepped connection, only while something is shown.
-- Phase 5: nothing shows before the player pressed PLAY on the main menu (UiGate.WaitForPlay(600) before the first panel);
-- the portal step's world target is Portal_Obby (the ONE Obby portal of the Gate Court).
-- (kit B U9-9) The card and the pointer wear the Signboard kit, the layout and behaviour unchanged: the card is the wood
-- frame round a stone body with its lip (no shadow, puffs, gloss or gradient), the portrait a square sky well in a wood
-- frame (a little pixel cloud in its corner, the ground lip over Nimbus' feet), the name a plain Section title in brown,
-- the counter a stone tag, the fold a stone block with the pixel minus, the pips kit B blocks (a done step grass, the
-- current one gold, the rest the sunk well, each in a wood edge), the text well a pale tile in a wood edge, the hint line
-- in navy ink, Next the one green plank (gold on the last step), the skip confirm a red and a stone plank (Pitch 2 03 B:
-- the folded bubble's "!" badge and "Tap me!" plank gave way to the quest strip). Confetti in the kit's gold and pink, flat squares that flip (no rotation) on
-- whole pixels. The menu pointer's ring is a square gold frame in wood lines that breathes in whole pixels (no glow, no
-- fade); the pixel arrow is gold with a brown outline, its scale snapped so each 4 px cell is twice the screen's icon pixel. Icons and
-- edges under the card's scale stay on whole screen px (client/UI/PixelCrisp). The world guide sign is the world-text
-- wave's.
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))

local Client = script.Parent.Parent
local LocalPlayer = Players.LocalPlayer

local TutorialController = {}
-- (look:fix6b2 N3) Metrics.MEASURE(text, size, role) -> Vector2: a one-line text's size (design px) when a hook is set, else
-- Theme.Measure (TextService). tools/dump_gui.lua's tutorial scenes hand it the renderer's font metrics: the mock's
-- TextService answers a flat 0.5 em a letter, so the titles' fit (fitTextSize) kept 'The Champion Ring' (FredokaOne draws it
-- 0.545 em a letter) at its full size and the gate's render cut it to 'The Champion Ri...'; Roblox measures the face
TutorialController.Metrics = { MEASURE = nil }

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
-- (U9-9 look 2) the card's lengths on the 0.8 grid (multiples of 5: whole px at 0.8 and 1.0; PixelCrisp snaps the rest,
-- at 0.7 or a fitted scale, on all four sides)
local K = {
	PANEL_W = 440,
	PANEL_MIN_W = 260,
	PAD = 15,
	PORTRAIT = 95,
	-- the portrait pops above the card, (U9-9 look 2) its top level with the name plank's gold edge (TAB_Y): the guide's
	-- name rides the card's top edge on a navy plank, as an NPC's does
	PORTRAIT_Y = -30,
	TAB_Y = -27, -- the name plank's top (its 3 px gold edge reaches PORTRAIT_Y) ...
	TAB_H = 35, -- ... and height: it ends 8 px into the card, clear above the counter tag and the fold (TAG_Y)
	TAB_INSET = 22, -- the name starts this far in from each end of its plank (12 px clear of a brass rivet; the NPC's)
	TAB_TEXT = 24, -- the name's largest size on the plank
	-- (2026-11-28 playtest C42: "NIMB..." on a 667x375 card, the engine drawing the name wider than TextService measured it
	-- at its floor) the name's box reaches this far into each inset past its plank's fit, 4 px clear of the rivets
	NAME_SLACK = 8,
	POP_EDGE = 6, -- at the screen's top edge the portrait and the plank may ride up to this far from the top (layout)
	TAG_Y = 16, -- the counter tag and the fold block (30 high), under the name plank's row
	TAG_H = 30,
	COUNTER_W = 105,
	FOLD_W = 35,
	HEADER_H = 95, -- card height above the text well
	WELL_PAD = 12,
	HINT_H = 26,
	FOOTER_H = 48,
	NAME_SIZE = 30,
	TITLE_SIZE = 22,
	-- (kit-b backlog items 10 / 16) a step title that does not fit one line at TITLE_FLOOR (its 14 screen px floor on the
	-- smallest card, 0.7) takes two lines at that size, the header TITLE_LINE taller (it was cut at 14.4 px: 'Pick Your Te...')
	TITLE_FLOOR = 20,
	TITLE_LINE = 24,
	BODY_SIZE = 20,
	CAPTION_SIZE = 18,
	BUTTON_SIZE = 22,
	NEXT_W = 150,
	BUTTON_H = 45,
	-- (U9-9 look) the step progress, one SignKit block row in whole SCREEN px (layoutProgress): its blocks PROG_H tall,
	-- PROG_GAP apart, a block per step while each gets PROG_MIN px (at most PROG_MAX), else a block per chapter of
	-- PROG_CHAPTER steps; the kit's 2 px wood edge and a PROG_LIP lip
	PROG_H = 12,
	PROG_GAP = 2,
	PROG_MIN = 10,
	PROG_MAX = 14,
	PROG_CHAPTER = 3,
	PROG_BLOCKS = 8, -- (kit-b gate U9 r4) the most single-step blocks; more steps show as chapters
	PROG_LIP = 2,
	NAME_MIN = 20, -- narrow cards shrink the name (and the step title down to CAPTION_SIZE) before truncating
	OUTLINE_ROOM = 6, -- the labels' glyph outline + stroke draw this much wider than TextService measures
	SKIP_W = 132,
	SKIP_SHORT_W = 56,
	CONFIRM_W = 92,
	CONFIRM_SHORT_W = 76,
	CONFIRM_TIGHT_W = 64,
	QUESTION_MIN = 90, -- the confirm question wraps to two lines down to this width, then shortens to "Skip?"
	QUESTION_SHORT_MIN = 60, -- "Skip?" needs this much on one line, else the confirm buttons narrow again
	EDGE = 12,
	TOUCH_EDGE = 20,
	GAP = 10,
	-- (kit-b backlog items 6 / 7 / 8) a window's hard shadow (Theme.Finish.Window), design px past its box to the right and
	-- down: the card's own, and the HUD's top-left panel's. GAP is kept off the ink, past it (box to box it left 0 - 2.4 px)
	SHADOW = 8,
	MIDDLE = 0.15, -- the screen middle the panel keeps out of: |dx| < 15% width and |dy| < 15% height
	TYPE_CPS = 52, -- typewriter characters per second
	TYPE_DELAY = 0.2,
	FIRST_SHOW_DELAY = 1.2,
	PANEL_ORDER = 12, -- HUD 10, hotbar 11, windows 20, toasts 30
	POINTER_ORDER = 21, -- above the menu column
	POINTER_ROOM = 92, -- room right of a Menu target for the arrow (68 px long, bouncing up to 15 px out)
	EVENT_COOLDOWN = 0.35,
	NEXT_LOCK = 2.5,
	SKIP_LOCK = 3,
	LAYOUT_EVERY = 0.5,
	COVER_EVERY = 0.15, -- (C17 review) seconds between two reads of a covering window's ink over the guide (Cover.underWindow)
	PORTRAIT_STEP = 1 / 30,
	PORTRAIT_FOLDED_STEP = 1 / 15, -- the folded bubble keeps flapping at half the rate (bug batch 2 #23; phone battery)
	FINALE_SECONDS = 4.5,
	-- world guide (studs)
	VOXEL = 0.36,
	ARROW_LIFT = 5, -- arrow centre above the target top (the arrow is ~7.6 studs tall: its tip clears the top)
	-- (Pitch 2 item 13 A) the arrow hops BOB studs every BOB_STEP s, two hard steps (it bobbed on a sine and spun)
	BOB = 0.6,
	BOB_STEP = 0.45,
	TRAIL_MAX = 90,
	TRAIL_HIDE = 10,
	-- (Pitch 2 item 13 A) the dot trail: DOT_SIZE-stud flat gold blocks every DOT_STEP studs from DOT_START studs ahead
	-- of the feet (at most DOT_MAX, out to TRAIL_MAX), laid again every DOT_EVERY s
	DOT_START = 2.5,
	DOT_STEP = 3,
	DOT_SIZE = 0.8,
	DOT_MAX = 30,
	DOT_EVERY = 0.25,
	-- floating guide sign (1080p design px, scaled by the screen factor): a stone tag (SIGN_EDGE wood edge, SIGN_LIP gold
	-- lip, SIGN_PAD in) SIGN_STUDS right of the arrow's axis (beside the shaft), SIGN_LIFT studs over the arrow's centre
	SIGN_W = 340,
	SIGN_H = 96,
	SIGN_NAME = 24,
	SIGN_INFO = 19,
	SIGN_EDGE = 3,
	SIGN_LIP = 4,
	SIGN_PAD = 14,
	SIGN_STUDS = 1.6,
	SIGN_GAP = 0.5, -- (look review fin0) studs between the arrow's widest part and the sign (its offset: W.signStuds)
	SIGN_LIFT = 1.5,
	RESOLVE_RETRY = 2,
	-- (Pitch 2 item 13 A; the owner's pick B of 2026-11-23, "Top-bar plank", the X on the right) the travel guide's chip,
	-- the top bar pill's twin: a cream stone plank (its wood edge outside the face, its lip inside) in Roblox's top band,
	-- its face GUIDE_DOCK screen px left of TopbarInset's right end (else GUIDE_RIGHT_RESERVE px off the screen's right:
	-- the '...' room), at the pill's height and row (TopBarController's rule: GUIDE_PILL / GUIDE_PILL_TOUCH px in a
	-- GUIDE_BAND px band, never under GUIDE_PILL_MIN), GUIDE_PILL_GAP px or more clear of the pill. A touch screen: the
	-- two-line ticket ([needle] place / 'NN studs away' [X]) in 1080p design px under the screen factor, each on whole
	-- screen px: GUIDE_PAD in, the GUIDE_MARK block, GUIDE_GAP to the lines (GUIDE_NAME over GUIDE_INFO, the muted ink),
	-- GUIDE_GAP to the red X block, a GUIDE_LIP lip; a portrait phone (no room in the band) the same ticket
	-- GUIDE_TICKET_H tall on the vitals stack, its ink GUIDE_STACK px over the name plank. A PC: one line at the pill's
	-- height ([needle] place [the 'NN studs' tag] [X]) in GUIDE_BAR_* screen px. Its X: a GUIDE_CLOSE px target. It
	-- arrives within GUIDE_ARRIVE studs of the gate, says so for GUIDE_HERE s and slides out in two steps over the last
	-- GUIDE_SLIDE s; the stud count is read every GUIDE_READ_EVERY s
	GUIDE_ORDER = 13,
	GUIDE_DOCK = 8,
	GUIDE_BAND = 58,
	GUIDE_RIGHT_RESERVE = 72,
	GUIDE_PILL = 40,
	GUIDE_PILL_TOUCH = 48,
	GUIDE_PILL_MIN = 32,
	GUIDE_PILL_GAP = 4,
	GUIDE_PAD = 8,
	GUIDE_MARK = 34,
	GUIDE_ICON = 18,
	GUIDE_GAP = 10,
	GUIDE_NAME = 22,
	GUIDE_INFO = 18,
	GUIDE_LIP = 5,
	GUIDE_TICKET_H = 55,
	GUIDE_STACK = 8,
	GUIDE_BAR_EDGE = 3,
	GUIDE_BAR_LIP = 4,
	GUIDE_BAR_PAD = 5,
	GUIDE_BAR_GAP = 10,
	GUIDE_BAR_NAME = 20,
	GUIDE_BAR_INFO = 18,
	GUIDE_BAR_TAG_H = 24,
	GUIDE_BAR_TAG_PAD = 7,
	GUIDE_BAR_TAG_GAP = 10,
	GUIDE_BAR_X_GAP = 12,
	GUIDE_BAR_LANE = 0.6, -- (look:chipB) a PC's one-line bar starts at 60 % of the width or further right, else the ticket
	GUIDE_CLOSE = 44,
	GUIDE_ARRIVE = 8,
	GUIDE_HERE = 3,
	GUIDE_SLIDE = 0.4,
	GUIDE_READ_EVERY = 0.25,
	-- (the pick) the needle: 'ahead' while the gate is on the screen; off it, behind from GUIDE_BEHIND degrees of bearing,
	-- a new sector only GUIDE_HOLD_DEG degrees past its edge; a change in two hard sprite steps, GUIDE_NEEDLE_STEP s apart
	GUIDE_BEHIND = 130,
	GUIDE_HOLD_DEG = 10,
	GUIDE_NEEDLE_STEP = 1 / 15,
	-- (the owner's portrait pick of 2026-11-24, "steps aside for signs": asideWanted) a portrait chip hides while a shown
	-- prompt plank stands within GUIDE_SIGN_KEEP px of its spot, back only once its spot has been clear of every sign
	-- for GUIDE_SIGN_DWELL s on end (the owner's pick of 2026-11-25: was 0.5 s from when it hid). 1.0 s covers the jumps
	-- at the gate (Config.Physics: 6.9 studs, 0.53 s in the air; where the plank meets the spot only near the top, the
	-- spot is clear for up to 0.93 s between two jumps 0.5 - 0.6 s apart) and tilts of 0.5 s each way: the smallest hold
	-- with no blink in travel_guide_plank at 30 and 60 fps (0.9 s blinked there)
	GUIDE_SIGN_KEEP = 6,
	GUIDE_SIGN_DWELL = 1.0,
	-- confetti (gui px at factor 1)
	CONFETTI_SMALL = 26,
	CONFETTI_BIG = 64,
	GRAVITY = 820,
	-- (kit B U9-9) the Signboard card
	FRAME = 6, -- the wood frame round the stone body
	CARD_LIP = 6, -- the stone body's lip
	FOOT_PAD = 18, -- the card's room under the text well (the frame, the lip and 4 px of stone)
	EDGE_PX = 2, -- a block's wood edge (the well, the tags, the pips)
	TAG_LIP = 3, -- a tag's lip (the counter, the fold, the badge, Tap me!)
	PORTRAIT_FRAME = 3, -- the portrait's wood frame
	PORTRAIT_LIP = 6, -- its ground lip
	NAME_LIP = 5, -- (U9-9 look 2) the name plank's navy lip (the NPC's)
	-- (Pitch 2 item 03_tutorial_dock, option B "Quest strip"; the owner's shot 03: folded, the guide was a lone sky tile with
	-- a "!" and a navy "Tap me!" tag, no step, no title) folded, the guide is one stone strip (STRIP_W x STRIP_H, a
	-- STRIP_EDGE wood edge, its STRIP_LIP lip): Nimbus' portrait chip (STRIP_CHIP square, STRIP_PAD in), the step's title
	-- (STRIP_TITLE: 23 px on PC, 18 on a phone's 0.8) with "3/21" right of it, under them the steps (STRIP_CELL_H tall: a
	-- chapter block of PROG_CHAPTER cells each, STRIP_CHAPTER_GAP screen px apart, 1 px of wood between two cells), and the
	-- STRIP_OPEN px "+" block that opens the card (>= 44 screen px at 0.8). PC and a landscape phone: top-left under the top
	-- bar (right of the menu column); a portrait phone: on the HUD stack, from the vitals card's left edge to the RUN / DASH
	-- column's right edge, STRIP_DOCK_GAP screen px over the vitals card. Narrower than STRIP_MIN_W, or meeting the arena's
	-- side stack: the portrait chip alone (its tap opens the card)
	STRIP_W = 440,
	STRIP_MIN_W = 300,
	STRIP_H = 76,
	STRIP_PAD = 8,
	STRIP_EDGE = 3,
	STRIP_LIP = 4,
	STRIP_CHIP = 56,
	STRIP_TITLE = 23,
	STRIP_TITLE_MIN = 18,
	STRIP_COUNT = 20,
	STRIP_OPEN = 56,
	STRIP_PLUS = 27,
	STRIP_COL_GAP = 10,
	STRIP_CELL_H = 14,
	STRIP_CHAPTER_GAP = 3,
	STRIP_DOCK_GAP = 10,
	-- (kit-b backlog items 7 / 8) a landscape chip's air off a HUD piece's box where STRIP_DOCK_GAP finds no spot (568 x 320
	-- in a match: 59 px between the thumbstick and the panel), screen px: 4 px of ink past a touch key's 3 px edge
	MIN_AIR = 7,
}

local BULLET = "\194\187 " -- >>
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the portrait's fallback cloud

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local TC = Theme.Colors
local SIGN = Theme.Sign -- (kit B U9-9) the Signboard palette
-- (Pitch 2 item 13 A) the world guide's arrow wears the kit's gold: the face, its light and its lip (no own yellows)
local C = {
	Navy = TC.Navy or TC.Ink,
	Stroke = TC.TextStroke or TC.Ink,
	White = TC.White,
	Gold = TC.Gold or TC.Token,
	ArrowLight = SIGN.GoldLight or SIGN.Gold,
	Arrow = SIGN.Gold,
	ArrowDark = SIGN.GoldLip,
	ArrowShine = SIGN.Stone,
	-- (kit B U9-9) the kit's confetti: the reward's gold and the gift's pink, each with its lip (no rainbow)
	Confetti = { SIGN.Gold, SIGN.Roof, SIGN.GoldLip, SIGN.RoofLip },
}
TutorialController.Confetti = C.Confetti

-- client event -> the CompleteOn it completes (mirrors TutorialService)
local EVENT_NEEDS = { Next = "Next", ShopOpened = "ShopOpened", IndexOpened = "IndexOpened", PetsOpened = "Equipped" }
-- window / panel ids (WindowOpened, OpenPanel, menu buttons) -> event
local WINDOW_EVENTS = { Shop = "ShopOpened", Index = "IndexOpened", Pets = "PetsOpened", Inventory = "PetsOpened" }
-- the menu button that leads to what the current step waits for (store W1: the pill's Shop button opens the Robux
-- Store now, so ShopOpened has no button: the roulette machines open the Cloud Shop)
local HOOK_FOR = { IndexOpened = "Index", Equipped = "Pets" }
local WORLD_KINDS = { Spot = true, Shop = true, Roulette = true, Portal = true }
local DEFAULT_HINTS = {
	NearSpot = "Walk to your plot",
	ShopOpened = "Open the shop",
	Rolled = "Spin a roulette",
	Equipped = "Tap the Pets button", -- (U9-9 look) the kit B ring is a gold frame: nothing glows
	IndexOpened = "Tap the Index button",
	MatchStarted = "Step into the portal",
	MatchEnded = "Reach the finish",
}

-- Runtime tables (kept in a few tables so the module stays far below Lua's 200-locals limit)
local UI = {} -- panel + pointer instances
local S = { clock = 0, layoutTimer = 0, hintTimer = 0, typing = false } -- panel state
local P = { yaw = 0.38, side = -1, dist = 6, height = 3, accum = 0, excitedUntil = 0 } -- portrait
local M = { findTimer = 0 } -- menu pointer
local W = { built = false, active = false, resolveTimer = 0, labelTimer = 0 } -- world guide
local G = { active = false } -- (Pitch 2 item 13 A) the travel guide (TutorialController.Guide)
local R = { last = {}, hooked = {} } -- remotes + hooks
local Fx = { pool = {}, live = 0 } -- confetti
local Mods = {} -- optional modules: name -> table | false
local warned = {}

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, message)
	if not warned[key] then
		warned[key] = true
		warn("[TutorialController] " .. tostring(message))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, key .. " failed: " .. tostring(err))
	end
	return ok
end

local function loadModule(container, name, timeout)
	if not container then
		return nil
	end
	local inst = container:FindFirstChild(name)
	if not inst and timeout then
		local okWait, found = pcall(function()
			return container:WaitForChild(name, timeout)
		end)
		if okWait then
			inst = found
		end
	end
	if not inst then
		return nil
	end
	local ok, result = pcall(require, inst)
	if ok and type(result) == "table" then
		return result
	end
	warnOnce("load" .. name, "could not load " .. name .. ": " .. tostring(result))
	return nil
end

-- (2026-11-28 playtest C17 review) the windows over the guide: which fold the card and where they draw (one table: the
-- chunk is near Lua's 200 locals)
local Cover = {}
-- (at 667 x 375 the Ring, Dungeon and Arena windows, the Food Machine and the garden picker the steps send the player to
-- lay over the open card and the strip, 'The Champion Rin'; the Sky Trove and Fusion too, Fusion over the card on a PC)
-- every window family that answers IsOpen, after MenuController's (its windows, Pets, the Shop, the egg stage): one open
-- folds the card as a menu window does (windowCovering)
Cover.WINDOWS = { "IndexController", "DailyController", "NpcController", "ArenaController", "DungeonController",
	"CareController", "TrainController", "FusionController", "TroveController", "RaidGateController", "ObbyController",
	"LossScreen", "PetPicker" }
Cover.CONTROLLERS = {}
for _, name in ipairs(Cover.WINDOWS) do
	Cover.CONTROLLERS[name] = name ~= "PetPicker" -- (a UI module)
end

-- Optional collaborators, loaded on first use (missing ones simply switch a feature off).
local function mod(name)
	local cached = Mods[name]
	if cached == nil then
		local loaded
		if name == "CloudUI" or name == "PixelCrisp" then
			loaded = loadModule(Client:FindFirstChild("UI"), name, 5)
		elseif name == "PetPicker" then -- (2026-11-28 playtest C17 review: windowCovering, the garden picker)
			loaded = loadModule(Client:FindFirstChild("UI"), name)
		elseif name == "MenuController" or name == "IndexController" or name == "HudController" or name == "PromptController"
			or name == "MainMenuController" or Cover.CONTROLLERS[name] then -- (2026-11-28 playtest C17: windowCovering)
			loaded = loadModule(script.Parent, name)
		else
			loaded = loadModule(Shared, name, 5)
		end
		cached = loaded or false
		Mods[name] = cached
	end
	return cached or nil
end

local function make(className, name, props, parent)
	local inst = Instance.new(className)
	inst.Name = name
	if props then
		for key, value in pairs(props) do
			inst[key] = value
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

-- A transparent, borderless Frame unless props say otherwise.
local function box(name, props, parent)
	props = props or {}
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.BorderSizePixel = 0
	return make("Frame", name, props, parent)
end

local function corner(parent, px)
	return make("UICorner", "Corner", { CornerRadius = UDim.new(0, px) }, parent)
end

local function stroke(parent, color, thickness, transparency)
	return make("UIStroke", "Stroke", {
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, parent)
end

-- (kit B U9-9) a block's wood edge: a mitred border stroke named SignEdge, kept on whole screen px under the card's scale
local function edge(parent, color, px)
	local s = make("UIStroke", "SignEdge", {
		Color = color or SIGN.Wood,
		Thickness = px,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
	}, parent)
	local crisp = mod("PixelCrisp")
	if crisp then
		crisp.Edge(s, px)
	end
	return s
end

-- a flat lip along the bottom of `parent` (px tall), (U9-9 look) whole screen px at any card scale
local function lipOf(parent, color, px)
	local lip = box("Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, px),
		ZIndex = parent.ZIndex,
	}, parent)
	local crisp = mod("PixelCrisp")
	if crisp then
		crisp.Lip(lip, px)
	end
	return lip
end

-- a pixel icon on whole screen px (PixelCrisp.Icon; a hosted glyph label when PixelCrisp is missing)
local function crispIcon(parent, name, px, colour, opts)
	local crisp = mod("PixelCrisp")
	if crisp then
		return crisp.Icon(parent, name, px, colour, opts)
	end
	opts = opts or {}
	local glyph = make("TextLabel", opts.Name or "Crisp", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = colour,
		AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = opts.Position or UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(px, px),
		ZIndex = opts.ZIndex or 1,
	}, parent)
	PixelIcon.Host(glyph, name, px)
	return glyph, glyph
end

-- (U9-9 look 2) a block on whole screen px of the card on all four sides (PixelCrisp.Box: its top-left and its size)
local function crispBox(obj)
	local crisp = mod("PixelCrisp")
	if crisp and obj then
		crisp.Box(obj)
	end
	return obj
end

-- A Theme-styled label. kit-b U6: the tutorial panel is a plate, so no outline (the guide sign over the world keeps its
-- own, below, until the world sign wave moves world text to kit B).
local function label(parent, name, text, role, size, color, props)
	local obj = Theme.Label(text, role, {
		Size = size,
		Color = color or C.White,
	})
	obj.Name = name
	if props then
		for key, value in pairs(props) do
			obj[key] = value
		end
	end
	obj.Parent = parent
	return obj
end

-- (kit B U9-9) a Signboard plank (CloudUI.Button Skin "Sign" when available, a flat kit B fallback otherwise).
local FALLBACK_FACE = { Green = "Grass", Gold = "Gold", Red = "Red" }
local function button(props)
	props.Skin = "Sign"
	local CloudUI = mod("CloudUI")
	if CloudUI and type(CloudUI.Button) == "function" then
		local ok, made = pcall(CloudUI.Button, props)
		if ok and made then
			return made
		end
	end
	local base = SIGN[FALLBACK_FACE[props.Style or "Green"] or "Tile"]
	local obj = make("TextButton", props.Name or "Button", {
		AutoButtonColor = true,
		BorderSizePixel = 0,
		BackgroundColor3 = base,
		Size = props.Size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		Text = props.Text or "",
	})
	Theme.Style(obj, "Button", { Size = props.TextSize or K.BUTTON_SIZE, Color = props.Style == "Green" and SIGN.OnGrass or SIGN.Text })
	edge(obj, SIGN.Wood, 3)
	if props.Callback then
		obj.Activated:Connect(function()
			if obj:GetAttribute("Disabled") ~= true then
				props.Callback(obj)
			end
		end)
	end
	obj.Parent = props.Parent
	return obj
end

local function setDisabled(obj, disabled)
	if not obj then
		return
	end
	local CloudUI = mod("CloudUI")
	if CloudUI and type(CloudUI.SetDisabled) == "function" then
		pcall(CloudUI.SetDisabled, obj, disabled)
	else
		obj:SetAttribute("Disabled", disabled and true or false)
		obj.AutoButtonColor = not disabled
	end
end

local function setStyle(obj, style)
	local CloudUI = mod("CloudUI")
	if obj and CloudUI and type(CloudUI.SetStyle) == "function" then
		pcall(CloudUI.SetStyle, obj, style)
	elseif obj and Theme.Buttons and Theme.Buttons[style] then
		obj.BackgroundColor3 = Theme.Buttons[style]
	end
end

local function tween(inst, seconds, goal, style, direction)
	local info = TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(inst, info, goal)
	t:Play()
	return t
end

local function inMatch()
	return LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

local function playerGui()
	return LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- y shift that converts another ScreenGui's AbsolutePosition into ours (ours does not ignore the inset).
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function shownIn(inst, rootGui)
	local node = inst
	while node and node ~= rootGui do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	if rootGui and rootGui:IsA("ScreenGui") and not rootGui.Enabled then
		return false
	end
	return node == rootGui
end

local function rectOf(inst, dy)
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	return { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

local function guiArea()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X > 1 and size.Y > 1 then
		return size
	end
	local camera = Workspace.CurrentCamera
	if camera and camera.ViewportSize.X > 1 then
		return Vector2.new(camera.ViewportSize.X, camera.ViewportSize.Y - topInset())
	end
	return Vector2.new(1280, 660)
end

local function rootPart()
	local character = LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root
	end
	return nil
end

local function firstRouletteId()
	local list = Config.Roulettes
	if type(list) == "table" and type(list[1]) == "table" and type(list[1].Id) == "string" then
		return list[1].Id
	end
	return "Cloud"
end

local function graphemeCount(text)
	if utf8 and type(utf8.len) == "function" then
		local ok, n = pcall(utf8.len, text)
		if ok and type(n) == "number" then
			return n
		end
	end
	return #text
end

----------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------
local function getRemote(name)
	local folder = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 15)
	if not folder then
		return nil
	end
	local remote = folder:FindFirstChild(name) or folder:WaitForChild(name, 10)
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

-- true when the current step shows the Next button: a "Next" step, or one with AlsoNext (bug batch 2 #24: the raid
-- step completes on its floor OR on Next)
local function nextShown(st)
	return st ~= nil and not st.Done and (st.CompleteOn == "Next" or st.AlsoNext == true)
end

-- Sends a tutorial event. Window / Next events go out only when the current step waits for them.
local function fireEvent(name)
	if not R.event then
		return false
	end
	if name ~= "Sync" and name ~= "Skip" then
		local st = S.state
		if not st or st.Done or (EVENT_NEEDS[name] ~= st.CompleteOn and not (name == "Next" and nextShown(st))) then
			return false
		end
	end
	local now = os.clock()
	local last = R.last[name]
	if last and now - last < K.EVENT_COOLDOWN then
		return false
	end
	R.last[name] = now
	local ok = pcall(function()
		R.event:FireServer(name)
	end)
	return ok
end

local function onWindowOpened(windowId)
	local event = WINDOW_EVENTS[tostring(windowId)]
	if event then
		fireEvent(event)
	end
end

----------------------------------------------------------------------
-- Panel: measuring + layout
----------------------------------------------------------------------
-- Height of the wrapped body text (design px). TextService wraps at the frame width; a result wider than the
-- frame means it did not wrap, so a per-line estimate is used instead.
local function bodyHeight(text, width)
	local perLine = math.max(8, math.floor(width / (K.BODY_SIZE * 0.52)))
	local estimate = math.max(1, math.ceil(#text / perLine)) * math.ceil(K.BODY_SIZE * 1.2) + 6
	local ok, size = pcall(function()
		return Theme.Measure(text, "Body", K.BODY_SIZE, width)
	end)
	if ok and size and size.Y > 0 and size.X <= width + 1 then
		return math.ceil(size.Y) + 6
	end
	return estimate
end

-- Single-line text width (design px) in a Theme role, as the label shows it ((U9-9 look) a caps role in capitals, a
-- FontFace role widened: the Title role's Enum font in lower case measured "NIMBUS" 10 % short, and the name came out
-- "NIMB..."); a rough per-character estimate when TextService cannot measure.
local function textWidth(text, size, role)
	local hook = TutorialController.Metrics.MEASURE
	local ok, measured = pcall(function()
		if hook then
			return hook(text, size, role)
		end
		return Theme.Measure(text, role, size, 10000)
	end)
	if ok and measured and measured.X > 0 then
		return measured.X
	end
	return #text * size * 0.62
end

-- The largest text size from `size` down to `minSize` (steps of 2, the last step to minSize itself) whose text fits
-- `room` design px.
local function fitTextSize(text, size, minSize, role, room)
	while size > minSize and textWidth(text, size, role) + K.OUTLINE_ROOM > room do
		size = math.max(minSize, size - 2)
	end
	return size
end

-- (kit-b backlog item 10) the lines `text` wraps to at `size` in `width` design px, word by word as the engine wraps it,
-- each line measured as it shows (textWidth: the titles' measure) with its glyph outline's room
local function wrapLines(text, size, role, width)
	local lines, line = 0, nil
	for sep, word in string.gmatch(text, "(%s*)(%S+)") do
		local try = line and (line .. sep .. word) or word
		if line and textWidth(try, size, role) + K.OUTLINE_ROOM > width then
			lines, line = lines + 1, word
		else
			line = try
		end
	end
	return lines + (line and 1 or 0)
end

-- (U9-9 look) the objective line wraps to a second line rather than cut its words (it was "Tap the glowing Pet..." on a
-- portrait phone): measured at the size it takes on the smallest card (14 screen px at 0.7) with the room the distance
-- suffix needs, so the card never jumps in height as the player walks. Returns its row's design height and its lines.
-- (kit-b backlog item 10: 13 objective lines ran past a one-line row - 960 x 540 '...then Food' / 'Machine' - where
-- TextService's wrapped height was read as one line; and a third line was never counted) its lines counted word by word
-- (wrapLines), as many as it takes
local HINT_MEASURE = math.max(K.CAPTION_SIZE, math.ceil(14 / 0.7 - 1e-6))
local function hintHeight(width)
	local st = S.state
	local text = st and (st.Hint or DEFAULT_HINTS[st.CompleteOn]) or ""
	if st and type(st.Target) == "table" and WORLD_KINDS[st.Target.Kind] then
		text = text .. "  \194\183  you're here!" -- (kit-b backlog item 10: the middle dot, as the live line has it; it was the bytes 1, "94", 1, "83")
	end
	local lines = math.max(1, wrapLines(BULLET .. text, HINT_MEASURE, "Label", width))
	return K.HINT_H + (lines - 1) * math.ceil(HINT_MEASURE * 1.2), lines
end

-- (kit-b backlog items 10 / 16: 'Pick Your Te...', 'Your Pet Gar...' on a narrow card at the 14.4 px floor) the lines the
-- step's title takes in a card `width` design px wide: 1 where it fits one line of the header at K.TITLE_FLOOR - its floor
-- on the smallest card (14 screen px at 0.7) -, else the lines it wraps to at that size (applyGeometry, panelHeight)
local function titleLines(width)
	local title = UI.StepTitle and UI.StepTitle.Text or ""
	local room = width - (K.PAD + K.PORTRAIT + 12) - K.PAD
	if title == "" or textWidth(title, K.TITLE_FLOOR, "Heading") + K.OUTLINE_ROOM <= room then
		return 1
	end
	return math.max(2, wrapLines(title, K.TITLE_FLOOR, "Heading", room))
end

-- the header's extra design px for the title's lines: each line past the first is K.TITLE_LINE, but on a narrow card (no
-- counter tag) the progress row moves up beside the fold block and the first two lines fit the header (applyGeometry)
local function titleExtraOf(width, lines)
	local headRoom = width - (K.PAD + K.PORTRAIT + 12) - K.PAD
	local counterShown = headRoom >= K.COUNTER_W + 6 + K.FOLD_W
	return math.max(0, lines - (counterShown and 1 or 2)) * K.TITLE_LINE
end

local function hintShown()
	local st = S.state
	-- (S.compactCard: a short screen's opened card drops the objective line; the text above says the same)
	return st ~= nil and not st.Done and st.CompleteOn ~= "Next" and not S.finale and not S.compactCard
end

local function footerShown()
	return not S.finale
end

-- Design-pixel height of the expanded panel at `width` (cached per width + text), its body's and its hint's, and the
-- header's extra for a title on more lines (titleLines, titleExtraOf).
local function panelHeight(width)
	local text = S.fullText or ""
	local st = S.state
	local title = UI.StepTitle and UI.StepTitle.Text or ""
	local key = tostring(width) .. "|" .. text .. "|" .. tostring(hintShown()) .. "|" .. tostring(footerShown()) .. "|" .. tostring(st and st.Step) .. "|" .. title
	if S.heightKey == key then
		return S.heightValue, S.bodyValue, S.hintValue, S.titleExtraValue
	end
	local wellW = width - 2 * K.PAD - 2 * K.WELL_PAD
	local bodyH = bodyHeight(text, wellW)
	local titleExtra = titleExtraOf(width, titleLines(width))
	local h = K.HEADER_H + titleExtra + 10 + bodyH + 8 + K.FOOT_PAD -- (kit B U9-9) the well ends above the stone lip
	local hintH = K.HINT_H
	if hintShown() then
		hintH = hintHeight(wellW)
		h = h + hintH + 4
	end
	if footerShown() then
		h = h + K.FOOTER_H
	end
	S.heightKey, S.heightValue, S.bodyValue, S.hintValue, S.titleExtraValue = key, h, bodyH, hintH, titleExtra
	return h, bodyH, hintH, titleExtra
end

-- MenuController's column (or the union of its MenuButton_* tiles) in our gui coordinates.
local function menuRect()
	local pg = playerGui()
	local menuGui = pg and pg:FindFirstChild("NimbusMenu")
	if not (menuGui and menuGui:IsA("ScreenGui") and menuGui.Enabled) then
		return nil
	end
	local dy = insetShift(menuGui)
	local column = menuGui:FindFirstChild("MenuColumn", true)
	if column and column:IsA("GuiObject") and column.AbsoluteSize.X > 0 and shownIn(column, menuGui) then
		return rectOf(column, dy)
	end
	local found = nil
	for _, d in ipairs(menuGui:GetDescendants()) do
		if d:IsA("GuiObject") and string.sub(d.Name, 1, 11) == "MenuButton_" and d.AbsoluteSize.X > 0 and shownIn(d, menuGui) then
			local r = rectOf(d, dy)
			if found then
				found.x0, found.y0 = math.min(found.x0, r.x0), math.min(found.y0, r.y0)
				found.x1, found.y1 = math.max(found.x1, r.x1), math.max(found.y1, r.y1)
			else
				found = r
			end
		end
	end
	return found
end

-- (look:fix6b2 N1) the menu column as far as it reaches: menuRect with every shown button in the column - its tiles, its
-- fold tab and the tab's tap pad (MenuController's ToggleHit, reaching right into the free sky); nil without a column
local function columnReach()
	local r = menuRect()
	local pg = playerGui()
	local menuGui = pg and pg:FindFirstChild("NimbusMenu")
	local column = r and menuGui and menuGui:FindFirstChild("MenuColumn", true)
	if not column then
		return r
	end
	local dy = insetShift(menuGui)
	for _, d in ipairs(column:GetDescendants()) do
		if d:IsA("GuiButton") and d.AbsoluteSize.X > 0 and shownIn(d, menuGui) then
			local b = rectOf(d, dy)
			r = { x0 = math.min(r.x0, b.x0), y0 = math.min(r.y0, b.y0), x1 = math.max(r.x1, b.x1), y1 = math.max(r.y1, b.y1) }
		end
	end
	return r
end

-- HUD neighbours (published by HudController, gui px): bottom of the top-left panel area and top of the
-- bottom-left block (vitals / currency), plus the top-left panel's right edge and the top-right stack (0 when absent).
local function hudBounds(area)
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local out = { TopLeftBottom = 0, TopLeftRight = 0, BottomLeftTop = area.Y, TopRightLeft = 0, TopRightBottom = 0 }
	if hud and hud:IsA("ScreenGui") and hud.Enabled then
		local dy = insetShift(hud)
		local a = tonumber(hud:GetAttribute("TopLeftBottom"))
		if a and a > 0 then
			out.TopLeftBottom = a + dy
		end
		local b = tonumber(hud:GetAttribute("BottomLeftTop"))
		if b and b > 0 then
			out.BottomLeftTop = b + dy
		end
		local r = tonumber(hud:GetAttribute("TopLeftRight"))
		if r and r > 0 and out.TopLeftBottom > 0 then
			out.TopLeftRight = r
		end
		local trl = tonumber(hud:GetAttribute("TopRightLeft"))
		local trb = tonumber(hud:GetAttribute("TopRightBottom"))
		if trl and trl > 0 and trb and trb > 0 then
			out.TopRightLeft, out.TopRightBottom = trl, trb + dy
		end
	end
	return out
end

-- The hotbar in our gui coordinates (nil when there is none on screen).
local function hotbarRect()
	local pg = playerGui()
	local bar = pg and pg:FindFirstChild("NimbusHotbar")
	local frame = bar and bar:FindFirstChild("Hotbar")
	if frame and frame:IsA("GuiObject") and frame.AbsoluteSize.X > 0 and shownIn(frame, bar) then
		return rectOf(frame, insetShift(bar))
	end
	return nil
end

-- The HUD's bottom-left block (vitals card, currency pills) as rects in our gui coordinates. ((kitb-matchhud) `noVitals`:
-- without the vitals card)
local function bottomLeftRects(noVitals)
	local out = {}
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local block = hud and hud:FindFirstChild("BottomLeft")
	if not (block and hud:IsA("ScreenGui") and hud.Enabled) then
		return out
	end
	local dy = insetShift(hud)
	for _, child in ipairs(block:GetChildren()) do
		if child:IsA("GuiObject") and child.AbsoluteSize.X > 0 and shownIn(child, hud) and not (noVitals and child.Name == "Vitals") then
			out[#out + 1] = rectOf(child, dy)
		end
	end
	return out
end

-- (kitb-matchhud) the vitals card's slot, shown or stepped aside (HudController.GetLayout().VitalsSlot: gui-area px of an
-- IgnoreGuiInset = false gui, as ours), nil when there is none
local function vitalsSlot()
	local hud = mod("HudController")
	if not (hud and type(hud.GetLayout) == "function") then
		return nil
	end
	local ok, lay = pcall(hud.GetLayout)
	local s = ok and type(lay) == "table" and lay.VitalsSlot
	if not s then
		return nil
	end
	return { x0 = s.X, y0 = s.Y, x1 = s.X + s.W, y1 = s.Y + s.H }
end

-- Phase 3: the compact battle team cards (BattleController on phones and small windows: a row under the battle's
-- top card, or a grid at the left edge of a landscape phone where the menu tiles were) while the player fights;
-- nil otherwise (no battle, or the wide layout's team card at the bottom right).
local function battleTeamRect(area)
	local pg = playerGui()
	local battle = pg and pg:FindFirstChild("NimbusBattle")
	local root = battle and battle:FindFirstChild("Root")
	local team = root and root:FindFirstChild("Team")
	if team and team:IsA("GuiObject") and team.AbsoluteSize.X > 0 and shownIn(team, battle) then
		local r = rectOf(team, insetShift(battle))
		if r.y0 < area.Y * 0.4 then
			return r
		end
	end
	return nil
end

-- Roblox's touch thumbstick (bottom-left; the classic stick or the dynamic stick's idle ring, whichever is
-- bigger) in gui px, nil without touch.
local function thumbstickRect(area)
	if not UserInputService.TouchEnabled then
		return nil
	end
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or area
	if math.min(vp.X, vp.Y) <= 500 then
		return { x0 = 25, y0 = area.Y - 96, x1 = 104, y1 = area.Y - 20 }
	end
	return { x0 = 58, y0 = area.Y - 210, x1 = 206, y1 = area.Y - 90 }
end

-- The touch RUN / DASH buttons (MovementController's MobileControls) in our gui coordinates.
local function touchButtonRects()
	local out = {}
	local pg = playerGui()
	local mobile = pg and pg:FindFirstChild("MobileControls")
	if not (mobile and mobile:IsA("ScreenGui") and mobile.Enabled) then
		return out
	end
	local dy = insetShift(mobile)
	for _, d in ipairs(mobile:GetDescendants()) do
		if d:IsA("GuiButton") and d.AbsoluteSize.X > 0 and shownIn(d, mobile) then
			out[#out + 1] = rectOf(d, dy)
		end
	end
	return out
end

-- A menu window, the odds popup, the roulette stage or the Pet Index is open (they cover the menu and the card).
local function windowCovering()
	local menu = mod("MenuController")
	if menu and type(menu.IsOpen) == "function" then
		local ok, open = pcall(menu.IsOpen)
		if ok and open == true then
			return true
		end
	end
	-- (2026-11-28 playtest C17) the Gifts window and an NPC's dialog stacked on the open card: they cover it too, as every
	-- other window family does (Cover.WINDOWS, C17 review)
	for _, name in ipairs(Cover.WINDOWS) do
		local m = mod(name)
		if m and type(m.IsOpen) == "function" then
			local ok, open = pcall(m.IsOpen)
			if ok and open == true then
				return true
			end
		end
	end
	-- (C17 review 2: the top bar gear's Settings window lay over the open card and the strip on the phones, the card still
	-- open) the game menu's own windows (Settings, What's New, Credits: MainMenuController.Window) cover it too
	local mmc = mod("MainMenuController")
	if mmc and type(mmc.Window) == "function" then
		local ok, holder = pcall(mmc.Window)
		if ok and holder ~= nil then
			return true
		end
	end
	-- (C17) and a phone's dungeon chip in the top band (DungeonController's RunChip: the party countdown, the run) lay
	-- under the strip, 'Door: tap Enter' read 'Enter'
	local pg = playerGui()
	local run = pg and pg:FindFirstChild("NimbusDungeonRun")
	local chip = run and run:FindFirstChild("RunChip", true)
	if chip and chip:IsA("GuiObject") and run:IsA("ScreenGui") and chip.AbsoluteSize.X > 0 and shownIn(chip, run) then
		return true
	end
	return false
end

-- Folded into the bubble? A window on top (S.windowOpen) or a card that cannot fit on this screen right now
-- (S.forcedBubble) always folds it; otherwise the player's choice, else automatic (the card does not fit).
local function collapsed()
	if S.windowOpen or S.forcedBubble then
		return true
	end
	if S.finale then
		return false
	end
	if S.manual == "collapsed" then
		return true
	end
	return S.manual ~= "expanded" and S.autoCollapse == true
end

-- (U9-9 look) the step progress: ONE SignKit.BlockRow (the kit's block-bar language: a wood edge, the face, its darker
-- lip) in a holder that undoes the card's scale, so its blocks, gaps, edges and lips are whole screen px at every card
-- size. A block per step while each gets K.PROG_MIN px, else a block per chapter of K.PROG_CHAPTER steps: done grass,
-- the current gold, the rest the sunk well with no lip. (The pips, their tight variant and the thin bar it replaces
-- were four looks for one thing.)
local PROG_LOOK = {
	Done = { Face = SIGN.Grass, Lip = SIGN.GrassLip },
	Current = { Face = SIGN.Gold, Lip = SIGN.GoldLip },
	Open = { Face = SIGN.Well },
}

-- (Pitch 2 03 B) the quest strip's steps for S.progStep / S.progDone: a done step's cell grass, the current one gold,
-- the rest the sunk well (the card's row looks, one cell a step)
local function paintStripSteps()
	local row = UI.StripRow
	if not row then
		return
	end
	local step, done = S.progStep or 0, S.progDone == true
	for _, cell in ipairs(row:GetDescendants()) do
		local s = cell:GetAttribute("Step")
		if s then
			local state = (done or s < step) and "Done" or (s == step and "Current" or "Open")
			cell.BackgroundColor3 = PROG_LOOK[state].Face
			cell:SetAttribute("State", state)
		end
	end
	row:SetAttribute("Current", done and 0 or step)
end

-- paints the row for `current` (the step shown; 0 with allDone for the finale); no arguments: the last ones again
local function paintProgress(current, allDone)
	if current ~= nil then
		S.progStep, S.progDone = current, allDone == true
	end
	paintStripSteps()
	local row = UI.ProgressRow
	if not row then
		return
	end
	local per = row:GetAttribute("PerBlock") or 1
	local n = row:GetAttribute("Count") or 0
	local step = S.progStep or 0
	local now = step >= 1 and math.ceil(step / per) or 0
	for i = 1, n do
		local state = "Open"
		if S.progDone or i < now then
			state = "Done"
		elseif i == now then
			state = "Current"
		end
		local block = row:FindFirstChild("Block" .. i)
		local face = block and block:FindFirstChild("Face")
		if face then
			local look = PROG_LOOK[state]
			block:SetAttribute("State", state)
			face.BackgroundColor3 = look.Face
			face.BackgroundTransparency = 0
			local lip = face:FindFirstChild("Lip")
			if lip then
				lip.Visible = look.Lip ~= nil
				lip.BackgroundColor3 = look.Lip or look.Face
			end
		end
	end
	row:SetAttribute("Current", (S.progDone and 0) or now)
end

-- the face of the block the current step is in (it breathes), nil when there is none
local function currentProgressFace()
	local row = UI.ProgressRow
	local now = row and row:GetAttribute("Current")
	local block = row and now and now > 0 and row:FindFirstChild("Block" .. now)
	return block and block:FindFirstChild("Face") or nil
end

-- sizes the row to `room` design px of the header at the card's scale, rebuilding it when its blocks change
local function layoutProgress(room)
	local holder = UI.Progress
	if not holder then
		return
	end
	local crisp = mod("PixelCrisp")
	local k = math.max(0.1, crisp and crisp.ScaleAbove(holder) or UI.Scale.Scale)
	local total = S.progTotal or 0
	local roomPx = math.max(0, math.floor(room * k))
	local per, n = 1, total
	local bw = n > 0 and math.floor((roomPx + K.PROG_GAP) / n) - K.PROG_GAP or 0
	-- (kit-b gate U9 r4: 21 thin blocks beside "Step 1/21" said the same thing twice, as noise) more than PROG_BLOCKS steps
	-- show as chapters of PROG_CHAPTER (21 steps: 7 blocks); the counter keeps the exact step
	if bw < K.PROG_MIN or n > K.PROG_BLOCKS then
		per = K.PROG_CHAPTER
		n = math.ceil(total / per)
		bw = n > 0 and math.floor((roomPx + K.PROG_GAP) / n) - K.PROG_GAP or 0
	else
		bw = math.min(bw, K.PROG_MAX)
	end
	local unscale = holder:FindFirstChild("Unscale")
	if unscale and unscale.Scale ~= 1 / k then
		unscale.Scale = 1 / k
	end
	holder.Size = UDim2.fromOffset(roomPx, K.PROG_H)
	local key = n .. "|" .. bw .. "|" .. per .. "|" .. total
	if S.progKey ~= key or not (UI.ProgressRow and UI.ProgressRow.Parent) then
		S.progKey = key
		if UI.ProgressRow then
			UI.ProgressRow:Destroy()
			UI.ProgressRow = nil
		end
		local SignKit = mod("SignKit")
		if SignKit and n > 0 and bw > 0 then
			local row = SignKit.BlockRow(holder, { Count = n, BlockW = bw, BlockH = K.PROG_H, Gap = K.PROG_GAP })
			row:SetAttribute("PerBlock", per)
			row:SetAttribute("Steps", total)
			for i = 1, n do
				local block = row:FindFirstChild("Block" .. i)
				local face = block and block:FindFirstChild("Face")
				local lip = face and face:FindFirstChild("Lip")
				if lip then
					lip.Size = UDim2.new(1, 0, 0, K.PROG_LIP)
				end
			end
			UI.ProgressRow = row
		end
	end
	paintProgress()
end

-- (Pitch 2 03 B) sizes the quest strip's steps to `room` design px at the strip's scale: one chapter block of
-- K.PROG_CHAPTER cells per chapter (21 steps: 7 blocks of 3, so the row and "3/21" agree), each block a wood frame
-- (2 screen px) round its cells with 1 px of wood between two; rebuilt only when the blocks change
local function layoutStripSteps(room)
	local holder = UI.StripSteps
	if not holder then
		return
	end
	local crisp = mod("PixelCrisp")
	local k = math.max(0.1, crisp and crisp.ScaleAbove(holder) or UI.Scale.Scale)
	local total = S.progTotal or 0
	local per = K.PROG_CHAPTER
	local n = math.ceil(total / per)
	local roomPx = math.max(0, math.floor(room * k))
	local hPx = math.max(8, math.floor(K.STRIP_CELL_H * k + 0.5))
	local gap, e = K.STRIP_CHAPTER_GAP, 2
	local bw = n > 0 and math.floor((roomPx + gap) / n) - gap or 0
	local unscale = holder:FindFirstChild("Unscale")
	if unscale and unscale.Scale ~= 1 / k then
		unscale.Scale = 1 / k
	end
	holder.Size = UDim2.fromOffset(roomPx, hPx)
	local key = n .. "|" .. bw .. "|" .. hPx .. "|" .. total
	if S.stripKey ~= key or not (UI.StripRow and UI.StripRow.Parent) then
		S.stripKey = key
		if UI.StripRow then
			UI.StripRow:Destroy()
			UI.StripRow = nil
		end
		if n > 0 and bw > 2 * e + per then
			local row = box("Row", { Size = UDim2.fromOffset(n * (bw + gap) - gap, hPx), ZIndex = 2 }, holder)
			row:SetAttribute("Steps", total)
			row:SetAttribute("PerBlock", per)
			for i = 1, n do
				local block = box("Chapter" .. i, {
					BackgroundTransparency = 0,
					BackgroundColor3 = SIGN.Wood,
					Position = UDim2.fromOffset((i - 1) * (bw + gap), 0),
					Size = UDim2.fromOffset(bw, hPx),
					ZIndex = 2,
				}, row)
				local c = math.min(per, total - (i - 1) * per)
				local inner = bw - 2 * e
				local cw = math.floor((inner - (c - 1)) / c)
				local x = e
				for j = 1, c do
					local w = (j == c) and (bw - e - x) or cw
					local cell = box("Cell" .. j, {
						BackgroundTransparency = 0,
						BackgroundColor3 = SIGN.Well,
						Position = UDim2.fromOffset(x, e),
						Size = UDim2.fromOffset(w, hPx - 2 * e),
						ZIndex = 2,
					}, block)
					cell:SetAttribute("Step", (i - 1) * per + j)
					x = x + cw + 1
				end
			end
			UI.StripRow = row
		end
	end
	paintStripSteps()
end

-- (Pitch 2 03 B) the HUD's vitals card (NimbusHud.BottomLeft.Vitals) in our gui px, nil when it is not shown
local function vitalsRect()
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local block = hud and hud:FindFirstChild("BottomLeft")
	local vitals = block and block:FindFirstChild("Vitals")
	if vitals and vitals:IsA("GuiObject") and vitals.AbsoluteSize.X > 0 and shownIn(vitals, hud) then
		return rectOf(vitals, insetShift(hud))
	end
	return nil
end

-- (Pitch 2 03 B, the spec's caveat) the arena's side stack (ArenaController: NimbusArenaSide.SideStack, anchored at the
-- bottom right and growing upward) in our gui px while it holds a shown card, nil otherwise
local function arenaSideRect()
	local pg = playerGui()
	local gui = pg and pg:FindFirstChild("NimbusArenaSide")
	local side = gui and gui:FindFirstChild("SideStack")
	if not (side and side:IsA("GuiObject") and side.AbsoluteSize.X > 0 and shownIn(side, gui)) then
		return nil
	end
	for _, c in ipairs(side:GetChildren()) do
		if c:IsA("GuiObject") and c.Visible and c.AbsoluteSize.Y > 0 then
			return rectOf(side, insetShift(gui))
		end
	end
	return nil
end

-- (Pitch 2 03 B) lays the folded guide out as the quest strip at `x, y` (gui px), `w` design px wide, or as the portrait
-- chip alone (`chip`): the strip's parts, the portrait on its left end, the "+" only while the card can open
local function placeStrip(w, chip)
	local pad, c = K.STRIP_PAD, K.STRIP_CHIP
	UI.Strip.Visible = not chip
	if chip then
		UI.Portrait.Position = UDim2.fromOffset(0, 0)
		UI.Portrait.Size = UDim2.fromOffset(c, c)
		return
	end
	UI.Strip.Position = UDim2.fromOffset(0, 0)
	UI.Strip.Size = UDim2.fromOffset(w, K.STRIP_H)
	UI.Portrait.Position = UDim2.fromOffset(pad, pad)
	UI.Portrait.Size = UDim2.fromOffset(c, c)
	local canOpen = S.canOpen ~= false and not S.windowOpen
	UI.StripOpen.Visible = canOpen
	local openX = w - pad - K.STRIP_OPEN
	UI.StripOpen.Position = UDim2.fromOffset(openX, pad)
	UI.StripOpen.Size = UDim2.fromOffset(K.STRIP_OPEN, c)
	local x0 = pad + c + K.STRIP_COL_GAP
	local x1 = canOpen and (openX - K.STRIP_COL_GAP) or (w - pad - K.STRIP_COL_GAP)
	local colW = math.max(20, x1 - x0)
	local titleH = K.STRIP_TITLE + 6
	local count = UI.StripCount.Text
	local countW = math.ceil(textWidth(count, K.STRIP_COUNT, "Heading")) + K.OUTLINE_ROOM
	UI.StripCount.Position = UDim2.fromOffset(x1 - countW, pad)
	UI.StripCount.Size = UDim2.fromOffset(countW, titleH)
	local titleW = math.max(20, colW - countW - 8)
	local title = UI.StripTitle.Text
	local size = fitTextSize(title, K.STRIP_TITLE, K.STRIP_TITLE_MIN, "Heading", titleW)
	-- (kit-b backlog items 10 / 16: 'The Pet Ind...' at 640 x 360) a title that does not fit beside its count even at its
	-- floor takes the count's room too: the strip drops "6/21" (its step cells still show the progress), as a narrow card
	-- drops its counter tag
	local showCount = textWidth(title, size, "Heading") + K.OUTLINE_ROOM <= titleW
	UI.StripCount.Visible = showCount
	if not showCount then
		titleW = colW
		size = fitTextSize(title, K.STRIP_TITLE, K.STRIP_TITLE_MIN, "Heading", titleW)
	end
	UI.StripTitle.TextSize = size
	UI.StripTitle.Position = UDim2.fromOffset(x0, pad)
	UI.StripTitle.Size = UDim2.fromOffset(titleW, titleH)
	local stepsY = pad + titleH + 4
	UI.StripSteps.Position = UDim2.fromOffset(x0, stepsY)
	layoutStripSteps(colW)
end

-- (U9-9 look) the HUD's vitals card steps aside while the opened card lies over a part of it (the plain lobby's card
-- the player opened on a short screen), as the result card and the NPC dialog do; back when the card folds or goes.
-- `rect`: the opened card in gui px, nil when it is folded or hidden. ((kitb-matchhud) `aside`: the folded chip's spot
-- holds them aside - layout's landscape chip)
local function syncVitals(rect, aside)
	local off = aside == true
	local hud = mod("HudController")
	if not off and rect and hud and type(hud.GetLayout) == "function" then
		local okLayout, lay = pcall(hud.GetLayout)
		local slot = okLayout and type(lay) == "table" and lay.VitalsSlot
		if slot then -- (gui-area px of an IgnoreGuiInset = false gui, as ours)
			local w = math.min(rect.x1, slot.X + slot.W) - math.max(rect.x0, slot.X)
			local h = math.min(rect.y1, slot.Y + slot.H) - math.max(rect.y0, slot.Y)
			off = w > 4 and h > 4
		end
	end
	if off ~= (S.vitalsOff == true) and hud and type(hud.SetVitalsHidden) == "function" then
		S.vitalsOff = off
		pcall(hud.SetVitalsHidden, "Tutorial", off)
	end
end

-- Applies the inner geometry of the panel for a design width / height (`titleExtra`: the header's second title line).
local function applyGeometry(width, height, bodyH, hintH, titleExtra)
	titleExtra = titleExtra or 0
	UI.Root.Size = UDim2.fromOffset(width, height)
	-- (kit-b backlog items 10 / 16) a title on two lines or more (titleLines): on a narrow card, with no counter tag, the
	-- progress row takes the tag's place left of the fold block and the title the progress row's, so two lines keep the
	-- header's height (a short phone's card has no px to spare); the progress row and the text well titleExtra lower.
	-- (written only when they move: PixelCrisp keeps its whole-px nudge in their Scale)
	local x0 = K.PAD + K.PORTRAIT + 12
	local headRoom = width - x0 - K.PAD
	local counterShown = headRoom >= K.COUNTER_W + 6 + K.FOLD_W
	local wraps = titleLines(width) > 1
	local progUp = wraps and not counterShown
	local function at(obj, x, y)
		if obj.Position.X.Offset ~= x or obj.Position.Y.Offset ~= y then
			obj.Position = UDim2.fromOffset(x, y)
		end
	end
	at(UI.Progress, x0, progUp and (K.TAG_Y + math.floor((K.TAG_H - K.PROG_H) / 2)) or (76 + titleExtra))
	at(UI.Well, K.PAD, K.HEADER_H + titleExtra)
	if UI.Well.Size.Y.Offset ~= -(K.HEADER_H + titleExtra + K.FOOT_PAD) then
		UI.Well.Size = UDim2.new(1, -2 * K.PAD, 1, -(K.HEADER_H + titleExtra + K.FOOT_PAD))
	end
	UI.Body.Size = UDim2.new(1, -2 * K.WELL_PAD, 0, bodyH)
	UI.TypeSkip.Size = UI.Body.Size
	UI.Hint.Position = UDim2.fromOffset(K.WELL_PAD, 10 + bodyH + 4)
	UI.Hint.Size = UDim2.new(1, -2 * K.WELL_PAD, 0, hintH or K.HINT_H) -- (U9-9 look) one or two lines
	UI.Hint.Visible = hintShown()
	UI.Footer.Visible = footerShown()
	-- (kit B U9-9) a card shrunk to fit a short phone (down to 0.7) keeps its small words at 14 screen px or more: the
	-- caption size grows to 14 / scale (18 -> 20 at 0.7)
	local cap = math.max(K.CAPTION_SIZE, math.ceil(14 / math.max(0.1, UI.Scale.Scale) - 1e-6))
	-- narrow cards drop the counter tag (the progress row still shows the progress): the counter and the fold share the
	-- row under the name plank (U9-9 look 2), the fold always shown
	UI.CounterPill.Visible = counterShown
	-- (U9-9 look 2) the name on its navy plank: as wide as the name at its size (measured as it shows, the Title role in
	-- capitals) and its insets, never wider than the header; the name down to the caption size before it would cut, the
	-- label TextScaled under that size (as the NPC's name), so the engine's own fit has the last word
	local nameRoom = headRoom - 2 * K.TAB_INSET
	local nameMin = math.min(K.NAME_MIN, cap)
	local nameSize = fitTextSize(UI.Name.Text, K.TAB_TEXT, nameMin, "Title", nameRoom)
	UI.Name.TextSize = nameSize
	if UI.NameFit then
		UI.NameFit.MinTextSize = nameMin
		UI.NameFit.MaxTextSize = nameSize
	end
	if UI.NameTab then
		local plankW = math.ceil(textWidth(UI.Name.Text, nameSize, "Title")) + K.OUTLINE_ROOM + 2 * K.TAB_INSET
		UI.NameTab.Size = UDim2.fromOffset(math.min(headRoom, plankW), K.TAB_H)
	end
	UI.Counter.TextSize = cap
	UI.Hint.TextSize = cap
	UI.SkipLink.TextSize = cap
	UI.ConfirmQuestion.TextSize = math.max(19, cap)
	-- (kit-b backlog items 10 / 16) one line from TITLE_SIZE down to TITLE_FLOOR, else its lines at TITLE_FLOOR
	-- (titleLines); it was cut at the 14.4 px floor on a narrow card. Its box: from the title row's top to 7 px over the
	-- well with the progress row moved up, or the row's 26 px; each line past those TITLE_LINE taller (titleExtra)
	UI.StepTitle.TextWrapped = wraps
	UI.StepTitle.TextYAlignment = wraps and Enum.TextYAlignment.Bottom or Enum.TextYAlignment.Center
	-- (2026-11-28 playtest C49: its descender touched the well's frame, 0.8 px, on phones; C49 review: 4 px over the well
	-- only moved the tail onto the frame, which is a 2 px edge drawn outside the well, the 'y' of 'Pick a Buddy' and the
	-- 'g' of 'Into the Dungeon!' drawn about 1 px under the box) the moved-up box ends 7 px over the well, 5 clear of its
	-- 2 px edge (4.1 - 4.5 on a phone card, whose edge is 2 screen px); 42 px still holds two 20 px lines
	UI.StepTitle.Size = UDim2.new(1, -(x0 + K.PAD), 0, (progUp and (K.HEADER_H - 7 - 46) or 26) + titleExtra)
	UI.StepTitle.TextSize = wraps and K.TITLE_FLOOR or fitTextSize(UI.StepTitle.Text, K.TITLE_SIZE, math.min(K.TITLE_FLOOR, cap), "Heading", headRoom)
	layoutProgress(progUp and (headRoom - K.FOLD_W - 6) or headRoom)
	-- narrow footers: "Skip tutorial" shortens to "Skip" and the Next button narrows, so they never overlap
	local footerW = width - 2 * K.PAD - 2 * K.WELL_PAD
	local shortSkip = footerW < K.SKIP_W + K.GAP + K.NEXT_W
	local skipW = shortSkip and K.SKIP_SHORT_W or K.SKIP_W
	UI.SkipLink.Text = shortSkip and "Skip" or "Skip tutorial"
	UI.SkipLink.Size = UDim2.fromOffset(skipW, 34)
	UI.SkipUnderline.Size = UDim2.fromOffset(math.ceil(textWidth(UI.SkipLink.Text, cap, "Label")), 2) -- (a crisp lip: 2 px)
	UI.Next.Size = UDim2.fromOffset(math.min(K.NEXT_W, footerW - skipW - K.GAP), K.BUTTON_H)
	-- and the skip confirmation: smaller buttons first, then the short question
	local confirmW = K.CONFIRM_W
	if footerW - (2 * confirmW + 12) < K.QUESTION_MIN then
		confirmW = K.CONFIRM_SHORT_W
	end
	if footerW - (2 * confirmW + 12) < K.QUESTION_SHORT_MIN then
		confirmW = K.CONFIRM_TIGHT_W
	end
	local questionW = footerW - (2 * confirmW + 12)
	UI.ConfirmYes.Size = UDim2.fromOffset(confirmW, 40)
	UI.ConfirmYes.Position = UDim2.new(1, -(confirmW + 8), 0.5, 0)
	UI.ConfirmStay.Size = UDim2.fromOffset(confirmW, 40)
	UI.ConfirmQuestion.Size = UDim2.new(0, questionW, 1, 0)
	UI.ConfirmQuestion.Text = questionW >= K.QUESTION_MIN and "Skip the tutorial?" or "Skip?"
end

local function layout()
	if not UI.Root then
		return
	end
	local area = guiArea()
	local k = Theme.ScreenFactor()
	S.compactCard = false -- measured with the objective line first (a short screen's opened card may drop it below)
	-- (kit B U9-9) the pixel arrow's cells are whole screen px. (U9-9 look 2) Its 2 px cells are the screen's icon pixel (a
	-- 2 px icon cell drawn at k lands on round(2k) whole screen px, never under 2; PixelCrisp.Px): its scale is that / 2
	-- (the arrow drew on 4 px cells, twice as coarse as the paw beside it)
	local ps = math.max(2, math.floor(2 * k + 0.5)) / 2
	if UI.PointerScale and UI.PointerScale.Scale ~= ps then
		UI.PointerScale.Scale = ps
	end
	local edge = UserInputService.TouchEnabled and K.TOUCH_EDGE or K.EDGE
	local inset = topInset()
	local screenH = area.Y + inset
	local midX0 = area.X * (0.5 - K.MIDDLE)
	local midY0 = screenH * (0.5 - K.MIDDLE) - inset
	local midY1 = screenH * (0.5 + K.MIDDLE) - inset
	local hud = hudBounds(area)
	local column = menuRect()
	-- the portrait pokes PORTRAIT_Y above the card: the card starts that much lower. (U9-9 look 2) At the screen's top
	-- edge the portrait and the name plank that ride the card's top edge may use the edge margin (down to POP_EDGE from
	-- the top): the card's body stays as high as it was before the plank (a landscape phone's opened card kept clear of
	-- the thumbstick's zone); under a top-left panel they keep the whole gap
	local cardTop0 = math.max(edge, K.POP_EDGE - K.PORTRAIT_Y * k)
	local top = cardTop0
	-- (kit-b backlog item 8) the top-left panel (a match / party panel) casts its hard shadow right and down: GAP of air
	-- past it (GAP off its box left 1.6 - 2.4 px of ink, 0 px at 932 x 430 / 960 x 540)
	local panelGap = (K.GAP + K.SHADOW) * k
	if hud.TopLeftBottom > 0 then
		top = math.max(edge, hud.TopLeftBottom + panelGap) - K.PORTRAIT_Y * k
	end
	-- the HUD's bottom-left block (vitals card / currency stack) is a hard limit for the bubble and the card
	local bottomLimit = math.min(area.Y - edge, hud.BottomLeftTop - K.GAP * k)

	-- on a Menu step the card / bubble also keeps clear of the pointer arrow's spot right of the target tile
	-- (otherwise the arrow would have to sit on Nimbus, or on a neighbouring tile of the phone grid)
	local target = nil
	local st = S.state
	if st and not st.Done and st.Target and st.Target.Kind == "Menu" and not inMatch() and M.button and M.button.Parent then
		local owner = M.button:FindFirstAncestorOfClass("ScreenGui")
		if owner and shownIn(M.button, owner) and M.button.AbsoluteSize.X > 0 then
			target = rectOf(M.button, insetShift(owner))
		end
	end

	local function leftFor(t, h)
		local l = edge
		if column and t < column.y1 + K.GAP * k and t + h > column.y0 - K.GAP * k then
			l = math.max(edge, column.x1 + K.GAP * k)
		end
		if target and t < target.y1 + K.GAP * k and t + h > target.y0 - K.GAP * k then
			l = math.max(l, target.x1 + K.POINTER_ROOM * math.max(k, ps))
		end
		return l
	end

	-- expanded card: as wide as allowed, never into the screen middle, never under the bottom-left HUD
	local width = K.PANEL_W
	local h = panelHeight(width) * k
	local left = leftFor(top, h)
	local maxW = math.floor((area.X - left - edge) / k)
	if width > maxW then
		width = maxW
		h = panelHeight(width) * k
		left = leftFor(top, h)
	end
	if left + width * k > midX0 and top + h > midY0 and top < midY1 then
		width = math.floor((midX0 - left) / k)
		h = panelHeight(math.max(width, K.PANEL_MIN_W)) * k
		left = leftFor(top, h)
	end
	local fits = width >= K.PANEL_MIN_W and top + h <= bottomLimit
	width = math.max(width, K.PANEL_MIN_W)
	S.autoCollapse = not fits

	-- A card the player opened (or the finale) that does not fit there. In the plain lobby nothing can hurt the
	-- player and the hotbar is idle, so the card the player asked for may cover the vitals card (and, as a last
	-- resort, the idle hotbar) and reach towards the middle like any window the player opens. With a party panel up
	-- (a match is about to start) the vitals card / currency pills and the hotbar are hard limits wherever the card
	-- goes (beside the panel too). It never covers Roblox's thumbstick, the touch buttons, the menu or the token pill
	-- and never leaves the screen, so its text, Next button and Skip link are always reachable. In a match: the bubble.
	local relaxed = nil
	if not fits and not inMatch() then
		local inputs = touchButtonRects()
		inputs[#inputs + 1] = thumbstickRect(area)
		local bar = hotbarRect()
		local hard = {} -- the vitals block + the hotbar while a party panel is up
		if hud.TopLeftBottom > 0 then
			for _, r in ipairs(bottomLeftRects()) do
				hard[#hard + 1] = r
			end
			hard[#hard + 1] = bar
		end
		local positions = { { Top = top, Left = nil } }
		if hud.TopLeftRight > 0 then
			-- beside the top-left panel (party panel) at the top edge
			positions[#positions + 1] = { Top = cardTop0, Left = hud.TopLeftRight + panelGap }
		end
		if hud.TopRightBottom > 0 then
			-- below the HUD's top-right block (the currency strips) when they leave the top too narrow
			positions[#positions + 1] = { Top = hud.TopRightBottom + K.GAP * k - K.PORTRAIT_Y * k, Left = nil }
		end
		-- (kit-b backlog item 6: on 360 x 640 / 384 x 640 the card could not open at any step, 375 x 667 at 18 of 21, so a
		-- tap did nothing and the tutorial could not pass step 1: beside the wallet strip and the Gift tile the top row is
		-- under PANEL_MIN_W, and under them the card has 160 - 180 px above RUN) a portrait phone's spot under the menu
		-- column, its right edge GAP of air left of the touch keys past its shadow: down to Roblox's thumbstick (it may lie
		-- over the vitals card, which steps aside - syncVitals - as for any card the player opens in the lobby)
		local reach = area.Y > area.X and columnReach() or nil
		if reach then
			local keysX = nil
			for _, r in ipairs(touchButtonRects()) do
				keysX = math.min(keysX or r.x0, r.x0)
			end
			positions[#positions + 1] = {
				Top = reach.y1 + (K.GAP + K.SHADOW) * k - K.PORTRAIT_Y * k,
				Left = nil,
				Right = keysX and (keysX - (K.GAP + K.SHADOW) * k) or nil,
			}
		end
		local function try(pos, avoidBar, compact, lastResort)
			S.compactCard = compact
			local t = pos.Top
			local l = pos.Left or leftFor(t, area.Y)
			local rightLimit = area.X - edge
			if hud.TopRightLeft > 0 and t < hud.TopRightBottom + K.GAP * k then
				rightLimit = math.min(rightLimit, hud.TopRightLeft - K.GAP * k)
			end
			if pos.Right then
				rightLimit = math.min(rightLimit, pos.Right)
			end
			local w2 = math.min(K.PANEL_W, math.floor((rightLimit - l) / k))
			-- (an in-place last resort may still be PANEL_MIN_W wide at 0.7: its search below)
			if w2 < K.PANEL_MIN_W and not (lastResort == "inPlace" and (rightLimit - l) / 0.7 >= K.PANEL_MIN_W) then
				return nil
			end
			local designH2 = panelHeight(w2)
			local h2 = designH2 * k
			if not pos.Left then
				l = leftFor(t, h2)
			end
			local x1 = l + w2 * k
			local floorY = area.Y - edge
			-- (kit-b backlog item 6) the touch keys and the thumbstick: GAP of air off the card's ink, its shadow included
			-- (box to box, the shadow lay 1 px into RUN at 375 x 667 steps 7 / 11 / 14)
			local s = K.SHADOW * k
			for _, r in pairs(inputs) do
				if l < r.x1 and x1 + s + K.GAP * k > r.x0 then
					floorY = math.min(floorY, r.y0 - K.GAP * k - s)
				end
			end
			for _, r in pairs(hard) do
				if l < r.x1 and x1 > r.x0 then
					floorY = math.min(floorY, r.y0 - K.GAP * k)
				end
			end
			if avoidBar and bar and l < bar.x1 and x1 > bar.x0 then
				floorY = math.min(floorY, bar.y0 - K.GAP * k)
			end
			if not lastResort and t + h2 <= floorY then
				return { Width = w2, Left = l, Top = t, H = h2, Scale = k, Compact = compact }
			elseif lastResort == "inPlace" then
				-- (kit-b backlog item 6) shrunk just enough (never below 0.7) to fit where it stands, or not here: a card
				-- shrunk to s may be (rightLimit - l) / s design px wide, its words on fewer lines, so a few widths are
				-- tried and the largest scale that fits both ways wins
				local best = nil
				for _, sTry in ipairs({ k, (k + 0.7) / 2, 0.7 }) do
					local w3 = math.min(K.PANEL_W, math.floor((rightLimit - l) / sTry))
					if w3 >= K.PANEL_MIN_W then
						local designH3 = panelHeight(w3)
						local fit = math.min(k, (floorY - t) / designH3, (rightLimit - l) / w3)
						if fit >= 0.7 and (best == nil or fit > best.Scale) then
							best = { Width = w3, Left = l, Top = t, H = designH3 * fit, Scale = fit, Compact = compact }
						end
					end
				end
				return best
			elseif lastResort then
				-- shrink just enough (never below 0.7: body text 14 px) to keep the card on screen
				local fit = math.max(0.7, math.min(k, (floorY - t) / designH2))
				local t2 = math.max(edge, K.POP_EDGE - K.PORTRAIT_Y * fit, math.min(t, floorY - designH2 * fit))
				return { Width = w2, Left = l, Top = t2, H = designH2 * fit, Scale = fit, Compact = compact }
			end
			return nil
		end
		for _, avoidBar in ipairs({ true, false }) do
			for _, pos in ipairs(positions) do
				for _, compact in ipairs({ false, true }) do
					relaxed = relaxed or try(pos, avoidBar, compact, nil)
				end
			end
		end
		if not relaxed and hud.TopLeftBottom <= 0 then
			-- nothing else fits in the plain lobby: the compact card, shrunk just enough (the Next button and the
			-- Skip link must stay reachable). With a party panel up (a short countdown) the bubble waits instead.
			relaxed = try(positions[1], false, true, true)
			-- (kit-b backlog item 6) where the top row is too narrow even for that (a short portrait phone), the first
			-- other spot where the compact card fits shrunk in its place
			for i = 2, #positions do
				relaxed = relaxed or try(positions[i], false, true, "inPlace")
			end
		end
		-- the variant that won decides whether the objective line is shown
		S.compactCard = relaxed ~= nil and relaxed.Compact == true
	end
	S.canOpen = fits or relaxed ~= nil
	S.forcedBubble = not S.canOpen and (S.manual == "expanded" or S.finale == true)
	local folded = collapsed()
	local cardScale = k
	if not fits and relaxed and not folded then
		width, left, top, h, cardScale = relaxed.Width, relaxed.Left, relaxed.Top, relaxed.H, relaxed.Scale
	else
		S.compactCard = false
	end
	if UI.Scale.Scale ~= cardScale then
		UI.Scale.Scale = cardScale
	end

	local designH, bodyH, hintH, titleExtra = panelHeight(width)
	-- (Pitch 2 item 03_tutorial_dock B) folded, the guide is the quest strip (K.STRIP_*): on a portrait phone on the HUD
	-- stack over the vitals card (from its left edge to the RUN / DASH column's right edge, STRIP_DOCK_GAP over it); on
	-- PC and a landscape phone top-left under the top bar (under a top-left panel, else beside it at the top edge), right
	-- of the menu column and short of the top-right stack. Too narrow, with no room, or meeting the arena's side stack: the
	-- portrait chip alone. (look:fix6b major 1) On a portrait phone the strip docks over the whole stack it spans: where
	-- RUN stands higher than the vitals card (360 x 640, 375 x 667, 384 x 640 since O3's 2947a7a moved the card left of
	-- RUN / DASH and below RUN's top) it sits STRIP_DOCK_GAP over RUN (it ran 58 x 22 px over RUN); a strip that would
	-- then meet a key, the menu column, the top-right stack or the top edge folds to the portrait chip
	local stripW, stripChip = K.STRIP_W, false
	local chipAside = false -- ((kitb-matchhud) the landscape chip's spot holds the vitals aside: below)
	if folded then
		local h2 = K.STRIP_H * k
		local chipH = K.STRIP_CHIP * k
		local v = area.Y > area.X and vitalsRect() or nil
		local reach = v and columnReach() or nil -- (look:fix6b2 N1) the menu column with its fold tab's tap pad
		local dockBlocked = false
		-- a touch key round `x0`..`x1` x `t0`..`t1` (STRIP_DOCK_GAP of air, half a px spare), nil when none
		local function keyIn(x0, x1, t0, t1)
			local d = K.STRIP_DOCK_GAP - 0.5
			for _, r in ipairs(touchButtonRects()) do
				if r.x1 > x0 - d and r.x0 < x1 + d and r.y1 > t0 - d and r.y0 < t1 + d then
					return r
				end
			end
			return nil
		end
		if v then
			local right = v.x1
			for _, r in ipairs(touchButtonRects()) do
				if r.x0 >= v.x1 - 4 and r.y0 < v.y1 and r.y1 > v.y0 - K.STRIP_DOCK_GAP - h2 then
					right = math.max(right, r.x1)
				end
			end
			left = v.x0
			stripW = math.min(K.STRIP_W, math.floor((math.min(right, area.X - edge) - left) / k))
			-- the stack's top across the strip's width: the vitals card's, or a key's beside it that stands higher
			local stackTop = v.y0
			for _, r in ipairs(touchButtonRects()) do
				if r.x1 > left and r.x0 < left + stripW * k and r.y0 < v.y1 and r.y1 > v.y0 - K.STRIP_DOCK_GAP - h2 then
					stackTop = math.min(stackTop, r.y0)
				end
			end
			top = stackTop - K.STRIP_DOCK_GAP - h2
			local x1 = left + stripW * k
			local g = K.GAP * k
			-- (look:fix6b2 N1) the column with STRIP_DOCK_GAP of air beyond the strip's own wood edge: GAP's 8 px off its box
			-- left 3.5 px of ink between the strip's edge and the tiles' shadow at 384 x 720 in a 3 player match (0.9 px at
			-- 400 x 720)
			local d = K.STRIP_DOCK_GAP + K.STRIP_EDGE * k - 0.5
			dockBlocked = top < edge or keyIn(left, x1, top, top + h2) ~= nil
				or (reach ~= nil and left < reach.x1 + d and x1 > reach.x0 - d and top < reach.y1 + d and top + h2 > reach.y0 - d)
				or (hud.TopRightLeft > 0 and x1 > hud.TopRightLeft - g and top < hud.TopRightBottom + g)
		else
			-- (kit-b backlog items 7 / 8) STRIP_DOCK_GAP of air past the top-left panel's hard shadow (GAP off its box left
			-- 0 - 2.4 px of ink: 0 at 844 x 390 on the party pad), and past the strip's own wood edge short of the top-right
			-- stack (3.6 px off the wallet strip there); a strip that would meet a touch key folds to the chip
			local dockPanel = K.STRIP_DOCK_GAP + K.SHADOW * k
			top = hud.TopLeftBottom > 0 and (hud.TopLeftBottom + dockPanel) or edge
			left = leftFor(top, h2)
			if top + h2 > bottomLimit and hud.TopLeftRight > 0 then
				top = edge
				left = math.max(hud.TopLeftRight + dockPanel, leftFor(top, h2))
			end
			local rightLimit = area.X - edge
			if hud.TopRightLeft > 0 and top < hud.TopRightBottom + K.GAP * k then
				rightLimit = math.min(rightLimit, hud.TopRightLeft - K.STRIP_DOCK_GAP - K.STRIP_EDGE * k)
			end
			stripW = math.min(K.STRIP_W, math.floor((rightLimit - left) / k))
			dockBlocked = keyIn(left, left + stripW * k, top, top + h2) ~= nil
		end
		local side = arenaSideRect()
		local x1, y1 = left + stripW * k, top + h2
		local g = K.GAP * k
		local meets = side ~= nil and left < side.x1 + g and x1 > side.x0 - g and top < side.y1 + g and y1 > side.y0 - g
		stripChip = stripW < K.STRIP_MIN_W or meets or dockBlocked or (v == nil and y1 > bottomLimit)
		if stripChip then
			-- (look:fix6b2 N1) the chip's spot keeps STRIP_DOCK_GAP of air off every HUD piece round it (the column, the keys,
			-- the vitals block, the top-left panel, each piece of the top-right stack - the wallet strips, the Gift tile, the
			-- boost chips -, the arena's side stack, the screen's edges). (kit-b backlog items 7 / 8) A landscape chip (`wide`)
			-- also keeps it off Roblox's thumbstick and the screen's left and bottom edges, and off the top-left panel as it
			-- stands, past its hard shadow (`gap`: the air, STRIP_DOCK_GAP unless given)
			local d = K.STRIP_DOCK_GAP - 0.5
			local pieces = {}
			local pg = playerGui()
			for _, spec in ipairs({ { "NimbusHud", "TopRight" }, { "NimbusDaily" }, { "NimbusBoosts" } }) do
				local g = pg and pg:FindFirstChild(spec[1])
				local holder = g and g:IsA("ScreenGui") and g.Enabled and (spec[2] and g:FindFirstChild(spec[2]) or g)
				for _, c in ipairs(holder and holder:GetChildren() or {}) do
					local s = c:IsA("GuiObject") and c.AbsoluteSize
					if s and s.X > 0 and s.X < area.X * 0.6 and s.Y < area.Y * 0.6 and shownIn(c, g) then
						pieces[#pieces + 1] = rectOf(c, insetShift(g))
					end
				end
			end
			local wide = {}
			if not v then
				local hudGui = pg and pg:FindFirstChild("NimbusHud")
				local block = hudGui and hudGui:IsA("ScreenGui") and hudGui.Enabled and hudGui:FindFirstChild("TopLeft")
				local s = K.SHADOW * k
				for _, c in ipairs(block and block:GetChildren() or {}) do
					if c:IsA("GuiObject") and c.AbsoluteSize.X > 0 and shownIn(c, hudGui) then
						local r = rectOf(c, insetShift(hudGui))
						wide[#wide + 1] = { x0 = r.x0, y0 = r.y0, x1 = r.x1 + s, y1 = r.y1 + s }
					end
				end
				wide[#wide + 1] = thumbstickRect(area)
			end
			local blocks = bottomLeftRects()
			local function clear(l, t, col, gap)
				local m = gap and (gap - 0.5) or d
				local function meets(r)
					return r ~= nil and r.x1 > l - m and r.x0 < l + chipH + m and r.y1 > t - m and r.y0 < t + chipH + m
				end
				if t < edge or l + chipH > area.X - edge or meets(col) or meets(arenaSideRect()) then
					return false
				end
				if not v and (l < edge or t + chipH > area.Y - edge) then
					return false
				end
				for _, list in ipairs({ touchButtonRects(), blocks, pieces, wide }) do
					for _, r in pairs(list) do
						if meets(r) then
							return false
						end
					end
				end
				return not v or not (hud.TopLeftBottom > 0 and t < hud.TopLeftBottom + d and (hud.TopLeftRight <= 0 or l < hud.TopLeftRight + d))
			end
			if v then
				-- on the stack still, STRIP_DOCK_GAP over the vitals card; (look:fix6b major 1) and over a key in its own
				-- column, should one stand there
				local function spot(l)
					local t = v.y0 - K.STRIP_DOCK_GAP - chipH
					local r = keyIn(l, l + chipH, t, t + chipH)
					return r and (r.y0 - K.STRIP_DOCK_GAP - chipH) or t
				end
				-- (look:fix6b2 N1) at the card's left edge, else right of the menu column and its fold tab's tap pad
				-- (columnReach), else right of its tiles (menuRect; the tap pad, over the chip, takes a tap there): the
				-- first clear spot. In a 3 or 4 player match and on a full party pad the panel pushes the column down to the
				-- card: the chip, checked against the keys only, lay under its Home tile (20 - 26.5 px). Where no spot is
				-- clear it keeps the first
				local tiles = menuRect()
				top = spot(left)
				for _, s in ipairs({ { left, reach }, { reach and reach.x1 + K.STRIP_DOCK_GAP, reach }, { tiles and tiles.x1 + K.STRIP_DOCK_GAP, tiles } }) do
					local l = s[1] and math.max(left, s[1])
					local t = l and spot(l)
					if l and clear(l, t, s[2]) then
						left, top = l, t
						break
					end
				end
			else
				if top + chipH > bottomLimit then
					top = math.max(edge, bottomLimit - chipH)
					left = leftFor(top, chipH)
				end
				-- (kit-b backlog items 7 / 8: beside a party / match panel the chip lay on the wallet strip - 640 x 360
				-- 19.6 px - and, at 568 x 320, where RUN stands at the top right beside the panel, 40 px over RUN: nothing
				-- checked it against the top-right stack or the keys) its spot, else under the top-left panel, else under the
				-- menu column, each right of Roblox's thumbstick where it meets it: the first clear spot, with STRIP_DOCK_GAP
				-- of air, else (the smallest phones: 568 x 320 has 59 px between the stick and the panel) with MIN_AIR.
				-- Where none is clear it keeps the first
				local dockPanel = K.STRIP_DOCK_GAP + K.SHADOW * k
				local col = columnReach()
				local stick = thumbstickRect(area)
				local spots = { { left, top } }
				if hud.TopLeftBottom > 0 then
					local t = hud.TopLeftBottom + dockPanel
					spots[#spots + 1] = { leftFor(t, chipH), t }
				end
				if col then
					local t = col.y1 + dockPanel
					spots[#spots + 1] = { leftFor(t, chipH), t }
				end
				local function search()
					for _, gap in ipairs({ K.STRIP_DOCK_GAP, K.MIN_AIR }) do
						for _, s in ipairs(spots) do
							local l, t = s[1], s[2]
							if stick and stick.x1 > l - gap and stick.x0 < l + chipH + gap and stick.y1 > t - gap and stick.y0 < t + chipH + gap then
								l = stick.x1 + gap
							end
							if clear(l, t, col, gap) then
								left, top = l, t
								return true
							end
						end
					end
					return false
				end
				-- (kitb-matchhud, the owner's pick A "Slim bar") at 568 x 320 in a solo / duo match the slim bar takes the row
				-- under the menu column the chip had, and no other spot is clear (the chip lay 40 px over RUN): where one is
				-- clear but for the vitals, the chip takes it and the vitals step aside while it shows there (the panel's gold
				-- 'you' chip shows the HP), as for the card the player opens (syncVitals). While it holds them aside their slot
				-- counts as if they showed, so the chip's spot never flips with them
				local slot = S.chipAside and vitalsSlot() or nil
				if slot then
					blocks[#blocks + 1] = slot
				end
				local found = search()
				if not found and (slot or vitalsRect()) then
					blocks = bottomLeftRects(true)
					found = search()
					chipAside = found
				end
			end
		end
	end
	S.stripChip = folded and stripChip
	S.chipAside = folded and stripChip and chipAside
	applyGeometry(width, designH, bodyH, hintH, titleExtra)
	if folded then
		placeStrip(stripW, stripChip)
		UI.Root.Size = stripChip and UDim2.fromOffset(K.STRIP_CHIP, K.STRIP_CHIP) or UDim2.fromOffset(stripW, K.STRIP_H)
	else
		UI.Strip.Visible = false
		UI.Portrait.Position = UDim2.fromOffset(K.PAD, K.PORTRAIT_Y)
		UI.Portrait.Size = UDim2.fromOffset(K.PORTRAIT, K.PORTRAIT)
	end
	S.portraitBase = UI.Portrait.Position
	local crisp = mod("PixelCrisp")
	if crisp then
		crisp.Refresh(UI.Root) -- (kit B U9-9) icons and edges back on whole screen px at the card's scale
	end
	UI.Main.Visible = not folded

	local goal = UDim2.fromOffset(math.floor(left + 0.5), math.floor(top + 0.5))
	if folded or not S.shown then
		syncVitals(nil, S.shown and S.chipAside)
	else
		local gx, gy = goal.X.Offset, goal.Y.Offset
		syncVitals({ x0 = gx, y0 = gy, x1 = gx + width * cardScale, y1 = gy + designH * cardScale })
	end
	if S.placed ~= goal then
		S.placed = goal
		if UI.Root.Visible and S.hasPlaced then
			tween(UI.Root, 0.25, { Position = goal })
		else
			UI.Root.Position = goal
		end
		S.hasPlaced = true
	end

	M.side = nil -- the menu pointer re-chooses its side around the new layout

	-- floating sign above the world arrow follows the readability rule too
	if W.labelGui then
		W.labelGui.Size = UDim2.fromOffset(math.floor(K.SIGN_W * k), math.floor(K.SIGN_H * k))
		if W.signScale then
			W.signScale.Scale = k
		end
	end
end

----------------------------------------------------------------------
-- Panel: building
----------------------------------------------------------------------
local function buildPortrait(parent)
	-- (kit B U9-9) a square sky well in a wood frame (the NPC dialog's portrait): a little pixel cloud in its corner,
	-- Nimbus in front of it, the ground lip over Nimbus' feet
	local holder = box("Portrait", {
		Size = UDim2.fromOffset(K.PORTRAIT, K.PORTRAIT),
		Position = UDim2.fromOffset(K.PAD, K.PORTRAIT_Y),
		ZIndex = 2,
	}, parent)
	local f = K.PORTRAIT_FRAME
	local frame = box("Frame", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Wood, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, holder)
	frame:SetAttribute("SignKit", "Frame")
	local sky = box("Sky", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Sky,
		Position = UDim2.fromOffset(f, f),
		Size = UDim2.new(1, -2 * f, 1, -2 * f),
		ZIndex = 2,
	}, frame)
	-- (U9-9 look 2) the portrait, its frame and the sky in it on whole px on all four sides (crispBox): the wood frame a
	-- whole px wide on every side at any card scale (2.4 px drew soft)
	crispBox(holder)
	crispBox(frame)
	crispBox(sky)
	crispIcon(sky, "cloud", 18, SIGN.Stone, {
		Name = "Cloud",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(5, 4),
		ZIndex = 2,
	})
	local view = make("ViewportFrame", "Nimbus", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(f, f),
		Size = UDim2.new(1, -2 * f, 1, -2 * f),
		Ambient = rgb(186, 192, 218),
		LightColor = rgb(255, 246, 232),
		LightDirection = Vector3.new(-0.4, -0.8, 1),
		ZIndex = 2,
	}, holder)
	crispBox(box("Ground", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.SkyLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, f, 1, -f),
		Size = UDim2.new(1, -2 * f, 0, K.PORTRAIT_LIP),
		ZIndex = 2,
	}, holder))
	local toggle = make("TextButton", "Toggle", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, holder)
	-- (Pitch 2 item 03_tutorial_dock B: the folded guide is the quest strip, buildStrip; the "!" badge and the "Tap me!"
	-- tag of the lone bubble are gone)
	UI.Portrait, UI.View, UI.Toggle = holder, view, toggle
end

-- (Pitch 2 item 03_tutorial_dock B) the folded guide: the quest strip (K.STRIP_*), a stone strip in its wood edge and lip
-- holding the step's title, "3/21", the steps row (layoutStripSteps) and the "+" block; Nimbus' portrait sits on its left
-- end as the chip (layout moves it there while the card is folded)
local function buildStrip(parent)
	local strip = box("QuestStrip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Size = UDim2.fromOffset(K.STRIP_W, K.STRIP_H),
		Visible = false,
		Active = true, -- (a tap on the strip never falls through to the world)
		ZIndex = 1,
	}, parent)
	edge(strip, SIGN.Wood, K.STRIP_EDGE)
	lipOf(strip, SIGN.StoneLip, K.STRIP_LIP)
	crispBox(strip)
	UI.Strip = strip
	UI.StripTitle = label(strip, "QuestTitle", "", "Heading", K.STRIP_TITLE, SIGN.Text, {
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		ZIndex = 2,
	})
	UI.StripCount = label(strip, "QuestCount", "", "Heading", K.STRIP_COUNT, SIGN.Text, {
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = 2,
	})
	-- the steps: a holder undoing the strip's scale (Unscale), so its chapter blocks and cells are whole screen px
	UI.StripSteps = box("QuestSteps", { Size = UDim2.fromOffset(200, K.STRIP_CELL_H), ZIndex = 2 }, strip)
	make("UIScale", "Unscale", { Scale = 1 }, UI.StripSteps)
	crispBox(UI.StripSteps)
	-- the "+" block: a stone tag in its wood edge with the pixel plus; it opens the card
	local open = make("TextButton", "QuestOpen", {
		BackgroundColor3 = SIGN.Tile,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.fromOffset(K.STRIP_OPEN, K.STRIP_OPEN),
		ZIndex = 2,
	}, strip)
	edge(open, SIGN.Wood, K.EDGE_PX)
	lipOf(open, SIGN.StoneLip, K.TAG_LIP)
	crispIcon(open, "plus", K.STRIP_PLUS, SIGN.Text, { Name = "Plus", Position = UDim2.new(0.5, 0, 0.5, -1), ZIndex = 2 })
	crispBox(open)
	UI.StripOpen = open
end

local function buildPixelArrow(parent)
	-- a chunky left-pointing pixel arrow: (kit B U9-9) a brown outline, the gold's three bands and a stone glint. (U9-9 look
	-- 2) Drawn on the icons' 2 px cell (34 x 22 cells, the same 68 x 44 silhouette): one pixel size on the screen, its
	-- head's steps as fine as the paw's beside it (on 4 px cells they were twice as coarse)
	local cols, rows, cell = 34, 22, 2
	local function inside(r, c)
		if r < 0 or r >= rows or c < 0 or c >= cols then
			return false
		end
		local head = c <= 15 and c >= math.abs(r - 10.5) - 0.5
		local shaft = r >= 6 and r <= 15 and c >= 12
		return head or shaft
	end
	local glint = { ["8_7"] = true, ["9_6"] = true } -- two stone cells along the head's upper edge
	local palette = { o = SIGN.Text, L = SIGN.GoldLight, G = SIGN.Gold, D = SIGN.GoldLip, W = SIGN.Stone }
	for r = 0, rows - 1 do
		local runKey, runStart = nil, 0
		for c = 0, cols do
			local key = nil
			if c < cols and inside(r, c) then
				local edgeCell = not (inside(r - 1, c) and inside(r + 1, c) and inside(r, c - 1) and inside(r, c + 1))
				if edgeCell then
					key = "o"
				elseif glint[r .. "_" .. c] then
					key = "W"
				elseif r <= 9 then
					key = "L"
				elseif r <= 11 then
					key = "G"
				else
					key = "D"
				end
			end
			if key ~= runKey then
				if runKey then
					box("Px" .. r .. "_" .. runStart, {
						BackgroundTransparency = 0,
						BackgroundColor3 = palette[runKey],
						Position = UDim2.fromOffset(runStart * cell, r * cell),
						Size = UDim2.fromOffset((c - runStart) * cell, cell),
					}, parent)
				end
				runKey, runStart = key, c
			end
		end
	end
	parent.Size = UDim2.fromOffset(cols * cell, rows * cell)
end

local function buildPointer()
	local pg = playerGui()
	local gui = make("ScreenGui", "NimbusTutorialPointer", {
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.POINTER_ORDER,
	}, nil)
	-- (U9-9 look 2) no ring: the pointed tile wears the kit's Selected look itself (MenuController.SetPointed: the gold face
	-- and its lip, the pitch's .sb.on), as the rail's tiles lie edge to edge and a ring round one covered the next ("ndex");
	-- the pixel arrow points at it
	local arrow = box("Arrow", { AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, Active = false }, gui)
	buildPixelArrow(arrow)
	UI.PointerScale = make("UIScale", "ReadScale", { Scale = 1 }, arrow)
	UI.PointerGui, UI.Arrow = gui, arrow
	gui.Parent = pg
end

local function onNextPressed()
	if S.typing then
		S.typeShown = S.typeTotal -- first press reveals the whole line
		return
	end
	if os.clock() < (S.nextLockUntil or 0) then
		return
	end
	if fireEvent("Next") then
		S.nextLockUntil = os.clock() + K.NEXT_LOCK
		setDisabled(UI.Next, true)
	end
end

local function setConfirming(on)
	S.confirming = on and true or false
	UI.Confirm.Visible = S.confirming
	UI.SkipLink.Visible = not S.confirming
	UI.Next.Visible = not S.confirming and nextShown(S.state)
end

local function buildPanel()
	local pg = playerGui()
	local gui = make("ScreenGui", "NimbusTutorial", {
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.PANEL_ORDER,
	}, nil)
	UI.Gui = gui
	local root = box("TutorialPanel", { Size = UDim2.fromOffset(K.PANEL_W, 260), Visible = false }, gui)
	UI.Root = root
	UI.Scale = make("UIScale", "ReadScale", { Scale = 1 }, root)
	local slide = box("Slide", { Size = UDim2.fromScale(1, 1) }, root)
	UI.Slide = slide
	local crisp = mod("PixelCrisp")
	if crisp then
		crisp.Root(slide) -- (U9-9 look) it slides in; the card's blocks sit on whole px of it at rest
	end

	local main = box("Main", { Size = UDim2.fromScale(1, 1), ZIndex = 1 }, slide)
	UI.Main = main
	-- (kit B U9-9) the card: the wood frame round the stone body, its lip along the bottom (the NPC dialog's card)
	local card = box("Card", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Wood,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 3,
		Active = true, -- clicks on the card never fall through to the world
	}, main)
	card:SetAttribute("SignKit", "Frame")
	local stone = box("Stone", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME),
		ZIndex = 3,
	}, card)
	stone:SetAttribute("SignKit", "Body")
	lipOf(stone, SIGN.StoneLip, K.CARD_LIP)
	-- (U9-9 look 2) the card and the stone in it on whole px on all four sides: the wood frame a whole px wide everywhere
	crispBox(card)
	crispBox(stone)
	-- (Pitch 2 F0, finish pass A) the frame's light, the card's shadow, the stone sunk under the frame with its carved rim
	local SK = mod("SignKit")
	if SK and SK.FinishFrame then
		SK.FinishFrame(card, { Body = stone })
	end

	-- header: the name plank, step title, block row, counter tag, fold block (kit B U9-9: brown on the stone body)
	local header = box("Header", { Size = UDim2.new(1, 0, 0, K.HEADER_H), ZIndex = 5 }, main)
	local x0 = K.PAD + K.PORTRAIT + 12
	-- (U9-9 look 2) the speaker's name on the NPC dialog's plank (one header language for the two speaker cards): a navy
	-- plank in a gold-lip edge with its navy lip and two brass rivets, riding the card's top edge from the header's x0, the
	-- name a plain Section title in gold (it was brown words on the stone, the plain one of the family)
	local nameTab = box("NameTab", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Navy,
		Position = UDim2.fromOffset(x0, K.TAB_Y),
		Size = UDim2.fromOffset(160, K.TAB_H),
		ZIndex = 6,
	}, main)
	edge(nameTab, SIGN.GoldLip, 3)
	lipOf(nameTab, SIGN.NavyLip, K.NAME_LIP)
	local crispMod = mod("PixelCrisp")
	for _, side in ipairs({ { "RivetL", 0, 6 }, { "RivetR", 1, -10 } }) do
		local rivet = box(side[1], {
			BackgroundTransparency = 0,
			BackgroundColor3 = SIGN.Brass,
			Position = UDim2.new(side[2], side[3], 0.5, -4),
			Size = UDim2.fromOffset(4, 4),
			ZIndex = 7,
		}, nameTab)
		if crispMod then
			crispMod.Adopt(rivet, 4) -- a whole-px square on a whole px
		end
	end
	UI.NameTab = crispBox(nameTab)
	UI.Name = label(nameTab, "GuideName", "Nimbus", "Title", K.TAB_TEXT, SIGN.Gold, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, -2),
		Size = UDim2.new(1, -2 * (K.TAB_INSET - K.NAME_SLACK), 1, -(6 + K.NAME_LIP)),
		TextXAlignment = Enum.TextXAlignment.Center,
		-- (2026-11-28 playtest C42 review: the offline fit cannot see the engine's own measure, which drew the name about
		-- 3 px wider than its box) never cut: the plank is sized to the name, so a name the engine draws a little wider
		-- stays on the plank's insets instead of reading "NIMB..."
		TextTruncate = Enum.TextTruncate.None,
		ZIndex = 7,
	})
	UI.Name.TextScaled = true -- (U9-9 look) under UI.NameFit (applyGeometry): never cut to "NIMB..."
	UI.NameFit = make("UITextSizeConstraint", "Fit", { MinTextSize = K.NAME_MIN, MaxTextSize = K.TAB_TEXT }, UI.Name)
	Theme.StyleTitle(UI.Name, "Section")
	UI.StepTitle = label(header, "StepTitle", "", "Heading", K.TITLE_SIZE, SIGN.Text, {
		Position = UDim2.fromOffset(x0, 46),
		Size = UDim2.new(1, -(x0 + K.PAD), 0, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	-- (U9-9 look) the step progress: one SignKit block row in whole screen px (layoutProgress), its holder undoing the
	-- card's scale (Unscale) and its top-left on a whole px
	UI.Progress = box("Progress", { Position = UDim2.fromOffset(x0, 76), Size = UDim2.fromOffset(200, K.PROG_H) }, header)
	make("UIScale", "Unscale", { Scale = 1 }, UI.Progress)
	if crisp then
		crisp.Box(UI.Progress)
	end
	-- the counter: a stone tag in its wood edge, brown words; (U9-9 look 2) under the name plank's row, left of the fold
	local pill = box("Counter", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Tile,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -(K.PAD + K.FOLD_W + 6), 0, K.TAG_Y),
		Size = UDim2.fromOffset(K.COUNTER_W, K.TAG_H),
	}, header)
	edge(pill, SIGN.Wood, K.EDGE_PX)
	lipOf(pill, SIGN.StoneLip, K.TAG_LIP)
	UI.Counter = label(pill, "Text", "Step 1/1", "Heading", K.CAPTION_SIZE, SIGN.Text, { Size = UDim2.new(1, 0, 1, -K.TAG_LIP) })
	UI.CounterPill = pill
	-- the fold: a stone block with the pixel minus
	local fold = make("TextButton", "Fold", {
		BackgroundColor3 = SIGN.Tile,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -K.PAD, 0, K.TAG_Y),
		Size = UDim2.fromOffset(K.FOLD_W, K.TAG_H),
	}, header)
	edge(fold, SIGN.Wood, K.EDGE_PX)
	lipOf(fold, SIGN.StoneLip, K.TAG_LIP)
	crispIcon(fold, "minus", 18, SIGN.Text, { Name = "Bar", Position = UDim2.new(0.5, 0, 0.5, -1) })
	UI.Fold = fold

	-- text well: a pale tile in a wood edge
	local well = box("Well", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Tile,
		Position = UDim2.fromOffset(K.PAD, K.HEADER_H),
		Size = UDim2.new(1, -2 * K.PAD, 1, -(K.HEADER_H + K.FOOT_PAD)),
		ZIndex = 6,
	}, main)
	edge(well, SIGN.Wood, K.EDGE_PX)
	UI.Well = well
	UI.Body = label(well, "Body", "", "Body", K.BODY_SIZE, SIGN.Text, {
		Position = UDim2.fromOffset(K.WELL_PAD, 10),
		Size = UDim2.new(1, -2 * K.WELL_PAD, 0, 60),
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
	})
	UI.TypeSkip = make("TextButton", "TypeSkip", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Position = UI.Body.Position,
		Size = UI.Body.Size,
	}, well)
	UI.Hint = label(well, "Hint", "", "Label", K.CAPTION_SIZE, SIGN.Navy, { -- (kit B U9-9) the objective in navy ink
		Position = UDim2.fromOffset(K.WELL_PAD, 70),
		Size = UDim2.new(1, -2 * K.WELL_PAD, 0, K.HINT_H),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true, -- (U9-9 look) a second line (hintHeight), never cut
	})

	local footer = box("Footer", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, K.WELL_PAD, 1, -6),
		Size = UDim2.new(1, -2 * K.WELL_PAD, 0, K.FOOTER_H),
		ZIndex = 2,
	}, well)
	UI.Footer = footer
	local skip = make("TextButton", "SkipLink", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(132, 34),
		Text = "Skip tutorial",
		TextXAlignment = Enum.TextXAlignment.Left,
	}, footer)
	Theme.Style(skip, "Label", { Size = K.CAPTION_SIZE, Color = SIGN.TextMuted })
	-- (U9-9 look 2) a 2 px line on whole px at any card scale (it drew 1.6 px): a crisp lip on a crisp origin
	UI.SkipUnderline = box("Underline", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.TextMuted,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -3),
		Size = UDim2.new(0, 104, 0, 2),
	}, skip)
	if crispMod then
		UI.SkipUnderline:SetAttribute("CrispLipWhole", true) -- (its width a whole px as well)
		crispMod.Lip(UI.SkipUnderline, 2)
		crispMod.Box(UI.SkipUnderline)
	end
	UI.SkipLink = skip
	UI.Next = button({
		Name = "Next",
		Text = "Next",
		Style = "Green",
		TextSize = K.BUTTON_SIZE,
		Size = UDim2.fromOffset(K.NEXT_W, K.BUTTON_H),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Callback = onNextPressed,
		Parent = footer,
	})

	local confirm = box("Confirm", { Size = UDim2.fromScale(1, 1), Visible = false }, footer)
	UI.Confirm = confirm
	UI.ConfirmQuestion = label(confirm, "Question", "Skip the tutorial?", "Body", 19, SIGN.Text, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(1, -196, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
	})
	UI.ConfirmYes = button({
		Name = "ConfirmSkip",
		Text = "Skip",
		Style = "Red",
		TextSize = 20,
		Size = UDim2.fromOffset(92, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -100, 0.5, 0),
		Callback = function()
			if fireEvent("Skip") then
				S.skipLockUntil = os.clock() + K.SKIP_LOCK
				setDisabled(UI.ConfirmYes, true)
			end
		end,
		Parent = confirm,
	})
	UI.ConfirmStay = button({
		Name = "ConfirmStay",
		Text = "Stay",
		Style = "Blue",
		TextSize = 20,
		Size = UDim2.fromOffset(92, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Callback = function()
			setConfirming(false)
		end,
		Parent = confirm,
	})

	-- (U9-9 look) the tags, the well and the planks on whole screen px of the card at any scale: their top-left (Box), and
	-- a CloudUI plank's wood edge and lip (2.1 / 2.4 px drew uneven)
	if crisp then
		for _, block in ipairs({ UI.CounterPill, UI.Fold, UI.Well, UI.Next, UI.ConfirmYes, UI.ConfirmStay }) do
			if block ~= UI.CounterPill and block ~= UI.Fold and block ~= UI.Well then
				for _, c in ipairs(block:GetChildren()) do
					if c:IsA("UIStroke") and c:GetAttribute("CrispEdge") == nil then
						crisp.Edge(c, c.Thickness)
					elseif c.Name == "Lip" and c:IsA("GuiObject") and c:GetAttribute("CrispLip") == nil then
						crisp.Lip(c, c.Size.Y.Offset)
					end
				end
			end
			crisp.Box(block)
		end
	end

	buildPortrait(slide)
	buildStrip(slide)

	-- confetti layer (gui pixels, no UIScale)
	UI.Fx = box("Confetti", { Size = UDim2.fromScale(1, 1), ZIndex = 50, Active = false }, gui)

	-- input
	skip.Activated:Connect(function()
		setConfirming(true)
	end)
	UI.TypeSkip.Activated:Connect(function()
		if S.typing then
			S.typeShown = S.typeTotal
		end
	end)
	UI.Toggle.Activated:Connect(function()
		if collapsed() then
			if S.canOpen == false or S.windowOpen then
				return -- the card has no room right now (a match on a short screen) or a window covers it
			end
			S.manual = "expanded"
		else
			S.manual = "collapsed"
		end
		safe("layout", layout)
	end)
	fold.Activated:Connect(function()
		S.manual = "collapsed"
		safe("layout", layout)
	end)
	-- (Pitch 2 03 B) the quest strip's "+" opens the card, as a tap on the portrait chip does
	UI.StripOpen.Activated:Connect(function()
		if not collapsed() or S.canOpen == false or S.windowOpen then
			return
		end
		S.manual = "expanded"
		safe("layout", layout)
	end)

	gui.Parent = pg
end

----------------------------------------------------------------------
-- Portrait: PetBuilder Cloudy Dragon in the viewport
----------------------------------------------------------------------
local function setupPortraitModel()
	local view = UI.View
	if not view or P.model then
		return
	end
	local Steps = mod("TutorialSteps")
	local guide = Steps and type(Steps.Guide) == "table" and Steps.Guide or {}
	local petId = type(guide.PetId) == "string" and guide.PetId or "cloudy_dragon"
	local PetBuilder = mod("PetBuilder")
	local PetCatalog = mod("PetCatalog")
	local def = nil
	if PetCatalog and type(PetCatalog.Get) == "function" then
		local okDef, found = pcall(PetCatalog.Get, petId)
		if okDef and type(found) == "table" then
			def = found
		end
	end
	local model = nil
	if def and PetBuilder and type(PetBuilder.Build) == "function" then
		local okBuild, built = pcall(PetBuilder.Build, def, { Detail = "High", Scale = 1 })
		if okBuild and typeof(built) == "Instance" then
			model = built
		else
			warnOnce("portrait", "PetBuilder.Build failed: " .. tostring(built))
		end
	end
	if not model then
		-- no pet art available: a friendly cloud glyph instead of an empty bubble
		-- (kit-b U7a) the pitch's pixel cloud; (kit B U9-9) on whole screen px, stone on the sky
		crispIcon(view.Parent, "cloud", 45, SIGN.Stone, { Name = "Fallback", ZIndex = 2 })
		return
	end
	model.Parent = view
	pcall(function()
		model:PivotTo(CFrame.new())
	end)
	P.builder = PetBuilder
	if type(PetBuilder.Animate) == "function" then
		pcall(PetBuilder.Animate, model, 0.3, { Flap = 0.8 })
	end
	local center, height = Vector3.new(0, 1.2, 0), 2.6
	local okBox, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if okBox and cf and size then
		center, height = cf.Position, math.max(0.5, size.Y)
	end
	-- pets face -Z; if this model's eyes sit on +Z, film that side instead
	local sum, count = 0, 0
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and string.find(string.lower(d.Name), "eye", 1, true) then
			sum = sum + (d.Position.Z - center.Z)
			count = count + 1
		end
	end
	if count > 0 and sum / count > 0.05 then
		P.side = 1
		view.LightDirection = Vector3.new(-0.4, -0.8, -1)
	end
	P.model = model
	P.height = height
	P.focus = center + Vector3.new(0, height * 0.1, 0)
	P.dist = (height * 0.62) / math.tan(math.rad(15)) -- the whole head, horns included, and a hint of wings
	P.camera = make("Camera", "PortraitCamera", { FieldOfView = 30 }, view)
	view.CurrentCamera = P.camera
end

local function updatePortrait(dt, t)
	if not P.model or not P.camera then
		return
	end
	P.accum = P.accum + dt
	if P.accum < (collapsed() and K.PORTRAIT_FOLDED_STEP or K.PORTRAIT_STEP) then
		return
	end
	P.accum = 0
	local excited = 0
	if t < P.excitedUntil then
		excited = 1
	elseif S.typing then
		excited = 0.35
	end
	local a = P.yaw + math.sin(t * 0.55) * 0.12
	local bob = math.sin(t * 1.7) * P.height * 0.03
	local focus = P.focus + Vector3.new(0, bob, 0)
	local offset = Vector3.new(math.sin(a) * P.dist, P.dist * 0.1, math.cos(a) * P.dist * P.side)
	P.camera.CFrame = CFrame.lookAt(focus + offset, focus)
	if P.builder and type(P.builder.Animate) == "function" then
		local ok = pcall(P.builder.Animate, P.model, t, { Flap = 0.7 + excited * 1.1, Excited = excited })
		if not ok then
			P.builder = nil
		end
	end
end

----------------------------------------------------------------------
-- Confetti (voxel squares), pooled
----------------------------------------------------------------------
local function burst(big)
	if not UI.Fx or not UI.Portrait then
		return
	end
	local k = Theme.ScreenFactor()
	local origin = UI.Portrait.AbsolutePosition + UI.Portrait.AbsoluteSize * 0.5 - UI.Fx.AbsolutePosition
	local count = big and K.CONFETTI_BIG or K.CONFETTI_SMALL
	for i = 1, count do
		local piece = nil
		for _, p in ipairs(Fx.pool) do
			if not p.alive then
				piece = p
				break
			end
		end
		if not piece then
			if #Fx.pool >= K.CONFETTI_BIG * 2 then
				break
			end
			local frameObj = box("Bit", { BackgroundTransparency = 0, Visible = false }, UI.Fx)
			piece = { frame = frameObj, alive = false }
			table.insert(Fx.pool, piece)
		end
		local angle = -0.25 - math.random() * 2.2 -- up and to the right, away from the screen edge
		local speed = (big and 300 or 230) + math.random() * (big and 340 or 220)
		local px = math.floor((5 + math.random() * 6) * k + 0.5)
		piece.alive = true
		piece.x, piece.y = origin.X, origin.Y
		piece.vx = math.cos(angle) * speed * k + 40 * k
		piece.vy = math.sin(angle) * speed * k
		piece.rot = math.random() * 90
		piece.vr = (math.random() - 0.5) * 720
		piece.age = 0
		piece.life = 1.1 + math.random() * (big and 0.9 or 0.5)
		piece.px = px
		local f = piece.frame
		f.BackgroundColor3 = C.Confetti[(i % #C.Confetti) + 1]
		f.Size = UDim2.fromOffset(px, px)
		f.BackgroundTransparency = 0
		f.Rotation = 0
		f.Position = UDim2.fromOffset(math.floor(piece.x - px / 2 + 0.5), math.floor(piece.y - px / 2 + 0.5))
		f.Visible = true
	end
	Fx.live = 0
	for _, p in ipairs(Fx.pool) do
		if p.alive then
			Fx.live = Fx.live + 1
		end
	end
end

local function updateConfetti(dt)
	if Fx.live <= 0 then
		return
	end
	local k = Theme.ScreenFactor()
	local live = 0
	for _, p in ipairs(Fx.pool) do
		if p.alive then
			p.age = p.age + dt
			if p.age >= p.life then
				p.alive = false
				p.frame.Visible = false
			else
				p.vy = p.vy + K.GRAVITY * k * dt
				p.vx = p.vx * (1 - math.min(0.9, 1.4 * dt))
				p.x = p.x + p.vx * dt
				p.y = p.y + p.vy * dt
				p.rot = p.rot + p.vr * dt
				-- (kit B U9-9) a flat bit that flips (its width follows the turn) on whole screen px, never a rotated square
				local f = p.frame
				local w = math.max(1, math.floor(p.px * math.abs(math.cos(math.rad(p.rot))) + 0.5))
				f.Size = UDim2.fromOffset(w, p.px)
				f.Position = UDim2.fromOffset(math.floor(p.x - w / 2 + 0.5), math.floor(p.y - p.px / 2 + 0.5))
				local fade = (p.age - p.life * 0.65) / (p.life * 0.35)
				if fade > 0 then
					f.BackgroundTransparency = math.min(1, fade)
				end
				live = live + 1
			end
		end
	end
	Fx.live = live
end

-- (audio wave 2) client/SoundFx, lazy; false = unavailable
local soundFxMod = nil
local function playSfx(name)
	if soundFxMod == nil then
		local module = Client:FindFirstChild("SoundFx")
		local ok, mod = false, nil
		if module then
			ok, mod = pcall(require, module)
		end
		soundFxMod = (ok and type(mod) == "table" and type(mod.Play) == "function") and mod or false
	end
	if soundFxMod then
		pcall(soundFxMod.Play, name)
	end
end

local function celebrate(big)
	P.excitedUntil = S.clock + (big and 2.6 or 1.4)
	-- a finished step: TutorialStep; the finale: Reward (its own TutorialChapter take was skipped this wave)
	playSfx(big and "Reward" or "TutorialStep")
	if S.shown then
		safe("burst", burst, big)
	end
	if UI.Portrait then
		-- a happy hop of the portrait (from where layout put it: over the card, or on the quest strip's end)
		local base = S.portraitBase or UDim2.fromOffset(K.PAD, K.PORTRAIT_Y)
		UI.Portrait.Position = base
		local up = tween(UI.Portrait, 0.14, { Position = base + UDim2.fromOffset(0, -10) })
		up.Completed:Connect(function()
			tween(UI.Portrait, 0.32, { Position = base }, Enum.EasingStyle.Bounce)
		end)
	end
end

----------------------------------------------------------------------
-- Panel: content + visibility
----------------------------------------------------------------------
local function setVisibleGraphemes(n)
	if S.noGraphemes then
		if n < 0 then
			UI.Body.Text = S.fullText or ""
		else
			UI.Body.Text = string.sub(S.fullText or "", 1, n)
		end
		return
	end
	local ok = pcall(function()
		UI.Body.MaxVisibleGraphemes = n
	end)
	if not ok then
		S.noGraphemes = true
		setVisibleGraphemes(n)
	end
end

local function startTyping(text)
	S.fullText = text
	UI.Body.Text = text
	S.typeTotal = graphemeCount(text)
	S.typeShown = 0
	S.typeDelay = K.TYPE_DELAY
	S.typing = true
	setVisibleGraphemes(0)
end

local function updateTypewriter(dt)
	if not S.typing then
		return
	end
	if S.typeDelay > 0 then
		S.typeDelay = S.typeDelay - dt
		return
	end
	S.typeShown = S.typeShown + dt * K.TYPE_CPS
	if S.typeShown >= S.typeTotal then
		S.typing = false
		setVisibleGraphemes(-1)
	else
		setVisibleGraphemes(math.floor(S.typeShown))
	end
end

local function hintText()
	local st = S.state
	if not st then
		return ""
	end
	local text = st.Hint or DEFAULT_HINTS[st.CompleteOn] or ""
	if W.active and W.distance then
		if W.distance <= K.TRAIL_HIDE then
			text = text .. "  \194\183  you're here!"
		else
			text = text .. "  \194\183  " .. math.floor(W.distance + 0.5) .. " studs"
		end
	end
	return BULLET .. text
end

-- Fills the panel with the current step (called when the step changes).
local function renderStep()
	local st = S.state
	if not st or not UI.Root then
		return
	end
	UI.StepTitle.Text = st.Title ~= "" and st.Title or "Nimbus says"
	UI.Counter.Text = "Step " .. st.Step .. "/" .. st.Total
	UI.StripTitle.Text = UI.StepTitle.Text -- (Pitch 2 03 B) the folded quest strip's title and count
	UI.StripCount.Text = st.Step .. "/" .. st.Total
	S.progTotal = st.Total -- (layout builds the row for it)
	paintProgress(st.Step, false)
	UI.Hint.Text = hintText()
	local isNext = nextShown(st)
	UI.Next.Text = st.Button or "Next"
	setStyle(UI.Next, st.Step >= st.Total and "Gold" or "Green")
	setDisabled(UI.Next, false)
	setDisabled(UI.ConfirmYes, false)
	S.nextLockUntil = 0
	setConfirming(false)
	UI.Next.Visible = isNext
	S.heightKey = nil
	startTyping(st.Text)
	safe("layout", layout)
end

local function renderFinale(reward)
	S.finale = true
	S.typing = false
	UI.StepTitle.Text = "All done!"
	UI.Counter.Text = "Complete!"
	UI.StripTitle.Text = "All done!"
	UI.StripCount.Text = "Done!"
	paintProgress(0, true)
	local text = "You know the basics now. Happy climbing, see you in the clouds!"
	if type(reward) == "number" and reward > 0 then
		text = "+" .. reward .. " Cloud Tokens are yours! You know the basics now. Happy climbing!"
	end
	S.heightKey = nil
	startTyping(text)
	S.typeShown = 0
	safe("layout", layout)
end

local function panelWanted()
	if S.finale then
		return S.clock < (S.finaleUntil or 0)
	end
	local st = S.state
	if not st or st.Done then
		return false
	end
	if S.clock < (S.showAfter or 0) then
		return false
	end
	if inMatch() and st.CompleteOn ~= "MatchEnded" then
		return false
	end
	-- a battle on a phone: the battle HUD's top card and team cards hold the top / left of the screen and the rest is
	-- the fight (the HUD cues ATTACK / RETREAT / SPECIAL itself); Nimbus comes back when the battle ends
	if UI.Gui and battleTeamRect(guiArea()) then
		return false
	end
	return true
end

local function setPanelShown(on)
	if not UI.Root then
		return
	end
	if on == S.shown then
		return
	end
	S.shown = on
	local k = math.max(0.1, UI.Scale.Scale)
	local hiddenX = -math.floor((UI.Root.AbsolutePosition.X / k) + UI.Root.Size.X.Offset + 40)
	if on then
		S.coverRead = 0 -- (C17 review) a window it comes back under is read at once (Step)
		safe("layout", layout)
		UI.Root.Visible = true
		UI.Slide.Position = UDim2.fromOffset(hiddenX, 0)
		tween(UI.Slide, 0.45, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
		if S.typing then
			S.typeDelay = math.max(S.typeDelay or 0, 0.35) -- let the card arrive before talking
		end
	else
		syncVitals(nil)
		local out = tween(UI.Slide, 0.3, { Position = UDim2.fromOffset(hiddenX, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		out.Completed:Connect(function()
			if not S.shown and UI.Root then
				UI.Root.Visible = false
				-- (C17 review) a guide that slid out unseen under a window is whole again for its next show
				UI.Slide.Visible = true
			end
		end)
	end
end

----------------------------------------------------------------------
-- Menu pointer: pulsing ring + pixel arrow at MenuButton_<Id>
----------------------------------------------------------------------
local function findMenuButton(id)
	local pg = playerGui()
	if not pg or type(id) ~= "string" then
		return nil
	end
	local names = { "MenuButton_" .. id, "Menu_" .. id }
	if id == "Home" then
		-- the Home tile keeps its v3 id "Spot" (MenuController): Phase 4's "Portal Home" step rings it as "Home"
		table.insert(names, 1, "MenuButton_Spot")
	end
	for _, name in ipairs(names) do
		for _, d in ipairs(pg:GetDescendants()) do
			if d.Name == name and d:IsA("GuiObject") and d.AbsoluteSize.X > 0 then
				local owner = d:FindFirstAncestorOfClass("ScreenGui")
				if owner and owner ~= UI.Gui and owner ~= UI.PointerGui and shownIn(d, owner) then
					return d
				end
			end
		end
	end
	return nil
end

local function isButton(obj)
	return obj:IsA("TextButton") or obj:IsA("ImageButton")
end

-- The button itself, or the first button inside a tile frame.
local function clickable(obj)
	if isButton(obj) then
		return obj
	end
	for _, d in ipairs(obj:GetDescendants()) do
		if isButton(d) then
			return d
		end
	end
	return nil
end

-- Hooks clicks on the menu button that leads to what the current step waits for.
local function refreshClickHook()
	local st = S.state
	local id = st and not st.Done and HOOK_FOR[st.CompleteOn] or nil
	if id ~= M.hookId or (M.hookConn and not (M.hookButton and M.hookButton.Parent)) then
		if M.hookConn then
			M.hookConn:Disconnect()
			M.hookConn = nil
		end
		M.hookId = id
		M.hookButton = nil
	end
	if id and not M.hookConn then
		local found = findMenuButton(id)
		local target = found and clickable(found)
		if target then
			M.hookButton = target
			M.hookConn = target.Activated:Connect(function()
				task.delay(0.35, onWindowOpened, id)
			end)
		end
	end
end

-- (U9-9 look 2) the menu tile the pointer marks (MenuController.SetPointed: the kit's Selected gold face); nil = none
local function setPointed(id)
	if M.pointed == id then
		return
	end
	local menu = mod("MenuController")
	if menu and type(menu.SetPointed) == "function" then
		if M.pointed then
			pcall(menu.SetPointed, M.pointed, false)
		end
		if id then
			pcall(menu.SetPointed, id, true)
		end
	end
	M.pointed = id
end

local function hidePointer()
	setPointed(nil)
	if UI.Arrow and UI.Arrow.Visible then
		UI.Arrow.Visible = false
	end
end

-- Shown MenuButton_* tiles (other than `except`) in our gui coordinates.
local function menuButtonRects(except)
	local out = {}
	local pg = playerGui()
	local menuGui = pg and pg:FindFirstChild("NimbusMenu")
	if not (menuGui and menuGui:IsA("ScreenGui") and menuGui.Enabled) then
		return out
	end
	local dy = insetShift(menuGui)
	for _, d in ipairs(menuGui:GetDescendants()) do
		if d ~= except and d:IsA("GuiObject") and string.sub(d.Name, 1, 11) == "MenuButton_" and d.AbsoluteSize.X > 0 and shownIn(d, menuGui) then
			out[#out + 1] = rectOf(d, dy)
		end
	end
	return out
end

-- What the pointer arrow must not cover: the other menu tiles and the tutorial card / bubble; (2026-11-28 playtest C51:
-- at 640x360 the step-21 arrow pointed up at Home from inside the thumbstick's zone) on touch, Roblox's thumbstick and
-- the RUN / DASH buttons too, as for the guide chip
local function pointerObstacles(button, area)
	local list = menuButtonRects(button)
	for _, r in ipairs(touchButtonRects()) do
		list[#list + 1] = r
	end
	list[#list + 1] = area and thumbstickRect(area) or nil
	if UI.Root and UI.Root.Visible then
		local part = (collapsed() and S.stripChip) and UI.Portrait or UI.Root -- (Pitch 2 03 B: folded, the root is the strip)
		if part and part.AbsoluteSize.X > 0 then
			list[#list + 1] = rectOf(part, 0)
		end
	end
	return list
end

local function rectsOverlap(a, b)
	return a.x0 < b.x1 and b.x0 < a.x1 and a.y0 < b.y1 and b.y0 < a.y1
end

-- Where the arrow goes around target rect `r`: right of it pointing left (the default), else above it pointing
-- down, below it pointing up or left of it pointing right, whichever first stays on screen and clear of the
-- neighbouring tiles and the tutorial card / bubble (the 2 x 3 phone grid has a tile right of Index). Returns
-- side, rotation; side "none" when every side is taken: then only the gold tile marks the button (an arrow on a
-- neighbouring tile would point the new player at the wrong button).
local POINTER_SIDES = { { "right", 0 }, { "above", -90 }, { "below", 90 }, { "left", 180 } }
local function pointerCentre(side, r, len, thick, push)
	local cx, cy = (r.x0 + r.x1) * 0.5, (r.y0 + r.y1) * 0.5
	if side == "right" then
		return r.x1 + push + len / 2, cy, len, thick
	elseif side == "above" then
		return cx, r.y0 - push - len / 2, thick, len
	elseif side == "below" then
		return cx, r.y1 + push + len / 2, thick, len
	end
	return r.x0 - push - len / 2, cy, len, thick
end

local function choosePointerSide(r, k, area, button)
	local len, thick = 68 * k, 44 * k
	local push = 15 * k -- the farthest point of the bounce
	local obstacles = pointerObstacles(button, area)
	for _, spec in ipairs(POINTER_SIDES) do
		local cx, cy, w, h = pointerCentre(spec[1], r, len, thick, push)
		local box = { x0 = cx - w / 2, y0 = cy - h / 2, x1 = cx + w / 2, y1 = cy + h / 2 }
		local clear = box.x0 >= 0 and box.y0 >= 0 and box.x1 <= area.X and box.y1 <= area.Y
		if clear then
			for _, o in ipairs(obstacles) do
				if rectsOverlap(box, o) then
					clear = false
					break
				end
			end
		end
		if clear then
			return spec[1], spec[2]
		end
	end
	return "none", 0
end

local function updateMenuPointer(dt, t)
	local st = S.state
	-- hidden while a window / the Index / the roulette covers the menu (S.windowOpen): it would draw on top of it
	local want = st and not st.Done and not S.finale and st.Target and st.Target.Kind == "Menu" and S.shown and not inMatch()
		and not S.windowOpen
	local targetId = want and st.Target.Id or nil
	-- (Pitch 2 item 13 A) the travel guide away from the lobby points at the Home tile (its Go home opens the home portal)
	if G.active and G.phase == "Home" and not S.windowOpen and not inMatch() then
		want, targetId = true, "Home"
	end
	M.findTimer = M.findTimer - dt
	if M.findTimer <= 0 then
		M.findTimer = 1
		safe("menu hook", refreshClickHook)
		if want then
			local valid = M.button and M.button.Parent and M.buttonId == targetId
			if valid then
				local owner = M.button:FindFirstAncestorOfClass("ScreenGui")
				valid = owner ~= nil and shownIn(M.button, owner)
			end
			if not valid then
				M.button = findMenuButton(targetId)
				M.buttonId = targetId
				M.side = nil
			end
		end
	end
	if not want or not M.button or not M.button.Parent then
		hidePointer()
		return
	end
	local owner = M.button:FindFirstAncestorOfClass("ScreenGui")
	local r = rectOf(M.button, insetShift(owner))
	local w, h = r.x1 - r.x0, r.y1 - r.y0
	if w <= 0 or h <= 0 then
		hidePointer()
		return
	end
	local k = Theme.ScreenFactor()
	local pk = UI.PointerScale and UI.PointerScale.Scale or k -- the arrow's snapped scale (layout)
	-- (U9-9 look 2) the tile itself turns gold (the kit's Selected look); no ring over its neighbours
	setPointed(targetId)
	-- the side is re-chosen after every layout pass (M.side = nil there, twice a second at most)
	if not M.side then
		local okSide, side, rotation = pcall(choosePointerSide, r, pk, guiArea(), M.button)
		if okSide then
			M.side, M.rotation = side, rotation
		else
			M.side, M.rotation = "right", 0
		end
	end
	if M.side == "none" then
		if UI.Arrow.Visible then
			UI.Arrow.Visible = false
		end
		return
	end
	local bounce = (8 + 7 * (math.sin(t * 5) + 1) * 0.5) * pk
	local len, thick = 68 * pk, 44 * pk
	local cx, cy = pointerCentre(M.side, r, len, thick, bounce)
	local rotation = M.rotation or 0
	-- (kit B U9-9) the arrow's box (after its quarter turn) starts on a whole screen px, so every cell is whole
	local bw, bh = len, thick
	if rotation % 180 ~= 0 then
		bw, bh = thick, len
	end
	cx = math.floor(cx - bw / 2 + 0.5) + bw / 2
	cy = math.floor(cy - bh / 2 + 0.5) + bh / 2
	UI.Arrow.Rotation = rotation
	UI.Arrow.Position = UDim2.fromOffset(cx, cy)
	UI.Arrow.Visible = true
end

----------------------------------------------------------------------
-- World guide: voxel arrow, sparkle ring, sign and dotted beam
----------------------------------------------------------------------
local function clientFx()
	local folder = Workspace:FindFirstChild("ClientFx")
	if not folder then
		folder = make("Folder", "ClientFx", nil, Workspace)
	end
	return folder
end

local function finishArrowPart(part)
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Massless = true
end

-- The golden guide arrow, sculpted with the voxel kit (a stepped-block arrow when the kit is missing).
local function buildArrowModel()
	local Voxel = mod("Voxel")
	local model = nil
	if Voxel and type(Voxel.NewGrid) == "function" and type(Voxel.Build) == "function" then
		local ok, built = pcall(function()
			local g = Voxel.NewGrid(24)
			-- head: a round cone pointing down with a lighter lip at its base
			Voxel.Shape(g, { Kind = "Cone", A = { 0, 9, 0 }, B = { 0, -0.5, 0 }, Radius = 6.4, Key = "Gold" })
			Voxel.Shape(g, { Kind = "Torus", Center = { 0, 9.2, 0 }, Radius = 5.8, Thickness = 0.8, Key = "Rim" })
			-- shaft: a rounded column with a soft dome on top
			Voxel.Shape(g, { Kind = "RoundBox", Center = { 0, 14.5, 0 }, Size = { 5, 11, 5 }, Round = 1.6, Key = "Gold" })
			Voxel.Shape(g, { Kind = "Ellipsoid", Center = { 0, 19.5, 0 }, Radius = { 2.4, 1.2, 2.4 }, Key = "Rim" })
			-- glints on the front-left edge
			Voxel.Shape(g, { Kind = "Box", Center = { -1, 14, -2 }, Size = { 1, 8, 1 }, Key = "Shine", Op = "Paint" })
			Voxel.Shape(g, { Kind = "Box", Center = { -2, 6.5, -4 }, Size = { 1, 3, 3 }, Key = "Shine", Op = "Paint" })
			Voxel.Shade(g, { Skip = { Shine = true }, DarkAt = -0.7, LightAt = 0.5, Noise = 0.03, Seed = 11 })
			return Voxel.Build(g, {
				VoxelSize = K.VOXEL,
				Palette = {
					Gold = C.Arrow,
					Gold_Light = C.ArrowLight,
					Gold_Dark = C.ArrowDark,
					Rim = C.ArrowLight,
					Rim_Light = C.ArrowShine,
					Rim_Dark = C.Arrow,
					Shine = C.ArrowShine,
				},
				Center = true,
				Name = "GuideArrow",
				MaxParts = 110,
				CastShadow = false,
			})
		end)
		if ok and typeof(built) == "Instance" then
			model = built
		else
			warnOnce("arrow", "voxel arrow failed: " .. tostring(built))
		end
	end
	if not model then
		model = make("Model", "GuideArrow", nil, nil)
		-- a stepped head (tip at the bottom) under a block shaft
		local widths = { 0.8, 1.8, 3.0, 4.2 }
		for i, w in ipairs(widths) do
			make("Part", "Head" .. i, {
				Size = Vector3.new(w, 1, w),
				Color = (i % 2 == 0) and C.ArrowDark or C.Arrow,
				Material = Enum.Material.SmoothPlastic,
				CFrame = CFrame.new(0, i - 4.5, 0),
			}, model)
		end
		make("Part", "Shaft", {
			Size = Vector3.new(1.8, 4, 1.8),
			Color = C.ArrowLight,
			Material = Enum.Material.SmoothPlastic,
			CFrame = CFrame.new(0, 2.5, 0),
		}, model)
	end
	local parts, offsets = {}, {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			finishArrowPart(d)
			table.insert(parts, d)
			table.insert(offsets, d.CFrame)
		end
	end
	-- (Pitch 2 item 13 A, kit B: nothing glows) the PointLight "Glow" on the first part went
	return model, parts, offsets
end

local function buildWorldGuide()
	W.built = true
	local folder = make("Folder", "TutorialGuide", nil, nil)
	W.folder = folder
	local model, parts, offsets = buildArrowModel()
	model.Parent = folder
	W.arrowParts, W.arrowOffsets = parts, offsets
	W.arrowTop = nil
	-- (look review fin0, MJ1) the arrow's outline for its box on the screen: the corners of its parts that are the
	-- farthest out along one of the 124 directions of a 5x5x5 grid (the points its silhouette can end at, a few dozen of
	-- the ~800 corners), round its centre. One box round the whole arrow (r1) drew it a head's width wide at its narrow
	-- tip: seen from below, that box's far bottom corners projected ~40 px under the real arrow and the chip dodged an
	-- arrow that ended above it
	local corners, wide = {}, 0
	for i, p in ipairs(parts) do
		local o, s = offsets[i].Position, p.Size / 2
		wide = math.max(wide, math.abs(o.X) + s.X, math.abs(o.Z) + s.Z)
		for _, dx in ipairs({ -1, 1 }) do
			for _, dy in ipairs({ -1, 1 }) do
				for _, dz in ipairs({ -1, 1 }) do
					corners[#corners + 1] = o + Vector3.new(dx * s.X, dy * s.Y, dz * s.Z)
				end
			end
		end
	end
	local hull, taken = {}, {}
	for x = -2, 2 do
		for y = -2, 2 do
			for z = -2, 2 do
				if x ~= 0 or y ~= 0 or z ~= 0 then
					local best, at = -math.huge, nil
					for i, c in ipairs(corners) do
						local v = c.X * x + c.Y * y + c.Z * z
						if v > best then
							best, at = v, i
						end
					end
					if at and not taken[at] then
						taken[at] = true
						hull[#hull + 1] = corners[at]
					end
				end
			end
		end
	end
	W.arrowHull = hull
	-- (look review fin0, minor) the GuideSign's edge stands K.SIGN_GAP studs past the arrow's widest part (SIGN_STUDS
	-- 1.6 sat inside its ~2.4-stud head: the card hid the arrow's side, 3 px at 844x390, 12 at 1920)
	W.signStuds = math.max(K.SIGN_STUDS, wide + K.SIGN_GAP)

	-- (Pitch 2 item 13_travel_guide A, the owner's pick "Gold arrow + dot trail"; it was a glowing Beam of a sparkle strip
	-- from the hip and a ring of Neon sparkles) the trail is flat gold dot blocks on the ground (Dots: a pool of
	-- SmoothPlastic squares, laid every K.DOT_EVERY s from K.DOT_START studs ahead of the feet toward the target, every
	-- K.DOT_STEP studs, at most K.TRAIL_MAX studs out); no Neon, no light
	W.dotFolder = make("Folder", "Dots", nil, folder)
	W.dots = {}
	W.dotTimer = 0

	-- floating sign beside the arrow's shaft (World text rule: pixel-sized, the name 24 px and the distance 19 px at 1080p
	-- on a compact plate sized to its text; a UIScale follows the screen-height factor). (Pitch 2 item 04 / 13: the navy
	-- rounded card with the gold stroke went) a stone tag: the Stone face, a 3 px wood edge, the gold lip, brown ink.
	-- AlwaysOnTop with a long MaxDistance on purpose: it is the way-finder, seen from anywhere in the lobby.
	local anchor = make("Part", "SignAnchor", { Size = Vector3.new(0.2, 0.2, 0.2), Transparency = 1 }, folder)
	finishArrowPart(anchor)
	W.labelAnchor = anchor
	local k = Theme.ScreenFactor()
	-- beside the shaft, not over the arrow's head: the billboard's left edge on the axis (SizeOffset 0.5), moved
	-- W.signStuds right of it on the screen (StudsOffset: past the arrow's widest part), the card on its left edge
	local signGui = make("BillboardGui", "GuideSign", {
		Size = UDim2.fromOffset(math.floor(K.SIGN_W * k), math.floor(K.SIGN_H * k)),
		SizeOffset = Vector2.new(0.5, 0),
		StudsOffset = Vector3.new(W.signStuds or K.SIGN_STUDS, 0, 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = 4000,
		ClipsDescendants = false,
	}, anchor)
	W.labelGui = signGui
	local card = box("Card", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, K.SIGN_EDGE, 0.5, 0),
		Size = UDim2.fromOffset(150, K.SIGN_NAME + K.SIGN_INFO + 22),
	}, signGui)
	-- (the UIScale grows the card round its anchor, the left edge: it stays beside the shaft at any screen size)
	edge(card, SIGN.Wood, K.SIGN_EDGE)
	lipOf(card, SIGN.GoldLip, K.SIGN_LIP)
	W.signCard = card
	W.signScale = make("UIScale", "ReadScale", { Scale = k }, card)
	W.signName = label(card, "Name", "", "Heading", K.SIGN_NAME, SIGN.Text, {
		Position = UDim2.fromOffset(K.SIGN_PAD, 5),
		Size = UDim2.fromOffset(100, K.SIGN_NAME + 4),
		TextScaled = false,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.None,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})
	W.signDistance = label(card, "Distance", "", "Label", K.SIGN_INFO, SIGN.TextMuted, {
		Position = UDim2.fromOffset(K.SIGN_PAD, 5 + K.SIGN_NAME + 5),
		Size = UDim2.fromOffset(100, K.SIGN_INFO + 4),
		TextScaled = false,
		TextWrapped = false,
		TextTruncate = Enum.TextTruncate.None,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 2,
	})
end

-- the sign's card hugs its two lines (measured; no AutomaticSize: the lip is a child outside any list). (look review
-- fin1, MJ-B) W.signShort: the name alone, the distance line off (where the two lines do not fit beside the arrow)
local function layoutSign()
	local card = W.signCard
	if not card then
		return
	end
	local short = W.signShort == true
	W.signDistance.Visible = not short
	local nameW = Theme.Measure(W.signName.Text, "Heading", K.SIGN_NAME).X
	local infoW = short and 0 or Theme.Measure(W.signDistance.Text, "Label", K.SIGN_INFO).X
	local inner = math.ceil(math.max(nameW, infoW, 60)) + 4
	W.signName.Size = UDim2.fromOffset(inner, K.SIGN_NAME + 4)
	W.signDistance.Size = UDim2.fromOffset(inner, K.SIGN_INFO + 4)
	local lines = short and (5 + K.SIGN_NAME + 4) or (5 + K.SIGN_NAME + 5 + K.SIGN_INFO + 4)
	card.Size = UDim2.fromOffset(inner + 2 * K.SIGN_PAD, lines + 4 + K.SIGN_LIP)
end

-- (look review fin0, MJ2) the board of the gate the world guide stands over is off while the guide shows: the arrow
-- (ARROW_LIFT over the gate's top) and the GuideSign hang exactly where the board hangs (27 studs up, growing upwards, a
-- pixel billboard, so no studs lift clears it at every distance), and the GuideSign already names the place (the
-- approved mock 13 A shows the target gate with the sign alone). Its own Enabled comes back when the guide moves on or
-- ends; a board switched on by someone else meanwhile is switched off again on the next frame. holdBoard(nil) lets go.
local function holdBoard(board)
	local held = W.board
	if held and held ~= board then
		if held.Parent then
			held.Enabled = W.boardWas ~= false
		end
		W.board, W.boardWas = nil, nil
	end
	if board and board.Parent then
		if W.board ~= board then
			W.board, W.boardWas = board, board.Enabled
		end
		if board.Enabled then
			board.Enabled = false
		end
	end
end

local function setWorldActive(on)
	if not W.built then
		return
	end
	if not on then
		holdBoard(nil)
	end
	if on == W.active then
		return
	end
	W.active = on
	if on then
		W.folder.Parent = clientFx()
		W.dotTimer = 0 -- the trail is laid again from where the player stands now
	else
		W.folder.Parent = nil
		W.distance = nil
	end
end

-- Bounding box of a Model / BasePart / Folder (cf, size) or nil.
local function boundsOf(inst)
	if inst:IsA("Model") then
		local ok, cf, size = pcall(function()
			return inst:GetBoundingBox()
		end)
		if ok and cf and size then
			return cf, size
		end
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.CFrame, inst.Size
	end
	local lo, hi = nil, nil
	local n = 0
	for _, d in ipairs(inst:GetDescendants()) do
		if d:IsA("BasePart") then
			n = n + 1
			if n > 4000 then
				break
			end
			local p, s = d.Position, d.Size * 0.5
			local a, b = p - s, p + s
			if lo then
				lo = Vector3.new(math.min(lo.X, a.X), math.min(lo.Y, a.Y), math.min(lo.Z, a.Z))
				hi = Vector3.new(math.max(hi.X, b.X), math.max(hi.Y, b.Y), math.max(hi.Z, b.Z))
			else
				lo, hi = a, b
			end
		end
	end
	if not lo then
		return nil
	end
	return CFrame.new((lo + hi) * 0.5), hi - lo
end

local function findSpotFolder(lobby, index)
	if not lobby or type(index) ~= "number" then
		return nil
	end
	local named = lobby:FindFirstChild(string.format("Spot_%02d", index), true)
	if named and named:GetAttribute("SpotIndex") == index then
		return named
	end
	for _, d in ipairs(lobby:GetDescendants()) do
		if (d:IsA("Folder") or d:IsA("Model")) and d:GetAttribute("SpotIndex") == index then
			return d
		end
	end
	return nil
end

-- Where the guide points: { Ground = Vector3, ArrowAt = Vector3, Radius, Name } or nil.
local function resolveTarget(target)
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	local kind = target.Kind
	local name = target.Label
	local server = typeof(target.Position) == "Vector3" and target.Position or nil
	local ground, arrowAt, radius = nil, nil, 6
	local model = nil
	if kind == "Spot" then
		radius = 9
		name = name or "Your Home"
		local index = target.SpotIndex
		if type(index) ~= "number" then
			index = LocalPlayer:GetAttribute(Config.Attr.SpotIndex)
		end
		ground = server
		if not ground then
			local folder = findSpotFolder(lobby, index)
			local plot = folder and folder:FindFirstChild("Plot")
			if plot and plot:IsA("Model") then
				local okPivot, pivot = pcall(function()
					return plot:GetPivot()
				end)
				if okPivot and pivot then
					ground = pivot.Position
				end
			elseif folder then
				local cf, size = boundsOf(folder)
				if cf then
					ground = cf.Position - Vector3.new(0, size.Y * 0.5, 0)
				end
			end
		end
		if ground then
			arrowAt = ground + Vector3.new(0, 6, 0)
		end
	elseif kind == "Gate" then
		-- (Pitch 2 item 13 A, the travel guide) a lobby gate by its ProximityPrompt (target.Prompt, e.g. AltarGatePrompt):
		-- the ground under its prompt part, the arrow over its gate model (the part itself when it has none)
		radius = 6
		name = name or "Gate"
		local prompt = lobby and type(target.Prompt) == "string" and lobby:FindFirstChild(target.Prompt, true)
		local part = prompt and prompt.Parent
		if part and part:IsA("BasePart") then
			local p, half = part.Position, part.Size.Y * 0.5
			ground = Vector3.new(p.X, p.Y - half, p.Z)
			arrowAt = Vector3.new(p.X, p.Y + half + 3, p.Z)
			local gate = part:FindFirstAncestorOfClass("Model")
			if gate and gate ~= lobby then
				local cf, size = boundsOf(gate)
				if cf and size.Y < 60 then
					arrowAt = Vector3.new(p.X, cf.Position.Y + size.Y * 0.5, p.Z)
				end
				model = gate
			end
		end
	else
		local id = target.Id
		if kind == "Portal" then
			radius = 7
			id = id or "Obby" -- Phase 5: the ONE Obby portal (Portal_Obby in the Gate Court)
			model = lobby and lobby:FindFirstChild("Portal_" .. tostring(id), true)
			if not name then
				local diff = Config.GetDifficulty and Config.GetDifficulty(id)
				name = (diff and diff.DisplayName or tostring(id)) .. " Portal"
			end
		else
			radius = 5
			id = id or firstRouletteId()
			model = lobby and lobby:FindFirstChild("Roulette_" .. tostring(id), true)
			if not name then
				name = kind == "Shop" and "Cloud Shop" or (tostring(id) .. " Roulette")
			end
		end
		if model then
			local cf, size = boundsOf(model)
			if cf then
				local c = cf.Position
				arrowAt = Vector3.new(c.X, c.Y + size.Y * 0.5, c.Z)
				ground = server or Vector3.new(c.X, c.Y - size.Y * 0.5, c.Z)
			end
		end
		if not ground and server then
			ground = server
			arrowAt = server + Vector3.new(0, 8, 0)
		end
	end
	if not ground or not arrowAt then
		return nil
	end
	-- (look review fin0, MJ2) a gate's hanging board (WorldStyle.BuildTag "GateTag", or a builder's stand-in of that name)
	local board = nil
	if model and (kind == "Gate" or kind == "Portal") then
		local b = model:FindFirstChild("GateTag", true)
		board = (b and b:IsA("BillboardGui")) and b or nil
	end
	return { Ground = ground, ArrowAt = arrowAt, Radius = radius, Name = name or "", Board = board }
end

local function targetKey(target)
	local p = typeof(target.Position) == "Vector3" and target.Position or Vector3.new()
	return table.concat({
		tostring(target.Kind),
		tostring(target.Id),
		tostring(target.SpotIndex),
		string.format("%.0f,%.0f,%.0f", p.X, p.Y, p.Z),
	}, "|")
end

-- (Pitch 2 item 13 A) the ground under a trail point: a ray down from a little over the straight line from the feet to
-- the target (the character and the guide are skipped; every guide part is CanQuery off), else that line
local function groundY(x, z, line)
	local hit = nil
	pcall(function()
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LocalPlayer.Character, W.folder }
		local result = Workspace:Raycast(Vector3.new(x, line + 4, z), Vector3.new(0, -12, 0), params)
		if result then
			hit = result.Position.Y
		end
	end)
	return hit or line
end

-- the trail's i-th dot block (a pool: made once, hidden by Transparency 1 when not laid)
local function dotAt(i)
	local d = W.dots[i]
	if not d then
		d = make("Part", "Dot" .. i, {
			Size = Vector3.new(K.DOT_SIZE, 0.16, K.DOT_SIZE),
			Color = SIGN.Gold,
			Material = Enum.Material.SmoothPlastic,
			Transparency = 1,
		}, W.dotFolder)
		finishArrowPart(d)
		W.dots[i] = d
	end
	return d
end

-- lays the dot trail from K.DOT_START studs ahead of `from` (the root) toward `goal` (the target's ground), every
-- K.DOT_STEP studs, out to K.TRAIL_MAX; none within K.TRAIL_HIDE of the goal. -> the flat distance to the goal
local function layDots(from, goal)
	local flat = Vector3.new(goal.X - from.X, 0, goal.Z - from.Z)
	local dist = flat.Magnitude
	local n = 0
	if dist > K.TRAIL_HIDE then
		local dir = flat.Unit
		local yaw = math.atan2(-dir.X, -dir.Z)
		local reach = math.min(dist - 2, K.TRAIL_MAX)
		local footY = from.Y - 3
		local s = K.DOT_START
		while s <= reach and n < K.DOT_MAX do
			n = n + 1
			local x, z = from.X + dir.X * s, from.Z + dir.Z * s
			local line = footY + (goal.Y - footY) * (s / dist)
			local part = dotAt(n)
			part.CFrame = CFrame.new(x, groundY(x, z, line) + 0.1, z) * CFrame.Angles(0, yaw, 0)
			if part.Transparency ~= 0 then
				part.Transparency = 0
			end
			s = s + K.DOT_STEP
		end
	end
	for i = n + 1, #W.dots do
		if W.dots[i].Transparency ~= 1 then
			W.dots[i].Transparency = 1
		end
	end
	return dist
end

local function updateWorldGuide(dt, t)
	local st = S.state
	local target = st and st.Target
	local want = st and not st.Done and not S.finale and S.shown and target and WORLD_KINDS[target.Kind] and not inMatch()
	-- (Pitch 2 item 13 A) the travel guide the player asked for takes the world guide while it walks the lobby (one guide
	-- at a time; the tutorial's comes back when it ends)
	if G.active and G.target and (G.phase == "Walk" or G.phase == "Here") then
		target, want = G.target, true
	end
	if not want then
		setWorldActive(false)
		return
	end
	if not W.built then
		local ok = safe("world guide", buildWorldGuide)
		if not ok then
			return
		end
	end
	local key = targetKey(target)
	W.resolveTimer = W.resolveTimer - dt
	if key ~= W.key or (not W.resolved and W.resolveTimer <= 0) then
		W.key = key
		W.resolveTimer = K.RESOLVE_RETRY
		local ok, resolved = pcall(resolveTarget, target)
		W.resolved = ok and resolved or nil
		if W.resolved then
			W.signName.Text = W.resolved.Name
			W.arrowTop = nil
			W.labelTimer = 0
			W.dotTimer = 0
		end
	end
	local goal = W.resolved
	if not goal then
		setWorldActive(false)
		return
	end
	setWorldActive(true)
	holdBoard(goal.Board)

	-- (Pitch 2 item 13 A) the arrow hops between two heights in hard steps (it bobbed on a sine and spun), its parts
	-- written only when it hops
	local hop = (math.floor(t / K.BOB_STEP) % 2 == 0) and 0 or K.BOB
	W.arrowHome = goal.ArrowAt + Vector3.new(0, K.ARROW_LIFT, 0)
	W.arrowBase = W.arrowHome
	local top = W.arrowBase + Vector3.new(0, hop, 0)
	if W.arrowTop ~= top then
		W.arrowTop = top
		local cf = CFrame.new(top)
		local parts, offsets = W.arrowParts, W.arrowOffsets
		for i = 1, #parts do
			parts[i].CFrame = cf * offsets[i]
		end
		W.labelAnchor.CFrame = CFrame.new(W.arrowBase + Vector3.new(0, K.SIGN_LIFT, 0))
	end

	-- the dot trail from just ahead of the feet toward the target (capped), the distance on the sign
	local root = rootPart()
	W.labelTimer = W.labelTimer - dt
	W.dotTimer = W.dotTimer - dt
	if root then
		local from = root.Position
		if W.dotTimer <= 0 then
			W.dotTimer = K.DOT_EVERY
			W.distance = layDots(from, goal.Ground)
		end
		local dist = W.distance or Vector3.new(goal.Ground.X - from.X, 0, goal.Ground.Z - from.Z).Magnitude
		if W.labelTimer <= 0 then
			W.labelTimer = 0.25
			local text = (dist <= K.TRAIL_HIDE) and "You're here!" or (math.floor(dist + 0.5) .. " studs away")
			if W.signDistance.Text ~= text or W.signLaid ~= W.signName.Text then
				W.signDistance.Text = text
				W.signLaid = W.signName.Text
				layoutSign()
			end
		end
	else
		W.distance = nil
	end
end

----------------------------------------------------------------------
-- State handling
----------------------------------------------------------------------
local function sanitize(payload)
	local st = {
		Step = math.max(1, math.floor(tonumber(payload.Step) or 1)),
		Total = math.max(1, math.floor(tonumber(payload.Total) or 1)),
		Id = type(payload.Id) == "string" and payload.Id or "",
		Title = type(payload.Title) == "string" and payload.Title or "",
		Text = type(payload.Text) == "string" and payload.Text or "",
		CompleteOn = type(payload.CompleteOn) == "string" and payload.CompleteOn or nil,
		Hint = type(payload.Hint) == "string" and payload.Hint or nil,
		Button = type(payload.Button) == "string" and payload.Button or nil,
		AlsoNext = payload.AlsoNext == true,
		Done = payload.Done == true,
		Completed = payload.Completed == true,
		Skipped = payload.Skipped == true,
		Reward = tonumber(payload.Reward) or 0,
		Target = nil,
	}
	if st.Step > st.Total then
		st.Total = st.Step
	end
	if type(payload.Target) == "table" and type(payload.Target.Kind) == "string" then
		local t = payload.Target
		st.Target = {
			Kind = t.Kind,
			Id = (type(t.Id) == "string") and t.Id or nil,
			Label = (type(t.Label) == "string") and t.Label or nil,
			Position = (typeof(t.Position) == "Vector3") and t.Position or nil,
			SpotIndex = (type(t.SpotIndex) == "number") and t.SpotIndex or nil,
		}
	end
	-- older servers: fill in what the shared step list knows
	local Steps = mod("TutorialSteps")
	-- the step at the payload's index first (Phase 4: chapter 4's "portal" shares its id with chapter 1's), else by id
	local def = nil
	if Steps and type(Steps.Steps) == "table" then
		local atIndex = Steps.Steps[st.Step]
		if type(atIndex) == "table" and atIndex.Id == st.Id then
			def = atIndex
		elseif type(Steps.IndexOf) == "table" and Steps.IndexOf[st.Id] then
			def = Steps.Steps[Steps.IndexOf[st.Id]]
		end
	end
	if type(def) == "table" then
		st.CompleteOn = st.CompleteOn or def.CompleteOn
		st.Hint = st.Hint or def.Hint
		st.Button = st.Button or def.Button
		if payload.AlsoNext == nil and def.AlsoNext == true and st.CompleteOn == def.CompleteOn then
			st.AlsoNext = true -- an older server: the shared step list knows
		end
		if st.Title == "" and type(def.Title) == "string" then
			st.Title = def.Title
		end
	end
	st.CompleteOn = st.CompleteOn or "Next"
	return st
end

local function ensureLoop()
	if R.loop then
		return
	end
	R.loop = RunService.RenderStepped:Connect(function(dt)
		TutorialController.Step(dt)
	end)
end

----------------------------------------------------------------------
-- Travel guide (Pitch 2 item 13_travel_guide A, the owner's pick "Gold arrow + dot trail"; its chip the owner's pick B of
-- 2026-11-23, "Top-bar plank"): the Shop's "Show the way" (it teleported) starts it. In the lobby world it is the world
-- guide above, pointed at the target's gate (the dot trail from the feet, the arrow over the gate; its GuideSign is
-- retired while the travel guide runs), and a chip, the top bar pill's twin: a cream stone plank docked in Roblox's top
-- band at its right end beside '...' (a portrait phone: on the vitals stack), the needle (PixelIcon's arrows, the way to
-- the gate), "Storm Altar" over "NN studs away" (a PC: one line, the stud count in its tag) and the red X (a 44 px target)
-- that ends it. Away from the lobby world (an arena, a dungeon) it routes home first: the house mark, "Home first" /
-- "then follow the arrow", the menu pointer on the Home tile (its Go home opens the home portal) and no trail; back in
-- the lobby the trail picks up by itself. Within K.GUIDE_ARRIVE studs of the gate the chip turns grass ("You're here" /
-- CloudUI.PromptWords) for K.GUIDE_HERE s, slides up in two hard steps and the guide ends. A match or a battle / run /
-- the Ring (a portal walked into), standing at the altar, the X or Stop end it at once; a second Start replaces the
-- first. Nothing is left behind: the chip's ScreenGui goes, the world guide hides (or goes back to the tutorial's target,
-- its sign back on), the pointer clears.
--   TutorialController.Guide.Start(id) -> boolean   id: a key of GUIDE_TARGETS ("StormAltar"); false in a match / battle
--   TutorialController.Guide.Stop()
--   TutorialController.Guide.Active() -> id | nil
--   TutorialController.Guide.Phase() -> "Walk" | "Home" | "Here" | nil
----------------------------------------------------------------------
local GUIDE_TARGETS = {
	StormAltar = { Kind = "Gate", Id = "Altar", Prompt = "AltarGatePrompt", Label = "Storm Altar" },
}
local Guide = {}
TutorialController.Guide = Guide

local function guideBlocked()
	return inMatch() or LocalPlayer:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil
end

-- the lobby world the trail can walk: the plaza, its islands, the ring street and the home plots on it, at lobby height
local function inLobbyWorld(pos)
	local L = Config.Lobby
	if typeof(pos) ~= "Vector3" or type(L) ~= "table" or typeof(L.Origin) ~= "Vector3" then
		return false
	end
	local dx, dz = pos.X - L.Origin.X, pos.Z - L.Origin.Z
	local reach = (L.SpotRingRadius or 340) + (L.PlotSize or 72)
	return dx * dx + dz * dz <= reach * reach and math.abs(pos.Y - L.Origin.Y) <= (L.ZoneBand or 80)
end

-- the target's prompt part in the lobby (looked up again while missing: the lobby may stream in)
local function guidePart()
	if G.part and G.part.Parent then
		return G.part
	end
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	local prompt = lobby and G.spec and lobby:FindFirstChild(G.spec.Prompt, true)
	local part = prompt and prompt.Parent
	G.part = (part and part:IsA("BasePart")) and part or nil
	return G.part
end

-- (the owner's pick B of 2026-11-23 on the guide chip pitch, "Top-bar plank", the X on the RIGHT; Gemini's left X was not
-- taken) the chip is the top bar pill's twin and stands at ONE home: Roblox's top band at its right end, its face
-- K.GUIDE_DOCK px left of TopbarInset's right end (the '...' room; read as the pill reads it) at the pill's own height and
-- row; a portrait phone (no room in the band) on the vitals stack, flush with the card's left edge, its ink K.GUIDE_STACK
-- px over the name plank (over the tutorial's quest strip when that docks there, over a touch key in its columns: clear
-- of RUN). It never moves, hides or changes its line on a camera move (but on a portrait phone it steps aside, hidden in
-- its place, while a world sign the camera brings stands on its spot: asideWanted): its home is read again only every K.LAYOUT_EVERY s
-- (the HUD, a turned phone) and on a new phase, and its width is fixed per phase (a three-digit stud count kept room
-- for). The travel guide's GuideSign is retired (its name and stud count are the chip's lines; the tutorial's own guide
-- keeps its sign); the gold arrow over the gate and the dot trail stay. The needle (guideNeedle) is PixelIcon's own
-- arrows, never a turned frame. Screen px throughout: the chip's ScreenGui ignores the gui inset, as the top bar's does.

-- the product of the UIScales on `inst` and its ancestors (what its stroke's Thickness is drawn at)
local function drawnScale(inst)
	local k, node = 1, inst
	while node and not node:IsA("ScreenGui") do
		for _, c in ipairs(node:GetChildren()) do
			if c:IsA("UIScale") then
				k = k * c.Scale
			end
		end
		node = node.Parent
	end
	return k
end

-- what `inst` draws, in screen px: its box and its border edge (a UIStroke outside the box) -> { x0, y0, x1, y1 }
local function inkRect(inst)
	local gui = inst:FindFirstAncestorOfClass("ScreenGui")
	local r = rectOf(inst, (gui and not gui.IgnoreGuiInset) and topInset() or 0)
	local s = inst:FindFirstChildOfClass("UIStroke")
	if s and s.Enabled and s.ApplyStrokeMode == Enum.ApplyStrokeMode.Border then
		local e = s.Thickness * drawnScale(inst)
		r = { x0 = r.x0 - e, y0 = r.y0 - e, x1 = r.x1 + e, y1 = r.y1 + e }
	end
	return r
end

-- the GuideSign on (both lines, or `short`: the name alone) or off; W.signGen counts its jumps
local function setSignShown(on, short)
	local gui = W.labelGui
	if not gui then
		return
	end
	if gui.Enabled ~= on then
		gui.Enabled = on
		W.signGen = (W.signGen or 0) + 1
	end
	short = on and short == true
	if (W.signShort == true) ~= short then
		W.signShort = short
		W.signGen = (W.signGen or 0) + 1
		layoutSign()
	end
end

-- the whole screen px of `v` design px at the screen factor (the pitch's px(): never under 1)
local function chipPx(v)
	return math.max(1, math.floor(v * (G.k or 1) + 0.5))
end

-- Roblox's top band: its height (K.GUIDE_BAND when the gui inset reads 0) and the free band's right end (TopbarInset,
-- else K.GUIDE_RIGHT_RESERVE px off the right edge: the '...' button), as TopBarController reads them
local function bandOf(vpX)
	local band = topInset()
	if band <= 0 then
		band = K.GUIDE_BAND
	end
	local right = vpX - K.GUIDE_RIGHT_RESERVE
	local ok, tb = pcall(function()
		return GuiService.TopbarInset
	end)
	if ok and typeof(tb) == "Rect" and tb.Min.X > 0 and tb.Max.X > tb.Min.X then
		right = tb.Max.X
	end
	return band, right
end

-- the pill's height and row in the band (TopBarController.relayout's own rule) -> h, y
local function pillRow(band)
	local touch = UserInputService.TouchEnabled == true
	local h = math.floor(math.clamp(band - (touch and 6 or 10), K.GUIDE_PILL_MIN, touch and K.GUIDE_PILL_TOUCH or K.GUIDE_PILL))
	return h, math.max(0, math.floor((band - h) / 2))
end

-- where the chip's face stands: its top-left in screen px, for a face `w` x `h` with a wood edge `e`
local function chipHome(w, h, e)
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	if not G.portrait then
		-- (the pill's row: its own height's middle of the band; a PC's ticket, a touch pill tall, the same rule)
		local band, right = bandOf(vp.X)
		return right - K.GUIDE_DOCK - w, math.max(0, math.floor((band - h) / 2))
	end
	-- the vitals stack: the card's left edge, the name plank's ink top (the quest strip's when it docks over it)
	local pg = playerGui()
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local vit = hud and hud:FindFirstChild("BottomLeft") and hud.BottomLeft:FindFirstChild("Vitals")
	local body = vit and vit:FindFirstChild("Body")
	local card = body and body:FindFirstChild("Card")
	local tab = body and body:FindFirstChild("NameTab")
	local x, foot = K.EDGE, vp.Y - K.EDGE
	if card and vit:IsA("GuiObject") and vit.AbsoluteSize.X > 0 and shownIn(vit, hud) then
		x = card.AbsolutePosition.X
		foot = inkRect(tab and tab.AbsoluteSize.X > 0 and tab or card).y0
	end
	-- (look:chipB major 3) never past the screen's K.EDGE gutter: paintChip shortens a ticket that would run past it
	-- (its 'NN studs'); this holds a chip whose short line still would not fit
	if w > 0 then
		x = math.max(K.EDGE + e, math.min(x, vp.X - K.EDGE - e - w))
	end
	local strip, over = UI.Strip, nil
	if strip and strip.Visible and strip.AbsoluteSize.Y > 0 and UI.Gui and shownIn(strip, UI.Gui) then
		local s = inkRect(strip)
		if s.y1 <= foot + 0.5 and s.y0 < foot and s.y0 > foot - 200 then
			over = s
		end
	end
	-- (clear of RUN) a touch key in the chip's columns that its spot meets: the chip stands over the key instead, by the
	-- key's ink (look:chipB: its block's 3 px wood edge is drawn outside the button's box; by the box the chip's foot
	-- stood 5 px over RUN's ink at 320 x 568, not GUIDE_STACK)
	local keys = {}
	local pgK = playerGui()
	local mobile = pgK and pgK:FindFirstChild("MobileControls")
	if mobile and mobile:IsA("ScreenGui") and mobile.Enabled then
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("GuiButton") and d.AbsoluteSize.X > 0 and shownIn(d, mobile) then
				local r = inkRect(d)
				for _, c in ipairs(d:GetDescendants()) do
					if c:IsA("GuiObject") and c.AbsoluteSize.X > 0 and shownIn(c, mobile) then
						local q = inkRect(c)
						r = { x0 = math.min(r.x0, q.x0), y0 = math.min(r.y0, q.y0), x1 = math.max(r.x1, q.x1), y1 = math.max(r.y1, q.y1) }
					end
				end
				keys[#keys + 1] = r
			end
		end
	end
	local function settle(f)
		local moved = true
		while moved do
			moved = false
			local y1 = f - K.GUIDE_STACK
			local y0 = y1 - h - 2 * e
			for _, r in ipairs(keys) do
				local ky0, ky1 = r.y0, r.y1
				if r.x0 < x + w + e + K.GUIDE_STACK and r.x1 > x - e - K.GUIDE_STACK and ky0 < y1 + K.GUIDE_STACK and ky1 > y0 - K.GUIDE_STACK and ky0 < f then
					f, moved = ky0, true
					break
				end
			end
		end
		return f
	end
	local under = foot
	foot = settle(over and over.y0 or foot)
	-- (look:chipB, 320 x 568 with the strip docked) no room over the strip under the menu column: the chip stood on its
	-- tiles and yielded its spot to them for the whole guide (spotClaimed). There it stands under the strip, at its own
	-- home over the name plank, when that is GUIDE_STACK clear of the strip; else over it as before
	if over then
		local pgM = playerGui()
		local menu = pgM and pgM:FindFirstChild("NimbusMenu")
		local col = menu and menu:FindFirstChild("MenuColumn", true)
		if col and col:IsA("GuiObject") and menu:IsA("ScreenGui") and col.AbsoluteSize.X > 1 and shownIn(col, menu) then
			local c, m = inkRect(col), K.GUIDE_PILL_GAP
			local y1 = foot - K.GUIDE_STACK
			local y0 = y1 - h - 2 * e
			if c.x0 < x + w + e + m and c.x1 > x - e - m and c.y0 < y1 + m and c.y1 > y0 - m then
				local f = settle(under)
				if f - K.GUIDE_STACK - h - 2 * e >= over.y1 + K.GUIDE_STACK then
					foot = f
				end
			end
		end
	end
	return x, foot - K.GUIDE_STACK - e - h
end

-- (Pitch 2 item 13 A; the pick's lines) the chip per phase: its mark's face and icon (the needle's arrows: guideNeedle),
-- the chip's lip, its two lines (`Info` with its widest reserve: the stud count's three digits), whether the X shows
local GUIDE_LOOK = {
	Walk = { Face = "Gold", Icon = "arrowup", Lip = "StoneLip", Close = true, Name = function(spec)
		return spec.Label
	end, Info = function(d, bar, short) -- (short: a ticket with no room for 'away', look:chipB major 3)
		return math.clamp(math.floor((d or 0) + 0.5), 0, 999) .. ((bar or short) and " studs" or " studs away")
	end, Reserve = function(bar, short)
		return (bar or short) and "888 studs" or "888 studs away"
	end },
	Home = { Face = "Gold", Icon = "house", Lip = "StoneLip", Close = true, Name = function()
		return "Home first"
	end, Info = function()
		return "then follow the arrow"
	end, Short = function() -- (a line that would run past the pill or the screen's gutters)
		return "then the arrow"
	end },
	Here = { Face = "Grass", Icon = "check", Lip = "GrassLip", Close = false, Name = function()
		return "You're here"
	end, Info = function()
		local CloudUI = mod("CloudUI")
		local ok, words = false, nil
		if CloudUI and type(CloudUI.PromptWords) == "function" then
			ok, words = pcall(CloudUI.PromptWords, false)
		end
		return (ok and type(words) == "string") and words or "press E"
	end },
}

-- the needle's sprite per sector (PixelIcon's own arrows) and the 45 degree sprite of a step between two of them
local NEEDLE_ICON = { ahead = "arrowup", right = "arrow", left = "left", behind = "arrowdown" }
local NEEDLE_STEP = {
	["ahead:right"] = "arrowne", ["ahead:left"] = "arrownw", ["right:behind"] = "arrowse", ["left:behind"] = "arrowsw",
}

-- a block's wood edge at `px` (whole screen px) and its lip at `lip` px
local function setBlockEdge(block, px, lip)
	local s = block:FindFirstChild("SignEdge")
	if s and s.Thickness ~= px then
		s.Thickness = px
		local crisp = mod("PixelCrisp")
		if crisp then
			crisp.Edge(s, px)
		end
	end
	local l = block:FindFirstChild("Lip")
	if l and lip and l.Size.Y.Offset ~= lip then
		l.Size = UDim2.new(1, 0, 0, lip)
	end
end

-- the mark's icon: re-hosted on its glyph (the attribute PixelIcon names it)
local function setMarkIcon(name)
	local glyph = G.glyph
	if glyph and G.sprite ~= name then
		G.sprite = name
		glyph:SetAttribute("PixelIcon", name)
		PixelIcon.Host(glyph, name, K.GUIDE_ICON)
	end
end

-- paints the chip for `phase` and lays it out in its form: the two-line ticket on a touch screen (the pill's height in
-- the band) and on a portrait phone (K.GUIDE_TICKET_H), the one-line bar (the 'NN studs' tag) on a PC; the place
-- (placeChip) is taken after it
local function paintChip(phase)
	local chip, look = G.chip, GUIDE_LOOK[phase]
	if not chip or not look then
		return
	end
	local ok, k = pcall(Theme.ScreenFactor)
	G.k = (ok and type(k) == "number" and k > 0) and k or 1
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	G.vp = vp
	G.portrait = vp.Y > vp.X
	local bar = not G.portrait and UserInputService.TouchEnabled ~= true
	local close = look.Close
	local name = look.Name(G.spec)
	local band = bandOf(vp.X)
	local pillH = pillRow(band)
	-- the sizes (screen px): the ticket's from the kit's design px at the screen factor, the bar's at the pill's own
	local e, h, lip, mk, pad, gap, ts, ss, tagged
	local function sizes()
		if bar then
			e, h, lip = K.GUIDE_BAR_EDGE, pillH, K.GUIDE_BAR_LIP
			mk, pad, gap = h - lip - 4, K.GUIDE_BAR_PAD, K.GUIDE_BAR_GAP
			ts, ss = K.GUIDE_BAR_NAME, K.GUIDE_BAR_INFO
		else
			e = (G.k < 1) and 2 or 3
			-- (a PC's ticket: a touch pill's height, as tall as the band allows: two lines want it)
			h = G.portrait and chipPx(K.GUIDE_TICKET_H) or math.max(pillH, math.min(K.GUIDE_PILL_TOUCH, band - 6))
			lip, mk, pad, gap = chipPx(K.GUIDE_LIP), chipPx(K.GUIDE_MARK), chipPx(K.GUIDE_PAD), chipPx(K.GUIDE_GAP)
			ts, ss = math.ceil(K.GUIDE_NAME * G.k - 1e-6), math.ceil(K.GUIDE_INFO * G.k - 1e-6)
		end
		-- (look:chipB minor 4) a PC's tag is the stud count's number cell: only the walk (a distance) wears it; Home /
		-- Here say their second line ('then follow the arrow', 'press E') as plain muted words after the name, as the
		-- ticket does
		tagged = bar and look.Reserve ~= nil
	end
	sizes()
	local function widthOf(info)
		local nw = math.ceil(textWidth(name, ts, "Heading"))
		local iw = math.ceil(textWidth(info, ss, "Heading"))
		if bar then
			local tagW = tagged and (iw + 2 * K.GUIDE_BAR_TAG_PAD) or iw
			return pad + mk + gap + nw + K.GUIDE_BAR_TAG_GAP + tagW + (close and (K.GUIDE_BAR_X_GAP + mk + pad) or K.GUIDE_BAR_X_GAP), nw, tagW
		end
		local tw = math.max(nw, iw)
		return pad + mk + gap + tw + (close and (gap + mk + pad) or gap), tw, 0
	end
	if look.Reserve and not G.distance then
		local root, part = rootPart(), guidePart()
		if root and part then
			G.distance = Vector3.new(part.Position.X - root.Position.X, 0, part.Position.Z - root.Position.Z).Magnitude
		end
	end
	local info = look.Info(G.distance, bar, false)
	local reserve = look.Reserve and look.Reserve(bar, false) or info
	local w, tw, tagW = widthOf(reserve)
	if bar then
		-- (look:chipB, travel_guide_clear's walk at 844 x 390 with no touch, red from 816badd: the one-line bar reached in
		-- to x 450, over the gold arrow at x 487 - 516; B's case is the arrow's lane kept free) a PC screen whose bar would
		-- start left of K.GUIDE_BAR_LANE of its width (a small window) wears the phones' two-line ticket instead
		local _, right = bandOf(vp.X)
		if right - K.GUIDE_DOCK - w - K.GUIDE_BAR_EDGE < vp.X * K.GUIDE_BAR_LANE then
			bar = false
			sizes()
			info = look.Info(G.distance, bar, false)
			reserve = look.Reserve and look.Reserve(bar, false) or info
			w, tw, tagW = widthOf(reserve)
		end
	end
	local face = h - lip
	local short = false
	if look.Short or (look.Reserve and not bar) then
		-- (a line that runs past the pill, or past the screen's right gutter on a portrait phone) the short one: Home's
		-- 'then the arrow'; (look:chipB major 3: at 320 x 568 the ticket stood flush with a vitals card standing right of
		-- the menu, its ink 3 px from the screen's right edge, 7 px past the card) the walk's 'NN studs' (minor 3: the walk
		-- now reads the pill's room in the band too; the band holds it at every screen of the pick, 568 x 320 too)
		local pg = playerGui()
		local pillGui = pg and pg:FindFirstChild("NimbusTopBar")
		local pillRight = pillGui and tonumber(pillGui:GetAttribute("PillRight")) or 0
		local _, right = bandOf(vp.X)
		local room = right - K.GUIDE_DOCK - pillRight - 2 * e - K.GUIDE_PILL_GAP
		if G.portrait then
			room = vp.X - K.EDGE - chipHome(0, h, e)
		end
		if w + 2 * e > room then
			short = true
			info = look.Short and look.Short(G.spec) or look.Info(G.distance, bar, true)
			reserve = look.Reserve and look.Reserve(bar, true) or info
			w, tw, tagW = widthOf(reserve)
		end
	end
	G.look, G.bar, G.e, G.h, G.w, G.short = look, bar, e, h, w, short
	chip.Size = UDim2.fromOffset(w, h)
	setBlockEdge(chip, e, lip)
	local chipLip = chip:FindFirstChild("Lip")
	if chipLip then
		chipLip.BackgroundColor3 = SIGN[look.Lip] or SIGN.StoneLip
	end
	-- the mark (the needle, the house, the check) and its brass pin (Gemini's touch: the needle's pivot cell in gold)
	local my = math.floor((face - mk) / 2)
	local markFace = SIGN[look.Face] or SIGN.Gold
	G.mark.BackgroundColor3 = markFace
	G.mark.Position = UDim2.fromOffset(pad, my)
	G.mark.Size = UDim2.fromOffset(mk, mk)
	setBlockEdge(G.mark, 2, bar and 3 or chipPx(3))
	local markLip = G.mark:FindFirstChild("Lip")
	if markLip then
		markLip.BackgroundColor3 = Theme.SignLipOf(markFace)
	end
	local ix, iy = math.floor(mk / 2) - math.floor(K.GUIDE_ICON / 2), math.floor(mk / 2) - 1 - math.floor(K.GUIDE_ICON / 2)
	G.iconHolder.Position = UDim2.fromOffset(ix, iy)
	G.glyph.TextColor3 = (look.Face == "Grass") and SIGN.OnGrass or SIGN.Text
	G.pin.Position = UDim2.fromOffset(ix + 4 * K.GUIDE_ICON / 9, iy + 4 * K.GUIDE_ICON / 9)
	G.pin.Size = UDim2.fromOffset(K.GUIDE_ICON / 9, K.GUIDE_ICON / 9)
	if phase == "Walk" then
		G.needle = G.needle or "ahead"
		chip:SetAttribute("Needle", G.needle)
		setMarkIcon(G.stepIcon or NEEDLE_ICON[G.needle])
		G.pin.Visible = true
	else
		G.needle, G.stepIcon, G.stepTo, G.stepLeft = nil, nil, nil, nil
		chip:SetAttribute("Needle", nil)
		setMarkIcon(look.Icon)
		G.pin.Visible = false
	end
	-- the lines: the place over its distance (the ticket), or the place and its tag (the bar)
	local tx = pad + mk + gap
	G.place.TextSize = ts
	G.place.Text = name
	G.info.TextSize = ss
	G.info.Text = info
	G.info.TextColor3 = tagged and SIGN.Text or SIGN.TextMuted
	local lh, ih = ts + 4, ss + 4
	if bar and not tagged then
		-- (minor 4) Home / Here on a PC: the name, then its second line in plain muted words, no number cell
		G.place.Position = UDim2.fromOffset(tx, math.floor((face - lh) / 2))
		G.place.Size = UDim2.fromOffset(tw + 2, lh)
		G.tag.Visible = false
		G.info.Parent = chip
		G.info.TextXAlignment = Enum.TextXAlignment.Left
		G.info.Position = UDim2.fromOffset(tx + tw + K.GUIDE_BAR_TAG_GAP, math.floor((face - ih) / 2))
		G.info.Size = UDim2.fromOffset(tagW + 2, ih)
	elseif bar then
		G.place.Position = UDim2.fromOffset(tx, math.floor((face - lh) / 2))
		G.place.Size = UDim2.fromOffset(tw + 2, lh)
		local tagH = K.GUIDE_BAR_TAG_H
		G.tag.Visible = true
		G.tag.Position = UDim2.fromOffset(tx + tw + K.GUIDE_BAR_TAG_GAP, math.floor((face - tagH) / 2))
		G.tag.Size = UDim2.fromOffset(tagW, tagH)
		G.info.Parent = G.tag
		G.info.TextXAlignment = Enum.TextXAlignment.Center
		G.info.Position = UDim2.fromOffset(0, math.floor((tagH - ih) / 2))
		G.info.Size = UDim2.fromOffset(tagW, ih)
	else
		G.place.Position = UDim2.fromOffset(tx, math.floor(face * 0.30 - lh / 2 + 0.5))
		G.place.Size = UDim2.fromOffset(tw + 2, lh)
		G.tag.Visible = false
		G.info.Parent = chip
		G.info.TextXAlignment = Enum.TextXAlignment.Left
		G.info.Position = UDim2.fromOffset(tx, math.floor(face * 0.75 - ih / 2 + 0.5))
		G.info.Size = UDim2.fromOffset(tw + 2, ih)
	end
	-- the X: the red block (as big as the mark) in a transparent K.GUIDE_CLOSE px button round it
	local hit = K.GUIDE_CLOSE
	local inset = math.floor((hit - mk) / 2)
	local xx = w - pad - mk
	G.close.Visible = close
	G.close.Size = UDim2.fromOffset(hit, hit)
	G.close.Position = UDim2.fromOffset(xx - inset, my - inset)
	G.closeFace.Position = UDim2.fromOffset(inset, inset)
	G.closeFace.Size = UDim2.fromOffset(mk, mk)
	G.xIcon.Position = UDim2.fromOffset(ix, iy)
	setBlockEdge(G.closeFace, 2, bar and 3 or chipPx(3))
	local crisp = mod("PixelCrisp")
	if crisp and type(crisp.Refresh) == "function" then
		pcall(crisp.Refresh, chip)
	end
	G.home = nil
	G.placeTimer = 0
end

-- (look:chipB major 2, and the states the B pins had not met) the cards that take the chip's spot for a while, each
-- its ScreenGui and its part (its shown children counted: an invite card, a menu tile): a dungeon party's chip
-- (DungeonController's RunChip, a phone's party countdown with its window closed: "Starting in 24 - press READY" /
-- "Dungeon in 5...", from the pill to '...' in the band), an NPC's dialog (it reaches the band on a landscape phone, the
-- vitals stack on a portrait one), the arena's side card (a duel invite, the queue), and on a portrait phone a portal
-- party's panel with the menu column and the wallet strips it pushes down onto the vitals stack
local SPOT_CLAIMS = {
	{ "NimbusDungeonRun", "RunChip" },
	{ "NimbusNpcDialog", "NpcDialog" },
	{ "NimbusArenaSide", "SideStack" },
	{ "NimbusMenu", "MenuColumn" },
	{ "NimbusHud", "PartyPanel" },
	{ "NimbusHud", "Currency" },
	-- (an open Shop: at 960 x 540 its awning, seated over the window's top, reaches into the band 1 px under the chip)
	{ "NimbusShop", "ShopWindow" },
}
local SPOT_HOLD = 12 -- (no flicker) a yielded chip comes back only this far clear: the party chip is fitted to its words

-- where one of SPOT_CLAIMS would meet the chip's home (ink K.GUIDE_PILL_GAP px round: battle_hud_no_overlap's MIN_GAP)
-- the chip yields its spot - hidden, the guide still running (the arrow and the trail stay), back once the card goes. A
-- HUD state, never a camera move; each of these is the moment's word (a party about to start, a talk, an invite).
-- Was: drawn over the dungeon party's chip (13 over 12) until the run began, over the NPC's dialog, the invite card,
-- under the menu tiles a full portal party pushes down at 360 x 640
local function spotClaimed()
	local home = G.home
	if not (home and G.w and G.h and G.e) then
		return false
	end
	local pg = playerGui()
	if not pg then
		return false
	end
	local m = K.GUIDE_PILL_GAP + (G.yielded and SPOT_HOLD or 0)
	local x0, y0 = home.x - G.e - m, home.y - G.e - m
	local x1, y1 = home.x + G.w + G.e + m, home.y + G.h + G.e + m
	-- what a part draws, not its box (the arena's empty side stack is an 8 px transparent list across the vitals stack)
	local function draws(o)
		if o.BackgroundTransparency < 0.99 or o:FindFirstChildOfClass("UIStroke") then
			return true
		end
		if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" and o.ImageTransparency < 0.99 then
			return true
		end
		return (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text ~= "" and o.TextTransparency < 0.99
	end
	local function meets(obj)
		if not (obj:IsA("GuiObject") and obj.Visible) then
			return false
		end
		local r = inkRect(obj)
		local hit = r.x0 < x1 and x0 < r.x1 and r.y0 < y1 and y0 < r.y1
		if hit and obj.AbsoluteSize.X > 1 and obj.AbsoluteSize.Y > 1 and draws(obj) then
			return true
		end
		if obj.ClipsDescendants and not hit then
			return false -- (its children are cut to its box: a window's scrolling page is not walked)
		end
		for _, c in ipairs(obj:GetChildren()) do
			if meets(c) then
				return true
			end
		end
		return false
	end
	G.claimRefs = G.claimRefs or {}
	for i, claim in ipairs(SPOT_CLAIMS) do
		local gui = pg:FindFirstChild(claim[1])
		local obj = G.claimRefs[i]
		if not (obj and gui and obj:IsDescendantOf(gui)) then
			obj = gui and gui:FindFirstChild(claim[2], true)
			G.claimRefs[i] = obj
		end
		if obj and obj:IsA("GuiObject") and gui:IsA("ScreenGui") and shownIn(obj, gui) and meets(obj) then
			return true
		end
	end
	return false
end

-- (the owner's pick of 2026-11-24 for PORTRAIT phones, "steps aside for signs"; look:chipB: with the tutorial's strip
-- docked the chip stood under the gate's 'TAP Enter' plank, its X on the plank, and a camera tilt or an NPC's 'Talk'
-- brought a plank onto it) a world sign - the kit's prompt planks, PromptController's PromptCard billboards in the
-- PlayerGui: the gate's 'TAP Enter', an NPC's 'Talk', any that shows - standing within GUIDE_SIGN_KEEP px of the chip's spot
-- (its ink and its X's GUIDE_CLOSE px target, where it is drawn) takes the spot, as a card does (spotClaimed): the chip
-- hides, its X with it (a tap on the sign never cancels the guide), the guide still running. Read every
-- GUIDE_NEEDLE_STEP s; back only once its spot has been SPOT_HOLD px clear of every sign for GUIDE_SIGN_DWELL s on end
-- (no flicker: the owner's pick of 2026-11-25, was no sooner than that after it stepped aside), in the same place: it
-- never moves to dodge. A sign the camera carries is kept off by twice its move since the last read more (where it is by the next read: it never reaches the chip between two reads). Landscape screens and
-- a PC keep the band as they are: never aside there

-- a shown prompt plank's rect on the screen (viewport px: the chip's ScreenGui ignores the inset) as the engine draws a
-- pixel billboard: its adornee's point, StudsOffsetWorldSpace and StudsOffset (the camera's axes), Size px round it
local function signRect(cam, card)
	local ad = card.Adornee
	if not (card.Enabled and ad) then
		return nil
	end
	local p = nil
	if ad:IsA("BasePart") then
		p = ad.Position
	elseif ad:IsA("Attachment") then
		p = ad.WorldPosition
	else
		return nil
	end
	local cf = cam.CFrame
	local so = card.StudsOffset
	p = p + card.StudsOffsetWorldSpace + cf.RightVector * so.X + cf.UpVector * so.Y - cf.LookVector * so.Z
	if card.MaxDistance > 0 and (p - cf.Position).Magnitude > card.MaxDistance then
		return nil
	end
	local v = cam:WorldToViewportPoint(p)
	if v.Z <= 0 then
		return nil
	end
	local w, h = card.Size.X.Offset, card.Size.Y.Offset
	local x0 = v.X - w / 2 + card.SizeOffset.X * w
	local y0 = v.Y - h / 2 - card.SizeOffset.Y * h
	return { x0 = x0, y0 = y0, x1 = x0 + w, y1 = y0 + h }
end

-- each shown plank on the screen now -> { [card] = rect }
local function signsNow()
	local out = {}
	local pg, cam = playerGui(), Workspace.CurrentCamera
	if not (pg and cam) then
		return out
	end
	for _, c in ipairs(pg:GetChildren()) do
		if c.Name == "PromptCard" and c:IsA("BillboardGui") then
			local ok, r = pcall(signRect, cam, c)
			if ok and r then
				out[c] = r
			end
		end
	end
	return out
end

-- (at the timed read) each plank's move since the last read: the margin a sign the camera carries is kept off by
local function trackSigns()
	if not G.portrait then
		G.signSeen = nil
		return
	end
	local seen = signsNow()
	for c, r in pairs(seen) do
		local last = G.signSeen and G.signSeen[c]
		r.move = last and math.max(math.abs(r.x0 - last.x0), math.abs(r.y0 - last.y0)) or 0
	end
	G.signSeen = seen
end

-- whether the chip stands aside for a sign now (a portrait screen): one within the keep of its spot where it is drawn,
-- or, once aside, its spot clear of every sign for less than GUIDE_SIGN_DWELL s
local function asideWanted()
	if not (G.portrait and G.home and G.w and G.h and G.e) then
		return false
	end
	local lift = math.floor((G.slide or 0) * (G.h + 2 * G.e) + 0.5)
	local x, y = G.home.x, G.home.y - lift
	local s = { x0 = x - G.e, y0 = y - G.e, x1 = x + G.w + G.e, y1 = y + G.h + G.e }
	local close = G.close
	if close and close.Visible then
		local p, z = close.Position, close.Size
		s.x0, s.y0 = math.min(s.x0, x + p.X.Offset), math.min(s.y0, y + p.Y.Offset)
		s.x1, s.y1 = math.max(s.x1, x + p.X.Offset + z.X.Offset), math.max(s.y1, y + p.Y.Offset + z.Y.Offset)
	end
	local keep = K.GUIDE_SIGN_KEEP + (G.aside and SPOT_HOLD or 0)
	for c, r in pairs(signsNow()) do
		local last = G.signSeen and G.signSeen[c]
		local m = keep + 2 * (last and last.move or 0)
		if r.x0 < s.x1 + m and s.x0 - m < r.x1 and r.y0 < s.y1 + m and s.y0 - m < r.y1 then
			G.signAt = S.clock -- (the owner's pick of 2026-11-25) the spot's last read with a sign on it
			return true
		end
	end
	-- (the owner's pick of 2026-11-25; look:portrait: counted from when it hid, a sign that left for a moment - a jump,
	-- a quick tilt - let it back for 0.07 - 0.2 s) back only once the spot has been clear for the hold on end
	return G.aside == true and S.clock - (G.signAt or 0) < K.GUIDE_SIGN_DWELL - 1e-6
end

-- the chip at its home (read again every K.LAYOUT_EVERY s, never on a camera move); the "You're here" slide lifts it
local function placeChip()
	local chip = G.chip
	if not (chip and G.w) then
		return
	end
	local x, y = chipHome(G.w, G.h, G.e)
	G.home = { x = math.floor(x + 0.5), y = math.floor(y + 0.5) }
	G.yielded = spotClaimed()
	local aside = asideWanted()
	if aside ~= (G.aside == true) then
		G.aside = aside
	end
	local lift = math.floor((G.slide or 0) * (G.h + 2 * G.e) + 0.5)
	chip.Position = UDim2.fromOffset(G.home.x, G.home.y - lift)
	chip.Visible = (G.slide or 0) < 1 and not G.yielded and not G.aside
end

local function buildChip()
	local pg = playerGui()
	if not pg then
		return false
	end
	local gui = make("ScreenGui", "NimbusGuide", {
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = K.GUIDE_ORDER,
	}, nil)
	local chip = box("Chip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Size = UDim2.fromOffset(200, 48),
		ZIndex = 2,
	}, gui)
	edge(chip, SIGN.Wood, 2)
	lipOf(chip, SIGN.StoneLip, 4)
	local mark = box("Mark", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Gold,
		Size = UDim2.fromOffset(27, 27),
		ZIndex = 3,
	}, chip)
	edge(mark, SIGN.Wood, 2)
	lipOf(mark, SIGN.GoldLip, 2)
	local holder, glyph = crispIcon(mark, "arrowup", K.GUIDE_ICON, SIGN.Text, {
		Name = "Icon",
		ZIndex = 5,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(4, 3),
	})
	G.iconHolder, G.glyph, G.sprite = holder, glyph, "arrowup"
	G.pin = box("Pin", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, ZIndex = 6 }, mark)
	local function line(nm)
		return label(chip, nm, "", "Heading", 18, SIGN.Text, {
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextScaled = false,
			TextWrapped = false,
			TextTruncate = Enum.TextTruncate.None,
			ZIndex = 4,
		})
	end
	G.place = line("Place")
	G.info = line("Info")
	-- (the bar) the stud count's tag: the vitals card's own number cell, a Well face in its WellEdge line
	local tag = box("Tag", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.WellEdge, ZIndex = 3, Visible = false }, chip)
	box("Face", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Well,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
		ZIndex = 3,
	}, tag)
	G.tag = tag
	local close = make("TextButton", "Close", {
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 4,
	}, chip)
	local closeFace = box("Face", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Red,
		ZIndex = 4,
		Active = false,
	}, close)
	edge(closeFace, SIGN.Wood, 2)
	lipOf(closeFace, SIGN.RedLip, 2)
	G.xIcon = crispIcon(closeFace, "x", K.GUIDE_ICON, SIGN.Text, {
		Name = "Icon",
		ZIndex = 5,
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.fromOffset(4, 3),
	})
	close.Activated:Connect(function()
		Guide.Stop()
	end)
	G.gui, G.chip, G.mark, G.close, G.closeFace = gui, chip, mark, close, closeFace
	gui.Parent = pg
	return true
end

function Guide.Stop()
	local was = G.active
	G.active = false
	G.phase, G.id, G.spec, G.target, G.part = nil, nil, nil, nil, nil
	G.slide, G.hereUntil, G.placeTimer, G.home, G.distance, G.distTimer, G.yielded = nil, nil, nil, nil, nil, nil, nil
	G.claimTimer, G.claimRefs, G.aside, G.signSeen, G.signAt = nil, nil, nil, nil, nil
	G.needle, G.stepIcon, G.stepTo, G.stepLeft, G.sprite = nil, nil, nil, nil, nil
	G.look, G.bar, G.e, G.h, G.w, G.k, G.vp, G.portrait, G.short = nil, nil, nil, nil, nil, nil, nil, nil, nil
	if G.gui then
		G.gui:Destroy()
	end
	G.gui, G.chip, G.mark, G.close, G.closeFace, G.place, G.info, G.tag = nil, nil, nil, nil, nil, nil, nil, nil
	G.iconHolder, G.glyph, G.pin, G.xIcon = nil, nil, nil, nil
	-- (the tutorial's own guide keeps its two-line sign)
	setSignShown(true, false)
	if was then
		-- the world guide and the pointer go with it (the tutorial's own target, if any, comes back on its next frame)
		setWorldActive(false)
		W.key = nil
		hidePointer()
		M.findTimer = 0
	end
end

local function setPhase(phase)
	if G.phase == phase then
		return
	end
	G.phase = phase
	W.key = nil
	M.findTimer = 0
	safe("guide chip", paintChip, phase)
	safe("guide chip", placeChip)
end

-- the distance the chip shows (straight to the gate, on the ground: one measure from the first frame, so standing still
-- it never changes), read every K.GUIDE_READ_EVERY s; the chip's width already holds three digits, so a new number never
-- moves it
local function readDistance(dt)
	G.distTimer = (G.distTimer or 0) - dt
	if G.distTimer > 0 then
		return
	end
	G.distTimer = K.GUIDE_READ_EVERY
	local root = rootPart()
	local part = guidePart()
	local d = nil
	if root and part then
		d = Vector3.new(part.Position.X - root.Position.X, 0, part.Position.Z - root.Position.Z).Magnitude
	end
	G.distance = d
	if G.phase == "Walk" and G.info and G.look then
		local text = G.look.Info(d, G.bar, G.short)
		if G.info.Text ~= text then
			G.info.Text = text
		end
	end
end

-- one frame of the travel guide (TutorialController.Step, before the pointer and the world guide)
local function updateTravel(dt)
	if not G.active then
		return
	end
	if guideBlocked() then
		Guide.Stop()
		return
	end
	-- (the pick) the GuideSign is retired while the travel guide runs: its words are the chip's (a world guide built
	-- again after the start is hidden too)
	if W.labelGui and W.labelGui.Enabled then
		setSignShown(false)
	end
	-- (major 2) a card coming to or going from the chip's spot (spotClaimed), and (the owner's portrait pick of 2026-11-24)
	-- a sign: read at the kit's step, 1/15 s
	G.claimTimer = (G.claimTimer or 0) - dt
	if G.home and G.claimTimer <= 0 then
		G.claimTimer = K.GUIDE_NEEDLE_STEP
		safe("guide signs", trackSigns)
		local okB, claimed = pcall(spotClaimed)
		local okS, aside = pcall(asideWanted)
		if (okB and (claimed == true) ~= (G.yielded == true)) or (okS and (aside == true) ~= (G.aside == true)) then
			safe("guide chip", placeChip)
		end
	end
	if G.phase == "Here" then
		local left = (G.hereUntil or 0) - S.clock
		local slide = 0
		if left <= K.GUIDE_SLIDE / 2 then
			slide = 1
		elseif left <= K.GUIDE_SLIDE then
			slide = 0.5
		end
		if slide ~= (G.slide or 0) then
			G.slide = slide
			safe("guide chip", placeChip)
		end
		if left <= 0 then
			Guide.Stop()
		end
		return
	end
	local root = rootPart()
	local pos = root and root.Position
	if pos and G.id == "StormAltar" and type(Config.AtAltar) == "function" and Config.AtAltar(pos) == true then
		Guide.Stop() -- already through the gate: the altar's own prompts take over
		return
	end
	if pos and inLobbyWorld(pos) then
		local part = guidePart()
		local d = part and Vector3.new(part.Position.X - pos.X, 0, part.Position.Z - pos.Z).Magnitude
		if d and d <= K.GUIDE_ARRIVE then
			G.hereUntil = S.clock + K.GUIDE_HERE
			G.slide = 0
			setPhase("Here")
			return
		end
		setPhase("Walk")
	elseif pos then
		setPhase("Home")
	end
	safe("guide distance", readDistance, dt)
	G.placeTimer = (G.placeTimer or 0) - dt
	if G.placeTimer <= 0 then
		G.placeTimer = K.LAYOUT_EVERY
		-- a new screen size (a turned phone) repaints the chip in its form; else its home follows the HUD
		local okK, k = pcall(Theme.ScreenFactor)
		local cam = Workspace.CurrentCamera
		local vp = cam and cam.ViewportSize
		if (okK and k ~= G.k) or (vp and G.vp and vp ~= G.vp) then
			safe("guide chip", paintChip, G.phase)
		end
		safe("guide chip", placeChip)
	end
end

-- (the pick, the needle) where the gate is, read every frame after the world guide (its arrow's hop this frame): the
-- needle rests on 'ahead' while the gate or its arrow is on the screen (8 px in); off it, the sector of the gate's
-- bearing from the camera (ahead within the screen's half width, right / left, behind from K.GUIDE_BEHIND degrees), a
-- new sector taken only K.GUIDE_HOLD_DEG degrees past its edge (no chatter there). A change shows the 45 degree sprite
-- between for K.GUIDE_NEEDLE_STEP s, then the new one: two hard steps, no tween, never a turned frame
local function guideNeedle(dt)
	if not (G.active and G.phase == "Walk" and G.chip and G.needle) then
		return
	end
	if G.stepTo then
		G.stepLeft = (G.stepLeft or 0) - dt
		if G.stepLeft <= 1e-6 then
			G.stepIcon, G.stepTo = nil, nil
			setMarkIcon(NEEDLE_ICON[G.needle])
		end
	end
	local cam = Workspace.CurrentCamera
	local part = guidePart()
	if not (cam and part) then
		return
	end
	local vp = cam.ViewportSize
	local function onScreen(p)
		local ok, v = pcall(cam.WorldToViewportPoint, cam, p)
		return ok and typeof(v) == "Vector3" and v.Z > 0 and v.X >= 8 and v.X <= vp.X - 8 and v.Y >= 8 and v.Y <= vp.Y - 8
	end
	local want = nil
	local on = onScreen(part.Position)
	if not on and W.active and W.arrowParts and #W.arrowParts > 0 then
		local mid = Vector3.new()
		for _, p in ipairs(W.arrowParts) do
			mid = mid + p.Position
		end
		on = onScreen(mid / #W.arrowParts)
	end
	local prev = G.needle
	-- (look:chipB minor 6) the gate's bearing on the ground: the camera's heading, its pitch left out (in camera space a
	-- steep look up or down swelled a small turn: 9 degrees off read 48 at a 72 degree look up, the needle 'right' with the
	-- gate ahead, and a gate under the view could read 'behind'). A camera looking straight up or down takes its heading
	-- from the screen's up (down: ahead; up: behind)
	local function flat()
		local cf = cam.CFrame
		local look = cf.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		if fwd.Magnitude < 0.05 then
			local up = cf.UpVector
			fwd = Vector3.new(up.X, 0, up.Z) * ((look.Y < 0) and 1 or -1)
		end
		if fwd.Magnitude < 1e-6 then
			return 0, -1
		end
		fwd = fwd.Unit
		local to = part.Position - cf.Position
		-- (x: right of the heading, z: -ahead, as in camera space)
		return to.X * -fwd.Z + to.Z * fwd.X, -(to.X * fwd.X + to.Z * fwd.Z)
	end
	if on then
		want = "ahead"
	else
		local vx, vz = flat()
		local v = { X = vx, Z = vz }
		local b = math.deg(math.atan2(v.X, -v.Z))
		local ab = math.abs(b)
		local half = math.deg(math.atan(math.tan(math.rad(cam.FieldOfView / 2)) * vp.X / math.max(1, vp.Y)))
		local hold = K.GUIDE_HOLD_DEG
		local side = (b > 0) and "right" or "left"
		local function sector(aheadTo, behindFrom)
			if ab >= behindFrom then
				return "behind"
			elseif ab > aheadTo then
				return side
			end
			return "ahead"
		end
		want = sector(half, K.GUIDE_BEHIND)
		if want ~= prev then
			-- (the hold) the sector it holds keeps it until the bearing is K.GUIDE_HOLD_DEG past that sector's edge
			local held = sector(prev == "ahead" and half + hold or half - hold, prev == "behind" and K.GUIDE_BEHIND - hold or K.GUIDE_BEHIND + hold)
			if held == prev then
				want = prev
			end
		end
	end
	if want and want ~= prev then
		G.needle = want
		G.chip:SetAttribute("Needle", want)
		local step = NEEDLE_STEP[prev .. ":" .. want] or NEEDLE_STEP[want .. ":" .. prev]
		if not step then
			-- (a half turn: the side the gate went round; right <-> left: over the way it went, ahead or behind)
			local vx, vz = flat()
			if (prev == "ahead" and want == "behind") or (prev == "behind" and want == "ahead") then
				step = NEEDLE_ICON[(vx > 0) and "right" or "left"]
			else
				step = NEEDLE_ICON[(vz < 0) and "ahead" or "behind"]
			end
		end
		G.stepIcon, G.stepTo, G.stepLeft = step, want, K.GUIDE_NEEDLE_STEP
		setMarkIcon(step)
	end
end

function Guide.Start(id)
	local spec = GUIDE_TARGETS[id]
	if not spec or guideBlocked() then
		return false
	end
	-- a second start replaces the first: the running guide's chip is kept (repainted, no second chip) and its state reset
	local keep = G.active and G.gui ~= nil and G.gui.Parent ~= nil
	if not keep then
		Guide.Stop()
	end
	G.active, G.id, G.spec = true, id, spec
	G.target = { Kind = spec.Kind, Id = spec.Id, Label = spec.Label, Prompt = spec.Prompt }
	G.phase, G.part, G.slide, G.hereUntil = nil, nil, nil, nil
	W.key = nil
	G.needle, G.stepIcon, G.stepTo, G.stepLeft, G.distance, G.distTimer = nil, nil, nil, nil, nil, nil
	if not keep then
		local ok, built = pcall(buildChip)
		if not (ok and built) then
			Guide.Stop()
			return false
		end
	end
	local root = rootPart()
	setPhase((root and inLobbyWorld(root.Position)) and "Walk" or "Home")
	updateTravel(0)
	ensureLoop()
	return G.active == true
end

function Guide.Active()
	return G.active and G.id or nil
end

function Guide.Phase()
	return G.active and G.phase or nil
end

local function applyState(payload)
	if type(payload) ~= "table" or not UI.Root then
		return
	end
	local prev = S.state
	local st = sanitize(payload)
	S.state = st
	if st.Done then
		if st.Completed and prev and not prev.Done and not S.finale then
			-- just finished: a last word from Nimbus, a big burst, then the card leaves
			S.finaleUntil = S.clock + K.FINALE_SECONDS
			renderFinale(st.Reward)
			if not S.shown then
				setPanelShown(true)
			end
			celebrate(true)
		elseif not S.finale then
			setPanelShown(false)
		end
		ensureLoop()
		return
	end
	if S.finale then
		-- a tutorial running again after the finale (the developer tools' restart): the card and the guide come back
		S.finale = false
		S.finaleUntil = nil
	end
	local changed = not prev or prev.Done or prev.Id ~= st.Id or prev.Step ~= st.Step or prev.Text ~= st.Text
	if changed then
		local advanced = prev ~= nil and not prev.Done and st.Step > prev.Step
		if S.manual == "collapsed" then
			S.manual = nil -- new words from Nimbus unfold the card again (an expanded card stays expanded)
		end
		renderStep()
		if advanced then
			celebrate(false)
		end
		if R.checkOpenWindows then
			task.defer(R.checkOpenWindows)
		end
	else
		UI.Hint.Text = hintText()
	end
	if not prev then
		S.showAfter = S.clock + K.FIRST_SHOW_DELAY
	end
	W.key = nil -- re-resolve the world target (the position may have arrived)
	M.findTimer = 0
	ensureLoop()
end

-- where each covering window (Cover.WINDOWS) draws: its ScreenGui; of NimbusMenu (it holds the menu column too) and of
-- NimbusMainMenu (the title screen's board too; C17 review 2) only the Window_ frames, of NimbusDungeonRun (its run card)
-- only the party's chip
Cover.GUIS = {
	{ "NimbusMenu", Prefix = "Window_" }, { "NimbusPets" }, { "NimbusShop" }, { "NimbusHatch" }, { "NimbusIndex" },
	{ "NimbusDaily" }, { "NimbusNpcDialog" }, { "NimbusDungeonRun", Part = "RunChip" }, { "NimbusArena" }, { "NimbusDungeon" },
	{ "NimbusCare" }, { "NimbusTrain" }, { "NimbusFusion" }, { "NimbusTrove" }, { "NimbusRaidGate" }, { "NimbusObby" },
	{ "NimbusLoss" }, { "NimbusPetPicker" }, { "NimbusMainMenu", Prefix = "Window_" },
}

-- what a part draws, not its box (as spotClaimed reads it: a window's holder is a transparent frame over the screen)
function Cover.drawn(o)
	if o.BackgroundTransparency < 0.99 or o:FindFirstChildOfClass("UIStroke") then
		return true
	end
	if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and o.Image ~= "" and o.ImageTransparency < 0.99 then
		return true
	end
	return (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text ~= "" and o.TextTransparency < 0.99
end

-- true when `obj` (shown) or a shown part under it draws ink meeting `box` (screen px; a clipping part's children are cut
-- to its box, so one clear of `box` is not walked)
function Cover.meets(obj, box)
	if not (obj:IsA("GuiObject") and obj.Visible) then
		return false
	end
	local r = inkRect(obj)
	local hit = r.x0 < box.x1 and box.x0 < r.x1 and r.y0 < box.y1 and box.y0 < r.y1
	if hit and obj.AbsoluteSize.X > 1 and obj.AbsoluteSize.Y > 1 and Cover.drawn(obj) then
		return true
	end
	if obj.ClipsDescendants and not hit then
		return false
	end
	for _, c in ipairs(obj:GetChildren()) do
		if Cover.meets(c, box) then
			return true
		end
	end
	return false
end

-- the guide's ink where it rests (the card with its name plank and portrait, or the strip; the slide's offset taken off,
-- so its slide-in reads as its place), screen px; nil while it is not up
function Cover.guideInk()
	local slide, root = UI.Slide, UI.Root
	if not (slide and root and root.Visible) then
		return nil
	end
	local box = nil
	local function walk(o)
		for _, c in ipairs(o:GetChildren()) do
			if c:IsA("GuiObject") and c.Visible then
				if c.AbsoluteSize.X > 1 and c.AbsoluteSize.Y > 1 and Cover.drawn(c) then
					local r = inkRect(c)
					box = box and { x0 = math.min(box.x0, r.x0), y0 = math.min(box.y0, r.y0), x1 = math.max(box.x1, r.x1), y1 = math.max(box.y1, r.y1) } or r
				end
				walk(c)
			end
		end
	end
	walk(slide)
	if not box then
		return nil
	end
	local dx = slide.Position.X.Offset * math.max(0.01, UI.Scale.Scale)
	return { x0 = box.x0 - dx, y0 = box.y0, x1 = box.x1 - dx, y1 = box.y1 }
end

-- a covering window's ink meets the guide's (the strip beside the docked Ring window at 1920 x 1080 stays; the Ring window
-- over the strip at 667 x 375, or the Pets window over its right end at 1920 x 1080, does not)
function Cover.underWindow()
	local pg = playerGui()
	local box = pg and Cover.guideInk()
	if not box then
		return false
	end
	for _, spec in ipairs(Cover.GUIS) do
		local gui = pg:FindFirstChild(spec[1])
		if gui and gui:IsA("ScreenGui") and gui.Enabled then
			if spec.Part then
				local part = gui:FindFirstChild(spec.Part, true)
				if part and part:IsA("GuiObject") and shownIn(part, gui) and Cover.meets(part, box) then
					return true
				end
			else
				for _, c in ipairs(gui:GetChildren()) do
					if (not spec.Prefix or c.Name:sub(1, #spec.Prefix) == spec.Prefix) and Cover.meets(c, box) then
						return true
					end
				end
			end
		end
	end
	return false
end

-- One frame of every tutorial visual (RenderStepped). Public so tests can drive it.
function TutorialController.Step(dt)
	dt = math.min(tonumber(dt) or 0, 0.25)
	S.clock = S.clock + dt
	local t = S.clock

	S.layoutTimer = S.layoutTimer + dt
	if S.layoutTimer >= K.LAYOUT_EVERY then
		S.layoutTimer = 0
		safe("layout", layout)
	end
	if S.finale and S.clock >= (S.finaleUntil or 0) and S.shown then
		setPanelShown(false)
	end
	local wanted = panelWanted()
	if wanted ~= (S.shown == true) then
		setPanelShown(wanted)
	end
	-- a window on top (menu window, odds, roulette stage, Pet Index): fold the card into the bubble and hide the
	-- menu pointer until it closes
	local covered = false
	if S.shown then
		local ok, open = pcall(windowCovering)
		covered = ok and open == true
	end
	if covered ~= (S.windowOpen == true) then
		S.windowOpen = covered
		S.coverRead = 0
		safe("layout", layout)
	end
	-- (2026-11-28 playtest C17: the Shop left 'Pick a B' of the folded strip showing, its '5/21' under the window) the
	-- folded guide steps out of sight while a covering window's ink meets its own (Cover.underWindow; C17 review: hidden
	-- under every window, it also went where nothing lay over it, as the Gifts window and an NPC's dialog at 1920 x 1080), read
	-- every COVER_EVERY s and at once when a window comes or goes. Written only while the panel shows (C17 review: a guide
	-- sent away under a window popped back in for its slide-out); the slide-out's end makes it whole again
	if S.shown and UI.Slide then
		S.coverRead = (S.coverRead or 0) - dt
		if S.coverRead <= 0 then
			S.coverRead = K.COVER_EVERY
			local ok, under = true, false
			if covered then
				ok, under = pcall(Cover.underWindow)
			end
			local hide = ok and under == true
			if UI.Slide.Visible == hide then
				UI.Slide.Visible = not hide
			end
		end
	end
	if S.shown then
		safe("typewriter", updateTypewriter, dt)
		-- the portrait animates whenever the panel shows: the folded bubble IS UI.Portrait, so it keeps flapping there
		-- too (at PORTRAIT_FOLDED_STEP; bug batch 2 #23: it froze while folded)
		safe("portrait", updatePortrait, dt, t)
		S.hintTimer = S.hintTimer - dt
		if S.hintTimer <= 0 then
			S.hintTimer = 0.25
			if UI.Hint.Visible then
				UI.Hint.Text = hintText()
			end
			if (S.nextLockUntil or 0) > 0 and os.clock() >= S.nextLockUntil then
				S.nextLockUntil = 0
				setDisabled(UI.Next, false)
			end
			if (S.skipLockUntil or 0) > 0 and os.clock() >= S.skipLockUntil then
				S.skipLockUntil = 0
				setDisabled(UI.ConfirmYes, false)
			end
			-- the current step's block breathes
			local st = S.state
			local face = st and not S.finale and currentProgressFace()
			if face then
				face.BackgroundTransparency = (math.sin(t * 6) + 1) * 0.2
			end
		end
	end
	safe("travel guide", updateTravel, dt)
	safe("menu pointer", updateMenuPointer, dt, t)
	safe("world guide", updateWorldGuide, dt, t)
	safe("guide needle", guideNeedle, dt)
	safe("confetti", updateConfetti, dt)

	-- nothing left to show: stop the loop until the next state (or the next travel guide)
	local st = S.state
	if st and st.Done and not S.shown and Fx.live <= 0 and not W.active and not G.active and R.loop then
		R.loop:Disconnect()
		R.loop = nil
		hidePointer()
	end
end

function TutorialController.GetState()
	return S.state
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
-- { module, signal, fixed window id (nil: the signal passes the window id) }
local WINDOW_SIGNALS = {
	{ "MenuController", "WindowOpened", nil },
	{ "IndexController", "WindowOpened", nil },
	{ "IndexController", "Opened", "Index" },
}

local function hookWindowSignals()
	for _, spec in ipairs(WINDOW_SIGNALS) do
		local key = spec[1] .. "." .. spec[2]
		if not R.hooked[key] then
			local m = mod(spec[1])
			local signal = m and m[spec[2]]
			if type(signal) == "table" and type(signal.Connect) == "function" then
				R.hooked[key] = true
				local fixed = spec[3]
				signal:Connect(function(windowId)
					onWindowOpened(fixed or windowId)
				end)
			end
		end
	end
	local indexHooked = R.hooked["IndexController.Opened"] or R.hooked["IndexController.WindowOpened"] or not mod("IndexController")
	return R.hooked["MenuController.WindowOpened"] == true and indexHooked == true
end

-- A window the step asks for may already be open when the step begins.
local function checkOpenWindows()
	local st = S.state
	if st and not st.Done and st.CompleteOn == "IndexOpened" then
		local IndexController = mod("IndexController")
		if IndexController and type(IndexController.IsOpen) == "function" then
			local ok, open = pcall(IndexController.IsOpen)
			if ok and open == true then
				onWindowOpened("Index")
			end
		end
	end
end

function TutorialController.Init()
	if R.initialized then
		return
	end
	R.initialized = true
	R.checkOpenWindows = function()
		safe("open windows", checkOpenWindows)
	end
	if not LocalPlayer then
		return
	end
	local okBuild, err = pcall(function()
		buildPanel()
		buildPointer()
	end)
	if not okBuild then
		warn("[TutorialController] could not build the panel: " .. tostring(err))
		return
	end
	safe("layout", layout)

	-- screen changes re-flow the panel right away
	local function watchCamera()
		local camera = Workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				safe("layout", layout)
			end)
		end
	end
	watchCamera()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
	LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
		M.findTimer = 0
		W.key = nil
		if inMatch() then
			-- a card opened in the lobby must not follow the player into the climb (it would cover the HP card):
			-- every match starts with Nimbus' automatic choice
			S.manual = nil
		end
		safe("layout", layout)
	end)

	task.spawn(function()
		-- Phase 5 (7.2): the main menu comes first. No panel, arrow or menu pointer before PLAY (or 600 s); the state
		-- the server pushed meanwhile is asked for again with "Sync" below
		local gate = loadModule(Client, "UiGate")
		if gate and type(gate.WaitForPlay) == "function" then
			pcall(gate.WaitForPlay, 600)
		end
		R.event = getRemote("TutorialEvent")
		local stateRemote = getRemote("TutorialState")
		if stateRemote then
			stateRemote.OnClientEvent:Connect(function(payload)
				safe("state", applyState, payload)
			end)
		else
			warnOnce("remote", "TutorialState remote missing: tutorial panel disabled")
			return
		end
		local openPanel = getRemote("OpenPanel")
		if openPanel then
			openPanel.OnClientEvent:Connect(function(panelId)
				onWindowOpened(panelId)
			end)
		end
		-- ask for the state (the join-time push may have arrived before we listened)
		fireEvent("Sync")
		for _, pause in ipairs({ 2, 4, 8, 15 }) do
			task.wait(pause)
			if S.state then
				break
			end
			R.last.Sync = nil
			fireEvent("Sync")
		end
	end)

	-- the portrait model (first sculpt can take a moment) and the window signals of the menu
	task.defer(function()
		safe("portrait", setupPortraitModel)
	end)
	task.spawn(function()
		for _ = 1, 30 do
			local ok, done = pcall(hookWindowSignals)
			if ok and done then
				break
			end
			task.wait(2)
		end
	end)
end

return TutorialController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1174">
            <Properties>
              <string name="Name">VipController</string>
              <string name="Source"><![CDATA[-- VipController (client, store 2026-11-04; spec 5.1 "VIP" / 8 / 14): the VIP pass's two looks, both client-side only.
--
--   VipController.Init()
--   VipController.IsVip(player) -> bool   the player's replicated OwnedPasses csv has the entry "VIP"
--
-- Chat: TextChatService.OnIncomingMessage returns a TextChatMessageProperties whose PrefixText is
--   '<font color="#FFC440">[VIP]</font> <font color="#FFC440">' .. message.PrefixText .. '</font>' when the message's
--   TextSource.UserId is a VIP in this server; any other message (no source, a non-VIP, an error) is left as it is (nil).
--   Set under pcall: a place without the property (the legacy chat) keeps its nil callback.
--   VipController.Crown(parent, px) -> Frame "Crown"   (kit-b U9-3) the crown's kit B look: the gold pixel crown on its
--                                                      wood lip (the lobby crown and a titled player's TitleTag)
-- Lobby crown: a BillboardGui "VipCrown" (VipController.Crown, its bottom 16 px over a point 2.4 studs above the head,
--   MaxDistance 60, client-only)
--   on every VIP character while Graphics is High; disabled while that player is InBattle / InMatch; every player's
--   OwnedPasses / InBattle / InMatch attributes and CharacterAdded are watched, and a 1 s sweep follows the graphics
--   level; the crown and the connections go when the player leaves.
-- Titled players (lobby-shop Task 19, spec 16.6): while a player has a Title (Top10 / Top100 / Creator) and the
--   TitleController is in the build, that player has no VipCrown billboard of its own: the same rule (VIP, Graphics High,
--   not InBattle / InMatch) goes to TitleController.SetCrown(player, on), which draws the crown inside the TitleTag 4 px
--   above the plate (a pixel gap that never closes far away). The Title attribute is watched too, so the crown moves
--   between the two the moment a title comes or goes.
--   VipController.TitleHost(player) -> the TitleController module while the player has a valid Title, else nil
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon"))

local Client = script.Parent.Parent
local NeonKit = require(Client:WaitForChild("UI"):WaitForChild("NeonKit"))
local GraphicsQuality = require(Client:WaitForChild("GraphicsQuality"))

local VipController = {}

local K = {
	PASS = "VIP",
	COLOR = "#FFC440",
	CROWN = "VipCrown",
	OFFSET = 2.4, -- studs above the head
	MAX_DISTANCE = 60,
	SIZE = 34, -- the billboard (px)
	ABOVE = 16, -- (kit-b U9-3) px between the crown's bottom and its anchor below it (Roblox's name is about 20 px tall)
	SWEEP = 1, -- seconds between two graphics-level sweeps
	-- the chat callback's return class: creatable in Roblox (the TextChatService.OnIncomingMessage docs build one with
	-- Instance.new); tools/roblox-api.json predates it, so the name is kept here rather than as a literal at the call
	PROPS_CLASS = "TextChatMessageProperties",
}
VipController.K = K

local initialized = false
local Watch = {} -- [player] = { conns }
local warned = {}

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[VipController] " .. key .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

function VipController.IsVip(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end
	local csv = player:GetAttribute(Config.Attr.OwnedPasses or "OwnedPasses")
	if type(csv) ~= "string" then
		return false
	end
	for entry in csv:gmatch("[^,]+") do
		if (entry:gsub("^%s+", ""):gsub("%s+$", "")) == K.PASS then
			return true
		end
	end
	return false
end

----------------------------------------------------------------------
-- Chat
----------------------------------------------------------------------
local function tagged(message)
	local source = message and message.TextSource
	local userId = source and tonumber(source.UserId)
	if not userId then
		return nil
	end
	local player = Players:GetPlayerByUserId(userId)
	if not VipController.IsVip(player) then
		return nil
	end
	local props = Instance.new(K.PROPS_CLASS)
	local open = '<font color="' .. K.COLOR .. '">'
	props.PrefixText = open .. "[VIP]</font> " .. open .. tostring(message.PrefixText or "") .. "</font>"
	return props
end

local function onIncoming(message)
	local ok, props = pcall(tagged, message)
	if ok then
		return props
	end
	warnOnce("chat", props)
	return nil
end

----------------------------------------------------------------------
-- The lobby crown
----------------------------------------------------------------------
local function crownOf(character)
	return character and character:FindFirstChild(K.CROWN, true) or nil
end

-- the TitleController (required once, lazily: no top-level local) while this player has a valid Title; nil without a
-- Title or when the build has no TitleController (the crown is then this controller's own billboard, as before)
function VipController.TitleHost(player)
	local kind = player:GetAttribute(Config.Attr.Title or "Title")
	local rt = Config.Leaderboard and Config.Leaderboard.RankTitles
	if type(kind) ~= "string" or not (rt and rt.Tag and rt.Tag[kind]) then
		return nil
	end
	if VipController._titles == nil then
		local module = script.Parent and script.Parent:FindFirstChild("TitleController")
		local ok, mod = false, nil
		if module then
			ok, mod = pcall(require, module)
		end
		VipController._titles = (ok and type(mod) == "table" and type(mod.SetCrown) == "function") and mod or false
	end
	return VipController._titles or nil
end

local function wantsCrown(player)
	if not VipController.IsVip(player) or GraphicsQuality.Effective() == "Low" then
		return false
	end
	return player:GetAttribute(Config.Attr.InMatch) ~= true and player:GetAttribute(Config.Attr.InBattle or "InBattle") == nil
end

-- (kit-b U9-3, finding 15) the crown in kit B: the gold pixel crown (Theme.Sign.Gold) over the same crown in wood one cell
-- lower, the flat block's darker lip, so it reads on the sky and on the grass with no glow. A transparent px x px Frame
-- "Crown" holding the wood "Lip" and the gold "Icon" (NeonKit.Icon: attribute PixelIcon = "crown"), both drawn at the
-- 27 px icon (3 px cells) a 34 px slot held before; the caller places the holder. Used by the lobby crown here and by a
-- titled player's TitleTag (TitleController)
K.CROWN_ICON = 30 -- NeonKit.Icon's size: the PixelIcon draws at 0.9 x this = 27 px
function VipController.Crown(parent, px)
	local holder = Instance.new("Frame")
	holder.Name = "Crown"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(px, px)
	local cell = math.floor(PixelIcon.Snap(K.CROWN_ICON * 0.9) / 9)
	-- the lip under the gold one (ZIndex 1 / 2: the pixel frames follow their host's)
	for _, part in ipairs({ { "Lip", Theme.Sign.Wood, cell, 1 }, { "Icon", Theme.Sign.Gold, 0, 2 } }) do
		local icon = NeonKit.Icon(holder, "VipCrown", K.CROWN_ICON)
		icon.Name = part[1]
		icon.TextColor3 = part[2]
		icon.Position = UDim2.new(0.5, 0, 0.5, part[3])
		icon.ZIndex = part[4]
	end
	holder.Parent = parent
	return holder
end

local function makeCrown(head)
	local bb = Instance.new("BillboardGui")
	bb.Name = K.CROWN
	bb.Size = UDim2.fromOffset(K.SIZE, K.SIZE)
	bb.StudsOffset = Vector3.new(0, K.OFFSET, 0)
	-- (kit-b U9-3) the crown's bottom ABOVE px over that point, a pixel gap that holds at any distance (the 0.4 stud between
	-- it and Roblox's name shrank on screen, so the crown sat on the name; the TitleTag's rule)
	bb.SizeOffset = Vector2.new(0, 0.5 + K.ABOVE / K.SIZE)
	bb.MaxDistance = K.MAX_DISTANCE
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.Adornee = head
	VipController.Crown(bb, K.SIZE)
	bb.Parent = head
	return bb
end

local function refresh(player)
	if not player or not player.Parent then
		return
	end
	local character = player.Character
	local head = character and (character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart"))
	local crown = crownOf(character)
	local want = head ~= nil and wantsCrown(player)
	local titles = VipController.TitleHost(player)
	if titles then
		-- a titled player: the crown is drawn inside the TitleTag (lobby-shop Task 19)
		if crown then
			crown:Destroy()
		end
		titles.SetCrown(player, want)
		return
	end
	if want and not crown then
		crown = makeCrown(head)
	end
	if crown then
		if not VipController.IsVip(player) then
			crown:Destroy()
		else
			crown.Enabled = want
		end
	end
end

local function unwatch(player)
	local w = Watch[player]
	if w then
		for _, c in ipairs(w) do
			c:Disconnect()
		end
		Watch[player] = nil
	end
	local crown = crownOf(player.Character)
	if crown then
		crown:Destroy()
	end
end

local function watch(player)
	if Watch[player] then
		return
	end
	local conns = {}
	Watch[player] = conns
	local attr = Config.Attr
	for _, name in ipairs({ attr.OwnedPasses or "OwnedPasses", attr.InMatch, attr.InBattle or "InBattle", attr.Title or "Title" }) do
		conns[#conns + 1] = player:GetAttributeChangedSignal(name):Connect(function()
			safe("refresh", refresh, player)
		end)
	end
	conns[#conns + 1] = player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Head", 5)
		safe("refresh", refresh, player)
	end)
	safe("refresh", refresh, player)
end

function VipController.Init()
	if initialized then
		return
	end
	initialized = true
	pcall(function()
		local chat = game:GetService("TextChatService")
		chat.OnIncomingMessage = onIncoming
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerAdded:Connect(function(player)
		safe("watch", watch, player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		safe("unwatch", unwatch, player)
	end)
	task.spawn(function()
		while true do
			task.wait(K.SWEEP)
			for player in pairs(Watch) do
				if player.Parent then
					safe("sweep", refresh, player)
				else
					safe("unwatch", unwatch, player)
				end
			end
		end
	end)
end

return VipController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="1175">
          <Properties>
            <string name="Name">GraphicsQuality</string>
            <string name="Source"><![CDATA[-- GraphicsQuality: the Graphics setting (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2 / 7.3, 6.4).
--   "Auto"  Low when Roblox's own graphics slider (UserSettings().GameSettings.SavedQualityLevel) is at 1..3,
--           High otherwise (its "Automatic" position counts as High: most players never touch the slider)
--   "Low"   LightingStack.Push("GfxLow"): Bloom / SunRays / DepthOfField off, Terrain clouds Density capped at 0.4 (the
--           lower of 0.4 and the living sky's own density, LightingStack.Value without GfxLow, so the clouds still thin
--           at night on Low; client SkyController calls Recap after each sky refresh); every model
--           tagged NC_Detail (pure decor: LobbyBuilder / HomeBuilder / DungeonBuilder) is moved to a local holder
--           folder outside the workspace (client-side only) with its particle emitters / beams / trails disabled, also
--           decor that streams in later; the Sage Dragon is paused with SkyDragonController.SetHeld(true) (model out
--           of the workspace, RenderStepped loop off, kept across its mesh rebuild)
--   "High"  everything restored (the GfxLow preset popped, the decor and the dragon back where they were, emitters on
--           again exactly where they were on)
--   Phone   (kit-b clouds wave, the owner's triangle call) on a touch-only device the obby far clouds (on a heavy
--           course some sea clouds too) tagged Config.Course.Clouds.PhoneTrimTag (CourseBuilder Mesh.trim) wait in the
--           same holder whatever the setting, also ones that stream in later; High never brings them back there
--
--   GraphicsQuality.Init()          reads ClientSettings.Gfx and follows ClientSettings.Changed
--   GraphicsQuality.Apply(setting)  "Auto" | "Low" | "High" (tests); -> the effective "Low" | "High"
--   GraphicsQuality.Effective()     -> "Low" | "High"
--   GraphicsQuality.Phone()         true on a touch-only device (touch, no keyboard): the phone trim applies
--   GraphicsQuality.Recap()         while Low: when the cloud cap moved Config.Sky.LowCloudStep or more, updates GfxLow's
--                                   cap in place (LightingStack.Update: no apply, so the sky's linear base tweens are never
--                                   cancelled or re-eased and no fade starts); the sky's next SetBase carries it
--   GraphicsQuality.Resolve(setting, savedLevel) -> "Low" | "High"  (pure; savedLevel = 0 Automatic, 1..10)
--
-- No per-frame work, no polling: CollectionService signals only. Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Client = script.Parent
local ClientSettings = require(Client:WaitForChild("ClientSettings"))
local LightingStack = require(Client:WaitForChild("LightingStack"))
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local GraphicsQuality = {}

local DETAIL_TAG = "NC_Detail"
local PRESET_ID = "GfxLow"
local CLOUD_CAP = 0.4 -- Terrain clouds Density on Low never above this (nor above the sky's own)
local FADE = 0.5 -- seconds of the lighting change
local EMITTERS = { ParticleEmitter = true, Beam = true, Trail = true }
local CLOUDS = type(Config.Course) == "table" and type(Config.Course.Clouds) == "table" and Config.Course.Clouds or {}
local TRIM_TAG = type(CLOUDS.PhoneTrimTag) == "string" and CLOUDS.PhoneTrimTag or "NC_PhoneTrim"

local St = {
	Mode = "High", -- the effective mode applied
	CloudDensity = nil, -- the cloud cap in the GfxLow preset pushed last
	Holder = nil, -- the local folder the hidden decor waits in
	Hidden = {}, -- [model] = original parent
	HiddenList = {}, -- models in the order they were hidden (restored in that order)
	Emitters = {}, -- [emitter] = true (an emitter WE turned off)
	Trimmed = setmetatable({}, { __mode = "k" }), -- [cloud] = its parent while the phone trim holds it (weak keys)
	Dragon = nil, -- true while Low holds the dragon (SetHeld); { Parent } on the fallback path
	Conns = {},
	Started = false,
}
GraphicsQuality._St = St

----------------------------------------------------------------------
-- Auto
----------------------------------------------------------------------

function GraphicsQuality.Resolve(setting, savedLevel)
	if setting == "Low" or setting == "High" then
		return setting
	end
	local level = tonumber(savedLevel)
	if level and level >= 1 and level <= 3 then
		return "Low"
	end
	return "High"
end

local function savedQualityLevel()
	local ok, level = pcall(function()
		local value = UserSettings().GameSettings.SavedQualityLevel
		if typeof(value) == "EnumItem" then
			return value.Value
		end
		return tonumber(value)
	end)
	if ok and type(level) == "number" then
		return level
	end
	return 0
end

----------------------------------------------------------------------
-- Decor
----------------------------------------------------------------------

local function holder()
	if St.Holder and St.Holder.Parent then
		return St.Holder
	end
	local f = Instance.new("Folder")
	f.Name = "NimbusGfxHidden"
	f.Parent = ReplicatedStorage
	St.Holder = f
	return f
end

local function setEmitters(root, on)
	local list = root:GetDescendants()
	list[#list + 1] = root
	for _, d in ipairs(list) do
		if EMITTERS[d.ClassName] then
			if on then
				if St.Emitters[d] then
					St.Emitters[d] = nil
					d.Enabled = true
				end
			elseif d.Enabled then
				St.Emitters[d] = true
				d.Enabled = false
			end
		end
	end
end

local function hide(inst)
	if St.Hidden[inst] or not inst.Parent or inst:IsDescendantOf(holder()) then
		return
	end
	-- a tagged part inside a tagged model moves with its model
	local parent = inst.Parent
	while parent and parent ~= game do
		if St.Hidden[parent] or CollectionService:HasTag(parent, DETAIL_TAG) then
			return
		end
		parent = parent.Parent
	end
	St.Hidden[inst] = inst.Parent
	St.HiddenList[#St.HiddenList + 1] = inst
	setEmitters(inst, false)
	inst.Parent = holder()
end

local function showAll()
	for _, inst in ipairs(St.HiddenList) do
		local parent = St.Hidden[inst]
		St.Hidden[inst] = nil
		if parent and parent.Parent and inst.Parent == St.Holder then
			inst.Parent = parent
			setEmitters(inst, true)
		end
	end
	St.HiddenList = {}
	St.Emitters = {}
end

----------------------------------------------------------------------
-- Phone trim (kit-b clouds wave)
----------------------------------------------------------------------

function GraphicsQuality.Phone()
	local ok, phone = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	return ok and phone == true
end

-- parks one trimmed cloud (one Low holds already, or one in the holder, is left alone: Low's High hands it back
-- and the next trim pass takes it)
local function trim(inst)
	if St.Trimmed[inst] or St.Hidden[inst] or not inst.Parent or inst:IsDescendantOf(holder()) then
		return
	end
	St.Trimmed[inst] = inst.Parent
	inst.Parent = holder()
end

-- a phone parks every tagged cloud (and follows new ones); any other device gets them back
local function applyTrim()
	if GraphicsQuality.Phone() then
		for _, inst in ipairs(CollectionService:GetTagged(TRIM_TAG)) do
			trim(inst)
		end
		if not St.Conns.Trim then
			St.Conns.Trim = CollectionService:GetInstanceAddedSignal(TRIM_TAG):Connect(function(inst)
				if GraphicsQuality.Phone() then
					task.defer(trim, inst)
				end
			end)
		end
		return
	end
	for inst, parent in pairs(St.Trimmed) do
		St.Trimmed[inst] = nil
		if parent.Parent and inst.Parent == St.Holder then
			inst.Parent = parent
		end
	end
end

local function dragonModule()
	local controllers = Client:FindFirstChild("Controllers")
	local module = controllers and controllers:FindFirstChild("SkyDragonController")
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

local function dragonModel(mod)
	if mod and type(mod.GetModel) == "function" then
		local okModel, model = pcall(mod.GetModel)
		if okModel and typeof(model) == "Instance" then
			return model
		end
	end
	return nil
end

-- Low pauses the Sage Dragon, High lets it fly again. The controller keeps the flag (SetHeld), so a dragon rebuilt
-- while Low (its mesh rebuild once the dragon keys load, _Rebuild) is built paused and High always finds the LIVE
-- model. Without SetHeld (an older controller): the current model is re-fetched every call and a write to a
-- destroyed model can never throw (Apply always reaches PetFx.SetQuality).
local function pauseDragon(on)
	local mod = dragonModule()
	if mod and type(mod.SetHeld) == "function" then
		St.Dragon = on and true or nil
		pcall(mod.SetHeld, on)
		return
	end
	local model = dragonModel(mod)
	if on then
		if model and model.Parent then
			local parent = model.Parent
			if pcall(function()
				model.Parent = nil
			end) then
				St.Dragon = { Parent = parent }
			end
		end
	elseif St.Dragon then
		local d = St.Dragon
		St.Dragon = nil
		if type(d) == "table" and model and model.Parent == nil and d.Parent and d.Parent.Parent then
			pcall(function()
				model.Parent = d.Parent
			end)
		end
	end
end

----------------------------------------------------------------------
-- Apply
----------------------------------------------------------------------

-- a fresh GfxLow preset: the cloud cap is the lower of CLOUD_CAP and what the sky shows under GfxLow right now
local function lowPreset()
	local density = CLOUD_CAP
	local ok, sky = pcall(LightingStack.Value, "Clouds", "Density", PRESET_ID)
	if ok and type(sky) == "number" and sky == sky then
		density = math.min(CLOUD_CAP, sky)
	end
	St.CloudDensity = density
	return {
		Bloom = { Enabled = false },
		SunRays = { Enabled = false },
		DepthOfField = { Enabled = false },
		Clouds = { Density = density },
	}
end

function GraphicsQuality.Apply(setting)
	local mode = GraphicsQuality.Resolve(setting, savedQualityLevel())
	if mode == "Low" then
		if St.Mode ~= "Low" then
			pcall(LightingStack.Push, PRESET_ID, lowPreset(), FADE)
		end
		St.Mode = "Low"
		for _, inst in ipairs(CollectionService:GetTagged(DETAIL_TAG)) do
			hide(inst)
		end
		pauseDragon(true)
		if not St.Conns.Added then
			St.Conns.Added = CollectionService:GetInstanceAddedSignal(DETAIL_TAG):Connect(function(inst)
				if St.Mode == "Low" then
					task.defer(hide, inst)
				end
			end)
		end
		-- the dragon is built a moment after the boot: catch it once it exists
		task.delay(3, function()
			if St.Mode == "Low" then
				pauseDragon(true)
			end
		end)
	else
		if St.Mode == "Low" then
			pcall(LightingStack.Pop, PRESET_ID, FADE)
		end
		St.Mode = "High"
		if St.Conns.Added then
			St.Conns.Added:Disconnect()
			St.Conns.Added = nil
		end
		showAll()
		pauseDragon(false)
	end
	applyTrim()
	-- Phase 6 (6.4 / A6): the evolved pets' particles follow the same switch (PetFx: Low = the soft light only)
	pcall(function()
		require(ReplicatedStorage.Shared.PetFx).SetQuality(St.Mode)
	end)
	return St.Mode
end

function GraphicsQuality.Effective()
	return St.Mode
end

-- the living sky moved (SkyController, after an applied refresh): while Low, update GfxLow's cloud cap when it moved at
-- least Config.Sky.LowCloudStep (a few times a loop: the night thins below 0.4 and back). In place, never a re-push: a
-- Push would cancel the SetBase tweens SkyController just started and restart them as an eased fade (Busy, so the
-- next refresh would skip); the cap rides the next refresh's linear SetBase instead (2 s later: the clouds move slowly)
function GraphicsQuality.Recap()
	if St.Mode ~= "Low" then
		return false
	end
	local ok, sky = pcall(LightingStack.Value, "Clouds", "Density", PRESET_ID)
	if not ok or type(sky) ~= "number" or sky ~= sky then
		return false
	end
	local step = (Config.Sky and Config.Sky.LowCloudStep) or 0.02
	if St.CloudDensity and math.abs(math.min(CLOUD_CAP, sky) - St.CloudDensity) < step then
		return false
	end
	local preset = lowPreset()
	local ok2, updated = pcall(LightingStack.Update, PRESET_ID, preset)
	if not (ok2 and updated) then
		pcall(LightingStack.Push, PRESET_ID, preset, FADE) -- GfxLow is not on the stack (never pushed): put it back
	end
	return true
end

function GraphicsQuality.Init()
	if St.Started then
		return
	end
	St.Started = true
	ClientSettings.Changed:Connect(function(key, value)
		if key == "Gfx" then
			GraphicsQuality.Apply(value)
		end
	end)
	GraphicsQuality.Apply(ClientSettings.Get("Gfx"))
end

return GraphicsQuality
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1176">
          <Properties>
            <string name="Name">LightingStack</string>
            <string name="Source"><![CDATA[-- LightingStack: client lighting presets per zone (ARCHITECTURE_V3.md "Phase 5 build contract" 6.4, C3).
-- The server writes Lighting once at boot (LightingService); every later mood change happens HERE, on the client,
-- as a stack of named presets, so two features never fight over Lighting (the dungeon darkening the world while
-- the Low graphics setting has bloom switched off, for example).
--
--   LightingStack.Push(id, preset, seconds)   push (or re-push: it moves to the top) a preset, tweened over `seconds`
--       preset = { Lighting = {...}, Atmosphere = {...}, ColorCorrection = {...}, Bloom = {...}, SunRays = {...},
--                  Clouds = {...}, DepthOfField = {...}, Sky = {...} }   (property name -> value per group)
--   LightingStack.Pop(id, seconds)            removes it and restores what is under it; an unknown id is a no-op
--   LightingStack.Value(group, prop, skipId) -> value | nil   what group.prop is without preset skipId (the topmost
--       other preset that sets it, else the base, else the instance's current value)
--   LightingStack.Top() -> id | nil           the topmost preset's id
--   LightingStack.Ids() -> { id, ... }        bottom to top (tests / debugging)
--   LightingStack.SetBase(preset, seconds, instant)   MOVES the base (the living sky): every group.prop `preset` names
--       becomes the new base value (an unseen property is snapshotted first), then the stack re-applies over `seconds`,
--       so the presets above keep winning and a Pop lands on the moved base, not on the boot value. instant (optional)
--       = { group = { prop = true } }: those are set at once in this apply (the sky's clock jump at a phase change);
--       asked while Busy they wait for the next apply, whichever it is
--   LightingStack.Busy() -> boolean           a tween started by Push / Pop (a preset fading in or out) still runs
--   LightingStack.Update(id, preset) -> boolean   replaces the values of a preset already on the stack IN PLACE (its
--       position kept) and applies NOTHING: no running tween is cancelled or re-eased, Busy() is untouched; the next
--       apply (the sky's next SetBase, or any Push / Pop) carries them. false (and no change) when id is not on the stack
--       (GraphicsQuality.Recap: the GfxLow cloud cap follows the sky without restarting the sky's linear tweens)
--
-- Rules: the first time any preset names a property, its current (replicated) value is snapshotted as the BASE;
-- the effective value of every property = the topmost preset that sets it, else the base. The base is no longer
-- fixed: SkyController (the day / night cycle and the raid skies, every Config.Sky.Cycle.Refresh s) is its only
-- writer, through SetBase. A SetBase while Busy only stores the values and applies nothing, so the Dungeon fade is
-- never cancelled or restarted; the next refresh after the fade applies them. Numbers, Color3 and
-- other tweenable values are tweened (TweenService, client side); booleans / strings / enums switch at once, and so
-- do the whole-number properties of shared/SkyCycle.Integer (StarCount) from any preset or the base.
-- A new Push / Pop cancels the running tween of each object first, so values never jump back. Missing instances
-- (no Atmosphere / Clouds on this client) are skipped quietly. No per-frame code, no connections.
-- Users: DungeonController ("Dungeon"), GraphicsQuality ("GfxLow"), BattleController ("AttackFxDim": a signature's
-- brief battle dim, Task 11 of the pet attack VFX), SkyController (SetBase, and "SkyLift": the night battle lift).
-- Nothing else on the client writes Lighting.
-- Plain Lua 5.1-compatible syntax only.

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SkyCycle = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SkyCycle"))

local LightingStack = {}

-- group name -> function() -> Instance | nil (resolved on every apply: cheap, and survives a replaced instance)
local GROUPS = {
	Lighting = function()
		return Lighting
	end,
	Atmosphere = function()
		return Lighting:FindFirstChildOfClass("Atmosphere")
	end,
	ColorCorrection = function()
		return Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	end,
	Bloom = function()
		return Lighting:FindFirstChildOfClass("BloomEffect")
	end,
	SunRays = function()
		return Lighting:FindFirstChildOfClass("SunRaysEffect")
	end,
	DepthOfField = function()
		return Lighting:FindFirstChildOfClass("DepthOfFieldEffect")
	end,
	Sky = function()
		return Lighting:FindFirstChildOfClass("Sky")
	end,
	Clouds = function()
		local terrain = Workspace:FindFirstChildOfClass("Terrain")
		return terrain and terrain:FindFirstChildOfClass("Clouds") or nil
	end,
}
-- a fixed order, so applying never depends on pairs() order
local GROUP_ORDER = { "Lighting", "Atmosphere", "ColorCorrection", "Bloom", "SunRays", "DepthOfField", "Sky", "Clouds" }

local TWEENABLE = { number = true, Color3 = true, Vector3 = true, Vector2 = true, UDim2 = true, CFrame = true }
local INTEGER = SkyCycle.Integer -- prop name -> true: whole numbers, never tweened

local stack = {} -- { { Id = id, Preset = preset }, ... } bottom -> top
local base = {} -- group -> { prop -> value } (the snapshot of the untouched values)
local tweens = {} -- group -> Tween (the running tween of that group's instance)
local fades = {} -- group -> Tween started by Push / Pop (Busy() while one still plays; SetBase tweens are not here)
local instantNext = {} -- group -> { prop -> true }: set at once by the next apply (SetBase's instant set)
local warned = {}

local function warnOnce(key, text)
	if not warned[key] then
		warned[key] = true
		warn("[LightingStack] " .. text)
	end
end

local function indexOf(id)
	for i = 1, #stack do
		if stack[i].Id == id then
			return i
		end
	end
	return nil
end

-- sorted property names of a table (deterministic iteration)
local function sortedKeys(t)
	local keys = {}
	for k in pairs(t) do
		if type(k) == "string" then
			keys[#keys + 1] = k
		end
	end
	table.sort(keys)
	return keys
end

-- record the base value of every property `preset` names that has no base yet
local function snapshot(preset)
	for _, group in ipairs(GROUP_ORDER) do
		local props = preset[group]
		if type(props) == "table" then
			local inst = GROUPS[group]()
			if inst then
				local b = base[group]
				if not b then
					b = {}
					base[group] = b
				end
				for _, prop in ipairs(sortedKeys(props)) do
					if b[prop] == nil then
						local ok, value = pcall(function()
							return inst[prop]
						end)
						if ok and value ~= nil then
							b[prop] = value
						else
							warnOnce(group .. "." .. prop, "unknown property " .. group .. "." .. prop .. " (ignored)")
						end
					end
				end
			end
		end
	end
end

-- the effective value of group.prop: the topmost preset that sets it, else the base
local function effective(group, prop)
	for i = #stack, 1, -1 do
		local props = stack[i].Preset[group]
		if type(props) == "table" and props[prop] ~= nil then
			return props[prop]
		end
	end
	return base[group] and base[group][prop]
end

local function setProp(inst, prop, value)
	pcall(function()
		inst[prop] = value
	end)
end

-- `fade` = this apply comes from Push / Pop (its tweens make Busy() true)
local function apply(seconds, fade)
	seconds = tonumber(seconds) or 0
	local instant = instantNext
	instantNext = {}
	for _, group in ipairs(GROUP_ORDER) do
		local b = base[group]
		local inst = b and GROUPS[group]()
		if inst then
			local running = tweens[group]
			fades[group] = nil
			if running then
				tweens[group] = nil
				pcall(function()
					running:Cancel()
				end)
			end
			local goals, any = {}, false
			local now = instant[group] or {}
			for _, prop in ipairs(sortedKeys(b)) do
				local want = effective(group, prop)
				if want ~= nil then
					local okCur, current = pcall(function()
						return inst[prop]
					end)
					if not okCur or current ~= want then
						if seconds > 0 and TWEENABLE[typeof(want)] and okCur and typeof(current) == typeof(want) and not INTEGER[prop] and not now[prop] then
							goals[prop] = want
							any = true
						else
							setProp(inst, prop, want)
						end
					end
				end
			end
			if any then
				-- a Push / Pop fade eases in and out; the sky's SetBase steps are linear, so back-to-back refreshes
				-- (a new 2 s step every 2 s) join into one steady drift instead of a pulse every step
				local style = fade and Enum.EasingStyle.Sine or Enum.EasingStyle.Linear
				local ok, tween = pcall(function()
					return TweenService:Create(inst, TweenInfo.new(seconds, style, Enum.EasingDirection.InOut), goals)
				end)
				if ok and tween then
					tweens[group] = tween
					if fade then
						fades[group] = tween
					end
					tween:Play()
				else
					for prop, value in pairs(goals) do
						setProp(inst, prop, value)
					end
				end
			end
		end
	end
end

function LightingStack.Push(id, preset, seconds)
	if type(id) ~= "string" or id == "" or type(preset) ~= "table" then
		warnOnce("badpush", "Push needs a string id and a preset table")
		return
	end
	for key in pairs(preset) do
		if not GROUPS[key] then
			warnOnce("group." .. tostring(key), "unknown preset group " .. tostring(key) .. " (ignored)")
		end
	end
	snapshot(preset)
	local i = indexOf(id)
	if i then
		table.remove(stack, i)
	end
	stack[#stack + 1] = { Id = id, Preset = preset }
	apply(seconds, true)
end

function LightingStack.Pop(id, seconds)
	local i = indexOf(id)
	if not i then
		return
	end
	table.remove(stack, i)
	apply(seconds, true)
end

function LightingStack.Update(id, preset)
	local i = indexOf(id)
	if not i or type(preset) ~= "table" then
		return false
	end
	snapshot(preset)
	stack[i].Preset = preset
	return true
end

-- a Push / Pop fade still plays (a finished or cancelled tween is dropped here)
function LightingStack.Busy()
	local busy = false
	for _, group in ipairs(GROUP_ORDER) do
		local tween = fades[group]
		if tween then
			local ok, state = pcall(function()
				return tween.PlaybackState
			end)
			if ok and (state == Enum.PlaybackState.Playing or state == Enum.PlaybackState.Delayed) then
				busy = true
			else
				fades[group] = nil
			end
		end
	end
	return busy
end

-- the base moves (SkyController): only properties whose instance exists and that read back (snapshot) take a value;
-- unknown groups are ignored here (SkyController only names the known ones), junk is a no-op
function LightingStack.SetBase(preset, seconds, instant)
	if type(preset) ~= "table" then
		return
	end
	snapshot(preset)
	if type(instant) == "table" then
		for group, props in pairs(instant) do
			if GROUPS[group] and type(props) == "table" then
				local set = instantNext[group] or {}
				for prop, on in pairs(props) do
					if on == true and type(prop) == "string" then
						set[prop] = true
					end
				end
				instantNext[group] = set
			end
		end
	end
	for _, group in ipairs(GROUP_ORDER) do
		local props, b = preset[group], base[group]
		if type(props) == "table" and b then
			for _, prop in ipairs(sortedKeys(props)) do
				if b[prop] ~= nil and props[prop] ~= nil then
					b[prop] = props[prop]
				end
			end
		end
	end
	if not LightingStack.Busy() then
		apply(seconds, false)
	end
end

-- the value group.prop has (or comes back to) without preset `skipId`: the topmost OTHER preset that sets it, else
-- the base, else the instance's current value (no preset ever named it). nil when the group's instance is missing.
-- A preset made relative to the look under it (BattleController's battle dim: darker than whatever the dungeon /
-- the arena shows) reads it here, so a re-push never dims what it already dimmed, and a running tween never leaks in
function LightingStack.Value(group, prop, skipId)
	for i = #stack, 1, -1 do
		local entry = stack[i]
		local props = entry.Id ~= skipId and entry.Preset[group]
		if type(props) == "table" and props[prop] ~= nil then
			return props[prop]
		end
	end
	if base[group] and base[group][prop] ~= nil then
		return base[group][prop]
	end
	local get = GROUPS[group]
	local inst = get and get()
	if not inst then
		return nil
	end
	local ok, value = pcall(function()
		return inst[prop]
	end)
	return ok and value or nil
end

function LightingStack.Top()
	local top = stack[#stack]
	return top and top.Id or nil
end

function LightingStack.Ids()
	local out = {}
	for i = 1, #stack do
		out[i] = stack[i].Id
	end
	return out
end

return LightingStack
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="1177">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Nimbus Climb client bootstrap (LocalScript).
--
-- 1. State.Init() (the client mirror of the saved profile: pets, items, stats) starts first.
-- 2. Then every client controller is required and initialised, in the order listed below.
--
-- Each step runs in its own thread inside pcall: controllers wait for remotes and GUIs inside Init, and one
-- slow, broken or missing controller must never delay or take down the others. A failure only logs a
-- warning. Threads are started in the order listed here, and task.spawn runs a new thread immediately until
-- it first yields, so State.Init() has already registered itself before the first controller starts.
-- The loading screen (src/first/LoadingScreen.client.lua) runs from ReplicatedFirst before this script.
-- Plain Lua 5.1-compatible syntax only.

local CONTROLLER_NAMES = {
	"MovementController",
	"MainMenuController", -- Phase 5 (7.2): gates every other ScreenGui until PLAY; the server holds the character meanwhile
	"HudController",
	"DamageFx",
	"NotifyController",
	"MenuController",
	"PetsController", -- team balance: the Pets window (MenuController delegates to it)
	"TopBarController", -- HUD cleanup: the top-left pill (Shop / Travel / Settings)
	-- store (2026-11-04)
	"ShopController", -- lobby-shop Task 21: the one Shop window (tab rail: Eggs, Gems, Packs, Passes, Boosts)
	"StoreController", -- the forwarder kept for old callers (everything goes to ShopController)
	"LeaderboardController", -- lobby-shop Task 24: the lobby board's top 10 (a PlayerGui SurfaceGui on its Face, tappable pages)
	"LobbyFxController", -- lobby-shop Task 25: one heartbeat turns / bobs the NC_Spin / NC_Bob targets, hides the Join sign once claimed
	"DailyController", -- the Gifts button, its pip and the streak / play-time window
	"BoostBadgeController", -- the boost chips (XP potion, passes) under the currency pills
	"VipController", -- the VIP chat tag and the lobby crown
	"TitleController", -- lobby-shop: the Top 10 / Top 100 / Creator titles above the head (the crown inside a titled tag)
	"PromptController", -- Pitch 2 item 04: every world prompt drawn as the kit's plank (Style Custom)
	"TroveController", -- the Sky Trove panel and the chest's lid
	"PetController",
	"TokenFx",
	-- v3 (ARCHITECTURE_V3.md)
	"SkyDragonController",
	"IndexController",
	"NpcController",
	"TutorialController",
	"ShowcaseController",
	"DevController",
	"DevPetShow", -- the developer pet showcase (/pet, /pets, /evolve; client/Controllers/EvolutionFx.lua)
	-- Phase 2
	"HomeFx",
	"FusionController",
	-- Phase 3
	"BattleController",
	"ArenaController",
	"RaidGateController", -- boss raids: the idle boss on the colosseum floor, the gate tag, the dare panel
	-- Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract")
	"CareController", -- Food Machine feed list, garden picker, the EVOLVE moment (Train forwards to TrainController)
	"TrainController", -- gui-redo Task 7: the Training Place window (big pet card, four skill cards, its own confirm)
	"HomePortalFx", -- the home portal and the arrival ring
	-- Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 5.6, 6.3)
	"DungeonController", -- the Dungeon window, run cards, chest prompt, the dungeon lighting preset
	"ObbyController", -- the obby level picker at the Obby gate
	-- bug #13
	"FountainFx", -- the lobby fountain's paper boat (and its water loop when Config.Audio.Ambient.Fountain is set)
	-- bug #12
	"MeadowFx", -- the lobby's grass and wildflowers (grown here from the server's scatter) and their wind sway
	-- bug #11
	"RingCrowdFx", -- the Champion Ring's sky-sailor crowd: the drum beat, cheers, caps, bell, flags (animation only; sounds: audio branch)
	-- bug #5
	"DungeonFx", -- the dungeon's turning parts (the Weatherworks' astrolabe rings over the boss chair)
	-- the original audio (Config.Audio): the Champion Ring's crowd + drums as positional loops
	"RingAmbience",
	-- the living sky: the 20 min cycle + raid skies as the LightingStack base, the battle lift, night lamps, fireflies
	"SkyController",
}

local TAG = "[NimbusClimb] "

-- Newer controllers that a build may not contain yet: skip them quietly when absent.
local OPTIONAL = { PetsController = true, SkyDragonController = true, IndexController = true, NpcController = true, TutorialController = true,
	ShowcaseController = true, DevController = true, DevPetShow = true,
	HomeFx = true, FusionController = true,
	BattleController = true, ArenaController = true, RaidGateController = true,
	CareController = true, TrainController = true, HomePortalFx = true,
	MainMenuController = true, DungeonController = true, ObbyController = true, FountainFx = true,
	MeadowFx = true, RingCrowdFx = true, DungeonFx = true,
	RingAmbience = true,
	ShopController = true, StoreController = true, DailyController = true, BoostBadgeController = true, VipController = true, TroveController = true,
	TitleController = true, LeaderboardController = true, LobbyFxController = true, PromptController = true }

local client = script.Parent
task.spawn(function() local okMesh, MeshLibrary = pcall(function() return require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("MeshLibrary", 30)) end) if okMesh and type(MeshLibrary) == "table" then MeshLibrary.Start() end end) -- Phase 6: Blender meshes
task.spawn(function() local okMf, MeshFallback = pcall(function() return require(client:WaitForChild("Controllers"):WaitForChild("MeshFallback", 30)) end) if okMf and type(MeshFallback) == "table" then pcall(MeshFallback.Start) end end) -- Phase 6: Part fallback for server mesh pets on a device whose preload failed
task.spawn(function() local okMl, MouseLock = pcall(function() return require(client:WaitForChild("MouseLock", 30)) end) if okMl and type(MouseLock) == "table" then pcall(MouseLock.Start) end end) -- dungeon fixes: the mouse lock option
task.spawn(function() local okFx, PortalFx = pcall(function() return require(client:WaitForChild("Controllers"):WaitForChild("PortalFxController", 30)) end) if okFx and type(PortalFx) == "table" and type(PortalFx.Init) == "function" then local okInit, err = pcall(PortalFx.Init) if not okInit then warn(TAG .. "PortalFxController.Init failed: " .. tostring(err)) end end end) -- Phase 6: the gates' animation

-- 1. State
task.spawn(function()
	local okRequire, State = pcall(function()
		return require(client:WaitForChild("State", 30))
	end)
	if not okRequire then
		warn(TAG .. "State failed to load: " .. tostring(State))
		return
	end
	if type(State) ~= "table" or type(State.Init) ~= "function" then
		warn(TAG .. "State has no Init function")
		return
	end
	local okInit, err = pcall(State.Init)
	if not okInit then
		warn(TAG .. "State.Init failed: " .. tostring(err))
	end
end)

-- 2. Controllers
local controllers = client:WaitForChild("Controllers")

for _, name in ipairs(CONTROLLER_NAMES) do
	task.spawn(function()
		local moduleScript = controllers:FindFirstChild(name)
		if not moduleScript then
			if not OPTIONAL[name] then
				warn(TAG .. "missing client controller: " .. name)
			end
			return
		end
		local okRequire, controller = pcall(require, moduleScript)
		if not okRequire then
			warn(TAG .. name .. " failed to load: " .. tostring(controller))
			return
		end
		if type(controller) ~= "table" or type(controller.Init) ~= "function" then
			warn(TAG .. name .. " has no Init function")
			return
		end
		local okInit, err = pcall(controller.Init)
		if not okInit then
			warn(TAG .. name .. ".Init failed: " .. tostring(err))
		end
	end)
end

print(TAG .. "client ready")
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1178">
          <Properties>
            <string name="Name">MouseLock</string>
            <string name="Source"><![CDATA[-- MouseLock: the optional mouse lock (docs/dungeon-fixes/plan.md decision 6). With the setting MouseLock on (Settings
-- window "Mouse lock", or the L key) the cursor stays locked in the screen centre and the mouse turns the camera, like
-- Roblox's shift-lock without holding a key. Keyboard + mouse devices only: touch / gamepad-only devices are untouched.
-- Bug batch 2 #21: the setting defaults to ON (the game is played with E / F prompts); "Mouse lock (recommended)" in
-- Settings, OFF stays possible (not recommended), and a saved OFF is kept. The first lock of a session that lasts
-- HINT_DELAY shows a "press L to free the cursor" pill low on the screen for HINT_SECONDS (NimbusMouseLockHint; kit B
-- U9-9: a stone plank with the pixel mouse, the TextLabel "Hint" still holding the whole line).
--
--   MouseLock.Start()           idempotent; reads ClientSettings "MouseLock" and follows its Changed signal
--   MouseLock.SetEnabled(on)    turns the lock on / off on this client (not saved; the setting goes through ClientSettings)
--   MouseLock.IsEnabled()       -> bool  the lock is wanted (the setting / SetEnabled)
--   MouseLock.IsLocked()        -> bool  the cursor is locked now (enabled, no hold, keyboard + mouse, started)
--   MouseLock.Hold(reason)      frees the cursor until the matching Release; counted per reason (two Holds = two Releases)
--   MouseLock.Release(reason)   -> bool  false (and harmless) for a reason that holds nothing
--   MouseLock.Holds()           -> { [reason] = count }  a copy (tests, debugging)
--   MouseLock.WatchVisible(reason, guiObject)  holds while guiObject is Visible inside an Enabled ScreenGui in the game
--                               (NeonKit.Dock calls it for every docked window); released when hidden / removed / destroyed
--
-- While locked: ONE RenderStep binding ("NimbusMouseLock", Enum.RenderPriority.Camera.Value + 1, after the camera
-- scripts, which write MouseBehavior every frame) sets UserInputService.MouseBehavior = LockCenter. Unlocked: no
-- binding at all; on the change MouseBehavior = Default and MouseIconEnabled = true are written once.
-- Automatic holds: every NeonKit.Dock window while shown, the main menu (MainMenuController), the loading screen
-- (PlayerGui.NimbusLoading while it exists), NotifyController's result card (NimbusNotify attribute ResultCardLeft > 0),
-- the tutorial card (NimbusTutorial.TutorialPanel + its Main card shown; the folded bubble does not hold), a focused
-- TextBox (chat) and (bug batch 2 #21) the overlays that are not docked windows: the egg stage (lobby-shop Task 22:
-- NimbusHatch.Stage, client/UI/EggStage) and the NPC dialog card (NimbusNpcDialog.NpcDialog); the Shop window holds
-- through ShopController's WatchVisible("Shop", ShopWindow). BattleController holds for its result
-- card / LEAVE confirm itself (pcall'd require).
-- Plain Lua 5.1-compatible syntax only; task.* only.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local MouseLock = {}

local K = {
	BIND = "NimbusMouseLock",
	KEY = Enum.KeyCode.L, -- the quick toggle (free: nothing in src/client binds L)
	KEY_NAME = "L",
	HINT_GUI = "NimbusMouseLockHint", -- the once-per-session "press L" pill (bug batch 2 #21)
	HINT_DELAY = 0.5, -- seconds the cursor must stay locked before the hint shows (no flash between two windows)
	HINT_SECONDS = 6,
}
MouseLock.HINT_GUI = K.HINT_GUI
MouseLock.KEY_NAME = K.KEY_NAME
MouseLock.BIND = K.BIND

local St = {
	Started = false,
	Enabled = false,
	Holds = {}, -- [reason] = count
	Flags = {}, -- [reason] = true: the automatic holds (one count each)
	Locked = false,
	Bound = false,
	Settings = nil, -- client/ClientSettings (lazy; false when missing)
	Watching = {}, -- [PlayerGui child name] = true (wired once per instance through Wired)
	Wired = setmetatable({}, { __mode = "k" }),
	Hinted = false, -- the "press L" hint was shown (or is pending) this session
	HintGui = nil,
}
MouseLock._St = St

local function priority()
	local ok, value = pcall(function()
		return Enum.RenderPriority.Camera.Value + 1
	end)
	return ok and value or 201
end

-- a keyboard + mouse device (a touch laptop with a keyboard and a mouse counts; a phone / a console does not)
local function desktop()
	local ok, yes = pcall(function()
		return UserInputService.KeyboardEnabled == true and UserInputService.MouseEnabled == true
	end)
	return ok and yes
end

local function step()
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
end

----------------------------------------------------------------------
-- the "press L" hint (bug batch 2 #21: the lock is on by default, so a new player must learn how to free the cursor
-- for the HUD buttons and side cards). Once per session, the first time the cursor stays locked for HINT_DELAY: a
-- small pill low on the screen (70% down) for HINT_SECONDS (ScreenGui "NimbusMouseLockHint"); gone at once on unlock.
----------------------------------------------------------------------
local function hideHint()
	local gui = St.HintGui
	St.HintGui = nil
	if gui then
		pcall(function()
			gui:Destroy()
		end)
	end
end

-- shared/Theme (optional here, no hard dependency): the Button font, ScaledSize, TextOutline (readability rule)
local function hintTheme()
	local ok, theme = pcall(function()
		local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("Theme")
		return module and require(module) or nil
	end)
	return (ok and type(theme) == "table") and theme or nil
end

-- (kit B U9-9) shared/PixelIcon (optional too): the pixel mouse before the words
local function hintIcons()
	local ok, icons = pcall(function()
		local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
		local module = shared and shared:FindFirstChild("PixelIcon")
		return module and require(module) or nil
	end)
	return (ok and type(icons) == "table") and icons or nil
end
local HINT_EDGE, HINT_LIP = 2, 4 -- the plank's wood edge and its stone lip (px)

local function showHint()
	if not St.Locked or St.HintGui then
		if not St.Locked then
			St.Hinted = false -- a lock that did not last: hint at the next one
		end
		return
	end
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = K.HINT_GUI
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false -- (it carries text: v2 rule)
	gui.DisplayOrder = 5
	local label = Instance.new("TextLabel")
	label.Name = "Hint"
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Position = UDim2.fromScale(0.5, 0.7) -- low, above the hotbar: never in the middle of the screen (v2 rule)
	local theme = hintTheme()
	local size = 20
	if theme then
		pcall(function()
			size = tonumber(theme.ScaledSize(20)) or 20
			theme.SetRole(label, "Button")
		end)
	end
	label.TextSize = size
	label.Size = UDim2.fromOffset(0, math.floor(size * 2 + 0.5))
	label.AutomaticSize = Enum.AutomaticSize.X
	-- (kit B U9-9) a stone plank (the Signboard kit): the pale tile in a mitred wood edge, its stone lip along the
	-- bottom, brown words after the pixel mouse; square, no outline on its text
	local sign = (theme and type(theme.Sign) == "table") and theme.Sign or {}
	label.BorderSizePixel = 0
	label.BackgroundColor3 = sign.Tile or Color3.fromRGB(255, 253, 246)
	label.BackgroundTransparency = 0
	label.TextColor3 = sign.Text or Color3.fromRGB(59, 36, 18)
	label.Text = "Mouse lock is ON  \194\183  press " .. K.KEY_NAME .. " to free the cursor"
	local edge = Instance.new("UIStroke")
	edge.Name = "SignEdge"
	edge.Color = sign.Wood or Color3.fromRGB(140, 90, 46)
	edge.Thickness = HINT_EDGE
	edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	edge.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 18)
	pad.PaddingRight = UDim.new(0, 18)
	pad.PaddingBottom = UDim.new(0, HINT_LIP)
	pad.Parent = label
	local icons = hintIcons()
	if icons then
		pcall(function()
			icons.Lead(label, "mouse", { Px = 18 }) -- the kit's 2 px icon cell
		end)
	end
	-- the lip: a UIPadding pads a label's children too, so it reaches back out to the plank's sides and bottom
	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BorderSizePixel = 0
	lip.BackgroundColor3 = sign.StoneLip or Color3.fromRGB(220, 201, 160)
	lip.AnchorPoint = Vector2.new(0, 1)
	lip.Position = UDim2.new(0, -pad.PaddingLeft.Offset, 1, pad.PaddingBottom.Offset)
	lip.Size = UDim2.new(1, pad.PaddingLeft.Offset + pad.PaddingRight.Offset, 0, HINT_LIP)
	lip.ZIndex = label.ZIndex
	lip.Parent = label
	label.Parent = gui
	gui.Parent = pg
	St.HintGui = gui
	-- short desktop windows: 70 % down would reach the HUD's bottom-centre vitals card (bug batch 2 #1), so the pill
	-- stands just above the card's top (NimbusHud attribute BottomCentreTop, same gui-area pixels: both keep the
	-- inset), but never up into the middle of the screen (the v2 rule's band ends at 64.5 % of the height). (U9-9 look 2)
	-- Its wood edge counted, and when the card leaves no room above it under the band (a 960 x 540 window: the card covered
	-- the plank's lower 9 px) the plank docks beside the card instead, its top on the card's top line, BAND_GAP right of
	-- it (on two lines when one is too wide for the room there)
	local BAND, BAND_GAP = 0.65, 8
	local hud = pg:FindFirstChild("NimbusHud")
	local top = hud and tonumber(hud:GetAttribute("BottomCentreTop"))
	local cardR = hud and tonumber(hud:GetAttribute("BottomCentreRight"))
	-- (P2 fix A) docked beside the card the plank lines up with the card's own top edge, under its name tab (vitals C): the
	-- tab's top line lay 1 px into the middle band at 960 x 540
	local cardTop = hud and tonumber(hud:GetAttribute("BottomCentreCardTop"))
	local areaH = gui.AbsoluteSize.Y
	local dock = nil
	if top and top > 0 and areaH > 0 then
		local above = top - BAND_GAP - label.Size.Y.Offset - HINT_EDGE
		if above >= BAND * areaH or not (cardR and cardR > 0) then
			local y = math.max(BAND * areaH, math.min(0.7 * areaH, above))
			label.Position = UDim2.new(0.5, 0, 0, math.floor(y))
		else
			dock = { X = math.ceil(cardR + BAND_GAP + HINT_EDGE), Y = math.floor((cardTop and cardTop > top) and cardTop or top) }
			label.AnchorPoint = Vector2.new(0, 0)
			label.Position = UDim2.fromOffset(dock.X, dock.Y)
		end
	end
	gui:SetAttribute("Docked", dock ~= nil)
	-- (U9-9 look) the plank on whole screen px: once its words have set its width, that width rounded up to an even
	-- number of px and its left edge on a whole px of the centre (an odd or fractional width put it at x 714.38)
	local settled, wrapped = false, false
	local function settle()
		local w = label.AbsoluteSize.X
		local areaW = gui.AbsoluteSize.X
		if settled or w <= 0 or areaW <= 0 or not label.Parent then
			return
		end
		if dock and not wrapped and dock.X + w + HINT_EDGE > areaW - BAND_GAP then
			-- too wide for the room beside the card: the same words on two lines (the plank grows down for the second)
			wrapped = true
			label.Text = "Mouse lock is ON\npress " .. K.KEY_NAME .. " to free the cursor"
			label.AutomaticSize = Enum.AutomaticSize.XY
			return
		end
		settled = true
		local even = 2 * math.ceil(w / 2 - 1e-6)
		local h = 2 * math.ceil(label.AbsoluteSize.Y / 2 - 1e-6)
		local p = label.Position
		label.AutomaticSize = Enum.AutomaticSize.None
		label.Size = UDim2.new(0, even, 0, math.max(label.Size.Y.Offset, h))
		label.AnchorPoint = Vector2.new(0, 0)
		if dock then
			label.Position = UDim2.fromOffset(dock.X, dock.Y)
		else
			label.Position = UDim2.fromOffset(math.floor((areaW - even) / 2), math.floor(p.Y.Scale * gui.AbsoluteSize.Y + p.Y.Offset))
		end
	end
	settle()
	if not settled then
		local conn
		conn = label:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			settle()
			if settled and conn then
				conn:Disconnect()
			end
		end)
	end
	task.delay(K.HINT_SECONDS, function()
		if St.HintGui == gui then
			hideHint()
		end
	end)
end

local function update()
	if not St.Started then
		return
	end
	local want = St.Enabled and next(St.Holds) == nil and desktop()
	if want then
		if not St.Bound then
			local ok, err = pcall(function()
				RunService:BindToRenderStep(K.BIND, priority(), step)
			end)
			St.Bound = ok
			if not ok then
				warn("[MouseLock] BindToRenderStep failed: " .. tostring(err))
			end
		end
		-- the binding writes LockCenter on the next frame (a hold that comes and goes inside one frame never warps)
		St.Locked = St.Bound
		if St.Locked and not St.Hinted then
			St.Hinted = true
			task.delay(K.HINT_DELAY, showHint)
		end
	else
		hideHint()
		if St.Bound then
			pcall(function()
				RunService:UnbindFromRenderStep(K.BIND)
			end)
			St.Bound = false
		end
		if St.Locked then
			pcall(function()
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
			end)
		end
		St.Locked = false
	end
end

function MouseLock.IsEnabled()
	return St.Enabled
end

function MouseLock.IsLocked()
	return St.Locked
end

function MouseLock.SetEnabled(on)
	on = on == true
	if St.Enabled == on then
		return
	end
	St.Enabled = on
	update()
end

local function keyOf(reason)
	if reason == nil then
		return "?"
	end
	return tostring(reason)
end

function MouseLock.Hold(reason)
	local key = keyOf(reason)
	St.Holds[key] = (St.Holds[key] or 0) + 1
	update()
	return key
end

function MouseLock.Release(reason)
	local key = keyOf(reason)
	local n = St.Holds[key]
	if not n then
		return false
	end
	if n <= 1 then
		St.Holds[key] = nil
	else
		St.Holds[key] = n - 1
	end
	update()
	return true
end

function MouseLock.Holds()
	local out = {}
	for key, n in pairs(St.Holds) do
		out[key] = n
	end
	return out
end

-- an automatic hold: one count under `reason` while `on`
local function flag(reason, on)
	on = on == true
	if (St.Flags[reason] == true) == on then
		return
	end
	St.Flags[reason] = on or nil
	if on then
		MouseLock.Hold(reason)
	else
		MouseLock.Release(reason)
	end
end
MouseLock._flag = flag

----------------------------------------------------------------------
-- visibility watchers
----------------------------------------------------------------------
local function shownInGame(obj)
	if not obj or not obj.Parent or not obj.Visible then
		return false
	end
	local gui = obj:FindFirstAncestorOfClass("ScreenGui")
	if not gui or not gui.Enabled then
		return false
	end
	local ok, inGame = pcall(function()
		return gui:IsDescendantOf(game)
	end)
	return ok and inGame
end

local serial = 0

-- holds while `obj` is shown (Visible, in an Enabled ScreenGui, in the game); released on hide / removal / destroy
function MouseLock.WatchVisible(reason, obj)
	if not obj then
		return nil
	end
	serial = serial + 1
	local key = keyOf(reason) .. "#" .. serial
	local conns = {}
	local function refresh()
		flag(key, shownInGame(obj))
	end
	local function bindGui()
		if conns.Gui then
			conns.Gui:Disconnect()
			conns.Gui = nil
		end
		local gui = obj.Parent and obj:FindFirstAncestorOfClass("ScreenGui")
		if gui then
			conns.Gui = gui:GetPropertyChangedSignal("Enabled"):Connect(refresh)
		end
	end
	local function stop()
		for name, c in pairs(conns) do
			c:Disconnect()
			conns[name] = nil
		end
		flag(key, false)
	end
	conns.Visible = obj:GetPropertyChangedSignal("Visible"):Connect(refresh)
	conns.Ancestry = obj.AncestryChanged:Connect(function()
		bindGui()
		refresh()
	end)
	conns.Gone = obj.Destroying:Connect(stop)
	bindGui()
	refresh()
	return { Key = key, Stop = stop, Refresh = refresh }
end

-- PlayerGui watchers for screens owned by other controllers (no edits there): matched by name
local function watchLoading(gui)
	local key = "auto:Loading"
	flag(key, true)
	gui.AncestryChanged:Connect(function()
		if not gui.Parent then
			flag(key, false)
		end
	end)
	gui.Destroying:Connect(function()
		flag(key, false)
	end)
end

local function watchNotify(gui)
	local key = "auto:ResultCard"
	local function refresh()
		local left = gui:GetAttribute("ResultCardLeft")
		flag(key, gui.Parent ~= nil and gui.Enabled and type(left) == "number" and left > 0)
	end
	gui:GetAttributeChangedSignal("ResultCardLeft"):Connect(refresh)
	gui:GetPropertyChangedSignal("Enabled"):Connect(refresh)
	gui.AncestryChanged:Connect(refresh)
	gui.Destroying:Connect(function()
		flag(key, false)
	end)
	refresh()
end

-- the tutorial card: TutorialPanel (Visible while the card is out) > Slide > Main (Visible = not folded)
local function watchTutorial(gui)
	local key = "auto:Tutorial"
	local wired = {}
	local function find()
		local root = gui:FindFirstChild("TutorialPanel")
		local slide = root and root:FindFirstChild("Slide")
		local main = slide and slide:FindFirstChild("Main")
		return root, main
	end
	local function refresh()
		local root, main = find()
		flag(key, gui.Parent ~= nil and gui.Enabled and root ~= nil and root.Visible and main ~= nil and main.Visible)
	end
	local function wire()
		local root, main = find()
		for _, obj in ipairs({ root, main }) do
			if obj and not wired[obj] and obj:IsA("GuiObject") then
				wired[obj] = true
				obj:GetPropertyChangedSignal("Visible"):Connect(refresh)
			end
		end
		refresh()
	end
	gui.DescendantAdded:Connect(function(d)
		if d.Name == "TutorialPanel" or d.Name == "Slide" or d.Name == "Main" then
			wire()
		end
	end)
	gui:GetPropertyChangedSignal("Enabled"):Connect(refresh)
	gui.AncestryChanged:Connect(refresh)
	gui.Destroying:Connect(function()
		flag(key, false)
	end)
	wire()
end

-- overlays that are not NeonKit.Dock windows (bug batch 2 #21, the lock is on by default now): one hold under
-- "auto:<gui name>" while any of the named DIRECT children of the gui is Visible (they come and go: EggStage builds
-- NimbusHatch per show and destroys it after)
local function watchOverlays(names)
	local wanted = {}
	for _, name in ipairs(names) do
		wanted[name] = true
	end
	return function(gui)
		local key = "auto:" .. gui.Name
		local wired = setmetatable({}, { __mode = "k" })
		local function refresh()
			local on = false
			if gui.Parent ~= nil and gui.Enabled then
				for _, child in ipairs(gui:GetChildren()) do
					if wanted[child.Name] and child:IsA("GuiObject") and child.Visible then
						on = true
						break
					end
				end
			end
			flag(key, on)
		end
		local function wire(child)
			if wanted[child.Name] and child:IsA("GuiObject") and not wired[child] then
				wired[child] = true
				child:GetPropertyChangedSignal("Visible"):Connect(refresh)
			end
			refresh()
		end
		gui.ChildAdded:Connect(wire)
		gui.ChildRemoved:Connect(refresh)
		gui:GetPropertyChangedSignal("Enabled"):Connect(refresh)
		gui.AncestryChanged:Connect(refresh)
		gui.Destroying:Connect(function()
			flag(key, false)
		end)
		for _, child in ipairs(gui:GetChildren()) do
			wire(child)
		end
		refresh()
	end
end

local WATCHERS = {
	NimbusLoading = watchLoading,
	NimbusNotify = watchNotify,
	NimbusTutorial = watchTutorial,
	-- the egg stage (lobby-shop Task 22, client/UI/EggStage: Skip, SPIN AGAIN, DONE), full screen and not docked
	NimbusHatch = watchOverlays({ "Stage" }),
	-- NpcController's dialog card (Next / Close buttons), like the tutorial card
	NimbusNpcDialog = watchOverlays({ "NpcDialog" }),
}

local function watchChild(child)
	local fn = WATCHERS[child.Name]
	if fn and not St.Wired[child] and child:IsA("ScreenGui") then
		St.Wired[child] = true
		local ok, err = pcall(fn, child)
		if not ok then
			warn("[MouseLock] watcher " .. child.Name .. ": " .. tostring(err))
		end
	end
end

local function watchPlayerGui()
	local player = Players.LocalPlayer
	if not player then
		return
	end
	local pg = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 30)
	if not pg then
		return
	end
	pg.ChildAdded:Connect(watchChild)
	for _, child in ipairs(pg:GetChildren()) do
		watchChild(child)
	end
end

----------------------------------------------------------------------
-- start
----------------------------------------------------------------------
local function settings()
	if St.Settings == nil then
		St.Settings = false
		local module = script.Parent and script.Parent:FindFirstChild("ClientSettings")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				St.Settings = mod
			end
		end
	end
	return St.Settings or nil
end

local function toggle()
	local cs = settings()
	if cs and type(cs.Set) == "function" then
		local ok, changed = pcall(cs.Set, "MouseLock", not St.Enabled)
		if ok and changed then
			return -- Changed fires -> SetEnabled
		end
	end
	MouseLock.SetEnabled(not St.Enabled)
end
MouseLock._toggle = toggle

function MouseLock.Start()
	if St.Started then
		return
	end
	St.Started = true
	local cs = settings()
	if cs then
		local ok, value = pcall(cs.Get, "MouseLock")
		St.Enabled = ok and value == true
		if cs.Changed and type(cs.Changed.Connect) == "function" then
			cs.Changed:Connect(function(key, value2)
				if key == "MouseLock" then
					MouseLock.SetEnabled(value2 == true)
				end
			end)
		end
	end
	for _, prop in ipairs({ "KeyboardEnabled", "MouseEnabled" }) do
		pcall(function()
			UserInputService:GetPropertyChangedSignal(prop):Connect(update)
		end)
	end
	UserInputService.TextBoxFocused:Connect(function()
		flag("auto:TextBox", true)
	end)
	UserInputService.TextBoxFocusReleased:Connect(function()
		flag("auto:TextBox", false)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input and input.KeyCode == K.KEY and desktop() then
			toggle()
		end
	end)
	task.spawn(watchPlayerGui) -- runs at once up to its first yield: the screens up now hold before the first update
	update()
end

return MouseLock
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1179">
          <Properties>
            <string name="Name">PortalVortex</string>
            <string name="Source"><![CDATA[-- PortalVortex (client, Phase 6 W2b): the magical swirling vortex inside a gate's hoop (the player's reference: spiral
-- arms turning into a deep centre, a bright glowing rim with small lightning crackles, thin light streaks pulled
-- inward), in the gate's own colour and bright enough for the cute voxel world. PortalFxController owns WHEN (which
-- gates, distance, quality); this module owns WHAT. Two modes, chosen per gate when it is built:
--   "Texture"   every key of K.TEXTURE_KEYS has an id in shared/TextureIds (tools/upload_assets.py --textures fills it):
--               a SurfaceGui (LightInfluence 0, Brightness 2, AlwaysOnTop false) on an invisible client plane inside
--               the ring holding the layers of blender/textures/build_vortex.py: the disc, the deep core, the broad arms
--               and the fine streaks turning at two speeds (clockwise: they flow inward), two streak layers shrinking to
--               the centre in turn, the rim breathing, four lightning frames that flicker softly at seeded random times;
--               a second, simpler SurfaceGui on the back face (disc, arms, rim)
--   "Fallback"  no ids yet (today): the same look from effects only: two invisible client spinner parts with curved
--               Beam spiral arms (broad + fine, two speeds), a ParticleEmitter of light streaks pulled to the centre
--               (Disc, Inward, VelocityParallel + Squash), a rim crackle emitter bursting at seeded random times, and
--               the old Neon swirl recoloured deep as the backdrop
-- Everything is created ONCE per gate (an invisible, anchored, non-colliding, non-querying, non-touching client part:
-- nothing replicates), disabled when the gate stops animating and destroyed with Destroy. No part of the gate itself is
-- moved, resized or re-parented. Per frame only numbers change (rotations, transparencies, the spinners' CFrame) and
-- every value is quantised and written only on a change. Plain Lua 5.1-compatible syntax only.
--
--   PortalVortex.Mode(ids) -> "Texture" | "Fallback"
--   PortalVortex.Layout(rec, mode) -> { Center = CFrame, Radius, Arch, Behind }   (from the gate's Swirl parts; tests)
--   PortalVortex.Build(rec, folder, ids, color, seed) -> v
--   PortalVortex.Show(v, on)            PortalVortex.Animate(v, t, fade, static)        PortalVortex.Destroy(v)
--   PortalVortex.SwirlLook(v) -> { Color, Transparency }   what the gate's old Swirl parts show while the vortex does
--   PortalVortex.SetLook(v, scale, dim) -> writes   a vortex that grows / shrinks (scale 0..1 of its built size, about
--                                       its centre) and dims (0 = as built, 1 = gone); writes only on a (quantised) change
-- A caller without Swirl parts (the per-player home portal, HomePortalFx; PortalFxController for a gate with a
-- VortexCenter part, spec 16.16: the Storm Altar island's return ring) passes rec.Fixed = { Center = CFrame, Radius,
-- Speed } instead: the vortex floats at Center (its front = -Z), Radius studs across, turning Speed x as fast.
-- Boost (lobby shop 5.11 a): Build reads rec.Model's "VortexBoost" attribute (WorldStyle.BuildGate writes it; the Storm
-- Altar gate's 1.4): v.Boost = max(1, it or 1). Above 1 the LIGHT tints (arm, fine, spark, rim) are lifted toward white
-- by Boost - 1; the deep disc and the core (and so SwirlLook's backdrop) keep the plain tints, and the glow rises by
-- min(Boost, BOOST_GLOW_CAP) (Texture: SurfaceGui Brightness = BRIGHTNESS x that; Fallback: every LightEmission x that,
-- capped at 1). Spec 16.16 (owner 2026-11-08): lifting every layer and glowing x 1.4 pushed every channel of every
-- layer over 1, so the whole vortex rendered as one flat white disc. Boost 1 gives the plain numbers exactly.

local PortalVortex = {}

local FxSprites = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("FxSprites"))

local K = {
	TEXTURE_KEYS = { "vortex_disc", "vortex_core", "vortex_arms", "vortex_fine", "vortex_streaks", "vortex_rim" },
	CRACKLES = { "vortex_crackle_1", "vortex_crackle_2", "vortex_crackle_3", "vortex_crackle_4" },
	CANVAS = 512,
	BRIGHTNESS = 2,
	BOOST_GLOW_CAP = 1.15, -- a boosted gate glows at most this much more (spec 16.16: x 1.4 washed the vortex out white)
	RIM_PAD = 0.8, -- studs the disc reaches under the glow ring past the swirl's edge
	ARMS_SPEED = 26, -- degrees per second (clockwise = inward)
	FINE_SPEED = 48,
	STREAK_PERIOD = 1.8, -- seconds a streak layer takes from the rim to the centre
	STREAK_SPIN = 64,
	CRACKLE_GAP = { 0.7, 2.2 }, -- seconds between two crackles (seeded)
	CRACKLE_LIFE = 0.42, -- fade in 0.08, hold, fade out
	BREATH_PERIOD = 3.6,
	-- fallback
	ARMS = 6,
	FINE = 9,
	ARM_SWEEP = 2.8, -- radians an arm winds from the rim to the centre
	FINE_SWEEP = 3.4,
	STREAK_RATE = 20,
	CRACKLE_BURST = { 4, 7 },
}
PortalVortex.K = K

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local TWO_PI = math.pi * 2

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------

local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

local function try(inst, key, value)
	pcall(function()
		inst[key] = value
	end)
end

-- a deterministic random stream (no shared global state; tests replay it)
local function stream(seed)
	local s = math.floor(tonumber(seed) or 1) % 2147483646 + 1
	return function()
		s = (s * 48271) % 2147483647
		return s / 2147483647
	end
end

-- the gate colour made vivid (the gates' pastel accents look grey once darkened)
local function vivid(color)
	local ok, h, sat, val = pcall(function()
		return color:ToHSV()
	end)
	if not ok or type(h) ~= "number" then
		return color
	end
	return Color3.fromHSV(h, math.max(sat, 0.72), math.max(val, 0.92))
end

-- boost (lobby shop 5.11 a: the gate's VortexBoost, >= 1): above 1 the light tints are lifted toward white by boost - 1;
-- deep and core stay as they are (spec 16.16: the dark centre is what makes the swirl read); boost 1 = the plain tints
local LIFTED = { arm = true, fine = true, spark = true, rim = true }
local function tints(color, boost)
	local c = vivid(color)
	local t = {
		deep = c:Lerp(BLACK, 0.42),
		core = c:Lerp(BLACK, 0.78),
		arm = c:Lerp(WHITE, 0.22),
		fine = c:Lerp(WHITE, 0.72),
		spark = c:Lerp(WHITE, 0.88),
		rim = c:Lerp(WHITE, 0.62),
	}
	if type(boost) == "number" and boost > 1 then
		local k = math.min(1, boost - 1)
		for name in pairs(LIFTED) do
			t[name] = t[name]:Lerp(WHITE, k)
		end
	end
	return t
end

function PortalVortex.Mode(ids)
	if type(ids) ~= "table" then
		return "Fallback"
	end
	for _, key in ipairs(K.TEXTURE_KEYS) do
		local id = ids[key]
		if type(id) ~= "number" or id <= 0 then
			return "Fallback"
		end
	end
	return "Texture"
end

-- where the vortex sits: the middle of the gate's Swirl parts (in the GlowCore's frame). Behind = the textured disc of a
-- hoop: the old swirl is hidden and the disc sits inside the swirl's voxel layer, reaching just under the glow ring
-- (the ring's front faces cover its edge). Otherwise (the effects-only fallback, or the crowned arch whose taller
-- opening keeps the old swirl as backdrop) the vortex floats just in front of the swirl and stays inside its edge.
function PortalVortex.Layout(rec, mode)
	local fixed = rec.Fixed
	if type(fixed) == "table" and typeof(fixed.Center) == "CFrame" and type(fixed.Radius) == "number" then
		return { Center = fixed.Center, Radius = fixed.Radius, Arch = false, Behind = false }
	end
	local origin = rec.Origin or CFrame.new()
	local x0, x1, y0, y1 = math.huge, -math.huge, math.huge, -math.huge
	for _, e in ipairs(rec.Swirl or {}) do
		local p = e.Part
		local lp = origin:PointToObjectSpace(p.Position)
		local hx, hy = p.Size.X / 2, p.Size.Y / 2
		x0, x1 = math.min(x0, lp.X - hx), math.max(x1, lp.X + hx)
		y0, y1 = math.min(y0, lp.Y - hy), math.max(y1, lp.Y + hy)
	end
	local cx, cy, w, h = 0, 0, 11, 11
	if x0 < x1 and y0 < y1 then
		cx, cy, w, h = (x0 + x1) / 2, (y0 + y1) / 2, x1 - x0, y1 - y0
	end
	local arch = rec.Model and rec.Model:GetAttribute("GateShape") == "Arch" or (h - w) > 1.5
	arch = arch and true or false
	local behind = mode == "Texture" and not arch
	-- a smaller gate (WorldStyle's GateScale, the arena's Return gate) has a thinner glow ring: the pad shrinks with it
	local scale = rec.Model and tonumber(rec.Model:GetAttribute("GateScale")) or 1
	local radius = math.min(w, h) / 2 + (behind and K.RIM_PAD * scale or 0)
	return { Center = origin * CFrame.new(cx, cy, behind and -0.1 or -0.6), Radius = radius, Arch = arch, Behind = behind }
end

local function plane(folder, name, cf, radius)
	return make("Part", {
		Name = name,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
		CastShadow = false,
		Massless = true,
		Transparency = 1,
		Size = Vector3.new(radius * 2, radius * 2, 0.05),
		CFrame = cf,
	}, folder)
end

----------------------------------------------------------------------
-- texture mode
----------------------------------------------------------------------

local LAYERS = {
	{ Name = "Disc", Key = "vortex_disc", Tint = "deep", Z = 1 },
	{ Name = "Core", Key = "vortex_core", Tint = "core", Z = 2, T = 0.12 },
	{ Name = "Arms", Key = "vortex_arms", Tint = "arm", Z = 3, Spin = "ARMS_SPEED" },
	{ Name = "Fine", Key = "vortex_fine", Tint = "fine", Z = 4, Spin = "FINE_SPEED", Rot0 = 40, T = 0.12 },
	{ Name = "StreaksA", Key = "vortex_streaks", Tint = "spark", Z = 5, Flow = 0 },
	{ Name = "StreaksB", Key = "vortex_streaks", Tint = "spark", Z = 5, Flow = 0.5 },
	{ Name = "Rim", Key = "vortex_rim", Tint = "rim", Z = 6, Breath = true },
}
local BACK_LAYERS = { Disc = true, Arms = true, Rim = true }
PortalVortex.LAYERS = LAYERS

local function label(gui, spec, id, tint)
	return make("ImageLabel", {
		Name = spec.Name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Image = "rbxassetid://" .. tostring(id),
		ImageColor3 = tint,
		ImageTransparency = spec.T or 0,
		Rotation = spec.Rot0 or 0,
		ZIndex = spec.Z,
	}, gui)
end

local function surface(part, face, name, glow)
	local gui = make("SurfaceGui", {
		Name = name,
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.FixedSize,
		CanvasSize = Vector2.new(K.CANVAS, K.CANVAS),
		LightInfluence = 0,
		Brightness = K.BRIGHTNESS * glow, -- the gate's VortexBoost, capped at BOOST_GLOW_CAP (1 = today's glow)
		AlwaysOnTop = false,
		ClipsDescendants = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Adornee = part,
		Enabled = false,
	}, part)
	return gui
end

local function buildTexture(v, ids, tint)
	v.Front = surface(v.Plane, Enum.NormalId.Front, "VortexFront", v.Glow)
	v.Back = surface(v.Plane, Enum.NormalId.Back, "VortexBack", v.Glow)
	v.Layers, v.BackLayers, v.Crackles = {}, {}, {}
	for _, spec in ipairs(LAYERS) do
		local entry = { Spec = spec, Label = label(v.Front, spec, ids[spec.Key], tint[spec.Tint]), Base = spec.T or 0 }
		entry.Last = { Rotation = spec.Rot0 or 0, T = entry.Base, S = 1 }
		v.Layers[#v.Layers + 1] = entry
		if BACK_LAYERS[spec.Name] then
			local b = { Spec = spec, Label = label(v.Back, spec, ids[spec.Key], tint[spec.Tint]), Base = spec.T or 0 }
			b.Last = { Rotation = spec.Rot0 or 0, T = b.Base, S = 1 }
			v.BackLayers[#v.BackLayers + 1] = b
		end
	end
	for i, key in ipairs(K.CRACKLES) do
		local id = ids[key]
		if type(id) == "number" and id > 0 then
			local spec = { Name = "Crackle" .. i, Z = 7, T = 1 }
			local l = label(v.Front, spec, id, tint.spark)
			l.Visible = false
			v.Crackles[#v.Crackles + 1] = { Label = l, Last = 1 }
		end
	end
end

----------------------------------------------------------------------
-- fallback mode (effects only)
----------------------------------------------------------------------

-- one spiral arm from the rim to the centre as a cubic Bezier Beam (exact for the spiral's own tangents)
local function arm(part, i, n, radius, sweep, width0, width1, color, transparency, emission, name)
	local a0 = TWO_PI * (i - 1) / n
	local r0, r1 = radius * 0.9, radius * 0.1
	local k = math.log(r1 / r0)
	local function point(s)
		local r = r0 * math.exp(k * s)
		local th = a0 + sweep * s
		return Vector3.new(r * math.cos(th), r * math.sin(th), 0), r, th
	end
	local function tangent(s)
		local _, r, th = point(s)
		local dr = r * k
		return Vector3.new(dr * math.cos(th) - r * sweep * math.sin(th), dr * math.sin(th) + r * sweep * math.cos(th), 0)
	end
	local p0, p3 = point(0), point(1)
	local d0, d3 = tangent(0) / 3, tangent(1) / 3
	local normal = Vector3.new(0, 0, 1)
	local at0 = make("Attachment", { Name = name .. "A" .. i, CFrame = CFrame.fromMatrix(p0, d0.Unit, normal) }, part)
	local at1 = make("Attachment", { Name = name .. "B" .. i, CFrame = CFrame.fromMatrix(p3, d3.Unit, normal) }, part)
	return make("Beam", {
		Name = name .. i,
		Attachment0 = at0,
		Attachment1 = at1,
		CurveSize0 = d0.Magnitude,
		CurveSize1 = d3.Magnitude,
		FaceCamera = true,
		Segments = 16,
		Width0 = width0,
		Width1 = width1,
		Color = color,
		Transparency = transparency,
		LightEmission = emission,
		LightInfluence = 0,
		Brightness = 1.6,
		Enabled = false,
	}, part), at0, at1
end

local function buildFallback(v, tint, folder)
	local radius = v.Radius
	-- the gate's VortexBoost (capped at BOOST_GLOW_CAP) scales every LightEmission, capped at 1 (boost 1 = today's 0.7 / 1)
	local function glow(e)
		return math.min(1, e * v.Glow)
	end
	v.SpinA = plane(folder, "VortexArms", v.Center, radius)
	v.SpinB = plane(folder, "VortexFine", v.Center, radius)
	v.Beams = {}
	v.BeamBase = {} -- the built geometry of every beam (SetLook scales it)
	local function keep(beam, at0, at1)
		v.Beams[#v.Beams + 1] = beam
		v.BeamBase[#v.BeamBase + 1] = { Beam = beam, A0 = at0, A1 = at1, CF0 = at0.CFrame, CF1 = at1.CFrame, W0 = beam.Width0, W1 = beam.Width1,
			C0 = beam.CurveSize0, C1 = beam.CurveSize1, T = beam.Transparency }
	end
	local armColor = ColorSequence.new(tint.arm, tint.fine)
	local armT = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.55),
		NumberSequenceKeypoint.new(0.3, 0.12),
		NumberSequenceKeypoint.new(1, 0.9),
	})
	for i = 1, K.ARMS do
		keep(arm(v.SpinA, i, K.ARMS, radius, K.ARM_SWEEP, radius * 0.19, 0.12, armColor, armT, glow(0.7), "Arm"))
	end
	local fineColor = ColorSequence.new(tint.fine, tint.spark)
	local fineT = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.4, 0.3),
		NumberSequenceKeypoint.new(1, 0.95),
	})
	for i = 1, K.FINE do
		keep(arm(v.SpinB, i, K.FINE, radius, K.FINE_SWEEP, radius * 0.06, 0.03, fineColor, fineT, glow(1), "Fine"))
	end
	-- light streaks pulled to the centre
	local streaks = make("ParticleEmitter", {
		Name = "VortexStreaks",
		Rate = K.STREAK_RATE,
		Lifetime = NumberRange.new(0.7, 1.0),
		Speed = NumberRange.new(radius * 0.85, radius * 1.1),
		Size = NumberSequence.new(0.16),
		Color = ColorSequence.new(tint.spark, tint.fine),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.25, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		}),
		LightEmission = glow(1),
		LightInfluence = 0,
		EmissionDirection = Enum.NormalId.Front,
		Enabled = false,
	}, v.Plane)
	try(streaks, "Shape", Enum.ParticleEmitterShape.Disc)
	try(streaks, "ShapeStyle", Enum.ParticleEmitterShapeStyle.Surface)
	try(streaks, "ShapeInOut", Enum.ParticleEmitterShapeInOut.Inward)
	try(streaks, "ShapePartial", 1)
	try(streaks, "Orientation", Enum.ParticleOrientation.VelocityParallel)
	try(streaks, "Squash", NumberSequence.new(1.4))
	try(streaks, "Brightness", 2)
	FxSprites.Apply(streaks, "Glow") -- a soft round glow squashed along its flight (any orientation reads)
	v.Streaks = streaks
	v.StreakT = streaks.Transparency
	-- rim crackles: short bright sparks on the rim, emitted in soft bursts
	local crackle = make("ParticleEmitter", {
		Name = "VortexCrackle",
		Rate = 0,
		Lifetime = NumberRange.new(0.12, 0.24),
		Speed = NumberRange.new(0.2, 0.6),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.1) }),
		Color = ColorSequence.new(WHITE, tint.rim),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) }),
		Rotation = NumberRange.new(0, 360),
		LightEmission = glow(1),
		LightInfluence = 0,
		EmissionDirection = Enum.NormalId.Front,
		Enabled = false,
	}, v.Plane)
	try(crackle, "Shape", Enum.ParticleEmitterShape.Disc)
	try(crackle, "ShapeStyle", Enum.ParticleEmitterShapeStyle.Surface)
	try(crackle, "ShapePartial", 1)
	try(crackle, "Squash", NumberSequence.new(1.8))
	try(crackle, "Brightness", 2)
	FxSprites.Apply(crackle, "Spark")
	v.Crackle = crackle
end

----------------------------------------------------------------------
-- public
----------------------------------------------------------------------

function PortalVortex.Build(rec, folder, ids, color, seed)
	local mode = PortalVortex.Mode(ids)
	local layout = PortalVortex.Layout(rec, mode)
	-- lobby shop (5.11 a): the gate model's VortexBoost (the Altar's 1.4; none = 1)
	local model = rec.Model
	local boost = tonumber(typeof(model) == "Instance" and model:GetAttribute("VortexBoost") or nil)
	boost = (boost and boost > 1) and boost or 1 -- math.max(1, attribute or 1), a NaN or junk value reads as 1
	local tint = tints(color, boost)
	local v = {
		Boost = boost,
		Glow = math.min(boost, K.BOOST_GLOW_CAP), -- spec 16.16: the boost's glow, capped (boost 1 = 1)
		Mode = mode,
		Center = layout.Center,
		Radius = layout.Radius,
		Arch = layout.Arch,
		Behind = layout.Behind,
		Color = color,
		Tint = tint,
		Random = stream(seed),
		NextCrackle = 0.6,
		CrackleAt = -1,
		CrackleIndex = 0,
		Shown = false,
		Static = false,
		LastA = -1,
		LastB = -1,
		Speed = (type(rec.Fixed) == "table" and tonumber(rec.Fixed.Speed)) or 1,
		Scale = 1,
		Dim = 0,
	}
	v.Plane = plane(folder, "PortalVortex", layout.Center, layout.Radius)
	if v.Mode == "Texture" then
		buildTexture(v, ids, tint)
	else
		buildFallback(v, tint, folder)
	end
	return v
end

-- the old Neon swirl while the vortex shows: hidden behind the textured disc (hoops); a deep backdrop otherwise
function PortalVortex.SwirlLook(v)
	if v.Behind then
		return { Color = v.Tint.deep, Transparency = 1 }
	end
	return { Color = v.Tint.deep, Transparency = v.Mode == "Texture" and 0.55 or 0.3 }
end

function PortalVortex.Show(v, on)
	on = on and true or false
	if not v or v.Shown == on then
		return
	end
	v.Shown = on
	if v.Mode == "Texture" then
		v.Front.Enabled = on
		v.Back.Enabled = on
	else
		for _, b in ipairs(v.Beams) do
			b.Enabled = on
		end
		v.Streaks.Enabled = on and not v.Static
		v.Crackle.Enabled = false
	end
end

-- static = Low graphics: the vortex holds still (no spin, no streaks, no crackles)
function PortalVortex.SetStatic(v, static)
	static = static and true or false
	if not v or v.Static == static then
		return
	end
	v.Static = static
	if v.Mode == "Fallback" then
		v.Streaks.Enabled = v.Shown and not static
	else
		for _, c in ipairs(v.Crackles) do
			c.Label.Visible = false
			c.Last = 1
		end
		v.CrackleAt = -1
	end
end

local function write(entry, key, value)
	if entry.Last[key] ~= value then
		entry.Last[key] = value
		return true
	end
	return false
end

local function q(x, step)
	return math.floor(x / step + 0.5) * step
end

-- the crackle schedule (seeded): -> the index of the crackle to show (or 0) and its opacity 0..1
local function crackle(v, t)
	if t >= v.NextCrackle then
		local gap = K.CRACKLE_GAP
		v.CrackleAt = v.NextCrackle
		v.CrackleIndex = 1 + math.floor(v.Random() * 4) % 4
		v.NextCrackle = v.NextCrackle + gap[1] + (gap[2] - gap[1]) * v.Random()
		if t > v.NextCrackle then
			v.NextCrackle = t + gap[1]
		end
		v.Burst = true
	end
	local age = t - v.CrackleAt
	if v.CrackleAt < 0 or age < 0 or age > K.CRACKLE_LIFE then
		return 0, 0
	end
	local a
	if age < 0.08 then
		a = age / 0.08
	elseif age < 0.2 then
		a = 1
	else
		a = 1 - (age - 0.2) / (K.CRACKLE_LIFE - 0.2)
	end
	return v.CrackleIndex, math.max(0, math.min(1, a))
end

local function animateTexture(v, t, fade, breath)
	local writes = 0
	for _, list in ipairs({ v.Layers, v.BackLayers }) do
		local mirror = list == v.BackLayers and -1 or 1
		for _, e in ipairs(list) do
			local spec = e.Spec
			local rot, tr, sc = spec.Rot0 or 0, e.Base, 1
			if spec.Spin then
				rot = rot + K[spec.Spin] * v.Speed * t * mirror
			elseif spec.Flow then
				local phase = (t / K.STREAK_PERIOD + spec.Flow) % 1
				sc = 1.12 - 0.8 * phase
				local s = math.sin(math.pi * phase)
				tr = 1 - 0.9 * s * s * fade
				rot = K.STREAK_SPIN * t + spec.Flow * 180
			elseif spec.Breath then
				tr = 0.18 * (1 - breath * fade)
				sc = 1 + 0.015 * breath * fade
			elseif spec.Name == "Core" then
				tr = e.Base + 0.08 * breath * fade
			end
			rot = q(rot % 360, 0.5)
			tr = q(tr + (1 - tr) * v.Dim, 0.01)
			sc = q(sc, 0.005)
			if write(e, "Rotation", rot) then
				e.Label.Rotation = rot
				writes = writes + 1
			end
			if write(e, "T", tr) then
				e.Label.ImageTransparency = tr
				writes = writes + 1
			end
			if write(e, "S", sc) then
				e.Label.Size = UDim2.fromScale(sc, sc)
				writes = writes + 1
			end
		end
	end
	if not v.Static then
		local idx, a = crackle(v, t)
		for i, c in ipairs(v.Crackles) do
			local tr = (i == idx) and q(1 - 0.85 * a * fade * (1 - v.Dim), 0.02) or 1
			if tr ~= c.Last then
				c.Last = tr
				c.Label.ImageTransparency = tr
				c.Label.Visible = tr < 1
				writes = writes + 1
			end
		end
	end
	return writes
end

local function animateFallback(v, t)
	local writes = 0
	local a = q((K.ARMS_SPEED * v.Speed * t) % 360, 0.25)
	local b = q((K.FINE_SPEED * v.Speed * t + 23) % 360, 0.25)
	if a ~= v.LastA then
		v.LastA = a
		v.SpinA.CFrame = v.Center * CFrame.Angles(0, 0, -math.rad(a))
		writes = writes + 1
	end
	if b ~= v.LastB then
		v.LastB = b
		v.SpinB.CFrame = v.Center * CFrame.Angles(0, 0, -math.rad(b))
		writes = writes + 1
	end
	if not v.Static then
		crackle(v, t)
		if v.Burst then
			v.Burst = false
			local n = K.CRACKLE_BURST
			pcall(function()
				v.Crackle:Emit(n[1] + math.floor((n[2] - n[1] + 1) * v.Random()))
			end)
			writes = writes + 1
		end
	end
	return writes
end

-- one update at time t (seconds), fade 0..1 (the gate easing in), breath 0..1; -> property writes made
function PortalVortex.Animate(v, t, fade, breath, static)
	if not v or not v.Shown then
		return 0
	end
	if static then
		if v.StaticDone then
			return 0
		end
		v.StaticDone = true
		t, fade, breath = 0, 1, 0.5
	else
		v.StaticDone = false
	end
	if v.Mode == "Texture" then
		return animateTexture(v, t, fade or 1, breath or 0.5)
	end
	return animateFallback(v, t)
end

-- a NumberSequence with every transparency pushed toward 1 by dim
local function dimmed(seq, dim)
	if dim <= 0 then
		return seq
	end
	local keys = {}
	for i, kp in ipairs(seq.Keypoints) do
		keys[i] = NumberSequenceKeypoint.new(kp.Time, kp.Value + (1 - kp.Value) * dim)
	end
	return NumberSequence.new(keys)
end

-- grow / shrink about the centre (scale, quantised to 0.02) and dim (quantised to 0.05); -> property writes made
function PortalVortex.SetLook(v, scale, dim)
	if not v then
		return 0
	end
	scale = q(math.max(0.02, math.min(1, tonumber(scale) or 1)), 0.02)
	dim = q(math.max(0, math.min(1, tonumber(dim) or 0)), 0.05)
	local writes = 0
	if scale ~= v.Scale then
		v.Scale = scale
		local r = v.Radius * scale
		v.Plane.Size = Vector3.new(r * 2, r * 2, 0.05)
		writes = writes + 1
		if v.Mode == "Fallback" then
			for _, b in ipairs(v.BeamBase) do
				b.A0.CFrame = b.CF0 - b.CF0.Position + b.CF0.Position * scale
				b.A1.CFrame = b.CF1 - b.CF1.Position + b.CF1.Position * scale
				b.Beam.Width0, b.Beam.Width1 = b.W0 * scale, b.W1 * scale
				b.Beam.CurveSize0, b.Beam.CurveSize1 = b.C0 * scale, b.C1 * scale
				writes = writes + 6
			end
			v.Streaks.Speed = NumberRange.new(r * 0.85, r * 1.1)
			writes = writes + 1
		end
	end
	if dim ~= v.Dim then
		v.Dim = dim
		if v.Mode == "Fallback" then
			for _, b in ipairs(v.BeamBase) do
				b.Beam.Transparency = dimmed(b.T, dim)
				writes = writes + 1
			end
			v.Streaks.Transparency = dimmed(v.StreakT, dim)
			writes = writes + 1
		else
			for _, list in ipairs({ v.Layers, v.BackLayers }) do
				for _, e in ipairs(list) do
					e.Last.T = nil -- animateTexture writes every layer's transparency again, dimmed
				end
			end
		end
	end
	return writes
end

function PortalVortex.Destroy(v)
	if not v then
		return
	end
	for _, p in ipairs({ v.Plane, v.SpinA, v.SpinB }) do
		if p then
			p:Destroy()
		end
	end
	v.Shown = false
end

return PortalVortex
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1180">
          <Properties>
            <string name="Name">SkyTransition</string>
            <string name="Source"><![CDATA[-- SkyTransition (client): the sky's transition helpers (kit-b SKY lane, .superpowers/slop-audit/round3/BUILD_PLAN.md S2,
-- S3). S2 (sky audit F4): a theme's six 1024 px faces are fetched before its skybox swap, not at the swap itself, so a
-- slow device never shows mismatched or blank faces streaming in one by one. S3 (sky audit F10): a screen blur eases out
-- instead of vanishing in one frame.
--
--   SkyTransition.Preload(themeId [, wait]) -> ids | nil   one ContentProvider:PreloadAsync on the six "rbxassetid://"
--       faces of SkyFaces.For(themeId), in its own thread (never blocks the caller), or in the caller's thread when `wait`
--       is true (SkyController's raid queue: one theme at a time); nil (nothing fetched) for a theme that is not uploaded
--       or a junk id. SkyController calls it for the next theme when its blend window opens and for the four raid themes
--       a few seconds after PLAY. No state: Roblox caches what it has fetched, a second call costs nothing.
--   SkyTransition.BlurOut(blur [, seconds]) -> tween | nil   a BlurEffect's Size tweened to 0 (Quad In: the screen
--       clears slowly, then fast) over `seconds` (default Config.Sky.Transitions.Screen.Out), destroyed when the tween
--       completes; a cancelled tween (the effect wanted on again) leaves it in place for the caller to reuse. Anything but
--       a BlurEffect -> nil. HatchFx.Dim(false) uses it.
-- Plain Lua 5.1-compatible syntax only.

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local SkyFaces = require(Shared:WaitForChild("SkyFaces"))

local SkyTransition = {}

function SkyTransition.Preload(themeId, wait)
	local faces = SkyFaces.For(themeId)
	if not faces then
		return nil
	end
	local ids = {}
	for _, face in ipairs(SkyFaces.Faces) do
		ids[#ids + 1] = faces[SkyFaces.Slot[face]]
	end
	local function fetch()
		local ok, err = pcall(function()
			ContentProvider:PreloadAsync(ids)
		end)
		if not ok then
			warn("[SkyTransition] preload of " .. tostring(themeId) .. " failed: " .. tostring(err))
		end
	end
	if wait == true then
		fetch()
	else
		task.spawn(fetch)
	end
	return ids
end

function SkyTransition.BlurOut(blur, seconds)
	if typeof(blur) ~= "Instance" or not blur:IsA("BlurEffect") then
		return nil
	end
	seconds = tonumber(seconds)
	if not seconds or seconds ~= seconds or seconds <= 0 then
		local screen = Config.Sky.Transitions and Config.Sky.Transitions.Screen
		seconds = screen and tonumber(screen.Out) or 0.35
	end
	local tween = TweenService:Create(blur, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = 0 })
	tween.Completed:Connect(function(state)
		if state == Enum.PlaybackState.Completed then
			blur:Destroy()
		end
	end)
	tween:Play()
	return tween
end

return SkyTransition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1181">
          <Properties>
            <string name="Name">SoundFx</string>
            <string name="Source"><![CDATA[-- SoundFx: UI sounds, background music and the positional loops (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2 / 7.3;
-- the original audio: Config.Audio, shared/AudioIds.lua written by tools/upload_assets.py --audio).
-- Ids come from Config.Audio (`Music = { Lobby, Battle, Dungeon }`, `Sfx = { Click, Confirm, Error, Reward, Whoosh,
-- Inhale, Shatter }`, `Ambient = { CrowdCheer, DrumLoop }`: AudioIds numbers). A missing id is silent and nothing breaks:
-- no Sound is made, nothing is warned.
--
--   SoundFx.Play(name, opts)  one-shot (any NAMES entry) at its slot volume x the Sfx setting (pooled Sounds, a random
--                             pitch in Config.Audio.Pitch[key] (default 0.95-1.05) so repeats do not tire the ear);
--                             Config.Audio.MinGap[key] and Caps keep frequent keys from piling up (a skipped play = nil);
--                             opts.Scale = volume x (a spectator's half volume, a boss KO's x1.2), opts.Gap = the MinGap
--                             key to use (a rotation shares its name's); returns the Sound or nil
--   SoundFx.PlayVariant(name, opts) one of Config.Audio.Variants[name] (the KO rotation): a random one that has an id,
--                             never the one played last; falls back to Play(name) when the name has no variants
--   SoundFx.Music(context)    "Lobby" | "Battle" | "Dungeon" | nil: loops Config.Audio.Music[context] at its slot volume x
--                             the Music setting, Config.Audio.Fade crossfade from the track before (Lobby / Dungeon resume
--                             where they stopped); nil fades the music out
--   SoundFx.SetLayer(name, on) the game state's music: "Battle" (BattleController) over "Dungeon" (DungeonController) over
--                             the base "Lobby"; plays the top layer that is on -> the context
--   SoundFx.Positional(name, parent, opts) -> Sound | nil   a looped 3D Sound of Ambient[name] (or any NAMES entry) in
--                             `parent` (a BasePart or an Attachment): RollOffMode InverseTapered, Config.Audio.Positional
--                             Min / Max studs (opts.Min / opts.Max win), slot volume x its setting; follows the settings
--   SoundFx.Current()         -> the music context playing (or nil)
--   SoundFx.Volume(kind)      -> 0..1 for "Music" / "Sfx" (ClientSettings)
--   SoundFx.SlotVolume(name, group) -> 0..1: Config.Audio.Volume[key] x the setting that key follows
--   SoundFx.Id(group, name)   -> "rbxassetid://<id>" | nil
--
-- Settings changes apply at once (ClientSettings.Changed) to the music and every positional loop. Sounds live in
-- SoundService (music, one-shots) or in their world part (positional); all client-side, never replicated.
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

local ClientSettings = require(script.Parent:WaitForChild("ClientSettings"))

local SoundFx = {}

local POOL = 3 -- Sounds per sfx name
local NAMES = { "Click", "Confirm", "Error", "Reward", "Whoosh", "Inhale", "Shatter", "CrowdCheer", "DrumLoop", "Fountain",
	-- audio wave 2
	"HitWater", "HitFlame", "HitFrost", "HitNature", "HitEarth", "HitStorm", "HitCelestial", "HitShadow", "Crit",
	"KO", "KO2", "KO3", "KO4", "Dash", "Parry", "PortalEnter", "PortalArrive", "StationBuild", "HouseTier",
	"DialogOpen", "DialogBlip", "DialogNext", "TutorialStep", "SpinStart", "SpinTick", "SpinLand",
	"RevealCommon", "RevealRare", "RevealLegendary",
	-- store (2026-11-04): silent until AudioIds has the key; StorePop / StoreBuy callers fall back to Click / Reward
	"StorePop", "StoreBuy", "TroveOpen", "DailyWeek",
	-- the egg cutscene (lobby-shop Task 27, uploaded 2026-11-07): a key with id 0 is silent; EggStage plays Config.Audio.Fallback then
	"EggStripTick", "EggStripLand", "EggRise", "EggShake", "EggCrack", "EggBurst", "EggCloudRing",
	"EggRevealCommon", "EggRevealEpic", "EggRevealLegend", "EggRevealSecret" }
do
	-- the NPC voices (Config.Audio.Keys.Sfx Npc<Name><Kind>), sorted
	local keys = type(Config.Audio) == "table" and type(Config.Audio.Keys) == "table" and Config.Audio.Keys.Sfx or {}
	local voices = {}
	for name in pairs(keys) do
		if string.sub(name, 1, 3) == "Npc" then
			voices[#voices + 1] = name
		end
	end
	table.sort(voices)
	for _, name in ipairs(voices) do
		NAMES[#NAMES + 1] = name
	end
end
local LAYERS = { "Battle", "Dungeon" } -- SetLayer priority (first on wins); none on = BASE
local BASE = "Lobby"

local St = {
	Folder = nil,
	Pools = {}, -- [name] = { Sound, ... }
	Next = {}, -- [name] = next pool index
	Music = nil, -- the playing music Sound
	FadeIn = nil, -- its fade-in Tween while it runs (a settings change cancels it: the new volume wins)
	Context = nil,
	Layers = {}, -- [layer] = true while on
	Pos = {}, -- [context] = TimePosition when it faded out (Config.Audio.Resume)
	Loops = {}, -- [Sound] = { name, group } (positional loops: the settings follow them)
	Hooked = false,
	Rng = Random.new(5),
	Last = {}, -- [MinGap key] = os.clock() of its last play
	Recent = {}, -- [Caps prefix] = { os.clock(), ... } of the plays inside its window
	LastVariant = {}, -- [variant name] = the file it played last
}
SoundFx._St = St

local function audio()
	return type(Config.Audio) == "table" and Config.Audio or {}
end

-- the group a name lives in ("Sfx" first: Play("CrowdCheer") finds it in Ambient)
local function groupOf(name)
	for _, group in ipairs({ "Sfx", "Ambient", "Music" }) do
		local keys = type(audio().Keys) == "table" and audio().Keys[group] or nil
		if type(keys) == "table" and keys[name] ~= nil then
			return group
		end
	end
	return "Sfx"
end

-- -> "rbxassetid://<id>" for an AudioIds number (Config.Audio), nil while it has no id. A non-empty string id is
-- taken as it is (the tools' drivers give one).
function SoundFx.Id(group, name)
	local list = audio()[group]
	local id = type(list) == "table" and list[name] or nil
	if type(id) == "number" and id > 0 and id == math.floor(id) then
		local digits = string.format("%d", id) -- (never tostring: a 15-digit id must not print as 1.2e+14)
		return "rbxassetid://" .. digits
	end
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

function SoundFx.Volume(kind)
	local value = ClientSettings.Get(kind)
	if type(value) ~= "number" then
		return 0
	end
	return math.max(0, math.min(1, value / 10))
end

-- the AudioIds key of a name in its group (Config.Audio.Keys), the name itself when unlisted
local function keyOf(group, name)
	local keys = type(audio().Keys) == "table" and audio().Keys[group] or nil
	local key = type(keys) == "table" and keys[name] or nil
	return type(key) == "string" and key or name
end

local function settingOf(group, name)
	local map = type(audio().Setting) == "table" and audio().Setting or {}
	local s = map[keyOf(group, name)]
	if s == "Music" or s == "Sfx" then
		return s
	end
	return group == "Music" and "Music" or "Sfx"
end

function SoundFx.SlotVolume(name, group)
	group = group or groupOf(name)
	local volumes = type(audio().Volume) == "table" and audio().Volume or {}
	local slot = tonumber(volumes[keyOf(group, name)]) or 1
	return math.max(0, math.min(1, slot)) * SoundFx.Volume(settingOf(group, name))
end

local function folder()
	if St.Folder and St.Folder.Parent then
		return St.Folder
	end
	local f = Instance.new("Folder")
	f.Name = "NimbusSounds"
	f.Parent = SoundService
	St.Folder = f
	return f
end

local function onChanged(key)
	if key ~= "Music" and key ~= "Sfx" then
		return
	end
	if key == "Music" and St.Music and St.Context then
		if St.FadeIn then
			pcall(function()
				St.FadeIn:Cancel() -- (else the fade-in would still end on the volume of the old setting)
			end)
			St.FadeIn = nil
		end
		St.Music.Volume = SoundFx.SlotVolume(St.Context, "Music")
	end
	for sound, rec in pairs(St.Loops) do
		if not sound.Parent then
			St.Loops[sound] = nil
		elseif settingOf(rec.group, rec.name) == key then
			sound.Volume = SoundFx.SlotVolume(rec.name, rec.group)
		end
	end
end

local function hook()
	if St.Hooked then
		return
	end
	St.Hooked = true
	ClientSettings.Changed:Connect(onChanged)
end

-- the PlaybackSpeed range of a key (Config.Audio.Pitch), 0.95-1.05 when unlisted
local function pitchOf(key)
	local map = type(audio().Pitch) == "table" and audio().Pitch or {}
	local r = map[key]
	local lo = type(r) == "table" and tonumber(r[1]) or nil
	local hi = type(r) == "table" and tonumber(r[2]) or nil
	if not lo or not hi or lo <= 0 or hi < lo then
		return 0.95, 1.05
	end
	return lo, hi
end

-- the Caps entry a key falls under (its Prefix), or nil
local function capOf(key)
	local caps = type(audio().Caps) == "table" and audio().Caps or {}
	for _, cap in ipairs(caps) do
		if type(cap) == "table" and type(cap.Prefix) == "string" and string.sub(key, 1, #cap.Prefix) == cap.Prefix then
			return cap
		end
	end
	return nil
end

-- MinGap + Caps: -> true when the key may play now (and records the play)
local function admit(key, gapKey)
	local now = os.clock()
	local gaps = type(audio().MinGap) == "table" and audio().MinGap or {}
	local gap = tonumber(gaps[gapKey]) or 0
	local last = St.Last[gapKey]
	if gap > 0 and last and now - last < gap and now >= last then
		return false
	end
	local cap = capOf(key)
	local recent = nil
	if cap then
		recent = St.Recent[cap.Prefix] or {}
		St.Recent[cap.Prefix] = recent
		local window = tonumber(cap.Window) or 0.25
		local i = 1
		while i <= #recent do
			if now - recent[i] >= window or now < recent[i] then
				table.remove(recent, i)
			else
				i = i + 1
			end
		end
		if #recent >= (tonumber(cap.Max) or 8) then
			return false
		end
	end
	St.Last[gapKey] = now
	if recent then
		recent[#recent + 1] = now
	end
	return true
end

function SoundFx.Play(name, opts)
	hook()
	opts = type(opts) == "table" and opts or nil
	local group = groupOf(name)
	local id = SoundFx.Id(group, name)
	if not id then
		return nil
	end
	local scale = opts and tonumber(opts.Scale) or 1
	local volume = math.min(1, SoundFx.SlotVolume(name, group) * math.max(0, scale))
	if volume <= 0 then
		return nil
	end
	local key = keyOf(group, name)
	local gapKey = opts and type(opts.Gap) == "string" and opts.Gap or key
	if not admit(key, gapKey) then
		return nil
	end
	local pool = St.Pools[name]
	if not pool then
		pool = {}
		for i = 1, POOL do
			local s = Instance.new("Sound")
			s.Name = "Sfx_" .. name .. "_" .. i
			s.SoundId = id
			s.Parent = folder()
			pool[i] = s
		end
		St.Pools[name] = pool
		St.Next[name] = 1
	end
	local index = St.Next[name] or 1
	St.Next[name] = index % #pool + 1
	local sound = pool[index]
	sound.SoundId = id
	sound.Volume = volume
	local lo, hi = pitchOf(key)
	sound.PlaybackSpeed = lo + St.Rng:NextNumber() * (hi - lo)
	pcall(function()
		sound:Play()
	end)
	return sound
end

function SoundFx.PlayVariant(name, opts)
	local variants = type(audio().Variants) == "table" and audio().Variants[name] or nil
	if type(variants) ~= "table" or #variants == 0 then
		return SoundFx.Play(name, opts)
	end
	local have = {}
	for _, v in ipairs(variants) do
		if SoundFx.Id(groupOf(v), v) then
			have[#have + 1] = v
		end
	end
	if #have == 0 then
		return nil
	end
	local last = St.LastVariant[name]
	local choices = {}
	for _, v in ipairs(have) do
		if v ~= last then
			choices[#choices + 1] = v
		end
	end
	if #choices == 0 then
		choices = have -- (one id left: that one)
	end
	local pick = choices[St.Rng:NextInteger(1, #choices)]
	local o = {}
	for k, v in pairs(opts or {}) do
		o[k] = v
	end
	o.Gap = o.Gap or keyOf(groupOf(name), name)
	local sound = SoundFx.Play(pick, o)
	if sound then
		St.LastVariant[name] = pick
	end
	return sound
end

local function fade()
	return math.max(0, tonumber(audio().Fade) or 1)
end

local function fadeOut(sound, context)
	if not sound then
		return
	end
	local resume = type(audio().Resume) == "table" and audio().Resume or {}
	if context and resume[context] then
		St.Pos[context] = sound.TimePosition
	end
	local tween = TweenService:Create(sound, TweenInfo.new(fade()), { Volume = 0 })
	tween.Completed:Connect(function()
		pcall(function()
			sound:Stop()
		end)
		sound:Destroy()
	end)
	tween:Play()
end

function SoundFx.Music(context)
	hook()
	if context == St.Context then
		return St.Music
	end
	local oldContext = St.Context
	St.Context = context
	local old = St.Music
	St.Music = nil
	if St.FadeIn then
		pcall(St.FadeIn.Cancel, St.FadeIn) -- (the old track's fade-in stops before its fade-out starts)
	end
	St.FadeIn = nil
	fadeOut(old, oldContext)
	local id = context and SoundFx.Id("Music", context) or nil
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Music_" .. tostring(context)
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = 0
	sound.TimePosition = St.Pos[context] or 0
	sound.Parent = folder()
	St.Music = sound
	pcall(function()
		sound:Play()
	end)
	local tween = TweenService:Create(sound, TweenInfo.new(fade()), { Volume = SoundFx.SlotVolume(context, "Music") })
	St.FadeIn = tween
	tween.Completed:Connect(function()
		if St.FadeIn == tween then
			St.FadeIn = nil
		end
	end)
	tween:Play()
	return sound
end

-- the context the layers ask for: the first LAYERS entry that is on, else BASE
function SoundFx.Wanted()
	for _, layer in ipairs(LAYERS) do
		if St.Layers[layer] then
			return layer
		end
	end
	return BASE
end

function SoundFx.SetLayer(name, on)
	if type(name) ~= "string" then
		return St.Music
	end
	St.Layers[name] = on and true or nil
	return SoundFx.Music(SoundFx.Wanted())
end

function SoundFx.Positional(name, parent, opts)
	hook()
	if typeof(parent) ~= "Instance" or not (parent:IsA("BasePart") or parent:IsA("Attachment")) then
		return nil
	end
	local group = groupOf(name)
	local id = SoundFx.Id(group, name)
	if not id then
		return nil
	end
	opts = type(opts) == "table" and opts or {}
	local ranges = type(audio().Positional) == "table" and audio().Positional[keyOf(group, name)] or nil
	ranges = type(ranges) == "table" and ranges or {}
	local minD = tonumber(opts.Min) or tonumber(ranges.Min) or 20
	local maxD = tonumber(opts.Max) or tonumber(ranges.Max) or 100
	local sound = Instance.new("Sound")
	sound.Name = opts.Name or ("Loop_" .. name)
	sound.SoundId = id
	sound.Looped = true
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = math.max(1, minD)
	sound.RollOffMaxDistance = math.max(minD + 1, maxD)
	sound.Volume = SoundFx.SlotVolume(name, group)
	sound.Parent = parent
	St.Loops[sound] = { name = name, group = group }
	sound.AncestryChanged:Connect(function()
		if not sound.Parent then
			St.Loops[sound] = nil
		end
	end)
	pcall(function()
		sound:Play()
	end)
	return sound
end

function SoundFx.Current()
	return St.Context
end

SoundFx.NAMES = NAMES
SoundFx.LAYERS = LAYERS

return SoundFx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1182">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- State: the client's read-only mirror of the player's saved profile (pets, items, stats, perks, the v3
-- Pet Index + tutorial progress and the Phase 2 tycoon data).
--
--   State.Init()                 connects Remotes.ProfileSync and asks the server for a snapshot (safe to call twice)
--   State.Get() -> snapshot      never nil; the snapshot is replaced (never mutated by us) on every ProfileSync,
--                                so a table you hold stays internally consistent. Do not write to it.
--   State.Changed                Util.Signal; Fire(snapshot) after every ProfileSync
--   State.OwnedCount(key)        State.IsEquipped(key)     State.EquippedCount(key)
--   State.Tokens()               reads the CloudTokens attribute, falls back to the snapshot (HUD cleanup: no
--                                ItemCount and no Items: the obby items are gone)
--   v3 (ARCHITECTURE_V3.md sections 1 + 3):
--   State.IsDiscovered(petId)    true once the pet was ever owned / rolled (an owned pet always counts; a tier key
--                                counts for its base pet, a hybrid key while it is owned)
--   State.IsClaimed(groupId)     true once that Pet Index group reward was claimed
--   Phase 2 (ARCHITECTURE_V3.md "Phase 2 build contract"; pet copies are keys, see shared/PetKeys.lua):
--   State.OwnedCount(key)        copies of a key: "petId" (Normal), "petId@Golden", "petId@Rainbow", "hyb:<uid>"
--   State.Keys() -> {key...}     every owned key in display order (PetKeys.List)
--   State.DefOf(key) -> def|nil  PetKeys.DefOf against the snapshot (tier finishes, merged hybrid looks)
--   State.PetLevel(key) -> level, xp      State.Food() -> {[foodId]=count}      State.FoodCount(foodId)
--   State.Home() -> { Level, Prestige, Stations = {[id]=level}, Garden = {[slot]=key}, Gym = {[slot]=key},
--                     CollectorCash, LegacySlots = n | nil, LegacyPrices = true | nil }
--                                (CollectorCash as of the last sync: the live amount is on the plot; the Phase 4
--                                LegacySlots / LegacyPrices are a veteran's extra garden places / old prices until
--                                their next Prestige, absent for everyone else)
--   State.Cash() / State.Gems()  read the Cash / Gems attributes, fall back to the snapshot
--   State.CashChanged / State.GemsChanged   Util.Signal, Fire(value) when the attribute changes
--
--   Phase 3 (ARCHITECTURE_V3.md "Phase 3 build contract"):
--   State.Teams() -> { Presets = { {key...}, {key...}, {key...} }, Active = 1..3, Slots = 3 | 4 }
--   State.Battle() -> { Trophies, TrialBest, TrialCleared = {[level]=true}, Raids, RaidBestDamage, RaidRewardAt, RaidLossAt, PvPWins,
--                       PvPLosses, EventPets = {[petId]=true} }   (RaidRewardAt / RaidLossAt: Unix seconds of the last paid raid win / loss)
--
--   Phase 4 (ARCHITECTURE_V3.md "Phase 4 build contract" section 4):
--   State.PetGrowth(key) -> { Evo = 0..2, Speed, Physique, Ability, Defense = 0..10, Job = { Stat, Ends, Rank, Slot,
--                             From, Paid } | nil }   always a table (zeros for a pet without growth; the server
--                             leaves zero numbers out of the snapshot and they are filled in here). Evo is the stored
--                             evolution stage (pressing EVOLVE), the four numbers are training ranks, Job the running
--                             training job (Ends = server os.time(); display only)
--   State.Ring() -> { Best, Runs }   the Champion Ring record (Best = the highest round won, Runs = finished runs)
--
--   Phase 5 (ARCHITECTURE_V3.md "Phase 5 build contract" 9.1 / 3.7 / 4.8):
--   State.Dungeon() -> { Best = 0..100, Cleared = {[floor]=true}, Runs, Clears }   (Cleared arrives as a dense array)
--   State.Berries() -> whole berries (reads the Berries attribute, falls back to the snapshot)
--   State.Settings() -> { Music 0..10, Sfx 0..10, Gfx "Auto"|"Low"|"High", Shake, SeenNotes, MouseLock, FastHatch }
--                       (per-key defaults)
--   State.SettingsChanged        Util.Signal; Fire(settings) after a ProfileSync that changed a setting
--   State.PetStage(key) -> 0..2  the stored evolution stage that counts (PetCatalog.EvolutionStage(def, level, Evo))
--   State.BestStage(petId) -> 0..2   the highest stage over the owned keys of that base pet (tier copies too)
--   State.Teams().Slots == 3     always (a fighter and two helpers)
--   Home gains DecorCredit = 1..18 | nil, LegacyMagnet = 1..5 | nil, LegacyMagnetStar = n | nil (the fold)
--
-- Extras (not part of the cross-module contract): State.IsLoaded(), State.Perks(), State.Stats(),
-- State.BerriesChanged (Signal, Fire(berries) when the Berries attribute changes),
-- State.EquippedList() (= State.ActiveTeam()), State.Busy(key) -> nil | "Training" | "Garden", State.TokensChanged (Signal, Fire(tokens) when the CloudTokens attribute changes),
-- State.DiscoveredCount(petIdList|nil), State.Tutorial() -> { Step, Done, Gifted }, State.Tiers(), State.Hybrids(),
-- State.IsTraining(key) (true while the key has a training Job), State.TrainingKeys() -> {[key] = true},
-- State.PetGrowthMap() -> the whole { [key] = entry } map (read-only).
--
-- The snapshot shape (ARCHITECTURE_V2.md section 1 + ARCHITECTURE_V3.md section 1 + Phase 2):
--   { Tokens, Pets = {[petId]=count}, Equipped = {key,...},
--     Stats = { Matches, Wins, TokensEarned, Spins, BestTimes = {[diffId]=sec} }, SpotIndex, Perks = {...},
--     Discovered = {[petId]=true}, IndexClaimed = {[groupId]=true}, Tutorial = { Step, Done, Gifted },
--     Cash, Gems, Home = {...}, Food = {[foodId]=count}, Tiers = {[petId]={Golden, Rainbow}},
--     Hybrids = {[uid]={Body, Style, Elements, Name, Rarity, Tier, Seed?, SpecialFrom?}}, PetLevels = {[key]={Level, Xp}},
--              (gui-redo: Elements in order; SpecialFrom = "Style" kept, anything else dropped = the Body's special)
--     Teams = {...}, Battle = {...},   (Phase 3; TrialCleared arrives as a dense array of booleans)
--     PetGrowth = {[key]={Evo?, Speed?, Physique?, Ability?, Defense?, Job?}}, Ring = { Best, Runs } }   (Phase 4)
-- Whatever arrives is sanitised here, so UI code can index it without nil/type checks. The server sends Garden /
-- Gym as arrays with "" for empty slots (remotes mangle sparse arrays); they are decoded to {[slot]=key} here.
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local State = {}

State.Changed = Util.Signal()
State.TokensChanged = Util.Signal()
State.CashChanged = Util.Signal()
State.GemsChanged = Util.Signal()
-- Phase 5
State.SettingsChanged = Util.Signal()
State.BerriesChanged = Util.Signal()

local PERK_KEYS = { "MaxHealth", "TokenBonus", "StaminaRegen", "CheckpointHeal" }
local STAT_KEYS = { "Matches", "Wins", "TokensEarned", "Spins" }
local RETRY_DELAYS = { 2, 4, 8, 15 } -- seconds between RequestProfile retries while no snapshot arrived
local MAX_ID_LENGTH = 64 -- ids longer than this are junk
local MAX_TUTORIAL_STEP = 1000
local MAX_SLOT = 64
local TIER_NAMES = { "Golden", "Rainbow" }
local VALID_TIER = { Normal = true, Golden = true, Rainbow = true }

-- shared/PetKeys (resolved on first use; State keeps working without it: keys then count as plain pet ids)
local petKeys = nil
local function getPetKeys()
	if petKeys then
		return petKeys
	end
	local module = Shared:FindFirstChild("PetKeys")
	if module then
		local ok, result = pcall(require, module)
		if ok and type(result) == "table" then
			petKeys = result
		end
	end
	return petKeys
end

local current = nil -- the live snapshot (always a table once the module is loaded)
local loaded = false -- true after the first ProfileSync
local initialised = false
local requestRemote = nil

----------------------------------------------------------------------
-- Sanitising
----------------------------------------------------------------------
local function num(value, default)
	if type(value) == "number" and value == value and value > -math.huge and value < math.huge then
		return value
	end
	return default
end

local function validId(key)
	return type(key) == "string" and key ~= "" and #key <= MAX_ID_LENGTH
end

-- { [id] = positive integer count } from a possibly messy table.
local function countMap(raw)
	local out = {}
	if type(raw) == "table" then
		for key, value in pairs(raw) do
			if type(key) == "string" and type(value) == "number" and value >= 1 then
				out[key] = math.floor(value)
			end
		end
	end
	return out
end

-- { [id] = true } from a set ({id = true}), a count map ({id = 2}) or a plain list ({"a", "b"}).
local function idSet(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, value in pairs(raw) do
		if validId(key) and (value == true or (type(value) == "number" and value > 0)) then
			out[key] = true
		elseif type(key) == "number" and validId(value) then
			out[value] = true
		end
	end
	return out
end

local function newTutorial()
	return { Step = 1, Done = false, Gifted = false }
end

local function cleanTutorial(raw)
	local t = newTutorial()
	if type(raw) == "table" then
		local step = num(raw.Step, 1)
		if step >= 1 then
			t.Step = math.min(math.floor(step), MAX_TUTORIAL_STEP)
		end
		t.Done = raw.Done == true
		t.Gifted = raw.Gifted == true
	end
	return t
end

local function wholeNumber(value)
	local n = num(value, 0)
	if n < 0 then
		return 0
	end
	return math.floor(n)
end

-- Garden / Gym: an array with "" holes, a map with numeric-string or name keys -> { [slot] = key }
local function slotMap(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, value in pairs(raw) do
		local slot = key
		if type(key) == "string" and string.find(key, "^%d+$") then
			slot = tonumber(key)
		end
		local okSlot = (type(slot) == "number" and slot >= 1 and slot <= MAX_SLOT and slot == math.floor(slot)) or validId(slot)
		if okSlot and validId(value) then
			out[slot] = value
		end
	end
	return out
end

local function newHome()
	return {
		Level = 0, Prestige = 0, Stations = {}, Garden = {}, Gym = {}, CollectorCash = 0, LegacySlots = nil, LegacyPrices = nil,
		DecorCredit = nil, LegacyMagnet = nil, LegacyMagnetStar = nil, -- Phase 5 (the fold)
	}
end

local function cleanHome(raw)
	local h = newHome()
	if type(raw) ~= "table" then
		return h
	end
	h.Level = wholeNumber(raw.Level)
	h.Prestige = wholeNumber(raw.Prestige)
	h.Stations = countMap(raw.Stations)
	h.Garden = slotMap(raw.Garden)
	h.Gym = slotMap(raw.Gym)
	h.CollectorCash = wholeNumber(raw.CollectorCash)
	-- Phase 4 (veterans only): a whole number of garden places >= 1, or nil; true, or nil
	local legacy = wholeNumber(raw.LegacySlots)
	if legacy >= 1 then
		h.LegacySlots = math.min(legacy, MAX_SLOT)
	end
	if raw.LegacyPrices == true then
		h.LegacyPrices = true
	end
	-- Phase 5 (the fold): DecorCredit 1..18 or nil; LegacyMagnet 1..5 with the Prestige it was folded at, or nil
	local credit = wholeNumber(raw.DecorCredit)
	if credit >= 1 then
		h.DecorCredit = math.min(credit, 18)
	end
	local magnet = wholeNumber(raw.LegacyMagnet)
	if magnet >= 1 then
		h.LegacyMagnet = math.min(magnet, 5)
		h.LegacyMagnetStar = wholeNumber(raw.LegacyMagnetStar)
	end
	return h
end

-- Phase 4: pet growth per key. The server leaves zero numbers out of the snapshot: they are filled in here, so every
-- entry has Evo and the four ranks.
local GROWTH_STATS = { "Speed", "Physique", "Ability", "Defense" }
local GROWTH_STAT_SET = { Speed = true, Physique = true, Ability = true, Defense = true }
local MAX_EVO = 2
local MAX_RANK = 10

local function newGrowth()
	local e = { Evo = 0 }
	for _, stat in ipairs(GROWTH_STATS) do
		e[stat] = 0
	end
	return e
end

local function cleanJob(raw)
	if type(raw) ~= "table" or not GROWTH_STAT_SET[raw.Stat] then
		return nil
	end
	local job = { Stat = raw.Stat, Ends = wholeNumber(raw.Ends), Rank = math.min(wholeNumber(raw.Rank), MAX_RANK), Slot = wholeNumber(raw.Slot), Paid = wholeNumber(raw.Paid) }
	if type(raw.From) == "string" and raw.From ~= "" then
		job.From = raw.From
	end
	return job
end

local function cleanGrowthEntry(raw)
	local e = newGrowth()
	if type(raw) ~= "table" then
		return e
	end
	e.Evo = math.min(wholeNumber(raw.Evo), MAX_EVO)
	for _, stat in ipairs(GROWTH_STATS) do
		e[stat] = math.min(wholeNumber(raw[stat]), MAX_RANK)
	end
	e.Job = cleanJob(raw.Job)
	return e
end

local function cleanGrowth(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, entry in pairs(raw) do
		if validId(key) and type(entry) == "table" then
			out[key] = cleanGrowthEntry(entry)
		end
	end
	return out
end

local function newRing()
	return { Best = 0, Runs = 0 }
end

local function cleanRing(raw)
	local r = newRing()
	if type(raw) == "table" then
		r.Best = wholeNumber(raw.Best)
		r.Runs = wholeNumber(raw.Runs)
	end
	return r
end

-- Phase 5: the Dungeon record. Cleared arrives as a dense boolean array (or a set) -> { [floor] = true }.
local MAX_FLOOR = 100

local function newDungeon()
	return { Best = 0, Cleared = {}, Runs = 0, Clears = 0 }
end

local function cleanDungeon(raw)
	local d = newDungeon()
	if type(raw) ~= "table" then
		return d
	end
	d.Best = math.min(wholeNumber(raw.Best), MAX_FLOOR)
	d.Runs = wholeNumber(raw.Runs)
	d.Clears = wholeNumber(raw.Clears)
	if type(raw.Cleared) == "table" then
		for key, value in pairs(raw.Cleared) do
			local floor = tonumber(key)
			if value == true and floor and floor >= 1 and floor <= MAX_FLOOR and floor == math.floor(floor) then
				d.Cleared[floor] = true
				if floor > d.Best then
					d.Best = floor
				end
			end
		end
	end
	return d
end

-- Phase 5: the settings with per-key defaults (7.2); a malformed value falls back to its default.
local SETTING_KEYS = { "Music", "Sfx", "Gfx", "Shake", "SeenNotes", "MouseLock", "FastHatch" }
-- (bug batch 2 #21: MouseLock defaults to ON, like DataService; a synced false stays false. Lobby shop 5.5: FastHatch,
-- default off)
local SETTING_DEFAULTS = { Music = 6, Sfx = 8, Gfx = "Auto", Shake = true, SeenNotes = 0, MouseLock = true, FastHatch = false }
local GFX_LEVELS = { Auto = true, Low = true, High = true }

local function newSettings()
	local s = {}
	for _, key in ipairs(SETTING_KEYS) do
		s[key] = SETTING_DEFAULTS[key]
	end
	return s
end

local function cleanSettings(raw)
	local s = newSettings()
	if type(raw) ~= "table" then
		return s
	end
	for _, key in ipairs({ "Music", "Sfx" }) do
		local v = raw[key]
		if type(v) == "number" and v == v and v >= 0 and v <= 10 and v == math.floor(v) then
			s[key] = v
		end
	end
	if type(raw.Gfx) == "string" and GFX_LEVELS[raw.Gfx] then
		s.Gfx = raw.Gfx
	end
	if type(raw.Shake) == "boolean" then
		s.Shake = raw.Shake
	end
	if type(raw.MouseLock) == "boolean" then
		s.MouseLock = raw.MouseLock
	end
	if type(raw.FastHatch) == "boolean" then
		s.FastHatch = raw.FastHatch
	end
	local notes = raw.SeenNotes
	if type(notes) == "number" and notes == notes and notes >= 0 and notes <= 1000 and notes == math.floor(notes) then
		s.SeenNotes = notes
	end
	return s
end

local function settingsEqual(a, b)
	for _, key in ipairs(SETTING_KEYS) do
		if a[key] ~= b[key] then
			return false
		end
	end
	return true
end

local function cleanTiers(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for petId, entry in pairs(raw) do
		if validId(petId) and type(entry) == "table" then
			local clean = nil
			for _, tier in ipairs(TIER_NAMES) do
				local n = wholeNumber(entry[tier])
				if n > 0 then
					clean = clean or {}
					clean[tier] = n
				end
			end
			if clean then
				out[petId] = clean
			end
		end
	end
	return out
end

local function cleanHybrids(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for uid, rec in pairs(raw) do
		if validId(uid) and type(rec) == "table" and validId(rec.Body) and validId(rec.Style) then
			local clean = { Body = rec.Body, Style = rec.Style, Elements = {}, Tier = VALID_TIER[rec.Tier] and rec.Tier or "Normal" }
			if type(rec.Elements) == "table" then
				for _, e in ipairs(rec.Elements) do
					if validId(e) then
						clean.Elements[#clean.Elements + 1] = e
					end
				end
			end
			if type(rec.Name) == "string" and rec.Name ~= "" then
				clean.Name = rec.Name
			end
			if validId(rec.Rarity) then
				clean.Rarity = rec.Rarity
			end
			if type(rec.Seed) == "number" and rec.Seed == rec.Seed then
				clean.Seed = rec.Seed
			end
			-- gui-redo: the Style gives the special (exactly "Style"; anything else = the Body), so State.DefOf gives the
			-- server's def (the Pets window's Special line, the form names, the Training / Fusion cards)
			if rec.SpecialFrom == "Style" then
				clean.SpecialFrom = "Style"
			end
			out[uid] = clean
		end
	end
	return out
end

local function cleanPetLevels(raw)
	local out = {}
	if type(raw) ~= "table" then
		return out
	end
	for key, entry in pairs(raw) do
		if validId(key) then
			local level, xp = 1, 0
			if type(entry) == "table" then
				level, xp = num(entry.Level, 1), num(entry.Xp, 0)
			elseif type(entry) == "number" then
				level = num(entry, 1)
			end
			out[key] = { Level = math.max(1, math.floor(level)), Xp = math.max(0, xp) }
		end
	end
	return out
end

-- Phase 3: battle teams. Presets are dense key lists (the server compacts them); Slots is 3, or 4 after Prestige 1.
-- Team balance: Busy = { [key] = "Training" | "Garden" } (such a key keeps its slot, it neither follows nor fights).
local TEAM_PRESETS = 3

local function newTeams()
	local presets = {}
	for i = 1, TEAM_PRESETS do
		presets[i] = {}
	end
	return { Presets = presets, Active = 1, Slots = 3, Busy = {} }
end

local function cleanTeams(raw)
	local t = newTeams()
	if type(raw) ~= "table" then
		return t
	end
	-- Phase 5 (4.8): Slots is 3 always (slot 1 = the fighter); a longer preset from an old snapshot keeps its first 3
	if type(raw.Presets) == "table" then
		for i = 1, TEAM_PRESETS do
			local list = raw.Presets[i]
			if type(list) == "table" then
				local seen = {}
				for _, key in ipairs(list) do
					if validId(key) and not seen[key] and #t.Presets[i] < t.Slots then
						seen[key] = true
						table.insert(t.Presets[i], key)
					end
				end
			end
		end
	end
	local active = num(raw.Active, 1)
	if active >= 1 and active <= TEAM_PRESETS then
		t.Active = math.floor(active)
	end
	if type(raw.Busy) == "table" then
		for key, why in pairs(raw.Busy) do
			if validId(key) and (why == "Training" or why == "Garden") then
				t.Busy[key] = why
			end
		end
	end
	return t
end

-- Phase 3: the battle record. TrialCleared becomes { [level] = true } (the server sends a dense boolean array).
local function newBattle()
	return {
		Trophies = 0,
		TrialBest = 0,
		TrialCleared = {},
		Raids = 0,
		RaidBestDamage = 0,
		RaidRewardAt = 0,
		RaidLossAt = 0,
		PvPWins = 0,
		PvPLosses = 0,
		EventPets = {},
	}
end

local function cleanBattle(raw)
	local b = newBattle()
	if type(raw) ~= "table" then
		return b
	end
	b.Trophies = wholeNumber(raw.Trophies)
	b.TrialBest = wholeNumber(raw.TrialBest)
	b.Raids = wholeNumber(raw.Raids)
	b.RaidBestDamage = wholeNumber(raw.RaidBestDamage)
	b.RaidRewardAt = wholeNumber(raw.RaidRewardAt)
	b.RaidLossAt = wholeNumber(raw.RaidLossAt)
	b.PvPWins = wholeNumber(raw.PvPWins)
	b.PvPLosses = wholeNumber(raw.PvPLosses)
	if type(raw.TrialCleared) == "table" then
		for level, value in pairs(raw.TrialCleared) do
			local n = level
			if type(level) == "string" then
				n = tonumber(level)
			end
			if type(n) == "number" and n >= 1 and n == math.floor(n) and value == true then
				b.TrialCleared[n] = true
				if n > b.TrialBest then
					b.TrialBest = n
				end
			end
		end
	end
	b.EventPets = idSet(raw.EventPets)
	return b
end

local function newSnapshot()
	local perks = {}
	for _, key in ipairs(PERK_KEYS) do
		perks[key] = 0
	end
	local stats = { BestTimes = {} }
	for _, key in ipairs(STAT_KEYS) do
		stats[key] = 0
	end
	return {
		Tokens = 0,
		Pets = {},
		Equipped = {},
		Stats = stats,
		SpotIndex = nil,
		Perks = perks,
		-- v3
		Discovered = {},
		IndexClaimed = {},
		Tutorial = newTutorial(),
		-- Phase 2
		Cash = 0,
		Gems = 0,
		Home = newHome(),
		Food = {},
		Tiers = {},
		Hybrids = {},
		PetLevels = {},
		-- Phase 3
		Teams = newTeams(),
		Battle = newBattle(),
		-- Phase 4
		PetGrowth = {},
		Ring = newRing(),
		-- Phase 5
		Dungeon = newDungeon(),
		Berries = 0,
		Settings = newSettings(),
	}
end

local function normalise(raw)
	local snap = newSnapshot()
	if type(raw) ~= "table" then
		return snap
	end
	snap.Tokens = math.max(0, math.floor(num(raw.Tokens, 0)))
	snap.Pets = countMap(raw.Pets)
	if type(raw.Equipped) == "table" then
		for _, id in ipairs(raw.Equipped) do
			if type(id) == "string" then
				table.insert(snap.Equipped, id)
			end
		end
	end
	if type(raw.Stats) == "table" then
		for _, key in ipairs(STAT_KEYS) do
			snap.Stats[key] = num(raw.Stats[key], 0)
		end
		if type(raw.Stats.BestTimes) == "table" then
			for id, seconds in pairs(raw.Stats.BestTimes) do
				if type(id) == "string" and type(seconds) == "number" then
					snap.Stats.BestTimes[id] = seconds
				end
			end
		end
	end
	if type(raw.Perks) == "table" then
		for _, key in ipairs(PERK_KEYS) do
			snap.Perks[key] = num(raw.Perks[key], 0)
		end
	end
	snap.SpotIndex = num(raw.SpotIndex, nil)

	-- v3: every owned pet counts as discovered, even when the server's set lags behind
	snap.Discovered = idSet(raw.Discovered)
	for id in pairs(snap.Pets) do
		if validId(id) then
			snap.Discovered[id] = true
		end
	end
	snap.IndexClaimed = idSet(raw.IndexClaimed)
	snap.Tutorial = cleanTutorial(raw.Tutorial)

	-- Phase 2
	snap.Cash = wholeNumber(raw.Cash)
	snap.Gems = wholeNumber(raw.Gems)
	snap.Home = cleanHome(raw.Home)
	snap.Food = countMap(raw.Food)
	snap.Tiers = cleanTiers(raw.Tiers)
	snap.Hybrids = cleanHybrids(raw.Hybrids)
	snap.PetLevels = cleanPetLevels(raw.PetLevels)
	-- Phase 3
	snap.Teams = cleanTeams(raw.Teams)
	snap.Battle = cleanBattle(raw.Battle)
	-- Phase 4
	snap.PetGrowth = cleanGrowth(raw.PetGrowth)
	snap.Ring = cleanRing(raw.Ring)
	-- Phase 5
	snap.Dungeon = cleanDungeon(raw.Dungeon)
	snap.Berries = wholeNumber(raw.Berries)
	snap.Settings = cleanSettings(raw.Settings)
	for id in pairs(snap.Tiers) do
		snap.Discovered[id] = true -- a tier copy counts for its base pet
	end
	return snap
end

current = newSnapshot()

----------------------------------------------------------------------
-- Reading
----------------------------------------------------------------------
local function attributeTokens()
	local player = Players.LocalPlayer
	if not player then
		return nil
	end
	local value = player:GetAttribute(Config.Attr.Tokens)
	if type(value) == "number" then
		return value
	end
	return nil
end

function State.Get()
	-- keep the token field in step with the replicated attribute (the attribute changes before the sync)
	local tokens = attributeTokens()
	if tokens ~= nil and current.Tokens ~= tokens then
		current.Tokens = tokens
	end
	return current
end

function State.IsLoaded()
	return loaded
end

-- Copies of a key ("petId" counts the Normal copies, "petId@Golden" the Golden ones, "hyb:<uid>" 0 or 1).
function State.OwnedCount(key)
	local keys = getPetKeys()
	if keys and type(keys.Count) == "function" then
		local ok, n = pcall(keys.Count, current, key)
		if ok and type(n) == "number" then
			return n
		end
		return 0
	end
	return current.Pets[key] or 0
end

State.Count = State.OwnedCount

function State.EquippedCount(petId)
	local n = 0
	for _, id in ipairs(current.Equipped) do
		if id == petId then
			n = n + 1
		end
	end
	return n
end

function State.IsEquipped(petId)
	return State.EquippedCount(petId) > 0
end

function State.Tokens()
	local tokens = attributeTokens()
	if tokens ~= nil then
		return tokens
	end
	return current.Tokens or 0
end

function State.Perks()
	return current.Perks
end

function State.Stats()
	return current.Stats
end

-- A copy, so callers may sort / edit it freely.
function State.EquippedList()
	local out = {}
	for i, id in ipairs(current.Equipped) do
		out[i] = id
	end
	return out
end

-- v3: Pet Index (base pets). A tier key counts for its base pet; a hybrid key counts while it is owned.
function State.IsDiscovered(petId)
	if type(petId) ~= "string" then
		return false
	end
	if current.Discovered[petId] == true or (current.Pets[petId] or 0) > 0 or current.Tiers[petId] ~= nil then
		return true
	end
	local keys = getPetKeys()
	local parsed = nil
	if keys and type(keys.Parse) == "function" then
		local ok, result = pcall(keys.Parse, petId)
		parsed = ok and result or nil
	end
	if not parsed or parsed.Key == nil or (parsed.PetId == petId and parsed.HybridId == nil) then
		return false
	end
	if parsed.HybridId then
		return State.OwnedCount(petId) > 0
	end
	return State.IsDiscovered(parsed.PetId)
end

function State.IsClaimed(groupId)
	if type(groupId) ~= "string" then
		return false
	end
	return current.IndexClaimed[groupId] == true
end

-- How many of `petIds` (a list of ids or of PetDefs) are discovered; without a list, every discovered id.
function State.DiscoveredCount(petIds)
	local n = 0
	if type(petIds) == "table" then
		for _, entry in ipairs(petIds) do
			local id = entry
			if type(entry) == "table" then
				id = entry.Id
			end
			if State.IsDiscovered(id) then
				n = n + 1
			end
		end
		return n
	end
	for _ in pairs(current.Discovered) do
		n = n + 1
	end
	return n
end

-- v3: tutorial progress as saved in the profile (TutorialState carries the live step text).
function State.Tutorial()
	return current.Tutorial
end

----------------------------------------------------------------------
-- Phase 2: pet keys, levels, food, home, Cash / Gems
----------------------------------------------------------------------
-- Every owned key in display order (catalog order, Normal / Golden / Rainbow, hybrids last).
function State.Keys()
	local keys = getPetKeys()
	if keys and type(keys.List) == "function" then
		local ok, list = pcall(keys.List, current)
		if ok and type(list) == "table" then
			return list
		end
	end
	local out = {}
	for id in pairs(current.Pets) do
		out[#out + 1] = id
	end
	table.sort(out)
	return out
end

-- The definition of a key (catalog def, tier def with Look.Finish, merged hybrid def), or nil. Read-only.
function State.DefOf(key)
	local keys = getPetKeys()
	if keys and type(keys.DefOf) == "function" then
		local ok, def = pcall(keys.DefOf, key, current)
		if ok then
			return def
		end
	end
	return nil
end

-- level, xp of a pet key (1, 0 when it never gained XP)
function State.PetLevel(key)
	local entry = type(key) == "string" and current.PetLevels[key]
	if entry then
		return entry.Level, entry.Xp
	end
	return 1, 0
end

function State.Food()
	return current.Food
end

function State.FoodCount(foodId)
	return current.Food[foodId] or 0
end

function State.Home()
	return current.Home
end

function State.Tiers()
	return current.Tiers
end

function State.Hybrids()
	return current.Hybrids
end

-- Phase 3
function State.Teams()
	return current.Teams
end

-- Team balance: nil | "Training" | "Garden": a busy pet keeps its team slot, it neither follows nor fights.
function State.Busy(key)
	return current.Teams.Busy[key]
end

-- Team balance: the pets that follow and fight, in slot order (the snapshot's Equipped = the active preset minus busy pets).
function State.ActiveTeam()
	return State.EquippedList()
end

function State.Battle()
	return current.Battle
end

-- Phase 4: one pet's growth { Evo, Speed, Physique, Ability, Defense, Job | nil } (always a table; zeros for a pet
-- without growth). Read-only: the entry belongs to the snapshot.
function State.PetGrowth(key)
	local entry = type(key) == "string" and current.PetGrowth[key]
	if entry then
		return entry
	end
	return newGrowth()
end

-- The whole growth map { [key] = entry } (read-only).
function State.PetGrowthMap()
	return current.PetGrowth
end

-- true while that key has a running training Job (it cannot be equipped, placed, fused or fielded meanwhile).
function State.IsTraining(key)
	local entry = type(key) == "string" and current.PetGrowth[key]
	return entry ~= nil and entry.Job ~= nil
end

-- { [key] = true } of every pet in training (a fresh table).
function State.TrainingKeys()
	local out = {}
	for key, entry in pairs(current.PetGrowth) do
		if entry.Job ~= nil then
			out[key] = true
		end
	end
	return out
end

-- The Champion Ring record { Best, Runs }.
function State.Ring()
	return current.Ring
end

-- Phase 5: the Dungeon record { Best, Cleared = {[floor]=true}, Runs, Clears } (read-only).
function State.Dungeon()
	return current.Dungeon
end

-- Phase 5: the settings { Music, Sfx, Gfx, Shake, SeenNotes } (read-only; every key present).
function State.Settings()
	return current.Settings
end

-- Phase 5 (3.7): the evolution stage that counts for an owned key: PetCatalog.EvolutionStage(def, level, Evo) with
-- the stored stage (hybrids through PetKeys.DefOf). 0 for an unknown key or without the catalog.
local petCatalog = nil
local function getPetCatalog()
	if petCatalog == nil then
		petCatalog = false
		local module = Shared:FindFirstChild("PetCatalog")
		if module then
			local ok, result = pcall(require, module)
			if ok and type(result) == "table" then
				petCatalog = result
			end
		end
	end
	return petCatalog or nil
end

function State.PetStage(key)
	if type(key) ~= "string" then
		return 0
	end
	local entry = current.PetGrowth[key]
	local stored = entry and entry.Evo or 0
	if stored < 1 then
		return 0
	end
	local catalog = getPetCatalog()
	local def = State.DefOf(key)
	if catalog and type(catalog.EvolutionStage) == "function" and def then
		local level = State.PetLevel(key)
		local ok, stage = pcall(catalog.EvolutionStage, def, level, stored)
		if ok and type(stage) == "number" then
			return stage
		end
	end
	return math.min(stored, MAX_EVO)
end

-- Phase 5 (3.7): the highest stage over the owned keys of a base pet id (its Normal / Golden / Rainbow copies).
function State.BestStage(petId)
	if type(petId) ~= "string" then
		return 0
	end
	local best = 0
	for key, entry in pairs(current.PetGrowth) do
		if entry.Evo and entry.Evo > best then
			local base = string.match(key, "^(.-)@[%w]+$") or key
			if base == petId and State.OwnedCount(key) > 0 then
				local stage = State.PetStage(key)
				if stage > best then
					best = stage
				end
			end
		end
	end
	return best
end

local function attributeNumber(name)
	local player = Players.LocalPlayer
	if not player or not name then
		return nil
	end
	local value = player:GetAttribute(name)
	if type(value) == "number" then
		return value
	end
	return nil
end

function State.Cash()
	local cash = attributeNumber(Config.Attr.Cash)
	if cash ~= nil then
		return cash
	end
	return current.Cash or 0
end

function State.Gems()
	local gems = attributeNumber(Config.Attr.Gems)
	if gems ~= nil then
		return gems
	end
	return current.Gems or 0
end

-- Phase 5: whole berries (the Berries attribute is written by DataService <= 2/s; the snapshot is the fallback)
function State.Berries()
	local berries = attributeNumber(Config.Attr.Berries)
	if berries ~= nil then
		return math.max(0, math.floor(berries))
	end
	return current.Berries or 0
end

----------------------------------------------------------------------
-- Server traffic
----------------------------------------------------------------------
local function apply(raw)
	if type(raw) ~= "table" then
		return
	end
	local previous = current
	current = normalise(raw)
	loaded = true
	State.Changed:Fire(State.Get())
	-- Phase 5: a setting changed on the server (another device, a merge) -> SettingsChanged(settings)
	if not settingsEqual(previous.Settings, current.Settings) then
		State.SettingsChanged:Fire(current.Settings)
	end
end

local function request()
	if requestRemote then
		pcall(function()
			requestRemote:FireServer()
		end)
	end
end

function State.Init()
	if initialised then
		return
	end
	initialised = true

	local okSync, syncRemote = pcall(Remotes.Get, "ProfileSync")
	if okSync and syncRemote then
		syncRemote.OnClientEvent:Connect(apply)
	else
		warn("[State] ProfileSync remote is unavailable: " .. tostring(syncRemote))
	end
	local okReq, req = pcall(Remotes.Get, "RequestProfile")
	if okReq and req then
		requestRemote = req
	else
		warn("[State] RequestProfile remote is unavailable: " .. tostring(req))
	end

	local player = Players.LocalPlayer
	if player then
		player:GetAttributeChangedSignal(Config.Attr.Tokens):Connect(function()
			State.TokensChanged:Fire(State.Tokens())
		end)
		if Config.Attr.Cash then
			player:GetAttributeChangedSignal(Config.Attr.Cash):Connect(function()
				State.CashChanged:Fire(State.Cash())
			end)
		end
		if Config.Attr.Gems then
			player:GetAttributeChangedSignal(Config.Attr.Gems):Connect(function()
				State.GemsChanged:Fire(State.Gems())
			end)
		end
		if Config.Attr.Berries then
			player:GetAttributeChangedSignal(Config.Attr.Berries):Connect(function()
				State.BerriesChanged:Fire(State.Berries())
			end)
		end
	end

	request()
	-- the first sync may have been sent before we were listening: ask again until one arrives
	task.spawn(function()
		for _, seconds in ipairs(RETRY_DELAYS) do
			task.wait(seconds)
			if loaded then
				return
			end
			request()
		end
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="1183">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="1184">
            <Properties>
              <string name="Name">CloudUI</string>
              <string name="Source"><![CDATA[-- CloudUI: the game's UI kit. v5 (Phase 5, ARCHITECTURE_V3.md "Phase 5 build contract" 6.6): every widget is re-skinned
-- on the Neon kit (client/UI/NeonKit.lua, image 21.png): dark navy faces, a glowing neon border in the widget's own
-- colour, GothamBlack labels with a dark stroke. Panel = a Neon card (accent = props.Accent, props.Category or Blue)
-- with a GothamBlack 34 title, a neon underline and a red X (drawn by NeonKit.CloseMark since the slop audit, 2026-11-12);
-- the cloud bumps, the sky-blue frame and the pixel glint of v3 are gone ("less cute"). The API, the names and the
-- attributes below are UNCHANGED.
-- kit-b U6: no widget text carries an outline or a classic stroke any more (every one sits on its own face, card or
-- bar: kit B "stroke or panel, never both").
-- (v3 text kept for the API:) the chunky "cloud" UI kit. Front-page-simulator style panels made cloudier: a thick dark
-- navy outline, glossy sky-blue frames with a bevelled rim, puffy cloud bumps along the top edge, a bold
-- title bar with big outlined title text and a red X, glossy buttons with a darker bottom lip, and a tiny
-- pixel glint (a nod to the voxel world). Everything is built from Frames / TextLabels / UICorner /
-- UIStroke / UIGradient / UIPadding / list+grid layouts. No images, no asset ids.
--
--   CloudUI.NewScreenGui(name, displayOrder) -> ScreenGui
--   CloudUI.Panel(props)      -> { Root, Body, Content, TitleBar, TitleLabel, CloseButton, Close, SetTitle, SetAccent, Destroy }
--   CloudUI.Button(props)     -> TextButton
--   CloudUI.IconButton(props) -> { Root, Button, Glyph, Caption, SetBadge, SetGlyph, SetLabel, SetColor }
--   CloudUI.Bar(props)        -> { Root, Fill, Label, SetFraction, SetText, SetColor, GetFraction }
--   CloudUI.Slot(props)       -> { Root, Button, SetContent, SetSelected, SetCount, SetHotkey, ... }
--   CloudUI.Tabs(props)       -> { Root, Content, Add, Select, GetSelected, GetPage, GetButton }
--   CloudUI.Grid(parent, cellSize, padding) -> ScrollingFrame (UIGridLayout, automatic canvas)
--   CloudUI.PetViewport(parent, petDef, size, opts) -> { Frame, Destroy, SetAnimated, SetExcited }   (opts.Evolved: Phase 4)
--   CloudUI.Pill(text, kind, parent) -> TextLabel
--   CloudUI.Tooltip(guiObject, textFn) -> disconnect function
--   CloudUI.RarityColor(rarityId) -> Color3
--   v3 readability helpers:
--   CloudUI.ScreenFactor()            -> Theme.ScreenFactor() (clamp(viewportY / 1080, 0.8, 1.25))
--   CloudUI.TextSize(basePx)          -> Theme.ScaledSize(basePx) for text that is not under a UIScale
--   CloudUI.AutoScale(guiObject, opts) -> UIScale kept at the screen factor (one shared camera listener)
--   CloudUI.Metrics / CloudUI.ContentInset(hasTitle, clouds) -> the panel geometry
--
-- Conventions
--   * Sizes are DESIGN pixels of a 1920x1080 screen and follow the v3 readability rule there (body text
--     >= 18, captions >= 15, buttons >= 20, titles 28-44). Put a widget tree under one UIScale of the screen
--     factor (CloudUI.AutoScale, or a window's own fit scale) and it reads well from phones to 1440p.
--   * Every constructor accepts Name / Parent / Position / AnchorPoint / Size in its props and names
--     its instances for debugging. Text uses Theme font roles only, with a stroke on every text.
--   * Buttons are plain TextButtons. Their state lives in attributes, so you can change it later:
--       button:SetAttribute("Disabled", true)   (or button.Active = false)   -> greyed out, callback ignored
--       button:SetAttribute("Style", "Gold")                                 -> re-skin
--     (CloudUI.SetDisabled / CloudUI.SetStyle do exactly that.) Setting button.Text just works.
--   * Hover / press feedback is a UIScale named "FxScale" (1.04 / 0.95). UIScale grows around the
--     AnchorPoint, so centre-anchored buttons look best.
--   * Panel.Content never gets decorative children, so callers may put a UIListLayout / UIGridLayout in it.
--   * ONE RenderStepped connection (CloudUI.Update) drives every pet viewport and the tooltip; it
--     disconnects itself when nothing needs it. Viewports of hidden or destroyed UI stop costing time.
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U8) the Signboard skin's roof and header
local PixelIcon = require(Shared:WaitForChild("PixelIcon"))
local NeonKit = require(script.Parent:WaitForChild("NeonKit"))

local CloudUI = {}

----------------------------------------------------------------------
-- Palette + tuning
----------------------------------------------------------------------
local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local MUTED = Colors.Muted or Colors.CloudShade
local GOLD = Colors.Gold or Colors.Token

local BUTTON_COLORS = Theme.Buttons or {}
local KIND_COLORS = Theme.Kinds or {}
-- v5 Neon kit colours
local NEON = Theme.Neon
local INK = Colors.PanelInk or Color3.fromRGB(8, 10, 28)
local PANEL_TOP = Colors.PanelTop or Color3.fromRGB(26, 32, 72)
local PANEL_BOTTOM = Colors.PanelBottom or Color3.fromRGB(12, 15, 38)
-- the neon colour of a button style name
local STYLE_NEON = { Green = "Green", Pink = "Pink", Red = "Red", Blue = "Blue", Gold = "Gold", Gray = "Grey" }

local HOVER_SCALE = 1.04
local PRESS_SCALE = 0.95
local FOV = 32 -- pet viewport camera
local TOOLTIP_DELAY = 0.35
local LONG_PRESS = 0.45

-- Panel geometry (design px)
local OUTLINE_THICKNESS = 3 -- v5: the neon border of every window
local PANEL_CORNER = 16
local PANEL_PAD = 12 -- frame border around the title bar and the content well
local TITLE_TOP = 10
local TITLE_H = 50
local TITLE_GAP = 10
local TITLE_TEXT = 34
local CLOSE_SIZE = 40
local SIGN_CLOSE = 44 -- (LOOK-ui) a Signboard window's red close block: one size with the Shop's, the Gifts' and the Pets sheet's
local UNTITLED_TOP_CLOUDS = 20 -- v5: no cloud bumps any more; an untitled panel keeps this room for its corner X

CloudUI.Metrics = {
	Outline = OUTLINE_THICKNESS,
	Corner = PANEL_CORNER,
	Pad = PANEL_PAD,
	TitleTop = TITLE_TOP,
	TitleHeight = TITLE_H,
	TitleGap = TITLE_GAP,
	TitleText = TITLE_TEXT,
	CloseSize = CLOSE_SIZE,
	ContentPad = 10, -- suggested padding for things laid out inside Panel.Content
	ButtonText = 22,
	ButtonHeight = 50,
	BodyText = 19,
	CaptionText = 16,
}

CloudUI.Palette = {
	Navy = NAVY,
	Gold = GOLD,
	Muted = MUTED,
	FrameTop = Colors.FrameTop,
	FrameBottom = Colors.FrameBottom,
	WellTop = Colors.WellTop,
	WellBottom = Colors.WellBottom,
	Mist = Colors.Mist,
	Buttons = BUTTON_COLORS,
}

-- Multiplier gradient for faces that carry TEXT. A UIGradient also tints the text of its TextLabel /
-- TextButton, so the gradient stays near white where the text sits and only darkens the "lip" band at
-- the bottom (hard step), which gives the glossy chunky 3-D look without recolouring the text.
local FACE_SEQUENCE = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
	ColorSequenceKeypoint.new(0.55, Color3.fromRGB(240, 242, 248)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 156, 184)),
})

----------------------------------------------------------------------
-- Small builders
----------------------------------------------------------------------
local function toUDim(value, default)
	if typeof(value) == "UDim" then
		return value
	end
	if type(value) == "number" then
		return UDim.new(0, value)
	end
	return default or UDim.new(0, 12)
end

local function toUDim2(value, default)
	if typeof(value) == "UDim2" then
		return value
	end
	if typeof(value) == "Vector2" then
		return UDim2.fromOffset(value.X, value.Y)
	end
	if type(value) == "number" then
		return UDim2.fromOffset(value, value)
	end
	return default
end

local function corner(parent, radius)
	return Util.Create("UICorner", { CornerRadius = toUDim(radius), Parent = parent })
end

local function round(parent)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return Util.Create("UIStroke", {
		Color = color or NAVY,
		Thickness = thickness or 3,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function padding(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = toUDim(left or 0),
		PaddingTop = toUDim(top or 0),
		PaddingRight = toUDim(right or 0),
		PaddingBottom = toUDim(bottom or 0),
		Parent = parent,
	})
end

local function gradient(parent, sequence, rotation)
	return Util.Create("UIGradient", { Color = sequence, Rotation = rotation or 90, Parent = parent })
end

local function frame(name, props, parent)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Soft translucent highlight strip near the top of a glossy face.
local function addShine(parent, heightScale, sideInset, transparency, zIndex)
	local shine = Util.Create("Frame", {
		Name = "Shine",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = transparency or 0.82,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 3),
		Size = UDim2.new(1, -2 * (sideInset or 10), heightScale or 0.32, 0),
		Active = false,
		ZIndex = zIndex or 1,
		Parent = parent,
	})
	round(shine)
	return shine
end

local function titleCase(text)
	text = tostring(text or "")
	return text:sub(1, 1):upper() .. text:sub(2):lower()
end

local function styleBase(style)
	return BUTTON_COLORS[titleCase(style)] or BUTTON_COLORS.Green or Color3.fromRGB(96, 196, 108)
end

local function isStyleName(style)
	return BUTTON_COLORS[titleCase(style)] ~= nil
end

local function isShown(gui)
	local node = gui
	while node do
		if node:IsA("GuiObject") then
			if not node.Visible then
				return false
			end
		elseif node:IsA("LayerCollector") then
			return node.Enabled ~= false
		end
		node = node.Parent
	end
	return false
end

----------------------------------------------------------------------
-- Readability helpers (v3)
----------------------------------------------------------------------
function CloudUI.ScreenFactor()
	return Theme.ScreenFactor()
end

-- Pixel size for text that is NOT under a UIScale (never below 14 px).
function CloudUI.TextSize(basePx, minPx)
	return Theme.ScaledSize(basePx, minPx)
end

-- Top / side / bottom insets of Panel.Content inside the panel (design px).
function CloudUI.ContentInset(hasTitle, clouds)
	local top = PANEL_PAD
	if hasTitle then
		top = TITLE_TOP + TITLE_H + TITLE_GAP
	elseif clouds ~= false then
		top = UNTITLED_TOP_CLOUDS -- v5: room for the corner X of an untitled panel
	end
	return top, PANEL_PAD, PANEL_PAD
end

local autoScales = {} -- { Scale = UIScale, Mult, Min, Max }
local autoCameraConn = nil
local autoWatchConn = nil

local function autoValue(entry)
	local value = Theme.ScreenFactor() * entry.Mult
	if entry.Min then
		value = math.max(entry.Min, value)
	end
	if entry.Max then
		value = math.min(entry.Max, value)
	end
	return value
end

local function refreshAutoScales()
	for i = #autoScales, 1, -1 do
		local entry = autoScales[i]
		if entry.Scale.Parent == nil then
			table.remove(autoScales, i)
		else
			entry.Scale.Scale = autoValue(entry)
		end
	end
end

local function bindAutoCamera()
	if autoCameraConn then
		autoCameraConn:Disconnect()
		autoCameraConn = nil
	end
	local camera = workspace.CurrentCamera
	if camera then
		autoCameraConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refreshAutoScales)
	end
	refreshAutoScales()
end

-- Adds (or reuses) a UIScale that keeps `guiObject` (designed in 1080p pixels) at the readability factor.
-- opts: Name (default "ReadScale"), Multiplier (default 1), Min, Max (clamp the final scale)
function CloudUI.AutoScale(guiObject, opts)
	if not guiObject then
		return nil
	end
	opts = opts or {}
	local name = opts.Name or "ReadScale"
	local scale = guiObject:FindFirstChild(name)
	if not (scale and scale:IsA("UIScale")) then
		scale = Util.Create("UIScale", { Name = name, Scale = 1, Parent = guiObject })
	end
	local entry = { Scale = scale, Mult = tonumber(opts.Multiplier) or 1, Min = opts.Min, Max = opts.Max }
	scale.Scale = autoValue(entry)
	table.insert(autoScales, entry)
	if not autoWatchConn then
		autoWatchConn = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindAutoCamera)
		bindAutoCamera()
	end
	return scale
end

----------------------------------------------------------------------
-- Shared update loop (ONE RenderStepped connection for viewports + tooltip)
----------------------------------------------------------------------
local tickers = {}
local loopConnection = nil
local clockTime = 0

function CloudUI.Update(dt)
	clockTime = clockTime + dt
	for i = #tickers, 1, -1 do
		local ticker = tickers[i]
		if ticker.dead then
			table.remove(tickers, i)
		else
			local ok, err = pcall(ticker.fn, dt, clockTime)
			if not ok then
				ticker.dead = true
				warn("[CloudUI] update error: " .. tostring(err))
			end
		end
	end
	if #tickers == 0 and loopConnection then
		loopConnection:Disconnect()
		loopConnection = nil
	end
end

local function addTicker(fn)
	local ticker = { fn = fn, dead = false }
	table.insert(tickers, ticker)
	if not loopConnection then
		loopConnection = RunService.RenderStepped:Connect(CloudUI.Update)
	end
	return ticker
end

----------------------------------------------------------------------
-- Hover / press feedback
----------------------------------------------------------------------
-- Adds a UIScale to `button` and tweens it on hover and press. opts.OnState(hovering, pressing) is
-- called on every change so the caller can repaint colours.
local function attachFx(button, opts)
	opts = opts or {}
	local hoverScale = opts.Hover or HOVER_SCALE
	local pressScale = opts.Press or PRESS_SCALE
	local scale = Util.Create("UIScale", { Name = "FxScale", Scale = 1, Parent = button })
	local fx = { Hovering = false, Pressing = false }
	local running = nil

	local function refresh(seconds)
		local target = 1
		if fx.Pressing then
			target = pressScale
		elseif fx.Hovering then
			target = hoverScale
		end
		if running then
			running:Cancel()
		end
		running = Util.Tween(scale, seconds, { Scale = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if opts.OnState then
			opts.OnState(fx.Hovering, fx.Pressing)
		end
	end

	button.MouseEnter:Connect(function()
		fx.Hovering = true
		refresh(0.12)
	end)
	button.MouseLeave:Connect(function()
		fx.Hovering = false
		fx.Pressing = false
		refresh(0.14)
	end)
	button.MouseButton1Down:Connect(function()
		fx.Pressing = true
		refresh(0.07)
	end)
	button.MouseButton1Up:Connect(function()
		fx.Pressing = false
		refresh(0.12)
	end)
	-- a finger that lifts never produces MouseLeave
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			fx.Hovering = false
			fx.Pressing = false
			refresh(0.12)
		end
	end)
	fx.Scale = scale
	return fx
end

----------------------------------------------------------------------
-- kit B blocks (U8: the HUD, the Pets window and the Index on the Signboard kit)
----------------------------------------------------------------------
-- The pitch's block (kit_pitch_mockups.html .bk, kit B): a flat face, a darker lip along its bottom, a wood edge; square,
-- no glow, no gloss gradient. One colour by role (finding 15): green is THE main action of a screen, gold is selected,
-- red is danger or close, everything else stone.
local SIGN = Theme.Sign
CloudUI.SignLooks = {
	Stone = { Face = SIGN.Tile, Lip = SIGN.StoneLip, Edge = SIGN.Wood, Text = SIGN.Text },
	Primary = { Face = SIGN.Grass, Lip = SIGN.GrassLip, Edge = SIGN.Wood, Text = SIGN.OnGrass },
	Selected = { Face = SIGN.Gold, Lip = SIGN.GoldLip, Edge = SIGN.Wood, Text = SIGN.Text },
	Danger = { Face = SIGN.Red, Lip = SIGN.RedLip, Edge = SIGN.Wood, Text = SIGN.Text }, -- brown reads 4.8:1 on the red, white 3:1
	Off = { Face = SIGN.Well, Lip = SIGN.Well, Edge = SIGN.WellEdge, Text = SIGN.TextMuted },
	Gift = { Face = SIGN.Roof, Lip = SIGN.RoofLip, Edge = SIGN.Wood, Text = SIGN.Text },
	Navy = { Face = SIGN.Navy, Lip = SIGN.NavyLip, Edge = SIGN.GoldLip, Text = SIGN.Gold },
	-- (U9-8 look) a small secondary action in a row (the Sky Obby picker's PICK): the sky face on its SkyLip lip
	Sky = { Face = SIGN.Sky, Lip = SIGN.SkyLip, Edge = SIGN.Wood, Text = SIGN.Text },
}
-- a CloudUI.Button style -> its kit B role
CloudUI.SignRole = { Green = "Primary", Gold = "Selected", Red = "Danger", Pink = "Danger", Blue = "Stone", Gray = "Stone",
	Sky = "Sky" } -- (kit-b U9-8 A) a Sign skin only: the small secondary action (the party panel's Change, the picker's PICK look)
-- (LOOK-ui, kitb-look1: two plank weights in one kit) one token with SignKit's planks (the Settings window, the main
-- menu, the loading board) and the pitch's .bk: a 5 px edge and an 8 px lip at 1080p, 4 + 6 at the 0.8 Fit (was 3 / 5:
-- 2 + 4, half as heavy beside them). Chips, key caps and bar blocks under 30 px keep SignKit's BlockEdge / BlockLip
CloudUI.SignMetrics = { Edge = SignKit.Sizes.Edge, Lip = SignKit.Sizes.Lip, PressLip = SignKit.Sizes.PressLip }
local SM = CloudUI.SignMetrics

local function sameColor(a, b)
	return typeof(a) == "Color3" and typeof(b) == "Color3" and math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end

local function signLook(look)
	if type(look) == "table" then
		return look
	end
	return CloudUI.SignLooks[look or "Stone"] or CloudUI.SignLooks.Stone
end

-- (U9-4 look review: the floating lip) a UIPadding on the block also pads its Lip child, so a text block's lip drew its
-- padding above the bottom (Claim! showed 5 px of face under it) and inset by the side padding (an underline under the
-- word). The lip reaches back out by the padding: its bottom is the block's bottom, its width the block's width, whatever
-- the padding is now; a pad changed later (a press, a caller's side padding) moves it again (one watcher per pad)
local function syncLip(obj)
	local lip = obj:FindFirstChild("Lip")
	if not lip then
		return
	end
	local pad = obj:FindFirstChildOfClass("UIPadding")
	local left = pad and pad.PaddingLeft.Offset or 0
	local right = pad and pad.PaddingRight.Offset or 0
	local bottom = pad and pad.PaddingBottom.Offset or 0
	lip.Position = UDim2.new(0, -left, 1, bottom)
	lip.Size = UDim2.new(1, left + right, 0, lip.Size.Y.Offset)
	if pad and not pad:GetAttribute("LipWatch") then
		pad:SetAttribute("LipWatch", true)
		pad.Changed:Connect(function()
			syncLip(obj)
		end)
	end
end
CloudUI.SyncLip = syncLip

-- (kit-b gate U9 r4: a phone was told "press E") the words for using a world prompt on this device: "tap the button" on a
-- touch-only screen, "press X" with a gamepad and no keyboard (the prompts' gamepad key), else "press E". cap = true
-- starts them with a capital
function CloudUI.PromptWords(cap)
	local words = "press E"
	pcall(function()
		local uis = game:GetService("UserInputService")
		if uis.TouchEnabled and not uis.KeyboardEnabled then
			words = "tap the button"
		elseif uis.GamepadEnabled and not uis.KeyboardEnabled then
			words = "press X"
		end
	end)
	if cap then
		return words:sub(1, 1):upper() .. words:sub(2)
	end
	return words
end

-- Paints `obj` (a Frame / TextLabel / TextButton) as a kit B block, in place: its face, a wood edge (UIStroke "SignEdge",
-- mitred corners) and the lip (Frame "Lip" along its bottom); any UICorner, UIGradient and border UIStroke it had go. A
-- text object gets the look's ink and a bottom padding over the lip. Calling it again repaints (a state change).
-- opts: Face, Lip / LipColor, Edge, Text (colour overrides), EdgePx (default 3), LipPx (default 5; 0 = none), Pad (false:
-- no padding). Returns edge, lip. (U9-8 look) The edge and the lip are whole screen px under the scale above the block
-- (SignKit.Whole: round(px x scale); a 2 px edge drew 1.6 px and a 4 px lip 3.2 px under a phone's 0.8)
function CloudUI.SignBlock(obj, look, opts)
	opts = opts or {}
	local name = type(look) == "string" and look or nil
	look = signLook(look)
	for _, c in ipairs(obj:GetChildren()) do
		if c:IsA("UICorner") or c:IsA("UIGradient") or (c:IsA("UIStroke") and c.Name ~= "SignEdge" and c.ApplyStrokeMode == Enum.ApplyStrokeMode.Border) then
			c:Destroy()
		end
	end
	obj.BackgroundTransparency = 0
	obj.BackgroundColor3 = opts.Face or look.Face
	obj.BorderSizePixel = 0 -- (LOOK-ui) a label's default 1 px blue-black border leaked round the wood edge (the boost chips)
	local edge = obj:FindFirstChild("SignEdge")
	if not edge then
		edge = stroke(obj, look.Edge, opts.EdgePx or SM.Edge, 0)
		edge.Name = "SignEdge"
		edge.LineJoinMode = Enum.LineJoinMode.Miter
	end
	edge.Color = opts.Edge or look.Edge
	-- (LOOK-ui) the edge and the lip a whole number of screen px under the window's scale (PixelIcon.Px): a 3 px edge at a
	-- 0.8 Fit drew 2.4 px, its lip 4 px of a 5 px design
	-- (merge) one design px for both snaps below (WholeStroke and SignKit.Whole): a repaint without EdgePx keeps the last
	local edgePx = tonumber(opts.EdgePx) or edge:GetAttribute("DesignPx") or SM.Edge
	PixelIcon.WholeStroke(edge, edgePx)
	local lipPx = tonumber(opts.LipPx) or SM.Lip
	local lip = obj:FindFirstChild("Lip")
	if not lip then
		lip = frame("Lip", {
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			BackgroundTransparency = 0,
			ZIndex = obj.ZIndex,
		}, obj)
	end
	lip.BackgroundColor3 = opts.LipColor or opts.Lip or look.Lip
	lip.Visible = lipPx > 0
	if obj:IsA("TextButton") or obj:IsA("TextLabel") then
		obj.TextColor3 = opts.Text or look.Text
		-- (LOOK-ui) not under a close block's pixel x: it sits on the block's centre (NeonKit.CloseMark), a repaint (hover,
		-- the ink Outline) must not pad it up
		if opts.Pad ~= false and lipPx > 0 and not obj:FindFirstChild("CloseMark") then
			local pad = obj:FindFirstChild("LipPad")
			if not pad then
				pad = Util.Create("UIPadding", { Name = "LipPad", Parent = obj })
			end
			pad.PaddingBottom = UDim.new(0, lipPx)
		end
	end
	-- (U9-4 look review; U9-7 look) a UIPadding lays out the block's children too: syncLip reaches the lip back out by the
	-- block's padding (the LipPad, or a caller's own), so it stays flush on the wood edge, now and whenever the pad changes
	lip.Size = UDim2.new(1, 0, 0, lipPx)
	syncLip(obj)
	if name then
		obj:SetAttribute("SignLook", name)
	end
	-- (U9-8 look) the edge and the lip on whole screen px, now and whenever the block moves or its window's scale changes
	SignKit.Whole(obj, function(sc)
		edge.Thickness = SignKit.Px(edgePx, sc)
		lip.Size = UDim2.new(1, lip.Size.X.Offset, 0, SignKit.Px(lipPx, sc)) -- the width syncLip gave it
	end)
	-- (Pitch 2 F0, finish pass A) the finish: a raised block has the light on its wood edge (on the edge stroke, outside
	-- the box), its face's lit top band and the card shadow (none under 30 px: a chip); an Off block (the Well face) is a
	-- sunk well. opts.Finish = false: none. opts.Finish = "Lean" (a small world tag over a head: its instance budget): the
	-- lit top band only, one part (no bevel strips, no shadow, no well). Repainting updates the same parts
	if opts.Finish == "Lean" then
		SignKit.HideFinish(obj, "FinishBevel")
		SignKit.HideFinish(obj, "FinishShadow")
		SignKit.HideFinish(obj, "FinishSunk")
		SignKit.Shine(obj, { Color = opts.Face or look.Face })
	elseif opts.Finish ~= false then
		local faceColor = opts.Face or look.Face
		local edgeColor = opts.Edge or look.Edge
		local well = name == "Off" or sameColor(faceColor, SIGN.Well) or sameColor(faceColor, SIGN.PetWell)
		SignKit.FinishBlock(obj, { Out = edgePx, Wood = sameColor(edgeColor, SIGN.Wood), Well = well, FaceColor = faceColor, EdgeColor = edgeColor })
	end
	return edge, lip
end

-- (kit-b U9-2b look review) the kit's one switch, the Shop's Fast hatch and the egg stage's: a square slot (the sunk Well in
-- a mitred WellEdge, Edge px) with a square stone knob (Tile in a mitred wood edge) that slides from side to side; on, the
-- slot turns gold in its GoldLip edge (gold = selected). The knob sits Inset px inside the slot, as tall as the slot less
-- 2 x Inset, so its own edge never touches the slot's.
--   CloudUI.SignSwitch(parent, opts) -> the "Switch" Frame (child "Knob"); opts = { Name, ZIndex }. Size it, then
--   CloudUI.SetSignSwitch(sw, on)      paints it and places the knob from its Size (call it again after a resize); attribute On
CloudUI.SwitchLook = { Slot = SIGN.Well, SlotEdge = SIGN.WellEdge, Knob = SIGN.Tile, KnobEdge = SIGN.Wood, On = SIGN.Gold, OnEdge = SIGN.GoldLip, Edge = 2, Inset = 3 }

function CloudUI.SignSwitch(parent, opts)
	opts = opts or {}
	local L = CloudUI.SwitchLook
	local z = opts.ZIndex or 1
	local sw = frame(opts.Name or "Switch", { BackgroundTransparency = 0, BackgroundColor3 = L.Slot, ZIndex = z }, parent)
	local edge = stroke(sw, L.SlotEdge, L.Edge, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	local knob = frame("Knob", { BackgroundTransparency = 0, BackgroundColor3 = L.Knob, ZIndex = z + 1 }, sw)
	local kedge = stroke(knob, L.KnobEdge, L.Edge, 0)
	kedge.Name = "SignEdge"
	kedge.LineJoinMode = Enum.LineJoinMode.Miter
	if opts.Finish == false then
		sw:SetAttribute("NoFinish", true) -- (Pitch 2 F0) no sunk-well finish (the hatch stage's instance budget)
	end
	CloudUI.SetSignSwitch(sw, false)
	return sw
end

function CloudUI.SetSignSwitch(sw, on)
	local L = CloudUI.SwitchLook
	local knob = sw and sw:FindFirstChild("Knob")
	if not knob then
		return
	end
	on = on == true
	local w, h = sw.Size.X.Offset, sw.Size.Y.Offset
	local k = math.max(2, h - 2 * L.Inset)
	sw.BackgroundColor3 = on and L.On or L.Slot
	local edge = sw:FindFirstChild("SignEdge")
	if edge then
		edge.Color = on and L.OnEdge or L.SlotEdge
	end
	knob.AnchorPoint = Vector2.new(0, 0)
	knob.Position = UDim2.fromOffset(on and math.max(L.Inset, w - k - L.Inset) or L.Inset, L.Inset)
	knob.Size = UDim2.fromOffset(k, k)
	sw:SetAttribute("On", on)
	-- (Pitch 2 F0) the slot is a sunk well (its shade in the slot's colour of the moment)
	if sw:GetAttribute("NoFinish") ~= true then
		SignKit.Sunk(sw, { Face = sw.BackgroundColor3, Edge = edge and edge.Color or L.SlotEdge })
	end
end

-- (LOOK-ui, kitb-look1: no gradient in a pixel screen) "more this way" at a sideways row's right edge: a small stone kit
-- block with the pixel arrow, right-centred in `holder` (a transparent frame the caller shows and hides; the row's old
-- edge fade). Returns the block
function CloudUI.MoreMark(holder, zIndex)
	local z = tonumber(zIndex) or holder.ZIndex
	local block = frame("More", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -4, 0.5, 0),
		Size = UDim2.fromOffset(30, 34),
		ZIndex = z,
	}, holder)
	CloudUI.SignBlock(block, "Stone", { Face = SIGN.Tile, EdgePx = 2, LipPx = 4, Pad = false })
	local icon = PixelIcon.New(block, "arrow", 18, SIGN.Text)
	if icon then
		icon.Position = UDim2.fromOffset(6, 6) -- (the 30 x 30 face over the 4 px lip; the edge is drawn outside)
		icon.ZIndex = z + 1
		for _, cell in ipairs(icon:GetChildren()) do
			if cell:IsA("GuiObject") then
				cell.ZIndex = z + 1
			end
		end
	end
	return block
end

-- A small square chip in an element's colour holding its PixelIcon (Config.Elements.Info[element].Icon) in the ink that
-- reads on it, with a wood edge (the pitch's .el). opts: Label (the element's name after the icon, on its own stone tag
-- inside the chip's edge: brown on stone reads at any size, where no ink reads 4.5:1 on the mid-tone element colours),
-- TextSize, Role (the label's Theme role, default Tag; the Index's narrow tiles use Heading), Name, ZIndex, LayoutOrder,
-- Icon (false: no icon square, the element's colour a 4 px stripe before the name's tag: the Pet Index tiles, where the
-- square and "Celestial" at 18 px do not fit one 114 px card).
-- Returns the chip (attribute Element), or nil for an unknown element.
local CHIP_STRIPE = 4
function CloudUI.ElementChip(parent, element, px, opts)
	opts = opts or {}
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	if not info then
		return nil
	end
	local stripe = opts.Icon == false and opts.Label ~= nil
	px = tonumber(px) or 26
	local ink = Theme.TextOn(info.Color)
	local chip = Instance.new("Frame")
	chip.Size = UDim2.fromOffset(px, px)
	local label = nil
	if opts.Label then
		-- (LOOK-ui, kitb-look1: "Mythic", "Shadow" filled their chips edge to edge) the name sizes its own stone tag
		-- (AutomaticSize) with 4 px after the icon square and 8 px before the chip's edge
		chip.AutomaticSize = Enum.AutomaticSize.X
		label = Theme.Label(tostring(opts.Label), opts.Role or "Tag", { Size = opts.TextSize or 16, Color = SIGN.Text })
		label.Name = "Label"
		label.AutomaticSize = Enum.AutomaticSize.X
		label.Position = UDim2.fromOffset(px, 0)
		label.Size = UDim2.fromOffset(0, px)
		label.BackgroundTransparency = 0
		label.BackgroundColor3 = SIGN.Tile
		label.BorderSizePixel = 0
		label.ZIndex = opts.ZIndex or 1
		padding(label, 4, 0, 8, 0)
		label.Parent = chip
	end
	chip.Name = opts.Name or "Element"
	chip.BorderSizePixel = 0
	chip.BackgroundTransparency = 0
	chip.BackgroundColor3 = info.Color
	chip.ZIndex = opts.ZIndex or 1
	chip.LayoutOrder = opts.LayoutOrder or 0
	local edge = stroke(chip, SIGN.Wood, 2, 0)
	edge.Name = "SignEdge"
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	local iconPx = math.max(9, 9 * math.floor((px - 6) / 9))
	-- (LOOK-ui, kitb-look1: the host from the snapped icon) the square is the icon's whole-px cells and 2 screen px round
	-- them (PixelIcon.Chip: 22 px at 2 px cells, at every scale), the name's tag beside it as tall
	local square = Instance.new("Frame")
	square.Name = "Square"
	square.BackgroundTransparency = 1
	square.BorderSizePixel = 0
	square.Parent = chip
	local icon = not stripe and info.Icon and PixelIcon.Chip(square, info.Icon, iconPx, ink)
	if icon then
		icon.ZIndex = chip.ZIndex
		for _, f in ipairs(icon:GetChildren()) do
			f.ZIndex = chip.ZIndex
		end
	end
	PixelIcon.Whole(chip, function(s)
		local side = PixelIcon.BoxPx(iconPx, 2, s)
		-- (kit-b, Icon = false) the stripe on whole screen px, as tall as an icon chip
		local lead = stripe and math.max(2, math.floor(CHIP_STRIPE * s + 0.5)) / s or side
		chip.Size = UDim2.fromOffset(lead, side)
		if label then
			label.Position = UDim2.fromOffset(lead, 0)
			-- (merge kitb-look1 x U9-7) the width a caller fitted (the Arena's fitWidth: its text and 4 px) kept; the
			-- AutomaticSize still grows the tag past it
			label.Size = UDim2.fromOffset(label.Size.X.Offset, side)
		end
	end)
	chip:SetAttribute("Element", element)
	chip.Parent = parent
	return chip
end

----------------------------------------------------------------------
-- Screen gui
----------------------------------------------------------------------
function CloudUI.NewScreenGui(name, displayOrder)
	local player = Players.LocalPlayer
	local playerGui = player and player:WaitForChild("PlayerGui")
	local old = playerGui and playerGui:FindFirstChild(name)
	if old and old:IsA("ScreenGui") then
		old:Destroy()
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = displayOrder or 1
	gui.Parent = playerGui
	return gui
end

----------------------------------------------------------------------
-- Rarity
----------------------------------------------------------------------
function CloudUI.RarityColor(rarityId)
	local wanted = tostring(rarityId or ""):lower()
	for _, rarity in ipairs(Config.Rarities) do
		if rarity.Id:lower() == wanted then
			return rarity.Color
		end
	end
	return Config.Rarities[1].Color
end

----------------------------------------------------------------------
-- Button
----------------------------------------------------------------------
-- props: Text, Style ("Green"|"Pink"|"Red"|"Blue"|"Gold"|"Gray"), Size (default 160x50), Position,
--        AnchorPoint, Callback (called as Callback(button)), Parent, TextSize (default 22), Name,
--        LayoutOrder, ZIndex, Skin ("Sign": a kit B block, see signButton; a child Frame "PressFace" holding the
--        caller's own labels sinks onto the lip with the face, kit-b U9-7). (kit-b U9-8 A) the Sign skin also takes
--        Style "Sky" (CloudUI.SignRole.Sky: the sky face on its SkyLip lip)
local function signStyleName(style)
	return isStyleName(style) or CloudUI.SignRole[titleCase(style)] ~= nil
end

local function signButton(props)
	local state = { Style = signStyleName(props.Style) and titleCase(props.Style) or "Gray" }
	local button = Util.Create("TextButton", {
		Name = props.Name or ("Button_" .. tostring(props.Text or "")),
		AutoButtonColor = false,
		Active = true,
		BorderSizePixel = 0,
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Text = props.Text or "",
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Theme.Style(button, "Button", { Size = props.TextSize or CloudUI.Metrics.ButtonText })
	button:SetAttribute("Skin", "Sign")
	local fx
	local function isDisabled()
		return button:GetAttribute("Disabled") == true or button.Active == false
	end
	-- no scale bounce (kit B): hover lightens the face a touch, a press sinks it onto its lip (the lip thins, the text drops)
	-- (Pitch 2 F0) after one darker frame (Theme.Finish.PressDark for Theme.Finish.PressFrame s)
	local paint
	function paint()
		local disabled = isDisabled()
		local role = disabled and "Off" or (CloudUI.SignRole[state.Style] or "Stone")
		local look = CloudUI.SignLooks[role]
		local pressing = fx and fx.Pressing and not disabled
		if pressing and not state.Pressed then
			state.Dark = true
			task.delay(Theme.Finish.PressFrame, function()
				state.Dark = false
				if button.Parent then
					paint()
				end
			end)
		end
		state.Pressed = pressing
		local face = look.Face
		if fx and fx.Hovering and not disabled and not pressing then
			face = Theme.Lighten(face, 0.06)
		elseif pressing and state.Dark then
			face = Theme.Darken(face, Theme.Finish.PressDark)
		end
		-- attribute Outline = true: the ink edge of the pitch's selected card (a shown-but-not-active team, say)
		local edge = (not disabled and button:GetAttribute("Outline") == true) and SIGN.Text or nil
		-- (LOOK-ui) attribute Ink (a Color3): the label's ink instead of the look's (a stone Remove plank in red ink)
		local ink = button:GetAttribute("Ink")
		ink = (not disabled and typeof(ink) == "Color3") and ink or nil
		-- (merge kitb-look1 x U9-4) attributes EdgePx / LipPx: a small block's own weight where the kit's 5 / 8 cannot fit
		-- (a phone band's 36 px close block keeps U9-4's 3 / 5)
		local edgePx = tonumber(button:GetAttribute("EdgePx")) or SM.Edge
		local lipPx = tonumber(button:GetAttribute("LipPx")) or SM.Lip
		local pressLip = math.min(lipPx, SM.PressLip)
		CloudUI.SignBlock(button, role, { Face = face, Edge = edge, Text = ink, EdgePx = edgePx, LipPx = pressing and pressLip or lipPx, Finish = props.Finish })
		local pad = button:FindFirstChild("LipPad")
		if pad then
			pad.PaddingTop = UDim.new(0, pressing and (lipPx - pressLip) or 0)
		end
		-- (kit-b U9-7) a block that carries its own labels keeps them in a Frame "PressFace": it sinks with the face too
		local face = button:FindFirstChild("PressFace")
		if face then
			face.Position = UDim2.fromOffset(0, pressing and (lipPx - pressLip) or 0)
		end
	end
	fx = attachFx(button, { Hover = 1, Press = 1, OnState = paint })
	paint()
	button:GetAttributeChangedSignal("Disabled"):Connect(paint)
	button:GetAttributeChangedSignal("Outline"):Connect(paint)
	button:GetAttributeChangedSignal("Ink"):Connect(paint)
	button:GetAttributeChangedSignal("EdgePx"):Connect(paint)
	button:GetAttributeChangedSignal("LipPx"):Connect(paint)
	button:GetPropertyChangedSignal("Active"):Connect(paint)
	button:GetAttributeChangedSignal("Style"):Connect(function()
		local style = button:GetAttribute("Style")
		if type(style) == "string" and signStyleName(style) then
			state.Style = titleCase(style)
			paint()
		end
	end)
	if props.Callback then
		button.Activated:Connect(function()
			if isDisabled() then
				return
			end
			props.Callback(button)
		end)
	end
	button.Parent = props.Parent
	return button
end

function CloudUI.Button(props)
	props = props or {}
	if props.Skin == "Sign" then
		return signButton(props)
	end
	local state = { Style = isStyleName(props.Style) and titleCase(props.Style) or "Green" }

	local button = Util.Create("TextButton", {
		Name = props.Name or ("Button_" .. tostring(props.Text or "")),
		AutoButtonColor = false,
		Active = true, -- explicit: "Active == false" is how a button is switched off (see isDisabled)
		BorderSizePixel = 0,
		BackgroundColor3 = Theme.Darken(styleBase(state.Style), 0.4),
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Text = props.Text or "",
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	Theme.Style(button, "Button", { Size = props.TextSize or CloudUI.Metrics.ButtonText })
	corner(button, 12)
	-- v5: the neon border in the style's own colour (Border mode) + a soft outer glow ring; kit-b U6: the text sits on the
	-- button's face, so it has no outline any more (was a 2 px dark Contextual stroke)
	local outline = stroke(button, NAVY, 3, 0)
	local textOutline = nil
	gradient(button, FACE_SEQUENCE, 90)
	-- (no UIPadding: it would shift the glow ring; the text is centred and truncates at the edges)
	local glow = frame("Glow", {
		Position = UDim2.fromOffset(-4, -4),
		Size = UDim2.new(1, 8, 1, 8),
		ZIndex = button.ZIndex,
	}, button)
	corner(glow, 16)
	local glowStroke = stroke(glow, NAVY, 4, 0.68)
	addShine(button, 0.06, 12, 0.8, button.ZIndex)

	local fx
	local function isDisabled()
		return button:GetAttribute("Disabled") == true or button.Active == false
	end

	local function paint(seconds)
		local disabled = isDisabled()
		local neon = disabled and NEON.Grey or Theme.NeonColor(STYLE_NEON[state.Style] or "Green")
		local face = Theme.Darken(neon, disabled and 0.7 or 0.4)
		if not disabled and fx then
			if fx.Pressing then
				face = Theme.Darken(face, 0.15)
			elseif fx.Hovering then
				face = Theme.Lighten(face, 0.08)
			end
		end
		if seconds and seconds > 0 then
			Util.Tween(button, seconds, { BackgroundColor3 = face })
		else
			button.BackgroundColor3 = face
		end
		button.TextColor3 = disabled and Color3.fromRGB(176, 184, 206) or WHITE
		button.TextStrokeColor3 = INK
		if textOutline then
			textOutline.Color = INK
			textOutline.Transparency = disabled and 0.35 or 0
		end
		outline.Color = disabled and Theme.Darken(neon, 0.2) or neon
		glowStroke.Color = neon
		glow.Visible = not disabled
	end

	fx = attachFx(button, {
		OnState = function()
			paint(0.08)
		end,
	})
	paint(0)

	button:GetAttributeChangedSignal("Disabled"):Connect(function()
		paint(0.15)
	end)
	button:GetPropertyChangedSignal("Active"):Connect(function()
		paint(0.15)
	end)
	button:GetAttributeChangedSignal("Style"):Connect(function()
		local style = button:GetAttribute("Style")
		if type(style) == "string" and isStyleName(style) then
			state.Style = titleCase(style)
			paint(0.15)
		end
	end)

	if props.Callback then
		button.Activated:Connect(function()
			if isDisabled() then
				return
			end
			props.Callback(button)
		end)
	end

	button.Parent = props.Parent
	return button
end

function CloudUI.SetDisabled(button, disabled)
	if button then
		button:SetAttribute("Disabled", disabled and true or false)
	end
end

function CloudUI.SetStyle(button, style)
	if button then
		button:SetAttribute("Style", tostring(style))
	end
end

----------------------------------------------------------------------
-- Panel (window)
----------------------------------------------------------------------
-- props: Name, Size, Position, AnchorPoint, Title, Closable, OnClose, Parent, Accent (Color3: the neon border, glow,
--        title underline), Category (v5: a Theme.Category name, e.g. "Pets", when no Accent is given; default Blue),
--        Glow (v5; kit-b U8: default false, NeonKit's glow is opt-in), Clouds (ignored since v5: no cloud bumps), LayoutOrder,
--        TitleSize (default 34), Skin ("Signboard": kit B, see signPanel), Icon (a PixelIcon name for a Signboard header),
--        CloseBlock (Signboard; default true: NeonKit.CloseBlock, the windows' one close block; false: a card that lays
--        its close out itself, the U9-9 result card's close inside its banner)
-- (kit-b U8) Skin = "Signboard": the window as a kit B sign (the pitch's Pets stage): the flat pink awning (SignKit.Roof)
-- at a FIXED size (Metrics.SignRoofW) centred over the top, never stretched with the window (Gemini's sign rule: the
-- roof is one sprite, never 9-sliced); the navy header plank in its wood rim (SignKit.Header) with the title in gold
-- through Theme.StyleTitle and, with props.Icon, the window's PixelIcon on the gold square; the wood frame (Body) and the
-- stone inside it (Body.Stone, its lip along the bottom); a red close block with the drawn X. Panel.Content sits where a
-- plain panel's does, so the callers' layouts do not move. No glow, gradient, corner or drop shadow; SetAccent does
-- nothing on this skin (one look for every window).
CloudUI.Metrics.SignRoofW = 360
CloudUI.Metrics.SignFrame = 6
-- (U9-7 look) a Signboard window's page inset: the design px between Panel.Content's edges and the window's pages, left and
-- right (the dock family: the Arena and Ring pages, the Dungeon's rows, the dare list)
CloudUI.Metrics.SignPagePad = 14

local function signPanel(props)
	local hasTitle = type(props.Title) == "string" and props.Title ~= ""
	local topInset = CloudUI.ContentInset(hasTitle, props.Clouds)
	local edge = CloudUI.Metrics.SignFrame
	local root = frame(props.Name or "CloudPanel", {
		Size = props.Size or UDim2.fromOffset(520, 380),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})
	root:SetAttribute("Skin", "Signboard")
	local body = frame("Body", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Wood,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 2,
		Active = true, -- sinks clicks so the world behind the window is not clicked
	}, root)
	body:SetAttribute("SignKit", "Frame")
	local stone = frame("Stone", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		Position = UDim2.fromOffset(edge, edge),
		Size = UDim2.new(1, -2 * edge, 1, -2 * edge),
		ZIndex = 2,
	}, body)
	stone:SetAttribute("SignKit", "Body")
	local stoneLip = frame("Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, SignKit.Sizes.Lip),
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.StoneLip,
		ZIndex = 2,
	}, stone)
	-- (U9-8 look) the wood frame and the stone's lip whole screen px under the window's scale (the frame drew 4.8 px at 0.8;
	-- the header's rim follows the same rule, so the two still match)
	SignKit.Whole(stone, function(sc)
		local e = SignKit.Px(edge, sc)
		stone.Position = UDim2.fromOffset(e, e)
		stone.Size = UDim2.new(1, -2 * e, 1, -2 * e)
		stoneLip.Size = UDim2.new(1, 0, 0, SignKit.Px(SignKit.Sizes.Lip, sc))
	end)
	-- (Pitch 2 F0, finish pass A) the frame's light, the window's shadow, the stone sunk under the frame with its carved rim
	SignKit.FinishFrame(body, { Body = stone })
	local content = frame("Content", {
		Position = UDim2.new(0, PANEL_PAD, 0, topInset),
		Size = UDim2.new(1, -2 * PANEL_PAD, 1, -(topInset + PANEL_PAD)),
		ZIndex = 4,
	}, root)
	local titleBar, titleLabel = nil, nil
	if hasTitle then
		local head, plate = SignKit.Header(body, {
			Title = props.Title,
			TitleSize = props.TitleSize or TITLE_TEXT,
			Height = TITLE_TOP + TITLE_H,
			Rim = edge,
			IconSlot = props.Icon ~= nil,
			Ribbon = true, -- (render gate) the T1 band the header's width, out over the frame with its tails (title_T1)
			Reserve = props.Closable and (SIGN_CLOSE + 18) or 16,
			Name = "TitleBar",
			ZIndex = 3,
		})
		titleBar = head
		titleLabel = plate:FindFirstChild("Title")
		if titleLabel then
			titleLabel.TextTruncate = Enum.TextTruncate.AtEnd
			titleLabel.ZIndex = 6
		end
		local slot = plate:FindFirstChild("IconSlot")
		if slot and props.Icon then
			local icon = PixelIcon.New(slot, props.Icon, 27, SIGN.Text)
			if icon then
				-- (U9-7 look) by a whole-pixel offset: centred by AnchorPoint 0.5 the 27 px icon in the 42 px square sat on a
				-- half pixel on every Signboard window
				local inset = math.floor((slot.Size.X.Offset - 27) / 2)
				icon.Position = UDim2.fromOffset(inset, inset)
			end
		end
	end
	-- the awning: one fixed-size piece over the header's top rim (its lower part overlaps the rim, so it reads as the roof
	-- of the sign and stays inside a window that sits right under Roblox's top bar)
	local roof = SignKit.Roof(root, { Width = CloudUI.Metrics.SignRoofW, Y = SignKit.RoofSeat(), ZIndex = 3 }) -- (F0 review) seated on the frame

	local panel = { Root = root, Body = body, Content = content, TitleBar = titleBar, TitleLabel = titleLabel, Roof = roof, Card = nil, Skin = "Signboard" }
	function panel.Close()
		if props.OnClose then
			props.OnClose(panel)
		else
			root.Visible = false
		end
	end
	function panel.SetTitle(text)
		if titleLabel then
			titleLabel.Text = tostring(text)
		end
	end
	function panel.SetAccent() end
	function panel.Destroy()
		root:Destroy()
	end
	if props.Closable then
		local position = hasTitle and UDim2.new(1, -(PANEL_PAD + 4 + SIGN_CLOSE / 2), 0, TITLE_TOP + math.floor(TITLE_H / 2) - 2)
			or UDim2.new(1, -12 - SIGN_CLOSE / 2, 0, 8 + SIGN_CLOSE / 2)
		local closeButton = CloudUI.Button({
			Name = "Close",
			Text = "",
			Style = "Red",
			Skin = "Sign",
			Size = UDim2.fromOffset(SIGN_CLOSE, SIGN_CLOSE),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			ZIndex = 8,
			Callback = function()
				panel.Close()
			end,
			Parent = root,
		})
		NeonKit.CloseMark(closeButton, { Square = true, Ink = SIGN.RedLip, Color = SIGN.Text }) -- square bars in a Danger block's brown ink
		if props.CloseBlock ~= false then
			NeonKit.CloseBlock(closeButton) -- (LOOK-ui) the kit's one close block (>= 44 screen px, 3 px cells)
		end
		panel.CloseButton = closeButton
	end
	root.Parent = props.Parent
	return panel
end

function CloudUI.Panel(props)
	props = props or {}
	if props.Skin == "Signboard" then
		return signPanel(props)
	end
	local hasTitle = type(props.Title) == "string" and props.Title ~= ""
	local accent = props.Accent
	if typeof(accent) ~= "Color3" then
		accent = Theme.NeonColor(props.Category or "Blue")
	end
	local topInset = CloudUI.ContentInset(hasTitle, props.Clouds)

	local root = frame(props.Name or "CloudPanel", {
		Size = props.Size or UDim2.fromOffset(520, 380),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})

	-- soft drop shadow (keeps the dark card readable on a bright sky)
	local shadow = frame("Shadow", {
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.72,
		Position = UDim2.new(0, 0, 0, 6),
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 0,
	}, root)
	corner(shadow, PANEL_CORNER + 2)

	-- the Neon card: dark navy fill, a 3 px neon border, an outer glow ring, a sheen line under the top edge
	local card = NeonKit.Card({
		Name = "Body",
		Size = UDim2.new(1, 0, 1, 0),
		Color = accent,
		Corner = PANEL_CORNER,
		Stroke = OUTLINE_THICKNESS,
		Glow = props.Glow == true,
		Floor = false,
		ZIndex = 2,
		Active = true, -- sinks clicks so the world behind the window is not clicked
		Parent = root,
	})
	local body = card.Root

	-- the content well: a slightly darker inset (no decorative children: callers own its layout)
	local content = frame("Content", {
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.55,
		Position = UDim2.new(0, PANEL_PAD, 0, topInset),
		Size = UDim2.new(1, -2 * PANEL_PAD, 1, -(topInset + PANEL_PAD)),
		ZIndex = 4,
	}, root)
	corner(content, 12)
	stroke(content, WHITE, 1, 0.9)

	-- title: the Title role 34 (T0: FredokaOne, through Theme.StyleTitle), white, over a neon underline that fades out to the right
	local titleBar, titleLabel, underline = nil, nil, nil
	if hasTitle then
		titleBar = frame("TitleBar", {
			Position = UDim2.new(0, PANEL_PAD, 0, TITLE_TOP),
			Size = UDim2.new(1, -2 * PANEL_PAD, 0, TITLE_H),
			ZIndex = 5,
		}, root)
		local rightRoom = props.Closable and (CLOSE_SIZE + 18) or 16
		titleLabel = Theme.Label(props.Title, "Title", {
			Size = props.TitleSize or TITLE_TEXT,
			Props = {
				Name = "Title",
				Position = UDim2.new(0, 10, 0, 0),
				Size = UDim2.new(1, -(10 + rightRoom), 1, -4),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
				ZIndex = 6,
			},
		})
		titleLabel:SetAttribute("RibbonBand", "NoTails") -- (render gate) tails inside the navy card read as a glitchy block
		Theme.StyleTitle(titleLabel)
		titleLabel.Parent = titleBar
		underline = frame("Underline", {
			BackgroundColor3 = accent,
			BackgroundTransparency = 0,
			Position = UDim2.new(0, 8, 1, 1),
			Size = UDim2.new(1, -16, 0, 3),
			ZIndex = 6,
		}, titleBar)
		round(underline)
		Util.Create("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(0.6, 0.15),
				NumberSequenceKeypoint.new(1, 0.85),
			}),
			Parent = underline,
		})
	end

	local panel = {
		Root = root,
		Body = body,
		Content = content,
		TitleBar = titleBar,
		TitleLabel = titleLabel,
		Card = card,
	}

	function panel.Close()
		if props.OnClose then
			props.OnClose(panel)
		else
			root.Visible = false
		end
	end

	function panel.SetTitle(text)
		if titleLabel then
			titleLabel.Text = tostring(text)
		end
	end

	-- Re-colour the neon border, glow and title underline (e.g. by rarity or category).
	function panel.SetAccent(color)
		if type(color) == "string" then
			color = Theme.NeonColor(color)
		end
		if typeof(color) ~= "Color3" then
			return
		end
		card.SetColor(color)
		if underline then
			underline.BackgroundColor3 = color
		end
	end

	function panel.Destroy()
		root:Destroy()
	end

	if props.Closable then
		local closeSize = hasTitle and CLOSE_SIZE or (CLOSE_SIZE - 2)
		local position
		if hasTitle then
			-- at the right end of the title row
			position = UDim2.new(1, -(PANEL_PAD + 4 + CLOSE_SIZE / 2), 0, TITLE_TOP + math.floor(TITLE_H / 2) - 2)
		else
			-- on the top-right corner of the card
			position = UDim2.new(1, -12, 0, 8)
		end
		local closeButton = CloudUI.Button({
			Name = "Close",
			Text = "",
			Style = "Red",
			TextSize = 24,
			Size = UDim2.fromOffset(closeSize, closeSize),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = position,
			ZIndex = 8,
			Callback = function()
				panel.Close()
			end,
			Parent = root,
		})
		NeonKit.CloseMark(closeButton) -- slop audit 2026-11-12: the X is drawn (no "X" letter, no glyph); it follows a resize
		panel.CloseButton = closeButton
	end

	root.Parent = props.Parent
	return panel
end

----------------------------------------------------------------------
-- Bar
----------------------------------------------------------------------
-- (LOOK-ui, kitb-look1: the owner's look bar, every bar in the pixel block-bar language) the Sign skin is a block bar: a
-- SignKit.FitBlocks row filling the bar's box (props.Blocks blocks, default 10: wood edges, stone faces, the darker lip),
-- the first ones lit in the role colour with that role's lip token (Theme.SignLipOf: the XP's sky on Sign.SkyLip, the
-- Prestige's gold on Sign.GoldLip; was a continuous fill whose lip was the colour darkened), the label over it in the
-- ink. No well, no gradient, no tween (the blocks step)
local function signBar(props)
	local height = props.Height or 24
	local color = props.Color or SIGN.Sky
	local count = math.max(2, math.floor(tonumber(props.Blocks) or 10))
	local fraction = 1
	local root = frame(props.Name or "CloudBar", {
		Size = props.Size or UDim2.new(1, 0, 0, height),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})
	root:SetAttribute("BlockBar", true)
	local row = SignKit.FitBlocks(root, {
		Name = "Blocks",
		Count = count,
		Size = UDim2.fromScale(1, 1),
		Fill = color,
		FillLip = Theme.SignLipOf(color),
		Weight = "Bar",
	})
	local textSize = props.TextSize or Util.Clamp(math.floor(height * 0.66 + 0.5), 15, 26)
	-- props.LabelSide "Right" (the pitch's XP line: the number beside its bar, no glyph across a block's edge): the label
	-- after the blocks, the row giving up its width; default "Over", centred on the faces over the lips
	local right = props.LabelSide == "Right"
	local label = Theme.Label(props.Label or "", "Heading", {
		Size = textSize,
		Color = SIGN.Text,
		Props = {
			Name = "Text",
			AnchorPoint = right and Vector2.new(1, 0) or Vector2.new(0, 0),
			Position = right and UDim2.fromScale(1, 0) or UDim2.new(),
			Size = UDim2.new(1, 0, 1, -2),
			ZIndex = 3,
			TextXAlignment = right and Enum.TextXAlignment.Right or Enum.TextXAlignment.Center,
		},
	})
	label.Parent = root
	-- the label sizes itself to its drawn text (AutomaticSize; Theme.Measure runs short of FredokaOne), the row takes the
	-- rest less 10 px; a first guess from the measure until the label has laid out
	local fitCount -- (below: props.MinBlockW)
	local function rowFor(w)
		row.Size = UDim2.new(1, -(math.ceil(w) + 10), 1, 0)
		if fitCount then
			fitCount() -- (the row's room changed: its block count follows)
		end
	end
	local function fitLabel()
		if not right then
			return
		end
		local ok, m = pcall(Theme.Measure, label.Text, "Heading", label.TextSize)
		local w = math.ceil((ok and typeof(m) == "Vector2" and m.X > 0) and m.X * 1.15 + 2 or #label.Text * label.TextSize * 0.6)
		-- (LOOK-ui2: hugging its text, a lone "0" had no px to spare for its outline) the measure is the box's least width;
		-- AutomaticSize still widens it to the drawn text
		label.Size = UDim2.new(0, w + 2, 1, -2)
		rowFor(w + 2)
	end
	if right then
		label.AutomaticSize = Enum.AutomaticSize.X
		label.Size = UDim2.new(0, 0, 1, -2)
		label:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			local s = PixelIcon.RestScale(label)
			if s > 0 and label.AbsoluteSize.X > 0 then
				rowFor(label.AbsoluteSize.X / s)
			end
		end)
	end
	local bar = { Root = root, Fill = row, Row = row, Label = label }
	local function paint()
		SignKit.FillBlocks(row, math.floor(fraction * count + 1e-6))
	end
	-- (LOOK-ui2) props.MinBlockW (design px, optional): a narrow row shows fewer blocks, down to 5 (each standing for a
	-- bigger share), rather than slivers too narrow for their wood edge (FitBlocks draws those as edgeless pips)
	local most, minW = count, tonumber(props.MinBlockW)
	function fitCount()
		local s = PixelIcon.RestScale(row)
		local w = (s > 0) and row.AbsoluteSize.X / s or 0
		if not minW or w <= 0 then
			return
		end
		local gap = row:GetAttribute("Gap") or 2
		local n = math.max(math.min(5, most), math.min(most, math.floor((w + gap) / (minW + gap))))
		if n ~= count then
			count = n
			SignKit.SetBlockCount(row, count, color, Theme.SignLipOf(color))
			root:SetAttribute("Blocks", count)
			paint()
		end
	end
	if minW then
		row:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitCount)
	end
	bar.FitCount = fitCount -- (a caller that resized the bar's root calls it after its layout)
	function bar.SetFraction(value)
		fraction = Util.Clamp(tonumber(value) or 0, 0, 1)
		root:SetAttribute("Fraction", fraction)
		paint()
	end
	function bar.GetFraction()
		return fraction
	end
	function bar.SetText(text)
		label.Text = tostring(text or "")
		fitLabel()
	end
	function bar.SetColor(newColor)
		if typeof(newColor) ~= "Color3" then
			return
		end
		color = newColor
		SignKit.SetBlockCount(row, count, color, Theme.SignLipOf(color))
		paint()
	end
	label:GetPropertyChangedSignal("TextSize"):Connect(fitLabel)
	fitLabel()
	bar.SetFraction(1)
	root.Parent = props.Parent
	return bar
end

-- props: Size, Color, Label, Parent, Height, Position, AnchorPoint, Name, LayoutOrder, TextSize, Skin ("Sign": the block
--        bar above), Blocks (Sign: the block count)
function CloudUI.Bar(props)
	props = props or {}
	if props.Skin == "Sign" then
		return signBar(props)
	end
	local height = props.Height or 24
	local color = props.Color or Colors.Health
	local fraction = 1

	local root = frame(props.Name or "CloudBar", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		Size = props.Size or UDim2.new(1, 0, 0, height),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})
	-- v5: a dark ink track with a thin light rim (the fill carries the colour)
	round(root)
	local trackStroke = stroke(root, Theme.Lighten(PANEL_TOP, 0.12), 2.5, 0)
	gradient(root, ColorSequence.new(INK, PANEL_TOP), 90)

	local inner = frame("Inner", {
		Position = UDim2.new(0, 3, 0, 3),
		Size = UDim2.new(1, -6, 1, -6),
	}, root)

	local fill = frame("Fill", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		Size = UDim2.new(1, 0, 1, 0),
	}, inner)
	local function fillSequence(c)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.34)),
			ColorSequenceKeypoint.new(0.5, c),
			ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.16)),
		})
	end
	round(fill)
	local fillGradient = gradient(fill, fillSequence(color), 90)
	addShine(fill, 0.34, 6, 0.7)

	-- kit B (no outline on a surface): the label reads by the colour of what lies under it, and the fill moves under a
	-- centred label. So it is drawn twice, each copy clipped to one stretch of the bar: dark ink over the bright fill
	-- (Theme.TextOn of its gradient), white over the dark track. Both copies are named "Text"; bar.Label is the fill's.
	local textSize = props.TextSize or Util.Clamp(math.floor(height * 0.66 + 0.5), 15, 26)
	local copies = {}
	for _, spec in ipairs({ { "TextFill", Theme.TextOn(fillSequence(color)) }, { "TextTrack", WHITE } }) do
		local clip = frame(spec[1], {
			ClipsDescendants = true,
			Size = UDim2.new(1, 0, 1, 0),
			ZIndex = 3,
		}, inner)
		local copy = Theme.Label(props.Label or "", "Heading", {
			Size = textSize,
			Color = spec[2],
			Props = {
				Name = "Text",
				Size = UDim2.new(1, 0, 1, 0),
				ZIndex = 3,
				TextXAlignment = Enum.TextXAlignment.Center,
			},
		})
		copy.Parent = clip
		copies[#copies + 1] = { Clip = clip, Label = copy }
	end
	local label = copies[1].Label

	-- the copies' stretches follow the fill's width (its tween too): the fill's copy over [0, f], the track's over [f, 1];
	-- each label keeps the whole bar's box, so a glyph's two halves meet at the fill's edge
	local function placeText()
		local f = Util.Clamp(fill.Size.X.Scale, 0, 1)
		for i, c in ipairs(copies) do
			local a, b = 0, f
			if i == 2 then
				a, b = f, 1
			end
			local span = b - a
			c.Clip.Visible = span > 0.001
			if span > 0.001 then
				c.Clip.Position = UDim2.fromScale(a, 0)
				c.Clip.Size = UDim2.fromScale(span, 1)
				c.Label.Position = UDim2.fromScale(-a / span, 0)
				c.Label.Size = UDim2.fromScale(1 / span, 1)
			end
		end
	end
	fill:GetPropertyChangedSignal("Size"):Connect(placeText)
	placeText()

	local bar = { Root = root, Fill = fill, Label = label }
	local running = nil

	function bar.SetFraction(value, animate)
		fraction = Util.Clamp(tonumber(value) or 0, 0, 1)
		local size = UDim2.new(fraction, 0, 1, 0)
		if running then
			running:Cancel()
			running = nil
		end
		if animate then
			running = Util.Tween(fill, 0.25, { Size = size }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		else
			fill.Size = size
		end
	end

	function bar.GetFraction()
		return fraction
	end

	function bar.SetText(text)
		for _, c in ipairs(copies) do
			c.Label.Text = tostring(text or "")
		end
	end

	function bar.SetColor(newColor)
		if typeof(newColor) ~= "Color3" then
			return
		end
		color = newColor
		fillGradient.Color = fillSequence(color)
		label.TextColor3 = Theme.TextOn(fillSequence(color))
	end
	bar.TrackStroke = trackStroke

	root.Parent = props.Parent
	return bar
end

----------------------------------------------------------------------
-- Pill
----------------------------------------------------------------------
local function kindColor(kind)
	if typeof(kind) == "Color3" then
		return kind
	end
	if type(kind) == "string" then
		local found = KIND_COLORS[kind:lower()]
		if found then
			return found
		end
		return CloudUI.RarityColor(kind)
	end
	return KIND_COLORS.info or Color3.fromRGB(90, 158, 234)
end

-- kind: "info" | "good" | "bad" | "token" | a rarity id ("Epic") | a Color3
function CloudUI.Pill(text, kind, parent)
	local color = kindColor(kind)
	-- v5: a dark face tinted by the kind colour, a neon border in that colour, white text with a dark stroke
	local pill = Theme.Label(tostring(text or ""), "Heading", {
		Size = 17,
		Props = {
			Name = "Pill",
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Darken(color, 0.62),
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.fromOffset(0, 28),
			TextXAlignment = Enum.TextXAlignment.Center,
		},
	})
	round(pill)
	stroke(pill, Theme.Lighten(color, 0.08), 2, 0)
	gradient(pill, FACE_SEQUENCE, 90)
	padding(pill, 12, 0, 12, 0)
	Util.Create("UISizeConstraint", { MinSize = Vector2.new(34, 28), Parent = pill })
	pill.Parent = parent
	return pill
end

----------------------------------------------------------------------
-- Icon button (round, with a caption below)
----------------------------------------------------------------------
-- props: Glyph (short text), Label (caption), Color (Color3 or style name), Callback, Parent, Size
--        (whole widget, default 72x96; the circle's diameter is the widget width, and with a caption the
--        widget is made at least width + 24 px tall so the caption never overlaps its neighbours),
--        Badge (bool), Position, AnchorPoint, Name, LayoutOrder
function CloudUI.IconButton(props)
	props = props or {}
	local hasLabel = type(props.Label) == "string" and props.Label ~= ""
	local labelHeight = 22
	local color = props.Color
	if type(color) == "string" then
		color = styleBase(color)
	elseif typeof(color) ~= "Color3" then
		color = BUTTON_COLORS.Blue or Color3.fromRGB(90, 158, 234)
	end

	local widgetSize = props.Size or UDim2.fromOffset(72, hasLabel and 96 or 72)
	if hasLabel and widgetSize.X.Scale == 0 and widgetSize.Y.Scale == 0 then
		local minHeight = widgetSize.X.Offset + labelHeight + 2
		if widgetSize.Y.Offset < minHeight then
			widgetSize = UDim2.fromOffset(widgetSize.X.Offset, minHeight)
		end
	end

	local root = frame(props.Name or ("IconButton_" .. tostring(props.Label or props.Glyph or "")), {
		Size = widgetSize,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})

	local holder = frame("CircleHolder", {
		Size = UDim2.new(1, 0, 1, hasLabel and -labelHeight or 0),
	}, root)

	local button = Util.Create("TextButton", {
		Name = "Button",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, -8, 1, -8),
		Parent = holder,
	})
	Util.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = button })
	round(button)
	local outline = stroke(button, color, 3, 0)
	local faceGradient = gradient(button, ColorSequence.new(Theme.Lighten(color, 0.3), color), 90)

	-- v5: a dark disc tinted by the colour (light at the top), the neon ring around it
	local function faceSequence(c)
		return ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Darken(c, 0.25)),
			ColorSequenceKeypoint.new(0.55, Theme.Darken(c, 0.55)),
			ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.78)),
		})
	end
	local function applyColor(c)
		color = c
		faceGradient.Color = faceSequence(c)
	end
	applyColor(color)

	local shine = Util.Create("Frame", {
		Name = "Shine",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.76,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.1, 0),
		Size = UDim2.new(0.54, 0, 0.24, 0),
		Parent = button,
	})
	round(shine)

	local glyph = Theme.Label(tostring(props.Glyph or ""), "Title", {
		Scaled = true,
		Props = {
			Name = "Glyph",
			Position = UDim2.new(0.5, 0, 0.44, 0),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Size = UDim2.new(0.58, 0, 0.58, 0),
			ZIndex = 2,
		},
	})
	Util.Create("UITextSizeConstraint", { MaxTextSize = 60, MinTextSize = 10, Parent = glyph })
	glyph.Parent = button

	local caption = nil
	if hasLabel then
		caption = Theme.Label(props.Label, "Heading", {
			Size = 16,
			Props = {
				Name = "Caption",
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 1, 0),
				Size = UDim2.new(1.3, 0, 0, labelHeight),
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
		})
		caption.Parent = root
	end

	-- little red "!" dot
	local badge = frame("Badge", {
		BackgroundColor3 = BUTTON_COLORS.Red or Color3.fromRGB(228, 90, 92),
		BackgroundTransparency = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.86, 0, 0.14, 0),
		Size = UDim2.fromOffset(24, 24),
		ZIndex = 4,
		Visible = props.Badge == true,
	}, button)
	round(badge)
	stroke(badge, INK, 2.5, 0)
	local badgeText = Theme.Label("!", "Button", {
		Size = 17,
		Props = { Name = "Mark", Size = UDim2.new(1, 0, 1, 0), ZIndex = 5 },
	})
	badgeText.Parent = badge

	local function paint(hovering, pressing)
		local face = color
		if pressing then
			face = Theme.Darken(color, 0.08)
		elseif hovering then
			face = Theme.Lighten(color, 0.1)
		end
		faceGradient.Color = faceSequence(face)
		outline.Color = color
	end
	attachFx(button, {
		Hover = 1.07,
		Press = 0.93,
		OnState = paint,
	})

	if props.Callback then
		button.Activated:Connect(function()
			props.Callback(button)
		end)
	end

	local widget = { Root = root, Button = button, Glyph = glyph, Caption = caption }

	function widget.SetBadge(on)
		badge.Visible = on and true or false
	end

	function widget.SetGlyph(text)
		glyph.Text = tostring(text or "")
	end

	function widget.SetLabel(text)
		if caption then
			caption.Text = tostring(text or "")
		end
	end

	function widget.SetColor(newColor)
		if typeof(newColor) == "Color3" then
			applyColor(newColor)
			outline.Color = newColor
		end
	end

	root.Parent = props.Parent
	return widget
end

----------------------------------------------------------------------
-- Tooltip (one shared label, follows the mouse; long-press on touch)
----------------------------------------------------------------------
local tip = nil
local TIP_TEXT = 18 -- 1080p px; the tooltip gui has no UIScale, so the size is scaled when shown
local TIP_MAX_W = 300

local function ensureTip()
	if tip then
		return tip
	end
	local gui = CloudUI.NewScreenGui("CloudUITooltip", 60)
	gui.IgnoreGuiInset = true
	local label = Theme.Label("", "Body", {
		Size = Theme.ScaledSize(TIP_TEXT),
		Props = {
			Name = "Tip",
			Visible = false,
			BackgroundTransparency = 0.04,
			BackgroundColor3 = PANEL_BOTTOM,
			BorderSizePixel = 0,
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			ZIndex = 10,
		},
	})
	corner(label, 10)
	stroke(label, NEON.Blue, 2, 0.1)
	padding(label, 12, 8, 12, 8)
	local limit = Util.Create("UISizeConstraint", { MaxSize = Vector2.new(TIP_MAX_W, 480), Parent = label })
	label.Parent = gui
	tip = { Gui = gui, Label = label, Limit = limit, Owner = nil, Mode = "mouse", Ticker = nil }
	return tip
end

local function mouseLocation()
	local ok, pos = pcall(function()
		return UserInputService:GetMouseLocation()
	end)
	if ok and pos then
		return pos
	end
	return Vector2.new(0, 0)
end

local function hideTip(owner)
	if not tip or not tip.Owner then
		return
	end
	if owner and tip.Owner ~= owner then
		return
	end
	tip.Owner = nil
	tip.Label.Visible = false
	if tip.Ticker then
		tip.Ticker.dead = true
		tip.Ticker = nil
	end
end

local function placeTip()
	if not tip or not tip.Owner then
		return
	end
	local owner = tip.Owner
	if not owner.Parent or not isShown(owner) then
		hideTip(owner)
		return
	end
	local label = tip.Label
	local screen = tip.Gui.AbsoluteSize
	local size = label.AbsoluteSize
	local x, y
	if tip.Mode == "mouse" then
		local m = mouseLocation()
		x = m.X + 16
		y = m.Y + 22
		if screen.Y > 0 and y + size.Y > screen.Y - 6 then
			y = m.Y - size.Y - 14
		end
	else
		local pos = owner.AbsolutePosition
		local osize = owner.AbsoluteSize
		x = pos.X + osize.X * 0.5 - size.X * 0.5
		y = pos.Y - size.Y - 8
		if y < 6 then
			y = pos.Y + osize.Y + 8
		end
	end
	if screen.X > 0 then
		x = Util.Clamp(x, 6, math.max(6, screen.X - size.X - 6))
	end
	label.Position = UDim2.fromOffset(math.floor(x), math.floor(y))
end

local function showTip(owner, text, mode)
	local t = ensureTip()
	hideTip()
	t.Owner = owner
	t.Mode = mode or "mouse"
	t.Label.TextSize = Theme.ScaledSize(TIP_TEXT)
	t.Limit.MaxSize = Vector2.new(math.floor(TIP_MAX_W * Theme.ScreenFactor()), 480)
	t.Label.Text = text
	t.Label.Visible = true
	placeTip()
	t.Ticker = addTicker(placeTip)
end

-- textFn: function() -> string|nil (or a plain string). Returns a function that removes the tooltip.
function CloudUI.Tooltip(guiObject, textFn)
	if not guiObject then
		return function() end
	end
	local token = 0
	local hovering = false
	local pressing = false
	local connections = {}

	local function resolve()
		local text = textFn
		if type(textFn) == "function" then
			local ok, value = pcall(textFn)
			text = ok and value or nil
		end
		if type(text) == "string" and text ~= "" then
			return text
		end
		return nil
	end

	table.insert(
		connections,
		guiObject.MouseEnter:Connect(function()
			hovering = true
			token = token + 1
			local mine = token
			task.delay(TOOLTIP_DELAY, function()
				if hovering and token == mine then
					local text = resolve()
					if text then
						showTip(guiObject, text, "mouse")
					end
				end
			end)
		end)
	)
	table.insert(
		connections,
		guiObject.MouseLeave:Connect(function()
			hovering = false
			token = token + 1
			hideTip(guiObject)
		end)
	)
	table.insert(
		connections,
		guiObject.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				pressing = true
				token = token + 1
				local mine = token
				task.delay(LONG_PRESS, function()
					if pressing and token == mine then
						local text = resolve()
						if text then
							showTip(guiObject, text, "object")
							task.delay(2.4, function()
								hideTip(guiObject)
							end)
						end
					end
				end)
			end
		end)
	)
	table.insert(
		connections,
		guiObject.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				pressing = false
				token = token + 1
			end
		end)
	)
	if guiObject:IsA("TextButton") or guiObject:IsA("ImageButton") then
		table.insert(
			connections,
			guiObject.MouseButton1Down:Connect(function()
				token = token + 1
				hideTip(guiObject)
			end)
		)
	end

	return function()
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		connections = {}
		hideTip(guiObject)
	end
end

----------------------------------------------------------------------
-- Pet viewport
----------------------------------------------------------------------
local PetBuilderModule = nil
local PetCatalogModule = nil
local petBuilderTried = false
local petCatalogTried = false
local viewportCounter = 0

local function getPetBuilder()
	if not petBuilderTried then
		petBuilderTried = true
		local ok, result = pcall(function()
			return require(Shared:WaitForChild("PetBuilder", 5))
		end)
		if ok and type(result) == "table" then
			PetBuilderModule = result
		else
			warn("[CloudUI] PetBuilder is unavailable: " .. tostring(result))
		end
	end
	return PetBuilderModule
end

local function getPetCatalog()
	if not petCatalogTried then
		petCatalogTried = true
		local ok, result = pcall(function()
			return require(Shared:WaitForChild("PetCatalog", 5))
		end)
		if ok and type(result) == "table" then
			PetCatalogModule = result
		end
	end
	return PetCatalogModule
end

-- A ViewportFrame showing a PetBuilder model that spins slowly and flaps. All viewports share the one
-- CloudUI.Update loop; hidden viewports skip work and destroyed ones unregister themselves.
-- size: UDim2 | Vector2 | number (square pixels) | nil (fill the parent)
-- opts: Position, AnchorPoint, ZIndex, Animate (default true), Spin ("spin"|"sway"|"none", default "spin"),
--       Flap (speed multiplier), Excited (0..1), Detail ("High" default | "Low", passed to PetBuilder.Build),
--       Evolved (Phase 4: the stored evolution stage 1 | 2 (or true = 1), passed to PetBuilder.Build as opts.Evolved;
--       0 / nil / false = the normal form; the def itself is never changed)
function CloudUI.PetViewport(parent, petDef, size, opts)
	opts = opts or {}
	viewportCounter = viewportCounter + 1
	local phase = (viewportCounter * 0.83) % 6.28

	if type(petDef) == "string" then
		local catalog = getPetCatalog()
		petDef = catalog and catalog.Get and catalog.Get(petDef) or nil
	end

	local viewport = Util.Create("ViewportFrame", {
		Name = "PetViewport",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = toUDim2(size, UDim2.new(1, 0, 1, 0)),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.new(0, 0),
		ZIndex = opts.ZIndex or 1,
		Ambient = Color3.fromRGB(176, 182, 206),
		LightColor = Color3.fromRGB(255, 246, 232),
		LightDirection = Vector3.new(-0.4, -0.8, 1), -- shines towards +Z: onto a model's -Z "front" (see side)
	})
	local camera = Util.Create("Camera", { FieldOfView = FOV, Parent = viewport })
	viewport.CurrentCamera = camera

	local animOpts = { Flap = opts.Flap or 1, Excited = opts.Excited or 0 }
	local animated = opts.Animate ~= false
	local spinMode = opts.Spin or "spin"
	local angle = 0.55
	local dead = false
	local model = nil
	local builder = nil
	local buildOpts = nil -- (Phase 6: kept for the mesh rebuild below)
	local meshVer = nil

	local center = Vector3.new(0, 1, 0)
	local halfH, halfW = 1.5, 1.8
	local lastAspect = 1
	local side = -1 -- which side of the model the camera sits on: -1 = the -Z side (Roblox models face -Z)

	if type(petDef) == "table" then
		builder = getPetBuilder()
		if builder and type(builder.Build) == "function" then
			buildOpts = { Scale = 1, Viewport = true } -- Phase 6: no PetFx particles inside a ViewportFrame
			if opts.Detail == "Low" or opts.Detail == "High" then
				buildOpts.Detail = opts.Detail
			end
			local evolved = opts.Evolved
			if evolved == true then
				evolved = 1
			end
			evolved = tonumber(evolved)
			if evolved and evolved >= 1 then
				buildOpts.Evolved = math.min(2, math.floor(evolved))
			end
			local ok, built = pcall(builder.Build, petDef, buildOpts)
			if ok and typeof(built) == "Instance" then
				model = built
			else
				warn("[CloudUI] PetBuilder.Build failed: " .. tostring(built))
			end
		end
	end

	local function fit()
		local abs = viewport.AbsoluteSize
		local aspect = 1
		if abs.X > 0 and abs.Y > 0 then
			aspect = abs.X / abs.Y
		end
		lastAspect = aspect
		local t = math.tan(math.rad(FOV) / 2)
		local dist = math.max(halfH * 1.2 / t, halfW * 1.08 / (t * aspect))
		camera.CFrame = CFrame.lookAt(center + Vector3.new(0, halfH * 0.12, dist * side), center)
	end

	-- Pets face -Z like every Roblox model (CFrame.lookAt convention). If a model's eyes turn out to sit
	-- on its +Z side instead, put the camera (and the light) there so the viewport shows the face.
	-- Expects the model to be posed at the origin with an identity pivot.
	local function detectSide(m, c)
		local sum, count = 0, 0
		for _, d in ipairs(m:GetDescendants()) do
			if d:IsA("BasePart") and d.Name:lower():find("eye", 1, true) then
				sum = sum + (d.Position.Z - c.Z)
				count = count + 1
			end
		end
		if count > 0 and sum / count > 0.05 then
			return 1
		end
		return -1
	end

	local function animate(t)
		if builder and type(builder.Animate) == "function" then
			pcall(builder.Animate, model, t, animOpts)
		end
	end

	local function pose(t, dt)
		if not model or not model.Parent then
			return
		end
		if spinMode == "spin" then
			angle = angle + dt * 0.8
		elseif spinMode == "sway" then
			angle = 0.5 + math.sin(t * 1.1 + phase) * 0.55
		end
		local bob = math.sin(t * 2.2 + phase) * halfH * 0.035
		model:PivotTo(CFrame.new(center + Vector3.new(0, bob, 0)) * CFrame.Angles(0, angle, 0) * CFrame.new(-center))
		animate(t + phase)
	end

	if model then
		model.Parent = viewport
		pcall(function()
			model:PivotTo(CFrame.new())
		end)
		animate(0.35)
		local ok, cf, bbox = pcall(function()
			return model:GetBoundingBox()
		end)
		if ok and cf and bbox then
			center = cf.Position
			halfH = math.max(0.5, bbox.Y * 0.5)
			halfW = math.max(0.5, math.max(bbox.X, bbox.Z) * 0.5)
			local okSide, found = pcall(detectSide, model, center)
			if okSide and found then
				side = found
				viewport.LightDirection = Vector3.new(-0.4, -0.8, -side)
			end
		end
		pose(0.35, 0)
	else
		-- no model available: a friendly placeholder instead of an empty frame
		local name = type(petDef) == "table" and petDef.Name or "?"
		local fallback = Theme.Label(tostring(name):sub(1, 1), "Title", {
			Scaled = true,
			Props = { Name = "Fallback", Size = UDim2.new(1, 0, 1, 0) },
		})
		fallback.Parent = viewport
	end
	fit()

	local handle = { Frame = viewport, Model = model }
	local ticker = nil
	local visibilityTimer = 1
	local stepTimer = 0
	local orphanTime = 0
	local shown = false

	function handle.Destroy()
		if dead then
			return
		end
		dead = true
		if ticker then
			ticker.dead = true
		end
		if model then
			model:Destroy()
			model = nil
		end
		viewport:Destroy()
	end

	function handle.SetAnimated(on)
		animated = on and true or false
		if not animated and model then
			angle = 0.55
			pose(0.35, 0)
		end
	end

	function handle.SetExcited(amount)
		animOpts.Excited = Util.Clamp(tonumber(amount) or 0, 0, 1)
	end

	if model then
		ticker = addTicker(function(dt, t)
			if dead then
				return
			end
			visibilityTimer = visibilityTimer + dt
			if visibilityTimer >= 0.25 then
				local elapsed = visibilityTimer
				visibilityTimer = 0
				if viewport:IsDescendantOf(game) then
					orphanTime = 0
				else
					orphanTime = orphanTime + elapsed
				end
				if orphanTime > 1.5 then
					handle.Destroy()
					return
				end
				-- Phase 6 (runtime-pets): the pet's Blender mesh keys became usable here -> swap the Part model for
				-- the mesh pet (MeshVersion: one compare per check; the rebuild only when this model can upgrade)
				local ver = builder.MeshVersion and builder.MeshVersion()
				if ver and ver ~= meshVer then
					meshVer = ver
					if builder.NeedsMeshRebuild and builder.NeedsMeshRebuild(model) then
						local okNew, fresh = pcall(builder.Build, petDef, buildOpts)
						if okNew and typeof(fresh) == "Instance" then
							model:Destroy()
							model = fresh
							handle.Model = fresh
							model.Parent = viewport
							pcall(function()
								model:PivotTo(CFrame.new())
							end)
							animate(0.35)
							local okBox, cf, bbox = pcall(function()
								return model:GetBoundingBox()
							end)
							if okBox and cf and bbox then
								center = cf.Position
								halfH = math.max(0.5, bbox.Y * 0.5)
								halfW = math.max(0.5, math.max(bbox.X, bbox.Z) * 0.5)
							end
							pose(0.35, 0)
							fit()
						end
					end
				end
				shown = isShown(viewport)
				if shown then
					local abs = viewport.AbsoluteSize
					if abs.X > 0 and abs.Y > 0 and math.abs(abs.X / abs.Y - lastAspect) > 0.02 then
						fit()
					end
				end
			end
			if not shown or not animated then
				return
			end
			stepTimer = stepTimer + dt
			if stepTimer < 1 / 40 then
				return
			end
			local step = stepTimer
			stepTimer = 0
			pose(t, step)
		end)
	end

	viewport.Parent = parent
	return handle
end

----------------------------------------------------------------------
-- Slot (inventory / hotbar cell with a rarity border)
----------------------------------------------------------------------
local function petKey(info)
	if type(info) ~= "table" then
		return nil
	end
	local pet = info.Pet
	local id = nil
	if type(pet) == "table" then
		id = pet.Id
	elseif type(pet) == "string" then
		id = pet
	end
	if id == nil then
		return nil
	end
	-- the evolution stage is part of the key: a slot rebuilds its model when the stage changes
	local stage = info.Evolved
	if stage == true then
		stage = 1
	end
	stage = math.floor(tonumber(stage) or 0)
	return tostring(id) .. "|" .. tostring(stage)
end

-- props: Size (default 80x80), Position, AnchorPoint, Parent, Callback, Hotkey, Name, LayoutOrder
-- info = { Glyph, Color, Pet = PetDef, Detail = "High" | "Low" (PetBuilder detail, default High), Evolved (stage 1 | 2 or
-- true: drawn Low), RarityColor, Name, Blurb }
function CloudUI.Slot(props)
	props = props or {}
	local info = nil
	local selected = false
	local dimmed = false
	local hovering = false
	local viewportHandle = nil

	local root = frame(props.Name or "CloudSlot", {
		Size = props.Size or UDim2.fromOffset(80, 80),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})

	local button = Util.Create("TextButton", {
		Name = "Button",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(1, 0, 1, 0),
		Parent = root,
	})
	corner(button, 12)
	local outline = stroke(button, NAVY, 3, 0)
	local fill = gradient(button, ColorSequence.new(PANEL_TOP, PANEL_BOTTOM), 90)

	-- v5: a thin sheen line under the top edge + the rarity colour glowing up from the floor (behind the content)
	local gloss = frame("Gloss", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.82,
		Position = UDim2.new(0, 10, 0, 4),
		Size = UDim2.new(1, -20, 0, 2),
	}, button)
	corner(gloss, 1)
	local floorGlow = frame("Floor", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0,
		Position = UDim2.new(0, 3, 0.45, 0),
		Size = UDim2.new(1, -6, 0.55, -3),
		Visible = false,
	}, button)
	corner(floorGlow, 9)
	Util.Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, 0.74),
		}),
		Parent = floorGlow,
	})

	local content = frame("Content", { Size = UDim2.new(1, 0, 1, 0), ZIndex = 2 }, button)

	local countLabel = Theme.Label("", "Heading", {
		Size = 17,
		Props = {
			Name = "Count",
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -5, 1, -3),
			Size = UDim2.new(0.8, 0, 0, 20),
			TextXAlignment = Enum.TextXAlignment.Right,
			Visible = false,
			ZIndex = 5,
		},
	})
	countLabel.Parent = button

	local hotkeyChip = frame("Hotkey", {
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.05,
		Position = UDim2.new(0, 4, 0, 4),
		Size = UDim2.fromOffset(26, 26),
		ZIndex = 5,
		Visible = false,
	}, button)
	corner(hotkeyChip, 7)
	stroke(hotkeyChip, NEON.Grey, 1.5, 0.3)
	local hotkeyLabel = Theme.Label("", "Heading", {
		Size = 18,
		Props = { Name = "Key", Size = UDim2.new(1, 0, 1, 0), ZIndex = 6 },
	})
	hotkeyLabel.Parent = hotkeyChip

	local markerChip = frame("Marker", {
		BackgroundColor3 = GOLD,
		BackgroundTransparency = 0,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(26, 26),
		ZIndex = 5,
		Visible = false,
	}, button)
	round(markerChip)
	stroke(markerChip, INK, 2, 0)
	local markerLabel = Theme.Label("", "Heading", {
		Size = 18,
		Props = { Name = "Mark", Size = UDim2.new(1, 0, 1, 0), ZIndex = 6 },
	})
	markerLabel.Parent = markerChip

	local dimOverlay = frame("Dim", {
		BackgroundColor3 = INK,
		BackgroundTransparency = 0.45,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 6,
		Visible = false,
	}, button)
	corner(dimOverlay, 12)

	local flashOverlay = frame("Flash", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 7,
	}, button)
	corner(flashOverlay, 12)

	-- v5: a dark navy face; the border is the rarity (or the item) colour, gold when selected; the colour also
	-- glows up from the floor; an empty slot is a dim, darker well
	local function paint()
		local rarity = info and info.RarityColor
		local tint = rarity or (info and info.Color) or NEON.Grey
		if selected then
			outline.Color = NEON.Gold
			outline.Thickness = 4
		elseif info then
			outline.Color = tint
			outline.Thickness = 3
		else
			outline.Color = Theme.Darken(NEON.Grey, 0.45)
			outline.Thickness = 2.5
		end
		if not info then
			fill.Color = ColorSequence.new(Theme.Darken(PANEL_TOP, 0.2), INK)
			gloss.BackgroundTransparency = 0.92
			floorGlow.Visible = false
			return
		end
		gloss.BackgroundTransparency = 0.82
		floorGlow.Visible = true
		floorGlow.BackgroundColor3 = selected and NEON.Gold or tint
		local top = PANEL_TOP:Lerp(tint, 0.1)
		if selected then
			top = PANEL_TOP:Lerp(NEON.Gold, 0.18)
		end
		fill.Color = ColorSequence.new(top, PANEL_BOTTOM)
	end

	local function clearContent()
		if viewportHandle then
			viewportHandle.Destroy()
			viewportHandle = nil
		end
		for _, child in ipairs(content:GetChildren()) do
			child:Destroy()
		end
	end

	local fx = attachFx(button, {
		Hover = 1.06,
		Press = 0.94,
		OnState = function(isHover)
			hovering = isHover
			if viewportHandle then
				viewportHandle.SetAnimated(hovering or selected)
				viewportHandle.SetExcited(hovering and 0.8 or 0)
			end
		end,
	})

	local slot = { Root = root, Button = button, Fx = fx }

	function slot.SetContent(newInfo)
		-- Windows re-render on every State.Changed: keep the (expensive) pet model when the same pet is shown again.
		local keepKey = viewportHandle ~= nil and petKey(info) or nil
		if keepKey ~= nil and keepKey == petKey(newInfo) then
			info = newInfo
			paint()
			return
		end
		clearContent()
		info = newInfo
		if info then
			if info.Pet then
				local evoStage = tonumber(info.Evolved == true and 1 or info.Evolved) or 0
				viewportHandle = CloudUI.PetViewport(content, info.Pet, UDim2.new(1, -8, 1, -8), {
					Position = UDim2.new(0.5, 0, 0.5, 0),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Animate = hovering or selected,
					Spin = "sway",
					Evolved = evoStage >= 1 and evoStage or nil,
					Detail = evoStage >= 1 and "Low" or info.Detail,
					ZIndex = 2,
				})
			elseif info.Glyph then
				local glyphColor = info.Color and Theme.Lighten(info.Color, 0.2) or WHITE
				local glyph = Theme.Label(tostring(info.Glyph), "Title", {
					Scaled = true,
					Color = glyphColor,
					Props = {
						Name = "Glyph",
						AnchorPoint = Vector2.new(0.5, 0.5),
						Position = UDim2.new(0.5, 0, 0.46, 0),
						Size = UDim2.new(0.62, 0, 0.62, 0),
						ZIndex = 3,
					},
				})
				Util.Create("UITextSizeConstraint", { MaxTextSize = 48, MinTextSize = 10, Parent = glyph })
				glyph.Parent = content
			end
		end
		paint()
	end

	function slot.SetSelected(on)
		selected = on and true or false
		paint()
		if viewportHandle then
			viewportHandle.SetAnimated(hovering or selected)
		end
	end

	-- Pet slots hide counts of 1 ("x1" is noise); item slots always show their count.
	function slot.SetCount(n)
		if type(n) ~= "number" then
			countLabel.Visible = false
			return
		end
		local isPet = info ~= nil and info.Pet ~= nil
		countLabel.Text = "x" .. tostring(math.floor(n))
		countLabel.Visible = (not isPet) or n > 1
	end

	function slot.SetHotkey(text)
		local value = text and tostring(text) or ""
		hotkeyLabel.Text = value
		hotkeyChip.Visible = value ~= ""
	end

	-- small corner chip, e.g. "*" for an equipped pet; nil hides it
	function slot.SetMarker(text, color)
		local value = text and tostring(text) or ""
		markerLabel.Text = value
		markerChip.Visible = value ~= ""
		if typeof(color) == "Color3" then
			markerChip.BackgroundColor3 = color
		end
	end

	function slot.SetDimmed(on)
		dimmed = on and true or false
		dimOverlay.Visible = dimmed
	end

	-- quick white flash, e.g. after an item was used
	function slot.Flash()
		flashOverlay.BackgroundTransparency = 0.35
		Util.Tween(flashOverlay, 0.35, { BackgroundTransparency = 1 })
	end

	function slot.Destroy()
		clearContent()
		root:Destroy()
	end

	CloudUI.Tooltip(button, function()
		if not info or not info.Name then
			return nil
		end
		if info.Blurb then
			return tostring(info.Name) .. "\n" .. tostring(info.Blurb)
		end
		return tostring(info.Name)
	end)

	if props.Callback then
		button.Activated:Connect(function()
			props.Callback(slot)
		end)
	end

	slot.SetHotkey(props.Hotkey)
	slot.SetContent(nil)
	root.Parent = props.Parent
	return slot
end

----------------------------------------------------------------------
-- Tabs
----------------------------------------------------------------------
-- props: Parent, Size, Position, AnchorPoint, Name, BarHeight (default 44), TextSize (default 21), OnSelect(name), Color (v5: the accent of the selected tab, a Color3 or neon / category name; default Blue)
-- Add(name, builderFn): creates the page frame, calls builderFn(page) immediately (errors are
-- warned, not thrown) and returns the page. The first tab added is selected.
function CloudUI.Tabs(props)
	props = props or {}
	local barHeight = props.BarHeight or 44
	local textSize = props.TextSize or 21

	local root = frame(props.Name or "CloudTabs", {
		Size = props.Size or UDim2.new(1, 0, 1, 0),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
	})
	local bar = frame("TabBar", { Size = UDim2.new(1, 0, 0, barHeight) }, root)
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 8),
		Parent = bar,
	})
	local content = frame("TabContent", {
		Position = UDim2.new(0, 0, 0, barHeight + 8),
		Size = UDim2.new(1, 0, 1, -(barHeight + 8)),
	}, root)

	local pages = {}
	local buttons = {}
	local outlines = {}
	local selected = nil
	local count = 0

	-- v5: neon pills; the selected tab is filled with its dark accent colour and glows, the others are navy with a
	-- dim border (props.Color: the accent, a Color3 or neon / category name; default Blue)
	local accent = Theme.NeonColor(props.Color or "Blue")
	local activeFace = Theme.Darken(accent, 0.42)
	local idleFace = PANEL_TOP
	local strokes = {}

	local function paintTab(name, animate)
		local button = buttons[name]
		if not button then
			return
		end
		local on = (name == selected)
		local face = on and activeFace or idleFace
		local textColor = on and WHITE or MUTED
		if animate then
			Util.Tween(button, 0.14, { BackgroundColor3 = face, TextColor3 = textColor })
		else
			button.BackgroundColor3 = face
			button.TextColor3 = textColor
		end
		button.TextStrokeColor3 = INK
		local border = strokes[name]
		if border then
			border.Color = on and accent or Theme.Darken(accent, 0.45)
			border.Thickness = on and 3 or 2
		end
		local textOutline = outlines[name]
		if textOutline then
			textOutline.Color = INK
			textOutline.Transparency = on and 0 or 0.25
		end
	end

	local tabs = { Root = root, Content = content, Bar = bar }

	function tabs.Select(name)
		if not pages[name] then
			return
		end
		local changed = selected ~= name
		selected = name
		for pageName, page in pairs(pages) do
			page.Visible = (pageName == name)
			paintTab(pageName, true)
		end
		if changed and props.OnSelect then
			props.OnSelect(name)
		end
	end

	function tabs.Add(name, builderFn)
		count = count + 1
		local page = frame("Page_" .. tostring(name), {
			Size = UDim2.new(1, 0, 1, 0),
			Visible = false,
		}, content)
		pages[name] = page

		local button = Util.Create("TextButton", {
			Name = "Tab_" .. tostring(name),
			AutoButtonColor = false,
			BorderSizePixel = 0,
			BackgroundColor3 = idleFace,
			Text = tostring(name),
			AutomaticSize = Enum.AutomaticSize.X,
			Size = UDim2.new(0, 0, 0, barHeight - 4),
			LayoutOrder = count,
		})
		Theme.Style(button, "Button", { Size = textSize, Color = MUTED })
		corner(button, math.floor((barHeight - 4) / 2))
		strokes[name] = stroke(button, accent, 2, 0)
		gradient(button, FACE_SEQUENCE, 90)
		padding(button, 20, 0, 20, 0)
		Util.Create("UISizeConstraint", { MinSize = Vector2.new(84, 0), Parent = button })
		button.Activated:Connect(function()
			tabs.Select(name)
		end)
		button.Parent = bar
		buttons[name] = button
		paintTab(name, false)

		if builderFn then
			local ok, err = pcall(builderFn, page)
			if not ok then
				warn("[CloudUI] tab '" .. tostring(name) .. "' builder failed: " .. tostring(err))
			end
		end
		if not selected then
			tabs.Select(name)
		end
		return page
	end

	function tabs.GetSelected()
		return selected
	end

	function tabs.GetPage(name)
		return pages[name]
	end

	function tabs.GetButton(name)
		return buttons[name]
	end

	root.Parent = props.Parent
	return tabs
end

----------------------------------------------------------------------
-- Grid
----------------------------------------------------------------------
-- cellSize: UDim2 | Vector2 | number; padding: number (px) | UDim2
function CloudUI.Grid(parent, cellSize, cellPadding)
	local cell = toUDim2(cellSize, UDim2.fromOffset(84, 84))
	local pad = toUDim2(cellPadding, UDim2.fromOffset(10, 10))

	local scroll = Util.Create("ScrollingFrame", {
		Name = "CloudGrid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 1, 0),
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
	})
	SignKit.ScrollBar(scroll) -- (U9-7 look) the kit's wood bar, square ends (was the old kit's 10 px neon blue)
	padding(scroll, 10, 10, 10, 10)
	Util.Create("UIGridLayout", {
		Name = "Layout",
		CellSize = cell,
		CellPadding = pad,
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Top,
		Parent = scroll,
	})
	scroll.Parent = parent
	return scroll
end

return CloudUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1185">
            <Properties>
              <string name="Name">Egg3D</string>
              <string name="Source"><![CDATA[-- Egg3D (client UI; egg-3d, the owner's pick 2026-11-08 "3D egg + 3D crack", spec
-- docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.14 "3D eggs"): the real Blender egg in a ViewportFrame for the
-- hatch cutscene's pedestal phases (EggStage: Rise, Crack) and the Shop's Secret hero egg (ShopEggs), and the crack that
-- splits it into its two Blender halves which fly apart. The model is the shelf's own dressed mesh: MeshLibrary.Assemble
-- of the same key, the way MeshLibrary.Dress dresses the egg row's shelf eggs (no fork, no second loader).
--
--   Egg3D.KEYS[rarity] = { Whole = "egg_<r>", Top = "egg_<r>_top", Bot = "egg_<r>_bot" }   (literal keys: tools/mesh_keys.py)
--   Egg3D.Usable(rarity, opts) -> ok, reason   reason "low" (Low graphics), "missing" (the whole egg's key is not usable
--                                  here: no id, still loading, refused, a failed load), "limit" (Live() + opts.Need, 1 by
--                                  default, would pass Limit(opts.Phone): egg-cards, an x3 asks for its three), "rarity"
--   Egg3D.New(parent, rarity, opts) -> view | nil, reason   (nil = draw today's 2D EggArt egg, exactly as before)
--       opts = { Phone = bool (the one-at-a-time limit), Name = "Egg3D", ZIndex, Spin = seconds a turn (nil = still),
--                Turn = start angle (degrees), View = egg heights the frame shows (default 2: the frame is 2.5 x 2 of the
--                parent, centred, room for the halves to fly) }
--       an Assemble that fails (a template gone, a part missing) returns nil, "failed"
--   view.Frame (the ViewportFrame), view.Rarity, view.Key, view.Model, view.Top / view.Bot (after Split), view.Dead
--   view:Spin(seconds | nil)      a slow turn (an endless Linear tween of a NumberValue; nil stops it where it is)
--   view:Settle(seconds)          the turn eases to a stop (Quad Out) over that long: the crack holds the egg still
--   view:Pose(rollDeg, bob)       the shake: a roll about the egg's middle (GUI-clockwise for > 0, as GuiObject.Rotation)
--                                 and a bob in studs; one PivotTo, no table / Instance made
--   view:CanSplit() -> bool       both halves usable here (their ids, loaded, High)
--   view:Split() -> bool          the whole egg out, the two halves in at its exact pose (they line up with it)
--   view:Fly(seconds) -> bool     the halves fly apart (a NumberValue tween, Quart Out): the cap up-left, tumbling to show
--                                 its hollow and fading out from half-way, the cup rocks and settles where it stood
--   view:Destroy()                everything (tweens, connections, the frame); also when the frame is destroyed
--   Egg3D.Watch(fn) -> connection fn(key) when a mesh key may have become usable here (MeshLibrary.Changed)
--   Egg3D.Live() -> number        views alive now; Egg3D.Limit(phone) -> 1 on a phone, 3 elsewhere (egg-cards, spec 16.18:
--                                 the x3 roll's three hero eggs; the Shop's hero is destroyed when the Shop hides, before
--                                 any cutscene egg rises); a phone's x3 stays 2D (3 > 1), the strip cells draw pictures
--   Egg3D._ML / Egg3D._High       tests only: a MeshLibrary stand-in { IsReady, Assemble } and a graphics answer
--
-- The camera: FieldOfView 20 from 8 degrees above, framing 2 x the egg's height (the frame is 2 egg heights tall), so the
-- 3-stud egg fills the same box the 2D egg did. Light per rarity (Ambient / LightColor / LightDirection from the upper
-- left, in front): soft and close to white for the low eggs, warm gold for Legendary, cool violet night for Secret.
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local UIFolder = script.Parent
local ClientFolder = UIFolder.Parent

local Egg3D = {}

Egg3D.KEYS = {
	Common = { Whole = "egg_common", Top = "egg_common_top", Bot = "egg_common_bot" },
	Uncommon = { Whole = "egg_uncommon", Top = "egg_uncommon_top", Bot = "egg_uncommon_bot" },
	Rare = { Whole = "egg_rare", Top = "egg_rare_top", Bot = "egg_rare_bot" },
	Epic = { Whole = "egg_epic", Top = "egg_epic_top", Bot = "egg_epic_bot" },
	Legendary = { Whole = "egg_legendary", Top = "egg_legendary_top", Bot = "egg_legendary_bot" },
	Mythic = { Whole = "egg_mythic", Top = "egg_mythic_top", Bot = "egg_mythic_bot" },
	Secret = { Whole = "egg_secret", Top = "egg_secret_top", Bot = "egg_secret_bot" },
}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local K = {
	EGG_H = 3, -- studs (the Blender egg: 2.2 x 3 x 2.2, pivot at the bottom centre)
	FOV = 20,
	PITCH = math.rad(8),
	WIDTH = 0.8, -- the 2D egg frame's width per height (EggArt): the frame is VIEW_EGGS / WIDTH of its width wide
	VIEW_EGGS = 2, -- egg heights the frame shows top to bottom (and parent heights it is tall): room for the halves
	-- the light per rarity: Ambient fills, LightColor from the upper left in front (it travels to -X, down, to +Z: onto the
	-- egg's -Z front)
	LIGHT = {
		Common = { rgb(176, 180, 194), rgb(255, 250, 240) },
		Uncommon = { rgb(170, 186, 176), rgb(255, 252, 236) },
		Rare = { rgb(168, 180, 202), rgb(240, 248, 255) },
		Epic = { rgb(178, 168, 200), rgb(255, 244, 255) },
		Legendary = { rgb(190, 176, 156), rgb(255, 236, 196) },
		Mythic = { rgb(196, 170, 186), rgb(255, 238, 246) },
		Secret = { rgb(132, 120, 176), rgb(214, 198, 255) },
	},
	LIGHT_AMOUNT = 0.55, -- LightColor is scaled by this (the vertex colours already carry their baked shading)
	DIR = Vector3.new(-0.55, -1, 0.7),
	-- the burst: the cap's flight (studs, radians) and the cup's rock. The flight is Quart Out, so u = 0.7 comes at about a
	-- quarter of the burst: the cap is seen solid on its way out and fades over the slow tail
	CAP = { X = 0.85, Y = 1.35, Z = -0.4, Roll = -0.62, Tumble = 0.55, FadeFrom = 0.7 },
	ROCK = 0.12,
}
Egg3D.Metrics = K

local LIVE = setmetatable({}, { __mode = "k" }) -- view -> true while alive
local GQ = nil

local function high()
	if Egg3D._High ~= nil then
		return Egg3D._High == true
	end
	if GQ == nil then
		GQ = false
		local module = ClientFolder:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				GQ = mod
			end
		end
	end
	if not GQ or type(GQ.Effective) ~= "function" then
		return true
	end
	local ok, mode = pcall(GQ.Effective)
	return not ok or mode ~= "Low"
end

local ML = nil
local function lib()
	if Egg3D._ML then
		return Egg3D._ML
	end
	if ML == nil then
		ML = false
		local module = Shared:FindFirstChild("MeshLibrary")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				ML = mod
			end
		end
	end
	return ML or nil
end

local function ready(key)
	local m = lib()
	if not m or type(m.IsReady) ~= "function" then
		return false
	end
	local ok, yes = pcall(m.IsReady, key)
	return ok and yes == true
end

-- the shelf's dressed mesh: the same Assemble call MeshLibrary.Dress makes, at the pivot (identity)
local function assemble(key, name)
	local m = lib()
	if not m or type(m.Assemble) ~= "function" then
		return nil
	end
	local ok, model = pcall(m.Assemble, { Name = name, Root = false, Parts = { { Key = key } } }, {}, { Scale = 1, At = CFrame.new() })
	if ok and typeof(model) == "Instance" and model:IsA("Model") then
		return model
	end
	return nil
end

function Egg3D.Live()
	local n = 0
	for v in pairs(LIVE) do
		if not v.Dead then
			n = n + 1
		end
	end
	return n
end

-- fn(key) whenever a mesh key may have become usable / unusable here (MeshLibrary.Changed) -> connection | nil
function Egg3D.Watch(fn)
	local m = lib()
	local sig = m and m.Changed
	if type(sig) == "table" and type(sig.Connect) == "function" then
		local ok, conn = pcall(sig.Connect, sig, fn)
		return ok and conn or nil
	end
	return nil
end

function Egg3D.Limit(phone)
	return phone and 1 or 3
end

function Egg3D.Usable(rarity, opts)
	local keys = Egg3D.KEYS[rarity]
	if not keys then
		return false, "rarity"
	end
	if not high() then
		return false, "low"
	end
	if not ready(keys.Whole) then
		return false, "missing"
	end
	opts = type(opts) == "table" and opts or {}
	-- (egg-cards, spec 16.18) Need: the frames the caller is about to make (an x3 asks for its three at once)
	local need = math.max(1, math.floor(tonumber(opts.Need) or 1))
	if Egg3D.Live() + need > Egg3D.Limit(opts.Phone == true) then
		return false, "limit"
	end
	return true, nil
end

----------------------------------------------------------------------
-- the view
----------------------------------------------------------------------
local View = {}
View.__index = View

local CENTER = CFrame.new(0, K.EGG_H / 2, 0)
local CENTER_INV = CENTER:Inverse()

-- the whole egg's pose from the turn, the shake's roll and the bob (one CFrame chain: no table)
function View:_pose()
	local yaw = math.rad(self.Turn.Value)
	return CFrame.new(0, self.Bob, 0) * CENTER * CFrame.Angles(0, 0, self.Roll) * CFrame.Angles(0, yaw, 0) * CENTER_INV
end

function View:_apply()
	if self.Dead or self.IsSplit or not self.Model then
		return
	end
	self.Model:PivotTo(self:_pose())
end

function View:_track(tw)
	self.Tweens[tw] = true
	tw:Play()
	return tw
end

function View:_stopTurn()
	if self.TurnTw then
		pcall(function()
			self.TurnTw:Cancel()
		end)
		self.Tweens[self.TurnTw] = nil
		self.TurnTw = nil
	end
end

function View:Spin(seconds)
	if self.Dead then
		return
	end
	self:_stopTurn()
	seconds = tonumber(seconds)
	if not seconds or seconds <= 0 then
		return
	end
	local from = self.Turn.Value % 360
	self.Turn.Value = from
	self.TurnTw = self:_track(TweenService:Create(self.Turn, TweenInfo.new(seconds, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Value = from + 360 }))
	self.TurnRate = 360 / seconds
end

function View:Settle(seconds)
	if self.Dead then
		return
	end
	local rate = self.TurnTw and self.TurnRate or 0
	self:_stopTurn()
	seconds = math.max(0.05, tonumber(seconds) or 0.5)
	if rate > 0 then
		-- Quad Out from the turn's speed: it covers half of speed x time and stops without a jolt
		self.TurnTw = self:_track(TweenService:Create(self.Turn, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = self.Turn.Value + rate * seconds / 2 }))
	end
	self.TurnRate = 0
end

function View:Pose(rollDeg, bob)
	if self.Dead or self.IsSplit then
		return
	end
	self.Roll = math.rad(tonumber(rollDeg) or 0)
	self.Bob = tonumber(bob) or 0
	self:_apply()
end

function View:CanSplit()
	return not self.Dead and high() and ready(self.Keys.Top) and ready(self.Keys.Bot)
end

function View:Split()
	if self.Dead or self.IsSplit or not self:CanSplit() then
		return false
	end
	local top = assemble(self.Keys.Top, "EggTop")
	local bot = assemble(self.Keys.Bot, "EggBot")
	if not (top and bot) then
		if top then
			top:Destroy()
		end
		if bot then
			bot:Destroy()
		end
		return false
	end
	self:_stopTurn()
	local at = self:_pose()
	self.SplitAt = at
	-- the cap turns about its own middle (its box centre at the pivot, before it is placed), in the frame's space (the
	-- screen's axes: the egg may have turned), so it always flies up-left and shows its hollow to the camera
	local okBox, cf = pcall(function()
		return (top:GetBoundingBox())
	end)
	local mid = (okBox and typeof(cf) == "CFrame") and cf.Position or Vector3.new(0, 2.3, 0)
	local p = at * mid
	self.CapMid = CFrame.new(p)
	self.CapMidInv = CFrame.new(-p)
	top:PivotTo(at)
	bot:PivotTo(at)
	top.Parent = self.Frame
	bot.Parent = self.Frame
	self.CapParts = {}
	for _, d in ipairs(top:GetDescendants()) do
		if d:IsA("BasePart") then
			self.CapParts[#self.CapParts + 1] = { d, d.Transparency }
		end
	end
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	self.Top, self.Bot = top, bot
	self.IsSplit = true
	self.Frame:SetAttribute("Split", true)
	return true
end

-- one step of the flight (u 0 -> 1, already eased)
function View:_fly()
	if self.Dead or not self.Top then
		return
	end
	local u = self.FlyU.Value
	local c = K.CAP
	local at = self.SplitAt
	self.Top:PivotTo(CFrame.new(c.X * u, c.Y * u, c.Z * u) * self.CapMid * CFrame.Angles(0, 0, c.Roll * u) * CFrame.Angles(c.Tumble * u, 0, 0) * self.CapMidInv * at)
	local fade = u > c.FadeFrom and (u - c.FadeFrom) / (1 - c.FadeFrom) or 0
	for _, pt in ipairs(self.CapParts) do
		pt[1].Transparency = pt[2] + (1 - pt[2]) * fade
	end
	-- the cup rocks on its foot and settles (a damped wobble about the pivot)
	self.Bot:PivotTo(at * CFrame.Angles(0, 0, K.ROCK * math.sin(u * math.pi * 3) * (1 - u)))
end

function View:Fly(seconds)
	if self.Dead or not self.IsSplit or self.FlyTw then
		return false
	end
	self.FlyU.Value = 0
	self.FlyTw = self:_track(TweenService:Create(self.FlyU, TweenInfo.new(math.max(0.05, tonumber(seconds) or 0.35), Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Value = 1 }))
	self.Frame:SetAttribute("Flying", true)
	return true
end

function View:Destroy()
	if self.Dead then
		return
	end
	self.Dead = true
	LIVE[self] = nil
	for tw in pairs(self.Tweens) do
		pcall(function()
			tw:Cancel()
		end)
	end
	self.Tweens = {}
	for _, c in ipairs(self.Conns) do
		pcall(function()
			c:Disconnect()
		end)
	end
	self.Conns = {}
	self.CapParts = {}
	local f = self.Frame
	self.Model, self.Top, self.Bot = nil, nil, nil
	if f and f.Parent then
		f:Destroy()
	end
end

function Egg3D.New(parent, rarity, opts)
	opts = type(opts) == "table" and opts or {}
	local ok, reason = Egg3D.Usable(rarity, opts)
	if not ok then
		return nil, reason
	end
	local keys = Egg3D.KEYS[rarity]
	local model = assemble(keys.Whole, "Egg")
	if not model then
		return nil, "failed"
	end
	local light = K.LIGHT[rarity] or K.LIGHT.Common
	local lc = light[2]
	-- the frame shows `view` egg heights top to bottom and is that many parent heights tall (as wide in the 0.8-wide 2D
	-- egg's measure), so the 3-stud egg always fills the parent's height
	local viewEggs = math.max(1, tonumber(opts.View) or K.VIEW_EGGS)
	local frame = Util.Create("ViewportFrame", {
		Name = opts.Name or "Egg3D",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(viewEggs / K.WIDTH, viewEggs),
		ZIndex = opts.ZIndex or 1,
		Ambient = light[1],
		LightColor = Color3.new(lc.R * K.LIGHT_AMOUNT, lc.G * K.LIGHT_AMOUNT, lc.B * K.LIGHT_AMOUNT),
		LightDirection = K.DIR,
	})
	frame:SetAttribute("Rarity", rarity)
	frame:SetAttribute("Key", keys.Whole)
	local cam = Util.Create("Camera", { Name = "Camera", FieldOfView = K.FOV, Parent = frame })
	local dist = (K.EGG_H * viewEggs / 2) / math.tan(math.rad(K.FOV) / 2)
	local look = Vector3.new(0, K.EGG_H / 2, 0)
	cam.CFrame = CFrame.lookAt(look + Vector3.new(0, math.sin(K.PITCH) * dist, -math.cos(K.PITCH) * dist), look)
	frame.CurrentCamera = cam
	local turn = Util.Create("NumberValue", { Name = "Turn", Value = tonumber(opts.Turn) or 0, Parent = frame })
	local flyU = Util.Create("NumberValue", { Name = "Fly", Value = 0, Parent = frame })
	local view = setmetatable({
		Frame = frame, Camera = cam, Model = model, Rarity = rarity, Key = keys.Whole, Keys = keys,
		Turn = turn, FlyU = flyU, Roll = 0, Bob = 0, TurnRate = 0, Tweens = {}, Conns = {}, CapParts = {},
		IsSplit = false, Dead = false,
	}, View)
	view.Conns[1] = turn.Changed:Connect(function()
		view:_apply()
	end)
	view.Conns[2] = flyU.Changed:Connect(function()
		view:_fly()
	end)
	view.Conns[3] = frame.Destroying:Connect(function()
		view:Destroy()
	end)
	model.Parent = frame
	view:_apply()
	LIVE[view] = true
	frame.Parent = parent
	if opts.Spin then
		view:Spin(opts.Spin)
	end
	return view, nil
end

return Egg3D
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1186">
            <Properties>
              <string name="Name">EggArt</string>
              <string name="Source"><![CDATA[-- EggArt (client UI; lobby-shop Tasks 20 / 26, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.5 "Painted eggs"
-- and 5.6 "How eggs look"): the seven eggs drawn from frames (no image ids, nothing to upload), painted with the same
-- motifs as the Blender shelf eggs (blender/kit/props/lobby_shop.py prop lobby_egg), so the shelf, the Shop and the
-- cutscene show one egg per rarity. One shape for all: an oval body (UICorner 0.5, 0.8 x as wide as it is tall), a
-- top-to-bottom tone gradient, a navy outline and a white highlight on the upper left.
--
--   EggArt.New(parent, rarity, size, opts) -> Frame "Egg_<Rarity>" (size = the egg's height in design px; width
--     floor(0.8 x size + 0.5)); opts = { Form = "Auto" | "Simple" | "Medium" | "Full", Vfx = bool, ZIndex, Name,
--     Rim = false (no rim light), Budget = n (a lower instance cap: the strip's cells pass 9, spec 16.4's 14 per cell),
--     Still = true (a Full egg whose sheen waits for SetVfx(egg, true): the Shop's hero egg) }
--     attributes Rarity, Form (Auto: Simple under 48 px, Medium 48-140, Full over 140), Size, Motifs (the paint kinds
--     drawn, comma-separated) and Vfx
--   EggArt.SetRarity(egg, rarity)  re-paints in place (tone, paint, light layer, VFX); the name follows a default name
--   EggArt.SetVfx(egg, on)  on (High graphics only): a Full egg's sheen plays and, from Rare up, the rarity VFX are added;
--     off (or Low): the VFX removed and the sheen parked, so the egg is still (nothing plays)
--   EggArt.Resize(egg, size)  the size, the outline and every stroke inside (each stroke keeps its share of the size)
--   EggArt.SetPaintShown(egg, shown)  (egg-3d) false: the painted egg hides (a client/UI/Egg3D egg stands in the frame),
--     its Shadow, Rays, Aura and whatever others put in it (Egg3D, Cracks, Leaks) stay; true: painted again
--   EggArt.Halves(parent, rarity, size) -> top, bottom   two CanvasGroups "HalfTop" / "HalfBottom" (the egg's width x half
--     its height, at y 0 and y size / 2 in the parent), each drawing the whole painted egg (no sheen, no shadow, no
--     tween: they fly apart in 0.35 s) clipped to its half
--   EggArt.Glow(rarity)  -> the glow strength behind the egg: 0 / 0 / 0.22 / 0.34 / 0.58 / 0.66 / 0.78 (Common .. Secret)
--   EggArt.Tones(rarity) -> top, bottom Color3: the rarity colour (Config.Rarities) 38% toward white / 28% toward black;
--     Secret rgb(74,68,104) / rgb(18,16,28) (its colour is near black)
--   EggArt.Paint(rarity) -> { { Kind, Count }, ... }   spec 16.5's motif list in order (Secret lists its stars first:
--     the Simple rule keeps them; its two rune lines ride in the shell's tone in every form)
--
-- The layers (instance caps, spec 16.5: Simple <= 8, Medium <= 14, Full <= 28): every form has the body Frame, its
-- UICorner, the UIGradient "Tone" (the paint's bands are hard-edged keypoints in it: no instance, <= 20 keypoints), the
-- UIStroke "Outline" (rgb(11,16,48), size / 20, at least 2 px, whole) and the "Highlight" with its UICorner (6). Medium
-- adds the "Rim" light (an inset capsule with a transparency gradient: 3); Full the Rim, the "Specular" dot (2), the
-- contact "Shadow" under the egg (2), the "Sheen" (a capsule whose UIGradient sweeps every ~4 s on High: 3) and, from
-- Epic up, the "Light" layer (soft glow rows behind the Neon details: 3). The paint fills what is left, in priority
-- order: Simple the first motif, Medium the first two as they fit, Full every motif (no frame pokes out of the outline).
-- VFX (Rare and up, High only; <= 8 instances, <= 3 tweens): a "Halo" ring in the glow colour round every one; Epic
-- the Light layer flickers every ~3 s and the star row twinkles; Legendary's soft "Rays" turn behind it and the gems
-- glint; Mythic's ribbon drifts; Secret pulses, its two stars twinkle and a dark violet "Aura" ring stands round it.
-- The drifting sparkles are not the egg's: they come from a HatchFx pool (client/UI/HatchFx). Every tween stops when the
-- egg is destroyed. Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))

local EggArt = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local K = {
	INK = rgb(11, 16, 48),
	WHITE = Color3.new(1, 1, 1),
	BLACK = Color3.new(0, 0, 0),
	TO_WHITE = 0.38, -- the top tone: the rarity colour this far toward white
	TO_BLACK = 0.28, -- the bottom tone: this far toward black
	SECRET_TOP = rgb(74, 68, 104),
	SECRET_BOTTOM = rgb(18, 16, 28),
	GLOW = { Common = 0, Uncommon = 0, Rare = 0.22, Epic = 0.34, Legendary = 0.58, Mythic = 0.66, Secret = 0.78 },
	SIMPLE_BELOW = 48, -- design px: Simple under this
	FULL_ABOVE = 140, -- design px: Full over this
	WIDTH = 0.8, -- the body is this much as wide as it is tall
	-- the highlight: an oval on the upper left (shares of the body)
	HL_POS = { 0.2, 0.12 },
	HL_SIZE = { 0.24, 0.2 },
	HL_ALPHA = 0.35,
	CAP = { Simple = 8, Medium = 14, Full = 28 },
	FORM_CHAR = { Simple = "S", Medium = "M", Full = "F" },
	EPS = 0.002, -- a hard band edge in the tone gradient
	BAND_SHADE = 0.22, -- a band's colour this far toward black at the egg's foot (shaded by height)
	SHEEN = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 2.8), -- 4.0 s a sweep
	HALO_K = 0.085, -- the halo ring's thickness, a share of the egg's height
	SECRET_GLOW = rgb(138, 92, 255), -- Secret's glow is violet (its colour is near black)
	AURA = rgb(52, 24, 110),
	SHADOW = rgb(11, 16, 48),
}
EggArt.Metrics = K

-- the instance cost of each paint shape (a ringed dot adds its UIStroke)
local COST = { dot = 2, dia = 1, bar = 1, row = 2, band = 2, ring = 3, ticks = 2, plus = 2 }

----------------------------------------------------------------------------------------------------
-- the designs (spec 16.5's table): Kinds = { Kind, Count } in order; Bands[kind] = tone bands { y0, y1, colour } (hard)
-- or { t, colour } (a soft point), Bands.Base in every form; Els = { kind, forms, shape, ... } in priority order (x a
-- share of the egg's width, y of its height, sizes in egg heights); Light = the glow rows from Epic up
----------------------------------------------------------------------------------------------------
local SPOT, CREAM, LIME, NAVY, GOLD = rgb(116, 124, 138), rgb(250, 240, 200), rgb(186, 240, 100), rgb(20, 36, 92), rgb(255, 206, 72)
local D = {}
D.Common = {
	Kinds = { { "Spots", 4 }, { "Dots", 2 }, { "Shine", 1 } },
	Bands = {},
	Els = {
		{ "Spots", "S", "dot", 0.60, 0.56, 0.30, SPOT },
		{ "Spots", "MF", "dot", 0.64, 0.40, 0.26, SPOT },
		{ "Dots", "MF", "dot", 0.52, 0.565, 0.075, K.WHITE, 0.05 },
		{ "Spots", "F", "dot", 0.33, 0.66, 0.19, SPOT },
		{ "Spots", "F", "dot", 0.74, 0.76, 0.15, SPOT },
		{ "Spots", "F", "dot", 0.50, 0.90, 0.11, SPOT },
		{ "Dots", "F", "dot", 0.24, 0.45, 0.06, K.WHITE, 0.05 },
	},
}
D.Uncommon = {
	Kinds = { { "ZigzagBand", 1 }, { "Spots", 3 }, { "Dots", 1 } },
	Bands = { ZigzagBand = { { 0.395, 0.625, rgb(40, 110, 62) } } }, -- the deep green belt the zigzag runs on
	Els = {
		{ "ZigzagBand", "SM", "bar", 0.035, 0.445, 0.5, 0.575, 0.075, CREAM, 0, 1 },
		{ "ZigzagBand", "SM", "bar", 0.5, 0.575, 0.965, 0.445, 0.075, CREAM, 1, 0 },
		{ "ZigzagBand", "F", "bar", 0.035, 0.575, 0.25, 0.445, 0.075, CREAM, 0, 1 },
		{ "ZigzagBand", "F", "bar", 0.25, 0.445, 0.5, 0.575, 0.075, CREAM, 1, 1 },
		{ "ZigzagBand", "F", "bar", 0.5, 0.575, 0.75, 0.445, 0.075, CREAM, 1, 1 },
		{ "ZigzagBand", "F", "bar", 0.75, 0.445, 0.965, 0.575, 0.075, CREAM, 1, 0 },
		{ "Spots", "MF", "dot", 0.5, 0.468, 0.075, LIME },
		{ "Spots", "F", "dot", 0.25, 0.555, 0.075, LIME },
		{ "Spots", "F", "dot", 0.75, 0.555, 0.075, LIME },
		{ "Dots", "F", "dot", 0.64, 0.24, 0.065, K.WHITE, 0.05 },
	},
}
D.Rare = {
	Kinds = { { "Bands", 2 }, { "Dots", 4 } },
	Bands = {
		Bands = {
			{ 0.306, 0.318, NAVY }, { 0.318, 0.402, rgb(246, 250, 255) }, { 0.402, 0.414, NAVY },
			{ 0.618, 0.630, NAVY }, { 0.630, 0.714, rgb(246, 250, 255) }, { 0.714, 0.726, NAVY },
		},
	},
	Els = {
		{ "Dots", "MF", "dot", 0.5, 0.516, 0.10, K.WHITE, 0, NAVY, 0.012 },
		{ "Dots", "F", "dot", 0.2, 0.516, 0.10, K.WHITE, 0, NAVY, 0.012 },
		{ "Dots", "F", "dot", 0.8, 0.516, 0.10, K.WHITE, 0, NAVY, 0.012 },
		{ "Dots", "F", "dot", 0.62, 0.20, 0.06, K.WHITE, 0.45 },
	},
}
D.Epic = {
	Kinds = { { "StarBand", 1 }, { "Trim", 2 }, { "Stars", 3 }, { "Dots", 2 } },
	Bands = {
		StarBand = { { 0.333, 0.600, rgb(70, 32, 128) } },
		Trim = { { 0.267, 0.333, GOLD }, { 0.600, 0.667, GOLD } },
	},
	Els = {
		-- the star row: a white line brightest at the three stars, and the stars' upright arms
		{ "Stars", "F", "row", 0.06, 0.94, 0.4665, 0.024, rgb(255, 248, 220), { 0, 1, 0.06, 0.7, 0.182, 0, 0.34, 0.7, 0.5, 0, 0.66, 0.7, 0.818, 0, 0.94, 0.7, 1, 1 } },
		{ "Stars", "F", "bar", 0.22, 0.4115, 0.22, 0.5215, 0.024, rgb(255, 248, 220) },
		{ "Stars", "F", "bar", 0.5, 0.3765, 0.5, 0.5565, 0.024, rgb(255, 248, 220) },
		{ "Stars", "F", "bar", 0.78, 0.4115, 0.78, 0.5215, 0.024, rgb(255, 248, 220) },
		{ "Dots", "F", "dot", 0.62, 0.17, 0.06, K.WHITE, 0.05 },
		{ "Dots", "F", "dot", 0.5, 0.80, 0.06, GOLD },
	},
	Light = { Color = rgb(255, 230, 150), Peaks = { { 0.30, 0.66, 0.06 }, { 0.4665, 0.74, 0.04 }, { 0.633, 0.66, 0.06 } } },
}
D.Legendary = {
	Kinds = { { "Crown", 1 }, { "Trim", 1 }, { "Gems", 2 }, { "Swags", 1 } },
	Bands = {
		Crown = { { 0.300, 0.509, rgb(150, 24, 52) }, { 0.509, 0.517, rgb(176, 106, 18) }, { 0.517, 0.667, rgb(255, 244, 206) } },
		Trim = { { 0.667, 0.733, GOLD } },
		Swags = { { 0.158, 0.172, rgb(255, 240, 205) } },
	},
	Els = {
		{ "Crown", "SMF", "dia", 0.5, 0.517, 0.30, rgb(255, 244, 206) },
		{ "Crown", "MF", "dia", 0.2, 0.517, 0.26, rgb(255, 244, 206) },
		{ "Crown", "MF", "dia", 0.8, 0.517, 0.26, rgb(255, 244, 206) },
		{ "Gems", "F", "dia", 0.335, 0.592, 0.09, rgb(255, 52, 96) },
		{ "Gems", "F", "dia", 0.665, 0.592, 0.09, rgb(52, 150, 255) },
		{ "Swags", "F", "dot", 0.5, 0.165, 0.05, rgb(255, 250, 240) },
		{ "Swags", "F", "dot", 0.76, 0.165, 0.05, rgb(255, 250, 240) },
	},
	Light = { Color = rgb(255, 236, 170), Peaks = { { 0.40, 0.7, 0.05 }, { 0.592, 0.62, 0.05 }, { 0.70, 0.62, 0.05 } } },
}
D.Mythic = {
	Kinds = { { "WaveBands", 4 }, { "Ribbon", 1 }, { "Swirls", 2 }, { "Stars", 1 } },
	Bands = {
		WaveBands = {
			{ 0.08, rgb(255, 232, 240) }, { 0.24, rgb(252, 176, 204) }, { 0.42, rgb(236, 130, 180) },
			{ 0.62, rgb(150, 56, 120) }, { 0.80, rgb(120, 52, 150) }, { 0.94, rgb(98, 54, 170) },
		},
	},
	Els = {
		{ "Ribbon", "MF", "band", 0.517, 0.577, { rgb(156, 92, 255), rgb(214, 176, 255) } },
		{ "Swirls", "F", "ring", 0.27, 0.445, 0.10, rgb(60, 236, 212), 0.018 },
		{ "Swirls", "F", "ring", 0.73, 0.65, 0.10, rgb(60, 236, 212), 0.018 },
		{ "Stars", "F", "dia", 0.66, 0.20, 0.07, rgb(255, 246, 252) },
	},
	Light = { Color = rgb(236, 210, 255), Peaks = { { 0.445, 0.72, 0.05 }, { 0.547, 0.6, 0.05 }, { 0.65, 0.72, 0.05 } } },
}
D.Secret = {
	Kinds = { { "Stars", 2 }, { "Runes", 1 }, { "Cracks", 1 }, { "Dots", 1 } },
	Bands = {
		-- the two magenta rune lines and the violet dusk at the foot: every form
		Base = {
			{ 0.333, 0.352, rgb(226, 82, 255) }, { 0.667, 0.686, rgb(226, 82, 255) },
			{ 0.80, rgb(40, 30, 72) }, { 0.94, rgb(70, 40, 124) },
		},
	},
	Els = {
		{ "Stars", "SMF", "plus", 0.62, 0.20, 0.13, 0.16, 0.02, rgb(255, 248, 220) },
		-- six rune marks, uneven in spacing, width and glow (an even row read as a barcode)
		{ "Runes", "MF", "ticks", 0.415, 0.585, rgb(226, 82, 255), { { 0.09, 0.025, 0.1 }, { 0.24, 0.04, 0.4 }, { 0.41, 0.022, 0.05 }, { 0.57, 0.045, 0.35 }, { 0.75, 0.025, 0.12 }, { 0.9, 0.035, 0.3 } } },
		{ "Stars", "F", "plus", 0.30, 0.84, 0.07, 0.08, 0.016, rgb(255, 248, 220) },
		{ "Cracks", "F", "bar", 0.53, 0.03, 0.46, 0.15, 0.022, rgb(150, 70, 255), 0, 1 },
		{ "Cracks", "F", "bar", 0.46, 0.15, 0.52, 0.335, 0.022, rgb(150, 70, 255), 1, 0 },
		{ "Dots", "F", "dia", 0.80, 0.30, 0.035, K.WHITE },
	},
	Light = { Color = rgb(226, 140, 255), Peaks = { { 0.18, 0.78, 0.07 }, { 0.343, 0.6, 0.04 }, { 0.50, 0.7, 0.06 }, { 0.676, 0.6, 0.04 } } },
}

-- per-egg state (weak keys): { Rarity, Form, Size, Z, Budget, Half, Paint = {}, Light, Sheen = tween, VfxOn, Fx = {} }
local ST = setmetatable({}, { __mode = "k" })
-- the graphics setting (client/GraphicsQuality's Effective(), asked on every call); High when the module is not there
local Q = { GQ = nil }

local function rarityColor(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return r.Color
		end
	end
	return rgb(168, 178, 194)
end

local function known(rarity)
	return K.GLOW[rarity] ~= nil
end

local function high()
	if Q.GQ == nil then
		Q.GQ = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				Q.GQ = mod
			end
		end
	end
	if not Q.GQ then
		return true
	end
	local ok, mode = pcall(Q.GQ.Effective)
	return not ok or mode ~= "Low"
end

function EggArt.Tones(rarity)
	if rarity == "Secret" then
		return K.SECRET_TOP, K.SECRET_BOTTOM
	end
	local c = rarityColor(rarity)
	return c:Lerp(K.WHITE, K.TO_WHITE), c:Lerp(K.BLACK, K.TO_BLACK)
end

function EggArt.Glow(rarity)
	return K.GLOW[rarity] or 0
end

function EggArt.Paint(rarity)
	local d = D[rarity]
	local out = {}
	for i, k in ipairs(d and d.Kinds or {}) do
		out[i] = { Kind = k[1], Count = k[2] }
	end
	return out
end

local function formOf(size, wanted)
	if wanted == "Simple" or wanted == "Medium" or wanted == "Full" then
		return wanted
	end
	if size < K.SIMPLE_BELOW then
		return "Simple"
	elseif size <= K.FULL_ABOVE then
		return "Medium"
	end
	return "Full"
end

local function outlineOf(size)
	return math.max(2, math.floor(size / 20 + 0.5))
end

-- the frame / corner / stroke / gradient makers (one helper table keeps the main chunk's locals few)
local M = {}
function M.frame(parent, name, z, color, alpha)
	return Util.Create("Frame", {
		Name = name,
		BackgroundColor3 = color or K.WHITE,
		BackgroundTransparency = alpha or 0,
		BorderSizePixel = 0,
		ZIndex = z,
		Parent = parent,
	})
end
function M.corner(f)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = f })
end
-- a stroke whose thickness keeps its share k of the egg's height (Resize reads the attribute K)
function M.stroke(f, color, k, size, alpha)
	local s = Util.Create("UIStroke", {
		Color = color,
		Thickness = math.max(1, math.floor(k * size + 0.5)),
		Transparency = alpha or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = f,
	})
	s:SetAttribute("K", k)
	return s
end
function M.alphas(list)
	local kps = {}
	for i = 1, #list, 2 do
		kps[#kps + 1] = NumberSequenceKeypoint.new(list[i], list[i + 1])
	end
	return NumberSequence.new(kps)
end
function M.gradient(f, name, rotation, alphas, colors)
	return Util.Create("UIGradient", { Name = name, Rotation = rotation or 0, Transparency = alphas, Color = colors, Parent = f })
end
-- a centred frame at (x, y) (shares of the egg), w x h in egg heights
function M.at(f, x, y, w, h)
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w / K.WIDTH, h)
	return f
end

-- the paint shapes: SHAPE[kind](egg, z, e, size) -> the frame (e = the element row; its arguments from e[4])
local SHAPE = {}
function SHAPE.dot(egg, z, e, size)
	local f = M.at(M.frame(egg, "Dot", z, e[7], e[8]), e[4], e[5], e[6], e[6])
	M.corner(f)
	if e[9] then
		M.stroke(f, e[9], e[10], size)
	end
	return f
end
function SHAPE.dia(egg, z, e)
	local side = e[6] / math.sqrt(2) -- d is the diamond's diagonal
	local f = M.at(M.frame(egg, "Dia", z, e[7]), e[4], e[5], side, side)
	f.Rotation = 45
	return f
end
-- a bar from (x1, y1) to (x2, y2), t thick; e[10] / e[11] = 1 mitres that end (a zigzag joint: (t / 2) tan of its slope)
function SHAPE.bar(egg, z, e)
	local x1, y1, x2, y2, t = e[4] * K.WIDTH, e[5], e[6] * K.WIDTH, e[7], e[8]
	local dx, dy = x2 - x1, y2 - y1
	local len = math.sqrt(dx * dx + dy * dy)
	local ux, uy = dx / len, dy / len
	local m = (t / 2) * math.abs(dy / math.max(math.abs(dx), 1e-6))
	m = math.min(m, t)
	local a, b = (e[10] or 0) * m, (e[11] or 0) * m
	local cx, cy = (x1 + x2) / 2 + ux * (b - a) / 2, (y1 + y2) / 2 + uy * (b - a) / 2
	local f = M.at(M.frame(egg, "Bar", z, e[9]), cx / K.WIDTH, cy, len + a + b, t)
	f.Rotation = math.deg(math.atan2(dy, dx))
	return f
end
-- a horizontal line x1 .. x2 at y, its transparency along it from the list (pairs of time, alpha)
function SHAPE.row(egg, z, e)
	local f = M.frame(egg, "Row", z, e[8])
	f.AnchorPoint = Vector2.new(0, 0.5)
	f.Position = UDim2.fromScale(e[4], e[6])
	f.Size = UDim2.fromScale(e[5] - e[4], e[7])
	M.gradient(f, "Taper", 0, M.alphas(e[9]))
	return f
end
-- a ribbon across the egg's straight middle (y0 .. y1), striped along it
function SHAPE.band(egg, z, e)
	local f = M.frame(egg, "Band", z, K.WHITE)
	f.Position = UDim2.fromScale(0, e[4])
	f.Size = UDim2.fromScale(1, e[5] - e[4])
	local kps, cs = {}, e[6]
	for i = 0, 6 do
		kps[#kps + 1] = ColorSequenceKeypoint.new(i / 6, cs[(i % 2) + 1])
	end
	M.gradient(f, "Stripes", 0, nil, ColorSequence.new(kps))
	f:FindFirstChild("Stripes").Offset = Vector2.new(-0.15, 0)
	return f
end
function SHAPE.ring(egg, z, e, size)
	local f = M.at(M.frame(egg, "Ring", z, e[7], 1), e[4], e[5], e[6], e[6])
	M.corner(f)
	M.stroke(f, e[7], e[8], size)
	return f
end
-- soft rune marks along the egg's straight middle (y0 .. y1): e[7] = { { centre, half width, alpha }, ... } (<= 6: the
-- gradient's 20 keypoints)
function SHAPE.ticks(egg, z, e)
	local f = M.frame(egg, "Ticks", z, e[6])
	f.Position = UDim2.fromScale(0, e[4])
	f.Size = UDim2.fromScale(1, e[5] - e[4])
	local list = { 0, 1 }
	for _, m in ipairs(e[7]) do
		list[#list + 1], list[#list + 2] = m[1] - m[2], 1
		list[#list + 1], list[#list + 2] = m[1], m[3]
		list[#list + 1], list[#list + 2] = m[1] + m[2], 1
	end
	list[#list + 1], list[#list + 2] = 1, 1
	M.gradient(f, "Ticks", 0, M.alphas(list))
	return f
end
-- a 4-point star: a crossbar (w wide, t thick) holding its upright arm (h tall) as a child, so one Size tween twinkles both
function SHAPE.plus(egg, z, e)
	local x, y, w, h, t = e[4], e[5], e[6], e[7], e[8]
	local f = M.at(M.frame(egg, "Plus", z, e[9]), x, y, w, t)
	local arm = M.frame(f, "Arm", z, e[9])
	arm.AnchorPoint = Vector2.new(0.5, 0.5)
	arm.Position = UDim2.fromScale(0.5, 0.5)
	arm.Size = UDim2.fromScale(t / w, h / t)
	return f
end

-- the tone: the shell's top-to-bottom colours with the bands of the kinds drawn (hard bands: keypoints EPS apart)
function M.tone(rarity, kinds)
	local top, bottom = EggArt.Tones(rarity)
	local d = D[rarity]
	local soft, hard = { { 0, top } }, {}
	local function take(list)
		for _, b in ipairs(list or {}) do
			if #b == 2 then
				soft[#soft + 1] = { b[1], b[2] }
			else
				hard[#hard + 1] = b
			end
		end
	end
	take(d.Bands.Base)
	for _, k in ipairs(d.Kinds) do
		if kinds[k[1]] then
			take(d.Bands[k[1]])
		end
	end
	soft[#soft + 1] = { 1, bottom }
	table.sort(soft, function(a, b)
		return a[1] < b[1]
	end)
	table.sort(hard, function(a, b)
		return a[1] < b[1]
	end)
	local function base(y)
		for i = 2, #soft do
			if y <= soft[i][1] then
				local a, b = soft[i - 1], soft[i]
				return a[2]:Lerp(b[2], (y - a[1]) / math.max(b[1] - a[1], 1e-6))
			end
		end
		return bottom
	end
	local function shade(c, y)
		return c:Lerp(K.BLACK, K.BAND_SHADE * y)
	end
	local pts, spans, last = {}, {}, nil
	for _, b in ipairs(hard) do
		local y0, y1, c = b[1], b[2], b[3]
		if last and math.abs(last - y0) < 1e-6 then
			pts[#pts + 1] = { y0 + K.EPS, shade(c, y0) }
		else
			if last then
				pts[#pts + 1] = { last + K.EPS, base(last) }
			end
			pts[#pts + 1] = { y0 - K.EPS, base(y0) }
			pts[#pts + 1] = { y0, shade(c, y0) }
		end
		pts[#pts + 1] = { y1, shade(c, y1) }
		spans[#spans + 1] = { y0 - K.EPS, y1 + K.EPS }
		last = y1
	end
	if last then
		pts[#pts + 1] = { last + K.EPS, base(last) }
	end
	for i = 2, #soft - 1 do
		local inside = false
		for _, s in ipairs(spans) do
			inside = inside or (soft[i][1] >= s[1] and soft[i][1] <= s[2])
		end
		if not inside then
			pts[#pts + 1] = soft[i]
		end
	end
	table.sort(pts, function(a, b)
		return a[1] < b[1]
	end)
	local kps = { ColorSequenceKeypoint.new(0, top) }
	for _, p in ipairs(pts) do
		if p[1] > kps[#kps].Time and p[1] < 1 then
			kps[#kps + 1] = ColorSequenceKeypoint.new(p[1], p[2])
		end
	end
	kps[#kps + 1] = ColorSequenceKeypoint.new(1, bottom)
	return ColorSequence.new(kps)
end

-- the Light layer (Full, Epic and up): a capsule over the body, its glow rows soft peaks of a transparency gradient
function M.light(egg, d, z)
	local f = M.frame(egg, "Light", z, K.WHITE)
	f.Size = UDim2.fromScale(1, 1)
	M.corner(f)
	local list = { 0, 1 }
	for _, p in ipairs(d.Light.Peaks) do
		list[#list + 1], list[#list + 2] = p[1] - p[3], 1
		list[#list + 1], list[#list + 2] = p[1], p[2]
		list[#list + 1], list[#list + 2] = p[1] + p[3], 1
	end
	list[#list + 1], list[#list + 2] = 1, 1
	M.gradient(f, "Glow", 90, M.alphas(list), ColorSequence.new(d.Light.Color))
	return f
end

-- the rarity-dependent layers: the Light layer, the paint (greedy within the cap) and the tone; attribute Motifs
function M.paint(egg, st)
	local d, form, z = D[st.Rarity], st.Form, st.Z
	local nk = (form == "Simple") and 1 or ((form == "Medium") and 2 or #d.Kinds)
	local allowed, hasEl, drew, count = {}, {}, {}, {}
	for i = 1, nk do
		allowed[d.Kinds[i][1]] = true
	end
	if form == "Full" and d.Light then
		st.Light = M.light(egg, d, z + 1)
	end
	local cap = math.min(st.Budget or K.CAP[form], K.CAP[form])
	local used = #egg:GetDescendants() + 1
	local fc = K.FORM_CHAR[form]
	st.Paint = {}
	for _, e in ipairs(d.Els) do
		local kind = e[1]
		if allowed[kind] and string.find(e[2], fc, 1, true) then
			hasEl[kind] = true
			local cost = COST[e[3]] + ((e[3] == "dot" and e[9]) and 1 or 0)
			if used + cost <= cap then
				count[kind] = (count[kind] or 0) + 1
				local f = SHAPE[e[3]](egg, z + 2, e, st.Size)
				f.Name = kind .. count[kind]
				st.Paint[#st.Paint + 1] = f
				used = used + cost
				drew[kind] = true
			end
		end
	end
	local motifs, kinds = {}, {}
	for i = 1, nk do
		local kind = d.Kinds[i][1]
		if drew[kind] or not hasEl[kind] then
			motifs[#motifs + 1] = kind
			kinds[kind] = true
		end
	end
	local tone = egg:FindFirstChild("Tone")
	if tone then
		tone.Color = M.tone(st.Rarity, kinds)
	end
	egg.BackgroundColor3 = K.WHITE
	egg:SetAttribute("Motifs", table.concat(motifs, ","))
end

function M.unpaint(st)
	for _, f in ipairs(st.Paint or {}) do
		f:Destroy()
	end
	st.Paint = {}
	if st.Light then
		st.Light:Destroy()
		st.Light = nil
	end
end

----------------------------------------------------------------------------------------------------
-- the sheen and the VFX
----------------------------------------------------------------------------------------------------
function M.startSheen(egg, st)
	local sheen = egg:FindFirstChild("Sheen")
	local grad = sheen and sheen:FindFirstChild("Sweep")
	if st.Sheen or not grad or not high() or st.Hidden then
		return
	end
	grad.Offset = Vector2.new(-1, 0)
	st.Sheen = TweenService:Create(grad, K.SHEEN, { Offset = Vector2.new(1, 0) })
	st.Sheen:Play()
end

function M.stopSheen(egg, st)
	if st.Sheen then
		st.Sheen:Cancel()
		st.Sheen = nil
	end
	local sheen = egg:FindFirstChild("Sheen")
	local grad = sheen and sheen:FindFirstChild("Sweep")
	if grad then
		grad.Offset = Vector2.new(-1, 0)
	end
end

-- one endless VFX tween; the property's resting value is kept so clearing puts it back
function M.loop(st, inst, info, goal)
	if not inst then
		return
	end
	local rest = {}
	for prop in pairs(goal) do
		rest[prop] = inst[prop]
	end
	local tw = TweenService:Create(inst, info, goal)
	st.Fx[#st.Fx + 1] = { Tween = tw, Inst = inst, Rest = rest }
	tw:Play()
end

local function glowColor(rarity)
	if rarity == "Secret" then
		return K.SECRET_GLOW
	end
	return rarityColor(rarity):Lerp(K.WHITE, 0.25)
end

function M.addVfx(egg, st)
	local r, z, size = st.Rarity, st.Z, st.Size
	local glow = K.GLOW[r] or 0
	if glow <= 0 then
		return
	end
	local o = outlineOf(size)
	local made = {}
	-- the halo: a ring in the glow colour just outside the outline
	local halo = M.frame(egg, "Halo", z, K.WHITE, 1)
	halo.AnchorPoint = Vector2.new(0.5, 0.5)
	halo.Position = UDim2.fromScale(0.5, 0.5)
	halo.Size = UDim2.new(1, 2 * o, 1, 2 * o)
	halo:SetAttribute("PadOutline", true)
	halo.Visible = not st.Hidden -- (a 3D egg stands in this frame: the 2D oval's ring would float off its outline)
	M.corner(halo)
	M.stroke(halo, glowColor(r), K.HALO_K, size, 1 - 0.85 * glow)
	made[#made + 1] = halo
	local sine = Enum.EasingStyle.Sine
	local io = Enum.EasingDirection.InOut
	if r == "Epic" then
		M.loop(st, st.Light, TweenInfo.new(0.18, Enum.EasingStyle.Linear, io, -1, true, 2.8), { BackgroundTransparency = 0.55 })
		M.loop(st, egg:FindFirstChild("Stars1"), TweenInfo.new(0.9, sine, io, -1, true, 0.5), { BackgroundTransparency = 0.6 })
	elseif r == "Legendary" then
		-- the soft rays: two bars turning behind the egg, invisible over it (a child draws over its parent)
		local rays = M.frame(egg, "Rays", z, K.WHITE, 1)
		M.at(rays, 0.5, 0.5, 2.2, 2.2)
		for i, rot in ipairs({ 45, 135 }) do
			local bar = M.frame(rays, "Ray" .. i, z, glowColor(r), 0)
			bar.AnchorPoint = Vector2.new(0.5, 0.5)
			bar.Position = UDim2.fromScale(0.5, 0.5)
			bar.Size = UDim2.fromScale(1, 0.1)
			bar.Rotation = rot
			M.gradient(bar, "Fade", 0, M.alphas({ 0, 1, 0.14, 0.62, 0.26, 1, 0.74, 1, 0.86, 0.62, 1, 1 }))
		end
		made[#made + 1] = rays
		M.loop(st, rays, TweenInfo.new(30, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = 360 })
		M.loop(st, st.Light, TweenInfo.new(0.3, sine, io, -1, true, 2.4), { BackgroundTransparency = 0.6 })
	elseif r == "Mythic" then
		local ribbon = egg:FindFirstChild("Ribbon1")
		M.loop(st, ribbon and ribbon:FindFirstChild("Stripes"), TweenInfo.new(3.2, sine, io, -1, true), { Offset = Vector2.new(0.15, 0) })
	elseif r == "Secret" then
		local aura = M.frame(egg, "Aura", z, K.WHITE, 1)
		M.at(aura, 0.5, 0.5, 1.3, 1.3)
		M.corner(aura)
		M.stroke(aura, K.AURA, 0.03, size, 0.3)
		made[#made + 1] = aura
		M.loop(st, st.Light, TweenInfo.new(1.6, sine, io, -1, true), { BackgroundTransparency = 0.6 })
		for i, info in ipairs({ TweenInfo.new(0.9, sine, io, -1, true, 0.3), TweenInfo.new(1.3, sine, io, -1, true, 0.7) }) do
			local star = egg:FindFirstChild("Stars" .. i)
			if star then
				local s = star.Size
				M.loop(st, star, info, { Size = UDim2.fromScale(s.X.Scale * 0.55, s.Y.Scale * 0.55) })
			end
		end
	end
	st.FxInst = made
	st.VfxOn = true
	egg:SetAttribute("Vfx", true)
end

function M.clearVfx(egg, st)
	for _, fx in ipairs(st.Fx) do
		fx.Tween:Cancel()
		if fx.Inst.Parent then
			for prop, v in pairs(fx.Rest) do
				fx.Inst[prop] = v
			end
		end
	end
	st.Fx = {}
	for _, inst in ipairs(st.FxInst or {}) do
		inst:Destroy()
	end
	st.FxInst = {}
	st.VfxOn = false
	egg:SetAttribute("Vfx", false)
end

----------------------------------------------------------------------------------------------------
-- the API
----------------------------------------------------------------------------------------------------
function EggArt.New(parent, rarity, size, opts)
	opts = opts or {}
	rarity = known(rarity) and rarity or "Common"
	size = math.max(8, math.floor((tonumber(size) or 64) + 0.5))
	local z = opts.ZIndex or 1
	local form = formOf(size, opts.Form)
	local egg = Util.Create("Frame", {
		Name = opts.Name or ("Egg_" .. rarity),
		BackgroundColor3 = K.WHITE,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(math.floor(K.WIDTH * size + 0.5), size),
		ZIndex = z,
	})
	egg:SetAttribute("DefaultName", opts.Name == nil)
	egg:SetAttribute("Form", form)
	egg:SetAttribute("Size", size)
	egg:SetAttribute("Rarity", rarity)
	M.corner(egg)
	Util.Create("UIGradient", { Name = "Tone", Rotation = 90, Parent = egg })
	Util.Create("UIStroke", {
		Name = "Outline",
		Color = K.INK,
		Thickness = outlineOf(size),
		Transparency = 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = egg,
	})
	local hl = M.frame(egg, "Highlight", z + 5, K.WHITE, K.HL_ALPHA)
	hl.Position = UDim2.fromScale(K.HL_POS[1], K.HL_POS[2])
	hl.Size = UDim2.fromScale(K.HL_SIZE[1], K.HL_SIZE[2])
	hl.Rotation = -24
	M.corner(hl)
	local st = { Rarity = rarity, Form = form, Size = size, Z = z, Budget = opts.Budget, Paint = {}, Fx = {}, FxInst = {} }
	ST[egg] = st
	if form ~= "Simple" and opts.Rim ~= false then
		-- the rim light: an inset capsule, lit along its lower right edge (the light bouncing back off the ground)
		local rim = M.at(M.frame(egg, "Rim", z + 3, K.WHITE), 0.5, 0.5, 0.92 * K.WIDTH, 0.94)
		M.corner(rim)
		M.gradient(rim, "RimFade", 45, M.alphas({ 0, 1, 0.6, 1, 0.86, 0.74, 1, 0.62 }))
	end
	if form == "Full" then
		M.corner(M.at(M.frame(egg, "Specular", z + 6, K.WHITE, 0.1), 0.255, 0.355, 0.05, 0.05))
		if not opts._Half then
			-- the contact shadow: a flat ellipse just under the egg (its top under the outline)
			M.corner(M.at(M.frame(egg, "Shadow", z, K.SHADOW, 0.7), 0.5, 1.04, 0.76, 0.07))
			local sheen = M.frame(egg, "Sheen", z + 4, K.WHITE)
			sheen.Size = UDim2.fromScale(1, 1)
			M.corner(sheen)
			local sweep = M.gradient(sheen, "Sweep", 25, M.alphas({ 0, 1, 0.4, 1, 0.5, 0.55, 0.6, 1, 1, 1 }))
			sweep.Offset = Vector2.new(-1, 0)
		end
	end
	M.paint(egg, st)
	egg.Destroying:Connect(function()
		if st.Sheen then
			st.Sheen:Cancel()
			st.Sheen = nil
		end
		for _, fx in ipairs(st.Fx) do
			fx.Tween:Cancel()
		end
		st.Fx = {}
	end)
	egg.Parent = parent
	if form == "Full" and not opts.Still and not opts._Half then
		M.startSheen(egg, st)
	end
	if opts.Vfx then
		EggArt.SetVfx(egg, true)
	end
	return egg
end

function EggArt.SetRarity(egg, rarity)
	if typeof(egg) ~= "Instance" or not known(rarity) or egg:GetAttribute("Rarity") == rarity then
		return
	end
	local st = ST[egg]
	egg:SetAttribute("Rarity", rarity)
	if egg:GetAttribute("DefaultName") == true then
		egg.Name = "Egg_" .. rarity
	end
	if not st then
		local tone = egg:FindFirstChild("Tone")
		if tone then
			tone.Color = ColorSequence.new(EggArt.Tones(rarity))
		end
		return
	end
	local fx = st.VfxOn
	if fx then
		M.clearVfx(egg, st)
	end
	M.unpaint(st)
	st.Rarity = rarity
	M.paint(egg, st)
	if fx then
		M.addVfx(egg, st)
	end
end

function EggArt.SetVfx(egg, on)
	local st = typeof(egg) == "Instance" and ST[egg] or nil
	if not st then
		return
	end
	if on and high() then
		M.startSheen(egg, st)
		if not st.VfxOn then
			M.addVfx(egg, st)
		end
	else
		if st.VfxOn then
			M.clearVfx(egg, st)
		end
		M.stopSheen(egg, st)
	end
end

-- (egg-3d, spec 16.14) a 3D egg (client/UI/Egg3D) shows in this frame: shown = false hides the painted 2D egg (the body's
-- background, the Outline, the paint, the light layers, the sheen and the Halo ring) and keeps what stands around it (the
-- contact Shadow, Legendary's turning Rays, Secret's Aura) and what others put in it (Egg3D, HatchFx's Cracks / Leaks);
-- shown = true paints it again. The frame keeps its size, attributes and VFX tweens, so every caller works unchanged.
local AROUND = { Shadow = true, Rays = true, Aura = true, Egg3D = true, Cracks = true, Leaks = true }
function EggArt.SetPaintShown(egg, shown)
	local st = typeof(egg) == "Instance" and ST[egg] or nil
	if not st then
		return
	end
	st.Hidden = not shown
	egg.BackgroundTransparency = shown and 0 or 1
	local outline = egg:FindFirstChild("Outline")
	if outline then
		outline.Enabled = shown and true or false
	end
	for _, c in ipairs(egg:GetChildren()) do
		if c:IsA("GuiObject") and not AROUND[c.Name] then
			if shown then
				local was = c:GetAttribute("EA_Vis")
				if was ~= nil then
					c.Visible = was
					c:SetAttribute("EA_Vis", nil)
				end
			else
				if c:GetAttribute("EA_Vis") == nil then
					c:SetAttribute("EA_Vis", c.Visible)
				end
				c.Visible = false
			end
		end
	end
	if shown then
		if st.VfxOn then
			M.startSheen(egg, st)
		end
	else
		M.stopSheen(egg, st)
	end
	egg:SetAttribute("Painted", shown and true or false)
end

function EggArt.Resize(egg, size)
	if typeof(egg) ~= "Instance" then
		return
	end
	size = math.max(8, math.floor((tonumber(size) or 64) + 0.5))
	egg.Size = UDim2.fromOffset(math.floor(K.WIDTH * size + 0.5), size)
	egg:SetAttribute("Size", size)
	local st = ST[egg]
	if st then
		st.Size = size
	end
	local o = outlineOf(size)
	local outline = egg:FindFirstChild("Outline")
	if outline then
		outline.Thickness = o
	end
	for _, d in ipairs(egg:GetDescendants()) do
		local k = d:GetAttribute("K")
		if d:IsA("UIStroke") and type(k) == "number" then
			d.Thickness = math.max(1, math.floor(k * size + 0.5))
		elseif d:GetAttribute("PadOutline") == true then
			d.Size = UDim2.new(1, 2 * o, 1, 2 * o)
		end
	end
end

function EggArt.Halves(parent, rarity, size)
	size = math.max(8, math.floor((tonumber(size) or 64) + 0.5))
	local w = math.floor(K.WIDTH * size + 0.5)
	local half = size / 2
	local out = {}
	for i, name in ipairs({ "HalfTop", "HalfBottom" }) do
		local group = Util.Create("CanvasGroup", {
			Name = name,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, (i - 1) * half),
			Size = UDim2.fromOffset(w, half),
		})
		local egg = EggArt.New(group, rarity, size, { _Half = true })
		egg.Position = UDim2.fromOffset(0, -(i - 1) * half)
		group.Parent = parent
		out[i] = group
	end
	return out[1], out[2]
end

return EggArt
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1187">
            <Properties>
              <string name="Name">EggStage</string>
              <string name="Source"><![CDATA[-- EggStage (client UI; lobby-shop Tasks 20 / 27, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.4 "The
-- egg-opening cutscene" and 5.5 "The egg stage"): the stage every roulette spin plays through. The one BuyRoulette request
-- path, the RouletteResult listener and its queue, and the seven phases dressed as storyboard A "Pedestal" (the owner's
-- pick, .superpowers/lobby-shop/pitch/CUTSCENE_PICK.md, with Gemini's cloud ring): the world dims (a navy Dim, four
-- vignette edges, HatchFx.Dim's blur and "Hatch" tint on High), the machine's name slides down, the server's strip
-- scrolls with speed streaks, the landed egg rises out of it onto a cloud-stone pedestal in a spot light with its rarity
-- backlight and a turning cloud ring, cracks glow and light leaks as it shakes (the push-in: its UIScale to 1.06), then
-- bursts (halves, the shock ring, the rays, the sparks, the ring's swell in the rarity colour, a white or gold flash) and
-- the pet pops on the pedestal under its banner (Legendary and up keep slow gold rays, Mythic / Secret confetti, Secret
-- a starry backdrop and a violet aura). The effects are client/UI/HatchFx; ShopController calls Init (Task 22).
-- Sounds: the owner's egg keys (Config.Audio Egg*), each playing Config.Audio.Fallback (today's roulette sounds, or
-- nothing) while its id is 0.
-- (egg-3d, spec 16.14) an x1 roll's hero egg is the real Blender egg (client/UI/Egg3D: a ViewportFrame "Egg3D" in the
-- Egg1 frame, attribute Egg3D = its key) when its key is usable here on High graphics: it turns slowly over the rise,
-- settles as it cracks, rocks in 3D with the shakes and, when its two halves' keys are usable too, splits into them at
-- the burst (the frame moves into Halves1, attribute Split3D) and they fly apart; else today's 2D halves. No id, Low
-- graphics, a phone with a 3D egg already showing or a failed Assemble: today's 2D egg exactly. (egg-cards, spec 16.18)
-- An x3's three hero eggs are 3D the same way, each cracking into its halves at its own burst, when all three are
-- usable at once (H.use3d: Egg3D's limit is 3 on PC / tablets, 1 on a phone, so a phone's x3 stays 2D); never a mix.
-- The strip cards draw the Blender egg's picture (HatchLook.EggImage, the TextureIds keys egg_card_<rarity>) when all
-- seven have ids (HatchLook.EggPictures; preloaded at Init); else (today: nothing uploaded) the painted egg, never a mix.
-- (roll-look, spec 16.15 "Roll look A+B") the dressed roll and opening (client/UI/HatchLook builds the pieces): the HUD
-- hides, glossy strip cards under a gold window with B's colour tell, an overshoot and a land pop (Task 1); the opening
-- (Task 2): every egg rises onto a flat lit plinth in its Pedestal box (HatchLook.Plinth: neutral, popping 0.6 -> 1 and
-- fading in over the rise), Gemini's tweak from Rare up at the first shake (the plinth, the cloud ring and faint turning
-- rays take the rarity colour; x3: the rays for the best pull only), the burst's punch (Hero's UIScale "Punch", Burst's
-- following it, High only; review round 1: the title and the chips are never scaled), the sparks capped at 16 on phones;
-- below Rare the plinth takes its colour at the burst. The reveal (Task 3): the rarity word as letters popping in turn
-- (HatchLook.Word: gradient, outline, glow; an x3 phone column one label), B's silhouette from Legendary (the best pull's
-- pets black for 0.3 s, the chain waiting for them; the gold flash gone by then), the name / NEW! / note rising in, the
-- glossy pills (HatchLook.Pill) rising in and the small chips (HatchLook.Chip / FastChip), a landscape phone's x1 reveal
-- side by side (the pet left, the word, name, note and pills right: L.reveal1Side), the rays dimmed to 0.55 while the
-- text shows. (review round 1) No bowl: both 2D halves fly off at the burst and the pet stands on the plinth (its feet on
-- the disc's centre line, K.LOOK.PET_FOOT) on a soft contact shadow; the title fades over the rise; the crack word is
-- dressed like the reveal word (one HatchLook.Word label); the three optional images (HatchLook.IMAGES) are wired to the
-- rays, the sparks and every glow; SPIN AGAIN / DONE arm only once their rise is in place.
-- (kit-b U9-2b, finding 15) the chrome is the Signboard kit's, the motion unchanged: the strip a flat navy rail in its
-- wood frame (Outer), the cards stone blocks in mitred wood edges with the rarity's plate along the bottom (the landed
-- card the selected cream, the others the sunk well), the window a square gold frame with stepped pixel notches and no
-- glow; the rarity and crack words the title look's hard bands with one outline (no glow); Spin again the Shop's stone
-- Spin plank (look review: the coin and price inline), Done the stage's one green action (sentence case), the chips navy
-- blocks, NEW! / EVOLVED flat
-- tags. The stage's art (vignette, flash, halves, the rays, HatchFx's effects) carries attribute Art = "Hatch" (the kit B
-- walks skip it). (U9-2b look review 2, the owner's look bar of 2026-11-17) the art is pixel art too: the plinth the kit's
-- navy slab with the rarity on its lip (HatchLook.Plinth), the backlight a flat stepped light, the cloud ring's puffs
-- stepped pixel clouds that bob (no turn), the shock a square, the cracks and leaks square pixels; no spot cone, no
-- Secret aura; the pet's contact shadow two flat stepped rows; the reveal's name and note on a navy nameplate (the
-- pitch's "labels become signs", the rarity on its lip), a nail pixel in each corner of the rail's wood frame, a plus
-- sparkle blinking on NEW! (Rare and up). The stage runs no fractional UIScale: a PC lays out K.PC times its screen factor
-- (H.pcTier, Fit 1), every chrome block on whole px.
--
--   EggStage.Init()                        connects the RouletteResult listener (once)
--   EggStage.Show(result) -> bool          plays a RouletteResult (new shape with Pulls, or the old top-level shape); a
--                                          result that comes while a roll plays waits in the queue (DONE plays it)
--   EggStage.Request(rouletteId, currency, spins) -> bool   the only BuyRoulette sender: FIRE_GAP 0.3 s, the pending
--                                          flag, WAIT_TIMEOUT 7 s (then a toast); a failure answer is one toast
--   EggStage.IsPending() / IsShowing() / Phase() -> "Intro" | "Strip" | "Land" | "Rise" | "Crack" | "Burst" | "Reveal" | nil
--   EggStage.Skip()                        before the reveal: the reveal starts on the next frame (sounds stop)
--   EggStage.Back()                        Esc's one path (ShopController's Esc handler, Task 22): skip before the
--                                          reveal, DONE on it. EggStage has NO UserInputService handler of its own.
--   EggStage.Done()                        DONE on the reveal (the next queued result plays in place); a skip before it
--   EggStage.Close()                       closes from anyone else (MenuController.Close, Task 22); toasts the pulls not
--                                          shown yet
--   (review round 2) taps = the Dim, the Skip chip, SPIN AGAIN, DONE. Before the reveal a tap skips at once; on it, SPIN
--   AGAIN, DONE and a tap's close act only once armed: ARM_AFTER 0.8 s after the reveal appeared and ARM_QUIET 0.5 s after
--   the last tap (each tap restarts the wait, so a mash never buys a spin); the two buttons show disabled until then. The
--   roll's Skip chip and Fast hatch sit on the reveal's chip row (L.rollBar), never under SPIN AGAIN or DONE. Esc / B
--   (Back) stay DONE at once on the reveal (keys never land on a paid button); Done() and Skip() are the API (no wait).
--   EggStage.Timings(fast, spins) -> { Intro, Strip, Land, Rise, Crack, Burst, Stagger, LandGap, RevealAt }
--   EggStage.NoteText(pull, rarity, brief) -> the reveal's note (brief: an x3 column's, without the pet's name);
--   EggStage.Layout() -> "PC" | "Phone" | "Portrait"
--   EggStage.IsPrewarmed(petId) -> true once that pet's model was built for the reveal (warmed during the strip)
--   EggStage.Stats() -> { Instances, Tweens, Sparks, Effects, Heartbeats }  this module's GUI instances (a ViewportFrame
--                                          counts as one), playing tweens (its own and its HatchFx handles'), live sparks,
--                                          Lighting effects (the blur and the "Hatch" preset) and Heartbeats (one: the
--                                          phase runner also steps the spark pool)
--   signals Pending(rouletteId, currency, spins), Answered(result), Opened(), Closed(reason)
--   EggStage._Answer(result)               the RouletteResult listener's body (tests call it while MenuController's old
--                                          stage still listens to the remote, until Task 22)
--   EggStage._InjectPhaseError = "<Phase>" a test-only hook (nil by default): the phase runner raises an error when the
--                                          roll reaches that phase ("Reveal": inside the reveal's build, after its
--                                          columns); every teardown resets it. An exit before the reveal was fully built
--                                          (roll.RevealBuilt, set last) toasts the roll's pulls
--
-- Instances: NimbusHatch (DisplayOrder 25, IgnoreGuiInset, ResetOnSpawn false) > Stage > Dim (the tap-anywhere button),
-- Vignette, (Stars: the Secret backdrop), Content (the area under the top bar, UIScale "Fit") > Title,
-- Strips > Strip1..3 > Track (a non-scrolling ScrollingFrame: it clips) > Cell1..12, Streaks (High), Pointer; Hero (UIScale
-- "Punch") > Rays, CloudRing1..3 (> Puff1..8 > Row1..3, Shade; Swell, Bob), Backlight1..3 (> Glow<level><Mid|L|R>),
-- Pedestal1..3 (> Slab, Foot: HatchLook.Plinth),
-- Egg1..3 (> Cracks, Leaks), Halves1..3, CrackWord (a HatchLook.Word label: UIGradient "Bands" + UIStroke); Burst
-- (UIScale "Punch", following Hero's) > Shock, Sparks (the pool of 64);
-- Reveal > TextIn (the rise's NumberValue), Col1..3 > Banner (Word: L1..Ln, attribute Text; an x3 phone
-- column: one TextLabel), Plate (the nameplate), Pet (> Pop, Shadow > Row1..2, the PetViewport), Name, New (> Sparkle; beside the name; an x3 phone /
-- portrait column puts it on the pet frame's bottom-left corner), Note (a long one broken at its dots: H.fitNote),
-- EvolvedRibbon (review round 2: in the name row after NEW! when the name still fits, else PC the model's shoulder, a
-- phone's x3 / portrait the pet frame's top-right corner); BottomBar > Skip,
-- FastHatch (the chips), SpinAgain, Done (the pills), PillsIn; then Stage > Flash. (The Rays live in Hero, not Burst: a GUI frame's children cannot sit
-- between another frame's, and the rays belong behind the egg, the pedestal and the pet.) Strip cells are recycled (at
-- most 12 per strip): a cell re-skins its egg with EggArt.SetRarity when it wraps (Task 26: lean Medium eggs, Rim = false
-- and Budget = 9; the cell's stroke is its wood edge; only the landed cell's egg gets its VFX).
-- Attributes for tests: Strip<j>.Landed, Egg<j>.State (Rise / Crack / Burst / Open), Burst.Sparks (the last burst's count).
--
-- Never breaks the player (16.4): it writes nothing to the Camera or the Humanoid and plays on through a death or a
-- respawn; one teardown(reason) ends every exit ("Done" | "Error" | "Match" | "Close") and fires Closed(reason) last.
-- Gamepad B: "NimbusHatchBack" at ContextActionPriority High + 1, bound only while the stage shows, always Sink.
-- Plain Lua 5.1-compatible syntax only. Text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Theme = require(Shared:WaitForChild("Theme"))
local PetCatalog = require(Shared:WaitForChild("PetCatalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local StoreCatalog = require(Shared:WaitForChild("StoreCatalog"))

local UIFolder = script.Parent
local ClientFolder = UIFolder.Parent
local EggArt = require(UIFolder:WaitForChild("EggArt"))
local Egg3D = require(UIFolder:WaitForChild("Egg3D"))
local HatchFx = require(UIFolder:WaitForChild("HatchFx"))
local HatchLook = require(UIFolder:WaitForChild("HatchLook"))
local GemIcon = require(UIFolder:WaitForChild("GemIcon"))
local CloudUI = require(UIFolder:WaitForChild("CloudUI"))
local NeonKit = require(UIFolder:WaitForChild("NeonKit"))
local PetBits = require(UIFolder:WaitForChild("PetBits"))
local State = require(ClientFolder:WaitForChild("State"))
local ClientSettings = require(ClientFolder:WaitForChild("ClientSettings"))

local LocalPlayer = Players.LocalPlayer
local DOT = "\194\183"

local EggStage = {}
EggStage.Pending = Util.Signal()
EggStage.Answered = Util.Signal()
EggStage.Opened = Util.Signal()
EggStage.Closed = Util.Signal()

local K = {
	GUI = "NimbusHatch",
	ORDER = 25,
	BACK_ACTION = "NimbusHatchBack",
	FIRE_GAP = 0.3, -- seconds between two BuyRoulette sends
	WAIT_TIMEOUT = 7, -- seconds to wait for a RouletteResult
	-- (review round 2) SPIN AGAIN, DONE and a tap's close arm ARM_AFTER after the reveal appeared AND ARM_QUIET after the
	-- last tap on the stage (each tap restarts the wait): a double tap or a mash on the Skip chip never spends a spin
	ARM_AFTER = 0.8,
	ARM_QUIET = 0.5,
	-- (review round 3) SPIN AGAIN's row (label + coin + price + its two 6 px gaps) keeps this much of the button free (8 px a
	-- side, clear of the rounded gold border), else the price takes its short form from 1,000 up ("3K")
	AGAIN_SLACK = 16,
	NEXT_GAP = 0.15,
	STRIP_LEN = 40,
	WIN = 34,
	START_CELL = 4.5, -- the pointer starts over cell 5's centre (cell i spans i-1 .. i)
	CURVE = 2.8, -- the strip's ease (1 - (1 - t) ^ CURVE), today's
	TICKS_PER_S = 12,
	MAX_CELLS = 12,
	DIM = 0.45, -- the navy dim's final transparency (0.55 strong)
	VIGNETTE = 0.25, -- the vignette edges' final transparency
	NAVY = Color3.fromRGB(8, 12, 32),
	GOLD = Color3.fromRGB(242, 182, 68),
	WHITE = Color3.new(1, 1, 1),
	SECRET_TEXT = Color3.fromRGB(180, 150, 255), -- Secret's own colour is near black: the readable violet on navy
	SECRET_ID = (Config.Gems and Config.Gems.SecretRoulette and Config.Gems.SecretRoulette.Id) or "Secret",
	RESTRICTED_ATTR = "PaidRandomItemsRestricted",
	-- the owner's egg sounds (Config.Audio: each plays Config.Audio.Fallback while its id is 0)
	SOUND = { Tick = "EggStripTick", Land = "EggStripLand", Rise = "EggRise", Shake = "EggShake", Crack = "EggCrack", Burst = "EggBurst", Ring = "EggCloudRing" },
	-- the owner's picks page: EggRevealCommon is "Common to Rare", EggRevealLegend Legendary / Mythic
	REVEAL_SOUND = { Common = "EggRevealCommon", Uncommon = "EggRevealCommon", Rare = "EggRevealCommon", Epic = "EggRevealEpic", Legendary = "EggRevealLegend", Mythic = "EggRevealLegend", Secret = "EggRevealSecret" },
	LOUD_FROM = 5, -- Config.Rarities Order: Legendary and up play at Scale 1, the rest at 0.6
	QUIET = 0.6,
	-- (Task 27) the dressed cutscene (spec 16.4 "VFX and budget")
	SPARKS = { Common = 12, Uncommon = 16, Rare = 20, Epic = 28, Legendary = 40, Mythic = 48, Secret = 48 },
	CONFETTI = 24,
	STARS = 14,
	POOL = 64,
	PUSH = 1.06, -- the push-in: the hero egg's UIScale over the shakes (it grows on its foot, so it never meets the pedestal)
	SQUASH = 0.05, -- a shake squashes the egg this much (wider and lower, never taller)
	SHOCK = 1.7, -- the shock square's last size, in egg heights (U9-2b look review 2: round the egg, not a frame round the scene)
	RAYS = 2.4, -- the rays' diameter, in egg heights (on the reveal 2.2 pet sizes)
	RING = 1.6, -- the cloud ring's diameter, in egg heights (roll-look: its puffs on a circle round the egg, the mock's ring)
	SPOT = 520 / 380, -- the spot cone's width, in egg heights
	SHAKE_SPARKS = 4,
	SHAKE_SPARK = { Life = { 0.25, 0.4 }, Speed = { 90, 170 }, Px = { 4, 7 } },
	GOLD_IN = 0.25, -- the gold flash: from 0.8 (a kick on the burst frame) to 0.5 in 0.25 s, out to clear in 0.6 s (half
	GOLD_FROM = 0.8, -- strong at most: the reveal's banner and name read through it)
	GOLD_PEAK = 0.5,
	GOLD_OUT = 0.6,
	WHITE_FLASH = { 0.4, 0.12 }, -- the micro-flash: transparency 0.4 (0.6 strong) for 0.12 s
	TAIL = 0.25, -- Skip's burst tail over the reveal's start
	PED = {
		StoneTop = Color3.fromRGB(214, 222, 240), StoneFoot = Color3.fromRGB(112, 124, 160), Top = Color3.fromRGB(241, 245, 255),
		Gold = Color3.fromRGB(242, 193, 78), Puff = Color3.fromRGB(227, 236, 251),
	},
	SPOT_COLOR = Color3.fromRGB(255, 246, 222),
	AURA = Color3.fromRGB(150, 110, 255),
	-- the shop's window rule (spec 5.4) decides Phone vs PC
	RECT = { RECT = { H0 = 390, W0 = 820, Y0 = 330, H1 = 1080, W1 = 1660, Y1 = 900 }, MARGIN = 12, PHONE_W = 900, SHORT = 560, PC_MIN_H = 600, PC_MAX_W = 0.87 },
	TEXT = {
		Match = "The shop is closed during a match.",
		-- (review round 1) a BuyRoulette that left the client is almost always charged: never ask for a retry
		NoAnswer = "Still waiting for the roulette. Your spin will hatch as soon as it arrives.",
		Failed = "The spin failed.",
		Fallback = "A new pet joined your collection!",
		Policy = "Gem roulettes are not available on this account right now.",
		TokenPolicy = "Token spins are not available on this account right now.", -- (lobby-shop 16.12)
		Hatched = "You hatched: ",
	},
}
-- design px per layout (spec 5.5 / 16.4); the middle (strip cells, crack eggs, reveal pets) shrinks to 0.6, text never
K.PC = {
	TitleY = 34, TitleH = 60, TitleSize = 52, Side = 40,
	Strip1 = { H = 296, CellW = 230, CellH = 250, Step = 246, Egg = 160, Word = 18 },
	Strip3 = { H = 230, CellW = 190, CellH = 210, Step = 206, Egg = 130, Word = 20 },
	Crack1 = { Egg = 380, Word = 80 }, Crack3 = { Egg = 220, Word = 80 }, Col3 = 520,
	R1 = { BannerY = 20, BannerH = 104, Word = 84, BannerMin = 320, BannerPad = 80, Gap = 8, BarGap = 32, Pet = 420, PetMin = 252, Ped = 90 / 420, NameGap = 16, NameH = 60, Name = 54, NoteGap = 4, NoteH = 32, Note = 24, NewW = 120, NewH = 44, New = 26 },
	R3 = { BannerH = 70, Word = 56, BannerMin = 200, BannerPad = 60, Gap = 12, Pet = 300, PetMin = 180, PedW = 0.8, PedH = 0.18, NameGap = 12, NameH = 44, Name = 36, NoteGap = 4, NoteH = 52, Note = 20, NewW = 96, NewH = 36, New = 22 },
	-- (roll-look, spec 16.15 "Sizes") the glossy pills 56 tall (44.8 real px at the PC factor's floor of 0.8, 1280x720 /
	-- 1366x768); the chips draw 36 px pills in tap boxes 56 tall for the same reason (the readability rule's 44 real px:
	-- a 44 design px box is 35 px at the floor); { pref, min, height } in design px
	Bar = { Gap = 16, Text = 22, ChipText = 18, Skip = { 260, 200, 56 }, SkipReveal = { 260, 200, 56 }, Fast = { 200, 170, 56 }, Again = { 380, 300, 56 }, Done = { 220, 180, 56 }, Coin = 30, FastText = 18 },
}
K.PHONE = {
	-- (U9-2b look review 2) R3.RowPet 150 (was 110, under a 150 px RowMax row); R1.PetPortrait: a portrait x1's pet (at most
	-- the screen less PortraitSide), the word PortraitGap above it, the four one centred group
	TitleY = 6, TitleH = 28, TitleSize = 28, Side = 10,
	Strip1 = { H = 170, CellW = 130, CellH = 160, Step = 138, Egg = 104, Word = 15 },
	Strip3 = { H = 74, CellW = 76, CellH = 66, Step = 80, Egg = 48 },
	Crack1 = { Egg = 200, Word = 40 }, Crack3 = { Egg = 96, Word = 40 }, Col3 = 260,
	R1 = { BannerY = 2, BannerH = 44, Word = 40, BannerMin = 160, BannerPad = 40, Gap = 2, Pet = 170, PetMin = 110, Lip = true, NameGap = 2, NameH = 30, Name = 26, NoteGap = 2, NoteH = 20, NoteH2 = 36, Note = 15, NewW = 70, NewH = 26, New = 15, PetPortrait = 300, PortraitSide = 90, PortraitGap = 12 },
	R3 = { BannerH = 28, Word = 22, BannerMin = 120, BannerPad = 24, Gap = 2, Pet = 130, PetMin = 78, Lip = true, NameGap = 2, NameH = 22, Name = 18, NoteGap = 2, NoteH = 36, Note = 15, NewW = 56, NewH = 22, New = 15, RowPet = 150 },
	-- (roll-look) pills 46 tall, chips 44 px boxes drawing 32 px pills; Again3 = SPIN AGAIN x3 (its longer label beside the
	-- price chip, measured with the real fonts)
	Bar = { Gap = 8, Text = 16, ChipText = 15, Skip = { 150, 120, 44 }, SkipReveal = { 150, 120, 44 }, Fast = { 150, 135, 44 }, Again = { 208, 180, 46 }, Again3 = { 250, 226, 46 }, Done = { 118, 100, 46 }, Coin = 20, FastText = 15 },
	-- (roll-look, spec 16.15 "Phone x1 landscape reveal", the pitch's phoneA) side by side: the pet in the left PetCol of
	-- the width, the right column from the top: the word row (the 44 px band, letters at Word, Min WordMin), the name row
	-- (+ NEW!), the note (two lines), the two pills; the chips stay on the bottom row
	R1Side = { PetCol = 0.46, Pet = 170, PetMin = 110, WordRow = 48, BannerH = 44, BannerPad = 24, Word = 44, WordMin = 40, Gap = 14, NameH = 30, Name = 26, NoteGap = 4, NoteH = 36, Note = 15, PillGap = 20, NewW = 70, NewH = 26, New = 15 },
}
-- (U9-2b look review 2: whole px on every PC) the stage never runs a fractional UIScale: Fit stays 1 and a PC screen
-- other than 1080 tall lays out K.PC times its screen factor f (Theme.ScreenFactor, 0.8 .. 1.25), every px number
-- rounded (shares under 1.5 kept): the 0.8 stage of 1280x720 drawn in device px. The kit's pixel tier (lay.Kit) is the
-- unit round(3 x f): 2 px below f 0.8333 ("Phone": edges 2, lips 4, the notch 2, the 20 px coin), else 3 ("PC")
K.TIERS = {}
-- a phone's reveal lip: W x the pet wide, H px tall, its top on the pet's feet line (H.feet; U9-2b look review 2: was a
-- fixed 8 px up from the frame's bottom, under the feet only at a 200 px pet: a 300 px portrait pet floated 10 px over it)
K.LIP = { W = 0.7, H = 12 }
-- the crack's shakes as { from, to (shares of Crack), degrees }: two, one on Fast hatch
K.SHAKE = { { 0.12, 0.4, 6 }, { 0.55, 0.88, 10 } }
K.SHAKE_FAST = { { 0.25, 0.75, 10 } }
-- (egg-3d, spec 16.14) the 3D hero egg: its start angle (degrees: a three-quarter look that turns towards the front), a
-- slow turn (seconds a turn) over the rise, settling over this share of the crack; a shake's dip (studs at full squash);
-- the egg layers that turn with its rock on screen
K.EGG3D = { Turn = -28, Spin = 9, Settle = 0.3, Dip = 0.06, Turns = { "Cracks", "Leaks" } }
-- (roll-look, spec 16.15 "Roll look A+B") the dressed strip (client/UI/HatchLook builds the pieces): B's colour tell (Rare
-- and up: the window turns the coming colour Before s ahead of the land, in Tween s; Fast hatch in brackets), the
-- overshoot (Px x the strip's scale past the winner at the end of the ease, then the Back Out spring over Land), the
-- track's colours, the card and window sizes per layout (design px at the 1080p strip; x3 and a shrunk strip scale them).
-- (kit-b U9-2b) the track is the kit's navy rail (Rail) in its wood frame (Outer, Rim px), square; a card's Edge is its
-- wood edge, its Plate the rarity band along its bottom. (look review) an x3's three rails share their beams (a shelf:
-- Rim px of wood between two rails, PC and phone alike); the strips keep Clear px of sky under the title (Top) and above
-- the chips (Bottom), the wood frame included; Notch is the window's notch pixel unit (the kit's pixel pair,
-- SignKit.Sizes.Pixel Glyph / 9: 3 px on PC, 2 on a phone)
K.LOOK = {
	TELL = { Before = 0.7, Fast = 0.25, Tween = 0.25, TweenFast = 0.1 },
	OVERSHOOT = { Px = 18, Fast = 8 },
	TRACK = { Rail = Theme.Sign.Navy, Outer = Theme.Sign.Wood, Rim = 4, Clear = { PC = { Top = 12, Bottom = 20 }, Phone = { Top = 8, Bottom = 12 } } },
	PC = { Card = { Edge = 3, Plate = 30, Notch = 3, Win = 4, Pad = 8 } },
	PHONE = { Card = { Edge = 2, Plate = 22, Notch = 2, Win = 3, Pad = 6 } },
	-- (Task 2) Gemini's shake tweak (Rare and up, at the first shake: the plinth, the cloud ring and the rays to the rarity
	-- colour in Tween s, Fast hatch in Fast s; the rays rest at GroupTransparency Rays); the burst's punch (Stage's UIScale
	-- to Scale in Up s, back in Down s; squeezed into a Fast hatch's shorter burst); the plinth's pop over the rise (From ->
	-- 1, Back Out); below Rare the plinth takes its colour at the burst in BurstTint s; the sparks a phone's burst keeps
	TWEAK = { Tween = 0.25, Fast = 0.1, Rays = 0.75 },
	PUNCH = { Scale = 1.05, Up = 0.08, Down = 0.25 },
	PLINTH_IN = { From = 0.6 },
	BURST_TINT = 0.15,
	PHONE_SPARKS = 16,
	-- (Task 3) B's silhouette (the best pull from Config.Rarities Order From: its pet black until Hold, white in Fill; the
	-- reveal's chain waits for it); the chain (seconds from the silhouette's end: the letters Letter apart, the name / NEW! /
	-- note rising TextRise px from Text in TextIn, NEW!'s pop to NewPeak at New in NewIn then NewOut, the pills rising
	-- PillsRise px (less where the screen's edge is nearer) from Pills in PillsIn); the rays' rest while the text shows
	SIL = { Hold = 0.3, Fill = 0.15, From = 5 },
	CHAIN = { Letter = 0.05, Text = 0.2, TextRise = 16, TextIn = 0.25, New = 0.4, NewPeak = 1.3, NewIn = 0.15, NewOut = 0.12, Pills = 0.4, PillsRise = 20, PillsIn = 0.3 },
	RAYS_TEXT = 0.55,
	-- (review round 1) no bowl: the pet stands on the plinth. CloudUI.PetViewport frames the model at 1 / 1.2 of its frame,
	-- centred, so its feet sit about PET_FOOT down the frame: a PC reveal lowers the pet frame until that line is the
	-- plinth's centre line (the box's top); a soft contact Shadow (W x H of the frame, black at A, faded at its ends) sits
	-- on it inside the pet frame, so it pops with the pet
	PET_FOOT = 0.9,
	PET_SHADOW = { W = 0.5, A = 0.45 },
	-- (review round 1) the machine's title fades out over this share of the rise (the mock's title leaves as the egg rises:
	-- no second headline over the crack word on a landscape phone)
	TITLE_OUT = 0.6,
	-- (review round 1) B's silhouette wants a clean frame: for a roll that silhouettes, the gold flash peaks (from GOLD_FROM to
	-- GOLD_PEAK) as early as the time left allows and is gone in GOLD_OUT_SIL (Quad Out) by the reveal (the pitch mock's
	-- flash ends 0.1 s before its pet pops); rolls without a silhouette keep 16.4's 0.25 / 0.6
	GOLD_OUT_SIL = 0.15,
	CHEVRONS = "\226\128\186\226\128\186",
	-- (kit-b U9-2b review) the evolved tag's words per stage: the full form, then the short one (TeamFaces' "EVO II") for
	-- a tag held to a small pet frame's corner
	EVOLVED = { { "EVOLVED", "EVO" }, { "EVOLVED II", "EVO II" } },
}
EggStage.Metrics = K

-- S: the stage. Roll = the roll playing (or nil); Queue = results waiting for DONE; Lay = the layout of this screen
local S = {
	Gui = nil, Stage = nil, Content = nil, Fit = nil, Dim = nil, Flash = nil, Vignette = nil, Punch = nil,
	Roll = nil, Queue = {}, Lay = nil, Conns = {}, Beat = nil, Bound = false, Inited = false,
	Pending = false, PendToken = 0, PendFrom = nil, LastFire = -10, LastTap = -10,
	Warm = {}, Warned = {}, Menu = nil, Sfx = nil, Builder = nil, GQ = nil, Stars = nil, Dimmed = false,
}
-- the tweens of the phases (cancelled at the reveal) and of the overlay (the flash, the shock, the rays: they play on
-- over the reveal's start); both weak-keyed, both counted by Stats and cancelled by every teardown
S.Tweens = setmetatable({}, { __mode = "k" })
S.Overlay = setmetatable({}, { __mode = "k" })
EggStage._S = S
EggStage._InjectPhaseError = nil

local H = {} -- helpers
local L = {} -- layout
local B = {} -- builders
local R = {} -- the phase runner

----------------------------------------------------------------------
-- small helpers
----------------------------------------------------------------------
function H.warnOnce(key, err)
	local k = tostring(key) .. tostring(err)
	if not S.Warned[k] then
		S.Warned[k] = true
		warn("[EggStage] " .. tostring(key) .. ": " .. tostring(err))
	end
end

function H.safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		H.warnOnce(key, err)
	end
	return ok
end

function H.lazy(field, folder, name)
	if S[field] == nil then
		S[field] = false
		local module = folder and folder:FindFirstChild(name)
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				S[field] = mod
			end
		end
	end
	return S[field] or nil
end

function H.menu()
	return H.lazy("Menu", ClientFolder:FindFirstChild("Controllers"), "MenuController")
end

function H.toast(text)
	local mc = H.menu()
	if mc and type(mc.Hint) == "function" then
		pcall(mc.Hint, text, "info")
	end
end

-- one sound of the roll: an egg key without an id yet plays Config.Audio.Fallback[key] in its place (or nothing); the
-- Sound is remembered so a skip (and an exit before the reveal) can stop it
function H.sfx(name, scale)
	local sf = H.lazy("Sfx", ClientFolder, "SoundFx")
	if not sf or type(sf.Play) ~= "function" then
		return nil
	end
	local fallback = type(Config.Audio) == "table" and type(Config.Audio.Fallback) == "table" and Config.Audio.Fallback or {}
	if fallback[name] ~= nil then
		local okId, id = pcall(sf.Id, "Sfx", name)
		if not (okId and id) then
			name = fallback[name]
			if not name then
				return nil
			end
		end
	end
	local ok, snd = pcall(sf.Play, name, { Scale = scale })
	if ok and typeof(snd) == "Instance" then
		if S.Roll then
			S.Roll.Sounds[snd] = true
		end
		return snd
	end
	return nil
end

function H.stopSounds(roll)
	for snd in pairs(roll and roll.Sounds or {}) do
		pcall(function()
			snd:Stop()
		end)
	end
	if roll then
		roll.Sounds = {}
	end
end

-- High graphics (GraphicsQuality has Low and High): the blur, the tint, the turning rays and ring, the speed streaks
function H.high()
	local gq = H.lazy("GQ", ClientFolder, "GraphicsQuality")
	if not gq or type(gq.Effective) ~= "function" then
		return true
	end
	local ok, mode = pcall(gq.Effective)
	return not ok or mode ~= "Low"
end

function H.order(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return r.Order or 1
		end
	end
	return 1
end

function H.scaleFor(rarity)
	return H.order(rarity) >= K.LOUD_FROM and 1 or K.QUIET
end

function H.color(rarity)
	if rarity == "Secret" then
		return K.SECRET_TEXT
	end
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return r.Color
		end
	end
	return K.WHITE
end

function H.inMatch()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(Config.Attr.InMatch) == true
end

function H.roulette(id)
	if type(id) ~= "string" then
		return nil
	end
	for _, r in ipairs(Config.Roulettes or {}) do
		if r.Id == id then
			return r
		end
	end
	local s = Config.Gems and Config.Gems.SecretRoulette
	if s and s.Id == id then
		return s
	end
	return nil
end

-- the price of one spin in that currency (Config; the server checks it again)
function H.price(roulette, currency)
	if not roulette then
		return 0
	end
	if currency == "Gems" then
		local prices = Config.Gems and Config.Gems.RouletteGemPrices or {}
		return math.floor(tonumber(prices[roulette.Id]) or tonumber(roulette.GemPrice) or 0)
	end
	return math.floor(tonumber(roulette.Price) or 0)
end

function H.balance(currency)
	local fn = currency == "Gems" and State.Gems or State.Tokens
	local ok, n = pcall(fn)
	return (ok and type(n) == "number") and n or 0
end

function H.gemsOpen()
	return LocalPlayer ~= nil and LocalPlayer:GetAttribute(K.RESTRICTED_ATTR) == false
end

-- May a spin paid with `currency` be asked for this account? Gems: only once PolicyService said "allowed" (main's
-- lock). Tokens: the same answer while the Store is on (lobby-shop 16.12); while the Store is off (release step 1, the
-- owner's pick 2026-11-23: nothing sells Tokens) always, as on main. The server decides the same way (PetService).
function H.spinOpen(currency)
	if currency ~= "Gems" and not StoreCatalog.Enabled() then
		return true
	end
	return H.gemsOpen()
end

function H.remote(name)
	local ok, remote = pcall(Remotes.Get, name)
	return ok and remote or nil
end

-- the text's width (TextService: the real font). K.MEASURE(text, size, font) replaces it when set: tools/dump_gui.lua's
-- renders pass the renderer's font metrics (the mock's GetTextSize is a flat 0.5 em per character)
function H.textW(text, size, role)
	local font = Theme.Fonts[role] or Theme.Fonts.Body
	local ok, v = pcall(function()
		if type(K.MEASURE) == "function" then
			return Vector2.new(K.MEASURE(text, size, font), size)
		end
		return Theme.Measure(text, font, size, 100000)
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v.X
	end
	return #tostring(text) * size * 0.6
end

function H.tween(inst, seconds, goals, style, direction, overlay)
	if not inst or not inst.Parent then
		return nil
	end
	local info = TweenInfo.new(math.max(0.01, seconds), style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tw = TweenService:Create(inst, info, goals)
	if overlay then
		S.Overlay[tw] = true
	else
		S.Tweens[tw] = true
	end
	tw:Play()
	return tw
end

-- the phases' tweens; with all = true the overlay's too (a resize, an exit)
function H.cancelTweens(all)
	for _, set in ipairs(all and { S.Tweens, S.Overlay } or { S.Tweens }) do
		for tw in pairs(set) do
			pcall(function()
				tw:Cancel()
			end)
			set[tw] = nil
		end
	end
end

function H.frame(parent, name, props)
	props = props or {}
	props.Name = name
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Parent = parent
	return Util.Create("Frame", props)
end

function H.label(parent, name, text, role, size, props)
	local l = Theme.Label(text, role, { Size = size, Stroke = 0.2, Outline = 2 })
	l.Name = name
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

function H.corner(parent, r)
	return Util.Create("UICorner", { CornerRadius = (r and r < 1) and UDim.new(r, 0) or UDim.new(0, r or 12), Parent = parent })
end

function H.stroke(parent, color, thickness)
	return Util.Create("UIStroke", { Color = color, Thickness = thickness or 3, Transparency = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

function H.place(o, x, y, w, h)
	if o then
		o.Position = UDim2.fromOffset(x, y)
		if w then
			o.Size = UDim2.fromOffset(math.max(0, w), math.max(0, h))
		end
	end
end

-- (look review: whole px) a piece of the chrome (a kit block, a tag, a text row) on whole px: its corner floored, its
-- size rounded up (a tag never gets narrower than its words). The art and anything tweened keep H.place
function H.placeWhole(o, x, y, w, h)
	H.place(o, math.floor(x + 1e-6), math.floor(y + 1e-6), w and math.ceil(w - 1e-6), h and math.ceil(h - 1e-6))
end

-- (Task 26) EggArt.Resize: the size, the outline and every painted stroke (ring dots, swirls, the VFX rings) follow
function H.sizeEgg(egg, size)
	EggArt.Resize(egg, size)
end

function H.insets()
	local top, bottom = 58, 0
	pcall(function()
		local tl, br = GuiService:GetGuiInset()
		top, bottom = tl.Y, br.Y
	end)
	return top, bottom
end

function H.viewport()
	local cam = workspace.CurrentCamera
	local v = cam and cam.ViewportSize
	if v and v.X > 2 and v.Y > 2 then
		return v.X, v.Y
	end
	return 1280, 720
end

----------------------------------------------------------------------
-- public pure parts
----------------------------------------------------------------------
function EggStage.Timings(fast, spins)
	local t
	if fast then
		t = { Intro = 0.15, Strip = 0.8, Land = 0.12, Rise = 0.2, Crack = 0.4, Burst = 0.25 }
	else
		t = { Intro = 0.35, Strip = 3.0, Land = 0.35, Rise = 0.5, Crack = 1.2, Burst = 0.35 }
	end
	t.Stagger, t.LandGap = 0, 0
	local n = 1
	if (tonumber(spins) or 1) > 1 then
		n = 3
		t.Crack = fast and 0.4 or 0.9
		t.Stagger = fast and 0.25 or 0.6
		t.LandGap = fast and 0.12 or 0.25
	end
	t.RevealAt = t.Intro + t.Strip + (n - 1) * t.LandGap + t.Land + t.Rise + (n - 1) * t.Stagger + t.Crack + t.Burst
	return t
end

-- brief (an x3 column, review round 3): a duplicate's note leaves the pet's name out ("you have 12 now"); the name sits right
-- above it, and on a phone the long form wrapped to three lines in the column's 36 px box
function EggStage.NoteText(pull, rarity, brief)
	pull = type(pull) == "table" and pull or {}
	local def = type(pull.PetId) == "string" and PetCatalog.Get(pull.PetId) or nil
	rarity = rarity or (def and def.Rarity) or "?"
	local text
	local sub = type(pull.Substitute) == "table" and tonumber(pull.Substitute.Tokens) or nil
	if sub then
		text = "Stack full: +" .. Util.Commas(sub) .. " Tokens instead"
	else
		local tail
		if pull.IsNew == true then
			tail = "added to your pets"
		else
			local count = tonumber(pull.Count)
			if not count then
				local ok, n = pcall(State.OwnedCount, pull.Key or pull.PetId)
				count = (ok and type(n) == "number") and n or 1
			end
			local what = brief and "" or (" " .. (def and def.Name or "of them"))
			tail = "you have " .. math.floor(count) .. what .. " now"
		end
		local n = tonumber(pull.PoolSize)
		if n and n >= 1 then
			text = "1 of " .. math.floor(n) .. " " .. rarity .. (n == 1 and " pet " or " pets ") .. DOT .. " " .. tail
		else
			text = tail:sub(1, 1):upper() .. tail:sub(2)
		end
	end
	if pull.Pity == true then
		text = text .. " " .. DOT .. " guaranteed"
	end
	return text
end

function EggStage.Layout()
	local w, h = H.viewport()
	local top = H.insets()
	local ok, rect = pcall(NeonKit.BigRect, K.RECT, { Width = w, Height = h, Inset = top })
	if h > w then
		return "Portrait"
	end
	if ok and type(rect) == "table" and rect.mode == "Phone" then
		return "Phone"
	end
	return "PC"
end

----------------------------------------------------------------------
-- the roll (a normalized result)
----------------------------------------------------------------------
function H.stripRarities(strip, rarity)
	if type(strip) ~= "table" or #strip < K.WIN then
		return nil
	end
	local out = {}
	for i = 1, K.STRIP_LEN do
		local def = type(strip[i]) == "string" and PetCatalog.Get(strip[i]) or nil
		out[i] = (def and EggArt.Glow(def.Rarity) ~= nil and def.Rarity) or false
	end
	out[K.WIN] = rarity
	return out
end

function R.schedule(roll)
	local T = roll.T
	local n = roll.N
	local s = { IntroEnd = T.Intro, Land = {} }
	local t = T.Intro
	if roll.HasStrip then
		for j = 1, n do
			s.Land[j] = T.Intro + T.Strip + (j - 1) * T.LandGap
		end
		s.StripEnd = s.Land[n]
		s.LandEnd = s.StripEnd + T.Land
		t = s.LandEnd
	else
		s.StripEnd, s.LandEnd = t, t
	end
	s.RiseEnd = t + T.Rise
	s.CrackAt, s.BurstAt, s.OpenAt = {}, {}, {}
	for j = 1, n do
		s.CrackAt[j] = s.RiseEnd + (j - 1) * T.Stagger
		s.BurstAt[j] = s.CrackAt[j] + T.Crack
		s.OpenAt[j] = s.BurstAt[j] + T.Burst
	end
	s.RevealAt = s.OpenAt[n]
	return s
end

function H.makeRoll(result)
	if type(result) ~= "table" or result.Ok == false then
		return nil
	end
	local src = (type(result.Pulls) == "table" and #result.Pulls > 0) and result.Pulls or { result }
	local roulette = H.roulette(result.RouletteId)
	local pulls = {}
	for i = 1, math.min(3, #src) do
		local p = src[i]
		local def = type(p) == "table" and type(p.PetId) == "string" and PetCatalog.Get(p.PetId) or nil
		if def then
			local rarity = EggArt.Metrics.GLOW[def.Rarity] and def.Rarity or "Common"
			local pull = {
				Def = def, PetId = def.Id, Key = (type(p.Key) == "string" and p.Key ~= "") and p.Key or def.Id, Rarity = rarity,
				IsNew = p.IsNew == true, Count = tonumber(p.Count), PoolSize = tonumber(p.PoolSize),
				Pity = (p.Pity == true) or nil, Substitute = type(p.Substitute) == "table" and p.Substitute or nil,
			}
			if not pull.PoolSize and roulette then
				local n = #PetCatalog.RarityPool(roulette.Id, rarity)
				pull.PoolSize = n > 0 and n or nil
			end
			pull.Rarities = H.stripRarities(p.Strip, rarity)
			pulls[#pulls + 1] = pull
		end
	end
	if #pulls == 0 then
		return nil
	end
	local hasStrip = true
	local best = 1
	for j, p in ipairs(pulls) do
		if not p.Rarities then
			hasStrip = false
		end
		if H.order(p.Rarity) > H.order(pulls[best].Rarity) then
			best = j
		end
	end
	local currency = (result.Currency == "Gems") and "Gems" or "Tokens"
	if roulette and roulette.Id == K.SECRET_ID then
		currency = "Gems"
	end
	local fast = ClientSettings.Get("FastHatch") == true
	local roll = {
		Result = result, Pulls = pulls, N = #pulls, Roulette = roulette, Currency = currency, HasStrip = hasStrip, Fast = fast, Best = best,
		T = EggStage.Timings(fast, #pulls > 1 and 3 or 1), Strips = {}, Eggs = {}, Cols = {}, Views = {}, UI = {}, Phase = "Intro",
		Sounds = {}, Hi = H.high(), Tweaked = {},
	}
	roll.Sched = R.schedule(roll)
	return roll
end

----------------------------------------------------------------------
-- layout (design px in Content's own space; Content = the screen under the top bar at the UIScale "Fit")
----------------------------------------------------------------------
-- the bottom bar: { H, Items = { [name] = { x, y, w, h } } } for the roll (Skip, Fast hatch) or the reveal
function L.bar(cw, P, portrait, reveal, hasAgain, x3)
	local spec = P.Bar
	local gap = spec.Gap
	local avail = cw - 24
	local again = (x3 and spec.Again3) or spec.Again
	local items
	if reveal then
		items = { { "Skip", spec.SkipReveal } }
		if hasAgain then
			items[#items + 1] = { "SpinAgain", again }
		end
		items[#items + 1] = { "Done", spec.Done }
		items[#items + 1] = { "FastHatch", spec.Fast }
	else
		items = { { "Skip", spec.Skip }, { "FastHatch", spec.Fast } }
	end
	local out = { Items = {} }
	local function sum(list, k)
		local s = 0
		for _, it in ipairs(list) do
			s = s + it[2][k]
		end
		return s + gap * (#list - 1)
	end
	local function rowH(list)
		local h = 0
		for _, it in ipairs(list) do
			h = math.max(h, it[2][3])
		end
		return h
	end
	-- one row: widths between min and pref, packed and centred from x0
	local function packRow(list, y, h)
		local pref, least = sum(list, 1), sum(list, 2)
		local k = 1
		if pref > avail then
			k = (pref == least) and 0 or math.max(0, (avail - least) / (pref - least))
		end
		local total = 0
		local widths = {}
		for i, it in ipairs(list) do
			widths[i] = it[2][2] + (it[2][1] - it[2][2]) * k
			total = total + widths[i]
		end
		total = total + gap * (#list - 1)
		local x = (cw - total) / 2
		for i, it in ipairs(list) do
			out.Items[it[1]] = { x = x, y = y + (h - it[2][3]) / 2, w = widths[i], h = it[2][3] }
			x = x + widths[i] + gap
		end
	end
	local h = rowH(items)
	if sum(items, 1) <= avail then
		-- the anchored row: the roll's Skip centred, the reveal's SPIN AGAIN + DONE centred; Skip left, Fast hatch right
		local fast = spec.Fast[1]
		local fastX = cw - 12 - fast
		local okAnchored
		if reveal then
			local mainW = (hasAgain and (again[1] + gap) or 0) + spec.Done[1]
			local mainX = (cw - mainW) / 2
			okAnchored = 12 + spec.SkipReveal[1] + gap <= mainX and mainX + mainW + gap <= fastX
			if okAnchored then
				out.Items.Skip = { x = 12, y = (h - spec.SkipReveal[3]) / 2, w = spec.SkipReveal[1], h = spec.SkipReveal[3] }
				local x = mainX
				if hasAgain then
					out.Items.SpinAgain = { x = x, y = (h - again[3]) / 2, w = again[1], h = again[3] }
					x = x + again[1] + gap
				end
				out.Items.Done = { x = x, y = (h - spec.Done[3]) / 2, w = spec.Done[1], h = spec.Done[3] }
			end
		else
			local skipX = (cw - spec.Skip[1]) / 2
			okAnchored = skipX + spec.Skip[1] + gap <= fastX
			if okAnchored then
				out.Items.Skip = { x = skipX, y = (h - spec.Skip[3]) / 2, w = spec.Skip[1], h = spec.Skip[3] }
			end
		end
		if okAnchored then
			out.Items.FastHatch = { x = fastX, y = (h - spec.Fast[3]) / 2, w = fast, h = spec.Fast[3] }
		else
			packRow(items, 0, h)
		end
		out.H = h
	elseif sum(items, 2) <= avail and not portrait then
		packRow(items, 0, h)
		out.H = h
	else
		-- two rows: the main controls on top
		local top, low
		if reveal then
			top = {}
			if hasAgain then
				top[1] = items[2]
			end
			top[#top + 1] = { "Done", spec.Done }
			low = { { "Skip", spec.SkipReveal }, { "FastHatch", spec.Fast } }
		else
			top, low = { items[1] }, { items[2] }
		end
		local h1, h2 = rowH(top), rowH(low)
		packRow(top, 0, h1)
		packRow(low, h1 + 8, h2)
		out.H = h1 + 8 + h2
	end
	return out
end

-- (roll-look) a landscape phone's x1 reveal (side by side, its pills in the right column, L.reveal1Side): the bottom row
-- holds the two chips only, Skip at the left, Fast hatch at the right
function L.chipBar(cw, P)
	local spec = P.Bar
	local s, f = spec.SkipReveal, spec.Fast
	local h = math.max(s[3], f[3])
	return {
		H = h,
		Items = {
			Skip = { x = 12, y = (h - s[3]) / 2, w = s[1], h = s[3] },
			FastHatch = { x = cw - 12 - f[1], y = (h - f[3]) / 2, w = f[1], h = f[3] },
		},
	}
end

-- (review round 2) the roll's bar is the reveal's chip row: the Skip chip and the Fast hatch toggle sit exactly where the
-- reveal puts "Tap to close" and its Fast hatch (one row, bottom-anchored like the reveal's), so the finger that skipped
-- rests on the close chip or the Dim as the reveal appears, never on SPIN AGAIN or DONE (which also arm late: H.armed).
-- The owner's pitch drew the roll's SKIP in a bottom corner, clear of the centred SPIN AGAIN + DONE.
function L.rollBar(rev)
	local s, f = rev.Items.Skip, rev.Items.FastHatch
	if not (s and f) then
		return nil
	end
	local h = math.max(s.h, f.h)
	return {
		H = h,
		Items = {
			Skip = { x = s.x, y = (h - s.h) / 2, w = s.w, h = s.h },
			FastHatch = { x = f.x, y = (h - f.h) / 2, w = f.w, h = f.h },
		},
	}
end

-- the pixel kit's tier at the screen factor f: "Phone" (2 px unit) while round(3 x f) is 2, else "PC" (3 px)
function H.kitOf(f)
	return (3 * f < 2.5 - 1e-6) and "Phone" or "PC"
end

-- (U9-2b look review 2) K.PC at the screen factor f, every px number rounded (cached per f); the coin keeps the kit's
-- pixel coin (9 cells of the tier's unit: 30 / 20)
function H.pcTier(f)
	f = math.floor(f * 1000 + 0.5) / 1000
	if math.abs(f - 1) < 1e-3 then
		return K.PC
	end
	local key = tostring(f)
	if K.TIERS[key] then
		return K.TIERS[key]
	end
	local function scaled(t)
		local out = {}
		for k, v in pairs(t) do
			if type(v) == "table" then
				out[k] = scaled(v)
			elseif type(v) == "number" and v >= 1.5 then
				out[k] = math.floor(v * f + 0.5)
			else
				out[k] = v
			end
		end
		return out
	end
	local P = scaled(K.PC)
	P.Bar.Coin = H.kitOf(f) == "Phone" and K.PHONE.Bar.Coin or K.PC.Bar.Coin
	-- the bar's tap boxes even (a chip's block is centred in its box: an odd box put it on a half px), never under 44
	for k, v in pairs(P.Bar) do
		if type(v) == "table" and v[3] then
			v[3] = math.max(44, 2 * math.floor(K.PC.Bar[k][3] * f / 2 + 0.5))
		end
	end
	K.TIERS[key] = P
	return P
end

-- a PC number of the layout (design px at 1080p) at this screen's factor, rounded; a phone's stays
function H.px(lay, v)
	if lay and lay.PC and lay.F and math.abs(lay.F - 1) > 1e-3 then
		return math.floor(v * lay.F + 0.5)
	end
	return v
end

function L.compute(n, roll)
	local w, h = H.viewport()
	local top, bottom = H.insets()
	local mode = EggStage.Layout()
	local pc = mode == "PC"
	-- (U9-2b look review 2) no fractional Fit: the PC tier at this screen's factor, Fit 1 (a phone's table never scaled)
	local f = pc and Theme.ScreenFactor(h) or 1
	local P = pc and H.pcTier(f) or K.PHONE
	local scale = 1
	local cw, ch = w / scale, math.max(1, (h - top) / scale)
	local x3 = n > 1
	local lay = { Mode = mode, PC = pc, P = P, Scale = scale, F = f, Kit = pc and H.kitOf(f) or "Phone", W = cw, H = ch, Top = top, N = n, X3 = x3, Portrait = mode == "Portrait" }
	lay.Rim = H.px(lay, K.LOOK.TRACK.Rim)
	lay.Unit = lay.Kit == "Phone" and K.LOOK.PHONE.Card.Notch or K.LOOK.PC.Card.Notch
	local bm = (12 + bottom) / scale -- 12 screen px above the bottom inset at every scale
	local hasAgain = roll ~= nil and roll.Roulette ~= nil
	lay.HasAgain = hasAgain
	-- (roll-look) a landscape phone's x1 reveal stands side by side: its pills go to the right column, the bottom row
	-- keeps the two chips (L.reveal1Side places the pills)
	lay.Side = mode == "Phone" and not x3
	lay.BarReveal = lay.Side and L.chipBar(cw, P) or L.bar(cw, P, lay.Portrait, true, hasAgain, x3)
	lay.BarRoll = L.rollBar(lay.BarReveal) or L.bar(cw, P, lay.Portrait, false, hasAgain, x3)
	lay.BarRoll.Y = ch - bm - lay.BarRoll.H
	lay.BarReveal.Y = ch - bm - lay.BarReveal.H
	lay.Title = { Y = P.TitleY, H = P.TitleH, Size = P.TitleSize }
	local midTop, midBot = P.TitleY + P.TitleH, lay.BarRoll.Y
	local avail = midBot - midTop
	-- strips. (look review) the wood frame (Rim) counts as the strip's: Clear.Top px of sky under the title and
	-- Clear.Bottom above the chips; an x3's rails share their beams (Rim px of wood between two rails: one shelf, PC and
	-- phone alike); every size whole px, the rail, the cards and the track even (the landed card and its window centre
	-- on a whole px)
	local rim = lay.Rim
	local clear = K.LOOK.TRACK.Clear[pc and "PC" or "Phone"]
	local sTop = midTop + H.px(lay, clear.Top) + rim
	local sAvail = (midBot - H.px(lay, clear.Bottom) - rim) - sTop
	local spec = x3 and P.Strip3 or P.Strip1
	local nStrips = x3 and 3 or 1
	local s = Util.Clamp((sAvail - (nStrips - 1) * rim) / (nStrips * spec.H), 0.6, 1)
	local function even(v)
		return 2 * math.floor(v / 2 + 0.5)
	end
	local railH = even(spec.H * s)
	local step = math.floor(spec.Step * s + 0.5)
	local trackW = even(math.min(cw - 2 * P.Side, 10 * step))
	local total = nStrips * railH + (nStrips - 1) * rim
	local y0 = math.floor(sTop + math.max(0, (sAvail - total) / 2))
	lay.Strip = {
		S = s, Step = step, CellW = even(spec.CellW * s), CellH = even(spec.CellH * s), Egg = math.floor(spec.Egg * s + 0.5), Word = spec.Word,
		H = railH, W = trackW, X = math.floor((cw - trackW) / 2), Y = {},
	}
	for j = 1, nStrips do
		lay.Strip.Y[j] = y0 + (j - 1) * (railH + rim)
	end
	-- the crack: the word, the egg, its pedestal (1.1 x / 0.24 x the egg), centred in the middle. The gap above the egg
	-- keeps the room of its outline (a Border stroke, size / 20 outside its box) and of the push-in (Task 27: the egg grows
	-- to K.PUSH on its foot during the shakes), so the word stays clear at the push-in's peak
	local crack = x3 and P.Crack3 or P.Crack1
	local colW = x3 and math.min(P.Col3, (cw - 24) / 3) or cw
	local sE = Util.Clamp((avail - crack.Word - 6) / ((1.24 + (K.PUSH - 1) + 0.05) * crack.Egg), 0.6, 1)
	local E = crack.Egg * sE
	if x3 then
		E = math.min(E, (colW - 8) / 1.1)
	end
	E = math.floor(E)
	local gap = math.max(2, math.floor(E / 20 + 0.5)) + 4 + math.ceil((K.PUSH - 1) * E)
	local stackH = crack.Word + gap + E * 1.24
	-- (U9-2b look review 2) the egg's foot, the slab and the columns' centres on whole px
	local cTop = math.floor(midTop + (avail - stackH) / 2)
	lay.Crack = { E = E, WordY = cTop, WordH = crack.Word, EggY = cTop + crack.Word + gap, PedW = 1.1 * E, PedH = 0.24 * E, Cx = {} }
	for j = 1, (x3 and 3 or 1) do
		lay.Crack.Cx[j] = math.floor(x3 and (cw / 2 + (j - 2) * colW) or cw / 2)
	end
	-- the reveal
	if x3 then
		L.reveal3(lay, P, colW)
	elseif lay.Side then
		L.reveal1Side(lay, P)
	else
		L.reveal1(lay, P)
	end
	return lay
end

-- (roll-look, spec 16.15, the pitch's phoneA) a landscape phone's x1 reveal side by side: the pet (and its lip) centred in
-- the left PetCol of the screen; the right column's stack (the word band, the name row, the note, the two pills) centred
-- beside it; the pills are BottomBar's items placed up here (y relative to the bar), the chips stay on the bottom row
function L.reveal1Side(lay, P)
	local r = P.R1Side
	local bar = P.Bar
	local cw = lay.W
	local col = { X = 0, Y = 0, W = cw, H = lay.H }
	local leftW = math.floor(r.PetCol * cw)
	local midTop, midBot = 2, lay.BarReveal.Y - 2
	local avail = midBot - midTop
	local pet = math.floor(Util.Clamp(math.min(r.Pet, leftW - 24, avail - 20), r.PetMin, r.Pet))
	local petY = midTop + math.max(0, (avail - pet) / 2)
	col.Pet = { X = (leftW - pet) / 2, Y = petY, S = pet }
	col.Ped = { X = col.Pet.X + (pet - K.LIP.W * pet) / 2, Y = petY + H.feet(pet), W = K.LIP.W * pet, H = K.LIP.H }
	local rx = leftW + r.Gap
	local rw = cw - rx - 12
	local items = {}
	if lay.HasAgain then
		items[1] = { "SpinAgain", bar.Again }
	end
	items[#items + 1] = { "Done", bar.Done }
	local pillH = 0
	for _, it in ipairs(items) do
		pillH = math.max(pillH, it[2][3])
	end
	local stack = r.WordRow + r.Gap + r.NameH + r.NoteGap + r.NoteH + r.PillGap + pillH
	local top = midTop + math.max(0, (avail - stack) / 2)
	col.Banner = { CX = rx + rw / 2, Y = top + (r.WordRow - r.BannerH) / 2, H = r.BannerH, Word = r.Word, WordMin = r.WordMin, Min = 0, Pad = r.BannerPad, MaxW = rw }
	col.NameX, col.NameW = rx, rw
	col.NameY, col.NameH, col.NameSize = top + r.WordRow + r.Gap, r.NameH, r.Name
	col.NoteY, col.NoteH, col.NoteSize = col.NameY + r.NameH + r.NoteGap, r.NoteH, r.Note
	col.New = { W = r.NewW, H = r.NewH, Size = r.New }
	-- the pills: preferred widths, down to their least when the column is narrow, centred under the note
	local pref, least = bar.Gap * (#items - 1), bar.Gap * (#items - 1)
	for _, it in ipairs(items) do
		pref, least = pref + it[2][1], least + it[2][2]
	end
	local k = (pref <= rw or pref == least) and 1 or math.max(0, (rw - least) / (pref - least))
	local x = rx + (rw - (least + (pref - least) * k)) / 2
	local py = col.NoteY + r.NoteH + r.PillGap
	for _, it in ipairs(items) do
		local w = it[2][2] + (it[2][1] - it[2][2]) * k
		lay.BarReveal.Items[it[1]] = { x = x, y = py + (pillH - it[2][3]) / 2 - lay.BarReveal.Y, w = w, h = it[2][3] }
		x = x + w + bar.Gap
	end
	lay.Cols = { col }
end

-- x1 reveal: the Banner as the title band, then pet (+ pedestal or lip), name, note centred above the bottom bar
function L.reveal1(lay, P)
	local r = P.R1
	local cw = lay.W
	local col = { X = 0, Y = 0, W = cw, H = lay.H }
	local midTop = r.BannerY + r.BannerH + r.Gap
	-- (look review) PC keeps BarGap design px between the note and the planks (16 real px at 1280x720: the pet gives the
	-- room first, down to PetMin)
	local midBot = lay.BarReveal.Y - math.max(r.Gap, r.BarGap or 0)
	local noteH = (lay.Portrait and r.NoteH2) or r.NoteH
	local fixed = r.NameGap + r.NameH + r.NoteGap + noteH
	local pedK = r.Lip and 0 or r.Ped
	local pet = math.floor(Util.Clamp((midBot - midTop - fixed) / (1 + pedK), r.PetMin, r.Pet))
	local stack = pet * (1 + pedK) + fixed
	local top = midTop + math.max(0, (midBot - midTop - stack) / 2)
	local bannerY = r.BannerY
	if lay.Portrait and r.PetPortrait then
		-- (U9-2b look review 2) a portrait x1: the pet min(PetPortrait, width - PortraitSide) (170 px on a 786 px stage left
		-- 195 px gaps above and below it), the word PortraitGap above it: word, pet, name and note one centred group
		local room = midBot - r.BannerY - r.BannerH - r.PortraitGap - fixed
		pet = math.floor(math.max(r.PetMin, math.min(r.PetPortrait, cw - r.PortraitSide, room)))
		local groupH = r.BannerH + r.PortraitGap + pet + fixed
		bannerY = math.floor(r.BannerY + math.max(0, (midBot - r.BannerY - groupH) / 2))
		top = bannerY + r.BannerH + r.PortraitGap
	end
	col.Banner = { Y = bannerY, H = r.BannerH, Word = r.Word, Min = r.BannerMin, Pad = r.BannerPad }
	col.Pet = { X = (cw - pet) / 2, Y = top, S = pet }
	col.NameY = top + pet * (1 + pedK) + r.NameGap
	col.NameH, col.NameSize = r.NameH, r.Name
	col.NoteY, col.NoteH, col.NoteSize = col.NameY + r.NameH + r.NoteGap, noteH, r.Note
	col.New = { W = r.NewW, H = r.NewH, Size = r.New }
	if r.Lip then
		col.Ped = { X = (cw - K.LIP.W * pet) / 2, Y = top + H.feet(pet), W = K.LIP.W * pet, H = K.LIP.H }
	else
		col.Ped = { X = (cw - pet) / 2, Y = top + pet, W = pet, H = pet * r.Ped }
		L.standOnPlinth(col)
	end
	lay.Cols = { col }
end

-- (review round 1) no bowl (the pick's Baseline: "the pet stands on a platform, and the shell flies away at the
-- burst"): on a plinth (PC) the pet frame comes down until its feet line (K.LOOK.PET_FOOT of the frame) is the plinth's
-- centre line, the box's top where the disc's middle is. The rows under it keep their places (the frame only reaches
-- into the plinth's box). A phone's lip is placed on the feet line (H.feet)
function L.standOnPlinth(col)
	col.Pet.Y = col.Pet.Y + (1 - K.LOOK.PET_FOOT) * col.Pet.S
end

-- x3 reveal: three columns (PC / phone landscape) or three rows (portrait)
function L.reveal3(lay, P, colW)
	local r = P.R3
	local cw = lay.W
	local cols = {}
	if lay.Portrait then
		-- (U9-2b look review 2) the three rows share the whole height above the planks (no RowMax cap: 208 px of empty road
		-- under them at 390x844), each pet RowPet
		local barY = lay.BarReveal.Y
		local rowH = math.floor((barY - 20) / 3)
		local rowW = cw - 24
		for j = 1, 3 do
			local pet = math.min(r.RowPet, rowH - 8)
			local col = { X = 12, Y = 2 + (j - 1) * (rowH + 8), W = rowW, H = rowH, Row = true }
			col.Pet = { X = 0, Y = (rowH - pet) / 2, S = pet }
			local rx = pet + 12
			local stack = r.BannerH + 4 + r.NameH + 4 + r.NoteH
			local ty = math.max(0, (rowH - stack) / 2)
			col.Banner = { X = rx, Y = ty, H = r.BannerH, Word = r.Word, Min = r.BannerMin, Pad = r.BannerPad, MaxW = rowW - rx, Left = true }
			col.NameX, col.NameW = rx, rowW - rx
			col.NameY, col.NameH, col.NameSize = ty + r.BannerH + 4, r.NameH, r.Name
			col.NoteY, col.NoteH, col.NoteSize = col.NameY + r.NameH + 4, r.NoteH, r.Note
			-- (U9-2b look review 2) NEW! after the name while the row holds both, else on the pet frame's corner (H.applyReveal
			-- measures); the evolved tag on the word's line
			col.New = { W = r.NewW, H = r.NewH, Size = r.New, Corner = "Fit" }
			col.Ped = { X = col.X + (pet - K.LIP.W * pet) / 2, Y = col.Y + col.Pet.Y + H.feet(pet), W = K.LIP.W * pet, H = K.LIP.H }
			cols[j] = col
		end
		lay.Cols = cols
		return
	end
	local colY = lay.PC and H.px(lay, 20) or 2
	-- (look review) PC: the x1's BarGap between the notes and the planks
	local colH = lay.BarReveal.Y - (lay.PC and P.R1.BarGap or 2) - colY
	for j = 1, 3 do
		local col = { X = cw / 2 - 1.5 * colW + (j - 1) * colW, Y = colY, W = colW, H = colH }
		local midTop = r.BannerH + r.Gap
		local fixed = r.NameGap + r.NameH + r.NoteGap + r.NoteH
		local pedK = r.Lip and 0 or r.PedH
		local pet = math.floor(Util.Clamp((colH - midTop - fixed) / (1 + pedK), r.PetMin, math.min(r.Pet, colW - 8)))
		local stack = pet * (1 + pedK) + fixed
		local top = midTop + math.max(0, (colH - midTop - stack) / 2)
		col.Banner = { Y = 0, H = r.BannerH, Word = r.Word, Min = r.BannerMin, Pad = r.BannerPad, MaxW = colW - 8 }
		col.Pet = { X = (colW - pet) / 2, Y = top, S = pet }
		col.NameY, col.NameH, col.NameSize = top + pet * (1 + pedK) + r.NameGap, r.NameH, r.Name
		col.NoteY, col.NoteH, col.NoteSize = col.NameY + r.NameH + r.NoteGap, r.NoteH, r.Note
		-- (review round 3) on a phone NEW! leaves the 18 px name's row for the pet frame's corner: beside it the name had
		-- column - 24 - 64 px (117 at 640x360, 172 at 844x390) and Legendary to Secret names were cut. PC keeps the pitch's row
		col.New = { W = r.NewW, H = r.NewH, Size = r.New, Corner = (not lay.PC) and "Fit" or false }
		if r.Lip then
			col.Ped = { X = col.X + (colW - K.LIP.W * pet) / 2, Y = colY + top + H.feet(pet), W = K.LIP.W * pet, H = K.LIP.H }
		else
			col.Ped = { X = col.X + (colW - r.PedW * pet) / 2, Y = colY + top + pet, W = r.PedW * pet, H = r.PedH * pet }
			L.standOnPlinth(col)
		end
		cols[j] = col
	end
	lay.Cols = cols
end

----------------------------------------------------------------------
-- building
----------------------------------------------------------------------
function B.gui()
	if S.Gui and S.Gui.Parent then
		return true
	end
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not pg then
		return false
	end
	local old = pg:FindFirstChild(K.GUI)
	if old then
		old:Destroy()
	end
	local gui = Util.Create("ScreenGui", { Name = K.GUI, DisplayOrder = K.ORDER, IgnoreGuiInset = true, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	-- (roll-look) anchored at its centre (review round 1: the burst's punch now scales only the roll's Hero and Burst, B.roll)
	local stage = H.frame(gui, "Stage", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) })
	S.Dim = Util.Create("TextButton", {
		Name = "Dim", Text = "", AutoButtonColor = false, BorderSizePixel = 0, BackgroundColor3 = K.NAVY, BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = stage,
	})
	S.Dim.Activated:Connect(function()
		H.safe("tap", H.tap)
	end)
	local vig = H.frame(stage, "Vignette", { Size = UDim2.fromScale(1, 1), ZIndex = 2 })
	-- (kit-b U9-2b) attribute Art = "Hatch": the stage's art (the vignette, the flash, the spot, the backlights, the
	-- plinths, the halves, the FX), soft on purpose; the kit B walks check only the chrome around it
	vig:SetAttribute("Art", "Hatch")
	for _, e in ipairs({ { "Top", 0, 0, 1, 0.14, 90 }, { "Bottom", 0, 0.86, 1, 0.14, 270 }, { "Left", 0, 0, 0.1, 1, 0 }, { "Right", 0.9, 0, 0.1, 1, 180 } }) do
		local edge = H.frame(vig, e[1], { Position = UDim2.fromScale(e[2], e[3]), Size = UDim2.fromScale(e[4], e[5]), BackgroundColor3 = K.NAVY, BackgroundTransparency = 1, ZIndex = 2 })
		Util.Create("UIGradient", { Rotation = e[6], Transparency = NumberSequence.new(0, 1), Parent = edge })
	end
	S.Content = H.frame(stage, "Content", { ZIndex = 3 })
	S.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = S.Content })
	S.Flash = H.frame(stage, "Flash", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.WHITE, BackgroundTransparency = 1, ZIndex = 4 })
	S.Flash:SetAttribute("Art", "Hatch")
	S.Gui, S.Stage, S.Vignette = gui, stage, vig
	gui.Parent = pg
	return true
end

-- the roll's own content (rebuilt per roll): Title, Strips, Hero, Burst, Reveal, BottomBar
function B.roll(roll)
	local c = S.Content
	local P = S.Lay.P
	local title = (roll.Roulette and roll.Roulette.DisplayName) or "Hatching"
	if roll.N > 1 then
		title = title .. " x3"
	end
	roll.UI.Title = Theme.StyleTitle(H.label(c, "Title", title, "Title", P.TitleSize, { ZIndex = 5, TextXAlignment = Enum.TextXAlignment.Center }), "Section") -- (kit-b prep) the hatch cutscene is not a window: no ribbon
	roll.UI.Strips = H.frame(c, "Strips", { Size = UDim2.fromScale(1, 1), ZIndex = 1 })
	-- (roll-look review round 1) the burst's punch scales the stage's world only: Hero (the eggs, plinths, rays, ring, the
	-- crack word) carries the UIScale "Punch" and Burst (the shock, the sparks) follows it; both anchored at their centre
	-- (their children keep their places at scale 1). The title, the chips, the Dim and the vignette never move or clip
	local mid = { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1) }
	mid.ZIndex = 2
	roll.UI.Hero = H.frame(c, "Hero", mid)
	S.Punch = Util.Create("UIScale", { Name = "Punch", Scale = 1, Parent = roll.UI.Hero })
	local burst = H.frame(c, "Burst", { AnchorPoint = mid.AnchorPoint, Position = mid.Position, Size = mid.Size, ZIndex = 3 })
	roll.UI.Burst = burst
	local follow = Util.Create("UIScale", { Name = "Punch", Scale = 1, Parent = burst })
	local punch = S.Punch
	punch:GetPropertyChangedSignal("Scale"):Connect(function()
		follow.Scale = punch.Scale
	end)
	-- (Task 27) the effects: the shock ring and the spark pool over the hero, the rays behind it (in Hero); the overlay
	-- tweens play on over the reveal's start. The pool is stepped by the phase runner (one Heartbeat in all). (review round
	-- 1) the hatch_rays / hatch_sparkle images when they have ids (HatchLook.IMAGES), else the frame fallbacks
	local best = roll.Pulls[roll.Best].Rarity
	roll.Shock = HatchFx.Shock(burst, best, { ZIndex = 3, Track = S.Overlay, Unit = S.Lay.Unit })
	roll.Rays = HatchFx.Rays(roll.UI.Hero, best, { ZIndex = 2, Track = S.Overlay, Image = HatchLook.Image(HatchLook.IMAGES.Rays) })
	roll.Pool = HatchFx.Pool(burst, K.POOL, 4, { Image = HatchLook.Image(HatchLook.IMAGES.Sparkle) })
	roll.Pool:Drive()
	roll.UI.Reveal = H.frame(c, "Reveal", { Size = UDim2.fromScale(1, 1), ZIndex = 4, Visible = false })
	-- (review round 1, spec 16.15 "Sizes") the crack word: one label dressed like the reveal word (the gradient and the
	-- outline of its rarity, HatchLook.Word without letters), re-coloured as an x3's word moves on (R.word)
	roll.CrackWord = HatchLook.Word(roll.UI.Hero, "", best, S.Lay.Crack.WordH, { Letters = false, Name = "CrackWord", ZIndex = 8 })
	roll.UI.Crack = roll.CrackWord.Frame
	roll.UI.Crack.Visible = false
	if roll.HasStrip then
		for j = 1, roll.N do
			B.strip(roll, j)
		end
	end
	B.bar(roll)
end

function B.strip(roll, j)
	local st = { Cells = {}, Landed = false, Tick = nil }
	local tk = K.LOOK.TRACK
	local geo = H.cardGeo(S.Lay)
	st.Frame = H.frame(roll.UI.Strips, "Strip" .. j, { ZIndex = 1 })
	-- (kit-b U9-2b) the track: the kit's navy rail, flat and square, in its wood frame (Outer, Rim px round it); (look
	-- review) its ends a flat navy-lip line each (EndL / EndR, no fade): the cards slide into a slot
	st.Outer = H.frame(st.Frame, "Outer", { BackgroundColor3 = tk.Outer, BackgroundTransparency = 0, ZIndex = 0 })
	-- (U9-2b look review 2) a nail pixel (one unit of Sign.WoodDark) in each corner of the wood frame; an x3's lower rails
	-- skip their top pair (the beam above is the rail above's bottom one: one nail per crossing). H.applyStrips places them
	for i = 1, 4 do
		if j == 1 or i > 2 then
			H.frame(st.Outer, "Nail" .. i, { BackgroundColor3 = Theme.Sign.WoodDark, BackgroundTransparency = 0, ZIndex = 0 })
		end
	end
	st.Track = Util.Create("ScrollingFrame", {
		Name = "Track", BorderSizePixel = 0, BackgroundColor3 = tk.Rail, BackgroundTransparency = 0, ClipsDescendants = true, Active = false,
		ScrollingEnabled = false, ScrollBarThickness = 0, CanvasSize = UDim2.new(0, 0, 0, 0), Size = UDim2.fromScale(1, 1), ZIndex = 1, Parent = st.Frame,
	})
	st.EndL, st.EndR = HatchLook.TrackEnds(st.Track)
	-- the gold winner window (its root keeps the name Pointer) and the dims beside it
	st.Pointer = H.frame(st.Frame, "Pointer", { ZIndex = 3 })
	st.Win = HatchLook.Window(st.Frame, st.Pointer, { Phone = S.Lay.Kit == "Phone", Gold = K.GOLD, Stroke = geo.Win, Notch = geo.Notch, Track = S.Tweens })
	if roll.Hi then
		-- (Task 27) soft speed streaks over the glass at full speed (High only; placed each frame inside the track)
		st.Streaks = H.frame(st.Frame, "Streaks", { Size = UDim2.fromScale(1, 1), ZIndex = 2 })
		st.Streaks:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) motion streaks: the stage's art
		st.StreakBars = {}
		local fade = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.25), NumberSequenceKeypoint.new(1, 1) })
		for i = 1, 4 do
			local bar = H.frame(st.Streaks, "Streak" .. i, { BackgroundColor3 = K.WHITE, BackgroundTransparency = 1, ZIndex = 2 })
			Util.Create("UIGradient", { Transparency = fade, Parent = bar })
			st.StreakBars[i] = bar
		end
	end
	roll.Strips[j] = st
end

-- (re)builds the 12 recycled cells of a strip at the layout's cell size
function B.cells(roll, j)
	local st = roll.Strips[j]
	local g = S.Lay.Strip
	for _, cell in pairs(st.Cells) do
		HatchLook.DropCard(cell.Card)
	end
	st.Cells = {}
	st.Geo = g
	local geo = H.cardGeo(S.Lay)
	-- (roll-look) as many recycled cells as can intersect the track at once (floor(W / Step) + 2, at most 12): the dressed
	-- cards cost more, and an x3 strip of 12 went past 750 instances
	st.Slots = math.min(K.MAX_CELLS, math.floor(g.W / g.Step) + 2)
	-- (egg-cards, spec 16.18) the card egg is the Blender egg's picture when all seven rarities have an image id
	-- (HatchLook.EggPictures), else the painted egg: a cell holds one or the other, never both (review round 1: a one-id x3
	-- with both peaked at 766 > 750 at the rise)
	local pics = HatchLook.EggPictures()
	local side = math.floor(g.Egg / HatchLook.Metrics.EGG_PIC.Fill + 0.5)
	for slot = 1, st.Slots do
		local f = H.frame(st.Track, "Cell" .. slot, { Size = UDim2.fromOffset(g.CellW, g.CellH), BackgroundColor3 = Theme.Sign.Tile, BackgroundTransparency = 0, Visible = false, ZIndex = 2 })
		local stroke = H.stroke(f, Theme.Sign.Wood, geo.Edge)
		-- (kit-b U9-2b) the card: a stone block in its mitred wood edge; its plate along the bottom in the rarity's colour
		-- holding the word; (look review) an x3 card on PC the same card (the plate, not a 5 px lip under a loose word: one
		-- card family), a phone's x3 lite (the rarity on its lip, no word: <= 16 instances a cell)
		local card = HatchLook.Card(f, {
			W = g.CellW, H = g.CellH, Edge = geo.Edge, Plate = geo.Plate, Word = g.Word, Lite = roll.N > 1 and not S.Lay.PC, Phone = S.Lay.Kit == "Phone",
		})
		-- (Task 26) a lean egg: no rim light and <= 9 instances (spec 16.15: <= 20 per x1 cell, the card included)
		local egg = nil
		if not pics then
			egg = EggArt.New(f, "Common", g.Egg, { Form = g.Egg < 48 and "Simple" or "Medium", ZIndex = 3, Rim = false, Budget = 9 })
			egg.AnchorPoint = Vector2.new(0.5, 0)
		end
		local word = card.PlateText
		local eggTop
		if word then
			-- the egg stands in the room above the plate, a little low (its top keeps clear of the shine line); whole px
			local plateY = card.Plate.Position.Y.Offset
			eggTop = math.floor(math.max(g.CellH * 0.06, (plateY - g.Egg) * 0.55))
		else
			-- (a phone's lite x3 card: no word, the rarity's colour on its lip)
			eggTop = math.floor((g.CellH - g.Egg) / 2)
		end
		if egg then
			egg.Position = UDim2.fromOffset(g.CellW / 2, eggTop)
		end
		-- (egg-cards) the picture: a square of egg px / Fill centred on the painted egg's box, so its egg is the same height
		local pic = nil
		if pics then
			pic = Util.Create("ImageLabel", {
				Name = "EggPic", Image = "", BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
				AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(g.CellW / 2, eggTop + g.Egg / 2), Size = UDim2.fromOffset(side, side),
				ZIndex = 3, Visible = false, Parent = f,
			})
		end
		st.Cells[slot] = { Frame = f, Stroke = stroke, Egg = egg, Pic = pic, Word = word, Index = nil, Card = card, OnPlate = word ~= nil and word == card.PlateText }
	end
end

-- (roll-look) the card and window sizes of this layout: the PC / phone table at the 1080p x1 strip, scaled with the cells
-- when they are smaller (x3, a shrunk strip); the plate never gets shorter than its word; an x3 phone's strips sit 6 px
-- apart, so their windows go without notches. (kit-b U9-2b) a card's wood edge stays 2 px at the least
function H.cardGeo(lay)
	-- (U9-2b look review 2) the plate, pad and window of a PC at its screen factor; the edge and the notch the kit tier's
	local pcBase, kit = K.LOOK.PC.Card, lay.Kit == "Phone" and K.LOOK.PHONE.Card or K.LOOK.PC.Card
	local base = lay.PC and {
		Edge = kit.Edge, Notch = kit.Notch, Plate = H.px(lay, pcBase.Plate), Win = H.px(lay, pcBase.Win), Pad = H.px(lay, pcBase.Pad),
	} or K.LOOK.PHONE.Card
	local g = lay.Strip
	local k = math.min(1, g.CellH / lay.P.Strip1.CellH)
	local function px(v)
		return math.max(1, math.floor(v * k + 0.5))
	end
	-- (look review) an x3 card on PC holds the x1 card's plate (its word + 12 px, the rarity's readable colour); the
	-- notch's pixel unit stays the screen's (one pixel size per screen: never scaled)
	local plate = math.max(px(base.Plate), (g.Word or 0) + 6)
	if lay.X3 and lay.PC then
		plate = (g.Word or 0) + 12
	end
	local geo = {
		Edge = math.max(2, px(base.Edge)), Plate = plate, Pad = px(base.Pad),
		Win = math.max(2, math.floor(base.Win * math.max(k, 0.6) + 0.5)),
		Notch = (lay.X3 and not lay.PC) and 0 or base.Notch,
	}
	return geo
end

-- the cell showing the winner (strip index K.WIN) once the strip has landed
function H.landedCell(st)
	for _, cell in pairs(st.Cells) do
		if cell.Index == K.WIN then
			return cell
		end
	end
	return nil
end

function B.bar(roll)
	local P = S.Lay.P
	local phone = S.Lay.Kit == "Phone" -- (U9-2b look review 2) the kit's pixel tier: a 720p PC's chips are the phone's
	local bar = H.frame(S.Content, "BottomBar", { ZIndex = 6 })
	roll.UI.Bar = bar
	-- (roll-look, spec 16.15) the small chips (a 44 px tap box drawing a 36 / 32 px pill) and the glossy pills (HatchLook)
	roll.UI.Skip = HatchLook.Chip(bar, { Name = "Skip", Text = "", TextSize = P.Bar.ChipText, Phone = phone, ZIndex = 6 })
	roll.UI.Skip.Activated:Connect(function()
		H.safe("tap", H.tap)
	end)
	-- (review round 2) DONE and SPIN AGAIN read Activated themselves: a tap on them while they are not armed still counts
	-- as a tap and restarts the wait (H.press). (kit-b U9-2b) kit B planks in sentence case: Done the stage's one green
	-- action; (look review) Spin again the Shop's Spin plank: stone, the coin and the price inline (gold means selected)
	roll.UI.Done = HatchLook.Pill(bar, { Name = "Done", Kind = "Green", Text = "Done", TextSize = P.Bar.Text, Phone = phone, ZIndex = 6 })
	roll.UI.Done.Activated:Connect(function()
		H.safe("done", H.doneTap)
	end)
	local again = HatchLook.Pill(bar, { Name = "SpinAgain", Kind = "Stone", Text = "Spin again", TextSize = P.Bar.Text, Price = true, Coin = P.Bar.Coin, Phone = phone, ZIndex = 6 })
	again.Activated:Connect(function()
		H.safe("again", H.againTap)
	end)
	local parts = HatchLook.PillParts(again)
	local z = parts.Coin.ZIndex
	if roll.Currency == "Gems" then
		local gem = GemIcon.New(parts.Coin, P.Bar.Coin, { ZIndex = z })
		gem.Position = UDim2.fromOffset(0, 0)
	else
		-- the token coin: a PixelIcon at 0.9 x the coin (27 px on a PC, 18 on a phone: the kit's Glyph size, whole cells)
		-- as the Shop's Spin draws it (Pitch 2 item 9 B: the carved token in its own colours; the plank's paint greys it when
		-- disabled). (look review: whole px) its host is
		-- the coin's own box at 0, 0 (not 1.25 x the coin centred by scale: a half px), PixelIcon.Host centres it by floor
		local icon = NeonKit.Icon(parts.Coin, "Tokens", P.Bar.Coin)
		icon.ZIndex = z
		icon.AnchorPoint = Vector2.new(0, 0)
		icon.Position = UDim2.fromOffset(0, 0)
		icon.Size = UDim2.fromOffset(P.Bar.Coin, P.Bar.Coin) -- (HatchLook.SizePill keeps it the coin's box on a resize)
		HatchLook.PillState(again, "Rest")
	end
	roll.UI.Again, roll.UI.AgainLabel, roll.UI.AgainCoin, roll.UI.AgainPrice = again, parts.Label, parts.Coin, parts.Price
	-- the pills' rise (spec 16.15 "Pills"): one NumberValue tweened 0 -> 1 drives both (H.pillsIn)
	roll.UI.Pills = { again, roll.UI.Done }
	roll.UI.PillParts = { parts, HatchLook.PillParts(roll.UI.Done) }
	roll.UI.Rise = {}
	local pillsIn = Util.Create("NumberValue", { Name = "PillsIn", Value = 1, Parent = bar })
	roll.PillsIn = pillsIn
	pillsIn:GetPropertyChangedSignal("Value"):Connect(function()
		H.pillsIn(roll, pillsIn.Value)
	end)
	-- the Fast hatch chip (ClientSettings FastHatch: the profile, every device)
	local fast = HatchLook.FastChip(bar, { Name = "FastHatch", TextSize = P.Bar.FastText, Phone = phone, ZIndex = 6 })
	fast.Activated:Connect(function()
		H.safe("fast", function()
			ClientSettings.Set("FastHatch", ClientSettings.Get("FastHatch") ~= true)
		end)
	end)
	roll.UI.Fast = fast
	H.paintFast(roll)
end

function H.paintFast(roll)
	local fast = roll and roll.UI.Fast
	if fast and fast.Parent then
		HatchLook.SetFast(fast, ClientSettings.Get("FastHatch") == true)
	end
end

-- (roll-look) the pills' rise at k (0 = low and clear .. 1 = in place); H.applyBar keeps each pill's rise on the screen
function H.pillsIn(roll, k)
	roll.PillK = k
	for i, btn in ipairs(roll.UI.Pills or {}) do
		if btn.Parent then
			HatchLook.PillIn(roll.UI.PillParts[i], k, roll.UI.Rise[btn.Name] or 0)
		end
	end
end

-- the reveal columns (one per pull, in the server's order)
function B.cols(roll)
	local reveal = roll.UI.Reveal
	local lay = S.Lay
	local brief = #roll.Pulls > 1 -- (review round 3) an x3 column's note leaves the name out: it sits right above
	for j, pull in ipairs(roll.Pulls) do
		local col = H.frame(reveal, "Col" .. j, { ZIndex = 4 })
		-- (roll-look, spec 16.15 "Reveal word") the Banner is the word's box (no plate, no border): the rarity word as
		-- letters (gradient, outline, glow) popping in turn; an x3 phone column keeps one label
		local banner = H.frame(col, "Banner", { ZIndex = 5 })
		local g = lay.Cols[j]
		local word = HatchLook.Word(banner, string.upper(pull.Rarity) .. "!", pull.Rarity, g and g.Banner.Word or 22, {
			Letters = lay.PC or roll.N == 1, ZIndex = 6, Measure = H.titleW,
		})
		-- (U9-2b look review 2, the owner's look bar: no soft round shapes) no violet aura behind a Secret pet: its starry
		-- backdrop and confetti stay. (review round 1) no Shell: the pet stands on the slab (or the phone's lip) on a flat
		-- contact shadow inside its frame under the model (it pops with the pet): two stepped rows (Row1 the wider, on the
		-- feet line; Row2 two units in on each side above it) in Sign.NavyLip at PET_SHADOW.A, placed in px (H.placeShadow)
		local pet = H.frame(col, "Pet", { ZIndex = 5 })
		local pop = Util.Create("UIScale", { Name = "Pop", Scale = 0, Parent = pet })
		local shadow = H.frame(pet, "Shadow", { ZIndex = 4 })
		for r = 1, 2 do
			H.frame(shadow, "Row" .. r, { BackgroundColor3 = Theme.Sign.NavyLip, BackgroundTransparency = K.LOOK.PET_SHADOW.A, ZIndex = 4 })
		end
		local stage = 0
		local okStage, st = pcall(PetBits.stage, pull.Key)
		if okStage and type(st) == "number" then
			stage = st
		end
		local view = CloudUI.PetViewport(pet, pull.Def, UDim2.fromScale(1, 1), {
			Spin = "spin", Excited = 1, Flap = 1.5, ZIndex = 5, Evolved = stage >= 1 and stage or nil, Detail = stage >= 1 and "Low" or nil,
		})
		roll.Views[#roll.Views + 1] = view
		local vf = view and view.Frame
		if vf and not vf:IsA("ViewportFrame") then
			vf = vf:FindFirstChildWhichIsA("ViewportFrame", true)
		end
		-- (U9-2b look review 2, the pitch's kit B rule: labels stop floating and become signs) the nameplate: the name and the
		-- note on one navy sign plank (the kit's navy sign: Sign.Navy, the GoldLip edge, the rarity on its lip), the name in
		-- the kit's gold and the note in stone, no outline or stroke on the plank (H.applyReveal sizes it round them)
		local plate = H.frame(col, "Plate", { BackgroundTransparency = 0, ZIndex = 4 })
		CloudUI.SignBlock(plate, "Navy", { EdgePx = 2, LipPx = lay.Kit == "Phone" and K.LOOK.PLATE.LipPhone or K.LOOK.PLATE.Lip, LipColor = HatchLook.RarityColor(pull.Rarity), Pad = false, Finish = false })
		local name = Theme.Label(pull.Def.Name, "Display", { Size = 18 })
		name.Name, name.ZIndex, name.TextColor3, name.TextTruncate, name.Parent = "Name", 5, Theme.Sign.Gold, Enum.TextTruncate.AtEnd, col
		-- (ZIndex 6 / 7 like the EvolvedRibbon: on a phone's x3 it sits on the pet frame's corner, over the pet's view)
		-- (roll-look) NEW! pops in at the chain's SIL + 0.4; (kit-b U9-2b) a flat gold kit B tag, square and untilted
		local new = HatchLook.Tag(col, "New", "NEW!", "Selected", { ZIndex = 6, Visible = pull.IsNew })
		local newPop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = new })
		if pull.IsNew and H.order(pull.Rarity) >= K.LOOK.SPARKLE.From then
			-- (U9-2b look review 2) a plus-shaped pixel sparkle (five unit cells: the H and V bars) on NEW!'s top-right corner,
			-- blinking twice after its pop (H.blink); hidden at rest
			local sp = H.frame(new, "Sparkle", { Visible = false, ZIndex = 8 })
			for _, nm in ipairs({ "H", "V" }) do
				H.frame(sp, nm, { BackgroundColor3 = K.LOOK.SPARKLE.Color, BackgroundTransparency = 0, ZIndex = 8 })
			end
		end
		local note = Theme.Label(EggStage.NoteText(pull, pull.Rarity, brief), "Body", { Size = 15 })
		note.Name, note.ZIndex, note.TextWrapped, note.TextColor3, note.Parent = "Note", 5, true, Theme.Sign.Stone, col
		if stage >= 1 then
			-- (kit-b U9-2b) the evolved stage's tag, square and untilted; its words follow the room (H.applyReveal:
			-- "EVOLVED II", or "EVO II" on a phone's small corner tag). (kit-b gate U9 round 3: navy on the navy nameplate it
			-- showed only its gold edge) the kit's pink block, apart from NEW!'s gold
			local tag = HatchLook.Tag(col, "EvolvedRibbon", K.LOOK.EVOLVED[stage >= 2 and 2 or 1][1], "Gift", { ZIndex = 6 })
			tag:SetAttribute("Stage", stage >= 2 and 2 or 1)
		end
		-- the chain's fades: { object, property, its shown value } (the name and note: their text, classic stroke, outline)
		local fade = { { plate, "BackgroundTransparency", 0 }, { plate.SignEdge, "Transparency", 0 }, { plate.Lip, "BackgroundTransparency", 0 } }
		for _, l in ipairs({ name, note }) do
			fade[#fade + 1] = { l, "TextTransparency", 0 }
			fade[#fade + 1] = { l, "TextStrokeTransparency", l.TextStrokeTransparency }
			local outline = l:FindFirstChild("TextOutline")
			if outline then
				fade[#fade + 1] = { outline, "Transparency", outline.Transparency }
			end
		end
		roll.Cols[j] = {
			Root = col, Pet = pet, Pop = pop, Banner = banner, Word = word, Name = name, New = new, NewPop = newPop, Note = note, NoteFull = note.Text, View = vf, Fade = fade, Rest = {}, Plate = plate,
			Sil = H.order(pull.Rarity) >= K.LOOK.SIL.From,
		}
	end
	-- the name / NEW! / note rise (spec 16.15): one NumberValue tweened 0 -> 1 drives every column (H.textIn)
	local textIn = Util.Create("NumberValue", { Name = "TextIn", Value = 1, Parent = reveal })
	roll.TextIn = textIn
	textIn:GetPropertyChangedSignal("Value"):Connect(function()
		H.textIn(roll, textIn.Value)
	end)
end

-- the stage's text widths in the Title face (the reveal word's letters)
function H.titleW(text, size)
	return H.textW(text, size, "Title")
end

-- (review round 2) a note too long for one line of its box breaks at its dots (each line whole phrases, the dot at the
-- break dropped): "1 of 4 Legendary pets" / "added to your pets", never a lone "pets" wrapped onto the second line
function H.fitNote(text, size, w)
	text = tostring(text or "")
	if H.textW(text, size, "Body") <= w then
		return text
	end
	local sep = " " .. DOT .. " "
	local parts, from = {}, 1
	while true do
		local a, b = text:find(sep, from, true)
		if not a then
			parts[#parts + 1] = text:sub(from)
			break
		end
		parts[#parts + 1] = text:sub(from, a - 1)
		from = b + 1
	end
	if #parts < 2 then
		return text
	end
	local lines, cur = {}, parts[1]
	for i = 2, #parts do
		local try = cur .. sep .. parts[i]
		if H.textW(try, size, "Body") <= w then
			cur = try
		else
			lines[#lines + 1] = cur
			cur = parts[i]
		end
	end
	lines[#lines + 1] = cur
	return table.concat(lines, "\n")
end

-- (roll-look) the name / NEW! / note at k (0 = 16 px low and clear .. 1 = at their layout places, shown)
function H.textIn(roll, k)
	roll.TextK = k
	local rise = (1 - k) * K.LOOK.CHAIN.TextRise
	for _, c in pairs(roll.Cols) do
		for key, at in pairs(c.Rest or {}) do
			c[key].Position = at + UDim2.fromOffset(0, rise)
		end
		for _, f in ipairs(c.Fade or {}) do
			f[1][f[2]] = 1 - k * (1 - f[3])
		end
	end
end

----------------------------------------------------------------------
-- applying the layout (snaps: called on build, on the reveal and after a resize)
----------------------------------------------------------------------
function H.apply()
	local roll, lay = S.Roll, S.Lay
	if not roll or not lay or not S.Content then
		return
	end
	S.Content.Position = UDim2.fromOffset(0, lay.Top)
	S.Content.Size = UDim2.fromOffset(lay.W, lay.H)
	S.Fit.Scale = lay.Scale
	local title = roll.UI.Title
	if title then
		H.place(title, 12, lay.Title.Y, lay.W - 24, lay.Title.H)
		title.TextSize = lay.Title.Size
		title.Visible = not roll.Revealed
		if roll.HeroBuilt then
			H.titleAlpha(roll, 0) -- (review round 1: gone once the egg has risen; a resize mid-rise ends the fade too)
		end
	end
	H.applyStrips(roll, lay)
	H.applyHero(roll, lay)
	H.applyReveal(roll, lay)
	H.applyBar(roll, lay)
end

function H.applyStrips(roll, lay)
	local g = lay.Strip
	local geo = H.cardGeo(lay)
	local rim = lay.Rim
	local band = (g.H - g.CellH) / 2
	local ew = HatchLook.TRACK_END.Px
	for j, st in pairs(roll.Strips) do
		H.place(st.Frame, g.X, g.Y[j], g.W, g.H)
		if st.Outer then
			H.place(st.Outer, -rim, -rim, g.W + 2 * rim, g.H + 2 * rim)
			-- the nails: a unit square centred in the rim's width at each corner (whole px)
			local u = math.min(lay.Unit, rim)
			local off = math.floor((rim - u) / 2)
			local ow, oh = g.W + 2 * rim, g.H + 2 * rim
			local at = { { off, off }, { ow - u - off, off }, { off, oh - u - off }, { ow - u - off, oh - u - off } }
			for i = 1, 4 do
				H.place(st.Outer:FindFirstChild("Nail" .. i), at[i][1], at[i][2], u, u)
			end
		end
		-- (look review) the ends: a flat navy-lip line each inside the frame, the rail's full height (no fade)
		H.place(st.EndL, 0, 0, ew, g.H)
		H.place(st.EndR, g.W - ew, 0, ew, g.H)
		if st.Geo ~= g then
			B.cells(roll, j)
		end
		-- the gold window round the landed cell's box + Pad a side, the dims beside it over the track
		st.Win:Style({ Stroke = geo.Win, Notch = geo.Notch })
		st.Win:Place(g.W / 2 - g.CellW / 2 - geo.Pad, band - geo.Pad, g.CellW + 2 * geo.Pad, g.CellH + 2 * geo.Pad, g.W, g.H)
		R.cells(roll, j, st.C or K.START_CELL)
	end
end

function H.applyHero(roll, lay)
	local cr = lay.Crack
	if roll.Spot then
		-- one light cone from above the word onto the pedestal(s)
		local w = K.SPOT * cr.E + (roll.N > 1 and (cr.Cx[3] - cr.Cx[1]) or 0)
		w = math.min(w, lay.W - 8)
		local y = math.max(0, cr.WordY - 0.2 * cr.E)
		H.place(roll.Spot, lay.W / 2 - w / 2, y, w, cr.EggY + cr.E + 0.6 * cr.PedH - y)
		roll.Spot.Visible = not roll.Revealed
	end
	for j, e in pairs(roll.Eggs) do
		local cx = cr.Cx[j]
		local eggY = cr.EggY
		if e.Egg and e.Egg.Parent then
			-- the egg stands on its foot (AnchorPoint 0.5, 1): the push-in grows it upward, never into the pedestal
			H.sizeEgg(e.Egg, cr.E)
			e.Egg.Position = UDim2.fromOffset(cx, eggY + cr.E)
			e.Pop.Scale = 1
			e.Egg.Rotation = 0
			e.Egg.Visible = e.State == "Rise" or e.State == "Crack"
		end
		if e.Ring then
			-- (roll-look) never past the screen's edge (a portrait x3's outer columns)
			e.Ring:Place(cx, eggY + cr.E / 2, math.min(K.RING * cr.E, 2 * math.min(cx, lay.W - cx)))
		end
		if e.Back then
			H.placeBack(e.Back, cx, eggY + cr.E / 2, K.LOOK.BACK.Size * cr.E, lay.Unit)
		end
		if e.Holder and e.Holder.Parent then
			if e.State == "Crack" and e.HolderSize ~= cr.E then
				e.Holder:Destroy()
				e.Holder = nil
				B.halves(roll, j)
			elseif e.State ~= "Crack" and e.HolderSize ~= cr.E then
				e.Holder.Visible = false
			end
		end
		if e.Ped then
			-- (roll-look) the box is anchored at its top centre (the egg's foot); (U9-2b look review 2) the slab on whole px:
			-- its centre a whole px, its width even
			if roll.Revealed and lay.Cols[j] then
				local p = lay.Cols[j].Ped -- (in Content's space: Hero fills Content)
				H.place(e.Ped, math.floor(p.X + p.W / 2), math.floor(p.Y), H.even(p.W), math.floor(p.H))
				H.pedLook(e.Ped, p.H < 20)
			else
				H.place(e.Ped, math.floor(cx), math.floor(eggY + cr.E), H.even(cr.PedW), math.floor(cr.PedH))
				H.pedLook(e.Ped, false)
			end
		end
	end
	H.placeWord(roll, lay)
	-- the rays: round the last egg that burst (or the egg of Gemini's tweak), or behind the best pet on the reveal
	if roll.Rays then
		local at = roll.RaysAt or roll.TweakRays
		if roll.Revealed then
			local g = lay.Cols[roll.Best]
			if g then
				roll.Rays:Place(g.X + g.Pet.X + g.Pet.S / 2, g.Y + g.Pet.Y + g.Pet.S / 2, 2.2 * g.Pet.S)
			end
		elseif at then
			roll.Rays:Place(cr.Cx[at], cr.EggY + cr.E / 2, K.RAYS * cr.E)
		end
	end
end

-- the crack word, centred over the hero, as wide as its text
function H.placeWord(roll, lay)
	local word = roll.UI.Crack
	if word and lay then
		local cr = lay.Crack
		-- (playtest 2026-11-28 C30) a word wider than the screen's room shrinks to fit it: "LEGENDARY EGG!" at 40 px ran
		-- out of its clamped box to within 5 px of both edges at 360x640
		local size, tw = cr.WordH, H.textW(word.Text, cr.WordH, "Title")
		local room = lay.W - 24 - 40
		if tw > room and tw > 0 then
			size = math.max(12, math.floor(cr.WordH * room / tw))
			tw = H.textW(word.Text, size, "Title")
		end
		if roll.CrackWord then
			roll.CrackWord:SetSize(size) -- (the outline follows the size)
		else
			word.TextSize = size
		end
		local w = math.min(lay.W - 24, tw + 40)
		H.place(word, (lay.W - w) / 2, cr.WordY, w, cr.WordH)
	end
end

-- the pedestal's look: the slab on its foot (U9-2b look review 2: HatchLook.Plinth), or the slab alone filling the box as
-- the thin lip a phone's reveal pet stands on; laid out again at every call (the box's size changes at the reveal)
function H.pedLook(ped, lip)
	ped:SetAttribute("Lip", lip)
	HatchLook.PlinthLip(ped, lip)
end

-- (U9-2b look review 2) the pet's flat contact shadow in its frame (s px): Row1 PET_SHADOW.W of the frame wide (even
-- units), one unit tall, its bottom on the feet line (PET_FOOT); Row2 two units in on each side, on top of it
function H.placeShadow(shadow, s, u)
	if not shadow then
		return
	end
	local w = math.max(6 * u, 2 * u * math.floor(K.LOOK.PET_SHADOW.W * s / (2 * u) + 0.5))
	local foot = H.feet(s)
	H.place(shadow, (s - w) / 2, foot - 2 * u, w, 2 * u)
	H.place(shadow:FindFirstChild("Row1"), 0, u, w, u)
	H.place(shadow:FindFirstChild("Row2"), 2 * u, 0, w - 4 * u, u)
end

-- the pet's feet line in its s px frame (K.LOOK.PET_FOOT, on a whole px: the contact shadow's bottom and a phone lip's top)
function H.feet(s)
	return math.floor(K.LOOK.PET_FOOT * s)
end

-- a px size made even (a box centred on a whole px keeps whole edges)
function H.even(v)
	return 2 * math.floor(v / 2 + 0.5)
end

-- (U9-2b look review 2) the nameplate round the name row (rowX, rowW: the name and the tags in it) and the note's lines
-- (in a box nx, nw wide: centred, or left-aligned in a row layout): PLATE.Pad px of plank round the words a side, Top px
-- over the name's glyphs, the lip under the note; whole px
K.LOOK.PLATE = { Pad = 12, PadPhone = 8, Top = 2, Lip = 5, LipPhone = 4 }
function H.placePlate(c, g, lay, rowX, rowW, nx, nw)
	local plate = c.Plate
	if not plate then
		return
	end
	local pl = K.LOOK.PLATE
	local phone = lay.Kit == "Phone"
	local pad = phone and pl.PadPhone or H.px(lay, pl.Pad)
	local lip = phone and pl.LipPhone or pl.Lip
	local note = c.Note
	local lines, noteW = 0, 0
	for line in string.gmatch(note.Text .. "\n", "(.-)\n") do
		lines = lines + 1
		noteW = math.max(noteW, H.textW(line, g.NoteSize, "Body"))
	end
	noteW = math.min(nw, math.ceil(noteW))
	local noteX = g.Row and nx or (nx + (nw - noteW) / 2)
	local left = math.min(rowX, noteX) - pad
	local right = math.max(rowX + rowW, noteX + noteW) + pad
	-- the words' own rows: the name's glyphs in its box, the note's lines from the top of its box (Center: centred)
	local nameTop = g.NameY + (g.NameH - g.NameSize) / 2
	local noteH = math.min(g.NoteH, lines * g.NoteSize * 1.15)
	local noteBottom = lines > 1 and (g.NoteY + g.NoteH) or (g.NoteY + (g.NoteH + noteH) / 2)
	local top = nameTop - pad / 2 - pl.Top
	local bottom = noteBottom + pad / 2 + lip
	left, right = math.max(0, left), math.min(g.W, right)
	H.placeWhole(plate, left + 2, top + 2, right - left - 4, bottom - top - 4) -- (its 2 px edge outside the frame)
end

function H.applyReveal(roll, lay)
	if not roll.Revealed then
		return
	end
	for j, c in pairs(roll.Cols) do
		local g = lay.Cols[j]
		if g then
			H.placeWhole(c.Root, g.X, g.Y, g.W, g.H) -- (look review: the chrome inside it on whole px)
			local banner, word = c.Banner, c.Word
			local wordRight = nil -- (U9-2b look review 2) the word's right edge: a row layout's evolved tag sits after it
			if word then
				-- (roll-look) the word at its layout size (a landscape phone's right column: down to WordMin when it is long)
				local maxW = g.Banner.MaxW or (g.W - 24)
				local size = g.Banner.Word
				word:SetSize(size)
				if g.Banner.WordMin and word:Width() > maxW - 8 then
					size = math.max(g.Banner.WordMin, math.floor(size * (maxW - 8) / word:Width()))
					word:SetSize(size)
				end
				local bw = math.min(math.max(g.Banner.Min, word:Width() + g.Banner.Pad), maxW)
				if g.Banner.Left then
					-- (U9-2b look review 2) a left-aligned row: the word's own width from Banner.X, so the word, the name and the
					-- note share one left edge (centred in a 120 px box it gave three)
					bw = math.min(math.ceil(word:Width()), maxW)
				end
				local bx = g.Banner.Left and g.Banner.X or (g.Banner.CX and (g.Banner.CX - bw / 2)) or (g.W - bw) / 2
				H.placeWhole(banner, bx, g.Banner.Y, bw, g.Banner.H)
				wordRight = math.floor(bx) + math.ceil(bw)
				-- (its glow stays on the screen: the room above the word's top and to the nearer side, in Content's px)
				local top, cx = g.Y + g.Banner.Y + (g.Banner.H - size) / 2, g.X + bx + bw / 2
				word:Place(bw / 2, (g.Banner.H - size) / 2, { Up = math.max(0, top - 1), Half = math.max(0, math.min(cx, lay.W - cx) - 1) })
			end
			-- (U9-2b look review 2) the pet frame centred on a whole px, its side even: its flat shadow's rows on whole px
			local ps = H.even(g.Pet.S)
			H.place(c.Pet, math.floor(g.Pet.X + g.Pet.S / 2), math.floor(g.Pet.Y + g.Pet.S / 2), ps, ps)
			c.Pet.AnchorPoint = Vector2.new(0.5, 0.5)
			H.placeShadow(c.Pet:FindFirstChild("Shadow"), ps, lay.Unit)
			-- the name (+ NEW!) row, then the note
			local name, new, note = c.Root:FindFirstChild("Name"), c.Root:FindFirstChild("New"), c.Root:FindFirstChild("Note")
			local ribbon = c.Root:FindFirstChild("EvolvedRibbon")
			local ribbonText = ribbon and ribbon:FindFirstChild("Text")
			local ribbonSize = lay.PC and H.px(lay, 20) or 15
			local rh = lay.PC and H.px(lay, 36) or 24
			local nx, nw = g.NameX or 12, g.NameW or (g.W - 24)
			local nameW = H.textW(name.Text, g.NameSize, "Display") + 8
			-- (U9-2b look review 2) Corner "Fit" (a phone's x3): NEW! after the name while the row holds both, else the pet
			-- frame's corner
			local corner = g.New.Corner == true
			if g.New.Corner == "Fit" then
				corner = new ~= nil and new.Visible and nameW + g.New.W + 8 > nw
			end
			local newW = (new and new.Visible and not corner) and (g.New.W + 8) or 0
			-- (review round 2) the Evolved ribbon: a sticker in the name row after NEW! (name, NEW!, Evolved centred together)
			-- wherever NEW! sits in that row and the whole name still fits beside them (PC, a landscape phone's x1); else on
			-- PC the model's shoulder (the frame's corner hung in the empty sky: the model fills only 1 / 1.2 of its frame)
			-- and on a phone's x3 / portrait a small tag on the pet frame's top-right corner (its text's width, at most 0.75
			-- of the frame), NEW! on the bottom-left one (never stacked over the pet's head). (kit-b U9-2b review) the tag is
			-- never narrower than its words (the label fills the tag, nothing clips it): on PC it grows past 0.36 of the pet
			-- (the shoulder has the sky beside it); a phone's tag keeps 4 px a side at the least, and a corner tag whose cap
			-- cannot hold the words takes the short form ("EVO II")
			local rw, ribW, inRow, wordLine = 0, 0, false, false
			if ribbon then
				local forms = K.LOOK.EVOLVED[ribbon:GetAttribute("Stage") == 2 and 2 or 1]
				local words = forms[1]
				local ww = H.textW(words, ribbonSize, "Tag")
				local tw = ww + (lay.PC and H.px(lay, 28) or 14)
				rw = lay.PC and math.max(tw, math.min(H.px(lay, 150), 0.36 * g.Pet.S)) or math.max(ww + 8, math.min(96, tw))
				-- (U9-2b look review 2) a portrait row: on the word's line after the word when it fits there
				wordLine = g.Row == true and wordRight ~= nil and wordRight + 8 + rw <= g.W
				inRow = not wordLine and not corner and nameW + newW + rw + 8 <= nw
				ribW = inRow and (rw + 8) or 0
				if not inRow and not wordLine and not lay.PC then
					local cap = math.min(96, 0.75 * g.Pet.S)
					if ww + 8 > cap then
						words = forms[2]
						ww = H.textW(words, ribbonSize, "Tag")
					end
					rw = math.max(ww + 8, math.min(cap, ww + 14))
				end
				if ribbonText and ribbonText.Text ~= words then
					ribbonText.Text = words
				end
			end
			local textW = math.min(nw - newW - ribW, nameW)
			local rowX = g.Row and nx or (nx + (nw - textW - newW - ribW) / 2)
			name.TextSize = g.NameSize
			-- (look review: whole px) the row's start and every tag in it on whole px (the tags' mitred edges were on 0.18 px)
			rowX = math.floor(rowX)
			textW = math.ceil(textW)
			H.placeWhole(name, rowX, g.NameY, textW, g.NameH)
			if new then
				if corner then
					-- (review round 3) on the pet frame's corner, the name keeps its whole row; (review round 2) the bottom-left
					-- corner, hanging up to 14 px off the frame into the column (clear of the ribbon on the top-right, and of
					-- the pet's head: the two stacked over the head covered most of a 110 px pet)
					local hang = math.min(14, g.Pet.X)
					H.placeWhole(new, g.Pet.X - hang, g.Pet.Y + 0.62 * g.Pet.S, g.New.W, g.New.H)
				else
					H.placeWhole(new, rowX + textW + 8, g.NameY + (g.NameH - g.New.H) / 2, g.New.W, g.New.H)
				end
				new.Rotation = 0 -- (kit-b U9-2b) a kit B tag sits square (no sticker tilt)
			local sp = new:FindFirstChild("Sparkle")
			if sp then
				-- its centre cell on the tag's top-right corner (whole units of the screen's pixel)
				local u = lay.Unit
				H.place(sp, math.ceil(g.New.W) - u, -2 * u, 3 * u, 3 * u)
				H.place(sp:FindFirstChild("H"), 0, u, 3 * u, u)
				H.place(sp:FindFirstChild("V"), u, 0, u, 3 * u)
			end
				local t = new:FindFirstChild("Text")
				if t then
					t.TextSize = g.New.Size
				end
			end
			note.TextSize = g.NoteSize
			note.TextXAlignment = g.Row and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
			note.Text = H.fitNote(c.NoteFull or note.Text, g.NoteSize, nw)
			H.placeWhole(note, nx, g.NoteY, nw, g.NoteH)
			H.placePlate(c, g, lay, rowX, textW + newW + (inRow and ribW or 0), nx, nw)
			if ribbon then
				if wordLine then
					H.placeWhole(ribbon, wordRight + 8, g.Banner.Y + (g.Banner.H - rh) / 2, rw, rh)
				elseif inRow then
					H.placeWhole(ribbon, rowX + textW + newW + 8, g.NameY + (g.NameH - rh) / 2, rw, rh)
				elseif lay.PC then
					-- the model's shoulder (it fills 1 / 1.2 of the frame, centred), not the frame's empty corner; a tag wider
					-- than the room right of it moves in to end inside the column
					H.placeWhole(ribbon, math.min(g.Pet.X + 0.62 * g.Pet.S, g.W - math.ceil(rw)), g.Pet.Y + 0.2 * g.Pet.S, rw, rh)
				else
					H.placeWhole(ribbon, g.Pet.X + g.Pet.S - math.ceil(rw), g.Pet.Y + 0.12 * g.Pet.S, rw, rh) -- inside the pet frame, clear of the banner
				end
				if ribbonText then
					ribbonText.TextSize = ribbonSize
				end
			end
			c.Pop.Scale = roll.PopDone and 1 or c.Pop.Scale
			-- (roll-look) the rest places the chain's rise ends at (H.textIn)
			c.Rest.Name, c.Rest.New, c.Rest.Note, c.Rest.Plate = name.Position, new and new.Position or nil, note.Position, c.Plate and c.Plate.Position or nil
		end
	end
	if roll.TextK and roll.TextK < 1 then
		H.textIn(roll, roll.TextK)
	end
end

function H.applyBar(roll, lay)
	local bar = roll.Revealed and lay.BarReveal or lay.BarRoll
	H.placeWhole(roll.UI.Bar, 0, bar.Y, lay.W, bar.H) -- (look review: the planks and chips on whole px)
	local P = lay.P
	local phone = lay.Kit == "Phone"
	-- (roll-look) the chips' text with the chevrons, the chips' and pills' sizes of this layout; (review round 2) a chip
	-- packed narrower than its words takes the next shorter form ("Tap to close ››", then "Close ››"), never an ellipsis
	local verb = roll.Revealed and "close" or "skip"
	local skipIt = bar.Items.Skip
	-- (kit-b U9-2b review) the label's own box (the block sits its edge inside the tap box): HatchLook.ChipRoom
	local room = skipIt and HatchLook.ChipRoom(skipIt.w, false, phone) or math.huge
	local forms = { "Tap to " .. verb .. " " .. K.LOOK.CHEVRONS, verb:sub(1, 1):upper() .. verb:sub(2) .. " " .. K.LOOK.CHEVRONS }
	if lay.PC then
		table.insert(forms, 1, "Tap anywhere to " .. verb .. " " .. K.LOOK.CHEVRONS)
	end
	-- (a chip at its preferred width is sized for its full words: only a packed, narrower chip measures)
	local pref = (roll.Revealed and P.Bar.SkipReveal or P.Bar.Skip)[1]
	local chipText = forms[#forms]
	for i, form in ipairs(forms) do
		if (i == 1 and skipIt and skipIt.w >= pref - 0.5) or H.textW(form, P.Bar.ChipText, "Label") <= room then
			chipText = form
			break
		end
	end
	HatchLook.SetChipText(roll.UI.Skip, chipText)
	HatchLook.SizeChip(roll.UI.Skip, P.Bar.ChipText, phone)
	HatchLook.SizeChip(roll.UI.Fast, P.Bar.FastText, phone)
	for _, btn in ipairs(roll.UI.Pills) do
		HatchLook.SizePill(btn, P.Bar.Text, phone, P.Bar.Coin)
	end
	for _, name in ipairs({ "Skip", "FastHatch", "SpinAgain", "Done" }) do
		local o = roll.UI.Bar:FindFirstChild(name)
		local it = bar.Items[name]
		if o then
			o.Visible = it ~= nil
			if it then
				H.placeWhole(o, it.x, it.y, it.w, it.h)
				-- the pills rise PillsRise px into place, less where the screen's bottom edge is nearer (never off it)
				roll.UI.Rise[name] = math.max(0, math.min(K.LOOK.CHAIN.PillsRise, lay.H - (bar.Y + it.y + it.h) - 1))
			end
		end
	end
	H.paintFast(roll)
	roll.AgainKey = nil -- (the sizes above changed: SPIN AGAIN measures and fits its chip again)
	H.refreshAgain()
	if roll.PillK then
		H.pillsIn(roll, roll.PillK)
	end
end

-- SPIN AGAIN: the same roulette, currency and spins; disabled with the reason when it cannot be paid or is locked, and
-- (review round 2) SPIN AGAIN and DONE both disabled until the reveal is armed (H.armed: the label and price stay)
function H.refreshAgain()
	local roll = S.Roll
	if not roll then
		return
	end
	local armed = H.armed()
	roll.Armed = armed
	local btn = roll.UI.Again
	local roulette = roll.Roulette
	local price = roulette and H.price(roulette, roll.Currency) * roll.N or 0
	local reason = nil
	if not roulette then
		reason = "none"
	elseif H.inMatch() then
		reason = "Shop closed"
	elseif not H.spinOpen(roll.Currency) then
		reason = "Locked" -- (lobby-shop 16.12: a token spin too, as the server refuses it while not "Allowed"; Store on only)
	elseif H.balance(roll.Currency) < price then
		reason = roll.Currency == "Gems" and "Not enough Gems" or "Not enough Tokens"
	end
	-- (review round 2) R.advance refreshes every 8 heartbeats for the whole reveal: nothing is looked up, measured or
	-- written again while what the pills show is the same (H.applyBar clears the key: a layout's sizes changed)
	local key = table.concat({ tostring(armed), tostring(S.Pending), reason or "", tostring(price) }, "|")
	if roll.AgainKey == key then
		return
	end
	roll.AgainKey = key
	local done = roll.UI.Done
	if done and done.Parent then
		CloudUI.SetDisabled(done, not armed)
	end
	if not btn or not btn.Parent then
		return
	end
	if not roulette then
		btn.Visible = false
		return
	end
	local parts = roll.UI.PillParts and roll.UI.PillParts[1] or nil
	local lbl = roll.UI.AgainLabel
	lbl.Text = reason or ((roll.N > 1) and "Spin again x3" or "Spin again")
	local priceText = (S.Lay and S.Lay.PC) and Util.Commas(price) or Theme.Short(price)
	local chipW, labelW = 0, 0
	if reason == nil then
		-- (review round 3) measured with the real fonts (TextService): a label that would not fit beside the price takes the
		-- short price ("3K"); (look review) the coin and the price inline after the label, like the Shop's Spin (Button role)
		labelW = H.textW(lbl.Text, lbl.TextSize, "Button")
		local fits
		chipW, fits = HatchLook.FitPill(btn, labelW, H.textW(priceText, roll.UI.AgainPrice.TextSize, "Button"), parts)
		if not fits then
			priceText = Theme.Short(price)
			chipW = HatchLook.FitPill(btn, labelW, H.textW(priceText, roll.UI.AgainPrice.TextSize, "Button"), parts)
		end
	end
	roll.UI.AgainPrice.Text = priceText
	HatchLook.SetPillChip(btn, chipW, parts, labelW) -- (a reason: no price, the label takes the whole pill)
	CloudUI.SetDisabled(btn, reason ~= nil or S.Pending or not armed)
end

----------------------------------------------------------------------
-- the phase runner (one Heartbeat while the stage shows)
----------------------------------------------------------------------
function R.phaseAt(roll, t)
	local s = roll.Sched
	if t < s.IntroEnd then
		return "Intro"
	elseif roll.HasStrip and t < s.StripEnd then
		return "Strip"
	elseif roll.HasStrip and t < s.LandEnd then
		return "Land"
	elseif t < s.RiseEnd then
		return "Rise"
	elseif t < s.BurstAt[roll.N] then
		return "Crack"
	elseif t < s.RevealAt then
		return "Burst"
	end
	return "Reveal"
end

-- lays the strip's cells out with the pointer over position c (cell i spans i-1 .. i); at most 12 cells intersect
function R.cells(roll, j, c)
	local st = roll.Strips[j]
	local g = st and st.Geo
	if not g then
		return
	end
	st.C = c
	local half = g.W / 2
	local rarities = roll.Pulls[j].Rarities or {}
	local used = st.Used or {} -- (one table per strip, cleared each frame: no per-frame garbage)
	st.Used = used
	for slot in pairs(used) do
		used[slot] = nil
	end
	local first = math.max(1, math.floor(c - half / g.Step) - 1)
	local last = math.min(K.STRIP_LEN, math.ceil(c + half / g.Step) + 1)
	for i = first, last do
		local x = half + (i - 1 - c) * g.Step + (g.Step - g.CellW) / 2
		if x + g.CellW > 0 and x < g.W then
			local slot = ((i - 1) % (st.Slots or K.MAX_CELLS)) + 1
			local cell = st.Cells[slot]
			if cell and not used[slot] then
				used[slot] = true
				if cell.Index ~= i then
					cell.Index = i
					cell.Frame:SetAttribute("Index", i)
					local rarity = rarities[i]
					local landed = st.Landed and i == K.WIN
					local egg = cell.Egg -- (nil once the winner's egg has lifted out at the rise: the hero egg left its card)
					local shown = rarity ~= false and rarity ~= nil and not (landed and st.Lifted)
					-- (egg-cards, spec 16.18) a picture cell (all seven ids) shows its rarity's picture; else the painted egg
					local image = (cell.Pic and rarity) and HatchLook.EggImage(rarity) or nil
					if cell.Pic then
						cell.Pic.Visible = shown and image ~= nil
						if image then
							cell.Pic.Image = image
						end
					end
					if egg then
						egg.Visible = shown and image == nil
						if rarity and not image then
							EggArt.SetRarity(egg, rarity)
						end
					end
					-- (kit-b U9-2b) the card by rarity: the plate (or the lite card's lip) in the rarity's colour with its word;
					-- the landed card the selected face (its egg gets its VFX), the others the sunk well once the strip has landed
					HatchLook.SetCard(cell.Card, rarity or false, landed and "Landed" or (st.Landed and "Dim") or "Idle")
					if cell.Word and not cell.OnPlate then
						cell.Word.Text = rarity and string.upper(rarity) or "" -- (a rarity tag in capitals, as on the x1 plate)
					end
					-- (only a painted egg wears the landed VFX: a picture has none)
					local vfx = landed and rarity ~= nil and rarity ~= false and image == nil
					if egg and (cell.Vfx == true) ~= vfx then
						cell.Vfx = vfx
						EggArt.SetVfx(egg, vfx)
					end
				end
				-- (placed by its centre: the land pop grows round the middle; its shadow follows)
				HatchLook.ShowCard(cell.Card, x + g.CellW / 2, g.H / 2)
			end
		end
	end
	for slot, cell in pairs(st.Cells) do
		if not used[slot] then
			HatchLook.HideCard(cell.Card)
		end
	end
end

function R.land(roll, j)
	local st = roll.Strips[j]
	st.Landed = true
	st.Frame:SetAttribute("Landed", true)
	local rarity = roll.Pulls[j].Rarity
	H.sfx(K.SOUND.Land, H.scaleFor(rarity))
	for _, cell in pairs(st.Cells) do
		cell.Index = nil -- re-skin with the landed look on the next layout
	end
	R.cells(roll, j, st.C or K.START_CELL)
	-- (roll-look) the winner has passed the window by the overshoot: the Back Out spring (R.landStep, from the next frame)
	-- brings it back over Land; the window bounces, the landed card pops once with one shine sweep
	local g = st.Geo
	st.Over = g and (roll.Fast and K.LOOK.OVERSHOOT.Fast or K.LOOK.OVERSHOOT.Px) * g.S or 0
	st.Fresh, st.Settled = true, false
	if st.Win then
		st.Win:Bounce(roll.T.Land)
	end
	local cell = H.landedCell(st)
	if cell then
		-- (look review) a hop, never a scale: at most the room above the card's wood edge inside the rail and the window's
		-- navy pad (the rail clips nothing, the window's pad stays navy)
		local geo = H.cardGeo(S.Lay)
		local room = g and math.min((g.H - g.CellH) / 2, geo.Pad) - geo.Edge or 0
		HatchLook.LandPop(cell.Card, roll.Fast, S.Tweens, room)
	end
end

-- (roll-look) one frame of the land: the landed strips spring back from the overshoot (Back Out, the rise's curve) and
-- the track darkens round the window; a strip rests once its Land is over
function R.landStep(roll, t)
	for j, st in pairs(roll.Strips) do
		if st.Landed and not st.Settled and st.Geo then
			if st.Fresh then
				st.Fresh = nil -- (the land's own frame shows the whole overshoot)
			else
				local k = Util.Clamp((t - roll.Sched.Land[j]) / math.max(0.01, roll.T.Land), 0, 1)
				local back = 1 + 2.70158 * (k - 1) ^ 3 + 1.70158 * (k - 1) ^ 2
				R.cells(roll, j, K.WIN - 0.5 + (st.Over or 0) * (1 - back) / st.Geo.Step)
				if st.Win then
					st.Win:SetDim(k)
				end
				st.Settled = k >= 1
			end
		end
	end
end

-- (roll-look) B's colour tell: from Rare up the window, its glow and its notches turn the coming rarity's colour a moment
-- before the strip stops (Common / Uncommon keep the gold: no fake tease); x3: each strip its own pull's colour
function R.tell(roll, j, t)
	local st = roll.Strips[j]
	local rarity = roll.Pulls[j].Rarity
	if st.Told or not st.Win or H.order(rarity) < 3 then
		return
	end
	local tl = K.LOOK.TELL
	if t >= roll.Sched.Land[j] - (roll.Fast and tl.Fast or tl.Before) then
		st.Told = true
		st.Win:Tell(H.color(rarity), roll.Fast and tl.TweenFast or tl.Tween)
	end
end

-- the speed streaks: as bright as the strip is fast (the ease's slope), sliding left, always inside the track
function R.streaks(st, t, p)
	local g = st.Geo
	if not st.StreakBars or not g then
		return
	end
	local a = Util.Clamp(((1 - p) ^ (K.CURVE - 1) - 0.3) / 0.7, 0, 1)
	local bw = g.W * 0.32
	for i, bar in ipairs(st.StreakBars) do
		local u = (i * 0.29 + t * 2.4) % 1
		bar.Position = UDim2.fromOffset((g.W - bw) * (1 - u), g.H * (0.14 + 0.18 * i))
		bar.Size = UDim2.fromOffset(bw, math.max(2, math.floor(3 * g.S + 0.5)))
		bar.BackgroundTransparency = 1 - 0.55 * a
	end
end

function R.strips(roll, t)
	local s = roll.Sched
	for j, st in pairs(roll.Strips) do
		-- (a landed strip belongs to R.landStep)
		if not st.Landed then
			local dur = math.max(0.01, s.Land[j] - s.IntroEnd)
			local p = Util.Clamp((t - s.IntroEnd) / dur, 0, 1)
			-- (roll-look, spec 16.15) today's ease plus the overshoot past the winner over its last stretch (p ^ 8)
			local g = st.Geo
			local over = g and (roll.Fast and K.LOOK.OVERSHOOT.Fast or K.LOOK.OVERSHOOT.Px) * g.S / g.Step or 0
			local c = K.START_CELL + (K.WIN - 0.5 - K.START_CELL) * (1 - (1 - p) ^ K.CURVE) + over * p ^ 8
			R.tell(roll, j, t)
			R.cells(roll, j, c)
			R.streaks(st, t, p)
			local cell = math.floor(c)
			if st.Tick ~= cell then
				if st.Tick ~= nil and j == 1 and p < 1 and os.clock() - (roll.LastTick or -1) >= 1 / K.TICKS_PER_S then
					roll.LastTick = os.clock()
					H.sfx(K.SOUND.Tick, K.QUIET)
				end
				st.Tick = cell
			end
			if p >= 1 then
				R.land(roll, j)
			end
		end
	end
end

-- the pedestal's box (spec 16.4 "Spot, Backlight, Pedestal"): the layout anchor the egg, the halves and the pet stand on,
-- from 420 x 90 down to a phone's 12 px lip. The owner (2026-11-08) had the cloud-stone drum removed ("the useless bars
-- below the pet"); roll-look (spec 16.15) draws a flat lit plinth in it instead (HatchLook.Plinth: a disc centred on
-- the egg's foot, its thin side, an inner ring and a soft halo; nothing stacked under it). It starts neutral.
function B.pedestal(hero, j, rarity, e)
	local box = H.frame(hero, "Pedestal" .. j, { ZIndex = 5 })
	-- (U9-2b look review 2) the kit's navy slab in the screen's pixel unit (chrome now, not soft art: no Art attribute)
	e.Plinth = HatchLook.Plinth(box, rarity, S.Lay.Kit == "Phone", { Track = S.Tweens, Unit = S.Lay.Unit })
	return box
end

-- (U9-2b look review 2, the owner's look bar: no round glow) the rarity backlight is a flat stepped pixel light behind the
-- egg: K.LOOK.BACK.Levels nested stepped squares (each three blocks: the middle column and two wings Step of it shorter
-- at both ends, so no part of one level lies on another), in the rarity's colour at flat alphas as strong as the egg's
-- glow (none for Common / Uncommon), every block on whole px of the screen's unit (H.placeBack). Each part's shown
-- transparency is its attribute Alpha (H.glowAlpha fades it)
K.LOOK.BACK = { Levels = { { 1, 0.16 }, { 0.62, 0.24 } }, Step = 0.18, Size = 0.96 }
function B.backlight(hero, j, rarity)
	local glow = EggArt.Glow(rarity)
	local back = H.frame(hero, "Backlight" .. j, { Visible = glow > 0, ZIndex = 4 })
	local parts = {}
	for i, lv in ipairs(K.LOOK.BACK.Levels) do
		for _, side in ipairs({ "Mid", "L", "R" }) do
			local p = H.frame(back, "Glow" .. i .. side, { BackgroundColor3 = H.color(rarity), BackgroundTransparency = 1, ZIndex = 4 })
			p:SetAttribute("Alpha", 1 - glow * lv[2])
			parts[#parts + 1] = p
		end
	end
	return back, parts
end

-- the backlight's box (d px, centred on cx, cy) and its stepped levels, every size whole units u (even: centred on a px)
function H.placeBack(back, cx, cy, d, u)
	local function units(v)
		return math.max(2 * u, 2 * u * math.floor(v / (2 * u) + 0.5))
	end
	d = units(d)
	H.place(back, math.floor(cx) - d / 2, math.floor(cy) - d / 2, d, d)
	for i, lv in ipairs(K.LOOK.BACK.Levels) do
		local s = math.min(d, units(lv[1] * d))
		local c = math.max(u, u * math.floor(K.LOOK.BACK.Step * s / u + 0.5))
		local x0 = (d - s) / 2
		H.place(back:FindFirstChild("Glow" .. i .. "Mid"), x0 + c, x0, s - 2 * c, s)
		H.place(back:FindFirstChild("Glow" .. i .. "L"), x0, x0 + c, c, s - 2 * c)
		H.place(back:FindFirstChild("Glow" .. i .. "R"), x0 + s - c, x0 + c, c, s - 2 * c)
	end
end

-- a backlight part at u (0 = clear .. 1 = its attribute Alpha): a disc's background or the image's transparency
function H.glowAlpha(disc, u)
	if disc and disc.Parent then
		local t = 1 + ((disc:GetAttribute("Alpha") or 1) - 1) * u
		if disc:IsA("ImageLabel") then
			disc.ImageTransparency = t
		else
			disc.BackgroundTransparency = t
		end
	end
end

-- the backdrop of the rise at rest (after a resize cancelled its tweens): the spot, the glows, the rings
function H.settleHero(roll)
	if roll.Spot and not roll.Revealed then
		roll.Spot.BackgroundTransparency = 0
	end
	for _, e in pairs(roll.Eggs) do
		for _, disc in ipairs(e.Glows or {}) do
			H.glowAlpha(disc, 1)
		end
		if e.Ring and (e.State == "Rise" or e.State == "Crack") then
			e.Ring:Show(0.01)
			e.Ring:Spin(true)
			if e.Tint then
				e.Ring:Tint(e.Tint, 0) -- (Gemini's tweak already played: kept)
			end
		end
		-- (roll-look) the plinth at rest: popped, shown, its colour snapped (the tweak's or the burst's, else neutral)
		if e.Plinth then
			e.Plinth:Rest()
		end
	end
end

-- the eggs lift out of the strip and grow onto their pedestals in a spot light, their backlight and cloud ring fading in
-- behind them. quick (a skip before the rise): only the pedestals the reveal stands on
function R.rise(roll, quick)
	roll.HeroBuilt = true
	local cr = S.Lay.Crack
	local hero = roll.UI.Hero
	-- (U9-2b look review 2, the owner's look bar: no soft light shapes) no spot cone: the stepped backlight and the slab's
	-- rarity lip carry the light
	-- (egg-cards, spec 16.18) the hero eggs are 3D all together or not at all (x1 as 16.14; x3 its three); (look review)
	-- when they are not (a phone's x3, Low graphics) and the strip cards draw the Blender egg pictures, each hero egg is its
	-- card's picture (B.eggPic): the egg that rises is the egg the strip showed, never a painted egg of another style
	local use3d = not quick and H.use3d(roll)
	local pics = not quick and not use3d and HatchLook.EggPictures()
	for j, pull in ipairs(roll.Pulls) do
		local e = { State = "Rise" }
		e.Back, e.Glows = B.backlight(hero, j, pull.Rarity)
		e.Ped = B.pedestal(hero, j, pull.Rarity, e)
		if not quick then
			-- (roll-look) the plinth comes in with the rise: from K.LOOK.PLINTH_IN.From and clear (R.riseStep)
			e.Plinth:SetAlpha(0) -- (U9-2b look review 2: it rises with the egg and fades in, never a scale)
			e.Ring = HatchFx.CloudRing(hero, H.color(pull.Rarity), { ZIndex = 3, Track = S.Tweens, Unit = S.Lay.Unit })
			e.Ring.Frame.Name = "CloudRing" .. j
			-- the hero egg: Full with its rarity VFX (spec 16.5 "Where the VFX show"). (review round 2) No drifting sparkles
			-- from the pool round it: the pick's clutter cap (ROLL_PICK.md "sparkles only at the burst"; 16.15 adds the shakes'
			-- small pops) overrides 16.5's ambient sparks on the stage (the Shop's Secret hero keeps them)
			e.Egg = EggArt.New(hero, pull.Rarity, cr.E, { Name = "Egg" .. j, ZIndex = 6, Vfx = true })
			e.Egg.AnchorPoint = Vector2.new(0.5, 1)
			e.Egg:SetAttribute("State", "Rise")
			e.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = e.Egg })
			if use3d then
				B.egg3d(roll, e, pull.Rarity)
			elseif pics then
				B.eggPic(e, pull.Rarity)
			end
		end
		roll.Eggs[j] = e
	end
	if use3d then
		B.unmix3d(roll)
		-- (look review) an x3 whose 3D failed part-way went back to 2D: the pictures, when the cards draw them
		local any3d = false
		for _, e in pairs(roll.Eggs) do
			any3d = any3d or e.V3 ~= nil
		end
		if not any3d and HatchLook.EggPictures() then
			for j, e in pairs(roll.Eggs) do
				B.eggPic(e, roll.Pulls[j].Rarity)
			end
		end
	end
	H.applyHero(roll, S.Lay)
	if quick then
		return
	end
	-- the grow: from the landed cell (or the middle) to the pedestal; the backdrop fades in. Driven a frame at a time by
	-- R.riseStep from the one Heartbeat (x3 would need ~25 tweens for it; the budget is 24 in all)
	local g = S.Lay.Strip
	for j, e in pairs(roll.Eggs) do
		local st = roll.Strips[j]
		e.RiseTo, e.PedTo = e.Egg.Position, e.Ped.Position
		if st and st.Geo then
			e.RiseFrom = UDim2.fromOffset(g.X + g.W / 2, g.Y[j] + g.H / 2 + g.Egg / 2)
			e.PopFrom = math.max(0.1, g.Egg / math.max(1, cr.E))
		else
			e.RiseFrom, e.PopFrom = e.RiseTo, 0.4
		end
		e.PedFrom = e.PedTo + UDim2.fromOffset(0, 0.12 * cr.E)
		e.Ring:Show(roll.T.Rise)
		e.Ring:Spin(true)
	end
	-- the landed strips only need the cells on show while they slide away (the rest go: x3 stays inside 750 instances)
	for _, st in pairs(roll.Strips) do
		for slot, cell in pairs(st.Cells) do
			if not cell.Frame.Visible then
				HatchLook.DropCard(cell.Card)
				st.Cells[slot] = nil
			end
		end
		-- (roll-look) the winner lifts OUT of its card (the hero egg grows from its place: no second egg left behind), and
		-- the window lets its soft glow go; an x3 strip drops its dark rim too (x3 stays inside 750 instances while the
		-- strips slide away under the three rising eggs)
		local lc = H.landedCell(st)
		if lc and lc.Egg then
			lc.Egg:Destroy()
			lc.Egg = nil
		end
		if lc and lc.Pic then
			lc.Pic:Destroy() -- (egg-cards: the winner's picture lifts out with it too)
			lc.Pic = nil
		end
		st.Lifted = true
		if st.Win then
			st.Win:DropGlow()
		end
		if roll.N > 1 and st.Outer then
			st.Outer:Destroy()
			st.Outer = nil
		end
		-- (Task 2) ...and its end lines and dims (the three plinths come in now: x3 stays inside 750 at the rise's start)
		if roll.N > 1 then
			for _, key in ipairs({ "EndL", "EndR" }) do
				if st[key] then
					st[key]:Destroy()
					st[key] = nil
				end
			end
			if st.Win then
				st.Win:DropDims()
			end
		end
		if st.Streaks then
			st.Streaks:Destroy()
			st.Streaks, st.StreakBars = nil, nil
		end
	end
	-- (review round 2) the strips slide away behind the bottom bar's top line (R.riseStep shrinks Strips to end there):
	-- they never cross the Skip / Fast hatch chips on their way off the screen
	if roll.UI.Strips then
		roll.UI.Strips.ClipsDescendants = true
	end
	roll.Rising = true -- (R.advance steps it from this frame)
	H.sfx(K.SOUND.Rise, H.scaleFor(roll.Pulls[roll.Best].Rarity))
end

-- one frame of the rise (u: 0 -> 1 over the Rise phase): the eggs ease up and grow (Back), the pedestals settle, the
-- spot and the glows fade in, the strips slide away down off the screen
function R.riseStep(roll, t)
	if not roll.Rising then
		return
	end
	local s = roll.Sched
	local u = Util.Clamp((t - s.LandEnd) / math.max(0.01, s.RiseEnd - s.LandEnd), 0, 1)
	local quad = 1 - (1 - u) * (1 - u)
	local back = 1 + 2.70158 * (u - 1) ^ 3 + 1.70158 * (u - 1) ^ 2
	if roll.Spot then
		roll.Spot.BackgroundTransparency = 1 - u
	end
	-- (review round 1) the machine's title leaves as the egg rises (the mock's title fade): the crack word is the one headline
	H.titleAlpha(roll, 1 - math.min(1, u / K.LOOK.TITLE_OUT))
	for _, e in pairs(roll.Eggs) do
		if e.Egg and e.RiseTo then
			e.Egg.Position = e.RiseFrom:Lerp(e.RiseTo, quad)
			e.Pop.Scale = e.PopFrom + (1 - e.PopFrom) * back
			e.Ped.Position = e.PedFrom:Lerp(e.PedTo, back)
		end
		if e.Plinth and e.PedTo then
			-- (roll-look) the plinth rises into place (its box's Back Out above) and fades in over the whole rise; (U9-2b look
			-- review 2) no scale pop: a kit block's pixel edges stay whole
			e.Plinth:SetAlpha(u)
		end
		if e.Glows and e.Back.Visible then
			for _, disc in ipairs(e.Glows) do
				H.glowAlpha(disc, u)
			end
		end
	end
	if roll.UI.Strips and S.Lay then
		-- the strips slide away: down, slow then fast (the egg has left them by then); (review round 2) Strips ends at the
		-- bottom bar's top line and clips, so they go behind it (the mock's strip leaves before the chips' row)
		local top = S.Lay.Strip and S.Lay.Strip.Y and S.Lay.Strip.Y[1] or 0
		local dy = (S.Lay.H - top) * u * u
		local floor = S.Lay.BarRoll and S.Lay.BarRoll.Y or S.Lay.H
		roll.UI.Strips.Position = UDim2.fromOffset(0, dy)
		roll.UI.Strips.Size = UDim2.new(1, 0, 0, math.max(0, floor - dy))
	end
	if u >= 1 then
		roll.Rising = false
	end
end

-- (review round 1) the title at alpha a (1 = as built .. 0 = gone: its text, its classic stroke and its outline); 0 is
-- remembered (roll.TitleOut) so a resize keeps it gone
function H.titleAlpha(roll, a)
	local title = roll.UI.Title
	if not (title and title.Parent) then
		return
	end
	if not roll.TitleRest then
		local outline = title:FindFirstChild("TextOutline") or title:FindFirstChildOfClass("UIStroke")
		roll.TitleRest = { Stroke = title.TextStrokeTransparency, Outline = outline, OutlineA = outline and outline.Transparency or 1 }
	end
	local rest = roll.TitleRest
	title.TextTransparency = 1 - a
	title.TextStrokeTransparency = 1 - a * (1 - rest.Stroke)
	if rest.Outline then
		rest.Outline.Transparency = 1 - a * (1 - rest.OutlineA)
	end
	roll.TitleOut = a <= 0
end

function R.dropStrips(roll)
	for _, st in pairs(roll.Strips) do
		st.Frame:Destroy()
	end
	roll.Strips = {}
	if roll.UI.Strips then
		roll.UI.Strips.Visible = false
	end
end

-- (egg-3d, spec 16.14) the real Blender egg in a ViewportFrame inside the hero egg's frame (egg-cards, spec 16.18: x1 and
-- x3, R.rise asks H.use3d first; at most one ViewportFrame egg on a phone). It takes the frame's place, size, rise and
-- push-in; the 2D paint hides, the backlight, ring, cracks, leaks, sparks and Rays / Aura stay round it. No id for the
-- key, Low graphics, the phone limit or a failed Assemble: nothing changes (today's 2D egg).
function B.egg3d(roll, e, rarity)
	if not e.Egg then
		return
	end
	local view = Egg3D.New(e.Egg, rarity, { Phone = EggStage.Layout() ~= "PC", ZIndex = e.Egg.ZIndex + 2, Turn = K.EGG3D.Turn, Spin = K.EGG3D.Spin })
	if view then
		EggArt.SetPaintShown(e.Egg, false)
		e.Egg:SetAttribute("Egg3D", view.Key)
		e.V3 = view
	end
end

-- (kit-b U9-2b look review) a 2D hero egg in the strip cards' picture style: the card's own Blender picture
-- (HatchLook.EggImage) as an ImageLabel "EggPic" in the hero egg's frame (its square EGG_PIC.Fill of the egg's height
-- tall, centred: the egg the same size as the painted one), the paint hidden as for a 3D egg; the frame keeps its place,
-- rise, push-in, shakes, cracks and leaks. B.halves splits the same picture at the burst (H.picHalves). No picture id:
-- nothing changes (today's painted egg)
function B.eggPic(e, rarity)
	local url = HatchLook.EggImage(rarity)
	if not (e.Egg and url) then
		return
	end
	EggArt.SetPaintShown(e.Egg, false)
	local fill = HatchLook.Metrics.EGG_PIC.Fill
	Util.Create("ImageLabel", {
		Name = "EggPic", Image = url, BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1 / (fill * EggArt.Metrics.WIDTH), 1 / fill),
		ZIndex = e.Egg.ZIndex + 2, Parent = e.Egg,
	})
	e.Egg:SetAttribute("EggPic", rarity)
	e.PicUrl = url
end

-- (look review) the burst's two halves of a picture egg: two CanvasGroups the egg's width x half its height (as
-- EggArt.Halves: they clip their half, turning or not), each holding the whole picture placed where the egg stood
function H.picHalves(holder, url, size)
	local w = math.floor(EggArt.Metrics.WIDTH * size + 0.5)
	local half = size / 2
	local side = size / HatchLook.Metrics.EGG_PIC.Fill
	local out = {}
	for i, name in ipairs({ "HalfTop", "HalfBottom" }) do
		local group = Util.Create("CanvasGroup", {
			Name = name, BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, (i - 1) * half), Size = UDim2.fromOffset(w, half),
			ZIndex = holder.ZIndex, Parent = holder,
		})
		Util.Create("ImageLabel", {
			Name = "EggPic", Image = url, BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit,
			Position = UDim2.fromOffset((w - side) / 2, (size - side) / 2 - (i - 1) * half), Size = UDim2.fromOffset(side, side), ZIndex = holder.ZIndex, Parent = group,
		})
		out[i] = group
	end
	return out[1], out[2]
end

-- (egg-cards, spec 16.18) whether this roll's hero eggs are 3D: decided once, for all of them (an x3 asks Egg3D for its
-- three frames at once: Low graphics, an id 0 or a phone's one-frame limit keep every egg 2D, never a mix)
function H.use3d(roll)
	local phone = EggStage.Layout() ~= "PC"
	for _, pull in ipairs(roll.Pulls) do
		if not Egg3D.Usable(pull.Rarity, { Phone = phone, Need = roll.N }) then
			return false
		end
	end
	return true
end

-- (egg-cards) an x3 whose Assemble failed part-way: the views already made go and their eggs are painted again
function B.unmix3d(roll)
	local all = true
	for _, e in pairs(roll.Eggs) do
		all = all and e.V3 ~= nil
	end
	if all then
		return
	end
	for _, e in pairs(roll.Eggs) do
		if e.V3 then
			e.V3:Destroy()
			e.V3 = nil
			EggArt.SetPaintShown(e.Egg, true)
			e.Egg:SetAttribute("Egg3D", nil)
		end
	end
end

function B.halves(roll, j)
	local e = roll.Eggs[j]
	local cr = S.Lay.Crack
	local w = math.floor(EggArt.Metrics.WIDTH * cr.E + 0.5)
	local holder = H.frame(roll.UI.Hero, "Halves" .. j, { Visible = false, ZIndex = 6 })
	holder:SetAttribute("Art", "Hatch")
	H.place(holder, cr.Cx[j] - w / 2, cr.EggY, w, cr.E)
	e.Holder, e.HolderSize = holder, cr.E
	-- (egg-3d) a 3D egg whose two Blender halves are usable here splits into them at the burst (the ViewportFrame moves
	-- into this holder); otherwise today's 2D halves, under the same flash
	e.Split3D = e.V3 ~= nil and e.V3:CanSplit() or false
	holder:SetAttribute("Split3D", e.Split3D)
	if not e.Split3D then
		-- (look review) a picture egg splits its own picture; else today's painted halves
		if e.PicUrl then
			e.Top, e.Bottom = H.picHalves(holder, e.PicUrl, cr.E)
		else
			e.Top, e.Bottom = EggArt.Halves(holder, roll.Pulls[j].Rarity, cr.E)
		end
	end
end

function R.crack(roll, j)
	local e = roll.Eggs[j]
	e.State = "Crack"
	e.Egg:SetAttribute("State", "Crack")
	local rarity = roll.Pulls[j].Rarity
	R.word(roll)
	B.halves(roll, j)
	-- the first crack and its light; the push-in over the shakes (the egg grows on its foot to K.PUSH)
	e.Step, e.Shook = 1, 0
	HatchFx.Cracks(e.Egg, rarity, 1)
	HatchFx.Leaks(e.Egg, rarity, 1)
	-- (review round 2) High only: the pick's card A ("blur and push-in off on Low"), spec 16.15 "Fallbacks"
	if H.high() then
		H.tween(e.Pop, roll.T.Crack * 0.9, { Scale = K.PUSH }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	end
	if e.V3 then
		-- the turn eases to a stop as the first crack glows (the cracks are drawn on the screen: the egg holds under them)
		e.V3:Settle(roll.T.Crack * K.EGG3D.Settle)
	end
	H.sfx(K.SOUND.Crack, H.scaleFor(rarity))
end

-- the crack word names the egg that bursts next: x3's eggs crack 0.6 s apart and overlap, so it is the earliest one
-- still cracking (after the last burst it keeps the last word until the reveal hides it)
function R.word(roll)
	local word = roll.UI.Crack
	for j = 1, roll.N do
		local e = roll.Eggs[j]
		if word and e and e.State == "Crack" then
			local rarity = roll.Pulls[j].Rarity
			local text = string.upper(rarity) .. " EGG!"
			if word.Text ~= text or not word.Visible then
				-- (review round 1) the label stays white: its gradient and outline take the rarity (HatchLook.Word)
				roll.CrackWord:SetText(text)
				roll.CrackWord:SetRarity(rarity)
				word.Visible = true
				H.placeWord(roll, S.Lay)
			end
			return
		end
	end
end

-- the shakes: two (one on Fast hatch), +-6 then +-10 degrees with a squash (wider and lower: never taller, so the
-- push-in's room above the egg holds); at each the cracks grow (1 -> 3 -> 5), the light leaks lengthen, small sparks pop
function R.shake(roll, j, u)
	local e = roll.Eggs[j]
	local C = roll.T.Crack
	local rot, squash = 0, 0
	local windows = roll.Fast and K.SHAKE_FAST or K.SHAKE
	for k, w in ipairs(windows) do
		local a, b = w[1] * C, w[2] * C
		if u >= a and u <= b then
			local s = (u - a) / (b - a)
			rot = w[3] * math.sin(s * math.pi * 6)
			squash = math.sin(s * math.pi)
		end
		if u >= a and e.Shook < k then
			e.Shook = k
			R.shakeStart(roll, j, (k == #windows) and 5 or 3)
		end
	end
	local E = S.Lay.Crack.E
	local w0 = math.floor(EggArt.Metrics.WIDTH * E + 0.5)
	if e.V3 then
		-- (egg-3d) the 3D egg rocks about its middle in 3D and dips; the cracks and leaks turn with it on screen (the frame
		-- itself stays square to the screen and unsquashed: the ViewportFrame's camera keeps its framing)
		e.Egg.Rotation = 0
		e.V3:Pose(rot, -K.EGG3D.Dip * squash)
		for _, name in ipairs(K.EGG3D.Turns) do
			local layer = e.Egg:FindFirstChild(name)
			if layer then
				layer.Rotation = rot
			end
		end
		e.Egg.Size = UDim2.fromOffset(w0, E)
		return
	end
	e.Egg.Rotation = rot
	e.Egg.Size = UDim2.fromOffset(w0 * (1 + K.SQUASH * squash), E * (1 - K.SQUASH * squash))
end

function R.shakeStart(roll, j, step)
	local e = roll.Eggs[j]
	local rarity = roll.Pulls[j].Rarity
	local cr = S.Lay.Crack
	e.Step = step
	HatchFx.Cracks(e.Egg, rarity, step)
	HatchFx.Leaks(e.Egg, rarity, step)
	roll.Pool:Burst(Vector2.new(cr.Cx[j], cr.EggY + 0.6 * cr.E), rarity, K.SHAKE_SPARKS, K.SHAKE_SPARK)
	H.sfx(K.SOUND.Shake, H.scaleFor(rarity))
	if e.Shook == 1 then
		R.tweak(roll, j) -- (the first shake: step 3, or a Fast hatch's one shake)
	end
end

-- (roll-look, spec 16.15) Gemini's shake tweak, Rare and up only (Common / Uncommon: nothing until the burst, no fake
-- tease): the plinth's rim, ring and glow and the cloud ring turn the rarity colour; the rays come up faint and start
-- turning behind the egg (x3: only for the best pull, the rays' one owner; the bursts move them on)
function R.tweak(roll, j)
	local e = roll.Eggs[j]
	local rarity = roll.Pulls[j].Rarity
	if not e or roll.Tweaked[j] or H.order(rarity) < 3 then
		return
	end
	roll.Tweaked[j] = true
	local tw = roll.Fast and K.LOOK.TWEAK.Fast or K.LOOK.TWEAK.Tween
	local color = H.color(rarity)
	e.Tint = color
	if e.Plinth then
		e.Plinth:Tint(color, tw)
	end
	if e.Ring then
		e.Ring:Tint(color, tw)
	end
	if j == roll.Best and roll.Rays and not roll.RaysAt then
		local cr = S.Lay.Crack
		roll.TweakRays = j
		roll.Rays:Recolor(rarity)
		roll.Rays:Place(cr.Cx[j], cr.EggY + cr.E / 2, K.RAYS * cr.E)
		roll.Rays:Flash(K.LOOK.TWEAK.Rays, tw)
		roll.Rays:Spin(true)
	end
end

-- (roll-look) the burst's punch: the stage's world (Hero, Burst following it; review round 1: never the title or the
-- chips, which clipped at the screen's edges) 1 -> 1.05 -> 1 round its middle (High only; a Fast hatch's shorter
-- burst squeezes it so it is over before the reveal). Phase tweens: the reveal and a resize put it back to 1
function R.punch(roll)
	local pu = S.Punch
	if not (pu and pu.Parent) or not H.high() then
		return
	end
	local P = K.LOOK.PUNCH
	local k = math.min(1, (roll.T.Burst - 0.01) / (P.Up + P.Down))
	pu.Scale = 1
	local up = H.tween(pu, P.Up * k, { Scale = P.Scale }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	if up then
		up.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and S.Punch == pu and pu.Parent then
				H.tween(pu, P.Down * k, { Scale = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
			end
		end)
	end
end

-- (roll-look) a burst's sparks: the rarity's count, capped on phones
function H.sparks(rarity)
	local n = K.SPARKS[rarity] or 12
	if S.Lay and not S.Lay.PC then
		n = math.min(n, K.LOOK.PHONE_SPARKS)
	end
	return n
end

function R.burst(roll, j)
	local e = roll.Eggs[j]
	e.State = "Burst"
	e.Egg:SetAttribute("State", "Burst")
	e.Egg.Visible = false
	e.Egg.Rotation = 0
	roll.Pool:StopAmbient(e.Egg)
	EggArt.SetVfx(e.Egg, false) -- (hidden from here: its sheen and VFX stop)
	local pull = roll.Pulls[j]
	local rarity = pull.Rarity
	local color = H.color(rarity)
	local cr = S.Lay.Crack
	local T = roll.T
	local cx, cy = cr.Cx[j], cr.EggY + cr.E / 2
	-- (egg-3d) the 3D egg splits into its two Blender halves at the exact pose it cracked in and they fly apart (the
	-- ViewportFrame moves into the halves' holder, the hidden hero frame's box); a split that fails falls back to the 2D
	-- halves under the same flash
	if e.Split3D and e.V3 and e.Holder then
		e.V3.Frame.Parent = e.Holder
		e.Holder.Visible = true
		if not (e.V3:Split() and e.V3:Fly(T.Burst)) then
			e.V3:Destroy()
			e.V3 = nil
			e.Split3D = false
			e.Holder:SetAttribute("Split3D", false)
			e.Top, e.Bottom = EggArt.Halves(e.Holder, rarity, e.HolderSize or cr.E)
		end
	elseif e.V3 then
		e.V3:Destroy() -- (its halves have no ids: today's 2D halves take over under the flash)
		e.V3 = nil
	end
	-- the halves fly apart: the top spins up-left and fades; (review round 1, the pick's Baseline "the shell flies away at
	-- the burst", the mock's halfB) the bottom tumbles down-right and fades too: no shell is left for the pet to stand in
	if e.Holder and e.Top and e.Bottom then
		e.Holder.Visible = true
		H.tween(e.Top, T.Burst, { Position = UDim2.fromOffset(-0.25 * cr.E, -0.45 * cr.E), Rotation = -35, GroupTransparency = 1 })
		H.tween(e.Bottom, T.Burst, { Position = UDim2.fromOffset(0.45 * cr.E, cr.E / 2 + 0.3 * cr.E), Rotation = 28, GroupTransparency = 1 })
	end
	-- the shock ring, the rays flashing in and turning, the cloud ring's swell in the rarity colour, the sparks
	roll.Shock:Play(cx, cy, K.SHOCK * cr.E, T.Burst, color:Lerp(K.WHITE, 0.2))
	roll.RaysAt = j
	roll.Rays:Recolor(rarity)
	roll.Rays:Place(cx, cy, K.RAYS * cr.E)
	roll.Rays:Flash(0.3, 0.12)
	roll.Rays:Spin(true)
	if e.Ring then
		e.Ring:Spin(false)
		e.Ring:Pulse(color, T.Burst)
	end
	-- (roll-look) below Rare the plinth takes its colour now (the tweak gave it to Rare and up at the first shake); the punch
	if e.Plinth and not e.Tint then
		e.Tint = color
		e.Plinth:Tint(color, math.min(K.LOOK.BURST_TINT, T.Burst))
	end
	R.punch(roll)
	local n = roll.Pool:Burst(Vector2.new(cx, cy), rarity, H.sparks(rarity))
	roll.UI.Burst:SetAttribute("Sparks", n)
	H.sfx(K.SOUND.Burst, H.scaleFor(rarity))
	H.sfx(K.SOUND.Ring, H.scaleFor(rarity))
	R.word(roll) -- (x3: the word moves on to the next egg still cracking)
	if j == roll.Best then
		-- x3: the loudest reveal sound and the gold flash follow the best pull, on its burst (spec 16.4 "x3")
		if roll.N > 1 then
			R.revealSound(roll)
		end
		R.flash(roll, H.order(rarity) >= K.LOUD_FROM)
	else
		R.flash(roll, false)
	end
end

-- the reveal sound of the best pull, once per roll
function R.revealSound(roll)
	if roll.RevealSoundDone then
		return
	end
	roll.RevealSoundDone = true
	local best = roll.Pulls[roll.Best]
	H.sfx(K.REVEAL_SOUND[best.Rarity] or K.REVEAL_SOUND.Common, H.scaleFor(best.Rarity))
end

-- the flash: white (0.12 s at 0.6 strong) or, once per roll for the best pull from Legendary, gold (a kick at 0.2
-- strong, up to 0.5 in 0.25 s, 0.6 s out); white = false skips the white one (Skip's burst tail). Overlay tweens: they play on over the reveal's start
function R.flash(roll, gold, white)
	if gold and roll.GoldDone then
		gold = false
	end
	local f = S.Flash
	if not f or (not gold and white == false) then
		return
	end
	-- one flash at a time: a new one ends the one before (its tween and its pending fade-out)
	if S.FlashTw then
		pcall(function()
			S.FlashTw:Cancel()
		end)
	end
	S.FlashToken = (S.FlashToken or 0) + 1
	local token = S.FlashToken
	if gold then
		roll.GoldDone = true
		f.BackgroundColor3 = K.GOLD
		f.BackgroundTransparency = K.GOLD_FROM
		-- (review round 1) a roll whose best pull silhouettes (B's, from Legendary) needs a clean frame for its black cut-out:
		-- the gold peaks as early as the time left allows and is gone by the reveal (K.LOOK.GOLD_OUT_SIL, Quad Out; at the
		-- reveal itself, a Skip's tail, it fades straight out). Otherwise 16.4's GOLD_IN up, GOLD_OUT (Quad In) out
		local up, out, outDir = K.GOLD_IN, K.GOLD_OUT, Enum.EasingDirection.In
		if H.order(roll.Pulls[roll.Best].Rarity) >= K.LOOK.SIL.From then
			local left = 0
			if not roll.Revealed and roll.Sched and roll.Start then
				left = math.max(0, roll.Sched.RevealAt - (os.clock() - roll.Start))
			end
			out, outDir = K.LOOK.GOLD_OUT_SIL, Enum.EasingDirection.Out
			up = Util.Clamp(left - out, 0, K.GOLD_IN)
		end
		local function fadeOut()
			if S.FlashToken == token and S.Flash == f and f.Parent then
				S.FlashTw = H.tween(f, out, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, outDir, true)
			end
		end
		if up < 0.02 then
			fadeOut()
		else
			S.FlashTw = H.tween(f, up, { BackgroundTransparency = K.GOLD_PEAK }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, true)
			task.delay(up, fadeOut)
		end
	else
		f.BackgroundColor3 = K.WHITE
		f.BackgroundTransparency = K.WHITE_FLASH[1]
		S.FlashTw = H.tween(f, K.WHITE_FLASH[2], { BackgroundTransparency = 1 }, nil, nil, true)
	end
end

function R.reveal(roll, skipped)
	roll.Revealed = true
	roll.RevealedAt = os.clock()
	roll.Phase = "Reveal"
	if skipped then
		H.stopSounds(roll) -- (Skip: every sound of the roll so far stops)
	end
	R.dropStrips(roll)
	if not roll.HeroBuilt then
		R.rise(roll, true)
	end
	for _, e in pairs(roll.Eggs) do
		if e.V3 then
			e.V3:Destroy()
			e.V3 = nil
		end
		if e.Egg then
			roll.Pool:StopAmbient(e.Egg)
			e.Egg:Destroy()
			e.Egg = nil
		end
		if e.Holder then
			e.Holder:Destroy()
			e.Holder = nil
		end
		if e.Back then
			e.Back.Visible = false
		end
		if e.Ring then
			e.Ring:Destroy()
			e.Ring = nil
		end
		e.State = "Open"
	end
	if roll.Spot then
		roll.Spot.Visible = false
	end
	roll.UI.Crack.Visible = false
	H.cancelTweens()
	H.settleBackdrop(true)
	-- (roll-look) the punch over (a Skip may cut it), every plinth shown in its rarity colour under its pet
	if S.Punch then
		S.Punch.Scale = 1
	end
	for j, e in pairs(roll.Eggs) do
		if e.Plinth then
			e.Tint = e.Tint or H.color(roll.Pulls[j].Rarity)
			e.Plinth.Color = e.Tint
			e.Plinth:Rest()
		end
	end
	B.cols(roll)
	if EggStage._InjectPhaseError == "Reveal" then
		error("injected phase error (Reveal)") -- the test hook: an error inside the reveal's own build
	end
	roll.UI.Reveal.Visible = true
	H.apply()
	local best = roll.Pulls[roll.Best]
	local loud = H.order(best.Rarity) >= K.LOUD_FROM
	local g = S.Lay.Cols[roll.Best]
	local px, py, ps = 0, 0, 0
	if g then
		px, py, ps = g.X + g.Pet.X + g.Pet.S / 2, g.Y + g.Pet.Y + g.Pet.S / 2, g.Pet.S
	end
	if skipped then
		-- the burst's last 0.25 s over the reveal's start (spec 16.4 "Skip"): the shock ring, the rays, the sparks and,
		-- from Legendary, the gold Flash once; no white micro-flash
		roll.Shock:Play(px, py, 1.6 * ps, K.TAIL, H.color(best.Rarity):Lerp(K.WHITE, 0.2))
		roll.Rays:Recolor(best.Rarity)
		if roll.Rays.Frame then
			roll.Rays.Frame.Visible = true
			roll.Rays.Frame.GroupTransparency = 0.3
		end
		roll.Pool:Burst(Vector2.new(px, py), best.Rarity, H.sparks(best.Rarity))
		R.flash(roll, loud, false)
	end
	-- Legendary and up keep slow gold rays behind the best pet (roll-look: dimmed to RAYS_TEXT while the text shows, the
	-- clutter cap); the others' rays fade with the burst's tail
	if loud then
		roll.Rays:Recolor(best.Rarity) -- (x3: the last burst may have been a lesser egg's)
		roll.Rays:Flash(K.LOOK.RAYS_TEXT, 0.2)
		roll.Rays:Spin(true)
	elseif roll.Rays.Frame and roll.Rays.Frame.Visible then
		roll.Rays:Flash(1, K.TAIL)
		local rays, mine = roll.Rays, roll
		task.delay(K.TAIL + 0.02, function()
			if S.Roll == mine then
				rays:Hide()
			end
		end)
	end
	-- the pets pop (0 -> past 1 -> 1, Back); (roll-look, spec 16.15) from Legendary the best pull's pets stand black (B's
	-- silhouette) and the chain (the letters, the name / NEW! / note, the pills) waits SIL for them
	for _, c in pairs(roll.Cols) do
		H.tween(c.Pop, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	local sil = H.order(best.Rarity) >= K.LOOK.SIL.From and K.LOOK.SIL.Hold or 0
	R.chain(roll, sil)
	local mine = roll
	task.delay(0.36, function()
		if S.Roll == mine then
			mine.PopDone = true
		end
	end)
	-- Mythic and Secret: confetti for 1.5 s (as soon as the pool has room for all of it); Secret: the starry backdrop
	if best.Rarity == "Mythic" or best.Rarity == "Secret" then
		roll.ConfettiWanted = best.Rarity
		R.confetti(roll)
	end
	if best.Rarity == "Secret" and S.Stage and not S.Stars then
		S.Stars = HatchFx.Stars(S.Stage, K.STARS)
		S.Stars.Frame.ZIndex = 2
	end
	R.revealSound(roll)
	-- (review round 1) set last: an error anywhere above leaves it nil, and teardown("Error") toasts the pulls then
	roll.RevealBuilt = true
end

-- (roll-look, spec 16.15 "Easing and timings") the reveal's chain from sil (0, or the silhouette's hold): the silhouettes
-- fill at sil, the letters pop 0.05 s apart from sil, the name / NEW! / note rise at sil + 0.2, NEW! pops at sil + 0.4,
-- the pills rise at sil + 0.4 (they still arm by the arming rule: H.armed). Every beat is a task.delay checked against
-- roll.ChainToken (a resize settles the chain and drops the rest: H.settleChain) and the roll still showing
function R.chain(roll, sil)
	local C = K.LOOK.CHAIN
	roll.ChainToken = (roll.ChainToken or 0) + 1
	local token = roll.ChainToken
	-- (review round 1) SPIN AGAIN and DONE arm no sooner than their rise is in place (the silhouette's 0.3 s puts it at 1.0 s,
	-- past ARM_AFTER): never a grey-to-gold repaint, or a paid tap, on a pill still sliding in (H.armed)
	roll.ArmAt = math.max(K.ARM_AFTER, sil + C.Pills + C.PillsIn)
	local function later(at, fn)
		task.delay(math.max(0, at), function()
			if S.Roll == roll and roll.ChainToken == token and not roll.Dead then
				H.safe("chain", fn)
			end
		end)
	end
	for _, c in pairs(roll.Cols) do
		c.Word:Pop(sil, C.Letter, S.Tweens)
		c.NewPop.Scale = 0
		if c.Sil and sil > 0 and c.View then
			c.View.ImageColor3 = Color3.new(0, 0, 0)
		end
	end
	H.textIn(roll, 0)
	H.pillsIn(roll, 0)
	if sil > 0 then
		later(sil, function()
			for _, c in pairs(roll.Cols) do
				if c.Sil and c.View then
					H.tween(c.View, K.LOOK.SIL.Fill, { ImageColor3 = K.WHITE })
				end
			end
		end)
	end
	later(sil + C.Text, function()
		roll.TextIn.Value = 0
		H.tween(roll.TextIn, C.TextIn, { Value = 1 })
	end)
	later(sil + C.New, function()
		for _, c in pairs(roll.Cols) do
			if c.New.Visible then
				local pop = c.NewPop
				local up = H.tween(pop, C.NewIn, { Scale = C.NewPeak })
				if up then
					up.Completed:Connect(function(state)
						if state == Enum.PlaybackState.Completed and pop.Parent then
							local down = H.tween(pop, C.NewOut, { Scale = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
							if down then
								down.Completed:Connect(function(st)
									if st == Enum.PlaybackState.Completed then
										H.blink(c.New:FindFirstChild("Sparkle"))
									end
								end)
							end
						end
					end)
				end
			end
		end
	end)
	later(sil + C.Pills, function()
		roll.PillsIn.Value = 0
		H.tween(roll.PillsIn, C.PillsIn, { Value = 1 })
	end)
end

-- (U9-2b look review 2) the NEW! sparkle blinks SPARKLE.Blinks times (on, off: SPARKLE.Beat s each), one tracked tween of
-- a NumberValue on it; hidden at the end
K.LOOK.SPARKLE = { From = 3, Blinks = 2, Beat = 0.12, Color = Theme.Sign.Stone }
function H.blink(sp)
	if not (sp and sp.Parent) then
		return
	end
	local v = sp:FindFirstChild("Blink") or Util.Create("NumberValue", { Name = "Blink", Value = 0, Parent = sp })
	if not sp:GetAttribute("BlinkWired") then
		sp:SetAttribute("BlinkWired", true)
		v:GetPropertyChangedSignal("Value"):Connect(function()
			local n = 2 * K.LOOK.SPARKLE.Blinks
			local beat = math.floor(v.Value * n)
			sp.Visible = v.Value < 1 and beat % 2 == 0
		end)
	end
	v.Value = 0
	sp.Visible = true
	H.tween(v, 2 * K.LOOK.SPARKLE.Blinks * K.LOOK.SPARKLE.Beat, { Value = 1 }, Enum.EasingStyle.Linear)
end

-- the chain at its end at once (a resize mid-chain: its tweens were cancelled), the beats still pending dropped
function H.settleChain(roll)
	roll.ChainToken = (roll.ChainToken or 0) + 1
	roll.ArmAt = K.ARM_AFTER -- (the pills are in place now: 16.4's rule alone)
	for _, c in pairs(roll.Cols) do
		c.Word:Settle()
		c.NewPop.Scale = 1
		local sp = c.New and c.New:FindFirstChild("Sparkle")
		if sp then
			sp.Visible = false
		end
		if c.View and c.View.Parent then
			c.View.ImageColor3 = K.WHITE
		end
	end
	H.textIn(roll, 1)
	H.pillsIn(roll, 1)
end

-- the confetti falls once the pool can hold all of it (the burst's sparks go back first)
function R.confetti(roll)
	local want = roll.ConfettiWanted
	if not want or not roll.Pool then
		return
	end
	local n = H.high() and K.CONFETTI or math.floor(K.CONFETTI / 2)
	if roll.Pool:Live() + n <= K.POOL then
		roll.ConfettiWanted = nil
		roll.Pool:Confetti(K.CONFETTI, want)
	end
end

function R.advance(roll)
	local t = os.clock() - roll.Start
	if roll.Revealed then
		roll.AgainClock = (roll.AgainClock or 0) + 1
		-- (every 8 heartbeats for the balance and the policy; on the frame the reveal arms or a tap disarms it)
		if roll.AgainClock % 8 == 0 or H.armed() ~= roll.Armed then
			H.refreshAgain()
		end
		R.confetti(roll)
		return
	end
	if roll.SkipWanted then
		R.reveal(roll, true)
		return
	end
	local s = roll.Sched
	if roll.HasStrip and next(roll.Strips) ~= nil then
		if not roll.StartPlayed and t >= s.IntroEnd then
			roll.StartPlayed = true
			H.sfx("SpinStart", K.QUIET)
		end
		R.strips(roll, t)
		R.landStep(roll, t)
	end
	R.warmOne(roll)
	if t >= s.LandEnd and not roll.HeroBuilt then
		R.rise(roll)
	end
	R.riseStep(roll, t)
	if t >= s.RiseEnd and next(roll.Strips) ~= nil then
		R.dropStrips(roll)
	end
	for j = 1, roll.N do
		local e = roll.Eggs[j]
		if e then
			if e.State == "Rise" and t >= s.CrackAt[j] then
				R.crack(roll, j)
			end
			if e.State == "Crack" then
				if t >= s.BurstAt[j] then
					R.burst(roll, j)
				else
					R.shake(roll, j, t - s.CrackAt[j])
				end
			end
			if e.State == "Burst" and t >= s.OpenAt[j] then
				e.State = "Open"
				if e.Egg then
					e.Egg:SetAttribute("State", "Open")
				end
			end
		end
	end
	if t >= s.RevealAt then
		R.reveal(roll, false)
		return
	end
	roll.Phase = R.phaseAt(roll, t)
	if EggStage._InjectPhaseError ~= nil and roll.Phase == EggStage._InjectPhaseError then
		error("injected phase error (" .. tostring(roll.Phase) .. ")")
	end
end

-- builds one pulled pet's model ahead of the reveal (one build a frame, while the strip runs). S.Warm[petId]: true =
-- built, false = its build failed (never tried again this session: review round 1, a failing build ran every frame and
-- kept the later pulls cold), nil = not tried yet
function R.warmOne(roll)
	local builder = nil
	for _, pull in ipairs(roll.Pulls) do
		if S.Warm[pull.PetId] == nil then
			builder = builder or H.lazy("Builder", Shared, "PetBuilder")
			if not (builder and type(builder.Build) == "function") then
				return -- no builder (yet): nothing is marked, the next frame asks again
			end
			local ok, model = pcall(builder.Build, pull.Def, { Scale = 1 })
			if ok and typeof(model) == "Instance" then
				model:Destroy()
				S.Warm[pull.PetId] = true
			else
				S.Warm[pull.PetId] = false
			end
			return
		end
	end
end

-- the one Heartbeat: the phases, then the spark pool (driven from here: no Heartbeat of its own)
function R.step(dt)
	local roll = S.Roll
	if not roll then
		return
	end
	local ok, err = pcall(R.advance, roll)
	if not ok and S.Roll == roll then
		H.warnOnce("phase", err)
		H.teardown("Error")
		return
	end
	if S.Roll == roll and roll.Pool then
		pcall(roll.Pool.Step, roll.Pool, tonumber(dt) or (1 / 60))
	end
end

----------------------------------------------------------------------
-- open, rolls, exits
----------------------------------------------------------------------
function H.open()
	if not B.gui() then
		return false
	end
	-- (roll-look, spec 16.15 "The HUD hides") every other Enabled ScreenGui goes off while the stage shows (HatchLook.KEEP
	-- and Roblox's own stay), and one added meanwhile too; every teardown switches them back on (HatchLook.RestoreHud)
	local pg = S.Gui.Parent
	HatchLook.HideHud(pg, S.Gui)
	S.Conns[#S.Conns + 1] = pg.ChildAdded:Connect(function(child)
		H.safe("hud", HatchLook.HideOne, child)
	end)
	if not S.Beat then
		S.Beat = RunService.Heartbeat:Connect(R.step)
	end
	S.Conns[#S.Conns + 1] = S.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		H.safe("resize", H.relayout)
	end)
	S.Conns[#S.Conns + 1] = LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
		if H.inMatch() and (S.Roll or S.Gui) then
			H.teardown("Match")
		end
	end)
	S.Conns[#S.Conns + 1] = ClientSettings.Changed:Connect(function(key)
		if key == "FastHatch" then
			H.paintFast(S.Roll)
		end
	end)
	if not S.Bound then
		S.Bound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					H.safe("back", EggStage.Back)
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	end
	local mc = H.menu()
	if mc and type(mc.SetTouchHidden) == "function" then
		pcall(mc.SetTouchHidden, "Hatch", true)
	end
	return true
end

function H.startRoll(roll)
	S.Roll = roll
	roll.Start = os.clock()
	roll.Phase = "Intro"
	S.Lay = L.compute(roll.N, roll)
	B.roll(roll)
	-- (owner's log 2026-11-27, "[EggStage] resize: ...HatchLook:1326") the roll is published above before its chips exist:
	-- a resize signalled while B.roll builds (a new NimbusHatch's first layout can fire it at once) is held (H.relayout)
	-- and taken here, the layout read again for the new screen
	roll.Built = true
	if roll.ResizedInBuild then
		roll.ResizedInBuild = nil
		S.Lay = L.compute(roll.N, roll)
	end
	H.apply()
	-- the intro: the dim, the vignette, the title sliding down
	if S.Dim and S.Dim.BackgroundTransparency > K.DIM then
		H.tween(S.Dim, roll.T.Intro, { BackgroundTransparency = K.DIM })
	end
	for _, edge in ipairs(S.Vignette:GetChildren()) do
		if edge:IsA("Frame") and edge.BackgroundTransparency > K.VIGNETTE then
			H.tween(edge, roll.T.Intro, { BackgroundTransparency = K.VIGNETTE })
		end
	end
	local title = roll.UI.Title
	local final = title.Position
	title.Position = final + UDim2.fromOffset(0, -20)
	H.tween(title, roll.T.Intro, { Position = final })
	-- the world behind: the blur and the cool tint (High only; one effect + the "Hatch" preset, ours)
	S.Dimmed = true
	pcall(HatchFx.Dim, true, roll.T.Intro)
end

function H.finishRoll()
	local roll = S.Roll
	S.Roll = nil
	if roll then
		roll.Dead = true
		for _, v in ipairs(roll.Views) do
			pcall(v.Destroy)
		end
		roll.Views = {}
		for _, key in ipairs({ "Rays", "Shock", "Pool" }) do
			local fx = roll[key]
			if fx then
				pcall(fx.Destroy, fx)
			end
		end
		for _, e in pairs(roll.Eggs) do
			if e.Ring then
				pcall(e.Ring.Destroy, e.Ring)
			end
			if e.V3 then
				pcall(e.V3.Destroy, e.V3)
				e.V3 = nil
			end
		end
		roll.Sounds = {}
	end
	if S.Stars then
		pcall(S.Stars.Destroy)
		S.Stars = nil
	end
	H.cancelTweens(true)
	S.FlashTw = nil
	S.FlashToken = (S.FlashToken or 0) + 1
	S.Punch = nil -- (it lives in the roll's Hero, destroyed below)
	if S.Content then
		for _, child in ipairs(S.Content:GetChildren()) do
			if child ~= S.Fit then
				child:Destroy()
			end
		end
	end
	if S.Flash then
		S.Flash.BackgroundTransparency = 1
	end
end

function H.namesOf(roll, out)
	for _, p in ipairs(roll.Pulls) do
		out[#out + 1] = p.Def.Name
	end
	return out
end

-- every exit ends here: the pulls not shown yet are toasted, then everything this module made goes, then Closed(reason)
function H.teardown(reason)
	local roll = S.Roll
	if not roll and not S.Gui then
		return
	end
	if reason ~= "Done" then
		local names = {}
		-- the roll's pulls unless its reveal was fully built (an error inside R.reveal leaves RevealBuilt nil)
		if roll and (not roll.Revealed or not roll.RevealBuilt) then
			H.namesOf(roll, names)
		end
		for _, result in ipairs(S.Queue) do
			local queued = H.makeRoll(result)
			if queued then
				H.namesOf(queued, names)
			end
		end
		S.Queue = {}
		if #names > 0 then
			H.toast(K.TEXT.Hatched .. table.concat(names, ", "))
		end
		H.stopSounds(roll) -- (DONE lets the reveal's sound ring out; every other exit stops the roll's sounds)
	end
	EggStage._InjectPhaseError = nil
	H.finishRoll()
	if S.Dimmed then
		S.Dimmed = false
		pcall(HatchFx.Dim, false, 0.35)
	end
	if S.Beat then
		S.Beat:Disconnect()
		S.Beat = nil
	end
	for _, conn in ipairs(S.Conns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	S.Conns = {}
	if S.Bound then
		S.Bound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
	local mc = H.menu()
	if mc and type(mc.SetTouchHidden) == "function" then
		pcall(mc.SetTouchHidden, "Hatch", false)
	end
	H.safe("hud", HatchLook.RestoreHud)
	if S.Gui then
		S.Gui:Destroy()
	end
	S.Gui, S.Stage, S.Content, S.Fit, S.Dim, S.Flash, S.Vignette, S.Lay, S.Punch = nil, nil, nil, nil, nil, nil, nil, nil, nil
	pcall(EggStage.Closed.Fire, EggStage.Closed, reason)
end

-- the backdrop at rest (after its tweens were cancelled): the dim, the vignette edges, no flash (keepFlash: the
-- reveal's start, where the burst's flash plays on)
function H.settleBackdrop(keepFlash)
	if S.Dim then
		S.Dim.BackgroundTransparency = K.DIM
	end
	if S.Vignette then
		for _, edge in ipairs(S.Vignette:GetChildren()) do
			if edge:IsA("Frame") then
				edge.BackgroundTransparency = K.VIGNETTE
			end
		end
	end
	if S.Flash and not keepFlash then
		S.Flash.BackgroundTransparency = 1
	end
end

function H.relayout()
	local roll = S.Roll
	if not roll or not S.Content then
		return
	end
	if not roll.Built then
		roll.ResizedInBuild = true -- (a half-built roll: H.startRoll lays it out for the new screen once B.roll is done)
		return
	end
	H.cancelTweens(true)
	S.FlashToken = (S.FlashToken or 0) + 1
	S.Lay = L.compute(roll.N, roll)
	H.settleBackdrop()
	if S.Punch then
		S.Punch.Scale = 1 -- (roll-look: a punch cut short by the resize)
	end
	if roll.UI.Strips then
		roll.UI.Strips.Position = UDim2.fromOffset(0, 0)
		roll.UI.Strips.Size = UDim2.fromScale(1, 1)
	end
	-- (review round 2) once the eggs have lifted out (the rise began) the strips are only leaving: a resize drops them now
	-- instead of rebuilding their cards (H.applyStrips) and snapping them back on the screen until the rise's end
	if roll.HeroBuilt and next(roll.Strips) ~= nil then
		R.dropStrips(roll)
	end
	for _, c in pairs(roll.Cols) do
		c.Pop.Scale = 1
	end
	roll.PopDone = roll.Revealed
	-- a resize mid-rise ends the rise where it was going (H.apply puts the eggs and pedestals at their new places)
	roll.Rising = false
	for _, e in pairs(roll.Eggs) do
		if e.Pop and e.State == "Rise" then
			e.Pop.Scale = 1
		end
	end
	H.apply()
	H.settleHero(roll)
	if roll.Revealed then
		H.settleChain(roll) -- (roll-look) every letter at 1, the silhouette filled, the text and the pills in place
	end
	-- (roll-look) the strips at rest: the window's bounce done and its tell colour snapped; (look review) a landed card at
	-- rest (its hop done: no scale)
	for _, st in pairs(roll.Strips) do
		if st.Win then
			st.Win:Rest()
		end
		local cell = st.Landed and H.landedCell(st)
		if cell then
			HatchLook.SetPop(cell.Card)
		end
	end
	-- the overlay at rest: the shock gone, the rays shown only where they stay (Legendary and up on the reveal) or while a
	-- burst's tail would still play (they go with the next burst or the reveal)
	if roll.Shock then
		roll.Shock:Hide()
	end
	if roll.Rays and roll.Rays.Frame then
		if roll.Revealed and H.order(roll.Pulls[roll.Best].Rarity) >= K.LOUD_FROM then
			roll.Rays.Frame.Visible = true
			roll.Rays.Frame.GroupTransparency = K.LOOK.RAYS_TEXT
			roll.Rays:Spin(true)
		elseif not roll.Revealed and roll.TweakRays and not roll.RaysAt then
			-- (roll-look) Gemini's tweak played and no burst yet: the faint turning rays stay
			roll.Rays.Frame.Visible = true
			roll.Rays.Frame.GroupTransparency = K.LOOK.TWEAK.Rays
			roll.Rays:Spin(true)
		else
			roll.Rays:Hide()
		end
	end
end

-- (review round 2) the reveal is armed ARM_AFTER after it appeared and ARM_QUIET after the last tap on the stage;
-- (roll-look review round 1) and not before the pills' rise is in place (roll.ArmAt, R.chain: 1.0 s from Legendary; and
-- roll.PillK at 1, so a late frame never arms a pill still sliding in)
function H.armed()
	local roll = S.Roll
	if not (roll and roll.Revealed and roll.RevealedAt) then
		return false
	end
	local now = os.clock()
	return now - roll.RevealedAt >= (roll.ArmAt or K.ARM_AFTER) and now - S.LastTap >= K.ARM_QUIET and (roll.PillK or 1) >= 1
end

-- one tap on the stage (the Dim, the Skip chip, SPIN AGAIN or DONE; Esc and B are keys, not taps): returns whether the
-- reveal was armed before it, then restarts the wait, so a mash never arms SPIN AGAIN
function H.press()
	local armed = H.armed()
	S.LastTap = os.clock()
	return armed
end

-- a tap anywhere outside the buttons, or the Skip chip: skip before the reveal (at once, spec 16.4), close it once armed
function H.tap()
	local roll = S.Roll
	if not roll then
		return
	end
	local armed = H.press()
	if roll.Revealed then
		if armed then
			EggStage.Done()
		end
	else
		EggStage.Skip()
	end
end

-- DONE: closes the reveal (or plays the next queued result) once armed
function H.doneTap()
	if H.press() then
		EggStage.Done()
	end
end

-- SPIN AGAIN: a new paid request once armed, and only while it shows enabled (no reason, not pending)
function H.againTap()
	local roll = S.Roll
	local btn = roll and roll.UI.Again
	if H.press() and btn and btn:GetAttribute("Disabled") ~= true then
		H.again()
	end
end

function H.again()
	local roll = S.Roll
	if not roll or not roll.Revealed or not roll.Roulette then
		return
	end
	if EggStage.Request(roll.Roulette.Id, roll.Currency, roll.N > 1 and 3 or 1) then
		S.PendFrom = "Again"
	end
end

----------------------------------------------------------------------
-- public API
----------------------------------------------------------------------
function EggStage.Init()
	if S.Inited then
		return
	end
	S.Inited = true
	-- (egg-cards review round 1) the card pictures fetched at the client's start, well before a first roll shows them
	H.safe("PreloadEggImages", HatchLook.PreloadEggImages)
	local remote = H.remote("RouletteResult")
	if remote then
		remote.OnClientEvent:Connect(function(result)
			H.safe("RouletteResult", EggStage._Answer, result)
		end)
	else
		H.warnOnce("Init", "the RouletteResult remote is unavailable")
	end
end

function EggStage.Show(result)
	local roll = H.makeRoll(result)
	if not roll then
		if type(result) == "table" and result.Ok ~= false then
			H.toast(K.TEXT.Fallback)
		end
		return false
	end
	if S.Roll then
		S.Queue[#S.Queue + 1] = result
		return true
	end
	if not H.open() then
		H.toast(K.TEXT.Hatched .. table.concat(H.namesOf(roll, {}), ", "))
		return false
	end
	-- (egg-cards review round 1) asks again before the strip is built: nothing once Init's preload sent every url
	H.safe("PreloadEggImages", HatchLook.PreloadEggImages)
	H.startRoll(roll)
	pcall(EggStage.Opened.Fire, EggStage.Opened)
	return true
end

function EggStage._Answer(result)
	local fromAgain = S.PendFrom == "Again"
	S.Pending = false
	S.PendToken = S.PendToken + 1
	S.PendFrom = nil
	pcall(EggStage.Answered.Fire, EggStage.Answered, result)
	if type(result) ~= "table" then
		H.refreshAgain()
		return
	end
	if result.Ok == false then
		local reason = (type(result.Reason) == "string" and result.Reason ~= "") and result.Reason or K.TEXT.Failed
		H.toast(reason)
		H.refreshAgain()
		return
	end
	local roll = S.Roll
	if roll and roll.Revealed and fromAgain and #S.Queue == 0 then
		local nextRoll = H.makeRoll(result)
		if nextRoll then
			H.finishRoll()
			H.startRoll(nextRoll)
			return
		end
	end
	EggStage.Show(result)
end

function EggStage.Request(rouletteId, currency, spins)
	if S.Pending then
		return false
	end
	local now = os.clock()
	if now - S.LastFire < K.FIRE_GAP then
		return false
	end
	local roulette = H.roulette(rouletteId)
	if not roulette then
		return false
	end
	spins = (spins == 3) and 3 or 1
	currency = (currency == "Gems" or roulette.Id == K.SECRET_ID) and "Gems" or "Tokens"
	if roulette.Id == K.SECRET_ID then
		spins = 1 -- the Secret Roulette is x1 only (spec 13 call 2)
	end
	if H.inMatch() then
		H.toast(K.TEXT.Match)
		return false
	end
	local price = H.price(roulette, currency) * spins
	if not H.spinOpen(currency) then
		-- (lobby-shop 16.12, the owner's pick A: token spins need the same "allowed" answer, while the Store is on)
		H.toast(currency == "Gems" and K.TEXT.Policy or K.TEXT.TokenPolicy)
		return false
	end
	if H.balance(currency) < price then
		H.toast("You need " .. Util.Commas(price) .. (currency == "Gems" and " Gems" or " Cloud Tokens") .. " for that.")
		return false
	end
	local remote = H.remote("BuyRoulette")
	if not remote then
		return false
	end
	local ok = pcall(function()
		remote:FireServer(roulette.Id, currency, spins)
	end)
	if not ok then
		return false
	end
	S.LastFire = now
	S.Pending = true
	S.PendFrom = nil
	S.PendToken = S.PendToken + 1
	local mine = S.PendToken
	pcall(EggStage.Pending.Fire, EggStage.Pending, roulette.Id, currency, spins)
	H.refreshAgain()
	task.delay(K.WAIT_TIMEOUT, function()
		if S.Pending and S.PendToken == mine then
			S.Pending = false
			S.PendFrom = nil
			H.toast(K.TEXT.NoAnswer)
			H.refreshAgain()
		end
	end)
	return true
end

function EggStage.IsPending()
	return S.Pending == true
end

function EggStage.IsShowing()
	return S.Roll ~= nil
end

function EggStage.Phase()
	return S.Roll and S.Roll.Phase or nil
end

function EggStage.Skip()
	local roll = S.Roll
	if roll and not roll.Revealed then
		roll.SkipWanted = true
	end
end

function EggStage.Back()
	local roll = S.Roll
	if not roll then
		return
	end
	if roll.Revealed then
		EggStage.Done()
	else
		EggStage.Skip()
	end
end

function EggStage.Done()
	local roll = S.Roll
	if not roll then
		return
	end
	if not roll.Revealed then
		EggStage.Skip()
		return
	end
	while #S.Queue > 0 do
		local nextRoll = H.makeRoll(table.remove(S.Queue, 1))
		if nextRoll then
			H.finishRoll()
			H.startRoll(nextRoll)
			return
		end
	end
	H.teardown("Done")
end

function EggStage.Close()
	if S.Roll or S.Gui then
		H.teardown("Close")
	elseif #S.Queue > 0 then
		local names = {}
		for _, result in ipairs(S.Queue) do
			local queued = H.makeRoll(result)
			if queued then
				H.namesOf(queued, names)
			end
		end
		S.Queue = {}
		if #names > 0 then
			H.toast(K.TEXT.Hatched .. table.concat(names, ", "))
		end
	end
end

function EggStage.IsPrewarmed(petId)
	return S.Warm[petId] == true
end

function EggStage.Stats()
	local n = 0
	if S.Gui and S.Gui.Parent then
		n = 1
		local skip = {}
		for _, d in ipairs(S.Gui:GetDescendants()) do
			local cur = d.Parent
			local inside = false
			while cur and cur ~= S.Gui do
				if skip[cur] or cur:IsA("ViewportFrame") then
					inside = true
					break
				end
				cur = cur.Parent
			end
			if inside then
				skip[d] = true
			else
				n = n + 1
			end
		end
	end
	local tweens = 0
	for _, set in ipairs({ S.Tweens, S.Overlay }) do
		for tw in pairs(set) do
			local ok, playing = pcall(function()
				return tw.PlaybackState == Enum.PlaybackState.Playing
			end)
			if ok and playing then
				tweens = tweens + 1
			end
		end
	end
	local sparks = 0
	if S.Roll and S.Roll.Pool then
		local ok, live = pcall(S.Roll.Pool.Live, S.Roll.Pool)
		sparks = ok and tonumber(live) or 0
	end
	local effects = 0
	if S.Gui and S.Gui.Parent then
		local ok, fx = pcall(HatchFx.Stats)
		effects = ok and type(fx) == "table" and tonumber(fx.Effects) or 0
	end
	return { Instances = n, Tweens = tweens, Sparks = sparks, Effects = effects, Heartbeats = S.Beat and 1 or 0 }
end

return EggStage
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1188">
            <Properties>
              <string name="Name">ElementsWindow</string>
              <string name="Source"><![CDATA[-- ElementsWindow (client UI; Pitch 2 item 12_elements, the owner's pick A "Wheel"; spec
-- docs/superpowers/specs/2026-11-20-pitch2-build-design.md): the element chart as its own centred kit B window over the
-- Pet Index. Before it, Elements was a scrolling section inside the Index (3 of the 8 elements in view, 18 px arrows, no
-- title bar and no X: the owner's shot 12).
--
--   ElementsWindow.New(gui, opts) -> win      gui: the Index's ScreenGui; opts.OnClose() runs after the window hid;
--                                             opts.OnPlace(left) gets its left edge (gui px) while open, nil on close
--   win.Open() / win.Close() / win.IsOpen() / win.Relayout()   win.Holder (Frame "Window_Elements"), win.Mode
--
-- The window: CloudUI.Panel Skin "Signboard" ("ElementsPanel": navy header, the gold ribbon title ELEMENTS, the red X,
-- the awning on the frame on its two brackets), centred on the screen. Inside, "Chart": the Ring (the 6-loop of
-- Config.Elements.Strong from Order[1]: Water > Flame > Frost > Nature > Earth > Storm, each a kit B block in its
-- element's colour with its pixel glyph and name, "Block_<element>"; each link one pixel arrow at exactly 45 or 90
-- degrees, PixelIcon arrow* on even stairs, never a turned frame; the hub "x1.5 / to where it points") and the Side:
-- "How it works", worked examples (Water -> Flame x1.5 strong, Flame -> Water x0.75 weak; PC also Water vs Earth x1, no
-- arrow) and the rivals (the elements outside the loop, each strong against the other: Celestial <-> Shadow, x1.5 both
-- ways as PetCatalog's singleMultiplier).
-- Three layouts in design px, nothing scrolls in any:
--   PC        1060 x 760 at the screen factor (fitted to the screen): the tall hexagon left, the side column right
--   Short     a landscape phone, 800 x 320 at scale 1 (fitted): a wide hexagon left, a compact column right, no awning
--   Portrait  a phone held upright, 360 x 640 at scale 1 (fitted): the tall hexagon over the examples and the rivals; the
--             window starts low enough for its awning to clear the HUD's currency strips
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon"))
local SignKit = require(Shared:WaitForChild("SignKit"))

local CloudUI = require(script.Parent:WaitForChild("CloudUI"))

local SIGN = Theme.Sign
local INK = SIGN.Text

local ElementsWindow = {}

-- the layouts (design px). Ring: Block w x h, Glyph px, Name text, the arrows' px (Diag at 45 degrees, Straight at 90),
-- Cols (the left x of each block column) and Rows (each block row's top), Slots (the loop's 6 places as { col, row }
-- clockwise from the first element) and Links (the arrow from slot i to slot i + 1); Hub { x, y, w, h, big, small }.
-- Side: X (from the chart's left) and its own parts
local L = {
	PC = {
		-- (look review r0: at 720 the ring filled the body and Nature sat 2-3 px over its foot) 760, so the centred ring keeps
		-- about 20 px of stone over and under it, as the mock's
		W = 1060, H = 760, Roof = true,
		Ring = {
			W = 600, H = 632, Block = { 124, 104 }, Glyph = 36, Name = 22, Diag = 54, Straight = 54,
			Cols = { 68, 238, 408 }, Rows = { 8, 186, 360, 528 },
			Slots = { { 2, 1 }, { 3, 2 }, { 3, 3 }, { 2, 4 }, { 1, 3 }, { 1, 2 } },
			Links = { "arrowse", "arrowdown", "arrowsw", "arrownw", "arrowup", "arrowne" },
			Hub = { 200, 270, 200, 110, 48, 20 }, HubSub = "to where it points",
		},
		Side = {
			X = 636, W = 392, Head = 30, Body = 20, BodyLine = "Each arrow points at the one it beats.", Cards = true,
			Square = 64, SquareGlyph = 36, Arrow = 36, Tag = { 90, 44, 28 }, Caption = 18, RowH = 100, RowGap = 6,
			Examples = { "strong", "weak", "none" }, RivalBlock = { 130, 96, 36, 22 }, RivalArrow = 45, RivalCaption = 18,
			RivalText = "each hits the other x1.5",
		},
	},
	Short = {
		W = 800, H = 320, Roof = false,
		Ring = {
			W = 480, H = 236, Block = { 80, 56 }, Glyph = 18, Name = 15, Diag = 27, Straight = 36,
			Cols = { 0, 120, 280, 400 }, Rows = { 0, 90, 180 },
			Slots = { { 2, 1 }, { 3, 1 }, { 4, 2 }, { 3, 3 }, { 2, 3 }, { 1, 2 } },
			Links = { "arrow", "arrowse", "arrowsw", "left", "arrownw", "arrowne" },
			Hub = { 128, 90, 224, 56, 26, 15 }, HubSub = "to where it points",
		},
		Side = {
			X = 500, W = 276, Head = 20, Cards = false,
			Square = 36, SquareGlyph = 18, Arrow = 27, Tag = { 64, 32, 18 }, Caption = 15, RowH = 40, RowGap = 6,
			-- (look review r0: "rivals: / x1.5 / both" wrapped to 3 lines in 60 px) 78 px blocks leave the caption 72, two lines
			Examples = { "strong", "weak" }, RivalBlock = { 78, 50, 18, 15 }, RivalArrow = 18, RivalCaption = 15,
			RivalText = "rivals: x1.5 both",
		},
	},
	Portrait = {
		W = 360, H = 640, Roof = true,
		Ring = {
			W = 336, H = 312, Block = { 64, 54 }, Glyph = 18, Name = 15, Diag = 27, Straight = 27,
			Cols = { 20, 136, 252 }, Rows = { 0, 86, 172, 258 },
			Slots = { { 2, 1 }, { 3, 2 }, { 3, 3 }, { 2, 4 }, { 1, 3 }, { 1, 2 } },
			Links = { "arrowse", "arrowdown", "arrowsw", "arrownw", "arrowup", "arrowne" },
			Hub = { 106, 120, 124, 72, 26, 14 }, HubSub = "where it points",
		},
		Side = {
			X = 0, W = 336, Head = 0, Cards = false, Below = 18,
			Square = 40, SquareGlyph = 18, Arrow = 27, Tag = { 70, 32, 18 }, Caption = 15, RowH = 44, RowGap = 8,
			Examples = { "strong", "weak" }, RivalBlock = { 84, 54, 18, 15 }, RivalArrow = 18, RivalCaption = 15,
			RivalText = "rivals: x1.5 both",
		},
	},
}
ElementsWindow.Layouts = L
ElementsWindow.ROOF_CLEAR = 26 -- (the Gifts window's rule) design px of clear sky the awning needs over a phone window
ElementsWindow.MARGIN = 12

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function frame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function text(parent, name, str, role, size, color, props)
	local label = Theme.Label(str, role, { Size = size, Color = color })
	label.Name = name
	label.BackgroundTransparency = 1
	label.TextWrapped = false
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

local function info(element)
	return Config.Elements and Config.Elements.Info and Config.Elements.Info[element] or nil
end

-- the loop of Strong from Order[1] (6 elements) and the rest (the rivals), as the Index's old card read them
function ElementsWindow.Cycle()
	local elements = Config.Elements
	if type(elements) ~= "table" or type(elements.Order) ~= "table" or type(elements.Strong) ~= "table" then
		return {}, {}
	end
	local cycle, inCycle = {}, {}
	local current = elements.Order[1]
	while current and not inCycle[current] and #cycle < #elements.Order do
		inCycle[current] = true
		cycle[#cycle + 1] = current
		local nextList = elements.Strong[current]
		current = type(nextList) == "table" and nextList[1] or nil
	end
	if current ~= cycle[1] then
		cycle, inCycle = {}, {}
	end
	local rest = {}
	for _, e in ipairs(elements.Order) do
		if not inCycle[e] then
			rest[#rest + 1] = e
		end
	end
	return cycle, rest
end

-- a pixel icon centred on (cx, cy) of `parent`, its box on a whole design px
local function iconAt(parent, name, px, colour, cx, cy, z)
	local icon = PixelIcon.New(parent, name, px, colour)
	if icon then
		icon.Position = UDim2.fromOffset(math.floor(cx - px / 2 + 0.5), math.floor(cy - px / 2 + 0.5))
		icon.ZIndex = z
		for _, c in ipairs(icon:GetChildren()) do
			if c:IsA("GuiObject") then
				c.ZIndex = z
			end
		end
	end
	return icon
end

-- an element's block: its colour on the face, its darker lip, the wood edge; the glyph over its name in the ink that
-- reads on the colour. `name` false: a glyph-only square (the examples)
local function elementBlock(parent, element, x, y, w, h, glyph, nameSize, z, blockName)
	local data = info(element)
	if not data then
		return nil
	end
	local block = frame(parent, blockName or ("Block_" .. element), {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = z,
	})
	block:SetAttribute("Element", element)
	local lipPx = h >= 50 and 5 or 3
	CloudUI.SignBlock(block, "Stone", { Face = data.Color, LipColor = Theme.Darken(data.Color, 0.28), EdgePx = h >= 50 and 3 or 2, LipPx = lipPx, Pad = false })
	local ink = Theme.TextOn(data.Color)
	local inner = h - lipPx
	if nameSize then
		local nameH = nameSize + 4
		local gap = math.max(2, math.floor((inner - glyph - nameH) / 3))
		iconAt(block, data.Icon or "sparkle", glyph, ink, w / 2, gap + glyph / 2, z + 1)
		text(block, "Name", element, "Heading", nameSize, ink, {
			Position = UDim2.fromOffset(2, gap * 2 + glyph),
			Size = UDim2.fromOffset(w - 4, nameH),
			ZIndex = z + 1,
		})
	else
		iconAt(block, data.Icon or "sparkle", glyph, ink, w / 2, inner / 2, z + 1)
	end
	return block
end

-- a multiplier tag: x1.5 on grass, x0.75 on the red, x1 on stone
local TAGS = {
	strong = { Text = "x1.5", Face = SIGN.Grass, Lip = SIGN.GrassLip, Caption = { "strong hit", "strong" } },
	weak = { Text = "x0.75", Face = SIGN.Red, Lip = SIGN.RedLip, Caption = { "weak hit", "weak" } },
	none = { Text = "x1", Face = SIGN.Tile, Lip = SIGN.StoneLip, Caption = { "no arrow", "no arrow" } },
}
local function tag(parent, kind, x, y, w, h, size, z)
	local t = TAGS[kind]
	local label = text(parent, "Tag_" .. kind, t.Text, "Display", size, Theme.TextOn(t.Face), {
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(w, h),
		ZIndex = z,
	})
	CloudUI.SignBlock(label, "Stone", { Face = t.Face, LipColor = t.Lip, EdgePx = 2, LipPx = 3 })
	label.TextColor3 = Theme.TextOn(t.Face)
	return label
end

----------------------------------------------------------------------
-- the chart
----------------------------------------------------------------------
local function buildRing(chart, spec, cycle, z)
	local R = spec.Ring
	local ring = frame(chart, "Ring", { Size = UDim2.fromOffset(R.W, R.H), ZIndex = z })
	local bw, bh = R.Block[1], R.Block[2]
	local centres = {}
	for i, element in ipairs(cycle) do
		local slot = R.Slots[i]
		if slot then
			local x, y = R.Cols[slot[1]], R.Rows[slot[2]]
			elementBlock(ring, element, x, y, bw, bh, R.Glyph, R.Name, z + 1)
			centres[i] = { x + bw / 2, y + bh / 2 }
		end
	end
	local n = #cycle
	for i = 1, n do
		local a, b = centres[i], centres[i % n + 1]
		local name = R.Links[i]
		if a and b and name then
			local diagonal = name:match("^arrow[ns][ew]$") ~= nil
			local px = diagonal and R.Diag or R.Straight
			local icon = iconAt(ring, name, px, SIGN.Wood, (a[1] + b[1]) / 2, (a[2] + b[2]) / 2, z + 2)
			if icon then
				icon.Name = "Link" .. i
			end
		end
	end
	local H = R.Hub
	local hub = frame(ring, "Hub", { Position = UDim2.fromOffset(H[1], H[2]), Size = UDim2.fromOffset(H[3], H[4]), ZIndex = z + 1 })
	CloudUI.SignBlock(hub, "Stone", { Face = SIGN.Tile, EdgePx = 2, LipPx = 4, Pad = false })
	local bigH = H[5] + 4
	local subH = H[6] + 4
	local top = math.floor((H[4] - 4 - bigH - subH) / 2)
	text(hub, "Mult", "x" .. tostring(Config.Elements.StrongMultiplier or 1.5), "Display", H[5], SIGN.GrassLip, {
		Position = UDim2.fromOffset(0, top),
		Size = UDim2.new(1, 0, 0, bigH),
		ZIndex = z + 2,
	})
	text(hub, "Sub", R.HubSub, "Label", H[6], INK, {
		Position = UDim2.fromOffset(0, top + bigH),
		Size = UDim2.new(1, 0, 0, subH),
		ZIndex = z + 2,
	})
	return ring
end

-- one worked example at y (a card on PC): the attacker's square, the arrow (or "vs"), the defender's, the tag, its words
local function example(side, spec, kind, y, z)
	local S = spec.Side
	local strongMap = Config.Elements.Strong or {}
	local cycle = ElementsWindow.Cycle()
	local a = cycle[1] or "Water"
	local b = (strongMap[a] and strongMap[a][1]) or cycle[2] or "Flame"
	if kind == "weak" then
		a, b = b, a
	elseif kind == "none" then
		b = cycle[5] or "Earth" -- (two steps away on the loop: no arrow either way)
	end
	local row = frame(side, "Example_" .. kind, { Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(S.W, S.RowH), ZIndex = z })
	if S.Cards then
		CloudUI.SignBlock(row, "Stone", { Face = SIGN.Tile, EdgePx = 2, LipPx = 4, Pad = false })
	end
	local pad = S.Cards and 14 or 0
	local q = S.Square
	local qy = math.floor((S.RowH - (S.Cards and 4 or 0) - q) / 2)
	elementBlock(row, a, pad, qy, q, q, S.SquareGlyph, nil, z + 1, "From")
	local x = pad + q + 8
	if kind == "none" then
		text(row, "Vs", "vs", "Heading", S.Caption + 4, INK, {
			Position = UDim2.fromOffset(x, qy),
			Size = UDim2.fromOffset(S.Arrow, q),
			ZIndex = z + 1,
		})
	else
		iconAt(row, "arrow", S.Arrow, SIGN.Wood, x + S.Arrow / 2, qy + q / 2, z + 1)
	end
	x = x + S.Arrow + 8
	elementBlock(row, b, x, qy, q, q, S.SquareGlyph, nil, z + 1, "To")
	x = x + q + 12
	local tw, th, ts = S.Tag[1], S.Tag[2], S.Tag[3]
	local caption = TAGS[kind].Caption[S.Cards and 1 or 2]
	if S.Cards then
		-- the tag on top, its words under it, right-aligned with the card
		local tx = S.W - pad - tw - 40
		tag(row, kind, tx, qy - 4, tw, th, ts, z + 1)
		text(row, "Caption", caption, "Label", S.Caption, INK, {
			Position = UDim2.fromOffset(tx - 40, qy + th),
			Size = UDim2.fromOffset(tw + 80, S.Caption + 6),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = z + 1,
		})
	else
		tag(row, kind, x, math.floor((S.RowH - th) / 2), tw, th, ts, z + 1)
		text(row, "Caption", caption, "Label", S.Caption, INK, {
			Position = UDim2.fromOffset(x + tw + 8, 0),
			Size = UDim2.fromOffset(math.max(10, S.W - (x + tw + 8)), S.RowH),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = z + 1,
		})
	end
	return row
end

local function buildSide(chart, spec, rest, z)
	local S = spec.Side
	local side = frame(chart, "Side", { Size = UDim2.fromOffset(S.W, 10), ZIndex = z })
	local y = 0
	if S.Head > 0 then
		-- (a plain heading in the mock's own case: the ribbon is for the window's title only)
		text(side, "HowItWorks", "How it works", "Heading", S.Head, INK, {
			Size = UDim2.fromOffset(S.W, S.Head + 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = z + 1,
		})
		y = y + S.Head + 8
	end
	if S.Body and S.BodyLine then
		text(side, "Explain", S.BodyLine, "Body", S.Body, INK, {
			Position = UDim2.fromOffset(0, y),
			Size = UDim2.fromOffset(S.W, S.Body + 6),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = z + 1,
		})
		y = y + S.Body + 12
	end
	for _, kind in ipairs(S.Examples) do
		example(side, spec, kind, y, z + 1)
		y = y + S.RowH + S.RowGap
	end
	-- the rivals: the elements outside the loop, each strong against the other
	local a, b = rest[1], rest[2]
	if a and b then
		local rule = SignKit.Rule(side, { Name = "Rule", Width = S.W, ZIndex = z + 1 })
		rule.Position = UDim2.fromOffset(0, y + 4)
		y = y + 12
		if S.Head > 0 then
			text(side, "Rivals", "The rivals", "Heading", S.Head, INK, {
				Position = UDim2.fromOffset(0, y),
				Size = UDim2.fromOffset(S.W, S.Head + 6),
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = z + 1,
			})
			y = y + S.Head + 10
		end
		local RB = S.RivalBlock
		local row = frame(side, "RivalRow", { Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(S.W, RB[2]), ZIndex = z + 1 })
		elementBlock(row, a, 0, 0, RB[1], RB[2], RB[3], RB[4], z + 2)
		local ax = RB[1] + 10
		local ap = S.RivalArrow
		local inner = RB[2] - 5
		iconAt(row, "arrow", ap, SIGN.Wood, ax + ap / 2, inner / 2 - ap / 2 - 2, z + 2)
		iconAt(row, "left", ap, SIGN.Wood, ax + ap / 2, inner / 2 + ap / 2 + 2, z + 2)
		local bx = ax + ap + 10
		elementBlock(row, b, bx, 0, RB[1], RB[2], RB[3], RB[4], z + 2)
		if S.Cards then
			text(side, "RivalCaption", S.RivalText, "Label", S.RivalCaption, INK, {
				Position = UDim2.fromOffset(0, y + RB[2] + 8),
				Size = UDim2.fromOffset(bx + RB[1], S.RivalCaption + 6),
				ZIndex = z + 1,
			})
			y = y + RB[2] + 8 + S.RivalCaption + 6
		else
			local cx = bx + RB[1] + 10
			text(row, "RivalCaption", S.RivalText, "Label", S.RivalCaption, INK, {
				Position = UDim2.fromOffset(cx, 0),
				Size = UDim2.fromOffset(math.max(10, S.W - cx), RB[2]),
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				ZIndex = z + 2,
			})
			y = y + RB[2]
		end
	end
	side.Size = UDim2.fromOffset(S.W, y)
	return side, y
end

----------------------------------------------------------------------
-- the window
----------------------------------------------------------------------
local function viewportOf(gui)
	local cam = Workspace.CurrentCamera
	local vp = cam and cam.ViewportSize
	if vp and vp.X > 2 and vp.Y > 2 then
		return vp
	end
	local s = gui and gui.AbsoluteSize
	return (s and s.X > 2) and s or Vector2.new(1920, 1080)
end

local function insetY()
	local inset = 58
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- the HUD's currency strips' (or the gift's) bottom in gui-area px (0: none), as the Gifts window reads it
local function stripsBottom(gui)
	local pg = gui and gui.Parent
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud then
		return 0
	end
	local gift = tonumber(hud:GetAttribute("GiftSize")) or 0
	if gift > 0 then
		return tonumber(hud:GetAttribute("GiftTop")) or 0
	end
	return tonumber(hud:GetAttribute("TopRightBottom")) or 0
end

-- the mode, the scale and the holder's place (gui-area px) for this screen
function ElementsWindow.Rect(gui)
	local vp = viewportOf(gui)
	local inset = (gui and gui.IgnoreGuiInset) and 0 or insetY()
	local areaW, areaH = vp.X, vp.Y - inset
	local factor = Theme.ScreenFactor(vp.Y)
	local mode
	if areaH > areaW then
		mode = "Portrait"
	elseif areaH / factor < 560 then
		mode = "Short"
	else
		mode = "PC"
	end
	local spec = L[mode]
	local m = ElementsWindow.MARGIN
	local roofRoom = spec.Roof and 22 or 0
	local cap = mode == "PC" and factor or 1
	local scale = math.min(cap, (areaW - 2 * m) / spec.W, (areaH - 2 * m - roofRoom) / spec.H)
	scale = math.max(0.4, scale)
	local w, h = spec.W * scale, spec.H * scale
	local x = math.floor((areaW - w) / 2 + 0.5)
	local y = math.floor((areaH - h + roofRoom * scale) / 2 + 0.5)
	if mode == "Portrait" then
		-- (the Gifts window's rule) the awning clears the currency strips by ROOF_CLEAR when the screen has the room
		local want = stripsBottom(gui) + ElementsWindow.ROOF_CLEAR * scale
		if y < want and want + h <= areaH - m then
			y = math.floor(want + 0.5)
		end
	end
	return { Mode = mode, Scale = scale, X = x, Y = y, W = w, H = h, Inset = inset }
end

function ElementsWindow.New(gui, opts)
	opts = opts or {}
	local win = { Mode = nil, Open_ = false }
	local holder = frame(gui, "Window_Elements", { Visible = false, ZIndex = 10, Active = true })
	local fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	win.Holder = holder
	local panel, chart = nil, nil

	local function build(mode)
		if panel then
			panel.Root:Destroy()
		end
		local spec = L[mode]
		panel = CloudUI.Panel({
			Name = "ElementsPanel",
			Title = "Elements",
			Closable = true,
			Skin = "Signboard",
			Icon = "sparkle",
			Size = UDim2.fromScale(1, 1),
			OnClose = function()
				win.Close()
			end,
			Parent = holder,
		})
		if panel.Roof then
			panel.Roof.Visible = spec.Roof == true -- (a landscape phone: no awning, as the Gifts window's)
		end
		win.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
		local content = panel.Content
		chart = frame(content, "Chart", { Size = UDim2.fromScale(1, 1), ZIndex = 5 })
		local cycle, rest = ElementsWindow.Cycle()
		local contentTop = CloudUI.ContentInset(true)
		local cw, ch = spec.W - 24, spec.H - contentTop - 12
		local ring = buildRing(chart, spec, cycle, 5)
		local side, sideH = buildSide(chart, spec, rest, 5)
		local R = spec.Ring
		if mode == "Portrait" then
			local gap = spec.Side.Below or 16
			local total = R.H + gap + sideH
			local top = math.max(0, math.floor((ch - total) / 2))
			ring.Position = UDim2.fromOffset(math.floor((cw - R.W) / 2), top)
			side.Position = UDim2.fromOffset(math.floor((cw - spec.Side.W) / 2), top + R.H + gap)
		else
			ring.Position = UDim2.fromOffset(0, math.max(0, math.floor((ch - R.H) / 2)))
			side.Position = UDim2.fromOffset(spec.Side.X, math.max(0, math.floor((ch - sideH) / 2)))
		end
		win.Panel = panel
		win.Mode = mode
		holder:SetAttribute("Mode", mode)
	end

	-- (look review r0) the window's left edge to the caller while it is open (nil once it closed): the Index steps the menu
	-- tiles aside where the window reaches over them (844x390: slivers of the tiles showed at its left edge)
	local function place(left)
		if type(opts.OnPlace) == "function" then
			pcall(opts.OnPlace, left)
		end
	end

	function win.Relayout()
		local r = ElementsWindow.Rect(gui)
		local spec = L[r.Mode]
		-- (look review r0) the holder takes its size before the panel is built in it, and the title's ribbon is fitted again
		-- once its label has that box: fitted while the label had no box yet, the ribbon took the full pads its 220 px box
		-- on a 390 px phone has no room for, and its right tail ran under the X
		holder.Position = UDim2.fromOffset(r.X, r.Y)
		holder.Size = UDim2.fromOffset(spec.W, spec.H)
		fit.Scale = r.Scale
		if r.Mode ~= win.Mode or not panel then
			build(r.Mode)
		end
		if panel and panel.TitleLabel then
			Theme.StyleTitle(panel.TitleLabel)
		end
		win.Rect = r
		if win.Open_ then
			place(r.X)
		end
		return r
	end

	function win.IsOpen()
		return win.Open_ == true
	end

	function win.Open()
		win.Relayout()
		local was = win.Open_
		win.Open_ = true
		holder.Visible = true
		place(win.Rect and win.Rect.X or 0)
		if not was and panel then
			SignKit.Rise(panel.Root) -- (Pitch 2 F0) the kit's open: it rises 12 px in 3 hard steps
		end
	end

	function win.Close()
		if not win.Open_ then
			return
		end
		win.Open_ = false
		holder.Visible = false
		place(nil)
		if type(opts.OnClose) == "function" then
			pcall(opts.OnClose)
		end
	end

	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if win.Open_ then
			pcall(win.Relayout)
		end
	end)
	-- the cursor is free while the window shows (client/MouseLock, as every window's)
	local okLock, lock = pcall(function()
		local module = script.Parent.Parent:FindFirstChild("MouseLock")
		return module and require(module)
	end)
	if okLock and type(lock) == "table" and type(lock.WatchVisible) == "function" then
		pcall(lock.WatchVisible, "Dock:" .. holder.Name, holder)
	end
	return win
end

return ElementsWindow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1189">
            <Properties>
              <string name="Name">GemIcon</string>
              <string name="Source"><![CDATA[-- GemIcon (client UI; lobby-shop Task 15, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 5.7 "How gems look",
-- pitch gemlook A): every gem in the GUI drawn as a cut gem out of frames (no image ids, so nothing to upload).
--
--   GemIcon.New(parent, size, opts) -> Frame "GemIcon" (size x size design px; opts = { Shine = true, ZIndex, Name })
--     attributes Simple (true under 28 px) and Shine (true when the icon is registered with the shine driver)
--   GemIcon.Pile(parent, size, count) -> Frame "GemPile" (count 1, 2, 3, 4 or 6 GemIcons at the pitch's PILE offsets; any
--     other count takes the nearest smaller pile)
--   GemIcon.Amount(parent, n, opts) -> Frame "GemAmount" > GemIcon + TextLabel "Value" (n: a number -> "1,250", or a ready
--     string such as "12.3M"; opts = { Size (the gem, default TextSize x 1.1), TextSize (22), Color (white), ZIndex })
--     sized to the gem + the measured number (attribute Width). (P2 icons look fin1) opts.Pixel = true: item 9 B's pixel
--     gem in place of the cut one, a "GemPixel" label hosting PixelIcon "gem" at 0.9 x TextSize snapped to whole 9-cell
--     steps (27 px beside a 30 px number), as the Eggs' gem planks and the Shop's Gems pill draw it
--   GemIcon.SetAmount(frame, n, opts) writes the number (n nil keeps it) and re-measures; opts restyles (TextSize / Size /
--     Color; the gem is rebuilt when its size changes)
--   GemIcon.Driver() -> { Count = n, Running = bool }   the live icons the one shine Heartbeat drives (dead ones dropped)
--
-- The look (spec 5.7): one 45-degree diamond ("Body", a square turned 45 degrees) inside an unrotated clipping frame
-- ("Clip") that cuts its top tip flat: the table, the crown and the pavilion of a cut gem. Three cyan-blue tones (light
-- Theme.Currency.Gems.Glow rgb(186,236,255), mid Theme.Currency.Gems.Color rgb(84,196,246), dark rgb(40,120,200)) through
-- the Body's UIGradient "Tone" and an inner facet diamond ("Facet"), a navy outline (UIStroke "Outline" rgb(11,16,48),
-- size / 16 thick) with a navy bar on the cut ("Cut"), and a small white four-point star on the upper left ("Glint";
-- review round 1: not "Star", a palette key the Blender kit bakes into evolved pets, which a lookup by name would unbake).
-- Under 28 px the simple form: the silhouette, two tones (light crown, mid pavilion), a navy outline of at least 2 px
-- snapped to whole pixels, no facet and no star (at 19-24 px those blur into each other).
-- Shine (Review Focus 5): a thin white bar ("ShineBar", a second diamond with a moving UIGradient band) sweeps across the
-- gem every 3.5 s for 0.6 s, only for icons of at least 20 px made while the graphics setting is High, and only while it
-- stays High. Every icon shares ONE Heartbeat driver: a weak-keyed registry; an icon out of the tree (destroyed, or its
-- window rebuilt) drops out on the next step, and the Heartbeat disconnects when nothing is left to shine.
-- Plain Lua 5.1-compatible syntax only. Text goes through Theme roles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (P2 icons look fin1) an amount's pixel gem (opts.Pixel)

local GemIcon = {}

local GEMS = (Theme.Currency and Theme.Currency.Gems) or {}
local K = {
	LIGHT = GEMS.Glow or Color3.fromRGB(186, 236, 255),
	MID = GEMS.Color or Color3.fromRGB(84, 196, 246),
	DARK = Color3.fromRGB(40, 120, 200),
	INK = Color3.fromRGB(11, 16, 48),
	WHITE = Color3.new(1, 1, 1),
	SIMPLE_BELOW = 28, -- design px: the simple form below this
	SHINE_MIN = 20, -- design px: the shine from this size up
	PERIOD = 3.5, -- seconds between two sweeps of one icon
	SWEEP = 0.6, -- seconds one sweep takes
	PHASE_STEP = 0.83, -- the next icon's sweep starts this much later (icons side by side do not flash together)
	HALF = 0.45, -- the diamond's half diagonal, at most this x size
	CUT = 0.5, -- the cut takes this share of the half diagonal off the top tip (the table is half the girdle)
	AMOUNT_GAP = 0.22, -- the gap between the gem and the number, x the gem size
	-- the pitch's PILE (page.html): { x, y, size } as shares of the pile box, back to front
	PILE = {
		[1] = { { 0.5, 0.55, 0.8 } },
		[2] = { { 0.36, 0.6, 0.62 }, { 0.64, 0.5, 0.7 } },
		[3] = { { 0.3, 0.64, 0.6 }, { 0.7, 0.64, 0.6 }, { 0.5, 0.4, 0.7 } },
		[4] = { { 0.25, 0.66, 0.52 }, { 0.75, 0.66, 0.52 }, { 0.5, 0.64, 0.58 }, { 0.5, 0.36, 0.62 } },
		[6] = { { 0.2, 0.72, 0.46 }, { 0.5, 0.74, 0.5 }, { 0.8, 0.72, 0.46 }, { 0.34, 0.5, 0.5 }, { 0.66, 0.5, 0.5 }, { 0.5, 0.27, 0.56 } },
	},
}
GemIcon.Metrics = K

-- the shine driver's state: Icons[icon] = { Bar, Sweep, Phase, On } (weak keys); GQ = client/GraphicsQuality or false
local D = { T = 0, NextPhase = 0, Conn = nil, GQ = nil }
D.Icons = setmetatable({}, { __mode = "k" })

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
-- the graphics setting (client/GraphicsQuality's Effective(), asked on every call: the settings window changes it);
-- High when the module is not there (the offline renderer's gallery)
local function gfxHigh()
	if D.GQ == nil then
		D.GQ = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				D.GQ = mod
			end
		end
	end
	if not D.GQ then
		return true
	end
	local ok, mode = pcall(D.GQ.Effective)
	return not ok or mode ~= "Low"
end

local function box(name, props, parent)
	props.Name = name
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Parent = parent
	return Util.Create("Frame", props)
end

local function textWidth(text, size, font)
	local ok, v = pcall(function()
		return Theme.Measure(text, font, size, 100000)
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v.X
	end
	return #text * size * 0.6
end

----------------------------------------------------------------------
-- the shine driver
----------------------------------------------------------------------
local function prune()
	local n = 0
	for icon in pairs(D.Icons) do
		if icon.Parent == nil or not icon:IsDescendantOf(game) then
			D.Icons[icon] = nil
		else
			n = n + 1
		end
	end
	return n
end

local function step(dt)
	D.T = D.T + (tonumber(dt) or 0)
	local high = gfxHigh()
	local alive = 0
	for icon, s in pairs(D.Icons) do
		if icon.Parent == nil or not icon:IsDescendantOf(game) then
			D.Icons[icon] = nil
		else
			alive = alive + 1
			local p = (D.T + s.Phase) % K.PERIOD
			local on = high and p < K.SWEEP
			if on then
				s.Sweep.Offset = Vector2.new(-1 + 2 * p / K.SWEEP, 0)
			end
			if on ~= s.On then
				s.On = on
				s.Bar.Visible = on
			end
		end
	end
	if alive == 0 and D.Conn then
		D.Conn:Disconnect()
		D.Conn = nil
	end
end

local function register(icon, bar, sweep)
	D.Icons[icon] = { Bar = bar, Sweep = sweep, Phase = D.NextPhase, On = false }
	D.NextPhase = (D.NextPhase + K.PHASE_STEP) % K.PERIOD
	if not D.Conn then
		D.Conn = RunService.Heartbeat:Connect(step)
	end
end

function GemIcon.Driver()
	local n = prune()
	if n == 0 and D.Conn then
		D.Conn:Disconnect()
		D.Conn = nil
	end
	return { Count = n, Running = D.Conn ~= nil }
end

----------------------------------------------------------------------
-- New
----------------------------------------------------------------------
-- a square turned 45 degrees: half diagonal d, centred at (x, y) of its parent
local function diamond(name, parent, x, y, d, z, color)
	local side = d * math.sqrt(2)
	return box(name, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(x, y),
		Size = UDim2.fromOffset(side, side),
		Rotation = 45,
		BackgroundTransparency = 0,
		BackgroundColor3 = color or K.WHITE,
		ZIndex = z,
	}, parent)
end

-- a gradient along the SCREEN's vertical on a frame turned 45 degrees (the gradient turns with its frame)
local function screenGradient(name, parent, keys, transparency)
	return Util.Create("UIGradient", {
		Name = name,
		Rotation = 45,
		Color = ColorSequence.new(keys),
		Transparency = transparency,
		Parent = parent,
	})
end

function GemIcon.New(parent, size, opts)
	opts = opts or {}
	local s = math.max(8, tonumber(size) or 32)
	local simple = s < K.SIMPLE_BELOW
	local z = tonumber(opts.ZIndex) or 1
	-- the outline: size / 16; the simple form at least 2 px and whole
	local th = s / 16
	if simple then
		th = math.max(2, math.floor(th + 0.5))
	end
	-- the diamond fits the box with its outline (a mitred tip reaches th x sqrt 2 past the edge)
	local d = math.min(K.HALF * s, s / 2 - 1.42 * th - 0.5)
	local c = K.CUT * d
	local cx = s / 2
	local cy = s / 2 - (c + 0.414 * th) / 2 -- the visible gem (cut bar to tip) centred in the box
	local cutY = cy - d + c

	local root = box(opts.Name or "GemIcon", { Size = UDim2.fromOffset(s, s), ZIndex = z }, nil)
	root:SetAttribute("Simple", simple)
	local clip = box("Clip", {
		Position = UDim2.fromOffset(0, cutY),
		Size = UDim2.fromOffset(s, s - cutY + 2 * th),
		ClipsDescendants = true,
		ZIndex = z,
	}, root)
	local body = diamond("Body", clip, cx, cy - cutY, d, z)
	if simple then
		screenGradient("Tone", body, {
			ColorSequenceKeypoint.new(0, K.LIGHT),
			ColorSequenceKeypoint.new(0.499, K.LIGHT),
			ColorSequenceKeypoint.new(0.501, K.MID),
			ColorSequenceKeypoint.new(1, K.MID),
		})
	else
		screenGradient("Tone", body, {
			ColorSequenceKeypoint.new(0, K.LIGHT),
			ColorSequenceKeypoint.new(0.499, K.LIGHT:Lerp(K.MID, 0.45)),
			ColorSequenceKeypoint.new(0.501, K.MID),
			ColorSequenceKeypoint.new(1, K.DARK),
		})
	end
	Util.Create("UIStroke", {
		Name = "Outline",
		Color = K.INK,
		Thickness = th,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter,
		Parent = body,
	})
	if not simple then
		-- the inner facet: a diamond of half the size on the girdle, its top tip on the table's edge
		local facet = diamond("Facet", clip, cx, cy - cutY, d * 0.5, z + 1, K.WHITE)
		facet.BackgroundTransparency = 0.25
		Util.Create("UIGradient", {
			Name = "FacetTone",
			Rotation = 0,
			Color = ColorSequence.new(K.LIGHT, K.MID:Lerp(K.DARK, 0.35)),
			Parent = facet,
		})
	end
	-- the navy bar on the cut (above the clip: the outline's own top edge was cut away with the tip)
	local barW = 2 * (c + 1.2 * th)
	box("Cut", {
		Position = UDim2.fromOffset(cx - barW / 2, cutY - th),
		Size = UDim2.fromOffset(barW, th),
		BackgroundTransparency = 0,
		BackgroundColor3 = K.INK,
		ZIndex = z + 3,
	}, root)
	if not simple then
		-- the white four-point star on the upper left (in the crown)
		local star = box("Glint", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx - 0.4 * d, cutY + 0.28 * d),
			Size = UDim2.fromOffset(0.22 * s, 0.22 * s),
			ZIndex = z + 4,
		}, root)
		for i, dims in ipairs({ { 0.2, 1 }, { 1, 0.2 } }) do
			local arm = box("Arm" .. i, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(dims[1], dims[2]),
				BackgroundTransparency = 0,
				BackgroundColor3 = K.WHITE,
				ZIndex = z + 4,
			}, star)
			Util.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = arm })
		end
	end
	local shine = opts.Shine ~= false and s >= K.SHINE_MIN and gfxHigh()
	if shine then
		local bar = diamond("ShineBar", clip, cx, cy - cutY, d, z + 2, K.WHITE)
		bar.Visible = false
		local sweep = Util.Create("UIGradient", {
			Name = "Sweep",
			Rotation = 0,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.42, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(0.58, 1),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Offset = Vector2.new(-1, 0),
			Parent = bar,
		})
		register(root, bar, sweep)
	end
	root:SetAttribute("Shine", shine == true)
	root.Parent = parent
	return root
end

----------------------------------------------------------------------
-- Pile
----------------------------------------------------------------------
function GemIcon.Pile(parent, size, count)
	local s = math.max(8, tonumber(size) or 96)
	local n = math.max(1, math.floor(tonumber(count) or 1))
	while not K.PILE[n] do
		n = n - 1
	end
	local pile = box("GemPile", { Size = UDim2.fromOffset(s, s) }, nil)
	pile:SetAttribute("Count", n)
	for i, p in ipairs(K.PILE[n]) do
		local g = p[3] * s
		local icon = GemIcon.New(pile, g, { ZIndex = 1 + i })
		icon.Position = UDim2.fromOffset(p[1] * s - g / 2, p[2] * s - g / 2)
	end
	pile.Parent = parent
	return pile
end

----------------------------------------------------------------------
-- Amount
----------------------------------------------------------------------
local function amountText(n)
	if type(n) == "string" then
		return n
	end
	return Util.Commas(math.max(0, math.floor(tonumber(n) or 0)))
end

-- an amount's gem at the number's text size `ts`: the cut GemIcon (g px), or with the frame's Pixel attribute item 9 B's
-- pixel gem, a "GemPixel" label of whole 9-cell steps hosting PixelIcon "gem" (its own colours)
local function amountGem(frame, g, ts, z)
	if frame:GetAttribute("Pixel") == true then
		local px = PixelIcon.Snap(ts * 0.9)
		local host = Theme.Label("", "Display", {
			Size = ts,
			Props = { Name = "GemPixel", ZIndex = z, TextTruncate = Enum.TextTruncate.None },
		})
		host.BackgroundTransparency = 1
		host.Size = UDim2.fromOffset(px, px)
		host.Parent = frame
		PixelIcon.Host(host, "gem", px)
		return host
	end
	return GemIcon.New(frame, g, { ZIndex = z })
end

-- lays the gem and the number out side by side and sizes the frame to them
local function measure(frame)
	local icon = frame:FindFirstChild("GemIcon") or frame:FindFirstChild("GemPixel")
	local value = frame:FindFirstChild("Value")
	if not (icon and value) then
		return
	end
	local g = icon.Size.X.Offset
	local ts = value.TextSize
	local gap = math.floor(g * K.AMOUNT_GAP + 0.5)
	if icon.Name == "GemPixel" then
		-- (P2 icons look pol0, minor: the pixel gem touched '100') its 1-cell drop shadow draws past its box: the gap
		-- starts after it
		gap = gap + math.ceil(g / 9)
	end
	local w = math.ceil(textWidth(value.Text, ts, Theme.FontOf(value))) + 2
	local h = math.max(g, ts + 4)
	icon.AnchorPoint = Vector2.new(0, 0.5)
	icon.Position = UDim2.new(0, 0, 0.5, 0)
	value.Position = UDim2.new(0, g + gap, 0, 0)
	value.Size = UDim2.new(0, w, 1, 0)
	frame.Size = UDim2.fromOffset(g + gap + w, h)
	frame:SetAttribute("Width", g + gap + w)
end

function GemIcon.Amount(parent, n, opts)
	opts = opts or {}
	local ts = tonumber(opts.TextSize) or 22
	local g = math.floor((tonumber(opts.Size) or ts * 1.1) + 0.5)
	local z = tonumber(opts.ZIndex) or 1
	local frame = box("GemAmount", { Size = UDim2.fromOffset(g, g), ZIndex = z }, nil)
	if opts.Pixel == true then
		frame:SetAttribute("Pixel", true)
	end
	amountGem(frame, g, ts, z + 1)
	local value = Theme.Label(amountText(n), "Display", {
		Size = ts,
		Color = opts.Color or K.WHITE,
		Props = {
			Name = "Value",
			ZIndex = z + 1,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			TextTruncate = Enum.TextTruncate.None,
		},
	})
	value.Parent = frame
	measure(frame)
	frame.Parent = parent
	return frame
end

function GemIcon.SetAmount(frame, n, opts)
	if typeof(frame) ~= "Instance" then
		return
	end
	local value = frame:FindFirstChild("Value")
	local icon = frame:FindFirstChild("GemIcon") or frame:FindFirstChild("GemPixel")
	if not value then
		return
	end
	if n ~= nil then
		value.Text = amountText(n)
	end
	if type(opts) == "table" then
		if tonumber(opts.TextSize) then
			value.TextSize = tonumber(opts.TextSize)
		end
		if opts.Color then
			value.TextColor3 = opts.Color
		end
		local g = math.floor((tonumber(opts.Size) or value.TextSize * 1.1) + 0.5)
		if frame:GetAttribute("Pixel") == true then
			g = PixelIcon.Snap(value.TextSize * 0.9) -- (the pixel gem's whole-cell size)
		end
		if not icon or icon.Size.X.Offset ~= g then
			local z = icon and icon.ZIndex or value.ZIndex
			if icon then
				icon:Destroy()
			end
			amountGem(frame, g, value.TextSize, z)
		end
	end
	measure(frame)
end

return GemIcon
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1190">
            <Properties>
              <string name="Name">HatchFx</string>
              <string name="Source"><![CDATA[-- HatchFx (client UI; lobby-shop Tasks 26 / 27, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.5 "Where the
-- VFX show" and 16.4 "VFX and budget"): the egg cutscene's effects, all GUI frames, tweens and one pooled spark system,
-- plus the one Lighting effect of the cutscene. A pool owns at most n spark frames (made only when first needed, reused
-- after) and one Heartbeat that runs only while a spark lives, unless its owner drives it (Drive: the egg stage steps
-- it from its own phase Heartbeat, so the cutscene has exactly one); nothing else here runs per frame.
--
--   HatchFx.Pool(parent, n [, z, opts]) -> pool   a holder Frame "Sparks" over the parent (n defaults to 16); opts.Image
--     (roll-look review round 1: the hatch_sparkle "rbxassetid://" id, spec 16.15 "Fallbacks"): the sparks are ImageLabels
--     tinted their colour (1.6 x the square's size, unturned) instead of 45-degree squares; the confetti stays squares;
--     never more than n objects of both kinds
--     pool:Burst(at, rarity, count [, opts]) -> spawned   sparks flying out of `at` (a Vector2 in the parent's px) and
--       fading in 0.55-0.9 s (opts.Life / opts.Speed / opts.Px ranges override: the shakes' small pops); never more
--       than n live at once; halved on Low graphics
--     pool:Confetti(n, rarity) -> spawned   n squares falling from the holder's top for 1.5 s, turning and swaying (the
--       Mythic / Secret reveal); halved on Low graphics; frames named "Confetti" while they fall
--     pool:Ambient(target, rarity [, count, mode])   sparkles round a GuiObject (an egg): Rare 3, Legendary 4, Mythic 6
--       drifting up and fading (mode "Drift"), Secret 2 orbiting star sparks ("Orbit"); none below Rare (Epic: 3) and
--       none on Low. They last until the target is destroyed, SetRunning(false) or Destroy
--     pool:SetRunning(on)   off: every spark back in the pool, the Heartbeat off (the ambient waits); on: it resumes
--     pool:Drive()   the owner calls pool:Step(dt) from its own Heartbeat; the pool never connects one
--     pool:Live() -> the sparks alive now;  pool:Destroy()   the frames and the Heartbeat gone
--   HatchFx.Rays(parent, rarity [, opts]) -> rays   a CanvasGroup "Rays" of 16 thin wedges (8 bars through the centre,
--     clear in the middle; opts.Image, the hatch_rays id: one ImageLabel "Fan" in their box, tinted, instead):
--     rays:Place(x, y, d), rays:Flash(alpha, seconds) (fade in, then rest at `alpha`), rays:Recolor(rarity),
--     rays:Spin(on) (an endless Rotation tween, 12 s a turn; still on Low), rays:Hide(), rays:Destroy()
--   (U9-2b look review 2, the owner's look bar of 2026-11-17: pixel shapes, no smooth round parts) the shock, the cracks,
--   the leaks and the cloud ring are drawn in square pixels on whole px (opts.Unit: the screen's pixel, 3 px PC, 2 a
--   phone / a 720p PC), never turned or blended:
--   HatchFx.Shock(parent, rarity [, opts]) -> shock   a square Frame "Shock" in a mitred UIStroke 2 units thick:
--     shock:Play(x, y, d, seconds, color) grows it 0 -> d on whole px (its NumberValue "Grow") while its stroke fades,
--     then hides it; shock:Hide(), shock:Destroy()
--   HatchFx.Cracks(egg, rarity, step) -> Frame "Cracks" on the egg: the zigzag as staircases of square pixels on the
--     egg's crack grid (Seg1..5 holders of "Px<n>" squares, step 1, 3 or 5 of them shown, and a Branch at 5), in shares
--     of the egg so they follow its size, shakes and push-in; flat light, no Rotation, no gradient
--   HatchFx.Leaks(egg, rarity, step) -> Frame "Leaks" on the egg: up to 5 straight pixel beams (Leak1..5, each Part1..3
--     a step more see-through) up or down from the crack's corners, as many and as long as the step
--   HatchFx.CloudRing(parent, color [, opts]) -> ring   (the owner's pick: Gemini's cloud ring) a CanvasGroup
--     "CloudRing" of 8 stepped pixel puffs (Puff<i> > Row1..3 + Shade: the loading screen's cloud) with NumberValues
--     "Swell" and "Bob": ring:Place(x, y, d), ring:Show(seconds), ring:Spin(on) (a 2-frame bob: every other puff one
--     unit up and back, RING_BOB s a frame; no Rotation; still on Low), ring:Pulse(color, seconds) (tinted the rarity
--     colour at once, the puffs pushed out to 1.45 x the circle and faded: the burst), ring:Tint(color, seconds)
--     (roll-look, spec 16.15: Gemini's shake tweak, GroupColor3 tweened half way from its pale tint to `color`; 0 s at
--     once; the burst's Pulse ends it), ring:Hide(), ring:Destroy()
--   HatchFx.Stars(parent, n) -> { Frame, Destroy }   a Frame "Stars" with n small stars, each twinkling (an endless,
--     offset alpha tween); Destroy stops the tweens and removes the frame
--   HatchFx.Dim(on [, seconds]) -> effects   High graphics only: on = the client-only Lighting.NimbusHatchBlur
--     (BlurEffect, ours by name, 0 -> 14) and the cool tint pushed as the LightingStack preset "Hatch" (Brightness
--     -0.08, Saturation -0.25 against LightingStack.Value without "Hatch"; no ColorCorrectionEffect of our own: the
--     LightingStack is the only client writer of Lighting); off = the blur eased out over `seconds` (kit-b S3, sky audit
--     F10: client/SkyTransition.BlurOut, Size -> 0 Quad In, then destroyed; it no longer counts as on) and the preset
--     popped. On again mid-fade takes the fading blur back from where it is. -> how many of the two are on now
--   HatchFx.Stats() -> { Live, Pooled, Tweens, Heartbeats, Effects }   (tests) every pool's live sparks and frames, the
--     tweens playing that HatchFx made (stars, rays, rings, shocks, the blur), the pools whose Heartbeat is connected
--     and the Lighting effects on (Dim)
--   opts.Track (Rays / Shock / CloudRing): a weak-keyed table that also gets every tween the handle plays (the egg
--     stage counts and cancels them with its own)
--   (kit-b U9-2b) every effect's root (Sparks, Stars, Rays, Shock, CloudRing) carries the attribute Art = "Hatch": the
--     stage's art keeps its own paint (soft rays, round puffs and sparks), the kit B walks read it as illustration
--
-- Positions: the holder's local px are the screen px divided by the UIScale(s) above it (UIScale shrinks the design
-- canvas on a phone). Plain Lua 5.1-compatible syntax only.

local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local HatchFx = {}

local K = {
	N = 16,
	BURST_LIFE = { 0.55, 0.9 },
	BURST_SPEED = { 140, 260 }, -- px / s
	DRAG = 2.4, -- the burst's speed falls by this share a second
	FALL = 70, -- px / s / s
	DRIFT_LIFE = { 1.6, 2.4 },
	DRIFT_RISE = 0.12, -- egg heights a second
	DRIFT_GAP = 0.3, -- s between two ambient spawns
	ORBIT_PERIOD = 4,
	AMBIENT = { Rare = { 3, "Drift" }, Epic = { 3, "Drift" }, Legendary = { 4, "Drift" }, Mythic = { 6, "Drift" }, Secret = { 2, "Orbit" } },
	COLORS = {
		Common = { Color3.fromRGB(255, 255, 255) },
		Uncommon = { Color3.fromRGB(214, 255, 190) },
		Rare = { Color3.fromRGB(170, 214, 255) },
		Epic = { Color3.fromRGB(255, 226, 140), Color3.fromRGB(232, 204, 255) },
		Legendary = { Color3.fromRGB(255, 222, 110), Color3.fromRGB(255, 244, 200) },
		Mythic = { Color3.fromRGB(255, 200, 230), Color3.fromRGB(200, 240, 255), Color3.fromRGB(222, 202, 255), Color3.fromRGB(200, 255, 232) },
		Secret = { Color3.fromRGB(255, 248, 220), Color3.fromRGB(196, 170, 255) },
	},
	CONFETTI_LIFE = 1.5,
	CONFETTI_FALL = { 150, 260 }, -- px / s
	CONFETTI = {
		Mythic = { Color3.fromRGB(255, 176, 214), Color3.fromRGB(170, 232, 255), Color3.fromRGB(214, 190, 255), Color3.fromRGB(176, 255, 220), Color3.fromRGB(255, 236, 160) },
		Secret = { Color3.fromRGB(180, 150, 255), Color3.fromRGB(255, 214, 110), Color3.fromRGB(255, 248, 230), Color3.fromRGB(120, 92, 220) },
	},
	RAY_TURN = 12, -- s a turn
	RING_TURN = 24,
	-- (U9-2b look review 2) 8 stepped pixel puffs (the finding's 6 to 8: the x3 budget), a 2-frame bob RING_BOB s a frame
	-- (no turn); the burst's swell moves the puffs out and grows the canvas with them (never clipped)
	RING_PUFFS = 8,
	RING_BOB = 0.45,
	RING_R = 0.4, -- (roll-look) the puffs' circle, a share of the ring's size; their widths (big, small) and transparencies
	RING_PUFF = { 0.14, 0.095 },
	RING_PUFF_A = { 0.55, 0.66 },
	RING_SHADE = Color3.fromRGB(200, 212, 236), -- a puff's pale underside (the loading screen's cloud shade)
	RING_REST = 0.2, -- the ring's transparency at rest
	RING_TINT = Color3.fromRGB(226, 234, 255),
	SWELL = 1.45,
	BLUR = 14,
	TINT = { Brightness = -0.08, Saturation = -0.25 },
	-- the crack's zigzag (shares of the egg's width / height, the pitch's points) and which segments each step shows
	ZIG = { { 0.12, 0.58 }, { 0.24, 0.66 }, { 0.34, 0.55 }, { 0.45, 0.67 }, { 0.55, 0.56 }, { 0.66, 0.66 }, { 0.76, 0.55 }, { 0.88, 0.62 } },
	SEGS = { [1] = { 4 }, [3] = { 3, 4, 5 }, [5] = { 2, 3, 4, 5, 6 } },
	BRANCH = { 0.45, 0.67, 0.42, 0.8 },
	-- (U9-2b look review 2) the crack's pixel grid: a square cell CRACK_CELL of the egg's height a side (the voxel egg's
	-- own block size); a leak's stepped parts' transparencies, from the crack outward
	CRACK_CELL = 0.04,
	LEAK_A = { 0.2, 0.45, 0.7 },
}
HatchFx.Metrics = K

-- every pool (weak keys), every tween HatchFx plays (weak keys: the stars, the handles' tweens) and the Dim state
local R = {
	Pools = setmetatable({}, { __mode = "k" }), Stars = setmetatable({}, { __mode = "k" }), GQ = nil, Rng = Random.new(26),
	Blur = nil, BlurTween = nil, Pushed = false, LS = nil,
	Fading = nil, ST = nil, -- { Blur, Tween }: the blur easing out after Dim(false); client/SkyTransition (lazy)
}

local function high()
	if R.GQ == nil then
		R.GQ = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				R.GQ = mod
			end
		end
	end
	if not R.GQ then
		return true
	end
	local ok, mode = pcall(R.GQ.Effective)
	return not ok or mode ~= "Low"
end

local function between(range)
	return range[1] + (range[2] - range[1]) * R.Rng:NextNumber()
end

-- one tween HatchFx plays: counted by Stats (and by opts.Track's owner)
local function play(inst, info, goals, track)
	local tw = TweenService:Create(inst, info, goals)
	R.Stars[tw] = true
	if type(track) == "table" then
		track[tw] = true
	end
	tw:Play()
	return tw
end

local function cancel(tw)
	if tw then
		pcall(function()
			tw:Cancel()
		end)
		R.Stars[tw] = nil
	end
end

local function lighter(color, k)
	return color:Lerp(Color3.new(1, 1, 1), k)
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function colorOf(rarity, i)
	local list = K.COLORS[rarity] or K.COLORS.Common
	return list[((i or 1) - 1) % #list + 1]
end

-- the product of the UIScale(s) on the holder's ancestors (1 when none)
local function scaleOf(inst)
	local s, cur = 1, inst
	while cur and cur:IsA("GuiBase2d") do
		local ui = cur:FindFirstChildOfClass("UIScale")
		if ui then
			s = s * ui.Scale
		end
		cur = cur.Parent
	end
	return (s > 0) and s or 1
end

local Pool = {}
Pool.__index = Pool

-- a spark object: a 45-degree square Frame, or (img: the pool's hatch_sparkle image, roll-look review round 1) an
-- ImageLabel tinted the spark colour. Never more than N of both kinds: when the pool is full a spare of the other kind
-- makes room (the confetti stays paper squares after a burst of image sparks)
function Pool:_frame(img)
	local f = table.remove(img and self.FreeImg or self.Free)
	if f then
		return f
	end
	if not self.Holder then
		return nil
	end
	if self.Made >= self.N then
		local spare = table.remove(img and self.Free or self.FreeImg)
		if not spare then
			return nil
		end
		spare:Destroy()
		self.Made = self.Made - 1
	end
	self.Made = self.Made + 1
	if img then
		f = Instance.new("ImageLabel")
		f.Image = self.Image
		f.BackgroundTransparency = 1
		f.ImageTransparency = 1
	else
		f = Instance.new("Frame")
	end
	f.Name = "Spark"
	f.BorderSizePixel = 0
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Rotation = 45
	f.ZIndex = self.Z
	f.Visible = false
	f.Parent = self.Holder
	return f
end

function Pool:_spawn(rec)
	local img = self.Image ~= nil and rec.Name ~= "Confetti"
	local f = self:_frame(img)
	if not f then
		return false
	end
	rec.F = f
	rec.Age = 0
	-- the property the fade writes each frame (rec.AP), set once here: no class test per frame
	rec.AP = img and "ImageTransparency" or "BackgroundTransparency"
	f.Name = rec.Name or "Spark"
	f.Rotation = rec.Rot or (img and 0 or 45)
	if img then
		f.ImageColor3 = rec.Color
	else
		f.BackgroundColor3 = rec.Color
	end
	-- (an image sparkle is drawn inside its box: a little larger than the square it replaces)
	local k = img and 1.6 or 1
	f.Size = UDim2.fromOffset(rec.Px * k, (rec.Py or rec.Px) * k)
	f[rec.AP] = 1
	f.Position = UDim2.fromOffset(rec.X, rec.Y)
	f.Visible = true
	self.List[#self.List + 1] = rec
	return true
end

function Pool:_free(i)
	local rec = self.List[i]
	self.List[i] = self.List[#self.List]
	self.List[#self.List] = nil
	if rec.Amb then
		rec.Amb.Live = rec.Amb.Live - 1
	end
	if rec.F and rec.F.Parent then
		rec.F.Visible = false
		rec.F.Name = "Spark"
		local list = (rec.AP == "ImageTransparency") and self.FreeImg or self.Free
		list[#list + 1] = rec.F
	end
end

-- connects the Heartbeat when something should run, drops it when nothing does (never for a driven pool)
function Pool:_sync()
	local want = not self.Manual and self.Running and self.Holder ~= nil and (#self.List > 0 or (next(self.Amb) ~= nil and high()))
	if want and not self.Conn then
		self.Conn = RunService.Heartbeat:Connect(function(dt)
			self:_step(dt)
		end)
	elseif not want and self.Conn then
		self.Conn:Disconnect()
		self.Conn = nil
	end
end

-- a target's centre and height in the holder's px
function Pool:_where(target, scale)
	local hp = self.Holder.AbsolutePosition
	local p, s = target.AbsolutePosition, target.AbsoluteSize
	return (p.X + s.X / 2 - hp.X) / scale, (p.Y + s.Y / 2 - hp.Y) / scale, s.Y / scale
end

function Pool:_step(dt)
	if not self.Holder or not self.Holder.Parent then
		self:Destroy()
		return
	end
	self.T = self.T + dt
	local hi = high()
	local scale = scaleOf(self.Holder)
	-- the ambient: top each target's sparkles up (one every DRIFT_GAP; the orbit sparks all at once)
	if hi then
		for target, a in pairs(self.Amb) do
			if a.Live < a.Count and self.T >= a.Next and target.Parent then
				local cx, cy, h = self:_where(target, scale)
				a.Next = self.T + ((a.Mode == "Orbit") and 0 or K.DRIFT_GAP)
				a.N = a.N + 1
				local rec = { Amb = a, Target = target, Color = colorOf(a.Rarity, a.N), Mode = a.Mode, X = cx, Y = cy }
				if a.Mode == "Orbit" then
					rec.Phase = (a.N - 1) * (2 * math.pi / a.Count)
					rec.Px = math.clamp(math.floor(h * 0.07 + 0.5), 5, 14)
					rec.Life = math.huge
				else
					local ang = R.Rng:NextNumber() * 2 * math.pi
					local u = 0.75 + 0.25 * R.Rng:NextNumber()
					rec.Ox, rec.Oy = math.cos(ang) * 0.55 * u, math.sin(ang) * 0.62 * u -- in egg heights from the centre
					rec.Vx = (R.Rng:NextNumber() - 0.5) * 0.1
					rec.Px = math.clamp(math.floor(h * (0.045 + 0.025 * R.Rng:NextNumber()) + 0.5), 4, 12)
					rec.Life = between(K.DRIFT_LIFE)
				end
				if self:_spawn(rec) then
					a.Live = a.Live + 1
				end
			end
		end
	end
	-- every live spark
	for i = #self.List, 1, -1 do
		local rec = self.List[i]
		rec.Age = rec.Age + dt
		local f = rec.F
		local gone = rec.Age >= rec.Life or not f or not f.Parent
		if rec.Amb and not gone then
			local target = rec.Target
			gone = not hi or not target.Parent or not self.Amb[target] -- Low graphics: the ambient sparks go at once
			if not gone then
				local cx, cy, h = self:_where(target, scale)
				if rec.Mode == "Orbit" then
					local th = rec.Phase + self.T * 2 * math.pi / K.ORBIT_PERIOD
					f.Position = UDim2.fromOffset(cx + math.cos(th) * 0.6 * h, cy + math.sin(th) * 0.66 * h)
					f[rec.AP] = 0.2 + 0.3 * (0.5 + 0.5 * math.sin(self.T * 5 + rec.Phase))
				else
					local k = rec.Age / rec.Life
					f.Position = UDim2.fromOffset(cx + (rec.Ox + rec.Vx * rec.Age) * h, cy + (rec.Oy - K.DRIFT_RISE * rec.Age) * h)
					local fade = (k < 0.25) and (k / 0.25) or ((k > 0.65) and ((1 - k) / 0.35) or 1)
					f[rec.AP] = 1 - 0.85 * math.max(0, fade)
				end
			end
		elseif not gone and rec.Name == "Confetti" then
			-- confetti: falling, swaying, turning; it fades over its last 0.35 s
			rec.Vy = rec.Vy + K.FALL * 0.5 * dt
			rec.X = rec.X + (rec.Vx + math.sin(rec.Age * rec.Sway + rec.Phase) * 40) * dt
			rec.Y = rec.Y + rec.Vy * dt
			rec.Rot = rec.Rot + rec.Spin * dt
			f.Position = UDim2.fromOffset(rec.X, rec.Y)
			f.Rotation = rec.Rot
			local left = rec.Life - rec.Age
			f[rec.AP] = (left < 0.35) and (1 - left / 0.35 * 0.9) or 0.1
		elseif not gone then
			-- a burst spark: out, slowing, falling a little, fading
			rec.Vx = rec.Vx * math.max(0, 1 - K.DRAG * dt)
			rec.Vy = rec.Vy * math.max(0, 1 - K.DRAG * dt) + K.FALL * dt
			rec.X, rec.Y = rec.X + rec.Vx * dt, rec.Y + rec.Vy * dt
			f.Position = UDim2.fromOffset(rec.X, rec.Y)
			f[rec.AP] = 0.1 + 0.9 * (rec.Age / rec.Life)
		end
		if gone then
			self:_free(i)
		end
	end
	self:_sync()
end

function Pool:Burst(at, rarity, count, opts)
	if not self.Holder or not self.Running then
		return 0
	end
	opts = type(opts) == "table" and opts or {}
	count = math.max(0, math.floor(tonumber(count) or 0))
	if not high() then
		count = math.floor(count / 2)
	end
	local px = opts.Px or { 6, 10 }
	local spawned = 0
	for i = 1, count do
		local ang = R.Rng:NextNumber() * 2 * math.pi
		local speed = between(opts.Speed or K.BURST_SPEED)
		local rec = {
			Color = colorOf(rarity, i),
			X = at.X,
			Y = at.Y,
			Vx = math.cos(ang) * speed,
			Vy = math.sin(ang) * speed,
			Px = math.floor(between(px) + 0.5),
			Life = between(opts.Life or K.BURST_LIFE),
		}
		if not self:_spawn(rec) then
			break
		end
		spawned = spawned + 1
	end
	self:_sync()
	return spawned
end

-- confetti from the holder's top edge, across its width (Mythic / Secret)
function Pool:Confetti(n, rarity)
	if not self.Holder or not self.Running then
		return 0
	end
	n = math.max(0, math.floor(tonumber(n) or 0))
	if not high() then
		n = math.floor(n / 2)
	end
	local scale = scaleOf(self.Holder)
	local w = self.Holder.AbsoluteSize.X / scale
	local list = K.CONFETTI[rarity] or K.COLORS[rarity] or K.COLORS.Common
	local spawned = 0
	for i = 1, n do
		local size = 8 + math.floor(R.Rng:NextNumber() * 6)
		local rec = {
			Name = "Confetti",
			Color = list[(i - 1) % #list + 1],
			X = w * (0.06 + 0.88 * ((i * 0.618034) % 1)),
			Y = -12 - R.Rng:NextNumber() * 60,
			Vx = (R.Rng:NextNumber() - 0.5) * 40,
			Vy = between(K.CONFETTI_FALL),
			Px = size,
			Py = math.floor(size * 0.6 + 0.5),
			Rot = R.Rng:NextNumber() * 360,
			Spin = (R.Rng:NextNumber() - 0.5) * 540,
			Sway = 2 + R.Rng:NextNumber() * 3,
			Phase = R.Rng:NextNumber() * 6.28,
			Life = K.CONFETTI_LIFE,
		}
		if not self:_spawn(rec) then
			break
		end
		spawned = spawned + 1
	end
	self:_sync()
	return spawned
end

-- the owner steps this pool from its own Heartbeat (Step); the pool never connects one
function Pool:Drive()
	self.Manual = true
	if self.Conn then
		self.Conn:Disconnect()
		self.Conn = nil
	end
end

function Pool:Step(dt)
	if self.Holder and self.Running and (#self.List > 0 or next(self.Amb) ~= nil) then
		self:_step(dt)
	end
end

function Pool:Ambient(target, rarity, count, mode)
	local def = K.AMBIENT[rarity]
	if not self.Holder or typeof(target) ~= "Instance" or not def then
		return
	end
	local old = self.Amb[target]
	if old and old.Conn then
		old.Conn:Disconnect()
	end
	local a = { Rarity = rarity, Count = count or def[1], Mode = mode or def[2], Live = 0, Next = self.T, N = 0 }
	a.Conn = target.Destroying:Connect(function()
		self:StopAmbient(target)
	end)
	self.Amb[target] = a
	self:_sync()
end

-- the target's sparkles back in the pool and its ambient forgotten
function Pool:StopAmbient(target)
	local a = self.Amb[target]
	if not a then
		return
	end
	self.Amb[target] = nil
	if a.Conn then
		a.Conn:Disconnect()
	end
	for i = #self.List, 1, -1 do
		if self.List[i].Amb == a then
			self:_free(i)
		end
	end
	self:_sync()
end

function Pool:SetRunning(on)
	on = on and true or false
	if not on then
		for i = #self.List, 1, -1 do
			self:_free(i)
		end
		for _, a in pairs(self.Amb) do
			a.Live, a.Next = 0, 0
		end
	else
		for _, a in pairs(self.Amb) do
			a.Next = self.T
		end
	end
	self.Running = on
	self:_sync()
end

function Pool:Live()
	return #self.List
end

function Pool:Destroy()
	for target in pairs(self.Amb) do
		local a = self.Amb[target]
		if a.Conn then
			a.Conn:Disconnect()
		end
	end
	self.Amb = {}
	self.List = {}
	self.Free = {}
	self.FreeImg = {}
	self.Running = false
	if self.Conn then
		self.Conn:Disconnect()
		self.Conn = nil
	end
	if self.Holder then
		self.Holder:Destroy()
		self.Holder = nil
	end
	R.Pools[self] = nil
end

function HatchFx.Pool(parent, n, z, opts)
	opts = type(opts) == "table" and opts or {}
	local holder = Instance.new("Frame")
	holder.Name = "Sparks"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = z or 20
	holder.Parent = parent
	holder:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) the stage's art
	local pool = setmetatable({
		Holder = holder,
		N = math.max(1, math.floor(tonumber(n) or K.N)),
		Z = z or 20,
		Made = 0,
		Free = {},
		FreeImg = {},
		Image = type(opts.Image) == "string" and opts.Image or nil,
		List = {},
		Amb = {},
		Running = true,
		T = 0,
		Conn = nil,
	}, Pool)
	R.Pools[pool] = true
	return pool
end

-- n small stars over the parent (deterministic spots), each twinkling on its own offset loop
function HatchFx.Stars(parent, n)
	local holder = Instance.new("Frame")
	holder.Name = "Stars"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.Parent = parent
	holder:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) the stage's art
	local tweens = {}
	n = math.max(0, math.floor(tonumber(n) or 0))
	for i = 1, n do
		local s = Instance.new("Frame")
		s.Name = "Star" .. i
		s.BorderSizePixel = 0
		s.AnchorPoint = Vector2.new(0.5, 0.5)
		s.Rotation = 45
		s.BackgroundColor3 = Color3.fromRGB(255, 248, 220)
		s.BackgroundTransparency = 0.2
		-- golden-ratio spots: spread without a pattern the eye picks up
		local x, y = (i * 0.618034) % 1, (i * 0.381966 + 0.13) % 1
		s.Position = UDim2.fromScale(0.04 + 0.92 * x, 0.06 + 0.88 * y)
		local px = 3 + (i % 3) * 2
		s.Size = UDim2.fromOffset(px, px)
		s.Parent = holder
		local info = TweenInfo.new(0.8 + (i % 5) * 0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true, (i * 0.37) % 1.5)
		local tw = TweenService:Create(s, info, { BackgroundTransparency = 0.85 })
		R.Stars[tw] = true
		tweens[#tweens + 1] = tw
		tw:Play()
	end
	local function destroy()
		for _, tw in ipairs(tweens) do
			tw:Cancel()
			R.Stars[tw] = nil
		end
		tweens = {}
		holder:Destroy()
	end
	holder.Destroying:Connect(function()
		for _, tw in ipairs(tweens) do
			tw:Cancel()
			R.Stars[tw] = nil
		end
	end)
	return { Frame = holder, Destroy = destroy }
end

----------------------------------------------------------------------------------------------------
-- the burst's rays, the shock ring, the cloud ring (handles); the cracks and leaks on an egg
----------------------------------------------------------------------------------------------------
-- an object a handle places by its centre and diameter (in the parent's px)
local function placeAt(o, x, y, d)
	o.Position = UDim2.fromOffset(x, y)
	o.Size = UDim2.fromOffset(math.max(0, d), math.max(0, d))
end

local Handle = {}
Handle.__index = Handle

function Handle:Place(x, y, d)
	if self.Frame and self.Frame.Parent then
		placeAt(self.Frame, x, y, d)
	end
end

function Handle:_play(key, inst, info, goals)
	cancel(self.Tw[key])
	self.Tw[key] = (inst and inst.Parent) and play(inst, info, goals, self.Track) or nil
	return self.Tw[key]
end

function Handle:Spin(on)
	if on and high() and self.Frame and self.Frame.Parent then
		if not (self.Tw.Spin and self.Tw.Spin.PlaybackState == Enum.PlaybackState.Playing) then
			self.Frame.Rotation = self.Frame.Rotation % 360
			local from = self.Frame.Rotation
			self:_play("Spin", self.Frame, TweenInfo.new(self.Turn, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Rotation = from + 360 })
		end
	else
		cancel(self.Tw.Spin)
		self.Tw.Spin = nil
	end
end

function Handle:Hide()
	for key, tw in pairs(self.Tw) do
		cancel(tw)
		self.Tw[key] = nil
	end
	if self.Frame and self.Frame.Parent then
		self.Frame.Visible = false
	end
end

function Handle:Destroy()
	self:Hide()
	if self.Frame then
		self.Frame:Destroy()
		self.Frame = nil
	end
end

local function handle(frame, turn, opts)
	return setmetatable({ Frame = frame, Tw = {}, Turn = turn or 12, Track = type(opts) == "table" and opts.Track or nil }, Handle)
end

-- the light colour of a rarity's effects (Legendary and up: gold)
local function rayColor(rarity)
	local gold = { Legendary = true, Mythic = true, Secret = true }
	if gold[rarity] then
		return Color3.fromRGB(255, 214, 120)
	end
	-- the tier's own pale tone (the last spark colour: Epic's lilac, not its gold trim)
	local list = K.COLORS[rarity] or K.COLORS.Common
	return lighter(list[#list], 0.1)
end

function HatchFx.Rays(parent, rarity, opts)
	opts = type(opts) == "table" and opts or {}
	local holder = new("CanvasGroup", {
		Name = "Rays", BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), GroupTransparency = 1,
		Visible = false, ZIndex = opts.ZIndex or 1,
	}, parent)
	holder:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) the stage's art
	local color = rayColor(rarity)
	if type(opts.Image) == "string" then
		-- (roll-look review round 1, spec 16.15 "Fallbacks") the hatch_rays fan: one ImageLabel in the wedges' box, tinted
		new("ImageLabel", {
			Name = "Fan", Image = opts.Image, ImageColor3 = color, BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), ZIndex = holder.ZIndex,
		}, holder)
	else
		-- each bar is two opposite rays: clear at the centre (the egg / pet reads through), bright mid-way, gone at the ends
		local fade = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.16, 0.55), NumberSequenceKeypoint.new(0.36, 0.2),
			NumberSequenceKeypoint.new(0.47, 1), NumberSequenceKeypoint.new(0.53, 1), NumberSequenceKeypoint.new(0.64, 0.2),
			NumberSequenceKeypoint.new(0.84, 0.55), NumberSequenceKeypoint.new(1, 1),
		})
		for i = 1, 8 do
			local bar = new("Frame", {
				Name = "Ray" .. i, BorderSizePixel = 0, BackgroundColor3 = color, BackgroundTransparency = 0, AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, (i % 2 == 0) and 0.022 or 0.034), Rotation = (i - 1) * 22.5,
				ZIndex = holder.ZIndex,
			}, holder)
			new("UIGradient", { Name = "Fade", Transparency = fade }, bar)
		end
	end
	local h = handle(holder, K.RAY_TURN, opts)
	function h:Flash(alpha, seconds)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		f.Visible = true
		f.GroupTransparency = math.min(f.GroupTransparency, 1)
		self:_play("Fade", f, TweenInfo.new(math.max(0.01, seconds or 0.12), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = alpha or 0.35 })
	end
	function h:Recolor(r)
		local c = rayColor(r)
		for _, bar in ipairs(self.Frame and self.Frame:GetChildren() or {}) do
			if bar:IsA("ImageLabel") then
				bar.ImageColor3 = c
			elseif bar:IsA("Frame") then
				bar.BackgroundColor3 = c
			end
		end
	end
	return h
end

-- (U9-2b look review 2, the owner's look bar: no smooth round shapes) the shock is a square frame in a mitred stroke 2
-- units thick (opts.Unit: the screen's pixel, 3 px PC / 2 a phone), growing 0 -> d on whole px (an even size centred on a
-- whole px, driven by its NumberValue "Grow") while its stroke fades
function HatchFx.Shock(parent, rarity, opts)
	opts = type(opts) == "table" and opts or {}
	local ring = new("Frame", {
		Name = "Shock", BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Visible = false, ZIndex = opts.ZIndex or 3,
	}, parent)
	ring:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) the stage's art
	local unit = math.max(1, math.floor(tonumber(opts.Unit) or 3))
	local stroke = new("UIStroke", { Color = lighter(colorOf(rarity, 1), 0.1), Thickness = 2 * unit, Transparency = 0, LineJoinMode = Enum.LineJoinMode.Miter }, ring)
	local grow = new("NumberValue", { Name = "Grow", Value = 0 }, ring)
	grow:GetPropertyChangedSignal("Value"):Connect(function()
		local d = 2 * math.floor(grow.Value / 2)
		ring.Size = UDim2.fromOffset(d, d)
	end)
	local h = handle(ring, 12, opts)
	h.Stroke = stroke
	h.Token = 0
	function h:Play(x, y, d, seconds, color)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		self.Token = self.Token + 1
		local mine = self.Token
		seconds = math.max(0.05, seconds or 0.35)
		placeAt(f, math.floor(x), math.floor(y), 0)
		grow.Value = 0
		f.Visible = true
		self.Stroke.Color = color or self.Stroke.Color
		self.Stroke.Transparency = 0
		local out = TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		self:_play("Grow", grow, out, { Value = d })
		self:_play("Fade", self.Stroke, out, { Transparency = 1 })
		task.delay(seconds, function()
			if self.Token == mine and self.Frame and self.Frame.Parent then
				self.Frame.Visible = false
			end
		end)
	end
	return h
end

-- (U9-2b look review 2) one stepped pixel cloud (the kit's, the loading screen's puff): Row1..3 narrowing upward (each
-- Inset units in on both sides from the one under it) on a pale Shade row, every size whole units u; n = its width in units
local function puffParts(puff, alpha, z)
	for r = 1, 3 do
		new("Frame", { Name = "Row" .. r, BorderSizePixel = 0, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = alpha, ZIndex = z }, puff)
	end
	new("Frame", { Name = "Shade", BorderSizePixel = 0, BackgroundColor3 = K.RING_SHADE, BackgroundTransparency = alpha, ZIndex = z }, puff)
end

-- a puff's size for n units of u px: { W, H, Row, Inset, Shade (px), Rows (2 or 3) }: a flat cloud (about 3 : 1, the
-- loading screen's), its top row dropped when it would be under 3 units wide (a small x3 ring's puff: 2 rows, not a cone)
local function puffSize(n, u)
	local row = math.max(2, math.floor(n * 0.11 + 0.5))
	local inset = math.max(1, math.floor(n * 0.16 + 0.5))
	local shade = math.max(1, math.floor(row * 0.4 + 0.5))
	local rows = (n - 4 * inset >= 3) and 3 or 2
	return { W = n * u, H = (rows * row + shade) * u, Row = row * u, Inset = inset * u, Shade = shade * u, Rows = rows }
end

local function layoutPuff(puff, sz)
	puff.Size = UDim2.fromOffset(sz.W, sz.H)
	for r = 1, 3 do
		local row = puff:FindFirstChild("Row" .. r)
		if row then
			row.Visible = r <= sz.Rows
			row.Position = UDim2.fromOffset((r - 1) * sz.Inset, (sz.Rows - r) * sz.Row)
			row.Size = UDim2.fromOffset(math.max(0, sz.W - 2 * (r - 1) * sz.Inset), sz.Row)
		end
	end
	local shade = puff:FindFirstChild("Shade")
	if shade then
		shade.Position = UDim2.fromOffset(0, sz.Rows * sz.Row)
		shade.Size = UDim2.fromOffset(sz.W, sz.Shade)
	end
end

function HatchFx.CloudRing(parent, color, opts)
	opts = type(opts) == "table" and opts or {}
	local ring = new("CanvasGroup", {
		Name = "CloudRing", BackgroundTransparency = 1, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), GroupTransparency = 1,
		GroupColor3 = K.RING_TINT, Visible = false, ZIndex = opts.ZIndex or 1,
	}, parent)
	ring:SetAttribute("Art", "Hatch") -- (kit-b U9-2b) the stage's art
	-- (U9-2b look review 2) the swell and the bob are NumberValues: the puffs move on whole px, the ring never scales or turns
	local swell = new("NumberValue", { Name = "Swell", Value = 1 }, ring)
	local bob = new("NumberValue", { Name = "Bob", Value = 0 }, ring)
	-- the puffs: white (GroupColor3 tints them), on a circle RING_R of the ring's size out, big and small in turn and see-
	-- through (roll-look, spec 16.15: the pitch mock's cloudRing, a halo of cloud puffs round the egg rather than big blobs
	-- behind it), a little uneven so it reads as cloud, not a gear; (U9-2b look review 2) each a stepped pixel cloud
	for i = 1, K.RING_PUFFS do
		local big = i % 2 == 1
		local puff = new("Frame", { Name = "Puff" .. i, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = ring.ZIndex }, ring)
		puff:SetAttribute("Big", big)
		puffParts(puff, big and K.RING_PUFF_A[1] or K.RING_PUFF_A[2], ring.ZIndex)
	end
	local h = handle(ring, K.RING_TURN, opts)
	h.SwellV, h.BobV = swell, bob
	h.Color = color
	h.Unit = math.max(1, math.floor(tonumber(opts.Unit) or 3))
	h.D, h.Frame2 = 0, false
	-- the puffs at the ring's size d, its swell and the bob's frame: every puff's box on whole px of its CanvasGroup
	function h:Layout()
		local f = self.Frame
		if not f or not f.Parent or self.D <= 0 then
			return
		end
		local d, u = self.D, self.Unit
		-- the canvas: the ring's size at rest (inside the screen, as before), grown with the swell (the old UIScale's reach)
		local box = 2 * math.floor(d * math.max(1, swell.Value) / 2 + 0.5)
		placeAt(f, self.X, self.Y, box)
		for i = 1, K.RING_PUFFS do
			local puff = f:FindFirstChild("Puff" .. i)
			if puff then
				local a = (i - 1) / K.RING_PUFFS * 2 * math.pi
				local big = puff:GetAttribute("Big") == true
				local share = (big and K.RING_PUFF[1] or K.RING_PUFF[2]) * (1 + 0.12 * ((i * 0.618034) % 1))
				local n = math.max(6, 2 * math.floor(share * d / (2 * u) + 0.5))
				local sz = puffSize(n, u)
				local r = (K.RING_R + 0.015 * (((i + 3) * 0.381966) % 1)) * d * swell.Value
				local lift = (self.Frame2 and (i % 2 == 0)) and u or 0
				layoutPuff(puff, sz)
				puff.Position = UDim2.fromOffset(math.floor(box / 2 + math.cos(a) * r - sz.W / 2), math.floor(box / 2 + math.sin(a) * r - sz.H / 2) - lift)
			end
		end
	end
	function h:Place(x, y, d)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		self.D = math.max(0, d)
		self.X, self.Y = math.floor(x), math.floor(y) -- (its centre on a whole px; Layout keeps the size even)
		self:Layout()
	end
	swell:GetPropertyChangedSignal("Value"):Connect(function()
		h:Layout()
	end)
	bob:GetPropertyChangedSignal("Value"):Connect(function()
		local two = bob.Value >= 0.5
		if two ~= h.Frame2 then
			h.Frame2 = two
			h:Layout()
		end
	end)
	function h:Show(seconds)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		f.Visible = true
		swell.Value = 1
		f.GroupColor3 = K.RING_TINT:Lerp(self.Color or K.RING_TINT, 0.12)
		self:_play("Fade", f, TweenInfo.new(math.max(0.01, seconds or 0.3), Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = K.RING_REST })
	end
	-- (U9-2b look review 2) the ring's motion is a 2-frame bob (as SignKit.Spin flips its propellers): every other puff one
	-- unit up for RING_BOB s, then back; never a Rotation (a turned frame goes soft). Still High only
	function h:Spin(on)
		if on and high() and self.Frame and self.Frame.Parent then
			if not (self.Tw.Spin and self.Tw.Spin.PlaybackState == Enum.PlaybackState.Playing) then
				bob.Value = 0
				self:_play("Spin", bob, TweenInfo.new(2 * K.RING_BOB, Enum.EasingStyle.Linear, Enum.EasingDirection.Out, -1), { Value = 1 })
			end
		else
			cancel(self.Tw.Spin)
			self.Tw.Spin = nil
			bob.Value = 0
		end
	end
	function h:Pulse(c, seconds)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		seconds = math.max(0.05, seconds or 0.35)
		cancel(self.Tw.Tint)
		self.Tw.Tint = nil
		f.Visible = true
		f.GroupColor3 = c or self.Color or K.RING_TINT
		f.GroupTransparency = 0
		self:_play("Swell", swell, TweenInfo.new(math.min(0.2, seconds), Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = K.SWELL })
		self:_play("Fade", f, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { GroupTransparency = 1 })
	end
	-- (roll-look, spec 16.15) Gemini's shake tweak: the ring turns half way to the rarity colour
	function h:Tint(c, seconds)
		local f = self.Frame
		if not f or not f.Parent then
			return
		end
		local goal = K.RING_TINT:Lerp(c or self.Color or K.RING_TINT, 0.5)
		if seconds and seconds > 0 then
			self:_play("Tint", f, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupColor3 = goal })
		else
			cancel(self.Tw.Tint)
			self.Tw.Tint = nil
			f.GroupColor3 = goal
		end
	end
	return h
end

-- (U9-2b look review 2) a crack segment from (x1, y1) to (x2, y2) (shares of the egg; the egg is 0.8 x as wide as it is
-- tall) as a staircase of square pixels on the egg's crack grid (CRACK_CELL of its height a side): a holder `name` with
-- "Px1..n", one square per grid cell the line crosses (a cell another segment of the zigzag already has is skipped). No
-- Rotation, no gradient: flat light through the shell
local function segment(parent, name, x1, y1, x2, y2, color, z, taken)
	local ch = K.CRACK_CELL
	local cw = ch / 0.8
	local holder = new("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = z }, parent)
	local ax, ay = math.floor(x1 / cw + 0.5), math.floor(y1 / ch + 0.5)
	local bx, by = math.floor(x2 / cw + 0.5), math.floor(y2 / ch + 0.5)
	local steps = math.max(math.abs(bx - ax), math.abs(by - ay), 1)
	local n = 0
	for s = 0, steps do
		local cx = math.floor(ax + (bx - ax) * s / steps + 0.5)
		local cy = math.floor(ay + (by - ay) * s / steps + 0.5)
		local key = cx .. ":" .. cy
		if not taken[key] then
			taken[key] = true
			n = n + 1
			new("Frame", {
				Name = "Px" .. n, BorderSizePixel = 0, BackgroundColor3 = color, BackgroundTransparency = 0,
				Position = UDim2.fromScale((cx - 0.5) * cw, (cy - 0.5) * ch), Size = UDim2.fromScale(cw, ch), ZIndex = z,
			}, holder)
		end
	end
	return holder
end

local function eggLayer(egg, name, z)
	local holder = egg:FindFirstChild(name)
	if not holder then
		holder = new("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = z }, egg)
	end
	return holder
end

function HatchFx.Cracks(egg, rarity, step)
	if typeof(egg) ~= "Instance" then
		return nil
	end
	local z = egg.ZIndex + 8
	local holder = egg:FindFirstChild("Cracks")
	if not holder then
		holder = eggLayer(egg, "Cracks", z)
		-- (U9-2b look review 2) one flat light: white with a breath of the rarity's colour (no glow gradient)
		local light = lighter(colorOf(rarity, 1), 0.7)
		local taken = {}
		for i = 1, 5 do
			local a, b = K.ZIG[i + 1], K.ZIG[i + 2]
			segment(holder, "Seg" .. i, a[1], a[2], b[1], b[2], light, z, taken)
		end
		local br = K.BRANCH
		segment(holder, "Branch", br[1], br[2], br[3], br[4], light, z, taken)
	end
	step = math.max(0, math.floor(tonumber(step) or 0))
	local show = {}
	for _, i in ipairs(K.SEGS[step >= 5 and 5 or (step >= 3 and 3 or (step >= 1 and 1 or 0))] or {}) do
		show[i - 1] = true -- (K.SEGS names zigzag segments 2..6; Seg1..5 are segments 2..6)
	end
	for i = 1, 5 do
		local seg = holder:FindFirstChild("Seg" .. i)
		if seg then
			seg.Visible = show[i] == true
		end
	end
	local branch = holder:FindFirstChild("Branch")
	if branch then
		branch.Visible = step >= 5
	end
	holder:SetAttribute("Step", step)
	return holder
end

-- (U9-2b look review 2) a leak is a pixel ray (no Rotation, no gradient): up to #LEAK_A single crack cells stepping out
-- from a corner of the crack, up from a high corner (down from a low one), straight or one cell aside a step (the old
-- fan), each a step more see-through (LEAK_A): 1 cell at step 1, 2 at 3, 3 at 5
function HatchFx.Leaks(egg, rarity, step)
	if typeof(egg) ~= "Instance" then
		return nil
	end
	local z = egg.ZIndex + 7
	local holder = egg:FindFirstChild("Leaks")
	if not holder then
		holder = eggLayer(egg, "Leaks", z)
		local glow = lighter(colorOf(rarity, 1), 0.45)
		for i = 1, 5 do
			local beam = new("Frame", { Name = "Leak" .. i, BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = z }, holder)
			for k = 1, #K.LEAK_A do
				new("Frame", { Name = "Part" .. k, BorderSizePixel = 0, BackgroundColor3 = glow, BackgroundTransparency = K.LEAK_A[k], ZIndex = z }, beam)
			end
		end
	end
	step = math.max(0, math.floor(tonumber(step) or 0))
	local n = math.min(5, step)
	local parts = step >= 5 and 3 or (step >= 3 and 2 or 1)
	local ch = K.CRACK_CELL
	local cw = ch / 0.8
	for i = 1, 5 do
		local beam = holder:FindFirstChild("Leak" .. i)
		if beam then
			local p = K.ZIG[i + 2]
			beam.Visible = i <= n
			if i <= n then
				local up = p[2] < 0.61
				local dx = (i % 3) - 1 -- left, straight or right a step
				local cx = math.floor(p[1] / cw + 0.5)
				local cy = math.floor(p[2] / ch + 0.5)
				for k = 1, #K.LEAK_A do
					local part = beam:FindFirstChild("Part" .. k)
					if part then
						part.Visible = k <= parts
						part.Position = UDim2.fromScale((cx + dx * k - 0.5) * cw, (cy + (up and -k or k) - 0.5) * ch)
						part.Size = UDim2.fromScale(cw, ch)
					end
				end
			end
		end
	end
	holder:SetAttribute("Step", step)
	return holder
end

----------------------------------------------------------------------------------------------------
-- the world dim: the one Lighting effect and the "Hatch" LightingStack preset (High only)
----------------------------------------------------------------------------------------------------
local function lightingStack()
	if R.LS == nil then
		R.LS = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("LightingStack")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				R.LS = mod
			end
		end
	end
	return R.LS or nil
end

local function skyTransition()
	if R.ST == nil then
		R.ST = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("SkyTransition")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				R.ST = mod
			end
		end
	end
	return R.ST or nil
end

local function effectsOn()
	local n = 0
	if R.Blur and R.Blur.Parent then
		n = n + 1
	end
	if R.Pushed then
		n = n + 1
	end
	return n
end

function HatchFx.Dim(on, seconds)
	seconds = math.max(0.01, tonumber(seconds) or 0.35)
	local ls = lightingStack()
	if on and high() then
		if not (R.Blur and R.Blur.Parent) then
			local fading = R.Fading
			R.Fading = nil
			if fading and fading.Blur.Parent then
				-- still easing out: stop there and come back from that size (no new blur, no jump to 0)
				pcall(function()
					fading.Tween:Cancel()
				end)
				R.Blur = fading.Blur
			else
				local old = Lighting:FindFirstChild("NimbusHatchBlur")
				if old and old:IsA("BlurEffect") then
					old:Destroy()
				end
				R.Blur = new("BlurEffect", { Name = "NimbusHatchBlur", Size = 0 }, Lighting)
			end
		end
		cancel(R.BlurTween)
		R.BlurTween = play(R.Blur, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = K.BLUR })
		if ls and not R.Pushed then
			-- the tint against the look under it (LightingStack presets set absolute values)
			local b = ls.Value("ColorCorrection", "Brightness", "Hatch")
			local s = ls.Value("ColorCorrection", "Saturation", "Hatch")
			if type(b) == "number" and type(s) == "number" then
				local ok = pcall(ls.Push, "Hatch", { ColorCorrection = { Brightness = b + K.TINT.Brightness, Saturation = s + K.TINT.Saturation } }, seconds)
				R.Pushed = ok
			end
		end
	elseif not on then
		cancel(R.BlurTween)
		R.BlurTween = nil
		if R.Blur then
			local blur = R.Blur
			R.Blur = nil
			-- eased out, then destroyed by SkyTransition (at once only without it, or for a blur already off Lighting)
			local ST = skyTransition()
			local ok, tween = false, nil
			if ST and blur.Parent then
				ok, tween = pcall(ST.BlurOut, blur, seconds)
			end
			if ok and tween then
				R.Fading = { Blur = blur, Tween = tween }
			else
				blur:Destroy()
			end
		end
		if R.Pushed and ls then
			pcall(ls.Pop, "Hatch", seconds)
		end
		R.Pushed = false
	end
	return effectsOn()
end

function HatchFx.Stats()
	local live, pooled, beats, tweens = 0, 0, 0, 0
	for pool in pairs(R.Pools) do
		live = live + #pool.List
		pooled = pooled + pool.Made
		if pool.Conn then
			beats = beats + 1
		end
	end
	for tw in pairs(R.Stars) do
		if tw.PlaybackState == Enum.PlaybackState.Playing then
			tweens = tweens + 1
		end
	end
	return { Live = live, Pooled = pooled, Tweens = tweens, Heartbeats = beats, Effects = effectsOn() }
end

return HatchFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1191">
            <Properties>
              <string name="Name">HatchLook</string>
              <string name="Source"><![CDATA[-- HatchLook (client UI; roll-look, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.15 "Roll look A+B", the
-- owner's pick A "Showcase" + B's colour tell): the dressed pieces of the egg stage as builders and small handles with no
-- stage state of their own. client/UI/EggStage keeps the phases and calls these from its builders, layout and phase runner.
-- Every rarity colour comes from Shade(RarityColor(r), t) (the pitch mock's `shade`).
--
--   HatchLook.Shade(c, t) -> Color3           t >= 0: c towards white by t; t < 0: towards black by -t
--   HatchLook.RarityColor(rarity) -> Color3   Config.Rarities' colour; Secret the readable violet 180,150,255; an unknown
--                                             rarity the neutral 168,178,194
--   HatchLook.Order(rarity) -> number         Config.Rarities' Order (1 when unknown)
--   (kit-b U9-2b, finding 15) the chrome is the Signboard kit's: square flat blocks (CloudUI.SignBlock: a face, a mitred
--   "SignEdge" and a darker "Lip"), cream / wood / navy, no gloss, shine, drop shadow or soft glow. The stage's art (the
--   rays, the FX, the eggs) carries attribute Art = "Hatch"; (U9-2b look review 2) the plinth is a kit block now.
--   HatchLook.Card(cell, geo) -> card         skins a strip cell (a Frame, its egg inside) as a stone block: the face
--                                             Theme.Sign.Tile, the cell's own UIStroke the mitred wood "SignEdge" (geo.Edge
--                                             px), no corner. geo = { W, H, Edge, Plate, Word, Lite, Phone, Z }. Not Lite: the
--                                             "Plate" band (geo.Plate px) along the bottom holding the upper-case "Word";
--                                             Lite (a phone's x3): a "Lip" band only (look review: a PC x3 card holds the
--                                             plate too). card = { Frame, Plate, PlateText, Rim }. Adds only the Plate and its
--                                             Word to the cell (Lite: the Lip; the edge is the cell's own stroke, no shadow
--                                             beside it): spec 16.15 "Budgets"
--   HatchLook.SetCard(card, rarity|false, state)   state "Idle" | "Landed" | "Dim": the face Tile / the Selected cream /
--                                             the sunk Well (look review: the landed card's edge the ink, Sign.Text: the
--                                             kit's selected mark); the lip in RarityColor(r), the plate in
--                                             Theme.ReadableFace(RarityColor(r), 4.5) with its word in the ink it returns
--                                             (StoneLip without a rarity), 0.3 clear when Dim
--   HatchLook.ShowCard(card, cx, cy) / HideCard(card)   places a card by its centre (AnchorPoint 0.5), its hop
--                                             above it, or hides it
--   HatchLook.DropCard(card)                  destroys the cell
--   HatchLook.LandPop(card, fast, track, room) -> { tween }   the land (look review: never a scale): the card hops
--                                             min(POP.Hop, room) px up (0.1 s Quad Out) and back (0.1 s; Fast 0.05 / 0.05)
--                                             on whole px (a NumberValue "Hop" on the cell), and one white "Sweep" (a hard-
--                                             edged flat band, Offset -1 -> 1 in 0.3 s, Fast 0.12; destroyed after). Every
--                                             tween it plays (the chained one too) goes into `track`
--   HatchLook.SetPop(card)                    the card at rest, no hop (a resize cancelled its tweens)
--   HatchLook.Window(parent, pointer, opts) -> win   the gold winner window on the strip's existing "Pointer" frame (its
--                                             root): children Window (the square gold frame: a mitred stroke), NotchTop /
--                                             NotchBottom (stepped pixel pointers: a 6-unit row on the frame's edge, child
--                                             rows Row2 / Row3 of 4 and 2 units stepping in; look review: Notch is the unit,
--                                             the screen's pixel: 3 px on PC, 2 on a phone; every row on whole px), a
--                                             UIScale "Bounce"; beside it in `parent`, DimL / DimR darken the track outside
--                                             the window after the land. opts = { Phone, Gold, Stroke, Notch (0 = none),
--                                             Track (the tween set) }.
--                                             win:Place(x, y, w, h, trackW, trackH)  the window's box (the landed cell's + pad;
--                                                                        its centre on a whole px, its sides even)
--                                             win:Style(opts)            a layout's stroke and notches (a resize)
--                                             win:Tell(color, seconds)   every gold part turns `color` (attribute Tell = true)
--                                             win:Reset()                gold again (Tell = nil)
--                                             win:Bounce(seconds) / win:Rest()   a 1.08 -> 1 Back Out pop / at rest
--                                             win:SetDim(k)              the dims at k (0 = clear .. 1 = dark), per frame
--                                             win:DropGlow()             nothing (no glow any more; kept for the rise's call)
--                                             win:DropDims()             the dims go (an x3 strip at the rise: the budget)
--                                             win:Destroy()
--   HatchLook.TrackEnds(track) -> EndL, EndR   (look review) the rail's square ends: a flat TRACK_END.Px line of
--                                             Sign.NavyLip each, over the cards (no fade); EggStage places them
--   HatchLook.KEEP / HatchLook.ROBLOX         the ScreenGuis the stage never switches off: KEEP = spec 16.15's list (the
--                                             stage, toasts, the cursor hint, the tooltip, the Shop under the stage, the dev
--                                             tools, the main menu, the loading screen); ROBLOX = Roblox's own PlayerGui guis
--                                             (TouchGui: MenuController.SetTouchHidden owns the thumbstick; Freecam,
--                                             BubbleChat)
--   HatchLook.HideHud(playerGui, own) -> { ScreenGui }   switches off every Enabled ScreenGui in PlayerGui outside KEEP /
--                                             ROBLOX and not `own`, and remembers it
--   HatchLook.HideOne(gui)                    the same rule for one gui (PlayerGui.ChildAdded while the stage shows)
--   HatchLook.RestoreHud()                    switches each remembered gui back on when it is still in PlayerGui, still
--                                             off and not marked HudKeepOff, then forgets them. A remembered gui someone
--                                             switches on meanwhile is forgotten at once (theirs again: never fought, never
--                                             switched on by us later). (review round 1) An owner that switches its gui off
--                                             while the stage has it off writes the same value, which the stage cannot see:
--                                             it sets the attribute HudKeepOff (HatchLook.KEEP_OFF) = true for "keep it off"
--                                             (MovementController's MobileControls on a death), false when it shows it again
--   HatchLook.HiddenCount() -> number         how many guis are remembered (tests)
--   (Task 2: the opening)
--   HatchLook.Plinth(box, rarity, phone, opts) -> plinth   (U9-2b look review 2: a kit block, no ellipse, gradient or
--                                             halo) the slab the hero egg, its halves and the pet stand on, drawn in the
--                                             existing "Pedestal<j>" layout box (anchored at its top centre: the egg's foot,
--                                             the slab's top): "Slab" (CloudUI.SignBlock "Navy": the navy face, the mitred
--                                             GoldLip "SignEdge", its "Lip" in the rarity's colour) on "Foot" (a narrower
--                                             NavyLip block), every size whole units of the box's attribute Unit
--                                             (opts.Unit, else 2 on a phone, 3); a UIScale "Pop" kept at 1. Neutral
--                                             (Sign.NavyLip on the lip) until Tint. 7 instances.
--                                             opts = { Track (the tween set), Unit }
--                                             plinth:SetAlpha(a)        0 = hidden .. 1 = shown (the rise's fade, per frame)
--                                             plinth:Tint(color, s)     the lip `color` in s seconds (0: at once); remembered
--                                                                       for Rest
--                                             plinth:Reset()            neutral again;  plinth:Rest()  shown, colour snapped
--                                                                       (a resize cancelled the tweens)
--   HatchLook.PlinthLip(box, lip)             lays the slab and the foot out in the box's Size (call it after a resize);
--                                             lip = true (a phone's reveal): the slab fills the box (the 12 px lip), no
--                                             foot. Attributes SlabH / FootH (px)
--   HatchLook.IMAGES                          the three optional images, TextureIds keys: Rays "hatch_rays" (EggStage passes
--                                             it to HatchFx.Rays: one ImageLabel fan), Glow "hatch_glow" (no longer drawn: U9-2b
--                                             look review 2, kit B has no glow; the key stays for the TextureIds table),
--                                             Sparkle "hatch_sparkle" (HatchFx.Pool's sparks); none uploaded: their frame
--                                             fallbacks draw (HatchFx's ray wedges and spark squares)
--   HatchLook.Image(key) -> "rbxassetid://<id>" | nil   the key's shared/TextureIds id when it is a number > 0
--                                             (HatchLook._Textures: a test table in place of the module; false = the module)
--   HatchLook.EGG_IMAGES[rarity] = "egg_card_<rarity>"   (egg-cards, spec 16.18) the strip cards' egg pictures (Cycles
--                                             renders of the real Blender eggs, blender/textures/build_egg_cards.py; not
--                                             uploaded yet); HatchLook.EggImage(rarity) -> "rbxassetid://<id>" | nil;
--                                             HatchLook.EggImages() -> how many of the seven have an id;
--                                             HatchLook.EggPictures() -> true only when all seven have one: the cards
--                                             draw the pictures all together or not at all (review round 1: never a mix
--                                             in a strip, and a cell never holds a painted egg and a picture);
--                                             HatchLook.PreloadEggImages() -> n: ContentProvider:PreloadAsync of the
--                                             seven urls not yet sent (a spawned thread, once per url; 0 when
--                                             EggPictures() is false); Metrics.EGG_PIC.Fill = 0.9, the egg's share of
--                                             its square picture
--   (Task 3: the reveal)
--   HatchLook.Word(parent, text, rarity, size, opts) -> word   the rarity word: a Frame opts.Name ("Word") with the
--                                             attribute Text; opts.Letters: one Theme "Title" TextLabel per glyph "L1..Ln"
--                                             (kit-b U9-2b: the title look's face, white under a UIGradient "Bands" of three
--                                             hard bands Shade(c, .45) / c / Shade(c, -.2), one UIStroke Shade(c, -.68) of
--                                             clamp(round(size x 0.06), 2, 6) px, a UIScale "Pop") 0.04 x size apart, no
--                                             glow; no Letters: one such TextLabel (an x3 phone column, the crack word).
--                                             opts = { Letters, Name, ZIndex, Measure = function(text, size) -> px (the
--                                             stage's real text widths) }
--                                             word:Width() -> px            word:Place(cx, y)   (y = the top)
--                                             word:SetSize(size)            word:Destroy()
--                                             word:SetRarity(rarity)        the bands and the outline re-coloured
--                                             word:SetText(text)            a one-label word's text (+ attribute Text)
--                                             word:Pop(startAt, stagger, track)   letter i (from 0) 0 -> 1.3 (0.12 s Quad
--                                                 Out) -> 1 (0.14 s Quad In) at startAt + stagger x i (task.delay; the
--                                                 tweens go into `track`); one label: hidden until startAt
--                                             word:Settle()   every letter at 1, pending pops dropped (a resize mid-chain)
--   HatchLook.Pill(parent, opts) -> TextButton   a kit B plank named opts.Name (transparent tap box, Text ""): "Face" (a
--                                             CanvasGroup: the rise and fade) > "Body" (the block, CloudUI.SignBlock: Stone
--                                             the stone plank, Green the "Primary" grass, Gold the "Selected" look; its wood
--                                             "SignEdge" 3 px inside the group and its "Lip" 5 px), "Label" (Theme "Button",
--                                             the look's ink) and, with opts.Price, "Chip" (look review: the Shop's Spin row,
--                                             no tag box: a transparent holder after the label) > "Coin" (the stage puts the
--                                             icon in it; the Shop's Spin coin: item 9 B's carved token in its own
--                                             colours, greyed when disabled; a one-ink coin in Sign.GoldLip), "Price"
--                                             (Theme "Button" at the
--                                             label's size, the look's ink). The attribute Disabled (CloudUI.SetDisabled)
--                                             paints the sunk "Off" well with muted words and coin. A press sinks the face
--                                             onto its lip (PillState). opts = { Name, Kind = "Stone" | "Green" | "Gold",
--                                             Text, TextSize, Price, Coin, Phone, ZIndex }
--   HatchLook.PillParts(btn) -> { Face, Body, Lip, Edge, Label, Chip, Coin, Price }
--   HatchLook.PillState(btn, "Press" | "Rest")   the press: the lip 2 px, the words and the price 3 px lower; Rest: back
--   HatchLook.SizePill(btn, textSize, phone, coin)   a layout's text and coin sizes (coin default 30, phone 20: its
--                                             pixel icon 27 / 18, the kit's Glyph size)
--   HatchLook.FitPill(btn, labelW, priceW, parts?) -> chipW, fits   the inline price's width (the coin, the row gap,
--                                             the price) and whether the label fits beside it
--   HatchLook.SetPillChip(btn, w, parts?, labelW)   the price row w px wide after a label labelW px wide, the row centred
--                                             on the face on whole px (0: hidden, the label takes the whole face). parts:
--                                             the button's PillParts already looked up (review round 2: no lookups per
--                                             refresh)
--   HatchLook.PillIn(parts, k, rise)          the rise: the Face rise x (1 - k) px lower and 1 - k clear (k = 1: in place)
--   HatchLook.Chip(parent, opts) -> TextButton   a small chip: a transparent 44 px tap box drawing a "Pill" (36 px, phone
--                                             32): the navy SignBlock (its gold-lip edge 2 px, lip 3) with its cream
--                                             "Label". opts = { Name, Text, TextSize, Phone, ZIndex }
--   HatchLook.FastChip(parent, opts) -> TextButton   the Fast hatch chip: the navy chip with the kit's one switch
--                                             (CloudUI.SignSwitch, the Shop's: the "Switch" well slot and its stone "Knob"),
--                                             the "Label"
--   HatchLook.SetFast(chip, on)               the switch gold / the well slot, the knob's side, attribute On
--   HatchLook.SizeChip(chip, textSize, phone) / HatchLook.SetChipText(chip, text)
--   HatchLook.ChipRoom(w, fast, phone) -> px  the label's width in a chip w px wide (its block's edge, the pad or the
--                                             switch taken out): the room a caller measures a chip's words against
--   HatchLook.Tag(parent, name, text, look, opts) -> tag, words   a flat reveal tag (NEW!, EVOLVED): a SignBlock in the
--                                             CloudUI.SignLooks `look` (edge 2, lip 3) with its "Text" (Theme "Tag") above
--                                             the lip; square, never tilted. opts = { ZIndex, Visible, TextSize }
--
-- Plain Lua 5.1-compatible syntax only. Text goes through Theme roles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (Pitch 2 item 9 B) Grey: the carved coin's disabled state
local CloudUI = require(script.Parent:WaitForChild("CloudUI")) -- (kit-b U9-2b) CloudUI.SignBlock / SignLooks: the kit's blocks

local HatchLook = {}

local rgb = Color3.fromRGB
local Sign = Theme.Sign
local K = {
	WHITE = Color3.new(1, 1, 1),
	BLACK = Color3.new(0, 0, 0),
	SECRET = rgb(180, 150, 255), -- Secret's own colour is near black: the readable violet (EggStage.Metrics.SECRET_TEXT)
	NEUTRAL = rgb(168, 178, 194),
	GOLD = rgb(242, 182, 68), -- the window's rest gold = EggStage.Metrics.GOLD
	NOTCH = rgb(255, 215, 106),
	DIM = rgb(4, 6, 22),
	DIM_A = 0.5, -- the dims' darkest (transparency 1 - DIM_A)
	-- (look review) the land is the kit's hover lift, never a scale (a part takes no scale bounce: its pixel edges stay whole
	-- and the rail never clips it): the landed card hops Hop px up (at most its room) in Up s and back in Down s, whole px
	POP = { Hop = 4, Up = 0.1, Down = 0.1, UpFast = 0.05, DownFast = 0.05 },
	SWEEP = { Normal = 0.3, Fast = 0.12, Band = 0.45, Rotation = 18 },
	BOUNCE = 1.08,
	-- (U9-2b look review 2, the owner's look bar of 2026-11-17: no smooth round shapes, no glow) the plinth is a kit
	-- block: the navy sign slab (Sign.Navy, the GoldLip edge one unit, the rarity on its lip: the pitch's "rarity on the
	-- lip") on a narrower NavyLip foot, in the screen's pixel unit (3 px PC, 2 px a phone / a 720p PC): the slab SlabK x
	-- its box wide tall (at least SlabMin units, its lip 2 units from LipFrom), the foot FootK x the slab tall (at least
	-- FootMin units), FootIn x the box in on each side. Neutral (the navy sign's own lip) until the rarity shows
	PLINTH = {
		SlabK = 0.1, SlabMin = 5, LipFrom = 8, FootK = 0.5, FootMin = 3, FootIn = 0.1,
		-- (kit-b gate U9 round 3: two navy slabs read as empty nameplates) a shop's display stand: a wood top in its dark wood
		-- edge with one light top row (Shine) and the rarity on its lip (Neutral, the wood's own dark lip, before it), on a
		-- stone base in the same edge
		Face = Sign.Wood, Edge = Sign.WoodDark, Shine = Sign.WoodLight,
		Neutral = Sign.WoodDark, FootFace = Sign.Stone, FootLip = Sign.StoneLip,
	},
	INK = rgb(11, 16, 48),
	-- (Task 3) the rarity word (spec 16.15: the gradient / outline shades of c, the letters' pop, the glow behind). The
	-- outline: the mock's SVG stroke (0.12 x size) is centred on the glyph's edge, so 0.06 x size of it shows outside the
	-- glyph; a UIStroke's Thickness is all outside, so 0.06 x size draws the mock's outline (0.12 drew it twice as heavy).
	-- The glow: a halo taller and wider than the word (GlowW x size more, GlowH x size tall, less where the screen's edge
	-- is nearer), its fallback discs' centre about 0.68 clear (GlowA): the mock's blurred 0.5 stroke, never a slab
	-- (kit-b U9-2b) the letters wear the title look (Theme.StyleTitle's T1 face): white under HARD bands of the rarity's
	-- tones (Shade(c, Top) to BandA, c itself to BandB, Shade(c, Bottom) under it: no blend, the pixel kit's stepped
	-- shading) with ONE outline Shade(c, Outline); no glow halo (kit B: no glow)
	WORD = {
		Top = 0.45, Mid = 0, Bottom = -0.2, BandA = 0.45, BandB = 0.8, Outline = -0.68, OutlineK = 0.06, OutlineMin = 2, OutlineMax = 6, Spacing = 0.04, Pad = 0.2,
		Stagger = 0.05, Up = 0.12, Down = 0.14, Peak = 1.3,
	},
	-- (kit-b U9-2b) the bottom bar's planks: kit B blocks (CloudUI.SignBlock) in a CanvasGroup "Face" that rises and fades
	-- in; Kind -> its sign look (Stone: the stone plank, brown words; Green: the grass block, the stage's one green action;
	-- Gold: the selected look, kept for callers; disabled: the sunk Off well); Edge / Lip px (the kit's 3 / 5), the press
	-- leaves PressLip of the lip (the face sinks onto it). (look review) a price sits inline like the Shop's Spin: the
	-- label, the coin (Sign.GoldLip, whole px) and the price (the Button role, the label's size) one centred row, Gap(size)
	-- = max(3, floor(size x 0.3)) px apart (the Shop's row gap); LabelL px of face kept free each side
	PILL = {
		Look = { Gold = "Selected", Green = "Primary", Stone = "Stone" }, Edge = 3, Lip = 5, PressLip = 2, LabelL = 8, Coin = Sign.GoldLip,
	},
	-- (kit-b U9-2b) the chips (Skip, Fast hatch): a navy block (the kit's navy sign: gold-lip edge, darker lip) H / HPhone
	-- tall in the 44 px tap box, cream words; (look review) Fast hatch's switch is the kit's one switch, the Shop's
	-- (CloudUI.SignSwitch: the sunk well slot, the stone knob in its wood edge, gold while on: never a second green beside Done)
	CHIP = {
		H = 36, HPhone = 32, Pad = 12, Edge = 2, Lip = 3, Ink = Sign.Stone,
		SwitchW = 34, SwitchH = 18, SwitchWPhone = 30, SwitchHPhone = 16, SwitchX = 10,
	},
	-- (kit-b U9-2b) the strip's cards: stone blocks (Sign.Tile; the landed card Sign.Selected, the dimmed ones the sunk
	-- Well) in a mitred wood edge Edge px thick, the rarity's colour on the plate along the bottom (a lite x3 card: a Lip
	-- px lip), the word in the ink that reads on it (the plate moved to reach Need:1, Theme.ReadableFace); the window's
	-- pixel notches: three rows Unit px tall stepping in
	CARD = { Edge = 3, EdgePhone = 2, Lip = 5, LipPhone = 4, DimText = 0.3, Need = 4.5 },
	-- (egg-cards, spec 16.18) the card eggs' pictures (blender/textures/build_egg_cards.py): the egg's projected box is Fill
	-- of the square picture's height, centred; a cell draws the picture (egg px) / Fill square on the painted egg's box
	EGG_PIC = { Fill = 0.9 },
}
HatchLook.Metrics = K

----------------------------------------------------------------------
-- colours
----------------------------------------------------------------------
function HatchLook.Shade(c, t)
	t = tonumber(t) or 0
	if t >= 0 then
		return c:Lerp(K.WHITE, math.min(1, t))
	end
	return c:Lerp(K.BLACK, math.min(1, -t))
end

function HatchLook.RarityColor(rarity)
	if rarity == "Secret" then
		return K.SECRET
	end
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return r.Color
		end
	end
	return K.NEUTRAL
end

function HatchLook.Order(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return r.Order or 1
		end
	end
	return 1
end

local function tween(inst, seconds, goals, style, direction, track)
	if not inst or not inst.Parent then
		return nil
	end
	local info = TweenInfo.new(math.max(0.01, seconds), style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local tw = TweenService:Create(inst, info, goals)
	if track then
		track[tw] = true
	end
	tw:Play()
	return tw
end

local function frame(parent, name, props)
	props = props or {}
	props.Name = name
	props.BorderSizePixel = 0
	if props.BackgroundTransparency == nil then
		props.BackgroundTransparency = 1
	end
	props.Parent = parent
	return Util.Create("Frame", props)
end

local function corner(parent, r)
	return Util.Create("UICorner", { CornerRadius = (r and r < 1) and UDim.new(r, 0) or UDim.new(0, r or 12), Parent = parent })
end

local function stroke(parent, color, thickness, transparency)
	return Util.Create("UIStroke", { Color = color, Thickness = thickness or 2, Transparency = transparency or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = parent })
end

----------------------------------------------------------------------
-- the strip cards (kit-b U9-2b: stone blocks on the navy rail)
----------------------------------------------------------------------
function HatchLook.Card(cell, geo)
	local W, H = geo.W, geo.H
	local C = K.CARD
	local z = geo.Z or cell.ZIndex
	local card = { Frame = cell, Geo = geo, Lite = geo.Lite == true }
	cell.AnchorPoint = Vector2.new(0.5, 0.5)
	cell.BackgroundColor3 = Sign.Tile
	cell.BackgroundTransparency = 0
	for _, c in ipairs(cell:GetChildren()) do
		if c:IsA("UICorner") or c:IsA("UIGradient") then
			c:Destroy()
		end
	end
	-- the cell's own stroke is the block's mitred wood edge
	local rim = cell:FindFirstChildOfClass("UIStroke") or stroke(cell, Sign.Wood, 3)
	rim.Name = "SignEdge"
	rim.Color = Sign.Wood
	rim.Transparency = 0
	rim.LineJoinMode = Enum.LineJoinMode.Miter
	rim.Thickness = geo.Edge or (geo.Phone and C.EdgePhone or C.Edge)
	card.Rim = rim
	if card.Lite then
		-- (an x3 card: the rarity's colour on its lip only, the x3 budget)
		local lip = geo.Phone and C.LipPhone or C.Lip
		card.Plate = frame(cell, "Lip", {
			Position = UDim2.fromOffset(0, H - lip), Size = UDim2.new(1, 0, 0, lip), BackgroundColor3 = Sign.StoneLip, BackgroundTransparency = 0, ZIndex = z + 1,
		})
	else
		-- the plate: the card's lip band in the rarity's colour, the rarity's word on it
		local ph = geo.Plate or 30
		card.Plate = frame(cell, "Plate", {
			Position = UDim2.fromOffset(0, H - ph), Size = UDim2.new(1, 0, 0, ph), BackgroundColor3 = Sign.StoneLip, BackgroundTransparency = 0, ZIndex = z + 1,
		})
		local word = Theme.Label("", geo.Phone and "Label" or "Heading", { Size = geo.Word or 18 })
		word.Name = "Word"
		word.Size = UDim2.fromScale(1, 1)
		word.TextColor3 = Sign.Text
		word.TextXAlignment = Enum.TextXAlignment.Center
		word.ZIndex = z + 2
		word.Parent = card.Plate
		card.PlateText = word
	end
	return card
end

function HatchLook.SetCard(card, rarity, state)
	if not card then
		return
	end
	local key = tostring(rarity) .. "/" .. tostring(state)
	if card.Key == key then
		return
	end
	card.Key = key
	local cell = card.Frame
	local dim = state == "Dim"
	local c = rarity and HatchLook.RarityColor(rarity) or nil
	-- the face: stone, the landed card the selected face, the others sunk once the strip has landed; (look review) the
	-- landed card wears the kit's selected mark, its edge in the ink (the Pets grid's pick, the Gifts TODAY tile)
	cell.BackgroundColor3 = (state == "Landed" and Sign.Selected) or (dim and Sign.Well) or Sign.Tile
	cell.BackgroundTransparency = 0
	if card.Rim then
		card.Rim.Color = state == "Landed" and Sign.Text or Sign.Wood
	end
	card.Plate.BackgroundColor3 = c or Sign.StoneLip
	if card.PlateText then
		-- (U9-2b review) the word's plate is the rarity's colour moved the least it takes for its ink to read at 4.5:1 (a
		-- plate word is under 18 px on most screens): Epic's violet two steps lighter under the brown ink, the rest as is
		local face, ink = Sign.StoneLip, Sign.Text
		if c then
			face, ink = Theme.ReadableFace(c, K.CARD.Need)
		end
		card.Plate.BackgroundColor3 = face
		card.PlateText.Text = c and string.upper(rarity) or ""
		card.PlateText.TextColor3 = ink
		card.PlateText.TextTransparency = dim and K.CARD.DimText or 0
	end
end

function HatchLook.ShowCard(card, cx, cy)
	card.X, card.Y = cx, cy
	card.Frame.Position = UDim2.fromOffset(cx, cy - (card.HopY or 0))
	card.Frame.Visible = true
end

function HatchLook.HideCard(card)
	card.Frame.Visible = false
end

function HatchLook.DropCard(card)
	card.Frame:Destroy()
end

-- (look review) the hop's driver: a NumberValue "Hop" on the cell (px up); the card follows it in whole px
local function hopOf(card)
	local f = card.Frame
	local hop = f:FindFirstChild("Hop")
	if not (hop and hop:IsA("NumberValue")) then
		hop = Util.Create("NumberValue", { Name = "Hop", Value = 0, Parent = f })
		hop:GetPropertyChangedSignal("Value"):Connect(function()
			card.HopY = math.floor((tonumber(hop.Value) or 0) + 0.5)
			if card.X and f.Parent then
				f.Position = UDim2.fromOffset(card.X, card.Y - card.HopY)
			end
		end)
	end
	return hop
end

-- the card at rest: no hop (a resize cancelled its tweens); `scale` is ignored (kept for old callers: never a scale)
function HatchLook.SetPop(card, scale)
	if card and card.Frame and card.Frame.Parent then
		hopOf(card).Value = 0
		card.HopY = 0
		if card.X then
			card.Frame.Position = UDim2.fromOffset(card.X, card.Y)
		end
	end
end

-- (look review) the land: the card hops min(Hop, room) px up and back (room: the caller's free px above it inside the
-- rail and the window's navy pad), whole px, plus one hard-edged shine sweep; nothing scales, nothing is clipped
function HatchLook.LandPop(card, fast, track, room)
	local out = {}
	if not (card and card.Frame and card.Frame.Parent) then
		return out
	end
	local P = K.POP
	local hop = hopOf(card)
	hop.Value = 0
	local h = math.max(0, math.floor(math.min(P.Hop, tonumber(room) or P.Hop)))
	local up = h > 0 and tween(hop, fast and P.UpFast or P.Up, { Value = h }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, track) or nil
	if up then
		out[#out + 1] = up
		up.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and hop.Parent then
				tween(hop, fast and P.DownFast or P.Down, { Value = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In, track)
			end
		end)
	end
	-- one shine sweep across the card (the clutter cap: one, at the land); (kit-b U9-2b) a flat band with hard edges, no
	-- soft falloff (the pixel look: no blur)
	local sw = K.SWEEP
	local sweep = frame(card.Frame, "Sweep", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.WHITE, BackgroundTransparency = 0, ZIndex = card.Frame.ZIndex + 4 })
	local band = Util.Create("UIGradient", {
		Name = "Sweep", Rotation = sw.Rotation, Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1), NumberSequenceKeypoint.new(0.4201, sw.Band),
			NumberSequenceKeypoint.new(0.58, sw.Band), NumberSequenceKeypoint.new(0.5801, 1), NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = sweep,
	})
	local tw = tween(band, fast and sw.Fast or sw.Normal, { Offset = Vector2.new(1, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut, track)
	if tw then
		out[#out + 1] = tw
		tw.Completed:Connect(function()
			sweep:Destroy() -- (done or cancelled: never left half way)
		end)
	else
		sweep:Destroy()
	end
	return out
end

----------------------------------------------------------------------
-- the gold window and the track's ends
----------------------------------------------------------------------
local Win = {}
Win.__index = Win

-- (kit-b U9-2b) a notch is a pixel pointer: its own frame the widest row on the window's edge, two child rows stepping in
-- towards the card. (look review) u is the screen's pixel unit (the kit's pixel pair: 3 px on PC, 2 on a phone; 0 =
-- none), the rows 6u / 4u / 2u wide (even: they centre on a whole px), the widest at floor(w / 2) - 3u of the window's
-- w px, AnchorPoint 0: every row on whole px
local function placeNotch(notch, u, i, edge, w)
	u = math.max(0, math.floor(tonumber(u) or 0))
	local down = i == 1 -- the top notch points down into the window, the bottom one up
	notch.AnchorPoint = Vector2.new(0, down and 0 or 1)
	notch.Position = UDim2.new(0, math.floor((w or 0) / 2) - 3 * u, i - 1, down and -edge or edge)
	notch.Size = UDim2.fromOffset(6 * u, u)
	for r, row in ipairs({ notch:FindFirstChild("Row2"), notch:FindFirstChild("Row3") }) do
		row.Position = UDim2.fromOffset(r * u, (down and 1 or -1) * r * u)
		row.Size = UDim2.fromOffset((6 - 2 * r) * u, u)
	end
	notch.Visible = u > 0
end

function HatchLook.Window(parent, pointer, opts)
	opts = opts or {}
	local phone = opts.Phone == true
	local self = setmetatable({}, Win)
	self.Gold = opts.Gold or K.GOLD
	self.Track = opts.Track
	self.Root = pointer
	pointer.AnchorPoint = Vector2.new(0.5, 0.5)
	pointer.BackgroundTransparency = 1
	for _, c in ipairs(pointer:GetChildren()) do
		c:Destroy() -- (the old 6 px bar's corner)
	end
	local z = pointer.ZIndex
	self.Scale = Util.Create("UIScale", { Name = "Bounce", Scale = 1, Parent = pointer })
	-- (kit-b U9-2b) a square gold frame, mitred, no soft glow round it
	self.Window = frame(pointer, "Window", { Size = UDim2.fromScale(1, 1), ZIndex = z + 1 })
	self.WinStroke = stroke(self.Window, self.Gold, opts.Stroke or (phone and 3 or 4), 0)
	self.WinStroke.LineJoinMode = Enum.LineJoinMode.Miter
	self.NotchN = opts.Notch or (phone and 2 or 3) -- (look review) the notch's pixel unit, px
	self.Notches = {}
	for i, name in ipairs({ "NotchTop", "NotchBottom" }) do
		local notch = frame(pointer, name, { BackgroundColor3 = K.NOTCH, BackgroundTransparency = 0, ZIndex = z + 2 })
		for _, row in ipairs({ "Row2", "Row3" }) do
			frame(notch, row, { BackgroundColor3 = K.NOTCH, BackgroundTransparency = 0, ZIndex = z + 2 })
		end
		placeNotch(notch, self.NotchN, i, self.WinStroke.Thickness, 0)
		self.Notches[i] = notch
	end
	-- the dims beside the window (the mock's landDim: the track darkens round the winner). Square: past the track's
	-- rounded ends they only cover its near-black rim, where the dim cannot be told apart
	self.Dims = {}
	for i, name in ipairs({ "DimL", "DimR" }) do
		self.Dims[i] = frame(parent, name, { BackgroundColor3 = K.DIM, BackgroundTransparency = 1, ZIndex = math.max(1, z - 1) })
	end
	return self
end

-- (kit-b U9-2b: the window has no soft glow any more) kept for the rise's call
function Win:DropGlow() end

-- (Task 2) the dims go (an x3 strip sliding away at the rise: the budget)
function Win:DropDims()
	for _, d in ipairs(self.Dims) do
		d:Destroy()
	end
	self.Dims = {}
end

-- (look review: whole px) the box's centre on a whole px and its sides even, so every edge lands on a whole px (the
-- bounce still grows round the middle: AnchorPoint 0.5)
function Win:Place(x, y, w, h, trackW, trackH)
	local root = self.Root
	local W, Hh = 2 * math.floor(math.max(0, w) / 2 + 0.5), 2 * math.floor(math.max(0, h) / 2 + 0.5)
	local cx, cy = math.floor(x + w / 2 + 0.5), math.floor(y + h / 2 + 0.5)
	root.Position = UDim2.fromOffset(cx, cy)
	root.Size = UDim2.fromOffset(W, Hh)
	self.W = W
	for i, notch in ipairs(self.Notches) do
		placeNotch(notch, self.NotchN, i, self.WinStroke.Thickness, W)
	end
	if trackW and self.Dims[2] then
		local left, right = self.Dims[1], self.Dims[2]
		local x0, x1 = cx - W / 2, cx + W / 2
		left.Position = UDim2.fromOffset(0, 0)
		left.Size = UDim2.fromOffset(math.max(0, x0), trackH or h)
		right.Position = UDim2.fromOffset(x1, 0)
		right.Size = UDim2.fromOffset(math.max(0, trackW - x1), trackH or h)
	end
end

-- the sizes of a layout (a resize): the frame's stroke, the notches' pixel unit (0 = none); (kit-b U9-2b) square: no
-- corner, no glow
function Win:Style(opts)
	if opts.Stroke then
		self.WinStroke.Thickness = opts.Stroke
	end
	if opts.Notch then
		self.NotchN = opts.Notch
	end
	for i, notch in ipairs(self.Notches) do
		placeNotch(notch, self.NotchN, i, self.WinStroke.Thickness, self.W or 0)
	end
end

function Win:paint(color, seconds)
	local out = {}
	local parts = { { self.WinStroke, "Color" } }
	for _, notch in ipairs(self.Notches) do
		parts[#parts + 1] = { notch, "BackgroundColor3" }
		for _, row in ipairs(notch:GetChildren()) do
			parts[#parts + 1] = { row, "BackgroundColor3" }
		end
	end
	for _, p in ipairs(parts) do
		local inst, prop, goal = p[1], p[2], p[3] or color
		if seconds and seconds > 0 then
			out[#out + 1] = tween(inst, seconds, { [prop] = goal }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, self.Track)
		else
			inst[prop] = goal
		end
	end
	return out
end

function Win:Tell(color, seconds)
	self.Root:SetAttribute("Tell", true)
	self.TellColor = color
	return self:paint(color, seconds)
end

function Win:Reset()
	self.Root:SetAttribute("Tell", nil)
	self.TellColor = nil
	self.WinStroke.Color = self.Gold
	for _, notch in ipairs(self.Notches) do
		notch.BackgroundColor3 = K.NOTCH
		for _, row in ipairs(notch:GetChildren()) do
			row.BackgroundColor3 = K.NOTCH
		end
	end
end

function Win:Bounce(seconds)
	self.Scale.Scale = K.BOUNCE
	return tween(self.Scale, seconds, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out, self.Track)
end

function Win:Rest()
	self.Scale.Scale = 1
	if self.TellColor then
		self:paint(self.TellColor, 0)
	end
end

function Win:SetDim(k)
	local a = 1 - K.DIM_A * math.max(0, math.min(1, k))
	for _, d in ipairs(self.Dims) do
		d.BackgroundTransparency = a
	end
end

function Win:Destroy()
	for _, d in ipairs(self.Dims) do
		d:Destroy()
	end
	self.Root:Destroy()
end

-- (look review) the rail's square ends: no airbrushed fade (the kit has no soft gradient on its chrome), a flat End px
-- line of the rail's lip (Sign.NavyLip) inside the wood frame at each end, over the cards: the cards slide into a slot.
-- EggStage places them (EndL / EndR, the track's full height)
HatchLook.TRACK_END = { Px = 2, Color = Sign.NavyLip }
function HatchLook.TrackEnds(track)
	local out = {}
	for i, name in ipairs({ "EndL", "EndR" }) do
		out[i] = frame(track, name, { BackgroundColor3 = HatchLook.TRACK_END.Color, BackgroundTransparency = 0, ZIndex = 4 })
	end
	return out[1], out[2]
end

----------------------------------------------------------------------
-- the optional images (spec 16.15 "Fallbacks": no id today, the frames draw)
----------------------------------------------------------------------
HatchLook.IMAGES = { Rays = "hatch_rays", Glow = "hatch_glow", Sparkle = "hatch_sparkle" }
HatchLook._Textures = false -- (tests: a table of key -> id in place of shared/TextureIds; false = the module)

local TextureIds = nil
local function textures()
	if type(HatchLook._Textures) == "table" then
		return HatchLook._Textures
	end
	if TextureIds == nil then
		TextureIds = false
		local module = Shared:FindFirstChild("TextureIds")
		if module and module:IsA("ModuleScript") then
			local ok, ids = pcall(require, module)
			if ok and type(ids) == "table" then
				TextureIds = ids
			end
		end
	end
	return TextureIds or {}
end

function HatchLook.Image(key)
	local id = textures()[key]
	if type(id) == "number" and id > 0 then
		return "rbxassetid://" .. tostring(id)
	end
	return nil
end

-- (egg-cards, spec 16.18) the strip cards' egg pictures: one TextureIds key per rarity (none uploaded yet: the owner sees
-- the PNGs first); no id -> nil and the card draws its painted EggArt egg as before
HatchLook.EGG_IMAGES = {
	Common = "egg_card_common", Uncommon = "egg_card_uncommon", Rare = "egg_card_rare", Epic = "egg_card_epic",
	Legendary = "egg_card_legendary", Mythic = "egg_card_mythic", Secret = "egg_card_secret",
}

function HatchLook.EggImage(rarity)
	local key = HatchLook.EGG_IMAGES[rarity]
	return key and HatchLook.Image(key) or nil
end

local EGG_ORDER = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret" }

-- how many of the seven egg pictures have an id here
function HatchLook.EggImages()
	local n = 0
	for _, key in pairs(HatchLook.EGG_IMAGES) do
		if HatchLook.Image(key) then
			n = n + 1
		end
	end
	return n
end

-- (review round 1) the cards draw the pictures only when all seven have ids: one strip never mixes painted and rendered
-- eggs (as the hero eggs are 3D all together or not at all), and a cell never carries both (the x3's 750 cap: a cell with
-- a painted egg and a picture took a one-id x3 to 766 at the rise)
function HatchLook.EggPictures()
	return HatchLook.EggImages() >= #EGG_ORDER
end

-- (review round 1) the seven pictures fetched before a strip shows them (a 512 px image decodes a few frames after its
-- first use, and a picture card has no painted egg to show meanwhile): the urls not sent yet go to one
-- ContentProvider:PreloadAsync in a spawned thread, so nothing waits on it -> how many were sent now
local PRELOADED = {}
function HatchLook.PreloadEggImages()
	if not HatchLook.EggPictures() then
		return 0
	end
	local list = {}
	for _, rarity in ipairs(EGG_ORDER) do
		local url = HatchLook.EggImage(rarity)
		if url and not PRELOADED[url] then
			PRELOADED[url] = true
			list[#list + 1] = url
		end
	end
	if #list > 0 then
		task.spawn(function()
			pcall(function()
				ContentProvider:PreloadAsync(list)
			end)
		end)
	end
	return #list
end

----------------------------------------------------------------------
-- the plinth (the Pedestal<j> box's look; U9-2b look review 2: a kit block slab on a narrower foot, never a soft disc)
----------------------------------------------------------------------
local Plinth = {}
Plinth.__index = Plinth

-- the slab and its foot laid out in the box (its Size in px, attribute Unit = the screen's pixel u): the slab one block
-- (face, mitred GoldLip edge u px, lip) from the box's top (the egg's / the pet's foot) SlabK x the box wide tall (at
-- least SlabMin units), its lip 2 units (1 under LipFrom units), the foot FootK x the slab tall (at least FootMin units)
-- and FootIn x the box in on each side; every size whole units. lip = true (a phone's reveal): the slab fills the box (the
-- 12 px lip), no foot. A block's edge is a stroke outside its frame: each frame sits one edge inside its outline, and
-- the foot's top edge lies on the slab's bottom one (one line, not two)
function HatchLook.PlinthLip(box, lip)
	local slab, foot = box and box:FindFirstChild("Slab"), box and box:FindFirstChild("Foot")
	if not (slab and foot) then
		return
	end
	local P = K.PLINTH
	local u = math.max(1, box:GetAttribute("Unit") or 3)
	local w = math.floor(box.Size.X.Offset + 0.5)
	local function units(v)
		return math.floor(v / u + 0.5) * u
	end
	local slabH, lipH, footH, footIn
	if lip then
		slabH, lipH, footH, footIn = math.max(3 * u, math.floor(box.Size.Y.Offset + 0.5)), u, 0, 0
	else
		slabH = math.max(P.SlabMin * u, units(P.SlabK * w))
		lipH = slabH >= P.LipFrom * u and 2 * u or u
		footH = math.max(P.FootMin * u, units(P.FootK * slabH))
		footIn = math.max(2 * u, units(P.FootIn * w))
	end
	box:SetAttribute("SlabH", slabH)
	box:SetAttribute("FootH", footH)
	slab.Position = UDim2.fromOffset(u, u)
	slab.Size = UDim2.fromOffset(math.max(0, w - 2 * u), math.max(0, slabH - 2 * u))
	slab.SignEdge.Thickness = u
	slab.Lip.Size = UDim2.new(1, 0, 0, lipH)
	local shine = slab:FindFirstChild("Shine")
	if shine then
		shine.Size = UDim2.new(1, 0, 0, u) -- one pixel unit of light wood along the top
	end
	foot.Visible = footH > 0
	foot.Position = UDim2.fromOffset(footIn + u, slabH)
	foot.Size = UDim2.fromOffset(math.max(0, w - 2 * footIn - 2 * u), math.max(0, footH - 2 * u))
	foot.SignEdge.Thickness = u
	foot.Lip.Size = UDim2.new(1, 0, 0, u)
end

function HatchLook.Plinth(box, rarity, phone, opts)
	opts = opts or {}
	local P = K.PLINTH
	local self = setmetatable({ Box = box, Rarity = rarity, Track = opts.Track, Alpha = 1, Color = nil }, Plinth)
	local z = box.ZIndex
	box.AnchorPoint = Vector2.new(0.5, 0) -- (the egg's foot: the slab's top)
	box.BackgroundTransparency = 1
	box:SetAttribute("Unit", opts.Unit or (phone and 2 or 3))
	-- (kept at 1: the plinth rises and fades in with the egg, never a scale: its pixel edges stay whole)
	self.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = box })
	self.Foot = frame(box, "Foot", { BackgroundTransparency = 0, ZIndex = z })
	-- (Pitch 2 F0) the hatch stage keeps its approved roll look and its instance budget (smoke_roll_look: the plinth is 8
	-- instances, x3 <= 750 a frame): every kit block of the stage is painted with Finish = false (no finish pass parts)
	CloudUI.SignBlock(self.Foot, "Stone", { Face = P.FootFace, LipColor = P.FootLip, Edge = P.Edge, EdgePx = 2, LipPx = 2, Pad = false, Finish = false })
	self.Slab = frame(box, "Slab", { BackgroundTransparency = 0, ZIndex = z + 1 })
	CloudUI.SignBlock(self.Slab, "Stone", { Face = P.Face, LipColor = P.Neutral, Edge = P.Edge, EdgePx = 2, LipPx = 2, Pad = false, Finish = false })
	self.Slab.Lip.ZIndex = z + 2
	local shine = frame(self.Slab, "Shine", { BackgroundTransparency = 0, BackgroundColor3 = P.Shine, ZIndex = z + 2 })
	self.Parts = {
		{ self.Slab, "BackgroundTransparency" }, { self.Slab.SignEdge, "Transparency" }, { self.Slab.Lip, "BackgroundTransparency" },
		{ shine, "BackgroundTransparency" },
		{ self.Foot, "BackgroundTransparency" }, { self.Foot.SignEdge, "Transparency" }, { self.Foot.Lip, "BackgroundTransparency" },
	}
	HatchLook.PlinthLip(box, false)
	return self
end

-- (kept for callers: the plinth has no halo any more)
function Plinth:FitGlow() end

function Plinth:SetAlpha(a)
	a = math.max(0, math.min(1, a))
	self.Alpha = a
	for _, p in ipairs(self.Parts) do
		p[1][p[2]] = 1 - a
	end
end

-- the rarity on the slab's lip (the pitch's "rarity on the lip"); Neutral (the navy sign's own lip) before it
function Plinth:paint(c, seconds)
	local out = {}
	local lip = self.Slab and self.Slab:FindFirstChild("Lip")
	if lip then
		if seconds and seconds > 0 then
			out[#out + 1] = tween(lip, seconds, { BackgroundColor3 = c }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, self.Track)
		else
			lip.BackgroundColor3 = c
		end
	end
	return out
end

function Plinth:Tint(color, seconds)
	self.Color = color or HatchLook.RarityColor(self.Rarity)
	return self:paint(self.Color, seconds)
end

function Plinth:Reset()
	self.Color = nil
	self:paint(K.PLINTH.Neutral, 0)
end

function Plinth:Rest()
	self.Pop.Scale = 1
	self:SetAlpha(1)
	self:paint(self.Color or K.PLINTH.Neutral, 0)
end

----------------------------------------------------------------------
-- (Task 3) the rarity word: a TextLabel a glyph popping in turn (or one label), its gradient, outline and glow
----------------------------------------------------------------------
local Word = {}
Word.__index = Word

-- (kit-b U9-2b) the title look's hard bands in the rarity's tones (no blend between them)
local function wordColors(c)
	local W = K.WORD
	local top, mid, low = HatchLook.Shade(c, W.Top), HatchLook.Shade(c, W.Mid), HatchLook.Shade(c, W.Bottom)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, top), ColorSequenceKeypoint.new(W.BandA, top),
		ColorSequenceKeypoint.new(W.BandA + 0.0001, mid), ColorSequenceKeypoint.new(W.BandB, mid),
		ColorSequenceKeypoint.new(W.BandB + 0.0001, low), ColorSequenceKeypoint.new(1, low),
	})
end

local function wordLabel(parent, name, text, size, c, z)
	local W = K.WORD
	local l = Theme.Label(text, "Title", { Size = size, Stroke = 1 })
	l.Name = name
	l.TextColor3 = K.WHITE -- (the bands tint it)
	l.TextXAlignment = Enum.TextXAlignment.Center
	l.TextYAlignment = Enum.TextYAlignment.Center
	l.ZIndex = z
	Util.Create("UIGradient", { Name = "Bands", Rotation = 90, Color = wordColors(c), Parent = l })
	Util.Create("UIStroke", { Color = HatchLook.Shade(c, W.Outline), Thickness = 2, LineJoinMode = Enum.LineJoinMode.Round, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, Parent = l })
	l.Parent = parent
	return l
end

local function outlineOf(size)
	local W = K.WORD
	return math.max(W.OutlineMin, math.min(W.OutlineMax, math.floor(size * W.OutlineK + 0.5)))
end

function HatchLook.Word(parent, text, rarity, size, opts)
	opts = opts or {}
	local c = HatchLook.RarityColor(rarity)
	local z = opts.ZIndex or parent.ZIndex
	local self = setmetatable({ Text = tostring(text), Size = size, Letters = {}, Measure = opts.Measure, Token = 0, Tw = {} }, Word)
	if opts.Letters then
		self.Frame = frame(parent, opts.Name or "Word", { ZIndex = z })
		local i = 0
		for ch in self.Text:gmatch("[%z\1-\127\194-\244][\128-\191]*") do
			i = i + 1
			local l = wordLabel(self.Frame, "L" .. i, ch, size, c, z + 1)
			l.AnchorPoint = Vector2.new(0.5, 0.5) -- (its pop grows round its middle)
			self.Letters[i] = { Label = l, Char = ch, Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = l }), W = 0 }
		end
	else
		self.Frame = wordLabel(parent, opts.Name or "Word", self.Text, size, c, z)
	end
	self.Frame:SetAttribute("Text", self.Text)
	self:SetSize(size)
	return self
end

function Word:charW(text, size)
	local w = self.Measure and self.Measure(text, size) or nil
	return (type(w) == "number" and w > 0) and w or #text * size * 0.6
end

function Word:Width()
	if #self.Letters == 0 then
		return self:charW(self.Text, self.Size)
	end
	local w = 0
	for _, L in ipairs(self.Letters) do
		w = w + L.W
	end
	return w + K.WORD.Spacing * self.Size * (#self.Letters - 1)
end

function Word:SetSize(size)
	self.Size = size
	local th = outlineOf(size)
	if #self.Letters == 0 then
		self.Frame.TextSize = size
		self.Frame:FindFirstChildOfClass("UIStroke").Thickness = th
		return
	end
	local x, gap, pad = 0, K.WORD.Spacing * size, K.WORD.Pad * size
	for _, L in ipairs(self.Letters) do
		L.W = self:charW(L.Char, size)
		L.Label.TextSize = size
		L.Label:FindFirstChildOfClass("UIStroke").Thickness = th
		-- the glyph's box: its advance + a little room for the outline (never clipped), centred on the advance
		L.Label.Position = UDim2.fromOffset(x + L.W / 2, size / 2)
		L.Label.Size = UDim2.fromOffset(L.W + pad, size)
		x = x + L.W + gap
	end
end

-- (cx, y) = the word's centre and top; room (the old glow's screen room) is no longer used: the word has no halo
function Word:Place(cx, y)
	local w = self:Width()
	if #self.Letters == 0 then
		w = w + K.WORD.Pad * self.Size
	end
	self.Frame.Position = UDim2.fromOffset(cx - w / 2, y)
	self.Frame.Size = UDim2.fromOffset(w, self.Size)
end

function Word:drop()
	self.Token = self.Token + 1
	for tw in pairs(self.Tw) do
		pcall(function()
			tw:Cancel()
		end)
	end
	self.Tw = {}
end

function Word:Pop(startAt, stagger, track)
	self:drop()
	local mine = self.Token
	local W = K.WORD
	startAt = math.max(0, tonumber(startAt) or 0)
	if #self.Letters == 0 then
		self.Frame.Visible = false
		task.delay(startAt, function()
			if self.Token == mine and self.Frame.Parent then
				self.Frame.Visible = true
			end
		end)
		return
	end
	local function play(inst, seconds, goals, direction)
		local tw = tween(inst, seconds, goals, Enum.EasingStyle.Quad, direction, track)
		if tw then
			self.Tw[tw] = true
		end
		return tw
	end
	for i, L in ipairs(self.Letters) do
		L.Pop.Scale = 0
		task.delay(startAt + (stagger or W.Stagger) * (i - 1), function()
			if self.Token ~= mine or not L.Pop.Parent then
				return
			end
			local up = play(L.Pop, W.Up, { Scale = W.Peak }, Enum.EasingDirection.Out)
			if up then
				up.Completed:Connect(function(state)
					if state == Enum.PlaybackState.Completed and self.Token == mine and L.Pop.Parent then
						play(L.Pop, W.Down, { Scale = 1 }, Enum.EasingDirection.In)
					end
				end)
			end
		end)
	end
end

function Word:Settle()
	self:drop()
	for _, L in ipairs(self.Letters) do
		L.Pop.Scale = 1
	end
	if #self.Letters == 0 and self.Frame.Parent then
		self.Frame.Visible = true
	end
end

function Word:Destroy()
	self:drop()
	self.Frame:Destroy()
end

-- (review round 1) another rarity's colours on the same instances: the bands and the outline (the crack word moves on
-- to the next egg of an x3)
function Word:SetRarity(rarity)
	local c = HatchLook.RarityColor(rarity)
	local seq, edge = wordColors(c), HatchLook.Shade(c, K.WORD.Outline)
	local labels = { self.Frame }
	if #self.Letters > 0 then
		labels = {}
		for i, L in ipairs(self.Letters) do
			labels[i] = L.Label
		end
	end
	for _, l in ipairs(labels) do
		local g = l:FindFirstChildOfClass("UIGradient")
		if g then
			g.Color = seq
		end
		local s = l:FindFirstChildOfClass("UIStroke")
		if s then
			s.Color = edge
		end
	end
end

-- a one-label word's new text (the attribute Text follows); a letter word keeps its letters
function Word:SetText(text)
	self.Text = tostring(text)
	if #self.Letters == 0 then
		self.Frame.Text = self.Text
	end
	self.Frame:SetAttribute("Text", self.Text)
end

----------------------------------------------------------------------
-- (Task 3; kit-b U9-2b) the planks and the small chips of the bottom bar, the reveal's tags
----------------------------------------------------------------------
function HatchLook.PillParts(btn)
	local face = btn:FindFirstChild("Face")
	local body = face and face:FindFirstChild("Body")
	local chip = face and face:FindFirstChild("Chip")
	return {
		Face = face, Body = body, Lip = body and body:FindFirstChild("Lip"), Edge = body and body:FindFirstChild("SignEdge"), Label = face and face:FindFirstChild("Label"),
		Chip = chip, Coin = chip and chip:FindFirstChild("Coin"), Price = chip and chip:FindFirstChild("Price"),
	}
end

local function pressed(btn)
	return btn:GetAttribute("PillState") == "Press" and btn:GetAttribute("Disabled") ~= true
end

-- (look review) the gap between an inline price row's parts: the Shop's Spin row gap, max(3, floor(size x 0.3)) px
local function rowGap(size)
	return math.max(3, math.floor((tonumber(size) or 22) * 0.3))
end

-- the words and the price on the face above the lip; a press moves them down with the face (the lip shrinks under it).
-- (look review) with a price (attribute ChipW > 0: the coin, its gap and the price, px) the label (attribute LabelW px)
-- and the price are one row centred on the face at whole px, like the Shop's Spin (no tag box); no price: the label
-- fills the face
local function layoutPill(btn, p)
	local P = K.PILL
	local e = P.Edge
	local lip = pressed(btn) and P.PressLip or P.Lip
	local drop = P.Lip - lip
	local w = math.max(0, math.ceil(btn:GetAttribute("ChipW") or 0))
	if w > 0 and p.Chip then
		local labelW = math.ceil(btn:GetAttribute("LabelW") or 0)
		local gap = rowGap(p.Label.TextSize)
		local x0 = e + math.max(P.LabelL, math.floor((btn.Size.X.Offset - 2 * e - (labelW + gap + w)) / 2))
		p.Label.Position = UDim2.fromOffset(x0 - 1, e + drop)
		p.Label.Size = UDim2.new(0, labelW + 2, 1, -(2 * e + P.Lip))
		p.Chip.Visible = true
		p.Chip.Position = UDim2.fromOffset(x0 + labelW + gap, e + drop)
		p.Chip.Size = UDim2.new(0, w, 1, -(2 * e + P.Lip))
		if p.Coin then
			local rowH = btn.Size.Y.Offset - 2 * e - P.Lip
			p.Coin.Position = UDim2.fromOffset(0, math.max(0, math.floor((rowH - p.Coin.Size.Y.Offset) / 2)))
		end
	else
		p.Label.Position = UDim2.fromOffset(e + P.LabelL, e + drop)
		p.Label.Size = UDim2.new(1, -2 * (e + P.LabelL), 1, -(2 * e + P.Lip))
		if p.Chip then
			p.Chip.Visible = false
		end
	end
end

-- (Pitch 2 item 9 B) the coin's drawn PixelIcon (the Frame inside its host label) greyed while the plank is disabled: the
-- carved token keeps its own colours, so TextColor3 no longer mutes it; PixelIcon.Grey leaves a one-ink icon alone
local function greyCoin(btn, coin)
	for _, d in ipairs(coin and coin:GetDescendants() or {}) do
		if d:IsA("Frame") and d:GetAttribute("PixelIcon") then
			PixelIcon.Grey(d, btn:GetAttribute("Disabled") == true)
		end
	end
end

local function paintPill(btn)
	local P = K.PILL
	local p = HatchLook.PillParts(btn)
	local off = btn:GetAttribute("Disabled") == true
	local role = off and "Off" or (P.Look[btn:GetAttribute("Kind")] or "Stone")
	CloudUI.SignBlock(p.Body, role, { EdgePx = P.Edge, LipPx = pressed(btn) and P.PressLip or P.Lip, Pad = false, Finish = false })
	p.Label.TextColor3 = CloudUI.SignLooks[role].Text
	if p.Price then
		p.Price.TextColor3 = CloudUI.SignLooks[role].Text
		-- (look review) the token coin (a PixelIcon hosted in a text label) as the Shop's Spin draws it: (Pitch 2 item 9 B) the
		-- carved token in its own colours, greyed when disabled; a one-ink coin follows TextColor3 (the deep gold, muted when
		-- disabled). A GemIcon keeps its own colours
		local icon = p.Coin and p.Coin:FindFirstChild("Icon")
		if icon and icon:IsA("TextLabel") then
			icon.TextColor3 = off and Sign.TextMuted or P.Coin
		end
		greyCoin(btn, p.Coin)
	end
	layoutPill(btn, p)
end

-- a plank's state: "Press" (the face sunk onto its lip, the lip PressLip px) or "Rest"; a disabled plank never sinks
function HatchLook.PillState(btn, state)
	if btn and btn.Parent then
		btn:SetAttribute("PillState", state == "Press" and "Press" or "Rest")
		paintPill(btn)
	end
end

-- (kit-b U9-2b) a kit B plank in the bottom bar: a transparent tap box holding the CanvasGroup "Face" (the rise and the
-- fade) > "Body" (the block: its face colour, the wood edge "SignEdge" inside the group, the darker "Lip"), "Label"
-- (Button role) and, with opts.Price, "Chip" (look review: the inline price row, no box) > "Coin" (the stage draws the
-- icon in it), "Price" (the Button role, the look's ink). Attribute Disabled (CloudUI.SetDisabled) paints the sunk Off
-- well; a press sinks the face
function HatchLook.Pill(parent, opts)
	opts = opts or {}
	local P = K.PILL
	local z = opts.ZIndex or 1
	local kind = P.Look[opts.Kind or "Stone"] and (opts.Kind or "Stone") or "Stone"
	local btn = Util.Create("TextButton", {
		Name = opts.Name or "Pill", Text = "", AutoButtonColor = false, Active = true, BorderSizePixel = 0, BackgroundTransparency = 1, ZIndex = z, Parent = parent,
	})
	btn:SetAttribute("Kind", kind)
	local face = Util.Create("CanvasGroup", { Name = "Face", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = z + 1, Parent = btn })
	-- the block sits its edge's width inside the group (a Border stroke draws outside its frame: never clipped)
	frame(face, "Body", { Position = UDim2.fromOffset(P.Edge, P.Edge), Size = UDim2.new(1, -2 * P.Edge, 1, -2 * P.Edge), BackgroundTransparency = 0, ZIndex = z + 1 })
	local label = Theme.Label(opts.Text or "", "Button", { Size = opts.TextSize or 22, Stroke = 1 })
	label.Name = "Label"
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.ZIndex = z + 3
	label.Parent = face
	if opts.Price then
		-- (look review) the price row: a transparent holder (no tag box), the coin and the price at whole px
		local chip = frame(face, "Chip", { ZIndex = z + 2 })
		local coin = frame(chip, "Coin", { ZIndex = z + 3 })
		-- (Pitch 2 item 9 B) a coin drawn, or redrawn by a resize (PixelIcon.Host draws a new icon), while disabled lands greyed
		coin.DescendantAdded:Connect(function(d)
			if d:IsA("Frame") and d:GetAttribute("PixelIcon") then
				PixelIcon.Grey(d, btn:GetAttribute("Disabled") == true)
			end
		end)
		local price = Theme.Label("", "Button", { Size = opts.TextSize or 22, Stroke = 1 })
		price.Name = "Price"
		price.TextXAlignment = Enum.TextXAlignment.Left
		price.ZIndex = z + 3
		price.Parent = chip
	end
	btn:SetAttribute("PillState", "Rest")
	btn:GetAttributeChangedSignal("Disabled"):Connect(function()
		paintPill(btn)
	end)
	btn.MouseButton1Down:Connect(function()
		HatchLook.PillState(btn, "Press")
	end)
	btn.MouseButton1Up:Connect(function()
		HatchLook.PillState(btn, "Rest")
	end)
	btn.MouseLeave:Connect(function()
		HatchLook.PillState(btn, "Rest")
	end)
	-- a finger that lifts never produces MouseLeave (nor MouseButton1Up once it slid off)
	btn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			HatchLook.PillState(btn, "Rest")
		end
	end)
	btn:SetAttribute("ChipW", 0)
	paintPill(btn)
	HatchLook.SizePill(btn, opts.TextSize or 22, opts.Phone, opts.Coin)
	return btn
end

-- a layout's text and coin sizes; (look review) the price in the label's size and role, the coin a whole-px box (its
-- pixel icon centred in it by PixelIcon.Host's whole-px offset), the price the row gap after it
function HatchLook.SizePill(btn, textSize, phone, coin)
	local p = HatchLook.PillParts(btn)
	p.Label.TextSize = textSize
	btn:SetAttribute("Phone", phone == true)
	if p.Price then
		coin = math.floor(coin or (phone and 20 or 30))
		local gap = rowGap(textSize)
		p.Price.TextSize = textSize
		p.Coin.Size = UDim2.fromOffset(coin, coin)
		-- a hosted pixel coin (a text label: NeonKit.Icon) is the coin's own box at 0, 0, its glyph size the coin's (the
		-- icon redraws at 0.9 x it, centred on whole px)
		local icon = p.Coin:FindFirstChild("Icon")
		if icon and icon:IsA("TextLabel") then
			icon.AnchorPoint = Vector2.new(0, 0)
			icon.Position = UDim2.fromOffset(0, 0)
			icon.Size = UDim2.fromOffset(coin, coin)
			icon.TextSize = coin
		end
		p.Price.Position = UDim2.fromOffset(coin + gap, 0)
		p.Price.Size = UDim2.new(1, 2 - (coin + gap), 1, 0)
	end
	layoutPill(btn, p)
end

-- (look review) the inline price's width for a price priceW px wide (the coin, the row gap, the price: whole px) and
-- whether the label (labelW px) fits beside it on the face, LabelL px kept free each side
function HatchLook.FitPill(btn, labelW, priceW, parts)
	local P = K.PILL
	local p = parts or HatchLook.PillParts(btn)
	local coin = p.Coin and p.Coin.Size.X.Offset or 0
	local gap = rowGap(p.Label.TextSize)
	local content = math.ceil(coin + gap + priceW)
	local room = btn.Size.X.Offset - 2 * (P.Edge + P.LabelL)
	return content, labelW + gap + content <= room
end

-- the price row w px wide (0: hidden, the label takes the whole face) beside a label labelW px wide. parts: the button's
-- PillParts already looked up (review round 2: no lookups per refresh)
function HatchLook.SetPillChip(btn, w, parts, labelW)
	btn:SetAttribute("ChipW", math.max(0, w))
	btn:SetAttribute("LabelW", math.max(0, tonumber(labelW) or 0))
	layoutPill(btn, parts or HatchLook.PillParts(btn))
end

function HatchLook.PillIn(parts, k, rise)
	k = math.max(0, math.min(1, k))
	parts.Face.Position = UDim2.fromOffset(0, (1 - k) * (rise or 0))
	parts.Face.GroupTransparency = 1 - k
end

-- (kit-b U9-2b) a small chip: a transparent 44 px tap box drawing the navy "Pill" block (the kit's navy sign: its gold-lip
-- edge, its darker lip) with its cream "Label"
function HatchLook.Chip(parent, opts)
	opts = opts or {}
	local C = K.CHIP
	local z = opts.ZIndex or 1
	local btn = Util.Create("TextButton", {
		Name = opts.Name or "Chip", Text = "", AutoButtonColor = false, Active = true, BorderSizePixel = 0, BackgroundTransparency = 1, ZIndex = z, Parent = parent,
	})
	local pill = frame(btn, "Pill", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 0, ZIndex = z })
	CloudUI.SignBlock(pill, "Navy", { EdgePx = C.Edge, LipPx = C.Lip, Pad = false, Finish = false })
	local label = Theme.Label(opts.Text or "", "Label", { Size = opts.TextSize or 18, Stroke = 1 })
	label.Name = "Label"
	label.TextColor3 = C.Ink
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = z + 1
	label.Parent = pill
	HatchLook.SizeChip(btn, opts.TextSize or 18, opts.Phone)
	return btn
end

-- the Fast hatch chip: the navy chip with the kit's switch (CloudUI.SignSwitch: the "Switch" slot and its "Knob", the
-- Shop's part) and its "Label"
function HatchLook.FastChip(parent, opts)
	opts = opts or {}
	local z = opts.ZIndex or 1
	local btn = HatchLook.Chip(parent, { Name = opts.Name or "FastHatch", Text = "Fast hatch", TextSize = opts.TextSize, Phone = opts.Phone, ZIndex = z })
	local pill = btn:FindFirstChild("Pill")
	CloudUI.SignSwitch(pill, { ZIndex = z + 1, Finish = false })
	HatchLook.SizeChip(btn, opts.TextSize or 18, opts.Phone)
	HatchLook.SetFast(btn, false)
	return btn
end

-- a chip label's left inset in its block and the block's width it leaves out: Skip Pad each side; Fast hatch the switch
-- and a 4 px gap on its left, the switch's inset on its right. (U9-2b review) the switch sits SwitchX px in from the tap
-- box (the block's edge inside it), so the label keeps the room it had before the block moved inside the tap box
local function chipInsets(fast, phone)
	local C = K.CHIP
	if not fast then
		return C.Pad, 2 * C.Pad
	end
	local x, w = C.SwitchX - C.Edge, phone and C.SwitchWPhone or C.SwitchW
	return x + w + 4, 2 * x + w + 4
end

-- a layout's chip: the block H / HPhone tall inside the tap box (its edge inside the box too), the words over the lip
function HatchLook.SizeChip(btn, textSize, phone)
	local C = K.CHIP
	local pill = btn:FindFirstChild("Pill")
	local label = pill:FindFirstChild("Label")
	pill.Size = UDim2.new(1, -2 * C.Edge, 0, (phone and C.HPhone or C.H) - 2 * C.Edge)
	label.TextSize = textSize
	local sw = pill:FindFirstChild("Switch")
	local left, out = chipInsets(sw ~= nil, phone)
	if sw then
		-- (look review: whole px) the slot's top a whole px, centred on the face above the lip
		local w, h = phone and C.SwitchWPhone or C.SwitchW, phone and C.SwitchHPhone or C.SwitchH
		local pillH = (phone and C.HPhone or C.H) - 2 * C.Edge
		sw.AnchorPoint = Vector2.new(0, 0)
		sw.Position = UDim2.fromOffset(C.SwitchX - C.Edge, math.floor((pillH - h) / 2) - math.floor(C.Lip / 2))
		sw.Size = UDim2.fromOffset(w, h)
		HatchLook.SetFast(btn, btn:GetAttribute("On") == true)
	end
	-- (Fast hatch: the label centred in the room right of the switch)
	label.Position = UDim2.fromOffset(left, 0)
	label.Size = UDim2.new(1, -out, 1, -C.Lip)
end

-- (U9-2b review) the label's width in a chip w px wide (the tap box): what SizeChip leaves it, so a caller that picks the
-- words for a chip (EggStage's Skip forms) measures against the real label box
function HatchLook.ChipRoom(w, fast, phone)
	local _, out = chipInsets(fast == true, phone)
	return w - 2 * K.CHIP.Edge - out
end

-- (kit-b U9-2b) a flat tag of the reveal (NEW!, EVOLVED): a Frame named `name` painted as a kit B block in `look` (a
-- CloudUI.SignLooks name: its face, wood or gold-lip edge Edge px and darker lip) with its words "Text" (Tag role, in
-- capitals) on the face above the lip, the look's ink; square, never tilted
HatchLook.TAG = { Edge = 2, Lip = 3 }
function HatchLook.Tag(parent, name, text, look, opts)
	opts = opts or {}
	local T = HatchLook.TAG
	local z = opts.ZIndex or 6
	local tag = frame(parent, name, { BackgroundTransparency = 0, ZIndex = z, Visible = opts.Visible ~= false })
	CloudUI.SignBlock(tag, look, { EdgePx = T.Edge, LipPx = T.Lip, Pad = false, Finish = false })
	local words = Theme.Label(text, "Tag", { Size = opts.TextSize or 15 })
	words.Name = "Text"
	words.Size = UDim2.new(1, 0, 1, -T.Lip)
	words.ZIndex = z + 1
	words.TextColor3 = CloudUI.SignLooks[look].Text
	words.TextXAlignment = Enum.TextXAlignment.Center
	words.Parent = tag
	return tag, words
end

function HatchLook.SetChipText(btn, text)
	local pill = btn and btn:FindFirstChild("Pill")
	local label = pill and pill:FindFirstChild("Label")
	if label then
		label.Text = text
	end
end

function HatchLook.SetFast(btn, on)
	local pill = btn and btn:FindFirstChild("Pill")
	local sw = pill and pill:FindFirstChild("Switch")
	if not sw then
		return
	end
	CloudUI.SetSignSwitch(sw, on) -- (look review) the Shop's switch: gold while on, the knob slid across
	btn:SetAttribute("On", on == true)
end

----------------------------------------------------------------------
-- the HUD hides while the stage shows (spec 16.15 "The HUD hides")
----------------------------------------------------------------------
HatchLook.KEEP = {
	NimbusHatch = true, NimbusNotify = true, NimbusMouseLockHint = true, CloudUITooltip = true, NimbusShop = true, NimbusDev = true,
	NimbusMainMenu = true, NimbusLoading = true,
}
HatchLook.ROBLOX = { TouchGui = true, Freecam = true, BubbleChat = true }

local Hidden = {} -- [ScreenGui] = its Enabled watch (a connection)

local function hideOne(gui, own)
	if typeof(gui) ~= "Instance" or not gui:IsA("ScreenGui") or gui == own or Hidden[gui] ~= nil then
		return false
	end
	if HatchLook.KEEP[gui.Name] or HatchLook.ROBLOX[gui.Name] or not gui.Enabled then
		return false
	end
	gui.Enabled = false
	-- someone switches it on while the stage shows: it is theirs again (left on now, never switched on by us later)
	Hidden[gui] = gui:GetPropertyChangedSignal("Enabled"):Connect(function()
		local conn = Hidden[gui]
		if conn and gui.Enabled then
			Hidden[gui] = nil
			conn:Disconnect()
		end
	end)
	return true
end

function HatchLook.HideHud(pg, own)
	local out = {}
	for _, gui in ipairs(pg and pg:GetChildren() or {}) do
		if hideOne(gui, own) then
			out[#out + 1] = gui
		end
	end
	return out
end

function HatchLook.HideOne(gui)
	return hideOne(gui, nil)
end

-- (review round 1) an owner that switches its gui off while the stage already has it off writes the same value: no
-- signal reaches the stage, so the owner says so with the attribute HudKeepOff = true (MovementController's
-- MobileControls on a death) and the restore leaves that gui off
HatchLook.KEEP_OFF = "HudKeepOff"

function HatchLook.RestoreHud()
	local list = Hidden
	Hidden = {}
	for gui, conn in pairs(list) do
		pcall(function()
			conn:Disconnect()
		end)
		pcall(function()
			if gui.Parent ~= nil and gui.Enabled == false and gui:GetAttribute(HatchLook.KEEP_OFF) ~= true then
				gui.Enabled = true
			end
		end)
	end
end

function HatchLook.HiddenCount()
	local n = 0
	for _ in pairs(Hidden) do
		n = n + 1
	end
	return n
end

return HatchLook
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1192">
            <Properties>
              <string name="Name">NeonKit</string>
              <string name="Source"><![CDATA[-- NeonKit: the Phase 5 "Neon" GUI kit (ARCHITECTURE_V3.md "Phase 5 build contract" 6.6, image 21.png): dark navy
-- cards with a glowing neon border in their own colour, a soft coloured floor glow, big glossy icons on orbs and bold
-- white GothamBlack labels with a dark stroke. Premium, game-y, and never in the way: the window rule (SideRect /
-- Dock) keeps every window docked at the right edge (landscape) or as a bottom sheet (portrait).
-- kit-b U6: the tile label, the badge mark, the pill's glyph and count and the button text sit on their own card, so
-- they carry no outline any more (kit B "stroke or panel, never both").
--
--   NeonKit.Card(props)  -> { Root, Body, Stroke, Glow, Floor, SetColor(color), SetGlow(on) }
--   NeonKit.Tile(props)   -> { Root, Card, Orb, Icon, Label, SetBadge(on), SetColor(color), SetLabel(text), SetIcon(id) }
--   NeonKit.Orb(parent, color, size)  -> Frame (a glossy disc; centred in its parent unless moved)
--   NeonKit.Icon(parent, id, size)    -> TextLabel with no text hosting a PixelIcon (kit-b U7a: Config.Icons[id] names one,
--                                        or `id` is a PixelIcon name) | ImageLabel (Config.Icons[id] = "rbxassetid://n") |
--                                        "Gems": the same empty TextLabel hosting a client/UI/GemIcon (the cut gem) |
--                                        a TextLabel showing `id` itself (plain text such as "!" or "R$": no emoji)
--   NeonKit.IconName(id)              -> the PixelIcon name `id` draws as, or nil
--   NeonKit.Pill(props)   -> { Root, Card, Coin, Glyph, Text, SetText(text), SetColor(color) }
--   NeonKit.Button(props) -> TextButton (Variant "Primary" | "Outline"; hover 1.04 / press 0.95; Disabled attribute)
--   NeonKit.CloseMark(button, opts) -> Frame "CloseMark" (the drawn X of every window's close button; slop audit 2026-11-12)
--   NeonKit.SideRect(prefW, prefH, minW, minH) -> { x, y, w, h, scale, mode = "Side" | "Sheet", designW, designH }
--   NeonKit.BigRect(K, opts) -> { x, y, w, h, scale, mode = "PC" | "Phone", portrait }   (the Pets / Store window box)
--   NeonKit.Dock(holder, uiScale, prefW, prefH, minW, minH) -> { Rect, Refresh(), Disconnect() }
--   NeonKit.OpenDocks() -> { { x0, y0, x1, y1, mode }... } the docked windows on screen (U9-7 look: the HUD keeps clear)
--     (also a MouseLock hold while the holder is shown: client/MouseLock.WatchVisible; dungeon-fixes decision 6)
--
-- Conventions (the same as CloudUI): sizes are DESIGN pixels of a 1920x1080 screen; put the tree under one UIScale
-- (CloudUI.AutoScale, or the scale NeonKit.Dock writes) and it follows the readability rule everywhere. Colours are a
-- Color3, a Theme.Neon name ("Orange") or a Theme.Category name ("Pets"); see Theme.NeonColor. Every text uses a
-- Theme font role. Every constructor takes Name / Parent / Position / AnchorPoint / Size / LayoutOrder / ZIndex.
-- Card children go into card.Body (it never gets decorative children, so a UIListLayout there is fine).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local GemIcon = require(script.Parent:WaitForChild("GemIcon"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon"))
local SignKit = require(Shared:WaitForChild("SignKit")) -- (LOOK-ui) the close block's token (NeonKit.CloseBlock)

local NeonKit = {}

local Colors = Theme.Colors
local WHITE = Colors.White
local INK = Colors.PanelInk or Color3.fromRGB(8, 10, 28)
local TOP = Colors.PanelTop or Color3.fromRGB(26, 32, 72)
local BOTTOM = Colors.PanelBottom or Color3.fromRGB(12, 15, 38)

-- the kit's numbers (design px); tests and window owners read them
NeonKit.Metrics = {
	Corner = 14, -- card corner radius
	Stroke = 3, -- the neon border
	GlowPad = 3, -- the glow ring frame sits this far outside the card (its stroke hugs the neon border)
	GlowStroke = 5, -- ... this thick
	GlowTransparency = 0.62,
	FloorFrom = 0.45, -- the coloured floor glow starts this far down the card (scale)
	FloorTransparency = 0.72, -- ... and is this transparent at the very bottom
	FloorMaxHeight = 260, -- cards taller than this get no floor by default (windows)
	SheenTransparency = 0.8,
	TileIcon = 0.46, -- icon glyph size x tile size
	TileOrb = 0.62, -- orb diameter x tile size
	TileLabel = 0.2, -- label text size x tile size
	TileLabelMin = 18, -- ... never below this (14.4 px on a phone at the 0.8 scale)
	LabelStroke = 0, -- (kit-b U6) a tile label sits on its card: no outline (was a 2.5 px dark stroke)
	Margin = 12, -- window rule: screen margin x the screen factor
	Inset = 58, -- window rule: Roblox's top bar
	SideMaxW = 0.44, -- landscape: a docked window is at most this much of the width
	SheetMaxH = 0.56, -- portrait: a bottom sheet is at most this much of the height
	SheetScale = 0.8,
	MinScaleDesktop = 0.85,
	MinScaleTouch = 0.8,
	CloseMark = 0.6, -- the drawn close X: its square box x the button's short side (CloseMark)
	CloseBar = 0.17, -- ... a bar's thickness x that box (its length is the box side)
	CloseInk = 2, -- ... the dark bar under each white one is this many px larger on every side
}
local MX = NeonKit.Metrics

-- (kit-b U7a) the icon ids are PixelIcons now: Config.Icons[id] names each one's 9 x 9 bitmap (or an uploaded image),
-- so no id draws an emoji. NeonKit.Glyphs keeps only the plain-text fallbacks of the ids with no icon (none today).
NeonKit.Glyphs = {}

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function colorOf(value, fallback)
	if typeof(value) == "Color3" then
		return value
	end
	if type(value) == "string" and value ~= "" then
		return Theme.NeonColor(value)
	end
	return fallback or Theme.Neon.Blue
end
NeonKit.ColorOf = colorOf

local function toUDim2(value, default)
	if typeof(value) == "UDim2" then
		return value
	end
	if typeof(value) == "Vector2" then
		return UDim2.fromOffset(value.X, value.Y)
	end
	if type(value) == "number" then
		return UDim2.fromOffset(value, value)
	end
	return default
end

local function corner(parent, px)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0, px), Parent = parent })
end

local function round(parent)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = parent })
end

local function stroke(parent, color, thickness, transparency, name)
	return Util.Create("UIStroke", {
		Name = name or "UIStroke",
		Color = color,
		Thickness = thickness,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

local function frame(name, props, parent)
	local p = props or {}
	p.Name = name
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

local function floorTransparency()
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.35, 0.93),
		NumberSequenceKeypoint.new(1, MX.FloorTransparency),
	})
end

-- the dark navy fill, a breath of the neon colour mixed into the top
local function fillSequence(top, bottom)
	return ColorSequence.new(top, bottom)
end

-- Hover 1.04 / press 0.95 on a UIScale named FxScale (CloudUI's convention). onState(hover, press) repaints.
local function attachFx(button, onState, hoverScale, pressScale)
	local scale = button:FindFirstChild("FxScale")
	if not (scale and scale:IsA("UIScale")) then
		scale = Util.Create("UIScale", { Name = "FxScale", Scale = 1, Parent = button })
	end
	local st = { Hover = false, Press = false, Running = nil }
	local function refresh(seconds)
		local target = 1
		if st.Press then
			target = pressScale or 0.95
		elseif st.Hover then
			target = hoverScale or 1.04
		end
		if st.Running then
			st.Running:Cancel()
		end
		st.Running = Util.Tween(scale, seconds, { Scale = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if onState then
			onState(st.Hover, st.Press)
		end
	end
	button.MouseEnter:Connect(function()
		st.Hover = true
		refresh(0.12)
	end)
	button.MouseLeave:Connect(function()
		st.Hover = false
		st.Press = false
		refresh(0.14)
	end)
	button.MouseButton1Down:Connect(function()
		st.Press = true
		refresh(0.07)
	end)
	button.MouseButton1Up:Connect(function()
		st.Press = false
		refresh(0.12)
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			st.Hover = false
			st.Press = false
			refresh(0.12)
		end
	end)
	st.Scale = scale
	return st
end
NeonKit.AttachFx = attachFx

local function isDisabled(button)
	return button:GetAttribute("Disabled") == true or button.Active == false
end

----------------------------------------------------------------------
-- Card
----------------------------------------------------------------------
-- props: Name, Size (UDim2 | number | Vector2; default 200x120), Position, AnchorPoint, LayoutOrder, ZIndex, Parent,
--        Color (Color3 | neon / category name; default Blue), Corner (14), Stroke (3), Glow (bool; kit-b U8: default
--        false, the outer glow ring only when asked for),
--        Floor (bool; default: the card is at most 260 design px tall), Fill ({ top, bottom } Color3s; default
--        PanelTop -> PanelBottom), Sheen (bool, default true), Class ("Frame" default | "TextButton": a clickable
--        card, Text = "" and AutoButtonColor off), Transparency (the fill, default 0), Active, ClipsDescendants,
--        Skin ("Sign": the kit B block, see signCard)
-- (kit-b U9-2 + U9-5: one Sign card for the Shop / Gifts family and the Care / battle family) Skin = "Sign": the pitch's
-- card (.pc / .bk) in place of the neon one: a flat face (props.Face, default Theme.Sign.Tile), a wood edge (Stroke,
-- UIStroke "SignEdge", mitred; props.Edge, default the wood; props.Stroke px, default 3) and a darker lip along its
-- bottom (Frame "Lip", props.LipPx px, default 5: the Shop / Gifts cards' lip) in props.Lip or props.Color (default the stone
-- lip: one colour by role, a pack's / a rarity's / a skill's own colour lives there); square, no glow, gloss, floor,
-- sheen or gradient. Body sits above the lip; props.BodyOverLip = true keeps it the whole card (a layout that draws its
-- own bottom row over the lip: the Shop and the Gifts cards). The table keeps the neon card's shape so a caller only
-- adds the Skin: Stroke = the edge (a caller's focus ring recolours it), Glow = a frame that never shows (its GlowStroke
-- disabled), SetColor(c) paints the lip, SetGlow(on) = the selected look (the gold-tinted face, the ink edge),
-- SetFill(face) / SetFace(face) repaint the face
local SIGN = Theme.Sign
local SIGN_CARD_LIP = 5
local function sameSign(a, b)
	return typeof(a) == "Color3" and typeof(b) == "Color3" and math.abs(a.R - b.R) < 0.004 and math.abs(a.G - b.G) < 0.004 and math.abs(a.B - b.B) < 0.004
end
local function signCard(props)
	local class = (props.Class == "TextButton") and "TextButton" or "Frame"
	local z = props.ZIndex or 1
	local root = Instance.new(class)
	root.Name = props.Name or "SignCard"
	root.BorderSizePixel = 0
	root.BackgroundTransparency = 0
	root.Size = toUDim2(props.Size, UDim2.fromOffset(200, 120))
	root.Position = props.Position or UDim2.new()
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	root.LayoutOrder = props.LayoutOrder or 0
	root.ZIndex = z
	if props.Active ~= nil then
		root.Active = props.Active
	end
	if class == "TextButton" then
		root.Text = ""
		root.AutoButtonColor = false
		if props.Active == nil then
			root.Active = true
		end
	end
	root:SetAttribute("Skin", "Sign")
	local face = typeof(props.Face) == "Color3" and props.Face or SIGN.Tile
	local edgeColor = typeof(props.Edge) == "Color3" and props.Edge or SIGN.Wood
	local edge = stroke(root, edgeColor, tonumber(props.Stroke) or 3, 0, "SignEdge")
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	local lipPx = tonumber(props.LipPx) or SIGN_CARD_LIP
	local color = typeof(props.Lip) == "Color3" and props.Lip or colorOf(props.Color, SIGN.StoneLip)
	local lip = frame("Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, lipPx),
		ZIndex = z,
	}, root)
	local glow = frame("Glow", { Size = UDim2.fromScale(1, 1), ZIndex = z, Visible = false }, root)
	local glowStroke = stroke(glow, SIGN.Gold, 3, 1, "GlowStroke")
	glowStroke.Enabled = false
	local overLip = props.BodyOverLip == true
	local clip = props.ClipsDescendants == true
	local body = frame("Body", {
		Size = overLip and UDim2.fromScale(1, 1) or UDim2.new(1, 0, 1, -lipPx),
		ZIndex = z,
		ClipsDescendants = clip and not overLip,
	}, root)
	-- a whole-card body clips at the card (the Shop's hero card), as it always did
	root.ClipsDescendants = clip and overLip
	local card = { Root = root, Body = body, Stroke = edge, Glow = glow, GlowStroke = glowStroke, Lip = lip, Color = color, Skin = "Sign", Selected = false }
	local edgePx = tonumber(props.Stroke) or 3
	-- (Pitch 2 F0, finish pass A) the kit's finish on the card: the light on its wood edge, its face's lit top band and the
	-- card shadow; a card in the Well face (a claimed day, a locked slot) is a sunk well. props.Finish = false: none
	local function finish()
		if props.Finish == false then
			return
		end
		local now = root.BackgroundColor3
		local well = sameSign(now, SIGN.Well) or sameSign(now, SIGN.PetWell)
		SignKit.FinishBlock(root, { Out = edgePx, Wood = sameSign(edge.Color, SIGN.Wood), Well = well, FaceColor = now, EdgeColor = edge.Color })
	end
	local function paint()
		root.BackgroundColor3 = card.Selected and SIGN.Selected or face
		edge.Color = card.Selected and SIGN.Text or edgeColor
		finish()
	end
	function card.SetColor(newColor)
		card.Color = colorOf(newColor, card.Color)
		lip.BackgroundColor3 = card.Color
	end
	function card.SetGlow(on)
		card.Selected = on and true or false
		paint()
	end
	-- the face only: a caller that recolours Stroke after it (a focus ring, a state's edge) keeps its edge
	function card.SetFill(newFace)
		if typeof(newFace) == "Color3" then
			face = newFace
			root.BackgroundColor3 = card.Selected and SIGN.Selected or face
			finish()
		end
	end
	function card.SetFace(newFace)
		face = newFace or SIGN.Tile
		paint()
	end
	paint()
	root.Parent = props.Parent
	return card
end

function NeonKit.Card(props)
	props = props or {}
	if props.Skin == "Sign" then
		return signCard(props)
	end
	local color = colorOf(props.Color)
	local size = toUDim2(props.Size, UDim2.fromOffset(200, 120))
	local radius = tonumber(props.Corner) or MX.Corner
	local thickness = tonumber(props.Stroke) or MX.Stroke
	local z = props.ZIndex or 1
	local class = (props.Class == "TextButton") and "TextButton" or "Frame"

	local root = Instance.new(class)
	root.Name = props.Name or "NeonCard"
	root.BorderSizePixel = 0
	root.BackgroundColor3 = WHITE
	root.BackgroundTransparency = tonumber(props.Transparency) or 0
	root.Size = size
	root.Position = props.Position or UDim2.new()
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	root.LayoutOrder = props.LayoutOrder or 0
	root.ZIndex = z
	if props.Active ~= nil then
		root.Active = props.Active
	end
	if class == "TextButton" then
		root.Text = ""
		root.AutoButtonColor = false
		if props.Active == nil then
			root.Active = true
		end
	end
	corner(root, radius)
	-- A UIGradient also tints the TEXT of its TextButton (and a child frame would cover that text), so a clickable
	-- card carries its fill as BackgroundColor3 plus a multiplier gradient that stays white where the text sits
	-- and only darkens the bottom; a plain card carries the real two-colour gradient.
	local fill = props.Fill
	local fillTop = (type(fill) == "table" and typeof(fill[1]) == "Color3") and fill[1] or TOP
	local fillBottom = (type(fill) == "table" and typeof(fill[2]) == "Color3") and fill[2] or BOTTOM
	local textSafe = class == "TextButton"
	local fillGradient = Util.Create("UIGradient", { Name = "Fill", Rotation = 90, Parent = root })
	local function applyFill(top, bottom)
		if textSafe then
			root.BackgroundColor3 = top:Lerp(bottom, 0.3)
			fillGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
				ColorSequenceKeypoint.new(0.6, Color3.fromRGB(236, 238, 246)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(150, 154, 176)),
			})
		else
			fillGradient.Color = fillSequence(top, bottom)
		end
	end
	applyFill(fillTop, fillBottom)
	local neon = stroke(root, color, thickness, 0, "NeonStroke")

	-- the outer glow ring (behind nothing: a transparent frame with only a wide, soft stroke)
	local glow = frame("Glow", {
		Position = UDim2.fromOffset(-MX.GlowPad, -MX.GlowPad),
		Size = UDim2.new(1, 2 * MX.GlowPad, 1, 2 * MX.GlowPad),
		ZIndex = z,
		Visible = props.Glow == true,
	}, root)
	corner(glow, radius + MX.GlowPad)
	local glowStroke = stroke(glow, color, MX.GlowStroke, MX.GlowTransparency, "GlowStroke")

	-- the coloured floor: the neon colour fading up from the bottom of the card
	local wantFloor = props.Floor
	if wantFloor == nil then
		wantFloor = size.Y.Scale == 0 and size.Y.Offset > 0 and size.Y.Offset <= MX.FloorMaxHeight
	end
	local floorFrame = frame("Floor", {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		Position = UDim2.new(0, thickness, MX.FloorFrom, 0),
		Size = UDim2.new(1, -2 * thickness, 1 - MX.FloorFrom, -thickness),
		ZIndex = z,
		Visible = wantFloor == true,
	}, root)
	corner(floorFrame, math.max(2, radius - thickness))
	Util.Create("UIGradient", { Rotation = 90, Transparency = floorTransparency(), Parent = floorFrame })

	-- the sheen: a thin light line under the top edge
	local sheen = frame("Sheen", {
		BackgroundTransparency = MX.SheenTransparency,
		BackgroundColor3 = WHITE,
		Position = UDim2.new(0, radius, 0, 4),
		Size = UDim2.new(1, -2 * radius, 0, 2),
		ZIndex = z,
		Visible = props.Sheen ~= false,
	}, root)
	round(sheen)

	local body = frame("Body", {
		Size = UDim2.fromScale(1, 1),
		ZIndex = z,
		ClipsDescendants = props.ClipsDescendants == true,
	}, root)

	local card = {
		Root = root, Body = body, Stroke = neon, Glow = glow, GlowStroke = glowStroke, Floor = floorFrame,
		Sheen = sheen, FillGradient = fillGradient, Color = color,
	}
	function card.SetColor(newColor)
		local c = colorOf(newColor, card.Color)
		card.Color = c
		neon.Color = c
		glowStroke.Color = c
		floorFrame.BackgroundColor3 = c
	end
	function card.SetGlow(on)
		glow.Visible = on and true or false
	end
	function card.SetFill(top, bottom)
		applyFill(top or TOP, bottom or BOTTOM)
	end
	root.Parent = props.Parent
	return card
end

----------------------------------------------------------------------
-- Orb + Icon
----------------------------------------------------------------------
-- A glossy disc behind an icon: light top, the colour, a darker bottom; a soft highlight ellipse in the top third.
function NeonKit.Orb(parent, color, size)
	local c = colorOf(color)
	local px = tonumber(size) or 48
	local orb = frame("Orb", {
		BackgroundTransparency = 0,
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(px, px),
	}, parent)
	round(orb)
	Util.Create("UIGradient", {
		Name = "Gloss",
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.45)),
			ColorSequenceKeypoint.new(0.5, c),
			ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.3)),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.6, 0.5),
			NumberSequenceKeypoint.new(1, 0.72),
		}),
		Parent = orb,
	})
	stroke(orb, Theme.Lighten(c, 0.2), math.max(1.5, px * 0.035), 0.55, "Rim")
	local hi = frame("Highlight", {
		BackgroundTransparency = 0.75,
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.08),
		Size = UDim2.fromScale(0.58, 0.26),
	}, orb)
	round(hi)
	return orb
end

-- The image id for an icon (Config.Icons[id] = an asset id), or nil. (U7a) a value naming a PixelIcon is no image
local function iconImage(id)
	local icons = Config.Icons
	if type(icons) == "table" and type(id) == "string" then
		local value = icons[id]
		if type(value) == "string" and value ~= "" and not PixelIcon.Bitmaps[value] then
			return value
		end
	end
	return nil
end

-- (U7a) the PixelIcon an id draws as: Config.Icons[id] when it names a bitmap, else `id` itself when it is one; nil
function NeonKit.IconName(id)
	if type(id) ~= "string" then
		return nil
	end
	local icons = Config.Icons
	local value = type(icons) == "table" and icons[id] or nil
	if type(value) == "string" and PixelIcon.Bitmaps[value] then
		return value
	end
	if PixelIcon.Bitmaps[id] then
		return id
	end
	return nil
end

-- (U7a) a PixelIcon centred in a text object, following its colour, fade and ZIndex (PixelIcon.Host; px nil: 0.9 x its
-- TextSize, redrawn when that changes)
local function hostPixelIcon(host, name, px)
	return PixelIcon.Host(host, name, px)
end

-- An icon of `size` px, centred in its parent unless moved: a PixelIcon (Config.Icons[id] names it, or `id` is a PixelIcon
-- name) hosted in a TextLabel with no text, so callers that set TextColor3 / TextTransparency / ZIndex on the icon recolour,
-- fade and layer it; an ImageLabel once Config.Icons[id] holds an asset id; "Gems" (lobby-shop Task 15, spec 5.7): the same
-- empty TextLabel hosting a GemIcon of `size` px; anything else shows `id` as plain text (no emoji: kit-b U7a).
function NeonKit.Icon(parent, id, size)
	local px = tonumber(size) or 32
	local image = iconImage(id)
	local pixel = not image and NeonKit.IconName(id) or nil
	local icon
	if not image and (id == "Gems" or pixel) then
		icon = Theme.Label("", "Display", {
			Size = px,
			Props = {
				Name = "Icon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(px * 1.25, px * 1.25),
			},
		})
		if pixel then
			hostPixelIcon(icon, pixel) -- 0.9 x the TextSize, redrawn when a caller resizes the icon like a glyph
			icon:SetAttribute("PixelIcon", pixel)
		else
			local gem = GemIcon.New(icon, px)
			gem.AnchorPoint = Vector2.new(0.5, 0.5)
			gem.Position = UDim2.fromScale(0.5, 0.5)
		end
	elseif image then
		icon = Util.Create("ImageLabel", {
			Name = "Icon",
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Image = image,
			ScaleType = Enum.ScaleType.Fit,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(px * 1.1, px * 1.1),
		})
	else
		local glyph = NeonKit.Glyphs[id] or tostring(id or "")
		icon = Theme.Label(glyph, "Display", {
			Size = px,
			Stroke = 1,
			Props = {
				Name = "Icon",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(px * 1.25, px * 1.25),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		})
	end
	icon:SetAttribute("IconId", tostring(id or ""))
	icon.Parent = parent
	return icon
end

----------------------------------------------------------------------
-- Tile (image 21.png)
----------------------------------------------------------------------
-- props: Size (number, design px; default 84), Color (default "Blue"), Icon (an icon id or a glyph), Label (text),
--        Callback(tile), Badge (bool), Name, Position, AnchorPoint, LayoutOrder, ZIndex, Parent, Glow (kit-b U8: default
--        false), Skin ("Sign": the kit B tile, see signTile)
-- (kit-b U8) the pitch's HUD tile (.sb): a stone block with a wood edge and its darker lip, the PixelIcon and the label in
-- brown, no orb and no glow. SetColor("Gold") = the selected tile (gold face), "Grey" = disabled (the sunk well), any other
-- colour = stone (one colour by role). tile.Card is a stand-in with SetColor / SetGlow (no glow on this skin)
local SIGN_TILE_LIP = 6 -- (LOOK-ui) 6: on the column's 2/3 step a 4 px lip, on 1 a 6 px one (5 drew 3.33 px)
local SIGN_TILE_PRESS = 3 -- a pressed tile's lip (2 / 3 screen px on the column's steps)
local function signTile(props, s, hasLabel)
	local Sign = Theme.Sign
	local root = Instance.new("TextButton")
	root.Name = props.Name or ("Tile_" .. tostring(props.Label or props.Icon or ""))
	root.Text = ""
	root.AutoButtonColor = false
	root.Active = true
	root.BorderSizePixel = 0
	root.BackgroundTransparency = 0
	root.BackgroundColor3 = Sign.Tile
	root.Size = UDim2.fromOffset(s, s)
	root.Position = props.Position or UDim2.new()
	root.AnchorPoint = props.AnchorPoint or Vector2.new(0, 0)
	root.LayoutOrder = props.LayoutOrder or 0
	root.ZIndex = props.ZIndex or 1
	root:SetAttribute("Skin", "Sign")
	local edge = stroke(root, Sign.Wood, 3, 0, "SignEdge")
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	local lip = frame("Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Sign.StoneLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, SIGN_TILE_LIP),
		ZIndex = root.ZIndex,
	}, root)
	local body = frame("Body", { Size = UDim2.new(1, 0, 1, -SIGN_TILE_LIP), ZIndex = root.ZIndex }, root)
	local iconY = hasLabel and 0.4 or 0.5
	local iconPx = PixelIcon.Snap(s * (hasLabel and MX.TileIcon or 0.56))
	local icon = NeonKit.Icon(body, props.Icon or props.Label or "", iconPx)
	icon.Position = UDim2.fromScale(0.5, iconY)
	icon.TextColor3 = Sign.Text
	local label = nil
	if hasLabel then
		label = Theme.Label(props.Label, "Button", {
			Size = math.max(MX.TileLabelMin, math.floor(s * MX.TileLabel + 0.5)),
			Color = Sign.Text,
			Props = {
				Name = "Label",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.82, 0),
				Size = UDim2.new(1, 0, 0, math.floor(s * 0.3 + 0.5)),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
		})
		label.Parent = body
	end
	-- the attention mark: a small red square with a brown "!" (4.8:1 on the red; white read 3.3:1)
	local badgePx = math.max(22, math.floor(s * 0.28))
	local badge = frame("Badge", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Sign.Red,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(badgePx, badgePx),
		Visible = props.Badge == true,
	}, body)
	local badgeEdge = stroke(badge, Sign.Wood, 2, 0, "SignEdge")
	badgeEdge.LineJoinMode = Enum.LineJoinMode.Miter
	local mark = Theme.Label("!", "Button", {
		Size = math.max(MX.TileLabelMin, math.floor(s * 0.2 + 0.5)),
		Color = Sign.Text,
		Props = { Name = "Mark", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center },
	})
	mark.Parent = badge
	local look = "Stone"
	local card = { Root = root, Body = body, Stroke = edge, Lip = lip }
	local tile = { Root = root, Card = card, Icon = icon, Label = label, Badge = badge, Skin = "Sign", Color = colorOf(props.Color) }
	local function paint(hover, press)
		local face, lipColor = Sign.Tile, Sign.StoneLip
		if look == "Gold" then
			face, lipColor = Sign.Gold, Sign.GoldLip
		elseif look == "Grey" then
			face, lipColor = Sign.Well, Sign.WellEdge
		end
		if hover and not press and look ~= "Grey" then
			face = Theme.Lighten(face, 0.06)
		end
		root.BackgroundColor3 = face
		lip.BackgroundColor3 = lipColor
		lip.Size = UDim2.new(1, 0, 0, press and SIGN_TILE_PRESS or SIGN_TILE_LIP)
		local ink = look == "Grey" and Sign.TextMuted or Sign.Text
		icon.TextColor3 = ink
		if label then
			label.TextColor3 = ink
		end
		-- (Pitch 2 F0, finish pass A) the kit's finish: lit wood edge, lit top band, the card shadow; Grey is a sunk well
		SignKit.FinishBlock(root, { Out = 3, Well = look == "Grey", FaceColor = face, EdgeColor = Sign.WellEdge })
	end
	function card.SetColor(c)
		tile.SetColor(c)
	end
	function card.SetGlow() end
	tile.Fx = attachFx(root, function(hover, press)
		paint(hover, press)
	end, 1, 1)
	function tile.SetBadge(on)
		badge.Visible = on and true or false
	end
	function tile.SetColor(newColor)
		look = (newColor == "Gold" or newColor == "Grey") and newColor or "Stone"
		tile.Color = colorOf(newColor, tile.Color)
		paint(tile.Fx.Hover, tile.Fx.Press)
	end
	function tile.SetLabel(text)
		if label then
			label.Text = tostring(text or "")
		end
	end
	function tile.SetIcon(id)
		local pos = icon.Position
		icon:Destroy()
		icon = NeonKit.Icon(body, id, iconPx)
		icon.Position = pos
		tile.Icon = icon
		paint(tile.Fx.Hover, tile.Fx.Press)
	end
	if props.Callback then
		root.Activated:Connect(function()
			if not isDisabled(root) then
				props.Callback(tile)
			end
		end)
	end
	paint(false, false)
	root.Parent = props.Parent
	return tile
end

function NeonKit.Tile(props)
	props = props or {}
	local s = tonumber(props.Size) or 84
	if typeof(props.Size) == "UDim2" then
		s = props.Size.X.Offset
	end
	if props.Skin == "Sign" then
		return signTile(props, s, type(props.Label) == "string" and props.Label ~= "")
	end
	local color = colorOf(props.Color)
	local hasLabel = type(props.Label) == "string" and props.Label ~= ""
	local card = NeonKit.Card({
		Name = props.Name or ("Tile_" .. tostring(props.Label or props.Icon or "")),
		Class = "TextButton",
		Size = UDim2.fromOffset(s, s),
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		ZIndex = props.ZIndex,
		Color = color,
		Corner = math.max(10, math.floor(s * 0.16 + 0.5)),
		Glow = props.Glow,
		Floor = true,
	})
	local root = card.Root
	local iconY = hasLabel and 0.4 or 0.5
	local orb = NeonKit.Orb(card.Body, color, s * MX.TileOrb)
	orb.Position = UDim2.fromScale(0.5, iconY)
	local iconPx = s * (hasLabel and MX.TileIcon or 0.56)
	local icon = NeonKit.Icon(card.Body, props.Icon or props.Label or "", iconPx)
	icon.Position = UDim2.fromScale(0.5, iconY)

	local label = nil
	if hasLabel then
		label = Theme.Label(props.Label, "Button", {
			Size = math.max(MX.TileLabelMin, math.floor(s * MX.TileLabel + 0.5)),
			Props = {
				Name = "Label",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, 0, 0.83, 0),
				Size = UDim2.new(1, 12, 0, math.floor(s * 0.3 + 0.5)),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
			},
		})
		label.Parent = card.Body
	end

	local badge = frame("Badge", {
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Neon.Red,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -4, 0, 4),
		Size = UDim2.fromOffset(math.max(22, s * 0.28), math.max(22, s * 0.28)),
		Visible = props.Badge == true,
	}, card.Body)
	round(badge)
	stroke(badge, INK, 2, 0)
	local mark = Theme.Label("!", "Button", {
		Size = math.max(MX.TileLabelMin, math.floor(s * 0.2 + 0.5)),
		Props = { Name = "Mark", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center },
	})
	mark.Parent = badge

	local tile = { Root = root, Card = card, Orb = orb, Icon = icon, Label = label, Badge = badge, Color = color }
	tile.Fx = attachFx(root, function(hover, press)
		card.GlowStroke.Transparency = (hover or press) and 0.45 or MX.GlowTransparency
	end)
	function tile.SetBadge(on)
		badge.Visible = on and true or false
	end
	function tile.SetColor(newColor)
		local c = colorOf(newColor, tile.Color)
		tile.Color = c
		card.SetColor(c)
		local gloss = orb:FindFirstChild("Gloss")
		if gloss then
			gloss.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.45)),
				ColorSequenceKeypoint.new(0.5, c),
				ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.3)),
			})
		end
	end
	function tile.SetLabel(text)
		if label then
			label.Text = tostring(text or "")
		end
	end
	function tile.SetIcon(id)
		local pos = icon.Position
		icon:Destroy()
		icon = NeonKit.Icon(card.Body, id, iconPx)
		icon.Position = pos
		tile.Icon = icon
	end
	if props.Callback then
		root.Activated:Connect(function()
			if not isDisabled(root) then
				props.Callback(tile)
			end
		end)
	end
	root.Parent = props.Parent
	return tile
end

----------------------------------------------------------------------
-- Pill (currency / status)
----------------------------------------------------------------------
-- props: Text, Glyph (coin glyph or icon id, e.g. "Tokens"; default none), Color (default Blue), Size (UDim2 | number width; default 200x40),
--        Height (when Size is a number; default 40), TextSize (default 0.62 x height), Font role (default "Display"),
--        Name, Position, AnchorPoint, LayoutOrder, ZIndex, Parent, Glow (default false)
function NeonKit.Pill(props)
	props = props or {}
	local color = colorOf(props.Color)
	local h = tonumber(props.Height) or 40
	local size = props.Size
	if type(size) == "number" then
		size = UDim2.fromOffset(size, h)
	elseif typeof(size) == "UDim2" then
		h = size.Y.Offset > 0 and size.Y.Offset or h
	else
		size = UDim2.fromOffset(200, h)
	end
	local hasCoin = type(props.Glyph) == "string" and props.Glyph ~= ""
	local root = frame(props.Name or "NeonPill", {
		Size = size,
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
	})
	local coinD = math.floor(h * 1.12 + 0.5)
	local left = hasCoin and math.floor(coinD * 0.42) or 0
	local card = NeonKit.Card({
		Name = "Card",
		Position = UDim2.fromOffset(left, 0),
		Size = UDim2.new(1, -left, 1, 0),
		Color = color,
		Corner = math.floor(h / 2),
		Glow = props.Glow == true,
		Floor = true,
		Sheen = true,
		ZIndex = props.ZIndex,
		Parent = root,
	})
	local coin, glyph = nil, nil
	if hasCoin then
		coin = frame("Coin", {
			BackgroundTransparency = 0,
			BackgroundColor3 = WHITE,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 0, 0.5, 0),
			Size = UDim2.fromOffset(coinD, coinD),
			ZIndex = props.ZIndex or 1,
		}, root)
		round(coin)
		Util.Create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Theme.Lighten(color, 0.5)),
				ColorSequenceKeypoint.new(0.55, color),
				ColorSequenceKeypoint.new(1, Theme.Darken(color, 0.35)),
			}),
			Parent = coin,
		})
		stroke(coin, INK, 2.5, 0)
		local shine = frame("Shine", {
			BackgroundTransparency = 0.6,
			BackgroundColor3 = WHITE,
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.fromScale(0.5, 0.1),
			Size = UDim2.fromScale(0.56, 0.24),
		}, coin)
		round(shine)
		-- (U7a) an icon id or PixelIcon name draws its PixelIcon on the coin; other text shows as it is
		glyph = Theme.Label(NeonKit.IconName(props.Glyph) and "" or props.Glyph, "Display", {
			Size = math.floor(coinD * 0.56 + 0.5),
			Props = { Name = "Glyph", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center },
		})
		if NeonKit.IconName(props.Glyph) then
			hostPixelIcon(glyph, NeonKit.IconName(props.Glyph), coinD * 0.56)
		end
		glyph.Parent = coin
	end
	local textLeft = hasCoin and (coinD - left + 6) or math.floor(h * 0.45)
	local text = Theme.Label(tostring(props.Text or ""), props.Font or "Display", {
		Size = tonumber(props.TextSize) or math.floor(h * 0.62 + 0.5),
		Props = {
			Name = "Text",
			Position = UDim2.fromOffset(textLeft, 0),
			Size = UDim2.new(1, -(textLeft + math.floor(h * 0.35)), 1, -2),
			TextXAlignment = hasCoin and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
			TextTruncate = Enum.TextTruncate.AtEnd,
		},
	})
	text.Parent = card.Body

	local pill = { Root = root, Card = card, Coin = coin, Glyph = glyph, Text = text, Color = color }
	function pill.SetText(value)
		text.Text = tostring(value or "")
	end
	function pill.SetColor(newColor)
		local c = colorOf(newColor, pill.Color)
		pill.Color = c
		card.SetColor(c)
	end
	root.Parent = props.Parent
	return pill
end

----------------------------------------------------------------------
-- Button
----------------------------------------------------------------------
-- props: Text, Color (default Green), Variant ("Primary" default: a filled dark-colour face + glow | "Outline": the
--        navy card face with a neon border), Size (default 180x52), TextSize (default 22), Callback(button), Name,
--        Position, AnchorPoint, LayoutOrder, ZIndex, Parent
-- State: button:SetAttribute("Disabled", true) (or Active = false) greys it out and ignores clicks;
--        button:SetAttribute("Color", "Red") re-colours it.
function NeonKit.Button(props)
	props = props or {}
	local st = { Color = colorOf(props.Color, Theme.Neon.Green), Variant = (props.Variant == "Outline") and "Outline" or "Primary" }
	local size = toUDim2(props.Size, UDim2.fromOffset(180, 52))
	local h = size.Y.Scale == 0 and size.Y.Offset or 52
	local card = NeonKit.Card({
		Name = props.Name or ("NeonButton_" .. tostring(props.Text or "")),
		Class = "TextButton",
		Size = size,
		Position = props.Position,
		AnchorPoint = props.AnchorPoint,
		LayoutOrder = props.LayoutOrder,
		ZIndex = props.ZIndex,
		Color = st.Color,
		Corner = math.min(16, math.floor(h * 0.32 + 0.5)),
		Glow = st.Variant == "Primary",
		Floor = st.Variant == "Outline",
	})
	local button = card.Root
	button.Active = true
	button.Text = tostring(props.Text or "")
	button.TextTruncate = Enum.TextTruncate.AtEnd
	Theme.Style(button, "Button", { Size = props.TextSize or 22 })
	Util.Create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = button })
	local outline = button:FindFirstChild("TextOutline")
	local fx

	local function paint()
		local disabled = isDisabled(button)
		local c = disabled and Theme.Neon.Grey or st.Color
		local hot = fx and (fx.Hover or fx.Press)
		card.SetColor(c)
		card.SetGlow(st.Variant == "Primary" and not disabled)
		if st.Variant == "Primary" then
			local top = Theme.Darken(c, disabled and 0.72 or (hot and 0.42 or 0.5))
			card.SetFill(top, Theme.Darken(c, 0.82))
		else
			card.SetFill(hot and Theme.Lighten(TOP, 0.08) or TOP, BOTTOM)
		end
		button.TextColor3 = disabled and Color3.fromRGB(176, 184, 206) or WHITE
		if outline then
			outline.Transparency = disabled and 0.4 or 0
		end
	end
	fx = attachFx(button, paint)
	paint()
	button:GetAttributeChangedSignal("Disabled"):Connect(paint)
	button:GetPropertyChangedSignal("Active"):Connect(paint)
	button:GetAttributeChangedSignal("Color"):Connect(function()
		local value = button:GetAttribute("Color")
		if type(value) == "string" then
			st.Color = colorOf(value, st.Color)
			paint()
		end
	end)
	if props.Callback then
		button.Activated:Connect(function()
			if not isDisabled(button) then
				props.Callback(button)
			end
		end)
	end
	button.Parent = props.Parent
	return button
end

----------------------------------------------------------------------
-- CloseMark (slop audit 2026-11-12, win 6)
----------------------------------------------------------------------
-- The X of a close button, drawn: the U+2715 glyph showed a missing-glyph box in Roblox's fonts, so every window's close
-- button carries this instead. It clears the button's text (its own Text and the Text of every TextLabel child: the label a
-- kit puts on a button) and removes the button's UIPadding (room for that text; NeonKit.Button has one: without text the
-- mark measures the whole button), then adds Frame "CloseMark": square (a 1:1 UIAspectRatioConstraint) at opts.Scale
-- (Metrics.CloseMark, 0.6) of the button's short side, centred (AnchorPoint 0.5, 0.5), scale-sized so it follows a button
-- that is resized or moved later, Active = false (taps reach the button), drawn above the button's other children. Inside:
-- InkA / InkB (dark, Metrics.CloseInk px larger on every side) under BarA (Rotation 45) / BarB (Rotation -45), white rounded
-- bars as long as the box side and Metrics.CloseBar of it thick. No font glyph, no image, no per-bar UIStroke. A rotated
-- frame is not clipped by ClipsDescendants, so the mark sits directly on the button, never under a clipping frame of its own.
-- Calling it again returns the existing mark (after clearing the text again). The button's name, size, position, colours
-- and callbacks are untouched.
--   opts (optional) = { Color = Color3 (the bars; default white), Ink = Color3 (default PanelInk), Square = true (kit B:
--   bars with square ends), Scale = number,
--                       ZIndex = number (the mark and the ink; the white bars one above) }
-- (LOOK-ui, kitb-look1) a kit B block's pixel x redrawn at `px` (a multiple of 9): the screen's glyph size, so the X
-- shares its window's one pixel size (27 on PC, 18 on a phone where the window draws its icons at 18 / 36)
function NeonKit.CloseMarkPx(button, px)
	local mark = button and button:FindFirstChild("CloseMark")
	px = tonumber(px)
	if not (mark and mark:GetAttribute("PixelX") and px and px >= 9) then
		return
	end
	if mark:GetAttribute("Px") == px and mark:FindFirstChild("Icon") then
		return
	end
	mark:SetAttribute("Px", px)
	local half = math.floor(px / 2)
	mark.Position = UDim2.new(0.5, -half, 0.5, -half)
	mark.Size = UDim2.fromOffset(px, px)
	for _, child in ipairs(mark:GetChildren()) do
		child:Destroy()
	end
	local z = mark.ZIndex
	local icon = PixelIcon.New(mark, "x", px, mark:GetAttribute("InkColor") or INK)
	if icon then
		icon.ZIndex = z
		for _, cell in ipairs(icon:GetChildren()) do
			if cell:IsA("GuiObject") then
				cell.ZIndex = z
			end
		end
	end
end

-- (LOOK-ui, kitb-look1) one close block for the kit B windows (SignKit.Sizes.CloseMin / CloseCell): a CloseMark Square
-- block that never draws under CloseMin screen px square (counter-scaled under its window's Fit, grown about its centre
-- whenever its owner sizes it smaller) with its x in CloseCell screen px cells at every rest scale. Returns the button
function NeonKit.CloseBlock(button)
	local mark = button and button:FindFirstChild("CloseMark")
	if not (mark and mark:GetAttribute("PixelX")) then
		return button
	end
	button:SetAttribute("CloseBlock", true)
	local sizing = false
	local function grow(s)
		if sizing or s <= 0 then
			return
		end
		local side = math.min(button.Size.X.Offset, button.Size.Y.Offset)
		local need = SignKit.Sizes.CloseMin / s
		if side > 0 and side * s < SignKit.Sizes.CloseMin - 0.01 then
			sizing = true
			local more = need - side
			local a = button.AnchorPoint
			button.Size = UDim2.fromOffset(need, need)
			button.Position = button.Position + UDim2.fromOffset(-more * (0.5 - a.X), -more * (0.5 - a.Y))
			sizing = false
		end
	end
	PixelIcon.Whole(mark, function(s)
		-- the cell: the design px that draw CloseCell screen px under s (4 at 0.8, 3 at 1)
		local want = SignKit.Sizes.CloseCell
		local cell = math.max(1, math.floor(want / s + 0.5))
		while cell > 1 and PixelIcon.Px(cell, s) * s > want + 1e-6 do
			cell = cell - 1
		end
		mark:SetAttribute("Px", nil) -- redrawn at the new cell
		NeonKit.CloseMarkPx(button, 9 * cell)
		grow(s)
	end)
	button:GetPropertyChangedSignal("Size"):Connect(function()
		grow(PixelIcon.RestScale(button))
	end)
	return button
end

function NeonKit.CloseMark(button, opts)
	if not (button and button:IsA("GuiButton")) then
		return nil
	end
	opts = type(opts) == "table" and opts or {}
	if button:IsA("TextButton") then
		button.Text = ""
	end
	for _, child in ipairs(button:GetChildren()) do
		if child:IsA("TextLabel") then
			child.Text = ""
		elseif child:IsA("UIPadding") then
			child:Destroy()
		end
	end
	-- (U9-7 look) a sign block's lip sits out by the block's padding (CloudUI.SignBlock): with the padding gone it goes back
	-- flush on the bottom edge (it hung 5 px under the close and kick blocks)
	local lip = button:FindFirstChild("Lip")
	if lip and lip:IsA("GuiObject") and button:FindFirstChild("SignEdge") then
		lip.Position = UDim2.new(0, 0, 1, 0)
		lip.Size = UDim2.new(1, 0, 0, lip.Size.Y.Offset)
	end
	local existing = button:FindFirstChild("CloseMark")
	if existing then
		return existing
	end
	local z = tonumber(opts.ZIndex)
	if not z then
		z = button.ZIndex
		for _, child in ipairs(button:GetChildren()) do
			if child:IsA("GuiObject") and child.ZIndex > z then
				z = child.ZIndex
			end
		end
		z = z + 1
	end
	if opts.Square then
		-- (kit-b U9-7 look) a kit B block's X is the pitch's pixel x (PixelIcon "x", 9 x 9 square cells in the brown ink):
		-- no rotated bars, the only smooth diagonals beside the 9 x 9 icons. 27 px on a block of 36 px or more, 18 below,
		-- placed by a whole-pixel offset from the button's centre (an AnchorPoint of 0.5 put it on a half pixel)
		local short = math.min(button.Size.X.Offset, button.Size.Y.Offset)
		local px = tonumber(opts.Px) or ((short <= 0 or short >= 36) and 27 or 18)
		local mark = frame("CloseMark", {
			Active = false,
			ZIndex = z,
		})
		mark:SetAttribute("PixelX", true)
		mark:SetAttribute("InkColor", colorOf(opts.Color, INK))
		mark.Parent = button
		-- (LOOK-ui, kitb-look1: the pitch's .x block) the close block's edge in the ink, not the wood (CloudUI.Button's
		-- Outline paint keeps it through hover and press)
		if button:GetAttribute("Skin") == "Sign" then
			button:SetAttribute("Outline", true)
		end
		NeonKit.CloseMarkPx(button, px)
		return mark
	end
	local scale = tonumber(opts.Scale) or MX.CloseMark
	local mark = frame("CloseMark", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(scale, scale),
		Active = false,
		ZIndex = z,
	})
	Util.Create("UIAspectRatioConstraint", { AspectRatio = 1, Parent = mark })
	local function bar(name, rotation, color, grow, zIndex)
		local b = frame(name, {
			BackgroundTransparency = 0,
			BackgroundColor3 = color,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 2 * grow, MX.CloseBar, 2 * grow),
			Rotation = rotation,
			Active = false,
			ZIndex = zIndex,
		}, mark)
		if not opts.Square then
			round(b)
		end
		return b
	end
	local ink = colorOf(opts.Ink, INK)
	local color = colorOf(opts.Color, WHITE)
	bar("InkA", 45, ink, MX.CloseInk, z)
	bar("InkB", -45, ink, MX.CloseInk, z)
	bar("BarA", 45, color, 0, z + 1)
	bar("BarB", -45, color, 0, z + 1)
	mark.Parent = button
	return mark
end

----------------------------------------------------------------------
-- The window rule: SideRect + Dock
----------------------------------------------------------------------
local function isTouch()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewport()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

-- The window rule (contract 6.6, the prototype's side_rect). Returns screen pixels (top bar included):
--   x, y, w, h   the window's box on screen;  scale  the UIScale to put on a window designed at designW x designH;
--   mode         "Side" (landscape: docked right, <= 44% of the width, never left of 0.56 W - margin, on the bottom
--                margin below the top bar; U9-7 look: it was centred, which put a short dock's roof into the HUD's
--                currency strips at 1080p, so a dock that is not full height now sits on the bottom margin, clear of
--                the top-right corner) | "Sheet" (portrait: a bottom sheet, scale 0.8, full width minus the
--                margins, <= 56% of the height: the top 44% where the character stands stays clear)
-- prefW / prefH: the preferred window size in design px; minW / minH (optional): the smallest design size the
-- content accepts (the scale shrinks instead, down to the phone scale).
-- opts (optional, tests): { Width, Height, Touch } override the screen.
function NeonKit.SideRect(prefW, prefH, minW, minH, opts)
	opts = opts or {}
	local vp = viewport()
	local W = tonumber(opts.Width) or vp.X
	local H = tonumber(opts.Height) or vp.Y
	local touch = opts.Touch
	if touch == nil then
		touch = isTouch()
	end
	prefW = tonumber(prefW) or 640
	prefH = tonumber(prefH) or 800
	local f = Theme.ScreenFactor(H)
	local m = MX.Margin * f
	local inset = MX.Inset
	local rect
	if W >= H then
		local maxW, maxH = W * MX.SideMaxW, H - inset - 2 * m
		local scale = f
		if prefW * scale > maxW then
			if touch then
				scale = MX.MinScaleTouch
			else
				scale = math.max(MX.MinScaleDesktop, maxW / prefW)
			end
			-- (LOOK-ui, shared: name it at the merge) a scale just under 1 (the Index at 1920x1080 sat at 0.982) is 1: the
			-- window's design width gives up the last few px instead, so every pixel part draws on whole px at 1080p
			if scale >= 0.95 and scale < 1 and f >= 1 and not (minW and maxW < minW) then
				scale = 1
			end
		end
		local w = math.min(prefW, maxW / scale)
		local h = math.min(prefH, maxH / scale)
		if minW and w < minW then
			w = minW
		end
		if minH and h < minH then
			h = minH
			scale = math.min(scale, maxH / minH)
		end
		rect = {
			x = W - m - w * scale,
			y = H - m - h * scale, -- (U9-7 look) the bottom margin (a full-height dock: inset + m, as before)
			w = w * scale,
			h = h * scale,
			scale = scale,
			mode = "Side",
		}
	else
		-- the sheet (with its bottom margin) stays inside the lower 56%: its top edge is never above 0.44 H
		local scale = MX.SheetScale
		local room = H * MX.SheetMaxH - m
		local w = (W - 2 * m) / scale
		local h = math.min(prefH, room / scale)
		if minH and h < minH then
			h = minH
			scale = math.min(scale, room / minH)
			w = (W - 2 * m) / scale
		end
		rect = {
			x = m,
			y = H - m - h * scale,
			w = w * scale,
			h = h * scale,
			scale = scale,
			mode = "Sheet",
		}
	end
	rect.designW = rect.w / rect.scale
	rect.designH = rect.h / rect.scale
	rect.margin = m
	return rect
end

-- The big-window rule (store 2026-11-04): the box of a full-size window centred under the top bar, the Pets window's
-- H.rect shared with the Store. The window grows between two screen heights (RECT.H0 -> RECT.H1: W0 x Y0 -> W1 x Y1
-- px, times the readability factor above 1), never wider than the screen minus MARGIN each side nor, on a landscape
-- screen at least PC_MIN_H tall, than PC_MAX_W of the width (the menu tiles and the currency pills stay free), never
-- taller than the screen under the gui inset. A box narrower than PHONE_W or lower than SHORT design px is the Phone
-- layout at scale 1; otherwise the PC layout at the readability factor.
--   K    = { RECT = { H0, W0, Y0, H1, W1, Y1 }, MARGIN, PHONE_W, SHORT, PC_MIN_H, PC_MAX_W }   the caller's numbers
--   opts (optional, tests) = { Width, Height, Inset }   override the viewport and GuiService:GetGuiInset().Y
--   -> { x, y, w, h (screen px), scale, mode = "PC" | "Phone", portrait }
function NeonKit.BigRect(K, opts)
	opts = opts or {}
	local vp = viewport()
	local w = tonumber(opts.Width) or vp.X
	local h = tonumber(opts.Height) or vp.Y
	local inset = tonumber(opts.Inset)
	if inset == nil then
		inset = 58
		pcall(function()
			inset = GuiService:GetGuiInset().Y
		end)
	end
	local R = K.RECT
	local t = math.max(0, math.min(1, (h - R.H0) / (R.H1 - R.H0)))
	local factor = Theme.ScreenFactor(h)
	local big = math.max(1, factor)
	local pxW = math.min((R.W0 + (R.W1 - R.W0) * t) * big, w - 2 * K.MARGIN)
	if w > h and h >= K.PC_MIN_H then
		pxW = math.min(pxW, w * K.PC_MAX_W)
	end
	local pxH = math.min((R.Y0 + (R.Y1 - R.Y0) * t) * big, h - inset - 2)
	local phone = pxW / factor < K.PHONE_W or pxH / factor < K.SHORT
	local scale = phone and 1 or factor
	return {
		x = math.floor((w - pxW) / 2 + 0.5),
		y = math.floor(inset + (h - inset - pxH) / 2 + 0.5),
		w = pxW,
		h = pxH,
		scale = scale,
		mode = phone and "Phone" or "PC",
		portrait = pxH > pxW,
	}
end

local DOCKS = setmetatable({}, { __mode = "k" }) -- (U9-7 look) [holder] = true for every docked window (NeonKit.OpenDocks)

local function guiInsetOf(holder)
	local gui = holder and holder:FindFirstAncestorOfClass("ScreenGui")
	if gui and gui.IgnoreGuiInset then
		return 0
	end
	local inset = MX.Inset
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- The optional client/MouseLock module (nil on the server or when missing): a docked window frees the cursor
local mouseLock = nil
local mouseLockWatched = setmetatable({}, { __mode = "k" }) -- [holder] = true (one watcher per holder)
local function getMouseLock()
	if mouseLock == nil then
		mouseLock = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("MouseLock")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.WatchVisible) == "function" then
				mouseLock = mod
			end
		end
	end
	return mouseLock or nil
end

-- Docks `holder` (a window root designed in px, AnchorPoint set to 0,0) by the window rule and keeps it docked when
-- the screen changes size. While the holder is shown (Visible in an Enabled ScreenGui) it is a MouseLock hold: the
-- cursor is free; hiding / removing / destroying the holder releases it (independent of Disconnect). `uiScale` (optional) is the UIScale to drive; without one a UIScale "DockScale" is added
-- (or reused) on the holder. Returns { Rect, Refresh(), Disconnect() }; Rect is the last SideRect.
-- The holder's Position is in ITS gui's area: a ScreenGui with IgnoreGuiInset = false starts below the top bar.
function NeonKit.Dock(holder, uiScale, prefW, prefH, minW, minH)
	local dock = { Rect = nil }
	if not holder then
		return dock
	end
	DOCKS[holder] = true
	if not (uiScale and uiScale:IsA("UIScale")) then
		uiScale = holder:FindFirstChild("DockScale")
		if not (uiScale and uiScale:IsA("UIScale")) then
			uiScale = Util.Create("UIScale", { Name = "DockScale", Scale = 1, Parent = holder })
		end
	end
	local conns = {}
	function dock.Refresh()
		if not holder.Parent then
			return
		end
		local r = NeonKit.SideRect(prefW, prefH, minW, minH)
		dock.Rect = r
		holder.AnchorPoint = Vector2.new(0, 0)
		holder.Position = UDim2.fromOffset(math.floor(r.x + 0.5), math.floor(r.y - guiInsetOf(holder) + 0.5))
		holder.Size = UDim2.fromOffset(math.floor(r.designW + 0.5), math.floor(r.designH + 0.5))
		uiScale.Scale = r.scale
		holder:SetAttribute("DockMode", r.mode)
		holder:SetAttribute("DockLeft", math.floor(r.x + 0.5))
	end
	local function bindCamera()
		if conns.Camera then
			conns.Camera:Disconnect()
			conns.Camera = nil
		end
		local camera = workspace.CurrentCamera
		if camera then
			conns.Camera = camera:GetPropertyChangedSignal("ViewportSize"):Connect(dock.Refresh)
		end
		dock.Refresh()
	end
	conns.Watch = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	conns.Gone = holder.Destroying:Connect(function()
		dock.Disconnect()
	end)
	function dock.Disconnect()
		for _, key in ipairs({ "Camera", "Watch", "Gone" }) do
			if conns[key] then
				conns[key]:Disconnect()
				conns[key] = nil
			end
		end
	end
	bindCamera()
	local ml = getMouseLock()
	if ml and not mouseLockWatched[holder] then
		mouseLockWatched[holder] = true
		pcall(ml.WatchVisible, "Dock:" .. holder.Name, holder)
	end
	return dock
end

-- (U9-7 look) the boxes of the docked windows on screen now (screen px, the top bar included: { x0, y0, x1, y1, mode }),
-- for the HUD parts that must keep clear of them (HudController's vitals card). A holder counts while it and every
-- ancestor is Visible in an Enabled ScreenGui.
function NeonKit.OpenDocks()
	local out = {}
	for holder in pairs(DOCKS) do
		local shown = holder.Parent ~= nil
		local cur = holder
		while shown and cur and not cur:IsA("LayerCollector") do
			if cur:IsA("GuiObject") and not cur.Visible then
				shown = false
			end
			cur = cur.Parent
		end
		if shown and cur and cur:IsA("ScreenGui") and cur.Enabled and holder.AbsoluteSize.X > 4 then
			local dy = cur.IgnoreGuiInset and 0 or guiInsetOf(holder)
			local p, s = holder.AbsolutePosition, holder.AbsoluteSize
			out[#out + 1] = { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy, mode = holder:GetAttribute("DockMode") }
		end
	end
	return out
end

-- The local player's PlayerGui (nil on the server); a convenience for window owners.
function NeonKit.PlayerGui()
	local player = Players.LocalPlayer
	return player and player:FindFirstChildOfClass("PlayerGui") or nil
end

return NeonKit
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1193">
            <Properties>
              <string name="Name">PetBits</string>
              <string name="Source"><![CDATA[-- PetBits (client UI): what the windows that show pets share about one pet copy (key = shared/PetKeys: Normal, Golden,
-- Rainbow, fused hybrids), split out of MenuController for the Pets window (team balance, Task 4). Reads State only.
--
--   Data:    parseKey, defOfKey, tierOf, isHybrid, tierMultiplier, displayName, elementsOf, rarityOrder, ownedKeys, petLevel,
--            xpToNext, levelCap, statsAt, battleStatsAt (the garden's numbers with Power / Health from the battle path, so one
--            window never shows two answers), battlePower (BattleCatalog.UnitPower of the copy, or nil), battleEntry (the entry
--            BattleCatalog reads), homeData, catalogCall (TycoonCatalog), slotsHolding, gardenCopies, isGardening,
--            firstFreeSlot, growth, stage, job, jobLeft, skillName, canEvolve, coinsPerSecond, formatCash, formatRate,
--            busyOf (nil | "Training" | "Garden": State.Busy, or the same answer from the home / the job on an old snapshot)
--   UI:      frame, text, corner, round, stroke, pad (the windows' Theme-styled building blocks)
--   PetBits.askRecall(gui, key, target, onYes, onNo, send): "<Pet name> is gardening! ("This pet ..." when the name does
--            not fit) Take it out of the garden and put it in your team?" [Yes] [No]. Yes = ONE request
--            (send("GardenRecall", { Key, To, Preset, Keys }), the server checks everything and takes it out + stores the
--            team); No = nothing. PetBits.closeRecall() -> true when one was up.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local UI = script.Parent
local Client = UI.Parent
local CloudUI = require(UI:WaitForChild("CloudUI"))
local State = require(Client:WaitForChild("State"))

local PetBits = {}

local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local CASH = (Theme.Currency and Theme.Currency.Cash and Theme.Currency.Cash.Glyph) or "$"
local GARDEN_COLOR = Color3.fromRGB(120, 196, 90)

-- The catalogs are written by other engineers: a broken one must not take the windows down.
local function optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		local ok, found = pcall(function()
			return Shared:WaitForChild(name, 3)
		end)
		module = ok and found or nil
	end
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[PetBits] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetCatalog = optionalShared("PetCatalog") or { Pets = {}, Get = function() return nil end }
local PetKeys = optionalShared("PetKeys")
local TycoonCatalog = optionalShared("TycoonCatalog")

----------------------------------------------------------------------
-- UI building blocks
----------------------------------------------------------------------
function PetBits.frame(parent, name, props)
	local p = { Name = name }
	for key, value in pairs(props or {}) do
		p[key] = value
	end
	if p.BackgroundTransparency == nil then
		p.BackgroundTransparency = 1
	end
	p.BorderSizePixel = 0
	p.Parent = parent
	return Util.Create("Frame", p)
end

-- Theme-styled TextLabel (stroke + glyph outline, readable on any panel) with optional property overrides.
function PetBits.text(parent, name, text, role, size, color, props)
	local p = { Name = name }
	for key, value in pairs(props or {}) do
		p[key] = value
	end
	local label = Theme.Label(tostring(text), role, {
		Size = size,
		Color = color or WHITE,
		Props = p,
	})
	label.Parent = parent
	return label
end

function PetBits.corner(parent, radius)
	return Theme.Corner(parent, UDim.new(0, radius or 12))
end

function PetBits.round(parent)
	return Theme.Corner(parent, UDim.new(0.5, 0))
end

function PetBits.stroke(parent, color, thickness, transparency)
	return Theme.Stroke(parent, color or NAVY, thickness or 3, transparency or 0)
end

function PetBits.pad(parent, left, top, right, bottom)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, left or 0),
		PaddingTop = UDim.new(0, top or 0),
		PaddingRight = UDim.new(0, right or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		Parent = parent,
	})
end

----------------------------------------------------------------------
-- One pet copy
----------------------------------------------------------------------
function PetBits.parseKey(key)
	if type(key) ~= "string" then
		return nil
	end
	if PetKeys and type(PetKeys.Parse) == "function" then
		local ok, parsed = pcall(PetKeys.Parse, key)
		if ok and type(parsed) == "table" then
			return parsed
		end
	end
	local base, tier = key:match("^(.-)@(%a+)$")
	base = base or key
	tier = tier or "Normal"
	if base:sub(1, 4) == "hyb:" then
		return { Key = key, HybridId = base:sub(5), Tier = tier }
	end
	return { Key = key, PetId = base, Tier = tier }
end

-- The definition of a pet copy: the catalog def (Normal), a tier def (Look.Finish), a merged hybrid def, or nil.
function PetBits.defOfKey(key)
	if type(key) ~= "string" then
		return nil
	end
	if type(State.DefOf) == "function" then
		local ok, def = pcall(State.DefOf, key)
		if ok and type(def) == "table" then
			return def
		end
	end
	return PetCatalog.Get(key)
end

function PetBits.tierOf(key, def)
	local t = type(def) == "table" and def.Tier or nil
	if t == "Golden" or t == "Rainbow" then
		return t
	end
	local parsed = PetBits.parseKey(key)
	if parsed and (parsed.Tier == "Golden" or parsed.Tier == "Rainbow") then
		return parsed.Tier
	end
	return "Normal"
end

function PetBits.isHybrid(key, def)
	if type(def) == "table" and def.IsHybrid == true then
		return true
	end
	return type(key) == "string" and key:sub(1, 4) == "hyb:"
end

-- x1 / x1.5 / x2.5 (perks and stats of tier copies; hybrids carry their own)
function PetBits.tierMultiplier(key, def)
	if type(def) == "table" and type(def.StatMultiplier) == "number" and def.StatMultiplier > 0 then
		return def.StatMultiplier
	end
	local tier = PetBits.tierOf(key, def)
	if tier == "Rainbow" then
		return 2.5
	elseif tier == "Golden" then
		return 1.5
	end
	return 1
end

function PetBits.displayName(key, def)
	def = def or PetBits.defOfKey(key)
	if type(def) ~= "table" then
		return tostring(key)
	end
	return tostring(def.DisplayName or def.Name or key)
end

-- the elements of a def that Config.Elements knows, in order, once each
function PetBits.elementsOf(def)
	local info = Config.Elements and Config.Elements.Info
	if type(def) ~= "table" or type(info) ~= "table" then
		return {}
	end
	local raw = nil
	if type(PetCatalog.ElementsOf) == "function" then
		local ok, result = pcall(PetCatalog.ElementsOf, def)
		if ok then
			raw = result
		end
	end
	if raw == nil and type(PetCatalog.GetElements) == "function" then
		local ok, result = pcall(PetCatalog.GetElements, def.Id)
		if ok then
			raw = result
		end
	end
	if raw == nil then
		raw = def.Elements or def.Element
	end
	if type(raw) == "string" then
		raw = { raw }
	end
	local out, seen = {}, {}
	if type(raw) == "table" then
		for _, e in ipairs(raw) do
			if type(e) == "string" and info[e] and not seen[e] then
				seen[e] = true
				table.insert(out, e)
			end
		end
	end
	return out
end

function PetBits.rarityOrder(rarityId)
	for _, r in ipairs(Config.Rarities) do
		if r.Id == rarityId then
			return r.Order
		end
	end
	return 1
end

-- Owned pet copies: rarest first; inside a rarity the hybrids, then the catalog pets (reverse catalog order, a pet's
-- Rainbow / Golden copies right before its Normal ones).
function PetBits.ownedKeys()
	local keys = nil
	if type(State.Keys) == "function" then
		local ok, list = pcall(State.Keys)
		if ok and type(list) == "table" then
			keys = list
		end
	end
	if not keys then
		keys = {}
		for _, def in ipairs(PetCatalog.Pets or {}) do
			keys[#keys + 1] = def.Id
		end
	end
	local info, out = {}, {}
	for i, key in ipairs(keys) do
		if type(key) == "string" and not info[key] and State.OwnedCount(key) > 0 then
			local def = PetBits.defOfKey(key)
			if def then
				info[key] = { Order = PetBits.rarityOrder(def.Rarity), Hybrid = PetBits.isHybrid(key, def) and 1 or 0, Index = i }
				out[#out + 1] = key
			end
		end
	end
	table.sort(out, function(a, b)
		local x, y = info[a], info[b]
		if x.Order ~= y.Order then
			return x.Order > y.Order
		end
		if x.Hybrid ~= y.Hybrid then
			return x.Hybrid > y.Hybrid
		end
		return x.Index > y.Index
	end)
	return out
end

-- level, xp of a pet copy
function PetBits.petLevel(key)
	if type(State.PetLevel) == "function" then
		local ok, level, xp = pcall(State.PetLevel, key)
		if ok and type(level) == "number" then
			return math.max(1, math.floor(level)), tonumber(xp) or 0
		end
	end
	return 1, 0
end

-- XP from `level` to the next one (math.huge at the top of the curve)
function PetBits.xpToNext(level)
	if TycoonCatalog and type(TycoonCatalog.XpToNext) == "function" then
		local ok, n = pcall(TycoonCatalog.XpToNext, level)
		if ok and type(n) == "number" and n > 0 then
			return n
		end
	end
	return math.huge
end

function PetBits.levelCap(key, def)
	if type(PetCatalog.LevelCap) == "function" then
		local ok, cap = pcall(PetCatalog.LevelCap, def or key)
		if ok and type(cap) == "number" and cap >= 1 then
			return math.floor(cap)
		end
	end
	return (TycoonCatalog and tonumber(TycoonCatalog.MaxPetLevel)) or 50
end

-- the pet's stats at its level (rarity scale x level factor x tier), or nil without a catalog that knows stats
function PetBits.statsAt(def, level)
	if type(def) ~= "table" then
		return nil
	end
	if type(PetCatalog.StatsOf) == "function" then
		local ok, stats = pcall(PetCatalog.StatsOf, def, level)
		if ok and type(stats) == "table" then
			return stats
		end
	end
	if type(PetCatalog.GetStats) == "function" and type(def.Id) == "string" then
		local ok, stats = pcall(PetCatalog.GetStats, def.Id, level)
		if ok and type(stats) == "table" then
			return stats
		end
	end
	return nil
end

function PetBits.homeData()
	if type(State.Home) == "function" then
		local ok, home = pcall(State.Home)
		if ok and type(home) == "table" then
			return home
		end
	end
	return { Level = 0, Prestige = 0, Stations = {}, Garden = {}, Gym = {}, CollectorCash = 0 }
end

function PetBits.catalogCall(fnName, ...)
	if not TycoonCatalog or type(TycoonCatalog[fnName]) ~= "function" then
		return nil
	end
	local ok, a, b = pcall(TycoonCatalog[fnName], ...)
	if ok then
		return a, b
	end
	return nil
end

-- slots of `map` ({[slot] = key}) that hold `key`, ascending
function PetBits.slotsHolding(map, key)
	local out = {}
	if type(map) == "table" then
		for slot, k in pairs(map) do
			if k == key and type(slot) == "number" then
				out[#out + 1] = slot
			end
		end
	end
	table.sort(out)
	return out
end

-- bug batch 2 #18: copies of a key working in the Garden, and whether it has NO copy free of it (busy gardening).
-- Only OPEN places count (DataService P3.placedCopies): a copy resting on a place a Prestige closed earns nothing and
-- is free to follow / fight (the server takes it off that bed silently).
function PetBits.gardenCopies(key)
	local home = PetBits.homeData()
	local open = PetBits.catalogCall("GardenSlots", home) or 0
	local n = 0
	for _, slot in ipairs(PetBits.slotsHolding(home.Garden, key)) do
		if open < 1 or slot <= open then
			n = n + 1
		end
	end
	return n
end

function PetBits.isGardening(key)
	local garden = PetBits.gardenCopies(key)
	return garden > 0 and State.OwnedCount(key) - garden < 1
end

function PetBits.firstFreeSlot(map, count)
	for slot = 1, count do
		if type(map) ~= "table" or map[slot] == nil then
			return slot
		end
	end
	return nil
end

-- one pet's growth { Evo, Speed, Physique, Ability, Defense, Job | nil } (State.PetGrowth; zeros when absent)
function PetBits.growth(key)
	if type(State.PetGrowth) == "function" then
		local ok, g = pcall(State.PetGrowth, key)
		if ok and type(g) == "table" then
			return g
		end
	end
	return { Evo = 0 }
end

-- Phase 5 (3.7): the stored stage the way every site draws it (State.PetStage: EvolutionStage of the stored Evo)
function PetBits.stage(key)
	if type(State.PetStage) == "function" then
		local ok, stage = pcall(State.PetStage, key)
		if ok and type(stage) == "number" then
			return math.max(0, math.floor(stage))
		end
	end
	return math.max(0, math.floor(tonumber(PetBits.growth(key).Evo) or 0))
end

-- the running training job of a key or nil
function PetBits.job(key)
	local job = PetBits.growth(key).Job
	return type(job) == "table" and job or nil
end

-- seconds left on a job ("2:10")
function PetBits.jobLeft(job)
	local now = os.time()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	if ok and type(t) == "number" then
		now = t
	end
	local left = math.max(0, math.ceil((tonumber(job and job.Ends) or 0) - now))
	return string.format("%d:%02d", math.floor(left / 60), left % 60)
end

-- "Attack Speed" for "Speed"
function PetBits.skillName(stat)
	if stat == "Speed" then
		return "Attack Speed"
	end
	return tostring(stat or "")
end

-- the next evolution stage when the pet can EVOLVE now (PetCatalog.CanEvolve), else nil
function PetBits.canEvolve(key, def, level)
	if type(PetCatalog.CanEvolve) ~= "function" then
		return nil
	end
	local ok, nextStage = pcall(PetCatalog.CanEvolve, def or key, level, PetBits.stage(key))
	if ok and type(nextStage) == "number" and nextStage >= 1 then
		return nextStage
	end
	return nil
end

-- coins per second of a pet in this home's Garden (PetPower x food x stars / meal x the Lucky EV; the grass food
-- before the Garden is built)
function PetBits.coinsPerSecond(key, def, home)
	if not TycoonCatalog then
		return 0
	end
	local level = PetBits.petLevel(key)
	local power = PetBits.catalogCall("PetPower", { Def = def, Level = level, Stage = PetBits.stage(key), Key = key }) or 0
	local coins = TycoonCatalog.Coins or {}
	local food = PetBits.catalogCall("FoodOf", home) or 0
	if food <= 0 then
		food = tonumber(coins.GrassFood) or 12
	end
	local mult = PetBits.catalogCall("PrestigeMultiplier", math.floor(tonumber(home.Prestige) or 0)) or 1
	local lucky = PetBits.catalogCall("LuckyEV", home) or 1
	return power * food * mult * lucky / (tonumber(coins.MealSeconds) or 8)
end

-- "$950", "$12.5K" (TycoonCatalog.FormatCash, the same text as the pad signs)
function PetBits.formatCash(n)
	if TycoonCatalog and type(TycoonCatalog.FormatCash) == "function" then
		local ok, text = pcall(TycoonCatalog.FormatCash, n)
		if ok and type(text) == "string" then
			return text
		end
	end
	return CASH .. Theme.Short(tonumber(n) or 0)
end

-- cash per second: one decimal below 100 ("$7.5"), FormatCash above
function PetBits.formatRate(n)
	n = tonumber(n) or 0
	if n ~= n or n < 0 then
		n = 0
	end
	if n < 100 then
		local text = string.format("%.1f", math.floor(n * 10 + 0.5) / 10)
		text = text:gsub("%.0$", "")
		return CASH .. text
	end
	return PetBits.formatCash(n)
end

-- nil | "Training" | "Garden": such a pet keeps its team slot but neither follows nor fights (team balance, spec s.1)
function PetBits.busyOf(key)
	if type(State.Busy) == "function" then
		local ok, why = pcall(State.Busy, key)
		if ok and why then
			return why
		end
	end
	if PetBits.job(key) then
		return "Training"
	end
	if PetBits.isGardening(key) then
		return "Garden"
	end
	return nil
end

----------------------------------------------------------------------
-- Battle numbers
----------------------------------------------------------------------
function PetBits.battleCatalog()
	if PetBits.Battle == nil then
		PetBits.Battle = false
		local module = Shared:FindFirstChild("BattleCatalog")
		local ok, mod = pcall(function()
			return module and require(module)
		end)
		if ok and type(mod) == "table" and type(mod.UnitPower) == "function" then
			PetBits.Battle = mod
		end
	end
	return PetBits.Battle or nil
end

-- the detail's numbers: the garden's (statsAt) with Power and Health from the battle path (BattleCatalog.BattleStatsOf, the
-- copy's tier and stored stage), so one window never shows two answers; nil like statsAt
function PetBits.battleStatsAt(def, key, level)
	local stats = PetBits.statsAt(def, level)
	local battle = PetBits.battleCatalog()
	if type(stats) == "table" and battle and type(battle.BattleStatsOf) == "function" then
		local ok, numbers = pcall(battle.BattleStatsOf, def, level, PetBits.tierOf(key, def), PetBits.stage(key))
		if ok and type(numbers) == "table" then
			stats.Power, stats.Health = numbers.Power, numbers.Health
		end
	end
	return stats
end

-- the entry BattleCatalog.UnitPower / TeamPower read for a pet copy
function PetBits.battleEntry(key, def, level)
	local growth = PetBits.growth(key)
	local train = { Speed = growth.Speed, Physique = growth.Physique, Ability = growth.Ability, Defense = growth.Defense }
	return { Def = def, Key = key, Level = level, Tier = PetBits.tierOf(key, def), Evo = PetBits.stage(key), Train = train }
end

-- Phase 5 (m17): BattleCatalog.UnitPower of a pet copy (a Support pet with its Support role multipliers), or nil
function PetBits.battlePower(key, def, level)
	local battle = PetBits.battleCatalog()
	if not battle then
		return nil
	end
	local ok, power = pcall(battle.UnitPower, PetBits.battleEntry(key, def, level))
	if ok and type(power) == "number" then
		return math.floor(power + 0.5)
	end
	return nil
end

----------------------------------------------------------------------
-- The garden recall question
----------------------------------------------------------------------
function PetBits.closeRecall()
	local dialog = PetBits.RecallDialog
	if not dialog then
		return false
	end
	PetBits.RecallDialog = nil
	dialog:Destroy()
	return true
end

-- target = { To = "Team", Preset = n, Keys = {...} }; onYes (optional) runs after the request was sent, onNo when the
-- answer was No (Esc / gamepad B answer through closeRecall and keep what was armed)
function PetBits.askRecall(gui, key, target, onYes, onNo, send)
	PetBits.closeRecall()
	-- (kit-b gate U9 round 3: it was the old rounded gradient box with a neon green ring and the old buttons) the kit B
	-- question, as the Care confirm: the navy shade, a stone notice in a mitred wood edge with its stone lip and nails, the
	-- plain Section title, ink text, Yes the one green Sign plank and No a stone one
	local SIGN = Theme.Sign
	local overlay = PetBits.frame(gui, "GardenRecall", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 0.55,
		BackgroundColor3 = SIGN.NavyLip,
		Active = true,
		ZIndex = 60,
	})
	PetBits.RecallDialog = overlay
	local box = PetBits.frame(overlay, "Box", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0.92, 0, 0, 218), -- phone: 92 % of the width, capped at 420 px
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Stone,
		ZIndex = 61,
	})
	Util.Create("UISizeConstraint", { MaxSize = Vector2.new(420, 218), Parent = box })
	CloudUI.SignBlock(box, "Stone", { Face = SIGN.Stone, EdgePx = 6, LipPx = 8 })
	local SignKit = require(Shared:WaitForChild("SignKit"))
	SignKit.Nails(box, { Inset = 5, ZIndex = 63 })
	-- (playtest 2026-11-28 C58) the question names the pet ('Aurora Fox is gardening!'); the old words when it cannot fit
	local generic = "This pet is gardening!"
	local okName, petName = pcall(function()
		return PetBits.displayName(key, PetBits.defOfKey(key))
	end)
	local named = (okName and type(petName) == "string" and petName ~= "") and (petName .. " is gardening!") or generic
	local title = Theme.StyleTitle(PetBits.text(box, "Title", named, "Title", 28, SIGN.Text, { -- (kit-b U7b: no seedling emoji)
		Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 36), ZIndex = 62,
	}), "Section") -- (kit-b prep) a dialog's title: the ribbon is for window titles only
	-- (kit-b gate U9 r4: "THIS PET IS GARDENING!" at 28 px ran past its box on a 390 px phone) the title steps down 2 px at
	-- a time until it fits its box (never under 18 px), now and when the box is laid out again
	local function fitTitle()
		local scale = SignKit.LayoutScale(title)
		local room = title.AbsoluteSize.X / math.max(scale, 0.01)
		if room <= 0 then
			return
		end
		local size = 28
		while size > 18 do
			-- (Theme.Measure runs short of the drawn face, as the side hint's: a 12 % spare)
			local ok, m = pcall(Theme.MeasureLabel, title, title.Text, size)
			if not ok or typeof(m) ~= "Vector2" or m.X * 1.12 <= room then
				break
			end
			size = size - 2
		end
		title.TextSize = size
		-- (playtest 2026-11-28 C58) a pet's name too long for the box at 18 px: the old words
		if size <= 18 and title.Text ~= Theme.Caps(generic) and title.Text ~= generic then
			local ok, m = pcall(Theme.MeasureLabel, title, title.Text, 18)
			if ok and typeof(m) == "Vector2" and m.X * 1.12 > room then
				title.Text = (title.Text == title.Text:upper()) and Theme.Caps(generic) or generic -- (the Section style's capitals kept)
				fitTitle()
			end
		end
	end
	fitTitle()
	title:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTitle)
	PetBits.text(box, "Body", "Take it out of the garden and put it in your team?", "Body", 20, SIGN.Text, {
		Position = UDim2.fromOffset(16, 56), Size = UDim2.new(1, -32, 0, 60), TextWrapped = true, ZIndex = 62,
	})
	local buttons = PetBits.frame(box, "Buttons", {
		AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -22), Size = UDim2.new(1, -32, 0, 56), ZIndex = 62,
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, 14),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = buttons,
	})
	CloudUI.Button({
		Name = "RecallYes", Text = "Yes", Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(150, 56), TextSize = 24, LayoutOrder = 1, ZIndex = 63,
		Callback = function()
			PetBits.closeRecall()
			local arg = { Key = key, To = target.To, Preset = target.Preset, Keys = target.Keys }
			if send("GardenRecall", arg) and onYes then
				onYes()
			end
		end,
		Parent = buttons,
	})
	CloudUI.Button({
		Name = "RecallNo", Text = "No", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(150, 56), TextSize = 24, LayoutOrder = 2, ZIndex = 63,
		Callback = function()
			PetBits.closeRecall()
			if onNo then
				onNo()
			end
		end,
		Parent = buttons,
	})
end

return PetBits
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1194">
            <Properties>
              <string name="Name">PetCard</string>
              <string name="Source"><![CDATA[-- PetCard (client UI): the small floating card above a pet (ARCHITECTURE_V3.md "Phase 4 build contract" 3.9).
-- One shared builder for every pet card of the game: PetController (followers), BattleController (battle units)
-- and HomeFx (garden / training pets at home) all draw their cards with it.
--
--   local card = PetCard.New(adornee, mode, heightStuds[, opts]) -> card
--       adornee      the BasePart the card floats over (a pet model's PrimaryPart); may be nil (set it later)
--       mode         one of PetCard.Modes (below); unknown -> "Follower"
--       heightStuds  studs above the adornee's centre (default 2.2), e.g. half the pet's height + 0.6
--       opts         optional { Parent = Instance (default: the local PlayerGui, so the EVOLVE pill can be tapped;
--                    without one the adornee), OnEvolve = function() (tap on the EVOLVE! pill), Name = string }
--   card:SetLevel(level, stage, ready)   "Lv 12", a gold star per evolution stage (0 / 1 / 2: none, a star, two
--                                        stars), ready = true shows the pulsing gold "EVOLVE!" pill (an Active button)
--   card:SetXp(frac)                     XP bar fill 0..1 (blue)
--   card:SetHp(frac)                     HP bar fill 0..1 (green on own / ally pets, red on enemies)
--   card:SetSpecial(frac, ready)         SPECIAL bar fill 0..1 (gold; brighter when ready)
--   card:SetTimer(frac, text)            training timer bar (purple) + its text, e.g. (0.4, "2:10")
--   card:SetLives(n, max)                Phase 5 (battle fighters): `max` small pips right of the level, `n` of them
--                                        lit (red hearts' colour), the rest dark; SetLives(nil) hides them
--   card:SetMode(mode)                   switches the rows / distance of the card (same instance, laid out again)
--   card:Destroy()                       removes the card (safe to call twice)
--   Extras (general helpers for the callers):
--   card:SetAdornee(adornee, heightStuds)  follow another part (a rebuilt model) without a new card
--   card:SetShown(shown)                 hide / show the card (BillboardGui.Enabled), e.g. while the owner battles
--   card:SetOnEvolve(fn)                 the EVOLVE! pill's tap handler
--   card.Gui                             the BillboardGui (named "PetCard" unless opts.Name)
--   PetCard.Count()                      cards alive right now (debug / tests)
--   PetCard.Modes                        the mode table below (read-only)
--
-- Modes (rows top to bottom; MaxDistance in studs). (Pitch 2 item 04 B) the Xp / Special flags still say which fractions
-- a mode feeds; only HP and the timer draw a row under the chip:
--   "Follower"  own follower:           the chip                           25 (2026-11-13 owner, was 15; first 90: the
--                                                                          card shows only with the camera close)
--   "Garden"    own garden pet at home: the chip                           90
--   "Training"  own training pet:       the chip + the purple timer "2:10" 90
--   "Unit"      own unit in a battle:   the chip + HP                      140 (BattleController's BAR_DISTANCE)
--   "Ally"      a teammate's unit:      the chip + HP (green)              140
--   "Enemy"     enemy / NPC unit:       the chip + HP (red)                140
--   "Other"     other players' pets:    the chip                           60
--
-- Looks (World text rule): a pixel-sized BillboardGui (offset UDim2, never studs-scaled text), LightInfluence 0.
-- (Pitch 2 item 04_world_ui, the owner's pick B "Stone tags"; owner shots 07 and 05: the navy plaque with a thin bar, its
-- stars plaque on top where the pet's body covered it) the tag is a compact wood chip (Plate: the Wood face, a 2 px
-- WoodDark edge, a 3 px lip, the lit top line), 30 px tall at 1080p and as wide as its row: the gold pixel stars INSIDE it
-- (StarBadge, no plaque of its own, left of the level so they never cover it), then "Lv 12" at 22 px in stone with a
-- dark wood stroke, then the lives pips. Under the chip ONE block row: HP (9 px, 8 blocks) in the modes that have it (the
-- training timer in Training); SPECIAL and XP keep their fractions (SetSpecial / SetXp) but show on the HUD helper cards,
-- not over the pet. The row is max(chip, 96) px wide with the chip centred over it. Every size is scaled with the
-- screen-height factor (Theme.ScaledSize, text never under 14 px). The EVOLVE! pill (20 px, gold) sits above the chip and
-- pulses with a reversing tween (the engine animates it; no Lua per frame).
-- Cost: nothing runs per frame. A bar fill is written only when it moved by more than 0.004 (BattleController's
-- rule); a text only when it changed. Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the evolution stars
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b gate U9 round 3) the bars are the kit's block rows
local CloudUI = require(script.Parent:WaitForChild("CloudUI")) -- ... and the plate, the badge and EVOLVE! kit B blocks
local Sign = Theme.Sign

local PetCard = {}
PetCard.__index = PetCard

PetCard.Modes = {
	Follower = { MaxDistance = 25, Xp = true }, -- own follower only (2026-11-13 owner: 25, was 15; first 90)
	Garden = { MaxDistance = 90, Xp = true },
	Training = { MaxDistance = 90, Xp = true, Timer = true },
	Unit = { MaxDistance = 140, Hp = true, Special = true, Xp = true, OnTop = true },
	Ally = { MaxDistance = 140, Hp = true, OnTop = true },
	Enemy = { MaxDistance = 140, Hp = true, Enemy = true, OnTop = true },
	Other = { MaxDistance = 60 },
}

-- 1080p design pixels (scaled by the screen-height factor at layout time)
local K = {
	WIDTH = 96, -- the HP row's least width (the chip is centred over it)
	LEVEL_PX = 22, -- "Lv 12"
	STAR_PX = 18,
	STAR_GAP = 6, -- px between the stars and "Lv" (look review r0: 4 left 1-2 px of chip at 0.8; the mock's gap is ~7)
	CHIP_H = 26, -- (Pitch 2 item 04 B) the chip's face (30 px with its 2 px edge)
	CHIP_EDGE = 2,
	CHIP_LIP = 3,
	CHIP_PAD = 7, -- px from the face's side to the stars / the level (9 from the edge's outside)
	ROW_GAP = 4, -- px between the chip's edge and the HP row (y 36 of the mock-up)
	BAR = 8, -- the timer (kit-b gate U9 round 3: block rows, a 1 px wood edge and lip round a face)
	HP_BAR = 9,
	BLOCKS = { Hp = 8, Special = 8, Xp = 8, Timer = 4 }, -- one cell module: 8 across the plate (HP an eighth each), 4 in the timer's shorter row
	GAP = 3,
	TIMER_PX = 18,
	TIMER_TEXT_W = 40,
	PILL_H = 28,
	PILL_PX = 20,
	PILL_W = 108, -- (Pitch 2 item 04 B) the EVOLVE! plank's least width: the word in FredokaOne at PILL_PX (~89 px) + its room
	PILL_GAP = 4,
	FILL_EPS = 0.004,
	PULSE = 0.55, -- seconds per half pulse of the EVOLVE! pill
	PIP = 9, -- Phase 5: a lives pip (px at 1080p)
	PIP_GAP = 3,
}

-- (kit-b gate U9 round 3: the old neon card, rounded with smooth bars) the kit's navy sign plate and its role colours: each
-- bar's lit blocks in its role face and lip, EVOLVE! the gold plank, the pips square
local C = {
	Xp = Sign.Sky, XpLip = Sign.SkyLip,
	Special = Sign.Gold, SpecialLip = Sign.GoldLip,
	SpecialReady = Sign.GoldLight, SpecialReadyLip = Sign.GoldLip,
	HpOwn = Sign.Grass, HpOwnLip = Sign.GrassLip,
	HpEnemy = Sign.Red, HpEnemyLip = Sign.RedLip,
	Timer = Sign.Violet, TimerLip = Sign.VioletLip,
	Star = Sign.Gold,
	Pill = Sign.Gold,
	PillGlow = Sign.GoldLight, -- the pulse: the gold face to its light step and back (no glow ring)
	-- (Pitch 2 item 04 B) the wood chip: its face, edge and lip; "Lv" in stone with a dark wood stroke
	Chip = Sign.Wood,
	ChipEdge = Sign.WoodDark,
	ChipLip = Sign.WoodDark,
	Text = Sign.Stone,
	Stroke = Sign.WoodDark,
	Life = Sign.Red, -- a lit lives pip
	LifeLost = Sign.WoodDark,
	PipEdge = Sign.Text,
}

local STAR_ICON = "star" -- (kit-b U7b) the evolution stars are PixelIcons (they were U+2605)

local live = 0

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function make(className, props, parent)
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		inst[k] = v
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function clamp01(x)
	x = tonumber(x) or 0
	if x ~= x then
		return 0
	end
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

-- a 1080p pixel size on this screen (bars / gaps: never below `minPx`)
local function px(base, minPx)
	local f = 1
	local ok, factor = pcall(Theme.ScreenFactor)
	if ok and type(factor) == "number" then
		f = factor
	end
	return math.max(minPx or 1, math.floor(base * f + 0.5))
end

local function defaultParent(adornee)
	local player = Players.LocalPlayer
	local pg = player and player:FindFirstChildOfClass("PlayerGui")
	if pg then
		return pg
	end
	return adornee
end

-- (kit-b gate U9 round 3) a bar is the kit's block row (SignKit.FitBlocks: whole-px blocks in a 1 px wood edge with
-- their lip, lit in the role's face and lip, the rest stone). The holder keeps the bar's name and the exact fraction in
-- its attribute Frac; Ceil lights a block for any part of it (health: a pet that lives shows one)
local function newBar(parent, name, color, lip, count, ceil)
	local back = make("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
	}, parent)
	back:SetAttribute("Frac", 0)
	local row = SignKit.FitBlocks(back, { Count = count, Fill = color, FillLip = lip, Weight = "Micro", Size = UDim2.fromScale(1, 1) })
	return { Back = back, Row = row, Count = count, Ceil = ceil == true, Frac = 0 }
end

local function lightBar(bar)
	local n, f = bar.Count, bar.Frac
	local k = bar.Ceil and math.ceil(f * n - 1e-6) or math.floor(f * n + 1e-6)
	SignKit.FillBlocks(bar.Row, k)
end

local function writeFill(bar, frac)
	frac = clamp01(frac)
	if math.abs(frac - bar.Frac) > K.FILL_EPS or (frac == 0 and bar.Frac ~= 0) or (frac == 1 and bar.Frac ~= 1) then
		bar.Frac = frac
		bar.Back:SetAttribute("Frac", frac)
		lightBar(bar)
	end
end

-- a bar's lit colours (the enemy's red health, SPECIAL ready)
local function paintBar(bar, color, lip)
	SignKit.SetBlockCount(bar.Row, bar.Count, color, lip)
	lightBar(bar)
end

----------------------------------------------------------------------
-- construction + layout
----------------------------------------------------------------------
function PetCard.New(adornee, mode, heightStuds, opts)
	opts = type(opts) == "table" and opts or {}
	local self = setmetatable({}, PetCard)
	self.mode = PetCard.Modes[mode] and mode or "Follower"
	self.height = tonumber(heightStuds) or 2.2
	self.level, self.stage, self.ready = nil, 0, false
	self.timerText = nil
	self.lives, self.livesMax = nil, 0
	self.onEvolve = opts.OnEvolve
	self.destroyed = false

	local gui = make("BillboardGui", {
		Name = type(opts.Name) == "string" and opts.Name or "PetCard",
		Adornee = (typeof(adornee) == "Instance") and adornee or nil,
		LightInfluence = 0,
		AlwaysOnTop = false,
		ResetOnSpawn = false,
		Active = true,
		ClipsDescendants = false,
		StudsOffset = Vector3.new(0, self.height, 0),
	})
	self.Gui = gui
	-- (Pitch 2 item 04 B; it was the navy sign plate) the wood chip: square, a mitred 2 px dark wood edge, its 3 px lip,
	-- the lit top line only (Finish "Lean": a small world tag's instance budget)
	local plate = make("Frame", {
		Name = "Plate",
		BorderSizePixel = 0,
		ZIndex = 1,
	}, gui)
	CloudUI.SignBlock(plate, "Stone", {
		Face = C.Chip, Edge = C.ChipEdge, Lip = C.ChipLip, EdgePx = K.CHIP_EDGE, LipPx = K.CHIP_LIP, Pad = false, Finish = "Lean",
	})
	self.plate = plate

	local level = make("TextLabel", {
		Name = "Level",
		BackgroundTransparency = 1,
		Text = "Lv 1",
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 2,
	}, plate)
	Theme.Style(level, "Display", { Color = C.Text, Outline = "World", OutlineThickness = 2, OutlineColor = C.Stroke }) -- over the world: ONE outline (kit-b U6)
	self.levelLabel = level
	-- Phase 5: the lives pips (frames, no text) right of the level; hidden until SetLives
	local pips = make("Frame", { Name = "Lives", BackgroundTransparency = 1, Visible = false }, plate)
	self.pipsFrame, self.pips = pips, {}

	-- the evolution stars: (Pitch 2 item 04 B; they were a navy plaque straddling the corner, covered by the pet's body)
	-- inside the chip, left of the level, with no plaque of their own
	local badge = make("Frame", {
		Name = "StarBadge",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
	}, gui)
	local stars = make("TextLabel", {
		Name = "Stars",
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 4,
	}, badge)
	Theme.Style(stars, "Heading", { Color = C.Star, Outline = "World", OutlineThickness = 1.5, OutlineColor = C.Stroke }) -- over the world: ONE outline (kit-b U6)
	self.starsLabel, self.badge = stars, badge

	self.bars = {
		Hp = newBar(plate, "Hp", C.HpOwn, C.HpOwnLip, K.BLOCKS.Hp, true),
		Special = newBar(plate, "Special", C.Special, C.SpecialLip, K.BLOCKS.Special),
		Xp = newBar(plate, "Xp", C.Xp, C.XpLip, K.BLOCKS.Xp),
		Timer = newBar(plate, "Timer", C.Timer, C.TimerLip, K.BLOCKS.Timer),
	}
	local timerText = make("TextLabel", {
		Name = "TimerText",
		BackgroundTransparency = 1,
		Text = "",
		Visible = false,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, plate)
	Theme.Style(timerText, "Heading", { Color = C.Text, Outline = "World", OutlineThickness = 2, OutlineColor = C.Stroke }) -- over the world: ONE outline (kit-b U6)
	self.timerLabel = timerText

	local pill = make("TextButton", {
		Name = "Evolve",
		Text = "EVOLVE!",
		BackgroundColor3 = C.Pill,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		AutoButtonColor = true,
		Active = true,
		Visible = false,
		Selectable = true,
	}, gui)
	Theme.Style(pill, "Button", { Color = Sign.Text }) -- (gate U9 round 3) brown ink on the gold plank, as the kit's planks
	CloudUI.SignBlock(pill, "Selected", { EdgePx = 2, LipPx = 3, Pad = false }) -- a square gold plank (no pill, no glow ring)
	self.pill = pill
	pill.Activated:Connect(function()
		if self.destroyed or not self.ready then
			return
		end
		local fn = self.onEvolve
		if type(fn) == "function" then
			local ok, err = pcall(fn)
			if not ok then
				warn("[PetCard] EVOLVE handler failed: " .. tostring(err))
			end
		end
	end)

	self:_layout()
	gui.Parent = (typeof(opts.Parent) == "Instance" and opts.Parent) or defaultParent(adornee)
	live = live + 1
	return self
end

-- lays the rows out for the current mode / ready state (called on SetMode / SetLevel changes, never per frame)
-- (Pitch 2 item 04 B) top to bottom: the EVOLVE! pill, the wood chip (stars, "Lv", lives pips in one row), the HP row /
-- the timer row under it. The chip is centred over the row; the billboard holds the chip's edge (it is drawn outside the
-- face) and grows upwards, the bottom row keeps the bottom.
function PetCard:_layout()
	local m = PetCard.Modes[self.mode]
	local gui = self.Gui
	gui.MaxDistance = m.MaxDistance
	gui.AlwaysOnTop = m.OnTop == true
	local gap = px(K.GAP, 2)
	local edge = K.CHIP_EDGE
	local chipH = px(K.CHIP_H, 18)
	local rowH = chipH - K.CHIP_LIP -- the chip's row sits above its lip
	local inset = px(K.CHIP_PAD, 4)
	local levelPx = Theme.ScaledSize(K.LEVEL_PX)
	local starPx = Theme.ScaledSize(K.STAR_PX)
	local hasStars = self.stage > 0
	self.levelLabel.TextSize = levelPx

	-- the chip's row, left to right (x in the face)
	local x = inset
	local badge = self.badge
	local bw, bh = 0, 0
	if hasStars then
		-- (look review r0: at 0.8 starPx 14 snapped to 9 px stars of 1 px cells beside an 18 px "Lv") the stars snap to the
		-- largest multiple of 9 within the chip's row and the level's px: 18 at 0.8 and 1080p, 27 at 1.25
		local snap = math.max(9, 9 * math.floor(math.min(rowH, math.max(starPx, levelPx)) / 9))
		local cell = math.floor(snap / 9)
		bw = self.stage * snap + (self.stage - 1) * cell
		bh = snap
		self.starsLabel.TextSize = starPx
		badge.Size = UDim2.fromOffset(bw, bh)
		-- (kit-b U7b) one PixelIcon star per stage, centred, at the multiple of 9 that fits starPx
		PixelIcon.Lead(self.starsLabel, STAR_ICON, { Count = self.stage, Of = self.stage, Px = snap })
		x = x + bw + px(K.STAR_GAP, 3)
	end
	badge.Visible = hasStars
	local ring = 2 -- the level's outline on both sides
	local levelW = math.ceil(Theme.MeasureLabel(self.levelLabel, self.levelLabel.Text, levelPx).X) + 2 * ring
	self.levelLabel.Position = UDim2.fromOffset(x, 0)
	self.levelLabel.Size = UDim2.fromOffset(levelW, rowH)
	x = x + levelW
	-- Phase 5 lives pips: right of the level, in the chip
	local nPips = self.lives ~= nil and self.livesMax or 0
	self.pipsFrame.Visible = nPips > 0
	if nPips > 0 then
		local pip, pgap = px(K.PIP, 5), px(K.PIP_GAP, 2)
		local pw = nPips * pip + (nPips - 1) * pgap
		x = x + gap
		self.pipsFrame.Position = UDim2.fromOffset(x, math.floor((rowH - pip) / 2))
		self.pipsFrame.Size = UDim2.fromOffset(pw, pip)
		x = x + pw
		for i = 1, math.max(nPips, #self.pips) do
			local p = self.pips[i]
			if i <= nPips then
				if not p then
					p = make("Frame", { Name = "Pip" .. i, BorderSizePixel = 0, BackgroundColor3 = C.Life, ZIndex = 2 }, self.pipsFrame)
					local edgeS = Theme.Stroke(p, C.PipEdge, 1, 0) -- (gate U9 round 3) a square pip in a 1 px edge
					edgeS.Name = "Edge"
					edgeS.LineJoinMode = Enum.LineJoinMode.Miter
					self.pips[i] = p
				end
				p.Visible = true
				p.Size = UDim2.fromOffset(pip, pip)
				p.Position = UDim2.fromOffset((i - 1) * (pip + pgap), 0)
				p.BackgroundColor3 = (i <= self.lives) and C.Life or C.LifeLost
			elseif p then
				p.Visible = false
			end
		end
	end
	local chipW = x + inset -- the face
	local outerW = chipW + 2 * edge

	-- the row under the chip: HP (the modes that have it), the training timer; SPECIAL and XP draw nothing here
	local bars = self.bars
	local hpOn, timerOn = m.Hp == true, m.Timer == true
	local w = outerW
	if hpOn or timerOn then
		w = math.max(outerW, px(K.WIDTH, 60))
	end
	-- (Pitch 2 item 04 B, the gate render) while EVOLVE! shows, the card is at least its word wide plus the plank's room
	-- (the chip stays centred): a lone "Lv 20" chip is narrower than the word, which ran out of its plank
	if self.ready then
		local word = Theme.Measure(self.pill.Text, "Button", Theme.ScaledSize(K.PILL_PX)).X
		w = math.max(w, math.ceil(word) + 2 * inset + 2 * edge, px(K.PILL_W, 80))
	end
	local chipX = math.floor((w - outerW) / 2) + edge -- the face's left in the billboard
	bars.Special.Back.Visible = false
	bars.Xp.Back.Visible = false
	if bars.Hp.Enemy ~= (m.Enemy == true) then
		bars.Hp.Enemy = m.Enemy == true
		paintBar(bars.Hp, m.Enemy and C.HpEnemy or C.HpOwn, m.Enemy and C.HpEnemyLip or C.HpOwnLip)
	end
	-- the rows are the chip's children, placed from the face's corner: under its edge, as wide as the billboard
	local rowY = chipH + edge + px(K.ROW_GAP, 2)
	local belowH = 0
	bars.Hp.Back.Visible = hpOn
	if hpOn then
		local hh = px(K.HP_BAR, 6)
		bars.Hp.Back.Position = UDim2.fromOffset(-chipX, rowY)
		bars.Hp.Back.Size = UDim2.fromOffset(w, hh)
		belowH = rowY + hh - chipH - edge
		rowY = rowY + hh + gap
	end
	bars.Timer.Back.Visible = timerOn
	self.timerLabel.Visible = timerOn
	if timerOn then
		local tpx = Theme.ScaledSize(K.TIMER_PX)
		local textW = px(K.TIMER_TEXT_W, 30)
		local th = tpx + 2
		local barH = px(K.BAR, 5)
		bars.Timer.Back.Position = UDim2.fromOffset(-chipX, rowY + math.floor((th - barH) / 2))
		bars.Timer.Back.Size = UDim2.fromOffset(w - textW - gap, barH)
		self.timerLabel.TextSize = tpx
		self.timerLabel.Position = UDim2.fromOffset(w - chipX - textW, rowY)
		self.timerLabel.Size = UDim2.fromOffset(textW, th)
		belowH = rowY + th - chipH - edge
	end

	-- the row above the chip: the EVOLVE! pill
	local top = 0
	local pill = self.pill
	if self.ready then
		local ph = px(K.PILL_H, 22)
		top = ph + px(K.PILL_GAP, 2)
		pill.TextSize = Theme.ScaledSize(K.PILL_PX)
		pill.Size = UDim2.fromOffset(w, ph)
		pill.Position = UDim2.fromOffset(0, 0)
	end
	pill.Visible = self.ready
	self.plate.Position = UDim2.fromOffset(chipX, top + edge)
	self.plate.Size = UDim2.fromOffset(chipW, chipH)
	if hasStars then
		badge.Position = UDim2.fromOffset(chipX + inset, top + edge + math.floor((rowH - bh) / 2))
	end
	gui.Size = UDim2.fromOffset(w, top + edge + chipH + edge + belowH)
	self:_pulse(self.ready)
end

function PetCard:_pulse(on)
	if on and not self.tween then
		local ok, tween = pcall(function()
			local info = TweenInfo.new(K.PULSE, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
			return TweenService:Create(self.pill, info, { BackgroundColor3 = C.PillGlow })
		end)
		if ok and tween then
			self.tween = tween
			pcall(tween.Play, tween)
		end
	elseif not on and self.tween then
		pcall(self.tween.Cancel, self.tween)
		self.tween = nil
		self.pill.BackgroundColor3 = C.Pill
	end
end

----------------------------------------------------------------------
-- public setters (cheap: each writes only what changed)
----------------------------------------------------------------------
function PetCard:SetLevel(level, stage, ready)
	if self.destroyed then
		return
	end
	level = math.max(1, math.floor(tonumber(level) or 1))
	stage = math.floor(tonumber(stage) or 0)
	if stage < 0 then
		stage = 0
	elseif stage > 2 then
		stage = 2
	end
	ready = ready == true
	local relayout = false
	if level ~= self.level then
		-- (Pitch 2 item 04 B) the chip is as wide as its row: a level with more digits widens it
		relayout = #tostring(level) ~= #tostring(self.level or 1)
		self.level = level
		self.levelLabel.Text = "Lv " .. tostring(level)
	end
	if stage ~= self.stage then
		self.stage = stage
		self.starsLabel.Text = "" -- (kit-b U7b) the layout draws the stars (PixelIcon.Lead, Count = the stage)
		relayout = true
	end
	if ready ~= self.ready then
		self.ready = ready
		relayout = true
	end
	if relayout then
		self:_layout()
	end
end

function PetCard:SetXp(frac)
	if not self.destroyed then
		writeFill(self.bars.Xp, frac)
	end
end

function PetCard:SetHp(frac)
	if not self.destroyed then
		writeFill(self.bars.Hp, frac)
	end
end

function PetCard:SetSpecial(frac, ready)
	if self.destroyed then
		return
	end
	writeFill(self.bars.Special, frac)
	ready = ready == true
	if ready ~= self.specialReady then
		self.specialReady = ready
		paintBar(self.bars.Special, ready and C.SpecialReady or C.Special, ready and C.SpecialReadyLip or C.SpecialLip)
	end
end

function PetCard:SetTimer(frac, text)
	if self.destroyed then
		return
	end
	writeFill(self.bars.Timer, frac)
	text = text ~= nil and tostring(text) or ""
	if text ~= self.timerText then
		self.timerText = text
		self.timerLabel.Text = text
	end
end

-- Phase 5: a fighter's lives (pips right of the level); n = nil hides them. Re-lays out only when they change.
function PetCard:SetLives(n, maxN)
	if self.destroyed then
		return
	end
	n = tonumber(n)
	if n ~= nil then
		n = math.max(0, math.floor(n))
		maxN = math.max(n, math.min(5, math.floor(tonumber(maxN) or 3)))
	else
		maxN = 0
	end
	if n == self.lives and maxN == self.livesMax then
		return
	end
	local relayout = maxN ~= self.livesMax or (n == nil) ~= (self.lives == nil)
	self.lives, self.livesMax = n, maxN
	if relayout then
		self:_layout()
	elseif n ~= nil then
		for i, p in ipairs(self.pips) do
			p.BackgroundColor3 = (i <= n) and C.Life or C.LifeLost
		end
	end
end

function PetCard:SetMode(mode)
	if self.destroyed or not PetCard.Modes[mode] or mode == self.mode then
		return
	end
	self.mode = mode
	self:_layout()
end

function PetCard:SetAdornee(adornee, heightStuds)
	if self.destroyed then
		return
	end
	local gui = self.Gui
	local part = (typeof(adornee) == "Instance") and adornee or nil
	if gui.Adornee ~= part then
		gui.Adornee = part
	end
	local h = tonumber(heightStuds)
	if h and math.abs(h - self.height) > 0.01 then
		self.height = h
		gui.StudsOffset = Vector3.new(0, h, 0)
	end
end

function PetCard:SetShown(shown)
	if self.destroyed then
		return
	end
	shown = shown ~= false
	if self.Gui.Enabled ~= shown then
		self.Gui.Enabled = shown
	end
end

function PetCard:SetOnEvolve(fn)
	self.onEvolve = fn
end

function PetCard:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	live = live - 1
	if self.tween then
		pcall(self.tween.Cancel, self.tween)
		self.tween = nil
	end
	local gui = self.Gui
	self.Gui = nil
	if gui then
		pcall(gui.Destroy, gui)
	end
end

function PetCard.Count()
	return live
end

return PetCard
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1195">
            <Properties>
              <string name="Name">PetPicker</string>
              <string name="Source"><![CDATA[-- PetPicker (client UI, gui-redo Task 6; docs/superpowers/specs/2026-11-06-window-redo-design.md 5.1 / 5.2): the ONE
-- full-screen pet picker sheet. The Training Place (TrainController) and the Fusion Machine (FusionController) open it over
-- their own window; it reads State / PetBits / PetKeys and never sends a remote.
--
--   PetPicker.Open(spec) -> boolean   spec = { Context = "Train" | "Upgrade" | "Mix", Title = string, Selected = key | nil
--                                     (outlined gold), Blocked = { [key] = word } | nil (dimmed with that word, not pickable),
--                                     OnPick = function(key) | nil (called once; the sheet closes first), OnClose =
--                                     function(picked) | nil }. false only without a gui or a valid Context (an empty list
--                                     still opens and says so). Opening over an open sheet closes that one first (OnClose(false)).
--   PetPicker.Close()                 closes without a pick: OnClose(false). The opener's Close calls it too.
--   PetPicker.IsOpen() -> boolean     PetPicker.Layout() -> "PC" | "Phone"
--   PetPicker.Entries(context) -> { entry... }   pure over State. entry = { Key, Def, Name, Level, Stage, Rarity, RarityOrder,
--                                     Copies, Team (the slot in the active preset) | nil, Job = { Stat, Ends, Slot } | nil, Ready
--                                     (Upgrade: Copies >= TycoonCatalog.Fusion.Copies), Hybrid, Blocked = "Training" | nil }.
--                                     Train lists every owned key; Upgrade the regular keys that can still go up a finish (no
--                                     hybrid, no Rainbow); Mix the regular keys. Blocked: Upgrade a key in training or whose
--                                     next-finish key is in training, Mix a key in training (the server refuses both).
--   PetPicker.Sorted(context, entries, sortId, filterId, query) -> entries   pure (the Training window's arrows use it): the
--                                     filter, the case-insensitive plain search of the name (string.find plain), the sort
--   PetPicker.Sorts[context], PetPicker.Filters[context]   { { Id, Label }... } (the first is the default)
--   Tests: PetPicker.Shown() -> { key... } (the cards in display order), SetQuery(text), SetSort(id), SetFilter(id),
--          Pick(key) -> boolean (the tap path: false when closed, blocked, gone or not shown)
-- The sheet binds no Esc / gamepad B: the opener's back handler calls Close() while IsOpen(), else closes itself. It does not
-- fire MenuController.WindowOpened (it is part of the window that opened it); entering a match closes it.
--
-- Screen: ScreenGui "NimbusPetPicker" (DisplayOrder 24, IgnoreGuiInset = true): Shade (dims the screen under the top bar,
-- swallows taps) and Window_PetPicker (NeonKit.BigRect: 1440x920 at 1080p, 820x330 at scale 1 on an 844x390 phone; UIScale
-- "Fit") > Panel (UIScale "Pop": the open tween) > Header (Icon, Title, CloseButton), Body > Search (TextBox), SortButton
-- ("Sort: Ready first" + a down arrow; it cycles the context's sorts), Filter_<Id> chips (attribute Selected), Grid (the only
-- ScrollingFrame) > Card_<key> (attributes Selected, Blocked, Dim, Ready; Art, Level "Lv 34" + a gold star per stage, Badge
-- (Train: a gold star in the team; Upgrade "x5", green when Ready; Mix "x2"), Name (TextService-measured: the whole name,
-- else a Golden / Rainbow copy's "Golden Owl", else the last word), Rarity (PC), TrainChip "Training 3:10" (Train, live),
-- Shade + BlockWord), Empty (EmptyText, ClearButton), HintLine (3 s: why a blocked card cannot be picked). ViewCache
-- (hidden) parks cached viewports. The window is a MouseLock hold while shown (the cursor is free).
--   Phone (scale 1): header 50, X 44; search 220 x 44, sort 170 x 44, chips 44 tall (Train shows its first three), the row
--     wrapping where the box is narrower (portrait: the search takes the whole first row); the grid 10 px under the last row
--     (y 58 on one row), cards >= 124 x 100 (art 56), 6 a row at 820.
--   PC: header 76, X 56; search 460 x 60, sort 280 x 60, chips 50 tall on the first row when they end at least 24 px before
--     the body's right edge, else on a row at y 92 with the grid from y 166 (else y 100); cards >= 180 x 226 (7 a row at 1080p).
--   Both: the cards fill the grid's width (as many as fit at the smallest size, then widened to fill).
-- Viewports: only the cards that intersect the grid's visible window hold one (CloudUI.PetViewport, Low, still); a card that
-- scrolls out parks its viewport in ViewCache (clones cached per key, rebuilt on a new stage, at most CACHE_MAX kept), new
-- ones are built under BUILD_BUDGET seconds a frame (at least one, at most BUILD_MAX) on one Heartbeat connection that lives
-- while the sheet is open. State.Changed re-lists the open sheet: a key that left the collection loses its card, can never be
-- handed to OnPick, and drops the Selected mark. Sort and filter are kept per context for the session; the search starts
-- empty on every Open.
-- Plain Lua 5.1-compatible syntax only. All text goes through Theme roles; glyphs are UTF-8 byte escapes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextService = game:GetService("TextService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the picker's icons
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-5) the awning over the sheet

local UI = script.Parent
local Client = UI.Parent
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local Bits = require(UI:WaitForChild("PetBits"))
local State = require(Client:WaitForChild("State"))

local PetPicker = {}

local K = {
	DISPLAY_ORDER = 24,
	RECT = { H0 = 390, W0 = 820, Y0 = 330, H1 = 1080, W1 = 1440, Y1 = 920 },
	MARGIN = 12,
	PHONE_W = 900,
	SHORT = 560,
	PC_MIN_H = 600,
	PC_MAX_W = 0.76,
	BUILD_BUDGET = 0.004, -- seconds of viewport building a frame (the first one always)
	BUILD_MAX = 4,
	CACHE_MAX = 48, -- cached viewports kept (shown + parked)
	TICK = 0.25, -- seconds between two Training chip refreshes
	HINT_SECONDS = 3,
	OPEN_TIME = 0.22,
	OPEN_FROM = 0.92,
	SHADE = 0.55,
	PHONE_FILTERS = 3,
	FRAME = 6, -- (kit-b U9-5) px of the wood frame round the stone body
	ROOF_W = 360, -- (kit-b U9-5) the awning's fixed width (the Pets window's)
	CARD_LIP = 6, -- (kit-b U9-5) px of a card's rarity lip
	-- (LOOK-ui2: the first row had no top edge, the first column no left edge: the cards' outer wood stroke lay outside the
	-- list's clip) the cards start this far in on every side: the selected card's 4 px stroke + 1
	GRID_INSET = 5,
	PHONE = {
		Header = 50, Close = 44, CloseY = 3, HeadPad = 10, Icon = 30, IconPx = 18, IconText = 24, TitleText = 20, TitleMin = 16,
		Pad = 10, RowY = 4, Row = 44, RowGap = 8, Gap = 8, ChipH = 44, ChipGap = 6, ChipText = 15, SearchW = 220, SortW = 170,
		SortText = 15, SortMin = 15, SearchText = 15, GridGap = 10, Scroll = 6, CardW = 122, CardH = 100, CardGap = 8, -- (LOOK-ui2: 124; the Grid's inset kept six a row)
		Art = 56, ArtY = 6, Text = 15, ChipRowH = 22, NameH = 20, Corner = 12, Hint = 15, Empty = 18, ClearW = 160,
		ClearH = 44, Block = 15,
	},
	PC = {
		Header = 76, Close = 56, CloseY = 10, HeadPad = 24, Icon = 42, IconPx = 27, IconText = 36, TitleText = 34, TitleMin = 24,
		Pad = 30, RowY = 18, Row = 60, RowGap = 14, Gap = 16, ChipH = 50, ChipGap = 10, ChipText = 20, SearchW = 460,
		SortW = 280, SortText = 22, SortMin = 18, SearchText = 22, Row2Y = 92, GridY1 = 100, GridY2 = 166, ChipEnd = 24,
		Scroll = 10, CardW = 180, CardH = 226, CardGap = 14, Art = 120, ArtY = 12, Text = 18, NameText = 20, ChipRowH = 30,
		NameH = 28, RarityH = 24, Corner = 14, Hint = 20, Empty = 24, ClearW = 200, ClearH = 56, Block = 22,
	},
	-- the chips' design widths (the mock's), widened when the measured label needs more
	CHIP_W = {
		PC = { All = 90, Team = 110, Training = 150, Ready = 110, Rare = 190, Epic = 180 },
		Phone = { All = 64, Team = 74, Training = 104, Ready = 84, Rare = 124, Epic = 124 },
	},
}

PetPicker.Sorts = {
	Train = { { Id = "Default", Label = "Training first" }, { Id = "Level", Label = "Level" }, { Id = "Rarity", Label = "Rarity" }, { Id = "Name", Label = "Name" } },
	Upgrade = { { Id = "Default", Label = "Ready first" }, { Id = "Rarity", Label = "Rarity" }, { Id = "Level", Label = "Level" }, { Id = "Name", Label = "Name" } },
	Mix = { { Id = "Default", Label = "Rarity" }, { Id = "Level", Label = "Level" }, { Id = "Name", Label = "Name" }, { Id = "Team", Label = "Team first" } },
}
PetPicker.Filters = {
	Train = { { Id = "All", Label = "All" }, { Id = "Team", Label = "Team" }, { Id = "Training", Label = "Training" }, { Id = "Rare", Label = "Rare and up" }, { Id = "Epic", Label = "Epic and up" } },
	Upgrade = { { Id = "All", Label = "All" }, { Id = "Ready", Label = "Ready" }, { Id = "Team", Label = "Team" } },
	Mix = { { Id = "All", Label = "All" }, { Id = "Team", Label = "Team" }, { Id = "Rare", Label = "Rare and up" } },
}
-- the short sort words a narrow sort button falls back to
local SHORT = { ["Training first"] = "Training", ["Ready first"] = "Ready", ["Team first"] = "Team" }
local FILTER_IDS = { "All", "Team", "Training", "Ready", "Rare", "Epic" }
local FILTER_LABELS = { All = "All", Team = "Team", Training = "Training", Ready = "Ready", Rare = "Rare and up", Epic = "Epic and up" }

-- (kit-b U9-5) the Signboard palette (the pitch's kit B, as the Pets window): brown ink on stone tiles in a sunk well, the
-- rarity on each card's lip, gold for the selected card and filter, green for a Ready count, violet for a pet in training
local SIGN = Theme.Sign
local C = {
	White = Theme.Colors.White,
	Ink = SIGN.Text,
	Navy = SIGN.Navy,
	Stone = SIGN.Stone,
	Tile = SIGN.Tile,
	Wood = SIGN.Wood,
	Well = SIGN.Well,
	WellEdge = SIGN.WellEdge,
	Muted = SIGN.TextMuted,
	Gold = SIGN.Gold,
	GoldInk = SIGN.GoldLip, -- gold marks on stone (the stars)
	Purple = SIGN.Violet,
	Ready = SIGN.Grass,
	Count = SIGN.Stone,
}
-- (kit-b U7b) PixelIcons, not emoji: the team star, the sort arrow, the search glass, the header's icon per context
local ICON = { Star = "star", Down = "down", Glass = "glass", Context = { Train = "weight", Upgrade = "sparkle", Mix = "sparkle" } }
local LEVEL_STAR = 20 -- px a level line's evolution star takes (18 + its cell gap)

local H = {}
local U = { Cards = {}, Chips = {}, Views = {} } -- widgets; Views[key] = { Handle, Stage } (cached viewports)
local S = {
	Open = false,
	Built = false,
	Spec = nil,
	Context = nil,
	Selected = nil,
	Query = "",
	Sort = { Train = "Default", Upgrade = "Default", Mix = "Default" },
	Filter = { Train = "All", Upgrade = "All", Mix = "All" },
	Order = {}, -- the shown keys in display order
	Shown = {}, -- [key] = true
	ByKey = {}, -- [key] = entry of the open context
	Mode = "PC",
	Scale = 1,
	ViewDirty = false,
	TickAcc = 0,
	HintToken = 0,
	Silent = false,
	Warned = {},
}

local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[PetPicker] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

-- (kit-b U9-5) a square edge (a mitred border UIStroke named SignEdge)
function H.edge(obj, color, px)
	local s = Theme.Stroke(obj, color, px or 2, 0)
	s.Name = "SignEdge"
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

local function label(parent, name, role, size, props)
	local l = Theme.Label("", role, { Size = size })
	l.Name = name
	l.BackgroundTransparency = 1
	l.BorderSizePixel = 0
	l.TextTruncate = Enum.TextTruncate.AtEnd
	l.TextColor3 = C.Ink -- (kit-b U9-5) brown ink on stone unless the caller says otherwise
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

----------------------------------------------------------------------
-- Data (pure over State)
----------------------------------------------------------------------
function H.optional(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	return (ok and type(mod) == "table") and mod or nil
end

function H.copiesNeeded()
	local tycoon = H.optional("TycoonCatalog")
	local n = tycoon and type(tycoon.Fusion) == "table" and tonumber(tycoon.Fusion.Copies) or nil
	return n or 3
end

-- { [key] = slot } of the active preset
function H.teamSlots()
	local out = {}
	local ok, teams = pcall(State.Teams)
	if ok and type(teams) == "table" and type(teams.Presets) == "table" then
		local preset = teams.Presets[tonumber(teams.Active) or 1]
		for i, key in ipairs(type(preset) == "table" and preset or {}) do
			if type(key) == "string" and key ~= "" and out[key] == nil then
				out[key] = i
			end
		end
	end
	return out
end

local NEXT_TIER = { Normal = "Golden", Golden = "Rainbow" }

function PetPicker.Entries(context)
	local out = {}
	if not PetPicker.Sorts[context] then
		return out
	end
	local okKeys, keys = pcall(State.Keys)
	if not okKeys or type(keys) ~= "table" then
		return out
	end
	local okMap, growth = pcall(State.PetGrowthMap)
	growth = (okMap and type(growth) == "table") and growth or {}
	local slots = H.teamSlots()
	local need = H.copiesNeeded()
	local seen = {}
	for _, key in ipairs(keys) do
		local copies = type(key) == "string" and not seen[key] and State.OwnedCount(key) or 0
		local parsed = copies > 0 and Bits.parseKey(key) or nil
		if parsed then
			seen[key] = true
			local hybrid = parsed.HybridId ~= nil
			local nextTier = NEXT_TIER[parsed.Tier or "Normal"]
			local listed = context == "Train" or (context == "Mix" and not hybrid) or (context == "Upgrade" and not hybrid and nextTier ~= nil)
			local def = listed and Bits.defOfKey(key) or nil
			if def then
				local g = growth[key]
				local job = type(g) == "table" and type(g.Job) == "table" and g.Job or nil
				local blocked = nil
				if context ~= "Train" and job then
					blocked = "Training"
				elseif context == "Upgrade" and parsed.PetId then
					local nextG = growth[parsed.PetId .. "@" .. nextTier]
					if type(nextG) == "table" and type(nextG.Job) == "table" then
						blocked = "Training"
					end
				end
				out[#out + 1] = {
					Key = key,
					Def = def,
					Name = Bits.displayName(key, def),
					Level = (Bits.petLevel(key)),
					Stage = Bits.stage(key),
					Rarity = def.Rarity,
					RarityOrder = Bits.rarityOrder(def.Rarity),
					Copies = copies,
					Team = slots[key],
					Job = job and { Stat = job.Stat, Ends = tonumber(job.Ends) or 0, Slot = job.Slot } or nil,
					Ready = context == "Upgrade" and copies >= need,
					Hybrid = hybrid,
					Blocked = blocked,
				}
			end
		end
	end
	return out
end

function H.valid(list, id)
	for _, it in ipairs(list or {}) do
		if it.Id == id then
			return true
		end
	end
	return false
end

function H.passes(e, filterId)
	if filterId == "Team" then
		return e.Team ~= nil
	elseif filterId == "Training" then
		return e.Job ~= nil
	elseif filterId == "Ready" then
		return e.Ready == true
	elseif filterId == "Rare" then
		return e.RarityOrder >= Bits.rarityOrder("Rare")
	elseif filterId == "Epic" then
		return e.RarityOrder >= Bits.rarityOrder("Epic")
	end
	return true
end

-- comparers answer true / false, or nil on a tie (the next rule decides; the key is the last)
local CMP = {}
function CMP.rarity(a, b)
	if a.RarityOrder ~= b.RarityOrder then
		return a.RarityOrder > b.RarityOrder
	end
	return nil
end
function CMP.level(a, b)
	if a.Level ~= b.Level then
		return a.Level > b.Level
	end
	return nil
end
function CMP.name(a, b)
	local x, y = tostring(a.Name):lower(), tostring(b.Name):lower()
	if x ~= y then
		return x < y
	end
	return nil
end
function CMP.team(a, b)
	local x, y = a.Team or math.huge, b.Team or math.huge
	if x ~= y then
		return x < y
	end
	return nil
end
-- Train's default: in training (soonest done first), then the team (slot order), then the rest
function CMP.training(a, b)
	local ga = a.Job and 1 or (a.Team and 2 or 3)
	local gb = b.Job and 1 or (b.Team and 2 or 3)
	if ga ~= gb then
		return ga < gb
	end
	if ga == 1 and a.Job.Ends ~= b.Job.Ends then
		return a.Job.Ends < b.Job.Ends
	elseif ga == 2 then
		return CMP.team(a, b)
	end
	return nil
end
function CMP.ready(a, b)
	if (a.Ready == true) ~= (b.Ready == true) then
		return a.Ready == true
	end
	if a.Copies ~= b.Copies then
		return a.Copies > b.Copies
	end
	return nil
end

local CHAINS = {
	Train = { Default = { CMP.training, CMP.rarity, CMP.level, CMP.name }, Level = { CMP.level, CMP.rarity, CMP.name }, Rarity = { CMP.rarity, CMP.level, CMP.name }, Name = { CMP.name } },
	Upgrade = { Default = { CMP.ready, CMP.rarity, CMP.name }, Rarity = { CMP.rarity, CMP.level, CMP.name }, Level = { CMP.level, CMP.rarity, CMP.name }, Name = { CMP.name } },
	Mix = { Default = { CMP.rarity, CMP.level, CMP.name }, Level = { CMP.level, CMP.rarity, CMP.name }, Name = { CMP.name }, Team = { CMP.team, CMP.rarity, CMP.level, CMP.name } },
}

function PetPicker.Sorted(context, entries, sortId, filterId, query)
	local out = {}
	local chains = CHAINS[context]
	if not chains or type(entries) ~= "table" then
		return out
	end
	if not H.valid(PetPicker.Filters[context], filterId) then
		filterId = "All"
	end
	local chain = chains[sortId] or chains.Default
	local q = type(query) == "string" and string.lower(query):match("^%s*(.-)%s*$") or ""
	for _, e in ipairs(entries) do
		if type(e) == "table" and H.passes(e, filterId) and (q == "" or string.find(tostring(e.Name):lower(), q, 1, true) ~= nil) then
			out[#out + 1] = e
		end
	end
	table.sort(out, function(a, b)
		for _, fn in ipairs(chain) do
			local r = fn(a, b)
			if r ~= nil then
				return r
			end
		end
		return tostring(a.Key) < tostring(b.Key)
	end)
	return out
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
function H.ensureGui()
	if U.Gui and U.Gui.Parent then
		return true
	end
	local player = Players.LocalPlayer
	if not (player and player:FindFirstChildOfClass("PlayerGui")) then
		return false
	end
	U.Gui = CloudUI.NewScreenGui("NimbusPetPicker", K.DISPLAY_ORDER)
	U.Gui.IgnoreGuiInset = true
	-- (LOOK-ui2: under the window's Fit of 0.8 a 2 px edge drew 1.6 screen px, a 8 px lip 6.4) every wood edge and lip of the
	-- window, now and as rows are added, on whole screen px (PixelIcon.WholeTree, kitb-look1's one helper)
	PixelIcon.WholeTree(U.Gui)
	S.Built = false
	U.Cards, U.Chips, U.Views = {}, {}, {}
	if not S.Hooked then
		S.Hooked = true
		State.Changed:Connect(function()
			if S.Open then
				safe("relist", H.relist)
			end
		end)
		player:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if player:GetAttribute(Config.Attr.InMatch) == true then
				PetPicker.Close()
			end
		end)
	end
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if S.Open then
			safe("relayout", H.layout)
		end
	end)
	return true
end

function H.build()
	if S.Built then
		return
	end
	S.Built = true
	local gui = U.Gui
	U.Shade = Util.Create("TextButton", {
		Name = "Shade", Text = "", AutoButtonColor = false, BorderSizePixel = 0, Active = true, Selectable = false,
		BackgroundColor3 = SIGN.NavyLip, BackgroundTransparency = K.SHADE, Visible = false, Parent = gui,
	})
	local holder = Util.Create("Frame", { Name = "Window_PetPicker", BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = 2, Parent = gui })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-5) the sheet as a kit B sign: a wood frame (Panel) round a stone body, the navy header plank (the title's T1
	-- band is the plank: RibbonBand = "Header"; one look for every context), on a PC screen the fixed-size pink awning
	local panel = Util.Create("Frame", {
		Name = "Panel", BackgroundColor3 = C.Wood, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1), ZIndex = 2, Parent = holder,
	})
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel })
	U.Panel = panel
	local stone = Util.Create("Frame", {
		Name = "Stone", BackgroundColor3 = C.Stone, BorderSizePixel = 0, Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME), ZIndex = 1, Parent = panel,
	})
	Util.Create("Frame", {
		Name = "Lip", BackgroundColor3 = SIGN.StoneLip, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 6), ZIndex = 1, Parent = stone,
	})
	local header = Util.Create("Frame", { Name = "Header", BackgroundColor3 = C.Navy, BorderSizePixel = 0, ZIndex = 3, Parent = panel })
	U.HeaderFoot = Util.Create("Frame", { Name = "HeaderFoot", BackgroundColor3 = SIGN.NavyLip, BorderSizePixel = 0, ZIndex = 3, Parent = header })
	U.Header = header
	U.Roof = SignKit.Roof(panel, { Width = K.ROOF_W, Y = SignKit.RoofSeat(), ZIndex = 4 }) -- (F0 review) seated on the frame
	U.Icon = label(header, "Icon", "Title", 36, { ZIndex = 4, TextColor3 = C.Gold, TextTruncate = Enum.TextTruncate.None })
	U.Title = label(header, "Title", "Title", 34, { ZIndex = 4, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Left })
	U.Title:SetAttribute("RibbonBand", "Header")
	Theme.StyleTitle(U.Title)
	U.Close = CloudUI.Button({
		Name = "CloseButton", Text = "", Style = "Red", Skin = "Sign", Size = UDim2.fromOffset(44, 44), TextSize = 22, ZIndex = 5,
		Callback = function()
			PetPicker.Close()
		end,
		Parent = header,
	})
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = C.Ink }) -- slop audit 2026-11-12: a drawn X (no glyph)
	NeonKit.CloseBlock(U.Close) -- (LOOK-ui2) the kit's one close block: never under 44 screen px, its x in 3 px cells
	-- body
	local body = Util.Create("Frame", { Name = "Body", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2, Parent = panel })
	U.Body = body
	local search = Util.Create("TextBox", {
		Name = "Search", Text = "", PlaceholderText = "Search pets", ClearTextOnFocus = false, BorderSizePixel = 0,
		BackgroundColor3 = C.Tile, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = body,
	})
	Theme.Style(search, "Body", { Size = 22 })
	search.TextColor3 = C.Ink -- (kit-b U9-5) a stone field in a wood edge
	search.PlaceholderColor3 = C.Muted
	H.edge(search, C.Wood, 3)
	U.SearchPad = Util.Create("UIPadding", { PaddingLeft = UDim.new(0, 44), PaddingRight = UDim.new(0, 10), Parent = search })
	U.Glass = label(search, "Glass", "Body", 20, { ZIndex = 4, TextTruncate = Enum.TextTruncate.None })
	PixelIcon.Host(U.Glass, ICON.Glass, 18)
	search:GetPropertyChangedSignal("Text"):Connect(function()
		if not S.Silent and S.Open then
			S.Query = search.Text
			safe("search", H.relist, true)
		end
	end)
	U.Search = search
	U.Sort = CloudUI.Button({
		Name = "SortButton", Text = "Sort", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(170, 44), TextSize = 22, ZIndex = 3,
		Callback = function()
			H.cycleSort()
		end,
		Parent = body,
	})
	for _, id in ipairs(FILTER_IDS) do
		local chip = Util.Create("TextButton", {
			Name = "Filter_" .. id, Text = FILTER_LABELS[id], AutoButtonColor = false, BorderSizePixel = 0,
			BackgroundColor3 = C.Tile, Visible = false, ZIndex = 3, Parent = body,
		})
		Theme.Style(chip, "Button", { Size = 20 })
		-- (kit-b U9-5) a stone block; the active filter turns gold (H.paintChips)
		local outline = CloudUI.SignBlock(chip, "Stone", { LipPx = 4 })
		chip.Activated:Connect(function()
			PetPicker.SetFilter(id)
		end)
		U.Chips[id] = { Button = chip, Stroke = outline, Glyphs = chip:FindFirstChild("TextOutline") }
	end
	local grid = Util.Create("ScrollingFrame", {
		Name = "Grid", BackgroundTransparency = 1, BorderSizePixel = 0, ScrollingDirection = Enum.ScrollingDirection.Y,
		CanvasSize = UDim2.fromOffset(0, 0),
		ZIndex = 3, Parent = body,
	})
	SignKit.ScrollBar(grid, { Color = C.Wood }) -- (U9-7 look) the kit's list bar, square ends
	grid:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		S.ViewDirty = true
	end)
	U.Grid = grid
	local empty = Util.Create("Frame", { Name = "Empty", BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 4, Parent = body })
	U.Empty = empty
	U.EmptyText = label(empty, "EmptyText", "Heading", 24, { ZIndex = 5, TextWrapped = true, TextTruncate = Enum.TextTruncate.None })
	U.Clear = CloudUI.Button({
		Name = "ClearButton", Text = "Clear", Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(160, 44), TextSize = 20, ZIndex = 5,
		Callback = function()
			H.clear()
		end,
		Parent = empty,
	})
	U.Hint = label(body, "HintLine", "Heading", 20, {
		Visible = false, ZIndex = 8, BackgroundTransparency = 0, BackgroundColor3 = C.Navy, TextColor3 = C.Stone, TextWrapped = true,
	})
	H.edge(U.Hint, C.Wood, 3) -- (kit-b U9-5) a small navy sign
	U.Cache = Util.Create("Frame", { Name = "ViewCache", BackgroundTransparency = 1, Visible = false, Size = UDim2.fromOffset(10, 10), Parent = holder })
	-- the cursor is free while the sheet is shown (client/MouseLock, as the Pets window)
	local mouseLock = Client:FindFirstChild("MouseLock")
	local okLock, lock = pcall(function()
		return mouseLock and require(mouseLock)
	end)
	if okLock and type(lock) == "table" and type(lock.WatchVisible) == "function" then
		safe("mouse lock", lock.WatchVisible, "Dock:" .. holder.Name, holder)
	end
end

function H.newCard(key)
	local item = { Key = key }
	local b = Util.Create("TextButton", {
		Name = "Card_" .. key, Text = "", AutoButtonColor = false, BorderSizePixel = 0, BackgroundColor3 = C.Tile, ZIndex = 3, Parent = U.Grid,
	})
	item.Button = b
	-- (kit-b U9-5) the pitch's .pc: a stone tile, the rarity on its lip (H.paintCard), the pet in a light well; selected = the
	-- gold-tinted face and the ink edge (was a neon gradient card with a rarity border)
	item.Stroke, item.Lip = CloudUI.SignBlock(b, "Stone", { LipPx = K.CARD_LIP, Pad = false })
	item.Art = Util.Create("Frame", { Name = "Art", BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell, BorderSizePixel = 0, ZIndex = 3, Parent = b })
	item.Level = label(b, "Level", "Heading", 18, {
		ZIndex = 5, RichText = true, BackgroundTransparency = 0, BackgroundColor3 = C.Count, TextTruncate = Enum.TextTruncate.None,
	})
	H.edge(item.Level, C.Wood, 2)
	item.Badge = label(b, "Badge", "Heading", 18, { ZIndex = 5, BackgroundTransparency = 1, TextTruncate = Enum.TextTruncate.None })
	item.BadgeEdge = H.edge(item.Badge, C.Wood, 2)
	item.Name = label(b, "Name", "Button", 18, { ZIndex = 5 })
	item.Rarity = label(b, "Rarity", "Label", 18, { ZIndex = 5, TextColor3 = C.Muted })
	item.Chip = label(b, "TrainChip", "Heading", 18, {
		ZIndex = 6, Visible = false, BackgroundTransparency = 0, BackgroundColor3 = C.Purple, TextTruncate = Enum.TextTruncate.None,
	})
	H.edge(item.Chip, C.Wood, 2)
	-- dimmed / blocked: a sunk stone cover (the word in brown on it)
	item.Shade = Util.Create("Frame", {
		Name = "Shade", BackgroundColor3 = C.Well, BackgroundTransparency = 0.45, BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 7, Parent = b,
	})
	item.Word = label(item.Shade, "BlockWord", "Heading", 18, { ZIndex = 8, Visible = false, Size = UDim2.fromScale(1, 1) })
	b.Activated:Connect(function()
		PetPicker.Pick(key)
	end)
	U.Cards[key] = item
	return item
end

function H.dropView(key)
	local v = U.Views[key]
	if v then
		U.Views[key] = nil
		pcall(v.Handle.Destroy)
	end
end

----------------------------------------------------------------------
-- Text fit (TextService: the real font)
----------------------------------------------------------------------
function H.width(text, size, font)
	local plain = tostring(text):gsub("<[^>]*>", "")
	local ok, v = pcall(function()
		return Theme.Measure(plain, font, size, 4096)
	end)
	if ok and typeof(v) == "Vector2" then
		return v.X
	end
	return #plain * size * 0.55
end

-- the first text that fits `width` at a size from maxSize down to minSize; the last text at minSize when none does
function H.fit(lbl, texts, width, maxSize, minSize)
	-- (kit-b U9-5) a capitals role (a title, a tag) is measured as it shows: in capitals
	local role = lbl:GetAttribute("FontRole")
	local caps = role ~= nil and Theme.CapsRoles[role] == true
	for _, t in ipairs(texts) do
		local size = maxSize
		while size >= minSize do
			if H.width(caps and Theme.Caps(t) or t, size, Theme.FontOf(lbl)) <= width then
				lbl.Text, lbl.TextSize = t, size
				return
			end
			size = size - 1
		end
	end
	lbl.Text, lbl.TextSize = texts[#texts], minSize
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
function H.metrics()
	return S.Mode == "Phone" and K.PHONE or K.PC
end

function H.inset()
	local inset = 58
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- the filter chips this layout shows for the context
function H.chipIds()
	local out = {}
	for i, f in ipairs(PetPicker.Filters[S.Context] or {}) do
		if not (S.Mode == "Phone" and i > K.PHONE_FILTERS) then
			out[#out + 1] = f.Id
		end
	end
	return out
end

function H.chipWidth(id, M)
	local base = K.CHIP_W[S.Mode == "Phone" and "Phone" or "PC"][id] or 90
	return math.max(base, math.ceil(H.width(FILTER_LABELS[id], M.ChipText, Theme.Fonts.Button)) + 24)
end

function H.layout()
	if not S.Built then
		return
	end
	local r = NeonKit.BigRect(K)
	S.Mode, S.Scale = r.mode, r.scale
	local phone = r.mode == "Phone"
	local M = H.metrics()
	local W = math.floor(r.w / r.scale + 0.5)
	local Hh = math.floor(r.h / r.scale + 0.5)
	place(U.Holder, r.x, r.y, W, Hh)
	U.Fit.Scale = r.scale
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1920, 1080)
	local inset = H.inset()
	place(U.Shade, 0, inset, vp.X, math.max(0, vp.Y - inset))
	-- header
	place(U.Header, 0, 0, W, M.Header)
	place(U.HeaderFoot, 0, M.Header - 5, W, 5) -- (kit-b U9-5) the plank's darker lip
	U.Roof.Visible = not phone -- (kit-b U9-5) a phone sheet sits right under Roblox's top bar: no awning stub
	place(U.Icon, M.HeadPad, (M.Header - M.Icon) / 2, M.Icon, M.Icon)
	SignKit.IconSlot(U.Icon, nil, M.IconPx)
	place(U.Close, W - M.HeadPad - M.Close, M.CloseY, M.Close, M.Close) -- (its drawn X scales with it)
	local titleX = M.HeadPad + M.Icon + 12
	local titleW = W - titleX - M.Close - 2 * M.HeadPad
	place(U.Title, titleX, 6, titleW, M.Header - 12) -- (kit-b U9-5) 6 px in top and bottom: the ribbon lifts its letters (Drop), their box stays on the plank
	H.fit(U.Title, { U.Title.Text }, titleW - 4, M.TitleText, M.TitleMin) -- (kit-b U9-5) 2 px each side for its outline
	-- body
	local bodyH = Hh - M.Header
	place(U.Body, 0, M.Header, W, bodyH)
	local chips = H.chipIds()
	local shownChip = {}
	for _, id in ipairs(chips) do
		shownChip[id] = true
	end
	for _, id in ipairs(FILTER_IDS) do
		U.Chips[id].Button.Visible = shownChip[id] == true
	end
	local refilter = false
	if not shownChip[S.Filter[S.Context]] then
		S.Filter[S.Context] = "All" -- the phone hides that chip: show everything rather than an unseen filter
		refilter = true
	end
	U.Search.TextSize = M.SearchText
	U.Search.PlaceholderText = phone and "Search" or "Search pets"
	U.SearchPad.PaddingLeft = UDim.new(0, phone and 34 or 50)
	place(U.Glass, phone and -28 or -42, 0, phone and 24 or 34, M.Row)
	U.Glass.TextSize = phone and 16 or 24
	local gridY
	if phone then
		-- one flowing row (it wraps where the box is narrower; portrait: the search alone on the first row)
		local items = { { U.Search, r.portrait and (W - 2 * M.Pad) or M.SearchW, M.Gap }, { U.Sort, M.SortW, M.Gap } }
		for _, id in ipairs(chips) do
			items[#items + 1] = { U.Chips[id].Button, H.chipWidth(id, M), M.ChipGap }
		end
		local x, y = M.Pad, M.RowY
		for _, it in ipairs(items) do
			if x > M.Pad and x + it[2] > W - M.Pad then
				x, y = M.Pad, y + M.Row + M.RowGap
			end
			place(it[1], x, y, it[2], M.Row)
			x = x + it[2] + it[3]
		end
		gridY = y + M.Row + M.GridGap
	else
		place(U.Search, M.Pad, M.RowY, M.SearchW, M.Row)
		local sortX = M.Pad + M.SearchW + M.Gap
		place(U.Sort, sortX, M.RowY, M.SortW, M.Row)
		local total = 0
		for i, id in ipairs(chips) do
			total = total + H.chipWidth(id, M) + (i > 1 and M.ChipGap or 0)
		end
		local x = sortX + M.SortW + M.Gap
		local y = M.RowY + (M.Row - M.ChipH) / 2
		gridY = M.GridY1
		if x + total > W - M.ChipEnd then
			x, y, gridY = M.Pad, M.Row2Y, M.GridY2
		end
		for _, id in ipairs(chips) do
			local w = H.chipWidth(id, M)
			if x > M.Pad and x + w > W - M.Pad then
				x, y = M.Pad, y + M.ChipH + 10
				gridY = y + M.ChipH + 24
			end
			place(U.Chips[id].Button, x, y, w, M.ChipH)
			x = x + w + M.ChipGap
		end
	end
	for _, id in ipairs(FILTER_IDS) do
		U.Chips[id].Button.TextSize = M.ChipText
	end
	local gridH = math.max(M.CardH, bodyH - gridY - M.Pad)
	place(U.Grid, M.Pad, gridY, W - 2 * M.Pad, gridH)
	U.Grid.ScrollBarThickness = M.Scroll
	place(U.Empty, M.Pad, gridY, W - 2 * M.Pad, gridH)
	place(U.EmptyText, 10, math.max(0, gridH / 2 - M.Empty * 2 - 10), W - 2 * M.Pad - 20, M.Empty * 3)
	U.EmptyText.TextSize = M.Empty
	place(U.Clear, (W - 2 * M.Pad - M.ClearW) / 2, math.max(0, gridH / 2 + M.Empty), M.ClearW, M.ClearH)
	U.Clear.TextSize = phone and 18 or 22
	local hintH = phone and 30 or 40
	place(U.Hint, M.Pad + 20, bodyH - hintH - 8, W - 2 * M.Pad - 40, hintH)
	U.Hint.TextSize = M.Hint
	H.paintSort()
	if refilter then
		H.relist(true)
	else
		H.layoutCards()
	end
end

-- the inside of one card at its size
function H.layoutCard(item, w, h, M)
	local phone = S.Mode == "Phone"
	local pad = phone and 4 or 8
	local text = M.Text
	local nameY, nameSize = h - M.NameH - (phone and 4 or 40), M.NameText or text
	-- (LOOK-ui2: a small centred square with "Lv 22" half on it and half on the stone) the Pets grid card's light well:
	-- 4 px inside the edge, the card's whole inner width, down to 4 px over the name; the tags 3 px inside its top corners
	place(item.Art, 4, 4, w - 8, math.max(24, nameY - 8))
	local tagIn = 4 + 3
	item.Level.TextSize = text
	local stars = tonumber(item.Level:GetAttribute("Stars")) or 0 -- (kit-b U7b) the stars drawn after the text
	local lw = math.min(w - 2 * tagIn, H.width(item.Level.Text, text, Theme.FontOf(item.Level)) + (phone and 12 or 16) + (stars > 0 and (stars * LEVEL_STAR + 4) or 0))
	place(item.Level, tagIn, tagIn, lw, M.ChipRowH)
	local bw = M.ChipRowH
	local starBadge = item.Badge:GetAttribute("HostMark") ~= nil and item.Badge:GetAttribute("HostMark") ~= ""
	if not starBadge then
		bw = H.width(item.Badge.Text, text, Theme.FontOf(item.Badge)) + (phone and 12 or 16)
	end
	place(item.Badge, w - tagIn - bw, tagIn, bw, M.ChipRowH)
	item.Badge.TextSize = starBadge and (phone and 18 or 24) or text
	place(item.Name, pad, nameY, w - 2 * pad, M.NameH)
	H.fit(item.Name, item.Names or { "" }, w - 2 * pad - 4, nameSize, nameSize)
	item.Rarity.Visible = not phone
	place(item.Rarity, pad, h - (M.RarityH or 0) - 12, w - 2 * pad, M.RarityH or 0)
	item.Rarity.TextSize = text
	place(item.Chip, phone and 4 or 10, nameY - M.ChipRowH - (phone and 0 or 4), w - (phone and 8 or 20), M.ChipRowH)
	item.Chip.TextSize = text
	item.Word.TextSize = M.Block
end

-- positions the shown cards in rows filling the grid's width; the canvas follows
function H.layoutCards()
	local M = H.metrics()
	local inset = K.GRID_INSET
	local gw = U.Grid.Size.X.Offset - M.Scroll - 2 - 2 * inset
	local gap = M.CardGap
	local n = math.max(1, math.floor((gw + gap) / (M.CardW + gap)))
	local cw = math.floor((gw - (n - 1) * gap) / n)
	local ch = M.CardH
	S.PerRow, S.CardW = n, cw
	for i, key in ipairs(S.Order) do
		local item = U.Cards[key]
		if item then
			local row, col = math.floor((i - 1) / n), (i - 1) % n
			place(item.Button, inset + col * (cw + gap), inset + row * (ch + gap), cw, ch)
			H.layoutCard(item, cw, ch, M)
		end
	end
	local rows = math.ceil(#S.Order / n)
	U.Grid.CanvasSize = UDim2.fromOffset(0, math.max(0, rows * (ch + gap) - gap + 2 * inset))
	S.ViewDirty = true
end

----------------------------------------------------------------------
-- Cards
----------------------------------------------------------------------
-- "Lv 34" and its evolution stars (0-2), drawn after it as gold PixelIcons (kit-b U7b)
function H.levelText(e)
	return "Lv " .. tostring(e.Level), math.min(2, math.max(0, tonumber(e.Stage) or 0))
end

function H.jobText(job)
	return "Training " .. Bits.jobLeft(job)
end

-- (playtest 2026-11-28 C40) "Twilight Dragon" -> "T. Dragon" (every word but the last as its initial); nil for one word
function H.initialed(name)
	local words = {}
	for word in tostring(name or ""):gmatch("%S+") do
		words[#words + 1] = word
	end
	if #words < 2 then
		return nil
	end
	local out = {}
	for i = 1, #words - 1 do
		out[i] = (words[i]:match("^[%w]") or words[i]:sub(1, 1)) .. "."
	end
	return table.concat(out, " ") .. " " .. words[#words]
end

function H.paintCard(item, e)
	local ctx = S.Context
	local tint = CloudUI.RarityColor(e.Rarity)
	local selected = S.Selected == e.Key
	-- (kit-b U9-5) the rarity on the lip; the selected card's gold-tinted face and ink edge
	item.Lip.BackgroundColor3 = tint
	item.Button.BackgroundColor3 = selected and SIGN.Selected or C.Tile
	item.Stroke.Color = selected and C.Ink or C.Wood
	item.Stroke.Thickness = selected and 4 or 3
	item.Button:SetAttribute("Selected", selected)
	-- the name, then (a Golden / Rainbow copy) its finish + last word, then the last word
	-- (playtest 2026-11-28 C40) and before the last word alone, the initials + last word ('T. Dragon'): 'Dragon' sat
	-- beside 'Cloudy Dragon' with nothing to tell which dragon
	local last = string.match(e.Name, "(%S+)%s*$") or e.Name
	local tier = not e.Hybrid and Bits.tierOf(e.Key, e.Def) or "Normal"
	item.Names = { e.Name }
	-- (C40 review) a Golden / Rainbow copy keeps its finish and its initials first ('Golden C. Dragon'): 'Golden Dragon'
	-- dropped 'Cloudy' and the initials of the whole name lost the finish ('G. C. Dragon')
	local base = tier ~= "Normal" and (e.Name:gsub("^" .. tier .. "%s+", "")) or e.Name
	local short = H.initialed(base)
	if tier ~= "Normal" then
		if short then
			item.Names[#item.Names + 1] = tier .. " " .. short
		end
		item.Names[#item.Names + 1] = tier .. " " .. last
	end
	item.Names[#item.Names + 1] = short
	item.Names[#item.Names + 1] = last
	local levelText, stars = H.levelText(e)
	item.Level.Text = levelText
	item.Level:SetAttribute("Stars", stars)
	PixelIcon.Mark(item.Level, stars > 0 and ICON.Star or nil, { After = true, Count = stars, Of = stars, Colour = C.GoldInk, Px = 18 })
	item.Rarity.Text = tostring(e.Rarity or "")
	-- the corner badge (kit-b U9-5: a team member's gold square with the brown star; a count on a stone tag, green when Ready)
	local badge = item.Badge
	if ctx == "Train" then
		badge.Visible = e.Team ~= nil
		badge.TextColor3 = C.Ink
		PixelIcon.Set(badge, ICON.Star) -- (kit-b U7b) a team member
		badge.BackgroundTransparency = 0
		badge.BackgroundColor3 = C.Gold
	else
		badge.Visible = true
		PixelIcon.Set(badge, nil)
		badge.Text = "x" .. tostring(e.Copies)
		badge.TextColor3 = e.Ready and SIGN.OnGrass or C.Ink
		badge.BackgroundTransparency = 0
		badge.BackgroundColor3 = e.Ready and C.Ready or C.Count
	end
	item.Button:SetAttribute("Ready", e.Ready == true)
	-- the Training chip (Train)
	item.Job = (ctx == "Train") and e.Job or nil
	item.Chip.Visible = item.Job ~= nil
	if item.Job then
		item.Chip.Text = H.jobText(item.Job)
	end
	-- dimmed (Upgrade: fewer copies than a fusion takes) / blocked (with its word)
	local blocked = e.Blocked
	local dim = ctx == "Upgrade" and not e.Ready
	item.Button:SetAttribute("Blocked", blocked)
	item.Button:SetAttribute("Dim", dim)
	item.Shade.Visible = dim or blocked ~= nil
	item.Shade.BackgroundTransparency = blocked and 0.3 or 0.5
	item.Word.Visible = blocked ~= nil
	item.Word.Text = blocked or ""
	item.Stage = e.Stage
	item.Def = e.Def
end

-- re-reads the entries, the order and the cards (resetScroll: back to the top)
function H.relist(resetScroll)
	if not S.Built or not S.Context then
		return
	end
	local ctx = S.Context
	local entries = PetPicker.Entries(ctx)
	local spec = S.Spec or {}
	local owned = {}
	S.ByKey = {}
	for _, e in ipairs(entries) do
		if type(spec.Blocked) == "table" and type(spec.Blocked[e.Key]) == "string" then
			e.Blocked = spec.Blocked[e.Key]
		end
		S.ByKey[e.Key] = e
		owned[e.Key] = true
	end
	if S.Selected and not owned[S.Selected] then
		S.Selected = nil
	end
	-- a key that left the collection (or this context) loses its card; its viewport stays cached while the pet is owned
	for key, item in pairs(U.Cards) do
		if not owned[key] then
			local v = U.Views[key]
			if v and State.OwnedCount(key) > 0 then
				v.Handle.Frame.Parent = U.Cache
			elseif v then
				H.dropView(key)
			end
			U.Cards[key] = nil
			item.Button:Destroy()
		end
	end
	local order = PetPicker.Sorted(ctx, entries, S.Sort[ctx], S.Filter[ctx], S.Query)
	S.Order, S.Shown = {}, {}
	for i, e in ipairs(order) do
		S.Order[i] = e.Key
		S.Shown[e.Key] = true
		H.paintCard(U.Cards[e.Key] or H.newCard(e.Key), e)
	end
	for key, item in pairs(U.Cards) do
		item.Button.Visible = S.Shown[key] == true
	end
	for key, v in pairs(U.Views) do
		if not S.Shown[key] and v.Handle.Frame.Parent ~= U.Cache then
			v.Handle.Frame.Parent = U.Cache
		end
	end
	U.Empty.Visible = #order == 0
	U.Clear.Visible = #entries > 0
	U.EmptyText.Text = #entries > 0 and "No pets match." or "No pets yet! Spin a roulette in the Shop to hatch one."
	H.paintChips()
	H.layoutCards()
	if resetScroll then
		U.Grid.CanvasPosition = Vector2.new(0, 0)
	end
end

function H.paintChips()
	local active = S.Filter[S.Context]
	for id, chip in pairs(U.Chips) do
		local on = id == active
		chip.Button:SetAttribute("Selected", on)
		CloudUI.SignBlock(chip.Button, on and "Selected" or "Stone", { LipPx = 4 }) -- (kit-b U9-5) gold = selected
		if chip.Glyphs then
			chip.Glyphs.Transparency = 1
		end
	end
end

function H.sortLabel()
	for _, s in ipairs(PetPicker.Sorts[S.Context] or {}) do
		if s.Id == S.Sort[S.Context] then
			return s.Label
		end
	end
	return ""
end

function H.paintSort()
	if not S.Context then
		return
	end
	local M = H.metrics()
	local name = H.sortLabel()
	local short = SHORT[name] or name
	-- (kit-b U7b) the arrow is a PixelIcon after the text (18 px + its gap)
	H.fit(U.Sort, { "Sort: " .. name, "Sort: " .. short, short }, M.SortW - 22 - 22, M.SortText, M.SortMin)
	PixelIcon.Mark(U.Sort, ICON.Down, { After = true, Px = 18 })
	H.lipFlush(U.Sort)
end

-- (LOOK-ui2: the Sort lip stopped 22 px short of the right edge) a UIPadding lays out the plank's Lip too: once a trailing
-- icon widened PaddingRight the lip reaches back out by the padding, flush on the wood edge as CloudUI.SignBlock sets it
function H.lipFlush(obj)
	local lip = obj:FindFirstChild("Lip")
	local pad = obj:FindFirstChildOfClass("UIPadding")
	if not (lip and pad) then
		return
	end
	local pl, pr, pb = pad.PaddingLeft.Offset, pad.PaddingRight.Offset, pad.PaddingBottom.Offset
	lip.Position = UDim2.new(0, -pl, 1, pb)
	lip.Size = UDim2.new(1, pl + pr, 0, lip.Size.Y.Offset)
end

function H.cycleSort()
	local list = PetPicker.Sorts[S.Context]
	if not list then
		return
	end
	local at = 1
	for i, s in ipairs(list) do
		if s.Id == S.Sort[S.Context] then
			at = i
		end
	end
	PetPicker.SetSort(list[at % #list + 1].Id)
end

function H.clear()
	S.Filter[S.Context] = "All"
	S.Silent = true
	U.Search.Text = ""
	S.Silent = false
	S.Query = ""
	H.relist(true)
end

function H.hint(message)
	S.HintToken = S.HintToken + 1
	local mine = S.HintToken
	U.Hint.Text = message
	U.Hint.Visible = true
	task.delay(K.HINT_SECONDS, function()
		if S.HintToken == mine and U.Hint then
			U.Hint.Visible = false
		end
	end)
end

function H.blockedHint(e)
	if e.Blocked == "Training" then
		return e.Name .. " is training: wait for it to finish"
	elseif e.Blocked == "In Body" or e.Blocked == "In Style" then
		return e.Name .. " is already in the other slot"
	end
	return e.Name .. " can't be picked here"
end

-- the selected card's row comes into view
function H.scrollToSelected()
	local M = H.metrics()
	for i, key in ipairs(S.Order) do
		if key == S.Selected then
			local top = K.GRID_INSET + math.floor((i - 1) / math.max(1, S.PerRow or 1)) * (M.CardH + M.CardGap)
			if top + M.CardH > U.Grid.Size.Y.Offset then
				U.Grid.CanvasPosition = Vector2.new(0, top * S.Scale)
			end
			return
		end
	end
end

----------------------------------------------------------------------
-- Viewports (one Heartbeat while open)
----------------------------------------------------------------------
function H.trimCache()
	local n = 0
	for _ in pairs(U.Views) do
		n = n + 1
	end
	if n <= K.CACHE_MAX then
		return
	end
	for key, v in pairs(U.Views) do
		if n <= K.CACHE_MAX then
			break
		end
		if v.Handle.Frame.Parent == U.Cache then
			H.dropView(key)
			n = n - 1
		end
	end
end

function H.fill()
	local gp, gs = U.Grid.AbsolutePosition, U.Grid.AbsoluteSize
	local top, bottom = gp.Y, gp.Y + gs.Y
	local started = os.clock()
	local built, pending = 0, false
	for _, key in ipairs(S.Order) do
		local item = U.Cards[key]
		if item then
			local p, s = item.Button.AbsolutePosition, item.Button.AbsoluteSize
			local inView = gs.Y > 0 and p.Y + s.Y > top + 0.5 and p.Y < bottom - 0.5
			local v = U.Views[key]
			if inView then
				if v and v.Stage == item.Stage then
					if v.Handle.Frame.Parent ~= item.Art then
						v.Handle.Frame.Parent = item.Art
					end
				elseif built >= K.BUILD_MAX or (built > 0 and os.clock() - started >= K.BUILD_BUDGET) then
					pending = true
				else
					H.dropView(key)
					built = built + 1
					local stage = item.Stage or 0
					local ok, handle = pcall(CloudUI.PetViewport, item.Art, item.Def, UDim2.fromScale(1, 1), {
						Detail = "Low", Spin = "sway", Animate = false, Evolved = stage >= 1 and stage or nil, ZIndex = 4,
					})
					if ok and handle then
						U.Views[key] = { Handle = handle, Stage = stage }
					else
						warnOnce("viewport", handle)
					end
				end
			elseif v and v.Handle.Frame.Parent == item.Art then
				v.Handle.Frame.Parent = U.Cache
			end
		end
	end
	S.ViewDirty = pending
	H.trimCache()
end

function H.step(dt)
	if not S.Open then
		return
	end
	if S.ViewDirty then
		safe("viewports", H.fill)
	end
	S.TickAcc = S.TickAcc + (tonumber(dt) or 0)
	if S.TickAcc >= K.TICK then
		S.TickAcc = 0
		for _, key in ipairs(S.Order) do
			local item = U.Cards[key]
			if item and item.Job then
				item.Chip.Text = H.jobText(item.Job)
			end
		end
	end
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
function H.hide()
	S.Open = false
	S.HintToken = S.HintToken + 1
	if U.Holder then
		U.Holder.Visible = false
		U.Shade.Visible = false
		U.Hint.Visible = false
	end
	if S.Beat then
		S.Beat:Disconnect()
		S.Beat = nil
	end
	if S.Tween then
		S.Tween:Cancel()
		S.Tween = nil
	end
end

function PetPicker.Open(spec)
	if type(spec) ~= "table" or not PetPicker.Sorts[spec.Context] then
		return false
	end
	if not H.ensureGui() then
		return false
	end
	if S.Open then
		PetPicker.Close()
	end
	H.build()
	S.Spec = spec
	S.Context = spec.Context
	S.Selected = type(spec.Selected) == "string" and spec.Selected or nil
	S.Query = ""
	S.Silent = true
	U.Search.Text = ""
	S.Silent = false
	-- (kit-b U9-5) one navy plank for every context; the icon tells them apart (LOOK-ui2: in the header's gold square)
	SignKit.IconSlot(U.Icon, ICON.Context[S.Context])
	U.Title.Text = tostring(spec.Title or "Pick a pet")
	S.Open = true
	U.Holder.Visible = true
	U.Shade.Visible = true
	U.Hint.Visible = false
	H.layout()
	H.relist(true)
	H.scrollToSelected()
	S.TickAcc = 0
	if S.Tween then
		S.Tween:Cancel()
	end
	U.Pop.Scale = K.OPEN_FROM
	S.Tween = Util.Tween(U.Pop, K.OPEN_TIME, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	if not S.Beat then
		S.Beat = RunService.Heartbeat:Connect(H.step)
	end
	return true
end

function PetPicker.Close()
	if not S.Open then
		return
	end
	local spec = S.Spec
	H.hide()
	if spec and type(spec.OnClose) == "function" then
		safe("OnClose", spec.OnClose, false)
	end
end

function PetPicker.IsOpen()
	return S.Open
end

function PetPicker.Layout()
	if S.Open then
		return S.Mode
	end
	return NeonKit.BigRect(K).mode
end

function PetPicker.Pick(key)
	if not S.Open or type(key) ~= "string" or not S.Shown[key] then
		return false
	end
	local e = S.ByKey[key]
	if not e or State.OwnedCount(key) < 1 then
		return false
	end
	if e.Blocked then
		H.hint(H.blockedHint(e))
		return false
	end
	local spec = S.Spec
	H.hide()
	if type(spec.OnClose) == "function" then
		safe("OnClose", spec.OnClose, true)
	end
	if type(spec.OnPick) == "function" then
		safe("OnPick", spec.OnPick, key)
	end
	return true
end

function PetPicker.Shown()
	local out = {}
	for i, key in ipairs(S.Order) do
		out[i] = key
	end
	return out
end

function PetPicker.SetQuery(text)
	if not S.Open then
		return
	end
	U.Search.Text = tostring(text or "")
end

function PetPicker.SetSort(id)
	local ctx = S.Context
	if ctx and H.valid(PetPicker.Sorts[ctx], id) then
		S.Sort[ctx] = id
		if S.Open then
			H.paintSort()
			H.relist(true)
		end
	end
end

function PetPicker.SetFilter(id)
	local ctx = S.Context
	if ctx and H.valid(PetPicker.Filters[ctx], id) then
		S.Filter[ctx] = id
		if S.Open then
			H.relist(true)
		end
	end
end

return PetPicker
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1196">
            <Properties>
              <string name="Name">PixelCrisp</string>
              <string name="Source"><![CDATA[-- PixelCrisp (kit B U9-9; the owner's look bar of 2026-11-17: "pixel icons and pixel edges snapped to whole pixels at
-- every screen size, one pixel size per screen, no blurry up-scaled pixels"). The side cards (toasts, the tutorial card,
-- the NPC dialog) are designed in 1080p px under a UIScale of Theme.ScreenFactor() or a fitted scale (0.7 .. 1.25), so a
-- 2 px icon cell would land on 1.6 or 2.5 screen px and draw uneven. Here an icon's holder carries the correction:
--   PixelCrisp.Icon(parent, name, px, colour[, opts]) -> holder, glyph
--        holder: a Frame px x px (design px, AnchorPoint 0.5 at the centre of its parent unless opts.Position /
--        opts.AnchorPoint) with a UIScale "Crisp" = c / (cell * k), k = the product of the UIScales above it, cell = the
--        icon's design cell (floor(px / 9)), c = round(cell * k): each of the 9 cells is c whole screen px. (U9-9 look) A
--        2 px cell never drops to 1 px (c >= 2): an 18 px icon is 18 screen px on every phone, as the top bar's, so a
--        screen has one pixel size (a card shrunk to 0.7 keeps 18 / k design px for the icon's slot). Its top-left lands on
--        a whole screen px too (Box).
--        glyph: a TextLabel filling the holder with no text whose icon is PixelIcon.Host'ed, so a caller fades or tints
--        the icon through glyph.TextTransparency / TextColor3 as it did a letter. opts: ZIndex, Name, Position, AnchorPoint
--   PixelCrisp.Adopt(frame[, cell])  the same correction on an icon Frame PixelIcon drew itself (PixelIcon.Lead's box, the
--                                icon PixelIcon.Host returns) or on any little pixel drawing in cells of `cell` design px
--                                (the NPC's stepped tail, a rivet), in place: a UIScale "Crisp" on it (it grows round its
--                                AnchorPoint); cell defaults to its height / 9. Returns the frame
--   PixelCrisp.Edge(stroke, px)  a border UIStroke of px design px that Refresh keeps at round(px * k) whole screen px
--                                (>= 2 for an edge of 2 design px or more)
--   PixelCrisp.Lip(lip, px)      (U9-9 look) a block's bottom lip (a Frame anchored 0, 1 at the bottom of its block, Size
--                                (1, 0, 0, px)) kept at round(px * k) whole screen px (>= 2 for 2 px or more): a UIScale
--                                "Crisp" on the lip (it grows round its bottom-left corner) and the width's scale undone,
--                                so the lip stays flush with its block. Returns the lip
--   PixelCrisp.Box(frame)        (U9-9 look) the frame's drawn top-left on a whole screen px, measured from its crisp
--                                root (or the screen): a correction in its Position's Scale (Roblox keeps a UDim's Offset
--                                whole, so a 0.4 px nudge cannot go there), kept apart from the caller's own Position. When
--                                the caller (or PixelIcon.Lead) moves the frame again it is snapped again. A frame a
--                                UIListLayout / UIGridLayout places is left alone. Icons and Adopted frames are Boxes too.
--                                (U9-9 look 2) Its right and bottom edges too: a correction in its Size's Scale (any card
--                                scale, a fitted 0.724 as well), so a block, the stone inside its wood frame and a plank are
--                                whole px on all four sides; not for a frame with its own UIScale or an AutomaticSize. Box
--                                the parents with the children: a block lies on whole px of its parent's snapped box
--   PixelCrisp.Root(frame)       (U9-9 look) marks a frame its owner keeps on a whole screen px at rest (a card's root, a
--                                toast that slides in, a dialog's slide): the Boxes under it snap relative to it, so a
--                                slide or a tween of the root never leaves them half a pixel off
--   PixelCrisp.Refresh(root)     re-snaps every holder, edge, lip and box under root (root included): call it after a scale
--                                above them changed (a relayout)
--   PixelCrisp.ScaleAbove(obj) -> k  the product of the UIScales on obj's ancestors (obj's own UIScale not counted)
--   PixelCrisp.Cell(holder) -> c  the screen px of one cell after the last snap
--   PixelCrisp.Px(px, k) -> n     the whole screen px a part of px design px takes at scale k (>= 2 for 2 px or more)
--   PixelCrisp.Len(px, k) -> n    the smallest whole design length >= px that is whole screen px at scale k (a block's
--                                height picked so its edges land on whole px: 28 -> 30 at 0.8)
-- Plain Lua 5.1-compatible syntax only.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local PixelIcon = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("PixelIcon"))

local PixelCrisp = {}

local function round(x)
	return math.floor(x + 0.5)
end

-- the whole screen px of a part of px design px at scale k: never under 2 for a part of 2 px or more (a 2 px cell or edge
-- that dropped to 1 px drew a second pixel size on the screen), never under 1
function PixelCrisp.Px(px, k)
	return math.max(px >= 2 and 2 or 1, round(px * k))
end
local wholePx = PixelCrisp.Px

-- the smallest whole design length >= px that lands on whole screen px at scale k (a UDim's Offset is whole in Roblox, so a
-- block's height is picked, not nudged: 28 -> 30 at 0.8); px itself when none does within 20 design px
function PixelCrisp.Len(px, k)
	local n = math.ceil(px - 1e-6)
	for add = 0, 20 do
		local v = (n + add) * k
		if math.abs(v - round(v)) < 1e-4 then
			return n + add
		end
	end
	return n
end

local function ownScale(obj)
	for _, c in ipairs(obj:GetChildren()) do
		if c:IsA("UIScale") then
			return c
		end
	end
	return nil
end

function PixelCrisp.ScaleAbove(obj)
	local k = 1
	local cur = obj and obj.Parent
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") then
			local s = ownScale(cur)
			if s and s.Scale > 0 then
				k = k * s.Scale
			end
		end
		cur = cur.Parent
	end
	return k
end

----------------------------------------------------------------------
-- origins (Box, Root)
----------------------------------------------------------------------
-- the nearest crisp root above obj (nil: the screen)
local function rootOf(obj)
	local cur = obj.Parent
	while cur and not cur:IsA("LayerCollector") do
		if cur:GetAttribute("CrispRoot") == true then
			return cur
		end
		cur = cur.Parent
	end
	return nil
end

-- the box a child of `parent` is placed in, in screen px: its AbsoluteSize less its UIPadding
local function contentSize(parent)
	local s = parent.AbsoluteSize
	local w, h = s.X, s.Y
	local pad = parent:FindFirstChildOfClass("UIPadding")
	if pad then
		local own = parent:IsA("GuiObject") and ownScale(parent) or nil
		local k = PixelCrisp.ScaleAbove(parent) * (own and own.Scale or 1)
		w = w - (pad.PaddingLeft.Scale + pad.PaddingRight.Scale) * s.X - (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) * k
		h = h - (pad.PaddingTop.Scale + pad.PaddingBottom.Scale) * s.Y - (pad.PaddingTop.Offset + pad.PaddingBottom.Offset) * k
	end
	return w, h
end

-- a UIListLayout / UIGridLayout of its parent places obj (its Position is not used)
local function laidOut(obj)
	local p = obj.Parent
	return p ~= nil and (p:FindFirstChildOfClass("UIListLayout") ~= nil or p:FindFirstChildOfClass("UIGridLayout") ~= nil)
end

local watched = setmetatable({}, { __mode = "k" }) -- [frame] = true once its Position is watched

-- (U9-9 look 2) a Box's size is snapped too: its right and bottom edges on whole px as well as its top-left (a block of
-- 104 x 32 design px at 0.8 drew 83.2 x 25.6, one side crisp and the other soft). Not for a frame that sizes itself (a
-- UIScale of its own: an icon holder, an Adopted drawing; AutomaticSize). A CloudUI plank's hover / press "FxScale" is
-- allowed: it is snapped at rest (Scale 1)
local function sizes(obj)
	if obj:GetAttribute("CrispBox") ~= true or obj.AutomaticSize ~= Enum.AutomaticSize.None then
		return false
	end
	for _, c in ipairs(obj:GetChildren()) do
		if c:IsA("UIScale") and c.Name ~= "FxScale" then
			return false
		end
	end
	return true
end

local function snapOrigin(obj)
	local parent = obj.Parent
	if not (obj:IsA("GuiObject") and parent and parent:IsA("GuiBase2d")) or laidOut(obj) then
		return
	end
	local fx = obj:FindFirstChild("FxScale")
	if fx and fx:IsA("UIScale") and math.abs(fx.Scale - 1) > 1e-6 then
		return -- (a plank mid hover / press: it grows round its anchor; the next snap finds it at rest)
	end
	local pw, ph = contentSize(parent)
	if pw <= 0 or ph <= 0 then
		return
	end
	local p, z = obj.Position, obj.Size
	local sx, sy, wx, wy = 0, 0, 0, 0
	if obj:GetAttribute("CrispAt") == p then
		sx, sy = obj:GetAttribute("CrispSX") or 0, obj:GetAttribute("CrispSY") or 0
	end
	local sizing = sizes(obj)
	if sizing and obj:GetAttribute("CrispSizeAt") == z then
		wx, wy = obj:GetAttribute("CrispWX") or 0, obj:GetAttribute("CrispWY") or 0
	end
	local a, s = obj.AbsolutePosition, obj.AbsoluteSize
	local ax, ay = obj.AnchorPoint.X, obj.AnchorPoint.Y
	local root = rootOf(obj)
	local o = root and root.AbsolutePosition or Vector2.new(0, 0)
	-- where it sits from its root and how big it is without the corrections (a size nudge moves an anchored frame's
	-- top-left by its AnchorPoint's share), then the nudges (in Scale) that put its edges on whole px
	local w0, h0 = s.X - wx * pw, s.Y - wy * ph
	local rx, ry = a.X - o.X - sx * pw + ax * wx * pw, a.Y - o.Y - sy * ph + ay * wy * ph
	local left, top = round(rx), round(ry)
	local nwx, nwy = 0, 0
	if sizing then
		nwx = (round(rx + w0) - left - w0) / pw
		nwy = (round(ry + h0) - top - h0) / ph
	end
	local nx, ny = (left - rx + ax * nwx * pw) / pw, (top - ry + ay * nwy * ph) / ph
	local same = math.abs(nx - sx) < 1e-7 and math.abs(ny - sy) < 1e-7 and obj:GetAttribute("CrispAt") == p
	if sizing then
		same = same and math.abs(nwx - wx) < 1e-7 and math.abs(nwy - wy) < 1e-7 and obj:GetAttribute("CrispSizeAt") == z
	end
	if same then
		return
	end
	if sizing then
		local newSize = UDim2.new(z.X.Scale - wx + nwx, z.X.Offset, z.Y.Scale - wy + nwy, z.Y.Offset)
		obj:SetAttribute("CrispWX", nwx)
		obj:SetAttribute("CrispWY", nwy)
		obj:SetAttribute("CrispSizeAt", newSize) -- (before the write: a watcher that runs at once sees it done)
		if newSize ~= z then
			obj.Size = newSize
		end
		obj:SetAttribute("CrispSizeAt", obj.Size)
	end
	local new = UDim2.new(p.X.Scale - sx + nx, p.X.Offset, p.Y.Scale - sy + ny, p.Y.Offset)
	obj:SetAttribute("CrispSX", nx)
	obj:SetAttribute("CrispSY", ny)
	obj:SetAttribute("CrispAt", new)
	if new ~= p then
		obj.Position = new
	end
	obj:SetAttribute("CrispAt", obj.Position)
end

local function watch(obj)
	if watched[obj] then
		return
	end
	watched[obj] = true
	-- the caller (a layout, PixelIcon.Lead's place) moved it: snap again from its new Position
	obj:GetPropertyChangedSignal("Position"):Connect(function()
		if obj:GetAttribute("CrispAt") ~= obj.Position and obj.Parent then
			snapOrigin(obj)
		end
	end)
	-- (U9-9 look 2) or resized a Box: its new Size is the caller's own, snapped again
	obj:GetPropertyChangedSignal("Size"):Connect(function()
		if sizes(obj) and obj:GetAttribute("CrispSizeAt") ~= obj.Size and obj.Parent then
			snapOrigin(obj)
		end
	end)
end

function PixelCrisp.Box(frame)
	if frame and frame:IsA("GuiObject") then
		frame:SetAttribute("CrispBox", true)
		watch(frame)
		snapOrigin(frame)
	end
	return frame
end

function PixelCrisp.Root(frame)
	if frame then
		frame:SetAttribute("CrispRoot", true)
	end
	return frame
end

----------------------------------------------------------------------
-- cells, edges, lips
----------------------------------------------------------------------
local function snapHolder(holder)
	local cell = holder:GetAttribute("CrispCell")
	local scale = holder:FindFirstChild("Crisp")
	if type(cell) ~= "number" or cell <= 0 or not scale then
		return
	end
	local k = PixelCrisp.ScaleAbove(holder)
	local c = wholePx(cell, k)
	scale.Scale = c / (cell * k)
	holder:SetAttribute("CrispPx", c)
	snapOrigin(holder)
end

local function snapEdge(stroke)
	local px = stroke:GetAttribute("CrispEdge")
	local host = stroke.Parent
	if type(px) ~= "number" or not host then
		return
	end
	local k = PixelCrisp.ScaleAbove(host) * (ownScale(host) and ownScale(host).Scale or 1)
	if k <= 0 then
		return
	end
	local t = wholePx(px, k) / k
	stroke:SetAttribute("CrispThick", t) -- (before the write: a watcher that runs at once sees it done)
	if stroke.Thickness ~= t then
		stroke.Thickness = t
	end
end

local function snapLip(lip)
	local px = lip:GetAttribute("CrispLip")
	local scale = lip:FindFirstChild("Crisp")
	if type(px) ~= "number" or px <= 0 or not scale then
		return
	end
	local k = PixelCrisp.ScaleAbove(lip)
	if k <= 0 then
		return
	end
	local s = wholePx(px, k) / (px * k)
	-- its own scale grows its width too: the width is undone in its Scale part (a lip runs its block's whole width; a
	-- padded block's lip, CloudUI.SignBlock's, reaches out over the padding by an Offset, which goes into the Scale too)
	local base = lip:GetAttribute("CrispLipBase")
	if typeof(base) ~= "UDim2" or lip:GetAttribute("CrispLipAt") ~= lip.Size then
		base = lip.Size
		lip:SetAttribute("CrispLipBase", base)
	end
	local want
	if base.X.Offset == 0 then
		want = UDim2.new(base.X.Scale / s, 0, 0, px)
	else
		local pw = lip.Parent and lip.Parent:IsA("GuiBase2d") and contentSize(lip.Parent) or 0
		if pw <= 0 then
			return
		end
		local w = pw * base.X.Scale + base.X.Offset * k
		if lip:GetAttribute("CrispLipWhole") == true then
			-- (U9-9 look 2) a free line (a link's underline, its width from its words): its drawn width a whole px too
			w = math.max(1, math.floor(w + 0.5))
		end
		want = UDim2.new(w / (pw * s), 0, 0, px)
	end
	scale.Scale = s
	lip:SetAttribute("CrispLipAt", want) -- (before the write: a watcher that runs at once sees it done)
	if lip.Size ~= want then
		lip.Size = want
	end
	lip:SetAttribute("CrispLipAt", lip.Size)
end

function PixelCrisp.Icon(parent, name, px, colour, opts)
	opts = opts or {}
	px = PixelIcon.Snap(px)
	local holder = Instance.new("Frame")
	holder.Name = opts.Name or "Crisp"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(px, px)
	holder.AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5)
	holder.Position = opts.Position or UDim2.fromScale(0.5, 0.5)
	holder.ZIndex = opts.ZIndex or 1
	holder:SetAttribute("CrispCell", math.floor(px / 9))
	local scale = Instance.new("UIScale")
	scale.Name = "Crisp"
	scale.Parent = holder
	local glyph = Instance.new("TextLabel")
	glyph.Name = "Glyph"
	glyph.BackgroundTransparency = 1
	glyph.BorderSizePixel = 0
	glyph.Size = UDim2.fromScale(1, 1)
	glyph.Text = ""
	glyph.TextColor3 = colour or Color3.new(1, 1, 1)
	glyph.ZIndex = holder.ZIndex
	glyph.Parent = holder
	glyph:SetAttribute("PixelIcon", name)
	PixelIcon.Host(glyph, name, px)
	holder.Parent = parent
	watch(holder)
	snapHolder(holder)
	return holder, glyph
end

function PixelCrisp.Adopt(frame, cell)
	if not frame then
		return nil
	end
	cell = tonumber(cell) or math.floor(frame.Size.Y.Offset / 9)
	if cell <= 0 then
		return frame
	end
	if not frame:FindFirstChild("Crisp") then
		local scale = Instance.new("UIScale")
		scale.Name = "Crisp"
		scale.Parent = frame
	end
	frame:SetAttribute("CrispCell", cell)
	watch(frame)
	snapHolder(frame)
	-- (merge kitb-look1 x U9-9) PixelIcon fits its icons and Lead boxes to the scales above them: once more with this
	-- correction counted (a Lead box sized before it drew 2.5 px cells), and it watches the correction from now on
	PixelIcon.Refit(frame)
	return frame
end

function PixelCrisp.Edge(stroke, px)
	if stroke then
		stroke:SetAttribute("CrispEdge", tonumber(px) or stroke.Thickness)
		snapEdge(stroke)
		if not watched[stroke] then
			watched[stroke] = true
			-- (U9-9 look) a repaint (CloudUI.SignBlock on a hover or a press) set its design px again: back on whole px
			stroke:GetPropertyChangedSignal("Thickness"):Connect(function()
				local want = stroke:GetAttribute("CrispThick")
				if type(want) ~= "number" or math.abs(stroke.Thickness - want) > 1e-6 then
					stroke:SetAttribute("CrispEdge", stroke.Thickness)
					snapEdge(stroke)
				end
			end)
		end
	end
	return stroke
end

function PixelCrisp.Lip(lip, px)
	if not lip then
		return nil
	end
	px = tonumber(px) or lip.Size.Y.Offset
	if not lip:FindFirstChild("Crisp") then
		local scale = Instance.new("UIScale")
		scale.Name = "Crisp"
		scale.Parent = lip
	end
	lip:SetAttribute("CrispLip", px)
	snapLip(lip)
	if not watched[lip] then
		watched[lip] = true
		-- (U9-9 look) a repaint (a Sign button's press thins its lip) set a new size: its height is the new design px
		lip:GetPropertyChangedSignal("Size"):Connect(function()
			if lip:GetAttribute("CrispLipAt") ~= lip.Size and lip.Parent then
				lip:SetAttribute("CrispLip", lip.Size.Y.Offset)
				snapLip(lip)
			end
		end)
	end
	return lip
end

function PixelCrisp.Refresh(root)
	if not root then
		return
	end
	-- parents before children (GetDescendants walks depth first): a box's place depends on its parent's
	local function one(d)
		if d:IsA("GuiObject") and d:GetAttribute("CrispLip") then
			snapLip(d)
		end
		if d:IsA("Frame") and d:GetAttribute("CrispCell") then
			snapHolder(d)
		elseif d:IsA("GuiObject") and d:GetAttribute("CrispBox") then
			snapOrigin(d)
		elseif d:IsA("UIStroke") and d:GetAttribute("CrispEdge") then
			snapEdge(d)
		end
	end
	one(root)
	for _, d in ipairs(root:GetDescendants()) do
		one(d)
	end
end

function PixelCrisp.Cell(holder)
	return holder and holder:GetAttribute("CrispPx") or nil
end

return PixelCrisp
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1197">
            <Properties>
              <string name="Name">ShopEggs</string>
              <string name="Source"><![CDATA[-- ShopEggs (client UI; lobby-shop Task 22, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.3 "Eggs tab", 16.5
-- "Fixes"): the Shop's Eggs page. ShopController builds it into its Page_Eggs frame, lays it out on every resize and
-- repaints it on every refresh. It never decides a price or a roll: every button goes through EggStage.Request (the one
-- BuyRoulette sender: the FIRE_GAP, the pending flag, the "You need ..." and policy toasts); the server checks again.
--
--   ShopEggs.Build(page, ctx)        page = the Page_Eggs Frame. In it: a ScrollingFrame "Scroll" holding ShopCard_Secret
--                                    (the hero, attribute Hero = true) and the ScrollingFrame "Cards" (ShopCard_Cloud /
--                                    _Storm / _Sky / _Celestial), and the phone's right "Fade" (48 px while more of the
--                                    row is to the right). ctx = { Tap() (the click sound), Close() (shop-area: TRAVEL
--                                    closes the Shop) } | nil
--   ShopEggs.Layout(page, box, mode) box = { W, H } (the content box, design px); mode:
--                                    "PC" / "Compact": the hero 240 tall at (0, 16) (the machine 190 x 218 at (26, 10),
--                                      "Secret Roulette" 46 px at (240, 22), the odds line at (240, 84), the PityChip
--                                      400 x 48 at (240, 132), Spin 290 x 100 at (w - 320, 66), the hint under it), the
--                                      card row at y 276: four cards (w - 48) / 4 wide (sideways under 250), 550 tall
--                                      (NamePlate, the machine 130 x 150 at y 76, Odds_* rows 40 tall from y 234, Spin
--                                      64 at y 400, Spin3 / SpinGems at y 476 half width, the hint). A body under 826 px
--                                      shrinks it (the hero 200 with a 160 machine, the cards 516 at y 236 with a 100
--                                      machine) and the page scrolls; (kit-b U9-2) a body under 760 takes TIGHT (the hero
--                                      180, the cards from y 208 to the body's bottom: every button row inside it at
--                                      1280x720); Compact / shrunk second-row buttons are 56 tall
--                                      (>= 44 px at the 0.8 scale)
--                                    (shop-area: the hint on one line from w - 380 (8 px clear of the chips) to w - 10)
--                                    "Phone": one sideways row: the Secret card 200 wide, then the four cards 166 wide at
--                                      x = 208 + i * 174, every card min(266, H - 12) tall (the art shrinks first)
--                                    "Portrait": a vertical list of full-width cards (Secret 200 tall, the machines 250;
--                                      the odds a 2 x 2 grid of egg 30 + % 15; the PityChip's long line while it
--                                      fits, else "Secret in N")
--   ShopEggs.Refresh(page)           the odds rows (rebuilt when PetCatalog.GetRarityOdds changes), the prices, the
--                                    states, the PityChip, the lock texts
--   ShopEggs.Focus(page, rouletteId) -> bool   scrolls that card into view (centred when its row scrolls) and outlines
--                                    it gold for 2.6 s (attribute Focused)
--   ShopEggs.CardState(rouletteId, button) -> "NoOdds" | "Pending" | "Locked" | "Altar" | "Loading" | "Short" | "Ready"
--                                    button = "Spin" (default) | "Spin3" | "SpinGems". In that order: no odds; a request
--                                    pending (EggStage.IsPending: every button); every button while
--                                    PaidRandomItemsRestricted is not false (Locked; token spins too since lobby-shop
--                                    16.12, but only while the Store is on: StoreCatalog.Enabled(), release step 1);
--                                    the Secret card away from the Storm Altar (Altar, shop-area 16.17.3:
--                                    ShopEggs.AtAltar() false); a gem button (SpinGems, every Secret button) before
--                                    GemsSettled (Loading); the balance under the price (Short: the price kept, drawn
--                                    red, the button still taps and EggStage toasts); else Ready
--   ShopEggs.AtAltar() -> bool       (shop-area 16.17.3) the Secret roll can be bought from here: ShopEggs._AtAltar when a
--                                    test set it (true / false); else Config.AtAltar(the character's HumanoidRootPart,
--                                    no slack: the server allows AltarRangeSlack more) whenever there is a root and the
--                                    replicated AltarIslandAt; only without that live reading the Shop opened by the
--                                    altar's prompt counts (SetFromAltar, until Close). Away from it the Secret card greys
--                                    under "Dim" (the navy lip at K.DIM), the "AltarChip" ("Available at the Storm Altar";
--                                    phone / portrait "At the Storm Altar") takes the PityChip's box and a green "Travel"
--                                    (the arrow glyph + "Show the way") takes SPIN's: (Pitch 2 item 13 A; it teleported) a
--                                    tap starts TutorialController.Guide.Start("StormAltar") at most once per K.TRAVEL_GAP
--                                    (no QuickTravel) and closes the Shop (ctx.Close); away from the lobby the guide routes
--                                    home first; greyed only while a match / battle / run holds the player ("Finish the
--                                    match first"). A restricted account keeps the
--                                    Locked card (no chip, no TRAVEL); the page repaints on the Shop's 1 s tick
--   ShopEggs.SetFromAltar(on)        ShopController.Open's FromAltar (the altar prompt), cleared by Close; read by AtAltar()
--                                    only while there is no live reading
--   ShopEggs.HeroPulse(page) -> the UIScale "Pulse" of the hero's Spin (ShopController's shine pulses it, High only)
--   ShopEggs.Fx(page) -> { Pool, Egg }   (Task 26, spec 16.5 "Where the VFX show") the page's HatchFx pool (16 sparks,
--                                    in the hero card) and the Secret hero's big "HeroEgg" (EggArt Full, built Still). On
--                                    PC / Compact the egg stands between the machine and the texts (150 tall at x 198,
--                                    the texts from x 360; shrunk: 124 at x 170, the texts from x 305); a phone or
--                                    portrait card has no room for it (hidden). While the page shows on High graphics the
--                                    egg wears its VFX, the pool keeps its 2 orbiting star sparks and every machine's
--                                    Glass sweeps a slow sheen (its UIGradient "GlassSheen"); hidden (another tab, the
--                                    Shop closed, the egg stage over it), on Low or on a phone everything stops: no
--                                    tween, no Heartbeat. It follows the page's and its ancestors' Visible, the
--                                    ScreenGui's Enabled and the Gfx setting. (egg-3d, spec 16.14) While it shows,
--                                    egg_secret's id is usable here and High: the real Blender egg turns slowly in a
--                                    ViewportFrame "Egg3D" inside HeroEgg (client/UI/Egg3D; the 2D paint hides, its
--                                    sparks and Aura stay); hidden it is destroyed and the 2D egg painted again
--                                    (ShopEggs.Fx(page).Egg3D = the view or nil)
--   ShopEggs.Metrics                 the K table (sizes, texts; MEASURE: a text-width hook for the offline renderer)
-- Buttons: Spin = EggStage.Request(id, "Tokens", 1), Spin3 = (id, "Tokens", 3), SpinGems = (id, "Gems", 1), the Secret
-- card's Spin = ("Secret", "Gems", 1). A spin button holds Word ("Spin" / "x3", or the state: "Locked", "Loading..."),
-- the currency icon (TokenIcon: the Cloud Token glyph; GemPixel: item 9 B's pixel gem) and Price (Theme.Short(n): "3K", "250";
-- Pitch 2 F0, one number style). The machines are frames placed
-- by scale (the pitch's 200 x 230 drawing: base, panel, neck, the glass dome with seven EggArt eggs, the cap).
-- Every PC text >= 18 px, every phone text >= 15 px. Plain Lua 5.1-compatible syntax only; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PetCatalog = require(Shared:WaitForChild("PetCatalog"))
local Remotes = require(Shared:WaitForChild("Remotes"))
local StoreCatalog = require(Shared:WaitForChild("StoreCatalog"))

local UI = script.Parent
local NeonKit = require(UI:WaitForChild("NeonKit"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the token coin, the gem, TRAVEL's arrow
local SignKit = require(Shared:WaitForChild("SignKit")) -- (LOOK-ui) the kit's one scroll bar
local CloudUI = require(UI:WaitForChild("CloudUI"))
local EggArt = require(UI:WaitForChild("EggArt"))
local Egg3D = require(UI:WaitForChild("Egg3D"))
local EggStage = require(UI:WaitForChild("EggStage"))
local HatchFx = require(UI:WaitForChild("HatchFx"))
local TweenService = game:GetService("TweenService")
local State = require(UI.Parent:WaitForChild("State"))

local ShopEggs = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local SECRET_DEF = type(Config.Gems) == "table" and Config.Gems.SecretRoulette or nil
local K = {
	SECRET = (type(SECRET_DEF) == "table" and SECRET_DEF.Id) or "Secret",
	MACHINES = { "Cloud", "Storm", "Sky", "Celestial" },
	-- the hero's big egg (Task 26): its height and x by plan, where the texts start, and the page's spark pool
	HERO_EGG = { Ref = { 150, 198, 360 }, Shrunk = { 124, 170, 305 }, Sparks = 16, Spin3D = 16, View3D = 1.15 }, -- (egg-3d: the 3D egg turns once in 16 s in a frame 1.15 egg heights tall)
	-- each machine dome's glass sheen (High, while the page shows): a lighter band sweeping across every ~6 s
	GLASS_SHEEN = TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 4.4),
	HERO = rgb(138, 92, 255),
	HERO_MACHINE = rgb(90, 75, 208),
	CHIP = rgb(59, 42, 138),
	RED = rgb(255, 92, 92),
	GOLD = rgb(255, 211, 77),
	LINE = rgb(255, 243, 176),
	NAVY = rgb(11, 16, 48),
	SECRET_TEXT = rgb(180, 150, 255), -- Secret's own colour is near black: the readable violet
	FOCUS_SECONDS = 2.6,
	FOCUS_STROKE = 6,
	TILE = 166, -- the phone row
	STEP = 174,
	TILE_MAX = 266,
	HERO_PHONE = 200,
	FADE = 48,
	TILE_WIDE = 240, -- (fix round B) the widest a phone card grows to fill its viewport with whole cards
	-- (fix6, P2 icons look pol1 #1) the narrowest phone card that draws the sheet's machines at 2 px cells: the card's stage
	-- (w - 102, L.cardSheetPhone) holds the 53-cell drawing and its 2 px rim (106 + 4), the hero's column (w - 90,
	-- L.heroPhone) the vault's 61 cells (122)
	TILE_SHEET = 212,
	-- (fix6) and the widest it grows to fill the row: two 2 px cards on an 800 wide phone left 120 px of bare page
	TILE_WIDE_SHEET = 300,
	MORE_GUTTER = 40, -- (fix round B) the More arrow's column right of the phone row's viewport (its block is 30 wide, 4 in)
	SNAP_DELAY = 0.25, -- (fix round B) s a drag rests before the phone row snaps to a whole card
	SCROLLBAR = SignKit.Sizes.ScrollBar, -- (LOOK-ui) the kit's one bar (was 6, black, round ends)
	FIT_H = 834, -- a PC / Compact body under this shrinks the page (REF's CardsY + Card + BODY_FOOT)
	-- (Pitch 2 F0 review, major 6: the cards' bottom edge ran under the window's frame and the stone's lip, and the hint
	-- touched the card's colour lip) the page keeps the card row BODY_FOOT px over the body's bottom (the frame 6 and the
	-- stone's 8 px lip lie over it, the card's 3 px edge outside it), and a card's hint ends CARD_FOOT px over the card's
	-- bottom (its 5 px colour lip and a gap)
	BODY_FOOT = 18,
	CARD_FOOT = 8,
	-- (same review) a card's wood edge (NeonKit's 3 px SignEdge stroke) and its finish shadow (Theme.Finish.Card) lie
	-- outside its box: the card row (a ScrollingFrame, it clips) and the page give them room, so the cards and the hero
	-- show their edge on every side (it was cut off on the left, top and bottom)
	CARD_EDGE = 3,
	PORTRAIT_CARD = 250,
	PORTRAIT_HERO = 200,
	-- (Pitch 2 item 10 A; P2 icons review r1) with the machines sheet: the portrait cards grow for the 2 px machines
	-- (128 x 136 stages), and a PC card's Spin rows and hint sit LIFT px higher (the hint clears the card's colour lip)
	PORTRAIT_CARD_SHEET = 292,
	PORTRAIT_HERO_SHEET = 254, -- (P2 icons look pol0, minor: 248 left the hint's second row on the button's wood edge)
	HINT_SPARE = 1.02, -- (P2 icons look fin1) H.heroHintRows: the Body face's width over its Enum fallback's, rounded up
	LIFT = 12,
	TEXT = {
		Lock = "Gem roulettes are not available on this account right now.",
		Checking = "Checking your account...",
		LockShort = "Locked on this account",
		CheckingShort = "Checking...",
		Loading = "Loading...",
		LoadingShort = "Loading",
		Locked = "Locked",
		NoOdds = "Odds unavailable",
		Hint = "Gems: same odds",
		-- shop-area (spec 16.17.3): the Secret roll happens at the Storm Altar only (was "Also at the Storm Altar"). Polish:
		-- the hero's hint follows its state: Locked keeps this rule line, Altar says what TRAVEL does, at the altar where
		-- you are (ShopEggs.Refresh)
		HeroHint = "Secret rolls happen at the Storm Altar",
		-- (Pitch 2 item 13_travel_guide A, the owner's pick: no teleport) the button starts a walking guide; it was "Travel
		-- flies you to the Storm Altar"
		HeroHintTravel = "A gold arrow leads you to the Storm Altar",
		HeroHintHere = "You are at the Storm Altar",
		-- away from the lobby the guide routes home first (it greyed out: "Go to the lobby to travel to the Storm Altar")
		HeroHintLobby = "From here: Home first, then the arrow",
		HeroHintLobbyShort = "Home first, then the arrow", -- phone / portrait
		-- a match / battle / dungeon run holds the player: the one state that greys the button
		HeroHintLocked = "Finish the match first",
		AltarLock = "Available at the Storm Altar",
		AltarLockShort = "At the Storm Altar",
		-- (P2 icons look pol0, major: the 360-wide portrait hero's chip, 132 px of room after the padlock, cut the short line
		-- to "At the Storm Al.") the line a chip too narrow for the short one reads: it still names the Storm Altar
		AltarLockTiny = "Storm Altar only",
		Travel = "Show the way", -- (kit-b U9-2: buttons read in sentence case; Pitch 2 item 13 A: was "Travel")
		GemsOnly = "gems only",
	},
	-- shop-area (spec 16.17.3): the Altar state. "Show the way" starts the guide (Pitch 2 item 13 A; it fired
	-- QuickTravel("Altar")) at most once per TRAVEL_GAP; the Dim
	-- (the navy lip at DIM) greys the hero over its art and the page's sparks (HatchFx.Pool's holder, ZIndex 20) and under the
	-- chips, the spin holder and the hint (Z_OVER)
	TRAVEL_GAP = 0.4,
	DIM = 0.35,
	Z_DIM = 21,
	Z_OVER = 22,
	-- the PC plans (REF while the body holds FIT_H, SHRUNK under it)
	REF = { Ref = true, Hero = 240, HeroArt = 190, CardsY = 276, Card = 540, Art = 130, RowsY = 232, RowsH = 152, SpinY = 388, Row2Y = 460 },
	SHRUNK = { Ref = false, Hero = 200, HeroArt = 160, CardsY = 236, Card = 516, Art = 100, RowsY = 198, RowsH = 152, SpinY = 354, Row2Y = 426 },
	-- (kit-b U9-2; the render gate: the x3 / gem row ran under the window's bottom edge at 1280x720) a body under SHRUNK's
	-- CardsY + Card + 8 takes TIGHT, sized from the body (L.plan): the hero 180 with a 150 machine, the cards from y 208
	-- down to the body's bottom (MinCard at least, then the page scrolls), the machine 84, the odds rows share what is left
	-- over the two button rows
	-- (fix6, P2 icons look pol1 #1's class at 960 x 540: MinCard 440 left the sheet's stage 146 tall, the machines at 1 px
	-- cells) MinCard 457: the stage (Card - 282 - LIFT, L.cardSheetPC) keeps the 163 its 2 px cells need under the 0.8 Fit
	TIGHT = { Hero = 180, HeroArt = 150, CardsY = 208, Art = 84, RowsY = 182, HintH = 20, MinCard = 457 },
	-- the machine: the pitch's 200 x 230 drawing; its dome eggs (the pitch's lists) at the pitch's spots pulled 30% toward
	-- the dome's centre (100, 76), so every egg stays inside the round glass (a plain Frame clips square)
	BOX = { 0, 0, 200, 230 },
	DOME = { 36, 12, 128, 128 },
	SPOTS = { { 60, 112 }, { 92, 118 }, { 122, 114 }, { 148, 104 }, { 74, 88 }, { 106, 92 }, { 134, 82 } },
	PULL = 0.7,
	DOME_EGG = 34,
	-- K.MEASURE(text, size, font) -> width replaces TextService:GetTextSize when set (tools/dump_gui.lua's shop scene hands
	-- in the renderer's font metrics: the mock's GetTextSize is a flat 0.5 em per character)
	MEASURE = nil,
	EGGS = {
		Cloud = { "Common", "Uncommon", "Common", "Rare", "Common", "Uncommon", "Common" },
		Storm = { "Rare", "Uncommon", "Rare", "Epic", "Uncommon", "Rare", "Legendary" },
		Sky = { "Epic", "Rare", "Epic", "Legendary", "Rare", "Epic", "Mythic" },
		Celestial = { "Legendary", "Epic", "Legendary", "Mythic", "Epic", "Legendary", "Epic" },
		Secret = { "Mythic", "Mythic", "Secret", "Mythic", "Mythic", "Secret", "Mythic" },
	},
}
ShopEggs.Metrics = K
local WHITE = Color3.new(1, 1, 1)
local MUTED = Theme.Colors.Muted or rgb(176, 184, 206)
-- (kit-b U9-2, finding 15) the Signboard palette: the machine cards are stone blocks (brown ink) with the roulette's own
-- colour on the lip and the name plate; the Secret hero is the navy plank (white / gold ink); a short balance reads in
-- SHORT, a dark red that holds 4.5:1 on stone, the sunk well and the green plank alike
local SIGN = Theme.Sign
local SHORT = rgb(140, 24, 48)
local LEFT, RIGHT, CENTER = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right, Enum.TextXAlignment.Center
local PAGES = setmetatable({}, { __mode = "k" }) -- page -> its widgets
local CUR = setmetatable({}, { __mode = "v" }) -- CUR.Page: the page built last (Focus without a page)
local H = {} -- helpers
local L = {} -- layouts
-- shop-area (spec 16.17.3): From = the Shop was opened by the Storm Altar's prompt (ShopController.Open's FromAltar, cleared
-- on Close); LastTravel = os.clock() of the last "Show the way" tap taken (Pitch 2 item 13 A)
local ALTAR = { From = false, LastTravel = -math.huge }
ShopEggs._AtAltar = nil -- tests: true / false overrides ShopEggs.AtAltar(); nil = the real reading

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

local function frame(name, parent, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function label(name, parent, text, role, size, props)
	local l = Theme.Label(text or "", role, { Size = size })
	l.Name = name
	l.BackgroundTransparency = 1
	l.TextWrapped = false
	l.TextTruncate = Enum.TextTruncate.AtEnd
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function scroller(name, parent, direction)
	local s = Instance.new("ScrollingFrame")
	s.Name = name
	s.BackgroundTransparency = 1
	s.BorderSizePixel = 0
	SignKit.Scroll(s, K.SCROLLBAR)
	s.ScrollingDirection = direction
	s.CanvasSize = UDim2.new()
	s.Parent = parent
	return s
end

-- (a false attribute stays false: PaidRandomItemsRestricted = false is "allowed")
local function attr(name)
	local player = Players.LocalPlayer
	if not player then
		return nil
	end
	return player:GetAttribute(Config.Attr[name] or name)
end

function H.textW(text, size, font)
	local ok, v = pcall(function()
		if type(K.MEASURE) == "function" then
			return Vector2.new(K.MEASURE(text, size, font), size)
		end
		return Theme.Measure(text, font, size, 10000)
	end)
	if ok and typeof(v) == "Vector2" and v.X > 0 then
		return v.X
	end
	return #tostring(text) * size * 0.55
end

-- (P2 icons look fin1, major: the portrait hero's hint was cut at 390 and 360 wide) the rows the longest line any hero
-- state can show takes, word-wrapped at `size` in a box `width` wide. Measured as the Body face: TextService knows only
-- its Enum fallback (Builder Sans Bold), and Nunito ExtraBold runs about 1.015 x that in render_gui's real font, so
-- K.HINT_SPARE rounds it up to 1.02 (Theme.MeasureSpare's 1.06 would add a row the face never needs)
function H.heroHintRows(width, size, font)
	local function w(s)
		return H.textW(s, size, font) * K.HINT_SPARE
	end
	local most = 1
	for _, text in ipairs({ K.TEXT.HeroHint, K.TEXT.HeroHintLocked, K.TEXT.HeroHintLobbyShort, K.TEXT.HeroHintTravel, K.TEXT.HeroHintHere }) do
		local rows, line = 0, nil
		for word in tostring(text):gmatch("%S+") do
			local try = line and (line .. " " .. word) or word
			if line and w(try) > width then
				rows, line = rows + 1, word
			else
				line = try
			end
		end
		most = math.max(most, rows + (line and 1 or 0))
	end
	return most
end

function H.roulette(id)
	for _, r in ipairs(Config.Roulettes or {}) do
		if r.Id == id then
			return r
		end
	end
	if type(SECRET_DEF) == "table" and SECRET_DEF.Id == id then
		return SECRET_DEF
	end
	return nil
end

-- one spin's price in that currency (Config; the server checks it again)
function H.price(id, currency)
	local r = H.roulette(id)
	if not r then
		return 0
	end
	if currency == "Gems" then
		local prices = type(Config.Gems) == "table" and Config.Gems.RouletteGemPrices or {}
		return math.floor(tonumber(prices[id]) or tonumber(r.GemPrice) or 0)
	end
	return math.floor(tonumber(r.Price) or 0)
end

function H.balance(currency)
	local fn = currency == "Gems" and State.Gems or State.Tokens
	local ok, n = pcall(fn)
	return (ok and type(n) == "number") and n or 0
end

function H.odds(id)
	local ok, list = pcall(PetCatalog.GetRarityOdds, id)
	return (ok and type(list) == "table") and list or {}
end

function H.rarityText(rarity)
	if rarity == "Secret" then
		return K.SECRET_TEXT
	end
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity then
			return Theme.Lighten(r.Color, 0.2)
		end
	end
	return WHITE
end

-- "60%": the whole percent, else one decimal
function H.pct(chance)
	local v = (tonumber(chance) or 0) * 100
	if math.abs(v - math.floor(v + 0.5)) < 1e-6 then
		return tostring(math.floor(v + 0.5)) .. "%"
	end
	return string.format("%.1f%%", v)
end

function H.sizeEgg(egg, px)
	px = math.max(8, math.floor(px + 0.5))
	local w = math.floor(((EggArt.Metrics and EggArt.Metrics.WIDTH) or 0.8) * px + 0.5)
	egg.Size = UDim2.fromOffset(w, px)
	local outline = egg:FindFirstChild("Outline")
	if outline then
		outline.Thickness = math.max(2, math.floor(px / 20 + 0.5))
	end
	egg:SetAttribute("Size", px)
	return w
end

-- (P2 icons review r1, major 1: under the 3 px pixel machines the odds chips drew this module's smooth vector EggArt) an
-- odds chip's hand-pixelled egg, "PixelEgg" (the mock-up's, 10_optA): cut from the machines sheet's egg row
-- (Config.MachineSheet.Eggs) while that sheet has an id, else the same drawing as the 9 x 9 PixelIcon glyph
-- "egg_<rarity>" in Frames. Drawn again only when px changes; nil for a rarity with neither (the vector egg stays)
local function eggSheet(rarity)
	local ms = Config.MachineSheet
	local id = type(ms) == "table" and tonumber(ms.Id) or 0
	local cell = type(ms) == "table" and type(ms.Eggs) == "table" and ms.Eggs[rarity] or nil
	return (id and id > 0 and cell) and id or nil, cell
end

-- whether a chip of rarity row.Rarity has a pixel egg to draw (its sheet cell or its glyph)
function H.canPixelEgg(row)
	return eggSheet(row.Rarity) ~= nil or PixelIcon.Art["egg_" .. string.lower(tostring(row.Rarity))] ~= nil
end

function H.pixelEgg(row, px)
	local old = row.PixelEgg
	if old and old.Parent and old:GetAttribute("Px") == px then
		return old
	end
	if old then
		old:Destroy()
	end
	local name = "egg_" .. string.lower(tostring(row.Rarity))
	local id, cell = eggSheet(row.Rarity)
	local icon = (id and PixelIcon.FromSheet(row.Root, name, px, id, cell)) or PixelIcon.New(row.Root, name, px, PixelIcon.Own)
	if icon then
		icon.Name = "PixelEgg"
		icon:SetAttribute("Px", px)
		local z = row.Pct.ZIndex
		icon.ZIndex = z
		for _, d in ipairs(icon:GetChildren()) do
			if d:IsA("GuiObject") then
				d.ZIndex = z
			end
		end
	end
	row.PixelEgg = icon
	return icon
end

function H.call(P, name, ...)
	local fn = P.Ctx[name]
	if type(fn) == "function" then
		pcall(fn, ...)
	end
end

----------------------------------------------------------------------
-- the machine (frames placed by scale in the pitch's 200 x 230 box)
----------------------------------------------------------------------
-- (kit-b U9-2) a square wood edge (mitred) on a kit B tag
function H.edge(obj, px)
	local s = Util.Create("UIStroke", {
		Name = "SignEdge", Color = SIGN.Wood, Thickness = px or 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter, Parent = obj,
	})
	-- (Pitch 2 F0, finish pass A) the light on the wood edge and the tag's lit top band (no shadow on a tag in a card)
	SignKit.FinishBlock(obj, { Out = px or 3, Shadow = false })
	return s
end

function H.part(m, parent, box, name
, x, y, w, h, color, radius, strokeW, props)
	local f = frame(name, parent, {
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		Position = UDim2.fromScale((x - box[1]) / box[3], (y - box[2]) / box[4]),
		Size = UDim2.fromScale(w / box[3], h / box[4]),
	})
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	if radius then
		Util.Create("UICorner", { CornerRadius = UDim.new(radius, 0), Parent = f })
	end
	if strokeW then
		local s = Util.Create("UIStroke", { Color = K.NAVY, Thickness = strokeW, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = f })
		m.Strokes[#m.Strokes + 1] = { Stroke = s, W = strokeW }
	end
	return f
end

-- (Pitch 2 item 10 A) the uploaded machines sheet: its image id and roulette `id`'s cell { x, y, w, h }, or nil while
-- Config.MachineSheet.Id is 0 (nothing uploaded: today's drawn machine)
function H.machineSheet(id)
	local ms = Config.MachineSheet
	local sheetId = type(ms) == "table" and tonumber(ms.Id) or 0
	local cell = type(ms) == "table" and type(ms.Cells) == "table" and ms.Cells[id] or nil
	if not (sheetId and sheetId > 0 and sheetId == math.floor(sheetId) and type(cell) == "table") then
		return nil
	end
	return sheetId, cell
end

-- (Pitch 2 item 10 A "Workshop machines") roulette `id`'s own pixel machine, cut from the sheet (one ImageLabel "Art",
-- ResampleMode Pixelated), standing on its "Stage": a Well sunk into the card in a pale wash of the roulette's colour with
-- a PetWell floor, its line and a stepped pixel ground shadow. (P2 icons review r1, major 3: the vault sat in a visible dark
-- box, dimmed, next to the big egg) the hero's vault has no box: it stands on the card's own navy, on a NavyLip slab with
-- its NavyTop line (the mock-up's), no ground shadow. Today's drawn machine stays under it in "Drawn" for a box too small
-- for one screen px a cell (H.layoutSheetMachine shows one or the other: never a blurry shrink, never art over the card's
-- rows)
function H.addSheet(m, color, secret, sheetId, cell)
	m.Sheet, m.Cell, m.Secret = true, cell, secret
	local root = m.Root
	root:SetAttribute("Sheet", true)
	local face = secret and SIGN.Navy or color:Lerp(SIGN.Tile, 0.74)
	m.Stage = frame("Stage", root, { BackgroundTransparency = secret and 1 or 0, BackgroundColor3 = secret and SIGN.NavyLip or SIGN.WellEdge, Size = UDim2.fromScale(1, 1) })
	m.Face = frame("Face", m.Stage, { BackgroundTransparency = secret and 1 or 0, BackgroundColor3 = face })
	m.Lid = frame("Lid", m.Face, { BackgroundTransparency = 0, BackgroundColor3 = face:Lerp(SIGN.WellEdge, 0.45), Visible = not secret })
	m.Floor = frame("Floor", m.Face, { BackgroundTransparency = 0, BackgroundColor3 = secret and SIGN.NavyLip or SIGN.PetWell })
	m.FloorLine = frame("FloorLine", m.Floor, { BackgroundTransparency = 0, BackgroundColor3 = secret and SIGN.NavyTop or SIGN.WellEdge })
	local shade = SIGN.PetWell:Lerp(SIGN.WellEdge, 0.55)
	m.Shadow = {}
	for i = 1, 3 do
		m.Shadow[i] = frame("Shadow" .. i, m.Face, { BackgroundTransparency = 0, BackgroundColor3 = shade, Visible = not secret })
	end
	m.Art = Util.Create("ImageLabel", {
		Name = "Art",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Image = Config.Art.Image(sheetId) or "", -- (P2 icons look fin1) the URL from Config.Art
		ImageRectOffset = Vector2.new(cell[1], cell[2]),
		ImageRectSize = Vector2.new(cell[3], cell[4]),
		ResampleMode = Enum.ResamplerMode.Pixelated,
		ScaleType = Enum.ScaleType.Stretch,
		Parent = root,
	})
end

-- the page's sheet machines (m.Group, ShopEggs.Build) show only when every one of them fits its box (m.Fits): a page never
-- mixes the new machines with today's. (P2 icons review r1, major 1) every layout's boxes are sized for whole px cells
-- (L.*Sheet below), so the phones show them too. The hero's Dim (away from the altar) veils today's drawn machine only:
-- the vault stays bright (the mock-up's; the altar chip's padlock says why)
function H.showSheets(m)
	local all = m.Fits == true
	for _, o in ipairs(m.Group or {}) do
		all = all and o.Fits == true
	end
	for _, o in ipairs(m.Group or { m }) do
		o.Drawn.Visible = not all
		o.Stage.Visible = all
		o.Art.Visible = all
		o.Root:SetAttribute("SheetShown", all)
		if o.HeroCard then
			o.HeroCard.Dim.Visible = o.HeroCard.Away == true and not all
		end
	end
end

-- whether the page shows the sheet machines (the hero's look follows it: no big egg, no Dim)
function H.sheetShown(t)
	return t.Machine.Sheet == true and t.Machine.Root:GetAttribute("SheetShown") == true
end

-- the sheet machine in its box at rest scale s: the largest whole number of screen px a cell that fits, centred (m.AlignX),
-- on whole screen px. A card's machine stands 4 cells into an 8-cell floor where the stage is tall enough (the drawing and
-- 1 cell of floor under its drop shadow must fit, inside the well's 2 px rim: P2 icons look pol0, the 640 x 360 phone's
-- 129 px stage holds the 2 px cells so; it asked for 2 cells); the hero's vault stands on the box's foot over its 3-cell
-- slab (no rim: the drawing must fit). A box too small for 1 px a cell can't: then the page shows today's drawn machines
-- (H.showSheets)
function H.layoutSheetMachine(m, s)
	s = (s and s > 0) and s or 1
	local W, Hh = m.Root.Size.X.Offset, m.Root.Size.Y.Offset
	local cw, ch = m.Cell[3], m.Cell[4]
	local edge = m.Secret and 0 or PixelIcon.Px(2, s)
	local px = math.floor(math.min((W - 2 * edge) * s / cw, (Hh - 2 * edge) * s / (ch + (m.Secret and 0 or 1))))
	m.Fits = px >= 1
	H.showSheets(m)
	if not m.Fits then
		m.Root:SetAttribute("CellPx", nil)
		return
	end
	local dc = px / s
	local aw, ah = cw * dc, ch * dc
	local ax = edge + math.floor((W - 2 * edge - aw) * (m.AlignX or 0.5) * s) / s
	m.Face.Position = UDim2.fromOffset(edge, edge)
	m.Face.Size = UDim2.fromOffset(W - 2 * edge, Hh - 2 * edge)
	if m.Secret then
		-- the vault's foot on the box's foot; the slab 3 cells tall under its last cells, 2 cells in from its sides
		local ay = math.floor((Hh - ah) * s) / s
		m.Art.Position = UDim2.fromOffset(ax, ay)
		m.Art.Size = UDim2.fromOffset(aw, ah)
		local slab = 3 * dc
		m.Floor.Position = UDim2.fromOffset(ax + 2 * dc, Hh - slab)
		m.Floor.Size = UDim2.fromOffset(math.max(0, aw - 4 * dc), slab)
		m.FloorLine.Size = UDim2.fromOffset(math.max(0, aw - 4 * dc), PixelIcon.Px(2, s))
		m.Root:SetAttribute("CellPx", px)
		return
	end
	local floorH = math.min(Hh - 2 * edge, 8 * dc)
	local feet = Hh - edge - math.max(3 * dc, floorH - 4 * dc) -- the feet 4 cells into an 8-cell floor
	local ay = math.max(edge, math.floor((feet - ah) * s) / s)
	m.Art.Position = UDim2.fromOffset(ax, ay)
	m.Art.Size = UDim2.fromOffset(aw, ah)
	m.Lid.Size = UDim2.fromOffset(W - 2 * edge, PixelIcon.Px(3, s))
	m.Floor.Position = UDim2.fromOffset(0, Hh - 2 * edge - floorH)
	m.Floor.Size = UDim2.fromOffset(W - 2 * edge, floorH)
	m.FloorLine.Size = UDim2.fromOffset(W - 2 * edge, edge)
	-- the ground shadow: three stepped rows a cell tall under the feet, the middle one widest (no blur), centred under the
	-- drawing (the rows sit in the Face, `edge` in from the root). The feet as drawn: a stage shorter than the 8-cell floor
	-- wants (the phones) holds the drawing from its top, lower than `feet`, and the rows hid behind it
	local mid = math.floor((ay + ah - edge) * s) / s - dc
	local rx = math.floor(aw * 0.42 / dc) * dc
	for i, row in ipairs({ { -1, 0.6 }, { 0, 1 }, { 1, 0.6 } }) do
		local w = math.floor(2 * rx * row[2] / dc) * dc
		local f = m.Shadow[i]
		f.Position = UDim2.fromOffset(math.floor((ax - edge + (aw - w) / 2) * s) / s, mid + row[1] * dc)
		f.Size = UDim2.fromOffset(w, dc)
	end
	m.Root:SetAttribute("CellPx", px)
end

function H.machine(parent, id, color, secret)
	local m = { Strokes = {} }
	local root = frame("Machine", parent)
	root:SetAttribute("Art", "Machine") -- (kit-b U9-2) an illustration: its round glass and sheen are the drawing, not a panel
	m.Root = root
	-- (Pitch 2 item 10 A) with the machines sheet uploaded, today's drawing goes into "Drawn" (the whole box: its parts are
	-- placed by scale, so they draw the same) under the sheet's art (H.addSheet below)
	local sheetId, cell = H.machineSheet(id)
	if sheetId then
		m.Drawn = frame("Drawn", root, { Size = UDim2.fromScale(1, 1) })
		root = m.Drawn
	end
	local B, D = K.BOX, K.DOME
	H.part(m, root, B, "Base", 26, 146, 148, 76, Theme.Darken(color, 0.32), 0.18, 5)
	H.part(m, root, B, "BaseShine", 36, 152, 128, 16, Theme.Lighten(color, 0.2), 0.5, nil, { BackgroundTransparency = 0.55 })
	H.part(m, root, B, "Panel", 64, 176, 72, 34, Theme.Darken(color, 0.55), 0.25, 4)
	H.part(m, root, B, "Slot", 80, 186, 40, 16, K.NAVY, 0.25)
	H.part(m, root, B, "Knob", 143, 181, 22, 22, WHITE, 0.5, 4)
	H.part(m, root, B, "Neck", 54, 130, 92, 22, Theme.Lighten(color, 0.08), 0.3, 5)
	local dome = H.part(m, root, B, "Dome", D[1], D[2], D[3], D[4], secret and rgb(29, 26, 52) or rgb(233, 246, 255), 0.5, nil, { ClipsDescendants = true })
	local eggs = K.EGGS[id] or K.EGGS.Cloud
	local eh = K.DOME_EGG
	local ew = eh * ((EggArt.Metrics and EggArt.Metrics.WIDTH) or 0.8)
	for i, spot in ipairs(K.SPOTS) do
		local cx = 100 + K.PULL * (spot[1] - 100)
		local cy = 76 + K.PULL * (spot[2] - 76)
		local egg = EggArt.New(dome, eggs[i] or "Common", eh, { Name = "DomeEgg" .. i })
		egg.Position = UDim2.fromScale((cx - ew / 2 - D[1]) / D[3], (cy - eh / 2 - D[2]) / D[4])
		egg.Size = UDim2.fromScale(ew / D[3], eh / D[4])
	end
	local glass = H.part(m, root, B, "Glass", D[1], D[2], D[3], D[4], secret and K.HERO or rgb(191, 230, 255), 0.5, 5, { BackgroundTransparency = 0 })
	-- (Task 26) the glass's see-through 0.84 lives in its gradient, with a lighter band parked off the glass (Offset -1):
	-- the page sweeps it across while it shows on High
	m.Sheen = Util.Create("UIGradient", {
		Name = "GlassSheen",
		Rotation = 30,
		Offset = Vector2.new(-1, 0),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.84),
			NumberSequenceKeypoint.new(0.4, 0.84),
			NumberSequenceKeypoint.new(0.5, 0.5),
			NumberSequenceKeypoint.new(0.6, 0.84),
			NumberSequenceKeypoint.new(1, 0.84),
		}),
		Parent = glass,
	})
	H.part(m, root, B, "Shine", 54, 28, 44, 9, WHITE, 0.5, nil, { BackgroundTransparency = 0.25, Rotation = -32 })
	H.part(m, root, B, "Cap", 82, 2, 36, 18, Theme.Lighten(color, 0.2), 0.35, 4)
	if sheetId then
		H.addSheet(m, color, secret, sheetId, cell)
	end
	return m
end

-- the machine `px` wide (its strokes follow the size; a sheet machine is laid out on whole screen px, again whenever the
-- window's rest scale changes)
function H.sizeMachine(m, px)
	if m.Sheet then
		-- today's drawing under the sheet keeps its own 200 x 230 shape at `px` wide, at the foot of the (wider, taller)
		-- stage, centred: never stretched to the stage (P2 icons review r1: the stages follow the mock-up's card)
		m.Drawn.AnchorPoint = Vector2.new(0.5, 1)
		m.Drawn.Position = UDim2.fromScale(0.5, 1)
		m.Drawn.Size = UDim2.fromOffset(px, math.floor(px * 1.15 + 0.5))
		PixelIcon.Whole(m.Art, function(s)
			H.layoutSheetMachine(m, s)
		end)
	end
	if m.Px == px then
		return
	end
	m.Px = px
	for _, s in ipairs(m.Strokes) do
		s.Stroke.Thickness = math.max(1, math.floor(s.W * px / 200 + 0.5))
	end
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
-- a spin button: a CloudUI.Button with no text of its own holding Word, the currency icon and Price in one row
function H.spinButton(P, parent, name, style, word, currency, id, spins)
	-- (kit-b U9-2) a kit B plank: green for the hero's SPIN (the page's one main action), stone for the machines' spins
	local p = { Currency = currency, BaseWord = word or "", Ink = style == "Green" and SIGN.OnGrass or SIGN.Text }
	p.Button = CloudUI.Button({
		Name = name,
		Text = "",
		Style = style,
		Skin = "Sign",
		Size = UDim2.fromOffset(200, 60),
		TextSize = 22,
		Callback = function()
			H.tap(P, id, currency, spins)
		end,
		Parent = parent,
	})
	p.Word = label("Word", p.Button, p.BaseWord, "Button", 22, { TextTruncate = Enum.TextTruncate.None, TextColor3 = p.Ink })
	if currency == "Tokens" then
		local cur = Theme.Currency.Tokens
		p.Icon = label("TokenIcon", p.Button, "", "Display", 22, { TextColor3 = SIGN.GoldLip, TextTruncate = Enum.TextTruncate.None })
		PixelIcon.Host(p.Icon, cur.Icon) -- (kit-b U7a) the Cloud Token coin, sized with the label (the deep gold reads on stone)
	else
		-- (P2 icons look fin0, major 2: the cut GemIcon, a smooth square turned 45 degrees, sat beside the pixel coins) item
		-- 9 B's pixel gem in its own colours, sized with the label as the coin (10_optA's gem planks)
		p.Icon = label("GemPixel", p.Button, "", "Display", 22, { TextColor3 = SIGN.Text, TextTruncate = Enum.TextTruncate.None })
		PixelIcon.Host(p.Icon, "gem")
	end
	p.Price = label("Price", p.Button, "", "Button", 22, { TextTruncate = Enum.TextTruncate.None, TextColor3 = p.Ink })
	return p
end

-- the row inside a spin button (w x h, text `size`, icon `iconPx`; nil = the last layout's numbers)
function H.arrange(p, w, h, size, iconPx)
	if w then
		p.W, p.H, p.Size, p.IconPx = w, h, size, iconPx
	end
	if not p.W then
		return
	end
	w, h, size, iconPx = p.W, p.H, p.Size, p.IconPx
	p.Icon.TextSize = iconPx
	p.Word.TextSize = size
	p.Price.TextSize = size
	if p.PriceFull then
		p.Price.Text = p.PriceFull
	end
	local stateOnly = p.StateText ~= nil
	p.Word.Visible = p.Word.Text ~= ""
	p.Icon.Visible = not stateOnly
	p.Price.Visible = not stateOnly
	local items = {}
	local priceItem = nil
	if p.Word.Visible then
		items[#items + 1] = { p.Word, H.textW(p.Word.Text, size, Theme.FontOf(p.Word)), true }
	end
	if not stateOnly then
		items[#items + 1] = { p.Icon, iconPx, false }
		priceItem = { p.Price, H.textW(p.Price.Text, size, Theme.FontOf(p.Price)), true }
		items[#items + 1] = priceItem
	end
	local function rowW(gap)
		local total = 0
		for _, it in ipairs(items) do
			total = total + it[2]
		end
		return total + gap * (#items - 1)
	end
	-- (review round 3) a row wider than its button even at the 2 px gap takes the short price from 1,000 up ("3K"): Roblox draws
	-- GothamBlack as the wide Montserrat Black, and the row would run past the button onto its neighbour (the size never steps
	-- under the 15 px phone floor)
	if priceItem and p.PriceShort and p.Price.Text ~= p.PriceShort and rowW(2) > w - 4 then
		p.Price.Text = p.PriceShort
		priceItem[2] = H.textW(p.PriceShort, size, Theme.FontOf(p.Price))
	end
	local gap = math.max(3, math.floor(size * 0.3))
	if rowW(gap) > w - 8 then
		gap = 2
	end
	local total = rowW(gap)
	local x = math.max(2, (w - total) / 2)
	for _, it in ipairs(items) do
		if it[3] then
			place(it[1], x, 0, it[2] + 2, h)
		else
			place(it[1], x, (h - iconPx) / 2, iconPx, iconPx)
		end
		x = x + it[2] + gap
	end
end

-- (kit-b U9-2) a card is a kit B block (NeonKit.Card Skin "Sign"): `face` (stone, or the hero's navy plank), the wood
-- edge (`edge`: the hero's is the gold lip), the roulette's own colour on its lip
function H.card(P, parent, id, color, face, size, edge)
	local c = NeonKit.Card({ Name = "ShopCard_" .. id, Skin = "Sign", BodyOverLip = true, Face = face, Lip = color, Edge = edge, Size = size, Parent = parent })
	local t = { Id = id, Root = c.Root, Card = c, Color = color, Edge = c.Stroke.Color, Thick = c.Stroke.Thickness, Rows = {} }
	local r = H.roulette(id)
	t.Name = (r and r.DisplayName) or (id .. " Roulette")
	return t, c.Body
end

function H.buildHero(P, parent)
	local t, b = H.card(P, parent, K.SECRET, K.HERO, SIGN.Navy, UDim2.fromOffset(1240, 240), SIGN.GoldLip)
	t.Hero = true
	t.Root:SetAttribute("Hero", true)
	t.Machine = H.machine(b, K.SECRET, K.HERO_MACHINE, true)
	t.Machine.HeroCard = t -- (P2 icons review r1) H.showSheets keeps the Dim off the vault
	t.Title = Theme.StyleTitle(label("Title", b, t.Name, "Title", 46, { TextXAlignment = LEFT, TextColor3 = SIGN.Gold }), "Section") -- a card's heading: the Shop's header title wears the ribbon
	t.Odds = frame("OddsLine", b)
	t.GemsOnly = label("GemsOnly", t.Odds, K.TEXT.GemsOnly, "Body", 24, { TextXAlignment = LEFT, TextColor3 = MUTED })
	t.NoOdds = label("NoOdds", b, K.TEXT.NoOdds, "Body", 22, { Visible = false, TextColor3 = MUTED, TextXAlignment = LEFT })
	-- (kit-b U9-2) the pity promise: a gold tag in its wood edge (brown ink)
	t.Pity = label("PityChip", b, "", "Heading", 22, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, TextColor3 = SIGN.Text })
	H.edge(t.Pity)
	t.Lock = label("Lock", b, "", "Body", 20, {
		Visible = false, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextColor3 = K.LINE, TextXAlignment = LEFT,
	})
	t.Holder = frame("SpinHolder", b, { ZIndex = K.Z_OVER })
	t.Pulse = Util.Create("UIScale", { Name = "Pulse", Scale = 1, Parent = t.Holder })
	t.Spin = H.spinButton(P, t.Holder, "Spin", "Green", "Spin", "Gems", K.SECRET, 1) -- (kit-b U9-2) the page's one green plank
	t.Hint = label("Hint", b, K.TEXT.HeroHint, "Body", 18, { TextColor3 = K.LINE, ZIndex = K.Z_OVER })
	-- (Task 26) the big Secret egg in front of the machine's right side, still until the page shows (ShopEggs.Fx)
	t.Egg = EggArt.New(b, "Secret", K.HERO_EGG.Ref[1], { Name = "HeroEgg", Form = "Full", Still = true, ZIndex = 3 })
	-- shop-area (spec 16.17.3): away from the Storm Altar the card greys under Dim (over the art, the egg and its sparks),
	-- AltarChip takes the PityChip's box and TRAVEL takes SPIN's in the same holder (over the Dim with the hint)
	-- (LOOK-ui, kitb-look1: the veil over the whole card greyed the title and the odds below the contrast rule) the Dim
	-- veils the art column only (the layouts place it); the texts stay whole and the chip's padlock says why
	-- (Pitch 2 fix round B r1, look review minor: at 844x390 the veil read as "a visible darker navy rectangle, an unblended
	-- picture box") the veil is the card's own navy face (H.card above): the art fades into the card, no box edge shows
	t.Dim = frame("Dim", b, { BackgroundTransparency = K.DIM, BackgroundColor3 = SIGN.Navy, Size = UDim2.fromScale(1, 1), ZIndex = K.Z_DIM, Visible = false })
	-- (kit-b U9-2) the altar note: a stone tag in its wood edge (brown ink)
	t.AltarChip = label("AltarChip", b, K.TEXT.AltarLock, "Heading", 22, {
		BackgroundTransparency = 0, BackgroundColor3 = SIGN.Tile, TextColor3 = SIGN.Text, ZIndex = K.Z_OVER, Visible = false,
	})
	H.edge(t.AltarChip)
	PixelIcon.Lead(t.AltarChip, "lock", { Px = 18, Gap = 8 }) -- (LOOK-ui, kitb-look1) the padlock before "Available at the Storm Altar"
	t.Travel = H.travelButton(P, t.Holder)
	return t
end

-- the hero's TRAVEL: a CloudUI.Button holding the compass glyph ("Icon") and "TRAVEL" ("Word"); no price: the trip is
-- free. (kit-b U9-2) the green plank: away from the altar it is the page's one main action, in SPIN's place
function H.travelButton(P, parent)
	local tr = {}
	tr.Button = CloudUI.Button({
		Name = "Travel",
		Text = "",
		Style = "Green",
		Skin = "Sign",
		Size = UDim2.fromOffset(290, 100),
		TextSize = 22,
		Callback = function()
			H.travel(P)
		end,
		Parent = parent,
	})
	CloudUI.SetStyle(tr.Button, "Green")
	tr.Button.Visible = false
	tr.Icon = label("Icon", tr.Button, "", "Display", 44, { TextTruncate = Enum.TextTruncate.None, TextColor3 = SIGN.OnGrass })
	PixelIcon.Host(tr.Icon, NeonKit.IconName("Travel")) -- (kit-b U7a) the arrow, sized with the label
	tr.Word = label("Word", tr.Button, K.TEXT.Travel, "Button", 34, { TextTruncate = Enum.TextTruncate.None, TextXAlignment = LEFT, TextColor3 = SIGN.OnGrass })
	return tr
end

-- TRAVEL's row (w x h, text `size`, glyph `iconPx`), centred by the measured width; the word's box runs to the button's
-- edge, so a face wider than the measure never clips it
function H.arrangeTravel(tr, w, h, size, iconPx)
	place(tr.Button, 0, 0, w, h)
	tr.Icon.TextSize = iconPx
	tr.Word.TextSize = size
	local gap = math.max(3, math.floor(size * 0.3))
	local ww = H.textW(tr.Word.Text, size, Theme.FontOf(tr.Word)) + 2
	local x = math.max(4, math.floor((w - (iconPx + gap + ww)) / 2))
	place(tr.Icon, x, (h - iconPx) / 2, iconPx, iconPx)
	local wx = x + iconPx + gap
	place(tr.Word, wx, 0, math.max(0, w - 4 - wx), h)
end

-- (Pitch 2 item 13 A) a match, a battle, a dungeon run or the Ring holds the player: the guide cannot start
function H.tripLocked()
	return attr("InMatch") == true or attr("InBattle") ~= nil
end

-- the travel guide (TutorialController.Guide), looked up when first needed (the Shop loads before the controllers)
function H.guide()
	local ok, guide = pcall(function()
		local folder = UI.Parent:FindFirstChild("Controllers")
		local mod = folder and folder:FindFirstChild("TutorialController")
		local TC = mod and require(mod)
		return type(TC) == "table" and TC.Guide or nil
	end)
	return ok and type(guide) == "table" and type(guide.Start) == "function" and guide or nil
end

-- a "Show the way" tap (Pitch 2 item 13 A: it sent QuickTravel("Altar"), a teleport): only while the page shows and no
-- match / run holds the player, at most once per K.TRAVEL_GAP; the walking guide starts (routing home first when away
-- from the lobby), then the Shop closes. No remote: nothing moves the player.
function H.travel(P)
	if not H.shown(P.Page) or H.tripLocked() or os.clock() - ALTAR.LastTravel < K.TRAVEL_GAP then
		return
	end
	local guide = H.guide()
	if not guide then
		return
	end
	ALTAR.LastTravel = os.clock()
	H.call(P, "Tap")
	local ok, started = pcall(guide.Start, "StormAltar")
	if ok and started == true then
		H.call(P, "Close")
	end
end

function H.buildCard(P, parent, id)
	local r = H.roulette(id)
	local color = (r and typeof(r.Color) == "Color3") and r.Color or rgb(120, 190, 235)
	local t, b = H.card(P, parent, id, color, SIGN.Tile, UDim2.fromOffset(298, 550))
	-- (kit-b U9-2) the name plate: a block in the roulette's own colour in its wood edge, the face nudged until its ink
	-- reads 4.5:1 (Theme.ReadableFace; the phone's plate text is 17 px)
	local plateFace, plateInk = Theme.ReadableFace(color, 4.5)
	t.Plate = label("NamePlate", b, t.Name, "Heading", 24, { BackgroundTransparency = 0, BackgroundColor3 = plateFace, TextColor3 = plateInk })
	H.edge(t.Plate)
	t.Machine = H.machine(b, id, color, false)
	t.Odds = frame("Odds", b)
	t.NoOdds = label("NoOdds", b, K.TEXT.NoOdds, "Body", 20, { Visible = false, TextColor3 = SIGN.TextMuted, TextWrapped = true, TextTruncate = Enum.TextTruncate.None })
	-- (kit-b U9-2) one colour by role: the machines' spins are stone planks (the green plank is the hero's)
	t.Spin = H.spinButton(P, b, "Spin", "Blue", "Spin", "Tokens", id, 1)
	t.Spin3 = H.spinButton(P, b, "Spin3", "Blue", "x3", "Tokens", id, 3)
	t.SpinGems = H.spinButton(P, b, "SpinGems", "Blue", nil, "Gems", id, 1)
	t.Hint = label("Hint", b, K.TEXT.Hint, "Body", 18, { TextColor3 = SIGN.TextMuted })
	return t
end

-- (re)builds a card's Odds_<Rarity> rows when GetRarityOdds(id) changed -> true when rebuilt
function H.syncRows(t)
	local odds = H.odds(t.Id)
	local parts = {}
	for i, e in ipairs(odds) do
		parts[i] = tostring(e.Rarity) .. "=" .. tostring(e.Chance)
	end
	local sig = table.concat(parts, ",")
	if sig == t.Sig then
		return false
	end
	t.Sig = sig
	for _, row in ipairs(t.Rows) do
		row.Root:Destroy()
	end
	t.Rows = {}
	for i, e in ipairs(odds) do
		local row = { Rarity = e.Rarity }
		row.Root = frame("Odds_" .. tostring(e.Rarity), t.Odds, { LayoutOrder = i })
		row.Egg = EggArt.New(row.Root, e.Rarity, 28, { Name = "Egg" })
		-- (kit-b U9-2) on the navy hero the rarity's own light colour; on a stone card brown (the egg names the rarity)
		row.Word = label("Word", row.Root, tostring(e.Rarity), "Heading", 20, { TextColor3 = t.Hero and H.rarityText(e.Rarity) or SIGN.Text, TextXAlignment = LEFT })
		row.Pct = label("Pct", row.Root, H.pct(e.Chance), "Heading", 22, { TextXAlignment = RIGHT, TextColor3 = t.Hero and WHITE or SIGN.Text })
		if t.Machine.Sheet and not t.Hero then
			-- (Pitch 2 item 10 A: "the odds become egg chips"; P2 icons review r1, major 2) with the sheet machines each odds
			-- row is a chip: a stone block in its wood edge with a StoneLip foot, the egg and its percent (no rarity word:
			-- the egg's colour names it, as on the phone). The layouts place the egg and the percent
			row.Root.BackgroundTransparency = 0
			row.Root.BackgroundColor3 = SIGN.Tile
			H.edge(row.Root, 2)
			frame("Lip", row.Root, {
				BackgroundTransparency = 0, BackgroundColor3 = SIGN.StoneLip or SIGN.WellEdge, AnchorPoint = Vector2.new(0, 1),
				Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3),
			})
			row.Chip = true
		end
		t.Rows[i] = row
	end
	t.HasOdds = #odds > 0
	return true
end

function H.all(P)
	local out = { P.Hero }
	for _, t in ipairs(P.Cards) do
		out[#out + 1] = t
	end
	return out
end

function H.tap(P, id, currency, spins)
	-- (shop-area 16.17.3) the Secret SPIN sends nothing away from the Storm Altar (it is hidden there; the server refuses too)
	if id == K.SECRET and not ShopEggs.AtAltar() then
		ShopEggs.Refresh(P.Page)
		return
	end
	H.call(P, "Tap")
	EggStage.Request(id, currency, spins)
	ShopEggs.Refresh(P.Page)
end

function ShopEggs.Build(page, ctx)
	local P = { Page = page, Ctx = type(ctx) == "table" and ctx or {}, Cards = {}, Mode = "PC", Box = { W = 1240, H = 834 } }
	PAGES[page] = P
	CUR.Page = page
	P.Scroll = scroller("Scroll", page, Enum.ScrollingDirection.Y)
	P.Scroll.Size = UDim2.fromScale(1, 1)
	-- (kit-b U9-2) the row's right edge while more is that way; (LOOK-ui, kitb-look1: no gradient in a pixel screen) a stone
	-- block with the pixel arrow there, not the stone fading in
	P.Fade = frame("Fade", page, { BackgroundTransparency = 1, Visible = false, ZIndex = 6 })
	CloudUI.MoreMark(P.Fade, 6)
	P.Hero = H.buildHero(P, P.Scroll)
	P.Row = scroller("Cards", P.Scroll, Enum.ScrollingDirection.X)
	for i, id in ipairs(K.MACHINES) do
		P.Cards[i] = H.buildCard(P, P.Row, id)
	end
	-- (Pitch 2 item 10 A) the page's sheet machines show together or not at all (H.showSheets)
	local group = {}
	for _, t in ipairs(H.all(P)) do
		if t.Machine.Sheet then
			group[#group + 1] = t.Machine
			t.Machine.Group = group
		end
	end
	P.Scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		ShopEggs._SyncFade(page)
		H.queueSnap(P)
	end)
	-- (Task 26) the page-owned spark pool in the hero card: the big egg's orbiting star sparks, stopped while hidden
	P.Pool = HatchFx.Pool(P.Hero.Card.Body, K.HERO_EGG.Sparks)
	P.Pool:SetRunning(false)
	P.Pool:Ambient(P.Hero.Egg, "Secret")
	P.FxConns = {}
	H.wireFx(P)
	page.AncestryChanged:Connect(function()
		H.wireFx(P)
		H.syncFx(P)
	end)
	local settings = UI.Parent:FindFirstChild("ClientSettings")
	local okCS, CS = false, nil
	if settings and settings:IsA("ModuleScript") then
		okCS, CS = pcall(require, settings)
	end
	if okCS and type(CS) == "table" and CS.Changed then
		CS.Changed:Connect(function(key)
			if key == "Gfx" then
				task.defer(H.syncFx, P) -- (after GraphicsQuality has applied the new setting)
			end
		end)
	end
	-- (egg-3d) the hero's real egg appears once egg_secret has loaded on this device, also with the page already open
	P.MeshConn = Egg3D.Watch(function(key)
		if key == Egg3D.KEYS.Secret.Whole then
			task.defer(H.syncFx, P)
		end
	end)
	ShopEggs.Refresh(page)
	H.syncFx(P)
	return P
end

----------------------------------------------------------------------
-- the page's VFX (Task 26)
----------------------------------------------------------------------
-- the graphics setting (client/GraphicsQuality's Effective(), asked on every call); High when the module is not there
function H.high()
	if H.GQ == nil then
		H.GQ = false
		local module = UI.Parent:FindFirstChild("GraphicsQuality")
		if module and module:IsA("ModuleScript") then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" then
				H.GQ = mod
			end
		end
	end
	if not H.GQ then
		return true
	end
	local ok, mode = pcall(H.GQ.Effective)
	return not ok or mode ~= "Low"
end

-- the page shows: it and every GuiObject above it Visible, its ScreenGui Enabled, in a PlayerGui
function H.shown(page)
	local cur = page
	while cur do
		if cur:IsA("GuiObject") then
			if not cur.Visible then
				return false
			end
		elseif cur:IsA("LayerCollector") then
			if not cur.Enabled then
				return false
			end
		elseif cur:IsA("PlayerGui") then
			return true
		end
		cur = cur.Parent
	end
	return false
end

-- (re)connects the Visible / Enabled listeners on the page and its ancestors
function H.wireFx(P)
	for _, c in ipairs(P.FxConns) do
		c:Disconnect()
	end
	P.FxConns = {}
	local cur = P.Page
	while cur and cur ~= game do
		local prop = (cur:IsA("GuiObject") and "Visible") or (cur:IsA("LayerCollector") and "Enabled") or nil
		if prop then
			P.FxConns[#P.FxConns + 1] = cur:GetPropertyChangedSignal(prop):Connect(function()
				H.syncFx(P)
			end)
		end
		cur = cur.Parent
	end
end

function H.syncFx(P)
	local egg = P.Hero.Egg
	local on = H.shown(P.Page) and egg.Visible and H.high()
	EggArt.SetVfx(egg, on)
	H.sync3d(P, on)
	P.Pool:SetRunning(on)
	for _, t in ipairs(H.all(P)) do
		local sheen = t.Machine.Sheen
		if on and not t.GlassTween then
			sheen.Offset = Vector2.new(-1, 0)
			t.GlassTween = TweenService:Create(sheen, K.GLASS_SHEEN, { Offset = Vector2.new(1, 0) })
			t.GlassTween:Play()
		elseif not on and t.GlassTween then
			t.GlassTween:Cancel()
			t.GlassTween = nil
			sheen.Offset = Vector2.new(-1, 0)
		end
	end
end

-- (egg-3d) the hero's real egg: made while the page shows (Egg3D decides: the id, High, the phone limit), destroyed when
-- it hides, so nothing turns behind a closed Shop or the egg stage
function H.sync3d(P, on)
	local egg = P.Hero.Egg
	if P.Egg3 and P.Egg3.Dead then
		P.Egg3 = nil
		EggArt.SetPaintShown(egg, true)
	end
	if on and not P.Egg3 then
		local view = Egg3D.New(egg, "Secret", { Phone = P.Mode ~= "PC", ZIndex = egg.ZIndex + 2, Spin = K.HERO_EGG.Spin3D, Turn = -20, View = K.HERO_EGG.View3D })
		if view then
			P.Egg3 = view
			EggArt.SetPaintShown(egg, false)
		end
	elseif not on and P.Egg3 then
		P.Egg3:Destroy()
		P.Egg3 = nil
		EggArt.SetPaintShown(egg, true)
	end
end

function ShopEggs.Fx(page)
	local P = PAGES[page or CUR.Page]
	return P and { Pool = P.Pool, Egg = P.Hero.Egg, Egg3D = (P.Egg3 and not P.Egg3.Dead) and P.Egg3 or nil } or nil
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
-- the hero's odds line on PC: each row Egg 40 + the rarity + the percent (24 px), then "gems only"
function L.heroOddsPC(t, w)
	-- (Task 26: the big egg moved the texts right) the gap between the rows narrows from 24 to 12 before "gems only"
	-- is left out for want of room. (kit-b P2 fix6, icons look pol1 #2: at 1024 x 768 "Secret 40%" ran under the button)
	-- then the words step down from 24 px to 22 and 20 before the rows run past their column
	local widths, total, size = {}, 0, 24
	for _, sz in ipairs({ 24, 22, 20 }) do
		widths, total, size = {}, 0, sz
		for i, row in ipairs(t.Rows) do
			local ww = H.textW(row.Word.Text, sz, Theme.FontOf(row.Word)) + 2
			local pw = H.textW(row.Pct.Text, sz, Theme.FontOf(row.Pct)) + 2
			widths[i] = { ww, pw }
			total = total + math.floor(EggArt.Metrics.WIDTH * 40 + 0.5) + 8 + ww + 8 + pw
		end
		if total + 12 * (#t.Rows - 1) <= w then
			break
		end
	end
	t.GemsOnly.TextSize = size
	local gw = H.textW(t.GemsOnly.Text, size, Theme.FontOf(t.GemsOnly)) + 2
	local gap = (total + 24 * #t.Rows + gw <= w) and 24 or 12
	local x = 0
	for i, row in ipairs(t.Rows) do
		local ew = H.sizeEgg(row.Egg, 40)
		place(row.Egg, 0, 0, ew, 40)
		row.Word.Visible = true
		row.Word.TextSize = size
		row.Pct.TextSize = size
		local ww, pw = widths[i][1], widths[i][2]
		place(row.Word, ew + 8, 0, ww, 40)
		place(row.Pct, ew + 8 + ww + 8, 0, pw, 40)
		row.Pct.TextXAlignment = LEFT
		local rw = ew + 8 + ww + 8 + pw
		place(row.Root, x, 0, rw, 40)
		x = x + rw + gap
	end
	t.GemsOnly.Visible = gw <= w - x
	place(t.GemsOnly, x, 0, math.max(0, w - x), 40)
end

function L.heroPC(t, w, M)
	local ref = M.Ref
	local art = M.HeroArt
	local artH = math.floor(art * 1.15)
	local ep = ref and K.HERO_EGG.Ref or K.HERO_EGG.Shrunk
	local vaultH = M.Hero - (M.Ref and 16 or 6)
	-- (kit-b P2 fix6, icons look pol1 #2: a tablet's card, 864 wide at 1024 x 768, left the texts w - 305 - 340 = 219 px:
	-- "SECRET...", the odds under the button, "Available at the...", its padlock outside the chip) the texts start at
	-- ep[3] while the title has its 46 px there; a narrower card's art column gives up the room it holds empty: down to
	-- the vault's own width (its cells come from the column's height, so a column cw / ch of that height draws the same
	-- cells) or to the drawn machine's box (the big egg goes)
	-- (the title reads in capitals: its role's; "Secret Roulette" measured 8 % short)
	local caps = Theme.Caps(t.Name)
	local want = H.textW(caps, 46, Theme.FontOf(t.Title)) + 2
	local x = ep[3]
	if w - x - 340 < want then
		local c = t.Machine.Sheet and t.Machine.Cell
		local least = c and (12 + math.ceil(vaultH * c[3] / c[4])) or (26 + art + 12)
		x = math.min(x, math.max(least, math.floor(w - 340 - want)))
	end
	local roomy = x >= ep[3]
	-- (Pitch 2 item 10 A) the sheet's vault stands on its own stage left of the big egg (Task 26), not under it; today's
	-- drawn machine keeps its whole box (the egg overlaps its edge, as before)
	if t.Machine.Sheet then
		-- (P2 icons review r1, major 3) the vault alone, as tall as the card allows (3 px cells at 1920), centred in the art
		-- column left of the texts: the big egg goes (two hero objects fought there)
		-- (its foot 14 px over the card's foot on REF, clear of the colour lip; 4 px on the shorter plans, so 1280 keeps 2 px)
		L.heroSheetArt(t, 4, 2, x - 12, vaultH)
	else
		place(t.Machine.Root, 26, ref and 10 or 8, art, artH)
		t.Machine.AlignX = 0
		H.sizeMachine(t.Machine, art)
		-- (Task 26) the big egg between the machine and the texts, centred in the card's height
		local ew = math.floor(EggArt.Metrics.WIDTH * ep[1] + 0.5)
		EggArt.Resize(t.Egg, ep[1])
		place(t.Egg, ep[2], (M.Hero - ep[1]) / 2, ew, ep[1])
		t.Egg.Visible = roomy
	end
	local tw = w - x - 340
	t.Title.Text = t.Name
	-- (fix6) the title steps down from 46 px while it is wider than its column (36 at 1024 x 768)
	local ts = 46
	while ts > 28 and H.textW(caps, ts, Theme.FontOf(t.Title)) + 2 > tw do
		ts = ts - 1
	end
	t.Title.TextSize = ts
	place(t.Title, x, ref and 22 or 12, tw, 56)
	local oy = ref and 84 or 76
	place(t.Odds, x, oy, tw, 40)
	L.heroOddsPC(t, tw)
	place(t.NoOdds, x, oy, tw, 40)
	t.NoOdds.TextSize = 22
	local cy = ref and 132 or 124
	-- (fix6) on a narrow card the chips end 8 px short of the hint's line (w - 380: its longest line, 358 px, whole) and
	-- take the line that fits them (ShopEggs.Refresh: "At the Storm Altar", "Secret in N")
	local chipMax = roomy and tw or math.max(0, math.min(tw, w - 388 - x))
	place(t.Pity, x, cy, math.min(400, chipMax), 48)
	t.Pity.TextSize = 22
	-- (shop-area) the altar chip in the pity chip's place, as wide as its long line needs (400 at least)
	t.AltarChip.TextSize = 22
	local chipW = math.min(chipMax, math.max(400, H.textW(K.TEXT.AltarLock, 22, Theme.FontOf(t.AltarChip)) + 32 + 26)) -- (+ the padlock and its gap)
	place(t.AltarChip, x, cy, chipW, 48)
	t.Dim.Position = UDim2.fromOffset(0, 0)
	t.Dim.Size = UDim2.new(0, x - 8, 1, 0) -- the machine and the big egg; the texts from x stay clear
	place(t.Lock, x, cy, tw, 48)
	t.Lock.TextSize = 20
	-- (Pitch 2 look review r0, crop 06: on the tight 180 px hero the line sat 4 px over the card's foot) the hint's box ends
	-- CARD_FOOT over the card's bottom: 22 px tall under the button on a tight hero. (P2 icons look pol0, minor: there, at
	-- 1280, the line's text met the button's 5 px wood edge and its descenders the purple lip) on a hero too short for the
	-- 28 px box the button rises so a 24 px box fits 2 px under its wood edge
	local holderY = ref and 66 or 46
	local hy, hh = ref and 172 or 152, 28
	if hy + hh > M.Hero - K.CARD_FOOT then
		hh = 24
		hy = M.Hero - K.CARD_FOOT - hh
		holderY = math.min(holderY, hy - 2 - 5 - 100)
	end
	place(t.Holder, w - 320, holderY, 290, 100)
	place(t.Spin.Button, 0, 0, 290, 100)
	H.arrange(t.Spin, 290, 100, 34, 44)
	-- (P2 icons look fin0, minor) the signpost 27 px, 3 px cells (the screen's glyph cell, the mock-up's): 44 drew it 36
	-- px, the sheet's art at 2 px cells (4 px as the glyph)
	-- (Pitch 2 item 13 A) "Show the way" is twice "Travel"'s length: 30 px keeps it inside the 290 px plank in FredokaOne
	-- (kit-b merge, icons 9 B x world 13 A) both kept: the world lane's 30 px word, the icons lane's 30 px signpost box
	H.arrangeTravel(t.Travel, 290, 100, 30, 30)
	t.Hint.Visible = true
	t.Hint.TextSize = 18
	t.Hint.TextWrapped = false -- (the phone card wraps its line; a turn back to the PC plan takes the one line again)
	-- (shop-area) the long hints, "Secret rolls happen at the Storm Altar" and (Pitch 2 item 13 A) "A gold arrow leads you
	-- to the Storm Altar", run ~322-350 px at 18 ("You are at the Storm Altar" is shorter; the shop tests measure them in
	-- the real face): one line from
	-- w - 380 to 10 px short of the card's edge, starting 8 px clear of the chips when they reach that far
	local hintL = math.max(w - 380, x + chipW + 8)
	place(t.Hint, hintL, hy, w - 10 - hintL, hh)
end

function L.cardPC(t, w, M, tall)
	if t.Machine.Sheet then
		return L.cardSheetPC(t, w, M, tall)
	end
	local row2H = tall and 56 or 48
	t.Plate.Text = t.Name
	t.Plate.TextSize = 24
	place(t.Plate, 12, 12, w - 24, 54)
	local artH = math.floor(M.Art * 1.15 + 0.5)
	place(t.Machine.Root, (w - M.Art) / 2, 76, M.Art, artH)
	H.sizeMachine(t.Machine, M.Art)
	local rowsH = M.RowsH or 160
	place(t.Odds, 16, M.RowsY, w - 32, rowsH)
	local n = #t.Rows
	local rh = n > 4 and math.floor(rowsH / n) or math.min(40, math.floor(rowsH / math.max(1, n)))
	local iw = w - 32
	for i, row in ipairs(t.Rows) do
		place(row.Root, 0, (i - 1) * rh, iw, rh)
		local px = math.min(28, rh - 8)
		local ew = H.sizeEgg(row.Egg, px)
		place(row.Egg, 4, (rh - px) / 2, ew, px)
		row.Word.Visible = true
		row.Word.TextSize = 20
		place(row.Word, 36, 0, iw - 36 - 72, rh)
		row.Pct.TextSize = 22
		row.Pct.TextXAlignment = RIGHT
		place(row.Pct, iw - 72, 0, 72, rh)
	end
	t.NoOdds.TextSize = 20
	place(t.NoOdds, 16, M.RowsY, w - 32, rowsH)
	local spinH = M.Tight and 56 or 64 -- (P2 icons look pol0, minor: L.plan's TIGHT)
	place(t.Spin.Button, 14, M.SpinY, w - 28, spinH)
	H.arrange(t.Spin, w - 28, spinH, 23, 26)
	local half = math.floor((w - 38) / 2)
	place(t.Spin3.Button, 14, M.Row2Y, half, row2H)
	H.arrange(t.Spin3, half, row2H, 18, 20)
	place(t.SpinGems.Button, w - 14 - half, M.Row2Y, half, row2H)
	H.arrange(t.SpinGems, half, row2H, 18, 22)
	t.Hint.Visible = true
	t.Hint.TextSize = 18
	if M.Tight then
		-- the line's own height, 2 px under the planks' 5 px edge and 5 px shadow (L.plan)
		place(t.Hint, 8, M.Row2Y + row2H + 12, w - 16, 18)
	else
		local hy = M.Row2Y + row2H + 2
		place(t.Hint, 8, hy, w - 16, math.max(16, M.Card - K.CARD_FOOT - hy))
	end
end

-- the PC / Compact plan for a body Hh tall: REF, SHRUNK, or TIGHT worked out from Hh (the two button rows 64 + 56 and
-- the hint at the card's foot, the odds rows above them)
function L.plan(Hh)
	if Hh >= K.FIT_H then
		return K.REF
	end
	local S = K.SHRUNK
	if Hh >= S.CardsY + S.Card + K.BODY_FOOT then
		return S
	end
	local T = K.TIGHT
	local card = math.max(T.MinCard, Hh - T.CardsY - K.BODY_FOOT)
	-- (P2 icons look pol0, minor: today's machines at 1280, the shipping look: "Gems: same odds" started 2 px under the
	-- x3 / gem planks' box, under their 5 px wood edge and 5 px shadow, its tops cut) the line (18 tall) ends 2 px over the
	-- card's 5 px colour lip and starts 2 px under the planks' shadow; the Spin plank gives the 8 px back (56: 44.8 screen
	-- px under the 0.8 Fit, still a touch target; L.cardPC), so the odds rows keep their room
	local row2Y = card - 5 - 2 - 18 - 12 - 56
	local spinY = row2Y - 8 - 56
	return {
		Ref = false, Tight = true, Hero = T.Hero, HeroArt = T.HeroArt, CardsY = T.CardsY, Card = card, Art = T.Art, RowsY = T.RowsY,
		RowsH = math.max(96, spinY - 6 - T.RowsY), SpinY = spinY, Row2Y = row2Y,
	}
end

function L.pc(P, W, Hh)
	local M = L.plan(Hh)

	local tall = P.Mode == "Compact" or not M.Ref
	local s = P.Scroll
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	-- the card row: (w - 48) / 4 each; under 250 it scrolls sideways (with room for its bar)
	local E, D = K.CARD_EDGE, (Theme.Finish and Theme.Finish.Card) or 5
	local function plan(cw)
		local cardW = math.floor((cw - 48 - 2 * E - D) / 4)
		local sideways = cardW < 250
		if sideways then
			cardW = 250
		end
		local bar = sideways and (K.SCROLLBAR + 4) or 0
		return cardW, sideways, M.Card + 2 * E + D + bar, M.CardsY + M.Card + bar + K.BODY_FOOT
	end
	local cw = W
	local cardW, sideways, rowH, contentH = plan(cw)
	if contentH > Hh + 0.5 then
		-- the page scrolls: the content stops short of its bar
		cw = W - K.SCROLLBAR - 2
		cardW, sideways, rowH, contentH = plan(cw)
	end
	s.CanvasSize = UDim2.fromOffset(0, contentH)
	P.Hero.Title.TextXAlignment = LEFT
	place(P.Hero.Root, E, 16, cw - 2 * E - D, M.Hero)
	L.heroPC(P.Hero, cw - 2 * E - D, M)
	place(P.Row, 0, M.CardsY - E, cw, rowH)
	P.Row.ScrollingDirection = Enum.ScrollingDirection.X
	local rowW = #P.Cards * (cardW + 16) - 16 + 2 * E + D
	P.Row.CanvasSize = UDim2.fromOffset(sideways and rowW or cw, 0)
	for i, t in ipairs(P.Cards) do
		place(t.Root, E + (i - 1) * (cardW + 16), E, cardW, M.Card)
		L.cardPC(t, cardW, M, tall)
	end
	P.CanvasW = 0
end

-- the phone's padding over a card's bottom rows (6 at 238 tall, 22 at 266)
local function phonePad(th)
	return math.max(6, 6 + math.floor((th - 238) * 16 / 28))
end

-- a phone odds row: one column per rarity, the egg 30 over its percent (15 px)
function L.phoneOdds(t, x, y, w)
	place(t.Odds, x, y, w, 50)
	local n = math.max(1, #t.Rows)
	local cw = w / n
	for i, row in ipairs(t.Rows) do
		place(row.Root, (i - 1) * cw, 0, cw, 50)
		local ew = H.sizeEgg(row.Egg, 30)
		place(row.Egg, (cw - ew) / 2, 0, ew, 30)
		row.Word.Visible = false
		row.Pct.TextSize = 15
		row.Pct.TextXAlignment = CENTER
		place(row.Pct, 0, 32, cw, 18)
	end
	t.NoOdds.TextSize = 15
	place(t.NoOdds, x, y, w, 50)
end

----------------------------------------------------------------------
-- (Pitch 2 item 10 A "Workshop machines": the mock-ups 10_optA.png / 10_optA_phone.png; P2 icons review r1, majors 1 - 3)
-- the layouts once the machines sheet has an id (t.Machine.Sheet). Each box is sized so its machine draws whole px cells:
-- 3 at 1920, 2 at 1280 (the window's 0.8) and on a phone. Without an id every layout above stays today's
----------------------------------------------------------------------
-- (P2 icons review r1, major 1 + the 1280 minor: the vector egg sat 1.6 px from the wood, "60%" 0.4 px from it) a chip's
-- pixel egg and its percent, laid out again whenever the rest scale above changes: the egg at eggPx (a multiple of 9: 3
-- screen px cells at 1920, 2 under the 1280 window's 0.8 and on a phone) over the percent when the face holds both, else
-- beside it; where neither fits, one cell size down (18 px). What is fitted is the egg as drawn: its 9 cells on whole
-- screen px and its 1-cell drop shadow (PixelIcon.BoxPx), the percent's text 2 px or more clear of the chip's sides
function L.chipEgg(row, cw, face, eggPx, size)
	PixelIcon.Whole(row.Root, function(s)
		local tw = H.textW(row.Pct.Text, size, Theme.FontOf(row.Pct)) + 2
		local px = math.max(9, 9 * math.floor(eggPx / 9))
		-- (P2 icons look fin0, major 1) the egg a screen px under the chip's top, the percent's box its text's height: the
		-- 1280 chip holds the 18 px percent (14.4 screen px, the readability floor) over its egg again
		local lid = 1 / s
		local side, drawn, over
		while true do
			side = PixelIcon.BoxPx(px, 0, s) -- the 9 cells, whole screen px, in design px
			drawn = side * 10 / 9 -- + the drop shadow's cell
			over = face >= lid + drawn + 1 + size and cw >= math.max(drawn, tw) + 4
			if over or (face >= drawn and cw >= drawn + 4 + tw + 4) or px <= 18 then
				break
			end
			px = math.max(18, px - 9)
		end
		local icon = H.pixelEgg(row, px)
		if not icon then
			return
		end
		-- New / FromSheet centre the cells in the px box (pad, on a whole screen px): undo it so the cells start at ex, ey
		local sc = side * s / 9
		local pad = math.floor((px * s - 9 * sc) / 2) / s
		local function at(ex, ey)
			icon.Position = UDim2.fromOffset(math.floor(ex * s) / s - pad, math.floor(ey * s) / s - pad)
		end
		if over then
			-- the room left split over and under, in whole screen px (a floor in design px left the 1280 egg on the wood)
			local top = math.max(lid, math.floor((face - (drawn + 1 + size)) * s / 2 + 0.5) / s)
			at((cw - side) / 2, top)
			row.Pct.TextXAlignment = CENTER
			place(row.Pct, 0, top + drawn + 1, cw, size)
		else
			local x0 = math.max(2, math.floor((cw - (drawn + 4 + tw)) / 2))
			at(x0, math.max(0, (face - drawn) / 2))
			row.Pct.TextXAlignment = LEFT
			place(row.Pct, x0 + drawn + 4, 0, math.max(0, cw - x0 - drawn - 4), face)
		end
	end)
end

-- the odds rows as egg chips (H.syncRows gave them their stone block) in a grid of `cols` columns in x, y, w x h: the egg
-- over its percent when the chip is tall enough, else beside it
function L.chips(t, x, y, w, h, cols, eggPx, size, gap)
	place(t.Odds, x, y, w, h)
	t.NoOdds.TextSize = size
	place(t.NoOdds, x, y, w, h)
	local n = math.max(1, #t.Rows)
	cols = math.max(1, math.min(cols, n))
	local rows = math.ceil(n / cols)
	local cw = math.floor((w - gap * (cols - 1)) / cols)
	local chH = math.floor((h - gap * (rows - 1)) / rows)
	local face = chH - 3 -- over the chip's 3 px lip
	for i, row in ipairs(t.Rows) do
		local col, line = (i - 1) % cols, math.floor((i - 1) / cols)
		place(row.Root, col * (cw + gap), line * (chH + gap), cw, chH)
		row.Word.Visible = false
		row.Pct.TextSize = size
		if row.Chip and H.canPixelEgg(row) then
			-- (P2 icons review r1, major 1) a card's chip: the hand-pixelled egg, not the vector one
			row.Egg.Visible = false
			L.chipEgg(row, cw, face, eggPx, size)
		elseif face >= eggPx + size + 8 then
			local ew = H.sizeEgg(row.Egg, eggPx)
			local top = math.floor((face - eggPx - size - 2) / 2)
			place(row.Egg, math.floor((cw - ew) / 2), top, ew, eggPx)
			row.Pct.TextXAlignment = CENTER
			place(row.Pct, 0, top + eggPx + 1, cw, size + 2)
		else
			local px = math.min(eggPx, face - 4)
			local ew = H.sizeEgg(row.Egg, px)
			local tw = H.textW(row.Pct.Text, size, Theme.FontOf(row.Pct)) + 2
			local x0 = math.max(2, math.floor((cw - (ew + 4 + tw)) / 2))
			place(row.Egg, x0, math.floor((face - px) / 2), ew, px)
			row.Pct.TextXAlignment = LEFT
			place(row.Pct, x0 + ew + 4, 0, math.max(0, cw - x0 - ew - 4), face)
		end
	end
end

-- a PC card: the name plate, the machine on a stage as wide as the plate, one row of egg chips, Spin, x3 + gems, and the
-- hint; the Spin rows and the hint K.LIFT px higher than before (the line clears the card's colour lip). TIGHT (1280 x 720)
-- takes a shorter plate and chips so the stage still holds 2 screen px cells
function L.cardSheetPC(t, w, M, tall)
	local tight = M.Tight == true
	local row2H = tall and 56 or 48
	local plateH = tight and 44 or 54
	t.Plate.Text = t.Name
	t.Plate.TextSize = 24
	place(t.Plate, 12, 12, w - 24, plateH)
	local hintY = M.Card - K.CARD_FOOT - K.LIFT - 20
	-- the hint clear of the x3 / gem planks' 5 px drop shadow (TIGHT: 6, so its 2 px stage keeps its height)
	local row2Y = hintY - (tight and 6 or 8) - row2H
	-- (P2 icons review r1, major 1 + the 1280 minor) TIGHT: the pixel egg (2 screen px cells: 22.5 design px under the
	-- 0.8 Fit, + its drop shadow) over an 18 px percent (14.4 screen px: P2 icons look fin0, major 1), a screen px under
	-- the chip's top, fits a 49 px chip; the 10 px come off the Spin plank (56: 44.8 screen px, still a 44 px touch target)
	local spinH = tight and 56 or 64
	local spinY = row2Y - 8 - spinH
	local chipH = tight and 49 or (M.Ref and 60 or 56)
	-- (P2 icons look fin0, minor: the chips sat fused to the Spin plank) the chips' wood edge 6 px over the plank's at
	-- 1920 (the mock-up's gap: 13 less the two edges, 2 + 5), 3.2 screen px at 1280 (11 under the 0.8 Fit); TIGHT takes
	-- the 5 px from the chip (50 -> 49) and the stage's two gaps (8 -> 6): the stage keeps its 163 (2 px cells need 162.5)
	local chipsY = spinY - (tight and 11 or 13) - chipH
	local stageY = 12 + plateH + (tight and 6 or 8)
	place(t.Machine.Root, 12, stageY, w - 24, math.max(40, chipsY - (tight and 6 or 8) - stageY))
	t.Machine.AlignX = 0.5
	H.sizeMachine(t.Machine, M.Art)
	-- (P2 icons look pol0, minor: the chips 6 apart left 2 px of cream between their 2 px edges at 1920, ~1.6 at 1280; the
	-- 10_optA mock-up has 6) 10 apart: 6 px of cream at 1920, 4.8 at 1280 (chips 60 / 54 wide still hold "60%" over the egg)
	L.chips(t, 12, chipsY, w - 24, chipH, #t.Rows, tight and 18 or 27, 18, 10)
	place(t.Spin.Button, 14, spinY, w - 28, spinH)
	H.arrange(t.Spin, w - 28, spinH, 23, 26)
	local half = math.floor((w - 38) / 2)
	place(t.Spin3.Button, 14, row2Y, half, row2H)
	H.arrange(t.Spin3, half, row2H, 18, 20)
	place(t.SpinGems.Button, w - 14 - half, row2Y, half, row2H)
	H.arrange(t.SpinGems, half, row2H, 18, 22)
	t.Hint.Visible = true
	t.Hint.TextSize = 18
	place(t.Hint, 8, hintY, w - 16, 20)
end

-- the hero's vault alone in the art column left of the texts (x0 .. textX - 8), as tall as the card allows; no big egg
function L.heroSheetArt(t, x0, y0, w, h)
	place(t.Machine.Root, x0, y0, w, h)
	t.Machine.AlignX = 0.5
	H.sizeMachine(t.Machine, K.REF.HeroArt)
	t.Egg.Visible = false
end

-- a landscape phone card: the machine's stage on the left (2 px cells from a 212 px tile), the plate and a column of egg
-- chips right of it, Spin and x3 + gems full width under them (as today)
function L.cardSheetPhone(t, w, th)
	local pad = phonePad(th)
	local row2Y = th - pad - 44
	local spinY = row2Y - 50
	-- (P2 icons look fin1, minor) the chip column 84 wide (was 80) for the chips' 8 px gap below: the stage gives up 4 px
	-- (112 still holds a 53-cell drawing at 2 px cells)
	local sw = math.max(60, math.min(112, w - 6 - 6 - 6 - 84))
	local rx = 6 + sw + 6
	local rw = w - rx - 6
	-- (P2 icons look fin0, minor: the chips' edge lay 1 px under the Spin plank's) the stage and the chips end 12 px over
	-- the plank: the chips' wood edge 5 px clear of its edge. (P2 icons look pol0, majors: at 640 x 360 / 667 x 375 the
	-- stage, 120 / 127 tall, was too short for the 2 px drawing (it fell to 1 px, a small machine in an empty stage), and
	-- the chips, 37 tall at 640, put each percent beside its egg, cut to "...") the upper band runs from 2 px under the
	-- card's top (under its 2 px finish shine: the plate's wood edge's top) to 3 px of cream over the plank's 5 px wood
	-- edge: the stage 2 .. spinY - 8 (its rim is inside its box), the plate 26 tall, the chips 3 px of cream under its
	-- edge down to the same line (their 2 px edges outside the box): 640's chips 40 tall hold the 15 px percent over its
	-- egg; its stage (128) holds the 2 px cells over one cell of floor (H.layoutSheetMachine)
	place(t.Machine.Root, 6, 2, sw, spinY - 10)
	t.Machine.AlignX = 0.5
	H.sizeMachine(t.Machine, 45)
	t.Plate.Text = t.Id
	t.Plate.TextSize = rw < 90 and 15 or 17
	place(t.Plate, rx, 5, rw, 26)
	-- (P2 icons review r1, major 1) two columns of tall chips, the pixel egg (2 px cells) over its percent as on PC: in one
	-- column the chips were 20 px faces, the egg and its drop shadow flush on the wood. (P2 icons look fin1, minor: the
	-- chips' 2 px wood edges met in a 4 px gap, fused into one line, and the plate's edge touched the grid) 8 px apart:
	-- 4 px of cream between the edges (chips 38 wide: the real "60%", ~30 px, stays over its egg)
	L.chips(t, rx, 39, rw, spinY - 10 - 39, 2, 20, 15, 8)
	place(t.Spin.Button, 6, spinY, w - 12, 44)
	H.arrange(t.Spin, w - 12, 44, 16, 18)
	local half = math.floor((w - 18) / 2)
	place(t.Spin3.Button, 6, row2Y, half, 44)
	H.arrange(t.Spin3, half, 44, 15, 15)
	place(t.SpinGems.Button, w - 6 - half, row2Y, half, 44)
	H.arrange(t.SpinGems, half, 44, 15, 16)
	t.Hint.Visible = false
end

-- a portrait card (the phone mock-up): the plate, the stage on the left (2 px cells), a 2 x 2 grid of egg chips and the
-- hint right of it, Spin and x3 + gems full width under them
function L.cardSheetPortrait(t, w, h)
	t.Plate.Text = t.Name
	t.Plate.TextSize = 20
	place(t.Plate, 8, 8, w - 16, 34)
	place(t.Machine.Root, 8, 48, 128, h - 104 - 8 - 48)
	t.Machine.AlignX = 0.5
	H.sizeMachine(t.Machine, 64)
	local rx = 144
	local rw = w - rx - 8
	-- (P2 icons look pol0, minor: 2 px of cream between the chips' edges, the phone mock-up has about 7) 10 apart: 6 px
	L.chips(t, rx, 52, rw, 82, 2, 22, 15, 10)
	t.Hint.Visible = true
	t.Hint.TextSize = 15
	place(t.Hint, rx, 140, rw, 20)
	place(t.Spin.Button, 8, h - 104, w - 16, 46)
	H.arrange(t.Spin, w - 16, 46, 18, 20)
	local half = math.floor((w - 24) / 2)
	place(t.Spin3.Button, 8, h - 52, half, 44)
	H.arrange(t.Spin3, half, 44, 15, 16)
	place(t.SpinGems.Button, w - 8 - half, h - 52, half, 44)
	H.arrange(t.SpinGems, half, 44, 15, 16)
end

function L.heroPhone(t, w, th)
	local pad = phonePad(th)
	-- (P2 icons look pol0, major: at 640 x 360 / 667 x 375 the vault's column, 126 / 133 tall, was short of the 2 px
	-- drawing's 138, so it drew at 1 px a cell, half size) where the card is that short, the altar / pity / lock chip (a
	-- label, not a touch target) gives up to 12 px (44 -> 32: its 15 px line still fits) so the vault keeps 2 px cells
	local chipH = 44
	if t.Machine.Sheet and t.Machine.Cell then
		local short = 2 * t.Machine.Cell[4] - (th - pad - 94 - 12)
		if short > 0 then
			chipH = math.max(32, 44 - short)
		end
	end
	local chipY = th - pad - 50 - chipH
	t.Title.Text = "Secret"
	t.Title.TextSize = 17
	t.Title.TextXAlignment = CENTER
	t.GemsOnly.Visible = false
	if t.Machine.Sheet then
		-- (P2 icons review r1, major 1) the vault at 2 px cells on the left over the chip, the title and the odds right of it
		local vw = math.max(64, math.min(122, w - 6 - 6 - 6 - 72))
		local rx = 6 + vw + 6
		local rw = w - rx - 6
		L.heroSheetArt(t, 6, 6, vw, chipY - 12)
		place(t.Dim, 0, 0, rx - 3, chipY - 3)
		t.Title.TextSize = rw < 80 and 15 or 17
		place(t.Title, rx, 6, rw, 30)
		-- the two odds one over the other (the egg beside its percent), as on the portrait phone
		L.chips(t, rx, 40, rw, 72, 1, 26, 15, 4)
	else
		place(t.Title, 6, 6, w - 12, 30)
		place(t.Machine.Root, 8, 40, 64, 74)
		H.sizeMachine(t.Machine, 64)
		place(t.Dim, 0, 36, 76, 82) -- the machine only
		t.Egg.Visible = false -- (Task 26: no room on the phone card)
		L.phoneOdds(t, 80, 40, w - 88)
	end
	place(t.Pity, 6, chipY, w - 12, chipH)
	t.Pity.TextSize = 15
	place(t.AltarChip, 6, chipY, w - 12, chipH)
	t.AltarChip.TextSize = 15
	place(t.Lock, 6, chipY, w - 12, chipH)
	t.Lock.TextSize = 15
	place(t.Holder, 6, th - pad - 44, w - 12, 44)
	place(t.Spin.Button, 0, 0, w - 12, 44)
	H.arrange(t.Spin, w - 12, 44, 16, 18)
	H.arrangeTravel(t.Travel, w - 12, 44, 16, 18)
	-- (Pitch 2 look review r0, minor 5: a landscape phone away from the lobby had no "Home first" line before the tap) the
	-- short away / match line in the band between the machine and the altar chip, wrapped; only while that band holds
	-- one 15 px row (H.paint shows it away from the lobby or held by a match, never in the plain lobby state)
	t.Hint.TextSize = 15
	t.Hint.TextWrapped = true
	-- (kit-b wave-2 merge, icons item 10 A x world item 13 A) with the vault drawn (P2 icons r1) the left column down to the
	-- chip is the vault's, so the line takes the odds column beside it (under the odds' 112 px foot); today's drawn
	-- machine ends at 114, so there the line keeps the full width. It shows only where its wrapped rows fit (H.paint)
	local hx, hw = 6, w - 12
	if t.Machine.Sheet then
		hx = 6 + math.max(64, math.min(122, w - 6 - 6 - 6 - 72)) + 6
		hw = w - hx - 6
	end
	local hh = chipY - 2 - 116
	place(t.Hint, hx, 116, hw, hh)
	local rows = 1
	for _, s in ipairs({ K.TEXT.HeroHintLobbyShort, K.TEXT.HeroHintLocked }) do
		rows = math.max(rows, math.ceil((H.textW(s, 15, Theme.FontOf(t.Hint)) + 2) / math.max(1, hw)))
	end
	t.PhoneHintRoom = hh >= rows * 15 + 2
	t.Hint.Visible = false
end

function L.cardPhone(t, w, th)
	if t.Machine.Sheet then
		return L.cardSheetPhone(t, w, th)
	end
	local pad = phonePad(th)
	t.Plate.Text = t.Id
	t.Plate.TextSize = 17
	place(t.Plate, 6, 6, w - 12, 30)
	local row2Y = th - pad - 44
	local spinY = row2Y - 50
	local oddsY = spinY - 54
	local artH = math.max(24, oddsY - 4 - 40)
	local artW = math.floor(artH * 200 / 230 + 0.5)
	place(t.Machine.Root, (w - artW) / 2, 40, artW, artH)
	H.sizeMachine(t.Machine, artW)
	L.phoneOdds(t, 6, oddsY, w - 12)
	place(t.Spin.Button, 6, spinY, w - 12, 44)
	H.arrange(t.Spin, w - 12, 44, 16, 18)
	local half = math.floor((w - 18) / 2)
	place(t.Spin3.Button, 6, row2Y, half, 44)
	H.arrange(t.Spin3, half, 44, 15, 15)
	place(t.SpinGems.Button, w - 6 - half, row2Y, half, 44)
	H.arrange(t.SpinGems, half, 44, 15, 16)
	t.Hint.Visible = false
end

-- (Pitch 2 fix round B, T1 look leftover 5: at 844x390 the More arrow sat on the Sky card's odds and the next card's gem
-- price '60' read '6') the Secret card and the four cards share one width (at least K.TILE), sized so the row's viewport
-- holds n WHOLE cards; the viewport ends there and the More arrow sits in the gutter right of it (K.MORE_GUTTER at least),
-- on no card. A drag that stops between two cards snaps to the nearest whole card (H.queueSnap)
function L.phone(P, W, Hh)
	local s = P.Scroll
	s.ScrollingDirection = Enum.ScrollingDirection.X
	local th = math.min(K.TILE_MAX, Hh - 12)
	local y = math.floor((Hh - th) / 2)
	local gap = K.STEP - K.TILE
	local items = 1 + #P.Cards
	-- (fix6, P2 icons look pol1 #1: from 720 to 960 wide the row fitted 3-4 cards of 166-199, whose stages held the sheet's
	-- machines at 1 px cells only, half size in an empty stage, the x3 plank's coin on its words) with the sheet's
	-- machines a card is never narrower than K.TILE_SHEET: fewer whole cards, each drawn at 2 px cells
	local minTile = (P.Hero and P.Hero.Machine and P.Hero.Machine.Sheet) and K.TILE_SHEET or K.TILE
	local n = math.max(1, math.min(items, math.floor((W - K.MORE_GUTTER + gap) / (minTile + gap))))
	local room = n < items and (W - K.MORE_GUTTER) or W
	local tile = math.min(minTile == K.TILE_SHEET and K.TILE_WIDE_SHEET or K.TILE_WIDE, math.max(minTile, math.floor((room - (n - 1) * gap) / n)))
	local pitch = tile + gap
	local viewW = math.min(W, n * pitch - gap)
	place(s, 0, 0, viewW, Hh)
	place(P.Fade, viewW, 0, W - viewW, Hh)
	place(P.Hero.Root, 0, y, tile, th)
	L.heroPhone(P.Hero, tile, th)
	local rowW = #P.Cards * pitch - gap
	place(P.Row, pitch, y, rowW, th)
	P.Row.CanvasSize = UDim2.fromOffset(rowW, 0) -- (no scroll of its own: the page's row scrolls)
	for i, t in ipairs(P.Cards) do
		place(t.Root, (i - 1) * pitch, 0, tile, th)
		L.cardPhone(t, tile, th)
	end
	P.CanvasW = pitch + rowW
	P.ViewW, P.Pitch = viewW, pitch
	s.CanvasSize = UDim2.fromOffset(P.CanvasW, 0)
end

-- (fix round B) the phone row snaps to a whole card once a drag or its glide has rested K.SNAP_DELAY s
function H.snap(P)
	local s = P.Scroll
	if P.Mode ~= "Phone" or not (P.Pitch and P.ViewW) or not s then
		return
	end
	local k = s.AbsoluteSize.X / math.max(1, P.ViewW) -- screen px per layout px
	local pitch = P.Pitch * k
	if pitch <= 0 then
		return
	end
	local maxX = math.max(0, P.CanvasW * k - s.AbsoluteSize.X)
	local x = s.CanvasPosition.X
	local want = math.min(maxX, math.floor(x / pitch + 0.5) * pitch)
	if math.abs(want - x) > 0.5 then
		s.CanvasPosition = Vector2.new(want, s.CanvasPosition.Y)
	end
end

function H.queueSnap(P)
	if P.Mode ~= "Phone" or not P.Pitch then
		return
	end
	P.SnapToken = (P.SnapToken or 0) + 1
	local mine = P.SnapToken
	task.delay(K.SNAP_DELAY, function()
		if P.SnapToken == mine then
			pcall(H.snap, P)
		end
	end)
end

-- a portrait odds grid (spec 16.3): two columns, each cell the egg 30 and the percent 15 beside it (no rarity word: at
-- 15 px "Legendary" + the percent does not fit a half-width cell; the egg's colour names the rarity, as on the phone)
function L.portraitOdds(t, x, y, w)
	place(t.Odds, x, y, w, 68)
	local gw = w / 2
	for i, row in ipairs(t.Rows) do
		local col = (i - 1) % 2
		local line = math.floor((i - 1) / 2)
		place(row.Root, col * gw, line * 36, gw, 32)
		local ew = H.sizeEgg(row.Egg, 30)
		place(row.Egg, 2, 1, ew, 30)
		row.Word.Visible = false
		row.Pct.TextSize = 15
		row.Pct.TextXAlignment = LEFT
		place(row.Pct, ew + 8, 0, math.max(0, gw - ew - 10), 32)
	end
	t.NoOdds.TextSize = 15
	place(t.NoOdds, x, y, w, 68)
end

function L.heroPortrait(t, w, h)
	t.Title.Text = t.Name
	t.Title.TextSize = 20
	t.Title.TextXAlignment = LEFT
	place(t.Title, 8, 8, w - 16, 30)
	t.GemsOnly.Visible = false
	if t.Machine.Sheet then
		-- (P2 icons review r1, major 1; the phone mock-up) the vault at 2 px cells on the left, the odds, the chip and the
		-- hint right of it, the button full width under them
		L.heroSheetArt(t, 8, 42, 128, h - 52 - 8 - 42)
		place(t.Dim, 0, 38, 140, h - 52 - 38)
		local rx, rw = 144, w - 152
		-- (P2 icons review r1, minor: a band of about 30 px of empty navy under the hint, beside the vault) the mock-up's
		-- column: the two odds one over the other (egg 30 beside its percent), the altar chip, the hint, down the vault's
		-- height. More than two odds keep the two-column grid
		local cy = 86
		if #t.Rows == 2 then
			place(t.Odds, rx, 46, rw, 68)
			for i, row in ipairs(t.Rows) do
				place(row.Root, 0, (i - 1) * 36, rw, 32)
				local ew = H.sizeEgg(row.Egg, 30)
				place(row.Egg, 2, 1, ew, 30)
				row.Word.Visible = false
				row.Pct.TextSize = 15
				row.Pct.TextXAlignment = LEFT
				place(row.Pct, ew + 8, 0, math.max(0, rw - ew - 10), 32)
			end
			t.NoOdds.TextSize = 15
			place(t.NoOdds, rx, 46, rw, 68)
			cy = 120
		else
			L.portraitOdds(t, rx, 46, rw)
		end
		place(t.Pity, rx, cy, rw, 36)
		t.Pity.TextSize = 15
		place(t.AltarChip, rx, cy, rw, 36)
		t.AltarChip.TextSize = 15
		place(t.Lock, rx, cy - 4, rw, 44)
		t.Lock.TextSize = 15
		-- (P2 icons look fin1, major: this was a one-line 188 x 20 box at 390 wide, so "A gold arrow leads you to the St..."
		-- and "Secret rolls happen at th..." were cut) the hint wraps at 15 px (the phone floor) in the band from the chip /
		-- lock line down to 2 px over the button: two rows hold every state's line at 390 wide; L.portrait makes the hero
		-- taller where the longest needs more (a 360-wide phone). The box starts 4 px left of the column (still 4 px clear
		-- of the vault's 136 px box) so "Home first, then the arrow" (~191 px in Nunito) keeps one row at 390 instead of
		-- leaving "arrow" alone on the second
		t.Hint.Visible = true
		t.Hint.TextSize = 15
		t.Hint.TextWrapped = true
		-- (P2 icons look pol0, minor: the box ran to 2 px over the button's box, under its 5 px wood edge, so the second
		-- row's 'y' touched the wood) the box ends 3 px over that edge; K.PORTRAIT_HERO_SHEET grew the 6 px it costs
		local hy = cy + 40
		place(t.Hint, rx - 4, hy, rw + 4, h - 52 - 8 - hy)
		place(t.Holder, 8, h - 52, w - 16, 44)
		place(t.Spin.Button, 0, 0, w - 16, 44)
		H.arrange(t.Spin, w - 16, 44, 18, 20)
		H.arrangeTravel(t.Travel, w - 16, 44, 18, 20)
		return
	end
	place(t.Machine.Root, 8, 44, 64, 74)
	H.sizeMachine(t.Machine, 64)
	place(t.Dim, 0, 40, 76, 82) -- the machine only
	t.Egg.Visible = false -- (Task 26: no room on the portrait card)
	L.portraitOdds(t, 80, 46, w - 88)
	place(t.Pity, 80, 84, w - 88, 32)
	t.Pity.TextSize = 15
	place(t.AltarChip, 80, 84, w - 88, 32)
	t.AltarChip.TextSize = 15
	place(t.Lock, 80, 80, w - 88, 40)
	t.Lock.TextSize = 15
	t.Hint.Visible = true
	t.Hint.TextSize = 15
	-- (P2 icons look fin1, major) one 20 px row at 390 wide; on a 360-wide phone "A gold arrow leads you to the Storm
	-- Altar" (~298 px in Nunito) ran past the 294 px box, so it wraps and L.portrait makes the hero a row taller
	t.Hint.TextWrapped = true
	place(t.Hint, 8, 122, w - 16, h - 52 - 6 - 122)
	place(t.Holder, 8, h - 52, w - 16, 44)
	place(t.Spin.Button, 0, 0, w - 16, 44)
	H.arrange(t.Spin, w - 16, 44, 18, 20)
	H.arrangeTravel(t.Travel, w - 16, 44, 18, 20)
end

function L.cardPortrait(t, w, h)
	if t.Machine.Sheet then
		return L.cardSheetPortrait(t, w, h)
	end
	t.Plate.Text = t.Name
	t.Plate.TextSize = 20
	place(t.Plate, 8, 8, w - 16, 34)
	place(t.Machine.Root, 8, 50, 64, 74)
	H.sizeMachine(t.Machine, 64)
	L.portraitOdds(t, 80, 50, w - 88)
	t.Hint.Visible = true
	t.Hint.TextSize = 15
	place(t.Hint, 80, 122, w - 88, 20)
	place(t.Spin.Button, 8, h - 104, w - 16, 46)
	H.arrange(t.Spin, w - 16, 46, 18, 20)
	local half = math.floor((w - 24) / 2)
	place(t.Spin3.Button, 8, h - 52, half, 44)
	H.arrange(t.Spin3, half, 44, 15, 16)
	place(t.SpinGems.Button, w - 8 - half, h - 52, half, 44)
	H.arrange(t.SpinGems, half, 44, 15, 16)
end

function L.portrait(P, W, Hh)
	local s = P.Scroll
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	local w = W - K.SCROLLBAR - 2
	local sheet = P.Hero.Machine.Sheet == true
	local heroH = sheet and K.PORTRAIT_HERO_SHEET or K.PORTRAIT_HERO
	-- (P2 icons look fin1, major) the hero's hint stays 15 px (the phone floor) and whole: its band holds two rows beside
	-- the vault (one under today's drawn machine); a 15 px row more of hero for each row its longest line needs beyond
	-- that (a 360-wide phone)
	local band = sheet and 2 or 1
	local hintW = sheet and (w - 148) or (w - 16)
	heroH = heroH + math.max(0, H.heroHintRows(hintW, 15, Theme.FontOf(P.Hero.Hint)) - band) * 15
	local cardH = sheet and K.PORTRAIT_CARD_SHEET or K.PORTRAIT_CARD
	place(P.Hero.Root, 0, 0, w, heroH)
	L.heroPortrait(P.Hero, w, heroH)
	local step = cardH + 8
	local rowH = #P.Cards * step - 8
	place(P.Row, 0, heroH + 8, w, rowH)
	P.Row.CanvasSize = UDim2.fromOffset(0, rowH) -- (no scroll of its own: the page scrolls)
	for i, t in ipairs(P.Cards) do
		place(t.Root, 0, (i - 1) * step, w, cardH)
		L.cardPortrait(t, w, cardH)
	end
	P.CanvasW = 0
	s.CanvasSize = UDim2.fromOffset(0, heroH + 8 + rowH + 8)
end

-- the phone's right fade: shown while more of the sideways row is to the right
function ShopEggs._SyncFade(page)
	local P = PAGES[page]
	if not P then
		return
	end
	local on = false
	if P.Mode == "Phone" then
		local s = P.Scroll
		local k = 1
		pcall(function()
			k = s.AbsoluteSize.X / math.max(1, P.ViewW or P.Box.W) -- (fix round B) the viewport ends before the More gutter
		end)
		local canvas = (P.CanvasW or 0) * k
		on = canvas > s.AbsoluteSize.X + 1 and s.CanvasPosition.X < canvas - s.AbsoluteSize.X - 1
	end
	P.Fade.Visible = on
end

function ShopEggs.Layout(page, box, mode)
	local P = PAGES[page]
	if not P then
		return
	end
	box = type(box) == "table" and box or P.Box
	local key = tostring(box.W) .. "x" .. tostring(box.H) .. tostring(mode or P.Mode)
	P.Box = { W = math.floor(tonumber(box.W) or 1240), H = math.floor(tonumber(box.H) or 834) }
	P.Mode = mode or P.Mode or "PC"
	P.Laid = true
	if key ~= P.LaidKey then
		-- a new size or layout: the old scroll offsets mean nothing there; start at the top-left
		P.LaidKey = key
		P.Scroll.CanvasPosition = Vector2.new(0, 0)
		P.Row.CanvasPosition = Vector2.new(0, 0)
	end
	local W, Hh = P.Box.W, P.Box.H
	place(P.Scroll, 0, 0, W, Hh)
	place(P.Fade, W - K.FADE, 0, K.FADE, Hh)
	P.ViewW, P.Pitch = nil, nil -- (fix round B) L.phone sets them
	if P.Mode == "Phone" then
		L.phone(P, W, Hh)
	elseif P.Mode == "Portrait" then
		L.portrait(P, W, Hh)
	else
		L.pc(P, W, Hh)
	end
	-- (a layout can change the short texts: the states and the chip follow it)
	ShopEggs.Refresh(page, true)
	ShopEggs._SyncFade(page)
	H.syncFx(P)
end

----------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------
-- shop-area (spec 16.17.3): the Secret roll is bought at the Storm Altar only (PetService.BuyRoulette checks the distance;
-- this only picks the card's look). The live reading (the character's HumanoidRootPart against the replicated altar
-- site) wins whenever it exists; FromAltar (the altar prompt's open) only stands in while there is none (no root, no
-- AltarIslandAt yet). Review round 1: FromAltar used to win until Close, so a player who opened the Shop at the altar
-- and walked off kept a live SPIN the server refused.
function ShopEggs.AtAltar()
	if ShopEggs._AtAltar ~= nil then
		return ShopEggs._AtAltar == true
	end
	local ok, at = pcall(function()
		local player = Players.LocalPlayer
		local char = player and player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (root ~= nil and root:IsA("BasePart")) or typeof(workspace:GetAttribute(Config.Lobby.ZoneAltarAttr)) ~= "Vector3" then
			return nil -- no live reading
		end
		return Config.AtAltar(root.Position, 0) == true
	end)
	if ok and at ~= nil then
		return at
	end
	return ALTAR.From == true
end

-- TRAVEL's look: true while the character stands in the lobby (Config.InLobbyZone, the server's rule for the trip);
-- with no live reading (no root) it stays true and the server decides. Tests: ShopEggs._InLobby (nil = live).
function ShopEggs.InLobby()
	if ShopEggs._InLobby ~= nil then
		return ShopEggs._InLobby == true
	end
	local ok, inLobby = pcall(function()
		local player = Players.LocalPlayer
		local char = player and player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (root ~= nil and root:IsA("BasePart")) then
			return nil
		end
		return Config.InLobbyZone(root.Position) == true
	end)
	if ok and inLobby ~= nil then
		return inLobby
	end
	return true
end

function ShopEggs.SetFromAltar(on)
	ALTAR.From = on == true
end

function ShopEggs.CardState(id, button)
	button = button or "Spin"
	if #H.odds(id) == 0 then
		return "NoOdds"
	end
	if EggStage.IsPending() then
		return "Pending"
	end
	local gems = id == K.SECRET or button == "SpinGems"
	-- (lobby-shop 16.12, the owner's pick A: the token spins lock too, as the server refuses them while not "Allowed".
	-- Release step 1, the owner's pick 2026-11-23: only while the Store is on; with the Store off a token button is
	-- never Locked, as on main. The gem buttons and the Secret card keep the lock in both states.)
	if attr("PaidRandomItemsRestricted") ~= false and (gems or StoreCatalog.Enabled()) then
		return "Locked"
	end
	if id == K.SECRET and not ShopEggs.AtAltar() then
		return "Altar"
	end
	if gems and attr("GemsSettled") ~= true then
		return "Loading"
	end
	local currency = gems and "Gems" or "Tokens"
	local price = H.price(id, currency) * ((button == "Spin3" and not gems) and 3 or 1)
	if H.balance(currency) < price then
		return "Short"
	end
	return "Ready"
end

-- amount: the price as a number, always in the game's one number style, Theme.Short ("3K", "15K", "250"). (Pitch 2 F0,
-- the owner's pick A: the prices read as the HUD's balances do; was "3,000" with separators, short only on the phone's x3
-- or when the row did not fit.) compact is kept for the callers (the phone's x3): the same short form
function H.paintButton(p, id, name, amount, short, compact)
	local st = ShopEggs.CardState(id, name)
	amount = tonumber(amount) or 0
	p.PriceShort = Theme.Short(amount)
	p.PriceFull = p.PriceShort
	p.Price.Text = p.PriceFull
	p.Price.TextColor3 = st == "Short" and SHORT or p.Ink
	local stateText = nil
	if st == "Locked" then
		stateText = K.TEXT.Locked
	elseif st == "Loading" then
		stateText = short and K.TEXT.LoadingShort or K.TEXT.Loading
	end
	p.StateText = stateText
	p.Word.Text = stateText or p.BaseWord
	local off = st == "NoOdds" or st == "Pending" or st == "Locked" or st == "Altar" or st == "Loading"
	if (p.Button:GetAttribute("Disabled") == true) ~= off then
		CloudUI.SetDisabled(p.Button, off) -- (only on a change: a repaint tweens the face)
	end
	H.arrange(p)
	return st
end

function H.pityText(short)
	local left = tonumber(attr("SecretPityLeft"))
	if attr("GemsSettled") ~= true or left == nil then
		return K.TEXT.Loading
	end
	left = math.max(1, math.floor(left))
	if short then
		return left <= 1 and "Secret next spin" or ("Secret in " .. left)
	end
	if left <= 1 then
		return "Secret for sure on the next spin"
	end
	return "Secret for sure in " .. left .. " more spins"
end

function ShopEggs.Refresh(page, fromLayout)
	local P = PAGES[page]
	if not P then
		return
	end
	local rebuilt = false
	for _, t in ipairs(H.all(P)) do
		if H.syncRows(t) then
			rebuilt = true
		end
	end
	if rebuilt and P.Laid and not fromLayout then
		ShopEggs.Layout(page, P.Box, P.Mode) -- (it repaints)
		return
	end
	local short = P.Mode == "Phone"
	for _, t in ipairs(P.Cards) do
		t.Odds.Visible = t.HasOdds == true
		t.NoOdds.Visible = t.HasOdds ~= true
		local unit = H.price(t.Id, "Tokens")
		H.paintButton(t.Spin, t.Id, "Spin", unit, short)
		-- (review round 3) the phone's 74 px x3 button: the short total from 1,000 up ("3K"; "3,000" ran onto the gem button)
		H.paintButton(t.Spin3, t.Id, "Spin3", 3 * unit, short, short)
		H.paintButton(t.SpinGems, t.Id, "SpinGems", H.price(t.Id, "Gems"), short)
	end
	local h = P.Hero
	h.Odds.Visible = h.HasOdds == true
	h.NoOdds.Visible = h.HasOdds ~= true
	H.paintButton(h.Spin, K.SECRET, "Spin", H.price(K.SECRET, "Gems"), short)
	local restricted = attr("PaidRandomItemsRestricted")
	local locked = restricted ~= false
	local brief = P.Mode == "Phone" or P.Mode == "Portrait"
	-- (shop-area 16.17.3) away from the Storm Altar: the Dim, the altar chip and TRAVEL (Locked keeps its own card)
	local altar = not locked and not ShopEggs.AtAltar()
	h.Lock.Visible = locked
	h.Pity.Visible = not locked and not altar
	-- (P2 icons review r1, major 3) the vault stays bright (the altar chip's padlock says why): the Dim veils today's drawn
	-- machine only (H.showSheets keeps it so when the page's look changes)
	h.Away = altar
	h.Dim.Visible = altar and not H.sheetShown(h)
	h.AltarChip.Visible = altar
	-- (P2 icons look pol0, major) the phone line while it fits the chip's room beside its padlock (the chip less its
	-- UIPadding, 2 px spare), else the tiny one: never a cut "At the Storm Al." (kit-b P2 fix6, icons look pol1 #2) the
	-- PC chip the same way from its long line: a tablet's narrow chip (L.heroPC) reads the phone's
	local chipText = brief and K.TEXT.AltarLockShort or K.TEXT.AltarLock
	local pad = h.AltarChip:FindFirstChildOfClass("UIPadding")
	local room = h.AltarChip.Size.X.Offset - (pad and (pad.PaddingLeft.Offset + pad.PaddingRight.Offset) or 0)
	local function fits(line)
		return H.textW(line, h.AltarChip.TextSize, Theme.FontOf(h.AltarChip)) + 2 <= room
	end
	if brief then
		if not fits(chipText) then
			chipText = K.TEXT.AltarLockTiny
		end
	elseif h.AltarChip.Size.X.Offset > 0 and not fits(chipText) then
		-- (laid out: before its first layout it keeps the long line)
		chipText = fits(K.TEXT.AltarLockShort) and K.TEXT.AltarLockShort or K.TEXT.AltarLockTiny
	end
	h.AltarChip.Text = chipText
	h.Travel.Button.Visible = altar
	h.Spin.Button.Visible = not altar
	-- (Pitch 2 item 13 A) away from the lobby the guide routes home first, so the button stays live and the hint says so;
	-- it greys only while a match / battle / run holds the player (it greyed whenever away: the teleport needed the lobby)
	local held = altar and H.tripLocked()
	local away = altar and not held and not ShopEggs.InLobby()
	if (h.Travel.Button:GetAttribute("Disabled") == true) ~= held then
		CloudUI.SetDisabled(h.Travel.Button, held)
	end
	local lobbyHint = brief and K.TEXT.HeroHintLobbyShort or K.TEXT.HeroHintLobby
	h.Hint.Text = (locked and K.TEXT.HeroHint) or (held and K.TEXT.HeroHintLocked) or (away and lobbyHint)
		or (altar and K.TEXT.HeroHintTravel) or K.TEXT.HeroHintHere
	if P.Mode == "Phone" then
		-- (Pitch 2 look review r0, minor 5) the phone card says why the button routes home / is greyed, before the tap
		h.Hint.Visible = (away or held) and h.PhoneHintRoom == true
	end
	if altar then
		h.Pulse.Scale = 1
	end
	if locked then
		if restricted == true then
			h.Lock.Text = brief and K.TEXT.LockShort or K.TEXT.Lock
		else
			h.Lock.Text = brief and K.TEXT.CheckingShort or K.TEXT.Checking
		end
	else
		-- (Portrait: the long line while it fits the chip, else the phone's "Secret in N"; kit-b P2 fix6: on PC too, the
		-- tablet's narrow chip)
		local text = H.pityText(short)
		if not short and (P.Mode == "Portrait" or h.Pity.Size.X.Offset > 0)
			and H.textW(text, h.Pity.TextSize, Theme.FontOf(h.Pity)) + 16 > h.Pity.Size.X.Offset then
			text = H.pityText(true)
		end
		h.Pity.Text = text
	end
end

----------------------------------------------------------------------
-- Focus
----------------------------------------------------------------------
function H.setFocus(t, on)
	t.Root:SetAttribute("Focused", on == true)
	t.Card.Stroke.Color = on and K.GOLD or t.Edge -- (kit-b U9-2: back to its wood / gold-lip edge)
	t.Card.Stroke.Thickness = on and K.FOCUS_STROKE or t.Thick
end

-- centres `obj` in the ScrollingFrame `sc` as far as its canvas allows (CanvasPosition in screen px, as G.reach reads it)
function H.centre(sc, obj)
	local sx = sc.Size.X.Offset > 0 and sc.AbsoluteSize.X / sc.Size.X.Offset or 1
	local sy = sc.Size.Y.Offset > 0 and sc.AbsoluteSize.Y / sc.Size.Y.Offset or 1
	local maxX = math.max(0, sc.CanvasSize.X.Offset * sx - sc.AbsoluteSize.X)
	local maxY = math.max(0, sc.CanvasSize.Y.Offset * sy - sc.AbsoluteSize.Y)
	local cp = sc.CanvasPosition
	local x = cp.X + (obj.AbsolutePosition.X - sc.AbsolutePosition.X) + (obj.AbsoluteSize.X - sc.AbsoluteSize.X) / 2
	local y = cp.Y + (obj.AbsolutePosition.Y - sc.AbsolutePosition.Y) + (obj.AbsoluteSize.Y - sc.AbsoluteSize.Y) / 2
	sc.CanvasPosition = Vector2.new(math.max(0, math.min(maxX, x)), math.max(0, math.min(maxY, y)))
end

function H.scrollTo(P, t)
	pcall(H.centre, P.Row, t.Root)
	pcall(H.centre, P.Scroll, t.Root)
end

function ShopEggs.Focus(page, rouletteId)
	local P = PAGES[page or CUR.Page]
	if not P then
		return false
	end
	local target = nil
	for _, t in ipairs(H.all(P)) do
		H.setFocus(t, false)
		if t.Id == rouletteId then
			target = t
		end
	end
	if not target then
		return false
	end
	P.FocusToken = (P.FocusToken or 0) + 1
	local mine = P.FocusToken
	H.setFocus(target, true)
	H.scrollTo(P, target)
	task.defer(function()
		if P.FocusToken == mine then
			H.scrollTo(P, target) -- (again once the engine has laid the page out)
		end
	end)
	task.delay(K.FOCUS_SECONDS, function()
		if P.FocusToken == mine then
			H.setFocus(target, false)
		end
	end)
	return true
end

-- (playtest 2026-11-28 C18) a fresh open with no machine to focus starts the page at the top-left: a machine's Focus
-- left its scroll behind, so the next pill open showed the Secret hero cut under the header
function ShopEggs.ScrollHome(page)
	local P = PAGES[page or CUR.Page]
	if not P then
		return false
	end
	P.Scroll.CanvasPosition = Vector2.new(0, 0)
	P.Row.CanvasPosition = Vector2.new(0, 0)
	return true
end

function ShopEggs.HeroPulse(page)
	local P = PAGES[page or CUR.Page]
	return P and P.Hero.Pulse or nil
end

return ShopEggs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1198">
            <Properties>
              <string name="Name">ShopGems</string>
              <string name="Source"><![CDATA[-- ShopGems (client UI; lobby-shop Task 21, docs/superpowers/specs/2026-11-07-lobby-shop-design.md 16.3 "Gems tab" and 16.1
-- "The packs, honest and computed"): the Shop's Gems page. ShopController builds it into its Page_Gems frame and lays it
-- out on every resize; this module never prompts a purchase or decides a price (every buy goes through ctx.Buy /
-- ctx.GemBuy, which fire StoreRequest; the server prompts).
--
--   ShopGems.Build(page, ctx)        page = the Page_Gems Frame. In it: a ScrollingFrame "Scroll" (GemHero, GemPack_1..4,
--                                    GemPotion, TokensTitle, TokenPack_1..3) and the phone's right "Fade" (48 px, shown while
--                                    more of the row is to the right). ctx (ShopController's): { Buy(key), GemBuy(),
--                                    Palette(key) -> { Top, Bottom, Edge }, Price(item) -> whole Robux | nil (the live
--                                    PriceInRobux of a created item), Robux() -> the Robux glyph, Preview() -> bool,
--                                    State(key) -> "Buy" | "Preview" | "Locked" | ..., LockText() -> string }
--   ShopGems.Layout(page, box, mode) box = { W, H } (the content box, design px); mode "PC" | "Compact" (the vertical page:
--                                    the hero 240, four packs 380 tall at (i * (w + 16), 276), the potion 130 at 676, "Cloud
--                                    Tokens" at 826 and three token packs 220 tall at 870) | "Phone" (one sideways row of eight
--                                    166 x min(266, H - 12) tiles every 174 px: the packs, the potion, the token packs; no
--                                    hero) | "Portrait" (the vertical list of full-width rows, the hero on top)
--   ShopGems.Refresh(page)           repaints the amounts, the prices, the ribbons, BEST VALUE, the hero's line, the potion
--                                    and the locks
--   ShopGems.PackRibbons(packs)      packs = { { Amount, Robux }... } (the prices SHOWN; Gems / Tokens are read when Amount is
--                                    missing) -> { [i] = "+N%" }: the whole percent of amount per Robux gained over the first
--                                    pack, rounded half up; none for the first pack, a pack without a shown price, or a gain
--                                    of zero or less
--   ShopGems.BestValue(packs)        -> the index with the most per Robux among the shown prices (ties: the bigger pack), nil
--                                    when that pack gains nothing over the first
--   ShopGems.ChestLine()             -> "Chest: 1,950 gems buys 3 Secret spins + 2 Celestial spins": n = floor(Chest / the
--                                    Secret Roulette's price), m = floor((Chest - n * Secret) / Celestial's gem price); the
--                                    "+ m ..." part dropped at m = 0 and the "n ... + " part at n = 0 (the hero pack's name
--                                    word, "Chest" from "Chest of Gems")
--   ShopGems.PotionState()           -> state, label: "Loading" "Loading..." (no GemsSettled), "Owned" "You have x2 Pet XP"
--                                    (XpPassState Owned), "Checking" "Checking your passes..." (any other state but NotOwned /
--                                    Unavailable), "Full" "Potion time is full" (XpBoostEnds plus the potion past
--                                    Config.Store.Potion.CapSeconds), "Short" (gems under the price: the price, drawn red),
--                                    "Ready" (the price). Only "Ready" may send StoreRequest("GemBuy", "XpPotionGems").
-- The Store switch (release step 1; StoreCatalog.Enabled, read on every Layout / Refresh): while it is off the page holds
-- only the CREATED gem packs (Config.Gems.Products with an Id > 0: what the live game already sold) and the hero only
-- with a created Chest; GemPotion, TokensTitle, TokenPack_1..3 and every uncreated pack are hidden, and the canvas ends
-- under the last pack. On = everything above, unchanged.
-- (kit-b U9-2, finding 15) The tiles are kit B blocks (NeonKit.Card Skin "Sign"): stone faces with each pack's own
-- colour (ctx.Palette's Top) on the lip, brown ink; the hero (the Chest) on the navy plank with its Buy the page's one
-- green plank, every other Buy a stone plank; the % ribbons red tags, BEST VALUE a gold tag; gems are GemIcon piles,
-- the tokens the Cloud Token coin. Every PC text >= 18 px, every phone text >= 15 px. Plain Lua 5.1-compatible syntax
-- only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local StoreCatalog = require(Shared:WaitForChild("StoreCatalog"))

local UI = script.Parent
local NeonKit = require(UI:WaitForChild("NeonKit"))
local GemIcon = require(UI:WaitForChild("GemIcon"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the token piles, the potion
local SignKit = require(Shared:WaitForChild("SignKit")) -- (LOOK-ui) the kit's one scroll bar
local CloudUI = require(UI:WaitForChild("CloudUI"))

local ShopGems = {}

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local K = {
	POTION_KEY = "XpPotionGems",
	HERO_INDEX = 3, -- the Chest (StoreCatalog's GEM_HERO_INDEX)
	PILES = { 1, 2, 4, 6 },
	TOKEN_ART = { 1, 3, 6 },
	TEAL = rgb(64, 200, 190),
	POTION = rgb(176, 108, 232),
	LINE = rgb(255, 243, 176),
	RED = rgb(255, 92, 92),
	GOLD = rgb(255, 211, 77),
	RIBBON = rgb(230, 60, 90),
	TILE = 166, -- the phone row
	STEP = 174,
	TILE_MAX = 266,
	FADE = 48,
	SCROLLBAR = SignKit.Sizes.ScrollBar, -- (LOOK-ui) the kit's one bar (was 6, black, round ends)
	-- the pitch's PILE shares (GemIcon's), reused for the token art
	SPOTS = {
		[1] = { { 0.5, 0.55, 0.8 } },
		[3] = { { 0.3, 0.64, 0.6 }, { 0.7, 0.64, 0.6 }, { 0.5, 0.4, 0.7 } },
		[6] = { { 0.2, 0.72, 0.46 }, { 0.5, 0.74, 0.5 }, { 0.8, 0.72, 0.46 }, { 0.34, 0.5, 0.5 }, { 0.66, 0.5, 0.5 }, { 0.5, 0.27, 0.56 } },
	},
}
local WHITE = Color3.new(1, 1, 1)
local SIGN = Theme.Sign -- (kit-b U9-2) the Signboard palette
local SHORT = rgb(140, 24, 48) -- a short balance: a dark red that reads 4.5:1 on stone and on the sunk well
local PAGES = setmetatable({}, { __mode = "k" }) -- page -> its widgets and ctx

----------------------------------------------------------------------
-- helpers
----------------------------------------------------------------------
local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

local function frame(name, parent, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

local function label(name, parent, text, role, size, props)
	local l = Theme.Label(text or "", role, { Size = size })
	l.Name = name
	l.BackgroundTransparency = 1
	l.TextWrapped = false
	l.TextTruncate = Enum.TextTruncate.AtEnd
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

-- the largest size from `max` down to `min` at which `text` fits `width` px on one line (TextService measures the font)
local function fitSize(lbl, max, min, width)
	for size = max, min, -1 do
		local ok, v = pcall(function()
			return Theme.MeasureLabel(lbl, lbl.Text, size, 10000)
		end)
		if not ok or typeof(v) ~= "Vector2" or v.X <= width then
			return size
		end
	end
	return min
end

local function attr(name)
	local player = Players.LocalPlayer
	return player and player:GetAttribute(Config.Attr[name] or name) or nil
end

local function now()
	local ok, t = pcall(function()
		return workspace:GetServerTimeNow()
	end)
	return (ok and type(t) == "number") and t or os.time()
end

-- a GemIcon pile (count) or the Cloud Token glyphs (tokens) in `host`, rebuilt only when its size changes
local function drawArt(host, px, count, tokens)
	px = math.max(16, math.floor(px + 0.5))
	if host:GetAttribute("ArtPx") == px then
		return
	end
	host:SetAttribute("ArtPx", px)
	for _, child in ipairs(host:GetChildren()) do
		child:Destroy()
	end
	if not tokens then
		local pile = GemIcon.Pile(host, px, count)
		pile.AnchorPoint = Vector2.new(0.5, 0.5)
		pile.Position = UDim2.fromScale(0.5, 0.5)
		return
	end
	local box = frame("TokenPile", host, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(px, px) })
	local cur = Theme.Currency.Tokens
	for i, spot in ipairs(K.SPOTS[count] or K.SPOTS[1]) do
		local s = math.floor(spot[3] * px)
		local g = label("Token" .. i, box, "", "Display", math.max(15, math.floor(s * 0.82)), {
			TextColor3 = SIGN.GoldLip, TextTruncate = Enum.TextTruncate.None, -- (kit-b U9-2) the deep gold reads on stone
		})
		PixelIcon.Host(g, cur.Icon) -- (kit-b U7a) a Cloud Token coin of the pile
		place(g, spot[1] * px - s / 2, spot[2] * px - s / 2, s, s)
	end
end

local function itemsByKey()
	local out = {}
	for _, item in ipairs(StoreCatalog.List()) do
		out[item.Key] = item
	end
	return out
end

local function amountOf(p)
	return tonumber(p.Amount) or tonumber(p.Gems) or tonumber(p.Tokens) or (type(p.Grants) == "table" and (tonumber(p.Grants.Gems) or tonumber(p.Grants.Tokens))) or nil
end

local function ratios(packs)
	local out = {}
	for i, p in ipairs(packs or {}) do
		local amount, robux = amountOf(p), tonumber(p.Robux)
		if amount and robux and robux > 0 then
			out[i] = amount / robux
		end
	end
	return out
end

----------------------------------------------------------------------
-- pure answers
----------------------------------------------------------------------
function ShopGems.PackRibbons(packs)
	local out = {}
	local r = ratios(packs)
	local base = r[1]
	if not base then
		return out
	end
	for i = 2, #(packs or {}) do
		if r[i] then
			local pct = math.floor((r[i] / base - 1) * 100 + 0.5)
			if pct > 0 then
				out[i] = "+" .. tostring(pct) .. "%"
			end
		end
	end
	return out
end

function ShopGems.BestValue(packs)
	local r = ratios(packs)
	local best = nil
	for i = 1, #(packs or {}) do
		if r[i] and (best == nil or r[i] > r[best] + 1e-9 or (math.abs(r[i] - r[best]) <= 1e-9 and (amountOf(packs[i]) or 0) >= (amountOf(packs[best]) or 0))) then
			best = i
		end
	end
	if best == nil or best == 1 or not r[1] or r[best] <= r[1] + 1e-9 then
		return nil
	end
	return best
end

function ShopGems.ChestLine()
	local products = type(Config.Gems) == "table" and Config.Gems.Products or {}
	local chest = products[K.HERO_INDEX] or {}
	local gems = tonumber(chest.Gems) or 0
	local secret = tonumber(Config.Gems.SecretRoulette and Config.Gems.SecretRoulette.GemPrice) or 0
	local celestial = tonumber(Config.Gems.RouletteGemPrices and Config.Gems.RouletteGemPrices.Celestial) or 0
	local word = type(chest.Name) == "string" and (chest.Name:match("^(%S+) of ") or chest.Name) or "Chest"
	local n = secret > 0 and math.floor(gems / secret) or 0
	local m = celestial > 0 and math.floor((gems - n * secret) / celestial) or 0
	local parts = {}
	if n > 0 then
		parts[#parts + 1] = n .. (n == 1 and " Secret spin" or " Secret spins")
	end
	if m > 0 then
		parts[#parts + 1] = m .. (m == 1 and " Celestial spin" or " Celestial spins")
	end
	local line = word .. ": " .. Util.Commas(gems) .. " gems"
	if #parts > 0 then
		line = line .. " buys " .. table.concat(parts, " + ")
	end
	return line
end

function ShopGems.PotionState()
	local item = StoreCatalog.GemItem(K.POTION_KEY)
	local price = item and tonumber(item.Gems) or 0
	local priceText = Util.Commas(price)
	if attr("GemsSettled") ~= true then
		return "Loading", "Loading..."
	end
	local pass = attr("XpPassState")
	if pass == "Owned" then
		return "Owned", "You have x2 Pet XP"
	end
	if pass ~= "NotOwned" and pass ~= "Unavailable" then
		return "Checking", "Checking your passes..."
	end
	local boost = item and type(item.Grants) == "table" and type(item.Grants.Boost) == "table" and tonumber(item.Grants.Boost.XpPotion) or 1800
	local potion = type(Config.Store) == "table" and Config.Store.Potion or nil
	local cap = (type(potion) == "table" and tonumber(potion.CapSeconds)) or 7 * 86400
	local left = math.max(0, (tonumber(attr("XpBoostEnds")) or 0) - now())
	if left + boost > cap then
		return "Full", "Potion time is full"
	end
	local gems = tonumber(attr("Gems")) or 0
	if gems < price then
		return "Short", priceText
	end
	return "Ready", priceText
end

----------------------------------------------------------------------
-- Build
----------------------------------------------------------------------
local function call(P, name, ...)
	local fn = P.Ctx[name]
	if type(fn) == "function" then
		local ok, a = pcall(fn, ...)
		if ok then
			return a
		end
	end
	return nil
end

-- (kit-b U9-2) a kit B plank: stone unless asked (the hero's is the page's one green plank)
local function newButton(P, parent, onTap, style)
	return CloudUI.Button({
		Name = "Buy",
		Text = "",
		Style = style or "Blue",
		Skin = "Sign",
		Size = UDim2.fromOffset(200, 60),
		TextSize = 24,
		Callback = function()
			onTap()
		end,
		Parent = parent,
	})
end

-- (kit-b U9-2) a kit B block: `face` (stone, or the hero's navy plank), the pack's own colour on the lip
local function card(name, parent, color, face)
	local navy = face == SIGN.Navy
	return NeonKit.Card({ Name = name, Skin = "Sign", BodyOverLip = true, Face = face or SIGN.Tile, Lip = color, Edge = navy and SIGN.GoldLip or nil, Size = UDim2.fromOffset(298, 380), Parent = parent })
end

-- (kit-b U9-2) a square wood edge (mitred) on a kit B tag
local function edge(obj, px)
	return Util.Create("UIStroke", {
		Name = "SignEdge", Color = SIGN.Wood, Thickness = px or 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		LineJoinMode = Enum.LineJoinMode.Miter, Parent = obj,
	})
end

-- a pack tile (gems or tokens): Art, Amount, Name, Ribbon (gems only), Best, Note, Buy
local function buildTile(P, kind, i)
	local key = (kind == "Gem" and "Gems" or "Tokens") .. i
	local pal = call(P, "Palette", key) or { Top = K.TEAL, Bottom = Theme.Darken(K.TEAL, 0.6), Edge = Theme.Lighten(K.TEAL, 0.3) }
	local c = card((kind == "Gem" and "GemPack_" or "TokenPack_") .. i, P.Scroll, pal.Top, SIGN.Tile)
	local b = c.Body
	local t = { Kind = kind, Index = i, Key = key, Root = c.Root, Card = c }
	t.Art = frame("Art", b)
	t.Amount = label("Amount", b, "", "Display", 44, { TextColor3 = SIGN.Text })
	t.Name = label("Name", b, "", "Body", 21, { TextColor3 = SIGN.Text })
	-- (kit-b U9-2) the gain: a red tag; BEST VALUE: a gold tag (brown ink in a wood edge, square)
	t.Ribbon = label("Ribbon", b, "", "Body", 20, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Red, TextColor3 = SIGN.Text, Visible = false })
	edge(t.Ribbon)
	t.Best = label("Best", b, "BEST VALUE", "Body", 18, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, TextColor3 = SIGN.Text, Visible = false })
	edge(t.Best)
	t.Note = label("Note", b, "", "Body", 18, { TextColor3 = SIGN.TextMuted, Visible = false, TextWrapped = true, TextTruncate = Enum.TextTruncate.None })
	t.Buy = newButton(P, b, function()
		call(P, "Buy", key)
	end)
	return t
end

local function buildHero(P)
	local c = card("GemHero", P.Scroll, K.TEAL, SIGN.Navy)
	local b = c.Body
	local h = { Root = c.Root, Card = c, Key = "Gems" .. K.HERO_INDEX }
	h.Pile = frame("Pile", b)
	h.Title = Theme.StyleTitle(label("Title", b, "Gems", "Title", 46, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Gold }), "Section") -- a card's heading: the Shop's header title wears the ribbon
	h.Line1 = label("Line1", b, "Spin the Secret Roulette and every machine with gems.", "Body", 24, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = WHITE })
	h.Line2 = label("Line2", b, "", "Heading", 24, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = K.LINE })
	h.Note = label("Note", b, "", "Body", 18, { TextColor3 = K.LINE, Visible = false })
	h.Buy = newButton(P, b, function()
		call(P, "Buy", h.Key)
	end, "Green")
	return h
end

local function buildPotion(P)
	local c = card("GemPotion", P.Scroll, K.POTION, SIGN.Tile)
	local b = c.Body
	local p = { Root = c.Root, Card = c }
	p.Icon = label("Icon", b, "", "Display", 64, { TextTruncate = Enum.TextTruncate.None, TextColor3 = SIGN.VioletLip })
	PixelIcon.Host(p.Icon, NeonKit.IconName("Boosts")) -- (kit-b U7a) the potion, sized with the label
	p.Title = Theme.StyleTitle(label("Title", b,"XP Potion \194\183 30 minutes", "Title", 32, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Text }), "Section") -- a card's heading
	p.Text = label("Text", b, "Your team earns double pet XP. Not random, so every account can buy it.", "Body", 22,
		{ TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextColor3 = SIGN.TextMuted })
	p.Buy = newButton(P, b, function()
		call(P, "GemBuy")
	end, "Blue")
	p.Buy.TextWrapped = true
	-- (P2 icons look fin1, minor) the plank's gem is item 9 B's pixel gem, as on the Gems pill and the Eggs' gem planks
	-- (the cut GemIcon sat beside them); the piles stay cut gems (the owner's 2026-11-07 call)
	p.Amount = GemIcon.Amount(p.Buy, "0", { TextSize = 30, Color = SIGN.Text, Pixel = true })
	p.Amount.AnchorPoint = Vector2.new(0.5, 0.5)
	p.Amount.Position = UDim2.fromScale(0.5, 0.5)
	return p
end

function ShopGems.Build(page, ctx)
	local P = { Ctx = type(ctx) == "table" and ctx or {}, Packs = {}, Tokens = {}, Mode = "PC", Box = { W = 1240, H = 834 } }
	PAGES[page] = P
	local scroll = Instance.new("ScrollingFrame")
	scroll.Name = "Scroll"
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	SignKit.Scroll(scroll, K.SCROLLBAR)
	scroll.CanvasSize = UDim2.new()
	scroll.Size = UDim2.fromScale(1, 1)
	scroll.Parent = page
	P.Scroll = scroll
	-- (kit-b U9-2) the row's right edge while more is that way; (LOOK-ui, kitb-look1: no gradient in a pixel screen) a stone
	-- block with the pixel arrow there, not the stone fading in
	local fade = frame("Fade", page, { BackgroundTransparency = 1, Visible = false, ZIndex = 6 })
	CloudUI.MoreMark(fade, 6)
	P.Fade = fade
	P.Hero = buildHero(P)
	for i = 1, #(Config.Gems.Products or {}) do
		P.Packs[i] = buildTile(P, "Gem", i)
	end
	P.Potion = buildPotion(P)
	P.TokensTitle = label("TokensTitle", scroll, "Cloud Tokens", "Heading", 26, { TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = SIGN.Text })
	for i = 1, 3 do
		P.Tokens[i] = buildTile(P, "Token", i)
	end
	scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		ShopGems._SyncFade(page)
	end)
	ShopGems.Refresh(page)
	return P
end

----------------------------------------------------------------------
-- Layout
----------------------------------------------------------------------
-- one tile on the PC / Compact page (w x h)
local function layoutTilePC(t, w, h)
	if t.Kind == "Gem" then
		place(t.Best, 12, 10, 140, 38)
		t.Best.TextSize = 18
		place(t.Ribbon, w - 92, 10, 80, 38)
		t.Ribbon.TextSize = 20
		place(t.Art, (w - 140) / 2, 50, 140, 140)
		drawArt(t.Art, 140, K.PILES[t.Index] or 6, false)
		place(t.Amount, 0, 192, w, 46)
		t.Amount.TextSize = 44
		place(t.Name, 8, 236, w - 16, 26)
		t.Name.TextSize = 21
		place(t.Note, 8, 262, w - 16, 26)
		t.Note.TextSize = 18
		place(t.Buy, 20, h - 88, w - 40, 68)
		t.Buy.TextSize = 30
	else
		local col = 148
		place(t.Best, 12, 10, 140, 34)
		t.Best.TextSize = 18
		place(t.Art, 16, 52, 120, 120)
		drawArt(t.Art, 120, K.TOKEN_ART[t.Index] or 6, true)
		place(t.Amount, col, 10, w - col - 12, 46)
		t.Amount.TextSize = 40
		place(t.Name, col, 56, w - col - 12, 26)
		t.Name.TextSize = 20
		place(t.Note, col, 84, w - col - 12, 58)
		t.Note.TextSize = 18
		place(t.Buy, col, h - 72, w - col - 16, 64)
		t.Buy.TextSize = 26
	end
	t.Amount.TextXAlignment = t.Kind == "Gem" and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
	t.Name.TextXAlignment = t.Amount.TextXAlignment
	t.Note.TextXAlignment = t.Amount.TextXAlignment
end

-- a phone tile (166 x h): the badges on top, the art, the amount, the name, the note, the Buy at the bottom
local function layoutTilePhone(t, w, h)
	place(t.Best, 6, 6, 100, 26)
	t.Best.TextSize = 15
	place(t.Ribbon, w - 58, 6, 52, 26)
	t.Ribbon.TextSize = 15
	local artTop, artBottom = 34, h - 152
	local art = math.max(40, math.min(72, artBottom - artTop - 4))
	place(t.Art, (w - art) / 2, artTop + math.max(0, (artBottom - artTop - art) / 2), art, art)
	drawArt(t.Art, art, t.Kind == "Gem" and (K.PILES[t.Index] or 6) or (K.TOKEN_ART[t.Index] or 6), t.Kind ~= "Gem")
	place(t.Amount, 0, h - 150, w, 30)
	t.Amount.TextSize = 26
	place(t.Name, 4, h - 120, w - 8, 20)
	t.Name.TextSize = 15
	place(t.Note, 4, h - 99, w - 8, 48)
	t.Note.TextSize = 15
	place(t.Buy, 8, h - 50, w - 16, 44)
	t.Buy.TextSize = 18
	for _, l in ipairs({ t.Amount, t.Name, t.Note }) do
		l.TextXAlignment = Enum.TextXAlignment.Center
	end
end

-- a portrait row (w x h): the art left, the amount and name beside it, the badges under them, the Buy top right, the note
-- across the bottom
local function layoutTilePortrait(t, w, h)
	place(t.Art, 8, 8, 64, 64)
	drawArt(t.Art, 64, t.Kind == "Gem" and (K.PILES[t.Index] or 6) or (K.TOKEN_ART[t.Index] or 6), t.Kind ~= "Gem")
	local tw = w - 80 - 120
	place(t.Amount, 80, 6, tw, 30)
	t.Amount.TextSize = 24
	place(t.Name, 80, 36, tw, 20)
	t.Name.TextSize = 15
	place(t.Ribbon, 80, 60, 52, 24)
	t.Ribbon.TextSize = 15
	place(t.Best, t.Ribbon.Visible and 138 or 80, 60, 100, 24)
	t.Best.TextSize = 15
	place(t.Buy, w - 112, 8, 104, 44)
	t.Buy.TextSize = 18
	place(t.Note, 8, 88, w - 16, h - 92)
	t.Note.TextSize = 15
	for _, l in ipairs({ t.Amount, t.Name, t.Note }) do
		l.TextXAlignment = Enum.TextXAlignment.Left
	end
end

local function layoutHero(h, w, mode)
	if mode == "Portrait" then
		place(h.Root, 0, 0, w, 150)
		place(h.Pile, 8, 8, 80, 80)
		drawArt(h.Pile, 80, 6, false)
		place(h.Title, 100, 6, w - 108, 30)
		h.Title.TextSize = 24
		h.Line1.Visible = false
		place(h.Line2, 100, 38, w - 108, 52)
		h.Line2.TextSize = 15
		h.Line2.TextWrapped = true
		place(h.Buy, w - 158, 98, 150, 44)
		h.Buy.TextSize = 18
		place(h.Note, 8, 104, w - 182, 34)
		h.Note.TextSize = 15
		return 150
	end
	place(h.Root, 0, 16, w, 240)
	place(h.Pile, 30, 20, 200, 200)
	drawArt(h.Pile, 200, 6, false)
	local tw = w - 250 - 340
	place(h.Title, 250, 22, tw, 56)
	h.Title.TextSize = 46
	h.Line1.Visible = true
	place(h.Line1, 250, 84, tw, 34)
	h.Line1.TextSize = fitSize(h.Line1, 24, 18, tw)
	place(h.Line2, 250, 128, tw, 40)
	h.Line2.TextWrapped = false
	h.Line2.TextSize = fitSize(h.Line2, 24, 18, tw)
	place(h.Buy, w - 320, 66, 290, 100)
	h.Buy.TextSize = 36
	place(h.Note, w - 320, 172, 290, 30)
	h.Note.TextSize = 18
	return 256
end

local function layoutPotion(p, w, h, mode)
	local amountSize
	if mode == "PC" or mode == "Compact" then
		place(p.Icon, 24, 17, 96, 96)
		p.Icon.TextSize = 64
		local tw = w - 140 - 320
		place(p.Title, 140, 18, tw, 44)
		p.Title.Text = "XP Potion \194\183 30 minutes"
		p.Title.TextSize = 32
		place(p.Text, 140, 64, tw, 52)
		p.Text.Text = "Your team earns double pet XP. Not random, so every account can buy it."
		p.Text.TextSize = 22
		place(p.Buy, w - 300, 26, 270, 78)
		p.Buy.TextSize = 22
		amountSize = 30
	elseif mode == "Phone" then
		local artBottom = h - 152
		local art = math.max(40, math.min(72, artBottom - 34 - 4))
		place(p.Icon, (w - art) / 2, 34 + math.max(0, (artBottom - 34 - art) / 2), art, art)
		p.Icon.TextSize = math.floor(art * 0.8)
		place(p.Title, 4, h - 150, w - 8, 30)
		p.Title.Text = "XP Potion"
		p.Title.TextSize = 17
		place(p.Text, 4, h - 118, w - 8, 40)
		p.Text.Text = "30 min \194\183 x2 pet XP"
		p.Text.TextSize = 15
		place(p.Buy, 8, h - 50, w - 16, 44)
		p.Buy.TextSize = 15
		amountSize = 18
	else
		place(p.Icon, 8, 8, 64, 64)
		p.Icon.TextSize = 48
		local tw = w - 80 - 120
		place(p.Title, 80, 6, tw, 26)
		p.Title.Text = "XP Potion"
		p.Title.TextSize = 17
		place(p.Text, 80, 34, tw, 40)
		p.Text.Text = "30 min \194\183 x2 pet XP"
		p.Text.TextSize = 15
		place(p.Buy, w - 112, 8, 104, 44)
		p.Buy.TextSize = 15
		amountSize = 18
	end
	local centred = mode == "Phone"
	p.Title.TextXAlignment = centred and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
	p.Text.TextXAlignment = p.Title.TextXAlignment
	GemIcon.SetAmount(p.Amount, nil, { TextSize = amountSize })
end

-- the phone's right fade: shown while more of the sideways row is to the right
function ShopGems._SyncFade(page)
	local P = PAGES[page]
	if not P then
		return
	end
	local on = false
	if P.Mode == "Phone" then
		local s = P.Scroll
		local k = 1
		pcall(function()
			k = s.AbsoluteSize.X / math.max(1, P.Box.W)
		end)
		local canvas = (P.CanvasW or 0) * k
		on = canvas > s.AbsoluteSize.X + 1 and s.CanvasPosition.X < canvas - s.AbsoluteSize.X - 1
	end
	P.Fade.Visible = on
end

-- The Store switch (release step 1, StoreCatalog.Enabled): which tiles show. On: the potion always, the packs as
-- Refresh's paintTile left them (unchanged). Off: only a CREATED gem pack (what the live game already sold); the token
-- packs and the gem potion never.
local function syncShown(P)
	P.On = StoreCatalog.Enabled()
	if P.On then
		P.Potion.Root.Visible = true
		return
	end
	local items = itemsByKey()
	for _, t in ipairs(P.Packs) do
		local item = items[t.Key]
		t.Root.Visible = item ~= nil and item.Created == true
	end
	for _, t in ipairs(P.Tokens) do
		t.Root.Visible = false
	end
	P.Potion.Root.Visible = false
end

-- The page while the Store switch is off: the hero only with a created Chest, the created gem packs side by side from
-- the first place (PC / Compact), in the phone's row or the portrait list, and the canvas ends under the last pack (no
-- empty scroll where the potion and the token packs were).
local function layoutOff(P, W, Hh)
	local s, hero = P.Scroll, P.Hero
	local chest = P.Packs[K.HERO_INDEX]
	P.TokensTitle.Visible = false
	if P.Mode == "Phone" then
		s.ScrollingDirection = Enum.ScrollingDirection.X
		hero.Root.Visible = false
		local th = math.min(K.TILE_MAX, Hh - 12)
		local y = math.floor((Hh - th) / 2)
		local x = 0
		for _, t in ipairs(P.Packs) do
			if t.Root.Visible then
				place(t.Root, x, y, K.TILE, th)
				layoutTilePhone(t, K.TILE, th)
				x = x + K.STEP
			end
		end
		P.CanvasW = math.max(0, x - (K.STEP - K.TILE))
		s.CanvasSize = UDim2.fromOffset(P.CanvasW, 0)
		return
	end
	s.ScrollingDirection = Enum.ScrollingDirection.Y
	hero.Root.Visible = chest ~= nil and chest.Root.Visible
	P.CanvasW = 0
	local w = W - K.SCROLLBAR - 2
	if P.Mode == "Portrait" then
		local y = hero.Root.Visible and (layoutHero(hero, w, "Portrait") + 8) or 0
		for _, t in ipairs(P.Packs) do
			if t.Root.Visible then
				place(t.Root, 0, y, w, 124)
				layoutTilePortrait(t, w, 124)
				y = y + 132
			end
		end
		s.CanvasSize = UDim2.fromOffset(0, y)
		return
	end
	local y = 16
	if hero.Root.Visible then
		layoutHero(hero, w, P.Mode)
		y = 276
	end
	local pw = math.floor((w - 48) / 4)
	local k = 0
	for _, t in ipairs(P.Packs) do
		if t.Root.Visible then
			place(t.Root, k * (pw + 16), y, pw, 380)
			layoutTilePC(t, pw, 380)
			k = k + 1
		end
	end
	s.CanvasSize = UDim2.fromOffset(0, y + 380 + 16)
end

function ShopGems.Layout(page, box, mode)
	local P = PAGES[page]
	if not P then
		return
	end
	box = type(box) == "table" and box or P.Box
	P.Box = { W = math.floor(tonumber(box.W) or 1240), H = math.floor(tonumber(box.H) or 834) }
	P.Mode = mode or "PC"
	local W, Hh = P.Box.W, P.Box.H
	local s = P.Scroll
	place(s, 0, 0, W, Hh)
	place(P.Fade, W - K.FADE, 0, K.FADE, Hh)
	local hero = P.Hero
	syncShown(P)
	if not P.On then
		layoutOff(P, W, Hh)
	elseif P.Mode == "Phone" then
		s.ScrollingDirection = Enum.ScrollingDirection.X
		hero.Root.Visible = false
		P.TokensTitle.Visible = false
		local th = math.min(K.TILE_MAX, Hh - 12)
		local y = math.floor((Hh - th) / 2)
		local row = {}
		for _, t in ipairs(P.Packs) do
			row[#row + 1] = t
		end
		row[#row + 1] = P.Potion
		for _, t in ipairs(P.Tokens) do
			row[#row + 1] = t
		end
		local x = 0
		for _, t in ipairs(row) do
			if t.Root.Visible then
				place(t.Root, x, y, K.TILE, th)
				if t == P.Potion then
					layoutPotion(t, K.TILE, th, "Phone")
				else
					layoutTilePhone(t, K.TILE, th)
				end
				x = x + K.STEP
			end
		end
		P.CanvasW = math.max(0, x - (K.STEP - K.TILE))
		s.CanvasSize = UDim2.fromOffset(P.CanvasW, 0)
	elseif P.Mode == "Portrait" then
		s.ScrollingDirection = Enum.ScrollingDirection.Y
		hero.Root.Visible = true
		P.TokensTitle.Visible = true
		local w = W - K.SCROLLBAR - 2
		local y = layoutHero(hero, w, "Portrait") + 8
		for _, t in ipairs(P.Packs) do
			if t.Root.Visible then
				place(t.Root, 0, y, w, 124)
				layoutTilePortrait(t, w, 124)
				y = y + 132
			end
		end
		place(P.Potion.Root, 0, y, w, 96)
		layoutPotion(P.Potion, w, 96, "Portrait")
		y = y + 104
		place(P.TokensTitle, 4, y, w - 8, 30)
		P.TokensTitle.TextSize = 20
		y = y + 34
		for _, t in ipairs(P.Tokens) do
			if t.Root.Visible then
				place(t.Root, 0, y, w, 124)
				layoutTilePortrait(t, w, 124)
				y = y + 132
			end
		end
		P.CanvasW = 0
		s.CanvasSize = UDim2.fromOffset(0, y)
	else
		s.ScrollingDirection = Enum.ScrollingDirection.Y
		hero.Root.Visible = true
		P.TokensTitle.Visible = true
		-- (the content stops short of the scroll bar, as on the card pages: the bar never covers the last tile's edge)
		local cw = W - K.SCROLLBAR - 2
		layoutHero(hero, cw, P.Mode)
		local pw = math.floor((cw - 48) / 4)
		for i, t in ipairs(P.Packs) do
			place(t.Root, (i - 1) * (pw + 16), 276, pw, 380)
			layoutTilePC(t, pw, 380)
		end
		place(P.Potion.Root, 0, 676, cw, 130)
		layoutPotion(P.Potion, cw, 130, P.Mode)
		place(P.TokensTitle, 4, 826, cw - 8, 34)
		P.TokensTitle.TextSize = 26
		local tw = math.floor((cw - 16) / 3)
		for i, t in ipairs(P.Tokens) do
			place(t.Root, (i - 1) * (tw + 8), 870, tw, 220)
			layoutTilePC(t, tw, 220)
		end
		P.CanvasW = 0
		s.CanvasSize = UDim2.fromOffset(0, 870 + 220 + 16)
	end
	ShopGems._SyncFade(page)
end

----------------------------------------------------------------------
-- Refresh
----------------------------------------------------------------------
-- the price SHOWN for an item: the live PriceInRobux once created (nil while it loads), else the Config Robux
local function shownPrice(P, item)
	if not item then
		return nil
	end
	if item.Created then
		return call(P, "Price", item)
	end
	return tonumber(item.Robux)
end

local function paintTile(P, t, item, best)
	t.Root.Visible = item ~= nil
	if not item then
		return
	end
	local amount = amountOf(item) or 0
	t.Amount.Text = Util.Commas(amount)
	t.Name.Text = tostring(item.Name or item.Key)
	local price = shownPrice(P, item)
	t.Buy.Text = price and ((call(P, "Robux") or "R$") .. Util.Commas(price)) or "..."
	local state = call(P, "State", t.Key) or "Preview"
	local note = ""
	if state == "Preview" then
		note = call(P, "Preview") and "PREVIEW" or "Coming soon"
	elseif state == "Locked" then
		note = tostring(call(P, "LockText") or "")
	end
	t.Note.Text = note
	t.Note.Visible = note ~= ""
	local off = state ~= "Buy"
	if (t.Buy:GetAttribute("Disabled") == true) ~= off then
		CloudUI.SetDisabled(t.Buy, off)
	end
	t.Best.Visible = best == t.Index
end

function ShopGems.Refresh(page)
	local P = PAGES[page]
	if not P then
		return
	end
	local items = itemsByKey()
	-- the Store switch off (StoreCatalog.Enabled): a pack that is not a CREATED gem pack is not an item here, so its tile
	-- hides (paintTile) instead of showing a dead "Coming soon" button; the token packs are never items
	local on = StoreCatalog.Enabled()
	if not on then
		for key, item in pairs(items) do
			if not (item.Gem and item.Created) then
				items[key] = nil
			end
		end
	end
	-- the gem packs: the shown prices -> the ribbons and BEST VALUE
	local shown = {}
	for i = 1, #P.Packs do
		local item = items["Gems" .. i]
		shown[i] = { Amount = item and amountOf(item) or 0, Robux = shownPrice(P, item) }
	end
	local ribbons = ShopGems.PackRibbons(shown)
	local best = ShopGems.BestValue(shown)
	for i, t in ipairs(P.Packs) do
		paintTile(P, t, items[t.Key], best)
		t.Ribbon.Text = ribbons[i] or ""
		t.Ribbon.Visible = ribbons[i] ~= nil
	end
	-- the token packs: BEST VALUE only (no % ribbon: spec 16.1)
	local tshown = {}
	for i = 1, #P.Tokens do
		local item = items["Tokens" .. i]
		tshown[i] = { Amount = item and amountOf(item) or 0, Robux = shownPrice(P, item) }
	end
	local tbest = ShopGems.BestValue(tshown)
	for _, t in ipairs(P.Tokens) do
		paintTile(P, t, items[t.Key], tbest)
		t.Ribbon.Visible = false
	end
	-- the hero: the Chest's line and buy
	local hero = P.Hero
	local chestTile = P.Packs[K.HERO_INDEX]
	hero.Line2.Text = ShopGems.ChestLine()
	if chestTile then
		hero.Buy.Text = chestTile.Buy.Text
		hero.Note.Text = chestTile.Note.Text
		hero.Note.Visible = chestTile.Note.Visible
		local off = chestTile.Buy:GetAttribute("Disabled") == true
		if (hero.Buy:GetAttribute("Disabled") == true) ~= off then
			CloudUI.SetDisabled(hero.Buy, off)
		end
	end
	-- the potion (hidden while the Store switch is off)
	local p = P.Potion
	p.Root.Visible = on
	local state, text = ShopGems.PotionState()
	local priced = state == "Ready" or state == "Short"
	p.Amount.Visible = priced
	if priced then
		p.Buy.Text = ""
		GemIcon.SetAmount(p.Amount, text, { Color = state == "Short" and SHORT or SIGN.Text })

	else
		p.Buy.Text = text
	end
	local off = not priced
	if (p.Buy:GetAttribute("Disabled") == true) ~= off then
		CloudUI.SetDisabled(p.Buy, off)
	end
end

return ShopGems
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1199">
            <Properties>
              <string name="Name">TeamFaces</string>
              <string name="Source"><![CDATA[-- TeamFaces (client UI, team balance, spec s.2): the row every battle panel shows, the three pets that will fight with Edit team
-- beside them. It replaces client/TeamPick's strip and its "Pick your battle team" popup: there is one flow and no silent auto-fill.
--
--   TeamFaces.New(parent, props) -> { Root, Refresh = fn, SetMode = fn(mode), Height = fn() -> design px, Destroy = fn }
--       props = { LayoutOrder, Compact = bool, Column = bool, ReturnTo = table | fn() -> table (what Edit team hands to the Pets window),
--         SlotH = { Compact = h, Column = h } };
--       SetMode("Card" | "Compact" | "Column") when the window's layout changes.
--       (U9-7 look) props.SlotH: row.Slot, an empty frame "Slot" the window fills, takes the power line's place (TeamPower stays
--       hidden): beside Edit team in a Card row, a line of SlotH.Compact px under the faces in a Compact row, a line of
--       SlotH.Column px under a full-width Edit team in a Column (no height: no line). The Ring pins its champion there.
--       Frame "TeamFaces": Face1..Face3 (Picture, Tag "FIGHTER" | "HELPER", Level "L12", Power, Busy, StageBadge + attribute Stage; an open
--       slot shows Empty "Empty", a slot whose pet is busy shows Empty "Training" | "Gardening" and the Busy mark; a Compact
--       face the word alone, "Training" | "Garden"), TeamPower and
--       the TextButton EditTeam ("Edit team", 56 design px: >= 44 px under the 0.8 touch scale).
--         Card     the faces in a row, a line below with TeamPower and EditTeam (wide windows)
--         Compact  the faces in a row with EditTeam beside them, one line high (phones: the Dungeon's party box); no TeamPower
--         Column   the faces under each other, TeamPower and EditTeam below (the Ring's right column on a landscape phone)
--       Every row redraws on State.Changed (one shared connection; destroyed rows drop out).
--   TeamFaces.Entries() -> { { Key, Def, Level, Tier, Evo, Train, Power, Busy = false }... }  State.ActiveTeam(): the pets that fight, in
--       slot order (busy pets are not in it); an entry is what BattleCatalog reads
--   TeamFaces.Power() -> number   TeamPower of the entries, rounded; 0 when empty
--   TeamFaces.Ensure(continueFn, returnTo) -> bool   continueFn() at once when the team is not empty. With 0 owned pets the hint "You need
--       a pet: spin a roulette in the Cloud Shop." and nothing else. Otherwise the Pets window with slot 1 in pick mode and NO
--       automatic continue: the player presses the panel's button again after editing. A team whose pets are all busy says so.
-- (kit-b U9-7) On the Signboard kit, as the Pets window's team slots: the row a sunk stone well, the faces stone tiles with the
-- rarity on their lip, FIGHTER / HELPER red / sky tags, Edit team a stone block (the panel's own action is its one green).
-- The server decides again (BattleService.TEAM_REFUSALS). Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the power sword and the busy marks

local UI = script.Parent
local Client = UI.Parent
local CloudUI = require(UI:WaitForChild("CloudUI"))
local Bits = require(UI:WaitForChild("PetBits"))
local State = require(Client:WaitForChild("State"))

local TeamFaces = {}

local K = {
	SLOTS = 3,
	PAD = 8,
	GAP = 6,
	EDIT_H = 56,
	EDIT_W = 150,
	EDIT_W_COMPACT = 100,
	EDIT_W_TWO_LINES = 76, -- (kit-b U9-7) the Compact row's Edit team block, its words on two lines
	CARD_H = 96, -- the height of a face per mode
	COMPACT_H = 64,
	COLUMN_H = 46, -- (U9-7 look) the tag's line and the level's line no longer share 2 px
	COLUMN_PAD = 4,
	NO_PET = "You need a pet: spin a roulette in the Cloud Shop.",
	ALL_BUSY = "Your whole team is busy: training or gardening",
}

-- (kit-b U9-7) the Signboard palette (the Pets window's team slots, U8): the row is a sunk stone well, each face a raised
-- stone tile with the pet's rarity on its lip and the pet standing in a light well, FIGHTER a red tag and HELPER a sky
-- tag in brown ink, EVO a gold tag; brown ink on stone, the muted brown for the level and an empty slot
local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local LIP = 4 -- design px of a face's lip
local ROLE_COLOR = { FIGHTER = SIGN.Red, HELPER = SIGN.Sky }
-- (kit-b U7b) PixelIcons, not emoji: the sword before a power, a busy slot's mark (training: the weight, garden: the sprout)
local POWER_ICON = "sword"
local BUSY_ICON = { Training = "weight", Garden = "sprout" }
local BUSY_WORD = { Training = "Training", Garden = "Gardening" }
-- (U9-7 look) a Compact face's busy slot: the word alone, centred under the tag (as an open slot's "Empty"); the 18 px mark
-- had a 20 px row between the tag and the word (it ran into both), and "Gardening" filled the tile edge to edge
local BUSY_SHORT = { Training = "Training", Garden = "Garden" }

local frame, text, stroke = Bits.frame, Bits.text, Bits.stroke

-- (kit-b U9-7) a square edge with mitred corners (kit B has no rounded blocks)
local function edge(parent, color, thickness)
	local s = stroke(parent, color, thickness, 0)
	s.Name = "SignEdge"
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

local S = {
	Rows = {}, -- live rows
	Conn = nil, -- the shared State.Changed connection
	Warned = {},
}

local function warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[TeamFaces] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function safe(label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(label, err)
	end
	return ok
end

-- another controller, at call time: the windows load this module while they load themselves
local function controller(name)
	local folder = Client:FindFirstChild("Controllers")
	local module = folder and folder:FindFirstChild(name)
	local ok, mod = pcall(function()
		return module and require(module)
	end)
	return ok and type(mod) == "table" and mod or nil
end

local function hint(message, kind)
	local menu = controller("MenuController")
	if menu and type(menu.Hint) == "function" then
		safe("hint", menu.Hint, message, kind)
	end
end

local function commas(n)
	local out = tostring(math.floor(tonumber(n) or 0)):reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (out:gsub("^,", ""))
end

-- a Compact face's power: 2,144 -> 2.14K (Theme.Short, the game's one short-number style; Pitch 2 F0)
local function shortPower(n)
	return Theme.Short(n)
end

local function openPets(args)
	local pets = controller("PetsController")
	if pets and type(pets.Open) == "function" then
		safe("open pets", pets.Open, args)
	end
end

----------------------------------------------------------------------
-- Data
----------------------------------------------------------------------
function TeamFaces.Entries()
	local out = {}
	local ok, keys = pcall(State.ActiveTeam)
	for _, key in ipairs(ok and type(keys) == "table" and keys or {}) do
		local def = Bits.defOfKey(key)
		if def then
			local level = Bits.petLevel(key)
			local entry = Bits.battleEntry(key, def, level)
			entry.Power = Bits.battlePower(key, def, level) or 0
			entry.Busy = false
			out[#out + 1] = entry
		end
	end
	return out
end

function TeamFaces.Power()
	local BC = Bits.battleCatalog()
	local entries = TeamFaces.Entries()
	if not BC or #entries == 0 then
		return 0
	end
	local ok, power = pcall(BC.TeamPower, entries)
	return ok and math.floor((tonumber(power) or 0) + 0.5) or 0
end

-- why the active team's busy pets are busy, in slot order: they keep their slot, the faces after the fielded ones say so
local function busyOfTeam()
	local out = {}
	local ok, teams = pcall(State.Teams)
	local active = ok and type(teams) == "table" and type(teams.Presets) == "table" and teams.Presets[teams.Active or 1]
	for _, key in ipairs(type(active) == "table" and active or {}) do
		local why = Bits.busyOf(key)
		if why then
			out[#out + 1] = why
		end
	end
	return out
end

function TeamFaces.Ensure(continueFn, returnTo)
	local ok, team = pcall(State.ActiveTeam)
	if ok and type(team) == "table" and #team > 0 then
		if continueFn then
			continueFn()
		end
		return true
	end
	if #Bits.ownedKeys() == 0 then
		hint(K.NO_PET, "info")
		return false
	end
	openPets({ Pick = 1, ReturnTo = returnTo })
	if #busyOfTeam() > 0 then
		hint(K.ALL_BUSY, "bad")
	end
	return false
end

----------------------------------------------------------------------
-- One face
----------------------------------------------------------------------
local function buildFace(root, i)
	-- (kit-b U9-7) a raised stone tile in a wood edge; its lip takes the pet's rarity (paintFace)
	local cell = frame(root, "Face" .. i, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Tile })
	local face = { Cell = cell, Rim = edge(cell, SIGN.Wood, 2), Key = nil, Stage = 0 }
	face.Lip = frame(cell, "Lip", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.StoneLip,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, LIP),
		ZIndex = 2,
	})
	face.Picture = frame(cell, "Picture", { BackgroundTransparency = 0, BackgroundColor3 = SIGN.PetWell, ZIndex = 2 })
	local role = i == 1 and "FIGHTER" or "HELPER"
	face.Tag = text(cell, "Tag", role, "Tag", 18, INK, {
		BackgroundTransparency = 0,
		BackgroundColor3 = ROLE_COLOR[role],
		ZIndex = 4,
	})
	face.Stage_ = text(cell, "StageBadge", "", "Button", 18, INK, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Gold,
		Visible = false,
		ZIndex = 4,
	})
	edge(face.Stage_, SIGN.Wood, 2)
	face.Level = text(cell, "Level", "", "Heading", 18, MUTED, { TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3 })
	face.Power = text(cell, "Power", "", "Heading", 18, INK, {
		TextXAlignment = Enum.TextXAlignment.Right,
		TextTruncate = Enum.TextTruncate.AtEnd,
		ZIndex = 3,
	})
	face.Empty = text(cell, "Empty", "Empty", "Heading", 18, MUTED, { ZIndex = 3 })
	face.Busy = text(cell, "Busy", "", "Heading", 18, INK, { Visible = false, ZIndex = 4 })
	return face
end

-- x and y in pixels; the width is a share of the parent (wScale) plus pixels
local function place(obj, x, y, wScale, w, h)
	obj.Position = UDim2.fromOffset(x, y)
	obj.Size = UDim2.new(wScale, w, 0, h)
end

-- where a face's parts sit: everything hangs off the cell's edges, so a cell can be any width
local function layoutFace(face, mode)
	-- (kit-b U9-7) everything stays above the face's LIP px rarity lip
	if mode == "Column" then
		-- [picture] FIGHTER
		--           L12    sword 358
		-- (U9-7 look) the tag 2..20, the line under it 22..40: 2 px clear of each other and of the lip (the tag sat on the
		-- tops of "L57" and the sword, "Gardening" ran into the lip)
		local h = K.COLUMN_H
		local p = h - 2 - LIP
		local x = p + 6
		place(face.Picture, 2, 2, 0, p, p)
		place(face.Tag, x, 2, 0, 88, 18)
		place(face.Level, x, 22, 0, 44, 18)
		place(face.Power, x + 44, 22, 1, -(x + 48), 18)
		place(face.Empty, x, 22, 1, -(x + 4), 18)
		place(face.Busy, 2, 2, 0, p, p)
	elseif mode == "Compact" then
		-- FIGHTER (a line across)
		-- [picture] L12 / 358
		place(face.Tag, 2, 2, 1, -4, 20)
		place(face.Picture, 2, 22, 0, 34, 38 - LIP)
		place(face.Level, 38, 22, 1, -40, 20)
		place(face.Power, 38, 40, 1, -40, 20)
		place(face.Busy, 2, 22, 1, -4, 20)
	else
		local h = K.CARD_H
		place(face.Picture, 4, 4, 1, -8, h - 34)
		place(face.Tag, 4, 4, 0, 88, 22)
		place(face.Stage_, 96, 4, 0, 62, 22)
		place(face.Level, 8, h - 28, 0, 46, 24)
		place(face.Power, 54, h - 28, 1, -60, 24)
		place(face.Empty, 4, 28, 1, -8, h - 32 - LIP)
		place(face.Busy, 8, 28, 0, 26, h - 32 - LIP)
	end
end

local function paintFace(face, entry, busy, mode, shown)
	local stage = entry and tonumber(entry.Evo) or 0
	local key = entry and entry.Key or nil
	if (shown or not key) and (face.Key ~= key or face.Stage ~= stage) then
		if face.Handle then
			pcall(face.Handle.Destroy)
			face.Handle = nil
		end
		face.Key, face.Stage = key, stage
		if entry then
			local ok, handle = pcall(CloudUI.PetViewport, face.Picture, entry.Def, UDim2.new(1, 0, 1, 0), {
				Spin = "sway",
				Detail = "Low",
				ZIndex = 2,
				Evolved = stage > 0 and stage or nil,
			})
			if ok then
				face.Handle = handle
			else
				warnOnce("viewport", handle)
			end
		end
	end
	face.Cell:SetAttribute("Stage", stage)
	face.Picture.Visible = entry ~= nil
	face.Level.Visible = entry ~= nil
	face.Power.Visible = entry ~= nil
	face.Empty.Visible = entry == nil
	face.Busy.Visible = entry == nil and busy ~= nil and mode ~= "Compact"
	-- (kit-b U9-7) an open slot is a sunk stone well, a filled one a raised tile
	face.Cell.BackgroundColor3 = entry and SIGN.Tile or SIGN.Well
	face.Rim.Color = entry and SIGN.Wood or SIGN.WellEdge
	if entry then
		face.Level.Text = "L" .. tostring(entry.Level)
		-- (kit-b U7b) the sword before a full power (a Compact face has room for the short number only); drawn on a change
		local sword = mode ~= "Compact"
		if face.PowerIcon ~= sword then
			face.PowerIcon = sword
			if sword then
				PixelIcon.Lead(face.Power, POWER_ICON)
			else
				PixelIcon.Clear(face.Power)
			end
		end
		face.Power.Text = sword and commas(entry.Power) or shortPower(entry.Power)
		face.Lip.BackgroundColor3 = CloudUI.RarityColor(entry.Def.Rarity) -- (kit-b U9-7) the rarity on the lip
		face.Stage_.Text = stage >= 2 and "EVO II" or "EVO I"
		face.Stage_.Visible = stage > 0 and mode == "Card" -- (the picture shows the stage; the smaller faces have no room for the badge)
	else
		face.Stage_.Visible = false
		face.Empty.Text = busy and ((mode == "Compact") and BUSY_SHORT[busy] or BUSY_WORD[busy]) or "Empty"
		local mark = busy and BUSY_ICON[busy] or nil
		if face.BusyIcon ~= mark then
			face.BusyIcon = mark
			PixelIcon.Host(face.Busy, mark or "") -- an unknown name drops the old mark
		end
		if mode == "Compact" then
			place(face.Empty, 2, 22, 1, -4, 38 - LIP)
		end
		face.Lip.BackgroundColor3 = SIGN.WellEdge
	end
end

----------------------------------------------------------------------
-- The row
----------------------------------------------------------------------
-- (U9-7 look) an object's width in its own design px: AbsoluteSize over the UIScales above it; 0 before the first layout
local function designWidth(obj)
	local s, cur = 1, obj
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") then
			local ui = cur:FindFirstChildOfClass("UIScale")
			if ui and ui.Scale > 0 then
				s = s * ui.Scale
			end
		end
		cur = cur.Parent
	end
	local w = obj.AbsoluteSize.X
	return (w > 0) and (w / s + 0.001) or 0
end
-- the row's window and page are on screen: a hidden row builds no pet viewports (its window refreshes it when it opens)
local function isShown(obj)
	while obj and obj:IsA("GuiObject") do
		if not obj.Visible then
			return false
		end
		obj = obj.Parent
	end
	return true
end

local function refreshRows()
	local alive = {}
	for _, row in ipairs(S.Rows) do
		if row.Root.Parent ~= nil then
			alive[#alive + 1] = row
			safe("row refresh", row.Refresh)
		else
			row.Release()
		end
	end
	S.Rows = alive
end

function TeamFaces.New(parent, props)
	props = props or {}
	local mode = (props.Column and "Column") or (props.Compact and "Compact") or "Card"
	-- (kit-b U9-7) the row: a sunk stone well in its own darker edge (the pitch's .wl), square
	local root = frame(parent, "TeamFaces", {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Well,
		LayoutOrder = props.LayoutOrder or 0,
	})
	edge(root, SIGN.WellEdge, 2)
	local faces = {}
	for i = 1, K.SLOTS do
		faces[i] = buildFace(root, i)
	end
	local power = text(root, "TeamPower", "", "Heading", 19, INK, {
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local edit = CloudUI.Button({
		Name = "EditTeam",
		Text = "Edit team",
		Style = "Gray",
		Skin = "Sign", -- (kit-b U9-7) a stone block: the panel's own action keeps the green
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.fromOffset(K.EDIT_W, K.EDIT_H),
		TextSize = 20,
		Parent = root,
		Callback = function()
			local back = props.ReturnTo
			if type(back) == "function" then
				back = back()
			end
			openPets({ ReturnTo = back })
		end,
	})

	local slotH = type(props.SlotH) == "table" and props.SlotH or nil
	local slot = slotH and frame(root, "Slot", {}) or nil
	local row = { Root = root, Slot = slot }

	-- (U9-7 look) the slot's own line in a Compact or Column row (a Card row has it beside Edit team)
	local function slotLine()
		local h = slotH and tonumber(slotH[mode]) or 0
		return (mode ~= "Card" and h > 0) and h or 0
	end

	function row.Height()
		local extra = slotLine() > 0 and (K.GAP + slotLine()) or 0
		if mode == "Column" then
			return K.COLUMN_PAD * 2 + K.SLOTS * K.COLUMN_H + (K.SLOTS - 1) * K.COLUMN_PAD + K.GAP + K.EDIT_H + extra
		elseif mode == "Compact" then
			return K.PAD * 2 + K.COMPACT_H + extra
		end
		return K.PAD * 2 + K.CARD_H + K.GAP + K.EDIT_H
	end

	function row.Mode()
		return mode
	end

	-- the cells of a row of faces: `taken` px of the row's width are not theirs. (U9-7 look) Whole design px once the row's
	-- width is known (thirds of it put the slot edges and rarity lips between pixels: 172.67 / 181.33 px), the remainder
	-- to the last face; a share of the width before the first layout
	local rowTaken, rowH = 0, 0
	local function faceRow(taken, h)
		rowTaken, rowH = taken, h
		local pad, n = K.PAD, K.SLOTS
		local width = designWidth(root)
		if width > 0 then
			local avail = math.floor(width) - 2 * pad - (n - 1) * K.GAP - taken
			local each = math.floor(avail / n)
			local x = pad
			for i, face in ipairs(faces) do
				local cw = (i == n) and (avail - each * (n - 1)) or each
				face.Cell.Position = UDim2.fromOffset(x, pad)
				face.Cell.Size = UDim2.fromOffset(cw, h)
				x = x + cw + K.GAP
			end
			return
		end
		local share = (2 * pad + (n - 1) * K.GAP + taken) / n
		for i, face in ipairs(faces) do
			face.Cell.Position = UDim2.new((i - 1) / n, pad + (i - 1) * (K.GAP - share), 0, pad)
			face.Cell.Size = UDim2.new(1 / n, -share, 0, h)
		end
	end
	root:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if mode ~= "Column" and rowH > 0 then
			faceRow(rowTaken, rowH)
		end
	end)

	local function layout()
		root.Size = UDim2.new(1, 0, 0, row.Height())
		for _, face in ipairs(faces) do
			layoutFace(face, mode)
		end
		local pad = K.PAD
		if mode == "Column" then
			pad = K.COLUMN_PAD
			for i, face in ipairs(faces) do
				place(face.Cell, pad, pad + (i - 1) * (K.COLUMN_H + pad), 1, -2 * pad, K.COLUMN_H)
			end
			local y = pad + K.SLOTS * K.COLUMN_H + (K.SLOTS - 1) * pad + K.GAP
			edit.Position = UDim2.new(1, -pad, 0, y)
			edit.Size = slot and UDim2.new(1, -2 * pad, 0, K.EDIT_H) or UDim2.fromOffset(K.EDIT_W_COMPACT, K.EDIT_H)
			place(power, pad + 2, y, 1, -(2 * pad + K.EDIT_W_COMPACT + 6), K.EDIT_H)
			if slot then
				place(slot, pad, y + K.EDIT_H + K.GAP, 1, -2 * pad, slotLine())
			end
		elseif mode == "Compact" then
			-- (kit-b U9-7) "Edit team" on two lines in a narrower block: the faces get the room for a whole FIGHTER tag
			faceRow(K.EDIT_W_TWO_LINES + K.GAP, K.COMPACT_H)
			edit.Position = UDim2.new(1, -pad, 0, pad + (K.COMPACT_H - K.EDIT_H) / 2)
			edit.Size = UDim2.fromOffset(K.EDIT_W_TWO_LINES, K.EDIT_H)
			if slot then
				place(slot, pad + 2, pad + K.COMPACT_H + K.GAP, 1, -(2 * pad + 4), slotLine())
			end
		else
			faceRow(0, K.CARD_H)
			local y = pad + K.CARD_H + K.GAP
			edit.Position = UDim2.new(1, -pad, 0, y)
			edit.Size = UDim2.fromOffset(K.EDIT_W, K.EDIT_H)
			place(power, pad + 2, y, 1, -(2 * pad + K.EDIT_W + 6), K.EDIT_H)
			if slot then
				place(slot, pad + 2, y, 1, -(2 * pad + K.EDIT_W + 6), K.EDIT_H)
			end
		end
		power.Visible = mode ~= "Compact" and not slot -- (a Compact row sits in a panel that shows the team's power already)
		if slot then
			slot.Visible = mode == "Card" or slotLine() > 0
		end
		edit.TextWrapped = mode == "Compact"
		edit.TextTruncate = (mode == "Compact") and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
		edit.LineHeight = (mode == "Compact") and 0.9 or 1
		edit.TextSize = (mode == "Compact") and 19 or 20
	end

	function row.Refresh()
		if mode ~= "Column" and rowH > 0 and designWidth(root) > 0 then
			faceRow(rowTaken, rowH) -- (U9-7 look) whole px once the row is laid out
		end
		local entries = TeamFaces.Entries()
		local busy = busyOfTeam()
		local shown = isShown(root)
		for i, face in ipairs(faces) do
			paintFace(face, entries[i], busy[i - #entries], mode, shown)
		end
		local total = commas(TeamFaces.Power())
		local sword = mode == "Column" -- (kit-b U7b) a Column row says the power with the sword in front
		if row.PowerIcon ~= sword then
			row.PowerIcon = sword
			if sword then
				PixelIcon.Lead(power, POWER_ICON)
			else
				PixelIcon.Clear(power)
			end
		end
		power.Text = sword and total or ("Team power " .. total)
	end

	function row.SetMode(newMode)
		if newMode ~= mode then
			mode = newMode
			layout()
			row.Refresh()
		end
	end

	function row.Release()
		for _, face in ipairs(faces) do
			if face.Handle then
				pcall(face.Handle.Destroy)
				face.Handle = nil
			end
		end
	end

	function row.Destroy()
		row.Release()
		root:Destroy()
	end

	layout()
	row.Refresh()
	S.Rows[#S.Rows + 1] = row
	if not S.Conn then
		S.Conn = State.Changed:Connect(refreshRows)
	end
	return row
end

return TeamFaces
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="1200">
          <Properties>
            <string name="Name">UiGate</string>
            <string name="Source"><![CDATA[-- UiGate: "has the player pressed PLAY on the main menu yet?" (ARCHITECTURE_V3.md "Phase 5 build contract" 7.2).
-- The main menu shows BEFORE the character spawns (the server holds it until MenuPlay). Until PLAY, every ScreenGui
-- except the ones in ALLOW is kept Enabled = false by MainMenuController (a DENY-list rule: any future gui is gated
-- too), MovementController / BattleController keys are inert and TutorialController waits for PLAY.
--
--   UiGate.ALLOW            { "NimbusLoading", "NimbusMainMenu", "NimbusNotify" }  the only guis shown before PLAY
--   UiGate.Played           Util.Signal, fires once when the player presses PLAY (or at once with the menu disabled)
--   UiGate.HasPlayed()      -> bool
--   UiGate.WaitForPlay(t)   -> bool  yields until PLAY or t seconds (default 600); true when played
--   UiGate.MarkPlayed()     -> bool  marks PLAY (once; true the first time) and fires Played
--   UiGate.IsAllowed(name)  -> bool  a ScreenGui name in ALLOW
--
-- Plain Lua 5.1-compatible syntax only. No per-frame work (WaitForPlay polls at 4 Hz only while someone waits).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Util = require(Shared:WaitForChild("Util"))

local UiGate = {}

UiGate.ALLOW = { "NimbusLoading", "NimbusMainMenu", "NimbusNotify" }
UiGate.Played = Util.Signal()

local played = false
local POLL = 0.25

function UiGate.HasPlayed()
	return played
end

function UiGate.MarkPlayed()
	if played then
		return false
	end
	played = true
	UiGate.Played:Fire()
	return true
end

function UiGate.WaitForPlay(timeout)
	if played then
		return true
	end
	local limit = tonumber(timeout) or 600
	if limit ~= limit or limit < 0 then
		limit = 0
	end
	local waited = 0
	while not played and waited < limit do
		waited = waited + task.wait(POLL)
	end
	return played
end

-- tests only (smoke_p5_menu.lua): back to "not played" so the gate can be exercised again in one client world
function UiGate._ResetForTests()
	played = false
end

function UiGate.IsAllowed(name)
	for _, allowed in ipairs(UiGate.ALLOW) do
		if allowed == name then
			return true
		end
	end
	return false
end

return UiGate
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
