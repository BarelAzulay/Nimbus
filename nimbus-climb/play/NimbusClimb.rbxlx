-- the window's words (spec 5.3)
local TEXT = {
	Claim = "Claim!", -- (kit-b U9-4) buttons read in sentence case (the kit's casing rule)
	Getting = "Getting your gifts ready...",
	Keep = "Come back tomorrow to keep your streak!",
	KeepClaim = "Claim today's gift to keep your streak!", -- (Pitch 2 09 B) the line by a claim that is due
	KeepLocked = "Your streak is safe while it unlocks.", -- (playtest 2026-11-28 C29) by a held claim: the hold loses no day
	Prize = "DAY 7 PRIZE", -- (Pitch 2 09 B) the prize card's label (TODAY when it is due); look review r0: the mock's capitals
	Week = "WEEK DONE! Week Wisp is yours!",
	Unlock = "Unlocks after %d min of play",
	Resets = "Day resets in %d min",
	PausedPC = "Paused: move around!",
	PausedTouch = "Paused: close this and move!",
	ToGo = "%d min to go",
	-- the Play page (spec 5.4)
	PlayLoading = "Play time gifts",
	PlayPausedPC = { "Paused: move around to keep counting!", "Paused: move around!" },
	PlayPausedTouch = { "Paused: close this and move around!", "Paused: close this and move!" },
	ClaimAll = "Claim all (%d)",
	TierClaim = "Claim",
	ClockIcon = "clock", -- (kit-b U7a) the PixelIcon beside a tier's countdown
}

-- the owner's colourful cells (kept here, not in Theme): one colour per day and per tier. (kit-b U9-4, findings 15 / 26:
-- colour by role) each colour lives on its block's lip, in the kit's own tones (the neon hues they were, flat and softer,
-- the same order), never on the face: the face says the state (CELL_LOOK)
local SIGN = Theme.Sign
local DAY_COLORS = {
	SIGN.Grass, -- green
	SIGN.Sky, -- sky
	SIGN.SkyLip, -- blue
	SIGN.Violet, -- violet
	SIGN.Roof, -- pink
	SIGN.GoldDeep, -- orange
	SIGN.Red, -- red (the Week Wisp)
}
local TIER_COLORS = {
	SIGN.Sky, -- 10 min: sky
	SIGN.Grass, -- green
	SIGN.SkyLip, -- blue
	SIGN.Violet, -- violet
	SIGN.Roof, -- pink
	SIGN.GoldDeep, -- orange
	SIGN.Gold, -- 3 h: gold
}
DailyController.DayColors = DAY_COLORS
DailyController.TierColors = TIER_COLORS
-- (kit-b U9-4) a block's face and its edge per state: today gold, a claimed day / box the sunk well, the rest stone.
-- (U9-4 look review) the edges are solid kit tokens, never faded by alpha: wood on an open day and a locked box (a day or
-- a gift still to come keeps its frame), the Off block's edge on a claimed one, the ink edge of the pitch's selected
-- card on today and a ready box; those two pulse as a 2-frame swap on the 1 s tick (ink <-> the gold lip, no tween)
local CELL_LOOK = {
	Today = { Face = SIGN.Gold, Edge = SIGN.Text, Pulse = true },
	Open = { Face = SIGN.Tile, Edge = SIGN.Wood },
	Ready = { Face = SIGN.Tile, Edge = SIGN.Text, Pulse = true },
	Locked = { Face = SIGN.Tile, Edge = SIGN.Wood },
	Claimed = { Face = SIGN.Well, Edge = SIGN.WellEdge },
}
DailyController.CellLook = CELL_LOOK
K.PULSE_EDGE = SIGN.GoldLip -- the pulse's second frame
-- (kit-b U9-4, finding 26) the week's confetti: the prize's gold and the gift's pink (the Gifts button's block), each with
-- its lip tone, in place of the rainbow
K.CONFETTI_COLORS = { SIGN.Gold, SIGN.Roof, SIGN.GoldLip, SIGN.RoofLip }
-- (U9-4 look review: one pixel size per screen) every pixel icon in the window draws at one of two sizes, one double the
-- other: Glyph (the header gift, the sparkles, the clock, a reward's coin) and Art (a day's reward, the ticks, a box's
-- gift): 3 / 6 px cells on PC (27 / 54 at 1080p), 2 / 4 px on a phone (18 / 36). (look review 2) the kit's one table,
-- SignKit.Sizes.Pixel, which the Trove reads too
K.PIXEL = SignKit.Sizes.Pixel
-- (U9-4 look review) a day's reward art sits on its role's chip, as the HUD's strips colour each currency: cash the
-- grass block, tokens gold, gems navy, the rest stone; Ink = the pixel art's colour on it. (look review 2) the gem is the
-- pitch's pixel gem in sky on the navy chip (the cut gem's gradient facets were the one smooth shape among the pixel art;
-- the Play page's gem is the same icon)
K.ART_CHIP = {
	Cash = { Face = SIGN.Grass, Lip = SIGN.GrassLip, Ink = SIGN.OnGrass },
	Tokens = { Face = SIGN.Gold, Lip = SIGN.GoldLip, Ink = SIGN.Text },
	Gems = { Face = SIGN.Navy, Lip = SIGN.NavyLip, Ink = SIGN.Sky },
	Other = { Face = SIGN.Tile, Lip = SIGN.StoneLip, Ink = SIGN.Text },
}
K.ART_LIP = 4
K.ART_EDGE = 2
-- (Pitch 2 09 B) the prize card's name plank: the wood block (its dark lip and edge) with cream words (5.4:1); the plinth
-- under the pet the sunk well slab in its edge colour
K.PLANK = { Face = SIGN.Wood, Lip = SIGN.WoodDark, Edge = SIGN.WoodDark, Text = SIGN.Tile }
K.PLANK_EDGE, K.PLANK_LIP = 2, 3
-- (U9-4 look review 2) a play gift's reward on its role's tag, the Trove's tag part (a kit B block in a 2 px wood edge on
-- a 3 px lip): cash the grass tag, tokens the gold tag with the coin, gems the navy tag with the gem, each icon at the
-- glyph size before the amount; any other reward (the Berry Basket, a pet) stays a plain line. Text = the words' ink
K.REWARD_TAG = {
	Cash = { Face = SIGN.Grass, Lip = SIGN.GrassLip, Text = SIGN.OnGrass },
	Tokens = { Face = SIGN.Gold, Lip = SIGN.GoldLip, Text = SIGN.Text, Icon = "token", Ink = SIGN.Text },
	Gems = { Face = SIGN.Navy, Lip = SIGN.NavyLip, Text = SIGN.Gold, Icon = "gem", Ink = SIGN.Sky },
}
K.TAG_EDGE, K.TAG_LIP, K.TAG_GAP = 2, 3, 3
-- (U9-4 look review) the next gift to open shows the minutes played toward it as the kit's block bar (SignKit.BlockRow,
-- Count blocks; look review 2: painted as the Wisp bar's SEG_LOOK by H.paintTierBar, filled gold on its lip, empty the
-- lipless well, the deep gold face while the clock is paused) over its countdown; H = the blocks' height, Gap the px
-- between them, MaxW a block's widest
K.TIER_BAR = { Count = 5, PC = { H = 16, Gap = 4, MaxW = 26 }, Phone = { H = 12, Gap = 2, MaxW = 16 } }
-- the Wisp bar's blocks per state, in the kit's block-bar language (SignKit.BlockRow, the pitch's .seg): a filled block
-- has its darker lip (a claimed day grass, the green of the claimed tick; today gold), an open one is the sunk well
-- with no lip; each in a 2 px wood edge
local SEG_LOOK = {
	Claimed = { Face = SIGN.Grass, Lip = SIGN.GrassLip, Edge = SIGN.Wood, Text = SIGN.Text, LipPx = SignKit.Sizes.BlockLip },
	Today = { Face = SIGN.Gold, Lip = SIGN.GoldLip, Edge = SIGN.Wood, Text = SIGN.Text, LipPx = SignKit.Sizes.BlockLip },
	Open = { Face = SIGN.Well, Lip = SIGN.Well, Edge = SIGN.Wood, Text = SIGN.Text, LipPx = 0 },
}
local function paintSeg(seg, state)
	local look = SEG_LOOK[state] or SEG_LOOK.Open
	CloudUI.SignBlock(seg, look, { LipPx = look.LipPx, EdgePx = SignKit.Sizes.BlockEdge })
	seg:SetAttribute("State", state)
end

local DOT = "\194\183"
local CHECK = "check" -- (kit-b U7a) the claimed tick is a PixelIcon

local LocalPlayer = nil
local initialized = false
local U = { Cells = {}, Tiers = {}, Segs = {} } -- the instances
local S = {
	Open = false,
	Tab = "Daily",
	State = nil, -- the last payload
	Last = nil, -- the last non-Loading payload since the last Loading one (the baseline of pops / shakes / the week)
	Tutorial = nil, -- the last TutorialState payload
	SpawnAt = 0, -- time() of the last CharacterAdded
	LastFire = {},
	Mode = nil, -- "PC" | "Phone" | "Portrait" of the laid-out window
	ShakeX = 0,
	ShakeToken = 0,
	StepBackKey = nil,
	BannerUntil = 0,
	Pulse = false,
	BackBound = false,
	Hidden = true,
	WindowUp = false, -- H.windowUp() at the last H.layoutButton (the K.WINDOW_POLL watcher compares against it)
	WindowMods = {}, -- (review round 1) [name] = the K.WINDOWS module once found, or the clock of its next look-up
	TouchOff = false,
	VitalsOff = false, -- the HUD's vitals card is hidden for this window (H.coverColumn)
}
DailyController._S = S -- (review round 1) tests read the state (the K.WINDOWS module cache)
local warned = {}

local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[DailyController] " .. key .. ": " .. tostring(err))
	end
end

local function safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function controller(name)
	local inst = script.Parent:FindFirstChild(name)
	local ok, mod = pcall(function()
		return inst and require(inst)
	end)
	return ok and type(mod) == "table" and mod or nil
end

local function now()
	return workspace:GetServerTimeNow()
end

local function label(name, text, role, size, parent, props)
	local l = Theme.Label(text or "", role, { Size = size })
	l.Name = name
	l.TextWrapped = true
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	l.Parent = parent
	return l
end

local function place(inst, x, y, w, h)
	inst.AnchorPoint = Vector2.new(0, 0)
	inst.Position = UDim2.fromOffset(math.floor(x + 0.5), math.floor(y + 0.5))
	inst.Size = UDim2.fromOffset(math.max(0, math.floor(w + 0.5)), math.max(0, math.floor(h + 0.5)))
end

local function viewport()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize
	if vp and vp.X >= 2 and vp.Y >= 2 then
		return vp
	end
	return Vector2.new(1920, 1080)
end

-- "4h 12m" / "12m 5s"
local function leftText(seconds)
	local s = math.max(0, math.floor(tonumber(seconds) or 0))
	local h = math.floor(s / 3600)
	local m = math.floor((s % 3600) / 60)
	if h > 0 then
		return h .. "h " .. m .. "m"
	end
	return m .. "m " .. (s % 60) .. "s"
end

-- "5h" / "40m"
local function resetText(seconds)
	local s = math.max(0, math.floor(tonumber(seconds) or 0))
	if s >= 3600 then
		return math.floor(s / 3600) .. "h"
	end
	return math.max(1, math.ceil(s / 60)) .. "m"
end

local function petName(petId)
	local ok, catalog = pcall(function()
		return require(Shared:WaitForChild("PetCatalog", 5))
	end)
	local def = ok and type(catalog) == "table" and catalog.Get and catalog.Get(petId) or nil
	return (def and def.Name) or "a pet"
end

local function short(n)
	return Theme.Short(math.floor(tonumber(n) or 0))
end

-- a pet's name and its last word ("Week Wisp", "Wisp")
local function petNames(petId)
	local name = petName(petId)
	return { name, string.match(name, "(%S+)%s*$") or name }
end

-- the short amount of a cell, the longest form first ("$1.45K", "50", "Week Wisp" / "Wisp", "$1.23M"). (Pitch 2 F0, finish
-- pass A: one number style, Theme.Short; the cells read "$1,450" beside the HUD's "48.2K")
local function cellAmounts(entry)
	local kind = entry.Kind
	if kind == "Cash" then
		return { "$" .. short(entry.Amount) }
	elseif kind == "Pet" then
		return petNames(entry.PetId)
	elseif kind == "Berries" then
		return { "Berries" }
	end
	return { short(entry.Amount) }
end

-- a play tier whose claim would pay nothing now: the server resolved it to Amount 0 (a full Berry Basket) or "None".
-- CLAIM ALL leaves it out (DailyService.ClaimPlayAll skips it too); its own box still claims it
local function paysNothing(tier)
	if tier.Kind == "None" then
		return true
	end
	local amount = tonumber(tier.Amount)
	return tier.Kind ~= "Pet" and amount ~= nil and amount < 1
end

-- the words of a play tier's reward, the longest form first ("+$200", "+40" after the token coin, "Full Berry Basket" /
-- "Berry Basket" / "Full Basket"; a full Basket, Amount 0: "Basket is full" / "Basket full"). (U9-4 look review) tokens
-- and gems read as the Trove's tags do: their pixel icon before the amount, not the word (look review 2: on their role's
-- tag, K.REWARD_TAG, H.placeReward)
local function tierRewards(tier)
	local kind = tier.Kind
	if kind == "Cash" then
		return { "+$" .. short(tier.Amount) } -- (Pitch 2 F0) one number style, Theme.Short
	elseif kind == "Tokens" or kind == "Gems" then
		return { "+" .. short(tier.Amount) }
	elseif kind == "Berries" and paysNothing(tier) then
		return { "Basket is full", "Basket full" }
	elseif kind == "Berries" then
		return { "Full Berry Basket", "Berry Basket", "Full Basket" }
	elseif kind == "Pet" then
		return petNames(tier.PetId)
	end
	return { "+" .. short(tier.Amount) }
end

local function days(st)
	return (type(st) == "table" and type(st.Days) == "table") and st.Days or {}
end

local function play(st)
	return (type(st) == "table" and type(st.Play) == "table") and st.Play or {}
end

local function tiers(st)
	local p = play(st)
	return type(p.Tiers) == "table" and p.Tiers or {}
end

local function entryAt(list, i)
	local e = list[i]
	return type(e) == "table" and e or {}
end

-- true once the payload's view went stale (StaleAt passed): the server's fresh payload is on its way (re-review 2)
local function stale(st, at)
	local staleAt = type(st) == "table" and tonumber(st.StaleAt) or nil
	return staleAt ~= nil and staleAt > 0 and (at or now()) >= staleAt
end

-- a streak claim the server will take now: ready, not stale and not held by the 10-minute rule
local function claimable(st)
	local mode = DailyController.ClaimView(st, now(), false).Mode
	return mode == "Claim" or mode == "Repair"
end

local function tierReady(st)
	if type(st) ~= "table" or st.Loading == true then
		return false
	end
	for _, t in ipairs(tiers(st)) do
		if type(t) == "table" and t.Ready == true and t.Claimed ~= true then
			return true
		end
	end
	return false
end

-- the ring's fill: Play.Seconds / the next tier's seconds (1 once every tier is behind)
local function ringFill(st)
	local seconds = tonumber(play(st).Seconds) or 0
	for _, t in ipairs(tiers(st)) do
		local goal = (tonumber(type(t) == "table" and t.Min) or 0) * 60
		if goal > seconds then
			return math.max(0, math.min(1, seconds / goal))
		end
	end
	return #tiers(st) > 0 and 1 or 0
end

local function tutorialOk()
	local t = S.Tutorial
	if type(t) ~= "table" then
		local tc = controller("TutorialController")
		if tc and type(tc.GetState) == "function" then
			local ok, state = pcall(tc.GetState)
			t = ok and state or nil
		end
	end
	if type(t) ~= "table" then
		return false
	end
	if t.Done == true then
		return true
	end
	local spin = TutorialSteps.IndexOf and TutorialSteps.IndexOf.spin or 1
	local step = tonumber(t.Step) or (type(t.Id) == "string" and TutorialSteps.IndexOf[t.Id]) or 0
	return step >= spin
end

local function hiddenByPlay()
	local p = LocalPlayer
	if not p then
		return true
	end
	return p:GetAttribute(Config.Attr.InMatch) == true or p:GetAttribute(Config.Attr.InBattle or "InBattle") ~= nil
end

local H = {}
DailyController._H = H -- (review round 2) tests stand in a step of Open (a build / layout / render that throws)

-- the first of `texts` that fits the label's box (its design width less FIT_SLACK) at its size and font, measured by
-- TextService (the real font: a cell's text is never cut to "Week W..."); the last one when none does
function H.fitText(lbl, texts)
	local width = lbl.Size.X.Offset - K.FIT_SLACK
	for i = 1, #texts - 1 do
		local ok, size = pcall(function()
			return Theme.MeasureLabel(lbl, texts[i], lbl.TextSize, 4096)
		end)
		if not ok or typeof(size) ~= "Vector2" or size.X <= width then
			return texts[i]
		end
	end
	return texts[#texts]
end

-- (fix6 look0 #6: at 1024 x 768 the PC page at its 0.8 scale left 66 px tiles: '$1.45K' at 24 px read '$1.4...', 'TODAY'
-- ran 1.4 px past its box) the label's own text at the largest size up to `size` that fits its box (less K.FIT_SLACK),
-- never under the readability floor (K.FLOOR_PX screen px at this window's scale); the size it set. The measure keeps 4 %
-- to spare, as BattleController's Hud.FitLine (a heavy face's measure ran short of its drawn width: 'TODAY')
function H.shrinkFit(lbl, size)
	local floorPx = H.floorPx()
	local width = lbl.Size.X.Offset - K.FIT_SLACK
	local s = size
	while s > floorPx and H.drawnW(lbl, lbl.Text, s) > width do
		s = s - 1
	end
	lbl.TextSize = s
	return s
end

-- (fix6 look0 #6) the readability floor in this window's design px
function H.floorPx()
	return math.ceil(K.FLOOR_PX / math.max(0.05, tonumber(S.Scale) or 1) - 1e-6)
end

-- (fix6 look0 #6) a label's text width at `s` as it will draw: the wider of its own measure and its font role's (a face
-- label - Nunito ExtraBold - measures by its role's stand-in font and spare: Theme.Measure), 4 % to spare; a word in
-- capitals ('TODAY') never under BattleController's tagW guess, 0.72 em a capital, 0.58 any other letter or digit, 0.3
-- a space (capitals in the heavy face run past the stand-in's measure: 'TODAY' drew 1.4 px past a box it measured into)
function H.drawnW(lbl, text, s)
	local best = 0
	text = tostring(text or "")
	if not text:find("%l") and select(2, text:gsub("%u", "")) >= 2 then
		local em = 0
		for ch in text:gmatch(".") do
			em = em + ((ch == " ") and 0.3 or (ch:match("%u") and 0.72 or 0.58))
		end
		best = em * s
	end
	for _, f in ipairs({
		function()
			return Theme.MeasureLabel(lbl, text, s, 4096)
		end,
		function()
			return Theme.Measure(text, lbl:GetAttribute("FontRole") or "Body", s, 4096)
		end,
	}) do
		local ok, v = pcall(f)
		if ok and typeof(v) == "Vector2" then
			best = math.max(best, v.X)
		end
	end
	return best * 1.04
end

-- a text's width at a size and font (TextService; the mock's flat 0.5 em when that fails)
function H.width(text, size, font)
	local ok, v = pcall(function()
		return Theme.Measure(text, font, size, 4096)
	end)
	if ok and typeof(v) == "Vector2" then
		return v.X
	end
	return #tostring(text) * size * 0.5
end

-- the rows `text` word-wraps into at `width` px (each word measured by TextService; math.huge when one word is wider)
function H.rows(text, size, font, width)
	local rows, cur = 0, 0
	local space = H.width(" ", size, font)
	for word in string.gmatch(tostring(text), "%S+") do
		local w = H.width(word, size, font)
		if w > width then
			return math.huge
		end
		if cur > 0 and cur + space + w <= width then
			cur = cur + space + w
		else
			rows = rows + 1
			cur = w
		end
	end
	return math.max(rows, 1)
end

-- H.fitText for a label of `lines` rows: the first of `texts` that word-wraps into them (one row: H.fitText)
function H.fitLines(lbl, texts, lines)
	if (lines or 1) <= 1 then
		return H.fitText(lbl, texts)
	end
	local width = lbl.Size.X.Offset - K.FIT_SLACK
	for i = 1, #texts - 1 do
		if H.rows(texts[i], lbl.TextSize, Theme.FontOf(lbl), width) <= lines then
			return texts[i]
		end
	end
	return texts[#texts]
end

-- the played seconds at server time `at`: the payload's, plus the time since ServerNow while the server counts (Active)
function H.liveSeconds(st, at)
	local p = play(st)
	local seconds = tonumber(p.Seconds) or 0
	if p.Active == true then
		seconds = seconds + math.max(0, (tonumber(at) or now()) - (tonumber(type(st) == "table" and st.ServerNow) or at or now()))
	end
	return seconds
end

-- the play tiers a CLAIM ALL would claim now (not one that would pay nothing: the server leaves it for its own box)
function H.readyCount(st)
	if type(st) ~= "table" or st.Loading == true then
		return 0
	end
	local n = 0
	for _, t in ipairs(tiers(st)) do
		if type(t) == "table" and t.Ready == true and t.Claimed ~= true and not paysNothing(t) then
			n = n + 1
		end
	end
	return n
end

function H.touchOnly()
	return UserInputService.TouchEnabled == true and UserInputService.KeyboardEnabled ~= true
end

----------------------------------------------------------------------
-- The button, its pip and ring
----------------------------------------------------------------------
function H.hud()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	return pg and pg:FindFirstChild("NimbusHud")
end

function H.small()
	local vp = viewport()
	return math.min(vp.X, vp.Y) <= K.SMALL
end

function H.buttonSize()
	if H.small() then
		return K.BTN_MIN
	end
	return math.max(K.BTN_MIN, math.floor(K.BTN * Theme.ScreenFactor(viewport().Y)))
end

-- (kit-b U8: the pitch's HUD stage) the button is a small pink kit B block (the awning colour: face, darker lip, wood edge;
-- square) with the pixel gift over the word "Gift", both brown; H.paintButton sizes them to the block
function H.buildButton()
	local size = H.buttonSize()
	local Sign = Theme.Sign
	local button = Instance.new("TextButton")
	button.Name = "GiftsButton"
	button.Text = ""
	button.AutoButtonColor = false
	button.BorderSizePixel = 0
	button.BackgroundTransparency = 0
	button.BackgroundColor3 = Sign.Roof
	button.Size = UDim2.fromOffset(size, size)
	button.ZIndex = 2
	button:SetAttribute("SignLook", "Gift")
	local edge = Instance.new("UIStroke")
	edge.Name = "SignEdge"
	edge.Color = Sign.Wood
	edge.Thickness = 3
	edge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	edge.LineJoinMode = Enum.LineJoinMode.Miter
	edge.Parent = button
	local lip = Instance.new("Frame")
	lip.Name = "Lip"
	lip.BorderSizePixel = 0
	lip.BackgroundColor3 = Sign.RoofLip
	lip.AnchorPoint = Vector2.new(0, 1)
	lip.Position = UDim2.new(0, 0, 1, 0)
	lip.Size = UDim2.new(1, 0, 0, 5)
	lip.ZIndex = 2
	lip.Parent = button
	button.Parent = U.Gui
	U.Button = button
	U.Icon = NeonKit.Icon(button, "Gifts", 27)
	U.Icon.TextColor3 = Sign.Text
	U.Icon.ZIndex = 3
	U.Word = Theme.Label("Gift", "Button", { Size = 15, Color = Sign.Text })
	U.Word.Name = "Word"
	U.Word.AnchorPoint = Vector2.new(0.5, 0.5)
	U.Word.TextXAlignment = Enum.TextXAlignment.Center
	U.Word.ZIndex = 3
	U.Word.Parent = button
	-- (U9-4 look review: the bar census) the play clock's progress toward the next tier (spec 8: "fills toward the next
	-- tier") in the kit's block-bar language, inside the block: Frame "PlayBar" over the block's lip, K.BAR_SEGS blocks
	-- with K.BAR_GAP px of the lip between them, filled left to right in gold (whole blocks, whole px), the gold lip while
	-- the clock is paused (never alpha); the rest stays the lip's own pink. It replaced a gold outline swept by a rotating
	-- gradient round the block (no segments, no lip, alpha-dimmed)
	local bar = Instance.new("Frame")
	bar.Name = "PlayBar"
	bar.BackgroundTransparency = 1
	bar.BorderSizePixel = 0
	bar.Size = UDim2.fromScale(1, 1)
	bar.ZIndex = 3
	bar.Parent = lip
	U.PlayBar = bar
	U.BarSegs = {}
	for i = 1, K.BAR_SEGS do
		local seg = Instance.new("Frame")
		seg.Name = "Seg" .. i
		seg.BorderSizePixel = 0
		seg.BackgroundColor3 = Sign.RoofLip
		seg.ZIndex = 3
		seg.Parent = bar
		U.BarSegs[i] = seg
	end
	local pip = Instance.new("Frame")
	pip.Name = "Pip"
	pip.BackgroundColor3 = Theme.Sign.Red -- (kit-b U8) a small red square in a wood edge
	pip.BorderSizePixel = 0
	pip.AnchorPoint = Vector2.new(0.5, 0.5)
	pip.Position = UDim2.new(1, -2, 0, K.PIP / 2) -- (C45: the bigger badge's top on the block's top, not over the strip)
	pip.Size = UDim2.fromOffset(K.PIP, K.PIP)
	pip.ZIndex = 5
	pip.Visible = false
	local pipEdge = Instance.new("UIStroke")
	pipEdge.Color = Theme.Sign.Wood
	pipEdge.Thickness = 2
	pipEdge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	pipEdge.LineJoinMode = Enum.LineJoinMode.Miter
	pipEdge.Parent = pip
	-- (playtest 2026-11-28 C45) the brown "!" of the menu tiles' badges (NeonKit): an empty red square read as a stray pixel
	local pipMark = Theme.Label("!", "Button", {
		Size = 16,
		Color = Theme.Sign.Text,
		Props = { Name = "Mark", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 6 },
	})
	pipMark.Parent = pip
	pip.Parent = U.Button
	U.Pip = pip
	-- (owner 2026-11-13) the button only opens: it hides while its window is open (X / Esc / gamepad B close it)
	U.Button.Activated:Connect(function()
		DailyController.Open()
	end)
end

-- the PlayBar: the segments laid out across the block's width (whole px; the last one takes the rounding), the first
-- floor(fill x K.BAR_SEGS) gold (the gold lip while paused), the rest the lip's pink; hidden with no play tiers
function H.paintRing()
	if not U.PlayBar then
		return
	end
	local st = S.State
	local fill = ringFill(st)
	local n = K.BAR_SEGS
	local k = math.max(0, math.min(n, math.floor(fill * n + 1e-6)))
	U.PlayBar:SetAttribute("Fill", fill)
	U.PlayBar:SetAttribute("Filled", k)
	local paused = type(st) == "table" and st.Loading ~= true and play(st).Active == false
	U.PlayBar:SetAttribute("Paused", paused)
	local w = U.Button and U.Button.Size.X.Offset or 0
	local segW = math.max(1, math.floor((w - (n - 1) * K.BAR_GAP) / n))
	-- (playtest 2026-11-28 C45) every block the same width, the row centred (the last one took the rounding: 11 vs 9 px)
	local x0 = math.floor((w - (n * segW + (n - 1) * K.BAR_GAP)) / 2)
	local Sign = Theme.Sign
	for i, seg in ipairs(U.BarSegs) do
		local x = x0 + (i - 1) * (segW + K.BAR_GAP)
		seg.Position = UDim2.fromOffset(x, 0)
		seg.Size = UDim2.new(0, segW, 1, 0)
		seg.BackgroundColor3 = i <= k and (paused and Sign.GoldLip or Sign.Gold) or Sign.RoofLip
		seg.BackgroundTransparency = 0
	end
	U.PlayBar.Visible = type(st) == "table" and st.Loading ~= true and #tiers(st) > 0
end

-- (lobby-shop review round 1: the Shop only; slop audit 2026-11-12, win 5: every window) a window over the button's
-- corner (the Shop's wide rect, the Pets window, the Index, the menu's windows, the Training Place ...) would sit under or
-- over it: the button, its ring and its pip hide while any controller of K.WINDOWS answers IsOpen() == true. Re-laid out by
-- MenuController.WindowOpened (another id), ShopController.Toggled and the K.WINDOW_POLL watcher (a close path with no
-- signal: an X, Esc, another window taking over, a match start). (owner 2026-11-13) The Gifts window itself hides them
-- too: S.Open, asked first (Open / Close re-lay the button out at once); an NPC talk box is NpcController in the list.
-- Nothing anchors to the button (the window is centred, the tutorial has no arrow on it, no claim flies to it), and
-- X / Esc / gamepad B still close the window while its toggle button is hidden.
-- (review round 1) the poll stays cheap: each K.WINDOWS module is looked up (FindFirstChild + require) once and kept; one
-- not found yet is looked up again at most every K.WINDOW_RETRY seconds; a tick is then only their IsOpen calls
function H.windowModule(name)
	local hit = S.WindowMods[name]
	if type(hit) == "table" then
		return hit
	end
	local t = os.clock()
	if type(hit) == "number" and t < hit then
		return nil
	end
	local mod = controller(name)
	S.WindowMods[name] = mod or (t + K.WINDOW_RETRY)
	return mod
end

function H.windowUp()
	if S.Open then
		return true
	end
	for _, name in ipairs(K.WINDOWS) do
		local mod = H.windowModule(name)
		if mod and type(mod.IsOpen) == "function" then
			local ok, open = pcall(mod.IsOpen)
			if ok and open == true then
				return true
			end
		end
	end
	-- (gate fix) the menu's own windows (Settings from the HUD pill's gear, Credits, What's new) are not the title screen,
	-- so MainMenuController.IsOpen() says false for them: ask Window() for the panel's holder instead
	local main = H.windowModule("MainMenuController")
	if main and type(main.Window) == "function" then
		local ok, holder = pcall(main.Window)
		if ok and holder ~= nil and holder.Parent ~= nil then
			return true
		end
	end
	return false
end

-- the K.WINDOW_POLL watcher's step: a layout only when the answer changed since the last one
function H.watchWindows()
	if H.windowUp() ~= S.WindowUp then
		H.layoutButton()
	end
end

function H.layoutButton()
	if not U.Button then
		return
	end
	local size = H.buttonSize()
	local hud = H.hud()
	local left = tonumber(hud and hud:GetAttribute("TopRightLeft")) or 0
	S.WindowUp = H.windowUp()
	S.Hidden = left <= 0 or hiddenByPlay() or S.WindowUp
	local x, y = math.floor(left - K.GAP - size + 0.5), K.TOP
	-- (kit-b U8) the HUD's dock under the strips (GiftLeft / GiftTop / GiftSize; a HUD without them: left of the strips as
	-- before); a dock of 0 (a result card holding the corner) hides the button
	local dock = hud and tonumber(hud:GetAttribute("GiftSize"))
	if dock ~= nil then
		size = dock
		x = tonumber(hud:GetAttribute("GiftLeft")) or x
		y = tonumber(hud:GetAttribute("GiftTop")) or y
		S.Hidden = S.Hidden or dock <= 0
	end
	U.Button.Size = UDim2.fromOffset(size, size)
	U.Button.Position = UDim2.fromOffset(x + S.ShakeX, y)
	-- (LOOK-ui) the HUD's one edge token: the block sits at scale 1, so its 3 px edge and 5 px lip follow the screen factor
	-- in whole px (3 / 5 at 1080p, 2 / 4 below), like the strips above it under their 0.8 scale
	local f = Theme.ScreenFactor(viewport().Y)
	local edge = U.Button:FindFirstChild("SignEdge")
	if edge then
		edge.Thickness = math.max(2, math.floor(3 * f + 0.5))
	end
	local lip = U.Button:FindFirstChild("Lip")
	if lip then
		lip.Size = UDim2.new(1, 0, 0, math.max(4, math.floor(5 * f + 0.5)))
	end
	-- the pixel gift over the word, sized to the block (the word never under 14 px)
	local iconPx = math.max(18, math.floor(size * 0.48 / 9) * 9)
	if U.Icon.TextSize ~= iconPx then
		U.Icon.TextSize = iconPx
	end
	U.Icon.Size = UDim2.fromOffset(iconPx, iconPx) -- (NeonKit.Icon's own box is 1.25 x: the icon fills this one)
	-- (U9-4 look review 2) both at whole-px offsets (the gift centred by scale sat at y .72 / .28: soft on a phone)
	U.Icon.AnchorPoint = Vector2.new(0, 0)
	U.Icon.Position = UDim2.fromOffset(math.floor((size - iconPx) / 2), math.floor(size * 0.38 - iconPx / 2))
	U.Word.TextSize = math.max(14, math.floor(size * 0.27 + 0.5))
	U.Word.Size = UDim2.new(1, 0, 0, U.Word.TextSize + 2)
	U.Word.AnchorPoint = Vector2.new(0, 0)
	U.Word.Position = UDim2.fromOffset(0, math.floor(size * 0.76 - (U.Word.TextSize + 2) / 2))
	U.Button.Visible = not S.Hidden
	H.paintRing() -- (the PlayBar lives in the block's lip: it hides and shakes with the block)
	H.refreshPip()
end

function H.refreshPip()
	if U.Pip then
		U.Pip.Visible = DailyController.PipShown()
	end
end

function H.shake()
	S.ShakeToken = S.ShakeToken + 1
	local mine = S.ShakeToken
	task.spawn(function()
		for _, dx in ipairs(K.SHAKE) do
			if S.ShakeToken ~= mine then
				return
			end
			S.ShakeX = dx
			safe("shake", H.layoutButton)
			task.wait(K.SHAKE_STEP)
		end
		if S.ShakeToken == mine then
			S.ShakeX = 0
			safe("shake", H.layoutButton)
		end
	end)
end

----------------------------------------------------------------------
-- The window: built once, laid out on every screen change
----------------------------------------------------------------------
-- a tab: its block is a sibling frame under the (transparent) button (kit-b U9-4: a kit B block, H.paintTab paints it
-- stone or the selected gold), so the button keeps its own text over it
function H.tabButton(name, text)
	local fill = Instance.new("Frame")
	fill.Name = name .. "Fill"
	fill.BorderSizePixel = 0
	fill.ZIndex = 5
	fill.Parent = U.Bar
	CloudUI.SignBlock(fill, "Stone", { Pad = false })
	local b = Instance.new("TextButton")
	b.Name = name
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.BackgroundTransparency = 1
	b.Text = text
	b.ZIndex = 6
	Theme.Style(b, "Button", { Size = 17, Color = SIGN.Text })
	b.Parent = U.Bar
	return b
end

-- (kit-b U9-4) a square tag in its wood edge with brown words (the streak on stone, the VIP chip on gold)
function H.chip(name, look, parent)
	local c = label(name, "", "Heading", 15, parent, { TextWrapped = false, ZIndex = 5 })
	CloudUI.SignBlock(c, look, { LipPx = 0, EdgePx = 2 })
	return c
end

-- (kit-b U9-4) the sunk cover over a claimed day or box: the well, see-through enough to show what was won
function H.dim(parent)
	return Util.Create("Frame", {
		Name = "Dim", BackgroundColor3 = SIGN.Well, BackgroundTransparency = 0.35, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		ZIndex = 6, Visible = false, Parent = parent,
	})
end

-- (kit-b U9-4, the owner's look bar 2026-11-17: a small handmade touch on rewards) the glint of the one thing to claim:
-- Frame "Sparkles" with two pixel sparkles (PixelIcon "sparkle", SparkleA / SparkleB) that take turns on the 1 s tick (two
-- frames, no tween, no glow); hidden until H.placeSparkles shows it round a tile's art or a box's gift
function H.sparkles(parent)
	return Util.Create("Frame", { Name = "Sparkles", BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1),
		Visible = false, ZIndex = 7, Active = false, Parent = parent })
end

-- the two sparkles in `colour` at the corners of a w x h art box at (x, y): one over its top right, one over its bottom
-- left; px a multiple of 9 (PixelIcon's whole pixels), redrawn only when the size changes
function H.placeSparkles(box, x, y, w, h, px, colour)
	if box:GetAttribute("Px") ~= px then
		box:SetAttribute("Px", px)
		for _, c in ipairs(box:GetChildren()) do
			c:Destroy()
		end
		for i, name in ipairs({ "SparkleA", "SparkleB" }) do
			local icon = PixelIcon.New(box, "sparkle", px, colour)
			if icon then
				icon.Name = name
				icon.ZIndex = 7
				for _, f in ipairs(icon:GetChildren()) do
					f.ZIndex = 7
				end
				icon.Visible = i == 1
			end
		end
	end
	local a, b = box:FindFirstChild("SparkleA"), box:FindFirstChild("SparkleB")
	if a then
		a.Position = UDim2.fromOffset(math.floor(x + w - px * 0.6), math.floor(y - px * 0.2))
	end
	if b then
		b.Position = UDim2.fromOffset(math.floor(x - px * 0.4), math.floor(y + h - px * 0.8))
	end
end

-- the tick's twinkle: the lit sparkle swaps
function H.twinkle(box, flip)
	local a, b = box:FindFirstChild("SparkleA"), box:FindFirstChild("SparkleB")
	if a and b then
		a.Visible, b.Visible = not flip, flip
	end
end

-- (U9-4 look review) a pixel size of the laid-out screen (K.PIXEL): "Glyph" or "Art"
function H.px(kind)
	local set = K.PIXEL[S.Mode == "PC" and "PC" or "Phone"]
	return set[kind] or set.Glyph
end

-- the largest of the screen's two pixel sizes that fits `room` px (the glyph size when neither does)
function H.fitPx(room)
	local art = H.px("Art")
	return (tonumber(room) or 0) >= art and art or H.px("Glyph")
end

-- (P2 icons review r1, major 2: the reward art drew 54 px on PC tiles and 36 on phone tiles, the gem, the coin and the
-- bills small in big empty tiles) a day's reward art at the approved 09_daily_layout B size, M.RewardPx (72 px: 4 px
-- cells of the 18 x 18 sheet art on PC tiles; 54: 3 px cells on phone tiles; the reward is the tile's hero), where
-- `room` holds it; else the largest of the screen's two pixel sizes that does
function H.rewardPx(room, M)
	local want = M and tonumber(M.RewardPx) or 0
	if want > 0 and (tonumber(room) or 0) >= want then
		return want
	end
	return H.fitPx(room)
end

-- a sparkle's px: the screen's glyph size
local function sparklePx()
	return H.px("Glyph")
end

-- the TextSize of a label whose hosted PixelIcon (0.9 x the TextSize, snapped to 9s) must draw at `px`
local function hostSize(px)
	return math.ceil(px / 0.9)
end

-- (kit-b U9-4) a day tile: a kit B block (NeonKit.Card Skin "Sign"; H.paintLook gives it its face and edge, the day's
-- colour sits on its lip)
function H.newCell(i, parent)
	local c = NeonKit.Card({ Name = "Cell" .. i, Skin = "Sign", BodyOverLip = true, Lip = DAY_COLORS[i], Size = UDim2.fromOffset(92, 122), ZIndex = 4, Parent = parent })
	local pop = Instance.new("UIScale")
	pop.Name = "Pop"
	pop.Parent = c.Root
	local day = label("Day", "Day " .. i, "Label", 15, c.Body, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	local art = Instance.new("Frame")
	art.Name = "Art"
	art.BackgroundTransparency = 1
	art.ZIndex = 5
	art.Parent = c.Body
	local amount = label("Amount", "", "Display", 17, c.Body, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	amount.TextTruncate = Enum.TextTruncate.AtEnd
	local dim = H.dim(c.Body)
	local check = label("Check", "", "Title", 36, c.Body, { TextColor3 = SIGN.GrassLip, ZIndex = 7, Visible = false, TextWrapped = false })
	-- (P2 icons look fin0, minor: green on Day 1's green bills) the tick in a 1-cell cream ring, the 09_daily_layout B
	-- mock-up's (PixelIcon's keyline)
	check:SetAttribute("IconKey", SIGN.Tile)
	PixelIcon.Host(check, CHECK) -- sized with the label
	U.Cells[i] = { Card = c, Root = c.Root, Pop = pop, Day = day, Art = art, Amount = amount, Dim = dim, Check = check, ArtKey = nil, LookKey = nil,
		Sparkles = H.sparkles(c.Body) }
end

-- a play-time gift box (card B): the minutes, the gift, the reward and one slot (Claim, the clock or the tick); (kit-b
-- U9-4) a kit B block like a day tile, its Claim a stone plank (Claim all is the page's one green action)
function H.newTier(i, parent)
	local c = NeonKit.Card({ Name = "Tier" .. i, Skin = "Sign", BodyOverLip = true, Lip = TIER_COLORS[i], Size = UDim2.fromOffset(104, 204), ZIndex = 4, Parent = parent })
	local pop = Instance.new("UIScale")
	pop.Name = "Pop"
	pop.Parent = c.Root
	local timeLabel = label("Time", "", "Heading", 15, c.Body, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	local gift = Util.Create("Frame", { Name = "Gift", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Parent = c.Body })
	gift:SetAttribute("Bobbing", false)
	local reward = label("Reward", "", "Display", 15, c.Body, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	reward.TextTruncate = Enum.TextTruncate.AtEnd
	local dim = H.dim(c.Body)
	local clock = label("Clock", "", "Display", 16, c.Body, { TextColor3 = SIGN.Text, TextWrapped = false, ZIndex = 5, Visible = false })
	local glyph = label("ClockGlyph", "", "Display", 16, c.Body, { TextColor3 = SIGN.Text, TextWrapped = false, ZIndex = 5, Visible = false })
	PixelIcon.Host(glyph, TEXT.ClockIcon) -- sized with the label
	local check = label("Check", "", "Title", 28, c.Body, { TextColor3 = SIGN.GrassLip, ZIndex = 7, TextWrapped = false, Visible = false })
	PixelIcon.Host(check, CHECK)
	local claim = CloudUI.Button({ Name = "Claim", Text = TEXT.TierClaim, Style = "Gray", Skin = "Sign", Size = UDim2.fromOffset(92, 44), TextSize = 16,
		ZIndex = 8, Parent = c.Body, Callback = function()
			H.send("ClaimPlay", i)
		end })
	U.Tiers[i] = { Card = c, Root = c.Root, Pop = pop, Time = timeLabel, Gift = gift, Reward = reward, Dim = dim, Clock = clock,
		Glyph = glyph, Check = check, Claim = claim, GiftKey = nil, ClockKey = nil, LookKey = nil, Sparkles = H.sparkles(c.Body) }
end

function H.ensureWindow()
	if U.Holder then
		return
	end
	U.Cells, U.Tiers, U.Segs = {}, {}, {}
	local holder = Util.Create("Frame", { Name = "DailyHolder", BackgroundTransparency = 1, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = 4, Parent = U.Gui })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	-- (kit-b U9-4, finding 15) the Signboard of the Shop: the wood frame round the stone body with its lip, square
	local win = Util.Create("Frame", {
		Name = "DailyWindow", BackgroundColor3 = SIGN.Wood, BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = holder,
	})
	win:SetAttribute("SignKit", "Frame")
	U.Window = win
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = win })
	local stone = Util.Create("Frame", {
		Name = "Stone", BackgroundColor3 = SIGN.Stone, BorderSizePixel = 0, Position = UDim2.fromOffset(K.FRAME, K.FRAME),
		Size = UDim2.new(1, -2 * K.FRAME, 1, -2 * K.FRAME), ZIndex = 3, Parent = win,
	})
	stone:SetAttribute("SignKit", "Body")
	Util.Create("Frame", {
		Name = "Lip", BackgroundColor3 = SIGN.StoneLip, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, SignKit.Sizes.Lip), ZIndex = 3, Parent = stone,
	})
	SignKit.FinishFrame(win, { Body = stone }) -- (Pitch 2 F0) the frame's light, the window's shadow, the carved body
	-- the navy header plank with its darker lip inside the wood frame (the Shop's header): the gift on its gold square,
	-- "Gifts" as the window's ribbon title, the tabs and the close sit on it
	local bar = Util.Create("Frame", { Name = "TitleBar", BackgroundColor3 = SIGN.Navy, BorderSizePixel = 0, ZIndex = 5, Parent = win })
	Util.Create("Frame", {
		Name = "Lip", BackgroundColor3 = SIGN.NavyLip, BorderSizePixel = 0, AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 4), ZIndex = 5, Parent = bar,
	})
	SignKit.BandTop(bar) -- (Pitch 2 F0) the navy band's lit top line
	U.Bar = bar
	U.GiftsIcon = label("GiftsIcon", "", "Display", 32, bar, {
		TextTruncate = Enum.TextTruncate.None, BackgroundTransparency = 0, BackgroundColor3 = SIGN.Gold, TextColor3 = SIGN.Text, ZIndex = 6,
	})
	-- (U9-4 look review) the kit's header icon square (SignKit.Header's IconSlot, the pitch's .hi): 42 px on PC, a 2 px
	-- ink edge, as every window's
	local iconEdge = Instance.new("UIStroke")
	iconEdge.Name = "SignEdge"
	iconEdge.Color = SIGN.Text
	iconEdge.Thickness = 2
	iconEdge.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	iconEdge.LineJoinMode = Enum.LineJoinMode.Miter
	iconEdge.Parent = U.GiftsIcon
	PixelIcon.Host(U.GiftsIcon, NeonKit.IconName("Gifts")) -- the pixel gift, sized with the label
	U.Title = label("WindowTitle", "Gifts", "Title", 34, bar, { TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = false, ZIndex = 6 })
	U.Title:SetAttribute("RibbonBand", "NoTails") -- (as the Shop's: the band ends square on the navy plank)
	Theme.StyleTitle(U.Title)
	-- the awning: one fixed-size piece over the top rim (never stretched with the window: the sign rule); PC only
	U.Roof = SignKit.Roof(win, { Width = K.ROOF_W, Y = SignKit.RoofSeat(), ZIndex = 7 }) -- (F0 review) seated on the frame
	U.TabDaily = H.tabButton("Tab_Daily", "Daily")
	U.TabPlay = H.tabButton("Tab_Play", "Play time")
	U.TabDaily.Activated:Connect(function()
		H.setTab("Daily")
	end)
	U.TabPlay.Activated:Connect(function()
		H.setTab("Play")
	end)
	U.Close = CloudUI.Button({ Name = "CloseButton", Text = "", Style = "Red", Skin = "Sign", Size = UDim2.fromOffset(44, 44), TextSize = 22,
		ZIndex = 7, Parent = bar, Callback = function()
			DailyController.Close()
		end })
	-- slop audit 2026-11-12: a drawn X (the U+2715 glyph showed a missing-glyph box); kit B: square bars in brown ink
	NeonKit.CloseMark(U.Close, { Square = true, Ink = SIGN.RedLip, Color = SIGN.Text })
	-- (U9-4 look review 2) on a phone the red block is 36 px inside the band and this see-through 44 px touch box lies
	-- under it (a tap on the block presses the block; one on the ring round it closes too)
	U.CloseTap = Util.Create("TextButton", {
		Name = "CloseTap", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, BorderSizePixel = 0, Selectable = false,
		Active = true, ZIndex = 6, Visible = false, Parent = bar,
	})
	U.CloseTap:SetAttribute("HitFor", "CloseButton") -- (F0 review, major 7) the close's 44 px thumb target
	U.CloseTap.Activated:Connect(function()
		DailyController.Close()
	end)
	U.Body =Util.Create("Frame", { Name = "Body", BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 4, Parent = win })

	-- the Daily page (card A)
	local daily = Util.Create("Frame", { Name = "DailyPage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 4, Parent = U.Body })
	U.DailyPage = daily
	U.DailyHeader = label("Header", "", "Title", 18, daily, { TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	Theme.StyleTitle(U.DailyHeader, "Section") -- (the owner's ruling 2026-11-14: the ribbon is for window titles only)
	-- (Pitch 2 F0 A: "dotted pixel rules"; look review of finish pass A, minor) the dotted rule under the heading line
	U.HeadRule = SignKit.Rule(daily, { Name = "HeadRule", ZIndex = 5 })
	U.StreakChip = H.chip("StreakChip", "Stone", daily)
	U.VipChip = H.chip("VipChip", "Selected", daily)
	U.VipChip.Text = "VIP x2"
	U.CellsFrame = Util.Create("Frame", { Name = "Cells", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4, Parent = daily })
	for i = 1, 7 do
		H.newCell(i, U.CellsFrame)
	end
	-- (Pitch 2 09 B) Day 7 is the prize card: the pet on its plinth, the name on a wood plank, the species line, and the
	-- week's countdown (the line, its 7-block bar, the week banner in their place) inside the card
	local hero = U.Cells[7]
	local card = hero.Card.Body
	hero.Plinth = Util.Create("Frame", { Name = "Plinth", BorderSizePixel = 0, ZIndex = 5, Parent = card })
	CloudUI.SignBlock(hero.Plinth, "Off", { EdgePx = 2, LipPx = 0, Pad = false })
	CloudUI.SignBlock(hero.Amount, K.PLANK, { EdgePx = K.PLANK_EDGE, LipPx = K.PLANK_LIP })
	hero.Amount:SetAttribute("Plank", true)
	hero.Species = label("Species", "", "Label", 15, card, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.TextMuted })
	U.WispText = label("WispText", "", "Heading", 15, card, { TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	U.WispBar = Util.Create("Frame", { Name = "WispBar", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5, Parent = card })
	for i = 1, 7 do
		local seg = Util.Create("Frame", { Name = "Seg" .. i, BorderSizePixel = 0, ZIndex = 6, Parent = U.WispBar })
		paintSeg(seg, "Open")
		U.Segs[i] = seg
	end
	-- the page's one green plank (kit-b U9-4: a kit B block; locked, the Off block)
	U.Claim = CloudUI.Button({ Name = "ClaimButton", Text = TEXT.Claim, Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(360, 88), TextSize = 40, ZIndex = 6,
		Parent = daily, Callback = function()
			H.onClaim()
		end })
	U.Line1 = label("Line1", "", "Body", 15, U.Claim, { TextWrapped = false, Visible = false, ZIndex = 9, TextColor3 = SIGN.Text })
	U.Line2 = label("Line2", "", "Body", 15, U.Claim, { TextWrapped = false, Visible = false, ZIndex = 9, TextColor3 = SIGN.TextMuted })
	U.Countdown = label("Countdown", "", "Heading", 17, daily, { ZIndex = 5, TextColor3 = SIGN.Text })
	U.Keep = label("Keep", TEXT.Keep, "Body", 15, daily, { TextColor3 = SIGN.TextMuted, ZIndex = 5, TextYAlignment = Enum.TextYAlignment.Top })
	-- (kit-b U9-4) the week banner: a gold block with brown words in the Wisp line's place
	U.Banner = label("WeekBanner", TEXT.Week, "Title", 15, card, { Visible = false, ZIndex = 8 }) -- (over the card's cover)
	Theme.StyleTitle(U.Banner, "Section")
	CloudUI.SignBlock(U.Banner, "Selected", { LipPx = 0, EdgePx = 2 })

	-- the Play page (card B: the header line, CLAIM ALL, seven gift boxes)
	local playPage = Util.Create("Frame", { Name = "PlayPage", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 4, Parent = U.Body })
	U.PlayPage = playPage
	U.PlayHeader = label("PlayHeader", "", "Heading", 17, playPage, { TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = false, ZIndex = 5, TextColor3 = SIGN.Text })
	-- the page's one green plank (a box's own Claim is stone)
	U.ClaimAll = CloudUI.Button({ Name = "ClaimAll", Text = string.format(TEXT.ClaimAll, 0), Style = "Green", Skin = "Sign", Size = UDim2.fromOffset(166, 44), TextSize = 15,
		ZIndex = 6, Parent = playPage, Callback = function()
			H.claimAll()
		end })
	U.TiersFrame = Util.Create("Frame", { Name = "Tiers", BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4, Parent = playPage })
	for i = 1, 7 do
		H.newTier(i, U.TiersFrame)
	end

	-- the week's sweep + confetti layer (inside the window only)
	U.Fx = Util.Create("Frame", { Name = "Fx", BackgroundTransparency = 1, ClipsDescendants = true, Size = UDim2.fromScale(1, 1), ZIndex = 8, Parent = U.Body })
	-- the cursor is free while the window is shown (client/MouseLock, as the Pets window and the Training Place)
	local mouseLock = Client:FindFirstChild("MouseLock")
	local okLock, lock = pcall(function()
		return mouseLock and require(mouseLock)
	end)
	if okLock and type(lock) == "table" and type(lock.WatchVisible) == "function" then
		safe("mouse lock", lock.WatchVisible, "Dock:" .. holder.Name, holder)
	end
	S.Pulse = false
end

-- the design numbers of the laid-out layout
function H.metrics()
	if S.Mode == "PC" then
		return K.PC
	elseif S.Mode == "Portrait" then
		return K.PORTRAIT
	end
	return K.PHONE
end

function H.inset()
	local inset = 58
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- (Pitch 2 09 B) the window's height follows the prize stand (screen px, in place): on PC the Daily page's window is
-- no taller than the Header + MaxBody design px, centred in its BigRect box (the box's 644 px body left ~160 px of
-- empty stone at 1080p); the Play page keeps the box's height (its two rows of gift boxes need it) under the same top,
-- so the tabs stay where they are (raised only as far as the screen's foot needs). On a portrait phone the window is up
-- to WinH tall from TopClear under the HUD's strips (TopClearTight where that leaves under WinMinRoom px), Foot px over
-- the screen's foot, where that is taller than the box. A landscape phone keeps its box
function H.fitRect(r, mode)
	if mode == "PC" then
		local full = r.h
		local maxH = (K.PC.Header + K.PC.MaxBody) * r.scale
		if full > maxH + 0.5 then
			local top = math.floor(r.y + (full - maxH) / 2 + 0.5)
			if S.Tab == "Play" then
				r.y = math.max(r.y, math.min(top, math.floor(viewport().Y - K.MARGIN - full)))
			else
				r.y, r.h = top, maxH
			end
		end
	elseif mode == "Portrait" then
		local P = K.PORTRAIT
		local inset = H.inset()
		local area = viewport().Y - inset
		local strips = H.stripsBottom()
		local top = strips + P.TopClear
		if area - P.Foot - top < P.WinMinRoom then
			top = strips + P.TopClearTight
		end
		local want = math.min(P.WinH, area - P.Foot - top)
		if want > r.h then
			r.y, r.h = inset + top, want
		end
	end
end

-- the box (NeonKit.BigRect, H.fitRect) -> the holder at its place and scale, then every part in the design box
function H.layout()
	if not U.Holder then
		return
	end
	local r = NeonKit.BigRect(K)
	local mode = r.mode
	if mode == "Phone" and r.portrait then
		mode = "Portrait"
	end
	H.fitRect(r, mode)
	S.Rect, S.Mode, S.Scale = r, mode, r.scale
	local W = math.floor(r.w / r.scale + 0.5)
	local Hh = math.floor(r.h / r.scale + 0.5)
	-- (NimbusDaily keeps the gui inset: its area starts under the top bar)
	place(U.Holder, r.x, r.y - H.inset(), W, Hh)
	U.Fit.Scale = r.scale
	S.WindowX = math.floor(r.x + 0.5)
	local M = H.metrics()
	H.layoutHeader(M, W, r.y - H.inset())
	local top = M.Header + (M.TabRow or 0)
	local B = Hh - top
	place(U.Body, 0, top, W, B)
	H.layoutDaily(M, W, B)
	H.layoutPlay(M, W, B)
end

-- (kit-b U9-4) the header as the Shop's: the navy band inside the wood frame (its edge shows round the top), the gift on
-- its gold square, "Gifts" (the ribbon), the two tab blocks, the red close at the right; where the band is too short for
-- all of them (a portrait phone) the title goes first, then the square. The tab buttons keep a TapH touch box over
-- their blocks (>= 44 px on a phone). Positions are in the band's own px
-- the bottom of the HUD's currency strips in gui-area px (over the gift's square, which hides while this window is open)
function H.stripsBottom()
	local hud = H.hud()
	if not hud then
		return 0
	end
	local gift = tonumber(hud:GetAttribute("GiftSize")) or 0
	if gift > 0 then
		return tonumber(hud:GetAttribute("GiftTop")) or 0
	end
	return tonumber(hud:GetAttribute("TopRightBottom")) or 0
end

-- winTop: the window's top in gui-area px (the awning's room)
function H.layoutHeader(M, W, winTop)
	local F = K.FRAME
	local bw, bh = W - 2 * F, M.Header - F
	place(U.Bar, F, F, bw, bh)
	-- (the awning reaches 10 px over the top on PC; no roof on a landscape phone: the Shop's rule, that window starts
	-- right under Roblox's top bar. U9-4 look review: the portrait window has clear sky over it, so it keeps the awning at
	-- the phones' ROOF_PHONE_W px whenever ROOF_CLEAR px lie between the HUD's strips and its top)
	local portrait = S.Mode == "Portrait"
	U.Roof.Size = UDim2.fromOffset(portrait and K.ROOF_PHONE_W or K.ROOF_W, U.Roof.Size.Y.Offset)
	U.Roof.Visible = S.Mode == "PC" or (portrait and (tonumber(winTop) or 0) - K.ROOF_CLEAR >= H.stripsBottom())
	local closeX = bw - M.Close - (10 - F)
	-- (U9-4 look review 2) a phone band: the CloseBlock px block centred in the band, its stroke 4 px inside the band's
	-- right end, over its Close px touch box (the 44 px block filled the band and its stroke hung onto the stone)
	local block = M.CloseBlock
	-- (merge kitb-look1 x U9-4) the 36 px block keeps U9-4's 3 px edge and 5 px lip (the kit's 5 / 8 would hang out of
	-- the 44 px band)
	U.Close:SetAttribute("EdgePx", block and 3 or nil)
	U.Close:SetAttribute("LipPx", block and 5 or nil)
	if block then
		closeX = bw - K.CLOSE_INSET - block
		local by = math.floor((bh - block) / 2)
		place(U.Close, closeX, by, block, block)
		place(U.CloseTap, closeX - math.floor((M.Close - block) / 2), by - math.floor((M.Close - block) / 2), M.Close, M.Close)
	else
		place(U.Close, closeX, math.floor((M.Header - M.Close) / 2) - F, M.Close, M.Close) -- (its drawn X scales with it)
	end
	U.CloseTap.Visible = block ~= nil
	NeonKit.CloseMarkPx(U.Close, H.px("Glyph")) -- (LOOK-ui) the x at the screen's glyph size: one pixel size
	-- (portrait: the tabs have their own row, so the band only holds the gift and the title)
	local tabsW = portrait and 0 or (M.TabW[1] + M.TabGap + M.TabW[2])
	local slot = M.Icon + 4
	local x = 10
	local room = closeX - 8
	local withIcon = x + slot + 10 + tabsW <= room
	local withTitle = withIcon and x + slot + 10 + M.TitleW + M.TitleGap + tabsW <= room
	U.GiftsIcon.Visible, U.Title.Visible = withIcon, withTitle
	if withIcon then
		-- (PC: centred on the band's face over its 4 px lip; look review 2, a phone: in line with the close block)
		place(U.GiftsIcon, x, math.floor((bh - (block and 0 or 4) - slot) / 2), slot, slot)
		U.GiftsIcon.TextSize = math.max(12, M.Icon - 10)
		x = x + slot + 10
	else
		x = M.HeadPad - F
	end
	if withTitle then
		place(U.Title, x, 0, M.TitleW, bh - 4)
		U.Title.TextSize = M.TitleText
		x = x + M.TitleW + M.TitleGap -- (the ribbon's stair keeps clear of the first tab)
	end
	-- (the touch box centred on the block's face, over its lip: the word sits where the face is)
	if portrait then
		-- the tab row under the band (still the bar's children, so they move with it): two halves of the inside, each a
		-- TabRowH block with its TapH touch box
		local tw = math.floor((W - 2 * M.TabRowSide - M.TabRowMid) / 2)
		local ty = bh + M.TabRowGap
		local tapY = math.floor(ty + (M.TabRowH - CloudUI.SignMetrics.Lip) / 2 - M.TapH / 2 + 0.5)
		x = M.TabRowSide - F
		for _, tab in ipairs({ U.TabDaily, U.TabPlay }) do
			place(tab, x, tapY, tw, M.TapH)
			place(U.Bar:FindFirstChild(tab.Name .. "Fill"), x, ty, tw, M.TabRowH)
			x = x + tw + M.TabRowMid
		end
	else
		local tapY = math.floor((M.TabY - F) + (M.TabH - CloudUI.SignMetrics.Lip) / 2 - M.TapH / 2 + 0.5)
		for i, tab in ipairs({ U.TabDaily, U.TabPlay }) do
			place(tab, x, tapY, M.TabW[i], M.TapH)
			place(U.Bar:FindFirstChild(tab.Name .. "Fill"), x, M.TabY - F, M.TabW[i], M.TabH)
			x = x + M.TabW[i] + M.TabGap
		end
	end
	U.TabDaily.TextSize, U.TabPlay.TextSize = M.TabText, M.TabText
end

-- the Daily page's geometry (S.G); the chips and the claim slot follow the payload, so render places them (keyed)
function H.layoutDaily(M, W, B)
	local G = { W = W, B = B }
	S.G = G
	S.ChipKey, S.BottomKey = nil, nil
	U.DailyHeader.TextSize = M.HeaderText
	U.StreakChip.TextSize, U.VipChip.TextSize = M.ChipText, M.ChipText
	U.WispText.TextSize, U.Banner.TextSize = M.WispText, M.BannerText
	U.Countdown.TextSize, U.Keep.TextSize = M.CountText, M.KeepText
	U.Line1.TextSize, U.Line2.TextSize = M.Line1, M.Line2
	-- (Pitch 2 09 B) every spot in the page's px first; the Cells frame is the day tiles' box (the prize card sits outside
	-- it, a child all the same, so a tile's lookup in "Cells" keeps finding Day 7)
	local spots = {}
	local gap = M.TileGap
	local tw, th, box, ruleTop, ruleW
	if S.Mode == "Portrait" then
		tw = math.min(M.TileW, math.floor((W - 2 * M.Side - 2 * gap) / 3))
		local gridW = 3 * tw + 2 * gap
		local x0 = math.floor((W - gridW) / 2)
		local fixed = M.HeroY + M.HeroGap + M.Raise + M.RowGap + M.AfterTiles + M.ClaimH + M.ClaimGap + M.KeepH + M.Bottom
		local room = B - fixed
		local heroH = math.max(M.HeroMinH, math.min(M.HeroMaxH, math.floor(room * M.HeroShare)))
		th = math.max(M.TileMinH, math.min(M.TileMaxH, math.floor((room - heroH) / 2)))
		heroH = math.max(M.HeroMinH, math.min(M.HeroMaxH, room - 2 * th))
		-- (what the card and the tiles both leave at their largest goes to the three gaps round the grid)
		local spare = math.floor(math.max(0, room - heroH - 2 * th) / 3)
		spots[7] = { x = x0, y = M.HeroY, w = gridW, h = heroH, hero = true }
		local top = M.HeroY + heroH + M.HeroGap + spare -- (today's raised top)
		for i = 1, 6 do
			local col, row = (i - 1) % 3, math.floor((i - 1) / 3)
			spots[i] = { x = x0 + col * (tw + gap), y = top + M.Raise + row * (th + M.RowGap), w = tw, h = th }
		end
		box = { x0, top, gridW, M.Raise + 2 * th + M.RowGap }
		G.ClaimX, G.ClaimW = x0, gridW
		G.ClaimY = top + M.Raise + 2 * th + M.RowGap + M.AfterTiles + spare
		G.ClaimH = M.ClaimH
		G.KeepX, G.KeepY, G.KeepW, G.KeepH = x0, G.ClaimY + M.ClaimH + M.ClaimGap, gridW, M.KeepH
		ruleTop, ruleW = M.HeroY, W - 2 * M.Side
	else
		local rowRoom = W - 2 * M.Side - M.HeroW - M.ColGap
		tw = math.min(M.TileW, math.floor((rowRoom - 5 * gap) / 6))
		local rowW = 6 * tw + 5 * gap
		local x0 = M.Side
		local fixed = M.TilesY + M.AfterTiles + M.ClaimH + M.Bottom
		th = math.max(M.TileMinH, math.min(M.TileMaxH, B - fixed))
		-- (what the tallest tile leaves goes over and under the row)
		local spare = math.max(0, B - fixed - th)
		local tilesY = M.TilesY + math.floor(spare / 2)
		for i = 1, 6 do
			spots[i] = { x = x0 + (i - 1) * (tw + gap), y = tilesY, w = tw, h = th }
		end
		box = { x0, tilesY - M.Raise, rowW, th + M.Raise }
		G.ClaimX, G.ClaimW = x0, nil
		G.ClaimY = tilesY + th + M.AfterTiles + (spare - math.floor(spare / 2))
		G.ClaimH = M.ClaimH
		G.RowRight = x0 + rowW
		G.ChipsRight = G.RowRight
		-- the prize card: ColGap right of the row to the page's side, from HeroY to the Claim's foot
		local heroX = G.RowRight + M.ColGap
		spots[7] = { x = heroX, y = M.HeroY, w = W - M.Side - heroX, h = G.ClaimY + M.ClaimH - M.HeroY, hero = true }
		ruleTop, ruleW = tilesY - M.Raise, rowW
	end
	place(U.CellsFrame, box[1], box[2], box[3], box[4])
	for i, cell in ipairs(U.Cells) do
		local s = spots[i]
		cell.Spot = { x = s.x - box[1], y = s.y - box[2], w = s.w, h = s.h, hero = s.hero }
		cell.PlaceKey = nil
	end
	G.TileW = tw
	-- (F0 review) the dotted rule halfway between the heading line (its chips) and what comes under it (today's raised
	-- tile; the prize card on a portrait phone), as wide as the day row
	local headFoot = math.max(M.HeaderY + M.HeaderH, M.ChipY + M.ChipH)
	SignKit.SetRule(U.HeadRule, ruleW)
	U.HeadRule.Position = UDim2.fromOffset(M.Side, math.floor((headFoot + ruleTop) / 2) - 1)
	U.HeadRule.Visible = ruleTop - headFoot >= 4
end

-- a tile at its spot (today: raised by M.Raise, the bottom kept), its insides fitted to its size; the prize card
-- (Pitch 2 09 B) is laid out by H.placeHero and never raised
function H.placeTile(cell, M, today, wide)
	local s = cell.Spot
	if not s then
		return
	end
	if s.hero then
		H.placeHero(cell, M)
		return
	end
	local y, h = s.y, s.h
	if today then
		y, h = s.y - M.Raise, s.h + M.Raise
	end
	local key = table.concat({ tostring(S.Mode), s.x, y, s.w, h }, ",")
	if cell.PlaceKey == key then
		return
	end
	cell.PlaceKey = key
	place(cell.Root, s.x, y, s.w, h)
	local w = s.w
	local dayH = M.DayText + 4
	place(cell.Day, 2, M.PadTop, w - 4, dayH)
	cell.Day.TextSize = M.DayText
	local amountH = M.AmountText + 6
	local amountY = h - M.PadBottom - amountH
	place(cell.Amount, 2, amountY, w - 4, amountH)
	cell.Amount.TextSize = M.AmountText
	local artY = M.PadTop + dayH + 1
	local artH = math.max(0, amountY - 1 - artY)
	place(cell.Art, 0, artY, w, artH)
	-- the reward's chip (ChipPx, or less where the tile is small) and the art on it at one of the screen's two pixel
	-- sizes
	cell.PetPx = math.max(12, math.min(M.PetPx, artH, w - 8))
	cell.ChipPx = math.max(12, math.min(M.ChipPx, artH, w - 8))
	-- (P2 icons review r1, major 2) the chip is a clear holder now (item 9 B: no block behind the art): the art takes its
	-- whole room at the 09 B size (it lost 12 px to the block's edge)
	cell.ArtPx = H.rewardPx(cell.ChipPx, M)
	-- (U9-4 look review) the tick at the screen's art size (6 px cells on PC, 4 on a phone); (P2 icons look fin0, minor:
	-- it kept the tile's centre when the art grew, 11 px low and 4 px right of it) centred on the reward's chip, as
	-- H.paintArt places it (centred with the art's drop shadow in the art box). (P2 icons look pol0, major: on the 360 x 640
	-- phone the tiles are 60 px tall, an 11 px art row, and the 36 px tick covered half of "Day 1" and "$400") the largest
	-- of the screen's two pixel sizes that fits the room from the day line's foot to the amount line's top (each line its
	-- TextSize tall, centred in its box: the art row + 2 + 1 over it, + 1 + 3 under it)
	local tick = H.fitPx(artH + 7)
	local check = hostSize(tick)
	cell.Check.TextSize = check
	local drop = math.ceil(cell.ArtPx / 9)
	local cx = math.max(0, math.floor((w - cell.ChipPx - drop) / 2)) + cell.ChipPx / 2
	local cy = artY + math.max(0, math.floor((artH - cell.ChipPx - drop) / 2)) + cell.ChipPx / 2
	local inset = math.floor((check + 8 - tick) / 2) -- where Host centres the icon in its label
	place(cell.Check, math.floor(cx - tick / 2) - inset, math.floor(cy - tick / 2) - inset, check + 8, check + 8)
	-- (kit-b U9-4) the glint round the art (a cream sparkle reads on today's gold)
	local a = wide and cell.PetPx or cell.ChipPx
	H.placeSparkles(cell.Sparkles, (w - a) / 2, artY + (artH - a) / 2, a, a, sparklePx(), SIGN.Tile)
end

-- (Pitch 2 09 B) the prize card's insides. Landscape, top to bottom: its label, the Week Wisp standing on its plinth (the
-- pet as big as the card's width and the room left allow, up to PetMax), the name plank, the species line, the week's
-- line ("in 4 more days") and its 7-block bar, the week banner over the species and the line while it is up. Portrait: the pet on its plinth
-- at the card's left, as tall as the card; the same rows in a column right of it, centred on the card's height
function H.placeHero(cell, M)
	local s = cell.Spot
	local key = table.concat({ "hero", tostring(S.Mode), s.x, s.y, s.w, s.h }, ",")
	if cell.PlaceKey == key then
		return
	end
	cell.PlaceKey = key
	place(cell.Root, s.x, s.y, s.w, s.h)
	local w, h = s.w, s.h
	local pad, g = M.HeroPad, M.CardGap
	local dayH, plankH = M.HeroDayText + 4, M.PlankH
	local speciesH, wispH = M.SpeciesText + 4, M.WispText + 4
	cell.Day.TextSize, cell.Amount.TextSize = M.HeroDayText, M.PlankText
	cell.Species.TextSize, U.WispText.TextSize = M.SpeciesText, M.WispText
	local side, artX, artY, colX, colW, rowsY
	if S.Mode == "Portrait" then
		side = math.max(12, h - 2 * pad - M.PlinthH)
		artX, artY = pad, pad
		place(cell.Plinth, artX, artY + side, side, M.PlinthH)
		colX = artX + side + M.PetGap
		colW = math.max(20, w - colX - pad)
		-- (a short card, 360 x 640: the species line goes first, then the card's label, so the rows stay inside it)
		local inner = h - 2 * pad
		local rows = plankH + wispH + M.BarH + 2 * g
		cell.SpeciesRoom = rows + speciesH + g <= inner
		rows = rows + (cell.SpeciesRoom and speciesH + g or 0)
		local withDay = rows + dayH + g <= inner
		rows = rows + (withDay and dayH + g or 0)
		cell.Day.Visible = withDay
		cell.Species.Visible = cell.SpeciesRoom and cell.Species.Text ~= ""
		rowsY = math.floor((h - rows) / 2)
		cell.Day.TextXAlignment = Enum.TextXAlignment.Left
		cell.Species.TextXAlignment = Enum.TextXAlignment.Left
		U.WispText.TextXAlignment = Enum.TextXAlignment.Left
		local y = rowsY
		if withDay then
			place(cell.Day, colX, y, colW, dayH)
			y = y + dayH + g
		end
		local nameW = math.min(colW, math.ceil(H.width(cell.Amount.Text ~= "" and cell.Amount.Text or "Week Wisp", M.PlankText, Theme.FontOf(cell.Amount))) + 2 * M.PlankSide)
		place(cell.Amount, colX, y, nameW, plankH)
		y = y + plankH + g
		if cell.SpeciesRoom then
			place(cell.Species, colX, y, colW, speciesH)
			y = y + speciesH + g
		end
		place(U.WispText, colX, y, colW, wispH)
		place(U.WispBar, colX, y + wispH + g, colW, M.BarH)
		local over = cell.SpeciesRoom and speciesH + g or 0
		-- (playtest 2026-11-28 C28) the banner also takes the bar's row (the bar hides while it shows): on a short card
		-- (over 0) one 15 px line held the two-line "WEEK DONE!" text, which ran under the plank and onto the blocks
		place(U.Banner, colX, y - over, colW, over + wispH + g + M.BarH)
	else
		cell.SpeciesRoom = true
		cell.Day.Visible = true
		cell.Day.TextXAlignment = Enum.TextXAlignment.Center
		cell.Species.TextXAlignment = Enum.TextXAlignment.Center
		U.WispText.TextXAlignment = Enum.TextXAlignment.Center
		place(cell.Day, 2, pad, w - 4, dayH)
		-- from the foot up: the bar, the line, the species, the plank, the plinth; the pet fills what is left
		local barY = h - pad - M.BarH
		local wispY = barY - g - wispH
		local speciesY = wispY - g - speciesH
		local plankY = speciesY - g - plankH
		local plinthY = plankY - g - M.PlinthH
		local top = pad + dayH + g
		side = math.max(12, math.min(M.PetMax, w - 2 * pad, plinthY - top))
		artX, artY = math.floor((w - side) / 2), plinthY - side
		local plinthW = math.min(w - 2 * pad, side + 2 * M.PlinthOut)
		place(cell.Plinth, (w - plinthW) / 2, plinthY, plinthW, M.PlinthH)
		place(cell.Amount, M.PlankSide, plankY, w - 2 * M.PlankSide, plankH)
		place(cell.Species, 2, speciesY, w - 4, speciesH)
		place(U.WispText, M.BarSide, wispY, w - 2 * M.BarSide, wispH)
		place(U.WispBar, M.BarSide, barY, w - 2 * M.BarSide, M.BarH)
		place(U.Banner, M.BarSide, speciesY, w - 2 * M.BarSide, speciesH + g + wispH)
		colW = w - 2 * M.BarSide
	end
	place(cell.Art, artX, artY, side, side)
	local sg = M.SegGap
	local segW = (U.WispBar.Size.X.Offset - 6 * sg) / 7
	for i, seg in ipairs(U.Segs) do
		place(seg, (i - 1) * (segW + sg), 0, segW, M.BarH)
	end
	local tick = H.px("Art")
	local check = hostSize(tick)
	cell.Check.TextSize = check
	place(cell.Check, artX + (side - check - 8) / 2, artY + (side - check - 8) / 2, check + 8, check + 8)
	cell.PetPx = side
	cell.ChipPx = math.max(12, math.min(M.ChipPx, side))
	cell.ArtPx = H.rewardPx(cell.ChipPx, M)
	H.placeSparkles(cell.Sparkles, artX, artY, side, side, sparklePx(), SIGN.Tile)
end

-- the streak / VIP chips and the header's width (they follow the payload)
function H.placeChips(M, showStreak, showVip)
	local G = S.G
	local key = table.concat({ tostring(S.Mode), G.W, tostring(showStreak), tostring(showVip), U.StreakChip.Text }, ",")
	if S.ChipKey == key then
		return
	end
	S.ChipKey = key
	local streakW = math.max(M.StreakW, math.ceil(H.width(U.StreakChip.Text, M.ChipText, Theme.FontOf(U.StreakChip))) + 2 * M.ChipPad)
	local vipW = math.max(M.VipW, math.ceil(H.width(U.VipChip.Text, M.ChipText, Theme.FontOf(U.VipChip))) + 2 * M.ChipPad)
	if S.Mode == "Portrait" then
		place(U.DailyHeader, M.Side, M.HeaderY, G.W - 2 * M.Side, M.HeaderH)
		local x = M.Side
		if showStreak then
			place(U.StreakChip, x, M.ChipY, streakW, M.ChipH)
			x = x + streakW + M.ChipGap
		end
		place(U.VipChip, x, M.ChipY, vipW, M.ChipH)
		return
	end
	local right = G.ChipsRight or (G.W - M.Side) -- (Pitch 2 09 B: they end where the day row ends, left of the prize card)
	if showVip then
		right = right - vipW
		place(U.VipChip, right, M.ChipY, vipW, M.ChipH)
		right = right - M.ChipGap
	end
	if showStreak then
		right = right - streakW
		place(U.StreakChip, right, M.ChipY, streakW, M.ChipH)
		right = right - M.ChipGap
	end
	place(U.DailyHeader, M.Side, M.HeaderY, math.max(40, right - M.Side), M.HeaderH)
end

-- the claim slot (`slotW` wide: the repair and the waiting texts take the wider one; the grid's width on a portrait
-- phone) and the keep line: (Pitch 2 09 B) beside the slot on PC and a landscape phone, under it on a portrait phone.
-- The week's line, its bar and the banner sit in the prize card (H.placeHero)
function H.placeBottom(M, slotW)
	local G = S.G
	local key = table.concat({ tostring(S.Mode), G.W, G.B, slotW }, ",")
	if S.BottomKey == key then
		return
	end
	S.BottomKey = key
	slotW = G.ClaimW or slotW
	place(U.Claim, G.ClaimX, G.ClaimY, slotW, G.ClaimH)
	place(U.Countdown, G.ClaimX, G.ClaimY, slotW, G.ClaimH)
	if S.Mode == "Portrait" then
		place(U.Keep, G.KeepX, G.KeepY, G.KeepW, G.KeepH)
		U.Keep.TextXAlignment = Enum.TextXAlignment.Center
		U.Keep.TextYAlignment = Enum.TextYAlignment.Top
	else
		local x = G.ClaimX + slotW + M.ColGap
		local room = math.max(40, G.RowRight - x)
		-- (two even lines where one does not fit: "Claim today's gift to / keep your streak!", no lone last word)
		local font = Theme.FontOf(U.Keep)
		local long = math.max(H.width(TEXT.KeepClaim, M.KeepText, font), H.width(TEXT.Keep, M.KeepText, font), H.width(TEXT.KeepLocked, M.KeepText, font))
		local w = long + K.FIT_SLACK <= room and room or math.min(room, math.ceil(long * 0.56))
		place(U.Keep, x, G.ClaimY, w, G.ClaimH)
		U.Keep.TextXAlignment = Enum.TextXAlignment.Left
		U.Keep.TextYAlignment = Enum.TextYAlignment.Center
	end
	-- the locked lines inside the claim button (its UIPadding keeps them off the edges)
	local block = (M.Line1 + 4) + (M.Line2 + 4)
	local top = math.floor((G.ClaimH - block) / 2)
	U.Line1.Position = UDim2.fromOffset(0, top)
	U.Line1.Size = UDim2.new(1, 0, 0, M.Line1 + 4)
	U.Line2.Position = UDim2.fromOffset(0, top + M.Line1 + 4)
	U.Line2.Size = UDim2.new(1, 0, 0, M.Line2 + 4)
end

-- the Play page (card B): the header line and CLAIM ALL on top, then the gift boxes in centred rows of BoxCols (PC: the
-- rows slide from PlayCompact to PlayFull with the body, as the Daily page's parts do)
function H.layoutPlay(M, W, B)
	local portrait = S.Mode == "Portrait"
	local P ={ BoxRowsY = M.BoxRowsY, BoxRowGap = M.BoxRowGap, BoxBottom = M.BoxBottom }
	if S.Mode == "PC" then
		local k = math.max(0, math.min(1, (B - M.CompactBody) / (M.FullBody - M.CompactBody)))
		for name, full in pairs(M.PlayFull) do
			P[name] = math.floor(M.PlayCompact[name] + (full - M.PlayCompact[name]) * k + 0.5)
		end
	end
	local cols = M.BoxCols
	local rows = math.ceil(7 / cols)
	local bw = math.min(M.BoxW, math.floor((W - 2 * M.BoxSide - (cols - 1) * M.BoxGap) / cols))
	if portrait then
		place(U.PlayHeader, M.PlaySide, M.PlayY, W - 2 * M.PlaySide, M.PlayH)
		place(U.ClaimAll, (W - M.AllW) / 2, M.AllY, M.AllW, M.AllH)
	else
		-- (U9-4 look review 2) Claim all ends where the first row of boxes ends (it stood 3 px past them on a phone)
		local rowW = cols * bw + (cols - 1) * M.BoxGap
		local right = math.floor((W - rowW) / 2) + rowW
		place(U.ClaimAll, right - M.AllW, M.AllY, M.AllW, M.AllH)
		place(U.PlayHeader, M.PlaySide, M.PlayY, math.max(40, right - M.AllW - M.AllGap - M.PlaySide), M.PlayH)
	end
	U.PlayHeader.TextWrapped = portrait
	U.ClaimAll.TextSize = M.AllText
	local bh = math.min(M.BoxMaxH, math.floor((B - P.BoxRowsY - (rows - 1) * P.BoxRowGap - P.BoxBottom) / rows))
	local gridH = rows * bh + (rows - 1) * P.BoxRowGap
	local y0 = P.BoxRowsY + math.floor(math.max(0, B - P.BoxRowsY - P.BoxBottom - gridH) / 2)
	place(U.TiersFrame, 0, y0, W, gridH)
	for i, cell in ipairs(U.Tiers) do
		local row = math.floor((i - 1) / cols)
		local inRow = math.min(cols, 7 - row * cols)
		local rowW = inRow * bw + (inRow - 1) * M.BoxGap
		local x = math.floor((W - rowW) / 2) + ((i - 1) % cols) * (bw + M.BoxGap)
		place(cell.Root, x, row * (bh + P.BoxRowGap), bw, bh)
		H.layoutTier(cell, bw, bh, M)
	end
end

-- a gift box's insides, top to bottom with even gaps (the mock's space-between column): the minutes, the gift (as big
-- as the room allows, up to GiftPx), the reward (two lines in a narrow box), the slot (CLAIM / the clock / the tick)
function H.layoutTier(cell, bw, bh, M)
	local inner = bw - 8
	local lines = inner < K.WRAP_BELOW and 2 or 1
	local timeH = M.TimeText + 4
	local rewardH = lines * M.RewardText + 6
	local free = bh - M.BoxPadTop - M.BoxPadBottom - timeH - rewardH - M.SlotH
	-- (the gift gives way first: the three gaps keep BoxMinGap, so the reward never touches the CLAIM button's glow)
	local px = math.max(0, math.min(M.GiftPx, free - 3 * M.BoxMinGap, bw - 12))
	local gap = math.max(0, (free - px) / 3)
	local y = M.BoxPadTop
	place(cell.Time, 4, y, inner, timeH)
	cell.Time.TextSize = M.TimeText
	y = y + timeH + gap
	place(cell.Gift, (bw - px) / 2, y, px, px)
	cell.GiftX, cell.GiftY, cell.GiftPx = cell.Gift.Position.X.Offset, cell.Gift.Position.Y.Offset, px
	-- (kit-b U9-4) the glint round the gift block (a deep gold sparkle reads on the stone box)
	H.placeSparkles(cell.Sparkles, cell.GiftX, cell.GiftY, px, px, sparklePx(), SIGN.GoldDeep)
	y = y + px + gap
	place(cell.Reward, 4, y, inner, rewardH)
	cell.Reward.TextSize = M.RewardText
	cell.Reward.TextWrapped = lines > 1
	cell.Lines = lines
	-- (U9-4 look review 2) the reward's slot (H.placeReward puts a currency on its role's tag in it)
	cell.RewardY, cell.RewardH, cell.RewardKey = math.floor(y + 0.5), rewardH, nil
	local slotY = bh - M.BoxPadBottom - M.SlotH
	cell.SlotY, cell.SlotH, cell.Inner = slotY, M.SlotH, inner
	local btnW = math.min(M.TierBtnW, inner - 8) -- (U9-4 look review: the plank never fills the box edge to edge)
	place(cell.Claim, (bw - btnW) / 2, slotY, btnW, M.SlotH)
	cell.Claim.TextSize = M.TierBtnText
	local pad = cell.Claim:FindFirstChildOfClass("UIPadding")
	if pad then
		-- (a narrow box's Claim keeps its word: 10 px sides would cut it)
		local side = btnW < 80 and 4 or 10
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, side), UDim.new(0, side)
	end
	cell.Clock.TextSize, cell.Glyph.TextSize = M.ClockText, M.ClockText
	-- (U9-4 look review) the tick at the screen's art size, as a day tile's
	local tick = hostSize(H.px("Art"))
	cell.Check.TextSize = tick
	place(cell.Check, (bw - tick - 8) / 2, slotY + (M.SlotH - tick - 8) / 2, tick + 8, tick + 8)
	cell.GiftKey, cell.ClockKey = nil, nil
	cell.BoxW = bw
	-- (U9-4 look review) the next gift's bar: Count blocks across the slot's middle, rebuilt when its size changes
	local TB = K.TIER_BAR[S.Mode == "PC" and "PC" or "Phone"]
	local n = K.TIER_BAR.Count
	local blockW = math.max(6, math.min(TB.MaxW, math.floor((inner - 8 - (n - 1) * TB.Gap) / n)))
	local barKey = blockW .. "x" .. TB.H .. ":" .. TB.Gap
	if not cell.Bar or cell.BarKey ~= barKey then
		if cell.Bar then
			cell.Bar:Destroy()
		end
		cell.Bar = SignKit.BlockRow(cell.Card.Body, { Count = n, BlockW = blockW, BlockH = TB.H, Gap = TB.Gap, Name = "PlayBar", ZIndex = 5, Visible = false })
		for _, d in ipairs(cell.Bar:GetDescendants()) do
			if d:IsA("GuiObject") then
				d.ZIndex = 5
			end
		end
		cell.BarKey = barKey
	end
	cell.BarH = TB.H
end

-- the menu tiles (NimbusMenu draws above this window) step aside while the open window reaches over them, on a
-- phone (or a touch-only device) Roblox's stick and jump go while it is open, and the HUD's vitals card hides
function H.coverColumn()
	local menu = controller("MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		safe("cover", menu.SetColumnCovered, (S.Open and U.Holder and S.WindowX) or nil, "Daily")
	end
	local want = S.Open and (S.Mode ~= "PC" or H.touchOnly())
	if want ~= S.TouchOff then
		S.TouchOff = want
		if menu and type(menu.SetTouchHidden) == "function" then
			safe("touch", menu.SetTouchHidden, "Daily", want)
		end
	end
	-- (review fix) the HUD's vitals card steps aside while the window is open: its bottom edge would cut the card (at
	-- 1080p the window covered its top half, at 1280x720 the card's glow showed under the edge)
	local vitalsOff = S.Open == true
	if vitalsOff ~= S.VitalsOff then
		S.VitalsOff = vitalsOff
		local hud = controller("HudController")
		if hud and type(hud.SetVitalsHidden) == "function" then
			safe("vitals", hud.SetVitalsHidden, "Daily", vitalsOff)
		end
	end
end

function H.setTab(tab)
	S.Tab = tab == "Play" and "Play" or "Daily"
	-- (Pitch 2 09 B) on PC the two pages' windows differ in height (H.fitRect): the window is laid out again
	if S.Open and U.Holder and S.Mode == "PC" then
		H.layout()
	end
	H.render()
end

-- (kit-b U9-4) the selected tab the gold block, the other the stone block; brown words on both
function H.paintTab(button, selected)
	button.TextColor3 = SIGN.Text
	button:SetAttribute("Selected", selected)
	local fill = U.Bar:FindFirstChild(button.Name .. "Fill")
	if fill then
		CloudUI.SignBlock(fill, selected and "Selected" or "Stone", { Pad = false })
	end
end

function H.paintArt(cell, entry)
	local px, chipPx = cell.ArtPx or 18, cell.ChipPx or 30
	local artW, artH = cell.Art.Size.X.Offset, cell.Art.Size.Y.Offset
	-- (P2 icons review r1, major 2) the key carries the icon sheet's id: a sheet set after the first draw (render_gui
	-- --sheets, the tests) draws the sheet's art
	local key = tostring(entry.Kind) .. ":" .. tostring(entry.PetId) .. ":" .. px .. ":" .. chipPx .. ":" .. tostring(cell.PetPx) .. ":" .. artW .. "x" .. artH
		.. ":" .. tostring(PixelIcon.SheetId and PixelIcon.SheetId() or 0)
	if cell.ArtKey == key then
		return
	end
	cell.ArtKey = key
	for _, child in ipairs(cell.Art:GetChildren()) do
		child:Destroy()
	end
	if entry.Kind == "Pet" and type(entry.PetId) == "string" then
		local ok = pcall(function()
			local vp = CloudUI.PetViewport(cell.Art, entry.PetId, cell.PetPx or px, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Spin = "sway" })
			vp.Name = "PetViewport"
			vp.ZIndex = 5
		end)
		if ok then
			return
		end
	end
	-- (U9-4 look review) the reward's art centred in the art box at the screen's art size; (look review 2) at a whole-px
	-- offset. (Pitch 2 item 9 B + 09_daily_layout B: "no slot or tile behind the art") the art stands on the tile in its own
	-- colours (the cash bills, the gold coin, the gem; the 18 x 18 art once the icon sheet is uploaded): "Chip" is a clear
	-- holder that keeps the reward's Role (it was a grass / gold / navy kit block behind a one-ink icon)
	local kind = tostring(entry.Kind or "")
	-- (P2 icons review r1, major 2) centred with the art's 1-cell drop shadow (px / 9 on the right and below: the 9 x 9
	-- glyph's cell, the larger of the two) inside the art box: at 54 px on a phone the shadow ran 1 px past it
	local drop = math.ceil(px / 9)
	local chip = Util.Create("Frame", {
		Name = "Chip", BorderSizePixel = 0, BackgroundTransparency = 1,
		Position = UDim2.fromOffset(math.max(0, math.floor((artW - chipPx - drop) / 2)), math.max(0, math.floor((artH - chipPx - drop) / 2))),
		Size = UDim2.fromOffset(chipPx, chipPx), ZIndex = 5, Parent = cell.Art,
	})
	chip:SetAttribute("Role", K.ART_CHIP[kind] and kind or "Other")
	local x, y = math.floor((chipPx - px) / 2), math.floor((chipPx - px) / 2)
	local id = (kind == "Pet" and "Gifts") or (kind == "" and "Gifts") or (kind == "Gems" and "gem") or kind
	local name = NeonKit.IconName(id) or NeonKit.IconName("Gifts") or "gift"
	-- a reward whose icon has no colours of its own (a one-ink glyph) draws in the brown ink of the tile's text
	local icon = PixelIcon.New(chip, name, px, PixelIcon.Art[name] and PixelIcon.Own or SIGN.Text)
	if icon then
		icon.Name = "Icon"
		icon.Position = UDim2.fromOffset(x, y)
		icon.ZIndex = 6
		for _, f in ipairs(icon:GetChildren()) do
			f.ZIndex = 6
		end
	end
end

-- a cell's colour (its lip) and its CELL_LOOK state (the face and the edge), painted only when they change
function H.paintLook(cell, color, look)
	local key = tostring(color) .. "|" .. look
	if cell.LookKey == key then
		return
	end
	cell.LookKey = key
	local L = CELL_LOOK[look] or CELL_LOOK.Open
	cell.Card.SetColor(color)
	cell.Card.SetFill(L.Face)
	cell.Card.Stroke.Color = L.Edge
	cell.Card.Stroke.Transparency = 0
end

-- (U9-4 look review) the pulse of today's tile / a ready box: its edge swaps between the ink and the gold lip, one frame
-- a tick (no tween, never faded)
function H.pulseEdge(cell, lit)
	cell.Card.Stroke.Color = lit and K.PULSE_EDGE or SIGN.Text
	cell.Card.Stroke.Transparency = 0
end

-- (kit-b U9-4) a box's gift: the Gifts button's pink block (its lip, its wood edge) holding the brown pixel gift;
-- redrawn only when its size changes (the tier's own colour is the box's lip). (U9-4 look review 2) the block is the Daily
-- page's reward chip (ChipPx: 72 / 48, a 2 px wood edge, the 4 px lip) and the gift is the art size on it (54 / 36), at
-- whole px: the gift is the hero of the box (a 27 px glyph in an 86 px block read as an empty pink square)
function H.paintGift(cell)
	local px = cell.GiftPx or 0
	local M = H.metrics()
	local key = px .. ":" .. tostring(M.ChipPx)
	if cell.GiftKey == key then
		return
	end
	cell.GiftKey = key
	for _, child in ipairs(cell.Gift:GetChildren()) do
		child:Destroy()
	end
	if px < 12 then
		return
	end
	local side = math.max(12, math.min(M.ChipPx, px - 2 * K.ART_EDGE)) -- room for the 2 px wood edge round it
	local at = math.floor((px - side) / 2)
	local block = Util.Create("Frame", {
		Name = "Block", BackgroundColor3 = SIGN.Roof, BorderSizePixel = 0, Position = UDim2.fromOffset(at, at),
		Size = UDim2.fromOffset(side, side), ZIndex = 5, Parent = cell.Gift,
	})
	CloudUI.SignBlock(block, "Gift", { EdgePx = K.ART_EDGE, LipPx = K.ART_LIP })
	-- (the art size wherever 2 px of face stay over and under it and 4 px each side, else the glyph size)
	local art = (side - K.ART_LIP - H.px("Art") >= 4 and side - H.px("Art") >= 8) and H.px("Art") or H.px("Glyph")
	local icon = PixelIcon.New(block, NeonKit.IconName("Gifts") or "gift", art, SIGN.Text)
	if icon then
		icon.Position = UDim2.fromOffset(math.floor((side - art) / 2), math.floor((side - K.ART_LIP - art) / 2))
		icon.ZIndex = 6
		for _, f in ipairs(icon:GetChildren()) do
			f.ZIndex = 6
		end
	end
end

-- (U9-4 look review 2) a play gift's reward in its slot: a currency on its role's tag (K.REWARD_TAG, sized to its words,
-- centred, the coin / gem at the glyph size before the amount at whole px), any other reward the plain line (two rows in
-- a narrow box); placed again only when the words, the box or the screen change
function H.placeReward(cell, t)
	local M = H.metrics()
	local kind = tostring(t.Kind or "")
	local look = K.REWARD_TAG[kind]
	local texts = tierRewards(t)
	local lbl = cell.Reward
	local key = table.concat({ tostring(S.Mode), kind, texts[1], tostring(cell.BoxW), tostring(cell.RewardY), tostring(cell.RewardH) }, "|")
	if cell.RewardKey == key then
		return
	end
	cell.RewardKey = key
	local old = lbl:FindFirstChild("KindIcon")
	if old then
		old:Destroy()
	end
	if not look then
		for _, name in ipairs({ "SignEdge", "Lip", "LipPad" }) do
			local c = lbl:FindFirstChild(name)
			if c then
				c:Destroy()
			end
		end
		lbl.BackgroundTransparency = 1
		lbl.TextColor3 = SIGN.Text
		lbl:SetAttribute("Role", nil)
		place(lbl, 4, cell.RewardY, cell.Inner, cell.RewardH)
		lbl.TextWrapped = cell.Lines > 1
		lbl.Text = H.fitLines(lbl, texts, cell.Lines)
		return
	end
	local glyph = look.Icon and H.px("Glyph") or 0
	local lead = glyph > 0 and glyph + K.TAG_GAP or 0
	local maxW = (cell.BoxW or 0) - 2 * M.BoxMinGap
	lbl.TextSize = M.RewardText
	local text, textW = texts[#texts], 0
	for i, candidate in ipairs(texts) do
		-- (measured as the label draws it, with the Trove tags' 15 % spare: a measure that runs short on the face's wide
		-- digits never cuts the amount)
		local ok, size = pcall(function()
			return Theme.MeasureLabel(lbl, candidate, M.RewardText, 4096)
		end)
		local measured = (ok and typeof(size) == "Vector2") and size.X or H.width(candidate, M.RewardText, Theme.FontOf(lbl))
		textW = math.ceil(measured * 1.15) + K.FIT_SLACK
		if 2 * M.TagPad + lead + textW <= maxW or i == #texts then
			text = candidate
			break
		end
	end
	local w = math.min(maxW, 2 * M.TagPad + lead + textW)
	CloudUI.SignBlock(lbl, { Face = look.Face, Lip = look.Lip, Edge = SIGN.Wood, Text = look.Text }, { EdgePx = K.TAG_EDGE, LipPx = K.TAG_LIP })
	lbl:SetAttribute("Role", kind)
	local pad = lbl:FindFirstChild("LipPad")
	if pad then
		pad.PaddingLeft, pad.PaddingRight = UDim.new(0, M.TagPad + lead), UDim.new(0, M.TagPad)
	end
	place(lbl, ((cell.BoxW or 0) - w) / 2, cell.RewardY + math.floor((cell.RewardH - M.TagH) / 2), w, M.TagH)
	lbl.TextWrapped = false
	lbl.Text = text
	if look.Icon then
		-- (the label's padding insets its children too: the icon sits in the lead room left of the text area)
		local icon = PixelIcon.New(lbl, look.Icon, glyph, look.Ink)
		if icon then
			icon.Name = "KindIcon"
			icon.Position = UDim2.fromOffset(-lead, math.floor((M.TagH - K.TAG_LIP - glyph) / 2))
			icon.ZIndex = lbl.ZIndex
			for _, f in ipairs(icon:GetChildren()) do
				f.ZIndex = lbl.ZIndex
			end
		end
	end
end

-- (U9-4 look review 2) the next gift's block bar in the Wisp bar's language (SEG_LOOK, the pitch's .seg): a filled block
-- is the gold face on its gold lip, an empty one the sunk well with no lip; while the clock holds the filled blocks keep
-- their lip under the deep gold face (the stone blocks with a lip used to look more raised than the lipless full ones)
function H.paintTierBar(bar, k, paused)
	k = SignKit.FillBlocks(bar, k)
	for i = 1, bar:GetAttribute("Count") or 0 do
		local face = bar:FindFirstChild("Block" .. i)
		face = face and face:FindFirstChild("Face")
		local lip = face and face:FindFirstChild("Lip")
		if face then
			local on = i <= k
			face.BackgroundColor3 = on and (paused and SIGN.GoldDeep or SIGN.Gold) or SIGN.Well
			if lip then
				lip.BackgroundColor3 = SIGN.GoldLip
				lip.Visible = on
			end
		end
	end
	bar:SetAttribute("Paused", paused)
	return k
end

-- the clock slot: the countdown centred with the clock glyph before it, or alone when both would not fit the box
function H.placeClock(cell, text)
	local barOn = cell.Bar ~= nil and cell.Bar.Visible
	local key = text .. "|" .. tostring(cell.SlotY) .. "|" .. tostring(cell.Inner) .. "|" .. cell.Clock.TextSize .. "|" .. tostring(barOn)
	if cell.ClockKey == key then
		return
	end
	cell.ClockKey = key
	local inner, slotY, slotH = cell.Inner or 0, cell.SlotY or 0, cell.SlotH or 44
	if barOn then
		-- (U9-4 look review) the next gift: its block bar on top of the slot, the countdown under it
		local bar = cell.Bar
		local barW = bar.Size.X.Offset
		place(bar, ((cell.BoxW or inner + 8) - barW) / 2, slotY, barW, cell.BarH or 12)
		local gap = 2
		slotY = slotY + (cell.BarH or 12) + gap
		slotH = slotH - (cell.BarH or 12) - gap
	end
	local size = cell.Clock.TextSize
	local textW = H.width(text, size, Theme.FontOf(cell.Clock))
	local room = size + 8 -- the glyph's box (size + 4) and a 4 px gap
	local withGlyph = text ~= "" and textW + room <= inner - K.FIT_SLACK
	cell.Glyph.Visible = withGlyph
	if withGlyph then
		-- the label is shifted right by the glyph's room, so the glyph + the centred text sit centred together
		place(cell.Clock, 4 + room, slotY, inner - room, slotH)
		place(cell.Glyph, 4 + (inner - textW) / 2 - room / 2, slotY + (slotH - size - 4) / 2, size + 4, size + 4)
	else
		place(cell.Clock, 4, slotY, inner, slotH)
	end
end

-- (Pitch 2 09 B: the line sits in the prize card, under the "Week Wisp" plank) "in 4 more days" / "in 1 more day" /
-- "Yours today!"
function H.wispText(cell)
	local left = 7 - cell
	if left <= 0 then
		return "Yours today!"
	elseif left == 1 then
		return "in 1 more day"
	end
	return "in " .. left .. " more days"
end

-- (Pitch 2 09 B) the prize card's species line: "Epic Owl · Storm" (the catalog's rarity, the look's species, the
-- element; "" for a pet the catalog does not know)
function H.speciesLine(petId)
	local ok, catalog = pcall(function()
		return require(Shared:WaitForChild("PetCatalog", 5))
	end)
	local def = ok and type(catalog) == "table" and catalog.Get and catalog.Get(petId) or nil
	if type(def) ~= "table" then
		return ""
	end
	local look = type(def.Look) == "table" and def.Look.Species or nil
	local head = table.concat({ tostring(def.Rarity or ""), look and tostring(look) or "" }, " "):gsub("^%s+", ""):gsub("%s+$", "")
	if def.Element then
		return head ~= "" and (head .. " " .. DOT .. " " .. tostring(def.Element)) or tostring(def.Element)
	end
	return head
end

function H.renderDaily(st, M)
	local view = DailyController.ClaimView(st, now(), H.touchOnly())
	S.View = view
	local loading = view.Mode == "Loading"
	-- a stale payload (StaleAt passed) promises nothing: no gold today tile, no claim, until the fresh one arrives
	local waiting = loading or view.Mode == "Stale"
	local due = view.Mode == "Claim" or view.Mode == "Repair" or view.Mode == "Locked"
	local cellNo = tonumber(type(st) == "table" and st.Cell) or 1
	if loading then
		U.DailyHeader.Text = "Daily gifts"
	else
		U.DailyHeader.Text = "Day " .. tostring(cellNo) .. " of 7 " .. DOT .. " Week " .. tostring((tonumber(st.Weeks) or 0) + 1)
	end
	local streak = (not loading) and math.floor(tonumber(st.Streak) or 0) or 0
	if S.Mode == "PC" then
		U.StreakChip.Text = "Streak: " .. streak .. (streak == 1 and " day" or " days")
	else
		U.StreakChip.Text = "Streak: " .. streak
	end
	local showVip = not loading and st.Vip == true
	U.StreakChip.Visible = streak > 0
	U.VipChip.Visible = showVip
	H.placeChips(M, streak > 0, showVip)
	-- (fix6 look0 #6: at 1024 x 768 'DAY 3 OF 7 · WEEK 2' ran 88 px past its box, under the Streak chip) the header whole
	-- beside the chips: the week dropped where the line does not fit at its size ("Day 3 of 7"), then a smaller size
	if not loading then
		U.DailyHeader.TextSize = M.HeaderText
		U.DailyHeader.Text = H.fitText(U.DailyHeader, { U.DailyHeader.Text, "Day " .. tostring(cellNo) .. " of 7" })
		H.shrinkFit(U.DailyHeader, M.HeaderText)
	end
	-- the tiles
	local list = days(st)
	for i, cell in ipairs(U.Cells) do
		local e = entryAt(list, i)
		local claimed = e.Claimed == true
		local today = e.Today == true and not claimed and not waiting
		H.placeTile(cell, M, today, i == 7)
		if not cell.Species then
			-- (fix6 look0 #6) the tile's sizes again before its texts are fitted (H.shrinkFit below)
			cell.Day.TextSize, cell.Amount.TextSize = M.DayText, M.AmountText
		end
		cell.Root:SetAttribute("Claimed", claimed)
		cell.Root:SetAttribute("Today", today)
		cell.Root:SetAttribute("Pulsing", today)
		-- (fix6 look0 #6: a 640 x 360 tile, 51 px inside, ran 'TODAY' 4 px past it at the 15 px floor) "Today" where the
		-- capitals do not fit at the tile's size; H.shrinkFit below then takes the size down where it still runs over
		local todayWord = "TODAY"
		if not cell.Species and H.drawnW(cell.Day, "TODAY", math.min(M.DayText, H.floorPx())) > cell.Day.Size.X.Offset - K.FIT_SLACK then
			todayWord = "Today"
		end
		cell.Day.Text = (today and due) and todayWord or (i == 7 and TEXT.Prize or ("Day " .. i))
		cell.Dim.Visible = claimed
		cell.Check.Visible = claimed
		-- (F0 review, minor: the mock keeps a claimed day's name and amount brown) the cover dims the art only: the texts
		-- sit over it in the muted ink
		cell.Day.ZIndex = claimed and cell.Dim.ZIndex + 1 or 5
		cell.Amount.ZIndex = claimed and cell.Dim.ZIndex + 1 or 5
		-- (look review r0) the prize card's label in the muted caption ink, as the mock's (TODAY keeps the full ink)
		local prizeLabel = i == 7 and not (today and due)
		cell.Day.TextColor3 = (claimed or prizeLabel) and SIGN.TextMuted or SIGN.Text
		cell.Amount.TextColor3 = claimed and SIGN.TextMuted or SIGN.Text
		if cell.Species then
			-- (Pitch 2 09 B) the prize card: the plank keeps its cream words and its lip rides with it over the cover; the
			-- species line under it
			cell.Amount.TextColor3 = K.PLANK.Text
			local lip = cell.Amount:FindFirstChild("Lip")
			if lip then
				lip.ZIndex = cell.Amount.ZIndex
			end
			cell.Species.ZIndex = cell.Amount.ZIndex
			cell.Species.Text = e.Kind == "Pet" and H.speciesLine(e.PetId) or ""
			cell.Species.Visible = cell.Species.Text ~= "" and cell.SpeciesRoom ~= false
		end
		-- (kit-b U9-4) only a gift the claim takes now glints (a held one, Locked, waits)
		cell.Sparkles.Visible = today and (view.Mode == "Claim" or view.Mode == "Repair")
		H.paintLook(cell, DAY_COLORS[i], today and "Today" or (claimed and "Claimed" or "Open"))
		if today and e.Repair == true then
			-- the claim re-earns this day and pays nothing: no amount, no gift art (re-review 1)
			cell.Amount.Text = "Repair"
			H.paintArt(cell, { Kind = "Repair" })
		elseif e.Kind ~= nil then
			cell.Amount.Text = H.fitText(cell.Amount, cellAmounts(e))
			H.paintArt(cell, e)
		else
			cell.Amount.Text = ""
		end
		if not cell.Species then
			-- (fix6 look0 #6) a narrow tile's day name and amount whole: a smaller size, never under the floor
			H.shrinkFit(cell.Day, M.DayText)
			H.shrinkFit(cell.Amount, M.AmountText)
		end
	end
	-- (fix6 look0 #6) the row's names and amounts at one size each: the smallest a tile needed
	local dayPx, amountPx = M.DayText, M.AmountText
	for _, cell in ipairs(U.Cells) do
		if not cell.Species then
			dayPx, amountPx = math.min(dayPx, cell.Day.TextSize), math.min(amountPx, cell.Amount.TextSize)
		end
	end
	for _, cell in ipairs(U.Cells) do
		if not cell.Species then
			cell.Day.TextSize, cell.Amount.TextSize = dayPx, amountPx
		end
	end
	-- the Week Wisp line and its bar (the banner takes the line's place while it is up)
	local banner = time() < S.BannerUntil
	U.Banner.Visible = banner
	U.WispText.Text = loading and "" or H.wispText(cellNo)
	U.WispText.Visible = not banner and not loading
	U.WispBar.Visible = not (banner and S.Mode == "Portrait") -- (playtest 2026-11-28 C28: the portrait banner covers its row)
	for i, seg in ipairs(U.Segs) do
		local e = entryAt(list, i)
		local state = (e.Claimed == true and "Claimed") or ((e.Today == true and not waiting) and "Today") or "Open"
		if seg:GetAttribute("State") ~= state then
			paintSeg(seg, state)
		end
	end
	-- the claim slot
	local wide = view.Repair == true or view.Mode == "Repair" or waiting
	H.placeBottom(M, wide and M.RepairW or M.ClaimW)
	U.Claim.Visible = due
	U.Countdown.Visible = not due
	U.Claim:SetAttribute("Mode", view.Mode)
	if view.Mode == "Locked" then
		U.Claim.Text = ""
		U.Claim:SetAttribute("Disabled", true)
		U.Line1.Text, U.Line2.Text = view.Line1 or "", view.Line2 or ""
		U.Line1.Visible, U.Line2.Visible = true, true
	else
		U.Claim.Text = (view.Mode == "Repair") and K.REPAIR_TEXT or TEXT.Claim
		U.Claim.TextSize = (view.Mode == "Repair") and M.RepairText or M.ClaimText
		U.Claim:SetAttribute("Disabled", false)
		U.Line1.Visible, U.Line2.Visible = false, false
	end
	U.Countdown.Text = due and "" or (view.Line1 or "")
	U.Keep.Text = (view.Mode == "Locked" and TEXT.KeepLocked) or (due and TEXT.KeepClaim) or TEXT.Keep -- (Pitch 2 09 B: by a due claim it says to claim today's gift)
	U.Keep.Visible = not waiting
end

-- the Play page (card B): the header line, CLAIM ALL (n) and the seven gift boxes
function H.renderPlay(st, M)
	local p = play(st)
	local loading = type(st) ~= "table" or st.Loading == true
	local at = now()
	local texts
	if loading then
		texts = { TEXT.PlayLoading }
	elseif p.Active == false then
		-- (on a touch device the stick is hidden while this window is open: only closing it lets the player move)
		texts = H.touchOnly() and TEXT.PlayPausedTouch or TEXT.PlayPausedPC
	else
		local mins = math.floor(H.liveSeconds(st, at) / 60)
		local reset = " " .. DOT .. " Resets in " .. resetText((tonumber(p.DayEnds) or 0) - at)
		texts = { mins .. " min today" .. reset }
		if S.Mode == "PC" then
			texts = { mins .. " min played today" .. reset, texts[1] }
		end
	end
	local paused = not loading and p.Active == false
	Theme.SetRole(U.PlayHeader, paused and "Body" or "Heading") -- (kit-b U6) SetRole keeps Body's Nunito face
	U.PlayHeader.TextColor3 = paused and SIGN.RedLip or SIGN.Text -- (kit-b U9-4) the paused line in the kit's red ink
	U.PlayHeader.TextSize = paused and M.PausedText or M.PlayText
	U.PlayHeader.Text = H.fitLines(U.PlayHeader, texts, S.Mode == "Portrait" and 2 or 1)
	-- CLAIM ALL: the ready count; greyed out at 0, in the same place
	local readyCount = H.readyCount(st)
	U.ClaimAll.Text = string.format(TEXT.ClaimAll, readyCount)
	U.ClaimAll:SetAttribute("Disabled", readyCount == 0)
	local list = tiers(st)
	-- (U9-4 look review) the next gift to open: the first one still locked; its bar fills with the minutes played toward it
	local nextTier = nil
	for i, t in ipairs(list) do
		if nextTier == nil and type(t) == "table" and t.Claimed ~= true and t.Ready ~= true then
			nextTier = i
		end
	end
	local live = H.liveSeconds(st, at)
	for i, cell in ipairs(U.Tiers) do
		local t = list[i]
		cell.Root.Visible = type(t) == "table"
		if type(t) == "table" then
			local color = TIER_COLORS[i] or SIGN.Gold
			cell.Time.Text = tostring(tonumber(t.Min) or 0) .. " min"
			H.placeReward(cell, t)
			H.paintGift(cell)
			local claimed = t.Claimed == true
			local ready = not claimed and t.Ready == true and not loading
			local state = claimed and "Claimed" or (ready and "Ready" or "Locked")
			cell.Root:SetAttribute("State", state)
			cell.Root:SetAttribute("Pulsing", ready)
			cell.Gift:SetAttribute("Bobbing", ready)
			if not ready and cell.GiftY and cell.Gift.Position.Y.Offset ~= cell.GiftY then
				cell.Gift.Position = UDim2.fromOffset(cell.GiftX, cell.GiftY)
			end
			cell.Check.Visible = claimed
			cell.Dim.Visible = claimed
			cell.Claim.Visible = ready
			cell.Sparkles.Visible = ready -- (kit-b U9-4) the ready box glints
			local countdown = state == "Locked" and DailyController.TierCountdown(i, st, at) or ""
			cell.Clock.Text = countdown
			cell.Clock.Visible = countdown ~= ""
			if cell.Bar then
				local on = i == nextTier and countdown ~= "" and not loading
				cell.Bar.Visible = on
				if on then
					local need = math.max(1, (tonumber(t.Min) or 1) * 60)
					H.paintTierBar(cell.Bar, math.floor(K.TIER_BAR.Count * math.min(1, live / need) + 1e-6), paused)
				end
			end
			H.placeClock(cell, countdown)
			H.paintLook(cell, color, state) -- (just ready: the ink edge at once; the tick then swaps it)
			cell.State = state
		end
	end
end

function H.render()
	if not U.Holder or not S.G then
		return
	end
	local M = H.metrics()
	local st = S.State
	H.paintTab(U.TabDaily, S.Tab == "Daily")
	H.paintTab(U.TabPlay, S.Tab == "Play")
	U.DailyPage.Visible = S.Tab == "Daily"
	U.PlayPage.Visible = S.Tab == "Play"
	H.renderDaily(st, M)
	H.renderPlay(st, M)
end

-- 1 s: countdowns, today's pulse, the pip
function H.tick()
	H.refreshPip()
	if not S.Open or not U.Holder then
		return
	end
	H.render()
	S.Pulse = not S.Pulse
	-- (kit-b U9-4) the glints swap their lit sparkle
	for _, list in ipairs({ U.Cells, U.Tiers }) do
		for _, cell in ipairs(list) do
			if cell.Sparkles.Visible then
				H.twinkle(cell.Sparkles, S.Pulse)
			end
		end
	end
	if S.Tab == "Play" then
		-- a ready gift box: its edge pulses (two frames) and its gift bobs
		for _, cell in ipairs(U.Tiers) do
			if cell.Root:GetAttribute("Pulsing") == true then
				H.pulseEdge(cell, S.Pulse)
			end
			if cell.Gift:GetAttribute("Bobbing") == true and cell.GiftY then
				-- (U9-4 look review 2) a two-frame hop on the tick, as the pulse: a tween slid the pixel gift across half pixels
				cell.Gift.Position = UDim2.fromOffset(cell.GiftX, cell.GiftY - (S.Pulse and K.BOB or 0))
			end
		end
		return
	end
	for _, cell in ipairs(U.Cells) do
		if cell.Root:GetAttribute("Pulsing") == true then
			H.pulseEdge(cell, S.Pulse)
		end
	end
end

----------------------------------------------------------------------
-- Moments
----------------------------------------------------------------------
function H.pop(scaleObj)
	if scaleObj then
		scaleObj.Scale = K.POP
		Util.Tween(scaleObj, K.POP_TIME, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
end

function H.week()
	S.BannerUntil = time() + K.WEEK_SECONDS
	pcall(SoundFx.Play, "DailyWeek")
	if not (S.Open and U.Fx) or GraphicsQuality.Effective() == "Low" then
		return -- the confetti is High only (the banner and the sound stay)
	end
	-- (kit-b U9-4, finding 26) flat bits in the kit's gold and pink (K.CONFETTI_COLORS); the rainbow sweep band went (a
	-- sheen sweep: kit B has none)
	local fx = U.Fx
	local colors = K.CONFETTI_COLORS
	for i = 1, K.CONFETTI do
		local bit = Instance.new("Frame")
		bit.Name = "Confetti"
		bit.BorderSizePixel = 0
		bit.BackgroundColor3 = colors[(i - 1) % #colors + 1]
		bit.Size = UDim2.fromOffset(8, 12)
		bit.AnchorPoint = Vector2.new(0.5, 0.5)
		local x = (i - 0.5) / K.CONFETTI + (math.random() - 0.5) * 0.03
		bit.Position = UDim2.new(x, 0, 0, -8)
		bit.ZIndex = 9
		bit.Parent = fx
		local fall = K.CONFETTI_TIME * (0.7 + 0.3 * math.random())
		Util.Tween(bit, fall, { Position = UDim2.new(x + (math.random() - 0.5) * 0.08, 0, 1, 12) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(fall + 0.05, function()
			bit:Destroy()
		end)
	end
end

function H.onState(payload)
	if type(payload) ~= "table" then
		return
	end
	S.State = payload
	if payload.Loading == true then
		S.Last = nil -- a (re)load: the next real payload is a join, it never pops, shakes or celebrates
		H.paintRing()
		H.refreshPip()
		H.render()
		return
	end
	local prev = S.Last
	if prev then
		local popped = false
		local before, after = days(prev), days(payload)
		for i = 1, 7 do
			if entryAt(after, i).Claimed == true and entryAt(before, i).Claimed ~= true then
				popped = true
				if U.Cells[i] then
					H.pop(U.Cells[i].Pop)
				end
			end
		end
		local tb, ta = tiers(prev), tiers(payload)
		local newlyReady = false
		for i = 1, #ta do
			local a, b = entryAt(ta, i), entryAt(tb, i)
			if a.Claimed == true and b.Claimed ~= true then
				popped = true
				if U.Tiers[i] then
					H.pop(U.Tiers[i].Pop)
				end
			end
			if a.Ready == true and a.Claimed ~= true and b.Ready ~= true then
				newlyReady = true
			end
		end
		if popped then
			pcall(SoundFx.Play, "Reward")
		end
		-- the week moment only for a PAID week: DailyService raises Weeks (= floor(Paid / 7)) only when a claim pays a day
		-- 7; a repair claim that climbs back onto a multiple of 7 ("Streak repaired! Day 7 of 7") leaves Weeks alone
		local streak, was = tonumber(payload.Streak) or 0, tonumber(prev.Streak) or 0
		local weeks, wasWeeks = tonumber(payload.Weeks) or 0, tonumber(prev.Weeks) or 0
		if streak > was and weeks > wasWeeks and streak > 0 and streak % 7 == 0 then
			H.week()
		end
		if newlyReady then
			H.shake()
		end
	end
	local back = tonumber(payload.StepBack) or 0
	if back > 0 then
		local key = tostring(back) .. "|" .. tostring(payload.Streak) .. "|" .. tostring(payload.ReadyAt)
		if key ~= S.StepBackKey then
			S.StepBackKey = key
			local menu = controller("MenuController")
			if menu and type(menu.Hint) == "function" then
				local n = math.floor(back)
				pcall(menu.Hint, "Welcome back! You stepped back " .. n .. (n == 1 and " day" or " days") .. ". Keep going!", "info")
			end
		end
	end
	S.Last = payload
	H.paintRing()
	H.refreshPip()
	H.render()
end

function H.send(action, tier)
	local key = action .. tostring(tier or "")
	local t = os.clock()
	if S.LastFire[key] and t - S.LastFire[key] < K.CLAIM_GAP then
		return false
	end
	local ok, remote = pcall(Remotes.Get, "DailyRequest")
	if not ok or not remote then
		return false
	end
	S.LastFire[key] = t
	if tier ~= nil then
		remote:FireServer(action, tier)
	else
		remote:FireServer(action)
	end
	return true
end

-- the claim button: only what the view promises (a stale, waiting or locked view never claims; the server decides anyway)
function H.onClaim()
	if claimable(S.State) then
		H.send("Claim")
	end
end

-- CLAIM ALL: one request for every ready play gift (the server claims each through ClaimPlay's step, one toast)
function H.claimAll()
	if H.readyCount(S.State) > 0 then
		H.send("ClaimPlayAll")
	end
end

function H.syncBack()
	if S.Open and not S.BackBound then
		S.BackBound = true
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, function(_, inputState)
				if inputState == Enum.UserInputState.Begin then
					DailyController.Close()
				end
				return Enum.ContextActionResult.Sink
			end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	elseif not S.Open and S.BackBound then
		S.BackBound = false
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

function H.relayout()
	H.layoutButton()
	if S.Open and U.Holder then
		H.layout()
		U.Holder.Visible = true
		H.render()
		H.coverColumn()
	end
end

function H.onPlayState()
	if S.Open and hiddenByPlay() then
		DailyController.Close()
	end
	H.layoutButton()
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function DailyController.State()
	return S.State
end

function DailyController.IsOpen()
	return S.Open
end

function DailyController.Layout()
	if S.Open and S.Mode then
		return S.Mode
	end
	local r = NeonKit.BigRect(K)
	if r.mode == "Phone" and r.portrait then
		return "Portrait"
	end
	return r.mode
end

-- what the claim slot says (see the header): pure over its arguments
function DailyController.ClaimView(st, at, touch)
	at = tonumber(at) or now()
	if type(st) ~= "table" or st.Loading == true then
		return { Mode = "Loading", Line1 = TEXT.Getting }
	end
	if stale(st, at) then
		return { Mode = "Stale", Line1 = TEXT.Getting }
	end
	local repair = st.Repair == true
	local readyAt = tonumber(st.ReadyAt)
	if readyAt == nil or at < readyAt then
		-- the wait before a claim that only repairs (Repair, re-review 3) never names a gift
		return { Mode = "Wait", Line1 = (repair and "Streak repair in " or "Next gift in ") .. leftText((readyAt or at) - at), Repair = repair or nil }
	end
	local unlock = type(st.Unlock) == "table" and st.Unlock or nil
	local need = unlock and tonumber(unlock.Need) or 0
	local left = unlock and tonumber(unlock.Left) or 0
	if need > 0 and left > 0 then
		local p = play(st)
		-- the seconds left, counted down on the client only while the server counts (Active), from its ServerNow
		local live = left
		if p.Active == true then
			live = left - math.max(0, at - (tonumber(st.ServerNow) or at))
		end
		local dayLeft = (tonumber(p.DayEnds) or 0) - at
		local line2
		if dayLeft > 0 and dayLeft < live then
			line2 = string.format(TEXT.Resets, math.max(1, math.ceil(dayLeft / 60)))
		elseif p.Active == false then
			line2 = touch and TEXT.PausedTouch or TEXT.PausedPC
		else
			line2 = string.format(TEXT.ToGo, math.max(1, math.ceil(live / 60)))
		end
		return { Mode = "Locked", Line1 = string.format(TEXT.Unlock, math.ceil(need / 60)), Line2 = line2, Repair = repair or nil }
	end
	if repair then
		return { Mode = "Repair", Line1 = K.REPAIR_TEXT, Repair = true }
	end
	return { Mode = "Claim", Line1 = TEXT.Claim }
end

-- play tier i's own countdown (see the header): pure over its arguments
function DailyController.TierCountdown(i, st, at)
	if type(st) ~= "table" or st.Loading == true then
		return ""
	end
	local t = tiers(st)[i]
	if type(t) ~= "table" or t.Claimed == true or t.Ready == true then
		return ""
	end
	at = tonumber(at) or now()
	local left = math.max(1, math.ceil((tonumber(t.Min) or 0) * 60 - H.liveSeconds(st, at)))
	if left >= 3600 then
		return math.floor(left / 3600) .. "h " .. math.floor((left % 3600) / 60) .. "m"
	end
	return math.floor(left / 60) .. ":" .. string.format("%02d", left % 60)
end

function DailyController.PipShown()
	local st = S.State
	if type(st) ~= "table" or st.Loading == true or S.Hidden then
		return false
	end
	if not (claimable(st) or tierReady(st)) then
		return false
	end
	if time() - S.SpawnAt < (Config.Daily and Config.Daily.PipDelaySeconds or 20) then
		return false
	end
	return tutorialOk()
end

function DailyController.Open(args)
	if not initialized then
		DailyController.Init()
	end
	if not U.Gui or hiddenByPlay() then
		return false
	end
	args = type(args) == "table" and args or {}
	local wasOpen = S.Open
	if args.Tab == "Play" or args.Tab == "Daily" then
		S.Tab = args.Tab
	elseif not wasOpen then
		S.Tab = (not claimable(S.State) and tierReady(S.State)) and "Play" or "Daily"
	end
	S.Open = true
	-- (review round 2) S.Open hides the button first; a build / layout / render that throws is undone (the window shut,
	-- S.Open false, the button back at once: a phone has no Esc to get out of a half-built window with no button)
	local built = safe("open", function()
		H.layoutButton()
		H.ensureWindow()
		H.layout()
		U.Holder.Visible = true
		H.render()
	end)
	if not built then
		S.Open = false
		if U.Holder then
			U.Holder.Visible = false
		end
		H.syncBack()
		safe("cover", H.coverColumn)
		safe("layout", H.layoutButton)
		return false
	end
	H.syncBack()
	if not wasOpen then
		-- (Pitch 2 F0, finish pass A) the kit's open: the window rises 12 px in 3 hard steps (no scale bounce)
		U.Pop.Scale = 1
		SignKit.Rise(U.Window)
		local menu = controller("MenuController")
		if menu and menu.WindowOpened then
			menu.WindowOpened:Fire("Daily")
		end
		safe("layout", H.layoutButton) -- (win 5) after the windows WindowOpened just closed (owner 2026-11-13: S.Open keeps it hidden)
	end
	H.coverColumn() -- after WindowOpened: the window it closed clears only its own cover
	return true
end

function DailyController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	if U.Holder then
		U.Holder.Visible = false
	end
	H.syncBack()
	H.coverColumn()
	safe("layout", H.layoutButton) -- (owner 2026-11-13) the button, its ring and its pip are back at once
end

function DailyController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	U.Gui = CloudUI.NewScreenGui("NimbusDaily", K.DISPLAY_ORDER)
	-- (LOOK-ui) every kit edge and lip in it, now and later, on whole screen px
	PixelIcon.WholeTree(U.Gui)
	U.Gui.IgnoreGuiInset = false
	H.buildButton()
	S.SpawnAt = time()
	LocalPlayer.CharacterAdded:Connect(function()
		S.SpawnAt = time()
		H.refreshPip()
	end)
	local attr = Config.Attr
	LocalPlayer:GetAttributeChangedSignal(attr.InMatch):Connect(function()
		safe("match", H.onPlayState)
	end)
	LocalPlayer:GetAttributeChangedSignal(attr.InBattle or "InBattle"):Connect(function()
		safe("battle", H.onPlayState)
	end)
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		safe("relayout", H.relayout)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Escape and S.Open then
			DailyController.Close()
		end
	end)
	local menu = controller("MenuController")
	if menu and menu.WindowOpened then
		menu.WindowOpened:Connect(function(id)
			if id ~= "Daily" then
				if S.Open then
					DailyController.Close()
				end
				-- (win 5) the button steps aside behind the window that opened (deferred: it finishes opening first)
				task.defer(function()
					safe("windows", H.layoutButton)
				end)
			end
		end)
	end
	-- the Shop's open / close (review round 1): the button steps aside while the Shop is up
	local shop = controller("ShopController")
	if type(shop) == "table" and type(shop.Toggled) == "table" and type(shop.Toggled.Connect) == "function" then
		shop.Toggled:Connect(function()
			safe("shop", H.layoutButton)
		end)
	end
	safe("layout", H.layoutButton)
	-- (win 5) no window fires a shared close signal (an X, Esc, another window taking over, a match start): the watcher
	-- re-lays the button out only when the K.WINDOWS answer changes
	task.spawn(function()
		while true do
			task.wait(K.WINDOW_POLL)
			safe("windows", H.watchWindows)
		end
	end)
	task.spawn(function()
		local pg = LocalPlayer:WaitForChild("PlayerGui")
		local hud = pg:WaitForChild("NimbusHud", 30)
		if hud then
			for _, name in ipairs({ "TopRightLeft", "TopRightBottom", "GiftLeft", "GiftTop", "GiftSize" }) do
				hud:GetAttributeChangedSignal(name):Connect(function()
					safe("relayout", H.relayout)
				end)
			end
			safe("relayout", H.relayout)
		end
	end)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "DailyState")
		if ok and remote then
			remote.OnClientEvent:Connect(function(payload)
				safe("state", H.onState, payload)
			end)
		end
	end)
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "TutorialState")
		if ok and remote then
			remote.OnClientEvent:Connect(function(payload)
				if type(payload) == "table" then
					S.Tutorial = payload
					H.refreshPip()
				end
			end)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			safe("tick", H.tick)
		end
	end)
end

return DailyController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1132">
            <Properties>
              <string name="Name">DamageFx</string>
              <string name="Source"><![CDATA[-- DamageFx (client, v2): everything the player sees and feels when they get hurt (or get paid).
--
--   DamageFx.Init()
--
-- What it does
--   * Remotes.DamageTaken(amount, kind): a SUBTLE coloured vignette on the screen EDGES only (four gradient
--     strips, no images; the middle of the screen stays clear), a short camera shake, and a small floating
--     "-12" number with a kind word ("ZAP!") that pops, rises and fades above the local player's head.
--   * Storm damage arrives four times a second, so it is merged into one gentle number every
--     STORM_INTERVAL seconds instead of spamming the screen.
--   * The MatchTokens player attribute going up pops a golden "+n <coin>" above the head (golden tokens get a
--     bigger, paler pop).
--
-- Colours follow the calmer v2 palette: nothing flashes white, the lightning flash is a faint warm wash.
-- v3 readability rule: the floating texts are sized with Theme.ScaledSize (1080p sizes scaled by the screen
-- height, never below 14 px) and carry a thick glyph outline, so they read over sky, clouds and grass alike.
--
-- Camera shake
--   The shake is driven through Humanoid.CameraOffset by a RenderStepped connection that exists only
--   while there is shake left. Whenever the shake ends, the character goes away or the humanoid
--   changes, CameraOffset is put back to zero, so the camera can never stay displaced.
--
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the token pop's coin
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DamageFx = {}

local LocalPlayer = Players.LocalPlayer
local ATTR = Config.Attr

----------------------------------------------------------------------
-- Tuning
----------------------------------------------------------------------
local STORM_INTERVAL = 0.6 -- seconds between merged storm damage numbers
local MAX_LIVE_FLOATS = 12 -- hard cap on simultaneous floating texts

local SHAKE_MAX = 0.8 -- studs of camera offset at full trauma
local SHAKE_DECAY = 2.6 -- trauma lost per second
local SHAKE_SPEED = 1.0 -- multiplier for the shake oscillation speed

-- 1080p design sizes of the floating texts (scaled per screen by Theme.ScaledSize)
local FLOAT_W = 260
local FLOAT_H = 120
local NUMBER_SIZE = 40
local NUMBER_SIZE_BIG = 48 -- hits of 25+
local WORD_SIZE = 24
local TOKEN_SIZE = 34
local TOKEN_SIZE_GOLDEN = 42

local Colors = Theme.Colors

-- Per damage kind: the word, the number colour, the vignette colour and how hard it shakes.
-- (All kinds of Config.Damage.Kinds are covered; anything unknown falls back to Other.)
local KIND_STYLE = {
	Void = {
		Word = "SPLASH",
		Color = Color3.fromRGB(190, 168, 242),
		Vignette = Color3.fromRGB(120, 88, 214),
		Shake = 0.5,
	},
	Lightning = {
		Word = "ZAP!",
		Color = Color3.fromRGB(244, 226, 134),
		Vignette = Color3.fromRGB(226, 196, 84),
		Shake = 0.8,
		Flash = true,
	},
	SpinBar = {
		Word = "WHACK!",
		Color = Color3.fromRGB(240, 156, 112),
		Vignette = Color3.fromRGB(214, 84, 76),
		Shake = 0.6,
	},
	Pendulum = {
		Word = "BONK!",
		Color = Color3.fromRGB(236, 170, 120),
		Vignette = Color3.fromRGB(206, 100, 80),
		Shake = 0.6,
	},
	Storm = {
		Word = "DRIZZLE",
		Color = Color3.fromRGB(150, 192, 238),
		Vignette = Color3.fromRGB(80, 118, 196),
		Shake = 0.1,
		Soft = true,
	},
	Other = {
		Word = "OOF!",
		Color = Colors.Bad,
		Vignette = Color3.fromRGB(204, 72, 92),
		Shake = 0.4,
	},
}

-- Smooth falloff for the vignette strips (strongest at the screen edge, clear towards the middle).
local VIGNETTE_FALLOFF = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0),
	NumberSequenceKeypoint.new(0.4, 0.6),
	NumberSequenceKeypoint.new(0.75, 0.9),
	NumberSequenceKeypoint.new(1, 1),
})

-- rotation: UIGradient offset 0 sits at the screen edge. 90 = top edge, -90 = bottom, 0 = left, 180 = right.
-- The strips are narrow: only the outer fifth of the screen is ever tinted.
local EDGE_DEFS = {
	{ Name = "Top", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(1, 0.22), Rotation = 90 },
	{ Name = "Bottom", Anchor = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.22), Rotation = -90 },
	{ Name = "Left", Anchor = Vector2.new(0, 0), Position = UDim2.fromScale(0, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 0 },
	{ Name = "Right", Anchor = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.14, 1), Rotation = 180 },
}

----------------------------------------------------------------------
-- State
----------------------------------------------------------------------
local initialized = false
local rng = Random.new()

local vignette = nil -- { holder, edges, tweens, flash, flashTween, token }
local liveFloats = 0

local shake = { trauma = 0, clock = 0, conn = nil, humanoid = nil, px = 0, py = 0 }

local stormAccum = 0
local stormLastShow = -10
local stormScheduled = false

local lastMatchTokens = 0

----------------------------------------------------------------------
-- Screen vignette
----------------------------------------------------------------------
local function buildScreenGui()
	local gui = CloudUI.NewScreenGui("NimbusDamageFx", 5) -- below the HUD (10)

	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromScale(1, 1)
	holder.Visible = false
	holder.Parent = gui

	local edges = {}
	for _, def in ipairs(EDGE_DEFS) do
		local edge = Instance.new("Frame")
		edge.Name = def.Name
		edge.AnchorPoint = def.Anchor
		edge.Position = def.Position
		edge.Size = def.Size
		edge.BorderSizePixel = 0
		edge.BackgroundColor3 = KIND_STYLE.Other.Vignette
		edge.BackgroundTransparency = 1
		edge.Parent = holder

		local gradient = Instance.new("UIGradient")
		gradient.Rotation = def.Rotation
		gradient.Transparency = VIGNETTE_FALLOFF
		gradient.Parent = edge

		table.insert(edges, edge)
	end

	-- faint warm wash used for lightning (never a white-out)
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(240, 228, 190)
	flash.BackgroundTransparency = 1
	flash.Visible = false
	flash.Parent = gui

	vignette = { holder = holder, edges = edges, tweens = {}, flash = flash, flashTween = nil, token = 0 }
end

-- Fade the kind-coloured edges from startT to invisible over 'seconds'.
local function flashVignette(color, startT, seconds)
	local v = vignette
	if not v then
		return
	end
	v.token = v.token + 1
	local token = v.token
	v.holder.Visible = true
	for i, edge in ipairs(v.edges) do
		-- a running tween would overwrite the value we set below, so stop it first
		local old = v.tweens[i]
		if old then
			old:Cancel()
		end
		edge.BackgroundColor3 = color
		edge.BackgroundTransparency = startT
		v.tweens[i] = Util.Tween(edge, seconds, { BackgroundTransparency = 1 })
	end
	task.delay(seconds + 0.05, function()
		if vignette and vignette.token == token then
			vignette.holder.Visible = false
		end
	end)
end

local function flashScreen(startT, seconds)
	local v = vignette
	if not v then
		return
	end
	if v.flashTween then
		v.flashTween:Cancel()
	end
	v.flash.Visible = true
	v.flash.BackgroundTransparency = startT
	local tween = Util.Tween(v.flash, seconds, { BackgroundTransparency = 1 })
	v.flashTween = tween
	task.delay(seconds + 0.05, function()
		if vignette and vignette.flashTween == tween then
			vignette.flash.Visible = false
		end
	end)
end

----------------------------------------------------------------------
-- Camera shake (Humanoid.CameraOffset, always restored)
----------------------------------------------------------------------
local function stopShake()
	if shake.conn then
		shake.conn:Disconnect()
		shake.conn = nil
	end
	shake.trauma = 0
	local humanoid = shake.humanoid
	shake.humanoid = nil
	if humanoid then
		pcall(function()
			humanoid.CameraOffset = Vector3.new(0, 0, 0)
		end)
	end
end

local function stepShake(dt)
	local humanoid = shake.humanoid
	if not humanoid or not humanoid.Parent then
		stopShake()
		return
	end
	shake.trauma = shake.trauma - SHAKE_DECAY * dt
	if shake.trauma <= 0 then
		stopShake()
		return
	end
	shake.clock = shake.clock + dt * SHAKE_SPEED
	local t = shake.clock
	local magnitude = shake.trauma * shake.trauma * SHAKE_MAX
	-- two incommensurate sines per axis read as noise without needing a random value per frame
	local x = (math.sin(t * 41 + shake.px) + 0.6 * math.sin(t * 67 + shake.py)) / 1.6
	local y = (math.sin(t * 53 + shake.py) + 0.6 * math.sin(t * 79 + shake.px)) / 1.6
	humanoid.CameraOffset = Vector3.new(x * magnitude, y * magnitude, 0)
end

local function addShake(amount)
	if amount <= 0 then
		return
	end
	local humanoid = Util.GetHumanoid(LocalPlayer)
	if not humanoid then
		return
	end
	if shake.humanoid ~= humanoid then
		stopShake() -- gives the previous humanoid (if any) its camera back
		shake.humanoid = humanoid
		shake.px = rng:NextNumber(0, 6.28)
		shake.py = rng:NextNumber(0, 6.28)
	end
	shake.trauma = math.min(1, shake.trauma + amount)
	if not shake.conn then
		shake.conn = RunService.RenderStepped:Connect(stepShake)
	end
end

----------------------------------------------------------------------
-- Floating texts (damage numbers, token pops)
----------------------------------------------------------------------
-- The part floating text hangs above, plus how many studs higher to start for that part.
local function getAnchor()
	local char = LocalPlayer.Character
	if not char then
		return nil, 0
	end
	local head = char:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		return head, 0
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root, 1.5
	end
	return nil, 0
end

-- cfg: Text, Word (optional kind word), Color, WordColor, TextSize, Rise, Life, StartX, StartY,
--      Gradient = { top, bottom } (optional; tints the number with a UIGradient)
local function spawnFloat(cfg)
	if liveFloats >= MAX_LIVE_FLOATS then
		return
	end
	local anchor, bias = getAnchor()
	if not anchor then
		return
	end
	local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end

	local startOffset = Vector3.new(cfg.StartX or 0, (cfg.StartY or 2.6) + bias, 0)
	local endOffset = startOffset + Vector3.new(0, cfg.Rise or 3, 0)
	local life = cfg.Life or 1.1
	local factor = Theme.ScreenFactor()

	local board = Instance.new("BillboardGui")
	board.Name = "NC_FloatText"
	board.Adornee = anchor
	board.AlwaysOnTop = true
	board.LightInfluence = 0
	board.ResetOnSpawn = false
	board.Size = UDim2.fromOffset(math.floor(FLOAT_W * factor), math.floor(FLOAT_H * factor))
	board.StudsOffset = startOffset

	-- the scale pop lives on an inner frame so the billboard itself keeps its size
	local root = Instance.new("Frame")
	root.Name = "Root"
	root.BackgroundTransparency = 1
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1, 1)
	root.Parent = board

	local scale = Instance.new("UIScale")
	scale.Scale = 0.3
	scale.Parent = root

	local texts = {}
	local outlines = {}
	local textSize = Theme.ScaledSize(cfg.TextSize or NUMBER_SIZE)
	local outlineColor = Theme.Darken(cfg.Color or Colors.Bad, 0.72)
	-- over the 3D world with no plate: ONE outline in the darkened colour (kit-b U6: no classic stroke under it)
	local number = Theme.Label(cfg.Text, "Accent", {
		Size = textSize,
		Color = cfg.Color,
		Outline = "World",
		OutlineThickness = 3,
		OutlineColor = outlineColor,
		Props = {
			Name = "Number",
			Size = UDim2.new(1, 0, 0, math.floor(textSize * 1.3)),
			Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5)),
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
		},
	})
	number.Parent = root
	if cfg.Icon then
		-- (kit-b U7a) a PixelIcon after the number (the token pop's coin); it fades with the number
		PixelIcon.Lead(number, cfg.Icon, { After = true, Colour = cfg.IconColor })
	end
	table.insert(texts, number)
	table.insert(outlines, number:FindFirstChild("TextOutline"))
	if cfg.Gradient then
		-- UIGradient multiplies the text colour, so the label itself must be white
		number.TextColor3 = Colors.White
		Theme.Gradient(number, cfg.Gradient[1], cfg.Gradient[2], 90)
	end

	if cfg.Word then
		local wordSize = Theme.ScaledSize(WORD_SIZE)
		local wordColor = cfg.WordColor or cfg.Color
		local wordOutline = Theme.Darken(wordColor or Colors.Bad, 0.72)
		local word = Theme.Label(cfg.Word, "Accent", {
			Size = wordSize,
			Color = wordColor,
			Outline = "World",
			OutlineThickness = 2,
			OutlineColor = wordOutline,
			Props = {
				Name = "Word",
				Size = UDim2.new(1, 0, 0, math.floor(wordSize * 1.3)),
				Position = UDim2.new(0, 0, 0.5, -math.floor(textSize * 0.5 + wordSize * 1.25)),
				TextXAlignment = Enum.TextXAlignment.Center,
				TextYAlignment = Enum.TextYAlignment.Center,
			},
		})
		word.Parent = root
		table.insert(texts, word)
		table.insert(outlines, word:FindFirstChild("TextOutline"))
	end

	board.Parent = playerGui
	liveFloats = liveFloats + 1

	Util.Tween(scale, 0.3, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	Util.Tween(board, life, { StudsOffset = endOffset }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	task.delay(life * 0.55, function()
		if not board.Parent then
			return
		end
		for _, label in ipairs(texts) do
			Util.Tween(label, life * 0.45, { TextTransparency = 1 })
		end
		for _, outline in ipairs(outlines) do
			if outline then
				Util.Tween(outline, life * 0.45, { Transparency = 1 })
			end
		end
	end)
	task.delay(life + 0.1, function()
		liveFloats = math.max(0, liveFloats - 1)
		if board.Parent then
			board:Destroy()
		end
	end)
end

local function spawnDamageNumber(amount, kind)
	local style = KIND_STYLE[kind] or KIND_STYLE.Other
	local n = math.max(1, math.floor(amount + 0.5))
	local size = NUMBER_SIZE
	if n >= 25 then
		size = NUMBER_SIZE_BIG
	end
	spawnFloat({
		Text = "-" .. n,
		Word = style.Word,
		Color = style.Color,
		WordColor = Theme.Lighten(style.Color, 0.3),
		TextSize = size,
		Rise = 3,
		Life = 1.05,
		StartX = rng:NextNumber(-1.1, 1.1),
		StartY = 2.6,
	})
end

local function spawnTokenPop(delta)
	local golden = delta >= (Config.Tokens.GoldenValue or 5)
	spawnFloat({
		Text = "+" .. delta,
		Icon = Theme.Currency.Tokens.Icon,
		IconColor = golden and Colors.TokenGlow or Colors.Token,
		Color = Colors.Token,
		Gradient = golden and { Colors.White:Lerp(Colors.TokenGlow, 0.4), Colors.TokenGlow }
			or { Colors.TokenGlow, Colors.Token },
		TextSize = golden and TOKEN_SIZE_GOLDEN or TOKEN_SIZE,
		Rise = 3.2,
		Life = 1.2,
		StartX = rng:NextNumber(-1.4, 1.4),
		StartY = 3.4,
	})
end

----------------------------------------------------------------------
-- Storm merging
----------------------------------------------------------------------
local function showStormNumber()
	stormScheduled = false
	if stormAccum <= 0 then
		return
	end
	local total = stormAccum
	stormAccum = 0
	stormLastShow = os.clock()
	spawnDamageNumber(total, "Storm")
end

local function queueStormNumber(amount)
	stormAccum = stormAccum + amount
	if stormScheduled then
		return
	end
	stormScheduled = true
	local remaining = stormLastShow + STORM_INTERVAL - os.clock()
	if remaining <= 0.02 then
		showStormNumber()
	else
		task.delay(remaining, showStormNumber)
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------
local function onDamageTaken(amount, kind)
	amount = tonumber(amount) or 0
	if amount <= 0 then
		return
	end
	if type(kind) ~= "string" or not KIND_STYLE[kind] then
		kind = "Other"
	end
	local style = KIND_STYLE[kind]

	-- subtle: even the hardest hit only reaches a medium tint at the very edge
	local strength = Util.Clamp(amount / 30, 0.2, 1)
	local startT = Util.Lerp(0.82, 0.4, strength)
	local seconds = 0.45 + strength * 0.35
	if style.Soft then
		startT = 0.86
		seconds = 0.4
	end
	flashVignette(style.Vignette, startT, seconds)
	if style.Flash then
		flashScreen(0.78, 0.25)
	end
	addShake(style.Shake * Util.Clamp(0.5 + amount / 40, 0.5, 1.2))

	if kind == "Storm" then
		queueStormNumber(amount)
	else
		spawnDamageNumber(amount, kind)
	end
end

local function onMatchTokensChanged()
	local value = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	local delta = value - lastMatchTokens
	lastMatchTokens = value
	if delta > 0 then
		spawnTokenPop(math.floor(delta + 0.5))
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function DamageFx.Init()
	if initialized then
		return
	end
	initialized = true
	if not LocalPlayer then
		return
	end

	task.spawn(function()
		local ok, err = pcall(buildScreenGui)
		if not ok then
			warn("[DamageFx] vignette setup failed: " .. tostring(err))
		end
	end)

	-- Remotes.Get yields until the folder replicates, so never block Init on it
	task.spawn(function()
		local ok, remote = pcall(Remotes.Get, "DamageTaken")
		if not ok or not remote then
			warn("[DamageFx] DamageTaken remote unavailable: " .. tostring(remote))
			return
		end
		remote.OnClientEvent:Connect(function(amount, kind)
			local okFx, err = pcall(onDamageTaken, amount, kind)
			if not okFx then
				warn("[DamageFx] damage feedback failed: " .. tostring(err))
			end
		end)
	end)

	-- "+n <coin>" whenever the match token count goes up
	lastMatchTokens = tonumber(LocalPlayer:GetAttribute(ATTR.MatchTokens)) or 0
	LocalPlayer:GetAttributeChangedSignal(ATTR.MatchTokens):Connect(function()
		local ok, err = pcall(onMatchTokensChanged)
		if not ok then
			warn("[DamageFx] token pop failed: " .. tostring(err))
		end
	end)

	-- never leave the camera displaced across respawns
	LocalPlayer.CharacterRemoving:Connect(function()
		stopShake()
	end)
end

return DamageFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1133">
            <Properties>
              <string name="Name">DevController</string>
              <string name="Source"><![CDATA[-- DevController (client): the owner-only DEV button and its "Developer tools" side panel (Config.Dev; the server
-- half is server/Services/DevService.lua).
--
--   DevController.Init()
--   Extras (tests): DevController.Open(), DevController.Close(), DevController.IsOpen(), DevController.Relayout()
--   Phase 5 (7.2): chat "/menu" (owner only) -> DevController.OpenMainMenu(); DevController.OnChat(message) (tests)
--
-- Everything here only exists while the LocalPlayer's PlayerGui has the attribute NC_Dev = true (DevService sets it
-- for the game's owner, the Config.Dev.Admins and everyone testing in Studio; a PlayerGui only replicates to its own
-- player, so nobody else learns who the developers are). The attribute is watched; it is only a hint: the server
-- checks every command again. NC_DevTutorial = true (same place) shows "Restart tutorial": the server only sets it
-- when its TutorialService can restart a tutorial.
--
-- ScreenGui "NimbusDev" (display order 15, IgnoreGuiInset = false), built the first time NC_Dev turns true:
--   * DevTile: a chunky cloud tile in the menu tiles' style (glossy face, thick navy outline, big "DEV") with the
--     TextButton "DevButton", docked to the RIGHT edge. Its spot is MEASURED, never guessed: the lowest free place
--     on the right edge that touches none of the menu column, the HUD blocks (NimbusHud panels + its published
--     TopRight geometry), the battle HUD's visible blocks (NimbusBattle.Root: the action cluster, the team card, the
--     enemy list, the top card, LEAVE; bug #16), the hotbar, the tutorial panel, the touch RUN / DASH buttons and Roblox's jump button,
--     and stays out of the middle of the screen. On a PC that is the bottom-right corner; on phones and tablets it
--     sits just above the thumb buttons. The top of the side-toast column (NimbusNotify's ToastStack, measured;
--     room for its two newest toasts) is kept free too whenever the screen has room for that. Re-checked twice a
--     second and on every screen size change.
--   * DevPanel: a compact CloudUI panel docked to the right edge, never centred, titled "Developer tools":
--     "Give all pets", "+1M tokens" (Config.Dev.GrantTokens through Theme.Short), "Restart tutorial",
--     "Skip tutorial", "Next raid boss" (DevCommand "raid"), the pet showcase ("Evolve every pet" =
--     DevCommand("evolve", "all"), "Show all pets" / "Show evolved pets" / "Show Evolved II pets" =
--     DevCommand("pets", "0" | "1" | "2"), "Clear pet show" = DevCommand("clearpets"); client/Controllers/DevPetShow.lua
--     builds them), the tools on all my pets ("Evolve my pets" = DevCommand("evolvepets"); a number box and "Level all pets" =
--     DevCommand("levelall", n), junk in the box goes to the server, whose toast answers; "Max stats pets" =
--     DevCommand("maxpets"); "2x speed: off / on" = DevCommand("speed"), following the hint NC_DevSpeed), the list of everyone
--     in the server (a row "DevPlayer_<UserId>" per player, kept up to date; other players' rows have "Dev_kick_<UserId>" =
--     DevCommand("kick", name) and "Dev_ban_<UserId>" = DevCommand("ban", name), which asks "Are you sure?" like Reset), "Reset
--     my data" (the first tap turns it into "Are you sure?"; only a second, separate tap
--     0.6 to 4 s later sends it, so a double click never resets) and the note "Only you can see this". For the
--     first 0.4 s after it opens its buttons ignore taps (the rest of a double click on the tile lands there).
--     It takes a free stretch of the right edge below the toasts' room, so the toasts that answer its buttons
--     never cover it, preferring a stretch where it fits whole (see placePanel): while open it may lie over the
--     thumb buttons or HUD pieces (one tap closes it), never in the middle. Only a very short screen (a landscape
--     phone) has no such stretch: there the newest toasts may cover its top. When the stretch is short the
--     buttons scroll instead of shrinking the text. The tile hides while it is open.
--     Built on the first open, so a developer who never opens it only carries the small tile.
-- Input: mouse, touch and gamepad. Both are Selectable TextButtons (Activated covers click, tap and gamepad A);
-- opening the panel with a gamepad selects its first button; B (ContextActionService, only while open), Esc, the
-- red X and the tile close it.
-- Readability rule: designed in 1080p pixels under one UIScale of the screen factor clamp(viewportY / 1080,
-- 0.8, 1.25): buttons 22 px, title 28 px, note 18 px -> never below 14 px on a phone.
-- Remote out: DevCommand(command, arg). Plain Lua 5.1-compatible syntax only. Fonts only via Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))

local Client = script.Parent.Parent
local CloudUI = require(Client:WaitForChild("UI"):WaitForChild("CloudUI"))

local DevController = {}

----------------------------------------------------------------------
-- Tunables (design pixels of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	ATTR = "NC_Dev", -- PlayerGui attributes set by DevService
	ATTR_TUTORIAL = "NC_DevTutorial",
	ATTR_SPEED = "NC_DevSpeed",
	GUI_NAME = "NimbusDev",
	ORDER = 15, -- above the HUD (10), hotbar (11) and tutorial (12); below the menu windows (20) and toasts (30)
	EDGE = 12, -- KEEP IN SYNC with HudController.lua: EDGE and TOUCH_EDGE (screen px)
	TOUCH_EDGE = 20,
	GAP = 8, -- screen px kept free around every neighbour
	KEY_AIR = 8, -- (playtest 2026-11-28 C48: a Leave tap opened the DEV panel) screen px more off a thumb key or the run chip
	RIGHT_SHARE = 0.62, -- (C48 round 2) the tile sits on the right edge: its centre right of this share of the width
	CENTRE_TOL = 0.145, -- the middle of the screen: |dx| < 14.5% of the width and |dy| < 14.5% of the height
	SCAN_STEP = 4, -- screen px between two candidate spots of the tile
	TILE = 84, -- same size as a menu tile
	TILE_MIN_SHRINK = 0.75, -- bug #16: the tile may shrink this far to fit a short screen's gap (text 30 x 0.75 = 22 design px)
	TILE_TEXT = 30,
	PANEL_W = 340,
	TITLE_TEXT = 28,
	BUTTON_H = 50,
	BUTTON_TEXT = 22,
	NOTE_TEXT = 18,
	NOTE_H = 26,
	ROW_TEXT = 18, -- the player rows and the box (x 0.8 on a phone: 14.4 px)
	ROW_NAME_H = 26, -- a player row's name line, above its two buttons
	ROW_GAP = 8, -- between Kick and Ban, and between the box and its button
	BOX_W = 84,
	DEFAULT_LEVEL = "100",
	BOX_MAX_TEXT = 16, -- characters of a junk box sent to the server
	LIST_PAD = 10,
	LIST_GAP = 8,
	BUMPS = 30, -- room the panel's cloud bumps (and their outline) need above its top edge
	MIN_PANEL_H = 230, -- the shortest (scrolling) panel worth showing
	MIN_SCALE = 0.5, -- only for absurdly small windows
	POLL = 0.5, -- seconds between two layout checks
	CONFIRM_SECONDS = 4, -- an armed "Are you sure?" disarms itself after this many seconds
	CONFIRM_DELAY = 0.6, -- seconds the confirming tap must come after the first one (a double click never resets)
	OPEN_GUARD = 0.4, -- seconds after opening during which the panel's buttons ignore taps
	SEND_GAP = 0.35, -- seconds between two commands sent from this panel
	-- design px kept free at the top of the side-toast column: its two newest toasts (the answer to a DEV button
	-- of up to 3 lines and one more of up to 4). KEEP IN SYNC with NotifyController.lua's toast: 18 px text,
	-- 8 px padding above and below, TOAST_GAP 8
	TOAST_ROOM = 200,
	BACK_ACTION = "NimbusDevBack",
}

local BUTTONS = Theme.Buttons or {}
local Colors = Theme.Colors
local WHITE = Colors.White
local NAVY = Colors.Navy or Colors.Ink
local DEV_COLOR = Theme.Mix(Colors.Storm, BUTTONS.Blue or Color3.fromRGB(90, 158, 234), 0.3) -- slate blue

local LocalPlayer = nil
local initialized = false
local enabled = false
local panelOpen = false
local pollSerial = 0
local lastSend = -math.huge
local openedAt = -math.huge -- os.clock() of the last Open()
local warned = {}

local UI = {} -- Gui, Tile, TileScale, TileButton, TileFx, Panel, PanelRoot, PanelScale, List, Buttons = {}, PlayerList, Rows = {}
local Hint = { Gui = nil } -- the LocalPlayer's PlayerGui: DevService's NC_Dev / NC_DevTutorial live there
local Reset = { Until = 0, Serial = 0, ChangedAt = -math.huge, Text = "Reset my data" } -- ChangedAt: when it was last armed or sent
local Back = { Bound = false }
local applied = {} -- last values written by relayout (only changes are written)

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
local function warnOnce(key, err)
	if not warned[key] then
		warned[key] = true
		warn("[DevController] " .. tostring(key) .. ": " .. tostring(err))
	end
end

local function guard(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warnOnce(key, err)
	end
	return ok
end

local function devConfig()
	if type(Config.Dev) == "table" then
		return Config.Dev
	end
	return {}
end

local function isTouchDevice()
	return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function viewportSize()
	local camera = workspace.CurrentCamera
	local vp = camera and camera.ViewportSize or Vector2.new(1920, 1080)
	if vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

local function topInset()
	local inset = 0
	pcall(function()
		inset = GuiService:GetGuiInset().Y
	end)
	return inset
end

-- The area GUIs with IgnoreGuiInset = false are laid out in (below the top bar).
local function guiAreaSize()
	local size = UI.Gui and UI.Gui.AbsoluteSize
	if size and size.X >= 2 and size.Y >= 2 then
		return size
	end
	local vp = viewportSize()
	return Vector2.new(vp.X, math.max(2, vp.Y - topInset()))
end

local function usingGamepad()
	local ok, kind = pcall(function()
		return UserInputService:GetLastInputType()
	end)
	return ok and kind ~= nil and string.find(tostring(kind), "Gamepad", 1, true) ~= nil
end

local refreshTutorialButton -- defined with the panel (Building)

local function corner(parent, radius)
	return Util.Create("UICorner", { CornerRadius = UDim.new(0, radius), Parent = parent })
end

local function stroke(parent, color, thickness)
	return Util.Create("UIStroke", {
		Color = color,
		Thickness = thickness,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

local function plainFrame(parent, name, props)
	local frame = Util.Create("Frame", { Name = name, BackgroundTransparency = 1, BorderSizePixel = 0 })
	for key, value in pairs(props or {}) do
		frame[key] = value
	end
	frame.Parent = parent
	return frame
end

----------------------------------------------------------------------
-- Commands
----------------------------------------------------------------------
local function devRemote()
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild("DevCommand")
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

-- Fires DevCommand(command, arg). Returns true when it was sent (a quick double tap is dropped).
local function send(command, arg)
	local now = os.clock()
	if now - lastSend < K.SEND_GAP then
		return false
	end
	local remote = devRemote()
	if not remote then
		warnOnce("remote", "the DevCommand remote is missing")
		return false
	end
	lastSend = now
	remote:FireServer(command, arg)
	return true
end

local function grantTokens()
	local amount = tonumber(devConfig().GrantTokens)
	if not amount or amount ~= amount or amount < 1 then
		amount = 1000000
	end
	return math.floor(amount)
end

local function tokensLabel()
	local amount = grantTokens()
	local text = nil
	if type(Theme.Short) == "function" then
		local ok, short = pcall(Theme.Short, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " tokens"
end

-- Phase 2: test amounts of Cash and Gems (Config.Dev.GrantCash / GrantGems).
local function grantAmount(key, fallback)
	local amount = tonumber(devConfig()[key])
	if not amount or amount ~= amount or amount < 1 then
		amount = fallback
	end
	return math.floor(amount)
end

local function amountLabel(amount, word)
	local text = nil
	if type(Theme.Short) == "function" then
		local ok, short = pcall(Theme.Short, amount)
		if ok and type(short) == "string" then
			text = short
		end
	end
	return "+" .. (text or Util.Commas(amount)) .. " " .. word
end

local function disarm(confirm)
	confirm.Until = 0
	confirm.Serial = confirm.Serial + 1
	if confirm.Button then
		confirm.Button.Text = confirm.Text
	end
end

-- First tap arms the button ("Are you sure?"); a second tap sends the command when it comes CONFIRM_DELAY to
-- CONFIRM_SECONDS later. A tap sooner than CONFIRM_DELAY after arming (or after sending) is ignored and the button
-- stays as it is: a double click, however fast, can never wipe the data or ban anyone. fire() -> true when it was sent.
local function confirmPress(confirm, fire)
	local now = os.clock()
	if now - confirm.ChangedAt < K.CONFIRM_DELAY then
		return
	end
	if confirm.Until > now then
		if fire() then
			disarm(confirm)
			confirm.ChangedAt = now
		end
		return
	end
	confirm.Until = now + K.CONFIRM_SECONDS
	confirm.ChangedAt = now
	confirm.Serial = confirm.Serial + 1
	local serial = confirm.Serial
	confirm.Button.Text = "Are you sure?"
	task.delay(K.CONFIRM_SECONDS, function()
		if confirm.Serial == serial then
			disarm(confirm)
		end
	end)
end

local function speedLabel()
	return (Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR_SPEED) == true) and "2x speed: on" or "2x speed: off"
end

local function refreshSpeedButton()
	local button = UI.Buttons and UI.Buttons.speed
	if button then
		button.Text = speedLabel()
	end
end

-- The level box: a whole number, or its text as it is (the server refuses that with a toast).
local function levelFromBox()
	local text = string.match(UI.LevelBox.Text, "^%s*(.-)%s*$") or ""
	return tonumber(text) or string.sub(text, 1, K.BOX_MAX_TEXT)
end

-- A panel button's press, ignored for OPEN_GUARD seconds after the panel opened: the panel opens where the DEV
-- tile was, so the second click of a double click on the tile would otherwise land on one of its buttons.
local function panelPress(action)
	return function()
		if os.clock() - openedAt < K.OPEN_GUARD then
			return
		end
		action()
	end
end

----------------------------------------------------------------------
-- Building
----------------------------------------------------------------------
-- Glossy chunky face (same recipe as the menu tiles): light top, the colour, then a darker lip at the bottom.
local function tileSequence(c)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Theme.Lighten(c, 0.34)),
		ColorSequenceKeypoint.new(0.5, Theme.Lighten(c, 0.05)),
		ColorSequenceKeypoint.new(0.78, Theme.Darken(c, 0.08)),
		ColorSequenceKeypoint.new(0.8, Theme.Darken(c, 0.32)),
		ColorSequenceKeypoint.new(1, Theme.Darken(c, 0.4)),
	})
end

local function buildTile(gui)
	local tile = plainFrame(gui, "DevTile", {
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.TILE, K.TILE),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		ZIndex = 2,
	})
	UI.Tile = tile
	UI.TileScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = tile })

	local button = Util.Create("TextButton", {
		Name = "DevButton",
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Text = "",
		BackgroundColor3 = WHITE,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		Selectable = true,
		ZIndex = 3,
		Parent = tile,
	})
	UI.TileButton = button
	corner(button, 18)
	local outline = stroke(button, NAVY, 4)
	local face = Util.Create("UIGradient", { Rotation = 90, Color = tileSequence(DEV_COLOR), Parent = button })
	local gloss = plainFrame(button, "Gloss", {
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.72,
		Position = UDim2.fromOffset(8, 6),
		Size = UDim2.new(1, -16, 0.3, 0),
		ZIndex = 3,
	})
	corner(gloss, 10)
	-- two tiny pixel glints, like the menu tiles (a nod to the voxel world)
	for i, glint in ipairs({ { 10, 9, 6 }, { 18, 9, 4 } }) do
		plainFrame(button, "Glint" .. i, {
			BackgroundColor3 = WHITE,
			BackgroundTransparency = 0.15,
			Position = UDim2.fromOffset(glint[1], glint[2]),
			Size = UDim2.fromOffset(glint[3], glint[3]),
			ZIndex = 4,
		})
	end
	local label = Theme.Label("DEV", "Title", {
		Size = K.TILE_TEXT,
		Props = {
			Name = "Label",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.new(1, -8, 0, 36),
			ZIndex = 5,
		},
	})
	label.Parent = button

	-- hover / press feedback (same feel as the menu tiles)
	local fx = Util.Create("UIScale", { Name = "FxScale", Scale = 1, Parent = button })
	local state = { Hovering = false, Pressing = false }
	local function paint()
		local color = DEV_COLOR
		local scale = 1
		if state.Pressing then
			color = Theme.Darken(DEV_COLOR, 0.08)
			scale = 0.93
		elseif state.Hovering then
			color = Theme.Lighten(DEV_COLOR, 0.1)
			scale = 1.07
		end
		face.Color = tileSequence(color)
		outline.Color = NAVY
		Util.Tween(fx, 0.1, { Scale = scale })
	end
	button.MouseEnter:Connect(function()
		state.Hovering = true
		paint()
	end)
	button.MouseLeave:Connect(function()
		state.Hovering, state.Pressing = false, false
		paint()
	end)
	button.MouseButton1Down:Connect(function()
		state.Pressing = true
		paint()
	end)
	button.MouseButton1Up:Connect(function()
		state.Pressing = false
		paint()
	end)
	button.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch then
			state.Hovering, state.Pressing = false, false
			paint()
		end
	end)
	button.Activated:Connect(function()
		guard("open", DevController.Open)
	end)
	CloudUI.Tooltip(button, function()
		return "Developer tools (only you)"
	end)
end

-- Design height of the whole panel when nothing is cut off (count buttons + the player list).
local function fullPanelHeight(count)
	local top, _, bottom = CloudUI.ContentInset(true)
	local list = 2 * K.LIST_PAD + count * (K.BUTTON_H + K.LIST_GAP) + K.NOTE_H
	if UI.PlayerList then
		list = list + UI.PlayerList.Size.Y.Offset + K.LIST_GAP
	end
	return top + list + bottom
end

-- True when the server says "Restart tutorial" works in this build (NC_DevTutorial on our PlayerGui).
local function tutorialAvailable()
	return Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR_TUTORIAL) == true
end

-- Shows "Restart tutorial" only when it works, and sizes the panel for the buttons that are shown.
function refreshTutorialButton()
	local button = UI.Buttons and UI.Buttons.tutorial
	if not button then
		return -- the panel is not built yet: it asks again when it is
	end
	button.Visible = tutorialAvailable()
	local shown = 0
	for _, b in ipairs(UI.Buttons) do
		if b.Visible then
			shown = shown + 1
		end
	end
	UI.FullHeight = fullPanelHeight(shown)
	DevController.Relayout()
end

-- One row of the player list: the name, and for other players Kick and Ban (Ban asks "Are you sure?" first).
local function buildPlayerRow(player)
	local id = player.UserId
	local mine = player == LocalPlayer
	local row = plainFrame(UI.PlayerList, "DevPlayer_" .. id, {
		Size = UDim2.new(1, 0, 0, mine and K.ROW_NAME_H or (K.ROW_NAME_H + K.BUTTON_H)),
	})
	local label = Theme.Label(mine and (player.DisplayName .. " (you)") or (player.DisplayName .. " (@" .. player.Name .. ")"), "Label", {
		Size = K.ROW_TEXT,
		Props = {
			Name = "PlayerName",
			Size = UDim2.new(1, 0, 0, K.ROW_NAME_H),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 6,
		},
	})
	label.Parent = row
	local entry = { Row = row, Confirm = nil }
	if not mine then
		local target = tostring(player.UserId) -- the server finds exactly this player, or nobody once they left
		local half = UDim2.new(0.5, -K.ROW_GAP / 2, 0, K.BUTTON_H)
		local kick = CloudUI.Button({
			Name = "Dev_kick_" .. id,
			Text = "Kick",
			Style = "Gold",
			Size = half,
			Position = UDim2.fromOffset(0, K.ROW_NAME_H),
			TextSize = K.ROW_TEXT,
			ZIndex = 6,
			Callback = panelPress(function()
				send("kick", target)
			end),
			Parent = row,
		})
		kick.Selectable = true
		local confirm = { Until = 0, Serial = 0, ChangedAt = -math.huge, Text = "Ban" }
		local ban = CloudUI.Button({
			Name = "Dev_ban_" .. id,
			Text = confirm.Text,
			Style = "Red",
			Size = half,
			Position = UDim2.new(0.5, K.ROW_GAP / 2, 0, K.ROW_NAME_H),
			TextSize = K.ROW_TEXT,
			ZIndex = 6,
			Callback = panelPress(function()
				guard("ban", confirmPress, confirm, function()
					return send("ban", target)
				end)
			end),
			Parent = row,
		})
		ban.Selectable = true
		confirm.Button = ban
		entry.Confirm = confirm
	end
	return entry
end

-- The list follows the server: a row per player, sorted by name; the panel's height follows the list.
local function refreshPlayerList(leaving)
	local holder = UI.PlayerList
	if not holder then
		return
	end
	local present = {}
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= leaving then
			present[player.UserId] = true
			list[#list + 1] = player
		end
	end
	for id, entry in pairs(UI.Rows) do
		if not present[id] then
			entry.Row:Destroy()
			UI.Rows[id] = nil
		end
	end
	table.sort(list, function(a, b)
		return string.lower(a.Name) < string.lower(b.Name)
	end)
	local height = K.NOTE_H
	for index, player in ipairs(list) do
		local entry = UI.Rows[player.UserId]
		if not entry then
			entry = buildPlayerRow(player)
			UI.Rows[player.UserId] = entry
		end
		entry.Row.LayoutOrder = index + 1
		height = height + K.LIST_GAP + entry.Row.Size.Y.Offset
	end
	holder.Size = UDim2.new(1, 0, 0, height)
	refreshTutorialButton()
end

local function buildPlayerSection(parent, order)
	local holder = plainFrame(parent, "DevPlayers", { Size = UDim2.new(1, 0, 0, K.NOTE_H), LayoutOrder = order })
	UI.PlayerList = holder
	UI.Rows = {}
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, K.LIST_GAP),
		Parent = holder,
	})
	local title = Theme.Label("Players in this server", "Label", {
		Size = K.ROW_TEXT,
		Props = {
			Name = "PlayersTitle",
			Size = UDim2.new(1, 0, 0, K.NOTE_H),
			LayoutOrder = 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 6,
		},
	})
	title.Parent = holder
	if not UI.PlayersHooked then
		UI.PlayersHooked = true
		Players.PlayerAdded:Connect(function()
			guard("players", refreshPlayerList)
		end)
		Players.PlayerRemoving:Connect(function(player)
			guard("players", refreshPlayerList, player)
		end)
	end
end

-- The number box and "Level all pets" side by side, one button's height.
local function buildLevelRow(parent, order, callback)
	local row = plainFrame(parent, "Dev_levelrow", { Size = UDim2.new(1, 0, 0, K.BUTTON_H), LayoutOrder = order })
	local box = Util.Create("TextBox", {
		Name = "Dev_levelbox",
		Text = K.DEFAULT_LEVEL,
		PlaceholderText = "1-100",
		ClearTextOnFocus = false,
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		TextColor3 = NAVY,
		Size = UDim2.new(0, K.BOX_W, 1, 0),
		Selectable = true,
		ZIndex = 6,
		Parent = row,
	})
	Theme.Style(box, "Button", { Size = K.BUTTON_TEXT })
	box.TextColor3 = NAVY
	corner(box, 10)
	stroke(box, NAVY, 2)
	UI.LevelBox = box
	return CloudUI.Button({
		Name = "Dev_levelall",
		Text = "Level all pets",
		Style = "Green",
		Size = UDim2.new(1, -(K.BOX_W + K.ROW_GAP), 1, 0),
		Position = UDim2.fromOffset(K.BOX_W + K.ROW_GAP, 0),
		TextSize = K.ROW_TEXT,
		ZIndex = 6,
		Callback = callback,
		Parent = row,
	})
end

local function buildPanel(gui)
	local specs = {
		{ Id = "allpets", Text = "Give all pets", Style = "Green" },
		{ Id = "tokens", Text = tokensLabel(), Style = "Gold" },
		{ Id = "cash", Text = amountLabel(grantAmount("GrantCash", 1000000), "Cash"), Style = "Green" },
		{ Id = "gems", Text = amountLabel(grantAmount("GrantGems", 1000), "Gems"), Style = "Blue" },
		{ Id = "tutorial", Text = "Restart tutorial", Style = "Blue" },
		{ Id = "skiptutorial", Text = "Skip tutorial", Style = "Pink" },
		{ Id = "raid", Text = "Next raid boss", Style = "Gold" }, -- boss raids: DevCommand("raid") brings the next boss (now, or when the fights end)
		-- the pet showcase (DevService: evolve / pets / clearpets)
		{ Id = "evolveall", Text = "Evolve every pet", Style = "Gold", Command = "evolve", Arg = "all" },
		{ Id = "pets0", Text = "Show all pets", Style = "Blue", Command = "pets", Arg = "0" },
		{ Id = "pets1", Text = "Show evolved pets", Style = "Blue", Command = "pets", Arg = "1" },
		{ Id = "pets2", Text = "Show Evolved II pets", Style = "Blue", Command = "pets", Arg = "2" },
		{ Id = "clearpets", Text = "Clear pet show", Style = "Gray", Command = "clearpets" },
		-- the tools on all my pets, saved (DevService: evolvepets / levelall / maxpets), and 2x speed
		{ Id = "evolvepets", Text = "Evolve my pets", Style = "Green" },
		{ Id = "levelall", Text = "Level all pets", Style = "Green" },
		{ Id = "maxpets", Text = "Max stats pets", Style = "Gold" },
		{ Id = "speed", Text = speedLabel(), Style = "Blue" },
		{ Id = "players" },
		{ Id = "reset", Text = "Reset my data", Style = "Red" },
	}
	UI.FullHeight = fullPanelHeight(#specs)
	local panel = CloudUI.Panel({
		Name = "DevPanel",
		Title = "Developer tools",
		TitleSize = K.TITLE_TEXT,
		Closable = true,
		OnClose = function()
			DevController.Close()
		end,
		Accent = DEV_COLOR,
		AnchorPoint = Vector2.new(1, 1),
		Size = UDim2.fromOffset(K.PANEL_W, UI.FullHeight),
		Position = UDim2.new(1, -K.EDGE, 1, -K.EDGE),
		Parent = gui,
	})
	UI.Panel = panel
	UI.PanelRoot = panel.Root
	UI.PanelRoot.Visible = false
	UI.PanelScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = panel.Root })

	local list = Util.Create("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = WHITE,
		ZIndex = 5,
		Parent = panel.Content,
	})
	UI.List = list
	Util.Create("UIPadding", {
		PaddingTop = UDim.new(0, K.LIST_PAD),
		PaddingBottom = UDim.new(0, K.LIST_PAD),
		PaddingLeft = UDim.new(0, K.LIST_PAD),
		PaddingRight = UDim.new(0, K.LIST_PAD + 4),
		Parent = list,
	})
	Util.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Vertical,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, K.LIST_GAP),
		Parent = list,
	})

	UI.Buttons = {}
	local buttonCount = 0
	local function makeButton(index, spec, callback)
		local id = spec.Id
		local button
		if id == "levelall" then
			button = buildLevelRow(list, index, callback)
		else
			button = CloudUI.Button({
				Name = "Dev_" .. id,
				Text = spec.Text,
				Style = spec.Style,
				Size = UDim2.new(1, 0, 0, K.BUTTON_H),
				TextSize = K.BUTTON_TEXT,
				LayoutOrder = index,
				ZIndex = 6,
				Callback = callback,
				Parent = list,
			})
		end
		button.Selectable = true
		buttonCount = buttonCount + 1
		UI.Buttons[id] = button
		UI.Buttons[buttonCount] = button
		if id == "reset" then
			Reset.Button = button
		end
	end
	for index, spec in ipairs(specs) do
		local id = spec.Id
		local callback
		if id == "reset" then
			callback = panelPress(function()
				guard("reset", confirmPress, Reset, function()
					return send("reset")
				end)
			end)
		elseif id == "levelall" then
			callback = panelPress(function()
				send("levelall", levelFromBox())
			end)
		elseif id == "tokens" then
			callback = panelPress(function()
				send("tokens", grantTokens())
			end)
		elseif id == "cash" then
			callback = panelPress(function()
				send("cash", grantAmount("GrantCash", 1000000))
			end)
		elseif id == "gems" then
			callback = panelPress(function()
				send("gems", grantAmount("GrantGems", 1000))
			end)
		elseif spec.Command then
			callback = panelPress(function()
				send(spec.Command, spec.Arg)
			end)
		else
			callback = panelPress(function()
				send(id)
			end)
		end
		if id == "players" then
			buildPlayerSection(list, index)
		else
			makeButton(index, spec, callback)
		end
	end
	local note = Theme.Label("Only you can see this", "Label", {
		Size = K.NOTE_TEXT,
		Color = Colors.Muted or WHITE,
		Props = {
			Name = "Note",
			Size = UDim2.new(1, 0, 0, K.NOTE_H),
			LayoutOrder = #specs + 1,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 6,
		},
	})
	note.Parent = list
	refreshPlayerList()
end

local function build()
	if UI.Gui and UI.Gui.Parent then
		return
	end
	local gui = CloudUI.NewScreenGui(K.GUI_NAME, K.ORDER)
	gui.Enabled = false
	UI.Gui = gui
	applied = {}
	UI.PanelRoot = nil -- the panel is built on first open (a developer who never opens it only pays for the tile)
	buildTile(gui)
	gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		guard("relayout", DevController.Relayout)
	end)
end

----------------------------------------------------------------------
-- Layout: measured neighbours (all rectangles in our gui-area pixels)
----------------------------------------------------------------------
local function playerGui()
	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
end

-- y offset that converts a gui's AbsolutePosition into our gui-area coordinates
local function insetShift(gui)
	if gui and gui:IsA("ScreenGui") and gui.IgnoreGuiInset then
		return -topInset()
	end
	return 0
end

local function shownIn(inst, root)
	local node = inst
	while node and node ~= root do
		if node:IsA("GuiObject") and not node.Visible then
			return false
		end
		node = node.Parent
	end
	return true
end

local function addRect(list, inst, root, dy, pad)
	if not (inst and inst:IsA("GuiObject")) then
		return
	end
	local p, s = inst.AbsolutePosition, inst.AbsoluteSize
	if s.X <= 0 or s.Y <= 0 or not shownIn(inst, root) then
		return
	end
	local e = tonumber(pad) or 0 -- (playtest 2026-11-28 C48) a thumb key's extra air (K.KEY_AIR)
	list[#list + 1] = { x0 = p.X - e, y0 = p.Y + dy - e, x1 = p.X + s.X + e, y1 = p.Y + s.Y + dy + e }
end

local function enabledGui(pg, name)
	local gui = pg:FindFirstChild(name)
	if gui and gui:IsA("ScreenGui") and gui.Enabled then
		return gui
	end
	return nil
end

-- The side toasts (NimbusNotify, drawn above us): the measured left / right edges and top of the toast column,
-- reserved TOAST_ROOM design px down, so its newest toasts (the answers to the panel's buttons) stay readable.
-- nil when there is no toast column.
local function toastRoom(pg, factor)
	local notify = enabledGui(pg, "NimbusNotify")
	local stack = notify and notify:FindFirstChild("ToastStack", true)
	if not (stack and stack:IsA("GuiObject")) or stack.AbsoluteSize.X <= 0 then
		return nil
	end
	local p, s = stack.AbsolutePosition, stack.AbsoluteSize
	local top = p.Y + insetShift(notify)
	return { x0 = p.X, y0 = top, x1 = p.X + s.X, y1 = top + K.TOAST_ROOM * factor }
end

-- What the DEV tile and panel keep clear of (gui-area rectangles):
--   Others          the menu column, HUD blocks, hotbar, tutorial panel, touch buttons (the tile never touches them)
--   Toasts          the toast column's room, or nil
--   TopRightBottom  the bottom of the HUD's top-right block (0 if none), TopRightLeft its left edge
local function neighbours(area, factor)
	local out = {}
	local layout = { Others = out, Toasts = nil, TopRightBottom = 0, TopRightLeft = area.X }
	local pg = playerGui()
	if not pg then
		return layout
	end
	layout.Toasts = toastRoom(pg, factor)
	local menu = enabledGui(pg, "NimbusMenu")
	if menu then
		addRect(out, menu:FindFirstChild("MenuColumn"), menu, insetShift(menu))
	end
	local hud = enabledGui(pg, "NimbusHud")
	if hud then
		local dy = insetShift(hud)
		for _, holder in ipairs(hud:GetChildren()) do
			if holder:IsA("GuiObject") and holder.Visible then
				for _, panel in ipairs(holder:GetChildren()) do
					addRect(out, panel, hud, dy)
				end
			end
		end
		local trb = tonumber(hud:GetAttribute("TopRightBottom")) or 0
		if trb > 0 then
			layout.TopRightBottom = trb
			layout.TopRightLeft = tonumber(hud:GetAttribute("TopRightLeft")) or 0
			out[#out + 1] = { x0 = layout.TopRightLeft, y0 = 0, x1 = area.X, y1 = trb }
		end
	end
	-- bug #16: the battle HUD (BattleController's NimbusBattle): every visible top-level block of its Root (the action
	-- cluster Commands, Team, Enemies, TopCard, LEAVE, ...), so the tile never sits on the ATTACK button; plus the
	-- cluster's own buttons (on a phone the Commands frame is a small anchor and its buttons sit outside it)
	local battle = enabledGui(pg, "NimbusBattle")
	if battle then
		local root = battle:FindFirstChild("Root")
		local dy = insetShift(battle)
		for _, block in ipairs(root and root:GetChildren() or {}) do
			if block:IsA("GuiObject") and block.Visible then
				addRect(out, block, battle, dy)
				if block.Name == "Commands" then
					for _, b in ipairs(block:GetChildren()) do
						if b:IsA("GuiObject") then
							addRect(out, b, battle, dy, K.KEY_AIR) -- (C48: a thumb key)
						end
					end
				end
			end
		end
	end
	-- (playtest 2026-11-28 C48: at 667 x 375 the tile lay on the dungeon run chip's Leave, and a Leave tap opened the DEV
	-- panel) the dungeon run's chip and cards (DungeonController's NimbusDungeonRun: RunChip, RunCard, EndCard)
	local run = enabledGui(pg, "NimbusDungeonRun")
	if run then
		local dy = insetShift(run)
		for _, block in ipairs(run:GetChildren()) do
			if block:IsA("GuiObject") and block.Visible then
				addRect(out, block, run, dy, K.KEY_AIR)
			end
		end
	end
	local hotbar = enabledGui(pg, "NimbusHotbar")
	if hotbar then
		addRect(out, hotbar:FindFirstChild("Hotbar"), hotbar, insetShift(hotbar))
	end
	local tutorial = enabledGui(pg, "NimbusTutorial")
	if tutorial then
		addRect(out, tutorial:FindFirstChild("TutorialPanel"), tutorial, insetShift(tutorial))
	end
	-- touch RUN / DASH (MovementController)
	local mobile = enabledGui(pg, "MobileControls")
	if mobile then
		local dy = insetShift(mobile)
		for _, d in ipairs(mobile:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("ImageButton") then
				addRect(out, d, mobile, dy, K.KEY_AIR)
			end
		end
	end
	-- Roblox's own jump button; when it cannot be measured, the footprint MovementController assumes
	-- (KEEP IN SYNC with MovementController.lua layoutMobileControls)
	local measured = false
	local touchGui = enabledGui(pg, "TouchGui")
	if touchGui then
		local jump = touchGui:FindFirstChild("JumpButton", true)
		if jump then
			local before = #out
			addRect(out, jump, touchGui, insetShift(touchGui))
			measured = #out > before
		end
	end
	if not measured and isTouchDevice() then
		local vp = viewportSize()
		local small = math.min(vp.X, vp.Y) <= 500
		local size = small and 70 or 120
		local bottom = small and 20 or size * 0.75
		local dy = area.Y - vp.Y -- screen -> gui area (minus the top bar)
		out[#out + 1] = {
			x0 = vp.X - (size * 1.5 + 10),
			y0 = vp.Y - bottom - size + dy,
			x1 = vp.X - (size * 0.5 + 10),
			y1 = vp.Y - bottom + dy,
		}
	end
	return layout
end

-- A new list with the rectangles of `a` and `b` (either may be a list, one rectangle or nil).
local function joined(a, b)
	local out = {}
	for _, part in ipairs({ a or {}, b or {} }) do
		if part.x0 then
			out[#out + 1] = part
		else
			for _, r in ipairs(part) do
				out[#out + 1] = r
			end
		end
	end
	return out
end

-- The middle of the screen the game never writes into (same band as the HUD), in gui-area pixels.
local function centreBand(area)
	local vp = viewportSize()
	local inset = math.max(0, vp.Y - area.Y)
	local tol = K.CENTRE_TOL
	return {
		x0 = vp.X * (0.5 - tol),
		x1 = vp.X * (0.5 + tol),
		y0 = vp.Y * (0.5 - tol) - inset,
		y1 = vp.Y * (0.5 + tol) - inset,
	}
end

local function touches(a, b, gap)
	return a.x0 < b.x1 + gap and a.x1 > b.x0 - gap and a.y0 < b.y1 + gap and a.y1 > b.y0 - gap
end

-- Bottom edge (gui px) of the lowest spot for a size x size tile at the right edge `right` that touches no
-- blocker and stays out of the band; nil when there is none. `precise`: a blocked candidate jumps to just above
-- the blocker it touches (no SCAN_STEP grid), so a narrow gap that just fits the tile is found.
local function lowestFreeSpot(area, side, right, size, blockers, band, precise)
	local y1 = area.Y - side
	while y1 - size >= side do
		local rect = { x0 = right - size, y0 = y1 - size, x1 = right, y1 = y1 }
		local free = not touches(rect, band, 0)
		local nextY = y1 - K.SCAN_STEP
		if free then
			for _, r in ipairs(blockers) do
				if touches(rect, r, K.GAP) then
					free = false
					if precise then
						nextY = math.min(y1 - 0.5, r.y0 - K.GAP - 0.01)
					end
					break
				end
			end
		elseif precise then
			nextY = y1 - 1
		end
		if free then
			return y1
		end
		y1 = nextY
	end
	return nil
end

-- Bottom-right corner (gui px) of the tile and its size share: the lowest free spot on the right edge, clear of
-- the toasts' room too when the screen has space for that (a short phone screen has not: then only toasts may
-- touch it). Bug #16: a short landscape phone in a battle (the enemy list above, the thumb buttons below) may have
-- no full-size stretch left on the right edge: the tile then shrinks (down to TILE_MIN_SHRINK, its text stays
-- readable) into the biggest gap rather than covering the battle HUD.
local function placeTile(area, side, size, layout, band)
	local right = area.X - side
	for _, blockers in ipairs({ joined(layout.Others, layout.Toasts), layout.Others }) do
		local y1 = lowestFreeSpot(area, side, right, size, blockers, band)
		if y1 then
			return right, y1, 1
		end
	end
	local shrink = 1
	while shrink > K.TILE_MIN_SHRINK + 1e-9 do
		shrink = math.max(K.TILE_MIN_SHRINK, shrink - 0.05)
		for _, blockers in ipairs({ joined(layout.Others, layout.Toasts), layout.Others }) do
			local y1 = lowestFreeSpot(area, side, right, size * shrink, blockers, band, true)
			if y1 then
				return right, y1, shrink
			end
		end
	end
	-- (playtest 2026-11-28 C48: at 667 x 375 the right edge had no gap even for the shrunk tile, so it went to the top-right
	-- corner over the currency strips, the gift and the run chip) the same search in columns further left (a quarter tile
	-- apart, the right half of the screen, never into the centre band)
	-- (C48 round 2: in a 640 x 360 dungeon run the search reached x 360 .. 428, its centre left of the right-edge rule) the
	-- tile's centre stays right of K.RIGHT_SHARE of the width; the column at that limit is tried last
	local step = math.max(K.SCAN_STEP, math.floor(size / 4))
	local function limit(shrink) -- the right edge that puts the tile's centre at the rule's line (whole px, past it)
		return math.ceil(area.X * K.RIGHT_SHARE + size * shrink / 2 + 0.5)
	end
	local last = limit(K.TILE_MIN_SHRINK)
	local columns = {}
	for x = right - step, last + 1, -step do
		columns[#columns + 1] = x
	end
	columns[#columns + 1] = limit(1)
	columns[#columns + 1] = last
	for _, x in ipairs(columns) do
		for _, shrink in ipairs({ 1, K.TILE_MIN_SHRINK }) do
			if x < right and x >= limit(shrink) then
				local y1 = lowestFreeSpot(area, side, x, size * shrink, layout.Others, band, true)
				if y1 then
					return x, y1, shrink
				end
			end
		end
	end
	-- no free spot at all (a tiny window): the top-right corner
	return right, math.min(area.Y - side, side + size), 1
end

-- Free vertical stretches [y0, y1] of the column [x0, x1] between top and bottom. `headroom` is kept free below
-- every blocker as well (the panel's cloud bumps stick out above its top edge).
local function freeStretches(x0, x1, top, bottom, blockers, headroom)
	local spans = {}
	for _, r in ipairs(blockers) do
		if r.x0 < x1 + K.GAP and r.x1 > x0 - K.GAP and r.y1 + K.GAP > top and r.y0 - K.GAP < bottom then
			spans[#spans + 1] = { r.y0 - K.GAP, r.y1 + K.GAP + headroom }
		end
	end
	table.sort(spans, function(a, b)
		return a[1] < b[1]
	end)
	local out = {}
	local cursor = top
	for _, span in ipairs(spans) do
		if span[1] > cursor then
			out[#out + 1] = { cursor, math.min(span[1], bottom) }
		end
		cursor = math.max(cursor, span[2])
	end
	if cursor < bottom then
		out[#out + 1] = { cursor, bottom }
	end
	return out
end

-- The tallest free stretch (the lower one on a tie); nil when none is at least minH tall.
local function bestStretch(stretches, minH)
	local best = nil
	for _, s in ipairs(stretches) do
		local h = s[2] - s[1]
		if h >= minH and (best == nil or h >= best[2] - best[1]) then
			best = s
		end
	end
	return best
end

-- Bottom-right corner, design height and scale of the open panel. While it is open the panel is what the
-- developer uses, so it should be whole and uncovered: it may then lie over the thumb buttons or HUD pieces (one
-- tap closes it), but never over the toasts' room or in the middle of the screen. Tried in this order:
--   1. clear of everything, full height        2. clear of the toasts' room and the middle, full height
--   3. clear of everything, scrolling           4. clear of the toasts' room and the middle, scrolling
--   5. out of the middle only (a very short screen: the newest toasts may cover its top)
local function placePanel(area, side, factor, layout, band)
	local scale = math.max(K.MIN_SCALE, math.min(factor, (area.X - 2 * side) / K.PANEL_W))
	local right = area.X - side
	local left = right - K.PANEL_W * scale
	local bumps = K.BUMPS * scale
	local top = side
	if layout.TopRightBottom > 0 and layout.TopRightLeft < right then
		top = math.max(top, layout.TopRightBottom + K.GAP) -- the HUD's top-right block always stays visible
	end
	top = top + bumps
	local bottom = area.Y - side
	local fullH = (UI.FullHeight or 400) * scale
	local minH = math.min(K.MIN_PANEL_H * scale, bottom - top)
	local bandBlock = nil
	if left < band.x1 and right > band.x0 then
		bandBlock = { x0 = left, x1 = right, y0 = band.y0 + K.GAP, y1 = band.y1 - K.GAP }
	end
	local everything = joined(joined(layout.Others, layout.Toasts), bandBlock)
	local toastsAndMiddle = joined(layout.Toasts, bandBlock)
	local tries = {
		{ everything, fullH },
		{ toastsAndMiddle, fullH },
		{ everything, minH },
		{ toastsAndMiddle, minH },
		{ joined(bandBlock, nil), minH },
	}
	local stretch = nil
	for _, try in ipairs(tries) do
		stretch = bestStretch(freeStretches(left, right, top, bottom, try[1], bumps), try[2])
		if stretch then
			break
		end
	end
	stretch = stretch or { top, bottom }
	local height = math.min(UI.FullHeight or 400, (stretch[2] - stretch[1]) / scale)
	return right, stretch[2], height, scale
end

local function setIfChanged(key, inst, prop, value)
	if applied[key] ~= value then
		applied[key] = value
		inst[prop] = value
	end
end

function DevController.Relayout()
	if not UI.Gui or not enabled then
		return
	end
	local area = guiAreaSize()
	local factor = Theme.ScreenFactor(viewportSize().Y)
	local side = isTouchDevice() and K.TOUCH_EDGE or K.EDGE
	local layout = neighbours(area, factor)
	local band = centreBand(area)
	local tx, ty, shrink = placeTile(area, side, K.TILE * factor, layout, band)
	setIfChanged("tileScale", UI.TileScale, "Scale", factor * shrink)
	setIfChanged("tilePos", UI.Tile, "Position", UDim2.fromOffset(math.floor(tx + 0.5), math.floor(ty + 0.5)))
	if panelOpen then
		local px, py, height, scale = placePanel(area, side, factor, layout, band)
		setIfChanged("panelScale", UI.PanelScale, "Scale", scale)
		setIfChanged("panelSize", UI.PanelRoot, "Size", UDim2.fromOffset(K.PANEL_W, math.floor(height)))
		setIfChanged("panelPos", UI.PanelRoot, "Position", UDim2.fromOffset(math.floor(px + 0.5), math.floor(py + 0.5)))
	end
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
local function onBackAction(_name, inputState)
	if inputState == Enum.UserInputState.Begin and panelOpen then
		DevController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

local function bindBack(on)
	if on == Back.Bound then
		return
	end
	Back.Bound = on
	if on then
		guard("bind back", function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, onBackAction, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

local function selectionInside(root)
	local selected = GuiService.SelectedObject
	return selected ~= nil and root ~= nil and selected:IsDescendantOf(root)
end

function DevController.IsOpen()
	return panelOpen
end

function DevController.Open()
	if not enabled or not UI.Gui then
		return false
	end
	if panelOpen then
		DevController.Close()
		return false
	end
	if not (UI.PanelRoot and UI.PanelRoot.Parent) then
		if not guard("build panel", buildPanel, UI.Gui) then
			return false
		end
	end
	-- (kit B U5) a main menu window (Settings / Updates / Credits) sits above this gui: it closes, so the panel's lower rows
	-- (Restart / Skip tutorial) never peek out from under it (opening one of those windows closes the panel the same way)
	local mmcModule = script.Parent:FindFirstChild("MainMenuController")
	local okMenu, mmc = pcall(function()
		return mmcModule and require(mmcModule)
	end)
	if okMenu and type(mmc) == "table" and type(mmc.Window) == "function" and mmc.Window() ~= nil then
		guard("menu window", mmc.CloseWindows)
	end
	panelOpen = true
	openedAt = os.clock()
	disarm(Reset)
	UI.PanelRoot.Visible = true
	UI.Tile.Visible = false
	DevController.Relayout()
	bindBack(true)
	if usingGamepad() and UI.Buttons[1] then
		pcall(function()
			GuiService.SelectedObject = UI.Buttons[1]
		end)
	end
	return true
end

function DevController.Close()
	if not panelOpen then
		return
	end
	panelOpen = false
	disarm(Reset)
	for _, entry in pairs(UI.Rows or {}) do
		if entry.Confirm then
			disarm(entry.Confirm)
		end
	end
	local hadSelection = selectionInside(UI.PanelRoot)
	if UI.PanelRoot then
		UI.PanelRoot.Visible = false
	end
	if UI.Tile then
		UI.Tile.Visible = enabled
	end
	bindBack(false)
	if hadSelection then
		pcall(function()
			GuiService.SelectedObject = (enabled and usingGamepad()) and UI.TileButton or nil
		end)
	end
	DevController.Relayout()
end

----------------------------------------------------------------------
-- NC_Dev on / off
----------------------------------------------------------------------
local function startPolling()
	pollSerial = pollSerial + 1
	local serial = pollSerial
	task.spawn(function()
		while enabled and serial == pollSerial do
			guard("relayout", DevController.Relayout)
			task.wait(K.POLL)
		end
	end)
end

local function setEnabled(on)
	if on == enabled then
		return
	end
	if on then
		if not guard("build", build) then
			return
		end
		enabled = true
		UI.Gui.Enabled = true
		UI.Tile.Visible = not panelOpen
		applied = {}
		startPolling()
	else
		DevController.Close()
		enabled = false
		pollSerial = pollSerial + 1
		if UI.Gui then
			UI.Gui.Enabled = false
		end
	end
end

local function refreshFlag()
	setEnabled(Hint.Gui ~= nil and Hint.Gui:GetAttribute(K.ATTR) == true)
end

-- Follows DevService's hints on our PlayerGui (never on the Player: that one every client can read).
local function watchHints()
	local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 60)
	if not pg then
		return
	end
	Hint.Gui = pg
	pg:GetAttributeChangedSignal(K.ATTR):Connect(function()
		guard("NC_Dev", refreshFlag)
	end)
	pg:GetAttributeChangedSignal(K.ATTR_TUTORIAL):Connect(function()
		guard("NC_DevTutorial", refreshTutorialButton)
	end)
	pg:GetAttributeChangedSignal(K.ATTR_SPEED):Connect(function()
		guard("NC_DevSpeed", refreshSpeedButton)
	end)
	guard("NC_Dev", refreshFlag)
end

-- Phase 5 (7.2): the owner shortcut /menu reopens the main menu (MainMenuController.Open: client-side only, the
-- character stays and MenuPlay is never sent again). Only while NC_Dev is set; DevService ignores the word.
function DevController.OpenMainMenu()
	local module = script.Parent:FindFirstChild("MainMenuController")
	local ok, menu = pcall(function()
		return module and require(module)
	end)
	if ok and type(menu) == "table" and type(menu.Open) == "function" then
		guard("menu", menu.Open)
		return true
	end
	return false
end

function DevController.OnChat(message)
	if type(message) ~= "string" or #message > 40 or not string.match(string.lower(message), "^%s*/menu%s*$") then
		return false
	end
	if not (Hint.Gui and Hint.Gui:GetAttribute(K.ATTR) == true) then
		return false
	end
	return DevController.OpenMainMenu()
end

local function watchChat()
	LocalPlayer.Chatted:Connect(DevController.OnChat)
	pcall(function()
		local chat = game:GetService("TextChatService")
		chat.SendingMessage:Connect(function(msg)
			DevController.OnChat(msg and msg.Text)
		end)
	end)
end

function DevController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	if not LocalPlayer then
		return
	end
	UserInputService.InputBegan:Connect(function(input)
		if panelOpen and input.KeyCode == Enum.KeyCode.Escape then
			DevController.Close()
		end
	end)
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
			guard("relayout", DevController.Relayout)
		end)
	end
	task.spawn(watchHints)
	pcall(watchChat)
end

return DevController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1134">
            <Properties>
              <string name="Name">DevPetShow</string>
              <string name="Source"><![CDATA[-- DevPetShow (client): the developer's pet showcase. The server half is DevService ("/pet", "/pets", "/evolve", "/fx",
-- "/clearpets"): it checks the permission and sends DevPetShow(action, payload) to the developer's own client.
--
--   DevPetShow.Init()
--   Extras (tests): DevPetShow.Handle(action, payload) (what the remote does), DevPetShow.Count() -> showcase pets
--                   in the world, DevPetShow.Busy() -> a lineup is being built or an evolution is playing,
--                   DevPetShow.Folder() -> the workspace folder (nil before the first pet)
--
-- The pets are built here with PetBuilder at Scale 1 (the size they have in the game) into the workspace folder
-- "DevPetShow": only this player sees them, and the server never has to replicate thousands of parts.
--   Spawn {PetId, Stage}    the pet at stage 0 (normal), 1 (evolved) or 2 (second evolution) in front of the player,
--                           facing them and hovering over the ground, beside the ones already there (they stay
--                           until Clear; the oldest goes past MAX_PETS)
--   Lineup {Stage, PetIds}  clears, builds every listed pet (one per frame) and stands them in rows in front of the
--                           player, all facing the same way; Low detail when the lineup would pass LINEUP_PARTS parts
--   Evolve {Steps}          clears, then plays the evolution animations (client/Controllers/EvolutionFx.lua) one
--                           after another in front of the player; Steps = { {PetId, From, To}, ... } with To = From + 1.
--                           A pet's line carries on with the evolved pet (normal -> evolved -> evolved II); after a
--                           short pause the next pet of a reel takes its place. The last one stays.
--   Fx {Element, Attack, Kind, Shape, Rarity, Stage}   the pet attack VFX preview (plan
--                           docs/superpowers/plans/2026-10-23-pet-attack-vfx.md Task 7): clears, then a caster pet (the
--                           catalog pet of that first element, of that rarity / special kind when there is one; else
--                           any pet of the element: the effect keeps the asked rarity) and a dummy target (a Common pet
--                           of another element) FX_APART (10) studs apart across the view in front of the player, facing
--                           each other; client/Controllers/AttackFx plays the attack (Mine = true: full density) and a
--                           short-lived RenderStepped drives AttackFx.Update + the poses (AttackFx.Pose -> the body offset
--                           PetBuilder.PoseBody on the pivot + PetBuilder.Animate opts.Pose) for FX_SECONDS; a Special
--                           without a kind plays the caster's own; the support kinds land on both pets and on 2 more
--                           stand-in allies behind them (4 allies: Task 10); a Storm (an attack special that hits the
--                           enemies in its zone) lands on the dummy and 2 stand-in enemies beside and behind it, inside
--                           the zone (3 enemies: Task 11 fix round 2, I1)
--   Clear {}                stops an evolution or a lineup and removes every showcase pet (and the Fx pair: AttackFx.Cancel)
-- Lineup, Evolve, Fx and Clear take over from whatever was running; Spawn adds to it. Resting pets get the tag
-- NC_Showcase (ShowcaseController makes them hover, flap, wag and blink) and a compact name tag (World text rule:
-- pixel-sized, 24 px name and 19 px info line, outlined, on a solid plate sized to its text, LightInfluence 0,
-- MaxDistance 120). Payloads are checked again here (catalog ids, stages each pet really has).
-- Plain Lua 5.1-compatible syntax only.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local function optionalModule(parent, name)
	local module = parent:FindFirstChild(name) or parent:WaitForChild(name, 5)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	warn("[DevPetShow] failed to load " .. name .. ": " .. tostring(result))
	return nil
end

local PetBuilder = optionalModule(Shared, "PetBuilder")
local PetCatalog = optionalModule(Shared, "PetCatalog")
local EvolutionFx = optionalModule(script.Parent, "EvolutionFx")

local DevPetShow = {}

local K = {
	FOLDER = "DevPetShow",
	TAG = "NC_Showcase", -- ShowcaseController animates models with this tag
	MAX_PETS = 40,
	HOVER = 0.7, -- studs between a pet's lowest point and the ground
	BOB = 0.3, -- ShowcaseController hover amplitude (studs)
	AHEAD = 6, -- studs from the player to the nearest pet's edge
	GAP = 1.6, -- studs between two pets
	PER_ROW = 8,
	LINEUP_PARTS = 26000, -- above this a lineup is built at Low detail
	PARTS = { [0] = 350, [1] = 1560, [2] = 2000 }, -- High detail part caps per stage (PetBuilder header)
	LOOK = 0.6, -- seconds a pet is shown before it evolves
	STEP_PAUSE = 0.5, -- seconds between the two evolutions of one pet
	PAUSE = 1.8, -- seconds an evolved pet rests before the next pet of a reel
	NAME_PX = 24, -- World text rule: names >= 22 px, info lines >= 18 px (1080p design pixels)
	INFO_PX = 19,
	TAG_W = 280,
	TAG_H = 70,
	TAG_DISTANCE = 120,
	RAY = 90, -- studs searched down for the ground
	FX_APART = 10, -- /fx: studs between the caster and the dummy target ...
	FX_BACK = 3, -- ... their line this much further than a lone pet would stand
	FX_SECONDS = 6, -- the preview's update runs this long (the longest special + its linger)
	FX_ALLY_BACK = 4, -- (Task 10) a support special's 2 extra allies stand this far behind the pair (4 allies in all)
	FX_FOE_BACK = 3.5, -- (Task 11 fix round 2) a Storm's 2 extra enemies stand this far behind the dummy ...
	FX_FOE_SIDE = 2.5, -- ... and this far to either side (4.3 studs off: inside the Storm Radius; client_dev_pets)
}
local STAGE_NAMES = { [0] = "Normal", [1] = "Evolved", [2] = "Evolved II" }

local folder = nil
local pets = {} -- { { Model, Pos = Vector3 (root, flat), Radius } } resting showcase pets, oldest first
local generation = 0 -- Lineup / Evolve / Clear bump it: a running lineup or evolution stops when it changes
local current = nil -- the EvolutionFx handle that is playing
local busy = 0
local initialized = false
local fxRun = nil -- the /fx preview: { Sides = { { Id, Model, Base } x2 }, Until, Conn }
local FX_CASTER, FX_TARGET = "DevFx:Caster", "DevFx:Target" -- AttackFx unit ids (never a battle's numbers)
local FX_ALLIES = { "DevFx:Ally1", "DevFx:Ally2" } -- (Task 10) the 2 extra allies of a support special
local FX_FOES = { "DevFx:Foe1", "DevFx:Foe2" } -- (Task 11 fix round 2) the 2 extra enemies in a Storm's zone

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function getFolder()
	if folder and folder.Parent then
		return folder
	end
	folder = Workspace:FindFirstChild(K.FOLDER)
	if not (folder and folder:IsA("Folder")) then
		folder = Instance.new("Folder")
		folder.Name = K.FOLDER
		folder.Parent = Workspace
	end
	return folder
end

local function defOf(id)
	if type(id) ~= "string" or not PetCatalog then
		return nil
	end
	local ok, def = pcall(PetCatalog.Get, id)
	if ok and type(def) == "table" then
		return def
	end
	return nil
end

local function maxStage(def)
	local ok, top = pcall(PetBuilder.MaxEvolution, def)
	if ok and (top == 1 or top == 2) then
		return top
	end
	return 1
end

local function validStage(def, stage)
	return type(stage) == "number" and stage == math.floor(stage) and stage >= 0 and stage <= maxStage(def)
end

local function rarityColor(rarity)
	for _, r in ipairs(Config.Rarities or {}) do
		if r.Id == rarity and typeof(r.Color) == "Color3" then
			if rarity == "Secret" then
				return Color3.fromRGB(150, 236, 255) -- the dark Secret colour does not show on the navy plate
			end
			return r.Color
		end
	end
	return Theme.Colors.Gold
end

-- The player's position and the flat direction they look at.
local function playerFrame()
	local player = Players.LocalPlayer
	local char = player and player.Character
	local root = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
	local cf
	if root and root:IsA("BasePart") then
		cf = root.CFrame
	else
		local cam = Workspace.CurrentCamera
		cf = cam and cam.CFrame or CFrame.new(0, 300, 0)
	end
	local look = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if look.Magnitude < 0.01 then
		look = Vector3.new(0, 0, -1)
	end
	return cf.Position, look.Unit, char
end

-- y of the ground under pos (the player's feet when nothing is found)
local function groundAt(pos, char, fallback)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { getFolder() }
	if char then
		ignore[#ignore + 1] = char
	end
	params.FilterDescendantsInstances = ignore
	local ok, hit = pcall(function()
		return Workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -K.RAY, 0), params)
	end)
	if ok and hit then
		return hit.Position.Y
	end
	return fallback
end

-- The built pet's extent around its root (PetBuilder builds the root at the origin): lowest and highest point,
-- and the horizontal radius from the root.
local function extentOf(model)
	local ok, cf, size = pcall(function()
		return model:GetBoundingBox()
	end)
	if not ok or typeof(cf) ~= "CFrame" then
		return -1.5, 1.5, 2
	end
	local root = model.PrimaryPart
	local rel = root and root.CFrame:PointToObjectSpace(cf.Position) or cf.Position
	local bottom = rel.Y - size.Y / 2
	local top = rel.Y + size.Y / 2
	local radius = math.max(math.abs(rel.X) + size.X / 2, math.abs(rel.Z) + size.Z / 2)
	return bottom, top, radius
end

local function build(def, stage, detail)
	local ok, model = pcall(PetBuilder.Build, def, { Detail = detail or "High", Evolved = (stage > 0) and stage or nil })
	if not ok or typeof(model) ~= "Instance" or not model.PrimaryPart then
		warn("[DevPetShow] could not build " .. tostring(def.Id) .. " stage " .. tostring(stage) .. ": " .. tostring(model))
		return nil
	end
	model.Name = "DevPet_" .. tostring(def.Id) .. "_" .. stage
	model:SetAttribute("DevPetStage", stage)
	return model
end

-- Root CFrame of a pet standing at flat position `spot` (its lowest point HOVER above the ground), facing `facing`.
local function poseAt(spot, bottom, facing, char, fallbackY)
	local ground = groundAt(Vector3.new(spot.X, fallbackY + 4, spot.Z), char, fallbackY)
	local pos = Vector3.new(spot.X, ground + K.HOVER - bottom, spot.Z)
	return CFrame.lookAt(pos, pos + facing), ground
end

local function nameTag(model, def, stage, top)
	local root = model.PrimaryPart
	if not root then
		return
	end
	local k = 1
	local okScale, factor = pcall(Theme.ScreenFactor)
	if okScale and type(factor) == "number" and factor > 0 then
		k = factor
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "DevPetTag"
	gui.Size = UDim2.fromOffset(math.floor(K.TAG_W * k), math.floor(K.TAG_H * k))
	gui.StudsOffsetWorldSpace = Vector3.new(0, top + 1.4, 0)
	gui.AlwaysOnTop = false
	gui.LightInfluence = 0
	gui.MaxDistance = K.TAG_DISTANCE
	gui.ClipsDescendants = false
	gui.Adornee = root
	local card = Instance.new("Frame")
	card.Name = "Card"
	card.BackgroundColor3 = Theme.Colors.Navy
	card.BackgroundTransparency = 0.04
	card.BorderSizePixel = 0
	card.AnchorPoint = Vector2.new(0.5, 1)
	card.Position = UDim2.fromScale(0.5, 1)
	card.Size = UDim2.fromOffset(0, 0)
	card.AutomaticSize = Enum.AutomaticSize.XY
	card.Parent = gui
	Theme.Corner(card, UDim.new(0, 12))
	Theme.Stroke(card, rarityColor(def.Rarity), 3, 0)
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 4)
	pad.PaddingBottom = UDim.new(0, 6)
	pad.PaddingLeft = UDim.new(0, 14)
	pad.PaddingRight = UDim.new(0, 14)
	pad.Parent = card
	local list = Instance.new("UIListLayout")
	list.FillDirection = Enum.FillDirection.Vertical
	list.HorizontalAlignment = Enum.HorizontalAlignment.Center
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 1)
	list.Parent = card
	local scale = Instance.new("UIScale")
	scale.Name = "ReadScale"
	scale.Scale = k
	scale.Parent = card
	local name = Theme.Label(tostring(def.Name or def.Id), "Heading", { Size = K.NAME_PX, Color = Theme.Colors.White, Outline = 2 })
	name.Name = "Name"
	name.AutomaticSize = Enum.AutomaticSize.XY
	name.Size = UDim2.fromOffset(0, K.NAME_PX + 4)
	name.TextWrapped = false
	name.LayoutOrder = 1
	name.Parent = card
	local info = Theme.Label(STAGE_NAMES[stage] .. "  \226\128\162  " .. tostring(def.Rarity or ""), "Label", { Size = K.INFO_PX, Color = rarityColor(def.Rarity), Outline = 2 })
	info.Name = "Info"
	info.AutomaticSize = Enum.AutomaticSize.XY
	info.Size = UDim2.fromOffset(0, K.INFO_PX + 4)
	info.TextWrapped = false
	info.LayoutOrder = 2
	info.Parent = card
	gui.Parent = root
end

-- A pet at rest: name tag, then ShowcaseController brings it to life.
local function rest(model, def, stage, pos, radius)
	local _, top = extentOf(model)
	model:SetAttribute("Ready", true)
	model:SetAttribute("HoverAmp", K.BOB)
	nameTag(model, def, stage, top)
	CollectionService:AddTag(model, K.TAG)
	pets[#pets + 1] = { Model = model, Pos = Vector3.new(pos.X, 0, pos.Z), Radius = radius }
	while #pets > K.MAX_PETS do
		local old = table.remove(pets, 1)
		pcall(function()
			old.Model:Destroy()
		end)
	end
end

local fxStop -- (the Fx section below)

local function clearAll()
	if current then
		pcall(current.Stop)
		current = nil
	end
	fxStop()
	for _, rec in ipairs(pets) do
		pcall(function()
			rec.Model:Destroy()
		end)
	end
	pets = {}
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			pcall(function()
				child:Destroy()
			end)
		end
	end
end

-- The first free spot on the line in front of the player (nearest the middle first).
local function freeSpot(origin, look, radius)
	local right = Vector3.new(-look.Z, 0, look.X)
	local base = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
	for i = 0, 40 do
		local side = (i == 0) and 0 or (((i % 2 == 1) and 1 or -1) * math.ceil(i / 2))
		local spot = base + right * side * (radius + K.GAP)
		local free = true
		for _, rec in ipairs(pets) do
			if rec.Model.Parent and (rec.Pos - spot).Magnitude < rec.Radius + radius + K.GAP * 0.5 then
				free = false
				break
			end
		end
		if free then
			return spot
		end
	end
	return base
end

----------------------------------------------------------------------
-- Actions
----------------------------------------------------------------------
local function spawnPet(payload)
	local def = defOf(payload.PetId)
	if not def or not validStage(def, payload.Stage) then
		return false
	end
	local model = build(def, payload.Stage, "High")
	if not model then
		return false
	end
	local origin, look, char = playerFrame()
	local bottom, _, radius = extentOf(model)
	local spot = freeSpot(origin, look, radius)
	local pose = poseAt(spot, bottom, -look, char, origin.Y - 3)
	model:PivotTo(pose)
	model.Parent = getFolder()
	rest(model, def, payload.Stage, spot, radius)
	return true
end

local function lineup(payload, gen)
	local stage = payload.Stage
	if type(payload.PetIds) ~= "table" or type(stage) ~= "number" then
		return false
	end
	local defs = {}
	for _, id in ipairs(payload.PetIds) do
		local def = defOf(id)
		if def and validStage(def, stage) then
			defs[#defs + 1] = def
		end
	end
	if #defs == 0 then
		return false
	end
	busy = busy + 1
	local detail = (#defs * (K.PARTS[stage] or 350) > K.LINEUP_PARTS) and "Low" or "High"
	-- build them all first (one per frame), then stand them in rows
	local built = {}
	local maxR = 1
	for _, def in ipairs(defs) do
		if gen ~= generation then
			break
		end
		local model = build(def, stage, detail)
		if model then
			local bottom, _, radius = extentOf(model)
			built[#built + 1] = { Model = model, Def = def, Bottom = bottom, Radius = radius }
			maxR = math.max(maxR, radius)
		end
		task.wait()
	end
	if gen ~= generation then
		for _, b in ipairs(built) do
			pcall(function()
				b.Model:Destroy()
			end)
		end
		busy = busy - 1
		return false
	end
	local origin, look, char = playerFrame()
	local right = Vector3.new(-look.Z, 0, look.X)
	local perRow = math.min(K.PER_ROW, #built)
	local pitch = maxR * 2 + K.GAP
	local parent = getFolder()
	for i, b in ipairs(built) do
		local row = math.floor((i - 1) / perRow)
		local col = (i - 1) % perRow
		local inRow = math.min(perRow, #built - row * perRow)
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + maxR + row * (pitch + K.GAP)) + right * ((col - (inRow - 1) / 2) * pitch)
		local pose = poseAt(spot, b.Bottom, -look, char, origin.Y - 3)
		b.Model:PivotTo(pose)
		b.Model.Parent = parent
		rest(b.Model, b.Def, stage, spot, b.Radius)
	end
	busy = busy - 1
	return true
end

-- Groups the steps into chains: consecutive steps of one pet where each starts where the previous ended.
local function chainsOf(steps)
	local chains = {}
	local last = nil
	for _, st in ipairs(steps) do
		if type(st) == "table" then
			local def = defOf(st.PetId)
			if def and validStage(def, st.From) and validStage(def, st.To) and st.To == st.From + 1 then
				if last and last.Def == def and last.To == st.From then
					last.Steps[#last.Steps + 1] = st
					last.To = st.To
				else
					last = { Def = def, From = st.From, To = st.To, Steps = { st } }
					chains[#chains + 1] = last
				end
			end
		end
	end
	return chains
end

local function evolveReel(payload, gen)
	if type(payload.Steps) ~= "table" or not EvolutionFx then
		return false
	end
	local chains = chainsOf(payload.Steps)
	if #chains == 0 then
		return false
	end
	busy = busy + 1
	local onShow = nil -- the model resting from the previous chain
	for ci, chain in ipairs(chains) do
		if gen ~= generation then
			break
		end
		if onShow then
			task.wait(K.PAUSE)
			if gen ~= generation then
				break
			end
			pcall(function()
				onShow:Destroy()
			end)
			onShow = nil
		end
		-- every stage of the chain is built first: the biggest one decides where it stands
		local models = {}
		local bottom, radius = 0, 1
		for stage = chain.From, chain.To do
			local m = build(chain.Def, stage, "High")
			if not m then
				break
			end
			models[stage] = m
			local b, _, r = extentOf(m)
			bottom, radius = math.min(bottom, b), math.max(radius, r)
			task.wait()
		end
		if gen ~= generation or not models[chain.To] then
			for _, m in pairs(models) do
				pcall(function()
					m:Destroy()
				end)
			end
			break
		end
		local origin, look, char = playerFrame()
		local spot = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + radius)
		local pose, ground = poseAt(spot, bottom, -look, char, origin.Y - 3)
		local parent = getFolder()
		local model = models[chain.From]
		model:PivotTo(pose)
		model.Parent = parent
		task.wait(K.LOOK)
		for si, st in ipairs(chain.Steps) do
			if gen ~= generation then
				break
			end
			if si > 1 then
				task.wait(K.STEP_PAUSE)
				if gen ~= generation then
					break
				end
			end
			local toModel = models[st.To]
			local okColors, a, b = pcall(PetBuilder.EvolutionColors, chain.Def, st.To)
			local handle = EvolutionFx.Play(model, toModel, pose, {
				Parent = parent,
				Colors = okColors and { a, b } or nil,
				Stage = st.To,
				Ground = ground,
			})
			current = handle
			while not handle.Done do
				if gen ~= generation then
					pcall(handle.Stop)
					break
				end
				task.wait(0.1)
			end
			if current == handle then
				current = nil
			end
			model = toModel
		end
		-- a stage built but never shown (stopped part-way) goes away
		for _, m in pairs(models) do
			if m ~= model then
				pcall(function()
					m:Destroy()
				end)
			end
		end
		if gen ~= generation then
			pcall(function()
				model:Destroy()
			end)
			break
		end
		if ci == #chains then
			rest(model, chain.Def, chain.To, spot, radius)
		else
			onShow = model
		end
	end
	if onShow and gen ~= generation then
		pcall(function()
			onShow:Destroy()
		end)
	end
	busy = busy - 1
	return true
end

----------------------------------------------------------------------
-- Fx (/fx): the pet attack VFX preview (client/Controllers/AttackFx + shared/AttackFxCatalog, loaded on the first use)
----------------------------------------------------------------------
local FX = { Mod = nil, Cat = nil, BC = nil }

-- BattleController (required once; false when it cannot load): its AttackFx hooks, and whether its loop steps AttackFx
local function fxBattle()
	if FX.BC == nil then
		local bcInst = script.Parent:FindFirstChild("BattleController")
		local okBc, BC = false, nil
		if bcInst then
			okBc, BC = pcall(require, bcInst)
		end
		FX.BC = (okBc and type(BC) == "table") and BC or false
	end
	return FX.BC or nil
end

local function fxModules()
	if FX.Mod == nil then
		local inst = script.Parent:FindFirstChild("AttackFx")
		local ok, m = false, nil
		if inst then
			ok, m = pcall(require, inst)
		end
		FX.Mod = (ok and type(m) == "table" and type(m.Play) == "function" and type(m.Update) == "function") and m or false
		-- (Task 11) before the first battle nothing has pointed AttackFx's hooks anywhere: BattleController does it (the
		-- camera punch, the edge glow, a signature's battle dim), so /fx shows a signature as a battle would
		if FX.Mod and type(FX.Mod.Hooks) == "table" and FX.Mod.Hooks.DimWorld == nil then
			local BC = fxBattle()
			if BC and type(BC.FxHooks) == "function" then
				pcall(BC.FxHooks)
			end
		end
	end
	if FX.Cat == nil then
		local inst = Shared:FindFirstChild("AttackFxCatalog")
		local ok, m = false, nil
		if inst then
			ok, m = pcall(require, inst)
		end
		FX.Cat = (ok and type(m) == "table" and type(m.Elements) == "table") and m or false
	end
	return FX.Mod or nil, FX.Cat or nil
end

local function listHas(list, name)
	for _, v in ipairs(type(list) == "table" and list or {}) do
		if v == name then
			return true
		end
	end
	return false
end

-- the payload checked again: catalog names only, a whole stage 0..2
local function fxValid(p, Cat)
	return type(p.Element) == "string" and Cat.Elements[p.Element] ~= nil and listHas(Cat.AttackNames, p.Attack)
		and (p.Kind == nil or listHas(Cat.KindNames, p.Kind)) and (p.Shape == nil or listHas(Cat.ShapeNames, p.Shape))
		and listHas(Cat.Rarities, p.Rarity) and type(p.Stage) == "number" and p.Stage == math.floor(p.Stage) and p.Stage >= 0 and p.Stage <= 2
end

local function firstElement(def)
	if type(PetCatalog.ElementsOf) == "function" then
		local ok, list = pcall(PetCatalog.ElementsOf, def)
		if ok and type(list) == "table" and list[1] then
			return list[1]
		end
	end
	return def.Element
end

-- the catalog pet that casts: its first element is `element`; the same rarity first, then the same special kind (a
-- signature pet when one matches); else any pet of the element (the effect keeps the asked rarity: the pet only
-- stands in)
local function fxCaster(element, rarity, kind)
	local best, bestScore = nil, -1
	for _, def in ipairs(PetCatalog.Pets or {}) do
		if type(def) == "table" and type(def.Id) == "string" and firstElement(def) == element then
			local score = ((def.Rarity == rarity) and 4 or 0) + ((kind and type(def.Special) == "table" and def.Special.Kind == kind) and 2 or 0)
			if score > bestScore then
				best, bestScore = def, score
			end
		end
	end
	return best or PetCatalog.Pets[1]
end

-- the dummy target: the first Common pet of another element (a plain stand-in); `skip` = that many such pets passed
-- over first (the support specials' extra allies: different stand-ins)
local function fxDummy(element, skip)
	skip = skip or 0
	local first = nil
	for _, def in ipairs(PetCatalog.Pets or {}) do
		if type(def) == "table" and def.Rarity == "Common" and firstElement(def) ~= element then
			first = first or def
			if skip <= 0 then
				return def
			end
			skip = skip - 1
		end
	end
	return first or PetCatalog.Pets[1]
end

function fxStop()
	local run = fxRun
	fxRun = nil
	if not run then
		return
	end
	if run.Conn then
		run.Conn:Disconnect()
	end
	local AF = FX.Mod
	if AF and type(AF.Cancel) == "function" then
		pcall(AF.Cancel, FX_CASTER)
		pcall(AF.Cancel, FX_TARGET)
		for _, id in ipairs(FX_ALLIES) do
			pcall(AF.Cancel, id)
		end
		for _, id in ipairs(FX_FOES) do
			pcall(AF.Cancel, id)
		end
	end
end

-- PetBuilder.PoseBody of AttackFx's pose for `id` (its crossfade honoured) -> pose for Animate, body CFrame
local function fxPose(AF, id)
	local ok, ps = pcall(AF.Pose, id)
	if not ok or type(ps) ~= "table" or type(ps.Name) ~= "string" then
		return nil, CFrame.new()
	end
	local pose = { Name = ps.Name, P = ps.P, Ranged = ps.Ranged, Amp = ps.Amp, Reach = ps.Reach } -- (the leap's band and length)
	local body = PetBuilder.PoseBody({ Pose = pose })
	local blend = tonumber(ps.Blend) or 1
	if type(ps.Prev) == "table" and blend < 1 then
		body = PetBuilder.PoseBody({ Pose = ps.Prev }):Lerp(body, math.max(0, blend))
		if blend < 0.5 then
			pose = ps.Prev
		end
	end
	return pose, body
end

-- per frame while the preview plays (its own short-lived RenderStepped: AttackFx has no loop, and the pair is not
-- tagged NC_Showcase, so ShowcaseController never moves it): AttackFx.Update, then each pet at its spot x its pose
local function fxStep()
	local run = fxRun
	local AF = FX.Mod
	if not run or not AF then
		return
	end
	local now = os.clock()
	-- (Task 11 fix round 1, M2) while BattleController's loop runs (an Eclipse dim wakes it) it steps AttackFx itself:
	-- one Update a frame, never two
	local BC = fxBattle()
	local stepped = false
	if BC and type(BC.StepsAttackFx) == "function" then
		local ok, yes = pcall(BC.StepsAttackFx)
		stepped = ok and yes == true
	end
	if not stepped then
		pcall(AF.Update, now)
	end
	for _, side in ipairs(run.Sides) do
		if side.Model.Parent then
			local pose, body = fxPose(AF, side.Id)
			pcall(function()
				side.Model:PivotTo(side.Base * body)
			end)
			pcall(PetBuilder.Animate, side.Model, now, { Pose = pose })
		end
	end
	if now >= run.Until then
		-- (the last pose stays: a Ko'd caster lies until /clearpets)
		if run.Conn then
			run.Conn:Disconnect()
			run.Conn = nil
		end
	end
end

local function fxPlay(payload)
	local AF, Cat = fxModules()
	if not (AF and Cat) or not fxValid(payload, Cat) then
		return false
	end
	local def = fxCaster(payload.Element, payload.Rarity, payload.Kind)
	local stage = validStage(def, payload.Stage) and payload.Stage or 0
	local caster = build(def, stage, "High")
	local dummyDef = fxDummy(payload.Element)
	local dummy = dummyDef and build(dummyDef, 0, "High")
	if not (caster and dummy) then
		if caster then
			caster:Destroy()
		end
		return false
	end
	-- side by side across the player's view, FX_APART studs apart, facing each other
	local origin, look, char = playerFrame()
	local right = Vector3.new(-look.Z, 0, look.X)
	local cBottom, _, cRadius = extentOf(caster)
	local tBottom, _, tRadius = extentOf(dummy)
	local center = Vector3.new(origin.X, 0, origin.Z) + look * (K.AHEAD + math.max(cRadius, tRadius) + K.FX_BACK)
	local cSpot = center - right * (K.FX_APART / 2)
	local tSpot = center + right * (K.FX_APART / 2)
	local cPose, ground = poseAt(cSpot, cBottom, right, char, origin.Y - 3)
	local tPose = poseAt(tSpot, tBottom, -right, char, origin.Y - 3)
	local parent = getFolder()
	caster:PivotTo(cPose)
	dummy:PivotTo(tPose)
	caster:SetAttribute("DevFx", "Caster")
	caster:SetAttribute("DevFxElement", payload.Element)
	caster:SetAttribute("DevFxRarity", payload.Rarity)
	dummy:SetAttribute("DevFx", "Target")
	caster.Parent = parent
	dummy.Parent = parent
	nameTag(caster, def, stage, select(2, extentOf(caster)))
	local cSide = { Unit = FX_CASTER, Model = caster, Pos = caster:GetPivot().Position }
	local tSide = { Unit = FX_TARGET, Model = dummy, Pos = dummy:GetPivot().Position }
	local attack, kind = payload.Attack, payload.Kind
	if attack == "Special" and not kind then
		kind = (type(def.Special) == "table" and listHas(Cat.KindNames, def.Special.Kind)) and def.Special.Kind or "Blast"
	end
	local to = nil
	local sides = { { Id = FX_CASTER, Model = caster, Base = cPose }, { Id = FX_TARGET, Model = dummy, Base = tPose } }
	if attack == "Special" and (kind == "Heal" or kind == "Shield" or kind == "Rally" or kind == "Haste") then
		to = { cSide, tSide } -- (the support kinds land on allies: both)
		-- (Task 10) + 2 more stand-in allies behind the pair, facing the player: a support special is checked on 4 allies
		for i, id in ipairs(FX_ALLIES) do
			local aDef = fxDummy(payload.Element, i)
			local ally = aDef and build(aDef, 0, "High")
			if ally then
				local aBottom = extentOf(ally)
				local aPose = poseAt(((i == 1) and cSpot or tSpot) + look * K.FX_ALLY_BACK, aBottom, -look, char, origin.Y - 3)
				ally:PivotTo(aPose)
				ally:SetAttribute("DevFx", "Ally")
				ally.Parent = parent
				to[#to + 1] = { Unit = id, Model = ally, Pos = aPose.Position }
				sides[#sides + 1] = { Id = id, Model = ally, Base = aPose }
			end
		end
	elseif attack == "Special" and kind == "Storm" then
		-- (Task 11 fix round 2, I1) a Storm hits the enemies in its zone (BattleController gathers them in a battle): the
		-- dummy + 2 stand-in enemies behind it, one to either side, facing the caster (Obsidian's sweep crosses all three)
		to = { tSide }
		for i, id in ipairs(FX_FOES) do
			local eDef = fxDummy(payload.Element, i)
			local foe = eDef and build(eDef, 0, "High")
			if foe then
				local eBottom = extentOf(foe)
				local spot = tSpot + look * K.FX_FOE_BACK + right * ((i == 1) and -K.FX_FOE_SIDE or K.FX_FOE_SIDE)
				local ePose = poseAt(spot, eBottom, -right, char, origin.Y - 3)
				foe:PivotTo(ePose)
				foe:SetAttribute("DevFx", "Foe")
				foe.Parent = parent
				to[#to + 1] = { Unit = id, Model = foe, Pos = ePose.Position }
				sides[#sides + 1] = { Id = id, Model = foe, Base = ePose }
			end
		end
	elseif attack == "Melee" or attack == "Ranged" or attack == "Special" or attack == "Element" then
		to = tSide
	end
	fxRun = { Sides = sides, Until = os.clock() + K.FX_SECONDS }
	local okPlay, played = pcall(AF.Play, {
		Attack = attack, Kind = (attack == "Special") and kind or nil, Shape = payload.Shape, Element = payload.Element,
		Rarity = payload.Rarity, Stage = payload.Stage, PetId = (def.Rarity == payload.Rarity) and def.Id or nil, Mine = true,
		From = cSide, To = to, Ground = ground,
	})
	if not (okPlay and played == true) then
		warn("[DevPetShow] AttackFx did not play " .. tostring(payload.Element) .. " " .. tostring(attack) .. ": " .. tostring(played))
	end
	fxRun.Conn = RunService.RenderStepped:Connect(function()
		local ok, err = pcall(fxStep)
		if not ok then
			warn("[DevPetShow] Fx update failed: " .. tostring(err))
			fxStop()
		end
	end)
	return true
end

function DevPetShow.Handle(action, payload)
	if type(action) ~= "string" then
		return false
	end
	payload = type(payload) == "table" and payload or {}
	if not (PetBuilder and PetCatalog) then
		warn("[DevPetShow] PetBuilder / PetCatalog are missing")
		return false
	end
	if action == "Spawn" then
		local ok, result = pcall(spawnPet, payload)
		if not ok then
			warn("[DevPetShow] Spawn failed: " .. tostring(result))
		end
		return ok and result == true
	end
	if action ~= "Lineup" and action ~= "Evolve" and action ~= "Clear" and action ~= "Fx" then
		return false
	end
	if action == "Fx" then
		local _, Cat = fxModules()
		if not (Cat and fxValid(payload, Cat)) then
			return false
		end
	end
	generation = generation + 1
	local gen = generation
	clearAll()
	if action == "Clear" then
		return true
	end
	if action == "Fx" then
		local ok, result = pcall(fxPlay, payload)
		if not ok then
			warn("[DevPetShow] Fx failed: " .. tostring(result))
		end
		return ok and result == true
	end
	task.spawn(function()
		local fn = (action == "Lineup") and lineup or evolveReel
		local ok, err = pcall(fn, payload, gen)
		if not ok then
			warn("[DevPetShow] " .. action .. " failed: " .. tostring(err))
			busy = math.max(0, busy - 1)
		end
	end)
	return true
end

function DevPetShow.Count()
	local n = 0
	if folder then
		for _, child in ipairs(folder:GetChildren()) do
			if child:IsA("Model") then
				n = n + 1
			end
		end
	end
	return n
end

function DevPetShow.Busy()
	return busy > 0
end

function DevPetShow.Folder()
	return folder
end

function DevPetShow.Init()
	if initialized then
		return
	end
	initialized = true
	local ok, remote = pcall(Remotes.Get, "DevPetShow")
	if not (ok and remote) then
		warn("[DevPetShow] the DevPetShow remote is missing")
		return
	end
	remote.OnClientEvent:Connect(function(action, payload)
		DevPetShow.Handle(action, payload)
	end)
end

return DevPetShow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1135">
            <Properties>
              <string name="Name">DungeonController</string>
              <string name="Source"><![CDATA[-- DungeonController (client, Phase 5, dungeonclient W4): the Dungeon window, the run card, the loot / chest toasts, the
-- End card and the dungeon mood (ARCHITECTURE_V3.md "Phase 5 build contract" 5.3, 5.6, 5.7, 6.4, 6.6).
--
--   DungeonController.Init()
--   DungeonController.Open(floor|nil, portal|nil) -> bool   the Dungeon side panel (Portal_Dungeon's DungeonPrompt is
--                                             handed over by ArenaController; OpenPanel("Dungeon", { Floor }) from the
--                                             server: the tutorial / the prompt). Refused (false) inside a run / a match.
--   DungeonController.Close()
--   DungeonController.IsOpen() -> bool
--   DungeonController.Request(action, a, b) -> bool   DungeonRequest(action, a, b), spaced per action (K.FIRE_GAP);
--                                             the server validates everything (DungeonService ladder + cooldowns)
--   DungeonController.GetState() -> { Window, Floor, Lobby, Run, End, Loot, Totals, Ready, Lit, CardMode, Countdown, Fade,
--                                     Door, Enter, Walk, Shoulder }
--   DungeonController.Opened / Closed (Util.Signal)
--
-- What the player sees
--   * The Dungeon window (a NeonKit side panel, 640 x 860 design px, Purple; docked right on landscape screens, a
--     bottom sheet on portrait phones; never dims the screen): the record ("Best: floor 5 - 7 clears - 12 runs") and
--     the team power; the 12 floors (element orb, name, "Cleared" / "Recommended power 512" / "Clear floor 6 first";
--     the next floor to beat marked NEXT); then the party box: SOLO / PARTY + the open parties ("Ava's party - Floor 3
--     - 2/4 - JOIN", "in room 2 - JOIN"), or the own party (members with READY ticks, team power, the leader's crown
--     and KICK (x), READY / START / LEAVE, the countdown "Dungeon in 5..." / "Starting in 30 - press READY").
--     READY flips at once (optimistic) and the next Lobby payload says what the server decided.
--     Team balance: the party box starts with UI/TeamFaces (the three faces, Edit team; back here on the same floor); SOLO /
--     PARTY / JOIN / READY / START with an empty team open the Pets window in pick mode and send nothing (TeamFaces.Ensure).
--   * The run card (ScreenGui NimbusDungeonRun): on desktops a side card at the right edge between the enemy list and
--     the battle buttons ("Floor 3 - Frozen Crypt", "Room 2 / 4" pips with the boss room crowned, "Wave 1 / 3",
--     the status: "Walk into the room", "Go to the door and press E" / "Waiting for 1 more (Ava)" (dungeon-fixes
--     decision 2: no room changes by timer; the door's EnterPrompt E goes through ProximityPromptService on the
--     server, this controller sends nothing for it), "Pick ONE chest!" (bug batch 2 #14: no CHEST button; each
--     member walks to ONE chest of the alcove and presses its E prompt, the server rolls that chest's own drop; once
--     I picked or Run.ChestOwed does not list me, the pocket's other ChestPrompts are switched off locally),
--     member chips with Downed / Left, the loot so far, LEAVE (two presses -> DungeonRequest("Quit"))); on phones a one-line
--     chip in Roblox's top band. The party countdown uses the same card while the window is closed. Loot and chest
--     toasts flash inside it ("Room 2 cleared! +$340 +24 tokens +70 XP"). The End card (totals, first clear, unlock,
--     new best) sits at the right (desktop / landscape) or under the top bar (portrait), never in the centre.
--     A lost floor (Wipe / Timeout) shows client/Controllers/LossScreen instead (R.showLoss; team balance).
--   * Lighting: LightingStack.Push("Dungeon", preset, 1.5) when a run starts (darker ambient, ColorCorrection Brightness
--     -0.12 / Contrast 0.1 / a warm grey tint, Atmosphere density +0.15; a tier mood read late is re-pushed over 2.5 s);
--     Pop("Dungeon", 2) on End or when the player is no longer in the pocket (InBattle released); 0 s on an End under
--     a black fade (kit-b S3, sky audit F9: Config.Sky.Transitions.Zone; was 1 s each). The music follows the same
--     switch: SoundFx.SetLayer("Dungeon", true / false) (the Dungeon track while the run lasts; BattleController's
--     Battle layer wins in the boss room).
--   * Sounds: SoundFx "Reward" when the chest pays out (DungeonState "Chest") and when a room's loot comes in (not
--     the third-of-the-XP consolation of a lost run).
--   * Camera (wave 6): while a run lasts, R.camClamp (RenderStep NimbusDungeonCamBox at Camera + 1) keeps the camera
--     inside the pieces' camera boxes (DungeonBuilder's CamMin / CamMax): the boom from the Focus is cut on its own ray
--     where it leaves the box the Focus is in (CAM_MARGIN 0.6 inside; through a doorway it carries on in the next box,
--     at most 2 hops), so no zoom or turn shows the outside of a room, over a ceiling or across the chasm. First person
--     (a boom < 1 stud), a Scriptable camera (the walk-in, the entrance) and a Focus in no box are left alone.
--   * Camera (bug batch 2, #19): MovementController.SetZoomMax(K.ZOOM_RUN 14) with the first Run payload, so the camera
--     stays inside the 16-stud rooms; SetZoomMax(nil) (the normal 40) on End, when the run vanished without an End
--     (R.check) and, as a safety net, on any light-loop tick that finds the zoom capped with no run (every exit path).
--   * Doors: the room models' DoorOpen / EntranceOpen attributes play a local slide (copies of the bars sink into the
--     floor) in the player's own pocket.
--   * The room change fade (DungeonState "Fade" { Out, Hold, In }): ONE black full-screen Frame in its own ScreenGui
--     NimbusDungeonFade (IgnoreGuiInset, DisplayOrder K.FADE_ORDER 25: above the HUD 10, the battle HUD / run card 12
--     and the windows 20-23, below Notify 30); tweens to black over Out, holds (until the next room's Run payload,
--     at least Hold), back over In; never stuck: a FADE_SAFETY 6 s clear, leaving the run clears it at once, End lifts
--     it over Config.Sky.Transitions.Screen.Lift (0.3 s; kit-b S3).
--     (wave 6: the black waits up to FADE_SAFETY for the room: the server's payload can queue behind a big
--     replication; the old 3 s clear dropped the walk-in when it came late.)
--   * Wave 5 (bugs #15 / #26):
--     - The entrance (DungeonState "Enter" { Cover, Reveal, Element }, before the server teleports the party into the
--       hall after Cover): the camera rushes into the Dungeon gate's vortex (0.5 s, FOV 70 -> 55, the gate flares,
--       Whoosh), the screen fills with voxel blocks in the floor's element colour from the centre out (ScreenGui
--       NimbusDungeonEnter, DisplayOrder K.ENTER_ORDER 26; 16 x 9 / 9 x 16 portrait / 8 x 5 on Low graphics), they
--       hold until the run's first Run payload, then hop and fall away (Reveal). Any key / click / tap skips (the
--       cover snaps full, the reveal ends at once); ENTER_SAFETY 3 s, End and the run's InBattle release clear it.
--     - The room walk-in: when the next room's Run payload (Corridor / Threshold) arrives under the fade, the camera is
--       placed inside the room looking back through the doorway (Scriptable, FOV 60), the controls are off and, as the
--       fade lifts, the character walks itself (Humanoid:MoveTo, 6 studs/s) past the Threshold while the camera dollies
--       back, swings a little and opens to FOV 70; the first member across starts the fight on the server; then the
--       camera blends back (0.35 s) to where it was at the door and the controls return. Any key / click / tap skips
--       (the character is set at the Threshold). Never stuck: WALK_SAFETY 3 s, End, the InBattle release, the
--       character removed. Outside a fade (a late join, a rejoin) there is no walk-in.
--     - The dungeon camera: Humanoid.CameraOffset = DUNGEON_SHOULDER (a little over the right shoulder) for the run,
--       zero again on End / leaving the run. The Camera shake setting OFF turns off ONLY the hit shakes (player ruling
--       2026-10-28): the entrance rush, the walk-in shot and the FOV punch on big attacks play regardless (all short and
--       skippable). The rush is skipped when the camera is > ENTER_RUSH_MAX from the gate (no flight across the plaza).
--       MovementController.SetFovOverride / SetCinematic do the FOV and the walk speed (the one place that writes them
--       every frame).
-- Remotes: DungeonState (in), OpenPanel (in), DungeonRequest (out). One side panel at a time: opening it closes the
-- menu windows, the Pet Index, the Fusion / Care windows and the Arena windows; theirs close this one. Esc / gamepad
-- B / the red X / walking 40 studs away from the gate close it. Text is designed at 1080p (>= 18 design px).
-- Plain Lua 5.1-compatible syntax only. All fonts come from Theme roles; no asset ids.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7b) the dungeon's marks
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-7) the cards' nails
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local TeamFaces = require(UI:WaitForChild("TeamFaces"))
local State = require(Client:WaitForChild("State"))

local DungeonController = {}
DungeonController.Opened = Util.Signal()
DungeonController.Closed = Util.Signal()
-- (U9-7 look) MEASURE(label, text, width) -> Vector2: replaces TextService (Theme.MeasureLabel) for the End card's reason
-- line and the phone chip's width; tools/dump_gui.lua's renders pass the renderer's font metrics (the mock's GetTextSize is
-- a flat 0.5 em per character and never wraps)
DungeonController.Metrics = { MEASURE = nil }

----------------------------------------------------------------------
-- Tunables (design px of a 1080p screen unless noted)
----------------------------------------------------------------------
local K = {
	DISPLAY_ORDER = 23, -- the windows' layer (like the Arena windows)
	RUN_ORDER = 12, -- the run card: above the HUD (10) and the hotbar (11), below the windows
	PREF_W = 640,
	PREF_H = 860,
	SHORT = 560, -- a docked window lower than this uses the compact rows (landscape phones)
	FACES_NARROW = 560, -- a docked window narrower than this (phones) shows the team's faces in the Compact row
	TOUCH_H = 56, -- design px of the party box's buttons on a phone: >= 44 px under the 0.8 touch scale
	JUMP_INSET = 110, -- design px a landscape phone's button row keeps free on its right
	LIST_MIN_SHORT = 66, -- design px of the floor list on a landscape phone: (U9-7 look) one whole row (the 8 px pad, a 52 px
	-- row, the 6 px gap: the next row starts at the edge), the team and SOLO / PARTY under it
	FIRE_GAP = 0.3, -- seconds between two sends of the same request
	WALK_AWAY = 40, -- studs from the gate that close a window opened there
	FLOORS = 12,
	ROW_H = 66,
	ROW_H_SHORT = 52,
	MEMBER_H = 46,
	MEMBER_H_SHORT = 40,
	CARD_W = 330, -- the desktop run card
	CARD_LIP = 6, -- (kit-b U9-7) design px of the run / End card's lip (NeonKit's Sign card: the body sits above it)
	CHIP_H = 50, -- the phone chip (design px; scale 0.8)
	-- (U9-7 review) where the chip goes (R.placeChip): screen px unless noted
	CHIP_SCALE = 0.8,
	CHIP_MAX_W = 520, -- design px of a chip in Roblox's top band at most (it is as wide as the free span there) ...
	CHIP_BAND_MIN = 200, -- ... which must hold this much (the text keeps about 140 design px beside LEAVE), else it drops
	CHIP_DROP_W = 320, -- design px of a chip under the band ("Pick ONE chest! 0:40" whole beside LEAVE)
	CHIP_LEAVE_W = 102, -- design px of a chip that is its LEAVE alone (the 92 px button, 5 px each side)
	CHIP_RIGHT = 60, -- the band's right end kept free: Roblox's "..." button (44 px, 12 px off the edge) and 4 px
	CHIP_EDGE = 20, -- a dropped chip's right margin (the HUD's touch margin: the strips' right edge)
	CHIP_GAP = 6, -- between a dropped chip and what it hangs under
	-- (keys look r3) a chip dropped under the battle HUD's enemy list in a fight: its hard shadow's reach and the team orders'
	-- 40 px it keeps off the thumbs' keys (MOVE / DASH / RUN), screen px (R.placeChip -> BattleController.ReserveUnderList)
	CHIP_SHADOW = 6,
	CHIP_KEYS_GAP = 40,
	-- (keys look r4: the dropped chip hung 0.4 px under the enemy row's gold target bracket, its frame 1.2 px over it, 1.6-4.6
	-- px from "+3 more") a fight's dropped chip is its Leave button alone (no card round it: the double frame and the purple
	-- lip sliver went too) and keeps CHIP_AIR screen px from every part's INK: a part's ink reaches CHIP_REACH past its box (a
	-- card's edge and hard shadow, a row's target bracket), a tag's 2 px; the button's own reaches CHIP_BTN_OUT (its bevel) up
	-- and left, CHIP_BTN_OUT + CHIP_BTN_SHADOW down and right (screen px)
	CHIP_AIR = 6,
	CHIP_REACH = 6,
	CHIP_BTN_OUT = 4,
	CHIP_BTN_SHADOW = 4,
	CHIP_LEAVE_H = 38, -- design px: the Leave button's height (CHIP_H less 12)
	CHIP_HIT = 44, -- (keys look r3) screen px: a phone chip's Leave takes a thumb (its clear LeaveHit pad)
	END_W = 440, -- (Pitch 2 item 02 B, look review round 1) the battle result card's width (one template: BattleController K.RESULT_W)
	END_MIN_W = 300, -- (U9-7 look) design px: a landscape phone's End card is never squeezed narrower for a spot
	END_TWO_COL = 420, -- (P2 fix A) design px: the narrowest landscape End card whose rows go in 2 columns (R.fillEnd: inner >= 400)
	CHIP_ROW = 30, -- (U9-7 look) design px of a reward chip (H.rewardChip) and of the End card's first-clear plate
	ICON_TILE = 30, -- (U9-7 look) the pitch toast's icon tile on the loot plate and the phone chip (H.iconTile)
	LEAVE_CONFIRM = 3, -- seconds the first LEAVE press stays armed
	TOAST_SECONDS = 4,
	END_SECONDS = 14, -- the End card hides by itself after this
	TREASURE = 45,
	FADE_ORDER = 25, -- the room change fade: above the HUD (10), the run card (12) and the windows (20-23), below Notify (30)
	FADE_SAFETY = 6, -- a fade never stays on longer than this (seconds; wave 6: 3 -> 6, it waits for a late room payload)
	FADE_MAX_STEP = 2, -- Out / Hold / In are clamped to 0..this
	TICK = 0.25, -- the light loop
	BACK_ACTION = "NimbusDungeonBack",
	LIGHT_ID = "Dungeon", -- pushed over Config.Sky.Transitions.Zone In / Late, popped over Out (kit-b S3, sky audit F9)
	MOOD_RETRY = 1, -- bug #5 review: re-read the tier mood every 1 s ...
	MOOD_TRIES = 10, -- ... up to 10 s while the run is lit (streaming / a slow join)
	ZOOM_RUN = 14, -- bug batch 2 (#19): the camera zoom cap inside a run (rooms are 16 studs high)
	ZOOM_NUDGE = 10, -- wave 5 (#15): a run starts zoomed in to 10 (the shoulder camera), the player may zoom out to the cap
	-- wave 5 (bug #26): the room walk-in (seconds, studs, degrees)
	WALK_SECONDS = 1.3, -- the scripted walk's camera clock (7.5 studs at WALK_SPEED)
	WALK_SPEED = 6, -- studs/s, a deliberate "entering" pace
	WALK_BLEND = 0.35, -- the scripted -> normal camera blend
	WALK_SKIP_BLEND = 0.25,
	WALK_FIGHT_GRACE = 0.4, -- the fight started (someone crossed): the walk-in hands back control within this
	WALK_CAM = { Ahead = 9, Pull = 3, Up = 3.5, Settle = 0.8, Swing = 2.5, Fov0 = 60, Fov1 = 70 },
	WALK_SAFETY = 3, -- the camera is never left Scriptable longer than this
	WALK_REISSUE = 0.5, -- Humanoid:MoveTo again this often (a fresh Humanoid needs it)
	WALK_LANE = 4.8, -- studs: everybody keeps their lane across the doorway
	WALK_IN = 1.5, -- studs past the Threshold's centre (inside its box)
	WALK_REACH = 1.2, -- this close to the end point = arrived
	WALK_BIND = "NimbusDungeonWalk",
	CAM_BIND = "NimbusDungeonCamBox", -- wave 6: the camera box clamp (RenderPriority.Camera + 1, while a run lasts)
	CAM_MARGIN = 0.6, -- the camera stays this far inside a piece's box
	WALK_ACTION = "NimbusDungeonWalkSink",
	-- wave 5 (bug #15): the voxel-shatter entrance
	ENTER_ORDER = 26, -- above the fade (25) and every window, below Notify (30)
	ENTER_GRID = { Desktop = { 16, 9 }, Portrait = { 9, 16 }, Low = { 8, 5 }, LowPortrait = { 5, 8 } },
	ENTER_RUSH = 0.5, -- the camera rush into the gate
	ENTER_RUSH_FOV = 55,
	ENTER_RUSH_MAX = 60, -- studs: a camera further than this from the gate gets no rush (the blocks still cover)
	ENTER_LEAD = 0.10, -- the first blocks pop this long after the rush began
	ENTER_MARGIN = 0.15, -- every block is full this long before Cover (the hall teleport can never show at the edges)
	ENTER_POP = 0.12, -- one block's pop-in (Back Out)
	ENTER_HOP = 0.12, -- the reveal: a block's hop ...
	ENTER_FALL = 0.5, -- ... and its fall
	ENTER_JITTER = 0.08,
	ENTER_SAFETY = 3, -- the blocks never stay longer than this without the run's Run payload
	ENTER_BIND = "NimbusDungeonEnter",
	DUNGEON_SHOULDER = Vector3.new(1.4, 0.35, 0), -- Humanoid.CameraOffset inside a run (bug #15 "3D" camera)
}

-- (kit-b U9-7) the Signboard palette (the Arena's: one colour by role): brown ink on stone, the muted brown for captions,
-- sunk stone wells for the lists, raised stone tiles for the rows, square tags in a role's colour with the ink that reads
-- on it; coloured text is darkened until it reads 4.5:1 on a well (#F3E6C8) and on the picked row's pale gold
local Colors = Theme.Colors
local SIGN = Theme.Sign
local INK = SIGN.Text
local MUTED = SIGN.TextMuted
local ENTER_INK = Colors.PanelInk or Color3.fromRGB(8, 10, 28) -- the entry blocks' thin edge (a world effect, not a plate)
local C = {
	Accent = SIGN.Violet, -- the dungeon's own colour (an unknown element, the loss screen's lip)
	Gold = SIGN.Gold,
	Green = SIGN.Grass,
	Red = SIGN.Red,
	Blue = SIGN.Sky,
	Muted = MUTED,
	Good = Color3.fromRGB(37, 107, 41), -- #256B29: 5.3:1 on a well
	Warn = Color3.fromRGB(148, 86, 10), -- #94560A: 4.7:1 on a well, 4.9:1 on the pale gold
	Bad = SIGN.RedLip,
	Token = SIGN.Gold,
	Gem = SIGN.Sky,
}

-- typography as UTF-8 escapes (the source stays ASCII). kit-b U7b: the marks are PixelIcons (the sword before a power, the
-- lock / tick of a floor, the crown of the leader, a member's tick / skull, the room pips, the torch of the countdown), the
-- loot lines say "tokens" and "gems" in words (lobby-shop Task 15, spec 5.7); the emoji went
local G = {
	Dot = "\194\183",
	-- (review round 1) a member who left: U+00D7, a Latin-1 sign every UI font has (U+2715 drew a missing-glyph box)
	Gone = "\195\151",
}

-- the dungeon mood (contract 5.6): absolute values for the ambient / colour correction, the haze relative to the base
local PRESET = {
	Lighting = { Ambient = Color3.fromRGB(70, 62, 86), OutdoorAmbient = Color3.fromRGB(86, 78, 104) },
	ColorCorrection = { Brightness = -0.12, Contrast = 0.1, TintColor = Color3.fromRGB(236, 226, 212) },
	AtmosphereAdd = 0.15,
	-- the haze's ceiling (kit-b S1 review): the pre-bridge one (the densest look 0.42 + 0.15 = 0.57 unchanged), so a
	-- run that starts inside a sky haze bridge (base 0.65-0.7, read once) never keeps 0.8+ for the whole run
	AtmosphereMax = 0.6,
}

----------------------------------------------------------------------
-- Module state
----------------------------------------------------------------------
local LocalPlayer = nil
local initialized = false
local U = {} -- gui references
local S = {
	Open = false,
	Token = 0,
	Floor = nil, -- the selected floor in the window
	Lobby = nil, -- last DungeonState "Lobby"
	LobbyAt = 0,
	Run = nil, -- last "Run" (nil outside a run)
	RunAt = 0,
	PhaseAt = 0, -- os.clock() when the run's State / Phase last changed
	PhaseKey = nil,
	End = nil, -- last "End" (the End card)
	EndAt = 0,
	EndCompact = false, -- (U9-7 look) true: the End card dropped its reason line to fit under a landscape phone's strips
	Loot = nil, -- last "Loot"
	Totals = { Cash = 0, Tokens = 0, Xp = 0, Gems = 0 },
	Toast = nil, -- { Text, Color, Until }
	ReadyWant = nil, -- optimistic READY until the next Lobby payload
	Lit = false,
	LeaveArmed = 0,
	LastFire = {},
	BackBound = false,
	AtPortal = nil,
	Hint = nil, -- { Text, Until } the window footer
	Built = false,
	Short = false,
	CardMode = nil, -- "Card" | "Chip" | nil
	ChipCompact = false, -- (U9-7 review) the phone chip is its LEAVE alone (dropped under the band in a fight)
	Warned = {},
	Doors = {}, -- connections watching the pocket's doors
	Pocket = nil,
	Zoomed = false, -- the camera zoom is capped at K.ZOOM_RUN (a run)
	Walk = nil, -- wave 5: the room walk-in (R.walkPrepare)
	WalkSkip = nil, -- wave 6: why the last room payload played no walk-in (GetState().WalkSkip, the run gui's attribute)
	CamBoxes = nil, -- wave 6: the pocket's piece camera boxes (R.camBoxes), nil = rebuild
	CamBound = false, -- wave 6: NimbusDungeonCamBox is bound
	Enter = nil, -- wave 5: the voxel-shatter entrance (R.enter)
	Gate = nil, -- the Dungeon gate model (GateId "Dungeon"), cached
	ShoulderHum = nil, -- the Humanoid whose CameraOffset is the dungeon shoulder
}

local H = {} -- helpers
local W = {} -- the window
local R = {} -- the run card / End card / lighting / doors

----------------------------------------------------------------------
-- Small helpers
----------------------------------------------------------------------
function H.warnOnce(key, err)
	if not S.Warned[key] then
		S.Warned[key] = true
		warn("[DungeonController] " .. key .. ": " .. tostring(err))
	end
end

function H.safe(key, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		H.warnOnce(key, err)
	end
	return ok
end

-- team balance: client/Controllers/LossScreen, loaded once; nil when it is missing (today's End card then)
function H.lossScreen()
	if H.LS == nil then
		H.LS = false
		local inst = script.Parent:FindFirstChild("LossScreen")
		local ok, mod = pcall(function()
			return inst and require(inst)
		end)
		if ok and type(mod) == "table" then
			H.LS = mod
		end
	end
	return H.LS or nil
end

-- where the Pets window comes back to when the team is edited from this panel: the same floor, the same portal
function H.panelReturn()
	return { Window = "Dungeon", Floor = W.selected(), Portal = S.AtPortal }
end

-- runs fn when the player has a battle team; without one the Pets window opens in pick mode and nothing is sent
function H.withTeam(fn)
	TeamFaces.Ensure(function()
		H.safe("team portal", fn)
	end, H.panelReturn())
end

function H.optionalShared(name)
	local module = Shared:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, result = pcall(require, module)
	if ok and type(result) == "table" then
		return result
	end
	return nil
end

function H.catalog()
	if H.BC == nil then
		H.BC = H.optionalShared("BattleCatalog") or false
	end
	return H.BC or nil
end

function H.controller(name)
	local module = script.Parent:FindFirstChild(name)
	if not module then
		return nil
	end
	local ok, mod = pcall(require, module)
	if ok and type(mod) == "table" then
		return mod
	end
	return nil
end

function H.frame(parent, name, props)
	local f = Instance.new("Frame")
	f.Name = name
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	f.Parent = parent
	return f
end

function H.text(parent, name, text, role, size, color, props)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = tostring(text or "")
	-- kit-b U6: the dungeon window, the run card and the chip are plates, so the text reads by contrast (no outline)
	Theme.Style(label, role or "Body", { Size = size, Color = color or INK })
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	for k, v in pairs(props or {}) do
		label[k] = v
	end
	label.Parent = parent
	return label
end

function H.stroke(parent, color, thickness, transparency)
	return Util.Create("UIStroke", {
		Color = color or SIGN.Wood,
		Thickness = thickness or 2,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = parent,
	})
end

function H.list(parent, direction, gap, hAlign, vAlign)
	return Util.Create("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, gap or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = parent,
	})
end

function H.pad(parent, l, t, r, b)
	return Util.Create("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0),
		PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0),
		PaddingBottom = UDim.new(0, b or 0),
		Parent = parent,
	})
end

-- (kit-b U9-7) a square edge with mitred corners (kit B has no rounded blocks)
function H.edge(parent, color, thickness)
	local s = H.stroke(parent, color, thickness, 0)
	s.Name = "SignEdge"
	s.LineJoinMode = Enum.LineJoinMode.Miter
	return s
end

-- (kit-b U9-7) the colour a tag paints: a mid-tone that no ink reads 4.5:1 on is lightened until brown does
function H.readable(color)
	for _ = 1, 6 do
		if Theme.Contrast(Theme.TextOn(color), color) >= 4.6 then
			break
		end
		color = Theme.Lighten(color, 0.08)
	end
	return color
end

-- (kit-b U9-7) a square tag frame holding a centred label "Text" (a floor's state); H.paintTag colours it
function H.tag(parent, name, size, props)
	local tag = H.frame(parent, name, props)
	tag.Size = size
	tag.BackgroundTransparency = 0
	H.edge(tag, SIGN.Wood, 2)
	H.text(tag, "Text", "", "Tag", 18, INK, { Size = UDim2.new(1, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	return tag
end

function H.paintTag(tag, face, ink)
	tag.BackgroundColor3 = face
	tag:FindFirstChild("Text").TextColor3 = ink or Theme.TextOn(face)
end

-- (kit-b U9-7) a sunk stone well around a list (the pitch's .wl): flat, its own darker edge
function H.well(obj)
	obj.BackgroundColor3 = SIGN.Well
	obj.BackgroundTransparency = 0
	H.edge(obj, SIGN.WellEdge, 2)
	return obj
end

-- (U9-7 look) a reward chip: the dock family's fact tag (ArenaController's factTag: a stone tag in a wood edge, its pixel
-- icon before the number), 30 px high and sized to its text. The End card's totals are a row of them (they were one
-- run-on line, "$1,630 170 tokens +360 XP", whose "XP" wrapped alone on a portrait phone)
function H.rewardChip(parent, name, icon, text)
	local chip = H.text(parent, name, text, "Heading", 19, INK, {
		BackgroundTransparency = 0,
		BackgroundColor3 = SIGN.Tile,
		Size = UDim2.fromOffset(0, K.CHIP_ROW),
		TextXAlignment = Enum.TextXAlignment.Center, -- (the fitted width runs generous: the icon and number sit centred)
	})
	H.edge(chip, SIGN.Wood, 2)
	local pad = H.pad(chip, 9, 0, 9, 1)
	PixelIcon.Lead(chip, icon)
	local ok, size = pcall(Theme.Measure, text, "Heading", 19)
	local tw = math.max((ok and typeof(size) == "Vector2") and size.X or 0, #text * 19 * 0.55)
	chip.Size = UDim2.fromOffset(math.ceil(tw) + pad.PaddingLeft.Offset + pad.PaddingRight.Offset + 4, K.CHIP_ROW)
	return chip
end

-- (U9-7 look) the pitch toast's icon tile: a 30 px stone square in a wood edge, an 18 px pixel icon in its middle
-- (H.setIconTile picks the icon; nil hides the tile)
function H.iconTile(parent, name, props)
	local tile = H.text(parent, name, "", "Heading", 18, INK, props)
	tile.BackgroundTransparency = 0
	tile.BackgroundColor3 = SIGN.Tile
	tile.Size = UDim2.fromOffset(K.ICON_TILE, K.ICON_TILE)
	tile.Visible = false
	H.edge(tile, SIGN.Wood, 2)
	return tile
end

function H.setIconTile(tile, icon)
	tile.Visible = icon ~= nil
	PixelIcon.Set(tile, icon, 18, INK)
end

function H.clear(frame)
	for _, c in ipairs(frame:GetChildren()) do
		if c:IsA("GuiObject") then
			c:Destroy()
		end
	end
end

function H.commas(n)
	return Util.Commas(math.floor((tonumber(n) or 0) + 0.5))
end

function H.clock(seconds)
	local s = math.max(0, math.floor((tonumber(seconds) or 0) + 0.5))
	return string.format("%d:%02d", math.floor(s / 60), s % 60)
end

function H.tween(inst, seconds, goal, style, direction)
	local t = TweenService:Create(inst, TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out), goal)
	t:Play()
	return t
end

function H.attr(name)
	return LocalPlayer and LocalPlayer:GetAttribute(name) or nil
end

function H.inMatch()
	return H.attr(Config.Attr.InMatch) == true
end

-- the dungeon run id while the player is in a run (InBattle = "D12"), else nil
function H.runAttr()
	local v = H.attr((Config.Attr and Config.Attr.InBattle) or "InBattle")
	if type(v) == "string" and v:sub(1, 1) == "D" then
		return v
	end
	return nil
end

function H.viewport()
	local camera = Workspace.CurrentCamera
	local vp = camera and camera.ViewportSize
	if not vp or vp.X < 2 or vp.Y < 2 then
		return Vector2.new(1920, 1080)
	end
	return vp
end

function H.isPhone()
	local vp = H.viewport()
	return math.min(vp.X, vp.Y) < 500
end

function H.rootPosition()
	local character = LocalPlayer and LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root and root:IsA("BasePart") then
		return root.Position
	end
	return nil
end

function H.positionOf(inst)
	if typeof(inst) ~= "Instance" then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, cf = pcall(function()
			return inst:GetBoundingBox()
		end)
		if ok and cf then
			return cf.Position
		end
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- floor data from the catalog: { Name, Element, Floor } (a plain fallback when the catalog is missing)
function H.floorInfo(f)
	local BC = H.catalog()
	local list = BC and BC.DungeonFloors
	local info = type(list) == "table" and list[f] or nil
	if type(info) == "table" then
		return info
	end
	return { Name = "Floor " .. tostring(f), Element = nil, Floor = f }
end

function H.floorCount()
	local BC = H.catalog()
	local D = BC and BC.Dungeon
	return math.max(1, math.floor(tonumber(D and D.Floors) or K.FLOORS))
end

function H.elementColor(element)
	local info = Config.Elements and Config.Elements.Info and Config.Elements.Info[element]
	return info and info.Color or C.Accent
end

function H.recommended(f)
	local BC = H.catalog()
	if BC and type(BC.DungeonPower) == "function" then
		local ok, p = pcall(BC.DungeonPower, f, 1)
		if ok and tonumber(p) then
			return math.max(1, math.ceil(tonumber(p) - 1e-9))
		end
	end
	return nil
end

function H.dungeonNumber(field, default)
	local BC = H.catalog()
	local D = BC and BC.Dungeon
	return tonumber(D and D[field]) or default
end

-- (quick wins, review round 1) the party cap: the Lobby payload's Max (DungeonService MAX_PARTY), else a party entry's
-- Max, else 4 (a party is the player + Max - 1 friends)
function H.partyMax()
	local lobby = S.Lobby
	local n = lobby and tonumber(lobby.Max) or nil
	if not n and lobby and type(lobby.Parties) == "table" and type(lobby.Parties[1]) == "table" then
		n = tonumber(lobby.Parties[1].Max)
	end
	return (n and n >= 2 and n < 100) and math.floor(n) or 4
end

-- the saved record: the Lobby payload's Record (fresh from the server) or State.Dungeon()
function H.record()
	local rec = S.Lobby and type(S.Lobby.Record) == "table" and S.Lobby.Record or nil
	local out = { Best = 0, Cleared = {}, Runs = 0, Clears = 0 }
	if not rec and type(State.Dungeon) == "function" then
		local ok, d = pcall(State.Dungeon)
		rec = ok and type(d) == "table" and d or nil
	end
	if rec then
		out.Best = math.floor(tonumber(rec.Best) or 0)
		out.Runs = math.floor(tonumber(rec.Runs) or 0)
		out.Clears = math.floor(tonumber(rec.Clears) or 0)
		if type(rec.Cleared) == "table" then
			for i = 1, K.FLOORS do
				if rec.Cleared[i] == true then
					out.Cleared[i] = true
				end
			end
		end
	end
	return out
end

-- floor f is open for the player as a leader: Best >= f - 1 (members are carried; the server decides)
function H.unlocked(f, rec)
	rec = rec or H.record()
	return f <= 1 or rec.Best >= f - 1 or rec.Cleared[f - 1] == true
end

function H.nextFloor(rec)
	rec = rec or H.record()
	return math.min(H.floorCount(), math.max(1, rec.Best + 1))
end

----------------------------------------------------------------------
-- The player's team power (team -> equipped -> best owned; training skipped), like the server's TeamSpec
----------------------------------------------------------------------
function H.teamPower()
	local now = os.clock()
	if H.PowerAt and now - H.PowerAt < 1 and H.PowerSnap == State.Get() then
		return H.Power
	end
	H.PowerAt, H.PowerSnap = now, State.Get()
	H.Power = H.teamPowerNow()
	return H.Power
end

function H.teamPowerNow()
	return TeamFaces.Power()
end

----------------------------------------------------------------------
-- Requests (DungeonRequest; spaced here, validated on the server)
----------------------------------------------------------------------
function H.request(action, a, b)
	local now = os.clock()
	local key = tostring(action) .. "|" .. tostring(a)
	if S.LastFire[key] and now - S.LastFire[key] < K.FIRE_GAP then
		return false
	end
	if not H.remote then
		local ok, remote = pcall(Remotes.Get, "DungeonRequest")
		H.remote = ok and remote or nil
	end
	if not H.remote then
		return false
	end
	S.LastFire[key] = now
	local ok, err = pcall(function()
		H.remote:FireServer(action, a, b)
	end)
	if not ok then
		H.warnOnce("DungeonRequest " .. tostring(action), err)
	end
	return ok
end

function H.hint(text, seconds)
	S.Hint = { Text = tostring(text), Until = os.clock() + (seconds or 4) }
	if S.Open then
		H.safe("footer", W.footer)
	end
end

----------------------------------------------------------------------
-- The window (CloudUI.Panel on NeonKit.Dock)
----------------------------------------------------------------------
function W.build()
	if S.Built then
		return true
	end
	S.Built = true
	local holder = H.frame(U.Gui, "Window_Dungeon", { Size = UDim2.fromOffset(K.PREF_W, K.PREF_H), Visible = false, ZIndex = 3 })
	U.Holder = holder
	U.Fit = Util.Create("UIScale", { Name = "Fit", Scale = 1, Parent = holder })
	U.Dock = NeonKit.Dock(holder, U.Fit, K.PREF_W, K.PREF_H)
	local panel = CloudUI.Panel({
		Name = "DungeonPanel",
		Title = "The Dungeon",
		Closable = true,
		Skin = "Signboard", -- (kit-b U9-7) roof, navy header with the key, wood frame, stone body
		Icon = Config.Icons.Dungeon,
		Size = UDim2.new(1, 0, 1, 0),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		OnClose = function()
			DungeonController.Close()
		end,
		Parent = holder,
	})
	U.Panel = panel
	-- (U9-7 look) a docked window's band stays inside the frame, no tails (its right tail ran off the screen edge): the
	-- header shape Index and the Food Machine wear on the same dock
	SignKit.HeaderOverhang(panel.TitleBar, false)
	U.Pop = Util.Create("UIScale", { Name = "Pop", Scale = 1, Parent = panel.Root })
	local content = panel.Content
	-- the record line
	-- (U9-7 look) the dock family's page inset (CloudUI.Metrics.SignPagePad) on the record line, the lists and the hint
	local PAD = CloudUI.Metrics.SignPagePad
	U.Top = H.frame(content, "Top", { Position = UDim2.fromOffset(PAD, 0), Size = UDim2.new(1, -2 * PAD, 0, 30) })
	U.Record = H.text(U.Top, "Record", "", "Heading", 19, INK, { Size = UDim2.new(1, -110, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	U.Power = H.text(U.Top, "Power", "", "Heading", 19, INK, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 106, 1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	PixelIcon.Lead(U.Power, "sword") -- (kit-b U7b) the team's power
	-- the floor list
	U.Floors = Instance.new("ScrollingFrame")
	U.Floors.Name = "Floors"
	H.well(U.Floors)
	U.Floors.BorderSizePixel = 0
	SignKit.ScrollBar(U.Floors) -- (U9-7 look) the kit's wood bar, square ends
	U.Floors.ScrollingDirection = Enum.ScrollingDirection.Y
	U.Floors.AutomaticCanvasSize = Enum.AutomaticSize.Y
	U.Floors.CanvasSize = UDim2.new(0, 0, 0, 0)
	U.Floors.Position = UDim2.fromOffset(PAD, 36)
	U.Floors.Parent = content
	H.pad(U.Floors, 8, 8, 14, 8)
	H.list(U.Floors, Enum.FillDirection.Vertical, 6)
	U.FloorRows = {}
	for f = 1, H.floorCount() do
		U.FloorRows[f] = W.floorRow(f)
	end
	-- the party box
	U.Party = Instance.new("ScrollingFrame")
	U.Party.Name = "Party"
	H.well(U.Party)
	U.Party.BorderSizePixel = 0
	SignKit.ScrollBar(U.Party)
	U.Party.ScrollingDirection = Enum.ScrollingDirection.Y
	U.Party.AutomaticCanvasSize = Enum.AutomaticSize.Y
	U.Party.CanvasSize = UDim2.new(0, 0, 0, 0)
	U.Party.Parent = content
	H.pad(U.Party, 10, 8, 10, 8)
	H.list(U.Party, Enum.FillDirection.Vertical, 6)
	-- the footer hint
	U.Footer = H.text(content, "Footer", "", "Body", 18, C.Muted, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, PAD, 1, 0),
		Size = UDim2.new(1, -2 * PAD, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	return true
end

-- one floor row (a TextButton: tap to select it). (kit-b U9-7) a stone block (pale gold with an ink edge when picked, a
-- sunk well when locked: W.refreshFloors) with a square stripe in the floor's element colour, the floor's number on a
-- square tile in that colour (was a glossy orb), the name and the status, a square tag at the right
function W.floorRow(f)
	local info = H.floorInfo(f)
	local color = H.elementColor(info.Element)
	local row = Instance.new("TextButton")
	row.Name = "Floor" .. f
	row.AutoButtonColor = false
	row.Text = ""
	row.BorderSizePixel = 0
	row.Size = UDim2.new(1, 0, 0, K.ROW_H)
	row.LayoutOrder = f
	row.Parent = U.Floors
	CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = 4, Pad = false })
	H.frame(row, "Stripe", { BackgroundTransparency = 0, BackgroundColor3 = color, Size = UDim2.new(0, 6, 1, -16), Position = UDim2.fromOffset(4, 6) })
	local face = H.readable(color)
	local badge = H.frame(row, "Badge", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.5, -2),
		Size = UDim2.fromOffset(42, 42),
		BackgroundTransparency = 0,
		BackgroundColor3 = face,
	})
	H.edge(badge, SIGN.Wood, 2)
	H.frame(badge, "Lip", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundTransparency = 0,
		BackgroundColor3 = Theme.Darken(face, 0.22),
	})
	local num = H.text(badge, "Num", tostring(f), "Title", 22, Theme.TextOn(face), {
		Size = UDim2.new(1, 0, 1, -4),
		TextXAlignment = Enum.TextXAlignment.Center,
	})
	local name = H.text(row, "FloorName", info.Name, "Heading", 21, INK, {
		Position = UDim2.fromOffset(70, 6),
		Size = UDim2.new(1, -190, 0, 28),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local sub = H.text(row, "Status", "", "Body", 18, MUTED, {
		Position = UDim2.fromOffset(70, 34),
		Size = UDim2.new(1, -190, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local chip = H.tag(row, "Chip", UDim2.fromOffset(106, 34), {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, -2),
	})
	row.Activated:Connect(function()
		H.safe("pick floor", W.pick, f)
	end)
	return { Root = row, Orb = badge, Num = num, Name = name, Sub = sub, Chip = chip, ChipText = chip:FindFirstChild("Text"), Color = color }
end

-- a tap on floor f: select it (the leader of a party also moves the party's floor)
function W.pick(f)
	local rec = H.record()
	local mine = S.Lobby and S.Lobby.Mine or nil
	if mine and LocalPlayer and mine.Leader ~= LocalPlayer.UserId then
		H.hint("The party leader picks the floor")
		return
	end
	if not H.unlocked(f, rec) then
		H.hint("Clear floor " .. (f - 1) .. " first")
		return
	end
	S.Floor = f
	if mine then
		H.request("SetFloor", f)
	end
	W.refresh()
end

function W.selected()
	local mine = S.Lobby and S.Lobby.Mine or nil
	if mine and tonumber(mine.Floor) then
		return math.floor(mine.Floor)
	end
	local rec = H.record()
	local f = S.Floor or H.nextFloor(rec)
	if not H.unlocked(f, rec) then
		f = H.nextFloor(rec)
	end
	return f
end

function W.refreshFloors(rec, short)
	local sel = W.selected()
	local nextF = H.nextFloor(rec)
	local power = H.teamPower()
	for f, ui in ipairs(U.FloorRows) do
		local open = H.unlocked(f, rec)
		local cleared = rec.Cleared[f] == true
		local rp = H.recommended(f)
		local h = short and K.ROW_H_SHORT or K.ROW_H
		ui.Root.Size = UDim2.new(1, 0, 0, h)
		ui.Name.Position = UDim2.fromOffset(70, short and 2 or 6)
		ui.Sub.Position = UDim2.fromOffset(70, short and 26 or 34)
		ui.Sub.Size = UDim2.new(1, -190, 0, short and 22 or 24)
		-- (kit-b U9-7) the tag by role: a locked floor a sunk well in muted ink, a cleared one stone with the green tick,
		-- the next floor gold (the one to go for), any other open floor sky
		local status, subColor, chip, chipFace, chipInk
		if not open then
			status = "Clear floor " .. (f - 1) .. " first"
			subColor = MUTED
			chip, chipFace, chipInk = "LOCKED", SIGN.Well, MUTED
		elseif cleared then
			status = "Cleared"
			subColor = C.Good
			chip, chipFace, chipInk = "CLEARED", SIGN.Tile, C.Good
		else
			status = "Recommended " .. (rp and H.commas(rp) or "?") -- (U9-7 look) the sword says "power" (PixelIcon.Mark below)
			subColor = (rp and power >= rp) and C.Good or C.Warn
			if f == nextF then
				chip, chipFace = "NEXT", SIGN.Gold
			else
				chip, chipFace = "OPEN", SIGN.Sky
			end
		end
		ui.Sub.Text = status
		PixelIcon.Mark(ui.Sub, (not open) and "lock" or (cleared and "check" or "sword")) -- (kit-b U7b)
		ui.Sub.TextColor3 = subColor
		ui.ChipText.Text = chip
		H.paintTag(ui.Chip, chipFace, chipInk)
		local picked = f == sel
		CloudUI.SignBlock(ui.Root, open and "Stone" or "Off", {
			Face = picked and SIGN.Selected or nil,
			Edge = picked and SIGN.Text or nil,
			EdgePx = picked and 3 or 2,
			LipPx = 4,
			Pad = false,
		})
		ui.Name.TextColor3 = open and INK or MUTED
		ui.Root:SetAttribute("Selected", f == sel)
		ui.Root:SetAttribute("Unlocked", open)
		ui.Root:SetAttribute("Cleared", cleared)
	end
end

-- a button inside the party box and on the cards; returns the TextButton. (kit-b U9-7) a kit B block (CloudUI's Sign
-- skin; was a NeonKit neon button): style is a CloudUI style, Green THE main action of the view, Red leave / remove,
-- Gray a stone block
function W.button(parent, name, text, style, size, order, callback)
	return CloudUI.Button({
		Name = name,
		Text = text,
		Style = style,
		Skin = "Sign",
		Size = size,
		TextSize = 20,
		LayoutOrder = order,
		Parent = parent,
		Callback = function()
			H.safe(name, callback)
		end,
	})
end

function W.setDisabled(button, disabled)
	if button then
		button:SetAttribute("Disabled", disabled == true)
	end
end

-- seconds left of the party countdown (ticks locally between two Lobby payloads)
function W.countdown(mine)
	local n = mine and tonumber(mine.Countdown)
	if not n then
		return nil
	end
	return math.max(0, math.ceil(n - (os.clock() - S.LobbyAt) - 1e-6))
end

function W.allReady(mine)
	for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" and m.Ready ~= true and m.UserId ~= mine.Leader then
			return false
		end
	end
	return true
end

function W.myReady(mine)
	if S.ReadyWant ~= nil then
		return S.ReadyWant
	end
	for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" and LocalPlayer and m.UserId == LocalPlayer.UserId then
			return m.Ready == true
		end
	end
	return false
end

-- -> the countdown line, its short form (playtest 2026-11-28 C34: a 360 px portrait phone's chip holds about 66 design
-- px of words beside the five blocks, so "Dungeon in 4..." read "Dung..." and the seconds were lost; R.fitChip swaps in
-- the short form when the long one would truncate)
function W.countdownText(mine)
	local left = W.countdown(mine)
	if not left then
		return nil
	end
	if W.allReady(mine) then
		return "Dungeon in " .. left .. "...", "In " .. left .. "..."
	end
	-- (the short form beside the chip's green READY: "Starts in 19" was still 5 px too wide for a 360 px portrait phone)
	return "Starting in " .. left .. " - press READY", "In " .. left
end

-- the party box when the player has no party: SOLO / PARTY + the open parties
function W.partyNone(box, short, sel)
	local info = H.floorInfo(sel)
	H.text(box, "Title", "Floor " .. sel .. " " .. G.Dot .. " " .. tostring(info.Name), "Heading", 20, INK, {
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	})
	W.faces(box)
	local row = H.frame(box, "Buttons", { Size = W.buttonRow(short), LayoutOrder = 3 })
	H.list(row, Enum.FillDirection.Horizontal, 10)
	local bw = UDim2.new(0.5, -5, 1, 0)
	U.Solo = W.button(row, "SoloButton", "Solo", "Green", bw, 1, function()
		H.withTeam(function()
			if H.request("Solo", W.selected()) then
				H.hint("Starting floor " .. W.selected() .. "...", 3)
			end
		end)
	end)
	U.Create = W.button(row, "PartyButton", "Party", "Gray", bw, 2, function()
		H.withTeam(function()
			if H.request("Create", W.selected()) then
				H.hint("Party made! Friends can JOIN it here", 4)
			end
		end)
	end)
	local parties = {}
	for _, p in ipairs(S.Lobby and type(S.Lobby.Parties) == "table" and S.Lobby.Parties or {}) do
		if type(p) == "table" then
			parties[#parties + 1] = p
		end
	end
	local maxRows = W.maxParties(short)
	H.text(box, "OpenTitle", (#parties > 0) and "Open parties" or "No open parties yet - make one!", "Heading", 18, C.Muted, {
		Size = UDim2.new(1, 0, 0, 24),
		LayoutOrder = 4,
	})
	for i, p in ipairs(parties) do
		if i > maxRows then
			break
		end
		W.partyRow(box, p, i, short)
	end
end

function W.partyRow(box, p, i, short)
	local row = H.frame(box, "Open" .. i, { Size = UDim2.new(1, 0, 0, W.openRowH(short)), LayoutOrder = 4 + i })
	CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = 3 }) -- (kit-b U9-7) a stone tile in the well
	local count = tostring(p.Count or 1) .. "/" .. tostring(p.Max or 4)
	local where = p.InRun and ("room " .. tostring(p.Room or 1)) or ("Floor " .. tostring(p.Floor or 1)) -- (U9-7 look) fits a phone row
	-- (kit-b U9-7) the leader with the crown (the list is headed "Open parties"; "'s party" ran past a phone's row)
	local label = H.text(row, "Text", tostring(p.LeaderName or "Someone") .. " " .. G.Dot .. " " .. where .. " " .. G.Dot .. " " .. count, "Body", 18, INK, {
		Position = UDim2.fromOffset(10, 0),
		Size = UDim2.new(1, -114, 1, 0), -- (merge kitb-look1) -114 (was -120): the crown's 6 px gap; 2 px clear of Join
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
	PixelIcon.Lead(label, "crown")
	local join = W.button(row, "JoinButton", p.Open and "Join" or (p.InRun and "Busy" or "Full"), "Gray", UDim2.fromOffset(96, W.openRowH(short) - 8), 1, function()
		if not p.Open then
			return
		end
		H.withTeam(function()
			if H.request("Join", p.Leader) then
				H.hint("Joining " .. tostring(p.LeaderName or "the") .. "'s party...", 3)
			end
		end)
	end)
	join.AnchorPoint = Vector2.new(1, 0.5)
	join.Position = UDim2.new(1, -6, 0.5, -1)
	W.setDisabled(join, p.Open ~= true)
	join:SetAttribute("Leader", p.Leader)
end

-- the party box of the player's own party
function W.partyMine(box, short, mine)
	local me = LocalPlayer and LocalPlayer.UserId
	local leader = mine.Leader == me
	local f = math.floor(tonumber(mine.Floor) or 1)
	local info = H.floorInfo(f)
	H.text(box, "Title", (leader and "Your party" or "Party") .. " " .. G.Dot .. " Floor " .. f .. " " .. G.Dot .. " " .. tostring(info.Name), "Heading", 20, INK, {
		Size = UDim2.new(1, 0, 0, 26),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 1,
	})
	W.faces(box)
	local cd = W.countdownText(mine)
	U.Countdown = H.text(box, "Countdown", cd or (leader and "Press START when everyone is READY" or "Press READY, the leader starts"), "Body", 18, cd and C.Warn or MUTED, {
		Size = UDim2.new(1, 0, 0, 24),
		TextTruncate = Enum.TextTruncate.AtEnd,
		LayoutOrder = 3,
	})
	local h = short and K.MEMBER_H_SHORT or K.MEMBER_H
	for i, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
		if type(m) == "table" then
			local isMe = m.UserId == me
			local ready = m.Ready == true
			if isMe and S.ReadyWant ~= nil and not leader then
				ready = S.ReadyWant
			end
			-- (kit-b U9-7) a stone tile, my own pale gold
			local row = H.frame(box, "Member" .. i, { Size = UDim2.new(1, 0, 0, h), LayoutOrder = 10 + i })
			CloudUI.SignBlock(row, "Stone", { EdgePx = 2, LipPx = 3, Face = isMe and SIGN.Selected or nil })
			row:SetAttribute("UserId", m.UserId)
			row:SetAttribute("Ready", ready)
			local tick = H.text(row, "Ready", "", "Heading", 20, ready and C.Good or MUTED, {
				Position = UDim2.fromOffset(8, 0),
				Size = UDim2.new(0, 28, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Center,
			})
			PixelIcon.Set(tick, ready and "check" or "hourglass", 18) -- (kit-b U7b)
			tick:SetAttribute("Ready", ready)
			-- (merge kitb-look1) 4 px wider (-186, was -190): the leader's crown keeps a whole 6 screen px from the name now
			local name = H.text(row, "Name", tostring(m.Name or "?"), "Body", 19, INK, { Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -186, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
			if m.UserId == mine.Leader then
				PixelIcon.Lead(name, "crown") -- (kit-b U7b) the party leader
			end
			PixelIcon.Lead(H.text(row, "Power", H.commas(m.Power or 0), "Heading", 18, INK, {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, leader and not isMe and -52 or -10, 0, 0),
				Size = UDim2.new(0, 110, 1, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
			}), "sword")
			if leader and not isMe then
				local kick = W.button(row, "KickButton", "", "Red", UDim2.fromOffset(38, h - 10), 1, function()
					if H.request("Kick", m.UserId) then
						H.hint("Removed " .. tostring(m.Name or "the player"), 3)
					end
				end)
				-- (review round 1) the drawn X of every close button, not the U+2715 glyph; (kit-b U9-7) square bars in the
				-- Danger block's brown ink, the windows' red X
				NeonKit.CloseMark(kick, { Square = true, Ink = SIGN.RedLip, Color = SIGN.Text })
				kick.AnchorPoint = Vector2.new(1, 0.5)
				kick.Position = UDim2.new(1, -6, 0.5, -1)
				kick:SetAttribute("UserId", m.UserId)
			end
		end
	end
	-- the buttons come before the member list (a phone's sheet bottom sits under the thumbstick / jump buttons); (U9-7 look) a
	-- landscape phone puts them right under the title, before the faces (the box's fold cut them through their labels)
	local row = H.frame(box, "Buttons", { Size = W.buttonRow(short), LayoutOrder = short and 2 or 4 })
	if short then
		if U.Faces then
			U.Faces.Root.LayoutOrder = 3
		end
		U.Countdown.LayoutOrder = 4
	end
	H.list(row, Enum.FillDirection.Horizontal, 10)
	local bw = UDim2.new(0.5, -5, 1, 0)
	if leader then
		-- (START needs only the leader's own team: the server checks every member's)
		U.Start = W.button(row, "StartButton", "Start", "Green", bw, 1, function()
			H.withTeam(function()
				if H.request("Start") then
					H.hint(W.allReady(mine) and "Starting..." or "Waiting 30 s for READY...", 3)
				end
			end)
		end)
		W.setDisabled(U.Start, W.countdown(mine) ~= nil and W.allReady(mine))
	else
		local want = W.myReady(mine)
		U.Ready = W.button(row, "ReadyButton", want and "Not ready" or "Ready", want and "Gray" or "Green", bw, 1, function()
			local now = not W.myReady(mine)
			local function send()
				if H.request("Ready", now) then
					S.ReadyWant = now -- optimistic: the next Lobby payload is the truth
					W.refresh()
				end
			end
			if now then
				H.withTeam(send) -- READY needs a team; NOT READY never asks
			else
				send()
			end
		end)
	end
	U.LeaveParty = W.button(row, "LeaveButton", "Leave", "Red", bw, 2, function()
		if H.request("Leave") then
			S.ReadyWant = nil
			H.hint("You left the party", 3)
		end
	end)
end

-- the team's faces at the top of the party box (LayoutOrder 2; the Compact row on a phone: its window is narrow and low)
function W.faces(box)
	U.Faces = TeamFaces.New(box, { LayoutOrder = 2, Compact = S.Short or W.narrow(), ReturnTo = H.panelReturn })
end

function W.narrow()
	local rect = U.Dock and U.Dock.Rect
	return rect ~= nil and rect.designW < K.FACES_NARROW
end

-- the row's height in the party box (+ the list padding), 0 without one
function W.facesHeight()
	local row = U.Faces
	if row and row.Root.Parent then
		return row.Height() + 6
	end
	return 0
end

-- the party box's buttons: >= 44 px on a phone (the panel's 0.8 touch scale)
function W.buttonH(short)
	if H.isPhone() then
		return K.TOUCH_H
	end
	return short and 46 or 52
end

-- the row of SOLO / PARTY or READY / LEAVE: on a landscape phone it stops short of Roblox's jump button
function W.buttonRow(short)
	return UDim2.new(1, (short and H.isPhone()) and -K.JUMP_INSET or 0, 0, W.buttonH(short))
end

function W.openRowH(short)
	if H.isPhone() then
		return K.TOUCH_H + 6
	end
	return short and 40 or 44
end

-- open parties shown at once: 3 on desktops, 2 on a portrait phone, 1 on a landscape phone (the jump button corner)
function W.maxParties(short)
	if short then
		return 1
	end
	return H.isPhone() and 2 or 3
end

function W.partyHeight(short, mine)
	local h = 16 + W.facesHeight()
	if mine then
		local n = #(type(mine.Members) == "table" and mine.Members or {})
		h = h + 26 + 24 + n * ((short and K.MEMBER_H_SHORT or K.MEMBER_H) + 6) + W.buttonH(short) + 18
	else
		local parties = S.Lobby and type(S.Lobby.Parties) == "table" and #S.Lobby.Parties or 0
		local rows = math.min(parties, W.maxParties(short))
		h = h + 26 + W.buttonH(short) + 24 + rows * (W.openRowH(short) + 6) + 18
	end
	return h
end

-- (U9-7 look) the party box ends on a whole row: as tall as the rows that fit in `avail` (the next one starts at the box's
-- edge; the fold cut a Join, a Kick or Ready / Leave through their labels), `avail` when every row fits. The rows as
-- partyNone / partyMine lay them out: the 8 px pad, 6 px gaps
function W.partyBoxH(avail, short, mine)
	local faces = math.max(0, W.facesHeight() - 6)
	local buttons = W.buttonH(short)
	local hs = { 26 }
	if mine then
		local rest = short and { buttons, faces, 24 } or { faces, 24, buttons }
		for _, h in ipairs(rest) do
			hs[#hs + 1] = h
		end
		for _ = 1, #(type(mine.Members) == "table" and mine.Members or {}) do
			hs[#hs + 1] = short and K.MEMBER_H_SHORT or K.MEMBER_H
		end
	else
		for _, h in ipairs({ faces, buttons, 24 }) do
			hs[#hs + 1] = h
		end
		local parties = S.Lobby and type(S.Lobby.Parties) == "table" and #S.Lobby.Parties or 0
		for _ = 1, math.min(parties, W.maxParties(short)) do
			hs[#hs + 1] = W.openRowH(short)
		end
	end
	local y, best = 8, nil
	for _, h in ipairs(hs) do
		if h > 0 then
			if y + h + 6 > avail then
				return best or avail
			end
			best = y + h + 6
			y = best
		end
	end
	return avail
end

function W.footer()
	if not U.Footer then
		return
	end
	local text = ""
	if S.Hint and os.clock() < S.Hint.Until then
		text = S.Hint.Text
	else
		local rec = H.record()
		local sel = W.selected()
		local rp = H.recommended(sel)
		local power = H.teamPower()
		if rp and power > 0 and power < rp then
			text = "Your team looks weak for floor " .. sel .. ". Train it, or bring friends!"
		elseif rec.Best >= H.floorCount() then
			text = "Every floor cleared! Run them again for loot."
		else
			text = "Rooms, waves and a boss. Solo or up to " .. tostring(H.partyMax() - 1) .. " friends." -- (you + the rest)
		end
	end
	U.Footer.Text = text
end

function W.layout()
	if not U.Dock then
		return
	end
	U.Dock.Refresh()
	local rect = U.Dock.Rect
	if not rect then
		return
	end
	S.Short = rect.designH < K.SHORT
end

function W.refresh()
	if not S.Built or not S.Open then
		return
	end
	W.layout()
	local short = S.Short
	local rec = H.record()
	local power = H.teamPower()
	U.Record.Text = "Best: floor " .. rec.Best .. " " .. G.Dot .. " " .. rec.Clears .. " clears " .. G.Dot .. " " .. rec.Runs .. " runs"
	U.Power.Text = H.commas(power)
	W.refreshFloors(rec, short)
	-- the party box (rebuilt: a handful of frames, only on a payload / a tap)
	local mine = S.Lobby and type(S.Lobby.Mine) == "table" and S.Lobby.Mine or nil
	local sig = W.partySig(mine, short)
	if sig ~= S.PartySig then
		S.PartySig = sig
		if U.Faces then
			U.Faces.Destroy()
			U.Faces = nil
		end
		H.clear(U.Party)
		U.Countdown, U.Start, U.Ready, U.Solo, U.Create = nil, nil, nil, nil, nil
		if mine then
			W.partyMine(U.Party, short, mine)
		else
			W.partyNone(U.Party, short, W.selected())
		end
	elseif mine and U.Countdown then
		local cd = W.countdownText(mine)
		if cd then
			U.Countdown.Text = cd
			U.Countdown.TextColor3 = C.Warn
		end
	end
	local contentH = U.Holder.Size.Y.Offset - 82
	local partyH = W.partyHeight(short, mine)
	-- phones: no footer line (the bottom edge of the sheet sits under Roblox's thumbstick / jump buttons)
	local footerH = H.isPhone() and 0 or 26
	U.Footer.Visible = footerH > 0
	local listH = math.max(short and K.LIST_MIN_SHORT or 150, contentH - 36 - partyH - footerH - 12)
	if short then
		listH = K.LIST_MIN_SHORT
	end
	-- (U9-7 look) whole rows only: the list's top pad and n rows with their gaps (238 px at 1080p showed half a row at
	-- each end); what is left goes to the party box under it
	local rowStep = (short and K.ROW_H_SHORT or K.ROW_H) + 6
	listH = 8 + math.max(1, math.floor((listH - 8) / rowStep)) * rowStep
	local pad = CloudUI.Metrics.SignPagePad
	U.Floors.Size = UDim2.new(1, -2 * pad, 0, listH)
	U.Party.Position = UDim2.fromOffset(pad, 36 + listH + 6)
	U.Party.Size = UDim2.new(1, -2 * pad, 0, W.partyBoxH(math.max(60, contentH - 36 - listH - 6 - footerH - 6), short, mine))
	W.footer()
	if S.ScrollTo then
		-- bring the selected floor into view once after opening
		local f = S.ScrollTo
		S.ScrollTo = nil
		local rowH = (short and K.ROW_H_SHORT or K.ROW_H) + 6
		local top = 8 + (f - 1) * rowH
		local maxY = math.max(0, 8 + H.floorCount() * rowH + 8 - listH)
		-- (U9-7 look) the selected row whole at the top of the list, on every screen (a portrait sheet kept the list at
		-- floor 1 and showed floors 1-2 with the picked floor 3 under the fold; half a row above it read as cut on PC). The
		-- coverage checks clip a scrolling frame's rows to it, so the rows scrolled away no longer count as covered screen
		local want = top - 8
		-- CanvasPosition is screen px (it runs to AbsoluteCanvasSize - AbsoluteWindowSize): the design px times the dock's
		-- scale (0.8 on a phone put the selected row half a row too high)
		local scale = (U.Dock.Rect and tonumber(U.Dock.Rect.scale)) or 1
		U.Floors.CanvasPosition = Vector2.new(0, math.max(0, math.min(maxY, want)) * scale)
	end
end

function W.partySig(mine, short)
	local parts = { tostring(short) }
	if mine then
		parts[#parts + 1] = "m" .. tostring(mine.Leader) .. ":" .. tostring(mine.Floor) .. ":" .. tostring(mine.Countdown ~= nil) .. ":" .. tostring(S.ReadyWant)
			.. ":" .. tostring(S.LobbyAt)
		for _, m in ipairs(type(mine.Members) == "table" and mine.Members or {}) do
			if type(m) == "table" then
				parts[#parts + 1] = tostring(m.UserId) .. tostring(m.Ready) .. tostring(m.Power)
			end
		end
	else
		parts[#parts + 1] = "n" .. tostring(W.selected())
		for _, p in ipairs(S.Lobby and type(S.Lobby.Parties) == "table" and S.Lobby.Parties or {}) do
			if type(p) == "table" then
				parts[#parts + 1] = tostring(p.Leader) .. ":" .. tostring(p.Floor) .. ":" .. tostring(p.Count) .. ":" .. tostring(p.Open) .. ":" .. tostring(p.Room)
			end
		end
	end
	return table.concat(parts, ",")
end

----------------------------------------------------------------------
-- Open / close
----------------------------------------------------------------------
function W.onBack(_name, inputState)
	if inputState == Enum.UserInputState.Begin and S.Open then
		DungeonController.Close()
		return Enum.ContextActionResult.Sink
	end
	return Enum.ContextActionResult.Pass
end

function W.syncBack()
	if S.Open == S.BackBound then
		return
	end
	S.BackBound = S.Open
	if S.Open then
		pcall(function()
			ContextActionService:BindActionAtPriority(K.BACK_ACTION, W.onBack, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.ButtonB)
		end)
	else
		pcall(function()
			ContextActionService:UnbindAction(K.BACK_ACTION)
		end)
	end
end

-- (kit-b U9-7) on a touch screen Roblox's thumbstick and jump button go while the window is open (the jump button sat on
-- SOLO and READY at 844x390) and come back as they were: MenuController keeps the one owner set (looked up at open / close
-- time: no require cycle), as the Index, the Pets window and the Arena do
function W.syncTouch()
	local want = S.Open == true and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	if want == (S.TouchOff == true) then
		return
	end
	S.TouchOff = want
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		H.safe("touch", menu.SetTouchHidden, "Dungeon", want)
	end
end

function W.closeOthers()
	for _, name in ipairs({ "MenuController", "IndexController", "FusionController", "CareController", "ArenaController", "ObbyController" }) do
		local mod = H.controller(name)
		if mod and type(mod.Close) == "function" then
			pcall(mod.Close)
		end
	end
end

function DungeonController.Open(floorIndex, portal)
	if not initialized then
		DungeonController.Init()
	end
	if not U.Gui or H.inMatch() then
		return false
	end
	if S.Run or H.runAttr() then
		return false -- inside a run the run card is the dungeon's UI
	end
	if not W.build() then
		return false
	end
	local n = tonumber(floorIndex)
	if n and n >= 1 and n <= H.floorCount() then
		S.Floor = math.floor(n)
	end
	S.AtPortal = (typeof(portal) == "Instance") and portal or nil
	local was = S.Open
	if not was then
		W.closeOthers()
	end
	S.Open = true
	S.Token = S.Token + 1
	S.PartySig = nil
	if not was then
		S.ScrollTo = W.selected()
	end
	W.syncBack()
	W.syncTouch()
	U.Holder.Visible = true
	if not was then
		U.Pop.Scale = 0.9
		H.tween(U.Pop, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	end
	H.request("Open")
	W.refresh()
	R.refresh()
	if not was then
		DungeonController.Opened:Fire("Dungeon")
	end
	return true
end

function DungeonController.Close()
	if not S.Open then
		return
	end
	S.Open = false
	S.AtPortal = nil
	S.Token = S.Token + 1
	local mine = S.Token
	W.syncBack()
	W.syncTouch()
	if U.Pop then
		H.tween(U.Pop, 0.12, { Scale = 0.92 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	end
	task.delay(0.13, function()
		if S.Token == mine and not S.Open and U.Holder then
			U.Holder.Visible = false
			U.Pop.Scale = 1
		end
	end)
	R.refresh()
	DungeonController.Closed:Fire("Dungeon")
end

function DungeonController.IsOpen()
	return S.Open == true
end

function DungeonController.Request(action, a, b)
	return H.request(action, a, b)
end

function DungeonController.GetState()
	return {
		Window = S.Open and "Dungeon" or nil,
		Floor = S.Built and W.selected() or S.Floor,
		Lobby = S.Lobby,
		Run = S.Run,
		End = S.End,
		Loot = S.Loot,
		Totals = S.Totals,
		Ready = S.ReadyWant,
		Lit = S.Lit,
		CardMode = S.CardMode,
		Countdown = S.Lobby and S.Lobby.Mine and W.countdown(S.Lobby.Mine) or nil,
		Fade = S.Fade and S.Fade.Phase or nil, -- "Out" | "Hold" | "In" while the room change fade shows
		Door = (S.Run and R.doorWait()) or nil, -- "press" | "wait" | "go" at an open door
		Enter = S.Enter and S.Enter.Phase or nil, -- "Rush" | "Cover" | "Hold" | "Reveal" while the entrance plays
		Walk = S.Walk and S.Walk.Phase or nil, -- "Hold" | "Walk" | "Blend" while the room walk-in plays
		WalkSkip = S.WalkSkip, -- wave 6: why the last room payload played no walk-in: "NoFade" | "FadeIn" | "InMatch" |
		-- "NoCharacter" | "NoRoom" | "Inward" | "Error" (nil = it played)
		Shoulder = S.ShoulderHum ~= nil,
	}
end

----------------------------------------------------------------------
-- The run card (desktop side card / phone top-band chip), the toasts and the End card
----------------------------------------------------------------------
function R.build()
	-- (IgnoreGuiInset stays false like every text-carrying gui; R.place converts screen px to the gui area)
	local gui = CloudUI.NewScreenGui("NimbusDungeonRun", K.RUN_ORDER)
	U.RunGui = gui
	-- the side card
	-- (kit-b U9-7) a hanging stone notice nailed up at its top corners, its lip in the floor's element colour (R.refresh)
	local card = NeonKit.Card({ Name = "RunCard", Skin = "Sign", Size = UDim2.fromOffset(K.CARD_W, 200), Color = C.Accent, LipPx = K.CARD_LIP, Parent = gui })
	SignKit.Nails(card.Root, { Inset = 5, ZIndex = 3 })
	card.Root.Visible = false
	U.Card = card
	U.CardScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = card.Root })
	local body = H.frame(card.Body, "List", { Size = UDim2.new(1, 0, 1, 0) })
	H.pad(body, 14, 10, 12, 12)
	H.list(body, Enum.FillDirection.Vertical, 6)
	U.CardList = body
	U.CardTitle = H.text(body, "Title", "", "Heading", 21, INK, { Size = UDim2.new(1, 0, 0, 28), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 1 })
	U.CardRoom = H.text(body, "Room", "", "Heading", 19, INK, { Size = UDim2.new(1, 0, 0, 26), RichText = false, LayoutOrder = 2 })
	U.CardWave = H.text(body, "Wave", "", "Body", 18, MUTED, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3 })
	-- (U9-7 look) a party's countdown as five gold blocks, one going out a second over the last five (the bars' one
	-- language: the loading bar's blocks, lip and all); in the Wave line's place, which a countdown never shows
	U.CardCount = SignKit.BlockRow(body, { Count = 5, BlockW = 22, BlockH = 14, Gap = 4, LipPx = 3 })
	U.CardCount.Name = "CountBlocks"
	U.CardCount.LayoutOrder = 3
	U.CardCount.Visible = false
	U.CardStatus = H.text(body, "Status", "", "Body", 19, INK, { Size = UDim2.new(1, 0, 0, 26), TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = 4 })
	-- (kit-b U9-7) the loot toast: a square plate in the toast's colour (gold loot, sky a lost room) with the ink that reads on it
	U.CardToast = H.frame(body, "LootToast", { BackgroundTransparency = 0, BackgroundColor3 = C.Gold, Size = UDim2.new(1, 0, 0, 58), Visible = false, LayoutOrder = 5 })
	H.edge(U.CardToast, SIGN.Wood, 2)
	H.pad(U.CardToast, 10, 6, 10, 6)
	U.CardToastText = H.text(U.CardToast, "Text", "", "Heading", 19, INK, { Size = UDim2.new(1, 0, 1, 0), TextWrapped = true })
	-- (U9-7 look) the pitch toast's icon tile at the plate's left (the room's chest, the chest's coin); the text after it
	U.CardToastIcon = H.iconTile(U.CardToast, "IconTile", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5) })
	U.CardMembers = H.frame(body, "Members", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 6 })
	Util.Create("UIGridLayout", { CellSize = UDim2.new(0.5, -4, 0, 26), CellPadding = UDim2.fromOffset(6, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = U.CardMembers })
	U.CardLoot = H.text(body, "Loot", "", "Heading", 18, C.Good, { Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 7 })
	local buttons = H.frame(body, "Buttons", { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = 8 })
	U.CardButtons = buttons
	H.list(buttons, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
	-- (bug batch 2 #14: no CHEST button; a chest is picked only with its own E prompt in the alcove)
	U.CardReady = W.button(buttons, "ReadyButton", "Ready", "Green", UDim2.new(0.5, -4, 1, 0), 2, R.ready)
	U.CardLeave = W.button(buttons, "LeaveButton", "Leave", "Red", UDim2.new(0.5, -4, 1, 0), 3, R.leave)
	-- the phone chip (one line in Roblox's top band)
	local chip = NeonKit.Card({ Name = "RunChip", Skin = "Sign", Size = UDim2.fromOffset(420, K.CHIP_H), Color = C.Accent, LipPx = 4, Parent = gui })
	chip.Root.Visible = false
	U.Chip = chip
	U.ChipScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 0.8, Parent = chip.Root })
	U.ChipText = H.text(chip.Body, "Text", "", "Heading", 19, INK, { Position = UDim2.fromOffset(12, 0), Size = UDim2.new(1, -112, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	-- (U9-7 look) a toast on the chip (a phone's loot / chest flash) wears the plate's icon tile before its words
	U.ChipIcon = H.iconTile(chip.Body, "IconTile", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0) })
	local function chipPress()
		if S.Run then
			R.leave()
		elseif S.Lobby and S.Lobby.Mine and LocalPlayer and S.Lobby.Mine.Leader ~= LocalPlayer.UserId and not W.myReady(S.Lobby.Mine) then
			R.ready()
		end
	end
	U.ChipButton = W.button(chip.Body, "LeaveButton", "Leave", "Red", UDim2.fromOffset(92, K.CHIP_LEAVE_H), 1, chipPress)
	U.ChipButton.AnchorPoint = Vector2.new(1, 0.5)
	U.ChipButton.Position = UDim2.new(1, -5, 0.5, 0)
	-- (keys look r3: the chip's Leave was a 74 x 30 px touch target on a phone; the battle card's Leave has its 44 px pad) a
	-- clear pad over the button, a thumb's K.CHIP_HIT screen px tall (the chip's 0.8 scale undone), centred on it
	local hit = Util.Create("TextButton", { Name = "LeaveHit", Text = "", BackgroundTransparency = 1, AutoButtonColor = false, BorderSizePixel = 0,
		AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = U.ChipButton.ZIndex + 2, Parent = U.ChipButton })
	hit:SetAttribute("HitFor", "LeaveButton")
	hit.Activated:Connect(chipPress)
	U.ChipHit = hit
	R.placeHit()
	-- (U9-7 look) the bars' one language on the phone chip too: the countdown's five gold blocks (the desktop card's row)
	-- and a run's room blocks, at the chip's right end before its button (R.fitChip places them and fits the chip round
	-- its words and blocks: it was a wide plank with only words, about 60 % blank)
	U.ChipCount = SignKit.BlockRow(chip.Body, { Count = 5, BlockW = 22, BlockH = 14, Gap = 4, LipPx = 3 })
	U.ChipCount.Name = "CountBlocks"
	U.ChipCount.AnchorPoint = Vector2.new(1, 0.5)
	U.ChipCount.Visible = false
	-- the End card
	-- (Pitch 2 item 02 B, look review round 1: "two result-card styles side by side") the battle's ONE result template
	-- (BattleController.ResultTemplate): the head band in the result's colour (a cleared floor green, a lost run violet) with
	-- its icon and word, the mode - reason line, stat rows with ticks, equal reward chips, the notes (the first clear, the
	-- unlock) and OK across the card, its lip in five parts the 14 s auto-close; no nails, the stone lip (the pitch's card).
	-- R.fillEnd builds the body (again only when the width or a value changes)
	local endCard = NeonKit.Card({ Name = "EndCard", Skin = "Sign", Size = UDim2.fromOffset(K.END_W, 200), Color = SIGN.StoneLip, LipPx = K.CARD_LIP, Parent = gui })
	endCard.Root.Visible = false
	U.End = endCard
	U.EndScale = Util.Create("UIScale", { Name = "ReadScale", Scale = 1, Parent = endCard.Root })
end

-- (keys look r3) the chip's Leave pad centred on the whole button: the button's UIPadding (its lip's room) moves its
-- children's box, so the pad undoes it; again after a restyle (CloudUI.SetStyle may pad the button anew)
function R.placeHit()
	local hit, b = U.ChipHit, U.ChipButton
	if not hit or not b then
		return
	end
	local p = b:FindFirstChildOfClass("UIPadding")
	local pl, pr, pt, pb = 0, 0, 0, 0
	if p then
		pl, pr, pt, pb = p.PaddingLeft.Offset, p.PaddingRight.Offset, p.PaddingTop.Offset, p.PaddingBottom.Offset
	end
	hit.Position = UDim2.new(0.5, (pr - pl) / 2, 0.5, (pb - pt) / 2)
	hit.Size = UDim2.new(1, pl + pr, 0, math.max(b.Size.Y.Offset, math.ceil(K.CHIP_HIT / K.CHIP_SCALE)))
end

function R.ready()
	local mine = S.Lobby and S.Lobby.Mine
	if not mine then
		return
	end
	local now = not W.myReady(mine)
	if H.request("Ready", now) then
		S.ReadyWant = now
		S.PartySig = nil
		R.refresh()
		W.refresh()
	end
end

-- bug batch 2 #14: true while the server still owes me a chest in the alcove (Run.ChestOwed lists the members who have
-- not picked one; an older payload without it: until my Chest arrives)
function R.chestOwed()
	local run = S.Run
	if not run or run.State ~= "Treasure" or S.ChestOpened then
		return false
	end
	if type(run.ChestOwed) ~= "table" then
		return true
	end
	local me = LocalPlayer and LocalPlayer.UserId
	for _, uid in ipairs(run.ChestOwed) do
		if uid == me then
			return true
		end
	end
	return false
end

-- bug batch 2 #14: once I picked (or the alcove owes me nothing) the other chests' "Pick ONE chest / Open" prompts
-- would only refuse: switch them off locally (the server still checks every pick; it switches taken ones off for all)
function R.lockChests()
	local run = S.Run
	if not run or run.State ~= "Treasure" or R.chestOwed() then
		return
	end
	local pocket = (S.Pocket and S.Pocket.Parent) and S.Pocket or R.findPocket()
	if not pocket then
		return
	end
	for _, d in ipairs(pocket:GetDescendants()) do
		if d:IsA("ProximityPrompt") and d.Name == "ChestPrompt" and d.Enabled then
			d.Enabled = false
		end
	end
end

-- LEAVE: two presses within LEAVE_CONFIRM seconds -> DungeonRequest("Quit")
function R.leave()
	if not S.Run then
		return
	end
	local now = os.clock()
	if now <= S.LeaveArmed then
		S.LeaveArmed = 0
		H.request("Quit")
		R.refresh()
		return
	end
	S.LeaveArmed = now + K.LEAVE_CONFIRM
	R.refresh()
end

-- icon: (U9-7 look) the PixelIcon the toast's tile shows on the loot plate and the phone chip (nil: no tile)
function R.toast(text, color, seconds, short, icon)
	S.Toast = { Text = tostring(text), Short = short, Color = color or C.Gold, Icon = icon, Until = os.clock() + (seconds or K.TOAST_SECONDS) }
	R.refresh()
end

-- seconds left of the current run phase (counted locally from when it began)
function R.phaseLeft()
	local run = S.Run
	if not run then
		return nil
	end
	local since = os.clock() - S.PhaseAt
	if run.State == "Treasure" then
		return math.max(0, H.dungeonNumber("TreasureSeconds", K.TREASURE) - since)
	end
	return nil
end

-- the door wait (decision 2): "press" (go and press E), "wait" (I pressed, others not yet), "go" (the transit) or nil;
-- -> kind, missing count, names of who did not press yet
function R.doorWait()
	local run = S.Run
	if not run or run.EnterOpen ~= true then
		if run and run.Transit == true then
			return "go", 0, {}
		end
		return nil, 0, {}
	end
	local pressed = {}
	for _, uid in ipairs(type(run.Confirmed) == "table" and run.Confirmed or {}) do
		pressed[uid] = true
	end
	local names = {}
	for _, m in ipairs(type(run.Members) == "table" and run.Members or {}) do
		if not m.Left and not pressed[m.UserId] then
			names[#names + 1] = tostring(m.Name or "?")
		end
	end
	local missing = math.max(0, math.floor(tonumber(run.NeedConfirm) or #names))
	if LocalPlayer and pressed[LocalPlayer.UserId] then
		return "wait", missing, names
	end
	return "press", missing, names
end

-- touch-only devices tap the prompt's button instead of pressing E
function R.pressWord()
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "tap Enter"
	end
	return "press E"
end

function R.doorText(short)
	local kind, missing, names = R.doorWait()
	if kind == "go" then
		return "Here we go!"
	elseif kind == "wait" then
		if missing <= 0 then
			return "Here we go!"
		end
		if short then
			return "Waiting for " .. missing .. " more"
		end
		return "Waiting for " .. missing .. " more (" .. table.concat(names, ", ") .. ")"
	elseif kind == "press" then
		return short and ("Door: " .. R.pressWord()) or ("Go to the door and " .. R.pressWord())
	end
	return nil
end

function R.statusText()
	local run = S.Run
	local left = R.phaseLeft()
	local door = R.doorText(false)
	if run.State == "Hall" then
		return door or "Get ready!"
	elseif run.State == "Corridor" then
		if run.Phase == "Walk" then
			return door or "Room cleared! The bars open..."
		end
		if S.Walk then
			return "Here we go!"
		end
		return door or "Walk into the room to start the fight"
	elseif run.State == "Fight" then
		return (tonumber(run.Room) == 4) and "Boss fight! Beat the boss and its escort" or "Fight! Beat every wave"
	elseif run.State == "Treasure" then
		return (R.chestOwed() and "Pick ONE chest! Exit in " or "Back to the plaza in ") .. H.clock(left or 0)
	elseif run.State == "Ending" then
		return "Back to the plaza..."
	end
	return ""
end

-- the run card is exactly as tall as its visible rows (fixed rows, no AutomaticSize)
function R.cardHeight()
	U.CardButtons.Visible = U.CardReady.Visible or U.CardLeave.Visible
	local ix = U.ChipIcon.Visible and (K.ICON_TILE + 4) or 0 -- (U9-7 look) the words after the toast's icon tile
	U.ChipText.Position = UDim2.fromOffset(12 + ix, 0)
	U.ChipText.Size = UDim2.new(1, (U.ChipButton.Visible and -112 or -20) - ix, 1, 0)
	local h = 10 + 12
	local n = 0
	for _, child in ipairs(U.CardList:GetChildren()) do
		if child:IsA("GuiObject") and child.Visible then
			h = h + child.Size.Y.Offset
			n = n + 1
		end
	end
	h = h + math.max(0, n - 1) * 6 + K.CARD_LIP
	U.Card.Root.Size = UDim2.fromOffset(K.CARD_W, h)
end

-- (U9-7 look) a desktop card pushed down under a long enemy list (R.place) still ends 8 px above the battle HUD's ability
-- buttons: the Wave line goes first (the HUD's mode card says the wave in a fight), then the status line, then the loot
-- line (the room's loot still flashes on the card's toast), then the room line (the mode card says the room too:
-- "DUNGEON - Floor 3 - Room 2"), then the party's chips; a card that still reaches them (the loot plate under four enemy
-- rows) takes the chip form meanwhile. (fix6, keys look pol1 #2: ab11837's 12 px taller enemy list left 1280 x 720's card
-- 19 px over the keys where the party row needs 30, and the party went before the room line: the card kept "Room 2 / 4",
-- which the mode card says, and lost who is alive, which no other part shows.) R.refresh shows every line again on its
-- next pass
function R.fitCard()
	if S.CardMode ~= "Card" then
		return
	end
	local cmd = R.shownRect(R.guiPart("NimbusBattle", "Commands"))
	if not cmd then
		return
	end
	local f = U.CardScale.Scale
	local root = U.Card.Root
	local x0 = root.Position.X.Offset
	local y0 = root.Position.Y.Offset + R.inset()
	if cmd.x0 >= x0 + K.CARD_W * f or cmd.x1 <= x0 then
		return
	end
	for _, line in ipairs({ U.CardWave, U.CardStatus, U.CardLoot, U.CardRoom, U.CardMembers }) do
		if y0 + root.Size.Y.Offset * f <= cmd.y0 - 8 then
			return
		end
		if line.Visible then
			line.Visible = false
			R.cardHeight()
		end
	end
	if y0 + root.Size.Y.Offset * f > cmd.y0 - 8 then
		local vp = H.viewport()
		R.placeChip(vp.X, vp.Y, R.inset(), R.view())
		S.CardMode = "Chip"
		root.Visible = false
		U.Chip.Root.Visible = true
		R.fitChip()
	end
end

-- (U9-7 look) the phone chip round what it shows: its icon tile, its words (measured with the widest digits, so a ticking
-- clock does not resize it every second), its block row and its button, 8 px each side and 16 px to spare; never wider
-- than R.placeChip gave it (S.ChipMaxW: a chip fitted round a short toast grows back for longer words). A chip under the
-- band keeps its right edge (S.ChipRight), one in the band its left
function R.fitChip()
	local root = U.Chip.Root
	local maxW = S.ChipMaxW or root.Size.X.Offset
	if not U.ChipText.Visible or maxW <= 0 then
		return
	end
	local ix = U.ChipIcon.Visible and (K.ICON_TILE + 4) or 0
	local function wordsW()
		local m = R.measure(U.ChipText, (U.ChipText.Text:gsub("%d", "8")), nil)
		return m and math.ceil(m.X) or math.ceil(#U.ChipText.Text * U.ChipText.TextSize * 0.6)
	end
	-- (playtest 2026-11-28 C34) a countdown starts from its long form every pass (a chip that grew back shows it again)
	local words = S.ChipWords
	if words and words.Full and U.ChipText.Text ~= words.Full then
		U.ChipText.Text = words.Full
	end
	local textW = wordsW()
	local blocks = nil
	if U.ChipCount.Visible then
		blocks = U.ChipCount
	else
		blocks = U.ChipText:FindFirstChild("Rooms")
	end
	local blocksW = blocks and (blocks.Size.X.Offset + 10) or 0
	local buttonW = U.ChipButton.Visible and (U.ChipButton.Size.X.Offset + 5) or 0
	local want = 12 + ix + textW + blocksW + buttonW + 8 + 16
	-- the room blocks only beside words that stay whole ("Pick ONE chest! 0:40" beside LEAVE fills a dropped chip): the
	-- words say what to do, the blocks only where the run is
	local rooms = U.ChipText:FindFirstChild("Rooms")
	if rooms then
		rooms.Visible = want <= maxW
		if not rooms.Visible then
			want = want - blocksW
			blocksW = 0
		end
	end
	local width = math.min(maxW, want)
	-- the words fill what is left of the chip; the blocks sit right after them, inside it
	local textBox = width - 12 - ix - blocksW - buttonW - 8
	-- (C34) the long form would truncate ("Dung..." at 360 x 640, the seconds gone): the short form, measured again
	if words and words.Short and textBox < textW then
		U.ChipText.Text = words.Short
		textW = wordsW()
		want = 12 + ix + textW + blocksW + buttonW + 8 + 16
		width = math.min(maxW, want)
		textBox = width - 12 - ix - blocksW - buttonW - 8
	end
	-- (C34) still no room (a portrait phone's chip with its READY button beside the five blocks left the words 0 px): the
	-- blocks step aside, the words carry the seconds; they come back with the next refresh on a wider chip
	if words and textBox < textW and U.ChipCount.Visible then
		U.ChipCount.Visible = false
		blocksW = 0
		want = 12 + ix + textW + buttonW + 8 + 16
		width = math.min(maxW, want)
		textBox = width - 12 - ix - buttonW - 8
	end
	U.ChipText.Size = UDim2.new(0, math.max(0, textBox), 1, 0)
	if U.ChipCount.Visible then
		U.ChipCount.Position = UDim2.new(1, -(buttonW + 8), 0.5, 0)
	end
	if rooms then
		-- the room blocks hang off the words' right end (R.pips anchors them to the label's right edge)
		rooms.AnchorPoint = Vector2.new(1, 0.5)
		rooms.Position = UDim2.new(1, 10 + rooms.Size.X.Offset, 0.5, 0)
	end
	if width ~= root.Size.X.Offset then
		root.Size = UDim2.fromOffset(width, root.Size.Y.Offset)
		if S.ChipRight then
			root.Position = UDim2.fromOffset(math.floor(S.ChipRight - width * U.ChipScale.Scale + 0.5), root.Position.Y.Offset)
		end
	end
end

-- the phone chip's one line (the battle HUD shows the wave during a fight)
function R.chipText(room, count)
	local run = S.Run
	local left = R.phaseLeft()
	if run.State == "Fight" then
		return (room >= count) and ("Floor " .. tostring(run.Floor or 1) .. " " .. G.Dot .. " Boss") or ("Room " .. room .. "/" .. count)
	elseif run.State == "Hall" or (run.State == "Corridor" and run.Phase == "Walk") then
		return R.doorText(true) or ((run.State == "Hall") and "Get ready!" or "Cleared!")
	elseif run.State == "Corridor" then
		return R.doorText(true) or "Walk in!"
	elseif run.State == "Treasure" then
		return (R.chestOwed() and "Pick ONE chest! " or "Exit in ") .. H.clock(left or 0)
	end
	return "Back soon..."
end

-- (kit-b U7b) the room pips after the room line; (U9-7 look) in the bar language: a small SignKit block row at the line's
-- right end (14 x 12 blocks on a 2 px lip), lit gold up to the room the run is in, the boss room's block red (its lip
-- red while it is ahead). The flat pips had no edge and no lip
function R.pips(label, room, count)
	local row = label:FindFirstChild("Rooms")
	if row and (room == nil or row:GetAttribute("Count") ~= count) then
		row:Destroy()
		row = nil
	end
	if room == nil then
		return -- (U9-7 look) no blocks (the phone chip's countdown, a toast)
	end
	if not row then
		row = SignKit.BlockRow(label, { Count = count, BlockW = 14, BlockH = 12, Gap = 3, LipPx = 2 })
		row.Name = "Rooms"
		row.AnchorPoint = Vector2.new(1, 0)
		row.Position = UDim2.new(1, 0, 0, math.floor((label.Size.Y.Offset - 12) / 2))
	end
	local lit = SignKit.FillBlocks(row, math.max(0, math.min(room, count)))
	local boss = row:FindFirstChild("Block" .. count)
	local face = boss and boss:FindFirstChild("Face")
	if face then
		face.BackgroundColor3 = (lit >= count) and SIGN.Red or SIGN.Stone
		local lip = face:FindFirstChild("Lip")
		if lip then
			lip.BackgroundColor3 = SIGN.RedLip
		end
	end
end

function R.lootText()
	local t = S.Totals
	local parts = { "$" .. H.commas(t.Cash), H.commas(t.Tokens) .. " tokens", "+" .. H.commas(t.Xp) .. " XP" }
	if (tonumber(t.Gems) or 0) > 0 then
		parts[#parts + 1] = H.commas(t.Gems) .. " gems"
	end
	return table.concat(parts, "   ")
end

-- which card to show: "Run" (in a run), "Countdown" (a party countdown while the window is closed), or nil
function R.view()
	if H.inMatch() then
		return nil
	end
	if S.Run then
		return "Run"
	end
	local mine = S.Lobby and S.Lobby.Mine
	if mine and not S.Open and W.countdown(mine) ~= nil and not mine.InRun then
		return "Countdown"
	end
	return nil
end

-- Roblox's top bar height (the gui area starts below it)
function R.inset()
	local ok, inset = pcall(function()
		return game:GetService("GuiService"):GetGuiInset().Y
	end)
	return (ok and tonumber(inset)) or 0
end

-- view: R.view()'s answer (a dropped chip is its LEAVE alone only in a run)
function R.place(view)
	local vp = H.viewport()
	local w, h = vp.X, vp.Y
	local top = R.inset()
	local f = Theme.ScreenFactor(h)
	local phone = H.isPhone()
	S.CardMode = nil
	-- the End card
	local endH = U.End.Root.Size.Y.Offset
	-- bug batch 2 #1: phones start the End card below the HUD's top-right currency strips, so they stay in view
	-- for the result (the HUD still hides them should the card ever reach them)
	local strips = R.stripsBottom()
	S.EndMenuLeft = nil
	S.EndKeysOff = false
	S.EndTouchOff = false
	if phone and w < h then
		-- portrait: under the currency strips (clear of the screen's centre). (P2 fix A, look: beside the menu column it was
		-- 217.6 px wide at 390 x 844, its third chip alone on a second row) the battle result card's width (one template:
		-- K.END_W at 0.8, 352 px), 8 px from the right edge as the battle's card (Hud.ResultSpot); the menu tiles step aside
		-- where it covers them (R.endMenu), as they do for the battle's card
		S.EndCompact = false
		-- (keys lane, look review fixA r1: at 360 x 640 the vitals card lay on RUN and DASH under the card) spec 02 B: on a
		-- phone the vitals card hides while any result card is up, portrait too (R.endVitals: HudController.SetVitalsHidden)
		S.EndVitalsOff = true
		local scale = 0.8
		U.EndScale.Scale = scale
		local width = math.min(K.END_W, math.floor((w - 16) / scale))
		local left = math.floor(w - 8 - width * scale)
		U.End.Root.Size = UDim2.fromOffset(width, endH)
		-- (right under the strips, the battle card's row: at 18 % down the cleared floor's card reached over the centre)
		local y = strips > 0 and strips or (math.floor(h * 0.18) - top)
		-- (P2 fix A, look review r1: at 360 x 640 the cleared floor's card under the strips reached RUN) where it would reach
		-- the RUN / DASH keys under it, the top-right corner (the strips step aside: HudController's corner card), as the
		-- battle's card does (Hud.ResultSpot); still too tall there, the keys step aside while it shows (R.endKeys)
		local keysTop = R.keysTop(left, left + width * scale)
		if keysTop and top + y + endH * scale > keysTop - 8 then
			y = 6
			S.EndKeysOff = top + y + endH * scale > keysTop - 8
		end
		U.End.Root.Position = UDim2.fromOffset(left, y)
		if R.menuRight(w) > left then
			S.EndMenuLeft = left
		end
	elseif phone then
		R.placeEndLandscape(w, h, top, endH, strips)
		S.EndVitalsOff = true -- (spec 02 B: a phone's vitals card hides while a result card is up, wherever the card sits)
	else
		S.EndCompact = false
		U.EndScale.Scale = f
		U.End.Root.Size = UDim2.fromOffset(K.END_W, endH)
		-- (fix6 look0 #3c: at 960 x 540, a small window with a keyboard, the card at 30 % of the height started 1.2 px under
		-- the token strip's shadow and reached 56 px over the vitals card, '100 / 100' cut to '100 /') under the top-right
		-- strips by their shadow, the card's frame and air (R.stripsBottom keeps 8 px); and where the card still covers the
		-- vitals card's slot (8 px round it), the vitals card steps aside while the card shows, as a phone's does (spec 02 B)
		local x = math.floor(w - 12 - K.END_W * f)
		local y = math.floor(h * 0.3) - top
		if strips > 0 then
			y = math.max(y, strips + 2)
		end
		U.End.Root.Position = UDim2.fromOffset(x, y)
		local vitals = R.vitalsSlot(top)
		local x1, y0, y1 = x + K.END_W * f, top + y, top + y + endH * f
		S.EndVitalsOff = vitals ~= nil and x < vitals.x1 + 8 and vitals.x0 < x1 + 8 and y0 < vitals.y1 + 8 and vitals.y0 < y1 + 8
	end
	-- the run card / chip
	if phone then
		R.placeChip(w, h, top, view)
		S.CardMode = "Chip"
	else
		-- (U9-7 look) below the battle HUD's enemy list when it reaches the card's column (four strips at 1280x720 end
		-- under 40 % of the height), the phone chip's rule; the 4 Hz refresh re-places it as the list grows or shrinks
		U.CardScale.Scale = f
		local x0 = math.floor(w - 12 - K.CARD_W * f)
		local y = math.floor(h * 0.4)
		local enemies = R.shownRect(R.guiPart("NimbusBattle", "Enemies"))
		if enemies and enemies.x1 > x0 then
			y = math.max(y, math.ceil(enemies.y1 + 8))
		end
		U.Card.Root.Position = UDim2.fromOffset(x0, y - top)
		S.CardMode = "Card"
	end
end

-- (U9-7 look) the End card on a landscape phone, always at the kit's 0.8 (it shrank to 0.7 under the strips: a pixel size of
-- its own, reward text under the 14 px floor, and it still sat on the HUD's vitals). The first spot that holds it whole,
-- 8 px clear of the vitals, of DASH / RUN and above Roblox's jump band: the column LEFT of the HUD's currency strips at the
-- top of the gui area (the strips stay in view), under the strips, then the top-right corner (the strips step aside:
-- HudController's corner card); each with the reason line, then without it (the title says the floor). None: the same spots
-- again with the vitals card hidden while it shows (S.EndVitalsOff -> R.endVitals), last the corner without the reason
-- line. Weighed on every refresh (R.fillEnd,
-- right after, reads S.EndCompact); the inputs are the HUD's laid-out slots, so hiding the strips or the vitals does not
-- feed back. strips: R.stripsBottom()
function R.placeEndLandscape(w, h, top, endH, strips)
	local scale = 0.8
	local reasonRow = S.EndReasonRow or 0 -- (the template's reason line with its gap: R.fillEnd's last build with it)
	local fullH = S.EndCompact and (endH + reasonRow) or endH
	local y0 = math.max(0, 52 - top) -- never above the gui area
	local maxW = math.min(K.END_W, math.floor(w * 0.44 / scale))
	local buttons = R.keyRects()
	local vitals = R.vitalsSlot(top)
	local leftEdge = R.menuRight(w) + 8
	-- one spot: the card's right edge (screen px), its top (gui px), its design height -> right, width or nil
	local function try(right, y, cardH, ignoreVitals)
		local bottom = top + y + cardH * scale
		if bottom > h - 90 - 8 then
			return nil -- into Roblox's jump button (70 px, 20 px off the bottom)
		end
		for _, r in ipairs(buttons) do
			if r.y0 < bottom + 8 and r.x0 - 8 < right and r.x1 + 8 > right - maxW * scale then
				right = math.floor(r.x0 - 8)
			end
		end
		local width = math.min(maxW, math.floor((right - leftEdge) / scale))
		if width < K.END_MIN_W then
			return nil
		end
		local left = right - width * scale
		if vitals and not ignoreVitals and left < vitals.x1 + 8 and vitals.x0 < right + 8 and top + y < vitals.y1 + 8 and vitals.y0 < bottom + 8 then
			return nil
		end
		return right, width
	end
	local spots = {}
	local stripsLeft = R.stripsLeft()
	if stripsLeft then
		-- (keys look r4: at 844 x 390 the card's hard shadow ended on the strips' frame, 0 px between them) left of the strips
		-- by the card's shadow (K.CHIP_SHADOW), the strips' 2 px frame, 4 px of air and 2 for the published left's rounding
		-- (R.stripsLeft is whole px; 844 x 390 drew the strips 0.4 px left of it)
		spots[#spots + 1] = { stripsLeft - (K.CHIP_SHADOW + 2 + 4 + 2), y0 }
	end
	if strips > 0 then
		spots[#spots + 1] = { w - 12, math.max(y0, strips) }
	end
	spots[#spots + 1] = { w - 12, y0 }
	local right, width, y, compact = nil, nil, y0, false
	-- (P2 fix A, look review r1) a short landscape phone's card (below) keeps that place while it shows: at its two-column
	-- width it is shorter than the narrow card the spots above weigh, so weighing them again would flip it back and forth
	local tightKey = string.format("%dx%d/%s", w, h, tostring(S.EndAt))
	local tight = S.EndTight == tightKey
	for _, spot in ipairs(tight and {} or spots) do
		for _, drop in ipairs({ false, true }) do
			if not right and (not drop or S.End ~= nil) then
				right, width = try(spot[1], spot[2], drop and (fullH - reasonRow) or fullH)
				y, compact = spot[2], drop
			end
		end
	end
	S.EndVitalsOff = false
	if not right then
		-- nowhere clear of the vitals: (Pitch 2 item 02 B, look review round 1: the End card is the battle's result template,
		-- taller than the old notice) the same spots in the same order with the vitals card stepping aside meanwhile (the
		-- spec: a phone's result card hides the vitals), so the strips stay in view; none: the corner without the reason line
		for _, spot in ipairs(tight and {} or spots) do
			for _, drop in ipairs({ false, true }) do
				if not right and (not drop or S.End ~= nil) then
					right, width = try(spot[1], spot[2], drop and (fullH - reasonRow) or fullH, true)
					y, compact = spot[2], drop
				end
			end
		end
		-- (P2 fix A, look review r1: at 640 x 360 the last resort below ran 7 px past the screen's foot, under RUN, DASH and
		-- the jump button, its third chip alone on a row) a phone too short for the card beside its controls: the card takes
		-- the top-right corner at the template's two-column width (the rows in 2 columns, the 3 chips on one row: the pitch's
		-- phone card), without the reason line, and while it shows the controls under it step aside as a phone window's do:
		-- the vitals card, the RUN / DASH keys (R.endKeys: MovementController.SetMobileHidden, a modal card's hold) and
		-- Roblox's stick and jump (R.endTouch: MenuController.SetTouchHidden). The template's full width (at the two columns'
		-- narrowest, 420, "Rooms" was cut to "R..." beside "4 / 4" at 640 x 360); where it reaches the menu column, the
		-- column's tiles step aside too (R.endMenu), as a portrait phone's do. (Ending left of the jump button instead put the
		-- card's middle in the screen's centre third at 640 x 360 and 844 x 390.)
		-- (only once the heights weighed above are this screen's narrow card's: R.fillEnd's last build was a landscape card at
		-- maxW, not a portrait one carried over by a turn of the phone)
		-- (P2 fix round C: and this End's own card, R.fillEnd's S.EndBuiltAt. A new End's first place weighs the last card's
		-- height until its fill: after a tall card a short one found no spot and latched the corner over the strips)
		if not right and (tight or (S.EndBuiltSig == ("true/" .. tostring(maxW)) and S.EndBuiltAt == S.EndAt)) then
			local limit = w - 12
			local wide = math.min(K.END_W, math.floor((limit - 8) / scale))
			local left = math.floor(limit - wide * scale)
			if wide >= K.END_TWO_COL then
				S.EndTight = tightKey
				right, width = limit, wide
				y, compact = y0, S.End ~= nil
				S.EndKeysOff = true
				S.EndTouchOff = true
				-- (weighed once for this card's place: with the tiles stepped aside the column's buttons read as gone)
				if not tight or S.EndTightMenu == nil then
					S.EndTightMenu = R.menuRight(w) > left
				end
				if S.EndTightMenu then
					-- (0: the whole column, as LossScreen's; the card may reach only the fold tab's touch pad, past the column's
					-- own edge, which MenuController's cover rule does not weigh)
					S.EndMenuLeft = 0
				end
			end
		end
		if not right then
			y, compact = y0, S.End ~= nil
			right, width = try(w - 12, y0, compact and (fullH - reasonRow) or fullH, true)
			right, width = right or (w - 12), width or maxW
		end
		S.EndVitalsOff = vitals ~= nil
	end
	S.EndCompact = compact
	U.EndScale.Scale = scale
	U.End.Root.Size = UDim2.fromOffset(width, compact and (fullH - reasonRow) or fullH)
	U.End.Root.Position = UDim2.fromOffset(math.floor(right - width * scale), y)
end

-- (U9-7 look) the HUD's vitals card slot in screen px (HudController.GetLayout().VitalsSlot: the same rect shown or
-- hidden, so the card's own hide does not move the End card), else its shown box, else nil
function R.vitalsSlot(top)
	local hud = H.controller("HudController")
	local ok, layout = pcall(function()
		return hud and hud.GetLayout()
	end)
	local slot = ok and type(layout) == "table" and layout.VitalsSlot or nil
	if type(slot) == "table" and tonumber(slot.W) and slot.W > 0 then
		return { x0 = slot.X, y0 = slot.Y + top, x1 = slot.X + slot.W, y1 = slot.Y + slot.H + top }
	end
	return R.shownRect(R.guiPart("NimbusHud", "Vitals"))
end

-- (U9-7 look) the left edge of the HUD's currency strips in the top-right corner (screen px = gui px across), nil when
-- they are elsewhere: HudController's TopRightLeft, laid out whether or not a corner card hides them meanwhile
function R.stripsLeft()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud or hud:GetAttribute("CurrencyMode") ~= "TopRight" then
		return nil
	end
	local left = tonumber(hud:GetAttribute("TopRightLeft"))
	return (left and left > 0) and math.floor(left) or nil
end

-- (P2 fix A) the menu tiles step aside while a portrait phone's End card covers them (MenuController.SetColumnCovered
-- "DungeonEnd": the column frame keeps its place, so R.menuRight does not move); left: the card's left x, nil = let go
function R.endMenu(left)
	left = type(left) == "number" and left or nil
	if S.EndMenuSet == left then
		return
	end
	S.EndMenuSet = left
	local menu = H.controller("MenuController")
	if menu and type(menu.SetColumnCovered) == "function" then
		H.safe("menu", menu.SetColumnCovered, left, "DungeonEnd")
	end
end

-- (U9-7 look) the vitals card steps aside while the End card has nowhere else (HudController.SetVitalsHidden "DungeonEnd")
function R.endVitals(off)
	off = off == true
	if S.EndVitalsHid == off then
		return
	end
	S.EndVitalsHid = off
	local hud = H.controller("HudController")
	if hud and type(hud.SetVitalsHidden) == "function" then
		H.safe("vitals", hud.SetVitalsHidden, "DungeonEnd", off)
	end
end

-- (U9-7 review) the phone chip. In Roblox's top band right of the top bar's pill (and of the HUD's strips when a battle
-- puts them in the band) and left of Roblox's "..." button, as wide as that span allows: the text truncates before LEAVE
-- moves. A span under K.CHIP_BAND_MIN (a run's three strips fill a landscape band, the pill a portrait one) drops the chip
-- under the band at the right edge, below what hangs there (the pill, the strips, the battle HUD's enemy list), where the
-- desktop card hangs too. In a room fight the battle HUD's mode card already says the room and the wave: a dropped chip
-- is then its LEAVE alone (S.ChipCompact), small enough to stay clear of the action buttons
function R.placeChip(w, h, top, view)
	local scale = K.CHIP_SCALE
	U.ChipScale.Scale = scale
	local pill = R.shownRect(R.guiPart("NimbusTopBar", "Pill"))
	local x0 = math.max((w < h) and 132 or math.max(300, math.floor(w * 0.36)), pill and math.ceil(pill.x1 + 8) or 0, R.pillsRight() + 8)
	local x1 = w - K.CHIP_RIGHT
	S.ChipCompact = false
	S.ChipRight = nil -- (U9-7 look) R.fitChip: a chip in the band keeps its left edge
	if x1 - x0 >= K.CHIP_BAND_MIN then
		R.listReserve(0)
		R.chipSkin(false)
		U.Chip.Root.Size = UDim2.fromOffset(math.min(K.CHIP_MAX_W, math.floor((x1 - x0) / scale)), K.CHIP_H)
		U.Chip.Root.Position = UDim2.fromOffset(x0, 4 - top)
		S.ChipMaxW = U.Chip.Root.Size.X.Offset
		return
	end
	local battle = R.battleParts()
	S.ChipCompact = view == "Run" and battle.TopCard ~= nil and S.Run ~= nil and S.Run.State ~= "Ending"
	R.chipSkin(S.ChipCompact)
	-- (keys look r3: at 640 x 360 the dropped chip's red Leave stood 10 px above RUN, a held key, between the list's "+2
	-- more" and the keys, its shadow on RUN) in a fight the battle HUD's enemy list keeps the chip, its shadow, the gap
	-- and the team orders' 40 px off the thumbs' keys free under it (it shows fewer rows): the chip drops into that room;
	-- (keys look r4) the Leave button alone, the air over it from the list's ink and its own bevel and shadow
	R.listReserve(S.ChipCompact and (K.CHIP_LEAVE_H * scale + K.CHIP_REACH + K.CHIP_AIR + 2 * K.CHIP_BTN_OUT + K.CHIP_BTN_SHADOW
		+ K.CHIP_KEYS_GAP) or 0)
	if S.ChipCompact then
		battle = R.battleParts() -- (the list as it now lies)
	end
	local right = w - K.CHIP_EDGE
	local width = S.ChipCompact and U.ChipButton.Size.X.Offset or K.CHIP_LEAVE_W
	if not S.ChipCompact then
		width = math.min(K.CHIP_DROP_W, math.floor((right - R.menuRight(w) - 8) / scale))
	end
	local left = right - width * scale
	local list = battle.Enemies
	if S.ChipCompact and list and math.abs(list.x1 - right) <= 24 and list.x1 <= w - 4 then
		-- (keys look r3) flush with the enemy list's right edge from the start: the list's "+n more" tag at its left end
		-- (the reserve) stays beside the chip, the chip under the list's last row
		left, right = left + (list.x1 - right), list.x1
	end
	-- what hangs at the top: the pill, the strips, the HUD's whole top-right block (in the lobby the gift docks under the
	-- strips: HudController's TopRightLeft / TopRightBottom, gui px), the boost chips under it, the battle HUD's parts
	local below = {}
	for _, r in ipairs(battle.Parts) do
		below[#below + 1] = r
	end
	below[#below + 1] = pill
	below[#below + 1] = R.shownRect(R.guiPart("NimbusHud", "Currency"))
	below[#below + 1] = R.shownRect(R.guiPart("NimbusBoosts", "BoostChips"))
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	local block = (hud and hud:GetAttribute("CurrencyMode") == "TopRight") and tonumber(hud:GetAttribute("TopRightBottom")) or 0
	if block > 0 then
		below[#below + 1] = { x0 = tonumber(hud:GetAttribute("TopRightLeft")) or 0, y0 = top, x1 = right, y1 = top + block }
	end
	-- down past everything in the chip's columns that it would touch (a few rounds: one step can meet the next part);
	-- -> its top (screen px) and the part it hangs under (nil: right under the band)
	local chipH = (S.ChipCompact and K.CHIP_LEAVE_H or K.CHIP_H) * scale
	local function drop(x0, x1)
		local y, under = top + K.CHIP_GAP, nil
		for _ = 1, 8 do
			local moved = false
			for _, r in ipairs(below) do
				if S.ChipCompact then
					-- (keys look r4) by ink: the part's reach and CHIP_AIR round it against the button's bevel and shadow
					local m = (r.reach or K.CHIP_REACH) + K.CHIP_AIR
					local o, f = K.CHIP_BTN_OUT, K.CHIP_BTN_OUT + K.CHIP_BTN_SHADOW
					if r.x0 - m < x1 + f and x0 - o < r.x1 + m and r.y0 - m < y + chipH + f and y - o < r.y1 + m then
						y, under = math.ceil(r.y1 + m + o), r
						moved = true
					end
				elseif r.x0 < x1 and x0 < r.x1 and r.y0 < y + chipH and y < r.y1 then
					y, under = math.ceil(r.y1 + K.CHIP_GAP), r
					moved = true
				end
			end
			if not moved then
				break
			end
		end
		return y, under
	end
	local y, under = drop(left, right)
	if under and math.abs(under.x1 - right) <= 24 and under.x1 <= w - 4 then
		-- flush with the right edge of the part it hangs under (the enemy list, the strips): one column, not two
		left, right = left + (under.x1 - right), under.x1
		y = drop(left, right)
	end
	if S.ChipCompact and right > w - 4 - (K.CHIP_BTN_OUT + K.CHIP_BTN_SHADOW) then
		-- (keys look r4: the Leave button alone, flush with the list, put its bevel and shadow 1.4 px from the screen's right
		-- edge at 640 x 360) its ink keeps 4 px off the edge, as the list's target bracket does
		local most = w - 4 - (K.CHIP_BTN_OUT + K.CHIP_BTN_SHADOW)
		left, right = left - (right - most), most
		y = drop(left, right)
	end
	-- (the card's 4 px lip band stays under the body, empty: the button fills the body from the chip's top edge)
	U.Chip.Root.Size = UDim2.fromOffset(width, S.ChipCompact and (K.CHIP_LEAVE_H + 4) or K.CHIP_H)
	U.Chip.Root.Position = UDim2.fromOffset(math.floor(left + 0.5), y - top)
	S.ChipRight = right -- (U9-7 look) R.fitChip: a dropped chip keeps its right edge
	S.ChipMaxW = width
end

-- (keys look r4: the dropped chip's card round its Leave button drew two frames and two shadows, the card's purple lip
-- a 3.2 px sliver under the button) a fight's dropped chip (S.ChipCompact) is its Leave button alone: the card's face,
-- edge, finish and lip step aside, the button fills the chip; back for every other chip
function R.chipSkin(compact)
	compact = compact == true
	if S.ChipSkinCompact == compact then
		return
	end
	S.ChipSkinCompact = compact
	local root = U.Chip and U.Chip.Root
	if not root then
		return
	end
	root.BackgroundTransparency = compact and 1 or 0
	for _, c in ipairs(root:GetChildren()) do
		if c:IsA("UIStroke") then
			c.Enabled = not compact
		elseif c.Name == "FinishBevel" or c.Name == "FinishShine" or c.Name == "FinishShadow" then
			c:SetAttribute("FinishOff", compact)
			c.Visible = not compact
		elseif c.Name == "Lip" and c:IsA("GuiObject") then
			c.Visible = not compact
		end
	end
	U.ChipButton.Position = UDim2.new(1, compact and 0 or -5, 0.5, 0)
end

-- (keys look r3) the room (screen px) the battle HUD's enemy list keeps free under it for the dropped chip, 0 = none
function R.listReserve(px)
	px = tonumber(px) or 0
	if S.ListReserve == px then
		return
	end
	S.ListReserve = px
	local battle = H.controller("BattleController")
	if battle and type(battle.ReserveUnderList) == "function" then
		H.safe("listReserve", battle.ReserveUnderList, px)
	end
end

-- a gui part by its ScreenGui's name and its own (searched below it), or nil
function R.guiPart(guiName, partName)
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local gui = pg and pg:FindFirstChild(guiName)
	return gui and gui:FindFirstChild(partName, true) or nil
end

-- a shown GuiObject's box in screen px { x0, y0, x1, y1 } (its ScreenGui's inset added back), nil while it is hidden,
-- empty or its ScreenGui is off. evenHidden: its own Visible is not asked (a part this card holds off, R.keyRects), nor its
-- ScreenGui's Enabled ((P2 fix round C) MovementController.SetMobileHidden holds RUN / DASH off by turning the whole
-- MobileControls gui off, so the next refresh saw no keys, put the card back where it reaches them and let them show: a
-- flip at 4 Hz)
function R.shownRect(obj, evenHidden)
	if not obj or not obj:IsA("GuiObject") then
		return nil
	end
	local cur = obj
	while cur and not cur:IsA("LayerCollector") do
		if cur:IsA("GuiObject") and not cur.Visible and not (evenHidden and cur == obj) then
			return nil
		end
		cur = cur.Parent
	end
	if not cur or not cur:IsA("ScreenGui") or not (cur.Enabled or evenHidden) then
		return nil
	end
	local p, s = obj.AbsolutePosition, obj.AbsoluteSize
	if s.X <= 4 or s.Y <= 4 then
		return nil
	end
	local dy = cur.IgnoreGuiInset and 0 or R.inset()
	return { x0 = p.X, y0 = p.Y + dy, x1 = p.X + s.X, y1 = p.Y + s.Y + dy }
end

-- the battle HUD's shown parts (its root's children, screen px) and its mode card's box (TopCard: shown in a fight)
function R.battleParts()
	local out = { Parts = {}, TopCard = nil }
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local gui = pg and pg:FindFirstChild("NimbusBattle")
	local root = gui and gui:FindFirstChild("Root")
	if not root or not R.shownRect(root) then
		return out
	end
	for _, child in ipairs(root:GetChildren()) do
		local r = R.shownRect(child)
		if r then
			local parts = nil
			if child.Name == "Enemies" then
				-- (keys look r3) the enemy list by its rows and its "+n more" tag: under the reserve the list keeps for the chip
				-- (BattleController.ReserveUnderList) the tag goes to the left end and the chip hangs under the right one
				parts = {}
				for _, row in ipairs(child:GetChildren()) do
					local rr = R.shownRect(row)
					if rr then
						-- (keys look r4) how far its ink reaches past the box: a row's target bracket, the "+n more" tag's frame
						rr.reach = (row.Name == "More") and 2 or K.CHIP_REACH
						parts[#parts + 1] = rr
					end
				end
			end
			if parts and #parts > 0 then
				for _, rr in ipairs(parts) do
					out.Parts[#out.Parts + 1] = rr
				end
			else
				out.Parts[#out.Parts + 1] = r
			end
			if child.Name == "TopCard" then
				out.TopCard = r
			elseif child.Name == "Enemies" then
				out.Enemies = r
			end
		end
	end
	return out
end

-- the right edge of MenuController's tile column (screen px) while it shows on the left, else 0
-- (P2 fix A, look review r1: at 360 x 640 the column's right edge, 127, is past 30 % of the width, so it read as "not on
-- the left", the End card never asked the tiles to step aside and they drew over it) on the left = its LEFT edge there
-- (and its buttons' touch pads, the fold toggle's 45 px hit box reaching past the column: they lie above our gui)
function R.menuRight(w)
	local column = R.guiPart("NimbusMenu", "MenuColumn")
	local r = R.shownRect(column)
	if not (r and r.x0 < w * 0.3) then
		return 0
	end
	local right = r.x1
	for _, d in ipairs(column:GetDescendants()) do
		if d:IsA("GuiButton") then
			local b = R.shownRect(d)
			if b then
				right = math.max(right, b.x1)
			end
		end
	end
	return math.ceil(right)
end

-- (P2 fix A, look review r1) the RUN / DASH touch keys' boxes (screen px) while their gui is up, shown or held off by a
-- card (MovementController.SetMobileHidden): the End card's own hold (R.endKeys) never feeds back into its place
function R.keyRects()
	local out = {}
	for _, name in ipairs({ "DashButton", "RunButton" }) do
		local b = R.guiPart("MobileControls", name)
		if b and b:IsA("GuiObject") then
			out[#out + 1] = R.shownRect(b, S.EndKeysHid == true)
		end
	end
	return out
end

-- the top (screen px) of the highest RUN / DASH key that reaches into the span x0..x1, nil = none
function R.keysTop(x0, x1)
	local out = nil
	for _, r in ipairs(R.keyRects()) do
		if r.x0 < x1 and r.x1 > x0 then
			out = math.min(out or math.huge, r.y0)
		end
	end
	return out
end

-- (P2 fix A, look review r1) the RUN / DASH keys step aside while the End card has no room clear of them (a modal card's
-- hold: MovementController.SetMobileHidden "DungeonEnd")
function R.endKeys(off)
	off = off == true
	if (S.EndKeysHid == true) == off then
		return
	end
	S.EndKeysHid = off
	local move = H.controller("MovementController")
	if move and type(move.SetMobileHidden) == "function" then
		H.safe("keys", move.SetMobileHidden, "DungeonEnd", off)
	end
end

-- (P2 fix A, look review r1) Roblox's stick and jump step aside while a short phone's End card takes the corner over them
-- (MenuController.SetTouchHidden "DungeonEnd", as a phone window's)
function R.endTouch(off)
	off = off == true
	if (S.EndTouchHid == true) == off then
		return
	end
	S.EndTouchHid = off
	local menu = H.controller("MenuController")
	if menu and type(menu.SetTouchHidden) == "function" then
		H.safe("touch", menu.SetTouchHidden, "DungeonEnd", off)
	end
end

-- just below the HUD's currency strips when they sit in the top-right corner under the top bar (gui-area px, the
-- same space as our cards), 0 when they are elsewhere (Roblox's top band in a battle) or unmeasured
function R.stripsBottom()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud or hud:GetAttribute("CurrencyMode") ~= "TopRight" then
		return 0
	end
	local bottom = tonumber(hud:GetAttribute("TopRightBottom"))
	return (bottom and bottom > 0) and math.ceil(bottom + 8) or 0
end

-- landscape phones in a battle: the HUD's currency strips share Roblox's top band; the chip starts right of them
function R.pillsRight()
	local pg = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local hud = pg and pg:FindFirstChild("NimbusHud")
	if not hud or hud:GetAttribute("CurrencyMode") ~= "TopBand" then
		return 0
	end
	local cur = hud:FindFirstChild("Currency", true)
	if not cur or not cur:IsA("GuiObject") then
		return 0
	end
	return math.floor(cur.AbsolutePosition.X + cur.AbsoluteSize.X + 0.5)
end

function R.refresh()
	if not U.RunGui then
		return
	end
	local view = R.view()
	local now = os.clock()
	if view == nil and S.End == nil then
		-- nothing to show (the common case in the lobby): no layout work on the 4 Hz tick
		U.Card.Root.Visible = false
		U.Chip.Root.Visible = false
		U.End.Root.Visible = false
		R.endVitals(false)
		R.endMenu(nil)
		R.endKeys(false)
		R.endTouch(false)
		R.listReserve(0)
		return
	end
	R.place(view)
	if view == nil or S.CardMode ~= "Chip" then
		R.listReserve(0) -- (keys look r3: no chip hangs under the battle HUD's list)
	end
	local toast = S.Toast and now < S.Toast.Until and S.Toast or nil
	local chip = S.CardMode == "Chip"
	U.Card.Root.Visible = view ~= nil and not chip
	U.Chip.Root.Visible = view ~= nil and chip
	U.Card.Root:SetAttribute("View", view)
	U.Chip.Root:SetAttribute("View", view)
	-- the End card
	local endShown = S.End ~= nil and now - S.EndAt < K.END_SECONDS and not H.inMatch()
	U.End.Root.Visible = endShown
	R.endVitals(endShown and S.EndVitalsOff == true)
	R.endMenu(endShown and S.EndMenuLeft or nil)
	R.endKeys(endShown and S.EndKeysOff == true)
	R.endTouch(endShown and S.EndTouchOff == true)
	if endShown then
		R.fillEnd()
	end
	if not view then
		return
	end
	if view == "Countdown" then
		local mine = S.Lobby.Mine
		local cd, cdShort = W.countdownText(mine)
		cd = cd or ""
		local isLeader = LocalPlayer and mine.Leader == LocalPlayer.UserId
		local needReady = not isLeader and not W.myReady(mine)
		local f = math.floor(tonumber(mine.Floor) or 1)
		U.CardTitle.Text = "The Dungeon " .. G.Dot .. " Floor " .. f
		PixelIcon.Mark(U.CardTitle, "flame") -- (kit-b U7b) the torch of the countdown
		U.CardStatus.Visible = true -- (U9-7 look) R.fitCard hides lines for one pass only
		U.CardRoom.Visible = true
		U.CardRoom.Text = cd
		PixelIcon.Mark(U.CardRoom, nil, { After = true })
		U.CardWave.Visible = false
		U.CardCount.Visible = true
		SignKit.FillBlocks(U.CardCount, math.min(5, W.countdown(mine) or 0))
		U.CardStatus.Text = "Stay near the Dungeon gate"
		U.CardMembers.Visible = false
		U.CardLoot.Visible = false
		U.CardToast.Visible = false
		U.CardReady.Visible = needReady
		U.CardLeave.Visible = false
		U.ChipText.Visible = true
		U.ChipText.Text = cd
		S.ChipWords = { Full = cd, Short = cdShort } -- (C34) R.fitChip falls back to the short form on a narrow chip
		U.ChipCount.Visible = true
		SignKit.FillBlocks(U.ChipCount, math.min(5, W.countdown(mine) or 0))
		R.pips(U.ChipText, nil) -- (no room blocks before a run)
		U.ChipButton.Text = "Ready"
		CloudUI.SetStyle(U.ChipButton, "Green") -- (kit-b U9-7) READY is the chip's one green; in a run it is Leave (red)
		R.placeHit()
		U.ChipButton.Visible = needReady
		H.setIconTile(U.ChipIcon, nil)
		R.cardHeight()
		R.fitChip()
		return
	end
	local run = S.Run
	local info = H.floorInfo(tonumber(run.Floor) or 1)
	local f = tonumber(run.Floor) or 1
	local room = math.floor(tonumber(run.Room) or 1)
	local count = math.floor(tonumber(run.RoomCount) or 4)
	U.Card.SetColor(H.elementColor(run.Element or info.Element))
	U.CardTitle.Text = "Floor " .. f .. " " .. G.Dot .. " " .. tostring(run.Name or info.Name)
	PixelIcon.Mark(U.CardTitle, nil)
	U.CardStatus.Visible = true -- (U9-7 look) R.fitCard hides lines for one pass only
	U.CardRoom.Visible = true
	U.CardRoom.Text = (room >= count) and "Boss room" or ("Room " .. room .. " / " .. count)
	R.pips(U.CardRoom, room, count)
	local waves = tonumber(run.Waves)
	local wave = tonumber(run.Wave)
	U.CardWave.Visible = waves ~= nil and waves > 0 and run.State == "Fight"
	U.CardCount.Visible = false
	U.CardWave.Text = "Wave " .. tostring(wave or 1) .. " / " .. tostring(waves or 1)
	U.CardStatus.Text = R.statusText()
	U.CardToast.Visible = toast ~= nil
	if toast then
		U.CardToastText.Text = toast.Text
		local face = H.readable(toast.Color or C.Gold)
		U.CardToast.BackgroundColor3 = face
		U.CardToastText.TextColor3 = Theme.TextOn(face)
		H.setIconTile(U.CardToastIcon, toast.Icon)
		local x = toast.Icon and (K.ICON_TILE + 8) or 0
		U.CardToastText.Position = UDim2.fromOffset(x, 0)
		U.CardToastText.Size = UDim2.new(1, -x, 1, 0)
	end
	-- members (a party only)
	local members = type(run.Members) == "table" and run.Members or {}
	U.CardMembers.Visible = #members > 1
	U.CardMembers.Size = UDim2.new(1, 0, 0, math.ceil(math.min(4, #members) / 2) * 30)
	local sig = ""
	for _, m in ipairs(members) do
		sig = sig .. tostring(m.UserId) .. tostring(m.Downed) .. tostring(m.Left) .. ";"
	end
	if sig ~= S.MemberSig then
		S.MemberSig = sig
		H.clear(U.CardMembers)
		for i, m in ipairs(members) do
			if i > 4 then
				break
			end
			local mark = (not m.Left) and (m.Downed and "skull" or "check") or nil -- (kit-b U7b) PixelIcons; a member who left keeps the sign
			local color = m.Left and MUTED or (m.Downed and C.Bad or C.Good)
			-- (kit-b U9-7) a square well tag per member: the green tick up, the red skull down
			local chipF = H.frame(U.CardMembers, "Member" .. i, { BackgroundTransparency = 0, BackgroundColor3 = SIGN.Well, LayoutOrder = i })
			H.edge(chipF, SIGN.WellEdge, 2)
			chipF:SetAttribute("Downed", m.Downed == true)
			chipF:SetAttribute("Left", m.Left == true)
			-- (merge kitb-look1) 4 px in, to the tag's right end (was 6 / -8): the mark keeps a whole 6 screen px from the name
			local chipText = H.text(chipF, "Text", (m.Left and (G.Gone .. " ") or "") .. tostring(m.Name or "?"), "Body", 18, color, { Position = UDim2.fromOffset(4, 0), Size = UDim2.new(1, -4, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
			if mark then
				PixelIcon.Lead(chipText, mark)
			end
		end
	end
	local t = S.Totals
	U.CardLoot.Visible = (t.Cash + t.Tokens + t.Xp + (t.Gems or 0)) > 0
	U.CardLoot.Text = R.lootText()
	U.CardReady.Visible = false
	U.CardLeave.Visible = run.State ~= "Ending"
	local armed = now <= S.LeaveArmed
	U.CardLeave.Text = armed and "Sure? Tap again" or "Leave"
	-- the phone chip: room / wave or the toast or the status
	S.ChipWords = nil -- (C34) only the countdown has a long / short pair
	U.ChipText.Text = toast and (toast.Short or toast.Text) or R.chipText(room, count)
	-- (kit-b U9-7) the loot flash takes the whole chip for its few seconds (beside LEAVE it ran past a portrait phone's chip);
	-- (U9-7 review) a chip that is its LEAVE alone (a fight: R.placeChip) keeps LEAVE and shows no text
	U.ChipText.Visible = not S.ChipCompact
	U.ChipButton.Visible = run.State ~= "Ending" and (toast == nil or S.ChipCompact == true)
	H.setIconTile(U.ChipIcon, (toast and not S.ChipCompact) and toast.Icon or nil)
	U.ChipCount.Visible = false
	-- (U9-7 look) the run's room blocks after the chip's words (not on a toast, not on a chip that is its LEAVE alone)
	R.pips(U.ChipText, (toast == nil and not S.ChipCompact) and room or nil, count)
	R.cardHeight()
	R.fitChip()
	R.fitCard()
	-- (bug batch 2 #14: the chip's button is LEAVE in the alcove too; chests open only at the chest)
	U.ChipButton.Text = armed and "Sure?" or "Leave"
	CloudUI.SetStyle(U.ChipButton, "Red")
	R.placeHit()
end

-- team balance (spec 2026-10-31 s.7): a lost floor (Wipe / Timeout, End.Pets from the server): the loss screen in place of the
-- End card and of the battle HUD's KNOCKED OUT card. Fight again only for a solo run. -> true when it took over
function R.showLoss(e)
	local LS = H.lossScreen()
	if not LS or (e.Reason ~= "Wipe" and e.Reason ~= "Timeout") or type(e.Pets) ~= "table" or #e.Pets == 0 then
		return false
	end
	local f = math.floor(tonumber(e.Floor) or 1)
	local name = tostring(e.Name or H.floorInfo(f).Name)
	local room = tostring(e.Room or 1)
	local timeout = e.Reason == "Timeout"
	local t = type(e.Totals) == "table" and e.Totals or S.Totals
	local lines = {
		{ "+$" .. H.commas(t.Cash) .. " Cash", C.Good },
		{ "+" .. H.commas(t.Tokens) .. " Tokens", C.Token },
		{ "+" .. H.commas(t.Xp) .. " Pet XP", C.Blue },
	}
	if (tonumber(t.Gems) or 0) > 0 then
		lines[#lines + 1] = { "+" .. H.commas(t.Gems) .. " Gems", C.Gem }
	end
	local okS, shown = pcall(LS.Show, {
		Mode = "Dungeon",
		Title = timeout and "TIME IS UP" or "KNOCKED OUT",
		Color = C.Accent,
		Sub = timeout and ("Floor " .. f .. ", the " .. name .. ": time ran out in room " .. room) or ("Floor " .. f .. ": the " .. name .. " got you in room " .. room),
		Pets = e.Pets,
		Lines = lines,
		Start = f,
		OnFightAgain = e.Solo == true and function()
			H.request("Solo", f)
		end or nil,
	})
	if not okS or shown ~= true then
		H.warnOnce("loss screen", shown)
		return false
	end
	local inst = script.Parent:FindFirstChild("BattleController")
	local okB, battle = pcall(function()
		return inst and require(inst)
	end)
	if okB and type(battle) == "table" and type(battle.HideResult) == "function" then
		H.safe("result card", battle.HideResult)
	end
	return true
end

-- (U9-7 look) a text's size in a label's font: DungeonController.Metrics.MEASURE, else Theme.MeasureLabel (TextService);
-- width: the wrap width (nil: one line). -> Vector2 or nil
function R.measure(label, text, width)
	local hook = DungeonController.Metrics.MEASURE
	local ok, size = pcall(function()
		if hook then
			return hook(label, text, width)
		end
		return Theme.MeasureLabel(label, text, label.TextSize, width)
	end)
	return (ok and typeof(size) == "Vector2") and size or nil
end

-- (Pitch 2 item 02 B, look review round 1) the End card's model in the result template's shape (BattleController
-- Hud.ResultModel): the head (a cleared floor green "FLOOR 3 CLEARED!", else violet "RUN OVER"), the mode - reason line, the
-- stat rows (the floor, the rooms cleared, a new best), the totals as reward chips (what is above 0; nothing at all: a muted
-- note), the first clear and the unlock as notes (FirstClear / Unlocked)
function R.endModel(e)
	local cleared = e.Cleared == true
	local f = math.floor(tonumber(e.Floor) or 1)
	local name = tostring(e.Name or H.floorInfo(f).Name)
	local reason = tostring(e.Reason or "")
	local room = math.max(1, math.floor(tonumber(e.Room) or 1))
	local M = { stats = {}, chips = {}, notes = {} }
	if cleared then
		M.title, M.color, M.icon = "FLOOR " .. f .. " CLEARED!", SIGN.Grass, "trophy"
	else
		M.title, M.color, M.icon = "RUN OVER", SIGN.Violet, "castle"
	end
	local why
	if cleared then
		why = "you beat the " .. name
	elseif reason == "Timeout" then
		why = "time ran out in room " .. room
	elseif reason == "Wipe" then
		why = "the " .. name .. " got you in room " .. room
	elseif reason == "Quit" or reason == "Left" then
		why = "you left: your loot is kept"
	elseif reason == "Shutdown" then
		why = "the server is restarting: your loot is kept"
	else
		why = "the run ended: your loot is kept"
	end
	M.sub = "Dungeon - " .. why
	local count = math.floor(tonumber(e.RoomCount) or tonumber(S.EndRooms) or 0)
	local done = cleared and room or (room - 1)
	if count > 0 then
		done = math.min(done, count)
	end
	-- (playtest 2026-11-28 C9 review) the green tick (a row's 5th field, Hud.BuildResult) only on what the player achieved,
	-- as on the battle's cards: the floor and its rooms on a cleared floor, a new best always (a wipe read "Floor 5 [tick] /
	-- Rooms 2 / 4 [tick]")
	M.stats[#M.stats + 1] = { "Floor", "castle", "Floor", tostring(f), cleared }
	M.stats[#M.stats + 1] = { "Rooms", "key", "Rooms", (count > 0) and (done .. " / " .. count) or tostring(done), cleared }
	if e.NewBest then
		local best = (type(e.NewBest) == "number") and math.floor(e.NewBest) or f
		M.stats[#M.stats + 1] = { "Best", "star", "New best", tostring(best), true }
	end
	local t = type(e.Totals) == "table" and e.Totals or S.Totals
	local function chip(key, icon, number, word)
		M.chips[#M.chips + 1] = { key, icon, number, word }
	end
	local tokens, cash, xp, gems = tonumber(t.Tokens) or 0, tonumber(t.Cash) or 0, tonumber(t.Xp) or 0, tonumber(t.Gems) or 0
	if tokens > 0 then
		chip("Tokens", Config.Icons.Tokens, "+" .. Theme.Short(tokens), "Tokens")
	end
	if cash > 0 then
		chip("Cash", Config.Icons.Cash, "+$" .. Theme.Short(cash), "Cash")
	end
	if xp > 0 then
		chip("Xp", "up", "+" .. Theme.Short(xp), "Pet XP")
	end
	if gems > 0 then
		chip("Gems", "gem", "+" .. Theme.Short(gems), "Gems")
	end
	if #M.chips == 0 then
		M.notes[#M.notes + 1] = { "No loot this run", true }
	end
	local first = type(e.FirstClear) == "table" and e.FirstClear or nil
	if first then
		M.notes[#M.notes + 1] = { "First clear! +" .. H.commas(first.Tokens or 0) .. " tokens  +" .. H.commas(first.Gems or 0) .. " gems", false, "FirstClear", "star" }
	end
	if tonumber(e.Unlocked) then
		M.notes[#M.notes + 1] = { "Floor " .. math.floor(e.Unlocked) .. " unlocked!", false, "Unlocked", Config.Icons.Dungeon or "key" }
	end
	return M
end

-- the End card's body: the template (BattleController.ResultTemplate) at the card's width, built again only when the width,
-- the reason line's drop (S.EndCompact), the scale or a value changes (the End card refreshes 4 times a second); OK's lip
-- counts down the K.END_SECONDS. The card is exactly as tall as what it shows
function R.fillEnd()
	local e = S.End
	local BC = H.controller("BattleController")
	if not (BC and type(BC.ResultTemplate) == "function") then
		H.warnOnce("result template", "BattleController.ResultTemplate missing")
		return
	end
	local M = R.endModel(e)
	local width = U.End.Root.Size.X.Offset
	local vp = H.viewport()
	local phone = H.isPhone()
	local landscape = phone and vp.X > vp.Y
	local parts = { width, tostring(S.EndCompact), M.title, M.sub, U.EndScale.Scale }
	for _, list in ipairs({ M.stats, M.chips, M.notes }) do
		for _, item in ipairs(list) do
			parts[#parts + 1] = tostring(item[1]) .. "/" .. tostring(item[3]) .. "/" .. tostring(item[4])
		end
	end
	local sig = table.concat(parts, "|")
	if U.EndSig ~= sig or not U.EndBuilt then
		local inner = width - 20
		local okB, built = pcall(BC.ResultTemplate, U.End.Body, M, {
			W = width,
			F = U.EndScale.Scale,
			Compact = phone,
			Landscape = landscape,
			Cols = (landscape and inner >= K.END_TWO_COL - 20) and 2 or 1,
			NoReason = S.EndCompact == true,
			OnOk = function()
				S.End = nil
				R.refresh()
			end,
		})
		if not okB or type(built) ~= "table" then
			H.warnOnce("result template", built)
			return
		end
		U.EndSig = sig
		U.EndBuilt = built
		S.EndBuiltSig = tostring(landscape) .. "/" .. tostring(width) -- (R.placeEndLandscape: which card its heights are)
		U.EndTimer = { segs = built.Segs, count = 5, lit = -1 }
		if not S.EndCompact then
			S.EndReasonRow = built.ReasonRow
		end
	end
	U.EndOk = U.EndBuilt.Ok
	S.EndBuiltAt = S.EndAt -- (R.placeEndLandscape: the card now holds this End's model, built now or unchanged)
	if type(BC.PaintResultTimer) == "function" then
		BC.PaintResultTimer(U.EndTimer, 1 - (os.clock() - S.EndAt) / K.END_SECONDS)
	end
	U.End.Root.Size = UDim2.fromOffset(width, U.EndBuilt.H + K.CARD_LIP)
end

----------------------------------------------------------------------
-- The room change fade (dungeon-fixes decision 2): one black Frame in its own ScreenGui
----------------------------------------------------------------------
function R.buildFade()
	local gui = CloudUI.NewScreenGui("NimbusDungeonFade", K.FADE_ORDER)
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	U.FadeGui = gui
	U.Fade = Util.Create("Frame", {
		Name = "Fade",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Active = false,
		Visible = false,
		ZIndex = 10,
		Parent = gui,
	})
end

function R.fadeStep(v, default)
	v = tonumber(v)
	if not v or v ~= v then
		return default
	end
	return math.max(0, math.min(K.FADE_MAX_STEP, v))
end

function R.fadeTween(target, seconds)
	if S.FadeTween then
		pcall(function()
			S.FadeTween:Cancel()
		end)
		S.FadeTween = nil
	end
	if seconds <= 0 then
		U.Fade.BackgroundTransparency = target
		return
	end
	S.FadeTween = H.tween(U.Fade, seconds, { BackgroundTransparency = target }, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
end

-- DungeonState "Fade" { Out, Hold, In }: to black over Out, hold (until the next room's Run payload arrived, >= Hold),
-- back over In; FADE_SAFETY clears it whatever happens
function R.fade(payload)
	if not U.Fade then
		return
	end
	local fade = {
		Token = (S.Fade and S.Fade.Token or S.FadeSeq or 0) + 1,
		Out = R.fadeStep(payload.Out, 0.45),
		Hold = R.fadeStep(payload.Hold, 0.35),
		In = R.fadeStep(payload.In, 0.45),
		Key = S.PhaseKey,
		Phase = "Out",
		HardAt = os.clock() + K.FADE_SAFETY,
	}
	-- wave 5: where the camera sits behind the character at the door (the walk-in blends back to it)
	local camera = Workspace.CurrentCamera
	local rp = H.rootPosition()
	if camera and rp and camera.CameraType ~= Enum.CameraType.Scriptable then
		fade.CamOff = camera.CFrame.Position - rp
		fade.CamRot = camera.CFrame - camera.CFrame.Position
	end
	S.FadeSeq = fade.Token
	S.Fade = fade
	U.FadeGui.Enabled = true
	U.Fade.Visible = true
	R.fadeTween(0, fade.Out)
	task.delay(fade.Out + fade.Hold, function()
		if S.Fade == fade then
			fade.Phase = "Hold"
			-- the server moved us already (a new State / Room): fade back in now, else on the next Run payload
			if S.PhaseKey ~= fade.Key or not S.Run then
				R.fadeIn()
			end
		end
	end)
	task.delay(K.FADE_SAFETY, function()
		if S.Fade == fade then
			R.clearFade()
		end
	end)
end

function R.fadeIn()
	local fade = S.Fade
	if not fade or fade.Phase == "In" then
		return
	end
	fade.Phase = "In"
	if S.Walk and S.Walk.Phase == "Hold" then
		H.safe("walk go", R.walkGo)
	end
	R.fadeTween(1, fade.In)
	task.delay(fade.In, function()
		if S.Fade == fade then
			R.clearFade()
		end
	end)
end

-- the overlay off at once (End, leaving the run, the safety timeout)
function R.clearFade()
	S.Fade = nil
	if S.Walk and S.Walk.Phase == "Hold" then
		H.safe("walk go", R.walkGo)
	end
	if S.FadeTween then
		pcall(function()
			S.FadeTween:Cancel()
		end)
		S.FadeTween = nil
	end
	if U.Fade then
		U.Fade.BackgroundTransparency = 1
		U.Fade.Visible = false
	end
	if U.FadeGui then
		U.FadeGui.Enabled = false
	end
end

-- kit-b S3 (sky audit F9): End with the fade on screen: the fade is over at once (S.Fade nil), but the black frame
-- tweens out over Config.Sky.Transitions.Screen.Lift (0.3 s) instead of vanishing in one frame. -> true when the screen
-- was black (nearly opaque) at that moment: the light may change under it unseen
function R.liftFade()
	local frame = U.Fade
	if not (S.Fade and frame and frame.Visible and frame.BackgroundTransparency < 0.99) then
		R.clearFade()
		return false
	end
	local black = frame.BackgroundTransparency <= 0.1
	local tr = type(Config.Sky) == "table" and Config.Sky.Transitions
	local lift = type(tr) == "table" and type(tr.Screen) == "table" and tonumber(tr.Screen.Lift) or 0.3
	S.Fade = nil
	if S.Walk and S.Walk.Phase == "Hold" then
		H.safe("walk go", R.walkGo)
	end
	local seq = S.FadeSeq
	R.fadeTween(1, lift)
	task.delay(lift, function()
		-- a new fade since (FadeSeq moved) keeps the overlay
		if S.Fade == nil and S.FadeSeq == seq then
			R.clearFade()
		end
	end)
	return black
end

-- the light loop's safety net (a lost task.delay never leaves the screen black)
function R.fadeTick()
	local fade = S.Fade
	if not fade then
		return
	end
	local now = os.clock()
	if now >= fade.HardAt then
		R.clearFade()
	elseif fade.Phase == "Hold" and now >= fade.HardAt - fade.In then
		R.fadeIn()
	end
end

----------------------------------------------------------------------
-- Lighting (LightingStack "Dungeon") and the door slides
----------------------------------------------------------------------
function R.lightingStack()
	if R.LS == nil then
		local module = Client:FindFirstChild("LightingStack")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		R.LS = (ok and type(result) == "table") and result or false
	end
	return R.LS or nil
end

-- bug #5: each style tier has its own mood (DungeonBuilder.Styles[s].Mood, a little darker deeper in the tier); the
-- server writes it on the pocket's holder (MoodAmbient / MoodOutdoor / MoodBrightness / MoodContrast / MoodTint).
-- No holder attributes (an older server, the lobby) = the contract 5.6 preset. The mood is never darker than that
-- preset (ambient per channel, brightness): the review's phone-readability cap (DungeonBuilder.MoodFloor, server side).
local function atLeast(c, lo)
	return Color3.new(math.max(c.R, lo.R), math.max(c.G, lo.G), math.max(c.B, lo.B))
end
function R.mood(holder)
	local amb = holder and holder:GetAttribute("MoodAmbient")
	if typeof(amb) ~= "Color3" then
		return nil
	end
	local out = holder:GetAttribute("MoodOutdoor")
	local tint = holder:GetAttribute("MoodTint")
	return {
		Lighting = {
			Ambient = atLeast(amb, PRESET.Lighting.Ambient),
			OutdoorAmbient = atLeast(typeof(out) == "Color3" and out or PRESET.Lighting.OutdoorAmbient, PRESET.Lighting.OutdoorAmbient),
		},
		ColorCorrection = {
			Brightness = math.max(tonumber(holder:GetAttribute("MoodBrightness")) or PRESET.ColorCorrection.Brightness, PRESET.ColorCorrection.Brightness),
			Contrast = tonumber(holder:GetAttribute("MoodContrast")) or PRESET.ColorCorrection.Contrast,
			TintColor = typeof(tint) == "Color3" and tint or PRESET.ColorCorrection.TintColor,
		},
	}
end

function R.preset()
	local mood = R.mood(R.findPocket and R.findPocket() or nil)
	S.MoodSet = mood ~= nil
	local preset = { Lighting = mood and mood.Lighting or PRESET.Lighting, ColorCorrection = mood and mood.ColorCorrection or PRESET.ColorCorrection }
	local atmosphere = game:GetService("Lighting"):FindFirstChildOfClass("Atmosphere")
	if atmosphere then
		-- the living sky moves the base (SkyController): the haze adds to the CURRENT sky's density without this
		-- preset (a re-push never adds twice), not to a value cached at the first run
		local LS = R.lightingStack()
		local base = nil
		if LS and type(LS.Value) == "function" then
			local ok, value = pcall(LS.Value, "Atmosphere", "Density", K.LIGHT_ID)
			base = ok and type(value) == "number" and value or nil
		end
		preset.Atmosphere = { Density = math.min(PRESET.AtmosphereMax, (base or atmosphere.Density or 0.3) + PRESET.AtmosphereAdd) }
	end
	return preset
end

-- client/SoundFx (optional: a build without it is silent)
function R.soundFx()
	if R.SF == nil then
		local module = Client:FindFirstChild("SoundFx")
		local ok, result = false, nil
		if module then
			ok, result = pcall(require, module)
		end
		R.SF = (ok and type(result) == "table") and result or false
	end
	return R.SF or nil
end

function R.sound(name)
	local SF = R.soundFx()
	if SF and type(SF.Play) == "function" then
		H.safe("sound", SF.Play, name)
	end
end

-- kit-b S3 (sky audit F9): the zone timings, Config.Sky.Transitions.Zone (In 1.5 / Late 2.5 / Out 2; was 1 s each)
local function zoneSeconds(key, default)
	local tr = type(Config.Sky) == "table" and Config.Sky.Transitions
	local zone = type(tr) == "table" and tr.Zone
	local v = type(zone) == "table" and tonumber(zone[key]) or nil
	return (v and v == v and v >= 0) and v or default
end

-- off: over Zone.Out, or over `seconds` when given (End under a black fade: 0, the change is never seen)
function R.light(on, seconds)
	if on == S.Lit then
		return
	end
	local LS = R.lightingStack()
	S.Lit = on
	local SF = R.soundFx()
	if SF and type(SF.SetLayer) == "function" then
		H.safe("music", SF.SetLayer, "Dungeon", on) -- (the dungeon's track while in the run; back to the lobby's after)
	end
	if not LS then
		return
	end
	if on then
		H.safe("light push", LS.Push, K.LIGHT_ID, R.preset(), zoneSeconds("In", 1.5))
		if not S.MoodSet then
			-- the run started before the player stood in the pocket (streaming, a slow join): re-read the style's mood
			-- every K.MOOD_RETRY s up to K.MOOD_TRIES times while the run's lighting is on, push it once it can be read,
			-- over Zone.Late (a slow re-tint while the player is already playing)
			S.MoodGen = (S.MoodGen or 0) + 1
			local gen = S.MoodGen
			task.spawn(function()
				for _ = 1, K.MOOD_TRIES or 10 do
					task.wait(K.MOOD_RETRY or 1)
					if not S.Lit or S.MoodSet or S.MoodGen ~= gen then
						return
					end
					local preset = R.preset()
					if S.MoodSet then
						H.safe("light push", LS.Push, K.LIGHT_ID, preset, zoneSeconds("Late", 2.5))
						return
					end
				end
			end)
		end
	else
		H.safe("light pop", LS.Pop, K.LIGHT_ID, tonumber(seconds) or zoneSeconds("Out", 2))
	end
end

-- bug batch 2 (#19): the camera zoom cap of a run (MovementController.SetZoomMax: K.ZOOM_RUN on, nil = the normal 40)
function R.zoom(on)
	on = on == true
	if on == S.Zoomed then
		return
	end
	S.Zoomed = on
	R.camBind(on)
	local MC = H.controller("MovementController")
	if MC and type(MC.SetZoomMax) == "function" then
		if not on then
			H.safe("zoom", MC.SetZoomMax, nil)
			return
		end
		-- the nudge: the max at 10 pulls the current zoom in at once, then the cap goes back up to 14
		H.safe("zoom", MC.SetZoomMax, K.ZOOM_NUDGE)
		task.delay(0.1, function()
			if S.Zoomed then
				H.safe("zoom", MC.SetZoomMax, K.ZOOM_RUN)
			end
		end)
	end
end

-- wave 6: the camera boxes of the pieces in my pocket (the hall, each Room_<n>'s corridor + room, the treasure: the
-- CamMin / CamMax attributes on the piece models), cached until a Run payload or a room added / removed
function R.camBoxes()
	if S.CamBoxes then
		return S.CamBoxes
	end
	local pocket = S.Pocket and S.Pocket.Parent and S.Pocket or nil
	if not pocket then
		return nil
	end
	local out = {}
	local function add(m)
		local a, b = m:GetAttribute("CamMin"), m:GetAttribute("CamMax")
		if typeof(a) == "Vector3" and typeof(b) == "Vector3" then
			out[#out + 1] = { Min = a, Max = b }
		end
	end
	for _, child in ipairs(pocket:GetChildren()) do
		if child:IsA("Model") then
			add(child)
			for _, piece in ipairs(child:GetChildren()) do
				if piece:IsA("Model") then
					add(piece)
				end
			end
		end
	end
	S.CamBoxes = out
	return out
end

local function camInBox(b, p)
	return p.X >= b.Min.X and p.X <= b.Max.X and p.Y >= b.Min.Y and p.Y <= b.Max.Y and p.Z >= b.Min.Z and p.Z <= b.Max.Z
end

-- one slab of camExit: the ray's t where it leaves [lo + m, hi - m] along one axis (v = the boom's component)
local function camSlab(t, v, f, lo, hi, m)
	if v > 1e-6 then
		return math.min(t, (hi - m - f) / v)
	elseif v < -1e-6 then
		return math.min(t, (lo + m - f) / v)
	end
	return t
end

-- where the ray F + boom * t (t >= 0) leaves box b shrunk by m (slab method; >= 0). Runs several times a frame, so
-- the three axes are unrolled (no per-frame table)
local function camExit(b, F, boom, m)
	local t = camSlab(math.huge, boom.X, F.X, b.Min.X, b.Max.X, m)
	t = camSlab(t, boom.Y, F.Y, b.Min.Y, b.Max.Y, m)
	t = camSlab(t, boom.Z, F.Z, b.Min.Z, b.Max.Z, m)
	return math.max(0, t)
end

-- every frame after the camera scripts: the boom cut where it leaves the boxes (same ray, so the view keeps its look)
function R.camClamp()
	local cam = Workspace.CurrentCamera
	if not cam or not S.Run or S.Walk or cam.CameraType ~= Enum.CameraType.Custom then
		return
	end
	local boxes = R.camBoxes()
	if not boxes or #boxes == 0 then
		return
	end
	local cf = cam.CFrame
	local F = cam.Focus.Position
	local boom = cf.Position - F
	if boom.Magnitude < 1 then
		return -- first person
	end
	local box = nil
	for _, b in ipairs(boxes) do
		if camInBox(b, F) then
			box = b
			break
		end
	end
	if not box then
		return -- a teleport frame
	end
	local t = 1
	for hop = 1, 3 do
		local inner = camExit(box, F, boom, K.CAM_MARGIN)
		if inner >= 1 then
			t = 1
			break
		end
		-- through a doorway: the ray goes on in the box it enters
		local p = F + boom * math.min(1, camExit(box, F, boom, 0) + 0.02)
		local nextBox = nil
		if hop < 3 then
			for _, b in ipairs(boxes) do
				if b ~= box and camInBox(b, p) then
					nextBox = b
					break
				end
			end
		end
		if not nextBox then
			t = inner
			break
		end
		box = nextBox
	end
	if t < 1 then
		cam.CFrame = CFrame.new(F + boom * t) * (cf - cf.Position)
	end
end

function R.camBind(on)
	if on == S.CamBound then
		return
	end
	S.CamBound = on
	S.CamBoxes = nil
	pcall(function()
		if on then
			RunService:BindToRenderStep(K.CAM_BIND, H.renderPriority(1), function()
				H.safe("camera box", R.camClamp)
			end)
		else
			RunService:UnbindFromRenderStep(K.CAM_BIND)
		end
	end)
end

-- where a pocket holder stands for R.findPocket: its hall's floor (PrimaryPart / Base), never the hall's bounding box.
-- (wave 6 Studio check: a client-dressed mesh placed before its door model's PrimaryPart replicated sat at the world
-- origin inside Entrance_1 and moved the box centre ~6400 studs away: no pocket found -> WalkSkip NoRoom on every room,
-- and no camera box clamp for the whole run)
function H.pocketAnchor(holder)
	local hall = holder:FindFirstChild("Entrance_1") or holder:FindFirstChildWhichIsA("Model")
	if not hall then
		return H.positionOf(holder)
	end
	local floorPart = (hall:IsA("Model") and hall.PrimaryPart) or hall:FindFirstChild("Base")
	if floorPart and floorPart:IsA("BasePart") then
		return floorPart.Position
	end
	return H.positionOf(hall)
end

-- the pocket (workspace.Dungeons.Dungeon_<i>) the player stands in: the nearest holder within 400 studs
function R.findPocket()
	local folder = Workspace:FindFirstChild("Dungeons")
	local pos = H.rootPosition()
	if not folder or not pos then
		return nil
	end
	local best, bestD = nil, 400
	for _, holder in ipairs(folder:GetChildren()) do
		local at = H.pocketAnchor(holder)
		if at then
			local d = (at - pos).Magnitude
			if d < bestD then
				best, bestD = holder, d
			end
		end
	end
	return best
end

function R.unwatchDoors()
	for _, conn in ipairs(S.Doors) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	S.Doors = {}
	S.Pocket = nil
	S.CamBoxes = nil
end

-- local copies of a door's bars sink into the floor (the server already switched the real bars off)
function R.slide(door)
	if typeof(door) ~= "Instance" then
		return
	end
	local n = 0
	for _, bar in ipairs(door:GetChildren()) do
		if bar.Name == "Bar" and bar:IsA("BasePart") and n < 8 then
			n = n + 1
			local ghost = Instance.new("Part")
			ghost.Name = "BarSlide"
			ghost.Anchored = true
			ghost.CanCollide = false
			ghost.CanQuery = false
			ghost.CanTouch = false
			ghost.CastShadow = false
			ghost.Size = bar.Size
			ghost.CFrame = bar.CFrame
			ghost.Color = bar.Color
			ghost.Material = bar.Material
			ghost.Parent = Workspace
			H.tween(ghost, 0.7, { CFrame = bar.CFrame * CFrame.new(0, -bar.Size.Y, 0), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.8, function()
				ghost:Destroy()
			end)
		end
	end
end

function R.watchRoom(room)
	if not room:IsA("Model") then
		return
	end
	table.insert(S.Doors, room:GetAttributeChangedSignal("DoorOpen"):Connect(function()
		if room:GetAttribute("DoorOpen") == true then
			R.slide(room:FindFirstChild("Door_Exit"))
		end
	end))
	table.insert(S.Doors, room:GetAttributeChangedSignal("EntranceOpen"):Connect(function()
		if room:GetAttribute("EntranceOpen") == true then
			R.slide(room:FindFirstChild("Door_Entrance"))
		end
	end))
end

function R.watchDoors()
	if S.Pocket and S.Pocket.Parent then
		return
	end
	R.unwatchDoors()
	local pocket = R.findPocket()
	if not pocket then
		return
	end
	S.Pocket = pocket
	for _, room in ipairs(pocket:GetChildren()) do
		R.watchRoom(room)
	end
	table.insert(S.Doors, pocket.ChildAdded:Connect(function(child)
		R.watchRoom(child)
		S.CamBoxes = nil
	end))
	table.insert(S.Doors, pocket.ChildRemoved:Connect(function()
		S.CamBoxes = nil
	end))
	S.CamBoxes = nil
end

----------------------------------------------------------------------
-- Wave 5 helpers (bugs #15 / #26)
----------------------------------------------------------------------
function H.clientModule(name)
	H.Mods = H.Mods or {}
	if H.Mods[name] == nil then
		local inst = Client:FindFirstChild(name)
		local ok, mod = false, nil
		if inst then
			ok, mod = pcall(require, inst)
		end
		H.Mods[name] = (ok and type(mod) == "table") and mod or false
	end
	return H.Mods[name] or nil
end

function H.mc()
	if H.MC == nil then
		H.MC = H.controller("MovementController") or false
	end
	return H.MC or nil
end

function H.mcCall(fn, ...)
	local mc = H.mc()
	if mc and type(mc[fn]) == "function" then
		pcall(mc[fn], ...)
	end
end

function H.lowGfx()
	local gq = H.clientModule("GraphicsQuality")
	if gq and type(gq.Effective) == "function" then
		local ok, mode = pcall(gq.Effective)
		return ok and mode == "Low"
	end
	return false
end

function H.character()
	local char = LocalPlayer and LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if hum and root and root:IsA("BasePart") then
		return char, hum, root
	end
	return nil
end

function H.renderPriority(extra)
	local ok, v = pcall(function()
		return Enum.RenderPriority.Camera.Value
	end)
	return (ok and v or 200) + extra
end

function H.smooth(p)
	return p * p * (3 - 2 * p)
end

function H.clamp01(v)
	return math.max(0, math.min(1, v))
end

-- a key / click / tap / button that skips a cinematic (not a mouse move, a stick, a focus change, sensors)
local SKIP_IGNORE = { MouseMovement = true, MouseWheel = true, Focus = true, TextInput = true, Gyro = true, Accelerometer = true, None = true, InputMethod = true }
local STICKS = { Thumbstick1 = true, Thumbstick2 = true }
function H.isSkipInput(input)
	if typeof(input) ~= "Instance" and type(input) ~= "table" and typeof(input) ~= "InputObject" then
		return false
	end
	local okT, t = pcall(function()
		return input.UserInputType.Name
	end)
	local okK, k = pcall(function()
		return input.KeyCode.Name
	end)
	if not okT or SKIP_IGNORE[t] then
		return false
	end
	if okK and STICKS[k] then
		return false
	end
	if okT and t:sub(1, 7) == "Gamepad" and (not okK or k == "Unknown") then
		return false
	end
	return true
end

function H.onSkipInput(input, processed)
	if not S.Walk and not S.Enter then
		return
	end
	if processed then
		return
	end
	if not H.isSkipInput(input) then
		return
	end
	if S.Walk then
		R.walkSkip()
	elseif S.Enter then
		R.enterSkip()
	end
end

----------------------------------------------------------------------
-- Wave 5 (bug #26): the room walk-in
----------------------------------------------------------------------
local SINK_KEYS = {
	Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left,
	Enum.KeyCode.Right, Enum.KeyCode.Space, Enum.KeyCode.ButtonA, Enum.KeyCode.Thumbstick1,
}

-- the movement keys during the walk-in: sunk (the character walks itself); a press skips
function R.walkSink(_name, state, input)
	if state == Enum.UserInputState.Begin then
		local okK, k = pcall(function()
			return input.KeyCode.Name
		end)
		if not (okK and STICKS[k]) then
			R.walkSkip()
		end
	end
	return Enum.ContextActionResult.Sink
end

function R.walkControls(off, w)
	if off then
		local ok, controls = pcall(function()
			local ps = LocalPlayer:FindFirstChild("PlayerScripts")
			local pm = ps and ps:FindFirstChild("PlayerModule")
			if not pm then
				return nil
			end
			return require(pm):GetControls()
		end)
		if ok and type(controls) == "table" and type(controls.Disable) == "function" then
			if pcall(controls.Disable, controls) then
				w.Controls = controls
			end
		end
		w.Sunk = pcall(function()
			ContextActionService:BindActionAtPriority(K.WALK_ACTION, R.walkSink, false, Enum.ContextActionPriority.High.Value + 1, (table.unpack or unpack)(SINK_KEYS))
		end)
	else
		if w.Controls then
			pcall(w.Controls.Enable, w.Controls)
			w.Controls = nil
		end
		if w.Sunk then
			pcall(function()
				ContextActionService:UnbindAction(K.WALK_ACTION)
			end)
			w.Sunk = false
		end
	end
end

-- the camera of the walk-in at progress e (0..1): inside the room, in front of the walkers, looking back at them
function R.walkCam(w, e)
	local c = K.WALK_CAM
	local at = w.End + w.Inward * (c.Ahead + c.Pull * e) + w.Right * (c.Swing * math.sin(e * math.pi / 2) * w.Side) + Vector3.new(0, c.Up - c.Settle * e, 0)
	return CFrame.lookAt(at, w.Root.Position + Vector3.new(0, 1.2, 0))
end

-- wave 6: why a room payload played no walk-in (nil = it played): GetState().WalkSkip and the run gui's WalkSkip
-- attribute (readable in Studio's Explorer during a play test)
function R.walkSkipped(why)
	S.WalkSkip = why
	if U.RunGui then
		U.RunGui:SetAttribute("WalkSkip", why)
	end
end

-- the next room's Run payload arrived under the fade: set the shot up while the screen is still black
-- -> true, or false + why ("InMatch" | "NoCharacter" | "NoRoom" | "Inward")
function R.walkPrepare(room, key)
	if S.Walk then
		R.walkClear()
	end
	if H.inMatch() or not LocalPlayer then
		return false, "InMatch"
	end
	local char, hum, root = H.character()
	local camera = Workspace.CurrentCamera
	if not char or hum.Health <= 0 or not camera then
		return false, "NoCharacter"
	end
	local pocket = (S.Pocket and S.Pocket.Parent and S.Pocket) or R.findPocket()
	local model = pocket and pocket:FindFirstChild("Room_" .. tostring(room))
	local th = model and model:FindFirstChild("Threshold")
	if not th or not th:IsA("BasePart") then
		return false, "NoRoom"
	end
	local doorPos = H.positionOf(model:FindFirstChild("Door_Entrance")) or root.Position
	local d = th.Position - doorPos
	local inward = Vector3.new(d.X, 0, d.Z)
	if inward.Magnitude < 0.5 then
		d = th.Position - root.Position
		inward = Vector3.new(d.X, 0, d.Z)
	end
	if inward.Magnitude < 0.5 then
		return false, "Inward"
	end
	inward = inward.Unit
	local right = inward:Cross(Vector3.new(0, 1, 0))
	local fade = S.Fade
	local w = {
		Token = (S.WalkSeq or 0) + 1,
		Room = room,
		Key = key,
		Phase = "Hold",
		Th = th,
		Inward = inward,
		Right = right,
		Hum = hum,
		Root = root,
		CamOff = fade and fade.CamOff or (camera.CFrame.Position - root.Position),
		CamRot = fade and fade.CamRot or (camera.CFrame - camera.CFrame.Position),
		HardAt = os.clock() + K.FADE_SAFETY + K.WALK_SAFETY,
		T0 = os.clock(),
	}
	R.walkLane(w)
	S.WalkSeq = w.Token
	S.Walk = w
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = R.walkCam(w, 0)
	H.mcCall("SetFovOverride", K.WALK_CAM.Fov0)
	H.mcCall("SetCinematic", K.WALK_SPEED)
	R.walkControls(true, w)
	RunService:BindToRenderStep(K.WALK_BIND, H.renderPriority(2), function(dt)
		H.safe("walk step", R.walkStep, dt)
	end)
	R.refresh()
	-- the fade is already lifting (a late payload): go now
	if S.Fade == nil or S.Fade.Phase == "In" then
		R.walkGo()
	end
	return true
end

-- my lane across the doorway and the end point, from where the root stands NOW (the server's teleport into the room
-- and its Run payload are not ordered, so R.walkGo recomputes them as the fade lifts)
function R.walkLane(w)
	local th, root, right = w.Th, w.Root, w.Right
	local lane = math.max(-K.WALK_LANE, math.min(K.WALK_LANE, (root.Position - th.Position):Dot(right)))
	local base = Vector3.new(th.Position.X, root.Position.Y, th.Position.Z)
	w.Lane = lane
	w.Side = (lane >= 0) and -1 or 1 -- the swing goes to the far side of my lane: the party stays centred
	w.End = base + w.Inward * K.WALK_IN + right * lane
end

-- the fade lifts: the character walks in
function R.walkGo()
	local w = S.Walk
	if not w or w.Phase ~= "Hold" then
		return
	end
	if w.Th.Parent and w.Root.Parent then
		R.walkLane(w)
	end
	w.Phase = "Walk"
	w.T0 = os.clock()
	w.HardAt = w.T0 + K.WALK_SAFETY
	w.NextMove = w.T0 + K.WALK_REISSUE
	pcall(function()
		w.Hum:MoveTo(w.End)
	end)
end

function R.walkStep(_dt)
	local w = S.Walk
	if not w then
		pcall(function()
			RunService:UnbindFromRenderStep(K.WALK_BIND)
		end)
		return
	end
	local now = os.clock()
	local camera = Workspace.CurrentCamera
	if now >= w.HardAt or not camera or not w.Root.Parent or not w.Hum.Parent then
		return R.walkClear()
	end
	if w.Phase == "Hold" or w.Phase == "Walk" then
		local p, e = 0, 0
		if w.Phase == "Walk" then
			p = H.clamp01((now - w.T0) / K.WALK_SECONDS)
			e = H.smooth(p)
		end
		if camera.CameraType ~= Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Scriptable
		end
		camera.CFrame = R.walkCam(w, e)
		local c = K.WALK_CAM
		H.mcCall("SetFovOverride", c.Fov0 + (c.Fov1 - c.Fov0) * e)
		if w.Phase == "Walk" then
			if now >= w.NextMove then
				w.NextMove = now + K.WALK_REISSUE
				pcall(function()
					w.Hum:MoveTo(w.End)
				end)
			end
			local rp = w.Root.Position
			local flat = Vector3.new(rp.X - w.End.X, 0, rp.Z - w.End.Z).Magnitude
			if flat < K.WALK_REACH or p >= 1 or (w.ReleaseBy and now >= w.ReleaseBy) then
				R.walkRelease()
			end
		end
	elseif w.Phase == "Blend" then
		local q = H.clamp01((now - w.T0) / w.Dur)
		local s = H.smooth(q)
		local target = CFrame.new(w.Root.Position + w.CamOff) * w.CamRot
		camera.CFrame = w.From:Lerp(target, s)
		H.mcCall("SetFovOverride", w.FromFov + (K.WALK_CAM.Fov1 - w.FromFov) * s)
		if q >= 1 then
			R.walkClear()
		end
	end
end

-- control comes back now; the camera blends to where it was at the door over `dur`
function R.walkRelease(dur)
	local w = S.Walk
	if not w or w.Phase == "Blend" then
		return
	end
	local camera = Workspace.CurrentCamera
	w.Phase = "Blend"
	w.T0 = os.clock()
	w.Dur = dur or K.WALK_BLEND
	w.From = camera and camera.CFrame or CFrame.new()
	w.FromFov = camera and camera.FieldOfView or K.WALK_CAM.Fov1
	w.HardAt = w.T0 + w.Dur + 1
	H.mcCall("SetCinematic", nil)
	R.walkControls(false, w)
	R.refresh()
end

-- any key / click / tap: at the Threshold at once (the server sees the crossing on its next tick)
function R.walkSkip()
	local w = S.Walk
	if not w or w.Phase == "Blend" then
		return
	end
	local char = LocalPlayer and LocalPlayer.Character
	if char and w.Root.Parent then
		local at = Vector3.new(w.End.X, w.Root.Position.Y, w.End.Z)
		pcall(function()
			char:PivotTo(CFrame.lookAt(at, at + w.Inward))
		end)
	end
	R.walkRelease(K.WALK_SKIP_BLEND)
end

-- the fight began (someone crossed the line): the walk-in hands control back within WALK_FIGHT_GRACE
function R.walkFight()
	local w = S.Walk
	if not w then
		return
	end
	if w.Phase == "Hold" then
		return R.walkClear()
	end
	if w.Phase == "Walk" then
		local by = os.clock() + K.WALK_FIGHT_GRACE
		w.ReleaseBy = math.min(w.ReleaseBy or by, by)
	end
end

-- every exit path (idempotent): the camera back to Custom, the FOV and the controls back, nothing bound
function R.walkClear()
	local w = S.Walk
	if not w then
		return
	end
	S.Walk = nil
	pcall(function()
		RunService:UnbindFromRenderStep(K.WALK_BIND)
	end)
	H.mcCall("SetFovOverride", nil)
	H.mcCall("SetCinematic", nil)
	R.walkControls(false, w)
	local camera = Workspace.CurrentCamera
	if camera and camera.CameraType == Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Custom
	end
	R.refresh()
end

-- the light loop's safety net (a lost RenderStep never leaves the camera Scriptable)
function R.walkTick()
	local w = S.Walk
	if w and os.clock() >= w.HardAt then
		R.walkClear()
	end
	local e = S.Enter
	if e and os.clock() >= e.HardAt + 2 then
		R.enterClear()
	end
end

----------------------------------------------------------------------
-- Wave 5 (bug #15): the voxel-shatter entrance and the dungeon shoulder camera
----------------------------------------------------------------------
-- the Dungeon gate (GateId "Dungeon"; its PrimaryPart GlowCore is the vortex centre). Looked up in the known places
-- only (the Gate Court folder NimbusLobby/Gates, PortalFxController's tracked gates, Workspace's own children), never
-- with a Workspace:GetDescendants() walk (a hitch on a big plaza at the worst moment)
function R.dungeonGate()
	local g = S.Gate
	if g and g.Parent then
		return g
	end
	S.Gate = nil
	local function isGate(d)
		return typeof(d) == "Instance" and d:IsA("Model") and d:GetAttribute("GateId") == "Dungeon"
	end
	local lobby = Workspace:FindFirstChild("NimbusLobby")
	local folder = lobby and lobby:FindFirstChild("Gates")
	for _, d in ipairs(folder and folder:GetChildren() or {}) do
		if isGate(d) then
			S.Gate = d
			return d
		end
	end
	local pfx = H.controller("PortalFxController")
	if pfx and type(pfx.FindGate) == "function" then
		local ok, d = pcall(pfx.FindGate, "Dungeon")
		if ok and isGate(d) and d:IsDescendantOf(Workspace) then
			S.Gate = d
			return d
		end
	end
	for _, d in ipairs(Workspace:GetChildren()) do
		if isGate(d) then
			S.Gate = d
			return d
		end
	end
	return nil
end

function R.enterGrid(low)
	local vp = H.viewport()
	local portrait = vp.Y > vp.X
	local g = K.ENTER_GRID
	local pick = low and (portrait and g.LowPortrait or g.Low) or (portrait and g.Portrait or g.Desktop)
	return pick[1], pick[2]
end

-- the block grid (built once per grid size)
function R.buildEnter(cols, rows)
	if not U.EnterGui then
		local gui = CloudUI.NewScreenGui("NimbusDungeonEnter", K.ENTER_ORDER)
		gui.IgnoreGuiInset = true
		gui.Enabled = false
		U.EnterGui = gui
		U.EnterGrid = H.frame(gui, "Grid", { Size = UDim2.fromScale(1, 1), ZIndex = 10 })
	end
	if U.EnterCols == cols and U.EnterRows == rows and U.EnterCells then
		return
	end
	H.clear(U.EnterGrid)
	U.EnterCells = {}
	U.EnterCols, U.EnterRows = cols, rows
	local maxD = math.sqrt((cols / 2) ^ 2 + (rows / 2) ^ 2)
	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			local x, y = (c + 0.5) / cols, (r + 0.5) / rows
			local f = Util.Create("Frame", {
				Name = "Cell",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(x, y),
				Size = UDim2.fromScale(0, 0),
				BorderSizePixel = 0,
				BackgroundTransparency = 0,
				ZIndex = 10,
				Parent = U.EnterGrid,
			})
			local stroke = H.stroke(f, ENTER_INK, 1, 0)
			local dx, dy = c + 0.5 - cols / 2, r + 0.5 - rows / 2
			local hash = (c * 7 + r * 13 + c * r * 3) % 17
			U.EnterCells[#U.EnterCells + 1] = {
				F = f, Stroke = stroke, X = x, Y = y, W = 1 / cols, H = 1 / rows,
				Dist = math.sqrt(dx * dx + dy * dy) / maxD,
				Hash = hash,
				Jitter = (hash % 9) / 8 * K.ENTER_JITTER,
				Rot = ((hash % 2 == 0) and 1 or -1) * (8 + hash % 12),
				Shade = (hash % 7) * 0.025 - 0.075,
			}
		end
	end
end

function R.enterColour(element)
	local base = H.elementColor(element) or C.Accent
	for _, cell in ipairs(U.EnterCells or {}) do
		local col = (cell.Shade >= 0) and Theme.Lighten(base, cell.Shade) or base:Lerp(Color3.new(0, 0, 0), -cell.Shade)
		cell.F.BackgroundColor3 = col
		cell.Stroke.Color = col:Lerp(Color3.new(0, 0, 0), 0.25)
	end
end

function R.enterResetCells()
	for _, cell in ipairs(U.EnterCells or {}) do
		cell.F.Size = UDim2.fromScale(0, 0)
		cell.F.Position = UDim2.fromScale(cell.X, cell.Y)
		cell.F.Rotation = 0
		cell.F.BackgroundTransparency = 0
		cell.S, cell.Ty = nil, nil
	end
end

local function backOut(k)
	local c1 = 1.70158
	local c3 = c1 + 1
	local m = k - 1
	return 1 + c3 * m * m * m + c1 * m * m
end

-- DungeonState "Enter": the rush + the blocks; the server teleports the party after Cover
function R.enter(payload)
	if S.Run or H.inMatch() then
		return
	end
	if S.Enter then
		R.enterClear()
	end
	local function secs(v, default)
		v = tonumber(v)
		if not v or v ~= v then
			return default
		end
		return math.max(0.1, math.min(2, v))
	end
	local low = H.lowGfx()
	local cols, rows = R.enterGrid(low)
	R.buildEnter(cols, rows)
	R.enterResetCells()
	R.enterColour(payload.Element)
	local now = os.clock()
	local e = {
		Token = (S.EnterSeq or 0) + 1,
		Phase = "Cover",
		Cover = secs(payload.Cover, 0.55),
		Reveal = secs(payload.Reveal, 0.9),
		At = now,
		HardAt = now + K.ENTER_SAFETY,
		Low = low,
		Lead = 0,
	}
	S.EnterSeq = e.Token
	local camera = Workspace.CurrentCamera
	local gate = R.dungeonGate()
	local core = gate and gate.PrimaryPart
	if camera and core and (camera.CFrame.Position - core.Position).Magnitude > K.ENTER_RUSH_MAX then
		core = nil -- the camera is far from the gate (a member who wandered off): no flight across the plaza
	end
	if camera and core then
		local cp = core.Position
		local lv = core.CFrame.LookVector
		local sign = ((camera.CFrame.Position - cp):Dot(lv) >= 0) and 1 or -1
		local target = cp + lv * sign
		e.Rush = { From = camera.CFrame, To = CFrame.lookAt(target, cp), Fov = camera.FieldOfView }
		e.Phase = "Rush"
		e.Lead = K.ENTER_LEAD
		camera.CameraType = Enum.CameraType.Scriptable
		local pfx = H.controller("PortalFxController")
		if pfx and type(pfx.Flare) == "function" then
			pcall(pfx.Flare, gate, 0.6)
		end
		local sfx = H.clientModule("SoundFx")
		if sfx and type(sfx.Play) == "function" then
			pcall(sfx.Play, "Whoosh")
		end
	end
	S.Enter = e
	U.EnterGui.Enabled = true
	RunService:BindToRenderStep(K.ENTER_BIND, H.renderPriority(3), function(dt)
		H.safe("enter step", R.enterStep, dt)
	end)
end

function R.enterStep(_dt)
	local e = S.Enter
	if not e then
		pcall(function()
			RunService:UnbindFromRenderStep(K.ENTER_BIND)
		end)
		return
	end
	local now = os.clock()
	local t = now - e.At
	if e.Phase == "Rush" or e.Phase == "Cover" then
		if now >= e.HardAt then
			return R.enterClear()
		end
		local camera = Workspace.CurrentCamera
		if e.Rush and camera then
			local p = H.clamp01(t / K.ENTER_RUSH)
			local q = p * p
			camera.CFrame = e.Rush.From:Lerp(e.Rush.To, q)
			H.mcCall("SetFovOverride", e.Rush.Fov + (K.ENTER_RUSH_FOV - e.Rush.Fov) * q)
			if p >= 1 then
				e.Phase = "Cover"
			end
		end
		local span = math.max(0, e.Cover - K.ENTER_MARGIN - e.Lead - K.ENTER_POP) -- full by Cover - ENTER_MARGIN
		for _, cell in ipairs(U.EnterCells) do
			local k = H.clamp01((t - (e.Lead + span * cell.Dist)) / K.ENTER_POP)
			local s = (k >= 1) and 1 or backOut(k)
			if s ~= cell.S then
				cell.S = s
				cell.F.Size = UDim2.new(cell.W * s, 2, cell.H * s, 2)
			end
		end
		if t >= e.Cover then
			R.enterSnapCover()
		end
	elseif e.Phase == "Hold" then
		if e.RunSeen then
			R.enterReveal()
		elseif now >= e.HardAt then
			-- no run came (refused / ended during the cover): reveal anyway
			R.enterReveal()
		end
	elseif e.Phase == "Reveal" then
		local tr = now - e.RevealAt
		local spread = math.max(0, e.Reveal - K.ENTER_HOP - K.ENTER_FALL - K.ENTER_JITTER)
		for _, cell in ipairs(U.EnterCells) do
			local tau = tr - (spread * cell.Dist + cell.Jitter)
			local y, q = 0, 0
			if tau > 0 then
				if tau < K.ENTER_HOP then
					y = -0.06 * math.sin(tau / K.ENTER_HOP * math.pi / 2)
				else
					q = H.clamp01((tau - K.ENTER_HOP) / K.ENTER_FALL)
					y = -0.06 + 1.36 * q * q
				end
			end
			if y ~= cell.Ty then
				cell.Ty = y
				cell.F.Position = UDim2.fromScale(cell.X, cell.Y + y)
				if not e.Low then
					cell.F.Rotation = cell.Rot * q
					cell.F.BackgroundTransparency = 0.35 * q
				end
			end
		end
		if tr >= e.Reveal or now >= e.HardAt then
			R.enterClear()
		end
	end
end

-- every block full; the camera back to normal under them (the teleport is about to happen / happened)
function R.enterSnapCover()
	local e = S.Enter
	if not e or (e.Phase ~= "Rush" and e.Phase ~= "Cover") then
		return
	end
	for _, cell in ipairs(U.EnterCells or {}) do
		cell.S = 1
		cell.F.Size = UDim2.new(cell.W, 2, cell.H, 2)
	end
	R.enterCamera(e)
	e.Phase = "Hold"
	if e.RunSeen then
		R.enterReveal()
	end
end

function R.enterCamera(e)
	if e.Rush and not e.CameraBack then
		e.CameraBack = true
		H.mcCall("SetFovOverride", nil)
		local camera = Workspace.CurrentCamera
		if camera and camera.CameraType == Enum.CameraType.Scriptable then
			camera.CameraType = Enum.CameraType.Custom
		end
	end
end

-- the run's first Run payload (the party stands in the hall): the blocks hop and fall away
function R.enterReveal()
	local e = S.Enter
	if not e or e.Phase == "Reveal" then
		return
	end
	if e.Phase == "Rush" or e.Phase == "Cover" then
		e.RunSeen = true
		return -- (the cover finishes first: the teleport is under it)
	end
	e.Phase = "Reveal"
	e.RevealAt = os.clock()
	e.HardAt = e.RevealAt + e.Reveal + 0.5
end

function R.enterSkip()
	local e = S.Enter
	if not e then
		return
	end
	if e.Phase == "Rush" or e.Phase == "Cover" then
		R.enterSnapCover()
	elseif e.Phase == "Reveal" then
		R.enterClear()
	end
end

-- every exit path (idempotent): nothing bound, the camera and the FOV back, the blocks hidden and reset
function R.enterClear()
	local e = S.Enter
	if not e then
		return
	end
	S.Enter = nil
	pcall(function()
		RunService:UnbindFromRenderStep(K.ENTER_BIND)
	end)
	R.enterCamera(e)
	if U.EnterGui then
		U.EnterGui.Enabled = false
	end
	R.enterResetCells()
end

-- the dungeon shoulder: Humanoid.CameraOffset while in a run (re-applied to a new character), zero outside
function R.shoulder()
	local _, hum = H.character()
	if S.Run and hum then
		if S.ShoulderHum ~= hum then
			S.ShoulderHum = hum
			hum.CameraOffset = K.DUNGEON_SHOULDER
		end
	elseif S.ShoulderHum then
		local old = S.ShoulderHum
		S.ShoulderHum = nil
		if old.Parent then
			old.CameraOffset = Vector3.new(0, 0, 0)
		end
	end
end

----------------------------------------------------------------------
-- Server messages
----------------------------------------------------------------------
function R.onState(kind, payload)
	if type(payload) ~= "table" then
		return
	end
	if kind == "Lobby" then
		S.Lobby = payload
		S.LobbyAt = os.clock()
		S.ReadyWant = nil -- the server's word wins (the optimistic READY is reverted or confirmed here)
		S.PartySig = nil
		if type(payload.Mine) == "table" and tonumber(payload.Mine.Floor) then
			S.Floor = math.floor(payload.Mine.Floor)
		end
		W.refresh()
		R.refresh()
	elseif kind == "Run" then
		local fresh = S.Run == nil or S.Run.RunId ~= payload.RunId
		local key = tostring(payload.State) .. ":" .. tostring(payload.Phase) .. ":" .. tostring(payload.Room)
		local newKey = key ~= S.PhaseKey
		if fresh then
			S.Totals = { Cash = 0, Tokens = 0, Xp = 0, Gems = 0 }
			S.ChestOpened = false
			S.End = nil
			S.LeaveArmed = 0
			S.MemberSig = nil
			R.unwatchDoors()
		end
		if key ~= S.PhaseKey then
			S.PhaseKey = key
			S.PhaseAt = os.clock()
		end
		S.Run = payload
		S.RunAt = os.clock()
		S.CamBoxes = nil
		-- wave 5 (bug #15): the run's first payload lifts the entrance blocks
		if fresh and S.Enter then
			R.enterReveal()
		end
		-- wave 5 (bug #26): the next room arrived under the fade: the walk-in (set up while black); another phase ends it
		local room = tonumber(payload.Room) or 0
		if S.Walk and key ~= S.Walk.Key then
			if payload.State == "Fight" and not fresh then
				R.walkFight()
			else
				R.walkClear()
			end
		end
		local threshold = payload.State == "Corridor" and payload.Phase == "Threshold" and room >= 1 and room <= 4
		if not S.Walk and S.Fade and (S.Fade.Phase == "Out" or S.Fade.Phase == "Hold") and key ~= S.Fade.Key and threshold then
			local okP, prepared, why = pcall(R.walkPrepare, room, key)
			if not okP then
				H.warnOnce("walk prepare", prepared)
			end
			R.walkSkipped(okP and not prepared and (why or "NoRoom") or (not okP and "Error") or nil)
		elseif threshold and newKey and not S.Walk then
			R.walkSkipped(S.Fade and "FadeIn" or "NoFade")
		end
		-- the next room arrived while the screen holds black: fade back in
		if S.Fade and S.Fade.Phase == "Hold" and key ~= S.Fade.Key then
			R.fadeIn()
		end
		if S.Open then
			DungeonController.Close()
		end
		R.light(true)
		R.zoom(true)
		H.safe("doors", R.watchDoors)
		H.safe("chests", R.lockChests)
		H.safe("shoulder", R.shoulder)
		R.refresh()
	elseif kind == "Enter" then
		H.safe("enter", R.enter, payload)
	elseif kind == "Loot" then
		S.Loot = payload
		local t = S.Totals
		t.Cash = t.Cash + (tonumber(payload.Cash) or 0)
		t.Tokens = t.Tokens + (tonumber(payload.Tokens) or 0)
		t.Xp = t.Xp + (tonumber(payload.Xp) or 0)
		local text
		if payload.Loss then
			text = "A third of the XP for trying: +" .. H.commas(payload.Xp) .. " XP"
		else
			local room = tonumber(payload.Room) or 1
			text = ((room >= 4) and "Boss beaten!" or ("Room " .. room .. " cleared!")) .. " +$" .. H.commas(payload.Cash) .. " +" .. H.commas(payload.Tokens) .. " tokens +"
				.. H.commas(payload.Xp) .. " XP"
			if (tonumber(payload.LevelUps) or 0) > 0 then
				local ups = math.floor(payload.LevelUps) -- (playtest 2026-11-28 C45: "3 level ups!", as BattleController says it)
				text = text .. " (" .. (ups == 1 and "1 level up!" or (ups .. " level ups!")) .. ")"
			end
		end
		R.toast(text, payload.Loss and C.Blue or C.Gold, nil, "+$" .. H.commas(payload.Cash) .. " +" .. H.commas(payload.Tokens) .. " tokens +" .. H.commas(payload.Xp) .. "XP",
			payload.Loss and "up" or Config.Icons.Trove) -- (U9-7 look) the room's chest; a lost room's XP
		if not payload.Loss then
			R.sound("Reward")
		end
	elseif kind == "Chest" then
		local amount = tonumber(payload.Amount) or 0
		local kindName = tostring(payload.Kind)
		if kindName == "Gems" then
			S.Totals.Gems = S.Totals.Gems + amount
		elseif kindName == "Tokens" then
			S.Totals.Tokens = S.Totals.Tokens + amount
		elseif kindName == "Cash" then
			S.Totals.Cash = S.Totals.Cash + amount
		end
		S.ChestOpened = true
		H.safe("chests", R.lockChests)
		local label = (kindName == "Cash") and ("$" .. H.commas(amount)) or (H.commas(amount) .. " " .. (kindName == "Gems" and "Gems" or "tokens"))
		local icon = (kindName == "Gems") and "gem" or ((kindName == "Cash") and Config.Icons.Cash or Config.Icons.Tokens)
		R.toast("Chest: +" .. label .. "!", (kindName == "Gems") and C.Gem or C.Gold, nil, "+" .. label, icon)
		R.sound("Reward")
	elseif kind == "Fade" then
		if S.Run then
			R.fade(payload)
		end
	elseif kind == "End" then
		S.EndRooms = S.Run and tonumber(S.Run.RoomCount) or S.EndRooms -- (the End card's "Rooms cleared 2 / 4")
		S.End = (not R.showLoss(payload)) and payload or nil
		S.EndAt = os.clock()
		S.EndCompact = false -- (U9-7 look) a new result shows its reason line again until it must drop it (R.place)
		S.Run = nil
		S.PhaseKey = nil
		S.LeaveArmed = 0
		S.Toast = nil
		H.safe("walk clear", R.walkClear)
		H.safe("enter clear", R.enterClear)
		-- (kit-b S3) a fade on screen lifts over 0.3 s; the light comes back under the black at once, else over Zone.Out
		local black = R.liftFade()
		R.light(false, black and 0 or nil)
		R.zoom(false)
		R.unwatchDoors()
		H.safe("shoulder", R.shoulder)
		R.refresh()
	end
end

-- a run that vanished without an End (InBattle released, the pocket left): clean up and restore the light
function R.check()
	if S.Run and not H.runAttr() and os.clock() - S.RunAt > 3 then
		S.Run = nil
		S.PhaseKey = nil
		H.safe("walk clear", R.walkClear)
		H.safe("enter clear", R.enterClear)
		H.safe("shoulder", R.shoulder)
		R.clearFade()
		R.unwatchDoors()
		R.light(false)
		R.zoom(false)
		R.refresh()
	elseif (S.Lit or S.Zoomed) and not S.Run and not H.runAttr() then
		R.light(false)
		R.zoom(false)
	end
end

----------------------------------------------------------------------
-- Init
----------------------------------------------------------------------
function H.connectOthers()
	local function hook(name, signalName)
		local mod = H.controller(name)
		local signal = mod and mod[signalName]
		if type(signal) == "table" and type(signal.Connect) == "function" then
			signal:Connect(function(windowId)
				if name == "DungeonController" or windowId == "Dungeon" then
					return
				end
				DungeonController.Close()
			end)
		end
	end
	hook("MenuController", "WindowOpened")
	hook("IndexController", "Opened")
	hook("FusionController", "Opened")
	hook("CareController", "Opened")
	hook("ArenaController", "Opened")
	hook("ObbyController", "Opened")
end

function DungeonController.Init()
	if initialized then
		return
	end
	initialized = true
	LocalPlayer = Players.LocalPlayer
	pcall(State.Init)
	U.Gui = CloudUI.NewScreenGui("NimbusDungeon", K.DISPLAY_ORDER)
	R.build()
	R.buildFade()
	R.refresh()
	U.Gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		H.safe("relayout", function()
			S.PartySig = nil
			W.refresh()
			R.refresh()
		end)
	end)
	State.Changed:Connect(function()
		H.safe("State.Changed", W.refresh)
	end)
	if LocalPlayer then
		LocalPlayer:GetAttributeChangedSignal(Config.Attr.InMatch):Connect(function()
			if H.inMatch() then
				DungeonController.Close()
			end
			H.safe("InMatch", R.refresh)
		end)
		LocalPlayer:GetAttributeChangedSignal((Config.Attr and Config.Attr.InBattle) or "InBattle"):Connect(function()
			-- wave 5: out of the run (released): no cinematic may stay on
			if not H.runAttr() then
				H.safe("walk clear", R.walkClear)
				H.safe("enter clear", R.enterClear)
			end
			task.delay(3.2, function()
				H.safe("InBattle", R.check)
			end)
		end)
		LocalPlayer.CharacterRemoving:Connect(function()
			H.safe("walk clear", R.walkClear) -- (death / respawn: the walk-in ends with the character)
		end)
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		H.safe("skip", H.onSkipInput, input, processed)
	end)
	UserInputService.InputBegan:Connect(function(input)
		if S.Open and input.KeyCode == Enum.KeyCode.Escape then
			DungeonController.Close()
		end
	end)
	task.spawn(function()
		local okState, stateRemote = pcall(Remotes.Get, "DungeonState")
		if okState and stateRemote then
			stateRemote.OnClientEvent:Connect(function(kind, payload)
				H.safe("DungeonState " .. tostring(kind), R.onState, kind, payload)
			end)
		end
		local okOpen, openRemote = pcall(Remotes.Get, "OpenPanel")
		if okOpen and openRemote then
			openRemote.OnClientEvent:Connect(function(panelId, args)
				if type(panelId) == "string" and panelId:lower() == "dungeon" then
					args = type(args) == "table" and args or {}
					H.safe("OpenPanel", DungeonController.Open, args.Floor)
				end
			end)
		end
	end)
	task.defer(function()
		H.safe("hooks", H.connectOthers)
	end)
	-- one light loop: countdowns, phase clocks, the toasts, walk-away (4 times a second)
	local nextTick = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now < nextTick then
			return
		end
		nextTick = now + K.TICK
		if S.Open and S.AtPortal then
			local pos, at = H.rootPosition(), H.positionOf(S.AtPortal)
			if pos and at and (Vector3.new(pos.X - at.X, 0, pos.Z - at.Z)).Magnitude > K.WALK_AWAY then
				DungeonController.Close()
				return
			end
		end
		if S.Open then
			H.safe("tick window", W.refresh)
		end
		H.safe("tick fade", R.fadeTick)
		H.safe("tick walk", R.walkTick)
		H.safe("tick shoulder", R.shoulder)
		H.safe("tick card", R.refresh)
		if S.Zoomed and not S.Run then
			H.safe("tick zoom", R.zoom, false) -- every exit path: no run, no zoom cap
		end
	end)
end

-- TESTS ONLY (smoke_bug5_dungeon client_bug5dgn_mood): the tier mood reader, the preset it never goes below, the retry;
-- Build = the run's LightingStack preset (smoke_sky client_dungeon_density_follows)
DungeonController._Mood = { Read = R.mood, Preset = PRESET, Tries = K.MOOD_TRIES, Retry = K.MOOD_RETRY, Build = R.preset }

return DungeonController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1136">
            <Properties>
              <string name="Name">DungeonFx</string>
              <string name="Source"><![CDATA[-- DungeonFx (client, bug #5 "dungeon rooms"): the dungeon's small motion that Beams and emitters cannot do.
--   * the Weatherworks' weather astrolabe (the boss room's chair, style b): three brass gimbal rings round a captured
--     storm cloud turn slowly. Each ring is one anchored Part tagged "NC_DungeonSpin" (DungeonBuilder, attributes
--     SpinSpeed in rad/s and SpinIndex); this client turns it about its own local Y from its rest frame. Once
--     dungeon_b_ring is uploaded the Blender mesh is welded to the ring Part (ML_Weld, unanchored, client-side) and
--     simply rides it. Here on this client only: the server's Parts never move.
-- Cheap: ONE Heartbeat connection, updates at UPDATE_HZ, only rings within RANGE studs of the camera turn, and a ring
-- goes back to rest out of range, on Low graphics or on Stop(). Streaming-safe: rings are found by tag as they arrive
-- and forgotten when they leave. No sound here (the audio branch reads the CollectionService tags).
--
--   DungeonFx.Init()            idempotent (Main.client.lua starts it)
--   DungeonFx.Stop()            disconnects everything, every ring back at rest
--   DungeonFx.Step(dt)          one Heartbeat step (tests drive it)
--   DungeonFx.Angle(t, speed, index) -> number   a ring's turn at time t (pure; tests)
--   DungeonFx.Stats() -> { Rings, Moving, Writes, Time, Quality }
--   DungeonFx.K                 the tuning numbers
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local DungeonFx = {}

local K = {
	SPIN_TAG = "NC_DungeonSpin",
	RANGE = 160, -- studs from the camera: farther rings rest
	UPDATE_HZ = 30,
	REFRESH = 0.5, -- seconds between quality / range passes
	DEFAULT_SPEED = 0.4, -- rad/s when a ring carries no SpinSpeed
}
DungeonFx.K = K

local St = {
	Started = false,
	Rings = {}, -- [part] = { Part, Rest, Speed, Index, Moving }
	Count = 0,
	Conns = {},
	Time = 0,
	Acc = 0,
	RefreshAcc = 0,
	Quality = "High",
	Quality0 = nil,
	Writes = 0,
}
DungeonFx._St = St

local function quality()
	if St.Quality0 == nil then
		St.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				St.Quality0 = mod
			end
		end
	end
	if St.Quality0 then
		local ok, mode = pcall(St.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

-- a ring's turn (radians) at time t: its own speed, each ring started a third of a turn apart
function DungeonFx.Angle(t, speed, index)
	return (t * (speed or K.DEFAULT_SPEED)) + ((index or 1) - 1) * (math.pi * 2 / 3)
end

local function rest(rec)
	if rec.Moving and rec.Part.Parent then
		rec.Part.CFrame = rec.Rest
		St.Writes = St.Writes + 1
	end
	rec.Moving = false
end

local function add(part)
	if not part:IsA("BasePart") or St.Rings[part] then
		return
	end
	St.Rings[part] = {
		Part = part,
		Rest = part.CFrame,
		Speed = tonumber(part:GetAttribute("SpinSpeed")) or K.DEFAULT_SPEED,
		Index = tonumber(part:GetAttribute("SpinIndex")) or 1,
		Moving = false,
	}
	St.Count = St.Count + 1
end

local function remove(part)
	local rec = St.Rings[part]
	if rec then
		St.Rings[part] = nil
		St.Count = St.Count - 1
	end
end

local function cameraPos()
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

function DungeonFx.Step(dt)
	dt = tonumber(dt) or 0
	St.Time = St.Time + dt
	St.RefreshAcc = St.RefreshAcc + dt
	if St.RefreshAcc >= K.REFRESH then
		St.RefreshAcc = 0
		St.Quality = quality()
		local from = cameraPos()
		for part, rec in pairs(St.Rings) do
			if not part.Parent then
				remove(part)
			else
				local near = St.Quality ~= "Low" and from ~= nil and (rec.Rest.Position - from).Magnitude <= K.RANGE
				if near then
					rec.Moving = true
				else
					rest(rec)
				end
			end
		end
	end
	St.Acc = St.Acc + dt
	if St.Acc < 1 / K.UPDATE_HZ then
		return
	end
	St.Acc = 0
	for part, rec in pairs(St.Rings) do
		if rec.Moving and part.Parent then
			part.CFrame = rec.Rest * CFrame.Angles(0, DungeonFx.Angle(St.Time, rec.Speed, rec.Index), 0)
			St.Writes = St.Writes + 1
		end
	end
end

function DungeonFx.Stats()
	local moving = 0
	for _, rec in pairs(St.Rings) do
		if rec.Moving then
			moving = moving + 1
		end
	end
	return { Rings = St.Count, Moving = moving, Writes = St.Writes, Time = St.Time, Quality = St.Quality }
end

function DungeonFx.Init()
	if St.Started then
		return
	end
	St.Started = true
	for _, part in ipairs(CollectionService:GetTagged(K.SPIN_TAG)) do
		add(part)
	end
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceAddedSignal(K.SPIN_TAG):Connect(add)
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceRemovedSignal(K.SPIN_TAG):Connect(function(part)
		local rec = St.Rings[part]
		if rec then
			rest(rec)
		end
		remove(part)
	end)
	St.RefreshAcc = K.REFRESH -- the first step decides range / quality at once
	St.Conns[#St.Conns + 1] = RunService.Heartbeat:Connect(function(dt)
		DungeonFx.Step(dt)
	end)
end

function DungeonFx.Stop()
	for _, c in ipairs(St.Conns) do
		c:Disconnect()
	end
	St.Conns = {}
	for _, rec in pairs(St.Rings) do
		rest(rec)
	end
	St.Rings = {}
	St.Count = 0
	St.Started = false
end

return DungeonFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1137">
            <Properties>
              <string name="Name">EvolutionFx</string>
              <string name="Source"><![CDATA[-- EvolutionFx (client): the evolution animation of a pet, played on this client only (its parts never exist on
-- the server, so nothing replicates). Used by the developer pet showcase (DevPetShow, "/evolve") and by the game's own
-- EVOLVE moment (CareController, Phase 4: two fresh PetBuilder clones in front of the player, with Confetti = true).
--
--   EvolutionFx.Play(fromModel, toModel, pose, opts) -> handle
--       fromModel  the pet as it is now: a PetBuilder model at rest (any stage), placed at `pose`
--       toModel    the evolved pet: a PetBuilder model at rest (parented to opts.Parent when it appears)
--       pose       CFrame of the pets' root (PrimaryPart) at rest: where both hover; LookVector = their facing
--       opts       { Parent = Instance for toModel and the effect parts (default workspace),
--                    Colors = { Color3, Color3 } (glow, sparks: PetBuilder.EvolutionColors),
--                    Stage = 1 | 2 (the stage reached; the second evolution is grander and longer),
--                    Ground = y of the floor under the pets (default: just under fromModel),
--                    Confetti = true (Phase 4, the game's EVOLVE moment: a burst of voxel confetti at the reveal),
--                    OnDone = function(toModel) (called once, after the animation or Stop) }
--       handle     { Done = false/true, Model = the pet on show (fromModel, then toModel), Stop = function() }
--                  Stop() ends it at once: fromModel destroyed, toModel at rest at `pose`, the effects gone.
--   EvolutionFx.Duration(stage) -> seconds the animation lasts
--   EvolutionFx.Count() -> evolutions playing right now
--   EvolutionFx.Arrive(pivot, opts) -> handle   (dungeon fixes, decision 3) an enemy's arrival: EFFECTS ONLY (no model
--       is touched): the evolution's rune ring on the ground, a light pillar, the white flash with a sparkle burst, the
--       shock ring and voxel sparks, about 1.2 s. pivot = CFrame of the arriving pet's centre.
--       opts { Parent (default workspace), Colors = { Color3, Color3 }, Height, Radius (studs of the pet), Ground (y of
--              the floor; default pivot.Y - Height / 2), Seconds (default 1.2), Quality "Low" | "High" (default
--              GraphicsQuality.Effective()), OnFlash = function() (once, at the flash: the caller pops its model in),
--              OnDone = function() (once, at the end or on Stop) }
--       handle { Done, Low, FlashAt (seconds after the start), T, Stop = function() (ends it at once, OnFlash still
--              runs once) }
--       Cheap: the parts live in pooled kits (one kit per arrival, reused; nothing is created after the first wave),
--       one BulkMoveTo per piece list per frame with reused buffers; at most ARRIVE_MAX full kits at once (more
--       arrivals at the same moment get the Low kit). Low = the flash + the shock ring only (13 parts, no light, no
--       particles).
--   EvolutionFx.ArriveStats() -> { Live, LiveLow, Pooled, Parts }   (tests)
--
-- The animation (stage 1 about 4.3 s, stage 2 about 5 s):
--   charge  the pet rises and spins faster and faster while it starts to glow (a Highlight), a ring of voxel runes
--           grows on the ground under it (two counter-rotating rings for the second evolution), glowing motes
--           spiral in and a pillar of light rises
--   burst   the pet shrinks into a white flash and the pillar flares
--   reveal  the evolved pet pops out of the flash (overshoot, then settles), spins down to face forward exactly
--           as it was, sinks back to its hover height; a shock ring races over the ground, voxel sparks burst out
--           and sparkles fly; the glow fades
-- Pets are moved and scaled by placing / resizing their parts from their rest offsets (workspace:BulkMoveTo), so
-- PetBuilder.Animate must not run on them meanwhile; at the end toModel is back at rest, ready for Animate.
-- One RenderStepped connection while anything plays; every effect part is anchored, CanCollide / CanTouch /
-- CanQuery off, CastShadow off. Plain Lua 5.1-compatible syntax only.

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local EvolutionFx = {}

local TAU = math.pi * 2
local FxSprites = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("FxSprites"))
local WHITE = Color3.fromRGB(255, 255, 255)

local K = {
	CHARGE = { 2.0, 2.6 }, -- seconds of charging, per stage reached
	BURST = 0.38,
	REVEAL = 1.35,
	SETTLE = 0.6,
	RISE = 0.28, -- the pet rises this share of its height while charging
	SPIN = 4.5, -- turns per second at the end of the charge
	REVEAL_TURNS = 2, -- turns the evolved pet spins down through
	MIN_SCALE = 0.04,
	RUNES = { 20, 28 }, -- voxel runes in the ground ring
	MOTES = { 18, 28 },
	SPARKS = { 22, 34 },
	PILLAR = { 9, 12 }, -- pillar height in pet heights... capped below
	PILLAR_MAX = 60, -- studs
	CONFETTI = 26, -- voxel confetti bits (opts.Confetti)
	-- an enemy's arrival (EvolutionFx.Arrive): seconds, the flash moment (share of the time), piece counts, caps
	ARRIVE_SECONDS = 1.2,
	ARRIVE_FLASH = 0.35,
	ARRIVE_RUNES = 12,
	ARRIVE_SHOCK = 16,
	ARRIVE_SHOCK_LOW = 12,
	ARRIVE_SPARKS = 10,
	ARRIVE_SPARKLES = 22,
	ARRIVE_MAX = 6, -- full kits at once (a wave of 3-5 + an escort); more arrivals at once get the Low kit
	ARRIVE_MAX_LOW = 16, -- beyond this nothing is drawn (OnFlash runs at once)
	ARRIVE_POOL = 6, -- kits of each kind kept for reuse
	CONFETTI_COLORS = {
		Color3.fromRGB(255, 96, 120),
		Color3.fromRGB(255, 176, 64),
		Color3.fromRGB(255, 226, 90),
		Color3.fromRGB(110, 214, 120),
		Color3.fromRGB(96, 176, 255),
		Color3.fromRGB(186, 128, 255),
	},
}

local plays = {}
local arrivals = {} -- live EvolutionFx.Arrive plays
local kitPool = { High = {}, Low = {} } -- free arrival kits
local loopConn = nil
local onFrame -- (below)
local quality = nil -- client/GraphicsQuality (lazy; false = unavailable)

local function ensureLoop()
	if not loopConn then
		loopConn = RunService.RenderStepped:Connect(function(dt)
			onFrame(dt)
		end)
	end
end

local function maybeStopLoop()
	if #plays == 0 and #arrivals == 0 and loopConn then
		loopConn:Disconnect()
		loopConn = nil
	end
end

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------
local function clamp01(x)
	if x < 0 then
		return 0
	elseif x > 1 then
		return 1
	end
	return x
end

local function smooth(x)
	x = clamp01(x)
	return x * x * (3 - 2 * x)
end

local function easeIn(x)
	x = clamp01(x)
	return x * x * x
end

local function easeOut(x)
	x = clamp01(x)
	local y = 1 - x
	return 1 - y * y * y
end

-- overshoots to about 1.1 and settles at 1
local function easeOutBack(x)
	x = clamp01(x)
	local c1 = 1.70158
	local c3 = c1 + 1
	local y = x - 1
	return 1 + c3 * y * y * y + c1 * y * y
end

local function lighten(c, t)
	return c:Lerp(WHITE, t)
end

-- a small deterministic "random" in [0, 1) per index
local function hash(i, salt)
	local h = math.sin(i * 12.9898 + (salt or 0) * 78.233) * 43758.5453
	return h - math.floor(h)
end

local function effectPart(play, name, shape, color, size)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.Massless = true
	p.Material = Enum.Material.Neon
	p.Color = color
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.Parent = play.Folder
	return p
end

-- The pet's parts, their rest offsets from the root and their sizes.
local function rigOf(model)
	local root = model.PrimaryPart or model:FindFirstChild("Body")
	if not (root and root:IsA("BasePart")) then
		return nil
	end
	local base = root.CFrame
	local rig = { Model = model, Root = root, Parts = {}, Pos = {}, Rot = {}, Size = {}, Scale = 1, Buf = {}, Posed = nil }
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			local rel = base:ToObjectSpace(d.CFrame)
			local n = #rig.Parts + 1
			rig.Parts[n] = d
			rig.Pos[n] = rel.Position
			rig.Rot[n] = rel - rel.Position
			rig.Size[n] = d.Size
		end
	end
	return rig
end

-- Places the pet with its root at cf, scaled by s around the root.
local function poseRig(rig, cf, s)
	if not rig or not rig.Model.Parent then
		return
	end
	local resize = s ~= rig.Scale
	if not resize and rig.Posed == cf then
		return -- already there (the settle phase holds the pose): nothing to move this frame
	end
	local list = rig.Buf -- reused every frame: no table per frame
	for i, part in ipairs(rig.Parts) do
		if resize then
			part.Size = rig.Size[i] * s
		end
		list[i] = cf * CFrame.new(rig.Pos[i] * s) * rig.Rot[i]
	end
	rig.Scale = s
	rig.Posed = cf
	Workspace:BulkMoveTo(rig.Parts, list, Enum.BulkMoveMode.FireCFrameChanged)
end

-- Height, radius (half the larger horizontal size) and the offset from the root down to the pet's lowest point.
local function measure(rig)
	local lo, hi = math.huge, -math.huge
	local rx = 0
	local base = rig.Root.CFrame
	for i, part in ipairs(rig.Parts) do
		if part.Transparency < 1 then
			local p = rig.Pos[i]
			local half = rig.Size[i].Magnitude / 2
			lo = math.min(lo, p.Y - half)
			hi = math.max(hi, p.Y + half)
			rx = math.max(rx, math.abs(p.X) + half, math.abs(p.Z) + half)
		end
	end
	if lo == math.huge then
		return 3, 2, -1.5, base
	end
	return hi - lo, rx, lo, base
end

----------------------------------------------------------------------
-- One play
----------------------------------------------------------------------
local function ringPose(play, i, n, radius, turn, lift)
	local a = i / n * TAU + turn
	local c = play.Pose
	local centre = Vector3.new(c.Position.X, play.Ground + (lift or 0.06), c.Position.Z)
	local pos = centre + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
	return CFrame.new(pos) * CFrame.Angles(0, -a, 0)
end

-- the sparkle burst emitter (Rate 0: Emit(n) only) on an attachment of `part`; also used by the arrival kits
local function newSparkles(part, c1, c2, R, u)
	local att = Instance.new("Attachment")
	att.Name = "EvolveSparkles"
	att.Parent = part
	local em = Instance.new("ParticleEmitter")
	em.Name = "EvolveSparkles"
	FxSprites.Apply(em, "Sparkle")
	em.LightEmission = 1
	em.LightInfluence = 0
	em.Rate = 0
	em.Lifetime = NumberRange.new(0.7, 1.4)
	em.SpreadAngle = Vector2.new(180, 180)
	em.Rotation = NumberRange.new(0, 360)
	em.RotSpeed = NumberRange.new(-180, 180)
	em.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	em.Parent = att
	local function tune(a, b, radius, unit)
		em.Color = ColorSequence.new(lighten(a, 0.3), lighten(b, 0.3))
		em.Speed = NumberRange.new(radius * 2.2, radius * 4.4)
		em.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0),
			NumberSequenceKeypoint.new(0.25, unit * 0.9),
			NumberSequenceKeypoint.new(1, 0),
		})
	end
	tune(c1, c2, R, u)
	return em, tune
end

local function buildEffects(play)
	local stage = play.Stage
	local c1, c2 = play.Colors[1], play.Colors[2]
	local R, H = play.Radius, play.Height
	local u = math.max(0.6, math.min(R, H) * 0.22) -- size unit of the voxel bits
	play.Unit = u
	-- glow on the pet
	local hl = Instance.new("Highlight")
	hl.Name = "EvolveGlow"
	hl.FillColor = lighten(c1, 0.35)
	hl.OutlineColor = lighten(c2, 0.5)
	hl.FillTransparency = 1
	hl.OutlineTransparency = 1
	hl.Adornee = play.From.Model
	hl.Parent = play.Folder
	play.Glow = hl
	-- the rune ring(s) on the ground
	play.Runes = {}
	local rings = (stage == 2) and 2 or 1
	for r = 1, rings do
		local n = K.RUNES[stage] - (r - 1) * 8
		for i = 1, n do
			local col = ((i + r) % 2 == 0) and c1 or c2
			local part = effectPart(play, "EvolveRune", nil, col, Vector3.new(u * 0.55, u * 0.14, u * ((i % 3 == 0) and 1.5 or 0.9)))
			part.Transparency = 1
			play.Runes[#play.Runes + 1] = { Part = part, I = i, N = n, Ring = r }
		end
	end
	-- motes that spiral in
	play.Motes = {}
	for i = 1, K.MOTES[stage] do
		local part = effectPart(play, "EvolveMote", nil, (i % 2 == 0) and c1 or c2, Vector3.new(u * 0.4, u * 0.4, u * 0.4))
		part.Transparency = 1
		play.Motes[i] = { Part = part, A = hash(i, 1) * TAU, Y = 0.15 + hash(i, 2) * 1.05, Delay = hash(i, 3) * 0.35 }
	end
	-- the pillar of light (a cylinder's axis is its X axis: turned upright)
	local pillar = effectPart(play, "EvolvePillar", Enum.PartType.Cylinder, lighten(c1, 0.45), Vector3.new(0.1, R * 1.4, R * 1.4))
	pillar.Transparency = 1
	play.Pillar = pillar
	play.PillarHeight = math.min(K.PILLAR_MAX, H * K.PILLAR[stage])
	local light = Instance.new("PointLight")
	light.Name = "EvolveLight"
	light.Color = lighten(c1, 0.3)
	light.Range = math.min(40, R * 4 + 8)
	light.Brightness = 0
	light.Parent = pillar
	play.Light = light
	-- the flash
	local flash = effectPart(play, "EvolveFlash", Enum.PartType.Ball, WHITE, Vector3.new(0.2, 0.2, 0.2))
	flash.Transparency = 1
	play.Flash = flash
	-- sparkles (emitted in bursts)
	play.Emitter = newSparkles(flash, c1, c2, R, u)
	-- shock ring + sparks (shown at the reveal)
	play.Shock = {}
	for i = 1, 28 do
		local part = effectPart(play, "EvolveShock", nil, (i % 2 == 0) and lighten(c2, 0.2) or WHITE, Vector3.new(u * 0.5, u * 0.18, u * 1.4))
		part.Transparency = 1
		play.Shock[i] = part
	end
	play.Sparks = {}
	for i = 1, K.SPARKS[stage] do
		local part = effectPart(play, "EvolveSpark", nil, (i % 3 == 0) and WHITE or ((i % 2 == 0) and c1 or c2), Vector3.new(u * 0.45, u * 0.45, u * 0.45))
		part.Transparency = 1
		local a = hash(i, 5) * TAU
		local speed = R * (2.4 + hash(i, 6) * 2.2)
		play.Sparks[i] = {
			Part = part,
			V = Vector3.new(math.cos(a) * speed, R * (2.2 + hash(i, 7) * 2.6), math.sin(a) * speed),
			Spin = Vector3.new(hash(i, 8) * 9, hash(i, 9) * 9, hash(i, 10) * 9),
		}
	end
	-- confetti (Phase 4's EVOLVE moment): flat voxel bits that pop up from the pet and flutter down
	play.Confetti = {}
	if play.ConfettiOn then
		for i = 1, K.CONFETTI do
			local col = K.CONFETTI_COLORS[(i - 1) % #K.CONFETTI_COLORS + 1]
			local part = effectPart(play, "EvolveConfetti", nil, col, Vector3.new(u * 0.5, u * 0.08, u * 0.32))
			part.Material = Enum.Material.SmoothPlastic
			part.Transparency = 1
			local a = hash(i, 13) * TAU
			local speed = R * (0.8 + hash(i, 14) * 1.6)
			play.Confetti[i] = {
				Part = part,
				V = Vector3.new(math.cos(a) * speed, R * (3 + hash(i, 15) * 2.4), math.sin(a) * speed),
				Spin = Vector3.new(4 + hash(i, 16) * 8, hash(i, 17) * 6, 3 + hash(i, 18) * 8),
				Phase = hash(i, 19) * TAU,
			}
		end
	end
end

local function cleanup(play)
	if play.Folder then
		pcall(function()
			play.Folder:Destroy()
		end)
		play.Folder = nil
	end
end

local function finish(play)
	if play.Handle.Done then
		return
	end
	play.Handle.Done = true
	-- fromModel goes, toModel rests exactly at the pose (scale 1)
	if play.From and play.From.Model then
		pcall(function()
			play.From.Model:Destroy()
		end)
	end
	if play.To and play.To.Model then
		if not play.To.Model.Parent then
			play.To.Model.Parent = play.Parent
		end
		poseRig(play.To, play.Pose, 1)
	end
	play.Handle.Model = play.To and play.To.Model or nil
	cleanup(play)
	for i = #plays, 1, -1 do
		if plays[i] == play then
			table.remove(plays, i)
		end
	end
	maybeStopLoop()
	if type(play.OnDone) == "function" and play.To then
		local ok, err = pcall(play.OnDone, play.To.Model)
		if not ok then
			warn("[EvolutionFx] OnDone failed: " .. tostring(err))
		end
	end
end

local function step(play, dt)
	play.T = play.T + dt
	local t = play.T
	local c, b, r, s = play.Charge, K.BURST, K.REVEAL, K.SETTLE
	local pose, H, R, u = play.Pose, play.Height, play.Radius, play.Unit
	local rise = H * K.RISE
	local runeTurn = t * 0.9
	-- the rune rings: grow while charging, stay through the reveal, fade while settling
	local ringP = smooth(t / (c * 0.6))
	local ringFade = clamp01((t - (c + b + r)) / s)
	local runeList, cfs = {}, {}
	for _, rune in ipairs(play.Runes) do
		local radius = R * (0.45 + 0.75 * ringP) * ((rune.Ring == 2) and 0.68 or 1)
		local turn = (rune.Ring == 2) and -runeTurn * 1.4 or runeTurn
		runeList[#runeList + 1] = rune.Part
		cfs[#cfs + 1] = ringPose(play, rune.I, rune.N, radius, turn, (rune.Ring == 2) and 0.1 or 0.06)
		rune.Part.Transparency = 1 - ringP * 0.9 * (1 - ringFade)
	end
	if #runeList > 0 then
		Workspace:BulkMoveTo(runeList, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end
	local centre = pose.Position + Vector3.new(0, rise * smooth(t / c), 0)
	if t < c then
		-- charge: rise, spin up, shake a little, glow; motes spiral in; the pillar rises
		local p = t / c
		play.Yaw = play.Yaw + dt * TAU * K.SPIN * p * p
		local shake = H * 0.015 * p * p
		local jx = (hash(math.floor(t * 30), 11) - 0.5) * shake
		local jz = (hash(math.floor(t * 30), 12) - 0.5) * shake
		poseRig(play.From, pose * CFrame.new(jx, rise * smooth(p), jz) * CFrame.Angles(0, play.Yaw, 0), 1)
		play.Glow.FillTransparency = 1 - 0.78 * smooth(p)
		play.Glow.OutlineTransparency = 1 - smooth(p * 1.4)
		local moteList, moteCfs = {}, {}
		for i, m in ipairs(play.Motes) do
			local q = clamp01((p - m.Delay) / (1 - m.Delay))
			local radius = R * 1.9 * (1 - easeIn(q)) + R * 0.1
			local a = m.A + q * TAU * 1.6
			local y = pose.Position.Y - H * 0.4 + H * m.Y * (1 - q * 0.5) + rise * smooth(p)
			moteList[i] = m.Part
			moteCfs[i] = CFrame.new(centre.X + math.cos(a) * radius, y, centre.Z + math.sin(a) * radius) * CFrame.Angles(t * 3 + i, t * 2, 0)
			m.Part.Transparency = (q > 0 and q < 0.98) and 0.05 or 1
		end
		Workspace:BulkMoveTo(moteList, moteCfs, Enum.BulkMoveMode.FireCFrameChanged)
		local ph = play.PillarHeight * smooth(p * 1.3)
		local w = R * (0.9 + 0.3 * p)
		play.Pillar.Size = Vector3.new(math.max(0.1, ph), w, w)
		play.Pillar.CFrame = CFrame.new(centre.X, play.Ground + ph / 2, centre.Z) * CFrame.Angles(0, 0, math.pi / 2)
		play.Pillar.Transparency = 1 - 0.38 * smooth(p * 1.5)
		play.Light.Brightness = 3 * p
	elseif t < c + b then
		-- burst: the pet shrinks into a white flash; the pillar flares
		if not play.BurstStarted then
			play.BurstStarted = true
			for _, m in ipairs(play.Motes) do
				m.Part.Transparency = 1
			end
		end
		local p = (t - c) / b
		play.Yaw = play.Yaw + dt * TAU * K.SPIN
		poseRig(play.From, pose * CFrame.new(0, rise, 0) * CFrame.Angles(0, play.Yaw, 0), math.max(K.MIN_SCALE, 1 - easeIn(p)))
		local fs = (R * 0.4 + R * 1.3 * easeOut(p)) * 2
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.CFrame = CFrame.new(centre)
		play.Flash.Transparency = 0.2 + 0.2 * p
		local w = R * (1.2 + 1.2 * easeOut(p))
		play.Pillar.Size = Vector3.new(play.PillarHeight, w, w)
		play.Pillar.Transparency = 0.55 + 0.45 * p
		play.Light.Brightness = 3 + 3 * p
	elseif t < c + b + r then
		-- reveal: swap the pets once, then the evolved pet pops out, spins down to face forward and sinks back
		if not play.Swapped then
			play.Swapped = true
			pcall(function()
				play.From.Model.Parent = nil
			end)
			play.To.Model.Parent = play.Parent
			play.Glow.Adornee = play.To.Model
			play.Glow.FillColor = WHITE
			play.Glow.FillTransparency = 0
			play.Glow.OutlineTransparency = 0
			play.Handle.Model = play.To.Model
			play.Pillar.Transparency = 1
			play.Emitter:Emit(play.Stage == 2 and 70 or 45)
			play.SparkT0 = t
		end
		local p = (t - c - b) / r
		local yaw = TAU * K.REVEAL_TURNS * easeOut(p)
		local scale = K.MIN_SCALE + (1 - K.MIN_SCALE) * easeOutBack(math.min(1, p * 1.25))
		poseRig(play.To, pose * CFrame.new(0, rise * (1 - smooth(p)), 0) * CFrame.Angles(0, yaw, 0), math.max(K.MIN_SCALE, scale))
		play.Glow.FillTransparency = smooth(p)
		play.Glow.OutlineTransparency = smooth(p * 0.8)
		local fs = R * 1.7 * 2 * (1 + 0.35 * p)
		play.Flash.Size = Vector3.new(fs, fs, fs)
		play.Flash.Transparency = 0.4 + 0.6 * smooth(p * 3)
		play.Light.Brightness = 6 * (1 - p)
	else
		-- settle: hold the pose while the effects fade, then finish
		poseRig(play.To, pose, 1)
		play.Glow.FillTransparency = 1
		play.Glow.OutlineTransparency = 1
		play.Flash.Transparency = 1
		play.Light.Brightness = 0
		if t >= c + b + r + s then
			finish(play)
			return
		end
	end
	-- the shock ring and the sparks (from the swap on)
	if play.SparkT0 then
		local q = t - play.SparkT0
		local shockP = clamp01(q / 0.85)
		local list, list2 = {}, {}
		for i, part in ipairs(play.Shock) do
			list[i] = part
			list2[i] = ringPose(play, i, #play.Shock, R * (0.8 + 2.4 * easeOut(shockP)), 0, 0.12)
			part.Transparency = (shockP < 1) and (0.1 + 0.9 * shockP) or 1
		end
		Workspace:BulkMoveTo(list, list2, Enum.BulkMoveMode.FireCFrameChanged)
		local sl, sc = {}, {}
		local base = pose.Position + Vector3.new(0, rise * 0.5, 0)
		for i, sp in ipairs(play.Sparks) do
			local pos = base + sp.V * q + Vector3.new(0, -0.5 * 26 * q * q, 0)
			if pos.Y < play.Ground + u * 0.2 then
				pos = Vector3.new(pos.X, play.Ground + u * 0.2, pos.Z)
			end
			sl[i] = sp.Part
			sc[i] = CFrame.new(pos) * CFrame.Angles(sp.Spin.X * q, sp.Spin.Y * q, sp.Spin.Z * q)
			sp.Part.Transparency = clamp01(q / 1.2)
		end
		Workspace:BulkMoveTo(sl, sc, Enum.BulkMoveMode.FireCFrameChanged)
		if #play.Confetti > 0 then
			-- up fast, then a slow flutter down (drag), fading out near the end of the settle
			local cl, cc = {}, {}
			local top = pose.Position + Vector3.new(0, H * 0.6, 0)
			local fade = clamp01((q - 1.3) / 0.6)
			for i, cf in ipairs(play.Confetti) do
				local k = 1 - math.exp(-2.2 * q)
				local drift = cf.V * (k / 2.2)
				local fall = 2.4 * math.max(0, q - 0.35) ^ 1.5
				local sway = math.sin(q * 6 + cf.Phase) * u * 0.6
				local pos = top + Vector3.new(drift.X + sway, drift.Y - fall * R, drift.Z)
				if pos.Y < play.Ground + u * 0.1 then
					pos = Vector3.new(pos.X, play.Ground + u * 0.1, pos.Z)
				end
				cl[i] = cf.Part
				cc[i] = CFrame.new(pos) * CFrame.Angles(cf.Spin.X * q, cf.Spin.Y * q, cf.Spin.Z * q)
				cf.Part.Transparency = fade
			end
			Workspace:BulkMoveTo(cl, cc, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	play.Handle.T = t
end

----------------------------------------------------------------------
-- An enemy's arrival (EvolutionFx.Arrive): pooled kits of effect parts, effects only
----------------------------------------------------------------------
local function kitPart(folder, name, shape)
	local p = effectPart({ Folder = folder }, name, shape, WHITE, Vector3.new(0.2, 0.2, 0.2))
	p.Transparency = 1
	return p
end

local function kitCount(kit)
	local n = #kit.Shock + #kit.Runes + #kit.Sparks + 1
	if kit.Pillar then
		n = n + 1
	end
	return n
end

-- one kit: Low = the flash + the shock ring; High adds the rune ring, the pillar (+ light), the sparkles, the sparks
local function newKit(low)
	local folder = Instance.new("Folder")
	folder.Name = "ArriveFx"
	local kit = { Low = low, Folder = folder, Runes = {}, Shock = {}, Sparks = {}, SparkV = {}, SparkSpin = {}, BufP = {}, BufC = {} }
	kit.Flash = kitPart(folder, "ArriveFlash", Enum.PartType.Ball)
	for i = 1, low and K.ARRIVE_SHOCK_LOW or K.ARRIVE_SHOCK do
		kit.Shock[i] = kitPart(folder, "ArriveShock")
	end
	if not low then
		for i = 1, K.ARRIVE_RUNES do
			kit.Runes[i] = kitPart(folder, "ArriveRune")
		end
		kit.Pillar = kitPart(folder, "ArrivePillar", Enum.PartType.Cylinder)
		local light = Instance.new("PointLight")
		light.Name = "ArriveLight"
		light.Brightness = 0
		light.Parent = kit.Pillar
		kit.Light = light
		kit.Emitter, kit.Tune = newSparkles(kit.Flash, WHITE, WHITE, 2, 0.6)
		for i = 1, K.ARRIVE_SPARKS do
			kit.Sparks[i] = kitPart(folder, "ArriveSpark")
		end
	end
	return kit
end

-- the kit's parts sized and coloured for this arrival (once per play, never per frame)
local function dressKit(kit, play)
	local c1, c2, R, u = play.Colors[1], play.Colors[2], play.Radius, play.Unit
	kit.Flash.Size = Vector3.new(0.2, 0.2, 0.2)
	kit.Flash.Color = WHITE
	for i, part in ipairs(kit.Shock) do
		part.Size = Vector3.new(u * 0.5, u * 0.18, u * 1.3)
		part.Color = (i % 2 == 0) and lighten(c2, 0.2) or WHITE
	end
	for i, part in ipairs(kit.Runes) do
		part.Size = Vector3.new(u * 0.55, u * 0.14, u * ((i % 3 == 0) and 1.5 or 0.9))
		part.Color = (i % 2 == 0) and c1 or c2
	end
	if kit.Pillar then
		kit.Pillar.Color = lighten(c1, 0.45)
		kit.Light.Color = lighten(c1, 0.3)
		kit.Light.Range = math.min(32, R * 4 + 8)
		kit.Light.Brightness = 0
		kit.Tune(c1, c2, R, u)
	end
	for i, part in ipairs(kit.Sparks) do
		part.Size = Vector3.new(u * 0.45, u * 0.45, u * 0.45)
		part.Color = (i % 3 == 0) and WHITE or ((i % 2 == 0) and c1 or c2)
		local a = hash(i, 5) * TAU + play.Salt
		local speed = R * (2.0 + hash(i, 6) * 1.8)
		kit.SparkV[i] = Vector3.new(math.cos(a) * speed, R * (2 + hash(i, 7) * 2.2), math.sin(a) * speed)
		kit.SparkSpin[i] = Vector3.new(hash(i, 8) * 9, hash(i, 9) * 9, hash(i, 10) * 9)
	end
end

local function hideKit(kit)
	kit.Flash.Transparency = 1
	for _, list in ipairs({ kit.Shock, kit.Runes, kit.Sparks }) do
		for _, part in ipairs(list) do
			part.Transparency = 1
		end
	end
	if kit.Pillar then
		kit.Pillar.Transparency = 1
		kit.Light.Brightness = 0
	end
end

local function takeKit(low, parent)
	local pool = kitPool[low and "Low" or "High"]
	while #pool > 0 do
		local kit = table.remove(pool)
		if pcall(function()
			kit.Folder.Parent = parent
		end) then
			return kit
		end
	end
	local kit = newKit(low)
	kit.Folder.Parent = parent
	return kit
end

local function giveKit(kit)
	hideKit(kit)
	local pool = kitPool[kit.Low and "Low" or "High"]
	if #pool < K.ARRIVE_POOL then
		pcall(function()
			kit.Folder.Parent = nil
		end)
		pool[#pool + 1] = kit
	else
		pcall(function()
			kit.Folder:Destroy()
		end)
	end
end

local function arriveFlash(play)
	if play.Flashed then
		return
	end
	play.Flashed = true
	play.Handle.Flashed = true
	if play.Kit and play.Kit.Emitter then
		play.Kit.Emitter:Emit(K.ARRIVE_SPARKLES)
	end
	if type(play.OnFlash) == "function" then
		local ok, err = pcall(play.OnFlash)
		if not ok then
			warn("[EvolutionFx] OnFlash failed: " .. tostring(err))
		end
	end
end

local function arriveFinish(play)
	if play.Handle.Done then
		return
	end
	arriveFlash(play) -- (a Stop before the flash still shows the pet)
	play.Handle.Done = true
	if play.Kit then
		giveKit(play.Kit)
		play.Kit = nil
	end
	for i = #arrivals, 1, -1 do
		if arrivals[i] == play then
			table.remove(arrivals, i)
		end
	end
	maybeStopLoop()
	if type(play.OnDone) == "function" then
		local ok, err = pcall(play.OnDone)
		if not ok then
			warn("[EvolutionFx] OnDone failed: " .. tostring(err))
		end
	end
end

-- per frame: one arrival (reused buffers: no table per frame)
local function arriveStep(play, dt)
	play.T = play.T + dt
	local t, D, F = play.T, play.Dur, play.FlashAt
	local kit = play.Kit
	local R, u = play.Radius, play.Unit
	local centre = play.Pose.Position
	local bp, bc = kit.BufP, kit.BufC
	if t >= F then
		arriveFlash(play)
	end
	-- the rune ring: grows and turns, fades out at the end
	local n = #kit.Runes
	if n > 0 then
		local grow = smooth(t / (0.3 * D))
		local fade = clamp01((t - 0.65 * D) / (0.35 * D))
		local alpha = 1 - (1 - fade) * 0.9 * smooth(t / (0.25 * D))
		for i, part in ipairs(kit.Runes) do
			bp[i] = part
			bc[i] = ringPose(play, i, n, R * (0.5 + 0.8 * grow), t * 1.6, 0.06)
			part.Transparency = alpha
		end
		for i = n + 1, #bp do
			bp[i], bc[i] = nil, nil
		end
		Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
	end
	-- the pillar rises until the flash, flares, then fades
	local pillar = kit.Pillar
	if pillar then
		local rise = easeOut(clamp01((t - 0.04 * D) / (F - 0.04 * D)))
		local after = clamp01((t - F) / (0.3 * D))
		local h = math.max(0.1, play.PillarHeight * rise)
		local w = R * (0.9 + 0.6 * after)
		pillar.Size = Vector3.new(h, w, w)
		pillar.CFrame = CFrame.new(centre.X, play.Ground + h / 2, centre.Z) * CFrame.Angles(0, 0, math.pi / 2)
		pillar.Transparency = (t < F) and (1 - 0.45 * rise) or (0.55 + 0.45 * after)
		kit.Light.Brightness = (t < F) and (4 * rise) or (4 * (1 - after))
	end
	-- the white flash
	local fp = (t - (F - 0.06 * D)) / (0.32 * D)
	if fp > 0 and fp < 1 then
		local fs = (R * 0.5 + R * 2.1 * easeOut(fp)) * 2
		kit.Flash.Size = Vector3.new(fs, fs, fs)
		kit.Flash.CFrame = CFrame.new(centre)
		kit.Flash.Transparency = 0.12 + 0.88 * smooth(fp)
	else
		kit.Flash.Transparency = 1
	end
	-- the shock ring and the sparks (from the flash on)
	if t >= F then
		local q = t - F
		local sp = clamp01(q / (0.45 * D))
		local m = #kit.Shock
		for i, part in ipairs(kit.Shock) do
			bp[i] = part
			bc[i] = ringPose(play, i, m, R * (0.6 + 2.6 * easeOut(sp)), 0, 0.12)
			part.Transparency = (sp < 1) and (0.1 + 0.9 * sp) or 1
		end
		for i = m + 1, #bp do
			bp[i], bc[i] = nil, nil
		end
		Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
		local k = #kit.Sparks
		if k > 0 then
			local fade = clamp01(q / (D - F))
			for i, part in ipairs(kit.Sparks) do
				local pos = centre + kit.SparkV[i] * q + Vector3.new(0, -13 * q * q, 0)
				if pos.Y < play.Ground + u * 0.2 then
					pos = Vector3.new(pos.X, play.Ground + u * 0.2, pos.Z)
				end
				local spin = kit.SparkSpin[i]
				bp[i] = part
				bc[i] = CFrame.new(pos) * CFrame.Angles(spin.X * q, spin.Y * q, spin.Z * q)
				part.Transparency = fade
			end
			for i = k + 1, #bp do
				bp[i], bc[i] = nil, nil
			end
			Workspace:BulkMoveTo(bp, bc, Enum.BulkMoveMode.FireCFrameChanged)
		end
	end
	play.Handle.T = t
	if t >= D then
		arriveFinish(play)
	end
end

local function wantLow(opts)
	if opts.Quality == "Low" or opts.Quality == "High" then
		return opts.Quality == "Low"
	end
	if quality == nil then
		quality = false
		local client = script.Parent and script.Parent.Parent
		local mod = client and client:FindFirstChild("GraphicsQuality")
		if mod then
			local ok, result = pcall(require, mod)
			if ok and type(result) == "table" and type(result.Effective) == "function" then
				quality = result
			end
		end
	end
	if quality then
		local ok, mode = pcall(quality.Effective)
		return ok and mode == "Low"
	end
	return false
end

function EvolutionFx.Arrive(pivot, opts)
	opts = type(opts) == "table" and opts or {}
	local D = (type(opts.Seconds) == "number" and opts.Seconds > 0.2) and math.min(opts.Seconds, 4) or K.ARRIVE_SECONDS
	local handle = { Done = false, Flashed = false, Low = false, FlashAt = D * K.ARRIVE_FLASH, T = 0 }
	local play = { Handle = handle, OnFlash = opts.OnFlash, OnDone = opts.OnDone }
	handle.Stop = function()
		pcall(arriveFinish, play)
	end
	if typeof(pivot) ~= "CFrame" then
		handle.Stop()
		return handle
	end
	local high, low = 0, 0
	for _, a in ipairs(arrivals) do
		if a.Low then
			low = low + 1
		else
			high = high + 1
		end
	end
	local isLow = wantLow(opts) or high >= K.ARRIVE_MAX
	if isLow and low >= K.ARRIVE_MAX_LOW then
		handle.Stop() -- too many at once: no effect, the pet just appears
		return handle
	end
	local colors = type(opts.Colors) == "table" and opts.Colors or {}
	local H = (type(opts.Height) == "number" and opts.Height > 0) and opts.Height or 3.5
	local R = (type(opts.Radius) == "number" and opts.Radius > 0) and opts.Radius or 1.8
	play.Low = isLow
	play.Pose = pivot
	play.Dur = D
	play.FlashAt = handle.FlashAt
	play.Height = math.max(1, H)
	play.Radius = math.max(0.8, R)
	play.Unit = math.max(0.5, math.min(play.Radius, play.Height) * 0.22)
	play.Ground = (type(opts.Ground) == "number") and opts.Ground or (pivot.Position.Y - play.Height / 2)
	play.PillarHeight = math.min(28, play.Height * 6)
	play.Colors = {
		typeof(colors[1]) == "Color3" and colors[1] or Color3.fromRGB(255, 214, 90),
		typeof(colors[2]) == "Color3" and colors[2] or Color3.fromRGB(120, 200, 255),
	}
	play.Salt = (#arrivals + 1) * 0.37 + (pivot.Position.X + pivot.Position.Z) * 0.01
	play.T = 0
	handle.Low = isLow
	local parent = (typeof(opts.Parent) == "Instance") and opts.Parent or Workspace
	play.Kit = takeKit(isLow, parent)
	dressKit(play.Kit, play)
	arrivals[#arrivals + 1] = play
	ensureLoop()
	return handle
end

function EvolutionFx.ArriveStats()
	local out = { Live = 0, LiveLow = 0, Pooled = #kitPool.High + #kitPool.Low, Parts = 0 }
	for _, a in ipairs(arrivals) do
		if a.Low then
			out.LiveLow = out.LiveLow + 1
		else
			out.Live = out.Live + 1
		end
		if a.Kit then
			out.Parts = out.Parts + kitCount(a.Kit)
		end
	end
	return out
end

onFrame = function(dt)
	dt = math.min(dt, 0.1)
	for i = #plays, 1, -1 do
		local play = plays[i]
		if play then
			local ok, err = pcall(step, play, dt)
			if not ok then
				warn("[EvolutionFx] " .. tostring(err))
				pcall(finish, play)
			end
		end
	end
	for i = #arrivals, 1, -1 do
		local play = arrivals[i]
		if play then
			local ok, err = pcall(arriveStep, play, dt)
			if not ok then
				warn("[EvolutionFx] arrive: " .. tostring(err))
				pcall(arriveFinish, play)
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------
function EvolutionFx.Duration(stage)
	return K.CHARGE[(stage == 2) and 2 or 1] + K.BURST + K.REVEAL + K.SETTLE
end

function EvolutionFx.Count()
	return #plays
end

function EvolutionFx.Play(fromModel, toModel, pose, opts)
	opts = type(opts) == "table" and opts or {}
	local handle = { Done = false, Model = fromModel, T = 0 }
	local from = (typeof(fromModel) == "Instance") and rigOf(fromModel) or nil
	local to = (typeof(toModel) == "Instance") and rigOf(toModel) or nil
	if not (from and to) or typeof(pose) ~= "CFrame" then
		warn("[EvolutionFx] Play needs two PetBuilder models and a CFrame")
		handle.Done = true
		handle.Stop = function() end
		return handle
	end
	local stage = (opts.Stage == 2) and 2 or 1
	local colors = type(opts.Colors) == "table" and opts.Colors or {}
	local parent = (typeof(opts.Parent) == "Instance") and opts.Parent or Workspace
	local height, radius, low = measure(to)
	local play = {
		Handle = handle,
		From = from,
		To = to,
		Pose = pose,
		Stage = stage,
		Colors = {
			typeof(colors[1]) == "Color3" and colors[1] or Color3.fromRGB(255, 214, 90),
			typeof(colors[2]) == "Color3" and colors[2] or Color3.fromRGB(120, 200, 255),
		},
		Parent = parent,
		Charge = K.CHARGE[stage],
		Height = math.max(1, height),
		Radius = math.max(0.8, radius),
		Ground = (type(opts.Ground) == "number") and opts.Ground or (pose.Position.Y + low - 0.5),
		OnDone = opts.OnDone,
		ConfettiOn = opts.Confetti == true,
		T = 0,
		Yaw = 0,
	}
	local folder = Instance.new("Folder")
	folder.Name = "EvolutionFx"
	folder.Parent = parent
	play.Folder = folder
	toModel.Parent = nil
	poseRig(from, pose, 1)
	buildEffects(play)
	handle.Stop = function()
		pcall(finish, play)
	end
	plays[#plays + 1] = play
	ensureLoop()
	return handle
end

return EvolutionFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1138">
            <Properties>
              <string name="Name">FountainFx</string>
              <string name="Source"><![CDATA[-- FountainFx (client, bug #13 "Sky-Oasis Steps"): the lobby fountain's small life that Beams and emitters cannot do.
-- The water itself animates on its own (LobbyBuilder buildFountain: Beams with TextureSpeed for the falls, emitters for
-- the splashes, ripple rings, mist and the spring's bubbles). This controller only:
--   * floats the paper boat: a slow drift round its rest point, a bob on the water, a little yaw and roll. The boat is
--     one anchored root Part tagged "OasisBoat" with its anchored parts under it (the sail: every lobby part stays
--     Anchored, so nothing can fall or be pushed). Each tick writes the root and every anchored BasePart under it at
--     its stored rest offset (two CFrame writes for the Part boat); once prop_oasis_boat is uploaded the Blender mesh
--     is welded to the root (ML_Weld, unanchored, client-side) and simply rides it. Here on this client only;
--   * plays the fountain's water loop (SoundFx.Positional "Fountain") when Config.Audio.Ambient.Fountain holds an id
--     (key FountainLoop: none approved yet = silent, today).
-- Cheap: ONE Heartbeat connection, updates at UPDATE_HZ, only boats within RANGE studs of the camera move, and a boat
-- returns to its rest CFrame when it goes out of range, on Low graphics or on Stop(). Streaming-safe: boats are found by
-- tag as they arrive and forgotten when they leave.
--
--   FountainFx.Init()            idempotent (Main.client.lua starts it)
--   FountainFx.Stop()            disconnects everything, every boat back at rest
--   FountainFx.Step(dt)          one Heartbeat step (tests drive it)
--   FountainFx.Offset(t, phase) -> CFrame   the boat's offset from rest at time t (pure; tests)
--   FountainFx.Stats() -> { Boats, Moving, Writes, Time, Quality, Sound }
--   FountainFx.K                 the tuning numbers
-- Plain Lua 5.1-compatible syntax only.

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local FountainFx = {}

local K = {
	BOAT_TAG = "OasisBoat",
	FALLS_TAG = "OasisFalls",
	RANGE = 140, -- studs from the camera: farther boats rest
	UPDATE_HZ = 30,
	REFRESH = 0.5, -- seconds between quality / range passes
	DRIFT = 0.45, -- studs: the radius of the slow circle the boat drifts on
	DRIFT_PERIOD = 18, -- seconds per circle
	BOB = 0.06, -- studs up / down
	BOB_PERIOD = 2.4,
	YAW = 0.14, -- radians of slow swing
	ROLL = 0.05, -- radians of rocking
	-- (the loop's volume is Config.Audio.Volume.FountainLoop x the Sfx setting)
	SOUND_RANGE = 70,
}
FountainFx.K = K

local TWO_PI = math.pi * 2

local St = {
	Started = false,
	Boats = {}, -- [part] = { Part, Rest, Phase, Moving }
	Count = 0,
	Conns = {},
	Time = 0,
	Acc = 0,
	RefreshAcc = 0,
	Quality = "High",
	Quality0 = nil,
	Writes = 0,
	Sound = nil,
}
FountainFx._St = St

local function quality()
	if St.Quality0 == nil then
		St.Quality0 = false
		local client = script.Parent and script.Parent.Parent
		local module = client and client:FindFirstChild("GraphicsQuality")
		if module then
			local ok, mod = pcall(require, module)
			if ok and type(mod) == "table" and type(mod.Effective) == "function" then
				St.Quality0 = mod
			end
		end
	end
	if St.Quality0 then
		local ok, mode = pcall(St.Quality0.Effective)
		if ok and (mode == "Low" or mode == "High") then
			return mode
		end
	end
	return "High"
end

-- The boat's offset from its rest frame at time t (a slow circle, a bob, a swing and a rock; `phase` 0..1 spreads boats).
function FountainFx.Offset(t, phase)
	phase = phase or 0
	local a = TWO_PI * (t / K.DRIFT_PERIOD + phase)
	local b = TWO_PI * (t / K.BOB_PERIOD + phase * 3)
	return CFrame.new(math.cos(a) * K.DRIFT, math.sin(b) * K.BOB, math.sin(a) * K.DRIFT)
		* CFrame.Angles(math.sin(b + 1.1) * K.ROLL, math.sin(a * 2) * K.YAW, 0)
end

-- the anchored parts under the root (the sail) and their offsets from its rest frame. A part not yet seen has never
-- been moved by this client, so its CFrame is its rest. Unanchored ones (the ML_Weld mesh) ride the root by weld.
local function collectKids(rec)
	for _, d in ipairs(rec.Part:GetDescendants()) do
		if d:IsA("BasePart") and d.Anchored and not rec.Seen[d] then
			rec.Seen[d] = true
			rec.Kids[#rec.Kids + 1] = { Part = d, Offset = rec.Rest:ToObjectSpace(d.CFrame) }
		end
	end
end

local function place(rec, cf)
	rec.Part.CFrame = cf
	St.Writes = St.Writes + 1
	for _, k in ipairs(rec.Kids) do
		if k.Part.Parent then
			k.Part.CFrame = cf * k.Offset
			St.Writes = St.Writes + 1
		end
	end
end

local function rest(rec)
	if rec.Moving and rec.Part.Parent then
		place(rec, rec.Rest)
	end
	rec.Moving = false
end

local function track(part)
	if not part:IsA("BasePart") or St.Boats[part] then
		return
	end
	local rec = { Part = part, Rest = part.CFrame, Phase = (St.Count * 0.37) % 1, Moving = false, Kids = {}, Seen = {} }
	collectKids(rec)
	St.Boats[part] = rec
	St.Count = St.Count + 1
end

local function forget(part)
	local rec = St.Boats[part]
	if rec then
		rest(rec)
		St.Boats[part] = nil
		St.Count = St.Count - 1
	end
end

-- (audio wave 2 fix) the water loop = SoundFx.Positional("Fountain"): Config.Audio.Ambient.Fountain (key FountainLoop,
-- an AudioIds number; none approved yet = silent, no warning), InverseTapered, follows the Sfx setting like every loop
local function soundFx()
	local ok, SF = pcall(function()
		local module = script.Parent.Parent:FindFirstChild("SoundFx")
		return module and require(module) or nil
	end)
	return (ok and type(SF) == "table" and type(SF.Positional) == "function") and SF or nil
end

-- the water loop on the falls' anchor (only when an id is configured)
local function attachSound(anchor)
	if St.Sound or not anchor:IsA("BasePart") then
		return
	end
	local SF = soundFx()
	if not SF then
		return
	end
	local ok, s = pcall(SF.Positional, "Fountain", anchor, { Min = 10, Max = K.SOUND_RANGE, Name = "FountainWater" })
	if ok and typeof(s) == "Instance" then
		St.Sound = s
	end
end

local function refresh()
	St.Quality = quality()
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position
	for _, rec in pairs(St.Boats) do
		local near = camPos == nil or (rec.Rest.Position - camPos).Magnitude <= K.RANGE
		local on = near and St.Quality ~= "Low" and rec.Part.Parent ~= nil
		if not on then
			rest(rec)
		elseif not rec.Moving then
			collectKids(rec) -- parts that streamed in late (picked up while the boat is at rest)
		end
		rec.On = on
	end
end

function FountainFx.Step(dt)
	dt = tonumber(dt) or 0
	if dt <= 0 then
		return
	end
	St.Time = St.Time + dt
	St.RefreshAcc = St.RefreshAcc + dt
	if St.RefreshAcc >= K.REFRESH then
		St.RefreshAcc = 0
		refresh()
	end
	St.Acc = St.Acc + dt
	if St.Acc < 1 / K.UPDATE_HZ then
		return
	end
	St.Acc = 0
	for _, rec in pairs(St.Boats) do
		if rec.On and rec.Part.Parent then
			place(rec, rec.Rest * FountainFx.Offset(St.Time, rec.Phase))
			rec.Moving = true
		end
	end
end

function FountainFx.Stats()
	local moving = 0
	for _, rec in pairs(St.Boats) do
		if rec.Moving then
			moving = moving + 1
		end
	end
	return { Boats = St.Count, Moving = moving, Writes = St.Writes, Time = St.Time, Quality = St.Quality,
		Sound = St.Sound ~= nil }
end

function FountainFx.Stop()
	for _, c in ipairs(St.Conns) do
		c:Disconnect()
	end
	St.Conns = {}
	local parts = {}
	for part in pairs(St.Boats) do
		parts[#parts + 1] = part
	end
	for _, part in ipairs(parts) do
		forget(part)
	end
	if St.Sound then
		St.Sound:Destroy()
		St.Sound = nil
	end
	St.Started = false
end

function FountainFx.Init()
	if St.Started then
		return
	end
	St.Started = true
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceAddedSignal(K.BOAT_TAG):Connect(track)
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceRemovedSignal(K.BOAT_TAG):Connect(forget)
	for _, part in ipairs(CollectionService:GetTagged(K.BOAT_TAG)) do
		track(part)
	end
	St.Conns[#St.Conns + 1] = CollectionService:GetInstanceAddedSignal(K.FALLS_TAG):Connect(attachSound)
	for _, anchor in ipairs(CollectionService:GetTagged(K.FALLS_TAG)) do
		attachSound(anchor)
	end
	St.Conns[#St.Conns + 1] = RunService.Heartbeat:Connect(FountainFx.Step)
	refresh()
end

return FountainFx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="1139">
            <Properties>
              <string name="Name">FusionController</string>
              <string name="Source"><![CDATA[-- FusionController (client): the Fusion Machine window. Phase 2 (ARCHITECTURE_V3.md section 11 and the FusionService /
-- FusionController paragraph of the "Phase 2 build contract"); redrawn as card A of the window redo (gui-redo Task 11:
-- docs/superpowers/specs/2026-11-06-window-redo-design.md 5.1 and 5.6; plan docs/superpowers/plans/2026-11-06-window-redo.md).
--
--   FusionController.Init()
--   FusionController.Open(tab, args)   tab = "Upgrade" | "Mix" | nil (the last one); args (optional) =
--                                       { Key = key (the Upgrade pet / the Body), KeyB = key (the Style), Machine = the
--                                       Station_FusionMachine model it was opened at }
--   FusionController.Close()            closes our pet picker sheet and the window
--   FusionController.IsOpen() -> bool,  FusionController.Plan() -> the preview the window shows ({ Ok, Reason, Action, Inputs,
--       ResultKey, ResultName, Rarity, Tier, Elements, Cost = { Currency, Amount }, Notes; Mix: Moves, SpecialFrom,
--       SameElement, MovesText }),
--   FusionController.Select(keyA, keyB) picks pets like the sheet does (Upgrade: keyA; Mix: Body, Style; nil empties),
--   FusionController.Fuse() (the FUSE! button), FusionController.Layout() -> "PC" | "Phone" | "Portrait",
--   FusionController.SetMoves(attackKey, specialKey)   (Task 12) the Mix move choice: each argument must be the Body's or the
--                                       Style's key (anything else is ignored); attackKey picks the parent of the normal
--                                       attack (ignored when both parents share an element), specialKey the parent of the
--                                       special
--   FusionController.Moves() -> "BB" | "BS" | "SB" | "SS"   letter 1 = the normal attack's parent, letter 2 = the special's
--                                       (B = Body, S = Style); "BB" = today's hybrid (the Body gives both)
--   FusionController.MovesText(bodyKey, styleKey, moves) -> { Attack = { Element, Name }, Special = { Kind, Name } } | nil
--                                       (pure: stage 0's names from the catalogs; nil for a hybrid / unknown / missing pet;
--                                       junk or nil moves read as "BB")
--   FusionController.Opened (fires the tab) / Closed (Util.Signal)
--
-- How it opens: E at the player's own Fusion Machine (the FusionPrompt HomeBuilder puts on Station_FusionMachine; other
-- players' prompts are disabled locally by HomeFx and ignored here), or OpenPanel("Fusion", { Tab, Key, KeyB }) from the
-- server / other windows. One window at a time: opening it closes the menu windows, the Pet Index and the Gifts window
-- (CareController closes Feed / Garden / the Training Place on our Opened); a menu window or the Pet Index opening closes
-- it. Esc / gamepad B close our sheet first, then the window; the red X, walking away from the machine (when it was opened
-- there) and entering a match close it.
--
-- Card A (the owner's pick): a violet header (the crystal, "Fusion Machine", the UPGRADE / MIX tabs, the Cloud Token and
-- Gem chips, the red X) over a navy body:
--   UPGRADE  Stack: three fanned copies ("COPIES", the pet, "Uncommon . Flame"; a copy you do not have is an empty card),
--            CopiesText "x5 owned . uses 3", the Arrow, the big glowing Result (GOLDEN: gold + sparks; RAINBOW: a shimmering
--            edge) with its Pills ("Uncommon", "x1.5 power"), the Note (why it cannot fuse, the copies taken off the team /
--            Garden first, or what the fusion does). Tapping the Stack opens the shared pet picker (Upgrade context).
--   MIX      Slot_Body, the SwapButton, Slot_Style, the Arrow, the NEW HYBRID card (violet glow, the pet bobbing, the blended
--            name; Pills: rarity, "Flame + Storm" in the hybrid's element order, finish), the Note (a reason, when there is
--            one) and the Info line. Tapping a slot opens the picker (Mix context) with the other slot's species blocked
--            ("In Body" / "In Style", every finish).
--            The move choice (gui-redo Task 12, the owner's note): under each slot Chips_Body / Chips_Style hold an Attack
--            chip (the pet's element attack, "<sword> Flare"; PC adds the element: "... . Flame") over a Special chip ("<star>
--            Leaf Pounce"; PC adds the kind: "... . Pounce"), stage 0's names. In each pair exactly one chip is lit (attribute
--            Lit, a gold border and a check badge); a tap on the other parent's chip moves that move to it. The choice
--            follows the PET: the swap keeps each move with its pet (the letters flip), a new pet in either slot resets it to
--            "BB". Two parents of one element: both attack chips lit and inactive (one element, no choice). The outcome in
--            the owner's words, "Normal attack: Flame (Flare)" / "Special: Pounce (Leaf Pounce)": PC = OutcomeAttack and
--            OutcomeSpecial inside the NEW HYBRID card between its name and its pills; phone = ONE Outcome line under the
--            slot row (in the Info line's place; the kind words drop first when it is too wide, then it wraps inside its 40
--            px, never cut) with a reason note in the right column; portrait = the Outcome line above the Note / Info line.
--            The preview record is built by PetKeys.MixMoves like the server's (Elements order, SpecialFrom).
--   both     the CostBar (the token icon and the price; PC: "You have 12,480 Cloud Tokens", red when short) and FUSE!
--            (pulsing when it can fuse), a TipLine (PC on top; the phone's Upgrade at the bottom), the HintLine (3 s:
--            window-local hints such as why FUSE! is grey, and the server's refusal), the Locked card (no Prestige / no
--            machine yet).
-- No pet picked: opening the Upgrade tab opens the sheet by itself; Mix with an empty slot opens it for the first empty slot
-- (Body first) and, after a pick, once more for the other one while it is still empty; closing the sheet without a pick ends
-- that chain; nothing opens by itself when the context has no pet.
-- FUSE sends Remotes.Fusion("Upgrade", key) / ("Mix", body, style, moves); the server checks everything again and answers with
-- Fusion:FireClient("Result", { Ok, Key, Name, Reason... }). On success the inputs fly into the result, a flash and a confetti
-- burst, the new pet pops in with a NEW! tag, and glowing cubes burst out of the machine's output pod (client-only parts).
--
-- Screen: ScreenGui NimbusFusion (DisplayOrder 22, IgnoreGuiInset) > Window_Fusion (NeonKit.BigRect: 1440 x 880 at 1080p, the
-- PC layout computed in the design box with the 1080p mock as its largest form; 820 x 330 at scale 1 on an 844 x 390 phone;
-- one column on a portrait phone; UIScale "Fit") > Panel (UIScale "Pop": the 0.22 s Back-Out open) > Header (Icon, Title,
-- Tab_Upgrade, Tab_Mix, TokenChip, GemChip, CloseButton), Body (TipLine, Stack > Copy1..3, CopiesText, Slot_Body, Plus,
-- SwapButton, Slot_Style, Chips_Body / Chips_Style > Attack / Special (> Check), Arrow, Result (> ... OutcomeAttack,
-- OutcomeSpecial), Pills > Pill_*, Note, Info, Outcome, CostBar > CostLabel / CostIcon / Cost / Have, FuseButton, HintLine,
-- Locked, Flash, New). On a phone or a touch-only device the window hides Roblox's stick and jump
-- (MenuController.SetTouchHidden("Fusion")) and steps the menu column aside (SetColumnCovered); the cursor is free while it
-- is shown (client/MouseLock). Pet looks are CloudUI.PetViewport (cached by what they show). Every number comes from the
-- catalogs and the synced profile; the server decides. Plain Lua 5.1-compatible syntax only. All text goes through Theme roles.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Theme = require(Shared:WaitForChild("Theme"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local Client = script.Parent.Parent
local UI = Client:WaitForChild("UI")
local CloudUI = require(UI:WaitForChild("CloudUI"))
local NeonKit = require(UI:WaitForChild("NeonKit"))
local GemIcon = require(UI:WaitForChild("GemIcon"))
local PixelIcon = require(Shared:WaitForChild("PixelIcon")) -- (kit-b U7a) the token chip's coin; (U7b) the window's icons
local SignKit = require(Shared:WaitForChild("SignKit")) -- (kit-b U9-5) the awning over the window
local PetPicker = require(UI:WaitForChild("PetPicker"))
local State = require(Client:WaitForChild("State"))

local function safeRequire(name)
	local ok, result = pcall(function()
		local module = Shared:FindFirstChild(name) or Shared:WaitForChild(name, 5)
		return module and require(module) or nil
	end)
	if ok and type(result) == "table" then
		return result
	end
	warn("[FusionController] " .. name .. " is unavailable: " .. tostring(result))
	return nil
end

local PetKeys = safeRequire("PetKeys")
local PetCatalog = safeRequire("PetCatalog")
local TycoonCatalog = safeRequire("TycoonCatalog")
local BattleCatalog = safeRequire("BattleCatalog") -- the move chips' names (ElementAttacks, Specials)

local FusionController = {}
FusionController.Opened = Util.Signal()
FusionController.Closed = Util.Signal()

