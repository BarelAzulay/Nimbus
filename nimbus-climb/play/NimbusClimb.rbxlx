ASC.Look.rime_wyrmling = { Glow = { 150, 232, 255 }, GlowB = { 226, 248, 255 }, Aura = "Snow" }
ASC.Look.hydralotl = { Glow = { 120, 255, 196 }, GlowB = { 196, 255, 110 }, Aura = "Orb" }

